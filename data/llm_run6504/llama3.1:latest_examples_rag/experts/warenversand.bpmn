<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" name="Versand von Ware">
    <bpmn:startEvent id="StartEvent_1" name="Ware wird versendet">
      <bpmn:outgoing>SequenceFlow_0fyx13v</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="SequenceFlow_0fyx13v" sourceRef="StartEvent_1" targetRef="ParallelGateway_02fgrfq" />
    <bpmn:parallelGateway id="ParallelGateway_02fgrfq">
      <bpmn:incoming>SequenceFlow_0fyx13v</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1t3z6c7</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_2a5y4u8</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_0vaxgaa" name="Klärt, wer den Versand übernimmt">
      <bpmn:incoming>SequenceFlow_1t3z6c7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3i9p8o0</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="ExclusiveGateway_1mpgzhg" name="Große Mengen?">
      <bpmn:incoming>SequenceFlow_3i9p8o0</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4u7q5r6</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_5a1b2c3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="SequenceFlow_0fyx13v" sourceRef="StartEvent_1" targetRef="ParallelGateway_02fgrfq" />
    <bpmn:sequenceFlow id="SequenceFlow_1t3z6c7" sourceRef="ParallelGateway_02fgrfq" targetRef="Task_0vaxgaa" />
    <bpmn:sequenceFlow id="SequenceFlow_2a5y4u8" sourceRef="ParallelGateway_02fgrfq" targetRef="ExclusiveGateway_1mpgzhg" />
    <bpmn:task id="Task_0e6hvnj" name="Sonderversand">
      <bpmn:incoming>SequenceFlow_5a1b2c3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6o7p8q9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_4u7q5r6" name="Nein" sourceRef="ExclusiveGateway_1mpgzhg" targetRef="Task_0s79ile" />
    <bpmn:task id="Task_0s79ile" name="Normaler Postversand">
      <bpmn:incoming>SequenceFlow_4u7q5r6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_7i1j2k3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_1fx9yp3" name="Ware wird zur Abholung bereitgestellt">
      <bpmn:incoming>SequenceFlow_8o9p10q</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>