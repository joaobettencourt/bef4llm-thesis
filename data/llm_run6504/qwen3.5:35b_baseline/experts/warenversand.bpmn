<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions id="Definitions_1" targetNamespace="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC">
  <bpmn:collaboration id="Collab_0a9876543210">
    <bpmn:participant id="Participant_ComputerHardwareShop" name="Computer Hardware Shop" processRef="Proc_ShipmentProcess"/>
  </bpmn:collaboration>

  <bpmn:process id="Proc_ShipmentProcess" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:laneSet id="Lane_Set_0123456789ab">
        <bpmn:lane id="Lane_Secretary" name="Sekretariat">
          <bpmn:flowNodeRef>StartEvent_WareVersenden</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Tsk_VersandartKlaeren</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Gtw_GrosseMenge</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Tsp_AngeboteEinholen</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Tsk_AngbotAuswaehlen</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Tsk_SpediteurBeauftragen</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Tsp_PaketformularAusfuellen</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_WareVersenden" name="Ware versendet werden soll">
      <bpmn:outgoing>SqFlow_StartToDecide</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1 -->
    <bpmn:userTask id="Tsk_VersandartKlaeren" name="Versandart klären">
      <bpmn:incoming>SqFlow_StartToDecide</bpmn:incoming>
      <bpmn:outgoing>SqFlow_DecideToSplit</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel Split -->
    <bpmn:parallelGateway id="Gtw_SplitAdminPack" name="">
      <bpmn:incoming>SqFlow_DecideToSplit</bpmn:incoming>
      <bpmn:outgoing>SqFlow_AdminPath</bpmn:outgoing>
      <bpmn:outgoing>SqFlow_PackPath</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Gateway 1 - Decision on quantity type -->
    <bpmn:exclusiveGateway id="Gtw_GrosseMenge" name="Große Menge?">
      <bpmn:incoming>SqFlow_AdminPath</bpmn:incoming>
      <bpmn:outgoing>SqFlow_LargeQtyPath</bpmn:outgoing>
      <bpmn:outgoing>SqFlow_SmallQtyPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 2 - Large quantity path -->
    <bpmn:userTask id="Tsp_AngeboteEinholen" name="Angebote von Spediteuren einholen">
      <bpmn:incoming>SqFlow_LargeQtyPath</bpmn:incoming>
      <bpmn:outgoing>SqFlow_EinholenzuAuswaehlen</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task 3 - Large quantity path -->
    <bpmn:userTask id="Tsk_AngbotAuswaehlen" name="Angebot auswählen">
      <bpmn:incoming>SqFlow_EinholenzuAuswaehlen</bpmn:incoming>
      <bpmn:outgoing>SqFlow_Auswahlenzubeauftragen</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task 4 - Large quantity path -->
    <bpmn:userTask id="Tsk_SpediteurBeauftragen" name="Spediteur beauftragen">
      <bpmn:incoming>SqFlow_Auswahlenzubeauftragen</bpmn:incoming>
      <bpmn:outgoing>SqFlow_LargeToJoinAll</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task 5 - Small quantity path -->
    <bpmn:userTask id="Tsp_PaketformularAusfuellen" name="Paketschein ausfüllen">
      <bpmn:incoming>SqFlow_SmallQtyPath</bpmn:incoming>
      <bpmn:outgoing>SqFormularZuVersicherungGtw</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway 2 - Insurance decision -->
    <bpmn:exclusiveGateway id="Gtw_VersicherungErforderlich" name="Versicherung erforderlich?">
      <bpmn:incoming>SqFormularZuVersicherungGtw</bpmn:incoming>
      <bpmn:outgoing>SqFlow_ZuVersicherungAbschliessen</bpmn:outgoing>
      <bpmn:outgoing>SqFlow_VersicherungsNichtErforderlich</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 6 - Insurance task -->
    <bpmn:userTask id="Tsk_LogistikVersicherung" name="Versicherung abschließen">
      <bpmn:incoming>SqFlow_ZuVersicherungAbschliessen</bpmn:incoming>
      <bpmn:outgoing>SqFlow_InsureToJoinAll</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task 7 - Parallel warehouse task -->
    <bpmn:userTask id="Tsk_WareVerpacken" name="Ware verpacken">
      <bpmn:incoming>SqFlow_PackPath</bpmn:incoming>
      <bpmn:outgoing>SqFlow_PackToJoinAll</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel Join -->
    <bpmn:parallelGateway id="Gtw_JoinAll" name="">
      <bpmn:incoming>SqFlow_LargeToJoinAll</bpmn:incoming>
      <bpmn:incoming>SqFlow_InsureToJoinAll</bpmn:incoming>
      <bpmn:incoming>SqFlow_VersicherungsNichtErforderlich</bpmn:incoming>
      <bpmn:incoming>SqFlow_PackToJoinAll</bpmn:incoming>
      <bpmn:outgoing>SqFlow_JoinToFinalTask</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 8 - Final Preparation -->
    <bpmn:userTask id="Tsk_Bereitstellen" name="Ware zur Abholung bereitstellen">
      <bpmn:incoming>SqFlow_JoinToFinalTask</bpmn:incoming>
      <bpmn:outgoing>SqFlow_FinalToEnd</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_ReadyForPickup" name="Ware zur Abholung bereitgestellt">
      <bpmn:incoming>SqFlow_FinalToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SqFlow_StartToDecide" sourceRef="StartEvent_WareVersenden" targetRef="Tsk_VersandartKlaeren"/>
    <bpmn:sequenceFlow id="SqFlow_DecideToSplit" sourceRef="Tsk_VersandartKlaeren" targetRef="Gtw_SplitAdminPack"/>
    <bpmn:sequenceFlow id="SqFlow_AdminPath" sourceRef="Gtw_SplitAdminPack" targetRef="Gtw_GrosseMenge"/>
    <bpmn:sequenceFlow id="SqFlow_PackPath" sourceRef="Gtw_SplitAdminPack" targetRef="Tsk_WareVerpacken"/>
    
    <!-- Large Quantity Flows -->
    <bpmn:sequenceFlow id="SqFlow_LargeQtyPath" name="Ja (Groß)" sourceRef="Gtw_GrosseMenge" targetRef="Tsp_AngeboteEinholen"/>
    <bpmn:sequenceFlow id="SqFlow_EinholenzuAuswaehlen" sourceRef="Tsp_AngeboteEinholen" targetRef="Tsk_AngbotAuswaehlen"/>
    <bpmn:sequenceFlow id="SqFlow_Auswahlenzubeauftragen" sourceRef="Tsk_AngbotAuswaehlen" targetRef="Tsk_SpediteurBeauftragen"/>
    <bpmn:sequenceFlow id="SqFlow_LargeToJoinAll" name="" sourceRef="Tsk_SpediteurBeauftragen" targetRef="Gtw_JoinAll"/>

    <!-- Small Quantity Flows -->
    <bpmn:sequenceFlow id="SqFlow_SmallQtyPath" name="Nein (Klein)" sourceRef="Gtw_GrosseMenge" targetRef="Tsp_PaketformularAusfuellen"/>
    <bpmn:sequenceFlow id="SqFormularZuVersicherungGtw" sourceRef="Tsp_PaketformularAusfuellen" targetRef="Gtw_VersicherungErforderlich"/>

    <!-- Insurance Flows -->
    <bpmn:sequenceFlow id="SqFlow_ZuVersicherungAbschliessen" name="Ja (erforderlich)" sourceRef="Gtw_VersicherungErforderlich" targetRef="Tsk_LogistikVersicherung"/>
    <bpmn:sequenceFlow id="SqFlow_InsureToJoinAll" sourceRef="Tsk_LogistikVersicherung" targetRef="Gtw_JoinAll"/>
    <bpmn:sequenceFlow id="SqFlow_VersicherungsNichtErforderlich" name="Nein (nicht erforderlich)" sourceRef="Gtw_VersicherungErforderlich" targetRef="Gtw_JoinAll"/>

    <!-- Warehouse Flow -->
    <bpmn:sequenceFlow id="SqFlow_PackToJoinAll" sourceRef="Tsk_WareVerpacken" targetRef="Gtw_JoinAll"/>

    <!-- Final Flows -->
    <bpmn:sequenceFlow id="SqFlow_JoinToFinalTask" sourceRef="Gtw_JoinAll" targetRef="Tsk_Bereitstellen"/>
    <bpmn:sequenceFlow id="SqFlow_FinalToEnd" sourceRef="Tsk_Bereitstellen" targetRef="EndEvent_ReadyForPickup"/>

  </bpmn:process>
</bpmn:definitions>