<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                 xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" 
                 xmlns:di="http://www.omg.org/spec/DD/20100524/DI" 
                 xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" 
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 id="Definitions_HealthProgram" targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Gesundheitsförderungsprogramm" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    
    <!-- Lanes -->
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Participant" name="Teilnehmer">
        <bpmn:flowNodeRef>Task_TrainingPhase06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_GroupSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TrainingPhase712NoWearables</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TrainingPhase712WithApp</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Coach" name="Gesundheitscoaches/Organisation">
        <bpmn:flowNodeRef>StartEvent_01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SplitInitial</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GesundheitsCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AppWearableTrainingInstruction</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MergeInitial</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreatePlans</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_TrainingStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NutritionCounseling</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InterimHealthCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MergeTrainingEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FinalHealthCheck</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_01" name="Programmstart">
      <bpmn:outgoing>SequenceFlow_StartToSplit</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Initial Split (Health Check & Onboarding) -->
    <bpmn:parallelGateway id="Gateway_SplitInitial" name="Start Phase">
      <bpmn:incoming>SequenceFlow_StartToSplit</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_HealthCheckPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_AppTrainingPath</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Health Check Task -->
    <bpmn:task id="Task_GesundheitsCheck" name="Gesundheits-Check (Vitals, WAI, Blutprobe)">
      <bpmn:incoming>SequenceFlow_HealthCheckPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckToMerge</bpmn:outgoing>
    </bpmn:task>

    <!-- App & Wearable Training Instruction -->
    <bpmn:task id="Task_AppWearableTrainingInstruction" name="Einweisung in App und Wearables">
      <bpmn:incoming>SequenceFlow_AppTrainingPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TrainingToMerge</bpmn:outgoing>
    </bpmn:task>

    <!-- Initial Merge -->
    <bpmn:parallelGateway id="Gateway_MergeInitial">
      <bpmn:incoming>SequenceFlow_CheckToMerge</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_TrainingToMerge</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToPlanning</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Planning Task -->
    <bpmn:task id="Task_CreatePlans" name="Erstelle Trainings- und Ernährungspläne">
      <bpmn:incoming>SequenceFlow_ToPlanning</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TrainingStartSplit</bpmn:outgoing>
    </bpmn:task>

    <!-- Training Start Split (Main Path vs Counseling) -->
    <bpmn:parallelGateway id="Gateway_TrainingStart" name="Trainingsphase starten">
      <bpmn:incoming>SequenceFlow_TrainingStartSplit</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MainTrainingPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CounselingPath</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Main Training Path -->
    <bpmn:task id="Task_TrainingPhase06" name="Trainingsphase (Monat 1-6)">
      <bpmn:incoming>SequenceFlow_MainTrainingPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToInterimCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Interim Check -->
    <bpmn:task id="Task_InterimHealthCheck" name="Zwischen-Check (Fortschrittsdokumentation)">
      <bpmn:incoming>SequenceFlow_ToInterimCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GroupSplitDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Group Split Gateway -->
    <bpmn:exclusiveGateway id="Gateway_GroupSplit" name="Gruppeneinteilung">
      <bpmn:incoming>SequenceFlow_GroupSplitDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PathNoWearables</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PathWithApp</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Path 1: No Wearables -->
    <bpmn:task id="Task_TrainingPhase712NoWearables" name="Trainingsphase (Monat 7-12) ohne Wearables">
      <bpmn:incoming>SequenceFlow_PathNoWearables</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToMergeTrainingEnd_06</bpmn:outgoing>
    </bpmn:task>

    <!-- Path 2: With App/Wearables -->
    <bpmn:task id="Task_TrainingPhase712WithApp" name="Trainingsphase (Monat 7-12) mit App &amp; Wearables">
      <bpmn:incoming>SequenceFlow_PathWithApp</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToMergeTrainingEnd_App</bpmn:outgoing>
    </bpmn:task>

    <!-- Counseling Path -->
    <bpmn:task id="Task_NutritionCounseling" name="Ernährungsberatung (optional)">
      <bpmn:incoming>SequenceFlow_CounselingPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToMergeTrainingEnd</bpmn:outgoing>
    </bpmn:task>

    <!-- Merge Training End -->
    <bpmn:parallelGateway id="Gateway_MergeTrainingEnd">
      <bpmn:incoming>SequenceFlow_ToMergeTrainingEnd</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ToMergeTrainingEnd_06</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ToMergeTrainingEnd_App</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FinalCheckStart</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Final Check -->
    <bpmn:task id="Task_FinalHealthCheck" name="Abschluss-Check (Gesamtfortschritt)">
      <bpmn:incoming>SequenceFlow_FinalCheckStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToEndEvent</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_01" name="Programm abgeschlossen">
      <bpmn:incoming>SequenceFlow_ToEndEvent</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToSplit" sourceRef="StartEvent_01" targetRef="Gateway_SplitInitial"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_HealthCheckPath" name="Gesundheits-Check" sourceRef="Gateway_SplitInitial" targetRef="Task_GesundheitsCheck"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_AppTrainingPath" name="Einweisung App/Wearables" sourceRef="Gateway_SplitInitial" targetRef="Task_AppWearableTrainingInstruction"/>

    <bpmn:sequenceFlow id="SequenceFlow_CheckToMerge" sourceRef="Task_GesundheitsCheck" targetRef="Gateway_MergeInitial"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_TrainingToMerge" name="Einweisung abgeschlossen" sourceRef="Task_AppWearableTrainingInstruction" targetRef="Gateway_MergeInitial"/>

    <bpmn:sequenceFlow id="SequenceFlow_ToPlanning" sourceRef="Gateway_MergeInitial" targetRef="Task_CreatePlans"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_TrainingStartSplit" name="Trainingsphase starten" sourceRef="Task_CreatePlans" targetRef="Gateway_TrainingStart"/>

    <bpmn:sequenceFlow id="SequenceFlow_MainTrainingPath" name="Hauptpfad Training" sourceRef="Gateway_TrainingStart" targetRef="Task_TrainingPhase06"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_CounselingPath" name="Beratung verfügbar" sourceRef="Gateway_TrainingStart" targetRef="Task_NutritionCounseling"/>

    <bpmn:sequenceFlow id="SequenceFlow_ToInterimCheck" sourceRef="Task_TrainingPhase06" targetRef="Task_InterimHealthCheck"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_GroupSplitDecision" name="Gruppeneinteilung prüfen" sourceRef="Task_InterimHealthCheck" targetRef="Gateway_GroupSplit"/>

    <bpmn:sequenceFlow id="SequenceFlow_PathNoWearables" name="Ohne Wearables" sourceRef="Gateway_GroupSplit" targetRef="Task_TrainingPhase712NoWearables"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_PathWithApp" name="Mit App &amp; Wearables" sourceRef="Gateway_GroupSplit" targetRef="Task_TrainingPhase712WithApp"/>

    <bpmn:sequenceFlow id="SequenceFlow_ToMergeTrainingEnd" sourceRef="Task_NutritionCounseling" targetRef="Gateway_MergeTrainingEnd"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ToMergeTrainingEnd_06" name="Trainingsphase 1 Ende" sourceRef="Task_TrainingPhase712NoWearables" targetRef="Gateway_MergeTrainingEnd"/>

    <bpmn:sequenceFlow id="SequenceFlow_ToMergeTrainingEnd_App" name="Trainingsphase 2 Ende (App)" sourceRef="Task_TrainingPhase712WithApp" targetRef="Gateway_MergeTrainingEnd"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_FinalCheckStart" name="Programmende vorbereiten" sourceRef="Gateway_MergeTrainingEnd" targetRef="Task_FinalHealthCheck"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ToEndEvent" sourceRef="Task_FinalHealthCheck" targetRef="EndEvent_01"/>

  </bpmn:process>

</bpmn:definitions>