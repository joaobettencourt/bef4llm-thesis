<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Schadensabwicklung Prozess" processRef="Process_1" />
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Kundenzentrum" name="Kundenzentrum">
        <bpmn:flowNodeRef>StartEvent_Schadensmeldung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Gueltigkeitspruefung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Exclusive_Valid</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Versicherungsmanagement" name="Versicherungsmanagement">
        <bpmn:flowNodeRef>Task_Dokumentenpruefung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Exclusive_InfoNeeded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RueckfragenStellen</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Fachabteilung" name="Fachabteilung">
        <bpmn:flowNodeRef>Event_UebergabeAnFachsAbt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SchadensursacheUntersuchen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Exclusive_LegalNeeded</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Schadensmeldung" name="Schadensmeldung eingereicht">
      <bpmn:outgoing>SequenceFlow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Customer Service Tasks -->
    <bpmn:task id="Task_Gueltigkeitspruefung" name="Gültigkeit der Schadensmeldung prüfen">
      <bpmn:incoming>SequenceFlow_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_02</bpmn:outgoing>
    </bpmn:task>

    <!-- Validity Check Gateway -->
    <bpmn:exclusiveGateway id="Gateway_Exclusive_Valid" name="Schaden gültig?">
      <bpmn:incoming>SequenceFlow_02</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_03</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_04</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Invalid Case End -->
    <bpmn:endEvent id="EndEvent_Ungueltig" name="Kunde informiert - Prozess abgeschlossen">
      <bpmn:incoming>SequenceFlow_03</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Valid Path Start Parallel Split -->
    <bpmn:parallelGateway id="Parallel_Split_Valid" name="">
      <bpmn:incoming>SequenceFlow_04</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_05</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_12</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Main Processing Path -->
    <bpmn:task id="Task_Dokumentenpruefung" name="Eingereichte Unterlagen auf Vollständigkeit prüfen">
      <bpmn:incoming>SequenceFlow_05</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_06</bpmn:outgoing>
    </bpmn:task>

    <!-- Request Additional Info Gateway -->
    <bpmn:exclusiveGateway id="Gateway_Exclusive_InfoNeeded" name="Zusätzliche Informationen erforderlich?">
      <bpmn:incoming>SequenceFlow_06</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_07</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Request Info Task -->
    <bpmn:task id="Task_RueckfragenStellen" name="Zusätzliche Informationen vom Kunden/Dritten einholen">
      <bpmn:incoming>SequenceFlow_07</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_14</bpmn:outgoing>
    </bpmn:task>

    <!-- Merge Info Collection -->
    <bpmn:exclusiveGateway id="Merge_InfoNeeded" name="">
      <bpmn:incoming>SequenceFlow_07</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_14</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Handover to Fachabteilung -->
    <bpmn:intermediateThrowEvent id="Event_UebergabeAnFachsAbt" name="Übergabe an Fachabteilung">
      <bpmn:incoming>SequenceFlow_15</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>

    <!-- Specialized Department Tasks -->
    <bpmn:startEvent id="StartEvent_Fachabteilung" name="Fallübernahme">
      <bpmn:outgoing>SequenceFlow_16</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>

    <bpmn:task id="Task_SchadensursacheUntersuchen" name="Schadensursache untersuchen">
      <bpmn:incoming>SequenceFlow_16</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_17</bpmn:outgoing>
    </bpmn:task>

    <!-- Legal Assessment Gateway -->
    <bpmn:exclusiveGateway id="Gateway_Exclusive_LegalNeeded" name="Rechtliche Einschätzung erforderlich?">
      <bpmn:incoming>SequenceFlow_17</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_18</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_20</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Legal Assessment Task -->
    <bpmn:task id="Task_RechtlicheEinschaetzung" name="Rechtliche Einschätzung durch Versicherer einholen">
      <bpmn:incoming>SequenceFlow_18</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_21</bpmn:outgoing>
    </bpmn:task>

    <!-- Merge Legal Assessment -->
    <bpmn:exclusiveGateway id="Merge_LegalNeeded" name="">
      <bpmn:incoming>SequenceFlow_07</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_21</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_23</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Parallel Stats Recording -->
    <bpmn:task id="Task_StatsErfassen" name="Fall in Schadensstatistik erfassen">
      <bpmn:incoming>SequenceFlow_12</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_24</bpmn:outgoing>
    </bpmn:task>

    <!-- Merge Main and Stats Recording -->
    <bpmn:parallelGateway id="Parallel_Merge_Main" name="">
      <bpmn:incoming>SequenceFlow_13</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_24</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_25</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Update Statistics -->
    <bpmn:task id="Task_SchadensstatistikAktualisieren" name="Schadensstatistik aktualisieren">
      <bpmn:incoming>SequenceFlow_25</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_26</bpmn:outgoing>
    </bpmn:task>

    <!-- Inform Customer -->
    <bpmn:endEvent id="EndEvent_Abschluss" name="Kunde über Bearbeitungsstand informiert">
      <bpmn:incoming>SequenceFlow_27</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_01" sourceRef="StartEvent_Schadensmeldung" targetRef="Task_Gueltigkeitspruefung" />
    
    <bpmn:sequenceFlow id="SequenceFlow_02" name="Prüfung durchgeführt">
      <bpmn:sourceRef>Task_Gueltigkeitspruefung</bpmn:sourceRef>
      <bpmn:targetRef>Gateway_Exclusive_Valid</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Invalid Path -->
    <bpmn:sequenceFlow id="SequenceFlow_03" name="Nein, ungültig">
      <bpmn:sourceRef>Gateway_Exclusive_Valid</bpmn:sourceRef>
      <bpmn:targetRef>EndEvent_Ungueltig</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Valid Path Split -->
    <bpmn:sequenceFlow id="SequenceFlow_04" name="Ja, gültig">
      <bpmn:sourceRef>Gateway_Exclusive_Valid</bpmn:sourceRef>
      <bpmn:targetRef>Parallel_Split_Valid</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Main Processing Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_05" name="Prüfung durchgeführt">
      <bpmn:sourceRef>Parallel_Split_Valid</bpmn:sourceRef>
      <bpmn:targetRef>Task_Dokumentenpruefung</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Request Info Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_06" name="Prüfung durchgeführt">
      <bpmn:sourceRef>Task_Dokumentenpruefung</bpmn:sourceRef>
      <bpmn:targetRef>Gateway_Exclusive_InfoNeeded</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Request Info Path -->
    <bpmn:sequenceFlow id="SequenceFlow_07" name="Ja">
      <bpmn:sourceRef>Gateway_Exclusive_InfoNeeded</bpmn:sourceRef>
      <bpmn:targetRef>Task_RueckfragenStellen</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- No Info Needed Path -->
    <bpmn:sequenceFlow id="SequenceFlow_13" name="Nein">
      <bpmn:sourceRef>Gateway_Exclusive_InfoNeeded</bpmn:sourceRef>
      <bpmn:targetRef>Parallel_Merge_Main</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Merge Info Collection -->
    <bpmn:sequenceFlow id="SequenceFlow_14" name="Informationen erhalten">
      <bpmn:sourceRef>Task_RueckfragenStellen</bpmn:sourceRef>
      <bpmn:targetRef>Merge_InfoNeeded</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Merge Info Collection Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_15" name="Informationen erhalten">
      <bpmn:sourceRef>Merge_InfoNeeded</bpmn:sourceRef>
      <bpmn:targetRef>Event_UebergabeAnFachsAbt</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Fachabteilung Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_16" name="Fallübernahme">
      <bpmn:sourceRef>StartEvent_Fachabteilung</bpmn:sourceRef>
      <bpmn:targetRef>Task_SchadensursacheUntersuchen</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Legal Assessment Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_17" name="Prüfung durchgeführt">
      <bpmn:sourceRef>Task_SchadensursacheUntersuchen</bpmn:sourceRef>
      <bpmn:targetRef>Gateway_Exclusive_LegalNeeded</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Legal Assessment Required -->
    <bpmn:sequenceFlow id="SequenceFlow_18" name="Ja">
      <bpmn:sourceRef>Gateway_Exclusive_LegalNeeded</bpmn:sourceRef>
      <bpmn:targetRef>Task_RechtlicheEinschaetzung</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Legal Assessment Not Required -->
    <bpmn:sequenceFlow id="SequenceFlow_20" name="Nein">
      <bpmn:sourceRef>Gateway_Exclusive_LegalNeeded</bpmn:sourceRef>
      <bpmn:targetRef>Merge_LegalNeeded</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Legal Assessment Complete -->
    <bpmn:sequenceFlow id="SequenceFlow_21" name="Einschätzung erhalten">
      <bpmn:sourceRef>Task_RechtlicheEinschaetzung</bpmn:sourceRef>
      <bpmn:targetRef>Merge_LegalNeeded</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Merge Legal Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_23" name="Prüfung abgeschlossen">
      <bpmn:sourceRef>Merge_LegalNeeded</bpmn:sourceRef>
      <bpmn:targetRef>Parallel_Merge_Main</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Stats Recording Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_12" name="Fall erfassen">
      <bpmn:sourceRef>Parallel_Split_Valid</bpmn:sourceRef>
      <bpmn:targetRef>Task_StatsErfassen</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Stats Recording Complete Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_24" name="Fall erfasst">
      <bpmn:sourceRef>Task_StatsErfassen</bpmn:sourceRef>
      <bpmn:targetRef>Parallel_Merge_Main</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Merge Main and Stats Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_25" name="Prüfung abgeschlossen">
      <bpmn:sourceRef>Parallel_Merge_Main</bpmn:sourceRef>
      <bpmn:targetRef>Task_SchadensstatistikAktualisieren</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Update Stats Flow -->
    <bpmn:task id="Task_KundeInformieren" name="Kunden über Bearbeitungsstand informieren">
      <bpmn:incoming>SequenceFlow_26</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_27</bpmn:outgoing>
    </bpmn:task>

    <!-- Final Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_26" name="Statistik aktualisiert">
      <bpmn:sourceRef>Task_SchadensstatistikAktualisieren</bpmn:sourceRef>
      <bpmn:targetRef>Task_KundeInformieren</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Final Notification Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_27" name="Information übermittelt">
      <bpmn:sourceRef>Task_KundeInformieren</bpmn:sourceRef>
      <bpmn:targetRef>EndEvent_Abschluss</bpmn:targetRef>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>