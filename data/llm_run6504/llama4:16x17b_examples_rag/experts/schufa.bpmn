<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">

  <process id="schufa_scoring_process" isExecutable="true">
    <startEvent id="start_event">
      <outgoing>sequence_flow_1</outgoing>
    </startEvent>

    <serviceTask id="scoring_anfrage_send" name="Scoringanfrage senden">
      <incoming>sequence_flow_1</incoming>
      <outgoing>sequence_flow_2</outgoing>
    </serviceTask>

    <exclusiveGateway id="verzögerung_gateway">
      <incoming>sequence_flow_3</incoming>
      <outgoing>sequence_flow_4</outgoing>
      <outgoing>sequence_flow_5</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequence_flow_1" sourceRef="start_event" targetRef="scoring_anfrage_send"/>
    <sequenceFlow id="sequence_flow_2" sourceRef="scoring_anfrage_send" targetRef="verzögerung_gateway"/>

    <serviceTask id="level_1_scoring" name="Level 1 Scoring durchführen">
      <incoming>sequence_flow_4</incoming>
      <outgoing>sequence_flow_6</outgoing>
    </serviceTask>

    <serviceTask id="level_2_scoring" name="Level 2 Scoring durchführen">
      <incoming>sequence_flow_5</incoming>
      <outgoing>sequence_flow_7</outgoing>
    </serviceTask>

    <sequenceFlow id="sequence_flow_3" sourceRef="scoring_anfrage_send" targetRef="verzögerung_gateway"/>
    <sequenceFlow id="sequence_flow_4" name="keine Verzögerung" sourceRef="verzögerung_gateway" targetRef="level_1_scoring">
      <conditionExpression xsi:type="tFormalExpression">${verzögerung == false}</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="sequence_flow_5" name="Verzögerung" sourceRef="verzögerung_gateway" targetRef="level_2_scoring">
      <conditionExpression xsi:type="tFormalExpression">${verzögerung == true}</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="sequence_flow_6" sourceRef="level_1_scoring" targetRef="end_event"/>
    <sequenceFlow id="sequence_flow_7" sourceRef="level_2_scoring" targetRef="end_event"/>

    <endEvent id="end_event">
      <incoming>sequence_flow_6</incoming>
      <incoming>sequence_flow_7</incoming>
    </endEvent>

  </process>
</definitions>