<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd" 
             id="definitions" targetNamespace="http://www.example.com/bpmn">
   <collaboration id="collaboration">
     <participant id="participant" processRef="process"/>
   </collaboration>
   <process id="process" isExecutable="true">

     <startEvent id="startEvent">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent" targetRef="task1"/>

     <userTask id="task1" name="Eingang der Daten für ein SEPA- Mandat prüfen">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow2" sourceRef="task1" targetRef="exclusiveGateway1"/>

     <exclusiveGateway id="exclusiveGateway1">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
       <outgoing>sequenceFlow4</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow3" name="ja" sourceRef="exclusiveGateway1" targetRef="task2"/>
     <sequenceFlow id="sequenceFlow4" name="nein" sourceRef="exclusiveGateway1" targetRef="task3"/>

     <userTask id="task2" name="Prüfen, ob alle erforderlichen Informationen vorhanden sind">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow5</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow5" sourceRef="task2" targetRef="exclusiveGateway2"/>

     <exclusiveGateway id="exclusiveGateway2">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow6</outgoing>
       <outgoing>sequenceFlow7</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow6" name="ja" sourceRef="exclusiveGateway2" targetRef="task4"/>
     <sequenceFlow id="sequenceFlow7" name="nein" sourceRef="exclusiveGateway2" targetRef="task5"/>

     <userTask id="task3" name="Manuelle Prüfung der fehlenden Daten">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow8</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow8" sourceRef="task3" targetRef="exclusiveGateway3"/>

     <exclusiveGateway id="exclusiveGateway3">
       <incoming>sequenceFlow8</incoming>
       <outgoing>sequenceFlow9</outgoing>
       <outgoing>sequenceFlow10</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow9" name="ja" sourceRef="exclusiveGateway3" targetRef="endEvent1"/>
     <sequenceFlow id="sequenceFlow10" name="nein" sourceRef="exclusiveGateway3" targetRef="task6"/>

     <userTask id="task4" name="Prüfen, ob ein  'Gültig von'- Datum vorhanden ist">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow11</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow11" sourceRef="task4" targetRef="exclusiveGateway4"/>

     <exclusiveGateway id="exclusiveGateway4">
       <incoming>sequenceFlow11</incoming>
       <outgoing>sequenceFlow12</outgoing>
       <outgoing>sequenceFlow13</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow12" name="ja" sourceRef="exclusiveGateway4" targetRef="task7"/>
     <sequenceFlow id="sequenceFlow13" name="nein" sourceRef="exclusiveGateway4" targetRef="task8"/>

     <userTask id="task5" name="Automatisch ein Schreiben erstellen, das die fehlende Unterschrift anfordert">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow14</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow14" sourceRef="task5" targetRef="exclusiveGateway5"/>

     <exclusiveGateway id="exclusiveGateway5">
       <incoming>sequenceFlow14</incoming>
       <outgoing>sequenceFlow15</outgoing>
       <outgoing>sequenceFlow16</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow15" name="ja" sourceRef="exclusiveGateway5" targetRef="endEvent1"/>
     <sequenceFlow id="sequenceFlow16" name="nein" sourceRef="exclusiveGateway5" targetRef="task9"/>

     <userTask id="task6" name="Warten auf Rückmeldung innerhalb von 28 Tagen">
       <incoming>sequenceFlow10</incoming>
       <outgoing>sequenceFlow17</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow17" sourceRef="task6" targetRef="exclusiveGateway6"/>

     <exclusiveGateway id="exclusiveGateway6">
       <incoming>sequenceFlow17</incoming>
       <outgoing>sequenceFlow18</outgoing>
       <outgoing>sequenceFlow19</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow18" name="ja" sourceRef="exclusiveGateway6" targetRef="endEvent1"/>
     <sequenceFlow id="sequenceFlow19" name="nein" sourceRef="exclusiveGateway6" targetRef="task10"/>

     <userTask id="task7" name="Überprüfen, ob der Unterschriftsort und das Datum korrekt erfasst wurden">
       <incoming>sequenceFlow12</incoming>
       <outgoing>sequenceFlow20</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow20" sourceRef="task7" targetRef="exclusiveGateway7"/>

     <exclusiveGateway id="exclusiveGateway7">
       <incoming>sequenceFlow20</incoming>
       <outgoing>sequenceFlow21</outgoing>
       <outgoing>sequenceFlow22</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow21" name="ja" sourceRef="exclusiveGateway7" targetRef="task11"/>
     <sequenceFlow id="sequenceFlow22" name="nein" sourceRef="exclusiveGateway7" targetRef="endEvent1"/>

     <userTask id="task8" name="Überprüfen, ob eine gültige Bankverbindung im System hinterlegt ist">
       <incoming>sequenceFlow13</incoming>
       <outgoing>sequenceFlow23</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow23" sourceRef="task8" targetRef="exclusiveGateway8"/>

     <exclusiveGateway id="exclusiveGateway8">
       <incoming>sequenceFlow23</incoming>
       <outgoing>sequenceFlow24</outgoing>
       <outgoing>sequenceFlow25</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow24" name="ja" sourceRef="exclusiveGateway8" targetRef="task12"/>
     <sequenceFlow id="sequenceFlow25" name="nein" sourceRef="exclusiveGateway8" targetRef="endEvent1"/>

     <userTask id="task9" name="Prüfen, ob bereits ein aktives SEPA- Mandat für die betreffende Person existiert">
       <incoming>sequenceFlow16</incoming>
       <outgoing>sequenceFlow26</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow26" sourceRef="task9" targetRef="exclusiveGateway9"/>

     <exclusiveGateway id="exclusiveGateway9">
       <incoming>sequenceFlow26</incoming>
       <outgoing>sequenceFlow27</outgoing>
       <outgoing>sequenceFlow28</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow27" name="ja" sourceRef="exclusiveGateway9" targetRef="task13"/>
     <sequenceFlow id="sequenceFlow28" name="nein" sourceRef="exclusiveGateway9" targetRef="endEvent1"/>

     <userTask id="task10" name="Anlage oder Bestätigung der Bankverbindung">
       <incoming>sequenceFlow19</incoming>
       <outgoing>sequenceFlow29</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow29" sourceRef="task10" targetRef="exclusiveGateway10"/>

     <exclusiveGateway id="exclusiveGateway10">
       <incoming>sequenceFlow29</incoming>
       <outgoing>sequenceFlow30</outgoing>
       <outgoing>sequenceFlow31</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow30" name="ja" sourceRef="exclusiveGateway10" targetRef="endEvent1"/>
     <sequenceFlow id="sequenceFlow31" name="nein" sourceRef="exclusiveGateway10" targetRef="task14"/>

     <userTask id="task11" name="Prüfen auf offene Forderungen">
       <incoming>sequenceFlow21</incoming>
       <outgoing>sequenceFlow32</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow32" sourceRef="task11" targetRef="exclusiveGateway11"/>

     <exclusiveGateway id="exclusiveGateway11">
       <incoming>sequenceFlow32</incoming>
       <outgoing>sequenceFlow33</outgoing>
       <outgoing>sequenceFlow34</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow33" name="ja" sourceRef="exclusiveGateway11" targetRef="task15"/>
     <sequenceFlow id="sequenceFlow34" name="nein" sourceRef="exclusiveGateway11" targetRef="endEvent1"/>

     <userTask id="task12" name="Anlegen eines neuen Mandats">
       <incoming>sequenceFlow24</incoming>
       <outgoing>sequenceFlow35</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow35" sourceRef="task12" targetRef="exclusiveGateway12"/>

     <exclusiveGateway id="exclusiveGateway12">
       <incoming>sequenceFlow35</incoming>
       <outgoing>sequenceFlow36</outgoing>
       <outgoing>sequenceFlow37</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow36" name="ja" sourceRef="exclusiveGateway12" targetRef="endEvent1"/>
     <sequenceFlow id="sequenceFlow37" name="nein" sourceRef="exclusiveGateway12" targetRef="task16"/>

     <userTask id="task13" name="Beenden des bestehenden Mandats">
       <incoming>sequenceFlow27</incoming>
       <outgoing>sequenceFlow38</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow38" sourceRef="task13" targetRef="exclusiveGateway13"/>

     <exclusiveGateway id="exclusiveGateway13">
       <incoming>sequenceFlow38</incoming>
       <outgoing>sequenceFlow39</outgoing>
       <outgoing>sequenceFlow40</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow39" name="ja" sourceRef="exclusiveGateway13" targetRef="endEvent1"/>
     <sequenceFlow id="sequenceFlow40" name="nein" sourceRef="exclusiveGateway13" targetRef="task17"/>

     <userTask id="task14" name="Manuelle Überprüfung bei offenen Forderungen über 5.000 €">
       <incoming>sequenceFlow31</incoming>
       <outgoing>sequenceFlow41</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow41" sourceRef="task14" targetRef="exclusiveGateway14"/>

     <exclusiveGateway id="exclusiveGateway14">
       <incoming>sequenceFlow41</incoming>
       <outgoing>sequenceFlow42</outgoing>
       <outgoing>sequenceFlow43</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow42" name="ja" sourceRef="exclusiveGateway14" targetRef="endEvent1"/>
     <sequenceFlow id="sequenceFlow43" name="nein" sourceRef="exclusiveGateway14" targetRef="task18"/>

     <userTask id="task15" name="Abschluss des SEPA- Mandats">
       <incoming>sequenceFlow33</incoming>
       <outgoing>sequenceFlow44</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow44" sourceRef="task15" targetRef="endEvent1"/>

     <userTask id="task16" name="Manuelle Überprüfung bei offenen Forderungen über 5.000 €">
       <incoming>sequenceFlow37</incoming>
       <outgoing>sequenceFlow45</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow45" sourceRef="task16" targetRef="endEvent1"/>

     <userTask id="task17" name="Abschluss des SEPA- Mandats">
       <incoming>sequenceFlow40</incoming>
       <outgoing>sequenceFlow46</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow46" sourceRef="task17" targetRef="endEvent1"/>

     <userTask id="task18" name="Abschluss des SEPA- Mandats">
       <incoming>sequenceFlow43</incoming>
       <outgoing>sequenceFlow47</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow47" sourceRef="task18" targetRef="endEvent1"/>

     <endEvent id="endEvent1"/>
   </process>
 </definitions>