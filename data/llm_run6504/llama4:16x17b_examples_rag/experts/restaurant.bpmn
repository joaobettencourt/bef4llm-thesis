<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definition" 
             name="Restaurant Process"
             targetNamespace="http://example.com/bpmn">

   <process id="restaurantProcess" isExecutable="true">
     <laneSet>
       <lane id="waiterLane" name="Waiter">
         <flowNodeRef>startEvent</flowNodeRef>
         <flowNodeRef>taskOrderTaking</flowNodeRef>
         <flowNodeRef>exclusiveGateway1</flowNodeRef>
         <flowNodeRef>inclusiveGateway1</flowNodeRef>
         <flowNodeRef>taskPaying</flowNodeRef>
         <flowNodeRef>serviceTaskNotifyCook</flowNodeRef>
         <flowNodeRef>exclusiveGateway2</flowNodeRef>
         <flowNodeRef>endEvent</flowNodeRef>
       </lane>
       <lane id="cookLane" name="Cook">
         <flowNodeRef>taskPrepareFood</flowNodeRef>
       </lane>
       <lane id="customerLane" name="Customer">
         <flowNodeRef>startEventCustomer</flowNodeRef>
         <flowNodeRef>endEventCustomer</flowNodeRef>
       </lane>
     </laneSet>

     <sequenceFlow id="sf1" sourceRef="startEvent" targetRef="taskOrderTaking"/>
     <startEvent id="startEvent" name="Customer enters restaurant">
       <outgoing>sf1</outgoing>
     </startEvent>

     <userTask id="taskOrderTaking" name="Take order">
       <incoming>sf1</incoming>
       <outgoing>sf2</outgoing>
     </userTask>

     <sequenceFlow id="sf2" sourceRef="taskOrderTaking" targetRef="exclusiveGateway1"/>

     <exclusiveGateway id="exclusiveGateway1" name="Does customer need pager?">
       <incoming>sf2</incoming>
       <outgoing>sf3</outgoing>
       <outgoing>sf4</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sf3" sourceRef="exclusiveGateway1" targetRef="taskPaying">
       <conditionExpression xsi:type="tFormalExpression">yes</conditionExpression>
     </sequenceFlow>

     <userTask id="taskPaying" name="Customer pays and gets pager">
       <incoming>sf3</incoming>
       <outgoing>sf5</outgoing>
     </userTask>

     <sequenceFlow id="sf5" sourceRef="taskPaying" targetRef="serviceTaskNotifyCook"/>

     <serviceTask id="serviceTaskNotifyCook" name="Notify cook about order">
       <incoming>sf5</incoming>
       <outgoing>sf6</outgoing>
     </serviceTask>

     <sequenceFlow id="sf6" sourceRef="serviceTaskNotifyCook" targetRef="taskPrepareFood"/>

     <userTask id="taskPrepareFood" name="Prepare food">
       <incoming>sf6</incoming>
       <outgoing>sf7</outgoing>
     </userTask>

     <sequenceFlow id="sf7" sourceRef="taskPrepareFood" targetRef="exclusiveGateway2"/>

     <exclusiveGateway id="exclusiveGateway2">
       <incoming>sf7</incoming>
       <outgoing>sf8</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sf8" sourceRef="exclusiveGateway2" targetRef="endEvent"/>
     <sequenceFlow id="sf9" sourceRef="exclusiveGateway2" targetRef="taskNotifyCustomer"/>

     <userTask id="taskNotifyCustomer">
       <incoming>sf9</incoming>
     </userTask>

     <sequenceFlow id="sf10" sourceRef="taskNotifyCustomer" targetRef="endEvent"/>


     <endEvent id="endEvent" name="Food delivered to customer">
       <incoming>sf8</incoming>
     </endEvent>

     <startEvent id="startEventCustomer" name="Customer hungry">
       <outgoing>sf11</outgoing>
     </startEvent>

     <sequenceFlow id="sf11" sourceRef="startEventCustomer" targetRef="inclusiveGateway1"/>

     <inclusiveGateway id="inclusiveGateway1">
       <incoming>sf4</incoming>
       <incoming>sf11</incoming>
       <outgoing>sf12</outgoing>
     </inclusiveGateway>

     <sequenceFlow id="sf12" sourceRef="inclusiveGateway1" targetRef="endEventCustomer"/>

     <endEvent id="endEventCustomer" name="Customer eats">
       <incoming>sf12</incoming>
     </endEvent>
   </process>
</definitions>