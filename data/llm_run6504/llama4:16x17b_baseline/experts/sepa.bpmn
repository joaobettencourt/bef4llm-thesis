<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" targetNamespace="http://www.example.com">

  <process id="SEPA_Mandat_Process" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>

    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>

    <task id="Task_1" name="Prüfung IBAN">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="ExclusiveGateway_1"/>

    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
      <outgoing>SequenceFlow_4</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_1" targetRef="Task_2">
      <conditionExpression xsi:type="tFormalExpression">IBAN gültig</conditionExpression>
    </sequenceFlow>

    <task id="Task_2" name="Suche nach Person im System">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_5</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_1">
      <conditionExpression xsi:type="tFormalExpression">IBAN ungültig</conditionExpression>
    </sequenceFlow>

    <endEvent id="EndEvent_1">
      <incoming>SequenceFlow_4</incoming>
    </endEvent>

    <sequenceFlow id="SequenceFlow_5" sourceRef="Task_2" targetRef="ExclusiveGateway_2"/>

    <exclusiveGateway id="ExclusiveGateway_2">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_6</outgoing>
      <outgoing>SequenceFlow_7</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow_6" sourceRef="ExclusiveGateway_2" targetRef="Task_3">
      <conditionExpression xsi:type="tFormalExpression">alle Informationen vorhanden</conditionExpression>
    </sequenceFlow>

    <task id="Task_3" name="Prüfung Gültigkeit SEPA-Mandat">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_7" sourceRef="ExclusiveGateway_2" targetRef="Task_4">
      <conditionExpression xsi:type="tFormalExpression">nicht alle Informationen vorhanden</conditionExpression>
    </sequenceFlow>

    <task id="Task_4" name="manuelle Prüfung oder Anforderung Unterschrift">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_9</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_8" sourceRef="Task_3" targetRef="ExclusiveGateway_3"/>

    <exclusiveGateway id="ExclusiveGateway_3">
      <incoming>SequenceFlow_8</incoming>
      <outgoing>SequenceFlow_10</outgoing>
      <outgoing>SequenceFlow_11</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow_10" sourceRef="ExclusiveGateway_3" targetRef="Task_5">
      <conditionExpression xsi:type="tFormalExpression">neues Mandat anlegen</conditionExpression>
    </sequenceFlow>

    <task id="Task_5" name="Anlage neues SEPA-Mandat">
      <incoming>SequenceFlow_10</incoming>
      <outgoing>SequenceFlow_12</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_11" sourceRef="ExclusiveGateway_3" targetRef="Task_6">
      <conditionExpression xsi:type="tFormalExpression">bestehendes Mandat überprüfen</conditionExpression>
    </sequenceFlow>

    <task id="Task_6" name="Überprüfung bestehendes SEPA-Mandat">
      <incoming>SequenceFlow_11</incoming>
      <outgoing>SequenceFlow_13</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_12" sourceRef="Task_5" targetRef="Task_7"/>

    <task id="Task_7" name="Prüfung offene Forderungen">
      <incoming>SequenceFlow_12</incoming>
      <outgoing>SequenceFlow_14</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_13" sourceRef="Task_6" targetRef="Task_7"/>

    <sequenceFlow id="SequenceFlow_14" sourceRef="Task_7" targetRef="EndEvent_2">
      <conditionExpression xsi:type="tFormalExpression">Forderungen kleiner 5000€</conditionExpression>
    </sequenceFlow>

    <endEvent id="EndEvent_2">
      <incoming>SequenceFlow_14</incoming>
    </endEvent>

    <sequenceFlow id="SequenceFlow_9" sourceRef="Task_4" targetRef="ExclusiveGateway_4"/>

    <exclusiveGateway id="ExclusiveGateway_4">
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_15</outgoing>
      <outgoing>SequenceFlow_16</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow_15" sourceRef="ExclusiveGateway_4" targetRef="Task_7">
      <conditionExpression xsi:type="tFormalExpression">Rückmeldung innerhalb 28 Tage</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="SequenceFlow_16" sourceRef="ExclusiveGateway_4" targetRef="EndEvent_3">
      <conditionExpression xsi:type="tFormalExpression">keine Rückmeldung</conditionExpression>
    </sequenceFlow>

    <endEvent id="EndEvent_3">
      <incoming>SequenceFlow_16</incoming>
    </endEvent>
  </process>
</definitions>