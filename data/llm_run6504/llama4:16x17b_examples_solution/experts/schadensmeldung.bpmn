<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" targetNamespace="http://www.example.com">
  <process id="Process_1" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
      <messageEventDefinition messageRef="Message_ClaimSubmission"/>
    </startEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_ValidateClaim"/>
    <task id="Task_ValidateClaim" name="Überprüfung der Schadensmeldung auf Gültigkeit">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
      <outgoing>SequenceFlow_3</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_ValidateClaim" targetRef="EndEvent_NotValid">
      <conditionExpression xsi:type="tFormalExpression">${claimIsNotValid}</conditionExpression>
    </sequenceFlow>
    <endEvent id="EndEvent_NotValid">
      <incoming>SequenceFlow_2</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_3" sourceRef="Task_ValidateClaim" targetRef="Task_PrepareForProcessing">
      <conditionExpression xsi:type="tFormalExpression">${claimIsValid}</conditionExpression>
    </sequenceFlow>
    <task id="Task_PrepareForProcessing" name="Vorläufige Annahme durch das Kundenzentrum">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_4</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_4" sourceRef="Task_PrepareForProcessing" targetRef="Gateway_SendToDepartment"/>
    <exclusiveGateway id="Gateway_SendToDepartment">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_5</outgoing>
      <outgoing>SequenceFlow_6</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_5" sourceRef="Gateway_SendToDepartment" targetRef="Task_UpdateStatistics">
      <conditionExpression xsi:type="tFormalExpression">${updateStatistics}</conditionExpression>
    </sequenceFlow>
    <task id="Task_UpdateStatistics" name="Aufnahme des Falls in die Schadensstatistik">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_6" sourceRef="Gateway_SendToDepartment" targetRef="Task_DepartmentProcessing">
      <conditionExpression xsi:type="tFormalExpression">${sendToDepartment}</conditionExpression>
    </sequenceFlow>
    <task id="Task_DepartmentProcessing" name="Bearbeitung durch die Fachabteilung">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_8" sourceRef="Task_DepartmentProcessing" targetRef="Gateway_EscalationNeeded">
    </sequenceFlow>
    <exclusiveGateway id="Gateway_EscalationNeeded">
      <incoming>SequenceFlow_8</incoming>
      <outgoing>SequenceFlow_9</outgoing>
      <outgoing>SequenceFlow_10</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_9" sourceRef="Gateway_EscalationNeeded" targetRef="Task_LegalAssessment">
      <conditionExpression xsi:type="tFormalExpression">${escalationNeeded}</conditionExpression>
    </sequenceFlow>
    <task id="Task_LegalAssessment" name="Rechtliche Einschätzung durch einen Versicherer">
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_11</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_10" sourceRef="Gateway_EscalationNeeded" targetRef="Task_NotifyCustomer">
      <conditionExpression xsi:type="tFormalExpression">${noEscalation}</conditionExpression>
    </sequenceFlow>
    <task id="Task_NotifyCustomer" name="Abschließend wird der aktuelle Bearbeitungsstand dem Kunden mitgeteilt">
      <incoming>SequenceFlow_10</incoming>
      <outgoing>SequenceFlow_12</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_11" sourceRef="Task_LegalAssessment" targetRef="Task_NotifyCustomer">
    </sequenceFlow>
    <sequenceFlow id="SequenceFlow_12" sourceRef="Task_NotifyCustomer" targetRef="EndEvent_ProcessCompleted">
    </sequenceFlow>
    <endEvent id="EndEvent_ProcessCompleted">
      <incoming>SequenceFlow_12</incoming>
    </endEvent>
  </process>
</definitions>