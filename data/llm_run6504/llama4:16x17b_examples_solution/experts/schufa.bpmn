<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" targetNamespace="http://www.example.com">
  <process id="Process_1" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>
    <task id="Task_1" name="Scoring-anfrage senden">
        <incoming>SequenceFlow_1</incoming>
        <outgoing>SequenceFlow_2</outgoing>
      </task>
    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="EventBasedGateway_1"/>
    <eventBasedGateway id="EventBasedGateway_1">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
      <outgoing>SequenceFlow_4</outgoing>
    </eventBasedGateway>
    <sequenceFlow id="SequenceFlow_3" sourceRef="EventBasedGateway_1" targetRef="IntermediateCatchEvent_1">
    </sequenceFlow>
    <intermediateCatchEvent id="IntermediateCatchEvent_1" name="Scoring sofort ermittelt">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_5</outgoing>
      <messageEventDefinition/>
    </intermediateCatchEvent>
    <sequenceFlow id="SequenceFlow_4" sourceRef="EventBasedGateway_1" targetRef="IntermediateCatchEvent_2">
    </sequenceFlow>
    <intermediateCatchEvent id="IntermediateCatchEvent_2" name="Scoring verzögert">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_6</outgoing>
      <messageEventDefinition/>
    </intermediateCatchEvent>
    <task id="Task_2" name="Verzögerung melden">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_5" sourceRef="IntermediateCatchEvent_1" targetRef="ExclusiveGateway_1"/>
    <sequenceFlow id="SequenceFlow_6" sourceRef="IntermediateCatchEvent_2" targetRef="Task_2"/>
    <sequenceFlow id="SequenceFlow_7" sourceRef="Task_2" targetRef="EndEvent_1"/>
    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_8" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_1"/>
    <endEvent id="EndEvent_1">
      <incoming>SequenceFlow_7</incoming>
      <incoming>SequenceFlow_8</incoming>
    </endEvent>
  </process>
</definitions>