<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  id="Definitions_1" name="Repair Smartphone Screen">
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Hardware issue detected">
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="UserTask_1" name="Create account">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="UserTask_2" name="Log into account">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="ExclusiveGateway_1" name="Have an account?">
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="UserTask_3" name="Enter model and issue">
      <bpmn:incoming>SequenceFlow_9</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="ExclusiveGateway_2" name="Have all required items?">
      <bpmn:incoming>SequenceFlow_11</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_12</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="UserTask_4" name="Get second-hand tools and materials">
      <bpmn:incoming>SequenceFlow_14</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_15</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="UserTask_5" name="Purchase online">
      <bpmn:incoming>SequenceFlow_16</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_17</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="ExclusiveGateway_3" name="Have intention to write a review?">
      <bpmn:incoming>SequenceFlow_18</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_19</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_20</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="UserTask_6" name="Write review">
      <bpmn:incoming>SequenceFlow_21</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_22</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndEvent_1" name="Hardware issue fixed">
      <bpmn:incoming>SequenceFlow_23</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="UserTask_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="UserTask_1" targetRef="ExclusiveGateway_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_1" targetRef="UserTask_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="UserTask_2" targetRef="ExclusiveGateway_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="ExclusiveGateway_1" targetRef="UserTask_3"/>
    <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="UserTask_3" targetRef="ExclusiveGateway_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_7" sourceRef="ExclusiveGateway_2" targetRef="UserTask_4"/>
    <bpmn:sequenceFlow id="SequenceFlow_8" sourceRef="ExclusiveGateway_2" targetRef="UserTask_5"/>
    <bpmn:sequenceFlow id="SequenceFlow_9" sourceRef="UserTask_3" targetRef="ExclusiveGateway_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="ExclusiveGateway_2" targetRef="UserTask_4"/>
    <bpmn:sequenceFlow id="SequenceFlow_11" sourceRef="UserTask_4" targetRef="ExclusiveGateway_3"/>
    <bpmn:sequenceFlow id="SequenceFlow_12" sourceRef="ExclusiveGateway_3" targetRef="UserTask_6"/>
    <bpmn:sequenceFlow id="SequenceFlow_13" sourceRef="ExclusiveGateway_3" targetRef="EndEvent_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_14" sourceRef="UserTask_4" targetRef="ExclusiveGateway_3"/>
    <bpmn:sequenceFlow id="SequenceFlow_15" sourceRef="ExclusiveGateway_3" targetRef="UserTask_6"/>
    <bpmn:sequenceFlow id="SequenceFlow_16" sourceRef="UserTask_5" targetRef="EndEvent_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_17" sourceRef="ExclusiveGateway_2" targetRef="UserTask_5"/>
    <bpmn:sequenceFlow id="SequenceFlow_18" sourceRef="UserTask_4" targetRef="ExclusiveGateway_3"/>
    <bpmn:sequenceFlow id="SequenceFlow_19" sourceRef="ExclusiveGateway_3" targetRef="UserTask_6"/>
    <bpmn:sequenceFlow id="SequenceFlow_20" sourceRef="ExclusiveGateway_3" targetRef="EndEvent_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_21" sourceRef="UserTask_6" targetRef="EndEvent_1"/>
  </bpmn:process>
</bpmn:definitions>