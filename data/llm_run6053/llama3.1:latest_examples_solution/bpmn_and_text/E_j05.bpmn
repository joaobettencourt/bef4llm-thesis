<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   targetNamespace="http://bpmn.io/schema/bpmn"
                   id="Definitions_1">
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Check requirements for working and living in Austria">
      <outgoing>SequenceFlow_0</outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="UserTask_1" name="Organize accommodation and bank account (negotiation)">
      <incoming>SequenceFlow_0</incoming>
      <outgoing>SequenceFlow_1</outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="ExclusiveGateway_1" gatewayDirection="Converging">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
      <outgoing>SequenceFlow_3</outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="UserTask_2" name="Request visa (every x amount of months) - Rot-Weiss-Rot Card">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_4</outgoing>
    </bpmn:userTask>

    <bpmn:parallelGateway id="ParallelGateway_1" gatewayDirection="Diverging">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_5</outgoing>
      <outgoing>SequenceFlow_6</outgoing>
    </bpmn:parallelGateway>

    <bpmn:userTask id="UserTask_3" name="Open an Austrian bank account">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndEvent_1" name="Shipment prepared">
      <incoming>SequenceFlow_7</incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow_0" sourceRef="StartEvent_1" targetRef="UserTask_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="UserTask_1" targetRef="ExclusiveGateway_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="ExclusiveGateway_1" targetRef="UserTask_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_1" targetRef="ParallelGateway_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="UserTask_2" targetRef="EndEvent_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="ParallelGateway_1" targetRef="UserTask_3"/>
    <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="ParallelGateway_1" targetRef="EndEvent_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_7" sourceRef="UserTask_3" targetRef="EndEvent_1"/>
  </bpmn:process>
</bpmn:definitions>