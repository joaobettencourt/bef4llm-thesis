<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             targetNamespace="http://bpmn.io/schema/bpmn"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <collaboration id="Collaboration_1" name="Chainsaw Order Process">
    <participant id="Participant_1" processRef="Process_1" name="Customer"/>
    <participant id="Participant_2" processRef="Process_1" name="Production Chainsaw GmbH"/>
  </collaboration>
  <process id="Process_1" isExecutable="false" name="Chainsaw Order Process">
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_ID_1</outgoing>
    </startEvent>
    <sequenceFlow id="SequenceFlow_ID_1" sourceRef="StartEvent_1" targetRef="Task_1"/>
    <serviceTask id="Task_1" name="Request properties from customer">
      <incoming>SequenceFlow_ID_1</incoming>
      <outgoing>SequenceFlow_ID_2</outgoing>
    </serviceTask>
    <sequenceFlow id="SequenceFlow_ID_2" sourceRef="Task_1" targetRef="ParallelGateway_1"/>
    <parallelGateway id="ParallelGateway_1">
      <incoming>SequenceFlow_ID_2</incoming>
      <outgoing>SequenceFlow_ID_3</outgoing>
      <outgoing>SequenceFlow_ID_4</outgoing>
    </parallelGateway>
    <sequenceFlow id="SequenceFlow_ID_3" sourceRef="ParallelGateway_1" targetRef="Task_2"/>
    <serviceTask id="Task_2" name="Order guide bar">
      <incoming>SequenceFlow_ID_3</incoming>
      <outgoing>SequenceFlow_ID_5</outgoing>
    </serviceTask>
    <sequenceFlow id="SequenceFlow_ID_4" sourceRef="ParallelGateway_1" targetRef="Task_3"/>
    <serviceTask id="Task_3" name="Order chain">
      <incoming>SequenceFlow_ID_4</incoming>
      <outgoing>SequenceFlow_ID_6</outgoing>
    </serviceTask>
    <sequenceFlow id="SequenceFlow_ID_5" sourceRef="Task_2" targetRef="ExclusiveGateway_1"/>
    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>SequenceFlow_ID_5</incoming>
      <outgoing>SequenceFlow_ID_7</outgoing>
      <outgoing>SequenceFlow_ID_8</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_ID_6" sourceRef="Task_3" targetRef="ExclusiveGateway_1"/>
    <sequenceFlow id="SequenceFlow_ID_7" sourceRef="ExclusiveGateway_1" targetRef="Task_4"/>
    <serviceTask id="Task_4" name="Order color">
      <incoming>SequenceFlow_ID_7</incoming>
      <outgoing>SequenceFlow_ID_9</outgoing>
    </serviceTask>
    <sequenceFlow id="SequenceFlow_ID_8" sourceRef="ExclusiveGateway_1" targetRef="Task_5"/>
    <serviceTask id="Task_5" name="Order protective shield">
      <incoming>SequenceFlow_ID_8</incoming>
      <outgoing>SequenceFlow_ID_10</outgoing>
    </serviceTask>
    <sequenceFlow id="SequenceFlow_ID_9" sourceRef="Task_4" targetRef="ExclusiveGateway_2"/>
    <exclusiveGateway id="ExclusiveGateway_2">
      <incoming>SequenceFlow_ID_9</incoming>
      <outgoing>SequenceFlow_ID_11</outgoing>
      <outgoing>SequenceFlow_ID_12</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_ID_10" sourceRef="Task_5" targetRef="ExclusiveGateway_2"/>
    <sequenceFlow id="SequenceFlow_ID_11" sourceRef="ExclusiveGateway_2" targetRef="Task_6"/>
    <serviceTask id="Task_6" name="Order motor">
      <incoming>SequenceFlow_ID_11</incoming>
      <outgoing>SequenceFlow_ID_13</outgoing>
    </serviceTask>
    <sequenceFlow id="SequenceFlow_ID_12" sourceRef="ExclusiveGateway_2" targetRef="Task_7"/>
    <serviceTask id="Task_7" name="Inspect parts">
      <incoming>SequenceFlow_ID_12</incoming>
      <outgoing>SequenceFlow_ID_14</outgoing>
    </serviceTask>
    <sequenceFlow id="SequenceFlow_ID_13" sourceRef="Task_6" targetRef="ExclusiveGateway_3"/>
    <exclusiveGateway id="ExclusiveGateway_3">
      <incoming>SequenceFlow_ID_13</incoming>
      <outgoing>SequenceFlow_ID_15</outgoing>
      <outgoing>SequenceFlow_ID_16</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_ID_14" sourceRef="Task_7" targetRef="ExclusiveGateway_3"/>
    <sequenceFlow id="SequenceFlow_ID_15" sourceRef="ExclusiveGateway_3" targetRef="Task_8"/>
    <serviceTask id="Task_8" name="Assemble parts">
      <incoming>SequenceFlow_ID_15</incoming>
      <outgoing>SequenceFlow_ID_17</outgoing>
    </serviceTask>
    <sequenceFlow id="SequenceFlow_ID_16" sourceRef="ExclusiveGateway_3" targetRef="Task_9"/>
    <serviceTask id="Task_9" name="Send update to customer">
      <incoming>SequenceFlow_ID_16</incoming>
      <outgoing>SequenceFlow_ID_18</outgoing>
    </serviceTask>
    <sequenceFlow id="SequenceFlow_ID_17" sourceRef="Task_8" targetRef="ExclusiveGateway_4"/>
    <exclusiveGateway id="ExclusiveGateway_4">
      <incoming>SequenceFlow_ID_17</incoming>
      <outgoing>SequenceFlow_ID_19</outgoing>
      <outgoing>SequenceFlow_ID_20</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_ID_18" sourceRef="Task_9" targetRef="ExclusiveGateway_4"/>
    <sequenceFlow id="SequenceFlow_ID_19" sourceRef="ExclusiveGateway_4" targetRef="EndEvent_1"/>
    <endEvent id="EndEvent_1">
      <incoming>SequenceFlow_ID_19</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_ID_20" sourceRef="ExclusiveGateway_4" targetRef="Task_10"/>
    <serviceTask id="Task_10" name="Send chainsaw to customer">
      <incoming>SequenceFlow_ID_20</incoming>
      <outgoing>SequenceFlow_ID_21</outgoing>
    </serviceTask>
    <sequenceFlow id="SequenceFlow_ID_21" sourceRef="Task_10" targetRef="ExclusiveGateway_5"/>
    <exclusiveGateway id="ExclusiveGateway_5">
      <incoming>SequenceFlow_ID_21</incoming>
      <outgoing>SequenceFlow_ID_22</outgoing>
      <outgoing>SequenceFlow_ID_23</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_ID_22" sourceRef="ExclusiveGateway_5" targetRef="Task_11"/>
    <serviceTask id="Task_11" name="Get feedback from customer">
      <incoming>SequenceFlow_ID_22</incoming>
      <outgoing>SequenceFlow_ID_24</outgoing>
    </serviceTask>
    <sequenceFlow id="SequenceFlow_ID_23" sourceRef="ExclusiveGateway_5" targetRef="EndEvent_2"/>
    <endEvent id="EndEvent_2">
      <incoming>SequenceFlow_ID_23</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_ID_24" sourceRef="Task_11" targetRef="ExclusiveGateway_6"/>
    <exclusiveGateway id="ExclusiveGateway_6">
      <incoming>SequenceFlow_ID_24</incoming>
      <outgoing>SequenceFlow_ID_25</outgoing>
      <outgoing>SequenceFlow_ID_26</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_ID_25" sourceRef="ExclusiveGateway_6" targetRef="Task_12"/>
    <serviceTask id="Task_12" name="Set number of chainsaws needed">
      <incoming>SequenceFlow_ID_25</incoming>
      <outgoing>SequenceFlow_ID_27</outgoing>
    </serviceTask>
    <sequenceFlow id="SequenceFlow_ID_26" sourceRef="ExclusiveGateway_6" targetRef="EndEvent_3"/>
    <endEvent id="EndEvent_3">
      <incoming>SequenceFlow_ID_26</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_ID_27" sourceRef="Task_12" targetRef="ExclusiveGateway_7"/>
    <exclusiveGateway id="ExclusiveGateway_7">
      <incoming>SequenceFlow_ID_27</incoming>
      <outgoing>SequenceFlow_ID_28</outgoing>
      <outgoing>SequenceFlow_ID_29</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_ID_28" sourceRef="ExclusiveGateway_7" targetRef="Task_13"/>
    <serviceTask id="Task_13" name="Send order to customer">
      <incoming>SequenceFlow_ID_28</incoming>
      <outgoing>SequenceFlow_ID_30</outgoing>
    </serviceTask>
    <sequenceFlow id="SequenceFlow_ID_29" sourceRef="ExclusiveGateway_7" targetRef="EndEvent_4"/>
    <endEvent id="EndEvent_4">
      <incoming>SequenceFlow_ID_29</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_ID_30" sourceRef="Task_13" targetRef="ExclusiveGateway_8"/>
    <exclusiveGateway id="ExclusiveGateway_8">
      <incoming>SequenceFlow_ID_30</incoming>
      <outgoing>SequenceFlow_ID_31</outgoing>
      <outgoing>SequenceFlow_ID_32</outgoing>
    </exclusiveGateway>
  </process>
</definitions>