<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   targetNamespace="http://bpmn.io/schema/bpmn"
                   xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                   xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
                   xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <bpmn:process id="OEE" isExecutable="false">
    <startEvent id="StartEvent_1" name="Start OEE check">
      <outgoing>SequenceFlow_ID_0</outgoing>
    </startEvent>
    <sequenceFlow id="SequenceFlow_ID_0" sourceRef="StartEvent_1" targetRef="ServiceTask_1"/>
    <serviceTask id="ServiceTask_1" name="Check machine connection">
      <incoming>SequenceFlow_ID_0</incoming>
      <outgoing>SequenceFlow_ID_1</outgoing>
    </serviceTask>
    <sequenceFlow id="SequenceFlow_ID_1" sourceRef="ServiceTask_1" targetRef="ExclusiveGateway_1"/>
    <exclusiveGateway id="ExclusiveGateway_1" gatewayDirection="Diverging" name="Is the machine connected?">
      <incoming>SequenceFlow_ID_1</incoming>
      <outgoing>SequenceFlow_ID_2</outgoing>
      <outgoing>SequenceFlow_ID_3</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_ID_2" sourceRef="ExclusiveGateway_1" targetRef="ServiceTask_2"/>
    <serviceTask id="ServiceTask_2" name="Collect information from machine">
      <incoming>SequenceFlow_ID_2</incoming>
      <outgoing>SequenceFlow_ID_4</outgoing>
    </serviceTask>
    <sequenceFlow id="SequenceFlow_ID_3" sourceRef="ExclusiveGateway_1" targetRef="ExclusiveGateway_2"/>
    <exclusiveGateway id="ExclusiveGateway_2" gatewayDirection="Diverging" name="Is OEE below a certain percentage?">
      <incoming>SequenceFlow_ID_3</incoming>
      <outgoing>SequenceFlow_ID_5</outgoing>
      <outgoing>SequenceFlow_ID_6</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_ID_4" sourceRef="ServiceTask_2" targetRef="ExclusiveGateway_2"/>
    <sequenceFlow id="SequenceFlow_ID_5" sourceRef="ExclusiveGateway_2" targetRef="UserTask_1"/>
    <userTask id="UserTask_1" name="Stop the machine">
      <incoming>SequenceFlow_ID_5</incoming>
      <outgoing>SequenceFlow_ID_7</outgoing>
    </userTask>
    <sequenceFlow id="SequenceFlow_ID_6" sourceRef="ExclusiveGateway_2" targetRef="ServiceTask_3"/>
    <serviceTask id="ServiceTask_3" name="Send email to engineer">
      <incoming>SequenceFlow_ID_6</incoming>
      <outgoing>SequenceFlow_ID_8</outgoing>
    </serviceTask>
    <sequenceFlow id="SequenceFlow_ID_7" sourceRef="UserTask_1" targetRef="ExclusiveGateway_3"/>
    <exclusiveGateway id="ExclusiveGateway_3" gatewayDirection="Converging" name="">
      <incoming>SequenceFlow_ID_7</incoming>
      <incoming>SequenceFlow_ID_8</incoming>
      <outgoing>SequenceFlow_ID_9</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_ID_8" sourceRef="ServiceTask_3" targetRef="ExclusiveGateway_3"/>
    <sequenceFlow id="SequenceFlow_ID_9" sourceRef="ExclusiveGateway_3" targetRef="ServiceTask_4"/>
    <serviceTask id="ServiceTask_4" name="Restart the machine">
      <incoming>SequenceFlow_ID_9</incoming>
      <outgoing>SequenceFlow_ID_10</outgoing>
    </serviceTask>
    <sequenceFlow id="SequenceFlow_ID_10" sourceRef="ServiceTask_4" targetRef="EndEvent_1"/>
    <endEvent id="EndEvent_1" name="End OEE check">
      <incoming>SequenceFlow_ID_10</incoming>
    </endEvent>
  </bpmn:process>
</bpmn:definitions>