<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                   xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
                   xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
                   targetNamespace="http://bpmn.io/schema/bpmn" id="inspection_process_definition">
  <bpmn:process id="inspection_process" isExecutable="false">
    <startEvent id="start_event_1" name="Start Inspection">
      <outgoing>sequence_flow_1</outgoing>
    </startEvent>
    <userTask id="choose_configuration_task_2" name="Choose Configuration">
      <incoming>sequence_flow_1</incoming>
      <outgoing>sequence_flow_2</outgoing>
    </userTask>
    <serviceTask id="read_error_codes_task_3" name="Read Error Codes">
      <incoming>sequence_flow_3</incoming>
      <outgoing>sequence_flow_4</outgoing>
    </serviceTask>
    <exclusiveGateway id="error_exists_gateway_5" gatewayDirection="Diverging" name="Error Exists?">
      <incoming>sequence_flow_2</incoming>
      <outgoing>sequence_flow_5</outgoing>
      <outgoing>sequence_flow_6</outgoing>
    </exclusiveGateway>
    <serviceTask id="clear_error_codes_task_7" name="Clear Error Codes">
      <incoming>sequence_flow_7</incoming>
      <outgoing>sequence_flow_8</outgoing>
    </serviceTask>
    <parallelGateway id="inspection_gateway_9" gatewayDirection="Diverging" name="Inspection">
      <incoming>sequence_flow_9</incoming>
      <outgoing>sequence_flow_10</outgoing>
      <outgoing>sequence_flow_11</outgoing>
    </parallelGateway>
    <userTask id="write_final_report_task_12" name="Write Final Report">
      <incoming>sequence_flow_13</incoming>
      <outgoing>end_event_14</outgoing>
    </userTask>
    <endEvent id="end_event_14" name="End Inspection">
      <incoming>sequence_flow_13</incoming>
    </endEvent>
    <sequenceFlow id="sequence_flow_1" sourceRef="start_event_1" targetRef="choose_configuration_task_2"/>
    <sequenceFlow id="sequence_flow_2" sourceRef="choose_configuration_task_2" targetRef="error_exists_gateway_5"/>
    <sequenceFlow id="sequence_flow_3" sourceRef="read_error_codes_task_3" targetRef="error_exists_gateway_5"/>
    <sequenceFlow id="sequence_flow_4" sourceRef="error_exists_gateway_5" targetRef="clear_error_codes_task_7"/>
    <sequenceFlow id="sequence_flow_5" sourceRef="error_exists_gateway_5" targetRef="inspection_gateway_9"/>
    <sequenceFlow id="sequence_flow_6" sourceRef="error_exists_gateway_5" targetRef="write_final_report_task_12"/>
    <sequenceFlow id="sequence_flow_7" sourceRef="clear_error_codes_task_7" targetRef="write_final_report_task_12"/>
    <sequenceFlow id="sequence_flow_8" sourceRef="inspection_gateway_9" targetRef="read_error_codes_task_3"/>
    <sequenceFlow id="sequence_flow_9" sourceRef="write_final_report_task_12" targetRef="end_event_14"/>
    <sequenceFlow id="sequence_flow_10" sourceRef="write_final_report_task_12" targetRef="end_event_14"/>
  </bpmn:process>
</bpmn:definitions>