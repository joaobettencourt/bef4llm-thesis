<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
                  targetNamespace="http://bpmn.io/schema/bpmn" id="Definitions_1">
  <bpmn:process id="Process_1" isExecutable="false">
    <startEvent id="StartEvent_1" name="Participate Night Run">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_2"/>
    <task id="Task_2" name="Select starting block">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_3</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_3" sourceRef="Task_2" targetRef="ParallelGateway_4"/>
    <parallelGateway id="ParallelGateway_4" gatewayDirection="Diverging" name="">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_5</outgoing>
      <outgoing>SequenceFlow_6</outgoing>
    </parallelGateway>
    <sequenceFlow id="SequenceFlow_5" sourceRef="ParallelGateway_4" targetRef="Task_7"/>
    <task id="Task_7" name="Run 5 km">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_8" sourceRef="Task_7" targetRef="ParallelGateway_10"/>
    <parallelGateway id="ParallelGateway_10" gatewayDirection="Converging" name="">
      <incoming>SequenceFlow_8</incoming>
      <outgoing>SequenceFlow_11</outgoing>
      <outgoing>SequenceFlow_12</outgoing>
    </parallelGateway>
    <sequenceFlow id="SequenceFlow_11" sourceRef="ParallelGateway_10" targetRef="Task_13"/>
    <task id="Task_13" name="Start to measure time">
      <incoming>SequenceFlow_11</incoming>
      <outgoing>SequenceFlow_14</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_14" sourceRef="Task_13" targetRef="ParallelGateway_15"/>
    <parallelGateway id="ParallelGateway_15" gatewayDirection="Converging" name="">
      <incoming>SequenceFlow_14</incoming>
      <outgoing>SequenceFlow_16</outgoing>
      <outgoing>SequenceFlow_17</outgoing>
    </parallelGateway>
    <sequenceFlow id="SequenceFlow_16" sourceRef="ParallelGateway_15" targetRef="Task_18"/>
    <task id="Task_18" name="Stop to measure the time">
      <incoming>SequenceFlow_16</incoming>
      <outgoing>SequenceFlow_19</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_19" sourceRef="Task_18" targetRef="ExclusiveGateway_20"/>
    <exclusiveGateway id="ExclusiveGateway_20" gatewayDirection="Diverging" name="Took less than 25 minutes?">
      <incoming>SequenceFlow_19</incoming>
      <outgoing>SequenceFlow_21</outgoing>
      <outgoing>SequenceFlow_22</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_21" sourceRef="ExclusiveGateway_20" targetRef="Task_23"/>
    <task id="Task_23" name="Satisfied with the result">
      <incoming>SequenceFlow_21</incoming>
      <outgoing>SequenceFlow_24</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_22" sourceRef="ExclusiveGateway_20" targetRef="Task_25"/>
    <task id="Task_25" name="Do Training">
      <incoming>SequenceFlow_22</incoming>
      <outgoing>SequenceFlow_26</outgoing>
    </task>
    <exclusiveGateway id="ExclusiveGateway_27" gatewayDirection="Diverging" name="Ends workday &gt;1h before starting time?">
      <incoming>SequenceFlow_24</incoming>
      <outgoing>SequenceFlow_28</outgoing>
      <outgoing>SequenceFlow_29</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_28" sourceRef="ExclusiveGateway_27" targetRef="Task_30"/>
    <task id="Task_30" name="Go to the run from home">
      <incoming>SequenceFlow_28</incoming>
      <outgoing>SequenceFlow_31</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_29" sourceRef="ExclusiveGateway_27" targetRef="Task_32"/>
    <task id="Task_32" name="Go directly after work to the run">
      <incoming>SequenceFlow_29</incoming>
      <outgoing>SequenceFlow_33</outgoing>
    </task>
    <exclusiveGateway id="ExclusiveGateway_34" gatewayDirection="Converging" name="">
      <incoming>SequenceFlow_31</incoming>
      <incoming>SequenceFlow_33</incoming>
      <outgoing>SequenceFlow_35</outgoing>
    </exclusiveGateway>
    <parallelGateway id="ParallelGateway_36" gatewayDirection="Diverging" name="">
      <incoming>SequenceFlow_35</incoming>
      <outgoing>SequenceFlow_37</outgoing>
      <outgoing>SequenceFlow_38</outgoing>
    </parallelGateway>
    <sequenceFlow id="SequenceFlow_37" sourceRef="ParallelGateway_36" targetRef="Task_39"/>
    <task id="Task_39" name="Run the night run">
      <incoming>SequenceFlow_37</incoming>
      <outgoing>SequenceFlow_40</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_38" sourceRef="ParallelGateway_36" targetRef="Task_41"/>
    <task id="Task_41" name="Drink iso sport">
      <incoming>SequenceFlow_38</incoming>
      <outgoing>SequenceFlow_42</outgoing>
    </task>
    <parallelGateway id="ParallelGateway_43" gatewayDirection="Converging" name="">
      <incoming>SequenceFlow_40</incoming>
      <incoming>SequenceFlow_42</incoming>
      <outgoing>SequenceFlow_44</outgoing>
    </parallelGateway>
    <sequenceFlow id="SequenceFlow_44" sourceRef="ParallelGateway_43" targetRef="Task_45"/>
    <task id="Task_45" name="Receive final running time">
      <incoming>SequenceFlow_44</incoming>
      <outgoing>SequenceFlow_46</outgoing>
    </task>
    <endEvent id="EndEvent_47" name="Run finished">
      <incoming>SequenceFlow_46</incoming>
    </endEvent>
  </bpmn:process>
</bpmn:definitions>