<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             targetNamespace="http://bpmn.io/schema/bpmn"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <process id="InstructArtistToCreate3DModelPrintItOn3DPrinter" isExecutable="false">
    <startEvent id="StartEvent_1" name="Start">
      <outgoing>SequenceFlow_ID_0</outgoing>
    </startEvent>
    <userTask id="UserTask_1" name="Instruct artist to create a 3D model">
      <incoming>SequenceFlow_ID_0</incoming>
      <outgoing>SequenceFlow_ID_1</outgoing>
    </userTask>
    <exclusiveGateway id="ExclusiveGateway_1" gatewayDirection="Diverging" name="Have you the color at home?">
      <incoming>SequenceFlow_ID_1</incoming>
      <outgoing>SequenceFlow_ID_2</outgoing>
      <outgoing>SequenceFlow_ID_3</outgoing>
    </exclusiveGateway>
    <userTask id="UserTask_2" name="Tell artist what to change">
      <incoming>SequenceFlow_ID_2</incoming>
      <outgoing>SequenceFlow_ID_4</outgoing>
    </userTask>
    <exclusiveGateway id="ExclusiveGateway_2" gatewayDirection="Diverging" name="Satisfied with the result?">
      <incoming>SequenceFlow_ID_4</incoming>
      <outgoing>SequenceFlow_ID_5</outgoing>
      <outgoing>SequenceFlow_ID_6</outgoing>
    </exclusiveGateway>
    <userTask id="UserTask_3" name="Choose a plastic color for model">
      <incoming>SequenceFlow_ID_3</incoming>
      <outgoing>SequenceFlow_ID_7</outgoing>
    </userTask>
    <exclusiveGateway id="ExclusiveGateway_3" gatewayDirection="Diverging" name="Is it under 100 grams?">
      <incoming>SequenceFlow_ID_7</incoming>
      <outgoing>SequenceFlow_ID_8</outgoing>
      <outgoing>SequenceFlow_ID_9</outgoing>
    </exclusiveGateway>
    <userTask id="UserTask_4" name="Put it on your shopping list">
      <incoming>SequenceFlow_ID_8</incoming>
      <outgoing>SequenceFlow_ID_10</outgoing>
    </userTask>
    <serviceTask id="ServiceTask_1" name="Order it">
      <incoming>SequenceFlow_ID_9</incoming>
      <outgoing>SequenceFlow_ID_11</outgoing>
    </serviceTask>
    <exclusiveGateway id="ExclusiveGateway_4" gatewayDirection="Converging" name="">
      <incoming>SequenceFlow_ID_10</incoming>
      <incoming>SequenceFlow_ID_11</incoming>
      <outgoing>SequenceFlow_ID_12</outgoing>
    </exclusiveGateway>
    <serviceTask id="ServiceTask_2" name="Turn on the printer">
      <incoming>SequenceFlow_ID_12</incoming>
      <outgoing>SequenceFlow_ID_13</outgoing>
    </serviceTask>
    <serviceTask id="ServiceTask_3" name="Heat up extruder">
      <incoming>SequenceFlow_ID_13</incoming>
      <outgoing>SequenceFlow_ID_14</outgoing>
    </serviceTask>
    <serviceTask id="ServiceTask_4" name="Heat up the bed">
      <incoming>SequenceFlow_ID_14</incoming>
      <outgoing>SequenceFlow_ID_15</outgoing>
    </serviceTask>
    <serviceTask id="ServiceTask_5" name="Program generates gcode file from STL">
      <incoming>SequenceFlow_ID_15</incoming>
      <outgoing>SequenceFlow_ID_16</outgoing>
    </serviceTask>
    <parallelGateway id="ParallelGateway_1" gatewayDirection="Converging" name="">
      <incoming>SequenceFlow_ID_16</incoming>
      <incoming>SequenceFlow_ID_17</incoming>
      <incoming>SequenceFlow_ID_18</incoming>
      <outgoing>SequenceFlow_ID_19</outgoing>
    </parallelGateway>
    <serviceTask id="ServiceTask_6" name="Program executed printing">
      <incoming>SequenceFlow_ID_19</incoming>
      <outgoing>SequenceFlow_ID_20</outgoing>
    </serviceTask>
    <endEvent id="EndEvent_1" name="End">
      <incoming>SequenceFlow_ID_20</incoming>
    </endEvent>
  </process>
  <sequenceFlow id="SequenceFlow_ID_0" sourceRef="StartEvent_1" targetRef="UserTask_1"/>
  <sequenceFlow id="SequenceFlow_ID_1" sourceRef="UserTask_1" targetRef="ExclusiveGateway_1"/>
  <sequenceFlow id="SequenceFlow_ID_2" sourceRef="ExclusiveGateway_1" targetRef="UserTask_2"/>
  <sequenceFlow id="SequenceFlow_ID_3" sourceRef="ExclusiveGateway_1" targetRef="UserTask_3"/>
  <sequenceFlow id="SequenceFlow_ID_4" sourceRef="UserTask_2" targetRef="ExclusiveGateway_2"/>
  <sequenceFlow id="SequenceFlow_ID_5" sourceRef="ExclusiveGateway_2" targetRef="UserTask_4"/>
  <sequenceFlow id="SequenceFlow_ID_6" sourceRef="ExclusiveGateway_2" targetRef="ServiceTask_1"/>
  <sequenceFlow id="SequenceFlow_ID_7" sourceRef="UserTask_3" targetRef="ExclusiveGateway_3"/>
  <sequenceFlow id="SequenceFlow_ID_8" sourceRef="ExclusiveGateway_3" targetRef="UserTask_4"/>
  <sequenceFlow id="SequenceFlow_ID_9" sourceRef="ExclusiveGateway_3" targetRef="ServiceTask_1"/>
  <sequenceFlow id="SequenceFlow_ID_10" sourceRef="UserTask_4" targetRef="ExclusiveGateway_4"/>
  <sequenceFlow id="SequenceFlow_ID_11" sourceRef="ServiceTask_1" targetRef="ExclusiveGateway_4"/>
  <sequenceFlow id="SequenceFlow_ID_12" sourceRef="ExclusiveGateway_4" targetRef="ServiceTask_2"/>
  <sequenceFlow id="SequenceFlow_ID_13" sourceRef="ServiceTask_2" targetRef="ServiceTask_3"/>
  <sequenceFlow id="SequenceFlow_ID_14" sourceRef="ServiceTask_3" targetRef="ServiceTask_5"/>
  <sequenceFlow id="SequenceFlow_ID_15" sourceRef="ServiceTask_4" targetRef="ServiceTask_5"/>
  <sequenceFlow id="SequenceFlow_ID_16" sourceRef="ServiceTask_5" targetRef="ParallelGateway_1"/>
  <sequenceFlow id="SequenceFlow_ID_17" sourceRef="ParallelGateway_1" targetRef="ServiceTask_6"/>
  <sequenceFlow id="SequenceFlow_ID_18" sourceRef="ParallelGateway_1" targetRef="EndEvent_1"/>
  <sequenceFlow id="SequenceFlow_ID_19" sourceRef="ParallelGateway_1" targetRef="ServiceTask_6"/>
  <sequenceFlow id="SequenceFlow_ID_20" sourceRef="ServiceTask_6" targetRef="EndEvent_1"/>
</definitions>