<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
                  targetNamespace="http://bpmn.io/schema/bpmn" id="Definitions_1"
                  xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/BPMN20.xsd">
  <bpmn:process id="LAN_Party" isExecutable="false">
    <bpmn:startEvent id="Send_invitation" name="Send invitation">
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Select_Games" name="Select Games">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="All_games_available?" name="All games available?">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Download_games" name="Download games">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Friends_available?" name=">= 8 Friends available?">
      <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Prepare_games" name="Prepare games">
      <bpmn:incoming>SequenceFlow_7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Select_beer" name="Select beer">
      <bpmn:incoming>SequenceFlow_8</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_LAN_Party" name="End LAN Party">
      <bpmn:incoming>SequenceFlow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="Send_invitation" targetRef="Select_Games"/>
    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="Select_Games" targetRef="All_games_available?"/>
    <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="Select_Games" targetRef="All_games_available?"/>
    <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="All_games_available?" targetRef="Download_games"/>
    <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="All_games_available?" targetRef="Friends_available?"/>
    <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="Download_games" targetRef="Friends_available?"/>
    <bpmn:sequenceFlow id="SequenceFlow_7" sourceRef="Friends_available?" targetRef="Prepare_games"/>
    <bpmn:sequenceFlow id="SequenceFlow_8" sourceRef="Friends_available?" targetRef="Select_beer"/>
    <bpmn:sequenceFlow id="SequenceFlow_9" sourceRef="Prepare_games" targetRef="Select_beer"/>
    <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="Select_beer" targetRef="End_LAN_Party"/>
  </bpmn:process>
</bpmn:definitions>