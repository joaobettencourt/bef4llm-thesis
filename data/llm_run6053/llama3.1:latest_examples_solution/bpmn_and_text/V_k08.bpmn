                   targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Open E-Shop Homepage">
      <bpmn:outgoing>SequenceFlow_0iu9po7</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:manualTask id="ManualTask_0jsoxba" name="customer logs into E-Shop">
      <bpmn:incoming>SequenceFlow_0iu9po7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1dlbln9</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:serviceTask id="ServiceTask_0vaxgaa" name="customer credentials being checked by system">
      <bpmn:incoming>SequenceFlow_1dlbln9</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0kz5g1t</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway_1mpgzhg" name="succesful login?">
      <bpmn:incoming>SequenceFlow_0kz5g1t</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_14a0oky</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_1j94oja</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="ManualTask_12j0pib" name="customer selects a product">
      <bpmn:incoming>SequenceFlow_14a0oky</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_023hzxi</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:parallelGateway id="ParallelGateway_02fgrfq" name="">
      <bpmn:incoming>SequenceFlow_14a0oky</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1ujhfx4</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_023hzxi</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="ServiceTask_05ftug5" name="Payment is prepared by system">
      <bpmn:incoming>SequenceFlow_1ujhfx4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0v64x8b</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_1fx9yp3" name="Close E-Shop Homepage">
      <bpmn:incoming>SequenceFlow_0v64x8b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow_0iu9po7" sourceRef="StartEvent_1" targetRef="ManualTask_0jsoxba"/>
    <bpmn:sequenceFlow id="SequenceFlow_1dlbln9" sourceRef="ManualTask_0jsoxba" targetRef="ServiceTask_0vaxgaa"/>
    <bpmn:sequenceFlow id="SequenceFlow_0kz5g1t" sourceRef="ServiceTask_0vaxgaa" targetRef="ExclusiveGateway_1mpgzhg"/>
    <bpmn:sequenceFlow id="SequenceFlow_14a0oky" sourceRef="ExclusiveGateway_1mpgzhg" targetRef="ParallelGateway_02fgrfq"/>
    <bpmn:sequenceFlow id="SequenceFlow_023hzxi" sourceRef="ParallelGateway_02fgrfq" targetRef="ManualTask_12j0pib"/>
    <bpmn:sequenceFlow id="SequenceFlow_1ujhfx4" sourceRef="ParallelGateway_02fgrfq" targetRef="ServiceTask_05ftug5"/>
