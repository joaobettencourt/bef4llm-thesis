  </bpmn:task>
  <bpmn:endEvent name="" id="EndNoneEvent_3">
    <bpmn:incoming>SequenceFlow_11</bpmn:incoming>
  </bpmn:endEvent>
  <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="Task_2" targetRef="EndNoneEvent_1"/>
  <bpmn:task name="Process measured values" id="Task_5">
