  </bpmn:process>
  <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="Exclusive_Databased_Gateway_1" targetRef="Task_2"/>
  <bpmn:task name="Inform about the failure of the reading" id="Task_2">
    <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
