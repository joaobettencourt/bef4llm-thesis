<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_0">
    <bpmn:participant id="Participant_0" name="MSPN" processRef="Process_0"/>
    <bpmn:participant id="Participant_1" name="MSPO" processRef="Process_1"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_0" isExecutable="false">
    <bpmn:startEvent id="StartEvent_0" name="Send dismissal">
      <bpmn:outgoing>SequenceFlow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="EndEvent_1" name="Dismissal received">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow_0" sourceRef="StartEvent_0" targetRef="Task_0"/>
    <bpmn:task id="Task_0" name="Send dismissal to MSPO">
      <bpmn:incoming>SequenceFlow_0</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_2" name="Dismissal received">
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Receive dismissal">
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="EndEvent_3" name="Dismissal processed">
      <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="ExclusiveGateway_0">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="Task_0" targetRef="EndEvent_2"/>
    <bpmn:task id="Task_1" name="Reject dismissal">
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="Task_0" targetRef="EndEvent_1"/>
    <bpmn:task id="Task_2" name="Confirm dismissal">
      <bpmn:incoming>SequenceFlow_7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_0" targetRef="EndEvent_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="StartEvent_1" targetRef="ExclusiveGateway_0"/>
    <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="Task_1" targetRef="EndEvent_3"/>
    <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="ExclusiveGateway_0" targetRef="Task_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_7" sourceRef="ExclusiveGateway_0" targetRef="Task_2"/>
  </bpmn:process>
</bpmn:definitions>