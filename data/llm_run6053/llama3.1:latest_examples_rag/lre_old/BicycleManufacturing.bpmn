<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_0">
    <bpmn:participant id="Participant_0" name="Sales Department" processRef="Process_0"/>
    <bpmn:participant id="Participant_1" name="Storehouse" processRef="Process_1"/>
    <bpmn:participant id="Participant_2" name="Engineering Department" processRef="Process_2"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_0">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_1" name="Sales Department">
        <bpmn:flowNodeRef>StartEvent_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_4</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_0" name="Receive order">
      <bpmn:outgoing>SequenceFlow_15</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="ExclusiveGateway_3">
      <bpmn:incoming>SequenceFlow_15</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_16</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_4" name="Finish process instance">
      <bpmn:incoming>SequenceFlow_18</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:process id="Process_1">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_2" name="Storehouse">
        <bpmn:flowNodeRef>StartEvent_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_8</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_5" name="Process part list">
      <bpmn:outgoing>SequenceFlow_19</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_6" name="Check availability and reserve/back-order parts">
      <bpmn:incoming>SequenceFlow_19</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_8" name="Finish processing part list">
      <bpmn:incoming>SequenceFlow_21</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:process id="Process_2">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_3" name="Engineering Department">
        <bpmn:flowNodeRef>StartEvent_9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_12</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_9" name="Prepare for assembling">
      <bpmn:outgoing>SequenceFlow_22</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_10" name="Prepare everything for assembling">
      <bpmn:incoming>SequenceFlow_22</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_23</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_12" name="Finish preparing for assembling">
      <bpmn:incoming>SequenceFlow_24</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:sequenceFlow id="SequenceFlow_15" sourceRef="StartEvent_0" targetRef="ExclusiveGateway_3"/>
  <bpmn:sequenceFlow id="SequenceFlow_16" sourceRef="ExclusiveGateway_3" targetRef="Process_2"/>
  <bpmn:sequenceFlow id="SequenceFlow_17" sourceRef="ExclusiveGateway_3" targetRef="EndEvent_4"/>
  <bpmn:sequenceFlow id="SequenceFlow_18" sourceRef="Process_2" targetRef="EndEvent_4"/>
  <bpmn:sequenceFlow id="SequenceFlow_19" sourceRef="StartEvent_5" targetRef="Task_6"/>
  <bpmn:sequenceFlow id="SequenceFlow_20" sourceRef="Task_6" targetRef="ExclusiveGateway_7"/>
  <bpmn:sequenceFlow id="SequenceFlow_21" sourceRef="ExclusiveGateway_7" targetRef="EndEvent_8"/>
  <bpmn:sequenceFlow id="SequenceFlow_22" sourceRef="StartEvent_9" targetRef="Task_10"/>
  <bpmn:sequenceFlow id="SequenceFlow_23" sourceRef="Task_10" targetRef="ExclusiveGateway_11"/>
  <bpmn:sequenceFlow id="SequenceFlow_24" sourceRef="ExclusiveGateway_11" targetRef="EndEvent_12"/>
</bpmn:definitions>