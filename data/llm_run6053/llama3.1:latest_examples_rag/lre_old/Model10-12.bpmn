<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_0">
    <bpmn:participant id="Participant_0" name="EC" processRef="Process_0"/>
    <bpmn:participant id="Participant_1" name="INQ" processRef="Process_1"/>
    <bpmn:participant id="Participant_2" name="IP" processRef="Process_2"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_0" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_1" name="">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateThrowEvent_0</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="EC tells INQ about change">
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_0" name="Notify INQ of change">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="StartEvent_1" targetRef="Task_0"/>
    <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="Task_0" targetRef="IntermediateThrowEvent_0"/>
    <bpmn:intermediateThrowEvent id="IntermediateThrowEvent_0" name="INQ notifies IP of change">
      <bpmn:outgoing>MessageFlow_1</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
  </bpmn:process>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_2" name="">
        <bpmn:flowNodeRef>IntermediateCatchEvent_0</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:messageFlow id="MessageFlow_1" sourceRef="IntermediateThrowEvent_0" targetRef="StartMessageEvent_0"/>
    <bpmn:startMessageEvent id="StartMessageEvent_0" name="INQ receives notification">
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
    </bpmn:startMessageEvent>
  </bpmn:process>
  <bpmn:process id="Process_2" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_3" name="">
        <bpmn:flowNodeRef>Task_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_0</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:messageFlow id="MessageFlow_2" sourceRef="StartMessageEvent_0" targetRef="Task_1"/>
    <bpmn:task id="Task_1" name="Check master data">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="ExclusiveGateway_0" name="Confirm or reject changes">
      <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
  </bpmn:process>
  <bpmn:endEvent id="EndEvent_0" name="Process completed">
    <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
  </bpmn:endEvent>
  <bpmn:endEvent id="EndEvent_1" name="Changes confirmed">
    <bpmn:incoming>SequenceFlow_7</bpmn:incoming>
  </bpmn:endEvent>
  <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="StartMessageEvent_0" targetRef="Task_1"/>
  <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="Task_1" targetRef="ExclusiveGateway_0"/>
  <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="ExclusiveGateway_0" targetRef="EndEvent_0"/>
  <bpmn:sequenceFlow id="SequenceFlow_7" sourceRef="ExclusiveGateway_0" targetRef="EndEvent_1"/>
</bpmn:definitions>