<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                   xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                   xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Enter model and what's broken">
      <bpmn:outgoing>SequenceFlow_14a0oky</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:sequenceFlow id="SequenceFlow_14a0oky" sourceRef="StartEvent_1" targetRef="ServiceTask_12j0pib"/>

    <bpmn:serviceTask id="ServiceTask_12j0pib" name="Get list of materials, tools and ordering choices">
      <bpmn:incoming>SequenceFlow_14a0oky</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1j94oja</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="ExclusiveGateway_0p2e5vq">
      <bpmn:incoming>SequenceFlow_1j94oja</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0kz5g1t</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="SequenceFlow_1j94oja" sourceRef="ServiceTask_12j0pib" targetRef="ExclusiveGateway_0p2e5vq"/>

    <bpmn:serviceTask id="ServiceTask_0jsoxba" name="Get instructions on how to fix phone">
      <bpmn:incoming>SequenceFlow_0kz5g1t</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0mp5byl</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="SequenceFlow_0kz5g1t" sourceRef="ExclusiveGateway_0p2e5vq" targetRef="ServiceTask_0jsoxba"/>

    <bpmn:inclusiveGateway id="InclusiveGateway_1dgb4sg">
      <bpmn:incoming>SequenceFlow_0mp5byl</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0buzwss</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <bpmn:sequenceFlow id="SequenceFlow_0mp5byl" sourceRef="ServiceTask_0jsoxba" targetRef="InclusiveGateway_1dgb4sg"/>

    <bpmn:serviceTask id="ServiceTask_05ftug5" name="Repair phone">
      <bpmn:incoming>SequenceFlow_0buzwss</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_06kfaev</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndEvent_1fx9yp3" name="Send review and/or video of repair">
      <bpmn:incoming>SequenceFlow_06kfaev</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>

</bpmn:definitions>