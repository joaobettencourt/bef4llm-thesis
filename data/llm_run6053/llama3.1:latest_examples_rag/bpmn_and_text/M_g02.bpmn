<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                   xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                   xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:collaboration id="Collaboration_0geryc1">
    <bpmn:participant id="Participant_0ygkg4f" name="Dispatch of goods&#10;Computer Hardware Shop"
                      processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Order received">
      <bpmn:outgoing>SequenceFlow_14a0oky</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="UserTask_12j0pib" name="Define requirements"
                    completionQuantity="1" implementation="##WebService" isForCompensation="false">
      <bpmn:incoming>SequenceFlow_14a0oky</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_023hzxi</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="ExclusiveGateway_1mpgzhg" name="Base model?">
      <bpmn:incoming>SequenceFlow_023hzxi</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0iu9po7</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_1xv6wk4</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="UserTask_05ftug5" name="Design individual parts"
                   completionQuantity="1" implementation="##WebService" isForCompensation="false">
      <bpmn:incoming>SequenceFlow_0iu9po7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0kz5g1t</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="ServiceTask_12j0pib" name="Order parts"
                      completionQuantity="1" implementation="##WebService" isForCompensation="false">
      <bpmn:incoming>SequenceFlow_0kz5g1t</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_035vf60</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="UserTask_0vaxgaa" name="Assemble plane"
                   completionQuantity="1" implementation="##WebService" isForCompensation="false">
      <bpmn:incoming>SequenceFlow_035vf60</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_06kfaev</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndEvent_1fx9yp3" name="Order completed">
      <bpmn:incoming>SequenceFlow_06kfaev</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow_14a0oky" sourceRef="StartEvent_1" targetRef="UserTask_12j0pib"/>
    <bpmn:sequenceFlow id="SequenceFlow_023hzxi" sourceRef="UserTask_12j0pib" targetRef="ExclusiveGateway_1mpgzhg"/>
    <bpmn:sequenceFlow id="SequenceFlow_0iu9po7" name="Yes" sourceRef="ExclusiveGateway_1mpgzhg" targetRef="UserTask_05ftug5"/>
    <bpmn:sequenceFlow id="SequenceFlow_0kz5g1t" sourceRef="UserTask_05ftug5" targetRef="ServiceTask_12j0pib"/>
    <bpmn:sequenceFlow id="SequenceFlow_035vf60" sourceRef="ServiceTask_12j0pib" targetRef="UserTask_0vaxgaa"/>
    <bpmn:sequenceFlow id="SequenceFlow_06kfaev" sourceRef="UserTask_0vaxgaa" targetRef="EndEvent_1fx9yp3"/>

  </bpmn:process>

</bpmn:definitions>