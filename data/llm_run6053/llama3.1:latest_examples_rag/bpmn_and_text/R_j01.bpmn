<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                   xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                   xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_0geryc1">
    <bpmn:participant id="Participant_0ygkg4f" name="Machine Operator" processRef="Process_1"/>
    <bpmn:participant id="Participant_1isfejc" name="Maintenance Team" processRef="Process_2"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Machine starts">
      <bpmn:outgoing>SequenceFlow_14a0oky</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_12j0pib" name="Collect machine data">
      <bpmn:incoming>SequenceFlow_14a0oky</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1j94oja</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_14a0oky" sourceRef="StartEvent_1" targetRef="Task_12j0pib"/>
    <bpmn:exclusiveGateway id="ExclusiveGateway_0p2e5vq">
      <bpmn:incoming>SequenceFlow_1j94oja</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0kz5g1t</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_1dlbln9</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_0jsoxba" name="Calculate OEE">
      <bpmn:incoming>SequenceFlow_0kz5g1t</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0mp5byl</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_1j94oja" sourceRef="Task_12j0pib" targetRef="ExclusiveGateway_0p2e5vq"/>
    <bpmn:sequenceFlow id="SequenceFlow_0kz5g1t" sourceRef="ExclusiveGateway_0p2e5vq" targetRef="Task_0jsoxba"/>
    <bpmn:task id="Task_05ftug5" name="Send email to engineer">
      <bpmn:incoming>SequenceFlow_0mp5byl</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0b2nw5c</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_1fx9yp3" name="Machine stopped">
      <bpmn:incoming>SequenceFlow_0b2nw5c</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow_0mp5byl" sourceRef="Task_0jsoxba" targetRef="Task_05ftug5"/>
    <bpmn:sequenceFlow id="SequenceFlow_1dlbln9" sourceRef="ExclusiveGateway_0p2e5vq" targetRef="EndEvent_1fx9yp3"/>
  </bpmn:process>

  <bpmn:process id="Process_2" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1ue4ryf" name="Machine restarted">
      <bpmn:outgoing>SequenceFlow_1hh6uxx</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_025ix5y" name="Continue measuring">
      <bpmn:incoming>SequenceFlow_1hh6uxx</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0bcgmh7</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_05bkud5" name="Machine disconnected">
      <bpmn:incoming>SequenceFlow_0o1wuwg</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow_1hh6uxx" sourceRef="StartEvent_1ue4ryf" targetRef="Task_025ix5y"/>
    <bpmn:exclusiveGateway id="ExclusiveGateway_0gcm22u">
      <bpmn:incoming>SequenceFlow_0bcgmh7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0wldc0t</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_0nso56z</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="EndEvent_0hrzlup" name="Machine stopped">
      <bpmn:incoming>SequenceFlow_0k0ace3</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow_0bcgmh7" sourceRef="Task_025ix5y" targetRef="ExclusiveGateway_0gcm22u"/>
    <bpmn:exclusiveGateway id="ExclusiveGateway_1v01ao7">
      <bpmn:incoming>SequenceFlow_0o1wuwg</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0o1wuwg</bpmn:outgoing>
    </bpmn:exclusiveGateway>

  </bpmn:process>
</bpmn:definitions>