<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_0geryc1">
    <bpmn:participant id="Participant_0ygkg4f" name="Lego Brick Factory"
                      processRef="Process_1"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_1viot5w" name="Design">
        <bpmn:flowNodeRef>Task_12j0pib</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1ocseyo" name="Ordering and Sorting">
        <bpmn:flowNodeRef>Task_0jsoxba</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_0vaxgaa</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1vl2igx" name="Building and Testing">
        <bpmn:flowNodeRef>Task_05ftug5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_0sl26uo</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Core Flow Elements -->
    <bpmn:startEvent id="StartEvent_1" name="Start">
      <bpmn:outgoing>SequenceFlow_14a0oky</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_12j0pib" name="Develop basic design">
      <bpmn:incoming>SequenceFlow_14a0oky</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1j94oja</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_14a0oky" sourceRef="StartEvent_1"
                       targetRef="Task_12j0pib"/>
    <bpmn:exclusiveGateway id="ExclusiveGateway_1mpgzhg" name="Order Lego sets?">
      <bpmn:incoming>SequenceFlow_1j94oja</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0iu9po7</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_1xv6wk4</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Ordering and Sorting -->
    <bpmn:task id="Task_0jsoxba" name="Order Lego sets">
      <bpmn:incoming>SequenceFlow_0iu9po7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1dlbln9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_1j94oja" sourceRef="Task_12j0pib"
                       targetRef="ExclusiveGateway_1mpgzhg"/>
    <bpmn:sequenceFlow id="SequenceFlow_0iu9po7" name="yes" sourceRef="ExclusiveGateway_1mpgzhg"
                       targetRef="Task_0jsoxba"/>
    <bpmn:task id="Task_0vaxgaa" name="Give Lego sets to children">
      <bpmn:incoming>SequenceFlow_1dlbln9</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0mp5byl</bpmn:outgoing>
    </bpmn:task>

    <!-- Building and Testing -->
    <bpmn:sequenceFlow id="SequenceFlow_1dlbln9" sourceRef="Task_0jsoxba"
                       targetRef="Task_0vaxgaa"/>
    <bpmn:exclusiveGateway id="ExclusiveGateway_1dgb4sg" name="Build subcomponent?">
      <bpmn:incoming>SequenceFlow_0mp5byl</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0buzwss</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Subcomponents -->
    <bpmn:task id="Task_05ftug5" name="Build subcomponent">
      <bpmn:incoming>SequenceFlow_0buzwss</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_06kfaev</bpmn:outgoing>
    </bpmn:task>

    <!-- Testing and Assembling -->
    <bpmn:sequenceFlow id="SequenceFlow_0mp5byl" sourceRef="Task_0vaxgaa"
                       targetRef="ExclusiveGateway_1dgb4sg"/>
    <bpmn:exclusiveGateway id="ExclusiveGateway_1ouv9kf">
      <bpmn:incoming>SequenceFlow_06kfaev</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_035vf60</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Redesign and Rebuild -->
    <bpmn:endEvent id="EndEvent_1fx9yp3" name="Finish">
      <bpmn:incoming>SequenceFlow_0v64x8b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_0sl26uo" name="Test subcomponent">
      <bpmn:incoming>SequenceFlow_06kfaev</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0v64x8b</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_1j94oja" sourceRef="Task_12j0pib"
                       targetRef="ExclusiveGateway_1mpgzhg"/>
    <bpmn:sequenceFlow id="SequenceFlow_0iu9po7" name="yes" sourceRef="ExclusiveGateway_1mpgzhg"
                       targetRef="Task_0jsoxba"/>
    <bpmn:sequenceFlow id="SequenceFlow_1dlbln9" sourceRef="Task_0jsoxba"
                       targetRef="Task_0vaxgaa"/>
    <bpmn:sequenceFlow id="SequenceFlow_0mp5byl" sourceRef="Task_0vaxgaa"
                       targetRef="ExclusiveGateway_1dgb4sg"/>
    <bpmn:sequenceFlow id="SequenceFlow_06kfaev" sourceRef="Task_05ftug5"
                       targetRef="ExclusiveGateway_1ouv9kf"/>
    <bpmn:sequenceFlow id="SequenceFlow_0v64x8b" sourceRef="Task_0sl26uo"
                       targetRef="EndEvent_1fx9yp3"/>
  </bpmn:process>
</bpmn:definitions>