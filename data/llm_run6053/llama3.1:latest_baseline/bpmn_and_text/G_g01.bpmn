<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_0geryc1">
    <bpmn:participant id="Participant_0ygkg4f" name="Host of LAN Party"
                      processRef="Process_1"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_1viot5w" name="Preparation">
        <bpmn:flowNodeRef>Task_12j0pib</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_0p2e5vq</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1ocseyo" name="Game and Beer">
        <bpmn:flowNodeRef>Task_0jsoxba</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_0vaxgaa</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Core Flow Elements -->
    <bpmn:startEvent id="StartEvent_1" name="Plan LAN Party">
      <bpmn:outgoing>SequenceFlow_14a0oky</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_12j0pib" name="Send Invitations to 10 Friends">
      <bpmn:incoming>SequenceFlow_14a0oky</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1j94oja</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="ExclusiveGateway_0p2e5vq" name="Check Date">
      <bpmn:incoming>SequenceFlow_1j94oja</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_023hzxi</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_1dlbln9</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Core Flow Elements -->
    <bpmn:task id="Task_0jsoxba" name="Find out which games are wanted">
      <bpmn:incoming>SequenceFlow_023hzxi</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0mp5byl</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_14a0oky" sourceRef="StartEvent_1"
                       targetRef="Task_12j0pib"/>
    <bpmn:sequenceFlow id="SequenceFlow_1j94oja" name="8 or more people agree on date"
                       sourceRef="Task_12j0pib" targetRef="ExclusiveGateway_0p2e5vq"/>
    <bpmn:sequenceFlow id="SequenceFlow_023hzxi" sourceRef="ExclusiveGateway_0p2e5vq"
                       targetRef="Task_0jsoxba"/>
    <bpmn:sequenceFlow id="SequenceFlow_1dlbln9" name="not enough people agree on date"
                       sourceRef="ExclusiveGateway_0p2e5vq" targetRef="Task_12j0pib"/>

    <!-- Core Flow Elements -->
    <bpmn:task id="Task_0vaxgaa" name="Check if all games are available">
      <bpmn:incoming>SequenceFlow_0mp5byl</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1rss71o</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_0mp5byl" sourceRef="Task_0jsoxba"
                       targetRef="Task_0vaxgaa"/>
    <bpmn:exclusiveGateway id="ExclusiveGateway_1dgb4sg" name="Check Beer">
      <bpmn:incoming>SequenceFlow_1rss71o</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0buzwss</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Core Flow Elements -->
    <bpmn:task id="Task_05ftug5" name="Download missing games">
      <bpmn:incoming>SequenceFlow_1rss71o</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0kz5g1t</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_1rss71o" sourceRef="Task_0vaxgaa"
                       targetRef="ExclusiveGateway_1dgb4sg"/>
    <bpmn:sequenceFlow id="SequenceFlow_0kz5g1t" sourceRef="Task_05ftug5"
                       targetRef="ExclusiveGateway_1dgb4sg"/>

    <!-- Core Flow Elements -->
    <bpmn:task id="Task_0sl26uo" name="Buy missing beer">
      <bpmn:incoming>SequenceFlow_0buzwss</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_06kfaev</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_1fx9yp3" name="Enjoy LAN Party">
      <bpmn:incoming>SequenceFlow_06kfaev</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Core Flow Elements -->
    <bpmn:sequenceFlow id="SequenceFlow_0buzwss" sourceRef="ExclusiveGateway_1dgb4sg"
                       targetRef="Task_0sl26uo"/>
    <bpmn:sequenceFlow id="SequenceFlow_06kfaev" sourceRef="Task_0sl26uo"
                       targetRef="EndEvent_1fx9yp3"/>
  </bpmn:process>
</bpmn:definitions>