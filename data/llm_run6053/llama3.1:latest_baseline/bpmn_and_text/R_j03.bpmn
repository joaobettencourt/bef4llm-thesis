  </bpmn:process>
  <bpmn:process id="Process_2" isExecutable="false">
    <bpmn:startEvent id="StartEvent_2" name="Central service center receives request">
      <bpmn:outgoing>SequenceFlow_1dlbln9</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="SequenceFlow_1dlbln9" sourceRef="StartEvent_2" targetRef="Task_0jsoxba" />
