  <bpmn:exclusiveGateway id="ExclusiveGateway_1mpgzhg">
    <bpmn:incoming>SequenceFlow_035vf60</bpmn:incoming>
    <bpmn:outgoing>SequenceFlow_0iu9po7</bpmn:outgoing>
