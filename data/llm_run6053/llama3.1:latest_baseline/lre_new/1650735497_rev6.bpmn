<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_0geryc1">
    <bpmn:participant id="Participant_0ygkg4f" name="PayPal Client" processRef="Process_1"/>
    <bpmn:participant id="Participant_1j9kq6o" name="PayPal System" processRef="Process_1"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_1viot5w" name="PayPal Client"/>
      <bpmn:lane id="Lane_1ocseyo" name="PayPal System"/>
    </bpmn:laneSet>
    <!-- PayPal client enters bank details -->
    <bpmn:startEvent id="StartEvent_1" name="Enter Bank Details">
      <bpmn:outgoing>SequenceFlow_14a0oky</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="SequenceFlow_14a0oky" sourceRef="StartEvent_1" targetRef="Task_12j0pib"/>
    <!-- PayPal client submits bank details to PayPal system -->
    <bpmn:task id="Task_12j0pib" name="Submit Bank Details">
      <bpmn:incoming>SequenceFlow_14a0oky</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1j94oja</bpmn:outgoing>
    </bpmn:task>
    <!-- PayPal system makes two random deposits in bank account -->
    <bpmn:sequenceFlow id="SequenceFlow_1j94oja" sourceRef="Task_12j0pib" targetRef="Task_0vaxgaa"/>
    <bpmn:task id="Task_0vaxgaa" name="Make Random Deposits">
      <bpmn:incoming>SequenceFlow_1j94oja</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_023hzxi</bpmn:outgoing>
    </bpmn:task>
    <!-- PayPal system sends message to client bank account -->
    <bpmn:sequenceFlow id="SequenceFlow_023hzxi" sourceRef="Task_0vaxgaa" targetRef="Task_1e6hvnj"/>
    <bpmn:task id="Task_1e6hvnj" name="Send Message to Client Bank Account">
      <bpmn:incoming>SequenceFlow_023hzxi</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0kz5g1t</bpmn:outgoing>
    </bpmn:task>
    <!-- PayPal client checks bank account for received deposits -->
    <bpmn:sequenceFlow id="SequenceFlow_0kz5g1t" sourceRef="Task_1e6hvnj" targetRef="Task_05ftug5"/>
    <bpmn:task id="Task_05ftug5" name="Check Bank Account">
      <bpmn:incoming>SequenceFlow_0kz5g1t</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_035vf60</bpmn:outgoing>
    </bpmn:task>
    <!-- PayPal client verifies bank account -->
    <bpmn:sequenceFlow id="SequenceFlow_035vf60" sourceRef="Task_05ftug5" targetRef="Task_0sl26uo"/>
    <bpmn:task id="Task_0sl26uo" name="Verify Bank Account">
      <bpmn:incoming>SequenceFlow_035vf60</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_06kfaev</bpmn:outgoing>
    </bpmn:task>
    <!-- PayPal system checks values against client's entries -->
    <bpmn:sequenceFlow id="SequenceFlow_06kfaev" sourceRef="Task_0sl26uo" targetRef="ExclusiveGateway_1mpgzhg"/>
    <bpmn:exclusiveGateway id="ExclusiveGateway_1mpgzhg">
      <bpmn:incoming>SequenceFlow_06kfaev</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0iu9po7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <!-- If values match, bank account is linked to client's PayPal account -->
    <bpmn:sequenceFlow id="SequenceFlow_0iu9po7" sourceRef="ExclusiveGateway_1mpgzhg" targetRef="EndEvent_1"/>
    <bpmn:endEvent id="EndEvent_1" name="Bank Account Linked">
      <bpmn:incoming>SequenceFlow_0iu9po7</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>