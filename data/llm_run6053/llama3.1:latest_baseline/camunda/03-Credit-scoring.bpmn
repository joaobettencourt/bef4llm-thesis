<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_0geryc1">
    <bpmn:participant id="Participant_0ygkg4f" name="Banking System"
                      processRef="Process_1"/>
    <bpmn:participant id="Participant_1jsoxba" name="Credit Protection Agency"
                      processRef="Process_2"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:startEvent id="StartEvent_0" name="Receive credit-scoring request">
      <bpmn:outgoing>SequenceFlow_14a0oky</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="SequenceFlow_14a0oky" sourceRef="StartEvent_0"
                       targetRef="Task_12j0pib"/>
    <bpmn:task id="Task_12j0pib" name="Send scoring request to agency">
      <bpmn:incoming>SequenceFlow_14a0oky</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1j94oja</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_1j94oja" sourceRef="Task_12j0pib"
                       targetRef="ExclusiveGateway_0p2e5vq"/>
    <bpmn:exclusiveGateway id="ExclusiveGateway_0p2e5vq">
      <bpmn:incoming>SequenceFlow_1j94oja</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_023hzxi</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_1dlbln9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="SequenceFlow_023hzxi" sourceRef="ExclusiveGateway_0p2e5vq"
                       targetRef="Task_0jsoxba"/>
    <bpmn:task id="Task_0jsoxba" name="Receive quick scoring result">
      <bpmn:incoming>SequenceFlow_023hzxi</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0mp5byl</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_1dlbln9" sourceRef="ExclusiveGateway_0p2e5vq"
                       targetRef="Task_0vaxgaa"/>
    <bpmn:task id="Task_0vaxgaa" name="Receive delayed scoring result">
      <bpmn:incoming>SequenceFlow_1dlbln9</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0kz5g1t</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_0mp5byl" sourceRef="Task_0jsoxba"
                       targetRef="ExclusiveGateway_1dgb4sg"/>
    <bpmn:exclusiveGateway id="ExclusiveGateway_1dgb4sg">
      <bpmn:incoming>SequenceFlow_0mp5byl</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_035vf60</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="SequenceFlow_0kz5g1t" sourceRef="Task_0vaxgaa"
                       targetRef="ExclusiveGateway_1dgb4sg"/>
    <bpmn:endEvent id="EndEvent_0" name="Display result to clerk">
      <bpmn:incoming>SequenceFlow_035vf60</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:process id="Process_2" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Receive scoring request from banking system">
      <bpmn:outgoing>SequenceFlow_14a0oky</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="SequenceFlow_14a0oky" sourceRef="StartEvent_1"
                       targetRef="Task_12j0pib"/>
    <bpmn:task id="Task_12j0pib" name="Perform quick scoring">
      <bpmn:incoming>SequenceFlow_14a0oky</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1j94oja</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_1j94oja" sourceRef="Task_12j0pib"
                       targetRef="ExclusiveGateway_0p2e5vq"/>
    <bpmn:exclusiveGateway id="ExclusiveGateway_0p2e5vq">
      <bpmn:incoming>SequenceFlow_1j94oja</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_023hzxi</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="SequenceFlow_023hzxi" sourceRef="ExclusiveGateway_0p2e5vq"
                       targetRef="Task_0jsoxba"/>
    <bpmn:task id="Task_12j1pib" name="Send result to banking system">
      <bpmn:incoming>SequenceFlow_023hzxi</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0mp5byl</bpmn:outgoing>
    </bpmn:task>
  </bpmn:process>
</bpmn:definitions>