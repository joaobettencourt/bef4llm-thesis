<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_0geryc1">
    <bpmn:participant id="Participant_0ygkg4f" name="Bank" processRef="Process_1"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_1viot5w" name="Bank">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_12j0pib</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_0p2e5vq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_0s79ile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_1mpgzhg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1fx9yp3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Core Flow Elements -->
    <bpmn:startEvent id="StartEvent_1" name="Scoringanfrage an Schufa senden">
      <bpmn:outgoing>SequenceFlow_14a0oky</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task to send Scoring request to Schufa -->
    <bpmn:task id="Task_12j0pib" name="Scoringanfrage an Schufa senden">
      <bpmn:incoming>SequenceFlow_14a0oky</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1j94oja</bpmn:outgoing>
    </bpmn:task>

    <!-- Inclusive Gateway for Level 1 Scoring -->
    <bpmn:inclusiveGateway id="InclusiveGateway_0p2e5vq">
      <bpmn:incoming>SequenceFlow_1j94oja</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_023hzxi</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_1dlbln9</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Sequence Flow for Level 1 Scoring -->
    <bpmn:sequenceFlow id="SequenceFlow_14a0oky" sourceRef="StartEvent_1" targetRef="Task_12j0pib"/>
    <bpmn:sequenceFlow id="SequenceFlow_1j94oja" sourceRef="Task_12j0pib" targetRef="InclusiveGateway_0p2e5vq"/>
    <bpmn:sequenceFlow id="SequenceFlow_023hzxi" sourceRef="InclusiveGateway_0p2e5vq" targetRef="Task_0s79ile"/>
    <bpmn:sequenceFlow id="SequenceFlow_1dlbln9" sourceRef="InclusiveGateway_0p2e5vq" targetRef="Task_05ftug5"/>

    <!-- Task to display Scoring result to Vertriebsmitarbeiter -->
    <bpmn:task id="Task_0s79ile" name="Scoringergebnis an Vertriebsmitarbeiter anzeigen">
      <bpmn:incoming>SequenceFlow_023hzxi</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0iu9po7</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway for Verzögerung -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_1mpgzhg">
      <bpmn:incoming>SequenceFlow_0iu9po7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_035vf60</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flow for Verzögerung -->
    <bpmn:sequenceFlow id="SequenceFlow_0iu9po7" sourceRef="Task_0s79ile" targetRef="ExclusiveGateway_1mpgzhg"/>
    <bpmn:sequenceFlow id="SequenceFlow_035vf60" sourceRef="ExclusiveGateway_1mpgzhg" targetRef="EndEvent_1fx9yp3"/>

    <!-- Task to perform Level 2 Scoring -->
    <bpmn:task id="Task_05ftug5" name="Level 2 Scoring durchführen">
      <bpmn:incoming>SequenceFlow_1dlbln9</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0v64x8b</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow for Level 2 Scoring Result -->
    <bpmn:sequenceFlow id="SequenceFlow_1dlbln9" sourceRef="InclusiveGateway_0p2e5vq" targetRef="Task_05ftug5"/>
    <bpmn:sequenceFlow id="SequenceFlow_0v64x8b" sourceRef="Task_05ftug5" targetRef="EndEvent_1fx9yp3"/>

  </bpmn:process>
</bpmn:definitions>