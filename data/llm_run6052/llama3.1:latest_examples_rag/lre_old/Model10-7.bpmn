<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" 
                  id="Definitions_1"
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_0" name="MSPO" processRef="Process_0"/>
    <bpmn:participant id="Participant_1" name="GO" processRef="Process_1"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_0" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_0" name="">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateThrowEvent_0</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Deregister">
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_0" name="Deregister">
      <bpmn:incoming>SequenceFlow_10</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="StartEvent_1" targetRef="Task_0"/>
    <bpmn:intermediateThrowEvent id="IntermediateThrowEvent_0">
      <bpmn:incoming>SequenceFlow_11</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_12</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:sequenceFlow id="SequenceFlow_11" sourceRef="Task_0" targetRef="IntermediateThrowEvent_0"/>
    <bpmn:sequenceFlow id="SequenceFlow_12" sourceRef="IntermediateThrowEvent_0" targetRef="ExclusiveGateway_0"/>
  </bpmn:process>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_1" name="">
        <bpmn:flowNodeRef>StartEvent_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_0</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_0" name="Assignment of GO">
      <bpmn:outgoing>SequenceFlow_13</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="ExclusiveGateway_0">
      <bpmn:incoming>SequenceFlow_12</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_14</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="SequenceFlow_13" sourceRef="StartEvent_0" targetRef="ExclusiveGateway_0"/>
    <bpmn:endEvent id="EndEvent_0" name="Assignment of GO">
      <bpmn:incoming>SequenceFlow_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow_14" sourceRef="ExclusiveGateway_0" targetRef="Task_1"/>
    <bpmn:task id="Task_1" name="Reject deregistration">
      <bpmn:incoming>SequenceFlow_14</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_1" name="Assignment of GO">
      <bpmn:incoming>SequenceFlow_17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow_15" sourceRef="ExclusiveGateway_0" targetRef="Task_2"/>
    <bpmn:task id="Task_2" name="Confirm deregistration preliminarily">
      <bpmn:incoming>SequenceFlow_15</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_2" name="Assignment of GO">
      <bpmn:incoming>SequenceFlow_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow_16" sourceRef="Task_1" targetRef="EndEvent_0"/>
    <bpmn:task id="Task_3" name="Assign GO as MSP">
      <bpmn:incoming>SequenceFlow_18</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_3" name="Assignment of GO">
      <bpmn:incoming>SequenceFlow_19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow_17" sourceRef="Task_1" targetRef="EndEvent_1"/>
    <bpmn:task id="Task_4" name="Inform about the new assignment">
      <bpmn:incoming>SequenceFlow_19</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_4" name="Assignment of GO">
      <bpmn:incoming>SequenceFlow_20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow_18" sourceRef="Task_2" targetRef="Task_3"/>
    <bpmn:task id="Task_5" name="Inform about the new assignment">
      <bpmn:incoming>SequenceFlow_20</bpmn:incoming>
      <bpmn:outgoing></bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_5" name="Assignment of GO">
      <bpmn:incoming></bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow_19" sourceRef="Task_3" targetRef="Task_4"/>
    <bpmn:sequenceFlow id="SequenceFlow_20" sourceRef="Task_4" targetRef="EndEvent_4"/>
  </bpmn:process>
</bpmn:definitions>