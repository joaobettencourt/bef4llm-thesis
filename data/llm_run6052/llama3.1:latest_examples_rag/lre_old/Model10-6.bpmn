<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" 
                  id="Definitions_1"
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_0" name="MSPN" processRef="Process_0"/>
    <bpmn:participant id="Participant_1" name="MSPO" processRef="Process_1"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_0" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_MSPN" name="">
        <bpmn:flowNodeRef>StartNoneEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndNoneEvent_3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent name="" id="StartNoneEvent_1">
      <bpmn:outgoing>SequenceFlow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task name="Send dismissal" id="Task_MSPN">
      <bpmn:incoming>SequenceFlow_0</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent name="" id="EndNoneEvent_3">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent name="" id="IntermediateMessageEventThrowing_MSPN">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
  </bpmn:process>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_MSPO" name="">
        <bpmn:flowNodeRef>StartMessageEvent_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndNoneEvent_4</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent name="" id="StartMessageEvent_0">
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task name="Review dismissal" id="Task_MSPO">
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent name="" id="EndNoneEvent_4">
      <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway name="" id="ExclusiveGateway_0">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
  </bpmn:process>
  <bpmn:sequenceFlow id="SequenceFlow_0" sourceRef="StartNoneEvent_1" targetRef="Task_MSPN"/>
  <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="Task_MSPN" targetRef="IntermediateMessageEventThrowing_MSPN"/>
  <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="IntermediateMessageEventThrowing_MSPN" targetRef="EndNoneEvent_3"/>
  <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="StartMessageEvent_0" targetRef="Task_MSPO"/>
  <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="Task_MSPO" targetRef="ExclusiveGateway_0"/>
  <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="EndNoneEvent_4" targetRef=""/>
  <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="ExclusiveGateway_0" targetRef="Task_MSPO"/>
  <bpmn:sequenceFlow id="SequenceFlow_7" sourceRef="ExclusiveGateway_0" targetRef="EndNoneEvent_4"/>
</bpmn:definitions>