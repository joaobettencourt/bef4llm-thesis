<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Open E-Shop Homepage">
      <outgoing>SequenceFlow_0</outgoing>
    </bpmn:startEvent>

    <!-- User logs into the E-Shop system -->
    <bpmn:serviceTask id="ServiceTask_1" name="customer logs into E-Shop"
                      implementation="##WebService">
      <incoming>SequenceFlow_0</incoming>
      <outgoing>SequenceFlow_1</outgoing>
    </bpmn:serviceTask>

    <!-- Check if login was successful -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_1" name="succesful login?">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
      <outgoing>SequenceFlow_3</outgoing>
    </bpmn:exclusiveGateway>

    <!-- Select products -->
    <bpmn:manualTask id="ManualTask_1" name="customer selects a product"
                     isForCompensation="false">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_4</outgoing>
    </bpmn:manualTask>

    <!-- Add products to shopping cart -->
    <bpmn:manualTask id="ManualTask_2" name="customer adds product to shopping cart"
                     isForCompensation="false">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_5</outgoing>
    </bpmn:manualTask>

    <!-- Save products -->
    <bpmn:manualTask id="ManualTask_3" name="customer saves product"
                     isForCompensation="false">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </bpmn:manualTask>

    <!-- Check if all products were selected -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_2" name="has customer selected&#10;all desired products?">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_7</outgoing>
      <outgoing>SequenceFlow_8</outgoing>
    </bpmn:exclusiveGateway>

    <!-- Prepare payment and shipment -->
    <bpmn:parallelGateway id="ParallelGateway_1" name="">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_9</outgoing>
      <outgoing>SequenceFlow_10</outgoing>
    </bpmn:parallelGateway>

    <!-- Prepare payment -->
    <bpmn:serviceTask id="ServiceTask_2" name="Payment is prepared by system"
                      implementation="##WebService">
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_11</outgoing>
    </bpmn:serviceTask>

    <!-- Prepare shipment -->
    <bpmn:serviceTask id="ServiceTask_3" name="Shipment is prepared by system"
                      implementation="##WebService">
      <incoming>SequenceFlow_10</incoming>
      <outgoing>SequenceFlow_12</outgoing>
    </bpmn:serviceTask>

    <!-- Check if shipping address == billing address -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_3" name="if shipping adress == billing adress?">
      <incoming>SequenceFlow_11</incoming>
      <outgoing>SequenceFlow_13</outgoing>
      <outgoing>SequenceFlow_14</outgoing>
    </bpmn:exclusiveGateway>

    <!-- Enter independent billing address -->
    <bpmn:manualTask id="ManualTask_4" name="customer enters an independent billing adress"
                     isForCompensation="false">
      <incoming>SequenceFlow_13</incoming>
      <outgoing>SequenceFlow_15</outgoing>
    </bpmn:manualTask>

    <!-- Wait for bank confirmation -->
    <bpmn:task id="Task_1" name="customer waits until bank confirms payment"
               isForCompensation="false">
      <incoming>SequenceFlow_14</incoming>
      <outgoing>SequenceFlow_16</outgoing>
    </bpmn:task>

    <!-- Finish order -->
    <bpmn:endEvent id="EndEvent_1" name="Close E-Shop Homepage">
      <incoming>SequenceFlow_15</incoming>
      <incoming>SequenceFlow_16</incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_0" sourceRef="StartEvent_1" targetRef="ServiceTask_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="ServiceTask_1" targetRef="ExclusiveGateway_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="ExclusiveGateway_1" targetRef="ManualTask_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_1" targetRef="ParallelGateway_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="ManualTask_1" targetRef="ManualTask_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="ManualTask_2" targetRef="ManualTask_3"/>
    <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="ManualTask_3" targetRef="ExclusiveGateway_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_7" sourceRef="ExclusiveGateway_2" targetRef="ParallelGateway_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_8" sourceRef="ExclusiveGateway_2" targetRef="EndEvent_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_9" sourceRef="ParallelGateway_1" targetRef="ServiceTask_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="ParallelGateway_1" targetRef="ServiceTask_3"/>
    <bpmn:sequenceFlow id="SequenceFlow_11" sourceRef="ServiceTask_2" targetRef="ExclusiveGateway_3"/>
    <bpmn:sequenceFlow id="SequenceFlow_12" sourceRef="ServiceTask_3" targetRef="EndEvent_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_13" sourceRef="ExclusiveGateway_3" targetRef="ManualTask_4"/>
    <bpmn:sequenceFlow id="SequenceFlow_14" sourceRef="ExclusiveGateway_3" targetRef="Task_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_15" sourceRef="ManualTask_4" targetRef="EndEvent_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_16" sourceRef="Task_1" targetRef="EndEvent_1"/>
  </bpmn:process>
</bpmn:definitions>