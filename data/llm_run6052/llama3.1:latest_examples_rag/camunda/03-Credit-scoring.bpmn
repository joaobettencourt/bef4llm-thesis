    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="SequenceFlow_0r4szy8" sourceRef="Task_2aoskvj" targetRef="ExclusiveGateway_08engp6" />
    <bpmn:task id="Task_3px7j41" name="Create interim customer dataset record">
      <bpmn:incoming>SequenceFlow_07nupq9</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_06hubv1</bpmn:outgoing>
    </bpmn:task>
