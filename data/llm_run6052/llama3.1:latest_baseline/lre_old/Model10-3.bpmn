    <bpmn:task id="Task_05ftug5" name="MPOO confirms continuation">
      <bpmn:incoming>SequenceFlow_0buzwss</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_06kfaev1</bpmn:outgoing>
    </bpmn:task>
