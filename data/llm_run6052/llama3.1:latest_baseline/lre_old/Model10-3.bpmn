    <bpmn:participant id="Participant_1jsoxba" name="GO" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="MPOO deregisters at GO">
