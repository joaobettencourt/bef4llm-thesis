      <bpmn:incoming>SequenceFlow_035vf60</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow_06kfaev" sourceRef="Task_0s79ile" targetRef="EndEvent_1fx9yp3" />
