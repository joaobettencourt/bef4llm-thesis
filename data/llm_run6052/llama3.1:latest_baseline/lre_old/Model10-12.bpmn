    <bpmn:task id="Task_0jsoxba" name="IP checks if master data can be changed at desired time">
      <bpmn:incoming>SequenceFlow_1j94oja</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0mp5byl</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_0mp5byl" sourceRef="Task_0jsoxba" targetRef="Gateway_1dgb4sg" />
    <bpmn:exclusiveGateway id="Gateway_1dgb4sg">
      <bpmn:incoming>SequenceFlow_0mp5byl</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0kz5g1t</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_1pq8ub3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="SequenceFlow_0kz5g1t" sourceRef="Gateway_1dgb4sg" targetRef="Task_0e6hvnj" />
    <bpmn:task id="Task_0e6hvnj" name="IP confirms changes of INQ">
      <bpmn:incoming>SequenceFlow_0kz5g1t</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_035vf60</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_035vf60" sourceRef="Task_0e6hvnj" targetRef="EndEvent_1fx9yp3" />
    <bpmn:sequenceFlow id="SequenceFlow_1pq8ub3" sourceRef="Gateway_1dgb4sg" targetRef="Task_0s79ile" />
    <bpmn:task id="Task_0s79ile" name="IP rejects changes of INQ">
      <bpmn:incoming>SequenceFlow_1pq8ub3</bpmn:incoming>
