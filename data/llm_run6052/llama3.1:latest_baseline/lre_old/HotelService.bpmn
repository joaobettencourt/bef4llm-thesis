    <bpmn:endEvent id="EndEvent_1fx9yp3" name="Deliver food and wine to guest's room">
      <bpmn:incoming>SequenceFlow_023hzxi</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
