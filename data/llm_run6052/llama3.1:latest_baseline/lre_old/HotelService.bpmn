                  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_0geryc1">
    <bpmn:participant id="Participant_0ygkg4f" name="Room Service Manager"
                      processRef="Process_1"/>
    <bpmn:participant id="Participant_0jsoxba" name="Kitchen"
                      processRef="Process_1"/>
    <bpmn:participant id="Participant_0vaxgaa" name="Sommelier"
                      processRef="Process_1"/>
    <bpmn:participant id="Participant_0e6hvnj" name="Waiter"
                      processRef="Process_1"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Guest calls room service">
      <bpmn:outgoing>SequenceFlow_14a0oky</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="SequenceFlow_14a0oky" sourceRef="StartEvent_1"
                       targetRef="Task_12j0pib"/>
    <bpmn:task id="Task_12j0pib" name="Take down order">
      <bpmn:incoming>SequenceFlow_14a0oky</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1j94oja</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_1j94oja" sourceRef="Task_12j0pib"
                       targetRef="Task_0jsoxba"/>
    <bpmn:task id="Task_0jsoxba" name="Submit order to kitchen">
      <bpmn:incoming>SequenceFlow_1j94oja</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0mp5byl</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_0mp5byl" sourceRef="Task_0jsoxba"
                       targetRef="Task_0vaxgaa"/>
    <bpmn:task id="Task_0vaxgaa" name="Fetch wine and prepare alcoholic beverages">
      <bpmn:incoming>SequenceFlow_0mp5byl</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1rss71o</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_1rss71o" sourceRef="Task_0vaxgaa"
                       targetRef="Task_0e6hvnj"/>
    <bpmn:task id="Task_0e6hvnj" name="Assign order to waiter">
      <bpmn:incoming>SequenceFlow_1rss71o</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0kz5g1t</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_0kz5g1t" sourceRef="Task_0e6hvnj"
                       targetRef="Task_05ftug5"/>
    <bpmn:task id="Task_05ftug5" name="Ready cart">
      <bpmn:incoming>SequenceFlow_0kz5g1t</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_023hzxi</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_023hzxi" sourceRef="Task_05ftug5"
