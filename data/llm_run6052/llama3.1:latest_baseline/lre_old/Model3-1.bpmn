<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_0geryc1">
    <bpmn:participant id="Participant_0ygkg4f" name="Client Service Back Office" processRef="Process_1" />
    <bpmn:participant id="Participant_1j9wz3o" name="Queensland Police" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Warrant possession request received">
      <bpmn:outgoing>SequenceFlow_0iu9po7</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="SequenceFlow_0iu9po7" sourceRef="StartEvent_1" targetRef="Task_12j0pib" />
    <bpmn:task id="Task_12j0pib" name="Retrieve SCTT file">
      <bpmn:incoming>SequenceFlow_0iu9po7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1j94oja</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_1j94oja" sourceRef="Task_12j0pib" targetRef="Message_1kz5g1t" />
    <bpmn:message id="Message_1kz5g1t" name="Forward SCT Warrant Possession to Queensland Police">
      <bpmn:outgoing>SequenceFlow_2mp5byl</bpmn:outgoing>
    </bpmn:message>
    <bpmn:sequenceFlow id="SequenceFlow_2mp5byl" sourceRef="Message_1kz5g1t" targetRef="Task_2jsoxba" />
    <bpmn:task id="Task_2jsoxba" name="Store SCTT physical file">
      <bpmn:incoming>SequenceFlow_2mp5byl</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3dlbln9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_3dlbln9" sourceRef="Task_2jsoxba" targetRef="Message_3mp5byl" />
    <bpmn:message id="Message_3mp5byl" name="Report received from Police">
      <bpmn:incoming>SequenceFlow_3dlbln9</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4iu9po7</bpmn:outgoing>
    </bpmn:message>
    <bpmn:endEvent id="EndEvent_1" name="SCT file retrieved and stored">
      <bpmn:incoming>SequenceFlow_4iu9po7</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>