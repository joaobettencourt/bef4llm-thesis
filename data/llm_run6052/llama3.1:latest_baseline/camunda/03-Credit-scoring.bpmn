<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_0geryc1">
    <bpmn:participant id="Participant_0ygkg4f" name="Banking System"
                      processRef="Process_1"/>
    <bpmn:participant id="Participant_0jsoxba" name="Credit Protection Agency"
                      processRef="Process_2"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1_1" name="Receive credit-scoring request">
      <bpmn:outgoing>SequenceFlow_14a0oky_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="SequenceFlow_14a0oky_1" sourceRef="StartEvent_1_1"
                       targetRef="Task_12j0pib_1"/>
    <bpmn:task id="Task_12j0pib_1" name="Send scoring request to agency">
      <bpmn:incoming>SequenceFlow_14a0oky_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1j94oja_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_1j94oja_1" sourceRef="Task_12j0pib_1"
                       targetRef="ExclusiveGateway_0p2e5vq_1"/>
    <bpmn:exclusiveGateway id="ExclusiveGateway_0p2e5vq_1">
      <bpmn:incoming>SequenceFlow_1j94oja_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_023hzxi_1</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_0kz5g1t_1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="SequenceFlow_023hzxi_1" sourceRef="ExclusiveGateway_0p2e5vq_1"
                       targetRef="Task_05ftug5_1"/>
    <bpmn:task id="Task_05ftug5_1" name="Receive quick scoring result">
      <bpmn:incoming>SequenceFlow_023hzxi_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0mp5byl_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_1fx9yp3_1" name="Display result to clerk">
      <bpmn:incoming>SequenceFlow_0mp5byl_1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow_0kz5g1t_1" sourceRef="ExclusiveGateway_0p2e5vq_1"
                       targetRef="Task_0jsoxba_1"/>
    <bpmn:task id="Task_0jsoxba_1" name="Receive delay notification from agency">
      <bpmn:incoming>SequenceFlow_0kz5g1t_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0buzwss_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_1fx9yp3_2" name="Notify bank of delay">
      <bpmn:incoming>SequenceFlow_0mp5byl_1</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:process id="Process_2" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1_2" name="Receive scoring request from bank">
      <bpmn:outgoing>SequenceFlow_14a0oky_2</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="SequenceFlow_14a0oky_2" sourceRef="StartEvent_1_2"
                       targetRef="Task_12j0pib_2"/>
    <bpmn:task id="Task_12j0pib_2" name="Perform quick scoring">
      <bpmn:incoming>SequenceFlow_14a0oky_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1j94oja_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_1fx9yp3_3" name="Notify bank of delay">
      <bpmn:incoming>SequenceFlow_0mp5byl_2</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>