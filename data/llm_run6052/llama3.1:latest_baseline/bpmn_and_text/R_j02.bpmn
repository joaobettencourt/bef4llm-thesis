<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Enter machine type and serial number">
      <bpmn:outgoing>SequenceFlow_0kz5g1t</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask_0jsoxba" name="Input values for questions">
      <bpmn:incoming>SequenceFlow_0kz5g1t</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0mp5byl</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask_0vaxgaa" name="Press buttons and collect values from machine">
      <bpmn:incoming>SequenceFlow_0mp5byl</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1dlbln9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway_1mpgzhg" name="Additional questions?">
      <bpmn:incoming>SequenceFlow_1dlbln9</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0iu9po7</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_1xv6wk4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask_12j0pib" name="Input values for additional questions">
      <bpmn:incoming>SequenceFlow_0iu9po7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1pq8ub3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_1fx9yp3" name="Inspection finished">
      <bpmn:incoming>SequenceFlow_1pq8ub3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow_0kz5g1t" sourceRef="StartEvent_1" targetRef="UserTask_0jsoxba" />
    <bpmn:sequenceFlow id="SequenceFlow_0mp5byl" sourceRef="UserTask_0jsoxba" targetRef="UserTask_0vaxgaa" />
    <bpmn:sequenceFlow id="SequenceFlow_1dlbln9" sourceRef="UserTask_0vaxgaa" targetRef="ExclusiveGateway_1mpgzhg" />
    <bpmn:sequenceFlow id="SequenceFlow_0iu9po7" name="yes" sourceRef="ExclusiveGateway_1mpgzhg" targetRef="UserTask_12j0pib" />
    <bpmn:sequenceFlow id="SequenceFlow_1xv6wk4" name="no" sourceRef="ExclusiveGateway_1mpgzhg" targetRef="EndEvent_1fx9yp3" />
    <bpmn:sequenceFlow id="SequenceFlow_1pq8ub3" sourceRef="UserTask_12j0pib" targetRef="EndEvent_1fx9yp3" />
  </bpmn:process>
