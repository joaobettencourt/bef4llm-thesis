<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Read order from automatic order management system">
      <bpmn:outgoing>SequenceFlow_0kz5g1t</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="SequenceFlow_0kz5g1t" sourceRef="StartEvent_1" targetRef="Task_12j0pib"/>
    <bpmn:task id="Task_12j0pib" name="Check if first product from order is in stock">
      <bpmn:incoming>SequenceFlow_0kz5g1t</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1j94oja</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="ExclusiveGateway_1mpgzhg" name="Is product in stock?">
      <bpmn:incoming>SequenceFlow_1j94oja</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0iu9po7</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_1xv6wk4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="SequenceFlow_1j94oja" sourceRef="Task_12j0pib" targetRef="ExclusiveGateway_1mpgzhg"/>
    <bpmn:task id="Task_05ftug5" name="Withdraw product from warehouse">
      <bpmn:incoming>SequenceFlow_0iu9po7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0kz5g1t</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_0iu9po7" sourceRef="ExclusiveGateway_1mpgzhg" targetRef="Task_05ftug5"/>
    <bpmn:task id="Task_0jsoxba" name="Reorder product from wholesaler">
      <bpmn:incoming>SequenceFlow_1xv6wk4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0mp5byl</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_1xv6wk4" sourceRef="ExclusiveGateway_1mpgzhg" targetRef="Task_0jsoxba"/>
    <bpmn:serviceTask id="ServiceTask_0e6hvnj" name="Wait for product arrival">
      <bpmn:incoming>SequenceFlow_0mp5byl</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1pq8ub3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="SequenceFlow_0mp5byl" sourceRef="Task_0jsoxba" targetRef="ServiceTask_0e6hvnj"/>
    <bpmn:task id="Task_0s79ile" name="Register product in stock management system">
      <bpmn:incoming>SequenceFlow_1pq8ub3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_035vf60</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_1pq8ub3" sourceRef="ServiceTask_0e6hvnj" targetRef="Task_0s79ile"/>
    <bpmn:exclusiveGateway id="ExclusiveGateway_1ouv9kf">
      <bpmn:incoming>SequenceFlow_035vf60</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_06kfaev</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_0v64x8b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="SequenceFlow_035vf60" sourceRef="Task_0s79ile" targetRef="ExclusiveGateway_1ouv9kf"/>
    <bpmn:startEvent id="StartEvent_2" name="Check if whole order is ready for shipment">
      <bpmn:incoming>SequenceFlow_06kfaev</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0ajhekx</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="SequenceFlow_06kfaev" sourceRef="ExclusiveGateway_1ouv9kf" targetRef="StartEvent_2"/>
    <bpmn:task id="Task_0vaxgaa" name="Request courier and pack products">
      <bpmn:incoming>SequenceFlow_0ajhekx</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_023hzxi</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_0ajhekx" sourceRef="StartEvent_2" targetRef="Task_0vaxgaa"/>
    <bpmn:endEvent id="EndEvent_1fx9yp3" name="Shipment prepared">
      <bpmn:incoming>SequenceFlow_023hzxi</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow_023hzxi" sourceRef="Task_0vaxgaa" targetRef="EndEvent_1fx9yp3"/>
  </bpmn:process>
