  <bpmn:collaboration id="Collaboration_0geryc1">
    <bpmn:participant id="Participant_0ygkg4f" name="Payment Office of SSP" processRef="Process_1" />
    <bpmn:participant id="Participant_1j3kq6o" name="Registry office" processRef="Process_1" />
    <bpmn:participant id="Participant_1p5g9xu" name="Accounts Receivable Department" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Week end">
      <bpmn:outgoing>SequenceFlow_0kz5g1t</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="SequenceFlow_0kz5g1t" sourceRef="StartEvent_1" targetRef="Task_12j0pib" />
    <bpmn:task id="Task_12j0pib" name="Generate payment report">
      <bpmn:incoming>SequenceFlow_0kz5g1t</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1j94oja</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_1j94oja" sourceRef="Task_12j0pib" targetRef="Task_0jsoxba" />
    <bpmn:task id="Task_0jsoxba" name="Send payment report to clients">
      <bpmn:incoming>SequenceFlow_1j94oja</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0mp5byl</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_0mp5byl" sourceRef="Task_0jsoxba" targetRef="Task_1e6hvnj" />
    <bpmn:task id="Task_1e6hvnj" name="Send payment report to Registry office">
      <bpmn:incoming>SequenceFlow_0mp5byl</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0buzwss</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_0buzwss" sourceRef="Task_1e6hvnj" targetRef="Task_2s79ile" />
    <bpmn:task id="Task_2s79ile" name="Send payment report to Accounts Receivable Department">
      <bpmn:incoming>SequenceFlow_0buzwss</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_035vf60</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_035vf60" sourceRef="Task_2s79ile" targetRef="Task_3vaxgaa" />
    <bpmn:task id="Task_3vaxgaa" name="Generate monthly invoice for clients">
      <bpmn:incoming>SequenceFlow_035vf60</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0ajhekx</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_0ajhekx" sourceRef="Task_3vaxgaa" targetRef="Task_4e6hvnj" />
    <bpmn:task id="Task_4e6hvnj" name="Charge $35 per invoice">
