    <bpmn:sequenceFlow id="SequenceFlow_0mp5byl" sourceRef="ServiceTask_2" targetRef="ExclusiveGateway_1dgb4sg" />
    <bpmn:serviceTask id="ServiceTask_3" name="Increase retry count">
