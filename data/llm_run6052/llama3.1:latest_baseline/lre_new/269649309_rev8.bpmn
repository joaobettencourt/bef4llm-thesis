    <bpmn:sequenceFlow id="SequenceFlow_0kz5g1t" sourceRef="StartEvent_1" targetRef="ServiceTask_1" />
    <bpmn:sequenceFlow id="SequenceFlow_14a0oky" sourceRef="ServiceTask_1" targetRef="ExclusiveGateway_1mpgzhg" />
    <bpmn:serviceTask id="ServiceTask_2" name="Contact customer by phone">
      <bpmn:incoming>SequenceFlow_0iu9po7</bpmn:incoming>
