<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
	xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" 
	xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
	xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	targetNamespace="http://bpmn.io/schema/bpmn">
    <bpmn:collaboration id="Collaboration_0geryc1">
        <bpmn:participant id="Participant_0ygkg4f" name="Artist"
            processRef="Process_1"/>
        <bpmn:participant id="Participant_1d7o8xw" name="Customer"
            processRef="Process_1"/>
    </bpmn:collaboration>
    <bpmn:process id="Process_1" isExecutable="false">
        <bpmn:startEvent id="StartEvent_1" name="Create a 3D model">
            <bpmn:outgoing>SequenceFlow_14a0oky</bpmn:outgoing>
        </bpmn:startEvent>

        <bpmn:userTask id="UserTask_12j0pib" name="Instruct an artist to create a project"
            completionQuantity="1">
            <bpmn:incoming>SequenceFlow_14a0oky</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_1j94oja</bpmn:outgoing>
        </bpmn:userTask>

        <bpmn:endEvent id="EndEvent_1" name="Shipment prepared">
            <bpmn:incoming>SequenceFlow_0v64x8b</bpmn:incoming>
        </bpmn:endEvent>

        <bpmn:exclusiveGateway id="ExclusiveGateway_0p2e5vq" name="Have you enough plastic?">
            <bpmn:incoming>SequenceFlow_1j94oja</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_0kz5g1t</bpmn:outgoing>
            <bpmn:outgoing>SequenceFlow_1dlbln9</bpmn:outgoing>
        </bpmn:exclusiveGateway>

        <bpmn:userTask id="UserTask_0jsoxba" name="Tell artist what to change"
            completionQuantity="1">
            <bpmn:incoming>SequenceFlow_1dlbln9</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_0mp5byl</bpmn:outgoing>
        </bpmn:userTask>

        <bpmn:endEvent id="EndEvent_2" name="Shipment prepared">
            <bpmn:incoming>SequenceFlow_0v64x8b</bpmn:incoming>
        </bpmn:endEvent>

        <bpmn:exclusiveGateway id="ExclusiveGateway_1dgb4sg" name="Is it under 100 grams?">
            <bpmn:incoming>SequenceFlow_0mp5byl</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_0buzwss</bpmn:outgoing>
        </bpmn:exclusiveGateway>

        <bpmn:userTask id="UserTask_05ftug6" name="Put it on your shopping list"
            completionQuantity="1">
            <bpmn:incoming>SequenceFlow_0buzwss</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_06kfaev</bpmn:outgoing>
        </bpmn:userTask>

        <bpmn:endEvent id="EndEvent_3" name="Shipment prepared">
            <bpmn:incoming>SequenceFlow_0v64x8b</bpmn:incoming>
        </bpmn:endEvent>

        <bpmn:sequenceFlow id="SequenceFlow_14a0oky" sourceRef="StartEvent_1"
            targetRef="UserTask_12j0pib" name="no"/>
        <bpmn:sequenceFlow id="SequenceFlow_1j94oja" sourceRef="ExclusiveGateway_0p2e5vq"
            targetRef="UserTask_12j0pib" name="If insurance necessary"/>
        <bpmn:userTask id="UserTask_05ftug7" name="Package goods">
            <bpmn:incoming>SequenceFlow_06kfaev</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_0v64x8b</bpmn:outgoing>
        </bpmn:userTask>

        <bpmn:endEvent id="EndEvent_4" name="Shipment prepared">
            <bpmn:incoming>SequenceFlow_0v64x8b</bpmn:incoming>
        </bpmn:endEvent>

        <bpmn:sequenceFlow id="SequenceFlow_1dlbln9" sourceRef="ExclusiveGateway_0p2e5vq"
            targetRef="UserTask_0jsoxba" name="always"/>
        <bpmn:sequenceFlow id="SequenceFlow_0mp5byl" sourceRef="UserTask_0jsoxba"
            targetRef="ExclusiveGateway_1dgb4sg"/>
        <bpmn:endEvent id="EndEvent_5" name="Shipment prepared">
            <bpmn:incoming>SequenceFlow_0v64x8b</bpmn:incoming>
        </bpmn:endEvent>

    </bpmn:process>
</bpmn:definitions>