<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
	xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" 
	xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
	xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	targetNamespace="http://bpmn.io/schema/bpmn">
    <bpmn:process id="Process_1" isExecutable="false">
        <bpmn:startEvent id="StartEvent_1" name="wish to enroll in course">
            <bpmn:outgoing>SequenceFlow_0</bpmn:outgoing>
        </bpmn:startEvent>

        <bpmn:userTask id="UserTask_1" name="select course" completionQuantity="1"
            implementation="##WebService" isForCompensation="false" startQuantity="1">
            <bpmn:incoming>SequenceFlow_0</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
        </bpmn:userTask>

        <bpmn:exclusiveGateway id="ExclusiveGateway_1" name="free spots?" gatewayDirection="Diverging">
            <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
            <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
        </bpmn:exclusiveGateway>

        <bpmn:serviceTask id="ServiceTask_1" name="system shows parallel courses and dates"
            completionQuantity="1" implementation="##WebService" isForCompensation="false" startQuantity="1">
            <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
        </bpmn:serviceTask>

        <bpmn:userTask id="UserTask_2" name="select specific course" completionQuantity="1"
            implementation="##WebService" isForCompensation="false" startQuantity="1">
            <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
        </bpmn:userTask>

        <bpmn:endEvent id="EndEvent_1" name="end process">
            <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
        </bpmn:endEvent>

        <bpmn:parallelGateway id="ParallelGateway_1" gatewayDirection="Diverging" name="">
            <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
            <bpmn:outgoing>SequenceFlow_8</bpmn:outgoing>
        </bpmn:parallelGateway>

        <bpmn:endEvent id="EndEvent_2" name="end process">
            <bpmn:incoming>SequenceFlow_9</bpmn:incoming>
        </bpmn:endEvent>

        <bpmn:sequenceFlow id="SequenceFlow_0" sourceRef="StartEvent_1" targetRef="UserTask_1"
            name="" />
        <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="UserTask_1" targetRef="ExclusiveGateway_1"
            name="" />
        <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="ExclusiveGateway_1" targetRef="ServiceTask_1"
            name="yes" />
        <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_1" targetRef="UserTask_2"
            name="no" />
        <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="ServiceTask_1" targetRef="UserTask_2"
            name="" />
        <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="UserTask_2" targetRef="ParallelGateway_1"
            name="" />
        <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="ParallelGateway_1" targetRef="EndEvent_1"
            name="" />
        <bpmn:sequenceFlow id="SequenceFlow_7" sourceRef="ParallelGateway_1" targetRef="UserTask_3"
            name="" />
        <bpmn:endEvent id="EndEvent_3" name="end process">
            <bpmn:incoming>SequenceFlow_10</bpmn:incoming>
        </bpmn:endEvent>

    </bpmn:process>
</bpmn:definitions>