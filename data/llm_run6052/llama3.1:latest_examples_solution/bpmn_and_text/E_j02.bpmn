<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
	xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" 
	xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
	xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	targetNamespace="http://bpmn.io/schema/bpmn" id="Definitions_1">
    <bpmn:collaboration id="Collaboration_0geryc1">
        <bpmn:participant id="Participant_0ygkg4f" name="Parent"
            processRef="Process_1"/>
        <bpmn:participant id="Participant_1d7o8xw" name="Social Security"
            processRef="Process_1"/>
    </bpmn:collaboration>
    <bpmn:process id="Process_1" isExecutable="false">
        <bpmn:startEvent id="StartEvent_1" name="Start">
            <bpmn:outgoing>SequenceFlow_14a0oky</bpmn:outgoing>
        </bpmn:startEvent>

        <bpmn:userTask id="UserTask_12j0pib" name="Fetch information about potential models"
            completionQuantity="1" implementation="##WebService" isForCompensation="false"
            startQuantity="1">
            <bpmn:incoming>SequenceFlow_14a0oky</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_1j94oja</bpmn:outgoing>
        </bpmn:userTask>

        <bpmn:exclusiveGateway id="ExclusiveGateway_0p2e5vq" gatewayDirection="Diverging"
            name="Select model">
            <bpmn:incoming>SequenceFlow_1j94oja</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_0kz5g1t</bpmn:outgoing>
            <bpmn:outgoing>SequenceFlow_1dlbln9</bpmn:outgoing>
        </bpmn:exclusiveGateway>

        <bpmn:userTask id="UserTask_0jsoxba" name="Let parent select"
            completionQuantity="1" implementation="##WebService" isForCompensation="false"
            startQuantity="1">
            <bpmn:incoming>SequenceFlow_0kz5g1t</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_0mp5byl</bpmn:outgoing>
        </bpmn:userTask>

        <bpmn:exclusiveGateway id="ExclusiveGateway_1dgb4sg" gatewayDirection="Diverging"
            name="Parent type">
            <bpmn:incoming>SequenceFlow_0mp5byl</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_0buzwss</bpmn:outgoing>
        </bpmn:exclusiveGateway>

        <bpmn:userTask id="UserTask_05ftug5" name="Collect relevant information"
            completionQuantity="1" implementation="##WebService" isForCompensation="false"
            startQuantity="1">
            <bpmn:incoming>SequenceFlow_0buzwss</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_06kfaev</bpmn:outgoing>
        </bpmn:userTask>

        <bpmn:endEvent id="EndEvent_1fx9yp3" name="Shipment prepared">
            <bpmn:incoming>SequenceFlow_0v64x8b</bpmn:incoming>
        </bpmn:endEvent>

        <bpmn:sequenceFlow id="SequenceFlow_14a0oky" sourceRef="StartEvent_1"
            targetRef="UserTask_12j0pib"/>
        <bpmn:sequenceFlow id="SequenceFlow_1j94oja" sourceRef="ExclusiveGateway_0p2e5vq"
            targetRef="UserTask_12j0pib"/>
        <bpmn:sequenceFlow id="SequenceFlow_0kz5g1t" sourceRef="ExclusiveGateway_0p2e5vq"
            targetRef="UserTask_0jsoxba"/>
        <bpmn:sequenceFlow id="SequenceFlow_1dlbln9" sourceRef="ExclusiveGateway_0p2e5vq"
            targetRef="UserTask_0jsoxba"/>
        <bpmn:sequenceFlow id="SequenceFlow_0mp5byl" sourceRef="UserTask_0jsoxba"
            targetRef="ExclusiveGateway_1dgb4sg"/>
        <bpmn:sequenceFlow id="SequenceFlow_06kfaev" sourceRef="UserTask_05ftug5"
            targetRef="EndEvent_1fx9yp3"/>

    </bpmn:process>
</bpmn:definitions>