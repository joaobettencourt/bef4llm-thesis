<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
	xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" 
	xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
	xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	targetNamespace="http://bpmn.io/schema/bpmn" id="Definitions_1">
    <bpmn:process id="Process_1" isExecutable="false">
        <bpmn:startEvent id="StartEvent_1" name="Fridge makes strange noises">
            <bpmn:outgoing>SequenceFlow_14a0oky</bpmn:outgoing>
        </bpmn:startEvent>

        <bpmn:userTask id="UserTask_1" name="Describe the symptoms" completionQuantity="1"
            implementation="##WebService" isForCompensation="false" startQuantity="1">
            <bpmn:incoming>SequenceFlow_14a0oky</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_023hzxi</bpmn:outgoing>
        </bpmn:userTask>

        <bpmn:parallelGateway id="ParallelGateway_02fgrfq" gatewayDirection="Diverging">
            <bpmn:incoming>SequenceFlow_14a0oky</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_023hzxi</bpmn:outgoing>
            <bpmn:outgoing>SequenceFlow_1ujhfx4</bpmn:outgoing>
        </bpmn:parallelGateway>

        <bpmn:userTask id="UserTask_2" name="Select local service facility" completionQuantity="1"
            implementation="##WebService" isForCompensation="false" startQuantity="1">
            <bpmn:incoming>SequenceFlow_023hzxi</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_0kz5g1t</bpmn:outgoing>
        </bpmn:userTask>

        <bpmn:serviceTask id="ServiceTask_1" name="Schedule an appointment for fridge repair"
            implementation="##WebService" isForCompensation="false" startQuantity="1">
            <bpmn:incoming>SequenceFlow_0kz5g1t</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_14a0oky</bpmn:outgoing>
        </bpmn:serviceTask>

        <bpmn:endEvent id="EndEvent_1" name="Repair is process over">
            <bpmn:incoming>SequenceFlow_035vf60</bpmn:incoming>
        </bpmn:endEvent>

        <bpmn:userTask id="UserTask_3" name="Collect fridge type data" completionQuantity="1"
            implementation="##WebService" isForCompensation="false" startQuantity="1">
            <bpmn:incoming>SequenceFlow_1ujhfx4</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_0v64x8b</bpmn:outgoing>
        </bpmn:userTask>

        <bpmn:endEvent id="EndEvent_2" name="Rapair process over">
            <bpmn:incoming>SequenceFlow_0v64x8b</bpmn:incoming>
        </bpmn:endEvent>

        <bpmn:exclusiveGateway id="ExclusiveGateway_1mpgzhg" gatewayDirection="Diverging"
            name="Additional parts needed?">
            <bpmn:incoming>SequenceFlow_035vf60</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_0iu9po7</bpmn:outgoing>
            <bpmn:outgoing>SequenceFlow_1xv6wk4</bpmn:outgoing>
        </bpmn:exclusiveGateway>

        <bpmn:endEvent id="EndEvent_3" name="Rapair process over">
            <bpmn:incoming>SequenceFlow_0iu9po7</bpmn:incoming>
        </bpmn:endEvent>

        <bpmn:userTask id="UserTask_4" name="Collect additional parts in warehouse"
            completionQuantity="1" implementation="##WebService" isForCompensation="false"
            startQuantity="1">
            <bpmn:incoming>SequenceFlow_1xv6wk4</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_06kfaev</bpmn:outgoing>
        </bpmn:userTask>

        <bpmn:endEvent id="EndEvent_4" name="Rapair process over">
            <bpmn:incoming>SequenceFlow_06kfaev</bpmn:incoming>
        </bpmn:endEvent>

        <bpmn:sequenceFlow id="SequenceFlow_14a0oky" sourceRef="StartEvent_1"
            targetRef="ParallelGateway_02fgrfq" name="yes" />
        <bpmn:sequenceFlow id="SequenceFlow_023hzxi" sourceRef="ParallelGateway_02fgrfq"
            targetRef="UserTask_2" name="always" />
        <bpmn:sequenceFlow id="SequenceFlow_1ujhfx4" sourceRef="ParallelGateway_02fgrfq"
            targetRef="UserTask_3" name="yes" />
        <bpmn:sequenceFlow id="SequenceFlow_0kz5g1t" sourceRef="UserTask_2"
            targetRef="ServiceTask_1" name="always" />
        <bpmn:sequenceFlow id="SequenceFlow_035vf60" sourceRef="ExclusiveGateway_1mpgzhg"
            targetRef="EndEvent_1" name="yes" />
        <bpmn:sequenceFlow id="SequenceFlow_0iu9po7" sourceRef="ExclusiveGateway_1mpgzhg"
            targetRef="EndEvent_3" name="no" />
        <bpmn:sequenceFlow id="SequenceFlow_1xv6wk4" sourceRef="ExclusiveGateway_1mpgzhg"
            targetRef="UserTask_4" name="yes" />
        <bpmn:sequenceFlow id="SequenceFlow_06kfaev" sourceRef="UserTask_4"
            targetRef="EndEvent_4" name="always" />

    </bpmn:process>
</bpmn:definitions>