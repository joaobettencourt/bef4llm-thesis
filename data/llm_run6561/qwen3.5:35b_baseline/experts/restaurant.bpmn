<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Restaurant_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_Restaurant_1">
    <bpmn:participant id="Participant_Restaurant_1" name="Restaurant Prozess" processRef="Process_Restaurant_1" />
  </bpmn:collaboration>

  <bpmn:process id="Process_Restaurant_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Gast_1" name="Gast">
        <bpmn:flowNodeRef>StartEvent_Eintritt_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WahlGericht_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PickerStatus_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_EssenVerzehrt_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Angestellte_1" name="Angestellte">
        <bpmn:flowNodeRef>Task_BestellungAufgeben_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_KassierenPieberUeberreichen_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Warte5Minuten_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GastRufen_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Koch_1" name="Küche">
        <bpmn:flowNodeRef>StartEvent_BestellungErhalten_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MahlzeitZubereiten_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_EssenInDurchreicheStellen_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Guest Lane -->
    <bpmn:startEvent id="StartEvent_Eintritt_1" name="Gast betritt Restaurant">
      <bpmn:outgoing>SequenceFlow_WahlGericht_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_WahlGericht_1" name="Gericht auswählen aus Angebot">
      <bpmn:incoming>SequenceFlow_WahlGericht_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BestellungAufgeben_1</bpmn:outgoing>
    </bpmn:task>

    <!-- Staff Lane -->
    <bpmn:sequenceFlow id="SequenceFlow_WahlGericht_1" sourceRef="StartEvent_Eintritt_1" targetRef="Task_WahlGericht_1" />

    <bpmn:task id="Task_BestellungAufgeben_1" name="Bestellung beim Angestellten aufgeben">
      <bpmn:incoming>SequenceFlow_BestellungAufgeben_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_KassierenPieberUeberreichen_1</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_BestellungAufgeben_1" sourceRef="Task_WahlGericht_1" targetRef="Task_BestellungAufgeben_1" />

    <bpmn:task id="Task_KassierenPieberUeberreichen_1" name="Kassen &amp; Pieper einrichten">
      <bpmn:incoming>SequenceFlow_KassierenPieberUeberreichen_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InformiereKoch_1</bpmn:outgoing>
    </bpmn:task>

    <!-- Kitchen Lane -->
    <bpmn:startEvent id="StartEvent_BestellungErhalten_1" name="Bestellung erhalten">
      <bpmn:outgoing>SequenceFlow_Zubereiten_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_MahlzeitZubereiten_1" name="Mahlzeit zubereiten">
      <bpmn:incoming>SequenceFlow_Zubereiten_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DurchreicheStellen_1</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event for Food in Pass-through -->
    <bpmn:endEvent id="EndEvent_EssenInDurchreicheStellen_1" name="Essen in Durchreich">
      <bpmn:incoming>SequenceFlow_DurchreicheStellen_1</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Staff Lane - Trigger Pager -->
    <bpmn:task id="Task_PieberAusloesen_1" name="Pieper auslösen">
      <bpmn:incoming>SequenceFlow_EssenFertig_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Warte5MinutenStart_1</bpmn:outgoing>
    </bpmn:task>

    <!-- Exception Handling - Timer -->
    <bpmn:intermediateCatchEvent id="Event_Warte5Minuten_1" name="Warte 5 Minuten">
      <bpmn:incoming>SequenceFlow_Warte5MinutenStart_1</bpmn:incoming>
      <bpmn:outgoing>Gateway_PickerStatus_1</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Gateway for Pickup Status -->
    <bpmn:xorGateway id="Gateway_PickerStatus_1">
      <bpmn:incoming>SequenceFlow_Warte5MinutenStart_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GastHoltAb_1</bpmn:outgoing>
    </bpmn:xorGateway>

    <!-- Guest Lane - Collect and Eat -->
    <bpmn:endEvent id="EndEvent_EssenVerzehrt_1" name="Essen verzehrt">
      <bpmn:incoming>SequenceFlow_GastHoltAb_1</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_KassierenPieberUeberreichen_1" sourceRef="Task_BestellungAufgeben_1" targetRef="Task_KassierenPieberUeberreichen_1" />
    
    <bpmn:sequenceFlow id="SequenceFlow_InformiereKoch_1" name="Informiere Koch über Bestellung">
      <!-- Staff informs cook -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_Zubereiten_1" sourceRef="StartEvent_BestellungErhalten_1" targetRef="Task_MahlzeitZubereiten_1" />
    
    <bpmn:sequenceFlow id="SequenceFlow_DurchreicheStellen_1" name="Essen in Durchreich stellen">
      <!-- Cook places food -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_EssenFertig_1" sourceRef="EndEvent_EssenInDurchreicheStellen_1" targetRef="Task_PieberAusloesen_1">
      <!-- Staff triggers pager when food ready -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_Warte5MinutenStart_1" sourceRef="Task_PieberAusloesen_1" targetRef="Event_Warte5Minuten_1">
      <!-- Start timer for guest response -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_GastHoltAb_1" name="Gast holt Essen ab">
      <!-- Guest collects food and eats -->
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>