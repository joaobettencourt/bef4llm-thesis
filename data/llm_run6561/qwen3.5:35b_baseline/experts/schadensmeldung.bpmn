<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Versicherung" name="Versicherungsabwicklung" processRef="Process_Schadensfall"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Schadensfall" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="Start_EingereichtSchadenmeldung" name="Schadensmeldung eingereicht">
      <bpmn:outgoing>Flow_StartValiditaet</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Validity Check -->
    <bpmn:task id="Task_PruefenGueltigkeit" name="Gültigkeit überprüfen">
      <bpmn:incoming>Flow_StartValiditaet</bpmn:incoming>
      <bpmn:outgoing>Flow_ValiditaetsGateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Validity Decision -->
    <bpmn:xorGateway id="Gateway_Gueltigkeit">
      <bpmn:incoming>Flow_ValiditaetsGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Ablehnung</bpmn:outgoing>
      <bpmn:outgoing>Flow_BearbeitungsStart</bpmn:outgoing>
    </bpmn:xorGateway>

    <!-- Path A: Invalid Claim -->
    <bpmn:endEvent id="End_Ablehnung" name="Prozess abgeschlossen (Ablehnung)">
      <bpmn:incoming>Flow_KundeInformieren</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Path B: Valid Claim -->
    <bpmn:startEvent id="Start_Bearbeitungsstart" name="">
      <bpmn:outgoing>Flow_StatistikErfassen</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 2: Inform Customer (Invalid) -->
    <bpmn:task id="Task_KundeInformierenAblehnung" name="Kunde informieren">
      <bpmn:incoming>Flow_Ablehnung</bpmn:incoming>
      <bpmn:outgoing>Flow_KundeInformieren</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3: Document Control -->
    <bpmn:task id="Task_DokumentePruefen" name="Unterlagen auf Vollständigkeit prüfen">
      <bpmn:incoming>Flow_BearbeitungsStart</bpmn:incoming>
      <bpmn:outgoing>Flow_VorlaeufigAnnahme</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 4: Forward to Specialist -->
    <bpmn:task id="Task_WeiterleitenFachabteilung" name="An Fachabteilung weiterleiten">
      <bpmn:incoming>Flow_VorlaeufigAnnahme</bpmn:incoming>
      <bpmn:outgoing>Flow_TiefenValidierung</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 5: Deep Validation -->
    <bpmn:task id="Task_SchadensursacheUntersuchen" name="Schadensursache untersuchen">
      <bpmn:incoming>Flow_TiefenValidierung</bpmn:incoming>
      <bpmn:outgoing>Gateway_RechtlicheEinschaetzung</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2: Legal Assessment Decision -->
    <bpmn:xorGateway id="Gateway_RechtlicheEinschaetzung">
      <bpmn:incoming>Flow_SchadensursacheUntersuchen</bpmn:incoming>
      <bpmn:outgoing>Flow_VersichererInformieren</bpmn:outgoing>
      <bpmn:outgoing>Flow_StatistikAktualisieren</bpmn:outgoing>
    </bpmn:xorGateway>

    <!-- Task 6: Legal Assessment -->
    <bpmn:task id="Task_RechtlicheEinschaetzung" name="Rechtliche Einschätzung einholen">
      <bpmn:incoming>Flow_VersichererInformieren</bpmn:incoming>
      <bpmn:outgoing>Flow_StatistikAktualisieren</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 7: Request Additional Info -->
    <bpmn:task id="Task_ZusaetzlicheInfoEinholen" name="Zusätzliche Informationen einholen">
      <bpmn:incoming>Flow_StatistikAktualisieren</bpmn:incoming>
      <bpmn:outgoing>Flow_KundeInformierenStatus</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 8: Update Statistics -->
    <bpmn:task id="Task_StatistikAktualisieren" name="Schadensstatistik aktualisieren">
      <bpmn:incoming>Flow_VersichererInformieren</bpmn:incoming>
      <bpmn:outgoing>Flow_KundeInformierenStatus</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 9: Inform Customer -->
    <bpmn:endEvent id="End_ProzessAbgeschlossen" name="Prozess abgeschlossen">
      <bpmn:incoming>Flow_KundeInformierenStatus</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task 10: Register in Statistics -->
    <bpmn:startEvent id="Start_StatistikErfassen" name="">
      <bpmn:outgoing>Flow_TiefenValidierung</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Flow_StartValiditaet" sourceRef="Start_EingereichtSchadenmeldung" targetRef="Task_PruefenGueltigkeit"/>
    
    <bpmn:sequenceFlow id="Flow_ValiditaetsGateway" name="" sourceRef="Task_PruefenGueltigkeit" targetRef="Gateway_Gueltigkeit">
      <bpmn:name>Gültigkeitsprüfung</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_Ablehnung" name="" sourceRef="Gateway_Gueltigkeit" targetRef="Task_KundeInformierenAblehnung">
      <bpmn:name>Nicht gültig</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_BearbeitungsStart" name="" sourceRef="Gateway_Gueltigkeit" targetRef="Task_DokumentePruefen">
      <bpmn:name>Gültig</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_KundeInformieren" name="" sourceRef="Task_KundeInformierenAblehnung" targetRef="End_Ablehnung">
      <bpmn:name>Kunde informieren</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_StatistikErfassen" name="" sourceRef="Start_Bearbeitungsstart" targetRef="Task_DokumentePruefen">
      <bpmn:name>Fall erfassen</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_VorlaeufigAnnahme" name="" sourceRef="Task_DokumentePruefen" targetRef="Task_WeiterleitenFachabteilung">
      <bpmn:name>Vorläufige Annahme</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_TiefenValidierung" name="" sourceRef="Task_WeiterleitenFachabteilung" targetRef="Task_SchadensursacheUntersuchen">
      <bpmn:name>Tiefe Validierung</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_VersichererInformieren" name="" sourceRef="Gateway_RechtlicheEinschaetzung" targetRef="Task_StatistikAktualisieren">
      <bpmn:name>Versicherer informieren</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_SchadensursacheUntersuchen" name="" sourceRef="Gateway_RechtlicheEinschaetzung" targetRef="Task_StatistikAktualisieren">
      <bpmn:name>Erforderlich</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_KundeInformierenStatus" name="" sourceRef="Task_ZusaetzlicheInfoEinholen" targetRef="End_ProzessAbgeschlossen">
      <bpmn:name>Kunden informieren</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>