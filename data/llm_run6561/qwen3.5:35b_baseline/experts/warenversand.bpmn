<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_ShipmentProcess">
    <bpmn:participant id="Participant_ComputerShop" name="Dispatch of goods&#10;Computer Hardware Shop" processRef="Process_Shipment_0geryc1" />
  </bpmn:collaboration>

  <bpmn:process id="Process_Shipment_0geryc1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Secretary" name="Secretary">
        <bpmn:flowNodeRef>Task_ClariyShipmentMethod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CheckLargeQuantity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GetOffers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectFreightForwarder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FillPackageForm</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_LogisticsManager" name="Logistics Manager">
        <bpmn:flowNodeRef>Task_ArrangeInsurance</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_WarehouseWorker" name="Warehouse Worker">
        <bpmn:flowNodeRef>Task_PackGoods</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareForPickup</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Shipment" name="Ship goods">
      <bpmn:outgoing>SequenceFlow_StartToClarify</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Secretary Tasks and Gateway -->
    <bpmn:task id="Task_ClariyShipmentMethod" name="Clarify shipment method">
      <bpmn:incoming>SequenceFlow_StartToClarify</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ClarifyToGateway</bpmn:outgoing>
    </bpmn:task>

    <bpmn:xorGateway id="Gateway_CheckLargeQuantity" name="Special handling?">
      <bpmn:incoming>SequenceFlow_ClarifyToGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_LargeQtyPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SmallQtyPath</bpmn:outgoing>
    </bpmn:xorGateway>

    <!-- Large Quantity Path -->
    <bpmn:task id="Task_GetOffers" name="Get 3 offers from logistic companies">
      <bpmn:incoming>SequenceFlow_LargeQtyPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OfferToSelect</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_SelectFreightForwarder" name="Select logistic company and place order">
      <bpmn:incoming>SequenceFlow_OfferToSelect</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OrderedToMerge</bpmn:outgoing>
    </bpmn:task>

    <!-- Small Quantity Path -->
    <bpmn:task id="Task_FillPackageForm" name="Write package label">
      <bpmn:incoming>SequenceFlow_SmallQtyPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FormToInsuranceCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Insurance Check Gateway -->
    <bpmn:xorGateway id="Gateway_CheckInsurance" name="Insurance necessary?">
      <bpmn:incoming>SequenceFlow_FormToInsuranceCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_YesInsurancePath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoInsurancePath</bpmn:outgoing>
    </bpmn:xorGateway>

    <!-- Insurance Task -->
    <bpmn:task id="Task_ArrangeInsurance" name="Insure parcel">
      <bpmn:incoming>SequenceFlow_YesInsurancePath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InsuranceToMerge</bpmn:outgoing>
    </bpmn:task>

    <!-- Warehouse Worker Tasks -->
    <bpmn:task id="Task_PackGoods" name="Package goods">
      <bpmn:incoming>SequenceFlow_StartParallelPack</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PackedToMerge</bpmn:outgoing>
    </bpmn:task>

    <!-- Merge Gateway -->
    <bpmn:xorGateway id="Gateway_MergeAllPaths">
      <bpmn:incoming>SequenceFlow_OrderedToMerge</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_NoInsurancePath</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_InsuranceToMerge</bpmn:outgoing>
    </bpmn:xorGateway>

    <!-- Final Task -->
    <bpmn:endEvent id="EndEvent_ShipmentPrepared" name="Shipment prepared">
      <bpmn:incoming>SequenceFlow_MergeToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToClarify" sourceRef="StartEvent_Shipment" targetRef="Task_ClariyShipmentMethod" />
    
    <bpmn:parallelGateway id="ParallelGateway_StartSplit">
      <bpmn:incoming>SequenceFlow_ClarifyToGateway</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_LargeQtyPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SmallQtyPath</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Correction - need to fix the flow structure -->
  </bpmn:process>
</bpmn:definitions>