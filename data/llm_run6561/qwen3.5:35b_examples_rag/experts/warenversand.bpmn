<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_TravelRequest">
    <bpmn:participant id="Participant_ComputerHardwareShop" name="Computer Hardware Shop Shipping Process" processRef="Process_Shipping01" />
  </bpmn:collaboration>

  <bpmn:process id="Process_Shipping01" isExecutable="true">
    <bpmn:laneSet id="LaneSet_001">
      <bpmn:lane id="Lane_Secretary" name="Sekretariat">
        <bpmn:flowNodeRef>StartEvent_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VerifyShipmentMethod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_LargeQuantity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GetOffersLarge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectFreightForwarder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ShipmentType</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FillPackageFormSmall</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_LogisticsManager" name="Logistikleiter">
        <bpmn:flowNodeRef>Gateway_InsuranceRequired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ArrangeInsurance</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_WarehouseWorker" name="Lagerarbeiter">
        <bpmn:flowNodeRef>Gateway_ParallelStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PackGoods</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_001</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_FreightForwarder" name="Spediteur">
        <bpmn:flowNodeRef>Gateway_MergeAllPreparations</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_001" name="Ware soll versendet werden">
      <bpmn:outgoing>SequenceFlow_StartToSecretary</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Secretary Task - Clarify shipment method -->
    <bpmn:task id="Task_VerifyShipmentMethod" name="Klären wer Versand übernimmt">
      <bpmn:incoming>SequenceFlow_StartToSecretary</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SecretaryToLargeGateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway - Large Quantity Decision -->
    <bpmn:exclusiveGateway id="Gateway_LargeQuantity" name="Große Menge?">
      <bpmn:incoming>SequenceFlow_SecretaryToLargeGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToParallelStart</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Parallel Gateway for warehouse packing -->
    <bpmn:parallelGateway id="Gateway_ParallelStart">
      <bpmn:incoming>SequenceFlow_ToParallelStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WarehousePacking</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Warehouse Task - Pack goods -->
    <bpmn:task id="Task_PackGoods" name="Ware verpacken">
      <bpmn:incoming>SequenceFlow_WarehousePacking</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToMergeGateway1</bpmn:outgoing>
    </bpmn:task>

    <!-- Large Quantity Path - Get offers -->
    <bpmn:exclusiveGateway id="Gateway_ShipmentType" name="Sonderversand notwendig?">
      <bpmn:incoming>SequenceFlow_ToMergeGateway1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GetOffersLarge</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Secretary Task - Get offers for large quantities -->
    <bpmn:task id="Task_GetOffersLarge" name="Angebote von 3 Spediteuren einholen">
      <bpmn:incoming>SequenceFlow_ToMergeGateway1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SelectFreightForwarder</bpmn:outgoing>
    </bpmn:task>

    <!-- Secretary Task - Select freight forwarder -->
    <bpmn:task id="Task_SelectFreightForwarder" name="Spediteur auswählen und beauftragen">
      <bpmn:incoming>SequenceFlow_GetOffersLarge</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToMergeGateway2</bpmn:outgoing>
    </bpmn:task>

    <!-- Small Quantity Path - Fill package form -->
    <bpmn:exclusiveGateway id="Gateway_InsuranceRequired" name="Versicherung erforderlich?">
      <bpmn:incoming>SequenceFlow_ToMergeGateway2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FillFormSmall</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Secretary Task - Fill package form for small quantities -->
    <bpmn:task id="Task_FillPackageFormSmall" name="Standardisierten Paketschein ausfüllen">
      <bpmn:incoming>SequenceFlow_ToMergeGateway2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InsuranceCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Logistics Manager Task - Arrange insurance -->
    <bpmn:task id="Task_ArrangeInsurance" name="Versicherung abschließen">
      <bpmn:incoming>SequenceFlow_ToMergeGateway2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToEndEvent</bpmn:outgoing>
    </bpmn:task>

    <!-- Merge Gateway - All preparations complete -->
    <bpmn:inclusiveGateway id="Gateway_MergeAllPreparations" name="Alle Vorbereitungen abgeschlossen">
      <bpmn:incoming>SequenceFlow_ToMergeGateway2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GoodsReadyForPickup</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- End Event - Goods ready for pickup -->
    <bpmn:endEvent id="EndEvent_001" name="Ware zur Abholung bereitgestellt">
      <bpmn:incoming>SequenceFlow_GoodsReadyForPickup</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToSecretary" sourceRef="StartEvent_001" targetRef="Task_VerifyShipmentMethod">
      <bpmn:name>Sekretariat informiert</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Parallel flow to warehouse -->
    <bpmn:sequenceFlow id="SequenceFlow_ToParallelStart" sourceRef="Gateway_LargeQuantity" targetRef="Gateway_ParallelStart">
      <bpmn:name>always</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Warehouse packing flow -->
    <bpmn:sequenceFlow id="SequenceFlow_WarehousePacking" sourceRef="Gateway_ParallelStart" targetRef="Task_PackGoods">
      <bpmn:name>always</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Large quantity flow -->
    <bpmn:sequenceFlow id="SequenceFlow_ToMergeGateway1" sourceRef="Task_PackGoods" targetRef="Gateway_ShipmentType">
      <bpmn:name>always</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Small quantity flow -->
    <bpmn:sequenceFlow id="SequenceFlow_GetOffersLarge" sourceRef="Gateway_ShipmentType" targetRef="Task_GetOffersLarge">
      <bpmn:name>Sonderversand notwendig</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Select freight forwarder flow -->
    <bpmn:sequenceFlow id="SequenceFlow_SelectFreightForwarder" sourceRef="Task_GetOffersLarge" targetRef="Task_SelectFreightForwarder">
      <bpmn:name>always</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Return to merge gateway -->
    <bpmn:sequenceFlow id="SequenceFlow_ToMergeGateway2" sourceRef="Task_SelectFreightForwarder" targetRef="Gateway_MergeAllPreparations">
      <bpmn:name>always</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Insurance check flow -->
    <bpmn:sequenceFlow id="SequenceFlow_InsuranceCheck" sourceRef="Task_FillPackageFormSmall" targetRef="Gateway_InsuranceRequired">
      <bpmn:name>always</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Insurance arrangement flow -->
    <bpmn:sequenceFlow id="SequenceFlow_ToEndEvent" sourceRef="Task_ArrangeInsurance" targetRef="Gateway_MergeAllPreparations">
      <bpmn:name>Versicherung erforderlich</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Final flow to end event -->
    <bpmn:sequenceFlow id="SequenceFlow_GoodsReadyForPickup" sourceRef="Gateway_MergeAllPreparations" targetRef="EndEvent_001">
      <bpmn:name>All preparations complete</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>