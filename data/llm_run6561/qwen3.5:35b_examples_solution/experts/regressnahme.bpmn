<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_RegressProzess_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_Regress_1">
    <bpmn:participant id="Participant_Sachbearbeiter" name="Regressnahme Sachbearbeiter" processRef="Process_Regress_1" />
  </bpmn:collaboration>

  <bpmn:process id="Process_Regress_1" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="StartRegressVerdacht" name="Regressverdacht gemeldet">
      <bpmn:messageEventDefinition />
      <bpmn:outgoing>SequenceFlow_StartPruefen</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Case Check -->
    <bpmn:task id="Task_FallPruefen" name="Fall prüfen">
      <bpmn:incoming>SequenceFlow_StartPruefen</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GatewayRegressMoeglich</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway: Is subrogation possible? -->
    <bpmn:exclusiveGateway id="Gateway_RegressMoeglich" name="Regress möglich?">
      <bpmn:incoming>SequenceFlow_GatewayRegressMoeglich</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ZahlungsaufforderungSenden</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_VorgangSchliessenNein</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Path: No subrogation possible -->
    <bpmn:endEvent id="EndVorgangGeschlossen1" name="Vorgang geschlossen">
      <bpmn:messageEventDefinition />
      <bpmn:incoming>SequenceFlow_VorgangSchliessenNein</bpmn:outgoing>
    </bpmn:endEvent>

    <!-- Path: Subrogation possible - Send payment request -->
    <bpmn:task id="Task_ZahlungsaufforderungSenden" name="Zahlungsaufforderung an VN schicken">
      <bpmn:incoming>SequenceFlow_ZahlungsaufforderungSenden</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_WiedervorlageSetzen</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Set on follow-up review -->
    <bpmn:task id="Task_WiedervorlageSetzen" name="Vorgang auf Wiedervorlage setzen">
      <bpmn:incoming>SequenceFlow_WiedervorlageSetzen</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_EventBasedGatewayStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Event-Based Gateway for parallel waiting -->
    <bpmn:eventBasedGateway id="EventBasedGateway_Warten" name="Warte auf...">
      <bpmn:incoming>SequenceFlow_EventBasedGatewayStart</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_GeldEingegangenWait</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_WiderspruchErhaltenWait</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_FristAblaufWarten</bpmn:outgoing>
    </bpmn:eventBasedGateway>

    <!-- Path 1: Money received -->
    <bpmn:intermediateCatchEvent id="IntermediateGeldEingegangen" name="Geld eingegangen">
      <bpmn:messageEventDefinition />
      <bpmn:incoming>SequenceFlow_GeldEingegangenWait</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_EingangVerbuchen</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task: Book money entry -->
    <bpmn:task id="Task_GeldeingangVerbuchen" name="Geldeingang verbuchen">
      <bpmn:incoming>SequenceFlow_EingangVerbuchen</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_VorgangSchliessenJa1</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event for money received path -->
    <bpmn:endEvent id="EndVorgangGeschlossen2" name="Vorgang geschlossen">
      <bpmn:messageEventDefinition />
      <bpmn:incoming>SequenceFlow_VorgangSchliessenJa1</bpmn:outgoing>
    </bpmn:endEvent>

    <!-- Path 2: Objection received -->
    <bpmn:intermediateCatchEvent id="IntermediateWiderspruchErhalten" name="Widerspruch erhalten">
      <bpmn:messageEventDefinition />
      <bpmn:incoming>SequenceFlow_WiderspruchErhaltenWait</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_WiderspruchPruefen</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task: Check objection -->
    <bpmn:task id="Task_WiderspruchPruefen" name="Widerspruch prüfen">
      <bpmn:incoming>SequenceFlow_WiderspruchPruefen</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_GatewayGerechtfertigt</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway: Is objection justified? -->
    <bpmn:exclusiveGateway id="Gateway_WiderspruchGerechtfertigt" name="Zahlungsverweigerung gerechtfertigt?">
      <bpmn:incoming>SequenceFlow_GatewayGerechtfertigt</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_VorgangSchliessenJa2</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_InkassoNein</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event for justified objection -->
    <bpmn:endEvent id="EndVorgangGeschlossen3" name="Vorgang geschlossen">
      <bpmn:messageEventDefinition />
      <bpmn:incoming>SequenceFlow_VorgangSchliessenJa2</bpmn:outgoing>
    </bpmn:endEvent>

    <!-- Path 3: Follow-up deadline expired -->
    <bpmn:intermediateCatchEvent id="IntermediateFristAblauf" name="Wiedervorlage fällig">
      <bpmn:timerEventDefinition />
      <bpmn:incoming>SequenceFlow_FristAblaufWarten</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_InkassoJa1</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task: Give to collection agency -->
    <bpmn:task id="Task_AnInkassoAbgeben" name="Vorgang an Inkasso-Dienstleister abgeben">
      <bpmn:incoming>SequenceFlow_InkassoJa1</bpmn:outgoing>
      <bpmn:incoming>SequenceFlow_InkassoNein</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_VorgangOffenEnde</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event for collection agency path -->
    <bpmn:endEvent id="EndVorgangOffen" name="Vorgang offen">
      <bpmn:messageEventDefinition />
      <bpmn:incoming>SequenceFlow_VorgangOffenEnde</bpmn:outgoing>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    
    <bpmn:sequenceFlow id="SequenceFlow_StartPruefen" sourceRef="StartRegressVerdacht" targetRef="Task_FallPruefen">
      <bpmn:name>Vermeldet</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_GatewayRegressMoeglich" sourceRef="Task_FallPruefen" targetRef="Gateway_RegressMoeglich">
      <bpmn:name>Fall geprüft</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Yes subrogation possible -->
    <bpmn:sequenceFlow id="SequenceFlow_ZahlungsaufforderungSenden" name="Ja" sourceRef="Gateway_RegressMoeglich" targetRef="Task_ZahlungsaufforderungSenden">
      <bpmn:name>Möglich</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- No subrogation possible -->
    <bpmn:endEvent id="EndVorgangGeschlossen1" name="Vorgang geschlossen">
      <bpmn:messageEventDefinition />
      <bpmn:incoming>SequenceFlow_VorgangSchliessenNein</bpmn:outgoing>
    </bpmn:endEvent>

    <!-- Set on follow-up -->
    <bpmn:sequenceFlow id="SequenceFlow_WiedervorlageSetzen" sourceRef="Task_ZahlungsaufforderungSenden" targetRef="Task_WiedervorlageSetzen">
      <bpmn:name>Auf Wiedervorlage</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Start waiting on events -->
    <bpmn:sequenceFlow id="SequenceFlow_EventBasedGatewayStart" sourceRef="Task_WiedervorlageSetzen" targetRef="EventBasedGateway_Warten">
      <bpmn:name>Zu warten</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Wait for money received -->
    <bpmn:intermediateCatchEvent id="IntermediateGeldEingegangen" name="Geld eingegangen">
      <bpmn:messageEventDefinition />
      <bpmn:incoming>SequenceFlow_GeldEingegangenWait</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_EingangVerbuchen</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Wait for objection -->
    <bpmn:sequenceFlow id="SequenceFlow_WiderspruchErhaltenWait" sourceRef="EventBasedGateway_Warten" targetRef="IntermediateWiderspruchErhalten">
      <bpmn:name>Objection</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Wait for deadline -->
    <bpmn:intermediateCatchEvent id="IntermediateFristAblauf" name="Wiedervorlage fällig">
      <bpmn:timerEventDefinition />
      <bpmn:incoming>SequenceFlow_FristAblaufWarten</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_InkassoJa1</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Wait for money -->
    <bpmn:sequenceFlow id="SequenceFlow_GeldEingegangenWait" sourceRef="EventBasedGateway_Warten" targetRef="IntermediateGeldEingegangen">
      <bpmn:name>Money</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Book money entry -->
    <bpmn:task id="Task_GeldeingangVerbuchen" name="Geldeingang verbuchen">
      <bpmn:incoming>SequenceFlow_EingangVerbuchen</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_VorgangSchliessenJa1</bpmn:outgoing>
    </bpmn:task>

    <!-- End for money received -->
    <bpmn:endEvent id="EndVorgangGeschlossen2" name="Vorgang geschlossen">
      <bpmn:messageEventDefinition />
      <bpmn:incoming>SequenceFlow_VorgangSchliessenJa1</bpmn:outgoing>
    </bpmn:endEvent>

    <!-- Check objection -->
    <bpmn:sequenceFlow id="SequenceFlow_WiderspruchPruefen" sourceRef="IntermediateWiderspruchErhalten" targetRef="Task_WiderspruchPruefen">
      <bpmn:name>Zu prüfen</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Gateway for objection justified -->
    <bpmn:exclusiveGateway id="Gateway_WiderspruchGerechtfertigt" name="Zahlungsverweigerung gerechtfertigt?">
      <bpmn:incoming>SequenceFlow_GatewayGerechtfertigt</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_VorgangSchliessenJa2</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_InkassoNein</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End for justified objection -->
    <bpmn:endEvent id="EndVorgangGeschlossen3" name="Vorgang geschlossen">
      <bpmn:messageEventDefinition />
      <bpmn:incoming>SequenceFlow_VorgangSchliessenJa2</bpmn:outgoing>
    </bpmn:endEvent>

    <!-- Give to collection agency -->
    <bpmn:task id="Task_AnInkassoAbgeben" name="Vorgang an Inkasso-Dienstleister abgeben">
      <bpmn:incoming>SequenceFlow_InkassoJa1</bpmn:outgoing>
      <bpmn:incoming>SequenceFlow_InkassoNein</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_VorgangOffenEnde</bpmn:outgoing>
    </bpmn:task>

    <!-- End for collection agency -->
    <bpmn:endEvent id="EndVorgangOffen" name="Vorgang offen">
      <bpmn:messageEventDefinition />
      <bpmn:incoming>SequenceFlow_VorgangOffenEnde</bpmn:outgoing>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>