<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_HealthProgram" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Process" name="Betriebliche Gesundheitsförderung" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Participants" name="Teilnehmer">
        <bpmn:flowNodeRef>StartEvent_Enrollment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AppInstruction</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_TrainingPhase1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IndependentTraining</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SupportedTraining</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Coaches" name="Gesundheitscoaches / Sportmediziner">
        <bpmn:flowNodeRef>StartEvent_Enrollment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HealthMeasurements</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_StartProgram</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreatePlans</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_TrainingStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InitialTraining</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_IntermediateDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IntermediateCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_GroupSplit</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Enrollment" name="Programmstart">
      <bpmn:outgoing>SequenceFlow_StartToHealthCheck</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Health Check Tasks (Medical Staff) -->
    <bpmn:task id="Task_HealthMeasurements" name="Gesundheits-Check durchführen">
      <bpmn:incoming>SequenceFlow_StartToHealthCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MeasurementsToParallelSplit</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Split for App Instruction and Planning -->
    <bpmn:parallelGateway id="Gateway_StartProgram" name="Start Phase">
      <bpmn:incoming>SequenceFlow_MeasurementsToParallelSplit</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AppInstruction</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- App Instruction Task (Participants) -->
    <bpmn:task id="Task_AppInstruction" name="Einweisung in App &amp; Wearables">
      <bpmn:incoming>SequenceFlow_AppInstruction</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TrainingPhase1Start</bpmn:outgoing>
    </bpmn:task>

    <!-- Planning Task (Coaches) -->
    <bpmn:task id="Task_CreatePlans" name="Trainings- &amp; Ernährungspläne erstellen">
      <bpmn:incoming>SequenceFlow_MeasurementsToParallelSplit</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PlanToTrainingPhase1</bpmn:outgoing>
    </bpmn:task>

    <!-- Training Phase 1 Start (Merge of App Instruction and Planning) -->
    <bpmn:parallelGateway id="Gateway_TrainingStart" name="Begin Training">
      <bpmn:incoming>SequenceFlow_AppInstruction</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_PlanToTrainingPhase1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TrainingPhase1Start</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Training Phase 1 -->
    <bpmn:task id="Task_InitialTraining" name="Individuelles Trainingsprogramm (6 Monate)">
      <bpmn:incoming>SequenceFlow_TrainingPhase1Start</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToIntermediateCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Check -->
    <bpmn:exclusiveGateway id="Gateway_IntermediateDecision" name="6 Monate vergangen?">
      <bpmn:incoming>SequenceFlow_ToIntermediateCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DoIntermedCheck</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Intermediate Check Task -->
    <bpmn:task id="Task_IntermediateCheck" name="Zwischen-Check (Fortschrittsdokumentation)">
      <bpmn:incoming>SequenceFlow_DoIntermedCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToGroupSplit</bpmn:outgoing>
    </bpmn:task>

    <!-- Group Split -->
    <bpmn:exclusiveGateway id="Gateway_GroupSplit" name="Gruppeneinteilung">
      <bpmn:incoming>SequenceFlow_ToGroupSplit</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PathIndependent</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PathSupported</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Path A: Independent Training -->
    <bpmn:task id="Task_IndependentTraining" name="Eigenständiges Training (ohne Wearables)">
      <bpmn:incoming>SequenceFlow_PathIndependent</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToFinalCheckMerge</bpmn:outgoing>
    </bpmn:task>

    <!-- Path B: Supported Training -->
    <bpmn:task id="Task_SupportedTraining" name="Trainingsunterstützung (App &amp; Wearables)">
      <bpmn:incoming>SequenceFlow_PathSupported</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToFinalCheckMerge</bpmn:outgoing>
    </bpmn:task>

    <!-- Merge before Final Check -->
    <bpmn:parallelGateway id="Gateway_FinalCheckStart" name="Ende Programmphase">
      <bpmn:incoming>SequenceFlow_PathIndependent</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_PathSupported</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StartFinalCheck</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Final Check End Event -->
    <bpmn:endEvent id="EndEvent_FinalCheck" name="Abschluss-Check">
      <bpmn:incoming>SequenceFlow_StartFinalCheck</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    
    <bpmn:sequenceFlow id="SequenceFlow_StartToHealthCheck" sourceRef="StartEvent_Enrollment" targetRef="Task_HealthMeasurements">
      <bpmn:name>Ablauf starten</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_MeasurementsToParallelSplit" sourceRef="Task_HealthMeasurements" targetRef="Gateway_StartProgram"/>

    <bpmn:sequenceFlow id="SequenceFlow_AppInstruction" sourceRef="Gateway_StartProgram" targetRef="Task_AppInstruction">
      <bpmn:name>Einweisung</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_PlanToTrainingPhase1" sourceRef="Gateway_StartProgram" targetRef="Task_CreatePlans"/>

    <bpmn:sequenceFlow id="SequenceFlow_TrainingPhase1Start" sourceRef="Gateway_TrainingStart" targetRef="Task_InitialTraining">
      <bpmn:name>Programmstart</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ToIntermediateCheck" sourceRef="Task_InitialTraining" targetRef="Gateway_IntermediateDecision"/>

    <bpmn:sequenceFlow id="SequenceFlow_DoIntermedCheck" name="Ja (6 Monate)" sourceRef="Gateway_IntermediateDecision" targetRef="Task_IntermediateCheck">
      <bpmn:name>Zeitraum erreicht</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ToGroupSplit" sourceRef="Task_IntermediateCheck" targetRef="Gateway_GroupSplit"/>

    <bpmn:sequenceFlow id="SequenceFlow_PathIndependent" name="Gruppe A (Eigenständig)" sourceRef="Gateway_GroupSplit" targetRef="Task_IndependentTraining">
      <bpmn:name>Keine Wearables</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_PathSupported" name="Gruppe B (App/Wearables)" sourceRef="Gateway_GroupSplit" targetRef="Task_SupportedTraining">
      <bpmn:name>Mit Unterstützung</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ToFinalCheckMerge" name="6 Monate Training Phase 2" sourceRef="Gateway_GroupSplit" targetRef="Task_IndependentTraining"/>

    <bpmn:sequenceFlow id="SequenceFlow_StartFinalCheck" sourceRef="Gateway_FinalCheckStart" targetRef="EndEvent_FinalCheck">
      <bpmn:name>Programmende</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>