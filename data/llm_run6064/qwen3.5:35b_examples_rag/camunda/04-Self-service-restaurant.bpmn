<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_0geryc1">
    <bpmn:participant id="Participant_0ygkg4f" name="Restaurant Process" processRef="Process_2" />
  </bpmn:collaboration>

  <bpmn:process id="Process_2" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Guest" name="Guest">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GuestChooseDish</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GuestWaitForTurn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GuestPickUpMeal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Employee" name="Employee">
        <bpmn:flowNodeRef>Task_EmployeeTakeOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EmployeePOS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EmployeeCollectMoney</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EmployeeSetBuzzer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EmployeeInformChef</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_BuzzerTimeoutCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EmployeeCallGuest</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Chef" name="Chef">
        <bpmn:flowNodeRef>Task_ChefPrepareMeal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ChefPlaceInHatch</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Guest Lane -->
    <bpmn:startEvent id="StartEvent_1" name="Guest Enters">
      <bpmn:outgoing>SequenceFlow_GuestEnters</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_GuestChooseDish" name="Choose Dish from Menu">
      <bpmn:incoming>SequenceFlow_GuestEnters</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ChooseDishWait</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_GuestWaitForTurn" name="Wait for Turn">
      <bpmn:incoming>SequenceFlow_ChooseDishWait</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitToOrder</bpmn:outgoing>
    </bpmn:task>

    <!-- Employee Lane -->
    <bpmn:task id="Task_EmployeeTakeOrder" name="Receive Order">
      <bpmn:incoming>SequenceFlow_WaitToOrder</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TakeOrderPOS</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_EmployeePOS" name="Enter Order into POS">
      <bpmn:incoming>SequenceFlow_TakeOrderPOS</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_POSCollectMoney</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_EmployeeCollectMoney" name="Collect Payment">
      <bpmn:incoming>SequenceFlow_POSCollectMoney</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CollectSetBuzzer</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_EmployeeSetBuzzer" name="Setup Buzzer for Guest">
      <bpmn:incoming>SequenceFlow_CollectSetBuzzer</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SetBuzzerInformChef</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_EmployeeInformChef" name="Inform Chef of Order">
      <bpmn:incoming>SequenceFlow_SetBuzzerInformChef</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InformWaitForReady</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for Buzzer Timeout Check -->
    <bpmn:exclusiveGateway id="Gateway_BuzzerTimeoutCheck" name="Buzzer Ringed?">
      <bpmn:incoming>SequenceFlow_WaitForReady</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RingedYes</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RingedNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Chef Lane -->
    <bpmn:task id="Task_ChefPrepareMeal" name="Prepare Meal">
      <bpmn:incoming>SequenceFlow_InformWaitForReady</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PreparePlaceHatch</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_ChefPlaceInHatch" name="Place Meal in Service Hatch">
      <bpmn:incoming>SequenceFlow_PreparePlaceHatch</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_HatchInformEmployee</bpmn:outgoing>
    </bpmn:task>

    <!-- Guest Lane - End -->
    <bpmn:endEvent id="EndEvent_1" name="Meal Eaten">
      <bpmn:incoming>SequenceFlow_GuestPickUpEat</bpmn:incoming />
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_GuestEnters" sourceRef="StartEvent_1" targetRef="Task_GuestChooseDish" />
    <bpmn:sequenceFlow id="SequenceFlow_ChooseDishWait" sourceRef="Task_GuestChooseDish" targetRef="Task_GuestWaitForTurn" />
    <bpmn:sequenceFlow id="SequenceFlow_WaitToOrder" name="When Turn Comes" sourceRef="Task_GuestWaitForTurn" targetRef="Task_EmployeeTakeOrder">
      <bpmn:conditionExpression xsi:type="tFormalExpression"><![CDATA[turnArrived]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Employee Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_TakeOrderPOS" sourceRef="Task_EmployeeTakeOrder" targetRef="Task_EmployeePOS" />
    <bpmn:sequenceFlow id="SequenceFlow_POSCollectMoney" name="After POS Entry" sourceRef="Task_EmployeePOS" targetRef="Task_EmployeeCollectMoney">
      <bpmn:conditionExpression xsi:type="tFormalExpression"><![CDATA[orderEntered]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Payment and Buzzer -->
    <bpmn:sequenceFlow id="SequenceFlow_CollectSetBuzzer" sourceRef="Task_EmployeeCollectMoney" targetRef="Task_EmployeeSetBuzzer">
      <bpmn:conditionExpression xsi:type="tFormalExpression"><![CDATA[paymentReceived]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Buzzer Setup -->
    <bpmn:sequenceFlow id="SequenceFlow_SetBuzzerInformChef" sourceRef="Task_EmployeeSetBuzzer" targetRef="Task_EmployeeInformChef">
      <bpmn:conditionExpression xsi:type="tFormalExpression"><![CDATA[buzzerReady]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Inform Chef -->
    <bpmn:sequenceFlow id="SequenceFlow_InformWaitForReady" sourceRef="Task_EmployeeInformChef" targetRef="Task_ChefPrepareMeal">
      <bpmn:conditionExpression xsi:type="tFormalExpression"><![CDATA[orderNotified]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Chef Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_PreparePlaceHatch" sourceRef="Task_ChefPrepareMeal" targetRef="Task_ChefPlaceInHatch">
      <bpmn:conditionExpression xsi:type="tFormalExpression"><![CDATA[mealPrepared]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Hatch to Employee -->
    <bpmn:sequenceFlow id="SequenceFlow_HatchInformEmployee" sourceRef="Task_ChefPlaceInHatch" targetRef="Gateway_BuzzerTimeoutCheck">
      <bpmn:conditionExpression xsi:type="tFormalExpression"><![CDATA[mealReady]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Buzzer Timeout Check -->
    <bpmn:sequenceFlow id="SequenceFlow_RingedYes" name="Guest Reacted" sourceRef="Gateway_BuzzerTimeoutCheck" targetRef="Task_GuestPickUpMeal">
      <bpmn:conditionExpression xsi:type="tFormalExpression"><![CDATA[guestReacted]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Timeout Path -->
    <bpmn:sequenceFlow id="SequenceFlow_RingedNo" name="5 Minutes No Reaction" sourceRef="Gateway_BuzzerTimeoutCheck" targetRef="Task_EmployeeCallGuest">
      <bpmn:conditionExpression xsi:type="tFormalExpression"><![CDATA[timeoutReached]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Call Guest -->
    <bpmn:task id="Task_EmployeeCallGuest" name="Call for Guest">
      <bpmn:incoming>SequenceFlow_RingedNo</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CallBackToCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Loop back to check -->
    <bpmn:sequenceFlow id="SequenceFlow_CallBackToCheck" sourceRef="Task_EmployeeCallGuest" targetRef="Gateway_BuzzerTimeoutCheck">
      <bpmn:conditionExpression xsi:type="tFormalExpression"><![CDATA[callMade]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Guest Picks Up Meal -->
    <bpmn:task id="Task_GuestPickUpMeal" name="Pick Up Meal at Hatch">
      <bpmn:incoming>SequenceFlow_RingedYes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GuestPickUpEat</bpmn:outgoing>
    </bpmn:task>

    <!-- End -->
    <bpmn:sequenceFlow id="SequenceFlow_GuestPickUpEat" sourceRef="Task_GuestPickUpMeal" targetRef="EndEvent_1">
      <bpmn:conditionExpression xsi:type="tFormalExpression"><![CDATA[mealCollected]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>