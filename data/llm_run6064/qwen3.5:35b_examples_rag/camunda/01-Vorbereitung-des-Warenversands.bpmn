<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1a8pib">
    <bpmn:participant id="Participant_1ygkg4f" name="Computer Hardware Shop" processRef="Process_2" />
  </bpmn:collaboration>

  <bpmn:process id="Process_2" isExecutable="false">
    <bpmn:startEvent id="StartEvent_0iu9po7" name="Ware versendet werden soll">
      <bpmn:outgoing>SequenceFlow_1a65vxa</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:parallelGateway id="ParallelGateway_3z8fqc" name="Start Parallel Processing">
      <bpmn:incoming>SequenceFlow_1a65vxa</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4k2lqpo</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_9d8jzxw</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Lane 1: Sekretariat -->
    <bpmn:laneSet id="LaneSet_0fenzda">
      <bpmn:lane id="Lane_Sekretariat" name="Sekretariat">
        <bpmn:flowNodeRef>ExclusiveGateway_3z8fqc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HoltAngebote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WaehltAngebotAus</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FuellPaketSchein</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_Versicherung</bpmn:flowNodeRef>
      </bpmn:lane>

      <!-- Lane 2: Logistikleiter -->
      <bpmn:lane id="Lane_Logistik" name="Logistikleiter">
        <bpmn:flowNodeRef>Task_SchliesstVersicherung</bpmn:flowNodeRef>
      </bpmn:lane>

      <!-- Lane 3: Lagerarbeiter -->
      <bpmn:lane id="Lane_Lager" name="Lagerarbeiter">
        <bpmn:flowNodeRef>Task_VerpacktWare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Bereitgestellt</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Admin Path - Large Quantity -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_3z8fqc" name="Große Menge?">
      <bpmn:incoming>SequenceFlow_4k2lqpo</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_LargePath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SmallPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Admin Path - Small Quantity -->
    <bpmn:task id="Task_HoltAngebote" name="Holt Angebote von drei Spediteuren ein">
      <bpmn:incoming>SequenceFlow_LargePath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SelectOrder</bpmn:outgoing>
    </bpmn:task>

    <!-- Admin Path - Small Quantity -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_Versicherung" name="Versicherung erforderlich?">
      <bpmn:incoming>SequenceFlow_SmallPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InsuranceYes</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_AdminDone_NoInsure</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Admin Path - Small Quantity -->
    <bpmn:task id="Task_FuellPaketSchein" name="Füllt standardisierten Paketschein aus">
      <bpmn:incoming>SequenceFlow_SmallPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InsuranceDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Logistics Manager Path -->
    <bpmn:task id="Task_WaehltAngebotAus" name="Wählt Angebot aus &amp; beauftragt Spediteur">
      <bpmn:incoming>SequenceFlow_SelectOrder</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AdminDone_Large</bpmn:outgoing>
    </bpmn:task>

    <!-- Logistics Manager Path -->
    <bpmn:task id="Task_SchliesstVersicherung" name="Schließt Versicherung ab">
      <bpmn:incoming>SequenceFlow_InsuranceYes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AdminDone_Logistics</bpmn:outgoing>
    </bpmn:task>

    <!-- Warehouse Path -->
    <bpmn:task id="Task_VerpacktWare" name="Verpackt Ware">
      <bpmn:incoming>SequenceFlow_9d8jzxw</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PackDone</bpmn:outgoing>
    </bpmn:task>

    <!-- Final Step -->
    <bpmn:endEvent id="EndEvent_Bereitgestellt" name="Ware zur Abholung bereit">
      <bpmn:incoming>SequenceFlow_FinalStep</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_1a65vxa" sourceRef="StartEvent_0iu9po7" targetRef="ParallelGateway_3z8fqc">
      <bpmn:conditionExpression xsi:type="tFormalExpression"><![CDATA[true]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Split to Admin and Warehouse -->
    <bpmn:sequenceFlow id="SequenceFlow_4k2lqpo" name="Admin Preparation" sourceRef="ParallelGateway_3z8fqc" targetRef="ExclusiveGateway_3z8fqc">
      <bpmn:conditionExpression xsi:type="tFormalExpression"><![CDATA[true]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Split to Warehouse -->
    <bpmn:sequenceFlow id="SequenceFlow_9d8jzxw" name="Pack Goods" sourceRef="ParallelGateway_3z8fqc" targetRef="Task_VerpacktWare">
      <bpmn:conditionExpression xsi:type="tFormalExpression"><![CDATA[true]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Admin Large Path -->
    <bpmn:sequenceFlow id="SequenceFlow_LargePath" name="Ja (Große Menge)" sourceRef="ExclusiveGateway_3z8fqc" targetRef="Task_HoltAngebote">
      <bpmn:conditionExpression xsi:type="tFormalExpression"><![CDATA[largeQuantity]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Admin Small Path -->
    <bpmn:sequenceFlow id="SequenceFlow_SmallPath" name="Nein (Kleine Menge)" sourceRef="ExclusiveGateway_3z8fqc" targetRef="Task_FuellPaketSchein">
      <bpmn:conditionExpression xsi:type="tFormalExpression"><![CDATA[smallQuantity]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Admin Large Sequence -->
    <bpmn:sequenceFlow id="SequenceFlow_SelectOrder" sourceRef="Task_HoltAngebote" targetRef="Task_WaehltAngebotAus">
      <bpmn:conditionExpression xsi:type="tFormalExpression"><![CDATA[true]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Admin Large End -->
    <bpmn:sequenceFlow id="SequenceFlow_AdminDone_Large" sourceRef="Task_WaehltAngebotAus" targetRef="ParallelGateway_Join">
      <bpmn:conditionExpression xsi:type="tFormalExpression"><![CDATA[true]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Admin Small Sequence -->
    <bpmn:sequenceFlow id="SequenceFlow_InsuranceDecision" sourceRef="Task_FuellPaketSchein" targetRef="ExclusiveGateway_Versicherung">
      <bpmn:conditionExpression xsi:type="tFormalExpression"><![CDATA[true]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Insurance Yes Path -->
    <bpmn:sequenceFlow id="SequenceFlow_InsuranceYes" name="Ja (Versicherung)" sourceRef="ExclusiveGateway_Versicherung" targetRef="Task_SchliesstVersicherung">
      <bpmn:conditionExpression xsi:type="tFormalExpression"><![CDATA[insuranceRequired]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Insurance No Path -->
    <bpmn:sequenceFlow id="SequenceFlow_AdminDone_NoInsure" name="Nein (Keine Versicherung)" sourceRef="ExclusiveGateway_Versicherung" targetRef="ParallelGateway_Join">
      <bpmn:conditionExpression xsi:type="tFormalExpression"><![CDATA[noInsurance]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Logistics Manager End -->
    <bpmn:sequenceFlow id="SequenceFlow_AdminDone_Logistics" sourceRef="Task_SchliesstVersicherung" targetRef="ParallelGateway_Join">
      <bpmn:conditionExpression xsi:type="tFormalExpression"><![CDATA[true]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Warehouse End -->
    <bpmn:sequenceFlow id="SequenceFlow_PackDone" sourceRef="Task_VerpacktWare" targetRef="ParallelGateway_Join">
      <bpmn:conditionExpression xsi:type="tFormalExpression"><![CDATA[true]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Final Join -->
    <bpmn:parallelGateway id="ParallelGateway_Join" name="Alle Vorbereitungen abgeschlossen">
      <bpmn:incoming>SequenceFlow_AdminDone_Large</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_AdminDone_NoInsure</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_AdminDone_Logistics</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_PackDone</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FinalStep</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Final Step -->
    <bpmn:sequenceFlow id="SequenceFlow_FinalStep" sourceRef="ParallelGateway_Join" targetRef="EndEvent_Bereitgestellt">
      <bpmn:conditionExpression xsi:type="tFormalExpression"><![CDATA[true]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>