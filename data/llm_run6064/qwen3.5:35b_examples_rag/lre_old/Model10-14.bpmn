<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1m9e7qz">
    <bpmn:messageFlow id="MessageFlow_MPOO_Operations_GO" sourceRef="Task_MPOO_SendBill_Operations" targetRef="IntermediateCatchEvent_GO_ExamineOperations"/>
    <bpmn:messageFlow id="MessageFlow_MSPO_Measurement_GO" sourceRef="Task_MSPO_SendBill_Measurement" targetRef="IntermediateCatchEvent_GO_ExamineMeasurement"/>
    <bpmn:messageFlow id="MessageFlow_MSPO_AdditionalReadings_GO" sourceRef="Task_MSPO_SendBill_AdditionalReadings" targetRef="IntermediateCatchEvent_GO_ExamineAdditionalReadings"/>
    <bpmn:messageFlow id="MessageFlow_MPOO_Equipment_MPON" sourceRef="Task_MPOO_SendBill_Equipment_MPON" targetRef="IntermediateCatchEvent_MPON_ExamineEquipment"/>
    <bpmn:messageFlow id="MessageFlow_MPOO_Equipment_GO" sourceRef="Task_MPOO_SendBill_Equipment_GO" targetRef="IntermediateCatchEvent_GO_ExamineEquipment"/>
    <bpmn:messageFlow id="MessageFlow_Confirmation_MSPO" sourceRef="Task_GO_ConfirmInvoice" targetRef="StartEvent_MSPO_ReceiptConfirmation"/>
    <bpmn:messageFlow id="MessageFlow_Rejection_MPOO" sourceRef="Task_MPON_RejectInvoice" targetRef="StartEvent_MPOO_ReceiptConfirmation"/>
  </bpmn:collaboration>

  <!-- MPOO Process -->
  <bpmn:process id="Process_MPOO" isExecutable="false">
    <bpmn:startEvent id="StartEvent_MPOO_SendBill_Operations">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_0g6h8y4</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:startEvent id="StartEvent_MPOO_SendBill_Equipment">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_1x9k4mz</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:startEvent id="StartEvent_MPOO_ReceiptConfirmation">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_2x9k4mz</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:endEvent id="EndEvent_MPOO_Processed">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SequenceFlow_3x9k4mz</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_0g6h8y4" sourceRef="StartEvent_MPOO_SendBill_Operations" targetRef="Task_MPOO_SendBill_Operations"/>
    
    <bpmn:task id="Task_MPOO_SendBill_Operations">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SequenceFlow_0g6h8y4</bpmn:incoming>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_1x9k4mz" sourceRef="StartEvent_MPOO_SendBill_Equipment" targetRef="ExclusiveGateway_MPOO_Equipment_Destination"/>
    
    <bpmn:exclusiveGateway id="ExclusiveGateway_MPOO_Equipment_Destination">
      <bpmn:name>Select Recipient for Equipment Bill</bpmn:name>
      <bpmn:incoming>SequenceFlow_1x9k4mz</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2r8v2kw</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_3y1f5nz</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Equipment Bill to MPON -->
    <bpmn:task id="Task_MPOO_SendBill_Equipment_MPON">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SequenceFlow_2r8v2kw</bpmn:incoming>
    </bpmn:task>

    <!-- Equipment Bill to GO -->
    <bpmn:sequenceFlow id="SequenceFlow_3y1f5nz" sourceRef="ExclusiveGateway_MPOO_Equipment_Destination" targetRef="Task_MPOO_SendBill_Equipment_GO"/>
    
    <bpmn:task id="Task_MPOO_SendBill_Equipment_GO">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SequenceFlow_3y1f5nz</bpmn:incoming>
    </bpmn:task>

  </bpmn:process>

  <!-- MSPO Process -->
  <bpmn:process id="Process_MSPO" isExecutable="false">
    <bpmn:startEvent id="StartEvent_MSPO_SendBill_Measurement">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_4m0w8p4</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:startEvent id="StartEvent_MSPO_SendBill_AdditionalReadings">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_5t4h1xq</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:startEvent id="StartEvent_MSPO_ReceiptConfirmation">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_6j5m3vn</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:endEvent id="EndEvent_MSPO_Processed">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SequenceFlow_7j5m3vn</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_4m0w8p4" sourceRef="StartEvent_MSPO_SendBill_Measurement" targetRef="Task_MSPO_SendBill_Measurement"/>
    
    <bpmn:task id="Task_MSPO_SendBill_Measurement">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SequenceFlow_4m0w8p4</bpmn:incoming>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_5t4h1xq" sourceRef="StartEvent_MSPO_SendBill_AdditionalReadings" targetRef="Task_MSPO_SendBill_AdditionalReadings"/>
    
    <bpmn:task id="Task_MSPO_SendBill_AdditionalReadings">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SequenceFlow_5t4h1xq</bpmn:incoming>
    </bpmn:task>

  </bpmn:process>

  <!-- GO Process -->
  <bpmn:process id="Process_GO" isExecutable="false">
    <bpmn:startEvent id="StartEvent_GO_ExamineOperations">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_8x2v1tq</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:startEvent id="StartEvent_GO_ExamineMeasurement">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_9x2v8mk</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:startEvent id="StartEvent_GO_ExamineAdditionalReadings">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_0x2v8mk</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:startEvent id="StartEvent_GO_ExamineEquipment">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_1x2v8mk</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Intermediate Catch Events for Messages -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_GO_ExamineOperations">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SequenceFlow_0g6h8y4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Ax9k4mz</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_GO_ExamineMeasurement">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SequenceFlow_4m0w8p4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Bx9k4mz</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_GO_ExamineAdditionalReadings">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SequenceFlow_5t4h1xq</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Cx9k4mz</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_GO_ExamineEquipment">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SequenceFlow_3y1f5nz</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Dx9k4mz</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Tasks for Examination -->
    <bpmn:task id="Task_GO_ExamineOperations">
      <bpmn:name>Examine Bill (Metering Point Operations)</bpmn:name>
      <bpmn:incoming>SequenceFlow_Ax9k4mz</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Ey9k4mz</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_GO_ExamineMeasurement">
      <bpmn:name>Examine Bill (Temporary Continuation of Measurement)</bpmn:name>
      <bpmn:incoming>SequenceFlow_Bx9k4mz</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Fy9k4mz</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_GO_ExamineAdditionalReadings">
      <bpmn:name>Examine Bill (Additional Readings)</bpmn:name>
      <bpmn:incoming>SequenceFlow_Cx9k4mz</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Gy9k4mz</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_GO_ExamineEquipment">
      <bpmn:name>Examine Bill (Equipment Acquisition)</bpmn:name>
      <bpmn:incoming>SequenceFlow_Dx9k4mz</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Hy9k4mz</bpmn:outgoing>
    </bpmn:task>

    <!-- Decision Gateway for Confirmation/Rejection -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_GO_Decision">
      <bpmn:name>Confirm or Reject Invoice?</bpmn:name>
      <bpmn:incoming>SequenceFlow_Ey9k4mz</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_Fy9k4mz</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_Gy9k4mz</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_Hy9k4mz</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Ix9k4mz</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_Jx9k4mz</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Confirmation Task -->
    <bpmn:task id="Task_GO_ConfirmInvoice">
      <bpmn:name>Confirm Invoice (GO)</bpmn:name>
      <bpmn:incoming>SequenceFlow_Ix9k4mz</bpmn:incoming>
    </bpmn:task>

    <!-- Rejection Task -->
    <bpmn:task id="Task_GO_RejectInvoice">
      <bpmn:name>Reject Invoice (GO)</bpmn:name>
      <bpmn:incoming>SequenceFlow_Jx9k4mz</bpmn:incoming>
    </bpmn:task>

  </bpmn:process>

  <!-- MPON Process -->
  <bpmn:process id="Process_MPON" isExecutable="false">
    <bpmn:startEvent id="StartEvent_MPON_ExamineEquipment">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_Kx9k4mz</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Intermediate Catch Event for Message -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_MPON_ExamineEquipment">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SequenceFlow_2r8v2kw</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Lx9k4mz</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task for Examination -->
    <bpmn:task id="Task_MPON_ExamineEquipment">
      <bpmn:name>Examine Bill (Equipment Acquisition)</bpmn:name>
      <bpmn:incoming>SequenceFlow_Lx9k4mz</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Mx9k4mz</bpmn:outgoing>
    </bpmn:task>

    <!-- Decision Gateway for Confirmation/Rejection -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_MPON_Decision">
      <bpmn:name>Confirm or Reject Invoice?</bpmn:name>
      <bpmn:incoming>SequenceFlow_Mx9k4mz</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Nx9k4mz</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_Ox9k4mz</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Confirmation Task -->
    <bpmn:task id="Task_MPON_ConfirmInvoice">
      <bpmn:name>Confirm Invoice (MPON)</bpmn:name>
      <bpmn:incoming>SequenceFlow_Nx9k4mz</bpmn:incoming>
    </bpmn:task>

    <!-- Rejection Task -->
    <bpmn:task id="Task_MPON_RejectInvoice">
      <bpmn:name>Reject Invoice (MPON)</bpmn:name>
      <bpmn:incoming>SequenceFlow_Ox9k4mz</bpmn:incoming>
    </bpmn:task>

  </bpmn:process>

</bpmn:definitions>