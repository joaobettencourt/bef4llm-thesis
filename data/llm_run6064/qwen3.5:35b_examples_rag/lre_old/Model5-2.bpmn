<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_VacationsRequest">
    <bpmn:participant id="Participant_VacationsProcess" name="Vacations Request Process" processRef="Process_Vacations"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Vacations" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Employee" name="Employee">
        <bpmn:flowNodeRef>StartEvent_RequestSubmitted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegisterRequest</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Supervisor" name="Supervisor">
        <bpmn:flowNodeRef>Gateway_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewRequest</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_HR" name="HR Representative">
        <bpmn:flowNodeRef>Task_NotifyHR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CompleteProcedures</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_System" name="System">
        <bpmn:flowNodeRef>Gateway_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendRejectionNotification</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_RequestSubmitted" name="Vacation Request Submitted">
      <bpmn:outgoing>SequenceFlow_RegisterRequest</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Employee Task - Register Request -->
    <bpmn:task id="Task_RegisterRequest" name="Register Vacation Request">
      <bpmn:incoming>SequenceFlow_RegisterRequest</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendToSupervisor</bpmn:outgoing>
    </bpmn:task>

    <!-- Supervisor Task - Review Request -->
    <bpmn:task id="Task_ReviewRequest" name="Review Vacation Request">
      <bpmn:incoming>SequenceFlow_SendToSupervisor</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DecideApprovalReject</bpmn:outgoing>
    </bpmn:task>

    <!-- Decision Gateway -->
    <bpmn:exclusiveGateway id="Gateway_Decision" name="Request Approved?">
      <bpmn:incoming>SequenceFlow_DecideApprovalReject</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RejectPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ApprovePath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Rejection Path -->
    <bpmn:task id="Task_SendRejectionNotification" name="Send Rejection Notification">
      <bpmn:incoming>SequenceFlow_RejectPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReturnToEmployee</bpmn:outgoing>
    </bpmn:task>

    <!-- Approval Path -->
    <bpmn:task id="Task_NotifyHR" name="Notify HR of Approval">
      <bpmn:incoming>SequenceFlow_ApprovePath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_HRProcedures</bpmn:outgoing>
    </bpmn:task>

    <!-- HR Task -->
    <bpmn:task id="Task_CompleteProcedures" name="Complete Management Procedures">
      <bpmn:incoming>SequenceFlow_HRProcedures</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProcessCompleted</bpmn:outgoing>
    </bpmn:task>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_Rejected" name="Request Rejected">
      <bpmn:incoming>SequenceFlow_ReturnToEmployee</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_Completed" name="Process Completed">
      <bpmn:incoming>SequenceFlow_ProcessCompleted</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_RegisterRequest" sourceRef="StartEvent_RequestSubmitted" targetRef="Task_RegisterRequest"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_SendToSupervisor" name="Send to Supervisor" sourceRef="Task_RegisterRequest" targetRef="Task_ReviewRequest"/>

    <bpmn:sequenceFlow id="SequenceFlow_DecideApprovalReject" name="Decision" sourceRef="Task_ReviewRequest" targetRef="Gateway_Decision"/>

    <!-- Rejection Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_RejectPath" name="Rejected" sourceRef="Gateway_Decision" targetRef="Task_SendRejectionNotification"/>

    <!-- Approval Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_ApprovePath" name="Approved" sourceRef="Gateway_Decision" targetRef="Task_NotifyHR"/>

    <!-- HR Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_HRProcedures" name="Complete Procedures" sourceRef="Task_NotifyHR" targetRef="Task_CompleteProcedures"/>

    <!-- Final Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_ProcessCompleted" sourceRef="Task_CompleteProcedures" targetRef="EndEvent_Completed"/>

  </bpmn:process>
</bpmn:definitions>