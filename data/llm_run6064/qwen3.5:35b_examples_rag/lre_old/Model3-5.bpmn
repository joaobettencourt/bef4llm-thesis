<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_1m9e7qz" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1a3f8y6"/>

  <bpmn:process id="Process_5j3rnxv" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_MailProcessingUnit" name="Mail Processing Unit">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SortUnopenedMail</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Registry" name="Registry">
        <bpmn:flowNodeRef>Task_OpenAndSortMail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegisterIncoming</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_QualityCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Compliance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CaptureMatterDetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_PaymentStart</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ArmyRegistryManager" name="Assistant Registry Manager">
        <bpmn:flowNodeRef>Task_QualityCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CompileRejectionList</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PostEnvelope</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Cashier" name="Cashier">
        <bpmn:flowNodeRef>Gateway_Compliance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TakeFees</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_PaymentStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CapturePartyDetails</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Daily Mail Collection">
      <bpmn:outgoing>SequenceFlow_SortMail</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Sort Unopened Mail -->
    <bpmn:task id="Task_SortUnopenedMail" name="Sort unopened mail into business areas">
      <bpmn:incoming>SequenceFlow_SortMail</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DistributeToRegistry</bpmn:outgoing>
    </bpmn:task>

    <!-- Open and Sort Mail in Registry -->
    <bpmn:task id="Task_OpenAndSortMail" name="Open mail and sort into groups">
      <bpmn:incoming>SequenceFlow_DistributeToRegistry</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RegisterIncoming</bpmn:outgoing>
    </bpmn:task>

    <!-- Register Incoming Mail -->
    <bpmn:task id="Task_RegisterIncoming" name="Register in manual incoming Mail Register">
      <bpmn:incoming>SequenceFlow_RegisterIncoming</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_QualityCheckStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Quality Check -->
    <bpmn:task id="Task_QualityCheck" name="Perform quality check">
      <bpmn:incoming>SequenceFlow_QualityCheckStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ComplianceDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Compliance Decision Gateway -->
    <bpmn:exclusiveGateway id="Gateway_Compliance" name="Mail Compliant?">
      <bpmn:incoming>SequenceFlow_ComplianceDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RejectionPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ApprovalPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Rejection Path -->
    <bpmn:task id="Task_CompileRejectionList" name="Compile list of requisition">
      <bpmn:incoming>SequenceFlow_RejectionPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendRejectionToParty</bpmn:outgoing>
    </bpmn:task>

    <!-- Send Rejection to Party -->
    <bpmn:endEvent id="EndEvent_Rejected" name="Rejected">
      <bpmn:name>Rejected - Sent back to party</bpmn:name>
      <bpmn:incoming>SequenceFlow_SendRejectionToParty</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Approval Path -->
    <bpmn:task id="Task_CaptureMatterDetails" name="Capture matter details">
      <bpmn:incoming>SequenceFlow_ApprovalPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProvideToCashier</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway for Payment Processing -->
    <bpmn:parallelGateway id="ParallelGateway_PaymentStart">
      <bpmn:name>Payment Start</bpmn:name>
      <bpmn:incoming>SequenceFlow_ProvideToCashier</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TakeFees</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Cashier Takes Fees -->
    <bpmn:task id="Task_TakeFees" name="Take applicable fees">
      <bpmn:incoming>SequenceFlow_TakeFees</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PaymentComplete</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway for Post Payment Activities -->
    <bpmn:parallelGateway id="ParallelGateway_PostPayment">
      <bpmn:name>Post Payment Split</bpmn:name>
      <bpmn:incoming>SequenceFlow_PaymentComplete</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PostEnvelope</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CapturePartyDetailsPath</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Post Envelope to Party -->
    <bpmn:task id="Task_PostEnvelope" name="Post envelope with receipt and copies">
      <bpmn:incoming>SequenceFlow_PostEnvelope</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EnvelopPosted</bpmn:outgoing>
    </bpmn:task>

    <!-- Capture Party Details and Print File -->
    <bpmn:task id="Task_CapturePartyDetails" name="Capture party details">
      <bpmn:incoming>SequenceFlow_CapturePartyDetailsPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFile_PartyDetailsComplete</bpmn:outgoing>
    </bpmn:task>

    <!-- Merge Parallel Paths -->
    <bpmn:parallelGateway id="ParallelGateway_Merge">
      <bpmn:name>Merge Payment Activities</bpmn:name>
      <bpmn:incoming>SequenceFlow_EnvelopPosted</bpmn:incoming>
      <bpmn:incoming>SequenceFile_PartyDetailsComplete</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProcessCompleted</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Completed" name="Process Completed">
      <bpmn:name>All activities completed</bpmn:name>
      <bpmn:incoming>SequenceFlow_ProcessCompleted</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_SortMail" sourceRef="StartEvent_1" targetRef="Task_SortUnopenedMail"/>
    <bpmn:sequenceFlow id="SequenceFlow_DistributeToRegistry" name="" sourceRef="Task_SortUnopenedMail" targetRef="Task_OpenAndSortMail"/>
    <bpmn:sequenceFlow id="SequenceFlow_RegisterIncoming" sourceRef="Task_OpenAndSortMail" targetRef="Task_RegisterIncoming"/>
    <bpmn:sequenceFlow id="SequenceFlow_QualityCheckStart" name="" sourceRef="Task_RegisterIncoming" targetRef="Task_QualityCheck"/>
    <bpmn:sequenceFlow id="SequenceFlow_ComplianceDecision" name="" sourceRef="Task_QualityCheck" targetRef="Gateway_Compliance"/>
    <bpmn:sequenceFlow id="SequenceFlow_RejectionPath" name="No - Not Compliant" sourceRef="Gateway_Compliance" targetRef="Task_CompileRejectionList"/>
    <bpmn:sequenceFlow id="SequenceFlow_SendRejectionToParty" name="" sourceRef="Task_CompileRejectionList" targetRef="EndEvent_Rejected"/>
    <bpmn:sequenceFlow id="SequenceFlow_ApprovalPath" name="Yes - Compliant" sourceRef="Gateway_Compliance" targetRef="Task_CaptureMatterDetails"/>
    <bpmn:sequenceFlow id="SequenceFlow_ProvideToCashier" name="" sourceRef="Task_CaptureMatterDetails" targetRef="ParallelGateway_PaymentStart"/>
    <bpmn:sequenceFlow id="SequenceFlow_TakeFees" name="" sourceRef="ParallelGateway_PaymentStart" targetRef="Task_TakeFees"/>
    <bpmn:sequenceFlow id="SequenceFlow_PaymentComplete" name="" sourceRef="Task_TakeFees" targetRef="ParallelGateway_PostPayment"/>
    <bpmn:sequenceFlow id="SequenceFlow_PostEnvelope" name="" sourceRef="ParallelGateway_PostPayment" targetRef="Task_PostEnvelope"/>
    <bpmn:sequenceFlow id="SequenceFile_PartyDetailsComplete" name="" sourceRef="Task_CapturePartyDetails" targetRef="ParallelGateway_Merge"/>
    <bpmn:sequenceFlow id="SequenceFlow_EnvelopPosted" name="" sourceRef="Task_PostEnvelope" targetRef="ParallelGateway_Merge"/>
    <bpmn:sequenceFlow id="SequenceFile_PartyDetailsPath" name="" sourceRef="ParallelGateway_PostPayment" targetRef="Task_CapturePartyDetails"/>

  </bpmn:process>

</bpmn:definitions>