<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:messageFlow id="MessageFlow_GO_MSP_Request" sourceRef="Task_GO_RequestMeasurements" targetRef="StartEvent_MSP_RequestReceived"/>
    <bpmn:messageFlow id="MessageFlow_MSP_GOFailure" sourceRef="IntermediateThrowFailure" targetRef="CatchGO_Failure"/>
    <bpmn:messageFlow id="MessageFlow_MSP_GOValues" sourceRef="Task_MSP_TransmitValues" targetRef="StartEvent_GO_ReceiveValues"/>
    <bpmn:messageFlow id="MessageFlow_GO_SPReadings" sourceRef="Task_GO_SendToSP" targetRef="CatchSP_Readings"/>
  </bpmn:collaboration>

  <!-- GO Pool -->
  <bpmn:process id="Process_GO">
    <bpmn:startEvent name="" id="StartEvent_GO_Request">
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task name="GO requests measurements of MSP" id="Task_GO_RequestMeasurements">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Event to wait for MSP response (Values) -->
    <bpmn:startEvent name="Received Values" id="StartEvent_GO_ReceiveValues">
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Intermediate Event to wait for MSP response (Failure) -->
    <bpmn:endEvent name="" id="EndGO_FailureReceived">
      <bpmn:name>Process Ended (Denied)</bpmn:name>
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Intermediate Catch Event for Failure -->
    <bpmn:startEvent name="Failure Received" id="StartEvent_GO_Failure">
       <bpmn:name>CatchGO_Failure</bpmn:name>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task to process values -->
    <bpmn:task name="GO processes measured values" id="Task_GO_ProcessValues">
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
    </bpmn:task>

    <!-- Task to send changed values back -->
    <bpmn:task name="GO sends the changed values to MSP" id="Task_GO_SendChanged">
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
    </bpmn:task>

     <!-- Task to send readings to SP -->
    <bpmn:task name="GO transmit the readings to SP" id="Task_GO_SendToSP">
      <bpmn:name>CatchSP_Readings</bpmn:name>
      <bpmn:incoming>SequenceFlow_7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_8</bpmn:outgoing>
    </bpmn:task>

     <!-- End Event -->
    <bpmn:endEvent name="Process Completed" id="End_GO_Success">
      <bpmn:name>CatchSP_Readings</bpmn:name>
      <bpmn:incoming>SequenceFlow_8</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_GO_Request" targetRef="Task_GO_RequestMeasurements"/>
    <bpmn:sequenceFlow id="SequenceFlow_2" name="" sourceRef="Task_GO_RequestMeasurements" targetRef="EndGO_FailureReceived">
      <!-- Placeholder for flow logic, actual interaction via message flows -->
    </bpmn:sequenceFlow>

  </bpmn:process>

  <!-- MSP Pool -->
  <bpmn:process id="Process_MSP">
    <bpmn:startEvent name="" id="StartEvent_MSP_RequestReceived">
      <bpmn:name>CatchGO_Failure</bpmn:name>
      <bpmn:outgoing>SequenceFlow_9</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task to check request -->
    <bpmn:task name="MSP checks the received request" id="Task_MSP_CheckRequest">
      <bpmn:name>CatchGO_Failure</bpmn:name>
      <bpmn:incoming>SequenceFlow_9</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway -->
    <bpmn:exclusiveGateway name="Deny or Perform?" id="ExclusiveGateway_MSP">
      <bpmn:name>CatchGO_Failure</bpmn:name>
      <bpmn:incoming>SequenceFlow_10</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_11</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Deny Path -->
    <bpmn:endEvent name="MSP Denied" id="End_MSP_Denied">
       <bpmn:name>CatchGO_Failure</bpmn:name>
      <bpmn:incoming>SequenceFlow_13</bpmn:incoming>
    </bpmn:endEvent>

     <!-- Intermediate Throw for Failure -->
    <bpmn:intermediateThrowEvent name="Inform GO about failure" id="IntermediateThrowFailure">
       <bpmn:name>CatchGO_Failure</bpmn:name>
      <bpmn:incoming>SequenceFlow_11</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_13</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <!-- Perform Path -->
     <!-- Intermediate Throw for Values (Task) -->
    <bpmn:startEvent name="Perform Measurement" id="StartEvent_MSP_Perform">
      <bpmn:name>CatchGO_Failure</bpmn:name>
      <bpmn:outgoing>SequenceFlow_14</bpmn:outgoing>
    </bpmn:startEvent>

     <!-- Task to transmit values -->
    <bpmn:task name="MSP transmits the measured values to GO" id="Task_MSP_TransmitValues">
      <bpmn:name>CatchGO_Failure</bpmn:name>
      <bpmn:incoming>SequenceFlow_14</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_15</bpmn:outgoing>
    </bpmn:task>

     <!-- End Event -->
    <bpmn:endEvent name="MSP Process Completed" id="End_MSP_Success">
       <bpmn:name>CatchGO_Failure</bpmn:name>
      <bpmn:incoming>SequenceFlow_15</bpmn:incoming>
    </bpmn:endEvent>

     <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_9" sourceRef="StartEvent_MSP_RequestReceived" targetRef="Task_MSP_CheckRequest"/>
    <bpmn:sequenceFlow id="SequenceFlow_10" name="" sourceRef="Task_MSP_CheckRequest" targetRef="ExclusiveGateway_MSP"/>

     <!-- Deny Path -->
    <bpmn:sequenceFlow id="SequenceFlow_11" name="Deny Request" sourceRef="ExclusiveGateway_MSP" targetRef="IntermediateThrowFailure"/>
    <bpmn:sequenceFlow id="SequenceFlow_13" sourceRef="IntermediateThrowFailure" targetRef="End_MSP_Denied"/>

     <!-- Perform Path -->
    <bpmn:sequenceFlow id="SequenceFlow_12" name="Perform Measurement" sourceRef="ExclusiveGateway_MSP" targetRef="StartEvent_MSP_Perform"/>
    <bpmn:sequenceFlow id="SequenceFlow_14" sourceRef="StartEvent_MSP_Perform" targetRef="Task_MSP_TransmitValues"/>
    <bpmn:sequenceFlow id="SequenceFlow_15" name="" sourceRef="Task_MSP_TransmitValues" targetRef="End_MSP_Success"/>

  </bpmn:process>

   <!-- SP Pool -->
  <bpmn:process id="Process_SP">
    <bpmn:startEvent name="Received Readings" id="CatchSP_Readings">
      <bpmn:name>CatchGO_Failure</bpmn:name>
      <bpmn:outgoing>SequenceFlow_16</bpmn:outgoing>
    </bpmn:startEvent>

     <!-- End Event -->
    <bpmn:endEvent name="Readings Received" id="End_SP">
       <bpmn:name>CatchGO_Failure</bpmn:name>
      <bpmn:incoming>SequenceFlow_16</bpmn:incoming>
    </bpmn:endEvent>

     <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_16" sourceRef="CatchSP_Readings" targetRef="End_SP"/>

  </bpmn:process>

</bpmn:definitions>