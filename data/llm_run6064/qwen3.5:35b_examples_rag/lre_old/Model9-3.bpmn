<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1m9e7qz">
    <bpmn:messageFlow id="MessageFlow_0kxwqp8"/>
    <bpmn:messageFlow id="MessageFlow_2j5r3v4" sourceRef="IntermediateThrowEvent_6h8y2p1" targetRef="StartEvent_9m7q3z5"/>
  </bpmn:collaboration>

  <!-- Process for Town Planning Authority -->
  <bpmn:process id="Process_TownPlanning">
    <bpmn:startEvent id="StartEvent_ScheduleDraft" name="Annual Meeting Scheduling">
      <bpmn:outgoing>SequenceFlow_DraftSchedule</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Lane for Coordination Unit -->
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_CoordUnit" name="Coordination Unit">
        <bpmn:flowNodeRef>StartEvent_ScheduleDraft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DraftSchedule</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecheckConflicts</bpmn:flowNodeRef>
      </bpmn:lane>

      <!-- Lane for Support Officer -->
      <bpmn:lane id="Lane_SupportOfficer" name="Support Officer">
        <bpmn:flowNodeRef>Task_CheckDates</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Task 1: Draft Schedule -->
    <bpmn:task id="Task_DraftSchedule" name="Draft schedule of meetings">
      <bpmn:incoming>SequenceFlow_DraftSchedule</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckDates</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: Check Dates (Support Officer) -->
    <bpmn:task id="Task_CheckDates" name="Check dates and suggest modifications">
      <bpmn:incoming>SequenceFlow_CheckDates</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RecheckConflicts</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3: Recheck Conflicts (Coordination Unit) -->
    <bpmn:task id="Task_RecheckConflicts" name="Recheck dates and check conflicts">
      <bpmn:incoming>SequenceFlow_RecheckConflicts</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendSchedule</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Throw Event for Sending Schedule -->
    <bpmn:intermediateThrowEvent id="IntermediateThrowEvent_6h8y2p1" name="Send schedule to members">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SequenceFlow_SendSchedule</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FinalizeProcess</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_ScheduleSent" name="Schedule Sent">
      <bpmn:incoming>SequenceFlow_FinalizeProcess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_DraftSchedule" sourceRef="StartEvent_ScheduleDraft" targetRef="Task_DraftSchedule"/>
    <bpmn:sequenceFlow id="SequenceFlow_CheckDates" name="" sourceRef="Task_DraftSchedule" targetRef="Task_CheckDates"/>
    <bpmn:sequenceFlow id="SequenceFlow_RecheckConflicts" name="" sourceRef="Task_CheckDates" targetRef="Task_RecheckConflicts"/>
    <bpmn:sequenceFlow id="SequenceFlow_SendSchedule" name="" sourceRef="Task_RecheckConflicts" targetRef="IntermediateThrowEvent_6h8y2p1"/>
    <bpmn:sequenceFlow id="SequenceFlow_FinalizeProcess" name="" sourceRef="IntermediateThrowEvent_6h8y2p1" targetRef="EndEvent_ScheduleSent"/>

  </bpmn:process>

  <!-- Process for Committee Members -->
  <bpmn:process id="Process_Members">
    <bpmn:startEvent id="StartEvent_9m7q3z5" name="Receive Schedule Email">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_CheckDiaries</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task for Members -->
    <bpmn:task id="Task_MembersCheck" name="Check diaries and advise conflicts">
      <bpmn:incoming>SequenceFlow_CheckDiaries</bpmn:incoming>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_AdviceSent" name="Advice Sent"/>

    <!-- Sequence Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckDiaries" sourceRef="StartEvent_9m7q3z5" targetRef="Task_MembersCheck">
      <bpmn:name/>
    </bpmn:sequenceFlow>

  </bpmn:process>

</bpmn:definitions>