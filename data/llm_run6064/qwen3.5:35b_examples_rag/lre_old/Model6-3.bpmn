<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_1m9e7qz">
  <bpmn:collaboration id="Collaboration_1a3f8y6"/>

  <bpmn:process id="Process_5j3rnxv" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_1viot5w" name="Master/Production Planning">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_2w5q7e1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2p5a7q8" name="PPS System">
        <bpmn:flowNodeRef>ServiceTask_3x9k4mz</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DataObjectReference_1q0w3k6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1vl2igx" name="ERP System">
        <bpmn:flowNodeRef>UserTask_4z9j2m5</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event - New Order from Sales Department -->
    <bpmn:startEvent id="StartEvent_1" name="New order received">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_0g6h8y4</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1 - Master determines parts, quantities, delivery date -->
    <bpmn:userTask id="UserTask_2w5q7e1" name="Determine necessary parts and quantities">
      <bpmn:incoming>SequenceFlow_0g6h8y4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3x9k4mz</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task 2 - Enter into PPS system -->
    <bpmn:userTask id="UserTask_6r8v2kw" name="Enter information into PPS">
      <bpmn:incoming>SequenceFlow_3x9k4mz</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5h7x9qj</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Service Task - PPS optimizes production and creates work packages -->
    <bpmn:serviceTask id="ServiceTask_3x9k4mz" name="Optimize production processes">
      <bpmn:incoming>SequenceFlow_5h7x9qj</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6r8v2kw</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Data Object - Parts list to be procured -->
    <bpmn:dataObjectReference id="DataObjectReference_1q0w3k6" name="Parts procurement list">
      <bpmn:incoming>SequenceFlow_7y1f5nz</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_8w3k1j6</bpmn:outgoing>
    </bpmn:dataObjectReference>

    <!-- Manual Task - Transfer data from PPS to ERP -->
    <bpmn:userTask id="UserTask_4z9j2m5" name="Transfer data manually to ERP">
      <bpmn:incoming>SequenceFlow_8w3k1j6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_9x2v8mk</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Decision Gateway - Check if parts need procurement -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_0p2e5vq" name="Parts missing?">
      <bpmn:incoming>SequenceFlow_9x2v8mk</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6m0w8p4</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_2t4h1xq</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Intermediate Catch Event - Production scheduled notice -->
    <bpmn:intermediateCatchEvent id="IntermediateThrowEvent_055ca3q" name="Production start notification">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SequenceFlow_2t4h1xq</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1j94oja</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task - Employee implements production -->
    <bpmn:userTask id="UserTask_0vaxgaa" name="Implement production">
      <bpmn:incoming>SequenceFlow_1j94oja</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_8j5m3vn</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task - Quality check -->
    <bpmn:userTask id="UserTask_0e6hvnj" name="Quality check order">
      <bpmn:incoming>SequenceFlow_8j5m3vn</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_06kfaev</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_1fx9yp3" name="Order completed">
      <bpmn:incoming>SequenceFlow_06kfaev</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_0g6h8y4" sourceRef="StartEvent_1" targetRef="UserTask_2w5q7e1"/>
    <bpmn:sequenceFlow id="SequenceFlow_3x9k4mz" name="" sourceRef="UserTask_2w5q7e1" targetRef="UserTask_6r8v2kw"/>
    <bpmn:sequenceFlow id="SequenceFlow_5h7x9qj" sourceRef="UserTask_6r8v2kw" targetRef="ServiceTask_3x9k4mz"/>

    <!-- PPS System Activities -->
    <bpmn:sequenceFlow id="SequenceFlow_6r8v2kw" name="" sourceRef="ServiceTask_3x9k4mz" targetRef="DataObjectReference_1q0w3k6"/>
    <bpmn:sequenceFlow id="SequenceFlow_7y1f5nz" sourceRef="ServiceTask_3x9k4mz" targetRef="ExclusiveGateway_0p2e5vq"/>

    <!-- ERP Transfer -->
    <bpmn:sequenceFlow id="SequenceFlow_8w3k1j6" name="" sourceRef="DataObjectReference_1q0w3k6" targetRef="UserTask_4z9j2m5"/>
    <bpmn:sequenceFlow id="SequenceFlow_9x2v8mk" sourceRef="UserTask_4z9j2m5" name="" targetRef="ExclusiveGateway_0p2e5vq"/>

    <!-- Decision Point -->
    <bpmn:sequenceFlow id="SequenceFlow_6m0w8p4" name="Parts needed" sourceRef="ExclusiveGateway_0p2e5vq" targetRef="DataObjectReference_1q0w3k6"/>
    <bpmn:sequenceFlow id="SequenceFlow_2t4h1xq" name="No parts needed" sourceRef="ExclusiveGateway_0p2e5vq" targetRef="IntermediateThrowEvent_055ca3q"/>

    <!-- Production Implementation -->
    <bpmn:sequenceFlow id="SequenceFlow_1j94oja" sourceRef="IntermediateThrowEvent_055ca3q" targetRef="UserTask_0vaxgaa"/>
    <bpmn:sequenceFlow id="SequenceFlow_8j5m3vn" name="" sourceRef="UserTask_0vaxgaa" targetRef="UserTask_0e6hvnj"/>

  </bpmn:process>
</bpmn:definitions>