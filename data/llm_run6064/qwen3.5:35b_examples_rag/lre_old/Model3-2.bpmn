<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_0a3f8y6" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_CourtProcess">
    <bpmn:participant id="Participant_CourtAdmin" name="Court Administration" processRef="Process_Main"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Main" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Administrator" name="Administrator">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckFiles</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_MissingCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SearchFiles</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TrackLocation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_ReadyMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_ParallelSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HandOverFiles</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Distribution" name="Distribution Team">
        <bpmn:flowNodeRef>Task_DistributeLawlist</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Each morning">
      <bpmn:outgoing>SequenceFlow_CheckFiles</bpmn:outgoing>
      <bpmn:timerEventDefinition />
    </bpmn:startEvent>

    <!-- Task 1 -->
    <bpmn:task id="Task_CheckFiles" name="Check Files Order">
      <bpmn:incoming>SequenceFlow_CheckFiles</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MissingCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway XOR -->
    <bpmn:exclusiveGateway id="Gw_MissingCheck" name="Missing?">
      <bpmn:incoming>SequenceFlow_MissingCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SearchFiles</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_TrackLocation</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Path A -->
    <bpmn:task id="Task_SearchFiles" name="Initiate File Search">
      <bpmn:incoming>SequenceFlow_SearchFiles</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeReady1</bpmn:outgoing>
    </bpmn:task>

    <!-- Path B -->
    <bpmn:task id="Task_TrackLocation" name="Track Files Location">
      <bpmn:incoming>SequenceFlow_TrackLocation</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeReady2</bpmn:outgoing>
    </bpmn:task>

    <!-- Merge Point (XOR Join) -->
    <bpmn:exclusiveGateway id="Gw_ReadyMerge">
      <bpmn:incoming>SequenceFlow_MergeReady1</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_MergeReady2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ParallelSplit</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Parallel Split -->
    <bpmn:parallelGateway id="Gw_ParallelSplit">
      <bpmn:incoming>SequenceFlow_ParallelSplit</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_HandoverFiles</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_DistributeLawlist</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task Handover -->
    <bpmn:task id="Task_HandOverFiles" name="Hand Over Files to Associate">
      <bpmn:incoming>SequenceFlow_HandoverFiles</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_JoinHearing1</bpmn:outgoing>
    </bpmn:task>

    <!-- Task Lawlist -->
    <bpmn:task id="Task_DistributeLawlist" name="Distribute Judges Lawlist">
      <bpmn:incoming>SequenceFlow_DistributeLawlist</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_JoinHearing2</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Join -->
    <bpmn:parallelGateway id="Gw_ParallelJoin">
      <bpmn:incoming>SequenceFlow_JoinHearing1</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_JoinHearing2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_HearingsConducted</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Final Task -->
    <bpmn:endEvent id="EndEvent_1" name="Hearings Conducted">
      <bpmn:incoming>SequenceFlow_HearingsConducted</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckFiles" sourceRef="StartEvent_1" targetRef="Task_CheckFiles"/>
    <bpmn:sequenceFlow id="SequenceFlow_MissingCheck" name="" sourceRef="Task_CheckFiles" targetRef="Gw_MissingCheck"/>

    <!-- Paths from Missing Gateway -->
    <bpmn:sequenceFlow id="SequenceFlow_SearchFiles" name="Yes" sourceRef="Gw_MissingCheck" targetRef="Task_SearchFiles"/>
    <bpmn:sequenceFlow id="SequenceFlow_TrackLocation" name="No" sourceRef="Gw_MissingCheck" targetRef="Task_TrackLocation"/>

    <!-- Merge Paths -->
    <bpmn:sequenceFlow id="SequenceFlow_MergeReady1" sourceRef="Task_SearchFiles" targetRef="Gw_ReadyMerge"/>
    <bpmn:sequenceFlow id="SequenceFlow_MergeReady2" name="" sourceRef="Task_TrackLocation" targetRef="Gw_ReadyMerge"/>

    <!-- Parallel Split -->
    <bpmn:sequenceFlow id="SequenceFlow_ParallelSplit" sourceRef="Gw_ReadyMerge" targetRef="Gw_ParallelSplit"/>
    
    <!-- Handover Path -->
    <bpmn:sequenceFlow id="SequenceFlow_HandoverFiles" name="" sourceRef="Gw_ParallelSplit" targetRef="Task_HandOverFiles"/>

    <!-- Lawlist Path -->
    <bpmn:sequenceFlow id="SequenceFlow_DistributeLawlist" name="" sourceRef="Gw_ParallelSplit" targetRef="Task_DistributeLawlist"/>

    <!-- Join Paths before Hearing -->
    <bpmn:sequenceFlow id="SequenceFlow_JoinHearing1" sourceRef="Task_HandOverFiles" targetRef="Gw_ParallelJoin"/>
    <bpmn:sequenceFlow id="SequenceFlow_JoinHearing2" name="" sourceRef="Task_DistributeLawlist" targetRef="Gw_ParallelJoin"/>

    <!-- Final Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_HearingsConducted" sourceRef="Gw_ParallelJoin" targetRef="EndEvent_1"/>

  </bpmn:process>
</bpmn:definitions>