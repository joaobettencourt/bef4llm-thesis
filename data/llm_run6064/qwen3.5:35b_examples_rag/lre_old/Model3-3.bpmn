<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Claims Handling Process" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Claim Registered">
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Claims Officer Examines Claim Task -->
    <bpmn:task id="Task_2" name="Claims Officer Examines Claim">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:task>

    <!-- Write Settlement Recommendation Task -->
    <bpmn:task id="Task_3" name="Write Settlement Recommendation">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
    </bpmn:task>

    <!-- Senior Checks Recommendation Task -->
    <bpmn:task id="Task_4" name="Senior Claims Officer Checks">
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
    </bpmn:task>

    <!-- Decision Gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_1" name="Recommendation OK?">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_1" name="Process Continues">
      <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Repeat Recommendation Task (for loop back) -->
    <bpmn:task id="Task_3_loopback" name="Repeat Settlement Recommendation">
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_2" name="" sourceRef="Task_2" targetRef="Task_3"/>
    <bpmn:sequenceFlow id="SequenceFlow_3" name="" sourceRef="Task_3" targetRef="Task_4"/>
    <bpmn:sequenceFlow id="SequenceFlow_4" name="" sourceRef="Task_4" targetRef="ExclusiveGateway_1"/>

    <!-- OK Path -->
    <bpmn:sequenceFlow id="SequenceFlow_5" name="OK" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_1"/>

    <!-- Not OK Path (Loop Back) -->
    <bpmn:sequenceFlow id="SequenceFlow_6" name="Not OK" sourceRef="ExclusiveGateway_1" targetRef="Task_3_loopback"/>
    <bpmn:sequenceFlow id="SequenceFlow_7" name="" sourceRef="Task_3_loopback" targetRef="ExclusiveGateway_1"/>

  </bpmn:process>
</bpmn:definitions>