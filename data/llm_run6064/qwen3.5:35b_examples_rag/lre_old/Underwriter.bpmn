<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                 xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" 
                 xmlns:di="http://www.omg.org/spec/DD/20100524/DI" 
                 xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                 id="Definitions_ipo_process" targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:collaboration id="Collab_IPO_Process"/>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Company" name="Company Management">
        <bpmn:flowNodeRef>StartEvent_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectUnderwriters</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Underwriter" name="Underwriters">
        <bpmn:flowNodeRef>ExclusiveGateway_FactsCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareRegistration</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CatchEvent_SEC_Clearance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RoadShowFirmUp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FixIssuePrice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_ReasonCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Cancelled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CommitmentOffer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Success</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Decision" name="Decision to Go Public">
      <bpmn:name>Decision to Go Public</bpmn:name>
      <bpmn:outgoing>SequenceFlow_SelectUnderwriters</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1 -->
    <bpmn:task id="Task_SelectUnderwriters" name="Select the underwriters">
      <bpmn:name>Select the underwriters</bpmn:name>
      <bpmn:incoming>SequenceFlow_SelectUnderwriters</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FactsCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1 -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_FactsCheck" name="Facts Fairly Presented?">
      <bpmn:name>Facts Fairly Presented?</bpmn:name>
      <bpmn:incoming>SequenceFlow_FactsCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RejectIPO</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SplitProcess</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event 1 -->
    <bpmn:endEvent id="EndEvent_Cancelled" name="IPO Cancelled">
      <bpmn:name>IPO Cancelled</bpmn:name>
      <bpmn:incoming>SequenceFlow_RejectIPO</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Parallel Gateway Split -->
    <bpmn:parallelGateway id="ParallelGateway_Split" name="Wait for SEC / Roadshow">
      <bpmn:name>Wait for SEC / Roadshow</bpmn:name>
      <bpmn:incoming>SequenceFlow_SplitProcess</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RegistrationPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RoadShowPath</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 2 -->
    <bpmn:task id="Task_PrepareRegistration" name="Prepare Registration Statement &amp; Check Blue-Sky Laws">
      <bpmn:name>Prepare Registration Statement &amp; Check Blue-Sky Laws</bpmn:name>
      <bpmn:incoming>SequenceFlow_RegistrationPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitSEC</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Catch Event -->
    <bpmn:intermediateCatchEvent id="CatchEvent_SEC_Clearance" name="Receive SEC Clearance">
      <bpmn:name>Receive SEC Clearance</bpmn:name>
      <bpmn:incoming>SequenceFlow_WaitSEC</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FixPriceTrigger</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task 3 -->
    <bpmn:task id="Task_RoadShowFirmUp" name="Arrange Road Show &amp; Firm Up Issue Price">
      <bpmn:name>Arrange Road Show &amp; Firm Up Issue Price</bpmn:name>
      <bpmn:incoming>SequenceFlow_RoadShowPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RoadShowComplete</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway Merge -->
    <bpmn:parallelGateway id="ParallelGateway_Merge" name="Merge Paths">
      <bpmn:name>Merge Paths</bpmn:name>
      <bpmn:incoming>SequenceFlow_FixPriceTrigger</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_RoadShowComplete</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FinalFixPrice</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 4 -->
    <bpmn:task id="Task_FixIssuePrice" name="Fix the Issue Price">
      <bpmn:name>Fix the Issue Price</bpmn:name>
      <bpmn:incoming>SequenceFlow_FinalFixPrice</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReasonCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2 -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_ReasonCheck" name="Reason Not To Proceed?">
      <bpmn:name>Reason Not To Proceed?</bpmn:name>
      <bpmn:incoming>SequenceFlow_FinalFixPrice</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CancelIPO</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_OfferPublic</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event 2 -->
    <bpmn:endEvent id="EndEvent_Success" name="Offered to Public">
      <bpmn:name>Offered to Public</bpmn:name>
      <bpmn:incoming>SequenceFlow_CommitmentOffer</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task 5 -->
    <bpmn:task id="Task_CommitmentOffer" name="Enter Firm Commitment &amp; Offer to Public">
      <bpmn:name>Enter Firm Commitment &amp; Offer to Public</bpmn:name>
      <bpmn:incoming>SequenceFlow_OfferPublic</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CommitmentOffer</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 3 -->
    <bpmn:endEvent id="EndEvent_CancelIPO" name="Process Cancelled">
      <bpmn:name>Process Cancelled</bpmn:name>
      <bpmn:incoming>SequenceFlow_CancelIPO</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_SelectUnderwriters" sourceRef="StartEvent_Decision" targetRef="Task_SelectUnderwriters"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_FactsCheck" name="" sourceRef="Task_SelectUnderwriters" targetRef="ExclusiveGateway_FactsCheck"/>

    <!-- Facts Check - No -->
    <bpmn:sequenceFlow id="SequenceFlow_RejectIPO" name="No (Facts Unfair)" sourceRef="ExclusiveGateway_FactsCheck" targetRef="EndEvent_Cancelled"/>

    <!-- Facts Check - Yes / Start Parallelism -->
    <bpmn:sequenceFlow id="SequenceFlow_SplitProcess" name="" sourceRef="ExclusiveGateway_FactsCheck" targetRef="ParallelGateway_Split"/>

    <!-- Registration Path -->
    <bpmn:sequenceFlow id="SequenceFlow_RegistrationPath" sourceRef="ParallelGateway_Split" targetRef="Task_PrepareRegistration"/>
    
    <!-- Wait for SEC (from Task to Event) -->
    <bpmn:sequenceFlow id="SequenceFlow_WaitSEC" name="" sourceRef="Task_PrepareRegistration" targetRef="CatchEvent_SEC_Clearance"/>

    <!-- Roadshow Path -->
    <bpmn:sequenceFlow id="SequenceFlow_RoadShowPath" name="" sourceRef="ParallelGateway_Split" targetRef="Task_RoadShowFirmUp"/>

    <!-- Merge Logic Connections -->
    <bpmn:sequenceFlow id="SequenceFlow_FixPriceTrigger" sourceRef="CatchEvent_SEC_Clearance" targetRef="ParallelGateway_Merge"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_RoadShowComplete" name="" sourceRef="Task_RoadShowFirmUp" targetRef="ParallelGateway_Merge"/>

    <!-- Fix Price Task -->
    <bpmn:sequenceFlow id="SequenceFlow_FinalFixPrice" name="" sourceRef="ParallelGateway_Merge" targetRef="Task_FixIssuePrice"/>

    <!-- Reason Check Gateway Input/Output -->
    <bpmn:sequenceFlow id="SequenceFlow_ReasonCheck" sourceRef="Task_FixIssuePrice" targetRef="ExclusiveGateway_ReasonCheck"/>

    <!-- Cancel IPO Path -->
    <bpmn:sequenceFlow id="SequenceFlow_CancelIPO" name="Yes (Found Reason)" sourceRef="ExclusiveGateway_ReasonCheck" targetRef="EndEvent_CancelIPO"/>

    <!-- Offer Public Path -->
    <bpmn:sequenceFlow id="SequenceFlow_OfferPublic" name="" sourceRef="ExclusiveGateway_ReasonCheck" targetRef="Task_CommitmentOffer"/>

  </bpmn:process>
</bpmn:definitions>