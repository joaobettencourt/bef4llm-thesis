<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_3k8m9xq" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_7p2w6rj">
    <bpmn:messageFlow id="MessageFlow_MPON_MPOO" sourceRef="Task_MPON_NotifyMPOO" targetRef="StartEvent_MPOO"/>
    <bpmn:messageFlow id="MessageFlow_MPOO_GO" sourceRef="Intermediate_MPOO_AnnounceSelf" targetRef="Intermediate_GO_MPONInfo"/>
  </bpmn:collaboration>

  <!-- MPON Process -->
  <bpmn:process id="Process_mpon" isExecutable="false">
    <bpmn:startEvent id="StartEvent_MPON" name="Equipment Change Intention">
      <bpmn:outgoing>SequenceFlow_0m1p7kq</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Notify MPOO about equipment change intentions -->
    <bpmn:task id="Task_MPON_NotifyMPOO" name="Notify MPOO of Equipment Change">
      <bpmn:incoming>SequenceFlow_0m1p7kq</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2x8v5tq</bpmn:outgoing>
    </bpmn:task>

    <!-- Wait for MPOO response -->
    <bpmn:intermediateCatchEvent id="Intermediate_MPON_WaitMPOOResponse">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SequenceFlow_2x8v5tq</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3k9m7p4</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Exclusive Gateway for self-dismounting decision -->
    <bpmn:exclusiveGateway id="Exclusive_MPON_SelfDismount" name="MPOO Self-Dismount?">
      <bpmn:incoming>SequenceFlow_3k9m7p4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5h2w8tq</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_6j1v9xq</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- MPON performs final reading -->
    <bpmn:task id="Task_MPON_FinalReading" name="Perform Final Reading">
      <bpmn:incoming>SequenceFlow_5h2w8tq</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_7k3m1p4</bpmn:outgoing>
    </bpmn:task>

    <!-- MPON dismounts old equipment -->
    <bpmn:task id="Task_MPON_Dismount" name="Dismount Old Equipment">
      <bpmn:incoming>SequenceFlow_7k3m1p4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_8v2w6tq</bpmn:outgoing>
    </bpmn:task>

    <!-- MPON mounts new device -->
    <bpmn:task id="Task_MPON_NewDevice" name="Mount New Device">
      <bpmn:incoming>SequenceFlow_8v2w6tq</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_9p4k7m1</bpmn:outgoing>
    </bpmn:task>

    <!-- MPON reads meter count -->
    <bpmn:task id="Task_MPON_ReadMeter" name="Read Meter Count">
      <bpmn:incoming>SequenceFlow_9p4k7m1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0x5v8tq</bpmn:outgoing>
    </bpmn:task>

    <!-- Send values to GO -->
    <bpmn:intermediateThrowEvent id="Intermediate_MPON_SendToGO">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SequenceFlow_0x5v8tq</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1m6k9p4</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <!-- Tell GO about device changes -->
    <bpmn:task id="Task_MPON_TellGO" name="Inform GO of Device Changes">
      <bpmn:incoming>SequenceFlow_1m6k9p4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2t7v5xq</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="End_MPON" name="MPOO Process Complete">
      <bpmn:incoming>SequenceFlow_2t7v5xq</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_0m1p7kq" sourceRef="StartEvent_MPON" targetRef="Task_MPON_NotifyMPOO"/>
    <bpmn:sequenceFlow id="SequenceFlow_2x8v5tq" name="" sourceRef="Task_MPON_NotifyMPOO" targetRef="Intermediate_MPON_WaitMPOOResponse"/>
    <bpmn:sequenceFlow id="SequenceFlow_3k9m7p4" sourceRef="Intermediate_MPON_WaitMPOOResponse" targetRef="Exclusive_MPON_SelfDismount"/>

    <!-- Self-Dismount - Yes Path -->
    <bpmn:sequenceFlow id="SequenceFlow_5h2w8tq" name="Yes (Self-dismount)" sourceRef="Exclusive_MPON_SelfDismount" targetRef="Task_MPON_FinalReading"/>

    <!-- No self-dismounting path - MPON performs tasks -->
    <bpmn:sequenceFlow id="SequenceFlow_6j1v9xq" name="No (MPON Performs)" sourceRef="Exclusive_MPON_SelfDismount" targetRef="Task_MPON_FinalReading"/>

    <!-- Continue flow after reading/dismounting -->
    <bpmn:sequenceFlow id="SequenceFlow_7k3m1p4" sourceRef="Task_MPON_FinalReading" targetRef="Task_MPON_Dismount"/>
    <bpmn:sequenceFlow id="SequenceFlow_8v2w6tq" name="" sourceRef="Task_MPON_Dismount" targetRef="Task_MPON_NewDevice"/>
    <bpmn:sequenceFlow id="SequenceFlow_9p4k7m1" sourceRef="Task_MPON_NewDevice" targetRef="Task_MPON_ReadMeter"/>

    <!-- Send to GO -->
    <bpmn:sequenceFlow id="SequenceFlow_0x5v8tq" name="" sourceRef="Task_MPON_ReadMeter" targetRef="Intermediate_MPON_SendToGO"/>
    <bpmn:sequenceFlow id="SequenceFlow_1m6k9p4" sourceRef="Intermediate_MPON_SendToGO" targetRef="Task_MPON_TellGO"/>

    <!-- End -->
    <bpmn:sequenceFlow id="SequenceFlow_2t7v5xq" name="" sourceRef="Task_MPON_TellGO" targetRef="End_MPON"/>
  </bpmn:process>

  <!-- MPOO Process -->
  <bpmn:process id="Process_mpoa" isExecutable="false">
    <bpmn:startEvent id="StartEvent_MPOO" name="Receive Equipment Change Notification">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_0m2p8kq</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Announce self-dismounting decision -->
    <bpmn:task id="Task_MPOO_DecideDismount" name="Decide Self-Dismount">
      <bpmn:incoming>SequenceFlow_0m2p8kq</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1x3v9tq</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway for announcement -->
    <bpmn:exclusiveGateway id="Exclusive_MPOO_Announce" name="Announcement Type?">
      <bpmn:incoming>SequenceFlow_1x3v9tq</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2k4m7p5</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_3j6w8tq</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Announce self-dismounting -->
    <bpmn:intermediateThrowEvent id="Intermediate_MPOO_AnnounceSelf">
      <bpmn:messageEventDefinition/>
      <bpmn:name>MPOO Announces Self-Dismount</bpmn:name>
      <bpmn:incoming>SequenceFlow_2k4m7p5</bpmn:incoming>
    </bpmn:intermediateThrowEvent>

    <!-- Announce no self-dismounting -->
    <bpmn:task id="Task_MPOO_AnnounceNoSelf" name="Announce No Self-Dismount">
      <bpmn:name>MPOO Notifies MPON of No Self-Dismount</bpmn:name>
      <bpmn:incoming>SequenceFlow_3j6w8tq</bpmn:incoming>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="End_MPOO" name="MPOO Process Complete">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SequenceFlow_4v7k1p5</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_0m2p8kq" sourceRef="StartEvent_MPOO" targetRef="Task_MPOO_DecideDismount"/>
    <bpmn:sequenceFlow id="SequenceFlow_1x3v9tq" name="" sourceRef="Task_MPOO_DecideDismount" targetRef="Exclusive_MPOO_Announce"/>

    <!-- Self-dismount path -->
    <bpmn:sequenceFlow id="SequenceFlow_2k4m7p5" name="Self-Dismount" sourceRef="Exclusive_MPOO_Announce" targetRef="Intermediate_MPOO_AnnounceSelf"/>

    <!-- No self-dismounting path -->
    <bpmn:sequenceFlow id="SequenceFlow_3j6w8tq" name="No Self-Dismount" sourceRef="Exclusive_MPOO_Announce" targetRef="Task_MPOO_AnnounceNoSelf"/>

    <!-- End flow from both paths -->
    <bpmn:sequenceFlow id="SequenceFlow_4v7k1p5" sourceRef="Intermediate_MPOO_AnnounceSelf" targetRef="End_MPOO"/>
  </bpmn:process>

  <!-- GO Process -->
  <bpmn:process id="Process_GO" isExecutable="false">
    <bpmn:startEvent id="StartEvent_GO" name="Receive Device Change Information">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_0g1m5tq</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Receive information from MPON -->
    <bpmn:intermediateCatchEvent id="Intermediate_GO_MPONInfo">
      <bpmn:messageEventDefinition/>
      <bpmn:name>MPOO Sends Device Changes Info</bpmn:name>
      <bpmn:incoming>SequenceFlow_0g1m5tq</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2h8k6p4</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Notify MSP about device changes -->
    <bpmn:task id="Task_GO_NotifyMSP" name="Notify MSP of Device Changes">
      <bpmn:name>MPOO Notifies MSP About Device Changes, Master Data and Meter Counts</bpmn:name>
      <bpmn:incoming>SequenceFlow_2h8k6p4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3v9m7tq</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="End_GO" name="MPOO Process Complete">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SequenceFlow_3v9m7tq</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_0g1m5tq" sourceRef="StartEvent_GO" targetRef="Intermediate_GO_MPONInfo"/>
    <bpmn:sequenceFlow id="SequenceFlow_2h8k6p4" name="" sourceRef="Intermediate_GO_MPONInfo" targetRef="Task_GO_NotifyMSP"/>

    <!-- End -->
    <bpmn:sequenceFlow id="SequenceFlow_3v9m7tq" sourceRef="Task_GO_NotifyMSP" targetRef="End_GO"/>
  </bpmn:process>

</bpmn:definitions>