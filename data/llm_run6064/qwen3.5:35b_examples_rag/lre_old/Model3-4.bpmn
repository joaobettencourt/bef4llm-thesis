<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1m9e7qz"/>

  <bpmn:process id="Process_claimHandling" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_ClaimReceived">
      <bpmn:name>Claim Received</bpmn:name>
      <bpmn:outgoing>SequenceFlow_SendQuestionnaire</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Send Initial Questionnaire -->
    <bpmn:task id="Task_SendQuestionnaire" name="Send Questionnaire to Claimant">
      <bpmn:incoming>SequenceFlow_SendQuestionnaire</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitResponse1</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Catching Timer Event (5 days) -->
    <bpmn:intermediateCatchEvent id="Timer_Initial">
      <bpmn:name/>
      <bpmn:timerDuration>P5D</bpmn:timerDuration>
      <bpmn:incoming>SequenceFlow_WaitResponse1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckResponse</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Decision Gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_ResponseReceived" name="Questionnaire Received?">
      <bpmn:incoming>SequenceFlow_CheckResponse</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProcessCompleted</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SendReminder1</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Process Completed Path -->
    <bpmn:endEvent id="EndEvent_Completed">
      <bpmn:name>Questionnaire Received</bpmn:name>
      <bpmn:incoming>SequenceFlow_ProcessCompleted</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Send Reminder Task -->
    <bpmn:task id="Task_SendReminder" name="Send Reminder to Claimant">
      <bpmn:incoming>SequenceFlow_SendReminder1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitResponse2</bpmn:outgoing>
    </bpmn:task>

    <!-- Timer for Response After Reminder (5 days) -->
    <bpmn:intermediateCatchEvent id="Timer_Reminder">
      <bpmn:name/>
      <bpmn:timerDuration>P5D</bpmn:timerDuration>
      <bpmn:incoming>SequenceFlow_WaitResponse2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckReminderResponse</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Decision Gateway for Reminder Response -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_ReminderReceived" name="Questionnaire Received?">
      <bpmn:incoming>SequenceFlow_CheckReminderResponse</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProcessCompleted2</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SendReminder2</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Process Completed Path 2 -->
    <bpmn:endEvent id="EndEvent_Completed2">
      <bpmn:name>Questionnaire Received After Reminder</bpmn:name>
      <bpmn:incoming>SequenceFlow_ProcessCompleted2</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Send Second Reminder Task -->
    <bpmn:task id="Task_SendReminder2" name="Send Another Reminder">
      <bpmn:incoming>SequenceFlow_SendReminder2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitResponse3</bpmn:outgoing>
    </bpmn:task>

    <!-- Timer for Response After Second Reminder (5 days) -->
    <bpmn:intermediateCatchEvent id="Timer_Reminder2">
      <bpmn:name/>
      <bpmn:timerDuration>P5D</bpmn:timerDuration>
      <bpmn:incoming>SequenceFlow_WaitResponse3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckSecondReminderResponse</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Decision Gateway for Second Reminder Response -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_SecondReminderReceived" name="Questionnaire Received?">
      <bpmn:incoming>SequenceFlow_CheckSecondReminderResponse</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProcessCompleted3</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Process Completed Path 3 -->
    <bpmn:endEvent id="EndEvent_Completed3">
      <bpmn:name>Questionnaire Received After Second Reminder</bpmn:name>
      <bpmn:incoming>SequenceFlow_ProcessCompleted3</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_SendQuestionnaire" sourceRef="StartEvent_ClaimReceived" targetRef="Task_SendQuestionnaire"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_WaitResponse1" name="" sourceRef="Task_SendQuestionnaire" targetRef="Timer_Initial"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_CheckResponse" name="" sourceRef="Timer_Initial" targetRef="ExclusiveGateway_ResponseReceived">
      <bpmn:name>Yes</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_SendReminder1" name="" sourceRef="ExclusiveGateway_ResponseReceived" targetRef="Task_SendReminder"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_WaitResponse2" name="" sourceRef="Task_SendReminder" targetRef="Timer_Reminder"/>

    <bpmn:sequenceFlow id="SequenceFlow_CheckReminderResponse" name="" sourceRef="Timer_Reminder" targetRef="ExclusiveGateway_ReminderReceived">
      <bpmn:name>Yes</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_SendReminder2" name="" sourceRef="ExclusiveGateway_ReminderReceived" targetRef="Task_SendReminder2"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_WaitResponse3" name="" sourceRef="Task_SendReminder2" targetRef="Timer_Reminder2"/>

    <bpmn:sequenceFlow id="SequenceFlow_CheckSecondReminderResponse" name="" sourceRef="Timer_Reminder2" targetRef="ExclusiveGateway_SecondReminderReceived">
      <bpmn:name>Yes</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>

</bpmn:definitions>