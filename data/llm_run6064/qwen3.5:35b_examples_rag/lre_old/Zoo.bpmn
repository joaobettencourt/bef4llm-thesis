<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1">
  <bpmn:collaboration id="Collaboration_1m9e7qz">
    <bpmn:messageFlow id="MessageFlow_Visitor_ZooClub" sourceRef="Task_Visitor_SendInfo" targetRef="StartEvent_ZooClub"/>
    <bpmn:messageFlow id="MessageFlow_ZooClub_Billing" sourceRef="Task_ZooClub_PaymentRequest" targetRef="StartEvent_Billing"/>
    <bpmn:messageFlow id="MessageFlow_Billing_Bank" sourceRef="Task_Billing_SendToBank" targetRef="StartEvent_Bank"/>
    <bpmn:messageFlow id="MessageFlow_Bank_Confirmation" sourceRef="EndEvent_Bank_Success" targetRef="IntermediateCatch_ZooClub_PaymentConfirmed"/>
    <bpmn:messageFlow id="MessageFlow_ZooClub_Marketing" sourceRef="Task_ZooClub_ForwardInfo" targetRef="StartEvent_Marketing"/>
  </bpmn:collaboration>

  <!-- Visitor Pool -->
  <bpmn:process id="Process_Visitor">
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:name>Visitor Wants Membership</bpmn:name>
      <bpmn:outgoing>SequenceFlow_DecideType</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_Visitor_Decide" name="Decide Membership Type">
      <bpmn:incoming>SequenceFlow_DecideType</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_XG_MemberType</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="ExclusiveGateway_1" name="Membership Type?">
      <bpmn:incoming>SequenceFlow_XG_MemberType</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PrepareIndividual</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PrepareFamily</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_Visitor_PrepIndiv" name="Prepare Personal Info">
      <bpmn:name>Individual Membership Prep</bpmn:name>
      <bpmn:incoming>SequenceFlow_PrepareIndividual</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeInfo1</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_Visitor_PrepFamily" name="Prepare Family Info">
      <bpmn:name>Family Membership Prep (Spouse/Spawn)</bpmn:name>
      <bpmn:incoming>SequenceFlow_PrepareFamily</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeInfo2</bpmn:outgoing>
    </bpmn:task>

    <!-- Merge Point for Visitor Preparation -->
    <bpmn:parallelGateway id="ParallelGateway_Visitor_Merge">
      <bpmn:name>Merge Info Paths</bpmn:name>
      <bpmn:incoming>SequenceFlow_MergeInfo1</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_MergeInfo2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendToZooClub</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Send Info to ZooClub -->
    <bpmn:task id="Task_Visitor_SendInfo" name="Give Information">
      <bpmn:name>Send Membership Application</bpmn:name>
      <bpmn:incoming>SequenceFlow_SendToZooClub</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitCardDelivery</bpmn:outgoing>
    </bpmn:task>

    <!-- Wait for Card Delivery -->
    <bpmn:intermediateCatchEvent id="IntermediateCatch_Visitor_CardReceived" name="Receive Membership Card">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SequenceFlow_WaitCardDelivery</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GoHome</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Visitor_Home">
      <bpmn:name>Go Home</bpmn:name>
      <bpmn:incoming>SequenceFlow_GoHome</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_DecideType" sourceRef="StartEvent_1" targetRef="Task_Visitor_Decide"/>
    <bpmn:sequenceFlow id="SequenceFlow_XG_MemberType" sourceRef="Task_Visitor_Decide" targetRef="ExclusiveGateway_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_PrepareIndividual" name="Individual" sourceRef="ExclusiveGateway_1" targetRef="Task_Visitor_PrepIndiv"/>
    <bpmn:sequenceFlow id="SequenceFlow_PrepareFamily" name="Family" sourceRef="ExclusiveGateway_1" targetRef="Task_Visitor_PrepFamily"/>
    <bpmn:sequenceFlow id="SequenceFlow_MergeInfo1" sourceRef="Task_Visitor_PrepIndiv" targetRef="ParallelGateway_Visitor_Merge"/>
    <bpmn:sequenceFlow id="SequenceFlow_MergeInfo2" sourceRef="Task_Visitor_PrepFamily" targetRef="ParallelGateway_Visitor_Merge"/>

  </bpmn:process>

  <!-- ZooClub Department Pool -->
  <bpmn:process id="Process_ZooClub">
    <bpmn:startEvent id="StartEvent_ZooClub" name="Receive Application">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_IntroduceData</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Introduce Data -->
    <bpmn:task id="Task_ZooClub_Data" name="Introduce Personal Data">
      <bpmn:name>Data Entry into System</bpmn:name>
      <bpmn:incoming>SequenceFlow_IntroduceData</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SplitParallel</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Split -->
    <bpmn:parallelGateway id="ParallelGateway_ZooClub">
      <bpmn:name>Data Processing Paths</bpmn:name>
      <bpmn:incoming>SequenceFlow_SplitParallel</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendPaymentRequest</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ForwardMarketingInfo</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Path 1: Payment Processing -->
    <bpmn:task id="Task_ZooClub_PaymentRequest" name="Take Payment Request">
      <bpmn:name>Send to Billing Dept</bpmn:name>
      <bpmn:incoming>SequenceFlow_SendPaymentRequest</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitConfirmation</bpmn:outgoing>
    </bpmn:task>

    <!-- Wait for Confirmation -->
    <bpmn:intermediateCatchEvent id="IntermediateCatch_ZooClub_PaymentConfirmed" name="Payment Confirmed">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SequenceFlow_WaitConfirmation</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PrintCard</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Print & Deliver Card -->
    <bpmn:task id="Task_ZooClub_Card" name="Print and Deliver Card">
      <bpmn:name>Create Membership Card</bpmn:name>
      <bpmn:incoming>SequenceFlow_PrintCard</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendToVisitor</bpmn:outgoing>
    </bpmn:task>

    <!-- Path 2: Marketing -->
    <bpmn:task id="Task_ZooClub_ForwardInfo" name="Forward Info to Marketing">
      <bpmn:name>Send Visitor Data for Magazine</bpmn:name>
      <bpmn:incoming>SequenceFlow_ForwardMarketingInfo</bpmn:incoming>
    </bpmn:task>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_ZooClub_ProcessComplete">
      <bpmn:name>ZooClub Process Complete</bpmn:name>
      <bpmn:incoming>SequenceFlow_SendToVisitor</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_IntroduceData" sourceRef="StartEvent_ZooClub" targetRef="Task_ZooClub_Data"/>
    <bpmn:sequenceFlow id="SequenceFlow_SplitParallel" sourceRef="Task_ZooClub_Data" targetRef="ParallelGateway_ZooClub"/>
    <bpmn:sequenceFlow id="SequenceFlow_SendPaymentRequest" name="" sourceRef="ParallelGateway_ZooClub" targetRef="Task_ZooClub_PaymentRequest"/>
    <bpmn:sequenceFlow id="SequenceFlow_WaitConfirmation" sourceRef="Task_ZooClub_PaymentRequest" targetRef="IntermediateCatch_ZooClub_PaymentConfirmed"/>
    <bpmn:sequenceFlow id="SequenceFlow_PrintCard" name="" sourceRef="IntermediateCatch_ZooClub_PaymentConfirmed" targetRef="Task_ZooClub_Card"/>
    <bpmn:sequenceFlow id="SequenceFlow_SendToVisitor" sourceRef="Task_ZooClub_Card" targetRef="EndEvent_ZooClub_ProcessComplete"/>
    <bpmn:sequenceFlow id="SequenceFlow_ForwardMarketingInfo" name="" sourceRef="ParallelGateway_ZooClub" targetRef="Task_ZooClub_ForwardInfo"/>

  </bpmn:process>

  <!-- Billing Department Pool -->
  <bpmn:process id="Process_Billing">
    <bpmn:startEvent id="StartEvent_Billing" name="Receive Payment Request">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_SendToBank</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Send to Bank -->
    <bpmn:task id="Task_Billing_SendToBank" name="Send Payment Request">
      <bpmn:name>To Billing Dept Process</bpmn:name>
      <bpmn:incoming>SequenceFlow_SendToBank</bpmn:incoming>
    </bpmn:task>

  </bpmn:process>

  <!-- Bank Pool -->
  <bpmn:process id="Process_Bank">
    <bpmn:startEvent id="StartEvent_Bank" name="Receive Payment Info">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_ProcessPayment</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Process & Charge -->
    <bpmn:task id="Task_Bank_Charge" name="Process Payment">
      <bpmn:name>Charge User Account</bpmn:name>
      <bpmn:incoming>SequenceFlow_ProcessPayment</bpmn:incoming>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Bank_Success">
      <bpmn:name>Payment Successful</bpmn:name>
      <bpmn:incoming>SequenceFlow_ProcessPayment</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>

  <!-- Marketing Department Pool -->
  <bpmn:process id="Process_Marketing">
    <bpmn:startEvent id="StartEvent_Marketing" name="Receive Visitor Info">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_RequestMagazine</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Mail Magazine -->
    <bpmn:task id="Task_Marketing_Magazine" name="Request Magazine">
      <bpmn:name>Mailing Request to Home</bpmn:name>
      <bpmn:incoming>SequenceFlow_RequestMagazine</bpmn:incoming>
    </bpmn:task>

  </bpmn:process>

</bpmn:definitions>