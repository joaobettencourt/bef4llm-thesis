<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Account Defaulters Process" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <!-- Start Event - Weekday Morning Timer -->
    <bpmn:startEvent id="StartEvent_0geryc1" name="Weekday Morning Backup Process">
      <bpmn:outgoing>SequenceFlow_0iu9po7</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1 - Database Backup -->
    <bpmn:task id="Task_12j0pib" name="Backup Database">
      <bpmn:incoming>SequenceFlow_0iu9po7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1j94oja</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1 - Check for New Defaulters -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_0p2e5vq" name="New Defaulter Records?">
      <bpmn:incoming>SequenceFlow_1j94oja</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1dlbln9</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_0kz5g1t</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 2 - Check CRM for Returns -->
    <bpmn:task id="Task_0jsoxba" name="Check CRM System">
      <bpmn:incoming>SequenceFlow_1dlbln9</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0mp5byl</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2 - Check for New Returns -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_1dgb4sg" name="New CRM Returns?">
      <bpmn:incoming>SequenceFlow_0mp5byl</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0buzwss</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_1xv6wk4</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 3 - Register Defaulting Accounts -->
    <bpmn:task id="Task_0e6hvnj" name="Register Defaulter Accounts">
      <bpmn:incoming>SequenceFlow_1xv6wk4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1pq8ub3</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 4 - Check Previously Advised Codes -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_0z5sib0" name="Client Codes Advised?">
      <bpmn:incoming>SequenceFlow_1pq8ub3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6r8v2kw</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_7y1f5nz</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 5 - Produce Report Table -->
    <bpmn:task id="Task_0s79ile" name="Produce Defaulting Accounts Table">
      <bpmn:incoming>SequenceFlow_6r8v2kw</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1rss71o</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 6 - Send to Account Management -->
    <bpmn:task id="Task_05ftug5" name="Send Report to Account Management">
      <bpmn:incoming>SequenceFlow_1rss71o</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0ajhekx</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Timer Event - 2:30 PM Deadline -->
    <bpmn:intermediateCatchEvent id="IntermediateTimerEvent_1" name="Alert if after 2:30 pm">
      <bpmn:incoming>SequenceFlow_7y1f5nz</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_8w3k1j6</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task 7 - Send Alert to Supervisor -->
    <bpmn:task id="Task_0vaxgaa" name="Send Alert to Supervisor">
      <bpmn:incoming>SequenceFlow_8w3k1j6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_9x2v8mk</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 3 - Check CRM Again After Report -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_1mpgzhg" name="New Returns Filed?">
      <bpmn:incoming>SequenceFlow_0ajhekx</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2t4h1xq</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 8 - Reconcile with Defaulters Table -->
    <bpmn:task id="Task_0sl26uo" name="Reconcile Account Defaulters">
      <bpmn:incoming>SequenceFlow_2t4h1xq</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5h7x9qj</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Timer Event - 4:00 PM Deadline -->
    <bpmn:intermediateCatchEvent id="IntermediateTimerEvent_2" name="Alert if after 4:00 pm">
      <bpmn:incoming>SequenceFlow_5h7x9qj</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6m0w8p4</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task 9 - Send Message to Supervisor -->
    <bpmn:task id="Task_3v7j9k5" name="Send Message to Supervisor">
      <bpmn:incoming>SequenceFlow_6m0w8p4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1ujhfx4</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_0r4t7q3" name="Process Completed">
      <bpmn:incoming>SequenceFlow_1ujhfx4</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_0iu9po7" sourceRef="StartEvent_0geryc1" targetRef="Task_12j0pib"/>
    <bpmn:sequenceFlow id="SequenceFlow_1j94oja" name="" sourceRef="Task_12j0pib" targetRef="ExclusiveGateway_0p2e5vq"/>

    <!-- No New Records Path -->
    <bpmn:sequenceFlow id="SequenceFlow_1dlbln9" name="No new records" sourceRef="ExclusiveGateway_0p2e5vq" targetRef="Task_0jsoxba"/>
    
    <!-- Has New Records Path (skip CRM check) -->
    <bpmn:sequenceFlow id="SequenceFlow_0kz5g1t" name="Has new records" sourceRef="ExclusiveGateway_0p2e5vq" targetRef="Task_0e6hvnj"/>

    <!-- Check for Returns Path -->
    <bpmn:sequenceFlow id="SequenceFlow_0mp5byl" sourceRef="Task_0jsoxba" targetRef="ExclusiveGateway_1dgb4sg"/>

    <!-- New Returns Found Path -->
    <bpmn:sequenceFlow id="SequenceFlow_1xv6wk4" name="Yes, new returns exist" sourceRef="ExclusiveGateway_1dgb4sg" targetRef="Task_0e6hvnj"/>

    <!-- No New Returns - Skip Registration (merge to report check) -->
    <bpmn:sequenceFlow id="SequenceFlow_0buzwss" name="No new returns" sourceRef="ExclusiveGateway_1dgb4sg" targetRef="Task_3v7j9k5"/>

    <!-- Client Codes Advised Path (skip report production) -->
    <bpmn:sequenceFlow id="SequenceFlow_6r8v2kw" name="Yes, previously advised" sourceRef="ExclusiveGateway_0z5sib0" targetRef="Task_3v7j9k5"/>

    <!-- Client Codes Not Advised Path (produce report) -->
    <bpmn:sequenceFlow id="SequenceFlow_7y1f5nz" name="No, not previously advised" sourceRef="ExclusiveGateway_0z5sib0" targetRef="IntermediateTimerEvent_1"/>

    <!-- Report Production Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_1rss71o" sourceRef="Task_0e6hvnj" targetRef="Task_0s79ile"/>
    
    <!-- Send to Account Management -->
    <bpmn:sequenceFlow id="SequenceFlow_0ajhekx" name="" sourceRef="Task_0s79ile" targetRef="ExclusiveGateway_1mpgzhg"/>

    <!-- 2:30 PM Alert Flow (from timer) -->
    <bpmn:sequenceFlow id="SequenceFlow_8w3k1j6" sourceRef="IntermediateTimerEvent_1" targetRef="Task_0vaxgaa"/>

    <!-- After Report Check for Returns -->
    <bpmn:sequenceFlow id="SequenceFlow_2t4h1xq" name="" sourceRef="ExclusiveGateway_1mpgzhg" targetRef="Task_0sl26uo"/>

    <!-- 4:00 PM Alert Flow (from timer) -->
    <bpmn:sequenceFlow id="SequenceFlow_5h7x9qj" sourceRef="IntermediateTimerEvent_2" targetRef="Task_3v7j9k5"/>

    <!-- Final Completion Path -->
    <bpmn:sequenceFlow id="SequenceFlow_1ujhfx4" name="" sourceRef="Task_0sl26uo" targetRef="EndEvent_0r4t7q3"/>

  </bpmn:process>
</bpmn:definitions>