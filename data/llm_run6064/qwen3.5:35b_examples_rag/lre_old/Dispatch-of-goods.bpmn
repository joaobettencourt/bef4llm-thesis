<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1m9e7qz">
    <bpmn:participant id="Participant_0ygkg4f" name="Dispatch of goods&#10;Computer Hardware Shop" processRef="Process_1" />
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_1viot5w" name="Logistics Department Head">
        <bpmn:flowNodeRef>InclusiveGateway_2k8w3p5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_12j0pib</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1ocseyo" name="Secretary">
        <bpmn:flowNodeRef>InclusiveGateway_1dgb4sg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_1p7j0vx</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_2w5q7e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1vl2igx" name="Warehouse">
        <bpmn:flowNodeRef>Task_0sl26uo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1fx9yp3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Goods to be shipped">
      <bpmn:outgoing>SequenceFlow_0g6h8y4</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Secretary Task - Clarify shipping -->
    <bpmn:userTask id="Task_2w5q7e1" name="Clarify who will do the shipping">
      <bpmn:incoming>SequenceFlow_0g6h8y4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3x9k4mz</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Decision Gateway - Large vs Small amounts -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_1p7j0vx" name="Large amount?">
      <bpmn:incoming>SequenceFlow_3x9k4mz</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6r8v2kw</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_7y1f5nz</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Large Amount Path - Special Shipping -->
    <bpmn:userTask id="Task_4z0w3k8" name="Invite 3 logistic companies for offers">
      <bpmn:incoming>SequenceFlow_6r8v2kw</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5h7x9qj</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Secretary selects logistic company -->
    <bpmn:userTask id="Task_1m0p6t4" name="Select one logistic company">
      <bpmn:incoming>SequenceFlow_5h7x9qj</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_8w3k1j6</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Small Amount Path - Normal Post Shipment -->
    <bpmn:userTask id="Task_0e6hvnj" name="Write package label">
      <bpmn:incoming>SequenceFlow_7y1f5nz</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_9x2v8mk</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Insurance Task (Logistics Department Head) -->
    <bpmn:userTask id="Task_12j0pib" name="Take parcel insurance if necessary">
      <bpmn:incoming>SequenceFlow_9x2v8mk</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4t6h3qz</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Warehouse Task - Package goods (parallel) -->
    <bpmn:task id="Task_05ftug5" name="Package goods">
      <bpmn:incoming>SequenceFlow_1ujhfx4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2t8k6p3</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway for warehouse packaging -->
    <bpmn:parallelGateway id="ParallelGateway_02fgrfq">
      <bpmn:incoming>SequenceFlow_1ujhfx4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3v7j9k5</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Inclusive Gateway for merging paths -->
    <bpmn:inclusiveGateway id="InclusiveGateway_1dgb4sg">
      <bpmn:incoming>SequenceFlow_8w3k1j6</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_2t8k6p3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0ajhekx</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Inclusive Gateway for warehouse path -->
    <bpmn:inclusiveGateway id="InclusiveGateway_2k8w3p5">
      <bpmn:incoming>SequenceFlow_4t6h3qz</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0ajhekx</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Final Preparation Task -->
    <bpmn:userTask id="Task_0sl26uo" name="Prepare for pickup by logistic company">
      <bpmn:incoming>SequenceFlow_0ajhekx</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5m9k7qz</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_1fx9yp3" name="Goods prepared for pickup">
      <bpmn:incoming>SequenceFlow_5m9k7qz</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_0g6h8y4" sourceRef="StartEvent_1" targetRef="Task_2w5q7e1"/>
    <bpmn:sequenceFlow id="SequenceFlow_3x9k4mz" name="" sourceRef="Task_2w5q7e1" targetRef="ExclusiveGateway_1p7j0vx"/>

    <!-- Large Amount Path -->
    <bpmn:sequenceFlow id="SequenceFlow_6r8v2kw" name="Yes - large amount" sourceRef="ExclusiveGateway_1p7j0vx" targetRef="Task_4z0w3k8"/>
    <bpmn:sequenceFlow id="SequenceFlow_5h7x9qj" sourceRef="Task_4z0w3k8" targetRef="Task_1m0p6t4"/>
    <bpmn:sequenceFlow id="SequenceFlow_8w3k1j6" name="" sourceRef="Task_1m0p6t4" targetRef="InclusiveGateway_1dgb4sg"/>

    <!-- Small Amount Path -->
    <bpmn:sequenceFlow id="SequenceFlow_7y1f5nz" name="No - small amount" sourceRef="ExclusiveGateway_1p7j0vx" targetRef="Task_0e6hvnj"/>
    <bpmn:sequenceFlow id="SequenceFlow_9x2v8mk" sourceRef="Task_0e6hvnj" targetRef="InclusiveGateway_2k8w3p5"/>

    <!-- Insurance Task -->
    <bpmn:sequenceFlow id="SequenceFlow_4t6h3qz" name="" sourceRef="Task_12j0pib" targetRef="InclusiveGateway_2k8w3p5"/>

    <!-- Warehouse Parallel Path -->
    <bpmn:sequenceFlow id="SequenceFlow_1ujhfx4" sourceRef="ExclusiveGateway_1p7j0vx" targetRef="ParallelGateway_02fgrfq"/>
    <bpmn:sequenceFlow id="SequenceFlow_3v7j9k5" name="" sourceRef="ParallelGateway_02fgrfq" targetRef="Task_05ftug5"/>

    <!-- Merge Paths -->
    <bpmn:sequenceFlow id="SequenceFlow_2t8k6p3" sourceRef="Task_05ftug5" targetRef="InclusiveGateway_1dgb4sg"/>
    <bpmn:sequenceFlow id="SequenceFlow_0ajhekx" name="" sourceRef="InclusiveGateway_1dgb4sg" targetRef="Task_0sl26uo"/>

    <!-- Final Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_5m9k7qz" sourceRef="Task_0sl26uo" targetRef="EndEvent_1fx9yp3"/>

  </bpmn:process>
</bpmn:definitions>