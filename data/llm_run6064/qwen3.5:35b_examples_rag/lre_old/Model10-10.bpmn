<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_FaultRepair_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_FaultRepair_001"/>

  <bpmn:process id="Process_FaultRepair_001" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_FaultDetected_001" name="Fault Detected/Suspected">
      <bpmn:outgoing>SequenceFlow_ExamineFailure_001</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Examine Failure -->
    <bpmn:task id="Task_ExamineFailure_001" name="Examine Failure">
      <bpmn:incoming>SequenceFlow_ExamineFailure_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConfirmFaultDecision_001</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Confirm Fault? -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_ConfirmFault_001" name="Confirm Fault?">
      <bpmn:incoming>SequenceFlow_ConfirmFaultDecision_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RejectPath_001</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_YesPath_001</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event 1: Rejected -->
    <bpmn:endEvent id="EndEvent_Rejected_001" name="Fault Rejected">
      <bpmn:incoming>SequenceFlow_RejectPath_001</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Parallel Split for Initial Notifications (Yes Path) -->
    <bpmn:parallelGateway id="ParallelGateway_InitNotifs_001" name="Notify Stakeholders">
      <bpmn:incoming>SequenceFlow_YesPath_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NotifyCustomerInit_001</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NotifyManagerInit_001</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 2a: Notify Customer (Initial) -->
    <bpmn:task id="Task_NotifyCustomerInit_001" name="Inform Customer">
      <bpmn:incoming>SequenceFlow_NotifyCustomerInit_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeNotifs1_001</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2b: Notify Manager (Initial) -->
    <bpmn:task id="Task_NotifyManagerInit_001" name="Inform Manager">
      <bpmn:incoming>SequenceFlow_NotifyManagerInit_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeNotifs2_001</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Merge for Initial Notifications -->
    <bpmn:parallelGateway id="ParallelGateway_InitMerge_001" name="Notify Stakeholders">
      <bpmn:incoming>SequenceFlow_MergeNotifs1_001</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_MergeNotifs2_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FixFaultTask_001</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 3: Fix Fault -->
    <bpmn:task id="Task_FixFault_001" name="Fix Fault at Measuring Device">
      <bpmn:incoming>SequenceFlow_FixFaultTask_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ShareResults_001</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 4: Share Results with Detector -->
    <bpmn:task id="Task_ShareResults_001" name="Share Repair Results">
      <bpmn:incoming>SequenceFlow_ShareResults_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FinalNotifsSplit_001</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Split for Final Notifications -->
    <bpmn:parallelGateway id="ParallelGateway_FinalNotifs_001" name="Notify Resolution">
      <bpmn:incoming>SequenceFlow_FinalNotifsSplit_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NotifyCusRes_001</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NotifyMgrRes_001</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 5a: Notify Customer (Resolution) -->
    <bpmn:task id="Task_NotifyCusRes_001" name="Inform Customer Resolution">
      <bpmn:incoming>SequenceFlow_NotifyCusRes_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeFinal1_001</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 5b: Notify Manager (Resolution) -->
    <bpmn:task id="Task_NotifyMgrRes_001" name="Inform Manager Resolution">
      <bpmn:incoming>SequenceFlow_NotifyMgrRes_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeFinal2_001</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Merge for Final Notifications -->
    <bpmn:parallelGateway id="ParallelGateway_FinalMerge_001" name="Notify Resolution">
      <bpmn:incoming>SequenceFlow_MergeFinal1_001</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_MergeFinal2_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CompletedEnd_001</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- End Event 2: Completed -->
    <bpmn:endEvent id="EndEvent_Completed_001" name="Process Completed">
      <bpmn:incoming>SequenceFlow_CompletedEnd_001</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_ExamineFailure_001" sourceRef="StartEvent_FaultDetected_001" targetRef="Task_ExamineFailure_001"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ConfirmFaultDecision_001" sourceRef="Task_ExamineFailure_001" targetRef="ExclusiveGateway_ConfirmFault_001"/>

    <!-- Reject Path -->
    <bpmn:sequenceFlow id="SequenceFlow_RejectPath_001" name="No (Reject)" sourceRef="ExclusiveGateway_ConfirmFault_001" targetRef="EndEvent_Rejected_001"/>

    <!-- Confirm/Yes Path to Initial Notifications Split -->
    <bpmn:sequenceFlow id="SequenceFlow_YesPath_001" name="Yes (Confirm)" sourceRef="ExclusiveGateway_ConfirmFault_001" targetRef="ParallelGateway_InitNotifs_001"/>

    <!-- Parallel Tasks for Initial Notification -->
    <bpmn:sequenceFlow id="SequenceFlow_NotifyCustomerInit_001" sourceRef="ParallelGateway_InitNotifs_001" targetRef="Task_NotifyCustomerInit_001"/>
    <bpmn:sequenceFlow id="SequenceFlow_NotifyManagerInit_001" sourceRef="ParallelGateway_InitNotifs_001" targetRef="Task_NotifyManagerInit_001"/>

    <!-- Merge Initial Notifications -->
    <bpmn:sequenceFlow id="SequenceFlow_MergeNotifs1_001" sourceRef="Task_NotifyCustomerInit_001" targetRef="ParallelGateway_InitMerge_001"/>
    <bpmn:sequenceFlow id="SequenceFlow_MergeNotifs2_001" sourceRef="Task_NotifyManagerInit_001" targetRef="ParallelGateway_InitMerge_001"/>

    <!-- Fix Fault -->
    <bpmn:sequenceFlow id="SequenceFlow_FixFaultTask_001" sourceRef="ParallelGateway_InitMerge_001" targetRef="Task_FixFault_001"/>

    <!-- Share Results -->
    <bpmn:sequenceFlow id="SequenceFlow_ShareResults_001" sourceRef="Task_FixFault_001" targetRef="Task_ShareResults_001"/>

    <!-- Parallel Tasks for Final Notification Split -->
    <bpmn:sequenceFlow id="SequenceFlow_FinalNotifsSplit_001" sourceRef="Task_ShareResults_001" targetRef="ParallelGateway_FinalNotifs_001"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_NotifyCusRes_001" sourceRef="ParallelGateway_FinalNotifs_001" targetRef="Task_NotifyCusRes_001"/>
    <bpmn:sequenceFlow id="SequenceFlow_NotifyMgrRes_001" sourceRef="ParallelGateway_FinalNotifs_001" targetRef="Task_NotifyMgrRes_001"/>

    <!-- Merge Final Notifications -->
    <bpmn:sequenceFlow id="SequenceFlow_MergeFinal1_001" sourceRef="Task_NotifyCusRes_001" targetRef="ParallelGateway_FinalMerge_001"/>
    <bpmn:sequenceFlow id="SequenceFlow_MergeFinal2_001" sourceRef="Task_NotifyMgrRes_001" targetRef="ParallelGateway_FinalMerge_001"/>

    <!-- End Event -->
    <bpmn:sequenceFlow id="SequenceFlow_CompletedEnd_001" sourceRef="ParallelGateway_FinalMerge_001" targetRef="EndEvent_Completed_001"/>

  </bpmn:process>
</bpmn:definitions>