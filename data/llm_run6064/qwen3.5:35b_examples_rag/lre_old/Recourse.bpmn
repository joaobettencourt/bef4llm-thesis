<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1m9e7qz">
    <bpmn:participant id="Participant_1p8k5j3" name="Subrogation Process" processRef="Process_0a6h2w4"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_0a6h2w4" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1q7k9m3" name="Subrogation Check Initiated">
      <bpmn:outgoing>SequenceFlow_5x8v2p6</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Get Information Task -->
    <bpmn:task id="Task_3w9k7m1" name="Get Subrogation Information">
      <bpmn:incoming>SequenceFlow_5x8v2p6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4h0j8q5</bpmn:outgoing>
    </bpmn:task>

    <!-- Decision Gateway - Is Recourse Possible? -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_2p6k9m7" name="Recourse Possible?">
      <bpmn:incoming>SequenceFlow_4h0j8q5</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1v3w8k6</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_7m2p9x4</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Close Case - No Recourse -->
    <bpmn:endEvent id="EndEvent_0k5w8q3" name="Case Closed (No Recourse)">
      <bpmn:name>Case Closed</bpmn:name>
      <bpmn:incoming>SequenceFlow_7m2p9x4</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Parallel Gateway - Send Request AND Make Reminder -->
    <bpmn:parallelGateway id="ParallelGateway_1h8k5j3">
      <bpmn:incoming>SequenceFlow_1v3w8k6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_9x4m7p2</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Send Payment Request -->
    <bpmn:task id="Task_6k0w3q8" name="Send Payment Request">
      <bpmn:incoming>SequenceFlow_9x4m7p2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5j1v8h4</bpmn:outgoing>
    </bpmn:task>

    <!-- Make Reminder -->
    <bpmn:task id="Task_0p7w9k2" name="Make Reminder">
      <bpmn:incoming>SequenceFlow_5j1v8h4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3q6m8x1</bpmn:outgoing>
    </bpmn:task>

    <!-- Wait for Response/Deadline -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_4k9w2p7" name="Response Received?">
      <bpmn:incoming>SequenceFlow_3q6m8x1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0h5j9v3</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_2w7k4p6</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Money Received Path -->
    <bpmn:endEvent id="EndEvent_1m8k5q3" name="Case Closed (Money Received)">
      <bpmn:name>Case Closed</bpmn:name>
      <bpmn:incoming>SequenceFlow_0h5j9v3</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Booking Task -->
    <bpmn:task id="Task_2w8k6p4" name="Make Booking">
      <bpmn:incoming>SequenceFlow_0h5j9v3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_7q1m9x5</bpmn:outgoing>
    </bpmn:task>

    <!-- Disagreement Path -->
    <bpmn:endEvent id="EndEvent_2p6k8w3" name="Case Closed (Disagreement)">
      <bpmn:name>Case Closed</bpmn:name>
      <bpmn:incoming>SequenceFlow_7q1m9x5</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Check Disagreement Reasoning -->
    <bpmn:task id="Task_4k0w8p6" name="Check Disagreement">
      <bpmn:incoming>SequenceFlow_2w7k4p6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_9m3v5q1</bpmn:outgoing>
    </bpmn:task>

    <!-- Decision - Is Disagreement Valid? -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_6p8k2w4" name="Disagreement Valid?">
      <bpmn:incoming>SequenceFlow_9m3v5q1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0x7h4j9</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_8k2p6w5</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Forward to Collection Agency -->
    <bpmn:endEvent id="EndEvent_3q9m7k4" name="Case Closed (Collection)">
      <bpmn:name>Case Closed</bpmn:name>
      <bpmn:incoming>SequenceFlow_8k2p6w5</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Deadline Reached Path -->
    <bpmn:task id="Task_7m4k9q1" name="Forward to Collection Agency">
      <bpmn:name>Forward Case to Collection Agency</bpmn:name>
      <bpmn:incoming>SequenceFlow_8k2p6w5</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_5x8v2p6" sourceRef="StartEvent_1q7k9m3" targetRef="Task_3w9k7m1"/>
    <bpmn:sequenceFlow id="SequenceFlow_4h0j8q5" name="" sourceRef="Task_3w9k7m1" targetRef="ExclusiveGateway_2p6k9m7"/>

    <!-- Recourse Possible - Yes Path -->
    <bpmn:sequenceFlow id="SequenceFlow_1v3w8k6" name="Yes" sourceRef="ExclusiveGateway_2p6k9m7" targetRef="ParallelGateway_1h8k5j3"/>

    <!-- Recourse Possible - No Path (Close Case) -->
    <bpmn:sequenceFlow id="SequenceFlow_7m2p9x4" name="No" sourceRef="ExclusiveGateway_2p6k9m7" targetRef="EndEvent_0k5w8q3"/>

    <!-- Parallel Activities - Send Request and Make Reminder -->
    <bpmn:sequenceFlow id="SequenceFlow_9x4m7p2" name="" sourceRef="ParallelGateway_1h8k5j3" targetRef="Task_6k0w3q8"/>
    <bpmn:sequenceFlow id="SequenceFlow_5j1v8h4" name="" sourceRef="Task_6k0w3q8" targetRef="Task_0p7w9k2"/>

    <!-- Wait for Response/Deadline -->
    <bpmn:sequenceFlow id="SequenceFlow_3q6m8x1" name="" sourceRef="Task_0p7w9k2" targetRef="ExclusiveGateway_4k9w2p7"/>

    <!-- Money Received Path -->
    <bpmn:sequenceFlow id="SequenceFlow_0h5j9v3" name="Money Received" sourceRef="ExclusiveGateway_4k9w2p7" targetRef="Task_2w8k6p4"/>

    <!-- Booking and Close Case -->
    <bpmn:sequenceFlow id="SequenceFlow_7q1m9x5" name="" sourceRef="Task_2w8k6p4" targetRef="EndEvent_2p6k8w3"/>

    <!-- Disagreement Path -->
    <bpmn:sequenceFlow id="SequenceFlow_2w7k4p6" name="Disagreement Received" sourceRef="ExclusiveGateway_4k9w2p7" targetRef="Task_4k0w8p6"/>

    <!-- Check Disagreement Reasoning -->
    <bpmn:sequenceFlow id="SequenceFlow_9m3v5q1" name="" sourceRef="Task_4k0w8p6" targetRef="ExclusiveGateway_6p8k2w4"/>

    <!-- Valid Disagreement - Close Case -->
    <bpmn:sequenceFlow id="SequenceFlow_0x7h4j9" name="Valid (Insurant Right)" sourceRef="ExclusiveGateway_6p8k2w4" targetRef="EndEvent_1m8k5q3"/>

    <!-- Invalid Disagreement - Forward to Collection -->
    <bpmn:sequenceFlow id="SequenceFlow_8k2p6w5" name="Invalid (Insurant Wrong)" sourceRef="ExclusiveGateway_6p8k2w4" targetRef="EndEvent_3q9m7k4"/>

  </bpmn:process>
</bpmn:definitions>