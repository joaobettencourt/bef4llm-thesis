<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:messageFlow id="MessageFlow_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_VacancyReported" name="Vacancy Reported">
      <bpmn:outgoing>SequenceFlow_CreateDesc</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Create Job Description -->
    <bpmn:task id="Task_CreateJobDescription" name="Create Job Description">
      <bpmn:incoming>SequenceFlow_CreateDesc</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckConfusion</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Check for confusion -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_Confusion" name="Confusion in message?">
      <bpmn:incoming>SequenceFlow_CheckConfusion</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AskClarification</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SubmitApproval</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Intermediate Event: Ask for clarification -->
    <bpmn:intermediateCatchEvent id="IntermediateMessage_AskClarification" name="Ask Department for Clarification">
      <bpmn:messageRef="MessageClarification"/>
      <bpmn:incoming>SequenceFlow_AskClarification</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ClarifyTask</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task: Clarify with Department -->
    <bpmn:task id="Task_ClariyDepartment" name="Clarify with Department">
      <bpmn:incoming>SequenceFlow_ClarifyTask</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeAfterClarity</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway for merging paths -->
    <bpmn:parallelGateway id="ParallelGateway_ClariyMerge" name="">
      <bpmn:incoming>SequenceFlow_AskClarification</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_SubmitApproval</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeAfterClarity</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Submit for Approval -->
    <bpmn:task id="Task_SubmitApproval" name="Submit Job Description">
      <bpmn:incoming>SequenceFlow_MergeAfterClariy</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Event: Wait for Approval Decision -->
    <bpmn:intermediateCatchEvent id="IntermediateMessage_Approval" name="Wait for Approval">
      <bpmn:messageRef="ApprovalDecision"/>
      <bpmn:incoming>SequenceFlow_WaitDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckApproved</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Gateway: Check if approved -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_Approved" name="Approved?">
      <bpmn:incoming>SequenceFlow_CheckApproved</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CorrectDescription</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PostJob</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Correct Description -->
    <bpmn:task id="Task_CorrectDescription" name="Correct Job Description">
      <bpmn:incoming>SequenceFlow_CorrectDescription</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ResubmitApproval</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Post Job -->
    <bpmn:task id="Task_PostJob" name="Post the Job">
      <bpmn:incoming>SequenceFlow_PostJob</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndProcess</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_JobPosted" name="Job Posted">
      <bpmn:incoming>SequenceFlow_EndProcess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_CreateDesc" sourceRef="StartEvent_VacancyReported" targetRef="Task_CreateJobDescription"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_CheckConfusion" name="" sourceRef="Task_CreateJobDescription" targetRef="ExclusiveGateway_Confusion"/>
    
    <!-- If confusion exists -->
    <bpmn:sequenceFlow id="SequenceFlow_AskClarification" name="Yes - Confusion exists" sourceRef="ExclusiveGateway_Confusion" targetRef="IntermediateMessage_AskClarification"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ClarifyTask" name="" sourceRef="IntermediateMessage_AskClarification" targetRef="Task_ClariyDepartment"/>
    
    <!-- If no confusion -->
    <bpmn:sequenceFlow id="SequenceFlow_SubmitApproval" name="No - Clear message" sourceRef="ExclusiveGateway_Confusion" targetRef="ParallelGateway_ClariyMerge"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_MergeAfterClarity" name="" sourceRef="Task_ClariyDepartment" targetRef="ParallelGateway_ClariyMerge"/>
    
    <!-- Submit for approval -->
    <bpmn:sequenceFlow id="SequenceFlow_SubmitApproval2" name="" sourceRef="ParallelGateway_ClariyMerge" targetRef="Task_SubmitApproval"/>
    
    <!-- Wait for decision -->
    <bpmn:sequenceFlow id="SequenceFlow_WaitDecision" name="" sourceRef="Task_SubmitApproval" targetRef="IntermediateMessage_Approval"/>
    
    <!-- Check approval result -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckApproved" name="" sourceRef="IntermediateMessage_Approval" targetRef="ExclusiveGateway_Approved"/>
    
    <!-- If rejected, correct and resubmit -->
    <bpmn:sequenceFlow id="SequenceFlow_CorrectDescription2" name="Rejected - Request correction" sourceRef="ExclusiveGateway_Approved" targetRef="Task_CorrectDescription"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ResubmitApproval" name="" sourceRef="Task_CorrectDescription" targetRef="ParallelGateway_ClariyMerge"/>
    
    <!-- If approved, post job -->
    <bpmn:sequenceFlow id="SequenceFlow_PostJob2" name="Approved" sourceRef="ExclusiveGateway_Approved" targetRef="Task_PostJob"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_EndProcess" name="" sourceRef="Task_PostJob" targetRef="EndEvent_JobPosted"/>

  </bpmn:process>

</bpmn:definitions>