<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_1m9e7qz">
  <bpmn:collaboration id="Collaboration_1a3f8y6">
    <bpmn:participant id="Participant_1p5k7j3" name="Sales Department" processRef="Process_2w4r0x9"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_2w4r0x9" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Manager" name="Manager">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckLeads</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectTopFive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Interested</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SalesAssistant" name="Sales Assistant">
        <bpmn:flowNodeRef>Task_CallCustomer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MoreLeads</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Open Leads Available">
      <bpmn:name>Open Leads Available</bpmn:name>
      <bpmn:outgoing>SequenceFlow_CheckLeads</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Manager Tasks -->
    <bpmn:task id="Task_CheckLeads" name="Check Open Leads">
      <bpmn:name>Check Open Leads</bpmn:name>
      <bpmn:incoming>SequenceFlow_CheckLeads</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SelectTopFive</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_SelectTopFive" name="Select Top Five Leads">
      <bpmn:name>Select Top Five Leads</bpmn:name>
      <bpmn:incoming>SequenceFlow_SelectTopFive</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AssignCalls</bpmn:outgoing>
    </bpmn:task>

    <!-- Sales Assistant Tasks -->
    <bpmn:task id="Task_CallCustomer" name="Call Customer">
      <bpmn:name>Call Customer</bpmn:name>
      <bpmn:incoming>SequenceFlow_StartLoop</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckInterest</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for Interest -->
    <bpmn:exclusiveGateway id="Gateway_Interested" name="Customer Interested?">
      <bpmn:name>Customer Interested?</bpmn:name>
      <bpmn:incoming>SequenceFlow_CheckInterest</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendNoteTask</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CallNextPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task to Send Note (Sales Assistant) -->
    <bpmn:task id="Task_SendNote" name="Send Note to Manager">
      <bpmn:name>Send Note to Manager</bpmn:name>
      <bpmn:incoming>SequenceFlow_SendNoteTask</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProcessLeadStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Task to Process Lead (Manager) -->
    <bpmn:task id="Task_ProcessLead" name="Process Lead">
      <bpmn:name>Process Lead</bpmn:name>
      <bpmn:incoming>SequenceFlow_ProcessLeadStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckMoreLeads</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for Loop Termination -->
    <bpmn:exclusiveGateway id="Gateway_MoreLeads" name="All Leads Processed?">
      <bpmn:name>All Leads Processed?</bpmn:name>
      <bpmn:incoming>SequenceFlow_CheckMoreLeads</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CallNextLoop</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_1" name="Process Completed">
      <bpmn:name>Process Completed</bpmn:name>
      <bpmn:incoming>SequenceFlow_NoMoreLeads</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckLeads" sourceRef="StartEvent_1" targetRef="Task_CheckLeads"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_SelectTopFive" name="" sourceRef="Task_CheckLeads" targetRef="Task_SelectTopFive"/>

    <!-- Handover to Sales Assistant -->
    <bpmn:sequenceFlow id="SequenceFlow_AssignCalls" name="Assign Calls" sourceRef="Task_SelectTopFive" targetRef="Gateway_Interested">
      <bpmn:name>Assign Calls</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Interest Decision -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckInterest" name="" sourceRef="Task_CallCustomer" targetRef="Gateway_Interested"/>

    <!-- Interested Path (Send Note & Process) -->
    <bpmn:sequenceFlow id="SequenceFlow_SendNoteTask" name="Yes - Interested" sourceRef="Gateway_Interested" targetRef="Task_SendNote">
      <bpmn:name>Yes</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Not Interested Path (Check More Leads) -->
    <bpmn:sequenceFlow id="SequenceFlow_CallNextPath" name="No - Next Customer?" sourceRef="Gateway_Interested" targetRef="Task_SendNote">
      <bpmn:name>No</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Process Lead Start -->
    <bpmn:sequenceFlow id="SequenceFlow_ProcessLeadStart" name="" sourceRef="Task_SendNote" targetRef="Task_ProcessLead"/>

    <!-- Loop Check (After Processing or Skipping) -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckMoreLeads" name="" sourceRef="Task_ProcessLead" targetRef="Gateway_MoreLeads">
      <bpmn:name>Check More Leads</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Loop Back -->
    <bpmn:sequenceFlow id="SequenceFlow_CallNextLoop" name="" sourceRef="Gateway_MoreLeads" targetRef="Task_CallCustomer">
      <bpmn:name>No More Leads?</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- End Process -->
    <bpmn:sequenceFlow id="SequenceFlow_NoMoreLeads" name="" sourceRef="Gateway_MoreLeads" targetRef="EndEvent_1">
      <bpmn:name>All Leads Done</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>

</bpmn:definitions>