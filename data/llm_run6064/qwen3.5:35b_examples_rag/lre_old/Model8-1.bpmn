<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1m9e7qz">
    <bpmn:participant id="Participant_HR" name="HR Department" processRef="Process_Recruitment"/>
    <bpmn:participant id="Participant_Department" name="Functional Department"/>
    <bpmn:messageFlow id="MessageFlow_DemandRequest" sourceRef="Participant_Department" targetRef="StartEvent_RequestReceived"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Recruitment" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_RequestReceived" name="Post Demand Received">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_Advertise</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Advertise Position -->
    <bpmn:task id="Task_AdvertisePosition" name="Advertise Post">
      <bpmn:incoming>SequenceFlow_Advertise</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckApplications</bpmn:outgoing>
    </bpmn:task>

    <!-- Check Applications -->
    <bpmn:task id="Task_CheckApplications" name="Check Applications">
      <bpmn:incoming>SequenceFlow_ApplicationsReceived</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DecisionQualified</bpmn:outgoing>
    </bpmn:task>

    <!-- Decision Gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_Qualified" name="Sufficient Qualified Candidates?">
      <bpmn:incoming>SequenceFlow_DecisionQualified</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ContractProcess</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoCandidates</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Contract Process -->
    <bpmn:task id="Task_SelectCandidate" name="Select Candidate">
      <bpmn:incoming>SequenceFlow_ContractProcess</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NegotiateContract</bpmn:outgoing>
    </bpmn:task>

    <!-- Negotiate Contract -->
    <bpmn:task id="Task_NegotiateContract" name="Negotiate Employment Terms">
      <bpmn:incoming>SequenceFlow_NegotiateContract</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConcludeContract</bpmn:outgoing>
    </bpmn:task>

    <!-- Conclude Contract -->
    <bpmn:task id="Task_ConcludeContract" name="Conclude Employment Contract">
      <bpmn:incoming>SequenceFlow_ConcludeContract</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProcessComplete</bpmn:outgoing>
    </bpmn:task>

    <!-- No Candidates Path -->
    <bpmn:task id="Task_Readvertise" name="Readvertise Position">
      <bpmn:incoming>SequenceFlow_NoCandidates</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AdvertiseAgain</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_ProcessComplete" name="Post Filled">
      <bpmn:incoming>SequenceFlow_ProcessComplete</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_Advertise" sourceRef="StartEvent_RequestReceived" targetRef="Task_AdvertisePosition"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ApplicationsReceived" name="" sourceRef="Task_AdvertisePosition" targetRef="Task_CheckApplications"/>

    <bpmn:sequenceFlow id="SequenceFlow_DecisionQualified" name="" sourceRef="Task_CheckApplications" targetRef="ExclusiveGateway_Qualified"/>

    <!-- Qualified Path -->
    <bpmn:sequenceFlow id="SequenceFlow_ContractProcess" name="Yes - Sufficient Candidates" sourceRef="ExclusiveGateway_Qualified" targetRef="Task_SelectCandidate"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_NegotiateContract" sourceRef="Task_SelectCandidate" targetRef="Task_NegotiateContract"/>

    <!-- Contract Conclusion -->
    <bpmn:sequenceFlow id="SequenceFlow_ConcludeContract" name="" sourceRef="Task_NegotiateContract" targetRef="Task_ConcludeContract"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ProcessComplete" sourceRef="Task_ConcludeContract" targetRef="EndEvent_ProcessComplete"/>

    <!-- No Candidates Path -->
    <bpmn:sequenceFlow id="SequenceFlow_NoCandidates" name="No - Insufficient Qualified" sourceRef="ExclusiveGateway_Qualified" targetRef="Task_Readvertise"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_AdvertiseAgain" sourceRef="Task_Readvertise" targetRef="StartEvent_RequestReceived">
      <!-- Loop back to start -->
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>