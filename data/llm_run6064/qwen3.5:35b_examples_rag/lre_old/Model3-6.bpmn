<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1"/>

  <bpmn:process id="Process_ClaimsHandling" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="StartClaimReceived" name="Claim Received">
      <bpmn:outgoing>SequenceFlow_CheckInsurance</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Check Insurance Status -->
    <bpmn:task id="Task_CheckInsurance" name="Check if claimant is insured">
      <bpmn:incoming>SequenceFlow_CheckInsurance</bpmn:incoming>
      <bpmn:outgoing>Gateway_IsInsured</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Is Insured? -->
    <bpmn:exclusiveGateway id="Gateway_IsInsured" name="Claimant insured?">
      <bpmn:incoming>SequenceFlow_CheckInsurance</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RejectPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_EvaluateSeverity</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Inform Rejection -->
    <bpmn:task id="Task_InformRejection" name="Inform claimant of rejection">
      <bpmn:incoming>SequenceFlow_RejectPath</bpmn:incoming>
      <bpmn:outgoing>EndRejectedClaim</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event for Rejected Claim -->
    <bpmn:endEvent id="EndRejectedClaim" name="Claim Rejected">
      <bpmn:incoming>SequenceFlow_RejectPath</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task: Evaluate Severity -->
    <bpmn:task id="Task_EvaluateSeverity" name="Evaluate claim severity">
      <bpmn:incoming>SequenceFlow_EvaluateSeverity</bpmn:incoming>
      <bpmn:outgoing>Gateway_FormsNeeded</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Forms Needed -->
    <bpmn:exclusiveGateway id="Gateway_FormsNeeded" name="Forms required?">
      <bpmn:incoming>SequenceFlow_EvaluateSeverity</bpmn:incoming>
      <bpmn:outgoing>Task_SendFormsPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CheckCompletenessDirectly</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Send Forms -->
    <bpmn:task id="Task_SendForms" name="Send forms to claimant">
      <bpmn:incoming>Task_SendFormsPath</bpmn:incoming>
      <bpmn:outgoing>CatchEvent_FormsReturned</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Catch Event: Forms Returned -->
    <bpmn:startEvent id="CatchEvent_FormsReturned" name="Forms returned">
      <bpmn:incoming>Task_SendFormsPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckCompleteness</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Check Completeness -->
    <bpmn:task id="Task_CheckCompleteness" name="Check forms for completeness">
      <bpmn:incoming>CatchEvent_FormsReturned</bpmn:incoming>
      <bpmn:outgoing>Gateway_CompleteDetails</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Complete Details? -->
    <bpmn:exclusiveGateway id="Gateway_CompleteDetails" name="All details provided?">
      <bpmn:incoming>SequenceFlow_CheckCompleteness</bpmn:incoming>
      <bpmn:outgoing>Task_InformUpdatePath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RegisterClaim</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Inform Update Required -->
    <bpmn:task id="Task_InformUpdate" name="Inform claimant to update forms">
      <bpmn:incoming>Task_InformUpdatePath</bpmn:incoming>
      <bpmn:outgoing>CatchEvent_FormsReturnedUpdated</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Catch Event: Updated Forms Returned -->
    <bpmn:startEvent id="CatchEvent_FormsReturnedUpdated" name="Updated forms returned">
      <bpmn:incoming>CatchEvent_FormsReturnedUpdated</bpmn:outgoing>SequenceFlow_CheckCompletenessAgain</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Check Completeness Again -->
    <bpmn:task id="Task_CheckCompletenessAgain" name="Check updated forms">
      <bpmn:incoming>CatchEvent_FormsReturnedUpdated</bpmn:incoming>
      <bpmn:outgoing>Gateway_CompleteDetails</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Register in Claims Management System -->
    <bpmn:task id="Task_RegisterClaim" name="Register claim in system">
      <bpmn:incoming>SequenceFlow_RegisterClaim</bpmn:incoming>
      <bpmn:outgoing>EndProcessCompleted</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndProcessCompleted" name="Claims Notification Process Completed">
      <bpmn:incoming>SequenceFlow_RegisterClaim</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckInsurance" sourceRef="StartClaimReceived" targetRef="Task_CheckInsurance"/>
    
    <bpmn:sequenceFlow id="Gateway_IsInsured" name="" sourceRef="Task_CheckInsurance" targetRef="Gateway_IsInsured"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_RejectPath" name="No" sourceRef="Gateway_IsInsured" targetRef="Task_InformRejection"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_EvaluateSeverity" name="Yes" sourceRef="Gateway_IsInsured" targetRef="Task_EvaluateSeverity"/>
    
    <bpmn:sequenceFlow id="Task_SendFormsPath" name="" sourceRef="Gateway_FormsNeeded" targetRef="Task_SendForms"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_CheckCompletenessDirectly" name="No forms needed" sourceRef="Gateway_FormsNeeded" targetRef="Task_CheckCompleteness"/>
    
    <bpmn:sequenceFlow id="CatchEvent_FormsReturned" name="" sourceRef="Task_SendForms" targetRef="CatchEvent_FormsReturned"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_CheckCompleteness" name="" sourceRef="CatchEvent_FormsReturned" targetRef="Task_CheckCompleteness"/>
    
    <bpmn:sequenceFlow id="Gateway_CompleteDetails" name="" sourceRef="Task_CheckCompleteness" targetRef="Gateway_CompleteDetails"/>
    
    <bpmn:sequenceFlow id="Task_InformUpdatePath" name="No" sourceRef="Gateway_CompleteDetails" targetRef="Task_InformUpdate"/>
    
    <bpmn:sequenceFlow id="CatchEvent_FormsReturnedUpdated" name="" sourceRef="Task_InformUpdate" targetRef="CatchEvent_FormsReturnedUpdated"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_CheckCompletenessAgain" name="" sourceRef="CatchEvent_FormsReturnedUpdated" targetRef="Task_CheckCompletenessAgain"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_RegisterClaim" name="Yes" sourceRef="Gateway_CompleteDetails" targetRef="Task_RegisterClaim"/>

  </bpmn:process>
</bpmn:definitions>