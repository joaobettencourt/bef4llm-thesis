<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Design Process" processRef="Process_1"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_SupportOffice" name="Support Office">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LocateDesigns</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Electrical" name="Electrical Design">
        <bpmn:flowNodeRef>Gateway_ParallelSplit_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EReviewDesigns</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ECreateUpdatePlan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Exclusive_TestE_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EReviewDesigns_Rework</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Physical" name="Physical Design">
        <bpmn:flowNodeRef>Gateway_ParallelSplit_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PReviewDesigns</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PCreateUpdatePlan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Exclusive_TestP_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PReviewDesigns_Rework</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    
    <!-- Start and Initial Task -->
    <bpmn:startEvent id="StartEvent_1" name="Process starts">
      <bpmn:outgoing>SequenceFlow_StartToLocate</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_LocateDesigns" name="Locate and distribute existing designs (electrical &amp; physical)">
      <bpmn:incoming>SequenceFlow_StartToLocate</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_LocateToParallelSplit</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Parallel Split for Electrical and Physical Design -->
    <bpmn:parallelGateway id="Gateway_ParallelSplit_1">
      <bpmn:incoming>SequenceFlow_LocateToParallelSplit</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SplitElectrical</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SplitPhysical</bpmn:outgoing>
    </bpmn:parallelGateway>
    
    <!-- Electrical Design Path -->
    <bpmn:sequenceFlow id="SequenceFlow_LocateToParallelSplit" sourceRef="Task_LocateDesigns" targetRef="Gateway_ParallelSplit_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_SplitElectrical" name="Start electrical design" sourceRef="Gateway_ParallelSplit_1" targetRef="Task_EReviewDesigns"/>
    
    <!-- Physical Design Path -->
    <bpmn:sequenceFlow id="SequenceFlow_SplitPhysical" name="Start physical design" sourceRef="Gateway_ParallelSplit_1" targetRef="Task_PReviewDesigns"/>
    
    <!-- Electrical Review and Update Plan Creation -->
    <bpmn:task id="Task_EReviewDesigns" name="Review existing designs">
      <bpmn:incoming>SequenceFlow_SplitElectrical</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EReviewToCreatePlan</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Physical Review and Update Plan Creation -->
    <bpmn:task id="Task_PReviewDesigns" name="Review existing designs">
      <bpmn:incoming>SequenceFlow_SplitPhysical</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PReviewToCreatePlan</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Create Update Plans -->
    <bpmn:sequenceFlow id="SequenceFlow_EReviewToCreatePlan" sourceRef="Task_EReviewDesigns" targetRef="Task_ECreateUpdatePlan"/>
    <bpmn:sequenceFlow id="SequenceFlow_PReviewToCreatePlan" sourceRef="Task_PReviewDesigns" targetRef="Task_PCreateUpdatePlan"/>
    
    <!-- Create Revised Designs -->
    <bpmn:task id="Task_ECreateUpdatePlan" name="Create Update Plan for electrical design">
      <bpmn:incoming>SequenceFlow_EReviewToCreatePlan</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ECReviewDesigns</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_PCreateUpdatePlan" name="Create Update Plan for physical design">
      <bpmn:incoming>SequenceFlow_PReviewToCreatePlan</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PCReviewDesigns</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Create Revised Designs -->
    <bpmn:sequenceFlow id="SequenceFlow_ECReviewDesigns" sourceRef="Task_ECreateUpdatePlan" targetRef="Gateway_Exclusive_TestE_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_PCReviewDesigns" sourceRef="Task_PCreateUpdatePlan" targetRef="Gateway_Exclusive_TestP_1"/>
    
    <!-- Test Revised Designs -->
    <bpmn:exclusiveGateway id="Gateway_Exclusive_TestE_1">
      <bpmn:incoming>SequenceFlow_ECReviewDesigns</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ETestPass</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ETestFail</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <bpmn:exclusiveGateway id="Gateway_Exclusive_TestP_1">
      <bpmn:incoming>SequenceFlow_PCReviewDesigns</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PTestPass</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PTestFail</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <!-- Test Pass - Notify Other Department -->
    <bpmn:sequenceFlow id="SequenceFlow_ETestPass" name="Design passes test" sourceRef="Gateway_Exclusive_TestE_1" targetRef="Task_PReviewDesigns_Rework"/>
    <bpmn:sequenceFlow id="SequenceFlow_PTestPass" name="Design passes test" sourceRef="Gateway_Exclusive_TestP_1" targetRef="Task_EReviewDesigns_Rework"/>
    
    <!-- Test Fail - Rework -->
    <bpmn:task id="Task_EReviewDesigns_Rework" name="Rework electrical design">
      <bpmn:incoming>SequenceFlow_PTestPass</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EReworkToParallelSplit</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_PReviewDesigns_Rework" name="Rework physical design">
      <bpmn:incoming>SequenceFlow_ETestPass</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PReworkToParallelSplit</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Rework Loops Back to Review -->
    <bpmn:sequenceFlow id="SequenceFlow_EReworkToParallelSplit" name="Restart design cycle" sourceRef="Task_EReviewDesigns_Rework" targetRef="Gateway_ParallelSplit_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_PReworkToParallelSplit" name="Restart design cycle" sourceRef="Task_PReviewDesigns_Rework" targetRef="Gateway_ParallelSplit_1"/>
    
    <!-- Test Fail Loops Back to Review -->
    <bpmn:exclusiveGateway id="Gateway_Exclusive_TestCombined">
      <bpmn:incoming>SequenceFlow_CombinedTest</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ComboPass</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ComboFail</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <!-- Combined Design Test -->
    <bpmn:task id="Task_CombinedDesign" name="Combine and test designs">
      <bpmn:incoming>SequenceFlow_ETestPass</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CombinedTest</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Combined Test Pass - Complete -->
    <bpmn:endEvent id="EndEvent_Complete" name="Designs complete">
      <bpmn:incoming>SequenceFlow_ComboPass</bpmn:incoming>
    </bpmn:endEvent>
    
    <!-- Sequence Flows for Combined Design Test -->
    <bpmn:sequenceFlow id="SequenceFlow_CombinedTest" sourceRef="Task_CombinedDesign" targetRef="Gateway_Exclusive_TestCombined"/>
    <bpmn:sequenceFlow id="SequenceFlow_ComboPass" name="Tests pass - Complete" sourceRef="Gateway_Exclusive_TestCombined" targetRef="EndEvent_Complete"/>
    
  </bpmn:process>
</bpmn:definitions>