<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_0a3f8y6" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1m9e7qz">
    <bpmn:participant id="Participant_0ygkg4f" name="Room Service Department" processRef="Process_5j3rnxv"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_5j3rnxv" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Manager" name="Room Service Manager">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TakeOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_WineDecision</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Kitchen" name="Kitchen">
        <bpmn:flowNodeRef>Task_PrepareFood</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Sommelier" name="Sommelier">
        <bpmn:flowNodeRef>Task_GetWine</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Waiter" name="Waiter">
        <bpmn:flowNodeRef>Gateway_ParallelSplit1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareCart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MergeBeforeDelivery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DeliverToRoom</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReturnAndDebit</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Guest Calls Room Service">
      <bpmn:outgoing>SequenceFlow_TakeOrder</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Manager Tasks -->
    <bpmn:task id="Task_TakeOrder" name="Take Down Order">
      <bpmn:incoming>SequenceFlow_TakeOrder</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SubmitOrders</bpmn:outgoing>
    </bpmn:task>

    <!-- Decision Point for Wine/Alcoholic Beverages (80% probability) -->
    <bpmn:exclusiveGateway id="Gateway_WineDecision" name="Wine Needed?">
      <bpmn:incoming>SequenceFlow_SubmitOrders</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToKitchen</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ToSommelier</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Kitchen Path -->
    <bpmn:task id="Task_PrepareFood" name="Prepare Food">
      <bpmn:incoming>SequenceFlow_ToKitchen</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FoodReady</bpmn:outgoing>
    </bpmn:task>

    <!-- Sommelier Path -->
    <bpmn:task id="Task_GetWine" name="Fetch Wine &amp; Alcoholic Beverages">
      <bpmn:incoming>SequenceFlow_ToSommelier</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WineReady</bpmn:outgoing>
    </bpmn:task>

    <!-- Waiter Path -->
    <bpmn:parallelGateway id="Gateway_ParallelSplit1" name="Start Concurrent Tasks">
      <bpmn:incoming>SequenceFlow_ToWaiter</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PrepareCart</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Waiter Cart Preparation -->
    <bpmn:task id="Task_PrepareCart" name="Ready Cart (Tablecloth &amp; Silverware)">
      <bpmn:incoming>SequenceFlow_PrepareCart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CartReady</bpmn:outgoing>
    </bpmn:task>

    <!-- Merge Point Before Delivery -->
    <bpmn:parallelGateway id="Gateway_MergeBeforeDelivery" name="All Ready?">
      <bpmn:incoming>SequenceFlow_FoodReady</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_WineReady</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_CartReady</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DeliverToRoom</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Delivery Task -->
    <bpmn:task id="Task_DeliverToRoom" name="Deliver to Guest's Room">
      <bpmn:incoming>SequenceFlow_DeliverToRoom</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReturnAndDebit</bpmn:outgoing>
    </bpmn:task>

    <!-- Billing Task -->
    <bpmn:task id="Task_ReturnAndDebit" name="Return &amp; Debit Guest Account">
      <bpmn:incoming>SequenceFlow_ReturnAndDebit</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProcessComplete</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_1" name="Order Processed">
      <bpmn:incoming>SequenceFlow_ProcessComplete</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows - Manager Path -->
    <bpmn:sequenceFlow id="SequenceFlow_TakeOrder" sourceRef="StartEvent_1" targetRef="Task_TakeOrder"/>
    <bpmn:sequenceFlow id="SequenceFlow_SubmitOrders" name="Submit Order Ticket" sourceRef="Task_TakeOrder" targetRef="Gateway_WineDecision"/>

    <!-- Wine Decision Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_ToKitchen" name="Always" sourceRef="Gateway_WineDecision" targetRef="Task_PrepareFood"/>
    <bpmn:sequenceFlow id="SequenceFlow_ToSommelier" name="Yes (80%)" sourceRef="Gateway_WineDecision" targetRef="Task_GetWine"/>

    <!-- Waiter Path -->
    <bpmn:sequenceFlow id="SequenceFlow_ToWaiter" name="Assign Order" sourceRef="Gateway_WineDecision" targetRef="Gateway_ParallelSplit1"/>

    <!-- Cart Preparation Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_PrepareCart" name="" sourceRef="Gateway_ParallelSplit1" targetRef="Task_PrepareCart"/>

    <!-- Convergence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_FoodReady" name="" sourceRef="Task_PrepareFood" targetRef="Gateway_MergeBeforeDelivery"/>
    <bpmn:sequenceFlow id="SequenceFlow_WineReady" name="" sourceRef="Task_GetWine" targetRef="Gateway_MergeBeforeDelivery"/>
    <bpmn:sequenceFlow id="SequenceFlow_CartReady" name="" sourceRef="Task_PrepareCart" targetRef="Gateway_MergeBeforeDelivery"/>

    <!-- Delivery and Billing Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_DeliverToRoom" name="" sourceRef="Gateway_MergeBeforeDelivery" targetRef="Task_DeliverToRoom"/>
    <bpmn:sequenceFlow id="SequenceFlow_ReturnAndDebit" name="" sourceRef="Task_DeliverToRoom" targetRef="Task_ReturnAndDebit"/>

    <!-- Complete Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_ProcessComplete" name="" sourceRef="Task_ReturnAndDebit" targetRef="EndEvent_1"/>

  </bpmn:process>
</bpmn:definitions>