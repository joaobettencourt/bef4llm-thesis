<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_3k8m9p7" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:message id="Message_ChangeNotification"/>

  <bpmn:collaboration id="Collaboration_6x2v8qz">
    <bpmn:participant id="Pool_EC" name="EC - Entity Client" processRef="Process_EC"/>
    <bpmn:participant id="Pool_INQ" name="INQ - Inquiry System" processRef="Process_INQ"/>
    <bpmn:participant id="Pool_IP" name="IP - Information Processing" processRef="Process_IP"/>

    <!-- Message Flow from EC to INQ -->
    <bpmn:messageFlow id="MessageFlow_EC_TO_INQ" sourceRef="IntermediateThrowEventEC_0k7m3p9" targetRef="StartCatchINQ_2h8r6t4">
      <bpmn:sourceRef>IntermediateThrowEventEC_0k7m3p9</bpmn:sourceRef>
      <bpmn:targetRef>StartCatchINQ_2h8r6t4</bpmn:targetRef>
    </bpmn:messageFlow>

    <!-- Message Flow from INQ to IP -->
    <bpmn:messageFlow id="MessageFlow_INQ_TO_IP" sourceRef="IntermediateThrowEventINQ_1w5j7k3" targetRef="StartCatchIP_0m6k9p2">
      <bpmn:sourceRef>IntermediateThrowEventINQ_1w5j7k3</bpmn:sourceRef>
      <bpmn:targetRef>StartCatchIP_0m6k9p2</bpmn:targetRef>
    </bpmn:messageFlow>

  </bpmn:collaboration>

  <!-- EC Process -->
  <bpmn:process id="Process_EC" isExecutable="false">
    <bpmn:startEvent id="StartEventEC_1" name="Change Master Data Requested">
      <bpmn:outgoing>SequenceFlowEC_0g6h8y4</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="TaskEC_SendNotification_2w5q7e1" name="Tell INQ about change">
      <bpmn:incoming>SequenceFlowEC_0g6h8y4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlowEC_3x9k4mz</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEventEC_ConfirmationReceived" name="Confirmation Received">
      <bpmn:incoming>SequenceFlowEC_5h7x9qj</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Intermediate Throw Event for Message to INQ -->
    <bpmn:intermediateThrowEvent id="IntermediateThrowEventEC_0k7m3p9" name="Notify Change">
      <bpmn:messageRef>Message_ChangeNotification</bpmn:messageRef>
      <bpmn:incoming>SequenceFlowEC_4z8w2kp</bpmn:incoming>
      <bpmn:outgoing>SequenceFlowEC_5h7x9qj</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <!-- Intermediate Catch Event for Response from IP -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEC_0p6k8m3" name="Receive Confirmation">
      <bpmn:messageRef>Message_ChangeNotification</bpmn:messageRef>
      <bpmn:incoming>SequenceFlowEC_5h7x9qj</bpmn:incoming>
    </bpmn:intermediateCatchEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlowEC_0g6h8y4" sourceRef="StartEventEC_1" targetRef="TaskEC_SendNotification_2w5q7e1"/>
    <bpmn:sequenceFlow id="SequenceFlowEC_3x9k4mz" name="" sourceRef="TaskEC_SendNotification_2w5q7e1" targetRef="IntermediateThrowEventEC_0k7m3p9"/>

  </bpmn:process>

  <!-- INQ Process -->
  <bpmn:process id="Process_INQ" isExecutable="false">
    <!-- Start Message Event for EC Notification -->
    <bpmn:startEvent id="StartCatchINQ_2h8r6t4" name="Receive Change Notification">
      <bpmn:messageRef>Message_ChangeNotification</bpmn:messageRef>
      <bpmn:outgoing>SequenceFlow_INQ_7y1f5nz</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task to Notify IP -->
    <bpmn:task id="TaskINQ_NotifyIP_4z0w3k8" name="Notify IP of change">
      <bpmn:incoming>SequenceFlow_INQ_7y1f5nz</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_INQ_9x2v8mk</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Throw Event for Message to IP -->
    <bpmn:intermediateThrowEvent id="IntermediateThrowINQ_1w5j7k3" name="Notify Change">
      <bpmn:messageRef>Message_ChangeNotification</bpmn:messageRef>
      <bpmn:incoming>SequenceFlow_INQ_9x2v8mk</bpmn:incoming>
    </bpmn:intermediateThrowEvent>

    <!-- End Event -->
    <bpmn:endEvent id="EndEventINQ_Processed" name="Process Completed">
      <bpmn:incoming>SequenceFlow_INQ_6m0w8p4</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_INQ_7y1f5nz" sourceRef="StartCatchINQ_2h8r6t4" targetRef="TaskINQ_NotifyIP_4z0w3k8"/>
    <bpmn:sequenceFlow id="SequenceFlow_INQ_9x2v8mk" name="" sourceRef="TaskINQ_NotifyIP_4z0w3k8" targetRef="IntermediateThrowINQ_1w5j7k3"/>

  </bpmn:process>

  <!-- IP Process -->
  <bpmn:process id="Process_IP" isExecutable="false">
    <!-- Start Message Event for INQ Notification -->
    <bpmn:startEvent id="StartCatchIP_0m6k9p2" name="Receive Change Notification">
      <bpmn:messageRef>Message_ChangeNotification</bpmn:messageRef>
      <bpmn:outgoing>SequenceFlow_IP_8w3k1j6</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task to Check if Change is Possible -->
    <bpmn:task id="TaskIP_CheckDecision_1w5j8kp" name="Check change possibility">
      <bpmn:incoming>SequenceFlow_IP_8w3k1j6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_IP_4x7v1tq</bpmn:outgoing>
    </bpmn:task>

    <!-- Decision Gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGatewayIP_3k8m6p9" name="Change Possible?">
      <bpmn:incoming>SequenceFlow_IP_4x7v1tq</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_IP_5h2w9kp</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_IP_6m0k8p3</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Confirm Task -->
    <bpmn:task id="TaskIP_Confirm_2w7j5kp" name="Confirm changes">
      <bpmn:incoming>SequenceFlow_IP_5h2w9kp</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_IP_8k3m6p4</bpmn:outgoing>
    </bpmn:task>

    <!-- Reject Task -->
    <bpmn:task id="TaskIP_Reject_1j5w7kp" name="Reject changes">
      <bpmn:incoming>SequenceFlow_IP_6m0k8p3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_IP_9x4v2tq</bpmn:outgoing>
    </bpmn:task>

    <!-- End Events -->
    <bpmn:endEvent id="EndEventIP_Confirmed" name="Changes Confirmed">
      <bpmn:incoming>SequenceFlow_IP_8k3m6p4</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEventIP_Rejected" name="Changes Rejected">
      <bpmn:incoming>SequenceFlow_IP_9x4v2tq</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_IP_8w3k1j6" sourceRef="StartCatchIP_0m6k9p2" targetRef="TaskIP_CheckDecision_1w5j8kp"/>
    <bpmn:sequenceFlow id="SequenceFlow_IP_4x7v1tq" name="" sourceRef="TaskIP_CheckDecision_1w5j8kp" targetRef="ExclusiveGatewayIP_3k8m6p9"/>

    <!-- Decision Outcomes -->
    <bpmn:sequenceFlow id="SequenceFlow_IP_5h2w9kp" name="Yes - Possible" sourceRef="ExclusiveGatewayIP_3k8m6p9" targetRef="TaskIP_Confirm_2w7j5kp"/>
    <bpmn:sequenceFlow id="SequenceFlow_IP_6m0k8p3" name="No - Not Possible" sourceRef="ExclusiveGatewayIP_3k8m6p9" targetRef="TaskIP_Reject_1j5w7kp"/>

  </bpmn:process>
</bpmn:definitions>