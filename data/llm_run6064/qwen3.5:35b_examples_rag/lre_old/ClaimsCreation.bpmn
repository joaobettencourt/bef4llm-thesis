<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1m9e7qz"/>

  <bpmn:process id="Process_5j3rnxv" isExecutable="false">
    <!-- Data Objects -->
    <bpmn:dataObject id="DataObject_PoliceReport" name="Police Report"/>
    <bpmn:dataObject id="DataObject_ClaimDocumentation" name="Claim Documentation"/>
    <bpmn:dataObject id="DataObject_CombinedFile" name="Combined File (Reports + Claims)"/>
    <bpmn:dataObject id="DataObject_ActionPlanChecklist" name="Action Plan Checklist"/>
    <bpmn:dataObject id="DataObject_InitialEstimate" name="Initial Claim Estimate"/>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:name>Accident Report Received</bpmn:name>
      <bpmn:outgoing>SequenceFlow_0g6h8y4</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Tasks -->
    <bpmn:task id="Task_SearchPoliceReport" name="Search Police Report Database">
      <bpmn:incoming>SequenceFlow_0g6h8y4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3x9k4mz</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_CombineDocuments" name="Create Combined File">
      <bpmn:incoming>SequenceFlow_3x9k4mz</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6r8v2kw</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_CalculateEstimate" name="Calculate Initial Claim Estimate">
      <bpmn:name>Claims Handler - Calculate Estimate</bpmn:name>
      <bpmn:incoming>SequenceFlow_6r8v2kw</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_7y1f5nz</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_CreateActionPlan" name="Create Action Plan">
      <bpmn:name>Claims Handler - Create Action Plan</bpmn:name>
      <bpmn:incoming>SequenceFlow_7y1f5nz</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_9x2v8mk</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_NegotiateSettlement" name="Negotiate Settlement">
      <bpmn:name>Claims Manager - Negotiate Settlement</bpmn:name>
      <bpmn:incoming>SequenceFlow_9x2v8mk</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5h7x9qj</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_1">
      <bpmn:name>Process Completed - Claimant Informed</bpmn:name>
      <bpmn:incoming>SequenceFlow_5h7x9qj</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_0g6h8y4" sourceRef="StartEvent_1" targetRef="Task_SearchPoliceReport"/>
    <bpmn:sequenceFlow id="SequenceFlow_3x9k4mz" sourceRef="Task_SearchPoliceReport" targetRef="Task_CombineDocuments"/>
    <bpmn:sequenceFlow id="SequenceFlow_6r8v2kw" sourceRef="Task_CombineDocuments" targetRef="Task_CalculateEstimate"/>
    <bpmn:sequenceFlow id="SequenceFlow_7y1f5nz" sourceRef="Task_CalculateEstimate" targetRef="Task_CreateActionPlan"/>
    <bpmn:sequenceFlow id="SequenceFlow_9x2v8mk" sourceRef="Task_CreateActionPlan" targetRef="Task_NegotiateSettlement"/>
    <bpmn:sequenceFlow id="SequenceFlow_5h7x9qj" sourceRef="Task_NegotiateSettlement" targetRef="EndEvent_1"/>

  </bpmn:process>
</bpmn:definitions>