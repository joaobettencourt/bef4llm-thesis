<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_3k8m9p7">
  <bpmn:collaboration id="Collaboration_6r4t8xq">
    <bpmn:participant id="Participant_2w5j9km" name="Loan Approval Process" processRef="Process_1"/>
    <bpmn:messageFlow id="MessageFlow_0k7m3p9" sourceRef="EndEvent_4h8v6xq" targetRef="StartEvent_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <!-- Start Event - Customer Loan Request -->
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:name>Customer loan request</bpmn:name>
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_0m9k4xq</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Risk Assessment Web Service -->
    <bpmn:serviceTask id="ServiceTask_1w7j5km" name="Risk assessment web service">
      <bpmn:name>Risk assessment web service</bpmn:name>
      <bpmn:incoming>SequenceFlow_0m9k4xq</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3p8v6tq</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Decision Gateway - Loan Amount Check -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_1k9m4xq" name="Loan amount &gt;= $10,000?">
      <bpmn:name>Loan amount &gt;= $10,000?</bpmn:name>
      <bpmn:incoming>SequenceFlow_3p8v6tq</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5j7w9kx</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_2m4k8xp</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Decision Gateway - Risk Level Check -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_1p7j5km" name="Customer risk level?">
      <bpmn:name>Customer risk level?</bpmn:name>
      <bpmn:incoming>SequenceFlow_2m4k8xp</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6w9t3xq</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_1j5p7km</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Approval Web Service -->
    <bpmn:serviceTask id="ServiceTask_2w9k4xp" name="Approver web service">
      <bpmn:name>Approver web service</bpmn:name>
      <bpmn:incoming>SequenceFlow_5j7w9kx</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_8m3p6tq</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Decision Gateway - Approval Result -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_1w5j9km" name="Approval result?">
      <bpmn:name>Approval result?</bpmn:name>
      <bpmn:incoming>SequenceFlow_8m3p6tq</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4k7w9xp</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_0j5p2km</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Loan Approved Task -->
    <bpmn:task id="Task_1m9k4xp" name="Loan approved">
      <bpmn:name>Loan approved</bpmn:name>
      <bpmn:incoming>SequenceFlow_6w9t3xq</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_7p8j5km</bpmn:outgoing>
    </bpmn:task>

    <!-- Loan Denied Task -->
    <bpmn:task id="Task_2w9k4xq" name="Loan denied">
      <bpmn:name>Loan denied</bpmn:name>
      <bpmn:incoming>SequenceFlow_1j5p7km</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3m8k6tq</bpmn:outgoing>
    </bpmn:task>

    <!-- Approval Accepted Task -->
    <bpmn:task id="Task_1w5j9xq" name="Approval accepted">
      <bpmn:name>Approval accepted</bpmn:name>
      <bpmn:incoming>SequenceFlow_4k7w9xp</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6p8j5xq</bpmn:outgoing>
    </bpmn:task>

    <!-- Approval Rejected Task -->
    <bpmn:task id="Task_2w9k4xm" name="Approval rejected">
      <bpmn:name>Approval rejected</bpmn:name>
      <bpmn:incoming>SequenceFlow_0j5p2km</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_8m3k6xq</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event - Loan Approved -->
    <bpmn:endEvent id="EndEvent_1w5j9xm">
      <bpmn:name>Loan approved feedback</bpmn:name>
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SequenceFlow_7p8j5km</bpmn:incoming>
    </bpmn:endEvent>

    <!-- End Event - Loan Denied -->
    <bpmn:endEvent id="EndEvent_2w9k4xm">
      <bpmn:name>Loan denied feedback</bpmn:name>
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SequenceFlow_3m8k6tq</bpmn:incoming>
    </bpmn:endEvent>

    <!-- End Event - Approval Accepted -->
    <bpmn:endEvent id="EndEvent_1w5j9xq">
      <bpmn:name>Approval accepted feedback</bpmn:name>
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SequenceFlow_6p8j5xq</bpmn:incoming>
    </bpmn:endEvent>

    <!-- End Event - Approval Rejected -->
    <bpmn:endEvent id="EndEvent_2w9k4xm">
      <bpmn:name>Approval rejected feedback</bpmn:name>
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SequenceFlow_8m3k6xq</bpmn:incoming>
    </bpmn:endEvent>

    <!-- End Event - Final -->
    <bpmn:endEvent id="EndEvent_4h8v6xq">
      <bpmn:name>Process completed</bpmn:name>
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SequenceFlow_9k7m3xp</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_0m9k4xq" name="" sourceRef="StartEvent_1" targetRef="ServiceTask_1w7j5km"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_3p8v6tq" name="" sourceRef="ServiceTask_1w7j5km" targetRef="ExclusiveGateway_1k9m4xq"/>

    <!-- Loan amount >= $10,000 path -->
    <bpmn:sequenceFlow id="SequenceFlow_5j7w9kx" name="$10,000 or more / needs review" sourceRef="ExclusiveGateway_1k9m4xq" targetRef="ServiceTask_2w9k4xp"/>

    <!-- Loan amount < $10,000 path - check risk level -->
    <bpmn:sequenceFlow id="SequenceFlow_2m4k8xp" name="< $10,000 and no further review needed" sourceRef="ExclusiveGateway_1k9m4xq" targetRef="ExclusiveGateway_1p7j5km"/>

    <!-- Low risk path -->
    <bpmn:sequenceFlow id="SequenceFlow_6w9t3xq" name="Low risk - approve" sourceRef="ExclusiveGateway_1p7j5km" targetRef="Task_1m9k4xp"/>

    <!-- High risk path -->
    <bpmn:sequenceFlow id="SequenceFlow_1j5p7km" name="High risk - deny" sourceRef="ExclusiveGateway_1p7j5km" targetRef="Task_2w9k4xq"/>

    <!-- Approval accepted result -->
    <bpmn:sequenceFlow id="SequenceFlow_4k7w9xp" name="Approved by approver" sourceRef="ExclusiveGateway_1w5j9km" targetRef="Task_1w5j9xq"/>

    <!-- Approval rejected result -->
    <bpmn:sequenceFlow id="SequenceFlow_0j5p2km" name="Rejected by approver" sourceRef="ExclusiveGateway_1w5j9km" targetRef="Task_2w9k4xm"/>

    <!-- Feedback flows to end events -->
    <bpmn:sequenceFlow id="SequenceFlow_7p8j5km" name="" sourceRef="Task_1m9k4xp" targetRef="EndEvent_1w5j9xm"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_3m8k6tq" name="" sourceRef="Task_2w9k4xq" targetRef="EndEvent_2w9k4xm"/>

    <bpmn:sequenceFlow id="SequenceFlow_6p8j5xq" name="" sourceRef="Task_1w5j9xq" targetRef="EndEvent_1w5j9xq"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_8m3k6xq" name="" sourceRef="Task_2w9k4xm" targetRef="EndEvent_2w9k4xm"/>

  </bpmn:process>
</bpmn:definitions>