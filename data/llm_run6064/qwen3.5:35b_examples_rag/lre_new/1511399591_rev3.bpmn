<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions id="Definitions_0a9j6w5v4h3k2l7x" targetNamespace="http://bpmn.io/schema/bpmn" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <bpmn:collaboration id="Collab_0v7x8w9z6q1p0r4m">
    <bpmn:participant name="Web Development Process" processRef="Process_0c5t3y2l8k6j4h9f">
      <bpmn:laneSet>
        <bpmn:lane id="Lane_BusinessAnalyst">
          <bpmn:flowNodeRef>Task_CollectData</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Gateway_DesignOK</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>StartEvent_0k2m3r7z9q1x5p4w8l6y</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_WebDesigner">
          <bpmn:flowNodeRef>Task_IntegrateDesign</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Gateway_DesignAdjustment</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Task_AdjustDesign</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_PHPHTMLCSS">
          <bpmn:flowNodeRef>Task_IntegrateImplementation</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Gateway_TestOK</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Task_AdjustBasedOnTest</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_Tester">
          <bpmn:flowNodeRef>Task_TestWebsite</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
    </bpmn:participant>
  </bpmn:collaboration>

  <bpmn:process id="Process_0c5t3y2l8k6j4h9f" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent name="Start Process" id="StartEvent_0k2m3r7z9q1x5p4w8l6y">
      <bpmn:outgoing>SequenceFlow_StartToCollectData</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Business Analyst Tasks -->
    <bpmn:task id="Task_CollectData" name="Collect Data &amp; Conduct Analysis">
      <bpmn:incoming>SequenceFlow_StartToCollectData</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AnalysisToIntegrateDesign</bpmn:outgoing>
    </bpmn:task>

    <!-- Web Designer Tasks -->
    <bpmn:task id="Task_IntegrateDesign" name="Integrate Design &amp; Decide Placement">
      <bpmn:incoming>SequenceFlow_AnalysisToIntegrateDesign</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DesignToCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Business Analyst Design Check -->
    <bpmn:exclusiveGateway id="Gateway_DesignOK" name="Design OK?">
      <bpmn:incoming>SequenceFlow_AnalysisToIntegrateDesign</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DesignAdjustment</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_IntegrationOK</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Web Designer Adjustment Loop -->
    <bpmn:task id="Task_AdjustDesign" name="Adjust Design">
      <bpmn:incoming>SequenceFlow_DesignAdjustment</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AdjustToIntegrateAgain</bpmn:outgoing>
    </bpmn:task>

    <!-- PHP/HTML/CSS Specialist Tasks -->
    <bpmn:task id="Task_IntegrateImplementation" name="Integrate with Overall Implementation">
      <bpmn:incoming>SequenceFlow_DesignToCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ImplementationToTest</bpmn:outgoing>
    </bpmn:task>

    <!-- Tester Task -->
    <bpmn:task id="Task_TestWebsite" name="Test Final Website">
      <bpmn:incoming>SequenceFlow_IntegrationOK</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TestToGateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Test Result Gateway -->
    <bpmn:exclusiveGateway id="Gateway_TestOK" name="Test OK?">
      <bpmn:incoming>SequenceFlow_ImplementationToTest</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProcessEnd</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_AdjustBasedOnTest</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- PHP/HTML/CSS Adjustment Loop -->
    <bpmn:task id="Task_AdjustBasedOnTest" name="Adjust Based on Test Results">
      <bpmn:incoming>SequenceFlow_TestToGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AdjustToReintegrate</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent name="Process Completed" id="EndEvent_ProcessCompleted">
      <bpmn:incoming>SequenceFlow_ProcessEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToCollectData" sourceRef="StartEvent_0k2m3r7z9q1x5p4w8l6y" targetRef="Task_CollectData" />
    <bpmn:sequenceFlow id="SequenceFlow_AnalysisToIntegrateDesign" name="Analysis Complete" sourceRef="Task_CollectData" targetRef="Gateway_DesignOK" />
    <bpmn:sequenceFlow id="SequenceFlow_DesignToCheck" name="Ready for Check" sourceRef="Task_IntegrateDesign" targetRef="Gateway_DesignOK" />
    <bpmn:sequenceFlow id="SequenceFlow_DesignAdjustment" name="No - Needs Adjustment" sourceRef="Gateway_DesignOK" targetRef="Task_AdjustDesign">
      <bpmn:name>No</bpmn:name>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_IntegrationOK" name="Yes - OK for Integration" sourceRef="Gateway_DesignOK" targetRef="Task_TestWebsite">
      <bpmn:name>Yes</bpmn:name>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_AdjustToIntegrateAgain" name="Adjustment Complete" sourceRef="Task_AdjustDesign" targetRef="Gateway_DesignOK" />
    <bpmn:sequenceFlow id="SequenceFlow_ImplementationToTest" name="Integration Ready for Test" sourceRef="Task_IntegrateImplementation" targetRef="Gateway_TestOK" />
    <bpmn:sequenceFlow id="SequenceFlow_ProcessEnd" name="Yes - OK to End" sourceRef="Gateway_TestOK" targetRef="EndEvent_ProcessCompleted">
      <bpmn:name>Yes</bpmn:name>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_AdjustBasedOnTest" name="No - Needs Adjustment" sourceRef="Gateway_TestOK" targetRef="Task_AdjustBasedOnTest">
      <bpmn:name>No</bpmn:name>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_AdjustToReintegrate" name="Adjustment Complete - Re-integrate" sourceRef="Task_AdjustBasedOnTest" targetRef="Gateway_TestOK" />

  </bpmn:process>
</bpmn:definitions>