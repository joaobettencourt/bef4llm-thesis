<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions id="Definitions_2k9m3r7z6q4x5p8w" targetNamespace="http://bpmn.io/schema/bpmn" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <bpmn:collaboration id="Collab_7x8w9z6q1p0r4m">
    <bpmn:participant name="Provision Team Process" processRef="Process_5c3t2y1l8k6j4h9f">
      <bpmn:laneSet>
        <bpmn:lane id="Lane_ProvisionTeam">
          <bpmn:flowNodeRef>Task_IdentifyParts</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Gateway_QuestionsAboutRequest</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Gateway_PartsAvailable</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Task_SupplyPartsToCustomer</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Task_RecordPetition</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Task_OrderDaisuki</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Task_ContactCustomerWhenCollected</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
    </bpmn:participant>
  </bpmn:collaboration>

  <bpmn:process id="Process_5c3t2y1l8k6j4h9f" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent name="Customer Request Received" id="StartEvent_CustomerRequestReceived">
      <bpmn:outgoing>SequenceFlow_IdentifyParts</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Identify Necessary Parts -->
    <bpmn:task id="Task_IdentifyParts" name="Identify Necessary Parts">
      <bpmn:incoming>SequenceFlow_IdentifyParts</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_QuestionsAboutRequest_Incoming</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Questions About Request? -->
    <bpmn:exclusiveGateway id="Gateway_QuestionsAboutRequest" name="Questions&#10;about request?">
      <bpmn:incoming>SequenceFlow_IdentifyParts</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AskMoreInfo</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoQuestionsNeeded</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Ask for More Information -->
    <bpmn:task id="Task_ContactCustomerForMoreInfo" name="Ask Customer&#10;for more information">
      <bpmn:incoming>SequenceFlow_AskMoreInfo</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReturnToIdentifyParts</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: All Parts Available? -->
    <bpmn:exclusiveGateway id="Gateway_PartsAvailable" name="All parts&#10;available?">
      <bpmn:incoming>SequenceFlow_NoQuestionsNeeded</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Yes_GoToSupply</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_No_GoToOrder</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Supply Parts to Customer -->
    <bpmn:task id="Task_SupplyPartsToCustomer" name="Supply parts&#10;to customer">
      <bpmn:incoming>SequenceFlow_Yes_GoToSupply</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CustomerCollectsItems</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Record Petition -->
    <bpmn:task id="Task_RecordPetition" name="Record petition">
      <bpmn:incoming>SequenceFlow_No_GoToOrder</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MakeOrderToDaisuki</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Order to Daisuki -->
    <bpmn:task id="Task_OrderDaisuki" name="Make order&#10;to Daisuki">
      <bpmn:incoming>SequenceFlow_MakeOrderToDaisuki</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitForCollection</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Contact Customer When Collected -->
    <bpmn:task id="Task_ContactCustomerWhenCollected" name="Contact customer&#10;when parts collected">
      <bpmn:incoming>SequenceFlow_WaitForCollection</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CustomerRecollectsItems</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Event: Items Collected by Customer -->
    <bpmn:intermediateCatchEvent id="IntermediateEvent_ItemsCollected" name="Items recollected&#10;by customer">
      <bpmn:incoming>SequenceFlow_CustomerCollectsItems</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FinalPaymentReceived_Incoming</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task: Receive Final Payment -->
    <bpmn:task id="Task_ReceiveFinalPayment" name="Receive final&#10;payment">
      <bpmn:incoming>SequenceFlow_FinalPaymentReceived_Incoming</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProcessComplete</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent name="Process Complete" id="EndEvent_ProcessComplete">
      <bpmn:incoming>SequenceFlow_ProcessComplete</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>