<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions id="Definitions_3b4c5d6e7f8g9h0i" targetNamespace="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <bpmn:collaboration id="Collab_InvProc_Collab">
    <bpmn:participant name="SSP Invoice Processing" processRef="Process_InvProc_Main" />
  </bpmn:collaboration>

  <bpmn:process id="Process_InvProc_Main" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_MC_Office" name="Mail Centre Office">
        <bpmn:flowNodeRef>StartEvent_InvReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CategorizeInvoice</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AdminDept" name="Administration Department">
        <bpmn:flowNodeRef>Task_ProcessInvoiceComplex</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PutInCollectionBox</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_DE_Office" name="Data Entry Office">
        <bpmn:flowNodeRef>StartEvent_Daily10am</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterSAPSystemComplex</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Val_Office" name="Validation Office">
        <bpmn:flowNodeRef>StartEvent_HourlyReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ValidateInvoiceComplex</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Pay_Office" name="Payment Office">
        <bpmn:flowNodeRef>StartEvent_StartOfWeek</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExecutePaymentComplex</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Registry_Office" name="Registry Office">
        <bpmn:flowNodeRef>Task_ArchiveInvoices</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ProcessComplete</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_InvReceived" name="Invoice Received from Client">
      <bpmn:outgoing>SequenceFlow_MC_Categorize</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Mail Centre Tasks -->
    <bpmn:task id="Task_CategorizeInvoice" name="Categorize Invoice by Staff Member">
      <bpmn:incoming>SequenceFlow_MC_Categorize</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Admin_Forward</bpmn:outgoing>
    </bpmn:task>

    <!-- Administration Department Tasks -->
    <bpmn:task id="Task_ProcessInvoiceComplex" name="Process Invoice (Complex Process)">
      <bpmn:incoming>SequenceFlow_Admin_Forward</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CollectionBox</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_PutInCollectionBox" name="Put Invoices in Collection Box">
      <bpmn:incoming>SequenceFlow_CollectionBox</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DEO_TakeForSAP</bpmn:outgoing>
    </bpmn:task>

    <!-- Data Entry Office Tasks -->
    <bpmn:startEvent id="StartEvent_Daily10am" name="Daily 10 AM Timer">
      <bpmn:timerEventDefinition />
      <bpmn:outgoing>SequenceFlow_DEO_EnterSAP</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_EnterSAPSystemComplex" name="Enter Data in SAP System (Complex Process)">
      <bpmn:incoming>SequenceFlow_DEO_EnterSAP</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MC_ReviewForValidation</bpmn:outgoing>
    </bpmn:task>

    <!-- Validation Office Tasks -->
    <bpmn:startEvent id="StartEvent_HourlyReview" name="Hourly Review Timer">
      <bpmn:timerEventDefinition />
      <bpmn:outgoing>SequenceFlow_Val_ProcessValidated</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_ValidateInvoiceComplex" name="Validate Invoice (Big Process)">
      <bpmn:incoming>SequenceFlow_MC_ReviewForValidation</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_Val_ProcessValidated</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Pay_OfficePayment</bpmn:outgoing>
    </bpmn:task>

    <!-- Payment Office Tasks -->
    <bpmn:startEvent id="StartEvent_StartOfWeek" name="Start of Week Timer">
      <bpmn:timerEventDefinition />
      <bpmn:outgoing>SequenceFlow_Pay_ExecutePayment</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_ExecutePaymentComplex" name="Execute Payment (Big Process)">
      <bpmn:incoming>SequenceFlow_Pay_OfficePayment</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Registry_Archive</bpmn:outgoing>
    </bpmn:task>

    <!-- Registry Office Tasks -->
    <bpmn:endEvent id="EndEvent_ProcessComplete" name="Process Complete">
      <bpmn:incoming>SequenceFlow_FinalArchive</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_MC_Categorize" sourceRef="StartEvent_InvReceived" targetRef="Task_CategorizeInvoice" />
    
    <bpmn:exclusiveGateway id="Gateway_ForwardToAdmin">
      <bpmn:incoming>SequenceFlow_Admin_Forward</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MC_ReviewForValidation</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="SequenceFlow_Admin_Forward" sourceRef="Task_CategorizeInvoice" targetRef="Task_ProcessInvoiceComplex" />
    
    <bpmn:sequenceFlow id="SequenceFlow_CollectionBox" sourceRef="Task_ProcessInvoiceComplex" targetRef="Task_PutInCollectionBox" />
    
    <bpmn:sequenceFlow id="SequenceFlow_DEO_TakeForSAP" sourceRef="Task_PutInCollectionBox" targetRef="StartEvent_Daily10am" />
    
    <bpmn:sequenceFlow id="SequenceFlow_MC_ReviewForValidation" name="Forward for Validation">
      <bpmn:sourceRef>Gateway_ForwardToAdmin</bpmn:sourceRef>
      <bpmn:targetRef>Task_ValidateInvoiceComplex</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_Val_ProcessValidated" sourceRef="StartEvent_HourlyReview" targetRef="Task_ValidateInvoiceComplex" />
    
    <bpmn:sequenceFlow id="SequenceFlow_Pay_OfficePayment" name="Execute Payment">
      <bpmn:sourceRef>Gateway_ForwardToAdmin</bpmn:sourceRef>
      <bpmn:targetRef>StartEvent_StartOfWeek</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_Pay_ExecutePayment" sourceRef="StartEvent_StartOfWeek" targetRef="Task_ExecutePaymentComplex" />

    <bpmn:sequenceFlow id="SequenceFlow_Registry_Archive" sourceRef="Task_ExecutePaymentComplex" targetRef="Task_ArchiveInvoices" />
    
    <bpmn:task id="Task_ArchiveInvoices" name="Archive All Invoices">
      <bpmn:incoming>SequenceFlow_Registry_Archive</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FinalArchive</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_FinalArchive" sourceRef="Task_ArchiveInvoices" targetRef="EndEvent_ProcessComplete" />
  </bpmn:process>
</bpmn:definitions>