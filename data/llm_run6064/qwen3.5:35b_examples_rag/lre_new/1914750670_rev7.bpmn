<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_AccountCreation">
    <bpmn:participant id="Participant_BankAccountProcess" name="Bank Account Creation Process&#10;" processRef="Process_1"/>
    
    <!-- Message Definitions -->
    <bpmn:message id="Message_AccountRequestDocuments" name="Account Request Documents"/>
    <bpmn:message id="Message_AcceptedDocs" name="Accepted Account Documents"/>
    <bpmn:message id="Message_RejectionLetter" name="Rejection Letter"/>
    
    <!-- Message Flows -->
    <bpmn:messageFlow id="MessageFlow_CustomerToBank" sourceRef="ThrowEvent_SentToBank" targetRef="CatchEvent_RequestReceived">
      <bpmn:sourceElement>Participant_BankAccountProcess</bpmn:sourceElement>
      <bpmn:targetElement>Participant_BankAccountProcess</bpmn:targetElement>
    </bpmn:messageFlow>
    
    <bpmn:messageFlow id="MessageFlow_AcceptedToCustomer" sourceRef="Task_SendDocumentsAccepted" targetRef="CatchEvent_CustomerReceiveDocs">
      <bpmn:sourceElement>Participant_BankAccountProcess</bpmn:sourceElement>
      <bpmn:targetElement>Participant_BankAccountProcess</bpmn:targetElement>
    </bpmn:messageFlow>
    
    <bpmn:messageFlow id="MessageFlow_RejectedToCustomer" sourceRef="Task_SendLetterRejected" targetRef="CatchEvent_CustomerReceiveRejection">
      <bpmn:sourceElement>Participant_BankAccountProcess</bpmn:sourceElement>
      <bpmn:targetElement>Participant_BankAccountProcess</bpmn:targetElement>
    </bpmn:messageFlow>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Customer" name="Bank Customer&#10;">
        <bpmn:flowNodeRef>StartEvent_AccountRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VisitWebsite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FillPersonalData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GeneratePDF</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrintDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VisitPostOffice</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_BankOfficer" name="Bank Officer&#10;">
        <bpmn:flowNodeRef>CatchEvent_RequestReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckCustomerData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DecisionAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendDocumentsAccepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendLetterRejected</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_PostOffice" name="Post Office&#10;">
        <bpmn:flowNodeRef>CatchEvent_IdentityCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PostOfficerChecks</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_CustomerEnd" name="Customer End&#10;">
        <bpmn:flowNodeRef>CatchEvent_CustomerReceiveDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CatchEvent_CustomerReceiveRejection</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_BankEnd" name="Bank End&#10;">
        <bpmn:flowNodeRef>EndEvent_AccountCreated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_RequestRejected</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Customer Side -->
    <bpmn:startEvent id="StartEvent_AccountRequest" name="Account Request Started&#10;">
      <bpmn:outgoing>SequenceFlow_VisitWebsite</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_VisitWebsite" name="Visit Bank Website">
      <bpmn:incoming>SequenceFlow_VisitWebsite</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FillData</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_FillPersonalData" name="Fill Personal Data">
      <bpmn:incoming>SequenceFlow_FillData</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GeneratePDF</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_GeneratePDF" name="Generate PDF Document">
      <bpmn:incoming>SequenceFlow_GeneratePDF</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PrintDocuments</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_PrintDocuments" name="Print Documents">
      <bpmn:incoming>SequenceFlow_PrintDocuments</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_VisitPostOffice</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_VisitPostOffice" name="Visit Post Office">
      <bpmn:incoming>SequenceFlow_VisitPostOffice</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendToBank</bpmn:outgoing>
    </bpmn:task>

    <!-- Message to Bank -->
    <bpmn:intermediateThrowEvent id="ThrowEvent_SentToBank" name="Send Account Request&#10;to Post Office">
      <bpmn:incoming>SequenceFlow_SendToBank</bpmn:incoming>
      <bpmn:messageEventDefinition messageRef="Message_AccountRequestDocuments"/>
    </bpmn:intermediateThrowEvent>

    <!-- Bank Side -->
    <bpmn:intermediateCatchEvent id="CatchEvent_RequestReceived" name="Receive Account Request">
      <bpmn:incoming>SequenceFlow_FromPostOffice</bpmn:incoming>
      <bpmn:messageEventDefinition messageRef="Message_AccountRequestDocuments"/>
      <bpmn:outgoing>SequenceFlow_CheckDataStart</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Post Office Processing -->
    <bpmn:task id="Task_PostOfficerChecks" name="Post Officer Checks Identity">
      <bpmn:incoming>SequenceFlow_FromCustomerToBank</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToBankReceivesRequest</bpmn:outgoing>
    </bpmn:task>

    <!-- Bank Decision -->
    <bpmn:exclusiveGateway id="Gateway_DecisionAccount" name="Accept Request?">
      <bpmn:incoming>SequenceFlow_CheckDataComplete</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AcceptRequest</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RejectRequest</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Bank Tasks -->
    <bpmn:task id="Task_CheckCustomerData" name="Check Customer Data">
      <bpmn:incoming>SequenceFlow_CheckDataStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckDataComplete</bpmn:outgoing>
    </bpmn:task>

    <!-- Acceptance Path -->
    <bpmn:intermediateCatchEvent id="CatchEvent_CustomerReceiveDocs" name="Customer Receives Docs">
      <bpmn:messageEventDefinition messageRef="Message_AcceptedDocs"/>
    </bpmn:intermediateCatchEvent>

    <!-- Rejection Path -->
    <bpmn:intermediateCatchEvent id="CatchEvent_CustomerReceiveRejection" name="Customer Receives Refusal">
      <bpmn:messageEventDefinition messageRef="Message_RejectionLetter"/>
    </bpmn:intermediateCatchEvent>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_AccountCreated" name="Account Created">
      <bpmn:incoming>SequenceFlow_AcceptedComplete</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_RequestRejected" name="Request Rejected">
      <bpmn:incoming>SequenceFlow_RejectComplete</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_VisitWebsite" sourceRef="StartEvent_AccountRequest" targetRef="Task_VisitWebsite"/>
    <bpmn:sequenceFlow id="SequenceFlow_FillData" sourceRef="Task_VisitWebsite" targetRef="Task_FillPersonalData"/>
    <bpmn:sequenceFlow id="SequenceFlow_GeneratePDF" sourceRef="Task_FillPersonalData" targetRef="Task_GeneratePDF"/>
    <bpmn:sequenceFlow id="SequenceFlow_PrintDocuments" sourceRef="Task_GeneratePDF" targetRef="Task_PrintDocuments"/>
    <bpmn:sequenceFlow id="SequenceFlow_VisitPostOffice" sourceRef="Task_PrintDocuments" targetRef="Task_VisitPostOffice"/>
    <bpmn:sequenceFlow id="SequenceFlow_SendToBank" sourceRef="Task_VisitPostOffice" targetRef="ThrowEvent_SentToBank"/>

    <!-- Decision Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_AcceptRequest" name="Accept">
      <bpmn:sourceRef>Gateway_DecisionAccount</bpmn:sourceRef>
      <bpmn:targetRef>Task_SendDocumentsAccepted</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_RejectRequest" name="Reject">
      <bpmn:sourceRef>Gateway_DecisionAccount</bpmn:sourceRef>
      <bpmn:targetRef>Task_SendLetterRejected</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Data Check Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckDataComplete" sourceRef="Task_CheckCustomerData" targetRef="Gateway_DecisionAccount"/>
    
    <!-- Post Office to Bank Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_FromPostOffice" name="" sourceRef="CatchEvent_RequestReceived" targetRef="Task_PostOfficerChecks">
      <bpmn:message>Message_AccountRequestDocuments</bpmn:message>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>