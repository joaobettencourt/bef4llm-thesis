<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions id="Definitions_0a9j6w5v4h3k2l7x" targetNamespace="http://bpmn.io/schema/bpmn" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC">
  <bpmn:collaboration id="Collab_0v7x8w9z6q1p0r4m">
    <bpmn:participant name="CVS Bag Resolution Process" processRef="Process_0c5t3y2l8k6j4h9f" />
  </bpmn:collaboration>

  <bpmn:process id="Process_0c5t3y2l8k6j4h9f" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_CVSDept" name="CVS Department">
        <bpmn:flowNodeRef>StartEvent_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_7</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_0" name="Uncollected Bag Identified">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Check Retries -->
    <bpmn:task id="Task_1" name="Check Number of Resolution Retries">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Threshold Check -->
    <bpmn:exclusiveGateway id="Gateway_2" name="Retries &gt; Threshold?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 2: Contact Customer -->
    <bpmn:task id="Task_3" name="Contact Customer by Phone">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2: Response Check -->
    <bpmn:exclusiveGateway id="Gateway_4" name="Customer Response?">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 3: Increase Retry Count -->
    <bpmn:task id="Task_5" name="Increase Retry Count on Bag Label">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 1: Disassemble -->
    <bpmn:endEvent id="EndEvent_6" name="Bag Returned for Disassemble">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>

    <!-- End Event 2: Updated -->
    <bpmn:endEvent id="EndEvent_7" name="Retry Count Updated">
      <bpmn:incoming>Flow_8</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_0" targetRef="Task_1">
      <bpmn:name>Identified</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_1" targetRef="Gateway_2" />

    <bpmn:sequenceFlow id="Flow_3" name="Yes - Exceeds Threshold" sourceRef="Gateway_2" targetRef="EndEvent_6">
      <bpmn:name>Return to Production</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_4" name="No - Contact Customer" sourceRef="Gateway_2" targetRef="Task_3">
      <bpmn:name>Contact by Phone</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_3" targetRef="Gateway_4" />

    <bpmn:sequenceFlow id="Flow_6" name="Withdraws Order" sourceRef="Gateway_4" targetRef="EndEvent_6">
      <bpmn:name>Return to Production</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_7" name="Promises Pickup / Unsuccessful Contact" sourceRef="Gateway_4" targetRef="Task_5">
      <bpmn:name>Increase Retry Count</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_5" targetRef="EndEvent_7" />

  </bpmn:process>
</bpmn:definitions>