<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions id="Definitions_0a9j6w5v4h3k2l7x" targetNamespace="http://bpmn.io/schema/bpmn" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <bpmn:collaboration id="Collab_0v7x8w9z6q1p0r4m">
    <bpmn:participant name="Order to Cash Process" processRef="Process_0c5t3y2l8k6j4h9f">
      <bpmn:laneSet>
        <bpmn:lane id="Lane_SalesDept">
          <bpmn:flowNodeRef>StartEvent_OrderReceived</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Task_ProcessOrder</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Gateway_PartsAvailable_01</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>EndEvent_OrderCompleted</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_Warehouse">
          <bpmn:flowNodeRef>Task_DeterminePartsRequired</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Gateway_PartsAvailable_01</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Task_OrderMissingParts</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_Production">
          <bpmn:flowNodeRef>Task_StartProduction</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Task_PerformQualityChecks</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Gateway_QualityPassed_01</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
    </bpmn:participant>
  </bpmn:collaboration>

  <bpmn:process id="Process_0c5t3y2l8k6j4h9f" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent name="Order Received" id="StartEvent_OrderReceived">
      <bpmn:outgoing>SequenceFlow_StartToProcess</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Process Order Task -->
    <bpmn:task id="Task_ProcessOrder" name="Process Customer Order">
      <bpmn:incoming>SequenceFlow_StartToProcess</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OrderToWarehouse</bpmn:outgoing>
    </bpmn:task>

    <!-- Warehouse Task -->
    <bpmn:task id="Task_DeterminePartsRequired" name="Determine Parts Required">
      <bpmn:incoming>SequenceFlow_OrderToWarehouse</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToGateway_PartsAvailable_01</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for parts availability -->
    <bpmn:exclusiveGateway id="Gateway_PartsAvailable_01" name="Parts Available?">
      <bpmn:incoming>SequenceFlow_ToGateway_PartsAvailable_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NoProductionReady</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Order Missing Parts Task -->
    <bpmn:task id="Task_OrderMissingParts" name="Order Missing Parts">
      <bpmn:incoming>SequenceFlow_YesOrdering</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PartsOrderedToGateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for parts ordering completion -->
    <bpmn:exclusiveGateway id="Gateway_PartsOrderingComplete_01" name="All Parts Ordered?">
      <bpmn:incoming>SequenceFlow_PartsOrderedToGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AllReadyProduction</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Start Production Task -->
    <bpmn:task id="Task_StartProduction" name="Start Production">
      <bpmn:incoming>SequenceFlow_NoProductionReady</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProductionToQuality_01</bpmn:outgoing>
    </bpmn:task>

    <!-- Quality Checks Task -->
    <bpmn:task id="Task_PerformQualityChecks" name="Perform Quality Checks">
      <bpmn:incoming>SequenceFlow_ProductionToQuality_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_QualityCheckResult_01</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for quality check result -->
    <bpmn:exclusiveGateway id="Gateway_QualityPassed_01" name="Quality Passed?">
      <bpmn:incoming>SequenceFlow_QualityCheckResult_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PackagingReady</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Packaging and Labeling Task -->
    <bpmn:task id="Task_PackageAndLabel" name="Package and Label Products">
      <bpmn:incoming>SequenceFlow_PackagingReady</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReturnToWarehouse_01</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for warehouse return -->
    <bpmn:exclusiveGateway id="Gateway_WarehouseReturn_01" name="Warehouse Ready?">
      <bpmn:incoming>SequenceFlow_ReturnToWarehouse_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SalesInformed_01</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Inform Sales Task -->
    <bpmn:task id="Task_InformSales" name="Inform Sales Department">
      <bpmn:incoming>SequenceFlow_SalesInformed_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToEndEvent_01</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent name="Order Completed" id="EndEvent_OrderCompleted">
      <bpmn:incoming>SequenceFlow_ToEndEvent_01</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToProcess" sourceRef="StartEvent_OrderReceived" targetRef="Task_ProcessOrder">
      <bpmn:name>Order Received</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_OrderToWarehouse" name="Send to Warehouse" sourceRef="Task_ProcessOrder" targetRef="Task_DeterminePartsRequired">
      <bpmn:name>Send to Warehouse</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ToGateway_PartsAvailable_01" name="Determination Complete" sourceRef="Task_DeterminePartsRequired" targetRef="Gateway_PartsAvailable_01">
      <bpmn:name>Determination Complete</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_NoProductionReady" name="Yes - All Parts Available" sourceRef="Gateway_PartsAvailable_01" targetRef="Task_StartProduction">
      <bpmn:name>All Parts Ready</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:exclusiveGateway id="Gateway_PartsMissingCheck_01" name="Parts Missing?">
      <bpmn:incoming>SequenceFlow_ToGateway_PartsAvailable_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_YesOrdering</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="SequenceFlow_YesOrdering" name="No - Parts Missing" sourceRef="Gateway_PartsMissingCheck_01" targetRef="Task_OrderMissingParts">
      <bpmn:name>No</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_AllReadyProduction" name="All Parts Ordered" sourceRef="Gateway_PartsOrderingComplete_01" targetRef="Task_StartProduction">
      <bpmn:name>All Ready</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ProductionToQuality_01" name="Ready for QC" sourceRef="Task_StartProduction" targetRef="Task_PerformQualityChecks">
      <bpmn:name>Pending</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_QualityCheckResult_01" name="Results Available" sourceRef="Task_PerformQualityChecks" targetRef="Gateway_QualityPassed_01">
      <bpmn:name>Pending</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_PackagingReady" name="Yes - Quality OK" sourceRef="Gateway_QualityPassed_01" targetRef="Task_PackageAndLabel">
      <bpmn:name>Pending</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ReturnToWarehouse_01" name="Return to Warehouse" sourceRef="Task_PackageAndLabel" targetRef="Gateway_WarehouseReturn_01">
      <bpmn:name>Pending</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_SalesInformed_01" name="All Complete" sourceRef="Gateway_WarehouseReturn_01" targetRef="Task_InformSales">
      <bpmn:name>Pending</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ToEndEvent_01" name="Order Completed" sourceRef="Task_InformSales" targetRef="EndEvent_OrderCompleted">
      <bpmn:name>Pending</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>