<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_PurchaseProcess">
    <bpmn:participant id="Participant_ACMEInc" name="ACME Inc." processRef="Process_PurchaseOrder">
      <bpmn:laneSet>
        <bpmn:lane id="Lane_DemandDepartment">
          <bpmn:flowNodeRef>StartEvent_01</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Task_CheckStockAvailability</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Gateway_SufficientStock</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_CentralProcurement">
          <bpmn:flowNodeRef>Task_CreatePurchaseRequisition</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Gateway_CheckSupplierInfo</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Task_ValidateSupplierExists</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Task_CreateNewSupplier</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>InclusiveGateway_SupplierCheckComplete</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
    </bpmn:participant>
  </bpmn:collaboration>

  <bpmn:process id="Process_PurchaseOrder" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent name="Demand Identified" id="StartEvent_01">
      <bpmn:outgoing>SequenceFlow_DemandIdentified</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Check Stock Availability Task -->
    <bpmn:task name="Check if goods available in stock" id="Task_CheckStockAvailability">
      <bpmn:incoming>SequenceFlow_DemandIdentified</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StockDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Decision Gateway for Stock Check -->
    <bpmn:exclusiveGateway name="Sufficient stock?" id="Gateway_SufficientStock">
      <bpmn:incoming>SequenceFlow_StockDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EnoughGoods</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NeedRequisition</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Local Consumption Path -->
    <bpmn:endEvent name="Stock consumed locally" id="EndEvent_LocalConsumption">
      <bpmn:incoming>SequenceFlow_ConsumeLocally</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Purchase Requisition Creation Task (Department) -->
    <bpmn:task name="Define goods type and amounts" id="Task_CreatePurchaseRequisition">
      <bpmn:incoming>SequenceFlow_NeedRequisition</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RequisitionCreated</bpmn:outgoing>
    </bpmn:task>

    <!-- Supplier Information Check Gateway -->
    <bpmn:exclusiveGateway name="Supplier info available?" id="Gateway_CheckSupplierInfo">
      <bpmn:incoming>SequenceFlow_SupplierCheckResult</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NewSupplierNeeded</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ExistingSupplier</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Create New Supplier Task -->
    <bpmn:task name="Create new supplier in ERP" id="Task_CreateNewSupplier">
      <bpmn:incoming>SequenceFlow_NewSupplierNeeded</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SupplierCreated</bpmn:outgoing>
    </bpmn:task>

    <!-- Inclusive Gateway for Supplier Path Convergence -->
    <bpmn:inclusiveGateway name="Supplier check complete" id="InclusiveGateway_SupplierCheckComplete">
      <bpmn:incoming>SequenceFlow_ExistingSupplier</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_SupplierCreated</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OrderTemplateCreation</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Order Template Creation Task -->
    <bpmn:task name="Create order template in ERP" id="Task_CreateOrderTemplate">
      <bpmn:incoming>SequenceFlow_OrderTemplateCreation</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TemplateReadyForApproval</bpmn:outgoing>
    </bpmn:task>

    <!-- Approver Task -->
    <bpmn:userTask name="Approve order" id="UserTask_ApproveOrder">
      <bpmn:incoming>SequenceFlow_TemplateReadyForApproval</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OrderApproved</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event for Purchase Order -->
    <bpmn:endEvent name="Purchase order triggered" id="EndEvent_PurchaseOrderTriggered">
      <bpmn:incoming>SequenceFlow_TriggerPurchaseOrder</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows - Stock Check Path -->
    <bpmn:sequenceFlow name="Demand identified" id="SequenceFlow_DemandIdentified">
      <bpmn:sourceRef>StartEvent_01</bpmn:sourceRef>
      <bpmn:targetRef>Task_CheckStockAvailability</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow name="Check stock result" id="SequenceFlow_StockDecision">
      <bpmn:sourceRef>Task_CheckStockAvailability</bpmn:sourceRef>
      <bpmn:targetRef>Gateway_SufficientStock</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Stock Sufficient Path -->
    <bpmn:sequenceFlow name="Yes - sufficient stock" id="SequenceFlow_EnoughGoods">
      <bpmn:sourceRef>Gateway_SufficientStock</bpmn:sourceRef>
      <bpmn:targetRef>EndEvent_LocalConsumption</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Stock Insufficient Path -->
    <bpmn:sequenceFlow name="No - need requisition" id="SequenceFlow_NeedRequisition">
      <bpmn:sourceRef>Gateway_SufficientStock</bpmn:sourceRef>
      <bpmn:targetRef>Task_CreatePurchaseRequisition</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Requisition to Supplier Check -->
    <bpmn:sequenceFlow name="Requisition created" id="SequenceFlow_RequisitionCreated">
      <bpmn:sourceRef>Task_CreatePurchaseRequisition</bpmn:sourceRef>
      <bpmn:targetRef>InclusiveGateway_SupplierCheckComplete</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Supplier Check Path -->
    <bpmn:sequenceFlow name="Supplier check result" id="SequenceFlow_SupplierCheckResult">
      <bpmn:sourceRef>InclusiveGateway_SupplierCheckComplete</bpmn:sourceRef>
      <bpmn:targetRef>Gateway_CheckSupplierInfo</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- New Supplier Path -->
    <bpmn:sequenceFlow name="New supplier needed" id="SequenceFlow_NewSupplierNeeded">
      <bpmn:sourceRef>Gateway_CheckSupplierInfo</bpmn:sourceRef>
      <bpmn:targetRef>Task_CreateNewSupplier</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Existing Supplier Path -->
    <bpmn:sequenceFlow name="Existing supplier" id="SequenceFlow_ExistingSupplier">
      <bpmn:sourceRef>Gateway_CheckSupplierInfo</bpmn:sourceRef>
      <bpmn:targetRef>InclusiveGateway_SupplierCheckComplete</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Supplier Created Path -->
    <bpmn:sequenceFlow name="New supplier created" id="SequenceFlow_SupplierCreated">
      <bpmn:sourceRef>Task_CreateNewSupplier</bpmn:sourceRef>
      <bpmn:targetRef>InclusiveGateway_SupplierCheckComplete</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Order Template Creation -->
    <bpmn:sequenceFlow name="Create order template" id="SequenceFlow_OrderTemplateCreation">
      <bpmn:sourceRef>InclusiveGateway_SupplierCheckComplete</bpmn:sourceRef>
      <bpmn:targetRef>Task_CreateOrderTemplate</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Template Ready for Approval -->
    <bpmn:sequenceFlow name="Template ready" id="SequenceFlow_TemplateReadyForApproval">
      <bpmn:sourceRef>Task_CreateOrderTemplate</bpmn:sourceRef>
      <bpmn:targetRef>UserTask_ApproveOrder</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Order Approved -->
    <bpmn:sequenceFlow name="Approved" id="SequenceFlow_OrderApproved">
      <bpmn:sourceRef>UserTask_ApproveOrder</bpmn:sourceRef>
      <bpmn:targetRef>EndEvent_PurchaseOrderTriggered</bpmn:targetRef>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>