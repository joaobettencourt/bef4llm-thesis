<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions id="Definitions_ErrorResolution_02" targetNamespace="http://bpmn.io/schema/bpmn" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <bpmn:collaboration id="Collab_ErrorResolution_02">
    <bpmn:participant name="Error Resolution Process" processRef="Process_ErrorResolution_02"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_ErrorResolution_02" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_DropOffTech" name="Drop-off Tech">
        <bpmn:flowNodeRef>Task_CheckTypos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_IsTypo</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Technician" name="Technician">
        <bpmn:flowNodeRef>StartEvent_ErrorNotification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckCustomerCorrection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CanCorrect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ScourPublicSources</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_IssueResolved</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_ErrorNotification" name="IS Notified about Data Validation Error">
      <bpmn:outgoing>SequenceFlow_StartToCheckTypos</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1 -->
    <bpmn:task id="Task_CheckTypos" name="Drop-off Tech checks for typos">
      <bpmn:incoming>SequenceFlow_StartToCheckTypos</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TyposToGateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1 -->
    <bpmn:exclusiveGateway id="Gateway_IsTypo" name="Is Typo?">
      <bpmn:incoming>SequenceFlow_TyposToGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ResolvedIfTypo</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NotTypoToCorrectionCheck</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 2 -->
    <bpmn:task id="Task_CheckCustomerCorrection" name="Technician checks if customer can correct mistake">
      <bpmn:incoming>SequenceFlow_NotTypoToCorrectionCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CorrectionDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2 -->
    <bpmn:exclusiveGateway id="Gateway_CanCorrect" name="Can Customer Correct?">
      <bpmn:incoming>SequenceFlow_CorrectionDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ResolvedIfYes</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ScourSources</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 3 -->
    <bpmn:task id="Task_ScourPublicSources" name="Scour public sources for solutions">
      <bpmn:incoming>SequenceFlow_ScourSources</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SourceToResolved</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_IssueResolved" name="Issue Resolved">
      <bpmn:incoming>SequenceFlow_ResolvedIfTypo</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ResolvedIfYes</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_SourceToResolved</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToCheckTypos" sourceRef="StartEvent_ErrorNotification" targetRef="Task_CheckTypos"/>
    <bpmn:sequenceFlow id="SequenceFlow_TyposToGateway" name="Typo Found?" sourceRef="Task_CheckTypos" targetRef="Gateway_IsTypo"/>
    <bpmn:sequenceFlow id="SequenceFlow_ResolvedIfTypo" name="Yes (Is Typo)" sourceRef="Gateway_IsTypo" targetRef="EndEvent_IssueResolved"/>
    <bpmn:sequenceFlow id="SequenceFlow_NotTypoToCorrectionCheck" name="No (Not Typo)" sourceRef="Gateway_IsTypo" targetRef="Task_CheckCustomerCorrection"/>
    <bpmn:sequenceFlow id="SequenceFlow_CorrectionDecision" sourceRef="Task_CheckCustomerCorrection" targetRef="Gateway_CanCorrect"/>
    <bpmn:sequenceFlow id="SequenceFlow_ResolvedIfYes" name="Can Correct?" sourceRef="Gateway_CanCorrect" targetRef="EndEvent_IssueResolved"/>
    <bpmn:sequenceFlow id="SequenceFlow_ScourSources" name="Otherwise (Cannot Correct)" sourceRef="Gateway_CanCorrect" targetRef="Task_ScourPublicSources"/>
    <bpmn:sequenceFlow id="SequenceFlow_SourceToResolved" sourceRef="Task_ScourPublicSources" targetRef="EndEvent_IssueResolved"/>

  </bpmn:process>
</bpmn:definitions>