<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions id="Definitions_2a3b4c5d6e7f8g9h" targetNamespace="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <bpmn:collaboration id="Collab_0a9j6w5v4h3k2l7x8m1p">
    <bpmn:participant name="SSP" processRef="Process_0c5t3y2l8k6j4h9f" />
  </bpmn:collaboration>

  <bpmn:message id="Message_InvoiceReceivedFromClient" name="Invoice Received from Client" />
  <bpmn:message id="Message_CompletionRequestToClient" name="Completion Request to Client" />

  <bpmn:process id="Process_0c5t3y2l8k6j4h9f" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_AdminOffice">
        <bpmn:flowNodeRef>StartEvent_InvoiceReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SortInvoicePerClient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SortInvoicePerVendor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AttachEntryForm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterInfoOnEntryForm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CheckCompleteness</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterSLAInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CheckPriority</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ApplyRedStamp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ComplianceCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CheckCompliance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ResolutionMethod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProcessNonCompliance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CallClient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_Reminder10Hours</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_DEO">
        <bpmn:flowNodeRef>Task_AllocateToDEO</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_InvoiceReceived" name="Invoice Received from Client">
      <bpmn:messageEventDefinition messageRef="Message_InvoiceReceivedFromClient" />
      <bpmn:outgoing>SequenceFlow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Admin Office Tasks -->
    <bpmn:task id="Task_SortInvoicePerClient" name="Sort Invoice per Client">
      <bpmn:incoming>SequenceFlow_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_02</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_SortInvoicePerVendor" name="Sort Invoice per Vendor">
      <bpmn:incoming>SequenceFlow_02</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_03</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_AttachEntryForm" name="Attach Invoice Entry Form">
      <bpmn:incoming>SequenceFlow_03</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_04</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_EnterInfoOnEntryForm" name="Enter Required Info on Entry Form">
      <bpmn:incoming>SequenceFlow_04</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_05</bpmn:outgoing>
    </bpmn:task>

    <!-- First Completeness Check -->
    <bpmn:exclusiveGateway id="Gateway_CheckCompleteness" name="Invoice Complete?">
      <bpmn:incoming>SequenceFlow_05</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_IncompletePath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CompletePath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Incomplete Path -->
    <bpmn:endEvent id="EndEvent_InvalidInvoice" name="Process Finished - Invalid Invoice">
      <bpmn:messageEventDefinition messageRef="Message_CompletionRequestToClient" />
      <bpmn:incoming>SequenceFlow_IncompletePath</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Complete Path -->
    <bpmn:task id="Task_EnterSLAInfo" name="Enter SLA Info">
      <bpmn:incoming>SequenceFlow_CompletePath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_06</bpmn:outgoing>
    </bpmn:task>

    <!-- Priority Check -->
    <bpmn:exclusiveGateway id="Gateway_CheckPriority" name="High Priority?">
      <bpmn:incoming>SequenceFlow_06</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_HighPriorityPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NormalPriorityPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- High Priority Path -->
    <bpmn:task id="Task_ApplyRedStamp" name="Apply Red Stamp on Entry Invoice">
      <bpmn:incoming>SequenceFlow_HighPriorityPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_07</bpmn:outgoing>
    </bpmn:task>

    <!-- Normal Priority Path -->
    <bpmn:sequenceFlow id="SequenceFlow_NormalPriorityPath" sourceRef="Gateway_CheckPriority" targetRef="Task_ComplianceCheck">
      <bpmn:description>Normal priority</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Compliance Check Task -->
    <bpmn:task id="Task_ComplianceCheck" name="Check Invoice Compliance">
      <bpmn:incoming>SequenceFlow_07</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CompletePath2</bpmn:outgoing>
    </bpmn:task>

    <!-- Complete Compliance Path -->
    <bpmn:endEvent id="EndEvent_CompleteInvoice" name="Process Finished - Invoice Allocated">
      <bpmn:incoming>SequenceFlow_AllocateToDEO</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Incomplete Compliance Path -->
    <bpmn:exclusiveGateway id="Gateway_CheckCompliance" name="Invoice Compliant?">
      <bpmn:incoming>SequenceFlow_CompletePath2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AllocateToDEO</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_IncompletePath2</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Resolution Method Gateway -->
    <bpmn:exclusiveGateway id="Gateway_ResolutionMethod" name="Choose Resolution Method?">
      <bpmn:incoming>SequenceFlow_IncompletePath2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ExperienceStaff</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CallClient</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PostalMail</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Experience Staff Path -->
    <bpmn:task id="Task_ProcessNonCompliance" name="Process Non-Compliance Invoice">
      <bpmn:incoming>SequenceFlow_ExperienceStaff</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConvergeToDEO</bpmn:outgoing>
    </bpmn:task>

    <!-- Call Client Path -->
    <bpmn:task id="Task_CallClient" name="Call Client for Information">
      <bpmn:incoming>SequenceFlow_CallClient</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConvergeToDEO2</bpmn:outgoing>
    </bpmn:task>

    <!-- Postal Mail Path -->
    <bpmn:intermediateCatchEvent id="Timer_Reminder10Hours" name="Reminder after 10 hours">
      <bpmn:timerEventDefinition xsi:type="bpmn:TimeDateExpression">PT10H</bpmn:timeDateExpression>
      <bpmn:incoming>SequenceFlow_PostalMail</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConvergeToDEO3</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- DEO Allocation Task -->
    <bpmn:task id="Task_AllocateToDEO" name="Allocate Invoice to DEO">
      <bpmn:incoming>SequenceFlow_ConvergeToDEO</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ConvergeToDEO2</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ConvergeToDEO3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AllocateToDEO</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_01" sourceRef="StartEvent_InvoiceReceived" targetRef="Task_SortInvoicePerClient">
      <bpmn:description>Initial processing</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_02" sourceRef="Task_SortInvoicePerClient" targetRef="Task_SortInvoicePerVendor"></bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_03" sourceRef="Task_SortInvoicePerVendor" targetRef="Task_AttachEntryForm"></bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_04" sourceRef="Task_AttachEntryForm" targetRef="Task_EnterInfoOnEntryForm"></bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_05" sourceRef="Task_EnterInfoOnEntryForm" targetRef="Gateway_CheckCompleteness"></bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_IncompletePath" name="Not Complete" sourceRef="Gateway_CheckCompleteness" targetRef="EndEvent_InvalidInvoice">
      <bpmn:description>Invoice not complete</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_CompletePath" name="Complete" sourceRef="Gateway_CheckCompleteness" targetRef="Task_EnterSLAInfo">
      <bpmn:description>Invoice is complete</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_06" sourceRef="Task_EnterSLAInfo" targetRef="Gateway_CheckPriority"></bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_HighPriorityPath" name="High Priority" sourceRef="Gateway_CheckPriority" targetRef="Task_ApplyRedStamp">
      <bpmn:description>Invoice has high priority</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_07" name="After Red Stamp or Normal Priority" sourceRef="Gateway_CheckPriority" targetRef="Task_ComplianceCheck"></bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_CompletePath2" name="Compliant" sourceRef="Task_ComplianceCheck" targetRef="Gateway_CheckCompliance">
      <bpmn:description></bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_AllocateToDEO" name="Allocate Invoice to DEO" sourceRef="Task_AllocateToDEO" targetRef="EndEvent_CompleteInvoice">
      <bpmn:description></bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_IncompletePath2" name="Not Compliant" sourceRef="Gateway_CheckCompliance" targetRef="Gateway_ResolutionMethod"></bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ExperienceStaff" name="Experience Staff Processing" sourceRef="Gateway_ResolutionMethod" targetRef="Task_ProcessNonCompliance">
      <bpmn:description></bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_CallClient" name="Call Client for Information" sourceRef="Gateway_ResolutionMethod" targetRef="Task_CallClient"></bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_PostalMail" name="Postal Mail Requesting Information" sourceRef="Gateway_ResolutionMethod" targetRef="Timer_Reminder10Hours">
      <bpmn:description></bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ConvergeToDEO" name="Converge to DEO Allocation" sourceRef="Task_ProcessNonCompliance" targetRef="Task_AllocateToDEO"></bpmn:sequenceFlow>
    
    <bpmn:sequenceFlow id="SequenceFlow_ConvergeToDEO2" name="Converge to DEO Allocation" sourceRef="Task_CallClient" targetRef="Task_AllocateToDEO"></bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ConvergeToDEO3" name="Converge to DEO Allocation after Reminder" sourceRef="Timer_Reminder10Hours" targetRef="Task_AllocateToDEO">
      <bpmn:description></bpmn:description>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>