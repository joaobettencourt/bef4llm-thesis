<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_0a9j6w5v4h3k2l7x">
    <bpmn:participant name="ACME Inc." processRef="Process_1" />
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_FinancialDept">
        <bpmn:flowNodeRef>Task_CheckInvoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Department">
        <bpmn:flowNodeRef>Task_CheckFactualCorrectness</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_AmountCheck</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_DepartmentHead">
        <bpmn:flowNodeRef>Task_ApproveInvoice</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent name="Purchase Invoice Received" id="StartEvent_1">
      <bpmn:outgoing>SequenceFlow_CheckInvoice</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Financial Department Task -->
    <bpmn:task id="Task_CheckInvoice" name="Check Purchase Invoice">
      <bpmn:incoming>SequenceFlow_CheckInvoice</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToDepartment</bpmn:outgoing>
    </bpmn:task>

    <!-- Department Task -->
    <bpmn:task id="Task_CheckFactualCorrectness" name="Check Factual Correctness &amp; Register in SAPERION">
      <bpmn:incoming>SequenceFlow_ToDepartment</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AmountDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway for Amount Check -->
    <bpmn:exclusiveGateway id="InclusiveGateway_AmountCheck" name="$500 Threshold">
      <bpmn:incoming>SequenceFlow_AmountDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Over500</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_Under500</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Department Head Task (Approval) -->
    <bpmn:task id="Task_ApproveInvoice" name="Approve Invoice in SAPERION">
      <bpmn:incoming>SequenceFlow_Over500</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToERP</bpmn:outgoing>
    </bpmn:task>

    <!-- ERP System Trigger Task -->
    <bpmn:task id="Task_TriggerPayment" name="Trigger Payment in ERP">
      <bpmn:incoming>SequenceFlow_Under500</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ToERP</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndProcess</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent name="Payment Processed" id="EndEvent_1">
      <bpmn:incoming>SequenceFlow_EndProcess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckInvoice" sourceRef="StartEvent_1" targetRef="Task_CheckInvoice">
      <bpmn:name>Purchase Invoice Received</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ToDepartment" name="Send to Department" sourceRef="Task_CheckInvoice" targetRef="Task_CheckFactualCorrectness">
      <bpmn:description>Forward invoice for factual check</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_AmountDecision" name="$500 Threshold Check" sourceRef="Task_CheckFactualCorrectness" targetRef="InclusiveGateway_AmountCheck">
      <bpmn:description>Determine if amount exceeds $500</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Gateway Outgoing Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_Over500" name="Amount &gt; $500" sourceRef="InclusiveGateway_AmountCheck" targetRef="Task_ApproveInvoice">
      <bpmn:description>Route to department head for approval</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_Under500" name="Amount &lt;= $500" sourceRef="InclusiveGateway_AmountCheck" targetRef="Task_TriggerPayment">
      <bpmn:description>Route directly to ERP payment trigger</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Flow from Approval Task -->
    <bpmn:sequenceFlow id="SequenceFlow_ToERP" name="After approval" sourceRef="Task_ApproveInvoice" targetRef="Task_TriggerPayment">
      <bpmn:description>Proceed to ERP after department head approval</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Final Flow to End -->
    <bpmn:sequenceFlow id="SequenceFlow_EndProcess" name="Trigger ERP Payment" sourceRef="Task_TriggerPayment" targetRef="EndEvent_1">
      <bpmn:description>Complete the purchase order-to-delivery process</bpmn:description>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>