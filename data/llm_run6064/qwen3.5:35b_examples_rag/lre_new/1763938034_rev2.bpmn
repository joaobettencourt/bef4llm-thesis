<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions id="Definitions_0a9j6w5v4h3k2l7x" targetNamespace="http://bpmn.io/schema/bpmn" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <bpmn:collaboration id="Collab_0v7x8w9z6q1p0r4m">
    <bpmn:participant name="Reward and Training Process" processRef="Process_0c5t3y2l8k6j4h9f">
      <bpmn:laneSet>
        <bpmn:lane id="Lane_Management">
          <bpmn:flowNodeRef>Task_CheckPerformance</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Gateway_PerformanceCheck</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Task_SuggestDismissal</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Task_SuggestTraining</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Gateway_RewardType</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Task_ChooseBenefit</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Task_AnnounceEmployeeMonth</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_HR">
          <bpmn:flowNodeRef>Task_DismissEmployee</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Task_ProvideTraining</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_Finance">
          <bpmn:flowNodeRef>Task_CalculateFinancialReward</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Task_PayFinancialReward</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
    </bpmn:participant>
  </bpmn:collaboration>

  <bpmn:process id="Process_0c5t3y2l8k6j4h9f" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent name="Start Performance Check" id="StartEvent_PerformanceCheck">
      <bpmn:outgoing>SequenceFlow_StartToTask</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Management Tasks and Gateways -->
    <bpmn:task id="Task_CheckPerformance" name="Check Employee Performance">
      <bpmn:incoming>SequenceFlow_StartToTask</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TaskToGateway</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_PerformanceCheck" name="Performance Threshold">
      <bpmn:incoming>SequenceFlow_TaskToGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DismissalPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_TrainingPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RewardPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Dismissal Path (&lt; 20%) -->
    <bpmn:task id="Task_SuggestDismissal" name="Suggest Employee Dismissal to HR">
      <bpmn:incoming>SequenceFlow_DismissalPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToHRDismiss</bpmn:outgoing>
    </bpmn:task>

    <!-- Training Path (20% - 50%) -->
    <bpmn:task id="Task_SuggestTraining" name="Suggest Employee for Training">
      <bpmn:incoming>SequenceFlow_TrainingPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToHRProvide</bpmn:outgoing>
    </bpmn:task>

    <!-- Reward Path (&gt; 75%) -->
    <bpmn:exclusiveGateway id="Gateway_RewardType" name="Reward Type">
      <bpmn:incoming>SequenceFlow_RewardPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FinancialReward</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_OtherBenefit</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Financial Reward Path -->
    <bpmn:task id="Task_CalculateFinancialReward" name="Calculate Financial Reward">
      <bpmn:incoming>SequenceFlow_FinancialReward</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PayFinancial</bpmn:outgoing>
    </bpmn:task>

    <!-- Other Benefit Path -->
    <bpmn:task id="Task_ChooseBenefit" name="Choose Appropriate Benefit">
      <bpmn:incoming>SequenceFlow_OtherBenefit</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToAnnounce</bpmn:outgoing>
    </bpmn:task>

    <!-- Common End Task -->
    <bpmn:task id="Task_AnnounceEmployeeMonth" name="Announce Employee of the Month">
      <bpmn:incoming>SequenceFlow_PayFinancial</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToEndEvent</bpmn:outgoing>
    </bpmn:task>

    <!-- End Events -->
    <bpmn:endEvent name="Employee Dismissed" id="EndEvent_Dismissal">
      <bpmn:incoming>SequenceFlow_HRDismissToDismissEnd</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent name="Training Completed" id="EndEvent_Training">
      <bpmn:incoming>SequenceFlow_ProvideTrainingToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent name="Reward Processed" id="EndEvent_Reward">
      <bpmn:incoming>SequenceFlow_ToAnnounceToFinal</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToTask" sourceRef="StartEvent_PerformanceCheck" targetRef="Task_CheckPerformance">
      <bpmn:name/>
    </bpmn:sequenceFlow>
    
    <bpmn:sequenceFlow id="SequenceFlow_TaskToGateway" name="Less than 20%, Greater or equal to 20% and Less than 50%, or Greater than 75%" sourceRef="Task_CheckPerformance" targetRef="Gateway_PerformanceCheck">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <!-- Dismissal Path -->
    <bpmn:sequenceFlow id="SequenceFlow_DismissalPath" name="Less than 20%" sourceRef="Gateway_PerformanceCheck" targetRef="Task_SuggestDismissal">
      <bpmn:name/>
    </bpmn:sequenceFlow>
    
    <bpmn:sequenceFlow id="SequenceFlow_ToHRDismiss" sourceRef="Task_SuggestDismissal" targetRef="Task_DismissEmployee"/>

    <!-- Training Path -->
    <bpmn:sequenceFlow id="SequenceFlow_TrainingPath" name="Greater or equal to 20% and Less than 50%" sourceRef="Gateway_PerformanceCheck" targetRef="Task_SuggestTraining">
      <bpmn:name/>
    </bpmn:sequenceFlow>
    
    <bpmn:sequenceFlow id="SequenceFlow_ToHRProvide" sourceRef="Task_SuggestTraining" targetRef="Task_ProvideTraining"/>

    <!-- Reward Path -->
    <bpmn:sequenceFlow id="SequenceFlow_RewardPath" name="Greater than 75%" sourceRef="Gateway_PerformanceCheck" targetRef="Gateway_RewardType">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <!-- Financial Reward Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_FinancialReward" name="Financial Reward" sourceRef="Gateway_RewardType" targetRef="Task_CalculateFinancialReward">
      <bpmn:name/>
    </bpmn:sequenceFlow>
    
    <bpmn:sequenceFlow id="SequenceFlow_PayFinancial" sourceRef="Task_CalculateFinancialReward" targetRef="Task_AnnounceEmployeeMonth"/>

    <!-- Other Benefit Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_OtherBenefit" name="Other Benefit" sourceRef="Gateway_RewardType" targetRef="Task_ChooseBenefit">
      <bpmn:name/>
    </bpmn:sequenceFlow>
    
    <bpmn:sequenceFlow id="SequenceFlow_ToAnnounce" sourceRef="Task_ChooseBenefit" targetRef="Task_AnnounceEmployeeMonth"/>

    <!-- End Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_HRDismissToDismissEnd" name="" sourceRef="Task_DismissEmployee" targetRef="EndEvent_Dismissal">
      <bpmn:name/>
    </bpmn:sequenceFlow>
    
    <bpmn:sequenceFlow id="SequenceFlow_ProvideTrainingToEnd" name="" sourceRef="Task_ProvideTraining" targetRef="EndEvent_Training"/>

    <bpmn:sequenceFlow id="SequenceFlow_ToAnnounceToFinal" name="" sourceRef="Task_AnnounceEmployeeMonth" targetRef="EndEvent_Reward">
      <bpmn:name/>
    </bpmn:sequenceFlow>
  </bpmn:process>
</bpmn:definitions>