<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1a8v7kx" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1a8v7ky">
    <bpmn:participant id="Participant_0h3c6f2" name="Vienna Night Run App Process" processRef="Process_1s9j4wq" />
  </bpmn:collaboration>

  <bpmn:process id="Process_1s9j4wq" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_0x2m8vz" name="Participate in Vienna Night Run">
      <bpmn:outgoing>SequenceFlow_3k7f5h6</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Select Starting Block -->
    <bpmn:userTask id="Task_4g9w1p2" name="Select starting block">
      <bpmn:incoming>SequenceFlow_3k7f5h6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_8t6j3x4</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Run and Measure Time -->
    <bpmn:task id="Task_2l7k9s5" name="Run 5km and measure time">
      <bpmn:incoming>SequenceFlow_8t6j3x4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1q4h8w7</bpmn:outgoing>
    </bpmn:task>

    <!-- Check if time is less than 25 minutes -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_6j9w4k2" name="Time &lt; 25 min?">
      <bpmn:incoming>SequenceFlow_1q4h8w7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3s6v8q1</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Training Loop -->
    <bpmn:userTask id="Task_5p6k3h9" name="Train and check">
      <bpmn:incoming>SequenceFlow_7w4t2m1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_8g3f1v7</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Get Starting Number -->
    <bpmn:userTask id="Task_2f4k8j5" name="Get starting number">
      <bpmn:incoming>SequenceFlow_3s6v8q1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_9t7h2m4</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Decision based on work day end -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_8k5j3p6" name="More than 1 hour before start?">
      <bpmn:incoming>SequenceFlow_9t7h2m4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4f1g8r2</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Go from home -->
    <bpmn:userTask id="Task_7m2f6k8" name="Go to event from home">
      <bpmn:incoming>SequenceFlow_4f1g8r2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5s9v3t7</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Leave from work -->
    <bpmn:userTask id="Task_1x5w8q3" name="Leave directly from work">
      <bpmn:incoming>SequenceFlow_6k2j4p9</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_7s8v4m2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Converge to parallel run -->
    <bpmn:parallelGateway id="ParallelGateway_3q9j7w4" name="">
      <bpmn:incoming>SequenceFlow_5s8v2t6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1f3r7p6</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Run activity -->
    <bpmn:userTask id="Task_9s4h1g3" name="Run at Night Run">
      <bpmn:incoming>SequenceFlow_2k8v5j4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_7w6f3p1</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Drink activity -->
    <bpmn:userTask id="Task_0y7m4v1" name="Drink while running">
      <bpmn:incoming>SequenceFlow_2k8v5j4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3t6h9p2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Converge parallel activities -->
    <bpmn:parallelGateway id="ParallelGateway_4k7g5p0" name="">
      <bpmn:incoming>SequenceFlow_3t6h9p2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_8w1f6m3</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_2k7g5p0" name="Receive final running time">
      <bpmn:incoming>SequenceFlow_8w1f6m3</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_3k7f5h6" sourceRef="StartEvent_0x2m8vz" targetRef="Task_4g9w1p2">
      <bpmn:name>Select starting block</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_8t6j3x4" sourceRef="Task_4g9w1p2" targetRef="Task_2l7k9s5">
      <bpmn:name>Start running</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_1q4h8w7" sourceRef="Task_2l7k9s5" targetRef="ExclusiveGateway_6j9w4k2">
      <bpmn:name>Measure time</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Training loop back -->
    <bpmn:sequenceFlow id="SequenceFlow_7w4t2m1" sourceRef="ExclusiveGateway_6j9w4k2" targetRef="Task_5p6k3h9">
      <bpmn:name>No, train more</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Training loop back to run -->
    <bpmn:sequenceFlow id="SequenceFlow_8g3f1v7" sourceRef="Task_5p6k3h9" targetRef="ExclusiveGateway_6j9w4k2">
      <bpmn:name>Check again</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Achieved goal -->
    <bpmn:sequenceFlow id="SequenceFlow_3s6v8q1" sourceRef="ExclusiveGateway_6j9w4k2" targetRef="Task_2f4k8j5">
      <bpmn:name>Yes, achieved</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Work day decision -->
    <bpmn:sequenceFlow id="SequenceFlow_9t7h2m4" sourceRef="Task_2f4k8j5" targetRef="ExclusiveGateway_8k5j3p6">
      <bpmn:name>Check work schedule</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Go from home -->
    <bpmn:sequenceFlow id="SequenceFlow_4f1g8r2" sourceRef="ExclusiveGateway_8k5j3p6" targetRef="Task_7m2f6k8">
      <bpmn:name>Yes, go from home</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Leave from work -->
    <bpmn:sequenceFlow id="SequenceFlow_6k2j4p9" sourceRef="ExclusiveGateway_8k5j3p6" targetRef="Task_1x5w8q3">
      <bpmn:name>No, leave from work</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Go from home to run -->
    <bpmn:sequenceFlow id="SequenceFlow_5s9v3t7" sourceRef="Task_7m2f6k8" targetRef="ParallelGateway_3q9j7w4">
      <bpmn:name>Arrive at event</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Leave from work to run -->
    <bpmn:sequenceFlow id="SequenceFlow_5s8v2t6" sourceRef="Task_1x5w8q3" targetRef="ParallelGateway_3q9j7w4">
      <bpmn:name>Arrive at event</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Run and drink parallel -->
    <bpmn:parallelGateway id="ParallelGateway_5t8h2k6" name="">
      <bpmn:incoming>SequenceFlow_1f3r7p6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2k8v5j4</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Run activity -->
    <bpmn:userTask id="Task_9s4h1g3" name="Run at Night Run">
      <bpmn:incoming>SequenceFlow_2k8v5j4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_7w6f3p1</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Drink activity -->
    <bpmn:userTask id="Task_0y7m4v1" name="Drink while running">
      <bpmn:incoming>SequenceFlow_2k8v5j4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3t6h9p2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Converge parallel activities -->
    <bpmn:parallelGateway id="ParallelGateway_4k7g5p0" name="">
      <bpmn:incoming>SequenceFlow_3t6h9p2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_8w1f6m3</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_2k7g5p0" name="Receive final running time">
      <bpmn:incoming>SequenceFlow_8w1f6m3</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>

  <!-- Data Objects -->
  <bpmn:dataObject id="DataObject_RunningTime" name="Running Time Measurement">
    <bpmn:name>5km Running Time</bpmn:name>
  </bpmn:dataObject>

  <bpmn:dataObject id="DataObject_WorkSchedule" name="Work Schedule Information">
    <bpmn:name>End of Work Day</bpmn:name>
  </bpmn:dataObject>

  <!-- Associations -->
  <bpmn:association associationDirection="OneWay">
    <bpmn:startEventRef>StartEvent_0x2m8vz</bpmn:startEventRef>
    <bpmn:dataInputSet>DataObject_RunningTime</bpmn:dataInputSet>
  </bpmn:association>

</bpmn:definitions>