<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1a8v7kx" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1s9j4wq">
    <bpmn:participant id="Participant_0h3c6f2" name="USI Course Registration Process" processRef="Process_1a8v7kx" />
  </bpmn:collaboration>

  <bpmn:process id="Process_1a8v7kx" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_0x2m8vz" name="Register for USI Course">
      <bpmn:outgoing>SequenceFlow_3k7f5h6</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Select Course -->
    <bpmn:userTask id="Task_4g9w1p2" name="Select a course">
      <bpmn:incoming>SequenceFlow_3k7f5h6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_8t6j3x4</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Check if slots are free -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_2l7k9s5" name="Slots Available?">
      <bpmn:incoming>SequenceFlow_8t6j3x4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1q4h8w7</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Show courses and dates -->
    <bpmn:userTask id="Task_3a7f1h8" name="Display available courses">
      <bpmn:incoming>SequenceFlow_1q4h8w7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6k2j4p9</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Check account status -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_5p6k3h9" name="Have Account?">
      <bpmn:incoming>SequenceFlow_7w4t2m1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_8g3f1v7</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Already have account - log in -->
    <bpmn:userTask id="Task_6j9w4k2" name="Log into existing account">
      <bpmn:incoming>SequenceFlow_8g3f1v7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1f3r7p6</bpmn:outgoing>
    </bpmn:userTask>

    <!-- No account - check university -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_2f4k8j5" name="Eligible University?">
      <bpmn:incoming>SequenceFlow_7g5h2m8</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_9s4h1g3</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Register account -->
    <bpmn:userTask id="Task_7m2f6k8" name="Register new account">
      <bpmn:incoming>SequenceFlow_9s4h1g3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5t8v2q4</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Request activation -->
    <bpmn:userTask id="Task_1k9w3p7" name="Request account activation">
      <bpmn:incoming>SequenceFlow_5t8v2q4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6h4j8m2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Wait for response -->
    <bpmn:intermediateCatchEvent id="IntermediateEvent_3q7k5w9" name="Wait for activation">
      <bpmn:incoming>SequenceFlow_6h4j8m2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1x5t9h4</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Twitter integration -->
    <bpmn:userTask id="Task_2m8v6k3" name="Tweet to friends">
      <bpmn:incoming>SequenceFlow_1x5t9h4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_7s4f9p2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Complete registration -->
    <bpmn:userTask id="Task_5k3w8j6" name="Complete course registration">
      <bpmn:incoming>SequenceFlow_7s4f9p2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1q8h5t3</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Payment information -->
    <bpmn:userTask id="Task_9p2k7m4" name="Provide payment information">
      <bpmn:incoming>SequenceFlow_1q8h5t3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6f3v8w1</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_4t7j2k5" name="Receive course ticket">
      <bpmn:incoming>SequenceFlow_6f3v8w1</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_3k7f5h6" sourceRef="StartEvent_0x2m8vz" targetRef="Task_4g9w1p2">
      <bpmn:name>Begin Registration</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Course selection flow -->
    <bpmn:sequenceFlow id="SequenceFlow_8t6j3x4" sourceRef="Task_4g9w1p2" targetRef="ExclusiveGateway_2l7k9s5">
      <bpmn:name>Select course</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Slots available flow -->
    <bpmn:sequenceFlow id="SequenceFlow_1q4h8w7" sourceRef="ExclusiveGateway_2l7k9s5" targetRef="Task_3a7f1h8">
      <bpmn:name>Yes</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Account check flow -->
    <bpmn:sequenceFlow id="SequenceFlow_6k2j4p9" sourceRef="Task_3a7f1h8" targetRef="ExclusiveGateway_5p6k3h9">
      <bpmn:name>Select course</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Have account flow -->
    <bpmn:sequenceFlow id="SequenceFlow_7w4t2m1" sourceRef="ExclusiveGateway_5p6k3h9" targetRef="Task_6j9w4k2">
      <bpmn:name>Yes</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- No account flow -->
    <bpmn:sequenceFlow id="SequenceFlow_8g3f1v7" sourceRef="ExclusiveGateway_5p6k3h9" targetRef="Task_2m8v6k3">
      <bpmn:name>No</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Eligible university flow -->
    <bpmn:sequenceFlow id="SequenceFlow_7g5h2m8" sourceRef="Task_2m8v6k3" targetRef="ExclusiveGateway_2f4k8j5">
      <bpmn:name>Check eligibility</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Register account flow -->
    <bpmn:sequenceFlow id="SequenceFlow_9s4h1g3" sourceRef="ExclusiveGateway_2f4k8j5" targetRef="Task_7m2f6k8">
      <bpmn:name>Yes</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Request activation flow -->
    <bpmn:sequenceFlow id="SequenceFlow_5t8v2q4" sourceRef="ExclusiveGateway_2f4k8j5" targetRef="Task_1k9w3p7">
      <bpmn:name>No</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Wait for activation flow -->
    <bpmn:sequenceFlow id="SequenceFlow_6h4j8m2" sourceRef="Task_1k9w3p7" targetRef="IntermediateEvent_3q7k5w9">
      <bpmn:name>Request sent</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Log in flow -->
    <bpmn:sequenceFlow id="SequenceFlow_1x5t9h4" sourceRef="IntermediateEvent_3q7k5w9" targetRef="Task_6j9w4k2">
      <bpmn:name>Activation received</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Twitter flow -->
    <bpmn:sequenceFlow id="SequenceFlow_7s4f9p2" sourceRef="Task_6j9w4k2" targetRef="Task_5k3w8j6">
      <bpmn:name>Login complete</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Registration flow -->
    <bpmn:sequenceFlow id="SequenceFlow_1q8h5t3" sourceRef="Task_5k3w8j6" targetRef="Task_9p2k7m4">
      <bpmn:name>Tweet sent</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Payment flow -->
    <bpmn:sequenceFlow id="SequenceFlow_6f3v8w1" sourceRef="Task_9p2k7m4" targetRef="EndEvent_4t7j2k5">
      <bpmn:name>Payment complete</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>

</bpmn:definitions>