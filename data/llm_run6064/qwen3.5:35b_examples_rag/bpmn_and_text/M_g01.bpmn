<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_CustomPrint">
    <bpmn:participant id="Participant_CustomPrint" name="Custom 3D Printing Process" processRef="Process_CustomPrint"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_CustomPrint" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Order Requested">
      <bpmn:outgoing>SequenceFlow_StartToInstruct</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Instruct Artist (Initial) -->
    <bpmn:userTask id="Task_InstructArtist" name="Send Sketches to Artist">
      <bpmn:incoming>SequenceFlow_StartToInstruct</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToSatisfiedCheck</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway: Satisfied? -->
    <bpmn:exclusiveGateway id="Gateway_Satisfied" name="Model Satisfactory?">
      <bpmn:incoming>SequenceFlow_ToSatisfiedCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_YesToColor</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoFeedback</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Request Changes (Loop) -->
    <bpmn:userTask id="Task_RequestChanges" name="Request Model Changes">
      <bpmn:incoming>SequenceFlow_NoFeedback</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FeedbackToInstruct</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Choose Color -->
    <bpmn:userTask id="Task_ChooseColor" name="Choose Plastic Color">
      <bpmn:incoming>SequenceFlow_YesToColor</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToStockCheck</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway: Have Stock? -->
    <bpmn:exclusiveGateway id="Gateway_HavePlastic" name="Have Plastic at Home?">
      <bpmn:incoming>SequenceFlow_ToStockCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OrderPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CheckAmountPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Order Plastic -->
    <bpmn:userTask id="Task_OrderPlastic" name="Order Required Color">
      <bpmn:incoming>SequenceFlow_OrderPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConvergeStockReady</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Check Amount -->
    <bpmn:userTask id="Task_CheckAmount" name="Check Stock Quantity">
      <bpmn:incoming>SequenceFlow_CheckAmountPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToUnder100g</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway: Under 100g? -->
    <bpmn:exclusiveGateway id="Gateway_Under100" name="Less than 100g?">
      <bpmn:incoming>SequenceFlow_ToUnder100g</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AddToListPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SufficientPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Add to List -->
    <bpmn:userTask id="Task_AddToShoppingList" name="Add Color to Shopping List">
      <bpmn:incoming>SequenceFlow_AddToListPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConvergeStockReady</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel Gateway Split for Printing Prep -->
    <bpmn:parallelGateway id="ParallelGateway_PrintPrep" name="">
      <bpmn:incoming>SequenceFlow_SufficientPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_HeatPrinterPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_GCodeGenPath</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Heat Printer -->
    <bpmn:userTask id="Task_HeatPrinter" name="Turn on &amp; Heat Up">
      <bpmn:incoming>SequenceFlow_HeatPrinterPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConvergePrintStart</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Generate G-Code -->
    <bpmn:userTask id="Task_GenerateGCode" name="Generate G-code from STL">
      <bpmn:incoming>SequenceFlow_GCodeGenPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConvergePrintStart2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel Gateway Converge for Printing Prep -->
    <bpmn:parallelGateway id="ParallelGateway_PrintReady" name="">
      <bpmn:incoming>SequenceFlow_ConvergeStockReady</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SufficientPath</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task Print Model -->
    <bpmn:userTask id="Task_PrintModel" name="Print 3D Model">
      <bpmn:incoming>SequenceFlow_ConvergePrintStart2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToEndEvent</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_1" name="Model Printed">
      <bpmn:incoming>SequenceFlow_ToEndEvent</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToInstruct" sourceRef="StartEvent_1" targetRef="Task_InstructArtist">
      <bpmn:name>Begin Process</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Sequence Flow to Gateway -->
    <bpmn:sequenceFlow id="SequenceFlow_ToSatisfiedCheck" sourceRef="Task_InstructArtist" targetRef="Gateway_Satisfied">
      <bpmn:name>Awaiting Feedback</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Sequence Flow for Yes -->
    <bpmn:sequenceFlow id="SequenceFlow_YesToColor" sourceRef="Gateway_Satisfied" targetRef="Task_ChooseColor">
      <bpmn:name>Satisfied</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Sequence Flow for No -->
    <bpmn:sequenceFlow id="SequenceFlow_NoFeedback" sourceRef="Gateway_Satisfied" targetRef="Task_RequestChanges">
      <bpmn:name>No Changes Needed?</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Loop Back Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_FeedbackToInstruct" sourceRef="Task_RequestChanges" targetRef="Gateway_Satisfied">
      <bpmn:name>Send Feedback</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Sequence Flow to Stock Check -->
    <bpmn:sequenceFlow id="SequenceFlow_ToStockCheck" sourceRef="Task_ChooseColor" targetRef="Gateway_HavePlastic">
      <bpmn:name>Select Color</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Sequence Flow Order Path -->
    <bpmn:sequenceFlow id="SequenceFlow_OrderPath" sourceRef="Gateway_HavePlastic" targetRef="Task_OrderPlastic">
      <bpmn:name>No</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Sequence Flow Check Path -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckAmountPath" sourceRef="Gateway_HavePlastic" targetRef="Task_CheckAmount">
      <bpmn:name>Yes</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Sequence Flow Converge Stock Ready -->
    <bpmn:sequenceFlow id="SequenceFlow_ConvergeStockReady" sourceRef="Task_OrderPlastic" targetRef="ParallelGateway_PrintPrep">
      <bpmn:name>Order Complete</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Sequence Flow Add List Path -->
    <bpmn:sequenceFlow id="SequenceFlow_AddToListPath" sourceRef="Gateway_Under100" targetRef="Task_AddToShoppingList">
      <bpmn:name>Yes</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Sequence Flow Sufficient Path -->
    <bpmn:sequenceFlow id="SequenceFlow_SufficientPath" sourceRef="Gateway_Under100" targetRef="ParallelGateway_PrintPrep">
      <bpmn:name>No</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Sequence Flow Heat Path -->
    <bpmn:sequenceFlow id="SequenceFlow_HeatPrinterPath" sourceRef="ParallelGateway_PrintPrep" targetRef="Task_HeatPrinter">
      <bpmn:name>Start Heating</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Sequence Flow GCode Path -->
    <bpmn:sequenceFlow id="SequenceFlow_GCodeGenPath" sourceRef="ParallelGateway_PrintPrep" targetRef="Task_GenerateGCode">
      <bpmn:name>Create File</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Sequence Flow Converge Print Start -->
    <bpmn:sequenceFlow id="SequenceFlow_ConvergePrintStart" sourceRef="Task_HeatPrinter" targetRef="ParallelGateway_PrintReady">
      <bpmn:name>Heating Done</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Sequence Flow Converge Print Start 2 -->
    <bpmn:sequenceFlow id="SequenceFlow_ConvergePrintStart2" sourceRef="Task_GenerateGCode" targetRef="ParallelGateway_PrintReady">
      <bpmn:name>G-Code Ready</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Sequence Flow to End Event -->
    <bpmn:sequenceFlow id="SequenceFlow_ToEndEvent" sourceRef="Task_PrintModel" targetRef="EndEvent_1">
      <bpmn:name>Print Complete</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>