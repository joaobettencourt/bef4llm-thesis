<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1a8v7kx" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1s9j4wq">
    <bpmn:participant id="Participant_0h3c6f2" name="Maternity Leave Process" processRef="Process_1x5m8vz" />
  </bpmn:collaboration>

  <bpmn:process id="Process_1x5m8vz" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_0k7f2h6" name="Parent Initiates Leave Planning">
      <bpmn:outgoing>SequenceFlow_3t9j4w1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Fetch Information Task -->
    <bpmn:userTask id="Task_2m8k5p7" name="Fetch Leave Model Options">
      <bpmn:description>Show duration months, split between parents</bpmn:description>
      <bpmn:incoming>SequenceFlow_3t9j4w1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6h2f8k4</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parent Selection -->
    <bpmn:userTask id="Task_5w9j3t1" name="Select Leave Model">
      <bpmn:description>Parent chooses preferred model</bpmn:description>
      <bpmn:incoming>SequenceFlow_6h2f8k4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1p7m5g9</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Decision Gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_4k8h2j6" name="Selection Confirmed?">
      <bpmn:description>Confirm parent selection is valid</bpmn:description>
      <bpmn:incoming>SequenceFlow_1p7m5g9</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_8f3w6t2</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Collect Information -->
    <bpmn:userTask id="Task_7g5k9m1" name="Collect Parent Information">
      <bpmn:description>Gather required personal details</bpmn:description>
      <bpmn:incoming>SequenceFlow_8f3w6t2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_9h4j7p5</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Notify Authorities -->
    <bpmn:serviceTask id="ServiceTask_3f8m2k6" name="Notify Social Security">
      <bpmn:description>Send notification in time before leave</bpmn:description>
      <bpmn:incoming>SequenceFlow_9h4j7p5</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2k6f8w3</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Notify Company -->
    <bpmn:userTask id="Task_9p4h7m5" name="Notify Employer">
      <bpmn:description>Inform company about leave dates</bpmn:description>
      <bpmn:incoming>SequenceFlow_2k6f8w3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5t9j4h1</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gather Company Information -->
    <bpmn:serviceTask id="ServiceTask_6k2m8f7" name="Gather Employer Data">
      <bpmn:description>Collect company leave policy information</bpmn:description>
      <bpmn:incoming>SequenceFlow_5t9j4h1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_7w3k6p2</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- End of Period Decision -->
    <bpmn:userTask id="Task_1h8f5m9" name="Decide on Extension">
      <bpmn:description>At end of period, parent decides about extension</bpmn:description>
      <bpmn:incoming>SequenceFlow_7w3k6p2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4m9j8t5</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Extension Decision Gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_2f7k6h3" name="Extend Leave?">
      <bpmn:description>Determine if leave should be extended</bpmn:description>
      <bpmn:incoming>SequenceFlow_4m9j8t5</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6p3h9k1</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Extension Processing -->
    <bpmn:userTask id="Task_8m5j2f4" name="Process Leave Extension">
      <bpmn:description>Handle extended leave period</bpmn:description>
      <bpmn:incoming>SequenceFlow_6p3h9k1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3w7f5m8</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_0k9h4p6" name="Leave Processed">
      <bpmn:description>Normal completion of leave process</bpmn:description>
      <bpmn:incoming>SequenceFlow_3w7f5m8</bpmn:incoming>
    </bpmn:endEvent>

    <!-- No Extension Path -->
    <bpmn:endEvent id="EndEvent_1j6k2h9" name="Leave Completed">
      <bpmn:description>No extension, process ends here</bpmn:description>
      <bpmn:incoming>SequenceFlow_5f8w3p7</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_3t9j4w1" sourceRef="StartEvent_0k7f2h6" targetRef="Task_2m8k5p7">
      <bpmn:name>Initiate Planning</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_6h2f8k4" sourceRef="Task_2m8k5p7" targetRef="Task_5w9j3t1">
      <bpmn:name>Show Options</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_1p7m5g9" sourceRef="Task_5w9j3t1" targetRef="ExclusiveGateway_4k8h2j6">
      <bpmn:name>Select Model</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_8f3w6t2" sourceRef="ExclusiveGateway_4k8h2j6" targetRef="Task_7g5k9m1">
      <bpmn:name>Yes</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_9h4j7p5" sourceRef="Task_7g5k9m1" targetRef="ServiceTask_3f8m2k6">
      <bpmn:name>Collect Data</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_2k6f8w3" sourceRef="ServiceTask_3f8m2k6" targetRef="Task_9p4h7m5">
      <bpmn:name>Social Security Notified</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_5t9j4h1" sourceRef="Task_9p4h7m5" targetRef="ServiceTask_6k2m8f7">
      <bpmn:name>Employer Notified</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_7w3k6p2" sourceRef="ServiceTask_6k2m8f7" targetRef="Task_1h8f5m9">
      <bpmn:name>Gather Data Complete</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_4m9j8t5" sourceRef="Task_1h8f5m9" targetRef="ExclusiveGateway_2f7k6h3">
      <bpmn:name>Period Ended</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_6p3h9k1" sourceRef="ExclusiveGateway_2f7k6h3" targetRef="Task_8m5j2f4">
      <bpmn:name>Yes</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_3w7f5m8" sourceRef="Task_8m5j2f4" targetRef="EndEvent_0k9h4p6">
      <bpmn:name>Extension Processed</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_5f8w3p7" sourceRef="ExclusiveGateway_2f7k6h3" targetRef="EndEvent_1j6k2h9">
      <bpmn:name>No</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>

  <!-- Data Objects -->
  <bpmn:dataObject id="DataObject_LeaveModel" name="Leave Model Information" />
  <bpmn:dataObject id="DataObject_ParentInfo" name="Parent Personal Details" />
  <bpmn:dataObject id="DataObject_CompanyPolicy" name="Employer Leave Policy Data" />

</bpmn:definitions>