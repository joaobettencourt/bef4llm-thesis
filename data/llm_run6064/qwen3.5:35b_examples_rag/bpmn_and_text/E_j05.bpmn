<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1a8v7kx" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_WorkLiveAustria">
    <bpmn:participant id="Participant_EGovernment" name="Work and Live in Austria Process" processRef="Process_VisaApplication"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_VisaApplication" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="Start_CheckRequirements" name="Check Requirements for Work &amp; Live in Austria">
      <bpmn:outgoing>SequenceFlow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Parallel Gateway - Accommodation and Bank Account -->
    <bpmn:parallelGateway id="Parallel_AccomBank" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_02</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_03</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Accommodation Task -->
    <bpmn:userTask id="Task_OrganizeAccommodation" name="Organize Accommodation">
      <bpmn:incoming>SequenceFlow_02</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_15</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Bank Account Task -->
    <bpmn:userTask id="Task_OrganizeBankAccount" name="Negotiate &amp; Open Bank Account">
      <bpmn:incoming>SequenceFlow_03</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_16</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel Gateway - Document Preparation -->
    <bpmn:parallelGateway id="Parallel_Documents" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow_04</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_05</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_06</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_07</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Visa Application Form Task -->
    <bpmn:userTask id="Task_VisaApplicationForm" name="Complete Visa Application Form">
      <bpmn:incoming>SequenceFlow_05</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_17</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Passport Task -->
    <bpmn:userTask id="Task_PassportCheck" name="Verify Valid Travel Document">
      <bpmn:incoming>SequenceFlow_06</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_18</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Photo Task -->
    <bpmn:userTask id="Task_PassportPhoto" name="Prepare Passport Photo (35x45mm)">
      <bpmn:incoming>SequenceFlow_07</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_19</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Insurance Task -->
    <bpmn:userTask id="Task_TravelInsurance" name="Obtain Travel Health Insurance (€30,000)">
      <bpmn:incoming>SequenceFlow_14</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_20</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Means of Subsistence Task -->
    <bpmn:userTask id="Task_ProofMeans" name="Prepare Proof of Sufficient Means">
      <bpmn:incoming>SequenceFlow_14</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_20</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Other Evidence Task -->
    <bpmn:userTask id="Task_OtherEvidence" name="Gather Additional Required Documents">
      <bpmn:incoming>SequenceFlow_14</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_20</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Visa Type Decision Gateway -->
    <bpmn:exclusiveGateway id="Gateway_VisaType" name="Determine Visa Type">
      <bpmn:incoming>SequenceFlow_13</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_21</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_22</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Schengen Visa Task -->
    <bpmn:userTask id="Task_SchengenVisa" name="Apply for Schengen Visa (Type C)">
      <bpmn:incoming>SequenceFlow_21</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_30</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Type D Visa Task -->
    <bpmn:userTask id="Task_TypeDVisa" name="Apply for National Visa (Type D)">
      <bpmn:incoming>SequenceFlow_22</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_31</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Rot-Weiss-Rot Card Task -->
    <bpmn:userTask id="Task_RWRCard" name="Apply for Red-White-Red Card">
      <bpmn:incoming>SequenceFlow_23</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_31</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Visa Validity Check Gateway -->
    <bpmn:exclusiveGateway id="Gateway_VisaValidity" name="Visa Valid?">
      <bpmn:incoming>SequenceFlow_24</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_30</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Representation Office Selection -->
    <bpmn:userTask id="Task_FindRepresentation" name="Find Competent Austrian Representation">
      <bpmn:incoming>SequenceFlow_25</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_30</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Visa Application Submission -->
    <bpmn:userTask id="Task_SubmitApplication" name="Submit Complete Application">
      <bpmn:incoming>SequenceFlow_26</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_30</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Visa Decision Gateway -->
    <bpmn:exclusiveGateway id="Gateway_VisaDecision" name="Visa Approved?">
      <bpmn:incoming>SequenceFlow_27</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_30</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Visa Renewal Task -->
    <bpmn:userTask id="Task_VisaRenewal" name="Apply for Visa Extension">
      <bpmn:incoming>SequenceFlow_28</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_31</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event - Success -->
    <bpmn:endEvent id="End_Success" name="Visa Approved &amp; Ready to Work/Live">
      <bpmn:incoming>SequenceFlow_30</bpmn:incoming>
    </bpmn:endEvent>

    <!-- End Event - Rejected -->
    <bpmn:endEvent id="End_Rejected" name="Visa Application Rejected">
      <bpmn:incoming>SequenceFlow_31</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_01" sourceRef="Start_CheckRequirements" targetRef="Parallel_AccomBank">
      <bpmn:name>Main Process Start</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Accommodation Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_02" sourceRef="Parallel_AccomBank" targetRef="Task_OrganizeAccommodation">
      <bpmn:name>Organize Housing</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Bank Account Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_03" sourceRef="Parallel_AccomBank" targetRef="Task_OrganizeBankAccount">
      <bpmn:name>Negotiate Banking</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Document Preparation Start -->
    <bpmn:sequenceFlow id="SequenceFlow_04" sourceRef="Parallel_AccomBank" targetRef="Parallel_Documents">
      <bpmn:name>Prepare Documents</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Document Tasks -->
    <bpmn:sequenceFlow id="SequenceFlow_05" sourceRef="Parallel_Documents" targetRef="Task_VisaApplicationForm">
      <bpmn:name>Complete Form</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_06" sourceRef="Parallel_Documents" targetRef="Task_PassportCheck">
      <bpmn:name>Verify Passport</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_07" sourceRef="Parallel_Documents" targetRef="Task_PassportPhoto">
      <bpmn:name>Prepare Photo</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Document Convergence -->
    <bpmn:parallelGateway id="Parallel_ConvergeDocs" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow_17</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_18</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_19</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_04</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Insurance and Evidence -->
    <bpmn:sequenceFlow id="SequenceFlow_14" sourceRef="Parallel_ConvergeDocs" targetRef="Task_TravelInsurance">
      <bpmn:name>Gather Additional Docs</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Document Convergence 2 -->
    <bpmn:parallelGateway id="Parallel_ConvergeAll" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow_15</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_16</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_20</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_13</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Visa Type Determination -->
    <bpmn:sequenceFlow id="SequenceFlow_13" sourceRef="Parallel_ConvergeAll" targetRef="Gateway_VisaType">
      <bpmn:name>Determine Eligibility</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Visa Type Decision -->
    <bpmn:sequenceFlow id="SequenceFlow_21" sourceRef="Gateway_VisaType" targetRef="Task_SchengenVisa">
      <bpmn:name>Schengen (Short Stay)</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_22" sourceRef="Gateway_VisaType" targetRef="Task_TypeDVisa">
      <bpmn:name>National Visa</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- RWR Card Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_23" sourceRef="Gateway_VisaType" targetRef="Task_RWRCard">
      <bpmn:name>Work Visa (RWR)</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Validity Check -->
    <bpmn:sequenceFlow id="SequenceFlow_24" sourceRef="Parallel_ConvergeAll" targetRef="Gateway_VisaValidity">
      <bpmn:name>Check Visa Type</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Representation Office -->
    <bpmn:sequenceFlow id="SequenceFlow_25" sourceRef="Parallel_ConvergeAll" targetRef="Task_FindRepresentation">
      <bpmn:name>Determine Competence</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Application Submission -->
    <bpmn:sequenceFlow id="SequenceFlow_26" sourceRef="Parallel_ConvergeAll" targetRef="Task_SubmitApplication">
      <bpmn:name>Submit to Authority</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Visa Decision -->
    <bpmn:sequenceFlow id="SequenceFlow_27" sourceRef="Parallel_ConvergeAll" targetRef="Gateway_VisaDecision">
      <bpmn:name>Awaiting Decision</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Visa Renewal -->
    <bpmn:sequenceFlow id="SequenceFlow_28" sourceRef="Parallel_ConvergeAll" targetRef="Task_VisaRenewal">
      <bpmn:name>Extension Required</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Success Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_30" sourceRef="Gateway_VisaDecision" targetRef="End_Success">
      <bpmn:name>Approved - Proceed to Work/Live</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Rejection Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_31" sourceRef="Gateway_VisaDecision" targetRef="End_Rejected">
      <bpmn:name>Rejected - Process Ends</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>

  <!-- Data Objects -->
  <bpmn:dataObject id="Data_VisaApplication" name="Visa Application Form"/>
  <bpmn:dataObject id="Data_Passport" name="Valid Travel Document"/>
  <bpmn:dataObject id="Data_Photo" name="Passport Photo (35x45mm)"/>
  <bpmn:dataObject id="Data_Insurance" name="Travel Health Insurance Policy"/>
  <bpmn:dataObject id="Data_MeansProof" name="Proof of Sufficient Means"/>
  <bpmn:dataObject id="Data_AdditionalDocs" name="Additional Required Documents"/>

</bpmn:definitions>