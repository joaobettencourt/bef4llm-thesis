<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1a8v7kx" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1a8v7kx">
    <bpmn:participant id="Participant_RobotBurgerSeller" name="Robotic Burger Seller Process" processRef="Process_BurgerPreparation"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_BurgerPreparation" isExecutable="false">
    <!-- Lane for the robotic system -->
    <bpmn:laneSet>
      <bpmn:lane id="Lane_RobotSystem" name="Robotic System">
        <bpmn:flowNodeRef>StartEvent_OrderReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MenuDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareDrink</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_FriesWedgesChoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareFries</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareWedges</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PrepConvergence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TimerEvent_StatusUpdate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareBurger</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_BurgerComplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_OrderDelivered</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_OrderReceived" name="Order Received">
      <bpmn:outgoing>SequenceFlow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Menu Decision Gateway -->
    <bpmn:exclusiveGateway id="Gateway_MenuDecision" name="Menu or Just Burger?">
      <bpmn:incoming>SequenceFlow_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Menupath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_BurgerOnlyPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Menu Path - Parallel Preparation -->
    <bpmn:parallelGateway id="Parallel_GoMenu" name="">
      <bpmn:incoming>SequenceFlow_Menupath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DrinkPrep</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_FriesWedgesChoicePath</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Just Burger Path -->
    <bpmn:sequenceFlow id="SequenceFlow_BurgerOnlyPath" sourceRef="Gateway_MenuDecision" targetRef="Task_PrepareBurger">
      <bpmn:name>Just Burger</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Drink Preparation Task -->
    <bpmn:task id="Task_PrepareDrink" name="Prepare Drink (Variable Time)">
      <bpmn:incoming>SequenceFlow_DrinkPrep</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_02</bpmn:outgoing>
    </bpmn:task>

    <!-- Fries/Wedges Choice Gateway -->
    <bpmn:exclusiveGateway id="Gateway_FriesWedgesChoice" name="Fries or Wedges?">
      <bpmn:incoming>SequenceFlow_FriesWedgesChoicePath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PrepareFries</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PrepareWedges</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Fries Preparation Task -->
    <bpmn:task id="Task_PrepareFries" name="Prepare Fries (Variable Time)">
      <bpmn:incoming>SequenceFlow_PrepareFries</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_03</bpmn:outgoing>
    </bpmn:task>

    <!-- Wedges Preparation Task -->
    <bpmn:task id="Task_PrepareWedges" name="Prepare Wedges (Variable Time)">
      <bpmn:incoming>SequenceFlow_PrepareWedges</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_04</bpmn:outgoing>
    </bpmn:task>

    <!-- Convergence Gateway for Menu Path -->
    <bpmn:parallelGateway id="Parallel_MenupathConverge" name="">
      <bpmn:incoming>SequenceFlow_02</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_03</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_04</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToBurgerPrep</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Burger Preparation Task -->
    <bpmn:task id="Task_PrepareBurger" name="Prepare Burger (Variable Time)">
      <bpmn:incoming>SequenceFlow_ToBurgerPrep</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_05</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Catching Timer for Status Updates -->
    <bpmn:intermediateCatchEvent id="TimerEvent_StatusUpdate" name="Status Update Every 30s">
      <bpmn:timerDuration>P30S</bpmn:timerDuration>
      <bpmn:incoming>SequenceFlow_05</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TimerLoop</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Timer Loop Back to Burger Prep -->
    <bpmn:sequenceFlow id="SequenceFlow_TimerLoop" sourceRef="TimerEvent_StatusUpdate" targetRef="Task_PrepareBurger">
      <bpmn:name>Status Update</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Final Convergence Gateway -->
    <bpmn:parallelGateway id="Parallel_BurgerComplete" name="">
      <bpmn:incoming>SequenceFlow_05</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToDelivery</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_OrderDelivered" name="Order Delivered">
      <bpmn:incoming>SequenceFlow_ToDelivery</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows for Menu Path -->
    <bpmn:sequenceFlow id="SequenceFlow_01" sourceRef="StartEvent_OrderReceived" targetRef="Gateway_MenuDecision">
      <bpmn:name>Begin Process</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Sequence Flow for Menu Path -->
    <bpmn:sequenceFlow id="SequenceFlow_Menupath" sourceRef="Gateway_MenuDecision" targetRef="Parallel_GoMenu">
      <bpmn:name>Yes</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Sequence Flow for Drink Preparation -->
    <bpmn:sequenceFlow id="SequenceFlow_DrinkPrep" sourceRef="Parallel_GoMenu" targetRef="Task_PrepareDrink">
      <bpmn:name>Start Prep</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Sequence Flow for Fries/Wedges Choice -->
    <bpmn:sequenceFlow id="SequenceFlow_FriesWedgesChoicePath" sourceRef="Parallel_GoMenu" targetRef="Gateway_FriesWedgesChoice">
      <bpmn:name>Ask Side</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Sequence Flow for Fries Preparation -->
    <bpmn:sequenceFlow id="SequenceFlow_PrepareFries" sourceRef="Gateway_FriesWedgesChoice" targetRef="Task_PrepareFries">
      <bpmn:name>Fries</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Sequence Flow for Wedges Preparation -->
    <bpmn:sequenceFlow id="SequenceFlow_PrepareWedges" sourceRef="Gateway_FriesWedgesChoice" targetRef="Task_PrepareWedges">
      <bpmn:name>Wedges</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Sequence Flow from Drink Prep to Convergence -->
    <bpmn:sequenceFlow id="SequenceFlow_02" sourceRef="Task_PrepareDrink" targetRef="Parallel_MenupathConverge">
      <bpmn:name>Complete</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Sequence Flow from Fries Prep to Convergence -->
    <bpmn:sequenceFlow id="SequenceFlow_03" sourceRef="Task_PrepareFries" targetRef="Parallel_MenupathConverge">
      <bpmn:name>Complete</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Sequence Flow from Wedges Prep to Convergence -->
    <bpmn:sequenceFlow id="SequenceFlow_04" sourceRef="Task_PrepareWedges" targetRef="Parallel_MenupathConverge">
      <bpmn:name>Complete</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Sequence Flow to Burger Preparation -->
    <bpmn:sequenceFlow id="SequenceFlow_ToBurgerPrep" sourceRef="Parallel_MenupathConverge" targetRef="Task_PrepareBurger">
      <bpmn:name>All Ready</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Sequence Flow from Burger Prep to Timer -->
    <bpmn:sequenceFlow id="SequenceFlow_05" sourceRef="Task_PrepareBurger" targetRef="TimerEvent_StatusUpdate">
      <bpmn:name>Burger Started</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Sequence Flow to Delivery -->
    <bpmn:sequenceFlow id="SequenceFlow_ToDelivery" sourceRef="Parallel_BurgerComplete" targetRef="EndEvent_OrderDelivered">
      <bpmn:name>Ready for Conveyor</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>

  <!-- Data Objects -->
  <bpmn:dataObject id="DataOrderInfo" name="Customer Order Information"/>
  
  <!-- Associations -->
  <bpmn:association associationDirection="OneWay">
    <bpmn:startEventRef>StartEvent_OrderReceived</bpmn:startEventRef>
    <bpmn:dataInputSet>DataOrderInfo</bpmn:dataInputSet>
  </bpmn:association>

</bpmn:definitions>