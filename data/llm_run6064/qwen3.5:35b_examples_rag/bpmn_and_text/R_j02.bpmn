<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1a8v7kx" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_inspection_process">
    <bpmn:participant id="Participant_machine_inspection" name="Machine Inspection Process" processRef="Process_1s9j4wq"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1s9j4wq" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_machine_info" name="Enter Machine Info">
      <bpmn:outgoing>SequenceFlow_start_to_collection</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Service Task: Collect data from machine automatically -->
    <bpmn:serviceTask id="ServiceTask_collect_data" name="Collect Data Automatically">
      <bpmn:incoming>SequenceFlow_start_to_collection</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_collection_to_display</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- User Task: Display collected values to user -->
    <bpmn:userTask id="UserTask_show_values" name="Show Values to Operator">
      <bpmn:incoming>SequenceFlow_collection_to_display</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_display_to_decision</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Exclusive Gateway: Check if additional questions needed -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_additional_questions" name="Additional Questions Needed?">
      <bpmn:incoming>SequenceFlow_display_to_decision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_yes_questions</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_no_proceed</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- User Task: Ask additional questions -->
    <bpmn:userTask id="UserTask_ask_questions" name="Ask Additional Questions">
      <bpmn:incoming>SequenceFlow_yes_questions</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_answers_to_decision2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Second Exclusive Gateway for further decisions -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_more_questions" name="More Questions?">
      <bpmn:incoming>SequenceFlow_answers_to_decision2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_yes_continue</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_no_complete</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- User Task for additional questioning loop -->
    <bpmn:userTask id="UserTask_more_questions" name="Continue Questioning">
      <bpmn:incoming>SequenceFlow_yes_continue</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_answers_to_decision3</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_inspection_done" name="Inspection Complete">
      <bpmn:incoming>SequenceFlow_no_proceed</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_answers_to_decision3</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_start_to_collection" sourceRef="StartEvent_machine_info" targetRef="ServiceTask_collect_data"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_collection_to_display" name="Data Collected" sourceRef="ServiceTask_collect_data" targetRef="UserTask_show_values"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_display_to_decision" name="Values Shown" sourceRef="UserTask_show_values" targetRef="ExclusiveGateway_additional_questions"/>
    
    <!-- Yes branch - Additional questions needed -->
    <bpmn:sequenceFlow id="SequenceFlow_yes_questions" name="Yes" sourceRef="ExclusiveGateway_additional_questions" targetRef="UserTask_ask_questions">
      <bpmn:name>Additional Questions</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- No branch - Proceed to completion -->
    <bpmn:sequenceFlow id="SequenceFlow_no_proceed" name="No" sourceRef="ExclusiveGateway_additional_questions" targetRef="EndEvent_inspection_done">
      <bpmn:name>No Additional Questions</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- More questions loop -->
    <bpmn:sequenceFlow id="SequenceFlow_answers_to_decision2" name="Answers Provided" sourceRef="UserTask_ask_questions" targetRef="ExclusiveGateway_more_questions"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_yes_continue" name="Yes, Continue" sourceRef="ExclusiveGateway_more_questions" targetRef="UserTask_more_questions">
      <bpmn:name>More Questions</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_no_complete" name="No More" sourceRef="ExclusiveGateway_more_questions" targetRef="EndEvent_inspection_done">
      <bpmn:name>No Additional Questions</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Loop back for additional questioning -->
    <bpmn:sequenceFlow id="SequenceFlow_answers_to_decision3" name="Continue?" sourceRef="UserTask_more_questions" targetRef="EndEvent_inspection_done"/>

  </bpmn:process>

  <!-- Data Objects -->
  <bpmn:dataObject id="DataObject_MachineResults" name="Machine Inspection Results">
    <bpmn:name>MACHINE_RESULTS</bpmn:name>
  </bpmn:dataObject>

  <!-- Associations for data flow -->
  <bpmn:association associationDirection="OneWay" id="Association_data_to_task1">
    <bpmn:startEventRef>StartEvent_machine_info</bpmn:startEventRef>
    <bpmn:dataInputSet>DataObject_MachineResults</bpmn:dataInputSet>
  </bpmn:association>

  <!-- Reusable Elements -->
  <bpmn:message id="Message_InspectionComplete" name="Inspection Complete Message"/>
  
  <bpmn:signal id="Signal_QuestionNeeded" name="Question Needed Signal"/>

</bpmn:definitions>