<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1a8v7kx" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1s9j4wq">
    <bpmn:participant id="Participant_0h3c6f2" name="Blizzard Online Character Generator Process" processRef="Process_1a8v7kx" />
  </bpmn:collaboration>

  <bpmn:process id="Process_1a8v7kx" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_0x2m8vz" name="Create WoW Character">
      <bpmn:outgoing>SequenceFlow_3k7f5h6</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Parallel Gateway for concurrent activities -->
    <bpmn:parallelGateway id="ParallelGateway_2l7k9s5" name="Start Activities">
      <bpmn:incoming>SequenceFlow_3k7f5h6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1q4h8w7</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_5r9m2v6</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Account Setup Flow -->
    <bpmn:userTask id="Task_4g9w1p2" name="Check battle.net account">
      <bpmn:incoming>SequenceFlow_5r9m2v6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_8t6j3x4</bpmn:outgoing>
    </bpmn:userTask>

    <!-- No account - create one -->
    <bpmn:userTask id="Task_3a7f1h8" name="Enter account information">
      <bpmn:incoming>SequenceFlow_2f8k5t6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4g9w1p2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Receive confirmation mail -->
    <bpmn:messageEvent id="MessageEvent_5r8k3t6" name="Receive confirmation mail">
      <bpmn:incoming>SequenceFlow_4g9w1p2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6j9w4k2</bpmn:outgoing>
    </bpmn:messageEvent>

    <!-- Click link in mail -->
    <bpmn:userTask id="Task_7m2f6k8" name="Click confirmation link">
      <bpmn:incoming>SequenceFlow_6j9w4k2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1x5t9h4</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Subscription Check -->
    <bpmn:userTask id="Task_6j9w4k2" name="Check WoW subscription">
      <bpmn:incoming>SequenceFlow_1x5t9h4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3s6v8q1</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Character Creation -->
    <bpmn:userTask id="Task_0x3m7k9" name="Log into game">
      <bpmn:incoming>SequenceFlow_4s5v8q1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6h2j5p8</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Select Character Options -->
    <bpmn:userTask id="Task_4f9k7m3" name="Select realm, race and class">
      <bpmn:incoming>SequenceFlow_6h2j5p8</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1s8v6q4</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Name Selection Loop -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_5j7k2p9" name="Name available?">
      <bpmn:incoming>SequenceFlow_1s8v6q4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3t9w6h5</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Enter name -->
    <bpmn:userTask id="Task_8m4k7p2" name="Enter character name">
      <bpmn:incoming>SequenceFlow_3t9w6h5</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1s8v6q4</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Confirmation -->
    <bpmn:endEvent id="EndEvent_2k7g5p9" name="Character Created">
      <bpmn:incoming>SequenceFlow_1s8v6q4</bpmn:outgoing>
    </bpmn:endEvent>

    <!-- Character Naming Flow -->
    <bpmn:userTask id="Task_7m2f6k9" name="Come up with character names">
      <bpmn:incoming>SequenceFlow_1q4h8w7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5r9m2v6</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Account Check -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_1q7k9s5" name="Have battle.net account?">
      <bpmn:incoming>SequenceFlow_8t6j3x4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2f8k5t6</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_7w4t2m1</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Subscription Decision -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_2f4k8j5" name="Active subscription?">
      <bpmn:incoming>SequenceFlow_3s6v8q1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_9g7h2m8</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- No subscription - payment -->
    <bpmn:userTask id="Task_1f3r7p6" name="Select payment method">
      <bpmn:incoming>SequenceFlow_9g7h2m8</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4s5v8q1</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Payment Method Decision -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_3h6k9j2" name="Payment method?">
      <bpmn:incoming>SequenceFlow_4s5v8q1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_7t8w5p3</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Credit Card -->
    <bpmn:userTask id="Task_2k4m6h9" name="Enter credit card information">
      <bpmn:incoming>SequenceFlow_7t8w5p3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1q5j8v4</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Bank Account -->
    <bpmn:userTask id="Task_9p7k3m2" name="Enter IBAN and BIC numbers">
      <bpmn:incoming>SequenceFlow_5r6t8w1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4s5v8q1</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_3k7f5h6" sourceRef="StartEvent_0x2m8vz" targetRef="ParallelGateway_2l7k9s5">
      <bpmn:name>Begin Character Creation</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Parallel Flow 1 - Account Setup -->
    <bpmn:sequenceFlow id="SequenceFlow_5r9m2v6" sourceRef="ParallelGateway_2l7k9s5" targetRef="Task_4g9w1p2">
      <bpmn:name>Setup Account</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Parallel Flow 2 - Character Naming -->
    <bpmn:sequenceFlow id="SequenceFlow_1q4h8w7" sourceRef="ParallelGateway_2l7k9s5" targetRef="Task_7m2f6k9">
      <bpmn:name>Prepare Names</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Account Check Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_8t6j3x4" sourceRef="Task_4g9w1p2" targetRef="ExclusiveGateway_1q7k9s5">
      <bpmn:name>Check Status</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- No Account Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_2f8k5t6" sourceRef="ExclusiveGateway_1q7k9s5" targetRef="Task_3a7f1h8">
      <bpmn:name>No</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Already Have Account Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_7w4t2m1" sourceRef="ExclusiveGateway_1q7k9s5" targetRef="Task_6j9w4k2">
      <bpmn:name>Yes</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Enter Account Info Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_4g9w1p2" sourceRef="Task_3a7f1h8" targetRef="MessageEvent_5r8k3t6">
      <bpmn:name>Submit Information</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Confirmation Link Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_6j9w4k2" sourceRef="MessageEvent_5r8k3t6" targetRef="Task_7m2f6k8">
      <bpmn:name>Receive Mail</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Click Link Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_1x5t9h4" sourceRef="Task_7m2f6k8" targetRef="Task_6j9w4k2">
      <bpmn:name>Activate Account</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Subscription Check Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_3s6v8q1" sourceRef="Task_6j9w4k2" targetRef="ExclusiveGateway_2f4k8j5">
      <bpmn:name>Check Status</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- No Subscription Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_9g7h2m8" sourceRef="ExclusiveGateway_2f4k8j5" targetRef="Task_1f3r7p6">
      <bpmn:name>No</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Payment Method Selection Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_4s5v8q1" sourceRef="Task_1f3r7p6" targetRef="ExclusiveGateway_3h6k9j2">
      <bpmn:name>Select Method</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Credit Card Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_7t8w5p3" sourceRef="ExclusiveGateway_3h6k9j2" targetRef="Task_2k4m6h9">
      <bpmn:name>Credit Card</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Bank Account Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_5r6t8w1" sourceRef="ExclusiveGateway_3h6k9j2" targetRef="Task_9p7k3m2">
      <bpmn:name>Bank Transfer</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Payment Complete Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_1q5j8v4" sourceRef="Task_2k4m6h9" targetRef="Task_0x3m7k9">
      <bpmn:name>Paid</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Bank Payment Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_8w6t4p2" sourceRef="Task_9p7k3m2" targetRef="Task_0x3m7k9">
      <bpmn:name>Paid</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Log In Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_6h2j5p8" sourceRef="Task_0x3m7k9" targetRef="Task_4f9k7m3">
      <bpmn:name>Login</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Select Options Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_1s8v6q4" sourceRef="Task_4f9k7m3" targetRef="ExclusiveGateway_5j7k2p9">
      <bpmn:name>Select</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Name Available Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_3t9w6h5" sourceRef="ExclusiveGateway_5j7k2p9" targetRef="Task_8m4k7p2">
      <bpmn:name>No</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>

  <!-- Data Objects -->
  <bpmn:dataObject id="DataObject_Account" name="Account Information" />
  <bpmn:dataObject id="DataObject_Payment" name="Payment Details" />
  
</bpmn:definitions>