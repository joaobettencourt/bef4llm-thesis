<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_CreditProcess_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_CreditApproval">
    <bpmn:participant id="Participant_CreditCompany" name="Credit Company" processRef="Proc_CreditApproval_01" />
    <bpmn:participant id="Participant_Customer" name="Customer" />

    <!-- Message Flows -->
    <bpmn:messageFlow id="Msg_StartInfo" sourceRef="Participant_Customer" targetRef="StartEvent_NewCreditRequest" />
    <bpmn:messageFlow id="Msg_EndAcceptEmail" sourceRef="EndEvent_CreditAccepted" targetRef="Participant_Customer" />
    <bpmn:messageFlow id="Msg_EndRejectEmail" sourceRef="EndEvent_CreditRejected" targetRef="Participant_Customer" />
  </bpmn:collaboration>

  <bpmn:process id="Proc_CreditApproval_01" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_NewCreditRequest" name="Receive Credit Information">
      <bpmn:messageEventDefinition />
      <bpmn:outgoing>SF_CollectInfo</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task -->
    <bpmn:task id="Task_CreditCompanyCollect" name="Collect Credit Information">
      <bpmn:incoming>SF_CollectInfo</bpmn:incoming>
      <bpmn:outgoing>SF_AmountCheckGateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Amount Check -->
    <bpmn:exclusiveGateway id="GW_AmountCheck" name="Amount &gt; $1M?">
      <bpmn:incoming>SF_AmountCheckGateway</bpmn:outgoing>
      <bpmn:outgoing>SF_RequestApprovalHighAmt</bpmn:outgoing> <!-- Yes -->
      <bpmn:outgoing>SF_AssessRiskLowAmt</bpmn:outgoing>     <!-- No (<= $1M) -->
    </bpmn:exclusiveGateway>

    <!-- Task: Assess Risk -->
    <bpmn:task id="Task_AssessRisk" name="Assess Credit Risk">
      <bpmn:incoming>SF_AssessRiskLowAmt</bpmn:outgoing> 
       ... (Wait, I need to ensure all IDs are unique and referenced correctly in the final output)

  <!-- Finalizing XML content -->