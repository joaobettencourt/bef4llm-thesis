<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_RewardTraining_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_Rewards_Training">
    <bpmn:participant id="Participant_RewardsAndTraining" name="Rewards and training process" processRef="Process_RewardTraining_1" />
  </bpmn:collaboration>

  <bpmn:process id="Process_RewardTraining_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Management" name="Management">
        <bpmn:flowNodeRef>StartEvent_CheckPerformance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SuggestDismissal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SuggestTraining</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SuggestReward</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_PerformanceCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_RewardType</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ChooseBenefit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AnnounceEmployeeMonth</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_HR" name="HR">
        <bpmn:flowNodeRef>Task_DismissEmployee</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProvideTraining</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Finance" name="Finance">
        <bpmn:flowNodeRef>Task_CalculatePayReward</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_CheckPerformance" name="Check employee performance">
      <bpmn:outgoing>SF_PerformanceToGateway</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Main Decision Gateway for Performance Levels -->
    <bpmn:exclusiveGateway id="GW_PerformanceCheck" name="Performance Level?">
      <bpmn:incoming>SF_PerformanceToGateway</bpmn:incoming>
      <bpmn:outgoing>SF_DismissalPath</bpmn:outgoing>
      <bpmn:outgoing>SF_TrainingPath</bpmn:outgoing>
      <bpmn:outgoing>SF_RewardPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Dismissal Path -->
    <bpmn:task id="Task_SuggestDismissal" name="Suggest employee dismissal">
      <bpmn:incoming>SF_DismissalPath</bpmn:incoming>
      <bpmn:outgoing>SF_HRDismissAction</bpmn:outgoing>
    </bpmn:task>

    <!-- HR Dismiss Task -->
    <bpmn:task id="Task_DismissEmployee" name="Dismiss employee">
      <bpmn:incoming>SF_HRDismissAction</bpmn:incoming>
      <bpmn:outgoing>SF_EndDismissal</bpmn:outgoing>
    </bpmn:task>

    <!-- Training Path -->
    <bpmn:task id="Task_SuggestTraining" name="Suggest training">
      <bpmn:incoming>SF_TrainingPath</bpmn:incoming>
      <bpmn:outgoing>SF_HRTrainAction</bpmn:outgoing>
    </bpmn:task>

    <!-- HR Training Task -->
    <bpmn:task id="Task_ProvideTraining" name="Provide training">
      <bpmn:incoming>SF_HRTrainAction</bpmn:incoming>
      <bpmn:outgoing>SF_EndTrainingFlow</bpmn:outgoing>
    </bpmn:task>

    <!-- Reward Path -->
    <bpmn:task id="Task_SuggestReward" name="Suggest for reward">
      <bpmn:incoming>SF_RewardPath</bpmn:incoming>
      <bpmn:outgoing>SF_GatewayRewardTypeFlow</bpmn:outgoing>
    </bpmn:task>

    <!-- Reward Type Decision Gateway -->
    <bpmn:exclusiveGateway id="GW_RewardType" name="Reward Type?">
      <bpmn:incoming>SF_GatewayRewardTypeFlow</bpmn:incoming>
      <bpmn:outgoing>SF_FinancialPath</bpmn:outgoing>
      <bpmn:outgoing>SF_BenefitPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Financial Reward Path -->
    <bpmn:task id="Task_CalculatePayReward" name="Calculate and pay reward">
      <bpmn:incoming>SF_FinancialPath</bpmn:incoming>
      <bpmn:outgoing>SF_AnnounceEmployeeMonthFlow1</bpmn:outgoing>
    </bpmn:task>

    <!-- Other Benefit Path -->
    <bpmn:task id="Task_ChooseBenefit" name="Choose appropriate benefit">
      <bpmn:incoming>SF_BenefitPath</bpmn:incoming>
      <bpmn:outgoing>SF_AnnounceEmployeeMonthFlow2</bpmn:outgoing>
    </bpmn:task>

    <!-- Announcement Task -->
    <bpmn:task id="Task_AnnounceEmployeeMonth" name="Announce employee of the month">
      <bpmn:incoming>SF_AnnounceEmployeeMonthFlow1</bpmn:incoming>
      <bpmn:incoming>SF_AnnounceEmployeeMonthFlow2</bpmn:incoming>
      <bpmn:outgoing>SF_EndRewardProcess</bpmn:outgoing>
    </bpmn:task>

    <!-- End Events -->
    <bpmn:endEvent id="EndDismissal" name="Dismissed">
      <bpmn:incoming>SF_EndDismissal</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndTraining" name="Trained">
      <bpmn:incoming>SF_EndTrainingFlow</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndRewardProcess" name="Employee of the Month Announced">
      <bpmn:incoming>SF_EndRewardProcess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SF_PerformanceToGateway" sourceRef="StartEvent_CheckPerformance" targetRef="GW_PerformanceCheck" />
    
    <bpmn:sequenceFlow id="SF_DismissalPath" name="< 20%" sourceRef="GW_PerformanceCheck" targetRef="Task_SuggestDismissal" />
    <bpmn:sequenceFlow id="SF_HRDismissAction" sourceRef="Task_SuggestDismissal" targetRef="Task_DismissEmployee" />
    <bpmn:sequenceFlow id="SF_EndDismissal" name="" sourceRef="Task_DismissEmployee" targetRef="EndDismissal" />

    <bpmn:sequenceFlow id="SF_TrainingPath" name="20% - 50%" sourceRef="GW_PerformanceCheck" targetRef="Task_SuggestTraining" />
    <bpmn:sequenceFlow id="SF_HRTrainAction" sourceRef="Task_SuggestTraining" targetRef="Task_ProvideTraining" />
    <bpmn:sequenceFlow id="SF_EndTrainingFlow" name="" sourceRef="Task_ProvideTraining" targetRef="EndTraining" />

    <bpmn:sequenceFlow id="SF_RewardPath" name="> 75%" sourceRef="GW_PerformanceCheck" targetRef="Task_SuggestReward" />
    
    <bpmn:sequenceFlow id="SF_GatewayRewardTypeFlow" sourceRef="Task_SuggestReward" targetRef="GW_RewardType" />

    <bpmn:sequenceFlow id="SF_FinancialPath" name="Financial Reward" sourceRef="GW_RewardType" targetRef="Task_CalculatePayReward" />
    
    <bpmn:sequenceFlow id="SF_BenefitPath" name="Other Benefit" sourceRef="GW_RewardType" targetRef="Task_ChooseBenefit" />

    <!-- Merging paths for Announcement -->
    <bpmn:sequenceFlow id="SF_AnnounceEmployeeMonthFlow1" sourceRef="Task_CalculatePayReward" targetRef="Task_AnnounceEmployeeMonth" />
    <bpmn:sequenceFlow id="SF_BenefitToAnnouncement" name="" sourceRef="Task_ChooseBenefit" targetRef="Task_AnnounceEmployeeMonth" />

    <!-- Final End -->
    <bpmn:sequenceFlow id="SF_EndRewardProcess" sourceRef="Task_AnnounceEmployeeMonth" targetRef="EndRewardProcess" />

  </bpmn:process>
</bpmn:definitions>