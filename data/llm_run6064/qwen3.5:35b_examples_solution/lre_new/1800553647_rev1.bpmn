<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_06t62l5">
    <bpmn:participant id="Participant_036paz5" name="ACME Inc." processRef="Process_1" />
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Department" name="Department">
        <bpmn:flowNodeRef>StartEvent_Demand</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_StockCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UseFromStock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_LocalConsumption</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SpecifyDemand</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateRequisition</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Procurement" name="Central procurement department">
        <bpmn:flowNodeRef>GW_SupplierCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateSupplier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_MergeAfterSupplierCreation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateOrderTemplate</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Approver" name="Approver">
        <bpmn:flowNodeRef>Task_ApproveTriggerOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_PurchaseOrderCreated</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Demand" name="Demand identified">
      <bpmn:outgoing>SF_StartToStockCheck</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Stock Check Gateway (Department Lane) -->
    <bpmn:exclusiveGateway id="GW_StockCheck">
      <bpmn:incoming>SF_StartToStockCheck</bpmn:incoming>
      <bpmn:outgoing>SF_GoodsInStockPath</bpmn:outgoing>
      <bpmn:outgoing>SF_NoGoodsInStockPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Use goods from stock (Department Lane) -->
    <bpmn:task id="Task_UseFromStock" name="Use goods from stock">
      <bpmn:incoming>SF_GoodsInStockPath</bpmn:incoming>
      <bpmn:outgoing>SF_LocalConsumptionEnd</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event for local consumption (Department Lane) -->
    <bpmn:endEvent id="EndEvent_LocalConsumption" name="No further action required">
      <bpmn:incoming>SF_LocalConsumptionEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task: Specify and quantify demand (Department Lane) -->
    <bpmn:task id="Task_SpecifyDemand" name="Specify and quantify the demand">
      <bpmn:incoming>SF_NoGoodsInStockPath</bpmn:incoming>
      <bpmn:outgoing>SF_CreateRequisitionFlow</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Create purchase requisition (Department Lane) -->
    <bpmn:task id="Task_CreateRequisition" name="Create purchase requisition">
      <bpmn:incoming>SF_CreateRequisitionFlow</bpmn:incoming>
      <bpmn:outgoing>SF_RequisitionToProcurement</bpmn:outgoing>
    </bpmn:task>

    <!-- Supplier Check Gateway (Central procurement department Lane) -->
    <bpmn:exclusiveGateway id="GW_SupplierCheck">
      <bpmn:incoming>SF_CheckRequisitionFlow</bpmn:incoming>
      <bpmn:outgoing>SF_NewSupplierPath</bpmn:outgoing>
      <bpmn:outgoing>SF_KnownSupplierPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Create supplier in ERP (Central procurement department Lane) -->
    <bpmn:task id="Task_CreateSupplier" name="Create new supplier">
      <bpmn:incoming>SF_NewSupplierPath</bpmn:incoming>
      <bpmn:outgoing>SF_MergeAfterCreationFlow</bpmn:outgoing>
    </bpmn:task>

    <!-- Merge Gateway after supplier creation (Central procurement department Lane) -->
    <bpmn:exclusiveGateway id="GW_MergeAfterSupplierCreation">
      <bpmn:incoming>SF_KnownSupplierPath</bpmn:incoming>
      <bpmn:incoming>SF_MergeAfterCreationFlow</bpmn:incoming>
      <bpmn:outgoing>SF_CreateOrderTemplateFlow</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Create order template (Central procurement department Lane) -->
    <bpmn:task id="Task_CreateOrderTemplate" name="Create order template">
      <bpmn:incoming>SF_CreateOrderTemplateFlow</bpmn:incoming>
      <bpmn:outgoing>SF_OrderToApprover</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Approve and trigger order (Approver Lane) -->
    <bpmn:task id="Task_ApproveTriggerOrder" name="Approve &amp; trigger purchase order">
      <bpmn:incoming>SF_OrderToApprover</bpmn:incoming>
      <bpmn:outgoing>SF_FinalEndFlow</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event for Purchase Order Created (Approver Lane) -->
    <bpmn:endEvent id="EndEvent_PurchaseOrderCreated" name="Purchase order created">
      <bpmn:incoming>SF_FinalEndFlow</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SF_StartToStockCheck" sourceRef="StartEvent_Demand" targetRef="GW_StockCheck" />
    
    <bpmn:sequenceFlow id="SF_GoodsInStockPath" name="Goods in stock" sourceRef="GW_StockCheck" targetRef="Task_UseFromStock" />
    
    <bpmn:sequenceFlow id="SF_NoGoodsInStockPath" name="No goods in stock" sourceRef="GW_StockCheck" targetRef="Task_SpecifyDemand" />
    
    <bpmn:sequenceFlow id="SF_LocalConsumptionEnd" sourceRef="Task_UseFromStock" targetRef="EndEvent_LocalConsumption" />
    
    <bpmn:sequenceFlow id="SF_CreateRequisitionFlow" sourceRef="Task_SpecifyDemand" targetRef="Task_CreateRequisition" />
    
    <!-- Cross-lane flow from Department to Central procurement department -->
    <bpmn:sequenceFlow id="SF_RequisitionToProcurement" name="" sourceRef="Task_CreateRequisition" targetRef="GW_SupplierCheck">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- ERP System Check (Central procurement department Lane) -->
    <bpmn:dataStoreReference id="DataStore_ERP" name="ERP system">
      <bpmn:name>Data Store</bpmn:name>
    </bpmn:dataStoreReference>

    <bpmn:sequenceFlow id="SF_CheckRequisitionFlow" sourceRef="Task_CreateRequisition" targetRef="GW_SupplierCheck" />
    
    <!-- New Supplier Path -->
    <bpmn:sequenceFlow id="SF_NewSupplierPath" name="New supplier" sourceRef="GW_SupplierCheck" targetRef="Task_CreateSupplier">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${new_supplier}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Known Supplier Path -->
    <bpmn:sequenceFlow id="SF_KnownSupplierPath" name="Known supplier" sourceRef="GW_SupplierCheck" targetRef="GW_MergeAfterSupplierCreation">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${known_supplier}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Merge after Supplier Creation -->
    <bpmn:sequenceFlow id="SF_MergeAfterCreationFlow" sourceRef="Task_CreateSupplier" targetRef="GW_MergeAfterSupplierCreation">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Create Order Template -->
    <bpmn:sequenceFlow id="SF_CreateOrderTemplateFlow" sourceRef="GW_MergeAfterSupplierCreation" targetRef="Task_CreateOrderTemplate">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Order to Approver -->
    <bpmn:sequenceFlow id="SF_OrderToApprover" sourceRef="Task_CreateOrderTemplate" targetRef="Task_ApproveTriggerOrder">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Final End Flow -->
    <bpmn:sequenceFlow id="SF_FinalEndFlow" sourceRef="Task_ApproveTriggerOrder" targetRef="EndEvent_PurchaseOrderCreated">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>