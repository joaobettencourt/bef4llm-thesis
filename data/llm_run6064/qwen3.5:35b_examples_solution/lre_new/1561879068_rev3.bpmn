<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_CustomerRegistration_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_CustomerRegistration_01" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="Start_Event_NewOrder" name="Visitor fills out Registration-Form">
      <bpmn:outgoing>SequenceFlow_CheckProducts</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Check Product Availability Task -->
    <bpmn:task id="Task_CheckProductAvailability" name="Check availability of products">
      <bpmn:incoming>SequenceFlow_CheckProducts</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckCreditRating</bpmn:outgoing>
    </bpmn:task>

    <!-- Check Credit Rating Task -->
    <bpmn:task id="Task_CheckCreditRating" name="Check credit rating at Schufa">
      <bpmn:incoming>SequenceFlow_CheckCreditRating</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CreditGatewayDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Credit Rating Decision Gateway -->
    <bpmn:exclusiveGateway id="GW_CreditCheck" name="Credit Rating &gt; 9000?">
      <bpmn:incoming>SequenceFlow_CreditGatewayDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_UnsuccessfulRegistration</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CreateInterimRecord</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Unsuccessful Registration End Event -->
    <bpmn:endEvent id="End_Event_Unsuccessful" name="Unsuccessful customer registration">
      <bpmn:incoming>SequenceFlow_UnsuccessfulRegistration</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Create Interim Customer Dataset Record Task -->
    <bpmn:task id="Task_CreateInterimRecord" name="Create interim customer dataset record">
      <bpmn:incoming>SequenceFlow_CreateInterimRecord</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ParallelSplit</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway - Split -->
    <bpmn:parallelGateway id="GW_ParallelSplit" name="">
      <bpmn:incoming>SequenceFlow_ParallelSplit</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DeviceProvision</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RegisterCustomerAccount</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Device Provision Sub-Process -->
    <bpmn:subProcess id="Task_DeviceProvision" name="Device provision">
      <bpmn:incoming>SequenceFlow_DeviceProvision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ParallelJoin1</bpmn:outgoing>
    </bpmn:subProcess>

    <!-- Register Customer Account at ISP Nodes Sub-Process -->
    <bpmn:subProcess id="Task_RegisterCustomerAccount" name="Register customer account at ISP nodes">
      <bpmn:incoming>SequenceFlow_RegisterCustomerAccount</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ParallelJoin2</bpmn:outgoing>
    </bpmn:subProcess>

    <!-- Parallel Gateway - Join -->
    <bpmn:parallelGateway id="GW_ParallelJoin" name="">
      <bpmn:incoming>SequenceFlow_ParallelJoin1</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ParallelJoin2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WelcomePackage</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Create and Send Welcome Package Task -->
    <bpmn:task id="Task_CreateWelcomePackage" name="Create and send Welcome-Package">
      <bpmn:incoming>SequenceFlow_WelcomePackage</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SuccessfulRegistration</bpmn:outgoing>
    </bpmn:task>

    <!-- Successful Registration End Event -->
    <bpmn:endEvent id="End_Event_Successful" name="Successful customer registration">
      <bpmn:incoming>SequenceFlow_SuccessfulRegistration</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckProducts" sourceRef="Start_Event_NewOrder" targetRef="Task_CheckProductAvailability" />
    <bpmn:sequenceFlow id="SequenceFlow_CheckCreditRating" sourceRef="Task_CheckProductAvailability" targetRef="Task_CheckCreditRating" />
    <bpmn:sequenceFlow id="SequenceFlow_CreditGatewayDecision" sourceRef="Task_CheckCreditRating" targetRef="GW_CreditCheck" />
    <bpmn:sequenceFlow id="SequenceFlow_UnsuccessfulRegistration" name="Yes (credit &gt; 9000)" sourceRef="GW_CreditCheck" targetRef="End_Event_Unsuccessful" />
    <bpmn:sequenceFlow id="SequenceFlow_CreateInterimRecord" name="No (credit ≤ 9000)" sourceRef="GW_CreditCheck" targetRef="Task_CreateInterimRecord" />
    <bpmn:sequenceFlow id="SequenceFlow_ParallelSplit" sourceRef="Task_CreateInterimRecord" targetRef="GW_ParallelSplit" />
    <bpmn:sequenceFlow id="SequenceFlow_DeviceProvision" name="" sourceRef="GW_ParallelSplit" targetRef="Task_DeviceProvision" />
    <bpmn:sequenceFlow id="SequenceFlow_RegisterCustomerAccount" name="" sourceRef="GW_ParallelSplit" targetRef="Task_RegisterCustomerAccount" />
    <bpmn:sequenceFlow id="SequenceFlow_ParallelJoin1" sourceRef="Task_DeviceProvision" targetRef="GW_ParallelJoin" />
    <bpmn:sequenceFlow id="SequenceFlow_ParallelJoin2" sourceRef="Task_RegisterCustomerAccount" targetRef="GW_ParallelJoin" />
    <bpmn:sequenceFlow id="SequenceFlow_WelcomePackage" sourceRef="GW_ParallelJoin" targetRef="Task_CreateWelcomePackage" />
    <bpmn:sequenceFlow id="SequenceFlow_SuccessfulRegistration" sourceRef="Task_CreateWelcomePackage" targetRef="End_Event_Successful" />

  </bpmn:process>
</bpmn:definitions>