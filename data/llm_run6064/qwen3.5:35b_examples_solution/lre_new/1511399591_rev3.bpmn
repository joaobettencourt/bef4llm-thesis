<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_WebDevProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_AddFeedbackModule">
    <bpmn:participant id="Participant_ProcessOrder" name="Add customer feedback module to the website" processRef="Proc_OrderProcess_WebDev" />
  </bpmn:collaboration>

  <bpmn:process id="Proc_OrderProcess_WebDev" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_BusinessAnalyst" name="Business Analyst">
        <bpmn:flowNodeRef>StartEvent_NewOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AnalysisData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CatchEvent_DesignComplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_CheckDesignOK</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_WebDesigner" name="Web Designer">
        <bpmn:flowNodeRef>Task_IntegrateDesign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ChangeDesign</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_PHPHTMLCSS" name="PHP/HTML/CSS Specialist">
        <bpmn:flowNodeRef>Task_IntegrateImplementation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AdjustResults</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Tester" name="Tester">
        <bpmn:flowNodeRef>Task_TestWebsite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_CheckTestOK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Successful</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_NewOrder" name="New Order Received">
      <bpmn:outgoing>SF_Start_Analysis</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Business Analyst Tasks & Events -->
    <bpmn:task id="Task_AnalysisData" name="Collect data conduct business analysis regarding customer feedback">
      <bpmn:incoming>SF_Start_Analysis</bpmn:incoming>
      <bpmn:outgoing>SF_AnalysisToDesignStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Catch Event for synchronization (Waiting for design) -->
    <bpmn:intermediateCatchEvent id="CatchEvent_DesignComplete" name="Wait until Design Complete">
      <bpmn:incoming>SF_IntegrationToCheck</bpmn:incoming>
      <bpmn:outgoing>SF_CheckDesignStart</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>

    <!-- Gateway for Design Check -->
    <bpmn:exclusiveGateway id="GW_CheckDesignOK" name="Design OK?">
      <bpmn:incoming>SF_AnalysisToCheck</bpmn:incoming>
      <bpmn:outgoing>SF_DesignOkProceed</bpmn:outgoing>
      <bpmn:outgoing>SF_NeedAdjustments</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Web Designer Tasks -->
    <bpmn:task id="Task_IntegrateDesign" name="Integrate Design and decide where customer feedback module should be placed">
      <bpmn:incoming>SF_AnalysisToDesignStart</bpmn:incoming>
      <bpmn:incoming>SF_ChangeBackToIntegrate</bpmn:incoming>
      <bpmn:outgoing>SF_DesignCompleteSignal</bpmn:outgoing>
    </bpmn:task>

    <!-- Web Designer Change Design Task -->
    <bpmn:task id="Task_ChangeDesign" name="Change design">
      <bpmn:incoming>SF_NeedAdjustments</bpmn:incoming>
      <bpmn:outgoing>SF_ChangeBackToIntegrate</bpmn:outgoing>
    </bpmn:task>

    <!-- PHP/HTML/CSS Specialist Tasks -->
    <bpmn:task id="Task_IntegrateImplementation" name="Integrate with the overall implementation">
      <bpmn:incoming>SF_DesignOkProceed</bpmn:incoming>
      <bpmn:incoming>SF_AdjustBackToIntegrate</bpmn:incoming>
      <bpmn:outgoing>SF_IntegrationToCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- PHP/HTML/CSS Adjust Results Task -->
    <bpmn:task id="Task_AdjustResults" name="Adjust according to test results">
      <bpmn:incoming>SF_ProvideTestResults</bpmn:incoming>
      <bpmn:outgoing>SF_AdjustBackToIntegrate</bpmn:outgoing>
    </bpmn:task>

    <!-- Tester Tasks & Gateway -->
    <bpmn:task id="Task_TestWebsite" name="Test the final website to make sure everything is going well">
      <bpmn:incoming>SF_IntegrationToCheck</bpmn:outgoing> 
      <bpmn:outgoing>SF_ToTestGateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for Test Results -->
    <bpmn:exclusiveGateway id="GW_CheckTestOK" name="Test OK?">
      <bpmn:incoming>SF_ToTestGateway</bpmn:incoming>
      <bpmn:outgoing>SF_TestOkProceed</bpmn:outgoing>
      <bpmn:outgoing>SF_NotOkAdjustment</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Successful" name="Process Complete">
      <bpmn:incoming>SF_TestOkProceed</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SF_Start_Analysis" sourceRef="StartEvent_NewOrder" targetRef="Task_AnalysisData" />
    
    <bpmn:sequenceFlow id="SF_AnalysisToDesignStart" sourceRef="Task_AnalysisData" targetRef="Task_IntegrateDesign" />
    
    <bpmn:sequenceFlow id="SF_DesignCompleteSignal" sourceRef="Task_IntegrateDesign" targetRef="CatchEvent_DesignComplete" />
    
    <bpmn:sequenceFlow id="SF_CheckDesignStart" sourceRef="CatchEvent_DesignComplete" targetRef="GW_CheckDesignOK" />
    
    <bpmn:sequenceFlow id="SF_AnalysisToCheck" name="" sourceRef="Task_IntegrateImplementation" targetRef="GW_CheckDesignOK" />

    <!-- Correction for proper flow -->
    <bpmn:sequenceFlow id="SF_DesignOkProceed" name="Yes" sourceRef="GW_CheckDesignOK" targetRef="Task_IntegrateImplementation" />
    
    <bpmn:sequenceFlow id="SF_NeedAdjustments" name="No" sourceRef="GW_CheckDesignOK" targetRef="Task_ChangeDesign" />
    
    <bpmn:sequenceFlow id="SF_ChangeBackToIntegrate" sourceRef="Task_ChangeDesign" targetRef="Task_IntegrateDesign" />

    <!-- Tester Flow -->
    <bpmn:sequenceFlow id="SF_ToTestGateway" name="" sourceRef="Task_TestWebsite" targetRef="GW_CheckTestOK" />
    
    <bpmn:sequenceFlow id="SF_TestOkProceed" name="Yes" sourceRef="GW_CheckTestOK" targetRef="EndEvent_Successful" />
    
    <bpmn:sequenceFlow id="SF_NotOkAdjustment" name="No" sourceRef="GW_CheckTestOK" targetRef="Task_AdjustResults" />

  </bpmn:process>
</bpmn:definitions>