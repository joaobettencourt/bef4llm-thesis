<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
                 id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_DispatchGoods">
    <bpmn:participant id="Pool_HardwareShop" name="Dispatch of goods - Computer Hardware Shop" processRef="Proc_ShippingProcess"/>
  </bpmn:collaboration>

  <bpmn:process id="Proc_ShippingProcess" isExecutable="false">
    <!-- Lane Set -->
    <bpmn:laneSet id="Lanes_1">
      <bpmn:lane id="Lane_LogisticsDept" name="Logistics Department Head"/>

      <bpmn:lane id="Lane_Secretary" name="Secretary">
        <bpmn:flowNodeRef>StartEvent_ShipGoods</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ClarifyShipmentMethod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_StockCheckSpecialHandling</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Get3Offers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_SelectLogisticCompany</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_NormalShippingPath</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Warehouse" name="Warehouse">
        <bpmn:flowNodeRef>G_ParallelGateway_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_PackageGoods</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_LogisticsCompany" name="Logistic Company"/>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_ShipGoods">
      <bpmn:name>Ship goods</bpmn:name>
      <bpmn:outgoing>SF_StartToParallel</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Parallel Gateway -->
    <bpmn:parallelGateway id="G_ParallelGateway_Start">
      <bpmn:incoming>SF_StartToParallel</bpmn:incoming>
      <bpmn:outgoing>SF_ToSecretaryTask</bpmn:outgoing>
      <bpmn:outgoing>SF_ToWarehousePackage</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Secretary Task - Clarify Shipment Method -->
    <bpmn:task id="T_ClarifyShipmentMethod">
      <bpmn:name>Clarify shipment method</bpmn:name>
      <bpmn:incoming>SF_ToSecretaryTask</bpmn:incoming>
      <bpmn:outgoing>SF_SpecialHandlingCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway - Special Handling Decision -->
    <bpmn:exclusiveGateway id="G_StockCheckSpecialHandling">
      <bpmn:name>Special handling?</bpmn:name>
      <bpmn:incoming>SF_SpecialHandlingCheck</bpmn:incoming>
      <bpmn:outgoing>SF_NormalShippingNo</bpmn:outgoing>
      <bpmn:outgoing>SF_SpecialShippingYes</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Secretary Task - Get 3 Offers -->
    <bpmn:task id="T_Get3Offers">
      <bpmn:name>Get 3 offers from logistic companies</bpmn:name>
      <bpmn:incoming>SF_SpecialShippingYes</bpmn:incoming>
      <bpmn:outgoing>SF_SelectCompany</bpmn:outgoing>
    </bpmn:task>

    <!-- Secretary Task - Select Logistic Company -->
    <bpmn:task id="T_SelectLogisticCompany">
      <bpmn:name>Select logistic company and place order</bpmn:name>
      <bpmn:incoming>SF_SelectCompany</bpmn:incoming>
      <bpmn:outgoing>SF_ToMergeSpecialShipping</bpmn:outgoing>
    </bpmn:task>

    <!-- Inclusive Gateway - Normal Shipping Path -->
    <bpmn:inclusiveGateway id="G_NormalShippingPath">
      <bpmn:name/>
      <bpmn:incoming>SF_NormalShippingNo</bpmn:incoming>
      <bpmn:outgoing>SF_WriteLabelAlways</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Secretary Task - Write Package Label -->
    <bpmn:task id="T_WritePackageLabel">
      <bpmn:name>Write package label</bpmn:name>
      <bpmn:incoming>SF_WriteLabelAlways</bpmn:incoming>
      <bpmn:outgoing>SF_ToInsuranceDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Inclusive Gateway - Insurance Decision -->
    <bpmn:inclusiveGateway id="G_InsuranceDecision">
      <bpmn:name/>
      <bpmn:description>Determine if insurance needed for small amounts</bpmn:description>
      <bpmn:incoming>SF_ToInsuranceDecision</bpmn:incoming>
      <bpmn:outgoing>SF_InsureIfNecessary</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Logistics Task - Insure Parcel -->
    <bpmn:task id="T_InsureParcel">
      <bpmn:name>Insure parcel</bpmn:name>
      <bpmn:description>Purchase insurance for valuable items</bpmn:description>
      <bpmn:incoming>SF_InsureIfNecessary</bpmn:incoming>
      <bpmn:outgoing>SF_ToFinalMerge</bpmn:outgoing>
    </bpmn:task>

    <!-- Warehouse Task - Package Goods -->
    <bpmn:task id="T_PackageGoods">
      <bpmn:name>Package goods</bpmn:name>
      <bpmn:description>Pack items for shipment</bpmn:description>
      <bpmn:incoming>SF_ToWarehousePackage</bpmn:incoming>
      <bpmn:outgoing>SF_WarehouseToFinalMerge</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway - Final Merge -->
    <bpmn:exclusiveGateway id="G_FinalMerge">
      <bpmn:name/>
      <bpmn:description>All shipping preparations complete</bpmn:description>
      <bpmn:incoming>SF_ToFinalMerge</bpmn:outgoing>
      <bpmn:incoming>SF_WarehouseToFinalMerge</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Warehouse Task - Prepare for Pickup -->
    <bpmn:task id="T_PrepareForPickup">
      <bpmn:name>Prepare for picking up goods</bpmn:name>
      <bpmn:description>Ready items for logistic company collection</bpmn:description>
      <bpmn:incoming>SF_ToFinalMerge</bpmn:outgoing>
    </bpmn:endEvent id="End_ShipmentPrepared">
      <bpmn:name>Shipment prepared</bpmn:name>
      <bpmn:incoming>SF_FinalToPickupTask</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    
    <bpmn:sequenceFlow id="SF_StartToParallel" sourceRef="StartEvent_ShipGoods" targetRef="G_ParallelGateway_Start"/>
    <bpmn:sequenceFlow id="SF_ToSecretaryTask" name="" sourceRef="G_ParallelGateway_Start" targetRef="T_ClarifyShipmentMethod"/>
    <bpmn:sequenceFlow id="SF_ToWarehousePackage" name="" sourceRef="G_ParallelGateway_Start" targetRef="T_PackageGoods"/>
    
    <!-- Secretary Path -->
    <bpmn:sequenceFlow id="SF_SpecialHandlingCheck" name="" sourceRef="T_ClarifyShipmentMethod" targetRef="G_StockCheckSpecialHandling"/>
    <bpmn:sequenceFlow id="SF_NormalShippingNo" name="no - small amounts" sourceRef="G_StockCheckSpecialHandling" targetRef="G_NormalShippingPath"/>
    <bpmn:sequenceFlow id="SF_SpecialShippingYes" name="yes - large amounts" sourceRef="G_StockCheckSpecialHandling" targetRef="T_Get3Offers"/>
    
    <!-- Special Shipping Path -->
    <bpmn:sequenceFlow id="SF_SelectCompany" name="" sourceRef="T_Get3Offers" targetRef="T_SelectLogisticCompany"/>
    <bpmn:sequenceFlow id="SF_ToMergeSpecialShipping" name="" sourceRef="T_SelectLogisticCompany" targetRef="G_FinalMerge"/>
    
    <!-- Normal Shipping Path -->
    <bpmn:sequenceFlow id="SF_WriteLabelAlways" name="always" sourceRef="G_NormalShippingPath" targetRef="T_WritePackageLabel"/>
    <bpmn:sequenceFlow id="SF_ToInsuranceDecision" name="" sourceRef="T_WritePackageLabel" targetRef="G_InsuranceDecision"/>
    
    <!-- Insurance Path -->
    <bpmn:sequenceFlow id="SF_InsureIfNecessary" name="if necessary" sourceRef="G_InsuranceDecision" targetRef="T_InsureParcel"/>
    <bpmn:sequenceFlow id="SF_ToFinalMerge" name="" sourceRef="T_InsureParcel" targetRef="G_FinalMerge"/>
    
    <!-- Warehouse Path -->
    <bpmn:sequenceFlow id="SF_WarehouseToFinalMerge" name="" sourceRef="T_PackageGoods" targetRef="G_FinalMerge"/>
    
    <!-- Final Preparation -->
    <bpmn:sequenceFlow id="SF_FinalToPickupTask" name="" sourceRef="G_FinalMerge" targetRef="T_PrepareForPickup"/>

  </bpmn:process>
</bpmn:definitions>