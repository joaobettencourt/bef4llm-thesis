<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_meetingSchedule_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_meetingSchedule">
    <bpmn:participant id="Participant_TownPlanningAuthority" name="Town Planning Authority" processRef="Process_ScheduleCreation"/>
    <bpmn:participant id="Participant_CommitteeMembers" name="Committee Members" processRef="Process_MemberResponse"/>
    <bpmn:messageFlow id="MessageFlow_SendScheduleToMembers" sourceRef="IntermediateThrowEvent_SendFinalSchedule" targetRef="StartMessageEvent_ReceiveMeetingSchedule"/>
    <bpmn:messageFlow id="MessageFlow_AdviseConflicts" sourceRef="IntermediateThrowEvent_AdviseConflicts" targetRef="IntermediateCatchEvent_ConflictReportReceived"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_ScheduleCreation" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_CoordinationUnit" name="Coordination Unit">
        <bpmn:flowNodeRef>StartTimerEvent_November</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DraftSchedule</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AddDraftDatesToCalendars</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateCatchEvent_SupportOfficerSuggestionsReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecheckAllDatesForConflicts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateThrowEvent_SendFinalSchedule</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SupportOfficer" name="Support Officer">
        <bpmn:flowNodeRef>Task_CheckDatesAndSuggestModifications</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateThrowEvent_SendSuggestionsToCoordinationUnit</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event - November each year -->
    <bpmn:startEvent id="StartTimerEvent_November" name="November">
      <bpmn:timerDefinition xsi:type="bpmn:TimeCycle">R/2019-11/P1Y</bpmn:timerDefinition>
      <bpmn:outgoing>SequenceFlow_DraftScheduleInitiated</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1 - Draft schedule -->
    <bpmn:task id="Task_DraftSchedule" name="Draft meeting schedule for next calendar year">
      <bpmn:incoming>SequenceFlow_DraftScheduleInitiated</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AddDatesToCalendars</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2 - Add draft dates to calendars -->
    <bpmn:task id="Task_AddDraftDatesToCalendars" name="Add draft dates to all calendars">
      <bpmn:incoming>SequenceFlow_AddDatesToCalendars</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendForReview</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3 - Support Officer checks dates -->
    <bpmn:task id="Task_CheckDatesAndSuggestModifications" name="Check the draft dates and suggest modifications">
      <bpmn:incoming>SequenceFlow_SendForReview</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SupportOfficerSendSuggestions</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Throw Event - Send suggestions back -->
    <bpmn:intermediateThrowEvent id="IntermediateThrowEvent_SendSuggestionsToCoordinationUnit" name="Send modification suggestions">
      <bpmn:incoming>SequenceFlow_SupportOfficerSendSuggestions</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReceiveFeedbackLoopBack</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <!-- Intermediate Catch Event - Receive suggestions -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_SupportOfficerSuggestionsReceived" name="Support Officer modification suggestions">
      <bpmn:incoming>SequenceFlow_ReceiveFeedbackLoopBack</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RecheckDatesForConflicts</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task 4 - Recheck dates for conflicts -->
    <bpmn:task id="Task_RecheckAllDatesForConflicts" name="Recheck all dates and look for potential conflicts">
      <bpmn:incoming>SequenceFlow_RecheckDatesForConflicts</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendFinalScheduleToMembers</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Throw Event - Send final schedule -->
    <bpmn:intermediateThrowEvent id="IntermediateThrowEvent_SendFinalSchedule" name="Send final meeting schedule to Committee Members">
      <bpmn:incoming>SequenceFlow_SendFinalScheduleToMembers</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitForConflictReport</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <!-- Intermediate Catch Event - Receive conflict report -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_ConflictReportReceived" name="Receive committee member conflicts">
      <bpmn:incoming>SequenceFlow_WaitForConflictReport</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProcessConflictsAndFinalize</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task 5 - Process conflicts -->
    <bpmn:task id="Task_ProcessConflicts" name="Process reported conflicts and finalize schedule">
      <bpmn:incoming>SequenceFlow_ProcessConflictsAndFinalize</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ScheduleCompleted</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_ScheduleComplete" name="Meeting schedule finalized">
      <bpmn:incoming>SequenceFlow_ScheduleCompleted</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows - Internal Process Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_DraftScheduleInitiated" sourceRef="StartTimerEvent_November" targetRef="Task_DraftSchedule"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_AddDatesToCalendars" name="Draft dates added to calendars" sourceRef="Task_DraftSchedule" targetRef="Task_AddDraftDatesToCalendars"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_SendForReview" name="Send for Support Officer review" sourceRef="Task_AddDraftDatesToCalendars" targetRef="IntermediateThrowEvent_SupportOfficerSuggestionsReceived">
      <bpmn:name>Support Officer Review Required</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Sequence Flow from Task to Throw Event -->
    <bpmn:sequenceFlow id="SequenceFlow_SupportOfficerSendSuggestions" sourceRef="Task_CheckDatesAndSuggestModifications" targetRef="IntermediateThrowEvent_SendSuggestionsToCoordinationUnit">
      <bpmn:name>Support Officer sends suggestions</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Sequence Flow from Throw Event to Catch Event -->
    <bpmn:sequenceFlow id="SequenceFlow_ReceiveFeedbackLoopBack" sourceRef="IntermediateThrowEvent_SendSuggestionsToCoordinationUnit" targetRef="IntermediateCatchEvent_SupportOfficerSuggestionsReceived">
      <bpmn:name>Support Officer sends suggestions</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Sequence Flow from Catch Event to Task -->
    <bpmn:sequenceFlow id="SequenceFlow_RecheckDatesForConflicts" sourceRef="IntermediateCatchEvent_SupportOfficerSuggestionsReceived" targetRef="Task_RecheckAllDatesForConflicts"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_SendFinalScheduleToMembers" name="Send final schedule to Committee Members by email" sourceRef="Task_RecheckAllDatesForConflicts" targetRef="IntermediateThrowEvent_SendFinalSchedule">
      <bpmn:name>Committee Member Review Required</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Sequence Flow from Throw Event to Catch Event -->
    <bpmn:sequenceFlow id="SequenceFlow_WaitForConflictReport" sourceRef="IntermediateThrowEvent_SendFinalSchedule" targetRef="IntermediateCatchEvent_ConflictReportReceived">
      <bpmn:name>Wait for Committee Member response</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Sequence Flow from Catch Event to Task -->
    <bpmn:sequenceFlow id="SequenceFlow_ProcessConflictsAndFinalize" sourceRef="IntermediateCatchEvent_ConflictReportReceived" targetRef="Task_ProcessConflicts">
      <bpmn:name>Process conflict reports</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Final Sequence Flow to End Event -->
    <bpmn:sequenceFlow id="SequenceFlow_ScheduleCompleted" sourceRef="Task_ProcessConflicts" targetRef="EndEvent_ScheduleComplete"/>
  </bpmn:process>

  <bpmn:process id="Process_MemberResponse" isExecutable="false">
    <!-- Start Event - Receive meeting schedule -->
    <bpmn:startEvent id="StartMessageEvent_ReceiveMeetingSchedule" name="Receive Meeting Schedule">
      <bpmn:messageRef>Message_FinalMeetingSchedule</bpmn:messageRef>
      <bpmn:outgoing>SequenceFlow_MemberReceivesSchedule</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task - Check diaries for conflicts -->
    <bpmn:task id="Task_CheckDiaryForConflicts" name="Check diary and advise of any conflicts">
      <bpmn:incoming>SequenceFlow_MemberReceivesSchedule</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendConflictReportToCoordinationUnit</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Throw Event - Send conflict report -->
    <bpmn:intermediateThrowEvent id="IntermediateThrowEvent_AdviseConflicts" name="Advise Coordination Unit of conflicts">
      <bpmn:incoming>SequenceFlow_SendConflictReportToCoordinationUnit</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MemberProcessComplete</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_ProcessingCompleted" name="Conflict Report Sent">
      <bpmn:incoming>SequenceFlow_MemberProcessComplete</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows - Member Response Process Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_MemberReceivesSchedule" sourceRef="StartMessageEvent_ReceiveMeetingSchedule" targetRef="Task_CheckDiaryForConflicts"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_SendConflictReportToCoordinationUnit" name="Send conflict report to Coordination Unit by email" sourceRef="Task_CheckDiaryForConflicts" targetRef="IntermediateThrowEvent_AdviseConflicts">
      <bpmn:name>Committee Member sends conflicts</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Sequence Flow from Throw Event to End -->
    <bpmn:sequenceFlow id="SequenceFlow_MemberProcessComplete" sourceRef="IntermediateThrowEvent_AdviseConflicts" targetRef="EndEvent_ProcessingCompleted">
      <bpmn:name>Member response complete</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>

  <!-- Global Message Definitions -->
  <bpmn:message id="Message_FinalMeetingSchedule" name="Final Meeting Schedule"/>
  <bpmn:message id="Message_CommitteeConflictReport" name="Committee Conflict Report"/>
</bpmn:definitions>