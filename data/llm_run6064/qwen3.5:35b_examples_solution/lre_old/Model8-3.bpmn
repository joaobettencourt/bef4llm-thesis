<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_personnelProc_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_personnelProcess">
    <bpmn:participant id="Participant_mainPersonnelProc" name="Organization" processRef="Process_personnelManagement"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_personnelManagement" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_HeadDept" name="Head of Functional Department">
        <bpmn:flowNodeRef>StartEvent_detectedRequirements</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_reportVacancy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateCatchJobDescriptionReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_reviewOutcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_askCorrections</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_approveDescription</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateCatchClarificationRequired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_hrQuestions</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_detectedRequirements" name="Personnel requirements detected">
      <bpmn:outgoing>SequenceFlow_reportVacancy</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Report vacancy -->
    <bpmn:task id="Task_reportVacancy" name="Report vacancy to Personnel Department">
      <bpmn:incoming>SequenceFlow_reportVacancy</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_waitJobDescription</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Catch Event 1: Wait for job description -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchJobDescriptionReceived" name="Wait for Job Description">
      <bpmn:incoming>SequenceFlow_waitJobDescription</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_reviewDescription</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task 2: Review job description -->
    <bpmn:task id="Task_reviewJobDesc" name="Review Job Description">
      <bpmn:incoming>SequenceFlow_reviewDescription</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_checkOutcome</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Review Outcome -->
    <bpmn:exclusiveGateway id="Gateway_reviewOutcome" name="Review OK?">
      <bpmn:incoming>SequenceFlow_checkOutcome</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_askCorrections</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_approveDescription</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 3: Ask for corrections -->
    <bpmn:task id="Task_askCorrections" name="Ask for Corrections">
      <bpmn:incoming>SequenceFlow_askCorrections</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_returnToReview</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 4: Approve job description -->
    <bpmn:task id="Task_approveDescription" name="Approve Job Description">
      <bpmn:incoming>SequenceFlow_approveDescription</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_hrQuestionsCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2: HR Questions Check -->
    <bpmn:exclusiveGateway id="Gateway_hrQuestions" name="HR Has Questions?">
      <bpmn:incoming>SequenceFlow_hrQuestionsCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_waitClarification</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_proceedToAdvertisement</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Intermediate Catch Event 2: Wait for clarification -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchClarificationRequired" name="Wait for Clarifications">
      <bpmn:incoming>SequenceFlow_waitClarification</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_proceedToAdvertisement</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_jobAdvertised" name="Job Advertised">
      <bpmn:incoming>SequenceFlow_proceedToAdvertisement</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_reportVacancy" sourceRef="StartEvent_detectedRequirements" targetRef="Task_reportVacancy"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_waitJobDescription" name="Wait for Job Description" sourceRef="Task_reportVacancy" targetRef="IntermediateCatchJobDescriptionReceived">
      <bpmn:name>Send to Personnel Department</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_reviewDescription" name="Receive Job Description" sourceRef="IntermediateCatchJobDescriptionReceived" targetRef="Task_reviewJobDesc"/>

    <bpmn:sequenceFlow id="SequenceFlow_checkOutcome" name="Review Complete" sourceRef="Task_reviewJobDesc" targetRef="Gateway_reviewOutcome">
      <bpmn:name>Ready for Decision</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_askCorrections" name="No - Corrections Needed" sourceRef="Gateway_reviewOutcome" targetRef="Task_askCorrections">
      <bpmn:name>Not Approved</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_returnToReview" name="Return for Review" sourceRef="Task_askCorrections" targetRef="IntermediateCatchJobDescriptionReceived">
      <bpmn:name>Send Back to HR</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_approveDescription" name="Yes - Approved" sourceRef="Gateway_reviewOutcome" targetRef="Task_approveDescription">
      <bpmn:name>Approved</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_hrQuestionsCheck" name="HR Questions Check" sourceRef="Task_approveDescription" targetRef="Gateway_hrQuestions"/>

    <bpmn:sequenceFlow id="SequenceFlow_waitClarification" name="Yes - HR Has Questions" sourceRef="Gateway_hrQuestions" targetRef="IntermediateCatchClarificationRequired">
      <bpmn:name>Wait for Clarifications</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_proceedToAdvertisement" name="No - No Questions / After Clarification" sourceRef="Gateway_hrQuestions" targetRef="EndEvent_jobAdvertised">
      <bpmn:name>No HR Questions</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>