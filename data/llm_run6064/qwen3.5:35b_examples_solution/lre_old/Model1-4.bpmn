<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_IPO_Underwriting" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_MainProcess" name="IPO Underwriter Process" processRef="Process_IPOUnderwriting"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_IPOUnderwriting" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Company decides to go public">
      <bpmn:outgoing>SequenceFlow_SelectUnderwriters</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Select Underwriters -->
    <bpmn:task id="Task_0" name="Select underwriters">
      <bpmn:incoming>SequenceFlow_SelectUnderwriters</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckFacts</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: Check Facts -->
    <bpmn:task id="Task_1" name="Check facts presented fairly">
      <bpmn:incoming>SequenceFlow_CheckFacts</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FairnessDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Fairness Decision -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_0" name="Facts fair?">
      <bpmn:incoming>SequenceFlow_FairnessDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProceedToWorkstreams</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RejectIssue</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event 1: Rejection -->
    <bpmn:endEvent id="EndEvent_0" name="Do not handle issue">
      <bpmn:incoming>SequenceFlow_RejectIssue</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Parallel Gateway for SEC Work & Roadshow Prep -->
    <bpmn:parallelGateway id="ParallelGateway_0" name="Workstreams Start">
      <bpmn:incoming>SequenceFlow_ProceedToWorkstreams</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PrepareRegStatement</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ComplianceCheck</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 3: Prepare Registration -->
    <bpmn:task id="Task_2" name="Prepare registration statement for SEC approval">
      <bpmn:incoming>SequenceFlow_PrepareRegStatement</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SubmitForApproval</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 4: Compliance Check -->
    <bpmn:task id="Task_3" name="Check compliance with blue-sky laws">
      <bpmn:incoming>SequenceFlow_ComplianceCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SubmitForApproval</bpmn:outgoing>
    </bpmn:task>

    <!-- Merge Registration and Compliance -->
    <bpmn:parallelGateway id="ParallelGateway_1" name="Submission Complete">
      <bpmn:incoming>SequenceFlow_SubmitForApproval</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitSEC</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Intermediate Catch Event for SEC Clearance -->
    <bpmn:intermediateCatchEvent id="IntermediateMessageEvent_0" name="Awaiting SEC Approval">
      <bpmn:incoming>SequenceFlow_WaitSEC</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FixPricePath</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Parallel Gateway for Roadshow & SEC Wait -->
    <bpmn:parallelGateway id="ParallelGateway_2" name="Roadshow vs Approval">
      <bpmn:incoming>SequenceFlow_WaitSEC</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RoadshowStart</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 5: Roadshow -->
    <bpmn:task id="Task_4" name="Talk to potential investors">
      <bpmn:incoming>SequenceFlow_RoadshowStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FixPricePath</bpmn:outgoing>
    </bpmn:task>

    <!-- Merge Roadshow and SEC Approval -->
    <bpmn:parallelGateway id="ParallelGateway_3" name="Ready for Price Fix">
      <bpmn:incoming>SequenceFlow_FixPricePath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_FixIssuePrice</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 6: Fix Issue Price -->
    <bpmn:task id="Task_5" name="Fix issue price">
      <bpmn:incoming>SequenceFlow_FixIssuePrice</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BuyStock</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 7: Buy Stock -->
    <bpmn:task id="Task_6" name="Buy stock">
      <bpmn:incoming>SequenceFlow_BuyStock</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OfferPublic</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 8: Offer to Public -->
    <bpmn:task id="Task_7" name="Offer stock to public">
      <bpmn:incoming>SequenceFlow_OfferPublic</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CompleteIPO</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 2: IPO Complete -->
    <bpmn:endEvent id="EndEvent_1" name="IPO Completed">
      <bpmn:incoming>SequenceFlow_CompleteIPO</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_SelectUnderwriters" sourceRef="StartEvent_1" targetRef="Task_0"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_CheckFacts" name="Proceed to Check Facts" sourceRef="Task_0" targetRef="Task_1"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_FairnessDecision" name="Check Fairness" sourceRef="Task_1" targetRef="ExclusiveGateway_0"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ProceedToWorkstreams" name="Yes - Facts fair" sourceRef="ExclusiveGateway_0" targetRef="ParallelGateway_0"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_RejectIssue" name="No - Reject Issue" sourceRef="ExclusiveGateway_0" targetRef="EndEvent_0"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_PrepareRegStatement" name="Prepare Registration" sourceRef="ParallelGateway_0" targetRef="Task_2"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ComplianceCheck" name="Compliance Check" sourceRef="ParallelGateway_0" targetRef="Task_3"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_SubmitForApproval" name="Submit for Approval" sourceRef="Task_2" targetRef="ParallelGateway_1"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_WaitSEC" name="Await SEC Clearance" sourceRef="ParallelGateway_1" targetRef="IntermediateMessageEvent_0"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_FixPricePath" name="Proceed to Price Fixing" sourceRef="Task_4" targetRef="ParallelGateway_3"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_RoadshowStart" name="Begin Roadshow" sourceRef="IntermediateMessageEvent_0" targetRef="Task_4"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_FixIssuePrice" name="Fix Issue Price" sourceRef="ParallelGateway_3" targetRef="Task_5"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_BuyStock" name="Buy Stock" sourceRef="Task_5" targetRef="Task_6"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_OfferPublic" name="Offer to Public" sourceRef="Task_6" targetRef="Task_7"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_CompleteIPO" name="Complete IPO Process" sourceRef="Task_7" targetRef="EndEvent_1"/>

  </bpmn:process>
</bpmn:definitions>