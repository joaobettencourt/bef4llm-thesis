<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_courtProcess_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_CourtFilesProcessing">
    <bpmn:participant id="Participant_MainPool" name="Court Files Processing Process" processRef="Process_CourtFileHandling"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_CourtFileHandling" isExecutable="false">
    <bpmn:startEvent id="StartEvent_MorningCheck" name="Morning Check Begins">
      <bpmn:outgoing>SequenceFlow_CheckFilesInitiated</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_CheckFiles" name="Check files for court hearing">
      <bpmn:incoming>SequenceFlow_CheckFilesInitiated</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FilesMissingDecision</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="ExclusiveGateway_FilesMissing" name="Files missing?">
      <bpmn:incoming>SequenceFlow_FilesMissingDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InitiateSearchPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_TrackFilesPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_InitiateSearch" name="Initiate search">
      <bpmn:incoming>SequenceFlow_InitiateSearchPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SearchCompleteMerge</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="ExclusiveGateway_FilesReady" name="">
      <bpmn:incoming>SequenceFlow_TrackFilesPath</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_SearchCompleteMerge</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FilesReadyParallelSplit</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_TrackPhysicalFiles" name="Physically track files to intended location">
      <bpmn:incoming>SequenceFlow_TrackFilesPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FilesReadyParallelSplit</bpmn:outgoing>
    </bpmn:task>

    <bpmn:parallelGateway id="ParallelGateway_FilePreparationComplete" name="">
      <bpmn:incoming>SequenceFlow_FilesReadyParallelSplit</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_HandFilesToAssociatePath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_DistributeLawlistPath</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:task id="Task_HandFilesToAssociate" name="Hand files to Associate">
      <bpmn:incoming>SequenceFlow_HandFilesToAssociatePath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PrepareForHearingsMerge1</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_DistributeLawlist" name="Distribute Judges Lawlist to relevant people">
      <bpmn:incoming>SequenceFlow_DistributeLawlistPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PrepareForHearingsMerge2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:parallelGateway id="ParallelGateway_HearingPreparationComplete" name="">
      <bpmn:incoming>SequenceFlow_PrepareForHearingsMerge1</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_PrepareForHearingsMerge2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConductDirectionsHearingPath</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:task id="Task_ConductDirectionsHearings" name="Conduct directions hearings">
      <bpmn:incoming>SequenceFlow_ConductDirectionsHearingPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProcessComplete</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_ProcessCompleted" name="">
      <bpmn:incoming>SequenceFlow_ProcessComplete</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckFilesInitiated" sourceRef="StartEvent_MorningCheck" targetRef="Task_CheckFiles">
      <bpmn:name>Morning Check Initiated</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_FilesMissingDecision" name="" sourceRef="Task_CheckFiles" targetRef="ExclusiveGateway_FilesMissing"/>

    <bpmn:sequenceFlow id="SequenceFlow_InitiateSearchPath" name="Yes - Files Missing" sourceRef="ExclusiveGateway_FilesMissing" targetRef="Task_InitiateSearch">
      <bpmn:name>Yes</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_TrackFilesPath" name="No - Files Present" sourceRef="ExclusiveGateway_FilesMissing" targetRef="Task_TrackPhysicalFiles">
      <bpmn:name>No</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_SearchCompleteMerge" name="" sourceRef="Task_InitiateSearch" targetRef="ExclusiveGateway_FilesReady"/>

    <bpmn:sequenceFlow id="SequenceFlow_FilesReadyParallelSplit" name="" sourceRef="ExclusiveGateway_FilesReady" targetRef="ParallelGateway_FilePreparationComplete">
      <bpmn:name>All Files Ready</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_HandFilesToAssociatePath" name="" sourceRef="ParallelGateway_FilePreparationComplete" targetRef="Task_HandFilesToAssociate"/>

    <bpmn:sequenceFlow id="SequenceFlow_DistributeLawlistPath" name="" sourceRef="ParallelGateway_FilePreparationComplete" targetRef="Task_DistributeLawlist"/>

    <bpmn:sequenceFlow id="SequenceFlow_PrepareForHearingsMerge1" name="" sourceRef="Task_HandFilesToAssociate" targetRef="ParallelGateway_HearingPreparationComplete"/>

    <bpmn:sequenceFlow id="SequenceFlow_PrepareForHearingsMerge2" name="" sourceRef="Task_DistributeLawlist" targetRef="ParallelGateway_HearingPreparationComplete"/>

    <bpmn:sequenceFlow id="SequenceFlow_ConductDirectionsHearingPath" name="" sourceRef="ParallelGateway_HearingPreparationComplete" targetRef="Task_ConductDirectionsHearings">
      <bpmn:name>Files and Lawlist Ready</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ProcessComplete" name="" sourceRef="Task_ConductDirectionsHearings" targetRef="EndEvent_ProcessCompleted"/>
  </bpmn:process>
</bpmn:definitions>