<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_LeadProcess_v2" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_leadProcessing_v2">
    <bpmn:participant id="Participant_mainPool_v2" name="Lead Processing Process" processRef="Process_leadManagement_v2"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_leadManagement_v2" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_manager_v2" name="Manager">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_checkLeads_v2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_selectTopFive_v2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_customerInterested_v2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_leadProcessed_v2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_salesAssistant_v2" name="Sales Assistant">
        <bpmn:flowNodeRef>Task_callContactPerson_v2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_noInterest_v2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Check open leads">
      <bpmn:outgoing>SequenceFlow_checkLeads_v2</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Manager Tasks -->
    <bpmn:task id="Task_checkLeads_v2" name="Check open leads">
      <bpmn:incoming>SequenceFlow_checkLeads_v2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_selectTopFive_v2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_selectTopFive_v2" name="Select top five leads">
      <bpmn:incoming>SequenceFlow_selectTopFive_v2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_assignCallTask_v2</bpmn:outgoing>
    </bpmn:task>

    <!-- Sales Assistant Task -->
    <bpmn:task id="Task_callContactPerson_v2" name="Call contact person">
      <bpmn:incoming>SequenceFlow_assignCallTask_v2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_customerDecision_v2</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for customer interest decision -->
    <bpmn:exclusiveGateway id="Gateway_customerInterested_v2" name="Customer interested?">
      <bpmn:incoming>SequenceFlow_customerDecision_v2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_sendNoteToManager_v2</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_callNextCustomer_v2</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_leadProcessed_v2" name="Lead processed">
      <bpmn:incoming>SequenceFlow_sendNoteToManager_v2</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_noInterest_v2" name="No interest - End call">
      <bpmn:incoming>SequenceFlow_callNextCustomer_v2</bpmn:outgoing>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_checkLeads_v2" sourceRef="StartEvent_1" targetRef="Task_checkLeads_v2"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_selectTopFive_v2" name="Select top five leads" sourceRef="Task_checkLeads_v2" targetRef="Task_selectTopFive_v2"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_assignCallTask_v2" name="Assign call task to Sales Assistant" sourceRef="Task_selectTopFive_v2" targetRef="Task_callContactPerson_v2">
      <bpmn:name>Manager tells Sales Assistant</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_customerDecision_v2" name="Customer response received" sourceRef="Task_callContactPerson_v2" targetRef="Gateway_customerInterested_v2"/>
    
    <!-- If customer interested -->
    <bpmn:sequenceFlow id="SequenceFlow_sendNoteToManager_v2" name="Yes - Send note to Manager" sourceRef="Gateway_customerInterested_v2" targetRef="EndEvent_leadProcessed_v2">
      <bpmn:name>Customer is interested</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- If customer not interested -->
    <bpmn:sequenceFlow id="SequenceFlow_callNextCustomer_v2" name="No - Call next customer or End" sourceRef="Gateway_customerInterested_v2" targetRef="EndEvent_noInterest_v2">
      <bpmn:name>No interest</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>