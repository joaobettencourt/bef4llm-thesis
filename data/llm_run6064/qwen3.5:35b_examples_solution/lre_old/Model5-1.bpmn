<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_loanApproval_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_loanProcess">
    <bpmn:participant id="Participant_loanProcessing" name="Loan Approval Process" processRef="Process_loanApproval"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_loanApproval" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_receiveRequest" name="Receive Customer Loan Request">
      <bpmn:outgoing>SequenceFlow_initiateAssessment</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Risk Assessment Task (Service Task) -->
    <bpmn:serviceTask id="Task_riskAssessment" name="Invoke Risk Assessment Web Service">
      <bpmn:incoming>SequenceFlow_initiateAssessment</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_decisionPoint</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Decision Gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_loanDecision" name="Loan Assessment Result">
      <bpmn:incoming>SequenceFlow_decisionPoint</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_approvePath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_denyPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_reviewPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Approval Path End Event -->
    <bpmn:endEvent id="EndEvent_loanApproved" name="Loan Approved">
      <bpmn:name>Customer Receives Feedback - Loan Approved</bpmn:name>
      <bpmn:incoming>SequenceFlow_approvePath</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Denial Path End Event -->
    <bpmn:endEvent id="EndEvent_loanDenied" name="Loan Denied">
      <bpmn:name>Customer Receives Feedback - Loan Denied</bpmn:name>
      <bpmn:incoming>SequenceFlow_denyPath</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Review Path Service Task -->
    <bpmn:serviceTask id="Task_approvalService" name="Invoke Approval Web Service">
      <bpmn:name>Request Further Review / Large Loan Processing</bpmn:name>
      <bpmn:incoming>SequenceFlow_reviewPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_feedbackReview</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- End Event for Review Path -->
    <bpmn:endEvent id="EndEvent_approvalFeedback" name="Approval Feedback Sent">
      <bpmn:name>Customer Receives Feedback - Approval Decision</bpmn:name>
      <bpmn:incoming>SequenceFlow_feedbackReview</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_initiateAssessment" sourceRef="StartEvent_receiveRequest" targetRef="Task_riskAssessment">
      <bpmn:name>Initiate Risk Assessment</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_decisionPoint" sourceRef="Task_riskAssessment" targetRef="ExclusiveGateway_loanDecision"/>

    <!-- Gateway Outgoing Flows with Conditions -->
    <bpmn:sequenceFlow id="SequenceFlow_approvePath" name="Small Loan AND Low Risk">
      <sourceRef>ExclusiveGateway_loanDecision</sourceRef>
      <targetRef>EndEvent_loanApproved</targetRef>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_denyPath" name="High Risk">
      <sourceRef>ExclusiveGateway_loanDecision</sourceRef>
      <targetRef>EndEvent_loanDenied</targetRef>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_reviewPath" name="Further Review OR $10,000+">
      <sourceRef>ExclusiveGateway_loanDecision</sourceRef>
      <targetRef>Task_approvalService</targetRef>
    </bpmn:sequenceFlow>

    <!-- Review Path Completion -->
    <bpmn:sequenceFlow id="SequenceFlow_feedbackReview" name="Send Approval Feedback to Customer">
      <sourceRef>Task_approvalService</sourceRef>
      <targetRef>EndEvent_approvalFeedback</targetRef>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>