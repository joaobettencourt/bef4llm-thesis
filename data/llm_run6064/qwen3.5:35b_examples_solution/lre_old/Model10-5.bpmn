<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_deviceTakeover" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_MPON" name="MPON" processRef="Process_MPON"/>
    <bpmn:participant id="Participant_MPOO" name="MPOO" processRef="Process_MPOO"/>
    
    <!-- Message Flows between participants -->
    <bpmn:messageFlow id="MessageFlow_1">
      <bpmn:name>Request device takeover bid</bpmn:name>
      <bpmn:sourceRef="Task_MPON_RequestBid" />
      <bpmn:targetRef="StartEvent_MPOO_Tender" />
    </bpmn:messageFlow>
    
    <bpmn:messageFlow id="MessageFlow_2">
      <bpmn:name>Tender for equipment takeover</bpmn:name>
      <bpmn:sourceRef="Task_MPOO_SendTender" />
      <bpmn:targetRef="StartEvent_MPON_OrderReceived" />
    </bpmn:messageFlow>
    
    <bpmn:messageFlow id="MessageFlow_3">
      <bpmn:name>Order placement</bpmn:name>
      <bpmn:sourceRef="Task_MPON_PlaceOrder" />
      <bpmn:targetRef="StartEvent_MPOO_Confirm" />
    </bpmn:messageFlow>
    
    <bpmn:messageFlow id="MessageFlow_4">
      <bpmn:name>Confirmation and master data</bpmn:name>
      <bpmn:sourceRef="Task_MPOO_ConfirmOrder" />
      <bpmn:targetRef="EndEvent_MPON_Complete" />
    </bpmn:messageFlow>
  </bpmn:collaboration>

  <!-- MPON Process -->
  <bpmn:process id="Process_MPON" isExecutable="false">
    <bpmn:startEvent id="StartEvent_MPON_RequestBid" name="Request device takeover bid">
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_MPON_RequestBid" name="Request a device takeover bid">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:startEvent id="StartEvent_MPON_OrderReceived" name="Receive tender">
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_MPON_PlaceOrder" name="Place order at MPOO">
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_MPON_Complete" name="Order confirmed and master data received">
      <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_MPON_RequestBid" targetRef="Task_MPON_RequestBid"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="Task_MPON_RequestBid" targetRef="EndEvent_MPON_Complete">
      <bpmn:name>Request bid</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="StartEvent_MPON_OrderReceived" targetRef="Task_MPON_PlaceOrder"/>
    
  </bpmn:process>

  <!-- MPOO Process -->
  <bpmn:process id="Process_MPOO" isExecutable="false">
    <bpmn:startEvent id="StartEvent_MPOO_Tender" name="Receive bid request">
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_MPOO_SendTender" name="Send tender for equipment takeover">
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
    </bpmn:task>

    <bpmn:startEvent id="StartEvent_MPOO_Confirm" name="Receive order">
      <bpmn:outgoing>SequenceFlow_8</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:endEvent id="EndEvent_MPOO_Complete" name="Order confirmed and master data sent">
      <bpmn:incoming>SequenceFlow_9</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="StartEvent_MPOO_Tender" targetRef="Task_MPOO_SendTender">
      <bpmn:name>Tender equipment</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_7" sourceRef="Task_MPOO_SendTender" targetRef="StartEvent_MPOO_Confirm"/>

    <bpmn:task id="Task_MPOO_ConfirmOrder" name="Confirm order and send master data">
      <bpmn:incoming>SequenceFlow_8</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_9</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_8" sourceRef="StartEvent_MPOO_Confirm" targetRef="Task_MPOO_ConfirmOrder">
      <bpmn:name>Confirm order</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_9" sourceRef="Task_MPOO_ConfirmOrder" targetRef="EndEvent_MPOO_Complete"/>
  </bpmn:process>

</bpmn:definitions>