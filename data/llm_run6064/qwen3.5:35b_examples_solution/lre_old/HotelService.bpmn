<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_abc123xyz" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_roomServiceProcess">
    <bpmn:participant id="Participant_mainRoomServiceProc" name="Hotel Room Service Process" processRef="Process_roomService"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_roomService" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_sommelier" name="Sommelier">
        <bpmn:flowNodeRef>InclusiveGateway_alcoholic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_fetchWine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_prepareAlcohol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_alcoholicEnd</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_kitchen" name="Kitchen">
        <bpmn:flowNodeRef>Task_prepareMeal</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_waiter" name="Waiter">
        <bpmn:flowNodeRef>InclusiveGateway_nonAlcoholic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_readyCart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_prepareNonAlcohol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_deliveryReady</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_waiterStart</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_manager" name="Room-Service Manager">
        <bpmn:flowNodeRef>StartEvent_orderReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_takeDownOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_managerSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_alcoholicCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_submitOrderToKitchen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_giveOrderToSommelier</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_orderReceived" name="Guest Calls Room Service">
      <bpmn:outgoing>SequenceFlow_takeOrder</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Manager Tasks -->
    <bpmn:task id="Task_takeDownOrder" name="Take Down Order">
      <bpmn:incoming>SequenceFlow_takeOrder</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_splitManagerTasks</bpmn:outgoing>
    </bpmn:task>

    <!-- Manager Parallel Gateway -->
    <bpmn:parallelGateway id="ParallelGateway_managerSplit" name="">
      <bpmn:incoming>SequenceFlow_splitManagerTasks</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_submitToKitchen</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_checkAlcoholicOrder</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Kitchen Task -->
    <bpmn:task id="Task_prepareMeal" name="Prepare Meal">
      <bpmn:incoming>SequenceFlow_kitchenPreparesMeal</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_mealReadyForDelivery</bpmn:outgoing>
    </bpmn:task>

    <!-- Alcoholic Beverages Check -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_alcoholicCheck" name="Alcoholic Beverage Ordered?">
      <bpmn:incoming>SequenceFlow_checkAlcoholicOrder</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_giveToSommelierYes</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_skipSommelerNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sommelier Tasks -->
    <bpmn:task id="Task_giveOrderToSommelier" name="Give Order to Sommelier">
      <bpmn:incoming>SequenceFlow_giveToSommelierYes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_sommelierStartsWork</bpmn:outgoing>
    </bpmn:task>

    <!-- Inclusive Gateway for Alcoholic Beverages -->
    <bpmn:inclusiveGateway id="InclusiveGateway_alcoholic" name="">
      <bpmn:incoming>SequenceFlow_sommelierStartsWork</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_fetchWineTask</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_prepareAlcoholTask</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Sommelier Tasks -->
    <bpmn:task id="Task_fetchWine" name="Fetch Wine from Cellar">
      <bpmn:incoming>SequenceFlow_fetchWineTask</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_sommelierDoneFetching</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_prepareAlcohol" name="Prepare Alcoholic Beverages">
      <bpmn:incoming>SequenceFlow_prepareAlcoholTask</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_sommelierDonePreparing</bpmn:outgoing>
    </bpmn:task>

    <!-- Inclusive Gateway End for Sommelier -->
    <bpmn:inclusiveGateway id="InclusiveGateway_alcoholicEnd" name="">
      <bpmn:incoming>SequenceFlow_sommelierDoneFetching</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_sommelierDonePreparing</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_waiterCanStartCart</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Waiter Tasks -->
    <bpmn:task id="Task_readyCart" name="Ready Cart (Tablecloth &amp; Silverware)">
      <bpmn:incoming>SequenceFlow_waiterCanStartCart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_cartReadyCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Non-Alcoholic Drinks Check -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_nonAlcoholic" name="Non-Alcoholic Drink Ordered?">
      <bpmn:incoming>SequenceFlow_cartReadyCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_prepareNonAlcoholYes</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_skipNonAlcoholicNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Non-Alcoholic Task -->
    <bpmn:task id="Task_prepareNonAlcohol" name="Prepare Non-Alcoholic Drinks">
      <bpmn:incoming>SequenceFlow_prepareNonAlcoholYes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_nonAlcoholDone</bpmn:outgoing>
    </bpmn:task>

    <!-- Waiter Parallel Gateway for Delivery -->
    <bpmn:parallelGateway id="ParallelGateway_waiterStart" name="">
      <bpmn:incoming>SequenceFlow_mealReadyForDelivery</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_sommelierDoneFetching</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_deliveryReadyCheck</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Delivery Ready Check -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_deliveryReady" name="All Items Ready?">
      <bpmn:incoming>SequenceFlow_cartReadyCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_deliverToGuestYes</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Delivery Task -->
    <bpmn:task id="Task_deliverToRoom" name="Deliver to Guest's Room">
      <bpmn:incoming>SequenceFlow_deliveryReadyCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_returnFromDelivery</bpmn:outgoing>
    </bpmn:task>

    <!-- Return Task -->
    <bpmn:task id="Task_returnToStation" name="Return to Room-Service Station">
      <bpmn:incoming>SequenceFlow_returnFromDelivery</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_billingReadyCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Billing Task -->
    <bpmn:endEvent id="EndEvent_orderCompleted" name="Order Completed">
      <bpmn:incoming>SequenceFlow_billingComplete</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_takeOrder" sourceRef="StartEvent_orderReceived" targetRef="Task_takeDownOrder"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_splitManagerTasks" name="" sourceRef="ParallelGateway_managerSplit">
      <!-- Split to Kitchen and Alcoholic Check -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_submitToKitchen" sourceRef="Task_takeDownOrder" targetRef="Task_prepareMeal"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_checkAlcoholicOrder" name="" sourceRef="ParallelGateway_managerSplit" targetRef="ExclusiveGateway_alcoholicCheck">
      <!-- Check for alcoholic beverages -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_giveToSommelierYes" name="Yes - Alcoholic Ordered" sourceRef="ExclusiveGateway_alcoholicCheck" targetRef="Task_giveOrderToSommelier"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_skipSommelerNo" name="No Skip Sommelier" sourceRef="ExclusiveGateway_alcoholicCheck" targetRef="InclusiveGateway_alcoholicEnd">
      <!-- 80% orders include alcoholic beverages -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_sommelierStartsWork" name="" sourceRef="Task_giveOrderToSommelier" targetRef="InclusiveGateway_alcoholic"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_fetchWineTask" name="" sourceRef="InclusiveGateway_alcoholic" targetRef="Task_fetchWine">
      <!-- Fetch wine from cellar -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_prepareAlcoholTask" name="" sourceRef="InclusiveGateway_alcoholic" targetRef="Task_prepareAlcohol"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_sommelierDoneFetching" name="" sourceRef="Task_fetchWine" targetRef="ParallelGateway_waiterStart">
      <!-- Wine fetched -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_sommelierDonePreparing" name="" sourceRef="Task_prepareAlcohol" targetRef="InclusiveGateway_alcoholicEnd"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_waiterCanStartCart" name="" sourceRef="ParallelGateway_managerSplit" targetRef="Task_readyCart">
      <!-- Waiter can start cart preparation -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_cartReadyCheck" name="" sourceRef="InclusiveGateway_alcoholicEnd" targetRef="ExclusiveGateway_nonAlcoholic"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_prepareNonAlcoholYes" name="Yes - Non-Alcoholic Ordered" sourceRef="ExclusiveGateway_nonAlcoholic" targetRef="Task_prepareNonAlcohol">
      <!-- Prepare non-alcoholic drinks -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_skipNonAlcoholicNo" name="Skip No Non-Alcoholic Ordered" sourceRef="ExclusiveGateway_nonAlcoholic" targetRef="ParallelGateway_waiterStart"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_kitchenPreparesMeal" name="" sourceRef="Task_prepareMeal" targetRef="ParallelGateway_waiterStart">
      <!-- Kitchen prepares meal -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_nonAlcoholDone" name="" sourceRef="Task_prepareNonAlcohol" targetRef="ParallelGateway_waiterStart"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_deliveryReadyCheck" name="" sourceRef="ParallelGateway_waiterStart" targetRef="ExclusiveGateway_deliveryReady">
      <!-- Check if all items ready for delivery -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_deliverToGuestYes" name="All Items Ready - Deliver Now" sourceRef="ExclusiveGateway_deliveryReady" targetRef="Task_deliverToRoom"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_returnFromDelivery" name="" sourceRef="Task_deliverToRoom" targetRef="Task_returnToStation">
      <!-- Return from delivery -->
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>