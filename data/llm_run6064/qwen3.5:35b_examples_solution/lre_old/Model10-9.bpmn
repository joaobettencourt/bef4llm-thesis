<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_mpoChangeProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_MPO_Change_Process">
    <bpmn:participant id="Participant_MPO" name="MPO (Measuring Point Operator)" processRef="Process_MPO_Change"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_MPO_Change" isExecutable="false">
    <!-- Start Event - Change Request Triggered -->
    <bpmn:startEvent id="StartEvent_1" name="Change Request Initiated">
      <bpmn:outgoing>SequenceFlow_toReviewGateway</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Gateway for initial routing based on who initiated -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_InitiatorCheck" name="Initiated By?">
      <bpmn:incoming>SequenceFlow_toReviewGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_fromSP_PU_GO_Request</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_fromMPO_CauseChange</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task - SP/PU/GO Request Change -->
    <bpmn:task id="Task_SP_PU_GO_Request" name="SP/PU/GO Requests MPO">
      <bpmn:incoming>SequenceFlow_fromSP_PU_GO_Request</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_toReviewGateway_1</bpmn:outgoing>
    </bpmn:task>

    <!-- Task - MPO Causes Change -->
    <bpmn:task id="Task_MPO_CauseChange" name="MPO Initiates Change">
      <bpmn:incoming>SequenceFlow_fromMPO_CauseChange</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_toReviewGateway_1</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway - Merge paths before review -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_MergeBeforeReview" name="">
      <bpmn:incoming>SequenceFlow_fromSP_PU_GO_Request</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_fromMPO_CauseChange_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_toReviewTask</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task - MPO Reviews Change Request -->
    <bpmn:task id="Task_MPO_Reviews" name="MPO Reviews Change Request">
      <bpmn:incoming>SequenceFlow_toReviewTask</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_toDecisionGateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway - Decision Point (Reject vs Confirm) -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_Decision" name="Approve Change?">
      <bpmn:incoming>SequenceFlow_toDecisionGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RejectPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ConfirmPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task - Reject Change -->
    <bpmn:task id="Task_Reject" name="MPO Rejects Request">
      <bpmn:incoming>SequenceFlow_RejectPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_toFailureNotification</bpmn:outgoing>
    </bpmn:task>

    <!-- Task - Confirm Change -->
    <bpmn:task id="Task_Confirm" name="MPO Confirms Request">
      <bpmn:incoming>SequenceFlow_ConfirmPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_toPerformChange</bpmn:outgoing>
    </bpmn:task>

    <!-- Task - Perform Measuring Point Change -->
    <bpmn:task id="Task_PerformChange" name="MPO Performs Measuring Point Change">
      <bpmn:incoming>SequenceFlow_toPerformChange</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_toFinalDecisionGateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway - Final Decision (Success vs Failure) -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_Final" name="Change Successful?">
      <bpmn:incoming>SequenceFlow_toFinalDecisionGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SuccessPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_FailurePath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task - Report Implementation -->
    <bpmn:task id="Task_ReportImplementation" name="Report Implementation to SP/PU/GO">
      <bpmn:incoming>SequenceFlow_SuccessPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_toEndSuccess</bpmn:outgoing>
    </bpmn:task>

    <!-- Task - Notify Failure -->
    <bpmn:task id="Task_NotifyFailure" name="Notify SP/PU/GO of Change Failure">
      <bpmn:incoming>SequenceFlow_FailurePath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_toEndFailure</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event - Success -->
    <bpmn:endEvent id="EndEvent_Success" name="Change Successfully Completed">
      <bpmn:incoming>SequenceFlow_toEndSuccess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- End Event - Failure -->
    <bpmn:endEvent id="EndEvent_Failure" name="Change Failed and Notified">
      <bpmn:incoming>SequenceFlow_toEndFailure</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_toReviewGateway" sourceRef="StartEvent_1" targetRef="ExclusiveGateway_InitiatorCheck"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_fromSP_PU_GO_Request" name="From SP/PU/GO Request" sourceRef="ExclusiveGateway_InitiatorCheck" targetRef="Task_SP_PU_GO_Request"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_fromMPO_CauseChange" name="From MPO Cause Change" sourceRef="ExclusiveGateway_InitiatorCheck" targetRef="Task_MPO_CauseChange"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_toReviewGateway_1" sourceRef="Task_SP_PU_GO_Request" targetRef="ExclusiveGateway_MergeBeforeReview"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_fromMPO_CauseChange_2" name="" sourceRef="Task_MPO_CauseChange" targetRef="ExclusiveGateway_MergeBeforeReview"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_toReviewTask" sourceRef="ExclusiveGateway_MergeBeforeReview" targetRef="Task_MPO_Reviews"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_toDecisionGateway" name="" sourceRef="Task_MPO_Reviews" targetRef="ExclusiveGateway_Decision"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_RejectPath" name="Reject Decision" sourceRef="ExclusiveGateway_Decision" targetRef="Task_Reject"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ConfirmPath" name="Confirm Decision" sourceRef="ExclusiveGateway_Decision" targetRef="Task_Confirm"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_toPerformChange" name="" sourceRef="Task_Confirm" targetRef="Task_PerformChange"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_toFinalDecisionGateway" name="" sourceRef="Task_PerformChange" targetRef="ExclusiveGateway_Final"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_SuccessPath" name="Success Path" sourceRef="ExclusiveGateway_Final" targetRef="Task_ReportImplementation"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_FailurePath" name="Failure Path" sourceRef="ExclusiveGateway_Final" targetRef="Task_NotifyFailure"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_toEndSuccess" name="" sourceRef="Task_ReportImplementation" targetRef="EndEvent_Success"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_toEndFailure" name="" sourceRef="Task_NotifyFailure" targetRef="EndEvent_Failure"/>

  </bpmn:process>
</bpmn:definitions>