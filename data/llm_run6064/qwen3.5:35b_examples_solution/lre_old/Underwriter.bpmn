<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ipoProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_underwriterIPO">
    <bpmn:participant id="Participant_underwriter" name="Underwriter Process" processRef="Process_IPO"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_IPO" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:name>Select Underwriters</bpmn:name>
      <bpmn:outgoing>SequenceFlow_selectUnderwriter</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Parallel Gateway for initial split -->
    <bpmn:parallelGateway id="ParallelGateway_initial">
      <bpmn:incoming>SequenceFlow_selectUnderwriter</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_checkFacts</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_parallelTasks</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Check Facts Presented -->
    <bpmn:task id="Task_checkFacts" name="Check Facts Presented">
      <bpmn:incoming>SequenceFlow_checkFacts</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_factsDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Decision Gateway for facts check -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_facts">
      <bpmn:name>All Right?</bpmn:name>
      <bpmn:incoming>SequenceFlow_factsDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_proceedToRegistration</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_rejectIssue</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event for rejection -->
    <bpmn:endEvent id="EndEvent_rejected">
      <bpmn:name>Issue Rejected - Facts Not Fairly Presented</bpmn:name>
      <bpmn:incoming>SequenceFlow_rejectIssue</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Parallel Gateway for SEC Registration and Blue-Sky Laws -->
    <bpmn:parallelGateway id="ParallelGateway_registration">
      <bpmn:name>Registration Tasks Split</bpmn:name>
      <bpmn:incoming>SequenceFlow_parallelTasks</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_prepareSECStatement</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_checkBlueSkyLaws</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Prepare Registration Statement for SEC -->
    <bpmn:task id="Task_prepareSECStatement" name="Prepare Registration Statement for Approval of SEC">
      <bpmn:incoming>SequenceFlow_prepareSECStatement</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_statementPrepared</bpmn:outgoing>
    </bpmn:task>

    <!-- Check Compliance with Blue-Sky Laws -->
    <bpmn:task id="Task_checkBlueSkyLaws" name="Check Compliance with State Blue-Sky Laws">
      <bpmn:incoming>SequenceFlow_checkBlueSkyLaws</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_lawsCompliant</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway to merge registration tasks -->
    <bpmn:parallelGateway id="ParallelGateway_mergeRegistration">
      <bpmn:name>Start Road Show After Registration Tasks</bpmn:name>
      <bpmn:incoming>SequenceFlow_statementPrepared</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_lawsCompliant</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_startRoadShow</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Road Show Task -->
    <bpmn:task id="Task_roadshow" name="Arrange Road Show to Talk to Potential Investors">
      <bpmn:incoming>SequenceFlow_startRoadShow</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_waitForSECAnswer</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Catch Event for SEC Answer -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_SEC">
      <bpmn:name>Wait for SEC Approval</bpmn:name>
      <bpmn:incoming>SequenceFlow_waitForSECAnswer</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_secDecision</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Decision Gateway for SEC Approval -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_SECApproval">
      <bpmn:name>SEC Approved?</bpmn:name>
      <bpmn:incoming>SequenceFlow_secDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_fixPriceIfApproved</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_rejectedBySEC</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event for SEC rejection -->
    <bpmn:endEvent id="EndEvent_secRejected">
      <bpmn:name>Issue Rejected by SEC - Not Approved</bpmn:name>
      <bpmn:incoming>SequenceFlow_rejectedBySEC</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Fix Issue Price -->
    <bpmn:task id="Task_fixPrice" name="Fix Issue Price">
      <bpmn:incoming>SequenceFlow_fixPriceIfApproved</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_buyStock</bpmn:outgoing>
    </bpmn:task>

    <!-- Buy Stock -->
    <bpmn:task id="Task_buyStock" name="Buy the Issue (Firm Commitment)">
      <bpmn:incoming>SequenceFlow_buyStock</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_offerPublic</bpmn:outgoing>
    </bpmn:task>

    <!-- Offer to Public -->
    <bpmn:task id="Task_offerPublic" name="Offer Stock to the Public">
      <bpmn:incoming>SequenceFlow_offerPublic</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_processComplete</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event for successful completion -->
    <bpmn:endEvent id="EndEvent_success">
      <bpmn:name>IPO Process Completed Successfully</bpmn:name>
      <bpmn:incoming>SequenceFlow_processComplete</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_selectUnderwriter" sourceRef="StartEvent_1" targetRef="ParallelGateway_initial"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_checkFacts" sourceRef="ParallelGateway_initial" targetRef="Task_checkFacts"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_parallelTasks" name="Proceed to Registration Prep" sourceRef="ParallelGateway_initial" targetRef="ParallelGateway_registration">
      <bpmn:name>Start Parallel Tasks</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_factsDecision" name="Check Facts" sourceRef="Task_checkFacts" targetRef="ExclusiveGateway_facts"/>

    <bpmn:sequenceFlow id="SequenceFlow_proceedToRegistration" name="Yes - All Right" sourceRef="ExclusiveGateway_facts" targetRef="ParallelGateway_registration"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_rejectIssue" name="No - Facts Not Fairly Presented" sourceRef="ExclusiveGateway_facts" targetRef="EndEvent_rejected"/>

    <bpmn:sequenceFlow id="SequenceFlow_prepareSECStatement" sourceRef="ParallelGateway_registration" targetRef="Task_prepareSECStatement"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_checkBlueSkyLaws" sourceRef="ParallelGateway_registration" targetRef="Task_checkBlueSkyLaws"/>

    <bpmn:sequenceFlow id="SequenceFlow_statementPrepared" name="Registration Statement Prepared" sourceRef="Task_prepareSECStatement" targetRef="ParallelGateway_mergeRegistration"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_lawsCompliant" name="Blue-Sky Laws Compliant" sourceRef="Task_checkBlueSkyLaws" targetRef="ParallelGateway_mergeRegistration"/>

    <bpmn:sequenceFlow id="SequenceFlow_startRoadShow" sourceRef="ParallelGateway_mergeRegistration" targetRef="Task_roadshow">
      <bpmn:name>Start Road Show</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_waitForSECAnswer" name="Await SEC Approval" sourceRef="Task_roadshow" targetRef="IntermediateCatchEvent_SEC"/>

    <bpmn:sequenceFlow id="SequenceFlow_secDecision" sourceRef="IntermediateCatchEvent_SEC" targetRef="ExclusiveGateway_SECApproval">
      <bpmn:name>SEC Decision Received</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_fixPriceIfApproved" name="Yes - SEC Approved" sourceRef="ExclusiveGateway_SECApproval" targetRef="Task_fixPrice"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_rejectedBySEC" name="No - Not Approved" sourceRef="ExclusiveGateway_SECApproval" targetRef="EndEvent_secRejected">
      <bpmn:name>Not SEC Approved</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_buyStock" name="Fix Price Complete" sourceRef="Task_fixPrice" targetRef="Task_buyStock"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_offerPublic" name="Buy Stock (Firm Commitment)" sourceRef="Task_buyStock" targetRef="Task_offerPublic">
      <bpmn:name>Enter Firm Commitment</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_processComplete" name="Offer to Public Complete" sourceRef="Task_offerPublic" targetRef="EndEvent_success"/>

  </bpmn:process>
</bpmn:definitions>