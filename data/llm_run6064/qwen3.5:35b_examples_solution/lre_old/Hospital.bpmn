<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_examinationProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_HealthcareExamination">
    <bpmn:participant id="Participant_HospitalSystem" name="Hospital Examination Process" processRef="Process_Examination"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Examination" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_OutpatientDepartment" name="Outpatient Department">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExaminePatient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AdditionalExamRequired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FillExaminationForm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_PatientReleased</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Ward" name="Ward">
        <bpmn:flowNodeRef>Task_ArrangeAppointment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareExaminationSampling</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TakeSampleFromPatient</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Laboratory" name="Laboratory">
        <bpmn:flowNodeRef>Gateway_SampleValidForAnalysis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ValidateSampleState</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AnalyseSample</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ValidateResults</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_OutpatientPhysician" name="Outpatient Physician">
        <bpmn:flowNodeRef>Gateway_PatientAgreesToProcedure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OrderExaminationTreatment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FillRequestForm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformAboutRisks</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_LabPhysician" name="Lab Physician">
        <bpmn:flowNodeRef>EndEvent_ProcessCompleted</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Patient Examination Initiated">
      <bpmn:outgoing>SequenceFlow_ExaminationInitiation</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Examine Patient -->
    <bpmn:task id="Task_ExaminePatient" name="Examine Female Patient">
      <bpmn:incoming>SequenceFlow_ExaminationInitiation</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DecideAdditionalExam</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Additional Examination Required? -->
    <bpmn:exclusiveGateway id="Gateway_AdditionalExamRequired" name="Additional examination required?">
      <bpmn:incoming>SequenceFlow_DecideAdditionalExam</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_HealthyPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_AdditionalExaminationPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Path A - Healthy -->
    <bpmn:task id="Task_FillExaminationForm" name="Fill Examination Form">
      <bpmn:incoming>SequenceFlow_HealthyPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PatientLeaves</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event - Patient Released -->
    <bpmn:endEvent id="EndEvent_PatientReleased" name="Patient Released">
      <bpmn:incoming>SequenceFlow_PatientLeaves</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Path B - Additional Examination Required -->
    <bpmn:task id="Task_OrderExaminationTreatment" name="Order Examination &amp; Follow-up Treatment">
      <bpmn:incoming>SequenceFlow_AdditionalExaminationPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FillRequestForm</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Fill Request Form -->
    <bpmn:task id="Task_FillRequestForm" name="Fill Out Request Form">
      <bpmn:incoming>SequenceFlow_FillRequestForm</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InformAboutRisks</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Inform About Risks -->
    <bpmn:task id="Task_InformAboutRisks" name="Inform Patient About Potential Risks">
      <bpmn:incoming>SequenceFlow_InformAboutRisks</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PatientAgreesToProcedure</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2: Patient Agrees to Procedure? -->
    <bpmn:exclusiveGateway id="Gateway_PatientAgreesToProcedure" name="Patient agrees to procedure?">
      <bpmn:incoming>SequenceFlow_PatientAgreesToProcedure</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProceedWithAppointment</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Arrange Appointment -->
    <bpmn:task id="Task_ArrangeAppointment" name="Arrange Patient Appointment with Ward">
      <bpmn:incoming>SequenceFlow_ProceedWithAppointment</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PrepareExaminationSampling</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Prepare Examination and Sampling -->
    <bpmn:task id="Task_PrepareExaminationSampling" name="Prepare Examination &amp; Sampling">
      <bpmn:incoming>SequenceFlow_PrepareExaminationSampling</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TakeSampleFromPatient</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Take Sample from Patient -->
    <bpmn:task id="Task_TakeSampleFromPatient" name="Take Sample Requested">
      <bpmn:incoming>SequenceFlow_TakeSampleFromPatient</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendToLab</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Validate Sample State (in Laboratory) -->
    <bpmn:task id="Task_ValidateSampleState" name="Validate Sample State">
      <bpmn:incoming>SequenceFlow_SendToLab</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SampleValidForAnalysis</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 3: Sample Valid for Analysis? -->
    <bpmn:exclusiveGateway id="Gateway_SampleValidForAnalysis" name="Sample valid for analysis?">
      <bpmn:incoming>SequenceFlow_SampleValidForAnalysis</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AnalysisProceeds</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Analyse Sample -->
    <bpmn:task id="Task_AnalyseSample" name="Analyse Sample">
      <bpmn:incoming>SequenceFlow_AnalysisProceeds</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ValidateResults</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Validate Results -->
    <bpmn:task id="Task_ValidateResults" name="Validate Analysis Results">
      <bpmn:incoming>SequenceFlow_ValidateResults</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MakeDiagnosis</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Make Diagnosis and Prescribe Therapy -->
    <bpmn:task id="Task_MakeDiagnosis" name="Make Diagnosis &amp; Prescribe Therapy">
      <bpmn:incoming>SequenceFlow_MakeDiagnosis</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProcessCompleted</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event - Process Completed -->
    <bpmn:endEvent id="EndEvent_ProcessCompleted" name="Examination Process Completed">
      <bpmn:incoming>SequenceFlow_ProcessCompleted</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows with proper attributes only (no child elements) -->
    <bpmn:sequenceFlow id="SequenceFlow_ExaminationInitiation" sourceRef="StartEvent_1" targetRef="Task_ExaminePatient"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_DecideAdditionalExam" name="Decision on Additional Examination" sourceRef="Task_ExaminePatient" targetRef="Gateway_AdditionalExamRequired"/>

    <bpmn:sequenceFlow id="SequenceFlow_HealthyPath" name="No - Healthy" sourceRef="Gateway_AdditionalExamRequired" targetRef="Task_FillExaminationForm"/>

    <bpmn:sequenceFlow id="SequenceFlow_PatientLeaves" name="Patient Leaves" sourceRef="Task_FillExaminationForm" targetRef="EndEvent_PatientReleased"/>

    <bpmn:sequenceFlow id="SequenceFlow_AdditionalExaminationPath" name="Yes - Additional Examination Required" sourceRef="Gateway_AdditionalExamRequired" targetRef="Task_OrderExaminationTreatment"/>

    <bpmn:sequenceFlow id="SequenceFlow_FillRequestForm" name="Fill Request Form" sourceRef="Task_OrderExaminationTreatment" targetRef="Task_FillRequestForm"/>

    <bpmn:sequenceFlow id="SequenceFlow_InformAboutRisks" name="Inform About Risks" sourceRef="Task_FillRequestForm" targetRef="Task_InformAboutRisks"/>

    <bpmn:sequenceFlow id="SequenceFlow_PatientAgreesToProcedure" name="Patient Agrees" sourceRef="Task_InformAboutRisks" targetRef="Gateway_PatientAgreesToProcedure"/>

    <bpmn:sequenceFlow id="SequenceFlow_ProceedWithAppointment" name="Proceed" sourceRef="Gateway_PatientAgreesToProcedure" targetRef="Task_ArrangeAppointment"/>

    <bpmn:sequenceFlow id="SequenceFlow_PrepareExaminationSampling" name="Prepare Examination and Sampling" sourceRef="Task_ArrangeAppointment" targetRef="Task_PrepareExaminationSampling"/>

    <bpmn:sequenceFlow id="SequenceFlow_TakeSampleFromPatient" name="Take Sample" sourceRef="Task_PrepareExaminationSampling" targetRef="Task_TakeSampleFromPatient"/>

    <bpmn:sequenceFlow id="SequenceFlow_SendToLab" name="Send to Lab" sourceRef="Task_TakeSampleFromPatient" targetRef="Task_ValidateSampleState"/>

    <bpmn:sequenceFlow id="SequenceFlow_SampleValidForAnalysis" name="Sample Valid for Analysis" sourceRef="Task_ValidateSampleState" targetRef="Gateway_SampleValidForAnalysis"/>

    <bpmn:sequenceFlow id="SequenceFlow_AnalysisProceeds" name="Analysis Proceeds" sourceRef="Gateway_SampleValidForAnalysis" targetRef="Task_AnalyseSample"/>

    <bpmn:sequenceFlow id="SequenceFlow_ValidateResults" name="Validate Results" sourceRef="Task_AnalyseSample" targetRef="Task_ValidateResults"/>

    <bpmn:sequenceFlow id="SequenceFlow_MakeDiagnosis" name="Make Diagnosis" sourceRef="Task_ValidateResults" targetRef="Task_MakeDiagnosis"/>

    <bpmn:sequenceFlow id="SequenceFlow_ProcessCompleted" name="Process Completed" sourceRef="Task_MakeDiagnosis" targetRef="EndEvent_ProcessCompleted"/>
  </bpmn:process>
</bpmn:definitions>