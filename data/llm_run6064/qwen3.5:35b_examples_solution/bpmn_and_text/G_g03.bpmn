<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_WoWCharacterCreation" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_NewWoWChar" name="New WoW character wanted">
      <bpmn:outgoing>SequenceFlow_Split</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Parallel Gateway Split (Two things start) -->
    <bpmn:parallelGateway id="ParallelGateway_AccountSetup" name="">
      <bpmn:incoming>SequenceFlow_Split</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckBattleNet</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ComingUpNames</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Path 1: Account Setup -->
    <bpmn:serviceTask id="Service_CheckBattleNet" name="Check existence of battle.net account">
      <bpmn:incoming>SequenceFlow_CheckBattleNet</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GatewayAccountExists</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Gateway: Account Exists? -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_AccountExists" name="battle.net account exists?">
      <bpmn:incoming>SequenceFlow_GatewayAccountExists</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CreateNewAccount</bpmn:outgoing> <!-- No -->
      <bpmn:outgoing>SequenceFlow_CheckSubscription</bpmn:outgoing>  <!-- Yes -->
    </bpmn:exclusiveGateway>

    <!-- Task: Create New Account Info (No path) -->
    <bpmn:userTask id="User_CreateNewAccount" name="Create new battle.net account">
      <bpmn:incoming>SequenceFlow_CreateNewAccount</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConfirmEmailLink</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Confirm via Email Link (No path) -->
    <bpmn:userTask id="User_ConfirmAccount" name="Confirm account information via email link">
      <bpmn:incoming>SequenceFlow_ConfirmEmailLink</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeAfterCreate</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Merge after Create Account or Already Exists -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_AccountMerge" name="">
      <bpmn:incoming>SequenceFlow_CheckSubscription</bpmn:incoming>  <!-- From Yes path of CheckBattleNet -->
      <bpmn:incoming>SequenceFlow_MergeAfterCreate</bpmn:incoming>  <!-- From Create/Confirm Path -->
    </bpmn:exclusiveGateway>

    <!-- Subscription Check Gateway (after account is confirmed) -->
    <bpmn:serviceTask id="Service_CheckSubscription" name="Check WoW subscription">
      <bpmn:incoming>SequenceFlow_MergeAfterCreate</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Gateway_SubscriptionPresent</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Gateway: Subscription Present? -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_Subscription" name="Subscription present?">
      <bpmn:incoming>SequenceFlow_Gateway_SubscriptionPresent</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SelectPaymentMethod</bpmn:outgoing> <!-- No -->
      <bpmn:outgoing>SequenceFlow_LogIntoGame</bpmn:outgoing>  <!-- Yes -->
    </bpmn:exclusiveGateway>

    <!-- Task: Select Payment Method (if no subscription) -->
    <bpmn:userTask id="User_SelectPaymentMethod" name="Select payment method">
      <bpmn:incoming>SequenceFlow_SelectPaymentMethod</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Gateway_PaymentChoice</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway: Payment Method Choice -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_PaymentMethod" name="Payment method?">
      <bpmn:incoming>SequenceFlow_Gateway_PaymentChoice</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EnterCreditCardInfo</bpmn:outgoing> <!-- Credit Card -->
      <bpmn:outgoing>SequenceFlow_EnterBankAccountInfo</bpmn:outgoing>  <!-- Bank Account -->
    </bpmn:exclusiveGateway>

    <!-- Task: Enter Credit Card Info (if credit card) -->
    <bpmn:userTask id="User_CreditCard" name="Enter credit card information">
      <bpmn:incoming>SequenceFlow_EnterCreditCardInfo</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergePaymentMethods</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Enter Bank Account Info (if bank account) -->
    <bpmn:userTask id="User_BankAccount" name="Enter IBAN and BIC numbers">
      <bpmn:incoming>SequenceFlow_EnterBankAccountInfo</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergePaymentMethods</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Merge Payment Methods -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_PaymentMerge" name="">
      <bpmn:incoming>SequenceFlow_EnterCreditCardInfo</bpmn:incoming>  <!-- From Credit Card Path (Yes) -->
      <bpmn:incoming>SequenceFlow_MergePaymentMethods</bpmn:incoming>  <!-- From Bank Account and Subscription Yes paths -->
    </bpmn:exclusiveGateway>

    <!-- Task: Log into Game -->
    <bpmn:userTask id="User_LogIntoGame" name="Log into the game">
      <bpmn:incoming>SequenceFlow_MergePaymentMethods</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SelectCharacterDetails</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel Gateway for Character Details -->
    <bpmn:parallelGateway id="ParallelGateway_CharacterCreation" name="">
      <bpmn:incoming>SequenceFlow_SelectCharacterDetails</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SelectRealm</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SelectRace</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SelectClass</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Select Realm -->
    <bpmn:userTask id="User_SelectRealm" name="Select realm of your character">
      <bpmn:incoming>SequenceFlow_SelectRealm</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeCharacterDetails1</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Select Race -->
    <bpmn:userTask id="User_SelectRace" name="Select race of your character">
      <bpmn:incoming>SequenceFlow_SelectRace</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeCharacterDetails2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Select Class -->
    <bpmn:userTask id="User_SelectClass" name="Select class of your character">
      <bpmn:incoming>SequenceFlow_SelectClass</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeCharacterDetails3</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Merge Character Details -->
    <bpmn:parallelGateway id="ParallelGateway_CharacterMerge" name="">
      <bpmn:incoming>SequenceFlow_MergeCharacterDetails1</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_MergeCharacterDetails2</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_MergeCharacterDetails3</bpmn:incoming>
    </bpmn:parallelGateway>

    <!-- Path B (from start): Character Name Planning -->
    <bpmn:userTask id="User_EnterName" name="Enter character name">
      <bpmn:incoming>SequenceFlow_ComingUpNames</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Gateway_NameAvailable</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway: Name Available? -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_NameAvailable" name="Character name available?">
      <bpmn:incoming>SequenceFlow_Gateway_NameAvailable</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EnterNameAgain</bpmn:outgoing> <!-- No -->
      <bpmn:outgoing>SequenceFlow_GetConfirmation</bpmn:outgoing>  <!-- Yes -->
    </bpmn:exclusiveGateway>

    <!-- Loop back to Enter Name if not available -->
    <bpmn:userTask id="User_EnterNameAgain" name="Enter character name">
      <bpmn:incoming>SequenceFlow_EnterNameAgain</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Gateway_NameAvailable2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway for Name Availability Check (loop) -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_NameAvailableLoop" name="">
      <bpmn:incoming>SequenceFlow_EnterNameAgain</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Gateway_NameAvailable2</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Get Confirmation and Selfies -->
    <bpmn:userTask id="User_GetConfirmation" name="Receive confirmation and character selfies">
      <bpmn:incoming>SequenceFlow_GetConfirmation</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndEvent</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_CharacterCreated" name="Character created">
      <bpmn:incoming>SequenceFlow_EndEvent</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows for Account Setup Path -->
    <bpmn:sequenceFlow id="SequenceFlow_Split" sourceRef="StartEvent_NewWoWChar" targetRef="ParallelGateway_AccountSetup"/>
    <bpmn:sequenceFlow id="SequenceFlow_CheckBattleNet" sourceRef="ParallelGateway_AccountSetup" targetRef="Service_CheckBattleNet"/>
    <bpmn:sequenceFlow id="SequenceFlow_GatewayAccountExists" sourceRef="Service_CheckBattleNet" targetRef="ExclusiveGateway_AccountExists"/>
    <bpmn:sequenceFlow id="SequenceFlow_CreateNewAccount" name="no" sourceRef="ExclusiveGateway_AccountExists" targetRef="User_CreateNewAccount"/>
    <bpmn:sequenceFlow id="SequenceFlow_ConfirmEmailLink" sourceRef="User_CreateNewAccount" targetRef="User_ConfirmAccount"/>
    <bpmn:sequenceFlow id="SequenceFlow_MergeAfterCreate" name="" sourceRef="User_ConfirmAccount" targetRef="Service_CheckSubscription"/>
    <bpmn:sequenceFlow id="SequenceFlow_CheckSubscription" name="yes" sourceRef="ExclusiveGateway_AccountExists" targetRef="Service_CheckSubscription"/>

    <!-- Sequence Flows for Subscription and Payment -->
    <bpmn:sequenceFlow id="SequenceFlow_Gateway_SubscriptionPresent" sourceRef="Service_CheckSubscription" targetRef="ExclusiveGateway_Subscription"/>
    <bpmn:sequenceFlow id="SequenceFlow_SelectPaymentMethod" name="no" sourceRef="ExclusiveGateway_Subscription" targetRef="User_SelectPaymentMethod"/>
    <bpmn:sequenceFlow id="SequenceFlow_LogIntoGame" name="yes" sourceRef="ExclusiveGateway_Subscription" targetRef="User_LogIntoGame"/>
    <bpmn:sequenceFlow id="SequenceFlow_Gateway_PaymentChoice" sourceRef="User_SelectPaymentMethod" targetRef="ExclusiveGateway_PaymentMethod"/>

    <!-- Payment Method Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_EnterCreditCardInfo" name="credit card" sourceRef="ExclusiveGateway_PaymentMethod" targetRef="User_CreditCard"/>
    <bpmn:sequenceFlow id="SequenceFlow_EnterBankAccountInfo" name="bank account" sourceRef="ExclusiveGateway_PaymentMethod" targetRef="User_BankAccount"/>

    <!-- Payment Merge Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_MergePaymentMethods" name="" sourceRef="User_CreditCard" targetRef="ExclusiveGateway_PaymentMerge"/>
    <bpmn:sequenceFlow id="SequenceFlow_MergeBankToCredit" name="" sourceRef="User_BankAccount" targetRef="ExclusiveGateway_PaymentMerge"/>

    <!-- Character Creation Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_SelectCharacterDetails" sourceRef="User_LogIntoGame" targetRef="ParallelGateway_CharacterCreation"/>
    <bpmn:sequenceFlow id="SequenceFlow_SelectRealm" sourceRef="ParallelGateway_CharacterCreation" targetRef="User_SelectRealm"/>
    <bpmn:sequenceFlow id="SequenceFlow_SelectRace" sourceRef="ParallelGateway_CharacterCreation" targetRef="User_SelectRace"/>
    <bpmn:sequenceFlow id="SequenceFlow_SelectClass" sourceRef="ParallelGateway_CharacterCreation" targetRef="User_SelectClass"/>

    <!-- Character Details Merge Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_MergeCharacterDetails1" name="" sourceRef="User_SelectRealm" targetRef="ParallelGateway_CharacterMerge"/>
    <bpmn:sequenceFlow id="SequenceFlow_MergeCharacterDetails2" name="" sourceRef="User_SelectRace" targetRef="ParallelGateway_CharacterMerge"/>
    <bpmn:sequenceFlow id="SequenceFlow_MergeCharacterDetails3" name="" sourceRef="User_SelectClass" targetRef="ParallelGateway_CharacterMerge"/>

    <!-- Character Name Planning Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_ComingUpNames" sourceRef="ParallelGateway_AccountSetup" targetRef="User_EnterName"/>
    <bpmn:sequenceFlow id="SequenceFlow_Gateway_NameAvailable" name="" sourceRef="User_EnterName" targetRef="ExclusiveGateway_NameAvailable"/>

    <!-- Name Availability Loop Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_EnterNameAgain" name="no" sourceRef="ExclusiveGateway_NameAvailable" targetRef="User_EnterNameAgain"/>
    <bpmn:sequenceFlow id="SequenceFlow_GetConfirmation" name="yes" sourceRef="ExclusiveGateway_NameAvailable" targetRef="User_GetConfirmation"/>

    <!-- Final Flow to End Event -->
    <bpmn:sequenceFlow id="SequenceFlow_EndEvent" sourceRef="User_GetConfirmation" targetRef="EndEvent_CharacterCreated"/>

  </bpmn:process>
</bpmn:definitions>