<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_BuildingHouse_002" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:message id="Message_ArchitectDraft"/>
  <bpmn:message id="Message_OrdersProcessed"/>

  <bpmn:collaboration id="Collaboration_BuildingHouse">
    <bpmn:participant id="Participant_Customer" name="Customer" processRef="Process_Main"/>
    <bpmn:participant id="Participant_Architect" name="Architect"/>
    
    <bpmn:messageFlow id="MessageFlow_SendRequirements" sourceRef="Task_SendRequirements" targetRef="Task_DraftPlan">
      <bpmn:name>Send Requirements</bpmn:name>
    </bpmn:messageFlow>
  </bpmn:collaboration>

  <bpmn:process id="Process_Main" isExecutable="false" name="Building a House">
    
    <!-- Start Event -->
    <bpmn:startEvent id="Start_BuildHouse" name="Wish to build house">
      <bpmn:outgoing>Sequence_StartToCollect</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Collect Requirements Task -->
    <bpmn:userTask id="Task_CollectRequirements" name="Collect requirements">
      <bpmn:incoming>Sequence_StartToCollect</bpmn:incoming>
      <bpmn:outgoing>Sequence_ToSendReq</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Send Requirements Task -->
    <bpmn:userTask id="Task_SendRequirements" name="Send requirements to architect">
      <bpmn:incoming>Sequence_ToSendReq</bpmn:incoming>
      <bpmn:outgoing>Sequence_WaitDraft</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Intermediate Catch Event for Draft -->
    <bpmn:intermediateCatchEvent id="Event_DraftReceived" name="Receive draft">
      <bpmn:messageEventDefinition ref="Message_ArchitectDraft"/>
      <bpmn:incoming>Sequence_WaitDraft</bpmn:incoming>
      <bpmn:outgoing>Sequence_ToCheckDraft</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Check Draft Task -->
    <bpmn:userTask id="Task_CheckDraft" name="Refine requirements">
      <bpmn:incoming>Sequence_ToCheckDraft</bpmn:incoming>
      <bpmn:outgoing>Sequence_Gateway_DraftSufficient</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Draft Sufficient Gateway -->
    <bpmn:exclusiveGateway id="Gateway_DraftSufficient" name="Draft sufficient?">
      <bpmn:incoming>Sequence_Gateway_DraftSufficient</bpmn:incoming>
      <bpmn:outgoing>Sequence_ToMaterialsList</bpmn:outgoing>
      <bpmn:outgoing>Sequence_BackToRefine</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Create Materials List Task -->
    <bpmn:userTask id="Task_CreateMaterials" name="Create materials list">
      <bpmn:incoming>Sequence_ToMaterialsList</bpmn:incoming>
      <bpmn:outgoing>Sequence_Gateway_ParallelOrderCall</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel Gateway for Orders and Friends -->
    <bpmn:parallelGateway id="Gateway_OrderParallel" name="">
      <bpmn:incoming>Sequence_Gateway_ParallelOrderCall</bpmn:incoming>
      <bpmn:outgoing>Sequence_ToPlaceOrders</bpmn:outgoing>
      <bpmn:outgoing>Sequence_CallFriends</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Place Orders Task -->
    <bpmn:userTask id="Task_PlaceOrders" name="Order materials from online stores">
      <bpmn:incoming>Sequence_ToPlaceOrders</bpmn:incoming>
      <bpmn:outgoing>Sequence_WaitMaterialsArrive</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Intermediate Catch Event for Materials -->
    <bpmn:intermediateCatchEvent id="Event_MaterialsReceived" name="Order processed">
      <bpmn:messageEventDefinition ref="Message_OrdersProcessed"/>
      <bpmn:incoming>Sequence_WaitMaterialsArrive</bpmn:incoming>
      <bpmn:outgoing>Sequence_Gateway_ConvergeBuild</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Call Friends Task -->
    <bpmn:userTask id="Task_CallFriends" name="Call friends to build house">
      <bpmn:incoming>Sequence_CallFriends</bpmn:incoming>
      <bpmn:outgoing>Sequence_Gateway_ConvergeBuild</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel Gateway for Building Start -->
    <bpmn:parallelGateway id="Gateway_BuildStart" name="">
      <bpmn:incoming>Sequence_WaitMaterialsArrive</bpmn:incoming>
      <bpmn:outgoing>Sequence_StartBuilding</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Build House Task -->
    <bpmn:userTask id="Task_BuildHouse" name="Build house">
      <bpmn:incoming>Sequence_StartBuilding</bpmn:incoming>
      <bpmn:outgoing>Sequence_Gateway_PartyPrep</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Party Preparation Gateway -->
    <bpmn:exclusiveGateway id="Gateway_PartyPrep" name="">
      <bpmn:incoming>Sequence_Gateway_PartyPrep</bpmn:incoming>
      <bpmn:outgoing>Sequence_SendInvitations</bpmn:outgoing>
      <bpmn:outgoing>Sequence_CreateGuestList</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Send Invitations Task -->
    <bpmn:userTask id="Task_SendInvitations" name="Send invitations for party">
      <bpmn:incoming>Sequence_SendInvitations</bpmn:incoming>
      <bpmn:outgoing>Sequence_Gateway_ConvergeParty</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Create Guest List Task -->
    <bpmn:userTask id="Task_CreateGuestList" name="Create guest list for snacks">
      <bpmn:incoming>Sequence_CreateGuestList</bpmn:incoming>
      <bpmn:outgoing>Sequence_Gateway_ConvergeParty</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel Gateway for Party Completion -->
    <bpmn:parallelGateway id="Gateway_PartyComplete" name="">
      <bpmn:incoming>Sequence_Gateway_ConvergeParty</bpmn:incoming>
      <bpmn:outgoing>Sequence_ToEndEvent</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- End Event -->
    <bpmn:endEvent id="End_HouseBuilt" name="House party prepared">
      <bpmn:incoming>Sequence_ToEndEvent</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Sequence_StartToCollect" sourceRef="Start_BuildHouse" targetRef="Task_CollectRequirements"/>
    <bpmn:sequenceFlow id="Sequence_ToSendReq" sourceRef="Task_CollectRequirements" targetRef="Task_SendRequirements"/>
    <bpmn:sequenceFlow id="Sequence_WaitDraft" name="" sourceRef="Task_SendRequirements" targetRef="Event_DraftReceived"/>
    <bpmn:sequenceFlow id="Sequence_ToCheckDraft" sourceRef="Event_DraftReceived" targetRef="Task_CheckDraft"/>
    <bpmn:sequenceFlow id="Sequence_Gateway_DraftSufficient" name="" sourceRef="Task_CheckDraft" targetRef="Gateway_DraftSufficient"/>
    <bpmn:sequenceFlow id="Sequence_ToMaterialsList" name="Yes - Draft sufficient" sourceRef="Gateway_DraftSufficient" targetRef="Task_CreateMaterials"/>
    <bpmn:sequenceFlow id="Sequence_BackToRefine" name="No - Refine again" sourceRef="Gateway_DraftSufficient" targetRef="Task_CheckDraft"/>
    <bpmn:sequenceFlow id="Sequence_Gateway_ParallelOrderCall" sourceRef="Task_CreateMaterials" targetRef="Gateway_OrderParallel"/>
    <bpmn:sequenceFlow id="Sequence_ToPlaceOrders" name="" sourceRef="Gateway_OrderParallel" targetRef="Task_PlaceOrders"/>
    <bpmn:sequenceFlow id="Sequence_CallFriends" name="" sourceRef="Gateway_OrderParallel" targetRef="Task_CallFriends"/>
    <bpmn:sequenceFlow id="Sequence_WaitMaterialsArrive" sourceRef="Task_PlaceOrders" targetRef="Event_MaterialsReceived"/>
    <bpmn:sequenceFlow id="Sequence_Gateway_ConvergeBuild" name="" sourceRef="Gateway_OrderParallel" targetRef="Gateway_BuildStart"/>
    <bpmn:sequenceFlow id="Sequence_StartBuilding" sourceRef="Gateway_BuildStart" targetRef="Task_BuildHouse"/>
    <bpmn:sequenceFlow id="Sequence_Gateway_PartyPrep" sourceRef="Task_BuildHouse" targetRef="Gateway_PartyPrep"/>
    <bpmn:sequenceFlow id="Sequence_SendInvitations" name="" sourceRef="Gateway_PartyPrep" targetRef="Task_SendInvitations"/>
    <bpmn:sequenceFlow id="Sequence_CreateGuestList" name="" sourceRef="Gateway_PartyPrep" targetRef="Task_CreateGuestList"/>
    <bpmn:sequenceFlow id="Sequence_Gateway_ConvergeParty" sourceRef="Task_SendInvitations" targetRef="Gateway_PartyComplete"/>
    <bpmn:sequenceFlow id="Sequence_ToEndEvent" name="" sourceRef="Gateway_PartyComplete" targetRef="End_HouseBuilt"/>

  </bpmn:process>

</bpmn:definitions>