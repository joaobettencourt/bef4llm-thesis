<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_LANParty_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_LANParty">
    <bpmn:participant id="Participant_Organizer" name="LAN Party Organizer" processRef="Process_Main"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Main" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="Start_SendInvitations" name="Send invitations to friends">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Send Invitations -->
    <bpmn:userTask id="Task_SendInvitations" name="Send invitations">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_SplitParallel</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel Gateway Split -->
    <bpmn:parallelGateway id="GW_ParallelSplit" name="Start Planning">
      <bpmn:incoming>Flow_SplitParallel</bpmn:incoming>
      <bpmn:outgoing>Flow_GamesPath</bpmn:outgoing>
      <bpmn:outgoing>Flow_DatePath</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Path 1: Game Preparation -->
    <bpmn:userTask id="Task_ReceiveGames" name="Find out which games they want">
      <bpmn:incoming>Flow_GamesPath</bpmn:incoming>
      <bpmn:outgoing>Flow_WaitList</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Intermediate Catch Event for List of Games -->
    <bpmn:intermediateCatchEvent id="Event_ListOfGames" name="Receive list of games">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>Flow_WaitList</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckAvailability</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Gateway for Game Availability -->
    <bpmn:exclusiveGateway id="GW_GamesAvailable" name="All games available?">
      <bpmn:incoming>Flow_CheckAvailability</bpmn:incoming>
      <bpmn:outgoing>Flow_DownloadGames</bpmn:outgoing>
      <bpmn:outgoing>Flow_GamesReady</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task for Downloading Games (if missing) -->
    <bpmn:userTask id="Task_DownloadGames" name="Download missing games">
      <bpmn:incoming>Flow_DownloadGames</bpmn:incoming>
      <bpmn:outgoing>Flow_GamesReadyMerge</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Path 2: Date Confirmation Loop -->
    <bpmn:userTask id="Task_AppointDate" name="Appoint a date">
      <bpmn:incoming>Flow_DatePath</bpmn:incoming>
      <bpmn:outgoing>Flow_SuggestDate</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Intermediate Throw Event for Suggestion -->
    <bpmn:intermediateThrowEvent id="Event_SuggestDate" name="Suggest appointment">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>Flow_SuggestDate</bpmn:incoming>
      <bpmn:outgoing>Flow_WaitAnswer</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <!-- Intermediate Catch Event for Answer -->
    <bpmn:intermediateCatchEvent id="Event_Answer" name="Receive answer">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>Flow_WaitAnswer</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckAgreement</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Gateway for Agreement Check -->
    <bpmn:exclusiveGateway id="GW_Agreement" name="8+ friends agree?">
      <bpmn:incoming>Flow_CheckAgreement</bpmn:incoming>
      <bpmn:outgoing>Flow_AppointAgain</bpmn:outgoing>
      <bpmn:outgoing>Flow_DateConfirmed</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Convergence of Game and Date Paths -->
    <bpmn:parallelGateway id="GW_ParallelMerge" name="All Ready">
      <bpmn:incoming>Flow_GamesReadyMerge</bpmn:incoming>
      <bpmn:incoming>Flow_DateConfirmed</bpmn:incoming>
      <bpmn:outgoing>Flow_BeerCheck</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Beer Preparation -->
    <bpmn:userTask id="Task_CheckBeer" name="Find out beer requirement">
      <bpmn:incoming>Flow_BeerCheck</bpmn:incoming>
      <bpmn:outgoing>Flow_EnoughBeer</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway for Beer Check -->
    <bpmn:exclusiveGateway id="GW_EnoughBeer" name="Have enough beer?">
      <bpmn:incoming>Flow_EnoughBeer</bpmn:incoming>
      <bpmn:outgoing>Flow_BuyBeer</bpmn:outgoing>
      <bpmn:outgoing>Flow_PartyReady</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task for Buying Beer (if missing) -->
    <bpmn:userTask id="Task_BuyBeer" name="Buy what's missing">
      <bpmn:incoming>Flow_BuyBeer</bpmn:incoming>
      <bpmn:outgoing>Flow_PartyReadyMerge</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="End_EnjoyParty" name="Enjoy LAN party">
      <bpmn:incoming>Flow_PartyReadyMerge</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows Definition -->
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_SendInvitations" targetRef="Task_SendInvitations"/>
    
    <bpmn:sequenceFlow id="Flow_SplitParallel" sourceRef="Task_SendInvitations" targetRef="GW_ParallelSplit"/>
    
    <bpmn:sequenceFlow id="Flow_GamesPath" sourceRef="GW_ParallelSplit" targetRef="Task_ReceiveGames"/>
    
    <bpmn:sequenceFlow id="Flow_WaitList" sourceRef="Task_ReceiveGames" targetRef="Event_ListOfGames"/>
    
    <bpmn:sequenceFlow id="Flow_CheckAvailability" sourceRef="Event_ListOfGames" targetRef="GW_GamesAvailable"/>
    
    <bpmn:sequenceFlow id="Flow_DownloadGames" name="No" sourceRef="GW_GamesAvailable" targetRef="Task_DownloadGames"/>
    
    <bpmn:sequenceFlow id="Flow_GamesReady" name="Yes" sourceRef="GW_GamesAvailable" targetRef="GW_ParallelMerge"/>
    
    <bpmn:sequenceFlow id="Flow_DatePath" sourceRef="GW_ParallelSplit" targetRef="Task_AppointDate"/>
    
    <bpmn:sequenceFlow id="Flow_SuggestDate" sourceRef="Task_AppointDate" targetRef="Event_SuggestDate"/>
    
    <bpmn:sequenceFlow id="Flow_WaitAnswer" sourceRef="Event_SuggestDate" targetRef="Event_Answer"/>
    
    <bpmn:sequenceFlow id="Flow_CheckAgreement" sourceRef="Event_Answer" targetRef="GW_Agreement"/>
    
    <bpmn:sequenceFlow id="Flow_AppointAgain" name="No" sourceRef="GW_Agreement" targetRef="Task_AppointDate"/>
    
    <bpmn:sequenceFlow id="Flow_DateConfirmed" name="Yes" sourceRef="GW_Agreement" targetRef="GW_ParallelMerge"/>
    
    <bpmn:sequenceFlow id="Flow_GamesReadyMerge" sourceRef="Task_DownloadGames" targetRef="GW_ParallelMerge"/>
    
    <bpmn:sequenceFlow id="Flow_BeerCheck" sourceRef="GW_ParallelMerge" targetRef="Task_CheckBeer"/>
    
    <bpmn:sequenceFlow id="Flow_EnoughBeer" sourceRef="Task_CheckBeer" targetRef="GW_EnoughBeer"/>
    
    <bpmn:sequenceFlow id="Flow_BuyBeer" name="No" sourceRef="GW_EnoughBeer" targetRef="Task_BuyBeer"/>
    
    <bpmn:sequenceFlow id="Flow_PartyReady" name="Yes" sourceRef="GW_EnoughBeer" targetRef="End_EnjoyParty"/>
    
    <bpmn:sequenceFlow id="Flow_PartyReadyMerge" sourceRef="Task_BuyBeer" targetRef="End_EnjoyParty"/>

  </bpmn:process>
</bpmn:definitions>