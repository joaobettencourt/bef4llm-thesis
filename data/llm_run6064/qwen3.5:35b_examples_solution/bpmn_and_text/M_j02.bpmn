<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_LuxuryAirplane" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_AirplaneManufacturing" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="Start_ReceiveSpecs" name="Specifications Received">
      <bpmn:outgoing>Flow_DefineRequirements</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Define Requirements Task -->
    <bpmn:userTask id="Task_DefineRequirements" name="Define Customer Specifications">
      <bpmn:incoming>Flow_DefineRequirements</bpmn:incoming>
      <bpmn:outgoing>Gateway_ManufacturingSplit</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel Gateway for Manufacturing Teams -->
    <bpmn:parallelGateway id="Gateway_ManufacturingSplit" name="Manufacture Parts">
      <bpmn:incoming>Flow_DefineRequirements</bpmn:incoming>
      <bpmn:outgoing>Flow_RussianTeam</bpmn:outgoing>
      <bpmn:outgoing>Flow_IrishTeam</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Russian Team Task -->
    <bpmn:userTask id="Task_ManufactureVodka" name="Manufacture Vodka Bar (Russian Team)">
      <bpmn:incoming>Flow_RussianTeam</bpmn:incoming>
      <bpmn:outgoing>Flow_MergeParts1</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Irish Team Task -->
    <bpmn:userTask id="Task_ManufactureWhiskey" name="Manufacture Whiskey Bar (Irish Team)">
      <bpmn:incoming>Flow_IrishTeam</bpmn:incoming>
      <bpmn:outgoing>Flow_MergeParts2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel Gateway for Merging Parts -->
    <bpmn:parallelGateway id="Gateway_ManufacturingMerge" name="All Parts Ready">
      <bpmn:incoming>Flow_MergeParts1</bpmn:incoming>
      <bpmn:incoming>Flow_MergeParts2</bpmn:incoming>
      <bpmn:outgoing>Flow_AssembleInterior</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Assemble Interior Task -->
    <bpmn:userTask id="Task_AssembleInterior" name="Assemble Plane Interior">
      <bpmn:incoming>Flow_AssembleInterior</bpmn:incoming>
      <bpmn:outgoing>Flow_TestFlight</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Test Flight Task -->
    <bpmn:userTask id="Task_TestFlight" name="Conduct Test Flight">
      <bpmn:incoming>Flow_TestFlight</bpmn:incoming>
      <bpmn:outgoing>Gateway_CreateProtocol</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel Gateway for Protocol Creation -->
    <bpmn:parallelGateway id="Gateway_CreateProtocol" name="Create Test Protocol">
      <bpmn:incoming>Flow_TestFlight</bpmn:incoming>
      <bpmn:outgoing>Flow_SendToCompany</bpmn:outgoing>
      <bpmn:outgoing>Flow_SendToCustomer</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Send Protocol to Company -->
    <bpmn:userTask id="Task_SendProtocolCompany" name="Send Test Protocol (Internal)">
      <bpmn:incoming>Flow_SendToCompany</bpmn:incoming>
      <bpmn:outgoing>Flow_MergeProtocols1</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Send Protocol to Customer -->
    <bpmn:userTask id="Task_SendProtocolCustomer" name="Send Test Protocol (External)">
      <bpmn:incoming>Flow_SendToCustomer</bpmn:incoming>
      <bpmn:outgoing>Flow_MergeProtocols2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel Gateway for Merging Protocols -->
    <bpmn:parallelGateway id="Gateway_ProtocolMerge" name="All Protocols Sent">
      <bpmn:incoming>Flow_MergeProtocols1</bpmn:incoming>
      <bpmn:incoming>Flow_MergeProtocols2</bpmn:incoming>
      <bpmn:outgoing>Flow_DeliverPlane</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Deliver Plane Task -->
    <bpmn:userTask id="Task_DeliverPlane" name="Deliver Plane to Customer">
      <bpmn:incoming>Flow_DeliverPlane</bpmn:incoming>
      <bpmn:outgoing>Flow_CustomerConfirm</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="End_ConfirmationReceived" name="Customer Confirmation Received">
      <bpmn:incoming>Flow_CustomerConfirm</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Flow_DefineRequirements" sourceRef="Start_ReceiveSpecs" targetRef="Task_DefineRequirements"/>
    
    <bpmn:sequenceFlow id="Gateway_ManufacturingSplit_Flow1" name="" sourceRef="Gateway_ManufacturingSplit" targetRef="Task_ManufactureVodka"/>
    <bpmn:sequenceFlow id="Gateway_ManufacturingSplit_Flow2" name="" sourceRef="Gateway_ManufacturingSplit" targetRef="Task_ManufactureWhiskey"/>

    <bpmn:sequenceFlow id="Flow_MergeParts1" sourceRef="Task_ManufactureVodka" targetRef="Gateway_ManufacturingMerge"/>
    <bpmn:sequenceFlow id="Flow_MergeParts2" sourceRef="Task_ManufactureWhiskey" targetRef="Gateway_ManufacturingMerge"/>

    <bpmn:sequenceFlow id="Flow_AssembleInterior" sourceRef="Gateway_ManufacturingMerge" targetRef="Task_AssembleInterior"/>
    
    <bpmn:sequenceFlow id="Flow_TestFlight" sourceRef="Task_AssembleInterior" targetRef="Task_TestFlight"/>
    
    <bpmn:sequenceFlow id="Flow_SendToCompany" name="" sourceRef="Gateway_CreateProtocol" targetRef="Task_SendProtocolCompany"/>
    <bpmn:sequenceFlow id="Flow_SendToCustomer" name="" sourceRef="Gateway_CreateProtocol" targetRef="Task_SendProtocolCustomer"/>

    <bpmn:sequenceFlow id="Flow_MergeProtocols1" sourceRef="Task_SendProtocolCompany" targetRef="Gateway_ProtocolMerge"/>
    <bpmn:sequenceFlow id="Flow_MergeProtocols2" sourceRef="Task_SendProtocolCustomer" targetRef="Gateway_ProtocolMerge"/>

    <bpmn:sequenceFlow id="Flow_DeliverPlane" sourceRef="Gateway_ProtocolMerge" targetRef="Task_DeliverPlane"/>
    
    <bpmn:sequenceFlow id="Flow_CustomerConfirm" name="" sourceRef="Task_DeliverPlane" targetRef="End_ConfirmationReceived"/>

  </bpmn:process>
</bpmn:definitions>