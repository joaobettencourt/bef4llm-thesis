<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_Chainsaw_001" targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:collaboration id="Collab_Production_Customer">
    <bpmn:participant id="Participant_Production" name="Production Chainsaw GmbH" processRef="Process_Chainsaw_001"/>
    <bpmn:participant id="Participant_Customer" name="Customer"/>

    <!-- Message Flows -->
    <bpmn:messageFlow id="Msg_OrderRequest" sourceRef="Task_RequestProperties" targetRef="Event_StartOrder_Production">
      <bpmn:name>Chainsaw Order Request</bpmn:name>
    </bpmn:messageFlow>

  </bpmn:collaboration>

  <bpmn:process id="Process_Chainsaw_001" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Production">
      <bpmn:lane id="Lane_Manufacturing" name="Production Department">
        <!-- Flow Nodes assigned to Lane -->
        <bpmn:flowNodeRef>Event_StartOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SetProperties</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_OrderParts_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Service_Task_GuideBar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Service_Task_Chain</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Service_Task_Motor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Service_Task_Color</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Service_Task_Shield</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_OrderParts_Converge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_PartsReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InspectParts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssembleParts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_SendUpdateLoop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Timer24h</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendUpdate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_DecideLikesIt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_ReceiveFeedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendFirstSaw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Completed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="Event_StartOrder" name="Chainsaw Order Request">
      <bpmn:outgoing>Seq_Flow_SetProps</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Set Properties (Manual) -->
    <bpmn:task id="Task_SetProperties" name="Set Chainsaw Properties">
      <bpmn:incoming>Seq_Flow_SetProps</bpmn:incoming>
      <bpmn:outgoing>Seq_OrderParts_Split</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway for Ordering Parts -->
    <bpmn:parallelGateway id="GW_OrderParts_Split" name="Order Parts">
      <bpmn:incoming>Seq_OrderParts_Split</bpmn:incoming>
      <bpmn:outgoing>Seq_GuideBar</bpmn:outgoing>
      <bpmn:outgoing>Seq_Chain</bpmn:outgoing>
      <bpmn:outgoing>Seq_Motor</bpmn:outgoing>
      <bpmn:outgoing>Seq_Color</bpmn:outgoing>
      <bpmn:outgoing>Seq_Shield</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Service Tasks for Ordering Parts -->
    <bpmn:serviceTask id="Service_Task_GuideBar" name="Order Guide Bar">
      <bpmn:incoming>Seq_GuideBar</bpmn:incoming>
      <bpmn:outgoing>Seq_OrderParts_Converge_1</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Service_Task_Chain" name="Order Chain">
      <bpmn:incoming>Seq_Chain</bpmn:incoming>
      <bpmn:outgoing>Seq_OrderParts_Converge_2</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Service_Task_Motor" name="Order Motor">
      <bpmn:incoming>Seq_Motor</bpmn:incoming>
      <bpmn:outgoing>Seq_OrderParts_Converge_3</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Service_Task_Color" name="Order Color">
      <bpmn:incoming>Seq_Color</bpmn:incoming>
      <bpmn:outgoing>Seq_OrderParts_Converge_4</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Service_Task_Shield" name="Order Protective Shield">
      <bpmn:incoming>Seq_Shield</bpmn:incoming>
      <bpmn:outgoing>Seq_OrderParts_Converge_5</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Converging Gateway for Parts -->
    <bpmn:parallelGateway id="GW_OrderParts_Converge" name="All Parts Ordered">
      <bpmn:incoming>Seq_OrderParts_Converge_1</bpmn:incoming>
      <bpmn:incoming>Seq_OrderParts_Converge_2</bpmn:incoming>
      <bpmn:incoming>Seq_OrderParts_Converge_3</bpmn:incoming>
      <bpmn:incoming>Seq_OrderParts_Converge_4</bpmn:incoming>
      <bpmn:incoming>Seq_OrderParts_Converge_5</bpmn:incoming>
      <bpmn:outgoing>Seq_PartsArrive</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Intermediate Catch Event for Parts Arrival -->
    <bpmn:intermediateCatchEvent id="Event_PartsReceived" name="All Parts Received">
      <bpmn:incoming>Seq_PartsArrive</bpmn:incoming>
      <bpmn:outgoing>Seq_InspectParts</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Manual Task: Inspect Parts -->
    <bpmn:task id="Task_InspectParts" name="Manual Inspection">
      <bpmn:incoming>Seq_InspectParts</bpmn:incoming>
      <bpmn:outgoing>Seq_AssembleParts</bpmn:outgoing>
    </bpmn:task>

    <!-- Manual Task: Assemble Parts -->
    <bpmn:task id="Task_AssembleParts" name="Assemble Chainsaw">
      <bpmn:incoming>Seq_AssembleParts</bpmn:incoming>
      <bpmn:outgoing>Seq_SendUpdateLoop_Start</bpmn:outgoing>
    </bpmn:task>

    <!-- Update Loop Logic -->
    <bpmn:eventBasedGateway id="GW_SendUpdateLoop" name="Send Updates">
       <bpmn:incoming>Seq_SendUpdateLoop_Start</bpmn:incoming>
       <bpmn:outgoing>Seq_TimerTriggered</bpmn:outgoing>
    </bpmn:eventBasedGateway>

    <!-- Timer Event -->
    <bpmn:intermediateCatchEvent id="Event_Timer24h" name="24 Hours Passed">
      <bpmn:incoming>Seq_SendUpdateLoop_Start</bpmn:incoming>
      <bpmn:outgoing>Seq_SentUpdate</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task Send Update -->
    <bpmn:task id="Task_SendUpdate" name="Send Production Update">
       <bpmn:incoming>Seq_SentUpdate</bpmn:incoming>
       <bpmn:outgoing>Seq_LoopBackToAssembly</bpmn:outgoing>
    </bpmn:task>

    <!-- Decision Gateway for Feedback (After First Saw) -->
    <bpmn:exclusiveGateway id="GW_DecideLikesIt" name="Customer Likes It?">
      <bpmn:incoming>Seq_FeedbackReceived</bpmn:incoming>
      <bpmn:outgoing>Seq_Yes_Like</bpmn:outgoing>
      <bpmn:outgoing>Seq_No_Dislike</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task Send First Saw -->
    <bpmn:task id="Task_SendFirstSaw" name="Send First Chainsaw">
       <bpmn:incoming>Seq_AssembleParts</bpmn:incoming>
       <bpmn:outgoing>Seq_WaitFeedback</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Catch Event for Feedback -->
    <bpmn:intermediateCatchEvent id="Event_ReceiveFeedback" name="Receive Customer Feedback">
       <bpmn:incoming>Seq_WaitFeedback</bpmn:incoming>
       <bpmn:outgoing>Seq_FeedbackReceived</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Seq_Flow_SetProps" sourceRef="Event_StartOrder" targetRef="Task_SetProperties"/>
    <bpmn:sequenceFlow id="Seq_OrderParts_Split" sourceRef="Task_SetProperties" targetRef="GW_OrderParts_Split"/>

    <!-- Parallel Order Flows -->
    <bpmn:sequenceFlow id="Seq_GuideBar" sourceRef="GW_OrderParts_Split" targetRef="Service_Task_GuideBar"/>
    <bpmn:sequenceFlow id="Seq_Chain" sourceRef="GW_OrderParts_Split" targetRef="Service_Task_Chain"/>
    <bpmn:sequenceFlow id="Seq_Motor" sourceRef="GW_OrderParts_Split" targetRef="Service_Task_Motor"/>
    <bpmn:sequenceFlow id="Seq_Color" sourceRef="GW_OrderParts_Split" targetRef="Service_Task_Color"/>
    <bpmn:sequenceFlow id="Seq_Shield" sourceRef="GW_OrderParts_Split" targetRef="Service_Task_Shield"/>

    <!-- Converge Flows -->
    <bpmn:sequenceFlow id="Seq_OrderParts_Converge_1" sourceRef="Service_Task_GuideBar" targetRef="GW_OrderParts_Converge"/>
    <bpmn:sequenceFlow id="Seq_OrderParts_Converge_2" sourceRef="Service_Task_Chain" targetRef="GW_OrderParts_Converge"/>
    <bpmn:sequenceFlow id="Seq_OrderParts_Converge_3" sourceRef="Service_Task_Motor" targetRef="GW_OrderParts_Converge"/>
    <bpmn:sequenceFlow id="Seq_OrderParts_Converge_4" sourceRef="Service_Task_Color" targetRef="GW_OrderParts_Converge"/>
    <bpmn:sequenceFlow id="Seq_OrderParts_Converge_5" sourceRef="Service_Task_Shield" targetRef="GW_OrderParts_Converge"/>

    <!-- Post-Order Flow -->
    <bpmn:sequenceFlow id="Seq_PartsArrive" sourceRef="GW_OrderParts_Converge" targetRef="Event_PartsReceived"/>
    <bpmn:sequenceFlow id="Seq_InspectParts" sourceRef="Event_PartsReceived" targetRef="Task_InspectParts"/>
    <bpmn:sequenceFlow id="Seq_AssembleParts" sourceRef="Task_InspectParts" targetRef="Task_AssembleParts"/>

    <!-- Update Loop Flow -->
    <bpmn:sequenceFlow id="Seq_SendUpdateLoop_Start" sourceRef="GW_OrderParts_Converge" targetRef="Event_Timer24h"/>
    <bpmn:sequenceFlow id="Seq_SentUpdate" sourceRef="Task_SendUpdate" targetRef="GW_DecideLikesIt"/>

    <!-- Feedback Flow Logic -->
    <bpmn:sequenceFlow id="Seq_WaitFeedback" sourceRef="Task_AssembleParts" targetRef="Event_ReceiveFeedback"/>
    <bpmn:sequenceFlow id="Seq_FeedbackReceived" sourceRef="Event_ReceiveFeedback" targetRef="GW_DecideLikesIt"/>

    <!-- Decision Flows -->
    <bpmn:sequenceFlow id="Seq_Yes_Like" name="Like" sourceRef="GW_DecideLikesIt" targetRef="EndEvent_Completed">
      <bpmn:name>Customer Likes It?</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Completed" name="Chainsaw Order Completed"/>

  </bpmn:process>

</bpmn:definitions>