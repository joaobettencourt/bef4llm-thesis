<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_InspectionProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_MachineInspection" isExecutable="false" name="Machine Inspection Process">
    <!-- Start Event -->
    <bpmn:startEvent id="Start_ConnectDevice" name="Testing device connected">
      <bpmn:outgoing>SequenceFlow_EnterDetails</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- User Task: Enter Machine Details -->
    <bpmn:userTask id="Task_EnterMachineInfo" name="Enter machine type and serial number">
      <bpmn:incoming>SequenceFlow_EnterDetails</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AutoCollect</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Service Task: Auto-collect Data -->
    <bpmn:serviceTask id="Service_CollectData" name="Auto-collect values from machine">
      <bpmn:incoming>SequenceFlow_AutoCollect</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckResults</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Exclusive Gateway: Check Results -->
    <bpmn:exclusiveGateway id="Gateway_InspectErrors" name="Errors found?">
      <bpmn:incoming>SequenceFlow_CheckResults</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AskQuestions</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SkipToFinalize</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- User Task: Additional Questions (Conditional) -->
    <bpmn:userTask id="Task_AdditionalQuestions" name="Ask additional questions and input values">
      <bpmn:incoming>SequenceFlow_AskQuestions</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConvergeFinalize</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Exclusive Gateway: Converge Paths -->
    <bpmn:exclusiveGateway id="Gateway_MergePaths" name="">
      <bpmn:incoming>SequenceFlow_SkipToFinalize</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ConvergeFinalize</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToFinalReport</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- User Task: Final Inspection Report -->
    <bpmn:userTask id="Task_FinalReport" name="Review results and finalize">
      <bpmn:incoming>SequenceFlow_ToFinalReport</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndInspection</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="End_Event_Completed" name="Inspection completed">
      <bpmn:incoming>SequenceFlow_EndInspection</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_EnterDetails" sourceRef="Start_ConnectDevice" targetRef="Task_EnterMachineInfo">
      <bpmn:name>Enter details</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_AutoCollect" sourceRef="Task_EnterMachineInfo" targetRef="Service_CollectData">
      <bpmn:name>Begin inspection</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_CheckResults" sourceRef="Service_CollectData" targetRef="Gateway_InspectErrors">
      <bpmn:name>Data collected</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Yes Path -->
    <bpmn:sequenceFlow id="SequenceFlow_AskQuestions" name="Yes (Errors found)" sourceRef="Gateway_InspectErrors" targetRef="Task_AdditionalQuestions">
      <bpmn:name>Ask questions</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- No Path -->
    <bpmn:sequenceFlow id="SequenceFlow_SkipToFinalize" name="No (Skip)" sourceRef="Gateway_InspectErrors" targetRef="Gateway_MergePaths">
      <bpmn:name>Skip questions</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Convergence Path -->
    <bpmn:sequenceFlow id="SequenceFlow_ConvergeFinalize" sourceRef="Task_AdditionalQuestions" targetRef="Gateway_MergePaths">
      <bpmn:name>Input complete</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- To Final Report -->
    <bpmn:sequenceFlow id="SequenceFlow_ToFinalReport" sourceRef="Gateway_MergePaths" targetRef="Task_FinalReport">
      <bpmn:name>Merged flow</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- End Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_EndInspection" sourceRef="Task_FinalReport" targetRef="End_Event_Completed">
      <bpmn:name>Proceed to end</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>