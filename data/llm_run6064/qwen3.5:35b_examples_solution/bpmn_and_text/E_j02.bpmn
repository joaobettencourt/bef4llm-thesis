<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_BecomingAParent" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_MainProcess" name="Becoming A Parent Process" processRef="Process_BecomingAParent"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_BecomingAParent" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Parent wants maternity leave">
      <bpmn:outgoing>SequenceFlow_001</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Fetch information about potential models -->
    <bpmn:userTask id="Task_FetchInfo" name="Fetch information about potential models">
      <bpmn:description>Determine months duration and split between parents</bpmn:description>
      <bpmn:incoming>SequenceFlow_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_002</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task 2: Let parent select -->
    <bpmn:userTask id="Task_ParentSelect" name="Let parent select">
      <bpmn:description>Select duration and split arrangement</bpmn:description>
      <bpmn:incoming>SequenceFlow_002</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_003</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task 3: Collect relevant information -->
    <bpmn:userTask id="Task_CollectInfo" name="Collect relevant information">
      <bpmn:description>Gather necessary documentation and details</bpmn:description>
      <bpmn:incoming>SequenceFlow_003</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_004</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel Gateway for notification and gathering -->
    <bpmn:parallelGateway id="ParallelGateway_Notification" name="Notification &amp; Gathering">
      <bpmn:incoming>SequenceFlow_004</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_005</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_006</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 4a: Notify Social Security -->
    <bpmn:userTask id="Task_NotifySocialSecurity" name="Notify Social Security">
      <bpmn:description>Inform about maternity leave plans</bpmn:description>
      <bpmn:incoming>SequenceFlow_005</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_013</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task 4b: Notify Company -->
    <bpmn:userTask id="Task_NotifyCompany" name="Notify Company">
      <bpmn:description>Inform employer about leave plans</bpmn:description>
      <bpmn:incoming>SequenceFlow_006</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_014</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task 5a: Gather information from Social Security -->
    <bpmn:userTask id="Task_GatherSocialSecurity" name="Gather information from companies">
      <bpmn:description>Collect responses and confirmations</bpmn:description>
      <bpmn:incoming>SequenceFlow_013</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_015</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task 5b: Gather information from Company -->
    <bpmn:userTask id="Task_GatherCompany" name="Gather company confirmation">
      <bpmn:description>Receive employer acknowledgment</bpmn:description>
      <bpmn:incoming>SequenceFlow_014</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_016</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel Gateway to converge -->
    <bpmn:parallelGateway id="ParallelGateway_Converge" name="Convergence">
      <bpmn:incoming>SequenceFlow_015</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_016</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_007</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 6: At end of period decide about extension -->
    <bpmn:userTask id="Task_DecideExtension" name="Decide about maternity leave extension">
      <bpmn:description>Evaluate need for extending the leave</bpmn:description>
      <bpmn:incoming>SequenceFlow_007</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_008</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Exclusive Gateway for extension decision -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_Decision" name="Extension needed?">
      <bpmn:incoming>SequenceFlow_008</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_009</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_010</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 7a: Extend leave -->
    <bpmn:userTask id="Task_ExtendLeave" name="Process extension request">
      <bpmn:description>Negotiate and confirm extended period</bpmn:description>
      <bpmn:incoming>SequenceFlow_009</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_017</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task 7b: No extension -->
    <bpmn:userTask id="Task_NoExtension" name="End maternity leave">
      <bpmn:description>Prepare for return to work</bpmn:description>
      <bpmn:incoming>SequenceFlow_010</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_018</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel Gateway to converge before end -->
    <bpmn:parallelGateway id="ParallelGateway_End" name="End Convergence">
      <bpmn:incoming>SequenceFlow_017</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_018</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_019</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_1" name="Maternity leave process completed">
      <bpmn:incoming>SequenceFlow_019</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_001" sourceRef="StartEvent_1" targetRef="Task_FetchInfo"/>
    <bpmn:sequenceFlow id="SequenceFlow_002" sourceRef="Task_FetchInfo" targetRef="Task_ParentSelect"/>
    <bpmn:sequenceFlow id="SequenceFlow_003" sourceRef="Task_ParentSelect" targetRef="Task_CollectInfo"/>
    <bpmn:sequenceFlow id="SequenceFlow_004" sourceRef="Task_CollectInfo" targetRef="ParallelGateway_Notification"/>

    <!-- Notification paths -->
    <bpmn:sequenceFlow id="SequenceFlow_005" name="Notify Social Security" sourceRef="ParallelGateway_Notification" targetRef="Task_NotifySocialSecurity"/>
    <bpmn:sequenceFlow id="SequenceFlow_006" name="Notify Company" sourceRef="ParallelGateway_Notification" targetRef="Task_NotifyCompany"/>

    <!-- Gathering paths -->
    <bpmn:sequenceFlow id="SequenceFlow_013" sourceRef="Task_NotifySocialSecurity" targetRef="Task_GatherSocialSecurity"/>
    <bpmn:sequenceFlow id="SequenceFlow_014" sourceRef="Task_NotifyCompany" targetRef="Task_GatherCompany"/>

    <!-- Convergence after gathering -->
    <bpmn:sequenceFlow id="SequenceFlow_015" name="Social Security response" sourceRef="Task_GatherSocialSecurity" targetRef="ParallelGateway_Converge"/>
    <bpmn:sequenceFlow id="SequenceFlow_016" name="Company confirmation" sourceRef="Task_GatherCompany" targetRef="ParallelGateway_Converge"/>

    <!-- Extension decision path -->
    <bpmn:sequenceFlow id="SequenceFlow_007" sourceRef="ParallelGateway_Converge" targetRef="Task_DecideExtension"/>
    <bpmn:sequenceFlow id="SequenceFlow_008" name="End of period reached" sourceRef="Task_DecideExtension" targetRef="ExclusiveGateway_Decision">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[extensionNeeded]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Extension decision outcomes -->
    <bpmn:sequenceFlow id="SequenceFlow_009" name="Yes, extend" sourceRef="ExclusiveGateway_Decision" targetRef="Task_ExtendLeave">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[extensionNeeded]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_010" name="No extension needed" sourceRef="ExclusiveGateway_Decision" targetRef="Task_NoExtension">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[!extensionNeeded]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Final convergence -->
    <bpmn:sequenceFlow id="SequenceFlow_017" sourceRef="Task_ExtendLeave" targetRef="ParallelGateway_End"/>
    <bpmn:sequenceFlow id="SequenceFlow_018" sourceRef="Task_NoExtension" targetRef="ParallelGateway_End"/>

    <!-- End -->
    <bpmn:sequenceFlow id="SequenceFlow_019" name="Process completed" sourceRef="ParallelGateway_End" targetRef="EndEvent_1"/>
  </bpmn:process>
</bpmn:definitions>