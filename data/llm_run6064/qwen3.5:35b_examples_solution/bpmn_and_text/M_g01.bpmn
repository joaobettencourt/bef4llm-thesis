<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_3dModelProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_Custom3DPrint" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_RequestCustomModel" name="Request Custom Model">
      <bpmn:outgoing>SequenceFlow_SendSketches</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Send Sketches to Artist -->
    <bpmn:userTask id="Task_SendSketches" name="Send sketches to artist">
      <bpmn:incoming>SequenceFlow_SendSketches</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckSatisfaction</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway: Satisfied with result? -->
    <bpmn:exclusiveGateway id="Gateway_Satisfied" name="Satisfied&#10;with result?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow_CheckSatisfaction</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TellChanges</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ChooseColor</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Tell Artist Changes (Loop) -->
    <bpmn:userTask id="Task_TellChanges" name="Tell artist what to change">
      <bpmn:incoming>SequenceFlow_TellChanges</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckSatisfaction</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Choose Plastic Color -->
    <bpmn:manualTask id="Task_ChooseColor" name="Choose plastic color">
      <bpmn:incoming>SequenceFlow_ChooseColor</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_HaveStock</bpmn:outgoing>
    </bpmn:manualTask>

    <!-- Gateway: Have Color at Home? -->
    <bpmn:exclusiveGateway id="Gateway_HaveColor" name="Have color&#10;at home?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow_HaveStock</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OrderPlastic</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CheckAmount</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Order Plastic -->
    <bpmn:userTask id="Task_OrderPlastic" name="Order plastic">
      <bpmn:incoming>SequenceFlow_OrderPlastic</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConvergeMaterial</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway: Check Amount (<100g) -->
    <bpmn:exclusiveGateway id="Gateway_CheckAmount" name="Under 100&#10;grams?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow_CheckAmount</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AddToShoppingList</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ConvergeMaterial</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Add to Shopping List -->
    <bpmn:userTask id="Task_AddToShoppingList" name="Put on shopping list">
      <bpmn:incoming>SequenceFlow_AddToShoppingList</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConvergeMaterial</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway: Converge Material Acquisition -->
    <bpmn:exclusiveGateway id="Gateway_MaterialReady" name="" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow_ConvergeMaterial</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StartPrintingTasks</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Parallel Gateway Divergence -->
    <bpmn:parallelGateway id="Parallel_GoPrint" name="" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow_StartPrintingTasks</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_HeatPrinter</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_GenGcode</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Turn on Printer / Heat Bed & Extruder -->
    <bpmn:userTask id="Task_HeatPrinter" name="Turn printer on&#10;and heat bed/extruder">
      <bpmn:incoming>SequenceFlow_HeatPrinter</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConvergePrintTasks</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Generate G-code -->
    <bpmn:serviceTask id="Task_GenGcode" name="Generate gcode file">
      <bpmn:incoming>SequenceFlow_GenGcode</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConvergePrintTasks</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Parallel Gateway Convergence -->
    <bpmn:parallelGateway id="Parallel_PrintReady" name="" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow_ConvergePrintTasks</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PrintModel</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Print Model -->
    <bpmn:userTask id="Task_PrintModel" name="Print the model">
      <bpmn:incoming>SequenceFlow_PrintModel</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndProcess</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_ModelPrinted" name="Model Printed">
      <bpmn:incoming>SequenceFlow_EndProcess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_SendSketches" sourceRef="StartEvent_RequestCustomModel" targetRef="Task_SendSketches" />
    
    <bpmn:sequenceFlow id="SequenceFlow_CheckSatisfaction" name="" sourceRef="Task_SendSketches" targetRef="Gateway_Satisfied" />
    <bpmn:sequenceFlow id="SequenceFlow_TellChanges" name="No" sourceRef="Gateway_Satisfied" targetRef="Task_TellChanges" />
    
    <!-- Loop back from Tell Changes to Satisfaction Check -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckSatisfactionLoop" name="" sourceRef="Task_TellChanges" targetRef="Gateway_Satisfied" />

    <bpmn:sequenceFlow id="SequenceFlow_ChooseColor" name="Yes" sourceRef="Gateway_Satisfied" targetRef="Task_ChooseColor" />
    
    <bpmn:sequenceFlow id="SequenceFlow_HaveStock" sourceRef="Task_ChooseColor" targetRef="Gateway_HaveColor" />
    <bpmn:sequenceFlow id="SequenceFlow_OrderPlastic" name="No (Not at home)" sourceRef="Gateway_HaveColor" targetRef="Task_OrderPlastic" />
    
    <bpmn:sequenceFlow id="SequenceFlow_CheckAmount" name="Yes (At Home)" sourceRef="Gateway_HaveColor" targetRef="Gateway_CheckAmount" />
    <bpmn:sequenceFlow id="SequenceFlow_AddToShoppingList" name="Under 100g" sourceRef="Gateway_CheckAmount" targetRef="Task_AddToShoppingList" />
    
    <!-- Convergence for Material -->
    <bpmn:sequenceFlow id="SequenceFlow_ConvergeMaterial_1" sourceRef="Task_OrderPlastic" targetRef="Gateway_MaterialReady" />
    <bpmn:sequenceFlow id="SequenceFlow_ConvergeMaterial_2" name="" sourceRef="Task_AddToShoppingList" targetRef="Gateway_MaterialReady" />
    
    <!-- Convergence for Material (Default path from CheckAmount if >=100g) -->
    <bpmn:sequenceFlow id="SequenceFlow_ConvergeMaterial_3" name="Enough Stock" sourceRef="Gateway_CheckAmount" targetRef="Gateway_MaterialReady" />

    <bpmn:sequenceFlow id="SequenceFlow_StartPrintingTasks" sourceRef="Gateway_MaterialReady" targetRef="Parallel_GoPrint" />
    
    <!-- Parallel Tasks -->
    <bpmn:sequenceFlow id="SequenceFlow_HeatPrinter" name="" sourceRef="Parallel_GoPrint" targetRef="Task_HeatPrinter" />
    <bpmn:sequenceFlow id="SequenceFlow_GenGcode" name="" sourceRef="Parallel_GoPrint" targetRef="Task_GenGcode" />

    <!-- Convergence for Printing -->
    <bpmn:sequenceFlow id="SequenceFlow_ConvergePrintTasks_1" sourceRef="Task_HeatPrinter" targetRef="Parallel_PrintReady" />
    <bpmn:sequenceFlow id="SequenceFlow_ConvergePrintTasks_2" sourceRef="Task_GenGcode" targetRef="Parallel_PrintReady" />

    <bpmn:sequenceFlow id="SequenceFlow_PrintModel" name="" sourceRef="Parallel_PrintReady" targetRef="Task_PrintModel" />
    
    <!-- End -->
    <bpmn:sequenceFlow id="SequenceFlow_EndProcess" sourceRef="Task_PrintModel" targetRef="EndEvent_ModelPrinted" />

  </bpmn:process>
</bpmn:definitions>