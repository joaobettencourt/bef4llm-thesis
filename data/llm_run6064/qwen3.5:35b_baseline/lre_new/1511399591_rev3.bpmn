<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_WebDevProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_WebDevelopment">
    <bpmn:participant id="Pool_Process" name="Website Development Process" processRef="Proc_Development"/>
  </bpmn:collaboration>

  <bpmn:process id="Proc_Development" isExecutable="false">
    
    <!-- Lane Definitions -->
    <bpmn:laneSet id="LaneSet_WebDev">
      <bpmn:lane id="Lane_BusinessAnalyst" name="Business Analyst">
        <bpmn:flowNodeRef>StartEvent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AnalysisDataCollection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DesignReviewFeedback</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_WebDesigner" name="Web Designer">
        <bpmn:flowNodeRef>Task_IntegrateDesignModulePlacement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AdjustRedesignIntegrate</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Developer" name="PHP/HTML/CSS Specialist">
        <bpmn:flowNodeRef>Task_IntegrateOverallImplementation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AdjustBasedOnTestResults</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Tester" name="Tester">
        <bpmn:flowNodeRef>Task_TestFinalWebsite</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent" name="Collect Data &amp; Conduct Analysis">
        <bpmn:outgoing>SF_AnalysisToDesign</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Business Analyst Task -->
    <bpmn:task id="Task_AnalysisDataCollection" name="Collect Data &amp; Conduct Analysis">
        <bpmn:incoming>SF_AnalysisToDesign</bpmn:incoming>
        <bpmn:outgoing>SF_DesignIntegrateModulePlacement</bpmn:outgoing>
    </bpmn:task>

    <!-- Web Designer Task -->
    <bpmn:task id="Task_IntegrateDesignModulePlacement" name="Integrate Design &amp; Decide Module Placement">
        <bpmn:incoming>SF_DesignIntegrateModulePlacement</bpmn:incoming>
        <bpmn:outgoing>SF_AnalysisWaitForCompletion</bpmn:outgoing>
    </bpmn:task>

    <!-- Business Analyst Review Task -->
    <bpmn:task id="Task_DesignReviewFeedback" name="Check Design &amp; Provide Feedback">
        <bpmn:incoming>SF_AnalysisWaitForCompletion</bpmn:incoming>
        <bpmn:outgoing>SF_GatewayDesignAdjustmentDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Design Adjustment Decision Gateway -->
    <bpmn:exclusiveGateway id="Gateway_DesignAdjustment" name="Needs Adjustment?">
        <bpmn:incoming>SF_GatewayDesignAdjustmentDecision</bpmn:incoming>
        <bpmn:outgoing>SF_AdjustRedesignIntegrateLoopBack</bpmn:outgoing>
        <bpmn:outgoing>SF_DesignOKToDeveloper</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Web Designer Adjustment Task -->
    <bpmn:task id="Task_AdjustRedesignIntegrate" name="Adjust Design &amp; Integrate Module Placement">
        <bpmn:incoming>SF_AdjustRedesignIntegrateLoopBack</bpmn:incoming>
        <bpmn:outgoing>SF_AnalysisWaitForCompletionAgain</bpmn:outgoing>
    </bpmn:task>

    <!-- Developer Integration Task -->
    <bpmn:task id="Task_IntegrateOverallImplementation" name="Integrate with Overall Implementation">
        <bpmn:incoming>SF_DesignOKToDeveloper</bpmn:incoming>
        <bpmn:outgoing>SF_TestFinalWebsiteFlow</bpmn:outgoing>
    </bpmn:task>

    <!-- Tester Task -->
    <bpmn:task id="Task_TestFinalWebsite" name="Test Final Website">
        <bpmn:incoming>SF_TestFinalWebsiteFlow</bpmn:incoming>
        <bpmn:outgoing>SF_GatewayTestResultDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Test Result Decision Gateway -->
    <bpmn:exclusiveGateway id="Gateway_TestResult" name="Test OK?">
        <bpmn:incoming>SF_GatewayTestResultDecision</bpmn:incoming>
        <bpmn:outgoing>SF_ProvideResultsToDeveloperLoopBack</bpmn:outgoing>
        <bpmn:outgoing>SF_TestOKToEndEvent</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Developer Adjustment Task -->
    <bpmn:task id="Task_AdjustBasedOnTestResults" name="Adjust Based on Test Results &amp; Integrate">
        <bpmn:incoming>SF_ProvideResultsToDeveloperLoopBack</bpmn:incoming>
        <bpmn:outgoing>SF_TestFinalWebsiteFlowAgain</bpmn:outgoing>
    </bpmn:task>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_Success" name="Process Complete">
        <bpmn:incoming>SF_TestOKToEndEvent</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SF_AnalysisToDesign" sourceRef="StartEvent" targetRef="Task_IntegrateDesignModulePlacement"/>
    
    <bpmn:sequenceFlow id="SF_DesignIntegrateModulePlacement" name="Submit for Review" sourceRef="Task_IntegrateDesignModulePlacement" targetRef="Task_DesignReviewFeedback"/>

    <bpmn:sequenceFlow id="SF_AnalysisWaitForCompletion" name="Complete Design Check" sourceRef="Task_DesignReviewFeedback" targetRef="Gateway_DesignAdjustment"/>
    
    <bpmn:sequenceFlow id="SF_AdjustRedesignIntegrateLoopBack" name="Needs Adjustment (Yes)" sourceRef="Gateway_DesignAdjustment" targetRef="Task_AdjustRedesignIntegrate">
        <bpmn:name>Needs Adjustment</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SF_AnalysisWaitForCompletionAgain" name="Submit for Review Again" sourceRef="Task_AdjustRedesignIntegrate" targetRef="Task_DesignReviewFeedback"/>

    <bpmn:sequenceFlow id="SF_DesignOKToDeveloper" name="Design OK (No)" sourceRef="Gateway_DesignAdjustment" targetRef="Task_IntegrateOverallImplementation">
        <bpmn:name>Design OK</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SF_TestFinalWebsiteFlow" name="Ready for Testing" sourceRef="Task_IntegrateOverallImplementation" targetRef="Task_TestFinalWebsite"/>

    <bpmn:sequenceFlow id="SF_GatewayTestResultDecision" name="Testing Complete" sourceRef="Task_TestFinalWebsite" targetRef="Gateway_TestResult"/>
    
    <bpmn:sequenceFlow id="SF_ProvideResultsToDeveloperLoopBack" name="Not OK (Yes)" sourceRef="Gateway_TestResult" targetRef="Task_AdjustBasedOnTestResults">
        <bpmn:name>Not OK</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SF_TestFinalWebsiteFlowAgain" name="Re-test After Adjustment" sourceRef="Task_AdjustBasedOnTestResults" targetRef="Task_TestFinalWebsite"/>

    <bpmn:sequenceFlow id="SF_TestOKToEndEvent" name="OK (No)" sourceRef="Gateway_TestResult" targetRef="EndEvent_Success">
        <bpmn:name>OK</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>