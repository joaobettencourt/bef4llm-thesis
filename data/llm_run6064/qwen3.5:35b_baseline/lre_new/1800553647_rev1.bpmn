<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ACME_Purchase_Process" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_ACME_001">
    <bpmn:participant id="Pool_ACME_Inc" name="ACME Inc Purchase Process" processRef="Proc_Purchase_Management"/>
  </bpmn:collaboration>

  <bpmn:process id="Proc_Purchase_Management" isExecutable="false">
    <bpmn:laneSet id="LaneSet_ACME_001">
      <bpmn:lane id="Lane_Department" name="Department">
        <bpmn:flowNodeRef>StartEvent_Demand</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_StockCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateRequisition</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Procurement" name="Central Procurement">
        <bpmn:flowNodeRef>Gateway_NewSupplierCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckSupplierInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MergeSuppliers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateNewSupplier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateOrderTemplate</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Approver" name="Approver">
        <bpmn:flowNodeRef>Task_ApproveTriggerPO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_PurchaseOrdered</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Demand" name="Demand Identified">
        <bpmn:outgoing>SF_StartToStockCheck</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Gateway 1: Stock Check -->
    <bpmn:exclusiveGateway id="Gateway_StockCheck" name="Enough Goods in Stock?">
        <bpmn:incoming>SF_StartToStockCheck</bpmn:incoming>
        <bpmn:outgoing>SF_GoToLocalConsumption</bpmn:outgoing>
        <bpmn:outgoing>SF_GoToRequisitionCreation</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event 1: Local Consumption -->
    <bpmn:endEvent id="EndEvent_LocalConsumption" name="Demand Satisfied">
        <bpmn:incoming>SF_GoToLocalConsumption</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task 1: Create Requisition (Department) -->
    <bpmn:task id="Task_CreateRequisition" name="Create Purchase Requisition">
        <bpmn:incoming>SF_GoToRequisitionCreation</bpmn:incoming>
        <bpmn:outgoing>SF_RequisitionToProcurementCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: Check Supplier Info (Procurement) -->
    <bpmn:task id="Task_CheckSupplierInfo" name="Check ERP for Supplier">
        <bpmn:incoming>SF_RequisitionToProcurementCheck</bpmn:incoming>
        <bpmn:outgoing>SF_InfoToNewSupplierGateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2: New Supplier Check -->
    <bpmn:exclusiveGateway id="Gateway_NewSupplierCheck" name="Is New Supplier?">
        <bpmn:incoming>SF_InfoToNewSupplierGateway</bpmn:incoming>
        <bpmn:outgoing>SF_CreateNewSupplierFlow</bpmn:outgoing>
        <bpmn:outgoing>SF_SkipCreationFlow</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 3: Create New Supplier (Procurement) -->
    <bpmn:task id="Task_CreateNewSupplier" name="Create Supplier in ERP">
        <bpmn:incoming>SF_CreateNewSupplierFlow</bpmn:incoming>
        <bpmn:outgoing>SF_SupplierCreatedToMerge</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 3: Merge Supplier Paths -->
    <bpmn:exclusiveGateway id="Gateway_MergeSuppliers" name="Supplier Ready?">
        <bpmn:incoming>SF_SupplierCreatedToMerge</bpmn:incoming>
        <bpmn:incoming>SF_SkipCreationFlow</bpmn:incoming>
        <bpmn:outgoing>SF_MergeToOrderTemplate</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 4: Create Order Template (Procurement) -->
    <bpmn:task id="Task_CreateOrderTemplate" name="Create Order Template">
        <bpmn:incoming>SF_MergeToOrderTemplate</bpmn:incoming>
        <bpmn:outgoing>SF_TemplateToApproval</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 5: Approval (Approver) -->
    <bpmn:task id="Task_ApproveTriggerPO" name="Approve &amp; Trigger PO">
        <bpmn:incoming>SF_TemplateToApproval</bpmn:incoming>
        <bpmn:outgoing>SF_POTriggedToEnd</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 2: Final -->
    <bpmn:endEvent id="EndEvent_PurchaseOrdered" name="Purchase Order Triggered">
        <bpmn:incoming>SF_POTriggedToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SF_StartToStockCheck" sourceRef="StartEvent_Demand" targetRef="Gateway_StockCheck"/>
    
    <bpmn:sequenceFlow id="SF_GoToLocalConsumption" name="Yes (Enough Stock)" sourceRef="Gateway_StockCheck" targetRef="EndEvent_LocalConsumption"/>
    
    <bpmn:sequenceFlow id="SF_GoToRequisitionCreation" name="No (Need Purchase)" sourceRef="Gateway_StockCheck" targetRef="Task_CreateRequisition"/>

    <bpmn:sequenceFlow id="SF_RequisitionToProcurementCheck" sourceRef="Task_CreateRequisition" targetRef="Task_CheckSupplierInfo"/>
    
    <bpmn:sequenceFlow id="SF_InfoToNewSupplierGateway" sourceRef="Task_CheckSupplierInfo" targetRef="Gateway_NewSupplierCheck"/>

    <bpmn:sequenceFlow id="SF_CreateNewSupplierFlow" name="Yes (Create)" sourceRef="Gateway_NewSupplierCheck" targetRef="Task_CreateNewSupplier"/>
    
    <bpmn:sequenceFlow id="SF_SkipCreationFlow" name="No (Known Supplier)" sourceRef="Gateway_NewSupplierCheck" targetRef="Gateway_MergeSuppliers"/>

    <bpmn:sequenceFlow id="SF_SupplierCreatedToMerge" sourceRef="Task_CreateNewSupplier" targetRef="Gateway_MergeSuppliers"/>
    
    <bpmn:sequenceFlow id="SF_MergeToOrderTemplate" name="Proceed to Order Template" sourceRef="Gateway_MergeSuppliers" targetRef="Task_CreateOrderTemplate"/>

    <bpmn:sequenceFlow id="SF_TemplateToApproval" sourceRef="Task_CreateOrderTemplate" targetRef="Task_ApproveTriggerPO"/>
    
    <bpmn:sequenceFlow id="SF_POTriggedToEnd" name="Purchase Order Triggered" sourceRef="Task_ApproveTriggerPO" targetRef="EndEvent_PurchaseOrdered"/>

  </bpmn:process>
</bpmn:definitions>