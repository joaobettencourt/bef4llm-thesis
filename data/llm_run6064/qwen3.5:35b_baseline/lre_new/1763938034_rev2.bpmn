<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_RewardTrainingProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_RewardTraining_1">
    <bpmn:participant id="Pool_EmployeeManagement_1" name="Employee Reward &amp; Training Process" processRef="Proc_ManageRewards_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Proc_ManageRewards_1" isExecutable="false">
    
    <!-- Lane Definitions -->
    <bpmn:laneSet id="LaneSet_RewardProcess_1">
      <bpmn:lane id="Lane_Management_1">
        <bpmn:name>Management</bpmn:name>
        <bpmn:flowNodeRef>StartEvent_CheckPerformance_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckEmployeePerformance_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PerformanceCheck_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RewardTypeSelection_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SuggestDismissal_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SuggestTraining_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ChooseBenefit_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AnnounceMerge_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AnnounceEmployeeOfTheMonth_1</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_HR_2">
        <bpmn:name>HR Department</bpmn:name>
        <bpmn:flowNodeRef>Task_DismissEmployee_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProvideTraining_1</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Finance_3">
        <bpmn:name>Finance Department</bpmn:name>
        <bpmn:flowNodeRef>Task_CalculateFinancialReward_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PayFinancialReward_1</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>


    
     <!-- Events and Tasks -->

    <bpmn:startEvent id="StartEvent_CheckPerformance_1" name="Check Employee Performance">
        <bpmn:outgoing>SF_Start_PerformanceCheck_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_CheckEmployeePerformance_1" name="Evaluate Performance Level">
      <bpmn:incoming>SF_Start_PerformanceCheck_1</bpmn:incoming>
        <bpmn:outgoing>SF_GoToPerfGateway_1</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway to check performance level -->
    <bpmn:exclusiveGateway id="Gateway_PerformanceCheck_1" name="Performance Level?">
      <bpmn:incoming>SF_GoToPerfGateway_1</bpmn:incoming>
        <bpmn:outgoing>SF_DismissalPath_1</bpmn:outgoing>
       <bpmn:outgoing>SF_TrainingPath_1</bpmn:outgoing>
       <bpmn:outgoing>SF_RewardPath_1</bpmn:outgoing>
    </bpmn:exclusiveGateway>

     <!-- Dismissal Path -->
      <bpmn:task id="Task_SuggestDismissal_1" name="Suggest Employee Dismissal">
        <bpmn:incoming>SF_DismissalPath_1</bpmn:incoming>
          <bpmn:outgoing>SF_SendToHRDismissing_1</bpmn:outgoing>
      </bpmn:task>

     <!-- Training Path -->
       <bpmn:task id="Task_SuggestTraining_1" name="Suggest Employee for Training">
        <bpmn:incoming>SF_TrainingPath_1</bpmn:incoming>
          <bpmn:outgoing>SF_SendToHRTraining_1</bpmn:outgoing>
      </bpmn:task>

     <!-- Reward Path -->
       <bpmn:exclusiveGateway id="Gateway_RewardTypeSelection_1" name="Reward Type?">
        <bpmn:incoming>SF_GoToRewardDecision_1</bpmn:incoming>
          <bpmn:outgoing>SF_FinancialRewardPath_1</bpmn:outgoing>
           <bpmn:outgoing>SF_BenefitPath_1</bpmn:outgoing>
    </bpmn:exclusiveGateway>

     <!-- Financial Reward Tasks -->
       <bpmn:task id="Task_CalculateFinancialReward_1" name="Calculate Financial Reward">
        <bpmn:incoming>SF_FinancialRewardPath_1</bpmn:incoming>
          <bpmn:outgoing>SF_PayFinancialRewardFlow_1</bpmn:outgoing>
      </bpmn:task>

       <bpmn:task id="Task_PayFinancialReward_1" name="Pay Financial Reward">
        <bpmn:incoming>SF_PayFinancialRewardFlow_1</bpmn:incoming>
          <bpmn:outgoing>SF_FinanceRewardEndLink_1</bpmn:outgoing>
      </bpmn:task>

     <!-- Benefit Path -->
       <bpmn:task id="Task_ChooseBenefit_1" name="Choose Appropriate Benefit">
        <bpmn:incoming>SF_BenefitPath_1</bpmn:incoming>
          <bpmn:outgoing>SF_GoToAnnounceMerged_1</bpmn:outgoing>
      </bpmn:task>

     <!-- HR Tasks -->
       <bpmn:task id="Task_DismissEmployee_1" name="Dismiss Employee">
        <bpmn:incoming>SF_SendToHRDismissing_1</bpmn:incoming>
          <bpmn:outgoing>SF_EndDismissalEventLink_1</bpmn:outgoing>
      </bpmn:task>

       <bpmn:task id="Task_ProvideTraining_1" name="Provide Training">
        <bpmn:incoming>SF_SendToHRTraining_1</bpmn:incoming>
          <bpmn:outgoing>SF_EndTrainingEventLink_1</bpmn:outgoing>
      </bpmn:task>

     <!-- Final Announcement Task -->
       <bpmn:exclusiveGateway id="Gateway_AnnounceMerge_1" name="All Paths Merged">
        <bpmn:incoming>SF_FinanceRewardEndLink_1</bpmn:incoming>
          <bpmn:incoming>SF_GoToAnnounceMerged_1</bpmn:incoming>
        <bpmn:outgoing>SF_GoToAnnounceTask_1</bpmn:outgoing>
    </bpmn:exclusiveGateway>

       <bpmn:task id="Task_AnnounceEmployeeOfTheMonth_1" name="Announce Employee of the Month">
        <bpmn:incoming>SF_GoToAnnounceTask_1</bpmn:incoming>
          <bpmn:outgoing>SF_EndRewardEventLink_1</bpmn:outgoing>
      </bpmn:task>

    <!-- End Events --> 

       <bpmn:endEvent id="End_DismissalComplete_1" name="Employee Dismissed">
             <bpmn:incoming>SF_EndDismissalEventLink_1</bpmn:incoming> 
        </bpmn:endEvent>

         <bpmn:endEvent id="End_TrainingComplete_1" name="Training Completed">
            <bpmn:incoming>SF_EndTrainingEventLink_1</bpmn:incoming> 
        </bpmn:endEvent>

       <bpmn:endEvent id="End_RewardAnnounced_1" name="Reward Announced">
             <bpmn:incoming>SF_EndRewardEventLink_1</bpmn:incoming> 
        </bpmn:endEvent>


    <!-- Flows --> 

      <!-- Initial Flow --> 
     <bpmn:sequenceFlow id="SF_Start_PerformanceCheck_1" sourceRef="StartEvent_CheckPerformance_1" targetRef="Task_CheckEmployeePerformance_1"/>

       <!-- To Gateway (Performance Check) -->
       <bpmn:sequenceFlow id="SF_GoToPerfGateway_1" name="Evaluate Performance Level" sourceRef="Task_CheckEmployeePerformance_1" targetRef="Gateway_PerformanceCheck_1">
        </bpmn:sequenceFlow>

    <!-- Dismissal Path Flows --> 
     <bpmn:sequenceFlow id="SF_DismissalPath_1" name="&lt; 20%" sourceRef="Gateway_PerformanceCheck_1" targetRef="Task_SuggestDismissal_1"/>
       <bpmn:sequenceFlow id="SF_SendToHRDismissing_1" name="Suggest Dismissal to HR" sourceRef="Task_SuggestDismissal_1" targetRef="Task_DismissEmployee_1"/>
        <bpmn:sequenceFlow id="SF_EndDismissalEventLink_1" name="" sourceRef="Task_DismissEmployee_1" targetRef="End_DismissalComplete_1"/>

    <!-- Training Path Flows --> 
     <bpmn:sequenceFlow id="SF_TrainingPath_1" name="20% - 50%" sourceRef="Gateway_PerformanceCheck_1" targetRef="Task_SuggestTraining_1">
        </bpmn:sequenceFlow>
       <bpmn:sequenceFlow id="SF_SendToHRTraining_1" name="Suggest Training to HR" sourceRef="Task_SuggestTraining_1" targetRef="Task_ProvideTraining_1"/>
         <bpmn:sequenceFlow id="SF_EndTrainingEventLink_1" name="" sourceRef="Task_ProvideTraining_1" targetRef="End_TrainingComplete_1"/>

    <!-- Reward Path Flows --> 
     <bpmn:sequenceFlow id="SF_GoToRewardDecision_1" name="&gt; 75%" sourceRef="Gateway_PerformanceCheck_1" targetRef="Gateway_RewardTypeSelection_1">
        </bpmn:sequenceFlow>

       <!-- Financial Reward Flow Branches --> 
     <bpmn:sequenceFlow id="SF_FinancialRewardPath_1" name="Financial Reward" sourceRef="Gateway_RewardTypeSelection_1" targetRef="Task_CalculateFinancialReward_1"/>
         <bpmn:sequenceFlow id="SF_PayFinancialRewardFlow_1" name="" sourceRef="Task_CalculateFinancialReward_1" targetRef="Task_PayFinancialReward_1"/>
           <bpmn:sequenceFlow id="SF_FinanceRewardEndLink_1" name="" sourceRef="Task_PayFinancialReward_1" targetRef="Gateway_AnnounceMerge_1">
        </bpmn:sequenceFlow>

       <!-- Benefit Flow Branches --> 
     <bpmn:sequenceFlow id="SF_BenefitPath_1" name="Other Benefit" sourceRef="Gateway_RewardTypeSelection_1" targetRef="Task_ChooseBenefit_1"/>
         <bpmn:sequenceFlow id="SF_GoToAnnounceMerged_1" name="" sourceRef="Task_ChooseBenefit_1" targetRef="Gateway_AnnounceMerge_1">
        </bpmn:sequenceFlow>

    <!-- Final Announcement Flow --> 
     <bpmn:sequenceFlow id="SF_GoToAnnounceTask_1" name="Proceed to Announce" sourceRef="Gateway_AnnounceMerge_1" targetRef="Task_AnnounceEmployeeOfTheMonth_1"/>
         <bpmn:sequenceFlow id="SF_EndRewardEventLink_1" name="" sourceRef="Task_AnnounceEmployeeOfTheMonth_1" targetRef="End_RewardAnnounced_1">
        </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>