<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1a2b3c4d5e6f7g8h9i0j" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_AirplaneManufacturing">
    <bpmn:participant id="Participant_ManufacturingCompany" name="Luxury Airplane Manufacturing Company" processRef="Process_LuxuryAirplane"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_LuxuryAirplane" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_SalesTeam" name="Sales Team">
        <bpmn:flowNodeRef>StartEvent_ReceiveSpecs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendRequirements</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_RussianTeam" name="Russian Team">
        <bpmn:flowNodeRef>Task_ManufactureVodkaBar</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_IrishTeam" name="Irish Team">
        <bpmn:flowNodeRef>Task_ManufactureWhiskeyBar</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_AssemblyTeam" name="Assembly Team">
        <bpmn:flowNodeRef>Gateway_PartsReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssembleInterior</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_TestTeam" name="Test Team">
        <bpmn:flowNodeRef>Gateway_ParallelStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TestFlight</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_DeliveryTeam" name="Delivery Team">
        <bpmn:flowNodeRef>Gateway_ProtocolSent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendProtocols</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Customer" name="Customer">
        <bpmn:flowNodeRef>EndEvent_ConfirmationReceived</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_ReceiveSpecs" name="Receive Customer Specifications">
      <bpmn:outgoing>SequenceFlow_SpecToRequirements</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Send Requirements to Teams -->
    <bpmn:task id="Task_SendRequirements" name="Send Manufacturing Requirements">
      <bpmn:incoming>SequenceFlow_SpecToRequirements</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReqToRussianTeam</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway for Manufacturing Teams -->
    <bpmn:parallelGateway id="Gateway_ManufacturingParallel" name="Manufacturing Teams">
      <bpmn:incoming>SequenceFlow_ReqToRussianTeam</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToVodkaBar</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Manufacture Vodka Bar (Russian Team) -->
    <bpmn:task id="Task_ManufactureVodkaBar" name="Manufacture Vodka Bar">
      <bpmn:incoming>SequenceFlow_ToVodkaBar</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_VodkaToAssembly</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Manufacture Whiskey Bar (Irish Team) -->
    <bpmn:task id="Task_ManufactureWhiskeyBar" name="Manufacture Whiskey Bar">
      <bpmn:incoming>SequenceFlow_ToWhiskeyBar</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WhiskyToAssembly</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for Parts Received Check -->
    <bpmn:exclusiveGateway id="Gateway_PartsReceived">
      <bpmn:incoming>SequenceFlow_VodkaToAssembly</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WhiskyToAssembly</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Assemble Interior -->
    <bpmn:task id="Task_AssembleInterior" name="Assemble Plane Interior">
      <bpmn:incoming>SequenceFlow_WhiskyToAssembly</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToTestFlight</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway for Test Flight and Protocol -->
    <bpmn:parallelGateway id="Gateway_ParallelStart">
      <bpmn:incoming>SequenceFlow_ToTestFlight</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StartTestFlight</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Test Flight -->
    <bpmn:task id="Task_TestFlight" name="Conduct Test Flight">
      <bpmn:incoming>SequenceFlow_StartTestFlight</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FlightToProtocol</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Create and Send Test Protocol -->
    <bpmn:task id="Task_SendProtocols" name="Create &amp; Send Test Protocols">
      <bpmn:incoming>SequenceFlow_FlightToProtocol</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProtocolSent</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for Protocol Sent Check -->
    <bpmn:exclusiveGateway id="Gateway_ProtocolSent">
      <bpmn:incoming>SequenceFlow_ProtocolSent</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToDelivery</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Deliver Plane -->
    <bpmn:task id="Task_DeliverPlane" name="Deliver Airplane to Customer">
      <bpmn:incoming>SequenceFlow_ToDelivery</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CustomerConfirmation</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_ConfirmationReceived" name="Customer Confirmation Received">
      <bpmn:incoming>SequenceFlow_CustomerConfirmation</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Data Objects -->
    <bpmn:dataObjectReference id="Data_CustomerSpecs" name="Customer Specifications"/>
    <bpmn:dataObjectReference id="Data_TestProtocol" name="Test Protocol"/>
    
    <bpmn:association sourceRef="StartEvent_ReceiveSpecs" targetRef="Data_CustomerSpecs"/>
    <bpmn:association sourceRef="Task_SendProtocols" targetRef="Data_TestProtocol"/>

  </bpmn:process>

  <!-- Sequence Flows -->
  <bpmn:sequenceFlow id="SequenceFlow_SpecToRequirements" name="" sourceRef="StartEvent_ReceiveSpecs" targetRef="Task_SendRequirements"/>
  
  <bpmn:sequenceFlow id="SequenceFlow_ReqToRussianTeam" name="" sourceRef="Gateway_ManufacturingParallel" targetRef="Task_ManufactureVodkaBar"/>

  <bpmn:sequenceFlow id="SequenceFlow_ToWhiskeyBar" name="" sourceRef="Gateway_ManufacturingParallel" targetRef="Task_ManufactureWhiskeyBar"/>
  
  <bpmn:sequenceFlow id="SequenceFlow_VodkaToAssembly" name="" sourceRef="Task_ManufactureVodkaBar" targetRef="Gateway_PartsReceived"/>

  <bpmn:sequenceFlow id="SequenceFlow_WhiskyToAssembly" name="" sourceRef="Task_ManufactureWhiskeyBar" targetRef="Gateway_PartsReceived"/>
  
  <bpmn:sequenceFlow id="SequenceFlow_ToTestFlight" name="" sourceRef="Gateway_ParallelStart" targetRef="Task_TestFlight"/>

  <bpmn:sequenceFlow id="SequenceFlow_StartTestFlight" name="" sourceRef="Gateway_ManufacturingParallel" targetRef="Task_AssembleInterior"/>
  
  <bpmn:sequenceFlow id="SequenceFlow_FlightToProtocol" name="" sourceRef="Task_TestFlight" targetRef="Task_SendProtocols"/>

  <bpmn:sequenceFlow id="SequenceFlow_ProtocolSent" name="" sourceRef="Task_SendProtocols" targetRef="Gateway_ProtocolSent"/>
  
  <bpmn:sequenceFlow id="SequenceFlow_ToDelivery" name="" sourceRef="Gateway_ProtocolSent" targetRef="Task_DeliverPlane"/>

  <bpmn:sequenceFlow id="SequenceFlow_CustomerConfirmation" name="" sourceRef="Task_DeliverPlane" targetRef="EndEvent_ConfirmationReceived"/>
</bpmn:definitions>