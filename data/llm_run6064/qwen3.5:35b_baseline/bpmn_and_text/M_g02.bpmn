<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_LegoMachineBuild" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="Participant_Manufacturing" name="Lego Machine Manufacturing Process" processRef="Process_BuildMachine"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_BuildMachine" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="Start_Event_1" name="Begin Building Machine">
      <bpmn:outgoing>SequenceFlow_StartToDesign</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Develop Design -->
    <bpmn:task id="Task_DevelopDesign" name="Develop Basic Design">
      <bpmn:incoming>SequenceFlow_StartToDesign</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DesignToOrderSets</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Order Brick Sets -->
    <bpmn:task id="Task_OrderBrickSets" name="Order Lego Brick Sets">
      <bpmn:incoming>SequenceFlow_DesignToOrderSets</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OrdersToSortParts</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Sort Parts (Children) -->
    <bpmn:task id="Task_SortParts" name="Sort Parts into Containers">
      <bpmn:incoming>SequenceFlow_OrdersToSortParts</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SortToStockCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Check Stock Availability -->
    <bpmn:exclusiveGateway id="Gateway_StockCheck" name="Parts Available?">
      <bpmn:incoming>SequenceFlow_SortToStockCheck</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_RedesignBackToBuild</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_NextComponentLoop</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StockYes_Build</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_StockNo_Reorder</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Reorder Individual Parts -->
    <bpmn:task id="Task_ReorderParts" name="Reorder Individual Parts">
      <bpmn:incoming>SequenceFlow_StockNo_Reorder</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReorderToBuild</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Build Subcomponent -->
    <bpmn:task id="Task_BuildSubcomp" name="Build Individual Subcomponent">
      <bpmn:incoming>SequenceFlow_StockYes_Build</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ReorderToBuild</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BuildToTest</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Test Component -->
    <bpmn:task id="Task_TestComponent" name="Test Subcomponent">
      <bpmn:incoming>SequenceFlow_BuildToTest</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TestResult</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Test Result -->
    <bpmn:exclusiveGateway id="Gateway_TestResult" name="Test Successful?">
      <bpmn:incoming>SequenceFlow_TestResult</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Fail_Redesign</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_Pass_ComponentsDone</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Redesign & Rebuild -->
    <bpmn:task id="Task_RedesignRebuild" name="Redesign and Rebuild">
      <bpmn:incoming>SequenceFlow_Fail_Redesign</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RedesignBackToBuild</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: All Components Done? -->
    <bpmn:exclusiveGateway id="Gateway_ComponentsDone" name="All Subcomponents Built?">
      <bpmn:incoming>SequenceFlow_Pass_ComponentsDone</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NextComponentLoop</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_AllAssemble</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Assemble Machine -->
    <bpmn:task id="Task_AssembleMachine" name="Assemble Subcomponents">
      <bpmn:incoming>SequenceFlow_AllAssemble</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AssembleToEnd</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="End_Event_1" name="Machine Built">
      <bpmn:incoming>SequenceFlow_AssembleToEnd</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>

  <!-- Sequence Flows -->
  <bpmn:sequenceFlow id="SequenceFlow_StartToDesign" name="" sourceRef="Start_Event_1" targetRef="Task_DevelopDesign"/>
  
  <bpmn:sequenceFlow id="SequenceFlow_DesignToOrderSets" name="" sourceRef="Task_DevelopDesign" targetRef="Task_OrderBrickSets"/>

  <bpmn:sequenceFlow id="SequenceFlow_OrdersToSortParts" name="" sourceRef="Task_OrderBrickSets" targetRef="Task_SortParts"/>
  
  <!-- Entry to Build Loop -->
  <bpmn:sequenceFlow id="SequenceFlow_SortToStockCheck" name="" sourceRef="Task_SortParts" targetRef="Gateway_StockCheck"/>

  <!-- Stock Check Logic -->
  <bpmn:sequenceFlow id="SequenceFlow_StockYes_Build" name="Parts Available" sourceRef="Gateway_StockCheck" targetRef="Task_BuildSubcomp"/>

  <!-- Reorder Logic -->
  <bpmn:sequenceFlow id="SequenceFlow_StockNo_Reorder" name="Parts Missing" sourceRef="Gateway_StockCheck" targetRef="Task_ReorderParts"/>

  <!-- Reorder to Build -->
  <bpmn:sequenceFlow id="SequenceFlow_ReorderToBuild" name="" sourceRef="Task_ReorderParts" targetRef="Task_BuildSubcomp"/>

  <!-- Build to Test -->
  <bpmn:sequenceFlow id="SequenceFlow_BuildToTest" name="" sourceRef="Task_BuildSubcomp" targetRef="Task_TestComponent"/>

  <!-- Test Result Logic -->
  <bpmn:sequenceFlow id="SequenceFlow_Fail_Redesign" name="Failed" sourceRef="Gateway_TestResult" targetRef="Task_RedesignRebuild"/>

  <!-- Test Pass to Component Check -->
  <bpmn:sequenceFlow id="SequenceFlow_Pass_ComponentsDone" name="" sourceRef="Gateway_TestResult" targetRef="Gateway_ComponentsDone"/>

  <!-- Redesign Loop Back -->
  <bpmn:sequenceFlow id="SequenceFlow_RedesignBackToBuild" name="" sourceRef="Task_RedesignRebuild" targetRef="Gateway_StockCheck"/>

  <!-- Component Completion Check Logic -->
  <bpmn:sequenceFlow id="SequenceFlow_NextComponentLoop" name="More Components?" sourceRef="Gateway_ComponentsDone" targetRef="Gateway_StockCheck"/>

  <!-- Final Assembly -->
  <bpmn:sequenceFlow id="SequenceFlow_AllAssemble" name="" sourceRef="Gateway_ComponentsDone" targetRef="Task_AssembleMachine"/>

  <!-- End Flow -->
  <bpmn:sequenceFlow id="SequenceFlow_AssembleToEnd" name="" sourceRef="Task_AssembleMachine" targetRef="End_Event_1"/>

</bpmn:definitions>