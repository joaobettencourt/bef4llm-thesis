<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_BuildTreeHouse" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="Participant_Homeowner" name="Homeowner Process" processRef="Process_BuildTreeHouse"/>
  </bpmn:collaboration>

  <bpmn:message id="Message_DraftReceived" />
  <bpmn:message id="Message_InviteSent" />

  <bpmn:process id="Process_BuildTreeHouse" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="Start_InitiateProject" name="Initiate Tree House Project">
      <bpmn:outgoing>SequenceFlow_CollectReq</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Collect Requirements -->
    <bpmn:task id="Task_CollectRequirements" name="Collect Initial Requirements">
      <bpmn:incoming>SequenceFlow_CollectReq</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendArchitect</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: Send to Architect -->
    <bpmn:task id="Task_SendToArchitect" name="Send Requirements to Architect">
      <bpmn:incoming>SequenceFlow_SendArchitect</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitDraft</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Event 1: Receive Draft -->
    <bpmn:startEvent id="Start_ReceiveDraft" name="Architect Sends Draft">
      <bpmn:messageEventDefinition ref="Message_DraftReceived"/>
      <bpmn:outgoing>SequenceFlow_RefinePlan</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 3: Refine Plan -->
    <bpmn:task id="Task_RefinePlan" name="Refine Requirements &amp; Draft">
      <bpmn:incoming>SequenceFlow_RefinePlan</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckReady</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Check Plan Readiness -->
    <bpmn:exclusiveGateway id="Gateway_PlanCheck" name="Plan Ready?">
      <bpmn:incoming>SequenceFlow_CheckReady</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendAdditionalReq</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CreateMaterialsList</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 4: Send Additional Requirements (Loop) -->
    <bpmn:task id="Task_SendAdditionalReq" name="Send Additional Requirements">
      <bpmn:incoming>SequenceFlow_SendAdditionalReq</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitDraft2</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Event 1 Loop Back -->
    <bpmn:startEvent id="Start_ReceiveDraftLoop" name="Architect Sends New Draft">
      <bpmn:messageEventDefinition ref="Message_DraftReceived"/>
      <bpmn:outgoing>SequenceFlow_RefinePlan</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 5: Create Material List -->
    <bpmn:task id="Task_CreateMaterialList" name="Create Materials List">
      <bpmn:incoming>SequenceFlow_CreateMaterialsList</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SplitOrderingBuilding</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2: Parallel Split -->
    <bpmn:parallelGateway id="Gateway_OrderBuildSplit" name="Start Orders &amp; Build Prep">
      <bpmn:incoming>SequenceFlow_SplitOrderingBuilding</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OrderMaterials1</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ContactFriends</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 6a: Order Materials (Category A) -->
    <bpmn:task id="Task_OrderMaterials1" name="Order Category 1 Materials">
      <bpmn:incoming>SequenceFlow_OrderMaterials1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_JoinOrders</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 6b: Order Materials (Category B) -->
    <bpmn:task id="Task_OrderMaterials2" name="Order Category 2 Materials">
      <bpmn:incoming>SequenceFlow_SplitOrders</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_JoinOrders</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for Orders -->
    <bpmn:parallelGateway id="Gateway_OrderSplit" name="Order Categories">
      <bpmn:incoming>SequenceFlow_SplitOrders</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OrderMaterials1</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_OrderMaterials2</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 7: Contact Friends -->
    <bpmn:task id="Task_ContactFriends" name="Send Messages to Friends">
      <bpmn:incoming>SequenceFlow_ContactFriends</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BuildHouseStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Join Orders and Build Prep -->
    <bpmn:parallelGateway id="Gateway_JoinBuild" name="Wait for Materials &amp; Friends">
      <bpmn:incoming>SequenceFlow_OrderMaterials2</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_BuildHouseStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_HouseBuiltEventTrigger</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Intermediate Event 2: House Built -->
    <bpmn:startEvent id="Start_HouseBuilt" name="House Completed">
      <bpmn:messageEventDefinition ref="Message_DraftReceived"/> 
      <bpmn:outgoing>SequenceFlow_SendInvites</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 8: Send Invitations -->
    <bpmn:task id="Task_SendInvites" name="Send Party Invitations">
      <bpmn:incoming>SequenceFlow_SendInvites</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CreateAttendeeList</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 9: Create Attendee List -->
    <bpmn:task id="Task_CreateAttendees" name="Create Attendee List">
      <bpmn:incoming>SequenceFlow_CreateAttendeeList</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BuySnacks</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 10: Buy Snacks -->
    <bpmn:task id="Task_BuySnacks" name="Buy Party Snacks">
      <bpmn:incoming>SequenceFlow_BuySnacks</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndPartyReady</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="End_PartyReady" name="Tree House Party Ready">
      <bpmn:incoming>SequenceFlow_EndPartyReady</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_CollectReq" sourceRef="Start_InitiateProject" targetRef="Task_CollectRequirements"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_SendArchitect" name="" sourceRef="Task_CollectRequirements" targetRef="Task_SendToArchitect"/>

    <!-- Loop Logic -->
    <bpmn:sequenceFlow id="SequenceFlow_WaitDraft" sourceRef="Task_SendToArchitect" targetRef="Start_ReceiveDraft"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_RefinePlan" name="" sourceRef="Start_ReceiveDraft" targetRef="Task_RefinePlan"/>
    <bpmn:sequenceFlow id="SequenceFlow_CheckReady" sourceRef="Task_RefinePlan" targetRef="Gateway_PlanCheck"/>

    <!-- Loop Back -->
    <bpmn:sequenceFlow id="SequenceFlow_SendAdditionalReq" name="" sourceRef="Gateway_PlanCheck" targetRef="Task_SendAdditionalReq">
      <bpmn:name>Needs Refinement</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_WaitDraft2" name="" sourceRef="Task_SendAdditionalReq" targetRef="Start_ReceiveDraftLoop"/>
    
    <!-- Main Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_CreateMaterialsList" name="" sourceRef="Gateway_PlanCheck" targetRef="Task_CreateMaterialList">
      <bpmn:name>Plan Approved</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Parallel Split -->
    <bpmn:sequenceFlow id="SequenceFlow_SplitOrderingBuilding" sourceRef="Task_CreateMaterialList" targetRef="Gateway_OrderBuildSplit"/>

    <!-- Order Path -->
    <bpmn:sequenceFlow id="SequenceFlow_ContactFriends" name="" sourceRef="Gateway_OrderBuildSplit" targetRef="Task_ContactFriends"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_SplitOrders" name="" sourceRef="Gateway_OrderBuildSplit" targetRef="Gateway_OrderSplit">
      <bpmn:name>Order Materials</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_OrderMaterials1" sourceRef="Gateway_OrderSplit" targetRef="Task_OrderMaterials1"/>
    
    <!-- Correcting Order Logic for Validity -->
    <bpmn:parallelGateway id="Gateway_OrdersJoin" name="All Orders Complete">
      <bpmn:incoming>SequenceFlow_JoinOrders</bpmn:incoming> 
       <bpmn:outgoing>SequenceFlow_BuildHouseStart</bpmn:outgoing>
    </bpmn:parallelGateway>

     <!-- Correcting Order Logic for Validity -->
    <bpmn:sequenceFlow id="SequenceFlow_OrderMaterials2" sourceRef="Gateway_OrderSplit" targetRef="Task_OrderMaterials2"/> 
  </bpmn:process>
</bpmn:definitions>