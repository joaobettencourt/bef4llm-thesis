<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_WorkAccidentReporting" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_WorkAccidents">
    <bpmn:participant id="Participant_EGovernmentSystem" name="E-Government Work Accident Reporting System" processRef="Process_AccidentHandling"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_AccidentHandling" isExecutable="false">
    <bpmn:startEvent id="Start_Event_1" name="Accident or Near Miss Occurs">
      <bpmn:outgoing>SequenceFlow_StartToGateway</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:exclusiveGateway id="Gateway_RoleCheck" name="Determine Reporting Obligation">
      <bpmn:incoming>SequenceFlow_StartToGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EmployeePath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SchoolPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PrivatePath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Employee Path -->
    <bpmn:task id="Task_ReportToEmployer" name="Report Accident to Employer Immediately">
      <bpmn:incoming>SequenceFlow_EmployeePath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToSeverityCheck</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_SeverityCheck" name="Fatality or Serious Injury?">
      <bpmn:incoming>SequenceFlow_ToSeverityCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InspectorateReport</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ProviderReport5Days</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Employer Tasks -->
    <bpmn:task id="Task_ReportToInspectorate" name="Report to Labour Inspectorate">
      <bpmn:incoming>SequenceFlow_InspectorateReport</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EmployerEnd1</bpmn:outgoing>
    </bpmn:task>

    <!-- Provider Reporting -->
    <bpmn:task id="Task_ReportToProvider" name="Report to Accident Insurance (Within 5 Days)">
      <bpmn:incoming>SequenceFlow_ProviderReport5Days</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EmployerEnd2</bpmn:outgoing>
    </bpmn:task>

    <!-- School Path -->
    <bpmn:startEvent id="Start_Event_School" name="School Accident Occurs">
      <bpmn:outgoing>SequenceFlow_ToDirectorateReport</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_ReportToDirectorate" name="Report to Competent Directorate">
      <bpmn:incoming>SequenceFlow_ToDirectorateReport</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SchoolEnd1</bpmn:outgoing>
    </bpmn:task>

    <!-- Private Insurance Path -->
    <bpmn:startEvent id="Start_Event_Private" name="Private Accident Occurs">
      <bpmn:outgoing>SequenceFlow_ToWrittenReport</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_ReportWritten" name="Report Accident in Writing Immediately">
      <bpmn:incoming>SequenceFlow_ToWrittenReport</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PrivateEnd1</bpmn:outgoing>
    </bpmn:task>

    <!-- End Events -->
    <bpmn:endEvent id="End_Event_Inspectorate" name="Inspection Report Filed">
      <bpmn:incoming>SequenceFlow_EmployerEnd1</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="End_Event_Provider" name="Insurance Report Filed">
      <bpmn:incoming>SequenceFlow_EmployerEnd2</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="End_Event_School_Reported" name="School/Directorate Reporting Complete">
      <bpmn:incoming>SequenceFlow_SchoolEnd1</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="End_Event_Private_Insured" name="Private Insurance Report Filed">
      <bpmn:incoming>SequenceFlow_PrivateEnd1</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Lane Set -->
    <bpmn:laneSet id="LaneSet_WorkAccidents">
      <bpmn:lane id="Lane_Employee" name="Employee/Insured Person">
        <bpmn:flowNodeRef>Start_Event_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReportToEmployer</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Employer" name="Employer/Institution">
        <bpmn:flowNodeRef>Gateway_SeverityCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReportToInspectorate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReportToProvider</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_School" name="School/University">
        <bpmn:flowNodeRef>Start_Event_School</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReportToDirectorate</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Private" name="Private Insured Party">
        <bpmn:flowNodeRef>Start_Event_Private</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReportWritten</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Authority" name="Authority/Insurance Provider">
        <bpmn:flowNodeRef>End_Event_Inspectorate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Event_Provider</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_School_Authority" name="Competent Directorate">
        <bpmn:flowNodeRef>End_Event_School_Reported</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Private_Insurance" name="Private Insurance Provider">
        <bpmn:flowNodeRef>End_Event_Private_Insured</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToGateway" sourceRef="Start_Event_1" targetRef="Gateway_RoleCheck"/>

    <bpmn:sequenceFlow id="SequenceFlow_EmployeePath" name="Insured Employee">
      <bpmn:name>Is Insured Employee</bpmn:name>
      <sourceRef>Gateway_RoleCheck</sourceRef>
      <targetRef>Task_ReportToEmployer</targetRef>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_SchoolPath" name="School/Student">
      <bpmn:name>School Accident</bpmn:name>
      <sourceRef>Gateway_RoleCheck</sourceRef>
      <targetRef>Start_Event_School</targetRef>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_PrivatePath" name="Private Insurance">
      <bpmn:name>Private Insured Party</bpmn:name>
      <sourceRef>Gateway_RoleCheck</sourceRef>
      <targetRef>Start_Event_Private</targetRef>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ToSeverityCheck" sourceRef="Task_ReportToEmployer" targetRef="Gateway_SeverityCheck"/>

    <bpmn:sequenceFlow id="SequenceFlow_InspectorateReport" name="Fatality/Serious Injury">
      <sourceRef>Gateway_SeverityCheck</sourceRef>
      <targetRef>Task_ReportToInspectorate</targetRef>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ProviderReport5Days" name="Injury/Death (3+ days)">
      <sourceRef>Gateway_SeverityCheck</sourceRef>
      <targetRef>Task_ReportToProvider</targetRef>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_EmployerEnd1" sourceRef="Task_ReportToInspectorate" targetRef="End_Event_Inspectorate"/>

    <bpmn:sequenceFlow id="SequenceFlow_EmployerEnd2" sourceRef="Task_ReportToProvider" targetRef="End_Event_Provider"/>

    <bpmn:sequenceFlow id="SequenceFlow_ToDirectorateReport" sourceRef="Start_Event_School" targetRef="Task_ReportToDirectorate"/>

    <bpmn:sequenceFlow id="SequenceFlow_SchoolEnd1" sourceRef="Task_ReportToDirectorate" targetRef="End_Event_School_Reported"/>

    <bpmn:sequenceFlow id="SequenceFlow_ToWrittenReport" sourceRef="Start_Event_Private" targetRef="Task_ReportWritten"/>

    <bpmn:sequenceFlow id="SequenceFlow_PrivateEnd1" sourceRef="Task_ReportWritten" targetRef="End_Event_Private_Insured"/>
  </bpmn:process>
</bpmn:definitions>