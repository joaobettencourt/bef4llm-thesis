<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_InspectionApp" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_MachineInspection">
    <bpmn:participant id="Participant_AppSystem" name="Machine Inspection Application" processRef="Process_InspectionFlow"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_InspectionFlow" isExecutable="false">
    <bpmn:dataObjectReference id="Data_MachineDetails" name="Machine Details"/>
    
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Operator" name="Inspector">
        <bpmn:flowNodeRef>StartEvent_MachineType</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_EnterDetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_PerformChecks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_CheckResults</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_AdditionalQuestions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Complete</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_MachineType" name="Start Inspection Session">
      <bpmn:outgoing>SequenceFlow_InitiateInspection</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Enter Details -->
    <bpmn:userTask id="UserTask_EnterDetails" name="Enter Machine Type &amp; Serial Number">
      <bpmn:incoming>SequenceFlow_InitiateInspection</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StartChecks</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task 2: Perform Checks (Questions + Auto-collect) -->
    <bpmn:manualTask id="UserTask_PerformChecks" name="Perform Inspection Steps">
      <bpmn:incoming>SequenceFlow_StartChecks</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EvaluateResults</bpmn:outgoing>
    </bpmn:manualTask>

    <!-- Gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_CheckResults" name="Additional Questions Needed?">
      <bpmn:incoming>SequenceFlow_EvaluateResults</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_YesQuestions</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoMoreInfo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 3: Additional Questions -->
    <bpmn:userTask id="UserTask_AdditionalQuestions" name="Ask Additional Questions">
      <bpmn:incoming>SequenceFlow_YesQuestions</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FinishInspection</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Complete" name="Inspection Complete">
      <bpmn:incoming>SequenceFlow_NoMoreInfo</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_FinishInspection</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_InitiateInspection" sourceRef="StartEvent_MachineType" targetRef="UserTask_EnterDetails"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_StartChecks" name="Begin Inspection" sourceRef="UserTask_EnterDetails" targetRef="UserTask_PerformChecks">
      <bpmn:name>Begin Inspection</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_EvaluateResults" name="" sourceRef="UserTask_PerformChecks" targetRef="ExclusiveGateway_CheckResults"/>

    <bpmn:sequenceFlow id="SequenceFlow_YesQuestions" name="Additional Info Required">
      <bpmn:name>Yes</bpmn:name>
      <bpmn:conditionExpression xsi:type="tFormalExpression">${resultsIndicateNeedForMoreInfo}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_NoMoreInfo" name="">
      <bpmn:name>No</bpmn:name>
      <bpmn:conditionExpression xsi:type="tFormalExpression">${!resultsIndicateNeedForMoreInfo}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_FinishInspection" name="" sourceRef="UserTask_AdditionalQuestions" targetRef="EndEvent_Complete"/>

    <!-- Data Association -->
    <bpmn:dataOutputAssociation id="Assoc_DataInput">
      <bpmn:sourceRef>UserTask_EnterDetails</bpmn:sourceRef>
      <bpmn:targetRef>Data_MachineDetails</bpmn:targetRef>
    </bpmn:dataOutputAssociation>

  </bpmn:process>
</bpmn:definitions>