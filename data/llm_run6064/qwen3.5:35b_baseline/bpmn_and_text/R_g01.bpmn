<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_DIYRepair_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_Diysmartphone">
    <bpmn:participant id="Participant_UserProcess" name="DIY Smartphone Repair Process" processRef="Process_DIYScreenRepair"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_DIYScreenRepair" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="Start_Event_EnterModel" name="Enter Smartphone Model & Issue">
      <bpmn:outgoing>SequenceFlow_StartToList</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Get Parts List -->
    <bpmn:task id="Task_GetPartsList" name="Get Materials, Tools & Ordering Choices">
      <bpmn:incoming>SequenceFlow_StartToList</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ListToInventoryCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Data Object for Parts List -->
    <bpmn:dataObjectReference id="Data_PartsList" name="Parts & Tools List"/>
    <bpmn:association sourceRef="Task_GetPartsList" targetRef="Data_PartsList">
      <bpmn:messageFlowRef ref="Message_Feedback_List"/>
    </bpmn:association>

    <!-- Gateway: Check Inventory / Sourcing Strategy -->
    <bpmn:exclusiveGateway id="Gateway_CheckInventory">
      <bpmn:incoming>SequenceFlow_ListToInventoryCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NeedBorrowing</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_DirectPurchase</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Contact Friends (Optional Sourcing) -->
    <bpmn:task id="Task_ContactFriends" name="Contact Friends for Borrowing/Buying Cheap">
      <bpmn:incoming>SequenceFlow_NeedBorrowing</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FriendsToPurchaseMerge</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Buy Remaining Items -->
    <bpmn:task id="Task_BuyRemaining" name="Buy Remaining Materials & Tools">
      <bpmn:incoming>SequenceFlow_DirectPurchase</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PurchaseToMerge</bpmn:outgoing>
    </bpmn:task>

    <!-- Merge Sourcing Paths -->
    <bpmn:exclusiveGateway id="Gateway_SourcingComplete">
      <bpmn:incoming>SequenceFlow_FriendsToPurchaseMerge</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_PurchaseToMerge</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SourcingToInstructions</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Receive Instructions -->
    <bpmn:dataObjectReference id="Data_Instructions" name="Repair Instructions"/>
    <bpmn:task id="Task_ReceiveInstructions" name="Receive Repair Instructions">
      <bpmn:incoming>SequenceFlow_SourcingToInstructions</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InstructionToRepair</bpmn:outgoing>
    </bpmn:task>

    <!-- Association for Instructions Data -->
    <bpmn:association sourceRef="Task_ReceiveInstructions" targetRef="Data_Instructions"/>

    <!-- Task: Perform Repair -->
    <bpmn:task id="Task_PerformRepair" name="Fix Smartphone Screen">
      <bpmn:incoming>SequenceFlow_InstructionToRepair</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RepairResult</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Repair Success Check -->
    <bpmn:exclusiveGateway id="Gateway_SuccessCheck">
      <bpmn:incoming>SequenceFlow_RepairResult</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SuccessPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_FailurePath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Path 1: Success -->
    <bpmn:task id="Task_SendReview" name="Send Review & Video of Fix">
      <bpmn:incoming>SequenceFlow_SuccessPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReviewToSuccessEnd</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 1 -->
    <bpmn:endEvent id="End_Event_Success" name="Repair Successful">
      <bpmn:incoming>SequenceFlow_ReviewToSuccessEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Path 2: Failure -->
    <bpmn:task id="Task_ShipExpert" name="Send to Expert for Repair">
      <bpmn:incoming>SequenceFlow_FailurePath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ExpertToFailureEnd</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 2 -->
    <bpmn:endEvent id="End_Event_Expert" name="Sent to Expert">
      <bpmn:incoming>SequenceFlow_ExpertToFailureEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows (Corrected IDs in logic above, defining them here) -->
    
  </bpmn:process>

  <!-- Correcting the XML structure for valid flow definitions within process scope -->
  
</bpmn:definitions>