<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_FarmingBot_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_FarmingBot">
    <bpmn:participant id="Participant_FarmbotSystem" name="Farming Bot System" processRef="Process_Farmbot"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Farmbot" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="Start_CreateBot_1" name="Create Custom Farming Bot">
      <bpmn:outgoing>SequenceFlow_StartToResourceSelection</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Resource Selection Phase - Parallel Collection -->
    <bpmn:parallelGateway id="Parallel_Gateway_ResourceStart_1"/>
    
    <bpmn:task id="Task_CollectRes_Wood" name="Collect Wood">
      <bpmn:incoming>SequenceFlow_StartToResourceSelection</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ResWoodComplete</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_CollectRes_Stone" name="Collect Stone">
      <bpmn:incoming>SequenceFlow_StartToResourceSelection</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ResStoneComplete</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_CollectRes_Iron" name="Collect Iron">
      <bpmn:incoming>SequenceFlow_StartToResourceSelection</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ResIronComplete</bpmn:outgoing>
    </bpmn:task>

    <!-- Priority Handling Gateway -->
    <bpmn:exclusiveGateway id="Exclusive_Gateway_Priority_1">
      <bpmn:incoming>SequenceFlow_ResourcesCollected</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_UrgentPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NormalPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Tool Creation Dependency Logic -->
    <bpmn:task id="Task_CreateTools" name="Create Tools from Resources">
      <bpmn:incoming>SequenceFlow_UrgentPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToolsReady</bpmn:outgoing>
    </bpmn:task>

    <!-- Resource Collection Completion -->
    <bpmn:parallelGateway id="Parallel_Gateway_ResourceEnd_1">
      <bpmn:incoming>SequenceFlow_ResWoodComplete</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ResStoneComplete</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ResIronComplete</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ResourcesCollected</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Transition to Farming Phase -->
    <bpmn:exclusiveGateway id="Exclusive_Gateway_StartFarming">
      <bpmn:incoming>SequenceFlow_ToolsReady</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FarmStart</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Farming Execution Phase -->
    <bpmn:startEvent id="Start_MilestoneNotification" name="Milestone Reached">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_NotifyPlayer</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_SendNotification" name="Send Milestone Notification to Player">
      <bpmn:incoming>SequenceFlow_NotifyPlayer</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ContinueFarming</bpmn:outgoing>
    </bpmn:task>

    <!-- Update Materials Subprocess (Parallel) -->
    <bpmn:startEvent id="Start_UpdateMaterials" name="Update Material List">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_ProcessUpdate</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_ProcessMaterialUpdate" name="Process Updated Materials Request">
      <bpmn:incoming>SequenceFlow_ProcessUpdate</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_UpdateComplete</bpmn:outgoing>
    </bpmn:task>

    <!-- Natural Disaster Exception Handling -->
    <bpmn:startEvent id="Start_Disaster" name="Natural Disaster">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_HandleDisaster</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_ResumeAfterDisaster" name="Recover from Disaster">
      <bpmn:incoming>SequenceFlow_HandleDisaster</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ResumedFarming</bpmn:outgoing>
    </bpmn:task>

    <!-- End Phase -->
    <bpmn:endEvent id="End_BotFinished" name="Bot Finished">
      <bpmn:incoming>SequenceFlow_FarmComplete</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:exclusiveGateway id="Exclusive_Gateway_EndChoice">
      <bpmn:incoming>SequenceFlow_BotFinished</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BragPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SendMaterialsPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Bragging Path -->
    <bpmn:task id="Task_BragToFriends" name="Brag to Selected Friends">
      <bpmn:incoming>SequenceFlow_BragPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Finished</bpmn:outgoing>
    </bpmn:task>

    <!-- Send Materials Path -->
    <bpmn:task id="Task_SendMaterials" name="Send Materials to Friends">
      <bpmn:incoming>SequenceFlow_SendMaterialsPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Finished2</bpmn:outgoing>
    </bpmn:task>

    <!-- Final End Event -->
    <bpmn:endEvent id="End_ProcessComplete" name="Process Complete">
      <bpmn:incoming>SequenceFlow_Finished</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_Finished2</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Data Objects for Dependencies and Priorities -->
    <bpmn:dataObjectReference id="Data_ResourceList"/>
    <bpmn:dataObjectReference id="Data_ToolRequirements"/>
    <bpmn:dataObjectReference id="Data_MaterialUpdates"/>
    
    <bpmn:association sourceRef="Task_CollectRes_Wood" targetRef="Data_ResourceList"/>
    <bpmn:association sourceRef="Task_CreateTools" targetRef="Data_ToolRequirements"/>
    <bpmn:association sourceRef="Task_ProcessMaterialUpdate" targetRef="Data_MaterialUpdates"/>

  </bpmn:process>

  <!-- Sequence Flows -->
  <bpmn:sequenceFlow id="SequenceFlow_StartToResourceSelection" name="" sourceRef="Start_CreateBot_1" targetRef="Parallel_Gateway_ResourceStart_1"/>
  
  <bpmn:sequenceFlow id="SequenceFlow_ResWoodComplete" name="" sourceRef="Task_CollectRes_Wood" targetRef="Parallel_Gateway_ResourceEnd_1"/>
  <bpmn:sequenceFlow id="SequenceFlow_ResStoneComplete" name="" sourceRef="Task_CollectRes_Stone" targetRef="Parallel_Gateway_ResourceEnd_1"/>
  <bpmn:sequenceFlow id="SequenceFlow_ResIronComplete" name="" sourceRef="Task_CollectRes_Iron" targetRef="Parallel_Gateway_ResourceEnd_1"/>

  <bpmn:sequenceFlow id="SequenceFlow_ResourcesCollected" name="" sourceRef="Parallel_Gateway_ResourceEnd_1" targetRef="Exclusive_Gateway_Priority_1"/>
  
  <bpmn:sequenceFlow id="SequenceFlow_UrgentPath" name="Is Urgent">
    <bpmn:name>Urgent Resources Required</bpmn:name>
  </bpmn:sequenceFlow>

  <bpmn:sequenceFlow id="SequenceFlow_NormalPath" name="" sourceRef="Exclusive_Gateway_Priority_1" targetRef="Parallel_Gateway_ResourceEnd_1"/>
  
  <bpmn:sequenceFlow id="SequenceFlow_ToolsReady" name="" sourceRef="Task_CreateTools" targetRef="Exclusive_Gateway_StartFarming"/>

  <!-- Farming Phase Flows -->
  <bpmn:parallelGateway id="Parallel_FarmLoopStart">
    <bpmn:incoming>SequenceFlow_FarmStart</bpmn:incoming>
    <bpmn:outgoing>SequenceFlow_FarmTask1</bpmn:outgoing>
    <bpmn:outgoing>SequenceFlow_NotifyPath</bpmn:outgoing>
  </bpmn:parallelGateway>

  <bpmn:task id="Task_MainFarming" name="Execute Farming Tasks">
    <bpmn:incoming>SequenceFlow_FarmTask1</bpmn:incoming>
    <bpmn:outgoing>SequenceFlow_FarmComplete</bpmn:outgoing>
  </bpmn:task>

  <!-- Notification Flow -->
  <bpmn:sequenceFlow id="SequenceFlow_NotifyPlayer" name="" sourceRef="Start_MilestoneNotification" targetRef="Task_SendNotification"/>
  
  <bpmn:parallelGateway id="Parallel_FarmLoopEnd">
    <bpmn:incoming>SequenceFlow_ContinueFarming</bpmn:incoming>
    <bpmn:outgoing>SequenceFlow_NotifyPath2</bpmn:outgoing>
  </bpmn:parallelGateway>

  <bpmn:sequenceFlow id="SequenceFlow_FarmStart" name="" sourceRef="Exclusive_Gateway_StartFarming" targetRef="Parallel_FarmLoopStart">
    <bpmn:name>Begin Farming</bpmn:name>
  </bpmn:sequenceFlow>

  <!-- Notification Flow -->
  <bpmn:sequenceFlow id="SequenceFlow_NotifyPath" name="" sourceRef="Parallel_FarmLoopEnd" targetRef="Task_SendNotification"/>
  
  <bpmn:parallelGateway id="Parallel_ContinueFarming">
    <bpmn:incoming>SequenceFlow_UpdateComplete</bpmn:incoming>
    <bpmn:outgoing>SequenceFlow_NotifyPath2</bpmn:outgoing>
  </bpmn:parallelGateway>

  <!-- Update Materials Flow -->
  <bpmn:sequenceFlow id="SequenceFlow_ProcessUpdate" name="" sourceRef="Start_UpdateMaterials" targetRef="Task_ProcessMaterialUpdate"/>
  
  <bpmn:sequenceFlow id="SequenceFlow_FarmComplete" name="" sourceRef="Parallel_ContinueFarming" targetRef="End_BotFinished">
    <bpmn:name>Farming Complete</bpmn:name>
  </bpmn:sequenceFlow>

  <!-- Disaster Handling Flow -->
  <bpmn:parallelGateway id="Parallel_DisasterJoin">
    <bpmn:incoming>SequenceFlow_ResumedFarming</bpmn:incoming>
    <bpmn:outgoing>SequenceFlow_NotifyPath2</bpmn:outgoing>
  </bpmn:parallelGateway>

  <!-- Update Materials Flow -->
  <bpmn:sequenceFlow id="SequenceFlow_UpdateComplete" name="" sourceRef="Task_ProcessMaterialUpdate" targetRef="Parallel_ContinueFarming">
    <bpmn:name>Continue Farming</bpmn:name>
  </bpmn:sequenceFlow>

  <!-- Disaster Handling Flow -->
  <bpmn:sequenceFlow id="SequenceFlow_HandleDisaster" name="" sourceRef="Start_Disaster" targetRef="Task_ResumeAfterDisaster"/>
  
  <bpmn:parallelGateway id="Parallel_FarmLoopEnd2">
    <bpmn:incoming>SequenceFlow_ResumedFarming</bpmn:incoming>
    <bpmn:outgoing>SequenceFlow_NotifyPath3</bpmn:outgoing>
  </bpmn:parallelGateway>

  <!-- Final Flow -->
  <bpmn:sequenceFlow id="SequenceFlow_Finished" name="" sourceRef="Task_BragToFriends" targetRef="End_ProcessComplete"/>
  
  <bpmn:sequenceFlow id="SequenceFlow_MaterialsSent" name="" sourceRef="Task_SendMaterials" targetRef="End_ProcessComplete">
    <bpmn:name>Send Materials</bpmn:name>
  </bpmn:sequenceFlow>

  <!-- End Phase Flows -->
  <bpmn:sequenceFlow id="SequenceFlow_BotFinished" name="" sourceRef="Task_MainFarming" targetRef="Exclusive_Gateway_EndChoice">
    <bpmn:name>Farm Complete</bpmn:name>
  </bpmn:sequenceFlow>

  <bpmn:sequenceFlow id="SequenceFlow_Finished2" name="" sourceRef="Task_SendMaterials" targetRef="End_ProcessComplete"/>

  <!-- Bragging Path -->
  <bpmn:sequenceFlow id="SequenceFlow_BragPath" name="" sourceRef="Exclusive_Gateway_EndChoice" targetRef="Task_BragToFriends"/>
  
  <!-- Send Materials Path -->
  <bpmn:sequenceFlow id="SequenceFlow_SendMaterialsPath" name="" sourceRef="Exclusive_Gateway_EndChoice" targetRef="Task_SendMaterials">
    <bpmn:name>Send Materials</bpmn:name>
  </bpmn:sequenceFlow>

  <!-- Notification Flow -->
  <bpmn:sequenceFlow id="SequenceFlow_ContinueFarming" name="" sourceRef="Task_SendNotification" targetRef="Parallel_FarmLoopEnd">
    <bpmn:name>Return to Farming</bpmn:name>
  </bpmn:sequenceFlow>

  <!-- Disaster Handling Flow -->
  <bpmn:parallelGateway id="Parallel_DisasterJoin2"/>

  <bpmn:sequenceFlow id="SequenceFlow_ResumedFarming" name="" sourceRef="Task_ResumeAfterDisaster" targetRef="Parallel_FarmLoopEnd">
    <bpmn:name>Continue Farming</bpmn:name>
  </bpmn:sequenceFlow>

  <!-- Message Definitions -->
  <bpmn:message id="Message_MilestoneNotification"/>
  <bpmn:message id="Message_UpdateMaterialsRequest"/>
  <bpmn:message id="Message_NaturalDisasterAlert"/>

</bpmn:definitions>