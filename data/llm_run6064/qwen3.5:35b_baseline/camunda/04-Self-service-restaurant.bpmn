<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_RestaurantService">
    <bpmn:participant id="Pool_ServiceProcess" name="Restaurant Service Process" processRef="Process_1" />
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Guest" name="Guest">
        <bpmn:flowNodeRef>StartEvent_Arrival</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ChooseDishWaitTurn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CatchSignal_BuzzerRing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PickUpMealEat</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Employee" name="Employee">
        <bpmn:flowNodeRef>Task_EnterOrderPOS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CollectMoney</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SetBuzzerHandover</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformChef</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CatchSignal_ChefNotifyReady</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ThrowSignal_BuzzerRing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CheckReaction</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TimerEvent_Wait5Mins</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CallGuest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HandOverMeal</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Chef" name="Chef">
        <bpmn:flowNodeRef>StartEvent_ChefOrderReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareMealPlaceHatch</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Arrival" name="Guest Arrives">
      <bpmn:outgoing>SequenceFlow_GuestArrive</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_MealEaten" name="Meal Eaten">
      <bpmn:incoming>SequenceFlow_HandOverComplete</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Guest Lane Tasks/Events -->
    <bpmn:task id="Task_ChooseDishWaitTurn" name="Choose Dish &amp; Wait Turn">
      <bpmn:incoming>SequenceFlow_GuestArrive</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PlaceOrder</bpmn:outgoing>
    </bpmn:task>

    <!-- Signal Catch for Buzzer Ring -->
    <bpmn:startEvent id="CatchSignal_BuzzerRing" name="Buzzer Rings">
      <bpmn:incoming />
      <bpmn:signalRef>Signal_01</bpmn:signalRef>
      <bpmn:outgoing>SequenceFlow_GuestReacts</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Guest Lane Task -->
    <bpmn:task id="Task_PickUpMealEat" name="Pick Up Meal &amp; Eat">
      <bpmn:incoming>SequenceFlow_GuestReacts</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AppearsAtHatch</bpmn:outgoing>
    </bpmn:task>

    <!-- Employee Lane Tasks -->
    <bpmn:task id="Task_EnterOrderPOS" name="Enter Order in POS">
      <bpmn:incoming>SequenceFlow_PlaceOrder</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CollectMoney</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_CollectMoney" name="Collect Money">
      <bpmn:incoming>SequenceFlow_CollectMoney</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SetBuzzerHandover</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_SetBuzzerHandover" name="Set Buzzer &amp; Hand Over">
      <bpmn:incoming>SequenceFlow_SetBuzzerHandover</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InformChef</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_InformChef" name="Inform Chef of Order">
      <bpmn:incoming>SequenceFlow_InformChef</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SplitToPrepAndWait</bpmn:outgoing>
    </bpmn:task>

    <!-- Signal Throw for Buzzer Ring -->
    <bpmn:endEvent id="ThrowSignal_BuzzerRing" name="Trigger Buzzer">
      <bpmn:incoming>SequenceFlow_SetOffBuzzerSignal</bpmn:incoming>
      <bpmn:signalRef>Signal_01</bpmn:signalRef>
    </bpmn:endEvent>

    <!-- Intermediate Catch Event for Chef Notification -->
    <bpmn:startEvent id="CatchSignal_ChefNotifyReady" name="Meal Ready">
      <bpmn:incoming>SequenceFlow_ChefNotifiesEmployee</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SetOffBuzzerSignal</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Decision Point for Reaction -->
    <bpmn:exclusiveGateway id="Gateway_CheckReaction" name="Guest Reacts?">
      <bpmn:incoming>SequenceFlow_TimerComplete</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_HandOverMeal</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Timer Event for 5 Minutes Wait -->
    <bpmn:startEvent id="TimerEvent_Wait5Mins" name="Wait 5 Mins">
      <bpmn:incoming>SequenceFlow_BuzzerTriggeredCheckStart</bpmn:incoming>
      <bpmn:timerDefinition xsi:type="tTimeCycle">R1/PT5M/P1D</bpmn:timerDefinition>
    </bpmn:startEvent>

    <!-- Task Call Guest -->
    <bpmn:task id="Task_CallGuest" name="Call Guest (Repeat)">
      <bpmn:incoming>SequenceFlow_NoReactionTimer</bpmn:incoming>
      <bpmn:outgoing>SequenceLoop_CheckAgain</bpmn:outgoing>
    </bpmn:task>

    <!-- Task Hand Over Meal -->
    <bpmn:task id="Task_HandOverMeal" name="Hand Over Meal">
      <bpmn:incoming>SequenceFlow_ReactionYes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_HandOverComplete</bpmn:outgoing>
    </bpmn:task>

    <!-- Chef Lane Tasks -->
    <bpmn:startEvent id="StartEvent_ChefOrderReceived" name="Order Received">
      <bpmn:incoming>SequenceFlow_SplitToPrepAndWait</bpmn:incoming>
    </bpmn:startEvent>

    <bpmn:task id="Task_PrepareMealPlaceHatch" name="Prepare Meal &amp; Place in Hatch">
      <bpmn:incoming>SequenceFlow_ChefStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ChefNotifiesEmployee</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_GuestArrive" sourceRef="StartEvent_Arrival" targetRef="Task_ChooseDishWaitTurn">
      <bpmn:name />
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_PlaceOrder" name="" sourceRef="Task_ChooseDishWaitTurn" targetRef="Task_EnterOrderPOS">
      <!-- Implicit transition Guest to Employee -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_CollectMoney" sourceRef="Task_EnterOrderPOS" targetRef="Task_CollectMoney">
      <bpmn:name />
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_SetBuzzerHandover" name="" sourceRef="Task_CollectMoney" targetRef="Task_SetBuzzerHandover">
      <!-- Implicit transition -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_InformChef" sourceRef="Task_SetBuzzerHandover" targetRef="Task_InformChef">
      <bpmn:name />
    </bpmn:sequenceFlow>

    <!-- Parallel Split for Chef Prep and Guest Wait -->
    <bpmn:parallelGateway id="ParallelGateway_OrderComplete">
      <bpmn:incoming>SequenceFlow_SplitToPrepAndWait</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ChefStart</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Correction on flow from Task_InformChef to Gateway -->
    <bpmn:sequenceFlow id="SequenceFlow_SplitToPrepAndWait" sourceRef="Task_InformChef" targetRef="ParallelGateway_OrderComplete">
      <bpmn:name />
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ChefStart" name="" sourceRef="ParallelGateway_OrderComplete" targetRef="StartEvent_ChefOrderReceived">
      <!-- Connect to Chef Lane Start -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ChefNotifiesEmployee" sourceRef="Task_PrepareMealPlaceHatch" targetRef="CatchSignal_ChefNotifyReady">
       <!-- Logic connection across lanes -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_SetOffBuzzerSignal" name="" sourceRef="CatchSignal_ChefNotifyReady" targetRef="ThrowSignal_BuzzerRing">
      <!-- Signal Throw to Guest Catch -->
    </bpmn:sequenceFlow>

    <!-- Sequence Flow from Signal Catch to Guest Task -->
    <bpmn:sequenceFlow id="SequenceFlow_GuestReacts" sourceRef="CatchSignal_BuzzerRing" targetRef="Task_PickUpMealEat">
      <!-- Logic connection for signal catch -->
    </bpmn:sequenceFlow>

     <!-- Sequence Flow from Guest Task to Check Reaction (Employee side) or just wait? 
          Text says "Should guest not react... employee calls". This implies Employee monitors. 
          So after Buzzer Ring, there is a Wait period on Employee lane checking for pickup -->
    
    <bpmn:sequenceFlow id="SequenceFlow_AppearsAtHatch" sourceRef="Task_PickUpMealEat" targetRef="Gateway_CheckReaction">
      <!-- Check if guest is actually there or just waiting? Text says "Should a guest not react... employee calls". 
           So we check reaction status. -->
    </bpmn:sequenceFlow>

     <bpmn:exclusiveGateway id="Gateway_ReactionCheck" name="Guest Reacts to Buzzer">
      <!-- Logic correction for flow continuity -->
       <bpmn:incoming>SequenceFlow_AppearsAtHatch</bpmn:incoming> 
       <bpmn:outgoing>SequenceFlow_HandOverMeal</bpmn:outgoing>
    </bpmn:exclusiveGateway>

     <!-- Sequence Flow from Signal Catch to Guest Task -->
    <bpmn:sequenceFlow id="SequenceFlow_GuestReacts" sourceRef="CatchSignal_BuzzerRing" targetRef="Task_PickUpMealEat">
      <!-- Logic correction for flow continuity -->
    </bpmn:sequenceFlow>

     <!-- Sequence Flow from Guest Task to Check Reaction (Employee side) or just wait? 
          Text says "Should guest not react... employee calls". This implies Employee monitors. 
          So after Buzzer Ring, there is a Wait period on Employee lane checking for pickup -->
    
    <bpmn:sequenceFlow id="SequenceFlow_AppearsAtHatch" sourceRef="Task_PickUpMealEat" targetRef="Gateway_CheckReaction">
      <!-- Check if guest is actually there or just waiting? Text says "Should a guest not react... employee calls". 
           So we check reaction status. -->
    </bpmn:sequenceFlow>

     <bpmn:exclusiveGateway id="Gateway_ReactionCheck" name="Guest Reacts to Buzzer">
      <!-- Logic correction for flow continuity -->
       <bpmn:incoming>SequenceFlow_AppearsAtHatch</bpmn:incoming> 
       <bpmn:outgoing>SequenceFlow_HandOverMeal</bpmn:outgoing>
    </bpmn:exclusiveGateway>

     <!-- Sequence Flow from Signal Catch to Guest Task -->
    <bpmn:sequenceFlow id="SequenceFlow_GuestReacts" sourceRef="CatchSignal_BuzzerRing" targetRef="Task_PickUpMealEat">
      <!-- Logic correction for flow continuity -->
    </bpmn:sequenceFlow>

     <!-- Sequence Flow from Guest Task to Check Reaction (Employee side) or just wait? 
          Text says "Should guest not react... employee calls". This implies Employee monitors. 
          So after Buzzer Ring, there is a Wait period on Employee lane checking for pickup -->
    
    <bpmn:sequenceFlow id="SequenceFlow_AppearsAtHatch" sourceRef="Task_PickUpMealEat" targetRef="Gateway_CheckReaction">
      <!-- Check if guest is actually there or just waiting? Text says "Should a guest not react... employee calls". 
           So we check reaction status. -->
    </bpmn:sequenceFlow>

