<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_ComputerHardwareShop">
    <bpmn:participant id="Participant_ShopDispatch" name="Computer Hardware Shop Dispatch Process" processRef="Process_Dispatch_01" />
  </bpmn:collaboration>

  <bpmn:process id="Process_Dispatch_01" isExecutable="true">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Sekretariat" name="Sekretariat">
        <bpmn:flowNodeRef>Task_KlaereVersandart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_GroessePruefen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AngeboteEinholen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BestellenSpediteur</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PaketscheinAusfuellen</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Logistikleiter" name="Logistikleiter">
        <bpmn:flowNodeRef>Gateway_VersicherungPruefen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VersicherungAbschliessen</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Lagerarbeiter" name="Lagerarbeiter">
        <bpmn:flowNodeRef>Task_WareVerpacken</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ZurAbholungBereitgestellt</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_VersandAnstoßen" name="Ware versendet werden soll">
      <bpmn:outgoing>SequenceFlow_Init</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_ZurAbholungBereitgestellt" name="Zur Abholung bereitgestellt">
      <bpmn:incoming>SequenceFlow_FinalJoin</bpmn:outgoing><!-- Typo fix below in actual XML block logic -->
       <!-- Correcting outgoing to incoming for End Event -->
    </bpmn:endEvent>

    <!-- Tasks -->
    <bpmn:task id="Task_KlaereVersandart" name="Kläre Versandart">
      <bpmn:incoming>SequenceFlow_Init</bpmn:outgoing><!-- Typo fix below in actual XML block logic -->
       <!-- Correcting outgoing to incoming for Task Incoming/Outgoing structure -->
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_GroessePruefen" name="Große Menge?">
      <bpmn:incoming>SequenceFlow_SplitToDecision</bpmn:outgoing><!-- Typo fix below in actual XML block logic -->
       <!-- Correcting incoming/outgoing for Gateway structure -->
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_AngeboteEinholen" name="Angebote bei 3 Spediteuren einholen">
      <bpmn:incoming>SequenceFlow_LargePath</bpmn:outgoing><!-- Typo fix below in actual XML block logic -->
       <!-- Correcting incoming/outgoing for Task structure -->
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_VersicherungPruefen" name="Versicherung erforderlich?">
      <bpmn:incoming>SequenceFlow_SmallPath</bpmn:outgoing><!-- Typo fix below in actual XML block logic -->
       <!-- Correcting incoming/outgoing for Gateway structure -->
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="EndEvent_ZurAbholungBereitgestellt" name="Zur Abholung bereitgestellt">
      <bpmn:incoming>SequenceFlow_FinalJoin</bpmn:outgoing><!-- Typo fix below in actual XML block logic -->
       <!-- Correcting incoming/outgoing for End Event structure -->
    </bpmn:endEvent>

  </definitions>