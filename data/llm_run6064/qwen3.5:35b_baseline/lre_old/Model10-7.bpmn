<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="MSPN Application Process" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="true">
    
    <!-- LaneSet -->
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_MSPN" name="MSPN">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegisterMeasurement</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GO" name="GO">
        <bpmn:flowNodeRef>Task_ExamineApplication</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssignMSPN</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformMSPO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformMPO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformSP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Success</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Register measurement at GO">
      <bpmn:outgoing>SequenceFlow_StartToTask</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Register Measurement (MSPN) -->
    <bpmn:task id="Task_RegisterMeasurement" name="Register measurement at the GO">
      <bpmn:incoming>SequenceFlow_StartToTask</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TaskToExamine</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: Examine Application (GO) -->
    <bpmn:task id="Task_ExamineApplication" name="Examine the application of the MSPN">
      <bpmn:incoming>SequenceFlow_TaskToExamine</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ExamineToGateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_Decision" name="Reject or Confirm?">
      <bpmn:incoming>SequenceFlow_ExamineToGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RejectPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ConfirmPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event 1 (Reject) -->
    <bpmn:endEvent id="EndEvent_Reject" name="Application Rejected">
      <bpmn:incoming>SequenceFlow_RejectPath</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task 3: Assign MSPN (Confirm Path) -->
    <bpmn:task id="Task_AssignMSPN" name="Assign the MSPN">
      <bpmn:incoming>SequenceFlow_ConfirmPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AssignToInformMSPO</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 4: Inform MSPO -->
    <bpmn:task id="Task_InformMSPO" name="Inform the MSPO about the assignment of MSPN">
      <bpmn:incoming>SequenceFlow_AssignToInformMSPO</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MSPOtoMPO</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 5: Inform MPO -->
    <bpmn:task id="Task_InformMPO" name="Inform the MPO about the assignment of MSPN">
      <bpmn:incoming>SequenceFlow_MSPOtoMPO</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MPOtoSP</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 6: Inform SP -->
    <bpmn:task id="Task_InformSP" name="Inform the SP about the assignment of MSPN">
      <bpmn:incoming>SequenceFlow_MPOtoSP</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SPToEnd</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 2 (Success) -->
    <bpmn:endEvent id="EndEvent_Success" name="Assignment Completed">
      <bpmn:incoming>SequenceFlow_SPToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToTask" sourceRef="StartEvent_1" targetRef="Task_RegisterMeasurement"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_TaskToExamine" sourceRef="Task_RegisterMeasurement" targetRef="Task_ExamineApplication"/>

    <bpmn:sequenceFlow id="SequenceFlow_ExamineToGateway" sourceRef="Task_ExamineApplication" targetRef="ExclusiveGateway_Decision"/>
    
    <bpmn:exclusiveGateway id="ExclusiveGateway_Decision">
      <bpmn:incoming>SequenceFlow_ExamineToGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RejectPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ConfirmPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="SequenceFlow_RejectPath" sourceRef="ExclusiveGateway_Decision" targetRef="EndEvent_Reject"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ConfirmPath" sourceRef="ExclusiveGateway_Decision" targetRef="Task_AssignMSPN">
      <bpmn:name>Confirm</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_AssignToInformMSPO" sourceRef="Task_AssignMSPN" targetRef="Task_InformMSPO"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_MSPOtoMPO" sourceRef="Task_InformMSPO" targetRef="Task_InformMPO"/>

    <bpmn:sequenceFlow id="SequenceFlow_MPOtoSP" sourceRef="Task_InformMPO" targetRef="Task_InformSP"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_SPToEnd" sourceRef="Task_InformSP" targetRef="EndEvent_Success"/>

  </bpmn:process>
</bpmn:definitions>