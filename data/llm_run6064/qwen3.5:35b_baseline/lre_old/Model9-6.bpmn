<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_DesignProcess" name="Design Process Modeler" processRef="Process_Design"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Design" isExecutable="true">
    
    <!-- Lane Set for Departments -->
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_ElectricalDesign" name="Electrical Design Department">
        <bpmn:flowNodeRef>Task_LocateDistribute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ParallelStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ElectricalReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ElectricalUpdatePlan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ElectricalTestResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ElectricalRevisedDesign</bpmn:flowNodeRef>
      </bpmn:lane>
      
      <bpmn:lane id="Lane_PhysicalDesign" name="Physical Design Department">
        <bpmn:flowNodeRef>Gateway_ParallelStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PhysicalReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PhysicalUpdatePlan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PhysicalTestResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PhysicalRevisedDesign</bpmn:flowNodeRef>
      </bpmn:lane>
      
      <bpmn:lane id="Lane_CombinedTesting" name="Combined Testing">
        <bpmn:flowNodeRef>Gateway_MergeBothComplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CombineDesigns</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_FinalTestResult</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Design Process Started">
      <bpmn:outgoing>SequenceFlow_StartToLocate</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Locate and Distribute Existing Designs -->
    <bpmn:task id="Task_LocateDistribute" name="Locate &amp; Distribute Existing Designs">
      <bpmn:incoming>SequenceFlow_StartToLocate</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToParallelStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway for Starting Both Designs -->
    <bpmn:parallelGateway id="Gateway_ParallelStart" name="Start Design Development">
      <bpmn:incoming>SequenceFlow_ToParallelStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ElectricalPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PhysicalPath</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Electrical Design Department Tasks -->
    <bpmn:task id="Task_ElectricalReview" name="Review Existing Designs">
      <bpmn:incoming>SequenceFlow_ElectricalPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToElectricalUpdatePlan</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_ElectricalUpdatePlan" name="Create Electrical Update Plan">
      <bpmn:incoming>SequenceFlow_ToElectricalUpdatePlan</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToElectricalRevisedDesign</bpmn:outgoing>
    </bpmn:task>

    <!-- Physical Design Department Tasks -->
    <bpmn:task id="Task_PhysicalReview" name="Review Existing Designs">
      <bpmn:incoming>SequenceFlow_PhysicalPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToPhysicalUpdatePlan</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_PhysicalUpdatePlan" name="Create Physical Update Plan">
      <bpmn:incoming>SequenceFlow_ToPhysicalUpdatePlan</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToPhysicalRevisedDesign</bpmn:outgoing>
    </bpmn:task>

    <!-- Revised Design Tasks -->
    <bpmn:task id="Task_ElectricalRevisedDesign" name="Create Electrical Revised Design">
      <bpmn:incoming>SequenceFlow_ToElectricalRevisedDesign</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToElectricalTestResult</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_PhysicalRevisedDesign" name="Create Physical Revised Design">
      <bpmn:incoming>SequenceFlow_ToPhysicalRevisedDesign</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToPhysicalTestResult</bpmn:outgoing>
    </bpmn:task>

    <!-- Test Result Gateways -->
    <bpmn:exclusiveGateway id="Gateway_ElectricalTestResult" name="Electrical Design Pass?">
      <bpmn:incoming>SequenceFlow_ToElectricalTestResult</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ElectricalPassToMerge</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:exclusiveGateway id="Gateway_PhysicalTestResult" name="Physical Design Pass?">
      <bpmn:incoming>SequenceFlow_ToPhysicalTestResult</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PhysicalPassToMerge</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Merge Gateway for Both Designs Complete -->
    <bpmn:parallelGateway id="Gateway_MergeBothComplete" name="Wait for Both">
      <bpmn:incoming>SequenceFlow_ElectricalPassToMerge</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_PhysicalPassToMerge</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToCombineDesigns</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Combined Design Tasks -->
    <bpmn:task id="Task_CombineDesigns" name="Combine &amp; Test Designs">
      <bpmn:incoming>SequenceFlow_ToCombineDesigns</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToFinalTestResult</bpmn:outgoing>
    </bpmn:task>

    <!-- Final Decision Gateway -->
    <bpmn:exclusiveGateway id="Gateway_FinalTestResult" name="Combined Design Pass?">
      <bpmn:incoming>SequenceFlow_ToFinalTestResult</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DesignCompleteToManufacturing</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event -->
    <bpmn:endEvent id="End_Event_Complete" name="Design Complete">
      <bpmn:incoming>SequenceFlow_DesignCompleteToManufacturing</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows - Main Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToLocate" sourceRef="StartEvent_1" targetRef="Task_LocateDistribute"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ToParallelStart" name="Designs Located" sourceRef="Task_LocateDistribute" targetRef="Gateway_ParallelStart">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[designsAvailable]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Parallel Paths -->
    <bpmn:sequenceFlow id="SequenceFlow_ElectricalPath" sourceRef="Gateway_ParallelStart" targetRef="Task_ElectricalReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[electricalDesignRequired]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_PhysicalPath" sourceRef="Gateway_ParallelStart" targetRef="Task_PhysicalReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[physicalDesignRequired]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Electrical Department Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_ToElectricalUpdatePlan" sourceRef="Task_ElectricalReview" targetRef="Task_ElectricalUpdatePlan"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ToElectricalRevisedDesign" name="Create Revised Design" sourceRef="Task_ElectricalUpdatePlan" targetRef="Task_ElectricalRevisedDesign">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[updatePlanComplete]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Physical Department Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_ToPhysicalUpdatePlan" sourceRef="Task_PhysicalReview" targetRef="Task_PhysicalUpdatePlan"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ToPhysicalRevisedDesign" name="Create Revised Design" sourceRef="Task_PhysicalUpdatePlan" targetRef="Task_PhysicalRevisedDesign">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[updatePlanComplete]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Test Result Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_ToElectricalTestResult" sourceRef="Task_ElectricalRevisedDesign" targetRef="Gateway_ElectricalTestResult"/>
    
    <bpmn:exclusiveGateway id="Gateway_ElectricalReviewLoop">
      <bpmn:incoming>SequenceFlow_ElectricalFailBack</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToElectricalUpdatePlan</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="SequenceFlow_ElectricalPassToMerge" name="PASS - Notify Other Dept" sourceRef="Gateway_ElectricalTestResult" targetRef="Gateway_MergeBothComplete">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[electricalDesignPassed]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Physical Test Result Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_ToPhysicalTestResult" sourceRef="Task_PhysicalRevisedDesign" targetRef="Gateway_PhysicalTestResult"/>
    
    <bpmn:exclusiveGateway id="Gateway_PhysicalReviewLoop">
      <bpmn:incoming>SequenceFlow_PhysicalFailBack</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToPhysicalUpdatePlan</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="SequenceFlow_PhysicalPassToMerge" name="PASS - Notify Other Dept" sourceRef="Gateway_PhysicalTestResult" targetRef="Gateway_MergeBothComplete">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[physicalDesignPassed]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Combined Testing Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_ToCombineDesigns" sourceRef="Gateway_MergeBothComplete" targetRef="Task_CombineDesigns"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ToFinalTestResult" name="Combined Test Complete" sourceRef="Task_CombineDesigns" targetRef="Gateway_FinalTestResult">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[combinedTestingComplete]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Final Decision Flows -->
    <bpmn:exclusiveGateway id="Gateway_FinalReviewLoop">
      <bpmn:incoming>SequenceFlow_DesignFailBack</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToParallelStart</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="SequenceFlow_DesignCompleteToManufacturing" name="PASS - Send to Manufacturing" sourceRef="Gateway_FinalTestResult" targetRef="End_Event_Complete">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[combinedDesignPassed]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>