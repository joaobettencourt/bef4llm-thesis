<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Claim Handling Process" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    
    <!-- Lane Set -->
    <bpmn:laneSet>
      <bpmn:lane id="Lane_ClaimsOfficer" name="Claims Officer">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExamineClaim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WriteRecommendation</bpmn:flowNodeRef>
      </bpmn:lane>
      
      <bpmn:lane id="Lane_SeniorOfficer" name="Senior Claims Officer">
        <bpmn:flowNodeRef>Task_CheckRecommendation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DecisionOK</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Claim Registered">
      <bpmn:outgoing>SequenceFlow_Examine</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Examine Claim (Claims Officer) -->
    <bpmn:task id="Task_ExamineClaim" name="Examine Claim">
      <bpmn:incoming>SequenceFlow_Examine</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WriteRec</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: Write Recommendation (Claims Officer) -->
    <bpmn:task id="Task_WriteRecommendation" name="Write Settlement Recommendation">
      <bpmn:incoming>SequenceFlow_WriteRec</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SeniorCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3: Check Recommendation (Senior Claims Officer) -->
    <bpmn:task id="Task_CheckRecommendation" name="Check Recommendation">
      <bpmn:incoming>SequenceFlow_SeniorCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DecisionPoint</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Decision (Senior Claims Officer) -->
    <bpmn:exclusiveGateway id="Gateway_DecisionOK" name="Claim OK?">
      <bpmn:incoming>SequenceFlow_DecisionPoint</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NotOkLoop</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ProceedOK</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event -->
    <bpmn:endEvent id="End_EventProceed" name="Process Proceeds">
      <bpmn:incoming>SequenceFlow_ProceedOK</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    
    <!-- Start to Examine -->
    <bpmn:sequenceFlow id="SequenceFlow_Examine" sourceRef="StartEvent_1" targetRef="Task_ExamineClaim"/>

    <!-- Examine to Write Rec -->
    <bpmn:sequenceFlow id="SequenceFlow_WriteRec" name="Examination Complete" sourceRef="Task_ExamineClaim" targetRef="Task_WriteRecommendation"/>

    <!-- Write Rec to Senior Check -->
    <bpmn:sequenceFlow id="SequenceFlow_SeniorCheck" name="Submit for Review" sourceRef="Task_WriteRecommendation" targetRef="Task_CheckRecommendation"/>

    <!-- Task Check to Gateway -->
    <bpmn:sequenceFlow id="SequenceFlow_DecisionPoint" name="Decision Point" sourceRef="Task_CheckRecommendation" targetRef="Gateway_DecisionOK"/>

    <!-- Gateway Not OK Loop Back -->
    <bpmn:sequenceFlow id="SequenceFlow_NotOkLoop" name="Not OK - Repeat Recommendation" sourceRef="Gateway_DecisionOK" targetRef="Task_WriteRecommendation">
      <bpmn:name>No</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Gateway OK to End -->
    <bpmn:sequenceFlow id="SequenceFlow_ProceedOK" name="Proceed with Claim Handling" sourceRef="Gateway_DecisionOK" targetRef="End_EventProceed">
      <bpmn:name>Yes</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
  
</bpmn:definitions>