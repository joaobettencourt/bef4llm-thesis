<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Company" name="Customized Bicycle Manufacturing Company" processRef="Process_BicycleManufacturing"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_BicycleManufacturing" isExecutable="true">
    
    <!-- Lane Set for Departments -->
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_SalesDept" name="Sales Department">
        <bpmn:flowNodeRef>StartEvent_OrderReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DecideOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AcceptReject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ShipToCustomer</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Storehouse" name="Storehouse">
        <bpmn:flowNodeRef>InclusiveGateway_ProcessParts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckQuantity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ReserveOrBackorder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReservedPart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BackorderPart</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Engineering" name="Engineering Department">
        <bpmn:flowNodeRef>InclusiveGateway_PrepareAssembly</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepForAssembly</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_OrderReceived" name="Order Received">
      <bpmn:outgoing>SequenceFlow_ToDecision</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Sales Member Decision -->
    <bpmn:task id="Task_DecideOrder" name="Decide on Order (Accept/Reject)">
      <bpmn:incoming>SequenceFlow_ToDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AcceptRejectGateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Accept or Reject -->
    <bpmn:exclusiveGateway id="Gateway_AcceptReject" name="Accept Order?">
      <bpmn:incoming>SequenceFlow_AcceptRejectGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RejectPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event for Rejected Order -->
    <bpmn:endEvent id="EndEvent_Rejected" name="Order Rejected">
      <bpmn:incoming>SequenceFlow_RejectPath</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Parallel Gateway after Acceptance (Inform Storehouse & Engineering) -->
    <bpmn:parallelGateway id="Parallel_InformBoth" name="Inform Departments">
      <bpmn:incoming>SequenceFlow_AcceptPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToStorehouse</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Storehouse Lane Elements -->
    <bpmn:startEvent id="StartEvent_Storehouse" name="Process Part List">
       <bpmn:incoming/> 
      <bpmn:outgoing>SequenceFlow_ToCheckQuantity</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Check Quantity -->
    <bpmn:task id="Task_CheckQuantity" name="Check Required Quantity">
       <bpmn:incoming>SequenceFlow_ToCheckQuantity</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReserveOrBackorderGateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Reserve or Back-order -->
    <bpmn:exclusiveGateway id="Gateway_ReserveOrBackorder" name="Available?">
      <bpmn:incoming>SequenceFlow_ReserveOrBackorderGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Reserve</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Reserve Part -->
    <bpmn:task id="Task_ReservedPart" name="Reserve Part">
       <bpmn:incoming>SequenceFlow_Reserve</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckNextItem</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Back-order Part -->
    <bpmn:exclusiveGateway id="Gateway_NextItem" name="More Items?">
       <bpmn:incoming>SequenceFlow_BackOrder</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckNextItem</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Engineering Lane Elements -->
    <bpmn:startEvent id="StartEvent_Engineering" name="Prepare Assembly">
       <bpmn:incoming/> 
      <bpmn:outgoing>SequenceFlow_ToPrepAssembly</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Prepare for Assembly -->
    <bpmn:task id="Task_PrepForAssembly" name="Prepare for Assembly">
       <bpmn:incoming>SequenceFlow_ToPrepAssembly</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AssemblyGateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway to Join Storehouse and Engineering -->
    <bpmn:parallelGateway id="Parallel_JoinBeforeAssembly" name="Join Before Assembly">
      <bpmn:incoming>SequenceFlow_StorehouseComplete</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToPrepAssembly</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Assemble Bicycle -->
    <bpmn:task id="Task_AssembleBicycle" name="Assemble Bicycle">
       <bpmn:incoming>SequenceFlow_AssemblyReady</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToShipping</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Ship to Customer -->
    <bpmn:task id="Task_ShipToCustomer" name="Ship Bicycle">
       <bpmn:incoming>SequenceFlow_ToShipping</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FinalEndEvent</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Completed" name="Order Completed">
       <bpmn:incoming>SequenceFlow_FinalEndEvent</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_ToDecision" sourceRef="StartEvent_OrderReceived" targetRef="Task_DecideOrder"/>
    
    <bpmn:exclusiveGateway id="Gateway_AcceptReject">
      <bpmn:incoming>SequenceFlow_AcceptRejectGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RejectPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_DecideOrder" name="Decide on Order (Accept/Reject)">
       <bpmn:incoming>SequenceFlow_ToDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AcceptRejectGateway</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_ReserveOrBackorder" name="Available?">
       <bpmn:incoming>SequenceFlow_ReserveOrBackorderGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Reserve</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_ReservedPart" name="Reserve Part">
       <bpmn:incoming>SequenceFlow_Reserve</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckNextItem</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_NextItem" name="More Items?">
       <bpmn:incoming>SequenceFlow_CheckNextItem</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToCheckQuantity</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Corrected Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_AcceptRejectGateway" sourceRef="Task_DecideOrder" targetRef="Gateway_AcceptReject"/>
    
    <bpmn:endEvent id="EndEvent_Rejected">
      <bpmn:incoming>SequenceFlow_RejectPath</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow_RejectPath" sourceRef="Gateway_AcceptReject" targetRef="EndEvent_Rejected"/>
    
    <bpmn:parallelGateway id="Parallel_InformBoth">
      <bpmn:incoming>SequenceFlow_AcceptPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToStorehouse</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:startEvent id="StartEvent_Storehouse">
       <bpmn:outgoing>SequenceFlow_ToCheckQuantity</bpmn:outgoing>
      <bpmn:incoming/> 
    </bpmn:startEvent>

    <bpmn:task id="Task_CheckQuantity" name="Check Required Quantity">
       <bpmn:incoming>SequenceFlow_ToCheckQuantity</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReserveOrBackorderGateway</bpmn:outgoing>
    </bpmn:task>

    <bpmn:startEvent id="StartEvent_Engineering">
       <bpmn:outgoing>SequenceFlow_ToPrepAssembly</bpmn:outgoing>
      <bpmn:incoming/> 
    </bpmn:startEvent>

  </bpmn:process>
  
  <!-- Data Definitions -->
  <bpmn:dataObject id="Data_PartList" name="Part List"/>
  <bpmn:dataAssociation id="Assoc_1">
    <bpmn:sourceRef>Data_PartList</bpmn:sourceRef>
    <bpmn:targetRef>Task_CheckQuantity</bpmn:targetRef>
  </bpmn:dataAssociation>

</bpmn:definitions>