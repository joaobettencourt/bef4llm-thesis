<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_Claims">
    <bpmn:participant id="Participant_ClaimsProcess" name="Claims Management Process" processRef="Process_Claims"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Claims" isExecutable="true">
    
    <!-- Start Event -->
    <bpmn:startEvent id="StartClaimReceived" name="Claim Received">
      <bpmn:outgoing>SequenceFlow_CheckInsurance</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Check Insurance Status -->
    <bpmn:task id="Task_CheckInsuranceStatus" name="Check Claimant Insured">
      <bpmn:incoming>SequenceFlow_CheckInsurance</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_IsInsuredGateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Is Claimant Insured? -->
    <bpmn:exclusiveGateway id="Gateway_IsInsured" name="Is Insured?">
      <bpmn:incoming>SequenceFlow_IsInsuredGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RejectPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Path 1: Not Insured -->
    <bpmn:task id="Task_InformRejection" name="Inform Claimant of Rejection">
      <bpmn:incoming>SequenceFlow_RejectPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndRejected</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 1 -->
    <bpmn:endEvent id="EndClaimRejected" name="Claim Rejected">
      <bpmn:incoming>SequenceFlow_EndRejected</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Path 2: Insured (Severity Evaluation) -->
    <bpmn:task id="Task_EvaluateSeverity" name="Evaluate Claim Severity">
      <bpmn:incoming>SequenceFlow_IsInsuredGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ClaimTypeCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2: Claim Type (Simple vs Complex) -->
    <bpmn:exclusiveGateway id="Gateway_ClaimType" name="Claim Type?">
      <bpmn:incoming>SequenceFlow_ClaimTypeCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendSimpleForms</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 2a: Send Simple Forms -->
    <bpmn:task id="Task_SendSimpleForms" name="Send Relevant Forms (Simple)">
      <bpmn:incoming>SequenceFlow_SendSimpleForms</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitForFormsReturn</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2b: Send Complex Forms -->
    <bpmn:task id="Task_SendComplexForms" name="Send Relevant Forms (Complex)">
      <bpmn:incoming>SequenceFlow_ClaimTypeCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitForFormsReturn</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Catch Event for Initial Forms Return -->
    <bpmn:startEvent id="StartInitialFormReturned" name="Forms Returned">
      <bpmn:incoming/>
      <bpmn:outgoing>SequenceFlow_CheckCompleteness</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 3: Check Completeness -->
    <bpmn:task id="Task_CheckCompleteness" name="Check Forms for Completeness">
      <bpmn:incoming>SequenceFlow_CheckCompleteness</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CompletenessGateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 3: Is Complete? -->
    <bpmn:exclusiveGateway id="Gateway_Complete" name="Complete?">
      <bpmn:incoming>SequenceFlow_CheckCompleteness</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_YesPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Path 3a: Complete -->
    <bpmn:task id="Task_RegisterClaim" name="Register in Claims Management System">
      <bpmn:incoming>SequenceFlow_YesPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndRegistered</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 2 -->
    <bpmn:endEvent id="EndClaimRegistered" name="Claims Notification Process Ended">
      <bpmn:incoming>SequenceFlow_EndRegistered</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Path 3b: Not Complete - Inform to Update -->
    <bpmn:task id="Task_InformUpdate" name="Inform Claimant to Update Forms">
      <bpmn:incoming>SequenceFlow_NoPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitUpdatedForms</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Catch Event for Updated Forms Return -->
    <bpmn:startEvent id="StartUpdatedFormReturned" name="Updated Forms Returned">
      <bpmn:incoming/>
      <bpmn:outgoing>SequenceFlow_CheckCompleteness</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckInsurance" sourceRef="StartClaimReceived" targetRef="Task_CheckInsuranceStatus"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_IsInsuredGateway" sourceRef="Task_CheckInsuranceStatus" targetRef="Gateway_IsInsured">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[isInsured]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_RejectPath" sourceRef="Gateway_IsInsured" targetRef="Task_InformRejection">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[not Insured]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_EndRejected" sourceRef="Task_InformRejection" targetRef="EndClaimRejected"/>

    <!-- Flow from Gateway to Evaluate Severity (for insured claims) -->
    <bpmn:exclusiveGateway id="Gateway_ClaimType">
      <bpmn:incoming>SequenceFlow_EvaluateToClaim</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendSimpleForms</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SendComplexForms</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="SequenceFlow_EvaluateToClaim" sourceRef="Task_EvaluateSeverity" targetRef="Gateway_ClaimType"/>

    <!-- Flow from Evaluate Severity to Claim Type Gateway -->
    <bpmn:sequenceFlow id="SequenceFlow_IsInsuredGateway" sourceRef="Task_CheckInsuranceStatus" targetRef="Gateway_IsInsured">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[is Insured]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Flow from Evaluate Severity to Claim Type Gateway -->
    <bpmn:exclusiveGateway id="Gateway_ClaimType">
      <bpmn:incoming>SequenceFlow_EvaluateToClaim</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendSimpleForms</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SendComplexForms</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Flow from Evaluate Severity to Claim Type Gateway -->
    <bpmn:sequenceFlow id="SequenceFlow_EvaluateToClaim" sourceRef="Task_EvaluateSeverity" targetRef="Gateway_ClaimType"/>

    <!-- Simple Forms Path -->
    <bpmn:task id="Task_SendSimpleForms" name="Send Relevant Forms (Simple)">
      <bpmn:incoming>SequenceFlow_SendSimpleForms</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitForFormsReturn</bpmn:outgoing>
    </bpmn:task>

    <!-- Complex Forms Path -->
    <bpmn:sequenceFlow id="SequenceFlow_ClaimTypeCheck" sourceRef="Task_EvaluateSeverity" targetRef="Gateway_ClaimType"/>

    <bpmn:exclusiveGateway id="Gateway_ClaimType">
      <bpmn:incoming>SequenceFlow_ClaimTypeCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendSimpleForms</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SendComplexForms</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Simple Forms Path -->
    <bpmn:task id="Task_SendSimpleForms" name="Send Relevant Forms (Simple)">
      <bpmn:incoming>SequenceFlow_SendSimpleForms</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitForFormsReturn</bpmn:outgoing>
    </bpmn:task>

    <!-- Complex Forms Path -->
    <bpmn:sequenceFlow id="SequenceFlow_ClaimTypeCheck" sourceRef="Task_EvaluateSeverity" targetRef="Gateway_ClaimType"/>

    <bpmn:exclusiveGateway id="Gateway_ClaimType">
      <bpmn:incoming>SequenceFlow_ClaimTypeCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendSimpleForms</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SendComplexForms</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Simple Forms Path -->
    <bpmn:task id="Task_SendSimpleForms" name="Send Relevant Forms (Simple)">
      <bpmn:incoming>SequenceFlow_SendSimpleForms</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitForFormsReturn</bpmn:outgoing>
    </bpmn:task>

    <!-- Complex Forms Path -->
    <bpmn:sequenceFlow id="SequenceFlow_ClaimTypeCheck" sourceRef="Task_EvaluateSeverity" targetRef="Gateway_ClaimType"/>

    <bpmn:exclusiveGateway id="Gateway_ClaimType">
      <bpmn:incoming>SequenceFlow_ClaimTypeCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendSimpleForms</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SendComplexForms</bpmn:outgoing>
    </bpmn:exclusiveGateway>

  </bpmn:process>
  
  <!-- Data Definitions -->
  <bpmn:dataObject id="Data_ClaimForm" name="Claim Form"/>
</bpmn:definitions>