<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:messageFlow id="MessageFlow_Order" name="Order Request" sourceRef="Task_PlaceOrder" targetRef="StartEvent_ProcessOrderReceived"/>
    <bpmn:messageFlow id="MessageFlow_Invoice" name="Invoice" sourceRef="IntermediateThrow_SendInvoice" targetRef="IntermediateCatch_ReceiveInvoice"/>
  </bpmn:collaboration>

  <!-- Process for Assembler AG -->
  <bpmn:process id="Process_AssemblerAG">
    <bpmn:startEvent id="StartEvent_MonthlyOrder" name="1st of Month: Order Request">
      <bpmn:outgoing>SequenceFlow_PlaceOrder</bpmn:outgoing>
      <bpmn:timerEventDefinition/>
    </bpmn:startEvent>

    <bpmn:task id="Task_PlaceOrder" name="Place Order">
      <bpmn:incoming>SequenceFlow_PlaceOrder</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitInvoice</bpmn:outgoing>
    </bpmn:task>

    <bpmn:intermediateCatchEvent id="IntermediateCatch_ReceiveInvoice" name="Receive Invoice">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SequenceFlow_WaitInvoice</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndAssembler</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:endEvent id="End_AssemblerAG" name="Process Completed">
      <bpmn:incoming>SequenceFlow_EndAssembler</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow_PlaceOrder" sourceRef="StartEvent_MonthlyOrder" targetRef="Task_PlaceOrder"/>
    <bpmn:sequenceFlow id="SequenceFlow_WaitInvoice" sourceRef="Task_PlaceOrder" targetRef="IntermediateCatch_ReceiveInvoice"/>
    <bpmn:sequenceFlow id="SequenceFlow_EndAssembler" sourceRef="IntermediateCatch_ReceiveInvoice" targetRef="End_AssemblerAG"/>

  </bpmn:process>

  <!-- Process for Supplier -->
  <bpmn:process id="Process_Supplier">
    <bpmn:startEvent id="StartEvent_ProcessOrderReceived" name="Order Received">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_StartProcessing</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_ProcessOrder" name="Process Order">
      <bpmn:incoming>SequenceFlow_StartProcessing</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendInvoice</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Throw Event to trigger message flow explicitly -->
    <bpmn:intermediateThrowEvent id="IntermediateThrow_SendInvoice" name="Send Invoice">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SequenceFlow_SendInvoice</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndSupplier</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <bpmn:endEvent id="End_Supplier" name="Order Processed">
      <bpmn:incoming>SequenceFlow_EndSupplier</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow_StartProcessing" sourceRef="StartEvent_ProcessOrderReceived" targetRef="Task_ProcessOrder"/>
    <bpmn:sequenceFlow id="SequenceFlow_SendInvoice" sourceRef="Task_ProcessOrder" targetRef="IntermediateThrow_SendInvoice"/>
    <bpmn:sequenceFlow id="SequenceFlow_EndSupplier" sourceRef="IntermediateThrow_SendInvoice" targetRef="End_Supplier"/>

  </bpmn:process>

</bpmn:definitions>