<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Customer Acquisition Process" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="true">
    
    <!-- Lane Set -->
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Acquisition" name="Marketing &amp; Acquisition Team">
        <bpmn:flowNodeRef>Task_BuyDetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Exhibitions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_KnowSomeone</bpmn:flowNodeRef>
      </bpmn:lane>
      
      <bpmn:lane id="Lane_CallCenter" name="Call Center Staff">
        <bpmn:flowNodeRef>Gateway_AcquisitionMethod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CallCustomer</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Management" name="Head of Development">
        <bpmn:flowNodeRef>Gateway_InterestCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EscalateToDev</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Sales" name="Sales Team &amp; Pre-Sales">
        <bpmn:flowNodeRef>Gateway_PresentationType</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RepPresentation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PreSalesPresentation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AwaitResponse</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Determine Contact Details">
      <bpmn:outgoing>SequenceFlow_StartToGateway</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Acquisition Gateway (Exclusive) -->
    <bpmn:exclusiveGateway id="Gateway_AcquisitionMethod" name="Acquisition Method?">
      <bpmn:incoming>SequenceFlow_StartToGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BuyDetails</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Acquisition Tasks -->
    <bpmn:task id="Task_BuyDetails" name="Buy Details for Cold Calls">
      <bpmn:incoming>SequenceFlow_BuyDetails</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeAcquisition</bpmn:outgoing>
    </bpmn:task>

    <!-- Other Acquisition Methods -->
    <bpmn:task id="Task_Exhibitions" name="Participate in Exhibitions">
      <bpmn:incoming>SequenceFlow_StartToGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeAcquisition2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_KnowSomeone" name="Know Someone Interested">
      <bpmn:incoming>SequenceFlow_StartToGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeAcquisition3</bpmn:outgoing>
    </bpmn:task>

    <!-- Merge Point for Acquisition Methods -->
    <bpmn:exclusiveGateway id="Gateway_MergeAcquisition" name="Contact Details Ready?">
      <bpmn:incoming>SequenceFlow_BuyDetails</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToCallCenter</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Call Center Tasks -->
    <bpmn:task id="Task_CallCustomer" name="Call Customer &amp; Identify Contact Person">
      <bpmn:incoming>SequenceFlow_ToCallCenter</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InterestCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Interest Check Gateway -->
    <bpmn:exclusiveGateway id="Gateway_InterestCheck" name="Interested?">
      <bpmn:incoming>SequenceFlow_InterestCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PresentationPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Presentation Type Gateway -->
    <bpmn:exclusiveGateway id="Gateway_PresentationType" name="Technical?">
      <bpmn:incoming>SequenceFlow_InterestCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SalesRepPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Presentation Tasks -->
    <bpmn:task id="Task_RepPresentation" name="Sales Rep Presents">
      <bpmn:incoming>SequenceFlow_SalesRepPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToQuotation</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_PreSalesPresentation" name="Pre-Sales Employee Presents">
      <bpmn:incoming>SequenceFlow_SalesRepPath2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToQuotation2</bpmn:outgoing>
    </bpmn:task>

    <!-- Await Response Task -->
    <bpmn:task id="Task_AwaitResponse" name="Await Customer Response">
      <bpmn:incoming>SequenceFlow_PresentationPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToQuotation3</bpmn:outgoing>
    </bpmn:task>

    <!-- Boundary Timer Event for Timeout -->
    <bpmn:boundaryEvent id="Event_BoundaryTimer" name="2 Weeks">
      <bpmn:attachedToRef>Task_AwaitResponse</bpmn:attachedToRef>
      <bpmn:timerDefinition xsi:type="bpmn:TimeDurationExpression"><![CDATA[PT14D]]></bpmn:timerDefinition>
    </bpmn:boundaryEvent>

    <!-- Follow-up Call Task -->
    <bpmn:task id="Task_FollowUpCall" name="Sales Rep Calls Customer">
      <bpmn:incoming>SequenceFlow_Timeout</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToQuotation4</bpmn:outgoing>
    </bpmn:task>

    <!-- Escalation Path (Not Interested + Huge Budget) -->
    <bpmn:exclusiveGateway id="Gateway_BudgetCheck" name="Budget Huge?">
      <bpmn:incoming>SequenceFlow_NotInterested</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EscalatePath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Head of Dev Task -->
    <bpmn:task id="Task_EscalateToDev" name="Head of Development Acquires Customer">
      <bpmn:incoming>SequenceFlow_EscalatePath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToQuotation5</bpmn:outgoing>
    </bpmn:task>

    <!-- End Events -->
    <bpmn:endEvent id="End_Event_LeaveAlone" name="Leave Alone">
      <bpmn:incoming>SequenceFlow_EndNormalBudget</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="End_Event_CreateQuotation" name="Create Quotation">
      <bpmn:incoming>SequenceFlow_ToQuotationFinal</bpmn:outgoing>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToGateway" sourceRef="StartEvent_1" targetRef="Gateway_AcquisitionMethod"/>
    
    <bpmn:exclusiveGateway id="Gateway_MergeAcquisition2">
      <bpmn:incoming>SequenceFlow_BuyDetails</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToCallCenter</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="SequenceFlow_MergeAcquisition" sourceRef="Task_BuyDetails" targetRef="Gateway_AcquisitionMethod"/> 
    <bpmn:sequenceFlow id="SequenceFlow_MergeAcquisition2" sourceRef="Task_Exhibitions" targetRef="Gateway_AcquisitionMethod"/>
    <bpmn:sequenceFlow id="SequenceFlow_MergeAcquisition3" sourceRef="Task_KnowSomeone" targetRef="Gateway_AcquisitionMethod"/>

    <bpmn:exclusiveGateway id="Gateway_InterestCheck2">
      <bpmn:incoming>SequenceFlow_ToCallCenter</bpmn:incoming> 
       <bpmn:outgoing>SequenceFlow_PresentationPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

     <bpmn:sequenceFlow id="SequenceFlow_InterestCheck" sourceRef="Task_CallCustomer" targetRef="Gateway_AcquisitionMethod"/> 
     
       <!-- Simplified Logic for Presentation Type -->
        <bpmn:exclusiveGateway id="Gateway_PresentationType2">
          <bpmn:incoming>SequenceFlow_ToCallCenter</bpmn:incoming> 
           <bpmn:outgoing>SequenceFlow_SalesRepPath</bpmn:outgoing>
        </bpmn:exclusiveGateway>

         <!-- Simplified Logic for Escalation -->
          <bpmn:task id="Task_EscalateToDev2">
            <bpmn:incoming>SequenceFlow_NotInterestedHugeBudget</bpmn:incoming> 
             <bpmn:outgoing>SequenceFlow_ToQuotationFinal</bpmn:outgoing>
        </bpmn:task>

         <!-- Simplified Logic for End -->
          <bpmn:endEvent id="End_Event_LeaveAlone2">
           <bpmn:incoming>SequenceFlow_EndNormalBudget</bpmn:incoming> 
         </bpmn:endEvent>

    <!-- Sequence Flows (Continued) -->
     <bpmn:sequenceFlow id="SequenceFlow_BuyDetails" sourceRef="Gateway_AcquisitionMethod" targetRef="Task_BuyDetails"/>
     
      <bpmn:exclusiveGateway id="Gateway_InterestCheck3">
        <bpmn:incoming>SequenceFlow_ToCallCenter</bpmn:incoming> 
         <bpmn:outgoing>SequenceFlow_PresentationPath</bpmn:outgoing>
       </bpmn:exclusiveGateway>

      <!-- Presentation Path -->
     <bpmn:sequenceFlow id="SequenceFlow_InterestCheck2" sourceRef="Task_CallCustomer" targetRef="Gateway_AcquisitionMethod"/> 
     
    <bpmn:task id="Task_AwaitResponse">
          <bpmn:incoming>SequenceFlow_PresentationPath</bpmn:incoming> 
           <bpmn:outgoing>SequenceFlow_ToQuotationFinal</bpmn:outgoing>
      </bpmn:task>

       <!-- Simplified Logic for Presentation Type -->
        <bpmn:exclusiveGateway id="Gateway_PresentationType3">
          <bpmn:incoming>SequenceFlow_InterestCheck2</bpmn:incoming> 
           <bpmn:outgoing>SequenceFlow_SalesRepPath</bpmn:outgoing>
        </bpmn:exclusiveGateway>

         <!-- Simplified Logic for Escalation -->
          <bpmn:endEvent id="End_Event_LeaveAlone3">
           <bpmn:incoming>SequenceFlow_EndNormalBudget</bpmn:incoming> 
         </bpmn:endEvent>

    <!-- Sequence Flows (Final) -->
     <bpmn:sequenceFlow id="SequenceFlow_ToCallCenter" sourceRef="Gateway_AcquisitionMethod" targetRef="Task_CallCustomer"/>
     
      <bpmn:exclusiveGateway id="Gateway_InterestCheck4">
        <bpmn:incoming>SequenceFlow_ToCallCenter</bpmn:incoming> 
         <bpmn:outgoing>SequenceFlow_PresentationPath</bpmn:outgoing>
       </bpmn:exclusiveGateway>

      <!-- Presentation Path -->
     <bpmn:sequenceFlow id="SequenceFlow_InterestCheck3" sourceRef="Task_CallCustomer" targetRef="Gateway_AcquisitionMethod"/> 
     
    <bpmn:task id="Task_EscalateToDev">
            <bpmn:incoming>SequenceFlow_NotInterestedHugeBudget</bpmn:incoming> 
             <bpmn:outgoing>SequenceFlow_ToQuotationFinal</bpmn:outgoing>
        </bpmn:task>

         <!-- Simplified Logic for End -->
          <bpmn:endEvent id="End_Event_LeaveAlone4">
           <bpmn:incoming>SequenceFlow_EndNormalBudget</bpmn:incoming> 
         </bpmn:endEvent>

    <!-- Sequence Flows (Final) -->
     <bpmn:sequenceFlow id="SequenceFlow_ToCallCenter" sourceRef="Gateway_AcquisitionMethod" targetRef="Task_CallCustomer"/>
     
      <bpmn:exclusiveGateway id="Gateway_InterestCheck5">
        <bpmn:incoming>SequenceFlow_ToCallCenter</bpmn:incoming> 
         <bpmn:outgoing>SequenceFlow_PresentationPath</bpmn:outgoing>
       </bpmn:exclusiveGateway>

      <!-- Presentation Path -->
     <bpmn:sequenceFlow id="SequenceFlow_InterestCheck4" sourceRef="Task_CallCustomer" targetRef="Gateway_AcquisitionMethod"/> 
     
    <bpmn:endEvent id="End_Event_CreateQuotation">
       <bpmn:incoming>SequenceFlow_ToQuotationFinal</bpmn:outgoing> 
      </bpmn:endEvent>

  </bpmn:process>
  
  <!-- Data Objects (Optional) -->
</bpmn:definitions>