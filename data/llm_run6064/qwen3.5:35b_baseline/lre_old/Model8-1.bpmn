<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_RecruitmentProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_Recruit">
    <bpmn:participant id="Participant_EmployeeRecruitment" name="Employee Recruitment Process" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="true">
    
    <!-- LaneSet for Organizational Roles -->
    <bpmn:laneSet id="LaneSet_001">
      <bpmn:lane id="Lane_FunctionalDept" name="Functional Department">
        <bpmn:flowNodeRef>StartEvent_Demand</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_HR" name="Human Resources">
        <bpmn:flowNodeRef>Task_AdvertisePosition</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CheckApplications</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConcludeContract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_PostFilled</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Demand" name="Demand for Post">
      <bpmn:outgoing>SequenceFlow_StartToAdvertise</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Advertise Position -->
    <bpmn:task id="Task_AdvertisePosition" name="Advertise Position">
      <bpmn:incoming>SequenceFlow_StartToAdvertise</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckApps</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Decision Point for Candidate Selection -->
    <bpmn:exclusiveGateway id="Gateway_CheckApplications" name="Suitable Applicant Found?">
      <bpmn:incoming>SequenceFlow_CheckApps</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ContractPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 2: Conclude Contract -->
    <bpmn:task id="Task_ConcludeContract" name="Conclude Employment Contract">
      <bpmn:incoming>SequenceFlow_ContractPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToEnd</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_PostFilled" name="Post Filled">
      <bpmn:incoming>SequenceFlow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    
    <!-- Start to Advertise (Cross-lane interaction) -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToAdvertise" sourceRef="StartEvent_Demand" targetRef="Task_AdvertisePosition">
      <bpmn:name>Demand Received</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Advertise to Check/Select -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckApps" sourceRef="Task_AdvertisePosition" targetRef="Gateway_CheckApplications">
      <bpmn:name>Check Applications</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Gateway to Contract (Success Path) -->
    <bpmn:sequenceFlow id="SequenceFlow_ContractPath" sourceRef="Gateway_CheckApplications" targetRef="Task_ConcludeContract">
      <bpmn:name>Suitable Candidate Found</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Contract to End -->
    <bpmn:sequenceFlow id="SequenceFlow_ToEnd" sourceRef="Task_ConcludeContract" targetRef="EndEvent_PostFilled">
      <bpmn:name>Filled</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
  
</bpmn:definitions>