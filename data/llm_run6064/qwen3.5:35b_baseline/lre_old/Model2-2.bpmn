<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_CustomerService" name="Customer Service (Shared)" processRef="Process_CustomerService"/>
    <bpmn:participant id="Participant_GridOperator" name="Grid Operator" processRef="Process_GridOperator"/>
  </bpmn:collaboration>

  <!-- Customer Service Process -->
  <bpmn:process id="Process_CustomerService" isExecutable="true">
    
    <!-- Start Event -->
    <bpmn:startEvent id="Start_SwitchRequest_1" name="Switch-over Request Received"/>
    
    <!-- Task: Receive and Enter Data -->
    <bpmn:task id="Task_ReceiveData_1" name="Transmit Customer Data to CRM System">
      <bpmn:incoming>SequenceFlow_Start_CS</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Compare_CS</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Error Check -->
    <bpmn:exclusiveGateway id="Gateway_ErrorCheck_1" name="Errors Found?">
      <bpmn:incoming>SequenceFlow_Compare_CS</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CorrectError_CS</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoError_CS</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Correct Errors -->
    <bpmn:task id="Task_CorrectErrors_1" name="Correct Data Based on Error List">
      <bpmn:incoming>SequenceFlow_CorrectError_CS</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReCompare_CS</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Customer Exists -->
    <bpmn:exclusiveGateway id="Gateway_CustomerExists_1" name="Customer in Database?">
      <bpmn:incoming>SequenceFlow_NoError_CS</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ExistingCustomer_CS</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NewCustomer_CS</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Create New Customer -->
    <bpmn:task id="Task_CreateNewCustomer_1" name="Create New Customer Object">
      <bpmn:incoming>SequenceFlow_NewCustomer_CS</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PrepareContract_CS</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Prepare Contract -->
    <bpmn:task id="Task_PrepareContract_1" name="Prepare Contract Documents">
      <bpmn:incoming>SequenceFlow_ExistingCustomer_CS</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CISCheck_CS</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: CIS Check Result -->
    <bpmn:exclusiveGateway id="Gateway_CISResult_1" name="CIS Check Successful?">
      <bpmn:incoming>SequenceFlow_CISCheck_CS</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NegativeResponse_CS</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PositiveResponse_CS</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Analyze Issues -->
    <bpmn:task id="Task_AnalyzeIssues_1" name="Analyze and Resolve Contract Issues">
      <bpmn:incoming>SequenceFlow_NegativeResponse_CS</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReGenerateContract_CS</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Regenerate Contracts -->
    <bpmn:task id="Task_RegenerateContracts_1" name="Regenerate Contract Documents">
      <bpmn:incoming>SequenceFlow_ReCompare_CS</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CISCheckAgain_CS</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Send Confirmation -->
    <bpmn:task id="Task_SendConfirmation_1" name="Send Switch-over Confirmation to Customer">
      <bpmn:incoming>SequenceFlow_PositiveResponse_CS</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RequestGridOperator_CS</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Supplier Concurrence -->
    <bpmn:exclusiveGateway id="Gateway_SupplierConcurrence_1" name="Supplier Concurrence?">
      <bpmn:incoming>SequenceFlow_GatewaySupplierCheck_CS</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConcurrenceYes_CS</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ConcurrenceNo_CS</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Inform Suppliers -->
    <bpmn:task id="Task_InformSuppliers_1" name="Inform All Involved Suppliers">
      <bpmn:incoming>SequenceFlow_ConcurrenceYes_CS</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TerminateAgreement_CS</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Terminate Agreement -->
    <bpmn:task id="Task_TerminateAgreement_1" name="Terminate Sales Agreement with Old Supplier">
      <bpmn:incoming>SequenceFlow_ConcurrenceNo_CS</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CreateCISContract_CS</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Create CIS Contract -->
    <bpmn:task id="Task_CreateCISContract_1" name="Create CIS Contract">
      <bpmn:incoming>SequenceFlow_CreateCISContract_CS</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CustomerReview_CS</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Customer Decision -->
    <bpmn:exclusiveGateway id="Gateway_CustomerDecision_1" name="Customer Accepts?">
      <bpmn:incoming>SequenceFlow_CustomerReview_CS</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Withdrawal_CS</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_Confirmation_CS</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event: Withdrawal -->
    <bpmn:endEvent id="End_Withdrawal_1" name="Process Ended (Withdrawal)">
      <bpmn:incoming>SequenceFlow_Withdrawal_CS</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task: Import Meter Data -->
    <bpmn:task id="Task_ImportMeterData_1" name="Import Meter Data to Systems">
      <bpmn:incoming>SequenceFlow_Confirmation_CS</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndProcess_CS</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event: Process Complete -->
    <bpmn:endEvent id="End_ProcessComplete_1" name="New Customer Won">
      <bpmn:incoming>SequenceFlow_EndProcess_CS</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_Start_CS" sourceRef="Start_SwitchRequest_1" targetRef="Task_ReceiveData_1"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_Compare_CS" name="compareWithDatabase" sourceRef="Task_ReceiveData_1" targetRef="Gateway_ErrorCheck_1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[true]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_CorrectError_CS" name="errorsFound" sourceRef="Gateway_ErrorCheck_1" targetRef="Task_CorrectErrors_1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[true]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_NoError_CS" name="noErrors" sourceRef="Gateway_ErrorCheck_1" targetRef="Gateway_CustomerExists_1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[true]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ReCompare_CS" sourceRef="Task_CorrectErrors_1" targetRef="Gateway_ErrorCheck_1"/>

    <bpmn:sequenceFlow id="SequenceFlow_ExistingCustomer_CS" name="customerExists" sourceRef="Gateway_CustomerExists_1" targetRef="Task_PrepareContract_1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[true]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_NewCustomer_CS" name="customerNotInDatabase" sourceRef="Gateway_CustomerExists_1" targetRef="Task_CreateNewCustomer_1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[true]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_CISCheck_CS" sourceRef="Task_PrepareContract_1" targetRef="Gateway_CISResult_1"/>

    <bpmn:sequenceFlow id="SequenceFlow_NegativeResponse_CS" name="checkFailed" sourceRef="Gateway_CISResult_1" targetRef="Task_AnalyzeIssues_1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[true]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_PositiveResponse_CS" name="checkSuccessful" sourceRef="Gateway_CISResult_1" targetRef="Task_SendConfirmation_1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[true]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ReGenerateContract_CS" sourceRef="Task_AnalyzeIssues_1" targetRef="Task_RegenerateContracts_1"/>

    <bpmn:sequenceFlow id="SequenceFlow_CISCheckAgain_CS" name="regenerated" sourceRef="Task_RegenerateContracts_1" targetRef="Gateway_CISResult_1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[true]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_RequestGridOperator_CS" sourceRef="Task_SendConfirmation_1" targetRef="Gateway_SupplierConcurrence_1"/>

    <bpmn:sequenceFlow id="SequenceFlow_GatewaySupplierCheck_CS" name="gridOperatorResponse" sourceRef="Gateway_SupplierConcurrence_1" targetRef="Gateway_SupplierConcurrence_1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[true]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ConcurrenceYes_CS" name="supplierConcurrence" sourceRef="Gateway_SupplierConcurrence_1" targetRef="Task_InformSuppliers_1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[true]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ConcurrenceNo_CS" name="noSupplierConcurrence" sourceRef="Gateway_SupplierConcurrence_1" targetRef="Task_TerminateAgreement_1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[true]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_CreateCISContract_CS" sourceRef="Task_TerminateAgreement_1" targetRef="Task_CreateCISContract_1"/>

    <bpmn:sequenceFlow id="SequenceFlow_CustomerReview_CS" name="customerHas7Days" sourceRef="Task_CreateCISContract_1" targetRef="Gateway_CustomerDecision_1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[true]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_Withdrawal_CS" name="customerWithdraws" sourceRef="Gateway_CustomerDecision_1" targetRef="End_Withdrawal_1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[true]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_Confirmation_CS" name="customerConfirmsOr7DaysPassed" sourceRef="Gateway_CustomerDecision_1" targetRef="Task_ImportMeterData_1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[true]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_EndProcess_CS" sourceRef="Task_ImportMeterData_1" targetRef="End_ProcessComplete_1"/>

  </bpmn:process>

  <!-- Grid Operator Process -->
  <bpmn:process id="Process_GridOperator" isExecutable="true">
    
    <!-- Start Event (Message) -->
    <bpmn:startEvent id="Start_MeterDataReceived_GO" name="Meter Data Received"/>
    
    <!-- Task: Transmit Meter Data -->
    <bpmn:task id="Task_TransmitMeterData_1" name="Transmit Power Meter Data to Customer Service and Old Supplier">
      <bpmn:incoming>SequenceFlow_Start_GO</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ComputeBilling_GO</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Compute Final Billing -->
    <bpmn:task id="Task_ComputeFinalBilling_1" name="Compute Final Billing">
      <bpmn:incoming>SequenceFlow_ComputeBilling_GO</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendToOldSupplier_GO</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="End_GridOperator_1" name="Process Ended">
      <bpmn:incoming>SequenceFlow_EndGrid_GO</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_Start_GO" sourceRef="Start_MeterDataReceived_GO" targetRef="Task_TransmitMeterData_1"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ComputeBilling_GO" name="computeBilling" sourceRef="Task_TransmitMeterData_1" targetRef="Task_ComputeFinalBilling_1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[true]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_SendToOldSupplier_GO" name="billingSent" sourceRef="Task_ComputeFinalBilling_1" targetRef="End_GridOperator_1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[true]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

  </bpmn:process>

</bpmn:definitions>