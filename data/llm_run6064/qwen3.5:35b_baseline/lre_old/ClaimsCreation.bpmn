<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Claims Department" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="true">
    
    <!-- Lane Definitions -->
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Handler" name="Claims Handler">
        <bpmn:flowNodeRef>Task_GatherDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Estimate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ActionPlan</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Manager" name="Claims Manager">
        <bpmn:flowNodeRef>Task_Negotiate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformClaimant</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="Start_1" name="Accident Reported">
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Gather Documents (Handler) -->
    <bpmn:task id="Task_GatherDocs" name="Compile Accident File">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: Calculate Estimate (Handler) -->
    <bpmn:task id="Task_Estimate" name="Calculate Initial Claim Estimate">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3: Create Action Plan (Handler) -->
    <bpmn:task id="Task_ActionPlan" name="Create Action Plan">
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 4: Negotiate Settlement (Manager) -->
    <bpmn:task id="Task_Negotiate" name="Negotiate Settlement">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 5: Inform Claimant (Manager) -->
    <bpmn:task id="Task_InformClaimant" name="Inform Claimant of Outcome">
      <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_End</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="End_1" name="Process Completed">
      <bpmn:incoming>SequenceFlow_End</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="Start_1" targetRef="Task_GatherDocs"/>
    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="Task_GatherDocs" targetRef="Task_Estimate"/>
    <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="Task_Estimate" targetRef="Task_ActionPlan"/>
    <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="Task_ActionPlan" targetRef="Task_Negotiate"/>
    <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="Task_Negotiate" targetRef="Task_InformClaimant"/>
    <bpmn:sequenceFlow id="SequenceFlow_End" sourceRef="Task_InformClaimant" targetRef="End_1"/>

    <!-- Data Objects -->
    <bpmn:dataObject id="Data_PoliceReportFile" name="Police Report File"/>
    <bpmn:dataObject id="Data_ClaimDocs" name="Claim Documentation"/>
    <bpmn:dataObject id="Data_AccidentFile" name="Accident File (Combined)"/>
    <bpmn:dataObject id="Data_Checklist" name="Action Plan Checklist"/>
    <bpmn:dataObject id="Data_PlanOutput" name="Action Plan"/>
    <bpmn:dataObject id="Data_EstimateOutput" name="Claim Estimate"/>

    <!-- Associations (Logical Links) -->
    <bpmn:association id="Assoc_1">
      <bpmn:sourceRef>Data_AccidentFile</bpmn:sourceRef>
      <bpmn:targetRef>Task_GatherDocs</bpmn:targetRef>
    </bpmn:association>
    <bpmn:association id="Assoc_2">
      <bpmn:sourceRef>Data_AccidentFile</bpmn:sourceRef>
      <bpmn:targetRef>Task_Estimate</bpmn:targetRef>
    </bpmn:association>
    <bpmn:association id="Assoc_3">
      <bpmn:sourceRef>Data_Checklist</bpmn:sourceRef>
      <bpmn:targetRef>Task_ActionPlan</bpmn:targetRef>
    </bpmn:association>

  </bpmn:process>
</bpmn:definitions>