<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Pool_MPON" name="MPON" processRef="Process_MPON"/>
    <bpmn:participant id="Pool_MPOO" name="MPOO" processRef="Process_MPOO"/>
    
    <!-- Message Flows -->
    <bpmn:messageFlow id="MessageFlow_RequestBid" sourceRef="Task_MPON_RequestBid" targetRef="Event_MPOO_ReceiveRequest"/>
    <bpmn:messageFlow id="MessageFlow_Tender" sourceRef="Task_MPOO_SendTender" targetRef="Event_MPON_ReceiveTender"/>
    <bpmn:messageFlow id="MessageFlow_Order" sourceRef="Task_MPON_PlaceOrder" targetRef="Event_MPOO_ReceiveOrder"/>
  </bpmn:collaboration>

  <!-- MPON Process -->
  <bpmn:process id="Process_MPON">
    <bpmn:startEvent id="StartEvent_MPON_RequestBid">
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_MPON_RequestBid" name="Request Device Takeover Bid">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitTender</bpmn:outgoing>
    </bpmn:task>

    <bpmn:intermediateCatchEvent id="Event_MPON_ReceiveTender" name="Receive Tender">
      <bpmn:incoming>SequenceFlow_WaitTender</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PlaceOrder</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:task id="Task_MPON_PlaceOrder" name="Place Order at MPOO">
      <bpmn:incoming>SequenceFlow_PlaceOrder</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndMPON</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_MPON">
      <bpmn:incoming>SequenceFlow_EndMPON</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_MPON_RequestBid" targetRef="Task_MPON_RequestBid"/>
    <bpmn:sequenceFlow id="SequenceFlow_WaitTender" sourceRef="Task_MPON_RequestBid" targetRef="Event_MPON_ReceiveTender"/>
    <bpmn:sequenceFlow id="SequenceFlow_PlaceOrder" sourceRef="Event_MPON_ReceiveTender" targetRef="Task_MPON_PlaceOrder"/>
    <bpmn:sequenceFlow id="SequenceFlow_EndMPON" sourceRef="Task_MPON_PlaceOrder" targetRef="EndEvent_MPON"/>

  </bpmn:process>

  <!-- MPOO Process -->
  <bpmn:process id="Process_MPOO">
    <bpmn:startEvent id="StartEvent_MPOO_Initiate">
      <bpmn:outgoing>SequenceFlow_WaitRequest</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Intermediate Catch Event to receive the request from MPON -->
    <bpmn:intermediateCatchEvent id="Event_MPOO_ReceiveRequest" name="Receive Bid Request">
      <bpmn:incoming>SequenceFlow_WaitRequest</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendTender</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:task id="Task_MPOO_SendTender" name="Send Tender for Equipment Takeover">
      <bpmn:incoming>SequenceFlow_SendTender</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitOrder</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Catch Event to receive the order from MPON -->
    <bpmn:intermediateCatchEvent id="Event_MPOO_ReceiveOrder" name="Receive Order">
      <bpmn:incoming>SequenceFlow_WaitOrder</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConfirmData</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:task id="Task_MPOO_Confirm" name="Confirm Order and Send Master Data">
      <bpmn:incoming>SequenceFlow_ConfirmData</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndMPOO</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_MPOO">
      <bpmn:incoming>SequenceFlow_EndMPOO</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow_WaitRequest" sourceRef="StartEvent_MPOO_Initiate" targetRef="Event_MPOO_ReceiveRequest"/>
    <bpmn:sequenceFlow id="SequenceFlow_SendTender" sourceRef="Event_MPOO_ReceiveRequest" targetRef="Task_MPOO_SendTender"/>
    <bpmn:sequenceFlow id="SequenceFlow_WaitOrder" sourceRef="Task_MPOO_SendTender" targetRef="Event_MPOO_ReceiveOrder"/>
    <bpmn:sequenceFlow id="SequenceFlow_ConfirmData" sourceRef="Event_MPOO_ReceiveOrder" targetRef="Task_MPOO_Confirm"/>
    <bpmn:sequenceFlow id="SequenceFlow_EndMPOO" sourceRef="Task_MPOO_Confirm" targetRef="EndEvent_MPOO"/>

  </bpmn:process>
</bpmn:definitions>