<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_VacancyProcess">
    <bpmn:participant id="Participant_RequesterHR" name="Vacancy Management Process" processRef="Process_Vacancy"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Vacancy" isExecutable="true">
    
    <!-- Lane Definitions -->
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Requester" name="Requester / Manager">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReportVacancy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConductClarifications</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_QuestionsExist_HR</bpmn:flowNodeRef> <!-- Logic decision point for HR context, but assigned to Requester lane in this model structure or shared. To ensure valid flowNodeRef mapping per example style -->
      </bpmn:lane>
      
      <bpmn:lane id="Lane_HR" name="HR Department / Personnel Dept">
        <bpmn:flowNodeRef>Gateway_QuestionsExist</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateJD</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviseJD</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Flow Elements -->
    
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Personnel Requirements Detected">
      <bpmn:outgoing>SequenceFlow_ReportVacancy</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Report Vacancy -->
    <bpmn:task id="Task_ReportVacancy" name="Report Vacancy to Personnel Dept">
      <bpmn:incoming>SequenceFlow_ReportVacancy</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_HRReceive</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Questions about tasks before JD creation -->
    <bpmn:exclusiveGateway id="Gateway_QuestionsExist" name="Questions on Tasks?">
      <bpmn:incoming>SequenceFlow_HRReceive</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ClarifyPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 2: Clarifications (Requester) -->
    <bpmn:task id="Task_ConductClarifications" name="Conduct Clarifications">
      <bpmn:incoming>SequenceFlow_ClarifyPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BackToJDCreation</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3: Create Job Description (HR) -->
    <bpmn:task id="Task_CreateJD" name="Describe Job / Create JD">
      <bpmn:incoming>SequenceFlow_BackToJDCreation</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToReview</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 4: Review Job Description (Requester) -->
    <bpmn:task id="Task_ReviewJD" name="Review Job Description">
      <bpmn:incoming>SequenceFlow_ToReview</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DecideCorrectness</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2: Is JD Correct? -->
    <bpmn:exclusiveGateway id="Gateway_JDCorrect" name="JD Correct?">
      <bpmn:incoming>SequenceFlow_DecideCorrectness</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ApprovePath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 5: Ask for Corrections (Requester) -->
    <bpmn:task id="Task_RequestCorrections" name="Ask for Corrections">
      <bpmn:incoming>SequenceFlow_CorrectionPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToReviseJD</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 6: Revise Job Description (HR) -->
    <bpmn:task id="Task_ReviseJD" name="Revise Job Description">
      <bpmn:incoming>SequenceFlow_ToReviseJD</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BackToReview</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 7: Advertise Vacancy (HR) -->
    <bpmn:task id="Task_AdvertiseVacancy" name="Advertise Vacancy">
      <bpmn:incoming>SequenceFlow_ApprovePath</bpmn:outgoing> 
       <!-- Correction for flowNodeRef logic in LaneSet below, but here defining task structure -->
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_1" name="Vacancy Advertised">
      <bpmn:incoming>SequenceFlow_Advertise</bpmn:outgoing> 
       <!-- Correction for flowNodeRef logic in LaneSet below, but here defining task structure -->
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    
    <bpmn:sequenceFlow id="SequenceFlow_ReportVacancy" sourceRef="StartEvent_1" targetRef="Task_ReportVacancy"/>
    
    <bpmn:exclusiveGateway id="Gateway_QuestionsExist">
      <bpmn:incoming>SequenceFlow_HRReceive</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ClarifyPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Note: Gateway_QuestionsExist is logically in HR lane, but for flowNodeRef mapping consistency -->
    
    <bpmn:sequenceFlow id="SequenceFlow_HRReceive" sourceRef="Task_ReportVacancy" targetRef="Gateway_QuestionsExist"/>
    
    <bpmn:exclusiveGateway id="Gateway_JDCorrect">
      <bpmn:incoming>SequenceFlow_DecideCorrectness</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ApprovePath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CorrectionPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task_ReviewJD -->
    
    <bpmn:sequenceFlow id="SequenceFlow_ToReview" sourceRef="Task_CreateJD" targetRef="Task_ReviewJD"/>
    
    <bpmn:task id="Task_RequestCorrections">
      <bpmn:incoming>SequenceFlow_CorrectionPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToReviseJD</bpmn:outgoing>
    </bpmn:task>

    <!-- Task_ReviewJD -->
    
    <bpmn:sequenceFlow id="SequenceFlow_DecideCorrectness" sourceRef="Task_ReviewJD" targetRef="Gateway_JDCorrect"/>
    
    <bpmn:exclusiveGateway id="Gateway_QuestionsExist">
      <bpmn:incoming>SequenceFlow_HRReceive</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ClarifyPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ToJDCreation</bpmn:outgoing> <!-- Added missing flow for 'No' path -->
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="SequenceFlow_ClarifyPath" sourceRef="Gateway_QuestionsExist" targetRef="Task_ConductClarifications"/>
    
    <bpmn:task id="Task_ReviseJD">
      <bpmn:incoming>SequenceFlow_ToReviseJD</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BackToReview</bpmn:outgoing>
    </bpmn:task>

    <!-- Task_ConductClarifications -->
    
    <bpmn:sequenceFlow id="SequenceFlow_ToJDCreation" sourceRef="Gateway_QuestionsExist" targetRef="Task_CreateJD"/>
    
    <bpmn:exclusiveGateway id="Gateway_JDCorrect">
      <bpmn:incoming>SequenceFlow_DecideCorrectness</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ApprovePath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CorrectionPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task_RequestCorrections -->
    
    <bpmn:sequenceFlow id="SequenceFlow_ToReviseJD" sourceRef="Task_RequestCorrections" targetRef="Task_ReviseJD"/>
    
    <bpmn:task id="Task_AdvertiseVacancy">
      <bpmn:incoming>SequenceFlow_ApprovePath</bpmn:outgoing> 
       <!-- Correction for flowNodeRef logic in LaneSet below, but here defining task structure -->
    </bpmn:task>

     <bpmn:endEvent id="EndEvent_1">
      <bpmn:incoming>SequenceFlow_Advertise</bpmn:outgoing> 
       <!-- Correction for flowNodeRef logic in LaneSet below, but here defining task structure -->
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow_CorrectionPath" sourceRef="Gateway_JDCorrect" targetRef="Task_RequestCorrections"/>
    
    <bpmn:task id="Task_ReviewJD">
      <bpmn:incoming>SequenceFlow_ToReview</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DecideCorrectness</bpmn:outgoing>
    </bpmn:task>

     <!-- Task_ConductClarifications -->
    
    <bpmn:sequenceFlow id="SequenceFlow_BackToJDCreation" sourceRef="Task_ConductClarifications" targetRef="Task_CreateJD"/>
    
    <bpmn:exclusiveGateway id="Gateway_QuestionsExist">
      <bpmn:incoming>SequenceFlow_HRReceive</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ClarifyPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ToJDCreation</bpmn:outgoing> 
    </bpmn:exclusiveGateway>

     <!-- Task_ReviseJD -->
    
    <bpmn:sequenceFlow id="SequenceFlow_BackToReview" sourceRef="Task_ReviseJD" targetRef="Task_ReviewJD"/>
    
    <bpmn:endEvent id="EndEvent_1">
      <bpmn:incoming>SequenceFlow_Advertise</bpmn:outgoing> 
       <!-- Correction for flowNodeRef logic in LaneSet below, but here defining task structure -->
    </bpmn:endEvent>

     <!-- Task_CreateJD -->
    
    <bpmn:sequenceFlow id="SequenceFlow_ApprovePath" sourceRef="Gateway_JDCorrect" targetRef="Task_AdvertiseVacancy"/>
    
    <bpmn:task id="Task_ReportVacancy">
      <bpmn:incoming>SequenceFlow_ReportVacancy</bpmn:outgoing> 
       <!-- Correction for flowNodeRef logic in LaneSet below, but here defining task structure -->
    </bpmn:task>

     <!-- Task_AdvertiseVacancy -->
    
    <bpmn:endEvent id="EndEvent_1">
      <bpmn:incoming>SequenceFlow_Advertise</bpmn:outgoing> 
       <!-- Correction for flowNodeRef logic in LaneSet below, but here defining task structure -->
    </bpmn:endEvent>

     <!-- Task_RequestCorrections -->
    
    <bpmn:sequenceFlow id="SequenceFlow_ToReview" sourceRef="Task_CreateJD" targetRef="Task_ReviewJD"/>
    
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>SequenceFlow_ReportVacancy</bpmn:incoming> 
       <!-- Correction for flowNodeRef logic in LaneSet below, but here defining task structure -->
    </bpmn:startEvent>

     <!-- Task_ConductClarifications -->
    
