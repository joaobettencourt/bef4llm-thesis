<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_VacationsRequest">
    <bpmn:participant id="Participant_Organization" name="Organization Process Modeler" processRef="Process_VacationsRequest"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_VacationsRequest" isExecutable="true">
    
    <!-- Lane Set -->
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Employee" name="Employee">
        <bpmn:flowNodeRef>StartEvent_Submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegisterRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Denied</bpmn:flowNodeRef>
      </bpmn:lane>
      
      <bpmn:lane id="Lane_Supervisor" name="Supervisor">
        <bpmn:flowNodeRef>Task_ReviewRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DecisionApproval</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_HR" name="Human Resources Representative">
        <bpmn:flowNodeRef>Task_NotifyHR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CompleteProcedures</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Approved</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Submit" name="Vacation Request Submitted">
      <bpmn:outgoing>SequenceFlow_Register</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Register (Employee Lane) -->
    <bpmn:task id="Task_RegisterRequest" name="Register Vacation Requirement">
      <bpmn:incoming>SequenceFlow_Register</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToSupervisor</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: Review (Supervisor Lane) -->
    <bpmn:task id="Task_ReviewRequest" name="Approve or Reject Request">
      <bpmn:incoming>SequenceFlow_ToSupervisor</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DecisionPoint</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Decision (Supervisor Lane) -->
    <bpmn:exclusiveGateway id="Gateway_DecisionApproval" name="Approved?">
      <bpmn:incoming>SequenceFlow_DecisionPoint</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ApprovedPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flow to HR (Approved) -->
    <bpmn:sequenceFlow id="SequenceFlow_ApprovedPath" sourceRef="Gateway_DecisionApproval" targetRef="Task_NotifyHR">
      <bpmn:name>Yes</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Task 3: Notify HR (HR Lane) -->
    <bpmn:task id="Task_NotifyHR" name="Generate Notification to HR">
      <bpmn:incoming>SequenceFlow_ApprovedPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CompleteProcedures</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 4: Complete Procedures (HR Lane) -->
    <bpmn:task id="Task_CompleteProcedures" name="Complete Management Procedures">
      <bpmn:incoming>SequenceFlow_CompleteProcedures</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndApproved</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 1: Approved -->
    <bpmn:endEvent id="EndEvent_Approved" name="Vacation Request Approved">
      <bpmn:incoming>SequenceFlow_EndApproved</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flow to Rejection (Supervisor Lane) -->
    <bpmn:sequenceFlow id="SequenceFlow_RejectedPath" sourceRef="Gateway_DecisionApproval" targetRef="Task_ReviewRejection">
      <bpmn:name>No</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Task 5: Review Rejection (Employee Lane) -->
    <bpmn:task id="Task_ReviewRejection" name="Review Rejection Reasons">
      <bpmn:incoming>SequenceFlow_RejectedPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndDenied</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 2: Denied -->
    <bpmn:endEvent id="EndEvent_Denied" name="Request Rejected">
      <bpmn:incoming>SequenceFlow_EndDenied</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows for Flow Control -->
    <bpmn:sequenceFlow id="SequenceFlow_Register" sourceRef="StartEvent_Submit" targetRef="Task_RegisterRequest"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ToSupervisor" name="Received by Supervisor">
      <bpmn:name>Once Registered</bpmn:name>
      <bpmn:sourceRef>Task_RegisterRequest</bpmn:sourceRef>
      <bpmn:targetRef>Task_ReviewRequest</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_DecisionPoint" sourceRef="Task_ReviewRequest" targetRef="Gateway_DecisionApproval"/>

    <!-- Sequence Flow to End Denied -->
    <bpmn:sequenceFlow id="SequenceFlow_EndDenied" sourceRef="Task_ReviewRejection" targetRef="EndEvent_Denied"/>

  </bpmn:process>
</bpmn:definitions>