<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_IPO_Process" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_IPO" name="IPO Process Modeler" processRef="Process_IPO"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_IPO" isExecutable="true">
    
    <!-- Lane Definitions -->
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Company" name="Company">
        <bpmn:flowNodeRef>StartEvent_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectUnderwriters</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Underwriter" name="Underwriters">
        <bpmn:flowNodeRef>ExclusiveGateway_FactsFair</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelSplit_RegPricing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareRegStatement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateCatch_SECClearance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelJoin_Finalize</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FixIssuePriceFinal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BuyStockCommitment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_ReasonNotOffer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_OfferedPublicly</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Decision" name="Decision to Go Public">
      <bpmn:outgoing>SequenceFlow_SelectUnderwriters</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Select Underwriters -->
    <bpmn:task id="Task_SelectUnderwriters" name="Select Underwriters">
      <bpmn:incoming>SequenceFlow_SelectUnderwriters</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FactsCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Facts Fair? -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_FactsFair" name="Facts Presented Fairly?">
      <bpmn:incoming>SequenceFlow_FactsCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProceedIPO</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event 1: Rejection -->
    <bpmn:endEvent id="End_Rejected" name="Process Stopped">
       <bpmn:incoming>SequenceFlow_Rejected</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Parallel Split after Acceptance -->
    <bpmn:parallelGateway id="ParallelSplit_RegPricing" name="Start Registration &amp; Pricing">
      <bpmn:incoming>SequenceFlow_ProceedIPO</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PrepareReg</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_FirmPriceEstimate</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Path A: Registration & Compliance -->
    <bpmn:task id="Task_PrepareRegStatement" name="Prepare Reg Statement &amp; Check Blue-Sky Laws">
      <bpmn:incoming>SequenceFlow_PrepareReg</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitSEC</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Catch Event for SEC Clearance -->
    <bpmn:intermediateCatchEvent id="IntermediateCatch_SECClearance" name="Wait SEC Clearance">
        <bpmn:incoming>SequenceFlow_WaitSEC</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow_FixPriceFinal</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Path B: Pricing Prep & Road Show -->
    <bpmn:task id="Task_RoadShow" name="Firm Up Price Estimate &amp; Arrange Road Show">
      <bpmn:incoming>SequenceFlow_FirmPriceEstimate</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_JoinFinalize</bpmn:outgoing>
    </bpmn:task>

     <!-- Join Gateway -->
    <bpmn:parallelGateway id="ParallelJoin_Finalize" name="Synchronize">
        <bpmn:incoming>SequenceFlow_FixPriceFinal</bpmn:incoming>
        <bpmn:incoming>SequenceFlow_JoinFinalize</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow_BuyStockCommitment</bpmn:outgoing>
    </bpmn:parallelGateway>

     <!-- Task Final Price Fix -->
    <bpmn:task id="Task_FixIssuePriceFinal" name="Fix Issue Price">
        <bpmn:incoming>SequenceFlow_WaitSEC</bpmn:incoming> 
        <bpmn:outgoing>SequenceFlow_BuyStockCommitment</bpmn:outgoing>
    </bpmn:task>

     <!-- Task Buy Stock Commitment -->
    <bpmn:task id="Task_BuyStockCommitment" name="Enter Firm Commitment to Buy Stock">
        <bpmn:incoming>SequenceFlow_BuyStockCommitment</bpmn:incoming> 
        <bpmn:outgoing>SequenceFlow_ReasonNotOffer</bpmn:outgoing>
    </bpmn:task>

     <!-- Gateway Check Reason Not Offer -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_ReasonNotOffer" name="Any Reason Not to Offer?">
        <bpmn:incoming>SequenceFlow_ReasonNotOffer</bpmn:incoming> 
        <bpmn:outgoing>SequenceFlow_OfferPublicly</bpmn:outgoing>
    </bpmn:exclusiveGateway>

     <!-- End Event -->
    <bpmn:endEvent id="End_OfferedPublicly" name="Offer to Public">
       <bpmn:incoming>SequenceFlow_OfferPublicly</bpmn:incoming> 
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_SelectUnderwriters" sourceRef="StartEvent_Decision" targetRef="Task_SelectUnderwriters"/>
    
    <bpmn:exclusiveGateway id="ExclusiveGateway_FactsFair">
      <bpmn:incoming>SequenceFlow_FactsCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProceedIPO</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="SequenceFlow_FactsCheck" sourceRef="Task_SelectUnderwriters" targetRef="ExclusiveGateway_FactsFair"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ProceedIPO" name="Yes" sourceRef="ExclusiveGateway_FactsFair" targetRef="ParallelSplit_RegPricing">
      <bpmn:name>Yes</bpmn:name>
    </bpmn:sequenceFlow>

     <bpmn:exclusiveGateway id="ExclusiveGateway_RejectLogic">
        <bpmn:incoming>SequenceFlow_FactsCheck</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow_Rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>

     <bpmn:sequenceFlow id="SequenceFlow_PrepareReg" sourceRef="ParallelSplit_RegPricing" targetRef="Task_PrepareRegStatement"/>
    
    <bpmn:parallelGateway id="ParallelJoin_Finalize">
        <bpmn:incoming>SequenceFlow_FixPriceFinal</bpmn:incoming>
        <bpmn:incoming>SequenceFlow_JoinFinalize</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow_BuyStockCommitment</bpmn:outgoing>
    </bpmn:parallelGateway>

     <bpmn:sequenceFlow id="SequenceFlow_FirmPriceEstimate" sourceRef="ParallelSplit_RegPricing" targetRef="Task_RoadShow"/>
    
    <bpmn:task id="Task_BuyStockCommitment">
        <bpmn:incoming>SequenceFlow_BuyStockCommitment</bpmn:incoming> 
        <bpmn:outgoing>SequenceFlow_ReasonNotOffer</bpmn:outgoing>
      </bpmn:task>

     <bpmn:exclusiveGateway id="ExclusiveGateway_ReasonNotOffer">
        <bpmn:incoming>SequenceFlow_ReasonNotOffer</bpmn:incoming> 
        <bpmn:outgoing>SequenceFlow_OfferPublicly</bpmn:outgoing>
    </bpmn:exclusiveGateway>

     <bpmn:endEvent id="End_OfferedPublicly">
       <bpmn:incoming>SequenceFlow_OfferPublicly</bpmn:incoming> 
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_SelectUnderwriters" sourceRef="StartEvent_Decision" targetRef="Task_SelectUnderriters"/>
    
    <bpmn:exclusiveGateway id="ExclusiveGateway_FactsFair">
      <bpmn:incoming>SequenceFlow_FactsCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProceedIPO</bpmn:outgoing>
    </bpmn:exclusiveGateway>

     <!-- Corrected Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_FactsCheck" sourceRef="Task_SelectUnderwriters" targetRef="ExclusiveGateway_FactsFair"/>
    
    <bpmn:parallelGateway id="ParallelSplit_RegPricing">
      <bpmn:incoming>SequenceFlow_ProceedIPO</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PrepareReg</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_FirmPriceEstimate</bpmn:outgoing>
    </bpmn:parallelGateway>

     <bpmn:sequenceFlow id="SequenceFlow_ProceedIPO" sourceRef="ExclusiveGateway_FactsFair" targetRef="ParallelSplit_RegPricing"/>
    
    <bpmn:task id="Task_PrepareRegStatement">
      <bpmn:incoming>SequenceFlow_PrepareReg</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitSEC</bpmn:outgoing>
    </bpmn:task>

     <bpmn:sequenceFlow id="SequenceFlow_PrepareReg" sourceRef="ParallelSplit_RegPricing" targetRef="Task_PrepareRegStatement"/>
    
    <bpmn:intermediateCatchEvent id="IntermediateCatch_SECClearance">
        <bpmn:incoming>SequenceFlow_WaitSEC</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow_FixPriceFinal</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

     <bpmn:sequenceFlow id="SequenceFlow_WaitSEC" sourceRef="Task_PrepareRegStatement" targetRef="IntermediateCatch_SECClearance"/>
    
    <bpmn:task id="Task_RoadShow">
      <bpmn:incoming>SequenceFlow_FirmPriceEstimate</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_JoinFinalize</bpmn:outgoing>
    </bpmn:task>

     <bpmn:sequenceFlow id="SequenceFlow_FirmPriceEstimate" sourceRef="ParallelSplit_RegPricing" targetRef="Task_RoadShow"/>
    
    <bpmn:parallelGateway id="ParallelJoin_Finalize">
        <bpmn:incoming>SequenceFlow_FixPriceFinal</bpmn:incoming>
        <bpmn:incoming>SequenceFlow_JoinFinalize</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow_BuyStockCommitment</bpmn:outgoing>
    </bpmn:parallelGateway>

     <bpmn:task id="Task_FixIssuePriceFinal">
        <bpmn:incoming>SequenceFlow_WaitSEC</bpmn:incoming> 
        <bpmn:outgoing>SequenceFlow_BuyStockCommitment</bpmn:outgoing>
    </bpmn:task>

     <bpmn:sequenceFlow id="SequenceFlow_FixPriceFinal" sourceRef="IntermediateCatch_SECClearance" targetRef="ParallelJoin_Finalize"/>
    
    <bpmn:task id="Task_BuyStockCommitment">
        <bpmn:incoming>SequenceFlow_BuyStockCommitment</bpmn:incoming> 
        <bpmn:outgoing>SequenceFlow_ReasonNotOffer</bpmn:outgoing>
      </bpmn:task>

     <bpmn:sequenceFlow id="SequenceFlow_JoinFinalize" sourceRef="Task_RoadShow" targetRef="ParallelJoin_Finalize"/>
    
    <bpmn:exclusiveGateway id="ExclusiveGateway_ReasonNotOffer">
        <bpmn:incoming>SequenceFlow_ReasonNotOffer</bpmn:incoming> 
        <bpmn:outgoing>SequenceFlow_OfferPublicly</bpmn:outgoing>
    </bpmn:exclusiveGateway>

     <bpmn:endEvent id="End_OfferedPublicly">
       <bpmn:incoming>SequenceFlow_OfferPublicly</bpmn:incoming> 
    </bpmn:endEvent>

     <bpmn:sequenceFlow id="SequenceFlow_BuyStockCommitment" sourceRef="ParallelJoin_Finalize" targetRef="Task_BuyStockCommitment"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ReasonNotOffer" sourceRef="Task_BuyStockCommitment" targetRef="ExclusiveGateway_ReasonNotOffer"/>

     <bpmn:endEvent id="End_Rejected">
       <bpmn:incoming>SequenceFlow_Rejected</bpmn:incoming> 
    </bpmn:endEvent>

     <bpmn:sequenceFlow id="SequenceFlow_OfferPublicly" sourceRef="ExclusiveGateway_ReasonNotOffer" targetRef="End_OfferedPublicly"/>
    
  </bpmn:process>
</bpmn:definitions>