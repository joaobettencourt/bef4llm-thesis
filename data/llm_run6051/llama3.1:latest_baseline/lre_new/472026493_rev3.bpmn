<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_0geryc1">
    <bpmn:participant id="Participant_0ygkg4f" name="IT Department" processRef="Process_1" />
    <bpmn:participant id="Participant_0ygkg5a" name="Supplier" processRef="Process_2" />
    <bpmn:participant id="Participant_0ygkg6d" name="Financial Department" processRef="Process_3" />
    <bpmn:participant id="Participant_0ygkg7e" name="Management" processRef="Process_4" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Request for new hardware received">
      <bpmn:outgoing>SequenceFlow_14a0oky</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="ExclusiveGateway_1mpgzhg" name="Approve or deny request">
      <bpmn:incoming>SequenceFlow_14a0oky</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0iu9po7</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_1xv6wk4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="SequenceFlow_14a0oky" sourceRef="StartEvent_1" targetRef="ExclusiveGateway_1mpgzhg" />
    <bpmn:task id="Task_12j0pib" name="Analyse request">
      <bpmn:incoming>SequenceFlow_0iu9po7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1j94oja</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_1j94oja" sourceRef="Task_12j0pib" targetRef="ExclusiveGateway_1mpgzhg" />
    <bpmn:endEvent id="EndEvent_1fx9yp3" name="Request denied">
      <bpmn:incoming>SequenceFlow_1xv6wk4</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:process id="Process_2" isExecutable="false">
    <bpmn:startEvent id="StartEvent_2" name="Email sent to supplier asking about prices">
      <bpmn:outgoing>SequenceFlow_14a0oky</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="EndEvent_2fx9yp3" name="Offer received from supplier">
      <bpmn:incoming>SequenceFlow_1j94oja</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:process id="Process_3" isExecutable="false">
    <bpmn:startEvent id="StartEvent_3" name="Form filled in and sent to management">
      <bpmn:outgoing>SequenceFlow_14a0oky</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="EndEvent_3fx9yp3" name="Invoice processed by financial department">
      <bpmn:incoming>SequenceFlow_1j94oja</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:process id="Process_4" isExecutable="false">
    <bpmn:startEvent id="StartEvent_4" name="Management analyses request and decides to approve or deny it">
      <bpmn:outgoing>SequenceFlow_14a0oky</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="EndEvent_4fx9yp3" name="Request approved by management">
      <bpmn:incoming>SequenceFlow_1j94oja</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>