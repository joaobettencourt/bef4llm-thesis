<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_0geryc1">
    <bpmn:participant id="Participant_0ygkg4f" name="Outpatient Physician"
                      processRef="Process_1"/>
    <bpmn:participant id="Participant_1jsoxba" name="Ward Physician"
                      processRef="Process_2"/>
    <bpmn:participant id="Participant_0vaxgaa" name="Lab Physician"
                      processRef="Process_3"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Process_1" name="Examination by Outpatient Physician">
      <bpmn:outgoing>SequenceFlow_14a0oky</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="ExclusiveGateway_1mpgzhg_Process_1" name="Healthy or Additional Examination?">
      <bpmn:incoming>SequenceFlow_14a0oky</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1j94oja</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_1dlbln9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_12j0pib" name="Fill out Examination Form">
      <bpmn:incoming>SequenceFlow_1j94oja</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0kz5g1t</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_Process_1" name="Examination Completed">
      <bpmn:incoming>SequenceFlow_0kz5g1t</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_0mp5byl</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:process id="Process_2" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Process_2" name="Appointment Arrangement by Delegate of Outpatient Physician">
      <bpmn:outgoing>SequenceFlow_14a0oky</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_05ftug5" name="Prepare Examination and Sampling">
      <bpmn:incoming>SequenceFlow_023hzxi</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0b2nw5c</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_Process_2" name="Follow-up Treatment Completed">
      <bpmn:incoming>SequenceFlow_0v64x8b</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:process id="Process_3" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Process_3" name="Sample Receipt by Lab Physician">
      <bpmn:outgoing>SequenceFlow_14a0oky</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="EndEvent_Process_3" name="Analysis Completed">
      <bpmn:incoming>SequenceFlow_0v64x8b</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:sequenceFlow id="SequenceFlow_14a0oky" sourceRef="StartEvent_Process_1"
                     targetRef="ExclusiveGateway_1mpgzhg_Process_1"/>
  <bpmn:sequenceFlow id="SequenceFlow_1j94oja" name="Healthy" sourceRef="ExclusiveGateway_1mpgzhg_Process_1"
                     targetRef="Task_12j0pib"/>
  <bpmn:sequenceFlow id="SequenceFlow_1dlbln9" name="Additional Examination" sourceRef="ExclusiveGateway_1mpgzhg_Process_1"
                     targetRef="Task_0jsoxba"/>
</bpmn:definitions>