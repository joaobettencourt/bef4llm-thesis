    <bpmn:sequenceFlow id="SequenceFlow_023hzxi" sourceRef="StartEvent_2" targetRef="Task_0vaxgaa" />
    <bpmn:task id="Task_0vaxgaa" name="MPON reads meter count from installed meter">
