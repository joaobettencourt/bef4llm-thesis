    <bpmn:sequenceFlow id="SequenceFlow_0buzwss" sourceRef="ExclusiveGateway_1dgb4sg" targetRef="EndEvent_1fx9yp3" />

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_1fx9yp3" name="End">
