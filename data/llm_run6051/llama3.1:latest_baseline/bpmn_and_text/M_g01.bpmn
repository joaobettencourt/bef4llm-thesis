<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_0geryc1">
    <bpmn:participant id="Participant_0ygkg4f" name="Artist" processRef="Process_1"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_1viot5w" name="Artist">
        <bpmn:flowNodeRef>Task_12j0pib</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1ocseyo" name="Customer">
        <bpmn:flowNodeRef>Task_0jsoxba</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_0vaxgaa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_0e6hvnj</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_0s79ile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_0p2e5vq</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Core Flow Elements -->
    <bpmn:startEvent id="StartEvent_1" name="Craving a custom 3D model">
      <bpmn:outgoing>SequenceFlow_14a0oky</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_12j0pib" name="Instruct artist to create project">
      <bpmn:incoming>SequenceFlow_14a0oky</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1j94oja</bpmn:outgoing>
    </bpmn:task>

    <!-- Artist Lane -->
    <bpmn:sequenceFlow id="SequenceFlow_1j94oja" sourceRef="Task_12j0pib" targetRef="Task_0vaxgaa"/>
    <bpmn:task id="Task_0vaxgaa" name="Send sketches and instructions to artist">
      <bpmn:incoming>SequenceFlow_1j94oja</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0mp5byl</bpmn:outgoing>
    </bpmn:task>

    <!-- Customer Lane -->
    <bpmn:sequenceFlow id="SequenceFlow_14a0oky" sourceRef="StartEvent_1" targetRef="Task_0jsoxba"/>
    <bpmn:task id="Task_0jsoxba" name="Check if color is in stock">
      <bpmn:incoming>SequenceFlow_14a0oky</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1dlbln9</bpmn:outgoing>
    </bpmn:task>

    <!-- Color Lane -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_1mpgzhg" name="Color in stock?">
      <bpmn:incoming>SequenceFlow_0mp5byl</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0iu9po7</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_1xv6wk4</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Customer Lane -->
    <bpmn:sequenceFlow id="SequenceFlow_0mp5byl" sourceRef="Task_0vaxgaa" targetRef="ExclusiveGateway_1mpgzhg"/>
    <bpmn:task id="Task_0e6hvnj" name="Order color if not in stock">
      <bpmn:incoming>SequenceFlow_1xv6wk4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1pq8ub3</bpmn:outgoing>
    </bpmn:task>

    <!-- Color Lane -->
    <bpmn:sequenceFlow id="SequenceFlow_0iu9po7" sourceRef="ExclusiveGateway_1mpgzhg" targetRef="Task_0e6hvnj"/>
    <bpmn:task id="Task_0s79ile" name="Check color level">
      <bpmn:incoming>SequenceFlow_1pq8ub3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_035vf60</bpmn:outgoing>
    </bpmn:task>

    <!-- Customer Lane -->
    <bpmn:sequenceFlow id="SequenceFlow_1dlbln9" sourceRef="Task_0jsoxba" targetRef="InclusiveGateway_0p2e5vq"/>
    <bpmn:inclusiveGateway id="InclusiveGateway_0p2e5vq">
      <bpmn:incoming>SequenceFlow_1dlbln9</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_023hzxi</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_1ujhfx4</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Printer Lane -->
    <bpmn:sequenceFlow id="SequenceFlow_0pq8ub3" sourceRef="Task_0e6hvnj" targetRef="Task_0s79ile"/>
    <bpmn:task id="Task_05ftug5" name="Turn on printer and heat up bed and extruder">
      <bpmn:incoming>SequenceFlow_1ujhfx4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0b2nw5c</bpmn:outgoing>
    </bpmn:task>

    <!-- Customer Lane -->
    <bpmn:sequenceFlow id="SequenceFlow_023hzxi" sourceRef="InclusiveGateway_0p2e5vq" targetRef="Task_0jsoxba"/>
    <bpmn:endEvent id="EndEvent_1" name="Model printed">
      <bpmn:incoming>SequenceFlow_0v64x8b</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Printer Lane -->
    <bpmn:sequenceFlow id="SequenceFlow_1ujhfx4" sourceRef="InclusiveGateway_0p2e5vq" targetRef="Task_05ftug5"/>
    <bpmn:task id="Task_0sl26uo" name="Generate gcode file">
      <bpmn:incoming>SequenceFlow_0b2nw5c</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0v64x8b</bpmn:outgoing>
    </bpmn:task>

    <!-- Customer Lane -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_1ouv9kf" name="Color level?">
      <bpmn:incoming>SequenceFlow_035vf60</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_06kfaev</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Printer Lane -->
    <bpmn:sequenceFlow id="SequenceFlow_0pq8ub3" sourceRef="Task_0e6hvnj" targetRef="Task_0s79ile"/>
    <bpmn:endEvent id="EndEvent_2" name="Model printed">
      <bpmn:incoming>SequenceFlow_0v64x8b</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Customer Lane -->
    <bpmn:sequenceFlow id="SequenceFlow_035vf60" sourceRef="Task_0s79ile" targetRef="ExclusiveGateway_1ouv9kf"/>
    <bpmn:sequenceFlow id="SequenceFlow_06kfaev" sourceRef="ExclusiveGateway_1ouv9kf" targetRef="EndEvent_2"/>
  </bpmn:process>
</bpmn:definitions>