<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  id="Definitions_1" name="ServiceForYourFridge">
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Your fridge produces strange noises">
      <bpmn:outgoing>SequenceFlow_ID_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="ServiceTask_1" name="Describe symptoms and send to central service center">
      <bpmn:incoming>SequenceFlow_ID_0</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ID_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway_1" name="Select local service facility">
      <bpmn:incoming>SequenceFlow_ID_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ID_2</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ID_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask_2" name="Make appointment with local service facility">
      <bpmn:incoming>SequenceFlow_ID_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ID_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_1" name="Fridge is repaired">
      <bpmn:incoming>SequenceFlow_ID_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow_ID_0" sourceRef="StartEvent_1" targetRef="ServiceTask_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_ID_1" sourceRef="ServiceTask_1" targetRef="ExclusiveGateway_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_ID_2" sourceRef="ExclusiveGateway_1" targetRef="ServiceTask_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_ID_3" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_ID_4" sourceRef="ServiceTask_2" targetRef="ExclusiveGateway_2"/>
    <bpmn:exclusiveGateway id="ExclusiveGateway_2" name="Confirm receipt of payment">
      <bpmn:incoming>SequenceFlow_ID_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ID_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_2" name="Fridge is repaired and payment confirmed">
      <bpmn:incoming>SequenceFlow_ID_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow_ID_5" sourceRef="ExclusiveGateway_2" targetRef="EndEvent_1"/>
    <bpmn:serviceTask id="ServiceTask_3" name="Confirm receipt of payment">
      <bpmn:incoming>SequenceFlow_ID_6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ID_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_3" name="Fridge is repaired and payment confirmed">
      <bpmn:incoming>SequenceFlow_ID_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow_ID_6" sourceRef="ServiceTask_3" targetRef="EndEvent_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_ID_7" sourceRef="ServiceTask_3" targetRef="EndEvent_3"/>
  </bpmn:process>
</bpmn:definitions>