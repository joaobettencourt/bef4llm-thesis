<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  id="Definitions_1">
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Check requirements for working and living in Austria">
      <outgoing>SequenceFlow_0</outgoing>
    </bpmn:startEvent>

    <bpmn:sequenceFlow id="SequenceFlow_0" sourceRef="StartEvent_1" targetRef="Task_1"/>

    <bpmn:task id="Task_1" name="Organize accommodation and bank account (negotiation)">
      <incoming>SequenceFlow_0</incoming>
      <outgoing>SequenceFlow_1</outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="Task_1" targetRef="Task_2"/>

    <bpmn:task id="Task_2" name="Check visa requirements">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="Task_2" targetRef="ExclusiveGateway_1"/>

    <bpmn:exclusiveGateway id="ExclusiveGateway_1" name="Check if visa is required">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
      <outgoing>SequenceFlow_4</outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_1" targetRef="Task_3"/>
    <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_1" targetRef="Task_5"/>

    <bpmn:task id="Task_3" name="Apply for visa">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_5</outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="Task_3" targetRef="ExclusiveGateway_2"/>

    <bpmn:exclusiveGateway id="ExclusiveGateway_2" name="Check if visa is approved">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_6</outgoing>
      <outgoing>SequenceFlow_7</outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="ExclusiveGateway_2" targetRef="Task_4"/>
    <bpmn:sequenceFlow id="SequenceFlow_7" sourceRef="ExclusiveGateway_2" targetRef="EndEvent_1"/>

    <bpmn:task id="Task_4" name="Collect required documents">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_8" sourceRef="Task_4" targetRef="EndEvent_1"/>

    <bpmn:endEvent id="EndEvent_1" name="Process finished">
      <incoming>SequenceFlow_7</incoming>
      <incoming>SequenceFlow_8</incoming>
    </bpmn:endEvent>

    <bpmn:task id="Task_5" name="Check if visa is required for specific circumstances">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_9</outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_9" sourceRef="Task_5" targetRef="ExclusiveGateway_3"/>

    <bpmn:exclusiveGateway id="ExclusiveGateway_3" name="Check if visa is required for specific circumstances">
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_10</outgoing>
      <outgoing>SequenceFlow_11</outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="ExclusiveGateway_3" targetRef="Task_6"/>
    <bpmn:sequenceFlow id="SequenceFlow_11" sourceRef="ExclusiveGateway_3" targetRef="EndEvent_1"/>

    <bpmn:task id="Task_6" name="Apply for visa for specific circumstances">
      <incoming>SequenceFlow_10</incoming>
      <outgoing>SequenceFlow_12</outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_12" sourceRef="Task_6" targetRef="EndEvent_1"/>
  </bpmn:process>
</bpmn:definitions>