<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/2.0"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
                  targetNamespace="http://bpmn.io/schema/bpmn" id="Definitions_1">
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:startEvent id="Start_Event">
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="User_Task_1" name="Report Job Applications">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Service_Task_1" name="New Job Offers">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="User_Task_2" name="Check Job Offers">
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Exclusive_Gateway_1" name="Job Interview">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="User_Task_3" name="Job Interview">
      <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Event">
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_7</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <!-- No layout information is included -->
  </bpmndi:BPMNDiagram>
  <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="Start_Event" targetRef="User_Task_1"/>
  <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="User_Task_1" targetRef="Service_Task_1"/>
  <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="Service_Task_1" targetRef="User_Task_2"/>
  <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="User_Task_2" targetRef="Exclusive_Gateway_1"/>
  <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="Exclusive_Gateway_1" targetRef="User_Task_3"/>
  <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="Exclusive_Gateway_1" targetRef="End_Event"/>
  <bpmn:sequenceFlow id="SequenceFlow_7" sourceRef="User_Task_3" targetRef="End_Event"/>
</bpmn:definitions>