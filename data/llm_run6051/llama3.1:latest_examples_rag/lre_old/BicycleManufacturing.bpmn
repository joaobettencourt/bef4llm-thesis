    <bpmn:sequenceFlow id="SequenceFlow_7" sourceRef="Task_6" targetRef="ExclusiveGateway_1"/>
    <bpmn:task id="Task_8" name="Reserve part">
      <bpmn:incoming>SequenceFlow_8</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_8" sourceRef="ExclusiveGateway_1" targetRef="Task_8"/>
    <bpmn:task id="Task_9" name="Back-order part">
      <bpmn:incoming>SequenceFlow_9</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_9" sourceRef="ExclusiveGateway_1" targetRef="Task_9"/>
    <bpmn:endEvent id="EndEvent_4" name="Finish process">
      <bpmn:incoming>SequenceFlow_10</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="Task_8" targetRef="EndEvent_4"/>
    <bpmn:sequenceFlow id="SequenceFlow_11" sourceRef="Task_9" targetRef="EndEvent_4"/>
  </bpmn:process>
  <bpmn:process id="Process_2" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_2" name="Engineering Department">
        <bpmn:flowNodeRef>StartEvent_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_6</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_5" name="Prepare for assembling">
      <bpmn:outgoing>SequenceFlow_12</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_12" name="Prepare for assembling">
      <bpmn:incoming>SequenceFlow_12</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="ExclusiveGateway_2">
      <bpmn:incoming>SequenceFlow_13</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_14</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_15</bpmn:outgoing>
