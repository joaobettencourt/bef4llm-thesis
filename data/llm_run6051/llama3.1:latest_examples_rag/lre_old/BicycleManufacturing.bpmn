    <bpmn:sequenceFlow id="SequenceFlow_16" sourceRef="Task_16" targetRef="EndEvent_7"/>
    <bpmn:sequenceFlow id="SequenceFlow_17" sourceRef="Task_16" targetRef="EndEvent_6"/>
