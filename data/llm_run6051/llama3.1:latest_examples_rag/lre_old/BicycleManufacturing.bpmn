    <bpmn:sequenceFlow id="SequenceFlow_15" sourceRef="ExclusiveGateway_2" targetRef="Task_16"/>
    <bpmn:task id="Task_16" name="Assemble bicycle">
      <bpmn:incoming>SequenceFlow_15</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_7" name="Finish process">
