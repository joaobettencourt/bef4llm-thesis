        <bpmn:flowNodeRef>Task_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateMessageEventThrowing_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_0</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Finalize dates">
      <bpmn:outgoing>SequenceFlow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_0" name="Update all group calendars">
      <bpmn:incoming>SequenceFlow_0</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_0" sourceRef="StartEvent_1" targetRef="Task_0"/>
    <bpmn:task id="Task_1" name="Create meeting folders and upload documents">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="Task_0" targetRef="Task_1"/>
    <bpmn:intermediateThrowEvent id="IntermediateMessageEventThrowing_0" name="Send schedule to members">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="IntermediateMessageEventThrowing_0"/>
    <bpmn:intermediateCatchEvent id="IntermediateMessageEventCatching_0" name="Receive schedule conflicts">
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="IntermediateMessageEventThrowing_0" targetRef="IntermediateMessageEventCatching_0"/>
    <bpmn:task id="Task_2" name="Update departmental records">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="IntermediateMessageEventCatching_0" targetRef="Task_2"/>
    <bpmn:intermediateThrowEvent id="IntermediateMessageEventThrowing_1" name="Send final schedule to members">
      <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="Task_2" targetRef="IntermediateMessageEventThrowing_1"/>
    <bpmn:endEvent id="EndEvent_0" name="">
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="IntermediateMessageEventThrowing_1" targetRef="EndEvent_0"/>
  </bpmn:process>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_1" name="Committee Members">
        <bpmn:flowNodeRef>StartEvent_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateMessageEventThrowing_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateMessageEventCatching_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_0" name="Receive meeting schedule">
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_3" name="Check for conflicts">
