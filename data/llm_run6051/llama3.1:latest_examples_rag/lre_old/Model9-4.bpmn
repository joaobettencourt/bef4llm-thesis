    <bpmn:endEvent id="EndEvent_1" name="">
      <bpmn:incoming>SequenceFlow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="IntermediateMessageEventCatching_1" targetRef="EndEvent_1"/>
