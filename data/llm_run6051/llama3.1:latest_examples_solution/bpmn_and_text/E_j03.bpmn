<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="incident happens"></bpmn:startEvent>
    
    <bpmn:userTask id="UserTask_1" name="start assessment tool"></bpmn:userTask>
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="UserTask_1" targetRef="ExclusiveGateway_1"></bpmn:sequenceFlow>
    
    <bpmn:exclusiveGateway id="ExclusiveGateway_1" name="self employed &amp;&#10; accident happened to you ?">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <bpmn:userTask id="UserTask_2" name="enter incident type"></bpmn:userTask>
    <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="UserTask_2" targetRef="ExclusiveGateway_1"></bpmn:sequenceFlow>
    
    <bpmn:endEvent id="EndEvent_1" name="everything done">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
    </bpmn:endEvent>
    
    <bpmn:userTask id="UserTask_3" name="enter victim's data"></bpmn:userTask>
    <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="UserTask_3" targetRef="ExclusiveGateway_2"></bpmn:sequenceFlow>
    
    <bpmn:endEvent id="EndEvent_2" name="everything done">
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
    </bpmn:endEvent>
    
    <bpmn:userTask id="UserTool_1" name="propose tasks to user"></bpmn:userTask>
    <bpmn:sequenceFlow id="SequenceFlow_7" sourceRef="UserTool_1" targetRef="ExclusiveGateway_3"></bpmn:sequenceFlow>
    
    <bpmn:endEvent id="EndEvent_3" name="everything done">
      <bpmn:incoming>SequenceFlow_8</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  
  <bpmn:exclusiveGateway id="ExclusiveGateway_2" name="victim is student?">
    <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
    <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
  </bpmn:exclusiveGateway>
  
  <bpmn:exclusiveGateway id="ExclusiveGateway_3" name="victim has &#10;private insurance?">
    <bpmn:incoming>SequenceFlow_7</bpmn:incoming>
    <bpmn:outgoing>SequenceFlow_8</bpmn:outgoing>
  </bpmn:exclusiveGateway>
  
  <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="ExclusiveGateway_1" targetRef="UserTask_4"></bpmn:sequenceFlow>
  
  <bpmn:userTask id="UserTask_4" name="propose tasks to user"></bpmn:userTask>
  <bpmn:sequenceFlow id="SequenceFlow_8" sourceRef="ExclusiveGateway_3" targetRef="EndEvent_1"></bpmn:sequenceFlow>
  
  <bpmn:endEvent id="EndEvent_4" name="everything done">
    <bpmn:incoming>SequenceFlow_9</bpmn:incoming>
  </bpmn:endEvent>
  
  <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="ExclusiveGateway_2" targetRef="UserTask_5"></bpmn:sequenceFlow>
  
  <bpmn:userTask id="UserTask_5" name="propose tasks to user"></bpmn:userTask>
  <bpmn:sequenceFlow id="SequenceFlow_9" sourceRef="UserTool_1" targetRef="EndEvent_4"></bpmn:sequenceFlow>
</bpmn:definitions>