<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1">
  
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Process start event"></bpmn:startEvent>
    
    <!-- Find out which resources are needed -->
    <scriptTask id="ScriptTask_1" bpmn:type="BPMN$ScriptTask" completionQuantity="1" isForCompensation="false" name="Find resources" scriptFormat="" startQuantity="1">
      <bpmn:extensionElements>
        <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffcc"/>
        <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
      </bpmn:extensionElements>
    </scriptTask>
    
    <!-- Create a list of resources to be collected -->
    <scriptTask id="ScriptTask_2" bpmn:type="BPMN$ScriptTask" completionQuantity="1" isForCompensation="false" name="Create resource list" scriptFormat="" startQuantity="1">
      <bpmn:extensionElements>
        <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffcc"/>
        <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
      </bpmn:extensionElements>
    </scriptTask>
    
    <!-- Collect resources in parallel -->
    <parallelGateway id="ParallelGateway_1" bpmn:type="BPMN$ParallelGateway" gatewayDirection="Diverging">
      <bpmn:extensionElements>
        <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
        <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
      </bpmn:extensionElements>
    </parallelGateway>
    
    <!-- Check if all resources are available -->
    <scriptTask id="ScriptTask_3" bpmn:type="BPMN$ScriptTask" completionQuantity="1" isForCompensation="false" name="Check resource availability" scriptFormat="" startQuantity="1">
      <bpmn:extensionElements>
        <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffcc"/>
        <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
      </bpmn:extensionElements>
    </scriptTask>
    
    <!-- Start farming -->
    <startEvent id="StartEvent_2" bpmn:type="BPMN$StartEvent" name="Farming started"></bpmn:startEvent>
    
    <!-- Farming loop -->
    <sequenceFlow id="SequenceFlow_1" sourceRef="ParallelGateway_1" targetRef="ScriptTask_3">
      <bpmn:extensionElements>
        <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
      </bpmn:extensionElements>
    </sequenceFlow>
    
    <!-- Check if milestone is reached -->
    <scriptTask id="ScriptTask_4" bpmn:type="BPMN$ScriptTask" completionQuantity="1" isForCompensation="false" name="Check milestone" scriptFormat="" startQuantity="1">
      <bpmn:extensionElements>
        <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffcc"/>
        <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
      </bpmn:extensionElements>
    </scriptTask>
    
    <!-- Notify player -->
    <serviceTask id="ServiceTask_1" bpmn:type="BPMN$ServiceTask" completionQuantity="1" implementation="##WebService" isForCompensation="false" name="Notify player" startQuantity="1">
      <bpmn:extensionElements>
        <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffcc"/>
        <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
      </bpmn:extensionElements>
    </serviceTask>
    
    <!-- End farming -->
    <endEvent id="EndEvent_1" bpmn:type="BPMN$EndEvent" name="Farming ended"></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>