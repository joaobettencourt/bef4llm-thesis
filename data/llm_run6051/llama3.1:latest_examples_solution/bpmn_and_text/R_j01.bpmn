<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  
    <process id="Process_1" isExecutable="false">
      <startEvent id="StartEvent_1" name="Process start event"></startEvent>
      <serviceTask completionQuantity="1" id="ServiceTask_1" implementation="##WebService" isForCompensation="false" name="Check connection" startQuantity="1">
        <incoming>SequenceFlow_1</incoming>
        <outgoing>SequenceFlow_2</outgoing>
      </serviceTask>
      <exclusiveGateway default="ExclusiveGateway_1" gatewayDirection="Diverging" id="ExclusiveGateway_0" name="Is the machine connected?">
        <incoming>SequenceFlow_2</incoming>
        <outgoing>SequenceFlow_3</outgoing>
        <outgoing>SequenceFlow_4</outgoing>
      </exclusiveGateway>
      <serviceTask completionQuantity="1" id="ServiceTask_2" implementation="##WebService" isForCompensation="false" name="Collect information from machine" startQuantity="1">
        <incoming>SequenceFlow_3</incoming>
        <outgoing>SequenceFlow_5</outgoing>
      </serviceTask>
      <exclusiveGateway default="ExclusiveGateway_2" gatewayDirection="Diverging" id="ExclusiveGateway_1" name="Is OEE below a certain percentage?">
        <incoming>SequenceFlow_5</incoming>
        <outgoing>SequenceFlow_6</outgoing>
        <outgoing>SequenceFlow_7</outgoing>
      </exclusiveGateway>
      <parallelGateway gatewayDirection="Diverging" id="ParallelGateway_1" name="">
        <incoming>SequenceFlow_7</incoming>
        <outgoing>SequenceFlow_8</outgoing>
        <outgoing>SequenceFlow_9</outgoing>
      </parallelGateway>
      <userTask completionQuantity="1" id="UserTask_1" implementation="##WebService" isForCompensation="false" name="Stop the machine" startQuantity="1">
        <incoming>SequenceFlow_8</incoming>
        <outgoing>SequenceFlow_10</outgoing>
      </userTask>
      <exclusiveGateway default="ExclusiveGateway_3" gatewayDirection="Diverging" id="ExclusiveGateway_2" name="Has any engineer responded?">
        <incoming>SequenceFlow_11</incoming>
        <outgoing>SequenceFlow_12</outgoing>
        <outgoing>SequenceFlow_13</outgoing>
      </exclusiveGateway>
      <userTask completionQuantity="1" id="UserTask_2" implementation="##WebService" isForCompensation="false" name="Notify the Repair and Service center" startQuantity="1">
        <incoming>SequenceFlow_12</incoming>
        <outgoing>SequenceFlow_14</outgoing>
      </userTask>
      <exclusiveGateway gatewayDirection="Converging" id="ExclusiveGateway_3" name="">
        <incoming>SequenceFlow_10</incoming>
        <incoming>SequenceFlow_15</incoming>
        <outgoing>SequenceFlow_16</outgoing>
      </exclusiveGateway>
      <serviceTask completionQuantity="1" id="ServiceTask_3" implementation="##WebService" isForCompensation="false" name="Restart the machine" startQuantity="1">
        <incoming>SequenceFlow_15</incoming>
        <outgoing>SequenceFlow_17</outgoing>
      </serviceTask>
      <userTask completionQuantity="1" id="UserTask_3" implementation="##WebService" isForCompensation="false" name="Do the diagnosis/repair" startQuantity="1">
        <incoming>SequenceFlow_18</incoming>
        <outgoing>SequenceFlow_19</outgoing>
      </userTask>
      <endEvent id="EndEvent_1" name="End"></endEvent>
      <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="ServiceTask_1">
        <extensionElements>
          <bpmndi:ExtensionElements>
            <bpmndi:PropertyString bpmnElement="ServiceTask_1" name="bordercolor">#000000</bpmndi:PropertyString>
          </bpmndi:ExtensionElements>
        </extensionElements>
      </sequenceFlow>
      <sequenceFlow id="SequenceFlow_2" sourceRef="ServiceTask_1" targetRef="ExclusiveGateway_0">
        <extensionElements>
          <bpmndi:ExtensionElements>
            <bpmndi:PropertyString bpmnElement="ExclusiveGateway_0" name="bordercolor">#000000</bpmndi:PropertyString>
          </bpmndi:ExtensionElements>
        </extensionElements>
      </sequenceFlow>
      <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_0" targetRef="ServiceTask_2">
        <extensionElements>
          <bpmndi:ExtensionElements>
            <bpmndi:PropertyString bpmnElement="ServiceTask_2" name="bordercolor">#000000</bpmndi:PropertyString>
          </bpmndi:ExtensionElements>
        </extensionElements>
      </sequenceFlow>
      <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_0" targetRef="ParallelGateway_1">
        <extensionElements>
          <bpmndi:ExtensionElements>
            <bpmndi:PropertyString bpmnElement="ParallelGateway_1" name="bordercolor">#000000</bpmndi:PropertyString>
          </bpmndi:ExtensionElements>
        </extensionElements>
      </sequenceFlow>
      <sequenceFlow id="SequenceFlow_5" sourceRef="ServiceTask_2" targetRef="ExclusiveGateway_1">
        <extensionElements>
          <bpmndi:ExtensionElements>
            <bpmndi:PropertyString bpmnElement="ExclusiveGateway_1" name="bordercolor">#000000</bpmndi:PropertyString>
          </bpmndi:ExtensionElements>
        </extensionElements>
      </sequenceFlow>
      <sequenceFlow id="SequenceFlow_6" sourceRef="ExclusiveGateway_1" targetRef="ParallelGateway_1">
        <extensionElements>
          <bpmndi:ExtensionElements>
            <bpmndi:PropertyString bpmnElement="ParallelGateway_1" name="bordercolor">#000000</bpmndi:PropertyString>
          </bpmndi:ExtensionElements>
        </extensionElements>
      </sequenceFlow>
      <sequenceFlow id="SequenceFlow_7" sourceRef="ExclusiveGateway_1" targetRef="ParallelGateway_1">
        <extensionElements>
          <bpmndi:ExtensionElements>
            <bpmndi:PropertyString bpmnElement="ParallelGateway_1" name="bordercolor">#000000</bpmndi:PropertyString>
          </bpmndi:ExtensionElements>
        </extensionElements>
      </sequenceFlow>
      <sequenceFlow id="SequenceFlow_8" sourceRef="ParallelGateway_1" targetRef="UserTask_1">
        <extensionElements>
          <bpmndi:ExtensionElements>
            <bpmndi:PropertyString bpmnElement="UserTask_1" name="bordercolor">#000000</bpmndi:PropertyString>
          </bpmndi:ExtensionElements>
        </extensionElements>
      </sequenceFlow>
      <sequenceFlow id="SequenceFlow_9" sourceRef="ParallelGateway_1" targetRef="ExclusiveGateway_2">
        <extensionElements>
          <bpmndi:ExtensionElements>
            <bpmndi:PropertyString bpmnElement="ExclusiveGateway_2" name="bordercolor">#000000</bpmndi:PropertyString>
          </bpmndi:ExtensionElements>
        </extensionElements>
      </sequenceFlow>
      <sequenceFlow id="SequenceFlow_10" sourceRef="UserTask_1" targetRef="ExclusiveGateway_3">
        <extensionElements>
          <bpmndi:ExtensionElements>
            <bpmndi:PropertyString bpmnElement="ExclusiveGateway_3" name="bordercolor">#000000</bpmndi:PropertyString>
          </bpmndi:ExtensionElements>
        </extensionElements>
      </sequenceFlow>
      <sequenceFlow id="SequenceFlow_11" sourceRef="ParallelGateway_1" targetRef="ExclusiveGateway_2">
        <extensionElements>
          <bpmndi:ExtensionElements>
            <bpmndi:PropertyString bpmnElement="ExclusiveGateway_2" name="bordercolor">#000000</bpmndi:PropertyString>
          </bpmndi:ExtensionElements>
        </extensionElements>
      </sequenceFlow>
      <sequenceFlow id="SequenceFlow_12" sourceRef="ExclusiveGateway_3" targetRef="UserTask_2">
        <extensionElements>
          <bpmndi:ExtensionElements>
            <bpmndi:PropertyString bpmnElement="UserTask_2" name="bordercolor">#000000</bpmndi:PropertyString>
          </bpmndi:ExtensionElements>
        </extensionElements>
      </sequenceFlow>
      <sequenceFlow id="SequenceFlow_13" sourceRef="ExclusiveGateway_3" targetRef="ParallelGateway_1">
        <extensionElements>
          <bpmndi:ExtensionElements>
            <bpmndi:PropertyString bpmnElement="ParallelGateway_1" name="bordercolor">#000000</bpmndi:PropertyString>
          </bpmndi:ExtensionElements>
        </extensionElements>
      </sequenceFlow>
      <sequenceFlow id="SequenceFlow_14" sourceRef="UserTask_2" targetRef="ExclusiveGateway_3">
        <extensionElements>
          <bpmndi:ExtensionElements>
            <bpmndi:PropertyString bpmnElement="ExclusiveGateway_3" name="bordercolor">#000000</bpmndi:PropertyString>
          </bpmndi:ExtensionElements>
        </extensionElements>
      </sequenceFlow>
      <sequenceFlow id="SequenceFlow_15" sourceRef="ParallelGateway_1" targetRef="ServiceTask_3">
        <extensionElements>
          <bpmndi:ExtensionElements>
            <bpmndi:PropertyString bpmnElement="ServiceTask_3" name="bordercolor">#000000</bpmndi:PropertyString>
          </bpmndi:ExtensionElements>
        </extensionElements>
      </sequenceFlow>
      <sequenceFlow id="SequenceFlow_16" sourceRef="ExclusiveGateway_3" targetRef="EndEvent_1">
        <extensionElements>
          <bpmndi:ExtensionElements>
            <bpmndi:PropertyString bpmnElement="EndEvent_1" name="bordercolor">#000000</bpmndi:PropertyString>
          </bpmndi:ExtensionElements>
        </extensionElements>
      </sequenceFlow>
      <sequenceFlow id="SequenceFlow_17" sourceRef="ServiceTask_3" targetRef="ParallelGateway_1">
        <extensionElements>
          <bpmndi:ExtensionElements>
            <bpmndi:PropertyString bpmnElement="ParallelGateway_1" name="bordercolor">#000000</bpmndi:PropertyString>
          </bpmndi:ExtensionElements>
        </extensionElements>
      </sequenceFlow>
      <sequenceFlow id="SequenceFlow_18" sourceRef="ParallelGateway_1" targetRef="UserTask_3">
        <extensionElements>
          <bpmndi:ExtensionElements>
            <bpmndi:PropertyString bpmnElement="UserTask_3" name="bordercolor">#000000</bpmndi:PropertyString>
          </bpmndi:ExtensionElements>
        </extensionElements>
      </sequenceFlow>
      <sequenceFlow id="SequenceFlow_19" sourceRef="UserTask_3" targetRef="EndEvent_1">
        <extensionElements>
          <bpmndi:ExtensionElements>
            <bpmndi:PropertyString bpmnElement="EndEvent_1" name="bordercolor">#000000</bpmndi:PropertyString>
          </bpmndi:ExtensionElements>
        </extensionElements>
      </sequenceFlow>
    </process>
</bpmn:definitions>