<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  targetNamespace="http://bpmn.io/schema/bpmn" id="Definitions_1">
  
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="wish to build a house"></bpmn:startEvent>
    
    <bpmn:userTask id="UserTask_1" name="Collect requirements" completionQuantity="1"
      implementation="##WebService" isForCompensation="false" startQuantity="1">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:userTask>
    
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="UserTask_1"></bpmn:sequenceFlow>
    
    <bpmn:userTask id="UserTask_2" name="Send requirements" completionQuantity="1"
      implementation="##WebService" isForCompensation="false" startQuantity="1">
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
    </bpmn:userTask>
    
    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="UserTask_1" targetRef="UserTask_2"></bpmn:sequenceFlow>
    
    <bpmn:exclusiveGateway id="ExclusiveGateway_1" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="UserTask_2" targetRef="ExclusiveGateway_1"></bpmn:sequenceFlow>
    
    <bpmn:userTask id="UserTask_3" name="Create order list" completionQuantity="1"
      implementation="##WebService" isForCompensation="false" startQuantity="1">
      <bpmn:incoming>SequenceFlow_7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_8</bpmn:outgoing>
    </bpmn:userTask>
    
    <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="ExclusiveGateway_1" targetRef="UserTask_3"></bpmn:sequenceFlow>
    
    <bpmn:exclusiveGateway id="ExclusiveGateway_2" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow_8</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_9</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <bpmn:userTask id="UserTask_4" name="Place order" completionQuantity="1"
      implementation="##WebService" isForCompensation="false" startQuantity="1">
      <bpmn:incoming>SequenceFlow_11</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_12</bpmn:outgoing>
    </bpmn:userTask>
    
    <bpmn:sequenceFlow id="SequenceFlow_7" sourceRef="UserTask_3" targetRef="ExclusiveGateway_2"></bpmn:sequenceFlow>
    
    <bpmn:sequenceFlow id="SequenceFlow_8" sourceRef="UserTask_3" targetRef="ExclusiveGateway_2"></bpmn:sequenceFlow>
    
    <bpmn:userTask id="UserTask_5" name="Hire building company" completionQuantity="1"
      implementation="##WebService" isForCompensation="false" startQuantity="1">
      <bpmn:incoming>SequenceFlow_13</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_14</bpmn:outgoing>
    </bpmn:userTask>
    
    <bpmn:sequenceFlow id="SequenceFlow_9" sourceRef="ExclusiveGateway_2" targetRef="UserTask_5"></bpmn:sequenceFlow>
    
    <bpmn:endEvent id="EndEvent_1" name="finished house">
      <bpmn:incoming>SequenceFlow_15</bpmn:incoming>
    </bpmn:endEvent>
    
    <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="ExclusiveGateway_2" targetRef="UserTask_4"></bpmn:sequenceFlow>
    
    <bpmn:sequenceFlow id="SequenceFlow_11" sourceRef="UserTask_4" targetRef="EndEvent_1"></bpmn:sequenceFlow>
    
    <bpmn:exclusiveGateway id="ExclusiveGateway_3" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow_14</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_16</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <bpmn:userTask id="UserTask_6" name="Call friends" completionQuantity="1"
      implementation="##WebService" isForCompensation="false" startQuantity="1">
      <bpmn:incoming>SequenceFlow_18</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_19</bpmn:outgoing>
    </bpmn:userTask>
    
    <bpmn:sequenceFlow id="SequenceFlow_13" sourceRef="UserTask_5" targetRef="ExclusiveGateway_3"></bpmn:sequenceFlow>
    
    <bpmn:sequenceFlow id="SequenceFlow_14" sourceRef="UserTask_5" targetRef="ExclusiveGateway_3"></bpmn:sequenceFlow>
    
    <bpmn:endEvent id="EndEvent_2" name="finished house">
      <bpmn:incoming>SequenceFlow_20</bpmn:incoming>
    </bpmn:endEvent>
    
    <bpmn:sequenceFlow id="SequenceFlow_16" sourceRef="ExclusiveGateway_3" targetRef="UserTask_6"></bpmn:sequenceFlow>
    
    <bpmn:sequenceFlow id="SequenceFlow_17" sourceRef="ExclusiveGateway_3" targetRef="EndEvent_2"></bpmn:sequenceFlow>
    
    <bpmn:endEvent id="EndEvent_3" name="finished house">
      <bpmn:incoming>SequenceFlow_21</bpmn:incoming>
    </bpmn:endEvent>
    
    <bpmn:sequenceFlow id="SequenceFlow_18" sourceRef="UserTask_6" targetRef="EndEvent_3"></bpmn:sequenceFlow>
  </bpmn:process>
</bpmn:definitions>