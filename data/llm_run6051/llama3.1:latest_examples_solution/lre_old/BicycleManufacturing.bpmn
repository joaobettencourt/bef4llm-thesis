      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_0" name="Process finished">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:parallelGateway id="ParallelGateway_1" name="Check part quantity">
