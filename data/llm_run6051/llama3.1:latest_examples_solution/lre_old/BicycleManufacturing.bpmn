    </bpmn:startEvent>
    <bpmn:task id="Task_11" name="Inform storehouse and engineering department">
      <bpmn:incoming>SequenceFlow_0</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="ExclusiveGateway_0" name="Accept order?">
