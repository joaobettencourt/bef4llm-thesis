<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                   xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_0" name="Customer Service" processRef="Process_0"/>
    <bpmn:participant id="Participant_1" name="Customer" processRef="Process_1"/>
    <bpmn:participant id="Participant_2" name="Service Management" processRef="Process_2"/>
    <bpmn:participant id="Participant_3" name="Resource Provisioning" processRef="Process_3"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_0" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_0" name="">
        <bpmn:flowNodeRef>StartNoneEvent_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Exclusive_Databased_Gateway_0</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent name="" id="StartNoneEvent_0">
      <bpmn:outgoing>SequenceFlow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task name="Enter problem report" id="Task_0">
      <bpmn:incoming>SequenceFlow_0</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway name="" id="Exclusive_Databased_Gateway_0">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
  </bpmn:process>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_1" name="">
        <bpmn:flowNodeRef>StartErrorEvent_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_8</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent name="" id="StartErrorEvent_0">
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task name="Send list of problem parameters" id="Task_8">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
    </bpmn:task>
  </bpmn:process>
  <bpmn:process id="Process_2" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_2" name="">
        <bpmn:flowNodeRef>StartMessageEvent_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Exclusive_Databased_Gateway_2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent name="" id="StartMessageEvent_0">
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task name="Investigate whether problem is analyzable at this level" id="Task_9">
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent name="" id="EndMessageEvent_0">
      <bpmn:incoming>SequenceFlow_7</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:process id="Process_3" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_3" name="">
        <bpmn:flowNodeRef>StartMessageEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_18</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Exclusive_Databased_Gateway_5</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent name="" id="StartMessageEvent_1">
      <bpmn:outgoing>SequenceFlow_8</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task name="Check for possible problems" id="Task_18">
      <bpmn:incoming>SequenceFlow_8</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_9</bpmn:outgoing>
    </bpmn:task>
  </bpmn:process>
  <bpmn:sequenceFlow id="SequenceFlow_0" sourceRef="StartNoneEvent_0" targetRef="Task_0"/>
  <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="Task_0" targetRef="Exclusive_Databased_Gateway_0"/>
  <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="Exclusive_Databased_Gateway_0" targetRef="EndNoneEvent_0"/>
  <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="Exclusive_Databased_Gateway_0" targetRef="Task_1"/>
  <bpmn:task name="Perform plausibility check" id="Task_1">
    <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
    <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
  </bpmn:task>
  <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="Task_1" targetRef="EndNoneEvent_0"/>
  <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="Task_8" targetRef="EndNoneEvent_2"/>
  <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="StartMessageEvent_0" targetRef="Task_9"/>
  <bpmn:sequenceFlow id="SequenceFlow_7" sourceRef="Task_9" targetRef="EndMessageEvent_0"/>
  <bpmn:sequenceFlow id="SequenceFlow_8" sourceRef="StartMessageEvent_1" targetRef="Task_18"/>
  <bpmn:sequenceFlow id="SequenceFlow_9" sourceRef="Task_18" targetRef="EndNoneEvent_6"/>
</bpmn:definitions>