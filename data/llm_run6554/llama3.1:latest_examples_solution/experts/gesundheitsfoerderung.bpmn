<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" targetNamespace="http://bpmn.io/schema/bpmn" id="Definitions_1">
  <bpmn:collaboration id="Collaboration_0">
    <bpmn:participant id="Participant_0" name="Trainings und Programmdurchführung" processRef="Process_0" />
  </bpmn:collaboration>
  <bpmn:process id="Process_0" isExecutable="true">
    <bpmn:laneSet id="LaneSet_0">
      <bpmn:lane id="Lane_0" name="Sportmediziner">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_5</bpmn:flowNodeRef>
