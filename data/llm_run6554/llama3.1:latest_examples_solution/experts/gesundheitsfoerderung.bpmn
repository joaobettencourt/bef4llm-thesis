    <bpmn:sequenceFlow id="Flow_8" sourceRef="Event_2" targetRef="Gateway_1" />
    <bpmn:sequenceFlow id="Flow_9" name="Nein" sourceRef="Gateway_1" targetRef="Task_6" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Gateway_1" targetRef="Event_3" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Event_3" targetRef="Event_2" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Event_2" targetRef="Task_7" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_7" targetRef="Event_4" />
  </bpmn:process>
