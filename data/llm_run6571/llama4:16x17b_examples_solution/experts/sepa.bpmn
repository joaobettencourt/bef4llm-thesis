<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definition" 
             name="BPMN Process Model"
             targetNamespace="http://example.com/bpmn">
  <process id="Process_1" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_IBAN_Check"/>
    <task id="Task_IBAN_Check" name="Check IBAN">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_IBAN_Check" targetRef="ExclusiveGateway_1"/>
    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
      <outgoing>SequenceFlow_4</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_1" targetRef="Task_Person_Search">
      <conditionExpression xsi:type="bpmn:tFormalExpression">iban exists</conditionExpression>
    </sequenceFlow>
    <task id="Task_Person_Search" name="Search Person">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_5</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_1" targetRef="Task_Manual_Check">
      <conditionExpression xsi:type="bpmn:tFormalExpression">not iban exists</conditionExpression>
    </sequenceFlow>
    <exclusiveGateway id="ExclusiveGateway_2">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_6</outgoing>
      <outgoing>SequenceFlow_7</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_5" sourceRef="Task_Person_Search" targetRef="ExclusiveGateway_2"/>
    <task id="Task_Mandat_Create" name="Create Mandate">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_6" sourceRef="ExclusiveGateway_2" targetRef="Task_Mandat_Create">
      <conditionExpression xsi:type="bpmn:tFormalExpression">all required information available</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="SequenceFlow_7" sourceRef="ExclusiveGateway_2" targetRef="Task_Manual_Check">
      <conditionExpression xsi:type="bpmn:tFormalExpression">not all required information available</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="SequenceFlow_8" sourceRef="Task_Mandat_Create" targetRef="EndEvent_1"/>
    <endEvent id="EndEvent_1">
      <incoming>SequenceFlow_8</incoming>
    </endEvent>
    <task id="Task_Manual_Check" name="Manual Check">
      <incoming>SequenceFlow_4</incoming>
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_9</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_9" sourceRef="Task_Manual_Check" targetRef="EndEvent_1"/>
  </process>
</definitions>