<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">

   <process id="Gesundheitsprogramm" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>

     <task id="Task_1" name="Gesundheits-Check">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="ParallelGateway_1"/>

     <parallelGateway id="ParallelGateway_1">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_4</outgoing>
     </parallelGateway>

     <sequenceFlow id="SequenceFlow_3" sourceRef="ParallelGateway_1" targetRef="Task_2"/>

     <task id="Task_2" name="Erfassung von Gesundheitsparametern">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_4" sourceRef="ParallelGateway_1" targetRef="Task_3"/>

     <task id="Task_3" name="Einweisung in App und Wearables">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_2" targetRef="Task_7"/>
     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_3" targetRef="Task_7"/>

     <task id="Task_7" name="Erstellung von Trainings- und Ernährungsplänen">
       <incoming>SequenceFlow_5</incoming>
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_8</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_8" sourceRef="Task_7" targetRef="SubProcess_1"/>

     <subProcess id="SubProcess_1">
       <startEvent id="StartEvent_Subprocess">
         <outgoing>SequenceFlow_Subprocess_1</outgoing>
       </startEvent>

       <sequenceFlow id="SequenceFlow_Subprocess_1" sourceRef="StartEvent_Subprocess" targetRef="Task_4"/>

       <task id="Task_4" name="Trainingsphase mit Ernährungsberatung">
         <incoming>SequenceFlow_Subprocess_1</incoming>
         <outgoing>SequenceFlow_Subprocess_2</outgoing>
       </task>

       <sequenceFlow id="SequenceFlow_Subprocess_2" sourceRef="Task_4" targetRef="IntermediateEvent_1"/>

       <intermediateEvent id="IntermediateEvent_1">
         <incoming>SequenceFlow_Subprocess_2</incoming>
         <outgoing>SequenceFlow_Subprocess_3</outgoing>
       </intermediateEvent>

       <sequenceFlow id="SequenceFlow_Subprocess_3" sourceRef="IntermediateEvent_1" targetRef="Task_5"/>

       <task id="Task_5" name="Zischen-Check">
         <incoming>SequenceFlow_Subprocess_3</incoming>
         <outgoing>SequenceFlow_Subprocess_4</outgoing>
       </task>

       <sequenceFlow id="SequenceFlow_Subprocess_4" sourceRef="Task_5" targetRef="ExclusiveGateway_1"/>

       <exclusiveGateway id="ExclusiveGateway_1">
         <incoming>SequenceFlow_Subprocess_4</incoming>
         <outgoing>SequenceFlow_Subprocess_5</outgoing>
         <outgoing>SequenceFlow_Subprocess_6</outgoing>
       </exclusiveGateway>

       <sequenceFlow id="SequenceFlow_Subprocess_5" sourceRef="ExclusiveGateway_1" targetRef="Task_6"/>

       <task id="Task_6" name="Training mit Wearables und App">
         <incoming>SequenceFlow_Subprocess_5</incoming>
         <outgoing>SequenceFlow_Subprocess_7</outgoing>
       </task>

       <sequenceFlow id="SequenceFlow_Subprocess_7" sourceRef="Task_6" targetRef="EndEvent_Subprocess"/>

       <sequenceFlow id="SequenceFlow_Subprocess_6" sourceRef="ExclusiveGateway_1" targetRef="Task_8"/>

       <task id="Task_8" name="Training ohne Wearables und App">
         <incoming>SequenceFlow_Subprocess_6</incoming>
         <outgoing>SequenceFlow_Subprocess_9</outgoing>
       </task>

       <sequenceFlow id="SequenceFlow_Subprocess_9" sourceRef="Task_8" targetRef="EndEvent_Subprocess"/>

       <endEvent id="EndEvent_Subprocess">
         <incoming>SequenceFlow_Subprocess_7</incoming>
         <incoming>SequenceFlow_Subprocess_9</incoming>
       </endEvent>

     </subProcess>

     <sequenceFlow id="SequenceFlow_9" sourceRef="SubProcess_1" targetRef="Task_9"/>

     <task id="Task_9" name="Abschließender Gesundheits-Check">
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_10</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_10" sourceRef="Task_9" targetRef="EndEvent_2"/>

     <endEvent id="EndEvent_2">
       <incoming>SequenceFlow_10</incoming>
     </endEvent>

   </process>

</definitions>