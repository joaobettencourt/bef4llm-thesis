<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://bpmn.io/schema/bpmn">
  <collaboration id="Collaboration_1">
    <participant id="Participant_1" name="Dispatch of goods&#10;Computer Hardware Shop" processRef="Process_1"/>
  </collaboration>
  <process id="Process_1" isExecutable="true">
    <laneSet id="LaneSet_1">
      <lane id="Lane_0" name="Secretary">
        <flowNodeRef>StartEvent_1</flowNodeRef>
        <flowNodeRef>InclusiveGateway_1</flowNodeRef>
        <flowNodeRef>Task_0s79ile</flowNodeRef>
        <flowNodeRef>ExclusiveGateway_1</flowNodeRef>
        <flowNodeRef>Task_0e6hvnj</flowNodeRef>
        <flowNodeRef>Task_12j0pib</flowNodeRef>
      </lane>
      <lane id="Lane_2" name="Logistics">
        <flowNodeRef>Task_05ftug5</flowNodeRef>
      </lane>
      <lane id="Lane_3" name="Warehouse">
        <flowNodeRef>ExclusiveGateway_0</flowNodeRef>
        <flowNodeRef>Task_0sl26uo</flowNodeRef>
        <flowNodeRef>EndEvent_1</flowNodeRef>
      </lane>
    </laneSet>

    <startEvent id="StartEvent_1" name="Ship goods">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>

    <parallelGateway id="ParallelGateway_1">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
      <outgoing>SequenceFlow_3</outgoing>
    </parallelGateway>

    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="ParallelGateway_1"/>

    <task id="Task_05ftug5" name="Package goods">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_4</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_3" sourceRef="ParallelGateway_1" targetRef="Task_05ftug5"/>

    <exclusiveGateway id="ExclusiveGateway_0">
      <incoming>SequenceFlow_4</incoming>
      <incoming>SequenceFlow_14</incoming>
      <outgoing>SequenceFlow_15</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow_4" sourceRef="Task_05ftug5" targetRef="ExclusiveGateway_0"/>

    <task id="Task_0sl26uo" name="Prepare for&#10;picking up&#10;goods">
      <incoming>SequenceFlow_15</incoming>
      <outgoing>SequenceFlow_16</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_15" sourceRef="ExclusiveGateway_0" targetRef="Task_0sl26uo"/>

    <endEvent id="EndEvent_1" name="Shipment&#10;prepared">
      <incoming>SequenceFlow_16</incoming>
    </endEvent>

    <sequenceFlow id="SequenceFlow_16" sourceRef="Task_0sl26uo" targetRef="EndEvent_1"/>

    <inclusiveGateway id="InclusiveGateway_1">
      <outgoing>SequenceFlow_6</outgoing>
      <outgoing>SequenceFlow_7</outgoing>
    </inclusiveGateway>

    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_8</outgoing>
      <outgoing>SequenceFlow_9</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow_2" sourceRef="ParallelGateway_1" targetRef="Task_0vaxgaa"/>

    <task id="Task_0vaxgaa" name="Clarify shipment method">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_10</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_10" sourceRef="Task_0vaxgaa" targetRef="ExclusiveGateway_1"/>

    <sequenceFlow id="SequenceFlow_8" name="yes" sourceRef="ExclusiveGateway_1" targetRef="Task_0e6hvnj"/>

    <task id="Task_0e6hvnj" name="Get 3 offers&#10;from logistic&#10;companies">
      <incoming>SequenceFlow_8</incoming>
      <outgoing>SequenceFlow_11</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_11" sourceRef="Task_0e6hvnj" targetRef="Task_0s79ile"/>

    <task id="Task_0s79ile" name="Select logistic&#10;company and&#10;place order">
      <incoming>SequenceFlow_11</incoming>
      <outgoing>SequenceFlow_12</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_12" sourceRef="Task_0s79ile" targetRef="ExclusiveGateway_2"/>

    <exclusiveGateway id="ExclusiveGateway_2">
      <incoming>SequenceFlow_12</incoming>
      <outgoing>SequenceFlow_13</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow_13" sourceRef="ExclusiveGateway_2" targetRef="InclusiveGateway_1"/>

    <sequenceFlow id="SequenceFlow_6" sourceRef="InclusiveGateway_1" targetRef="Task_12j0pib"/>

    <task id="Task_12j0pib" name="Insure parcel">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_17</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_17" sourceRef="Task_12j0pib" targetRef="ExclusiveGateway_2"/>

    <sequenceFlow id="SequenceFlow_7" sourceRef="InclusiveGateway_1" targetRef="Task_0jsoxba"/>

    <task id="Task_0jsoxba" name="Write package&#10;label">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_18</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_18" sourceRef="Task_0jsoxba" targetRef="ParallelGateway_2"/>

    <parallelGateway id="ParallelGateway_2">
      <incoming>SequenceFlow_18</incoming>
      <outgoing>SequenceFlow_19</outgoing>
    </parallelGateway>

    <sequenceFlow id="SequenceFlow_9" sourceRef="ExclusiveGateway_1" targetRef="Task_05ftug5"/>
  </process>
</definitions>