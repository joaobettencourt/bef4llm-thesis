<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://bpmn.io/schema/bpmn">

  <process id="damage_claim_process" isExecutable="true">
    <laneSet>
      <lane id="customer_service_lane" name="Kundenservice">
        <flowNodeRef>start_event</flowNodeRef>
        <flowNodeRef>task_validate_damage_claim</flowNodeRef>
        <flowNodeRef>exclusive_gateway_invalid_claim</flowNodeRef>
        <flowNodeRef>sequence_flow_1</flowNodeRef>
      </lane>

      <lane id="insurance_management_lane" name="Versicherungsmanagement">
        <flowNodeRef>task_check_documents</flowNodeRef>
        <flowNodeRef>inclusive_gateway_further_checks</flowNodeRef>
        <flowNodeRef>sequence_flow_3</flowNodeRef>
        <flowNodeRef>task_notify_customer</flowNodeRef>
      </lane>

      <lane id="specialized_department_lane" name="Fachabteilung">
        <flowNodeRef>task_detailed_validation</flowNodeRef>
        <flowNodeRef>exclusive_gateway_legal_assessment</flowNodeRef>
        <flowNodeRef>sequence_flow_5</flowNodeRef>
      </lane>

      <lane id="statistics_lane" name="Statistik">
        <flowNodeRef>task_capture_in_statistics</flowNodeRef>
        <flowNodeRef>task_update_statistics</flowNodeRef>
      </lane>
    </laneSet>

    <startEvent id="start_event" name="Schadensmeldung eingereicht">
      <outgoing>sequence_flow_1</outgoing>
    </startEvent>

    <sequenceFlow id="sequence_flow_1" sourceRef="start_event" targetRef="task_validate_damage_claim"/>

    <task id="task_validate_damage_claim" name="Schadensmeldung auf Gültigkeit überprüfen">
      <incoming>sequence_flow_1</incoming>
      <outgoing>sequence_flow_2</outgoing>
    </task>

    <exclusiveGateway id="exclusive_gateway_invalid_claim">
      <incoming>sequence_flow_2</incoming>
      <outgoing>sequence_flow_3</outgoing>
      <outgoing>sequence_flow_4</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequence_flow_2" sourceRef="task_validate_damage_claim" targetRef="exclusive_gateway_invalid_claim"/>

    <sequenceFlow id="sequence_flow_3" name="gültig" sourceRef="exclusive_gateway_invalid_claim" targetRef="task_check_documents"/>

    <sequenceFlow id="sequence_flow_4" name="nicht gültig" sourceRef="exclusive_gateway_invalid_claim" targetRef="end_event_invalid_claim"/>

    <task id="task_check_documents" name="Unterlagen auf Vollständigkeit überprüfen">
      <incoming>sequence_flow_3</incoming>
      <outgoing>sequence_flow_5</outgoing>
    </task>

    <sequenceFlow id="sequence_flow_5" sourceRef="task_check_documents" targetRef="inclusive_gateway_further_checks"/>

    <inclusiveGateway id="inclusive_gateway_further_checks">
      <incoming>sequence_flow_5</incoming>
      <outgoing>sequence_flow_6</outgoing>
      <outgoing>sequence_flow_7</outgoing>
    </inclusiveGateway>

    <sequenceFlow id="sequence_flow_6" sourceRef="inclusive_gateway_further_checks" targetRef="task_detailed_validation"/>

    <sequenceFlow id="sequence_flow_7" sourceRef="inclusive_gateway_further_checks" targetRef="task_capture_in_statistics"/>

    <task id="task_detailed_validation" name="vertieften Validierungsprozess durchführen">
      <incoming>sequence_flow_6</incoming>
      <outgoing>sequence_flow_8</outgoing>
    </task>

    <exclusiveGateway id="exclusive_gateway_legal_assessment">
      <incoming>sequence_flow_8</incoming>
      <outgoing>sequence_flow_9</outgoing>
      <outgoing>sequence_flow_10</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequence_flow_8" sourceRef="task_detailed_validation" targetRef="exclusive_gateway_legal_assessment"/>

    <sequenceFlow id="sequence_flow_9" name="rechtl. Einschätzung erforderlich" sourceRef="exclusive_gateway_legal_assessment" targetRef="task_notify_customer"/>

    <sequenceFlow id="sequence_flow_10" name="keine rechtl. Einschätzung erforderlich" sourceRef="exclusive_gateway_legal_assessment" targetRef="task_update_statistics"/>

    <task id="task_capture_in_statistics" name="Schadensfall in der Statistik erfassen">
      <incoming>sequence_flow_7</incoming>
      <outgoing>sequence_flow_11</outgoing>
    </task>

    <sequenceFlow id="sequence_flow_11" sourceRef="task_capture_in_statistics" targetRef="parallel_gateway"/>

    <parallelGateway id="parallel_gateway">
      <incoming>sequence_flow_11</incoming>
      <outgoing>sequence_flow_12</outgoing>
      <outgoing>sequence_flow_13</outgoing>
    </parallelGateway>

    <sequenceFlow id="sequence_flow_12" sourceRef="parallel_gateway" targetRef="task_notify_customer"/>

    <sequenceFlow id="sequence_flow_13" sourceRef="parallel_gateway" targetRef="task_update_statistics"/>

    <task id="task_notify_customer" name="Kunden über Bearbeitungsstand informieren">
      <incoming>sequence_flow_9</incoming>
      <incoming>sequence_flow_12</incoming>
      <outgoing>sequence_flow_14</outgoing>
    </task>

    <sequenceFlow id="sequence_flow_14" sourceRef="task_notify_customer" targetRef="end_event"/>

    <task id="task_update_statistics" name="Schadensstatistik aktualisieren">
      <incoming>sequence_flow_10</incoming>
      <incoming>sequence_flow_13</incoming>
      <outgoing>sequence_flow_15</outgoing>
    </task>

    <sequenceFlow id="sequence_flow_15" sourceRef="task_update_statistics" targetRef="end_event"/>

    <endEvent id="end_event">
      <incoming>sequence_flow_14</incoming>
      <incoming>sequence_flow_15</incoming>
    </endEvent>

    <endEvent id="end_event_invalid_claim">
      <incoming>sequence_flow_4</incoming>
    </endEvent>
  </process>
</definitions>