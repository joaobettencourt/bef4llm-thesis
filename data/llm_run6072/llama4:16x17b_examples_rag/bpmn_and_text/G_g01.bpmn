<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definitions" name="LAN Party" targetNamespace="http://lanparty.com">

   <process id="lanPartyProcess" isExecutable="true">
     <startEvent id="startEvent1">
       <outgoing>sendInvitationsFlow</outgoing>
     </startEvent>

     <task id="sendInvitationsTask" name="Send Invitations">
       <incoming>sendInvitationsFlow</incoming>
       <outgoing>getGamesListFlow</outgoing>
     </task>

     <sequenceFlow id="sendInvitationsFlow" sourceRef="startEvent1" targetRef="sendInvitationsTask"/>

     <task id="getGamesListTask" name="Get Games List">
       <incoming>getGamesListFlow</incoming>
       <outgoing>appointDateFlow</outgoing>
     </task>

     <sequenceFlow id="getGamesListFlow" sourceRef="sendInvitationsTask" targetRef="getGamesListTask"/>

     <exclusiveGateway id="appointDateGW">
       <incoming>appointDateFlow</incoming>
       <outgoing>dateAppointedFlow</outgoing>
       <outgoing>anotherDateFlow</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="appointDateFlow" sourceRef="getGamesListTask" targetRef="appointDateGW"/>

     <userTask id="dateAppointedTask" name="Date Appointed">
       <incoming>dateAppointedFlow</incoming>
       <outgoing>getMissingGamesFlow</outgoing>
     </userTask>

     <sequenceFlow id="dateAppointedFlow" sourceRef="appointDateGW" targetRef="dateAppointedTask"/>

     <userTask id="anotherDateTask" name="Another Date">
       <incoming>anotherDateFlow</incoming>
       <outgoing>getGamesListFlow</outgoing>
     </userTask>

     <sequenceFlow id="anotherDateFlow" sourceRef="appointDateGW" targetRef="anotherDateTask"/>

     <task id="getMissingGamesTask" name="Get Missing Games">
       <incoming>getMissingGamesFlow</incoming>
       <outgoing>gamesAvailableFlow</outgoing>
     </task>

     <sequenceFlow id="getMissingGamesFlow" sourceRef="dateAppointedTask" targetRef="getMissingGamesTask"/>

     <exclusiveGateway id="gamesAvailableGW">
       <incoming>gamesAvailableFlow</incoming>
       <outgoing>gamesDownloadedFlow</outgoing>
       <outgoing>noGamesToDownloadFlow</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="gamesAvailableFlow" sourceRef="getMissingGamesTask" targetRef="gamesAvailableGW"/>

     <task id="downloadGamesTask" name="Download Games">
       <incoming>gamesDownloadedFlow</incoming>
       <outgoing>getBeerRequiredFlow</outgoing>
     </task>

     <sequenceFlow id="gamesDownloadedFlow" sourceRef="gamesAvailableGW" targetRef="downloadGamesTask"/>

     <userTask id="noGamesToDownloadTask" name="No Games To Download">
       <incoming>noGamesToDownloadFlow</incoming>
       <outgoing>getBeerRequiredFlow</outgoing>
     </userTask>

     <sequenceFlow id="noGamesToDownloadFlow" sourceRef="gamesAvailableGW" targetRef="noGamesToDownloadTask"/>

     <task id="getBeerRequiredTask" name="Get Beer Required">
       <incoming>getBeerRequiredFlow</incoming>
       <outgoing>beerAvailableFlow</outgoing>
     </task>

     <sequenceFlow id="getBeerRequiredFlow" sourceRef="downloadGamesTask" targetRef="getBeerRequiredTask"/>

     <exclusiveGateway id="beerAvailableGW">
       <incoming>beerAvailableFlow</incoming>
       <outgoing>beerBoughtFlow</outgoing>
       <outgoing>noBeerToBuyFlow</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="beerAvailableFlow" sourceRef="getBeerRequiredTask" targetRef="beerAvailableGW"/>

     <task id="buyBeerTask" name="Buy Beer">
       <incoming>beerBoughtFlow</incoming>
       <outgoing>enjoyLanPartyFlow</outgoing>
     </task>

     <sequenceFlow id="beerBoughtFlow" sourceRef="beerAvailableGW" targetRef="buyBeerTask"/>

     <userTask id="noBeerToBuyTask" name="No Beer To Buy">
       <incoming>noBeerToBuyFlow</incoming>
       <outgoing>enjoyLanPartyFlow</outgoing>
     </userTask>

     <sequenceFlow id="noBeerToBuyFlow" sourceRef="beerAvailableGW" targetRef="noBeerToBuyTask"/>

     <endEvent id="enjoyLanParty">
       <incoming>enjoyLanPartyFlow</incoming>
     </endEvent>

     <sequenceFlow id="enjoyLanPartyFlow" sourceRef="buyBeerTask" targetRef="enjoyLanParty"/>
   </process>

</definitions>