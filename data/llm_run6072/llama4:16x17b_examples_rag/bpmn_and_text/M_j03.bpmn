<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/BPMN20.xsd"
             id="definitions" name="Contract Process" targetNamespace="http://example.com/bpmn">

    <process id="contractProcess" isExecutable="true">
        <startEvent id="startEvent1">
            <outgoing>sequenceFlow1</outgoing>
        </startEvent>

        <serviceTask id="queryWebShopsTask">
            <incoming>sequenceFlow1</incoming>
            <outgoing>sequenceFlow2</outgoing>
        </serviceTask>

        <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="queryWebShopsTask"/>

        <exclusiveGateway id="checkPartsAvailabilityGateway">
            <incoming>sequenceFlow2</incoming>
            <outgoing>sequenceFlow3</outgoing>
            <outgoing>sequenceFlow4</outgoing>
        </exclusiveGateway>

        <sequenceFlow id="sequenceFlow2" sourceRef="queryWebShopsTask" targetRef="checkPartsAvailabilityGateway"/>

        <task id="orderPartsTask">
            <incoming>sequenceFlow3</incoming>
            <outgoing>sequenceFlow5</outgoing>
        </task>

        <sequenceFlow id="sequenceFlow3" sourceRef="checkPartsAvailabilityGateway" targetRef="orderPartsTask"/>

        <intermediateCatchEvent id="partsArriveEvent">
            <incoming>sequenceFlow5</incoming>
            <outgoing>sequenceFlow6</outgoing>
        </intermediateCatchEvent>

        <sequenceFlow id="sequenceFlow5" sourceRef="orderPartsTask" targetRef="partsArriveEvent"/>

        <task id="buildProductTask">
            <incoming>sequenceFlow6</incoming>
            <outgoing>sequenceFlow7</outgoing>
        </task>

        <sequenceFlow id="sequenceFlow6" sourceRef="partsArriveEvent" targetRef="buildProductTask"/>

        <exclusiveGateway id="checkStockLevelGateway">
            <incoming>sequenceFlow7</incoming>
            <outgoing>sequenceFlow8</outgoing>
            <outgoing>sequenceFlow9</outgoing>
            <outgoing>sequenceFlow10</outgoing>
        </exclusiveGateway>

        <sequenceFlow id="sequenceFlow7" sourceRef="buildProductTask" targetRef="checkStockLevelGateway"/>

        <task id="reorderPartsCheapestTask">
            <incoming>sequenceFlow8</incoming>
            <outgoing>sequenceFlow11</outgoing>
        </task>

        <sequenceFlow id="sequenceFlow8" sourceRef="checkStockLevelGateway" targetRef="reorderPartsCheapestTask"/>

        <task id="reorderPartsFastestTask">
            <incoming>sequenceFlow9</incoming>
            <outgoing>sequenceFlow12</outgoing>
        </task>

        <sequenceFlow id="sequenceFlow9" sourceRef="checkStockLevelGateway" targetRef="reorderPartsFastestTask"/>

        <task id="complainToFriendsTask">
            <incoming>sequenceFlow10</incoming>
        </task>

        <sequenceFlow id="sequenceFlow10" sourceRef="checkStockLevelGateway" targetRef="complainToFriendsTask"/>

        <endEvent id="processEndEvent">
            <incoming>sequenceFlow11</incoming>
            <incoming>sequenceFlow12</incoming>
        </endEvent>

        <sequenceFlow id="sequenceFlow11" sourceRef="reorderPartsCheapestTask" targetRef="processEndEvent"/>
        <sequenceFlow id="sequenceFlow12" sourceRef="reorderPartsFastestTask" targetRef="processEndEvent"/>

    </process>

</definitions>