<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/BPMN20.xsd"
             id="definitions" name="Building a House" targetNamespace="http://example.com/bpmn">

    <process id="buildingHouseProcess" isExecutable="true">
        <startEvent id="collectRequirements">
            <outgoing>sendToArchitect</outgoing>
        </startEvent>

        <task id="sendToArchitect" name="Send Requirements to Architect">
            <incoming>collectRequirements</incoming>
            <outgoing>refineDraftSequenceFlow</outgoing>
        </task>

        <sequenceFlow id="sendToArchitectSequenceFlow" sourceRef="collectRequirements" targetRef="sendToArchitect"/>

        <exclusiveGateway id="refineDraft">
            <incoming>refineDraftSequenceFlow</incoming>
            <outgoing>createMaterialListSequenceFlow</outgoing>
            <outgoing>orderMaterialsSequenceFlow</outgoing>
        </exclusiveGateway>

        <sequenceFlow id="refineDraftSequenceFlow" sourceRef="sendToArchitect" targetRef="refineDraft"/>

        <task id="createMaterialList" name="Create Material List">
            <incoming>createMaterialListSequenceFlow</incoming>
            <outgoing>orderMaterialsSequenceFlow</outgoing>
        </task>

        <sequenceFlow id="createMaterialListSequenceFlow" sourceRef="refineDraft" targetRef="createMaterialList"/>

        <parallelGateway id="orderMaterials">
            <incoming>orderMaterialsSequenceFlow</incoming>
            <outgoing>sendMessagesToFriendsSequenceFlow</outgoing>
            <outgoing>houseBuiltSequenceFlow</outgoing>
            <outgoing>createGuestListSequenceFlow</outgoing>
        </parallelGateway>

        <sequenceFlow id="orderMaterialsSequenceFlow" sourceRef="createMaterialList" targetRef="orderMaterials"/>

        <task id="sendMessagesToFriends" name="Send Messages to Friends">
            <incoming>sendMessagesToFriendsSequenceFlow</incoming>
        </task>

        <sequenceFlow id="sendMessagesToFriendsSequenceFlow" sourceRef="orderMaterials" targetRef="sendMessagesToFriends"/>

        <exclusiveGateway id="houseBuilt">
            <incoming>houseBuiltSequenceFlow</incoming>
            <outgoing>partyInvitationsSentSequenceFlow</outgoing>
            <outgoing>createGuestListSequenceFlow</outgoing>
        </exclusiveGateway>

        <sequenceFlow id="houseBuiltSequenceFlow" sourceRef="orderMaterials" targetRef="houseBuilt"/>

        <task id="createGuestList" name="Create Guest List">
            <incoming>createGuestListSequenceFlow</incoming>
            <outgoing>partyInvitationsSentSequenceFlow</outgoing>
        </task>

        <sequenceFlow id="createGuestListSequenceFlow" sourceRef="orderMaterials" targetRef="createGuestList"/>
        <sequenceFlow id="partyInvitationsSentSequenceFlow" sourceRef="houseBuilt" targetRef="endEvent"/>

        <endEvent id="endEvent">
            <incoming>partyInvitationsSentSequenceFlow</incoming>
        </endEvent>

    </process>
</definitions>