<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definitions" name="Blizzard Online Character Generator" targetNamespace="http://example.com">

   <process id="characterGeneratorProcess" isExecutable="true">
     <startEvent id="startCharacterCreation">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <exclusiveGateway id="hasBattleNetAccountGateway">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
       <outgoing>sequenceFlow3</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow1" sourceRef="startCharacterCreation" targetRef="hasBattleNetAccountGateway"/>

     <userTask id="createBattleNetAccount" name="Create Battle.net account">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow4</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow2" sourceRef="hasBattleNetAccountGateway" targetRef="createBattleNetAccount"/>

     <exclusiveGateway id="hasWoWSubscriptionGateway">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow5</outgoing>
       <outgoing>sequenceFlow6</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow4" sourceRef="createBattleNetAccount" targetRef="hasWoWSubscriptionGateway"/>

     <userTask id="selectPaymentMethod" name="Select payment method">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow7</outgoing>
       <outgoing>sequenceFlow8</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow5" sourceRef="hasWoWSubscriptionGateway" targetRef="selectPaymentMethod"/>

     <userTask id="enterCreditCardInfo" name="Enter credit card information">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow9</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow7" sourceRef="selectPaymentMethod" targetRef="enterCreditCardInfo"/>

     <userTask id="enterBankAccountInfo" name="Enter IBAN and BIC numbers">
       <incoming>sequenceFlow8</incoming>
       <outgoing>sequenceFlow10</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow8" sourceRef="selectPaymentMethod" targetRef="enterBankAccountInfo"/>

     <parallelGateway id="logInAndCreateCharacterGateway">
       <incoming>sequenceFlow9</incoming>
       <incoming>sequenceFlow10</incoming>
       <outgoing>sequenceFlow11</outgoing>
     </parallelGateway>

     <sequenceFlow id="sequenceFlow9" sourceRef="enterCreditCardInfo" targetRef="logInAndCreateCharacterGateway"/>
     <sequenceFlow id="sequenceFlow10" sourceRef="enterBankAccountInfo" targetRef="logInAndCreateCharacterGateway"/>

     <userTask id="selectRealmRaceClass" name="Select realm, race and class">
       <incoming>sequenceFlow11</incoming>
       <outgoing>sequenceFlow12</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow11" sourceRef="logInAndCreateCharacterGateway" targetRef="selectRealmRaceClass"/>

     <serviceTask id="checkNameAvailabilityService">
       <incoming>sequenceFlow14</incoming>
       <outgoing>sequenceFlow15</outgoing>
     </serviceTask>

     <userTask id="enterCharacterName" name="Enter character name">
       <incoming>sequenceFlow12</incoming>
       <outgoing>sequenceFlow14</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow12" sourceRef="selectRealmRaceClass" targetRef="enterCharacterName"/>
     <sequenceFlow id="sequenceFlow14" sourceRef="enterCharacterName" targetRef="checkNameAvailabilityService"/>

     <endEvent id="characterCreated">
       <incoming>sequenceFlow15</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow15" sourceRef="checkNameAvailabilityService" targetRef="characterCreated"/>
   </process>
</definitions>