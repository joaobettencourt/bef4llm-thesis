<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/BPMN20.xsd"
             id="definitions" name="Inspection of an Energy Drink Bottling Machine"
             targetNamespace="http://example.com/bpmn">

   <process id="inspectionProcess" isExecutable="true">
     <startEvent id="startEvent1">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <userTask id="enterMachineDetails1" name="Enter machine details">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="enterMachineDetails1"/>

     <exclusiveGateway id="checkConnection1">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
       <outgoing>sequenceFlow4</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow2" sourceRef="enterMachineDetails1" targetRef="checkConnection1"/>

     <serviceTask id="collectData1" name="Collect data from machine">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow5</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlow3" sourceRef="checkConnection1" targetRef="collectData1"/>

     <userTask id="askQuestions1" name="Ask questions and input values">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow6</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow5" sourceRef="collectData1" targetRef="askQuestions1"/>

     <exclusiveGateway id="evaluateResults1">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow7</outgoing>
       <outgoing>sequenceFlow8</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow6" sourceRef="askQuestions1" targetRef="evaluateResults1"/>

     <endEvent id="inspectionComplete1">
       <incoming>sequenceFlow7</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow7" sourceRef="evaluateResults1" targetRef="inspectionComplete1"/>

     <userTask id="additionalActions1" name="Perform additional actions">
       <incoming>sequenceFlow8</incoming>
       <outgoing>sequenceFlow9</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow8" sourceRef="evaluateResults1" targetRef="additionalActions1"/>

     <endEvent id="processEnd1">
       <incoming>sequenceFlow9</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow9" sourceRef="additionalActions1" targetRef="processEnd1"/>

     <sequenceFlow id="sequenceFlow4NotConnected" sourceRef="checkConnection1" targetRef="endEventNotConnected1">
       <conditionExpression xsi:type="tFormalExpression">${not connected}</conditionExpression>
     </sequenceFlow>

     <endEvent id="endEventNotConnected1">
       <incoming>sequenceFlow4NotConnected</incoming>
     </endEvent>
   </process>
 </definitions>