<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" 
             name="Schufa Scoring Prozess"
             targetNamespace="http://example.com/bpmn">

   <process id="schufaScoringProzess" isExecutable="true">
     <startEvent id="startEvent">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <serviceTask id="scoringAnfrage" name="Scoringanfrage an Schufa senden">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </serviceTask>

     <exclusiveGateway id="verzogerungGateway">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow4</outgoing>
       <outgoing>sequenceFlow5</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent" targetRef="scoringAnfrage"/>
     <sequenceFlow id="sequenceFlow2" sourceRef="scoringAnfrage" targetRef="verzogerungGateway"/>
     <sequenceFlow id="sequenceFlow3" name="Ergebnis liegt vor" sourceRef="verzogerungGateway" targetRef="exclusiveGateway2"/>

     <endEvent id="prozessBeendet">
       <incoming>sequenceFlow6</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow4" name="Ergebnis verzögert" sourceRef="verzogerungGateway" targetRef="hinweisAnVertriebsmitarbeiter"/>
     <sequenceFlow id="sequenceFlow5" name="Level 2 Scoringergebnis ermitteln" sourceRef="verzogerungGateway" targetRef="scoringLevel2"/>

     <serviceTask id="hinweisAnVertriebsmitarbeiter" name="Hinweis an Vertriebsmitarbeiter senden">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow7</outgoing>
     </serviceTask>

     <exclusiveGateway id="exclusiveGateway2">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow8</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow6" sourceRef="exclusiveGateway2" targetRef="prozessBeendet"/>

     <serviceTask id="scoringLevel2" name="Level 2 Scoringergebnis ermitteln">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow9</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlow7" sourceRef="hinweisAnVertriebsmitarbeiter" targetRef="endEvent2"/>

     <endEvent id="endEvent2">
       <incoming>sequenceFlow7</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow8" sourceRef="exclusiveGateway2" targetRef="scoringErgebnisAnBankLeiten"/>
     <sequenceFlow id="sequenceFlow9" sourceRef="scoringLevel2" targetRef="scoringErgebnisAnBankLeiten"/>

     <serviceTask id="scoringErgebnisAnBankLeiten" name="Scoringergebnis an Bank leiten">
       <incoming>sequenceFlow8</incoming>
       <incoming>sequenceFlow9</incoming>
       <outgoing>sequenceFlow10</outgoing>
     </serviceTask>

     <endEvent id="endEvent3">
       <incoming>sequenceFlow10</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow10" sourceRef="scoringErgebnisAnBankLeiten" targetRef="endEvent3"/>
   </process>
</definitions>