<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <collaboration id="Collaboration_0">
    <participant id="Participant_0" name="Dispatch of goods&#10;Computer Hardware Shop" processRef="Process_1"/>
  </collaboration>
  <process id="Process_1" isExecutable="false">
    <laneSet>
      <lane id="Lane_1" name="Secretary">
        <flowNodeRef>StartEvent_1</flowNodeRef>
        <flowNodeRef>Task_0</flowNodeRef>
        <flowNodeRef>InclusiveGateway_1</flowNodeRef>
        <flowNodeRef>ExclusiveGateway_1</flowNodeRef>
        <flowNodeRef>Task_3</flowNodeRef>
        <flowNodeRef>ExclusiveGateway_2</flowNodeRef>
      </lane>
      <lane id="Lane_2" name="Logistics Department Head">
        <flowNodeRef>Task_1</flowNodeRef>
      </lane>
      <lane id="Lane_3" name="Warehousemen">
        <flowNodeRef>Task_2</flowNodeRef>
      </lane>
    </laneSet>

    <startEvent id="StartEvent_1" name="Ship goods">
      <outgoing>SequenceFlow_0</outgoing>
    </startEvent>

    <sequenceFlow id="SequenceFlow_0" sourceRef="StartEvent_1" targetRef="Task_0"/>

    <userTask id="Task_0" name="Clarify who will do the shipping">
      <incoming>SequenceFlow_0</incoming>
      <outgoing>SequenceFlow_1</outgoing>
    </userTask>

    <sequenceFlow id="SequenceFlow_1" sourceRef="Task_0" targetRef="InclusiveGateway_1"/>

    <inclusiveGateway id="InclusiveGateway_1">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
      <outgoing>SequenceFlow_3</outgoing>
    </inclusiveGateway>

    <sequenceFlow id="SequenceFlow_2" name="small amount" sourceRef="InclusiveGateway_1" targetRef="Task_1"/>

    <userTask id="Task_1" name="Write package label and insure parcel if necessary">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_4</outgoing>
    </userTask>

    <sequenceFlow id="SequenceFlow_4" sourceRef="Task_1" targetRef="ExclusiveGateway_2"/>

    <sequenceFlow id="SequenceFlow_3" name="large amount" sourceRef="InclusiveGateway_1" targetRef="ExclusiveGateway_1"/>

    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_5</outgoing>
      <outgoing>SequenceFlow_6</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow_5" name="yes" sourceRef="ExclusiveGateway_1" targetRef="Task_3"/>

    <userTask id="Task_3" name="Invite three logistic companies to make offers and select one">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </userTask>

    <sequenceFlow id="SequenceFlow_7" sourceRef="Task_3" targetRef="ExclusiveGateway_2"/>

    <sequenceFlow id="SequenceFlow_6" name="no" sourceRef="ExclusiveGateway_1" targetRef="ExclusiveGateway_2"/>

    <exclusiveGateway id="ExclusiveGateway_2">
      <incoming>SequenceFlow_4</incoming>
      <incoming>SequenceFlow_7</incoming>
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow_8" sourceRef="ExclusiveGateway_2" targetRef="Task_2"/>

    <userTask id="Task_2" name="Package goods">
      <incoming>SequenceFlow_8</incoming>
      <outgoing>SequenceFlow_9</outgoing>
    </userTask>

    <sequenceFlow id="SequenceFlow_9" sourceRef="Task_2" targetRef="EndEvent_1"/>

    <endEvent id="EndEvent_1" name="Shipment prepared">
      <incoming>SequenceFlow_9</incoming>
    </endEvent>
  </process>
</definitions>