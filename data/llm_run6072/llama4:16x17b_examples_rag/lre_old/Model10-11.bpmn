<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" 
             targetNamespace="http://bpmn.io/schema/bpmn">
   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>
     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_GO_Request_Measurements"/>
     <task id="Task_GO_Request_Measurements" name="GO requests measurements of MSP">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_GO_Request_Measurements" targetRef="Task_MSP_Checks_Request"/>
     <task id="Task_MSP_Checks_Request" name="MSP checks received request">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_4</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_3" sourceRef="Task_MSP_Checks_Request" targetRef="Task_MSP_Denies_Request">
     </sequenceFlow>
     <task id="Task_MSP_Denies_Request" name="MSP denies request of GO">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_MSP_Denies_Request" targetRef="EndEvent_Failure"/>
     <sequenceFlow id="SequenceFlow_4" sourceRef="Task_MSP_Checks_Request" targetRef="Task_MSP_Performs_Measurement">
     </sequenceFlow>
     <task id="Task_MSP_Performs_Measurement" name="MSP performs measurement">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_MSP_Performs_Measurement" targetRef="ExclusiveGateway_Measurement_Result"/>
     <exclusiveGateway id="ExclusiveGateway_Measurement_Result">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_7</outgoing>
       <outgoing>SequenceFlow_8</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_7" sourceRef="ExclusiveGateway_Measurement_Result" targetRef="Task_MSP_Informs_About_Failure">
     </sequenceFlow>
     <task id="Task_MSP_Informs_About_Failure" name="MSP informs GO about failure of reading">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_MSP_Informs_About_Failure" targetRef="EndEvent_Failure"/>
     <sequenceFlow id="SequenceFlow_8" sourceRef="ExclusiveGateway_Measurement_Result" targetRef="Task_MSP_Transmits_Measured_Values">
     </sequenceFlow>
     <task id="Task_MSP_Transmits_Measured_Values" name="MSP transmits measured values to GO">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_10</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_10" sourceRef="Task_MSP_Transmits_Measured_Values" targetRef="Task_GO_Processes_Measured_Values"/>
     <task id="Task_GO_Processes_Measured_Values" name="GO processes measured values">
       <incoming>SequenceFlow_10</incoming>
       <outgoing>SequenceFlow_11</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_11" sourceRef="Task_GO_Processes_Measured_Values" targetRef="Task_GO_Sends_Changed_Values"/>
     <task id="Task_GO_Sends_Changed_Values" name="GO sends changed values to MSP">
       <incoming>SequenceFlow_11</incoming>
       <outgoing>SequenceFlow_12</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_12" sourceRef="Task_GO_Sends_Changed_Values" targetRef="Task_GO_Transmits_Readings_To_SP"/>
     <task id="Task_GO_Transmits_Readings_To_SP" name="GO transmits readings to SP">
       <incoming>SequenceFlow_12</incoming>
       <outgoing>SequenceFlow_13</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_13" sourceRef="Task_GO_Transmits_Readings_To_SP" targetRef="EndEvent_Successful"/>
     <endEvent id="EndEvent_Failure">
       <incoming>SequenceFlow_5</incoming>
       <incoming>SequenceFlow_9</incoming>
     </endEvent>
     <endEvent id="EndEvent_Successful">
       <incoming>SequenceFlow_13</incoming>
     </endEvent>
   </process>
</definitions>