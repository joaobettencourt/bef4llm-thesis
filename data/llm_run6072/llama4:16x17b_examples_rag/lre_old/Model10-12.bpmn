<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="BPMN Process Model" targetNamespace="http://bpmn.io/schema/bpmn">
   <collaboration id="Collaboration_1">
     <participant id="Participant_0" name="EC" processRef="Pool_0"/>
     <participant id="Participant_1" name="INQ" processRef="Pool_1"/>
     <participant id="Participant_2" name="IP" processRef="Pool_2"/>
     <messageFlow id="MessageFlow_0" sourceRef="IntermediateThrowEvent_0" targetRef="StartEvent_1"/>
     <messageFlow id="MessageFlow_1" sourceRef="Task_1" targetRef="StartEvent_2"/>
     <messageFlow id="MessageFlow_2" sourceRef="Task_3" targetRef="EndEvent_1"/>
   </collaboration>
   <process id="Pool_0" isExecutable="false">
     <startEvent id="StartEvent_0">
       <outgoing>SequenceFlow_0</outgoing>
     </startEvent>
     <sequenceFlow id="SequenceFlow_0" sourceRef="StartEvent_0" targetRef="Task_0"/>
     <task id="Task_0" name="Tell INQ about master data change">
       <incoming>SequenceFlow_0</incoming>
       <outgoing>SequenceFlow_1</outgoing>
     </task>
     <intermediateThrowEvent id="IntermediateThrowEvent_0">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>MessageFlow_0</outgoing>
     </intermediateThrowEvent>
   </process>
   <process id="Pool_1" isExecutable="false">
     <startEvent id="StartEvent_1">
       <incoming>MessageFlow_0</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </startEvent>
     <sequenceFlow id="SequenceFlow_2" sourceRef="StartEvent_1" targetRef="Task_1"/>
     <task id="Task_1" name="Notify IP of change">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_3" sourceRef="Task_1" targetRef="IntermediateThrowEvent_1"/>
     <intermediateThrowEvent id="IntermediateThrowEvent_1">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>MessageFlow_1</outgoing>
     </intermediateThrowEvent>
   </process>
   <process id="Pool_2" isExecutable="false">
     <startEvent id="StartEvent_2">
       <incoming>MessageFlow_1</incoming>
       <outgoing>SequenceFlow_4</outgoing>
     </startEvent>
     <sequenceFlow id="SequenceFlow_4" sourceRef="StartEvent_2" targetRef="Task_2"/>
     <task id="Task_2" name="Check master data change">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_5</outgoing>
       <outgoing>SequenceFlow_6</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_2" targetRef="ExclusiveGateway_0">
       <!-- content expression -->
     </sequenceFlow>
     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_2" targetRef="ExclusiveGateway_0">
       <!-- other condition -->
     </sequenceFlow>
     <exclusiveGateway id="ExclusiveGateway_0">
       <incoming>SequenceFlow_5</incoming>
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_7</outgoing>
       <outgoing>SequenceFlow_8</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_7" sourceRef="ExclusiveGateway_0" targetRef="Task_3">
       <!-- confirm -->
     </sequenceFlow>
     <task id="Task_3" name="Confirm change">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_8" sourceRef="ExclusiveGateway_0" targetRef="Task_4">
       <!-- reject -->
     </sequenceFlow>
     <task id="Task_4" name="Reject change">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_10</outgoing>
     </task>
     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_9</incoming>
     </endEvent>
     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_3" targetRef="IntermediateThrowEvent_2"/>
     <intermediateThrowEvent id="IntermediateThrowEvent_2">
       <incoming>SequenceFlow_9</incoming>
       <outgoing>MessageFlow_2</outgoing>
     </intermediateThrowEvent>
     <endEvent id="EndEvent_0">
       <incoming>SequenceFlow_10</incoming>
     </endEvent>
   </process>
</definitions>