<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="BPMN Process Model" targetNamespace="http://example.com/bpmn">
  <collaboration id="Collaboration_1">
    <participant id="Participant_0" name="MPON" processRef="Pool_0"/>
    <participant id="Participant_1" name="MPOO" processRef="Pool_1"/>
    <messageFlow id="MessageFlow_0" sourceRef="Task_0" targetRef="StartEvent_2"/>
  </collaboration>
  <process id="Pool_0" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_0"/>
    <task id="Task_0" name="Send dismissal to MPOO">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_0" targetRef="EndEvent_1"/>
    <endEvent id="EndEvent_1">
      <incoming>SequenceFlow_2</incoming>
    </endEvent>
  </process>
  <process id="Pool_1" isExecutable="true">
    <startEvent id="StartEvent_2">
      <incoming>MessageFlow_0</incoming>
      <outgoing>SequenceFlow_3</outgoing>
    </startEvent>
    <sequenceFlow id="SequenceFlow_3" sourceRef="StartEvent_2" targetRef="Task_1"/>
    <task id="Task_1" name="Review dismissal">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_4</outgoing>
      <outgoing>SequenceFlow_5</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_4" sourceRef="Task_1" targetRef="ExclusiveGateway_1">
      <conditionExpression xsi:type="tFormalExpression">${reviewResult == 'oppose'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="SequenceFlow_5" sourceRef="Task_1" targetRef="EndEvent_2">
      <conditionExpression xsi:type="tFormalExpression">${reviewResult == 'confirm'}</conditionExpression>
    </sequenceFlow>
    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_6" sourceRef="ExclusiveGateway_1" targetRef="Task_2"/>
    <task id="Task_2" name="Oppose dismissal">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_7" sourceRef="Task_2" targetRef="EndEvent_3"/>
    <endEvent id="EndEvent_2">
      <incoming>SequenceFlow_5</incoming>
    </endEvent>
    <endEvent id="EndEvent_3">
      <incoming>SequenceFlow_7</incoming>
    </endEvent>
  </process>
</definitions>