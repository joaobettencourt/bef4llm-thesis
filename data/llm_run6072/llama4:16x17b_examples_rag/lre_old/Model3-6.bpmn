<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="BPMN Process Model">
  <process id="Claims_Process" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>
    <task id="Task_1" name="Check if claimant is insured">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="ExclusiveGateway_1"/>
    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
      <outgoing>SequenceFlow_4</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_1" targetRef="Task_2">
      <conditionExpression xsi:type="tFormalExpression">${claimantInsured == true}</conditionExpression>
    </sequenceFlow>
    <task id="Task_2" name="Evaluate claim severity">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_5</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_5" sourceRef="Task_2" targetRef="Task_4"/>
    <task id="Task_4" name="Send relevant forms to claimant">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_7" sourceRef="Task_4" targetRef="Task_5"/>
    <task id="Task_5" name="Check forms for completeness">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_8</outgoing>
      <outgoing>SequenceFlow_9</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_8" sourceRef="Task_5" targetRef="Task_6">
      <conditionExpression xsi:type="tFormalExpression">${formsComplete == true}</conditionExpression>
    </sequenceFlow>
    <task id="Task_6" name="Register claim in Claims Management system">
      <incoming>SequenceFlow_8</incoming>
      <outgoing>SequenceFlow_10</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_10" sourceRef="Task_6" targetRef="EndEvent_2"/>
    <sequenceFlow id="SequenceFlow_9" sourceRef="Task_5" targetRef="Task_7">
      <conditionExpression xsi:type="tFormalExpression">${formsComplete == false}</conditionExpression>
    </sequenceFlow>
    <task id="Task_7" name="Inform claimant to update forms">
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_11</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_11" sourceRef="Task_7" targetRef="Task_4"/>
    <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_1">
      <conditionExpression xsi:type="tFormalExpression">${claimantInsured == false}</conditionExpression>
    </sequenceFlow>
    <endEvent id="EndEvent_1">
      <incoming>SequenceFlow_4</incoming>
    </endEvent>
    <endEvent id="EndEvent_2">
      <incoming>SequenceFlow_10</incoming>
    </endEvent>
  </process>
</definitions>