<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="BPMN Process Model" targetNamespace="http://bpmn.io/schema/bpmn">
   <collaboration id="Collaboration_1">
     <participant id="Participant_0" name="MPON" processRef="Pool_0"/>
     <participant id="Participant_1" name="MPOO" processRef="Pool_1"/>
     <messageFlow id="MessageFlow_0" sourceRef="Task_0" targetRef="StartEvent_1"/>
     <messageFlow id="MessageFlow_1" sourceRef="IntermediateCatchEvent_1" targetRef="Task_2"/>
   </collaboration>
   <process id="Pool_0" isExecutable="true">
     <laneSet>
       <lane id="Lane_0" name="">
         <flowNodeRef>StartNoneEvent_0</flowNodeRef>
         <flowNodeRef>Task_0</flowNodeRef>
         <flowNodeRef>IntermediateCatchEvent_0</flowNodeRef>
         <flowNodeRef>EndNoneEvent_0</flowNodeRef>
       </lane>
     </laneSet>
     <sequenceFlow id="SequenceFlow_1" sourceRef="StartNoneEvent_0" targetRef="Task_0"/>
     <startEvent id="StartNoneEvent_0">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>
     <task id="Task_0" name="Request device takeover bid">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_0" targetRef="IntermediateCatchEvent_0"/>
     <intermediateCatchEvent id="IntermediateCatchEvent_0">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
     </intermediateCatchEvent>
     <sequenceFlow id="SequenceFlow_3" sourceRef="IntermediateCatchEvent_0" targetRef="EndNoneEvent_0"/>
     <endEvent id="EndNoneEvent_1">
       <incoming>SequenceFlow_3</incoming>
     </endEvent>
   </process>
   <process id="Pool_1" isExecutable="true">
     <laneSet>
       <lane id="Lane_1" name="">
         <flowNodeRef>StartEvent_1</flowNodeRef>
         <flowNodeRef>Task_1</flowNodeRef>
         <flowNodeRef>IntermediateCatchEvent_1</flowNodeRef>
         <flowNodeRef>Task_2</flowNodeRef>
         <flowNodeRef>EndEvent_0</flowNodeRef>
       </lane>
     </laneSet>
     <startEvent id="StartEvent_1">
       <incoming>MessageFlow_0</incoming>
       <outgoing>SequenceFlow_4</outgoing>
     </startEvent>
     <sequenceFlow id="SequenceFlow_4" sourceRef="StartEvent_1" targetRef="Task_1"/>
     <task id="Task_1" name="Send tender for equipment takeover">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_1" targetRef="IntermediateCatchEvent_1"/>
     <intermediateCatchEvent id="IntermediateCatchEvent_1">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_7</outgoing>
     </intermediateCatchEvent>
     <sequenceFlow id="SequenceFlow_7" sourceRef="IntermediateCatchEvent_1" targetRef="Task_2"/>
     <task id="Task_2" name="Confirm order and send master data">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_2" targetRef="EndEvent_0"/>
     <endEvent id="EndEvent_0">
       <incoming>SequenceFlow_6</incoming>
     </endEvent>
   </process>
</definitions>