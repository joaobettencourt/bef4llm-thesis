<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="BPMN Process Model">
  <process id="Process_1" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>
    <task id="Task_1" name="Backup Database">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="ExclusiveGateway_1"/>
    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
      <outgoing>SequenceFlow_4</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_1" targetRef="Task_2">
      <conditionExpression xsi:type="tFormalExpression">${newRecords == false}</conditionExpression>
    </sequenceFlow>
    <task id="Task_2" name="Check CRM for New Returns">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_5</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_1" targetRef="Task_3">
      <conditionExpression xsi:type="tFormalExpression">${newRecords == true}</conditionExpression>
    </sequenceFlow>
    <task id="Task_3" name="Register Defaulting Accounts and Customers">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_5" sourceRef="Task_2" targetRef="ExclusiveGateway_2"/>
    <exclusiveGateway id="ExclusiveGateway_2">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_7</outgoing>
      <outgoing>SequenceFlow_8</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_6" sourceRef="Task_3" targetRef="Task_4"/>
    <task id="Task_4" name="Produce Defaulting Accounts Report">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_7" sourceRef="Task_4" targetRef="IntermediateCatchEvent_1"/>
    <intermediateCatchEvent id="IntermediateCatchEvent_1">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_9</outgoing>
    </intermediateCatchEvent>
    <sequenceFlow id="SequenceFlow_8" sourceRef="ExclusiveGateway_2" targetRef="Task_5"/>
    <task id="Task_5" name="Send Alert to Supervisor">
      <incoming>SequenceFlow_8</incoming>
    </task>
    <sequenceFlow id="SequenceFlow_9" sourceRef="IntermediateCatchEvent_1" targetRef="ExclusiveGateway_3"/>
    <exclusiveGateway id="ExclusiveGateway_3">
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_10</outgoing>
      <outgoing>SequenceFlow_11</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_10" sourceRef="ExclusiveGateway_3" targetRef="Task_6">
      <conditionExpression xsi:type="tFormalExpression">${currentTime <= 1430}</conditionExpression>
    </sequenceFlow>
    <task id="Task_6" name="Reconcile with Existing Account Defaulters Table">
      <incoming>SequenceFlow_10</incoming>
      <outgoing>SequenceFlow_12</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_11" sourceRef="ExclusiveGateway_3" targetRef="Task_7">
      <conditionExpression xsi:type="tFormalExpression">${currentTime > 1430}</conditionExpression>
    </sequenceFlow>
    <task id="Task_7" name="Send Message to Supervisor">
      <incoming>SequenceFlow_11</incoming>
    </task>
    <intermediateCatchEvent id="IntermediateCatchEvent_2">
      <incoming>SequenceFlow_12</incoming>
      <outgoing>SequenceFlow_13</outgoing>
    </intermediateCatchEvent>
    <sequenceFlow id="SequenceFlow_12" sourceRef="Task_6" targetRef="IntermediateCatchEvent_2"/>
    <task id="Task_8" name="Check CRM for New Returns">
      <incoming>SequenceFlow_13</incoming>
      <outgoing>SequenceFlow_14</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_13" sourceRef="IntermediateCatchEvent_2" targetRef="Task_8"/>
    <exclusiveGateway id="ExclusiveGateway_4">
      <incoming>SequenceFlow_14</incoming>
      <outgoing>SequenceFlow_15</outgoing>
      <outgoing>SequenceFlow_16</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_14" sourceRef="Task_8" targetRef="ExclusiveGateway_4"/>
    <endEvent id="EndEvent_1">
      <incoming>SequenceFlow_15</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_15" sourceRef="ExclusiveGateway_4" targetRef="EndEvent_1">
      <conditionExpression xsi:type="tFormalExpression">${currentTime <= 1600}</conditionExpression>
    </sequenceFlow>
    <task id="Task_9" name="Send Message to Supervisor">
      <incoming>SequenceFlow_16</incoming>
    </task>
    <sequenceFlow id="SequenceFlow_16" sourceRef="ExclusiveGateway_4" targetRef="Task_9"/>
    <endEvent id="EndEvent_2">
      <incoming>SequenceFlow_17</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_17" sourceRef="Task_9" targetRef="EndEvent_2"/>
  </process>
</definitions>