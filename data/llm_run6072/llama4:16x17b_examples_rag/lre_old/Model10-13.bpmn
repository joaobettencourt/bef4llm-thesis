<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="BPMN Process Model" targetNamespace="http://bpmn.io/schema/bpmn">
   <collaboration id="Collaboration_1">
     <participant id="Participant_0" name="INQ" processRef="Pool_0"/>
     <participant id="Participant_1" name="IP" processRef="Pool_1"/>
     <messageFlow id="MessageFlow_0" sourceRef="IntermediateEvent_TransmitRequest" targetRef="StartEvent_IP_CheckRequest"/>
   </collaboration>
   <process id="Pool_0" isExecutable="true">
     <laneSet>
       <lane id="Lane_INQ" name="INQ">
         <flowNodeRef>StartEvent_INQ</flowNodeRef>
         <flowNodeRef>Task_INQ_TransmitRequest</flowNodeRef>
         <flowNodeRef>EndEvent_DataTransmitted</flowNodeRef>
         <flowNodeRef>EndEvent_RequestRejected</flowNodeRef>
       </lane>
     </laneSet>
     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_INQ" targetRef="Task_INQ_TransmitRequest"/>
     <startEvent id="StartEvent_INQ">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>
     <task id="Task_INQ_TransmitRequest" name="Transmit transaction data request">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_INQ_TransmitRequest" targetRef="IntermediateEvent_TransmitRequest"/>
     <intermediateThrowEvent id="IntermediateEvent_TransmitRequest">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>MessageFlow_0</outgoing>
     </intermediateThrowEvent>
     <endEvent id="EndEvent_DataTransmitted">
       <incoming>SequenceFlow_4</incoming>
     </endEvent>
     <sequenceFlow id="SequenceFlow_4" sourceRef="Task_IP_TransmitData" targetRef="EndEvent_DataTransmitted"/>
     <endEvent id="EndEvent_RequestRejected">
       <incoming>SequenceFlow_5</incoming>
     </endEvent>
   </process>
   <process id="Pool_1" isExecutable="true">
     <laneSet>
       <lane id="Lane_IP" name="IP">
         <flowNodeRef>StartEvent_IP_CheckRequest</flowNodeRef>
         <flowNodeRef>Task_IP_CheckRequest</flowNodeRef>
         <flowNodeRef>ExclusiveGateway_Decision</flowNodeRef>
         <flowNodeRef>Task_IP_TransmitData</flowNodeRef>
         <flowNodeRef>Task_IP_RejectRequest</flowNodeRef>
       </lane>
     </laneSet>
     <startEvent id="StartEvent_IP_CheckRequest">
       <incoming>MessageFlow_0</incoming>
       <outgoing>SequenceFlow_3</outgoing>
     </startEvent>
     <sequenceFlow id="SequenceFlow_3" sourceRef="StartEvent_IP_CheckRequest" targetRef="Task_IP_CheckRequest"/>
     <task id="Task_IP_CheckRequest" name="Check request">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_IP_CheckRequest" targetRef="ExclusiveGateway_Decision"/>
     <exclusiveGateway id="ExclusiveGateway_Decision">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_7</outgoing>
       <outgoing>SequenceFlow_8</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_7" sourceRef="ExclusiveGateway_Decision" targetRef="Task_IP_TransmitData">
       <!-- Add condition expression if needed -->
     </sequenceFlow>
     <task id="Task_IP_TransmitData" name="Transmit data">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_4</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_8" sourceRef="ExclusiveGateway_Decision" targetRef="Task_IP_RejectRequest">
       <!-- Add condition expression if needed -->
     </sequenceFlow>
     <task id="Task_IP_RejectRequest" name="Reject request">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>
   </process>
</definitions>