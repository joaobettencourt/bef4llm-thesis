<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org//spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/ spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" 
             targetNamespace="http://bpmn.io/schema/bpmn">
   <process id="Process_1" isExecutable="true">
     <laneSet>
       <lane id="Lane_MailProcessingUnit" name="Mail Processing Unit">
         <flowNodeRef>StartEvent_1</flowNodeRef>
         <flowNodeRef>Task_CollectAndSortMail</flowNodeRef>
         <flowNodeRef>Task_DistributeMailToRegistry</flowNodeRef>
       </lane>
       <lane id="Lane_Registry" name="Registry">
         <flowNodeRef>Task_OpenAndSortMail</flowNodeRef>
         <flowNodeRef>InclusiveGateway_1</flowNodeRef>
         <flowNodeRef>Task_PerformQualityCheckAndCaptureMatterDetails</flowNodeRef>
         <flowNodeRef>Task_CompileListOfRequisitionAndSendBackToParty</flowNodeRef>
       </lane>
       <lane id="Lane_Cashier" name="Cashier">
         <flowNodeRef>Task_TakeApplicableFees</flowNodeRef>
       </lane>
     </laneSet>
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_Start_To_MailProcessingUnit</outgoing>
     </startEvent>
     <sequenceFlow id="SequenceFlow_Start_To_MailProcessingUnit" sourceRef="StartEvent_1" targetRef="Task_CollectAndSortMail"/>
     <task id="Task_CollectAndSortMail" name="Collect and sort mail">
       <incoming>SequenceFlow_Start_To_MailProcessingUnit</incoming>
       <outgoing>SequenceFlow_MailProcessingUnit_To_DistributeMail</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_MailProcessingUnit_To_DistributeMail" sourceRef="Task_CollectAndSortMail" targetRef="Task_DistributeMailToRegistry"/>
     <task id="Task_DistributeMailToRegistry" name="Distribute mail to Registry">
       <incoming>SequenceFlow_MailProcessingUnit_To_DistributeMail</incoming>
       <outgoing>SequenceFlow_DistributeMail_To_Registry</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_DistributeMail_To_Registry" sourceRef="Task_DistributeMailToRegistry" targetRef="Task_OpenAndSortMail"/>
     <task id="Task_OpenAndSortMail" name="Open and sort mail">
       <incoming>SequenceFlow_DistributeMail_To_Registry</incoming>
       <outgoing>SequenceFlow_Registry_To_InclusiveGateway</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_Registry_To_InclusiveGateway" sourceRef="Task_OpenAndSortMail" targetRef="InclusiveGateway_1"/>
     <inclusiveGateway id="InclusiveGateway_1">
       <incoming>SequenceFlow_Registry_To_InclusiveGateway</incoming>
       <outgoing>SequenceFlow_CompliantMail</outgoing>
       <outgoing>SequenceFlow_NonCompliantMail</outgoing>
     </inclusiveGateway>
     <sequenceFlow id="SequenceFlow_CompliantMail" sourceRef="InclusiveGateway_1" targetRef="Task_PerformQualityCheckAndCaptureMatterDetails">
     </sequenceFlow>
     <task id="Task_PerformQualityCheckAndCaptureMatterDetails" name="Perform quality check and capture matter details">
       <incoming>SequenceFlow_CompliantMail</incoming>
       <outgoing>SequenceFlow_QualityCheck_To_Cashier</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_QualityCheck_To_Cashier" sourceRef="Task_PerformQualityCheckAndCaptureMatterDetails" targetRef="Task_TakeApplicableFees"/>
     <task id="Task_TakeApplicableFees" name="Take applicable fees">
       <incoming>SequenceFlow_QualityCheck_To_Cashier</incoming>
       <outgoing>SequenceFlow_Cashier_To_EndEvent2</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_Cashier_To_EndEvent2" sourceRef="Task_TakeApplicableFees" targetRef="EndEvent_2"/>
     <endEvent id="EndEvent_2">
       <incoming>SequenceFlow_Cashier_To_EndEvent2</incoming>
     </endEvent>
     <sequenceFlow id="SequenceFlow_NonCompliantMail" sourceRef="InclusiveGateway_1" targetRef="Task_CompileListOfRequisitionAndSendBackToParty"/>
     <task id="Task_CompileListOfRequisitionAndSendBackToParty" name="Compile list of requisition and send back to party">
       <incoming>SequenceFlow_NonCompliantMail</incoming>
       <outgoing>SequenceFlow_Requisition_To_EndEvent1</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_Requisition_To_EndEvent1" sourceRef="Task_CompileListOfRequisitionAndSendBackToParty" targetRef="EndEvent_1"/>
     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_Requisition_To_EndEvent1</incoming>
     </endEvent>
   </process>
</definitions>