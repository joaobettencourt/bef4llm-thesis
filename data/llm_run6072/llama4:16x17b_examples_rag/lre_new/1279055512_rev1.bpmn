<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" name="Invoice Processing" targetNamespace="http://bpmn.io/schema/bpmn">
   <process id="invoiceProcessing" isExecutable="true">
     <laneSet>
       <lane id="mailCentreLane" name="Mail Centre office of SSP">
         <flowNodeRef>startEvent</flowNodeRef>
         <flowNodeRef>categorizeInvoiceTask</flowNodeRef>
         <flowNodeRef>forwardToAdministrationTask</flowNodeRef>
       </lane>

       <lane id="administrationLane" name="Administration Department">
         <flowNodeRef>processInvoiceTask</flowNodeRef>
         <flowNodeRef>invoicesInCollectionBoxEvent</flowNodeRef>
       </lane>

       <lane id="dataEntryLane" name="Data Entry office">
         <flowNodeRef>enterDataTask</flowNodeRef>
       </lane>

       <lane id="validationLane" name="Validation office">
         <flowNodeRef>validateInvoicesTask</flowNodeRef>
       </lane>

       <lane id="paymentLane" name="Payment office">
         <flowNodeRef>executePaymentTask</flowNodeRef>
       </lane>

       <lane id="registryLane" name="Registry office">
         <flowNodeRef>archiveInvoicesTask</flowNodeRef>
       </lane>
     </laneSet>

     <!-- Start Event --> 
     <startEvent id="startEvent1" name="Receive Invoice">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <!-- Categorize Invoice Task --> 
     <task id="categorizeInvoiceTask" name="Categorize Invoice by staff member">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </task>

     <!-- Forward to Administration Task --> 
     <task id="forwardToAdministrationTask" name="Forward invoice to Administration Department">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
     </task>

     <!-- Process Invoice SubProcess --> 
     <subProcess id="processInvoiceSubProcess" name="Process Invoice">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow4</outgoing>

       <startEvent id="processInvoiceStart1" name="Start Processing Invoice">
         <outgoing>sequenceFlow5</outgoing>
       </startEvent>

       <task id="processInvoiceTask" name="Process Invoice  (complex process)">
         <incoming>sequenceFlow5</incoming>
         <outgoing>sequenceFlow6</outgoing>
       </task>

       <endEvent id="invoicesInCollectionBoxEvent" name="Invoices in collection box">
         <incoming>sequenceFlow6</incoming>
       </endEvent>
     </subProcess>

     <!-- Data Entry Task --> 
     <startEvent id="dataEntryStart1" name="Data Entry Start">
       <outgoing>sequenceFlow7</outgoing>
       <timerEventDefinition/>
     </startEvent>

     <task id="enterDataTask" name="Enter data in SAP system  (complex process)">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow8</outgoing>
     </task>

     <!-- Validation Task --> 
     <startEvent id="validationStart1" name="Validation Start">
       <outgoing>sequenceFlow9</outgoing>
       <timerEventDefinition/>
     </startEvent>

     <subProcess id="validateInvoicesSubProcess" name="Validate Invoices">
       <incoming>sequenceFlow9</incoming>
       <outgoing>sequenceFlow10</outgoing>

       <startEvent id="validationStart2" name="Start Validation">
         <outgoing>sequenceFlow11</outgoing>
       </startEvent>

       <task id="validateInvoicesTask" name="Validate invoices  (big process)">
         <incoming>sequenceFlow11</incoming>
         <outgoing>sequenceFlow12</outgoing>
       </task>

       <endEvent id="validationEnd1" name="Validation Complete">
         <incoming>sequenceFlow12</incoming>
       </endEvent>
     </subProcess>

     <!-- Payment Task --> 
     <startEvent id="paymentStart1" name="Payment Start">
       <outgoing>sequenceFlow13</outgoing>
       <timerEventDefinition/>
     </startEvent>

     <task id="executePaymentTask" name="Execute payment of validated invoices  (big process)">
       <incoming>sequenceFlow13</incoming>
       <outgoing>sequenceFlow14</outgoing>
     </task>

     <!-- Archive Invoices Task --> 
     <task id="archiveInvoicesTask" name="Archive invoices">
       <incoming>sequenceFlow14</incoming>
     </task>

     <!-- Sequence Flows --> 
     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="categorizeInvoiceTask"/>
     <sequenceFlow id="sequenceFlow2" sourceRef="categorizeInvoiceTask" targetRef="forwardToAdministrationTask"/>
     <sequenceFlow id="sequenceFlow3" sourceRef="forwardToAdministrationTask" targetRef="processInvoiceSubProcess"/>
     <sequenceFlow id="sequenceFlow4" sourceRef="processInvoiceSubProcess" targetRef="dataEntryStart1"/>
     <sequenceFlow id="sequenceFlow5" sourceRef="processInvoiceStart1" targetRef="processInvoiceTask"/>
     <sequenceFlow id="sequenceFlow6" sourceRef="processInvoiceTask" targetRef="invoicesInCollectionBoxEvent"/>
     <sequenceFlow id="sequenceFlow7" sourceRef="dataEntryStart1" targetRef="enterDataTask"/>
     <sequenceFlow id="sequenceFlow8" sourceRef="enterDataTask" targetRef="validationStart1"/>
     <sequenceFlow id="sequenceFlow9" sourceRef="validationStart1" targetRef="validateInvoicesSubProcess"/>
     <sequenceFlow id="sequenceFlow10" sourceRef="validateInvoicesSubProcess" targetRef="paymentStart1"/>
     <sequenceFlow id="sequenceFlow11" sourceRef="validationStart2" targetRef="validateInvoicesTask"/>
     <sequenceFlow id="sequenceFlow12" sourceRef="validateInvoicesTask" targetRef="validationEnd1"/>
     <sequenceFlow id="sequenceFlow13" sourceRef="paymentStart1" targetRef="executePaymentTask"/>
     <sequenceFlow id="sequenceFlow14" sourceRef="executePaymentTask" targetRef="archiveInvoicesTask"/>

   </process>
</definitions>