<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com/bpmn">
  <process id="shipment_process" isExecutable="true">
    <laneSet>
      <lane id="logistics_lane" name="Logistics">
        <flowNodeRef>prepare_goods</flowNodeRef>
        <flowNodeRef>ship_goods</flowNodeRef>
      </lane>
      <lane id="accounting_lane" name="Accounting">
        <flowNodeRef>prepare_invoice</flowNodeRef>
        <flowNodeRef>send_invoice</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="receive_subsidiary_order" name="Receives subsidiary order">
      <outgoing>sequence_flow_1</outgoing>
    </startEvent>
    <parallelGateway id="parallel_gateway" name="Prepare and Ship in Parallel">
      <incoming>sequence_flow_1</incoming>
      <outgoing>sequence_flow_2</outgoing>
      <outgoing>sequence_flow_3</outgoing>
    </parallelGateway>
    <task id="prepare_goods" name="Prepare goods for shipment">
      <incoming>sequence_flow_2</incoming>
      <outgoing>sequence_flow_4</outgoing>
    </task>
    <task id="ship_goods" name="Ship goods">
      <incoming>sequence_flow_3</incoming>
    </task>
    <inclusiveGateway id="invoice_gateway" name="Is Customer Subsidiary?">
      <incoming>sequence_flow_4</incoming>
      <outgoing>sequence_flow_5</outgoing>
      <outgoing>sequence_flow_6</outgoing>
    </inclusiveGateway>
    <exclusiveGateway id="determine_address" name="Determine Invoicing Address">
      <incoming>sequence_flow_6</incoming>
      <outgoing>sequence_flow_7</outgoing>
      <outgoing>sequence_flow_8</outgoing>
    </exclusiveGateway>
    <task id="add_parent_company" name="Add parent company as invoicing address">
      <incoming>sequence_flow_7</incoming>
      <outgoing>sequence_flow_9</outgoing>
    </task>
    <task id="prepare_invoice" name="Prepare invoice">
      <incoming>sequence_flow_5</incoming>
      <incoming>sequence_flow_9</incoming>
      <outgoing>sequence_flow_10</outgoing>
    </task>
    <task id="send_invoice" name="Send invoice">
      <incoming>sequence_flow_10</incoming>
    </task>
    <endEvent id="shipment_prepared" name="Shipment prepared">
      <incoming>sequence_flow_3</incoming>
    </endEvent>
    <sequenceFlow id="sequence_flow_1" sourceRef="receive_subsidiary_order" targetRef="parallel_gateway"/>
    <sequenceFlow id="sequence_flow_2" sourceRef="parallel_gateway" targetRef="prepare_goods"/>
    <sequenceFlow id="sequence_flow_3" sourceRef="parallel_gateway" targetRef="shipment_prepared"/>
    <sequenceFlow id="sequence_flow_4" sourceRef="prepare_goods" targetRef="invoice_gateway"/>
    <sequenceFlow id="sequence_flow_5" sourceRef="invoice_gateway" targetRef="prepare_invoice"/>
    <sequenceFlow id="sequence_flow_6" sourceRef="invoice_gateway" targetRef="determine_address"/>
    <sequenceFlow id="sequence_flow_7" sourceRef="determine_address" targetRef="add_parent_company"/>
    <sequenceFlow id="sequence_flow_8" sourceRef="determine_address" targetRef="prepare_invoice"/>
    <sequenceFlow id="sequence_flow_9" sourceRef="add_parent_company" targetRef="prepare_invoice"/>
    <sequenceFlow id="sequence_flow_10" sourceRef="prepare_invoice" targetRef="send_invoice"/>
  </process>
</definitions>