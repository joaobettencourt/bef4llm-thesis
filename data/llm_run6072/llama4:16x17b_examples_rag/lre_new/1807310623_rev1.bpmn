<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">
   <process id="purchaseOrderProcess" isExecutable="true">
     <laneSet>
       <lane id="financialDepartmentLane" name="Financial Department">
         <flowNodeRef>startEvent</flowNodeRef>
         <flowNodeRef>checkInvoiceTask</flowNodeRef>
       </lane>
       <lane id="departmentLane" name="Department">
         <flowNodeRef>registerInvoiceTask</flowNodeRef>
         <flowNodeRef>inclusiveGateway</flowNodeRef>
       </lane>
       <lane id="departmentHeadLane" name="Department Head">
         <flowNodeRef>approveInvoiceTask</flowNodeRef>
       </lane>
     </laneSet>

     <startEvent id="startEvent" name="Purchase Invoice Received">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <task id="checkInvoiceTask" name="Check Purchase Invoice">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent" targetRef="checkInvoiceTask"/>
     <sequenceFlow id="sequenceFlow2" sourceRef="checkInvoiceTask" targetRef="inclusiveGateway"/>

     <exclusiveGateway id="exclusiveGateway1">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow4</outgoing>
       <outgoing>sequenceFlow5</outgoing>
     </exclusiveGateway>

     <task id="registerInvoiceTask" name="Register Invoice in SAPERION">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow3" sourceRef="registerInvoiceTask" targetRef="exclusiveGateway1"/>

     <inclusiveGateway id="inclusiveGateway">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow6</outgoing>
     </inclusiveGateway>

     <task id="approveInvoiceTask" name="Approve Invoice (Department Head)">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow7</outgoing>
     </task>

     <endEvent id="endEvent1">
       <incoming>sequenceFlow6</incoming>
     </endEvent>

     <endEvent id="endEvent2">
       <incoming>sequenceFlow7</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow4" sourceRef="exclusiveGateway1" targetRef="inclusiveGateway"/>
     <sequenceFlow id="sequenceFlow5" sourceRef="exclusiveGateway1" targetRef="approveInvoiceTask"/>
     <sequenceFlow id="sequenceFlow6" sourceRef="inclusiveGateway" targetRef="endEvent1"/>
     <sequenceFlow id="sequenceFlow7" sourceRef="approveInvoiceTask" targetRef="endEvent2"/>
   </process>
</definitions>