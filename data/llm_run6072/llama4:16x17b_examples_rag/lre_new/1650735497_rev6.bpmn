<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com/bpmn">

  <collaboration id="Collaboration_1">
    <participant id="Participant_1" name="PayPal Client and PayPal System" processRef="Process_1"/>
  </collaboration>

  <process id="Process_1" isExecutable="true">

    <laneSet>
      <lane id="Lane_1" name="PayPal Client">
        <flowNodeRef>StartEvent_1</flowNodeRef>
        <flowNodeRef>Task_EnterBankDetails</flowNodeRef>
        <flowNodeRef>ExclusiveGateway_VerifyAmounts</flowNodeRef>
        <flowNodeRef>EndEvent_BankAccountVerifiedOrRemoved</flowNodeRef>
      </lane>

      <lane id="Lane_2" name="PayPal System">
        <flowNodeRef>IntermediateThrowEvent_SubmitBankDetails</flowNodeRef>
        <flowNodeRef>Task_MakeTwoRandomDeposits</flowNodeRef>
        <flowNodeRef>IntermediateCatchEvent_NotifyClientToVerify</flowNodeRef>
      </lane>

    </laneSet>

    <startEvent id="StartEvent_1" name="Client wants to pay with bank account">
      <outgoing>SequenceFlow_Start_To_EnterBankDetails</outgoing>
    </startEvent>

    <task id="Task_EnterBankDetails" name="Enter bank details">
      <incoming>SequenceFlow_Start_To_EnterBankDetails</incoming>
      <outgoing>SequenceFlow_EnterBankDetails_To_SubmitBankDetails</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_Start_To_EnterBankDetails" sourceRef="StartEvent_1" targetRef="Task_EnterBankDetails"/>

    <sequenceFlow id="SequenceFlow_EnterBankDetails_To_SubmitBankDetails" sourceRef="Task_EnterBankDetails" targetRef="IntermediateThrowEvent_SubmitBankDetails"/>

    <intermediateThrowEvent id="IntermediateThrowEvent_SubmitBankDetails" name="Submit bank details to PayPal system">
      <incoming>SequenceFlow_EnterBankDetails_To_SubmitBankDetails</incoming>
      <outgoing>SequenceFlow_SubmitBankDetails_To_MakeTwoRandomDeposits</outgoing>
      <messageEventDefinition/>
    </intermediateThrowEvent>

    <sequenceFlow id="SequenceFlow_SubmitBankDetails_To_MakeTwoRandomDeposits" sourceRef="IntermediateThrowEvent_SubmitBankDetails" targetRef="Task_MakeTwoRandomDeposits"/>

    <task id="Task_MakeTwoRandomDeposits" name="Make two random deposits to bank account">
      <incoming>SequenceFlow_SubmitBankDetails_To_MakeTwoRandomDeposits</incoming>
      <outgoing>SequenceFlow_MakeTwoRandomDeposits_To_NotifyClientToVerify</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_MakeTwoRandomDeposits_To_NotifyClientToVerify" sourceRef="Task_MakeTwoRandomDeposits" targetRef="IntermediateCatchEvent_NotifyClientToVerify"/>

    <intermediateCatchEvent id="IntermediateCatchEvent_NotifyClientToVerify" name="Client notified to verify bank account">
      <incoming>SequenceFlow_MakeTwoRandomDeposits_To_NotifyClientToVerify</incoming>
      <outgoing>SequenceFlow_NotifyClientToVerify_To_EnterDepositAmounts</outgoing>
      <messageEventDefinition/>
    </intermediateCatchEvent>

    <sequenceFlow id="SequenceFlow_NotifyClientToVerify_To_EnterDepositAmounts" sourceRef="IntermediateCatchEvent_NotifyClientToVerify" targetRef="Task_EnterDepositAmounts"/>

    <task id="Task_EnterDepositAmounts" name="Enter deposit amounts">
      <incoming>SequenceFlow_NotifyClientToVerify_To_EnterDepositAmounts</incoming>
      <outgoing>SequenceFlow_EnterDepositAmounts_To_VerifyAmounts</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_EnterDepositAmounts_To_VerifyAmounts" sourceRef="Task_EnterDepositAmounts" targetRef="ExclusiveGateway_VerifyAmounts"/>

    <exclusiveGateway id="ExclusiveGateway_VerifyAmounts">
      <incoming>SequenceFlow_EnterDepositAmounts_To_VerifyAmounts</incoming>
      <outgoing>SequenceFlow_ValuesMatch</outgoing>
      <outgoing>SequenceFlow_ValuesDoNotMatch</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow_ValuesMatch" name="Values match" sourceRef="ExclusiveGateway_VerifyAmounts" targetRef="EndEvent_BankAccountVerified"/>

    <sequenceFlow id="SequenceFlow_ValuesDoNotMatch" name="Values do not match" sourceRef="ExclusiveGateway_VerifyAmounts" targetRef="Task_RemoveBankAccount"/>

    <task id="Task_RemoveBankAccount" name="Remove bank account">
      <incoming>SequenceFlow_ValuesDoNotMatch</incoming>
      <outgoing>SequenceFlow_RemoveBankAccount_To_EndEvent_BankAccountVerifiedOrRemoved</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_RemoveBankAccount_To_EndEvent_BankAccountVerifiedOrRemoved" sourceRef="Task_RemoveBankAccount" targetRef="EndEvent_BankAccountVerifiedOrRemoved"/>

    <endEvent id="EndEvent_BankAccountVerified" name="Bank account verified">
      <incoming>SequenceFlow_ValuesMatch</incoming>
    </endEvent>

    <endEvent id="EndEvent_BankAccountVerifiedOrRemoved" name="Bank account verified or removed">
      <incoming>SequenceFlow_RemoveBankAccount_To_EndEvent_BankAccountVerifiedOrRemoved</incoming>
    </endEvent>

  </process>

</definitions>