<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <collaboration id="Collaboration_0">
    <participant id="Participant_1" name="ACME Inc." processRef="Process_1"/>
  </collaboration>
  <process id="Process_1" isExecutable="false">
    <laneSet>
      <lane id="Lane_1" name="Department">
        <flowNodeRef>StartEvent_1</flowNodeRef>
        <flowNodeRef>Task_0</flowNodeRef>
        <flowNodeRef>ExclusiveGateway_1</flowNodeRef>
        <flowNodeRef>Task_1</flowNodeRef>
      </lane>
      <lane id="Lane_2" name="Central Procurement">
        <flowNodeRef>Task_2</flowNodeRef>
        <flowNodeRef>ExclusiveGateway_2</flowNodeRef>
        <flowNodeRef>Task_3</flowNodeRef>
      </lane>
      <lane id="Lane_3" name="Approver">
        <flowNodeRef>Task_4</flowNodeRef>
      </lane>
    </laneSet>

    <!-- Start Event -->
    <startEvent id="StartEvent_1" name="Purchase Request">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>

    <!-- Task: Check stock -->
    <task id="Task_0" name="Check Stock">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
      <outgoing>SequenceFlow_3</outgoing>
    </task>

    <!-- Exclusive Gateway: Stock -->
    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_4</outgoing>
      <outgoing>SequenceFlow_5</outgoing>
    </exclusiveGateway>

    <!-- Task: Create Purchase Requisition -->
    <task id="Task_1" name="Create Purchase Requisition">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </task>

    <!-- Task: Check Supplier -->
    <task id="Task_2" name="Check Supplier">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_7</outgoing>
      <outgoing>SequenceFlow_8</outgoing>
    </task>

    <!-- Exclusive Gateway: Supplier -->
    <exclusiveGateway id="ExclusiveGateway_2">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_9</outgoing>
      <outgoing>SequenceFlow_10</outgoing>
    </exclusiveGateway>

    <!-- Task: Create Order Template -->
    <task id="Task_3" name="Create Order Template">
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_11</outgoing>
    </task>

    <!-- Task: Approve Order -->
    <task id="Task_4" name="Approve Order">
      <incoming>SequenceFlow_11</incoming>
      <outgoing>SequenceFlow_12</outgoing>
    </task>

    <!-- End Event -->
    <endEvent id="EndEvent_1" name="Purchase Order Created">
      <incoming>SequenceFlow_4</incoming>
      <incoming>SequenceFlow_12</incoming>
    </endEvent>

    <!-- Sequence Flows -->
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_0"/>
    <sequenceFlow id="SequenceFlow_2" name="enough stock" sourceRef="Task_0" targetRef="ExclusiveGateway_1"/>
    <sequenceFlow id="SequenceFlow_3" name="not enough stock" sourceRef="Task_0" targetRef="ExclusiveGateway_1"/>
    <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_1"/>
    <sequenceFlow id="SequenceFlow_5" name="no" sourceRef="ExclusiveGateway_1" targetRef="Task_1"/>
    <sequenceFlow id="SequenceFlow_6" sourceRef="Task_1" targetRef="Task_2"/>
    <sequenceFlow id="SequenceFlow_7" sourceRef="Task_2" targetRef="ExclusiveGateway_2"/>
    <sequenceFlow id="SequenceFlow_8" name="new supplier" sourceRef="ExclusiveGateway_2" targetRef="Task_3"/>
    <sequenceFlow id="SequenceFlow_9" name="known supplier" sourceRef="ExclusiveGateway_2" targetRef="Task_3"/>
    <sequenceFlow id="SequenceFlow_10" sourceRef="Task_2" targetRef="EndEvent_1"/>
    <sequenceFlow id="SequenceFlow_11" sourceRef="Task_3" targetRef="Task_4"/>
    <sequenceFlow id="SequenceFlow_12" sourceRef="Task_4" targetRef="EndEvent_1"/>

  </process>
</definitions>