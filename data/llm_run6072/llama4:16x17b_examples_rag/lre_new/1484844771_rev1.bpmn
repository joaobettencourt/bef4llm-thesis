<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com/bpmn">

   <process id="invoiceProcess" isExecutable="true">
     <startEvent id="startEvent1">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="taskLocateVendor"/>

     <task id="taskLocateVendor" name="Try to locate Vendor in SAP system">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
       <outgoing>sequenceFlow3</outgoing>
     </task>

     <exclusiveGateway id="exclusiveGateway1">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow4</outgoing>
       <outgoing>sequenceFlow5</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow2" sourceRef="taskLocateVendor" targetRef="exclusiveGateway1"/>

     <subProcess id="subProcessNewVendorRecord">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow6</outgoing>
       <startEvent id="startSubProcess">
         <outgoing>sequenceFlow7</outgoing>
       </startEvent>

       <task id="taskNewVendorMasterRecord" name="Fill new Vendor Master Record form">
         <incoming>sequenceFlow7</incoming>
         <outgoing>sequenceFlow8</outgoing>
       </task>

       <sequenceFlow id="sequenceFlow7" sourceRef="startSubProcess" targetRef="taskNewVendorMasterRecord"/>

       <task id="taskAttachRequestToInvoice" name="Attach request to invoice">
         <incoming>sequenceFlow8</incoming>
         <outgoing>sequenceFlow9</outgoing>
       </task>

       <sequenceFlow id="sequenceFlow8" sourceRef="taskNewVendorMasterRecord" targetRef="taskAttachRequestToInvoice"/>

       <exclusiveGateway id="exclusiveGateway2">
         <incoming>sequenceFlow9</incoming>
         <outgoing>sequenceFlow10</outgoing>
         <outgoing>sequenceFlow11</outgoing>
       </exclusiveGateway>

       <sequenceFlow id="sequenceFlow9" sourceRef="taskAttachRequestToInvoice" targetRef="exclusiveGateway2"/>

       <task id="taskFinishRequestWithin24hrs" name="Finish request within 24 hrs">
         <incoming>sequenceFlow10</incoming>
       </task>

       <sequenceFlow id="sequenceFlow10" sourceRef="exclusiveGateway2" targetRef="taskFinishRequestWithin24hrs"/>

       <task id="taskFinishRequestWithin5Days" name="Finish request within 1-5 working days">
         <incoming>sequenceFlow11</incoming>
       </task>

       <sequenceFlow id="sequenceFlow11" sourceRef="exclusiveGateway2" targetRef="taskFinishRequestWithin5Days"/>

     </subProcess>

     <sequenceFlow id="sequenceFlow3" sourceRef="taskLocateVendor" targetRef="startSubProcess"/>
     <sequenceFlow id="sequenceFlow6" sourceRef="taskFinishRequestWithin24hrs" targetRef="exclusiveGateway1"/>
     <sequenceFlow id="sequenceFlow6-alt" sourceRef="taskFinishRequestWithin5Days" targetRef="exclusiveGateway1"/>

     <sequenceFlow id="sequenceFlow4" name="Vendor exists" sourceRef="exclusiveGateway1" targetRef="taskAddSapNumberToInvoice"/>

     <task id="taskAddSapNumberToInvoice" name="Add SAP number to invoice">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow12</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow12" sourceRef="taskAddSapNumberToInvoice" targetRef="taskSortInvoices"/>

     <task id="taskSortInvoices" name="Sort invoices by amount and vendor">
       <incoming>sequenceFlow12</incoming>
       <outgoing>sequenceFlow13</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow13" sourceRef="taskSortInvoices" targetRef="taskEnterIntoSapSystem"/>

     <task id="taskEnterIntoSapSystem" name="Enter invoices into SAP system">
       <incoming>sequenceFlow13</incoming>
       <outgoing>sequenceFlow14</outgoing>
     </task>

     <endEvent id="endEvent1">
       <incoming>sequenceFlow14</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow14" sourceRef="taskEnterIntoSapSystem" targetRef="endEvent1"/>

   </process>

</definitions>