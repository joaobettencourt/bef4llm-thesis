<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/06-02-01.xsd" 
             id="definition" name="Luxury Airplane Process" targetNamespace="http://example.com">

   <process id="luxuryAirplaneProcess" isExecutable="true">
     <startEvent id="orderReceived">
       <outgoing>defineRequirements</outgoing>
     </startEvent>

     <sequenceFlow id="defineRequirementsSequenceFlow" sourceRef="orderReceived" targetRef="defineRequirements"/>
     <userTask id="defineRequirements" name="Define requirements">
       <incoming>defineRequirementsSequenceFlow</incoming>
       <outgoing>baseModelGateway</outgoing>
     </userTask>

     <sequenceFlow id="baseModelGatewaySequenceFlow" sourceRef="defineRequirements" targetRef="baseModelGateway"/>
     <exclusiveGateway id="baseModelGateway">
       <incoming>baseModelGatewaySequenceFlow</incoming>
       <outgoing>orderBaseModel</outgoing>
       <outgoing>orderCustomizedModel</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="orderBaseModel" sourceRef="baseModelGateway" targetRef="assemblePlane">
       <conditionExpression xsi:type="tFormalExpression">${requirements.customizationLevel  ==  'low'}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="orderCustomizedModel" sourceRef="baseModelGateway" targetRef="designAndOrderParts">
       <conditionExpression xsi:type="tFormalExpression">${requirements.customizationLevel  !=  'low'}</conditionExpression>
     </sequenceFlow>

     <userTask id="designAndOrderParts" name="Design and order individual parts">
       <incoming>orderCustomizedModel</incoming>
       <outgoing>assemblePlane</outgoing>
     </userTask>

     <sequenceFlow id="assemblePlaneSequenceFlow" sourceRef="designAndOrderParts" targetRef="assemblePlane"/>
     <userTask id="assemblePlane" name="Assemble plane">
       <incoming>assemblePlaneSequenceFlow</incoming>
       <incoming>orderBaseModel</incoming>
       <outgoing>makeTestFlight</outgoing>
     </userTask>

     <sequenceFlow id="makeTestFlightSequenceFlow" sourceRef="assemblePlane" targetRef="makeTestFlight"/>
     <userTask id="makeTestFlight" name="Make test flight">
       <incoming>makeTestFlightSequenceFlow</incoming>
       <outgoing>createTestProtocol</outgoing>
     </userTask>

     <sequenceFlow id="createTestProtocolSequenceFlow" sourceRef="makeTestFlight" targetRef="createTestProtocol"/>
     <serviceTask id="createTestProtocol" name="Create test protocol">
       <incoming>createTestProtocolSequenceFlow</incoming>
       <outgoing>notifyCustomer</outgoing>
     </serviceTask>

     <sequenceFlow id="notifyCustomerSequenceFlow" sourceRef="createTestProtocol" targetRef="notifyCustomer"/>
     <serviceTask id="notifyCustomer" name="Notify customer">
       <incoming>notifyCustomerSequenceFlow</incoming>
       <outgoing>deliverPlane</outgoing>
     </serviceTask>

     <sequenceFlow id="deliverPlaneSequenceFlow" sourceRef="notifyCustomer" targetRef="deliverPlane"/>
     <userTask id="deliverPlane" name="Deliver plane">
       <incoming>deliverPlaneSequenceFlow</incoming>
       <outgoing>confirmDeliveryGateway</outgoing>
     </userTask>

     <sequenceFlow id="confirmDeliveryGatewaySequenceFlow" sourceRef="deliverPlane" targetRef="confirmDeliveryGateway"/>
     <exclusiveGateway id="confirmDeliveryGateway">
       <incoming>confirmDeliveryGatewaySequenceFlow</incoming>
       <outgoing>endProcess</outgoing>
       <outgoing>renegotiateContract</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="endProcess" sourceRef="confirmDeliveryGateway" targetRef="endEvent">
       <conditionExpression xsi:type="tFormalExpression">${confirmation  ==  'yes'}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="renegotiateContract" sourceRef="confirmDeliveryGateway" targetRef="renegotiateContractTask">
       <conditionExpression xsi:type="tFormalExpression">${confirmation  ==  'no'}</conditionExpression>
     </sequenceFlow>

     <userTask id="renegotiateContractTask" name="Renegotiate contract">
       <incoming>renegotiateContract</incoming>
       <outgoing>endEvent</outgoing>
     </userTask>

     <endEvent id="endEvent">
       <incoming>endProcess</incoming>
       <incoming>renegotiateContractTask</incoming>
     </endEvent>
   </process>
</definitions>