<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/06-02-01.xsd" 
             id="definition" name="BPMN Process Model">
   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>
     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>
     <task id="Task_1" name="Select starting block">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="ParallelGateway_1"/>
     <parallelGateway id="ParallelGateway_1">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_4</outgoing>
     </parallelGateway>
     <sequenceFlow id="SequenceFlow_3" sourceRef="ParallelGateway_1" targetRef="Task_2"/>
     <task id="Task_2" name="Run 5 km">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_4" sourceRef="ParallelGateway_1" targetRef="Task_3"/>
     <task id="Task_3" name="Start to measure time">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </task>
     <parallelGateway id="MergeGateway_1">
       <incoming>SequenceFlow_5</incoming>
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_7</outgoing>
     </parallelGateway>
     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_2" targetRef="MergeGateway_1"/>
     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_3" targetRef="MergeGateway_1"/>
     <sequenceFlow id="SequenceFlow_7" sourceRef="MergeGateway_1" targetRef="ExclusiveGateway_1"/>
     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_8</outgoing>
       <outgoing>SequenceFlow_9</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_8" sourceRef="ExclusiveGateway_1" targetRef="Task_4">
       <conditionExpression xsi:type="tFormalExpression">${runTime <= 25}</conditionExpression>
     </sequenceFlow>
     <task id="Task_4" name="Get starting number">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_10</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_9" sourceRef="ExclusiveGateway_1" targetRef="Task_5"/>
     <task id="Task_5" name="Do Training">
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_11</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_10" sourceRef="Task_4" targetRef="ExclusiveGateway_2"/>
     <sequenceFlow id="SequenceFlow_11" sourceRef="Task_5" targetRef="Task_1">
       <conditionExpression xsi:type="tFormalExpression">${trainingComplete == true}</conditionExpression>
     </sequenceFlow>
     <exclusiveGateway id="ExclusiveGateway_2">
       <incoming>SequenceFlow_10</incoming>
       <outgoing>SequenceFlow_12</outgoing>
       <outgoing>SequenceFlow_13</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_12" sourceRef="ExclusiveGateway_2" targetRef="Task_6">
       <conditionExpression xsi:type="tFormalExpression">${workdayEnd > startTime - 60}</conditionExpression>
     </sequenceFlow>
     <task id="Task_6" name="Go to the run from home">
       <incoming>SequenceFlow_12</incoming>
       <outgoing>SequenceFlow_14</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_13" sourceRef="ExclusiveGateway_2" targetRef="Task_7"/>
     <task id="Task_7" name="Go directly after work to the run">
       <incoming>SequenceFlow_13</incoming>
       <outgoing>SequenceFlow_15</outgoing>
     </task>
     <parallelGateway id="ParallelGateway_2">
       <incoming>SequenceFlow_14</incoming>
       <incoming>SequenceFlow_15</incoming>
       <outgoing>SequenceFlow_16</outgoing>
       <outgoing>SequenceFlow_17</outgoing>
     </parallelGateway>
     <sequenceFlow id="SequenceFlow_14" sourceRef="Task_6" targetRef="ParallelGateway_2"/>
     <sequenceFlow id="SequenceFlow_15" sourceRef="Task_7" targetRef="ParallelGateway_2"/>
     <task id="Task_8" name="Run the night run">
       <incoming>SequenceFlow_16</incoming>
       <outgoing>SequenceFlow_18</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_16" sourceRef="ParallelGateway_2" targetRef="Task_8"/>
     <task id="Task_9" name="Drink iso sport">
       <incoming>SequenceFlow_17</incoming>
       <outgoing>SequenceFlow_19</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_17" sourceRef="ParallelGateway_2" targetRef="Task_9"/>
     <parallelGateway id="MergeGateway_2">
       <incoming>SequenceFlow_18</incoming>
       <incoming>SequenceFlow_19</incoming>
       <outgoing>SequenceFlow_20</outgoing>
     </parallelGateway>
     <sequenceFlow id="SequenceFlow_18" sourceRef="Task_8" targetRef="MergeGateway_2"/>
     <sequenceFlow id="SequenceFlow_19" sourceRef="Task_9" targetRef="MergeGateway_2"/>
     <task id="Task_10" name="Receive final running time">
       <incoming>SequenceFlow_20</incoming>
       <outgoing>SequenceFlow_21</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_20" sourceRef="MergeGateway_2" targetRef="Task_10"/>
     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_21</incoming>
     </endEvent>
     <sequenceFlow id="SequenceFlow_21" sourceRef="Task_10" targetRef="EndEvent_1"/>
   </process>
</definitions>