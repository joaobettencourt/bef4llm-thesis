<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:di="http://www.w3.org/2000/01/rdf-schema#"
             xmlns:dc="http://purl.org/dc/terms/"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/06-02-01.xsd"
             id="definition" name="BPMN Process Model" targetNamespace="http://example.com/bpmn">
   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>
     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>
     <task id="Task_1" name="Receive order and properties">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="ParallelGateway_1"/>
     <parallelGateway id="ParallelGateway_1">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_4</outgoing>
     </parallelGateway>
     <sequenceFlow id="SequenceFlow_3" sourceRef="ParallelGateway_1" targetRef="Task_2"/>
     <serviceTask id="Task_2" name="Order guide bar">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </serviceTask>
     <sequenceFlow id="SequenceFlow_4" sourceRef="ParallelGateway_1" targetRef="Task_3"/>
     <serviceTask id="Task_3" name="Order chain">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </serviceTask>
     <parallelGateway id="ParallelGateway_2">
       <incoming>SequenceFlow_5</incoming>
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_7</outgoing>
     </parallelGateway>
     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_2" targetRef="ParallelGateway_2"/>
     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_3" targetRef="ParallelGateway_2"/>
     <sequenceFlow id="SequenceFlow_7" sourceRef="ParallelGateway_2" targetRef="Task_4"/>
     <manualTask id="Task_4" name="Inspect parts">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_8</outgoing>
     </manualTask>
     <sequenceFlow id="SequenceFlow_8" sourceRef="Task_4" targetRef="Task_5"/>
     <manualTask id="Task_5" name="Assemble parts">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </manualTask>
     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_5" targetRef="ExclusiveGateway_1"/>
     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_10</outgoing>
       <outgoing>SequenceFlow_11</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_10" sourceRef="ExclusiveGateway_1" targetRef="Task_6">
     </sequenceFlow>
     <task id="Task_6" name="Send chainsaw to customer">
       <incoming>SequenceFlow_10</incoming>
     </task>
     <sequenceFlow id="SequenceFlow_11" sourceRef="ExclusiveGateway_1" targetRef="Task_7"/>
     <task id="Task_7" name="Send update to customer and repeat process for additional chainsaws">
       <incoming>SequenceFlow_11</incoming>
     </task>
     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_12</incoming>
     </endEvent>
     <sequenceFlow id="SequenceFlow_12" sourceRef="Task_6" targetRef="EndEvent_1"/>
   </process>
 </definitions>