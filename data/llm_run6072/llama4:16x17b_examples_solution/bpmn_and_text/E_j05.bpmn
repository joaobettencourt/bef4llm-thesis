<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/06-02-01.xsd"
             id="definition" name="Work and Live in Austria" targetNamespace="http://example.com/bpmn">
   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>
     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_0ysoxba"/>
     <userTask id="Task_0ysoxba" name="Check requirements for working and living in Austria">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </userTask>
     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_0ysoxba" targetRef="ParallelGateway_1"/>
     <parallelGateway id="ParallelGateway_1">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_13</outgoing>
     </parallelGateway>
     <sequenceFlow id="SequenceFlow_3" sourceRef="ParallelGateway_1" targetRef="Task_0sl26uo"/>
     <userTask id="Task_0sl26uo" name="Organize accommodation and bank account">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_4</outgoing>
     </userTask>
     <sequenceFlow id="SequenceFlow_4" sourceRef="Task_0sl26uo" targetRef="ExclusiveGateway_1"/>
     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_5</outgoing>
       <outgoing>SequenceFlow_12</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_5" sourceRef="ExclusiveGateway_1" targetRef="Task_05ftug5">
       <conditionExpression xsi:type="tFormalExpression">${stayDuration   > 6}</conditionExpression>
     </sequenceFlow>
     <userTask id="Task_05ftug5" name="Apply for Rot-Weiss-Rot Card (Visa)">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </userTask>
     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_05ftug5" targetRef="EndEvent_1"/>
     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_6</incoming>
     </endEvent>
     <sequenceFlow id="SequenceFlow_12" name="Less than 6 month" sourceRef="ExclusiveGateway_1" targetRef="Task_0e6hvnj"/>
     <userTask id="Task_0e6hvnj" name="Apply for Schengen Visa">
       <incoming>SequenceFlow_12</incoming>
       <outgoing>SequenceFlow_14</outgoing>
     </userTask>
     <sequenceFlow id="SequenceFlow_14" sourceRef="Task_0e6hvnj" targetRef="EndEvent_1"/>
     <sequenceFlow id="SequenceFlow_13" sourceRef="ParallelGateway_1" targetRef="Task_12j0pib"/>
     <userTask id="Task_12j0pib" name="Prepare travel documents (passport photo, health insurance etc.)">
       <incoming>SequenceFlow_13</incoming>
       <outgoing>SequenceFlow_15</outgoing>
     </userTask>
     <sequenceFlow id="SequenceFlow_15" sourceRef="Task_12j0pib" targetRef="ExclusiveGateway_1"/>
   </process>
 </definitions>