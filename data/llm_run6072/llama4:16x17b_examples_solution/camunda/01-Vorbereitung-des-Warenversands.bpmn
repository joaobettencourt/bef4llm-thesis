<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com/bpmn">

  <process id="goodsDispatchProcess" isExecutable="true">
    <laneSet>
      <lane id="logisticsLeaderLane" name="Leiter Logistik">
        <flowNodeRef>insuranceTask</flowNodeRef>
      </lane>
      <lane id="secretariatLane" name="Sekretariat">
        <flowNodeRef>clarifyShipmentMethodTask</flowNodeRef>
        <flowNodeRef>getOffersTask</flowNodeRef>
        <flowNodeRef>selectLogisticCompanyTask</flowNodeRef>
        <flowNodeRef>startEvent</flowNodeRef>
        <flowNodeRef>exclusiveGatewaySpecialHandling</flowNodeRef>
        <flowNodeRef>inclusiveGatewayInsurance</flowNodeRef>
        <flowNodeRef>parallelGateway</flowNodeRef>
        <flowNodeRef>exclusiveGatewayPreparationComplete</flowNodeRef>
        <flowNodeRef>fillOutShipmentLabelTask</flowNodeRef>
      </lane>
      <lane id="warehouseWorkerLane" name="Lagerarbeiter">
        <flowNodeRef>packageGoodsTask</flowNodeRef>
        <flowNodeRef>prepareForPickingUpGoodsTask</flowNodeRef>
        <flowNodeRef>endEvent</flowNodeRef>
      </lane>
    </laneSet>

    <startEvent id="startEvent" name="Artikel zu versenden">
      <outgoing>sequenceFlow1</outgoing>
    </startEvent>

    <parallelGateway id="parallelGateway">
      <incoming>sequenceFlow1</incoming>
      <outgoing>sequenceFlow2</outgoing>
      <outgoing>sequenceFlow3</outgoing>
    </parallelGateway>

    <task id="clarifyShipmentMethodTask" name="Versandart klären">
      <incoming>sequenceFlow2</incoming>
      <outgoing>sequenceFlow4</outgoing>
    </task>

    <exclusiveGateway id="exclusiveGatewaySpecialHandling" name="Sonderversand?">
      <incoming>sequenceFlow4</incoming>
      <outgoing>sequenceFlow5</outgoing>
      <outgoing>sequenceFlow6</outgoing>
    </exclusiveGateway>

    <task id="getOffersTask" name="Angebote von 3 Spediteuren einholen">
      <incoming>sequenceFlow5</incoming>
      <outgoing>sequenceFlow7</outgoing>
    </task>

    <task id="selectLogisticCompanyTask" name="Spediteur beauftragen">
      <incoming>sequenceFlow7</incoming>
      <outgoing>sequenceFlow8</outgoing>
    </task>

    <exclusiveGateway id="exclusiveGatewayPreparationComplete">
      <incoming>sequenceFlow8</incoming>
      <incoming>sequenceFlow14</incoming>
      <outgoing>sequenceFlow9</outgoing>
    </exclusiveGateway>

    <inclusiveGateway id="inclusiveGatewayInsurance">
      <incoming>sequenceFlow10</incoming>
      <incoming>sequenceFlow11</incoming>
      <outgoing>sequenceFlow12</outgoing>
    </inclusiveGateway>

    <task id="fillOutShipmentLabelTask" name="Paketschein ausfüllen">
      <incoming>sequenceFlow13</incoming>
      <outgoing>sequenceFlow14</outgoing>
    </task>

    <task id="insuranceTask" name="Versicherung abschließen">
      <incoming>sequenceFlow10</incoming>
      <outgoing>sequenceFlow15</outgoing>
    </task>

    <task id="packageGoodsTask" name="Ware verpacken">
      <incoming>sequenceFlow3</incoming>
      <outgoing>sequenceFlow16</outgoing>
    </task>

    <exclusiveGateway id="exclusiveGatewayFinalizePreparation">
      <incoming>sequenceFlow9</incoming>
      <incoming>sequenceFlow16</incoming>
      <outgoing>sequenceFlow17</outgoing>
    </exclusiveGateway>

    <task id="prepareForPickingUpGoodsTask" name="Ware bereitstellen">
      <incoming>sequenceFlow17</incoming>
      <outgoing>sequenceFlow18</outgoing>
    </task>

    <endEvent id="endEvent" name="Warenversand vorbereitet">
      <incoming>sequenceFlow18</incoming>
    </endEvent>

    <!-- Sequence Flows -->
    <sequenceFlow id="sequenceFlow1" sourceRef="startEvent" targetRef="parallelGateway"/>
    <sequenceFlow id="sequenceFlow2" sourceRef="parallelGateway" targetRef="clarifyShipmentMethodTask"/>
    <sequenceFlow id="sequenceFlow3" sourceRef="parallelGateway" targetRef="packageGoodsTask"/>
    <sequenceFlow id="sequenceFlow4" sourceRef="clarifyShipmentMethodTask" targetRef="exclusiveGatewaySpecialHandling"/>
    <sequenceFlow id="sequenceFlow5" name="ja" sourceRef="exclusiveGatewaySpecialHandling" targetRef="getOffersTask"/>
    <sequenceFlow id="sequenceFlow6" name="nein" sourceRef="exclusiveGatewaySpecialHandling" targetRef="inclusiveGatewayInsurance"/>
    <sequenceFlow id="sequenceFlow7" sourceRef="getOffersTask" targetRef="selectLogisticCompanyTask"/>
    <sequenceFlow id="sequenceFlow8" sourceRef="selectLogisticCompanyTask" targetRef="exclusiveGatewayPreparationComplete"/>
    <sequenceFlow id="sequenceFlow9" sourceRef="exclusiveGatewayPreparationComplete" targetRef="exclusiveGatewayFinalizePreparation"/>
    <sequenceFlow id="sequenceFlow10" name="Versicherung erforderlich" sourceRef="inclusiveGatewayInsurance" targetRef="insuranceTask"/>
    <sequenceFlow id="sequenceFlow11" name="immer" sourceRef="inclusiveGatewayInsurance" targetRef="fillOutShipmentLabelTask"/>
    <sequenceFlow id="sequenceFlow12" sourceRef="inclusiveGatewayInsurance" targetRef="exclusiveGatewayPreparationComplete"/>
    <sequenceFlow id="sequenceFlow13" sourceRef="fillOutShipmentLabelTask" targetRef="inclusiveGatewayInsurance"/>
    <sequenceFlow id="sequenceFlow14" sourceRef="fillOutShipmentLabelTask" targetRef="exclusiveGatewayPreparationComplete"/>
    <sequenceFlow id="sequenceFlow15" sourceRef="insuranceTask" targetRef="inclusiveGatewayInsurance"/>
    <sequenceFlow id="sequenceFlow16" sourceRef="packageGoodsTask" targetRef="exclusiveGatewayFinalizePreparation"/>
    <sequenceFlow id="sequenceFlow17" sourceRef="exclusiveGatewayFinalizePreparation" targetRef="prepareForPickingUpGoodsTask"/>
    <sequenceFlow id="sequenceFlow18" sourceRef="prepareForPickingUpGoodsTask" targetRef="endEvent"/>

  </process>
</definitions>