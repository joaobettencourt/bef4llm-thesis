<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definitions" name="Credit Scoring Process"
             targetNamespace="http://example.com/bpmn">

   <process id="bankingProcess" isExecutable="true">
     <startEvent id="startEvent1">
       <outgoing>requestScoring</outgoing>
     </startEvent>

     <sequenceFlow id="requestScoring" sourceRef="startEvent1" targetRef="requestCreditScore"/>

     <serviceTask id="requestCreditScore" name="Request Credit Score">
       <incoming>requestScoring</incoming>
       <outgoing>scoringResultLevel1</outgoing>
       <outgoing>delayNotification</outgoing>
     </serviceTask>

     <sequenceFlow id="scoringResultLevel1" sourceRef="requestCreditScore" targetRef="exclusiveGateway1"/>

     <exclusiveGateway id="exclusiveGateway1">
       <incoming>scoringResultLevel1</incoming>
       <outgoing>immediateResult</outgoing>
       <outgoing>delayedResult</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="immediateResult" name="Immediate Result" sourceRef="exclusiveGateway1" targetRef="presentResult"/>

     <task id="presentResult" name="Present Result">
       <incoming>immediateResult</incoming>
       <outgoing>endEventSequence</outgoing>
     </task>

     <sequenceFlow id="endEventSequence" sourceRef="presentResult" targetRef="processEnd1"/>

     <sequenceFlow id="delayedResult" name="Delayed Result" sourceRef="exclusiveGateway1" targetRef="delayNotification1"/>

     <intermediateCatchEvent id="delayNotification1" name="Delay Notification">
       <incoming>delayedResult</incoming>
       <outgoing>reportDelaySequence</outgoing>
       <messageEventDefinition/>
     </intermediateCatchEvent>

     <sequenceFlow id="reportDelaySequence" sourceRef="delayNotification1" targetRef="reportDelayTask"/>

     <task id="reportDelayTask" name="Report Delay">
       <incoming>reportDelaySequence</incoming>
       <outgoing>checkAgainLaterSequence</outgoing>
     </task>

     <sequenceFlow id="checkAgainLaterSequence" sourceRef="reportDelayTask" targetRef="processEnd1"/>

     <endEvent id="processEnd1">
       <incoming>endEventSequence</incoming>
       <incoming>checkAgainLaterSequence</incoming>
     </endEvent>
   </process>

</definitions>