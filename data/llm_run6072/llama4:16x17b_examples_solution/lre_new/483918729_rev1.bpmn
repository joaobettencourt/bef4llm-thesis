<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" targetNamespace="http://www.example.com">

  <process id="provisionProcess" isExecutable="true">
    <startEvent id="startEvent">
      <outgoing>sequenceFlow1</outgoing>
      <messageEventDefinition/>
    </startEvent>

    <sequenceFlow id="sequenceFlow1" sourceRef="startEvent" targetRef="identifyPartsTask"/>

    <task id="identifyPartsTask" name="Identify parts">
      <incoming>sequenceFlow1</incoming>
      <outgoing>sequenceFlow2</outgoing>
    </task>

    <exclusiveGateway id="clarifyRequestGateway">
      <incoming>sequenceFlow2</incoming>
      <outgoing>sequenceFlow3</outgoing>
      <outgoing>sequenceFlow4</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequenceFlow2" sourceRef="identifyPartsTask" targetRef="clarifyRequestGateway"/>

    <task id="elicitInformationFromCustomerTask" name="Elicit information from customer">
      <incoming>sequenceFlow3</incoming>
      <outgoing>sequenceFlow5</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow3" sourceRef="clarifyRequestGateway" targetRef="elicitInformationFromCustomerTask">

      <conditionExpression xsi:type="tFormalExpression">request unclear</conditionExpression>
    </sequenceFlow>

    <task id="checkAvailabilityTask" name="Check availability">
      <incoming>sequenceFlow4</incoming>
      <incoming>sequenceFlow5</incoming>
      <outgoing>sequenceFlow6</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow4" sourceRef="clarifyRequestGateway" targetRef="checkAvailabilityTask">

      <conditionExpression xsi:type="tFormalExpression">request clear</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="sequenceFlow5" sourceRef="elicitInformationFromCustomerTask" targetRef="checkAvailabilityTask"/>

    <exclusiveGateway id="availabilityGateway">
      <incoming>sequenceFlow6</incoming>
      <outgoing>sequenceFlow7</outgoing>
      <outgoing>sequenceFlow8</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequenceFlow6" sourceRef="checkAvailabilityTask" targetRef="availabilityGateway"/>

    <task id="recordCustomerDetailTask" name="Record customer detail">
      <incoming>sequenceFlow7</incoming>
      <outgoing>sequenceFlow9</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow7" sourceRef="availabilityGateway" targetRef="recordCustomerDetailTask">

      <conditionExpression xsi:type="tFormalExpression">parts not available</conditionExpression>
    </sequenceFlow>

    <subProcess id="orderAndReceivePartFromDaisukiSubProcess" name="Order and receive part from Daisuki">
      <incoming>sequenceFlow9</incoming>
      <outgoing>sequenceFlow10</outgoing>
    </subProcess>

    <sequenceFlow id="sequenceFlow9" sourceRef="recordCustomerDetailTask" targetRef="orderAndReceivePartFromDaisukiSubProcess"/>

    <task id="contactCustomerTask" name="Contact customer">
      <incoming>sequenceFlow10</incoming>
      <outgoing>sequenceFlow11</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow10" sourceRef="orderAndReceivePartFromDaisukiSubProcess" targetRef="contactCustomerTask"/>

    <task id="supplyToCustomerTask" name="Supply to customer">
      <incoming>sequenceFlow8</incoming>
      <outgoing>sequenceFlow12</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow8" sourceRef="availabilityGateway" targetRef="supplyToCustomerTask">

      <conditionExpression xsi:type="tFormalExpression">parts available</conditionExpression>
    </sequenceFlow>

    <exclusiveGateway id="processCompletionGateway">
      <incoming>sequenceFlow11</incoming>
      <incoming>sequenceFlow12</incoming>
      <outgoing>sequenceFlow13</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequenceFlow11" sourceRef="contactCustomerTask" targetRef="processCompletionGateway"/>

    <sequenceFlow id="sequenceFlow12" sourceRef="supplyToCustomerTask" targetRef="processCompletionGateway"/>

    <task id="receivePaymentTask" name="Receive payment">
      <incoming>sequenceFlow13</incoming>
      <outgoing>sequenceFlow14</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow13" sourceRef="processCompletionGateway" targetRef="receivePaymentTask"/>

    <endEvent id="endEvent">
      <incoming>sequenceFlow14</incoming>
    </endEvent>

    <sequenceFlow id="sequenceFlow14" sourceRef="receivePaymentTask" targetRef="endEvent"/>
  </process>
</definitions>