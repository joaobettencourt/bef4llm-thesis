<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/pec/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/pec/20100524/06-02-01.xsd"
             id="definition" targetNamespace="http://www.example.com">

   <process id="purchaseProcess" isExecutable="true">
     <startEvent id="demandIdentified">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <exclusiveGateway id="checkStockAvailability">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
       <outgoing>sequenceFlow3</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow1" sourceRef="demandIdentified" targetRef="checkStockAvailability"/>

     <task id="consumeGoodsFromStock" name="Use goods from stock">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow4</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow2" sourceRef="checkStockAvailability" targetRef="consumeGoodsFromStock"> 
        <conditionExpression xsi:type="tFormalExpression">${goodsInStock}</conditionExpression>
    </sequenceFlow>

     <endEvent id="processCompleted">
       <incoming>sequenceFlow4</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow4" sourceRef="consumeGoodsFromStock" targetRef="processCompleted"/>

     <task id="specifyAndQuantifyDemand" name="Specify and quantify the demand">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow5</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow3" sourceRef="checkStockAvailability" targetRef="specifyAndQuantifyDemand"> 
        <conditionExpression xsi:type="tFormalExpression">${!goodsInStock}</conditionExpression>
    </sequenceFlow>

     <task id="createPurchaseRequisition">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow6</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow5" sourceRef="specifyAndQuantifyDemand" targetRef="createPurchaseRequisition"/>

     <task id="checkPurchaseRequisition">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow7</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow6" sourceRef="createPurchaseRequisition" targetRef="checkPurchaseRequisition"/>

     <exclusiveGateway id="supplierCheck">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow8</outgoing>
       <outgoing>sequenceFlow9</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow7" sourceRef="checkPurchaseRequisition" targetRef="supplierCheck"/>

     <task id="createSupplierInERP">
       <incoming>sequenceFlow8</incoming>
       <outgoing>sequenceFlow10</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow8" sourceRef="supplierCheck" targetRef="createSupplierInERP"> 
        <conditionExpression xsi:type="tFormalExpression">${newSupplier}</conditionExpression>
    </sequenceFlow>

     <task id="createOrderTemplate">
       <incoming>sequenceFlow9</incoming>
       <outgoing>sequenceFlow11</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow9" sourceRef="supplierCheck" targetRef="createOrderTemplate"> 
        <conditionExpression xsi:type="tFormalExpression">${!newSupplier}</conditionExpression>
    </sequenceFlow>

     <sequenceFlow id="sequenceFlow10" sourceRef="createSupplierInERP" targetRef="createOrderTemplate"/>

     <task id="approveAndTriggerOrder">
       <incoming>sequenceFlow11</incoming>
       <outgoing>sequenceFlow12</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow11" sourceRef="createOrderTemplate" targetRef="approveAndTriggerOrder"/>

     <endEvent id="purchaseOrderTriggered">
       <incoming>sequenceFlow12</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow12" sourceRef="approveAndTriggerOrder" targetRef="purchaseOrderTriggered"/>
   </process>
</definitions>