<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" targetNamespace="http://www.example.com">

   <process id="orderProcess" isExecutable="true">
     <startEvent id="startEvent">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <manualTask id="reviewOrderTask" name="Review Order">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </manualTask>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent" targetRef="reviewOrderTask"/>

     <exclusiveGateway id="checkAvailabilityGateway">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
       <outgoing>sequenceFlow4</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow2" sourceRef="reviewOrderTask" targetRef="checkAvailabilityGateway"/>

     <task id="informCustomerTask" name="Inform Customer about delay">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow5</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow4" sourceRef="checkAvailabilityGateway" targetRef="informCustomerTask">

       <conditionExpression xsi:type="tFormalExpression">productUnavailable</conditionExpression>
     </sequenceFlow>

     <task id="orderMissingProductsTask" name="Order missing products">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow6</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow3" sourceRef="checkAvailabilityGateway" targetRef="orderMissingProductsTask">

       <conditionExpression xsi:type="tFormalExpression">productAvailableButNotInStock</conditionExpression>
     </sequenceFlow>

     <intermediateThrowEvent id="waitForDeliveryTime">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow7</outgoing>
     </intermediateThrowEvent>

     <sequenceFlow id="sequenceFlow6" sourceRef="orderMissingProductsTask" targetRef="waitForDeliveryTime"/>

     <exclusiveGateway id="checkAvailabilityAgainGateway">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow8</outgoing>
       <outgoing>sequenceFlow9</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow7" sourceRef="waitForDeliveryTime" targetRef="checkAvailabilityAgainGateway"/>

     <task id="recollectProductsTask" name="Recollect products">
       <incoming>sequenceFlow8</incoming>
       <outgoing>sequenceFlow10</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow8" sourceRef="checkAvailabilityAgainGateway" targetRef="recollectProductsTask">

       <conditionExpression xsi:type="tFormalExpression">productsAvailable</conditionExpression>
     </sequenceFlow>

     <task id="informCourierTask" name="Inform courier">
       <incoming>sequenceFlow10</incoming>
       <outgoing>sequenceFlow11</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow10" sourceRef="recollectProductsTask" targetRef="informCourierTask"/>

     <serviceTask id="ensureEnoughHumanResourcesTask" name="Ensure enough human resources">
       <incoming>sequenceFlow11</incoming>
       <outgoing>sequenceFlow12</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlow11" sourceRef="informCourierTask" targetRef="ensureEnoughHumanResourcesTask"/>

     <exclusiveGateway id="enoughFreeDriversGateway">
       <incoming>sequenceFlow12</incoming>
       <outgoing>sequenceFlow13</outgoing>
       <outgoing>sequenceFlow14</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow12" sourceRef="ensureEnoughHumanResourcesTask" targetRef="enoughFreeDriversGateway"/>

     <task id="pickupPackagesTask" name="Pickup packages">
       <incoming>sequenceFlow13</incoming>
       <outgoing>sequenceFlow15</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow13" sourceRef="enoughFreeDriversGateway" targetRef="pickupPackagesTask">

       <conditionExpression xsi:type="tFormalExpression">enoughFreeDrivers</conditionExpression>
     </sequenceFlow>

     <userTask id="updateInfoTask" name="Update info">
       <incoming>sequenceFlow15</incoming>
       <outgoing>sequenceFlow16</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow15" sourceRef="pickupPackagesTask" targetRef="updateInfoTask"/>

     <endEvent id="endEvent1">
       <incoming>sequenceFlow16</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow16" sourceRef="updateInfoTask" targetRef="endEvent1"/>

   </process>

</definitions>