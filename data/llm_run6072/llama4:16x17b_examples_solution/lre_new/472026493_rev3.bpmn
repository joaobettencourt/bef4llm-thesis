<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" targetNamespace="http://www.example.com">

   <process id="buyingNewHardwareProcess" isExecutable="true">
     <startEvent id="receiveRequestStartEvent">
       <outgoing>analyzeRequestSequenceFlow</outgoing>
       <messageEventDefinition/>
     </startEvent>

     <sequenceFlow id="analyzeRequestSequenceFlow" sourceRef="receiveRequestStartEvent" targetRef="analyzeRequestTask"/>

     <task id="analyzeRequestTask" name="Analyze Request">
       <incoming>analyzeRequestSequenceFlow</incoming>
       <outgoing>approveOrDenySequenceFlow</outgoing>
     </task>

     <sequenceFlow id="approveOrDenySequenceFlow" sourceRef="analyzeRequestTask" targetRef="approvalGateway"/>

     <exclusiveGateway id="approvalGateway">
       <incoming>approveOrDenySequenceFlow</incoming>
       <outgoing>approvedSequenceFlow</outgoing>
       <outgoing>deniedSequenceFlow</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="approvedSequenceFlow" name="Approved" sourceRef="approvalGateway" targetRef="editRequestTask">
       <conditionExpression xsi:type="tFormalExpression">approved</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="deniedSequenceFlow" name="Denied" sourceRef="approvalGateway" targetRef="informEmployeeEndEvent">
       <conditionExpression xsi:type="tFormalExpression">denied</conditionExpression>
     </sequenceFlow>

     <task id="editRequestTask" name="Edit and Complete Request">
       <incoming>approvedSequenceFlow</incoming>
       <outgoing>sendSupplierSequenceFlow</outgoing>
     </task>

     <sequenceFlow id="sendSupplierSequenceFlow" sourceRef="editRequestTask" targetRef="askSupplierIntermediateThrowEvent"/>

     <intermediateThrowEvent id="askSupplierIntermediateThrowEvent" name="Ask Supplier About Prices">
       <incoming>sendSupplierSequenceFlow</incoming>
       <outgoing>receiveOfferSequenceFlow</outgoing>
       <messageEventDefinition/>
     </intermediateThrowEvent>

     <sequenceFlow id="receiveOfferSequenceFlow" sourceRef="askSupplierIntermediateThrowEvent" targetRef="fillFormTask"/>

     <task id="fillFormTask" name="Fill Form and Send to Management">
       <incoming>receiveOfferSequenceFlow</incoming>
       <outgoing>managementAnalysisSequenceFlow</outgoing>
     </task>

     <sequenceFlow id="managementAnalysisSequenceFlow" sourceRef="fillFormTask" targetRef="managementApprovalGateway"/>

     <exclusiveGateway id="managementApprovalGateway">
       <incoming>managementAnalysisSequenceFlow</incoming>
       <outgoing>approvedByManagementSequenceFlow</outgoing>
       <outgoing>notApprovedByManagementSequenceFlow</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="approvedByManagementSequenceFlow" name="Approved By Management" sourceRef="managementApprovalGateway" targetRef="financeDepartmentParallelGateway">
       <conditionExpression xsi:type="tFormalExpression">approved</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="notApprovedByManagementSequenceFlow" name="Not Approved By Management" sourceRef="managementApprovalGateway" targetRef="reworkOrDenyExclusiveGateway">
       <conditionExpression xsi:type="tFormalExpression">not approved</conditionExpression>
     </sequenceFlow>

     <parallelGateway id="financeDepartmentParallelGateway">
       <incoming>approvedByManagementSequenceFlow</incoming>
       <outgoing>prepareOrderSequenceFlow</outgoing>
       <outgoing>findResourcesSequenceFlow</outgoing>
     </parallelGateway>

     <task id="prepareOrderTask" name="Prepare Order">
       <incoming>prepareOrderSequenceFlow</incoming>
       <outgoing>sendOrderSequenceFlow</outgoing>
     </task>

     <sequenceFlow id="prepareOrderSequenceFlow" sourceRef="financeDepartmentParallelGateway" targetRef="prepareOrderTask"/>

     <task id="findResourcesTask" name="Find Finance Resources">
       <incoming>findResourcesSequenceFlow</incoming>
       <outgoing>resourcesFoundSequenceFlow</outgoing>
     </task>

     <sequenceFlow id="findResourcesSequenceFlow" sourceRef="financeDepartmentParallelGateway" targetRef="findResourcesTask"/>

     <sequenceFlow id="resourcesFoundSequenceFlow" sourceRef="findResourcesTask" targetRef="orderAcceptedIntermediateCatchEvent"/>

     <intermediateCatchEvent id="orderAcceptedIntermediateCatchEvent">
       <incoming>resourcesFoundSequenceFlow</incoming>
       <outgoing>receiveHardwareSequenceFlow</outgoing>
       <messageEventDefinition/>
     </intermediateCatchEvent>

     <sequenceFlow id="receiveHardwareSequenceFlow" sourceRef="orderAcceptedIntermediateCatchEvent" targetRef="receiveHardwareTask"/>

     <task id="receiveHardwareTask" name="Receive Hardware and Invoice">
       <incoming>receiveHardwareSequenceFlow</incoming>
       <outgoing>payInvoiceSequenceFlow</outgoing>
     </task>

     <sequenceFlow id="payInvoiceSequenceFlow" sourceRef="receiveHardwareTask" targetRef="payInvoiceEndEvent"/>

     <endEvent id="payInvoiceEndEvent">
       <incoming>payInvoiceSequenceFlow</incoming>
     </endEvent>

     <exclusiveGateway id="reworkOrDenyExclusiveGateway">
       <incoming>notApprovedByManagementSequenceFlow</incoming>
       <outgoing>reworkSequenceFlow</outgoing>
       <outgoing>denyRequestSequenceFlow</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="reworkSequenceFlow" name="Rework" sourceRef="reworkOrDenyExclusiveGateway" targetRef="editRequestTask">
       <conditionExpression xsi:type="tFormalExpression">rework</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="denyRequestSequenceFlow" name="Deny Request" sourceRef="reworkOrDenyExclusiveGateway" targetRef="informEmployeeEndEvent">
       <conditionExpression xsi:type="tFormalExpression">deny</conditionExpression>
     </sequenceFlow>

     <endEvent id="informEmployeeEndEvent" name="Inform About Denial">
       <incoming>deniedSequenceFlow</incoming>
       <incoming>denyRequestSequenceFlow</incoming>
       <messageEventDefinition/>
     </endEvent>

   </process>

</definitions>