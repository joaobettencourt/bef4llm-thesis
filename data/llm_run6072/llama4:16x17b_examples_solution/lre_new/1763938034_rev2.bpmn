<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definition" targetNamespace="http://www.example.com">

   <process id="rewardAndTrainingProcess" isExecutable="true">
     <startEvent id="startEvent">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <task id="checkPerformanceTask" name="Check Employee Performance">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent" targetRef="checkPerformanceTask"/>

     <exclusiveGateway id="performanceGateway">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
       <outgoing>sequenceFlow4</outgoing>
       <outgoing>sequenceFlow5</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow2" sourceRef="checkPerformanceTask" targetRef="performanceGateway"/>

     <task id="suggestDismissalTask" name="Suggest Employee Dismissal">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow6</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow3" name="performance &lt; 20%" sourceRef="performanceGateway" targetRef="suggestDismissalTask"/>

     <task id="dismissEmployeeTask" name="Dismiss Employee">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow7</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow6" sourceRef="suggestDismissalTask" targetRef="dismissEmployeeTask"/>

     <endEvent id="dismissEndEvent">
       <incoming>sequenceFlow7</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow7" sourceRef="dismissEmployeeTask" targetRef="dismissEndEvent"/>

     <task id="suggestTrainingTask" name="Suggest Training">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow8</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow4" name="20% &lt; performance &lt; 50%" sourceRef="performanceGateway" targetRef="suggestTrainingTask"/>

     <task id="provideTrainingTask" name="Provide Training">
       <incoming>sequenceFlow8</incoming>
       <outgoing>sequenceFlow9</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow8" sourceRef="suggestTrainingTask" targetRef="provideTrainingTask"/>

     <endEvent id="trainingEndEvent">
       <incoming>sequenceFlow9</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow9" sourceRef="provideTrainingTask" targetRef="trainingEndEvent"/>

     <task id="suggestRewardTask" name="Suggest for Reward">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow10</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow5" name="performance &gt; 75%" sourceRef="performanceGateway" targetRef="suggestRewardTask"/>

     <exclusiveGateway id="rewardTypeGateway">
       <incoming>sequenceFlow10</incoming>
       <outgoing>sequenceFlow11</outgoing>
       <outgoing>sequenceFlow12</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow10" sourceRef="suggestRewardTask" targetRef="rewardTypeGateway"/>

     <task id="chooseBenefitTask" name="Choose Appropriate Benefit">
       <incoming>sequenceFlow11</incoming>
       <outgoing>sequenceFlow13</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow11" name="other benefit" sourceRef="rewardTypeGateway" targetRef="chooseBenefitTask"/>

     <task id="calculateRewardTask" name="Calculate Reward">
       <incoming>sequenceFlow12</incoming>
       <outgoing>sequenceFlow14</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow12" name="financial reward" sourceRef="rewardTypeGateway" targetRef="calculateRewardTask"/>

     <task id="payRewardTask" name="Pay Reward">
       <incoming>sequenceFlow14</incoming>
       <outgoing>sequenceFlow15</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow14" sourceRef="calculateRewardTask" targetRef="payRewardTask"/>

     <task id="announceEmployeeTask" name="Announce Employee of the Month">
       <incoming>sequenceFlow15</incoming>
       <outgoing>sequenceFlow16</outgoing>
     </task>

     <endEvent id="rewardEndEvent">
       <incoming>sequenceFlow16</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow15" sourceRef="payRewardTask" targetRef="announceEmployeeTask"/>
     <sequenceFlow id="sequenceFlow16" sourceRef="announceEmployeeTask" targetRef="rewardEndEvent"/>

   </process>

</definitions>