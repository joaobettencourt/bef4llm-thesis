<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" targetNamespace="http://www.example.com">

   <process id="paymentProcess" isExecutable="true">
     <startEvent id="weeklyPaymentReport">
       <outgoing>generatePaymentReport</outgoing>
       <timerEventDefinition/>
     </startEvent>

     <task id="generatePaymentReport" name="Generate a Payment report">
       <incoming>generatePaymentReport</incoming>
       <outgoing>payVendor</outgoing>
     </task>

     <sequenceFlow id="flow1" sourceRef="weeklyPaymentReport" targetRef="generatePaymentReport"/>

     <task id="payVendor" name="Pay the vendor">
       <incoming>payVendor</incoming>
       <outgoing>sendPaymentReportToAccountsReceivable</outgoing>
       <outgoing>sendPaymentReportToRegistry</outgoing>
       <outgoing>autoSendPaymentReportToClients</outgoing>
     </task>

     <sequenceFlow id="flow2" sourceRef="generatePaymentReport" targetRef="payVendor"/>

     <task id="sendPaymentReportToAccountsReceivable" name="Send the payment report to Accounts Receivable Department">
       <incoming>sendPaymentReportToAccountsReceivable</incoming>
       <outgoing>generateMonthlyInvoice</outgoing>
     </task>

     <sequenceFlow id="flow3" sourceRef="payVendor" targetRef="sendPaymentReportToAccountsReceivable"/>

     <task id="generateMonthlyInvoice" name="Generate monthly invoice for clients">
       <incoming>generateMonthlyInvoice</incoming>
       <outgoing>chargeClient</outgoing>
     </task>

     <sequenceFlow id="flow4" sourceRef="sendPaymentReportToAccountsReceivable" targetRef="generateMonthlyInvoice"/>

     <task id="chargeClient" name="Charge the client  $35 per invoice">
       <incoming>chargeClient</incoming>
       <outgoing>endChargingClient</outgoing>
     </task>

     <sequenceFlow id="flow5" sourceRef="generateMonthlyInvoice" targetRef="chargeClient"/>

     <endEvent id="endChargingClient">
       <incoming>endChargingClient</incoming>
     </endEvent>

     <sequenceFlow id="flow6" sourceRef="chargeClient" targetRef="endChargingClient"/>

     <task id="sendPaymentReportToRegistry" name="Send payment report to registry">
       <incoming>sendPaymentReportToRegistry</incoming>
       <outgoing>selectPaperBasedInvoices</outgoing>
     </task>

     <sequenceFlow id="flow7" sourceRef="payVendor" targetRef="sendPaymentReportToRegistry"/>

     <task id="selectPaperBasedInvoices" name="Selects the paper-based invoices that have been paid">
       <incoming>selectPaperBasedInvoices</incoming>
       <outgoing>archiveInvoicesPerVendor</outgoing>
       <outgoing>trackDownPayment</outgoing>
     </task>

     <sequenceFlow id="flow8" sourceRef="sendPaymentReportToRegistry" targetRef="selectPaperBasedInvoices"/>

     <task id="archiveInvoicesPerVendor" name="Archive the invoices per vendor">
       <incoming>archiveInvoicesPerVendor</incoming>
       <outgoing>endArchiving</outgoing>
     </task>

     <sequenceFlow id="flow9" sourceRef="selectPaperBasedInvoices" targetRef="archiveInvoicesPerVendor"/>

     <endEvent id="endArchiving">
       <incoming>endArchiving</incoming>
     </endEvent>

     <task id="trackDownPayment" name="Track down payment">
       <incoming>trackDownPayment</incoming>
       <outgoing>endTrackingPayment</outgoing>
     </task>

     <sequenceFlow id="flow10" sourceRef="selectPaperBasedInvoices" targetRef="trackDownPayment"/>

     <endEvent id="endTrackingPayment">
       <incoming>endTrackingPayment</incoming>
     </endEvent>

     <task id="autoSendPaymentReportToClients">
       <outgoing>sendAutomaticEmail</outgoing>
     </task>

     <sequenceFlow id="flow11" sourceRef="payVendor" targetRef="autoSendPaymentReportToClients"/>

   </process>

   <dataObject id="DataObject_0kl0zvs" name="payment invoice"/>
  
  </definitions>