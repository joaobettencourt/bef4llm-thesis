<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" targetNamespace="http://www.example.com">

  <process id="expenseReportProcess" isExecutable="true">
    <startEvent id="startEvent">
      <outgoing>sequenceFlow1</outgoing>
    </startEvent>

    <task id="receiveExpenseReportTask" name="Receive Expense Report">
      <incoming>sequenceFlow1</incoming>
      <outgoing>sequenceFlow2</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow1" sourceRef="startEvent" targetRef="receiveExpenseReportTask"/>

    <exclusiveGateway id="checkAccountExistsGateway">
      <incoming>sequenceFlow2</incoming>
      <outgoing>sequenceFlow3</outgoing>
      <outgoing>sequenceFlow4</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequenceFlow2" sourceRef="receiveExpenseReportTask" targetRef="checkAccountExistsGateway"/>

    <intermediateCatchEvent id="accountCheckTimeoutEvent" name="28 days">
      <incoming>sequenceFlow4</incoming>
      <outgoing>sequenceFlow5</outgoing>
      <timerEventDefinition/>
    </intermediateCatchEvent>

    <sequenceFlow id="sequenceFlow4" sourceRef="checkAccountExistsGateway" targetRef="accountCheckTimeoutEvent"/>

    <endEvent id="processStoppedEndEvent" name="Process stopped and send the employee a 'resubmit report' email">
      <incoming>sequenceFlow5</incoming>
      <messageEventDefinition/>
    </endEvent>

    <sequenceFlow id="sequenceFlow5" sourceRef="accountCheckTimeoutEvent" targetRef="processStoppedEndEvent"/>

    <exclusiveGateway id="hasAccountGateway">
      <incoming>sequenceFlow3</incoming>
      <outgoing>sequenceFlow6</outgoing>
      <outgoing>sequenceFlow7</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequenceFlow3" sourceRef="checkAccountExistsGateway" targetRef="hasAccountGateway"/>

    <task id="reviewExpenseReportTask" name="Review Expense Report">
      <incoming>sequenceFlow6</incoming>
      <incoming>sequenceFlow8</incoming>
      <outgoing>sequenceFlow9</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow6" sourceRef="hasAccountGateway" targetRef="reviewExpenseReportTask"/>

    <task id="createNewAccountTask" name="Create New Account">
      <incoming>sequenceFlow7</incoming>
      <outgoing>sequenceFlow8</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow7" sourceRef="hasAccountGateway" targetRef="createNewAccountTask"/>

    <sequenceFlow id="sequenceFlow8" sourceRef="createNewAccountTask" targetRef="reviewExpenseReportTask"/>

    <sequenceFlow id="sequenceFlow9" sourceRef="reviewExpenseReportTask" targetRef="checkAmountExceeds200Gateway"/>

    <exclusiveGateway id="checkAmountExceeds200Gateway">
      <incoming>sequenceFlow9</incoming>
      <outgoing>sequenceFlow10</outgoing>
      <outgoing>sequenceFlow11</outgoing>
    </exclusiveGateway>

    <task id="askSupervisorForApprovalTask" name="Ask Supervisor for Approval">
      <incoming>sequenceFlow11</incoming>
      <outgoing>sequenceFlow12</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow10" sourceRef="checkAmountExceeds200Gateway" targetRef="endEventDirectDeposit"/>

    <sequenceFlow id="sequenceFlow11" name="Amount >= 200" sourceRef="checkAmountExceeds200Gateway" targetRef="askSupervisorForApprovalTask"/>

    <complexGateway id="supervisorResponseGateway">
      <incoming>sequenceFlow12</incoming>
      <outgoing>sequenceFlow13</outgoing>
      <outgoing>sequenceFlow14</outgoing>
      <outgoing>sequenceFlow15</outgoing>
    </complexGateway>

    <intermediateCatchEvent id="approvalInProgressEvent" name="7 days">
      <incoming>sequenceFlow12</incoming>
      <outgoing>sequenceFlow16</outgoing>
      <timerEventDefinition/>
    </intermediateCatchEvent>

    <task id="sendApprovalInProgressEmailTask" name="Send the employee a 'approval in progress' email">
      <incoming>sequenceFlow16</incoming>
      <outgoing>sequenceFlow17</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow12" sourceRef="askSupervisorForApprovalTask" targetRef="supervisorResponseGateway"/>

    <sequenceFlow id="sequenceFlow13" sourceRef="supervisorResponseGateway" targetRef="endEventDirectDeposit">

      <conditionExpression xsi:type="tFormalExpression">approved</conditionExpression>
    </sequenceFlow>

    <intermediateCatchEvent id="approvalAcceptedEvent" name="Supervisor Approves">
      <incoming>sequenceFlow13</incoming>
      <outgoing>sequenceFlow18</outgoing>
      <messageEventDefinition/>
    </intermediateCatchEvent>

    <task id="directDepositTask" name="Deposit Reimbursement to Employee's Direct Deposit Bank Account">
      <incoming>sequenceFlow18</incoming>
      <outgoing>sequenceFlow19</outgoing>
    </task>

    <endEvent id="endEventDirectDeposit">
      <incoming>sequenceFlow10</incoming>
      <incoming>sequenceFlow19</incoming>
    </endEvent>

    <sequenceFlow id="sequenceFlow14" sourceRef="supervisorResponseGateway" targetRef="sendRejectionEmailTask">

      <conditionExpression xsi:type="tFormalExpression">rejected</conditionExpression>
    </sequenceFlow>

    <intermediateCatchEvent id="approvalRejectedEvent" name="Supervisor Rejects">
      <incoming>sequenceFlow14</incoming>
      <outgoing>sequenceFlow20</outgoing>
      <messageEventDefinition/>
    </intermediateCatchEvent>

    <task id="sendRejectionEmailTask" name="Send the employee a rejection notice by email">
      <incoming>sequenceFlow20</incoming>
      <outgoing>sequenceFlow21</outgoing>
    </task>

    <endEvent id="endEventRejected">
      <incoming>sequenceFlow21</incoming>
    </endEvent>

    <sequenceFlow id="sequenceFlow15" sourceRef="supervisorResponseGateway" targetRef="sendApprovalInProgressEmailTask">

      <conditionExpression xsi:type="tFormalExpression">pending</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="sequenceFlow16" sourceRef="approvalInProgressEvent" targetRef="sendApprovalInProgressEmailTask"/>

    <sequenceFlow id="sequenceFlow17" sourceRef="sendApprovalInProgressEmailTask" targetRef="supervisorResponseGateway"/>

    <sequenceFlow id="sequenceFlow18" sourceRef="approvalAcceptedEvent" targetRef="directDepositTask"/>

    <sequenceFlow id="sequenceFlow19" sourceRef="directDepositTask" targetRef="endEventDirectDeposit"/>

    <sequenceFlow id="sequenceFlow20" sourceRef="approvalRejectedEvent" targetRef="sendRejectionEmailTask"/>

    <sequenceFlow id="sequenceFlow21" sourceRef="sendRejectionEmailTask" targetRef="endEventRejected"/>
  </process>
</definitions>