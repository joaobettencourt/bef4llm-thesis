<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" targetNamespace="http://www.example.com">

  <process id="dataValidationProcess" isExecutable="true">
    <startEvent id="startEvent">
      <outgoing>sequenceFlow1</outgoing>
    </startEvent>

    <task id="checkTyposTask" name="Check for typos">
      <incoming>sequenceFlow1</incoming>
      <outgoing>sequenceFlow2</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow1" sourceRef="startEvent" targetRef="checkTyposTask"/>

    <exclusiveGateway id="typoCheckGateway">
      <incoming>sequenceFlow2</incoming>
      <outgoing>sequenceFlow3</outgoing>
      <outgoing>sequenceFlow4</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequenceFlow2" sourceRef="checkTyposTask" targetRef="typoCheckGateway"/>

    <task id="customerCorrectTask" name="Check if customer can correct">
      <incoming>sequenceFlow3</incoming>
      <outgoing>sequenceFlow5</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow3" sourceRef="typoCheckGateway" targetRef="customerCorrectTask">

      <conditionExpression xsi:type="tFormalExpression">noTypoFound</conditionExpression>
    </sequenceFlow>

    <exclusiveGateway id="customerCorrectGateway">
      <incoming>sequenceFlow5</incoming>
      <outgoing>sequenceFlow6</outgoing>
      <outgoing>sequenceFlow7</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequenceFlow5" sourceRef="customerCorrectTask" targetRef="customerCorrectGateway"/>

    <task id="publicSourcesTask" name="Check public sources">
      <incoming>sequenceFlow6</incoming>
      <outgoing>sequenceFlow8</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow6" sourceRef="customerCorrectGateway" targetRef="publicSourcesTask">

      <conditionExpression xsi:type="tFormalExpression">cannotBeCorrectedByCustomer</conditionExpression>
    </sequenceFlow>

    <endEvent id="issueResolved">
      <incoming>sequenceFlow4</incoming>
      <incoming>sequenceFlow7</incoming>
      <incoming>sequenceFlow8</incoming>
    </endEvent>

    <sequenceFlow id="sequenceFlow4" sourceRef="typoCheckGateway" targetRef="issueResolved">

      <conditionExpression xsi:type="tFormalExpression">foundTypoAndCorrected</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="sequenceFlow7" sourceRef="customerCorrectGateway" targetRef="issueResolved">

      <conditionExpression xsi:type="tFormalExpression">canBeCorrectedByCustomer</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="sequenceFlow8" sourceRef="publicSourcesTask" targetRef="issueResolved"/>
  </process>

</definitions>