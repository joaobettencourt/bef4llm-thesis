<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" name="Device Takeover Bid Process" targetNamespace="http://example.com/bpmn">

   <collaboration id="Collaboration_1">
     <participant id="Participant_MPNO" name="MPON" processRef="Process_MPNO"/>
     <participant id="Participant_MPOO" name="MPOO" processRef="Process_MPOO"/>
     <messageFlow id="MessageFlow_RequestBid" sourceRef="Task_RequestBid_MPNO" targetRef="StartEvent_Tender_MPOO"/>
     <messageFlow id="MessageFlow_SendTender" sourceRef="Task_SendTender_MPOO" targetRef="Task_Order_MPNO"/>
     <messageFlow id="MessageFlow_ConfirmOrder" sourceRef="Task_ConfirmOrder_MPOO" targetRef="EndEvent_OrderConfirmed_MPNO"/>
   </collaboration>

   <process id="Process_MPNO" isExecutable="true">
     <startEvent id="StartEvent_RequestBid_MPNO" name="Request Device Takeover Bid">
       <outgoing>SequenceFlow_RequestBid</outgoing>
     </startEvent>
     <task id="Task_RequestBid_MPNO" name="Request a device takeover bid">
       <incoming>SequenceFlow_RequestBid</incoming>
       <outgoing>SequenceFlow_SendOrder</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_RequestBid" sourceRef="StartEvent_RequestBid_MPNO" targetRef="Task_RequestBid_MPNO"/>
     <sequenceFlow id="SequenceFlow_SendOrder" sourceRef="Task_RequestBid_MPNO" targetRef="Task_Order_MPNO"/>
     <task id="Task_Order_MPNO" name="Place Order">
       <incoming>SequenceFlow_SendOrder</incoming>
       <outgoing>SequenceFlow_ConfirmOrder</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_ConfirmOrder" sourceRef="Task_Order_MPNO" targetRef="EndEvent_OrderConfirmed_MPNO"/>
     <endEvent id="EndEvent_OrderConfirmed_MPNO" name="Order Confirmed">
       <incoming>SequenceFlow_ConfirmOrder</incoming>
     </endEvent>
   </process>

   <process id="Process_MPOO" isExecutable="true">
     <startEvent id="StartEvent_Tender_MPOO" name="Receive Request for Tender">
       <outgoing>SequenceFlow_SendTender</outgoing>
     </startEvent>
     <sequenceFlow id="SequenceFlow_SendTender" sourceRef="StartEvent_Tender_MPOO" targetRef="Task_SendTender_MPOO"/>
     <task id="Task_SendTender_MPOO" name="Send Tender for Equipment Takeover">
       <incoming>SequenceFlow_SendTender</incoming>
       <outgoing>SequenceFlow_ReceiveOrder</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_ReceiveOrder" sourceRef="Task_SendTender_MPOO" targetRef="Task_ConfirmOrder_MPOO"/>
     <task id="Task_ConfirmOrder_MPOO" name="Confirm Order and Send Master Data">
       <incoming>SequenceFlow_ReceiveOrder</incoming>
       <outgoing>SequenceFlow_EndProcess</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_EndProcess" sourceRef="Task_ConfirmOrder_MPOO" targetRef="EndEvent_ProcessCompleted_MPOO"/>
     <endEvent id="EndEvent_ProcessCompleted_MPOO" name="Process Completed">
       <incoming>SequenceFlow_EndProcess</incoming>
     </endEvent>
   </process>

</definitions>