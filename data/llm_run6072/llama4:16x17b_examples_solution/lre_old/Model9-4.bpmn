<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Committee Meeting Process" targetNamespace="http://example.com/bpmn">

   <process id="committeeMeetingProcess" isExecutable="true">
     <laneSet>
       <lane id="coordinationUnitLane" name="Coordination Unit">
         <flowNodeRef>Task_0ycxvd8</flowNodeRef>
       </lane>
       <lane id="supportOfficerLane" name="Support Officer">
         <flowNodeRef>StartEvent_1</flowNodeRef>
         <flowNodeRef>Task_updateCalendars</flowNodeRef>
         <flowNodeRef>Task_uploadDocuments</flowNodeRef>
         <flowNodeRef>CatchEvent_remindCommitteeMembers</flowNodeRef>
         <flowNodeRef>Task_committeeMeeting</flowNodeRef>
         <flowNodeRef>Task_prepareMinutes</flowNodeRef>
         <flowNodeRef>Gateway_exclusive</flowNodeRef>
         <flowNodeRef>Task_qaCheck</flowNodeRef>
         <flowNodeRef>ThrowEvent_sendMinutes</flowNodeRef>
         <flowNodeRef>Task_updateRecords</flowNodeRef>
       </lane>
     </laneSet>

     <startEvent id="StartEvent_1" name="Dates Finalized">
       <outgoing>SequenceFlow_startToUpdateCalendars</outgoing>
     </startEvent>

     <task id="Task_updateCalendars" name="Update Calendars and Create Meeting Folders">
       <incoming>SequenceFlow_startToUpdateCalendars</incoming>
       <outgoing>SequenceFlow_updateCalendarsToUploadDocuments</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_startToUpdateCalendars" sourceRef="StartEvent_1" targetRef="Task_updateCalendars"/>

     <task id="Task_uploadDocuments" name="Upload Documents">
       <incoming>SequenceFlow_updateCalendarsToUploadDocuments</incoming>
       <outgoing>SequenceFlow_uploadDocumentsToCatchEvent_remindCommitteeMembers</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_updateCalendarsToUploadDocuments" sourceRef="Task_updateCalendars" targetRef="Task_uploadDocuments"/>

     <intermediateCatchEvent id="CatchEvent_remindCommitteeMembers" name="Remind Committee Members">
       <incoming>SequenceFlow_uploadDocumentsToCatchEvent_remindCommitteeMembers</incoming>
       <outgoing>SequenceFlow_remindCommitteeMembersToTask_committeeMeeting</outgoing>
       <timerEventDefinition/>
     </intermediateCatchEvent>

     <sequenceFlow id="SequenceFlow_uploadDocumentsToCatchEvent_remindCommitteeMembers" sourceRef="Task_uploadDocuments" targetRef="CatchEvent_remindCommitteeMembers"/>

     <task id="Task_committeeMeeting" name="Committee Meeting">
       <incoming>SequenceFlow_remindCommitteeMembersToTask_committeeMeeting</incoming>
       <outgoing>SequenceFlow_taskCommitteeMeetingToTask_prepareMinutes</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_remindCommitteeMembersToTask_committeeMeeting" sourceRef="CatchEvent_remindCommitteeMembers" targetRef="Task_committeeMeeting"/>

     <task id="Task_prepareMinutes" name="Prepare Minutes">
       <incoming>SequenceFlow_taskCommitteeMeetingToTask_prepareMinutes</incoming>
       <outgoing>SequenceFlow_taskPrepareMinutesToGateway_exclusive</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_taskCommitteeMeetingToTask_prepareMinutes" sourceRef="Task_committeeMeeting" targetRef="Task_prepareMinutes"/>

     <exclusiveGateway id="Gateway_exclusive">
       <incoming>SequenceFlow_taskPrepareMinutesToGateway_exclusive</incoming>
       <outgoing>SequenceFlow_gatewayExclusiveToTask_qaCheck</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_taskPrepareMinutesToGateway_exclusive" sourceRef="Task_prepareMinutes" targetRef="Gateway_exclusive"/>

     <task id="Task_qaCheck" name="QA Check">
       <incoming>SequenceFlow_gatewayExclusiveToTask_qaCheck</incoming>
       <outgoing>SequenceFlow_taskQACheckToThrowEvent_sendMinutes</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_gatewayExclusiveToTask_qaCheck" sourceRef="Gateway_exclusive" targetRef="Task_qaCheck"/>

     <intermediateThrowEvent id="ThrowEvent_sendMinutes" name="Send Minutes">
       <incoming>SequenceFlow_taskQACheckToThrowEvent_sendMinutes</incoming>
     </intermediateThrowEvent>

     <sequenceFlow id="SequenceFlow_taskQACheckToThrowEvent_sendMinutes" sourceRef="Task_qaCheck" targetRef="ThrowEvent_sendMinutes"/>

     <task id="Task_updateRecords" name="Update Records">
       <!-- Assuming it follows sending minutes -->
     </task>
   </process>
</definitions>