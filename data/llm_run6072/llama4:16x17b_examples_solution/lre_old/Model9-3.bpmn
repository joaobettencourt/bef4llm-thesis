<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" 
             targetNamespace="http://bpmn.io/schema/bpmn">
    <collaboration id="meetingScheduleCollaboration">
      <participant id="townPlanningAuthority" name="Town Planning Authority" processRef="townPlanningAuthorityProcess"/>
      <participant id="committeeMembers" name="Committee Members" processRef="committeeMembersProcess"/>
      <messageFlow id="sendScheduleMF" sourceRef="IntermediateMessageEventThrowing_SendSchedule" targetRef="StartMessageEvent_0"/>
      <messageFlow id="adviseConflictsMF" sourceRef="IntermediateMessageEventThrowing_AdviseConflicts" targetRef="townPlanningAuthorityProcess.IntermediateCatchEvent_ReceiveConflicts"/>
    </collaboration>

    <process id="townPlanningAuthorityProcess" isExecutable="true">
      <laneSet>
        <lane id="coordinationUnitLane" name="Coordination Unit">
          <flowNodeRef>StartTimerEvent</flowNodeRef>
          <flowNodeRef>Task_DraftSchedule</flowNodeRef>
          <flowNodeRef>Task_EnterDates</flowNodeRef>
          <flowNodeRef>Task_FinalizeSchedule</flowNodeRef>
          <flowNodeRef>IntermediateMessageEventThrowing_SendSchedule</flowNodeRef>
          <flowNodeRef>IntermediateCatchEvent_ReceiveConflicts</flowNodeRef>
          <flowNodeRef>Task_UpdateCalendars</flowNodeRef>
        </lane>
        <lane id="supportOfficerLane" name="Support Officer">
          <flowNodeRef>Task_CheckDates</flowNodeRef>
        </lane>
      </laneSet>

      <sequenceFlow id="draftScheduleSF" sourceRef="StartTimerEvent" targetRef="Task_DraftSchedule"/>
      <sequenceFlow id="enterDatesSF" sourceRef="Task_DraftSchedule" targetRef="Task_EnterDates"/>
      <sequenceFlow id="checkDatesSF" sourceRef="Task_EnterDates" targetRef="Task_CheckDates"/>
      <sequenceFlow id="finalizeScheduleSF" sourceRef="Task_CheckDates" targetRef="Task_FinalizeSchedule"/>
      <sequenceFlow id="sendScheduleSF" sourceRef="Task_FinalizeSchedule" targetRef="IntermediateMessageEventThrowing_SendSchedule"/>

      <startEvent id="StartTimerEvent" name="November">
        <outgoing>draftScheduleSF</outgoing>
      </startEvent>

      <task id="Task_DraftSchedule" name="Draft schedule of meetings">
        <incoming>draftScheduleSF</incoming>
        <outgoing>enterDatesSF</outgoing>
      </task>

      <task id="Task_EnterDates" name="Add draft dates to calendars">
        <incoming>enterDatesSF</incoming>
        <outgoing>checkDatesSF</outgoing>
      </task>

      <task id="Task_CheckDates" name="Check and suggest updates">
        <incoming>checkDatesSF</incoming>
        <outgoing>finalizeScheduleSF</outgoing>
      </task>

      <task id="Task_FinalizeSchedule" name="Finalize schedule of meetings">
        <incoming>finalizeScheduleSF</incoming>
        <outgoing>sendScheduleSF</outgoing>
      </task>

      <intermediateThrowEvent id="IntermediateMessageEventThrowing_SendSchedule" name="Send schedule to members">
        <incoming>sendScheduleSF</incoming>
      </intermediateThrowEvent>

      <intermediateCatchEvent id="IntermediateCatchEvent_ReceiveConflicts" name="Receive schedule conflicts">
        <outgoing>updateCalendarsSF</outgoing>
      </intermediateCatchEvent>

      <task id="Task_UpdateCalendars" name="Update group calendars based on conflicts">
        <incoming>updateCalendarsSF</incoming>
      </task>

      <sequenceFlow id="updateCalendarsSF" sourceRef="IntermediateCatchEvent_ReceiveConflicts" targetRef="Task_UpdateCalendars"/>

    </process>

    <process id="committeeMembersProcess" isExecutable="true">

      <laneSet>
        <lane id="committeeMembersLane" name="">
          <flowNodeRef>StartMessageEvent_0</flowNodeRef>
          <flowNodeRef>Task_CheckConflicts</flowNodeRef>
          <flowNodeRef>IntermediateMessageEventThrowing_AdviseConflicts</flowNodeRef>
        </lane>
      </laneSet>

      <sequenceFlow id="checkConflictsSF" sourceRef="StartMessageEvent_0" targetRef="Task_CheckConflicts"/>
      <sequenceFlow id="adviseConflictsSF" sourceRef="Task_CheckConflicts" targetRef="IntermediateMessageEventThrowing_AdviseConflicts"/>

      <startEvent id="StartMessageEvent_0" name="Receive meeting schedule">
        <outgoing>checkConflictsSF</outgoing>
      </startEvent>

      <task id="Task_CheckConflicts" name="Check for conflicts and advise of any">
        <incoming>checkConflictsSF</incoming>
        <outgoing>adviseConflictsSF</outgoing>
      </task>

      <intermediateThrowEvent id="IntermediateMessageEventThrowing_AdviseConflicts" name="Advise schedule conflicts">
        <incoming>adviseConflictsSF</incoming>
      </intermediateThrowEvent>

    </process>

</definitions>