<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" name="Vacation Request Process" targetNamespace="http://example.com/bpmn">

   <process id="vacationRequestProcess" isExecutable="true">
     <laneSet>
       <lane id="employeeLane" name="Employee">
         <flowNodeRef>startEvent</flowNodeRef>
         <flowNodeRef>task_RegisterVacationRequest</flowNodeRef>
         <flowNodeRef>task_InformeEmpleadoSobreRazonesDeRechazo</flowNodeRef>
       </lane>
       <lane id="supervisorLane" name="Supervisor">
         <flowNodeRef>task_VerifyAvailableVacationDays</flowNodeRef>
         <flowNodeRef>exclusiveGateway_ApprovedOrRejected</flowNodeRef>
         <flowNodeRef>task_ApproveVacationRequest</flowNodeRef>
         <flowNodeRef>task_RejectVacationRequest</flowNodeRef>
       </lane>
       <lane id="hrLane" name="Human Resources">
         <flowNodeRef>task_ManageVacationProcedures</flowNodeRef>
       </lane>
     </laneSet>

     <startEvent id="startEvent" name="Start Vacation Request Process">
       <outgoing>sequenceFlow_0</outgoing>
     </startEvent>

     <task id="task_RegisterVacationRequest" name="Register Vacation Request">
       <incoming>sequenceFlow_0</incoming>
       <outgoing>sequenceFlow_1</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow_0" sourceRef="startEvent" targetRef="task_RegisterVacationRequest"/>
     <sequenceFlow id="sequenceFlow_1" sourceRef="task_RegisterVacationRequest" targetRef="task_VerifyAvailableVacationDays"/>

     <task id="task_VerifyAvailableVacationDays" name="Verify Available Vacation Days">
       <incoming>sequenceFlow_1</incoming>
       <outgoing>sequenceFlow_2</outgoing>
     </task>

     <exclusiveGateway id="exclusiveGateway_ApprovedOrRejected" name="Approved or Rejected">
       <incoming>sequenceFlow_2</incoming>
       <outgoing>sequenceFlow_3</outgoing>
       <outgoing>sequenceFlow_4</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow_2" sourceRef="task_VerifyAvailableVacationDays" targetRef="exclusiveGateway_ApprovedOrRejected"/>

     <task id="task_ApproveVacationRequest" name="Approve Vacation Request">
       <incoming>sequenceFlow_3</incoming>
       <outgoing>sequenceFlow_5</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow_3" sourceRef="exclusiveGateway_ApprovedOrRejected" targetRef="task_ApproveVacationRequest"/>

     <task id="task_ManageVacationProcedures" name="Manage Vacation Procedures">
       <incoming>sequenceFlow_5</incoming>
       <outgoing>sequenceFlow_6</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow_5" sourceRef="task_ApproveVacationRequest" targetRef="task_ManageVacationProcedures"/>

     <endEvent id="endEvent" name="End Vacation Request Process">
       <incoming>sequenceFlow_6</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow_6" sourceRef="task_ManageVacationProcedures" targetRef="endEvent"/>

     <task id="task_InformeEmpleadoSobreRazonesDeRechazo" name="Inform Employee about Rejection Reasons">
       <incoming>sequenceFlow_4</incoming>
     </task>

     <sequenceFlow id="sequenceFlow_4" sourceRef="exclusiveGateway_ApprovedOrRejected" targetRef="task_InformeEmpleadoSobreRazonesDeRechazo"/>

     <task id="task_RejectVacationRequest" name="Reject Vacation Request">
       <outgoing>sequenceFlow_7</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow_7" sourceRef="exclusiveGateway_ApprovedOrRejected" targetRef="task_RejectVacationRequest"/>

   </process>
</definitions>