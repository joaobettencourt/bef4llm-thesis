<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/ spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Subrogation Process">

   <process id="subrogationProcess" isExecutable="true">
     <startEvent id="probableRecourseDetected1">
       <outgoing>sequenceFlow1</outgoing>
       <messageEventDefinition/>
     </startEvent>

     <task id="checkCase1">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </task>

     <exclusiveGateway id="recoursePossible1">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
       <outgoing>sequenceFlow4</outgoing>
     </exclusiveGateway>

     <task id="sendRequestForPayment1">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow5</outgoing>
     </task>

     <task id="closeCaseNotPossible1">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow6</outgoing>
     </task>

     <endEvent id="caseClosed1">
       <incoming>sequenceFlow6</incoming>
     </endEvent>

     <task id="sendReminder1">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow7</outgoing>
     </task>

     <eventBasedGateway id="waitForResponse1">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow8</outgoing>
       <outgoing>sequenceFlow9</outgoing>
       <outgoing>sequenceFlow10</outgoing>
     </eventBasedGateway>

     <intermediateCatchEvent id="disagreementLetterReceived1">
       <incoming>sequenceFlow8</incoming>
       <outgoing>sequenceFlow11</outgoing>
       <messageEventDefinition/>
     </intermediateCatchEvent>

     <task id="checkReasoning1">
       <incoming>sequenceFlow11</incoming>
       <outgoing>sequenceFlow12</outgoing>
     </task>

     <exclusiveGateway id="isRight1">
       <incoming>sequenceFlow12</incoming>
       <outgoing>sequenceFlow13</outgoing>
       <outgoing>sequenceFlow14</outgoing>
     </exclusiveGateway>

     <task id="closeCaseRight1">
       <incoming>sequenceFlow13</incoming>
       <outgoing>sequenceFlow15</outgoing>
     </task>

     <endEvent id="caseClosedRight1">
       <incoming>sequenceFlow15</incoming>
     </endEvent>

     <task id="handOverToCollectionAgency1">
       <incoming>sequenceFlow14</incoming>
       <incoming>sequenceFlow17</incoming>
       <outgoing>sequenceFlow16</outgoing>
     </task>

     <intermediateCatchEvent id="reminderDue1">
       <incoming>sequenceFlow9</incoming>
       <outgoing>sequenceFlow17</outgoing>
       <timerEventDefinition/>
     </intermediateCatchEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="probableRecourseDetected1" targetRef="checkCase1"/>
     <sequenceFlow id="sequenceFlow2" sourceRef="checkCase1" targetRef="recoursePossible1"/>
     <sequenceFlow id="sequenceFlow3" name="yes" sourceRef="recoursePossible1" targetRef="sendRequestForPayment1"/>
     <sequenceFlow id="sequenceFlow4" name="no" sourceRef="recoursePossible1" targetRef="closeCaseNotPossible1"/>
     <sequenceFlow id="sequenceFlow5" sourceRef="sendRequestForPayment1" targetRef="sendReminder1"/>
     <sequenceFlow id="sequenceFlow6" sourceRef="closeCaseNotPossible1" targetRef="caseClosed1"/>
     <sequenceFlow id="sequenceFlow7" sourceRef="sendReminder1" targetRef="waitForResponse1"/>
     <sequenceFlow id="sequenceFlow8" sourceRef="waitForResponse1" targetRef="disagreementLetterReceived1"/>
     <sequenceFlow id="sequenceFlow9" sourceRef="waitForResponse1" targetRef="reminderDue1"/>
     <sequenceFlow id="sequenceFlow10" sourceRef="waitForResponse1" targetRef="handOverToCollectionAgency1"/>
     <sequenceFlow id="sequenceFlow11" sourceRef="disagreementLetterReceived1" targetRef="checkReasoning1"/>
     <sequenceFlow id="sequenceFlow12" sourceRef="checkReasoning1" targetRef="isRight1"/>
     <sequenceFlow id="sequenceFlow13" name="yes" sourceRef="isRight1" targetRef="closeCaseRight1"/>
     <sequenceFlow id="sequenceFlow14" name="no" sourceRef="isRight1" targetRef="handOverToCollectionAgency1"/>
     <sequenceFlow id="sequenceFlow15" sourceRef="closeCaseRight1" targetRef="caseClosedRight1"/>
     <sequenceFlow id="sequenceFlow16" sourceRef="handOverToCollectionAgency1" targetRef="EndEvent0nfuudw1"/>
     <sequenceFlow id="sequenceFlow17" sourceRef="reminderDue1" targetRef="handOverToCollectionAgency1"/>

     <intermediateCatchEvent id="moneyReceived1">
       <incoming>sequenceFlow10</incoming>
       <outgoing>makeBooking1</outgoing>
       <messageEventDefinition/>
     </intermediateCatchEvent>

     <task id="makeBooking1">
       <incoming>moneyReceived1/incoming>
       <outgoing>closeCaseAfterBooking1</outgoing>
     </task>

     <task id="closeCaseAfterBooking1">
       <incoming>makeBooking1</incoming>
       <outgoing>caseClosedAfterPayment1</outgoing>
     </task>

     <endEvent id="EndEvent0nfuudw1">
       <incoming>sequenceFlow16</incoming>
     </endEvent>

     <endEvent id="caseClosedAfterPayment1">
       <incoming>closeCaseAfterBooking1</incoming>
     </endEvent>
   </process>
</definitions>