<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Customized Bicycle Manufacturing Process" targetNamespace="http://example.com/bpmn">

    <process id="customizedBicycleManufacturingProcess" isExecutable="true">
      <laneSet>
        <lane id="salesDepartment" name="Sales Department">
          <flowNodeRef>startEvent</flowNodeRef>
          <flowNodeRef>task_2</flowNodeRef>
          <flowNodeRef>exclusiveGateway_1</flowNodeRef>
          <flowNodeRef>task_4</flowNodeRef>
          <flowNodeRef>endEvent_1</flowNodeRef>
        </lane>
        <lane id="storehouse" name="Storehouse">
          <flowNodeRef>parallelGateway_1</flowNodeRef>
          <flowNodeRef>exclusiveGateway_2</flowNodeRef>
          <flowNodeRef>task_5</flowNodeRef>
          <flowNodeRef>exclusiveGateway_3</flowNodeRef>
          <flowNodeRef>task_6</flowNodeRef>
          <flowNodeRef>task_7</flowNodeRef>
          <flowNodeRef>exclusiveGateway_4</flowNodeRef>
        </lane>
        <lane id="engineeringDepartment" name="Engineering Department">
          <flowNodeRef>parallelGateway_2</flowNodeRef>
          <flowNodeRef>task_0</flowNodeRef>
          <flowNodeRef>task_1</flowNodeRef>
        </lane>
      </laneSet>

      <startEvent id="startEvent" name="Receive Order">
        <outgoing>sequenceFlow_1</outgoing>
      </startEvent>

      <exclusiveGateway id="exclusiveGateway_1" name="Accept Order?">
        <incoming>sequenceFlow_1</incoming>
        <outgoing>sequenceFlow_2</outgoing>
        <outgoing>sequenceFlow_3</outgoing>
      </exclusiveGateway>

      <task id="task_2" name="Reject Order">
        <incoming>sequenceFlow_2</incoming>
        <outgoing>sequenceFlow_4</outgoing>
      </task>

      <endEvent id="endEvent_1" name="Order Rejected">
        <incoming>sequenceFlow_4</incoming>
      </endEvent>

      <task id="task_3" name="Inform Storehouse and Engineering Department">
        <incoming>sequenceFlow_3</incoming>
        <outgoing>sequenceFlow_5</outgoing>
      </task>

      <parallelGateway id="parallelGateway_1">
        <incoming>sequenceFlow_5</incoming>
        <outgoing>sequenceFlow_6</outgoing>
        <outgoing>sequenceFlow_7</outgoing>
      </parallelGateway>

      <exclusiveGateway id="exclusiveGateway_2" name="Available in-house?">
        <incoming>sequenceFlow_6</incoming>
        <outgoing>sequenceFlow_8</outgoing>
        <outgoing>sequenceFlow_9</outgoing>
      </exclusiveGateway>

      <task id="task_5" name="Check Part Quantity">
        <incoming>sequenceFlow_8</incoming>
        <outgoing>sequenceFlow_10</outgoing>
      </task>

      <task id="task_6" name="Reserve Part">
        <incoming>sequenceFlow_9</incoming>
        <outgoing>sequenceFlow_11</outgoing>
      </task>

      <task id="task_7" name="Back-order Part">
        <incoming>sequenceFlow_10</incoming>
        <outgoing>sequenceFlow_12</outgoing>
      </task>

      <exclusiveGateway id="exclusiveGateway_3">
        <incoming>sequenceFlow_11</incoming>
        <incoming>sequenceFlow_12</incoming>
        <outgoing>sequenceFlow_13</outgoing>
      </exclusiveGateway>

      <parallelGateway id="parallelGateway_2">
        <incoming>sequenceFlow_7</incoming>
        <outgoing>sequenceFlow_14</outgoing>
      </parallelGateway>

      <task id="task_0" name="Prepare for Assembling">
        <incoming>sequenceFlow_14</incoming>
        <outgoing>sequenceFlow_15</outgoing>
      </task>

      <exclusiveGateway id="exclusiveGateway_4" name="Any part left unchecked?">
        <incoming>sequenceFlow_13</incoming>
        <outgoing>sequenceFlow_16</outgoing>
        <outgoing>sequenceFlow_17</outgoing>
      </exclusiveGateway>

      <task id="task_1" name="Assemble Bicycle">
        <incoming>sequenceFlow_15</incoming>
        <outgoing>sequenceFlow_18</outgoing>
      </task>

      <task id="task_4" name="Ship Bicycle to Customer">
        <incoming>sequenceFlow_18</incoming>
        <outgoing>sequenceFlow_19</outgoing>
      </task>

      <endEvent id="endEvent_2" name="Order Delivered">
        <incoming>sequenceFlow_19</incoming>
      </endEvent>

      <sequenceFlow id="sequenceFlow_1" sourceRef="startEvent" targetRef="exclusiveGateway_1"/>
      <sequenceFlow id="sequenceFlow_2" sourceRef="exclusiveGateway_1" targetRef="task_2"/>
      <sequenceFlow id="sequenceFlow_3" sourceRef="exclusiveGateway_1" targetRef="task_3"/>
      <sequenceFlow id="sequenceFlow_4" sourceRef="task_2" targetRef="endEvent_1"/>
      <sequenceFlow id="sequenceFlow_5" sourceRef="task_3" targetRef="parallelGateway_1"/>
      <sequenceFlow id="sequenceFlow_6" sourceRef="parallelGateway_1" targetRef="exclusiveGateway_2"/>
      <sequenceFlow id="sequenceFlow_7" sourceRef="parallelGateway_1" targetRef="parallelGateway_2"/>
      <sequenceFlow id="sequenceFlow_8" sourceRef="exclusiveGateway_2" targetRef="task_5"/>
      <sequenceFlow id="sequenceFlow_9" sourceRef="exclusiveGateway_2" targetRef="task_6"/>
      <sequenceFlow id="sequenceFlow_10" sourceRef="task_5" targetRef="task_7"/>
      <sequenceFlow id="sequenceFlow_11" sourceRef="task_6" targetRef="exclusiveGateway_3"/>
      <sequenceFlow id="sequenceFlow_12" sourceRef="task_7" targetRef="exclusiveGateway_3"/>
      <sequenceFlow id="sequenceFlow_13" sourceRef="exclusiveGateway_3" targetRef="exclusiveGateway_4"/>
      <sequenceFlow id="sequenceFlow_14" sourceRef="parallelGateway_2" targetRef="task_0"/>
      <sequenceFlow id="sequenceFlow_15" sourceRef="task_0" targetRef="task_1"/>
      <sequenceFlow id="sequenceFlow_16" sourceRef="exclusiveGateway_4" targetRef="endEvent_2"/>
      <sequenceFlow id="sequenceFlow_17" sourceRef="exclusiveGateway_4" targetRef="parallelGateway_2"/>
      <sequenceFlow id="sequenceFlow_18" sourceRef="task_1" targetRef="task_4"/>
      <sequenceFlow id="sequenceFlow_19" sourceRef="task_4" targetRef="endEvent_2"/>

    </process>
</definitions>