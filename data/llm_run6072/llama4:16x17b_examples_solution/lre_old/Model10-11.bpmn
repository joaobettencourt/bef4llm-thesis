<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Measurements Process">

   <collaboration id="Collaboration_1">
     <participant id="Participant_MSP" name="MSP" processRef="Pool_MSP"/>
     <participant id="Participant_GO" name="GO" processRef="Pool_GO"/>
     <messageFlow id="MessageFlow_Request" sourceRef="Task_GO_RequestMeasurements" targetRef="StartEvent_MSP_CheckRequest"/>
     <messageFlow id="MessageFlow_TransmitMeasuredValues" sourceRef="Task_MSP_TransmitMeasuredValues" targetRef="IntermediateCatchEvent_GO_ReceiveMeasuredValues"/>
     <messageFlow id="MessageFlow_SendChangedValues" sourceRef="Task_GO_SendChangedValuesToMSP" targetRef="Task_MSP_ReceiveChangedValues"/>
   </collaboration>

   <process id="Pool_MSP" isExecutable="false">
     <startEvent id="StartEvent_MSP_CheckRequest" name="Check Request">
       <outgoing>SequenceFlow_MSP_DenyOrPerform</outgoing>
     </startEvent>

     <exclusiveGateway id="ExclusiveGateway_MSP_Decision" name="Deny or Perform Measurements">
       <incoming>SequenceFlow_MSP_DenyOrPerform</incoming>
       <outgoing>SequenceFlow_MSP_Deny</outgoing>
       <outgoing>SequenceFlow_MSP_PerformMeasurement</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_MSP_DenyOrPerform" sourceRef="StartEvent_MSP_CheckRequest" targetRef="ExclusiveGateway_MSP_Decision"/>
     <sequenceFlow id="SequenceFlow_MSP_Deny" sourceRef="ExclusiveGateway_MSP_Decision" targetRef="Task_MSP_InformAboutFailure"/>
     <task id="Task_MSP_InformAboutFailure" name="Inform about the failure of the reading">
       <incoming>SequenceFlow_MSP_Deny</incoming>
     </task>

     <sequenceFlow id="SequenceFlow_MSP_PerformMeasurement" sourceRef="ExclusiveGateway_MSP_Decision" targetRef="Task_MSP_PerformsMeasurements"/>
     <task id="Task_MSP_PerformsMeasurements" name="Perform Measurements">
       <incoming>SequenceFlow_MSP_PerformMeasurement</incoming>
       <outgoing>SequenceFlow_MSP_TransmitMeasuredValues</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_MSP_TransmitMeasuredValues" sourceRef="Task_MSP_PerformsMeasurements" targetRef="Task_MSP_TransmitMeasuredValues"/>
     <task id="Task_MSP_TransmitMeasuredValues" name="Transmit the measured values">
       <incoming>SequenceFlow_MSP_TransmitMeasuredValues</incoming>
       <outgoing>MessageFlow_TransmitMeasuredValues</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_MSP_ReceiveChangedValues" sourceRef="Task_MSP_ReceiveChangedValues" targetRef="EndEvent_MSP_End"/>
     <intermediateCatchEvent id="IntermediateCatchEvent_MSP_ReceiveChangedValues" name="Receive Changed Values">
       <incoming>MessageFlow_SendChangedValues</incoming>
       <outgoing>SequenceFlow_MSP_ReceiveChangedValues</outgoing>
     </intermediateCatchEvent>

     <endEvent id="EndEvent_MSP_End" name="Measurements Process End">
       <incoming>SequenceFlow_MSP_ReceiveChangedValues</incoming>
     </endEvent>

   </process>

   <process id="Pool_GO" isExecutable="false">
     <startEvent id="StartEvent_GO_RequestMeasurements" name="Request Measurements">
       <outgoing>SequenceFlow_GO_RequestMeasurements</outgoing>
     </startEvent>

     <task id="Task_GO_RequestMeasurements" name="GO requests the measurements of the MSP">
       <incoming>SequenceFlow_GO_RequestMeasurements</incoming>
       <outgoing>MessageFlow_Request</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_GO_RequestMeasurements" sourceRef="StartEvent_GO_RequestMeasurements" targetRef="Task_GO_RequestMeasurements"/>

     <intermediateCatchEvent id="IntermediateCatchEvent_GO_ReceiveMeasuredValues" name="Receive Measured Values">
       <incoming>MessageFlow_TransmitMeasuredValues</incoming>
       <outgoing>SequenceFlow_GO_ProcessMeasuredValues</outgoing>
     </intermediateCatchEvent>

     <sequenceFlow id="SequenceFlow_GO_ProcessMeasuredValues" sourceRef="IntermediateCatchEvent_GO_ReceiveMeasuredValues" targetRef="Task_GO_ProcessMeasuredValues"/>
     <task id="Task_GO_ProcessMeasuredValues" name="GO processes the measured values">
       <incoming>SequenceFlow_GO_ProcessMeasuredValues</incoming>
       <outgoing>SequenceFlow_GO_SendChangedValuesToMSP</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_GO_SendChangedValuesToMSP" sourceRef="Task_GO_ProcessMeasuredValues" targetRef="Task_GO_SendChangedValuesToMSP"/>
     <task id="Task_GO_SendChangedValuesToMSP" name="GO sends the changed values to MSP">
       <incoming>SequenceFlow_GO_SendChangedValuesToMSP</incoming>
       <outgoing>MessageFlow_SendChangedValues</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_GO_TransmitReadingsToSP" sourceRef="Task_GO_TransmitReadingsToSP" targetRef="EndEvent_GO_End"/>
     <task id="Task_GO_TransmitReadingsToSP" name="GO transmit the readings to SP">
       <incoming>SequenceFlow_GO_SendChangedValues</incoming>
     </task>

     <endEvent id="EndEvent_GO_End" name="Measurements Process End">
       <incoming>SequenceFlow_GO_TransmitReadingsToSP</incoming>
     </endEvent>

   </process>

</definitions>