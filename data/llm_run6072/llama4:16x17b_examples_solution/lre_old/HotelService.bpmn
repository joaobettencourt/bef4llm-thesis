<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Room Service Process at The Evanstonian" targetNamespace="http://bpmn.io/schema/bpmn">
    <process id="roomServiceProcess" isExecutable="true">
        <startEvent id="startOrder" name="Start Order">
            <outgoing>takeDownOrder</outgoing>
        </startEvent>

        <task id="takeDownOrderTask" name="Take Down Order">
            <incoming>sequenceFlow1</incoming>
            <outgoing>sequenceFlow2</outgoing>
        </task>

        <sequenceFlow id="sequenceFlow1" sourceRef="startOrder" targetRef="takeDownOrderTask"/>

        <task id="submitOrderTicketToKitchenTask" name="Submit Order Ticket to Kitchen">
            <incoming>sequenceFlow2</incoming>
            <outgoing>sequenceFlow3</outgoing>
        </task>

        <sequenceFlow id="sequenceFlow2" sourceRef="takeDownOrderTask" targetRef="submitOrderTicketToKitchenTask"/>

        <parallelGateway id="prepareOrderGateway" name="Prepare Order">
            <incoming>sequenceFlow3</incoming>
            <outgoing>sequenceFlow4</outgoing>
            <outgoing>sequenceFlow5</outgoing>
        </parallelGateway>

        <sequenceFlow id="sequenceFlow3" sourceRef="submitOrderTicketToKitchenTask" targetRef="prepareOrderGateway"/>

        <task id="prepareMealTask" name="Prepare Meal">
            <incoming>sequenceFlow4</incoming>
            <outgoing>sequenceFlow6</outgoing>
        </task>

        <sequenceFlow id="sequenceFlow4" sourceRef="prepareOrderGateway" targetRef="prepareMealTask"/>

        <exclusiveGateway id="orderIncludesAlcoholicBeverageGateway" name="Does Order Include Alcoholic Beverage?">
            <incoming>sequenceFlow5</incoming>
            <outgoing>sequenceFlow7</outgoing>
            <outgoing>sequenceFlow8</outgoing>
        </exclusiveGateway>

        <sequenceFlow id="sequenceFlow5" sourceRef="prepareOrderGateway" targetRef="orderIncludesAlcoholicBeverageGateway"/>

        <task id="fetchWineAndOtherAlcoholicBeveragesTask" name="Fetch Wine and Other Alcoholic Beverages">
            <incoming>sequenceFlow7</incoming>
            <outgoing>sequenceFlow9</outgoing>
        </task>

        <sequenceFlow id="sequenceFlow7" sourceRef="orderIncludesAlcoholicBeverageGateway" targetRef="fetchWineAndOtherAlcoholicBeveragesTask"/>

        <parallelGateway id="allTasksCompleteGateway" name="All Tasks Complete">
            <incoming>sequenceFlow9</incoming>
            <incoming>sequenceFlow6</incoming>
            <outgoing>sequenceFlow10</outgoing>
        </parallelGateway>

        <sequenceFlow id="sequenceFlow9" sourceRef="fetchWineAndOtherAlcoholicBeveragesTask" targetRef="allTasksCompleteGateway"/>
        <sequenceFlow id="sequenceFlow6" sourceRef="prepareMealTask" targetRef="allTasksCompleteGateway"/>

        <task id="deliverToGuestRoomTask" name="Deliver to Guest Room">
            <incoming>sequenceFlow10</incoming>
            <outgoing>sequenceFlow11</outgoing>
        </task>

        <sequenceFlow id="sequenceFlow10" sourceRef="allTasksCompleteGateway" targetRef="deliverToGuestRoomTask"/>

        <task id="debitGuestAccountTask" name="Debit Guest Account">
            <incoming>sequenceFlow11</incoming>
            <outgoing>sequenceFlow12</outgoing>
        </task>

        <sequenceFlow id="sequenceFlow11" sourceRef="deliverToGuestRoomTask" targetRef="debitGuestAccountTask"/>

        <endEvent id="endOrder" name="End Order">
            <incoming>sequenceFlow12</incoming>
        </endEvent>

        <sequenceFlow id="sequenceFlow12" sourceRef="debitGuestAccountTask" targetRef="endOrder"/>
    </process>
</definitions>