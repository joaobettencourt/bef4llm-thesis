<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Switch Over Process" targetNamespace="http://bpmn.io/schema/bpmn">
  <process id="switchOverProcess" isExecutable="true">
    <startEvent id="startEvent" name="Switch-Over Request">
      <outgoing>sequenceFlow1</outgoing>
    </startEvent>

    <task id="enterCustomerData" name="Enter Customer Data Object">
      <incoming>sequenceFlow1</incoming>
      <outgoing>sequenceFlow2</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow1" sourceRef="startEvent" targetRef="enterCustomerData"/>
    <sequenceFlow id="sequenceFlow2" sourceRef="enterCustomerData" targetRef="checkCustomersFirstRegistration"/>

    <exclusiveGateway id="dataCompleteAndPossible" name="Data Complete and Possible?">
      <outgoing>sequenceFlow3</outgoing>
      <outgoing>sequenceFlow4</outgoing>
    </exclusiveGateway>

    <task id="performErrorHandling" name="Perform Error Handling">
      <incoming>sequenceFlow4</incoming>
    </task>

    <task id="checkCustomersFirstRegistration" name="Check Customer' First Registration">
      <incoming>sequenceFlow2</incoming>
      <outgoing>sequenceFlow5</outgoing>
    </task>

    <exclusiveGateway id="newCustomer" name="New Customer?">
      <incoming>sequenceFlow5</incoming>
      <outgoing>sequenceFlow6</outgoing>
      <outgoing>sequenceFlow7</outgoing>
    </exclusiveGateway>

    <task id="createCustomer" name="Create Customer">
      <incoming>sequenceFlow6</incoming>
      <outgoing>sequenceFlow8</outgoing>
    </task>

    <task id="prepareContractDocuments" name="Prepare Contract Documents">
      <incoming>sequenceFlow8</incoming>
      <incoming>sequenceFlow9</incoming>
      <outgoing>sequenceFlow10</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow3" sourceRef="dataCompleteAndPossible" targetRef="performErrorHandling"/>
    <sequenceFlow id="sequenceFlow4" sourceRef="enterCustomerData" targetRef="dataCompleteAndPossible"/>
    <sequenceFlow id="sequenceFlow5" sourceRef="checkCustomersFirstRegistration" targetRef="newCustomer"/>
    <sequenceFlow id="sequenceFlow6" sourceRef="newCustomer" targetRef="createCustomer"/>
    <sequenceFlow id="sequenceFlow7" sourceRef="newCustomer" targetRef="prepareContractDocuments"/>
    <sequenceFlow id="sequenceFlow8" sourceRef="createCustomer" targetRef="prepareContractDocuments"/>
  </process>
</definitions>