<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Computer Repair Process" targetNamespace="http://example.com">
   <process id="computerRepairProcess" isExecutable="true">
     <startEvent id="startEvent">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <task id="bringInDefectiveComputer" name="Bring in defective computer">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent" targetRef="bringInDefectiveComputer"/>

     <task id="checkDefect" name="Check defect and calculate repair cost">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow2" sourceRef="bringInDefectiveComputer" targetRef="checkDefect"/>

     <exclusiveGateway id="costDecision">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow4</outgoing>
       <outgoing>sequenceFlow5</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow3" sourceRef="checkDefect" targetRef="costDecision"/>

     <task id="takeComputerHome" name="Take computer home unrepaired">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow6</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow5" sourceRef="costDecision" targetRef="takeComputerHome"/>

     <endEvent id="processEnded">
       <incoming>sequenceFlow6</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow6" sourceRef="takeComputerHome" targetRef="processEnded"/>

     <task id="continueRepair" name="Continue with repair">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow7</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow4" sourceRef="costDecision" targetRef="continueRepair"/>

     <parallelGateway id="repairActivitiesGateway">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow8</outgoing>
       <outgoing>sequenceFlow9</outgoing>
     </parallelGateway>

     <sequenceFlow id="sequenceFlow7" sourceRef="continueRepair" targetRef="repairActivitiesGateway"/>

     <task id="checkAndRepairHardware" name="Check and repair hardware">
       <incoming>sequenceFlow8</incoming>
       <outgoing>sequenceFlow10</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow8" sourceRef="repairActivitiesGateway" targetRef="checkAndRepairHardware"/>

     <task id="checkAndConfigureSoftware" name="Check and configure software">
       <incoming>sequenceFlow9</incoming>
       <outgoing>sequenceFlow11</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow9" sourceRef="repairActivitiesGateway" targetRef="checkAndConfigureSoftware"/>

     <exclusiveGateway id="testResultGateway">
       <incoming>sequenceFlow10</incoming>
       <incoming>sequenceFlow11</incoming>
       <outgoing>sequenceFlow12</outgoing>
       <outgoing>sequenceFlow13</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow10" sourceRef="checkAndRepairHardware" targetRef="testResultGateway"/>
     <sequenceFlow id="sequenceFlow11" sourceRef="checkAndConfigureSoftware" targetRef="testResultGateway"/>

     <task id="repeatActivity" name="Repeat activity if error detected">
       <incoming>sequenceFlow13</incoming>
       <outgoing>sequenceFlow14</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow13" sourceRef="testResultGateway" targetRef="repeatActivity"/>

     <endEvent id="repairFinished">
       <incoming>sequenceFlow12</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow12" sourceRef="testResultGateway" targetRef="repairFinished"/>
     <sequenceFlow id="sequenceFlow14" sourceRef="repeatActivity" targetRef="repairActivitiesGateway"/>

   </process>
 </definitions>