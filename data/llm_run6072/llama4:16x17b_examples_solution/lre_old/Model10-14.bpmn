<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Bill Examination and Confirmation Process" targetNamespace="http://bpmn.io/schema/bpmn">
    <process id="billProcess" isExecutable="true">
        <startEvent id="startEvent1" name="Start Bill Process">
            <outgoing>sequenceFlow1</outgoing>
            <outgoing>sequenceFlow4</outgoing>
        </startEvent>

        <task id="examineBillGO" name="Examine Bill by GO">
            <incoming>sequenceFlow1</incoming>
            <outgoing>sequenceFlow2</outgoing>
        </task>

        <task id="examineBillMPON" name="Examine Bill by MPON">
            <incoming>sequenceFlow4</incoming>
            <outgoing>sequenceFlow5</outgoing>
        </task>

        <exclusiveGateway id="gateway1" name="Is Invoice Confirmed?">
            <incoming>sequenceFlow2</incoming>
            <incoming>sequenceFlow5</incoming>
            <outgoing>sequenceFlow6</outgoing>
            <outgoing>sequenceFlow7</outgoing>
        </exclusiveGateway>

        <task id="confirmInvoice" name="Confirm Invoice with Payment Advice">
            <incoming>sequenceFlow6</incoming>
            <outgoing>sequenceFlow8</outgoing>
        </task>

        <task id="rejectInvoice" name="Reject Invoice">
            <incoming>sequenceFlow7</incoming>
            <outgoing>sequenceFlow9</outgoing>
        </task>

        <endEvent id="endConfirmed" name="Invoice Confirmed and Paid">
            <incoming>sequenceFlow8</incoming>
        </endEvent>

        <endEvent id="endRejected" name="Invoice Rejected">
            <incoming>sequenceFlow9</incoming>
        </endEvent>

        <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="examineBillGO"/>
        <sequenceFlow id="sequenceFlow2" sourceRef="examineBillGO" targetRef="gateway1"/>
        <sequenceFlow id="sequenceFlow4" sourceRef="startEvent1" targetRef="examineBillMPON"/>
        <sequenceFlow id="sequenceFlow5" sourceRef="examineBillMPON" targetRef="gateway1"/>
        <sequenceFlow id="sequenceFlow6" sourceRef="gateway1" targetRef="confirmInvoice"/>
        <sequenceFlow id="sequenceFlow7" sourceRef="gateway1" targetRef="rejectInvoice"/>
        <sequenceFlow id="sequenceFlow8" sourceRef="confirmInvoice" targetRef="endConfirmed"/>
        <sequenceFlow id="sequenceFlow9" sourceRef="rejectInvoice" targetRef="endRejected"/>

    </process>
</definitions>