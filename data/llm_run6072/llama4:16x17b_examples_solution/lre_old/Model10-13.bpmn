<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Transaction Data Request Process" targetNamespace="http://example.com/bpmn">

   <collaboration id="Collaboration_1">
     <participant id="Participant_INQ" name="INQ" processRef="Process_INQ"/>
     <participant id="Participant_IP" name="IP" processRef="Process_IP"/>
     <messageFlow id="MessageFlow_Request" sourceRef="IntermediateThrowEvent_Request" targetRef="StartEvent_CheckRequest"/>
   </collaboration>

   <process id="Process_INQ" isExecutable="true">
     <startEvent id="StartEvent_1" name="Transmit Request">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>
    
     <task id="Task_Request" name="Request Data">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>

     <intermediateThrowEvent id="IntermediateThrowEvent_1" name="Send Request to IP">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>MessageFlow_Request</outgoing>
     </intermediateThrowEvent>

     <endEvent id="EndEvent_DataReceived_1" name="Data Received">
       <incoming>SequenceFlow_4</incoming>
     </endEvent>

     <endEvent id="EndEvent_Rejected_1" name="Request Rejected">
       <incoming>SequenceFlow_5</incoming>
     </endEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_Request"/>
     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_Request" targetRef="IntermediateThrowEvent_1"/>
     <sequenceFlow id="SequenceFlow_4" sourceRef="Task_DataReceived_1" targetRef="EndEvent_DataReceived_1"/>
     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_Rejected_1" targetRef="EndEvent_Rejected_1"/>
   </process>

   <process id="Process_IP" isExecutable="true">
     <startEvent id="StartEvent_CheckRequest" name="Receive Request from INQ">
       <incoming>MessageFlow_Request</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </startEvent>

     <task id="Task_CheckRequest_1" name="Check Request">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_7</outgoing>
     </task>

     <exclusiveGateway id="ExclusiveGateway_Result_1" name="Result of Check">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_8</outgoing>
       <outgoing>SequenceFlow_9</outgoing>
     </exclusiveGateway>

     <task id="Task_DataReceived_1" name="Transmit Data to INQ">
       <incoming>SequenceFlow_8</incoming>
     </task>

     <task id="Task_Rejected_1" name="Reject Request">
       <incoming>SequenceFlow_9</incoming>
     </task>

     <sequenceFlow id="SequenceFlow_6" sourceRef="StartEvent_CheckRequest" targetRef="Task_CheckRequest_1"/>
     <sequenceFlow id="SequenceFlow_7" sourceRef="Task_CheckRequest_1" targetRef="ExclusiveGateway_Result_1"/>
     <sequenceFlow id="SequenceFlow_8" sourceRef="ExclusiveGateway_Result_1" targetRef="Task_DataReceived_1"/>
     <sequenceFlow id="SequenceFlow_9" sourceRef="ExclusiveGateway_Result_1" targetRef="Task_Rejected_1"/>
   </process>
</definitions>