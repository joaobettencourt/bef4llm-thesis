<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Room Service Process" targetNamespace="http://bpmn.io/schema/bpmn">

   <process id="roomServiceProcess" isExecutable="true">
     <startEvent id="startEvent1">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <task id="takeDownOrderTask" name="Take Down Order">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="takeDownOrderTask"/>

     <parallelGateway id="submitOrdersGateway">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
       <outgoing>sequenceFlow4</outgoing>
     </parallelGateway>

     <sequenceFlow id="sequenceFlow2" sourceRef="takeDownOrderTask" targetRef="submitOrdersGateway"/>

     <task id="submitOrderTicketToKitchenTask" name="Submit Order Ticket to Kitchen">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow5</outgoing>
     </task>

     <task id="giveOrderToSommelierTask" name="Give Order to Sommelier">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow6</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow3" sourceRef="submitOrdersGateway" targetRef="submitOrderTicketToKitchenTask"/>
     <sequenceFlow id="sequenceFlow4" sourceRef="submitOrdersGateway" targetRef="giveOrderToSommelierTask"/>

     <task id="prepareMealTask" name="Prepare Meal">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow7</outgoing>
     </task>

     <inclusiveGateway id="sommelierTasksCompleteGateway">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow8</outgoing>
     </inclusiveGateway>

     <sequenceFlow id="sequenceFlow5" sourceRef="submitOrderTicketToKitchenTask" targetRef="prepareMealTask"/>
     <sequenceFlow id="sequenceFlow6" sourceRef="giveOrderToSommelierTask" targetRef="sommelierTasksCompleteGateway"/>

     <task id="readyCartTask" name="Ready Cart">
       <incoming>sequenceFlow8</incoming>
       <outgoing>sequenceFlow9</outgoing>
     </task>

     <parallelGateway id="deliverAndReturnGateway">
       <incoming>sequenceFlow7</incoming>
       <incoming>sequenceFlow9</incoming>
       <outgoing>sequenceFlow10</outgoing>
     </parallelGateway>

     <sequenceFlow id="sequenceFlow7" sourceRef="prepareMealTask" targetRef="deliverAndReturnGateway"/>
     <sequenceFlow id="sequenceFlow8" sourceRef="sommelierTasksCompleteGateway" targetRef="readyCartTask"/>
     <sequenceFlow id="sequenceFlow9" sourceRef="readyCartTask" targetRef="deliverAndReturnGateway"/>

     <task id="deliverToGuestRoomTask" name="Deliver to Guest's Room">
       <incoming>sequenceFlow10</incoming>
       <outgoing>sequenceFlow11</outgoing>
     </task>

     <task id="returnToRoomServiceStationTask" name="Return to Room-Service Station">
       <incoming>sequenceFlow11</incoming>
       <outgoing>sequenceFlow12</outgoing>
     </task>

     <task id="debitGuestsAccountTask" name="Debit Guest's Account">
       <incoming>sequenceFlow12</incoming>
       <outgoing>sequenceFlow13</outgoing>
     </task>

     <endEvent id="orderFulfilledEvent">
       <incoming>sequenceFlow13</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow10" sourceRef="deliverAndReturnGateway" targetRef="deliverToGuestRoomTask"/>
     <sequenceFlow id="sequenceFlow11" sourceRef="deliverToGuestRoomTask" targetRef="returnToRoomServiceStationTask"/>
     <sequenceFlow id="sequenceFlow12" sourceRef="returnToRoomServiceStationTask" targetRef="debitGuestsAccountTask"/>
     <sequenceFlow id="sequenceFlow13" sourceRef="debitGuestsAccountTask" targetRef="orderFulfilledEvent"/>

   </process>
</definitions>