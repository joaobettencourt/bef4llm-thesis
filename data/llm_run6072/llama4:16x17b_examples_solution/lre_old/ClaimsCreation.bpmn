<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" 
             targetNamespace="http://example.com/bpmn">

   <process id="policeReportAndClaimHandlingProcess" isExecutable="true">
     <laneSet>
       <lane id="claimsHandlerLane" name="Claims Handler">
         <flowNodeRef>calculateInitialClaimEstimateTask</flowNodeRef>
         <flowNodeRef>createActionPlanTask</flowNodeRef>
       </lane>
       <lane id="clerkLane" name="Clerk">
         <flowNodeRef>searchPoliceReportDatabaseTask</flowNodeRef>
         <flowNodeRef>composeFileTask</flowNodeRef>
         <flowNodeRef>negotiateSettlementTask</flowNodeRef>
         <flowNodeRef>informeClaimantTask</flowNodeRef>
       </lane>
     </laneSet>

     <startEvent id="startEvent" name="Start Police Report and Claim Handling Process">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <task id="searchPoliceReportDatabaseTask" name="Search Police Report Database">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent" targetRef="searchPoliceReportDatabaseTask"/>
     <sequenceFlow id="sequenceFlow2" sourceRef="searchPoliceReportDatabaseTask" targetRef="composeFileTask"/>

     <task id="composeFileTask" name="Compose File with Police Report and Claim Documentation">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow3" sourceRef="composeFileTask" targetRef="calculateInitialClaimEstimateTask"/>

     <task id="calculateInitialClaimEstimateTask" name="Calculate Initial Claim Estimate">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow4</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow4" sourceRef="calculateInitialClaimEstimateTask" targetRef="createActionPlanTask"/>

     <task id="createActionPlanTask" name="Create Action Plan">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow5</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow5" sourceRef="createActionPlanTask" targetRef="negotiateSettlementTask"/>

     <task id="negotiateSettlementTask" name="Negotiate Settlement">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow6</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow6" sourceRef="negotiateSettlementTask" targetRef="informeClaimantTask"/>

     <task id="informeClaimantTask" name="Inform Claimant of Outcome">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow7</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow7" sourceRef="informeClaimantTask" targetRef="endEvent"/>

     <endEvent id="endEvent" name="Police Report and Claim Handling Process Completed">
       <incoming>sequenceFlow7</incoming>
     </endEvent>
   </process>
</definitions>