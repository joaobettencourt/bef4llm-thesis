<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="BPMN Process Model" targetNamespace="http://example.com/bpmn">
  <process id="ClaimsHandlingProcess" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_SearchPoliceReport"/>
    <task id="Task_SearchPoliceReport" name="Search Police Report">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_SearchPoliceReport" targetRef="Task_CreateFile"/>
    <task id="Task_CreateFile" name="Create File with Police Report and Claim Documentation">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_3" sourceRef="Task_CreateFile" targetRef="Task_CalculateClaimEstimate"/>
    <task id="Task_CalculateClaimEstimate" name="Calculate Initial Claim Estimate">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_4</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_4" sourceRef="Task_CalculateClaimEstimate" targetRef="Task_CreateActionPlan"/>
    <task id="Task_CreateActionPlan" name="Create Action Plan">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_5</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_5" sourceRef="Task_CreateActionPlan" targetRef="Task_NegotiateSettlement"/>
    <task id="Task_NegotiateSettlement" name="Negotiate Settlement">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_6" sourceRef="Task_NegotiateSettlement" targetRef="Task_InformeClaimant"/>
    <task id="Task_InformeClaimant" name="Inform Claimant of Outcome">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_7" sourceRef="Task_InformeClaimant" targetRef="EndEvent_1"/>
    <endEvent id="EndEvent_1">
      <incoming>SequenceFlow_7</incoming>
    </endEvent>
  </process>
</definitions>