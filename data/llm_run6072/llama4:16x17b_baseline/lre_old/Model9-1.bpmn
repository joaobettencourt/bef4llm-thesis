<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="BPMN Process Model" targetNamespace="http://example.com/bpmn">
   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>
     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>
     <task id="Task_1" name="Backup Database">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="ExclusiveGateway_1"/>
     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_4</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_1" targetRef="Task_2">
     </sequenceFlow>
     <task id="Task_2" name="Check Account Defaulters table for new records">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_1" targetRef="Task_3"/>
     <task id="Task_3" name="Check CRM system for new returns">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_2" targetRef="Task_7"/>
     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_3" targetRef="ExclusiveGateway_2"/>
     <exclusiveGateway id="ExclusiveGateway_2">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_7</outgoing>
       <outgoing>SequenceFlow_8</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_7" sourceRef="ExclusiveGateway_2" targetRef="Task_4"/>
     <task id="Task_4" name="Register defaulting accounts and customers">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_8" sourceRef="ExclusiveGateway_2" targetRef="Task_5"/>
     <task id="Task_5" name="Check if defaulting client codes have been previously advised">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_10</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_4" targetRef="Task_5"/>
     <sequenceFlow id="SequenceFlow_10" sourceRef="Task_5" targetRef="ExclusiveGateway_3"/>
     <exclusiveGateway id="ExclusiveGateway_3">
       <incoming>SequenceFlow_10</incoming>
       <outgoing>SequenceFlow_11</outgoing>
       <outgoing>SequenceFlow_12</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_11" sourceRef="ExclusiveGateway_3" targetRef="Task_6"/>
     <task id="Task_6" name="Produce table of defaulting accounts and send to account management">
       <incoming>SequenceFlow_11</incoming>
       <outgoing>SequenceFlow_13</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_12" sourceRef="ExclusiveGateway_3" targetRef="EndEvent_1"/>
     <intermediateCatchEvent id="IntermediateCatchEvent_1">
       <incoming>SequenceFlow_13</incoming>
       <!-- timer event definition -->
       <outgoing>SequenceFlow_14</outgoing>
     </intermediateCatchEvent>
     <sequenceFlow id="SequenceFlow_13" sourceRef="Task_6" targetRef="IntermediateCatchEvent_1"/>
     <sequenceFlow id="SequenceFlow_14" sourceRef="IntermediateCatchEvent_1" targetRef="Task_8"/>
     <task id="Task_8" name="Send alert to supervisor">
       <incoming>SequenceFlow_14</incoming>
       <!-- outgoing -->
     </task>
     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_12</incoming>
     </endEvent>
   </process>
 </definitions>