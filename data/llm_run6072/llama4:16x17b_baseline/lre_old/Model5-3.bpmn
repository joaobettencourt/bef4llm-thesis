<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" 
             targetNamespace="http://example.com/bpmn">

   <process id="OfficeSupplyRequestProcess" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>

     <task id="Task_1" name="Submit Office Supply Request">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="ExclusiveGateway_1"/>

     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_4</outgoing>
       <outgoing>SequenceFlow_5</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_1" targetRef="Task_2">
       <conditionExpression xsi:type="tFormalExpression">${approvalResult == 'approved'}</conditionExpression>
     </sequenceFlow>

     <task id="Task_2" name="Approve Request">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_2" targetRef="SubProcess_1"/>

     <subProcess id="SubProcess_1" name="Make Quotation and Select Vendor">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_7</outgoing>
     </subProcess>

     <sequenceFlow id="SequenceFlow_7" sourceRef="SubProcess_1" targetRef="Task_3"/>

     <task id="Task_3" name="Generate and Send Purchase Order">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_8</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_8" sourceRef="Task_3" targetRef="EndEvent_1"/>

     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_8</incoming>
     </endEvent>

     <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_2">
       <conditionExpression xsi:type="tFormalExpression">${approvalResult == 'rejected'}</conditionExpression>
     </sequenceFlow>

     <endEvent id="EndEvent_2">
       <incoming>SequenceFlow_4</incoming>
     </endEvent>

     <sequenceFlow id="SequenceFlow_5" sourceRef="ExclusiveGateway_1" targetRef="Task_4">
       <conditionExpression xsi:type="tFormalExpression">${approvalResult == 'changeRequired'}</conditionExpression>
     </sequenceFlow>

     <task id="Task_4" name="Request Changes">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_4" targetRef="Task_1"/>

   </process>

</definitions>