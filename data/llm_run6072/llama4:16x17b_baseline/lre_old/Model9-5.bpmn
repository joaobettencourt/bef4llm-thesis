<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Expense Report Process">

  <process id="ExpenseReportProcess" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>

    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_CreateAccount"/>

    <task id="Task_CreateAccount" name="Create New Account if Necessary">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_CreateAccount" targetRef="ExclusiveGateway_1"/>

    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
      <outgoing>SequenceFlow_4</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_1" targetRef="Task_SupervisorApproval">
      <conditionExpression xsi:type="tFormalExpression">${amount >= 200}</conditionExpression>
    </sequenceFlow>

    <task id="Task_SupervisorApproval" name="Send to Supervisor for Approval">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_5</outgoing>
      <outgoing>SequenceFlow_Rejected</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_5" sourceRef="Task_SupervisorApproval" targetRef="Task_AutomaticReimburse">
      <conditionExpression xsi:type="tFormalExpression">${approvalResult == 'approved'}</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="SequenceFlow_Rejected" sourceRef="Task_SupervisorApproval" targetRef="Task_SendRejectionEmail">
      <conditionExpression xsi:type="tFormalExpression">${approvalResult == 'rejected'}</conditionExpression>
    </sequenceFlow>

    <task id="Task_SendRejectionEmail" name="Send Rejection Email to Employee">
      <incoming>SequenceFlow_Rejected</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_6" sourceRef="Task_SendRejectionEmail" targetRef="EndEvent_1"/>

    <endEvent id="EndEvent_1">
      <incoming>SequenceFlow_6</incoming>
    </endEvent>

    <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_1" targetRef="Task_AutomaticApproval">
      <conditionExpression xsi:type="tFormalExpression">${amount < 200}</conditionExpression>
    </sequenceFlow>

    <task id="Task_AutomaticApproval" name="Automatic Approval">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_7" sourceRef="Task_AutomaticApproval" targetRef="Task_AutomaticReimburse"/>

    <task id="Task_AutomaticReimburse" name="Reimburse Employee">
      <incoming>SequenceFlow_5</incoming>
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_8" sourceRef="Task_AutomaticReimburse" targetRef="EndEvent_2"/>

    <endEvent id="EndEvent_2">
      <incoming>SequenceFlow_8</incoming>
    </endEvent>

    <intermediateCatchEvent id="IntermediateCatchEvent_1">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_InProgress</outgoing>
      <timerEventDefinition>
        <timeDuration>P7D</timeDuration>
      </timerEventDefinition>
    </intermediateCatchEvent>

    <sequenceFlow id="SequenceFlow_InProgress" sourceRef="IntermediateCatchEvent_1" targetRef="Task_SendInProgressEmail"/>

    <task id="Task_SendInProgressEmail" name="Send Approval in Progress Email to Employee">
      <incoming>SequenceFlow_InProgress</incoming>
      <outgoing>SequenceFlow_9</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_9" sourceRef="Task_SendInProgressEmail" targetRef="IntermediateCatchEvent_2"/>

    <intermediateCatchEvent id="IntermediateCatchEvent_2">
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_Cancelled</outgoing>
      <timerEventDefinition>
        <timeDuration>P30D</timeDuration>
      </timerEventDefinition>
    </intermediateCatchEvent>

    <sequenceFlow id="SequenceFlow_Cancelled" sourceRef="IntermediateCatchEvent_2" targetRef="Task_SendCancellationEmail"/>

    <task id="Task_SendCancellationEmail" name="Send Cancellation Email to Employee">
      <incoming>SequenceFlow_Cancelled</incoming>
      <outgoing>SequenceFlow_10</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_10" sourceRef="Task_SendCancellationEmail" targetRef="EndEvent_3"/>

    <endEvent id="EndEvent_3">
      <incoming>SequenceFlow_10</incoming>
    </endEvent>
  </process>
</definitions>