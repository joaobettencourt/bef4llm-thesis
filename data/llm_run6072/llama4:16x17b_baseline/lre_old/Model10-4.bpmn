<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Equipment Change Process" targetNamespace="http://example.com/bpmn">
   <process id="equipmentChangeProcess" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>
     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="ExclusiveGateway_1"/>
     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
       <outgoing>SequenceFlow_3</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_2" sourceRef="ExclusiveGateway_1" targetRef="Task_MPOO_Dismounts">
       <conditionExpression xsi:type="tFormalExpression">${mpooSelfDismounting  = true}</conditionExpression>
     </sequenceFlow>
     <task id="Task_MPOO_Dismounts" name="MPOO performs dismounting">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_4</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_4" sourceRef="Task_MPOO_Dismounts" targetRef="ParallelGateway_FinalReadings"/>
     <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_1" targetRef="Task_MPON_Notifies_MPOO">
       <conditionExpression xsi:type="tFormalExpression">${mpooSelfDismounting  = false}</conditionExpression>
     </sequenceFlow>
     <task id="Task_MPON_Notifies_MPOO" name="MPON notifies MPOO about no self-dismounting">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_MPON_Notifies_MPOO" targetRef="ParallelGateway_FinalReadings"/>
     <parallelGateway id="ParallelGateway_FinalReadings">
       <incoming>SequenceFlow_4</incoming>
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_6</outgoing>
       <outgoing>SequenceFlow_7</outgoing>
     </parallelGateway>
     <sequenceFlow id="SequenceFlow_6" sourceRef="ParallelGateway_FinalReadings" targetRef="Task_Dismount_Old_Equipment"/>
     <task id="Task_Dismount_Old_Equipment" name="Dismount old equipment">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_8</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_7" sourceRef="ParallelGateway_FinalReadings" targetRef="Task_Mount_New_Equipment"/>
     <task id="Task_Mount_New_Equipment" name="Mount new equipment">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_8" sourceRef="Task_Dismount_Old_Equipment" targetRef="Task_Read_Meter_Count"/>
     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_Mount_New_Equipment" targetRef="Task_Read_Meter_Count"/>
     <task id="Task_Read_Meter_Count" name="Read meter count">
       <incoming>SequenceFlow_8</incoming>
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_10</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_10" sourceRef="Task_Read_Meter_Count" targetRef="Task_Send_Final_Readings"/>
     <task id="Task_Send_Final_Readings" name="Send final readings to GO">
       <incoming>SequenceFlow_10</incoming>
       <outgoing>SequenceFlow_11</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_11" sourceRef="Task_Send_Final_Readings" targetRef="Task_Notify_Device_Changes"/>
     <task id="Task_Notify_Device_Changes" name="Notify GO about device changes">
       <incoming>SequenceFlow_11</incoming>
       <outgoing>SequenceFlow_12</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_12" sourceRef="Task_Notify_Device_Changes" targetRef="Task_GO_Notifies_MSP"/>
     <task id="Task_GO_Notifies_MSP" name="GO notifies MSP about device changes">
       <incoming>SequenceFlow_12</incoming>
       <outgoing>SequenceFlow_13</outgoing>
     </task>
     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_13</incoming>
     </endEvent>
   </process>
 </definitions>