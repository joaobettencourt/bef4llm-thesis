<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="ZooClub Membership Process" targetNamespace="http://example.com/ZooClubMembershipProcess">
   <process id="ZooClubMembershipProcess" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>
     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="ExclusiveGateway_1"/>
     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
       <outgoing>SequenceFlow_3</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_2" sourceRef="ExclusiveGateway_1" targetRef="Task_1">
       <conditionExpression xsi:type="tFormalExpression">${membershipType == 'individual'}</conditionExpression>
     </sequenceFlow>
     <task id="Task_1" name="Prepare Personal Information">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_4</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_4" sourceRef="Task_1" targetRef="Task_3"/>
     <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_1" targetRef="Task_2">
       <conditionExpression xsi:type="tFormalExpression">${membershipType == 'family'}</conditionExpression>
     </sequenceFlow>
     <task id="Task_2" name="Prepare Family Information">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_2" targetRef="Task_3"/>
     <task id="Task_3" name="Submit Information to ZooClub">
       <incoming>SequenceFlow_4</incoming>
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_3" targetRef="ServiceTask_1"/>
     <serviceTask id="ServiceTask_1" name="Introduce Data into System and Request Payment">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_7</outgoing>
       <outgoing>SequenceFlow_8</outgoing>
     </serviceTask>
     <sequenceFlow id="SequenceFlow_7" sourceRef="ServiceTask_1" targetRef="Task_4"/>
     <task id="Task_4" name="Forward Information to Marketing">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_4" targetRef="EndEvent_3"/>
     <sequenceFlow id="SequenceFlow_8" sourceRef="ServiceTask_1" targetRef="Task_5"/>
     <task id="Task_5" name="Send Payment Request to Billing">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_10</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_10" sourceRef="Task_5" targetRef="ServiceTask_2"/>
     <serviceTask id="ServiceTask_2" name="Send Payment Request to Bank">
       <incoming>SequenceFlow_10</incoming>
       <outgoing>SequenceFlow_11</outgoing>
     </serviceTask>
     <sequenceFlow id="SequenceFlow_11" sourceRef="ServiceTask_2" targetRef="Task_6"/>
     <task id="Task_6" name="Process Payment">
       <incoming>SequenceFlow_11</incoming>
       <outgoing>SequenceFlow_12</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_12" sourceRef="Task_6" targetRef="Task_7"/>
     <task id="Task_7" name="Print and Deliver Card">
       <incoming>SequenceFlow_12</incoming>
       <outgoing>SequenceFlow_13</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_13" sourceRef="Task_7" targetRef="EndEvent_1"/>
     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_13</incoming>
     </endEvent>
     <sequenceFlow id="SequenceFlow_14" sourceRef="ServiceTask_2" targetRef="Task_8"/>
     <task id="Task_8" name="Mail Magazine Request">
       <incoming>SequenceFlow_14</incoming>
       <outgoing>SequenceFlow_15</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_15" sourceRef="Task_8" targetRef="EndEvent_2"/>
     <endEvent id="EndEvent_2">
       <incoming>SequenceFlow_15</incoming>
     </endEvent>
     <endEvent id="EndEvent_3">
       <incoming>SequenceFlow_9</incoming>
     </endEvent>
   </process>
 </definitions>