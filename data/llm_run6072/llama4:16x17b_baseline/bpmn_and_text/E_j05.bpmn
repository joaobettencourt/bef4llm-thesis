<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL
                                 http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Work and Live in Austria" targetNamespace="http://example.com/bpmn">

   <process id="workAndLiveInAustriaProcess" isExecutable="true">
     <startEvent id="startEvent1" name="Start Process">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <!-- Organizing Accommodation and Bank Account  -->
     <task id="organizeAccommodationTask" name="Organize Accommodation and Bank Account">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </task>
     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="organizeAccommodationTask"/>

     <!-- Check Visa Requirements  -->
     <exclusiveGateway id="visaRequirementsGateway" name="Visa Requirements">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
       <outgoing>sequenceFlow4</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="sequenceFlow2" sourceRef="organizeAccommodationTask" targetRef="visaRequirementsGateway"/>

     <!-- Gather Documents for Visa Application  -->
     <task id="gatherDocumentsTask" name="Gather Documents for Visa Application">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow5</outgoing>
     </task>
     <sequenceFlow id="sequenceFlow3" sourceRef="visaRequirementsGateway" targetRef="gatherDocumentsTask"/>

     <!-- Apply for Visa  -->
     <serviceTask id="applyForVisaTask" name="Apply for Visa">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow6</outgoing>
     </serviceTask>
     <sequenceFlow id="sequenceFlow5" sourceRef="gatherDocumentsTask" targetRef="applyForVisaTask"/>

     <!-- Check Visa Application Status  -->
     <exclusiveGateway id="visaApplicationStatusGateway" name="Visa Application Status">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow7</outgoing>
       <outgoing>sequenceFlow8</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="sequenceFlow6" sourceRef="applyForVisaTask" targetRef="visaApplicationStatusGateway"/>

     <!-- Visa Approved  -->
     <endEvent id="visaApprovedEndEvent" name="Visa Approved">
       <incoming>sequenceFlow7</incoming>
     </endEvent>
     <sequenceFlow id="sequenceFlow7" sourceRef="visaApplicationStatusGateway" targetRef="visaApprovedEndEvent"/>

     <!-- Additional Requirements or Issues  -->
     <task id="additionalRequirementsTask" name="Address Additional Requirements or Issues">
       <incoming>sequenceFlow8</incoming>
       <outgoing>sequenceFlow9</outgoing>
     </task>
     <sequenceFlow id="sequenceFlow8" sourceRef="visaApplicationStatusGateway" targetRef="additionalRequirementsTask"/>

     <!-- Re-apply or Appeal  -->
     <exclusiveGateway id="reApplyOrAppealGateway" name="Re-apply or Appeal">
       <incoming>sequenceFlow9</incoming>
       <outgoing>sequenceFlow10</outgoing>
       <outgoing>sequenceFlow11</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="sequenceFlow9" sourceRef="additionalRequirementsTask" targetRef="reApplyOrAppealGateway"/>

     <!-- End Process  -->
     <endEvent id="processEndedEndEvent" name="Process Ended">
       <incoming>sequenceFlow10</incoming>
       <incoming>sequenceFlow11</incoming>
     </endEvent>
     <sequenceFlow id="sequenceFlow10" sourceRef="reApplyOrAppealGateway" targetRef="processEndedEndEvent"/>
     <sequenceFlow id="sequenceFlow11" sourceRef="reApplyOrAppealGateway" targetRef="processEndedEndEvent"/>

   </process>

</definitions>