<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL
                                 http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Storage Management" targetNamespace="http://example.com/storage-management">

   <process id="storageManagement" isExecutable="true">
     <startEvent id="readOrder" name="Read Order from System">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="readOrder" targetRef="checkProductAvailability"/>

     <task id="checkProductAvailability" name="Check Product Availability">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
       <outgoing>sequenceFlow3</outgoing>
     </task>

     <exclusiveGateway id="gateway1">
       <incoming>sequenceFlow2</incoming>
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow4</outgoing>
       <outgoing>sequenceFlow5</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow2" sourceRef="checkProductAvailability" targetRef="gateway1">
       <conditionExpression xsi:type="tFormalExpression">productInStock = true</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="sequenceFlow3" sourceRef="checkProductAvailability" targetRef="gateway1">
       <conditionExpression xsi:type="tFormalExpression">productInStock = false</conditionExpression>
     </sequenceFlow>

     <task id="withdrawFromWarehouse" name="Withdraw from Warehouse">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow6</outgoing>
     </task>

     <task id="reorderProduct" name="Reorder Product from Wholesaler">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow7</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow4" sourceRef="gateway1" targetRef="withdrawFromWarehouse"/>
     <sequenceFlow id="sequenceFlow5" sourceRef="gateway1" targetRef="reorderProduct"/>

     <task id="registerArrival" name="Register Product Arrival">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow8</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow7" sourceRef="reorderProduct" targetRef="registerArrival"/>
     <sequenceFlow id="sequenceFlow6" sourceRef="withdrawFromWarehouse" targetRef="checkOrderReady"/>

     <exclusiveGateway id="gateway2">
       <incoming>sequenceFlow8</incoming>
       <outgoing>sequenceFlow9</outgoing>
       <outgoing>sequenceFlow10</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow8" sourceRef="registerArrival" targetRef="gateway2"/>

     <task id="demandPenalty" name="Demand Delivery Delay Penalty">
       <incoming>sequenceFlow9</incoming>
     </task>

     <sequenceFlow id="sequenceFlow9" sourceRef="gateway2" targetRef="demandPenalty"/>

     <subProcess id="checkOrderReadySubprocess">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow10</outgoing>
     </subProcess>

     <sequenceFlow id="sequenceFlow10" sourceRef="checkOrderReadySubprocess" targetRef="requestCourier"/>

     <parallelGateway id="gateway3">
       <incoming>sequenceFlow10</incoming>
       <outgoing>sequenceFlow11</outgoing>
       <outgoing>sequenceFlow12</outgoing>
     </parallelGateway>

     <task id="requestCourier" name="Request Courier">
       <incoming>sequenceFlow10</incoming>
     </task>

     <task id="packProducts" name="Pack Products">
       <incoming>sequenceFlow11</incoming>
     </task>

     <task id="shipOrder" name="Ship Order">
       <incoming>sequenceFlow12</incoming>
     </task>

     <sequenceFlow id="sequenceFlow11" sourceRef="gateway3" targetRef="packProducts"/>
     <sequenceFlow id="sequenceFlow12" sourceRef="gateway3" targetRef="shipOrder"/>

     <endEvent id="orderShipped" name="Order Shipped">
       <incoming>sequenceFlow13</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow13" sourceRef="shipOrder" targetRef="orderShipped"/>
   </process>

</definitions>