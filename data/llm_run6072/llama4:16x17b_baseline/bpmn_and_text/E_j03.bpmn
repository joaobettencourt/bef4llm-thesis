<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL
                                 http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" name="Work Accident Process" targetNamespace="http://example.com/workaccident">

   <process id="workAccidentProcess" isExecutable="true">
     <startEvent id="startEvent1" name="Occurrence of Work Accident or Near Miss">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <task id="informEmployerTask" name="Inform Employer Immediately">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </task>

     <exclusiveGateway id="exclusiveGateway1Id" name="Type of Accident">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
       <outgoing>sequenceFlow4</outgoing>
     </exclusiveGateway>

     <task id="reportLabourInspectorateTask" name="Report to Labour Inspectorate (Fatality/Serious Injury)">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow5</outgoing>
     </task>

     <task id="reportAccidentInsuranceProviderTask" name="Report to Accident Insurance Provider">
       <incoming>sequenceFlow4</incoming>
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow6</outgoing>
     </task>

     <endEvent id="endEvent1" name="Reporting Completed">
       <incoming>sequenceFlow6</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="informEmployerTask"/>
     <sequenceFlow id="sequenceFlow2" sourceRef="informEmployerTask" targetRef="exclusiveGateway1Id"/>
     <sequenceFlow id="sequenceFlow3" name="Fatality or Serious Injury" sourceRef="exclusiveGateway1Id" targetRef="reportLabourInspectorateTask"/>
     <sequenceFlow id="sequenceFlow4" name="Other Cases" sourceRef="exclusiveGateway1Id" targetRef="reportAccidentInsuranceProviderTask"/>
     <sequenceFlow id="sequenceFlow5" sourceRef="reportLabourInspectorateTask" targetRef="reportAccidentInsuranceProviderTask"/>
     <sequenceFlow id="sequenceFlow6" sourceRef="reportAccidentInsuranceProviderTask" targetRef="endEvent1"/>

   </process>

</definitions>