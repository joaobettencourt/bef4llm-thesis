<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL
                                 http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Service for Your Fridge">

   <process id="fridgeServiceProcess" isExecutable="true">
     <startEvent id="startEvent1" name="Start Service Request">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <task id="describeSymptomsTask" name="Describe Symptoms and Send Request">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="describeSymptomsTask"/>
     <sequenceFlow id="sequenceFlow2" sourceRef="describeSymptomsTask" targetRef="selectServiceFacilityTask"/>

     <serviceTask id="selectServiceFacilityTask" name="Select Local Service Facility">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlow3" sourceRef="selectServiceFacilityTask" targetRef="makeAppointmentTask"/>

     <task id="makeAppointmentTask" name="Make Appointment">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow4</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow4" sourceRef="makeAppointmentTask" targetRef="performRepairSubProcess"/>

     <subProcess id="performRepairSubProcess" name="Perform Repair">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow5</outgoing>

       <startEvent id="repairStartEvent" name="Start Repair">
         <outgoing>sequenceFlow6</outgoing>
       </startEvent>

       <task id="arriveAndRepairTask" name="Arrive and Attempt to Repair">
         <incoming>sequenceFlow6</incoming>
         <outgoing>sequenceFlow7</outgoing>
         <outgoing>sequenceFlow8</outgoing>
       </task>

       <sequenceFlow id="sequenceFlow6" sourceRef="repairStartEvent" targetRef="arriveAndRepairTask"/>

       <exclusiveGateway id="gateway1">
         <incoming>sequenceFlow7</incoming>
         <outgoing>sequenceFlow9</outgoing>
         <outgoing>sequenceFlow10</outgoing>
       </exclusiveGateway>

       <sequenceFlow id="sequenceFlow7" sourceRef="arriveAndRepairTask" targetRef="gateway1"/>
       <sequenceFlow id="sequenceFlow8" sourceRef="arriveAndRepairTask" targetRef="needAdditionalPartsTask"/>

       <task id="needAdditionalPartsTask" name="Need Additional Parts">
         <incoming>sequenceFlow8</incoming>
         <outgoing>sequenceFlow11</outgoing>
       </task>

       <sequenceFlow id="sequenceFlow10" sourceRef="gateway1" targetRef="endRepairEvent"/>
       <sequenceFlow id="sequenceFlow9" sourceRef="gateway1" targetRef="needAdditionalPartsTask"/>

       <endEvent id="endRepairEvent" name="End Repair">
         <incoming>sequenceFlow11</incoming>
       </endEvent>

     </subProcess>

     <sequenceFlow id="sequenceFlow5" sourceRef="performRepairSubProcess" targetRef="confirmRepairTask"/>

     <task id="confirmRepairTask" name="Confirm Repair and Rate Service Facility">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow12</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow12" sourceRef="confirmRepairTask" targetRef="endEvent1"/>

     <endEvent id="endEvent1" name="End Process">
       <incoming>sequenceFlow12</incoming>
     </endEvent>

   </process>

</definitions>