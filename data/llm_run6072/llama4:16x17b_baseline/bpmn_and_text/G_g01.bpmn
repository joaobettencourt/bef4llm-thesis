<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL
                                 http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="LAN Party Process" targetNamespace="http://example.com/bpmn">

   <process id="lanPartyProcess" isExecutable="true">
     <startEvent id="startEvent1" name="Plan LAN Party">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <task id="sendInvitationsTask" name="Send Invitations to 10 Friends">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="sendInvitationsTask"/>

     <task id="getGamePreferencesTask" name="Collect Game Preferences">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow2" sourceRef="sendInvitationsTask" targetRef="getGamePreferencesTask"/>

     <subProcess id="dateSelectionSubProcess" name="Select Date for LAN Party">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow4</outgoing>

       <startEvent id="appointDateStartEvent" name="Appoint Date">
         <outgoing>sequenceFlow5</outgoing>
       </startEvent>

       <sequenceFlow id="sequenceFlow3" sourceRef="getGamePreferencesTask" targetRef="appointDateStartEvent"/>

       <task id="getConfirmedGuestsTask" name="Get Confirmed Guests">
         <incoming>sequenceFlow5</incoming>
         <outgoing>sequenceFlow6</outgoing>
       </task>

       <sequenceFlow id="sequenceFlow5" sourceRef="appointDateStartEvent" targetRef="getConfirmedGuestsTask"/>

       <exclusiveGateway id="checkGuestCountGateway" name="Check Guest Count">
         <incoming>sequenceFlow6</incoming>
         <outgoing>sequenceFlow7</outgoing>
         <outgoing>sequenceFlow8</outgoing>
       </exclusiveGateway>

       <sequenceFlow id="sequenceFlow6" sourceRef="getConfirmedGuestsTask" targetRef="checkGuestCountGateway"/>

       <sequenceFlow id="sequenceFlow7" sourceRef="checkGuestCountGateway" targetRef="prepareGamesAndBeerSubProcess">
         <conditionExpression xsi:type="tFormalExpression">8 or more guests confirmed</conditionExpression>
       </sequenceFlow>

       <sequenceFlow id="sequenceFlow8" sourceRef="checkGuestCountGateway" targetRef="appointDateStartEvent">
         <conditionExpression xsi:type="tFormalExpression">less than 8 guests confirmed</conditionExpression>
       </sequenceFlow>

     </subProcess>

     <sequenceFlow id="sequenceFlow4" sourceRef="dateSelectionSubProcess" targetRef="prepareGamesAndBeerSubProcess"/>

     <subProcess id="prepareGamesAndBeerSubProcess" name="Prepare Games and Beer">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow9</outgoing>

       <startEvent id="prepareStartEvent" name="Prepare for LAN Party">
         <outgoing>sequenceFlow10</outgoing>
       </startEvent>

       <sequenceFlow id="sequenceFlow9" sourceRef="dateSelectionSubProcess" targetRef="prepareStartEvent"/>

       <task id="getRequiredGamesTask" name="Collect Required Games">
         <incoming>sequenceFlow10</incoming>
         <outgoing>sequenceFlow11</outgoing>
       </task>

       <sequenceFlow id="sequenceFlow10" sourceRef="prepareStartEvent" targetRef="getRequiredGamesTask"/>

       <exclusiveGateway id="checkGameAvailabilityGateway" name="Check Game Availability">
         <incoming>sequenceFlow11</incoming>
         <outgoing>sequenceFlow12</outgoing>
         <outgoing>sequenceFlow13</outgoing>
       </exclusiveGateway>

       <sequenceFlow id="sequenceFlow11" sourceRef="getRequiredGamesTask" targetRef="checkGameAvailabilityGateway"/>

       <sequenceFlow id="sequenceFlow12" sourceRef="checkGameAvailabilityGateway" targetRef="estimateBeerRequirementsTask">
         <conditionExpression xsi:type="tFormalExpression">all games available</conditionExpression>
       </sequenceFlow>

       <sequenceFlow id="sequenceFlow13" sourceRef="checkGameAvailabilityGateway" targetRef="getRequiredGamesTask">
         <conditionExpression xsi:type="tFormalExpression">some games missing</conditionExpression>
       </sequenceFlow>

       <task id="estimateBeerRequirementsTask" name="Estimate Beer Requirements">
         <incoming>sequenceFlow12</incoming>
         <outgoing>sequenceFlow14</outgoing>
       </task>

       <sequenceFlow id="sequenceFlow14" sourceRef="estimateBeerRequirementsTask" targetRef="checkBeerAvailabilityGateway"/>

       <exclusiveGateway id="checkBeerAvailabilityGateway" name="Check Beer Availability">
         <incoming>sequenceFlow14</incoming>
         <outgoing>sequenceFlow15</outgoing>
         <outgoing>sequenceFlow16</outgoing>
       </exclusiveGateway>

       <sequenceFlow id="sequenceFlow15" sourceRef="checkBeerAvailabilityGateway" targetRef="enjoyLanPartyEndEvent">
         <conditionExpression xsi:type="tFormalExpression">enough beer available</conditionExpression>
       </sequenceFlow>

       <sequenceFlow id="sequenceFlow16" sourceRef="checkBeerAvailabilityGateway" targetRef="estimateBeerRequirementsTask">
         <conditionExpression xsi:type="tFormalExpression">not enough beer</conditionExpression>
       </sequenceFlow>

     </subProcess>

     <sequenceFlow id="sequenceFlow17" sourceRef="prepareGamesAndBeerSubProcess" targetRef="enjoyLanPartyEndEvent"/>

     <endEvent id="enjoyLanPartyEndEvent" name="Enjoy LAN Party">
       <incoming>sequenceFlow17</incoming>
     </endEvent>

   </process>

</definitions>