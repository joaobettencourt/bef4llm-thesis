<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL
                                 http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" name="Ordering in an Online Shop">

   <process id="orderingProcess" isExecutable="true">
     <startEvent id="loginStart" name="Login to E-Shop">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <exclusiveGateway id="loginCheck" name="Login Confirmation Check">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
       <outgoing>sequenceFlow3</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow1" sourceRef="loginStart" targetRef="loginCheck"/>
     <sequenceFlow id="sequenceFlow2" name="yes" sourceRef="loginCheck" targetRef="selectProduct"/>
     <sequenceFlow id="sequenceFlow3" name="no" sourceRef="loginCheck" targetRef="endEventLoginFailed"/>

     <task id="selectProductTask" name="Select Product">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow4</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow4" sourceRef="selectProductTask" targetRef="addProductToCart"/>

     <task id="addProductToCart" name="Add to Cart and Save">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow5</outgoing>
     </task>

     <exclusiveGateway id="checkProductsSelected" name="All Products Selected?">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow6</outgoing>
       <outgoing>sequenceFlow7</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow5" sourceRef="addProductToCart" targetRef="checkProductsSelected"/>
     <sequenceFlow id="sequenceFlow6" name="yes" sourceRef="checkProductsSelected" targetRef="prepareOrder"/>
     <sequenceFlow id="sequenceFlow7" name="no" sourceRef="checkProductsSelected" targetRef="selectProductTask"/>

     <task id="prepareOrderTask" name="Finish Order and Prepare Payment  & Shipment">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow8</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow8" sourceRef="prepareOrderTask" targetRef="enterPaymentDetails"/>

     <task id="enterPaymentDetails" name="Enter Payment Data">
       <incoming>sequenceFlow8</incoming>
       <outgoing>sequenceFlow9</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow9" sourceRef="enterPaymentDetails" targetRef="paymentConfirmationGateway"/>

     <exclusiveGateway id="paymentConfirmationGateway" name="Payment Confirmed?">
       <incoming>sequenceFlow9</incoming>
       <outgoing>sequenceFlow10</outgoing>
       <outgoing>sequenceFlow11</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow10" name="yes" sourceRef="paymentConfirmationGateway" targetRef="enterShippingAddressTask"/>
     <sequenceFlow id="sequenceFlow11" name="no" sourceRef="paymentConfirmationGateway" targetRef="endEventPaymentFailed"/>

     <task id="enterShippingAddressTask" name="Enter Shipping Address">
       <incoming>sequenceFlow10</incoming>
       <outgoing>sequenceFlow12</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow12" sourceRef="enterShippingAddressTask" targetRef="orderFinished"/>

     <endEvent id="orderFinished" name="Order Finished">
       <incoming>sequenceFlow12</incoming>
     </endEvent>

     <endEvent id="endEventLoginFailed" name="Login Failed  - Process Stopped">
       <incoming>sequenceFlow3</incoming>
     </endEvent>

     <endEvent id="endEventPaymentFailed" name="Payment Failed  - Order Not Finished">
       <incoming>sequenceFlow11</incoming>
     </endEvent>

   </process>

</definitions>