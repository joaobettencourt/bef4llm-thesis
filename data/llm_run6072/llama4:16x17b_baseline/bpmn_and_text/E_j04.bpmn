<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL
                                 http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" name="Internship Process" targetNamespace="http://example.com/internship">

   <process id="internshipProcess" isExecutable="true">
     <startEvent id="startEvent1" name="Start Internship Application">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <task id="enterApplicationDetailsTask" name="Enter Application Details">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="enterApplicationDetailsTask"/>
     <sequenceFlow id="sequenceFlow2" sourceRef="enterApplicationDetailsTask" targetRef="receiveOffersEvent"/>

     <intermediateCatchEvent id="receiveOffersEvent" name="Receive Offers">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
     </intermediateCatchEvent>

     <exclusiveGateway id="evaluateOfferGateway" name="Evaluate Offer">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow4</outgoing>
       <outgoing>sequenceFlow5</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow3" sourceRef="receiveOffersEvent" targetRef="evaluateOfferGateway"/>
     <sequenceFlow id="sequenceFlow4" name="Accept Offer" sourceRef="evaluateOfferGateway" targetRef="writeStatusUpdatesTask">
       <conditionExpression xsi:type="tFormalExpression">accepted = true</conditionExpression>
     </sequenceFlow>
     <sequenceFlow id="sequenceFlow5" name="Deny Offers" sourceRef="evaluateOfferGateway" targetRef="receiveOffersEvent">
       <conditionExpression xsi:type="tFormalExpression">denied = true</conditionExpression>
     </sequenceFlow>

     <task id="writeStatusUpdatesTask" name="Write Status Updates (Intern)">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow6</outgoing>
     </task>

     <subProcess id="statusUpdateSubprocess" name="Status Update Subprocess">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow7</outgoing>
     </subProcess>

     <sequenceFlow id="sequenceFlow6" sourceRef="writeStatusUpdatesTask" targetRef="statusUpdateSubprocess"/>
     <sequenceFlow id="sequenceFlow7" sourceRef="statusUpdateSubprocess" targetRef="companyWritesStatusUpdatesTask"/>

     <task id="companyWritesStatusUpdatesTask" name="Write Status Updates (Company)">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow8</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow8" sourceRef="companyWritesStatusUpdatesTask" targetRef="recommendCompanyTask"/>

     <task id="recommendCompanyTask" name="Recommend Company">
       <incoming>sequenceFlow8</incoming>
       <outgoing>sequenceFlow9</outgoing>
     </task>

     <parallelGateway id="sendTweetsGateway" name="Send Tweets">
       <incoming>sequenceFlow9</incoming>
       <outgoing>sequenceFlow10</outgoing>
       <outgoing>sequenceFlow11</outgoing>
       <outgoing>sequenceFlow12</outgoing>
     </parallelGateway>

     <sequenceFlow id="sequenceFlow9" sourceRef="recommendCompanyTask" targetRef="sendTweetsGateway"/>
     <sequenceFlow id="sequenceFlow10" name="Send Tweet 1" sourceRef="sendTweetsGateway" targetRef="endEvent1">
       <conditionExpression xsi:type="tFormalExpression">tweet1 = sent</conditionExpression>
     </sequenceFlow>
     <sequenceFlow id="sequenceFlow11" name="Send Tweet 2" sourceRef="sendTweetsGateway" targetRef="endEvent1">
       <conditionExpression xsi:type="tFormalExpression">tweet2 = sent</conditionExpression>
     </sequenceFlow>
     <sequenceFlow id="sequenceFlow12" name="Send Tweet 3" sourceRef="sendTweetsGateway" targetRef="endEvent1">
       <conditionExpression xsi:type="tFormalExpression">tweet3 = sent</conditionExpression>
     </sequenceFlow>

     <endEvent id="endEvent1" name="End Internship Process">
       <incoming>sequenceFlow10</incoming>
       <incoming>sequenceFlow11</incoming>
       <incoming>sequenceFlow12</incoming>
     </endEvent>

   </process>

</definitions>