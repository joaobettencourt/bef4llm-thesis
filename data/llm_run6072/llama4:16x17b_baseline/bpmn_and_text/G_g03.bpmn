<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL
                                 http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Blizzard Online Character Generator" targetNamespace="http://example.com/bpmn">

   <process id="blizzardCharacterGenerator" isExecutable="true">
     <startEvent id="startEvent1" name="Start Creating Character">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <exclusiveGateway id="gateway1" name="Has battle.net Account?">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
       <outgoing>sequenceFlow3</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="gateway1"/>

     <task id="createBattleNetAccountTask" name="Create battle.net Account">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow4</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow3" sourceRef="gateway1" targetRef="createBattleNetAccountTask"/>

     <task id="enterAccountInfoTask" name="Enter account information and confirm email">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow5</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow4" sourceRef="createBattleNetAccountTask" targetRef="enterAccountInfoTask"/>

     <exclusiveGateway id="gateway2" name="Has active WoW subscription?">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow6</outgoing>
       <outgoing>sequenceFlow7</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow5" sourceRef="enterAccountInfoTask" targetRef="gateway2"/>

     <task id="selectPaymentMethodTask" name="Select payment method">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow8</outgoing>
       <outgoing>sequenceFlow9</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow7" sourceRef="gateway2" targetRef="selectPaymentMethodTask"/>

     <exclusiveGateway id="gateway3" name="Select payment type">
       <incoming>sequenceFlow8</incoming>
       <outgoing>sequenceFlow10</outgoing>
       <outgoing>sequenceFlow11</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow8" sourceRef="selectPaymentMethodTask" targetRef="gateway3"/>

     <task id="enterCreditCardInfoTask" name="Enter credit card information">
       <incoming>sequenceFlow10</incoming>
       <outgoing>sequenceFlow12</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow10" sourceRef="gateway3" targetRef="enterCreditCardInfoTask"/>

     <task id="enterBankAccountInfoTask" name="Enter IBAN and BIC numbers">
       <incoming>sequenceFlow11</incoming>
       <outgoing>sequenceFlow12</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow11" sourceRef="gateway3" targetRef="enterBankAccountInfoTask"/>

     <task id="chooseCharacterOptionsTask" name="Log into game and select realm, race and class">
       <incoming>sequenceFlow12</incoming>
       <outgoing>sequenceFlow13</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow12" sourceRef="enterCreditCardInfoTask" targetRef="chooseCharacterOptionsTask"/>
     <sequenceFlow id="sequenceFlow9" sourceRef="selectPaymentMethodTask" targetRef="chooseCharacterOptionsTask"/>

     <task id="enterCharacterNameTask" name="Enter character name">
       <incoming>sequenceFlow13</incoming>
       <outgoing>sequenceFlow14</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow13" sourceRef="chooseCharacterOptionsTask" targetRef="enterCharacterNameTask"/>

     <endEvent id="endEvent1" name="Character created successfully">
       <incoming>sequenceFlow14</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow14" sourceRef="enterCharacterNameTask" targetRef="endEvent1"/>
   </process>
</definitions>