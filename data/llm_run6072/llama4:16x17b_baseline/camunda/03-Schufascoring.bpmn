<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" targetNamespace="http://www.example.com">

   <process id="SchufaScoringProcess" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>

     <task id="Task_1" name="Send scoring request to Schufa">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="IntermediateEvent_1"/>

     <intermediateEvent id="IntermediateEvent_1">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_4</outgoing>
     </intermediateEvent>

     <sequenceFlow id="SequenceFlow_3" sourceRef="IntermediateEvent_1" targetRef="Task_2"/>

     <task id="Task_2" name="Receive scoring result and forward to frontend">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_2" targetRef="EndEvent_1"/>

     <sequenceFlow id="SequenceFlow_4" sourceRef="IntermediateEvent_1" targetRef="Task_3"/>

     <task id="Task_3" name="Wait for delayed scoring result and notify sales staff">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_3" targetRef="IntermediateEvent_2"/>

     <intermediateEvent id="IntermediateEvent_2">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_7</outgoing>
     </intermediateEvent>

     <sequenceFlow id="SequenceFlow_7" sourceRef="IntermediateEvent_2" targetRef="Task_4"/>

     <task id="Task_4" name="Receive final scoring result and forward to frontend">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_8</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_8" sourceRef="Task_4" targetRef="EndEvent_1"/>

     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_5</incoming>
       <incoming>SequenceFlow_8</incoming>
     </endEvent>
   </process>

</definitions>