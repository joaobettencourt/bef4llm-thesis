<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" 
             targetNamespace="http://example.com/bpmn">

   <process id="invoiceProcess" isExecutable="true">
     <startEvent id="startEvent1">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="task1"/>

     <task id="task1" name="Try to locate Vendor in SAP system">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
       <outgoing>sequenceFlow3</outgoing>
     </task>

     <exclusiveGateway id="exclusiveGateway1">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow4</outgoing>
       <outgoing>sequenceFlow5</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow2" sourceRef="task1" targetRef="exclusiveGateway1"/>
     <sequenceFlow id="sequenceFlow3" sourceRef="task1" targetRef="subProcess1"/>

     <subProcess id="subProcess1" name="Record new Vendor">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow6</outgoing>

       <startEvent id="startSubProcess1">
         <outgoing>sequenceFlow7</outgoing>
       </startEvent>

       <sequenceFlow id="sequenceFlow7" sourceRef="startSubProcess1" targetRef="task2"/>

       <task id="task2" name="Fill new Vendor Master Record form">
         <incoming>sequenceFlow7</incoming>
         <outgoing>sequenceFlow8</outgoing>
       </task>

       <sequenceFlow id="sequenceFlow8" sourceRef="task2" targetRef="task3"/>

       <task id="task3" name="Attach request to invoice and put in internal outbox">
         <incoming>sequenceFlow8</incoming>
         <outgoing>sequenceFlow9</outgoing>
       </task>

       <exclusiveGateway id="exclusiveGateway2">
         <incoming>sequenceFlow9</incoming>
         <outgoing>sequenceFlow10</outgoing>
         <outgoing>sequenceFlow11</outgoing>
       </exclusiveGateway>

       <sequenceFlow id="sequenceFlow9" sourceRef="task3" targetRef="exclusiveGateway2"/>
       <sequenceFlow id="sequenceFlow10" sourceRef="exclusiveGateway2" targetRef="endSubProcess1"/>
       <sequenceFlow id="sequenceFlow11" sourceRef="exclusiveGateway2" targetRef="endSubProcess1"/>

       <endEvent id="endSubProcess1">
         <incoming>sequenceFlow10</incoming>
         <incoming>sequenceFlow11</incoming>
         <outgoing>sequenceFlow6</outgoing>
       </endEvent>

       <sequenceFlow id="sequenceFlow6" sourceRef="endSubProcess1" targetRef="exclusiveGateway1"/>
     </subProcess>

     <sequenceFlow id="sequenceFlow4" sourceRef="exclusiveGateway1" targetRef="task4"/>
     <sequenceFlow id="sequenceFlow5" sourceRef="exclusiveGateway1" targetRef="task4"/>

     <task id="task4" name="Add SAP number to invoice">
       <incoming>sequenceFlow4</incoming>
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow12</outgoing>
     </task>

     <exclusiveGateway id="exclusiveGateway3">
       <incoming>sequenceFlow12</incoming>
       <outgoing>sequenceFlow13</outgoing>
       <outgoing>sequenceFlow14</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow12" sourceRef="task4" targetRef="exclusiveGateway3"/>
     <sequenceFlow id="sequenceFlow13" sourceRef="exclusiveGateway3" targetRef="task5"/>
     <sequenceFlow id="sequenceFlow14" sourceRef="exclusiveGateway3" targetRef="task6"/>

     <task id="task5" name="Sort invoices by amount">
       <incoming>sequenceFlow13</incoming>
       <outgoing>sequenceFlow15</outgoing>
     </task>

     <task id="task6" name="Sort invoices by vendor">
       <incoming>sequenceFlow14</incoming>
       <outgoing>sequenceFlow16</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow15" sourceRef="task5" targetRef="task7"/>
     <sequenceFlow id="sequenceFlow16" sourceRef="task6" targetRef="task7"/>

     <task id="task7" name="Enter invoices in SAP system">
       <incoming>sequenceFlow15</incoming>
       <incoming>sequenceFlow16</incoming>
       <outgoing>sequenceFlow17</outgoing>
     </task>

     <endEvent id="endEvent1">
       <incoming>sequenceFlow17</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow17" sourceRef="task7" targetRef="endEvent1"/>
   </process>
 </definitions>