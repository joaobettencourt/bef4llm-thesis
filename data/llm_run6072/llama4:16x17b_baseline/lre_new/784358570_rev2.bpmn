<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
                  id="definitions" name="Review Order Process">

  <bpmn:process id="reviewOrderProcess" isExecutable="true">
    <bpmn:startEvent id="startEvent1">
      <bpmn:outgoing>sequenceFlow1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="taskReviewOrder"/>

    <bpmn:userTask id="taskReviewOrder" name="Review Order">
      <bpmn:incoming>sequenceFlow1</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow2</bpmn:outgoing>
      <bpmn:outgoing>sequenceFlow3</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="exclusiveGateway1">
      <bpmn:incoming>sequenceFlow2</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow4</bpmn:outgoing>
      <bpmn:outgoing>sequenceFlow5</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="sequenceFlow2" sourceRef="taskReviewOrder" targetRef="exclusiveGateway1">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${availableItems == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="sequenceFlow3" sourceRef="taskReviewOrder" targetRef="endEventInformCustomerAboutDelay">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${not availableItems}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:userTask id="taskInformCustomerAboutDelay" name="Inform Customer about Delay and Order Missing Products">
      <bpmn:incoming>sequenceFlow5</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow6</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:sequenceFlow id="sequenceFlow5" sourceRef="exclusiveGateway1" targetRef="taskInformCustomerAboutDelay">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${missingItems}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:userTask id="taskWaitForDelivery" name="Wait for Delivery of Missing Products">
      <bpmn:incoming>sequenceFlow4</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow7</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:sequenceFlow id="sequenceFlow4" sourceRef="exclusiveGateway1" targetRef="taskWaitForDelivery"/>

    <bpmn:exclusiveGateway id="exclusiveGateway2">
      <bpmn:incoming>sequenceFlow7</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow8</bpmn:outgoing>
      <bpmn:outgoing>sequenceFlow9</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="sequenceFlow7" sourceRef="taskWaitForDelivery" targetRef="exclusiveGateway2">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${allItemsAvailable}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:userTask id="taskRecollectProducts" name="Recollect Products and Prepare Package">
      <bpmn:incoming>sequenceFlow8</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow10</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:sequenceFlow id="sequenceFlow8" sourceRef="exclusiveGateway2" targetRef="taskRecollectProducts"/>

    <bpmn:serviceTask id="taskInformCourier" name="Inform Courier about Pre-processed Package">
      <bpmn:incoming>sequenceFlow10</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow11</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="sequenceFlow10" sourceRef="taskRecollectProducts" targetRef="taskInformCourier"/>

    <bpmn:userTask id="taskPickUpPackage" name="Pick up Package by Driver">
      <bpmn:incoming>sequenceFlow11</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow12</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:sequenceFlow id="sequenceFlow11" sourceRef="taskInformCourier" targetRef="taskPickUpPackage"/>

    <bpmn:serviceTask id="taskCentralizedServiceDecidesBestRoute" name="Centralized Service Decides Best Route">
      <bpmn:incoming>sequenceFlow12</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow13</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="sequenceFlow12" sourceRef="taskPickUpPackage" targetRef="taskCentralizedServiceDecidesBestRoute"/>

    <bpmn:userTask id="taskUpdateSystemAfterDelivery" name="Update System after Delivery">
      <bpmn:incoming>sequenceFlow13</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow14</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:sequenceFlow id="sequenceFlow13" sourceRef="taskCentralizedServiceDecidesBestRoute" targetRef="taskUpdateSystemAfterDelivery"/>

    <bpmn:endEvent id="endEventProcessCompleted" name="Process Completed">
      <bpmn:incoming>sequenceFlow14</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="sequenceFlow14" sourceRef="taskUpdateSystemAfterDelivery" targetRef="endEventProcessCompleted"/>

    <bpmn:endEvent id="endEventInformCustomerAboutDelay" name="Inform Customer about Delay">
      <bpmn:incoming>sequenceFlow3</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>