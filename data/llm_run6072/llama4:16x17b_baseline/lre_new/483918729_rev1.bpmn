<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
                  id="definitions" name="Provision Process">

  <bpmn:process id="provisionProcess" isExecutable="true">
    <bpmn:startEvent id="startEvent1">
      <bpmn:outgoing>sequenceFlow1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="taskIdentifyParts"/>

    <bpmn:userTask id="taskIdentifyParts" name="Identify necessary parts">
      <bpmn:incoming>sequenceFlow1</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow2</bpmn:outgoing>
      <bpmn:outgoing>sequenceFlow3</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:sequenceFlow id="sequenceFlow2" sourceRef="taskIdentifyParts" targetRef="exclusiveGateway1"/>

    <bpmn:sequenceFlow id="sequenceFlow3" sourceRef="taskIdentifyParts" targetRef="taskCheckAvailability"/>

    <bpmn:exclusiveGateway id="exclusiveGateway1">
      <bpmn:incoming>sequenceFlow2</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow4</bpmn:outgoing>
      <bpmn:outgoing>sequenceFlow5</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="sequenceFlow4" sourceRef="exclusiveGateway1" targetRef="taskRequestMoreInformation"/>

    <bpmn:sequenceFlow id="sequenceFlow5" sourceRef="exclusiveGateway1" targetRef="taskCheckAvailability"/>

    <bpmn:userTask id="taskRequestMoreInformation" name="Request more information from customer">
      <bpmn:incoming>sequenceFlow4</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow6</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:sequenceFlow id="sequenceFlow6" sourceRef="taskRequestMoreInformation" targetRef="taskIdentifyParts"/>

    <bpmn:userTask id="taskCheckAvailability" name="Check parts availability">
      <bpmn:incoming>sequenceFlow3</bpmn:incoming>
      <bpmn:incoming>sequenceFlow5</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow7</bpmn:outgoing>
      <bpmn:outgoing>sequenceFlow8</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="exclusiveGateway2">
      <bpmn:incoming>sequenceFlow7</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow9</bpmn:outgoing>
      <bpmn:outgoing>sequenceFlow10</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="sequenceFlow7" sourceRef="taskCheckAvailability" targetRef="exclusiveGateway2"/>

    <bpmn:sequenceFlow id="sequenceFlow8" sourceRef="taskCheckAvailability" targetRef="serviceTaskOrderParts"/>

    <bpmn:sequenceFlow id="sequenceFlow9" sourceRef="exclusiveGateway2" targetRef="endEventSupplyParts"/>

    <bpmn:sequenceFlow id="sequenceFlow10" sourceRef="exclusiveGateway2" targetRef="serviceTaskOrderParts"/>

    <bpmn:endEvent id="endEventSupplyParts" name="Parts supplied to customer">
      <bpmn:incoming>sequenceFlow9</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:serviceTask id="serviceTaskOrderParts" name="Order parts and notify customer">
      <bpmn:incoming>sequenceFlow8</bpmn:incoming>
      <bpmn:incoming>sequenceFlow10</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow11</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="taskCollectPayment" name="Collect final payment from customer">
      <bpmn:incoming>sequenceFlow11</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow12</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:sequenceFlow id="sequenceFlow11" sourceRef="serviceTaskOrderParts" targetRef="taskCollectPayment"/>

    <bpmn:endEvent id="endEventProcessCompleted" name="Process completed">
      <bpmn:incoming>sequenceFlow12</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="sequenceFlow12" sourceRef="taskCollectPayment" targetRef="endEventProcessCompleted"/>
  </bpmn:process>
</bpmn:definitions>