<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
                 id="definitions" name="Reimbursement Process">

  <bpmn:process id="reimbursementProcess" isExecutable="true">
    <bpmn:startEvent id="startEvent1">
      <bpmn:outgoing>sequenceFlow1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="createReimbursementContactTask" name="Create Reimbursement Contact">
      <bpmn:incoming>sequenceFlow1</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="createReimbursementContactTask"/>

    <bpmn:task id="chooseBeneficiaryTask" name="Choose Beneficiary">
      <bpmn:incoming>sequenceFlow2</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow3</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="sequenceFlow2" sourceRef="createReimbursementContactTask" targetRef="chooseBeneficiaryTask"/>

    <bpmn:task id="determineRefundPeriodTask" name="Determine Refund Period">
      <bpmn:incoming>sequenceFlow3</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow4</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="sequenceFlow3" sourceRef="chooseBeneficiaryTask" targetRef="determineRefundPeriodTask"/>

    <bpmn:exclusiveGateway id="exclusiveGateway1">
      <bpmn:incoming>sequenceFlow4</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow5</bpmn:outgoing>
      <bpmn:outgoing>sequenceFlow6</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="sequenceFlow4" sourceRef="determineRefundPeriodTask" targetRef="exclusiveGateway1"/>

    <bpmn:task id="selectCustomerGroupAssociationTask" name="Select Customer Group Association">
      <bpmn:incoming>sequenceFlow5</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow7</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="sequenceFlow5" sourceRef="exclusiveGateway1" targetRef="selectCustomerGroupAssociationTask">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${isPartOfVerband()}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:task id="selectCustomersManuallyTask" name="Select Customers Manually">
      <bpmn:incoming>sequenceFlow6</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow8</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="sequenceFlow6" sourceRef="exclusiveGateway1" targetRef="selectCustomersManuallyTask">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${!isPartOfVerband()}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:task id="setThresholdTask" name="Set Threshold">
      <bpmn:incoming>sequenceFlow7</bpmn:incoming>
      <bpmn:incoming>sequenceFlow8</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow9</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="sequenceFlow7" sourceRef="selectCustomerGroupAssociationTask" targetRef="setThresholdTask"/>
    <bpmn:sequenceFlow id="sequenceFlow8" sourceRef="selectCustomersManuallyTask" targetRef="setThresholdTask"/>

    <bpmn:task id="printAndSendCreditNoteTask" name="Print and Send Credit Note">
      <bpmn:incoming>sequenceFlow9</bpmn:incoming>
    </bpmn:task>

    <bpmn:task id="calculateAndPayReimbursementTask" name="Calculate and Pay Reimbursement">
      <bpmn:incoming>sequenceFlow9</bpmn:incoming>
    </bpmn:task>

    <bpmn:endEvent id="endEvent1">
      <bpmn:incoming>sequenceFlow10</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="sequenceFlow9" sourceRef="setThresholdTask" targetRef="printAndSendCreditNoteTask"/>
    <bpmn:sequenceFlow id="sequenceFlow10" sourceRef="printAndSendCreditNoteTask" targetRef="endEvent1"/>

  </bpmn:process>
</bpmn:definitions>