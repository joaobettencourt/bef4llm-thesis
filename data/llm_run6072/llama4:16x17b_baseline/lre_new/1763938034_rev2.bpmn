<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Reward and Training Process">

  <process id="rewardAndTrainingProcess" isExecutable="true">
    <startEvent id="startEvent1">
      <outgoing>sequenceFlow1</outgoing>
    </startEvent>

    <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="exclusiveGateway1"/>

    <exclusiveGateway id="exclusiveGateway1">
      <incoming>sequenceFlow1</incoming>
      <outgoing>sequenceFlow2</outgoing>
      <outgoing>sequenceFlow3</outgoing>
      <outgoing>sequenceFlow4</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequenceFlow2" name="performance &lt; 20%" sourceRef="exclusiveGateway1" targetRef="task1">
      <conditionExpression xsi:type="tFormalExpression">${performance <= 20}</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="sequenceFlow3" name="20% &lt;= performance &lt; 50%" sourceRef="exclusiveGateway1" targetRef="task2">
      <conditionExpression xsi:type="tFormalExpression">${performance >= 20 and performance < 50}</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="sequenceFlow4" name="performance > 75%" sourceRef="exclusiveGateway1" targetRef="exclusiveGateway2">
      <conditionExpression xsi:type="tFormalExpression">${performance > 75}</conditionExpression>
    </sequenceFlow>

    <task id="task1" name="Suggest dismissal to HR">
      <incoming>sequenceFlow2</incoming>
      <outgoing>sequenceFlow5</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow5" sourceRef="task1" targetRef="task3"/>

    <task id="task3" name="Dismiss employee">
      <incoming>sequenceFlow5</incoming>
      <outgoing>sequenceFlow6</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow6" sourceRef="task3" targetRef="endEvent1"/>

    <task id="task2" name="Suggest training to HR">
      <incoming>sequenceFlow3</incoming>
      <outgoing>sequenceFlow7</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow7" sourceRef="task2" targetRef="task4"/>

    <task id="task4" name="Provide training">
      <incoming>sequenceFlow7</incoming>
      <outgoing>sequenceFlow8</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow8" sourceRef="task4" targetRef="endEvent1"/>

    <exclusiveGateway id="exclusiveGateway2">
      <incoming>sequenceFlow4</incoming>
      <outgoing>sequenceFlow9</outgoing>
      <outgoing>sequenceFlow10</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequenceFlow9" name="financial reward" sourceRef="exclusiveGateway2" targetRef="task5">
      <conditionExpression xsi:type="tFormalExpression">${rewardType == 'financial'}</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="sequenceFlow10" name="other benefit" sourceRef="exclusiveGateway2" targetRef="task6">
      <conditionExpression xsi:type="tFormalExpression">${rewardType != 'financial'}</conditionExpression>
    </sequenceFlow>

    <task id="task5" name="Calculate and pay financial reward">
      <incoming>sequenceFlow9</incoming>
      <outgoing>sequenceFlow11</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow11" sourceRef="task5" targetRef="task7"/>

    <task id="task6" name="Choose appropriate benefit">
      <incoming>sequenceFlow10</incoming>
      <outgoing>sequenceFlow12</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow12" sourceRef="task6" targetRef="task7"/>

    <task id="task7" name="Announce rewarded employee as employee of the month">
      <incoming>sequenceFlow11</incoming>
      <incoming>sequenceFlow12</incoming>
      <outgoing>sequenceFlow13</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow13" sourceRef="task7" targetRef="endEvent1"/>

    <endEvent id="endEvent1">
      <incoming>sequenceFlow6</incoming>
      <incoming>sequenceFlow8</incoming>
      <incoming>sequenceFlow13</incoming>
    </endEvent>

  </process>

</definitions>