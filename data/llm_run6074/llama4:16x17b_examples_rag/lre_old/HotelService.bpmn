<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com/bpmn">
  <process id="roomServiceProcess" isExecutable="true">
    <startEvent id="orderReceived">
      <outgoing>prepareOrder</outgoing>
    </startEvent>
    <sequenceFlow id="prepareOrder" sourceRef="orderReceived" targetRef="taskOrderManager"/>
    <userTask id="taskOrderManager" name="Take down order details">
      <incoming>prepareOrder</incoming>
      <outgoing>getWineAndBeverages</outgoing>
      <outgoing>sendToKitchen</outgoing>
    </userTask>
    <sequenceFlow id="getWineAndBeverages" sourceRef="taskOrderManager" targetRef="taskSommelier"/>
    <serviceTask id="taskSommelier" name="Fetch wine and prepare beverages">
      <incoming>getWineAndBeverages</incoming>
      <outgoing>sommelierDone</outgoing>
    </serviceTask>
    <sequenceFlow id="sommelierDone" sourceRef="taskSommelier" targetRef="exclusiveGateway"/>
    <sequenceFlow id="sendToKitchen" sourceRef="taskOrderManager" targetRef="taskKitchen"/>
    <userTask id="taskKitchen" name="Prepare food">
      <incoming>sendToKitchen</incoming>
      <outgoing>kitchenDone</outgoing>
    </userTask>
    <sequenceFlow id="kitchenDone" sourceRef="taskKitchen" targetRef="exclusiveGateway"/>
    <exclusiveGateway id="exclusiveGateway">
      <incoming>sommelierDone</incoming>
      <incoming>kitchenDone</incoming>
      <outgoing>assignWaiter</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="assignWaiter" sourceRef="exclusiveGateway" targetRef="taskAssignWaiter"/>
    <userTask id="taskAssignWaiter" name="Assign order to waiter">
      <incoming>assignWaiter</incoming>
      <outgoing>waiterReadyCart</outgoing>
    </userTask>
    <sequenceFlow id="waiterReadyCart" sourceRef="taskAssignWaiter" targetRef="taskWaiter"/>
    <userTask id="taskWaiter" name="Ready cart (tablecloth, silverware)">
      <incoming>waiterReadyCart</incoming>
      <outgoing>cartReady</outgoing>
    </userTask>
    <sequenceFlow id="cartReady" sourceRef="taskWaiter" targetRef="parallelGateway"/>
    <parallelGateway id="parallelGateway">
      <incoming>cartReady</incoming>
      <outgoing>deliverToGuest</outgoing>
      <outgoing>prepareNonAlcoholicDrinks</outgoing>
    </parallelGateway>
    <sequenceFlow id="prepareNonAlcoholicDrinks" sourceRef="parallelGateway" targetRef="taskPrepareNonAlcoholicDrinks"/>
    <userTask id="taskPrepareNonAlcoholicDrinks" name="Prepare non-alcoholic drinks">
      <incoming>prepareNonAlcoholicDrinks</incoming>
    </userTask>
    <sequenceFlow id="deliverToGuest" sourceRef="parallelGateway" targetRef="taskDeliverToGuest"/>
    <userTask id="taskDeliverToGuest" name="Deliver to guest's room and debit account">
      <incoming>deliverToGuest</incoming>
      <outgoing>orderDelivered</outgoing>
    </userTask>
    <sequenceFlow id="orderDelivered" sourceRef="taskDeliverToGuest" targetRef="endEvent"/>
    <endEvent id="endEvent">
      <incoming>orderDelivered</incoming>
    </endEvent>
  </process>
</definitions>