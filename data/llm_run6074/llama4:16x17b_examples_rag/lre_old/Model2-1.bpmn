<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                 xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                 xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                 xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_0">
    <bpmn:participant id="Participant_0" name="Customer Service" processRef="Process_1"/>
    <bpmn:participant id="Participant_1" name="Customer" processRef="Process_2"/>
    <bpmn:participant id="Participant_2" name="Service Management" processRef="Process_3"/>
    <bpmn:participant id="Participant_3" name="Resource Provisioning" processRef="Process_4"/>
  </bpmn:collaboration>
  
  <!-- Customer Service Process -->
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_0" name="Customer Service">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_1</bpmn:flowNodeRef>
        <!-- Add other flow nodes here -->
      </bpmn:lane>
    </bpmn:laneSet>
    
    <bpmn:startEvent id="StartEvent_1" name="Service Degradation Noticed">
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>
    
    <bpmn:task id="Task_1" name="Send Problem Report to TELECO">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Add other process elements here -->
  </bpmn:process>
  
  <!-- Customer Process -->
  <bpmn:process id="Process_2" isExecutable="false">
    <!-- Add process elements here -->
  </bpmn:process>
  
  <!-- Service Management Process -->
  <bpmn:process id="Process_3" isExecutable="false">
    <!-- Add process elements here -->
  </bpmn:process>
  
  <!-- Resource Provisioning Process -->
  <bpmn:process id="Process_4" isExecutable="false">
    <!-- Add process elements here -->
  </bpmn:process>
</bpmn:definitions>