<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://bpmn.io/schema/bpmn">

  <process id="filePreparationProcess" isExecutable="true">
    <laneSet>
      <lane id="courtStaffLane" name="Court Staff">
        <flowNodeRef>startEvent</flowNodeRef>
        <flowNodeRef>task_CheckFiles</flowNodeRef>
        <flowNodeRef>inclusiveGateway_FileReady</flowNodeRef>
        <flowNodeRef>task_SearchFiles</flowNodeRef>
        <flowNodeRef>task_TrackFiles</flowNodeRef>
      </lane>
      <lane id="associateLane" name="Associate">
        <flowNodeRef>task_HandOverFiles</flowNodeRef>
      </lane>
    </laneSet>

    <startEvent id="startEvent" name="Morning Check">
      <outgoing>sequenceFlow_1</outgoing>
    </startEvent>

    <task id="task_CheckFiles" name="Check Files">
      <incoming>sequenceFlow_1</incoming>
      <outgoing>sequenceFlow_2</outgoing>
    </task>

    <inclusiveGateway id="inclusiveGateway_FileReady">
      <incoming>sequenceFlow_2</incoming>
      <outgoing>sequenceFlow_3</outgoing>
      <outgoing>sequenceFlow_4</outgoing>
    </inclusiveGateway>

    <task id="task_SearchFiles" name="Search for Missing Files">
      <incoming>sequenceFlow_4</incoming>
      <outgoing>sequenceFlow_5</outgoing>
    </task>

    <task id="task_TrackFiles" name="Track Files to Location">
      <incoming>sequenceFlow_3</incoming>
      <outgoing>sequenceFlow_6</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow_1" sourceRef="startEvent" targetRef="task_CheckFiles"/>
    <sequenceFlow id="sequenceFlow_2" sourceRef="task_CheckFiles" targetRef="inclusiveGateway_FileReady"/>
    <sequenceFlow id="sequenceFlow_3" name="Files Ready" sourceRef="inclusiveGateway_FileReady" targetRef="task_TrackFiles"/>
    <sequenceFlow id="sequenceFlow_4" name="Missing Files" sourceRef="inclusiveGateway_FileReady" targetRef="task_SearchFiles"/>
    <sequenceFlow id="sequenceFlow_5" sourceRef="task_SearchFiles" targetRef="inclusiveGateway_FileReady"/>

    <task id="task_HandOverFiles" name="Hand over Files to Associate">
      <incoming>sequenceFlow_6</incoming>
      <outgoing>sequenceFlow_7</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow_6" sourceRef="task_TrackFiles" targetRef="task_HandOverFiles"/>

    <endEvent id="endEvent">
      <incoming>sequenceFlow_7</incoming>
    </endEvent>

    <sequenceFlow id="sequenceFlow_7" sourceRef="task_HandOverFiles" targetRef="endEvent"/>
  </process>
</definitions>