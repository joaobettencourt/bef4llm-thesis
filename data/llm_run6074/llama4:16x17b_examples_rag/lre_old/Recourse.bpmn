<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <collaboration id="Collaboration_1">
    <participant id="Participant_0" name="Subrogation Handling" processRef="Pool_0"/>
  </collaboration>
  <process id="Pool_0" isExecutable="false">
    <laneSet>
      <lane id="Lane_0" name="Handler">
        <flowNodeRef>StartNoneEvent_0</flowNodeRef>
        <flowNodeRef>Task_GetInfo</flowNodeRef>
        <flowNodeRef>ExclusiveGateway_SubrogationPossible</flowNodeRef>
        <flowNodeRef>Task_SendRequest_1</flowNodeRef>
        <flowNodeRef>Task_CreateReminder_2</flowNodeRef>
        <flowNodeRef>Task_CloseCase_3</flowNodeRef>
        <flowNodeRef>ExclusiveGateway_Disagreement_4</flowNodeRef>
        <flowNodeRef>Task_CheckDisagreementReasoning_5</flowNodeRef>
        <flowNodeRef>ExclusiveGateway_ForwardCollectionAgency_6</flowNodeRef>
        <flowNodeRef>EndNoneEvent_7</flowNodeRef>
        <flowNodeRef>TimerEvent_DeadlineReached_8</flowNodeRef>
        <flowNodeRef>Task_MakeBooking_9</flowNodeRef>
      </lane>
    </laneSet>

    <!-- Sequence Flows  -->
    <sequenceFlow id="SequenceFlow_GetInfo" sourceRef="StartNoneEvent_0" targetRef="Task_GetInfo"/>
    <sequenceFlow id="SequenceFlow_SubrogationPossible" sourceRef="Task_GetInfo" targetRef="ExclusiveGateway_SubrogationPossible"/>
    <sequenceFlow id="SequenceFlow_SendRequest" sourceRef="ExclusiveGateway_SubrogationPossible" targetRef="Task_SendRequest_1"/>
    <sequenceFlow id="SequenceFlow_CreateReminder" sourceRef="Task_SendRequest_1" targetRef="Task_CreateReminder_2"/>
    <sequenceFlow id="SequenceFlow_MakeBooking" sourceRef="Task_CreateReminder_2" targetRef="Task_MakeBooking_9"/>
    <sequenceFlow id="SequenceFlow_CloseCaseAfterPayment" sourceRef="Task_MakeBooking_9" targetRef="Task_CloseCase_3"/>
    <sequenceFlow id="SequenceFlow_Disagreement" sourceRef="Task_CreateReminder_2" targetRef="ExclusiveGateway_Disagreement_4"/>
    <sequenceFlow id="SequenceFlow_CheckDisagreementReasoning" sourceRef="ExclusiveGateway_Disagreement_4" targetRef="Task_CheckDisagreementReasoning_5"/>
    <sequenceFlow id="SequenceFlow_ForwardCollectionAgencyAfterDeadline" sourceRef="TimerEvent_DeadlineReached_8" targetRef="ExclusiveGateway_ForwardCollectionAgency_6"/>
    <sequenceFlow id="SequenceFlow_CloseCaseNoSubrogation" sourceRef="ExclusiveGateway_SubrogationPossible" targetRef="Task_CloseCase_3"/>

    <!-- Tasks  -->
    <task id="Task_GetInfo" name="Get Information about Possible Subrogation">
      <incoming>SequenceFlow_GetInfo</incoming>
      <outgoing>SequenceFlow_SubrogationPossible</outgoing>
    </task>

    <task id="Task_SendRequest_1" name="Send Request for Payment">
      <incoming>SequenceFlow_SendRequest</incoming>
      <outgoing>SequenceFlow_CreateReminder</outgoing>
    </task>

    <task id="Task_CreateReminder_2" name="Create Reminder">
      <incoming>SequenceFlow_CreateReminder</incoming>
      <outgoing>SequenceFlow_MakeBooking</outgoing>
      <outgoing>SequenceFlow_Disagreement</outgoing>
    </task>

    <task id="Task_MakeBooking_9" name="Make Booking">
      <incoming>SequenceFlow_MakeBooking</incoming>
      <outgoing>SequenceFlow_CloseCaseAfterPayment</outgoing>
    </task>

    <task id="Task_CloseCase_3" name="Close Case">
      <incoming>SequenceFlow_CloseCaseAfterPayment</incoming>
      <incoming>SequenceFlow_CloseCaseNoSubrogation</incoming>
    </task>

    <!-- Gateways  -->
    <exclusiveGateway id="ExclusiveGateway_SubrogationPossible" name="Is Subrogation Possible?">
      <incoming>SequenceFlow_SubrogationPossible</incoming>
      <outgoing>SequenceFlow_SendRequest</outgoing>
      <outgoing>SequenceFlow_CloseCaseNoSubrogation</outgoing>
    </exclusiveGateway>

    <exclusiveGateway id="ExclusiveGateway_Disagreement_4" name="Is Disagreement Valid?">
      <incoming>SequenceFlow_Disagreement</incoming>
      <outgoing>SequenceFlow_CheckDisagreementReasoning</outgoing>
      <outgoing>SequenceFlow_ForwardCollectionAgencyAfterDeadline</outgoing>
    </exclusiveGateway>

    <exclusiveGateway id="ExclusiveGateway_ForwardCollectionAgency_6" name="Forward to Collection Agency?">
      <incoming>SequenceFlow_ForwardCollectionAgencyAfterDeadline</incoming>
      <outgoing></outgoing>
    </exclusiveGateway>

    <!-- Events  -->
    <startEvent id="StartNoneEvent_0" name="Start Subrogation Handling">
      <outgoing>SequenceFlow_GetInfo</outgoing>
    </startEvent>

    <endEvent id="EndNoneEvent_7" name="Close Case">
      <incoming></incoming>
    </endEvent>

    <intermediateCatchEvent id="TimerEvent_DeadlineReached_8">
      <outgoing>SequenceFlow_ForwardCollectionAgencyAfterDeadline</outgoing>
    </intermediateCatchEvent>

  </process>
</definitions>