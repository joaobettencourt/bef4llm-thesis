<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com/bpmn">
  <process id="process" isExecutable="true">
    <startEvent id="start-event">
      <outgoing>sequence-flow-1</outgoing>
    </startEvent>
    <sequenceFlow id="sequence-flow-1" sourceRef="start-event" targetRef="task-1"/>
    <task id="task-1" name="MPON notifies MPOO about equipment change intentions">
      <outgoing>sequence-flow-2</outgoing>
    </task>
    <sequenceFlow id="sequence-flow-2" sourceRef="task-1" targetRef="exclusive-gateway-1"/>
    <exclusiveGateway id="exclusive-gateway-1">
      <incoming>sequence-flow-2</incoming>
      <outgoing>sequence-flow-3</outgoing>
      <outgoing>sequence-flow-4</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="sequence-flow-3" sourceRef="exclusive-gateway-1" targetRef="task-2"/>
    <sequenceFlow id="sequence-flow-4" sourceRef="exclusive-gateway-1" targetRef="task-3"/>
    <task id="task-2" name="MPOO announces self dismounting to MPON or no self-dismounting">
      <outgoing>sequence-flow-5</outgoing>
    </task>
    <sequenceFlow id="sequence-flow-5" sourceRef="task-2" targetRef="task-4"/>
    <task id="task-3" name="MPOO notify MPON about no self-dismounting">
      <outgoing>sequence-flow-6</outgoing>
    </task>
    <sequenceFlow id="sequence-flow-6" sourceRef="task-3" targetRef="task-4"/>
    <task id="task-4" name="MPON or MPOO perform final reading">
      <outgoing>sequence-flow-7</outgoing>
    </task>
    <sequenceFlow id="sequence-flow-7" sourceRef="task-4" targetRef="task-5"/>
    <task id="task-5" name="MPON or MPOO dismount old equipment">
      <outgoing>sequence-flow-8</outgoing>
    </task>
    <sequenceFlow id="sequence-flow-8" sourceRef="task-5" targetRef="task-6"/>
    <task id="task-6" name="MPON mounts new device">
      <outgoing>sequence-flow-9</outgoing>
    </task>
    <sequenceFlow id="sequence-flow-9" sourceRef="task-6" targetRef="task-7"/>
    <task id="task-7" name="MPON reads meter count from installed meter">
      <outgoing>sequence-flow-10</outgoing>
    </task>
    <sequenceFlow id="sequence-flow-10" sourceRef="task-7" targetRef="task-8"/>
    <task id="task-8" name="MPON sends values of final reading to GO">
      <outgoing>sequence-flow-11</outgoing>
    </task>
    <sequenceFlow id="sequence-flow-11" sourceRef="task-8" targetRef="task-9"/>
    <task id="task-9" name="MPON tells GO about device changes, master data and meter count at installation">
      <outgoing>sequence-flow-12</outgoing>
    </task>
    <sequenceFlow id="sequence-flow-12" sourceRef="task-9" targetRef="end-event"/>
    <task id="task-end-1" name="GO notify MSP about device changes, master data and meter counts">
      <incoming>sequence-flow-13</incoming>
    </task>
    <sequenceFlow id="sequence-flow-13" sourceRef="task-9" targetRef="task-end-1"/>
    <endEvent id="end-event">
      <incoming>sequence-flow-12</incoming>
    </endEvent>
  </process>
</definitions>