<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definitions" name="ZooClub Membership Process" targetNamespace="http://example.com/bpmn">

   <process id="zooClubMembershipProcess" isExecutable="true">
     <startEvent id="startEvent1">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <exclusiveGateway id="exclusiveGateway1">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
       <outgoing>sequenceFlow3</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="exclusiveGateway1"/>

     <sequenceFlow id="sequenceFlow2" name="Individual Membership" sourceRef="exclusiveGateway1" targetRef="individualTask">
       <conditionExpression xsi:type="tFormalExpression">type  ==  'individual'</conditionExpression>
     </sequenceFlow>

     <task id="individualTask">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow4</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow4" sourceRef="individualTask" targetRef="zooClubDeptTask"/>

     <sequenceFlow id="sequenceFlow3" name="Family Membership" sourceRef="exclusiveGateway1" targetRef="familyTask">
       <conditionExpression xsi:type="tFormalExpression">type  ==  'family'</conditionExpression>
     </sequenceFlow>

     <task id="familyTask">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow5</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow5" sourceRef="familyTask" targetRef="zooClubDeptTask"/>

     <task id="zooClubDeptTask">
       <incoming>sequenceFlow4</incoming>
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow6</outgoing>
       <outgoing>sequenceFlow7</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow6" sourceRef="zooClubDeptTask" targetRef="billingDeptTask"/>

     <task id="billingDeptTask">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow8</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow8" sourceRef="billingDeptTask" targetRef="bankTask"/>

     <task id="bankTask">
       <incoming>sequenceFlow8</incoming>
       <outgoing>sequenceFlow9</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow9" sourceRef="bankTask" targetRef="zooClubDeptPaymentConfirmationTask"/>

     <task id="zooClubDeptPaymentConfirmationTask">
       <incoming>sequenceFlow9</incoming>
       <outgoing>sequenceFlow10</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow10" sourceRef="zooClubDeptPaymentConfirmationTask" targetRef="endEvent1"/>

     <sequenceFlow id="sequenceFlow7" sourceRef="zooClubDeptTask" targetRef="marketingDeptTask"/>

     <task id="marketingDeptTask">
       <incoming>sequenceFlow7</incoming>
     </task>

     <endEvent id="endEvent1">
       <incoming>sequenceFlow10</incoming>
     </endEvent>
   </process>
</definitions>