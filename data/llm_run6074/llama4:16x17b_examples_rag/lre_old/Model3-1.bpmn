<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://example.com/bpmn">
    <collaboration id="collaboration">
        <participant id="Participant_1" name="Small Claims Registry Operations" processRef="Process_1"/>
    </collaboration>
    <process id="Process_1" isExecutable="true">
        <laneSet>
            <lane id="Lane_1" name="Client Service Back Office">
                <flowNodeRef>StartEvent_1</flowNodeRef>
                <flowNodeRef>Task_Retrieve_SCTT_file</flowNodeRef>
                <flowNodeRef>Task_Forward_SCT_Warrant_Possession</flowNodeRef>
                <flowNodeRef>Task_Store_SCTT_physical_file</flowNodeRef>
                <flowNodeRef>Task_Receive_report_and_update_SCT_file</flowNodeRef>
                <flowNodeRef>Task_Attach_new_SCT_document</flowNodeRef>
                <flowNodeRef>Task_Store_expanded_SCT_physical_file</flowNodeRef>
                <flowNodeRef>EndEvent_1</flowNodeRef>
            </lane>
        </laneSet>
        <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_Retrieve_SCTT_file"/>
        <startEvent id="StartEvent_1">
            <outgoing>SequenceFlow_1</outgoing>
        </startEvent>
        <task id="Task_Retrieve_SCTT_file">
            <incoming>SequenceFlow_1</incoming>
            <outgoing>SequenceFlow_2</outgoing>
        </task>
        <sequenceFlow id="SequenceFlow_2" sourceRef="Task_Retrieve_SCTT_file" targetRef="Task_Forward_SCT_Warrant_Possession"/>
        <task id="Task_Forward_SCT_Warrant_Possession">
            <incoming>SequenceFlow_2</incoming>
            <outgoing>SequenceFlow_3</outgoing>
        </task>
        <sequenceFlow id="SequenceFlow_3" sourceRef="Task_Forward_SCT_Warrant_Possession" targetRef="Task_Store_SCTT_physical_file"/>
        <task id="Task_Store_SCTT_physical_file">
            <incoming>SequenceFlow_3</incoming>
            <outgoing>SequenceFlow_4</outgoing>
        </task>
        <sequenceFlow id="SequenceFlow_4" sourceRef="Task_Store_SCTT_physical_file" targetRef="Task_Receive_report_and_update_SCT_file"/>
        <task id="Task_Receive_report_and_update_SCT_file">
            <incoming>SequenceFlow_4</incoming>
            <outgoing>SequenceFlow_5</outgoing>
        </task>
        <sequenceFlow id="SequenceFlow_5" sourceRef="Task_Receive_report_and_update_SCT_file" targetRef="Task_Attach_new_SCT_document"/>
        <task id="Task_Attach_new_SCT_document">
            <incoming>SequenceFlow_5</incoming>
            <outgoing>SequenceFlow_6</outgoing>
        </task>
        <sequenceFlow id="SequenceFlow_6" sourceRef="Task_Attach_new_SCT_document" targetRef="Task_Store_expanded_SCT_physical_file"/>
        <task id="Task_Store_expanded_SCT_physical_file">
            <incoming>SequenceFlow_6</incoming>
            <outgoing>SequenceFlow_7</outgoing>
        </task>
        <sequenceFlow id="SequenceFlow_7" sourceRef="Task_Store_expanded_SCT_physical_file" targetRef="EndEvent_1"/>
        <endEvent id="EndEvent_1">
            <incoming>SequenceFlow_7</incoming>
        </endEvent>
    </process>
</definitions>