<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definitions" targetNamespace="http://www.example.com/bpmn">

  <process id="design_process" isExecutable="true">
    <startEvent id="start_event">
      <outgoing>sequence_flow_1</outgoing>
    </startEvent>

    <task id="locate_distribute_designs">
        <incoming>sequence_flow_1</incoming>
        <outgoing>sequence_flow_2</outgoing>
    </task>

    <parallelGateway id="design_gateway">
      <incoming>sequence_flow_2</incoming>
      <outgoing>sequence_flow_electrical_start</outgoing>
      <outgoing>sequence_flow_physical_start</outgoing>
    </parallelGateway>

    <subProcess id="electrical_design_subprocess">
      <startEvent id="electrical_design_start">
        <incoming>sequence_flow_electrical_start</incoming>
        <outgoing>sequence_flow_electrical_review</outgoing>
      </startEvent>

      <task id="electrical_design_task">
        <incoming>sequence_flow_electrical_review</incoming>
        <outgoing>sequence_flow_electrical_test</outgoing>
      </task>

      <exclusiveGateway id="electrical_gateway">
        <incoming>sequence_flow_electrical_test</incoming>
        <outgoing>sequence_flow_electrical_pass</outgoing>
        <outgoing>sequence_flow_electrical_fail</outgoing>
      </exclusiveGateway>

      <sequenceFlow id="sequence_flow_electrical_review" sourceRef="electrical_design_start" targetRef="electrical_design_task"/>
      <sequenceFlow id="sequence_flow_electrical_test" sourceRef="electrical_design_task" targetRef="electrical_gateway"/>

    </subProcess>

    <subProcess id="physical_design_subprocess">
      <startEvent id="physical_design_start">
        <incoming>sequence_flow_physical_start</incoming>
        <outgoing>sequence_flow_physical_review</outgoing>
      </startEvent>

      <task id="physical_design_task">
        <incoming>sequence_flow_physical_review</incoming>
        <outgoing>sequence_flow_physical_test</outgoing>
      </task>

      <exclusiveGateway id="physical_gateway">
        <incoming>sequence_flow_physical_test</incoming>
        <outgoing>sequence_flow_physical_pass</outgoing>
        <outgoing>sequence_flow_physical_fail</outgoing>
      </exclusiveGateway>

      <sequenceFlow id="sequence_flow_physical_review" sourceRef="physical_design_start" targetRef="physical_design_task"/>
      <sequenceFlow id="sequence_flow_physical_test" sourceRef="physical_design_task" targetRef="physical_gateway"/>

    </subProcess>

    <!-- Sequence Flows -->
    <sequenceFlow id="sequence_flow_1" sourceRef="start_event" targetRef="locate_distribute_designs"/>
    <sequenceFlow id="sequence_flow_2" sourceRef="locate_distribute_designs" targetRef="design_gateway"/>
    <sequenceFlow id="sequence_flow_electrical_start" sourceRef="design_gateway" targetRef="electrical_design_subprocess"/>
    <sequenceFlow id="sequence_flow_physical_start" sourceRef="design_gateway" targetRef="physical_design_subprocess"/>

  </process>
</definitions>