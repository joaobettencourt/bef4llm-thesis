<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definitions" name="Customer Acquisition Process">

   <process id="customerAcquisitionProcess" isExecutable="true">
     <laneSet>
       <lane id="marketingLane" name="Marketing">
         <flowNodeRef>startEvent</flowNodeRef>
         <flowNodeRef>getContactDetailsTask</flowNodeRef>
       </lane>
       <lane id="callCenterLane" name="Call Center">
         <flowNodeRef>clarifyInterestTask</flowNodeRef>
         <flowNodeRef>checkBudgetTask</flowNodeRef>
       </lane>
       <lane id="developmentLane" name="Development">
         <flowNodeRef>headOfDevelopmentTask</flowNodeRef>
       </lane>
       <lane id="salesLane" name="Sales">
         <flowNodeRef>onlinePresentationTask</flowNodeRef>
         <flowNodeRef>followUpTask</flowNodeRef>
         <flowNodeRef>createQuotationTask</flowNodeRef>
       </lane>
     </laneSet>

     <startEvent id="startEvent1" name="Start">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <task id="getContactDetailsTask" name="Determine Contact Details">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="getContactDetailsTask"/>

     <exclusiveGateway id="exclusiveGateway1">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow4</outgoing>
       <outgoing>sequenceFlow5</outgoing>
     </exclusiveGateway>

     <task id="clarifyInterestTask" name="Clarify Interest">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow2" sourceRef="getContactDetailsTask" targetRef="clarifyInterestTask"/>

     <sequenceFlow id="sequenceFlow3" sourceRef="clarifyInterestTask" targetRef="exclusiveGateway1"/>

     <endEvent id="endEvent2" name="Process Stopped Due to Lack of Interest">
       <incoming>sequenceFlow4</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow4" name="not interested and normal budget" sourceRef="exclusiveGateway1" targetRef="endEvent2"/>

     <task id="checkBudgetTask" name="Check Budget">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow6</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow5" sourceRef="exclusiveGateway1" targetRef="checkBudgetTask"/>

     <exclusiveGateway id="exclusiveGateway2">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow7</outgoing>
       <outgoing>sequenceFlow8</outgoing>
     </exclusiveGateway>

     <task id="headOfDevelopmentTask" name="Head of Development Acquires Customer">
       <incoming>sequenceFlow8</incoming>
       <outgoing>sequenceFlow9</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow6" sourceRef="checkBudgetTask" targetRef="exclusiveGateway2"/>

     <sequenceFlow id="sequenceFlow7" name="customer interested and budget sufficient" sourceRef="exclusiveGateway2" targetRef="onlinePresentationTask"/>

     <endEvent id="endEvent1" name="Quotation Created">
       <incoming>sequenceFlow9</incoming>
     </endEvent>

     <task id="onlinePresentationTask" name="Online Presentation">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow10</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow8" name="budget huge" sourceRef="exclusiveGateway2" targetRef="headOfDevelopmentTask"/>

     <sequenceFlow id="sequenceFlow9" sourceRef="headOfDevelopmentTask" targetRef="endEvent1"/>

     <task id="followUpTask" name="Follow Up">
       <incoming>sequenceFlow10</incoming>
       <outgoing>sequenceFlow11</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow10" sourceRef="onlinePresentationTask" targetRef="followUpTask"/>

     <exclusiveGateway id="exclusiveGateway3">
       <incoming>sequenceFlow11</incoming>
       <outgoing>sequenceFlow12</outgoing>
       <outgoing>sequenceFlow13</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow11" sourceRef="followUpTask" targetRef="exclusiveGateway3"/>

     <task id="createQuotationTask" name="Create Quotation">
       <incoming>sequenceFlow12</incoming>
     </task>

     <sequenceFlow id="sequenceFlow12" name="contacted within 2 weeks" sourceRef="exclusiveGateway3" targetRef="createQuotationTask"/>

     <sequenceFlow id="sequenceFlow13" name="not contacted within 2 weeks" sourceRef="exclusiveGateway3" targetRef="followUpTask"/>
   </process>
</definitions>