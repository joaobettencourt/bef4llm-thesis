<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <process id="Pool_0" isExecutable="false">
    <laneSet>
      <lane id="Lane_0" name="HR Representative">
        <flowNodeRef>StartNoneEvent_0</flowNodeRef>
        <flowNodeRef>Task_0</flowNodeRef>
        <flowNodeRef>Task_1</flowNodeRef>
        <flowNodeRef>IntermediateCatchEvent_0</flowNodeRef>
        <flowNodeRef>ExclusiveGateway_0</flowNodeRef>
        <flowNodeRef>Task_2</flowNodeRef>
        <flowNodeRef>ExclusiveGateway_1</flowNodeRef>
        <flowNodeRef>Task_3</flowNodeRef>
        <flowNodeRef>EndNoneEvent_0</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent name="Vacancy reported" id="StartNoneEvent_0">
      <outgoing>SequenceFlow_0</outgoing>
    </startEvent>
    <task name="Create job description" id="Task_0">
      <incoming>SequenceFlow_0</incoming>
      <outgoing>SequenceFlow_1</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_0" sourceRef="StartNoneEvent_0" targetRef="Task_0"/>
    <sequenceFlow id="SequenceFlow_1" sourceRef="Task_0" targetRef="ExclusiveGateway_0"/>
    <exclusiveGateway name="" id="ExclusiveGateway_0">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
      <outgoing>SequenceFlow_3</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_2" sourceRef="ExclusiveGateway_0" targetRef="Task_1">
      <conditionExpression xsi:type="tFormalExpression">澄清信息</conditionExpression>
    </sequenceFlow>
    <task name="Clarify information with Department" id="Task_1">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_4</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_0" targetRef="Task_2"/>
    <task name="Submit job description for approval" id="Task_2">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_5</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_4" sourceRef="Task_1" targetRef="Task_2"/>
    <exclusiveGateway name="" id="ExclusiveGateway_1">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_6</outgoing>
      <outgoing>SequenceFlow_7</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_5" sourceRef="Task_2" targetRef="ExclusiveGateway_1"/>
    <task name="Correct job description" id="Task_3">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_6" sourceRef="ExclusiveGateway_1" targetRef="EndNoneEvent_0"/>
    <sequenceFlow id="SequenceFlow_7" sourceRef="ExclusiveGateway_1" targetRef="Task_3">
      <conditionExpression>需要修正</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="SequenceFlow_8" sourceRef="Task_3" targetRef="Task_2"/>
    <endEvent name="Job description approved and posted" id="EndNoneEvent_0">
      <incoming>SequenceFlow_6</incoming>
    </endEvent>
  </process>
</definitions>