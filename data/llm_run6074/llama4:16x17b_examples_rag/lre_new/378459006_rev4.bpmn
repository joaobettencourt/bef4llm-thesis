<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd" 
             id="definitions" targetNamespace="http://www.example.com">

   <process id="PaymentProcess" isExecutable="true">
     <laneSet>
       <lane id="Lane_1" name="Payment Office">
         <flowNodeRef>StartEvent_WeeklyPayment</flowNodeRef>
         <flowNodeRef>Task_GenerateReport</flowNodeRef>
         <flowNodeRef>Task_SendToRegistryOffice</flowNodeRef>
         <flowNodeRef>Task_SendToAccountsReceivableDepartment</flowNodeRef>
         <flowNodeRef>Task_PayVendor</flowNodeRef>
       </lane>

       <lane id="Lane_2" name="Registry Office">
         <flowNodeRef>Task_SelectInvoicesForArchiving</flowNodeRef>
         <flowNodeRef>Task_ArchiveInvoicesPerVendorAndDate</flowNodeRef>
       </lane>

       <lane id="Lane_3" name="Accounts Receivable Department">
         <flowNodeRef>Task_GenerateMonthlyInvoice</flowNodeRef>
         <flowNodeRef>Task_SendInvoiceToClient</flowNodeRef>
         <flowNodeRef>Task_NotifyClientOfCharge</flowNodeRef>
       </lane>

       <lane id="Lane_4" name="Client">
         <flowNodeRef>EndEvent_ProcessCompleted</flowNodeRef>
       </lane>
     </laneSet>

     <startEvent id="StartEvent_WeeklyPayment">
       <outgoing>SequenceFlow_GenerateReport</outgoing>
       <timerEventDefinition/>
     </startEvent>

     <sequenceFlow id="SequenceFlow_GenerateReport" sourceRef="StartEvent_WeeklyPayment" targetRef="Task_GenerateReport"/>

     <task id="Task_GenerateReport">
       <incoming>SequenceFlow_GenerateReport</incoming>
       <outgoing>SequenceFlow_SendToRegistryOffice</outgoing>
       <outgoing>SequenceFlow_SendToAccountsReceivableDepartment</outgoing>
       <outgoing>SequenceFlow_PayVendor</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_SendToRegistryOffice" sourceRef="Task_GenerateReport" targetRef="Task_SendToRegistryOffice"/>

     <task id="Task_SendToRegistryOffice">
       <incoming>SequenceFlow_SendToRegistryOffice</incoming>
       <outgoing>SequenceFlow_SelectInvoicesForArchiving</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_SendToAccountsReceivableDepartment" sourceRef="Task_GenerateReport" targetRef="Task_SendToAccountsReceivableDepartment"/>

     <task id="Task_SendToAccountsReceivableDepartment">
       <incoming>SequenceFlow_SendToAccountsReceivableDepartment</incoming>
       <outgoing>SequenceFlow_GenerateMonthlyInvoice</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_PayVendor" sourceRef="Task_GenerateReport" targetRef="Task_PayVendor"/>

     <task id="Task_PayVendor">
       <incoming>SequenceFlow_PayVendor</incoming>
     </task>

     <sequenceFlow id="SequenceFlow_GenerateMonthlyInvoice" sourceRef="Task_SendToAccountsReceivableDepartment" targetRef="Task_GenerateMonthlyInvoice"/>

     <task id="Task_GenerateMonthlyInvoice">
       <incoming>SequenceFlow_GenerateMonthlyInvoice</incoming>
       <outgoing>SequenceFlow_SendInvoiceToClient</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_SendInvoiceToClient" sourceRef="Task_GenerateMonthlyInvoice" targetRef="Task_SendInvoiceToClient"/>

     <task id="Task_SendInvoiceToClient">
       <incoming>SequenceFlow_SendInvoiceToClient</incoming>
       <outgoing>SequenceFlow_NotifyClientOfCharge</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_NotifyClientOfCharge" sourceRef="Task_SendInvoiceToClient" targetRef="Task_NotifyClientOfCharge"/>

     <task id="Task_NotifyClientOfCharge">
       <incoming>SequenceFlow_NotifyClientOfCharge</incoming>
     </task>

     <sequenceFlow id="SequenceFlow_SelectInvoicesForArchiving" sourceRef="Task_SendToRegistryOffice" targetRef="Task_SelectInvoicesForArchiving"/>

     <task id="Task_SelectInvoicesForArchiving">
       <incoming>SequenceFlow_SelectInvoicesForArchiving</incoming>
       <outgoing>SequenceFlow_ArchiveInvoicesPerVendorAndDate</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_ArchiveInvoicesPerVendorAndDate" sourceRef="Task_SelectInvoicesForArchiving" targetRef="Task_ArchiveInvoicesPerVendorAndDate"/>

     <task id="Task_ArchiveInvoicesPerVendorAndDate">
       <incoming>SequenceFlow_ArchiveInvoicesPerVendorAndDate</incoming>
     </task>

     <endEvent id="EndEvent_ProcessCompleted">
       <incoming/>
     </endEvent>

   </process>

</definitions>