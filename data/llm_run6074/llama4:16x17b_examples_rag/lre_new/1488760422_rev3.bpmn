<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definitions" targetNamespace="http://www.example.com">

    <process id="Process_1" isExecutable="true">
      <startEvent id="StartEvent_1">
        <outgoing>SequenceFlow_1</outgoing>
      </startEvent>

      <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>

      <task id="Task_1" name="Sort invoice per client and vendor">
        <incoming>SequenceFlow_1</incoming>
        <outgoing>SequenceFlow_2</outgoing>
      </task>

      <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="Task_2"/>

      <task id="Task_2" name="Attach invoice entry form to invoice">
        <incoming>SequenceFlow_2</incoming>
        <outgoing>SequenceFlow_3</outgoing>
      </task>

      <sequenceFlow id="SequenceFlow_3" sourceRef="Task_2" targetRef="Task_3"/>

      <task id="Task_3" name="Enter required info on invoice entry form">
        <incoming>SequenceFlow_3</incoming>
        <outgoing>SequenceFlow_4</outgoing>
      </task>

      <sequenceFlow id="SequenceFlow_4" sourceRef="Task_3" targetRef="ExclusiveGateway_1"/>

      <exclusiveGateway id="ExclusiveGateway_1">
        <incoming>SequenceFlow_4</incoming>
        <outgoing>SequenceFlow_5</outgoing>
        <outgoing>SequenceFlow_6</outgoing>
      </exclusiveGateway>

      <sequenceFlow id="SequenceFlow_5" name="completed" sourceRef="ExclusiveGateway_1" targetRef="Task_4">
        <conditionExpression xsi:type="tFormalExpression">${invoiceComplete  == true}</conditionExpression>
      </sequenceFlow>

      <task id="Task_4" name="Check SLA and priority">
        <incoming>SequenceFlow_5</incoming>
        <outgoing>SequenceFlow_7</outgoing>
      </task>

      <sequenceFlow id="SequenceFlow_6" name="not completed" sourceRef="ExclusiveGateway_1" targetRef="Task_9">
        <conditionExpression xsi:type="tFormalExpression">${invoiceComplete  == false}</conditionExpression>
      </sequenceFlow>

      <task id="Task_9" name="Send message to client">
        <incoming>SequenceFlow_6</incoming>
        <outgoing>SequenceFlow_10</outgoing>
      </task>

      <sequenceFlow id="SequenceFlow_10" sourceRef="Task_9" targetRef="EndEvent_1"/>

      <sequenceFlow id="SequenceFlow_7" sourceRef="Task_4" targetRef="ExclusiveGateway_2"/>

      <exclusiveGateway id="ExclusiveGateway_2">
        <incoming>SequenceFlow_7</incoming>
        <outgoing>SequenceFlow_8</outgoing>
        <outgoing>SequenceFlow_11</outgoing>
      </exclusiveGateway>

      <sequenceFlow id="SequenceFlow_8" name="high priority" sourceRef="ExclusiveGateway_2" targetRef="Task_5">
        <conditionExpression xsi:type="tFormalExpression">${priority ==  'high'}</conditionExpression>
      </sequenceFlow>

      <task id="Task_5" name="Apply red stamp on entry invoice">
        <incoming>SequenceFlow_8</incoming>
        <outgoing>SequenceFlow_12</outgoing>
      </task>

      <sequenceFlow id="SequenceFlow_12" sourceRef="Task_5" targetRef="Task_6"/>

      <sequenceFlow id="SequenceFlow_11" name="normal priority" sourceRef="ExclusiveGateway_2" targetRef="Task_6">
        <conditionExpression xsi:type="tFormalExpression">${priority ==  'normal'}</conditionExpression>
      </sequenceFlow>

      <task id="Task_6" name="Check invoice compliance">
        <incoming>SequenceFlow_12</incoming>
        <incoming>SequenceFlow_11</incoming>
        <outgoing>SequenceFlow_13</outgoing>
        <outgoing>SequenceFlow_14</outgoing>
      </task>

      <sequenceFlow id="SequenceFlow_13" name="compliant" sourceRef="Task_6" targetRef="Task_7">
        <conditionExpression xsi:type="tFormalExpression">${compliance  == true}</conditionExpression>
      </sequenceFlow>

      <task id="Task_7" name="Allocate invoice to DEO">
        <incoming>SequenceFlow_13</incoming>
        <outgoing>SequenceFlow_15</outgoing>
      </task>

      <sequenceFlow id="SequenceFlow_14" name="non-compliant" sourceRef="Task_6" targetRef="SubProcess_1"/>

      <subProcess id="SubProcess_1" name="Handle non- compliance">
        <incoming>SequenceFlow_14</incoming>
        <outgoing>SequenceFlow_16</outgoing>
      </subProcess>

      <sequenceFlow id="SequenceFlow_15" sourceRef="Task_7" targetRef="EndEvent_1"/>

      <sequenceFlow id="SequenceFlow_16" sourceRef="SubProcess_1" targetRef="ExclusiveGateway_3"/>

      <exclusiveGateway id="ExclusiveGateway_3">
        <incoming>SequenceFlow_16</incoming>
        <outgoing>SequenceFlow_17</outgoing>
        <outgoing>SequenceFlow_18</outgoing>
        <outgoing>SequenceFlow_19</outgoing>
      </exclusiveGateway>

      <sequenceFlow id="SequenceFlow_17" sourceRef="ExclusiveGateway_3" targetRef="Task_8">
        <conditionExpression xsi:type="tFormalExpression">${requestInformationFromClient  == 'call'}</conditionExpression>
      </sequenceFlow>

      <task id="Task_8" name="Call client and request information">
        <incoming>SequenceFlow_17</incoming>
        <outgoing>SequenceFlow_20</outgoing>
      </task>

      <sequenceFlow id="SequenceFlow_18" sourceRef="ExclusiveGateway_3" targetRef="Task_10">
        <conditionExpression xsi:type="tFormalExpression">${requestInformationFromClient  == 'send postal mail'}</conditionExpression>
      </sequenceFlow>

      <task id="Task_10" name="Send postal mail requesting information">
        <incoming>SequenceFlow_18</incoming>
        <outgoing>SequenceFlow_21</outgoing>
      </task>

      <sequenceFlow id="SequenceFlow_19" sourceRef="ExclusiveGateway_3" targetRef="Task_12">
        <conditionExpression xsi:type="tFormalExpression">${requestInformationFromClient  == 'send to experience staff'}</conditionExpression>
      </sequenceFlow>

      <task id="Task_12" name="Send invoice to experience staff">
        <incoming>SequenceFlow_19</incoming>
        <outgoing>SequenceFlow_22</outgoing>
      </task>

      <sequenceFlow id="SequenceFlow_20" sourceRef="Task_8" targetRef="IntermediateCatchEvent_1"/>

      <intermediateCatchEvent id="IntermediateCatchEvent_1">
        <incoming>SequenceFlow_20</incoming>
        <outgoing>SequenceFlow_23</outgoing>
        <timerEventDefinition/>
      </intermediateCatchEvent>

      <sequenceFlow id="SequenceFlow_21" sourceRef="Task_10" targetRef="EndEvent_1"/>

      <sequenceFlow id="SequenceFlow_22" sourceRef="Task_12" targetRef="Task_6"/>

      <sequenceFlow id="SequenceFlow_23" sourceRef="IntermediateCatchEvent_1" targetRef="Task_10"/>

      <endEvent id="EndEvent_1">
        <incoming>SequenceFlow_15</incoming>
        <incoming>SequenceFlow_21</incoming>
        <incoming>SequenceFlow_10</incoming>
      </endEvent>

    </process>

  </definitions>