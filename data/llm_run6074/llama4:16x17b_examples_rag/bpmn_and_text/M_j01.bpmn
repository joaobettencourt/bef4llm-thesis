<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/BPMN20.xsd" 
             id="definition" targetNamespace="http://www.example.com">

   <process id="chainsaw_process" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_GetCustomerRequirements"/>

     <task id="Task_GetCustomerRequirements" name="Get customer requirements">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_GetCustomerRequirements" targetRef="ParallelGateway_1"/>

     <parallelGateway id="ParallelGateway_1">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_4</outgoing>
     </parallelGateway>

     <sequenceFlow id="SequenceFlow_3" sourceRef="ParallelGateway_1" targetRef="Task_OrderParts"/>

     <task id="Task_OrderParts" name="Order parts">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_4" sourceRef="ParallelGateway_1" targetRef="Task_SendUpdatesToCustomer"/>

     <task id="Task_SendUpdatesToCustomer" name="Send updates to customer">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_OrderParts" targetRef="IntermediateCatchEvent_PartsArrived"/>

     <intermediateCatchEvent id="IntermediateCatchEvent_PartsArrived">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_7</outgoing>
     </intermediateCatchEvent>

     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_SendUpdatesToCustomer" targetRef="ExclusiveGateway_1"/>

     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_8</outgoing>
       <outgoing>SequenceFlow_9</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_7" sourceRef="IntermediateCatchEvent_PartsArrived" targetRef="Task_ManualInspection"/>

     <task id="Task_ManualInspection" name="Manual inspection">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_10</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_8" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_FirstSawProduced">
       <conditionExpression xsi:type="tFormalExpression">${customerLikesFirstSaw}</conditionExpression>
     </sequenceFlow>

     <endEvent id="EndEvent_FirstSawProduced">
       <incoming>SequenceFlow_8</incoming>
     </endEvent>

     <sequenceFlow id="SequenceFlow_9" sourceRef="ExclusiveGateway_1" targetRef="Task_AssembleParts"/>

     <task id="Task_AssembleParts" name="Assemble parts">
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_10</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_10" sourceRef="Task_ManualInspection" targetRef="ExclusiveGateway_2"/>

     <exclusiveGateway id="ExclusiveGateway_2">
       <incoming>SequenceFlow_10</incoming>
       <outgoing>SequenceFlow_11</outgoing>
       <outgoing>SequenceFlow_12</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_11" sourceRef="ExclusiveGateway_2" targetRef="EndEvent_ProductionFinished">
       <conditionExpression xsi:type="tFormalExpression">${productionComplete}</conditionExpression>
     </sequenceFlow>

     <endEvent id="EndEvent_ProductionFinished">
       <incoming>SequenceFlow_11</incoming>
     </endEvent>

   </process>
</definitions>