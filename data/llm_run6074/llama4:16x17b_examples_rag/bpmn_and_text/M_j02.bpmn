<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" targetNamespace="http://www.example.com">

   <process id="LuxuryAirplaneProcess" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>

     <task id="Task_1" name="Receive specifications from customer">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="ExclusiveGateway_1"/>

     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_2</incoming>
       <!-- outgoing sequence flows for different interior options -->
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_7</outgoing>
       <outgoing>SequenceFlow_11</outgoing>
       <outgoing>SequenceFlow_15</outgoing>
     </exclusiveGateway>

     <!-- Interior Options -->
     <sequenceFlow id="SequenceFlow_3" name="Bar option: Vodka" sourceRef="ExclusiveGateway_1" targetRef="Task_2">
       <conditionExpression xsi:type="tFormalExpression">${barOption == 'vodka'}</conditionExpression>
     </sequenceFlow>

     <task id="Task_2" name="Send requirements to Russian team for vodka bar">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_4</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_4" sourceRef="Task_2" targetRef="ParallelGateway_1"/>

     <!-- Additional Interior Options -->
     <sequenceFlow id="SequenceFlow_7" name="Bar option: Whiskey" sourceRef="ExclusiveGateway_1" targetRef="Task_3">
       <conditionExpression xsi:type="tFormalExpression">${barOption == 'whiskey'}</conditionExpression>
     </sequenceFlow>

     <task id="Task_3" name="Send requirements to Irish team for whiskey bar">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_8</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_8" sourceRef="Task_3" targetRef="ParallelGateway_1"/>

     <!-- More sequence flows and tasks for other interior options -->

     <parallelGateway id="ParallelGateway_1">
       <incoming>SequenceFlow_4</incoming>
       <incoming>SequenceFlow_8</incoming>
       <!-- more incoming flows -->
       <outgoing>SequenceFlow_5</outgoing>
     </parallelGateway>

     <sequenceFlow id="SequenceFlow_5" sourceRef="ParallelGateway_1" targetRef="Task_4"/>

     <task id="Task_4" name="Assemble interior of airplane">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_4" targetRef="Task_5"/>

     <task id="Task_5" name="Conduct test flight and create test protocol">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_5" targetRef="ExclusiveGateway_2"/>

     <exclusiveGateway id="ExclusiveGateway_2">
       <!-- outgoing sequence flows for delivery or not -->
       <outgoing>SequenceFlow_10</outgoing>
       <outgoing>SequenceFlow_12</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_10" sourceRef="ExclusiveGateway_2" targetRef="Task_6">
       <!-- normal delivery process -->
     </sequenceFlow>

     <task id="Task_6" name="Deliver airplane to customer and confirm">
       <incoming>SequenceFlow_10</incoming>
       <outgoing>SequenceFlow_11</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_11" sourceRef="Task_6" targetRef="EndEvent_1"/>

     <!-- More sequence flows for other paths -->

     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_11</incoming>
     </endEvent>

   </process>
</definitions>