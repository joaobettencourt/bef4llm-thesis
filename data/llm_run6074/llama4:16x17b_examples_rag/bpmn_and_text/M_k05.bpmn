<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/BPMN20.xsd" 
             id="definition" targetNamespace="http://www.example.com">

    <process id="Building_a_House" isExecutable="true">
      <startEvent id="StartEvent_1">
        <outgoing>SequenceFlow_1</outgoing>
      </startEvent>

      <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_CollectRequirements"/>

      <task id="Task_CollectRequirements" name="Collect requirements">
        <incoming>SequenceFlow_1</incoming>
        <outgoing>SequenceFlow_2</outgoing>
      </task>

      <sequenceFlow id="SequenceFlow_2" sourceRef="Task_CollectRequirements" targetRef="Task_SendToArchitect"/>

      <serviceTask id="Task_SendToArchitect" name="Send to architect">
        <incoming>SequenceFlow_2</incoming>
        <outgoing>SequenceFlow_3</outgoing>
      </serviceTask>

      <sequenceFlow id="SequenceFlow_3" sourceRef="Task_SendToArchitect" targetRef="Gateway_RefineDraft"/>

      <exclusiveGateway id="Gateway_RefineDraft">
        <incoming>SequenceFlow_3</incoming>
        <outgoing>SequenceFlow_4</outgoing>
        <outgoing>SequenceFlow_5</outgoing>
      </exclusiveGateway>

      <sequenceFlow id="SequenceFlow_4" name="Additional requirements needed" sourceRef="Gateway_RefineDraft" targetRef="Task_SendToArchitect">
        <conditionExpression xsi:type="tFormalExpression">${requirementsNotMet}</conditionExpression>
      </sequenceFlow>

      <sequenceFlow id="SequenceFlow_5" name="Requirements met" sourceRef="Gateway_RefineDraft" targetRef="Task_CreateMaterialList"/>

      <task id="Task_CreateMaterialList" name="Create list of needed materials">
        <incoming>SequenceFlow_5</incoming>
        <outgoing>SequenceFlow_6</outgoing>
      </task>

      <sequenceFlow id="SequenceFlow_6" sourceRef="Task_CreateMaterialList" targetRef="Gateway_OrderMaterials"/>

      <parallelGateway id="Gateway_OrderMaterials">
        <incoming>SequenceFlow_6</incoming>
        <outgoing>SequenceFlow_7</outgoing>
        <outgoing>SequenceFlow_8</outgoing>
        <outgoing>SequenceFlow_9</outgoing>
      </parallelGateway>

      <sequenceFlow id="SequenceFlow_7" sourceRef="Gateway_OrderMaterials" targetRef="Task_SendMessagesToFriends"/>

      <task id="Task_SendMessagesToFriends" name="Send messages to friends">
        <incoming>SequenceFlow_7</incoming>
      </task>

      <sequenceFlow id="SequenceFlow_8" sourceRef="Gateway_OrderMaterials" targetRef="Task_OrderFromOnlineStores"/>

      <task id="Task_OrderFromOnlineStores" name="Order materials from online stores">
        <incoming>SequenceFlow_8</incoming>
      </task>

      <sequenceFlow id="SequenceFlow_9" sourceRef="Gateway_OrderMaterials" targetRef="Task_PrepareForParty"/>

      <task id="Task_PrepareForParty" name="Prepare for party">
        <incoming>SequenceFlow_9</incoming>
        <outgoing>SequenceFlow_10</outgoing>
      </task>

      <sequenceFlow id="SequenceFlow_10" sourceRef="Task_PrepareForParty" targetRef="EndEvent_TreeHouseBuilt"/>

      <endEvent id="EndEvent_TreeHouseBuilt" name="Tree house built">
        <incoming>SequenceFlow_10</incoming>
      </endEvent>

    </process>
</definitions>