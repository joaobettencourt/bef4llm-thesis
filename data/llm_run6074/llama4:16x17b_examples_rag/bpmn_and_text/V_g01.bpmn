<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/BPMN20.xsd"
             id="definition" targetNamespace="http://www.example.com">

  <process id="RoboticBurgerSellerProcess" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>

    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="ExclusiveGateway_1"/>

    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
      <outgoing>SequenceFlow_3</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow_2" name="Menu" sourceRef="ExclusiveGateway_1" targetRef="Task_1">
      <conditionExpression xsi:type="tFormalExpression">${orderType == 'menu'}</conditionExpression>
    </sequenceFlow>

    <task id="Task_1" name="Prepare drink">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_4</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_3" name="Just Burger" sourceRef="ExclusiveGateway_1" targetRef="Task_5">
      <conditionExpression xsi:type="tFormalExpression">${orderType == 'burger'}</conditionExpression>
    </sequenceFlow>

    <task id="Task_5" name="Prepare burger">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_11</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_4" sourceRef="Task_1" targetRef="ExclusiveGateway_2"/>

    <exclusiveGateway id="ExclusiveGateway_2">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_6</outgoing>
      <outgoing>SequenceFlow_7</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow_6" name="Fries" sourceRef="ExclusiveGateway_2" targetRef="Task_2">
      <conditionExpression xsi:type="tFormalExpression">${side == 'fries'}</conditionExpression>
    </sequenceFlow>

    <task id="Task_2" name="Prepare fries">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_7" name="Wedges" sourceRef="ExclusiveGateway_2" targetRef="Task_3">
      <conditionExpression xsi:type="tFormalExpression">${side == 'wedges'}</conditionExpression>
    </sequenceFlow>

    <task id="Task_3" name="Prepare wedges">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_9</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_8" sourceRef="Task_2" targetRef="Task_4"/>
    <sequenceFlow id="SequenceFlow_9" sourceRef="Task_3" targetRef="Task_4"/>

    <task id="Task_4" name="Prepare burger with status updates">
      <incoming>SequenceFlow_8</incoming>
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_10</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_10" sourceRef="Task_4" targetRef="EndEvent_1"/>
    <sequenceFlow id="SequenceFlow_11" sourceRef="Task_5" targetRef="EndEvent_1"/>

    <endEvent id="EndEvent_1">
      <incoming>SequenceFlow_10</incoming>
      <incoming>SequenceFlow_11</incoming>
    </endEvent>

  </process>
</definitions>