<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" targetNamespace="http://example.com/bpmn">

  <collaboration id="collaboration">
    <participant id="Participant_1" name="Restaurant Process" processRef="Process_1"/>
  </collaboration>

  <process id="Process_1" isExecutable="true">

    <!-- Lanes -->
    <laneSet>
      <lane id="Lane_Employee" name="Employee">
        <flowNodeRef>Task_0x6vyrbg</flowNodeRef>
        <flowNodeRef>Task_1idj4oa</flowNodeRef>
        <flowNodeRef>Task_1kanzcw</flowNodeRef>
        <flowNodeRef>ExclusiveGateway_0ej2cjq</flowNodeRef>
      </lane>
      <lane id="Lane_Chef" name="Chef">
        <flowNodeRef>Task_05cqwwde</flowNodeRef>
      </lane>
    </laneSet>

    <!-- Start Event -->
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_0zufwom</outgoing>
    </startEvent>

    <!-- Sequence Flows -->
    <sequenceFlow id="SequenceFlow_0zufwom" sourceRef="StartEvent_1" targetRef="Task_0x6vyrbg"/>

    <!-- Tasks -->
    <task id="Task_0x6vyrbg" name="Place Order">
      <incoming>SequenceFlow_0zufwom</incoming>
      <outgoing>SequenceFlow_0exhluwz</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_0exhluwz" sourceRef="Task_0x6vyrbg" targetRef="Task_1idj4oa"/>

    <task id="Task_1idj4oa" name="Enter Order into POS">
      <incoming>SequenceFlow_0exhluwz</incoming>
      <outgoing>SequenceFlow_1cjq2cd</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_1cjq2cd" sourceRef="Task_1idj4oa" targetRef="Task_1kanzcw"/>

    <task id="Task_1kanzcw" name="Collect Money and Give Buzzer">
      <incoming>SequenceFlow_1cjq2cd</incoming>
      <outgoing>SequenceFlow_0jsanjwy</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_0jsanjwy" sourceRef="Task_1kanzcw" targetRef="ExclusiveGateway_0ej2cjq"/>

    <exclusiveGateway id="ExclusiveGateway_0ej2cjq">
      <incoming>SequenceFlow_0jsanjwy</incoming>
      <outgoing>SequenceFlow_1vhyphen</outgoing>
      <outgoing>SequenceFlow_0x9dk3la</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow_1vhyphen" name="No reaction" sourceRef="ExclusiveGateway_0ej2cjq" targetRef="Task_Call_Guest"/>

    <task id="Task_Call_Guest" name="Call Guest">
      <incoming>SequenceFlow_1vhyphen</incoming>
      <!-- outgoing not specified -->
    </task>

    <sequenceFlow id="SequenceFlow_0x9dk3la" name="Reaction" sourceRef="ExclusiveGateway_0ej2cjq" targetRef="Task_Inform_Chef"/>

    <task id="Task_Inform_Chef" name="Inform Chef">
      <incoming>SequenceFlow_0x9dk3la</incoming>
      <outgoing>SequenceFlow_1d4sg8k</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_1d4sg8k" sourceRef="Task_Inform_Chef" targetRef="Task_05cqwwde"/>

    <task id="Task_05cqwwde" name="Prepare Meal">
      <incoming>SequenceFlow_1d4sg8k</incoming>
      <outgoing>SequenceFlow_0imrhkac</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_0imrhkac" sourceRef="Task_05cqwwde" targetRef="Task_Signal_Guest"/>

    <task id="Task_Signal_Guest" name="Signal Guest">
      <incoming>SequenceFlow_0imrhkac</incoming>
      <!-- outgoing not specified -->
    </task>

    <endEvent id="EndEvent_1" name="Meal Delivered">
      <!-- incoming not specified -->
    </endEvent>

  </process>
</definitions>