<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd" 
             id="definitions" 
             targetNamespace="http://bpmn.io/schema/bpmn">
  <collaboration id="Collaboration_1">
    <participant id="Participant_1" name="Dispatch of goods&#10;Computer Hardware Shop" processRef="Process_1"/>
  </collaboration>
  <process id="Process_1" isExecutable="false">
    <laneSet>
      <lane id="Lane_1" name="Secretary">
        <flowNodeRef>StartEvent_1</flowNodeRef>
        <flowNodeRef>ExclusiveGateway_1</flowNodeRef>
        <flowNodeRef>Task_0jsoxba</flowNodeRef>
        <flowNodeRef>InclusiveGateway_1</flowNodeRef>
        <flowNodeRef>Task_0e6hvnj</flowNodeRef>
        <flowNodeRef>Task_0s79ile</flowNodeRef>
      </lane>
      <lane id="Lane_2" name="Logistics Department Head">
        <flowNodeRef>Task_12j0pib</flowNodeRef>
      </lane>
      <lane id="Lane_3" name="Warehousemen">
        <flowNodeRef>Task_05ftug5</flowNodeRef>
      </lane>
    </laneSet>

    <startEvent id="StartEvent_1" name="Ship goods">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>

    <parallelGateway id="ParallelGateway_1">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
      <outgoing>SequenceFlow_3</outgoing>
    </parallelGateway>

    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="ParallelGateway_1"/>

    <exclusiveGateway id="ExclusiveGateway_1" name="Special handling?">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_4</outgoing>
      <outgoing>SequenceFlow_5</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow_2" sourceRef="ParallelGateway_1" targetRef="ExclusiveGateway_1"/>

    <task id="Task_0jsoxba" name="Write package label">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_1" targetRef="Task_0jsoxba"/>

    <inclusiveGateway id="InclusiveGateway_1">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </inclusiveGateway>

    <sequenceFlow id="SequenceFlow_6" sourceRef="Task_0jsoxba" targetRef="InclusiveGateway_1"/>

    <task id="Task_12j0pib" name="Insure parcel">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_7" sourceRef="InclusiveGateway_1" targetRef="Task_12j0pib"/>

    <exclusiveGateway id="ExclusiveGateway_2">
      <incoming>SequenceFlow_8</incoming>
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_10</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow_8" sourceRef="Task_12j0pib" targetRef="ExclusiveGateway_2"/>

    <task id="Task_05ftug5" name="Package goods">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_9</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_3" sourceRef="ParallelGateway_1" targetRef="Task_05ftug5"/>

    <sequenceFlow id="SequenceFlow_9" sourceRef="Task_05ftug5" targetRef="ExclusiveGateway_2"/>

    <task id="Task_0e6hvnj" name="Get 3 offers from logistic companies">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_11</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_5" sourceRef="ExclusiveGateway_1" targetRef="Task_0e6hvnj"/>

    <task id="Task_0s79ile" name="Select logistic company and place order">
      <incoming>SequenceFlow_11</incoming>
      <outgoing>SequenceFlow_12</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_11" sourceRef="Task_0e6hvnj" targetRef="Task_0s79ile"/>

    <exclusiveGateway id="ExclusiveGateway_3">
      <incoming>SequenceFlow_12</incoming>
      <outgoing>SequenceFlow_10</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow_12" sourceRef="Task_0s79ile" targetRef="ExclusiveGateway_3"/>

    <endEvent id="EndEvent_1" name="Shipment prepared">
      <incoming>SequenceFlow_10</incoming>
    </endEvent>

    <sequenceFlow id="SequenceFlow_10" sourceRef="ExclusiveGateway_2" targetRef="EndEvent_1"/>
  </process>
</definitions>