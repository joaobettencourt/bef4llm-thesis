<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definition" name="Restaurant Process" targetNamespace="http://example.com">

   <process id="restaurantProcess" isExecutable="true">
     <startEvent id="guestArrives1">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="guestArrives1" targetRef="taskChooseMeal"/>

     <task id="taskChooseMeal" name="Choose meal from menu">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow2" sourceRef="taskChooseMeal" targetRef="taskPlaceOrder"/>

     <task id="taskPlaceOrder" name="Place order at employee">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow3" sourceRef="taskPlaceOrder" targetRef="taskPayAndGetPieper"/>

     <task id="taskPayAndGetPieper" name="Pay and get pieper from employee">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow4</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow4" sourceRef="taskPayAndGetPieper" targetRef="exclusiveGateway1"/>

     <exclusiveGateway id="exclusiveGateway1">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow5</outgoing>
       <outgoing>sequenceFlow6</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow5" sourceRef="exclusiveGateway1" targetRef="taskInformCook">
       <conditionExpression xsi:type="tFormalExpression">${pieperActivated}</conditionExpression>
     </sequenceFlow>

     <task id="taskInformCook" name="Inform cook about order">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow7</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow7" sourceRef="taskInformCook" targetRef="taskPrepareMeal"/>

     <task id="taskPrepareMeal" name="Prepare meal">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow8</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow8" sourceRef="taskPrepareMeal" targetRef="taskInformEmployeeAboutReadyMeal"/>

     <task id="taskInformEmployeeAboutReadyMeal" name="Inform employee about ready meal">
       <incoming>sequenceFlow8</incoming>
       <outgoing>sequenceFlow9</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow9" sourceRef="taskInformEmployeeAboutReadyMeal" targetRef="taskTriggerPieper"/>

     <task id="taskTriggerPieper" name="Trigger pieper for guest">
       <incoming>sequenceFlow9</incoming>
       <outgoing>sequenceFlow10</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow10" sourceRef="taskTriggerPieper" targetRef="exclusiveGateway2"/>

     <exclusiveGateway id="exclusiveGateway2">
       <incoming>sequenceFlow10</incoming>
       <outgoing>sequenceFlow11</outgoing>
       <outgoing>sequenceFlow12</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow11" sourceRef="exclusiveGateway2" targetRef="taskHandOverMeal">
       <conditionExpression xsi:type="tFormalExpression">${guestPicksUpMeal}</conditionExpression>
     </sequenceFlow>

     <task id="taskHandOverMeal" name="Hand over meal to guest">
       <incoming>sequenceFlow11</incoming>
       <outgoing>sequenceFlow13</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow13" sourceRef="taskHandOverMeal" targetRef="endEvent1"/>

     <sequenceFlow id="sequenceFlow12" sourceRef="exclusiveGateway2" targetRef="taskCallGuestAfter5Minutes">
       <conditionExpression xsi:type="tFormalExpression">${guestDoesntReact}</conditionExpression>
     </sequenceFlow>

     <task id="taskCallGuestAfter5Minutes" name="Call guest after 5 minutes">
       <incoming>sequenceFlow12</incoming>
       <outgoing>sequenceFlow14</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow14" sourceRef="taskCallGuestAfter5Minutes" targetRef="exclusiveGateway2"/>

     <endEvent id="endEvent1">
       <incoming>sequenceFlow13</incoming>
     </endEvent>
   </process>
 </definitions>