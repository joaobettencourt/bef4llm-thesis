<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definitions" 
             targetNamespace="http://example.com/bpmn">

   <process id="RoboticBurgerSellerProcess" isExecutable="true">
     <startEvent id="StartEvent_1" name="New Order Received">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="ExclusiveGateway_1"/>

     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
       <outgoing>SequenceFlow_3</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_2" sourceRef="ExclusiveGateway_1" targetRef="Task_1">
       <conditionExpression xsi:type="tFormalExpression">${wantMenu == true}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_1" targetRef="Task_4">
       <conditionExpression xsi:type="tFormalExpression">${wantMenu == false}</conditionExpression>
     </sequenceFlow>

     <task id="PrepareDrinkTask" name="Prepare Drink">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_4</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_4" sourceRef="PrepareDrinkTask" targetRef="ExclusiveGateway_2"/>

     <exclusiveGateway id="ExclusiveGateway_2">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_5</outgoing>
       <outgoing>SequenceFlow_6</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_5" sourceRef="ExclusiveGateway_2" targetRef="PrepareFriesTask">
       <conditionExpression xsi:type="tFormalExpression">${wantFries == true}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="SequenceFlow_6" sourceRef="ExclusiveGateway_2" targetRef="PrepareWedgesTask">
       <conditionExpression xsi:type="tFormalExpression">${wantWedges == true}</conditionExpression>
     </sequenceFlow>

     <task id="PrepareFriesTask" name="Prepare Fries">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_7</outgoing>
     </task>

     <task id="PrepareWedgesTask" name="Prepare Wedges">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_8</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_7" sourceRef="PrepareFriesTask" targetRef="PrepareBurgerTask"/>
     <sequenceFlow id="SequenceFlow_8" sourceRef="PrepareWedgesTask" targetRef="PrepareBurgerTask"/>

     <task id="PrepareBurgerTask" name="Prepare Burger">
       <incoming>SequenceFlow_3</incoming>
       <incoming>SequenceFlow_7</incoming>
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_9" sourceRef="PrepareBurgerTask" targetRef="ServiceTask_1"/>

     <serviceTask id="ServiceTask_1" name="Give Status Updates">
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_10</outgoing>
     </serviceTask>

     <sequenceFlow id="SequenceFlow_10" sourceRef="ServiceTask_1" targetRef="EndEvent_1"/>

     <endEvent id="EndEvent_1" name="Order Delivered">
       <incoming>SequenceFlow_10</incoming>
     </endEvent>
   </process>
 </definitions>