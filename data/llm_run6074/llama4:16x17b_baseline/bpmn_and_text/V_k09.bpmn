<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definitions" name="Storage Management">

   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1" name="Read Order from Automatic Order Management System">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>

     <task id="Task_1" name="Check if Product is in Stock">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
       <outgoing>SequenceFlow_3</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="Task_2">
       <conditionExpression xsi:type="tFormalExpression">${productInStock == true}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="SequenceFlow_3" sourceRef="Task_1" targetRef="Task_3">
       <conditionExpression xsi:type="tFormalExpression">${productInStock == false}</conditionExpression>
     </sequenceFlow>

     <task id="Task_2" name="Withdraw Product from Warehouse">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_4</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_4" sourceRef="Task_2" targetRef="Gateway_1"/>

     <task id="Task_3" name="Reorder Product from Wholesaler">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_3" targetRef="IntermediateEvent_1"/>

     <intermediateEvent id="IntermediateEvent_1" name="Wait for Product Arrival">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </intermediateEvent>

     <sequenceFlow id="SequenceFlow_6" sourceRef="IntermediateEvent_1" targetRef="Gateway_2"/>

     <exclusiveGateway id="Gateway_2">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_7</outgoing>
       <outgoing>SequenceFlow_8</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_7" sourceRef="Gateway_2" targetRef="Task_4">
       <conditionExpression xsi:type="tFormalExpression">${waitingTime > 10}</conditionExpression>
     </sequenceFlow>

     <task id="Task_4" name="Demand Delivery Delay Penalty from Wholesaler">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_4" targetRef="Task_5"/>

     <sequenceFlow id="SequenceFlow_8" sourceRef="Gateway_2" targetRef="Task_5"/>

     <task id="Task_5" name="Register Product in Stock Management System">
       <incoming>SequenceFlow_8</incoming>
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_10</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_10" sourceRef="Task_5" targetRef="Gateway_1"/>

     <exclusiveGateway id="Gateway_1">
       <incoming>SequenceFlow_4</incoming>
       <incoming>SequenceFlow_10</incoming>
       <outgoing>SequenceFlow_11</outgoing>
       <outgoing>SequenceFlow_12</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_11" sourceRef="Gateway_1" targetRef="Task_6">
       <conditionExpression xsi:type="tFormalExpression">${orderReadyForShipment == true}</conditionExpression>
     </sequenceFlow>

     <task id="Task_6" name="Request Courier and Pack Products">
       <incoming>SequenceFlow_11</incoming>
       <outgoing>SequenceFlow_13</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_12" sourceRef="Gateway_1" targetRef="Task_1"/>

     <task id="Task_7" name="Ship Products">
       <incoming>SequenceFlow_13</incoming>
     </task>

     <sequenceFlow id="SequenceFlow_13" sourceRef="Task_6" targetRef="Task_7"/>
   </process>
 </definitions>