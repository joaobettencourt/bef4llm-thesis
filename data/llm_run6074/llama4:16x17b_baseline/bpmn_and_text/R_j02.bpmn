<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definitions" 
             targetNamespace="http://example.com/bpmn">

   <process id="inspectionProcess" isExecutable="true">
     <startEvent id="startEvent1">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="task1"/>

     <task id="task1" name="Enter Machine Type and Serial Number">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow2" sourceRef="task1" targetRef="exclusiveGateway1"/>

     <exclusiveGateway id="exclusiveGateway1">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
       <outgoing>sequenceFlow4</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow3" sourceRef="exclusiveGateway1" targetRef="task2">
       <!-- conditionExpression -->
     </sequenceFlow>

     <sequenceFlow id="sequenceFlow4" sourceRef="exclusiveGateway1" targetRef="task3">
       <!-- conditionExpression -->
     </sequenceFlow>

     <task id="task2" name="Input Values for Questions">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow5</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow5" sourceRef="task2" targetRef="exclusiveGateway2"/>

     <exclusiveGateway id="exclusiveGateway2">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow6</outgoing>
       <outgoing>sequenceFlow7</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow6" sourceRef="exclusiveGateway2" targetRef="task4">
       <!-- conditionExpression -->
     </sequenceFlow>

     <sequenceFlow id="sequenceFlow7" sourceRef="exclusiveGateway2" targetRef="endEvent1"/>

     <task id="task3" name="Automatic Collection of Values from Machine">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow8</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow8" sourceRef="task3" targetRef="exclusiveGateway2"/>

     <task id="task4" name="Input Additional Values for Questions">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow9</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow9" sourceRef="task4" targetRef="endEvent1"/>

     <endEvent id="endEvent1" name="Inspection Completed">
       <incoming>sequenceFlow7</incoming>
       <incoming>sequenceFlow9</incoming>
     </endEvent>
   </process>

</definitions>