<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definitions" name="Chainsaw Production Process" targetNamespace="http://example.com">

   <process id="chainsaw-production-process" isExecutable="true">
     <startEvent id="start-event-1" name="New Order Received">
       <outgoing>sequence-flow-1</outgoing>
     </startEvent>

     <sequenceFlow id="sequence-flow-1" sourceRef="start-event-1" targetRef="task-1"/>

     <task id="task-1" name="Determine Chainsaw Properties">
       <incoming>sequence-flow-1</incoming>
       <outgoing>sequence-flow-2</outgoing>
     </task>

     <sequenceFlow id="sequence-flow-2" sourceRef="task-1" targetRef="parallel-gateway-1"/>

     <parallelGateway id="parallel-gateway-1">
       <incoming>sequence-flow-2</incoming>
       <outgoing>sequence-flow-3</outgoing>
       <outgoing>sequence-flow-4</outgoing>
       <outgoing>sequence-flow-5</outgoing>
       <outgoing>sequence-flow-6</outgoing>
       <outgoing>sequence-flow-7</outgoing>
     </parallelGateway>

     <task id="task-2" name="Order Guide Bar">
       <incoming>sequence-flow-3</incoming>
       <outgoing>sequence-flow-8</outgoing>
     </task>
     <sequenceFlow id="sequence-flow-3" sourceRef="parallel-gateway-1" targetRef="task-2"/>
     <sequenceFlow id="sequence-flow-8" sourceRef="task-2" targetRef="intermediate-event-1"/>

     <task id="task-3" name="Order Chain">
       <incoming>sequence-flow-4</incoming>
       <outgoing>sequence-flow-9</outgoing>
     </task>
     <sequenceFlow id="sequence-flow-4" sourceRef="parallel-gateway-1" targetRef="task-3"/>
     <sequenceFlow id="sequence-flow-9" sourceRef="task-3" targetRef="intermediate-event-1"/>

     <task id="task-4" name="Order Motor">
       <incoming>sequence-flow-5</incoming>
       <outgoing>sequence-flow-10</outgoing>
     </task>
     <sequenceFlow id="sequence-flow-5" sourceRef="parallel-gateway-1" targetRef="task-4"/>
     <sequenceFlow id="sequence-flow-10" sourceRef="task-4" targetRef="intermediate-event-1"/>

     <task id="task-5" name="Order Electronics">
       <incoming>sequence-flow-6</incoming>
       <outgoing>sequence-flow-11</outgoing>
     </task>
     <sequenceFlow id="sequence-flow-6" sourceRef="parallel-gateway-1" targetRef="task-5"/>
     <sequenceFlow id="sequence-flow-11" sourceRef="task-5" targetRef="intermediate-event-1"/>

     <task id="task-6" name="Order Additional Parts">
       <incoming>sequence-flow-7</incoming>
       <outgoing>sequence-flow-12</outgoing>
     </task>
     <sequenceFlow id="sequence-flow-7" sourceRef="parallel-gateway-1" targetRef="task-6"/>
     <sequenceFlow id="sequence-flow-12" sourceRef="task-6" targetRef="intermediate-event-1"/>

     <intermediateEvent id="intermediate-event-1" name="Parts Arrived">
       <incoming>sequence-flow-8</incoming>
       <incoming>sequence-flow-9</incoming>
       <incoming>sequence-flow-10</incoming>
       <incoming>sequence-flow-11</incoming>
       <incoming>sequence-flow-12</incoming>
       <outgoing>sequence-flow-13</outgoing>
     </intermediateEvent>

     <sequenceFlow id="sequence-flow-13" sourceRef="intermediate-event-1" targetRef="task-7"/>

     <task id="task-7" name="Inspect Parts">
       <incoming>sequence-flow-13</incoming>
       <outgoing>sequence-flow-14</outgoing>
     </task>

     <sequenceFlow id="sequence-flow-14" sourceRef="task-7" targetRef="task-8"/>

     <task id="task-8" name="Assemble Chainsaw">
       <incoming>sequence-flow-14</incoming>
       <outgoing>sequence-flow-15</outgoing>
     </task>

     <intermediateEvent id="intermediate-event-2" name="Chainsaw Produced">
       <incoming>sequence-flow-15</incoming>
       <outgoing>sequence-flow-16</outgoing>
     </intermediateEvent>

     <sequenceFlow id="sequence-flow-16" sourceRef="task-8" targetRef="task-9"/>

     <task id="task-9" name="Send Update to Customer">
       <incoming>sequence-flow-16</incoming>
       <outgoing>sequence-flow-17</outgoing>
     </task>

     <sequenceFlow id="sequence-flow-17" sourceRef="task-9" targetRef="exclusive-gateway-1"/>

     <exclusiveGateway id="exclusive-gateway-1">
       <incoming>sequence-flow-17</incoming>
       <outgoing>sequence-flow-18</outgoing>
       <outgoing>sequence-flow-19</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequence-flow-18" sourceRef="exclusive-gateway-1" targetRef="task-10"/>

     <task id="task-10" name="Send Chainsaw to Customer">
       <incoming>sequence-flow-18</incoming>
       <outgoing>sequence-flow-20</outgoing>
     </task>

     <sequenceFlow id="sequence-flow-20" sourceRef="task-10" targetRef="exclusive-gateway-2"/>

     <exclusiveGateway id="exclusive-gateway-2">
       <incoming>sequence-flow-20</incoming>
       <outgoing>sequence-flow-21</outgoing>
       <outgoing>sequence-flow-22</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequence-flow-21" sourceRef="exclusive-gateway-2" targetRef="end-event-1"/>

     <endEvent id="end-event-1" name="Order Fulfilled">
       <incoming>sequence-flow-21</incoming>
     </endEvent>

     <sequenceFlow id="sequence-flow-19" sourceRef="exclusive-gateway-1" targetRef="end-event-2"/>
     <endEvent id="end-event-2" name="Customer Rejected">
       <incoming>sequence-flow-19</incoming>
     </endEvent>
   </process>
</definitions>