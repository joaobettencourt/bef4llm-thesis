<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definitions" 
             targetNamespace="http://example.com/bpmn">

   <process id="OrderingProcess" isExecutable="true">
     <startEvent id="StartEvent_1" name="Customer Login">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="ExclusiveGateway_1"/>

     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
       <outgoing>SequenceFlow_3</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_2" sourceRef="ExclusiveGateway_1" targetRef="Task_1">
       <conditionExpression xsi:type="tFormalExpression">${loginSuccess}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_1">
       <conditionExpression xsi:type="tFormalExpression">${not loginSuccess}</conditionExpression>
     </sequenceFlow>

     <task id="Task_1" name="Select Products">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_4</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_4" sourceRef="Task_1" targetRef="ExclusiveGateway_2"/>

     <exclusiveGateway id="ExclusiveGateway_2">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_5</outgoing>
       <outgoing>SequenceFlow_6</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_5" sourceRef="ExclusiveGateway_2" targetRef="Task_2">
       <conditionExpression xsi:type="tFormalExpression">${allProductsSelected}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="SequenceFlow_6" sourceRef="ExclusiveGateway_2" targetRef="Task_3">
       <conditionExpression xsi:type="tFormalExpression">${not allProductsSelected}</conditionExpression>
     </sequenceFlow>

     <task id="Task_2" name="Finish Order and Prepare Payment/Shipping">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_7</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_7" sourceRef="Task_2" targetRef="ParallelGateway_1"/>

     <parallelGateway id="ParallelGateway_1">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_8</outgoing>
       <outgoing>SequenceFlow_9</outgoing>
     </parallelGateway>

     <sequenceFlow id="SequenceFlow_8" sourceRef="ParallelGateway_1" targetRef="Task_4"/>

     <task id="Task_3" name="Add Product to Cart and Save">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_10</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_10" sourceRef="Task_3" targetRef="Task_1"/>

     <task id="Task_4" name="Enter Payment Data and Wait for Bank Confirmation">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_11</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_11" sourceRef="Task_4" targetRef="Task_5"/>

     <task id="Task_5" name="Enter Shipping Address">
       <incoming>SequenceFlow_11</incoming>
       <outgoing>SequenceFlow_12</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_12" sourceRef="Task_5" targetRef="ExclusiveGateway_3"/>

     <exclusiveGateway id="ExclusiveGateway_3">
       <incoming>SequenceFlow_12</incoming>
       <outgoing>SequenceFlow_13</outgoing>
       <outgoing>SequenceFlow_14</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_9" sourceRef="ParallelGateway_1" targetRef="ExclusiveGateway_3"/>

     <sequenceFlow id="SequenceFlow_13" sourceRef="ExclusiveGateway_3" targetRef="EndEvent_2">
       <conditionExpression xsi:type="tFormalExpression">${paymentAndAddressComplete}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="SequenceFlow_14" sourceRef="ExclusiveGateway_3" targetRef="Task_4">
       <conditionExpression xsi:type="tFormalExpression">${not paymentAndAddressComplete}</conditionExpression>
     </sequenceFlow>

     <endEvent id="EndEvent_1" name="Login Failed">
       <incoming>SequenceFlow_3</incoming>
     </endEvent>

     <endEvent id="EndEvent_2" name="Order Completed">
       <incoming>SequenceFlow_13</incoming>
     </endEvent>
   </process>
 </definitions>