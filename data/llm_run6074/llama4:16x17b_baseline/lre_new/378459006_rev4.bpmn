<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" targetNamespace="http://www.example.com">
  <process id="PaymentProcess" isExecutable="true">
    <startEvent id="WeeklyPaymentReport">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="WeeklyPaymentReport" targetRef="Task_GeneratePaymentReport"/>
    <task id="Task_GeneratePaymentReport" name="Generate payment report">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_GeneratePaymentReport" targetRef="Task_PayVendor"/>
    <task id="Task_PayVendor" name="Pay vendor">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_3" sourceRef="Task_PayVendor" targetRef="Task_SendPaymentReportToClients"/>
    <task id="Task_SendPaymentReportToClients" name="Send payment report to clients (including invoice)">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_4</outgoing>
      <outgoing>SequenceFlow_5</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_4" sourceRef="Task_SendPaymentReportToClients" targetRef="Task_SendPaymentReportToRegistryOffice"/>
    <task id="Task_SendPaymentReportToRegistryOffice" name="Send payment report to Registry office">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_5" sourceRef="Task_SendPaymentReportToClients" targetRef="Task_SendPaymentReportToAccountsReceivable"/>
    <task id="Task_SendPaymentReportToAccountsReceivable" name="Send payment report to Accounts Receivable Department">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_6" sourceRef="Task_SendPaymentReportToRegistryOffice" targetRef="Task_ArchiveInvoices"/>
    <task id="Task_ArchiveInvoices" name="Archive invoices per vendor and payment data">
      <incoming>SequenceFlow_6</incoming>
    </task>
    <sequenceFlow id="SequenceFlow_7" sourceRef="Task_SendPaymentReportToAccountsReceivable" targetRef="Task_GenerateMonthlyInvoice"/>
    <task id="Task_GenerateMonthlyInvoice" name="Generate monthly invoice for clients">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_8" sourceRef="Task_GenerateMonthlyInvoice" targetRef="Task_ChargeClient"/>
    <task id="Task_ChargeClient" name="Charge client $35 per invoice and notify">
      <incoming>SequenceFlow_8</incoming>
    </task>
    <endEvent id="EndEvent_1">
      <incoming>SequenceFlow_9</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_9" sourceRef="Task_ArchiveInvoices" targetRef="EndEvent_1"/>
  </process>
</definitions>