<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" targetNamespace="http://www.example.com">
  <process id="WebDesignProcess" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>
    <task id="Task_1" name="Informational meeting among the web design team">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </task>
    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
      <outgoing>SequenceFlow_4</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="ExclusiveGateway_1"/>
    <sequenceFlow id="SequenceFlow_3" name="yes" sourceRef="ExclusiveGateway_1" targetRef="Task_2">
      <conditionExpression xsi:type="tFormalExpression">${meetingSuccessful == true}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="SequenceFlow_4" name="no" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_1">
      <conditionExpression xsi:type="tFormalExpression">${meetingSuccessful == false}</conditionExpression>
    </sequenceFlow>
    <task id="Task_2" name="Create a storyboard">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_5</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_5" sourceRef="Task_2" targetRef="Task_3"/>
    <parallelGateway id="ParallelGateway_1">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_6</outgoing>
      <outgoing>SequenceFlow_7</outgoing>
    </parallelGateway>
    <task id="Task_3" name="Design and development of the website">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_6" sourceRef="ParallelGateway_1" targetRef="Task_3"/>
    <task id="Task_4" name="Prepare an initial draft of the content">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_9</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_7" sourceRef="ParallelGateway_1" targetRef="Task_4"/>
    <exclusiveGateway id="ExclusiveGateway_2">
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_10</outgoing>
      <outgoing>SequenceFlow_11</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_9" sourceRef="Task_4" targetRef="ExclusiveGateway_2"/>
    <sequenceFlow id="SequenceFlow_10" name="yes" sourceRef="ExclusiveGateway_2" targetRef="Task_5">
      <conditionExpression xsi:type="tFormalExpression">${draftNeedsReview == true}</conditionExpression>
    </sequenceFlow>
    <task id="Task_5" name="Marketing team review draft">
      <incoming>SequenceFlow_10</incoming>
      <outgoing>SequenceFlow_12</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_12" sourceRef="Task_5" targetRef="Task_6"/>
    <task id="Task_6" name="Create final version of the content">
      <incoming>SequenceFlow_12</incoming>
      <incoming>SequenceFlow_11</incoming>
      <outgoing>SequenceFlow_13</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_11" name="no" sourceRef="ExclusiveGateway_2" targetRef="Task_6">
      <conditionExpression xsi:type="tFormalExpression">${draftNeedsReview == false}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="SequenceFlow_13" sourceRef="Task_6" targetRef="ParallelGateway_2"/>
    <parallelGateway id="ParallelGateway_2">
      <incoming>SequenceFlow_8</incoming>
      <incoming>SequenceFlow_13</incoming>
      <outgoing>SequenceFlow_14</outgoing>
    </parallelGateway>
    <task id="Task_7" name="Build the website">
      <incoming>SequenceFlow_14</incoming>
      <outgoing>SequenceFlow_15</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_14" sourceRef="ParallelGateway_2" targetRef="Task_7"/>
    <exclusiveGateway id="ExclusiveGateway_3">
      <incoming>SequenceFlow_15</incoming>
      <outgoing>SequenceFlow_16</outgoing>
      <outgoing>SequenceFlow_17</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_15" sourceRef="Task_7" targetRef="ExclusiveGateway_3"/>
    <sequenceFlow id="SequenceFlow_16" name="yes" sourceRef="ExclusiveGateway_3" targetRef="EndEvent_2">
      <conditionExpression xsi:type="tFormalExpression">${siteApproved == true}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="SequenceFlow_17" name="no" sourceRef="ExclusiveGateway_3" targetRef="Task_7">
      <conditionExpression xsi:type="tFormalExpression">${siteApproved == false}</conditionExpression>
    </sequenceFlow>
    <endEvent id="EndEvent_1">
      <incoming>SequenceFlow_4</incoming>
    </endEvent>
    <endEvent id="EndEvent_2">
      <incoming>SequenceFlow_16</incoming>
    </endEvent>
  </process>
</definitions>