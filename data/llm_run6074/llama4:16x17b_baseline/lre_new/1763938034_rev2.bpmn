<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" targetNamespace="http://www.example.com">

  <process id="RewardAndTrainingProcess" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>

    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_CheckPerformance"/>

    <task id="Task_CheckPerformance" name="Check employee performance">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_CheckPerformance" targetRef="ExclusiveGateway_PerformanceEvaluation"/>

    <exclusiveGateway id="ExclusiveGateway_PerformanceEvaluation">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
      <outgoing>SequenceFlow_4</outgoing>
      <outgoing>SequenceFlow_5</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow_3" name="performance < 20%" sourceRef="ExclusiveGateway_PerformanceEvaluation" targetRef="Task_SuggestDismissal">
      <conditionExpression xsi:type="tFormalExpression">${performance <= 20}</conditionExpression>
    </sequenceFlow>

    <task id="Task_SuggestDismissal" name="Suggest dismissal to HR">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_6" sourceRef="Task_SuggestDismissal" targetRef="Task_DismissEmployee"/>

    <task id="Task_DismissEmployee" name="Dismiss employee">
      <incoming>SequenceFlow_6</incoming>
    </task>

    <sequenceFlow id="SequenceFlow_4" name="20% <= performance < 50%" sourceRef="ExclusiveGateway_PerformanceEvaluation" targetRef="Task_SuggestTraining">
      <conditionExpression xsi:type="tFormalExpression">${performance >= 20 and performance < 50}</conditionExpression>
    </sequenceFlow>

    <task id="Task_SuggestTraining" name="Suggest training to HR">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_7" sourceRef="Task_SuggestTraining" targetRef="Task_ProvideTraining"/>

    <task id="Task_ProvideTraining" name="Provide training">
      <incoming>SequenceFlow_7</incoming>
    </task>

    <sequenceFlow id="SequenceFlow_5" name="performance >= 75%" sourceRef="ExclusiveGateway_PerformanceEvaluation" targetRef="Task_SuggestReward">
      <conditionExpression xsi:type="tFormalExpression">${performance >= 75}</conditionExpression>
    </sequenceFlow>

    <task id="Task_SuggestReward" name="Suggest reward to management">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </task>

    <exclusiveGateway id="ExclusiveGateway_RewardType">
      <incoming>SequenceFlow_8</incoming>
      <outgoing>SequenceFlow_9</outgoing>
      <outgoing>SequenceFlow_10</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow_8" sourceRef="Task_SuggestReward" targetRef="ExclusiveGateway_RewardType"/>

    <sequenceFlow id="SequenceFlow_9" name="financial reward" sourceRef="ExclusiveGateway_RewardType" targetRef="Task_CalculateFinancialReward">
      <conditionExpression xsi:type="tFormalExpression">${rewardType == 'financial'}</conditionExpression>
    </sequenceFlow>

    <task id="Task_CalculateFinancialReward" name="Calculate and pay financial reward">
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_11</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_10" name="other benefit" sourceRef="ExclusiveGateway_RewardType" targetRef="Task_ChooseBenefit">
      <conditionExpression xsi:type="tFormalExpression">${rewardType == 'benefit'}</conditionExpression>
    </sequenceFlow>

    <task id="Task_ChooseBenefit" name="Choose appropriate benefit">
      <incoming>SequenceFlow_10</incoming>
      <outgoing>SequenceFlow_11</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_11" sourceRef="Task_CalculateFinancialReward" targetRef="Task_AnnounceEmployeeOfTheMonth"/>
    <sequenceFlow id="SequenceFlow_12" sourceRef="Task_ChooseBenefit" targetRef="Task_AnnounceEmployeeOfTheMonth"/>

    <task id="Task_AnnounceEmployeeOfTheMonth" name="Announce rewarded employee as employee of the month">
      <incoming>SequenceFlow_11</incoming>
      <incoming>SequenceFlow_12</incoming>
    </task>

    <endEvent id="EndEvent_1">
      <incoming>SequenceFlow_13</incoming>
    </endEvent>

    <sequenceFlow id="SequenceFlow_13" sourceRef="Task_AnnounceEmployeeOfTheMonth" targetRef="EndEvent_1"/>
  </process>
</definitions>