<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" targetNamespace="http://www.example.com">
  <process id="BankAccountLinkingProcess" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>sf1</outgoing>
    </startEvent>
    <sequenceFlow id="sf1" sourceRef="StartEvent_1" targetRef="Task_1"/>
    <task id="Task_1" name="Enter bank details">
      <incoming>sf1</incoming>
      <outgoing>sf2</outgoing>
    </task>
    <sequenceFlow id="sf2" sourceRef="Task_1" targetRef="ServiceTask_1"/>
    <serviceTask id="ServiceTask_1" name="Submit bank details to PayPal system">
      <incoming>sf2</incoming>
      <outgoing>sf3</outgoing>
    </serviceTask>
    <sequenceFlow id="sf3" sourceRef="ServiceTask_1" targetRef="IntermediateEvent_1"/>
    <intermediateEvent id="IntermediateEvent_1" name="Make two random deposits">
      <incoming>sf3</incoming>
      <outgoing>sf4</outgoing>
    </intermediateEvent>
    <sequenceFlow id="sf4" sourceRef="IntermediateEvent_1" targetRef="Task_2"/>
    <task id="Task_2" name="Notify client to check bank account">
      <incoming>sf4</incoming>
      <outgoing>sf5</outgoing>
    </task>
    <sequenceFlow id="sf5" sourceRef="Task_2" targetRef="Task_3"/>
    <task id="Task_3" name="Enter deposit amounts and verify">
      <incoming>sf5</incoming>
    </task>
    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>sf6</incoming>
      <outgoing>sf7</outgoing>
      <outgoing>sf8</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="sf6" sourceRef="Task_3" targetRef="ExclusiveGateway_1"/>
    <sequenceFlow id="sf7" name="yes" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_1">
      <conditionExpression xsi:type="tFormalExpression">${depositAmountsMatch  == true}</conditionExpression>
    </sequenceFlow>
    <endEvent id="EndEvent_1" name="Bank account linked and confirmed">
      <incoming>sf7</incoming>
    </endEvent>
    <sequenceFlow id="sf8" name="no" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_2">
      <conditionExpression xsi:type="tFormalExpression">${depositAmountsMatch  == false}</conditionExpression>
    </sequenceFlow>
    <endEvent id="EndEvent_2" name="Bank account not confirmed and removed">
      <incoming>sf8</incoming>
    </endEvent>
  </process>
</definitions>