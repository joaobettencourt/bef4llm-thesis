<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" targetNamespace="http://www.example.com">

  <process id="CreditProcess" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>

    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>

    <task id="Task_1" name="Collect credit information">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="ExclusiveGateway_1"/>

    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
      <outgoing>SequenceFlow_4</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow_3" name="amount > 1M$" sourceRef="ExclusiveGateway_1" targetRef="Task_2">
      <conditionExpression xsi:type="tFormalExpression">${requestedAmount > 1000000}</conditionExpression>
    </sequenceFlow>

    <task id="Task_2" name="Request approval">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_5</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_5" sourceRef="Task_2" targetRef="ExclusiveGateway_2"/>

    <exclusiveGateway id="ExclusiveGateway_2">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_6</outgoing>
      <outgoing>SequenceFlow_7</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow_6" name="credit accepted" sourceRef="ExclusiveGateway_2" targetRef="Task_3">
      <conditionExpression xsi:type="tFormalExpression">${approvalStatus == 'accepted'}</conditionExpression>
    </sequenceFlow>

    <task id="Task_3" name="Send email to customer (accepted)">
      <incoming>SequenceFlow_6</incoming>
    </task>

    <sequenceFlow id="SequenceFlow_7" name="credit rejected" sourceRef="ExclusiveGateway_2" targetRef="Task_4">
      <conditionExpression xsi:type="tFormalExpression">${approvalStatus == 'rejected'}</conditionExpression>
    </sequenceFlow>

    <task id="Task_4" name="Send email to customer (rejected)">
      <incoming>SequenceFlow_7</incoming>
    </task>

    <sequenceFlow id="SequenceFlow_4" name="amount <= 1M$" sourceRef="ExclusiveGateway_1" targetRef="Task_8">
      <conditionExpression xsi:type="tFormalExpression">${requestedAmount <= 1000000}</conditionExpression>
    </sequenceFlow>

    <task id="Task_8" name="Assess risk">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_9</outgoing>
      <outgoing>SequenceFlow_10</outgoing>
    </task>

    <exclusiveGateway id="ExclusiveGateway_3">
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_11</outgoing>
      <outgoing>SequenceFlow_12</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow_9" sourceRef="Task_8" targetRef="ExclusiveGateway_3">
      <conditionExpression xsi:type="tFormalExpression">${riskLevel == 'low'}</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="SequenceFlow_10" sourceRef="Task_8" targetRef="Task_2">
      <conditionExpression xsi:type="tFormalExpression">${riskLevel == 'high'}</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="SequenceFlow_11" name="accept credit" sourceRef="ExclusiveGateway_3" targetRef="Task_5">
      <conditionExpression xsi:type="tFormalExpression">${approvalStatus == 'accepted'}</conditionExpression>
    </sequenceFlow>

    <task id="Task_5" name="Send email to customer (credit accepted)">
      <incoming>SequenceFlow_11</incoming>
    </task>

    <endEvent id="EndEvent_1">
      <incoming>SequenceFlow_11</incoming>
    </endEvent>

    <sequenceFlow id="SequenceFlow_12" name="reject credit" sourceRef="ExclusiveGateway_3" targetRef="Task_6">
      <conditionExpression xsi:type="tFormalExpression">${approvalStatus == 'rejected'}</conditionExpression>
    </sequenceFlow>

    <task id="Task_6" name="Send email to customer (credit rejected)">
      <incoming>SequenceFlow_12</incoming>
    </task>

    <endEvent id="EndEvent_2">
      <incoming>SequenceFlow_12</incoming>
    </endEvent>
  </process>
</definitions>