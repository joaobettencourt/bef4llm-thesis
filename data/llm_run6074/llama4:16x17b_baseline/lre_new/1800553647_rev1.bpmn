<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" targetNamespace="http://www.example.com">
  <process id="PurchaseProcess" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>
    <task id="Task_1" name="Identify demand and check stock">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
      <outgoing>SequenceFlow_3</outgoing>
    </task>
    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_4</outgoing>
      <outgoing>SequenceFlow_5</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="ExclusiveGateway_1">
      <conditionExpression xsi:type="tFormalExpression">${enoughGoodsInStock}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="SequenceFlow_3" sourceRef="Task_1" targetRef="ExclusiveGateway_1">
      <conditionExpression xsi:type="tFormalExpression">${not enoughGoodsInStock}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_1">
      <conditionExpression xsi:type="tFormalExpression">${goodsConsumedLocally}</conditionExpression>
    </sequenceFlow>
    <task id="Task_2" name="Create purchase requisition">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_5" sourceRef="ExclusiveGateway_1" targetRef="Task_2"/>
    <userTask id="UserTask_1" name="Process purchase requisition">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </userTask>
    <sequenceFlow id="SequenceFlow_6" sourceRef="Task_2" targetRef="UserTask_1"/>
    <exclusiveGateway id="ExclusiveGateway_2">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_8</outgoing>
      <outgoing>SequenceFlow_9</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_7" sourceRef="UserTask_1" targetRef="ExclusiveGateway_2"/>
    <task id="Task_3" name="Create supplier in ERP">
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_10</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_9" sourceRef="ExclusiveGateway_2" targetRef="Task_3">
      <conditionExpression xsi:type="tFormalExpression">${newSupplier}</conditionExpression>
    </sequenceFlow>
    <task id="Task_4" name="Create order template in ERP">
      <incoming>SequenceFlow_10</incoming>
      <incoming>SequenceFlow_8</incoming>
      <outgoing>SequenceFlow_11</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_10" sourceRef="Task_3" targetRef="Task_4"/>
    <sequenceFlow id="SequenceFlow_8" sourceRef="ExclusiveGateway_2" targetRef="Task_4">
      <conditionExpression xsi:type="tFormalExpression">${knownSupplier}</conditionExpression>
    </sequenceFlow>
    <userTask id="UserTask_2" name="Approve order template">
      <incoming>SequenceFlow_11</incoming>
      <outgoing>SequenceFlow_12</outgoing>
    </userTask>
    <sequenceFlow id="SequenceFlow_11" sourceRef="Task_4" targetRef="UserTask_2"/>
    <endEvent id="EndEvent_1">
      <incoming>SequenceFlow_12</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_12" sourceRef="UserTask_2" targetRef="EndEvent_1"/>
  </process>
</definitions>