<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" targetNamespace="http://www.example.com">
  <process id="AddCreditCardProcess" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>
    <task id="Task_1" name="Enter credit card details">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="Task_2"/>
    <task id="Task_2" name="Check billing address">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
      <outgoing>SequenceFlow_4</outgoing>
    </task>
    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_5</outgoing>
      <outgoing>SequenceFlow_6</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_3" sourceRef="Task_2" targetRef="ExclusiveGateway_1">
      <conditionExpression xsi:type="tFormalExpression">${billingAddressCorrect == true}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="SequenceFlow_4" sourceRef="Task_2" targetRef="ExclusiveGateway_1">
      <conditionExpression xsi:type="tFormalExpression">${billingAddressCorrect == false}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="SequenceFlow_5" sourceRef="ExclusiveGateway_1" targetRef="Task_3">
      <conditionExpression xsi:type="tFormalExpression">${billingAddressCorrect == true}</conditionExpression>
    </sequenceFlow>
    <task id="Task_3" name="User confirms billing address">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_6" sourceRef="ExclusiveGateway_1" targetRef="Task_1">
      <conditionExpression xsi:type="tFormalExpression">${billingAddressCorrect == false}</conditionExpression>
    </sequenceFlow>
    <userTask id="UserTask_1" name="Click continue button">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </userTask>
    <sequenceFlow id="SequenceFlow_7" sourceRef="Task_3" targetRef="UserTask_1"/>
    <serviceTask id="ServiceTask_1" name="Verify credit card">
      <incoming>SequenceFlow_8</incoming>
      <outgoing>SequenceFlow_9</outgoing>
    </serviceTask>
    <sequenceFlow id="SequenceFlow_8" sourceRef="UserTask_1" targetRef="ServiceTask_1"/>
    <exclusiveGateway id="ExclusiveGateway_2">
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_10</outgoing>
      <outgoing>SequenceFlow_11</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_9" sourceRef="ServiceTask_1" targetRef="ExclusiveGateway_2">
      <conditionExpression xsi:type="tFormalExpression">${creditCardVerified == true}</conditionExpression>
    </sequenceFlow>
    <task id="Task_4" name="Add credit card">
      <incoming>SequenceFlow_10</incoming>
    </task>
    <sequenceFlow id="SequenceFlow_10" sourceRef="ExclusiveGateway_2" targetRef="Task_4">
      <conditionExpression xsi:type="tFormalExpression">${creditCardVerified == true}</conditionExpression>
    </sequenceFlow>
    <endEvent id="EndEvent_1" name="Credit card added successfully">
      <incoming>SequenceFlow_12</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_12" sourceRef="Task_4" targetRef="EndEvent_1"/>
    <task id="Task_5" name="Cancel credit card addition">
      <incoming>SequenceFlow_11</incoming>
    </task>
    <sequenceFlow id="SequenceFlow_11" sourceRef="ExclusiveGateway_2" targetRef="Task_5">
      <conditionExpression xsi:type="tFormalExpression">${creditCardVerified == false}</conditionExpression>
    </sequenceFlow>
    <endEvent id="EndEvent_2" name="Credit card addition cancelled">
      <incoming>SequenceFlow_13</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_13" sourceRef="Task_5" targetRef="EndEvent_2"/>
  </process>
</definitions>