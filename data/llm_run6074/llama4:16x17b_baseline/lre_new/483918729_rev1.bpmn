<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" targetNamespace="http://www.example.com">
  <process id="Process_1" isExecutable="true">
    <startEvent id="StartEvent_1">
      <incoming>None</incoming>
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>
    <task id="Task_1" name="Identify necessary parts">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
      <outgoing>SequenceFlow_3</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="Task_2"/>
    <sequenceFlow id="SequenceFlow_3" sourceRef="Task_1" targetRef="Task_3">
      <conditionExpression xsi:type="tFormalExpression">${requestIncomplete}</conditionExpression>
    </sequenceFlow>
    <task id="Task_2" name="Check parts availability">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_4</outgoing>
      <outgoing>SequenceFlow_5</outgoing>
    </task>
    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_6</outgoing>
      <outgoing>SequenceFlow_7</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_4" sourceRef="Task_2" targetRef="ExclusiveGateway_1"/>
    <sequenceFlow id="SequenceFlow_5" sourceRef="Task_2" targetRef="Task_6">
      <conditionExpression xsi:type="tFormalExpression">${partsNotAvailable}</conditionExpression>
    </sequenceFlow>
    <task id="Task_3" name="Request more information from customer">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_8" sourceRef="Task_3" targetRef="Task_1"/>
    <task id="Task_6" name="Record petition and order parts">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_9</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_7" sourceRef="ExclusiveGateway_1" targetRef="Task_6"/>
    <sequenceFlow id="SequenceFlow_6" sourceRef="ExclusiveGateway_1" targetRef="Task_4">
      <conditionExpression xsi:type="tFormalExpression">${partsAvailable}</conditionExpression>
    </sequenceFlow>
    <task id="Task_4" name="Supply parts to customer">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_10</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_10" sourceRef="Task_4" targetRef="EndEvent_1"/>
    <task id="Task_9" name="Notify customer and collect payment">
      <incoming>SequenceFlow_11</incoming>
      <outgoing>SequenceFlow_12</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_9" sourceRef="Task_6" targetRef="Task_7"/>
    <task id="Task_7" name="Contact customer">
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_11</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_11" sourceRef="Task_7" targetRef="Task_9"/>
    <endEvent id="EndEvent_1">
      <incoming>SequenceFlow_10</incoming>
      <incoming>SequenceFlow_12</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_12" sourceRef="Task_9" targetRef="EndEvent_1"/>
  </process>
</definitions>