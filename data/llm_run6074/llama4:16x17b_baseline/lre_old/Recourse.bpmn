<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="BPMN Diagram" targetNamespace="http://example.com/bpmn">

   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>

     <task id="Task_1" name="Get Information about Insurant">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="ExclusiveGateway_1"/>

     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_4</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_3" name="Recourse Possible" sourceRef="ExclusiveGateway_1" targetRef="Task_2"/>

     <sequenceFlow id="SequenceFlow_4" name="Recourse Not Possible" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_1"/>

     <task id="Task_2" name="Send Request for Payment and Create Reminder">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_2" targetRef="ExclusiveGateway_2"/>

     <exclusiveGateway id="ExclusiveGateway_2">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_6</outgoing>
       <outgoing>SequenceFlow_7</outgoing>
       <outgoing>SequenceFlow_8</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_6" name="Payment Received" sourceRef="ExclusiveGateway_2" targetRef="Task_3"/>

     <task id="Task_3" name="Make Booking and Close Case">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_3" targetRef="EndEvent_2"/>

     <sequenceFlow id="SequenceFlow_7" name="Insurant Disagrees" sourceRef="ExclusiveGateway_2" targetRef="Task_4"/>

     <task id="Task_4" name="Check Reasoning of Insurant">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_10</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_10" sourceRef="Task_4" targetRef="ExclusiveGateway_3"/>

     <exclusiveGateway id="ExclusiveGateway_3">
       <incoming>SequenceFlow_10</incoming>
       <outgoing>SequenceFlow_11</outgoing>
       <outgoing>SequenceFlow_12</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_11" name="Insurant is Right" sourceRef="ExclusiveGateway_3" targetRef="EndEvent_2"/>

     <sequenceFlow id="SequenceFlow_12" name="Insurant is Wrong" sourceRef="ExclusiveGateway_3" targetRef="Task_5"/>

     <task id="Task_5" name="Forward to Collection Agency">
       <incoming>SequenceFlow_12</incoming>
       <outgoing>SequenceFlow_13</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_13" sourceRef="Task_5" targetRef="EndEvent_2"/>

     <sequenceFlow id="SequenceFlow_8" name="Deadline for Disagreement Reached" sourceRef="ExclusiveGateway_2" targetRef="Task_5"/>

     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_4</incoming>
     </endEvent>

     <endEvent id="EndEvent_2">
       <incoming>SequenceFlow_9</incoming>
       <incoming>SequenceFlow_11</incoming>
       <incoming>SequenceFlow_13</incoming>
     </endEvent>
   </process>
 </definitions>