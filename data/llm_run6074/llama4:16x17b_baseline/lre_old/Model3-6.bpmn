<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="BPMN Diagram" targetNamespace="http://example.com/bpmn">

   <process id="ClaimsNotificationProcess" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="CheckInsuredStatusTask"/>

     <task id="CheckInsuredStatusTask" name="Check Insured Status">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_2" sourceRef="CheckInsuredStatusTask" targetRef="IsInsuredExclusiveGateway"/>

     <exclusiveGateway id="IsInsuredExclusiveGateway">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_4</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_3" name="Insured" sourceRef="IsInsuredExclusiveGateway" targetRef="EvaluateClaimSeverityTask">
       <conditionExpression xsi:type="tFormalExpression">${insured  == true}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="SequenceFlow_4" name="Not Insured" sourceRef="IsInsuredExclusiveGateway" targetRef="InformClaimantTask"/>

     <task id="EvaluateClaimSeverityTask" name="Evaluate Claim Severity">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_5" sourceRef="EvaluateClaimSeverityTask" targetRef="ClaimSeverityExclusiveGateway"/>

     <exclusiveGateway id="ClaimSeverityExclusiveGateway">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_6</outgoing>
       <outgoing>SequenceFlow_7</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_6" name="Simple Claim" sourceRef="ClaimSeverityExclusiveGateway" targetRef="SendSimpleFormsTask">
       <conditionExpression xsi:type="tFormalExpression">${severity  == 'simple'}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="SequenceFlow_7" name="Complex Claim" sourceRef="ClaimSeverityExclusiveGateway" targetRef="SendComplexFormsTask">
       <conditionExpression xsi:type="tFormalExpression">${severity  == 'complex'}</conditionExpression>
     </sequenceFlow>

     <task id="SendSimpleFormsTask" name="Send Simple Forms">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_8</outgoing>
     </task>

     <task id="SendComplexFormsTask" name="Send Complex Forms">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_8" sourceRef="SendSimpleFormsTask" targetRef="CheckFormsForCompletenessTask"/>

     <sequenceFlow id="SequenceFlow_9" sourceRef="SendComplexFormsTask" targetRef="CheckFormsForCompletenessTask"/>

     <task id="CheckFormsForCompletenessTask" name="Check Forms for Completeness">
       <incoming>SequenceFlow_8</incoming>
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_10</outgoing>
       <outgoing>SequenceFlow_11</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_10" name="Complete Forms" sourceRef="CheckFormsForCompletenessTask" targetRef="RegisterClaimTask">
       <conditionExpression xsi:type="tFormalExpression">${forms.complete  == true}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="SequenceFlow_11" name="Incomplete Forms" sourceRef="CheckFormsForCompletenessTask" targetRef="InformClaimantTask"/>

     <task id="RegisterClaimTask" name="Register Claim">
       <incoming>SequenceFlow_10</incoming>
       <outgoing>SequenceFlow_12</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_12" sourceRef="RegisterClaimTask" targetRef="EndEvent_1"/>

     <task id="InformClaimantTask" name="Inform Claimant">
       <incoming>SequenceFlow_4</incoming>
       <incoming>SequenceFlow_11</incoming>
       <outgoing>SequenceFlow_13</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_13" sourceRef="InformClaimantTask" targetRef="EndEvent_1"/>

     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_12</incoming>
       <incoming>SequenceFlow_13</incoming>
     </endEvent>
   </process>
 </definitions>