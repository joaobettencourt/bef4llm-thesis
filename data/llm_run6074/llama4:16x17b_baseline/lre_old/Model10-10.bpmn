<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" 
             targetNamespace="http://example.com/bpmn">

   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_ExamineFailure"/>

     <task id="Task_ExamineFailure" name="Examine Failure">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
       <outgoing>SequenceFlow_3</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_2" name="Reject Failure" sourceRef="Task_ExamineFailure" targetRef="EndEvent_Rejected"/>

     <sequenceFlow id="SequenceFlow_3" name="Confirm Failure" sourceRef="Task_ExamineFailure" targetRef="Task_InformCustomerAndManager">
       <!-- No conditionExpression, as it's not clear what ${user.confirm == true} refers to -->
     </sequenceFlow>

     <task id="Task_InformCustomerAndManager" name="Inform Customer and Manager">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_4</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_4" sourceRef="Task_InformCustomerAndManager" targetRef="Task_FixFault"/>

     <task id="Task_FixFault" name="Fix Fault">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_FixFault" targetRef="Task_ShareRepairResults"/>

     <task id="Task_ShareRepairResults" name="Share Repair Results">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_ShareRepairResults" targetRef="Task_InformCustomerAboutResolution"/>

     <task id="Task_InformCustomerAboutResolution" name="Inform Customer about Resolution">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_7</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_7" sourceRef="Task_InformCustomerAboutResolution" targetRef="Task_InformManagerAboutResolution"/>

     <task id="Task_InformManagerAboutResolution" name="Inform Manager about Resolution">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_8</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_8" sourceRef="Task_InformManagerAboutResolution" targetRef="EndEvent_Resolved"/>

     <endEvent id="EndEvent_Rejected">
       <incoming>SequenceFlow_2</incoming>
     </endEvent>

     <endEvent id="EndEvent_Resolved">
       <incoming>SequenceFlow_8</incoming>
     </endEvent>
   </process>
 </definitions>