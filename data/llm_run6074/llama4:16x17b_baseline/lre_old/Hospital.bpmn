<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Examination Process" targetNamespace="http://example.com/bpmn">

   <process id="examinationProcess" isExecutable="true">
     <startEvent id="start-event">
       <outgoing>sf1</outgoing>
     </startEvent>

     <sequenceFlow id="sf1" sourceRef="start-event" targetRef="task-1"/>

     <task id="task-1" name="Examine Patient">
       <incoming>sf1</incoming>
       <outgoing>sf2</outgoing>
       <outgoing>sf3</outgoing>
     </task>

     <exclusiveGateway id="exclusive-gateway-1">
       <incoming>sf2</incoming>
       <outgoing>sf4</outgoing>
       <outgoing>sf5</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sf2" sourceRef="task-1" targetRef="exclusive-gateway-1"/>
     <sequenceFlow id="sf3" sourceRef="task-1" targetRef="exclusive-gateway-1"/>

     <sequenceFlow id="sf4" name="Patient Healthy" sourceRef="exclusive-gateway-1" targetRef="end-event-1">
       <conditionExpression xsi:type="tFormalExpression">${patientHealthy == true}</conditionExpression>
     </sequenceFlow>

     <endEvent id="end-event-1">
       <incoming>sf4</incoming>
     </endEvent>

     <sequenceFlow id="sf5" name="Patient Unhealthy" sourceRef="exclusive-gateway-1" targetRef="task-2"/>

     <task id="task-2" name="Fill Out Request Form">
       <incoming>sf5</incoming>
       <outgoing>sf6</outgoing>
     </task>

     <sequenceFlow id="sf6" sourceRef="task-2" targetRef="task-3"/>

     <task id="task-3" name="Inform Patient About Risks">
       <incoming>sf6</incoming>
       <outgoing>sf7</outgoing>
     </task>

     <sequenceFlow id="sf7" sourceRef="task-3" targetRef="exclusive-gateway-2"/>

     <exclusiveGateway id="exclusive-gateway-2">
       <incoming>sf7</incoming>
       <outgoing>sf8</outgoing>
       <outgoing>sf9</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sf8" name="Patient Declines" sourceRef="exclusive-gateway-2" targetRef="end-event-1">
       <conditionExpression xsi:type="tFormalExpression">${patientDeclines == true}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="sf9" name="Patient Agrees" sourceRef="exclusive-gateway-2" targetRef="task-4">
       <conditionExpression xsi:type="tFormalExpression">${patientAgrees == true}</conditionExpression>
     </sequenceFlow>

     <!-- ... rest of the process ... -->

     <endEvent id="end-event-2">
       <incoming>sf19</incoming>
     </endEvent>
   </process>
 </definitions>