<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="BPMN Diagram" targetNamespace="http://example.com/bpmn">

   <process id="Mail_Processing" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>

     <task id="Task_1" name="Collect Mail">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="Task_2"/>

     <task id="Task_2" name="Sort Mail">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_3" sourceRef="Task_2" targetRef="Task_3"/>

     <task id="Task_3" name="Distribute Mail to Registry">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_4</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_4" sourceRef="Task_3" targetRef="Task_4"/>

     <task id="Task_4" name="Open and Sort Mail">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_4" targetRef="Task_5"/>

     <task id="Task_5" name="Register Mail">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_5" targetRef="ExclusiveGateway_1"/>

     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_7</outgoing>
       <outgoing>SequenceFlow_8</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_7" name="Compliant" sourceRef="ExclusiveGateway_1" targetRef="Task_6">
       <conditionExpression xsi:type="tFormalExpression">${mail.compliant  == true}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="SequenceFlow_8" name="Not Compliant" sourceRef="ExclusiveGateway_1" targetRef="Task_7">
       <conditionExpression xsi:type="tFormalExpression">${mail.compliant  == false}</conditionExpression>
     </sequenceFlow>

     <task id="Task_6" name="Capture Matter Details and Send to Cashier">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_6" targetRef="Task_8"/>

     <task id="Task_7" name="Compile Rejection List and Send to Party">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_10</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_10" sourceRef="Task_7" targetRef="EndEvent_1"/>

     <task id="Task_8" name="Quality Check and Process Fees">
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_11</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_11" sourceRef="Task_8" targetRef="ParallelGateway_1"/>

     <parallelGateway id="ParallelGateway_1">
       <incoming>SequenceFlow_11</incoming>
       <outgoing>SequenceFlow_12</outgoing>
       <outgoing>SequenceFlow_13</outgoing>
     </parallelGateway>

     <sequenceFlow id="SequenceFlow_12" sourceRef="ParallelGateway_1" targetRef="Task_9"/>

     <task id="Task_9" name="Post Receipt and Documents to Party">
       <incoming>SequenceFlow_12</incoming>
       <outgoing>SequenceFlow_14</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_14" sourceRef="Task_9" targetRef="EndEvent_2"/>

     <sequenceFlow id="SequenceFlow_13" sourceRef="ParallelGateway_1" targetRef="Task_10"/>

     <task id="Task_10" name="Capture Party Details and Print Court File">
       <incoming>SequenceFlow_13</incoming>
       <outgoing>SequenceFlow_15</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_15" sourceRef="Task_10" targetRef="EndEvent_2"/>

     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_10</incoming>
     </endEvent>

     <endEvent id="EndEvent_2">
       <incoming>SequenceFlow_14</incoming>
       <incoming>SequenceFlow_15</incoming>
     </endEvent>
   </process>
 </definitions>