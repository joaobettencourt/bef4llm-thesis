<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="BPMN Diagram" targetNamespace="http://bpmn.io/schema/bpmn">

   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>

     <task id="Task_1" name="Backup Database">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="ExclusiveGateway_1"/>

     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_4</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_3" name="New Records Found" sourceRef="ExclusiveGateway_1" targetRef="Task_2"/>

     <task id="Task_2" name="Register Defaulting Accounts and Customers">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_2" targetRef="ExclusiveGateway_2"/>

     <exclusiveGateway id="ExclusiveGateway_2">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_6</outgoing>
       <outgoing>SequenceFlow_7</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_4" name="No New Records" sourceRef="ExclusiveGateway_1" targetRef="Task_3"/>

     <task id="Task_3" name="Check CRM System for New Returns">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_8</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_8" sourceRef="Task_3" targetRef="ExclusiveGateway_3"/>

     <exclusiveGateway id="ExclusiveGateway_3">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_9</outgoing>
       <outgoing>SequenceFlow_10</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_6" name="Previously Advised" sourceRef="ExclusiveGateway_2" targetRef="Task_4"/>

     <task id="Task_4" name="Produce Defaulting Accounts Report and Send to Account Management">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_11</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_11" sourceRef="Task_4" targetRef="Gateway_1"/>

     <gateway id="Gateway_1" type="exclusive">
       <incoming>SequenceFlow_11</incoming>
       <outgoing>SequenceFlow_12</outgoing>
       <outgoing>SequenceFlow_13</outgoing>
     </gateway>

     <sequenceFlow id="SequenceFlow_9" name="New Returns Filed" sourceRef="ExclusiveGateway_3" targetRef="Task_2"/>

     <sequenceFlow id="SequenceFlow_10" name="No New Returns" sourceRef="ExclusiveGateway_3" targetRef="EndEvent_1"/>

     <sequenceFlow id="SequenceFlow_12" name="Completed by 2:30 pm" sourceRef="Gateway_1" targetRef="Task_5"/>

     <task id="Task_5" name="Check CRM System for New Returns">
       <incoming>SequenceFlow_12</incoming>
       <outgoing>SequenceFlow_14</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_14" sourceRef="Task_5" targetRef="Gateway_2"/>

     <gateway id="Gateway_2" type="exclusive">
       <incoming>SequenceFlow_14</incoming>
       <outgoing>SequenceFlow_15</outgoing>
       <outgoing>SequenceFlow_16</outgoing>
     </gateway>

     <sequenceFlow id="SequenceFlow_7" name="Not Previously Advised" sourceRef="ExclusiveGateway_2" targetRef="Task_6"/>

     <task id="Task_6" name="Send Alert to Supervisor">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_17</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_17" sourceRef="Task_6" targetRef="EndEvent_1"/>

     <sequenceFlow id="SequenceFlow_13" name="Not Completed by 2:30 pm" sourceRef="Gateway_1" targetRef="Task_8"/>

     <task id="Task_8" name="Send Alert to Supervisor">
       <incoming>SequenceFlow_13</incoming>
       <outgoing>SequenceFlow_18</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_18" sourceRef="Task_8" targetRef="EndEvent_1"/>

     <sequenceFlow id="SequenceFlow_15" name="New Returns Filed" sourceRef="Gateway_2" targetRef="Task_7"/>

     <task id="Task_7" name="Reconcile with Existing Account Defaulters Table">
       <incoming>SequenceFlow_15</incoming>
       <outgoing>SequenceFlow_19</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_19" sourceRef="Task_7" targetRef="Gateway_3"/>

     <gateway id="Gateway_3" type="exclusive">
       <incoming>SequenceFlow_19</incoming>
       <outgoing>SequenceFlow_20</outgoing>
       <outgoing>SequenceFlow_21</outgoing>
     </gateway>

     <sequenceFlow id="SequenceFlow_16" name="No New Returns" sourceRef="Gateway_2" targetRef="EndEvent_2"/>

     <sequenceFlow id="SequenceFlow_20" name="Completed by 4:00 pm" sourceRef="Gateway_3" targetRef="EndEvent_2"/>

     <sequenceFlow id="SequenceFlow_21" name="Not Completed by 4:00 pm" sourceRef="Gateway_3" targetRef="Task_9"/>

     <task id="Task_9" name="Send Message to Supervisor">
       <incoming>SequenceFlow_21</incoming>
       <outgoing>SequenceFlow_22</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_22" sourceRef="Task_9" targetRef="EndEvent_2"/>

     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_10</incoming>
       <incoming>SequenceFlow_17</incoming>
       <incoming>SequenceFlow_18</incoming>
     </endEvent>

     <endEvent id="EndEvent_2">
       <incoming>SequenceFlow_16</incoming>
       <incoming>SequenceFlow_20</incoming>
       <incoming>SequenceFlow_22</incoming>
     </endEvent>
   </process>
</definitions>