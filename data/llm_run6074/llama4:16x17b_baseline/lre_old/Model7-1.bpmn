<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="BPMN Diagram" targetNamespace="http://bpmn.io/schema/bpmn">

   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>

     <task id="Task_1" name="Check Open Leads">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="Task_2"/>

     <task id="Task_2" name="Select Top Five Leads">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_3" sourceRef="Task_2" targetRef="Task_3"/>

     <task id="Task_3" name="Notify Sales Assistant">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_4</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_4" sourceRef="Task_3" targetRef="ExclusiveGateway_1"/>

     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_5</outgoing>
       <outgoing>SequenceFlow_6</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_5" sourceRef="ExclusiveGateway_1" targetRef="Task_4">
       <conditionExpression xsi:type="tFormalExpression">${lead.valid == true}</conditionExpression>
     </sequenceFlow>

     <task id="Task_4" name="Call Customer">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_7</outgoing>
       <outgoing>SequenceFlow_8</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_6" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_2"/>

     <sequenceFlow id="SequenceFlow_7" sourceRef="Task_4" targetRef="Manager_Task">
       <conditionExpression xsi:type="tFormalExpression">${customer.interested == true}</conditionExpression>
     </sequenceFlow>

     <task id="Manager_Task" name="Process Lead">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_8" sourceRef="Task_4" targetRef="Task_4"/>

     <sequenceFlow id="SequenceFlow_9" sourceRef="Manager_Task" targetRef="EndEvent_1"/>

     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_9</incoming>
     </endEvent>

     <endEvent id="EndEvent_2">
       <incoming>SequenceFlow_6</incoming>
     </endEvent>
   </process>
</definitions>