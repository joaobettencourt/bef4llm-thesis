<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="BPMN Diagram" targetNamespace="http://example.com/bpmn">

   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>

     <task id="Task_1" name="Send Problem Parameters to Customer Service">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="Task_2"/>

     <task id="Task_2" name="Enter Problem Report into System T">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_3" sourceRef="Task_2" targetRef="ExclusiveGateway_1"/>

     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_4</outgoing>
       <outgoing>SequenceFlow_5</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_1" targetRef="Task_3">
       <conditionExpression xsi:type="tFormalExpression">${customer.significance == 'premium'}</conditionExpression>
     </sequenceFlow>

     <task id="Task_3" name="Link to Extra Problem Fix Process">
       <incoming>SequenceFlow_4</incoming>
     </task>

     <sequenceFlow id="SequenceFlow_5" sourceRef="ExclusiveGateway_1" targetRef="Task_4"/>

     <task id="Task_4" name="Determine Counter Measures and Priorities">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_4" targetRef="ExclusiveGateway_2"/>

     <exclusiveGateway id="ExclusiveGateway_2">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_7</outgoing>
       <outgoing>SequenceFlow_8</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_7" sourceRef="ExclusiveGateway_2" targetRef="Task_5">
       <conditionExpression xsi:type="tFormalExpression">${customer.significance affects counter measures}</conditionExpression>
     </sequenceFlow>

     <task id="Task_5" name="Re-prioritize Counter Measures">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_5" targetRef="Task_6"/>

     <task id="Task_6" name="Create Detailed Problem Report">
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_10</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_10" sourceRef="Task_6" targetRef="ServiceManagementSubprocess"/>

     <subProcess id="ServiceManagementSubprocess">
       <incoming>SequenceFlow_10</incoming>
       <startEvent id="StartEvent_ServiceManagement">
         <outgoing>SequenceFlow_SM1</outgoing>
       </startEvent>

       <sequenceFlow id="SequenceFlow_SM1" sourceRef="StartEvent_ServiceManagement" targetRef="Task_ServiceManagement1"/>

       <task id="Task_ServiceManagement1" name="Investigate Problem">
         <incoming>SequenceFlow_SM1</incoming>
         <outgoing>SequenceFlow_SM2</outgoing>
       </task>

       <sequenceFlow id="SequenceFlow_SM2" sourceRef="Task_ServiceManagement1" targetRef="ExclusiveGateway_ServiceManagement"/>

       <exclusiveGateway id="ExclusiveGateway_ServiceManagement">
         <incoming>SequenceFlow_SM2</incoming>
         <outgoing>SequenceFlow_SM3</outgoing>
         <outgoing>SequenceFlow_SM4</outgoing>
       </exclusiveGateway>

       <sequenceFlow id="SequenceFlow_SM3" sourceRef="ExclusiveGateway_ServiceManagement" targetRef="Task_ServiceManagement2">
         <conditionExpression xsi:type="tFormalExpression">${problem analyzable}</conditionExpression>
       </sequenceFlow>

       <task id="Task_ServiceManagement2" name="Analyze Problem and Create Trouble Report">
         <incoming>SequenceFlow_SM3</incoming>
         <outgoing>SequenceFlow_SM5</outgoing>
       </task>

       <sequenceFlow id="SequenceFlow_SM5" sourceRef="Task_ServiceManagement2" targetRef="EndEvent_ServiceManagement"/>

       <endEvent id="EndEvent_ServiceManagement">
         <incoming>SequenceFlow_SM5</incoming>
       </endEvent>

       <sequenceFlow id="SequenceFlow_SM4" sourceRef="ExclusiveGateway_ServiceManagement" targetRef="ResourceProvisioningSubprocess"/>

     </subProcess>

     <subProcess id="ResourceProvisioningSubprocess">
       <!-- Add Resource Provisioning subprocess elements here -->
     </subProcess>

   </process>
</definitions>