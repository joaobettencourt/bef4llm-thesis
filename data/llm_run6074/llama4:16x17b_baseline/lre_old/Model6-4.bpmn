<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="BPMN Diagram" targetNamespace="http://bpmn.io/schema/bpmn">

   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="ExclusiveGateway_1"/>

     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_4</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_2" name="Buy Details" sourceRef="ExclusiveGateway_1" targetRef="Task_1"/>

     <sequenceFlow id="SequenceFlow_3" name="Marketing Staff" sourceRef="ExclusiveGateway_1" targetRef="Task_1"/>

     <sequenceFlow id="SequenceFlow_4" name="Personal Connection" sourceRef="ExclusiveGateway_1" targetRef="Task_1"/>

     <task id="Task_1">
       <incoming>SequenceFlow_2</incoming>
       <incoming>SequenceFlow_3</incoming>
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_1" targetRef="Task_2"/>

     <task id="Task_2">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_2" targetRef="ExclusiveGateway_2"/>

     <exclusiveGateway id="ExclusiveGateway_2">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_7</outgoing>
       <outgoing>SequenceFlow_8</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_7" sourceRef="ExclusiveGateway_2" targetRef="EndEvent_1">
       <!--<conditionExpression xsi:type="tFormalExpression">${customerInterested  == false and budget  !=  'huge'}</conditionExpression>-->
     </sequenceFlow>

     <sequenceFlow id="SequenceFlow_8" sourceRef="ExclusiveGateway_2" targetRef="Task_3">
       <!--<conditionExpression xsi:type="tFormalExpression">${customerInterested  == true or budget  ==  'huge'}</conditionExpression>-->
     </sequenceFlow>

     <task id="Task_3">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_3" targetRef="TimerEvent_1"/>

     <timerEvent id="TimerEvent_1">
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_10</outgoing>
       <outgoing>SequenceFlow_11</outgoing>
     </timerEvent>

     <sequenceFlow id="SequenceFlow_10" sourceRef="TimerEvent_1" targetRef="Task_4"/>

     <sequenceFlow id="SequenceFlow_11" sourceRef="TimerEvent_1" targetRef="Task_5"/>

     <task id="Task_4">
       <incoming>SequenceFlow_10</incoming>
       <outgoing>SequenceFlow_12</outgoing>
     </task>

     <task id="Task_5">
       <incoming>SequenceFlow_11</incoming>
       <outgoing>SequenceFlow_13</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_12" sourceRef="Task_4" targetRef="EndEvent_2"/>

     <sequenceFlow id="SequenceFlow_13" sourceRef="Task_5" targetRef="Task_4"/>

     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_7</incoming>
     </endEvent>

     <endEvent id="EndEvent_2">
       <incoming>SequenceFlow_12</incoming>
     </endEvent>
   </process>
</definitions>