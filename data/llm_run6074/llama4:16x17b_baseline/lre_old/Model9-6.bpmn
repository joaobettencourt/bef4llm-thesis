<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="BPMN Diagram" targetNamespace="http://bpmn.io/schema/bpmn">

   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>

     <task id="Task_1" name="Locate and Distribute Existing Designs">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="ParallelGateway_1"/>

     <parallelGateway id="ParallelGateway_1">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_4</outgoing>
     </parallelGateway>

     <sequenceFlow id="SequenceFlow_3" sourceRef="ParallelGateway_1" targetRef="SubProcess_ElectricalDesign"/>

     <subProcess id="SubProcess_ElectricalDesign">
       <incoming>SequenceFlow_3</incoming>
       <startEvent id="StartEvent_Electrical">
         <outgoing>SequenceFlow_11</outgoing>
       </startEvent>

       <sequenceFlow id="SequenceFlow_11" sourceRef="StartEvent_Electrical" targetRef="Task_ElectricalReview"/>

       <task id="Task_ElectricalReview" name="Electrical Design Review">
         <incoming>SequenceFlow_11</incoming>
         <outgoing>SequenceFlow_12</outgoing>
       </task>

       <sequenceFlow id="SequenceFlow_12" sourceRef="Task_ElectricalReview" targetRef="Task_ElectricalUpdatePlan"/>

       <task id="Task_ElectricalUpdatePlan" name="Create Electrical Update Plan">
         <incoming>SequenceFlow_12</incoming>
         <outgoing>SequenceFlow_13</outgoing>
       </task>

       <sequenceFlow id="SequenceFlow_13" sourceRef="Task_ElectricalUpdatePlan" targetRef="Task_ElectricalRevisedDesign"/>

       <task id="Task_ElectricalRevisedDesign" name="Create Revised Electrical Design">
         <incoming>SequenceFlow_13</incoming>
         <outgoing>SequenceFlow_14</outgoing>
       </task>

       <sequenceFlow id="SequenceFlow_14" sourceRef="Task_ElectricalRevisedDesign" targetRef="Task_ElectricalTest"/>

       <task id="Task_ElectricalTest" name="Electrical Design Test">
         <incoming>SequenceFlow_14</incoming>
         <outgoing>SequenceFlow_15</outgoing>
         <outgoing>SequenceFlow_16</outgoing>
       </task>

       <sequenceFlow id="SequenceFlow_15" sourceRef="Task_ElectricalTest" targetRef="EndEvent_ElectricalSuccess">
         <conditionExpression xsi:type="tFormalExpression">${electricalTestResult == true}</conditionExpression>
       </sequenceFlow>

       <sequenceFlow id="SequenceFlow_16" sourceRef="Task_ElectricalTest" targetRef="Task_ElectricalReview"/>

       <endEvent id="EndEvent_ElectricalSuccess">
         <incoming>SequenceFlow_15</incoming>
       </endEvent>
     </subProcess>

     <sequenceFlow id="SequenceFlow_4" sourceRef="ParallelGateway_1" targetRef="SubProcess_PhysicalDesign"/>

     <subProcess id="SubProcess_PhysicalDesign">
       <incoming>SequenceFlow_4</incoming>
       <startEvent id="StartEvent_Physical">
         <outgoing>SequenceFlow_21</outgoing>
       </startEvent>

       <sequenceFlow id="SequenceFlow_21" sourceRef="StartEvent_Physical" targetRef="Task_PhysicalReview"/>

       <task id="Task_PhysicalReview" name="Physical Design Review">
         <incoming>SequenceFlow_21</incoming>
         <outgoing>SequenceFlow_22</outgoing>
       </task>

       <sequenceFlow id="SequenceFlow_22" sourceRef="Task_PhysicalReview" targetRef="Task_PhysicalUpdatePlan"/>

       <task id="Task_PhysicalUpdatePlan" name="Create Physical Update Plan">
         <incoming>SequenceFlow_22</incoming>
         <outgoing>SequenceFlow_23</outgoing>
       </task>

       <sequenceFlow id="SequenceFlow_23" sourceRef="Task_PhysicalUpdatePlan" targetRef="Task_PhysicalRevisedDesign"/>

       <task id="Task_PhysicalRevisedDesign" name="Create Revised Physical Design">
         <incoming>SequenceFlow_23</incoming>
         <outgoing>SequenceFlow_24</outgoing>
       </task>

       <sequenceFlow id="SequenceFlow_24" sourceRef="Task_PhysicalRevisedDesign" targetRef="Task_PhysicalTest"/>

       <task id="Task_PhysicalTest" name="Physical Design Test">
         <incoming>SequenceFlow_24</incoming>
         <outgoing>SequenceFlow_25</outgoing>
         <outgoing>SequenceFlow_26</outgoing>
       </task>

       <sequenceFlow id="SequenceFlow_25" sourceRef="Task_PhysicalTest" targetRef="EndEvent_PhysicalSuccess">
         <conditionExpression xsi:type="tFormalExpression">${physicalTestResult == true}</conditionExpression>
       </sequenceFlow>

       <sequenceFlow id="SequenceFlow_26" sourceRef="Task_PhysicalTest" targetRef="Task_PhysicalReview"/>

       <endEvent id="EndEvent_PhysicalSuccess">
         <incoming>SequenceFlow_25</incoming>
       </endEvent>
     </subProcess>

     <exclusiveGateway id="ExclusiveGateway_1">
       <outgoing>SequenceFlow_27</outgoing>
       <outgoing>SequenceFlow_28</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_27" sourceRef="EndEvent_ElectricalSuccess" targetRef="ExclusiveGateway_1"/>
     <sequenceFlow id="SequenceFlow_28" sourceRef="EndEvent_PhysicalSuccess" targetRef="ExclusiveGateway_1"/>

     <task id="Task_CombineDesigns" name="Combine and Test Designs">
       <incoming>SequenceFlow_29</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_29" sourceRef="ExclusiveGateway_1" targetRef="Task_CombineDesigns"/>

     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_CombineDesigns" targetRef="EndEvent_2"/>

     <endEvent id="EndEvent_2">
       <incoming>SequenceFlow_9</incoming>
     </endEvent>
   </process>

   <messageFlow id="MessageFlow_ElectricalInterruptPhysical" name="Electrical Interrupt Physical"
                sourceRef="EndEvent_ElectricalSuccess" targetRef="Task_PhysicalReview"/>

   <messageFlow id="MessageFlow_PhysicalInterruptElectrical" name="Physical Interrupt Electrical"
                sourceRef="EndEvent_PhysicalSuccess" targetRef="Task_ElectricalReview"/>
 </definitions>