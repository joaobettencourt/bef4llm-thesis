<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Business Process Model" targetNamespace="http://bpmn.io/schema/bpmn">
   <process id="WebSiteDevelopmentProcess" isExecutable="true">
     <startEvent id="StartEvent">
       <outgoing>SequenceFlow1</outgoing>
     </startEvent>
     <sequenceFlow id="SequenceFlow1" sourceRef="StartEvent" targetRef="Task_InformationalMeeting"/>
     <task id="Task_InformationalMeeting" name="informational meeting">
       <incoming>SequenceFlow1</incoming>
       <outgoing>SequenceFlow2</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow2" sourceRef="Task_InformationalMeeting" targetRef="ExclusiveGateway_MeetingSuccessful"/>
     <exclusiveGateway id="ExclusiveGateway_MeetingSuccessful">
       <incoming>SequenceFlow2</incoming>
       <outgoing>SequenceFlow3</outgoing>
       <outgoing>SequenceFlow4</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow3" name="yes" sourceRef="ExclusiveGateway_MeetingSuccessful" targetRef="Task_CreateStoryboard"/>
     <task id="Task_CreateStoryboard" name="create storyboard">
       <incoming>SequenceFlow3</incoming>
       <outgoing>SequenceFlow5</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow5" sourceRef="Task_CreateStoryboard" targetRef="ParallelGateway_1"/>
     <parallelGateway id="ParallelGateway_1">
       <incoming>SequenceFlow5</incoming>
       <outgoing>SequenceFlow6</outgoing>
       <outgoing>SequenceFlow7</outgoing>
     </parallelGateway>
     <sequenceFlow id="SequenceFlow6" sourceRef="ParallelGateway_1" targetRef="Task_DesignAndDevelopment"/>
     <task id="Task_DesignAndDevelopment" name="design and development">
       <incoming>SequenceFlow6</incoming>
       <outgoing>SequenceFlow8</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow8" sourceRef="Task_DesignAndDevelopment" targetRef="Gateway_1"/>
     <sequenceFlow id="SequenceFlow7" sourceRef="ParallelGateway_1" targetRef="Task_PrepareInitialDraftOfContent">
       <incoming>SequenceFlow6</incoming>
     </sequenceFlow>
     <task id="Task_PrepareInitialDraftOfContent" name="prepare initial draft of content">
       <incoming>SequenceFlow7</incoming>
       <outgoing>SequenceFlow9</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow9" sourceRef="Task_PrepareInitialDraftOfContent" targetRef="ExclusiveGateway_ReviewNeededForContent"/>
     <exclusiveGateway id="ExclusiveGateway_ReviewNeededForContent">
       <incoming>SequenceFlow9</incoming>
       <outgoing>SequenceFlow10</outgoing>
       <outgoing>SequenceFlow11</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow10" name="no" sourceRef="ExclusiveGateway_ReviewNeededForContent" targetRef="Task_CreateFinalVersionOfContent"/>
     <task id="Task_CreateFinalVersionOfContent" name="create final version of content">
       <incoming>SequenceFlow10</incoming>
       <outgoing>SequenceFlow12</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow11" name="yes" sourceRef="ExclusiveGateway_ReviewNeededForContent" targetRef="Task_MarketingTeamReviewsDraftOfContent"/>
     <task id="Task_MarketingTeamReviewsDraftOfContent" name="marketing team reviews draft of content">
       <incoming>SequenceFlow11</incoming>
       <outgoing>SequenceFlow13</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow13" sourceRef="Task_MarketingTeamReviewsDraftOfContent" targetRef="Task_CreateFinalVersionOfContent"/>
     <sequenceFlow id="SequenceFlow12" sourceRef="Task_CreateFinalVersionOfContent" targetRef="Gateway_1"/>
     <parallelGateway id="Gateway_1">
       <incoming>SequenceFlow8</incoming>
       <incoming>SequenceFlow12</incoming>
       <outgoing>SequenceFlow14</outgoing>
     </parallelGateway>
     <sequenceFlow id="SequenceFlow14" sourceRef="Gateway_1" targetRef="Task_BuildWebsite"/>
     <task id="Task_BuildWebsite" name="build website">
       <incoming>SequenceFlow14</incoming>
       <outgoing>SequenceFlow15</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow15" sourceRef="Task_BuildWebsite" targetRef="ExclusiveGateway_WebsiteApproved"/>
     <exclusiveGateway id="ExclusiveGateway_WebsiteApproved">
       <incoming>SequenceFlow15</incoming>
       <outgoing>SequenceFlow16</outgoing>
       <outgoing>SequenceFlow17</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow4" name="no" sourceRef="ExclusiveGateway_MeetingSuccessful" targetRef="EndEvent_ProcessTerminated"/>
     <endEvent id="EndEvent_ProcessTerminated">
       <incoming>SequenceFlow4</incoming>
     </endEvent>
     <sequenceFlow id="SequenceFlow16" name="yes" sourceRef="ExclusiveGateway_WebsiteApproved" targetRef="EndEvent_ProcessCompleted"/>
     <endEvent id="EndEvent_ProcessCompleted">
       <incoming>SequenceFlow16</incoming>
     </endEvent>
     <sequenceFlow id="SequenceFlow17" name="no" sourceRef="ExclusiveGateway_WebsiteApproved" targetRef="Task_BuildWebsite"/>
   </process>
</definitions>