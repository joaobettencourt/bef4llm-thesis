<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Business Process Model">
  <process id="RegistrationProcess" isExecutable="true">
    <startEvent id="StartEvent1">
      <outgoing>SequenceFlow1</outgoing>
    </startEvent>
    <sequenceFlow id="SequenceFlow1" sourceRef="StartEvent1" targetRef="Task1"/>
    <task id="Task1" name="Fill out registration-form">
      <outgoing>SequenceFlow2</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow2" sourceRef="Task1" targetRef="Task2"/>
    <task id="Task2" name="Check availability of products and credit rating">
      <outgoing>SequenceFlow3</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow3" sourceRef="Task2" targetRef="ExclusiveGateway1"/>
    <exclusiveGateway id="ExclusiveGateway1">
      <incoming>SequenceFlow3</incoming>
      <outgoing>SequenceFlow4</outgoing>
      <outgoing>SequenceFlow5</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow4" sourceRef="ExclusiveGateway1" targetRef="EndEvent1">
      <conditionExpression xsi:type="tFormalExpression">${creditRating > 9000}</conditionExpression>
    </sequenceFlow>
    <endEvent id="EndEvent1">
      <incoming>SequenceFlow4</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow5" sourceRef="ExclusiveGateway1" targetRef="Task3">
      <conditionExpression xsi:type="tFormalExpression">${creditRating <= 9000}</conditionExpression>
    </sequenceFlow>
    <task id="Task3" name="Create interim customer dataset record">
      <outgoing>SequenceFlow6</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow6" sourceRef="Task3" targetRef="ParallelGateway1"/>
    <parallelGateway id="ParallelGateway1">
      <incoming>SequenceFlow6</incoming>
      <outgoing>SequenceFlow7</outgoing>
      <outgoing>SequenceFlow8</outgoing>
    </parallelGateway>
    <sequenceFlow id="SequenceFlow7" sourceRef="ParallelGateway1" targetRef="SubProcess1"/>
    <subProcess id="SubProcess1" name="Device provision process">
      <incoming>SequenceFlow7</incoming>
      <outgoing>SequenceFlow9</outgoing>
    </subProcess>
    <sequenceFlow id="SequenceFlow9" sourceRef="SubProcess1" targetRef="ParallelGateway2"/>
    <sequenceFlow id="SequenceFlow8" sourceRef="ParallelGateway1" targetRef="SubProcess2"/>
    <subProcess id="SubProcess2" name="Register customer account at ISP nodes">
      <incoming>SequenceFlow8</incoming>
      <outgoing>SequenceFlow10</outgoing>
    </subProcess>
    <sequenceFlow id="SequenceFlow10" sourceRef="SubProcess2" targetRef="ParallelGateway2"/>
    <parallelGateway id="ParallelGateway2">
      <incoming>SequenceFlow9</incoming>
      <incoming>SequenceFlow10</incoming>
      <outgoing>SequenceFlow11</outgoing>
    </parallelGateway>
    <sequenceFlow id="SequenceFlow11" sourceRef="ParallelGateway2" targetRef="Task4"/>
    <task id="Task4" name="Create and send Welcome-Package">
      <incoming>SequenceFlow11</incoming>
      <outgoing>SequenceFlow12</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow12" sourceRef="Task4" targetRef="EndEvent2"/>
    <endEvent id="EndEvent2">
      <incoming>SequenceFlow12</incoming>
    </endEvent>
  </process>
</definitions>