<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" 
             targetNamespace="http://bpmn.io/schema/bpmn">
   <process id="CreatePaypalAccountProcess" isExecutable="true">
     <startEvent id="StartEvent1">
       <outgoing>SequenceFlow1</outgoing>
     </startEvent>
     <sequenceFlow id="SequenceFlow1" sourceRef="StartEvent1" targetRef="ExclusiveGateway1"/>
     <exclusiveGateway id="ExclusiveGateway1">
       <incoming>SequenceFlow1</incoming>
       <outgoing>SequenceFlow2</outgoing>
       <outgoing>SequenceFlow3</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow2" sourceRef="ExclusiveGateway1" targetRef="Task4">
       <conditionExpression xsi:type="tFormalExpression">${accountType  ==  'personal'}</conditionExpression>
     </sequenceFlow>
     <sequenceFlow id="SequenceFlow3" sourceRef="ExclusiveGateway1" targetRef="Task5">
       <conditionExpression xsi:type="tFormalExpression">${accountType  ==  'premium'}</conditionExpression>
     </sequenceFlow>

     <!-- Tasks for entering details -->
     <task id="Task4" name="Select Personal Account Type">
       <incoming>SequenceFlow2</incoming>
       <outgoing>SequenceFlow6</outgoing>
     </task>
     <task id="Task5" name="Select Premium Account Type">
       <incoming>SequenceFlow3</incoming>
       <outgoing>SequenceFlow7</outgoing>
     </task>

     <!-- Task for entering login details -->
     <task id="Task6" name="Enter Login Details">
       <incoming>SequenceFlow6</incoming>
       <outgoing>SequenceFlow8</outgoing>
     </task>
     <task id="Task7" name="Enter Login Details"> 
       <incoming>SequenceFlow7</incoming>
       <outgoing>SequenceFlow9</outgoing>
     </task>

     <!-- Tasks for entering personal, telephone and address details -->
     <subProcess id="Subprocess1">
       <incoming>SequenceFlow8</incoming>
       <outgoing>SequenceFlow10</outgoing>
     </subProcess>

     <sequenceFlow id="SequenceFlow6" sourceRef="Task4" targetRef="Task6"/>
     <sequenceFlow id="SequenceFlow7" sourceRef="Task5" targetRef="Task7"/>

     <!-- Task for declaring affiliation with a politically exposed person -->
     <task id="Task8" name="Declare if have been or affiliated with a Politically Exposed person">
       <incoming>SequenceFlow10</incoming>
       <outgoing>SequenceFlow11</outgoing>
     </task>

     <!-- Create account button clicked, send details to Paypal system -->
     <sequenceFlow id="SequenceFlow8" sourceRef="Task6" targetRef="Subprocess1"/>
     <sequenceFlow id="SequenceFlow9" sourceRef="Task7" targetRef="Subprocess1"/>

     <sequenceFlow id="SequenceFlow10" sourceRef="Subprocess1" targetRef="Task8"/> 
     <sequenceFlow id="SequenceFlow11" sourceRef="Task8" targetRef="IntermediateThrowEvent1"/> 

     <!-- Intermediate Throw Event: Submit account details to System -->
     <intermediateThrowEvent id="IntermediateThrowEvent1">
       <incoming>SequenceFlow11</incoming>
       <outgoing>SequenceFlow12</outgoing>
       <messageEventDefinition/> 
     </intermediateThrowEvent>

     <!-- Intermediate Catch Event: New account request received -->
     <sequenceFlow id="SequenceFlow12" sourceRef="IntermediateThrowEvent1" targetRef="Task9"/>  
     <task id="Task9" name="Validate input fields">
       <incoming>SequenceFlow12</incoming>
       <outgoing>SequenceFlow13</outgoing>
     </task>

     <!-- Exclusive Gateway for validation result -->
     <exclusiveGateway id="ExclusiveGateway2">
       <incoming>SequenceFlow13</incoming>
       <outgoing>SequenceFlow14</outgoing>
       <outgoing>SequenceFlow15</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow13" sourceRef="Task9" targetRef="ExclusiveGateway2"/> 
     <sequenceFlow id="SequenceFlow14" name="Input fields invalid" sourceRef="ExclusiveGateway2" targetRef="Task6"/> 

     <!-- Sequence flow for input fields valid, generate welcome email and end event -->
     <sequenceFlow id="SequenceFlow15" name="Input fields valid" sourceRef="ExclusiveGateway2" targetRef="IntermediateThrowEvent2"/> 
     <intermediateThrowEvent id="IntermediateThrowEvent2">
       <incoming>SequenceFlow15</incoming>
       <outgoing>SequenceFlow16</outgoing>
       <messageEventDefinition/>  
     </intermediateThrowEvent>

     <sequenceFlow id="SequenceFlow16" sourceRef="IntermediateThrowEvent2" targetRef="EndEvent1"/> 
     <endEvent id="EndEvent1">
       <incoming>SequenceFlow16</incoming>
     </endEvent>
   </process>
</definitions>