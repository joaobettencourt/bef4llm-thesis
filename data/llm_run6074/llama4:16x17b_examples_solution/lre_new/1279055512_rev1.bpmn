<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/pec/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/pec/spec/BPMN/20100524/MODEL http://www.omg.org/pec/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" 
             targetNamespace="http://bpmn.io/schema/bpmn">
   <process id="invoiceProcess" isExecutable="true">
     <laneSet>
       <lane id="mailCentreLane" name="Mail Centre">
         <flowNodeRef>startEvent</flowNodeRef>
         <flowNodeRef>categorizeInvoiceTask</flowNodeRef>
         <flowNodeRef>forwardInvoiceTask</flowNodeRef>
         <flowNodeRef>reviewInvoicesTimer</flowNodeRef>
       </lane>
       <lane id="administrationLane" name="Administration Department">
         <flowNodeRef>processInvoiceSubProcess</flowNodeRef>
         <flowNodeRef>invoicesInCollectionBoxTask</flowNodeRef>
       </lane>
       <lane id="dataEntryLane" name="Data Entry">
         <flowNodeRef>enterDataSubProcess</flowNodeRef>
       </lane>
       <lane id="validationLane" name="Validation Office">
         <flowNodeRef>validateInvoicesSubProcess</flowNodeRef>
       </lane>
       <lane id="paymentLane" name="Payment Office">
         <flowNodeRef>processPaymentsSubProcess</flowNodeRef>
       </lane>
       <lane id="registryLane" name="Registry Office">
         <flowNodeRef>archiveInvoicesTask</flowNodeRef>
         <flowNodeRef>theEndEvent</flowNodeRef>
       </lane>
     </laneSet>

     <startEvent id="startEvent" name="Invoice Received">
       <outgoing>sequenceFlow1</outgoing>
       <messageEventDefinition/> 
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent" targetRef="categorizeInvoiceTask"/>

     <task id="categorizeInvoiceTask" name="Categorize Invoice by Staff Member">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow2" sourceRef="categorizeInvoiceTask" targetRef="forwardInvoiceTask"/>

     <task id="forwardInvoiceTask" name="Forward Invoice to Admin Department">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow3" sourceRef="forwardInvoiceTask" targetRef="processInvoiceSubProcess"/>

     <subProcess id="processInvoiceSubProcess" name="Process Invoice">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow4</outgoing>
     </subProcess>

     <sequenceFlow id="sequenceFlow4" sourceRef="processInvoiceSubProcess" targetRef="invoicesInCollectionBoxTask"/>

     <task id="invoicesInCollectionBoxTask" name="Put Invoices in Collection Box">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow5</outgoing>
     </task>

     <intermediateCatchEvent id="reviewInvoicesTimer" name="Every 1 hour"> 
       <timerEventDefinition interval="PT1H"/>
       <outgoing>sequenceFlow9</outgoing>
     </intermediateCatchEvent>

     <subProcess id="enterDataSubProcess" name="Enter Data in SAP">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow6</outgoing>
     </subProcess>

     <sequenceFlow id="sequenceFlow6" sourceRef="enterDataSubProcess" targetRef="reviewInvoicesTimer"/>

     <sequenceFlow id="sequenceFlow9" sourceRef="reviewInvoicesTimer" targetRef="forwardInvoicesForValidationTask"/>

     <task id="forwardInvoicesForValidationTask" name="Forward Invoice for Validation">
       <incoming>sequenceFlow9</incoming>
       <outgoing>sequenceFlow10</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow10" sourceRef="forwardInvoicesForValidationTask" targetRef="validateInvoicesSubProcess"/>

     <subProcess id="validateInvoicesSubProcess" name="Validate Invoices">
       <incoming>sequenceFlow10</incoming>
       <outgoing>sequenceFlow11</outgoing>
     </subProcess>

     <intermediateCatchEvent id="processPaymentsTimer" name="Beginning of every Week"> 
       <timerEventDefinition interval="PT168H"/>
       <outgoing>sequenceFlow12</outgoing>
     </intermediateCatchEvent>

     <sequenceFlow id="sequenceFlow11" sourceRef="validateInvoicesSubProcess" targetRef="processPaymentsTimer"/>

     <subProcess id="processPaymentsSubProcess" name="Process Payment">
       <incoming>sequenceFlow12</incoming>
       <outgoing>sequenceFlow13</outgoing>
     </subProcess>

     <sequenceFlow id="sequenceFlow12" sourceRef="processPaymentsTimer" targetRef="processPaymentsSubProcess"/>

     <sequenceFlow id="sequenceFlow13" sourceRef="processPaymentsSubProcess" targetRef="archiveInvoicesTask"/>

     <task id="archiveInvoicesTask" name="Archive Invoice">
       <incoming>sequenceFlow13</incoming>
       <outgoing>sequenceFlow14</outgoing>
     </task>

     <endEvent id="theEndEvent" name="Invoice Process Completed"> 
       <incoming>sequenceFlow14</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow14" sourceRef="archiveInvoicesTask" targetRef="theEndEvent"/>
   </process>
</definitions>