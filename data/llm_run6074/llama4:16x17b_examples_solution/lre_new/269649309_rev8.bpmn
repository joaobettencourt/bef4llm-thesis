<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Business Process Model">
  <process id="BagManagementProcess" isExecutable="true">
    <startEvent id="StartEvent1">
      <outgoing>SequenceFlow1</outgoing>
    </startEvent>
    <sequenceFlow id="SequenceFlow1" sourceRef="StartEvent1" targetRef="Task1"/>
    <task id="Task1" name="Check number of resolution retries conducted">
      <incoming>SequenceFlow1</incoming>
      <outgoing>SequenceFlow2</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow2" sourceRef="Task1" targetRef="ExclusiveGateway1"/>
    <exclusiveGateway id="ExclusiveGateway1">
      <incoming>SequenceFlow2</incoming>
      <outgoing>SequenceFlow3</outgoing>
      <outgoing>SequenceFlow4</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow3" sourceRef="ExclusiveGateway1" targetRef="Task2">
      <conditionExpression xsi:type="tFormalExpression">${retries > X}</conditionExpression>
    </sequenceFlow>
    <task id="Task2" name="Return to production for disassemble">
      <incoming>SequenceFlow3</incoming>
      <outgoing>SequenceFlow5</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow5" sourceRef="Task2" targetRef="EndEvent1"/>
    <sequenceFlow id="SequenceFlow4" sourceRef="ExclusiveGateway1" targetRef="Task3">
      <conditionExpression xsi:type="tFormalExpression">${retries <= X}</conditionExpression>
    </sequenceFlow>
    <task id="Task3" name="Try to contact customer by phone and remind to pick up the bag">
      <incoming>SequenceFlow4</incoming>
      <outgoing>SequenceFlow6</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow6" sourceRef="Task3" targetRef="ExclusiveGateway2"/>
    <exclusiveGateway id="ExclusiveGateway2">
      <incoming>SequenceFlow6</incoming>
      <outgoing>SequenceFlow7</outgoing>
      <outgoing>SequenceFlow8</outgoing>
      <outgoing>SequenceFlow9</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow7" sourceRef="ExclusiveGateway2" targetRef="Task4">
      <conditionExpression xsi:type="tFormalExpression">${contactSuccessful and customerWithdrawn}</conditionExpression>
    </sequenceFlow>
    <task id="Task4" name="Return to production for disassemble">
      <incoming>SequenceFlow7</incoming>
      <outgoing>SequenceFlow10</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow10" sourceRef="Task4" targetRef="EndEvent1"/>
    <sequenceFlow id="SequenceFlow8" sourceRef="ExclusiveGateway2" targetRef="Task5">
      <conditionExpression xsi:type="tFormalExpression">${contactSuccessful and customerPromised}</conditionExpression>
    </sequenceFlow>
    <task id="Task5" name="Increase retry count on bag label">
      <incoming>SequenceFlow8</incoming>
      <outgoing>SequenceFlow11</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow11" sourceRef="Task5" targetRef="EndEvent1"/>
    <sequenceFlow id="SequenceFlow9" sourceRef="ExclusiveGateway2" targetRef="Task6">
      <conditionExpression xsi:type="tFormalExpression">${contactUnsuccessful}</conditionExpression>
    </sequenceFlow>
    <task id="Task6" name="Increase retry count on bag label">
      <incoming>SequenceFlow9</incoming>
      <outgoing>SequenceFlow12</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow12" sourceRef="Task6" targetRef="EndEvent1"/>
    <endEvent id="EndEvent1">
      <incoming>SequenceFlow5</incoming>
      <incoming>SequenceFlow10</incoming>
      <incoming>SequenceFlow11</incoming>
      <incoming>SequenceFlow12</incoming>
    </endEvent>
  </process>
</definitions>