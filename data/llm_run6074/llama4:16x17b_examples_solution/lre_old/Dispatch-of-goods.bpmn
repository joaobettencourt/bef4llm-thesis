<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" 
             targetNamespace="http://example.com/bpmn">

   <process id="ShipmentProcess" isExecutable="true">
     <laneSet>
       <lane id="SecretaryLane" name="Secretary">
         <flowNodeRef>ClarifyShipmentMethod</flowNodeRef>
         <flowNodeRef>WritePackageLabel</flowNodeRef>
         <flowNodeRef>GetOffersFromLogisticCompanies</flowNodeRef>
         <flowNodeRef>SelectLogisticCompany</flowNodeRef>
       </lane>
       <lane id="LogisticsLane" name="Logistics">
         <flowNodeRef>InsureParcel</flowNodeRef>
       </lane>
       <lane id="WarehouseLane" name="Warehouse">
         <flowNodeRef>PackageGoods</flowNodeRef>
         <flowNodeRef>PrepareForPickingUpGoods</flowNodeRef>
       </lane>
     </laneSet>

     <startEvent id="StartEvent1">
       <outgoing>SF1</outgoing>
     </startEvent>

     <sequenceFlow id="SF1" sourceRef="StartEvent1" targetRef="ClarifyShipmentMethod"/>

     <task id="ClarifyShipmentMethod">
       <incoming>SF1</incoming>
       <outgoing>SF2</outgoing>
     </task>

     <sequenceFlow id="SF2" sourceRef="ClarifyShipmentMethod" targetRef="SpecialHandlingGateway"/>

     <exclusiveGateway id="SpecialHandlingGateway">
       <incoming>SF2</incoming>
       <outgoing>SF3</outgoing>
       <outgoing>SF4</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SF3" name="yes" sourceRef="SpecialHandlingGateway" targetRef="GetOffersFromLogisticCompanies">
     </sequenceFlow>

     <task id="GetOffersFromLogisticCompanies">
       <incoming>SF3</incoming>
       <outgoing>SF5</outgoing>
     </task>

     <sequenceFlow id="SF5" sourceRef="GetOffersFromLogisticCompanies" targetRef="SelectLogisticCompany"/>

     <task id="SelectLogisticCompany">
       <incoming>SF5</incoming>
       <outgoing>SF6</outgoing>
     </task>

     <sequenceFlow id="SF6" sourceRef="SelectLogisticCompany" targetRef="InclusiveGateway1"/>

     <sequenceFlow id="SF4" name="no" sourceRef="SpecialHandlingGateway" targetRef="WritePackageLabel"/>

     <task id="WritePackageLabel">
       <incoming>SF4</incoming>
       <outgoing>SF7</outgoing>
     </task>

     <sequenceFlow id="SF7" sourceRef="WritePackageLabel" targetRef="InclusiveGateway1"/>

     <inclusiveGateway id="InclusiveGateway1">
       <incoming>SF6</incoming>
       <incoming>SF7</incoming>
       <outgoing>SF8</outgoing>
     </inclusiveGateway>

     <sequenceFlow id="SF8" sourceRef="InclusiveGateway1" targetRef="InsureParcel"/>

     <task id="InsureParcel">
       <incoming>SF8</incoming>
       <outgoing>SF9</outgoing>
     </task>

     <sequenceFlow id="SF9" sourceRef="InsureParcel" targetRef="ParallelGateway1"/>

     <parallelGateway id="ParallelGateway1">
       <incoming>SF9</incoming>
       <outgoing>SF10</outgoing>
       <outgoing>SF11</outgoing>
     </parallelGateway>

     <sequenceFlow id="SF10" sourceRef="ParallelGateway1" targetRef="PackageGoods"/>

     <task id="PackageGoods">
       <incoming>SF10</incoming>
       <outgoing>SF12</outgoing>
     </task>

     <sequenceFlow id="SF11" sourceRef="ParallelGateway1" targetRef="PrepareForPickingUpGoods"/>

     <task id="PrepareForPickingUpGoods">
       <incoming>SF11</incoming>
       <outgoing>SF13</outgoing>
     </task>

     <sequenceFlow id="SF13" sourceRef="PrepareForPickingUpGoods" targetRef="EndEvent1"/>

     <endEvent id="EndEvent1">
       <incoming>SF13</incoming>
     </endEvent>
   </process>
</definitions>