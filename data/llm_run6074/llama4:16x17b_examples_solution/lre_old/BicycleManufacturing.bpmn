<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" 
             targetNamespace="http://example.com/bpmn">

   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="ExclusiveGateway_1"/>

     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
       <outgoing>SequenceFlow_3</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_2" name="yes" sourceRef="ExclusiveGateway_1" targetRef="Task_1">
       <conditionExpression xsi:type="tFormalExpression">${order.accepted  == true}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="SequenceFlow_3" name="no" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_1"/>

     <task id="Task_1" name="Inform Storehouse and Engineering Department">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_4</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_4" sourceRef="Task_1" targetRef="ParallelGateway_1"/>

     <parallelGateway id="ParallelGateway_1">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_5</outgoing>
       <outgoing>SequenceFlow_6</outgoing>
     </parallelGateway>

     <sequenceFlow id="SequenceFlow_5" sourceRef="ParallelGateway_1" targetRef="Task_2"/>

     <task id="Task_2" name="Process Part List">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_7</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_6" sourceRef="ParallelGateway_1" targetRef="Task_3"/>

     <task id="Task_3" name="Prepare for Assembling">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_8</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_7" sourceRef="Task_2" targetRef="ExclusiveGateway_2"/>

     <exclusiveGateway id="ExclusiveGateway_2">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_9</outgoing>
       <outgoing>SequenceFlow_10</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_9" name="available" sourceRef="ExclusiveGateway_2" targetRef="Task_4">
       <conditionExpression xsi:type="tFormalExpression">${part.available  == true}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="SequenceFlow_10" name="not available" sourceRef="ExclusiveGateway_2" targetRef="Task_5"/>

     <task id="Task_4" name="Reserve Part">
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_11</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_11" sourceRef="Task_4" targetRef="ExclusiveGateway_3"/>

     <task id="Task_5" name="Backorder Part">
       <incoming>SequenceFlow_10</incoming>
       <outgoing>SequenceFlow_12</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_12" sourceRef="Task_5" targetRef="ExclusiveGateway_3"/>

     <exclusiveGateway id="ExclusiveGateway_3">
       <incoming>SequenceFlow_11</incoming>
       <incoming>SequenceFlow_12</incoming>
       <outgoing>SequenceFlow_13</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_13" sourceRef="ExclusiveGateway_3" targetRef="ParallelGateway_2"/>

     <parallelGateway id="ParallelGateway_2">
       <incoming>SequenceFlow_13</incoming>
       <outgoing>SequenceFlow_14</outgoing>
     </parallelGateway>

     <sequenceFlow id="SequenceFlow_14" sourceRef="ParallelGateway_2" targetRef="Task_6"/>

     <task id="Task_6" name="Assemble Bicycle">
       <incoming>SequenceFlow_14</incoming>
       <outgoing>SequenceFlow_15</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_15" sourceRef="Task_6" targetRef="Task_7"/>

     <task id="Task_7" name="Ship Bicycle to Customer">
       <incoming>SequenceFlow_15</incoming>
       <outgoing>SequenceFlow_16</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_16" sourceRef="Task_7" targetRef="EndEvent_1"/>

     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_3</incoming>
       <incoming>SequenceFlow_16</incoming>
     </endEvent>

   </process>

</definitions>