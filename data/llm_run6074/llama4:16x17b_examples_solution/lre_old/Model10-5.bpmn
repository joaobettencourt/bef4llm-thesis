<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="MPON MPOO Process" targetNamespace="http://example.com">

   <collaboration id="Collaboration_1">
     <participant id="Participant_0" name="MPON" processRef="Pool_0"/>
     <participant id="Participant_1" name="MPOO" processRef="Pool_1"/>
     <messageFlow id="MessageFlow_2" sourceRef="Task_0" targetRef="StartEvent_1"/>
     <messageFlow id="MessageFlow_1" sourceRef="Task_2" targetRef="Task_1"/>
     <messageFlow id="MessageFlow_3" sourceRef="EndEvent_1" targetRef="Task_3"/>
   </collaboration>

   <process id="Pool_0" isExecutable="true">
     <startEvent id="StartEvent_0">
       <outgoing>SequenceFlow_0</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_0" sourceRef="StartEvent_0" targetRef="Task_0"/>

     <task id="Task_0" name="Request a device takeover bid">
       <incoming>SequenceFlow_0</incoming>
       <outgoing>SequenceFlow_1</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_1" sourceRef="Task_0" targetRef="Task_1"/>

     <task id="Task_1" name="Order">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="EndEvent_0"/>

     <endEvent id="EndEvent_0">
       <incoming>SequenceFlow_2</incoming>
     </endEvent>
   </process>

   <process id="Pool_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <incoming>MessageFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_3" sourceRef="StartEvent_1" targetRef="Task_2"/>

     <task id="Task_2" name="Tender the equipment takeover">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_4</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_4" sourceRef="Task_2" targetRef="Task_3"/>

     <task id="Task_3" name="Confirm order and transmission of master data">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_3" targetRef="EndEvent_1"/>

     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_5</incoming>
     </endEvent>
   </process>
</definitions>