<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Text Description" targetNamespace="http://bpmn.io/schema/bpmn">

   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>

     <task id="Task_1" name="Locate and Distribute Existing Designs">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="ParallelGateway_1"/>

     <parallelGateway id="ParallelGateway_1">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_4</outgoing>
     </parallelGateway>

     <sequenceFlow id="SequenceFlow_3" sourceRef="ParallelGateway_1" targetRef="Task_2"/>
     <sequenceFlow id="SequenceFlow_4" sourceRef="ParallelGateway_1" targetRef="Task_3"/>

     <task id="Task_2" name="Update Electrical Design">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>

     <task id="Task_3" name="Update Physical Design">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_2" targetRef="ExclusiveGateway_1"/>
     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_3" targetRef="ExclusiveGateway_2"/>

     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_7</outgoing>
       <outgoing>SequenceFlow_8</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_7" sourceRef="ExclusiveGateway_1" targetRef="Task_3"/>
     <sequenceFlow id="SequenceFlow_8" sourceRef="ExclusiveGateway_1" targetRef="Task_2"/>

     <exclusiveGateway id="ExclusiveGateway_2">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_9</outgoing>
       <outgoing>SequenceFlow_10</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_9" sourceRef="ExclusiveGateway_2" targetRef="Task_2"/>
     <sequenceFlow id="SequenceFlow_10" sourceRef="ExclusiveGateway_2" targetRef="Task_3"/>

     <task id="Task_4" name="Test Electrical Design">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_11</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_11" sourceRef="Task_4" targetRef="ExclusiveGateway_3"/>

     <exclusiveGateway id="ExclusiveGateway_3">
       <incoming>SequenceFlow_11</incoming>
       <outgoing>SequenceFlow_12</outgoing>
       <outgoing>SequenceFlow_13</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_12" sourceRef="ExclusiveGateway_3" targetRef="Task_2"/>
     <sequenceFlow id="SequenceFlow_13" sourceRef="ExclusiveGateway_3" targetRef="ParallelGateway_2"/>

     <task id="Task_5" name="Test Physical Design">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_14</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_14" sourceRef="Task_5" targetRef="ExclusiveGateway_4"/>

     <exclusiveGateway id="ExclusiveGateway_4">
       <incoming>SequenceFlow_14</incoming>
       <outgoing>SequenceFlow_15</outgoing>
       <outgoing>SequenceFlow_16</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_15" sourceRef="ExclusiveGateway_4" targetRef="Task_3"/>
     <sequenceFlow id="SequenceFlow_16" sourceRef="ExclusiveGateway_4" targetRef="ParallelGateway_2"/>

     <parallelGateway id="ParallelGateway_2">
       <incoming>SequenceFlow_13</incoming>
       <incoming>SequenceFlow_16</incoming>
       <outgoing>SequenceFlow_17</outgoing>
     </parallelGateway>

     <sequenceFlow id="SequenceFlow_17" sourceRef="ParallelGateway_2" targetRef="Task_6"/>

     <task id="Task_6" name="Combine and Test Designs">
       <incoming>SequenceFlow_17</incoming>
       <outgoing>SequenceFlow_18</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_18" sourceRef="Task_6" targetRef="ExclusiveGateway_5"/>

     <exclusiveGateway id="ExclusiveGateway_5">
       <incoming>SequenceFlow_18</incoming>
       <outgoing>SequenceFlow_19</outgoing>
       <outgoing>SequenceFlow_20</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_19" sourceRef="ExclusiveGateway_5" targetRef="EndEvent_1"/>
     <sequenceFlow id="SequenceFlow_20" sourceRef="ExclusiveGateway_5" targetRef="StartEvent_1"/>

     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_19</incoming>
     </endEvent>

   </process>
</definitions>