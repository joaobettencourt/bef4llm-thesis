<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Order Process" targetNamespace="http://example.com">

   <collaboration id="Collaboration_1">
     <participant id="Participant_0" name="Supplier" processRef="Pool_0"/>
     <participant id="Participant_1" name="Assembler AG" processRef="Pool_1"/>
     <messageFlow id="MessageFlow_0" sourceRef="Task_1" targetRef="Task_3"/>
   </collaboration>

   <process id="Pool_0" isExecutable="false">
     <laneSet>
       <lane id="Lane_0" name="Accounts Department">
         <flowNodeRef>Task_0</flowNodeRef>
         <flowNodeRef>StartEvent_0</flowNodeRef>
         <flowNodeRef>Task_1</flowNodeRef>
         <flowNodeRef>EndEvent_0</flowNodeRef>
       </lane>
     </laneSet>

     <startEvent id="StartEvent_0">
       <outgoing>SequenceFlow_0</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_0" sourceRef="StartEvent_0" targetRef="Task_2"/>

     <task id="Task_2" name="Process order">
       <incoming>SequenceFlow_0</incoming>
       <outgoing>SequenceFlow_1</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_1" sourceRef="Task_2" targetRef="Task_1"/>

     <task id="Task_1" name="Send invoice">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="EndEvent_0"/>

     <endEvent id="EndEvent_0">
       <incoming>SequenceFlow_2</incoming>
     </endEvent>
   </process>

   <process id="Pool_1" isExecutable="false">
     <laneSet>
       <lane id="Lane_1" name="Production">
         <flowNodeRef>StartTimerEvent_1</flowNodeRef>
         <flowNodeRef>Task_3</flowNodeRef>
         <flowNodeRef>Task_0</flowNodeRef>
         <flowNodeRef>EndEvent_1</flowNodeRef>
       </lane>
     </laneSet>

     <startEvent id="StartTimerEvent_1">
       <outgoing>SequenceFlow_3</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_3" sourceRef="StartTimerEvent_1" targetRef="Task_3"/>

     <task id="Task_3" name="Create order">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_4</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_4" sourceRef="Task_3" targetRef="Task_0"/>

     <task id="Task_0" name="Receive invoice">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_0" targetRef="EndEvent_1"/>

     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_5</incoming>
     </endEvent>
   </process>
</definitions>