<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="MSP and GO Process" targetNamespace="http://example.com/bpmn">

    <process id="Process_0" isExecutable="true">

      <!-- Start Event  -->
      <startEvent id="StartEvent_1">
        <outgoing>SequenceFlow_1</outgoing>
      </startEvent>

      <!-- Task: Request measurements  -->
      <serviceTask id="RequestMeasurements" name="Request Measurements">
        <incoming>SequenceFlow_1</incoming>
        <outgoing>SequenceFlow_2</outgoing>
      </serviceTask>

      <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="RequestMeasurements"/>

      <!-- Task: Check request  -->
      <userTask id="CheckRequest" name="Check Request">
        <incoming>SequenceFlow_2</incoming>
        <outgoing>SequenceFlow_3</outgoing>
        <outgoing>SequenceFlow_4</outgoing>
      </userTask>

      <sequenceFlow id="SequenceFlow_2" sourceRef="RequestMeasurements" targetRef="CheckRequest"/>

      <!-- Exclusive Gateway  -->
      <exclusiveGateway id="ExclusiveGateway_1">
        <incoming>SequenceFlow_3</incoming>
        <outgoing>SequenceFlow_5</outgoing>
        <outgoing>SequenceFlow_6</outgoing>
      </exclusiveGateway>

      <sequenceFlow id="SequenceFlow_3" sourceRef="CheckRequest" targetRef="ExclusiveGateway_1"/>

      <!-- Sequence for measurement  -->
      <sequenceFlow id="SequenceFlow_5" name="Perform Measurement" sourceRef="ExclusiveGateway_1" targetRef="PerformMeasurements"/>
      <userTask id="PerformMeasurements" name="Perform Measurements">
        <incoming>SequenceFlow_5</incoming>
        <outgoing>SequenceFlow_7</outgoing>
      </userTask>

      <!-- Sequence for denial  -->
      <sequenceFlow id="SequenceFlow_6" name="Deny Request" sourceRef="ExclusiveGateway_1" targetRef="InformAboutFailure"/>
      <userTask id="InformAboutFailure" name="Inform about failure">
        <incoming>SequenceFlow_6</incoming>
        <outgoing>SequenceFlow_8</outgoing>
      </userTask>

      <!-- Transmission of measurements  -->
      <sequenceFlow id="SequenceFlow_7" sourceRef="PerformMeasurements" targetRef="TransmitMeasurements"/>
      <serviceTask id="TransmitMeasurements" name="Transmit Measurements">
        <incoming>SequenceFlow_7</incoming>
        <outgoing>SequenceFlow_9</outgoing>
      </serviceTask>

      <!-- Processing of measurements  -->
      <sequenceFlow id="SequenceFlow_8" sourceRef="InformAboutFailure" targetRef="EndEvent_1"/>
      <endEvent id="EndEvent_1">
        <incoming>SequenceFlow_8</incoming>
      </endEvent>

      <sequenceFlow id="SequenceFlow_9" sourceRef="TransmitMeasurements" targetRef="ProcessMeasurements"/>
      <userTask id="ProcessMeasurements" name="Process Measurements">
        <incoming>SequenceFlow_9</incoming>
        <outgoing>SequenceFlow_10</outgoing>
      </userTask>

      <!-- Send changed values  -->
      <sequenceFlow id="SequenceFlow_10" sourceRef="ProcessMeasurements" targetRef="SendChangedValues"/>
      <serviceTask id="SendChangedValues" name="Send Changed Values">
        <incoming>SequenceFlow_10</incoming>
        <outgoing>SequenceFlow_11</outgoing>
      </serviceTask>

      <!-- Transmission to SP  -->
      <sequenceFlow id="SequenceFlow_11" sourceRef="SendChangedValues" targetRef="EndEvent_2"/>
      <endEvent id="EndEvent_2">
        <incoming>SequenceFlow_11</incoming>
      </endEvent>
    </process>
</definitions>