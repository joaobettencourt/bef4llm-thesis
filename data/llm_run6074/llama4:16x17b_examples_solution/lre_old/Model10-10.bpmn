<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" 
             targetNamespace="http://bpmn.io/schema/bpmn">

   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_ExamineFailure"/>

     <task id="Task_ExamineFailure" name="Examine Failure Report">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
       <outgoing>SequenceFlow_3</outgoing>
     </task>

     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_2</incoming>
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_4</outgoing>
       <outgoing>SequenceFlow_5</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_2" name="Confirm Failure" sourceRef="Task_ExamineFailure" targetRef="ExclusiveGateway_1"/>
     <sequenceFlow id="SequenceFlow_3" name="Reject Failure" sourceRef="Task_ExamineFailure" targetRef="ExclusiveGateway_1"/>

     <task id="Task_InformCustomerAndManager" name="Inform Customer and Manager about failure">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_1" targetRef="Task_InformCustomerAndManager"/>

     <task id="Task_RepairFault" name="Fix Fault">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_7</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_InformCustomerAndManager" targetRef="Task_RepairFault"/>

     <task id="Task_ShareResults" name="Share results of repair with Fault Detector">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_8</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_7" sourceRef="Task_RepairFault" targetRef="Task_ShareResults"/>

     <task id="Task_InformeCustomerAndManagerResolution" name="Inform Customer and Manager about resolution">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_8" sourceRef="Task_ShareResults" targetRef="Task_InformeCustomerAndManagerResolution"/>

     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_9</incoming>
     </endEvent>

     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_InformeCustomerAndManagerResolution" targetRef="EndEvent_1"/>
   </process>
</definitions>