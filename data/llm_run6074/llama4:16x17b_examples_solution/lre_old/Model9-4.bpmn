<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" 
             name="Text Description"
             targetNamespace="http://example.com/bpmn">

   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>

     <task id="Task_1" name="Update all group calendars and create meeting folders">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="Task_2"/>

     <task id="Task_2" name="Upload all relevant documents">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_3" sourceRef="Task_2" targetRef="IntermediateThrowEvent_1"/>

     <intermediateCatchEvent id="IntermediateThrowEvent_1">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_4</outgoing>
       <timerEventDefinition/>
     </intermediateCatchEvent>

     <sequenceFlow id="SequenceFlow_4" sourceRef="IntermediateThrowEvent_1" targetRef="Task_3"/>

     <task id="Task_3" name="Remind Committee Members to read documents a week before meeting">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_3" targetRef="Task_4"/>

     <task id="Task_4" name="Committee Members hold meeting">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_4" targetRef="Task_5"/>

     <task id="Task_5" name="Produce meeting minutes">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_7</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_7" sourceRef="Task_5" targetRef="ExclusiveGateway_1"/>

     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_8</outgoing>
       <outgoing>SequenceFlow_9</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_8" sourceRef="ExclusiveGateway_1" targetRef="Task_6">
       <conditionExpression xsi:type="tFormalExpression">${minutesValidated  == true}</conditionExpression>
     </sequenceFlow>

     <task id="Task_6" name="Send minutes to Committee Members">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_11</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_11" sourceRef="Task_6" targetRef="EndEvent_1"/>

     <sequenceFlow id="SequenceFlow_9" sourceRef="ExclusiveGateway_1" targetRef="IntermediateCatchEvent_2">
       <conditionExpression xsi:type="tFormalExpression">${minutesValidated  == false}</conditionExpression>
     </sequenceFlow>

     <intermediateCatchEvent id="IntermediateCatchEvent_2">
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_10</outgoing>
       <timerEventDefinition/>
     </intermediateCatchEvent>

     <sequenceFlow id="SequenceFlow_10" sourceRef="IntermediateCatchEvent_2" targetRef="Task_7"/>

     <task id="Task_7" name="Conduct QA check on minutes">
       <incoming>SequenceFlow_10</incoming>
       <outgoing>SequenceFlow_12</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_12" sourceRef="Task_7" targetRef="Task_8"/>

     <task id="Task_8" name="Send minutes to Committee Members">
       <incoming>SequenceFlow_12</incoming>
       <outgoing>SequenceFlow_13</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_13" sourceRef="Task_8" targetRef="EndEvent_1"/>

     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_11</incoming>
       <incoming>SequenceFlow_13</incoming>
     </endEvent>

   </process>
</definitions>