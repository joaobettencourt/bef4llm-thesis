<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Text Description" targetNamespace="http://bpmn.io/schema/bpmn">

   <collaboration id="Collaboration_1">
     <participant id="Participant_0" name="Customer Service" processRef="Pool_0"/>
     <participant id="Participant_1" name="Customer" processRef="Pool_1"/>
     <participant id="Participant_2" name="Service Management" processRef="Pool_2"/>
     <participant id="Participant_3" name="Resource Provisioning" processRef="Pool_3"/>
   </collaboration>

   <process id="Pool_0" isExecutable="true">
     <laneSet>
       <lane id="Lane_0" name="">
         <flowNodeRef>StartNoneEvent_0</flowNodeRef>
         <flowNodeRef>Task_0</flowNodeRef>
         <flowNodeRef>Task_1</flowNodeRef>
         <flowNodeRef>ExclusiveGateway_0</flowNodeRef>
         <flowNodeRef>EndNoneEvent_0</flowNodeRef>
       </lane>
     </laneSet>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartNoneEvent_0" targetRef="Task_0"/>
     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_0" targetRef="Task_1"/>
     <sequenceFlow id="SequenceFlow_3" sourceRef="Task_1" targetRef="ExclusiveGateway_0"/>

     <startEvent id="StartNoneEvent_0">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <task id="Task_0" name="Send list of problem parameters">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>

     <task id="Task_1" name="Enter problem report into system T">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
     </task>

     <exclusiveGateway id="ExclusiveGateway_0">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_4</outgoing>
       <outgoing>SequenceFlow_5</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_0" targetRef="Task_2"/>
     <sequenceFlow id="SequenceFlow_5" sourceRef="ExclusiveGateway_0" targetRef="EndNoneEvent_0"/>

     <task id="Task_2" name="Determine significance of the customer">
       <incoming>SequenceFlow_4</incoming>
     </task>

     <endEvent id="EndNoneEvent_0">
       <incoming>SequenceFlow_5</incoming>
     </endEvent>
   </process>

   <process id="Pool_1" isExecutable="true">
     <!-- Customer process elements -->
     <startEvent id="StartErrorEvent_0">
       <!-- outgoing sequence flow -->
     </startEvent>
   </process>

   <process id="Pool_2" isExecutable="true">
     <!-- Service Management process elements -->
     <task id="Task_SM_0" name="Investigate whether problem is analyzable at this level">
       <!-- incoming and outgoing sequence flows -->
     </task>
   </process>

   <process id="Pool_3" isExecutable="true">
     <!-- Resource Provisioning process elements -->
     <task id="Task_RP_0" name="Check for possible problems">
       <!-- incoming and outgoing sequence flows -->
     </task>
   </process>

</definitions>