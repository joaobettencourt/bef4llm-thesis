<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Vacation Request Process" targetNamespace="http://example.com">

   <process id="Process_1" isExecutable="true">
     <laneSet>
       <lane id="Lane_Employee" name="Employee">
         <flowNodeRef>StartEvent_1</flowNodeRef>
         <flowNodeRef>Task_RegisterRequest</flowNodeRef>
         <flowNodeRef>Task_InformeRejection</flowNodeRef>
       </lane>
       <lane id="Lane_Supervisor" name="Supervisor">
         <flowNodeRef>Task_VerifyVacationDays</flowNodeRef>
         <flowNodeRef>ExclusiveGateway_ApproveRequest</flowNodeRef>
         <flowNodeRef>Task_ApproveRequest</flowNodeRef>
         <flowNodeRef>Task_RejectRequest</flowNodeRef>
       </lane>
       <lane id="Lane_HumanResources" name="Human Resources">
         <flowNodeRef>Task_ManageRequest</flowNodeRef>
       </lane>
     </laneSet>

     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_RegisterRequest"/>

     <task id="Task_RegisterRequest" name="Register Vacation Request">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_RegisterRequest" targetRef="Task_VerifyVacationDays"/>

     <task id="Task_VerifyVacationDays" name="Verify Available Vacation Days">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_3" sourceRef="Task_VerifyVacationDays" targetRef="ExclusiveGateway_ApproveRequest"/>

     <exclusiveGateway id="ExclusiveGateway_ApproveRequest">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_4</outgoing>
       <outgoing>SequenceFlow_5</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_4" name="Approved" sourceRef="ExclusiveGateway_ApproveRequest" targetRef="Task_ManageRequest">
       <conditionExpression xsi:type="tFormalExpression">${approved  == true}</conditionExpression>
     </sequenceFlow>

     <task id="Task_ManageRequest" name="Manage Request">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_ManageRequest" targetRef="EndEvent_1"/>

     <sequenceFlow id="SequenceFlow_5" name="Rejected" sourceRef="ExclusiveGateway_ApproveRequest" targetRef="Task_RejectRequest">
       <conditionExpression xsi:type="tFormalExpression">${approved  == false}</conditionExpression>
     </sequenceFlow>

     <task id="Task_RejectRequest" name="Inform Employee about Rejection Reasons">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_7</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_7" sourceRef="Task_RejectRequest" targetRef="Task_InformeRejection"/>

     <task id="Task_InformeRejection" name="Review Rejection Reasons">
       <incoming>SequenceFlow_7</incoming>
     </task>

     <task id="Task_ApproveRequest" name="Approve Request">
       <!-- Removed, as it was not used -->
     </task>

     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_6</incoming>
     </endEvent>

   </process>
</definitions>