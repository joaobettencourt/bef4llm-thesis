<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">
   <process id="findJobProcess" isExecutable="true">
     <startEvent id="unemployedStart" name="Unemployed">
       <outgoing>writeApplication</outgoing>
     </startEvent>
     <sequenceFlow id="writeApplicationSeq" sourceRef="unemployedStart" targetRef="writeJobApplication"/>
     <manualTask id="writeJobApplication" name="Write job application">
       <incoming>writeApplicationSeq</incoming>
       <outgoing>sendJobApplicationSeq</outgoing>
     </manualTask>
     <sequenceFlow id="sendJobApplicationSeq" sourceRef="writeJobApplication" targetRef="sendJobApplicationTask"/>
     <serviceTask id="sendJobApplicationTask" name="Send job application">
       <incoming>sendJobApplicationSeq</incoming>
       <outgoing>reportJobApplicationSeq</outgoing>
     </serviceTask>
     <sequenceFlow id="reportJobApplicationSeq" sourceRef="sendJobApplicationTask" targetRef="reportJobApplicationTask"/>
     <manualTask id="reportJobApplicationTask" name="Report job application">
       <incoming>reportJobApplicationSeq</incoming>
       <outgoing>receiveConfirmationOfApplicationEntrySeq</outgoing>
     </manualTask>
     <sequenceFlow id="receiveConfirmationOfApplicationEntrySeq" sourceRef="reportJobApplicationTask" targetRef="receiveConfirmationOfApplicationEntryTask"/>
     <serviceTask id="receiveConfirmationOfApplicationEntryTask" name="Receive confirmation of application entry">
       <incoming>receiveConfirmationOfApplicationEntrySeq</incoming>
       <outgoing>jobApplicationSuccessfulSeq</outgoing>
     </serviceTask>
     <sequenceFlow id="jobApplicationSuccessfulSeq" sourceRef="receiveConfirmationOfApplicationEntryTask" targetRef="jobApplicationSuccessfulGateway"/>
     <exclusiveGateway id="jobApplicationSuccessfulGateway">
       <incoming>jobApplicationSuccessfulSeq</incoming>
       <outgoing>jobInterviewSeq</outgoing>
       <outgoing>applicationRejectedSeq</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="jobInterviewSeq" name="yes" sourceRef="jobApplicationSuccessfulGateway" targetRef="negotiateJobInterviewTask">
       <conditionExpression xsi:type="tFormalExpression">${job.application.successful}</conditionExpression>
     </sequenceFlow>
     <sequenceFlow id="applicationRejectedSeq" name="no" sourceRef="jobApplicationSuccessfulGateway" targetRef="receivePotentialJobOffersTask"/>
     <manualTask id="negotiateJobInterviewTask" name="Negotiate job interview">
       <incoming>jobInterviewSeq</incoming>
       <outgoing>jobInterviewSuccessfulSeq2</outgoing>
     </manualTask>
     <sequenceFlow id="jobInterviewSuccessfulSeq2" sourceRef="negotiateJobInterviewTask" targetRef="jobInterviewSuccessfulGateway2"/>
     <exclusiveGateway id="jobInterviewSuccessfulGateway2">
       <incoming>jobInterviewSuccessfulSeq2</incoming>
       <outgoing>startJobProbationPhaseSeq</outgoing>
       <outgoing>applicationRejectedAfterInterviewSeq</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="startJobProbationPhaseSeq" name="yes" sourceRef="jobInterviewSuccessfulGateway2" targetRef="startJobProbationPhaseTask">
       <conditionExpression xsi:type="tFormalExpression">${job.interview.successful}</conditionExpression>
     </sequenceFlow>
     <manualTask id="startJobProbationPhaseTask" name="Start job (probation phase)">
       <incoming>startJobProbationPhaseSeq</incoming>
       <outgoing>probationPhaseFinishedSeq</outgoing>
     </manualTask>
     <intermediateCatchEvent id="probationPhaseFinished" name="Probation phase finished">
       <incoming>probationPhaseFinishedSeq</incoming>
       <timerEventDefinition/>
       <outgoing>rateCompanySeq</outgoing>
     </intermediateCatchEvent>
     <sequenceFlow id="probationPhaseFinishedSeq" sourceRef="startJobProbationPhaseTask" targetRef="probationPhaseFinished"/>
     <sequenceFlow id="rateCompanySeq" sourceRef="probationPhaseFinished" targetRef="rateCompanyTask"/>
     <manualTask id="rateCompanyTask" name="Rate company">
       <incoming>rateCompanySeq</incoming>
       <outgoing>jobPermanentGatewaySeq</outgoing>
     </manualTask>
     <sequenceFlow id="jobPermanentGatewaySeq" sourceRef="rateCompanyTask" targetRef="jobPermanentExclusiveGateway"/>
     <exclusiveGateway id="jobPermanentExclusiveGateway">
       <incoming>jobPermanentGatewaySeq</incoming>
       <outgoing>applicationProcessFinishedSeq</outgoing>
       <outgoing>continueReceivingJobOffersSeq</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="applicationProcessFinishedSeq" name="yes" sourceRef="jobPermanentExclusiveGateway" targetRef="applicationProcessFinishedEnd">
       <conditionExpression xsi:type="tFormalExpression">${job.permanent}</conditionExpression>
     </sequenceFlow>
     <endEvent id="applicationProcessFinishedEnd" name="Application process finished">
       <incoming>applicationProcessFinishedSeq</incoming>
     </endEvent>
     <sequenceFlow id="continueReceivingJobOffersSeq" name="no" sourceRef="jobPermanentExclusiveGateway" targetRef="receivePotentialJobOffersTask"/>
     <serviceTask id="receivePotentialJobOffersTask" name="Receive potential job offers">
       <incoming>applicationRejectedSeq</incoming>
       <incoming>continueReceivingJobOffersSeq</incoming>
       <standardLoopCharacteristics testBefore="false"/>
       <outgoing>writeApplicationSeq2</outgoing>
     </serviceTask>
     <sequenceFlow id="writeApplicationSeq2" sourceRef="receivePotentialJobOffersTask" targetRef="writeJobApplication"/>
     <endEvent id="unemployedEnd" name="Unemployed">
       <incoming>applicationRejectedAfterInterviewSeq</incoming>
     </endEvent>
     <sequenceFlow id="applicationRejectedAfterInterviewSeq" name="no" sourceRef="jobInterviewSuccessfulGateway2" targetRef="unemployedEnd"/>
   </process>
</definitions>