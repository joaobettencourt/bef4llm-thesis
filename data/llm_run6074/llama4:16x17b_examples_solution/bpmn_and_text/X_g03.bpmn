<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="definitions" targetNamespace="http://www.example.com">
   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>
     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>
     <task id="Task_1" name="Select starting block">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="ParallelGateway_1"/>
     <parallelGateway id="ParallelGateway_1">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_7</outgoing>
     </parallelGateway>
     <sequenceFlow id="SequenceFlow_3" sourceRef="ParallelGateway_1" targetRef="Task_2"/>
     <task id="Task_2" name="Run 5 km">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_4</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_4" sourceRef="Task_2" targetRef="Gateway_1"/>
     <exclusiveGateway id="Gateway_1">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_5</outgoing>
       <outgoing>SequenceFlow_6</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_5" name="yes" sourceRef="Gateway_1" targetRef="Task_3">
       <conditionExpression xsi:type="tFormalExpression">${runTime <= 25}</conditionExpression>
     </sequenceFlow>
     <task id="Task_3" name="Get starting number">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_8</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_8" sourceRef="Task_3" targetRef="ExclusiveGateway_2"/>
     <sequenceFlow id="SequenceFlow_6" name="no" sourceRef="Gateway_1" targetRef="Task_4"/>
     <task id="Task_4" name="Do Training">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_4" targetRef="Task_1"/>
     <exclusiveGateway id="ExclusiveGateway_2">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_10</outgoing>
       <outgoing>SequenceFlow_11</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_10" name="yes" sourceRef="ExclusiveGateway_2" targetRef="Task_5">
       <conditionExpression xsi:type="tFormalExpression">${workdayEnd > startTime - 60}</conditionExpression> 
     </sequenceFlow>
     <task id="Task_5" name="Go to the run from home">
       <incoming>SequenceFlow_10</incoming>
       <outgoing>SequenceFlow_12</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_12" sourceRef="Task_5" targetRef="ParallelGateway_2"/>
     <sequenceFlow id="SequenceFlow_11" name="no" sourceRef="ExclusiveGateway_2" targetRef="Task_6"/>
     <task id="Task_6" name="Go directly after work to the run">
       <incoming>SequenceFlow_11</incoming>
       <outgoing>SequenceFlow_13</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_13" sourceRef="Task_6" targetRef="ParallelGateway_2"/>
     <parallelGateway id="ParallelGateway_2">
       <incoming>SequenceFlow_12</incoming>
       <incoming>SequenceFlow_13</incoming>
       <outgoing>SequenceFlow_14</outgoing>
     </parallelGateway>
     <sequenceFlow id="SequenceFlow_14" sourceRef="ParallelGateway_2" targetRef="Task_7"/>
     <task id="Task_7" name="Run the night run and drink">
       <incoming>SequenceFlow_14</incoming>
       <outgoing>SequenceFlow_15</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_15" sourceRef="Task_7" targetRef="Task_8"/>
     <task id="Task_8" name="Receive final running time">
       <incoming>SequenceFlow_15</incoming>
       <outgoing> SequenceFlow_16</outgoing>
     </task>
     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_16</incoming>
     </endEvent>
     <sequenceFlow id="SequenceFlow_16" sourceRef="Task_8" targetRef="EndEvent_1"/>
     <sequenceFlow id="SequenceFlow_7" sourceRef="ParallelGateway_1" targetRef="Task_2"/>
   </process>
</definitions>