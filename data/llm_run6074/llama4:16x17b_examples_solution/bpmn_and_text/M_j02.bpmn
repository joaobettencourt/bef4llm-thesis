<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">

   <process id="LuxuryAirplaneProcess" isExecutable="true">
     <startEvent id="OrderReceived">
       <outgoing>DefineRequirements</outgoing>
     </startEvent>

     <sequenceFlow id="DefineRequirementsSequenceFlow" sourceRef="OrderReceived" targetRef="DefineRequirements"/>

     <userTask id="DefineRequirements" name="Define Requirements">
       <incoming>DefineRequirementsSequenceFlow</incoming>
       <outgoing>BaseModelDecision</outgoing>
     </userTask>

     <sequenceFlow id="BaseModelDecisionSequenceFlow" sourceRef="DefineRequirements" targetRef="BaseModelDecision"/>

     <exclusiveGateway id="BaseModelDecision">
       <incoming>BaseModelDecisionSequenceFlow</incoming>
       <outgoing>NoCustomization</outgoing>
       <outgoing>WithCustomization</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="NoCustomization" sourceRef="BaseModelDecision" targetRef="OrderParts"/>

     <sequenceFlow id="WithCustomization" sourceRef="BaseModelDecision" targetRef="DesignIndividualParts">

       <conditionExpression xsi:type="tFormalExpression">${customizationRequired}</conditionExpression>
     </sequenceFlow>

     <userTask id="DesignIndividualParts" name="Design Individual Parts">
       <incoming>WithCustomization</incoming>
       <outgoing>OrderPartsCustomized</outgoing>
     </userTask>

     <sequenceFlow id="OrderPartsCustomized" sourceRef="DesignIndividualParts" targetRef="OrderParts"/>

     <serviceTask id="OrderParts" name="Order Parts">
       <incoming>NoCustomization</incoming>
       <incoming>OrderPartsCustomized</incoming>
       <outgoing>AssemblePlane</outgoing>
     </serviceTask>

     <sequenceFlow id="AssemblePlaneSequenceFlow" sourceRef="OrderParts" targetRef="AssemblePlane"/>

     <userTask id="AssemblePlane" name="Assemble Plane">
       <incoming>AssemblePlaneSequenceFlow</incoming>
       <outgoing>MakeTestFlight</outgoing>
     </userTask>

     <sequenceFlow id="MakeTestFlightSequenceFlow" sourceRef="AssemblePlane" targetRef="MakeTestFlight"/>

     <userTask id="MakeTestFlight" name="Make Test Flight">
       <incoming>MakeTestFlightSequenceFlow</incoming>
       <outgoing>CreateTestProtocol</outgoing>
     </userTask>

     <sequenceFlow id="CreateTestProtocolSequenceFlow" sourceRef="MakeTestFlight" targetRef="CreateTestProtocol"/>

     <serviceTask id="CreateTestProtocol" name="Create Test Protocol">
       <incoming>CreateTestProtocolSequenceFlow</incoming>
       <outgoing>NotifyCustomer</outgoing>
     </serviceTask>

     <sequenceFlow id="NotifyCustomerSequenceFlow" sourceRef="CreateTestProtocol" targetRef="NotifyCustomer"/>

     <serviceTask id="NotifyCustomer" name="Notify Customer">
       <incoming>NotifyCustomerSequenceFlow</incoming>
       <outgoing>DeliverPlane</outgoing>
     </serviceTask>

     <sequenceFlow id="DeliverPlaneSequenceFlow" sourceRef="NotifyCustomer" targetRef="DeliverPlane"/>

     <userTask id="DeliverPlane" name="Deliver Plane">
       <incoming>DeliverPlaneSequenceFlow</incoming>
       <outgoing>ConfirmDelivery</outgoing>
     </userTask>

     <sequenceFlow id="ConfirmDeliverySequenceFlow" sourceRef="DeliverPlane" targetRef="EndEvent"/>

     <endEvent id="EndEvent" name="Order Completed">
       <incoming>ConfirmDeliverySequenceFlow</incoming>
     </endEvent>

   </process>

</definitions>