<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/BPMN20.xsd"
             id="definitions" targetNamespace="http://www.example.com">
  <process id="OEE_Process" isExecutable="true">
    <startEvent id="Start_Event_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="Start_Event_1" targetRef="Check_Machine_Connection"/>
    <serviceTask id="Check_Machine_Connection">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </serviceTask>
    <sequenceFlow id="SequenceFlow_2" sourceRef="Check_Machine_Connection" targetRef="Exclusive_Gateway_1"/>
    <exclusiveGateway id="Exclusive_Gateway_1">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
      <outgoing>SequenceFlow_4</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_3" sourceRef="Exclusive_Gateway_1" targetRef="Collect_Machine_Data">
      <conditionExpression xsi:type="tFormalExpression">${machineConnected}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="SequenceFlow_4" sourceRef="Exclusive_Gateway_1" targetRef="End_Event_1">
      <conditionExpression xsi:type="tFormalExpression">${not machineConnected}</conditionExpression>
    </sequenceFlow>
    <serviceTask id="Collect_Machine_Data">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_5</outgoing>
    </serviceTask>
    <sequenceFlow id="SequenceFlow_5" sourceRef="Collect_Machine_Data" targetRef="Calculate_OEE"/>
    <serviceTask id="Calculate_OEE">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </serviceTask>
    <sequenceFlow id="SequenceFlow_6" sourceRef="Calculate_OEE" targetRef="Exclusive_Gateway_2"/>
    <exclusiveGateway id="Exclusive_Gateway_2">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_7</outgoing>
      <outgoing>SequenceFlow_8</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_7" sourceRef="Exclusive_Gateway_2" targetRef="Stop_Machine_Send_Email">
      <conditionExpression xsi:type="tFormalExpression">${oeeValue  < threshold}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="SequenceFlow_8" sourceRef="Exclusive_Gateway_2" targetRef="Continue_Monitoring">
      <conditionExpression xsi:type="tFormalExpression">${oeeValue >= threshold}</conditionExpression>
    </sequenceFlow>
    <userTask id="Stop_Machine_Send_Email">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_9</outgoing>
    </userTask>
    <sequenceFlow id="SequenceFlow_9" sourceRef="Stop_Machine_Send_Email" targetRef="Wait_For_Engineer_Response"/>
    <exclusiveGateway id="Wait_For_Engineer_Response">
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_10</outgoing>
      <outgoing>SequenceFlow_11</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_10" sourceRef="Wait_For_Engineer_Response" targetRef="Restart_Machine">
      <conditionExpression xsi:type="tFormalExpression">${engineerResponded}</conditionExpression>
    </sequenceFlow>
    <userTask id="Continue_Monitoring">
      <incoming>SequenceFlow_8</incoming>
      <outgoing>SequenceFlow_12</outgoing>
    </userTask>
    <sequenceFlow id="SequenceFlow_12" sourceRef="Continue_Monitoring" targetRef="Collect_Machine_Data"/>
    <endEvent id="End_Event_1">
      <incoming>SequenceFlow_4</incoming>
    </endEvent>
  </process>
</definitions>