<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" 
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/06-02-01.xsd" 
             id="definitions" targetNamespace="http://www.example.com">
   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>
     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_0logsintoeshop"/>
     <task id="Task_0logsintoeshop" name="Customer logs into E-Shop">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_0logsintoeshop" targetRef="ServiceTask_1"/>
     <serviceTask id="ServiceTask_1" name="Customer credentials being checked by system">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
     </serviceTask>
     <sequenceFlow id="SequenceFlow_3" sourceRef="ServiceTask_1" targetRef="ExclusiveGateway_1"/>
     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_4</outgoing>
       <outgoing>SequenceFlow_5</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_4" name="yes" sourceRef="ExclusiveGateway_1" targetRef="Task_1">
       <conditionExpression xsi:type="tFormalExpression">${login_successful}</conditionExpression>
     </sequenceFlow>  
     <task id="Task_1" name="Customer selects a product">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_5" name="no" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_0eshopclosed"/>
     <endEvent id="EndEvent_0eshopclosed">
       <incoming>SequenceFlow_5</incoming>
     </endEvent>
     <exclusiveGateway id="ExclusiveGateway_2">
       <outgoing>SequenceFlow_7</outgoing>
       <outgoing>SequenceFlow_10</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_1" targetRef="ExclusiveGateway_2"/>
     <parallelGateway id="ParallelGateway_1">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_8</outgoing>
       <outgoing>SequenceFlow_9</outgoing>
     </parallelGateway>
     <sequenceFlow id="SequenceFlow_7" sourceRef="ExclusiveGateway_2" targetRef="ParallelGateway_1"/>
     <task id="Task_3" name="Customer adds product to shopping cart">
       <incoming>SequenceFlow_10</incoming>
       <outgoing>SequenceFlow_11</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_8" sourceRef="ParallelGateway_1" targetRef="ServiceTask_2"/>
     <serviceTask id="ServiceTask_2" name="Payment is prepared by system">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_12</outgoing>
     </serviceTask>
     <sequenceFlow id="SequenceFlow_9" sourceRef="ParallelGateway_1" targetRef="ServiceTask_3"/>
     <serviceTask id="ServiceTask_3" name="Shipment is prepared by system">
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_13</outgoing>
     </serviceTask>
     <sequenceFlow id="SequenceFlow_10" sourceRef="ExclusiveGateway_2" targetRef="Task_3"/>
     <sequenceFlow id="SequenceFlow_11" sourceRef="Task_3" targetRef="ExclusiveGateway_2"/> 
     <task id="Task_payment" name="Customer enters payment data">
       <incoming>SequenceFlow_12</incoming>
       <outgoing>SequenceFlow_14</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_12" sourceRef="ServiceTask_2" targetRef="Task_payment"/>
     <serviceTask id="ServiceTask_4" name="Bank confirms payment">
       <incoming>SequenceFlow_14</incoming>
       <outgoing>SequenceFlow_15</outgoing>
     </serviceTask>
     <sequenceFlow id="SequenceFlow_13" sourceRef="ServiceTask_3" targetRef="ParallelGateway_2"/>
     <parallelGateway id="ParallelGateway_2">
       <incoming>SequenceFlow_15</incoming>
       <incoming>SequenceFlow_16</incoming>
       <outgoing>SequenceFlow_17</outgoing>
     </parallelGateway>
     <task id="Task_4" name="Customer enters shipping address">
       <incoming>SequenceFlow_13</incoming>
       <outgoing>SequenceFlow_16</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_14" sourceRef="Task_payment" targetRef="ServiceTask_4"/>
     <sequenceFlow id="SequenceFlow_15" sourceRef="ServiceTask_4" targetRef="ParallelGateway_2"/> 
     <sequenceFlow id="SequenceFlow_16" sourceRef="Task_4" targetRef="ParallelGateway_2"/>
     <serviceTask id="ServiceTask_orderfinished" name="Order is finished by system">
       <incoming>SequenceFlow_17</incoming>
       <outgoing>SequenceFlow_18</outgoing>
     </serviceTask>
     <sequenceFlow id="SequenceFlow_17" sourceRef="ParallelGateway_2" targetRef="ServiceTask_orderfinished"/>
     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_18</incoming>
     </endEvent>
     <sequenceFlow id="SequenceFlow_18" sourceRef="ServiceTask_orderfinished" targetRef="EndEvent_1"/> 
   </process>
</definitions>