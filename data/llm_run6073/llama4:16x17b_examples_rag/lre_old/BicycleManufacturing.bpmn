<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">
  <process id="Process_1" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="ExclusiveGateway_1"/>
    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
      <outgoing>SequenceFlow_3</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_2" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_1">
      <conditionExpression xsi:type="tFormalExpression">${orderRejected}</conditionExpression>
    </sequenceFlow>
    <endEvent id="EndEvent_1">
      <incoming>SequenceFlow_2</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_1" targetRef="Task_1">
      <conditionExpression xsi:type="tFormalExpression">${orderAccepted}</conditionExpression>
    </sequenceFlow>
    <task id="Task_1" name="Inform Storehouse and Engineering Department">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_4</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_4" sourceRef="Task_1" targetRef="ParallelGateway_1"/>
    <parallelGateway id="ParallelGateway_1">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_5</outgoing>
      <outgoing>SequenceFlow_6</outgoing>
    </parallelGateway>
    <sequenceFlow id="SequenceFlow_5" sourceRef="ParallelGateway_1" targetRef="Task_2"/>
    <task id="Task_2" name="Process Part List">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_6" sourceRef="ParallelGateway_1" targetRef="Task_3"/>
    <task id="Task_3" name="Prepare for Assembly">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_7" sourceRef="Task_2" targetRef="ExclusiveGateway_2"/>
    <exclusiveGateway id="ExclusiveGateway_2">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_9</outgoing>
      <outgoing>SequenceFlow_10</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_9" sourceRef="ExclusiveGateway_2" targetRef="Task_4">
      <conditionExpression xsi:type="tFormalExpression">${allPartsReserved}</conditionExpression>
    </sequenceFlow>
    <task id="Task_4" name="Assemble Bicycle">
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_11</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_10" sourceRef="ExclusiveGateway_2" targetRef="Task_5"/>
    <task id="Task_5" name="Backorder Parts">
      <incoming>SequenceFlow_10</incoming>
      <!-- Add logic for backordering parts -->
    </task>
    <sequenceFlow id="SequenceFlow_8" sourceRef="Task_3" targetRef="ExclusiveGateway_3"/>
    <exclusiveGateway id="ExclusiveGateway_3">
      <incoming>SequenceFlow_8</incoming>
      <outgoing>SequenceFlow_12</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_11" sourceRef="Task_4" targetRef="Task_6"/>
    <task id="Task_6" name="Ship Bicycle">
      <incoming>SequenceFlow_11</incoming>
      <outgoing>SequenceFlow_12</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_12" sourceRef="Task_6" targetRef="EndEvent_2"/>
    <endEvent id="EndEvent_2">
      <incoming>SequenceFlow_12</incoming>
    </endEvent>
  </process>
</definitions>