<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">
  <process id="Process_1" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>
    <task id="Task_1" name="Check Defect and Calculate Repair Cost">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="ExclusiveGateway_1"/>
    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
      <outgoing>SequenceFlow_4</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_1">
      <conditionExpression xsi:type="tFormalExpression">${costsAcceptable == true}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_2"/>
    <task id="Task_2" name="Check and Repair Hardware">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </task>
    <task id="Task_3" name="Check and Configure Software">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </task>
    <parallelGateway id="ParallelGateway_1">
      <incoming>SequenceFlow_4-1</incoming>
      <outgoing>SequenceFlow_5</outgoing>
    </parallelGateway>
    <sequenceFlow id="SequenceFlow_5" sourceRef="ParallelGateway_1" targetRef="Task_2"/>
    <sequenceFlow id="SequenceFlow_6" sourceRef="Task_2" targetRef="IntermediateCatchEvent_1">
      <conditionExpression xsi:type="tFormalExpression">${hardwareFunctional == true}</conditionExpression>
    </sequenceFlow>
    <intermediateCatchEvent id="IntermediateCatchEvent_1">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </intermediateCatchEvent>
    <task id="Task_4" name="Perform Additional Repair Activity">
      <incoming>SequenceFlow_8</incoming>
      <outgoing>SequenceFlow_9</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_7" sourceRef="Task_3" targetRef="IntermediateCatchEvent_2">
      <conditionExpression xsi:type="tFormalExpression">${softwareFunctional == true}</conditionExpression>
    </sequenceFlow>
    <intermediateCatchEvent id="IntermediateCatchEvent_2">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_10</outgoing>
    </intermediateCatchEvent>
    <endEvent id="EndEvent_1" name="Repair Finished and Computer Returned to Customer">
      <incoming>SequenceFlow_3</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_4-1" sourceRef="ExclusiveGateway_1" targetRef="ParallelGateway_1"/>
    <sequenceFlow id="SequenceFlow_8" sourceRef="IntermediateCatchEvent_1" targetRef="Task_4"/>
    <sequenceFlow id="SequenceFlow_9" sourceRef="Task_4" targetRef="ParallelGateway_2"/>
    <parallelGateway id="ParallelGateway_2">
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_10</outgoing>
    </parallelGateway>
    <sequenceFlow id="SequenceFlow_10" sourceRef="ParallelGateway_2" targetRef="EndEvent_1"/>
    <endEvent id="EndEvent_2" name="Computer Unrepaired Returned to Customer">
      <incoming>SequenceFlow_4</incoming>
    </endEvent>
  </process>
</definitions>