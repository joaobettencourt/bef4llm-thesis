<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">
  <process id="Process_1" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>
    <task id="Task_1" name="Receive Customer Data">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="Task_2"/>
    <task id="Task_2" name="Enter Customer Data into CRM">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_3" sourceRef="Task_2" targetRef="ExclusiveGateway_1"/>
    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_4</outgoing>
      <outgoing>SequenceFlow_5</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_1" targetRef="Task_3">
      <conditionExpression xsi:type="tFormalExpression">${customerExists}</conditionExpression>
    </sequenceFlow>
    <task id="Task_3" name="Prepare Contract Documents">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_5" sourceRef="ExclusiveGateway_1" targetRef="Task_4"/>
    <task id="Task_4" name="Create New Customer Object">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_6" sourceRef="Task_3" targetRef="CISContract"/>
    <serviceTask id="CISContract" name="Automated Check in CIS">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_7</outgoing>
      <outgoing>SequenceFlow_8</outgoing>
    </serviceTask>
    <sequenceFlow id="SequenceFlow_7" sourceRef="CISContract" targetRef="Task_5">
      <conditionExpression xsi:type="tFormalExpression">${cisResponse}</conditionExpression>
    </sequenceFlow>
    <task id="Task_5" name="Analyze and Resolve Issues">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_9</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_8" sourceRef="CISContract" targetRef="Task_6"/>
    <task id="Task_6" name="Send Confirmation Document to Customer">
      <incoming>SequenceFlow_8</incoming>
      <outgoing>SequenceFlow_10</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_9" sourceRef="Task_5" targetRef="CISContract"/>
    <sequenceFlow id="SequenceFlow_10" sourceRef="Task_6" targetRef="GridOperatorRequest"/>
    <serviceTask id="GridOperatorRequest" name="Send Request to Grid Operator">
      <incoming>SequenceFlow_10</incoming>
      <outgoing>SequenceFlow_11</outgoing>
    </serviceTask>
    <sequenceFlow id="SequenceFlow_11" sourceRef="GridOperatorRequest" targetRef="ExclusiveGateway_2"/>
    <exclusiveGateway id="ExclusiveGateway_2">
      <incoming>SequenceFlow_11</incoming>
      <outgoing>SequenceFlow_12</outgoing>
      <outgoing>SequenceFlow_13</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_12" sourceRef="ExclusiveGateway_2" targetRef="Task_7">
      <conditionExpression xsi:type="tFormalExpression">${gridOperatorResponse}</conditionExpression>
    </sequenceFlow>
    <task id="Task_7" name="Customer Service Creates CIS Contract">
      <incoming>SequenceFlow_12</incoming>
      <outgoing>SequenceFlow_14</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_13" sourceRef="ExclusiveGateway_2" targetRef="EndEvent_1"/>
    <endEvent id="EndEvent_1">
      <incoming>SequenceFlow_13</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_14" sourceRef="Task_7" targetRef="CustomerConfirmation"/>
    <userTask id="CustomerConfirmation" name="Customer Confirmation">
      <incoming>SequenceFlow_14</incoming>
      <outgoing>SequenceFlow_15</outgoing>
      <outgoing>SequenceFlow_16</outgoing>
    </userTask>
    <sequenceFlow id="SequenceFlow_15" sourceRef="CustomerConfirmation" targetRef="EndEvent_2">
      <conditionExpression xsi:type="tFormalExpression">${customerRejects}</conditionExpression>
    </sequenceFlow>
    <endEvent id="EndEvent_2">
      <incoming>SequenceFlow_15</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_16" sourceRef="CustomerConfirmation" targetRef="Task_8">
      <conditionExpression xsi:type="tFormalExpression">${customerConfirms}</conditionExpression>
    </sequenceFlow>
    <task id="Task_8" name="Switch-Over on Scheduled Date">
      <incoming>SequenceFlow_16</incoming>
      <outgoing>SequenceFlow_17</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_17" sourceRef="Task_8" targetRef="EndEvent_3"/>
    <endEvent id="EndEvent_3">
      <incoming>SequenceFlow_17</incoming>
    </endEvent>
  </process>
</definitions>