<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">
  <process id="Process_1" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>
    <task id="Task_1" name="Customer perceives service degradation and sends problem parameters to TELECO">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="Task_2"/>
    <task id="Task_2" name="Employee in Customer Service department enters problem report into system T">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_3" sourceRef="Task_2" targetRef="Task_3"/>
    <task id="Task_3" name="Compare problem report to customer SLA">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_4</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_4" sourceRef="Task_3" targetRef="ExclusiveGateway_1"/>
    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_5</outgoing>
      <outgoing>SequenceFlow_6</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_5" sourceRef="ExclusiveGateway_1" targetRef="Task_4">
      <conditionExpression xsi:type="tFormalExpression">${isPremiumCustomer}</conditionExpression>
    </sequenceFlow>
    <task id="Task_4" name="Link to extra problem fix process for premium customers">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_6" sourceRef="ExclusiveGateway_1" targetRef="Task_5"/>
    <task id="Task_5" name="Determine significance of customer and re-prioritize counter measures if necessary">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_7" sourceRef="Task_4" targetRef="ExclusiveGateway_2"/>
    <exclusiveGateway id="ExclusiveGateway_2">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_9</outgoing>
      <outgoing>SequenceFlow_10</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_8" sourceRef="Task_5" targetRef="ExclusiveGateway_2"/>
    <sequenceFlow id="SequenceFlow_9" sourceRef="ExclusiveGateway_2" targetRef="Task_6">
      <conditionExpression xsi:type="tFormalExpression">${requiresRePrioritization}</conditionExpression>
    </sequenceFlow>
    <task id="Task_6" name="Create detailed problem report and send to Service Management">
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_11</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_10" sourceRef="ExclusiveGateway_2" targetRef="Task_6"/>
    <sequenceFlow id="SequenceFlow_11" sourceRef="Task_6" targetRef="Task_7"/>
    <task id="Task_7" name="Service Management investigates and creates trouble report or normal execution notification">
      <incoming>SequenceFlow_11</incoming>
      <outgoing>SequenceFlow_12</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_12" sourceRef="Task_7" targetRef="ExclusiveGateway_3"/>
    <exclusiveGateway id="ExclusiveGateway_3">
      <incoming>SequenceFlow_12</incoming>
      <outgoing>SequenceFlow_13</outgoing>
      <outgoing>SequenceFlow_14</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_13" sourceRef="ExclusiveGateway_3" targetRef="Task_8">
      <conditionExpression xsi:type="tFormalExpression">${problemAnalyzable}</conditionExpression>
    </sequenceFlow>
    <task id="Task_8" name="Service Management performs analysis and creates trouble report">
      <incoming>SequenceFlow_13</incoming>
      <outgoing>SequenceFlow_15</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_14" sourceRef="ExclusiveGateway_3" targetRef="Task_9"/>
    <task id="Task_9" name="Resource Provisioning checks for possible problems and creates trouble report or normal execution notification">
      <incoming>SequenceFlow_14</incoming>
      <outgoing>SequenceFlow_16</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_15" sourceRef="Task_8" targetRef="Task_10"/>
    <task id="Task_10" name="Send status report back to Service Management">
      <incoming>SequenceFlow_15</incoming>
      <outgoing>SequenceFlow_17</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_16" sourceRef="Task_9" targetRef="Task_10"/>
    <sequenceFlow id="SequenceFlow_17" sourceRef="Task_10" targetRef="ExclusiveGateway_4"/>
    <exclusiveGateway id="ExclusiveGateway_4">
      <incoming>SequenceFlow_17</incoming>
      <outgoing>SequenceFlow_18</outgoing>
      <outgoing>SequenceFlow_19</outgoing>
      <outgoing>SequenceFlow_20</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_18" sourceRef="ExclusiveGateway_4" targetRef="Task_11">
      <conditionExpression xsi:type="tFormalExpression">${noCorrectiveActions}</conditionExpression>
    </sequenceFlow>
    <task id="Task_11" name="Service Management prepares final status report and sends back to Customer Service">
      <incoming>SequenceFlow_18</incoming>
      <outgoing>SequenceFlow_21</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_19" sourceRef="ExclusiveGateway_4" targetRef="Task_12">
      <conditionExpression xsi:type="tFormalExpression">${minorCorrectiveActions}</conditionExpression>
    </sequenceFlow>
    <task id="Task_12" name="Service Management undertakes corrective actions and sends problem resolution report to Customer Service">
      <incoming>SequenceFlow_19</incoming>
      <outgoing>SequenceFlow_21</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_20" sourceRef="ExclusiveGateway_4" targetRef="Task_13">
      <conditionExpression xsi:type="tFormalExpression">${automaticResourceRestoration}</conditionExpression>
    </sequenceFlow>
    <task id="Task_13" name="Service Management creates request for automatic resource restoration and sends to Resource Provisioning">
      <incoming>SequenceFlow_20</incoming>
      <outgoing>SequenceFlow_22</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_21" sourceRef="Task_11" targetRef="EndEvent_1"/>
    <endEvent id="EndEvent_1">
      <incoming>SequenceFlow_21</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_22" sourceRef="Task_13" targetRef="Task_14"/>
    <task id="Task_14" name="Resource Provisioning performs corrective actions and creates trouble-shooting report">
      <incoming>SequenceFlow_22</incoming>
      <outgoing>SequenceFlow_23</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_23" sourceRef="Task_14" targetRef="EndEvent_2"/>
    <endEvent id="EndEvent_2">
      <incoming>SequenceFlow_23</incoming>
    </endEvent>
  </process>
</definitions>