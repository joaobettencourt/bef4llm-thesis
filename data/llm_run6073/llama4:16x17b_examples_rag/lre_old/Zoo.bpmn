<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">
  <process id="Process_1" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="ExclusiveGateway_1"/>
    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
      <outgoing>SequenceFlow_3</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_2" sourceRef="ExclusiveGateway_1" targetRef="Task_1">
      <conditionExpression xsi:type="tFormalExpression">${membershipType == 'individual'}</conditionExpression>
    </sequenceFlow>
    <task id="Task_1" name="Prepare Personal Information">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_4</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_4" sourceRef="Task_1" targetRef="Task_5"/>
    <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_1" targetRef="Task_2">
      <conditionExpression xsi:type="tFormalExpression">${membershipType == 'family'}</conditionExpression>
    </sequenceFlow>
    <task id="Task_2" name="Prepare Family Information">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_5</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_5" sourceRef="Task_2" targetRef="Task_5"/>
    <task id="Task_5" name="Submit Information to ZooClub">
      <incoming>SequenceFlow_4</incoming>
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_6" sourceRef="Task_5" targetRef="Task_6"/>
    <task id="Task_6" name="Introduce Data into System and Send Payment Request">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_7</outgoing>
      <outgoing>SequenceFlow_8</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_7" sourceRef="Task_6" targetRef="Task_7"/>
    <task id="Task_7" name="Send Payment Request to Billing">
      <incoming>SequenceFlow_7</incoming>
    </task>
    <sequenceFlow id="SequenceFlow_8" sourceRef="Task_6" targetRef="Task_10"/>
    <task id="Task_10" name="Forward Information to Marketing">
      <incoming>SequenceFlow_8</incoming>
    </task>
    <task id="Task_11" name="Process Payment">
      <incoming>SequenceFlow_9</incoming>
    </task>
    <sequenceFlow id="SequenceFlow_9" sourceRef="Task_7" targetRef="Task_11"/>
    <task id="Task_12" name="Confirm Payment and Print Card">
      <incoming>SequenceFlow_10</incoming>
      <outgoing>SequenceFlow_11</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_10" sourceRef="Task_11" targetRef="Task_12"/>
    <sequenceFlow id="SequenceFlow_11" sourceRef="Task_12" targetRef="EndEvent_1">
      <conditionExpression xsi:type="tFormalExpression">${paymentConfirmed == true}</conditionExpression>
    </sequenceFlow>
    <endEvent id="EndEvent_1">
      <incoming>SequenceFlow_11</incoming>
    </endEvent>
  </process>
</definitions>