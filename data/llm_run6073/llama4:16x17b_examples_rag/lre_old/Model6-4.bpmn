<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd" 
             id="definitions" targetNamespace="http://bpmn.io/schema/bpmn">
   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>
     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="ExclusiveGateway_1"/>
     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_4</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_2" sourceRef="ExclusiveGateway_1" targetRef="Task_1">
     </sequenceFlow>
     <task id="Task_1" name="Buy contact details">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_1" targetRef="Task_2">
     </sequenceFlow>
     <task id="Task_2" name="Participate in exhibition">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_5_2</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_1" targetRef="Task_3">
     </sequenceFlow>
     <task id="Task_3" name="Personal connection">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_5_3</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_1" targetRef="Task_4"/>
     <sequenceFlow id="SequenceFlow_5_2" sourceRef="Task_2" targetRef="Task_4"/>
     <sequenceFlow id="SequenceFlow_5_3" sourceRef="Task_3" targetRef="Task_4"/>
     <task id="Task_4" name="Call potential customer">
       <incoming>SequenceFlow_5</incoming>
       <incoming>SequenceFlow_5_2</incoming>
       <incoming>SequenceFlow_5_3</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_4" targetRef="ExclusiveGateway_2"/>
     <exclusiveGateway id="ExclusiveGateway_2">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_7</outgoing>
       <outgoing>SequenceFlow_8</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_7" sourceRef="ExclusiveGateway_2" targetRef="Task_5">
     </sequenceFlow>
     <task id="Task_5" name="Online presentation">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_8" sourceRef="ExclusiveGateway_2" targetRef="EndEvent_1"/>
     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_8</incoming>
     </endEvent>
     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_5" targetRef="IntermediateCatchEvent_1"/>
     <intermediateCatchEvent id="IntermediateCatchEvent_1">
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_10</outgoing>
       <timerEventDefinition/>
     </intermediateCatchEvent>
     <sequenceFlow id="SequenceFlow_10" sourceRef="IntermediateCatchEvent_1" targetRef="Task_6"/>
     <task id="Task_6" name="Follow- up call">
       <incoming>SequenceFlow_10</incoming>
       <outgoing>SequenceFlow_11</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_11" sourceRef="Task_6" targetRef="Task_7"/>
     <task id="Task_7" name="Create quotation">
       <incoming>SequenceFlow_11</incoming>
       <outgoing>SequenceFlow_12</outgoing>
     </task>
     <endEvent id="EndEvent_2">
       <incoming>SequenceFlow_12</incoming>
     </endEvent>
     <sequenceFlow id="SequenceFlow_12" sourceRef="Task_7" targetRef="EndEvent_2"/>
   </process>
</definitions>