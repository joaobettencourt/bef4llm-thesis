<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">
  <process id="Claims_Notification_Process" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>
    <task id="Task_1" name="Check if claimant is insured">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
      <outgoing>SequenceFlow_3</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="EndEvent_2">
      <conditionExpression xsi:type="tFormalExpression">${not insured}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="SequenceFlow_3" sourceRef="Task_1" targetRef="ExclusiveGateway_1">
      <conditionExpression xsi:type="tFormalExpression">${insured}</conditionExpression>
    </sequenceFlow>
    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_4</outgoing>
      <outgoing>SequenceFlow_5</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_1" targetRef="Task_2">
      <conditionExpression xsi:type="tFormalExpression">${claim.severity == 'simple'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="SequenceFlow_5" sourceRef="ExclusiveGateway_1" targetRef="Task_3">
      <conditionExpression xsi:type="tFormalExpression">${claim.severity == 'complex'}</conditionExpression>
    </sequenceFlow>
    <task id="Task_2" name="Send simple claim form">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </task>
    <task id="Task_3" name="Send complex claim form">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_6" sourceRef="Task_2" targetRef="Task_4"/>
    <sequenceFlow id="SequenceFlow_7" sourceRef="Task_3" targetRef="Task_5"/>
    <task id="Task_4" name="Check simple claim form completeness">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_8</outgoing>
      <outgoing>SequenceFlow_9</outgoing>
    </task>
    <task id="Task_5" name="Check complex claim form completeness">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_10</outgoing>
      <outgoing>SequenceFlow_11</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_8" sourceRef="Task_4" targetRef="Task_6">
      <conditionExpression xsi:type="tFormalExpression">${form.complete}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="SequenceFlow_9" sourceRef="Task_4" targetRef="Task_2">
      <conditionExpression xsi:type="tFormalExpression">${not form.complete}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="SequenceFlow_10" sourceRef="Task_5" targetRef="Task_6">
      <conditionExpression xsi:type="tFormalExpression">${form.complete}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="SequenceFlow_11" sourceRef="Task_5" targetRef="Task_3">
      <conditionExpression xsi:type="tFormalExpression">${not form.complete}</conditionExpression>
    </sequenceFlow>
    <task id="Task_6" name="Register claim in Claims Management system">
      <incoming>SequenceFlow_8</incoming>
      <incoming>SequenceFlow_10</incoming>
      <outgoing>SequenceFlow_12</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_12" sourceRef="Task_6" targetRef="EndEvent_1"/>
    <endEvent id="EndEvent_1">
      <incoming>SequenceFlow_12</incoming>
    </endEvent>
    <endEvent id="EndEvent_2">
      <incoming>SequenceFlow_2</incoming>
    </endEvent>
  </process>
</definitions>