<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">
  <process id="Process_1" isExecutable="true">
    <laneSet>
      <lane id="Lane_1" name="Mail Processing Unit">
        <flowNodeRef>StartEvent_1</flowNodeRef>
        <flowNodeRef>Task_1</flowNodeRef>
        <flowNodeRef>SequenceFlow_1</flowNodeRef>
      </lane>
      <lane id="Lane_2" name="Registry">
        <flowNodeRef>Task_3</flowNodeRef>
        <flowNodeRef>Task_4</flowNodeRef>
        <flowNodeRef>Task_5</flowNodeRef>
        <flowNodeRef>ExclusiveGateway_1</flowNodeRef>
      </lane>
      <lane id="Lane_3" name="Cashier">
        <flowNodeRef>Task_6</flowNodeRef>
      </lane>
    </laneSet>

    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>

    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>

    <task id="Task_1" name="Sort mail into business areas">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="Task_3"/>

    <task id="Task_3" name="Open and sort mail">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_3" sourceRef="Task_3" targetRef="ExclusiveGateway_1"/>

    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_4</outgoing>
      <outgoing>SequenceFlow_5</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_1" targetRef="Task_4">
      <conditionExpression xsi:type="tFormalExpression">${mailCompliant == true}</conditionExpression>
    </sequenceFlow>

    <task id="Task_4" name="Capture matter details and quality check">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_6" sourceRef="Task_4" targetRef="Task_5"/>

    <task id="Task_5" name="Compile list of requisition if not compliant">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_7" sourceRef="Task_5" targetRef="EndEvent_1"/>

    <endEvent id="EndEvent_1">
      <incoming>SequenceFlow_7</incoming>
    </endEvent>

    <sequenceFlow id="SequenceFlow_5" sourceRef="ExclusiveGateway_1" targetRef="Task_6"/>

    <task id="Task_6" name="Take applicable fees">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_8" sourceRef="Task_6" targetRef="EndEvent_2"/>

    <endEvent id="EndEvent_2">
      <incoming>SequenceFlow_8</incoming>
    </endEvent>
  </process>
</definitions>