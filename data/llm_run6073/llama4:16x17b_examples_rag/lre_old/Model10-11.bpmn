<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">
  <collaboration id="Collaboration_1">
    <participant id="Participant_0" name="GO" processRef="Pool_0"/>
    <participant id="Participant_1" name="MSP" processRef="Pool_1"/>
    <messageFlow id="MessageFlow_0" sourceRef="Task_2" targetRef="IntermediateCatchEvent_0"/>
    <messageFlow id="MessageFlow_1" sourceRef="Task_5" targetRef="IntermediateCatchEvent_1"/>
  </collaboration>
  <process id="Pool_0" isExecutable="true">
    <laneSet>
      <lane id="Lane_0" name="">
        <flowNodeRef>StartNoneEvent_0</flowNodeRef>
        <flowNodeRef>Task_0</flowNodeRef>
        <flowNodeRef>EndNoneEvent_0</flowNodeRef>
      </lane>
    </laneSet>
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartNoneEvent_0" targetRef="Task_0"/>
    <startEvent name="" id="StartNoneEvent_0">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <task name="Request measurements from MSP" id="Task_0">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_0" targetRef="IntermediateThrowEvent_0"/>
    <intermediateThrowEvent name="" id="IntermediateThrowEvent_0">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>MessageFlow_0</outgoing>
    </intermediateThrowEvent>
    <sequenceFlow id="SequenceFlow_8" sourceRef="Task_3" targetRef="EndNoneEvent_0"/>
    <endEvent name="" id="EndNoneEvent_0">
      <incoming>SequenceFlow_8</incoming>
    </endEvent>
  </process>
  <process id="Pool_1" isExecutable="true">
    <laneSet>
      <lane id="Lane_1" name="">
        <flowNodeRef>IntermediateCatchEvent_0</flowNodeRef>
        <flowNodeRef>Task_1</flowNodeRef>
        <flowNodeRef>ExclusiveGateway_0</flowNodeRef>
        <flowNodeRef>Task_2</flowNodeRef>
        <flowNodeRef>Task_3</flowNodeRef>
        <flowNodeRef>IntermediateThrowEvent_1</flowNodeRef>
      </lane>
    </laneSet>
    <sequenceFlow id="SequenceFlow_3" sourceRef="IntermediateCatchEvent_0" targetRef="Task_1"/>
    <intermediateCatchEvent name="" id="IntermediateCatchEvent_0">
      <incoming>MessageFlow_0</incoming>
      <outgoing>SequenceFlow_3</outgoing>
    </intermediateCatchEvent>
    <task name="Check request" id="Task_1">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_4</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_4" sourceRef="Task_1" targetRef="ExclusiveGateway_0"/>
    <exclusiveGateway name="" id="ExclusiveGateway_0">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_5</outgoing>
      <outgoing>SequenceFlow_6</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_5" sourceRef="ExclusiveGateway_0" targetRef="Task_2">
      <conditionExpression xsi:type="tFormalExpression">${requestValid == true}</conditionExpression>
    </sequenceFlow>
    <task name="Deny request" id="Task_2">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_6" sourceRef="ExclusiveGateway_0" targetRef="Task_2"/>
    <sequenceFlow id="SequenceFlow_7" sourceRef="Task_2" targetRef="IntermediateThrowEvent_1"/>
    <intermediateThrowEvent name="" id="IntermediateThrowEvent_1">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>MessageFlow_1</outgoing>
    </intermediateThrowEvent>
    <task name="Perform measurement" id="Task_3">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </task>
  </process>
</definitions>