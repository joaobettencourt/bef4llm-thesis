<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definitions" 
             targetNamespace="http://example.com/bpmn">

    <collaboration id="collaboration_1">
      <participant id="Participant_1" name="SSP" processRef="process_1"/>
      <participant id="Participant_2" name="Client"/>
      <participant id="Participant_3" name="Registry Office"/>
      <participant id="Participant_4" name="Accounts Receivable Department"/>
    </collaboration>

    <process id="process_1" isExecutable="true">
      <laneSet>
        <lane id="Lane_1" name="Payment Office">
          <flowNodeRef>Task_1</flowNodeRef>
          <flowNodeRef>StartEvent_1</flowNodeRef>
        </lane>
        <lane id="Lane_2" name="Registry Office">
          <flowNodeRef>Task_3</flowNodeRef>
        </lane>
        <lane id="Lane_3" name="Accounts Receivable Department">
          <flowNodeRef>Task_4</flowNodeRef>
          <flowNodeRef>Task_5</flowNodeRef>
        </lane>
      </laneSet>

      <startEvent id="StartEvent_1" name="End of Week">
        <outgoing>sequenceFlow_1</outgoing>
        <timerEventDefinition interval="P7D"/> 
      </startEvent>

      <task id="Task_GeneratePaymentReport" name="Generate Payment Report and Pay Vendor">
        <incoming>sequenceFlow_1</incoming>
        <outgoing>sequenceFlow_SendReportToClients</outgoing>
        <outgoing>sequenceFlow_SendReportToRegistryAndAccountsReceivable</outgoing>
      </task>

      <sequenceFlow id="sequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_GeneratePaymentReport"/>

      <task id="Task_SendReportToClients" name="Send Payment Report to Clients">
        <incoming>sequenceFlow_SendReportToClients</incoming>
      </task>

      <sequenceFlow id="sequenceFlow_SendReportToClients" sourceRef="Task_GeneratePaymentReport" targetRef="Task_SendReportToClients"/>

      <task id="Task_SendReportToRegistryAndAccountsReceivable" name="Send Payment Report to Registry and Accounts Receivable">
        <incoming>sequenceFlow_SendReportToRegistryAndAccountsReceivable</incoming>
      </task>

      <sequenceFlow id="sequenceFlow_SendReportToRegistryAndAccountsReceivable" sourceRef="Task_GeneratePaymentReport" targetRef="Task_SendReportToRegistryAndAccountsReceivable"/>

      <task id="Task_ArchiveInvoices" name="Archive Invoices per Vendor and Payment Data">
        <incoming>sequenceFlow_ArchiveInvoices</incoming>
      </task>

      <sequenceFlow id="sequenceFlow_ArchiveInvoices" sourceRef="Task_SendReportToRegistryAndAccountsReceivable" targetRef="Task_ArchiveInvoices"/>

      <task id="Task_GenerateMonthlyInvoice" name="Generate Monthly Invoice for Clients">
        <outgoing>sequenceFlow_GenerateMonthlyInvoice</outgoing>
      </task>

      <sequenceFlow id="sequenceFlow_GenerateMonthlyInvoice" sourceRef="Task_GenerateMonthlyInvoice" targetRef="Task_ChargeClients"/>

      <task id="Task_ChargeClients" name="Charge $35 per Invoice and Notify Client">
        <incoming>sequenceFlow_GenerateMonthlyInvoice</incoming>
      </task>

    </process>
  </definitions>