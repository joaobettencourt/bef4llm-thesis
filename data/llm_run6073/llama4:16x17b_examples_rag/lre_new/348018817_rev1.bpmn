<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definition" name="Expense Report Process">

   <process id="expenseReportProcess" isExecutable="true">
     <startEvent id="startEvent" name="Employee Files Expense Report">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent" targetRef="checkAccountExists"/>

     <exclusiveGateway id="checkAccountExists" name="Check if Employee has an Account">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
       <outgoing>sequenceFlow3</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow2" sourceRef="checkAccountExists" targetRef="reviewExpenseReport"/>

     <task id="createAccount" name="Create Account for Employee">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow4</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow3" sourceRef="checkAccountExists" targetRef="createAccount"/>
     <sequenceFlow id="sequenceFlow4" sourceRef="createAccount" targetRef="reviewExpenseReport"/>

     <task id="reviewExpenseReport" name="Review Expense Report">
       <incoming>sequenceFlow2</incoming>
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow5</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow5" sourceRef="reviewExpenseReport" targetRef="checkAmount"/>

     <exclusiveGateway id="checkAmount" name="Check if Amount Exceeds $200">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow6</outgoing>
       <outgoing>sequenceFlow7</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow6" sourceRef="checkAmount" targetRef="reimburseEmployee"/>

     <task id="reimburseEmployee" name="Reimburse Employee">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow8</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow8" sourceRef="reimburseEmployee" targetRef="endEvent1"/>

     <sequenceFlow id="sequenceFlow7" sourceRef="checkAmount" targetRef="requestSupervisorApproval"/>

     <task id="requestSupervisorApproval" name="Request Supervisor Approval">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow9</outgoing>
     </task>

     <intermediateCatchEvent id="approvalInProgress" name="Approval in Progress">
       <incoming>sequenceFlow10</incoming>
       <outgoing>sequenceFlow11</outgoing>
       <timerEventDefinition>
         <timeDuration>P7D</timeDuration>
       </timerEventDefinition>
     </intermediateCatchEvent>

     <sequenceFlow id="sequenceFlow9" sourceRef="requestSupervisorApproval" targetRef="supervisorApproves"/>

     <exclusiveGateway id="supervisorApproves" name="Is Supervisor Approval Given?">
       <incoming>sequenceFlow9</incoming>
       <outgoing>sequenceFlow10</outgoing>
       <outgoing>sequenceFlow12</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow10" sourceRef="supervisorApproves" targetRef="approvalInProgress"/>

     <task id="approveAndReimburse" name="Approve and Reimburse Employee">
       <incoming>sequenceFlow11</incoming>
       <outgoing>sequenceFlow13</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow11" sourceRef="approvalInProgress" targetRef="approveAndReimburse"/>

     <sequenceFlow id="sequenceFlow13" sourceRef="approveAndReimburse" targetRef="endEvent1"/>

     <sequenceFlow id="sequenceFlow12" sourceRef="supervisorApproves" targetRef="notifyEmployeeOfRejection"/>

     <task id="notifyEmployeeOfRejection" name="Notify Employee of Rejection">
       <incoming>sequenceFlow12</incoming>
       <outgoing>sequenceFlow14</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow14" sourceRef="notifyEmployeeOfRejection" targetRef="endEvent2"/>

     <intermediateCatchEvent id="resubmitAfter28Days" name="Resubmit After 28 Days">
       <incoming>sequenceFlow15</incoming>
       <outgoing>sequenceFlow16</outgoing>
       <timerEventDefinition>
         <timeDuration>P28D</timeDuration>
       </timerEventDefinition>
     </intermediateCatchEvent>

     <sequenceFlow id="sequenceFlow15" sourceRef="startEvent" targetRef="resubmitAfter28Days"/>

     <task id="sendResubmitEmail" name="Send Resubmit Email to Employee">
       <incoming>sequenceFlow16</incoming>
       <outgoing>sequenceFlow17</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow16" sourceRef="resubmitAfter28Days" targetRef="sendResubmitEmail"/>

     <endEvent id="endEvent1" name="Process Completed Successfully">
       <incoming>sequenceFlow8</incoming>
       <incoming>sequenceFlow13</incoming>
     </endEvent>

     <endEvent id="endEvent2" name="Employee Notified of Rejection">
       <incoming>sequenceFlow14</incoming>
     </endEvent>
   </process>
</definitions>