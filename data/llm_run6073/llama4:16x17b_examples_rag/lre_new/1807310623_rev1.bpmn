<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.4.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" name="Purchase Order- to-Delivery Process"
             targetNamespace="http://bpmn.io/schema/bpmn">

   <process id="purchaseOrderToDeliveryProcess" isExecutable="true">
     <laneSet>
       <lane id="financialDepartmentLane" name="Financial Department">
         <flowNodeRef>startEvent</flowNodeRef>
         <flowNodeRef>task_1</flowNodeRef>
       </lane>
       <lane id="departmentLane" name="Department">
         <flowNodeRef>task_2</flowNodeRef>
         <flowNodeRef>inclusiveGateway_1</flowNodeRef>
         <flowNodeRef>task_3_over500</flowNodeRef>
         <flowNodeRef>task_3_under500</flowNodeRef>
       </lane>
       <lane id="departmentHeadLane" name="Department Head">
         <flowNodeRef>task_4</flowNodeRef>
       </lane>
     </laneSet>

     <startEvent id="startEvent" name="Start Purchase Order- to-Delivery">
       <outgoing>sequenceFlow_1</outgoing>
     </startEvent>

     <task id="task_1" name="Check purchase invoice and send to department">
       <incoming>sequenceFlow_1</incoming>
       <outgoing>sequenceFlow_2</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow_1" sourceRef="startEvent" targetRef="task_1"/>
     <sequenceFlow id="sequenceFlow_2" sourceRef="task_1" targetRef="task_2"/>

     <task id="task_2" name="Check invoice for factual correctness and register in SAPERION">
       <incoming>sequenceFlow_2</incoming>
       <outgoing>sequenceFlow_3</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow_3" sourceRef="task_2" targetRef="inclusiveGateway_1"/>

     <inclusiveGateway id="inclusiveGateway_1">
       <incoming>sequenceFlow_3</incoming>
       <outgoing>sequenceFlow_4_over500</outgoing>
       <outgoing>sequenceFlow_5_under500</outgoing>
     </inclusiveGateway>

     <sequenceFlow id="sequenceFlow_4_over500" sourceRef="inclusiveGateway_1" targetRef="task_3_over500"/>
     <sequenceFlow id="sequenceFlow_5_under500" sourceRef="inclusiveGateway_1" targetRef="task_3_under500"/>

     <task id="task_3_over500" name="Send to department head for approval">
       <incoming>sequenceFlow_4_over500</incoming>
       <outgoing>sequenceFlow_6</outgoing>
     </task>

     <task id="task_3_under500" name="Trigger ERP system directly for payment under $500">
       <incoming>sequenceFlow_5_under500</incoming>
       <outgoing>sequenceFlow_7</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow_6" sourceRef="task_3_over500" targetRef="task_4"/>
     <sequenceFlow id="sequenceFlow_7" sourceRef="task_3_under500" targetRef="exclusiveGateway_2"/>

     <task id="task_4" name="Approve invoice using SAPERION workflow">
       <incoming>sequenceFlow_6</incoming>
       <outgoing>sequenceFlow_8</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow_8" sourceRef="task_4" targetRef="exclusiveGateway_2"/>

     <exclusiveGateway id="exclusiveGateway_2">
       <incoming>sequenceFlow_7</incoming>
       <incoming>sequenceFlow_8</incoming>
       <outgoing>sequenceFlow_9</outgoing>
     </exclusiveGateway>

     <task id="triggerERP" name="Trigger ERP system for payment">
       <incoming>sequenceFlow_9</incoming>
     </task>

     <sequenceFlow id="sequenceFlow_9" sourceRef="exclusiveGateway_2" targetRef="triggerERP"/>

     <endEvent id="endEvent" name="Purchase Order- to-Delivery Completed">
       <incoming>sequenceFlow_10</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow_10" sourceRef="triggerERP" targetRef="endEvent"/>
   </process>
</definitions>