<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/DD/20100524/DC/ http://www.omg.org/spec/DD/20100524/DI/"
             id="definitions" 
             targetNamespace="http://bpmn.io/schema/bpmn">

  <process id="orderToCashProcess" isExecutable="true">
    <startEvent id="receiveCustomerOrder" name="Receive Customer Order">
      <outgoing>sendToWarehouse</outgoing>
    </startEvent>

    <sequenceFlow id="sendToWarehouseSeq" sourceRef="receiveCustomerOrder" targetRef="sendToWarehouse"/>

    <serviceTask id="sendToWarehouse" name="Send to Warehouse">
      <incoming>sendToWarehouseSeq</incoming>
      <outgoing>determinePartsNeededSeq</outgoing>
    </serviceTask>

    <sequenceFlow id="determinePartsNeededSeq" sourceRef="sendToWarehouse" targetRef="determinePartsNeeded"/>

    <exclusiveGateway id="determinePartsNeeded" name="Determine Parts Needed">
      <incoming>determinePartsNeededSeq</incoming>
      <outgoing>startProductionSeq</outgoing>
      <outgoing>orderPartsSeq</outgoing>
    </exclusiveGateway>

    <task id="orderParts" name="Order Parts">
      <incoming>orderPartsSeq</incoming>
      <outgoing>startProductionSeq2</outgoing>
    </task>

    <sequenceFlow id="orderPartsSeq" sourceRef="determinePartsNeeded" targetRef="orderParts"/>

    <sequenceFlow id="startProductionSeq2" sourceRef="orderParts" targetRef="startProduction"/>

    <task id="startProduction" name="Start Production">
      <incoming>startProductionSeq</incoming>
      <incoming>startProductionSeq2</incoming>
      <outgoing>performQualityChecksSeq</outgoing>
    </task>

    <sequenceFlow id="startProductionSeq" sourceRef="determinePartsNeeded" targetRef="startProduction"/>

    <task id="performQualityChecks" name="Perform Quality Checks">
      <incoming>performQualityChecksSeq</incoming>
      <outgoing>packageAndLabelSeq</outgoing>
    </task>

    <sequenceFlow id="performQualityChecksSeq" sourceRef="startProduction" targetRef="performQualityChecks"/>

    <task id="packageAndLabel" name="Package and Label">
      <incoming>packageAndLabelSeq</incoming>
      <outgoing>informSalesSeq</outgoing>
    </task>

    <sequenceFlow id="packageAndLabelSeq" sourceRef="performQualityChecks" targetRef="packageAndLabel"/>

    <serviceTask id="informSales" name="Inform Sales">
      <incoming>informSalesSeq</incoming>
      <outgoing>orderCompletedSeq</outgoing>
    </serviceTask>

    <sequenceFlow id="informSalesSeq" sourceRef="packageAndLabel" targetRef="informSales"/>

    <endEvent id="orderCompleted" name="Order Completed">
      <incoming>orderCompletedSeq</incoming>
    </endEvent>

    <sequenceFlow id="orderCompletedSeq" sourceRef="informSales" targetRef="orderCompleted"/>
  </process>
</definitions>