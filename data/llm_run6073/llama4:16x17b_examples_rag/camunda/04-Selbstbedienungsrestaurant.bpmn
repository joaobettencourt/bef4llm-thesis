<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definition" name="Restaurant Process"
             targetNamespace="http://bpmn.io/schema/bpmn">

   <process id="restaurantProcess" isExecutable="true">
     <laneSet>
       <lane id="guestLane" name="Gast">
         <flowNodeRef>StartEvent_1</flowNodeRef>
         <flowNodeRef>Task_GetFood</flowNodeRef>
         <flowNodeRef>EndEvent_Finished</flowNodeRef>
       </lane>
       <lane id="staffLane" name="Angestellte( r )">
         <flowNodeRef>Task_TakeOrder</flowNodeRef>
         <flowNodeRef>Task_PayAndGetPieper</flowNodeRef>
         <flowNodeRef>Task_InformCook</flowNodeRef>
         <flowNodeRef>Task_CallGuest</flowNodeRef>
         <flowNodeRef>InclusiveGateway_CheckIfFoodReady</flowNodeRef>
       </lane>
       <lane id="cookLane" name="Koch">
         <flowNodeRef>Task_PrepareFood</flowNodeRef>
         <flowNodeRef>Task_InformStaffAboutFoodReady</flowNodeRef>
       </lane>
     </laneSet>

     <startEvent id="StartEvent_1" name="Gast betritt Restaurant">
       <outgoing>SequenceFlow_GuestArrives</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_GuestArrives" sourceRef="StartEvent_1" targetRef="Task_GetOrder"/>

     <task id="Task_GetOrder" name="Wählt Gericht aus und gibt Bestellung auf">
       <incoming>SequenceFlow_GuestArrives</incoming>
       <outgoing>SequenceFlow_OrderGiven</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_OrderGiven" sourceRef="Task_GetOrder" targetRef="Task_TakeOrder"/>

     <task id="Task_TakeOrder" name="Gibt Bestellung in Kassensystem ein und kassiert Geld">
       <incoming>SequenceFlow_OrderGiven</incoming>
       <outgoing>SequenceFlow_PaymentDone</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_PaymentDone" sourceRef="Task_TakeOrder" targetRef="Task_PayAndGetPieper"/>

     <task id="Task_PayAndGetPieper" name="Stellt Pieper ein und übergibt ihn an Gast">
       <incoming>SequenceFlow_PaymentDone</incoming>
       <outgoing>SequenceFlow_GuestGetsPieper</outgoing>
       <outgoing>SequenceFlow_InformCookAboutOrder</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_GuestGetsPieper" sourceRef="Task_PayAndGetPieper" targetRef="InclusiveGateway_CheckIfFoodReady"/>

     <sequenceFlow id="SequenceFlow_InformCookAboutOrder" sourceRef="Task_PayAndGetPieper" targetRef="Task_InformCook"/>

     <task id="Task_InformCook" name="Informiert Koch über Bestellung">
       <incoming>SequenceFlow_InformCookAboutOrder</incoming>
       <outgoing>SequenceFlow_CookNotified</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_CookNotified" sourceRef="Task_InformCook" targetRef="Task_PrepareFood"/>

     <task id="Task_PrepareFood" name="Bereitet Mahlzeit zu">
       <incoming>SequenceFlow_CookNotified</incoming>
       <outgoing>SequenceFlow_FoodPrepared</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_FoodPrepared" sourceRef="Task_PrepareFood" targetRef="Task_InformStaffAboutFoodReady"/>

     <task id="Task_InformStaffAboutFoodReady" name="Informiert Angestellten, dass Essen fertig ist">
       <incoming>SequenceFlow_FoodPrepared</incoming>
       <outgoing>SequenceFlow_StaffNotified</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_StaffNotified" sourceRef="Task_InformStaffAboutFoodReady" targetRef="InclusiveGateway_CheckIfFoodReady"/>

     <inclusiveGateway id="InclusiveGateway_CheckIfFoodReady">
       <incoming>SequenceFlow_GuestGetsPieper</incoming>
       <incoming>SequenceFlow_StaffNotified</incoming>
       <outgoing>SequenceFlow_FoodIsReady</outgoing>
       <outgoing>SequenceFlow_NoReaction</outgoing>
     </inclusiveGateway>

     <sequenceFlow id="SequenceFlow_FoodIsReady" sourceRef="InclusiveGateway_CheckIfFoodReady" targetRef="Task_GetFood"/>

     <task id="Task_GetFood" name="Holt Essen ab">
       <incoming>SequenceFlow_FoodIsReady</incoming>
       <outgoing>SequenceFlow_GuestGetsFood</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_GuestGetsFood" sourceRef="Task_GetFood" targetRef="EndEvent_Finished"/>

     <sequenceFlow id="SequenceFlow_NoReaction" sourceRef="InclusiveGateway_CheckIfFoodReady" targetRef="Task_CallGuest"/>

     <task id="Task_CallGuest" name="Ruft Gast nach 5 Minuten aus, wenn nötig">
       <incoming>SequenceFlow_NoReaction</incoming>
       <outgoing>SequenceFlow_GuestCalled</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_GuestCalled" sourceRef="Task_CallGuest" targetRef="InclusiveGateway_CheckIfFoodReady"/>

     <endEvent id="EndEvent_Finished" name="Essen verzehren">
       <incoming>SequenceFlow_GuestGetsFood</incoming>
     </endEvent>
   </process>
</definitions>