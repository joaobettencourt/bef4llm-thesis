<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com/bpmn">
    <collaboration id="collaboration">
        <participant id="guest" name="Guest"/>
        <participant id="employee" name="Employee" processRef="process"/>
    </collaboration>
    <process id="process" isExecutable="true">
        <laneSet>
            <lane id="logistics_lane" name="Logistics">
                <flowNodeRef>task_place_order</flowNodeRef>
                <flowNodeRef>task_pay_and_buzzer</flowNodeRef>
                <flowNodeRef>exclusive_gateway_call_guest</flowNodeRef>
                <flowNodeRef>end_event_meal_handovered</flowNodeRef>
            </lane>
            <lane id="chef_lane" name="Chef">
                <flowNodeRef>task_prepare_dish</flowNodeRef>
                <flowNodeRef>exclusive_gateway_inform_employee</flowNodeRef>
            </lane>
        </laneSet>

        <startEvent id="start_event_guest_enters" name="Guest enters restaurant feeling hungry.">
            <outgoing>sequence_flow_to_choose_dish</outgoing>
        </startEvent>

        <task id="task_choose_dish" name="Choose dish from changing meal range and wait until it is his turn.">
            <incoming>sequence_flow_to_choose_dish</incoming>
            <outgoing>sequence_flow_to_place_order</outgoing>
        </task>

        <sequenceFlow id="sequence_flow_to_choose_dish" sourceRef="start_event_guest_enters" targetRef="task_choose_dish"/>

        <userTask id="task_place_order" name="Place order with employee.">
            <incoming>sequence_flow_to_place_order</incoming>
            <outgoing>sequence_flow_to_pay_and_buzzer</outgoing>
        </userTask>

        <sequenceFlow id="sequence_flow_to_place_order" sourceRef="task_choose_dish" targetRef="task_place_order"/>

        <serviceTask id="task_pay_and_buzzer" name="Pay and receive buzzer from employee.">
            <incoming>sequence_flow_to_pay_and_buzzer</incoming>
            <outgoing>sequence_flow_to_inform_chef</outgoing>
        </serviceTask>

        <sequenceFlow id="sequence_flow_to_pay_and_buzzer" sourceRef="task_place_order" targetRef="task_pay_and_buzzer"/>

        <userTask id="task_prepare_dish" name="Prepare dish.">
            <incoming>sequence_flow_to_inform_chef</incoming>
            <outgoing>sequence_flow_to_finish_preparation</outgoing>
        </userTask>

        <sequenceFlow id="sequence_flow_to_inform_chef" sourceRef="task_pay_and_buzzer" targetRef="task_prepare_dish"/>

        <messageEvent id="exclusive_gateway_inform_employee" name="Inform employee about finished dish.">
            <incoming>sequence_flow_to_finish_preparation</incoming>
            <outgoing>sequence_flow_to_call_guest</outgoing>
        </messageEvent>

        <sequenceFlow id="sequence_flow_to_finish_preparation" sourceRef="task_prepare_dish" targetRef="exclusive_gateway_inform_employee"/>

        <userTask id="task_call_guest" name="Call guest if necessary.">
            <incoming>sequence_flow_to_call_guest</incoming>
            <outgoing>sequence_flow_to_handover_meal</outgoing>
        </userTask>

        <exclusiveGateway id="exclusive_gateway_call_guest">
            <incoming>sequence_flow_to_inform_employee</incoming>
            <outgoing>sequence_flow_to_wait_a_bit</outgoing>
            <outgoing>sequence_flow_to_call_guest_directly</outgoing>
        </exclusiveGateway>

        <sequenceFlow id="sequence_flow_to_call_guest" sourceRef="exclusive_gateway_call_guest" targetRef="task_call_guest"/>

        <sequenceFlow id="sequence_flow_to_wait_a_bit" name="Wait 5 minutes." sourceRef="exclusive_gateway_call_guest" targetRef="task_call_guest"/>

        <sequenceFlow id="sequence_flow_to_call_guest_directly" name="Call guest directly." sourceRef="exclusive_gateway_call_guest" targetRef="task_call_guest"/>

        <endEvent id="end_event_meal_handovered" name="Handover meal to guest.">
            <incoming>sequence_flow_to_handover_meal</incoming>
        </endEvent>

        <sequenceFlow id="sequence_flow_to_handover_meal" sourceRef="task_call_guest" targetRef="end_event_meal_handovered"/>
    </process>
</definitions>