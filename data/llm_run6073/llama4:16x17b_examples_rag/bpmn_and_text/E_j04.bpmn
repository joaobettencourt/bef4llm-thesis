<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/06-02-01.xsd"
             id="definition" name="Internship Process" targetNamespace="http://example.com">

   <process id="internshipProcess" isExecutable="true">
     <startEvent id="startEvent1">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <task id="taskEnterDetails" name="Enter Topic, Money, Experience and Hobbies">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="taskEnterDetails"/>

     <exclusiveGateway id="exclusiveGatewayOffers">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
       <outgoing>sequenceFlow4</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow2" sourceRef="taskEnterDetails" targetRef="exclusiveGatewayOffers"/>

     <exclusiveGateway id="exclusiveGateway1">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow5</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow3" name="yes" sourceRef="exclusiveGatewayOffers" targetRef="exclusiveGateway1"/>

     <task id="taskAcceptOffer" name="Accept Offer">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow6</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow5" sourceRef="exclusiveGateway1" targetRef="taskAcceptOffer"/>

     <task id="taskWriteStatusUpdates" name="Write Status Updates">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow7</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow6" sourceRef="taskAcceptOffer" targetRef="taskWriteStatusUpdates"/>

     <exclusiveGateway id="exclusiveGateway2">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow8</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow7" sourceRef="taskWriteStatusUpdates" targetRef="exclusiveGateway2"/>

     <endEvent id="endEventInternshipFinished" name="Internship Finished">
       <incoming>sequenceFlow8</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow8" sourceRef="exclusiveGateway2" targetRef="endEventInternshipFinished"/>

     <task id="taskRejectOffer" name="Reject Offer">
       <outgoing>sequenceFlow4</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow4" name="no" sourceRef="exclusiveGatewayOffers" targetRef="taskRejectOffer"/>

     <parallelGateway id="parallelGateway1">
       <incoming>sequenceFlow9</incoming>
       <outgoing>sequenceFlow10</outgoing>
       <outgoing>sequenceFlow11</outgoing>
     </parallelGateway>

     <sequenceFlow id="sequenceFlow9" sourceRef="endEventInternshipFinished" targetRef="parallelGateway1"/>

     <task id="taskSendTweet" name="Send Tweet">
       <incoming>sequenceFlow10</incoming>
     </task>

     <sequenceFlow id="sequenceFlow10" sourceRef="parallelGateway1" targetRef="taskSendTweet"/>

   </process>
</definitions>