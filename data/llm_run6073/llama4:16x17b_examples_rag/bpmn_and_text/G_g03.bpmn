<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/BPMN20.xsd"
             id="definition" name="Blizzard Online Character Generator" targetNamespace="http://example.com">

   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="ExclusiveGateway_1"/>

     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
       <outgoing>SequenceFlow_3</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_2" name="has battle.net account" sourceRef="ExclusiveGateway_1" targetRef="Task_1"/>

     <sequenceFlow id="SequenceFlow_3" name="no battle.net account" sourceRef="ExclusiveGateway_1" targetRef="Task_2"/>

     <userTask id="Task_1" name="Enter WoW character names">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_4</outgoing>
     </userTask>

     <sequenceFlow id="SequenceFlow_4" sourceRef="Task_1" targetRef="ParallelGateway_1"/>

     <userTask id="Task_2" name="Create battle.net account">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </userTask>

     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_2" targetRef="ExclusiveGateway_2"/>

     <exclusiveGateway id="ExclusiveGateway_2">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_6</outgoing>
       <outgoing>SequenceFlow_7</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_6" name="has active WoW subscription" sourceRef="ExclusiveGateway_2" targetRef="Task_3"/>

     <sequenceFlow id="SequenceFlow_7" name="no active WoW subscription" sourceRef="ExclusiveGateway_2" targetRef="Task_4"/>

     <userTask id="Task_3" name="Select payment method">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_8</outgoing>
     </userTask>

     <sequenceFlow id="SequenceFlow_8" sourceRef="Task_3" targetRef="ExclusiveGateway_3"/>

     <exclusiveGateway id="ExclusiveGateway_3">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_9</outgoing>
       <outgoing>SequenceFlow_10</outgoing>
       <outgoing>SequenceFlow_11</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_9" name="credit card" sourceRef="ExclusiveGateway_3" targetRef="Task_5"/>

     <sequenceFlow id="SequenceFlow_10" name="bank account" sourceRef="ExclusiveGateway_3" targetRef="Task_6"/>

     <sequenceFlow id="SequenceFlow_11" name="other payment methods" sourceRef="ExclusiveGateway_3" targetRef="EndEvent_1"/>

     <userTask id="Task_4" name="Select realm, race and class">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_12</outgoing>
     </userTask>

     <sequenceFlow id="SequenceFlow_12" sourceRef="Task_4" targetRef="EndEvent_1"/>

     <parallelGateway id="ParallelGateway_1">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_13</outgoing>
     </parallelGateway>

     <sequenceFlow id="SequenceFlow_13" sourceRef="ParallelGateway_1" targetRef="Task_7"/>

     <userTask id="Task_5" name="Enter credit card information">
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_14</outgoing>
     </userTask>

     <sequenceFlow id="SequenceFlow_14" sourceRef="Task_5" targetRef="EndEvent_1"/>

     <userTask id="Task_6" name="Enter IBAN and BIC numbers">
       <incoming>SequenceFlow_10</incoming>
       <outgoing>SequenceFlow_15</outgoing>
     </userTask>

     <sequenceFlow id="SequenceFlow_15" sourceRef="Task_6" targetRef="EndEvent_1"/>

     <userTask id="Task_7" name="Enter character names one by one">
       <incoming>SequenceFlow_13</incoming>
       <outgoing>SequenceFlow_16</outgoing>
     </userTask>

     <sequenceFlow id="SequenceFlow_16" sourceRef="Task_7" targetRef="EndEvent_1"/>

     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_11</incoming>
       <incoming>SequenceFlow_12</incoming>
       <incoming>SequenceFlow_14</incoming>
       <incoming>SequenceFlow_15</incoming>
       <incoming>SequenceFlow_16</incoming>
     </endEvent>

   </process>
</definitions>