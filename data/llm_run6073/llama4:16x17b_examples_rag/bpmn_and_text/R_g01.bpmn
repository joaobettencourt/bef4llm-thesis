<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/06-02-01.xsd" 
             id="definition" name="BPMN Process Model" targetNamespace="http://bpmn.io/schema/bpmn">
   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>
     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_EnterModelAndBrokenPart"/>
     <task id="Task_EnterModelAndBrokenPart" name="Enter model and what is broken">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_EnterModelAndBrokenPart" targetRef="Gateway_GetMaterialsTools"/>
     <exclusiveGateway id="Gateway_GetMaterialsTools">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_4</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_3" sourceRef="Gateway_GetMaterialsTools" targetRef="Task_FixPhone">
       <conditionExpression xsi:type="tFormalExpression">${hasAllNeededStuff}</conditionExpression>
     </sequenceFlow>
     <sequenceFlow id="SequenceFlow_4" sourceRef="Gateway_GetMaterialsTools" targetRef="Task_OrderOrBorrow"/>
     <task id="Task_FixPhone" name="Fix phone">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_FixPhone" targetRef="ExclusiveGateway_WorkedOrNot"/>
     <exclusiveGateway id="ExclusiveGateway_WorkedOrNot">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_6</outgoing>
       <outgoing>SequenceFlow_7</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_6" sourceRef="ExclusiveGateway_WorkedOrNot" targetRef="Task_SendReviewVideo">
       <conditionExpression xsi:type="tFormalExpression">${fixingSucceeded}</conditionExpression>
     </sequenceFlow>
     <sequenceFlow id="SequenceFlow_7" sourceRef="ExclusiveGateway_WorkedOrNot" targetRef="Task_SendToExpert">
       <conditionExpression xsi:type="tFormalExpression">${fixingFailed}</conditionExpression>
     </sequenceFlow>
     <task id="Task_SendReviewVideo" name="Send review and/or video of fixing it">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_8</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_8" sourceRef="Task_SendReviewVideo" targetRef="EndEvent_1"/>
     <task id="Task_SendToExpert" name="Send it to an expert">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_SendToExpert" targetRef="EndEvent_1"/>
     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_8</incoming>
       <incoming>SequenceFlow_9</incoming>
     </endEvent>
     <task id="Task_OrderOrBorrow" name="Order or borrow needed parts and tools">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_10</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_10" sourceRef="Task_OrderOrBorrow" targetRef="Task_FixPhone"/>
   </process>
 </definitions>