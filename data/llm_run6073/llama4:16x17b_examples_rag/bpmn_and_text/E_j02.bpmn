<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/BPMN20.xsd"
             id="definition" name="BPMN Process Model" targetNamespace="http://example.com">

   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_FetchInfo"/>

     <task id="Task_FetchInfo" name="Fetch Information About Potential Models">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_FetchInfo" targetRef="Task_SelectModel"/>

     <task id="Task_SelectModel" name="Let Parent Select Model">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_3" sourceRef="Task_SelectModel" targetRef="Task_CollectInfo"/>

     <task id="Task_CollectInfo" name="Collect Relevant Information">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_4</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_4" sourceRef="Task_CollectInfo" targetRef="Task_Notify"/>

     <task id="Task_Notify" name="Notify Social Security, Company">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_Notify" targetRef="Task_GatherInfoCompanies"/>

     <task id="Task_GatherInfoCompanies" name="Gather Information From Companies">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_GatherInfoCompanies" targetRef="ExclusiveGateway_1"/>

     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_7</outgoing>
       <outgoing>SequenceFlow_8</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_7" name="yes" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_Extension"/>

     <sequenceFlow id="SequenceFlow_8" name="no" sourceRef="ExclusiveGateway_1" targetRef="Task_DecideOnExtension"/>

     <task id="Task_DecideOnExtension" name="Let Parent Decide About Extension">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_DecideOnExtension" targetRef="EndEvent_1"/>

     <endEvent id="EndEvent_Extension">
       <incoming>SequenceFlow_7</incoming>
     </endEvent>

     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_9</incoming>
     </endEvent>
   </process>
</definitions>