<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Luxury Airplane Manufacturing Process" targetNamespace="http://example.com/bpmn">
   <process id="Process_1" isExecutable="true">
     <laneSet>
       <lane id="Lane_0" name="Sales Department">
         <flowNodeRef>StartEvent_1</flowNodeRef>
         <flowNodeRef>Task_1</flowNodeRef>
         <flowNodeRef>ExclusiveGateway_1</flowNodeRef>
       </lane>
       <lane id="Lane_1" name="Design and Planning">
         <flowNodeRef>Task_2</flowNodeRef>
         <flowNodeRef>ParallelGateway_1</flowNodeRef>
       </lane>
       <lane id="Lane_2" name="Manufacturing Teams">
         <flowNodeRef>Task_3</flowNodeRef>
         <flowNodeRef>Task_4</flowNodeRef>
         <flowNodeRef>Task_5</flowNodeRef>
       </lane>
       <lane id="Lane_3" name="Assembly and Testing">
         <flowNodeRef>Task_6</flowNodeRef>
         <flowNodeRef>EndEvent_1</flowNodeRef>
       </lane>
     </laneSet>

     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>

     <task id="Task_1" name="Receive Customer Specifications">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="ExclusiveGateway_1"/>

     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_4</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_3" name="valid specifications" sourceRef="ExclusiveGateway_1" targetRef="Task_2">
       <conditionExpression xsi:type="tFormalExpression">${specificationsValid}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="SequenceFlow_4" name="invalid specifications" sourceRef="ExclusiveGateway_1" targetRef="Task_1"/>

     <task id="Task_2" name="Create Design and Plan">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_2" targetRef="ParallelGateway_1"/>

     <parallelGateway id="ParallelGateway_1">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_6</outgoing>
       <outgoing>SequenceFlow_7</outgoing>
     </parallelGateway>

     <sequenceFlow id="SequenceFlow_6" sourceRef="ParallelGateway_1" targetRef="Task_3"/>

     <task id="Task_3" name="Manufacture Vodka Bar">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_8</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_8" sourceRef="Task_3" targetRef="Task_6"/>

     <sequenceFlow id="SequenceFlow_7" sourceRef="ParallelGateway_1" targetRef="Task_4"/>

     <task id="Task_4" name="Manufacture Whiskey Bar">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_4" targetRef="Task_6"/>

     <task id="Task_5" name="Manufacture Custom Seats">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_10</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_10" sourceRef="Task_5" targetRef="Task_6"/>

     <task id="Task_6" name="Assemble Interior">
       <incoming>SequenceFlow_8</incoming>
       <incoming>SequenceFlow_9</incoming>
       <incoming>SequenceFlow_10</incoming>
       <outgoing>SequenceFlow_11</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_11" sourceRef="Task_6" targetRef="EndEvent_1"/>

     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_11</incoming>
     </endEvent>
   </process>
</definitions>