<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="OEE Process Model">
   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>
     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_CollectInfo"/>
     <task id="Task_CollectInfo" name="Collect machine information">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_CollectInfo" targetRef="Task_CalculateOEE"/>
     <task id="Task_CalculateOEE" name="Calculate OEE">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_3" sourceRef="Task_CalculateOEE" targetRef="ExclusiveGateway_1">
       <conditionExpression xsi:type="tFormalExpression">${oeeValue &lt; threshold}</conditionExpression>
     </sequenceFlow>
     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_4</outgoing>
       <outgoing>SequenceFlow_9</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_4" name="yes" sourceRef="ExclusiveGateway_1" targetRef="Task_StopMachine"/>
     <task id="Task_StopMachine" name="Stop machine and send email to engineer">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_StopMachine" targetRef="IntermediateEvent_1"/>
     <intermediateEvent id="IntermediateEvent_1">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </intermediateEvent>
     <sequenceFlow id="SequenceFlow_6" sourceRef="IntermediateEvent_1" targetRef="Task_RestartMachine"/>
     <task id="Task_RestartMachine" name="Restart machine">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_7</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_7" sourceRef="Task_RestartMachine" targetRef="EndEvent_1"/>
     <sequenceFlow id="SequenceFlow_9" name="no" sourceRef="ExclusiveGateway_1" targetRef="IntermediateCatchEvent_1"/>
     <intermediateCatchEvent id="IntermediateCatchEvent_1">
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_8</outgoing>
       <!-- Add a message event definition here if needed -->
     </intermediateCatchEvent>
     <sequenceFlow id="SequenceFlow_8" sourceRef="IntermediateCatchEvent_1" targetRef="EndEvent_1"/>
     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_7</incoming>
       <incoming>SequenceFlow_8</incoming>
     </endEvent>
   </process>
</definitions>