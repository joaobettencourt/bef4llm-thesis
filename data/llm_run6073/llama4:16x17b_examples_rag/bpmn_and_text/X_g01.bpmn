<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/BPMN20.xsd"
             id="definition" name="New Application for Registering for an USI course" targetNamespace="http://example.com/bpmn">
  <process id="Process_1" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>

    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_SelectCourse"/>

    <task id="Task_SelectCourse" name="Select a course and check for free slots">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_SelectCourse" targetRef="ExclusiveGateway_HasAccount"/>

    <exclusiveGateway id="ExclusiveGateway_HasAccount">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
      <outgoing>SequenceFlow_4</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow_3" name="yes" sourceRef="ExclusiveGateway_HasAccount" targetRef="Task_Login">
      <conditionExpression xsi:type="tFormalExpression">${hasAccount}</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="SequenceFlow_4" name="no" sourceRef="ExclusiveGateway_HasAccount" targetRef="Task_CheckEligibility"/>

    <task id="Task_CheckEligibility">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_5</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_5" sourceRef="Task_CheckEligibility" targetRef="ExclusiveGateway_IsRegistered"/>

    <exclusiveGateway id="ExclusiveGateway_IsRegistered">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_6</outgoing>
      <outgoing>SequenceFlow_7</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow_6" name="yes" sourceRef="ExclusiveGateway_IsRegistered" targetRef="Task_RegisterAccount">
      <conditionExpression xsi:type="tFormalExpression">${isRegistered}</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="SequenceFlow_7" name="no" sourceRef="ExclusiveGateway_IsRegistered" targetRef="Task_RequestActivation"/>

    <task id="Task_RegisterAccount">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_8" sourceRef="Task_RegisterAccount" targetRef="Task_Login"/>

    <task id="Task_RequestActivation">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_9</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_9" sourceRef="Task_RequestActivation" targetRef="EndEvent_WaitForResponse"/>

    <endEvent id="EndEvent_WaitForResponse">
      <incoming>SequenceFlow_9</incoming>
    </endEvent>

    <task id="Task_Login">
      <incoming>SequenceFlow_3</incoming>
      <incoming>SequenceFlow_8</incoming>
      <outgoing>SequenceFlow_10</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_10" sourceRef="Task_Login" targetRef="Task_TweetToFriends"/>

    <task id="Task_TweetToFriends">
      <incoming>SequenceFlow_10</incoming>
      <outgoing>SequenceFlow_11</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_11" sourceRef="Task_TweetToFriends" targetRef="Task_CompleteRegistration"/>

    <task id="Task_CompleteRegistration">
      <incoming>SequenceFlow_11</incoming>
      <outgoing>SequenceFlow_12</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_12" sourceRef="Task_CompleteRegistration" targetRef="EndEvent_CourseTicket"/>

    <endEvent id="EndEvent_CourseTicket">
      <incoming>SequenceFlow_12</incoming>
    </endEvent>
  </process>
</definitions>