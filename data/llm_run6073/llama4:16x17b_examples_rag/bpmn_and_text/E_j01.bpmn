<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/BPMN20.xsd"
             id="definition" name="BPMN Process Model">
  <process id="Process_1" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_ReportApplications"/>
    <task id="Task_ReportApplications" name="Regularly report job applications">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_ReportApplications" targetRef="ServiceTask_NewJobOffers"/>
    <serviceTask id="ServiceTask_NewJobOffers">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
    </serviceTask>
    <sequenceFlow id="SequenceFlow_3" sourceRef="ServiceTask_NewJobOffers" targetRef="ExclusiveGateway_1"/>
    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_4</outgoing>
      <outgoing>SequenceFlow_5</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_1" targetRef="Task_ApplicationConfirmation">
      <conditionExpression xsi:type="tFormalExpression">${applicationConfirmed}</conditionExpression>
    </sequenceFlow>
    <task id="Task_ApplicationConfirmation" name="Company confirms application receipt and rates it">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_6" sourceRef="Task_ApplicationConfirmation" targetRef="Gateway_NegotiateInterview"/>
    <gateway id="Gateway_NegotiateInterview">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_7</outgoing>
      <outgoing>SequenceFlow_8</outgoing>
    </gateway>
    <sequenceFlow id="SequenceFlow_7" sourceRef="Gateway_NegotiateInterview" targetRef="Task_ProbationPhase">
      <conditionExpression xsi:type="tFormalExpression">${interviewScheduled}</conditionExpression>
    </sequenceFlow>
    <task id="Task_ProbationPhase" name="Enter probation phase">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_9</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_9" sourceRef="Task_ProbationPhase" targetRef="Gateway_RateCompany"/>
    <gateway id="Gateway_RateCompany">
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_10</outgoing>
      <outgoing>SequenceFlow_11</outgoing>
    </gateway>
    <sequenceFlow id="SequenceFlow_10" sourceRef="Gateway_RateCompany" targetRef="EndEvent_Temporary">
      <conditionExpression xsi:type="tFormalExpression">${companyRated >= 4}</conditionExpression>
    </sequenceFlow>
    <endEvent id="EndEvent_Temporary">
      <incoming>SequenceFlow_10</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_11" sourceRef="Gateway_RateCompany" targetRef="Task_ContinueReceivingOffers">
      <conditionExpression xsi:type="tFormalExpression">${companyRated <= 3}</conditionExpression>
    </sequenceFlow>
    <task id="Task_ContinueReceivingOffers" name="Continue receiving job offers without reporting">
      <incoming>SequenceFlow_11</incoming>
      <outgoing>SequenceFlow_12</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_12" sourceRef="Task_ContinueReceivingOffers" targetRef="EndEvent_Final"/>
    <endEvent id="EndEvent_Final">
      <incoming>SequenceFlow_5</incoming>
      <incoming>SequenceFlow_12</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_5" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_Final">
      <conditionExpression xsi:type="tFormalExpression">${not (companyRated <= 3)}</conditionExpression>
    </sequenceFlow>
  </process>
</definitions>