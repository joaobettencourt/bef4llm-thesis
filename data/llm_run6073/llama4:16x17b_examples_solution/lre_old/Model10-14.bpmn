<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">

  <process id="billExaminationProcess" isExecutable="true">
    <startEvent id="startEvent">
      <outgoing>sequenceFlow1</outgoing>
    </startEvent>

    <sequenceFlow id="sequenceFlow1" sourceRef="startEvent" targetRef="exclusiveGateway1"/>

    <exclusiveGateway id="exclusiveGateway1">
      <incoming>sequenceFlow1</incoming>
      <outgoing>sequenceFlow2</outgoing>
      <outgoing>sequenceFlow3</outgoing>
      <outgoing>sequenceFlow4</outgoing>
      <outgoing>sequenceFlow5</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequenceFlow2" sourceRef="exclusiveGateway1" targetRef="taskExamineBill">
      <conditionExpression xsi:type="tFormalExpression">${billSender == 'MPOO'}</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="sequenceFlow3" sourceRef="exclusiveGateway1" targetRef="taskExamineBill">
      <conditionExpression xsi:type="tFormalExpression">${billSender == 'MSPO'}</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="sequenceFlow4" sourceRef="exclusiveGateway1" targetRef="taskConfirmOrRejectBillGO">
      <conditionExpression xsi:type="tFormalExpression">${billType == 'equipmentAcquisition' and billReceiver == 'MPON or GO'}</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="sequenceFlow5" sourceRef="exclusiveGateway1" targetRef="taskConfirmOrRejectBillMSPO">
      <conditionExpression xsi:type="tFormalExpression">${billType == 'additionalReadings' and billReceiver == 'GO'}</conditionExpression>
    </sequenceFlow>

    <task id="taskExamineBill" name="Examine Bill">
      <incoming>sequenceFlow2</incoming>
      <incoming>sequenceFlow3</incoming>
      <outgoing>sequenceFlow6</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow6" sourceRef="taskExamineBill" targetRef="exclusiveGateway2"/>

    <exclusiveGateway id="exclusiveGateway2">
      <incoming>sequenceFlow6</incoming>
      <outgoing>sequenceFlow7</outgoing>
      <outgoing>sequenceFlow8</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequenceFlow7" sourceRef="exclusiveGateway2" targetRef="taskConfirmBill">
      <conditionExpression xsi:type="tFormalExpression">${billStatus == 'confirmed'}</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="sequenceFlow8" sourceRef="exclusiveGateway2" targetRef="taskRejectBill">
      <conditionExpression xsi:type="tFormalExpression">${billStatus == 'rejected'}</conditionExpression>
    </sequenceFlow>

    <task id="taskConfirmOrRejectBillGO" name="Confirm or Reject Bill (GO)">
      <incoming>sequenceFlow4</incoming>
      <outgoing>sequenceFlow9</outgoing>
    </task>

    <task id="taskConfirmOrRejectBillMSPO" name="Confirm or Reject Bill (MSPO)">
      <incoming>sequenceFlow5</incoming>
      <outgoing>sequenceFlow10</outgoing>
    </task>

    <task id="taskConfirmBill" name="Confirm Bill">
      <incoming>sequenceFlow7</incoming>
    </task>

    <task id="taskRejectBill" name="Reject Bill">
      <incoming>sequenceFlow8</incoming>
    </task>

    <endEvent id="endEvent">
      <incoming>sequenceFlow9</incoming>
      <incoming>sequenceFlow10</incoming>
    </endEvent>
  </process>
</definitions>