<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">

  <process id="productionProcess" isExecutable="true">
    <startEvent id="startEvent">
      <outgoing>sequenceFlow1</outgoing>
    </startEvent>

    <sequenceFlow id="sequenceFlow1" sourceRef="startEvent" targetRef="task1"/>

    <task id="task1" name="Determine parts, amounts, and delivery date">
      <incoming>sequenceFlow1</incoming>
      <outgoing>sequenceFlow2</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow2" sourceRef="task1" targetRef="task2"/>

    <task id="task2" name="Transfer data to PPS">
      <incoming>sequenceFlow2</incoming>
      <outgoing>sequenceFlow3</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow3" sourceRef="task2" targetRef="exclusiveGateway1"/>

    <exclusiveGateway id="exclusiveGateway1">
      <incoming>sequenceFlow3</incoming>
      <outgoing>sequenceFlow4</outgoing>
      <outgoing>sequenceFlow5</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequenceFlow4" sourceRef="exclusiveGateway1" targetRef="task3">
      <conditionExpression xsi:type="tFormalExpression">${partsMissing == true}</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="sequenceFlow5" sourceRef="exclusiveGateway1" targetRef="intermediateThrowEvent1"/>

    <task id="task3" name="Procure parts">
      <incoming>sequenceFlow4</incoming>
      <outgoing>sequenceFlow6</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow6" sourceRef="task3" targetRef="intermediateThrowEvent1"/>

    <intermediateThrowEvent id="intermediateThrowEvent1">
      <incoming>sequenceFlow5</incoming>
      <incoming>sequenceFlow6</incoming>
      <outgoing>sequenceFlow7</outgoing>
    </intermediateThrowEvent>

    <sequenceFlow id="sequenceFlow7" sourceRef="intermediateThrowEvent1" targetRef="task4"/>

    <task id="task4" name="Produce order">
      <incoming>sequenceFlow7</incoming>
      <outgoing>sequenceFlow8</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow8" sourceRef="task4" targetRef="task5"/>

    <task id="task5" name="Review quality">
      <incoming>sequenceFlow8</incoming>
      <outgoing>sequenceFlow9</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow9" sourceRef="task5" targetRef="endEvent1"/>

    <endEvent id="endEvent1">
      <incoming>sequenceFlow9</incoming>
    </endEvent>
  </process>
</definitions>