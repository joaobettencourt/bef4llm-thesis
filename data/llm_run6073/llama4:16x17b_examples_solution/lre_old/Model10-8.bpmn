<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
                 id="definitions" targetNamespace="http://www.example.com">

  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_0" name="MSPO" processRef="Pool_0"/>
    <bpmn:participant id="Participant_1" name="GO" processRef="Pool_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Pool_0" isExecutable="false">
    <bpmn:startEvent id="StartNoneEvent_0">
      <bpmn:outgoing>SequenceFlow_0</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_0" name="Deregister at GO">
      <bpmn:incoming>SequenceFlow_0</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_0" sourceRef="StartNoneEvent_0" targetRef="Task_0"/>
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="Task_0" targetRef="IntermediateMessageEventThrowing_0"/>

    <bpmn:intermediateThrowEvent id="IntermediateMessageEventThrowing_0">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <bpmn:endEvent id="EndNoneEvent_0">
      <!-- No incoming/outgoing for end event -->
    </bpmn:endEvent>
  </bpmn:process>

  <bpmn:process id="Pool_1" isExecutable="false">
    <bpmn:startEvent id="StartMessageEvent_0">
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:exclusiveGateway id="ExclusiveGateway_0">
      <bpmn:incoming>SequenceFlow_10</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="StartMessageEvent_0" targetRef="ExclusiveGateway_0"/>

    <bpmn:task id="Task_1" name="Verify deregistration">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_0" targetRef="Task_1"/>

    <bpmn:endEvent id="EndNoneEvent_1">
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="Task_1" targetRef="EndNoneEvent_1"/>

    <bpmn:task id="Task_2" name="Reject deregistration">
      <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_11</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="ExclusiveGateway_0" targetRef="Task_2"/>

    <bpmn:endEvent id="EndNoneEvent_2">
      <bpmn:incoming>SequenceFlow_11</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow_11" sourceRef="Task_2" targetRef="EndNoneEvent_2"/>

    <bpmn:task id="Task_3" name="Preliminarily confirm deregistration">
      <bpmn:incoming>SequenceFlow_7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_8</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_7" sourceRef="Task_1" targetRef="Task_3"/>

    <bpmn:task id="Task_4" name="Assign GO as MSP">
      <bpmn:incoming>SequenceFlow_8</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_9</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_8" sourceRef="Task_3" targetRef="Task_4"/>

    <bpmn:task id="Task_5" name="Inform MSPO about end of assignment and beginning of GO's assignment">
      <bpmn:incoming>SequenceFlow_9</bpmn:incoming>
      <!-- No outgoing -->
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_9" sourceRef="Task_4" targetRef="Task_5"/>

    <bpmn:task id="Task_6" name="Inform MPO about GO's assignment">
      <!-- Incoming/Outgoing not specified -->
    </bpmn:task>

    <bpmn:task id="Task_7" name="Inform SP about GO's assignment">
      <!-- Incoming/Outgoing not specified -->
    </bpmn:task>
  </bpmn:process>
</bpmn:definitions>