<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">

  <process id="leadProcessing" isExecutable="true">
    <laneSet>
      <lane id="managerLane" name="Manager">
        <flowNodeRef>startEvent</flowNodeRef>
        <flowNodeRef>task1</flowNodeRef>
        <flowNodeRef>task2</flowNodeRef>
        <flowNodeRef>exclusiveGateway1</flowNodeRef>
        <flowNodeRef>task3</flowNodeRef>
        <flowNodeRef>endEvent1</flowNodeRef>
      </lane>
      <lane id="salesAssistantLane" name="Sales Assistant">
        <flowNodeRef>task4</flowNodeRef>
      </lane>
    </laneSet>

    <startEvent id="startEvent">
      <outgoing>sequenceFlow1</outgoing>
    </startEvent>

    <sequenceFlow id="sequenceFlow1" sourceRef="startEvent" targetRef="task1"/>

    <task id="task1" name="Check open leads">
      <incoming>sequenceFlow1</incoming>
      <outgoing>sequenceFlow2</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow2" sourceRef="task1" targetRef="task2"/>

    <task id="task2" name="Select top five leads">
      <incoming>sequenceFlow2</incoming>
      <outgoing>sequenceFlow3</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow3" sourceRef="task2" targetRef="task4"/>

    <task id="task4" name="Call contact person">
      <incoming>sequenceFlow3</incoming>
      <outgoing>sequenceFlow4</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow4" sourceRef="task4" targetRef="exclusiveGateway1"/>

    <exclusiveGateway id="exclusiveGateway1">
      <incoming>sequenceFlow4</incoming>
      <outgoing>sequenceFlow5</outgoing>
      <outgoing>sequenceFlow6</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequenceFlow5" sourceRef="exclusiveGateway1" targetRef="task3">
      <conditionExpression xsi:type="tFormalExpression">${isInterested == true}</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="sequenceFlow6" sourceRef="exclusiveGateway1" targetRef="task4"/>

    <task id="task3" name="Process lead">
      <incoming>sequenceFlow5</incoming>
      <outgoing>sequenceFlow7</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow7" sourceRef="task3" targetRef="endEvent1"/>

    <endEvent id="endEvent1">
      <incoming>sequenceFlow7</incoming>
    </endEvent>
  </process>
</definitions>