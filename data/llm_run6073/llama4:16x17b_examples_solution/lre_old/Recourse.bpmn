<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">

  <process id="subrogationProcess" isExecutable="true">
    <startEvent id="probableRecourseDetected">
      <outgoing>checkCase</outgoing>
      <messageEventDefinition/>
    </startEvent>

    <sequenceFlow id="checkCase" sourceRef="probableRecourseDetected" targetRef="checkCaseTask"/>

    <task id="checkCaseTask" name="Check Case">
      <incoming>checkCase</incoming>
      <outgoing>recoursePossible</outgoing>
    </task>

    <exclusiveGateway id="recoursePossible">
      <incoming>recoursePossible</incoming>
      <outgoing>sendRequestForPayment</outgoing>
      <outgoing>closeCaseNotPossible</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sendRequestForPayment" sourceRef="recoursePossible" targetRef="sendRequestForPaymentTask">
      <conditionExpression xsi:type="tFormalExpression">${recoursePossible == true}</conditionExpression>
    </sequenceFlow>

    <task id="sendRequestForPaymentTask" name="Send Request for Payment">
      <incoming>sendRequestForPayment</incoming>
      <outgoing>sendReminder</outgoing>
    </task>

    <sequenceFlow id="sendReminder" sourceRef="sendRequestForPaymentTask" targetRef="sendReminderTask"/>

    <task id="sendReminderTask" name="Send Reminder">
      <incoming>sendReminder</incoming>
      <outgoing>waitForResponse</outgoing>
    </task>

    <eventBasedGateway id="waitForResponse">
      <incoming>waitForResponse</incoming>
      <outgoing>disagreementLetterReceived</outgoing>
      <outgoing>moneyReceived</outgoing>
      <outgoing>deadlineReached</outgoing>
    </eventBasedGateway>

    <intermediateCatchEvent id="disagreementLetterReceived">
      <incoming>disagreementLetterReceived</incoming>
      <outgoing>checkReasoning</outgoing>
      <messageEventDefinition/>
    </intermediateCatchEvent>

    <sequenceFlow id="checkReasoning" sourceRef="disagreementLetterReceived" targetRef="checkReasoningTask"/>

    <task id="checkReasoningTask" name="Check Reasoning">
      <incoming>checkReasoning</incoming>
      <outgoing>closeCaseIfRight</outgoing>
    </task>

    <exclusiveGateway id="closeCaseIfRight">
      <incoming>closeCaseIfRight</incoming>
      <outgoing>closeCase</outgoing>
      <outgoing>forwardToCollectionAgency</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="closeCase" sourceRef="closeCaseIfRight" targetRef="closeCaseTask">
      <conditionExpression xsi:type="tFormalExpression">${reasoningOK == true}</conditionExpression>
    </sequenceFlow>

    <task id="closeCaseTask" name="Close Case">
      <incoming>closeCase</incoming>
      <outgoing>caseClosed</outgoing>
    </task>

    <endEvent id="caseClosed">
      <incoming>caseClosed</incoming>
    </endEvent>

    <sequenceFlow id="forwardToCollectionAgency" sourceRef="closeCaseIfRight" targetRef="forwardToCollectionAgencyTask"/>

    <task id="forwardToCollectionAgencyTask" name="Forward to Collection Agency">
      <incoming>forwardToCollectionAgency</incoming>
      <outgoing>caseForwarded</outgoing>
    </task>

    <endEvent id="caseForwarded">
      <incoming>caseForwarded</incoming>
    </endEvent>

    <intermediateCatchEvent id="moneyReceived">
      <incoming>moneyReceived</incoming>
      <outgoing>makeBooking</outgoing>
      <messageEventDefinition/>
    </intermediateCatchEvent>

    <sequenceFlow id="makeBooking" sourceRef="moneyReceived" targetRef="makeBookingTask"/>

    <task id="makeBookingTask" name="Make Booking">
      <incoming>makeBooking</incoming>
      <outgoing>closeCaseAfterPayment</outgoing>
    </task>

    <sequenceFlow id="closeCaseAfterPayment" sourceRef="makeBookingTask" targetRef="closeCaseTask"/>

    <intermediateCatchEvent id="deadlineReached">
      <incoming>deadlineReached</incoming>
      <outgoing>forwardToCollectionAgencyDeadline</outgoing>
      <timerEventDefinition/>
    </intermediateCatchEvent>

    <sequenceFlow id="forwardToCollectionAgencyDeadline" sourceRef="deadlineReached" targetRef="forwardToCollectionAgencyTask"/>

  </process>
</definitions>