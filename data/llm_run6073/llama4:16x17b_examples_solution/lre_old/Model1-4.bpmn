<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">

  <process id="goPublicProcess" isExecutable="true">
    <startEvent id="startEvent">
      <outgoing>sequenceFlow1</outgoing>
    </startEvent>

    <sequenceFlow id="sequenceFlow1" sourceRef="startEvent" targetRef="task1"/>

    <task id="task1" name="Select Underwriters">
      <incoming>sequenceFlow1</incoming>
      <outgoing>sequenceFlow2</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow2" sourceRef="task1" targetRef="parallelGateway1"/>

    <parallelGateway id="parallelGateway1">
      <incoming>sequenceFlow2</incoming>
      <outgoing>sequenceFlow3</outgoing>
      <outgoing>sequenceFlow4</outgoing>
    </parallelGateway>

    <sequenceFlow id="sequenceFlow3" sourceRef="parallelGateway1" targetRef="task2"/>
    <sequenceFlow id="sequenceFlow4" sourceRef="parallelGateway1" targetRef="task3"/>

    <task id="task2" name="Prepare Registration Statement">
      <incoming>sequenceFlow3</incoming>
      <outgoing>sequenceFlow5</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow5" sourceRef="task2" targetRef="exclusiveGateway1"/>

    <exclusiveGateway id="exclusiveGateway1">
      <incoming>sequenceFlow5</incoming>
      <outgoing>sequenceFlow6</outgoing>
      <outgoing>sequenceFlow7</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequenceFlow6" sourceRef="exclusiveGateway1" targetRef="task4">
      <conditionExpression xsi:type="tFormalExpression">${approved}</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="sequenceFlow7" sourceRef="exclusiveGateway1" targetRef="endEvent1"/>

    <task id="task3" name="Check Compliance with Laws">
      <incoming>sequenceFlow4</incoming>
      <outgoing>sequenceFlow8</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow8" sourceRef="task3" targetRef="parallelGateway2"/>

    <parallelGateway id="parallelGateway2">
      <incoming>sequenceFlow8</incoming>
      <outgoing>sequenceFlow9</outgoing>
    </parallelGateway>

    <sequenceFlow id="sequenceFlow9" sourceRef="parallelGateway2" targetRef="task5"/>

    <task id="task4" name="Firm Up Issue Price">
      <incoming>sequenceFlow6</incoming>
      <outgoing>sequenceFlow10</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow10" sourceRef="task4" targetRef="task6"/>

    <task id="task5" name="Arrange Road Show">
      <incoming>sequenceFlow9</incoming>
      <outgoing>sequenceFlow11</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow11" sourceRef="task5" targetRef="intermediateCatchEvent1"/>

    <intermediateCatchEvent id="intermediateCatchEvent1">
      <incoming>sequenceFlow11</incoming>
      <outgoing>sequenceFlow12</outgoing>
    </intermediateCatchEvent>

    <sequenceFlow id="sequenceFlow12" sourceRef="intermediateCatchEvent1" targetRef="task7"/>

    <task id="task6" name="Fix Issue Price">
      <incoming>sequenceFlow10</incoming>
      <outgoing>sequenceFlow13</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow13" sourceRef="task6" targetRef="task8"/>

    <task id="task7" name="Receive Clearance from SEC">
      <incoming>sequenceFlow12</incoming>
      <!-- No outgoing sequence flow, assuming it's an end event -->
    </task>

    <task id="task8" name="Enter into Firm Commitment to Buy Stock and Offer to Public">
      <incoming>sequenceFlow13</incoming>
      <outgoing>sequenceFlow14</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow14" sourceRef="task8" targetRef="endEvent1"/>

    <endEvent id="endEvent1">
      <incoming>sequenceFlow14</incoming>
    </endEvent>

  </process>
</definitions>