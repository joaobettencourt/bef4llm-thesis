<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">

  <process id="mailProcessing" isExecutable="true">
    <laneSet>
      <lane id="mailProcessingUnit" name="Mail Processing Unit">
        <flowNodeRef>startEvent</flowNodeRef>
        <flowNodeRef>task1</flowNodeRef>
        <flowNodeRef>task2</flowNodeRef>
      </lane>
      <lane id="registry" name="Registry">
        <flowNodeRef>task3</flowNodeRef>
        <flowNodeRef>task4</flowNodeRef>
        <flowNodeRef>exclusiveGateway1</flowNodeRef>
        <flowNodeRef>task5</flowNodeRef>
        <flowNodeRef>task6</flowNodeRef>
        <flowNodeRef>endEvent1</flowNodeRef>
      </lane>
      <lane id="cashier" name="Cashier">
        <flowNodeRef>exclusiveGateway2</flowNodeRef>
        <flowNodeRef>task7</flowNodeRef>
        <flowNodeRef>task8</flowNodeRef>
        <flowNodeRef>endEvent2</flowNodeRef>
      </lane>
    </laneSet>

    <startEvent id="startEvent">
      <outgoing>sequenceFlow1</outgoing>
      <timerEventDefinition/>
    </startEvent>

    <sequenceFlow id="sequenceFlow1" sourceRef="startEvent" targetRef="task1"/>

    <task id="task1" name="Collect mail">
      <incoming>sequenceFlow1</incoming>
      <outgoing>sequenceFlow2</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow2" sourceRef="task1" targetRef="task2"/>

    <task id="task2" name="Sort unopened mail">
      <incoming>sequenceFlow2</incoming>
      <outgoing>sequenceFlow3</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow3" sourceRef="task2" targetRef="task3"/>

    <task id="task3" name="Open and sort mail">
      <incoming>sequenceFlow3</incoming>
      <outgoing>sequenceFlow4</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow4" sourceRef="task3" targetRef="task4"/>

    <task id="task4" name="Register mail">
      <incoming>sequenceFlow4</incoming>
      <outgoing>sequenceFlow5</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow5" sourceRef="task4" targetRef="exclusiveGateway1"/>

    <exclusiveGateway id="exclusiveGateway1">
      <incoming>sequenceFlow5</incoming>
      <outgoing>sequenceFlow6</outgoing>
      <outgoing>sequenceFlow7</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequenceFlow6" sourceRef="exclusiveGateway1" targetRef="task5">
      <conditionExpression xsi:type="tFormalExpression">${mailCompliant == true}</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="sequenceFlow7" sourceRef="exclusiveGateway1" targetRef="task6">
      <conditionExpression xsi:type="tFormalExpression">${mailCompliant == false}</conditionExpression>
    </sequenceFlow>

    <task id="task5" name="Capture matter details">
      <incoming>sequenceFlow6</incoming>
      <outgoing>sequenceFlow8</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow8" sourceRef="task5" targetRef="task7"/>

    <task id="task6" name="Compile requisition list">
      <incoming>sequenceFlow7</incoming>
      <outgoing>sequenceFlow9</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow9" sourceRef="task6" targetRef="endEvent1"/>

    <task id="task7" name="Receipt fee payment">
      <incoming>sequenceFlow8</incoming>
      <outgoing>sequenceFlow10</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow10" sourceRef="task7" targetRef="exclusiveGateway2"/>

    <exclusiveGateway id="exclusiveGateway2">
      <incoming>sequenceFlow10</incoming>
      <outgoing>sequenceFlow11</outgoing>
      <outgoing>sequenceFlow12</outgoing>
    </exclusiveGateway>

    <task id="task8" name="Print physical file">
      <incoming>sequenceFlow11</incoming>
      <outgoing>sequenceFlow13</outgoing>
    </task>

    <endEvent id="endEvent2">
      <incoming>sequenceFlow13</incoming>
    </endEvent>

    <endEvent id="endEvent1" name="End of process">
      <incoming>sequenceFlow9</incoming>
    </endEvent>
  </process>
</definitions>