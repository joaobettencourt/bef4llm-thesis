<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">

  <process id="goPublicProcess" isExecutable="true">
    <startEvent id="startEvent">
      <outgoing>sequenceFlow1</outgoing>
    </startEvent>

    <sequenceFlow id="sequenceFlow1" sourceRef="startEvent" targetRef="task1"/>

    <task id="task1" name="Select Underwriters">
      <incoming>sequenceFlow1</incoming>
      <outgoing>sequenceFlow2</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow2" sourceRef="task1" targetRef="parallelGateway1"/>

    <parallelGateway id="parallelGateway1">
      <incoming>sequenceFlow2</incoming>
      <outgoing>sequenceFlow3</outgoing>
      <outgoing>sequenceFlow4</outgoing>
    </parallelGateway>

    <sequenceFlow id="sequenceFlow3" sourceRef="parallelGateway1" targetRef="task2"/>
    <sequenceFlow id="sequenceFlow4" sourceRef="parallelGateway1" targetRef="parallelGateway2"/>

    <task id="task2" name="Provide Procedural and Financial Advice">
      <incoming>sequenceFlow3</incoming>
      <outgoing>sequenceFlow5</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow5" sourceRef="task2" targetRef="exclusiveGateway1"/>

    <exclusiveGateway id="exclusiveGateway1">
      <incoming>sequenceFlow5</incoming>
      <outgoing>sequenceFlow6</outgoing>
      <outgoing>sequenceFlow7</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequenceFlow6" sourceRef="exclusiveGateway1" targetRef="task3">
      <conditionExpression xsi:type="tFormalExpression">${factsPresentedFairly}</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="sequenceFlow7" sourceRef="exclusiveGateway1" targetRef="endEvent1"/>

    <task id="task3" name="Prepare Registration Statement for Approval of SEC">
      <incoming>sequenceFlow6</incoming>
      <outgoing>sequenceFlow8</outgoing>
    </task>

    <parallelGateway id="parallelGateway2">
      <incoming>sequenceFlow4</incoming>
      <outgoing>sequenceFlow9</outgoing>
      <outgoing>sequenceFlow10</outgoing>
    </parallelGateway>

    <sequenceFlow id="sequenceFlow8" sourceRef="task3" targetRef="parallelGateway3"/>
    <sequenceFlow id="sequenceFlow9" sourceRef="parallelGateway2" targetRef="task4"/>
    <sequenceFlow id="sequenceFlow10" sourceRef="parallelGateway2" targetRef="task5"/>

    <task id="task4" name="Check Compliance with Laws">
      <incoming>sequenceFlow9</incoming>
      <outgoing>sequenceFlow11</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow11" sourceRef="task4" targetRef="parallelGateway3"/>

    <task id="task5" name="Talk to Potential Investors">
      <incoming>sequenceFlow10</incoming>
      <outgoing>sequenceFlow12</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow12" sourceRef="task5" targetRef="intermediateCatchEvent1"/>

    <parallelGateway id="parallelGateway3">
      <incoming>sequenceFlow8</incoming>
      <incoming>sequenceFlow11</incoming>
      <outgoing>sequenceFlow13</outgoing>
    </parallelGateway>

    <sequenceFlow id="sequenceFlow13" sourceRef="parallelGateway3" targetRef="intermediateCatchEvent1"/>

    <intermediateCatchEvent id="intermediateCatchEvent1">
      <incoming>sequenceFlow12</incoming>
      <incoming>sequenceFlow13</incoming>
      <outgoing>sequenceFlow14</outgoing>
      <messageEventDefinition/>
    </intermediateCatchEvent>

    <exclusiveGateway id="exclusiveGateway2">
      <incoming>sequenceFlow14</incoming>
      <outgoing>sequenceFlow15</outgoing>
      <outgoing>sequenceFlow16</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequenceFlow14" sourceRef="intermediateCatchEvent1" targetRef="exclusiveGateway2"/>

    <task id="task6" name="Fix Issue Price">
      <incoming>sequenceFlow15</incoming>
      <outgoing>sequenceFlow17</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow15" sourceRef="exclusiveGateway2" targetRef="task6"/>
    <sequenceFlow id="sequenceFlow16" sourceRef="exclusiveGateway2" targetRef="endEvent1"/>

    <task id="task7" name="Buy Stock">
      <incoming>sequenceFlow17</incoming>
      <outgoing>sequenceFlow18</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow17" sourceRef="task6" targetRef="task7"/>
    <sequenceFlow id="sequenceFlow18" sourceRef="task7" targetRef="task8"/>

    <task id="task8" name="Offer to Public">
      <incoming>sequenceFlow18</incoming>
      <outgoing>sequenceFlow19</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow19" sourceRef="task8" targetRef="endEvent2"/>
    <endEvent id="endEvent1">
      <incoming>sequenceFlow7</incoming>
    </endEvent>

    <endEvent id="endEvent2">
      <incoming>sequenceFlow19</incoming>
    </endEvent>
  </process>
</definitions>