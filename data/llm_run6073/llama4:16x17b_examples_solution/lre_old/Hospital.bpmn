<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd" 
             id="definitions" targetNamespace="http://www.example.com">

   <process id="examinationProcess" isExecutable="true">
     <startEvent id="startEvent1">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="task1"/>

     <task id="task1" name="Examine patient">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </task>

     <exclusiveGateway id="exclusiveGateway1">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
       <outgoing>sequenceFlow4</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow2" sourceRef="task1" targetRef="exclusiveGateway1"/>

     <sequenceFlow id="sequenceFlow3" name="Healthy" sourceRef="exclusiveGateway1" targetRef="task2">
       <!-- No condition expression for this example -->
     </sequenceFlow>

     <sequenceFlow id="sequenceFlow4" name="Not Healthy" sourceRef="exclusiveGateway1" targetRef="task3"/>

     <task id="task2" name="Release patient">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow5</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow5" sourceRef="task2" targetRef="endEvent1"/>

     <task id="task3" name="Order examination  & follow-up treatment">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow6</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow6" sourceRef="task3" targetRef="exclusiveGateway2"/>

     <exclusiveGateway id="exclusiveGateway2">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow7</outgoing>
       <outgoing>sequenceFlow8</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow7" name="Patient agrees" sourceRef="exclusiveGateway2" targetRef="task4"/>

     <sequenceFlow id="sequenceFlow8" name="Patient disagrees" sourceRef="exclusiveGateway2" targetRef="endEvent1"/>

     <task id="task4" name="Make appointment">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow9</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow9" sourceRef="task4" targetRef="task5"/>

     <!-- ward physician takes sample and sends it to lab  -->
     <task id="task5" name="Take sample">
       <incoming>sequenceFlow9</incoming>
       <outgoing>sequenceFlow10</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow10" sourceRef="task5" targetRef="exclusiveGateway3"/>

     <!-- lab physician validates the state of a sample  -->
     <exclusiveGateway id="exclusiveGateway3">
       <incoming>sequenceFlow10</incoming>
       <outgoing>sequenceFlow11</outgoing>
       <outgoing>sequenceFlow12</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow11" name="Sample ok" sourceRef="exclusiveGateway3" targetRef="task6"/>

     <sequenceFlow id="sequenceFlow12" name="New sample required" sourceRef="exclusiveGateway3" targetRef="endEvent1"/>

     <!-- medical technical assistant performs analysis  -->
     <task id="task6" name="Analyse sample">
       <incoming>sequenceFlow11</incoming>
       <outgoing>sequenceFlow13</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow13" sourceRef="task6" targetRef="task7"/>

     <!-- lab physician validates results  -->
     <task id="task7" name="Validate results">
       <incoming>sequenceFlow13</incoming>
       <outgoing>sequenceFlow14</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow14" sourceRef="task7" targetRef="task8"/>

     <!-- outpatient physician makes diagnosis  -->
     <task id="task8" name="Make diagnosis">
       <incoming>sequenceFlow14</incoming>
       <outgoing>sequenceFlow15</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow15" sourceRef="task8" targetRef="endEvent2"/>

     <endEvent id="endEvent1">
       <incoming>sequenceFlow5</incoming>
       <incoming>sequenceFlow8</incoming>
       <incoming>sequenceFlow12</incoming>
     </endEvent>

     <endEvent id="endEvent2">
       <incoming>sequenceFlow15</incoming>
     </endEvent>
   </process>
</definitions>