<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">

  <process id="masterDataChangeProcess" isExecutable="true">
    <startEvent id="ecInformsInq">
      <outgoing>sequenceFlow1</outgoing>
    </startEvent>

    <sequenceFlow id="sequenceFlow1" sourceRef="ecInformsInq" targetRef="inqNotifiesIp"/>

    <task id="inqNotifiesIp" name="INQ notifies IP of change">
      <incoming>sequenceFlow1</incoming>
      <outgoing>sequenceFlow2</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow2" sourceRef="inqNotifiesIp" targetRef="ipChecksMasterData"/>

    <task id="ipChecksMasterData" name="IP checks master data">
      <incoming>sequenceFlow2</incoming>
      <outgoing>sequenceFlow3</outgoing>
      <outgoing>sequenceFlow4</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow3" sourceRef="ipChecksMasterData" targetRef="ipConfirmsChanges">
      <conditionExpression xsi:type="tFormalExpression">${changeAllowed}</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="sequenceFlow4" sourceRef="ipChecksMasterData" targetRef="ipRejectsChanges">
      <conditionExpression xsi:type="tFormalExpression">${changeNotAllowed}</conditionExpression>
    </sequenceFlow>

    <task id="ipConfirmsChanges" name="IP confirms changes">
      <incoming>sequenceFlow3</incoming>
      <outgoing>sequenceFlow5</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow5" sourceRef="ipConfirmsChanges" targetRef="endEvent"/>

    <task id="ipRejectsChanges" name="IP rejects changes">
      <incoming>sequenceFlow4</incoming>
      <outgoing>sequenceFlow6</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow6" sourceRef="ipRejectsChanges" targetRef="endEvent"/>

    <endEvent id="endEvent">
      <incoming>sequenceFlow5</incoming>
      <incoming>sequenceFlow6</incoming>
    </endEvent>
  </process>
</definitions>