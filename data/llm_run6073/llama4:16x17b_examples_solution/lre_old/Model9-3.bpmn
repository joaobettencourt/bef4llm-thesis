<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">

  <process id="meetingScheduleProcess" isExecutable="true">
    <startEvent id="startEvent">
      <outgoing>sequenceFlow1</outgoing>
    </startEvent>

    <sequenceFlow id="sequenceFlow1" sourceRef="startEvent" targetRef="task1"/>

    <task id="task1" name="Draft a schedule of meetings for the next calendar year and add draft dates to all calendars">
      <incoming>sequenceFlow1</incoming>
      <outgoing>sequenceFlow2</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow2" sourceRef="task1" targetRef="task2"/>

    <task id="task2" name="Check the dates and suggest modifications">
      <incoming>sequenceFlow2</incoming>
      <outgoing>sequenceFlow3</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow3" sourceRef="task2" targetRef="task3"/>

    <task id="task3" name="Recheck all dates and look for potential conflicts">
      <incoming>sequenceFlow3</incoming>
      <outgoing>sequenceFlow4</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow4" sourceRef="task3" targetRef="intermediateThrowEvent1"/>

    <intermediateThrowEvent id="intermediateThrowEvent1">
      <incoming>sequenceFlow4</incoming>
      <outgoing>sequenceFlow5</outgoing>
    </intermediateThrowEvent>

    <sequenceFlow id="sequenceFlow5" sourceRef="intermediateThrowEvent1" targetRef="intermediateCatchEvent1"/>

    <intermediateCatchEvent id="intermediateCatchEvent1">
      <incoming>sequenceFlow5</incoming>
      <outgoing>sequenceFlow6</outgoing>
    </intermediateCatchEvent>

    <sequenceFlow id="sequenceFlow6" sourceRef="intermediateCatchEvent1" targetRef="task4"/>

    <task id="task4" name="Check diaries and advise of any conflicts">
      <incoming>sequenceFlow6</incoming>
      <outgoing>sequenceFlow7</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow7" sourceRef="task4" targetRef="endEvent"/>

    <endEvent id="endEvent">
      <incoming>sequenceFlow7</incoming>
    </endEvent>
  </process>
</definitions>