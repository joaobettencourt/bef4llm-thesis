<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">

   <collaboration id="collaboration">
     <participant id="MSPN" name="MSPN" processRef="MSPNProcess"/>
     <participant id="MSPO" name="MSPO" processRef="MSPOProcess"/>
     <messageFlow id="messageFlow1" sourceRef="intermediateThrowEvent" targetRef="startEvent2"/>
   </collaboration>

   <process id="MSPNProcess" isExecutable="true">
     <startEvent id="startEvent1">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <task id="dismissalTask" name="Send dismissal">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="dismissalTask"/>
     <sequenceFlow id="sequenceFlow2" sourceRef="dismissalTask" targetRef="intermediateThrowEvent"/>

     <intermediateThrowEvent id="intermediateThrowEvent">
       <incoming>sequenceFlow2</incoming>
       <outgoing>messageFlow1</outgoing>
     </intermediateThrowEvent>

     <endEvent id="endEvent1">
       <!-- No incoming or outgoing flows -->
     </endEvent>

   </process>

   <process id="MSPOProcess" isExecutable="true">
     <startEvent id="startEvent2">
       <incoming>messageFlow1</incoming>
       <outgoing>sequenceFlow3</outgoing>
     </startEvent>

     <task id="reviewTask" name="Review dismissal">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow4</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow3" sourceRef="startEvent2" targetRef="reviewTask"/>
     <sequenceFlow id="sequenceFlow4" sourceRef="reviewTask" targetRef="exclusiveGateway1"/>

     <exclusiveGateway id="exclusiveGateway1">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow5</outgoing>
       <outgoing>sequenceFlow6</outgoing>
     </exclusiveGateway>

     <task id="rejectTask" name="Reject dismissal">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow7</outgoing>
     </task>

     <task id="confirmTask" name="Confirm dismissal">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow8</outgoing>
     </task>

     <endEvent id="endEvent2">
       <incoming>sequenceFlow7</incoming>
     </endEvent>

     <endEvent id="endEvent3">
       <incoming>sequenceFlow8</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow5" sourceRef="exclusiveGateway1" targetRef="rejectTask"/>
     <sequenceFlow id="sequenceFlow6" sourceRef="exclusiveGateway1" targetRef="confirmTask"/>
     <sequenceFlow id="sequenceFlow7" sourceRef="rejectTask" targetRef="endEvent2"/>
     <sequenceFlow id="sequenceFlow8" sourceRef="confirmTask" targetRef="endEvent3"/>

   </process>

</definitions>