<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">

  <process id="changeProcess" isExecutable="true">
    <startEvent id="startEvent">
      <outgoing>sequenceFlow1</outgoing>
    </startEvent>

    <sequenceFlow id="sequenceFlow1" sourceRef="startEvent" targetRef="exclusiveGateway1"/>

    <exclusiveGateway id="exclusiveGateway1">
      <incoming>sequenceFlow1</incoming>
      <outgoing>sequenceFlow2</outgoing>
      <outgoing>sequenceFlow3</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequenceFlow2" sourceRef="exclusiveGateway1" targetRef="task1">
      <conditionExpression xsi:type="tFormalExpression">${changeRequested}</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="sequenceFlow3" sourceRef="exclusiveGateway1" targetRef="task4"/>

    <task id="task1" name="Review Change Request">
      <incoming>sequenceFlow2</incoming>
      <outgoing>sequenceFlow4</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow4" sourceRef="task1" targetRef="exclusiveGateway2"/>

    <exclusiveGateway id="exclusiveGateway2">
      <incoming>sequenceFlow4</incoming>
      <outgoing>sequenceFlow5</outgoing>
      <outgoing>sequenceFlow6</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequenceFlow5" sourceRef="exclusiveGateway2" targetRef="task2">
      <conditionExpression xsi:type="tFormalExpression">${requestConfirmed}</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="sequenceFlow6" sourceRef="exclusiveGateway2" targetRef="endEvent1"/>

    <task id="task2" name="Perform Measuring Point Change">
      <incoming>sequenceFlow5</incoming>
      <outgoing>sequenceFlow7</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow7" sourceRef="task2" targetRef="exclusiveGateway3"/>

    <exclusiveGateway id="exclusiveGateway3">
      <incoming>sequenceFlow7</incoming>
      <outgoing>sequenceFlow8</outgoing>
      <outgoing>sequenceFlow9</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequenceFlow8" sourceRef="exclusiveGateway3" targetRef="task3"/>

    <sequenceFlow id="sequenceFlow9" sourceRef="exclusiveGateway3" targetRef="task5"/>

    <task id="task3" name="Send Implementation Report">
      <incoming>sequenceFlow8</incoming>
      <outgoing>sequenceFlow10</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow10" sourceRef="task3" targetRef="endEvent2"/>

    <task id="task4" name="Cause Change by Itself">
      <incoming>sequenceFlow3</incoming>
      <outgoing>sequenceFlow11</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow11" sourceRef="task4" targetRef="task1"/>

    <task id="task5" name="Inform about Failure of Changes">
      <incoming>sequenceFlow9</incoming>
      <outgoing>sequenceFlow12</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow12" sourceRef="task5" targetRef="endEvent2"/>

    <endEvent id="endEvent1">
      <incoming>sequenceFlow6</incoming>
    </endEvent>

    <endEvent id="endEvent2">
      <incoming>sequenceFlow10</incoming>
      <incoming>sequenceFlow12</incoming>
    </endEvent>
  </process>
</definitions>