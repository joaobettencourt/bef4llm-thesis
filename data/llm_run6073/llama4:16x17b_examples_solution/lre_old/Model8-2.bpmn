<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">

  <process id="jobDescriptionProcess" isExecutable="true">
    <startEvent id="startEvent">
      <outgoing>sequenceFlow1</outgoing>
    </startEvent>

    <sequenceFlow id="sequenceFlow1" sourceRef="startEvent" targetRef="task1"/>

    <task id="task1" name="Create Job Description">
      <incoming>sequenceFlow1</incoming>
      <outgoing>sequenceFlow2</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow2" sourceRef="task1" targetRef="exclusiveGateway1"/>

    <exclusiveGateway id="exclusiveGateway1">
      <incoming>sequenceFlow2</incoming>
      <outgoing>sequenceFlow3</outgoing>
      <outgoing>sequenceFlow4</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequenceFlow3" sourceRef="exclusiveGateway1" targetRef="task3">
      <conditionExpression xsi:type="tFormalExpression">${clarificationNeeded}</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="sequenceFlow4" sourceRef="exclusiveGateway1" targetRef="eventBasedGateway1"/>

    <task id="task3" name="Request Clarification from Department">
      <incoming>sequenceFlow3</incoming>
      <outgoing>sequenceFlow5</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow5" sourceRef="task3" targetRef="task1"/>

    <eventBasedGateway id="eventBasedGateway1">
      <incoming>sequenceFlow4</incoming>
      <outgoing>sequenceFlow6</outgoing>
      <outgoing>sequenceFlow7</outgoing>
    </eventBasedGateway>

    <intermediateCatchEvent id="intermediateCatchEvent1" name="Job Description Rejected">
      <incoming>sequenceFlow6</incoming>
      <outgoing>sequenceFlow8</outgoing>
    </intermediateCatchEvent>

    <sequenceFlow id="sequenceFlow6" sourceRef="eventBasedGateway1" targetRef="intermediateCatchEvent1"/>

    <task id="task4" name="Correct Job Description">
      <incoming>sequenceFlow8</incoming>
      <outgoing>sequenceFlow9</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow9" sourceRef="task4" targetRef="eventBasedGateway1"/>

    <intermediateCatchEvent id="intermediateCatchEvent2" name="Job Description Approved">
      <incoming>sequenceFlow7</incoming>
      <outgoing>sequenceFlow10</outgoing>
    </intermediateCatchEvent>

    <sequenceFlow id="sequenceFlow7" sourceRef="eventBasedGateway1" targetRef="intermediateCatchEvent2"/>

    <task id="task5" name="Post Job">
      <incoming>sequenceFlow10</incoming>
      <outgoing>sequenceFlow11</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow10" sourceRef="intermediateCatchEvent2" targetRef="task5"/>

    <endEvent id="endEvent1">
      <incoming>sequenceFlow11</incoming>
    </endEvent>

    <sequenceFlow id="sequenceFlow11" sourceRef="task5" targetRef="endEvent1"/>
  </process>
</definitions>