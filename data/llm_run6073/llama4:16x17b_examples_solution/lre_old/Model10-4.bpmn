<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://bpmn.io/schema/bpmn">

   <collaboration id="collaboration">
     <participant id="MPON" name="MPON" processRef="MPON_process"/>
     <participant id="MPOO" name="MPOO" processRef="MPOO_process"/>
     <participant id="GO" name="GO" processRef="GO_process"/>
     <participant id="MSP" name="MSP" processRef="MSP_process"/>

     <messageFlow id="equipment_change_intention" sourceRef="Task_MPON_NotifyEquipmentChangeIntention" targetRef="StartEvent_MPOO"/>
     <messageFlow id="self_dismounting_announcement" sourceRef="ExclusiveGateway_MPOO" targetRef="IntermediateCatchEvent_MPON"/>
     <messageFlow id="no_self_dismounting_notification" sourceRef="ExclusiveGateway_MPOO" targetRef="Task_MPON_ConductFinalReading"/>

   </collaboration>

   <process id="MPON_process" isExecutable="true">
     <startEvent id="StartEvent_MPON">
       <outgoing>SequenceFlow_MPON_1</outgoing>
     </startEvent>

     <task id="Task_MPON_NotifyEquipmentChangeIntention" name="Notify about equipment change intentions">
       <incoming>SequenceFlow_MPON_1</incoming>
       <outgoing>equipment_change_intention</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_MPON_1" sourceRef="StartEvent_MPON" targetRef="Task_MPON_NotifyEquipmentChangeIntention"/>

     <intermediateCatchEvent id="IntermediateCatchEvent_MPON">
       <incoming>self_dismounting_announcement</incoming>
       <outgoing>SequenceFlow_MPON_2</outgoing>
     </intermediateCatchEvent>

     <sequenceFlow id="SequenceFlow_MPON_2" sourceRef="IntermediateCatchEvent_MPON" targetRef="Task_MPON_ConductFinalReading"/>

     <task id="Task_MPON_ConductFinalReading" name="Perform final reading">
       <incoming>SequenceFlow_MPON_2</incoming>
       <incoming>no_self_dismounting_notification</incoming>
       <outgoing>SequenceFlow_MPON_3</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_MPON_3" sourceRef="Task_MPON_ConductFinalReading" targetRef="Task_MPON_DismountOldEquipment"/>

     <task id="Task_MPON_DismountOldEquipment" name="Dismount old equipment">
       <incoming>SequenceFlow_MPON_3</incoming>
       <outgoing>SequenceFlow_MPON_4</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_MPON_4" sourceRef="Task_MPON_DismountOldEquipment" targetRef="Task_MPON_MountNewDevice"/>

     <task id="Task_MPON_MountNewDevice" name="Mount new device">
       <incoming>SequenceFlow_MPON_4</incoming>
       <outgoing>SequenceFlow_MPON_5</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_MPON_5" sourceRef="Task_MPON_MountNewDevice" targetRef="Task_MPON_ReadMeterCountAtInstallation"/>

     <task id="Task_MPON_ReadMeterCountAtInstallation" name="Read meter count at installation">
       <incoming>SequenceFlow_MPON_5</incoming>
       <outgoing>SequenceFlow_MPON_6</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_MPON_6" sourceRef="Task_MPON_ReadMeterCountAtInstallation" targetRef="Task_MPON_SendValuesOfFinalReadingToGO"/>

     <task id="Task_MPON_SendValuesOfFinalReadingToGO" name="Send values of final reading to GO">
       <incoming>SequenceFlow_MPON_6</incoming>
       <outgoing>SequenceFlow_MPON_7</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_MPON_7" sourceRef="Task_MPON_SendValuesOfFinalReadingToGO" targetRef="EndEvent_MPON"/>

     <endEvent id="EndEvent_MPON">
       <incoming>SequenceFlow_MPON_7</incoming>
     </endEvent>

   </process>

   <process id="MPOO_process" isExecutable="true">
     <startEvent id="StartEvent_MPOO">
       <incoming>equipment_change_intention</incoming>
       <outgoing>SequenceFlow_MPOO_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_MPOO_1" sourceRef="StartEvent_MPOO" targetRef="ExclusiveGateway_MPOO"/>

     <exclusiveGateway id="ExclusiveGateway_MPOO">
       <incoming>SequenceFlow_MPOO_1</incoming>
       <outgoing>self_dismounting_announcement</outgoing>
       <outgoing>no_self_dismounting_notification</outgoing>
     </exclusiveGateway>

   </process>

   <process id="GO_process" isExecutable="true">
     <startEvent id="StartEvent_GO">
       <outgoing>SequenceFlow_GO_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_GO_1" sourceRef="StartEvent_GO" targetRef="Task_GO_NotifyMSPAboutDeviceChanges"/>

     <task id="Task_GO_NotifyMSPAboutDeviceChanges" name="Notify MSP about device changes, master data, meter count at dismounting and installation">
       <incoming>SequenceFlow_GO_1</incoming>
       <outgoing>SequenceFlow_GO_2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_GO_2" sourceRef="Task_GO_NotifyMSPAboutDeviceChanges" targetRef="EndEvent_GO"/>

     <endEvent id="EndEvent_GO">
       <incoming>SequenceFlow_GO_2</incoming>
     </endEvent>

   </process>

   <process id="MSP_process" isExecutable="true">
     <startEvent id="StartEvent_MSP">

     </startEvent>

     <task id="Task_MSP_ReceiveNotification" name="Receive notification about device changes, master data, meter count at dismounting and installation">
       <incoming>SequenceFlow_MSP_1</incoming>
     </task>

   </process>

</definitions>