<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">

   <collaboration id="collaboration">
     <participant id="INQ" name="INQ" processRef="inqProcess"/>
     <participant id="IP" name="IP" processRef="ipProcess"/>
     <messageFlow id="messageFlow1" sourceRef="IntermediateMessageEventThrowing_0" targetRef="StartMessageEvent_1"/>
     <messageFlow id="messageFlow2" sourceRef="Task_Transmit_Data" targetRef="IntermediateMessageEventCatching_0"/>
     <messageFlow id="messageFlow3" sourceRef="Task_Reject" targetRef="IntermediateMessageEventCatching_0"/>
   </collaboration>

   <process id="inqProcess">
     <startEvent id="StartEvent_0">
       <outgoing>SequenceFlow_0</outgoing>
     </startEvent>

     <task id="Task_Request">
       <incoming>SequenceFlow_0</incoming>
       <outgoing>SequenceFlow_1</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_0" sourceRef="StartEvent_0" targetRef="Task_Request"/>
     <sequenceFlow id="SequenceFlow_1" sourceRef="Task_Request" targetRef="IntermediateMessageEventThrowing_0"/>

     <intermediateThrowEvent id="IntermediateMessageEventThrowing_0">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>messageFlow1</outgoing>
     </intermediateThrowEvent>

     <intermediateCatchEvent id="IntermediateMessageEventCatching_0">
       <incoming>messageFlow2</incoming>
       <incoming>messageFlow3</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </intermediateCatchEvent>

     <sequenceFlow id="SequenceFlow_2" sourceRef="IntermediateMessageEventCatching_0" targetRef="EndEvent_0"/>

     <endEvent id="EndEvent_0">
       <incoming>SequenceFlow_2</incoming>
     </endEvent>
   </process>

   <process id="ipProcess">
     <startEvent id="StartMessageEvent_1">
       <incoming>messageFlow1</incoming>
       <outgoing>SequenceFlow_3</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_3" sourceRef="StartMessageEvent_1" targetRef="Task_Check"/>

     <task id="Task_Check">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_4</outgoing>
       <outgoing>SequenceFlow_5</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_4" sourceRef="Task_Check" targetRef="Task_Transmit_Data"/>
     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_Check" targetRef="Task_Reject"/>

     <task id="Task_Transmit_Data">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>messageFlow2</outgoing>
     </task>

     <task id="Task_Reject">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>messageFlow3</outgoing>
     </task>
   </process>
</definitions>