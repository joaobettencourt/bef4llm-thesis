<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd" 
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="definitions" targetNamespace="http://www.example.com">

   <process id="expenseReportProcess" isExecutable="true">
     <startEvent id="startEvent">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent" targetRef="taskCreateAccountOrNot"/>

     <exclusiveGateway id="gatewayCreateAccountOrNot">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
       <outgoing>sequenceFlow3</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow2" sourceRef="gatewayCreateAccountOrNot" targetRef="taskAutoApproveAndReimburse">
       <conditionExpression xsi:type="tFormalExpression">${employeeHasAccount}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="sequenceFlow3" sourceRef="gatewayCreateAccountOrNot" targetRef="taskCreateAccount">
       <conditionExpression xsi:type="tFormalExpression">${not employeeHasAccount}</conditionExpression>
     </sequenceFlow>

     <task id="taskCreateAccount" name="Create account">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow4</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow4" sourceRef="taskCreateAccount" targetRef="gatewayAutoApproveOrNot"/>

     <exclusiveGateway id="gatewayAutoApproveOrNot">
       <incoming>sequenceFlow4</incoming>
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow5</outgoing>
       <outgoing>sequenceFlow6</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow5" sourceRef="gatewayAutoApproveOrNot" targetRef="taskAutoApproveAndReimburse">
       <conditionExpression xsi:type="tFormalExpression">${amount  <= 200}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="sequenceFlow6" sourceRef="gatewayAutoApproveOrNot" targetRef="taskSendForSupervisorApproval">
       <conditionExpression xsi:type="tFormalExpression">${amount  > 200}</conditionExpression>
     </sequenceFlow>

     <task id="taskAutoApproveAndReimburse" name="Auto approve and reimburse">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow7</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow7" sourceRef="taskAutoApproveAndReimburse" targetRef="endEvent1"/>

     <task id="taskSendForSupervisorApproval" name="Send for supervisor approval">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow8</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow8" sourceRef="taskSendForSupervisorApproval" targetRef="gatewayApproveOrNot"/>

     <exclusiveGateway id="gatewayApproveOrNot">
       <incoming>sequenceFlow8</incoming>
       <outgoing>sequenceFlow9</outgoing>
       <outgoing>sequenceFlow10</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow9" sourceRef="gatewayApproveOrNot" targetRef="taskReimburseEmployee">
       <conditionExpression xsi:type="tFormalExpression">${approved}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="sequenceFlow10" sourceRef="gatewayApproveOrNot" targetRef="taskSendRejectionEmail">
       <conditionExpression xsi:type="tFormalExpression">${not approved}</conditionExpression>
     </sequenceFlow>

     <task id="taskReimburseEmployee" name="Reimburse employee">
       <incoming>sequenceFlow9</incoming>
       <outgoing>sequenceFlow11</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow11" sourceRef="taskReimburseEmployee" targetRef="endEvent1"/>

     <task id="taskSendRejectionEmail" name="Send rejection email">
       <incoming>sequenceFlow10</incoming>
       <outgoing>sequenceFlow12</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow12" sourceRef="taskSendRejectionEmail" targetRef="endEvent1"/>

     <intermediateCatchEvent id="intermediateCatchEvent1">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow13</outgoing>
       <timerEventDefinition>
         <timeDuration>PT7D</timeDuration>
       </timerEventDefinition>
     </intermediateCatchEvent>

     <sequenceFlow id="sequenceFlow13" sourceRef="intermediateCatchEvent1" targetRef="taskSendApprovalInProgressEmail"/>

     <task id="taskSendApprovalInProgressEmail" name="Send approval in progress email">
       <incoming>sequenceFlow13</incoming>
       <outgoing>sequenceFlow14</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow14" sourceRef="taskSendApprovalInProgressEmail" targetRef="intermediateCatchEvent2"/>

     <intermediateCatchEvent id="intermediateCatchEvent2">
       <incoming>sequenceFlow14</incoming>
       <outgoing>sequenceFlow15</outgoing>
       <timerEventDefinition>
         <timeDuration>PT30D</timeDuration>
       </timerEventDefinition>
     </intermediateCatchEvent>

     <sequenceFlow id="sequenceFlow15" sourceRef="intermediateCatchEvent2" targetRef="taskSendCancellationEmail"/>

     <task id="taskSendCancellationEmail" name="Send cancellation email">
       <incoming>sequenceFlow15</incoming>
       <outgoing>sequenceFlow16</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow16" sourceRef="taskSendCancellationEmail" targetRef="endEvent1"/>

     <endEvent id="endEvent1">
       <incoming>sequenceFlow7</incoming>
       <incoming>sequenceFlow11</incoming>
       <incoming>sequenceFlow12</incoming>
       <incoming>sequenceFlow16</incoming>
     </endEvent>

   </process>
</definitions>