<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd" 
             id="definition" name="Building a custom machine out of Lego bricks" targetNamespace="http://example.com">

   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_DevelopBasicDesign"/>

     <userTask id="Task_DevelopBasicDesign" name="Develop basic design">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </userTask>

     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_DevelopBasicDesign" targetRef="Task_OrderLegoBrickSets"/>

     <userTask id="Task_OrderLegoBrickSets" name="Order Lego brick sets">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
     </userTask>

     <sequenceFlow id="SequenceFlow_3" sourceRef="Task_OrderLegoBrickSets" targetRef="Task_SortPartsIntoContainers"/>

     <userTask id="Task_SortPartsIntoContainers" name="Sort parts into containers">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_4</outgoing>
     </userTask>

     <sequenceFlow id="SequenceFlow_4" sourceRef="Task_SortPartsIntoContainers" targetRef="ExclusiveGateway_IsMorePartsNeeded"/>

     <exclusiveGateway id="ExclusiveGateway_IsMorePartsNeeded">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_5</outgoing>
       <outgoing>SequenceFlow_6</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_5" name="Yes" sourceRef="ExclusiveGateway_IsMorePartsNeeded" targetRef="Task_ReorderIndividualParts"/>

     <userTask id="Task_ReorderIndividualParts" name="Reorder individual parts">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_7</outgoing>
     </userTask>

     <sequenceFlow id="SequenceFlow_6" name="No" sourceRef="ExclusiveGateway_IsMorePartsNeeded" targetRef="ParallelGateway_StartBuildingSubcomponents"/>

     <sequenceFlow id="SequenceFlow_7" sourceRef="Task_ReorderIndividualParts" targetRef="Task_SortPartsIntoContainers"/>

     <parallelGateway id="ParallelGateway_StartBuildingSubcomponents">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_8</outgoing>
       <outgoing>SequenceFlow_9</outgoing>
     </parallelGateway>

     <sequenceFlow id="SequenceFlow_8" sourceRef="ParallelGateway_StartBuildingSubcomponents" targetRef="Task_BuildSubcomponent"/>

     <userTask id="Task_BuildSubcomponent" name="Build subcomponent">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_10</outgoing>
     </userTask>

     <sequenceFlow id="SequenceFlow_9" sourceRef="ParallelGateway_StartBuildingSubcomponents" targetRef="Task_TestSubcomponent"/>

     <userTask id="Task_TestSubcomponent" name="Test subcomponent">
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_11</outgoing>
     </userTask>

     <exclusiveGateway id="ExclusiveGateway_DidItPassTheTest">
       <incoming>SequenceFlow_11</incoming>
       <outgoing>SequenceFlow_12</outgoing>
       <outgoing>SequenceFlow_13</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_10" sourceRef="Task_BuildSubcomponent" targetRef="Task_TestSubcomponent"/>

     <sequenceFlow id="SequenceFlow_11" sourceRef="Task_TestSubcomponent" targetRef="ExclusiveGateway_DidItPassTheTest"/>

     <sequenceFlow id="SequenceFlow_12" name="Yes" sourceRef="ExclusiveGateway_DidItPassTheTest" targetRef="ParallelGateway_AssembleMachine"/>

     <userTask id="Task_RedesignSubcomponent" name="Redesign subcomponent">
       <incoming>SequenceFlow_13</incoming>
       <outgoing>SequenceFlow_14</outgoing>
     </userTask>

     <sequenceFlow id="SequenceFlow_13" name="No" sourceRef="ExclusiveGateway_DidItPassTheTest" targetRef="Task_RedesignSubcomponent"/>

     <sequenceFlow id="SequenceFlow_14" sourceRef="Task_RedesignSubcomponent" targetRef="Task_BuildSubcomponent"/>

     <parallelGateway id="ParallelGateway_AssembleMachine">
       <incoming>SequenceFlow_12</incoming>
       <outgoing>SequenceFlow_15</outgoing>
     </parallelGateway>

     <sequenceFlow id="SequenceFlow_15" sourceRef="ParallelGateway_AssembleMachine" targetRef="Task_AssembleMachine"/>

     <userTask id="Task_AssembleMachine" name="Assemble machine">
       <incoming>SequenceFlow_15</incoming>
       <outgoing>SequenceFlow_16</outgoing>
     </userTask>

     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_16</incoming>
     </endEvent>

     <sequenceFlow id="SequenceFlow_16" sourceRef="Task_AssembleMachine" targetRef="EndEvent_1"/>
   </process>
 </definitions>