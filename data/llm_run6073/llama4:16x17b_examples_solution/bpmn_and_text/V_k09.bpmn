<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/pecoff4py/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/pecoff4py/20100524/MODEL BPMN20.xsd"
             id="definition" name="Storage Management">

   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_ReadOrder"/>

     <serviceTask id="Task_ReadOrder" name="Read order">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </serviceTask>

     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_ReadOrder" targetRef="ExclusiveGateway_IsInStock"/>

     <exclusiveGateway id="ExclusiveGateway_IsInStock">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_4</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_3" name="yes" sourceRef="ExclusiveGateway_IsInStock" targetRef="Task_WithDrawProduct">
       <conditionExpression xsi:type="tFormalExpression">${productInStock  == true}</conditionExpression>
     </sequenceFlow>

     <manualTask id="Task_WithDrawProduct" name="Withdraw product from warehouse">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </manualTask>

     <sequenceFlow id="SequenceFlow_4" name="no" sourceRef="ExclusiveGateway_IsInStock" targetRef="Task_ReorderProduct">
       <conditionExpression xsi:type="tFormalExpression">${productInStock  == false}</conditionExpression>
     </sequenceFlow>

     <serviceTask id="Task_ReorderProduct" name="Reorder product from wholesaler">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </serviceTask>

     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_WithDrawProduct" targetRef="ExclusiveGateway_IsOrderReady"/>

     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_ReorderProduct" targetRef="ServiceTask_WaitingForProductArrival">
       <conditionExpression xsi:type="tFormalExpression">${waitingDays  > 10}</conditionExpression>
     </sequenceFlow>

     <serviceTask id="ServiceTask_WaitingForProductArrival" name="Waiting for product arrival (handling system)">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>ExclusiveGateway_IsArrivedAfterMoreThan10Days</outgoing>
     </serviceTask>

     <exclusiveGateway id="ExclusiveGateway_IsArrivedAfterMoreThan10Days">
       <incoming>ServiceTask_WaitingForProductArrival</incoming>
       <outgoing>SequenceFlow_7</outgoing>
       <outgoing>SequenceFlow_8</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_7" name="yes" sourceRef="ExclusiveGateway_IsArrivedAfterMoreThan10Days" targetRef="Task_DemandDeliveryDelayPenalty">
       <conditionExpression xsi:type="tFormalExpression">${waitingDays  > 10}</conditionExpression>
     </sequenceFlow>

     <serviceTask id="Task_DemandDeliveryDelayPenalty" name="Demand delivery delay penalty from the wholesaler">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </serviceTask>

     <sequenceFlow id="SequenceFlow_8" name="no" sourceRef="ExclusiveGateway_IsArrivedAfterMoreThan10Days" targetRef="Task_RegisterProductInStockManagement">
     </sequenceFlow>

     <manualTask id="Task_RegisterProductInStockManagement" name="Register product in stock management system">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_10</outgoing>
     </manualTask>

     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_DemandDeliveryDelayPenalty" targetRef="Task_RegisterProductInStockManagement"/>

     <sequenceFlow id="SequenceFlow_10" sourceRef="Task_RegisterProductInStockManagement" targetRef="ExclusiveGateway_IsOrderReady"/>

     <exclusiveGateway id="ExclusiveGateway_IsOrderReady">
       <incoming>SequenceFlow_5</incoming>
       <incoming>SequenceFlow_10</incoming>
       <outgoing>SequenceFlow_11</outgoing>
       <outgoing>SequenceFlow_12</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_11" name="yes" sourceRef="ExclusiveGateway_IsOrderReady" targetRef="ParallelGateway_RequestCourierAndPackProducts">
       <conditionExpression xsi:type="tFormalExpression">${orderReady  == true}</conditionExpression>
     </sequenceFlow>

     <parallelGateway id="ParallelGateway_RequestCourierAndPackProducts">
       <incoming>SequenceFlow_11</incoming>
       <outgoing>SequenceFlow_13</outgoing>
       <outgoing>SequenceFlow_14</outgoing>
     </parallelGateway>

     <sequenceFlow id="SequenceFlow_12" name="no" sourceRef="ExclusiveGateway_IsOrderReady" targetRef="Task_SelectNextProduct">
       <conditionExpression xsi:type="tFormalExpression">${orderReady  == false}</conditionExpression>
     </sequenceFlow>

     <manualTask id="Task_SelectNextProduct" name="Select next product">
       <incoming>SequenceFlow_12</incoming>
       <outgoing>SequenceFlow_15</outgoing>
     </manualTask>

     <sequenceFlow id="SequenceFlow_13" sourceRef="ParallelGateway_RequestCourierAndPackProducts" targetRef="Task_PackingProducts"/>

     <manualTask id="Task_PackingProducts" name="Packing products">
       <incoming>SequenceFlow_13</incoming>
       <outgoing>SequenceFlow_16</outgoing>
     </manualTask>

     <sequenceFlow id="SequenceFlow_14" sourceRef="ParallelGateway_RequestCourierAndPackProducts" targetRef="Task_RequestCourier"/>

     <manualTask id="Task_RequestCourier" name="Request courier">
       <incoming>SequenceFlow_14</incoming>
       <outgoing>SequenceFlow_17</outgoing>
     </manualTask>

     <sequenceFlow id="SequenceFlow_15" sourceRef="Task_SelectNextProduct" targetRef="ExclusiveGateway_IsInStock"/>

     <sequenceFlow id="SequenceFlow_16" sourceRef="Task_PackingProducts" targetRef="ParallelGateway_ShipOrder"/>

     <sequenceFlow id="SequenceFlow_17" sourceRef="Task_RequestCourier" targetRef="ParallelGateway_ShipOrder"/>

     <parallelGateway id="ParallelGateway_ShipOrder">
       <incoming>SequenceFlow_16</incoming>
       <incoming>SequenceFlow_17</incoming>
       <outgoing>SequenceFlow_18</outgoing>
     </parallelGateway>

     <sequenceFlow id="SequenceFlow_18" sourceRef="ParallelGateway_ShipOrder" targetRef="EndEvent_OrderShipped"/>

     <endEvent id="EndEvent_OrderShipped" name="Shipment prepared">
       <incoming>SequenceFlow_18</incoming>
     </endEvent>

   </process>

</definitions>