<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/pec/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/pec/20100524/MODEL http://www.omg.org/pec/20100524/06-02-01.xsd"
             id="definition" name="BPMN Process Model">
   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>
     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_CollectCreditInfo"/>
     <task id="Task_CollectCreditInfo" name="Collect credit information">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_CollectCreditInfo" targetRef="ExclusiveGateway_AmountCheck"/>
     <exclusiveGateway id="ExclusiveGateway_AmountCheck">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_4</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_3" name="amount <= 1M$" sourceRef="ExclusiveGateway_AmountCheck" targetRef="Task_AssessRisk">
     </sequenceFlow>
     <sequenceFlow id="SequenceFlow_4" name="amount > 1M$" sourceRef="ExclusiveGateway_AmountCheck" targetRef="Task_RequestApproval"/>
     <task id="Task_AssessRisk" name="Assess risk">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_AssessRisk" targetRef="ExclusiveGateway_RiskCheck"/>
     <exclusiveGateway id="ExclusiveGateway_RiskCheck">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_6</outgoing>
       <outgoing>SequenceFlow_7</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_6" name="risk = low" sourceRef="ExclusiveGateway_RiskCheck" targetRef="Task_AcceptCredit">
     </sequenceFlow>
     <sequenceFlow id="SequenceFlow_7" name="risk = high" sourceRef="ExclusiveGateway_RiskCheck" targetRef="Task_RequestApproval"/>
     <task id="Task_AcceptCredit" name="Accept credit">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_8</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_8" sourceRef="Task_AcceptCredit" targetRef="EndEvent_1"/>
     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_8</incoming>
     </endEvent>
     <task id="Task_RequestApproval" name="Request approval">
       <incoming>SequenceFlow_4</incoming>
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_RequestApproval" targetRef="ExclusiveGateway_ApprovalCheck"/>
     <exclusiveGateway id="ExclusiveGateway_ApprovalCheck">
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_10</outgoing>
       <outgoing>SequenceFlow_11</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_10" name="approval = accepted" sourceRef="ExclusiveGateway_ApprovalCheck" targetRef="EndEvent_1"/>
     <sequenceFlow id="SequenceFlow_11" name="approval = rejected" sourceRef="ExclusiveGateway_ApprovalCheck" targetRef="EndEvent_2"/>
     <task id="Task_RejectCreditAfterApproval" name="Reject credit after approval">
       <incoming>SequenceFlow_11</incoming>
       <outgoing>SequenceFlow_12</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_12" sourceRef="Task_RejectCreditAfterApproval" targetRef="EndEvent_2"/>
     <endEvent id="EndEvent_2">
       <incoming>SequenceFlow_12</incoming>
     </endEvent>
   </process>
 </definitions>