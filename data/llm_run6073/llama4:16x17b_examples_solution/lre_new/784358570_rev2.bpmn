<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="BPMN Process Model" targetNamespace="http://bpmn.io/schema/bpmn">
   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>
     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_0s49tzs"/>
     <manualTask id="Task_0s49tzs" name="Review order">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </manualTask>
     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_0s49tzs" targetRef="ExclusiveGateway_1"/>
     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_4</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_1" targetRef="Task_0cw54t3">
       <conditionExpression xsi:type="tFormalExpression">all products available</conditionExpression>
     </sequenceFlow>
     <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_1" targetRef="IntermediateThrowEvent_1">
       <conditionExpression xsi:type="tFormalExpression">some products not available</conditionExpression>
     </sequenceFlow>
     <intermediateThrowEvent id="IntermediateThrowEvent_1" name="wait for delivery of ordered products from supplier">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </intermediateThrowEvent>
     <sequenceFlow id="SequenceFlow_5" sourceRef="IntermediateThrowEvent_1" targetRef="Task_1ff16ed"/>
     <manualTask id="Task_1ff16ed" name="Check products on store">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </manualTask>
     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_1ff16ed" targetRef="ExclusiveGateway_2"/>
     <exclusiveGateway id="ExclusiveGateway_2">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_7</outgoing>
       <outgoing>SequenceFlow_8</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_7" sourceRef="ExclusiveGateway_2" targetRef="Task_0hbku4g">
       <conditionExpression xsi:type="tFormalExpression">all products available</conditionExpression>
     </sequenceFlow>
     <sequenceFlow id="SequenceFlow_8" sourceRef="ExclusiveGateway_2" targetRef="Task_005efpe">
       <conditionExpression xsi:type="tFormalExpression">some products not available</conditionExpression>
     </sequenceFlow>
     <userTask id="Task_0hbku4g" name="Inform customer about delay">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </userTask>
     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_0hbku4g" targetRef="Task_1mxhkkb"/>
     <manualTask id="Task_1mxhkkb" name="Prepare package">
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_10</outgoing>
     </manualTask>
     <sequenceFlow id="SequenceFlow_10" sourceRef="Task_1mxhkkb" targetRef="EndEvent_1"/>
     <userTask id="Task_005efpe" name="Order missing products from supplier">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_11</outgoing>
     </userTask>
     <sequenceFlow id="SequenceFlow_11" sourceRef="Task_005efpe" targetRef="IntermediateThrowEvent_2"/>
     <intermediateCatchEvent id="IntermediateThrowEvent_2" name="wait for delivery of ordered products from supplier">
       <incoming>SequenceFlow_11</incoming>
       <outgoing>SequenceFlow_12</outgoing>
     </intermediateCatchEvent>
     <sequenceFlow id="SequenceFlow_12" sourceRef="IntermediateThrowEvent_2" targetRef="Task_0cw54t3"/>
     <manualTask id="Task_0cw54t3" name="Pick up products from store">
       <incoming>SequenceFlow_3</incoming>
       <incoming>SequenceFlow_12</incoming>
       <outgoing>SequenceFlow_13</outgoing>
     </manualTask>
     <sequenceFlow id="SequenceFlow_13" sourceRef="Task_0cw54t3" targetRef="Task_1l5ze2s"/>
     <userTask id="Task_1l5ze2s" name="Inform courier about prepared packages for delivery">
       <incoming>SequenceFlow_13</incoming>
       <outgoing>SequenceFlow_14</outgoing>
     </userTask>
     <sequenceFlow id="SequenceFlow_14" sourceRef="Task_1l5ze2s" targetRef="ExclusiveGateway_3"/>
     <exclusiveGateway id="ExclusiveGateway_3">
       <incoming>SequenceFlow_14</incoming>
       <outgoing>SequenceFlow_15</outgoing>
       <outgoing>SequenceFlow_16</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_15" sourceRef="ExclusiveGateway_3" targetRef="Task_074g9pd">
       <conditionExpression xsi:type="tFormalExpression">enough free drivers</conditionExpression>
     </sequenceFlow>
     <sequenceFlow id="SequenceFlow_16" sourceRef="ExclusiveGateway_3" targetRef="IntermediateThrowEvent_3">
       <conditionExpression xsi:type="tFormalExpression">no enough free drivers</conditionExpression>
     </sequenceFlow>
     <intermediateCatchEvent id="IntermediateThrowEvent_3" name="wait for free driver">
       <incoming>SequenceFlow_16</incoming>
       <outgoing>SequenceFlow_17</outgoing>
     </intermediateCatchEvent>
     <sequenceFlow id="SequenceFlow_17" sourceRef="IntermediateThrowEvent_3" targetRef="Task_074g9pd"/>
     <userTask id="Task_074g9pd" name="Inform our client about short delay">
       <incoming>SequenceFlow_15</incoming>
       <incoming>SequenceFlow_17</incoming>
       <outgoing>SequenceFlow_18</outgoing>
     </userTask>
     <sequenceFlow id="SequenceFlow_18" sourceRef="Task_074g9pd" targetRef="EndEvent_2"/>
     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_10</incoming>
     </endEvent>
     <endEvent id="EndEvent_2">
       <incoming>SequenceFlow_18</incoming>
     </endEvent>
   </process>
 </definitions>