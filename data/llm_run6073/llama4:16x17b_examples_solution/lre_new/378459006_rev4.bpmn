<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="BPMN Process Model" targetNamespace="http://bpmn.io/schema/bpmn">
   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
       <timerEventDefinition/>
     </startEvent>
     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_0hqmmyy"/>
     <task id="Task_0hqmmyy" name="Generate a Payment report">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_0hqmmyy" targetRef="Task_0ypqj5y"/>
     <task id="Task_0ypqj5y" name="Pay the vendor">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_3" sourceRef="Task_0ypqj5y" targetRef="ParallelGateway_1"/>
     <parallelGateway id="ParallelGateway_1">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_4</outgoing>
       <outgoing>SequenceFlow_5</outgoing>
       <outgoing>SequenceFlow_6</outgoing>
     </parallelGateway>
     <sequenceFlow id="SequenceFlow_4" sourceRef="ParallelGateway_1" targetRef="Task_0xbe0ek"/>
     <task id="Task_0xbe0ek" name="Send the payment report to Accounts Receivable Department">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_7</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_7" sourceRef="Task_0xbe0ek" targetRef="Task_0y014x0"/>
     <task id="Task_0y014x0" name="Generate monthly invoice for clients">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_8</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_8" sourceRef="Task_0y014x0" targetRef="Task_07gmhlg"/>
     <task id="Task_07gmhlg" name="Charge the client $35 per invoice">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_07gmhlg" targetRef="EndEvent_1"/>
     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_9</incoming>
     </endEvent>
     <sequenceFlow id="SequenceFlow_5" sourceRef="ParallelGateway_1" targetRef="Task_1p6ib3m"/>
     <task id="Task_1p6ib3m" name="Send payment report to registry">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_10</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_10" sourceRef="Task_1p6ib3m" targetRef="Task_1jpy31l"/>
     <task id="Task_1jpy31l" name="Selects the paper-based invoices that have been paid">
       <incoming>SequenceFlow_10</incoming>
       <outgoing>SequenceFlow_11</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_11" sourceRef="Task_1jpy31l" targetRef="ExclusiveGateway_2"/>
     <exclusiveGateway id="ExclusiveGateway_2">
       <incoming>SequenceFlow_11</incoming>
       <outgoing>SequenceFlow_12</outgoing>
       <outgoing>SequenceFlow_13</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_12" sourceRef="ExclusiveGateway_2" targetRef="Task_1v5plyz">
     </sequenceFlow>
     <task id="Task_1v5plyz" name="Archive the invoices per vendor">
       <incoming>SequenceFlow_12</incoming>
       <outgoing>SequenceFlow_14</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_14" sourceRef="Task_1v5plyz" targetRef="EndEvent_2"/>
     <endEvent id="EndEvent_2">
       <incoming>SequenceFlow_14</incoming>
     </endEvent>
     <sequenceFlow id="SequenceFlow_13" sourceRef="ExclusiveGateway_2" targetRef="Task_0on5stz">
     </sequenceFlow>
     <task id="Task_0on5stz" name="Track down payment">
       <incoming>SequenceFlow_13</incoming>
       <outgoing>SequenceFlow_15</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_15" sourceRef="Task_0on5stz" targetRef="EndEvent_3"/>
     <endEvent id="EndEvent_3">
       <incoming>SequenceFlow_15</incoming>
     </endEvent>
     <sequenceFlow id="SequenceFlow_6" sourceRef="ParallelGateway_1" targetRef="Task_0am9sd"/>
     <task id="Task_0am9sd" name="Send the payment invoice to clients">
       <incoming>SequenceFlow_6</incoming>
     </task>
   </process>
</definitions>