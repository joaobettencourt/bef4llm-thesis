<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="BPMN Process Model">
   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>
     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>
     <task id="Task_1" name="Check employee performance">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="ExclusiveGateway_1"/>
     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_4</outgoing>
       <outgoing>SequenceFlow_5</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_3" name="performance < 20%" sourceRef="ExclusiveGateway_1" targetRef="Task_2"/>
     <task id="Task_2" name="Suggest employee dismissal">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_2" targetRef="Task_3"/>
     <task id="Task_3" name="Dismiss employee">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_7</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_7" sourceRef="Task_3" targetRef="EndEvent_1"/>
     <sequenceFlow id="SequenceFlow_4" name="20% < performance < 50%" sourceRef="ExclusiveGateway_1" targetRef="Task_4"/>
     <task id="Task_4" name="Suggest training">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_8</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_8" sourceRef="Task_4" targetRef="Task_5"/>
     <task id="Task_5" name="Provide training">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_5" targetRef="EndEvent_1"/>
     <sequenceFlow id="SequenceFlow_5" name="performance > 75%" sourceRef="ExclusiveGateway_1" targetRef="Task_6"/>
     <task id="Task_6" name="Suggest for reward">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_10</outgoing>
     </task>
     <exclusiveGateway id="ExclusiveGateway_2">
       <incoming>SequenceFlow_10</incoming>
       <outgoing>SequenceFlow_11</outgoing>
       <outgoing>SequenceFlow_12</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_10" sourceRef="Task_6" targetRef="ExclusiveGateway_2"/>
     <sequenceFlow id="SequenceFlow_11" name="other benefit" sourceRef="ExclusiveGateway_2" targetRef="Task_7"/>
     <task id="Task_7" name="Choose appropriate benefit">
       <incoming>SequenceFlow_11</incoming>
       <outgoing>SequenceFlow_13</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_13" sourceRef="Task_7" targetRef="ExclusiveGateway_3"/>
     <sequenceFlow id="SequenceFlow_12" name="financial reward" sourceRef="ExclusiveGateway_2" targetRef="Task_8"/>
     <task id="Task_8" name="Calculate and pay reward">
       <incoming>SequenceFlow_12</incoming>
       <outgoing>SequenceFlow_14</outgoing>
     </task>
     <exclusiveGateway id="ExclusiveGateway_3">
       <incoming>SequenceFlow_13</incoming>
       <incoming>SequenceFlow_14</incoming>
       <outgoing>SequenceFlow_15</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_14" sourceRef="Task_8" targetRef="ExclusiveGateway_3"/>
     <sequenceFlow id="SequenceFlow_15" sourceRef="ExclusiveGateway_3" targetRef="Task_9"/>
     <task id="Task_9" name="Announce employee of the month">
       <incoming>SequenceFlow_15</incoming>
       <outgoing>SequenceFlow_16</outgoing>
     </task>
     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_7</incoming>
       <incoming>SequenceFlow_9</incoming>
       <incoming>SequenceFlow_16</incoming>
     </endEvent>
     <sequenceFlow id="SequenceFlow_16" sourceRef="Task_9" targetRef="EndEvent_1"/>
   </process>
</definitions>