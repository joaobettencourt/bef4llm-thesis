<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" 
             targetNamespace="http://bpmn.io/schema/bpmn">

   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_Vendor_Location"/>

     <task id="Task_Vendor_Location" name="Vendor located in SAP system">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_Vendor_Location" targetRef="ExclusiveGateway_1"/>

     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_4</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_3" name="Vendor does not exist" sourceRef="ExclusiveGateway_1" targetRef="Task_New_Vendor_Master_Record">
     </sequenceFlow>

     <task id="Task_New_Vendor_Master_Record" name="Fill out request for new Vendor Master Record form">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_New_Vendor_Master_Record" targetRef="Task_Staple_Request_To_Invoice"/>

     <task id="Task_Staple_Request_To_Invoice" name="Staple request to invoice">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_Staple_Request_To_Invoice" targetRef="Task_Place_Invoice_In_Outbox"/>

     <task id="Task_Place_Invoice_In_Outbox" name="Place invoice in internal outbox for new vendors">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_7</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_7" sourceRef="Task_Place_Invoice_In_Outbox" targetRef="ExclusiveGateway_SubProcess"/>

     <exclusiveGateway id="ExclusiveGateway_SubProcess">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_Urgent</outgoing>
       <outgoing>SequenceFlow_Non_Urgent</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_Urgent" name="Urgent Invoice" sourceRef="ExclusiveGateway_SubProcess" targetRef="IntermediateCatchEvent_Urgent">
     </sequenceFlow>

     <intermediateCatchEvent id="IntermediateCatchEvent_Urgent">
       <incoming>SequenceFlow_Urgent</incoming>
       <outgoing>SequenceFlow_8</outgoing>
       <timerEventDefinition/>
     </intermediateCatchEvent>

     <sequenceFlow id="SequenceFlow_8" sourceRef="IntermediateCatchEvent_Urgent" targetRef="ExclusiveGateway_Final"/>

     <sequenceFlow id="SequenceFlow_Non_Urgent" name="Non-Urgent Invoice" sourceRef="ExclusiveGateway_SubProcess" targetRef="IntermediateCatchEvent_Non_Urgent">
     </sequenceFlow>

     <intermediateCatchEvent id="IntermediateCatchEvent_Non_Urgent">
       <incoming>SequenceFlow_Non_Urgent</incoming>
       <outgoing>SequenceFlow_9</outgoing>
       <timerEventDefinition/>
     </intermediateCatchEvent>

     <sequenceFlow id="SequenceFlow_9" sourceRef="IntermediateCatchEvent_Non_Urgent" targetRef="ExclusiveGateway_Final"/>

     <exclusiveGateway id="ExclusiveGateway_Final">
       <incoming>SequenceFlow_8</incoming>
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_10</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_4" name="Vendor Exists" sourceRef="ExclusiveGateway_1" targetRef="Task_SAP_Vendor_Number"/>

     <task id="Task_SAP_Vendor_Number" name="SAP Vendor number added to invoice">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_10</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_10" sourceRef="ExclusiveGateway_Final" targetRef="Task_Invoices_Sorted"/>

     <exclusiveGateway id="ExclusiveGateway_Sort">
       <incoming>SequenceFlow_10</incoming>
       <outgoing>SequenceFlow_Sort_Vendor</outgoing>
       <outgoing>SequenceFlow_Sort_Amount</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_10" sourceRef="Task_SAP_Vendor_Number" targetRef="ExclusiveGateway_Sort"/>

     <sequenceFlow id="SequenceFlow_Sort_Vendor" name="Sort by Vendor" sourceRef="ExclusiveGateway_Sort" targetRef="Task_Invoices_Sorted_By_Vendor">
     </sequenceFlow>

     <task id="Task_Invoices_Sorted_By_Vendor" name="Invoices sorted by Vendor">
       <incoming>SequenceFlow_Sort_Vendor</incoming>
       <outgoing>SequenceFlow_11</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_11" sourceRef="Task_Invoices_Sorted_By_Vendor" targetRef="ExclusiveGateway_Last"/>

     <sequenceFlow id="SequenceFlow_Sort_Amount" name="Sort by Amount" sourceRef="ExclusiveGateway_Sort" targetRef="Task_Invoices_Sorted_By_Amount">
     </sequenceFlow>

     <task id="Task_Invoices_Sorted_By_Amount" name="Invoices sorted by Amount">
       <incoming>SequenceFlow_Sort_Amount</incoming>
       <outgoing>SequenceFlow_12</outgoing>
     </task>

     <exclusiveGateway id="ExclusiveGateway_Last">
       <incoming>SequenceFlow_11</incoming>
       <incoming>SequenceFlow_12</incoming>
       <outgoing>SequenceFlow_13</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_12" sourceRef="Task_Invoices_Sorted_By_Amount" targetRef="ExclusiveGateway_Last"/>

     <sequenceFlow id="SequenceFlow_13" sourceRef="ExclusiveGateway_Last" targetRef="Task_Invoices_Entered_To_SAP">

     </sequenceFlow>

     <task id="Task_Invoices_Entered_To_SAP" name="Invoices entered into SAP system">
       <incoming>SequenceFlow_13</incoming>
       <outgoing>SequenceFlow_14</outgoing>
     </task>

     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_14</incoming>
     </endEvent>

     <sequenceFlow id="SequenceFlow_14" sourceRef="Task_Invoices_Entered_To_SAP" targetRef="EndEvent_1"/>

   </process>
</definitions>