<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" 
             targetNamespace="http://bpmn.oo/schema">

   <collaboration id="Collaboration_1">
     <participant id="Participant_Customer" name="Bank Customer" processRef="Process_Customer"/>
     <participant id="Participant_PostOfficer" name="Post Officer" processRef="Process_PostOfficer"/>
     <participant id="Participant_BankOfficer" name="Bank Officer" processRef="Process_BankOfficer"/>

     <messageFlow id="MessageFlow_1" sourceRef="Task_Customer_GeneratePDF" targetRef="StartEvent_PostOffice"/>
     <messageFlow id="MessageFlow_2" sourceRef="Task_PostOfficer_MailAccountRequest" targetRef="StartEvent_BankOfficer"/>
   </collaboration>

   <process id="Process_Customer" isExecutable="true">
     <startEvent id="StartEvent_Customer_1">
       <outgoing>SequenceFlow_Customer_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_Customer_1" sourceRef="StartEvent_Customer_1" targetRef="Task_Customer_VisitBankWebsite"/>

     <task id="Task_Customer_VisitBankWebsite" name="Visit Bank Website">
       <incoming>SequenceFlow_Customer_1</incoming>
       <outgoing>SequenceFlow_Customer_2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_Customer_2" sourceRef="Task_Customer_VisitBankWebsite" targetRef="Task_Customer_FillInPersonalData"/>

     <task id="Task_Customer_FillInPersonalData" name="Fill in personal data">
       <incoming>SequenceFlow_Customer_2</incoming>
       <outgoing>SequenceFlow_Customer_3</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_Customer_3" sourceRef="Task_Customer_FillInPersonalData" targetRef="Task_Customer_GeneratePDF"/>

     <task id="Task_Customer_GeneratePDF" name="Generate and print Pdf">
       <incoming>SequenceFlow_Customer_3</incoming>
       <outgoing>MessageFlow_1</outgoing>
     </task>

     <intermediateCatchEvent id="IntermediateCatchEvent_Customer_AccountDocuments" name="Account Documents Received">
       <incoming>MessageFlow_2</incoming>
       <outgoing>SequenceFlow_Customer_4</outgoing>
       <messageEventDefinition/>
     </intermediateCatchEvent>

     <sequenceFlow id="SequenceFlow_Customer_4" sourceRef="IntermediateCatchEvent_Customer_AccountDocuments" targetRef="EndEvent_Customer"/>

     <endEvent id="EndEvent_Customer">
       <incoming>SequenceFlow_Customer_4</incoming>
     </endEvent>
   </process>

   <process id="Process_PostOfficer" isExecutable="true">
     <startEvent id="StartEvent_PostOffice">
       <incoming>MessageFlow_1</incoming>
       <outgoing>SequenceFlow_PostOfficer_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_PostOfficer_1" sourceRef="StartEvent_PostOffice" targetRef="Task_PostOfficer_AuthenticateCustomer"/>

     <task id="Task_PostOfficer_AuthenticateCustomer" name="Authenticate Bank Customer">
       <incoming>SequenceFlow_PostOfficer_1</incoming>
       <outgoing>SequenceFlow_PostOfficer_2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_PostOfficer_2" sourceRef="Task_PostOfficer_AuthenticateCustomer" targetRef="Task_PostOfficer_MailAccountRequest"/>

     <task id="Task_PostOfficer_MailAccountRequest" name="Mail Account Request">
       <incoming>SequenceFlow_PostOfficer_2</incoming>
       <outgoing>MessageFlow_2</outgoing>
     </task>
   </process>

   <process id="Process_BankOfficer" isExecutable="true">
     <startEvent id="StartEvent_BankOfficer">
       <incoming>MessageFlow_2</incoming>
       <outgoing>SequenceFlow_BankOfficer_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_BankOfficer_1" sourceRef="StartEvent_BankOfficer" targetRef="Task_BankOfficer_CheckCustomerData"/>

     <task id="Task_BankOfficer_CheckCustomerData" name="Check Customer Data">
       <incoming>SequenceFlow_BankOfficer_1</incoming>
       <outgoing>SequenceFlow_BankOfficer_2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_BankOfficer_2" sourceRef="Task_BankOfficer_CheckCustomerData" targetRef="ExclusiveGateway_BankOfficer"/>

     <exclusiveGateway id="ExclusiveGateway_BankOfficer">
       <incoming>SequenceFlow_BankOfficer_2</incoming>
       <outgoing>SequenceFlow_BankOfficer_3</outgoing>
       <outgoing>SequenceFlow_BankOfficer_4</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_BankOfficer_3" sourceRef="ExclusiveGateway_BankOfficer" targetRef="Task_BankOfficer_MailAccountDocuments">
       <conditionExpression xsi:type="tFormalExpression">accept</conditionExpression>
     </sequenceFlow>

     <task id="Task_BankOfficer_MailAccountDocuments" name="Mail Account Documents">
       <incoming>SequenceFlow_BankOfficer_3</incoming>
     </task>

     <sequenceFlow id="SequenceFlow_BankOfficer_4" sourceRef="ExclusiveGateway_BankOfficer" targetRef="Task_BankOfficer_MailLetterOfRefusal">
       <conditionExpression xsi:type="tFormalExpression">reject</conditionExpression>
     </sequenceFlow>

     <task id="Task_BankOfficer_MailLetterOfRefusal" name="Mail letter of refusal">
       <incoming>SequenceFlow_BankOfficer_4</incoming>
     </task>
   </process>
</definitions>