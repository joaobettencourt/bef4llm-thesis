<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="BPMN Process Model">
   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>
     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>
     <task id="Task_1" name="Receive expense report">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="ExclusiveGateway_1"/>
     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_4</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_1" targetRef="Task_2">
       <conditionExpression xsi:type="tFormalExpression">has account</conditionExpression>
     </sequenceFlow>
     <task id="Task_2" name="Review the report">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_1" targetRef="Task_3">
       <conditionExpression xsi:type="tFormalExpression">no account</conditionExpression>
     </sequenceFlow>
     <task id="Task_3" name="Create a new account">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_3" targetRef="Task_2"/>
     <exclusiveGateway id="ExclusiveGateway_2">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_7</outgoing>
       <outgoing>SequenceFlow_8</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_2" targetRef="ExclusiveGateway_2"/>
     <sequenceFlow id="SequenceFlow_7" sourceRef="ExclusiveGateway_2" targetRef="EndEvent_3">
       <conditionExpression xsi:type="tFormalExpression">amount <= 200</conditionExpression>
     </sequenceFlow>
     <task id="Task_4" name="Deposit reimbursement to employee's direct deposit bank account">
       <incoming>SequenceFlow_7</incoming>
     </task>
     <endEvent id="EndEvent_3">
       <incoming>SequenceFlow_7</incoming>
       <incoming>SequenceFlow_9</incoming>
     </endEvent>
     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_4" targetRef="EndEvent_3"/>
     <sequenceFlow id="SequenceFlow_8" sourceRef="ExclusiveGateway_2" targetRef="Task_5">
       <conditionExpression xsi:type="tFormalExpression">amount > 200</conditionExpression>
     </sequenceFlow>
     <task id="Task_5" name="Ask approval from supervisor">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_10</outgoing>
     </task>
     <intermediateCatchEvent id="IntermediateCatchEvent_1" name="28 days passed">
       <timerEventDefinition/>
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_11</outgoing>
     </intermediateCatchEvent>
     <sequenceFlow id="SequenceFlow_11" sourceRef="IntermediateCatchEvent_1" targetRef="EndEvent_1"/>
     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_11</incoming>
     </endEvent>
     <exclusiveGateway id="ExclusiveGateway_3">
       <incoming>SequenceFlow_10</incoming>
       <outgoing>SequenceFlow_12</outgoing>
       <outgoing>SequenceFlow_13</outgoing>
       <outgoing>SequenceFlow_14</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_10" sourceRef="Task_5" targetRef="ExclusiveGateway_3"/>
     <sequenceFlow id="SequenceFlow_12" sourceRef="ExclusiveGateway_3" targetRef="EndEvent_2">
     </sequenceFlow>
     <endEvent id="EndEvent_2">
       <incoming>SequenceFlow_12</incoming>
     </endEvent>
     <intermediateCatchEvent id="IntermediateCatchEvent_2" name="Supervisor approves the request">
       <messageEventDefinition/>
       <incoming>SequenceFlow_10</incoming>
       <outgoing>SequenceFlow_15</outgoing>
     </intermediateCatchEvent>
     <sequenceFlow id="SequenceFlow_15" sourceRef="IntermediateCatchEvent_2" targetRef="Task_4"/>
     <intermediateCatchEvent id="IntermediateCatchEvent_3" name="Supervisor rejects the request">
       <messageEventDefinition/>
       <incoming>SequenceFlow_10</incoming>
       <outgoing>SequenceFlow_16</outgoing>
     </intermediateCatchEvent>
     <task id="Task_6" name="Send employee a notification through email that the request has been rejected">
       <incoming>SequenceFlow_16</incoming>
     </task>
     <sequenceFlow id="SequenceFlow_14" sourceRef="ExclusiveGateway_3" targetRef="IntermediateCatchEvent_3"/>
     <sequenceFlow id="SequenceFlow_13" sourceRef="ExclusiveGateway_3" targetRef="Task_6"/>
     <sequenceFlow id="SequenceFlow_16" sourceRef="IntermediateCatchEvent_3" targetRef="Task_6"/>
   </process>
</definitions>