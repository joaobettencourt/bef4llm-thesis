<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" 
             targetNamespace="http://bpmn.io/schema/bpmn">

   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>

     <task id="Task_1" name="Process Customer Order">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="IntermediateThrowEvent_1"/>

     <intermediateThrowEvent id="IntermediateThrowEvent_1">
       <incoming>SequenceFlow_2</incoming>
       <messageEventDefinition/>
       <outgoing>MessageFlow_1</outgoing>
     </intermediateThrowEvent>

     <messageFlow id="MessageFlow_1" sourceRef="IntermediateThrowEvent_1" targetRef="StartEvent_2"/>

     <startEvent id="StartEvent_2">
       <incoming>MessageFlow_1</incoming>
       <outgoing>SequenceFlow_3</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_3" sourceRef="StartEvent_2" targetRef="Task_2"/>

     <task id="Task_2" name="Determine Required Parts">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_4</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_4" sourceRef="Task_2" targetRef="ExclusiveGateway_1"/>

     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_5</outgoing>
       <outgoing>SequenceFlow_6</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_5" name="No" sourceRef="ExclusiveGateway_1" targetRef="Task_3"/>

     <task id="Task_3" name="Order Missing Parts">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_7</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_7" sourceRef="Task_3" targetRef="ExclusiveGateway_2"/>

     <exclusiveGateway id="ExclusiveGateway_2">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_8</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_8" sourceRef="ExclusiveGateway_2" targetRef="Task_4"/>

     <task id="Task_4" name="Produce Product">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_4" targetRef="Task_5"/>

     <task id="Task_5" name="Perform Quality Checks">
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_10</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_10" sourceRef="Task_5" targetRef="Task_6"/>

     <task id="Task_6" name="Package and Label Product">
       <incoming>SequenceFlow_10</incoming>
       <outgoing>MessageFlow_2</outgoing>
     </task>

     <messageFlow id="MessageFlow_2" sourceRef="Task_6" targetRef="EndEvent_1"/>

     <endEvent id="EndEvent_1">
       <incoming>MessageFlow_2</incoming>
     </endEvent>

     <sequenceFlow id="SequenceFlow_6" name="Yes" sourceRef="ExclusiveGateway_1" targetRef="Task_4"/>
   </process>
</definitions>