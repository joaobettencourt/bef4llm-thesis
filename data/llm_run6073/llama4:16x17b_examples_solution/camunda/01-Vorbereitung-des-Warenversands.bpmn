<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definitions" 
             targetNamespace="http://example.com">

   <process id="Process_1" isExecutable="true">
     <laneSet>
       <lane id="Lane_Sekretariat" name="Sekretariat">
         <flowNodeRef>Task_Versandartklaeren</flowNodeRef>
         <flowNodeRef>Task_Angebotevon3Spediteureneinholen</flowNodeRef>
         <flowNodeRef>Task_Spediteurbeauftragen</flowNodeRef>
         <flowNodeRef>Task_Paketscheinausfuellen</flowNodeRef>
         <flowNodeRef>Gateway_Versandart</flowNodeRef>
         <flowNodeRef>Gateway_Versicherung</flowNodeRef>
         <flowNodeRef>StartEvent_1</flowNodeRef>
       </lane>
       <lane id="Lane_LeiterLogistik" name="Leiter Logistik">
         <flowNodeRef>Task_Versicherungabschliessen</flowNodeRef>
       </lane>
       <lane id="Lane_Lagerarbeiter" name="Lagerarbeiter">
         <flowNodeRef>Task_Wareverpacken</flowNodeRef>
         <flowNodeRef>Task_Warebereitstellen</flowNodeRef>
       </lane>
     </laneSet>

     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="ParallelGateway_1"/>

     <parallelGateway id="ParallelGateway_1">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
       <outgoing>SequenceFlow_3</outgoing>
     </parallelGateway>

     <sequenceFlow id="SequenceFlow_2" sourceRef="ParallelGateway_1" targetRef="Task_Versandartklaeren"/>

     <task id="Task_Versandartklaeren" name="Versandart klären">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_4</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_4" sourceRef="Task_Versandartklaeren" targetRef="Gateway_Versandart"/>

     <exclusiveGateway id="Gateway_Versandart">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_5</outgoing>
       <outgoing>SequenceFlow_6</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_5" name="ja" sourceRef="Gateway_Versandart" targetRef="Task_Angebotevon3Spediteureneinholen"/>

     <task id="Task_Angebotevon3Speditureneinholen" name="Angebote von 3 Spediteuren einholen">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_7</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_7" sourceRef="Task_Angebotevon3Speditureneinholen" targetRef="Task_Spediteurbeauftragen"/>

     <task id="Task_Spediteurbeauftragen" name="Spediteur beauftragen">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_8</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_8" sourceRef="Task_Spediteurbeauftragen" targetRef="Gateway_2"/>

     <sequenceFlow id="SequenceFlow_6" name="nein" sourceRef="Gateway_Versandart" targetRef="Task_Paketscheinausfuellen"/>

     <task id="Task_Paketscheinausfuellen" name="Paketschein ausfüllen">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_Paketscheinausfuellen" targetRef="Gateway_Versicherung"/>

     <inclusiveGateway id="Gateway_Versicherung">
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_10</outgoing>
     </inclusiveGateway>

     <sequenceFlow id="SequenceFlow_10" sourceRef="Gateway_Versicherung" targetRef="Task_Versicherungabschliessen"/>

     <task id="Task_Versicherungabschliessen" name="Versicherung abschließen">
       <incoming>SequenceFlow_10</incoming>
       <outgoing>SequenceFlow_11</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_11" sourceRef="Task_Versicherungabschliessen" targetRef="Gateway_2"/>

     <exclusiveGateway id="Gateway_2">
       <incoming>SequenceFlow_8</incoming>
       <incoming>SequenceFlow_11</incoming>
       <outgoing>SequenceFlow_12</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_12" sourceRef="Gateway_2" targetRef="Task_Wareverpacken"/>

     <task id="Task_Wareverpacken" name="Ware verpacken">
       <incoming>SequenceFlow_3</incoming>
       <incoming>SequenceFlow_12</incoming>
       <outgoing>SequenceFlow_13</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_13" sourceRef="Task_Wareverpacken" targetRef="Gateway_3"/>

     <exclusiveGateway id="Gateway_3">
       <incoming>SequenceFlow_13</incoming>
       <outgoing>SequenceFlow_14</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_14" sourceRef="Gateway_3" targetRef="Task_Warebereitstellen"/>

     <task id="Task_Warebereitstellen" name="Ware bereitstellen">
       <incoming>SequenceFlow_14</incoming>
       <outgoing>SequenceFlow_15</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_15" sourceRef="Task_Warebereitstellen" targetRef="EndEvent_1"/>

     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_15</incoming>
     </endEvent>

   </process>
</definitions>