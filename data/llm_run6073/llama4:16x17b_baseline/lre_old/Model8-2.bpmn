<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" 
             targetNamespace="http://example.com/bpmn">
  <process id="Process_1" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>
    <task id="Task_1" name="Create Job Description">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
      <outgoing>SequenceFlow_3</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="Task_3">
      <conditionExpression xsi:type="tFormalExpression">clarificationNeeded = false</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="SequenceFlow_3" sourceRef="Task_1" targetRef="Task_2">
      <conditionExpression xsi:type="tFormalExpression">clarificationNeeded = true</conditionExpression>
    </sequenceFlow>
    <task id="Task_2" name="Request Clarification from Department">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_4</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_4" sourceRef="Task_2" targetRef="Task_1"/>
    <task id="Task_3" name="Submit Job Description for Approval">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_5</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_5" sourceRef="Task_3" targetRef="ExclusiveGateway_1"/>
    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_6</outgoing>
      <outgoing>SequenceFlow_7</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_6" sourceRef="ExclusiveGateway_1" targetRef="Task_4">
      <conditionExpression xsi:type="tFormalExpression">approvalStatus = 'approved'</conditionExpression>
    </sequenceFlow>
    <task id="Task_4" name="Post Job">
      <incoming>SequenceFlow_6</incoming>
    </task>
    <sequenceFlow id="SequenceFlow_7" sourceRef="ExclusiveGateway_1" targetRef="Task_5">
      <conditionExpression xsi:type="tFormalExpression">approvalStatus = 'rejected'</conditionExpression>
    </sequenceFlow>
    <task id="Task_5" name="Correct Job Description">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_8" sourceRef="Task_5" targetRef="Task_3"/>
  </process>
</definitions>