<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Loan Approval Process" targetNamespace="http://example.com/bpmn">
   <process id="loanApprovalProcess" isExecutable="true">
     <startEvent id="start-event">
       <outgoing>sequence-flow-1</outgoing>
     </startEvent>
     <sequenceFlow id="sequence-flow-1" sourceRef="start-event" targetRef="receive-customer-request"/>
     <task id="receive-customer-request" name="Receive Customer Request">
       <incoming>sequence-flow-1</incoming>
       <outgoing>sequence-flow-2</outgoing>
     </task>
     <sequenceFlow id="sequence-flow-2" sourceRef="receive-customer-request" targetRef="invoke-risk-assessment-web-service"/>
     <serviceTask id="invoke-risk-assessment-web-service" name="Invoke Risk Assessment Web Service">
       <incoming>sequence-flow-2</incoming>
       <outgoing>sequence-flow-3</outgoing>
     </serviceTask>
     <sequenceFlow id="sequence-flow-3" sourceRef="invoke-risk-assessment-web-service" targetRef="exclusive-gateway-1"/>
     <exclusiveGateway id="exclusive-gateway-1">
       <incoming>sequence-flow-3</incoming>
       <outgoing>sequence-flow-4</outgoing>
       <outgoing>sequence-flow-5</outgoing>
       <outgoing>sequence-flow-6</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="sequence-flow-4" name="Low Risk and Small Loan" sourceRef="exclusive-gateway-1" targetRef="approve-loan">
       <conditionExpression xsi:type="tFormalExpression">loanAmount &lt; 10000 and riskLevel = 'low'</conditionExpression>
     </sequenceFlow>
     <task id="approve-loan" name="Approve Loan">
       <incoming>sequence-flow-4</incoming>
       <outgoing>sequence-flow-7</outgoing>
     </task>
     <sequenceFlow id="sequence-flow-7" sourceRef="approve-loan" targetRef="end-event-1"/>
     <endEvent id="end-event-1">
       <incoming>sequence-flow-7</incoming>
     </endEvent>
     <sequenceFlow id="sequence-flow-5" name="High Risk" sourceRef="exclusive-gateway-1" targetRef="deny-loan">
       <conditionExpression xsi:type="tFormalExpression">riskLevel = 'high'</conditionExpression>
     </sequenceFlow>
     <task id="deny-loan" name="Deny Loan">
       <incoming>sequence-flow-5</incoming>
       <outgoing>sequence-flow-8</outgoing>
     </task>
     <sequenceFlow id="sequence-flow-8" sourceRef="deny-loan" targetRef="end-event-2"/>
     <endEvent id="end-event-2">
       <incoming>sequence-flow-8</incoming>
     </endEvent>
     <sequenceFlow id="sequence-flow-6" name="Further Review or Large Loan" sourceRef="exclusive-gateway-1" targetRef="invoke-approver-web-service">
       <conditionExpression xsi:type="tFormalExpression">loanAmount >= 10000 or riskLevel = 'medium'</conditionExpression>
     </sequenceFlow>
     <serviceTask id="invoke-approver-web-service" name="Invoke Approver Web Service">
       <incoming>sequence-flow-6</incoming>
       <outgoing>sequence-flow-9</outgoing>
     </serviceTask>
     <sequenceFlow id="sequence-flow-9" sourceRef="invoke-approver-web-service" targetRef="end-event-3"/>
     <endEvent id="end-event-3">
       <incoming>sequence-flow-9</incoming>
     </endEvent>
   </process>
 </definitions>