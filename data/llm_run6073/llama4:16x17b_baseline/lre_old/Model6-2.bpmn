<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" 
             targetNamespace="http://example.com/bpmn">
  <process id="orderProcess" isExecutable="true">
    <startEvent id="startEvent">
      <outgoing>sendOrder</outgoing>
      <timerEventDefinition>
        <timeCycle>P1M</timeCycle>
      </timerEventDefinition>
    </startEvent>
    <sequenceFlow id="sendOrder" sourceRef="startEvent" targetRef="sendOrderToSupplier"/>
    <serviceTask id="sendOrderToSupplier" name="Send Order to Supplier">
      <incoming>sendOrder</incoming>
      <outgoing>processOrder</outgoing>
    </serviceTask>
    <sequenceFlow id="processOrder" sourceRef="sendOrderToSupplier" targetRef="supplierProcessesOrder"/>
    <serviceTask id="supplierProcessesOrder" name="Supplier Processes Order">
      <incoming>processOrder</incoming>
      <outgoing>sendInvoice</outgoing>
    </serviceTask>
    <sequenceFlow id="sendInvoice" sourceRef="supplierProcessesOrder" targetRef="supplierSendsInvoice"/>
    <serviceTask id="supplierSendsInvoice" name="Supplier Sends Invoice">
      <incoming>sendInvoice</incoming>
      <outgoing>receiveInvoice</outgoing>
    </serviceTask>
    <sequenceFlow id="receiveInvoice" sourceRef="supplierSendsInvoice" targetRef="assemblerAGReceivesInvoice"/>
    <serviceTask id="assemblerAGReceivesInvoice" name="Assembler AG Receives Invoice">
      <incoming>receiveInvoice</incoming>
      <outgoing>endProcess</outgoing>
    </serviceTask>
    <sequenceFlow id="endProcess" sourceRef="assemblerAGReceivesInvoice" targetRef="endEvent"/>
    <endEvent id="endEvent">
      <incoming>endProcess</incoming>
    </endEvent>
  </process>
</definitions>