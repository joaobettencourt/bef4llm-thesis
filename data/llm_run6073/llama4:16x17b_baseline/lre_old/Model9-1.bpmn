<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Business Process Model" targetNamespace="http://example.com/bpmn">
   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>
     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>
     <task id="Task_1" name="Backup Database">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="Task_2"/>
     <task id="Task_2" name="Check for New Records in Account Defaulters Table">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_4</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_3" sourceRef="Task_2" targetRef="Task_5">
       <!-- conditionExpression -->
     </sequenceFlow>
     <sequenceFlow id="SequenceFlow_4" sourceRef="Task_2" targetRef="Task_3">
       <!-- conditionExpression -->
     </sequenceFlow>
     <task id="Task_3" name="Check CRM System for New Returns">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_5</outgoing>
       <outgoing>SequenceFlow_6</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_3" targetRef="EndEvent_1">
       <!-- conditionExpression -->
     </sequenceFlow>
     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_3" targetRef="Task_4"/>
     <task id="Task_4" name="Register Defaulting Accounts and Customers">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_7</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_7" sourceRef="Task_4" targetRef="ExclusiveGateway_1"/>
     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_8</outgoing>
       <outgoing>SequenceFlow_9</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_8" sourceRef="ExclusiveGateway_1" targetRef="Task_6">
       <!-- conditionExpression -->
     </sequenceFlow>
     <task id="Task_6" name="Produce Table of Defaulting Accounts and Send to Account Management">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_10</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_10" sourceRef="Task_6" targetRef="IntermediateEvent_1"/>
     <intermediateEvent id="IntermediateEvent_1">
       <incoming>SequenceFlow_10</incoming>
       <!-- timerEventDefinition -->
       <outgoing>SequenceFlow_11</outgoing>
     </intermediateEvent>
     <sequenceFlow id="SequenceFlow_11" sourceRef="IntermediateEvent_1" targetRef="Task_7"/>
     <task id="Task_7" name="Send Alert to Supervisor">
       <incoming>SequenceFlow_11</incoming>
     </task>
     <sequenceFlow id="SequenceFlow_9" sourceRef="ExclusiveGateway_1" targetRef="Task_5"/>
     <task id="Task_5" name="Reconcile with Existing Account Defaulters Table">
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_12</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_12" sourceRef="Task_5" targetRef="IntermediateEvent_2"/>
     <intermediateEvent id="IntermediateEvent_2">
       <incoming>SequenceFlow_12</incoming>
       <!-- timerEventDefinition -->
       <outgoing>SequenceFlow_13</outgoing>
     </intermediateEvent>
     <sequenceFlow id="SequenceFlow_13" sourceRef="IntermediateEvent_2" targetRef="Task_8"/>
     <task id="Task_8" name="Send Message to Supervisor">
       <incoming>SequenceFlow_13</incoming>
     </task>
     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_5</incoming>
     </endEvent>
   </process>
 </definitions>