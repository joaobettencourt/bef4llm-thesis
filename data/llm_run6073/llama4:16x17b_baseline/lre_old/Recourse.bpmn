<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Business Process Model" targetNamespace="http://example.com/bpmn">
   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>
     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>
     <task id="Task_1" name="Check if Insurant can be Subrogated">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="ExclusiveGateway_1"/>
     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_4</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_1" targetRef="Task_2">
       <conditionExpression xsi:type="tFormalExpression">subrogationPossible  = true</conditionExpression>
     </sequenceFlow>
     <task id="Task_2" name="Send Request for Payment and Create Reminder">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_1">
       <conditionExpression xsi:type="tFormalExpression">subrogationPossible  = false</conditionExpression>
     </sequenceFlow>
     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_4</incoming>
     </endEvent>
     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_2" targetRef="IntermediateCatchEvent_1"/>
     <intermediateCatchEvent id="IntermediateCatchEvent_1">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_6</outgoing>
       <outgoing>SequenceFlow_7</outgoing>
     </intermediateCatchEvent>
     <sequenceFlow id="SequenceFlow_6" sourceRef="IntermediateCatchEvent_1" targetRef="Task_3">
       <conditionExpression xsi:type="tFormalExpression">paymentReceived  = true</conditionExpression>
     </sequenceFlow>
     <task id="Task_3" name="Make Booking and Close Case">
       <incoming>SequenceFlow_6</incoming>
     </task>
     <sequenceFlow id="SequenceFlow_7" sourceRef="IntermediateCatchEvent_1" targetRef="Task_4">
       <conditionExpression xsi:type="tFormalExpression">insurantDisagrees  = true</conditionExpression>
     </sequenceFlow>
     <task id="Task_4" name="Check Insurant's Reasoning">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_8</outgoing>
       <outgoing>SequenceFlow_9</outgoing>
     </task>
     <exclusiveGateway id="ExclusiveGateway_2">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_10</outgoing>
       <outgoing>SequenceFlow_11</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_8" sourceRef="Task_4" targetRef="ExclusiveGateway_2"/>
     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_4" targetRef="EndEvent_2">
       <conditionExpression xsi:type="tFormalExpression">insurantRight  = true</conditionExpression>
     </sequenceFlow>
     <endEvent id="EndEvent_2">
       <incoming>SequenceFlow_9</incoming>
     </endEvent>
     <sequenceFlow id="SequenceFlow_10" sourceRef="ExclusiveGateway_2" targetRef="Task_5">
       <conditionExpression xsi:type="tFormalExpression">insurantWrong  = true</conditionExpression>
     </sequenceFlow>
     <task id="Task_5" name="Forward to Collection Agency">
       <incoming>SequenceFlow_10</incoming>
     </task>
     <sequenceFlow id="SequenceFlow_11" sourceRef="ExclusiveGateway_2" targetRef="EndEvent_3"/>
     <endEvent id="EndEvent_3">
       <incoming>SequenceFlow_11</incoming>
     </endEvent>
   </process>
 </definitions>