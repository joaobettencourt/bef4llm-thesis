<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Claims Notification Process" targetNamespace="http://example.com">
   <process id="claimsNotificationProcess" isExecutable="true">
     <startEvent id="start-event-1">
       <outgoing>sequence-flow-1</outgoing>
     </startEvent>
     <sequenceFlow id="sequence-flow-1" sourceRef="start-event-1" targetRef="check-claimant-insurance-status"/>
     <task id="check-claimant-insurance-status" name="Check Claimant Insurance Status">
       <incoming>sequence-flow-1</incoming>
       <outgoing>sequence-flow-2</outgoing>
     </task>
     <exclusiveGateway id="exclusive-gateway-1">
       <incoming>sequence-flow-2</incoming>
       <outgoing>sequence-flow-3</outgoing>
       <outgoing>sequence-flow-4</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="sequence-flow-2" sourceRef="check-claimant-insurance-status" targetRef="exclusive-gateway-1"/>
     <sequenceFlow id="sequence-flow-3" sourceRef="exclusive-gateway-1" targetRef="evaluate-claim-severity">
       <conditionExpression xsi:type="tFormalExpression">claimantInsured = true</conditionExpression>
     </sequenceFlow>
     <task id="inform-claimant-to-reject-claim" name="Inform Claimant to Reject Claim">
       <incoming>sequence-flow-4</incoming>
     </task>
     <sequenceFlow id="sequence-flow-4" sourceRef="exclusive-gateway-1" targetRef="inform-claimant-to-reject-claim">
       <conditionExpression xsi:type="tFormalExpression">claimantInsured = false</conditionExpression>
     </sequenceFlow>
     <task id="evaluate-claim-severity" name="Evaluate Claim Severity">
       <incoming>sequence-flow-3</incoming>
       <outgoing>sequence-flow-5</outgoing>
     </task>
     <exclusiveGateway id="exclusive-gateway-2">
       <incoming>sequence-flow-5</incoming>
       <outgoing>sequence-flow-6</outgoing>
       <outgoing>sequence-flow-7</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="sequence-flow-5" sourceRef="evaluate-claim-severity" targetRef="exclusive-gateway-2"/>
     <task id="send-simple-claim-forms" name="Send Simple Claim Forms">
       <incoming>sequence-flow-6</incoming>
       <outgoing>sequence-flow-8</outgoing>
     </task>
     <sequenceFlow id="sequence-flow-6" sourceRef="exclusive-gateway-2" targetRef="send-simple-claim-forms">
       <conditionExpression xsi:type="tFormalExpression">claimSeverity = 'simple'</conditionExpression>
     </sequenceFlow>
     <task id="send-complex-claim-forms" name="Send Complex Claim Forms">
       <incoming>sequence-flow-7</incoming>
       <outgoing>sequence-flow-9</outgoing>
     </task>
     <sequenceFlow id="sequence-flow-7" sourceRef="exclusive-gateway-2" targetRef="send-complex-claim-forms">
       <conditionExpression xsi:type="tFormalExpression">claimSeverity = 'complex'</conditionExpression>
     </sequenceFlow>
     <sequenceFlow id="sequence-flow-8" sourceRef="send-simple-claim-forms" targetRef="check-claim-forms-for-completeness"/>
     <sequenceFlow id="sequence-flow-9" sourceRef="send-complex-claim-forms" targetRef="check-claim-forms-for-completeness"/>
     <task id="check-claim-forms-for-completeness" name="Check Claim Forms for Completeness">
       <incoming>sequence-flow-8</incoming>
       <incoming>sequence-flow-9</incoming>
       <outgoing>sequence-flow-10</outgoing>
       <outgoing>sequence-flow-11</outgoing>
     </task>
     <sequenceFlow id="sequence-flow-10" sourceRef="check-claim-forms-for-completeness" targetRef="register-claim-in-claims-management-system">
       <conditionExpression xsi:type="tFormalExpression">formsComplete = true</conditionExpression>
     </sequenceFlow>
     <task id="register-claim-in-claims-management-system" name="Register Claim in Claims Management System">
       <incoming>sequence-flow-10</incoming>
       <outgoing>sequence-flow-12</outgoing>
     </task>
     <endEvent id="end-event-1">
       <incoming>sequence-flow-12</incoming>
     </endEvent>
     <sequenceFlow id="sequence-flow-11" sourceRef="check-claim-forms-for-completeness" targetRef="inform-claimant-to-update-forms">
       <conditionExpression xsi:type="tFormalExpression">formsComplete = false</conditionExpression>
     </sequenceFlow>
     <task id="inform-claimant-to-update-forms" name="Inform Claimant to Update Forms">
       <incoming>sequence-flow-11</incoming>
       <outgoing>sequence-flow-13</outgoing>
     </task>
     <sequenceFlow id="sequence-flow-12" sourceRef="register-claim-in-claims-management-system" targetRef="end-event-1"/>
     <sequenceFlow id="sequence-flow-13" sourceRef="inform-claimant-to-update-forms" targetRef="check-claim-forms-for-completeness"/>
   </process>
</definitions>