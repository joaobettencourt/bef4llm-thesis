<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definitions" 
             targetNamespace="http://example.com/bpmn">

   <process id="RoboticBurgerSellerProcess" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_ReceiveOrder"/>

     <task id="Task_ReceiveOrder" name="Receive Order">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_ReceiveOrder" targetRef="ExclusiveGateway_MenuOrBurger"/>

     <exclusiveGateway id="ExclusiveGateway_MenuOrBurger">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_4</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_MenuOrBurger" targetRef="Task_PrepareDrink">
       <conditionExpression xsi:type="tFormalExpression">${orderType  ==  'menu'}</conditionExpression>
     </sequenceFlow>

     <task id="Task_PrepareDrink" name="Prepare Drink">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_PrepareDrink" targetRef="ExclusiveGateway_FriesOrWedges"/>

     <exclusiveGateway id="ExclusiveGateway_FriesOrWedges">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_6</outgoing>
       <outgoing>SequenceFlow_7</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_6" sourceRef="ExclusiveGateway_FriesOrWedges" targetRef="Task_PrepareFries">
       <conditionExpression xsi:type="tFormalExpression">${sideOrder  ==  'fries'}</conditionExpression>
     </sequenceFlow>

     <task id="Task_PrepareFries" name="Prepare Fries">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_8</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_8" sourceRef="Task_PrepareFries" targetRef="Task_PrepareBurger"/>

     <sequenceFlow id="SequenceFlow_7" sourceRef="ExclusiveGateway_FriesOrWedges" targetRef="Task_PrepareWedges">
       <conditionExpression xsi:type="tFormalExpression">${sideOrder  ==  'wedges'}</conditionExpression>
     </sequenceFlow>

     <task id="Task_PrepareWedges" name="Prepare Wedges">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_PrepareWedges" targetRef="Task_PrepareBurger"/>

     <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_MenuOrBurger" targetRef="Task_PrepareBurger">
       <conditionExpression xsi:type="tFormalExpression">${orderType  ==  'burger'}</conditionExpression>
     </sequenceFlow>

     <task id="Task_PrepareBurger" name="Prepare Burger">
       <incoming>SequenceFlow_8</incoming>
       <incoming>SequenceFlow_9</incoming>
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_10</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_10" sourceRef="Task_PrepareBurger" targetRef="EndEvent_OrderDelivered"/>

     <endEvent id="EndEvent_OrderDelivered">
       <incoming>SequenceFlow_10</incoming>
     </endEvent>

   </process>

</definitions>