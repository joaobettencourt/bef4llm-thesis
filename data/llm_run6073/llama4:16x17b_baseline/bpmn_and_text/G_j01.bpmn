<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definition" name="Farming Bot Process" targetNamespace="http://example.com">

   <process id="FarmingBotProcess" isExecutable="true">
     <startEvent id="StartEvent1">
       <outgoing>SequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow1" sourceRef="StartEvent1" targetRef="Task_ResourceSelection"/>

     <task id="Task_ResourceSelection" name="Select Resources to Farm">
       <incoming>SequenceFlow1</incoming>
       <outgoing>SequenceFlow2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow2" sourceRef="Task_ResourceSelection" targetRef="ParallelGateway_ResourceSelection"/>

     <parallelGateway id="ParallelGateway_ResourceSelection">
       <incoming>SequenceFlow2</incoming>
       <outgoing>SequenceFlow3-1</outgoing>
       <outgoing>SequenceFlow3-2</outgoing>
     </parallelGateway>

     <!-- Resource Selection Tasks  (up to 10)  -->
     <task id="Task_ResourceSelection1" name="Select Resource 1">
       <incoming>SequenceFlow3-1</incoming>
       <outgoing>SequenceFlow4-1</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow3-1" sourceRef="ParallelGateway_ResourceSelection" targetRef="Task_ResourceSelection1"/>

     <!--  ...  -->

     <parallelGateway id="ParallelGateway_Farming">
       <incoming>SequenceFlow4-1</incoming>
       <!-- Add incoming sequence flows from all resource selection tasks  -->
       <outgoing>SequenceFlow5</outgoing>
     </parallelGateway>

     <sequenceFlow id="SequenceFlow4-1" sourceRef="Task_ResourceSelection1" targetRef="ParallelGateway_Farming"/>

     <sequenceFlow id="SequenceFlow5" sourceRef="ParallelGateway_Farming" targetRef="Task_StartFarming"/>

     <task id="Task_StartFarming" name="Start Farming Bot">
       <incoming>SequenceFlow5</incoming>
       <outgoing>SequenceFlow6</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow6" sourceRef="Task_StartFarming" targetRef="IntermediateCatchEvent_NaturalDisaster"/>

     <intermediateCatchEvent id="IntermediateCatchEvent_NaturalDisaster">
       <incoming>SequenceFlow6</incoming>
       <outgoing>SequenceFlow7</outgoing>
     </intermediateCatchEvent>

     <sequenceFlow id="SequenceFlow7" sourceRef="IntermediateCatchEvent_NaturalDisaster" targetRef="Task_UpdateResources"/>

     <task id="Task_UpdateResources" name="Update Resources to Farm">
       <incoming>SequenceFlow7</incoming>
       <outgoing>SequenceFlow8</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow8" sourceRef="Task_UpdateResources" targetRef="ParallelGateway_Farming"/>

     <!-- Milestone notification  -->
     <intermediateThrowEvent id="IntermediateThrowEvent_Milestone">
       <incoming>SequenceFlow6</incoming>
     </intermediateThrowEvent>

     <!-- Brag to friends and/ share materials  -->
     <task id="Task_BragAndShare" name="Brag to Friends and Share Materials">
       <incoming>SequenceFlow9</incoming>
     </task>

     <endEvent id="EndEvent1">
       <incoming>SequenceFlow10</incoming>
     </endEvent>

   </process>

</definitions>