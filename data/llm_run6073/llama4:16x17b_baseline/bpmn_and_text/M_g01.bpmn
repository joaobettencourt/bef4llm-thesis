<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definitions" name="Instruct Artist and 3D Print Model">

   <process id="InstructArtistAndPrintModel" isExecutable="true">
     <startEvent id="StartEvent1">
       <outgoing>SequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow1" sourceRef="StartEvent1" targetRef="Task_InstructArtist"/>

     <task id="Task_InstructArtist" name="Instruct Artist to Create 3D Model">
       <incoming>SequenceFlow1</incoming>
       <outgoing>SequenceFlow2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow2" sourceRef="Task_InstructArtist" targetRef="ExclusiveGateway1"/>

     <exclusiveGateway id="ExclusiveGateway1">
       <incoming>SequenceFlow2</incoming>
       <outgoing>SequenceFlow3</outgoing>
       <outgoing>SequenceFlow4</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow3" sourceRef="ExclusiveGateway1" targetRef="Task_CheckColorAvailability">
       <!--<conditionExpression xsi:type="tFormalExpression">${hasColorAtHome  == true}</conditionExpression>-->
     </sequenceFlow>

     <task id="Task_CheckColorAvailability" name="Check Color Availability at Home">
       <incoming>SequenceFlow3</incoming>
       <outgoing>SequenceFlow5</outgoing>
       <outgoing>SequenceFlow6</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow5" sourceRef="Task_CheckColorAvailability" targetRef="Task_AddToShoppingList">
       <!--<conditionExpression xsi:type="tFormalExpression">${colorQuantity  < 100}</conditionExpression>-->
     </sequenceFlow>

     <task id="Task_AddToShoppingList" name="Add Color to Shopping List">
       <incoming>SequenceFlow5</incoming>
       <outgoing>SequenceFlow7</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow7" sourceRef="Task_AddToShoppingList" targetRef="Task_ReceiveColor"/>

     <task id="Task_ReceiveColor" name="Receive Color">
       <incoming>SequenceFlow7</incoming>
       <outgoing>SequenceFlow8</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow8" sourceRef="Task_ReceiveColor" targetRef="Service_Prepare3DPrinter"/>

     <serviceTask id="Service_Prepare3DPrinter" name="Prepare 3D Printer">
       <incoming>SequenceFlow8</incoming>
       <outgoing>SequenceFlow9</outgoing>
     </serviceTask>

     <sequenceFlow id="SequenceFlow9" sourceRef="Service_Prepare3DPrinter" targetRef="Task_GenerateGcodeFile"/>

     <task id="Task_GenerateGcodeFile" name="Generate G-Code File">
       <incoming>SequenceFlow9</incoming>
       <outgoing>SequenceFlow10</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow10" sourceRef="Task_GenerateGcodeFile" targetRef="Task_Print3DModel"/>

     <task id="Task_Print3DModel" name="Print 3D Model">
       <incoming>SequenceFlow10</incoming>
       <outgoing>SequenceFlow11</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow11" sourceRef="Task_Print3DModel" targetRef="EndEvent1"/>

     <endEvent id="EndEvent1">
       <incoming>SequenceFlow11</incoming>
     </endEvent>

     <sequenceFlow id="SequenceFlow4" sourceRef="ExclusiveGateway1" targetRef="Task_ReceiveColorFromSupplier">
       <!--<conditionExpression xsi:type="tFormalExpression">${hasColorAtHome  == false}</conditionExpression>-->
     </sequenceFlow>

     <task id="Task_ReceiveColorFromSupplier" name="Receive Color From Supplier">
       <incoming>SequenceFlow4</incoming>
       <outgoing>SequenceFlow12</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow12" sourceRef="Task_ReceiveColorFromSupplier" targetRef="Service_Prepare3DPrinter"/>
   </process>
</definitions>