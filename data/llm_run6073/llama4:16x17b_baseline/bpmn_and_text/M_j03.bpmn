<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definition" name="Contract Process">
  <process id="ContractProcess" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_Query_Web_Shops"/>
    <task id="Task_Query_Web_Shops" name="Query Web Shops for Parts">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_Query_Web_Shops" targetRef="ExclusiveGateway_1"/>
    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
      <outgoing>SequenceFlow_4</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_1" targetRef="Task_Order_Parts">
      <conditionExpression xsi:type="tFormalExpression">${cheapestSupplierFound}</conditionExpression>
    </sequenceFlow>
    <task id="Task_Order_Parts" name="Order Parts from Cheapest Supplier">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_5</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_5" sourceRef="Task_Order_Parts" targetRef="Event_Parts_Arrive"/>
    <event id="Event_Parts_Arrive" name="Parts Arrive">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </event>
    <sequenceFlow id="SequenceFlow_6" sourceRef="Event_Parts_Arrive" targetRef="Task_Start_Building"/>
    <task id="Task_Start_Building" name="Start Building">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_7</outgoing>
      <outgoing>SequenceFlow_8</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_7" sourceRef="Task_Start_Building" targetRef="Gateway_Check_Stock_Level"/>
    <exclusiveGateway id="Gateway_Check_Stock_Level">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_9</outgoing>
      <outgoing>SequenceFlow_10</outgoing>
      <outgoing>SequenceFlow_11</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_8" sourceRef="Task_Start_Building" targetRef="EndEvent_1"/>
    <endEvent id="EndEvent_1">
      <incoming>SequenceFlow_8</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_9" sourceRef="Gateway_Check_Stock_Level" targetRef="Task_Reorder_Cheapest_Parts">
      <conditionExpression xsi:type="tFormalExpression">${stockLevel &lt; 5}</conditionExpression>
    </sequenceFlow>
    <task id="Task_Reorder_Cheapest_Parts" name="Reorder Cheapest Parts">
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_12</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_12" sourceRef="Task_Reorder_Cheapest_Parts" targetRef="Gateway_Check_Stock_Level"/>
    <sequenceFlow id="SequenceFlow_10" sourceRef="Gateway_Check_Stock_Level" targetRef="Task_Reorder_Fastest_Parts">
      <conditionExpression xsi:type="tFormalExpression">${stockLevel &lt; 3}</conditionExpression>
    </sequenceFlow>
    <task id="Task_Reorder_Fastest_Parts" name="Reorder Fastest Parts">
      <incoming>SequenceFlow_10</incoming>
      <outgoing>SequenceFlow_13</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_13" sourceRef="Task_Reorder_Fastest_Parts" targetRef="Gateway_Check_Stock_Level"/>
    <sequenceFlow id="SequenceFlow_11" sourceRef="Gateway_Check_Stock_Level" targetRef="Task_Send_Complaint_Email">
      <conditionExpression xsi:type="tFormalExpression">${stockLevel == 0}</conditionExpression>
    </sequenceFlow>
    <task id="Task_Send_Complaint_Email" name="Send Complaint Email to Friends">
      <incoming>SequenceFlow_11</incoming>
      <outgoing>SequenceFlow_14</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_14" sourceRef="Task_Send_Complaint_Email" targetRef="EndEvent_2"/>
    <endEvent id="EndEvent_2">
      <incoming>SequenceFlow_14</incoming>
    </endEvent>
  </process>
</definitions>