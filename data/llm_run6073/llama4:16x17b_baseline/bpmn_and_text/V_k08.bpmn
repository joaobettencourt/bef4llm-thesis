<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definitions" name="Ordering in an Online Shop" targetNamespace="http://example.com">

   <process id="orderingProcess" isExecutable="true">
     <startEvent id="loginStart">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="loginStart" targetRef="loginTask"/>

     <task id="loginTask" name="Login to E-Shop System">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
       <outgoing>SequenceFlow_3</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_2" sourceRef="loginTask" targetRef="productSelectionGateway"/>

     <exclusiveGateway id="productSelectionGateway">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_4</outgoing>
       <outgoing>SequenceFlow_5</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_4" sourceRef="productSelectionGateway" targetRef="selectProductTask"/>

     <task id="selectProductTask" name="Select Product">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_6" sourceRef="selectProductTask" targetRef="addToCartTask"/>

     <task id="addToCartTask" name="Add Product to Shopping Cart">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_7</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_7" sourceRef="addToCartTask" targetRef="allProductsSelectedGateway"/>

     <exclusiveGateway id="allProductsSelectedGateway">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_8</outgoing>
       <outgoing>SequenceFlow_9</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_8" sourceRef="allProductsSelectedGateway" targetRef="preparePaymentAndShipmentTask"/>

     <task id="preparePaymentAndShipmentTask" name="Prepare Payment and Shipment">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_10</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_10" sourceRef="preparePaymentAndShipmentTask" targetRef="enterPaymentDataTask"/>

     <task id="enterPaymentDataTask" name="Enter Payment Data">
       <incoming>SequenceFlow_10</incoming>
       <outgoing>SequenceFlow_11</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_11" sourceRef="enterPaymentDataTask" targetRef="paymentConfirmationGateway"/>

     <eventGateway id="paymentConfirmationGateway">
       <incoming>SequenceFlow_11</incoming>
       <outgoing>SequenceFlow_12</outgoing>
       <outgoing>SequenceFlow_13</outgoing>
     </eventGateway>

     <sequenceFlow id="SequenceFlow_12" sourceRef="paymentConfirmationGateway" targetRef="enterShippingAddressTask"/>

     <task id="enterShippingAddressTask" name="Enter Shipping Address">
       <incoming>SequenceFlow_12</incoming>
       <outgoing>SequenceFlow_14</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_14" sourceRef="enterShippingAddressTask" targetRef="orderFinishedEndEvent"/>

     <endEvent id="orderFinishedEndEvent">
       <incoming>SequenceFlow_14</incoming>
     </endEvent>

     <sequenceFlow id="SequenceFlow_5" sourceRef="productSelectionGateway" targetRef="loginEndEvent"/>

     <endEvent id="loginEndEvent">
       <incoming>SequenceFlow_5</incoming>
     </endEvent>

     <sequenceFlow id="SequenceFlow_3" sourceRef="loginTask" targetRef="loginFailedEndEvent"/>

     <endEvent id="loginFailedEndEvent">
       <incoming>SequenceFlow_3</incoming>
     </endEvent>

     <sequenceFlow id="SequenceFlow_9" sourceRef="allProductsSelectedGateway" targetRef="selectProductTask"/>
   </process>
 </definitions>