<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definition" name="Chainsaw Production Process" targetNamespace="http://example.com">

   <process id="ChainsawProductionProcess" isExecutable="true">
     <startEvent id="StartEvent1">
       <outgoing>SequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow1" sourceRef="StartEvent1" targetRef="Task1"/>

     <task id="Task1" name="Receive Customer Order">
       <incoming>SequenceFlow1</incoming>
       <outgoing>SequenceFlow2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow2" sourceRef="Task1" targetRef="ParallelGateway1"/>

     <parallelGateway id="ParallelGateway1">
       <incoming>SequenceFlow2</incoming>
       <outgoing>SequenceFlow3</outgoing>
       <outgoing>SequenceFlow4</outgoing>
       <outgoing>SequenceFlow5</outgoing>
       <outgoing>SequenceFlow6</outgoing>
     </parallelGateway>

     <sequenceFlow id="SequenceFlow3" sourceRef="ParallelGateway1" targetRef="Task2"/>

     <task id="Task2" name="Order Guide Bar">
       <incoming>SequenceFlow3</incoming>
       <outgoing>SequenceFlow7</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow7" sourceRef="Task2" targetRef="Task6"/>

     <sequenceFlow id="SequenceFlow4" sourceRef="ParallelGateway1" targetRef="Task3"/>

     <task id="Task3" name="Order Chain">
       <incoming>SequenceFlow4</incoming>
       <outgoing>SequenceFlow8</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow8" sourceRef="Task3" targetRef="Task6"/>

     <sequenceFlow id="SequenceFlow5" sourceRef="ParallelGateway1" targetRef="Task4"/>

     <task id="Task4" name="Order Motor">
       <incoming>SequenceFlow5</incoming>
       <outgoing>SequenceFlow9</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow9" sourceRef="Task4" targetRef="Task6"/>

     <sequenceFlow id="SequenceFlow6" sourceRef="ParallelGateway1" targetRef="Task5"/>

     <task id="Task5" name="Order Accessories">
       <incoming>SequenceFlow6</incoming>
       <outgoing>SequenceFlow10</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow10" sourceRef="Task5" targetRef="Task6"/>

     <task id="Task6" name="Inspect Parts">
       <incoming>SequenceFlow7</incoming>
       <incoming>SequenceFlow8</incoming>
       <incoming>SequenceFlow9</incoming>
       <incoming>SequenceFlow10</incoming>
       <outgoing>SequenceFlow11</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow11" sourceRef="Task6" targetRef="Task7"/>

     <task id="Task7" name="Assemble Chainsaw">
       <incoming>SequenceFlow11</incoming>
       <outgoing>SequenceFlow12</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow12" sourceRef="Task7" targetRef="Task8"/>

     <task id="Task8" name="Send Update to Customer">
       <incoming>SequenceFlow12</incoming>
       <outgoing>SequenceFlow13</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow13" sourceRef="Task8" targetRef="ExclusiveGateway1"/>

     <exclusiveGateway id="ExclusiveGateway1">
       <incoming>SequenceFlow13</incoming>
       <outgoing>SequenceFlow14</outgoing>
       <outgoing>SequenceFlow15</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow14" sourceRef="ExclusiveGateway1" targetRef="Task9">
       <!-- ${approval  ==  'positive'} -->
     </sequenceFlow>

     <task id="Task9" name="Produce Additional Chainsaws">
       <incoming>SequenceFlow14</incoming>
       <outgoing>SequenceFlow16</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow16" sourceRef="Task9" targetRef="EndEvent1"/>

     <endEvent id="EndEvent1">
       <incoming>SequenceFlow16</incoming>
     </endEvent>

     <sequenceFlow id="SequenceFlow15" sourceRef="ExclusiveGateway1" targetRef="EndEvent2">
       <!-- ${approval  ==  'negative'} -->
     </sequenceFlow>

     <endEvent id="EndEvent2">
       <incoming>SequenceFlow15</incoming>
     </endEvent>

   </process>

</definitions>