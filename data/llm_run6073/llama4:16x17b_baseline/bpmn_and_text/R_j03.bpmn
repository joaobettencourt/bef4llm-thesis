<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definitions" name="Fridge Service Process"
             targetNamespace="http://example.com/bpmn">

  <process id="FridgeServiceProcess" isExecutable="true">
    <startEvent id="StartEvent1">
      <outgoing>SequenceFlow1</outgoing>
    </startEvent>

    <sequenceFlow id="SequenceFlow1" sourceRef="StartEvent1" targetRef="Task1"/>

    <task id="Task1" name="Describe Symptoms and Send to Service Center">
      <incoming>SequenceFlow1</incoming>
      <outgoing>SequenceFlow2</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow2" sourceRef="Task1" targetRef="ServiceCenterTask"/>

    <serviceTask id="ServiceCenterTask" name="Select Local Service Facility">
      <incoming>SequenceFlow2</incoming>
      <outgoing>SequenceFlow3</outgoing>
    </serviceTask>

    <sequenceFlow id="SequenceFlow3" sourceRef="ServiceCenterTask" targetRef="ExclusiveGateway1"/>

    <exclusiveGateway id="ExclusiveGateway1">
      <incoming>SequenceFlow3</incoming>
      <outgoing>SequenceFlow4</outgoing>
      <outgoing>SequenceFlow5</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow4" sourceRef="ExclusiveGateway1" targetRef="Task2">
      <conditionExpression xsi:type="tFormalExpression">${partsNeeded == false}</conditionExpression>
    </sequenceFlow>

    <task id="Task2" name="Make Appointment and Repair Fridge">
      <incoming>SequenceFlow4</incoming>
      <outgoing>SequenceFlow6</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow6" sourceRef="Task2" targetRef="Task3"/>

    <task id="Task3" name="Confirm Repair and Rate Service Facility">
      <incoming>SequenceFlow6</incoming>
      <outgoing>SequenceFlow7</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow7" sourceRef="Task3" targetRef="EndEvent1"/>

    <endEvent id="EndEvent1">
      <incoming>SequenceFlow7</incoming>
    </endEvent>

    <sequenceFlow id="SequenceFlow5" sourceRef="ExclusiveGateway1" targetRef="Task4">
      <conditionExpression xsi:type="tFormalExpression">${partsNeeded == true}</conditionExpression>
    </sequenceFlow>

    <task id="Task4" name="Notify Customer and Reschedule Appointment">
      <incoming>SequenceFlow5</incoming>
      <outgoing>SequenceFlow8</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow8" sourceRef="Task4" targetRef="Task2"/>
  </process>
</definitions>