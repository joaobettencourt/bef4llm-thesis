<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">

  <process id="bag_collection_process" isExecutable="true">
    <startEvent id="not_collected_bag_identified">
      <outgoing>sequence_flow_1</outgoing>
    </startEvent>

    <sequenceFlow id="sequence_flow_1" sourceRef="not_collected_bag_identified" targetRef="check_retry_count"/>

    <task id="check_retry_count" name="Check number of resolution retries conducted">
      <incoming>sequence_flow_1</incoming>
      <outgoing>sequence_flow_2</outgoing>
    </task>

    <exclusiveGateway id="retry_count_gateway">
      <incoming>sequence_flow_2</incoming>
      <outgoing>sequence_flow_3</outgoing>
      <outgoing>sequence_flow_4</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequence_flow_2" sourceRef="check_retry_count" targetRef="retry_count_gateway">
      <conditionExpression xsi:type="tFormalExpression">retryCount > maxRetriesAllowed</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="sequence_flow_3" sourceRef="retry_count_gateway" targetRef="return_to_production_area">
      <conditionExpression xsi:type="tFormalExpression">true</conditionExpression>
    </sequenceFlow>

    <task id="return_to_production_area" name="Return bag to production area for disassemble">
      <incoming>sequence_flow_3</incoming>
      <outgoing>sequence_flow_5</outgoing>
    </task>

    <sequenceFlow id="sequence_flow_4" sourceRef="retry_count_gateway" targetRef="contact_customer"/>

    <task id="contact_customer" name="Try to contact customer by phone and remind to pick up the bag">
      <incoming>sequence_flow_4</incoming>
      <outgoing>sequence_flow_6</outgoing>
      <outgoing>sequence_flow_7</outgoing>
    </task>

    <exclusiveGateway id="contact_result_gateway">
      <incoming>sequence_flow_6</incoming>
      <outgoing>sequence_flow_8</outgoing>
      <outgoing>sequence_flow_9</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequence_flow_6" sourceRef="contact_customer" targetRef="contact_result_gateway">
      <conditionExpression xsi:type="tFormalExpression">contactSuccessful AND customerWithdrawnOrder</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="sequence_flow_7" sourceRef="contact_customer" targetRef="contact_result_gateway">
      <conditionExpression xsi:type="tFormalExpression">contactSuccessful AND customerPromisesToPickUp OR contactUnsuccessful</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="sequence_flow_8" sourceRef="contact_result_gateway" targetRef="return_to_production_area"/>

    <task id="increase_retry_count" name="Increase retry count on the bag label">
      <incoming>sequence_flow_9</incoming>
      <outgoing>sequence_flow_10</outgoing>
    </task>

    <sequenceFlow id="sequence_flow_9" sourceRef="contact_result_gateway" targetRef="increase_retry_count"/>

    <sequenceFlow id="sequence_flow_10" sourceRef="increase_retry_count" targetRef="end_event"/>

    <sequenceFlow id="sequence_flow_5" sourceRef="return_to_production_area" targetRef="end_event"/>

    <endEvent id="end_event">
      <incoming>sequence_flow_5</incoming>
      <incoming>sequence_flow_10</incoming>
    </endEvent>

  </process>

</definitions>