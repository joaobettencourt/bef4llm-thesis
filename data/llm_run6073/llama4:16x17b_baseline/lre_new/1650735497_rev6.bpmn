<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">

   <process id="BankAccountLinkingProcess" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>sf1</outgoing>
     </startEvent>

     <sequenceFlow id="sf1" sourceRef="StartEvent_1" targetRef="Task_EnterBankDetails"/>

     <task id="Task_EnterBankDetails" name="Enter bank details">
       <incoming>sf1</incoming>
       <outgoing>sf2</outgoing>
     </task>

     <sequenceFlow id="sf2" sourceRef="Task_EnterBankDetails" targetRef="ServiceTask_SubmitBankDetails"/>

     <serviceTask id="ServiceTask_SubmitBankDetails" name="Submit bank details to PayPal system">
       <incoming>sf2</incoming>
       <outgoing>sf3</outgoing>
     </serviceTask>

     <sequenceFlow id="sf3" sourceRef="ServiceTask_SubmitBankDetails" targetRef="IntermediateEvent_DepositsMade"/>

     <intermediateEvent id="IntermediateEvent_DepositsMade">
       <incoming>sf3</incoming>
       <outgoing>sf4</outgoing>
     </intermediateEvent>

     <sequenceFlow id="sf4" sourceRef="IntermediateEvent_DepositsMade" targetRef="Task_NotifyClientCheckAccount"/>

     <task id="Task_NotifyClientCheckAccount" name="Notify client to check bank account for deposits">
       <incoming>sf4</incoming>
       <outgoing>sf5</outgoing>
     </task>

     <sequenceFlow id="sf5" sourceRef="Task_NotifyClientCheckAccount" targetRef="ExclusiveGateway_1"/>

     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>sf5</incoming>
       <outgoing>sf6</outgoing>
       <outgoing>sf7</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sf6" sourceRef="ExclusiveGateway_1" targetRef="Task_EnterDepositAmounts"/>

     <task id="Task_EnterDepositAmounts" name="Enter deposit amounts and verify">
       <incoming>sf6</incoming>
       <outgoing>sf8</outgoing>
     </task>

     <sequenceFlow id="sf8" sourceRef="Task_EnterDepositAmounts" targetRef="ExclusiveGateway_2"/>

     <exclusiveGateway id="ExclusiveGateway_2">
       <incoming>sf8</incoming>
       <outgoing>sf9</outgoing>
       <outgoing>sf10</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sf9" sourceRef="ExclusiveGateway_2" targetRef="EndEvent_Confirmed">
       <conditionExpression xsi:type="tFormalExpression">values match</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="sf10" sourceRef="ExclusiveGateway_2" targetRef="EndEvent_NotConfirmed">
       <conditionExpression xsi:type="tFormalExpression">values do not match</conditionExpression>
     </sequenceFlow>

     <endEvent id="EndEvent_Confirmed">
       <incoming>sf9</incoming>
     </endEvent>

     <endEvent id="EndEvent_NotConfirmed">
       <incoming>sf10</incoming>
     </endEvent>

   </process>

</definitions>