<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">

   <process id="WebDesignProcess" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="ExclusiveGateway_1"/>

     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
       <outgoing>SequenceFlow_3</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_2" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_1">
       <conditionExpression xsi:type="tFormalExpression">meetingNotSuccessful</conditionExpression>
     </sequenceFlow>

     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_2</incoming>
     </endEvent>

     <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_1" targetRef="CreateStoryboard">
       <conditionExpression xsi:type="tFormalExpression">meetingSuccessful</conditionExpression>
     </sequenceFlow>

     <task id="CreateStoryboard">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_4</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_4" sourceRef="CreateStoryboard" targetRef="AgreementOnStoryboard"/>

     <event id="AgreementOnStoryboard">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </event>

     <parallelGateway id="ParallelGateway_1">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_6</outgoing>
       <outgoing>SequenceFlow_7</outgoing>
     </parallelGateway>

     <sequenceFlow id="SequenceFlow_5" sourceRef="AgreementOnStoryboard" targetRef="ParallelGateway_1"/>

     <task id="DesignAndDevelopment">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_8</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_6" sourceRef="ParallelGateway_1" targetRef="DesignAndDevelopment"/>

     <task id="PrepareInitialDraftContent">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_7" sourceRef="ParallelGateway_1" targetRef="PrepareInitialDraftContent"/>

     <exclusiveGateway id="ExclusiveGateway_2">
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_10</outgoing>
       <outgoing>SequenceFlow_11</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_9" sourceRef="PrepareInitialDraftContent" targetRef="ExclusiveGateway_2"/>

     <task id="ReviewDraftContent">
       <incoming>SequenceFlow_10</incoming>
       <outgoing>SequenceFlow_12</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_10" sourceRef="ExclusiveGateway_2" targetRef="ReviewDraftContent">
       <conditionExpression xsi:type="tFormalExpression">reviewNeeded</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="SequenceFlow_11" sourceRef="ExclusiveGateway_2" targetRef="CreateFinalVersionContent">
       <conditionExpression xsi:type="tFormalExpression">noReviewNeeded</conditionExpression>
     </sequenceFlow>

     <task id="CreateFinalVersionContent">
       <incoming>SequenceFlow_11</incoming>
       <outgoing>SequenceFlow_12</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_12" sourceRef="ReviewDraftContent" targetRef="BuildWebsite"/>
     <sequenceFlow id="SequenceFlow_13" sourceRef="CreateFinalVersionContent" targetRef="BuildWebsite"/>

     <task id="BuildWebsite">
       <incoming>SequenceFlow_12</incoming>
       <incoming>SequenceFlow_13</incoming>
       <outgoing>SequenceFlow_14</outgoing>
     </task>

     <exclusiveGateway id="ExclusiveGateway_3">
       <incoming>SequenceFlow_14</incoming>
       <outgoing>SequenceFlow_15</outgoing>
       <outgoing>SequenceFlow_16</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_14" sourceRef="BuildWebsite" targetRef="ExclusiveGateway_3"/>

     <endEvent id="EndEvent_2">
       <incoming>SequenceFlow_15</incoming>
     </endEvent>

     <sequenceFlow id="SequenceFlow_15" sourceRef="ExclusiveGateway_3" targetRef="EndEvent_2">
       <conditionExpression xsi:type="tFormalExpression">siteApproved</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="SequenceFlow_16" sourceRef="ExclusiveGateway_3" targetRef="BuildWebsite">
       <conditionExpression xsi:type="tFormalExpression">siteNotApproved</conditionExpression>
     </sequenceFlow>

   </process>

</definitions>