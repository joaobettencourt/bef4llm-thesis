<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">

  <process id="Process_1" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>

    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>

    <task id="Task_1" name="Perform market analysis and prepare portfolio presentation">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="Task_2"/>

    <task id="Task_2" name="Send out offers to potential clients and inform management about responses">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_3" sourceRef="Task_2" targetRef="Task_3"/>

    <task id="Task_3" name="Send out detailed offer to client and negotiate">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>ExclusiveGateway_1</outgoing>
    </task>

    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_5</outgoing>
      <outgoing>SequenceFlow_6</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow_4" sourceRef="Task_3" targetRef="ExclusiveGateway_1"/>

    <sequenceFlow id="SequenceFlow_5" name="Client accepts offer" sourceRef="ExclusiveGateway_1" targetRef="Task_4">
      <conditionExpression xsi:type="tFormalExpression">clientResponse == 'accept'</conditionExpression>
    </sequenceFlow>

    <task id="Task_4" name="Prepare contract and get it signed">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_7" sourceRef="Task_4" targetRef="EndEvent_1"/>

    <sequenceFlow id="SequenceFlow_6" name="Client rejects offer" sourceRef="ExclusiveGateway_1" targetRef="Task_5">
      <conditionExpression xsi:type="tFormalExpression">clientResponse == 'reject'</conditionExpression>
    </sequenceFlow>

    <task id="Task_5" name="Analyze reason for failed offer and improve for future">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_8" sourceRef="Task_5" targetRef="EndEvent_1"/>

    <endEvent id="EndEvent_1">
      <incoming>SequenceFlow_7</incoming>
      <incoming>SequenceFlow_8</incoming>
    </endEvent>

  </process>

</definitions>