<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">

  <process id="RewardAndTrainingProcess" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>

    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>

    <task id="Task_1" name="Check employee performance">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="ExclusiveGateway_1"/>

    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
      <outgoing>SequenceFlow_4</outgoing>
      <outgoing>SequenceFlow_5</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_1" targetRef="Task_2">
      <conditionExpression xsi:type="tFormalExpression">performance  &lt; 20%</conditionExpression>
    </sequenceFlow>

    <task id="Task_2" name="Suggest dismissal to HR">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_6" sourceRef="Task_2" targetRef="Task_3"/>

    <task id="Task_3" name="Dismiss employee">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_7" sourceRef="Task_3" targetRef="EndEvent_1"/>

    <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_1" targetRef="Task_4">
      <conditionExpression xsi:type="tFormalExpression">20% &lt;= performance  &lt; 50%</conditionExpression>
    </sequenceFlow>

    <task id="Task_4" name="Suggest training to HR">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_8" sourceRef="Task_4" targetRef="Task_5"/>

    <task id="Task_5" name="Provide training">
      <incoming>SequenceFlow_8</incoming>
      <outgoing>SequenceFlow_9</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_9" sourceRef="Task_5" targetRef="EndEvent_1"/>

    <sequenceFlow id="SequenceFlow_5" sourceRef="ExclusiveGateway_1" targetRef="Task_6">
      <conditionExpression xsi:type="tFormalExpression">performance  &gt; 75%</conditionExpression>
    </sequenceFlow>

    <task id="Task_6" name="Suggest reward to management">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_10</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_10" sourceRef="Task_6" targetRef="ExclusiveGateway_2"/>

    <exclusiveGateway id="ExclusiveGateway_2">
      <incoming>SequenceFlow_10</incoming>
      <outgoing>SequenceFlow_11</outgoing>
      <outgoing>SequenceFlow_12</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow_11" sourceRef="ExclusiveGateway_2" targetRef="Task_7">
      <conditionExpression xsi:type="tFormalExpression">reward type  == 'financial'</conditionExpression>
    </sequenceFlow>

    <task id="Task_7" name="Calculate and pay financial reward">
      <incoming>SequenceFlow_11</incoming>
      <outgoing>SequenceFlow_13</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_12" sourceRef="ExclusiveGateway_2" targetRef="Task_8">
      <conditionExpression xsi:type="tFormalExpression">reward type  == 'other benefit'</conditionExpression>
    </sequenceFlow>

    <task id="Task_8" name="Choose appropriate benefit">
      <incoming>SequenceFlow_12</incoming>
      <outgoing>SequenceFlow_13</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_13" sourceRef="Task_7" targetRef="Task_9"/>
    <sequenceFlow id="SequenceFlow_14" sourceRef="Task_8" targetRef="Task_9"/>

    <task id="Task_9" name="Announce rewarded employee as employee of the month">
      <incoming>SequenceFlow_13</incoming>
      <incoming>SequenceFlow_14</incoming>
      <outgoing>SequenceFlow_15</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_15" sourceRef="Task_9" targetRef="EndEvent_1"/>

    <endEvent id="EndEvent_1">
      <incoming>SequenceFlow_7</incoming>
      <incoming>SequenceFlow_9</incoming>
      <incoming>SequenceFlow_15</incoming>
    </endEvent>

  </process>

</definitions>