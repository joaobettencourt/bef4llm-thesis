<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Goods Shipment Process" targetNamespace="http://example.com/bpmn">

  <process id="goodsShipmentProcess" isExecutable="true">
    <startEvent id="startEvent1">
      <outgoing>sequenceFlow1</outgoing>
    </startEvent>

    <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="exclusiveGateway1"/>

    <exclusiveGateway id="exclusiveGateway1">
      <incoming>sequenceFlow1</incoming>
      <outgoing>sequenceFlow2</outgoing>
      <outgoing>sequenceFlow3</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequenceFlow2" name="Large Amounts" sourceRef="exclusiveGateway1" targetRef="task1">
      <conditionExpression xsi:type="tFormalExpression">${amount > 100}</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="sequenceFlow3" name="Small Amounts" sourceRef="exclusiveGateway1" targetRef="task2"/>

    <task id="task1">
      <incoming>sequenceFlow2</incoming>
      <outgoing>sequenceFlow4</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow4" sourceRef="task1" targetRef="parallelGateway1"/>

    <task id="task2">
      <incoming>sequenceFlow3</incoming>
      <outgoing>sequenceFlow5</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow5" sourceRef="task2" targetRef="inclusiveGateway1"/>

    <parallelGateway id="parallelGateway1">
      <incoming>sequenceFlow4</incoming>
      <outgoing>sequenceFlow6</outgoing>
      <outgoing>sequenceFlow7</outgoing>
    </parallelGateway>

    <task id="task3">
      <incoming>sequenceFlow6</incoming>
      <outgoing>sequenceFlow8</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow6" sourceRef="parallelGateway1" targetRef="task3"/>

    <task id="task4">
      <incoming>sequenceFlow7</incoming>
      <outgoing>sequenceFlow9</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow7" sourceRef="parallelGateway1" targetRef="task4"/>

    <inclusiveGateway id="inclusiveGateway1">
      <incoming>sequenceFlow5</incoming>
      <outgoing>sequenceFlow10</outgoing>
    </inclusiveGateway>

    <sequenceFlow id="sequenceFlow10" sourceRef="inclusiveGateway1" targetRef="exclusiveGateway2"/>

    <exclusiveGateway id="exclusiveGateway2">
      <incoming>sequenceFlow10</incoming>
      <outgoing>sequenceFlow11</outgoing>
      <outgoing>sequenceFlow12</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequenceFlow11" sourceRef="exclusiveGateway2" targetRef="task5"/>

    <sequenceFlow id="sequenceFlow12" name="Insurance Necessary" sourceRef="exclusiveGateway2" targetRef="task6">
      <conditionExpression xsi:type="tFormalExpression">${insuranceNecessary == true}</conditionExpression>
    </sequenceFlow>

    <task id="task5">
      <incoming>sequenceFlow11</incoming>
      <outgoing>sequenceFlow13</outgoing>
    </task>

    <task id="task6">
      <incoming>sequenceFlow12</incoming>
      <outgoing>sequenceFlow14</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow13" sourceRef="task5" targetRef="endEvent1"/>

    <sequenceFlow id="sequenceFlow14" sourceRef="task6" targetRef="endEvent1"/>

    <endEvent id="endEvent1">
      <incoming>sequenceFlow13</incoming>
      <incoming>sequenceFlow14</incoming>
    </endEvent>

  </process>
</definitions>