<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Restaurant Process" targetNamespace="http://example.com/restaurant">

   <process id="restaurantProcess" isExecutable="true">
     <startEvent id="guestEnters" name="Guest Enters Restaurant">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="guestEnters" targetRef="chooseDish"/>

     <task id="chooseDishTask" name="Choose Dish from Menu">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow2" sourceRef="chooseDishTask" targetRef="waitForTurnTask"/>

     <task id="waitForTurnTask" name="Wait for Turn">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow3" sourceRef="waitForTurnTask" targetRef="placeOrderTask"/>

     <task id="placeOrderTask" name="Place Order with Employee">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow4</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow4" sourceRef="placeOrderTask" targetRef="employeeCollectsMoneyTask"/>

     <task id="employeeCollectsMoneyTask" name="Employee Collects Money">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow5</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow5" sourceRef="employeeCollectsMoneyTask" targetRef="employeeSetsUpBuzzerTask"/>

     <task id="employeeSetsUpBuzzerTask" name="Employee Sets Up Buzzer and Informs Guest">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow6</outgoing>
       <outgoing>sequenceFlow10</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow6" sourceRef="employeeSetsUpBuzzerTask" targetRef="chefPreparesMealTask"/>

     <task id="chefPreparesMealTask" name="Chef Prepares Meal">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow7</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow7" sourceRef="chefPreparesMealTask" targetRef="employeeInformedAboutReadyMealTask"/>

     <task id="employeeInformedAboutReadyMealTask" name="Employee Informed About Ready Meal">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow8</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow8" sourceRef="employeeInformedAboutReadyMealTask" targetRef="employeeRingsBuzzerTask"/>

     <task id="employeeRingsBuzzerTask" name="Employee Rings Buzzer">
       <incoming>sequenceFlow8</incoming>
       <outgoing>sequenceFlow9</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow9" sourceRef="employeeRingsBuzzerTask" targetRef="guestCollectsMealTask"/>

     <task id="guestCollectsMealTask" name="Guest Collects Meal">
       <incoming>sequenceFlow9</incoming>
       <outgoing>sequenceFlow11</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow10" sourceRef="employeeSetsUpBuzzerTask" targetRef="informChefAboutOrderTask"/>

     <task id="informChefAboutOrderTask" name="Employee Informs Chef About Order">
       <incoming>sequenceFlow10</incoming>
     </task>

     <sequenceFlow id="sequenceFlow11" sourceRef="guestCollectsMealTask" targetRef="endEvent"/>

     <endEvent id="endEvent" name="Process Ends">
       <incoming>sequenceFlow11</incoming>
     </endEvent>

   </process>
</definitions>