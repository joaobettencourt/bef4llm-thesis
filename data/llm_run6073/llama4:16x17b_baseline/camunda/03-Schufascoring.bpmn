<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" name="Schufascoring-Process">

  <process id="schufa-scoring-prozess" isExecutable="true">
    <startEvent id="start-event-1">
      <outgoing>sequence-flow-1</outgoing>
    </startEvent>

    <serviceTask id="scoring-anfrage-task">
      <incoming>sequence-flow-1</incoming>
      <outgoing>sequence-flow-2</outgoing>
    </serviceTask>

    <sequenceFlow id="sequence-flow-1" sourceRef="start-event-1" targetRef="scoring-anfrage-task"/>

    <exclusiveGateway id="verzogerung-gateway-1">
      <incoming>sequence-flow-2</incoming>
      <outgoing>sequence-flow-3</outgoing>
      <outgoing>sequence-flow-4</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequence-flow-2" sourceRef="scoring-anfrage-task" targetRef="verzogerung-gateway-1"/>

    <task id="scoring-ergebnis-verzogert-task">
      <incoming>sequence-flow-3</incoming>
      <outgoing>sequence-flow-5</outgoing>
    </task>

    <sequenceFlow id="sequence-flow-3" sourceRef="verzogerung-gateway-1" targetRef="scoring-ergebnis-verzogert-task"/>

    <serviceTask id="level2-scoring-task">
      <incoming>sequence-flow-4</incoming>
      <outgoing>sequence-flow-6</outgoing>
    </serviceTask>

    <sequenceFlow id="sequence-flow-4" sourceRef="verzogerung-gateway-1" targetRef="level2-scoring-task"/>

    <task id="scoring-ergebnis-weiterleiten-task">
      <incoming>sequence-flow-5</incoming>
      <incoming>sequence-flow-6</incoming>
      <outgoing>sequence-flow-7</outgoing>
    </task>

    <sequenceFlow id="sequence-flow-5" sourceRef="scoring-ergebnis-verzogert-task" targetRef="scoring-ergebnis-weiterleiten-task"/>
    <sequenceFlow id="sequence-flow-6" sourceRef="level2-scoring-task" targetRef="scoring-ergebnis-weiterleiten-task"/>

    <endEvent id="prozess-beendet-event">
      <incoming>sequence-flow-7</incoming>
    </endEvent>

    <sequenceFlow id="sequence-flow-7" sourceRef="scoring-ergebnis-weiterleiten-task" targetRef="prozess-beendet-event"/>
  </process>
</definitions>