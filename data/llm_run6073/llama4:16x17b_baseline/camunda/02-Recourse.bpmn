<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Recourse Process" targetNamespace="http://example.com/bpmn">

   <process id="recourseProcess" isExecutable="true">
     <startEvent id="startEvent1">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="taskGetInformation"/>

     <task id="taskGetInformation" name="Get information about possible subrogation">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow2" sourceRef="taskGetInformation" targetRef="exclusiveGateway1"/>

     <exclusiveGateway id="exclusiveGateway1">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
       <outgoing>sequenceFlow4</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow3" name="yes" sourceRef="exclusiveGateway1" targetRef="taskSendRequest"/>

     <sequenceFlow id="sequenceFlow4" name="no" sourceRef="exclusiveGateway1" targetRef="endEventCloseCase1"/>

     <task id="taskSendRequest" name="Send request for payment and create reminder">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow5</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow5" sourceRef="taskSendRequest" targetRef="exclusiveGateway2"/>

     <exclusiveGateway id="exclusiveGateway2">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow6</outgoing>
       <outgoing>sequenceFlow7</outgoing>
       <outgoing>sequenceFlow8</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow6" name="payment received" sourceRef="exclusiveGateway2" targetRef="taskMakeBooking"/>

     <sequenceFlow id="sequenceFlow7" name="insurant disagrees" sourceRef="exclusiveGateway2" targetRef="taskCheckReasoning"/>

     <sequenceFlow id="sequenceFlow8" name="deadline reached" sourceRef="exclusiveGateway2" targetRef="serviceTaskForwardToCollectionAgency1"/>

     <task id="taskMakeBooking" name="Make booking and close case">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow9</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow9" sourceRef="taskMakeBooking" targetRef="endEventCloseCase1"/>

     <task id="taskCheckReasoning" name="Check reasoning of disagreement">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow10</outgoing>
       <outgoing>sequenceFlow11</outgoing>
     </task>

     <exclusiveGateway id="exclusiveGateway3">
       <incoming>sequenceFlow10</incoming>
       <outgoing>sequenceFlow12</outgoing>
       <outgoing>sequenceFlow13</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow10" sourceRef="taskCheckReasoning" targetRef="exclusiveGateway3"/>

     <sequenceFlow id="sequenceFlow11" name="insurant is right" sourceRef="exclusiveGateway3" targetRef="endEventCloseCase1"/>

     <sequenceFlow id="sequenceFlow12" name="insurant is wrong" sourceRef="exclusiveGateway3" targetRef="serviceTaskForwardToCollectionAgency1"/>

     <sequenceFlow id="sequenceFlow13" name="close case" sourceRef="exclusiveGateway3" targetRef="endEventCloseCase1"/>

     <serviceTask id="serviceTaskForwardToCollectionAgency1" name="Forward to collection agency">
       <incoming>sequenceFlow8</incoming>
       <incoming>sequenceFlow12</incoming>
       <outgoing>sequenceFlow14</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlow14" sourceRef="serviceTaskForwardToCollectionAgency1" targetRef="endEventCloseCase1"/>

     <endEvent id="endEventCloseCase1" name="Close case">
       <incoming>sequenceFlow4</incoming>
       <incoming>sequenceFlow9</incoming>
       <incoming>sequenceFlow11</incoming>
       <incoming>sequenceFlow13</incoming>
       <incoming>sequenceFlow14</incoming>
     </endEvent>

   </process>

</definitions>