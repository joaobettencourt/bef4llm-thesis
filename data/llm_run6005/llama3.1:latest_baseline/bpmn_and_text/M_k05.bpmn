    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_14a0oky" sourceRef="StartEvent_1" targetRef="ParallelGateway_02fgrfq" />
    <bpmn:sequenceFlow id="SequenceFlow_1j94oja" name="yes" sourceRef="Task_12j0pib" targetRef="ExclusiveGateway_1mpgzhg" />
    
    <!-- Exclusive Gateway -->
