<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Collect credit information">
      <bpmn:outgoing>SequenceFlow_0kz5g1t</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="ExclusiveGateway_1mpgzhg" name="Is amount greater than 1M$?">
      <bpmn:incoming>SequenceFlow_0kz5g1t</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1j94oja</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_1dlbln9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="SequenceFlow_0kz5g1t" sourceRef="StartEvent_1" targetRef="ExclusiveGateway_1mpgzhg" />
    <bpmn:task id="Task_12j0pib" name="Assess risk of credit">
      <bpmn:incoming>SequenceFlow_1dlbln9</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0mp5byl</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_1j94oja" name="yes" sourceRef="ExclusiveGateway_1mpgzhg" targetRef="Task_12j0pib" />
    <bpmn:exclusiveGateway id="InclusiveGateway_0p2e5vq">
      <bpmn:incoming>SequenceFlow_0mp5byl</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1rss71o</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_1xv6wk4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="SequenceFlow_0mp5byl" sourceRef="Task_12j0pib" targetRef="InclusiveGateway_0p2e5vq" />
    <bpmn:task id="Task_0jsoxba" name="Request approval">
      <bpmn:incoming>SequenceFlow_1rss71o</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0iu9po7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_1rss71o" name="yes" sourceRef="InclusiveGateway_0p2e5vq" targetRef="Task_0jsoxba" />
    <bpmn:endEvent id="EndEvent_1fx9yp3" name="Credit accepted">
      <bpmn:incoming>SequenceFlow_0iu9po7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow_0iu9po7" sourceRef="Task_0jsoxba" targetRef="EndEvent_1fx9yp3" />
    <bpmn:task id="Task_0vaxgaa" name="Credit rejected">
      <bpmn:incoming>SequenceFlow_1xv6wk4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0ajhekx</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_1xv6wk4" name="no" sourceRef="InclusiveGateway_0p2e5vq" targetRef="Task_0vaxgaa" />
    <bpmn:endEvent id="EndEvent_1fx9yp3_1" name="Credit rejected">
      <bpmn:incoming>SequenceFlow_0ajhekx</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow_0ajhekx" sourceRef="Task_0vaxgaa" targetRef="EndEvent_1fx9yp3_1" />
  </bpmn:process>
