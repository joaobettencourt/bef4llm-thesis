<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                   xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                   xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1"
                   targetNamespace="http://bpmn.io/schema/bpmn">
    <bpmn:collaboration id="Collaboration_0geryc1">
        <bpmn:participant id="Participant_0ygkg4f" name="Customer Service TELECO" processRef="Process_1"/>
        <bpmn:participant id="Participant_1jsoxba" name="Service Management" processRef="Process_2"/>
        <bpmn:participant id="Participant_0vaxgaa" name="Resource Provisioning" processRef="Process_3"/>
    </bpmn:collaboration>
    <bpmn:process id="Process_1" isExecutable="false">
        <bpmn:laneSet>
            <bpmn:lane id="Lane_1viot5w" name="Customer Service TELECO">
                <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>Task_12j0pib</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>ExclusiveGateway_0p2e5vq</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>SequenceFlow_1j94oja</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>Task_0jsoxba</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>ExclusiveGateway_1dgb4sg</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>SequenceFlow_0mp5byl</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>Task_05ftug5</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>ExclusiveGateway_1mpgzhg</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>SequenceFlow_0kz5g1t</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>Task_0e6hvnj</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>ExclusiveGateway_1ouv9kf</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>SequenceFlow_035vf60</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>Task_0sl26uo</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>ExclusiveGateway_0z5sib0</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>SequenceFlow_06kfaev</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>EndEvent_1fx9yp3</bpmn:flowNodeRef>
            </bpmn:lane>
        </bpmn:laneSet>
        <bpmn:startEvent id="StartEvent_1" name="Customer perceives service degradation">
            <bpmn:outgoing>SequenceFlow_14a0oky</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:task id="Task_12j0pib" name="Send problem parameters to Customer Service TELECO">
            <bpmn:incoming>SequenceFlow_14a0oky</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_1j94oja</bpmn:outgoing>
        </bpmn:task>
        <bpmn:exclusiveGateway id="ExclusiveGateway_0p2e5vq" name="Is customer premium?">
            <bpmn:incoming>SequenceFlow_1j94oja</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_023hzxi</bpmn:outgoing>
            <bpmn:outgoing>SequenceFlow_1ujhfx4</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:sequenceFlow id="SequenceFlow_14a0oky" sourceRef="StartEvent_1" targetRef="Task_12j0pib"/>
        <bpmn:sequenceFlow id="SequenceFlow_1j94oja" sourceRef="Task_12j0pib" targetRef="ExclusiveGateway_0p2e5vq"/>
        <bpmn:task id="Task_0jsoxba" name="Create problem report">
            <bpmn:incoming>SequenceFlow_023hzxi</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_0mp5byl</bpmn:outgoing>
        </bpmn:task>
        <bpmn:exclusiveGateway id="ExclusiveGateway_1dgb4sg" name="Is customer significant?">
            <bpmn:incoming>SequenceFlow_023hzxi</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_0buzwss</bpmn:outgoing>
            <bpmn:outgoing>SequenceFlow_1xv6wk4</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:sequenceFlow id="SequenceFlow_023hzxi" sourceRef="ExclusiveGateway_0p2e5vq"
                           targetRef="Task_0jsoxba"/>
        <bpmn:task id="Task_05ftug5" name="Determine counter measures">
            <bpmn:incoming>SequenceFlow_1ujhfx4</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_0kz5g1t</bpmn:outgoing>
        </bpmn:task>
        <bpmn:exclusiveGateway id="ExclusiveGateway_1mpgzhg" name="Is problem analyzable by Service Management?">
            <bpmn:incoming>SequenceFlow_0kz5g1t</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_035vf60</bpmn:outgoing>
            <bpmn:outgoing>SequenceFlow_06kfaev</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:sequenceFlow id="SequenceFlow_0kz5g1t" sourceRef="Task_05ftug5"
                           targetRef="ExclusiveGateway_1mpgzhg"/>
        <bpmn:task id="Task_0e6hvnj" name="Create detailed problem report">
            <bpmn:incoming>SequenceFlow_035vf60</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_0v64x8b</bpmn:outgoing>
        </bpmn:task>
        <bpmn:endEvent id="EndEvent_1fx9yp3" name="Problem resolution report created">
            <bpmn:incoming>SequenceFlow_0v64x8b</bpmn:incoming>
        </bpmn:endEvent>
    </bpmn:process>

    <bpmn:process id="Process_2" isExecutable="false">
        <bpmn:laneSet>
            <bpmn:lane id="Lane_1ocseyo" name="Service Management">
                <bpmn:flowNodeRef>Task_0jsoxba</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>ExclusiveGateway_1dgb4sg</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>SequenceFlow_0mp5byl</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>Task_05ftug5</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>ExclusiveGateway_1mpgzhg</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>SequenceFlow_0kz5g1t</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>Task_0e6hvnj</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>ExclusiveGateway_1ouv9kf</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>SequenceFlow_035vf60</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>Task_0sl26uo</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>ExclusiveGateway_0z5sib0</bpmn:flowNodeRef>
            </bpmn:lane>
        </bpmn:laneSet>
        <bpmn:task id="Task_0jsoxba" name="Create problem report">
            <bpmn:incoming>SequenceFlow_023hzxi</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_1j94oja</bpmn:outgoing>
        </bpmn:task>
        <bpmn:exclusiveGateway id="ExclusiveGateway_1dgb4sg" name="Is customer significant?">
            <bpmn:incoming>SequenceFlow_023hzxi</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_0buzwss</bpmn:outgoing>
            <bpmn:outgoing>SequenceFlow_1xv6wk4</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:sequenceFlow id="SequenceFlow_023hzxi" sourceRef="ExclusiveGateway_0p2e5vq"
                           targetRef="Task_0jsoxba"/>
        <bpmn:task id="Task_05ftug5" name="Determine counter measures">
            <bpmn:incoming>SequenceFlow_1ujhfx4</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_0kz5g1t</bpmn:outgoing>
        </bpmn:task>
        <bpmn:endEvent id="EndEvent_2" name="Problem resolution report created">
            <bpmn:incoming>SequenceFlow_0v64x8b</bpmn:incoming>
        </bpmn:endEvent>
    </bpmn:process>

    <bpmn:process id="Process_3" isExecutable="false">
        <bpmn:laneSet>
            <bpmn:lane id="Lane_1vl2igx" name="Resource Provisioning">
                <bpmn:flowNodeRef>Task_0sl26uo</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>ExclusiveGateway_0z5sib0</bpmn:flowNodeRef>
            </bpmn:lane>
        </bpmn:laneSet>
        <bpmn:task id="Task_0sl26uo" name="Create trouble report">
            <bpmn:incoming>SequenceFlow_06kfaev</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_0v64x8b</bpmn:outgoing>
        </bpmn:task>
    </bpmn:process>

    <!-- Message Flows -->
    <bpmn:messageFlow id="MessageFlow_1" sourceRef="Task_0jsoxba" targetRef="Participant_1jsoxba"/>
    <bpmn:messageFlow id="MessageFlow_2" sourceRef="Task_05ftug5" targetRef="Participant_1jsoxba"/>
    <bpmn:messageFlow id="MessageFlow_3" sourceRef="Task_0e6hvnj" targetRef="Participant_1jsoxba"/>
