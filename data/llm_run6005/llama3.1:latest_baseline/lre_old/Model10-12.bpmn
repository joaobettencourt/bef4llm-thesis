<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                   xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                   xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1"
                   targetNamespace="http://bpmn.io/schema/bpmn">
    <bpmn:collaboration id="Collaboration_0geryc1">
        <bpmn:participant id="Participant_0ygkg4f" name="EC" processRef="Process_1"/>
        <bpmn:participant id="Participant_0ygkg5a" name="INQ" processRef="Process_1"/>
        <bpmn:participant id="Participant_0ygkg6b" name="IP" processRef="Process_1"/>
    </bpmn:collaboration>
    <bpmn:process id="Process_1" isExecutable="false">
        <bpmn:startEvent id="StartEvent_1" name="EC tells INQ about change of master data">
            <bpmn:outgoing>SequenceFlow_14a0oky</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:sequenceFlow id="SequenceFlow_14a0oky" sourceRef="StartEvent_1"
                           targetRef="Task_12j0pib"/>
        <bpmn:task id="Task_12j0pib" name="INQ notifies IP of change">
            <bpmn:incoming>SequenceFlow_14a0oky</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_1j94oja</bpmn:outgoing>
        </bpmn:task>
        <bpmn:sequenceFlow id="SequenceFlow_1j94oja" sourceRef="Task_12j0pib"
                           targetRef="Task_0jsoxba"/>
        <bpmn:task id="Task_0jsoxba" name="IP checks whether master data can be changed at desired time">
            <bpmn:incoming>SequenceFlow_1j94oja</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_0kz5g1t</bpmn:outgoing>
        </bpmn:task>
        <bpmn:sequenceFlow id="SequenceFlow_0kz5g1t" sourceRef="Task_0jsoxba"
                           targetRef="ExclusiveGateway_1mpgzhg"/>
        <bpmn:exclusiveGateway id="ExclusiveGateway_1mpgzhg">
            <bpmn:incoming>SequenceFlow_0kz5g1t</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_0iu9po7</bpmn:outgoing>
            <bpmn:outgoing>SequenceFlow_1xv6wk4</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:sequenceFlow id="SequenceFlow_0iu9po7" sourceRef="ExclusiveGateway_1mpgzhg"
                           targetRef="Task_05ftug5"/>
        <bpmn:task id="Task_05ftug5" name="IP confirms changes of INQ">
            <bpmn:incoming>SequenceFlow_0iu9po7</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_035vf60</bpmn:outgoing>
        </bpmn:task>
        <bpmn:sequenceFlow id="SequenceFlow_1xv6wk4" sourceRef="ExclusiveGateway_1mpgzhg"
                           targetRef="Task_0sl26uo"/>
        <bpmn:task id="Task_0sl26uo" name="IP rejects changes of INQ">
            <bpmn:incoming>SequenceFlow_1xv6wk4</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_06kfaev</bpmn:outgoing>
        </bpmn:task>
        <bpmn:endEvent id="EndEvent_1fx9yp3" name="Process completed">
            <bpmn:incoming>SequenceFlow_035vf60</bpmn:incoming>
            <bpmn:incoming>SequenceFlow_06kfaev</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="SequenceFlow_035vf60" sourceRef="Task_05ftug5"
                           targetRef="EndEvent_1fx9yp3"/>
        <bpmn:sequenceFlow id="SequenceFlow_06kfaev" sourceRef="Task_0sl26uo"
                           targetRef="EndEvent_1fx9yp3"/>
    </bpmn:process>
</bpmn:definitions>