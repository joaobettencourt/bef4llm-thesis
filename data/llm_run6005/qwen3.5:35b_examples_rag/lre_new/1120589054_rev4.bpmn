<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Order to Cash Process" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Sales" name="Sales Department">
        <bpmn:flowNodeRef>LaneTask_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LaneTask_ProcessOrder</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Warehouse" name="Warehouse">
        <bpmn:flowNodeRef>LaneTask_DetermineParts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LaneGateway_PartsCheck</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Procurement" name="Procurement">
        <bpmn:flowNodeRef>LaneTask_RecordPetition</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LaneTask_OrderDaisuki</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Production" name="Production">
        <bpmn:flowNodeRef>LaneTask_StartProduction</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LaneTask_QualityCheck</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="LaneTask_Start" name="Customer Order Received">
      <bpmn:outgoing>bpmn:SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Process Order Task -->
    <bpmn:userTask id="LaneTask_ProcessOrder" name="Process Order &amp; Send to Warehouse">
      <bpmn:incoming>bpmn:SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Determine Parts Task -->
    <bpmn:userTask id="LaneTask_DetermineParts" name="Determine Required Parts">
      <bpmn:incoming>bpmn:SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_3</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway for Parts Availability -->
    <bpmn:exclusiveGateway id="LaneGateway_PartsCheck">
      <bpmn:incoming>bpmn:SequenceFlow_3</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_4</bpmn:outgoing>
      <bpmn:outgoing>bpmn:SequenceFlow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Record Petition Task -->
    <bpmn:userTask id="LaneTask_RecordPetition" name="Record Petition">
      <bpmn:incoming>bpmn:SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_6</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Order from Daisuki Task -->
    <bpmn:userTask id="LaneTask_OrderDaisuki" name="Order Parts from Daisuki">
      <bpmn:incoming>bpmn:SequenceFlow_6</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_7</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Start Production Task -->
    <bpmn:userTask id="LaneTask_StartProduction" name="Start Production">
      <bpmn:incoming>bpmn:SequenceFlow_5</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_8</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Quality Check Task -->
    <bpmn:userTask id="LaneTask_QualityCheck" name="Perform Quality Checks">
      <bpmn:incoming>bpmn:SequenceFlow_7</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_9</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Package and Label Task -->
    <bpmn:userTask id="LaneTask_PackageLabel" name="Package &amp; Label Products">
      <bpmn:incoming>bpmn:SequenceFlow_8</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_10</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Return to Warehouse Task -->
    <bpmn:userTask id="LaneTask_ReturnWarehouse" name="Return Items to Warehouse">
      <bpmn:incoming>bpmn:SequenceFlow_9</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_10</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Inform Sales Task -->
    <bpmn:userTask id="LaneTask_InformSales" name="Inform Sales About Completed Production">
      <bpmn:incoming>bpmn:SequenceFlow_10</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_11</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Sell to Customer Task -->
    <bpmn:userTask id="LaneTask_SellCustomer" name="Sell Product to Customer">
      <bpmn:incoming>bpmn:SequenceFlow_11</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_12</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="LaneEnd_Success" name="Order Completed">
      <bpmn:incoming>bpmn:SequenceFlow_12</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="LaneTask_Start" targetRef="LaneTask_ProcessOrder"/>
    <bpmn:sequenceFlow id="SequenceFlow_2" name="Send to Warehouse" sourceRef="LaneTask_ProcessOrder" targetRef="LaneTask_DetermineParts"/>
    <bpmn:sequenceFlow id="SequenceFlow_3" name="Check Parts Availability?" sourceRef="LaneTask_DetermineParts" targetRef="LaneGateway_PartsCheck">
      <bpmn:name>Is parts available?</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Not Available Path -->
    <bpmn:sequenceFlow id="SequenceFlow_4" name="No - Parts Missing" sourceRef="LaneGateway_PartsCheck" targetRef="LaneTask_RecordPetition"/>

    <!-- Available Path -->
    <bpmn:sequenceFlow id="SequenceFlow_5" name="Yes - Parts Available" sourceRef="LaneGateway_PartsCheck" targetRef="LaneTask_StartProduction"/>

    <!-- Order Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="LaneTask_RecordPetition" targetRef="LaneTask_OrderDaisuki"/>
    <bpmn:sequenceFlow id="SequenceFlow_7" name="Parts Collected &amp; Quality Check Passed" sourceRef="LaneTask_OrderDaisuki" targetRef="LaneTask_StartProduction">
      <bpmn:name>Order Complete</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Production Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_8" sourceRef="LaneTask_StartProduction" targetRef="LaneTask_QualityCheck"/>
    <bpmn:sequenceFlow id="SequenceFlow_9" name="Quality Check Passed?" sourceRef="LaneTask_QualityCheck" targetRef="LaneTask_PackageLabel">
      <bpmn:name>Pass?</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Packaging Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="LaneTask_PackageLabel" targetRef="LaneTask_ReturnWarehouse"/>
    <bpmn:sequenceFlow id="SequenceFlow_11" name="Inform Sales" sourceRef="LaneTask_ReturnWarehouse" targetRef="LaneTask_InformSales">
      <bpmn:name>Notify</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Final Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_12" sourceRef="LaneTask_InformSales" targetRef="LaneEnd_Success"/>

  </bpmn:process>
</bpmn:definitions>