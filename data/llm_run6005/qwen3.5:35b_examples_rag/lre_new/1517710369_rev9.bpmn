<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_CreditCardAddition" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Credit Card Addition Process" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_01" name="Select Credit Card Payment">
      <bpmn:outgoing>bpmn:SequenceFlow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- User Task: Enter Details -->
    <bpmn:userTask id="UserTask_EnterDetails" name="Enter Credit Card &amp; Billing Info">
      <bpmn:incoming>bpmn:SequenceFlow_01</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_02</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Service Task: Check Address -->
    <bpmn:serviceTask id="Service_CheckAddress" name="Validate Billing Address">
      <bpmn:incoming>bpmn:SequenceFlow_02</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_03</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Gateway 1: Address Validity -->
    <bpmn:exclusiveGateway id="Gateway_AddressValid" name="Address Correct?">
      <bpmn:incoming>bpmn:SequenceFlow_03</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_InvalidPath</bpmn:outgoing>
      <bpmn:outgoing>bpmn:SequenceFlow_ValidPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Modify Details (Loop Back) -->
    <bpmn:userTask id="UserTask_ModifyDetails" name="Modify Billing Information">
      <bpmn:incoming>bpmn:SequenceFlow_InvalidPath</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_ReCheckAddress</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Click Continue -->
    <bpmn:userTask id="UserTask_ClickContinue" name="Click 'Continue' Button">
      <bpmn:incoming>bpmn:SequenceFlow_ValidPath</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_04</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Service Task: Verify CC -->
    <bpmn:serviceTask id="Service_VerifyCC" name="Verify with Credit Card Authority">
      <bpmn:incoming>bpmn:SequenceFlow_04</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_05</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Gateway 2: Verification Result -->
    <bpmn:exclusiveGateway id="Gateway_VerificationResult" name="Verification Successful?">
      <bpmn:incoming>bpmn:SequenceFlow_05</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_SuccessPath</bpmn:outgoing>
      <bpmn:outgoing>bpmn:SequenceFlow_FailPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Add Card -->
    <bpmn:userTask id="UserTask_AddCard" name="Add Credit Card to Profile">
      <bpmn:incoming>bpmn:SequenceFlow_SuccessPath</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_06</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Cancel Addition -->
    <bpmn:userTask id="UserTask_CancelAddition" name="Cancel Credit Card Addition">
      <bpmn:incoming>bpmn:SequenceFlow_FailPath</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_07</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_Success" name="Card Added Successfully">
      <bpmn:incoming>bpmn:SequenceFlow_06</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_Failure" name="Addition Cancelled">
      <bpmn:incoming>bpmn:SequenceFlow_07</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    
    <!-- Start to Enter Details -->
    <bpmn:sequenceFlow id="SequenceFlow_01" sourceRef="StartEvent_01" targetRef="UserTask_EnterDetails"/>

    <!-- Enter Details to Check Address -->
    <bpmn:sequenceFlow id="SequenceFlow_02" sourceRef="UserTask_EnterDetails" targetRef="Service_CheckAddress"/>

    <!-- Check Address to Gateway 1 -->
    <bpmn:sequenceFlow id="SequenceFlow_03" name="Check Result" sourceRef="Service_CheckAddress" targetRef="Gateway_AddressValid">
      <bpmn:name>Is address valid?</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Gateway 1 Invalid Path to Modify -->
    <bpmn:sequenceFlow id="SequenceFlow_InvalidPath" name="No (Incorrect)" sourceRef="Gateway_AddressValid" targetRef="UserTask_ModifyDetails"/>

    <!-- Modify Details back to Check Address -->
    <bpmn:sequenceFlow id="SequenceFlow_ReCheckAddress" sourceRef="UserTask_ModifyDetails" targetRef="Service_CheckAddress"/>

    <!-- Gateway 1 Valid Path to Continue Button -->
    <bpmn:sequenceFlow id="SequenceFlow_ValidPath" name="Yes (Correct)" sourceRef="Gateway_AddressValid" targetRef="UserTask_ClickContinue"/>

    <!-- Continue Button to Verify CC -->
    <bpmn:sequenceFlow id="SequenceFlow_04" sourceRef="UserTask_ClickContinue" targetRef="Service_VerifyCC"/>

    <!-- Verify CC to Gateway 2 -->
    <bpmn:sequenceFlow id="SequenceFlow_05" name="Verification Result" sourceRef="Service_VerifyCC" targetRef="Gateway_VerificationResult">
      <bpmn:name>Is verified?</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Gateway 2 Success Path to Add Card -->
    <bpmn:sequenceFlow id="SequenceFlow_SuccessPath" name="Yes (Validated)" sourceRef="Gateway_VerificationResult" targetRef="UserTask_AddCard"/>

    <!-- Gateway 2 Fail Path to Cancel -->
    <bpmn:sequenceFlow id="SequenceFlow_FailPath" name="No (Not Validated)" sourceRef="Gateway_VerificationResult" targetRef="UserTask_CancelAddition"/>

    <!-- Add Card to End Success -->
    <bpmn:sequenceFlow id="SequenceFlow_06" sourceRef="UserTask_AddCard" targetRef="EndEvent_Success"/>

    <!-- Cancel Addition to End Failure -->
    <bpmn:sequenceFlow id="SequenceFlow_07" sourceRef="UserTask_CancelAddition" targetRef="EndEvent_Failure"/>

  </bpmn:process>
</bpmn:definitions>