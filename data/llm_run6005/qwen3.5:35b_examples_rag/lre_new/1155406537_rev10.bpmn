<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_AccountCreation">
    <bpmn:participant id="Participant_Client" name="PayPal Client"/>
    <bpmn:participant id="Participant_System" name="PayPal System" processRef="Process_1"/>
    <bpmn:messageFlow id="MessageFlow_CreateAccount" sourceRef="IntermediateThrowEvent_SubmitDetails" targetRef="StartEvent_RequestReceived">
      <bpmn:name>Submit Account Creation Request</bpmn:name>
    </bpmn:messageFlow>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Client" name="PayPal Client">
        <bpmn:flowNodeRef>StartEvent_AccountCreation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_SelectAccountType</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_0accountSelection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_LoginDetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_PersonalInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_PEPCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateThrowEvent_SubmitDetails</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_AccountCreation" name="Create PayPal Account">
      <bpmn:outgoing>bpmn:SequenceFlow_0start</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Select Account Type Task -->
    <bpmn:userTask id="UserTask_SelectAccountType" name="Select Account Type">
      <bpmn:incoming>bpmn:SequenceFlow_0start</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_1accountSelection</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Account Type Selection Gateway -->
    <bpmn:exclusiveGateway id="InclusiveGateway_0accountSelection">
      <bpmn:incoming>bpmn:SequenceFlow_1accountSelection</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_2personalAccount</bpmn:outgoing>
      <bpmn:outgoing>bpmn:SequenceFlow_3premiumAccount</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Login Details Task -->
    <bpmn:userTask id="UserTask_LoginDetails" name="Enter Login Details">
      <bpmn:incoming>bpmn:SequenceFlow_2personalAccount</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_4loginToPersonalInfo</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Personal Info Task -->
    <bpmn:userTask id="UserTask_PersonalInfo" name="Enter Personal Details">
      <bpmn:incoming>bpmn:SequenceFlow_4loginToPersonalInfo</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_5personalToPEP</bpmn:outgoing>
    </bpmn:userTask>

    <!-- PEP Declaration Task -->
    <bpmn:userTask id="UserTask_PEPCheck" name="Declare Political Exposure">
      <bpmn:incoming>bpmn:SequenceFlow_5personalToPEP</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_6pepSubmit</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Submit to System -->
    <bpmn:intermediateThrowEvent id="IntermediateThrowEvent_SubmitDetails" name="Click Create Account">
      <bpmn:incoming>bpmn:SequenceFlow_6pepSubmit</bpmn:incoming>
      <bpmn:messageEventDefinition/>
    </bpmn:intermediateThrowEvent>

    <!-- System Side - Start Event -->
    <bpmn:startEvent id="StartEvent_RequestReceived" name="Receive Account Creation Request">
      <bpmn:outgoing>bpmn:SequenceFlow_7validation</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- System Validation Task -->
    <bpmn:userTask id="UserTask_SystemValidation" name="Validate Input Fields">
      <bpmn:incoming>bpmn:SequenceFlow_7validation</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_8validateResult</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Validation Result Gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_Validation">
      <bpmn:incoming>bpmn:SequenceFlow_8validateResult</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_9validFields</bpmn:outgoing>
      <bpmn:outgoing>bpmn:SequenceFlow_10invalidFields</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Error Notification Task -->
    <bpmn:userTask id="UserTask_ErrorNotification" name="Notify Client of Errors">
      <bpmn:incoming>bpmn:SequenceFlow_10invalidFields</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_11errorToCorrection</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Correction Task -->
    <bpmn:userTask id="UserTask_Correction" name="Correct Invalid Fields">
      <bpmn:incoming>bpmn:SequenceFlow_11errorToCorrection</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_12correctionBackValidation</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Welcome Email Task -->
    <bpmn:userTask id="UserTask_WelcomeEmail" name="Generate &amp; Send Welcome Email">
      <bpmn:incoming>bpmn:SequenceFlow_9validFields</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_13emailToSuccess</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Success End Event -->
    <bpmn:endEvent id="EndEvent_AccountCreated" name="Account Created Successfully">
      <bpmn:incoming>bpmn:SequenceFlow_13emailToSuccess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Error Loop End Event -->
    <bpmn:endEvent id="EndEvent_ErrorHandled" name="Errors Corrected">
      <bpmn:incoming>bpmn:SequenceFlow_12correctionBackValidation</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_0start" sourceRef="StartEvent_AccountCreation" targetRef="UserTask_SelectAccountType"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_1accountSelection" name="Select Account Type" sourceRef="UserTask_SelectAccountType" targetRef="InclusiveGateway_0accountSelection">
      <bpmn:name conditionExpression xsi:type="formalExpression">${selectAccount}</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_2personalAccount" name="Personal Account" sourceRef="InclusiveGateway_0accountSelection" targetRef="UserTask_LoginDetails">
      <bpmn:name conditionExpression xsi:type="formalExpression">${accountType='personal'}</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_3premiumAccount" name="Premium Account" sourceRef="InclusiveGateway_0accountSelection" targetRef="UserTask_LoginDetails">
      <bpmn:name conditionExpression xsi:type="formalExpression">${accountType='premium'}</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_4loginToPersonalInfo" sourceRef="UserTask_LoginDetails" targetRef="UserTask_PersonalInfo"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_5personalToPEP" name="Enter Personal Details, Phone &amp; Address" sourceRef="UserTask_PersonalInfo" targetRef="UserTask_PEPCheck">
      <bpmn:name conditionExpression xsi:type="formalExpression">${enterPersonalDetails}</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_6pepSubmit" sourceRef="UserTask_PEPCheck" targetRef="IntermediateThrowEvent_SubmitDetails"/>

    <!-- System Side Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_7validation" sourceRef="StartEvent_RequestReceived" targetRef="UserTask_SystemValidation"/>

    <bpmn:sequenceFlow id="SequenceFlow_8validateResult" name="Validate Input Fields" sourceRef="UserTask_SystemValidation" targetRef="ExclusiveGateway_Validation">
      <bpmn:name conditionExpression xsi:type="formalExpression">${validationComplete}</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Validation Results -->
    <bpmn:sequenceFlow id="SequenceFlow_9validFields" name="All Fields Valid" sourceRef="ExclusiveGateway_Validation" targetRef="UserTask_WelcomeEmail">
      <bpmn:name conditionExpression xsi:type="formalExpression">${validationResult='valid'}</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_10invalidFields" name="Invalid Fields Found" sourceRef="ExclusiveGateway_Validation" targetRef="UserTask_ErrorNotification">
      <bpmn:name conditionExpression xsi:type="formalExpression">${validationResult='invalid'}</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Error Handling Loop -->
    <bpmn:sequenceFlow id="SequenceFlow_11errorToCorrection" sourceRef="UserTask_ErrorNotification" targetRef="UserTask_Correction"/>

    <bpmn:sequenceFlow id="SequenceFlow_12correctionBackValidation" name="Correct and Resubmit" sourceRef="UserTask_Correction" targetRef="ExclusiveGateway_Validation">
      <bpmn:name conditionExpression xsi:type="formalExpression">${correctAndResubmit}</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Success Path -->
    <bpmn:sequenceFlow id="SequenceFlow_13emailToSuccess" sourceRef="UserTask_WelcomeEmail" targetRef="EndEvent_AccountCreated"/>

  </bpmn:process>
</bpmn:definitions>