<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                 xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" 
                 xmlns:di="http://www.omg.org/spec/DD/20100524/DI" 
                 xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" 
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
                 id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_NewClients">
    <bpmn:participant id="Participant_ManagementMarketing" name="Client Acquisition Process" processRef="Process_ClientAcquisition"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_ClientAcquisition" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Management" name="Management">
        <bpmn:flowNodeRef>StartEvent_NewClients</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendDetailedOffer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ClientDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ContractSigned</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AnalyzeFailure</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Marketing" name="Marketing Team">
        <bpmn:flowNodeRef>Task_MarketAnalysis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepPresentation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendOffers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_ResponsesReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformManagement</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_NewClients" name="New clients needed">
      <bpmn:outgoing>bpmn:SequenceFlow_Analysis</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Marketing Tasks -->
    <bpmn:userTask id="Task_MarketAnalysis" name="Perform market analysis">
      <bpmn:incoming>bpmn:SequenceFlow_Analysis</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_Presentation</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_PrepPresentation" name="Prepare portfolio presentation">
      <bpmn:incoming>bpmn:SequenceFlow_Presentation</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_SendOffers</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_SendOffers" name="Send offers to potential clients">
      <bpmn:incoming>bpmn:SequenceFlow_SendOffers</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_WaitResponse</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Intermediate Event for Client Responses -->
    <bpmn:intermediateCatchEvent id="Event_ResponsesReceived" name="Client responses received">
      <bpmn:incoming>bpmn:SequenceFlow_WaitResponse</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_InformManagement</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Handover to Management -->
    <bpmn:userTask id="Task_InformManagement" name="Inform management about responses">
      <bpmn:incoming>bpmn:SequenceFlow_InformManagement</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_NegotiationStart</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Management Tasks -->
    <bpmn:userTask id="Task_SendDetailedOffer" name="Send detailed offer to client">
      <bpmn:incoming>bpmn:SequenceFlow_NegotiationStart</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_DecisionPoint</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Decision Gateway -->
    <bpmn:exclusiveGateway id="Gateway_ClientDecision">
      <bpmn:incoming>bpmn:SequenceFlow_DecisionPoint</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_Accepted</bpmn:outgoing>
      <bpmn:outgoing>bpmn:SequenceFlow_Rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Path A: Accept -->
    <bpmn:userTask id="Task_PrepareContract" name="Prepare contract">
      <bpmn:incoming>bpmn:SequenceFlow_Accepted</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_Signing</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Path B: Fail -->
    <bpmn:userTask id="Task_AnalyzeFailure" name="Analyze reason for failure">
      <bpmn:incoming>bpmn:SequenceFlow_Rejected</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_FailureEnd</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_ContractSigned" name="Contract signed">
      <bpmn:incoming>bpmn:SequenceFlow_Signing</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_FailureAnalyzed" name="Failure analyzed">
      <bpmn:incoming>bpmn:SequenceFlow_FailureEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_Analysis" sourceRef="StartEvent_NewClients" targetRef="Task_MarketAnalysis"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_Presentation" name="After analysis" sourceRef="Task_MarketAnalysis" targetRef="Task_PrepPresentation"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_SendOffers" name="Send offers" sourceRef="Task_PrepPresentation" targetRef="Task_SendOffers"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_WaitResponse" name="Wait for responses" sourceRef="Task_SendOffers" targetRef="Event_ResponsesReceived"/>

    <bpmn:sequenceFlow id="SequenceFlow_InformManagement" name="Inform management" sourceRef="Event_ResponsesReceived" targetRef="Task_InformManagement"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_NegotiationStart" name="Negotiations start" sourceRef="Task_InformManagement" targetRef="Task_SendDetailedOffer"/>

    <bpmn:sequenceFlow id="SequenceFlow_DecisionPoint" name="Client response?" sourceRef="Task_SendDetailedOffer" targetRef="Gateway_ClientDecision"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_Accepted" name="Accepts offer" sourceRef="Gateway_ClientDecision" targetRef="Task_PrepareContract"/>

    <bpmn:sequenceFlow id="SequenceFlow_Rejected" name="Offer failed" sourceRef="Gateway_ClientDecision" targetRef="Task_AnalyzeFailure"/>

    <bpmn:sequenceFlow id="SequenceFlow_Signing" name="Prepare contract" sourceRef="Task_PrepareContract" targetRef="EndEvent_ContractSigned"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_FailureEnd" name="Analyze failure" sourceRef="Task_AnalyzeFailure" targetRef="EndEvent_FailureAnalyzed"/>

  </bpmn:process>
</bpmn:definitions>