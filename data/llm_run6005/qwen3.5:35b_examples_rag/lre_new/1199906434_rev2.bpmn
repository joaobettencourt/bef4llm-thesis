<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_ErrorHandling">
    <bpmn:participant id="Participant_Process" name="Error Resolution Process" processRef="Process_ErrorResolution"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_ErrorResolution" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_IS" name="Information System (IS)">
        <bpmn:flowNodeRef>LaneTask_Start</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Tech" name="Drop-off Technician">
        <bpmn:flowNodeRef>UserTask_CheckTypos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_IsTypo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_AssessCorrection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_CanCorrect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_ScourSources</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Notification" name="IS Notified of Error">
      <bpmn:outgoing>bpmn:SequenceFlow_StartToCheckTypos</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1 -->
    <bpmn:userTask id="UserTask_CheckTypos" name="Drop-off Tech Checks for Typos">
      <bpmn:incoming>bpmn:SequenceFlow_StartToCheckTypos</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_TypoDecision</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway 1 -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_IsTypo">
      <bpmn:incoming>bpmn:SequenceFlow_TypoDecision</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_ResolvedIfTypo</bpmn:outgoing>
      <bpmn:outgoing>bpmn:SequenceFlow_CheckCorrectionCapability</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 2 -->
    <bpmn:userTask id="UserTask_AssessCorrection" name="Check if Customer Can Correct">
      <bpmn:incoming>bpmn:SequenceFlow_CheckCorrectionCapability</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_CanCorrectDecision</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway 2 -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_CanCorrect">
      <bpmn:incoming>bpmn:SequenceFlow_CanCorrectDecision</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_ResolvedIfCustomerCanFix</bpmn:outgoing>
      <bpmn:outgoing>bpmn:SequenceFlow_ScourSources</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 3 -->
    <bpmn:userTask id="UserTask_ScourSources" name="Scour Public Sources for Solutions">
      <bpmn:incoming>bpmn:SequenceFlow_ScourSources</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_ResolvedIfSolutionFound</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Resolved" name="Issue Resolved">
      <bpmn:incoming>bpmn:SequenceFlow_ResolvedIfTypo</bpmn:incoming>
      <bpmn:incoming>bpmn:SequenceFlow_ResolvedIfCustomerCanFix</bpmn:incoming>
      <bpmn:incoming>bpmn:SequenceFlow_ResolvedIfSolutionFound</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToCheckTypos" sourceRef="StartEvent_Notification" targetRef="UserTask_CheckTypos"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_TypoDecision" name="Is Typo Found?" sourceRef="ExclusiveGateway_IsTypo">
      <!-- Condition logic implied -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ResolvedIfTypo" name="Yes (Fixed)" targetRef="EndEvent_Resolved"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_CheckCorrectionCapability" sourceRef="ExclusiveGateway_IsTypo" targetRef="UserTask_AssessCorrection">
      <!-- Condition logic implied -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_CanCorrectDecision" name="Can Customer Correct?" sourceRef="ExclusiveGateway_CanCorrect"/>

    <bpmn:sequenceFlow id="SequenceFlow_ResolvedIfCustomerCanFix" name="Yes (Fixed)" targetRef="EndEvent_Resolved"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ScourSources" sourceRef="ExclusiveGateway_CanCorrect" targetRef="UserTask_ScourSources">
      <!-- Condition logic implied -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ResolvedIfSolutionFound" name="Yes (Fixed)" targetRef="EndEvent_Resolved"/>

  </bpmn:process>
</bpmn:definitions>