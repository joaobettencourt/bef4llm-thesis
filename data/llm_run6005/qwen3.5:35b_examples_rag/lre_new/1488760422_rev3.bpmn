<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                 xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" 
                 xmlns:di="http://www.omg.org/spec/DD/20100524/DI" 
                 xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" 
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_SSP" name="SSP" processRef="Process_1"/>
    <bpmn:participant id="Participant_Client" name="Client"/>
  </bpmn:collaboration>

  <!-- Global Messages -->
  <bpmn:message id="Message_Invoice" name="Invoice"/>
  <bpmn:message id="Message_RequestInfo" name="Request Information"/>
  <bpmn:message id="Message_Reminder" name="Reminder"/>

  <bpmn:process id="Process_1" isExecutable="false">
    
    <!-- Lane Set for SSP -->
    <bpmn:laneSet>
      <bpmn:lane id="Lane_AdminOffice" name="Admin Office">
        <bpmn:flowNodeRef>LaneTask_SortClient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LaneTask_SortVendor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LaneTask_AttachForm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LaneTask_EnterInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LaneGateway_CompletenessCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LaneTask_SLAEntry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LaneTask_CheckPriority</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LaneGateway_PriorityCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LaneTask_RedStamp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LaneGateway_ComplianceCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LaneTask_AllocateDEO1</bpmn:flowNodeRef>
      </bpmn:lane>

      <!-- Lane for Experience Staff -->
      <bpmn:lane id="Lane_ExperienceStaff" name="Experience Staff">
        <bpmn:flowNodeRef>LaneTask_ProcessNonCompliance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LaneGateway_MergeAfterProcessing</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event - Invoice Received from Client -->
    <bpmn:startEvent id="StartEvent_InvoiceReceived" name="Invoice Received">
      <bpmn:messageEventDefinition messageRef="Message_Invoice"/>
      <bpmn:outgoing>bpmn:SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Admin Office Tasks -->
    <bpmn:userTask id="LaneTask_SortClient" name="Sort Invoice per Client">
      <bpmn:incoming>bpmn:SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_2</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="LaneTask_SortVendor" name="Sort Invoice per Vendor">
      <bpmn:incoming>bpmn:SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_3</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="LaneTask_AttachForm" name="Attach Invoice Entry Form">
      <bpmn:incoming>bpmn:SequenceFlow_3</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_4</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="LaneTask_EnterInfo" name="Enter Required Info on Form">
      <bpmn:incoming>bpmn:SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_5</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Completeness Check Gateway -->
    <bpmn:exclusiveGateway id="LaneGateway_CompletenessCheck" name="Invoice Complete?">
      <bpmn:incoming>bpmn:SequenceFlow_5</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_6</bpmn:outgoing>
      <bpmn:outgoing>bpmn:SequenceFlow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- SLA Entry Tasks -->
    <bpmn:userTask id="LaneTask_SLAEntry" name="Enter Info for SLA">
      <bpmn:incoming>bpmn:SequenceFlow_6</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_8</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="LaneTask_CheckPriority" name="Check Priority">
      <bpmn:incoming>bpmn:SequenceFlow_8</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_9</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Priority Check Gateway -->
    <bpmn:exclusiveGateway id="LaneGateway_PriorityCheck" name="High Priority?">
      <bpmn:incoming>bpmn:SequenceFlow_9</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_10</bpmn:outgoing>
      <bpmn:outgoing>bpmn:SequenceFlow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Red Stamp Task -->
    <bpmn:userTask id="LaneTask_RedStamp" name="Apply Red Stamp">
      <bpmn:incoming>bpmn:SequenceFlow_10</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_12</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Compliance Check Gateway -->
    <bpmn:exclusiveGateway id="LaneGateway_ComplianceCheck" name="Invoice Compliant?">
      <bpmn:incoming>bpmn:SequenceFlow_12</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_13</bpmn:outgoing>
      <bpmn:outgoing>bpmn:SequenceFlow_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Experience Staff Task -->
    <bpmn:userTask id="LaneTask_ProcessNonCompliance" name="Process Non-Compliant Invoice">
      <bpmn:incoming>bpmn:SequenceFlow_14</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_20</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Merge Gateway after Experience Staff -->
    <bpmn:exclusiveGateway id="LaneGateway_MergeAfterProcessing" name="Merge After Processing">
      <bpmn:incoming>bpmn:SequenceFlow_13</bpmn:incoming>
      <bpmn:incoming>bpmn:SequenceFlow_20</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_21</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Allocation Tasks -->
    <bpmn:userTask id="LaneTask_AllocateDEO1" name="Allocate Invoice to DEO">
      <bpmn:incoming>bpmn:SequenceFlow_21</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_24</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Message Flow Events -->
    <bpmn:intermediateThrowEvent id="IntermediateThrow_SendMsgIncomplete" name="Send Message">
      <bpmn:incoming>bpmn:SequenceFlow_7</bpmn:incoming>
      <bpmn:messageEventDefinition messageRef="Message_RequestInfo"/>
      <bpmn:outgoing>bpmn:SequenceFlow_End1</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <!-- Timer Event for Reminder -->
    <bpmn:timerEventDefinition id="Timer_Reminder">
      <bpmn:timeDuration xsi:type="bpmn:tTimeDate" expression="PT10H"/>
    </bpmn:timerEventDefinition>

    <bpmn:intermediateThrowEvent id="IntermediateThrow_SendReminder" name="Send Reminder (after 10 hours)">
      <bpmn:messageEventDefinition messageRef="Message_Reminder"/>
      <bpmn:outgoing>bpmn:SequenceFlow_23</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_Incomplete" name="Process Finished">
      <bpmn:incoming>bpmn:SequenceFlow_End1</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_Completed" name="Invoice Processed">
      <bpmn:incoming>bpmn:SequenceFlow_24</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_InvoiceReceived" targetRef="LaneTask_SortClient"/>
    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="LaneTask_SortClient" targetRef="LaneTask_SortVendor"/>
    <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="LaneTask_SortVendor" targetRef="LaneTask_AttachForm"/>
    <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="LaneTask_AttachForm" targetRef="LaneTask_EnterInfo"/>
    
    <!-- Completeness Check -->
    <bpmn:sequenceFlow id="SequenceFlow_5" name="Check Completeness" sourceRef="LaneTask_EnterInfo" targetRef="LaneGateway_CompletenessCheck">
      <bpmn:name conditionExpression="${invoiceComplete}"></bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Incomplete Path -->
    <bpmn:sequenceFlow id="SequenceFlow_7" name="No - Not Complete" sourceRef="LaneGateway_CompletenessCheck" targetRef="IntermediateThrow_SendMsgIncomplete">
      <bpmn:name conditionExpression="${!invoiceComplete}"></bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Complete Path -->
    <bpmn:sequenceFlow id="SequenceFlow_6" name="Yes - Complete" sourceRef="LaneGateway_CompletenessCheck" targetRef="LaneTask_SLAEntry">
      <bpmn:name conditionExpression="${invoiceComplete}"></bpmn:name>
    </bpmn:sequenceFlow>

    <!-- SLA and Priority -->
    <bpmn:sequenceFlow id="SequenceFlow_8" sourceRef="LaneTask_SLAEntry" targetRef="LaneTask_CheckPriority"/>
    
    <!-- Priority Check Gateway -->
    <bpmn:sequenceFlow id="SequenceFlow_9" name="Check Priority" sourceRef="LaneTask_CheckPriority" targetRef="LaneGateway_PriorityCheck">
      <bpmn:name conditionExpression="${checkPriority}"></bpmn:name>
    </bpmn:sequenceFlow>

    <!-- High Priority Path -->
    <bpmn:sequenceFlow id="SequenceFlow_10" name="Yes - High Priority" sourceRef="LaneGateway_PriorityCheck" targetRef="LaneTask_RedStamp">
      <bpmn:name conditionExpression="${highPriority}"></bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Low/Normal Priority Path -->
    <bpmn:sequenceFlow id="SequenceFlow_11" name="No - Normal Priority" sourceRef="LaneGateway_PriorityCheck" targetRef="LaneTask_RedStamp">
      <bpmn:name conditionExpression="${!highPriority}"></bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Compliance Check -->
    <bpmn:sequenceFlow id="SequenceFlow_12" sourceRef="LaneTask_RedStamp" targetRef="LaneGateway_ComplianceCheck">
      <bpmn:name conditionExpression="${checkCompliance}"></bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Compliant Path -->
    <bpmn:sequenceFlow id="SequenceFlow_13" name="Yes - Compliant" sourceRef="LaneGateway_ComplianceCheck" targetRef="LaneTask_AllocateDEO1">
      <bpmn:name conditionExpression="${compliant}"></bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Non-Compliant Path -->
    <bpmn:sequenceFlow id="SequenceFlow_14" name="No - Not Compliant" sourceRef="LaneGateway_ComplianceCheck" targetRef="LaneTask_ProcessNonCompliance">
      <bpmn:name conditionExpression="${!compliant}"></bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Merge after processing -->
    <bpmn:sequenceFlow id="SequenceFlow_20" sourceRef="LaneTask_ProcessNonCompliance" targetRef="LaneGateway_MergeAfterProcessing"/>
    
    <!-- Final Allocation Path -->
    <bpmn:sequenceFlow id="SequenceFlow_21" name="Merge Paths" sourceRef="LaneGateway_MergeAfterProcessing" targetRef="LaneTask_AllocateDEO1">
      <bpmn:name conditionExpression="${mergePaths}"></bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Final End -->
    <bpmn:sequenceFlow id="SequenceFlow_24" sourceRef="LaneTask_AllocateDEO1" targetRef="EndEvent_Completed"/>

  </bpmn:process>
</bpmn:definitions>