<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_BankAccountCreation">
    <bpmn:participant id="Participant_Customer" name="Customer" processRef="Process_Customer"/>
    <bpmn:participant id="Participant_Bank" name="Bank Process" processRef="Process_Bank"/>
  </bpmn:collaboration>

  <!-- Customer Process -->
  <bpmn:process id="Process_Customer">
    <bpmn:startEvent id="StartCustomer_1" name="Visit Bank Website">
      <bpmn:outgoing>bpmn:SequenceFlow_Cust_0</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_Customer_DataEntry" name="Fill Personal Data and Generate PDF Document">
      <bpmn:incoming>bpmn:SequenceFlow_Cust_0</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_Cust_1</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_Customer_Print" name="Print PDF Document">
      <bpmn:incoming>bpmn:SequenceFlow_Cust_1</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_Cust_2</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_Customer_PostOffice" name="Visit Post Office">
      <bpmn:incoming>bpmn:SequenceFlow_Cust_2</bpmn:incoming>
      <bpmn:outgoing>bpmn:MessageFlow_Cust_Bank_1</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Message Flow to Bank -->
    <bpmn:message id="Msg_AccountRequest" name="Account Request Documents"/>

    <bpmn:endEvent id="EndCustomer_Accepted">
      <bpmn:incoming>bpmn:SequenceFlow_Cust_3</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndCustomer_Rejected" name="Account Request Rejected">
      <bpmn:incoming>bpmn:SequenceFlow_Cust_4</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_Cust_0" sourceRef="StartCustomer_1" targetRef="Task_Customer_DataEntry"/>
    <bpmn:sequenceFlow id="SequenceFlow_Cust_1" sourceRef="Task_Customer_DataEntry" targetRef="Task_Customer_Print"/>
    <bpmn:sequenceFlow id="SequenceFlow_Cust_2" sourceRef="Task_Customer_Print" targetRef="Task_Customer_PostOffice"/>

  </bpmn:process>

  <!-- Bank Process -->
  <bpmn:process id="Process_Bank">
    <bpmn:startEvent id="StartBank_1" name="Receive Account Request Documents">
      <bpmn:outgoing>bpmn:SequenceFlow_Bank_0</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Lane for Post Office Officer -->
    <bpmn:laneSet id="LaneSet_PostOffice">
      <bpmn:lane id="Lane_Officer" name="Post Office Officer">
        <bpmn:flowNodeRef>LaneTask_CheckIdentity</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Lane for Bank Officer -->
    <bpmn:laneSet id="LaneSet_BankOfficer">
      <bpmn:lane id="Lane_OfficerDecision" name="Bank Officer">
        <bpmn:flowNodeRef>LaneTask_CheckData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LaneGateway_Decision</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Post Office Officer Task -->
    <bpmn:userTask id="LaneTask_CheckIdentity" name="Check Customer Identity">
      <bpmn:incoming>bpmn:SequenceFlow_Bank_0</bpmn:incoming>
      <bpmn:outgoing>bpmn:MessageFlow_Bank_Cust_1</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Bank Officer Task -->
    <bpmn:userTask id="LaneTask_CheckData" name="Check Customer Data">
      <bpmn:incoming>bpmn:SequenceFlow_Bank_0</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_Bank_1</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Decision Gateway -->
    <bpmn:exclusiveGateway id="LaneGateway_Decision">
      <bpmn:incoming>bpmn:SequenceFlow_Bank_1</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_Bank_Accepted</bpmn:outgoing>
      <bpmn:outgoing>bpmn:SequenceFlow_Bank_Rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Accept Path -->
    <bpmn:userTask id="LaneTask_SendDocuments" name="Mail Account Documents to Customer">
      <bpmn:incoming>bpmn:SequenceFlow_Bank_Accepted</bpmn:incoming>
      <bpmn:outgoing>bpmn:MessageFlow_Cust_Bank_2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Reject Path -->
    <bpmn:userTask id="LaneTask_SendRefusal" name="Mail Letter of Refusal to Customer">
      <bpmn:incoming>bpmn:SequenceFlow_Bank_Rejected</bpmn:incoming>
      <bpmn:outgoing>bpmn:MessageFlow_Cust_Bank_3</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Events -->
    <bpmn:endEvent id="EndBank_Accepted" name="Account Created">
      <bpmn:incoming>bpmn:SequenceFlow_Bank_EndAccepted</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndBank_Rejected" name="Request Rejected">
      <bpmn:incoming>bpmn:SequenceFlow_Bank_EndRejected</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_Bank_0" sourceRef="StartBank_1" targetRef="LaneTask_CheckData"/>
    <bpmn:sequenceFlow id="SequenceFlow_Bank_1" name="Review Data Complete?" sourceRef="LaneTask_CheckData" targetRef="LaneGateway_Decision">
      <bpmn:name conditionExpression xsi:type="formalExpression">${dataComplete}</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Gateway Conditions -->
    <bpmn:sequenceFlow id="SequenceFlow_Bank_Accepted" name="Accept Request?" sourceRef="LaneGateway_Decision" targetRef="LaneTask_SendDocuments">
      <bpmn:name conditionExpression xsi:type="formalExpression">${decision=accept}</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_Bank_Rejected" name="Reject Request?" sourceRef="LaneGateway_Decision" targetRef="LaneTask_SendRefusal">
      <bpmn:name conditionExpression xsi:type="formalExpression">${decision=reject}</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- End Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_Bank_EndAccepted" sourceRef="LaneTask_SendDocuments" targetRef="EndBank_Accepted"/>
    <bpmn:sequenceFlow id="SequenceFlow_Bank_EndRejected" sourceRef="LaneTask_SendRefusal" targetRef="EndBank_Rejected"/>

  </bpmn:process>

</bpmn:definitions>