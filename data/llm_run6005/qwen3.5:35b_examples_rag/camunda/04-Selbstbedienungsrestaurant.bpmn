<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_RestaurantProcess">
    <bpmn:participant id="Participant_RestaurantService" name="Restaurant Service Process" processRef="Process_RestaurantOrdering"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_RestaurantOrdering" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Customer" name="Gast (Customer)">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_GuestWaitsForOrdering</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_PagerResponseCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_MealConsumed</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Staff" name="Angestellter (Staff)">
        <bpmn:flowNodeRef>UserTask_GuestPlacesOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterOrderInPOS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_CollectPayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_SetPagerForGuest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_InformCookAboutOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_PaymentSuccessful</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_KitchenStart_08</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_TriggerGuestPager</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_CallGuestAfter5Minutes</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Kitchen" name="Koch (Kitchen)">
        <bpmn:flowNodeRef>Task_PrepareMeal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_PlaceInPassThroughWindow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_NotifyStaffFoodReady</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Gast betritt Restaurant">
      <bpmn:name>Gast betritt Restaurant</bpmn:name>
      <bpmn:description>Kunde kommt ins Restaurant, wenn er Hunger verspürt.</bpmn:description>
      <bpmn:outgoing>SequenceFlow_GuestWaitsForOrdering_01</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Guest Task -->
    <bpmn:userTask id="UserTask_GuestWaitsForOrdering" name="Gericht auswählen und warten">
      <bpmn:name>Gericht auswählen und warten</bpmn:name>
      <bpmn:description>Gast wählt aus wechselndem Angebot ein Gericht aus.</bpmn:description>
      <bpmn:incoming>SequenceFlow_GuestWaitsForOrdering_01</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Staff Tasks -->
    <bpmn:userTask id="UserTask_GuestPlacesOrder" name="Bestellung aufnehmen">
      <bpmn:name>Bestellung aufnehmen</bpmn:name>
      <bpmn:description>Gast gibt Bestellung beim Angestellten auf.</bpmn:description>
      <bpmn:incoming>SequenceFlow_OrderPlacedWithStaff_02</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:task id="Task_EnterOrderInPOS" name="Bestellung in Kassensystem eingeben">
      <bpmn:name>Bestellung in Kassensystem eingeben</bpmn:name>
      <bpmn:description>Angestellter gibt Bestellung ins System ein.</bpmn:description>
      <bpmn:incoming>SequenceFlow_OrderPlacedWithStaff_02</bpmn:outgoing>
    </bpmn:task>

    <bpmn:userTask id="UserTask_CollectPayment" name="Geld vom Gast kassieren">
      <bpmn:name>Geld vom Gast kassieren</bpmn:name>
      <bpmn:description>Angestellter nimmt Zahlung entgegen.</bpmn:description>
      <bpmn:incoming>SequenceFlow_EnterOrderInPOS_03</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Payment Gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_PaymentSuccessful" name="Zahlung erfolgreich?">
      <bpmn:name>Zahlung erfolgreich?</bpmn:name>
      <bpmn:description>Prüft ob Zahlung akzeptiert wurde.</bpmn:description>
      <bpmn:incoming>SequenceFlow_CollectPayment_04</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Pager Task -->
    <bpmn:userTask id="UserTask_SetPagerForGuest" name="Pieper einstellen und übergeben">
      <bpmn:name>Pieper einstellen und übergeben</bpmn:name>
      <bpmn:description>"Wenn sich der Pieper meldet, ist Ihr Essen fertig"</bpmn:description>
      <bpmn:incoming>SequenceFlow_PaymentSuccessful_05</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Inform Cook Task -->
    <bpmn:userTask id="UserTask_InformCookAboutOrder" name="Koch über Mahlzeit informieren">
      <bpmn:name>Koch über Mahlzeit informieren</bpmn:name>
      <bpmn:description>Angestellter informiert Koch über bestellte Mahlzeit.</bpmn:description>
      <bpmn:incoming>SequenceFlow_SetPagerForGuest_06</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Kitchen Tasks -->
    <bpmn:task id="Task_PrepareMeal" name="Mahlzeit zubereiten">
      <bpmn:name>Mahlzeit zubereiten</bpmn:name>
      <bpmn:description>Koch bereitet die Mahlzeit zu.</bpmn:description>
      <bpmn:incoming>SequenceFlow_KitchenStart_08</bpmn:outgoing>
    </bpmn:task>

    <bpmn:userTask id="UserTask_PlaceInPassThroughWindow" name="Mahlzeit in Durchreiche stellen">
      <bpmn:name>Mahlzeit in Durchreiche stellen</bpmn:name>
      <bpmn:description>Koch stellt Mahlstein für Angestellten bereit.</bpmn:description>
      <bpmn:incoming>SequenceFlow_PrepareMeal_09</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Kitchen Notification Task -->
    <bpmn:userTask id="UserTask_NotifyStaffFoodReady" name="Angestellten informieren">
      <bpmn:name>Angestellten informieren</bpmn:name>
      <bpmn:description>Koch informiert Angestellte, dass Essen fertig ist.</bpmn:description>
      <bpmn:incoming>SequenceFlow_PlaceInPassThroughWindow_10</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Food Ready Gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_FoodReadyNotificationReceived" name="Info über fertiges Essen erhalten?">
      <bpmn:name>Info über fertiges Essen erhalten?</bpmn:name>
      <bpmn:description>Angestellter erhält Information von Küche.</bpmn:description>
      <bpmn:incoming>SequenceFlow_NotifyStaffFoodReady_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Trigger Pager Task -->
    <bpmn:userTask id="UserTask_TriggerGuestPager" name="Pieper des Gastes auslösen">
      <bpmn:name>Pieper des Gastes auslösen</bpmn:name>
      <bpmn:description>Angestellter löst Pieper aus, sobald Essen fertig ist.</bpmn:description>
      <bpmn:incoming>SequenceFlow_FoodReadyNotificationReceived_12</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Guest Response Gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_PagerResponseCheck" name="Gast reagiert auf Pieper?">
      <bpmn:name>Gast reagiert auf Pieper?</bpmn:name>
      <bpmn:description>Kunde antwortet auf Signal des Pagers.</bpmn:description>
      <bpmn:incoming>SequenceFlow_TriggerGuestPager_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Call Guest Task -->
    <bpmn:userTask id="UserTask_CallGuestAfter5Minutes" name="Gast nach 5 Minuten rufen">
      <bpmn:name>Gast nach 5 Minuten rufen</bpmn:name>
      <bpmn:description>Angestellter ruft Gast, falls nicht auf Pieper reagiert.</bpmn:description>
      <bpmn:incoming>SequenceFlow_PagerNoResponse_14</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_MealConsumed" name="Mahlzeit verzehrt">
      <bpmn:name>Mahlzeit verzehrt</bpmn:name>
      <bpmn:description>Gast hat Essen abgeholt und konsumiert.</bpmn:description>
    </bpmn:endEvent>

    <!-- Parallel Gateway -->
    <bpmn:parallelGateway id="ParallelGateway_KitchenStart_08" name="">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_InformCookAboutOrder_07</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_GuestWaitsForOrdering_01" name="" sourceRef="StartEvent_1" targetRef="UserTask_GuestWaitsForOrdering">
      <bpmn:description>Gast betritt Restaurant und wählt Gericht aus.</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_OrderPlacedWithStaff_02" name="" sourceRef="UserTask_GuestWaitsForOrdering" targetRef="UserTask_GuestPlacesOrder">
      <bpmn:description>Gast gibt Bestellung beim Angestellten auf.</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_EnterOrderInPOS_03" name="" sourceRef="UserTask_GuestPlacesOrder" targetRef="Task_EnterOrderInPOS">
      <bpmn:description>Angestellter gibt Bestellung ins Kassensystem ein.</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_CollectPayment_04" name="" sourceRef="Task_EnterOrderInPOS" targetRef="UserTask_CollectPayment">
      <bpmn:description>Zahlung wird vom Gast entgegengenommen.</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_PaymentSuccessful_05" name="ja, Zahlung erfolgreich" sourceRef="UserTask_CollectPayment" targetRef="ExclusiveGateway_PaymentSuccessful">
      <bpmn:description>Zahlung akzeptiert - Pieper wird eingestellt.</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_SetPagerForGuest_06" name="" sourceRef="ExclusiveGateway_PaymentSuccessful" targetRef="UserTask_SetPagerForGuest">
      <bpmn:description>Pieper wird an Gast übergeben.</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_InformCookAboutOrder_07" name="" sourceRef="UserTask_SetPagerForGuest" targetRef="ParallelGateway_KitchenStart_08">
      <bpmn:description>Koch wird über Bestellung informiert.</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Kitchen Tasks Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_KitchenStart_08" name="" sourceRef="ParallelGateway_KitchenStart_08" targetRef="Task_PrepareMeal">
      <bpmn:description>Koch beginnt mit Zubereitung.</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_PrepareMeal_09" name="" sourceRef="Task_PrepareMeal" targetRef="UserTask_PlaceInPassThroughWindow">
      <bpmn:description>Mahlzeit wird zubereitet.</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Kitchen Notification Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_NotifyStaffFoodReady_10" name="" sourceRef="UserTask_PlaceInPassThroughWindow" targetRef="ExclusiveGateway_FoodReadyNotificationReceived">
      <bpmn:description>Koch informiert Angestellten über fertiges Essen.</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Staff Trigger Pager Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_FoodReadyNotificationReceived_12" name="" sourceRef="ExclusiveGateway_FoodReadyNotificationReceived" targetRef="UserTask_TriggerGuestPager">
      <bpmn:description>Angestellter erhält Info und löst Pieper aus.</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Guest Response Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_TriggerGuestPager_13" name="" sourceRef="UserTask_TriggerGuestPager" targetRef="ExclusiveGateway_PagerResponseCheck">
      <bpmn:description>Pieper wird ausgelöst.</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Guest Response Check Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_GuestResponds_15" name="ja, reagiert auf Pieper" sourceRef="ExclusiveGateway_PagerResponseCheck" targetRef="EndEvent_MealConsumed">
      <bpmn:description>Gast kommt zur Ausgabe und holt Essen ab.</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Guest No Response Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_PagerNoResponse_14" name="nein, keine Reaktion nach 5 Minuten" sourceRef="ExclusiveGateway_PagerResponseCheck" targetRef="UserTask_CallGuestAfter5Minutes">
      <bpmn:description>Gast reagiert nicht auf Pieper.</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Call Guest Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_CalledBack_16" name="" sourceRef="UserTask_CallGuestAfter5Minutes" targetRef="ExclusiveGateway_PagerResponseCheck">
      <bpmn:description>Gast wird angerufen (mehrmals möglich).</bpmn:description>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>