<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_RestaurantProcess">
    <bpmn:participant id="Participant_Restaurant" name="Restaurant Process" processRef="Process_OrderProcessing"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_OrderProcessing" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Guest" name="Guest">
        <bpmn:flowNodeRef>StartEvent_HungryGuest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ChooseDish</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WaitForTurn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_HearBuzzer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GoToHatch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_MealEaten</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Employee" name="Employee">
        <bpmn:flowNodeRef>Task_PlaceOrderInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterPOS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CollectMoney</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SetupBuzzer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ReactionCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_CallGuestTimer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CallGuest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_HandoverReady</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HandoverMeal</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Chef" name="Chef">
        <bpmn:flowNodeRef>StartEvent_ReceiveOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareMeal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PlaceInHatch</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_HungryGuest" name="Hungry Guest Enters">
      <bpmn:description>A guest enters the restaurant feeling hungry.</bpmn:description>
      <bpmn:outgoing>SequenceFlow_ChooseDish</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_MealEaten" name="Meal Eaten">
      <bpmn:description>The guest has collected and eaten the meal.</bpmn:description>
      <bpmn:incoming>SequenceFlow_GuestLeaves</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Guest Lane Tasks -->
    <bpmn:userTask id="Task_ChooseDish" name="Choose Dish from Menu">
      <bpmn:description>Selects a dish from the changing meal range.</bpmn:description>
      <bpmn:incoming>SequenceFlow_ChooseDish</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitTurn</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:task id="Task_WaitForTurn" name="Wait Until Turn">
      <bpmn:description>Guest waits until it is their turn to order.</bpmn:description>
      <bpmn:incoming>SequenceFlow_WaitTurn</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PlaceOrderInteraction</bpmn:outgoing>
    </bpmn:task>

    <!-- Employee Lane Tasks -->
    <bpmn:userTask id="Task_PlaceOrderInfo" name="Place Order with Employee">
      <bpmn:description>Guest places order at the till.</bpmn:description>
      <bpmn:incoming>SequenceFlow_PlaceOrderInteraction</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EnterPOS</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:task id="Task_EnterPOS" name="Enter Order into POS">
      <bpmn:description>Employee enters order details.</bpmn:description>
      <bpmn:incoming>SequenceFlow_EnterPOS</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CollectMoney</bpmn:outgoing>
    </bpmn:task>

    <bpmn:userTask id="Task_CollectMoney" name="Collect Money">
      <bpmn:description>Employee collects payment from guest.</bpmn:description>
      <bpmn:incoming>SequenceFlow_CollectMoney</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SetupBuzzer</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Buzzer Setup -->
    <bpmn:task id="Task_SetupBuzzer" name="Set Up &amp; Handover Buzzer">
      <bpmn:description>Sets up buzzer and gives to guest with instructions.</bpmn:description>
      <bpmn:incoming>SequenceFlow_SetupBuzzer</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InformChef</bpmn:outgoing>
    </bpmn:task>

    <!-- Chef Lane Tasks -->
    <bpmn:startEvent id="StartEvent_ReceiveOrder" name="New Meal Order">
       <bpmn:description>Triggered when employee informs chef.</bpmn:description>
      <bpmn:incoming>SequenceFlow_InformChef</bpmn:incoming>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_PrepareMeal" name="Prepare Meal">
      <bpmn:description>Chef prepares the ordered meal.</bpmn:description>
      <bpmn:incoming>SequenceFlow_ReceiveOrder</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PlaceInHatch</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:task id="Task_PlaceInHatch" name="Place Meal in Service Hatch">
      <bpmn:description>Chef places finished meal and notifies employee.</bpmn:description>
      <bpmn:incoming>SequenceFlow_PlaceInHatch</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NotifyEmployeeReady</bpmn:outgoing>
    </bpmn:task>

    <!-- Guest Lane - Buzzer Reaction -->
    <bpmn:startEvent id="StartEvent_HearBuzzer" name="Hear Buzzer">
      <bpmn:description>Guest hears the buzzer signal.</bpmn:description>
      <bpmn:incoming>SequenceFlow_BuzzerRings</bpmn:incoming>
    </bpmn:startEvent>

    <!-- Exception Handling Timer -->
    <bpmn:intermediateTimerEvent id="Event_CallGuestTimer" name="5 Minutes Wait">
       <bpmn:description>If guest does not react within 5 minutes.</bpmn:description>
      <bpmn:incoming>SequenceFlow_WaitForReaction</bpmn:incoming>
    </bpmn:intermediateTimerEvent>

    <!-- Guest Lane - Hatch -->
    <bpmn:userTask id="Task_GoToHatch" name="Go to Service Hatch">
      <bpmn:description>Guest goes to service hatch upon hearing buzzer.</bpmn:description>
      <bpmn:incoming>SequenceFlow_HearBuzzer</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GoToHatchTask</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Employee Lane - Call Guest -->
    <bpmn:userTask id="Task_CallGuest" name="Call for Guest">
      <bpmn:description>Employee calls guest if no reaction after 5 mins.</bpmn:description>
      <bpmn:incoming>SequenceFlow_TimeoutReached</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CallGuestLoopBack</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Employee Lane - Handover -->
    <bpmn:userTask id="Task_HandoverMeal" name="Hand Over Meal">
      <bpmn:description>Employee hands meal to guest at hatch.</bpmn:description>
      <bpmn:incoming>SequenceFlow_GuestAtHatch</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MealEatenProcess</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateways -->
    <bpmn:exclusiveGateway id="Gateway_ReactionCheck" name="Guest Reacts?">
       <bpmn:description>Determines if guest reacts to buzzer.</bpmn:description>
      <bpmn:incoming>SequenceFlow_NotifyEmployeeReady</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BuzzerRings</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_WaitForReaction</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Handover Gateway -->
    <bpmn:parallelGateway id="Gateway_HandoverReady" name="Guest at Hatch?">
       <bpmn:description>Converges paths for handover.</bpmn:description>
      <bpmn:incoming>SequenceFlow_GuestAtHatch</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MealEatenProcess</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_ChooseDish" sourceRef="StartEvent_HungryGuest" targetRef="Task_ChooseDish">
      <bpmn:description>Guest chooses dish.</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_WaitTurn" sourceRef="Task_ChooseDish" targetRef="Task_WaitForTurn">
       <bpmn:description>Guest waits for turn.</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Interaction Guest to Employee -->
    <bpmn:sequenceFlow id="SequenceFlow_PlaceOrderInteraction" sourceRef="Task_WaitForTurn" targetRef="Task_PlaceOrderInfo">
      <bpmn:description>Guest places order with employee.</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Employee Process Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_EnterPOS" sourceRef="Task_PlaceOrderInfo" targetRef="Task_EnterPOS">
      <bpmn:description>Employee enters order.</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_CollectMoney" sourceRef="Task_EnterPOS" targetRef="Task_CollectMoney">
       <bpmn:description>Collect payment.</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Buzzer Setup -->
    <bpmn:sequenceFlow id="SequenceFlow_SetupBuzzer" sourceRef="Task_CollectMoney" targetRef="Task_SetupBuzzer">
      <bpmn:description>Set up buzzer.</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Inform Chef -->
    <bpmn:sequenceFlow id="SequenceFlow_InformChef" sourceRef="Task_SetupBuzzer" targetRef="StartEvent_ReceiveOrder">
      <bpmn:description>Employee informs chef of new order.</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Chef Process Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_ReceiveOrder" sourceRef="StartEvent_ReceiveOrder" targetRef="Task_PrepareMeal">
      <bpmn:description>Chef receives order notification.</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_PlaceInHatch" sourceRef="Task_PrepareMeal" targetRef="Task_PlaceInHatch">
      <bpmn:description>Chef prepares meal.</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Notify Employee Ready -->
    <bpmn:sequenceFlow id="SequenceFlow_NotifyEmployeeReady" sourceRef="Task_PlaceInHatch" targetRef="Gateway_ReactionCheck">
      <bpmn:description>Chef notifies employee meal is ready.</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Buzzer Logic -->
    <bpmn:sequenceFlow id="SequenceFlow_BuzzerRings" sourceRef="Gateway_ReactionCheck" targetRef="StartEvent_HearBuzzer">
      <bpmn:description>Buzzer rings for guest.</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Reaction Check -->
    <bpmn:sequenceFlow id="SequenceFlow_WaitForReaction" sourceRef="Gateway_ReactionCheck" targetRef="Event_CallGuestTimer">
      <bpmn:description>No reaction detected initially.</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Timeout to Call Guest -->
    <bpmn:sequenceFlow id="SequenceFlow_TimeoutReached" sourceRef="Event_CallGuestTimer" targetRef="Task_CallGuest">
      <bpmn:description>Timeout after 5 minutes.</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Guest Hearing Buzzer -->
    <bpmn:sequenceFlow id="SequenceFlow_HearBuzzer" sourceRef="StartEvent_HearBuzzer" targetRef="Task_GoToHatch">
      <bpmn:description>Guest hears buzzer.</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Guest Goes to Hatch -->
    <bpmn:sequenceFlow id="SequenceFlow_GoToHatchTask" sourceRef="Task_GoToHatch" targetRef="Gateway_HandoverReady"> 
      <bpmn:description>Guest goes to hatch.</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Call Guest Loop Back (Simplified) -->
    <bpmn:sequenceFlow id="SequenceFlow_CallGuestLoopBack" sourceRef="Task_CallGuest" targetRef="Gateway_ReactionCheck">
      <bpmn:description>Employee calls guest again.</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Final Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_MealEatenProcess" sourceRef="Task_HandoverMeal" targetRef="EndEvent_MealEaten">
      <bpmn:description>Guest eats meal.</bpmn:description>
    </bpmn:sequenceFlow>

  <!-- Data Objects -->
  <bpmn:dataObject id="Data_OrderInfo" name="Order Information"/>
  <bpmn:dataObject id="Data_PaymentStatus" name="Payment Status"/>

</bpmn:process>
</bpmn:definitions>