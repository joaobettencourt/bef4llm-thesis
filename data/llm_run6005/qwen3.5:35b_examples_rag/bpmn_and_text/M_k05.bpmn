<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_BuildingHouse_01" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_HouseBuilding_01">
    <bpmn:participant id="Participant_Homeowner" name="Homeowner Process" processRef="Process_BuildingHouse_01"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_BuildingHouse_01" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Planning_Construction">
      <bpmn:lane id="Lane_DesignPhase" name="Design & Planning">
        <bpmn:flowNodeRef>StartEvent_CollectRequirements</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendToArchitect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CatchEvent_ReceiveDraft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_DraftFinalized</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RefineRequirements</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_ExecutionPhase" name="Construction & Party">
        <bpmn:flowNodeRef>Task_CreateMaterialsList</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_OrderAndBuildSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceOrderMaterial1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendBuildersInvites</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CatchEvent_HouseBuilt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_BuildingComplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendPartyInvites</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateGuestList</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_CollectRequirements" name="Collect Requirements">
      <bpmn:outgoing>Seq_SendToArchitect</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Send to Architect -->
    <bpmn:task id="Task_SendToArchitect" name="Send requirements&#10;to architect">
      <bpmn:incoming>Seq_SendToArchitect</bpmn:incoming>
      <bpmn:outgoing>Seq_WaitDraftMsg</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Catch Event for Draft -->
    <bpmn:startEvent id="CatchEvent_ReceiveDraft" name="Architect sends draft">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>Seq_WaitDraftMsg</bpmn:incoming>
      <bpmn:outgoing>Seq_CheckFinalized</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Gateway for Draft Finalization -->
    <bpmn:exclusiveGateway id="Gw_DraftFinalized" name="Draft final?">
      <bpmn:incoming>Seq_CheckFinalized</bpmn:incoming>
      <bpmn:outgoing>Seq_RefineLoop</bpmn:outgoing> <!-- No -->
      <bpmn:outgoing>Seq_CreateMaterialsListFlow</bpmn:outgoing> <!-- Yes (Default) -->
    </bpmn:exclusiveGateway>

    <!-- Task Refinement Loop -->
    <bpmn:task id="Task_RefineRequirements" name="Refine requirements">
      <bpmn:incoming>Seq_RefineLoop</bpmn:incoming>
      <bpmn:outgoing>Seq_SendToArchitectAgain</bpmn:outgoing> <!-- Loop back to send -->
    </bpmn:task>

    <!-- Task Create Materials List (After Plan Final) -->
    <bpmn:task id="Task_CreateMaterialsList" name="Create materials&#10;list">
      <bpmn:incoming>Seq_CheckFinalized</bpmn:incoming>
      <bpmn:outgoing>Seq_SplitOrderBuild</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Split for Ordering and Building -->
    <bpmn:parallelGateway id="Gw_OrderAndBuildSplit" name="">
      <bpmn:incoming>Seq_SplitOrderBuild</bpmn:incoming>
      <bpmn:outgoing>Seq_OrderMaterials1Flow</bpmn:outgoing> <!-- Material 1 -->
      <bpmn:outgoing>Seq_SendBuildersInvitesFlow</bpmn:outgoing> <!-- Builders Invite -->
    </bpmn:parallelGateway>

    <!-- Ordering Materials (Parallel) - Simplified to one task for valid flow in single pool context without external pools defined fully -->
    <bpmn:serviceTask id="ServiceOrderMaterial1" name="Order materials&#10;(Category 1)">
      <bpmn:incoming>Seq_OrderMaterials1Flow</bpmn:incoming>
      <bpmn:outgoing>Seq_MaterialsConvergeIn</bpmn:outgoing> <!-- Simplified convergence -->
    </bpmn:serviceTask>

    <!-- Send Builders Invites (Parallel Branch) -->
    <bpmn:task id="Task_SendBuildersInvites" name="Send messages&#10;to friends">
      <bpmn:incoming>Seq_SendBuildersInvitesFlow</bpmn:incoming>
      <bpmn:outgoing>Seq_WaitHouseBuiltTrigger</bpmn:outgoing> <!-- Implicitly triggers build -->
    </bpmn:task>

    <!-- Intermediate Catch Event for House Built (External Trigger) - Simplified to StartEvent in single pool context or Task completion logic. Using End of Build as trigger. -->
    <bpmn:startEvent id="CatchEvent_HouseBuilt" name="House built">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>Seq_WaitHouseBuiltTrigger</bpmn:incoming> <!-- Simplified convergence logic for valid XML flow -->
      <bpmn:outgoing>Seq_GoToPartyPrepFlow</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Convergence Gateway for Party Prep (Simplified) -->
    <bpmn:exclusiveGateway id="Gw_BuildingComplete" name="">
      <bpmn:incoming>Seq_GoToPartyPrepFlow</bpmn:incoming>
      <bpmn:outgoing>Seq_SendPartyInvitesFinal</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task Send Party Invitations -->
    <bpmn:task id="Task_SendPartyInvites" name="Send invitations&#10;for party">
      <bpmn:incoming>Seq_GoToPartyPrepFlow</bpmn:incoming>
      <bpmn:outgoing>Seq_CreateGuestListFinal</bpmn:outgoing>
    </bpmn:task>

    <!-- Task Create Guest List -->
    <bpmn:task id="Task_CreateGuestList" name="Create guest&#10;list">
      <bpmn:incoming>Seq_SendPartyInvitesFinal</bpmn:incoming>
      <bpmn:outgoing>Seq_EndProcessFlow</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="End_Event_PartyPrep" name="Party prepared">
      <bpmn:incoming>Seq_CreateGuestListFinal</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Seq_SendToArchitect" sourceRef="StartEvent_CollectRequirements" targetRef="Task_SendToArchitect">
      <bpmn:name>Collect & Send</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Loop Back Flow -->
    <bpmn:sequenceFlow id="Seq_RefineLoop" sourceRef="Gw_DraftFinalized" targetRef="Task_RefineRequirements">
      <bpmn:name>No</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Final Plan Flow -->
    <bpmn:sequenceFlow id="Seq_CheckFinalized" sourceRef="Gw_DraftFinalized" targetRef="Task_CreateMaterialsList">
      <bpmn:name>Yes</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Split Flow -->
    <bpmn:sequenceFlow id="Seq_SplitOrderBuild" sourceRef="Task_CreateMaterialsList" targetRef="Gw_OrderAndBuildSplit">
      <bpmn:name>Create List</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Ordering Flow -->
    <bpmn:sequenceFlow id="Seq_OrderMaterials1Flow" sourceRef="Gw_OrderAndBuildSplit" targetRef="ServiceOrderMaterial1">
      <bpmn:name>Order Mat 1</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Builders Flow -->
    <bpmn:sequenceFlow id="Seq_SendBuildersInvitesFlow" sourceRef="Gw_OrderAndBuildSplit" targetRef="Task_SendBuildersInvites">
      <bpmn:name>Invite Friends</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Party Prep Flow -->
    <bpmn:sequenceFlow id="Seq_GoToPartyPrepFlow" sourceRef="Gw_BuildingComplete" targetRef="Task_SendPartyInvites">
      <bpmn:name>Houses Ready</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Guest List Flow -->
    <bpmn:sequenceFlow id="Seq_CreateGuestListFinal" sourceRef="Task_SendPartyInvites" targetRef="End_Event_PartyPrep">
      <bpmn:name>Create List</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>