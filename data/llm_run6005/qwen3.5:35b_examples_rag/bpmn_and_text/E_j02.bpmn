<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_MaternityLeave_01" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_MaternityProcess_01">
    <bpmn:participant id="Participant_ParentsProcess" name="Maternity Leave Process" processRef="Process_MaternityLeave_01"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_MaternityLeave_01" isExecutable="false">
    <bpmn:startEvent id="Start_Event_ParentsDecision" name="Parent Decides to Take Leave">
      <bpmn:outgoing>SequenceFlow_FetchInfo</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_FetchModels" name="Fetch Information About Potential Models">
      <bpmn:description>Determine months duration and split between parents</bpmn:description>
      <bpmn:incoming>SequenceFlow_FetchInfo</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SelectModel</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_ParentSelect" name="Parent Selects Model">
      <bpmn:incoming>SequenceFlow_SelectModel</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CollectInfo</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_CollectInformation" name="Collect Relevant Information">
      <bpmn:description>Gather necessary documentation for application</bpmn:description>
      <bpmn:incoming>SequenceFlow_CollectInfo</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NotifyParallel</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:parallelGateway id="Gw_NotificationSplit" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow_NotifyParallel</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SocialSecurity</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CompanyNotification</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:serviceTask id="Task_NotifySocialSecurity" name="Notify Social Security">
      <bpmn:description>In time notification required by law</bpmn:description>
      <bpmn:incoming>SequenceFlow_SocialSecurity</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GatherFeedbackSS</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="Task_NotifyCompany" name="Notify Company">
      <bpmn:description>In time notification required by employer policy</bpmn:description>
      <bpmn:incoming>SequenceFlow_CompanyNotification</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GatherFeedbackComp</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="Task_GatherSSInfo" name="Gather Information from Social Security">
      <bpmn:description>Collect confirmation and details about benefits</bpmn:description>
      <bpmn:incoming>SequenceFlow_GatherFeedbackSS</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConvergeNotifications1</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="Task_GatherCompanyInfo" name="Gather Information from Company">
      <bpmn:description>Collect confirmation and details about employment terms</bpmn:description>
      <bpmn:incoming>SequenceFlow_GatherFeedbackComp</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConvergeNotifications2</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:parallelGateway id="Gw_NotificationConverge" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow_ConvergeNotifications1</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ConvergeNotifications2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_LeavePeriodStart</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:userTask id="Task_MaternityLeave" name="Maternity Leave Period">
      <bpmn:description>The actual maternity leave period takes place here</bpmn:description>
      <bpmn:incoming>SequenceFlow_LeavePeriodStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DecideExtension</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gw_DecideExtension" gatewayDirection="Diverging">
      <bpmn:description>Decision point at end of leave period</bpmn:description>
      <bpmn:incoming>SequenceFlow_DecideExtension</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ExtendLeave</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_EndProcess</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_ExtensionApplication" name="Apply for Extension">
      <bpmn:description>Submit application to extend maternity leave period</bpmn:description>
      <bpmn:incoming>SequenceFlow_ExtendLeave</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProcessExtensionApproval</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="Task_ApprovalProcess" name="Process Extension Approval">
      <bpmn:description>Social Security and Company review extension request</bpmn:description>
      <bpmn:incoming>SequenceFlow_ProcessExtensionApproval</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ExtendedLeaveStart</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="Task_ExtendedMaternity" name="Extended Maternity Leave">
      <bpmn:description>The extended leave period takes place here</bpmn:description>
      <bpmn:incoming>SequenceFlow_ExtendedLeaveStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FinalEndProcess</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="End_Event_ProcessComplete" name="Maternity Leave Process Complete">
      <bpmn:description>All leave periods concluded successfully</bpmn:description>
      <bpmn:incoming>SequenceFlow_FinalEndProcess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_FetchInfo" sourceRef="Start_Event_ParentsDecision" targetRef="Task_FetchModels"/>

    <bpmn:sequenceFlow id="SequenceFlow_SelectModel" sourceRef="Task_FetchModels" targetRef="Task_ParentSelect"/>

    <bpmn:sequenceFlow id="SequenceFlow_CollectInfo" sourceRef="Task_ParentSelect" targetRef="Task_CollectInformation"/>

    <bpmn:sequenceFlow id="SequenceFlow_NotifyParallel" sourceRef="Task_CollectInformation" targetRef="Gw_NotificationSplit"/>

    <bpmn:sequenceFlow id="SequenceFlow_SocialSecurity" sourceRef="Gw_NotificationSplit" targetRef="Task_NotifySocialSecurity"/>

    <bpmn:sequenceFlow id="SequenceFlow_CompanyNotification" sourceRef="Gw_NotificationSplit" targetRef="Task_NotifyCompany"/>

    <bpmn:sequenceFlow id="SequenceFlow_GatherFeedbackSS" sourceRef="Task_NotifySocialSecurity" targetRef="Task_GatherSSInfo"/>

    <bpmn:sequenceFlow id="SequenceFlow_GatherFeedbackComp" sourceRef="Task_NotifyCompany" targetRef="Task_GatherCompanyInfo"/>

    <bpmn:sequenceFlow id="SequenceFlow_ConvergeNotifications1" sourceRef="Task_GatherSSInfo" targetRef="Gw_NotificationConverge"/>

    <bpmn:sequenceFlow id="SequenceFlow_ConvergeNotifications2" sourceRef="Task_GatherCompanyInfo" targetRef="Gw_NotificationConverge"/>

    <bpmn:sequenceFlow id="SequenceFlow_LeavePeriodStart" sourceRef="Gw_NotificationConverge" targetRef="Task_MaternityLeave"/>

    <bpmn:sequenceFlow id="SequenceFlow_DecideExtension" sourceRef="Task_MaternityLeave" targetRef="Gw_DecideExtension"/>

    <bpmn:sequenceFlow id="SequenceFlow_ExtendLeave" name="Yes - Extend Leave" sourceRef="Gw_DecideExtension" targetRef="Task_ExtensionApplication">
      <bpmn:description>Parent decides to extend</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_EndProcess" name="No - End Process" sourceRef="Gw_DecideExtension" targetRef="End_Event_ProcessComplete">
      <bpmn:description>No extension needed</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ProcessExtensionApproval" sourceRef="Task_ExtensionApplication" targetRef="Task_ApprovalProcess"/>

    <bpmn:sequenceFlow id="SequenceFlow_ExtendedLeaveStart" sourceRef="Task_ApprovalProcess" targetRef="Task_ExtendedMaternity"/>

    <bpmn:sequenceFlow id="SequenceFlow_FinalEndProcess" sourceRef="Task_ExtendedMaternity" targetRef="End_Event_ProcessComplete"/>
  </bpmn:process>
</bpmn:definitions>