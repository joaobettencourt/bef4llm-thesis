<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ViennaNightRun_01" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_NightRun_01">
    <bpmn:participant id="Participant_RunnerProcess" name="Vienna Night Run App Process" processRef="Process_ViennaNightRun_01" />
  </bpmn:collaboration>

  <bpmn:process id="Process_ViennaNightRun_01" isExecutable="false">
    <!-- Lane Set for different actors -->
    <bpmn:laneSet id="LaneSet_RunnerApp_01">
      <bpmn:lane id="Lane_Participant" name="Participant">
        <bpmn:flowNodeRef>StartEvent_AppLaunch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_SelectStartingBlock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_TimeCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_TrainAndRecheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_GetStartingNumber</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_AppSystem" name="App System">
        <bpmn:flowNodeRef>ServiceTask_Run5kmMeasureTime</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_CheckWorkSchedule</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_FitnessGadget" name="Fitness Gadget">
        <bpmn:flowNodeRef>ServiceTask_Run5kmMeasureTime</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_AppLaunch" name="App Launch">
      <bpmn:outgoing>SequenceFlow_SelectStartingBlock</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Select Starting Block (User Input) -->
    <bpmn:userTask id="UserTask_SelectStartingBlock" name="Select Starting Block">
      <bpmn:incoming>SequenceFlow_SelectStartingBlock</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StartRun</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Run 5km and Measure Time (Fitness Gadget) -->
    <bpmn:serviceTask id="ServiceTask_Run5kmMeasureTime" name="Run 5km &amp; Measure Time">
      <bpmn:incoming>SequenceFlow_StartRun</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TimeMeasured</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Check if time is less than 25 minutes -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_TimeCheck" name="Time &lt; 25 min?">
      <bpmn:incoming>SequenceFlow_TimeMeasured</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GoToStartingNumber</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_TrainAndRecheck</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Train and Re-check (Loop if time not achieved) -->
    <bpmn:userTask id="UserTask_TrainAndRecheck" name="Train &amp; Check Again">
      <bpmn:incoming>SequenceFlow_TrainAndRecheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StartRunLoop</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Get Starting Number -->
    <bpmn:userTask id="UserTask_GetStartingNumber" name="Get Starting Number">
      <bpmn:incoming>SequenceFlow_GoToStartingNumber</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckWorkSchedule</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Check Work Schedule for Transportation Decision -->
    <bpmn:userTask id="UserTask_CheckWorkSchedule" name="Check Work End Time">
      <bpmn:incoming>SequenceFlow_CheckWorkSchedule</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TransportDecision</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Decision: More than 1 hour between start and work end -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_Transport" name="More than 1 hr?">
      <bpmn:incoming>SequenceFlow_TransportDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GoFromHome</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_LeaveFromWork</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Go from Home -->
    <bpmn:userTask id="UserTask_GoFromHome" name="Go to Race from Home">
      <bpmn:incoming>SequenceFlow_GoFromHome</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StartRace</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Leave Directly from Work -->
    <bpmn:userTask id="UserTask_LeaveFromWork" name="Leave Race from Work">
      <bpmn:incoming>SequenceFlow_LeaveFromWork</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StartRace2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Run at Night Run (Parallel Activities) -->
    <bpmn:parallelGateway id="ParallelGateway_RaceStart" name="">
      <bpmn:incoming>SequenceFlow_StartRace</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RunDuringRace</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_DrinkDuringRace</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Run During Race -->
    <bpmn:userTask id="UserTask_RunDuringRace" name="Run at Night Run">
      <bpmn:incoming>SequenceFlow_StartRace2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RaceComplete1</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Drink During Race -->
    <bpmn:userTask id="UserTask_DrinkDuringRace" name="Drink at Night Run">
      <bpmn:incoming>SequenceFlow_DrinkDuringRace</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RaceComplete2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel Gateway to converge -->
    <bpmn:parallelGateway id="ParallelGateway_RaceEnd" name="">
      <bpmn:incoming>SequenceFlow_RaceComplete1</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_RaceComplete2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FinalTime</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Receive Final Running Time -->
    <bpmn:userTask id="UserTask_ReceiveFinalTime" name="Receive Final Running Time">
      <bpmn:incoming>SequenceFlow_FinalTime</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndProcess</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_ProcessComplete" name="Race Complete">
      <bpmn:incoming>SequenceFlow_EndProcess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_SelectStartingBlock" sourceRef="StartEvent_AppLaunch" targetRef="UserTask_SelectStartingBlock" />

    <bpmn:sequenceFlow id="SequenceFlow_StartRun" name="" sourceRef="UserTask_SelectStartingBlock" targetRef="ServiceTask_Run5kmMeasureTime" />

    <bpmn:sequenceFlow id="SequenceFlow_TimeMeasured" name="" sourceRef="ServiceTask_Run5kmMeasureTime" targetRef="ExclusiveGateway_TimeCheck" />

    <bpmn:sequenceFlow id="SequenceFlow_GoToStartingNumber" name="Yes, &lt; 25 min" sourceRef="ExclusiveGateway_TimeCheck" targetRef="UserTask_GetStartingNumber" />

    <bpmn:sequenceFlow id="SequenceFlow_TrainAndRecheck" name="No, train again" sourceRef="ExclusiveGateway_TimeCheck" targetRef="UserTask_TrainAndRecheck" />

    <bpmn:sequenceFlow id="SequenceFlow_StartRunLoop" name="" sourceRef="UserTask_TrainAndRecheck" targetRef="ServiceTask_Run5kmMeasureTime" />

    <bpmn:sequenceFlow id="SequenceFlow_CheckWorkSchedule" name="" sourceRef="UserTask_GetStartingNumber" targetRef="UserTask_CheckWorkSchedule" />

    <bpmn:sequenceFlow id="SequenceFlow_TransportDecision" name="" sourceRef="UserTask_CheckWorkSchedule" targetRef="ExclusiveGateway_Transport" />

    <bpmn:sequenceFlow id="SequenceFlow_GoFromHome" name="Yes, &gt; 1 hr left" sourceRef="ExclusiveGateway_Transport" targetRef="UserTask_GoFromHome" />

    <bpmn:sequenceFlow id="SequenceFlow_LeaveFromWork" name="No, leave from work" sourceRef="ExclusiveGateway_Transport" targetRef="UserTask_LeaveFromWork" />

    <bpmn:sequenceFlow id="SequenceFlow_StartRace" name="" sourceRef="UserTask_GoFromHome" targetRef="ParallelGateway_RaceStart" />

    <bpmn:sequenceFlow id="SequenceFlow_StartRace2" name="" sourceRef="UserTask_LeaveFromWork" targetRef="ParallelGateway_RaceStart" />

    <bpmn:sequenceFlow id="SequenceFlow_RunDuringRace" name="" sourceRef="ParallelGateway_RaceStart" targetRef="UserTask_RunDuringRace" />

    <bpmn:sequenceFlow id="SequenceFlow_DrinkDuringRace" name="" sourceRef="ParallelGateway_RaceStart" targetRef="UserTask_DrinkDuringRace" />

    <bpmn:sequenceFlow id="SequenceFlow_RaceComplete1" name="" sourceRef="UserTask_RunDuringRace" targetRef="ParallelGateway_RaceEnd" />

    <bpmn:sequenceFlow id="SequenceFlow_RaceComplete2" name="" sourceRef="UserTask_DrinkDuringRace" targetRef="ParallelGateway_RaceEnd" />

    <bpmn:sequenceFlow id="SequenceFlow_FinalTime" name="" sourceRef="ParallelGateway_RaceEnd" targetRef="UserTask_ReceiveFinalTime" />

    <bpmn:sequenceFlow id="SequenceFlow_EndProcess" name="" sourceRef="UserTask_ReceiveFinalTime" targetRef="EndEvent_ProcessComplete" />
  </bpmn:process>
</bpmn:definitions>