<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_BlizzardCharacter_02" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_CharacterCreation_02">
    <bpmn:participant id="Participant_UserProcess_02" name="User Character Creation Process" processRef="Process_BlizzardCharacter_02" />
  </bpmn:collaboration>

  <bpmn:process id="Process_BlizzardCharacter_02" isExecutable="false">
    <bpmn:laneSet id="LaneSet_UserActions_02">
      <bpmn:lane id="Lane_AccountSetup_01" name="Account Setup &amp; Payment">
        <bpmn:flowNodeRef>StartEvent_CharacterCreation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_CheckBattleNet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterAccountInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_ConfirmationMailLinkClick</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_CheckSubscription</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_SelectPaymentMethod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterCreditCardInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterIBANBIC</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_CharacterCreation_01" name="Character Creation">
        <bpmn:flowNodeRef>Gw_ParallelSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterNamesLoop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_NameAvailableCheck</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_GameAccess_01" name="Game Access">
        <bpmn:flowNodeRef>Task_LogInAndSelectCharacter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_ConvergenceFinal</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_CharacterCreation" name="Create WoW Character">
      <bpmn:outgoing>SequenceFlow_StartToParallel</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Parallel Gateway for two simultaneous activities -->
    <bpmn:parallelGateway id="Gw_ParallelSplit" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow_StartToParallel</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow_AccountSetupPath</bpmn:outgoing>
          <bpmn:outgoing>SequenceFlow_CharacterCreationPath</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Check Battle.net Account -->
    <bpmn:exclusiveGateway id="Gw_CheckBattleNet" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow_AccountSetupPath</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow_HasAccountYes</bpmn:outgoing>
          <bpmn:outgoing>SequenceFlow_NoBattleNet</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Enter Account Information -->
    <bpmn:userTask id="Task_EnterAccountInfo" name="Enter account information">
      <bpmn:incoming>SequenceFlow_NoBattleNet</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow_WaitForConfirmationLink</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Confirmation Mail Link Click -->
    <bpmn:messageEvent id="Event_ConfirmationMailLinkClick" name="Confirm via mail link">
      <bpmn:incoming>SequenceFlow_WaitForConfirmationLink</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow_AccountConfirmed</bpmn:outgoing>
    </bpmn:messageEvent>

    <!-- Check WoW Subscription -->
    <bpmn:exclusiveGateway id="Gw_CheckSubscription" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow_HasAccountYes</bpmn:outgoing>
        <bpmn:incoming>SequenceFlow_AccountConfirmed</bpmn:outgoing>
          <bpmn:outgoing>SequenceFlow_SubscriptionActiveYes</bpmn:outgoing>
            <bpmn:outgoing>SequenceFlow_NoSubscription</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Select Payment Method -->
    <bpmn:exclusiveGateway id="Gw_SelectPaymentMethod" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow_NoSubscription</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow_CreditCardOption</bpmn:outgoing>
          <bpmn:outgoing>SequenceFlow_BankAccountOption</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Enter Credit Card Info -->
    <bpmn:userTask id="Task_EnterCreditCardInfo" name="Enter credit card information">
      <bpmn:incoming>SequenceFlow_CreditCardOption</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow_PaymentComplete_CC</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Enter IBAN and BIC -->
    <bpmn:userTask id="Task_EnterIBANBIC" name="Enter IBAN and BIC numbers">
      <bpmn:incoming>SequenceFlow_BankAccountOption</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow_PaymentComplete_Bank</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Character Name Entry Loop -->
    <bpmn:userTask id="Task_EnterNamesLoop" name="Enter character names">
      <bpmn:incoming>SequenceFlow_CharacterCreationPath</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow_NameCheckAvailable</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Check Name Availability -->
    <bpmn:exclusiveGateway id="Gw_NameAvailableCheck" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow_NameCheckAvailable</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow_NameNotAvailableLoop</bpmn:outgoing>
          <bpmn:outgoing>SequenceFlow_NameAvailableYes</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Log In and Select Character -->
    <bpmn:userTask id="Task_LogInAndSelectCharacter" name="Log in, select realm/race/class">
      <bpmn:incoming>SequenceFlow_SubscriptionActiveYes</bpmn:outgoing>
        <bpmn:incoming>SequenceFlow_PaymentComplete_CC</bpmn:outgoing>
          <bpmn:incoming>SequenceFlow_PaymentComplete_Bank</bpmn:outgoing>
            <bpmn:outgoing>SequenceFlow_ConvergenceFinalPath</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Final Convergence -->
    <bpmn:exclusiveGateway id="Gw_ConvergenceFinal" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow_NameAvailableYes</bpmn:outgoing>
        <bpmn:incoming>SequenceFlow_ConvergenceFinalPath</bpmn:outgoing>
          <bpmn:outgoing>SequenceFlow_FinalToEndEvent</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_CharacterCreated" name="Character Created">
      <bpmn:incoming>SequenceFlow_FinalToEndEvent</bpmn:outgoing>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToParallel" sourceRef="StartEvent_CharacterCreation" targetRef="Gw_ParallelSplit" />

    <bpmn:sequenceFlow id="SequenceFlow_AccountSetupPath" name="Account Setup Path" sourceRef="Gw_ParallelSplit" targetRef="Gw_CheckBattleNet" />

    <bpmn:sequenceFlow id="SequenceFlow_CharacterCreationPath" name="Character Creation Path" sourceRef="Gw_ParallelSplit" targetRef="Task_EnterNamesLoop" />

    <bpmn:sequenceFlow id="SequenceFlow_HasAccountYes" name="Has Battle.net account? Yes" sourceRef="Gw_CheckBattleNet" targetRef="Gw_CheckSubscription" />

    <bpmn:sequenceFlow id="SequenceFlow_NoBattleNet" name="No battle.net account" sourceRef="Gw_CheckBattleNet" targetRef="Task_EnterAccountInfo" />

    <bpmn:sequenceFlow id="SequenceFlow_WaitForConfirmationLink" sourceRef="Task_EnterAccountInfo" targetRef="Event_ConfirmationMailLinkClick" />

    <bpmn:sequenceFlow id="SequenceFlow_AccountConfirmed" name="Confirm via mail link" sourceRef="Event_ConfirmationMailLinkClick" targetRef="Gw_CheckSubscription" />

    <bpmn:sequenceFlow id="SequenceFlow_SubscriptionActiveYes" name="Has active subscription? Yes" sourceRef="Gw_CheckSubscription" targetRef="Task_LogInAndSelectCharacter" />

    <bpmn:sequenceFlow id="SequenceFlow_NoSubscription" name="No active subscription" sourceRef="Gw_CheckSubscription" targetRef="Gw_SelectPaymentMethod" />

    <bpmn:sequenceFlow id="SequenceFlow_CreditCardOption" name="Credit card payment method" sourceRef="Gw_SelectPaymentMethod" targetRef="Task_EnterCreditCardInfo" />

    <bpmn:sequenceFlow id="SequenceFlow_BankAccountOption" name="Bank account payment method" sourceRef="Gw_SelectPaymentMethod" targetRef="Task_EnterIBANBIC" />

    <bpmn:sequenceFlow id="SequenceFlow_PaymentComplete_CC" sourceRef="Task_EnterCreditCardInfo" targetRef="Task_LogInAndSelectCharacter" />

    <bpmn:sequenceFlow id="SequenceFlow_PaymentComplete_Bank" sourceRef="Task_EnterIBANBIC" targetRef="Task_LogInAndSelectCharacter" />

    <bpmn:sequenceFlow id="SequenceFlow_NameCheckAvailable" name="Enter names one by one" sourceRef="Task_EnterNamesLoop" targetRef="Gw_NameAvailableCheck" />

    <bpmn:sequenceFlow id="SequenceFlow_NameNotAvailableLoop" name="Name not available, try another" sourceRef="Gw_NameAvailableCheck" targetRef="Task_EnterNamesLoop" />

    <bpmn:sequenceFlow id="SequenceFlow_NameAvailableYes" name="Name is still available" sourceRef="Gw_NameAvailableCheck" targetRef="Gw_ConvergenceFinal" />

    <bpmn:sequenceFlow id="SequenceFlow_FinalToEndEvent" name="Character selection complete" sourceRef="Task_LogInAndSelectCharacter" targetRef="Gw_ConvergenceFinal" />
  </bpmn:process>
</bpmn:definitions>