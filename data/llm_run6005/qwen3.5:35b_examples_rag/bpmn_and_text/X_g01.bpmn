<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                 xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" 
                 xmlns:di="http://www.omg.org/spec/DD/20100524/DI" 
                 xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" 
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 id="Definitions_NewApplication_01" targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:collaboration id="Collab_SportsInstitute_Reg_01">
    <bpmn:participant id="Participant_UserProcess" name="Sports Institute Registration Process" processRef="Process_NewApplication_01"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_NewApplication_01" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="Start_Event_RegApp" name="Register Application">
      <bpmn:outgoing>Seq_CheckCourse</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Check Course Availability & Select One -->
    <bpmn:task id="Task_CheckSelectCourse" name="Check Course Availability and Select">
      <bpmn:incoming>Seq_CheckCourse</bpmn:incoming>
      <bpmn:outgoing>Seq_HasAccountDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Has Existing Account? -->
    <bpmn:exclusiveGateway id="Gw_HasExistingAccount" name="Has existing account?" gatewayDirection="Diverging">
      <bpmn:incoming>Seq_HasAccountDecision</bpmn:incoming>
      <bpmn:outgoing>Seq_LoginPathYes</bpmn:outgoing>
      <bpmn:outgoing>Seq_CheckEligibilityNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Path Yes: Login -->
    <bpmn:task id="Task_Login" name="Log Into System">
      <bpmn:incoming>Seq_LoginPathYes</bpmn:incoming>
      <bpmn:outgoing>Seq_TwitterDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Path No: Check Eligibility -->
    <bpmn:task id="Task_CheckEligibility" name="Check University Registration">
      <bpmn:incoming>Seq_CheckEligibilityNo</bpmn:incoming>
      <bpmn:outgoing>Seq_IsEligibleDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2: Is Eligible? -->
    <bpmn:exclusiveGateway id="Gw_IsEligible" name="Is registered at eligible university?" gatewayDirection="Diverging">
      <bpmn:incoming>Seq_IsEligibleDecision</bpmn:incoming>
      <bpmn:outgoing>Seq_RegisterAccountYes</bpmn:outgoing>
      <bpmn:outgoing>Seq_RequestActivationNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sub-Path Yes: Register Account -->
    <bpmn:task id="Task_RegisterAccount" name="Register Your Account">
      <bpmn:incoming>Seq_RegisterAccountYes</bpmn:incoming>
      <bpmn:outgoing>Seq_AccountReadyMerge1</bpmn:outgoing>
    </bpmn:task>

    <!-- Sub-Path No: Request Activation & Wait -->
    <bpmn:task id="Task_RequestActivation" name="Request Activation and Wait for Response">
      <bpmn:incoming>Seq_RequestActivationNo</bpmn:incoming>
      <bpmn:outgoing>Seq_AccountReadyMerge2</bpmn:outgoing>
    </bpmn:task>

    <!-- Convergence Gateway -->
    <bpmn:exclusiveGateway id="Gw_ConvergeAccount" gatewayDirection="Converging">
      <bpmn:incoming>Seq_AccountReadyMerge1</bpmn:incoming>
      <bpmn:incoming>Seq_AccountReadyMerge2</bpmn:incoming>
      <bpmn:outgoing>Seq_LoginPathYes</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Twitter Decision Gateway -->
    <bpmn:exclusiveGateway id="Gw_TweetFriends" name="Tweet friends?" gatewayDirection="Diverging">
      <bpmn:incoming>Seq_TwitterDecision</bpmn:incoming>
      <bpmn:outgoing>Seq_SendTweetsYes</bpmn:outgoing>
      <bpmn:outgoing>Seq_SkipTweetNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Send Tweets -->
    <bpmn:task id="Task_TweetFriends" name="Tweet to Friends">
      <bpmn:incoming>Seq_SendTweetsYes</bpmn:incoming>
      <bpmn:outgoing>Seq_MergeToPayment</bpmn:outgoing>
    </bpmn:task>

    <!-- Merge Tweet Path -->
    <bpmn:exclusiveGateway id="Gw_ConvergeTweet" gatewayDirection="Converging">
      <bpmn:incoming>Seq_SkipTweetNo</bpmn:incoming>
      <bpmn:incoming>Seq_MergeToPayment</bpmn:incoming>
      <bpmn:outgoing>Seq_CompleteRegistration</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Final Task -->
    <bpmn:task id="Task_CompleteReg" name="Complete Registration and Payment">
      <bpmn:incoming>Seq_CompleteRegistration</bpmn:incoming>
      <bpmn:outgoing>Seq_ReceiveTicket</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="End_Event_Ticket" name="Course Ticket Received">
      <bpmn:incoming>Seq_ReceiveTicket</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Seq_CheckCourse" sourceRef="Start_Event_RegApp" targetRef="Task_CheckSelectCourse"/>
    
    <bpmn:sequenceFlow id="Seq_HasAccountDecision" sourceRef="Task_CheckSelectCourse" targetRef="Gw_HasExistingAccount"/>

    <!-- Login Path (Yes) -->
    <bpmn:sequenceFlow id="Seq_LoginPathYes" sourceRef="Gw_ConvergeAccount" targetRef="Task_Login">
      <bpmn:conditionExpression>${hasAccount}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Check Eligibility Path (No) -->
    <bpmn:sequenceFlow id="Seq_CheckEligibilityNo" sourceRef="Gw_HasExistingAccount" targetRef="Task_CheckEligibility">
      <bpmn:conditionExpression>${!hasAccount}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Eligible Path (Yes) -->
    <bpmn:sequenceFlow id="Seq_RegisterAccountYes" sourceRef="Gw_IsEligible" targetRef="Task_RegisterAccount">
      <bpmn:conditionExpression>${isRegistered}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Not Eligible Path (No) -->
    <bpmn:sequenceFlow id="Seq_RequestActivationNo" sourceRef="Gw_IsEligible" targetRef="Task_RequestActivation">
      <bpmn:conditionExpression>${!isRegistered}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Account Ready Merge 1 -->
    <bpmn:sequenceFlow id="Seq_AccountReadyMerge1" sourceRef="Task_RegisterAccount" targetRef="Gw_ConvergeAccount"/>
    
    <!-- Account Ready Merge 2 -->
    <bpmn:sequenceFlow id="Seq_AccountReadyMerge2" sourceRef="Task_RequestActivation" targetRef="Gw_ConvergeAccount"/>

    <!-- Twitter Path -->
    <bpmn:sequenceFlow id="Seq_TwitterDecision" sourceRef="Task_Login" targetRef="Gw_TweetFriends"/>

    <!-- Send Tweets Yes -->
    <bpmn:sequenceFlow id="Seq_SendTweetsYes" sourceRef="Gw_TweetFriends" targetRef="Task_TweetFriends">
      <bpmn:conditionExpression>${tweet}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Skip Tweet No -->
    <bpmn:sequenceFlow id="Seq_SkipTweetNo" sourceRef="Gw_TweetFriends" targetRef="Gw_ConvergeTweet">
      <bpmn:conditionExpression>${!tweet}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Merge to Payment -->
    <bpmn:sequenceFlow id="Seq_MergeToPayment" sourceRef="Task_TweetFriends" targetRef="Gw_ConvergeTweet"/>

    <!-- Final Steps -->
    <bpmn:sequenceFlow id="Seq_CompleteRegistration" sourceRef="Gw_ConvergeTweet" targetRef="Task_CompleteReg"/>
    
    <bpmn:sequenceFlow id="Seq_ReceiveTicket" sourceRef="Task_CompleteReg" targetRef="End_Event_Ticket"/>

  </bpmn:process>
</bpmn:definitions>