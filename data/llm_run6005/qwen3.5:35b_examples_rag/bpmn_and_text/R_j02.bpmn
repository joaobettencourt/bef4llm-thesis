<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_InspectionApp_01" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_MachineInspection_01">
    <bpmn:participant id="Participant_AppUser" name="Machine Inspection App User" processRef="Process_InspectionApp_01"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_InspectionApp_01" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_InitiateInspection" name="Initiate Inspection">
      <bpmn:outgoing>SequenceFlow_EnterDetails</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- User Task: Enter Machine Details -->
    <bpmn:userTask id="UserTask_EnterMachineDetails" name="Enter Machine Type &amp; Serial Number">
      <bpmn:incoming>SequenceFlow_EnterDetails</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StartCollection</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Service Task: Collect Values from Machine -->
    <bpmn:serviceTask id="Service_CollectMachineValues" name="Collect Automatic Values">
      <bpmn:description>Buttons pressed, values collected automatically</bpmn:description>
      <bpmn:incoming>SequenceFlow_StartCollection</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckResults</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Exclusive Gateway: Check Results -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_InspectionCheck" name="Additional Questions Needed?">
      <bpmn:incoming>SequenceFlow_CheckResults</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AskQuestions</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_InspectComplete</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- User Task: Ask Additional Questions -->
    <bpmn:userTask id="UserTask_AdditionalInquiries" name="Ask Additional Questions">
      <bpmn:description>User inputs values based on inspection results</bpmn:description>
      <bpmn:incoming>SequenceFlow_AskQuestions</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReEvaluateResults</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_InspectionComplete" name="Inspection Complete">
      <bpmn:incoming>SequenceFlow_InspectComplete</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_EnterDetails" sourceRef="StartEvent_InitiateInspection" targetRef="UserTask_EnterMachineDetails"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_StartCollection" sourceRef="UserTask_EnterMachineDetails" targetRef="Service_CollectMachineValues"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_CheckResults" sourceRef="Service_CollectMachineValues" targetRef="ExclusiveGateway_InspectionCheck"/>

    <!-- Branch 1: Additional Questions Needed -->
    <bpmn:sequenceFlow id="SequenceFlow_AskQuestions" name="Yes, Ask More" sourceRef="ExclusiveGateway_InspectionCheck" targetRef="UserTask_AdditionalInquiries"/>

    <!-- Branch 2: Inspection Complete -->
    <bpmn:sequenceFlow id="SequenceFlow_InspectComplete" name="No, Finish" sourceRef="ExclusiveGateway_InspectionCheck" targetRef="EndEvent_InspectionComplete"/>

    <!-- Loop Back from Additional Questions -->
    <bpmn:sequenceFlow id="SequenceFlow_ReEvaluateResults" sourceRef="UserTask_AdditionalInquiries" targetRef="ExclusiveGateway_InspectionCheck"/>

  </bpmn:process>
</bpmn:definitions>