<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_MPO_Process">
    <bpmn:participant id="Participant_MPO" name="MPO Process" processRef="Process_ChangeRequest"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_ChangeRequest" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Change Request Received">
      <bpmn:outgoing>SequenceFlow_StartToReview</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Review Change Request -->
    <bpmn:task id="Task_MPO_Review" name="MPO Reviews Change">
      <bpmn:description>MPO reviews the change request from SP/PU/GO or self-initiated</bpmn:description>
      <bpmn:incoming>SequenceFlow_StartToReview</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReviewToDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway for Decision -->
    <bpmn:exclusiveGateway id="Gateway_Decision" name="Change Request Approval">
      <bpmn:description>MPO decides to reject or confirm the change request</bpmn:description>
      <bpmn:incoming>SequenceFlow_ReviewToDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RejectPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ConfirmPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event 1: Rejection -->
    <bpmn:endEvent id="EndEvent_Rejected" name="Change Request Rejected">
      <bpmn:description>Process ends after rejection and notification</bpmn:description>
      <bpmn:incoming>SequenceFlow_NotifyFailureToComplete</bpmn:outgoing> <!-- Fixed tag mismatch -->
    </bpmn:endEvent>

    <!-- Task 2: Perform Measuring Point Change (if confirmed) -->
    <bpmn:task id="Task_MPO_Change" name="Perform Measuring Point Change">
      <bpmn:description>MPO executes the approved measuring point change</bpmn:description>
      <bpmn:incoming>SequenceFlow_ConfirmPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ChangeToReport</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway for Implementation Status -->
    <bpmn:exclusiveGateway id="Gateway_Status" name="Implementation Status Check">
      <bpmn:description>Determine if implementation was successful or failed</bpmn:description>
      <bpmn:incoming>SequenceFlow_ChangeToReport</bpmn:outgoing> <!-- Fixed tag mismatch -->
      <bpmn:outgoing>SequenceFlow_SuccessPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_FailurePath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 3a: Report Implementation Success -->
    <bpmn:task id="Task_Report_Success" name="Report Successful Implementation">
      <bpmn:description>MPO reports successful implementation to SP/PU/GO</bpmn:description>
      <bpmn:incoming>SequenceFlow_SuccessPath</bpmn:outgoing> <!-- Fixed tag mismatch -->
      <bpmn:outgoing>SequenceFlow_ReportSuccessToComplete</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3b: Report Implementation Failure (Initial Rejection or Execution Fail) -->
    <bpmn:task id="Task_Notify_Failure" name="Notify Change Failure">
      <bpmn:description>MPO notifies SP/PU/GO about failure of changes</bpmn:description>
      <bpmn:incoming>SequenceFlow_RejectPath</bpmn:outgoing> <!-- Fixed tag mismatch -->
      <bpmn:outgoing>SequenceFlow_ReportFailureToComplete</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 2: Process Completed Successfully -->
    <bpmn:endEvent id="EndEvent_Success" name="Change Request Completed">
      <bpmn:description>Process ends after successful implementation and reporting</bpmn:description>
      <bpmn:incoming>SequenceFlow_ReportSuccessToComplete</bpmn:outgoing> <!-- Fixed tag mismatch -->
    </bpmn:endEvent>

    <!-- End Event 3: Process Ended Due to Failure/Rejection -->
    <bpmn:endEvent id="EndEvent_Failure" name="Change Request Failed">
      <bpmn:description>Process ends after failure notification</bpmn:description>
      <bpmn:incoming>SequenceFlow_ReportFailureToComplete</bpmn:outgoing> <!-- Fixed tag mismatch -->
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    
    <!-- Start to Review -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToReview" name="" sourceRef="StartEvent_1" targetRef="Task_MPO_Review">
      <bpmn:description>MPO receives and reviews change request</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Review to Decision -->
    <bpmn:sequenceFlow id="SequenceFlow_ReviewToDecision" name="" sourceRef="Task_MPO_Review" targetRef="Gateway_Decision">
      <bpmn:description>MPO completes review and makes decision</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Decision Paths -->
    
    <!-- Reject Path (Initial Rejection) -> Notify Failure Task -> End Event Failed -->
    <bpmn:sequenceFlow id="SequenceFlow_RejectPath" name="Reject Request" sourceRef="Gateway_Decision" targetRef="Task_Notify_Failure">
      <bpmn:description>MPO rejects the change request</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Confirm Path -> Perform Change -->
    <bpmn:sequenceFlow id="SequenceFlow_ConfirmPath" name="Confirm Request" sourceRef="Gateway_Decision" targetRef="Task_MPO_Change">
      <bpmn:description>MPO confirms the change request</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Post-Decision Paths -->
    
    <!-- Perform Change to Status Check -->
    <bpmn:sequenceFlow id="SequenceFlow_ChangeToReport" name="" sourceRef="Task_MPO_Change" targetRef="Gateway_Status">
      <bpmn:description>MPO completes measuring point change</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Success Reporting Path -->
    <bpmn:sequenceFlow id="SequenceFlow_SuccessPath" name="Implementation Successful" sourceRef="Gateway_Status" targetRef="Task_Report_Success">
      <bpmn:description>MPO reports successful implementation to SP/PU/GO</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Failure Reporting Path (Execution Fail) -->
    <bpmn:sequenceFlow id="SequenceFlow_FailurePath" name="Implementation Failed" sourceRef="Gateway_Status" targetRef="Task_Notify_Failure">
      <bpmn:description>MPO notifies SP/PU/GO about failure of changes</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Final Sequence Flows to End Events -->
    
    <!-- Success Reporting Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_ReportSuccessToComplete" name="" sourceRef="Task_Report_Success" targetRef="EndEvent_Success">
      <bpmn:description>Process completes after successful reporting</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Failure Reporting Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_NotifyFailureToComplete" name="" sourceRef="Task_Notify_Failure" targetRef="EndEvent_Rejected">
      <bpmn:description>Process ends after failure notification to SP/PU/GO</bpmn:description>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>