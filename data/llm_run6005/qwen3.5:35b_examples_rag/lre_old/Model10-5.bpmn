<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_MPON_MPOO">
    <bpmn:participant id="Participant_MPON" name="MPON" processRef="Process_MPON"/>
    <bpmn:participant id="Participant_MPOO" name="MPOO" processRef="Process_MPOO"/>

    <!-- Message Flows -->
    <bpmn:messageFlow id="MessageFlow_RequestBid" sourceRef="IntermediateThrowEvent_1" targetRef="StartCatchEvent_1">
      <bpmn:name>Device Takeover Bid Request</bpmn:name>
    </bpmn:messageFlow>

    <bpmn:messageFlow id="MessageFlow_Tender" sourceRef="IntermediateThrowEvent_2" targetRef="IntermediateCatchEvent_1">
      <bpmn:name>Tender for Equipment Takeover</bpmn:name>
    </bpmn:messageFlow>

    <bpmn:messageFlow id="MessageFlow_Order" sourceRef="IntermediateThrowEvent_3" targetRef="StartCatchEvent_2">
      <bpmn:name>Order Placement Request</bpmn:name>
    </bpmn:messageFlow>

    <bpmn:messageFlow id="MessageFlow_Confirmation" sourceRef="IntermediateThrowEvent_4" targetRef="IntermediateCatchEvent_2">
      <bpmn:name>Order Confirmation and Master Data</bpmn:name>
    </bpmn:messageFlow>
  </bpmn:collaboration>

  <!-- MPON Process -->
  <bpmn:process id="Process_MPON" isExecutable="false">
    <bpmn:startEvent id="StartNone_1" name="Request Device Takeover Bid Initiated">
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_MPON_RequestBid" name="Request device takeover bid of MPOO">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:intermediateThrowEvent id="IntermediateThrowEvent_1" name="Send Bid Request">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <!-- Wait for tender -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_1" name="Receive Tender">
      <bpmn:incoming>MessageFlow_Tender</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:task id="Task_MPON_PlaceOrder" name="Place order at MPOO">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
    </bpmn:task>

    <!-- Send Order -->
    <bpmn:intermediateThrowEvent id="IntermediateThrowEvent_3" name="Send Order">
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <!-- Wait for confirmation -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_2" name="Receive Confirmation">
      <bpmn:name>Order Confirmation and Master Data Received</bpmn:name>
      <bpmn:incoming>MessageFlow_Confirmation</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_8</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- End Event -->
    <bpmn:endEvent id="EndNone_MPON" name="Order Process Completed">
      <bpmn:incoming>SequenceFlow_9</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="StartNone_1" targetRef="Task_MPON_RequestBid"/>
    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="Task_MPON_RequestBid" targetRef="IntermediateThrowEvent_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="IntermediateThrowEvent_1" targetRef="IntermediateCatchEvent_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="IntermediateCatchEvent_1" targetRef="Task_MPON_PlaceOrder"/>
    <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="Task_MPON_PlaceOrder" targetRef="IntermediateThrowEvent_3"/>
    <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="IntermediateThrowEvent_3" targetRef="IntermediateCatchEvent_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_7" sourceRef="Task_MPON_PlaceOrder" targetRef="EndNone_MPON"/>
  </bpmn:process>

  <!-- MPOO Process -->
  <bpmn:process id="Process_MPOO" isExecutable="false">
    <bpmn:startEvent id="StartCatchEvent_1" name="Receive Bid Request">
      <bpmn:name>Device Takeover Bid Received</bpmn:name>
      <bpmn:incoming>MessageFlow_RequestBid</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MPOO_1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Prepare tender -->
    <bpmn:task id="Task_MPOO_PrepareTender" name="Send tender for equipment takeover to MPON">
      <bpmn:name>Prepare device takeover bid</bpmn:name>
      <bpmn:incoming>SequenceFlow_MPOO_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MPOO_2</bpmn:outgoing>
    </bpmn:task>

    <!-- Send tender -->
    <bpmn:intermediateThrowEvent id="IntermediateThrowEvent_2" name="Send Tender">
      <bpmn:name>Tender Sent to MPON</bpmn:name>
      <bpmn:incoming>SequenceFlow_MPOO_3</bpmn:incoming>
    </bpmn:intermediateThrowEvent>

    <!-- Wait for order -->
    <bpmn:startEvent id="StartCatchEvent_2" name="Receive Order">
      <bpmn:name>Order Received from MPON</bpmn:name>
      <bpmn:incoming>MessageFlow_Order</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MPOO_4</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Confirm order and send master data -->
    <bpmn:task id="Task_MPOO_ConfirmOrder" name="Confirm order of MPON">
      <bpmn:name>Send confirmation with master data to MPON</bpmn:name>
      <bpmn:incoming>SequenceFlow_MPOO_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MPOO_5</bpmn:outgoing>
    </bpmn:task>

    <!-- Send confirmation -->
    <bpmn:intermediateThrowEvent id="IntermediateThrowEvent_4" name="Send Confirmation">
      <bpmn:name>Confirmation and Master Data Sent to MPON</bpmn:name>
      <bpmn:incoming>SequenceFlow_MPOO_6</bpmn:incoming>
    </bpmn:intermediateThrowEvent>

    <!-- End Event -->
    <bpmn:endEvent id="EndNone_MPOO" name="MPOO Order Processing Complete">
      <bpmn:name>MPOO Order Process Completed</bpmn:name>
      <bpmn:incoming>SequenceFlow_MPOO_7</bpmn:outgoing>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_MPOO_1" sourceRef="StartCatchEvent_1" targetRef="Task_MPOO_PrepareTender"/>
    <bpmn:sequenceFlow id="SequenceFlow_MPOO_2" sourceRef="Task_MPOO_PrepareTender" targetRef="IntermediateThrowEvent_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_MPOO_3" sourceRef="StartCatchEvent_1" targetRef="IntermediateThrowEvent_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_MPOO_4" sourceRef="StartCatchEvent_2" targetRef="Task_MPOO_ConfirmOrder"/>
    <bpmn:sequenceFlow id="SequenceFlow_MPOO_5" sourceRef="Task_MPOO_ConfirmOrder" targetRef="IntermediateThrowEvent_4"/>
    <bpmn:sequenceFlow id="SequenceFlow_MPOO_6" sourceRef="StartCatchEvent_2" targetRef="EndNone_MPOO"/>
  </bpmn:process>

</bpmn:definitions>