<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_ComputerRepair">
    <bpmn:participant id="Participant_RepairProcess" name="Computer Repair Process" processRef="Process_ComputerRepair" />
  </bpmn:collaboration>

  <bpmn:process id="Process_ComputerRepair" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="Start_CustomerBringsDefectiveComputer" name="Customer brings defective computer">
      <bpmn:outgoing>Flow_CheckCost</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: CRS checks defect and calculates cost -->
    <bpmn:task id="Task_CRSCheckDefect" name="CRS checks defect &amp; calculate repair costs">
      <bpmn:incoming>Flow_CheckCost</bpmn:incoming>
      <bpmn:outgoing>Gateway_DecisionAcceptable</bpmn:outgoing>
    </bpmn:task>

    <!-- Decision Gateway for cost acceptance -->
    <bpmn:exclusiveGateway id="Gateway_DecisionAcceptable" name="Costs acceptable?">
      <bpmn:incoming>Flow_CostCalculated</bpmn:incoming>
      <bpmn:outgoing>Flow_StartRepairProcess</bpmn:outgoing>
      <bpmn:outgoing>Flow_CustomerTakesHomeUnrepaired</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event 1: Customer takes home unrepaired -->
    <bpmn:endEvent id="End_CustomerTakesHome" name="Customer takes computer home (unrepaired)">
      <bpmn:name>Computer taken home</bpmn:name>
      <bpmn:incoming>Flow_CustomerTakesHomeUnrepaired</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Parallel Gateway for two repair activities in arbitrary order -->
    <bpmn:parallelGateway id="Parallel_StartRepairActivities" name="Start Repair Activities">
      <bpmn:name>Merge After Testing</bpmn:name>
      <bpmn:incoming>Flow_StartRepairProcess</bpmn:incoming>
      <bpmn:outgoing>Flow_HardwareCheck</bpmn:outgoing>
      <bpmn:outgoing>Flow_SoftwareConfig</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 2a: Check and repair hardware -->
    <bpmn:task id="Task_HardwareCheck" name="Check &amp; repair hardware">
      <bpmn:name>Error Repair Activity</bpmn:name>
      <bpmn:incoming>Flow_HardwareCheck</bpmn:incoming>
      <bpmn:outgoing>Gateway_TestHardwareResult</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2b: Check and configure software -->
    <bpmn:task id="Task_SoftwareConfig" name="Check &amp; configure software">
      <bpmn:name>Error Repair Activity Software</bpmn:name>
      <bpmn:incoming>Flow_SoftwareConfig</bpmn:incoming>
      <bpmn:outgoing>Gateway_TestSoftwareResult</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for hardware test result -->
    <bpmn:exclusiveGateway id="Gateway_TestHardwareResult" name="Test Hardware Result">
      <bpmn:name>Error Repair Activity</bpmn:name>
      <bpmn:incoming>Flow_HardwareCheckComplete</bpmn:incoming>
      <bpmn:outgoing>Flow_ErrorDetectedHardware</bpmn:outgoing>
      <bpmn:outgoing>Flow_NoErrorHardware</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Gateway for software test result -->
    <bpmn:exclusiveGateway id="Gateway_TestSoftwareResult" name="Test Software Result">
      <bpmn:name>Error Repair Activity Software</bpmn:name>
      <bpmn:incoming>Flow_SoftwareCheckComplete</bpmn:incoming>
      <bpmn:outgoing>Flow_ErrorDetectedSoftware</bpmn:outgoing>
      <bpmn:outgoing>Flow_NoErrorSoftware</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task for error repair (arbitrary) -->
    <bpmn:task id="Task_ErrorRepair" name="Execute additional hardware repair">
      <bpmn:name>Error Repair Activity Hardware</bpmn:name>
      <bpmn:incoming>Flow_ErrorDetectedHardware</bpmn:incoming>
      <bpmn:outgoing>Gateway_TestHardwareResultLoopback</bpmn:outgoing>
    </bpmn:task>

    <!-- Task for error repair (arbitrary) -->
    <bpmn:task id="Task_ErrorRepairSoftware" name="Execute additional software repair">
      <bpmn:name>Error Repair Activity Software Loop</bpmn:name>
      <bpmn:incoming>Flow_ErrorDetectedSoftware</bpmn:incoming>
      <bpmn:outgoing>Gateway_TestSoftwareResultLoopback</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway to merge repair activities -->
    <bpmn:parallelGateway id="Parallel_MergeRepairActivities" name="Merge Repair Activities">
      <bpmn:name>Merge After Testing</bpmn:name>
      <bpmn:incoming>Flow_NoErrorHardware</bpmn:incoming>
      <bpmn:incoming>Flow_NoErrorSoftware</bpmn:incoming>
    </bpmn:parallelGateway>

    <!-- Final Test Gateway -->
    <bpmn:exclusiveGateway id="Gateway_FinalTest" name="Final System Functionality Test">
      <bpmn:name>System Functional?</bpmn:name>
      <bpmn:incoming>Flow_MergeComplete</bpmn:incoming>
      <bpmn:outgoing>Flow_RepairFinished</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event 2: Repair finished -->
    <bpmn:endEvent id="End_RepairFinished" name="Repair completed successfully">
      <bpmn:name>Computer repaired</bpmn:name>
      <bpmn:incoming>Flow_RepairFinished</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Flow_CheckCost" sourceRef="Start_CustomerBringsDefectiveComputer" targetRef="Task_CRSCheckDefect" />
    <bpmn:sequenceFlow id="Flow_CostCalculated" name="cost calculated" sourceRef="Task_CRSCheckDefect" targetRef="Gateway_DecisionAcceptable" />
    <bpmn:sequenceFlow id="Flow_StartRepairProcess" name="Costs acceptable - yes" sourceRef="Gateway_DecisionAcceptable" targetRef="Parallel_StartRepairActivities" />
    <bpmn:sequenceFlow id="Flow_CustomerTakesHomeUnrepaired" name="Costs not acceptable - no" sourceRef="Gateway_DecisionAcceptable" targetRef="End_CustomerTakesHome" />

    <!-- Repair Activities -->
    <bpmn:sequenceFlow id="Flow_HardwareCheck" sourceRef="Parallel_StartRepairActivities" targetRef="Task_HardwareCheck" />
    <bpmn:sequenceFlow id="Flow_SoftwareConfig" sourceRef="Parallel_StartRepairActivities" targetRef="Task_SoftwareConfig" />

    <!-- Testing Flows -->
    <bpmn:sequenceFlow id="Flow_HardwareCheckComplete" name="Hardware check complete" sourceRef="Task_HardwareCheck" targetRef="Gateway_TestHardwareResult" />
    <bpmn:sequenceFlow id="Flow_ErrorDetectedHardware" name="Error detected - yes" sourceRef="Gateway_TestHardwareResult" targetRef="Task_ErrorRepair" />
    <bpmn:sequenceFlow id="Flow_NoErrorHardware" name="No error - no" sourceRef="Gateway_TestHardwareResult" targetRef="Parallel_MergeRepairActivities" />

    <!-- Software Testing Flows -->
    <bpmn:sequenceFlow id="Flow_SoftwareCheckComplete" name="Software check complete" sourceRef="Task_SoftwareConfig" targetRef="Gateway_TestSoftwareResult" />
    <bpmn:sequenceFlow id="Flow_ErrorDetectedSoftware" name="Error detected - yes" sourceRef="Gateway_TestSoftwareResult" targetRef="Task_ErrorRepairSoftware" />
    <bpmn:sequenceFlow id="Flow_NoErrorSoftware" name="No error - no" sourceRef="Gateway_TestSoftwareResult" targetRef="Parallel_MergeRepairActivities" />

    <!-- Loopback Flows for Error Repair -->
    <bpmn:sequenceFlow id="Loopback_HardwareTest" sourceRef="Task_ErrorRepair" targetRef="Gateway_TestHardwareResult" name="Re-test hardware" />
    <bpmn:sequenceFlow id="Loopback_SoftwareTest" sourceRef="Task_ErrorRepairSoftware" targetRef="Gateway_TestSoftwareResult" name="Re-test software" />

    <!-- Merge and Final Test -->
    <bpmn:sequenceFlow id="Flow_MergeComplete" sourceRef="Parallel_MergeRepairActivities" targetRef="Gateway_FinalTest" />
    <bpmn:sequenceFlow id="Flow_RepairFinished" name="System functional - yes" sourceRef="Gateway_FinalTest" targetRef="End_RepairFinished" />

  </bpmn:process>
</bpmn:definitions>