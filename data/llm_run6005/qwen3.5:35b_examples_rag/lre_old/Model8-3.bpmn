<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_VacancyProcess">
    <bpmn:participant id="Participant_HRDepartment" name="HR Department Process" processRef="Process_VacancyManagement"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_VacancyManagement" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_HRManager" name="HR Manager">
        <bpmn:flowNodeRef>StartEvent_PersonnelRequirements</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReportVacancy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ReviewDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateCatchEvent_WaitingForDescription</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProvideClarifications</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CorrectionDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateCatchEvent_WaitingForApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AdvertiseJobDescription</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_PersonnelRequirements" name="Personnel Requirements Detected">
      <bpmn:outgoing>SequenceFlow_ReportVacancy</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Report vacancy -->
    <bpmn:task id="Task_ReportVacancy" name="Report Vacancy to Personnel Department">
      <bpmn:incoming>SequenceFlow_ReportVacancy</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitForDescription</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Catch Event 1: Wait for job description -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_WaitingForDescription" name="Wait for Job Description">
      <bpmn:incoming>SequenceFlow_WaitForDescription</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToReviewDecision</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Gateway 1: Review Decision -->
    <bpmn:exclusiveGateway id="Gateway_ReviewDecision" name="Job Description Ready?">
      <bpmn:incoming>SequenceFlow_ToReviewDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_HaveQuestions</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 2: Provide clarifications -->
    <bpmn:task id="Task_ProvideClarifications" name="Provide Clarifications to HR">
      <bpmn:incoming>SequenceFlow_HaveQuestions</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToReviewDecisionAgain</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2: Correction Decision -->
    <bpmn:exclusiveGateway id="Gateway_CorrectionDecision" name="Corrections Required?">
      <bpmn:incoming>SequenceFlow_ToReviewDecisionAgain</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ApproveDescription</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Intermediate Catch Event 2: Wait for approval -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_WaitingForApproval" name="Wait for Approval">
      <bpmn:incoming>SequenceFlow_ApproveDescription</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AdvertiseJob</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task 3: Advertise job description -->
    <bpmn:endEvent id="EndEvent_JobAdvertised" name="Job Advertised">
      <bpmn:incoming>SequenceFlow_AdvertiseJob</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_ReportVacancy" sourceRef="StartEvent_PersonnelRequirements" targetRef="Task_ReportVacancy"/>
    <bpmn:sequenceFlow id="SequenceFlow_WaitForDescription" sourceRef="Task_ReportVacancy" targetRef="IntermediateCatchEvent_WaitingForDescription"/>
    <bpmn:sequenceFlow id="SequenceFlow_ToReviewDecision" sourceRef="IntermediateCatchEvent_WaitingForDescription" targetRef="Gateway_ReviewDecision"/>
    <bpmn:sequenceFlow id="SequenceFlow_HaveQuestions" name="HR has questions" sourceRef="Gateway_ReviewDecision" targetRef="Task_ProvideClarifications"/>
    <bpmn:sequenceFlow id="SequenceFlow_ToReviewDecisionAgain" sourceRef="Task_ProvideClarifications" targetRef="Gateway_CorrectionDecision"/>
    <bpmn:sequenceFlow id="SequenceFlow_ApproveDescription" name="No corrections needed" sourceRef="Gateway_CorrectionDecision" targetRef="IntermediateCatchEvent_WaitingForApproval"/>
    <bpmn:sequenceFlow id="SequenceFlow_AdvertiseJob" sourceRef="IntermediateCatchEvent_WaitingForApproval" targetRef="EndEvent_JobAdvertised"/>

  </bpmn:process>
</bpmn:definitions>