<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_RestaurantProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_001">
    <bpmn:participant id="Participant_Main" name="Restaurant Process" processRef="Process_Main"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Main" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Guest" name="Guest">
        <bpmn:flowNodeRef>StartEvent_Arrives</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ChooseDish</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PlaceOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_WaitBuzzer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CheckPickup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PickUpMeal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Eat</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Employee" name="Employee">
        <bpmn:flowNodeRef>Task_EnterPOS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CollectMoney</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SetBuzzerHandover</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_SplitOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Wait5Min</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CallGuestEscalation</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Chef" name="Chef">
        <bpmn:flowNodeRef>Task_InformChef</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareMeal</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Guest Lane Start -->
    <bpmn:startEvent id="StartEvent_Arrives" name="Guest Arrives">
      <bpmn:outgoing>Flow_StartToChoose</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_ChooseDish" name="Choose Dish from Menu">
      <bpmn:incoming>Flow_StartToChoose</bpmn:incoming>
      <bpmn:outgoing>Flow_ChosenOrder</bpmn:outgoing>
    </bpmn:task>

    <!-- Interaction to Employee -->
    <bpmn:sequenceFlow id="Flow_ChosenOrder" sourceRef="Task_ChooseDish" targetRef="Task_PlaceOrder">
      <bpmn:name>Place Order</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Employee Lane Tasks -->
    <bpmn:task id="Task_EnterPOS" name="Enter Order in POS System">
      <bpmn:incoming>Flow_ChosenOrder</bpmn:incoming>
      <bpmn:outgoing>Flow_CollectMoney</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="Flow_CollectMoney" sourceRef="Task_EnterPOS" targetRef="Task_CollectPayment"/>

    <bpmn:task id="Task_CollectPayment" name="Collect Money from Guest">
      <bpmn:incoming>Flow_CollectMoney</bpmn:incoming>
      <bpmn:outgoing>Flow_SetBuzzer</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="Flow_SetBuzzer" sourceRef="Task_CollectPayment" targetRef="Task_SetBuzzerHandover"/>

    <bpmn:task id="Task_SetBuzzerHandover" name="Set Buzzer &amp; Handover to Guest">
      <bpmn:incoming>Flow_SetBuzzer</bpmn:incoming>
      <bpmn:outgoing>Flow_SplitOrderProcess</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Split for Kitchen and Waiting Logic -->
    <bpmn:parallelGateway id="InclusiveGateway_SplitOrder" name="Start Cooking &amp; Wait">
      <bpmn:incoming>Flow_SplitOrderProcess</bpmn:incoming>
      <bpmn:outgoing>Flow_InformChef</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Inform Chef -->
    <bpmn:sequenceFlow id="Flow_InformChef" sourceRef="InclusiveGateway_SplitOrder" targetRef="Task_InformChef"/>

    <bpmn:task id="Task_InformChef" name="Inform Chef of New Order">
      <bpmn:incoming>Flow_InformChef</bpmn:incoming>
      <bpmn:outgoing>Flow_PrepareMealStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Chef Lane -->
    <bpmn:sequenceFlow id="Flow_PrepareMealStart" sourceRef="Task_InformChef" targetRef="Task_PrepareMeal"/>

    <bpmn:task id="Task_PrepareMeal" name="Prepare Meal &amp; Place in Hatch">
      <bpmn:incoming>Flow_PrepareMealStart</bpmn:incoming>
      <bpmn:outgoing>Flow_NotifyReadyToEmployee</bpmn:outgoing>
    </bpmn:task>

    <!-- Notification to Employee -->
    <bpmn:endEvent id="EndEvent_ChefDone">
      <bpmn:name>Meal Ready</bpmn:name>
      <bpmn:incoming>Flow_NotifyReadyToEmployee</bpmn:outgoing>
    </bpmn:endEvent>

    <!-- Correction for valid sequence logic within one process pool without message flows between lanes (internal communication) -->
    <bpmn:startEvent id="Start_Event2" name="Order Approved">
        <bpmn:outgoing>Flow_Approved</bpmn:outgoing> 
      </bpmn:startEvent>

  </bpmn:process>
  
  <!-- Redefining the Process content cleanly below to match BPMN rules without duplicate IDs in same scope -->
</definitions>