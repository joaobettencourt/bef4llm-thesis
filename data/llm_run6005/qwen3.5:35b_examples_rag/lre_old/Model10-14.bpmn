<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_BillProcessing">
    <bpmn:participant id="Participant_MPOO" name="MPOO" processRef="Process_MPOO"/>
    <bpmn:participant id="Participant_MSPO" name="MSPO" processRef="Process_MSPO"/>
    <bpmn:participant id="Participant_GO" name="GO" processRef="Process_GO"/>
    <bpmn:participant id="Participant_MPON" name="MPON" processRef="Process_MPON"/>

    <!-- Message Flows -->
    <bpmn:messageFlow id="Message_MPOO_TO_GO_Bill1" sourceRef="Task_MPOO_SendBill1" targetRef="IntermediateCatchEvent_GO_ReceiveBill1"/>
    <bpmn:messageFlow id="Message_MSPO_TO_GO_Bill2" sourceRef="Task_MSPO_SendBill2" targetRef="IntermediateCatchEvent_GO_ReceiveBill2"/>
    <bpmn:messageFlow id="Message_MSPO_TO_GO_Bill3" sourceRef="Task_MSPO_SendBill3" targetRef="IntermediateCatchEvent_GO_ReceiveBill3"/>
    <bpmn:messageFlow id="Message_MPOO_TO_MPON_Go_Equip" sourceRef="Task_MPOO_SendBill4" targetRef="IntermediateCatchEvent_MPON_OR_GO_ReceiveEquip"/>

  </bpmn:collaboration>

  <!-- MPOO Process -->
  <bpmn:process id="Process_MPOO" isExecutable="false">
    <bpmn:startEvent id="StartMPOO_1">
      <bpmn:name>MPOO Bill Initiation</bpmn:name>
      <bpmn:outgoing>SequenceFlow_StartToBillSend</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- MPOO sends bill for temporary continuation of metering point operations -->
    <bpmn:task id="Task_MPOO_SendBill1" name="Send Bill - Temporary Continuation Metering Operations">
      <bpmn:name>MPOO Send Bill (Temp Cont. Metering)</bpmn:name>
      <bpmn:incoming>SequenceFlow_StartToBillSend</bpmn:outgoing>
    </bpmn:task>

    <!-- MPOO sends bill for equipment acquisition -->
    <bpmn:task id="Task_MPOO_SendBill4" name="Send Bill - Equipment Acquisition">
      <bpmn:name>MPOO Send Bill (Equipment)</bpmn:name>
      <bpmn:incoming>SequenceFlow_StartToBillSend</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for MPOO bill types -->
    <bpmn:exclusiveGateway id="Gateway_MPOO_BillTypes">
      <bpmn:name>MPOO Bill Type?</bpmn:name>
      <bpmn:incoming>SequenceFlow_StartToBillSend</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ToTempMetering</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ToEquipment</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- MPOO receives confirmation/rejection -->
    <bpmn:endEvent id="End_Event_MPOO_Receipt">
      <bpmn:name>MPOO Receives Invoice Decision</bpmn:name>
      <bpmn:incoming>SequenceFlow_ConfirmRejectReceived</bpmn:outgoing>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToBillSend" sourceRef="StartMPOO_1" targetRef="Gateway_MPOO_BillTypes"/>
    <bpmn:sequenceFlow id="SequenceFlow_ToTempMetering" name="Temporary Continuation Metering Operations" sourceRef="Gateway_MPOO_BillTypes" targetRef="Task_MPOO_SendBill1"/>
    <bpmn:sequenceFlow id="SequenceFlow_ToEquipment" name="Equipment Acquisition" sourceRef="Gateway_MPOO_BillTypes" targetRef="Task_MPOO_SendBill4"/>

  </bpmn:process>

  <!-- MSPO Process -->
  <bpmn:process id="Process_MSPO" isExecutable="false">
    <bpmn:startEvent id="StartMSPO_1">
      <bpmn:name>MSPO Bill Initiation</bpmn:name>
      <bpmn:outgoing>SequenceFlow_StartToBillSend</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- MSPO sends bill for temporary continuation of measurement -->
    <bpmn:task id="Task_MSPO_SendBill2" name="Send Bill - Temporary Continuation Measurement">
      <bpmn:name>MSPO Send Bill (Temp Cont. Measurement)</bpmn:name>
      <bpmn:incoming>SequenceFlow_StartToBillSend</bpmn:outgoing>
    </bpmn:task>

    <!-- MSPO sends bill for additional readings -->
    <bpmn:task id="Task_MSPO_SendBill3" name="Send Bill - Additional Readings">
      <bpmn:name>MSPO Send Bill (Additional Readings)</bpmn:name>
      <bpmn:incoming>SequenceFlow_StartToBillSend</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for MSPO bill types -->
    <bpmn:exclusiveGateway id="Gateway_MSPO_BillTypes">
      <bpmn:name>MSPO Bill Type?</bpmn:name>
      <bpmn:incoming>SequenceFlow_StartToBillSend</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ToTempMeasurement</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ToAdditionalReadings</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- MSPO receives confirmation/rejection -->
    <bpmn:endEvent id="End_Event_MSPO_Receipt">
      <bpmn:name>MSPO Receives Invoice Decision</bpmn:name>
      <bpmn:incoming>SequenceFlow_ConfirmRejectReceived</bpmn:outgoing>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToBillSend" sourceRef="StartMSPO_1" targetRef="Gateway_MSPO_BillTypes"/>
    <bpmn:sequenceFlow id="SequenceFlow_ToTempMeasurement" name="Temporary Continuation Measurement" sourceRef="Gateway_MSPO_BillTypes" targetRef="Task_MSPO_SendBill2"/>
    <bpmn:sequenceFlow id="SequenceFlow_ToAdditionalReadings" name="Additional Readings" sourceRef="Gateway_MSPO_BillTypes" targetRef="Task_MSPO_SendBill3"/>

  </bpmn:process>

  <!-- GO Process -->
  <bpmn:process id="Process_GO" isExecutable="false">
    <bpmn:startEvent id="StartGO_1">
      <bpmn:name>Invoice Examination</bpmn:name>
      <bpmn:outgoing>SequenceFlow_StartToExamination</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- GO receives bill for temporary continuation of metering point operations -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_GO_ReceiveBill1">
      <bpmn:messageEventDefinition/>
      <bpmn:name>Receive Bill (Temp Cont. Metering)</bpmn:name>
      <bpmn:outgoing>SequenceFlow_Bill1ToExamination</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- GO receives bill for temporary continuation of measurement -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_GO_ReceiveBill2">
      <bpmn:messageEventDefinition/>
      <bpmn:name>Receive Bill (Temp Cont. Measurement)</bpmn:name>
      <bpmn:outgoing>SequenceFlow_Bill2ToExamination</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- GO receives bill for additional readings -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_GO_ReceiveBill3">
      <bpmn:messageEventDefinition/>
      <bpmn:name>Receive Bill (Additional Readings)</bpmn:name>
      <bpmn:outgoing>SequenceFlow_Bill3ToExamination</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- GO receives bill for equipment acquisition -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_GO_ReceiveEquip">
      <bpmn:messageEventDefinition/>
      <bpmn:name>Receive Bill (Equipment Acquisition)</bpmn:name>
      <bpmn:outgoing>SequenceFlow_EquipToExamination</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- GO examines bill -->
    <bpmn:task id="Task_GO_ExamineBill" name="Examine Bill">
      <bpmn:name>GO Examine Invoice</bpmn:name>
      <bpmn:incoming>SequenceFlow_Bill1ToExamination</bpmn:outgoing>
      <bpmn:incoming>SequenceFlow_Bill2ToExamination</bpmn:outgoing>
      <bpmn:incoming>SequenceFlow_Bill3ToExamination</bpmn:outgoing>
      <bpmn:incoming>SequenceFlow_EquipToExamination</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for decision -->
    <bpmn:exclusiveGateway id="Gateway_GO_Decision">
      <bpmn:name>Invoice Decision?</bpmn:name>
      <bpmn:incoming>SequenceFlow_ExamineToDecision</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ConfirmWithPaymentAdvice</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RejectInvoice</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- GO confirms invoice with payment advice -->
    <bpmn:task id="Task_GO_Confirm" name="Confirm Invoice with Payment Advice">
      <bpmn:name>GO Confirm (Payment Advice)</bpmn:name>
      <bpmn:incoming>SequenceFlow_ConfirmWithPaymentAdvice</bpmn:outgoing>
    </bpmn:task>

    <!-- GO rejects invoice -->
    <bpmn:task id="Task_GO_Reject" name="Reject Invoice">
      <bpmn:name>GO Reject Invoice</bpmn:name>
      <bpmn:incoming>SequenceFlow_RejectInvoice</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToExamination" sourceRef="StartGO_1" targetRef="IntermediateCatchEvent_GO_ReceiveBill1"/>
    <bpmn:sequenceFlow id="SequenceFlow_Bill2ToExamination" name="From MSPO Temp Measurement Bill" sourceRef="IntermediateCatchEvent_GO_ReceiveBill2" targetRef="Task_GO_ExamineBill"/>
    <bpmn:sequenceFlow id="SequenceFlow_Bill3ToExamination" name="From Additional Readings Bill" sourceRef="IntermediateCatchEvent_GO_ReceiveBill3" targetRef="Task_GO_ExamineBill"/>
    <bpmn:sequenceFlow id="SequenceFlow_EquipToExamination" name="From Equipment Acquisition Bill (GO)" sourceRef="IntermediateCatchEvent_GO_ReceiveEquip" targetRef="Task_GO_ExamineBill"/>

  </bpmn:process>

  <!-- MPON Process -->
  <bpmn:process id="Process_MPON" isExecutable="false">
    <bpmn:startEvent id="StartMPON_1">
      <bpmn:name>Invoice Examination</bpmn:name>
      <bpmn:outgoing>SequenceFlow_StartToExamination</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- MPON receives bill for equipment acquisition -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_MPON_ReceiveEquip">
      <bpmn:messageEventDefinition/>
      <bpmn:name>Receive Bill (Equipment Acquisition)</bpmn:name>
      <bpmn:outgoing>SequenceFlow_EquipToExamination</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- MPON examines bill -->
    <bpmn:task id="Task_MPON_ExamineBill" name="Examine Bill">
      <bpmn:name>MPON Examine Invoice</bpmn:name>
      <bpmn:incoming>SequenceFlow_EquipToExamination</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for decision -->
    <bpmn:exclusiveGateway id="Gateway_MPON_Decision">
      <bpmn:name>Invoice Decision?</bpmn:name>
      <bpmn:incoming>SequenceFlow_ExamineToDecision</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ConfirmWithPaymentAdvice</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RejectInvoice</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- MPON confirms invoice with payment advice -->
    <bpmn:task id="Task_MPON_Confirm" name="Confirm Invoice with Payment Advice">
      <bpmn:name>MPON Confirm (Payment Advice)</bpmn:name>
      <bpmn:incoming>SequenceFlow_ConfirmWithPaymentAdvice</bpmn:outgoing>
    </bpmn:task>

    <!-- MPON rejects invoice -->
    <bpmn:task id="Task_MPON_Reject" name="Reject Invoice">
      <bpmn:name>MPON Reject Invoice</bpmn:name>
      <bpmn:incoming>SequenceFlow_RejectInvoice</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToExamination" sourceRef="StartMPON_1" targetRef="IntermediateCatchEvent_MPON_ReceiveEquip"/>

  </bpmn:process>

</bpmn:definitions>