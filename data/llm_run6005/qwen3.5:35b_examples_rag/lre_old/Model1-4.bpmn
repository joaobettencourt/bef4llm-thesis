<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_IPO_Process">
    <bpmn:participant id="Participant_IPO" name="IPO Process - Going Public" processRef="Process_IPO_Main" />
  </bpmn:collaboration>

  <bpmn:process id="Process_IPO_Main" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="Start_Event_Decision" name="Decision to Go Public">
      <bpmn:outgoing>SequenceFlow_SelectUnderwriters</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Select Underwriters -->
    <bpmn:task id="Task_SelectUnderwriters" name="Select Underwriters">
      <bpmn:incoming>SequenceFlow_SelectUnderwriters</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckFacts</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Check if facts presented fairly -->
    <bpmn:exclusiveGateway id="Gateway_FairnessCheck" name="Facts Presented Fairly?">
      <bpmn:incoming>SequenceFlow_CheckFacts</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ProceedYes</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_DealDeclined</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event 1: Deal Declined -->
    <bpmn:endEvent id="End_DealDeclined" name="Deal Declined">
      <bpmn:name>Underwriter Rejects Issue</bpmn:name>
      <bpmn:incoming>SequenceFlow_DealDeclined</bpmn:outgoing>
    </bpmn:endEvent>

    <!-- Parallel Gateway 1: Split for SEC and Road Show -->
    <bpmn:parallelGateway id="Parallel_Split_Preparation" name="Preparation &amp; Road Show">
      <bpmn:incoming>SequenceFlow_ProceedYes</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SubmitSEC</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RoadShowStart</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 2: Prepare Registration Statement -->
    <bpmn:task id="Task_PrepareRegistration" name="Prepare Registration Statement">
      <bpmn:name>Create SEC Registration Document</bpmn:name>
      <bpmn:incoming>SequenceFlow_SubmitSEC</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CheckCompliance</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3: Check Blue-Sky Laws -->
    <bpmn:task id="Task_BlueSkyCheck" name="Check State Compliance">
      <bpmn:name>Verify Blue-Sky Law Compliance</bpmn:name>
      <bpmn:incoming>SequenceFlow_CheckCompliance</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_WaitSECApproval</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Catch Event 1: Wait for SEC Approval -->
    <bpmn:intermediateCatchEvent id="Event_SECApproval" name="Wait for SEC Clearance">
      <bpmn:name>Receive SEC Approval</bpmn:name>
      <bpmn:incoming>SequenceFlow_WaitSECApproval</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_FixPriceTrigger</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task 4: Road Show -->
    <bpmn:task id="Task_RoadShow" name="Arrange &amp; Conduct Road Show">
      <bpmn:name>Firm Up Issue Price (Roadshow)</bpmn:name>
      <bpmn:incoming>SequenceFlow_RoadShowStart</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RoadShowComplete</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway 2: Join after SEC and Road Show -->
    <bpmn:parallelGateway id="Parallel_Join_Pricing" name="Ready to Fix Price">
      <bpmn:incoming>SequenceFlow_FixPriceTrigger</bpmn:outgoing>
      <bpmn:incoming>SequenceFlow_RoadShowComplete</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_FinalCheck</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 5: Fix Issue Price -->
    <bpmn:task id="Task_FixIssuePrice" name="Fix Issue Price">
      <bpmn:name>Finalize Pricing Post-SEC</bpmn:name>
      <bpmn:incoming>SequenceFlow_FinalCheck</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ProceedDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2: Final Decision -->
    <bpmn:exclusiveGateway id="Gateway_FinalReason" name="Any Reason Not to Proceed?">
      <bpmn:name>No Reasons Found?</bpmn:name>
      <bpmn:incoming>SequenceFlow_ProceedDecision</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_OfferPublicYes</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CancelDealNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event 2: Process Cancelled -->
    <bpmn:endEvent id="End_DealCancelled" name="Process Cancelled">
      <bpmn:name>No Proceeding Due to Issues</bpmn:name>
      <bpmn:incoming>SequenceFlow_CancelDealNo</bpmn:outgoing>
    </bpmn:endEvent>

    <!-- Task 6: Firm Commitment and Offer Public -->
    <bpmn:task id="Task_FirmCommitment" name="Firm Commitment &amp; Offer Public">
      <bpmn:name>Sell Stock to Investors</bpmn:name>
      <bpmn:incoming>SequenceFlow_OfferPublicYes</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 3: IPO Completed -->
    <bpmn:endEvent id="End_IPOCompleted" name="IPO Completed">
      <bpmn:name>All Stock Sold Successfully</bpmn:name>
      <bpmn:incoming>SequenceFlow_OfferPublicYes</bpmn:outgoing>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_SelectUnderwriters" sourceRef="Start_Event_Decision" targetRef="Task_SelectUnderwriters" />
    
    <bpmn:sequenceFlow id="SequenceFlow_CheckFacts" name="Check Facts Fairness" sourceRef="Task_SelectUnderwriters" targetRef="Gateway_FairnessCheck" />

    <bpmn:sequenceFlow id="SequenceFlow_ProceedYes" name="Fair / Proceed" sourceRef="Gateway_FairnessCheck" targetRef="Parallel_Split_Preparation" />
    
    <bpmn:sequenceFlow id="SequenceFlow_DealDeclined" name="Not Fair / Decline" sourceRef="Gateway_FairnessCheck" targetRef="End_DealDeclined" />

    <!-- Parallel Split Paths -->
    <bpmn:sequenceFlow id="SequenceFlow_SubmitSEC" sourceRef="Parallel_Split_Preparation" targetRef="Task_PrepareRegistration" />
    
    <bpmn:sequenceFlow id="SequenceFlow_CheckCompliance" name="Check Compliance" sourceRef="Task_PrepareRegistration" targetRef="Task_BlueSkyCheck" />

    <!-- Road Show Path -->
    <bpmn:sequenceFlow id="SequenceFlow_RoadShowStart" sourceRef="Parallel_Split_Preparation" targetRef="Task_RoadShow" />
    
    <bpmn:sequenceFlow id="SequenceFlow_WaitSECApproval" name="Submit to SEC &amp; Wait" sourceRef="Task_BlueSkyCheck" targetRef="Event_SECApproval" />

    <!-- Joining Paths -->
    <bpmn:sequenceFlow id="SequenceFlow_FixPriceTrigger" sourceRef="Event_SECApproval" targetRef="Parallel_Join_Pricing" />
    
    <bpmn:sequenceFlow id="SequenceFlow_RoadShowComplete" name="Road Show Complete" sourceRef="Task_RoadShow" targetRef="Parallel_Join_Pricing" />

    <!-- Post Pricing Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_FinalCheck" sourceRef="Parallel_Join_Pricing" targetRef="Task_FixIssuePrice" />
    
    <bpmn:sequenceFlow id="SequenceFlow_ProceedDecision" name="No Reasons Found?" sourceRef="Task_FixIssuePrice" targetRef="Gateway_FinalReason">
      <bpmn:name>No Issues</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Final Steps -->
    <bpmn:sequenceFlow id="SequenceFlow_OfferPublicYes" name="Proceed with Sale" sourceRef="Gateway_FinalReason" targetRef="Task_FirmCommitment">
      <bpmn:name>No Reasons Found</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Cancellation Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_CancelDealNo" name="Issues Found" sourceRef="Gateway_FinalReason" targetRef="End_DealCancelled">
      <bpmn:name>Cancel Deal</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>