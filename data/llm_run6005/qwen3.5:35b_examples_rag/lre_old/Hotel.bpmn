<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_RoomService">
    <bpmn:participant id="Participant_Evanstonian" name="The Evanstonian Room Service Process" processRef="Process_1" />
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Manager" name="Room-service Manager">
        <bpmn:flowNodeRef>Task_TakeOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AlcoholCheck</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Kitchen" name="Kitchen Staff">
        <bpmn:flowNodeRef>Task_PrepFood</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sommelier" name="Sommelier">
        <bpmn:flowNodeRef>Task_PrepareWine</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Waiter" name="Waiter">
        <bpmn:flowNodeRef>Task_ReadiesCart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DeliverOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReturnStation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BillAccount</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="Start_Event1" name="Guest calls room service">
      <bpmn:outgoing>SequenceFlow_001</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Manager Tasks & Decision -->
    <bpmn:task id="Task_TakeOrder" name="Take down order ticket">
      <bpmn:incoming>SequenceFlow_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_002</bpmn:outgoing>
    </bpmn:task>

    <!-- Inclusive Gateway for Alcohol Check & Parallel Prep -->
    <bpmn:inclusiveGateway id="Gateway_AlcoholCheck" name="Alcoholic beverage needed?">
      <bpmn:incoming>SequenceFlow_002</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_003_Kitchen</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_004_WaiterCart</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_005_Sommelier</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Kitchen Prep (Always) -->
    <bpmn:task id="Task_PrepFood" name="Prepare food">
      <bpmn:incoming>SequenceFlow_003_Kitchen</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_102_FoodReady</bpmn:outgoing>
    </bpmn:task>

    <!-- Waiter Cart Prep (Always) -->
    <bpmn:task id="Task_ReadiesCart" name="Readies cart &amp; non-alcoholic drinks">
      <bpmn:incoming>SequenceFlow_004_WaiterCart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_103_CartReady</bpmn:outgoing>
    </bpmn:task>

    <!-- Sommelier Prep (Conditional) -->
    <bpmn:task id="Task_PrepareWine" name="Fetch wine &amp; prep alcohol">
      <bpmn:incoming>SequenceFlow_005_Sommelier</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_104_WineReady</bpmn:outgoing>
    </bpmn:task>

    <!-- Join Point for Delivery -->
    <bpmn:inclusiveGateway id="Gateway_DeliveryJoin" name="All items ready?">
      <bpmn:incoming>SequenceFlow_102_FoodReady</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_103_CartReady</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_104_WineReady</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_201_DeliverStart</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Delivery -->
    <bpmn:task id="Task_DeliverOrder" name="Deliver to guest room">
      <bpmn:incoming>SequenceFlow_201_DeliverStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_301_ReturnStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Return & Billing -->
    <bpmn:task id="Task_ReturnStation" name="Return to station">
      <bpmn:incoming>SequenceFlow_301_ReturnStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_401_BillStart</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_BillAccount" name="Debit guest account">
      <bpmn:incoming>SequenceFlow_401_BillStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_501_NextOrderCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Decision for Next Order -->
    <bpmn:exclusiveGateway id="Gateway_NextOrder" name="Another order?">
      <bpmn:incoming>SequenceFlow_501_NextOrderCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_601_LoopBack</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_701_EndProcess</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event -->
    <bpmn:endEvent id="End_Event1" name="Shift complete">
      <bpmn:incoming>SequenceFlow_701_EndProcess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows with Conditions (Implicit for Inclusive Gateway) -->
    <bpmn:sequenceFlow id="SequenceFlow_002" sourceRef="Task_TakeOrder" targetRef="Gateway_AlcoholCheck">
      <bpmn:name>Take down order</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Kitchen Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_003_Kitchen" sourceRef="Gateway_AlcoholCheck" targetRef="Task_PrepFood">
      <bpmn:name>Kitchen Prep</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Waiter Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_004_WaiterCart" sourceRef="Gateway_AlcoholCheck" targetRef="Task_ReadiesCart">
      <bpmn:name>Cart Prep</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Sommelier Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_005_Sommelier" sourceRef="Gateway_AlcoholCheck" targetRef="Task_PrepareWine">
      <bpmn:name>Sommelier Prep</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Join Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_102_FoodReady" sourceRef="Task_PrepFood" targetRef="Gateway_DeliveryJoin">
      <bpmn:name>Food Ready</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_103_CartReady" sourceRef="Task_ReadiesCart" targetRef="Gateway_DeliveryJoin">
      <bpmn:name>Cart Ready</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_104_WineReady" sourceRef="Task_PrepareWine" targetRef="Gateway_DeliveryJoin">
      <bpmn:name>Wine Ready</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Delivery Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_201_DeliverStart" sourceRef="Gateway_DeliveryJoin" targetRef="Task_DeliverOrder">
      <bpmn:name>All items ready</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Return Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_301_ReturnStart" sourceRef="Task_DeliverOrder" targetRef="Task_ReturnStation">
      <bpmn:name>Return to station</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Billing Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_401_BillStart" sourceRef="Task_ReturnStation" targetRef="Task_BillAccount">
      <bpmn:name>Billing</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Next Order Check -->
    <bpmn:sequenceFlow id="SequenceFlow_501_NextOrderCheck" sourceRef="Task_BillAccount" targetRef="Gateway_NextOrder">
      <bpmn:name>Billing complete</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Loop Back -->
    <bpmn:sequenceFlow id="SequenceFlow_601_LoopBack" sourceRef="Gateway_NextOrder" targetRef="Start_Event1">
      <bpmn:name>Yes</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- End Process -->
    <bpmn:sequenceFlow id="SequenceFlow_701_EndProcess" sourceRef="Gateway_NextOrder" targetRef="End_Event1">
      <bpmn:name>No</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>