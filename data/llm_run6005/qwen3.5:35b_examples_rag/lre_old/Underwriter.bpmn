<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_IPO_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_IPO_1">
    <bpmn:participant id="Participant_IPO_Main" name="IPO Process - Underwriting &amp; Public Offering" processRef="Process_IPO_001" />
  </bpmn:collaboration>

  <bpmn:process id="Process_IPO_001" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Company" name="Company Management">
        <bpmn:flowNodeRef>StartEvent_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectUnderwriters</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Underwriter" name="Underwriting Team">
        <bpmn:flowNodeRef>InclusiveGateway_FairnessCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareRegistration</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_SplitWaitRoadshow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CatchEvent_SECApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RoadShowPricing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_MergeFixPrice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FixIssuePrice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterCommitment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_SellDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Decline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_CancelSale</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OfferPublic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_IPOComplete</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Decision" name="Company Decides to Go Public">
      <bpmn:outgoing>SequenceFlow_SelectUnderwriters</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Select Underwriters -->
    <bpmn:task id="Task_SelectUnderwriters" name="Select Underwriters">
      <bpmn:incoming>SequenceFlow_SelectUnderwriters</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FairnessCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Fairness Check -->
    <bpmn:inclusiveGateway id="InclusiveGateway_FairnessCheck" name="Facts Presented&#10;Fairly?">
      <bpmn:incoming>SequenceFlow_FairnessCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DeclineUnderwriter</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PrepareRegistration</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- End Event 1: Decline -->
    <bpmn:endEvent id="EndEvent_Decline" name="Underwriter&#10;Declines">
      <bpmn:incoming>SequenceFlow_DeclineUnderwriter</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task 2: Registration & Compliance -->
    <bpmn:task id="Task_PrepareRegistration" name="Prepare Registration&#10;Statement &amp;&#10;Check Blue-Sky Laws">
      <bpmn:incoming>SequenceFlow_PrepareRegistration</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SplitWaitRoadshow</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2: Parallel Split (SEC Wait vs Roadshow) -->
    <bpmn:parallelGateway id="ParallelGateway_SplitWaitRoadshow">
      <bpmn:incoming>SequenceFlow_SplitWaitRoadshow</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitSECClearance</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RoadShowStart</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Intermediate Catch Event 1: SEC Approval -->
    <bpmn:intermediateCatchEvent id="CatchEvent_SECApproval" name="SEC Clearance&#10;Received">
      <bpmn:messageEventDefinition />
      <bpmn:incoming>SequenceFlow_WaitSECClearance</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitSECClearanceComplete</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task 3: Roadshow & Pricing Prep -->
    <bpmn:task id="Task_RoadShowPricing" name="Arrange Road Show&#10;Firm Up Issue Price">
      <bpmn:name>Road Show &amp;&#10;Price Firming</bpmn:name>
      <bpmn:incoming>SequenceFlow_RoadShowStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RoadShowFinish</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 3: Merge at Fix Price -->
    <bpmn:parallelGateway id="InclusiveGateway_MergeFixPrice">
      <bpmn:name>Merge&#10;SEC &amp;&#10;Roadshow</bpmn:name>
      <bpmn:incoming>SequenceFlow_WaitSECClearanceComplete</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_RoadShowFinish</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeToFixPrice</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 4: Fix Issue Price -->
    <bpmn:task id="Task_FixIssuePrice" name="Fix Final&#10;Issue Price">
      <bpmn:name>Fix Final Issue Price</bpmn:name>
      <bpmn:incoming>SequenceFlow_MergeToFixPrice</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FixPriceToCommitment</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 5: Firm Commitment -->
    <bpmn:task id="Task_EnterCommitment" name="Enter Firm&#10;Commitment">
      <bpmn:name>Firm Commitment</bpmn:name>
      <bpmn:incoming>SequenceFlow_FixPriceToCommitment</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CommitmentToSell</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 4: Sell Decision -->
    <bpmn:exclusiveGateway id="InclusiveGateway_SellDecision" name="Reason Not&#10;to Sell?">
      <bpmn:name>Sale Reasonable?</bpmn:name>
      <bpmn:incoming>SequenceFlow_CommitmentToSell</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SellDecisionNo</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SellDecisionYes</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event 2: Cancel Sale -->
    <bpmn:endEvent id="EndEvent_CancelSale" name="Cancel&#10;Public Offering">
      <bpmn:name>Sale Cancelled</bpmn:name>
      <bpmn:incoming>SequenceFlow_SellDecisionNo</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task 6: Offer Public -->
    <bpmn:task id="Task_OfferPublic" name="Offer Stock&#10;to Public">
      <bpmn:name>Offer to Public</bpmn:name>
      <bpmn:incoming>SequenceFlow_SellDecisionYes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OfferToPublic</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 3: IPO Complete -->
    <bpmn:endEvent id="EndEvent_IPOComplete" name="IPO&#10;Completed">
      <bpmn:name>IPO Completed</bpmn:name>
      <bpmn:incoming>SequenceFlow_OfferToPublic</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_SelectUnderwriters" sourceRef="StartEvent_Decision" targetRef="Task_SelectUnderwriters" />
    
    <bpmn:sequenceFlow id="SequenceFlow_FairnessCheck" name="Proceed with&#10;Selection" sourceRef="Task_SelectUnderwriters" targetRef="InclusiveGateway_FairnessCheck" />
    
    <bpmn:sequenceFlow id="SequenceFlow_DeclineUnderwriter" name="Facts Not Fair" sourceRef="InclusiveGateway_FairnessCheck" targetRef="EndEvent_Decline" />
    
    <bpmn:sequenceFlow id="SequenceFlow_PrepareRegistration" name="Proceed with&#10;Issue Handling" sourceRef="InclusiveGateway_FairnessCheck" targetRef="Task_PrepareRegistration" />

    <!-- Note: Task_PrepareRegistration outgoing flow needs to be defined correctly -->
    <bpmn:sequenceFlow id="SequenceFlow_SplitWaitRoadshow" name="" sourceRef="Task_PrepareRegistration" targetRef="ParallelGateway_SplitWaitRoadshow" />

    <bpmn:sequenceFlow id="SequenceFlow_WaitSECClearance" name="" sourceRef="ParallelGateway_SplitWaitRoadshow" targetRef="CatchEvent_SECApproval" />
    
    <!-- Catch Event outgoing flow to Merge Gateway -->
    <bpmn:sequenceFlow id="SequenceFlow_WaitSECClearanceComplete" name="SEC Cleared" sourceRef="CatchEvent_SECApproval" targetRef="InclusiveGateway_MergeFixPrice" />

    <bpmn:sequenceFlow id="SequenceFlow_RoadShowStart" name="" sourceRef="ParallelGateway_SplitWaitRoadshow" targetRef="Task_RoadShowPricing" />
    
    <!-- Road Show Task outgoing flow to Merge Gateway -->
    <bpmn:sequenceFlow id="SequenceFlow_RoadShowFinish" name="Price Firming Done" sourceRef="Task_RoadShowPricing" targetRef="InclusiveGateway_MergeFixPrice" />

    <bpmn:sequenceFlow id="SequenceFlow_MergeToFixPrice" name="" sourceRef="InclusiveGateway_MergeFixPrice" targetRef="Task_FixIssuePrice" />
    
    <bpmn:sequenceFlow id="SequenceFlow_FixPriceToCommitment" name="" sourceRef="Task_FixIssuePrice" targetRef="Task_EnterCommitment" />

    <bpmn:sequenceFlow id="SequenceFlow_CommitmentToSell" name="" sourceRef="Task_EnterCommitment" targetRef="InclusiveGateway_SellDecision" />
    
    <bpmn:sequenceFlow id="SequenceFlow_SellDecisionNo" name="Reason Not&#10;to Sell?" sourceRef="InclusiveGateway_SellDecision" targetRef="EndEvent_CancelSale" />

    <bpmn:sequenceFlow id="SequenceFlow_SellDecisionYes" name="Proceed with Sale" sourceRef="InclusiveGateway_SellDecision" targetRef="Task_OfferPublic" />
    
    <bpmn:sequenceFlow id="SequenceFlow_OfferToPublic" name="" sourceRef="Task_OfferPublic" targetRef="EndEvent_IPOComplete" />

  </bpmn:process>
</bpmn:definitions>