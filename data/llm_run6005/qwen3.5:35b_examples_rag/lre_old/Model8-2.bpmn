<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_RecruitmentProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_VacancyManagement">
    <bpmn:participant id="Participant_HRManager" name="HR Manager Process" processRef="Process_VacancyHandling"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_VacancyHandling" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_HRManager" name="HR Manager">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CreateJobDescriptionTask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AskDepartmentClarificationIntermediate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubmitForApprovalGateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WaitForDecisionTask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CorrectDescriptionTask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PostJobTask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Vacancy Reported">
      <bpmn:outgoing>Flow_StartToCreate</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Create Job Description from vacancy information -->
    <bpmn:task id="CreateJobDescriptionTask" name="Create job description">
      <bpmn:incoming>Flow_StartToCreate</bpmn:incoming>
      <bpmn:outgoing>Flow_CreateToDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Catch Event for Department Clarification -->
    <bpmn:intermediateCatchEvent id="AskDepartmentClarificationIntermediate" name="Wait for department clarification">
      <bpmn:incoming>Flow_DecisionToClarify</bpmn:incoming>
      <bpmn:outgoing>Flow_ClarifyBackToCreate</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Exclusive Gateway for Decision on Description Quality -->
    <bpmn:exclusiveGateway id="SubmitForApprovalGateway" name="Confusion in message?">
      <bpmn:incoming>Flow_CreateToDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_DecisionToClarify</bpmn:outgoing>
      <bpmn:outgoing>Flow_GatewayToSubmitApproval</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 2: Submit for Approval -->
    <bpmn:task id="WaitForDecisionTask" name="Submit job description">
      <bpmn:incoming>Flow_GatewayToSubmitApproval</bpmn:incoming>
      <bpmn:outgoing>Flow_SubmitToGateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Catch Event for Approval Decision -->
    <bpmn:intermediateCatchEvent id="WaitForApprovalDecision" name="Waiting for approval decision">
      <bpmn:incoming>Flow_SubmitToGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_ApprovalResult</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Exclusive Gateway for Approval Decision -->
    <bpmn:exclusiveGateway id="ApprovalDecisionGateway" name="Approved?">
      <bpmn:incoming>Flow_ApprovalResult</bpmn:incoming>
      <bpmn:outgoing>Flow_DecisionToCorrect</bpmn:outgoing>
      <bpmn:outgoing>Flow_GatewayToPostJob</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 3: Correct Description -->
    <bpmn:task id="CorrectDescriptionTask" name="Correct description">
      <bpmn:incoming>Flow_DecisionToCorrect</bpmn:incoming>
      <bpmn:outgoing>Flow_CorrectBackToSubmit</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 4: Post Job -->
    <bpmn:task id="PostJobTask" name="Post the job">
      <bpmn:incoming>Flow_GatewayToPostJob</bpmn:incoming>
      <bpmn:outgoing>Flow_PostToEnd</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_1" name="Vacancy Process Complete">
      <bpmn:incoming>Flow_PostToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Flow_StartToCreate" sourceRef="StartEvent_1" targetRef="CreateJobDescriptionTask"/>
    
    <bpmn:sequenceFlow id="Flow_CreateToDecision" name="description created" sourceRef="CreateJobDescriptionTask" targetRef="SubmitForApprovalGateway"/>
    
    <bpmn:sequenceFlow id="Flow_DecisionToClarify" name="confusion exists - ask department" sourceRef="SubmitForApprovalGateway" targetRef="AskDepartmentClarificationIntermediate"/>
    
    <bpmn:sequenceFlow id="Flow_ClarifyBackToCreate" name="clarification received" sourceRef="AskDepartmentClarificationIntermediate" targetRef="CreateJobDescriptionTask"/>
    
    <bpmn:sequenceFlow id="Flow_GatewayToSubmitApproval" name="no confusion - submit for approval" sourceRef="SubmitForApprovalGateway" targetRef="WaitForDecisionTask"/>
    
    <bpmn:sequenceFlow id="Flow_SubmitToGateway" name="submitted to department" sourceRef="WaitForDecisionTask" targetRef="WaitForApprovalDecision"/>
    
    <bpmn:sequenceFlow id="Flow_ApprovalResult" name="decision received from department" sourceRef="WaitForApprovalDecision" targetRef="ApprovalDecisionGateway"/>
    
    <bpmn:sequenceFlow id="Flow_DecisionToCorrect" name="rejected - needs correction" sourceRef="ApprovalDecisionGateway" targetRef="CorrectDescriptionTask"/>
    
    <bpmn:sequenceFlow id="Flow_CorrectBackToSubmit" name="corrected and resubmitted" sourceRef="CorrectDescriptionTask" targetRef="WaitForDecisionTask"/>
    
    <bpmn:sequenceFlow id="Flow_GatewayToPostJob" name="approved - post job" sourceRef="ApprovalDecisionGateway" targetRef="PostJobTask"/>
    
    <bpmn:sequenceFlow id="Flow_PostToEnd" name="job posted successfully" sourceRef="PostJobTask" targetRef="EndEvent_1"/>

  </bpmn:process>
</bpmn:definitions>