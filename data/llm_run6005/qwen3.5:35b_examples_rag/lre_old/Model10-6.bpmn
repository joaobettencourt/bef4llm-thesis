<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_DismissalProcess">
    <bpmn:participant id="Participant_MSPN" name="MSPN" processRef="Pool_MSPN"/>
    <bpmn:participant id="Participant_MSPO" name="MSPO" processRef="Pool_MSPO"/>
    <bpmn:messageFlow id="MessageFlow_DismissalSent" sourceRef="IntermediateThrowEvent_SendDismissal" targetRef="StartCatchEvent_ReceiveDismissal"/>
  </bpmn:collaboration>

  <!-- MSPN Process -->
  <bpmn:process id="Pool_MSPN" isExecutable="false">
    <bpmn:startEvent id="StartNone_Event1" name="Process Dismissal Request">
      <bpmn:outgoing>SequenceFlow_Init</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_SendDismissal" name="Send dismissal to MSPO">
      <bpmn:incoming>SequenceFlow_Init</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToMessageThrow</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndNone_Event1" name="Dismissal Sent">
      <bpmn:incoming>SequenceFlow_EndProcess</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:intermediateThrowEvent id="IntermediateThrowEvent_SendDismissal" name="Send Dismissal Message">
      <bpmn:incoming>SequenceFlow_ToMessageThrow</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MessageToMSPO</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <bpmn:endEvent id="EndNone_Event2" name="Process Complete">
      <bpmn:incoming>SequenceFlow_EndComplete</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow_Init" sourceRef="StartNone_Event1" targetRef="Task_SendDismissal"/>
    <bpmn:sequenceFlow id="SequenceFlow_ToMessageThrow" sourceRef="Task_SendDismissal" targetRef="IntermediateThrowEvent_SendDismissal"/>
    <bpmn:sequenceFlow id="SequenceFlow_MessageToMSPO" sourceRef="IntermediateThrowEvent_SendDismissal" targetRef="EndNone_Event1"/>
    <bpmn:sequenceFlow id="SequenceFlow_EndProcess" sourceRef="Task_SendDismissal" targetRef="EndNone_Event2"/>
  </bpmn:process>

  <!-- MSPO Process -->
  <bpmn:process id="Pool_MSPO" isExecutable="false">
    <bpmn:startEvent id="StartCatchEvent_ReceiveDismissal" name="Receive Dismissal Message">
      <bpmn:outgoing>SequenceFlow_ToReview</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_ReviewDismissal" name="Review dismissal of MSPN">
      <bpmn:incoming>SequenceFlow_ToReview</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DecisionPoint</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndReject" name="Dismissal Rejected">
      <bpmn:incoming>SequenceFlow_RejectPath</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndConfirm" name="Dismissal Confirmed">
      <bpmn:incoming>SequenceFlow_ConfirmPath</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:exclusiveGateway id="ExclusiveGateway_Decision" name="Decision on Dismissal">
      <bpmn:incoming>SequenceFlow_DecisionPoint</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RejectPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ConfirmPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="EndNone_Event3" name="Process Complete">
      <bpmn:incoming>SequenceFlow_EndRejected</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndNone_Event4" name="Dismissal Processed">
      <bpmn:incoming>SequenceFlow_EndConfirmed</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:task id="Task_RejectDismissal" name="Reject dismissal of MSPN">
      <bpmn:incoming>SequenceFlow_RejectPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndRejected</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_ConfirmDismissal" name="Confirm dismissal of MSPN">
      <bpmn:incoming>SequenceFlow_ConfirmPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndConfirmed</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_ToReview" sourceRef="StartCatchEvent_ReceiveDismissal" targetRef="Task_ReviewDismissal"/>
    <bpmn:sequenceFlow id="SequenceFlow_DecisionPoint" sourceRef="Task_ReviewDismissal" targetRef="ExclusiveGateway_Decision"/>
    <bpmn:sequenceFlow id="SequenceFlow_RejectPath" name="Reject" sourceRef="ExclusiveGateway_Decision" targetRef="Task_RejectDismissal"/>
    <bpmn:sequenceFlow id="SequenceFlow_ConfirmPath" name="Confirm" sourceRef="ExclusiveGateway_Decision" targetRef="Task_ConfirmDismissal"/>
    <bpmn:sequenceFlow id="SequenceFlow_EndRejected" sourceRef="Task_RejectDismissal" targetRef="EndNone_Event3"/>
    <bpmn:sequenceFlow id="SequenceFlow_EndConfirmed" sourceRef="Task_ConfirmDismissal" targetRef="EndNone_Event4"/>
  </bpmn:process>

</bpmn:definitions>