<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_WarrantProcess">
    <bpmn:participant id="Participant_SCTRegistry" name="Small Claims Registry Operations" processRef="Process_WarrantRequest"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_WarrantRequest" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_BackOffice" name="Client Service Back Office">
        <bpmn:flowNodeRef>StartEvent_RequestReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RetrieveSCTTFile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ForwardToPolice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_StorePhysicalFile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_WaitingForReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ReceivePoliceReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RetrieveSCTFile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AttachNewDocument</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_StoreExpandedFile</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_RequestReceived" name="Warrant Possession Request Received">
      <bpmn:outgoing>SequenceFlow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Retrieve SCTT File -->
    <bpmn:task id="Task_RetrieveSCTTFile" name="Retrieve SCTT file">
      <bpmn:incoming>SequenceFlow_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_02</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Forward to Police -->
    <bpmn:exclusiveGateway id="Gateway_ForwardToPolice" name="Forward SCT Warrant Possession?">
      <bpmn:incoming>SequenceFlow_02</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_03</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 2: Store Physical File -->
    <bpmn:task id="Task_StorePhysicalFile" name="Store SCTT physical file awaiting report">
      <bpmn:incoming>SequenceFlow_03</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_04</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Event: Wait for Police Report -->
    <bpmn:startEvent id="StartEvent_PoliceReport" name="Police Report Received">
      <bpmn:timerEventDefinition/>
      <bpmn:outgoing>SequenceFlow_05</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Gateway 2: Receive Police Report -->
    <bpmn:exclusiveGateway id="Gateway_ReceivePoliceReport" name="SCT File Ready?">
      <bpmn:incoming>SequenceFlow_04</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_05</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_06</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 3: Retrieve SCT File -->
    <bpmn:task id="Task_RetrieveSCTFile" name="Retrieve respective SCT file">
      <bpmn:incoming>SequenceFlow_06</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_07</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 4: Attach New Document -->
    <bpmn:task id="Task_AttachNewDocument" name="Attach new SCT document">
      <bpmn:incoming>SequenceFlow_07</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_08</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 5: Store Expanded File -->
    <bpmn:task id="Task_StoreExpandedFile" name="Store expanded SCT physical file">
      <bpmn:incoming>SequenceFlow_08</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_09</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndFileReady" name="SCT File Ready for MC Staff">
      <bpmn:incoming>SequenceFlow_09</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_01" sourceRef="StartEvent_RequestReceived" targetRef="Task_RetrieveSCTTFile"/>
    <bpmn:sequenceFlow id="SequenceFlow_02" name="Yes" sourceRef="Gateway_ForwardToPolice" targetRef="Task_StorePhysicalFile"/>
    <bpmn:sequenceFlow id="SequenceFlow_03" sourceRef="StartEvent_RequestReceived" targetRef="Gateway_ForwardToPolice"/>
    <bpmn:sequenceFlow id="SequenceFlow_04" name="Awaiting Report" sourceRef="Task_StorePhysicalFile" targetRef="Gateway_ReceivePoliceReport"/>
    <bpmn:sequenceFlow id="SequenceFlow_05" sourceRef="StartEvent_PoliceReport" targetRef="Gateway_ReceivePoliceReport"/>
    <bpmn:sequenceFlow id="SequenceFlow_06" name="Yes - Report Received" sourceRef="Gateway_ReceivePoliceReport" targetRef="Task_RetrieveSCTFile"/>
    <bpmn:sequenceFlow id="SequenceFlow_07" sourceRef="Task_RetrieveSCTFile" targetRef="Task_AttachNewDocument"/>
    <bpmn:sequenceFlow id="SequenceFlow_08" name="Attach Document" sourceRef="Task_AttachNewDocument" targetRef="Task_StoreExpandedFile"/>
    <bpmn:sequenceFlow id="SequenceFlow_09" sourceRef="Task_StoreExpandedFile" targetRef="EndFileReady"/>

  </bpmn:process>
</bpmn:definitions>