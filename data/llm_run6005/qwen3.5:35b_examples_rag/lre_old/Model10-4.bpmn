<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                 xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" 
                 xmlns:di="http://www.omg.org/spec/DD/20100524/DI" 
                 xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" 
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:collaboration id="Collaboration_EquipmentChange">
    <!-- Participants -->
    <bpmn:participant id="Participant_MPON" name="MPON" processRef="Process_MPON"/>
    <bpmn:participant id="Participant_MPOO" name="MPOO" processRef="Process_MPOO"/>
    <bpmn:participant id="Participant_GO" name="GO" processRef="Process_GO"/>

    <!-- Message Flows -->
    <bpmn:messageFlow id="Message_EquipmentChangeIntentions">
      <bpmn:name>Equipment Change Intentions</bpmn:name>
      <bpmn:sourceRef>StartEvent_MPON1</bpmn:sourceRef>
      <bpmn:targetRef>StartEvent_MPOO1</bpmn:targetRef>
    </bpmn:messageFlow>

    <bpmn:messageFlow id="Message_SelfDismountAnnouncement">
      <bpmn:name>Sellf-Dismounting Announcement</bpmn:name>
      <bpmn:sourceRef>End_MPOO_SelfDismount</bpmn:sourceRef>
      <bpmn:targetRef>Gateway_MPON_DismountDecision</bpmn:targetRef>
    </bpmn:messageFlow>

    <bpmn:messageFlow id="Message_FinalReadingToGO">
      <bpmn:name>Final Reading Values to GO</bpmn:name>
      <bpmn:sourceRef>End_MPON_ReadyForGO</bpmn:sourceRef>
      <bpmn:targetRef>StartEvent_GO1</bpmn:targetRef>
    </bpmn:messageFlow>

    <bpmn:messageFlow id="Message_DeviceChangesToGO">
      <bpmn:name>Device Changes, Master Data and Meter Count at Installation to GO</bpmn:name>
      <bpmn:sourceRef>Task_MPON_ReadMeterCount</bpmn:sourceRef>
      <bpmn:targetRef>StartEvent_GO1</bpmn:targetRef>
    </bpmn:messageFlow>

    <bpmn:messageFlow id="Message_MSPNotification">
      <bpmn:name>MSP Notification about Device Changes, Master Data and Meter Counts</bpmn:name>
      <bpmn:sourceRef>Task_GO_NotifyMSP</bpmn:sourceRef>
    </bpmn:messageFlow>

  </bpmn:collaboration>

  <!-- MPON Process -->
  <bpmn:process id="Process_MPON">
    <bpmn:startEvent id="StartEvent_MPON1" name="Equipment Change Intention Notification">
      <bpmn:outgoing>SequenceFlow_001</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Self-dismounting decision gateway -->
    <bpmn:exclusiveGateway id="Gateway_MPON_DismountDecision" name="Self-Dismounting?">
      <bpmn:incoming>SequenceFlow_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_002</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Final reading task -->
    <bpmn:task id="Task_MPON_FinalReading" name="Perform final reading">
      <bpmn:incoming>SequenceFlow_003</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_012</bpmn:outgoing>
    </bpmn:task>

    <!-- Dismount old equipment -->
    <bpmn:task id="Task_MPON_DismountOld" name="Dismount old equipment">
      <bpmn:incoming>SequenceFlow_012</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_013</bpmn:outgoing>
    </bpmn:task>

    <!-- Mount new device -->
    <bpmn:task id="Task_MPON_MountNewDevice" name="Mount new device">
      <bpmn:incoming>SequenceFlow_014</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_015</bpmn:outgoing>
    </bpmn:task>

    <!-- Read meter count -->
    <bpmn:task id="Task_MPON_ReadMeterCount" name="Read meter count from installed meter">
      <bpmn:incoming>SequenceFlow_015</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_016</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event for MPON -->
    <bpmn:endEvent id="End_MPON_ReadyForGO" name="Final Reading Sent to GO">
      <bpmn:incoming>SequenceFlow_016</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="SequenceFlow_001" sourceRef="StartEvent_MPON1" targetRef="Gateway_MPON_DismountDecision"/>
    <bpmn:sequenceFlow id="SequenceFlow_002" name="Yes - Self-dismounting possible" sourceRef="Gateway_MPON_DismountDecision" targetRef="Task_MPON_FinalReading">
      <bpmn:name>MPON performs final reading</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>

  <!-- MPOO Process -->
  <bpmn:process id="Process_MPOO">
    <bpmn:startEvent id="StartEvent_MPOO1" name="Equipment Change Notification Received">
      <bpmn:outgoing>SequenceFlow_021</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Self-dismounting decision -->
    <bpmn:exclusiveGateway id="Gateway_MPOO_DismountDecision" name="Self-Dismounting?">
      <bpmn:incoming>SequenceFlow_021</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_022</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Announce self-dismounting -->
    <bpmn:endEvent id="End_MPOO_SelfDismount" name="Self-Dismounting Announced">
      <bpmn:name>Sellf-Dismounting Announced</bpmn:name>
      <bpmn:incoming>SequenceFlow_023</bpmn:incoming>
    </bpmn:endEvent>

    <!-- No self-dismounting -->
    <bpmn:task id="Task_MPOO_NoSelfDismount" name="Notify MPON about no self-dismounting">
      <bpmn:incoming>SequenceFlow_024</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_016</bpmn:outgoing>
    </bpmn:task>

    <!-- Dismount old equipment -->
    <bpmn:endEvent id="End_MPOO_Dismount" name="Dismount Old Equipment Completed">
      <bpmn:name>Dismount Old Equipment Completed</bpmn:name>
      <bpmn:incoming>SequenceFlow_016</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="SequenceFlow_021" sourceRef="StartEvent_MPOO1" targetRef="Gateway_MPOO_DismountDecision"/>
    <bpmn:sequenceFlow id="SequenceFlow_022" name="Yes - Self-dismounting possible" sourceRef="Gateway_MPOO_DismountDecision" targetRef="End_MPOO_SelfDismount">
      <bpmn:name>Announce self dismounting</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>

  <!-- GO Process -->
  <bpmn:process id="Process_GO">
    <bpmn:startEvent id="StartEvent_GO1" name="Final Reading Received from MPON">
      <bpmn:outgoing>SequenceFlow_031</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Notify MSP -->
    <bpmn:endEvent id="End_GO_MSPNotification" name="Device Changes Notified to MSP">
      <bpmn:name>MSP Notification Sent</bpmn:name>
      <bpmn:incoming>SequenceFlow_032</bpmn:outgoing>
    </bpmn:endEvent>

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="SequenceFlow_031" sourceRef="StartEvent_GO1" targetRef="Task_GO_NotifyMSP"/>
    <bpmn:sequenceFlow id="SequenceFlow_032" name="Notify MSP about device changes, master data and meter counts" sourceRef="Task_GO_NotifyMSP" targetRef="End_GO_MSPNotification">
      <bpmn:name>Device Changes Notified to MSP</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>

</bpmn:definitions>