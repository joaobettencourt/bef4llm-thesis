<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_OrderProcess">
    <bpmn:participant id="Participant_AssemblerAG" name="Assembler AG" processRef="Process_Assembler" />
    <bpmn:participant id="Participant_Supplier" name="Supplier" processRef="Process_Supplier" />
  </bpmn:collaboration>

  <!-- Assembler AG Process -->
  <bpmn:process id="Process_Assembler">
    <bpmn:startEvent id="Start_TimerMonthly" name="First of Month&#10;Order Request">
      <bpmn:timerEventDefinition />
      <bpmn:outgoing>Flow_PlaceOrder</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_Assembler_Order" name="Place Order with Supplier">
      <bpmn:incoming>Flow_PlaceOrder</bpmn:incoming>
      <bpmn:outgoing>Flow_SendToSupplier</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="End_Assembler_InvoiceReceived" name="Invoice Received">
      <bpmn:incoming>Flow_ReceiveInvoice</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>

  <!-- Supplier Process -->
  <bpmn:process id="Process_Supplier">
    <bpmn:startEvent id="Start_OrderReceived" name="Order Received&#10;from Assembler AG">
      <bpmn:messageEventDefinition />
      <bpmn:outgoing>Flow_ProcessOrder</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_Supplier_ProcessOrder" name="Process Order&#10;from Assembler AG">
      <bpmn:incoming>Flow_ProcessOrder</bpmn:incoming>
      <bpmn:outgoing>Flow_SendInvoice</bpmn:outgoing>
    </bpmn:task>

  </bpmn:process>

  <!-- Sequence Flows -->
  <bpmn:sequenceFlow id="Flow_PlaceOrder" sourceRef="Start_TimerMonthly" targetRef="Task_Assembler_Order" />
  <bpmn:sequenceFlow id="Flow_SendToSupplier" name="Send Order Request" sourceRef="Task_Assembler_Order" targetRef="End_Assembler_InvoiceReceived">
    <!-- Note: Message flow handles the actual communication -->
  </bpmn:sequenceFlow>

  <bpmn:sequenceFlow id="Flow_ProcessOrder" sourceRef="Start_OrderReceived" targetRef="Task_Supplier_ProcessOrder" />
  <bpmn:sequenceFlow id="Flow_SendInvoice" name="Send Invoice to Assembler AG" sourceRef="Task_Supplier_ProcessOrder" targetRef="End_Assembler_InvoiceReceived">
    <!-- Note: Message flow handles the actual communication -->
  </bpmn:sequenceFlow>

</bpmn:definitions>