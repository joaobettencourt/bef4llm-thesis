<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_HRProcess">
    <bpmn:participant id="Participant_FunctionalDept" name="Functional Department" processRef="Process_Requester" />
    <bpmn:participant id="Participant_HRTeam" name="HR Team" processRef="Process_Recruitment" />
  </bpmn:collaboration>

  <!-- Process for Functional Department (Requester) -->
  <bpmn:process id="Process_Requester">
    <bpmn:startEvent id="Start_DemandPost" name="Demand to fill post">
      <bpmn:outgoing>Flow_SendToHR</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:endEvent id="End_ContractConcluded">
      <bpmn:incoming>Flow_ProcessComplete</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:messageFlowRef>Message_DemandPost</bpmn:messageFlowRef>
  </bpmn:process>

  <!-- Main Recruitment Process -->
  <bpmn:process id="Process_Recruitment">
    <bpmn:startEvent id="Start_RequestReceived" name="Request to fill post received">
      <bpmn:outgoing>Flow_Advertise</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Lane Set for Organization -->
    <bpmn:laneSet>
      <bpmn:lane id="Lane_HR" name="HR Team">
        <bpmn:flowNodeRef>Task_AdvertisePosition</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CheckApplications</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewApplications</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConcludeContract</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Task 1: Advertise Position -->
    <bpmn:task id="Task_AdvertisePosition" name="Advertise position">
      <bpmn:incoming>Flow_WaitApplications</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckQuality</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: Receive Applications -->
    <bpmn:task id="Task_ReceiveApplications" name="Collect applications">
      <bpmn:incoming>Message_ApplicationsReceived</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckQuality</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Check if qualified applicants exist -->
    <bpmn:exclusiveGateway id="Gateway_CheckApplications">
      <bpmn:incoming>Flow_CheckQuality</bpmn:incoming>
      <bpmn:outgoing>Flow_QualifiedApplicants</bpmn:outgoing>
      <bpmn:outgoing>Flow_NoQualifiedCandidates</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 3: Review Applications -->
    <bpmn:task id="Task_ReviewApplications" name="Check applications">
      <bpmn:incoming>Flow_QualifiedApplicants</bpmn:incoming>
      <bpmn:outgoing>Flow_SelectCandidate</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 4: Conclude Contract -->
    <bpmn:task id="Task_ConcludeContract" name="Conclude employment contract">
      <bpmn:incoming>Flow_SelectCandidate</bpmn:incoming>
      <bpmn:outgoing>Flow_ProcessComplete</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="End_PostFilled" name="Post filled">
      <bpmn:incoming>Flow_ProcessComplete</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Flow_Advertise" sourceRef="Start_RequestReceived" targetRef="Task_AdvertisePosition">
      <bpmn:name>Advertised</bpmn:name>
    </bpmn:sequenceFlow>
    
    <bpmn:sequenceFlow id="Flow_WaitApplications" name="Wait for applications">
      <bpmn:sourceRef>Task_AdvertisePosition</bpmn:sourceRef>
      <bpmn:targetRef>Gateway_CheckApplications</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Message flow for applications -->
    <bpmn:messageFlow id="Message_Applications" name="Application Submitted">
      <bpmn:name>Application Submitted</bpmn:name>
      <bpmn:sourceRef>Participant_FunctionalDept</bpmn:sourceRef>
      <bpmn:targetRef>Task_ReceiveApplications</bpmn:targetRef>
    </bpmn:messageFlow>

    <bpmn:sequenceFlow id="Flow_CheckQuality" name="Check applications quality">
      <bpmn:name>Qualified Applicants Found</bpmn:name>
      <bpmn:sourceRef>Task_ReceiveApplications</bpmn:sourceRef>
      <bpmn:targetRef>Gateway_CheckApplications</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Decision Flows -->
    <bpmn:sequenceFlow id="Flow_QualifiedApplicants" name="Qualified applicants exist">
      <bpmn:name>Yes - Qualified Applicants Found</bpmn:name>
      <bpmn:sourceRef>Gateway_CheckApplications</bpmn:sourceRef>
      <bpmn:targetRef>Task_ReviewApplications</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_NoQualifiedCandidates" name="No qualified applicants">
      <bpmn:name>No - No Qualified Candidates Found</bpmn:name>
      <bpmn:sourceRef>Gateway_CheckApplications</bpmn:sourceRef>
      <bpmn:targetRef>Task_AdvertisePosition</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Selection Flow -->
    <bpmn:sequenceFlow id="Flow_SelectCandidate" name="Select candidate">
      <bpmn:name>Select Candidate</bpmn:name>
      <bpmn:sourceRef>Task_ReviewApplications</bpmn:sourceRef>
      <bpmn:targetRef>Task_ConcludeContract</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Completion Flow -->
    <bpmn:sequenceFlow id="Flow_ProcessComplete" name="Process complete">
      <bpmn:name>Contract Concluded</bpmn:name>
      <bpmn:sourceRef>Task_ConcludeContract</bpmn:sourceRef>
      <bpmn:targetRef>End_PostFilled</bpmn:targetRef>
    </bpmn:sequenceFlow>

  </bpmn:process>
  
  <!-- Global Message Flow -->
  <bpmn:message id="Message_DemandPost" />
</bpmn:definitions>