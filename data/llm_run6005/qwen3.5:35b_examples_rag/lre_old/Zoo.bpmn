<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_ZooClub">
    <bpmn:participant id="Participant_Customer" name="Visitor/Customer" processRef="Process_Customer"/>
    <bpmn:participant id="Participant_ZooClub" name="ZooClub Department" processRef="Process_ZooClub"/>
    <bpmn:participant id="Participant_Billing" name="Billing Department" processRef="Process_Billing"/>
    <bpmn:participant id="Participant_Marketing" name="Marketing Department" processRef="Process_Marketing"/>
    <bpmn:participant id="Participant_Bank" name="Bank" processRef="Process_Bank"/>
    
    <!-- Message Flows between participants -->
    <bpmn:messageFlow id="MessageFlow_1" sourceRef="Task_Customer_SubmitInfo" targetRef="StartEvent_ZooClub_Request"/>
    <bpmn:messageFlow id="MessageFlow_2" sourceRef="Task_ZooClub_SendPaymentRequest" targetRef="StartEvent_Billing_PaymentReceived"/>
    <bpmn:messageFlow id="MessageFlow_3" sourceRef="Task_ZooClub_ForwardMarketingInfo" targetRef="StartEvent_Marketing_InfoReceived"/>
    <bpmn:messageFlow id="MessageFlow_4" sourceRef="Task_Billing_SendToBank" targetRef="StartEvent_Bank_PaymentRequest"/>
  </bpmn:collaboration>

  <!-- Customer Process -->
  <bpmn:process id="Process_Customer">
    <bpmn:startEvent id="StartEvent_Customer_Join" name="Join ZooClub Request">
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:exclusiveGateway id="Gateway_MembershipType">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_Customer_PrepareIndividual" name="Prepare Personal Information">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_Customer_PrepareFamily" name="Prepare Family Information">
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="End_Customer_Submitted" name="Information Submitted">
      <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_Customer_Join" targetRef="Gateway_MembershipType"/>
    <bpmn:sequenceFlow id="SequenceFlow_2" name="Individual Membership" sourceRef="Gateway_MembershipType" targetRef="Task_Customer_PrepareIndividual"/>
    <bpmn:sequenceFlow id="SequenceFlow_3" name="Family Membership" sourceRef="Gateway_MembershipType" targetRef="Task_Customer_PrepareFamily"/>
    <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="Task_Customer_PrepareIndividual" targetRef="End_Customer_Submitted"/>
    <bpmn:task id="Task_Customer_SubmitInfo" name="Submit Information to ZooClub">
      <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
    </bpmn:task>

  </bpmn:process>

  <!-- ZooClub Department Process -->
  <bpmn:process id="Process_ZooClub">
    <bpmn:startEvent id="StartEvent_ZooClub_Request" name="Membership Request Received">
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
      <bpmn:messageEventDefinition/>
    </bpmn:startEvent>

    <bpmn:task id="Task_ZooClub_DataEntry" name="Enter Data into System">
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
    </bpmn:task>

    <bpmn:parallelGateway id="Parallel_ZooClub">
      <bpmn:incoming>SequenceFlow_7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_8</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_9</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:task id="Task_ZooClub_ForwardMarketingInfo" name="Forward Info to Marketing">
      <bpmn:incoming>SequenceFlow_8</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="End_ZooClub_Complete" name="Card Delivered">
      <bpmn:incoming>SequenceFlow_12</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="StartEvent_ZooClub_Request" targetRef="Task_ZooClub_DataEntry"/>
    <bpmn:sequenceFlow id="SequenceFlow_7" name="Data Entered" sourceRef="Task_ZooClub_DataEntry" targetRef="Parallel_ZooClub"/>
    <bpmn:task id="Task_ZooClub_SendPaymentRequest" name="Send Payment Request to Billing">
      <bpmn:incoming>SequenceFlow_9</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
    </bpmn:task>

  </bpmn:process>

  <!-- Billing Department Process -->
  <bpmn:process id="Process_Billing">
    <bpmn:startEvent id="StartEvent_Billing_PaymentReceived" name="Payment Request Received">
      <bpmn:outgoing>SequenceFlow_13</bpmn:outgoing>
      <bpmn:messageEventDefinition/>
    </bpmn:startEvent>

    <bpmn:endEvent id="End_Billing_Complete" name="Request Sent to Bank">
      <bpmn:incoming>SequenceFlow_14</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow_13" sourceRef="StartEvent_Billing_PaymentReceived" targetRef="Task_ZooClub_SendPaymentRequest"/>
  </bpmn:process>

  <!-- Marketing Department Process -->
  <bpmn:process id="Process_Marketing">
    <bpmn:startEvent id="StartEvent_Marketing_InfoReceived" name="Visitor Info Received">
      <bpmn:outgoing>SequenceFlow_15</bpmn:outgoing>
      <bpmn:messageEventDefinition/>
    </bpmn:startEvent>

    <bpmn:endEvent id="End_Marketing_Complete" name="Magazine Mailed">
      <bpmn:incoming>SequenceFlow_16</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>

  <!-- Bank Process -->
  <bpmn:process id="Process_Bank">
    <bpmn:startEvent id="StartEvent_Bank_PaymentRequest" name="Payment Request from Billing">
      <bpmn:outgoing>SequenceFlow_17</bpmn:outgoing>
      <bpmn:messageEventDefinition/>
    </bpmn:startEvent>

  </bpmn:process>
</bpmn:definitions>