<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">
  <process id="ExpenseReportProcess" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>
    <task id="Task_1" name="Receive Expense Report">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="ExclusiveGateway_1"/>
    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
      <outgoing>SequenceFlow_4</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_1" targetRef="Task_AccountCheck">
      <conditionExpression xsi:type="tFormalExpression">${hasAccount}</conditionExpression>
    </sequenceFlow>
    <task id="Task_AccountCheck" name="Check Account">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_5</outgoing>
      <outgoing>SequenceFlow_14</outgoing>
    </task>
    <intermediateEvent id="IntermediateEvent_1">
      <incoming>SequenceFlow_4</incoming>
      <timerEventDefinition>
        <timeDuration>P28D</timeDuration>
      </timerEventDefinition>
      <outgoing>SequenceFlow_6</outgoing>
    </intermediateEvent>
    <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_1" targetRef="IntermediateEvent_1"/>
    <task id="Task_SendResubmitEmail" name="Send Resubmit Email">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_6" sourceRef="IntermediateEvent_1" targetRef="Task_SendResubmitEmail"/>
    <endEvent id="EndEvent_Resubmit">
      <incoming>SequenceFlow_7</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_5" sourceRef="Task_AccountCheck" targetRef="Task_ReviewExpenseReport"/>
    <task id="Task_CreateAccount" name="Create Account">
      <incoming>SequenceFlow_14</incoming>
      <outgoing>SequenceFlow_15</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_14" sourceRef="Task_AccountCheck" targetRef="Task_CreateAccount"/>
    <sequenceFlow id="SequenceFlow_15" sourceRef="Task_CreateAccount" targetRef="Task_ReviewExpenseReport"/>
    <task id="Task_ReviewExpenseReport" name="Review Expense Report">
      <incoming>SequenceFlow_5</incoming>
      <incoming>SequenceFlow_15</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </task>
    <exclusiveGateway id="ExclusiveGateway_2">
      <incoming>SequenceFlow_8</incoming>
      <outgoing>SequenceFlow_9</outgoing>
      <outgoing>SequenceFlow_10</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_8" sourceRef="Task_ReviewExpenseReport" targetRef="ExclusiveGateway_2">
      <conditionExpression xsi:type="tFormalExpression">${expenseAmount <= 200}</conditionExpression>
    </sequenceFlow>
    <task id="Task_ReimburseEmployee" name="Reimburse Employee">
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_11</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_9" sourceRef="ExclusiveGateway_2" targetRef="Task_ReimburseEmployee"/>
    <endEvent id="EndEvent_Reimbursed">
      <incoming>SequenceFlow_11</incoming>
    </endEvent>
    <userTask id="UserTask_RequestApproval" name="Request Supervisor Approval">
      <incoming>SequenceFlow_10</incoming>
      <outgoing>SequenceFlow_12</outgoing>
      <outgoing>SequenceFlow_16</outgoing>
    </userTask>
    <sequenceFlow id="SequenceFlow_10" sourceRef="ExclusiveGateway_2" targetRef="UserTask_RequestApproval"/>
    <exclusiveGateway id="ExclusiveGateway_3">
      <incoming>SequenceFlow_12</incoming>
      <outgoing>SequenceFlow_13</outgoing>
      <outgoing>SequenceFlow_17</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_12" sourceRef="UserTask_RequestApproval" targetRef="ExclusiveGateway_3">
      <conditionExpression xsi:type="tFormalExpression">${approvalStatus == 'approved'}</conditionExpression>
    </sequenceFlow>
    <task id="Task_NotifyApproved" name="Notify Employee of Approval">
      <incoming>SequenceFlow_13</incoming>
      <outgoing>SequenceFlow_18</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_13" sourceRef="ExclusiveGateway_3" targetRef="Task_NotifyApproved"/>
    <endEvent id="EndEvent_Approved">
      <incoming>SequenceFlow_18</incoming>
    </endEvent>
    <intermediateEvent id="IntermediateEvent_2">
      <incoming>SequenceFlow_16</incoming>
      <timerEventDefinition>
        <timeDuration>P7D</timeDuration>
      </timerEventDefinition>
      <outgoing>SequenceFlow_19</outgoing>
    </intermediateEvent>
    <sequenceFlow id="SequenceFlow_16" sourceRef="UserTask_RequestApproval" targetRef="IntermediateEvent_2"/>
    <task id="Task_NotifyInProgress" name="Notify Employee of Approval in Progress">
      <incoming>SequenceFlow_19</incoming>
      <outgoing>SequenceFlow_20</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_19" sourceRef="IntermediateEvent_2" targetRef="Task_NotifyInProgress"/>
    <sequenceFlow id="SequenceFlow_20" sourceRef="Task_NotifyInProgress" targetRef="UserTask_RequestApproval"/>
  </process>
</definitions>