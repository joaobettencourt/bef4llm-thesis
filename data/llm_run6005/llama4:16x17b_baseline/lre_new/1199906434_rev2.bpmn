<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">
  <process id="Process_1" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>
    <task id="Task_1" name="Check for typos">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
      <outgoing>SequenceFlow_3</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="ExclusiveGateway_1">
      <conditionExpression xsi:type="tFormalExpression">${typoFound == true}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="SequenceFlow_3" sourceRef="Task_1" targetRef="Task_2">
      <conditionExpression xsi:type="tFormalExpression">${typoFound == false}</conditionExpression>
    </sequenceFlow>
    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_4</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_1"/>
    <task id="Task_2" name="Check if customer can correct">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_5</outgoing>
      <outgoing>SequenceFlow_6</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_5" sourceRef="Task_2" targetRef="ExclusiveGateway_2">
      <conditionExpression xsi:type="tFormalExpression">${customerCanCorrect == true}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="SequenceFlow_6" sourceRef="Task_2" targetRef="Task_3">
      <conditionExpression xsi:type="tFormalExpression">${customerCanCorrect == false}</conditionExpression>
    </sequenceFlow>
    <exclusiveGateway id="ExclusiveGateway_2">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_7" sourceRef="ExclusiveGateway_2" targetRef="EndEvent_1"/>
    <task id="Task_3" name="Scour public sources">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_8" sourceRef="Task_3" targetRef="EndEvent_1"/>
    <endEvent id="EndEvent_1">
      <incoming>SequenceFlow_4</incoming>
      <incoming>SequenceFlow_7</incoming>
      <incoming>SequenceFlow_8</incoming>
    </endEvent>
  </process>
</definitions>