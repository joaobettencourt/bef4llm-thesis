<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">
   <process id="InvoiceProcess" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>
     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>
     <task id="Task_1" name="Sort Invoice per Client and Vendor">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="Task_2"/>
     <task id="Task_2" name="Attach Invoice Entry Form and Enter Required Info">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_3" sourceRef="Task_2" targetRef="Task_3"/>
     <task id="Task_3" name="Check Completeness of Invoice">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_4</outgoing>
       <outgoing>SequenceFlow_5</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_4" sourceRef="Task_3" targetRef="Task_6">
       <conditionExpression xsi:type="tFormalExpression">${invoiceComplete == true}</conditionExpression>
     </sequenceFlow>
     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_3" targetRef="EndEvent_1">
       <conditionExpression xsi:type="tFormalExpression">${invoiceComplete == false}</conditionExpression>
     </sequenceFlow>
     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_5</incoming>
     </endEvent>
     <task id="Task_6" name="Enter SLA Info and Check Priority">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_7</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_7" sourceRef="Task_6" targetRef="ExclusiveGateway_1"/>
     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_8</outgoing>
       <outgoing>SequenceFlow_9</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_8" sourceRef="ExclusiveGateway_1" targetRef="Task_7">
       <conditionExpression xsi:type="tFormalExpression">${priority == 'high'}</conditionExpression>
     </sequenceFlow>
     <task id="Task_7" name="Apply Red Stamp on Entry Invoice">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_10</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_10" sourceRef="Task_7" targetRef="Task_4"/>
     <task id="Task_4" name="Check Invoice Compliance">
       <incoming>SequenceFlow_10</incoming>
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_11</outgoing>
       <outgoing>SequenceFlow_12</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_9" sourceRef="ExclusiveGateway_1" targetRef="Task_4"/>
     <sequenceFlow id="SequenceFlow_11" sourceRef="Task_4" targetRef="Task_8">
       <conditionExpression xsi:type="tFormalExpression">${compliance == true}</conditionExpression>
     </sequenceFlow>
     <task id="Task_8" name="Allocate Invoice to DEO">
       <incoming>SequenceFlow_11</incoming>
       <outgoing>SequenceFlow_13</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_13" sourceRef="Task_8" targetRef="EndEvent_2"/>
     <endEvent id="EndEvent_2">
       <incoming>SequenceFlow_13</incoming>
     </endEvent>
     <sequenceFlow id="SequenceFlow_12" sourceRef="Task_4" targetRef="ExclusiveGateway_2"/>
     <exclusiveGateway id="ExclusiveGateway_2">
       <incoming>SequenceFlow_12</incoming>
       <outgoing>SequenceFlow_14</outgoing>
       <outgoing>SequenceFlow_15</outgoing>
       <outgoing>SequenceFlow_16</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_14" sourceRef="ExclusiveGateway_2" targetRef="Task_5"/>
     <task id="Task_5" name="Process Non-Compliance Invoice">
       <incoming>SequenceFlow_14</incoming>
       <outgoing>SequenceFlow_17</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_17" sourceRef="Task_5" targetRef="Task_4"/>
     <task id="Task_9" name="Send Postal Mail Requesting Information">
       <incoming>SequenceFlow_15</incoming>
       <outgoing>SequenceFlow_18</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_15" sourceRef="ExclusiveGateway_2" targetRef="Task_9"/>
     <intermediateCatchEvent id="IntermediateCatchEvent_1">
       <incoming>SequenceFlow_18</incoming>
       <timerEventDefinition>
         <timeDuration>PT10H</timeDuration>
       </timerEventDefinition>
       <outgoing>SequenceFlow_19</outgoing>
     </intermediateCatchEvent>
     <sequenceFlow id="SequenceFlow_18" sourceRef="Task_9" targetRef="IntermediateCatchEvent_1"/>
     <task id="Task_11" name="Send Reminder to Client">
       <incoming>SequenceFlow_19</incoming>
       <outgoing>SequenceFlow_20</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_19" sourceRef="IntermediateCatchEvent_1" targetRef="Task_11"/>
     <sequenceFlow id="SequenceFlow_20" sourceRef="Task_11" targetRef="Task_4"/>
     <task id="Task_10" name="Call Client and Request Information">
       <incoming>SequenceFlow_16</incoming>
       <outgoing>SequenceFlow_21</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_16" sourceRef="ExclusiveGateway_2" targetRef="Task_10"/>
     <sequenceFlow id="SequenceFlow_21" sourceRef="Task_10" targetRef="Task_4"/>
   </process>
 </definitions>