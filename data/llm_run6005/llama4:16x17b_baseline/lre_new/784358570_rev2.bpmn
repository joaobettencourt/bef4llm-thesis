<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">
  <process id="OrderProcess" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>
    <task id="Task_1" name="Review Order and Check Availability">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
      <outgoing>SequenceFlow_3</outgoing>
    </task>
    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_4</outgoing>
      <outgoing>SequenceFlow_5</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="ExclusiveGateway_1">
      <conditionExpression xsi:type="tFormalExpression">${allItemsAvailable}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="SequenceFlow_3" sourceRef="Task_1" targetRef="Task_2">
    </sequenceFlow>
    <task id="Task_2" name="Inform Customer about Delay and Order Missing Products">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_6" sourceRef="Task_2" targetRef="IntermediateCatchEvent_1"/>
    <intermediateCatchEvent id="IntermediateCatchEvent_1">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_7</outgoing>
      <timerEventDefinition>
        <timeDuration>P${x}D</timeDuration>
      </timerEventDefinition>
    </intermediateCatchEvent>
    <sequenceFlow id="SequenceFlow_7" sourceRef="IntermediateCatchEvent_1" targetRef="Task_3"/>
    <task id="Task_3" name="Check Availability Again">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_1" targetRef="Task_4"/>
    <task id="Task_4" name="Recollect Products and Prepare Package">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_9</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_9" sourceRef="Task_4" targetRef="Task_5"/>
    <task id="Task_5" name="Inform Courier about Pre-processed Package">
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_10</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_10" sourceRef="Task_5" targetRef="IntermediateCatchEvent_2"/>
    <intermediateCatchEvent id="IntermediateCatchEvent_2">
      <incoming>SequenceFlow_10</incoming>
      <outgoing>SequenceFlow_11</outgoing>
      <!-- Simulate waiting for courier to process delivery -->
      <timerEventDefinition>
        <timeDuration>P1D</timeDuration>
      </timerEventDefinition>
    </intermediateCatchEvent>
    <sequenceFlow id="SequenceFlow_11" sourceRef="IntermediateCatchEvent_2" targetRef="Task_6"/>
    <task id="Task_6" name="Pick up Package by Driver">
      <incoming>SequenceFlow_11</incoming>
      <outgoing>SequenceFlow_12</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_12" sourceRef="Task_6" targetRef="ServiceTask_1"/>
    <serviceTask id="ServiceTask_1" name="Decide Best Route for Delivery">
      <incoming>SequenceFlow_12</incoming>
      <outgoing>SequenceFlow_13</outgoing>
    </serviceTask>
    <sequenceFlow id="SequenceFlow_13" sourceRef="ServiceTask_1" targetRef="Task_7"/>
    <task id="Task_7" name="Deliver Package and Update System">
      <incoming>SequenceFlow_13</incoming>
      <outgoing>SequenceFlow_14</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_14" sourceRef="Task_7" targetRef="EndEvent_1"/>
    <endEvent id="EndEvent_1">
      <incoming>SequenceFlow_14</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_5" sourceRef="ExclusiveGateway_1" targetRef="Task_8"/>
    <task id="Task_8" name="Inform Customer about Discontinued Item">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_15</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_15" sourceRef="Task_8" targetRef="EndEvent_2"/>
    <endEvent id="EndEvent_2">
      <incoming>SequenceFlow_15</incoming>
    </endEvent>
  </process>
</definitions>