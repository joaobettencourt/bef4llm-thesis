<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">
  <process id="BankAccountLinkingProcess" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_EnterBankDetails"/>
    <task id="Task_EnterBankDetails" name="Enter Bank Details">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_EnterBankDetails" targetRef="ServiceTask_MakeDeposits"/>
    <serviceTask id="ServiceTask_MakeDeposits" name="Make Two Random Deposits">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
    </serviceTask>
    <sequenceFlow id="SequenceFlow_3" sourceRef="ServiceTask_MakeDeposits" targetRef="IntermediateEvent_WaitForDeposits"/>
    <intermediateEvent id="IntermediateEvent_WaitForDeposits" name="Wait for 3-5 Working Days">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_4</outgoing>
    </intermediateEvent>
    <sequenceFlow id="SequenceFlow_4" sourceRef="IntermediateEvent_WaitForDeposits" targetRef="Task_VerifyDeposits"/>
    <task id="Task_VerifyDeposits" name="Verify Deposits">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_5</outgoing>
      <outgoing>SequenceFlow_6</outgoing>
    </task>
    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>SequenceFlow_5</incoming>
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_7</outgoing>
      <outgoing>SequenceFlow_8</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_5" sourceRef="Task_VerifyDeposits" targetRef="ExclusiveGateway_1">
      <conditionExpression xsi:type="tFormalExpression">${depositsMatch == true}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="SequenceFlow_6" sourceRef="Task_VerifyDeposits" targetRef="ExclusiveGateway_1">
      <conditionExpression xsi:type="tFormalExpression">${depositsMatch == false}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="SequenceFlow_7" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_Linked"/>
    <endEvent id="EndEvent_Linked" name="Bank Account Linked">
      <incoming>SequenceFlow_7</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_8" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_Removed"/>
    <endEvent id="EndEvent_Removed" name="Bank Account Removed">
      <incoming>SequenceFlow_8</incoming>
    </endEvent>
  </process>
</definitions>