<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" targetNamespace="http://www.example.com">
  <process id="instructArtistProcess" name="Instruct Artist to Create 3D Model and Print" isExecutable="true">
    <startEvent id="startEvent1" name="Craving a Custom 3D Model">
      <outgoing>sequenceFlow1</outgoing>
    </startEvent>
    <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="task1"/>
    <task id="task1" name="Instruct Artist to Create Project">
      <incoming>sequenceFlow1</incoming>
      <outgoing>sequenceFlow2</outgoing>
    </task>
    <sequenceFlow id="sequenceFlow2" sourceRef="task1" targetRef="exclusiveGateway1"/>
    <exclusiveGateway id="exclusiveGateway1" name="Is Artist Satisfied?">
      <incoming>sequenceFlow2</incoming>
      <outgoing>sequenceFlow3</outgoing>
      <outgoing>sequenceFlow4</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="sequenceFlow3" sourceRef="exclusiveGateway1" targetRef="task2">
      <conditionExpression xsi:type="tFormalExpression">${artistSatisfied == true}</conditionExpression>
    </sequenceFlow>
    <task id="task2" name="Choose Plastic Color">
      <incoming>sequenceFlow3</incoming>
      <outgoing>sequenceFlow5</outgoing>
    </task>
    <sequenceFlow id="sequenceFlow5" sourceRef="task2" targetRef="exclusiveGateway2"/>
    <exclusiveGateway id="exclusiveGateway2" name="Do You Have Color at Home?">
      <incoming>sequenceFlow5</incoming>
      <outgoing>sequenceFlow6</outgoing>
      <outgoing>sequenceFlow7</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="sequenceFlow6" sourceRef="exclusiveGateway2" targetRef="task3">
      <conditionExpression xsi:type="tFormalExpression">${hasColorAtHome == true}</conditionExpression>
    </sequenceFlow>
    <task id="task3" name="Check Color Quantity">
      <incoming>sequenceFlow6</incoming>
      <outgoing>sequenceFlow8</outgoing>
    </task>
    <sequenceFlow id="sequenceFlow8" sourceRef="task3" targetRef="exclusiveGateway3"/>
    <exclusiveGateway id="exclusiveGateway3" name="Is Color Quantity Under 100g?">
      <incoming>sequenceFlow8</incoming>
      <outgoing>sequenceFlow9</outgoing>
      <outgoing>sequenceFlow10</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="sequenceFlow9" sourceRef="exclusiveGateway3" targetRef="task4">
      <conditionExpression xsi:type="tFormalExpression">${colorQuantity &lt; 100}</conditionExpression>
    </sequenceFlow>
    <task id="task4" name="Add Color to Shopping List">
      <incoming>sequenceFlow9</incoming>
      <outgoing>sequenceFlow11</outgoing>
    </task>
    <sequenceFlow id="sequenceFlow11" sourceRef="task4" targetRef="task5"/>
    <sequenceFlow id="sequenceFlow10" sourceRef="exclusiveGateway3" targetRef="task5">
      <conditionExpression xsi:type="tFormalExpression">${colorQuantity &gt;= 100}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="sequenceFlow7" sourceRef="exclusiveGateway2" targetRef="task6">
      <conditionExpression xsi:type="tFormalExpression">${hasColorAtHome == false}</conditionExpression>
    </sequenceFlow>
    <task id="task6" name="Order Color">
      <incoming>sequenceFlow7</incoming>
      <outgoing>sequenceFlow12</outgoing>
    </task>
    <sequenceFlow id="sequenceFlow12" sourceRef="task6" targetRef="task5"/>
    <task id="task5" name="Prepare 3D Printer">
      <incoming>sequenceFlow11</incoming>
      <incoming>sequenceFlow10</incoming>
      <outgoing>sequenceFlow13</outgoing>
    </task>
    <sequenceFlow id="sequenceFlow13" sourceRef="task5" targetRef="serviceTask1"/>
    <serviceTask id="serviceTask1" name="Turn On Printer and Heat Bed and Extruder">
      <incoming>sequenceFlow13</incoming>
      <outgoing>sequenceFlow14</outgoing>
    </serviceTask>
    <sequenceFlow id="sequenceFlow14" sourceRef="serviceTask1" targetRef="task7"/>
    <task id="task7" name="Generate Gcode File">
      <incoming>sequenceFlow14</incoming>
      <outgoing>sequenceFlow15</outgoing>
    </task>
    <sequenceFlow id="sequenceFlow15" sourceRef="task7" targetRef="task8"/>
    <task id="task8" name="Print 3D Model">
      <incoming>sequenceFlow15</incoming>
      <outgoing>sequenceFlow16</outgoing>
    </task>
    <sequenceFlow id="sequenceFlow16" sourceRef="task8" targetRef="endEvent1"/>
    <endEvent id="endEvent1" name="3D Model Printed">
      <incoming>sequenceFlow16</incoming>
    </endEvent>
  </process>
</definitions>