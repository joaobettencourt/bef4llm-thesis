<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" targetNamespace="http://www.example.com">

  <process id="workAccidentProcess" name="Work Accident Process" isExecutable="true">
    <startEvent id="startEvent" name="Employee Experiences Work Accident or Near Miss">
      <outgoing>sequenceFlow1</outgoing>
    </startEvent>

    <sequenceFlow id="sequenceFlow1" sourceRef="startEvent" targetRef="task1"/>

    <task id="task1" name="Inform Employer of Work Accident or Near Miss">
      <incoming>sequenceFlow1</incoming>
      <outgoing>sequenceFlow2</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow2" sourceRef="task1" targetRef="exclusiveGateway1"/>

    <exclusiveGateway id="exclusiveGateway1" name="Is Work Accident Reportable?">
      <incoming>sequenceFlow2</incoming>
      <outgoing>sequenceFlow3</outgoing>
      <outgoing>sequenceFlow4</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequenceFlow3" sourceRef="exclusiveGateway1" targetRef="task2">
      <conditionExpression xsi:type="tFormalExpression">${workAccident == true}</conditionExpression>
    </sequenceFlow>

    <task id="task2" name="Employer Reports Work Accident to Labour Inspectorate and Accident Insurance Provider">
      <incoming>sequenceFlow3</incoming>
      <outgoing>sequenceFlow5</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow5" sourceRef="task2" targetRef="endEvent1"/>

    <sequenceFlow id="sequenceFlow4" sourceRef="exclusiveGateway1" targetRef="task3">
      <conditionExpression xsi:type="tFormalExpression">${workAccident == false}</conditionExpression>
    </sequenceFlow>

    <task id="task3" name="Document and Review Near Miss Incident">
      <incoming>sequenceFlow4</incoming>
      <outgoing>sequenceFlow6</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow6" sourceRef="task3" targetRef="endEvent1"/>

    <endEvent id="endEvent1" name="Work Accident Process Complete">
      <incoming>sequenceFlow5</incoming>
      <incoming>sequenceFlow6</incoming>
    </endEvent>

  </process>

</definitions>