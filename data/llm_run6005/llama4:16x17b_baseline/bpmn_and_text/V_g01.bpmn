<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" targetNamespace="http://www.example.com">
  <process id="roboticBurgerSellerProcess" name="Robotic Burger Seller Process" isExecutable="true">
    <startEvent id="startEvent1" name="Receive Order">
      <outgoing>sequenceFlow1</outgoing>
    </startEvent>
    <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="exclusiveGateway1"/>
    <exclusiveGateway id="exclusiveGateway1" name="Does customer want a menu?">
      <incoming>sequenceFlow1</incoming>
      <outgoing>sequenceFlow2</outgoing>
      <outgoing>sequenceFlow3</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="sequenceFlow2" sourceRef="exclusiveGateway1" targetRef="task1">
      <conditionExpression xsi:type="tFormalExpression">${customerWantsMenu  == true}</conditionExpression>
    </sequenceFlow>
    <task id="task1" name="Prepare Drink">
      <incoming>sequenceFlow2</incoming>
      <outgoing>sequenceFlow4</outgoing>
    </task>
    <sequenceFlow id="sequenceFlow4" sourceRef="task1" targetRef="exclusiveGateway2"/>
    <exclusiveGateway id="exclusiveGateway2" name="Does customer want fries or wedges?">
      <incoming>sequenceFlow4</incoming>
      <outgoing>sequenceFlow5</outgoing>
      <outgoing>sequenceFlow6</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="sequenceFlow5" sourceRef="exclusiveGateway2" targetRef="task2">
      <conditionExpression xsi:type="tFormalExpression">${customerWantsFries  == true}</conditionExpression>
    </sequenceFlow>
    <task id="task2" name="Prepare Fries">
      <incoming>sequenceFlow5</incoming>
      <outgoing>sequenceFlow7</outgoing>
    </task>
    <sequenceFlow id="sequenceFlow7" sourceRef="task2" targetRef="mergeGateway1"/>
    <sequenceFlow id="sequenceFlow6" sourceRef="exclusiveGateway2" targetRef="task3">
      <conditionExpression xsi:type="tFormalExpression">${customerWantsWedges  == true}</conditionExpression>
    </sequenceFlow>
    <task id="task3" name="Prepare Wedges">
      <incoming>sequenceFlow6</incoming>
      <outgoing>sequenceFlow8</outgoing>
    </task>
    <sequenceFlow id="sequenceFlow8" sourceRef="task3" targetRef="mergeGateway1"/>
    <parallelGateway id="mergeGateway1">
      <incoming>sequenceFlow7</incoming>
      <incoming>sequenceFlow8</incoming>
      <outgoing>sequenceFlow9</outgoing>
    </parallelGateway>
    <sequenceFlow id="sequenceFlow9" sourceRef="mergeGateway1" targetRef="task4"/>
    <sequenceFlow id="sequenceFlow3" sourceRef="exclusiveGateway1" targetRef="task4">
      <conditionExpression xsi:type="tFormalExpression">${customerWantsMenu  == false}</conditionExpression>
    </sequenceFlow>
    <task id="task4" name="Prepare Burger">
      <incoming>sequenceFlow9</incoming>
      <incoming>sequenceFlow3</incoming>
      <outgoing>sequenceFlow10</outgoing>
    </task>
    <sequenceFlow id="sequenceFlow10" sourceRef="task4" targetRef="serviceTask1"/>
    <serviceTask id="serviceTask1" name="Give Enthusiastic Status Updates">
      <incoming>sequenceFlow10</incoming>
      <outgoing>sequenceFlow11</outgoing>
    </serviceTask>
    <sequenceFlow id="sequenceFlow11" sourceRef="serviceTask1" targetRef="endEvent1"/>
    <endEvent id="endEvent1" name="Deliver Order via Conveyor Belt">
      <incoming>sequenceFlow11</incoming>
    </endEvent>
  </process>
</definitions>