<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" targetNamespace="http://www.example.com">
  <process id="chainsawProductionProcess" name="Chainsaw Production Process" isExecutable="true">
    <startEvent id="startEvent1" name="Start Chainsaw Production">
      <outgoing>sequenceFlow1</outgoing>
    </startEvent>
    <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="task1"/>
    <task id="task1" name="Gather Customer Requirements">
      <incoming>sequenceFlow1</incoming>
      <outgoing>sequenceFlow2</outgoing>
    </task>
    <sequenceFlow id="sequenceFlow2" sourceRef="task1" targetRef="parallelGateway1"/>
    <parallelGateway id="parallelGateway1">
      <incoming>sequenceFlow2</incoming>
      <outgoing>sequenceFlow3</outgoing>
      <outgoing>sequenceFlow4</outgoing>
      <outgoing>sequenceFlow5</outgoing>
      <outgoing>sequenceFlow6</outgoing>
      <outgoing>sequenceFlow7</outgoing>
    </parallelGateway>
    <task id="task2" name="Order Guide Bar">
      <incoming>sequenceFlow3</incoming>
      <outgoing>sequenceFlow8</outgoing>
    </task>
    <sequenceFlow id="sequenceFlow3" sourceRef="parallelGateway1" targetRef="task2"/>
    <task id="task3" name="Order Chain">
      <incoming>sequenceFlow4</incoming>
      <outgoing>sequenceFlow9</outgoing>
    </task>
    <sequenceFlow id="sequenceFlow4" sourceRef="parallelGateway1" targetRef="task3"/>
    <task id="task4" name="Order Motor">
      <incoming>sequenceFlow5</incoming>
      <outgoing>sequenceFlow10</outgoing>
    </task>
    <sequenceFlow id="sequenceFlow5" sourceRef="parallelGateway1" targetRef="task4"/>
    <task id="task5" name="Order Electric Components">
      <incoming>sequenceFlow6</incoming>
      <outgoing>sequenceFlow11</outgoing>
    </task>
    <sequenceFlow id="sequenceFlow6" sourceRef="parallelGateway1" targetRef="task5"/>
    <task id="task6" name="Order Other Components">
      <incoming>sequenceFlow7</incoming>
      <outgoing>sequenceFlow12</outgoing>
    </task>
    <sequenceFlow id="sequenceFlow7" sourceRef="parallelGateway1" targetRef="task6"/>
    <exclusiveGateway id="exclusiveGateway1">
      <incoming>sequenceFlow8</incoming>
      <incoming>sequenceFlow9</incoming>
      <incoming>sequenceFlow10</incoming>
      <incoming>sequenceFlow11</incoming>
      <incoming>sequenceFlow12</incoming>
      <outgoing>sequenceFlow13</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="sequenceFlow8" sourceRef="task2" targetRef="exclusiveGateway1"/>
    <sequenceFlow id="sequenceFlow9" sourceRef="task3" targetRef="exclusiveGateway1"/>
    <sequenceFlow id="sequenceFlow10" sourceRef="task4" targetRef="exclusiveGateway1"/>
    <sequenceFlow id="sequenceFlow11" sourceRef="task5" targetRef="exclusiveGateway1"/>
    <sequenceFlow id="sequenceFlow12" sourceRef="task6" targetRef="exclusiveGateway1"/>
    <sequenceFlow id="sequenceFlow13" sourceRef="exclusiveGateway1" targetRef="task7"/>
    <task id="task7" name="Inspect Parts">
      <incoming>sequenceFlow13</incoming>
      <outgoing>sequenceFlow14</outgoing>
    </task>
    <sequenceFlow id="sequenceFlow14" sourceRef="task7" targetRef="task8"/>
    <task id="task8" name="Assemble Chainsaw">
      <incoming>sequenceFlow14</incoming>
      <outgoing>sequenceFlow15</outgoing>
    </task>
    <sequenceFlow id="sequenceFlow15" sourceRef="task8" targetRef="exclusiveGateway2"/>
    <exclusiveGateway id="exclusiveGateway2">
      <incoming>sequenceFlow15</incoming>
      <outgoing>sequenceFlow16</outgoing>
      <outgoing>sequenceFlow17</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="sequenceFlow16" sourceRef="exclusiveGateway2" targetRef="task9"/>
    <task id="task9" name="Send Chainsaw to Customer">
      <incoming>sequenceFlow16</incoming>
      <outgoing>sequenceFlow18</outgoing>
    </task>
    <sequenceFlow id="sequenceFlow18" sourceRef="task9" targetRef="endEvent1"/>
    <sequenceFlow id="sequenceFlow17" sourceRef="exclusiveGateway2" targetRef="task10"/>
    <task id="task10" name="Improve Production Process">
      <incoming>sequenceFlow17</incoming>
      <outgoing>sequenceFlow19</outgoing>
    </task>
    <sequenceFlow id="sequenceFlow19" sourceRef="task10" targetRef="endEvent1"/>
    <endEvent id="endEvent1" name="Chainsaw Production End">
      <incoming>sequenceFlow18</incoming>
      <incoming>sequenceFlow19</incoming>
    </endEvent>
  </process>
</definitions>