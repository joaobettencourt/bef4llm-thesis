<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" targetNamespace="http://www.example.com">
  <process id="lanPartyProcess" name="LAN Party Process" isExecutable="true">
    <startEvent id="startEvent" name="Plan LAN Party">
      <outgoing>sequenceFlow1</outgoing>
    </startEvent>
    <sequenceFlow id="sequenceFlow1" sourceRef="startEvent" targetRef="task1"/>
    <task id="task1" name="Send Invitations">
      <incoming>sequenceFlow1</incoming>
      <outgoing>sequenceFlow2</outgoing>
    </task>
    <sequenceFlow id="sequenceFlow2" sourceRef="task1" targetRef="task2"/>
    <task id="task2" name="Collect Game Preferences">
      <incoming>sequenceFlow2</incoming>
      <outgoing>sequenceFlow3</outgoing>
    </task>
    <sequenceFlow id="sequenceFlow3" sourceRef="task2" targetRef="task3"/>
    <task id="task3" name="Appoint Date">
      <incoming>sequenceFlow3</incoming>
      <outgoing>sequenceFlow4</outgoing>
      <outgoing>sequenceFlow5</outgoing>
    </task>
    <exclusiveGateway id="exclusiveGateway1" name="Is Date Confirmed?">
      <incoming>sequenceFlow4</incoming>
      <outgoing>sequenceFlow6</outgoing>
      <outgoing>sequenceFlow7</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="sequenceFlow4" sourceRef="task3" targetRef="exclusiveGateway1">
      <conditionExpression xsi:type="tFormalExpression">${confirmedDate == true}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="sequenceFlow7" sourceRef="exclusiveGateway1" targetRef="task3">
      <conditionExpression xsi:type="tFormalExpression">${confirmedDate == false}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="sequenceFlow6" sourceRef="exclusiveGateway1" targetRef="task4"/>
    <task id="task4" name="Check Games Availability">
      <incoming>sequenceFlow6</incoming>
      <outgoing>sequenceFlow8</outgoing>
      <outgoing>sequenceFlow9</outgoing>
    </task>
    <exclusiveGateway id="exclusiveGateway2" name="Are All Games Available?">
      <incoming>sequenceFlow8</incoming>
      <outgoing>sequenceFlow10</outgoing>
      <outgoing>sequenceFlow11</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="sequenceFlow8" sourceRef="task4" targetRef="exclusiveGateway2">
      <conditionExpression xsi:type="tFormalExpression">${allGamesAvailable == true}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="sequenceFlow11" sourceRef="exclusiveGateway2" targetRef="task5">
      <conditionExpression xsi:type="tFormalExpression">${allGamesAvailable == false}</conditionExpression>
    </sequenceFlow>
    <task id="task5" name="Download Missing Games">
      <incoming>sequenceFlow11</incoming>
      <outgoing>sequenceFlow12</outgoing>
    </task>
    <sequenceFlow id="sequenceFlow12" sourceRef="task5" targetRef="task6"/>
    <task id="task6" name="Check Beer Availability">
      <incoming>sequenceFlow10</incoming>
      <incoming>sequenceFlow12</incoming>
      <outgoing>sequenceFlow13</outgoing>
      <outgoing>sequenceFlow14</outgoing>
    </task>
    <exclusiveGateway id="exclusiveGateway3" name="Is Enough Beer Available?">
      <incoming>sequenceFlow13</incoming>
      <outgoing>sequenceFlow15</outgoing>
      <outgoing>sequenceFlow16</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="sequenceFlow13" sourceRef="task6" targetRef="exclusiveGateway3">
      <conditionExpression xsi:type="tFormalExpression">${enoughBeer == true}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="sequenceFlow16" sourceRef="exclusiveGateway3" targetRef="task7">
      <conditionExpression xsi:type="tFormalExpression">${enoughBeer == false}</conditionExpression>
    </sequenceFlow>
    <task id="task7" name="Buy Beer">
      <incoming>sequenceFlow16</incoming>
      <outgoing>sequenceFlow17</outgoing>
    </task>
    <sequenceFlow id="sequenceFlow17" sourceRef="task7" targetRef="endEvent"/>
    <sequenceFlow id="sequenceFlow15" sourceRef="exclusiveGateway3" targetRef="endEvent"/>
    <endEvent id="endEvent" name="LAN Party">
      <incoming>sequenceFlow15</incoming>
      <incoming>sequenceFlow17</incoming>
    </endEvent>
  </process>
</definitions>