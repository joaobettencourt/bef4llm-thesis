<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" targetNamespace="http://www.example.com">
  <process id="internshipProcess" name="Internship Process" isExecutable="true">
    <startEvent id="startEvent1" name="Start Internship Application">
      <outgoing>sequenceFlow1</outgoing>
    </startEvent>
    <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="task1"/>
    <task id="task1" name="Enter Application Details">
      <incoming>sequenceFlow1</incoming>
      <outgoing>sequenceFlow2</outgoing>
    </task>
    <sequenceFlow id="sequenceFlow2" sourceRef="task1" targetRef="intermediateCatchEvent1"/>
    <intermediateCatchEvent id="intermediateCatchEvent1" name="Wait for Offers">
      <incoming>sequenceFlow2</incoming>
      <outgoing>sequenceFlow3</outgoing>
    </intermediateCatchEvent>
    <sequenceFlow id="sequenceFlow3" sourceRef="intermediateCatchEvent1" targetRef="exclusiveGateway1"/>
    <exclusiveGateway id="exclusiveGateway1" name="Handle Offer">
      <incoming>sequenceFlow3</incoming>
      <outgoing>sequenceFlow4</outgoing>
      <outgoing>sequenceFlow5</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="sequenceFlow4" sourceRef="exclusiveGateway1" targetRef="task2">
      <conditionExpression xsi:type="tFormalExpression">${offerAccepted == true}</conditionExpression>
    </sequenceFlow>
    <task id="task2" name="Accept Offer">
      <incoming>sequenceFlow4</incoming>
      <outgoing>sequenceFlow6</outgoing>
    </task>
    <sequenceFlow id="sequenceFlow6" sourceRef="task2" targetRef="subProcess1"/>
    <subProcess id="subProcess1" name="Internship Period">
      <incoming>sequenceFlow6</incoming>
      <startEvent id="startEvent2" name="Start Internship">
        <outgoing>sequenceFlow7</outgoing>
      </startEvent>
      <sequenceFlow id="sequenceFlow7" sourceRef="startEvent2" targetRef="task3"/>
      <task id="task3" name="Write Status Update (Intern)">
        <incoming>sequenceFlow7</incoming>
        <outgoing>sequenceFlow8</outgoing>
      </task>
      <sequenceFlow id="sequenceFlow8" sourceRef="task3" targetRef="exclusiveGateway2"/>
      <exclusiveGateway id="exclusiveGateway2" name="Is Internship Finished?">
        <incoming>sequenceFlow8</incoming>
        <outgoing>sequenceFlow9</outgoing>
        <outgoing>sequenceFlow10</outgoing>
      </exclusiveGateway>
      <sequenceFlow id="sequenceFlow9" sourceRef="exclusiveGateway2" targetRef="task3">
        <conditionExpression xsi:type="tFormalExpression">${statusUpdateCount < 3}</conditionExpression>
      </sequenceFlow>
      <sequenceFlow id="sequenceFlow10" sourceRef="exclusiveGateway2" targetRef="endEvent1">
        <conditionExpression xsi:type="tFormalExpression">${statusUpdateCount >= 3}</conditionExpression>
      </sequenceFlow>
      <task id="task4" name="Company Writes Status Update">
        <!-- omitted for brevity -->
      </task>
      <outgoing>sequenceFlow11</outgoing>
    </subProcess>
    <sequenceFlow id="sequenceFlow11" sourceRef="subProcess1" targetRef="exclusiveGateway3"/>
    <exclusiveGateway id="exclusiveGateway3" name="Recommend Company?">
      <incoming>sequenceFlow11</incoming>
      <outgoing>sequenceFlow12</outgoing>
      <outgoing>sequenceFlow13</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="sequenceFlow12" sourceRef="exclusiveGateway3" targetRef="task5">
      <conditionExpression xsi:type="tFormalExpression">${recommendation == true}</conditionExpression>
    </sequenceFlow>
    <task id="task5" name="Recommend Company on Twitter">
      <!-- omitted for brevity -->
    </task>
    <endEvent id="endEvent1" name="Internship Application Finished">
      <incoming>sequenceFlow10</incoming>
    </endEvent>
  </process>
</definitions>