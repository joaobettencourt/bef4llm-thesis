<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definitions" 
             targetNamespace="http://example.com/bpmn">

   <process id="roomServiceProcess" isExecutable="true">
     <startEvent id="orderReceived">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="orderReceived" targetRef="submitOrderToKitchen"/>

     <serviceTask id="submitOrderToKitchen">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlow2" sourceRef="submitOrderToKitchen" targetRef="parallelGateway1"/>

     <parallelGateway id="parallelGateway1">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
       <outgoing>sequenceFlow4</outgoing>
     </parallelGateway>

     <sequenceFlow id="sequenceFlow3" sourceRef="parallelGateway1" targetRef="prepareFoodTask"/>

     <serviceTask id="prepareFoodTask">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow5</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlow5" sourceRef="prepareFoodTask" targetRef="parallelGateway2"/>

     <sequenceFlow id="sequenceFlow4" sourceRef="parallelGateway1" targetRef="sommelierTask">
       <!-- conditionExpression for 80% of cases -->
     </sequenceFlow>

     <serviceTask id="sommelierTask">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow6</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlow6" sourceRef="sommelierTask" targetRef="parallelGateway2"/>

     <parallelGateway id="parallelGateway2">
       <incoming>sequenceFlow5</incoming>
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow7</outgoing>
     </parallelGateway>

     <sequenceFlow id="sequenceFlow7" sourceRef="parallelGateway2" targetRef="waiterTask"/>

     <serviceTask id="waiterTask">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow8</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlow8" sourceRef="waiterTask" targetRef="exclusiveGateway1"/>

     <exclusiveGateway id="exclusiveGateway1">
       <incoming>sequenceFlow8</incoming>
       <outgoing>sequenceFlow9</outgoing>
       <outgoing>sequenceFlow10</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow9" sourceRef="exclusiveGateway1" targetRef="deliverTask">
       <!-- condition -->
     </sequenceFlow>

     <serviceTask id="deliverTask">
       <incoming>sequenceFlow9</incoming>
       <outgoing>sequenceFlow11</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlow11" sourceRef="deliverTask" targetRef="debitAccountTask"/>

     <sequenceFlow id="sequenceFlow10" sourceRef="exclusiveGateway1" targetRef="debitAccountTask"/>

     <serviceTask id="debitAccountTask">
       <incoming>sequenceFlow10</incoming>
       <incoming>sequenceFlow11</incoming>
       <outgoing>sequenceFlow12</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlow12" sourceRef="debitAccountTask" targetRef="orderCompleted"/>

     <endEvent id="orderCompleted">
       <incoming>sequenceFlow12</incoming>
     </endEvent>
   </process>
 </definitions>