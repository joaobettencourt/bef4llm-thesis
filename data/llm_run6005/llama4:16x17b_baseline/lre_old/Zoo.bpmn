<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definition" name="ZooClub Membership Process" targetNamespace="http://example.com/bpmn">

   <process id="zooClubMembershipProcess" isExecutable="true">
     <startEvent id="startEvent1">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <exclusiveGateway id="exclusiveGateway1">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
       <outgoing>sequenceFlow3</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="exclusiveGateway1"/>

     <userTask id="prepareIndividualInfo">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow4</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow2" sourceRef="exclusiveGateway1" targetRef="prepareIndividualInfo"/>

     <userTask id="prepareFamilyInfo">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow5</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow3" sourceRef="exclusiveGateway1" targetRef="prepareFamilyInfo"/>

     <sequenceFlow id="sequenceFlow4" sourceRef="prepareIndividualInfo" targetRef="sendToZooClubDept"/>

     <sequenceFlow id="sequenceFlow5" sourceRef="prepareFamilyInfo" targetRef="sendToZooClubDept"/>

     <userTask id="sendToZooClubDept">
       <incoming>sequenceFlow4</incoming>
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow6</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow6" sourceRef="sendToZooClubDept" targetRef="zooClubDeptProcessing"/>

     <userTask id="zooClubDeptProcessing">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow7</outgoing>
       <outgoing>sequenceFlow8</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow7" sourceRef="zooClubDeptProcessing" targetRef="billingDeptRequest"/>

     <sequenceFlow id="sequenceFlow8" sourceRef="zooClubDeptProcessing" targetRef="marketingDeptRequest1"/>

     <userTask id="billingDeptRequest">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow9</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow9" sourceRef="billingDeptRequest" targetRef="bankProcessing"/>

     <userTask id="bankProcessing">
       <incoming>sequenceFlow9</incoming>
       <outgoing>sequenceFlow10</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow10" sourceRef="bankProcessing" targetRef="paymentConfirmed1"/>

     <intermediateEvent id="paymentConfirmed1" name="Payment confirmed">
       <incoming>sequenceFlow10</incoming>
       <outgoing>sequenceFlow11</outgoing>
     </intermediateEvent>

     <sequenceFlow id="sequenceFlow11" sourceRef="paymentConfirmed1" targetRef="zooClubDeptPrintCard"/>

     <userTask id="zooClubDeptPrintCard">
       <incoming>sequenceFlow11</incoming>
       <outgoing>sequenceFlow12</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow12" sourceRef="zooClubDeptPrintCard" targetRef="endEvent1"/>

     <userTask id="marketingDeptRequest1">
       <incoming>sequenceFlow8</incoming>
       <outgoing>sequenceFlow13</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow13" sourceRef="marketingDeptRequest1" targetRef="marketingDeptMailMagazine"/>

     <userTask id="marketingDeptMailMagazine">
       <incoming>sequenceFlow13</incoming>
       <outgoing>sequenceFlow14</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow14" sourceRef="marketingDeptMailMagazine" targetRef="endEvent1"/>

     <endEvent id="endEvent1">
       <incoming>sequenceFlow12</incoming>
       <incoming>sequenceFlow14</incoming>
     </endEvent>
   </process>
</definitions>