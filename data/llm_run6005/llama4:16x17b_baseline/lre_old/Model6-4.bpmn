<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Sales Process">

   <process id="salesProcess" isExecutable="true">
     <startEvent id="startEvent1" name="Start Sales Process">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="exclusiveGateway1"/>

     <exclusiveGateway id="exclusiveGateway1" name="How to Determine Contact Details?">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
       <outgoing>sequenceFlow3</outgoing>
       <outgoing>sequenceFlow4</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow2" name="Buy details for cold calls" sourceRef="exclusiveGateway1" targetRef="task1"/>
     <sequenceFlow id="sequenceFlow3" name="Marketing staff participates in exhibitions" sourceRef="exclusiveGateway1" targetRef="task1"/>
     <sequenceFlow id="sequenceFlow4" name="Personal connection" sourceRef="exclusiveGateway1" targetRef="task1"/>

     <task id="task1" name="Determine Contact Details and Initial Budget">
       <incoming>sequenceFlow2</incoming>
       <incoming>sequenceFlow3</incoming>
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow5</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow5" sourceRef="task1" targetRef="exclusiveGateway2"/>

     <exclusiveGateway id="exclusiveGateway2" name="Is Customer Interested?">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow6</outgoing>
       <outgoing>sequenceFlow7</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow6" name="Customer not interested and budget is normal" sourceRef="exclusiveGateway2" targetRef="endEvent1">
       <!-- Assuming a condition here for simplicity -->
     </sequenceFlow>

     <sequenceFlow id="sequenceFlow7" name="Customer interested or huge budget" sourceRef="exclusiveGateway2" targetRef="task2">
       <!-- Assuming a condition here for simplicity -->
     </sequenceFlow>

     <endEvent id="endEvent1" name="Leave Customer Alone">
       <incoming>sequenceFlow6</incoming>
     </endEvent>

     <task id="task2" name="Online Presentation by Sales/Pre-Sales Staff">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow8</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow8" sourceRef="task2" targetRef="exclusiveGateway3"/>

     <exclusiveGateway id="exclusiveGateway3" name="Has Customer Responded Within 2 Weeks?">
       <incoming>sequenceFlow8</incoming>
       <outgoing>sequenceFlow9</outgoing>
       <outgoing>sequenceFlow10</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow9" sourceRef="exclusiveGateway3" targetRef="task4"/>
     <sequenceFlow id="sequenceFlow10" sourceRef="exclusiveGateway3" targetRef="task3"/>

     <task id="task3" name="Follow-up Call by Sales Representative">
       <incoming>sequenceFlow10</incoming>
       <outgoing>sequenceFlow11</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow11" sourceRef="task3" targetRef="task4"/>

     <task id="task4" name="Create Quotation">
       <incoming>sequenceFlow9</incoming>
       <incoming>sequenceFlow11</incoming>
       <outgoing>sequenceFlow12</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow12" sourceRef="task4" targetRef="endEvent2"/>

     <endEvent id="endEvent2" name="Quotation Sent">
       <incoming>sequenceFlow12</incoming>
     </endEvent>
   </process>
</definitions>