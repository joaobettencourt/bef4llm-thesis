<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" 
             targetNamespace="http://example.com/bpmn">

   <process id="changeMasterDataProcess" isExecutable="true">
     <startEvent id="startEvent1">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="task_EC_tells_INQ_about_change"/>

     <serviceTask id="task_EC_tells_INQ_about_change" name="EC tells INQ about change">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlow2" sourceRef="task_EC_tells_INQ_about_change" targetRef="task_INQ_notifies_IP_of_change"/>

     <serviceTask id="task_INQ_notifies_IP_of_change" name="INQ notifies IP of change">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlow3" sourceRef="task_INQ_notifies_IP_of_change" targetRef="exclusiveGateway1"/>

     <exclusiveGateway id="exclusiveGateway1">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow4</outgoing>
       <outgoing>sequenceFlow5</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow4" name="Confirm" sourceRef="exclusiveGateway1" targetRef="task_IP_confirms_changes">
     </sequenceFlow>

     <userTask id="task_IP_confirms_changes" name="IP confirms changes">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow6</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow6" sourceRef="task_IP_confirms_changes" targetRef="endEvent1"/>

     <endEvent id="endEvent1">
       <incoming>sequenceFlow6</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow5" name="Reject" sourceRef="exclusiveGateway1" targetRef="task_IP_rejects_changes"/>
     
     <userTask id="task_IP_rejects_changes" name="IP rejects changes">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow7</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow7" sourceRef="task_IP_rejects_changes" targetRef="endEvent2"/>

     <endEvent id="endEvent2">
       <incoming>sequenceFlow7</incoming>
     </endEvent>

   </process>

</definitions>