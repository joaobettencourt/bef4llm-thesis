<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
                  id="definitions" name="MPON_MPOO_Process">

  <bpmn:process id="equipment_change_process" isExecutable="true">
    <bpmn:startEvent id="start_event">
      <bpmn:outgoing>sequence_flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:sequenceFlow id="sequence_flow_1" sourceRef="start_event" targetRef="task_mpon_notifies_mpco"/>

    <bpmn:serviceTask id="task_mpon_notifies_mpco" name="MPON notifies MPOO about equipment change intentions">
      <bpmn:outgoing>sequence_flow_2</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="exclusive_gateway_1">
      <bpmn:incoming>sequence_flow_2</bpmn:incoming>
      <bpmn:outgoing>sequence_flow_3</bpmn:outgoing>
      <bpmn:outgoing>sequence_flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="sequence_flow_2" sourceRef="task_mpon_notifies_mpco" targetRef="exclusive_gateway_1"/>

    <bpmn:serviceTask id="task_mpco_announces_self_dismounting" name="MPOO announces self dismounting to MPON">
      <bpmn:incoming>sequence_flow_3</bpmn:incoming>
      <bpmn:outgoing>sequence_flow_5</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="sequence_flow_3" sourceRef="exclusive_gateway_1" targetRef="task_mpco_announces_self_dismounting"/>

    <bpmn:serviceTask id="task_mpco_notifies_mpcon_no_self_dismounting" name="MPOO notifies MPON about no self-dismounting">
      <bpmn:incoming>sequence_flow_4</bpmn:incoming>
      <bpmn:outgoing>sequence_flow_5b</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="sequence_flow_4" sourceRef="exclusive_gateway_1" targetRef="task_mpco_notifies_mpcon_no_self_dismounting"/>

    <bpmn:parallelGateway id="parallel_gateway_1">
      <bpmn:incoming>sequence_flow_5</bpmn:incoming>
      <bpmn:incoming>sequence_flow_5b</bpmn:incoming>
      <bpmn:outgoing>sequence_flow_6</bpmn:outgoing>
      <bpmn:outgoing>sequence_flow_7</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:sequenceFlow id="sequence_flow_5" sourceRef="task_mpco_announces_self_dismounting" targetRef="parallel_gateway_1"/>
    <bpmn:sequenceFlow id="sequence_flow_5b" sourceRef="task_mpco_notifies_mpcon_no_self_dismounting" targetRef="parallel_gateway_1"/>

    <bpmn:serviceTask id="task_mpon_or_mpco_perform_final_reading" name="MPON or MPOO perform the final reading">
      <bpmn:incoming>sequence_flow_6</bpmn:incoming>
      <bpmn:outgoing>sequence_flow_8</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="sequence_flow_6" sourceRef="parallel_gateway_1" targetRef="task_mpon_or_mpco_perform_final_reading"/>

    <bpmn:serviceTask id="task_mpon_or_mpco_dismount_old_equipment" name="MPON or MPOO dismount the old equipment">
      <bpmn:incoming>sequence_flow_7</bpmn:incoming>
      <bpmn:outgoing>sequence_flow_9</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="sequence_flow_7" sourceRef="parallel_gateway_1" targetRef="task_mpon_or_mpco_dismount_old_equipment"/>

    <bpmn:serviceTask id="task_mpon_mounts_new_device" name="MPON mounts the new device">
      <bpmn:incoming>sequence_flow_8</bpmn:incoming>
      <bpmn:outgoing>sequence_flow_10</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="sequence_flow_8" sourceRef="task_mpon_or_mpco_perform_final_reading" targetRef="task_mpon_mounts_new_device"/>

    <bpmn:serviceTask id="task_mpon_reads_meter_count" name="MPON reads the meter count from installed meter">
      <bpmn:incoming>sequence_flow_9</bpmn:incoming>
      <bpmn:outgoing>sequence_flow_11</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="sequence_flow_9" sourceRef="task_mpon_or_mpco_dismount_old_equipment" targetRef="task_mpon_reads_meter_count"/>

    <bpmn:serviceTask id="task_mpon_send_values_to_go" name="MPON sends values of final reading to GO">
      <bpmn:incoming>sequence_flow_10</bpmn:incoming>
      <bpmn:outgoing>sequence_flow_12</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="sequence_flow_10" sourceRef="task_mpon_mounts_new_device" targetRef="task_mpon_send_values_to_go"/>

    <bpmn:serviceTask id="task_mpon_tell_go_about_device_changes" name="MPON tells GO about device changes, master data and meter count at installation">
      <bpmn:incoming>sequence_flow_11</bpmn:incoming>
      <bpmn:outgoing>sequence_flow_13</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="sequence_flow_11" sourceRef="task_mpon_reads_meter_count" targetRef="task_mpon_tell_go_about_device_changes"/>

    <bpmn:serviceTask id="task_go_notify_msp" name="GO notifies MSP about device changes, master data, meter count at dismounting and installation">
      <bpmn:incoming>sequence_flow_12</bpmn:incoming>
      <bpmn:outgoing>sequence_flow_14</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="sequence_flow_12" sourceRef="task_mpon_send_values_to_go" targetRef="task_go_notify_msp"/>

    <bpmn:endEvent id="end_event">
      <bpmn:incoming>sequence_flow_14</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="sequence_flow_14" sourceRef="task_go_notify_msp" targetRef="end_event"/>
  </bpmn:process>
</bpmn:definitions>