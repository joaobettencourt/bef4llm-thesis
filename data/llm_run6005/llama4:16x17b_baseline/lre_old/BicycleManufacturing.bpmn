<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" 
             targetNamespace="http://example.com/bpmn">

   <process id="bicycleManufacturingProcess" isExecutable="true">
     <startEvent id="orderReceived">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="orderReceived" targetRef="acceptOrRejectOrder"/>

     <exclusiveGateway id="acceptOrRejectOrder">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
       <outgoing>sequenceFlow3</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow2" name="Accept Order" sourceRef="acceptOrRejectOrder" targetRef="informStorehouseAndEngineering">
       <conditionExpression xsi:type="tFormalExpression">${orderAccepted == true}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="sequenceFlow3" name="Reject Order" sourceRef="acceptOrRejectOrder" targetRef="endEvent1">
       <conditionExpression xsi:type="tFormalExpression">${orderAccepted == false}</conditionExpression>
     </sequenceFlow>

     <serviceTask id="informStorehouseAndEngineering">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow4</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlow4" sourceRef="informStorehouseAndEngineering" targetRef="parallelGateway1"/>

     <parallelGateway id="parallelGateway1">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow5</outgoing>
       <outgoing>sequenceFlow6</outgoing>
     </parallelGateway>

     <sequenceFlow id="sequenceFlow5" sourceRef="parallelGateway1" targetRef="processPartList"/>

     <subProcess id="partListSubProcess">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow7</outgoing>
       <startEvent id="partListStart">
         <outgoing>sequenceFlow8</outgoing>
       </startEvent>

       <sequenceFlow id="sequenceFlow8" sourceRef="partListStart" targetRef="exclusiveGateway3"/>

       <exclusiveGateway id="exclusiveGateway3">
         <incoming>sequenceFlow8</incoming>
         <outgoing>sequenceFlow9</outgoing>
         <outgoing>sequenceFlow10</outgoing>
       </exclusiveGateway>

       <sequenceFlow id="sequenceFlow9" sourceRef="exclusiveGateway3" targetRef="partListEnd">
         <conditionExpression xsi:type="tFormalExpression">${partReservedOrBackordered}</conditionExpression>
       </sequenceFlow>

       <sequenceFlow id="sequenceFlow10" sourceRef="exclusiveGateway3" targetRef="partListEnd"/>

       <endEvent id="partListEnd">
         <incoming>sequenceFlow9</incoming>
         <incoming>sequenceFlow10</incoming>
       </endEvent>
     </subProcess>

     <sequenceFlow id="sequenceFlow7" sourceRef="partListSubProcess" targetRef="exclusiveGateway2"/>

     <exclusiveGateway id="exclusiveGateway2">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow11</outgoing>
       <outgoing>sequenceFlow12</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow11" sourceRef="exclusiveGateway2" targetRef="parallelGateway2">
       <conditionExpression xsi:type="tFormalExpression">${allPartsReservedOrBackordered}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="sequenceFlow12" sourceRef="exclusiveGateway2" targetRef="endEvent1"/>

     <subProcess id="prepareForAssemblySubProcess">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow13</outgoing>
       <startEvent id="prepareForAssemblyStart">
         <outgoing>sequenceFlow14</outgoing>
       </startEvent>

       <sequenceFlow id="sequenceFlow14" sourceRef="prepareForAssemblyStart" targetRef="prepareForAssemblyEnd"/>

       <endEvent id="prepareForAssemblyEnd">
         <incoming>sequenceFlow14</incoming>
       </endEvent>
     </subProcess>

     <sequenceFlow id="sequenceFlow13" sourceRef="prepareForAssemblySubProcess" targetRef="parallelGateway2"/>

     <parallelGateway id="parallelGateway2">
       <incoming>sequenceFlow11</incoming>
       <incoming>sequenceFlow13</incoming>
       <outgoing>sequenceFlow15</outgoing>
     </parallelGateway>

     <sequenceFlow id="sequenceFlow15" sourceRef="parallelGateway2" targetRef="assembleBicycle"/>

     <serviceTask id="assembleBicycle">
       <incoming>sequenceFlow15</incoming>
       <outgoing>sequenceFlow16</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlow16" sourceRef="assembleBicycle" targetRef="shipBicycleToCustomer"/>

     <serviceTask id="shipBicycleToCustomer">
       <incoming>sequenceFlow16</incoming>
       <outgoing>sequenceFlow17</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlow17" sourceRef="shipBicycleToCustomer" targetRef="endEvent2"/>

     <endEvent id="endEvent1">
       <incoming>sequenceFlow3</incoming>
       <incoming>sequenceFlow12</incoming>
     </endEvent>

     <endEvent id="endEvent2">
       <incoming>sequenceFlow17</incoming>
     </endEvent>
   </process>
 </definitions>