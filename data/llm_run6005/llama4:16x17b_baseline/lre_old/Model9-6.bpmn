<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Design Process" targetNamespace="http://example.com/designProcess">

   <process id="designProcess" isExecutable="true">
     <startEvent id="startEvent">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent" targetRef="locateAndDistributeTask"/>

     <task id="locateAndDistributeTask" name="Locate and Distribute Existing Designs">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow2" sourceRef="locateAndDistributeTask" targetRef="parallelGateway"/>

     <parallelGateway id="parallelGateway">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
       <outgoing>sequenceFlow4</outgoing>
     </parallelGateway>

     <sequenceFlow id="sequenceFlow3" sourceRef="parallelGateway" targetRef="electricalReviewTask"/>
     <sequenceFlow id="sequenceFlow4" sourceRef="parallelGateway" targetRef="physicalReviewTask"/>

     <!-- Electrical Design Path  -->
     <task id="electricalReviewTask" name="Electrical Review and Update Plan">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow5</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow5" sourceRef="electricalReviewTask" targetRef="exclusiveGateway1"/>

     <exclusiveGateway id="exclusiveGateway1">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow6</outgoing>
       <outgoing>sequenceFlow7</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow6" sourceRef="exclusiveGateway1" targetRef="electricalTestTask">
       <conditionExpression xsi:type="tFormalExpression">${designPassed}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="sequenceFlow7" sourceRef="exclusiveGateway1" targetRef="physicalReviewTask">
       <conditionExpression xsi:type="tFormalExpression">${interruptPhysicalDesign}</conditionExpression>
     </sequenceFlow>

     <task id="electricalTestTask" name="Electrical Test">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow8</outgoing>
       <outgoing>sequenceFlow9</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow8" sourceRef="electricalTestTask" targetRef="endEvent1">
       <conditionExpression xsi:type="tFormalExpression">${designPassed}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="sequenceFlow9" sourceRef="electricalTestTask" targetRef="electricalReviewTask">
       <conditionExpression xsi:type="tFormalExpression">${designFailed}</conditionExpression>
     </sequenceFlow>

     <!-- Physical Design Path  -->
     <task id="physicalReviewTask" name="Physical Review and Update Plan">
       <incoming>sequenceFlow4</incoming>
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow10</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow10" sourceRef="physicalReviewTask" targetRef="exclusiveGateway2"/>

     <exclusiveGateway id="exclusiveGateway2">
       <incoming>sequenceFlow10</incoming>
       <outgoing>sequenceFlow11</outgoing>
       <outgoing>sequenceFlow12</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow11" sourceRef="exclusiveGateway2" targetRef="physicalTestTask">
       <conditionExpression xsi:type="tFormalExpression">${designPassed}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="sequenceFlow12" sourceRef="exclusiveGateway2" targetRef="electricalReviewTask">
       <conditionExpression xsi:type="tFormalExpression">${interruptElectricalDesign}</conditionExpression>
     </sequenceFlow>    

     <task id="physicalTestTask" name="Physical Test">
       <incoming>sequenceFlow11</incoming>
       <outgoing>sequenceFlow13</outgoing>
       <outgoing>sequenceFlow14</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow13" sourceRef="physicalTestTask" targetRef="endEvent1">
       <conditionExpression xsi:type="tFormalExpression">${designPassed}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="sequenceFlow14" sourceRef="physicalTestTask" targetRef="physicalReviewTask">
       <conditionExpression xsi:type="tFormalExpression">${designFailed}</conditionExpression>
     </sequenceFlow>    

     <!-- Notify and Combine  -->
     <task id="combineDesigns" name="Combine Designs">
       <incoming>sequenceFlow8</incoming>
       <incoming>sequenceFlow13</incoming>
       <outgoing>sequenceFlow15</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow15" sourceRef="combineDesigns" targetRef="exclusiveGateway3"/>

     <exclusiveGateway id="exclusiveGateway3">
       <incoming>sequenceFlow15</incoming>
       <outgoing>sequenceFlow16</outgoing>
       <outgoing>sequenceFlow17</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow16" sourceRef="exclusiveGateway3" targetRef="endEvent2">
       <conditionExpression xsi:type="tFormalExpression">${designPassed}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="sequenceFlow17" sourceRef="exclusiveGateway3" targetRef="parallelGateway">
       <conditionExpression xsi:type="tFormalExpression">${designFailed}</conditionExpression>
     </sequenceFlow>    

     <endEvent id="endEvent1" name="Electrical Design Complete">
       <incoming>sequenceFlow8</incoming>
       <incoming>sequenceFlow9</incoming>
     </endEvent>

     <endEvent id="endEvent2" name="Design Process Complete">
       <incoming>sequenceFlow16</incoming>
     </endEvent>

   </process>

</definitions>