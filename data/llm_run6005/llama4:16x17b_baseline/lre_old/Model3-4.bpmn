<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definitions" name="Claim Handling Process">

   <process id="claimHandlingProcess" isExecutable="true">
     <startEvent id="startEvent1">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="taskSendQuestionnaire"/>

     <serviceTask id="taskSendQuestionnaire" name="Send Questionnaire to Claimant">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlow2" sourceRef="taskSendQuestionnaire" targetRef="exclusiveGateway1"/>

     <exclusiveGateway id="exclusiveGateway1">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
       <outgoing>sequenceFlow4</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow3" name="responseReceived" sourceRef="exclusiveGateway1" targetRef="endEvent1">
     </sequenceFlow>

     <sequenceFlow id="sequenceFlow4" name="noResponse" sourceRef="exclusiveGateway1" targetRef="taskSendReminder">
     </sequenceFlow>

     <serviceTask id="taskSendReminder" name="Send Reminder to Claimant">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow5</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlow5" sourceRef="taskSendReminder" targetRef="exclusiveGateway2"/>

     <exclusiveGateway id="exclusiveGateway2">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow6</outgoing>
       <outgoing>sequenceFlow7</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow6" sourceRef="exclusiveGateway2" targetRef="taskSendQuestionnaire">
     </sequenceFlow>

     <sequenceFlow id="sequenceFlow7" sourceRef="exclusiveGateway2" targetRef="endEvent1">
     </sequenceFlow>

     <endEvent id="endEvent1" name="Claimant has responded or process abandoned">
       <incoming>sequenceFlow3</incoming>
       <incoming>sequenceFlow7</incoming>
     </endEvent>
   </process>
 </definitions>