<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" 
             targetNamespace="http://example.com/bpmn">

    <process id="telecomServiceDegradationProcess" isExecutable="true">
        <!-- Start Event -->
        <startEvent id="serviceDegradationDetected">
            <outgoing>sequenceFlow1</outgoing>
        </startEvent>

        <!-- Sequence Flow to Customer Service -->
        <sequenceFlow id="sequenceFlow1" sourceRef="serviceDegradationDetected" targetRef="enterProblemReport"/>

        <!-- Task: Enter Problem Report -->
        <task id="enterProblemReport">
            <incoming>sequenceFlow1</incoming>
            <outgoing>sequenceFlow2</outgoing>
        </task>

        <!-- Sequence Flow to Compare with SLA -->
        <sequenceFlow id="sequenceFlow2" sourceRef="enterProblemReport" targetRef="determineCounterMeasures"/>

        <!-- Task: Determine Counter Measures -->
        <task id="determineCounterMeasures">
            <incoming>sequenceFlow2</incoming>
            <outgoing>sequenceFlow3</outgoing>
        </task>

        <!-- Sequence Flow to Determine Customer Significance -->
        <sequenceFlow id="sequenceFlow3" sourceRef="determineCounterMeasures" targetRef="isPremiumCustomer"/>

        <!-- Gateway: Is Premium Customer? -->
        <exclusiveGateway id="isPremiumCustomer">
            <incoming>sequenceFlow3</incoming>
            <outgoing>yesPremiumCustomer</outgoing>
            <outgoing>noNotPremiumCustomer</outgoing>
        </exclusiveGateway>

        <!-- Sequence Flow for Premium Customer -->
        <sequenceFlow id="yesPremiumCustomer" sourceRef="isPremiumCustomer" targetRef="extraProblemFixProcess">
            <conditionExpression xsi:type="tFormalExpression">${customerSignificance  ==  'premium'}</conditionExpression>
        </sequenceFlow>

        <!-- Subprocess: Extra Problem Fix Process (not detailed here) -->
        <subProcess id="extraProblemFixProcess">
            <incoming>yesPremiumCustomer</incoming>
            <!-- Implementation details not provided -->
        </subProcess>

        <!-- Sequence Flow for Non-Premium Customer -->
        <sequenceFlow id="noNotPremiumCustomer" sourceRef="isPremiumCustomer" targetRef="rePrioritizeMeasures"/>

        <!-- Task: Re-prioritize Measures (if necessary) -->
        <task id="rePrioritizeMeasures">
            <incoming>noNotPremiumCustomer</incoming>
            <outgoing>sequenceFlow4</outgoing>
        </task>

        <!-- Sequence Flow to Create Detailed Problem Report -->
        <sequenceFlow id="sequenceFlow4" sourceRef="rePrioritizeMeasures" targetRef="createDetailedProblemReport"/>

        <!-- Task: Send to Service Management -->
        <task id="createDetailedProblemReport">
            <incoming>sequenceFlow4</incoming>
            <outgoing>sequenceFlow5</outgoing>
        </task>

        <!-- Sequence Flow to Investigate Problem -->
        <sequenceFlow id="sequenceFlow5" sourceRef="createDetailedProblemReport" targetRef="investigateProblem"/>

        <!-- Task: Investigate Problem -->
        <task id="investigateProblem">
            <incoming>sequenceFlow5</incoming>
            <outgoing>sequenceFlow6</outgoing>
        </task>

        <!-- Gateway: Can Analyze? -->
        <exclusiveGateway id="canAnalyze">
            <incoming>sequenceFlow6</incoming>
            <outgoing>yesCanAnalyze</outgoing>
            <outgoing>noCannotAnalyze</outgoing>
        </exclusiveGateway>

        <!-- Sequence Flow for Analysis by Service Management -->
        <sequenceFlow id="yesCanAnalyze" sourceRef="canAnalyze" targetRef="performAnalysis">
        </sequenceFlow>

        <!-- Task: Perform Analysis and Create Trouble Report -->
        <task id="performAnalysis">
            <incoming>yesCanAnalyze</incoming>
            <outgoing>sequenceFlow7</outgoing>
        </task>

        <!-- Sequence Flow to Resource Provisioning -->
        <sequenceFlow id="sequenceFlow7" sourceRef="performAnalysis" targetRef="checkForProblems"/>

    </process>
</definitions>