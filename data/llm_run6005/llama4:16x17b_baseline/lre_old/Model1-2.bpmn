<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definition" name="Repair Process" targetNamespace="http://example.com/repairProcess">

   <process id="repairProcess" isExecutable="true">
     <startEvent id="startEvent">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent" targetRef="checkDefect"/>

     <userTask id="checkDefect" name="Check Defect and Calculate Repair Costs">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
       <outgoing>sequenceFlow3</outgoing>
     </userTask>

     <exclusiveGateway id="exclusiveCosts">
       <incoming>sequenceFlow2</incoming>
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow4</outgoing>
       <outgoing>sequenceFlow5</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow2" sourceRef="checkDefect" targetRef="exclusiveCosts"/>
     <sequenceFlow id="sequenceFlow3" sourceRef="checkDefect" targetRef="exclusiveCosts"/>

     <sequenceFlow id="sequenceFlow4" sourceRef="exclusiveCosts" targetRef="parallelGatewayStart"/>
     <sequenceFlow id="sequenceFlow5" sourceRef="exclusiveCosts" targetRef="endCancel"/>

     <endEvent id="endCancel">
       <incoming>sequenceFlow5</incoming>
     </endEvent>

     <parallelGateway id="parallelGatewayStart">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow6</outgoing>
       <outgoing>sequenceFlow7</outgoing>
     </parallelGateway>

     <sequenceFlow id="sequenceFlow6" sourceRef="parallelGatewayStart" targetRef="checkHardware"/>
     <sequenceFlow id="sequenceFlow7" sourceRef="parallelGatewayStart" targetRef="checkSoftware"/>

     <userTask id="checkHardware" name="Check and Repair Hardware">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow8</outgoing>
     </userTask>

     <userTask id="checkSoftware" name="Check and Configure Software">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow9</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow8" sourceRef="checkHardware" targetRef="exclusiveTestResultHW"/>
     <sequenceFlow id="sequenceFlow9" sourceRef="checkSoftware" targetRef="exclusiveTestResultSW"/>

     <exclusiveGateway id="exclusiveTestResultHW">
       <incoming>sequenceFlow8</incoming>
       <outgoing>sequenceFlow10</outgoing>
       <outgoing>sequenceFlow11</outgoing>
     </exclusiveGateway>

     <exclusiveGateway id="exclusiveTestResultSW">
       <incoming>sequenceFlow9</incoming>
       <outgoing>sequenceFlow12</outgoing>
       <outgoing>sequenceFlow13</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow10" sourceRef="exclusiveTestResultHW" targetRef="checkHardware"/>
     <sequenceFlow id="sequenceFlow11" sourceRef="exclusiveTestResultHW" targetRef="parallelGatewayEnd"/>

     <sequenceFlow id="sequenceFlow12" sourceRef="exclusiveTestResultSW" targetRef="checkSoftware"/>
     <sequenceFlow id="sequenceFlow13" sourceRef="exclusiveTestResultSW" targetRef="parallelGatewayEnd"/>

     <parallelGateway id="parallelGatewayEnd">
       <incoming>sequenceFlow11</incoming>
       <incoming>sequenceFlow13</incoming>
       <outgoing>sequenceFlow14</outgoing>
     </parallelGateway>

     <sequenceFlow id="sequenceFlow14" sourceRef="parallelGatewayEnd" targetRef="end"/>

     <endEvent id="end">
       <incoming>sequenceFlow14</incoming>
     </endEvent>

   </process>

</definitions>