<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definitions" name="Loan Approval Process">

  <process id="loanApprovalProcess" isExecutable="true">
    <startEvent id="startEvent1">
      <outgoing>sequenceFlow1</outgoing>
    </startEvent>

    <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="riskAssessmentServiceTask"/>

    <serviceTask id="riskAssessmentServiceTask">
      <incoming>sequenceFlow1</incoming>
      <outgoing>sequenceFlow2</outgoing>
      <outgoing>sequenceFlow3</outgoing>
    </serviceTask>

    <exclusiveGateway id="exclusiveGateway1">
      <incoming>sequenceFlow2</incoming>
      <outgoing>sequenceFlow4</outgoing>
      <outgoing>sequenceFlow5</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequenceFlow2" sourceRef="riskAssessmentServiceTask" targetRef="exclusiveGateway1"/>

    <sequenceFlow id="sequenceFlow4" name="Low Risk & Small Loan" sourceRef="exclusiveGateway1" targetRef="loanApprovedEvent">
      <conditionExpression xsi:type="tFormalExpression">${lowRisk and loanAmount  < 10000}</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="sequenceFlow5" name="High Risk or Large Loan" sourceRef="exclusiveGateway1" targetRef="approverServiceTask">
      <conditionExpression xsi:type="tFormalExpression">${highRisk or loanAmount >= 10000}</conditionExpression>
    </sequenceFlow>

    <serviceTask id="approverServiceTask">
      <incoming>sequenceFlow5</incoming>
      <outgoing>sequenceFlow6</outgoing>
    </serviceTask>

    <sequenceFlow id="sequenceFlow6" sourceRef="approverServiceTask" targetRef="loanFeedbackEvent"/>

    <endEvent id="loanApprovedEvent">
      <incoming>sequenceFlow4</incoming>
    </endEvent>

    <endEvent id="loanDeniedEvent">
      <incoming>sequenceFlow3</incoming>
    </endEvent>

    <sequenceFlow id="sequenceFlow3" sourceRef="riskAssessmentServiceTask" targetRef="loanDeniedEvent"/>

    <endEvent id="loanFeedbackEvent">
      <incoming>sequenceFlow6</incoming>
    </endEvent>

  </process>
</definitions>