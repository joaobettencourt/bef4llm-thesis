<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
                  id="definitions" name="MSPO Deregistration Process">

  <bpmn:process id="mspoDeregistrationProcess" isExecutable="true">
    <bpmn:startEvent id="startEvent1">
      <bpmn:outgoing>sequenceFlow1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="mspoDeregistersAtGoTask" name="MSPO deregisters at the GO">
      <bpmn:incoming>sequenceFlow1</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow2</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="goVerifiesDeregistrationTask" name="GO verifies the deregistration">
      <bpmn:incoming>sequenceFlow2</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow3</bpmn:outgoing>
      <bpmn:outgoing>sequenceFlow4</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="exclusiveGateway1">
      <bpmn:incoming>sequenceFlow3</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow5</bpmn:outgoing>
      <bpmn:outgoing>sequenceFlow6</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="goRejectsDeregistrationEnd" name="GO rejects the deregistration of the MSPO">
      <bpmn:incoming>sequenceFlow5</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:userTask id="goPreliminarilyConfirmsDeregistrationTask" name="GO preliminarily confirms the deregistration of the MSPO">
      <bpmn:incoming>sequenceFlow6</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow7</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="goAssignsHimselfAsMspTask" name="GO assigns himself as MSP">
      <bpmn:incoming>sequenceFlow7</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow8</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="goInformsMspoAboutEndOfAssignmentAndBeginningOfAssignmentTask" name="GO informs the MSPO about the end of the assignment and the beginning of the assignment of the GO">
      <bpmn:incoming>sequenceFlow8</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow9</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="goInformsMpoAboutAssignmentTask" name="GO informs the MPO about the assignment of the GO">
      <bpmn:incoming>sequenceFlow9</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow10</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="goInformsSpAboutAssignmentTask" name="GO informs the SP about the assignment of the GO">
      <bpmn:incoming>sequenceFlow10</bpmn:incoming>
    </bpmn:userTask>

    <bpmn:sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="mspoDeregistersAtGoTask"/>
    <bpmn:sequenceFlow id="sequenceFlow2" sourceRef="mspoDeregistersAtGoTask" targetRef="goVerifiesDeregistrationTask"/>
    <bpmn:sequenceFlow id="sequenceFlow3" sourceRef="goVerifiesDeregistrationTask" targetRef="exclusiveGateway1"/>
    <bpmn:sequenceFlow id="sequenceFlow4" name="yes" sourceRef="goVerifiesDeregistrationTask" targetRef="exclusiveGateway1"/>
    <bpmn:sequenceFlow id="sequenceFlow5" sourceRef="exclusiveGateway1" targetRef="goRejectsDeregistrationEnd"/>
    <bpmn:sequenceFlow id="sequenceFlow6" name="no" sourceRef="exclusiveGateway1" targetRef="goPreliminarilyConfirmsDeregistrationTask"/>
    <bpmn:sequenceFlow id="sequenceFlow7" sourceRef="goPreliminarilyConfirmsDeregistrationTask" targetRef="goAssignsHimselfAsMspTask"/>
    <bpmn:sequenceFlow id="sequenceFlow8" sourceRef="goAssignsHimselfAsMspTask" targetRef="goInformsMspoAboutEndOfAssignmentAndBeginningOfAssignmentTask"/>
    <bpmn:sequenceFlow id="sequenceFlow9" sourceRef="goInformsMspoAboutEndOfAssignmentAndBeginningOfAssignmentTask" targetRef="goInformsMpoAboutAssignmentTask"/>
    <bpmn:sequenceFlow id="sequenceFlow10" sourceRef="goInformsMpoAboutAssignmentTask" targetRef="goInformsSpAboutAssignmentTask"/>

  </bpmn:process>
</bpmn:definitions>