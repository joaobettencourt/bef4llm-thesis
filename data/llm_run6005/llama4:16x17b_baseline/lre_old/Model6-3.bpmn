<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" 
             targetNamespace="http://example.com/bpmn">

   <process id="newOrderProcess" isExecutable="true">
     <startEvent id="startEvent1">
       <outgoing>sf1</outgoing>
     </startEvent>

     <sequenceFlow id="sf1" sourceRef="startEvent1" targetRef="determinePartsAndQuantities"/>

     <userTask id="determinePartsAndQuantities" name="Determine necessary parts and quantities as well as delivery date">
       <incoming>sf1</incoming>
       <outgoing>sf2</outgoing>
     </userTask>

     <sequenceFlow id="sf2" sourceRef="determinePartsAndQuantities" targetRef="enterDataIntoPPS"/>

     <userTask id="enterDataIntoPPS" name="Enter data into PPS and transfer to ERP">
       <incoming>sf2</incoming>
       <outgoing>sf3</outgoing>
     </userTask>

     <sequenceFlow id="sf3" sourceRef="enterDataIntoPPS" targetRef="exclusiveGateway1"/>

     <exclusiveGateway id="exclusiveGateway1">
       <incoming>sf3</incoming>
       <outgoing>sf4</outgoing>
       <outgoing>sf5</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sf4" name="Parts missing" sourceRef="exclusiveGateway1" targetRef="procureParts">
     </sequenceFlow>

     <sequenceFlow id="sf5" name="No parts missing" sourceRef="exclusiveGateway1" targetRef="scheduleProduction">
     </sequenceFlow>

     <userTask id="procureParts" name="Procure missing parts">
       <incoming>sf4</incoming>
       <outgoing>sf6</outgoing>
     </userTask>

     <sequenceFlow id="sf6" sourceRef="procureParts" targetRef="scheduleProduction"/>

     <serviceTask id="scheduleProduction" name="Schedule production and receive system notice">
       <incoming>sf5</incoming>
       <incoming>sf6</incoming>
       <outgoing>sf7</outgoing>
     </serviceTask>

     <sequenceFlow id="sf7" sourceRef="scheduleProduction" targetRef="implementOrder"/>

     <userTask id="implementOrder" name="Implement order">
       <incoming>sf7</incoming>
       <outgoing>sf8</outgoing>
     </userTask>

     <sequenceFlow id="sf8" sourceRef="implementOrder" targetRef="checkOrderQuality"/>

     <userTask id="checkOrderQuality" name="Check order quality">
       <incoming>sf8</incoming>
       <outgoing>sf9</outgoing>
     </userTask>

     <sequenceFlow id="sf9" sourceRef="checkOrderQuality" targetRef="endEvent1"/>

     <endEvent id="endEvent1" name="Order completed">
       <incoming>sf9</incoming>
     </endEvent>
   </process>
 </definitions>