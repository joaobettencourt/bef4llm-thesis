<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" 
             targetNamespace="http://example.com/bpmn">

   <process id="personnelRequirementsProcess" isExecutable="true">
     <startEvent id="startEvent1">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="reportVacancy"/>

     <task id="reportVacancy" name="Report Vacancy to Personnel Department">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow2" sourceRef="reportVacancy" targetRef="waitForJobDescription"/>

     <task id="waitForJobDescription" name="Wait for Job Description">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
       <outgoing>sequenceFlow7</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow3" sourceRef="waitForJobDescription" targetRef="reviewJobDescription"/>

     <userTask id="reviewJobDescription" name="Review Job Description">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow4</outgoing>
       <outgoing>sequenceFlow5</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow4" sourceRef="reviewJobDescription" targetRef="approveJobDescription"/>

     <task id="approveJobDescription" name="Approve Job Description">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow6</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow6" sourceRef="approveJobDescription" targetRef="advertizeJob"/>

     <task id="advertizeJob" name="Advertize Job">
       <incoming>sequenceFlow6</incoming>
     </task>

     <sequenceFlow id="sequenceFlow5" sourceRef="reviewJobDescription" targetRef="requestCorrections"/>

     <userTask id="requestCorrections" name="Request Corrections">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow8</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow8" sourceRef="requestCorrections" targetRef="waitForJobDescription"/>

     <sequenceFlow id="sequenceFlow7" sourceRef="waitForJobDescription" targetRef="provideClarifications"/>

     <userTask id="provideClarifications" name="Provide Clarifications">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow9</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow9" sourceRef="provideClarifications" targetRef="reviewJobDescription"/>

     <endEvent id="endEvent1">
       <incoming>sequenceFlow6</incoming>
     </endEvent>
   </process>
</definitions>