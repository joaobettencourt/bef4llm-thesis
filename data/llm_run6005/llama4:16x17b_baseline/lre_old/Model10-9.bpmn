<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
                  id="definitions" name="MPO Change Request Process">

  <bpmn:process id="mpoChangeRequestProcess" isExecutable="true">
    <bpmn:startEvent id="startEvent1">
      <bpmn:outgoing>sequenceFlow1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="taskReviewChangeRequest" name="Review Change Request">
      <bpmn:incoming>sequenceFlow1</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow2</bpmn:outgoing>
      <bpmn:outgoing>sequenceFlow3</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="taskReviewChangeRequest"/>

    <bpmn:exclusiveGateway id="exclusiveGateway1">
      <bpmn:incoming>sequenceFlow2</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow4</bpmn:outgoing>
      <bpmn:outgoing>sequenceFlow5</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="sequenceFlow2" sourceRef="taskReviewChangeRequest" targetRef="exclusiveGateway1"/>

    <bpmn:endEvent id="endEventReject">
      <bpmn:incoming>sequenceFlow3</bpmn:incoming>
      <bpmn:incoming>sequenceFlow5</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="sequenceFlow3" name="Reject" sourceRef="taskReviewChangeRequest" targetRef="endEventReject">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${confirm} == false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:userTask id="taskPerformMeasuringPointChange" name="Perform Measuring Point Change">
      <bpmn:incoming>sequenceFlow4</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow6</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:sequenceFlow id="sequenceFlow4" name="Confirm" sourceRef="exclusiveGateway1" targetRef="taskPerformMeasuringPointChange">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${confirm} == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:serviceTask id="taskReportImplementation" name="Report Implementation or Notify Failure">
      <bpmn:incoming>sequenceFlow6</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow7</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="endEventComplete">
      <bpmn:incoming>sequenceFlow7</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="sequenceFlow6" sourceRef="taskPerformMeasuringPointChange" targetRef="taskReportImplementation"/>

    <bpmn:sequenceFlow id="sequenceFlow5" name="Reject Change Request" sourceRef="exclusiveGateway1" targetRef="endEventReject">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${confirm} == false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="sequenceFlow7" sourceRef="taskReportImplementation" targetRef="endEventComplete"/>
  </bpmn:process>
</bpmn:definitions>