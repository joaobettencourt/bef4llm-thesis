<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" name="Fault Handling Process" targetNamespace="http://example.com/bpmn">

   <process id="faultHandlingProcess" isExecutable="true">
     <startEvent id="startEvent1">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="task1"/>

     <userTask id="task1" name="Examine the failure">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
       <outgoing>sequenceFlow3</outgoing>
     </userTask>

     <exclusiveGateway id="exclusiveGateway1">
       <incoming>sequenceFlow2</incoming>
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow4</outgoing>
       <outgoing>sequenceFlow5</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow2" sourceRef="task1" targetRef="exclusiveGateway1"/>
     <sequenceFlow id="sequenceFlow3" name="rejects" sourceRef="task1" targetRef="exclusiveGateway1"/>

     <userTask id="task2" name="Inform customer and manager">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow6</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow4" sourceRef="exclusiveGateway1" targetRef="task2"/>

     <userTask id="task3" name="Fix the fault at measuring device">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow7</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow5" sourceRef="exclusiveGateway1" targetRef="task3"/>

     <userTask id="task4" name="Share results with fault detector">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow8</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow7" sourceRef="task3" targetRef="task4"/>

     <userTask id="task5" name="Inform customer about resolution">
       <incoming>sequenceFlow8</incoming>
       <outgoing>sequenceFlow9</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow8" sourceRef="task4" targetRef="task5"/>

     <userTask id="task6" name="Inform manager about resolution">
       <incoming>sequenceFlow9</incoming>
       <outgoing>sequenceFlow10</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow9" sourceRef="task5" targetRef="task6"/>

     <endEvent id="endEvent1">
       <incoming>sequenceFlow10</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow10" sourceRef="task6" targetRef="endEvent1"/>
   </process>
</definitions>