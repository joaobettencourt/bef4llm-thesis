<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Measurements Process" targetNamespace="http://example.com">

   <process id="measurementsProcess" isExecutable="true">
     <startEvent id="startEvent1">
       <outgoing>requestMeasurements</outgoing>
     </startEvent>

     <sequenceFlow id="requestMeasurements" sourceRef="startEvent1" targetRef="taskRequestMeasurements"/>

     <serviceTask id="taskRequestMeasurements" name="GO requests measurements of MSP">
       <incoming>requestMeasurements</incoming>
       <outgoing>checkRequest</outgoing>
     </serviceTask>

     <sequenceFlow id="checkRequest" sourceRef="taskRequestMeasurements" targetRef="exclusiveGateway"/>

     <exclusiveGateway id="exclusiveGateway1">
       <incoming>checkRequest</incoming>
       <outgoing>denyRequest</outgoing>
       <outgoing>performMeasurement</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="denyRequest" name="Deny request" sourceRef="exclusiveGateway1" targetRef="taskDenyRequest">
       <conditionExpression xsi:type="tFormalExpression">${request.denied = true}</conditionExpression>
     </sequenceFlow>

     <serviceTask id="taskDenyRequest" name="MSP denies the request of GO">
       <incoming>denyRequest</incoming>
       <outgoing>informGO</outgoing>
     </serviceTask>

     <sequenceFlow id="informGO" sourceRef="taskDenyRequest" targetRef="endEventFailure"/>

     <sequenceFlow id="performMeasurement" name="Perform measurement" sourceRef="exclusiveGateway1" targetRef="taskPerformMeasurement">
       <conditionExpression xsi:type="tFormalExpression">${request.approved = true}</conditionExpression>
     </sequenceFlow>

     <serviceTask id="taskPerformMeasurement" name="MSP performs the measurements">
       <incoming>performMeasurement</incoming>
       <outgoing>transmitMeasurements</outgoing>
     </serviceTask>

     <sequenceFlow id="transmitMeasurements" sourceRef="taskPerformMeasurement" targetRef="exclusiveGateway2"/>

     <exclusiveGateway id="exclusiveGateway2">
       <incoming>transmitMeasurements</incoming>
       <outgoing>failureReading</outgoing>
       <outgoing>successReading</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="failureReading" name="Failure reading" sourceRef="exclusiveGateway2" targetRef="taskFailureReading">
       <conditionExpression xsi:type="tFormalExpression">${reading.failed = true}</conditionExpression>
     </sequenceFlow>

     <serviceTask id="taskFailureReading" name="MSP informs GO about failure of the reading">
       <incoming>failureReading</incoming>
       <outgoing>informGO2</outgoing>
     </serviceTask>

     <sequenceFlow id="informGO2" sourceRef="taskFailureReading" targetRef="endEventFailure"/>

     <sequenceFlow id="successReading" name="Success reading" sourceRef="exclusiveGateway2" targetRef="taskTransmitMeasurements">
       <conditionExpression xsi:type="tFormalExpression">${reading.successful = true}</conditionExpression>
     </sequenceFlow>

     <serviceTask id="taskTransmitMeasurements" name="MSP transmits measured values to GO">
       <incoming>successReading</incoming>
       <outgoing>processValues</outgoing>
     </serviceTask>

     <sequenceFlow id="processValues" sourceRef="taskTransmitMeasurements" targetRef="taskProcessValues"/>

     <userTask id="taskProcessValues" name="GO processes measured values">
       <incoming>processValues</incoming>
       <outgoing>sendChangedValues</outgoing>
     </userTask>

     <sequenceFlow id="sendChangedValues" sourceRef="taskProcessValues" targetRef="taskSendChangedValues"/>

     <serviceTask id="taskSendChangedValues" name="GO sends changed values to MSP">
       <incoming>sendChangedValues</incoming>
       <outgoing>transmitReadings</outgoing>
     </serviceTask>

     <sequenceFlow id="transmitReadings" sourceRef="taskSendChangedValues" targetRef="taskTransmitReadings"/>

     <userTask id="taskTransmitReadings" name="GO transmits readings to SP">
       <incoming>transmitReadings</incoming>
       <outgoing>endEventSuccessFlow</outgoing>
     </userTask>

     <sequenceFlow id="endEventSuccessFlow" sourceRef="taskTransmitReadings" targetRef="endEventSuccess"/>

     <endEvent id="endEventFailure">
       <incoming>informGO</incoming>
       <incoming>informGO2</incoming>
     </endEvent>

     <endEvent id="endEventSuccess">
       <incoming>endEventSuccessFlow</incoming>
     </endEvent>

   </process>
</definitions>