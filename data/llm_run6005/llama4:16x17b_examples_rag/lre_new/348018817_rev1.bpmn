<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definition" name="Expense Report Process">

   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_0"/>

     <task id="Task_0" name="Check if employee has an account">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
       <outgoing>SequenceFlow_3</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_0" targetRef="ExclusiveGateway_1">
       <conditionExpression xsi:type="tFormalExpression">${employee.hasAccount()}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="SequenceFlow_3" sourceRef="Task_0" targetRef="Task_7">
       <conditionExpression xsi:type="tFormalExpression">${!employee.hasAccount()}</conditionExpression>
     </sequenceFlow>

     <task id="Task_7" name="Create account for employee">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_8</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_8" sourceRef="Task_7" targetRef="ExclusiveGateway_1"/>

     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_2</incoming>
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_4</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_1" targetRef="Task_1"/>

     <task id="Task_1" name="Review expense report">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_1" targetRef="ExclusiveGateway_2"/>

     <exclusiveGateway id="ExclusiveGateway_2">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_6</outgoing>
       <outgoing>SequenceFlow_9</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_6" sourceRef="ExclusiveGateway_2" targetRef="Task_2">
       <conditionExpression xsi:type="tFormalExpression">${expenseReport.amount  <= 200}</conditionExpression>
     </sequenceFlow>

     <task id="Task_2" name="Reimburse employee directly">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_11</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_11" sourceRef="Task_2" targetRef="EndEvent_1"/>

     <sequenceFlow id="SequenceFlow_9" sourceRef="ExclusiveGateway_2" targetRef="Task_3">
       <conditionExpression xsi:type="tFormalExpression">${expenseReport.amount  > 200}</conditionExpression>
     </sequenceFlow>

     <task id="Task_3" name="Request supervisor approval">
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_10</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_10" sourceRef="Task_3" targetRef="ExclusiveGateway_3"/>

     <exclusiveGateway id="ExclusiveGateway_3">
       <incoming>SequenceFlow_10</incoming>
       <outgoing>SequenceFlow_12</outgoing>
       <outgoing>SequenceFlow_13</outgoing>
       <outgoing>SequenceFlow_14</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_12" sourceRef="ExclusiveGateway_3" targetRef="Task_4">
       <conditionExpression xsi:type="tFormalExpression">${approval.approved()}</conditionExpression>
     </sequenceFlow>

     <task id="Task_4" name="Notify employee of approval">
       <incoming>SequenceFlow_12</incoming>
       <outgoing>SequenceFlow_15</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_15" sourceRef="Task_4" targetRef="EndEvent_1"/>

     <sequenceFlow id="SequenceFlow_13" sourceRef="ExclusiveGateway_3" targetRef="Task_5">
       <conditionExpression xsi:type="tFormalExpression">${approval.rejected()}</conditionExpression>
     </sequenceFlow>

     <task id="Task_5" name="Notify employee of rejection">
       <incoming>SequenceFlow_13</incoming>
       <outgoing>SequenceFlow_16</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_16" sourceRef="Task_5" targetRef="EndEvent_1"/>

     <sequenceFlow id="SequenceFlow_14" sourceRef="ExclusiveGateway_3" targetRef="IntermediateTimerEvent_0">
       <conditionExpression xsi:type="tFormalExpression">${approval.inProgress()}</conditionExpression>
     </sequenceFlow>

     <intermediateCatchEvent id="IntermediateTimerEvent_0">
       <incoming>SequenceFlow_14</incoming>
       <outgoing>SequenceFlow_17</outgoing>
     </intermediateCatchEvent>

     <sequenceFlow id="SequenceFlow_17" sourceRef="IntermediateTimerEvent_0" targetRef="Task_3"/>

     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_11</incoming>
       <incoming>SequenceFlow_15</incoming>
       <incoming>SequenceFlow_16</incoming>
     </endEvent>

   </process>
</definitions>