<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definition" name="Business Process Model" targetNamespace="http://bpmn.io/schema/bpmn">

   <process id="Process_1" isExecutable="true">
     <laneSet>
       <lane id="Lane_MailCentreOffice" name="Mail Centre office">
         <extensionElements/>
       </lane>
       <lane id="Lane_AdministrationDepartment" name="Administration Department">
         <extensionElements/>
       </lane>
       <lane id="Lane_DataEntryOffice" name="Data Entry office">
         <extensionElements/>
       </lane>
       <lane id="Lane_ValidationOffice" name="Validation office">
         <extensionElements/>
       </lane>
       <lane id="Lane_PaymentOffice" name="Payment office">
         <extensionElements/>
       </lane>
       <lane id="Lane_RegistryOffice" name="Registry office">
         <extensionElements/>
       </lane>
     </laneSet>

     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>

     <task id="Task_1" name="Categorize invoice by staff member">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="Task_2"/>

     <task id="Task_2" name="Forward invoice to Administration Department">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_3" sourceRef="Task_2" targetRef="Task_3"/>

     <task id="Task_3" name="Process invoice">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_4</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_4" sourceRef="Task_3" targetRef="IntermediateEvent_1"/>

     <intermediateEvent id="IntermediateEvent_1">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_5</outgoing>
       <timerEventDefinition>
         <timeCycle>P1D PT10H</timeCycle>
       </timerEventDefinition>
     </intermediateEvent>

     <sequenceFlow id="SequenceFlow_5" sourceRef="IntermediateEvent_1" targetRef="Task_4"/>

     <task id="Task_4" name="Enter data into SAP system">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_4" targetRef="IntermediateEvent_2"/>

     <intermediateEvent id="IntermediateEvent_2">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_7</outgoing>
       <timerEventDefinition>
         <timeCycle>P1H</timeCycle>
       </timerEventDefinition>
     </intermediateEvent>

     <sequenceFlow id="SequenceFlow_7" sourceRef="IntermediateEvent_2" targetRef="Task_5"/>

     <task id="Task_5" name="Validate invoices">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_8</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_8" sourceRef="Task_5" targetRef="IntermediateEvent_3"/>

     <intermediateEvent id="IntermediateEvent_3">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_9</outgoing>
       <timerEventDefinition>
         <timeCycle>P1W PT0H</timeCycle>
       </timerEventDefinition>
     </intermediateEvent>

     <sequenceFlow id="SequenceFlow_9" sourceRef="IntermediateEvent_3" targetRef="Task_6"/>

     <task id="Task_6" name="Execute payment of validated invoices">
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_10</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_10" sourceRef="Task_6" targetRef="Task_7"/>

     <task id="Task_7" name="Archive invoices">
       <incoming>SequenceFlow_10</incoming>
     </task>

   </process>
</definitions>