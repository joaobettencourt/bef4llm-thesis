<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd" 
             id="definition" name="Business Process Model">

   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_ReviewOrder"/>

     <userTask id="Task_ReviewOrder" name="Review Order">
       <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
     </userTask>

     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_ReviewOrder" targetRef="ExclusiveGateway_CheckAvailability"/>

     <exclusiveGateway id="ExclusiveGateway_CheckAvailability">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_DiscontinuedItem</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_3" name="" sourceRef="ExclusiveGateway_CheckAvailability" targetRef="Task_PreparePackage">
       <conditionExpression xsi:type="tFormalExpression">${allItemsAvailable == true}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="SequenceFlow_DiscontinuedItem" name="" sourceRef="ExclusiveGateway_CheckAvailability" targetRef="Task_InformCustomerDiscontinued">
       <conditionExpression xsi:type="tFormalExpression">${discontinuedItem == true}</conditionExpression>
     </sequenceFlow>

     <userTask id="Task_PreparePackage" name="Prepare Package">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_4</outgoing>
     </userTask>

     <sequenceFlow id="SequenceFlow_4" sourceRef="Task_PreparePackage" targetRef="Task_InformCourier"/>

     <userTask id="Task_InformCourier" name="Inform Courier">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </userTask>

     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_InformCourier" targetRef="ExclusiveGateway_Delay"/>

     <exclusiveGateway id="ExclusiveGateway_Delay">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_6</outgoing>
       <outgoing>SequenceFlow_WaitForResources</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_6" name="" sourceRef="ExclusiveGateway_Delay" targetRef="Task_PickupPackage">
     </sequenceFlow>

     <userTask id="Task_PickupPackage" name="Pickup Package">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_7</outgoing>
     </userTask>

     <sequenceFlow id="SequenceFlow_7" sourceRef="Task_PickupPackage" targetRef="Task_UpdateSystem"/>

     <userTask id="Task_UpdateSystem" name="Update System">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_8</outgoing>
     </userTask>

     <sequenceFlow id="SequenceFlow_8" sourceRef="Task_UpdateSystem" targetRef="EndEvent_DeliveryCompleted"/>

     <endEvent id="EndEvent_DeliveryCompleted">
       <incoming>SequenceFlow_8</incoming>
     </endEvent>

     <!-- Discontinued Item handling  -->
     <userTask id="Task_InformCustomerDiscontinued" name="Inform Customer about discontinued item">
       <incoming>SequenceFlow_DiscontinuedItem</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </userTask>

     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_InformCustomerDiscontinued" targetRef="Task_OrderMissingProducts"/>

     <userTask id="Task_OrderMissingProducts" name="Order missing products">
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_WaitForDelivery</outgoing>
     </userTask>

     <sequenceFlow id="SequenceFlow_WaitForDelivery" sourceRef="Task_OrderMissingProducts" targetRef="Task_WaitForXDays"/>

     <serviceTask id="Task_WaitForXDays" name="Wait for delivery  (x days)">
       <incoming>SequenceFlow_WaitForDelivery</incoming>
       <outgoing>SequenceFlow_CheckAvailabilityAgain</outgoing>
     </serviceTask>

     <sequenceFlow id="SequenceFlow_CheckAvailabilityAgain" sourceRef="Task_WaitForXDays" targetRef="ExclusiveGateway_CheckAvailabilityAgain"/>

     <exclusiveGateway id="ExclusiveGateway_CheckAvailabilityAgain">
       <incoming>SequenceFlow_CheckAvailabilityAgain</incoming>
       <outgoing>SequenceFlow_10</outgoing>
       <outgoing>SequenceFlow_InformCustomerDelay</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_10" name="" sourceRef="ExclusiveGateway_CheckAvailabilityAgain" targetRef="Task_PreparePackage">
     </sequenceFlow>

     <!-- Inform customer about delay  -->
     <userTask id="Task_InformCustomerDelay" name="Inform Customer about potential delay">
       <incoming>SequenceFlow_InformCustomerDelay</incoming>
       <outgoing>SequenceFlow_11</outgoing>
     </userTask>

     <sequenceFlow id="SequenceFlow_InformCustomerDelay" sourceRef="ExclusiveGateway_CheckAvailabilityAgain" targetRef="Task_InformCustomerDelay">
     </sequenceFlow>

     <sequenceFlow id="SequenceFlow_11" sourceRef="Task_InformCustomerDelay" targetRef="EndEvent_CancelOrder"/>

     <endEvent id="EndEvent_CancelOrder">
       <incoming>SequenceFlow_11</incoming>
     </endEvent>

     <!-- Wait for resources  -->
     <sequenceFlow id="SequenceFlow_WaitForResources" sourceRef="ExclusiveGateway_Delay" targetRef="Task_WaitForResources"/>

     <serviceTask id="Task_WaitForResources" name="Wait until there are enough resources">
       <incoming>SequenceFlow_WaitForResources</incoming>
       <outgoing>SequenceFlow_12</outgoing>
     </serviceTask>

     <sequenceFlow id="SequenceFlow_12" sourceRef="Task_WaitForResources" targetRef="Task_PickupPackage"/>

   </process>
</definitions>