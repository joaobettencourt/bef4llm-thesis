<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" name="Bank Account Linking Process"
             targetNamespace="http://bpmn.io/schema/bpmn">

   <process id="Process_1" isExecutable="true">
     <laneSet>
       <lane id="Lane_1" name="PayPal Client">
         <flowNodeRef>StartEvent_1</flowNodeRef>
         <flowNodeRef>Task_Enter_Bank_Details</flowNodeRef>
         <flowNodeRef>Task_Enter_Deposit_Amounts</flowNodeRef>
         <flowNodeRef>ExclusiveGateway_Verify_Deposits</flowNodeRef>
         <flowNodeRef>Task_Remove_Bank_Account</flowNodeRef>
       </lane>
       <lane id="Lane_2" name="PayPal System">
         <flowNodeRef>IntermediateThrowEvent_Make_Two_Random_Deposits</flowNodeRef>
         <flowNodeRef>Task_Notify_Client_to_Verify_Deposits</flowNodeRef>
         <flowNodeRef>IntermediateCatchEvent_Wait_for_Client_Verification</flowNodeRef>
       </lane>
     </laneSet>

     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_Enter_Bank_Details"/>

     <task id="Task_Enter_Bank_Details" name="Enter Bank Details">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_Enter_Bank_Details" targetRef="IntermediateThrowEvent_Make_Two_Random_Deposits"/>

     <intermediateThrowEvent id="IntermediateThrowEvent_Make_Two_Random_Deposits">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
     </intermediateThrowEvent>

     <sequenceFlow id="SequenceFlow_3" sourceRef="IntermediateThrowEvent_Make_Two_Random_Deposits" targetRef="Task_Notify_Client_to_Verify_Deposits"/>

     <task id="Task_Notify_Client_to_Verify_Deposits" name="Notify Client to Verify Deposits">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_4</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_4" sourceRef="Task_Notify_Client_to_Verify_Deposits" targetRef="IntermediateCatchEvent_Wait_for_Client_Verification"/>

     <intermediateCatchEvent id="IntermediateCatchEvent_Wait_for_Client_Verification">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </intermediateCatchEvent>

     <sequenceFlow id="SequenceFlow_5" sourceRef="IntermediateCatchEvent_Wait_for_Client_Verification" targetRef="Task_Enter_Deposit_Amounts"/>

     <task id="Task_Enter_Deposit_Amounts" name="Enter Deposit Amounts">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_Enter_Deposit_Amounts" targetRef="ExclusiveGateway_Verify_Deposits"/>

     <exclusiveGateway id="ExclusiveGateway_Verify_Deposits">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_7</outgoing>
       <outgoing>SequenceFlow_8</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_7" name="Values Match" sourceRef="ExclusiveGateway_Verify_Deposits" targetRef="EndEvent_Bank_Account_Linked"/>

     <endEvent id="EndEvent_Bank_Account_Linked">
       <incoming>SequenceFlow_7</incoming>
     </endEvent>

     <sequenceFlow id="SequenceFlow_8" name="Values Do Not Match" sourceRef="ExclusiveGateway_Verify_Deposits" targetRef="Task_Remove_Bank_Account"/>

     <task id="Task_Remove_Bank_Account" name="Remove Bank Account from System">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_Remove_Bank_Account" targetRef="EndEvent_Bank_Account_Removed"/>

     <endEvent id="EndEvent_Bank_Account_Removed">
       <incoming>SequenceFlow_9</incoming>
     </endEvent>

   </process>
 </definitions>