<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definitions" 
             targetNamespace="http://example.com/bpmn">

   <process id="Process_1" isExecutable="true">
     <laneSet>
       <lane id="Lane_PaymentOffice" name="Payment Office">
         <flowNodeRef>Task_GeneratePaymentReport</flowNodeRef>
         <flowNodeRef>Task_PayVendor</flowNodeRef>
         <flowNodeRef>StartEvent_WeeklyPayment</flowNodeRef>
       </lane>
       <lane id="Lane_RegistryOffice" name="Registry Office">
         <flowNodeRef>Task_SelectInvoicesForArchiving</flowNodeRef>
         <flowNodeRef>Task_ArchiveInvoices</flowNodeRef>
       </lane>
       <lane id="Lane_AccountsReceivableDepartment" name="Accounts Receivable Department">
         <flowNodeRef>Task_GenerateMonthlyInvoice</flowNodeRef>
         <flowNodeRef>Task_NotifyClientOfCharge</flowNodeRef>
       </lane>
     </laneSet>

     <startEvent id="StartEvent_WeeklyPayment">
       <outgoing>SequenceFlow_StartToGenerateReport</outgoing>
       <timerEventDefinition interval="PT168H"/> 
     </startEvent>

     <sequenceFlow id="SequenceFlow_StartToGenerateReport" sourceRef="StartEvent_WeeklyPayment" targetRef="Task_GeneratePaymentReport"/>

     <task id="Task_GeneratePaymentReport" name="Generate Payment Report">
       <incoming>SequenceFlow_StartToGenerateReport</incoming>
       <outgoing>SequenceFlow_GenerateReportToPayVendor</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_GenerateReportToPayVendor" sourceRef="Task_GeneratePaymentReport" targetRef="Task_PayVendor"/>

     <task id="Task_PayVendor" name="Pay Vendor">
       <incoming>SequenceFlow_GenerateReportToPayVendor</incoming>
       <outgoing>SequenceFlow_PayVendorToSendReports</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_PayVendorToSendReports" sourceRef="Task_PayVendor" targetRef="Task_SendPaymentReportToClients"/>

     <task id="Task_SendPaymentReportToClients" name="Send Payment Report to Clients (including invoice)">
       <incoming>SequenceFlow_PayVendorToSendReports</incoming>
       <outgoing>SequenceFlow_SendToRegistryOffice</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_SendToRegistryOffice" sourceRef="Task_SendPaymentReportToClients" targetRef="Task_SendPaymentReportToRegistryOffice"/>

     <task id="Task_SendPaymentReportToRegistryOffice" name="Send Payment Report to Registry Office">
       <incoming>SequenceFlow_SendToRegistryOffice</incoming>
       <outgoing>SequenceFlow_RegistryToSelectInvoices</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_RegistryToSelectInvoices" sourceRef="Task_SendPaymentReportToRegistryOffice" targetRef="Task_SelectInvoicesForArchiving"/>

     <task id="Task_SelectInvoicesForArchiving" name="Select Invoices for Archiving">
       <incoming>SequenceFlow_RegistryToSelectInvoices</incoming>
       <outgoing>SequenceFlow_SelectInvoicesToArchive</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_SelectInvoicesToArchive" sourceRef="Task_SelectInvoicesForArchiving" targetRef="Task_ArchiveInvoices"/>

     <task id="Task_ArchiveInvoices" name="Archive Invoices">
       <incoming>SequenceFlow_SelectInvoicesToArchive</incoming>
     </task>

     <sequenceFlow id="SequenceFlow_PayVendorToGenerateMonthlyInvoice" sourceRef="Task_PayVendor" targetRef="Task_GenerateMonthlyInvoice"/>

     <task id="Task_GenerateMonthlyInvoice" name="Generate Monthly Invoice for Clients">
       <incoming>SequenceFlow_PayVendorToGenerateMonthlyInvoice</incoming>
       <outgoing>SequenceFlow_GenerateMonthlyInvoiceToNotifyClient</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_GenerateMonthlyInvoiceToNotifyClient" sourceRef="Task_GenerateMonthlyInvoice" targetRef="Task_NotifyClientOfCharge"/>

     <task id="Task_NotifyClientOfCharge" name="Notify Client of $35 Charge per Invoice">
       <incoming>SequenceFlow_GenerateMonthlyInvoiceToNotifyClient</incoming>
     </task>

   </process>
</definitions>