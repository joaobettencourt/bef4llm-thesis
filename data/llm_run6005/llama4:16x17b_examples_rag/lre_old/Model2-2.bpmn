<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
                  id="definitions" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="switchOverProcess" name="Switch Over Process" isExecutable="true">
    <bpmn:startEvent id="startEvent" name="Switch-over Request">
      <bpmn:outgoing>sequenceFlow1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="sequenceFlow1" sourceRef="startEvent" targetRef="task_ReceiveCustomerData"/>
    <bpmn:task id="task_ReceiveCustomerData" name="Receive Customer Data">
      <bpmn:incoming>sequenceFlow1</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="sequenceFlow2" sourceRef="task_ReceiveCustomerData" targetRef="task_CreateCustomerObject"/>
    <bpmn:task id="task_CreateCustomerObject" name="Create Customer Object">
      <bpmn:incoming>sequenceFlow2</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="sequenceFlow3" sourceRef="task_CreateCustomerObject" targetRef="exclusiveGateway_DataComparison"/>
    <bpmn:exclusiveGateway id="exclusiveGateway_DataComparison" name="Data Comparison and Completeness Check">
      <bpmn:incoming>sequenceFlow3</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow4</bpmn:outgoing>
      <bpmn:outgoing>sequenceFlow5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="sequenceFlow4" name="yes" sourceRef="exclusiveGateway_DataComparison" targetRef="task_PrepareContractDocuments">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${dataValid == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:task id="task_PrepareContractDocuments" name="Prepare Contract Documents">
      <bpmn:incoming>sequenceFlow4</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="sequenceFlow5" name="no" sourceRef="exclusiveGateway_DataComparison" targetRef="endEvent_ProcessTerminated">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${dataValid == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="endEvent_ProcessTerminated" name="Process Terminated">
      <bpmn:incoming>sequenceFlow5</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>