<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd" 
             id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
    <bpmn:collaboration id="Collaboration_1">
      <bpmn:participant id="Participant_1" name="MPOO" processRef="Process_MPNO"/>
      <bpmn:participant id="Participant_2" name="MPON" processRef="Process_MPON"/>
      <bpmn:participant id="Participant_3" name="GO" processRef="Process_GO"/>
      <bpmn:participant id="Participant_4" name="MSP" processRef="Process_MSP"/>
    </bpmn:collaboration>
   
    <bpmn:process id="Process_MPNO" isExecutable="false">
      <bpmn:startEvent id="StartEvent_1" name="MPON Notifies Equipment Change Intentions">
        <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
      </bpmn:startEvent>

      <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_MPNO_Notify"/>

      <bpmn:task id="Task_MPNO_Notify" name="MPON Notifies MPOO">
        <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
      </bpmn:task>

      <sequenceFlow id="SequenceFlow_2" sourceRef="Task_MPNO_Notify" targetRef="ExclusiveGateway_1"/>

      <bpmn:exclusiveGateway id="ExclusiveGateway_1">
        <bpmn:incoming>SequenceFlow_2</incoming>
        <bpmn:outgoing>SequenceFlow_3</outgoing>
        <bpmn:outgoing>SequenceFlow_4</outgoing>
      </bpmn:exclusiveGateway>

      <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_1" targetRef="Task_MPOO_Dismounting">
        <bpmn:conditionExpression xsi:type="tFormalExpression">${selfDismounting  == true}</bpmn:conditionExpression>
      </sequenceFlow>

      <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_1" targetRef="Task_MPOO_NoSelfDismounting">
        <bpmn:conditionExpression xsi:type="tFormalExpression">${selfDismounting  == false}</bpmn:conditionExpression>
      </sequenceFlow>

      <bpmn:task id="Task_MPOO_Dismounting" name="MPOO Announces Self Dismounting">
        <bpmn:outgoing>SequenceFlow_5</bpmn:outing/>
      </bpmn:task>

      <sequenceFlow id="SequenceFlow_5" sourceRef="Task_MPOO_Dismounting" targetRef="Task_FinalReading"/>

      <bpmn:task id="Task_MPOO_NoSelfDismounting" name="MPOO Notify No Self-Dismounting">
        <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
      </bpmn:task>

      <sequenceFlow id="SequenceFlow_6" sourceRef="Task_MPOO_NoSelfDismounting" targetRef="Task_FinalReading"/>

      <bpmn:task id="Task_FinalReading" name="MPON or MPOO Perform Final Reading">
        <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
      </bpmn:task>

      <sequenceFlow id="SequenceFlow_7" sourceRef="Task_FinalReading" targetRef="Task_DismountOldEquipment"/>

      <bpmn:task id="Task_DismountOldEquipment" name="MPON or MPOO Dismount Old Equipment">
        <bpmn:outgoing>SequenceFlow_8</bpmn:outgoing>
      </bpmn:task>

      <sequenceFlow id="SequenceFlow_8" sourceRef="Task_DismountOldEquipment" targetRef="Task_MountNewDevice"/>

      <bpmn:task id="Task_MountNewDevice" name="MPON Mounts New Device">
        <bpmn:outgoing>SequenceFlow_9</bpmn:outgoing>
      </bpmn:task>

      <sequenceFlow id="SequenceFlow_9" sourceRef="Task_MountNewDevice" targetRef="Task_ReadMeterCount"/>

      <bpmn:task id="Task_ReadMeterCount" name="MPON Reads Meter Count">
        <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
      </bpmn:task>

      <sequenceFlow id="SequenceFlow_10" sourceRef="Task_ReadMeterCount" targetRef="Task_SendValuesToGO"/>

      <bpmn:task id="Task_SendValuesToGO" name="MPON Sends Values to GO">
        <bpmn:outgoing>SequenceFlow_11</bpmn:outgoing>
      </bpmn:task>

      <sequenceFlow id="SequenceFlow_11" sourceRef="Task_SendValuesToGO" targetRef="Task_GO_NotifyMSP"/>

      <bpmn:task id="Task_GO_NotifyMSP" name="GO Notifies MSP">
        <bpmn:outgoing>SequenceFlow_12</bpmn:outgoing>
      </bpmn:task>

      <sequenceFlow id="SequenceFlow_12" sourceRef="Task_GO_NotifyMSP" targetRef="EndEvent_1"/>

      <endEvent id="EndEvent_1"/>
    </bpmn:process>

    <bpmn:process id="Process_MPON" isExecutable="false">
    </bpmn:process>
    
    <bpmn:process id="Process_GO" isExecutable="false">
    </bpmn:process>
    
    <bpmn:process id="Process_MSP" isExecutable="false">
    </bpmn:process>

</definitions>