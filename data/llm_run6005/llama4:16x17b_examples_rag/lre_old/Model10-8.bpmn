<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
                 id="Definitions" targetNamespace="http://www.example.com">
  <bpmn:process id="DeregistrationProcess" name="MSPO Deregistration Process" isExecutable="true">
    <bpmn:startEvent id="StartEvent" name="Begin MSPO Deregistration">
      <bpmn:outgoing>SequenceFlow1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:sequenceFlow id="SequenceFlow1" sourceRef="StartEvent" targetRef="Task_Deregister"/>

    <bpmn:task id="Task_Deregister" name="MSPO deregisters at the GO">
      <bpmn:incoming>SequenceFlow1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow2" sourceRef="Task_Deregister" targetRef="ExclusiveGateway_Verify"/>

    <bpmn:exclusiveGateway id="ExclusiveGateway_Verify" name="Verify Deregistration">
      <bpmn:incoming>SequenceFlow2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow3</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow4</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="SequenceFlow3" sourceRef="ExclusiveGateway_Verify" targetRef="Task_RejectDeregistration">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${deregistrationRejected == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:task id="Task_RejectDeregistration" name="GO rejects the deregistration of the MSPO">
      <bpmn:incoming>SequenceFlow3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow5</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow4" sourceRef="ExclusiveGateway_Verify" targetRef="Task_PrepareConfirmation">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${deregistrationPreliminarilyConfirmed == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:task id="Task_PrepareConfirmation" name="GO preliminarily confirms the deregistration of the MSPO">
      <bpmn:incoming>SequenceFlow4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow6</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow5" sourceRef="Task_RejectDeregistration" targetRef="EndEvent_Rejected"/>

    <bpmn:endEvent id="EndEvent_Rejected">
      <bpmn:incoming>SequenceFlow5</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow6" sourceRef="Task_PrepareConfirmation" targetRef="Task_AssignGOasMSP"/>

    <bpmn:task id="Task_AssignGOasMSP" name="GO assigns himself as MSP">
      <bpmn:incoming>SequenceFlow6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow7</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow7" sourceRef="Task_AssignGOasMSP" targetRef="Task_InformeMSPO"/>

    <bpmn:task id="Task_InformeMSPO" name="GO informs the MSPO about the end of the assignment and the beginning of the assignment of the GO">
      <bpmn:incoming>SequenceFlow7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow8</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow8" sourceRef="Task_InformeMSPO" targetRef="Task_InformeMPO"/>

    <bpmn:task id="Task_InformeMPO" name="GO informs the MPO about the assignment of the GO">
      <bpmn:incoming>SequenceFlow8</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow9</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow9" sourceRef="Task_InformeMPO" targetRef="Task_InformeSP"/>

    <bpmn:task id="Task_InformeSP" name="GO informs the SP about the assignment of the GO">
      <bpmn:incoming>SequenceFlow9</bpmn:incoming>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_Completed">
      <bpmn:incoming>SequenceFlow10</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>