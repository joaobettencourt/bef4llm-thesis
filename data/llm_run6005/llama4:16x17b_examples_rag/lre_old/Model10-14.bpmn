<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd" 
             id="Definitions" targetNamespace="http://www.example.com">

    <collaboration id="Collaboration">
      <participant id="Participant_1" name="MPOO" processRef="Process_1"/>
      <participant id="Participant_2" name="GO" processRef="Process_2"/>
      <participant id="Participant_3" name="MSPO" processRef="Process_3"/>
      <participant id="Participant_4" name="MPON" processRef="Process_4"/>
    </collaboration>

    <process id="Process_1" name="Invoice Processing MPOO" isExecutable="true">
      <startEvent id="StartEvent_1">
        <outgoing>SequenceFlow_1</outgoing>
      </startEvent>

      <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_ExamineBill_MPOO"/>

      <task id="Task_ExamineBill_MPOO" name="Examine Bill MPOO">
        <incoming>SequenceFlow_1</incoming>
        <outgoing>SequenceFlow_2</outgoing>
      </task>

      <sequenceFlow id="SequenceFlow_2" sourceRef="Task_ExamineBill_MPOO" targetRef="ExclusiveGateway_1"/>

      <exclusiveGateway id="ExclusiveGateway_1">
        <incoming>SequenceFlow_2</incoming>
        <outgoing>SequenceFlow_3</outgoing>
        <outgoing>SequenceFlow_4</outgoing>
      </exclusiveGateway>

      <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_1" targetRef="Task_SendConfirmation_MPOO">
        <conditionExpression xsi:type="tFormalExpression">${invoiceConfirmed == true}</conditionExpression>
      </sequenceFlow>

      <task id="Task_SendConfirmation_MPOO" name="Send Confirmation with Payment Advice MPOO">
        <incoming>SequenceFlow_3</incoming>
      </task>

      <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_1" targetRef="Task_RejectInvoice_MPOO">
        <conditionExpression xsi:type="tFormalExpression">${invoiceConfirmed == false}</conditionExpression>
      </sequenceFlow>

      <task id="Task_RejectInvoice_MPOO" name="Reject Invoice MPOO">
        <incoming>SequenceFlow_4</incoming>
      </task>

      <endEvent id="EndEvent_1">
        <incoming>SequenceFlow_5</incoming>
      </endEvent>

      <sequenceFlow id="SequenceFlow_5" sourceRef="Task_SendConfirmation_MPOO" targetRef="EndEvent_1"/>
    </process>

    <process id="Process_2" name="Invoice Processing GO" isExecutable="true">
      <startEvent id="StartEvent_2">
        <outgoing>SequenceFlow_6</outgoing>
      </startEvent>

      <sequenceFlow id="SequenceFlow_6" sourceRef="StartEvent_2" targetRef="Task_ExamineBill_GO"/>

      <task id="Task_ExamineBill_GO" name="Examine Bill GO">
        <incoming>SequenceFlow_6</incoming>
        <outgoing>SequenceFlow_7</outgoing>
      </task>

      <sequenceFlow id="SequenceFlow_7" sourceRef="Task_ExamineBill_GO" targetRef="ExclusiveGateway_2"/>

      <exclusiveGateway id="ExclusiveGateway_2">
        <incoming>SequenceFlow_7</incoming>
        <outgoing>SequenceFlow_8</outgoing>
        <outgoing>SequenceFlow_9</outgoing>
      </exclusiveGateway>

      <sequenceFlow id="SequenceFlow_8" sourceRef="ExclusiveGateway_2" targetRef="Task_SendConfirmation_GO">
        <conditionExpression xsi:type="tFormalExpression">${invoiceConfirmed == true}</conditionExpression>
      </sequenceFlow>

      <task id="Task_SendConfirmation_GO" name="Send Confirmation with Payment Advice GO">
        <incoming>SequenceFlow_8</incoming>
      </task>

      <sequenceFlow id="SequenceFlow_9" sourceRef="ExclusiveGateway_2" targetRef="Task_RejectInvoice_GO">
        <conditionExpression xsi:type="tFormalExpression">${invoiceConfirmed == false}</conditionExpression>
      </sequenceFlow>

      <task id="Task_RejectInvoice_GO" name="Reject Invoice GO">
        <incoming>SequenceFlow_9</incoming>
      </task>

      <endEvent id="EndEvent_2">
        <incoming>SequenceFlow_10</incoming>
      </endEvent>

      <sequenceFlow id="SequenceFlow_10" sourceRef="Task_SendConfirmation_GO" targetRef="EndEvent_2"/>
    </process>

    <process id="Process_3" name="Invoice Processing MSPO" isExecutable="true">
      <!-- Add process elements here -->
    </process>

    <process id="Process_4" name="Invoice Processing MPON" isExecutable="true">
      <!-- Add process elements here -->
    </process>
</definitions>