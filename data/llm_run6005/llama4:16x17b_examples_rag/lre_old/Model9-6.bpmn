<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
                  id="Definitions" targetNamespace="http://www.example.com">

  <bpmn:process id="DesignProcess" name="Design Process" isExecutable="true">
    <bpmn:startEvent id="StartEvent" name="Process starts">
      <bpmn:outgoing>SequenceFlow1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:sequenceFlow id="SequenceFlow1" sourceRef="StartEvent" targetRef="Task_LocateDistributeDesigns"/>

    <bpmn:task id="Task_LocateDistributeDesigns" name="Locate and distribute designs">
      <bpmn:incoming>SequenceFlow1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow2" sourceRef="Task_LocateDistributeDesigns" targetRef="ParallelGateway"/>

    <bpmn:parallelGateway id="ParallelGateway">
      <bpmn:incoming>SequenceFlow2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow3</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow4</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:sequenceFlow id="SequenceFlow3" sourceRef="ParallelGateway" targetRef="Task_ElectricalDesign"/>
    <bpmn:sequenceFlow id="SequenceFlow4" sourceRef="ParallelGateway" targetRef="Task_PhysicalDesign"/>

    <bpmn:task id="Task_ElectricalDesign" name="Electrical Design">
      <bpmn:incoming>SequenceFlow3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow5</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_PhysicalDesign" name="Physical Design">
      <bpmn:incoming>SequenceFlow4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow6</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow5" sourceRef="Task_ElectricalDesign" targetRef="ExclusiveGateway_1"/>
    <bpmn:sequenceFlow id="SequenceFlow6" sourceRef="Task_PhysicalDesign" targetRef="ExclusiveGateway_2"/>

    <bpmn:exclusiveGateway id="ExclusiveGateway_1">
      <bpmn:incoming>SequenceFlow5</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow7</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow8</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="SequenceFlow7" sourceRef="ExclusiveGateway_1" targetRef="Task_UpdateElectricalDesign">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${electricalUpdateNecessary  == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow8" sourceRef="ExclusiveGateway_1" targetRef="Task_TestElectricalDesign">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${electricalUpdateNecessary  == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:exclusiveGateway id="ExclusiveGateway_2">
      <bpmn:incoming>SequenceFlow6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow9</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow10</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="SequenceFlow9" sourceRef="ExclusiveGateway_2" targetRef="Task_UpdatePhysicalDesign">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${physicalUpdateNecessary  == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow10" sourceRef="ExclusiveGateway_2" targetRef="Task_TestPhysicalDesign">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${physicalUpdateNecessary  == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Tasks for updating and testing designs -->

    <bpmn:task id="Task_UpdateElectricalDesign" name="Update Electrical Design">
      <bpmn:incoming>SequenceFlow7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow11</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_TestElectricalDesign" name="Test Electrical Design">
      <bpmn:incoming>SequenceFlow8</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow12</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_UpdatePhysicalDesign" name="Update Physical Design">
      <bpmn:incoming>SequenceFlow9</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow13</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_TestPhysicalDesign" name="Test Physical Design">
      <bpmn:incoming>SequenceFlow10</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow14</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flows for testing and combining designs -->

    <bpmn:sequenceFlow id="SequenceFlow11" sourceRef="Task_UpdateElectricalDesign" targetRef="ExclusiveGateway_3"/>
    <bpmn:sequenceFlow id="SequenceFlow12" sourceRef="Task_TestElectricalDesign" targetRef="ExclusiveGateway_4">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${electricalTestPassed  == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:exclusiveGateway id="ExclusiveGateway_3">
      <bpmn:incoming>SequenceFlow11</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow15</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow16</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="SequenceFlow13" sourceRef="Task_UpdatePhysicalDesign" targetRef="ExclusiveGateway_5"/>
    <bpmn:sequenceFlow id="SequenceFlow14" sourceRef="Task_TestPhysicalDesign" targetRef="ExclusiveGateway_6">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${physicalTestPassed  == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:exclusiveGateway id="ExclusiveGateway_4">
      <bpmn:incoming>SequenceFlow12</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow17</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow18</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Tasks and Gateways for handling test results -->

    <bpmn:sequenceFlow id="SequenceFlow15" sourceRef="ExclusiveGateway_3" targetRef="Task_UpdateElectricalDesign"/>
    <bpmn:sequenceFlow id="SequenceFlow16" sourceRef="ExclusiveGateway_3" targetRef="Task_PhysicalDesign"/>

    <bpmn:exclusiveGateway id="ExclusiveGateway_5">
      <bpmn:incoming>SequenceFlow13</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow19</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow20</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="SequenceFlow17" sourceRef="ExclusiveGateway_4" targetRef="Task_UpdateElectricalDesign"/>
    <bpmn:sequenceFlow id="SequenceFlow18" sourceRef="ExclusiveGateway_4" targetRef="Task_PhysicalDesign"/>

    <bpmn:sequenceFlow id="SequenceFlow19" sourceRef="ExclusiveGateway_5" targetRef="Task_UpdatePhysicalDesign"/>
    <bpmn:sequenceFlow id="SequenceFlow20" sourceRef="ExclusiveGateway_5" targetRef="Task_ElectricalDesign"/>

    <!-- Combining and final testing of designs -->

    <bpmn:task id="Task_CombineDesigns" name="Combine Designs">
      <bpmn:incoming>SequenceFlow21</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow22</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow21" sourceRef="Task_UpdatePhysicalDesign" targetRef="Task_CombineDesigns"/>
    <bpmn:sequenceFlow id="SequenceFlow22" sourceRef="Task_CombineDesigns" targetRef="EndEvent"/>

    <bpmn:endEvent id="EndEvent">
      <bpmn:incoming>SequenceFlow22</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>

</bpmn:definitions>