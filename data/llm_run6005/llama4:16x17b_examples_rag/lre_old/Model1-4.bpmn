<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://bpmn.io/schema/bpmn">
  <process id="GoingPublicProcess" name="Going Public Process" isExecutable="true">
    <startEvent id="StartEvent" name="Decision to Go Public">
      <outgoing>SequenceFlow1</outgoing>
    </startEvent>

    <sequenceFlow id="SequenceFlow1" sourceRef="StartEvent" targetRef="Task_SelectUnderwriters"/>

    <task id="Task_SelectUnderwriters" name="Select Underwriters">
      <incoming>SequenceFlow1</incoming>
      <outgoing>SequenceFlow2</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow2" sourceRef="Task_SelectUnderwriters" targetRef="Gateway_PrepareRegistrationStatement"/>

    <exclusiveGateway id="Gateway_PrepareRegistrationStatement">
      <incoming>SequenceFlow2</incoming>
      <outgoing>SequenceFlow3</outgoing>
      <outgoing>SequenceFlow4</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow3" sourceRef="Gateway_PrepareRegistrationStatement" targetRef="Task_PrepareRegistrationStatement">
      <conditionExpression xsi:type="tFormalExpression">${factsPresentedFairly  == true}</conditionExpression>
    </sequenceFlow>

    <task id="Task_PrepareRegistrationStatement" name="Prepare Registration Statement">
      <incoming>SequenceFlow3</incoming>
      <outgoing>SequenceFlow5</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow5" sourceRef="Task_PrepareRegistrationStatement" targetRef="Task_RegisterWithSEC"/>

    <task id="Task_RegisterWithSEC" name="Register with SEC">
      <incoming>SequenceFlow5</incoming>
      <outgoing>SequenceFlow6</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow6" sourceRef="Task_RegisterWithSEC" targetRef="Gateway_FirmUpIssuePrice"/>

    <parallelGateway id="Gateway_FirmUpIssuePrice">
      <incoming>SequenceFlow6</incoming>
      <outgoing>SequenceFlow7</outgoing>
      <outgoing>SequenceFlow8</outgoing>
    </parallelGateway>

    <sequenceFlow id="SequenceFlow7" sourceRef="Gateway_FirmUpIssuePrice" targetRef="Task_ArrangeRoadShow"/>

    <task id="Task_ArrangeRoadShow" name="Arrange Road Show">
      <incoming>SequenceFlow7</incoming>
      <outgoing>SequenceFlow9</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow9" sourceRef="Task_ArrangeRoadShow" targetRef="Gateway_FixIssuePrice"/>

    <exclusiveGateway id="Gateway_FixIssuePrice">
      <incoming>SequenceFlow9</incoming>
      <outgoing>SequenceFlow10</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow10" sourceRef="Gateway_FixIssuePrice" targetRef="Task_FixIssuePriceAndBuy"/>

    <task id="Task_FixIssuePriceAndBuy" name="Fix Issue Price and Buy">
      <incoming>SequenceFlow10</incoming>
      <outgoing>SequenceFlow11</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow11" sourceRef="Task_FixIssuePriceAndBuy" targetRef="EndEvent"/>

    <endEvent id="EndEvent" name="Going Public Completed">
      <incoming>SequenceFlow11</incoming>
    </endEvent>
  </process>
</definitions>