<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.4.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="Definitions" targetNamespace="http://www.example.com">

   <process id="ExpenseReportProcess" name="Expense Report Process" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_ReceiveExpenseReport"/>

     <task id="Task_ReceiveExpenseReport" name="Receive Expense Report">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_ReceiveExpenseReport" targetRef="ExclusiveGateway_HasAccount"/>

     <exclusiveGateway id="ExclusiveGateway_HasAccount">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_4</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_HasAccount" targetRef="Task_ReviewReport">
       <conditionExpression xsi:type="tFormalExpression">${hasAccount == true}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_HasAccount" targetRef="Task_CreateNewAccount">
       <conditionExpression xsi:type="tFormalExpression">${hasAccount == false}</conditionExpression>
     </sequenceFlow>

     <task id="Task_CreateNewAccount" name="Create New Account">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_CreateNewAccount" targetRef="Task_ReviewReport"/>

     <task id="Task_ReviewReport" name="Review Report">
       <incoming>SequenceFlow_3</incoming>
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_ReviewReport" targetRef="ExclusiveGateway_Amount"/>

     <exclusiveGateway id="ExclusiveGateway_Amount">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_7</outgoing>
       <outgoing>SequenceFlow_8</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_7" sourceRef="ExclusiveGateway_Amount" targetRef="EndEvent_Reimburse">
       <conditionExpression xsi:type="tFormalExpression">${amount <= 200}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="SequenceFlow_8" sourceRef="ExclusiveGateway_Amount" targetRef="Task_AskSupervisorApproval">
       <conditionExpression xsi:type="tFormalExpression">${amount > 200}</conditionExpression>
     </sequenceFlow>

     <task id="Task_AskSupervisorApproval" name="Ask Supervisor Approval">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_AskSupervisorApproval" targetRef="ExclusiveGateway_SupervisorResponse"/>

     <exclusiveGateway id="ExclusiveGateway_SupervisorResponse">
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_10</outgoing>
       <outgoing>SequenceFlow_11</outgoing>
       <outgoing>SequenceFlow_12</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_10" sourceRef="ExclusiveGateway_SupervisorResponse" targetRef="EndEvent_Reimburse">
       <conditionExpression xsi:type="tFormalExpression">${supervisorApproved == true}</conditionExpression>
     </sequenceFlow>

     <intermediateCatchEvent id="IntermediateCatchEvent_ApprovalInProgress">
       <incoming>SequenceFlow_11</incoming>
       <outgoing>SequenceFlow_13</outgoing>
       <timerEventDefinition/>
     </intermediateCatchEvent>

     <sequenceFlow id="SequenceFlow_11" sourceRef="ExclusiveGateway_SupervisorResponse" targetRef="IntermediateCatchEvent_ApprovalInProgress">
       <conditionExpression xsi:type="tFormalExpression">${supervisorResponseTime > 7}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="SequenceFlow_13" sourceRef="IntermediateCatchEvent_ApprovalInProgress" targetRef="Task_AskSupervisorApproval"/>

     <intermediateCatchEvent id="IntermediateCatchEvent_RequestExpired">
       <incoming>SequenceFlow_12</incoming>
       <outgoing>SequenceFlow_14</outgoing>
       <timerEventDefinition/>
     </intermediateCatchEvent>

     <sequenceFlow id="SequenceFlow_12" sourceRef="ExclusiveGateway_SupervisorResponse" targetRef="IntermediateCatchEvent_RequestExpired">
       <conditionExpression xsi:type="tFormalExpression">${supervisorResponseTime > 30}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="SequenceFlow_14" sourceRef="IntermediateCatchEvent_RequestExpired" targetRef="EndEvent_CancelRequest"/>

     <endEvent id="EndEvent_Reimburse">
       <incoming>SequenceFlow_7</incoming>
       <incoming>SequenceFlow_10</incoming>
     </endEvent>

     <task id="Task_SendRejectionEmail" name="Send Rejection Email">
       <incoming>SequenceFlow_15</incoming>
     </task>

     <sequenceFlow id="SequenceFlow_15" sourceRef="ExclusiveGateway_SupervisorResponse" targetRef="Task_SendRejectionEmail">
       <conditionExpression xsi:type="tFormalExpression">${supervisorRejected == true}</conditionExpression>
     </sequenceFlow>

     <endEvent id="EndEvent_CancelRequest">
       <incoming>SequenceFlow_14</incoming>
     </endEvent>

   </process>

</definitions>