<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="Definitions" targetNamespace="http://www.example.com">

   <process id="DailyProcess" name="Daily Process" isExecutable="true">
     <laneSet>
       <lane id="Lane_1" name="IT Department">
         <flowNodeRef>StartEvent</flowNodeRef>
         <flowNodeRef>Task_BackupDatabase</flowNodeRef>
         <flowNodeRef>ExclusiveGateway_CheckDefaulters</flowNodeRef>
         <flowNodeRef>Task_SendAlertSupervisor</flowNodeRef>
       </lane>
       <lane id="Lane_2" name="Account Management">
         <flowNodeRef>Task_CheckCRMSystem</flowNodeRef>
         <flowNodeRef>Task_RegisterDefaultingAccounts</flowNodeRef>
         <flowNodeRef>Task_SendReportToManagement</flowNodeRef>
       </lane>
     </laneSet>

     <startEvent id="StartEvent" name="Begin Daily Process">
       <outgoing>SequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow1" sourceRef="StartEvent" targetRef="Task_BackupDatabase"/>

     <task id="Task_BackupDatabase" name="Backup Database">
       <incoming>SequenceFlow1</incoming>
       <outgoing>SequenceFlow2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow2" sourceRef="Task_BackupDatabase" targetRef="ExclusiveGateway_CheckDefaulters"/>

     <exclusiveGateway id="ExclusiveGateway_CheckDefaulters" name="New Defaulters?">
       <incoming>SequenceFlow2</incoming>
       <outgoing>SequenceFlow3</outgoing>
       <outgoing>SequenceFlow4</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow3" sourceRef="ExclusiveGateway_CheckDefaulters" targetRef="Task_SendAlertSupervisor">
       <conditionExpression xsi:type="tFormalExpression">${newDefaulters == false}</conditionExpression>
     </sequenceFlow>

     <task id="Task_SendAlertSupervisor" name="Send Alert to Supervisor">
       <incoming>SequenceFlow3</incoming>
       <outgoing>SequenceFlow13</outgoing>
     </task>

     <endEvent id="EndEvent_CompletedBefore2pm" name="Process Completed Before 2:30 pm">
       <incoming>SequenceFlow13</incoming>
     </endEvent>

     <sequenceFlow id="SequenceFlow13" sourceRef="Task_SendAlertSupervisor" targetRef="EndEvent_CompletedBefore2pm"/>

     <sequenceFlow id="SequenceFlow4" sourceRef="ExclusiveGateway_CheckDefaulters" targetRef="Task_CheckCRMSystem">
       <conditionExpression xsi:type="tFormalExpression">${newDefaulters == true}</conditionExpression>
     </sequenceFlow>

     <task id="Task_CheckCRMSystem" name="Check CRM System for New Returns">
       <incoming>SequenceFlow4</incoming>
       <outgoing>SequenceFlow5</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow5" sourceRef="Task_CheckCRMSystem" targetRef="ExclusiveGateway_NewReturns"/>

     <exclusiveGateway id="ExclusiveGateway_NewReturns" name="New Returns?">
       <incoming>SequenceFlow5</incoming>
       <outgoing>SequenceFlow6</outgoing>
       <outgoing>SequenceFlow10</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow6" sourceRef="ExclusiveGateway_NewReturns" targetRef="Task_RegisterDefaultingAccounts">
       <conditionExpression xsi:type="tFormalExpression">${newReturns == true}</conditionExpression>
     </sequenceFlow>

     <task id="Task_RegisterDefaultingAccounts" name="Register Defaulting Accounts and Customers">
       <incoming>SequenceFlow6</incoming>
       <outgoing>SequenceFlow7</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow7" sourceRef="Task_RegisterDefaultingAccounts" targetRef="Task_SendReportToManagement"/>

     <task id="Task_SendReportToManagement" name="Send Report to Account Management">
       <incoming>SequenceFlow7</incoming>
       <outgoing>SequenceFlow8</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow8" sourceRef="Task_SendReportToManagement" targetRef="Task_ReconcileWithDefaultersTable"/>

     <task id="Task_ReconcileWithDefaultersTable" name="Reconcile with Defaulters Table">
       <incoming>SequenceFlow8</incoming>
       <outgoing>SequenceFlow9</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow9" sourceRef="Task_ReconcileWithDefaultersTable" targetRef="EndEvent_CompletedBefore4pm"/>

     <endEvent id="EndEvent_CompletedBefore4pm" name="Process Completed Before 4:00 pm">
       <incoming>SequenceFlow9</incoming>
     </endEvent>

     <sequenceFlow id="SequenceFlow10" sourceRef="ExclusiveGateway_NewReturns" targetRef="EndEvent_CompletedBefore2pm">
       <conditionExpression xsi:type="tFormalExpression">${newReturns == false}</conditionExpression>
     </sequenceFlow>

   </process>

</definitions>