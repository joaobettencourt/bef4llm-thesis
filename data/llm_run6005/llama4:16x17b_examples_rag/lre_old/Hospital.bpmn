<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
                 id="Definitions" targetNamespace="http://www.example.com">

  <bpmn:process id="ExaminationProcess" name="Patient Examination Process" isExecutable="true">
    <bpmn:startEvent id="StartEvent" name="Outpatient Physician Examines Patient">
      <bpmn:outgoing>SequenceFlow1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:sequenceFlow id="SequenceFlow1" sourceRef="StartEvent" targetRef="ExclusiveGateway"/>

    <bpmn:exclusiveGateway id="ExclusiveGateway" name="Is Additional Examination Needed?">
      <bpmn:incoming>SequenceFlow1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow2</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow3</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="SequenceFlow2" name="No" sourceRef="ExclusiveGateway" targetRef="Task_CompleteProcess">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${additionalExamination  == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:endEvent id="EndEvent_Leave" name="Patient Leaves">
      <bpmn:incoming>SequenceFlow2</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:task id="Task_CompleteProcess" name="Fill Out Examination Form">
      <bpmn:incoming>SequenceFlow2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow19</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow19" sourceRef="Task_CompleteProcess" targetRef="EndEvent_Leave"/>

    <bpmn:sequenceFlow id="SequenceFlow3" name="Yes" sourceRef="ExclusiveGateway" targetRef="Task_CreateExaminationOrder">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${additionalExamination  == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:task id="Task_CreateExaminationOrder" name="Create Examination and Follow-up Treatment Order">
      <bpmn:incoming>SequenceFlow3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow4</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow4" sourceRef="Task_CreateExaminationOrder" targetRef="Task_FillOutRequestForm"/>

    <bpmn:task id="Task_FillOutRequestForm" name="Fill Out Request Form">
      <bpmn:incoming>SequenceFlow4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow5</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow5" sourceRef="Task_FillOutRequestForm" targetRef="Task_InformPatientAboutRisks"/>

    <bpmn:task id="Task_InformPatientAboutRisks" name="Inform Patient About Potential Risks">
      <bpmn:incoming>SequenceFlow5</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow6</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow6" sourceRef="Task_InformPatientAboutRisks" targetRef="ExclusiveGateway_SignConsent"/>

    <bpmn:exclusiveGateway id="ExclusiveGateway_SignConsent" name="Does Patient Sign Informed Consent?">
      <bpmn:incoming>SequenceFlow6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow7</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow20</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="SequenceFlow7" name="Yes" sourceRef="ExclusiveGateway_SignConsent" targetRef="Task_ArrangeAppointment">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${patientSignedConsent  == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:task id="Task_ArrangeAppointment" name="Arrange Appointment with Ward">
      <bpmn:incoming>SequenceFlow7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow8</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow8" sourceRef="Task_ArrangeAppointment" targetRef="Task_PrepareExaminationAndSampling"/>

    <bpmn:task id="Task_PrepareExaminationAndSampling" name="Prepare Examination and Sampling">
      <bpmn:incoming>SequenceFlow8</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow9</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow9" sourceRef="Task_PrepareExaminationAndSampling" targetRef="Task_TakeSample"/>

    <bpmn:task id="Task_TakeSample" name="Take Sample">
      <bpmn:incoming>SequenceFlow9</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow10</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow10" sourceRef="Task_TakeSample" targetRef="Task_SendSampleToLab"/>

    <bpmn:task id="Task_SendSampleToLab" name="Send Sample to Lab">
      <bpmn:incoming>SequenceFlow10</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow11</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow11" sourceRef="Task_SendSampleToLab" targetRef="ExclusiveGateway_ValidateSample"/>

    <bpmn:exclusiveGateway id="ExclusiveGateway_ValidateSample" name="Is Sample Valid?">
      <bpmn:incoming>SequenceFlow11</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow12</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow21</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="SequenceFlow12" name="Yes" sourceRef="ExclusiveGateway_ValidateSample" targetRef="Task_PerformAnalysis">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${sampleValid  == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:task id="Task_PerformAnalysis" name="Perform Analysis">
      <bpmn:incoming>SequenceFlow12</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow13</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow13" sourceRef="Task_PerformAnalysis" targetRef="Task_ValidateResults"/>

    <bpmn:task id="Task_ValidateResults" name="Validate Results">
      <bpmn:incoming>SequenceFlow13</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow14</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow14" sourceRef="Task_ValidateResults" targetRef="Task_MakeDiagnosis"/>

    <bpmn:task id="Task_MakeDiagnosis" name="Make Diagnosis and Prescribe Therapy">
      <bpmn:incoming>SequenceFlow14</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow15</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow15" sourceRef="Task_MakeDiagnosis" targetRef="EndEvent_CompleteProcess"/>

    <bpmn:endEvent id="EndEvent_CompleteProcess" name="Examination Process Complete">
      <bpmn:incoming>SequenceFlow15</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow20" name="No" sourceRef="ExclusiveGateway_SignConsent" targetRef="EndEvent_CancelProcess">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${patientSignedConsent  == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:endEvent id="EndEvent_CancelProcess" name="Examination Process Cancelled">
      <bpmn:incoming>SequenceFlow20</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow21" name="No" sourceRef="ExclusiveGateway_ValidateSample" targetRef="Task_RequestNewSample">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${sampleValid  == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:task id="Task_RequestNewSample" name="Request New Sample">
      <bpmn:incoming>SequenceFlow21</bpmn:incoming>
    </bpmn:task>

  </bpmn:process>

</bpmn:definitions>