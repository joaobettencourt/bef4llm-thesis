<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
                 id="definitions" targetNamespace="http://www.example.com">

  <bpmn:process id="OfficeSupplyRequestProcess" name="Office Supply Request Process" isExecutable="true">
    <bpmn:startEvent id="StartEvent" name="Submit Office Supply Request">
      <bpmn:outgoing>SequenceFlow1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:sequenceFlow id="SequenceFlow1" sourceRef="StartEvent" targetRef="Task_ReceiveRequest"/>

    <bpmn:task id="Task_ReceiveRequest" name="Receive and Register Request">
      <bpmn:incoming>SequenceFlow1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow2" sourceRef="Task_ReceiveRequest" targetRef="ExclusiveGateway"/>

    <bpmn:exclusiveGateway id="ExclusiveGateway">
      <bpmn:incoming>SequenceFlow2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow3</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow4</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow5</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="SequenceFlow3" name="Approve" sourceRef="ExclusiveGateway" targetRef="Task_PurchaseDepartment">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${approval == 'approved'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow4" name="Reject" sourceRef="ExclusiveGateway" targetRef="EndEvent_Reject">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${approval == 'rejected'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow5" name="Change Requested" sourceRef="ExclusiveGateway" targetRef="Task_SendChangeRequestBackToEmployee">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${approval == 'change requested'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:task id="Task_PurchaseDepartment" name="Purchase Department (Quotation and Vendor Selection)">
      <bpmn:incoming>SequenceFlow3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow6</bpmn:outgoing>
    </bpmn:task>

    <bpmn:subProcess id="SubProcess_QuotationAndVendorSelection">
      <bpmn:incoming>SequenceFlow6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow7</bpmn:outgoing>

      <bpmn:startEvent id="StartEvent_SubProcess" name="Begin Quotation and Vendor Selection">
        <bpmn:outgoing>SequenceFlow_SubProcess1</bpmn:outgoing>
      </bpmn:startEvent>

      <bpmn:sequenceFlow id="SequenceFlow_SubProcess1" sourceRef="StartEvent_SubProcess" targetRef="Task_MakeQuotations"/>

      <bpmn:task id="Task_MakeQuotations" name="Make Quotations">
        <bpmn:incoming>SequenceFlow_SubProcess1</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow_SubProcess2</bpmn:outgoing>
      </bpmn:task>

      <bpmn:sequenceFlow id="SequenceFlow_SubProcess2" sourceRef="Task_MakeQuotations" targetRef="ExclusiveGateway_SubProcess"/>

      <bpmn:exclusiveGateway id="ExclusiveGateway_SubProcess">
        <bpmn:incoming>SequenceFlow_SubProcess2</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow_SubProcess3</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow_SubProcess4</bpmn:outgoing>
      </bpmn:exclusiveGateway>

      <bpmn:sequenceFlow id="SequenceFlow_SubProcess3" name="Valid Vendor" sourceRef="ExclusiveGateway_SubProcess" targetRef="EndEvent_SubProcess">
        <bpmn:conditionExpression xsi:type="tFormalExpression">${vendorValid == true}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>

      <bpmn:sequenceFlow id="SequenceFlow_SubProcess4" name="Invalid Vendor, Choose Another" sourceRef="ExclusiveGateway_SubProcess" targetRef="Task_ChooseDifferentVendor">
        <bpmn:conditionExpression xsi:type="tFormalExpression">${vendorValid == false}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>

      <bpmn:endEvent id="EndEvent_SubProcess">
        <bpmn:incoming>SequenceFlow_SubProcess3</bpmn:incoming>
      </bpmn:endEvent>

    </bpmn:subProcess>

    <bpmn:sequenceFlow id="SequenceFlow6" sourceRef="Task_PurchaseDepartment" targetRef="SubProcess_QuotationAndVendorSelection"/>
    <bpmn:sequenceFlow id="SequenceFlow7" sourceRef="SubProcess_QuotationAndVendorSelection" targetRef="ExclusiveGateway2"/>

    <bpmn:exclusiveGateway id="ExclusiveGateway2">
      <bpmn:incoming>SequenceFlow7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow8</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="SequenceFlow8" sourceRef="ExclusiveGateway2" targetRef="Task_GeneratePurchaseOrder"/>

    <bpmn:task id="Task_GeneratePurchaseOrder" name="Generate and Send Purchase Order">
      <bpmn:incoming>SequenceFlow8</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow10</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow10" sourceRef="Task_GeneratePurchaseOrder" targetRef="EndEvent_ProcessComplete"/>

    <bpmn:endEvent id="EndEvent_Reject" name="Request Rejected">
      <bpmn:incoming>SequenceFlow4</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:task id="Task_SendChangeRequestBackToEmployee" name="Send Change Request Back to Employee">
      <bpmn:incoming>SequenceFlow5</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow11</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow11" sourceRef="Task_SendChangeRequestBackToEmployee" targetRef="EndEvent_ProcessComplete"/>

    <bpmn:endEvent id="EndEvent_ProcessComplete">
      <bpmn:incoming>SequenceFlow10</bpmn:incoming>
      <bpmn:incoming>SequenceFlow11</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>

</bpmn:definitions>