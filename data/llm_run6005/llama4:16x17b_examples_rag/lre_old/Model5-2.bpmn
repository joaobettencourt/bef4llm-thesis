<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">

   <process id="vacationRequestProcess" name="Vacation Request Process" isExecutable="true">
     <laneSet>
       <lane id="employeeLane" name="Employee">
         <flowNodeRef>startEvent</flowNodeRef>
         <flowNodeRef>task_SubmitRequest</flowNodeRef>
         <flowNodeRef>task_ReviewRejection</flowNodeRef>
       </lane>
       <lane id="supervisorLane" name="Supervisor">
         <flowNodeRef>task_ApproveOrReject</flowNodeRef>
         <flowNodeRef>exclusiveGateway_ApprovalDecision</flowNodeRef>
       </lane>
       <lane id="humanResourcesLane" name="Human Resources">
         <flowNodeRef>task_ManageRequest</flowNodeRef>
       </lane>
     </laneSet>

     <startEvent id="startEvent" name="Vacation Request Submitted">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent" targetRef="task_SubmitRequest"/>

     <task id="task_SubmitRequest" name="Submit Vacation Request">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow2" sourceRef="task_SubmitRequest" targetRef="task_ApproveOrReject"/>

     <task id="task_ApproveOrReject" name="Approve or Reject Request">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
       <outgoing>sequenceFlow4</outgoing>
     </task>

     <exclusiveGateway id="exclusiveGateway_ApprovalDecision" name="Request Approved?">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow5</outgoing>
       <outgoing>sequenceFlow6</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow3" sourceRef="task_ApproveOrReject" targetRef="exclusiveGateway_ApprovalDecision"/>

     <sequenceFlow id="sequenceFlow4" name="Rejected" sourceRef="task_ApproveOrReject" targetRef="task_ReviewRejection">
       <conditionExpression xsi:type="tFormalExpression">${approvalStatus  ==  'rejected'}</conditionExpression>
     </sequenceFlow>

     <task id="task_ReviewRejection" name="Review Rejection Reasons">
       <incoming>sequenceFlow4</incoming>
     </task>

     <sequenceFlow id="sequenceFlow5" name="Approved" sourceRef="exclusiveGateway_ApprovalDecision" targetRef="task_ManageRequest">
       <conditionExpression xsi:type="tFormalExpression">${approvalStatus  ==  'approved'}</conditionExpression>
     </sequenceFlow>

     <task id="task_ManageRequest" name="Complete Management Procedures">
       <incoming>sequenceFlow5</incoming>
     </task>

     <endEvent id="endEvent_ApprovalDecision" name="End of Process">
       <outgoing>sequenceFlow7</outgoing>
     </endEvent>

     <sequenceFlow id="sequenceFlow6" sourceRef="exclusiveGateway_ApprovalDecision" targetRef="endEvent_ApprovalDecision"/>

   </process>

</definitions>