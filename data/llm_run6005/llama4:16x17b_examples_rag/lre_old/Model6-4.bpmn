<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://bpmn.io/schema/bpmn">
  <process id="CustomerAcquisitionProcess" name="Customer Acquisition Process" isExecutable="true">
    <laneSet>
      <lane id="MarketingStaffLane" name="Marketing Staff">
        <flowNodeRef>DetermineContactDetailsTask</flowNodeRef>
      </lane>
      <lane id="CallCenterStaffLane" name="Call Center Staff">
        <flowNodeRef>CallCustomerTask</flowNodeRef>
        <flowNodeRef>InterestedGateway</flowNodeRef>
      </lane>
      <lane id="SalesRepresentativePreSalesEmployeeLane" name="Sales Representative/Pre- Sales Employee">
        <flowNodeRef>OnlinePresentationTask</flowNodeRef>
      </lane>
      <lane id="HeadOfDevelopmentLane" name="Head of Development">
        <flowNodeRef>AcquireCustomerTask</flowNodeRef>
      </lane>
    </laneSet>

    <startEvent id="StartEvent">
      <outgoing>SequenceFlow1</outgoing>
    </startEvent>

    <sequenceFlow id="SequenceFlow1" sourceRef="StartEvent" targetRef="DetermineContactDetailsTask"/>

    <task id="DetermineContactDetailsTask">
      <incoming>SequenceFlow1</incoming>
      <outgoing>SequenceFlow2</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow2" sourceRef="DetermineContactDetailsTask" targetRef="ExclusiveGateway_ContactApproach"/>

    <exclusiveGateway id="ExclusiveGateway_ContactApproach">
      <incoming>SequenceFlow2</incoming>
      <outgoing>BuyApproachSequenceFlow</outgoing>
      <outgoing>ExhibitionApproachSequenceFlow</outgoing>
      <outgoing>KnowSomebodyApproachSequenceFlow</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="BuyApproachSequenceFlow" sourceRef="ExclusiveGateway_ContactApproach" targetRef="CallCustomerTask">
      <conditionExpression xsi:type="tFormalExpression">${approach == 'buy'}</conditionExpression>
    </sequenceFlow>

    <task id="CallCustomerTask">
      <incoming>BuyApproachSequenceFlow</incoming>
      <outgoing>SequenceFlow3</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow3" sourceRef="CallCustomerTask" targetRef="InterestedGateway"/>

    <exclusiveGateway id="InterestedGateway">
      <incoming>SequenceFlow3</incoming>
      <outgoing>InterestedSequenceFlow</outgoing>
      <outgoing>NotInterestedSequenceFlow</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="InterestedSequenceFlow" sourceRef="InterestedGateway" targetRef="OnlinePresentationTask">
      <conditionExpression xsi:type="tFormalExpression">${isInterested == true}</conditionExpression>
    </sequenceFlow>

    <task id="OnlinePresentationTask">
      <incoming>InterestedSequenceFlow</incoming>
      <outgoing>WaitForResponseSequenceFlow</outgoing>
    </task>

    <sequenceFlow id="WaitForResponseSequenceFlow" sourceRef="OnlinePresentationTask" targetRef="FollowUpTask"/>

    <task id="FollowUpTask">
      <incoming>WaitForResponseSequenceFlow</incoming>
      <outgoing>SendQuotationSequenceFlow</outgoing>
    </task>

    <sequenceFlow id="SendQuotationSequenceFlow" sourceRef="FollowUpTask" targetRef="EndEvent"/>

    <endEvent id="EndEvent">
      <incoming>SendQuotationSequenceFlow</incoming>
    </endEvent>

  </process>
</definitions>