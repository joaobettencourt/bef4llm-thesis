<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd" 
             id="definition" targetNamespace="http://bpmn.io/schema/bpmn">
   <process id="GoingPublicProcess" name="Going Public Process" isExecutable="true">
     <startEvent id="StartEvent1" name="Decision to Go Public">
       <outgoing>SequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow1" sourceRef="StartEvent1" targetRef="Task_SelectUnderwriters"/>

     <task id="Task_SelectUnderwriters" name="Select Underwriters">
       <incoming>SequenceFlow1</incoming>
       <outgoing>SequenceFlow2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow2" sourceRef="Task_SelectUnderwriters" targetRef="Task_RegisterWithSEC"/>

     <task id="Task_RegisterWithSEC" name="Prepare Registration Statement">
       <incoming>SequenceFlow2</incoming>
       <outgoing>SequenceFlow3</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow3" sourceRef="Task_RegisterWithSEC" targetRef="ExclusiveGateway1"/>

     <exclusiveGateway id="ExclusiveGateway1">
       <incoming>SequenceFlow3</incoming>
       <outgoing>SequenceFlow4</outgoing>
       <outgoing>SequenceFlow5</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow4" sourceRef="ExclusiveGateway1" targetRef="Task_FirmUpIssuePrice">
       <conditionExpression xsi:type="tFormalExpression">${registrationApproved  == true}</conditionExpression>
     </sequenceFlow>

     <task id="Task_FirmUpIssuePrice" name="Firm Up Issue Price and arrange road show ">
       <incoming>SequenceFlow4</incoming>
       <outgoing>SequenceFlow6</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow5" sourceRef="ExclusiveGateway1" targetRef="EndEvent_RegistrationDenied">
       <conditionExpression xsi:type="tFormalExpression">${registrationApproved  == false}</conditionExpression>
     </sequenceFlow>

     <endEvent id="EndEvent_RegistrationDenied" name="Registration Denied">
       <incoming>SequenceFlow5</incoming>
     </endEvent>

     <sequenceFlow id="SequenceFlow6" sourceRef="Task_FirmUpIssuePrice" targetRef="IntermediateCatchEvent1"/>

     <intermediateCatchEvent id="IntermediateCatchEvent1">
       <incoming>SequenceFlow6</incoming>
       <outgoing>SequenceFlow7</outgoing>
       <timerEventDefinition/>
     </intermediateCatchEvent>

     <sequenceFlow id="SequenceFlow7" sourceRef="IntermediateCatchEvent1" targetRef="ExclusiveGateway2"/>

     <exclusiveGateway id="ExclusiveGateway2">
       <incoming>SequenceFlow7</incoming>
       <outgoing>SequenceFlow8</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow8" sourceRef="ExclusiveGateway2" targetRef="Task_BuyStock"/>

     <task id="Task_BuyStock" name="Buy Stock and Fix Issue Price">
       <incoming>SequenceFlow8</incoming>
       <outgoing>SequenceFlow9</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow9" sourceRef="Task_BuyStock" targetRef="EndEvent_ProcessCompleted"/>

     <endEvent id="EndEvent_ProcessCompleted" name="Process Completed">
       <incoming>SequenceFlow9</incoming>
     </endEvent>
   </process>
 </definitions>