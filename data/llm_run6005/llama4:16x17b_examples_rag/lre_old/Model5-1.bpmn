<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="Definitions" targetNamespace="http://www.example.com">

   <process id="LoanApprovalProcess" name="Loan Approval Process" isExecutable="true">
     <startEvent id="StartEvent1">
       <outgoing>SequenceFlow1</outgoing>
       <messageEventDefinition/>
     </startEvent>

     <sequenceFlow id="SequenceFlow1" sourceRef="StartEvent1" targetRef="Task_RiskAssessment"/>

     <task id="Task_RiskAssessment" name="Invoke Risk Assessment Web Service">
       <incoming>SequenceFlow1</incoming>
       <outgoing>SequenceFlow2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow2" sourceRef="Task_RiskAssessment" targetRef="ExclusiveGateway_AssessRisk"/>

     <exclusiveGateway id="ExclusiveGateway_AssessRisk">
       <incoming>SequenceFlow2</incoming>
       <outgoing>SequenceFlow3</outgoing>
       <outgoing>SequenceFlow4</outgoing>
       <outgoing>SequenceFlow5</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow3" sourceRef="ExclusiveGateway_AssessRisk" targetRef="EndEvent1">
       <conditionExpression xsi:type="tFormalExpression">${riskLevel == 'low' and loanAmount < 10000}</conditionExpression>
     </sequenceFlow>

     <endEvent id="EndEvent1" name="Loan Approved">
       <incoming>SequenceFlow3</incoming>
       <messageEventDefinition/>
     </endEvent>

     <sequenceFlow id="SequenceFlow4" sourceRef="ExclusiveGateway_AssessRisk" targetRef="EndEvent2">
       <conditionExpression xsi:type="tFormalExpression">${riskLevel == 'high'}</conditionExpression>
     </sequenceFlow>

     <endEvent id="EndEvent2" name="Loan Denied">
       <incoming>SequenceFlow4</incomings</incoming>
       <messageEventDefinition/>
     </endEvent>

     <sequenceFlow id="SequenceFlow5" sourceRef="ExclusiveGateway_AssessRisk" targetRef="Task_RequestApproval"/>

     <task id="Task_RequestApproval" name="Invoke Approver Web Service">
       <incoming>SequenceFlow5</incoming>
       <outgoing>SequenceFlow6</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow6" sourceRef="Task_RequestApproval" targetRef="EndEvent3"/>

     <endEvent id="EndEvent3" name="Feedback Sent to Customer">
       <incoming>SequenceFlow6</incoming>
       <messageEventDefinition/>
     </endEvent>
   </process>

</definitions>