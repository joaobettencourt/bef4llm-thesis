<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
                  id="definitions" targetNamespace="http://www.example.com">

  <bpmn:process id="orderProcess" name="Periodic Order Process" isExecutable="true">
    <bpmn:startEvent id="startEvent" name="First of Each Month">
      <bpmn:outgoing>sequenceFlow1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:sequenceFlow id="sequenceFlow1" sourceRef="startEvent" targetRef="task_SendOrder"/>

    <bpmn:task id="task_SendOrder" name="Send Order to Supplier">
      <bpmn:incoming>sequenceFlow1</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="sequenceFlow2" sourceRef="task_SendOrder" targetRef="task_ProcessOrder"/>

    <bpmn:task id="task_ProcessOrder" name="Supplier Process Order">
      <bpmn:incoming>sequenceFlow2</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow3</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="sequenceFlow3" sourceRef="task_ProcessOrder" targetRef="task_SendInvoice"/>

    <bpmn:task id="task_SendInvoice" name="Send Invoice to Assembler AG">
      <bpmn:incoming>sequenceFlow3</bpmn:incoming>
    </bpmn:task>

    <bpmn:endEvent id="endEvent" name="Order Process Completed">
      <bpmn:incoming>sequenceFlow3</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>

</bpmn:definitions>