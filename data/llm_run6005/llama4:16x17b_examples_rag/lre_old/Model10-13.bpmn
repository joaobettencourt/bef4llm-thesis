<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="Definitions" targetNamespace="http://www.example.com">

   <collaboration id="Collaboration">
     <participant id="INQ" name="INQ" processRef="Process_INQ"/>
     <participant id="IP" name="IP" processRef="Process_IP"/>
     <messageFlow id="MessageFlow_1" sourceRef="Task_TransmitDataRequest" targetRef="StartEvent_CheckRequest"/>
   </collaboration>

   <process id="Process_INQ" isExecutable="true">
     <laneSet>
       <lane id="Lane_INQ" name="INQ">
         <flowNodeRef>StartEvent</flowNodeRef>
         <flowNodeRef>Task_TransmitDataRequest</flowNodeRef>
         <flowNodeRef>Gateway_Decision</flowNodeRef>
         <flowNodeRef>EndEvent_DataReceived</flowNodeRef>
         <flowNodeRef>EndEvent_DataRejected</flowNodeRef>
       </lane>
     </laneSet>

     <startEvent id="StartEvent" name="Begin Process">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <task id="Task_TransmitDataRequest" name="Transmit Data Request">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent" targetRef="Task_TransmitDataRequest"/>

     <gateway id="Gateway_Decision" name="Decision Gateway">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_4</outgoing>
     </gateway>

     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_TransmitDataRequest" targetRef="Gateway_Decision"/>

     <exclusiveGateway id="Exclusive_Gateway_Accepted">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_Accepted</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_3" sourceRef="Gateway_Decision" targetRef="Exclusive_Gateway_Accepted"/>

     <endEvent id="EndEvent_DataReceived" name="Data Received">
       <incoming>SequenceFlow_Accepted</incoming>
     </endEvent>

     <sequenceFlow id="SequenceFlow_Accepted" sourceRef="Exclusive_Gateway_Accepted" targetRef="EndEvent_DataReceived"/>

     <exclusiveGateway id="Exclusive_Gateway_Rejected">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_Rejected</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_4" sourceRef="Gateway_Decision" targetRef="Exclusive_Gateway_Rejected"/>

     <endEvent id="EndEvent_DataRejected" name="Data Rejected">
       <incoming>SequenceFlow_Rejected</incoming>
     </endEvent>

     <sequenceFlow id="SequenceFlow_Rejected" sourceRef="Exclusive_Gateway_Rejected" targetRef="EndEvent_DataRejected"/>
   </process>

   <process id="Process_IP" isExecutable="true">
     <laneSet>
       <lane id="Lane_IP" name="IP">
         <flowNodeRef>StartEvent_CheckRequest</flowNodeRef>
         <flowNodeRef>Task_CheckData</flowNodeRef>
         <flowNodeRef>Gateway_IPDecision</flowNodeRef>
         <flowNodeRef>EndEvent_DataSent</flowNodeRef>
         <flowNodeRef>EndEvent_RequestRejected</flowNodeRef>
       </lane>
     </laneSet>

     <startEvent id="StartEvent_CheckRequest" name="Check Request">
       <incoming>MessageFlow_1</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </startEvent>

     <task id="Task_CheckData" name="Check Data">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_5" sourceRef="StartEvent_CheckRequest" targetRef="Task_CheckData"/>

     <gateway id="Gateway_IPDecision" name="IP Decision Gateway">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_7</outgoing>
       <outgoing>SequenceFlow_8</outgoing>
     </gateway>

     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_CheckData" targetRef="Gateway_IPDecision"/>

     <exclusiveGateway id="Exclusive_Gateway_Accept">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_DataAccepted</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_7" sourceRef="Gateway_IPDecision" targetRef="Exclusive_Gateway_Accept"/>

     <endEvent id="EndEvent_DataSent" name="Data Sent">
       <incoming>SequenceFlow_DataAccepted</incoming>
     </endEvent>

     <sequenceFlow id="SequenceFlow_DataAccepted" sourceRef="Exclusive_Gateway_Accept" targetRef="EndEvent_DataSent"/>

     <exclusiveGateway id="Exclusive_Gateway_Reject">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_RequestRejected</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_8" sourceRef="Gateway_IPDecision" targetRef="Exclusive_Gateway_Reject"/>

     <endEvent id="EndEvent_RequestRejected" name="Request Rejected">
       <incoming>SequenceFlow_RequestRejected</incoming>
     </endEvent>

     <sequenceFlow id="SequenceFlow_RequestRejected" sourceRef="Exclusive_Gateway_Reject" targetRef="EndEvent_RequestRejected"/>
   </process>
</definitions>