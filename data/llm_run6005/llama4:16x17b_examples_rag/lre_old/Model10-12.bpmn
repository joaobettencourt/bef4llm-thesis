<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
                 id="definitions" targetNamespace="http://www.example.com">

  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="Participant_EC" name="EC" processRef="Process_EC"/>
    <bpmn:participant id="Participant_INQ" name="INQ" processRef="Process_INQ"/>
    <bpmn:participant id="Participant_IP" name="IP" processRef="Process_IP"/>
    <bpmn:messageFlow id="MessageFlow_1" sourceRef="Task_EC_Notify_INQ" targetRef="StartEvent_INQ"/>
    <bpmn:messageFlow id="MessageFlow_2" sourceRef="Task_INQ_Notify_IP" targetRef="StartEvent_IP"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_EC">
    <bpmn:startEvent id="StartEvent_EC">
      <bpmn:outgoing>SequenceFlow_EC_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="SequenceFlow_EC_1" sourceRef="StartEvent_EC" targetRef="Task_EC_Notify_INQ"/>
    <bpmn:task id="Task_EC_Notify_INQ">
      <bpmn:incoming>SequenceFlow_EC_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EC_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_EC">
      <bpmn:incoming>SequenceFlow_EC_2</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>

  <bpmn:process id="Process_INQ" isExecutable="false">
    <bpmn:startEvent id="StartEvent_INQ">
      <bpmn:incoming messageRef="MessageFlow_1"/>
      <bpmn:outgoing>SequenceFlow_INQ_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="SequenceFlow_INQ_1" sourceRef="StartEvent_INQ" targetRef="Task_INQ_Notify_IP"/>
    <bpmn:task id="Task_INQ_Notify_IP">
      <bpmn:incoming>SequenceFlow_INQ_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_INQ_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_INQ">
      <bpmn:incoming>SequenceFlow_INQ_2</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>

  <bpmn:process id="Process_IP" isExecutable="false">
    <bpmn:startEvent id="StartEvent_IP">
      <bpmn:incoming messageRef="MessageFlow_2"/>
      <bpmn:outgoing>SequenceFlow_IP_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="SequenceFlow_IP_1" sourceRef="StartEvent_IP" targetRef="Task_IP_Check_Master_Data"/>
    <bpmn:task id="Task_IP_Check_Master_Data">
      <bpmn:incoming>SequenceFlow_IP_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_IP_2</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_IP_3</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Exclusive_Gateway"/>
    <sequenceFlow id="SequenceFlow_IP_2" sourceRef="Task_IP_Check_Master_Data" targetRef="Exclusive_Gateway">
      <conditionExpression xsi:type="tFormalExpression">${canChange  == true}</conditionExpression>
    </sequenceFlow>

    <bpmn:task id="Task_IP_Confirm_Changes">
      <bpmn:incoming>SequenceFlow_IP_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_IP_5</bpmn:outgoing>
    </bpmn:task>
    <sequenceFlow id="SequenceFlow_IP_4" sourceRef="Exclusive_Gateway" targetRef="Task_IP_Confirm_Changes"/>
    <bpmn:endEvent id="EndEvent_IP_Confirmed">
      <bpmn:incoming>SequenceFlow_IP_5</bpmn:incoming>
    </bpmn:endEvent>

    <sequenceFlow id="SequenceFlow_IP_3" sourceRef="Task_IP_Check_Master_Data" targetRef="Exclusive_Gateway">
      <conditionExpression xsi:type="tFormalExpression">${canChange  == false}</conditionExpression>
    </sequenceFlow>

    <bpmn:task id="Task_IP_Reject_Changes">
      <bpmn:incoming>SequenceFlow_IP_6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_IP_7</bpmn:outgoing>
    </bpmn:task>
    <sequenceFlow id="SequenceFlow_IP_6" sourceRef="Exclusive_Gateway" targetRef="Task_IP_Reject_Changes"/>
    <bpmn:endEvent id="EndEvent_IP_Rejected">
      <bpmn:incoming>SequenceFlow_IP_7</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>

</bpmn:definitions>