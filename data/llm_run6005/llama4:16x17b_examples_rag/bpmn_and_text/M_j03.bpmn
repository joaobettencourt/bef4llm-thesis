<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/25/BPMN20.xsd"
             id="definitions" targetNamespace="http://bpmn.io/schema/bpmn">
   <collaboration id="Collaboration_1">
     <participant id="Participant_1" name="Contract Project" processRef="Process_1"/>
   </collaboration>
   <process id="Process_1" isExecutable="true">
     <laneSet id="LaneSet_1">
       <lane id="Lane_1" name="Procurement">
         <flowNodeRef>Task_0</flowNodeRef>
         <flowNodeRef>ExclusiveGateway_0</flowNodeRef>
         <flowNodeRef>Task_7</flowNodeRef>
       </lane>
       <lane id="Lane_2" name="Production">
         <flowNodeRef>Task_5</flowNodeRef>
         <flowNodeRef>Task_10</flowNodeRef>
         <flowNodeRef>ExclusiveGateway_1</flowNodeRef>
         <flowNodeRef>ExclusiveGateway_2</flowNodeRef>
       </lane>
     </laneSet>
     <startEvent id="StartEvent_1" name="Receive Parts Order">
       <outgoing>SequenceFlow_0</outgoing>
     </startEvent>
     <sequenceFlow id="SequenceFlow_0" sourceRef="StartEvent_1" targetRef="Task_0"/>
     <task id="Task_0" name="Query Web Shops for Parts">
       <incoming>SequenceFlow_0</incoming>
       <outgoing>SequenceFlow_1</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_1" sourceRef="Task_0" targetRef="ExclusiveGateway_0"/>
     <exclusiveGateway id="ExclusiveGateway_0">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
       <outgoing>SequenceFlow_3</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_2" name="Enough Parts Available" sourceRef="ExclusiveGateway_0" targetRef="Task_5"/>
     <task id="Task_5" name="Receive Parts">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_4</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_4" sourceRef="Task_5" targetRef="EndEvent_1"/>
     <endEvent id="EndEvent_1" name="Parts Received">
       <incoming>SequenceFlow_4</incoming>
     </endEvent>
     <sequenceFlow id="SequenceFlow_3" name="Not Enough Parts Available" sourceRef="ExclusiveGateway_0" targetRef="Task_7"/>
     <task id="Task_7" name="Order Additional Parts from Cheapest Web Shop">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_7" targetRef="IntermediateCatchEvent_1"/>
     <intermediateCatchEvent id="IntermediateCatchEvent_1">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </intermediateCatchEvent>
     <sequenceFlow id="SequenceFlow_6" sourceRef="IntermediateCatchEvent_1" targetRef="Task_10"/>
     <task id="Task_10" name="Build Product">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_7</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_7" sourceRef="Task_10" targetRef="ExclusiveGateway_1"/>
     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_8</outgoing>
       <outgoing>SequenceFlow_9</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_8" name="Stock Level Below 5" sourceRef="ExclusiveGateway_1" targetRef="Task_11"/>
     <task id="Task_11" name="Reorder Parts (Cheapest)">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_10</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_10" sourceRef="Task_11" targetRef="ExclusiveGateway_1"/>
     <sequenceFlow id="SequenceFlow_9" name="Stock Level Below 3" sourceRef="ExclusiveGateway_1" targetRef="Task_12"/>
     <task id="Task_12" name="Reorder Parts (Fastest)">
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_11</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_11" sourceRef="Task_12" targetRef="ExclusiveGateway_2"/>
     <exclusiveGateway id="ExclusiveGateway_2">
       <incoming>SequenceFlow_11</incoming>
       <outgoing>SequenceFlow_12</outgoing>
       <outgoing>SequenceFlow_13</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_12" name="Stock Level Zero" sourceRef="ExclusiveGateway_2" targetRef="Task_14"/>
     <task id="Task_14" name="Send Mail to Friends">
       <incoming>SequenceFlow_12</incoming>
       <outgoing>SequenceFlow_14</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_14" sourceRef="Task_14" targetRef="EndEvent_2"/>
     <endEvent id="EndEvent_2" name="Mail Sent">
       <incoming>SequenceFlow_14</incoming>
     </endEvent>
     <sequenceFlow id="SequenceFlow_13" sourceRef="ExclusiveGateway_2" targetRef="Task_10"/>
   </process>
</definitions>