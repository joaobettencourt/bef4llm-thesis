<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com/bpmn">
  <collaboration id="collaboration">
    <participant id="participant" name="Tree House Builder" processRef="process"/>
  </collaboration>
  <process id="process" isExecutable="true">
    <laneSet id="laneSet">
      <lane id="lane"/>
    </laneSet>
    <startEvent id="startEvent">
      <outgoing>sequenceFlow1</outgoing>
    </startEvent>
    <task id="collectRequirements">
      <incoming>sequenceFlow1</incoming>
      <outgoing>sequenceFlow2</outgoing>
    </task>
    <sequenceFlow id="sequenceFlow1" sourceRef="startEvent" targetRef="collectRequirements"/>
    <sequenceFlow id="sequenceFlow2" sourceRef="collectRequirements" targetRef="sendRequirementsToArchitect"/>
    <task id="sendRequirementsToArchitect">
      <incoming>sequenceFlow2</incoming>
      <outgoing>sequenceFlow3</outgoing>
    </task>
    <sequenceFlow id="sequenceFlow3" sourceRef="sendRequirementsToArchitect" targetRef="receiveDraftFromArchitect"/>
    <task id="receiveDraftFromArchitect">
      <incoming>sequenceFlow3</incoming>
      <outgoing>sequenceFlow4</outgoing>
    </task>
    <sequenceFlow id="sequenceFlow4" sourceRef="receiveDraftFromArchitect" targetRef="refineRequirements"/>
    <task id="refineRequirements">
      <incoming>sequenceFlow4</incoming>
      <outgoing>sequenceFlow5</outgoing>
    </task>
    <sequenceFlow id="sequenceFlow5" sourceRef="refineRequirements" targetRef="createListOfNeededMaterials"/>
    <task id="createListOfNeededMaterials">
      <incoming>sequenceFlow5</incoming>
      <outgoing>sequenceFlow6</outgoing>
    </task>
    <sequenceFlow id="sequenceFlow6" sourceRef="createListOfNeededMaterials" targetRef="parallelGateway"/>
    <parallelGateway id="parallelGateway">
      <incoming>sequenceFlow6</incoming>
      <outgoing>sequenceFlow7</outgoing>
      <outgoing>sequenceFlow8</outgoing>
    </parallelGateway>
    <sequenceFlow id="sequenceFlow7" sourceRef="parallelGateway" targetRef="orderMaterialsFromOnlineStores"/>
    <task id="orderMaterialsFromOnlineStores">
      <incoming>sequenceFlow7</incoming>
      <outgoing>sequenceFlow9</outgoing>
    </task>
    <sequenceFlow id="sequenceFlow8" sourceRef="parallelGateway" targetRef="sendMessagesToFriends"/>
    <task id="sendMessagesToFriends">
      <incoming>sequenceFlow8</incoming>
      <outgoing>sequenceFlow10</outgoing>
    </task>
    <sequenceFlow id="sequenceFlow9" sourceRef="orderMaterialsFromOnlineStores" targetRef="exclusiveGateway"/>
    <exclusiveGateway id="exclusiveGateway">
      <incoming>sequenceFlow9</incoming>
      <outgoing>sequenceFlow11</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="sequenceFlow10" sourceRef="sendMessagesToFriends" targetRef="houseBuilt"/>
    <endEvent id="houseBuilt">
      <incoming>sequenceFlow10</incoming>
    </endEvent>
    <sequenceFlow id="sequenceFlow11" sourceRef="exclusiveGateway" targetRef="createGuestListForParty"/>
    <task id="createGuestListForParty">
      <incoming>sequenceFlow11</incoming>
    </task>
  </process>
</definitions>