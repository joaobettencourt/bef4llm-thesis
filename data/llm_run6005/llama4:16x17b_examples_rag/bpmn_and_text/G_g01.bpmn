<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com/bpmn">
  <process id="lanPartyProcess" isExecutable="true">
    <startEvent id="startEvent">
      <outgoing>sequenceFlow1</outgoing>
    </startEvent>
    <task id="sendInvitations">
      <incoming>sequenceFlow1</incoming>
      <outgoing>sequenceFlow2</outgoing>
    </task>
    <sequenceFlow id="sequenceFlow1" sourceRef="startEvent" targetRef="sendInvitations"/>
    <sequenceFlow id="sequenceFlow2" sourceRef="sendInvitations" targetRef="getGamesList"/>
    <task id="getGamesList">
      <incoming>sequenceFlow2</incoming>
      <outgoing>sequenceFlow3</outgoing>
    </task>
    <exclusiveGateway id="appointDateGateway">
      <incoming>sequenceFlow3</incoming>
      <outgoing>sequenceFlow4</outgoing>
      <outgoing>sequenceFlow5</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="sequenceFlow3" sourceRef="getGamesList" targetRef="appointDateGateway"/>
    <sequenceFlow id="sequenceFlow4" name="8 or more agree" sourceRef="appointDateGateway" targetRef="findGamesTask"/>
    <task id="findGamesTask">
      <incoming>sequenceFlow4</incoming>
      <outgoing>sequenceFlow6</outgoing>
    </task>
    <sequenceFlow id="sequenceFlow5" name="Less than 8 agree" sourceRef="appointDateGateway" targetRef="appointDateGateway"/>
    <task id="downloadGamesTask">
      <incoming>sequenceFlow6</incoming>
      <outgoing>sequenceFlow7</outgoing>
    </task>
    <sequenceFlow id="sequenceFlow6" sourceRef="findGamesTask" targetRef="downloadGamesTask">
      <conditionExpression xsi:type="tFormalExpression">${gamesAvailable} = false</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="sequenceFlow7" sourceRef="downloadGamesTask" targetRef="buyBeerTask"/>
    <task id="buyBeerTask">
      <incoming>sequenceFlow7</incoming>
      <outgoing>sequenceFlow8</outgoing>
    </task>
    <sequenceFlow id="sequenceFlow8" sourceRef="buyBeerTask" targetRef="lanPartyStartsEvent"/>
    <endEvent id="lanPartyStartsEvent">
      <incoming>sequenceFlow8</incoming>
    </endEvent>
  </process>
</definitions>