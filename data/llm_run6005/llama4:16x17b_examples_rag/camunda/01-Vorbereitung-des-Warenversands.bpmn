<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" 
             targetNamespace="http://bpmn.io/schema/bpmn">
  <collaboration id="Collaboration_1">
    <participant id="Participant_1" name="Dispatch of goods&#10;Computer Hardware Shop" processRef="Process_1"/>
  </collaboration>
  <process id="Process_1" isExecutable="true">
    <laneSet id="LaneSet_1">
      <lane id="Lane_1" name="Secretariat">
        <flowNodeRef>StartEvent_1</flowNodeRef>
        <flowNodeRef>Task_0vaxgaa</flowNodeRef>
        <flowNodeRef>Task_0e6hvnj</flowNodeRef>
        <flowNodeRef>Task_0s79ile</flowNodeRef>
        <flowNodeRef>InclusiveGateway_1</flowNodeRef>
      </lane>
      <lane id="Lane_2" name="Logistics">
        <flowNodeRef>Task_12j0pib</flowNodeRef>
      </lane>
      <lane id="Lane_3" name="Warehouse">
        <flowNodeRef>Task_05ftug5</flowNodeRef>
        <flowNodeRef>ExclusiveGateway_1</flowNodeRef>
        <flowNodeRef>EndEvent_1</flowNodeRef>
      </lane>
    </laneSet>

    <startEvent id="StartEvent_1" name="Ship goods">
      <outgoing>SequenceFlow_14a0oky</outgoing>
    </startEvent>

    <parallelGateway id="ParallelGateway_1">
      <incoming>SequenceFlow_14a0oky</incoming>
      <outgoing>SequenceFlow_023hzxi</outgoing>
      <outgoing>SequenceFlow_1ujhfx4</outgoing>
    </parallelGateway>

    <sequenceFlow id="SequenceFlow_14a0oky" sourceRef="StartEvent_1" targetRef="ParallelGateway_1"/>

    <task id="Task_0vaxgaa" name="Clarify shipment method">
      <incoming>SequenceFlow_023hzxi</incoming>
      <outgoing>SequenceFlow_1rss71o</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_023hzxi" sourceRef="ParallelGateway_1" targetRef="Task_0vaxgaa"/>

    <exclusiveGateway id="ExclusiveGateway_1" name="Special&#10;handling?">
      <incoming>SequenceFlow_1rss71o</incoming>
      <outgoing>SequenceFlow_1xv6wk4</outgoing>
      <outgoing>SequenceFlow_0iu9po7</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow_1rss71o" sourceRef="Task_0vaxgaa" targetRef="ExclusiveGateway_1"/>

    <task id="Task_0e6hvnj" name="Get 3 offers&#10;from logistic&#10;companies">
      <incoming>SequenceFlow_1xv6wk4</incoming>
      <outgoing>SequenceFlow_1pq8ub3</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_1xv6wk4" sourceRef="ExclusiveGateway_1" targetRef="Task_0e6hvnj"/>

    <task id="Task_0s79ile" name="Select logistic&#10;company and&#10;place order">
      <incoming>SequenceFlow_1pq8ub3</incoming>
      <outgoing>SequenceFlow_0ajhekx</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_1pq8ub3" sourceRef="Task_0e6hvnj" targetRef="Task_0s79ile"/>

    <inclusiveGateway id="InclusiveGateway_1">
      <incoming>SequenceFlow_0ajhekx</incoming>
      <outgoing>SequenceFlow_035vf60</outgoing>
    </inclusiveGateway>

    <sequenceFlow id="SequenceFlow_0ajhekx" sourceRef="Task_0s79ile" targetRef="InclusiveGateway_1"/>

    <task id="Task_12j0pib" name="Insure parcel">
      <incoming>SequenceFlow_035vf60</incoming>
      <outgoing>SequenceFlow_0kz5g1t</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_035vf60" sourceRef="InclusiveGateway_1" targetRef="Task_12j0pib"/>

    <inclusiveGateway id="InclusiveGateway_2">
      <incoming>SequenceFlow_0kz5g1t</incoming>
      <outgoing>SequenceFlow_06kfaev</outgoing>
    </inclusiveGateway>

    <sequenceFlow id="SequenceFlow_0kz5g1t" sourceRef="Task_12j0pib" targetRef="InclusiveGateway_2"/>

    <task id="Task_05ftug5" name="Package goods">
      <incoming>SequenceFlow_1ujhfx4</incoming>
      <outgoing>SequenceFlow_0b2nw5c</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_1ujhfx4" sourceRef="ParallelGateway_1" targetRef="Task_05ftug5"/>

    <exclusiveGateway id="ExclusiveGateway_2">
      <incoming>SequenceFlow_06kfaev</incoming>
      <incoming>SequenceFlow_0b2nw5c</incoming>
      <outgoing>SequenceFlow_0v64x8b</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow_06kfaev" sourceRef="InclusiveGateway_2" targetRef="ExclusiveGateway_2"/>
    <sequenceFlow id="SequenceFlow_0b2nw5c" sourceRef="Task_05ftug5" targetRef="ExclusiveGateway_2"/>

    <task id="Task_0sl26uo" name="Prepare for&#10;picking up&#10;goods">
      <incoming>SequenceFlow_0v64x8b</incoming>
    </task>

    <sequenceFlow id="SequenceFlow_0v64x8b" sourceRef="ExclusiveGateway_2" targetRef="Task_0sl26uo"/>

    <endEvent id="EndEvent_1" name="Shipment&#10;prepared">
      <incoming>SequenceFlow_0iu9po7</incoming>
    </endEvent>

    <sequenceFlow id="SequenceFlow_0iu9po7" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_1"/>
  </process>
</definitions>