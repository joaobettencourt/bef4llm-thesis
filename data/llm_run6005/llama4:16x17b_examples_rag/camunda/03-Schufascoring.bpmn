<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" name="Schufa Scoring Prozess">

  <collaboration id="Collaboration">
    <participant id="Participant" processRef="Process"/>
  </collaboration>

  <process id="Process" isExecutable="true">
    <laneSet>
      <lane id="Lane">
        <flowNodeRef>StartEvent</flowNodeRef>
        <flowNodeRef>ExclusiveGateway</flowNodeRef>
        <flowNodeRef>ServiceTask</flowNodeRef>
        <flowNodeRef>IntermediateCatchEvent</flowNodeRef>
        <flowNodeRef>ServiceTask2</flowNodeRef>
        <flowNodeRef>EndEvent</flowNodeRef>
      </lane>
    </laneSet>

    <startEvent id="StartEvent">
      <outgoing>SequenceFlow1</outgoing>
    </startEvent>

    <sequenceFlow id="SequenceFlow1" sourceRef="StartEvent" targetRef="ExclusiveGateway"/>

    <exclusiveGateway id="ExclusiveGateway">
      <incoming>SequenceFlow1</incoming>
      <outgoing>SequenceFlow2</outgoing>
      <outgoing>SequenceFlow3</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow2" name="Direkte Anfrage" sourceRef="ExclusiveGateway" targetRef="ServiceTask"/>

    <sequenceFlow id="SequenceFlow3" name="Verzögerte Antwort" sourceRef="ExclusiveGateway" targetRef="IntermediateCatchEvent"/>

    <serviceTask id="ServiceTask">
      <incoming>SequenceFlow2</incoming>
      <outgoing>SequenceFlow4</outgoing>
    </serviceTask>

    <sequenceFlow id="SequenceFlow4" sourceRef="ServiceTask" targetRef="EndEvent"/>

    <intermediateCatchEvent id="IntermediateCatchEvent">
      <incoming>SequenceFlow3</incoming>
      <outgoing>SequenceFlow5</outgoing>
    </intermediateCatchEvent>

    <sequenceFlow id="SequenceFlow5" sourceRef="IntermediateCatchEvent" targetRef="ServiceTask2"/>

    <serviceTask id="ServiceTask2">
      <incoming>SequenceFlow5</incoming>
      <outgoing>SequenceFlow6</outgoing>
    </serviceTask2>

    <sequenceFlow id="SequenceFlow6" sourceRef="ServiceTask2" targetRef="EndEvent"/>

    <endEvent id="EndEvent"/>
  </process>
</definitions>