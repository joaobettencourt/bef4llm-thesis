<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definitions" targetNamespace="http://bpmn.io/schema/bpmn">
  <collaboration id="Collaboration_1">
    <participant id="Participant_0" name="Recourse Process" processRef="Process_0"/>
  </collaboration>
  <process id="Process_0" isExecutable="false">
    <laneSet>
      <lane id="Lane_0" name="Clerk">
        <flowNodeRef>StartEvent_1</flowNodeRef>
        <flowNodeRef>Task_GetInformation</flowNodeRef>
        <flowNodeRef>ExclusiveGateway_CheckPossibility</flowNodeRef>
        <flowNodeRef>Task_SendRequest</flowNodeRef>
        <flowNodeRef>Task_CreateReminder</flowNodeRef>
        <flowNodeRef>Task_CloseCase</flowNodeRef>
        <flowNodeRef>ExclusiveGateway_Disagreement</flowNodeRef>
        <flowNodeRef>Task_CheckDisagreementReasoning</flowNodeRef>
        <flowNodeRef>ExclusiveGateway_ForwardToCollectionAgency</flowNodeRef>
        <flowNodeRef>Task_MakeBooking</flowNodeRef>
      </lane>
    </laneSet>

    <!-- Sequence Flows  -->
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_GetInformation"/>
    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_GetInformation" targetRef="ExclusiveGateway_CheckPossibility"/>
    <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_CheckPossibility" targetRef="Task_SendRequest"/>
    <sequenceFlow id="SequenceFlow_4" sourceRef="Task_SendRequest" targetRef="Task_CreateReminder"/>
    <sequenceFlow id="SequenceFlow_5" sourceRef="Task_CreateReminder" targetRef="ExclusiveGateway_Disagreement"/>
    <sequenceFlow id="SequenceFlow_6" sourceRef="ExclusiveGateway_CheckPossibility" targetRef="Task_CloseCase"/>
    <sequenceFlow id="SequenceFlow_7" sourceRef="ExclusiveGateway_Disagreement" targetRef="Task_CheckDisagreementReasoning"/>
    <sequenceFlow id="SequenceFlow_8" sourceRef="Task_CheckDisagreementReasoning" targetRef="ExclusiveGateway_ForwardToCollectionAgency"/>
    <sequenceFlow id="SequenceFlow_9" sourceRef="ExclusiveGateway_Disagreement" targetRef="Task_MakeBooking"/>
    <sequenceFlow id="SequenceFlow_10" sourceRef="Task_MakeBooking" targetRef="Task_CloseCase"/>
    <sequenceFlow id="SequenceFlow_11" sourceRef="ExclusiveGateway_ForwardToCollectionAgency" targetRef="Task_CloseCase"/>

    <!-- Flow Elements  -->
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>

    <task id="Task_GetInformation" name="Get Information about Insurant">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </task>

    <exclusiveGateway id="ExclusiveGateway_CheckPossibility" name="Is Recourse Possible?">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
      <outgoing>SequenceFlow_6</outgoing>
    </exclusiveGateway>

    <task id="Task_SendRequest" name="Send Request for Payment">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_4</outgoing>
    </task>

    <task id="Task_CreateReminder" name="Create Reminder">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_5</outgoing>
    </task>

    <exclusiveGateway id="ExclusiveGateway_Disagreement" name="Has Insurant Disagreed?">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_7</outgoing>
      <outgoing>SequenceFlow_9</outgoing>
    </exclusiveGateway>

    <task id="Task_CheckDisagreementReasoning" name="Check Disagreement Reasoning">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </task>

    <exclusiveGateway id="ExclusiveGateway_ForwardToCollectionAgency" name="Should be forwarded to Collection Agency?">
      <incoming>SequenceFlow_8</incoming>
      <outgoing>SequenceFlow_11</outgoing>
    </exclusiveGateway>

    <task id="Task_MakeBooking" name="Make Booking">
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_10</outgoing>
    </task>

    <task id="Task_CloseCase" name="Close Case">
      <incoming>SequenceFlow_6</incoming>
      <incoming>SequenceFlow_10</incoming>
      <incoming>SequenceFlow_11</incoming>
    </task>

  </process>
</definitions>