<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_0">
    <bpmn:participant id="Participant_0" name="Dispatch of goods&#10;Computer Hardware Shop" processRef="Process_1"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_1" name="Secretary">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Logistics Department Head">
        <bpmn:flowNodeRef>Task_4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3" name="Warehousemen">
        <bpmn:flowNodeRef>Task_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Ship goods">
      <bpmn:outgoing>SequenceFlow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="SequenceFlow_0" sourceRef="StartEvent_1" targetRef="Task_0"/>
    <bpmn:userTask id="Task_0" name="Clarify who will do the shipping">
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="Task_0" targetRef="ExclusiveGateway_1"/>
    <bpmn:exclusiveGateway id="ExclusiveGateway_1" name="Special handling?">
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="SequenceFlow_2" name="yes" sourceRef="ExclusiveGateway_1" targetRef="Task_3"/>
    <bpmn:userTask id="Task_3" name="Invite three logistic companies to make offers and select one of them">
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="SequenceFlow_3" name="no" sourceRef="ExclusiveGateway_1" targetRef="InclusiveGateway_1"/>
    <bpmn:inclusiveGateway id="InclusiveGateway_1">
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="Task_3" targetRef="InclusiveGateway_1"/>
    <bpmn:userTask id="Task_2" name="Write package label">
      <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="InclusiveGateway_1" targetRef="Task_2"/>
    <bpmn:task id="Task_4" name="Take parcel insurance if necessary">
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="InclusiveGateway_1" targetRef="Task_4"/>
    <bpmn:sequenceFlow id="SequenceFlow_7" sourceRef="Task_2" targetRef="InclusiveGateway_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_8" sourceRef="Task_4" targetRef="InclusiveGateway_2"/>
    <bpmn:inclusiveGateway id="InclusiveGateway_2">
      <bpmn:incoming>SequenceFlow_7</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_8</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_9</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:task id="Task_5" name="Package goods">
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_9" sourceRef="InclusiveGateway_2" targetRef="Task_5"/>
    <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="Task_5" targetRef="EndEvent_1"/>
    <bpmn:endEvent id="EndEvent_1" name="Shipment prepared">
      <bpmn:incoming>SequenceFlow_10</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>