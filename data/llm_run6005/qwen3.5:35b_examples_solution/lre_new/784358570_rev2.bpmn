<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_1x9k3mz">
  <bpmn:collaboration id="Collaboration_0a8d6h7">
    <bpmn:participant id="Participant_EshopStaff" name="E-shop Staff" processRef="Process_Main"/>
    <bpmn:participant id="Participant_CourierCompany" name="Courier Company" />
  </bpmn:collaboration>

  <bpmn:process id="Process_Main">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_EshopStaff">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CheckStock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformDelay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OrderMissingProducts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CheckDiscontinued</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformUnavailableItems</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateTimerEvent_WaitDelivery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CheckStockAgain</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecollectProducts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PreparePackage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_PackageReady</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_CourierCompany">
        <bpmn:flowNodeRef>StartEvent_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformClientDelay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_HumanResources</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PickupPackage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_DecideRoute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DeliverPackage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateSystem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- E-shop Staff Process -->
    <bpmn:startEvent id="StartEvent_1" name="Order Received">
      <bpmn:outgoing>SequenceFlow_StartToReview</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_ReviewOrder" name="Review order">
      <bpmn:incoming>SequenceFlow_StartToReview</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReviewToCheckStock</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_CheckStock" name="All items available?">
      <bpmn:incoming>SequenceFlow_ReviewToCheckStock</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ItemsAvailable</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SomethingMissing</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_InformDelay" name="Inform customer about potential delay">
      <bpmn:incoming>SequenceFlow_SomethingMissing</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DelayToOrderProducts</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_OrderMissingProducts" name="Order missing products">
      <bpmn:incoming>SequenceFlow_DelayToOrderProducts</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OrderToCheckDiscontinued</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_CheckDiscontinued" name="Item discontinued?">
      <bpmn:incoming>SequenceFlow_OrderToCheckDiscontinued</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DiscontinuedYes</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NotDiscontinuedNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_InformUnavailableItems" name="Inform customer about unavailable items">
      <bpmn:incoming>SequenceFlow_DiscontinuedYes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_UnavailableToWaitDelivery</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:intermediateThrowEvent id="IntermediateTimerEvent_WaitDelivery" name="x days - supplier delivery time">
      <bpmn:incoming>SequenceFlow_NotDiscontinuedNo</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_UnavailableToWaitDelivery</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <bpmn:userTask id="Task_RecollectProducts" name="Recollect all products">
      <bpmn:incoming>SequenceFlow_WaitStockAgain</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RecollToPreparePackage</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_PreparePackage" name="Prepare package">
      <bpmn:incoming>SequenceFlow_RecollToPreparePackage</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PackageReadyToCourier</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndEvent_PackageReady" name="Package ready">
      <bpmn:incoming>SequenceFlow_PackageReadyToCourier</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Courier Company Process -->
    <bpmn:startEvent id="StartEvent_2" name="Receive package notification">
      <bpmn:outgoing>SequenceFlow_CourierStartToInformDelay</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_InformClientDelay" name="Inform client about potential delay">
      <bpmn:incoming>SequenceFlow_CourierStartToInformDelay</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DelayToCheckResources</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Human resource decision -->
    <bpmn:exclusiveGateway id="Gateway_HumanResources" name="Enough human resources?">
      <bpmn:incoming>SequenceFlow_DelayToCheckResources</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_YesResources</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoWaitDrivers</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Delivery flows -->
    <bpmn:userTask id="Task_PickupPackage" name="Pick up package by driver">
      <bpmn:incoming>SequenceFlow_YesResources</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PickupToDecideRoute</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="ServiceTask_DecideRoute" name="Decide best route for all packages">
      <bpmn:incoming>SequenceFlow_PickupToDecideRoute</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RouteToDeliver</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="Task_DeliverPackage" name="Deliver package">
      <bpmn:incoming>SequenceFlow_RouteToDeliver</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DeliverToUpdateSystem</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_UpdateSystem" name="Update system - notify stakeholders">
      <bpmn:incoming>SequenceFlow_DeliverToUpdateSystem</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SystemToFinish</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToReview" sourceRef="StartEvent_1" targetRef="Task_ReviewOrder"/>
    <bpmn:sequenceFlow id="SequenceFlow_ReviewToCheckStock" sourceRef="Task_ReviewOrder" targetRef="Gateway_CheckStock"/>

    <!-- Missing items path -->
    <bpmn:sequenceFlow id="SequenceFlow_SomethingMissing" name="No - something missing" sourceRef="Gateway_CheckStock" targetRef="Task_InformDelay"/>
    <bpmn:sequenceFlow id="SequenceFlow_DelayToOrderProducts" sourceRef="Task_InformDelay" targetRef="Task_OrderMissingProducts"/>

    <!-- Discontinued items path -->
    <bpmn:exclusiveGateway id="Gateway_CheckStockAgain">
      <bpmn:incoming>SequenceFlow_WaitStockAgain</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_YesAllOK</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoStillMissing</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Wait for delivery -->
    <bpmn:sequenceFlow id="SequenceFlow_NotDiscontinuedNo" name="No - not discontinued" sourceRef="Gateway_CheckStockAgain" targetRef="IntermediateTimerEvent_WaitDelivery"/>
    <bpmn:sequenceFlow id="SequenceFlow_DiscontinuedYes" name="Yes - item discontinued" sourceRef="Gateway_CheckDiscontinued" targetRef="Task_InformUnavailableItems"/>

    <!-- Wait for delivery -->
    <bpmn:sequenceFlow id="SequenceFlow_UnavailableToWaitDelivery" sourceRef="Task_OrderMissingProducts" targetRef="IntermediateTimerEvent_WaitDelivery"/>
    <bpmn:sequenceFlow id="SequenceFlow_WaitStockAgain" name="After x days - check stock again" sourceRef="IntermediateTimerEvent_WaitDelivery" targetRef="Gateway_CheckStockAgain"/>

    <!-- Stock recheck -->
    <bpmn:exclusiveGateway id="Gateway_EnoughDrivers">
      <bpmn:incoming>SequenceFlow_DelayToCheckResources</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_YesResources</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoWaitDrivers</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Package preparation -->
    <bpmn:sequenceFlow id="SequenceFlow_RecollToPreparePackage" sourceRef="Task_RecollectProducts" targetRef="Task_PreparePackage"/>
    <bpmn:sequenceFlow id="SequenceFlow_PackageReadyToCourier" name="Inform courier about package" sourceRef="Task_PreparePackage" targetRef="EndEvent_PackageReady"/>

    <!-- Courier company flows -->
    <bpmn:sequenceFlow id="SequenceFlow_CourierStartToInformDelay" sourceRef="StartEvent_2" targetRef="Task_InformClientDelay"/>
    <bpmn:sequenceFlow id="SequenceFlow_DelayToCheckResources" name="Wait for resources check" sourceRef="Task_InformClientDelay" targetRef="Gateway_HumanResources"/>

    <!-- Delivery flows -->
    <bpmn:sequenceFlow id="SequenceFlow_PickupToDecideRoute" sourceRef="Task_PickupPackage" targetRef="ServiceTask_DecideRoute"/>
    <bpmn:sequenceFlow id="SequenceFlow_RouteToDeliver" name="Best route decided" sourceRef="ServiceTask_DecideRoute" targetRef="Task_DeliverPackage"/>

    <!-- Final notification -->
    <bpmn:endEvent id="EndEvent_2">
      <bpmn:name>Delivery complete - stakeholders notified</bpmn:name>
      <bpmn:incoming>SequenceFlow_SystemToFinish</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>

  <!-- Message flows between participants -->
  <bpmn:message id="Message_PackageReady" name="Package ready notification"/>
  <bpmn:messageFlow id="MessageFlow_1">
    <bpmn:sourceRef>EndEvent_PackageReady</bpmn:sourceRef>
    <bpmn:targetRef>StartEvent_2</bpmn:targetRef>
  </bpmn:messageFlow>

</bpmn:definitions>