<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                 id="Definitions_NewClientAcquisition" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_0a8d6h7">
    <bpmn:participant id="Participant_ManagementMarketingProcess" name="New Client Acquisition Process" processRef="Process_NewClient"/>
    <bpmn:messageFlow id="MessageFlow_OfferSent" sourceRef="IntermediateThrowEvent_SendOffer" targetRef="External_PotentialClient"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_NewClient">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Management">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ManagementIndication</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateThrowEvent_SendOffer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_ClientDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareContract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SignContract</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Marketing">
        <bpmn:flowNodeRef>IntermediateCatchEvent_OfferResponse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AnalyzeMarket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PreparePresentation</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_External">
        <bpmn:flowNodeRef>IntermediateThrowEvent_SendOfferResponse</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:name>New Client Needed Indication</bpmn:name>
      <bpmn:outgoing>SequenceFlow_StartToIndication</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Management Task -->
    <bpmn:task id="Task_ManagementIndication" name="Management indicates new clients needed">
      <bpmn:incoming>SequenceFlow_StartToIndication</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_IndicationToMarketing</bpmn:outgoing>
    </bpmn:task>

    <!-- Marketing Tasks -->
    <bpmn:task id="Task_AnalyzeMarket" name="Perform market analysis">
      <bpmn:name>Analyze Market</bpmn:name>
      <bpmn:incoming>SequenceFlow_MarketingStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AnalysisToPresentation</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_PreparePresentation" name="Prepare portfolio presentation">
      <bpmn:name>Portfolio Presentation</bpmn:name>
      <bpmn:incoming>SequenceFlow_AnalysisToPresentation</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PresentationToOfferSend</bpmn:outgoing>
    </bpmn:task>

    <!-- Message Flow for Sending Offers -->
    <bpmn:intermediateThrowEvent id="IntermediateThrowEvent_SendOffer" name="Send offer to potential client">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SequenceFlow_PresentationToOfferSend</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OfferSentToResponseWait</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <!-- Message Flow for Receiving Responses -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_ClientResponse" name="Receive client response">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SequenceFlow_OfferSentToClient</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ResponseToDecisionGateway</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Decision Gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_ClientDecision">
      <bpmn:name>Client Accepts Offer?</bpmn:name>
      <bpmn:incoming>SequenceFlow_ResponseToDecisionGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AcceptPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RejectPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Contract Preparation Path -->
    <bpmn:task id="Task_PrepareContract" name="Prepare contract">
      <bpmn:name>Prepare contract for signing</bpmn:name>
      <bpmn:incoming>SequenceFlow_AcceptPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ContractToSign</bpmn:outgoing>
    </bpmn:task>

    <!-- Contract Signing Path -->
    <bpmn:task id="Task_SignContract" name="Sign contract">
      <bpmn:name>Client signs contract</bpmn:name>
      <bpmn:incoming>SequenceFlow_ContractToSign</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ContractSignedToEnd</bpmn:outgoing>
    </bpmn:task>

    <!-- Failure Analysis Path -->
    <bpmn:task id="Task_AnalyzeFailureReasons" name="Analyze reasons for offer failure">
      <bpmn:name>Analyze why offer failed and improve future processes</bpmn:name>
      <bpmn:incoming>SequenceFlow_RejectPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AnalysisToEnd</bpmn:outgoing>
    </bpmn:task>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_Success">
      <bpmn:name>New Client Acquired Successfully</bpmn:name>
      <bpmn:incoming>SequenceFlow_ContractSignedToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_Failure">
      <bpmn:name>Offer Failed - Analysis Complete</bpmn:name>
      <bpmn:incoming>SequenceFlow_AnalysisToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToIndication" sourceRef="StartEvent_1" targetRef="Task_ManagementIndation"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_MarketingStart" name="Inform marketing team">
      <bpmn:name>Management informs marketing team</bpmn:name>
      <bpmn:sourceRef>Task_ManagementIndication</bpmn:sourceRef>
      <bpmn:targetRef>IntermediateCatchEvent_OfferResponse</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Marketing Lane Flow -->
    <bpmn:intermediateThrowEvent id="IntermediateThrowEvent_SendOffer" name="Send offer to potential client">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SequenceFlow_PresentationToOfferSend</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OfferSentToResponseWait</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <!-- Message Flow for Client Response -->
    <bpmn:message id="Message_ClientOffer" name="Client Offer"/>
    
    <!-- Marketing Lane Tasks -->
    <bpmn:task id="Task_AnalyzeMarket" name="Perform market analysis">
      <bpmn:name>Analyze Market</bpmn:name>
      <bpmn:incoming>SequenceFlow_MarketingStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AnalysisToPresentation</bpmn:outgoing>
    </bpmn:task>

    <!-- Message Flow for Sending Offers -->
    <bpmn:message id="Message_OfferSent" name="Client Offer Sent"/>
    
    <!-- Sequence Flows in Marketing Lane -->
    <bpmn:sequenceFlow id="SequenceFlow_AnalysisToPresentation" sourceRef="Task_AnalyzeMarket" targetRef="Task_PreparePresentation">
      <bpmn:name>Analysis complete</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Message Flow for Sending Offers -->
    <bpmn:message id="Message_SendOfferToClient" name="Send Offer to Client"/>
    
    <!-- Sequence Flows in Marketing Lane -->
    <bpmn:sequenceFlow id="SequenceFlow_PresentationToOfferSend" sourceRef="Task_PreparePresentation" targetRef="IntermediateThrowEvent_SendOffer">
      <bpmn:name>Presentation ready</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>