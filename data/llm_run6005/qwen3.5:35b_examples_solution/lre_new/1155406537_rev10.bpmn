<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_1x9k3mz">
  <bpmn:collaboration id="Collaboration_0a8d6h7">
    <bpmn:participant id="Participant_Client" name="PayPal Client" processRef="Process_Client"/>
    <bpmn:participant id="Participant_System" name="PayPal System" processRef="Process_System"/>
  </bpmn:collaboration>

  <bpmn:message id="Message_SubmitAccountDetails" />
  <bpmn:message id="Message_NotifyInvalidFields" />

  <bpmn:process id="Process_Client">
    <bpmn:startEvent id="StartEvent_AccountCreation">
      <bpmn:name>Create PayPal Account</bpmn:name>
      <bpmn:outgoing>SequenceFlow_0123456789ab</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_DetermineAccountType">
      <bpmn:name>Determine Account Type</bpmn:name>
      <bpmn:incoming>SequenceFlow_0123456789ab</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_abcdef123456</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Exclusive_GatewayAccountType">
      <bpmn:name>Select Account Type</bpmn:name>
      <bpmn:incoming>SequenceFlow_abcdef123456</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_personalaccount</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_premiumaccount</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_SelectPersonalAccount">
      <bpmn:name>Select Personal Account Type</bpmn:name>
      <bpmn:incoming>SequenceFlow_personalaccount</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0123456789cd</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_SelectPremiumAccount">
      <bpmn:name>Select Premium Account Type</bpmn:name>
      <bpmn:incoming>SequenceFlow_premiumaccount</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0123456789cd</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Exclusive_GatewayMergeAccount">
      <bpmn:incoming>SequenceFlow_0123456789cd</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_enterlogin</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_EnterLoginDetails">
      <bpmn:name>Enter Login Details (Email, Password)</bpmn:name>
      <bpmn:incoming>SequenceFlow_enterlogin</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0123456789ef</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_EnterPersonalDetails">
      <bpmn:name>Enter Personal Details (Name, DOB)</bpmn:name>
      <bpmn:incoming>SequenceFlow_0123456789ef</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0123456789gh</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_EnterContactDetails">
      <bpmn:name>Enter Contact Details (Phone, Address)</bpmn:name>
      <bpmn:incoming>SequenceFlow_0123456789gh</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0123456789ij</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_DeclarePEP">
      <bpmn:name>Declare PEP Affiliation</bpmn:name>
      <bpmn:incoming>SequenceFlow_0123456789ij</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_createaccount</bpmn:outgoing>
    </bpmn:task>

    <bpmn:intermediateThrowEvent id="IntermediateSubmitAccount">
      <bpmn:name>Submit Account Details to System</bpmn:name>
      <bpmn:incoming>SequenceFlow_createaccount</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_messageToSystem</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageDef_SubmitAccount"/>
    </bpmn:intermediateThrowEvent>

  </bpmn:process>

  <bpmn:process id="Process_System">
    <bpmn:startEvent id="StartEvent_RequestReceived" name="Request Received">
      <bpmn:messageRefMessageDef_SubmitAccount/>
      <bpmn:outgoing>SequenceFlow_validateInput</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_ValidateFields">
      <bpmn:name>Validate Input Fields</bpmn:name>
      <bpmn:incoming>SequenceFlow_validateInput</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_checkValidationResult</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Exclusive_GatewayValidation">
      <bpmn:name>Fields Valid?</bpmn:name>
      <bpmn:incoming>SequenceFlow_checkValidationResult</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_invalidFields</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_validFields</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:intermediateThrowEvent id="IntermediateNotifyInvalid">
      <bpmn:name>Notify Client of Invalid Fields</bpmn:name>
      <bpmn:incoming>SequenceFlow_invalidFields</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_messageToClient</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageDef_NotifyInvalid"/>
    </bpmn:intermediateThrowEvent>

    <bpmn:endEvent id="EndEvent_AccountCreated">
      <bpmn:name>Account Created Successfully</bpmn:name>
      <bpmn:incoming>SequenceFlow_sendWelcomeEmail</bpmn:incoming/>
    </bpmn:endEvent>

    <bpmn:task id="Task_GenerateWelcomeEmail">
      <bpmn:name>Generate Welcome Email</bpmn:name>
      <bpmn:incoming>SequenceFlow_validFields</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_sendWelcomeEmail</bpmn:outgoing>
    </bpmn:task>

  </bpmn:process>

  <!-- Message Flows -->
  <bpmn:message id="MessageDef_SubmitAccount" name="Submit Account Details"/>
  <bpmn:message id="MessageDef_NotifyInvalid" name="Notify Invalid Fields"/>

</bpmn:definitions>