<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_RewardsTraining">
    <bpmn:participant id="Participant_RewardsTraining" name="Rewards and training process" processRef="Process_RewardsAndTraining"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_RewardsAndTraining">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Management" name="Management">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckPerformance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_PerformanceCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SuggestDismissal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SuggestTraining</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SuggestReward</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_RewardType</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ChooseBenefit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_ConvergeReward</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AnnounceEmployeeMonth</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_HR" name="HR">
        <bpmn:flowNodeRef>Task_DismissEmployee</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProvideTraining</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Finance" name="Finance">
        <bpmn:flowNodeRef>Task_CalculateReward</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PayReward</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Check employee performance">
      <bpmn:outgoing>SequenceFlow_CheckPerformance</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Check Performance -->
    <bpmn:task id="Task_CheckPerformance" name="Check employee performance">
      <bpmn:incoming>SequenceFlow_CheckPerformance</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PerformanceDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Performance Decision -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_PerformanceCheck" name="Performance Check">
      <bpmn:incoming>SequenceFlow_PerformanceDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DismissalPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_TrainingPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RewardPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Dismissal Path -->
    <bpmn:sequenceFlow id="SequenceFlow_DismissalPath" name="performance &lt; 20%" sourceRef="ExclusiveGateway_PerformanceCheck" targetRef="Task_SuggestDismissal"/>

    <!-- Task: Suggest Dismissal -->
    <bpmn:task id="Task_SuggestDismissal" name="Suggest employee dismissal">
      <bpmn:incoming>SequenceFlow_DismissalPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_HRDismissal</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Dismiss Employee (HR) -->
    <bpmn:task id="Task_DismissEmployee" name="Dismiss employee">
      <bpmn:incoming>SequenceFlow_HRDismissal</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndDismissed</bpmn:outgoing>
    </bpmn:task>

    <!-- Training Path -->
    <bpmn:sequenceFlow id="SequenceFlow_TrainingPath" name="20% &lt; performance &lt; 50%" sourceRef="ExclusiveGateway_PerformanceCheck" targetRef="Task_SuggestTraining"/>

    <!-- Task: Suggest Training -->
    <bpmn:task id="Task_SuggestTraining" name="Suggest training">
      <bpmn:incoming>SequenceFlow_TrainingPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_HRTraining</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Provide Training (HR) -->
    <bpmn:task id="Task_ProvideTraining" name="Provide training">
      <bpmn:incoming>SequenceFlow_HRTraining</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndTrained</bpmn:outgoing>
    </bpmn:task>

    <!-- Reward Path -->
    <bpmn:sequenceFlow id="SequenceFlow_RewardPath" name="performance &gt; 75%" sourceRef="ExclusiveGateway_PerformanceCheck" targetRef="Task_SuggestReward"/>

    <!-- Task: Suggest Reward -->
    <bpmn:task id="Task_SuggestReward" name="Suggest for reward">
      <bpmn:incoming>SequenceFlow_RewardPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RewardDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2: Reward Type Decision -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_RewardType" name="Reward Type">
      <bpmn:incoming>SequenceFlow_RewardDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FinancialReward</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_OtherBenefit</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Financial Reward Path -->
    <bpmn:sequenceFlow id="SequenceFlow_FinancialReward" name="financial reward" sourceRef="ExclusiveGateway_RewardType" targetRef="Task_CalculateReward"/>

    <!-- Task: Calculate Reward (Finance) -->
    <bpmn:task id="Task_CalculateReward" name="Calculate reward">
      <bpmn:incoming>SequenceFlow_FinancialReward</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PayReward</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Pay Reward (Finance) -->
    <bpmn:task id="Task_PayReward" name="Pay reward">
      <bpmn:incoming>SequenceFlow_PayReward</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConvergeFinancial</bpmn:outgoing>
    </bpmn:task>

    <!-- Other Benefit Path -->
    <bpmn:sequenceFlow id="SequenceFlow_OtherBenefit" name="other benefit" sourceRef="ExclusiveGateway_RewardType" targetRef="Task_ChooseBenefit"/>

    <!-- Task: Choose Benefit -->
    <bpmn:task id="Task_ChooseBenefit" name="Choose appropriate benefit">
      <bpmn:incoming>SequenceFlow_OtherBenefit</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConvergeOther</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 3: Converge Reward Paths -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_ConvergeReward" name="Reward Path Convergence">
      <bpmn:incoming>SequenceFlow_ConvergeFinancial</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ConvergeOther</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AnnounceEmployeeMonth</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Announce Employee of Month -->
    <bpmn:task id="Task_AnnounceEmployeeMonth" name="Announce employee of the month">
      <bpmn:incoming>SequenceFlow_AnnounceEmployeeMonth</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndProcess</bpmn:outgoing>
    </bpmn:task>

    <!-- End Events -->
    <bpmn:endEvent id="EndDismissed" name="Employee dismissed">
      <bpmn:incoming>SequenceFlow_EndDismissed</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndTrained" name="Training completed">
      <bpmn:incoming>SequenceFlow_EndTrained</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndProcess" name="Reward process complete">
      <bpmn:incoming>SequenceFlow_EndProcess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckPerformance" sourceRef="StartEvent_1" targetRef="Task_CheckPerformance"/>
    <bpmn:sequenceFlow id="SequenceFlow_PerformanceDecision" name="Determine action based on performance" sourceRef="Task_CheckPerformance" targetRef="ExclusiveGateway_PerformanceCheck"/>
    <bpmn:sequenceFlow id="SequenceFlow_HRDismissal" name="HR dismisses employee" sourceRef="Task_SuggestDismissal" targetRef="Task_DismissEmployee"/>
    <bpmn:sequenceFlow id="SequenceFlow_EndDismissed" name="Dismissal complete" sourceRef="Task_DismissEmployee" targetRef="EndDismissed"/>
    <bpmn:sequenceFlow id="SequenceFlow_HRTraining" name="HR provides training" sourceRef="Task_SuggestTraining" targetRef="Task_ProvideTraining"/>
    <bpmn:sequenceFlow id="SequenceFlow_EndTrained" name="Training complete" sourceRef="Task_ProvideTraining" targetRef="EndTrained"/>
    <bpmn:sequenceFlow id="SequenceFlow_RewardDecision" name="Select reward type" sourceRef="Task_SuggestReward" targetRef="ExclusiveGateway_RewardType"/>
    <bpmn:sequenceFlow id="SequenceFlow_ConvergeFinancial" name="After payment complete" sourceRef="Task_PayReward" targetRef="ExclusiveGateway_ConvergeReward"/>
    <bpmn:sequenceFlow id="SequenceFlow_ConvergeOther" name="After benefit chosen" sourceRef="Task_ChooseBenefit" targetRef="ExclusiveGateway_ConvergeReward"/>
    <bpmn:sequenceFlow id="SequenceFlow_AnnounceEmployeeMonth" name="Announcement" sourceRef="ExclusiveGateway_ConvergeReward" targetRef="Task_AnnounceEmployeeMonth"/>
    <bpmn:sequenceFlow id="SequenceFlow_EndProcess" name="Reward process complete" sourceRef="Task_AnnounceEmployeeMonth" targetRef="EndProcess"/>
  </bpmn:process>
</bpmn:definitions>