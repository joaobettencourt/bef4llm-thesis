<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_1x9k3mz" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_0a8d6h7">
    <bpmn:participant id="Participant_ERICS" name="ERICS Company" processRef="Process_Reimbursement"/>
    <bpmn:participant id="Participant_Customer" name="Customer"/>
    <bpmn:messageFlow id="MessageFlow_CreditNote" sourceRef="IntermediateThrowEvent_SendCreditNote" targetRef="Participant_Customer"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Reimbursement">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Administration" name="Administration Department">
        <bpmn:flowNodeRef>StartEvent_RequestReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateReimbursementContact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectBeneficiary</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SetRefundPeriodDuration</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_CheckCustomerType</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectAssociationGroup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ManualCustomerSelection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_JoinAfterSelection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SetThreshold</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateCatchEvent_WaitPeriodEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_SplitAfterWait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrintCreditNoteSend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateThrowEvent_SendNotification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CalculateReimbursement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PayReimbursement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_JoinBeforeEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ProcessComplete</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_RequestReceived" name="Reimbursement Request Received">
      <bpmn:outgoing>SequenceFlow_01_CreateContact</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1 -->
    <bpmn:task id="Task_CreateReimbursementContact" name="Create Reimbursement Contact">
      <bpmn:incoming>SequenceFlow_01_CreateContact</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_02_SelectBeneficiary</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2 -->
    <bpmn:task id="Task_SelectBeneficiary" name="Select Beneficiary">
      <bpmn:incoming>SequenceFlow_02_SelectBeneficiary</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_03_SetRefundPeriod</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3 -->
    <bpmn:task id="Task_SetRefundPeriodDuration" name="Determine Refund Period and Contract Duration">
      <bpmn:incoming>SequenceFlow_03_SetRefundPeriod</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_04_CheckCustomerType</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1 - Customer Type Check -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_CheckCustomerType" name="Check Customer Type">
      <bpmn:incoming>SequenceFlow_04_CheckCustomerType</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_05_VerbandPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_06_NormalPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 4a - Verband Path -->
    <bpmn:task id="Task_SelectAssociationGroup" name="Select Association as Customer Group">
      <bpmn:incoming>SequenceFlow_05_VerbandPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_10_JoinAfterSelection</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 4b - Normal Path -->
    <bpmn:task id="Task_ManualCustomerSelection" name="Select Customers Manually">
      <bpmn:incoming>SequenceFlow_06_NormalPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_10_JoinAfterSelection</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2 - Join After Selection -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_JoinAfterSelection" name="Join After Customer Selection">
      <bpmn:incoming>SequenceFlow_10_VerbandPath</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_11_NormalPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_20_SetThreshold</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 5 -->
    <bpmn:task id="Task_SetThreshold" name="Set Threshold">
      <bpmn:incoming>SequenceFlow_20_JoinAfterSelection</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_30_WaitPeriodEnd</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Catch Event - Timer -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_WaitPeriodEnd" name="Wait for Refund Period End">
      <bpmn:incoming>SequenceFlow_30_SetThreshold</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_40_SplitAfterWait</bpmn:outgoing>
      <bpmn:timerEventDefinition/>
    </bpmn:intermediateCatchEvent>

    <!-- Parallel Gateway - Split -->
    <bpmn:parallelGateway id="ParallelGateway_SplitAfterWait" name="Split After Wait">
      <bpmn:incoming>SequenceFlow_40_WaitPeriodEnd</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_50_PrintCreditNotePath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_60_CalculateReimbursementPath</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 6a - Credit Note Path -->
    <bpmn:task id="Task_PrintCreditNoteSend" name="Print and Send Credit Note to Customer">
      <bpmn:incoming>SequenceFlow_50_SplitAfterWait</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_71_SendNotificationMessage</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Throw Event - Message -->
    <bpmn:intermediateThrowEvent id="IntermediateThrowEvent_SendCreditNote" name="Send Credit Note to Customer">
      <bpmn:incoming>SequenceFlow_71_PrintAndSend</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_80_JoinBeforeEnd</bpmn:outgoing>
      <bpmn:messageEventDefinition/>
    </bpmn:intermediateThrowEvent>

    <!-- Task 6b - Reimbursement Path -->
    <bpmn:task id="Task_CalculateReimbursement" name="Calculate Reimbursement">
      <bpmn:incoming>SequenceFlow_60_SplitAfterWait</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_90_PayReimbursementPath</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 7 -->
    <bpmn:task id="Task_PayReimbursement" name="Pay Reimbursement to Customer">
      <bpmn:incoming>SequenceFlow_90_CalculatePath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_100_JoinBeforeEnd</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway - Join -->
    <bpmn:parallelGateway id="ParallelGateway_JoinBeforeEnd" name="Join Before End">
      <bpmn:incoming>SequenceFlow_80_SendNotificationPath</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_100_PaymentCompletePath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_200_EndProcess</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_ProcessComplete" name="Reimbursement Process Complete">
      <bpmn:incoming>SequenceFlow_200_JoinBeforeEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_01_CreateContact" sourceRef="StartEvent_RequestReceived" targetRef="Task_CreateReimbursementContact"/>
    <bpmn:sequenceFlow id="SequenceFlow_02_SelectBeneficiary" sourceRef="Task_CreateReimbursementContact" targetRef="Task_SelectBeneficiary"/>
    <bpmn:sequenceFlow id="SequenceFlow_03_SetRefundPeriod" sourceRef="Task_SelectBeneficiary" targetRef="Task_SetRefundPeriodDuration"/>
    <bpmn:sequenceFlow id="SequenceFlow_04_CheckCustomerType" sourceRef="Task_SetRefundPeriodDuration" targetRef="ExclusiveGateway_CheckCustomerType"/>

    <!-- Gateway 1 Outgoing Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_05_VerbandPath" name="Verband Member" sourceRef="ExclusiveGateway_CheckCustomerType" targetRef="Task_SelectAssociationGroup">
      <bpmn:name>Verband</bpmn:name>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_06_NormalPath" name="Normal Subsidiaries" sourceRef="ExclusiveGateway_CheckCustomerType" targetRef="Task_ManualCustomerSelection">
      <bpmn:name>Normal</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Join After Selection -->
    <bpmn:sequenceFlow id="SequenceFlow_10_VerbandPath" sourceRef="Task_SelectAssociationGroup" targetRef="ExclusiveGateway_JoinAfterSelection"/>
    <bpmn:sequenceFlow id="SequenceFlow_11_NormalPath" sourceRef="Task_ManualCustomerSelection" targetRef="ExclusiveGateway_JoinAfterSelection"/>

    <!-- Threshold to Wait Event -->
    <bpmn:sequenceFlow id="SequenceFlow_20_JoinAfterSelection" sourceRef="ExclusiveGateway_JoinAfterSelection" targetRef="Task_SetThreshold">
      <bpmn:name>Join After Selection</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Split After Wait -->
    <bpmn:sequenceFlow id="SequenceFlow_30_WaitPeriodEnd" sourceRef="Task_SetThreshold" targetRef="IntermediateCatchEvent_WaitPeriodEnd"/>
    <bpmn:sequenceFlow id="SequenceFlow_40_SplitAfterWait" sourceRef="ParallelGateway_SplitAfterWait" targetRef="Task_PrintCreditNoteSend">
      <bpmn:name>Split After Wait</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Credit Note Path -->
    <bpmn:sequenceFlow id="SequenceFlow_50_PrintCreditNotePath" sourceRef="ParallelGateway_SplitAfterWait" targetRef="Task_PrintCreditNoteSend">
      <bpmn:name>Credit Note</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Reimbursement Calculation and Payment -->
    <bpmn:sequenceFlow id="SequenceFlow_60_CalculateReimbursementPath" sourceRef="ParallelGateway_SplitAfterWait" targetRef="Task_CalculateReimbursement">
      <bpmn:name>Calculation</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Join Before End -->
    <bpmn:sequenceFlow id="SequenceFlow_71_SendNotificationMessage" sourceRef="IntermediateThrowEvent_SendCreditNote" targetRef="ParallelGateway_JoinBeforeEnd"/>
    <bpmn:sequenceFlow id="SequenceFlow_80_JoinBeforeEnd" name="Send Notification Path" sourceRef="Task_PrintCreditNoteSend" targetRef="IntermediateThrowEvent_SendCreditNote">
      <bpmn:name>Print and Send</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Join Before End -->
    <bpmn:sequenceFlow id="SequenceFlow_90_PayReimbursementPath" sourceRef="Task_CalculateReimbursement" targetRef="Task_PayReimbursement">
      <bpmn:name>Calculation Complete</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Join Before End -->
    <bpmn:sequenceFlow id="SequenceFlow_100_JoinBeforeEnd" name="Payment Complete Path" sourceRef="Task_PayReimbursement" targetRef="ParallelGateway_JoinBeforeEnd">
      <bpmn:name>Pay Reimbursement</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- End Process -->
    <bpmn:sequenceFlow id="SequenceFlow_200_EndProcess" sourceRef="ParallelGateway_JoinBeforeEnd" targetRef="EndEvent_ProcessComplete"/>

  </bpmn:process>
</bpmn:definitions>