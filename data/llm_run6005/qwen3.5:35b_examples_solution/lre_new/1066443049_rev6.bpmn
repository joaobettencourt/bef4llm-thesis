<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_WebDesignProject" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_WebDesign">
    <bpmn:participant id="Participant_ProjectTeam" name="Web Design Project Team" processRef="Process_WebDesign" />
  </bpmn:collaboration>

  <bpmn:process id="Process_WebDesign" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_DesignTeam" name="Web Design Team">
        <bpmn:flowNodeRef>StartEvent_Meeting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformationalMeeting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Successful</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Failed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Storyboard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SplitParallel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DesignDev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ContentDraft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ReviewNeeded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FinalContent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_JoinParallel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BuildReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Success</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_MarketingTeam" name="Marketing Team">
        <bpmn:flowNodeRef>Task_ReviewDraft</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Meeting">
      <bpmn:name>Informational Meeting</bpmn:name>
      <bpmn:outgoing>SequenceFlow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task -->
    <bpmn:task id="Task_InformationalMeeting" name="Hold Informational Meeting">
      <bpmn:incoming>SequenceFlow_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_02</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway -->
    <bpmn:exclusiveGateway id="Gateway_Successful" name="Meeting successful?">
      <bpmn:incoming>SequenceFlow_02</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_03</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_04</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Failed" name="Process Ends">
      <bpmn:incoming>SequenceFlow_04</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_03" sourceRef="Gateway_Successful" targetRef="Task_Storyboard">
      <bpmn:name>yes</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:task id="Task_Storyboard" name="Create Storyboard">
      <bpmn:incoming>SequenceFlow_03</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_05</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_04" sourceRef="Gateway_Successful" targetRef="EndEvent_Failed">
      <bpmn:name>no</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_05" sourceRef="Task_Storyboard" targetRef="Gateway_SplitParallel">
      <bpmn:name>Agreement reached</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Parallel Gateway -->
    <bpmn:parallelGateway id="Gateway_SplitParallel">
      <bpmn:incoming>SequenceFlow_05</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_20</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Dev Path -->
    <bpmn:task id="Task_DesignDev" name="Design and Develop Website">
      <bpmn:incoming>SequenceFlow_10</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_30</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="Gateway_SplitParallel" targetRef="Task_DesignDev">
      <bpmn:name>Design &amp; Develop</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Content Path -->
    <bpmn:task id="Task_ContentDraft" name="Prepare Initial Draft of Content">
      <bpmn:incoming>SequenceFlow_20</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_35</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_20" sourceRef="Gateway_SplitParallel" targetRef="Task_ContentDraft">
      <bpmn:name>Prepare Draft</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Review Gateway -->
    <bpmn:exclusiveGateway id="Gateway_ReviewNeeded" name="Review needed?">
      <bpmn:incoming>SequenceFlow_35</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_40</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_41</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Marketing Review Task -->
    <bpmn:task id="Task_ReviewDraft" name="Conduct Content Review">
      <bpmn:incoming>SequenceFlow_40</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_50</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flows for Review Logic -->
    <bpmn:sequenceFlow id="SequenceFlow_35" sourceRef="Task_ContentDraft" targetRef="Gateway_ReviewNeeded">
      <bpmn:name>Draft Ready</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_40" sourceRef="Gateway_ReviewNeeded" targetRef="Task_ReviewDraft">
      <bpmn:name>yes</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Final Content Task -->
    <bpmn:task id="Task_FinalContent" name="Create Final Version of Content">
      <bpmn:incoming>SequenceFlow_50</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_41</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_60</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_50" sourceRef="Task_ReviewDraft" targetRef="Task_FinalContent">
      <bpmn:name>After Review</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_41" sourceRef="Gateway_ReviewNeeded" targetRef="Task_FinalContent">
      <bpmn:name>no</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Parallel Join -->
    <bpmn:parallelGateway id="Gateway_JoinParallel">
      <bpmn:incoming>SequenceFlow_30</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_60</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_70</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Sequence Flows to Join -->
    <bpmn:sequenceFlow id="SequenceFlow_30" sourceRef="Task_DesignDev" targetRef="Gateway_JoinParallel">
      <bpmn:name>Development Done</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_60" sourceRef="Task_FinalContent" targetRef="Gateway_JoinParallel">
      <bpmn:name>Content Done</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Build Task -->
    <bpmn:task id="Task_BuildReview" name="Build and Review Website">
      <bpmn:incoming>SequenceFlow_70</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_80</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flows for Build -->
    <bpmn:sequenceFlow id="SequenceFlow_70" sourceRef="Gateway_JoinParallel" targetRef="Task_BuildReview">
      <bpmn:name>All Ready</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Approval Gateway -->
    <bpmn:exclusiveGateway id="Gateway_Approved" name="Site approved?">
      <bpmn:incoming>SequenceFlow_80</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_90</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_100</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Loop Back -->
    <bpmn:sequenceFlow id="SequenceFlow_80" sourceRef="Task_BuildReview" targetRef="Gateway_Approved">
      <bpmn:name>Built</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_100" sourceRef="Gateway_Approved" targetRef="Task_BuildReview">
      <bpmn:name>no</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Success" name="Process Completed">
      <bpmn:incoming>SequenceFlow_90</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow_90" sourceRef="Gateway_Approved" targetRef="EndEvent_Success">
      <bpmn:name>yes</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>