<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_0kz3w9y">
  <bpmn:collaboration id="Collaboration_0a8d6h7">
    <bpmn:participant id="Participant_DropOffTech" name="Drop-off tech" processRef="Process_TechFlow" />
    <bpmn:participant id="Participant_Customer" name="Customer" />
  </bpmn:collaboration>

  <bpmn:process id="Process_TechFlow">
    
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_ErrorNotification">
      <bpmn:name>IS notified about data validation error</bpmn:name>
      <bpmn:outgoing>SequenceFlow_StartToCheckTypos</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1 -->
    <bpmn:task id="Task_CheckTypos">
      <bpmn:name>Drop-off tech checks for typos</bpmn:name>
      <bpmn:incoming>SequenceFlow_StartToCheckTypos</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TyposDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1 -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_TyposFound">
      <bpmn:name>Typos Found?</bpmn:name>
      <bpmn:incoming>SequenceFlow_TyposDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ResolvedTypos</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CheckCustomerCorrection</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 2 -->
    <bpmn:task id="Task_CustomerCheck">
      <bpmn:name>Check if customer can correct mistake</bpmn:name>
      <bpmn:incoming>SequenceFlow_CheckCustomerCorrection</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CorrectionDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2 -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_CustomerCanCorrect">
      <bpmn:name>Customer Can Correct?</bpmn:name>
      <bpmn:incoming>SequenceFlow_CorrectionDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ResolvedCorrection</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CheckPublicSources</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 3 -->
    <bpmn:task id="Task_PublicSearch">
      <bpmn:name>Scour public sources for solutions</bpmn:name>
      <bpmn:incoming>SequenceFlow_CheckPublicSources</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SolutionDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 3 -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_SolutionFound">
      <bpmn:name>Solution Found?</bpmn:name>
      <bpmn:incoming>SequenceFlow_SolutionDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ResolvedSearch</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_UnresolvedEnd</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event 1 -->
    <bpmn:endEvent id="EndEvent_IssueResolved">
      <bpmn:name>Issue was resolved</bpmn:name>
      <bpmn:incoming>SequenceFlow_ResolvedTypos</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ResolvedCorrection</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ResolvedSearch</bpmn:incoming>
    </bpmn:endEvent>

    <!-- End Event 2 -->
    <bpmn:endEvent id="EndEvent_IssueUnresolved">
      <bpmn:name>Issue was un-resolvable</bpmn:name>
      <bpmn:incoming>SequenceFlow_UnresolvedEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToCheckTypos" sourceRef="StartEvent_ErrorNotification" targetRef="Task_CheckTypos">
      <bpmn:name/>
    </bpmn:sequenceFlow>
    
    <bpmn:sequenceFlow id="SequenceFlow_TyposDecision" sourceRef="Task_CheckTypos" targetRef="ExclusiveGateway_TyposFound"/>

    <bpmn:sequenceFlow id="SequenceFlow_ResolvedTypos" name="found (typos)" sourceRef="ExclusiveGateway_TyposFound" targetRef="EndEvent_IssueResolved">
      <bpmn:name>Yes</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_CheckCustomerCorrection" name="Not found (typos)" sourceRef="ExclusiveGateway_TyposFound" targetRef="Task_CustomerCheck">
      <bpmn:name>No</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_CorrectionDecision" sourceRef="Task_CustomerCheck" targetRef="ExclusiveGateway_CustomerCanCorrect"/>

    <bpmn:sequenceFlow id="SequenceFlow_ResolvedCorrection" name="Customer can correct" sourceRef="ExclusiveGateway_CustomerCanCorrect" targetRef="EndEvent_IssueResolved">
      <bpmn:name>Yes</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_CheckPublicSources" name="Customer cannot correct" sourceRef="ExclusiveGateway_CustomerCanCorrect" targetRef="Task_PublicSearch">
      <bpmn:name>No</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_SolutionDecision" sourceRef="Task_PublicSearch" targetRef="ExclusiveGateway_SolutionFound"/>

    <bpmn:sequenceFlow id="SequenceFlow_ResolvedSearch" name="Solution found in public sources" sourceRef="ExclusiveGateway_SolutionFound" targetRef="EndEvent_IssueResolved">
      <bpmn:name>Yes</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_UnresolvedEnd" name="No solution found in public sources" sourceRef="ExclusiveGateway_SolutionFound" targetRef="EndEvent_IssueUnresolved">
      <bpmn:name>No</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>