<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_001">
    <bpmn:participant id="Participant_001" name="Court File Processing System" processRef="Process_001"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_001" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Administration" name="Administration">
        <bpmn:flowNodeRef>StartEvent_MorningCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckFiles</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_MorningCheck" name="Morning Check">
      <bpmn:name>Morning File Check</bpmn:name>
      <bpmn:outgoing>SeqFlow_StartToCheck</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Check files -->
    <bpmn:task id="Task_CheckFiles" name="Check Files">
      <bpmn:name>Check files for court hearing</bpmn:name>
      <bpmn:incoming>SeqFlow_StartToCheck</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_ToDecisionGateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway -->
    <bpmn:exclusiveGateway id="Gateway_FilesMissing" name="Files Missing?">
      <bpmn:name>Files Missing?</bpmn:name>
      <bpmn:incoming>SeqFlow_ToDecisionGateway</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_InitiateSearch</bpmn:outgoing>
      <bpmn:outgoing>SeqFlow_TrackFiles</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Initiate search -->
    <bpmn:task id="Task_InitiateSearch" name="Initiate Search">
      <bpmn:name>Initiate file search</bpmn:name>
      <bpmn:incoming>SeqFlow_InitiateSearch</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_ToConvergeGateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Track physical files -->
    <bpmn:task id="Task_TrackFiles" name="Track Physical Files">
      <bpmn:name>Physically track files to intended location</bpmn:name>
      <bpmn:incoming>SeqFlow_TrackFiles</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_ToConvergeGateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway (Split) -->
    <bpmn:parallelGateway id="Parallel_Gateway_Concurrent" name="">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SeqFlow_ToConvergeGateway</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_HandFilesToAssociate</bpmn:outgoing>
      <bpmn:outgoing>SeqFlow_DistributeLawlist</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Hand files to Associate -->
    <bpmn:task id="Task_HandFilesToAssociate" name="Hand Files to Associate">
      <bpmn:name>Hand files to the Associate</bpmn:name>
      <bpmn:incoming>SeqFlow_HandFilesToAssociate</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_HandToJoin</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Distribute judge's lawlist -->
    <bpmn:task id="Task_DistributeLawlist" name="Distribute Judge's Lawlist">
      <bpmn:name>Distribute Judges Lawlist to relevant people</bpmn:name>
      <bpmn:incoming>SeqFlow_DistributeLawlist</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_DistribToJoin</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway (Join) -->
    <bpmn:parallelGateway id="Parallel_Gateway_Join" name="">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SeqFlow_HandToJoin</bpmn:incoming>
      <bpmn:incoming>SeqFlow_DistribToJoin</bpmn:incoming>
    </bpmn:parallelGateway>

    <!-- Task: Conduct directions hearings -->
    <bpmn:task id="Task_ConductHearings" name="Conduct Directions Hearings">
      <bpmn:name>Conduct directions hearings</bpmn:name>
      <bpmn:incoming>SeqFlow_ToDirectionsHearings</bpmn:incoming>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Completed" name="">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SeqFlow_ToDirectionsHearings</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SeqFlow_StartToCheck" sourceRef="StartEvent_MorningCheck" targetRef="Task_CheckFiles">
      <bpmn:name>To Check Files</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SeqFlow_ToDecisionGateway" sourceRef="Task_CheckFiles" targetRef="Gateway_FilesMissing">
      <bpmn:name>To Decision Gateway</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SeqFlow_InitiateSearch" name="Yes - Files Missing" sourceRef="Gateway_FilesMissing" targetRef="Task_InitiateSearch">
      <bpmn:name>If files missing</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SeqFlow_TrackFiles" name="No - Files OK" sourceRef="Gateway_FilesMissing" targetRef="Task_TrackFiles">
      <bpmn:name>If files in order</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Both tasks converge to the Parallel Gateway (Split) -->
    <bpmn:sequenceFlow id="SeqFlow_ToConvergeGateway" sourceRef="Task_InitiateSearch" targetRef="Parallel_Gateway_Concurrent">
      <bpmn:name>To Split</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SeqFlow_TrackToSplit" name="" sourceRef="Task_TrackFiles" targetRef="Parallel_Gateway_Concurrent">
      <bpmn:name>To Split</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Parallel Paths -->
    <bpmn:sequenceFlow id="SeqFlow_HandFilesToAssociate" name="" sourceRef="Parallel_Gateway_Concurrent" targetRef="Task_HandFilesToAssociate">
      <bpmn:name>To Associate</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SeqFlow_DistributeLawlist" name="" sourceRef="Parallel_Gateway_Concurrent" targetRef="Task_DistributeLawlist">
      <bpmn:name>Distribute Lawlist</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Join Paths -->
    <bpmn:sequenceFlow id="SeqFlow_HandToJoin" name="" sourceRef="Task_HandFilesToAssociate" targetRef="Parallel_Gateway_Join">
      <bpmn:name>To Hearings</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SeqFlow_DistribToJoin" name="" sourceRef="Task_DistributeLawlist" targetRef="Parallel_Gateway_Join">
      <bpmn:name>To Hearings</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Final Flow -->
    <bpmn:sequenceFlow id="SeqFlow_ToDirectionsHearings" name="" sourceRef="Parallel_Gateway_Join" targetRef="Task_ConductHearings">
      <bpmn:name>To Hearings</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>