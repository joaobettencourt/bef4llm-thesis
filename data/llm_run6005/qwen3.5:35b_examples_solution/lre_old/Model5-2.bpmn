<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_VacationRequest">
    <bpmn:participant id="Participant_Organization" name="Organization" processRef="Process_VacationRequest"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_VacationRequest" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Employee" name="Employee">
        <bpmn:flowNodeRef>StartEvent_SubmitRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegisterVacationRequest</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Supervisor" name="Supervisor">
        <bpmn:flowNodeRef>Gateway_ApprovalDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewRejectionReasons</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_HR" name="Human Resources">
        <bpmn:flowNodeRef>Task_CompleteManagementProcedures</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ProcessCompleted</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_SubmitRequest" name="Submit Vacation Request">
      <bpmn:outgoing>SequenceFlow_RegisterRequest</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_ProcessCompleted" name="Process Completed">
      <bpmn:incoming>SequenceFlow_CompleteProcedures</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Tasks -->
    <bpmn:task id="Task_RegisterVacationRequest" name="Register Vacation Request">
      <bpmn:incoming>SequenceFlow_RegisterRequest</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToSupervisor</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_ReviewRejectionReasons" name="Review Rejection Reasons">
      <bpmn:incoming>SequenceFlow_RejectedRequest</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToSupervisorAgain</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_CompleteManagementProcedures" name="Complete Management Procedures">
      <bpmn:incoming>SequenceFlow_ApprovedNotification</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CompleteProcedures</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway -->
    <bpmn:exclusiveGateway id="Gateway_ApprovalDecision" name="Request Approved?">
      <bpmn:incoming>SequenceFlow_SupervisorReview</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_YesApproved</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoRejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_RegisterRequest" sourceRef="StartEvent_SubmitRequest" targetRef="Task_RegisterVacationRequest">
      <bpmn:name>To Registration</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ToSupervisor" name="To Supervisor Review" sourceRef="Task_RegisterVacationRequest" targetRef="Gateway_ApprovalDecision"/>

    <bpmn:sequenceFlow id="SequenceFlow_SupervisorReview" name="Rejected - Return to Employee" sourceRef="Gateway_ApprovalDecision" targetRef="Task_ReviewRejectionReasons">
      <bpmn:name>Return for Review</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ToSupervisorAgain" name="Resubmit for Review" sourceRef="Task_ReviewRejectionReasons" targetRef="Gateway_ApprovalDecision"/>

    <bpmn:sequenceFlow id="SequenceFlow_YesApproved" name="Approved - Notify HR" sourceRef="Gateway_ApprovalDecision" targetRef="Task_CompleteManagementProcedures">
      <bpmn:name>Notify HR</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_NoRejected" name="Not Approved - Return to Employee" sourceRef="Gateway_ApprovalDecision" targetRef="Task_ReviewRejectionReasons"/>

    <bpmn:sequenceFlow id="SequenceFlow_CompleteProcedures" name="To Completion" sourceRef="Task_CompleteManagementProcedures" targetRef="EndEvent_ProcessCompleted">
      <bpmn:name>To End</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>