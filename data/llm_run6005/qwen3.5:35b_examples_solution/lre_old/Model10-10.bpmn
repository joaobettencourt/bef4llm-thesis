<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_FaultDetection_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_FaultDetection">
    <bpmn:participant id="Participant_UserProcess" name="Service Provider - User Process" processRef="Process_User"/>
    <bpmn:participant id="Participant_DetectorSystem" name="Fault Detector System" processRef="Process_Detector"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_User" isExecutable="false">
    <bpmn:startEvent id="Start_FaultDetected_01">
      <bpmn:name>Fault Detected or Suspicion</bpmn:name>
      <bpmn:outgoing>Seq_StartToExamine_01</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_ExamineFailure_02">
      <bpmn:name>Examine Failure Report</bpmn:name>
      <bpmn:incoming>Seq_StartToExamine_01</bpmn:incoming>
      <bpmn:outgoing>Seq_ToDecisionGateway_03</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gate_DecisionFailure_04">
      <bpmn:name>Confirm Failure?</bpmn:name>
      <bpmn:incoming>Seq_ToDecisionGateway_03</bpmn:incoming>
      <bpmn:outgoing>Seq_RejectPath_05</bpmn:outgoing>
      <bpmn:outgoing>Seq_ConfirmPath_06</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="End_Rejected_07">
      <bpmn:name>Fault Rejected</bpmn:name>
      <bpmn:incoming>Seq_RejectPath_05</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:task id="Task_InformCustomerFailure_08">
      <bpmn:name>Inform Customer about Failure</bpmn:name>
      <bpmn:incoming>Seq_ConfirmPath_06</bpmn:incoming>
      <bpmn:outgoing>Seq_ToManagerNotification_09</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_InformManagerFailure_10">
      <bpmn:name>Inform Manager about Failure</bpmn:name>
      <bpmn:incoming>Seq_ToManagerNotification_09</bpmn:incoming>
      <bpmn:outgoing>Seq_FixFault_11</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_FixFault_12">
      <bpmn:name>Fix Fault at Measuring Device</bpmn:name>
      <bpmn:incoming>Seq_FixFault_11</bpmn:incoming>
      <bpmn:outgoing>Seq_ShareResultsDetector_13</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="End_Resolution_14">
      <bpmn:name>Interference Resolved</bpmn:name>
      <bpmn:incoming>Seq_FinalNotification_15</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Seq_StartToExamine_01" sourceRef="Start_FaultDetected_01" targetRef="Task_ExamineFailure_02"/>
    
    <bpmn:sequenceFlow id="Seq_ToDecisionGateway_03" name="After Examination" sourceRef="Task_ExamineFailure_02" targetRef="Gate_DecisionFailure_04"/>

    <bpmn:sequenceFlow id="Seq_RejectPath_05" name="Reject Failure" sourceRef="Gate_DecisionFailure_04" targetRef="End_Rejected_07"/>
    
    <bpmn:sequenceFlow id="Seq_ConfirmPath_06" name="Confirm Failure" sourceRef="Gate_DecisionFailure_04" targetRef="Task_InformCustomerFailure_08"/>

    <bpmn:sequenceFlow id="Seq_ToManagerNotification_09" name="After Customer Notification" sourceRef="Task_InformCustomerFailure_08" targetRef="Task_InformManagerFailure_10"/>

    <bpmn:sequenceFlow id="Seq_FixFault_11" name="Proceed to Repair" sourceRef="Task_InformManagerFailure_10" targetRef="Task_FixFault_12"/>
    
    <!-- Message Flow for sharing results with fault detector -->
  </bpmn:process>

  <bpmn:process id="Process_Detector" isExecutable="false">
    <bpmn:startEvent id="Start_DetectorInitiated_16">
      <bpmn:name>Fault Detector Ready</bpmn:name>
      <bpmn:outgoing>Seq_ToFaultReport_17</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:endEvent id="End_DetectorComplete_18">
      <bpmn:name>Fault Detector Results Received</bpmn:name>
      <bpmn:incoming>Seq_ShareResultsDetector_19</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Message Flow for sharing results with fault detector -->
  </bpmn:process>

  <!-- Message Flows between participants -->
  <bpmn:messageFlow id="Msg_FaultReport" sourceRef="Start_DetectorInitiated_16" targetRef="Task_ExamineFailure_02"/>
  
</bpmn:definitions>