<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_001">
    <bpmn:participant id="Participant_FunctionalDept" name="Head of Functional Department" processRef="Process_001"/>
    <bpmn:messageFlow id="MsgFlow_VacancyRequest" sourceRef="Task_ReportVacancy" targetRef="Message_JobDescriptionReceived">
      <bpmn:sourceElement>Participant_FunctionalDept</bpmn:sourceElement>
      <bpmn:targetElement>IntermediateCatchEvent_01</bpmn:targetElement>
    </bpmn:messageFlow>
  </bpmn:collaboration>

  <bpmn:process id="Process_001" isExecutable="false">
    <bpmn:startEvent id="Start_PersonnelRequirements" name="Personnel requirements detected">
      <bpmn:outgoing>SeqFlow_ReportVacancy</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_ReportVacancy" name="Report vacancy to Personnel Department">
      <bpmn:incoming>SeqFlow_ReportVacancy</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_WaitJobDesc</bpmn:outgoing>
    </bpmn:task>

    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_01" name="Wait for Job Description">
      <bpmn:messageRef="Message_JobDescriptionReceived"/>
      <bpmn:incoming>SeqFlow_WaitJobDesc</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_ReviewDecision</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:exclusiveGateway id="Gateway_ReviewDecision" name="OK?">
      <bpmn:incoming>SeqFlow_ReviewDecision</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_ApproveDesc</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="End_JobDescriptionApproved" name="Job Description Approved">
      <bpmn:incoming>SeqFlow_Completed</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:message id="Message_JobDescriptionReceived"/>

    <bpmn:sequenceFlow id="SeqFlow_ReportVacancy" sourceRef="Start_PersonnelRequirements" targetRef="Task_ReportVacancy">
      <bpmn:name>To Report Vacancy</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SeqFlow_WaitJobDesc" name="Send to HR Department" sourceRef="Task_ReportVacancy" targetRef="IntermediateCatchEvent_01">
      <bpmn:messageRef>Message_JobDescriptionReceived</bpmn:messageRef>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SeqFlow_ReviewDecision" name="Receive Job Description" sourceRef="IntermediateCatchEvent_01" targetRef="Gateway_ReviewDecision">
      <bpmn:name>To Review</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SeqFlow_ApproveDesc" name="OK - Approved" sourceRef="Gateway_ReviewDecision" targetRef="End_JobDescriptionApproved">
      <bpmn:name>To End</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>