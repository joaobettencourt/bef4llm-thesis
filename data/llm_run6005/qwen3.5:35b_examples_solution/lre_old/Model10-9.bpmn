<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_MPO" name="MPO" processRef="Process_ChangeRequest"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_ChangeRequest" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="StartChangeRequest" name="SP/PU/GO or MPO initiates change request">
      <bpmn:outgoing>SeqFlow_ToReview</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task - Review -->
    <bpmn:task id="Task_Review" name="MPO reviews the change request">
      <bpmn:incoming>SeqFlow_ToReview</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_DecisionPoint</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway - Reject or Confirm -->
    <bpmn:exclusiveGateway id="Gateway_RejectConfirm" name="Decision: Reject or Confirm">
      <bpmn:incoming>SeqFlow_DecisionPoint</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_RejectPath</bpmn:outgoing>
      <bpmn:outgoing>SeqFlow_ConfirmPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task - Reject -->
    <bpmn:task id="Task_Reject" name="MPO rejects the change of measuring point">
      <bpmn:incoming>SeqFlow_RejectPath</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_ToEndRejected</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event - Rejected -->
    <bpmn:endEvent id="End_Rejected" name="Change Request Rejected">
      <bpmn:incoming>SeqFlow_ToEndRejected</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task - Confirm and Perform Change -->
    <bpmn:task id="Task_ConfirmPerform" name="MPO performs the measuring point change">
      <bpmn:incoming>SeqFlow_ConfirmPath</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_DecisionOutcome</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway - Implementation Success or Failure -->
    <bpmn:exclusiveGateway id="Gateway_Outcome" name="Implementation Outcome">
      <bpmn:incoming>SeqFlow_DecisionOutcome</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_SuccessPath</bpmn:outgoing>
      <bpmn:outgoing>SeqFlow_FailurePath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task - Report Implementation -->
    <bpmn:task id="Task_ReportSuccess" name="MPO reports implementation to SP/PU/GO">
      <bpmn:incoming>SeqFlow_SuccessPath</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_ToEndSuccess</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event - Success -->
    <bpmn:endEvent id="End_Success" name="Change Request Completed Successfully">
      <bpmn:incoming>SeqFlow_ToEndSuccess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task - Notify Failure -->
    <bpmn:task id="Task_NotifyFailure" name="MPO notifies SP/PU/GO about failure of changes">
      <bpmn:incoming>SeqFlow_FailurePath</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_ToEndFailure</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event - Failure -->
    <bpmn:endEvent id="End_Failure" name="Change Request Failed">
      <bpmn:incoming>SeqFlow_ToEndFailure</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SeqFlow_ToReview" sourceRef="StartChangeRequest" targetRef="Task_Review"/>
    <bpmn:sequenceFlow id="SeqFlow_DecisionPoint" name="After Review" sourceRef="Task_Review" targetRef="Gateway_RejectConfirm"/>
    <bpmn:sequenceFlow id="SeqFlow_RejectPath" name="Reject Decision" sourceRef="Gateway_RejectConfirm" targetRef="Task_Reject"/>
    <bpmn:sequenceFlow id="SeqFlow_ToEndRejected" sourceRef="Task_Reject" targetRef="End_Rejected"/>
    <bpmn:sequenceFlow id="SeqFlow_ConfirmPath" name="Confirm Decision" sourceRef="Gateway_RejectConfirm" targetRef="Task_ConfirmPerform"/>
    <bpmn:sequenceFlow id="SeqFlow_DecisionOutcome" name="After Performing Change" sourceRef="Task_ConfirmPerform" targetRef="Gateway_Outcome"/>
    <bpmn:sequenceFlow id="SeqFlow_SuccessPath" name="Implementation Successful" sourceRef="Gateway_Outcome" targetRef="Task_ReportSuccess"/>
    <bpmn:sequenceFlow id="SeqFlow_ToEndSuccess" sourceRef="Task_ReportSuccess" targetRef="End_Success"/>
    <bpmn:sequenceFlow id="SeqFlow_FailurePath" name="Implementation Failed" sourceRef="Gateway_Outcome" targetRef="Task_NotifyFailure"/>
    <bpmn:sequenceFlow id="SeqFlow_ToEndFailure" sourceRef="Task_NotifyFailure" targetRef="End_Failure"/>

  </bpmn:process>
</bpmn:definitions>