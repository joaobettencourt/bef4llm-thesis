<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_0geryc1">
    <bpmn:participant id="Participant_1ygkg4f" name="Mail Processing System" processRef="Process_1" />
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_MailProcessingUnit" name="Mail Processing Unit">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CollectMail</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Registry" name="Registry">
        <bpmn:flowNodeRef>Task_OpenSortRegister</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_QualityCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Compliance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CaptureMatterDetails</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Cashier" name="Cashier">
        <bpmn:flowNodeRef>Gateway_ParallelStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProcessFees</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event with Timer -->
    <bpmn:startEvent id="StartEvent_1" name="Daily Mail Collection">
      <bpmn:outgoing>SequenceFlow_StartToCollect</bpmn:outgoing>
      <bpmn:timerEventDefinition />
    </bpmn:startEvent>

    <!-- Tasks -->
    <bpmn:task id="Task_CollectMail" name="Sort unopened mail">
      <bpmn:incoming>SequenceFlow_StartToCollect</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToRegistry</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_OpenSortRegister" name="Open, sort and register mail">
      <bpmn:incoming>SequenceFlow_ToRegistry</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToQualityCheck</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_QualityCheck" name="Perform quality check">
      <bpmn:incoming>SequenceFlow_ToQualityCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ComplianceDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for Compliance Decision -->
    <bpmn:exclusiveGateway id="Gateway_Compliance" name="Compliant?">
      <bpmn:incoming>SequenceFlow_ComplianceDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RejectionPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ApprovalPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Rejection Path -->
    <bpmn:endEvent id="EndEvent_1" name="Requisition Sent to Party">
      <bpmn:incoming>SequenceFlow_RejectionPath</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Approval Path -->
    <bpmn:task id="Task_CaptureMatterDetails" name="Capture matter details">
      <bpmn:incoming>SequenceFlow_ApprovalPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToParallelStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway for Concurrent Activities -->
    <bpmn:parallelGateway id="Gateway_ParallelStart" name="Split">
      <bpmn:incoming>SequenceFlow_ToParallelStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FeesPath</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Cashier Tasks -->
    <bpmn:task id="Task_ProcessFees" name="Process fees and capture party details">
      <bpmn:incoming>SequenceFlow_FeesPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PrintFile</bpmn:outgoing>
    </bpmn:task>

    <!-- Final End Event -->
    <bpmn:endEvent id="EndEvent_2" name="Process Complete">
      <bpmn:incoming>SequenceFlow_PrintFile</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToCollect" sourceRef="StartEvent_1" targetRef="Task_CollectMail">
      <bpmn:name>Daily Collection</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ToRegistry" name="Distribute to Registry" sourceRef="Task_CollectMail" targetRef="Task_OpenSortRegister">
      <bpmn:name>Distributed</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ToQualityCheck" name="For Quality Check" sourceRef="Task_OpenSortRegister" targetRef="Task_QualityCheck">
      <bpmn:name>To Registry Manager</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ComplianceDecision" name="For Decision" sourceRef="Task_QualityCheck" targetRef="Gateway_Compliance">
      <bpmn:name>Quality Check Complete</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_RejectionPath" name="No - Not Compliant" sourceRef="Gateway_Compliance" targetRef="EndEvent_1">
      <bpmn:name>Requisition Sent</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ApprovalPath" name="Yes - Compliant" sourceRef="Gateway_Compliance" targetRef="Task_CaptureMatterDetails">
      <bpmn:name>Matter Details Captured</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ToParallelStart" name="To Cashier Processing" sourceRef="Task_CaptureMatterDetails" targetRef="Gateway_ParallelStart">
      <bpmn:name>To Fees Processing</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_FeesPath" name="Process Fees" sourceRef="Gateway_ParallelStart" targetRef="Task_ProcessFees">
      <bpmn:name>Fees Processing</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_PrintFile" name="Print File and Post Mail" sourceRef="Task_ProcessFees" targetRef="EndEvent_2">
      <bpmn:name>Process Complete</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>