<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_RecruitmentProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_HiringProcess">
    <bpmn:participant id="Participant_HRSystem" name="Hiring Process System" processRef="Proc_Hiring_01" />
  </bpmn:collaboration>

  <bpmn:process id="Proc_Hiring_01" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_FunctionalDept" name="Functional Department">
        <bpmn:flowNodeRef>StartEvent_Demand</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReportVacancy</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_HRDept" name="HR Department">
        <bpmn:flowNodeRef>Task_AdvertisePost</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckApplication</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConcludeContract</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Applicant" name="Applicant">
        <bpmn:flowNodeRef>Task_SubmitApplication</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Demand" name="Demand to fill post">
      <bpmn:outgoing>SeqFlow_ReportVacancy</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Tasks -->
    <bpmn:task id="Task_ReportVacancy" name="Report vacancy request">
      <bpmn:incoming>SeqFlow_ReportVacancy</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_AdvertisePost</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_AdvertisePost" name="Advertise post">
      <bpmn:incoming>SeqFlow_AdvertisePost</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_ApplicantApply</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_SubmitApplication" name="Applicants apply">
      <bpmn:incoming>SeqFlow_ApplicantApply</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_CheckApplications</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_CheckApplication" name="Check applications">
      <bpmn:incoming>SeqFlow_CheckApplications</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_ConcludeContract</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_ConcludeContract" name="Conclude contract of employment">
      <bpmn:incoming>SeqFlow_ConcludeContract</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_EndProcess</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Filled" name="Post filled">
      <bpmn:incoming>SeqFlow_EndProcess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SeqFlow_ReportVacancy" sourceRef="StartEvent_Demand" targetRef="Task_ReportVacancy">
      <bpmn:name>To HR</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SeqFlow_AdvertisePost" sourceRef="Task_ReportVacancy" targetRef="Task_AdvertisePost">
      <bpmn:name>Request Approved</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SeqFlow_ApplicantApply" sourceRef="Task_AdvertisePost" targetRef="Task_SubmitApplication">
      <bpmn:name>Public Advertisement Open</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SeqFlow_CheckApplications" sourceRef="Task_SubmitApplication" targetRef="Task_CheckApplication">
      <bpmn:name>Receive Applications</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SeqFlow_ConcludeContract" sourceRef="Task_CheckApplication" targetRef="Task_ConcludeContract">
      <bpmn:name>Select Candidate</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SeqFlow_EndProcess" sourceRef="Task_ConcludeContract" targetRef="EndEvent_Filled">
      <bpmn:name>Hiring Complete</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>