<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_RecourseProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_RecourseClerk">
    <bpmn:participant id="Participant_Clerk" name="Recourse Clerk" processRef="Proc_RecourseProcess"/>
  </bpmn:collaboration>

  <bpmn:process id="Proc_RecourseProcess" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="Start_ProbableRecourse" name="Probable recourse detected">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>Seq_StartToCheck</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Tasks -->
    <bpmn:task id="Task_GetInfo" name="Get information">
      <bpmn:incoming>Seq_StartToCheck</bpmn:incoming>
      <bpmn:outgoing>Seq_ToCaseCheck</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_CheckCase" name="Check case">
      <bpmn:incoming>Seq_ToCaseCheck</bpmn:incoming>
      <bpmn:outgoing>Seq_GatewayRecoursePossible</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for Recourse Possibility -->
    <bpmn:exclusiveGateway id="Gate_RecoursePossible" name="Recourse possible?">
      <bpmn:incoming>Seq_GatewayRecoursePossible</bpmn:incoming>
      <bpmn:outgoing>Seq_SendPaymentRequest</bpmn:outgoing>
      <bpmn:outgoing>Seq_CloseCaseNoRecourse</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Payment Request and Reminder Tasks -->
    <bpmn:task id="Task_SendPaymentRequest" name="Send request for payment">
      <bpmn:incoming>Seq_SendPaymentRequest</bpmn:incoming>
      <bpmn:outgoing>Seq_ToReminder</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_MakeReminder" name="Make reminder">
      <bpmn:incoming>Seq_ToReminder</bpmn:incoming>
      <bpmn:outgoing>Seq_EventBasedGatewayWait</bpmn:outgoing>
    </bpmn:task>

    <!-- Event-Based Gateway for Waiting Period -->
    <bpmn:eventBasedGateway id="Gate_WaitEvents" name="Waiting period">
      <bpmn:incoming>Seq_EventBasedGatewayWait</bpmn:incoming>
      <bpmn:outgoing>Seq_MoneyReceivedPath</bpmn:outgoing>
      <bpmn:outgoing>Seq_DisagreementLetterPath</bpmn:outgoing>
      <bpmn:outgoing>Seq_TimerDuePath</bpmn:outgoing>
    </bpmn:eventBasedGateway>

    <!-- Intermediate Catch Events -->
    <bpmn:intermediateCatchEvent id="IntMoneyReceived" name="Money received">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>Seq_MoneyReceivedPath</bpmn:incoming>
      <bpmn:outgoing>Seq_ToBooking</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:intermediateCatchEvent id="IntDisagreementLetter" name="Disagreement letter received">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>Seq_DisagreementLetterPath</bpmn:incoming>
      <bpmn:outgoing>Seq_CheckReasoning</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:intermediateCatchEvent id="IntTimerDue" name="Deadline reached">
      <bpmn:timerEventDefinition/>
      <bpmn:incoming>Seq_TimerDuePath</bpmn:incoming>
      <bpmn:outgoing>Seq_ToCollectionAgency</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Reasoning Check Path -->
    <bpmn:task id="Task_CheckReasoning" name="Check reasoning">
      <bpmn:incoming>Seq_CheckReasoning</bpmn:incoming>
      <bpmn:outgoing>Seq_GatewayIsRight</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for Reasoning Check -->
    <bpmn:exclusiveGateway id="Gate_IsRight" name="Reasoning OK?">
      <bpmn:incoming>Seq_GatewayIsRight</bpmn:incoming>
      <bpmn:outgoing>Seq_CloseCaseRight</bpmn:outgoing>
      <bpmn:outgoing>Seq_ToCollectionAgencyWrong</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Booking and Close Case Path -->
    <bpmn:task id="Task_MakeBooking" name="Make booking">
      <bpmn:incoming>Seq_ToBooking</bpmn:incoming>
      <bpmn:outgoing>Seq_CloseCaseMoneyReceived</bpmn:outgoing>
    </bpmn:task>

    <!-- Collection Agency Task -->
    <bpmn:task id="Task_CollectionAgency" name="Forward to collection agency">
      <bpmn:incoming>Seq_ToCollectionAgency</bpmn:incoming>
      <bpmn:outgoing>Seq_EndOpenCase</bpmn:outgoing>
    </bpmn:task>

    <!-- Close Case Tasks -->
    <bpmn:task id="Task_CloseNoRecourse" name="Close case">
      <bpmn:incoming>Seq_CloseCaseNoRecourse</bpmn:incoming>
      <bpmn:outgoing>Seq_EndClosed1</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_CloseRight" name="Close case">
      <bpmn:incoming>Seq_CloseCaseRight</bpmn:incoming>
      <bpmn:outgoing>Seq_EndClosed2Flow</bpmn:outgoing>
    </bpmn:task>

    <!-- End Events -->
    <bpmn:endEvent id="End_Closed1" name="Case closed">
      <bpmn:incoming>Seq_EndClosed1</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="End_Closed2" name="Case closed">
      <bpmn:incoming>Seq_CloseCaseMoneyReceived</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="End_Opened" name="Case open (collection)">
      <bpmn:incoming>Seq_EndOpenCase</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Seq_StartToCheck" sourceRef="Start_ProbableRecourse" targetRef="Task_GetInfo"/>
    
    <bpmn:sequenceFlow id="Seq_ToCaseCheck" sourceRef="Task_GetInfo" targetRef="Task_CheckCase"/>
    
    <bpmn:sequenceFlow id="Seq_GatewayRecoursePossible" sourceRef="Task_CheckCase" targetRef="Gate_RecoursePossible"/>
    
    <bpmn:sequenceFlow id="Seq_SendPaymentRequest" name="Yes - Recourse possible" sourceRef="Gate_RecoursePossible" targetRef="Task_SendPaymentRequest"/>
    
    <bpmn:sequenceFlow id="Seq_CloseCaseNoRecourse" name="No - No recourse" sourceRef="Gate_RecoursePossible" targetRef="Task_CloseNoRecourse"/>
    
    <bpmn:sequenceFlow id="Seq_ToReminder" sourceRef="Task_SendPaymentRequest" targetRef="Task_MakeReminder"/>
    
    <bpmn:sequenceFlow id="Seq_EventBasedGatewayWait" sourceRef="Task_MakeReminder" targetRef="Gate_WaitEvents"/>
    
    <bpmn:sequenceFlow id="Seq_MoneyReceivedPath" sourceRef="Gate_WaitEvents" targetRef="IntMoneyReceived"/>
    
    <bpmn:sequenceFlow id="Seq_DisagreementLetterPath" sourceRef="Gate_WaitEvents" targetRef="IntDisagreementLetter"/>
    
    <bpmn:sequenceFlow id="Seq_TimerDuePath" sourceRef="Gate_WaitEvents" targetRef="IntTimerDue"/>
    
    <bpmn:sequenceFlow id="Seq_CheckReasoning" sourceRef="IntDisagreementLetter" targetRef="Task_CheckReasoning"/>
    
    <bpmn:sequenceFlow id="Seq_GatewayIsRight" sourceRef="Task_CheckReasoning" targetRef="Gate_IsRight"/>
    
    <bpmn:sequenceFlow id="Seq_CloseCaseRight" name="Yes - Reasoning OK" sourceRef="Gate_IsRight" targetRef="Task_CloseRight"/>
    
    <bpmn:sequenceFlow id="Seq_ToCollectionAgencyWrong" name="No - Wrong reasoning" sourceRef="Gate_IsRight" targetRef="Task_CollectionAgency"/>
    
    <bpmn:sequenceFlow id="Seq_ToBooking" sourceRef="IntMoneyReceived" targetRef="Task_MakeBooking"/>
    
    <bpmn:sequenceFlow id="Seq_CloseCaseMoneyReceived" name="Close case after booking" sourceRef="Task_MakeBooking" targetRef="End_Closed2"/>
    
    <bpmn:sequenceFlow id="Seq_ToCollectionAgency" sourceRef="IntTimerDue" targetRef="Task_CollectionAgency"/>
    
    <bpmn:sequenceFlow id="Seq_EndClosed1" sourceRef="Task_CloseNoRecourse" targetRef="End_Closed1"/>
    
    <bpmn:sequenceFlow id="Seq_EndOpenCase" name="Forward to collection agency" sourceRef="Task_CollectionAgency" targetRef="End_Opened"/>

  </bpmn:process>
</bpmn:definitions>