<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_0" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_001">
    <bpmn:participant id="Participant_001" name="Dispatch of goods&#10;Computer Hardware Shop" processRef="Process_001" />
  </bpmn:collaboration>

  <bpmn:process id="Process_001" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Secretary" name="Secretary">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ClariyShipmentMethod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SpecialHandling</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_InsuranceCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GetOffers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectCompany</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WriteLabel</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Logistics" name="Logistics">
        <bpmn:flowNodeRef>Task_InsureParcel</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Warehouse" name="Warehouse">
        <bpmn:flowNodeRef>ParallelGateway_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PackageGoods</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Ship goods">
      <bpmn:outgoing>SequenceFlow_StartToParallel</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Parallel Gateway (Split) -->
    <bpmn:parallelGateway id="ParallelGateway_Start">
      <bpmn:name>Start Processing</bpmn:name>
      <bpmn:incoming>SequenceFlow_StartToParallel</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToSecretaryClarify</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ToWarehousePack</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Secretary Lane Tasks -->
    <bpmn:task id="Task_ClariyShipmentMethod" name="Clarify shipment method">
      <bpmn:name>Clarify shipment method</bpmn:name>
      <bpmn:incoming>SequenceFlow_ToSecretaryClarify</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SpecialHandlingDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway (Large vs Small) -->
    <bpmn:exclusiveGateway id="Gateway_SpecialHandling" name="Special handling?">
      <bpmn:name>Special handling?</bpmn:name>
      <bpmn:incoming>SequenceFlow_SpecialHandlingDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_LargeAmounts</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SmallAmounts</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Large Amount Path (Secretary) -->
    <bpmn:task id="Task_GetOffers" name="Get 3 offers from logistic companies">
      <bpmn:name>Get 3 offers&#10;from logistic&#10;companies</bpmn:name>
      <bpmn:incoming>SequenceFlow_LargeAmounts</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SelectCompanyTask</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_SelectCompany" name="Select logistic company and place order">
      <bpmn:name>Select logistic&#10;company and&#10;place order</bpmn:name>
      <bpmn:incoming>SequenceFlow_SelectCompanyTask</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SpecialPathMerge</bpmn:outgoing>
    </bpmn:task>

    <!-- Small Amount Path (Secretary) -->
    <bpmn:inclusiveGateway id="InclusiveGateway_InsuranceCheck" name="If insurance necessary">
      <bpmn:name>If insurance&#10;necessary</bpmn:name>
      <bpmn:incoming>SequenceFlow_SmallAmounts</bpmn:incoming>
    </bpmn:inclusiveGateway>

    <!-- Inclusive Gateway Outgoing Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_LabelPath" sourceRef="InclusiveGateway_InsuranceCheck" targetRef="Task_WriteLabel">
      <bpmn:name>always</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Logistics Lane Task (Conditional) -->
    <bpmn:task id="Task_InsureParcel" name="Insure parcel">
      <bpmn:name>Insure parcel</bpmn:name>
      <bpmn:incoming>SequenceFlow_InsurancePath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SmallPathMerge</bpmn:outgoing>
    </bpmn:task>

    <!-- Small Amount Path (Secretary) -->
    <bpmn:sequenceFlow id="SequenceFlow_InsurancePath" sourceRef="InclusiveGateway_InsuranceCheck" targetRef="Task_InsureParcel">
      <bpmn:name>If insurance&#10;necessary</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Small Amount Path (Secretary) -->
    <bpmn:task id="Task_WriteLabel" name="Write package label">
      <bpmn:name>Write package&#10;label</bpmn:name>
      <bpmn:incoming>SequenceFlow_LabelPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SmallPathMerge</bpmn:outgoing>
    </bpmn:task>

    <!-- Warehouse Lane Task (Parallel) -->
    <bpmn:task id="Task_PackageGoods" name="Package goods">
      <bpmn:name>Package goods</bpmn:name>
      <bpmn:incoming>SequenceFlow_ToWarehousePack</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WarehouseMerge</bpmn:outgoing>
    </bpmn:task>

    <!-- Merge Secretary Paths -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_SecretaryMerge">
      <bpmn:name>Merge Secretary</bpmn:name>
      <bpmn:incoming>SequenceFlow_SpecialPathMerge</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_SmallPathMerge</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SecretaryReady</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Merge All Paths -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_Final">
      <bpmn:name>All Ready?</bpmn:name>
      <bpmn:incoming>SequenceFlow_SecretaryReady</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_WarehouseMerge</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PreparePickup</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Final Task -->
    <bpmn:endEvent id="End_Success">
      <bpmn:name>Shipment prepared</bpmn:name>
      <bpmn:incoming>SequenceFlow_PreparePickup</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToParallel" sourceRef="StartEvent_1" targetRef="ParallelGateway_Start">
      <bpmn:name>To Processing</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ToSecretaryClarify" sourceRef="ParallelGateway_Start" targetRef="Task_ClariyShipmentMethod">
      <bpmn:name>To Secretary</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_SpecialHandlingDecision" sourceRef="Task_ClariyShipmentMethod" targetRef="Gateway_SpecialHandling">
      <bpmn:name>To Decision</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_LargeAmounts" name="yes" sourceRef="Gateway_SpecialHandling" targetRef="Task_GetOffers">
      <bpmn:name>Large amounts</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_SmallAmounts" name="no" sourceRef="Gateway_SpecialHandling" targetRef="InclusiveGateway_InsuranceCheck">
      <bpmn:name>Small amounts</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_SelectCompanyTask" sourceRef="Task_GetOffers" targetRef="Task_SelectCompany">
      <bpmn:name>To Select Company</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_SpecialPathMerge" sourceRef="Task_SelectCompany" targetRef="ExclusiveGateway_SecretaryMerge">
      <bpmn:name>Select Done</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ToWarehousePack" sourceRef="ParallelGateway_Start" targetRef="Task_PackageGoods">
      <bpmn:name>To Warehouse</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_WarehouseMerge" sourceRef="Task_PackageGoods" targetRef="ExclusiveGateway_Final">
      <bpmn:name>Packaging Done</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_SmallPathMerge" name="Small Path Merge" sourceRef="Task_WriteLabel" targetRef="ExclusiveGateway_SecretaryMerge">
      <bpmn:name>Label Done</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_InsurancePath" name="If insurance necessary" sourceRef="InclusiveGateway_InsuranceCheck" targetRef="Task_InsureParcel">
      <bpmn:name>If insurance&#10;necessary</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_SecretaryReady" sourceRef="ExclusiveGateway_SecretaryMerge" targetRef="ExclusiveGateway_Final">
      <bpmn:name>Sready</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_PreparePickup" name="All Ready" sourceRef="ExclusiveGateway_Final" targetRef="End_Success">
      <bpmn:name>All ready</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>