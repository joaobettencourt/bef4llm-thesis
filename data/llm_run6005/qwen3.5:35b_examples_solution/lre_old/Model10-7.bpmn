<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_MSPN_GO">
    <bpmn:participant id="Pool_MSPN" name="MSPN" processRef="Proc_MSPN"/>
    <bpmn:participant id="Pool_GO" name="GO" processRef="Proc_GO"/>

    <!-- Message Flow from MSPN to GO -->
    <bpmn:messageFlow id="MsgFlow_01">
      <bpmn:name>Registration Notification</bpmn:name>
      <bpmn:sourceRef="Event_MSPN_SendReg" />
      <bpmn:targetRef="Task_GO_Examine" />
    </bpmn:messageFlow>

    <!-- Message Flows from GO to external parties -->
    <bpmn:messageFlow id="MsgFlow_02">
      <bpmn:name>MSPN Assignment Notification</bpmn:name>
      <bpmn:sourceRef="Task_GO_InformMSPO" />
      <bpmn:targetRef="Event_MSPO_Awareness" />
    </bpmn:messageFlow>

    <bpmn:messageFlow id="MsgFlow_03">
      <bpmn:name>MSPN Assignment Notification</bpmn:name>
      <bpmn:sourceRef="Task_GO_InformMPO" />
      <bpmn:targetRef="Event_MPO_Awareness" />
    </bpmn:messageFlow>

    <bpmn:messageFlow id="MsgFlow_04">
      <bpmn:name>MSPN Assignment Notification</bpmn:name>
      <bpmn:sourceRef="Task_GO_InformSP" />
      <bpmn:targetRef="Event_SP_Awareness" />
    </bpmn:messageFlow>

  </bpmn:collaboration>

  <!-- MSPN Process -->
  <bpmn:process id="Proc_MSPN" isExecutable="false">
    <bpmn:startEvent id="Start_MSPN_Register" name="Register Measurement at GO">
      <bpmn:outgoing>SeqFlow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Intermediate Event for notification -->
    <bpmn:intermediateThrowEvent id="Event_MSPN_SendReg" name="Send Registration Notification">
      <bpmn:messageRef="Message_RegNotification"/>
      <bpmn:outgoing>SeqFlow_02</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SeqFlow_01" sourceRef="Start_MSPN_Register" targetRef="Task_MSPN_Register">
      <bpmn:name>To Registration</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Task for MSPN -->
    <bpmn:task id="Task_MSPN_Register" name="Register Measurement at GO">
      <bpmn:incoming>SeqFlow_01</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_02</bpmn:outgoing>
    </bpmn:task>

  </bpmn:process>

  <!-- GO Process -->
  <bpmn:process id="Proc_GO" isExecutable="false">
    <bpmn:startEvent id="Start_GO_Receive" name="Receive Registration Notification">
      <bpmn:messageRef="Message_RegNotification"/>
      <bpmn:outgoing>SeqFlow_GO_01</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Examine Application -->
    <bpmn:task id="Task_GO_Examine" name="Examine MSPN Application">
      <bpmn:incoming>SeqFlow_GO_01</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_GO_02</bpmn:outgoing>
    </bpmn:task>

    <!-- Decision Gateway -->
    <bpmn:exclusiveGateway id="Gate_Decision" name="Decision">
      <bpmn:incoming>SeqFlow_GO_02</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_GO_Reject</bpmn:outgoing>
      <bpmn:outgoing>SeqFlow_GO_Confirm</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 2a: Reject -->
    <bpmn:endEvent id="End_REJECT" name="Application Rejected">
      <bpmn:incoming>SeqFlow_GO_Reject</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flow for Reject Path -->
    <bpmn:sequenceFlow id="SeqFlow_GO_Reject" sourceRef="Gate_Decision" targetRef="End_REJECT">
      <bpmn:name>Reject</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Task 2b: Confirm -->
    <bpmn:task id="Task_GO_Confirm" name="Confirm Application of MSPN">
      <bpmn:incoming>SeqFlow_GO_Confirm</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_GO_04</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow for Confirm Path -->
    <bpmn:sequenceFlow id="SeqFlow_GO_Confirm" sourceRef="Gate_Decision" targetRef="Task_GO_Confirm">
      <bpmn:name>Confirm</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Task 3: Assign MSPN -->
    <bpmn:task id="Task_GO_Assign" name="Assign MSPN">
      <bpmn:incoming>SeqFlow_GO_04</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_GO_05</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 4a: Inform MSPO -->
    <bpmn:endEvent id="End_MSPO" name="MSPO Informed">
      <bpmn:incoming>SeqFlow_GO_06</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:task id="Task_GO_InformMSPO" name="Inform MSPO about Assignment of MSPN">
      <bpmn:incoming>SeqFlow_GO_05</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_GO_06</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 4b: Inform MPO -->
    <bpmn:endEvent id="End_MPO" name="MPO Informed">
      <bpmn:incoming>SeqFlow_GO_07</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:task id="Task_GO_InformMPO" name="Inform MPO about Assignment of MSPN">
      <bpmn:incoming>SeqFlow_GO_06</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_GO_07</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 4c: Inform SP -->
    <bpmn:endEvent id="End_SP" name="SP Informed">
      <bpmn:incoming>SeqFlow_GO_08</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:task id="Task_GO_InformSP" name="Inform SP about Assignment of MSPN">
      <bpmn:incoming>SeqFlow_GO_07</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_GO_08</bpmn:outgoing>
    </bpmn:task>

    <!-- Final End Event -->
    <bpmn:endEvent id="End_ALL_INFORMED" name="All Parties Informed">
      <bpmn:incoming>SeqFlow_GO_Final</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flow for SP to Final End -->
    <bpmn:sequenceFlow id="SeqFlow_GO_08" sourceRef="Task_GO_InformSP" targetRef="End_ALL_INFORMED">
      <bpmn:name>To Completion</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>

  <!-- Message Definitions -->
  <bpmn:message id="Message_RegNotification"/>
  <bpmn:message id="Message_AssignmentNotification"/>

</bpmn:definitions>