<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_UnderwriterProcess">
    <bpmn:participant id="Participant_Underwriter" name="Underwriter Process" processRef="Proc_UnderwriterIPO"/>
  </bpmn:collaboration>

  <bpmn:process id="Proc_UnderwriterIPO" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="Start_DecisionToGoPublic" name="Decision to Go Public">
      <bpmn:outgoing>SeqFlow_SelectUnderwriters</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Select Underwriters -->
    <bpmn:task id="Task_SelectUnderwriters" name="Select Underwriters">
      <bpmn:incoming>SeqFlow_SelectUnderwriters</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_StartParallelPath1</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway for concurrent paths -->
    <bpmn:parallelGateway id="PG_ConcurrentTasks" name="Concurrent Tasks">
      <bpmn:incoming>SeqFlow_StartParallelPath1</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_CheckFacts</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Check Facts Presented (Reputation check) -->
    <bpmn:task id="Task_CheckFacts" name="Check Facts Presented">
      <bpmn:incoming>SeqFlow_CheckFacts</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_FactsDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway for facts check -->
    <bpmn:exclusiveGateway id="GW_FactsOK" name="Facts OK?">
      <bpmn:incoming>SeqFlow_FactsDecision</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_ProceedIPO</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event for rejection -->
    <bpmn:endEvent id="End_Rejected" name="Process Rejected">
      <bpmn:incoming>SeqFlow_Rejected</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Parallel Gateway 2 - Registration and Compliance (concurrent) -->
    <bpmn:parallelGateway id="PG_ConcurrentTasks2" name="Registration &amp; Compliance">
      <bpmn:incoming>SeqFlow_ProceedIPO</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_PrepareRegStatement</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Prepare Registration Statement for SEC -->
    <bpmn:task id="Task_PrepareRegistration" name="Prepare Registration Statement">
      <bpmn:incoming>SeqFlow_PrepareRegStatement</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_RegToSyncPoint</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Check Blue-Sky Laws Compliance -->
    <bpmn:task id="Task_CheckCompliance" name="Check Blue-Sky Law Compliance">
      <bpmn:incoming>SeqFlow_CompliancePath</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_ComplToSyncPoint</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway 3 - Sync after registration and compliance -->
    <bpmn:parallelGateway id="PG_SyncTasks" name="Wait for SEC">
      <bpmn:incoming>SeqFlow_RegToSyncPoint</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_RoadShowStart</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Road Show - Talk to Investors -->
    <bpmn:task id="Task_Roadshow" name="Road Show (Talk to Investors)">
      <bpmn:incoming>SeqFlow_RoadShowStart</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_WaitSECAnswer</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Catch Event - SEC Answer -->
    <bpmn:intermediateCatchEvent id="IEC_SECResponse" name="Wait for SEC Clearance">
      <bpmn:incoming>SeqFlow_WaitSECAnswer</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_SECClearanceReceived</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Exclusive Gateway - SEC Approval Decision -->
    <bpmn:exclusiveGateway id="GW_SECApproved" name="SEC Approved?">
      <bpmn:incoming>SeqFlow_SECClearanceReceived</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_ApprovedProceed</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event for SEC rejection -->
    <bpmn:endEvent id="End_SECRejected" name="SEC Rejected">
      <bpmn:incoming>SeqFlow_SECNoApproval</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task: Fix Issue Price (after SEC approval) -->
    <bpmn:task id="Task_FixIssuePrice" name="Fix Issue Price">
      <bpmn:incoming>SeqFlow_ApprovedProceed</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_BuyStock</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Buy Stock (Firm Commitment) -->
    <bpmn:task id="Task_FirmCommitment" name="Buy Stock">
      <bpmn:incoming>SeqFlow_BuyStock</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_OfferPublic</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Offer to Public -->
    <bpmn:task id="Task_OffertoPublic" name="Offer Stock to Public">
      <bpmn:incoming>SeqFlow_OfferPublic</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_ProcessComplete</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event - Process Complete -->
    <bpmn:endEvent id="End_Success" name="IPO Completed Successfully">
      <bpmn:incoming>SeqFlow_ProcessComplete</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SeqFlow_SelectUnderwriters" sourceRef="Start_DecisionToGoPublic" targetRef="Task_SelectUnderwriters"/>
    
    <bpmn:sequenceFlow id="SeqFlow_StartParallelPath1" name="Proceed to Tasks" sourceRef="Task_SelectUnderwriters" targetRef="PG_ConcurrentTasks"/>

    <bpmn:sequenceFlow id="SeqFlow_CheckFacts" sourceRef="PG_ConcurrentTasks" targetRef="Task_CheckFacts"/>
    
    <bpmn:sequenceFlow id="SeqFlow_FactsDecision" name="Check Facts Result" sourceRef="Task_CheckFacts" targetRef="GW_FactsOK"/>

    <bpmn:sequenceFlow id="SeqFlow_Rejected" name="No - Rejected" sourceRef="GW_FactsOK" targetRef="End_Rejected"/>
    
    <bpmn:sequenceFlow id="SeqFlow_ProceedIPO" name="Yes - Proceed IPO" sourceRef="GW_FactsOK" targetRef="PG_ConcurrentTasks2"/>

    <bpmn:parallelGateway id="PG_CompliancePathStart">
      <bpmn:incoming>SeqFlow_StartParallelPath1</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_CompliancePath</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:sequenceFlow id="SeqFlow_PrepareRegStatement" sourceRef="PG_ConcurrentTasks2" targetRef="Task_PrepareRegistration"/>
    
    <bpmn:sequenceFlow id="SeqFlow_CompliancePath" name="Check Compliance Path" sourceRef="PG_CompliancePathStart" targetRef="Task_CheckCompliance"/>

    <bpmn:parallelGateway id="PG_SyncTasks2">
      <bpmn:incoming>SeqFlow_RegToSyncPoint</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_RoadShowStart</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:sequenceFlow id="SeqFlow_ComplToSyncPoint" sourceRef="Task_CheckCompliance" targetRef="PG_SyncTasks2"/>
    
    <bpmn:sequenceFlow id="SeqFlow_RegToSyncPoint" name="Registration Complete" sourceRef="Task_PrepareRegistration" targetRef="PG_SyncTasks2"/>

    <bpmn:parallelGateway id="PG_RoadshowStart">
      <bpmn:incoming>SeqFlow_ComplToSyncPoint</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_RoadShowStart</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:sequenceFlow id="SeqFlow_RegToRoadshow" sourceRef="PG_SyncTasks2" targetRef="Task_PrepareRegistration"/>

    <!-- Corrected flow structure -->
    
  </bpmn:process>
</bpmn:definitions>