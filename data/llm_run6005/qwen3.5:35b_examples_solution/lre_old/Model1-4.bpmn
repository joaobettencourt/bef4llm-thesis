<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_001">
    <bpmn:participant id="Participant_001" name="Underwriter Process" processRef="Process_001"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_001" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="Start_Event_SelectUnderwriters">
      <bpmn:name>Select Underwriters</bpmn:name>
      <bpmn:description>Company decides to go public and selects underwriters</bpmn:description>
      <bpmn:outgoing>SeqFlow_StartToCheckFacts</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task -->
    <bpmn:task id="Task_CheckFacts">
      <bpmn:name>Check Facts Presented Fairly</bpmn:name>
      <bpmn:description>Underwriters verify facts are presented fairly before proceeding</bpmn:description>
      <bpmn:incoming>SeqFlow_StartToCheckFacts</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_CheckFactsDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway -->
    <bpmn:exclusiveGateway id="Gate_FairPresentation">
      <bpmn:name>Facts Fair?</bpmn:name>
      <bpmn:description>Underwriters check if facts are presented fairly</bpmn:description>
      <bpmn:incoming>SeqFlow_CheckFactsDecision</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_ProceedToRegistration</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event - Cancelled -->
    <bpmn:endEvent id="End_Cancelled">
      <bpmn:name>Process Cancelled</bpmn:name>
      <bpmn:description>Facts not presented fairly - underwriter declines to proceed</bpmn:description>
      <bpmn:incoming>SeqFlow_FairNoCancel</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Parallel Gateway -->
    <bpmn:parallelGateway id="Parallel_StartRegistration">
      <bpmn:name>Start Registration &amp; Compliance Check</bpmn:name>
      <bpmn:description>Begin parallel tasks for SEC registration and state law compliance</bpmn:description>
      <bpmn:incoming>SeqFlow_ProceedToRegistration</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_PrepareStatement</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task -->
    <bpmn:task id="Task_PrepareSEC">
      <bpmn:name>Prepare Registration Statement for SEC Approval</bpmn:name>
      <bpmn:description>Create registration statement to be submitted to Securities and Exchange Commission</bpmn:description>
      <bpmn:incoming>SeqFlow_PrepareStatement</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_SubmitSECStatement</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Catch Event -->
    <bpmn:intermediateCatchEvent id="Intermediate_SECApproval">
      <bpmn:name>Awaiting SEC Approval</bpmn:name>
      <bpmn:description>Catch event for receiving clearance from Securities and Exchange Commission</bpmn:description>
      <bpmn:incoming>SeqFlow_SubmitSECStatement</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_CompletionSECApproval</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task -->
    <bpmn:task id="Task_BlueSkyCheck">
      <bpmn:name>Check Blue-Sky Law Compliance</bpmn:name>
      <bpmn:description>Verify issue complies with blue-sky laws of each state regulating securities sales</bpmn:description>
      <bpmn:incoming>SeqFlow_StartCompliance</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_CompletionBlueSky</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway -->
    <bpmn:parallelGateway id="Parallel_MergeRegistration">
      <bpmn:name>Merge Registration &amp; Compliance Paths</bpmn:name>
      <bpmn:description>Synchronize completion of SEC registration and state law compliance checks</bpmn:description>
      <bpmn:incoming>SeqFlow_CompletionSECApproval</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_StartRoadshow</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task -->
    <bpmn:task id="Task_RoadShow">
      <bpmn:name>Arrange Road Show to Potential Investors</bpmn:name>
      <bpmn:description>Firm up issue price through investor road show while awaiting SEC approval</bpmn:description>
      <bpmn:incoming>SeqFlow_StartRoadshow</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_CompletionRoadshow</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway -->
    <bpmn:parallelGateway id="Parallel_MergePriceFirming">
      <bpmn:name>Merge Price Firming Paths</bpmn:name>
      <bpmn:description>Synchronize SEC clearance and road show completion before fixing issue price</bpmn:description>
      <bpmn:incoming>SeqFlow_CompletionRoadshow</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_FixIssuePrice</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task -->
    <bpmn:task id="Task_FixIssuePrice">
      <bpmn:name>Fix Issue Price</bpmn:name>
      <bpmn:description>Finalize the issue price after SEC clearance and road show completion</bpmn:description>
      <bpmn:incoming>SeqFlow_FixIssuePrice</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_FixPriceDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway -->
    <bpmn:exclusiveGateway id="Gate_ProceedToOffer">
      <bpmn:name>No Reason Not to Proceed?</bpmn:name>
      <bpmn:description>Final decision point before entering firm commitment</bpmn:description>
      <bpmn:incoming>SeqFlow_FixPriceDecision</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_NoProceedCancel</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event - Cancelled -->
    <bpmn:endEvent id="End_Cancelled_Price">
      <bpmn:name>Process Cancelled - Price Issue</bpmn:name>
      <bpmn:description>Firm commitment not entered due to issues discovered during price fixing</bpmn:description>
      <bpmn:incoming>SeqFlow_NoProceedCancel</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task -->
    <bpmn:task id="Task_FirmCommitment">
      <bpmn:name>Enter Firm Commitment to Buy Stock</bpmn:name>
      <bpmn:description>Underwriters commit to purchase the stock from company at fixed price</bpmn:description>
      <bpmn:incoming>SeqFlow_ProceedToBuy</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_OfferToPublicComplete</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event - Success -->
    <bpmn:endEvent id="End_Success">
      <bpmn:name>Offer to Public - Process Complete</bpmn:name>
      <bpmn:description>Stock successfully offered to public after firm commitment entered</bpmn:description>
      <bpmn:incoming>SeqFlow_OfferToPublicComplete</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SeqFlow_StartToCheckFacts" sourceRef="Start_Event_SelectUnderwriters" targetRef="Task_CheckFacts"/>
    
    <bpmn:sequenceFlow id="SeqFlow_CheckFactsDecision" sourceRef="Task_CheckFacts" targetRef="Gate_FairPresentation"/>

    <bpmn:sequenceFlow id="SeqFlow_ProceedToRegistration" name="Yes - Facts Fair" sourceRef="Gate_FairPresentation" targetRef="Parallel_StartRegistration"/>
    
    <bpmn:sequenceFlow id="SeqFlow_FairNoCancel" name="No - Facts Not Fair" sourceRef="Gate_FairPresentation" targetRef="End_Cancelled"/>

    <bpmn:sequenceFlow id="SeqFlow_PrepareStatement" sourceRef="Parallel_StartRegistration" targetRef="Task_PrepareSEC"/>
    
    <bpmn:sequenceFlow id="SeqFlow_SubmitSECStatement" name="Submit to SEC" sourceRef="Task_PrepareSEC" targetRef="Intermediate_SECApproval"/>

    <bpmn:sequenceFlow id="SeqFlow_StartCompliance" sourceRef="Parallel_StartRegistration" targetRef="Task_BlueSkyCheck"/>
    
    <bpmn:sequenceFlow id="SeqFlow_CompletionSECApproval" name="SEC Approval Received" sourceRef="Intermediate_SECApproval" targetRef="Parallel_MergeRegistration"/>

    <bpmn:sequenceFlow id="SeqFlow_CompletionBlueSky" name="Compliance Check Complete" sourceRef="Task_BlueSkyCheck" targetRef="Parallel_MergeRegistration"/>
    
    <bpmn:sequenceFlow id="SeqFlow_StartRoadshow" sourceRef="Parallel_MergeRegistration" targetRef="Task_RoadShow"/>

    <bpmn:sequenceFlow id="SeqFlow_CompletionRoadshow" name="Road Show Complete" sourceRef="Task_RoadShow" targetRef="Parallel_MergePriceFirming"/>
    
    <bpmn:sequenceFlow id="SeqFlow_FixIssuePrice" name="All Paths Complete" sourceRef="Parallel_MergePriceFirming" targetRef="Task_FixIssuePrice"/>

    <bpmn:sequenceFlow id="SeqFlow_FixPriceDecision" sourceRef="Task_FixIssuePrice" targetRef="Gate_ProceedToOffer"/>
    
    <bpmn:sequenceFlow id="SeqFlow_NoProceedCancel" name="Reason Not to Proceed" sourceRef="Gate_ProceedToOffer" targetRef="End_Cancelled_Price"/>

    <bpmn:sequenceFlow id="SeqFlow_ProceedToBuy" name="Proceed" sourceRef="Gate_ProceedToOffer" targetRef="Task_FirmCommitment"/>
    
    <bpmn:sequenceFlow id="SeqFlow_OfferToPublicComplete" sourceRef="Task_FirmCommitment" targetRef="End_Success"/>

  </bpmn:process>
</bpmn:definitions>