<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Internship_1">
  <bpmn:collaboration>
    <bpmn:participant id="Participant_InternProcess" name="Internship Process Service" processRef="Process_InternExecution"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_InternExecution" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Applicant" name="Applicant (Intern)">
        <bpmn:flowNodeRef>bpmnStartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bpmnTask_EnterDetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bpmnGateway_CheckRegistration</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bpmnIntermediateCatch_OffersArrive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bpmnTask_ProcessOffer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bpmnGateway_DecideAcceptance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bpmnParallelGateway_InternshipStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bpmnTask_WriteStatusUpdate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bpmnGateway_CheckUpdatesCount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bpmnParallelGateway_InternshipEnd</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Company" name="Company (Employer)">
        <bpmn:flowNodeRef>bpmnTask_WriteStatusAboutIntern</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bpmnGateway_CheckUpdatesCount_Comp</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Recommendation" name="Recommendation">
        <bpmn:flowNodeRef>bpmnTask_RecommendCompany</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bpmnGateway_Recommendation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bpmnParallelGateway_TweetsSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bpmnSendTask_Tweet1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bpmnSendTask_Tweet2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bpmnParallelGateway_MergeTweets</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="bpmnStartEvent_1" name="Internship Application">
      <bpmn:outgoing>bpmnSequenceFlow_StartToEntry</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Entry Task -->
    <bpmn:userTask id="bpmnTask_EnterDetails" name="Enter Topic, Money, Experience &amp; Hobbies">
      <bpmn:incoming>bpmnSequenceFlow_StartToEntry</bpmn:incoming>
      <bpmn:outgoing>bpmnSequenceFlow_EntryToCheckReg</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Registration Check -->
    <bpmn:exclusiveGateway id="bpmnGateway_CheckRegistration" name="Is Registered?">
      <bpmn:incoming>bpmnSequenceFlow_EntryToCheckReg</bpmn:incoming>
      <bpmn:outgoing>bpmnSequenceFlow_RegYes</bpmn:outgoing>
      <bpmn:outgoing>bpmnSequenceFlow_RegNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Wait for Offers -->
    <bpmn:intermediateCatchEvent id="bpmnIntermediateCatch_OffersArrive" name="Offers Arrival">
      <bpmn:messageRef>bpmnMessage_InternshipOffer</bpmn:messageRef>
      <bpmn:incoming>bpmnSequenceFlow_RegYes</bpmn:incoming>
      <bpmn:outgoing>bpmnSequenceFlow_WaitToProcess</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Process Offer -->
    <bpmn:userTask id="bpmnTask_ProcessOffer" name="Accept or Deny Offers">
      <bpmn:incoming>bpmnSequenceFlow_WaitToProcess</bpmn:incoming>
      <bpmn:outgoing>bpmnSequenceFlow_OfferDecision</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Acceptance Decision -->
    <bpmn:exclusiveGateway id="bpmnGateway_DecideAcceptance" name="Offer Accepted?">
      <bpmn:incoming>bpmnSequenceFlow_OfferDecision</bpmn:incoming>
      <bpmn:outgoing>bpmnSequenceFlow_AcceptedYes</bpmn:outgoing>
      <bpmn:outgoing>bpmnSequenceFlow_AcceptedNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Internship Start Parallel Split -->
     <bpmn:parallelGateway id="bpmnParallelGateway_InternshipStart" name="">
       <bpmn:incoming>bpmnSequenceFlow_AcceptedYes</bpmn:incoming>
       <bpmn:outgoing>bpmnSequenceFlow_InternStartUpdates</bpmn:outgoing>
       <bpmn:outgoing>bpmnSequenceFlow_CompanyStartUpdates</bpmn:outgoing>
     </bpmn:parallelGateway>

    <!-- Intern Updates Loop -->
    <bpmn:userTask id="bpmnTask_WriteStatusUpdate" name="Write Internship Status">
      <bpmn:incoming>bpmnSequenceFlow_InternStartUpdates</bpmn:incoming>
      <bpmn:outgoing>bpmnSequenceFlow_CheckInternCount</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Check Intern Updates Count -->
    <bpmn:exclusiveGateway id="bpmnGateway_CheckUpdatesCount" name="3 Statuses Written?">
      <bpmn:incoming>bpmnSequenceFlow_CheckInternCount</bpmn:incoming>
      <bpmn:outgoing>bpmnSequenceFlow_InternLoopBack</bpmn:outgoing>
      <bpmn:outgoing>bpmnSequenceFlow_InternDoneToMerge</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Company Updates Loop -->
    <bpmn:userTask id="bpmnTask_WriteStatusAboutIntern" name="Write Company Report">
      <bpmn:incoming>bpmnSequenceFlow_CompanyStartUpdates</bpmn:incoming>
      <bpmn:outgoing>bpmnSequenceFlow_CheckCompCount</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Check Company Updates Count -->
    <bpmn:exclusiveGateway id="bpmnGateway_CheckUpdatesCount_Comp" name="3 Reports Written?">
      <bpmn:incoming>bpmnSequenceFlow_CheckCompCount</bpmn:incoming>
      <bpmn:outgoing>bpmnSequenceFlow_CompanyLoopBack</bpmn:outgoing>
      <bpmn:outgoing>bpmnSequenceFlow_CompDoneToMerge</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Merge after updates -->
     <bpmn:parallelGateway id="bpmnParallelGateway_InternshipEnd" name="">
       <bpmn:incoming>bpmnSequenceFlow_InternDoneToMerge</bpmn:incoming>
       <bpmn:incoming>bpmnSequenceFlow_CompDoneToMerge</bpmn:incoming>
       <bpmn:outgoing>bpmnSequenceFlow_InternshipFinishedToRec</bpmn:outgoing>
     </bpmn:parallelGateway>

    <!-- Recommendation -->
    <bpmn:userTask id="bpmnTask_RecommendCompany" name="Recommend Company to Friends">
      <bpmn:incoming>bpmnSequenceFlow_InternshipFinishedToRec</bpmn:incoming>
      <bpmn:outgoing>bpmnSequenceFlow_RecDecision</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Recommendation Decision -->
    <bpmn:exclusiveGateway id="bpmnGateway_Recommendation" name="Recommend?">
      <bpmn:incoming>bpmnSequenceFlow_RecDecision</bpmn:incoming>
      <bpmn:outgoing>bpmnSequenceFlow_SendTweetsYes</bpmn:outgoing>
      <bpmn:outgoing>bpmnSequenceFlow_SendTweetsNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Tweets Split -->
     <bpmn:parallelGateway id="bpmnParallelGateway_TweetsSplit" name="">
       <bpmn:incoming>bpmnSequenceFlow_SendTweetsYes</bpmn:incoming>
       <bpmn:outgoing>bpmnSequenceFlow_SplitToTweet1</bpmn:outgoing>
       <bpmn:outgoing>bpmnSequenceFlow_SplitToTweet2</bpmn:outgoing>
     </bpmn:parallelGateway>

    <!-- Send Tweet 1 -->
    <bpmn:sendTask id="bpmnSendTask_Tweet1" name="Send Twitter Recommendation">
      <bpmn:incoming>bpmnSequenceFlow_SplitToTweet1</bpmn:incoming>
      <bpmn:outgoing>bpmnSequenceFlow_MergeTweets_1</bpmn:outgoing>
    </bpmn:sendTask>

     <!-- Send Tweet 2 -->
    <bpmn:sendTask id="bpmnSendTask_Tweet2" name="Send Twitter Recommendation">
      <bpmn:incoming>bpmnSequenceFlow_SplitToTweet2</bpmn:incoming>
      <bpmn:outgoing>bpmnSequenceFlow_MergeTweets_1</bpmn:outgoing>
    </bpmn:sendTask>

     <!-- Merge Tweets -->
     <bpmn:parallelGateway id="bpmnParallelGateway_MergeTweets" name="">
       <bpmn:incoming>bpmnSequenceFlow_MergeTweets_1</bpmn:incoming>
       <bpmn:outgoing>bpmnSequenceFlow_ToEndEvent</bpmn:outgoing>
     </bpmn:parallelGateway>

    <!-- End Event -->
    <bpmn:endEvent id="bpmnEnd_InternshipFinished" name="Internship Finished">
      <bpmn:incoming>bpmnSequenceFlow_ToEndEvent</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="bpmnSequenceFlow_StartToEntry" sourceRef="bpmnStartEvent_1" targetRef="bpmnTask_EnterDetails">
      <bpmn:name><![CDATA[Application]]></bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="bpmnSequenceFlow_EntryToCheckReg" sourceRef="bpmnTask_EnterDetails" targetRef="bpmnGateway_CheckRegistration">
      <bpmn:name><![CDATA[Submit]]></bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="bpmnSequenceFlow_RegYes" sourceRef="bpmnGateway_CheckRegistration" targetRef="bpmnIntermediateCatch_OffersArrive">
      <bpmn:name><![CDATA[Registered]]></bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="bpmnSequenceFlow_RegNo" sourceRef="bpmnGateway_CheckRegistration" targetRef="bpmnTask_EnterDetails">
      <bpmn:name><![CDATA[Not Registered]]></bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="bpmnSequenceFlow_WaitToProcess" sourceRef="bpmnIntermediateCatch_OffersArrive" targetRef="bpmnTask_ProcessOffer">
      <bpmn:name><![CDATA[Offers Arrived]]></bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="bpmnSequenceFlow_OfferDecision" sourceRef="bpmnTask_ProcessOffer" targetRef="bpmnGateway_DecideAcceptance">
      <bpmn:name><![CDATA[Process]]></bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="bpmnSequenceFlow_AcceptedYes" sourceRef="bpmnGateway_DecideAcceptance" targetRef="bpmnParallelGateway_InternshipStart">
      <bpmn:name><![CDATA[Accepted]]></bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="bpmnSequenceFlow_AcceptedNo" sourceRef="bpmnGateway_DecideAcceptance" targetRef="bpmnIntermediateCatch_OffersArrive">
      <bpmn:name><![CDATA[Denied]]></bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Intern Updates Loop -->
    <bpmn:sequenceFlow id="bpmnSequenceFlow_InternStartUpdates" sourceRef="bpmnParallelGateway_InternshipStart" targetRef="bpmnTask_WriteStatusUpdate">
      <bpmn:name><![CDATA[Write Status]]></bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="bpmnSequenceFlow_CheckInternCount" sourceRef="bpmnTask_WriteStatusUpdate" targetRef="bpmnGateway_CheckUpdatesCount">
      <bpmn:name><![CDATA[Check Count]]></bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="bpmnSequenceFlow_InternLoopBack" sourceRef="bpmnGateway_CheckUpdatesCount" targetRef="bpmnTask_WriteStatusUpdate">
      <bpmn:name><![CDATA[Less than 3]]></bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Company Updates Loop -->
     <bpmn:sequenceFlow id="bpmnSequenceFlow_CompanyStartUpdates" sourceRef="bpmnParallelGateway_InternshipStart" targetRef="bpmnTask_WriteStatusAboutIntern">
      <bpmn:name><![CDATA[Write Report]]></bpmn:name>
    </bpmn:sequenceFlow>

     <bpmn:sequenceFlow id="bpmnSequenceFlow_CheckCompCount" sourceRef="bpmnTask_WriteStatusAboutIntern" targetRef="bpmnGateway_CheckUpdatesCount_Comp">
      <bpmn:name><![CDATA[Check Count]]></bpmn:name>
    </bpmn:sequenceFlow>

     <bpmn:sequenceFlow id="bpmnSequenceFlow_CompanyLoopBack" sourceRef="bpmnGateway_CheckUpdatesCount_Comp" targetRef="bpmnTask_WriteStatusAboutIntern">
      <bpmn:name><![CDATA[Less than 3]]></bpmn:name>
    </bpmn:sequenceFlow>

     <!-- Merge after updates -->
    <bpmn:sequenceFlow id="bpmnSequenceFlow_InternDoneToMerge" sourceRef="bpmnGateway_CheckUpdatesCount" targetRef="bpmnParallelGateway_InternshipEnd">
      <bpmn:name><![CDATA[3 Written]]></bpmn:name>
    </bpmn:sequenceFlow>

     <bpmn:sequenceFlow id="bpmnSequenceFlow_CompDoneToMerge" sourceRef="bpmnGateway_CheckUpdatesCount_Comp" targetRef="bpmnParallelGateway_InternshipEnd">
      <bpmn:name><![CDATA[3 Written]]></bpmn:name>
    </bpmn:sequenceFlow>

     <!-- Recommendation Flow -->
    <bpmn:sequenceFlow id="bpmnSequenceFlow_InternshipFinishedToRec" sourceRef="bpmnParallelGateway_InternshipEnd" targetRef="bpmnTask_RecommendCompany">
      <bpmn:name><![CDATA[Finish]]></bpmn:name>
    </bpmn:sequenceFlow>

     <!-- Recommendation Decision -->
    <bpmn:sequenceFlow id="bpmnSequenceFlow_RecDecision" sourceRef="bpmnTask_RecommendCompany" targetRef="bpmnGateway_Recommendation">
      <bpmn:name><![CDATA[Recommend?]]></bpmn:name>
    </bpmn:sequenceFlow>

     <!-- Tweets Split -->
    <bpmn:sequenceFlow id="bpmnSequenceFlow_SendTweetsYes" sourceRef="bpmnGateway_Recommendation" targetRef="bpmnParallelGateway_TweetsSplit">
      <bpmn:name><![CDATA[Yes]]></bpmn:name>
    </bpmn:sequenceFlow>

     <!-- Tweets No -->
    <bpmn:sequenceFlow id="bpmnSequenceFlow_SendTweetsNo" sourceRef="bpmnGateway_Recommendation" targetRef="bpmnEnd_InternshipFinished">
      <bpmn:name><![CDATA[No]]></bpmn:name>
    </bpmn:sequenceFlow>

     <!-- Tweet Parallel -->
    <bpmn:sequenceFlow id="bpmnSequenceFlow_SplitToTweet1" sourceRef="bpmnParallelGateway_TweetsSplit" targetRef="bpmnSendTask_Tweet1">
      <bpmn:name><![CDATA[Split]]></bpmn:name>
    </bpmn:sequenceFlow>

     <!-- Tweet 2 -->
    <bpmn:sequenceFlow id="bpmnSequenceFlow_SplitToTweet2" sourceRef="bpmnParallelGateway_TweetsSplit" targetRef="bpmnSendTask_Tweet2">
      <bpmn:name><![CDATA[Split]]></bpmn:name>
    </bpmn:sequenceFlow>

     <!-- Merge Tweets -->
    <bpmn:sequenceFlow id="bpmnSequenceFlow_MergeTweets_1" sourceRef="bpmnSendTask_Tweet1" targetRef="bpmnParallelGateway_MergeTweets">
      <bpmn:name><![CDATA[End Tweet]]></bpmn:name>
    </bpmn:sequenceFlow>

     <!-- Final End -->
    <bpmn:sequenceFlow id="bpmnSequenceFlow_ToEndEvent" sourceRef="bpmnParallelGateway_MergeTweets" targetRef="bpmnEnd_InternshipFinished">
      <bpmn:name><![CDATA[Finish]]></bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>

  <!-- Message Definitions -->
   <bpmn:message id="bpmnMessage_InternshipOffer" name="Internship Offer"/>

</bpmn:definitions>