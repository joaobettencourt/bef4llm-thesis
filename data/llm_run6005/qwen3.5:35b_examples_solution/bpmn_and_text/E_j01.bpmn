<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_FindJob_1">
  <bpmn:process id="Process_FindJob_Execution" isExecutable="false">

    <!-- Start Event -->
    <bpmn:startEvent id="Start_Unemployed" name="Unemployed">
      <bpmn:outgoing>Flow_StartToAppLoop</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Tasks related to Application -->
    <bpmn:task id="Task_WriteApplication" name="Write job application">
      <bpmn:incoming>Flow_AppLoopBack</bpmn:incoming>
      <bpmn:outgoing>Flow_SendApp</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_SendApplication" name="Send job application">
      <bpmn:incoming>Flow_SendApp</bpmn:incoming>
      <bpmn:outgoing>Flow_ReportApp</bpmn:outgoing>
    </bpmn:task>

    <!-- Reporting Task -->
    <bpmn:task id="Task_ReportApplication" name="Report job application">
      <bpmn:incoming>Flow_ReportApp</bpmn:incoming>
      <bpmn:outgoing>Flow_ParallelSplit1</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway for receiving feedback and offers -->
    <bpmn:parallelGateway id="Parallel_Gateway_Receive" name="">
      <bpmn:incoming>Flow_ParallelSplit1</bpmn:incoming>
      <bpmn:outgoing>Flow_SendOfferLoop</bpmn:outgoing>
      <bpmn:outgoing>Flow_CheckConfirmation</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Service Task for receiving confirmation -->
    <bpmn:serviceTask id="Service_ReceiveConfirmation" name="Receive confirmation of application entry">
      <bpmn:incoming>Flow_CheckConfirmation</bpmn:incoming>
      <bpmn:outgoing>Flow_FeedbackReceivedEvent</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Intermediate Throw Event for feedback -->
    <bpmn:intermediateThrowEvent id="Intermediate_Feedback" name="Feedback on application received">
      <bpmn:incoming>Flow_FeedbackReceivedEvent</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckSuccessGateway</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <!-- Gateway for Application Success -->
    <bpmn:exclusiveGateway id="Gateway_AppSuccessful" name="Job application successful?">
      <bpmn:incoming>Flow_StartToAppLoop</bpmn:incoming>
      <bpmn:incoming>Flow_CheckSuccessGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_NegotiateInterviewYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_AppLoopBackNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Negotiation Task -->
    <bpmn:task id="Task_NegotiateInterview" name="Negotiate job interview">
      <bpmn:incoming>Flow_NegotiateInterviewYes</bpmn:incoming>
      <bpmn:outgoing>Flow_InterviewSuccessGateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for Interview Success -->
    <bpmn:exclusiveGateway id="Gateway_InterviewSuccessful" name="Job interview successful?">
      <bpmn:incoming>Flow_InterviewSuccessGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_ProbationYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_AppLoopBackNoInterview</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Probation Phase Task -->
    <bpmn:task id="Task_ProbationPhase" name="Start job (probation phase)">
      <bpmn:incoming>Flow_ProbationYes</bpmn:incoming>
      <bpmn:outgoing>Flow_ProbationFinishedEvent</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Catch Event for Probation End -->
    <bpmn:intermediateCatchEvent id="Intermediate_ProbationEnd" name="Probation phase finished">
      <bpmn:incoming>Flow_ProbationFinishedEvent</bpmn:incoming>
      <bpmn:outgoing>Flow_RateCompanyTask</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Rating Task -->
    <bpmn:task id="Task_RateCompany" name="Rate company">
      <bpmn:incoming>Flow_RateCompanyTask</bpmn:incoming>
      <bpmn:outgoing>Flow_FeedbackToService</bpmn:outgoing>
    </bpmn:task>

    <!-- Service Task for Feedback -->
    <bpmn:serviceTask id="Service_ReceiveFeedback" name="Receive feedback on interview">
      <bpmn:incoming>Flow_FeedbackToService</bpmn:incoming>
      <bpmn:outgoing>Flow_ReportFeedback</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Report Feedback Task -->
    <bpmn:task id="Task_ReportFeedback" name="Report feedback">
      <bpmn:incoming>Flow_ReportFeedback</bpmn:incoming>
      <bpmn:outgoing>Flow_ConvergeBeforePermanentCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway to converge paths before Permanent Check -->
    <bpmn:parallelGateway id="Parallel_Gateway_Permanent" name="">
      <bpmn:incoming>Flow_ConvergeBeforePermanentCheck</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckPermanentJob</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Gateway for Permanent Job -->
    <bpmn:exclusiveGateway id="Gateway_Permanent" name="Job permanent?">
      <bpmn:incoming>Flow_CheckPermanentJob</bpmn:incoming>
      <bpmn:outgoing>Flow_RatingCheckYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_UnemployedEndNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Gateway for Rating Check -->
    <bpmn:exclusiveGateway id="Gateway_RatingCheck" name="Company rating above C?">
      <bpmn:incoming>Flow_RatingCheckYes</bpmn:incoming>
      <bpmn:outgoing>Flow_ConvergeEndYesRating</bpmn:outgoing>
      <bpmn:outgoing>Flow_ContinueOffersNoRating</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Service Task for Job Offers (Loop) -->
    <bpmn:serviceTask id="Service_JobOffer" name="Receive potential job offer">
      <bpmn:incoming>Flow_ContinueOffersNoRating</bpmn:incoming>
      <bpmn:outgoing>Flow_ConvergeEndYesRatingLoop</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- End Event 1 -->
    <bpmn:endEvent id="End_ProcessFinished" name="Application process finished">
      <bpmn:incoming>Flow_AppLoopBackNoInterviewOrLowRating</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    
    <!-- Start Flow -->
    <bpmn:sequenceFlow id="Flow_StartToAppLoop" sourceRef="Start_Unemployed" targetRef="Gateway_AppSuccessful" />

    <!-- Application Loop Backs (No) -->
    <bpmn:sequenceFlow id="Flow_NegotiateInterviewYes" name="yes" sourceRef="Gateway_AppSuccessful" targetRef="Task_NegotiateInterview" />
    <bpmn:sequenceFlow id="Flow_AppLoopBackNo" name="no" sourceRef="Gateway_AppSuccessful" targetRef="Start_Unemployed" />

    <!-- Application Success Flow -->
    <bpmn:sequenceFlow id="Flow_SendApp" sourceRef="Task_WriteApplication" targetRef="Task_SendApplication" />
    
    <!-- Reporting Flows -->
    <bpmn:sequenceFlow id="Flow_ReportApp" sourceRef="Task_SendApplication" targetRef="Task_ReportApplication" />
    <bpmn:sequenceFlow id="Flow_ParallelSplit1" sourceRef="Task_ReportApplication" targetRef="Parallel_Gateway_Receive" />

    <!-- Parallel Gateway Flows -->
    <bpmn:sequenceFlow id="Flow_SendOfferLoop" name="" sourceRef="Parallel_Gateway_Receive" targetRef="Service_JobOffer" />
    <bpmn:sequenceFlow id="Flow_CheckConfirmation" name="" sourceRef="Parallel_Gateway_Receive" targetRef="Service_ReceiveConfirmation" />

    <!-- Confirmation Flow -->
    <bpmn:sequenceFlow id="Flow_FeedbackReceivedEvent" sourceRef="Service_ReceiveConfirmation" targetRef="Intermediate_Feedback" />
    
    <!-- Success Check Gateway Flows -->
    <bpmn:sequenceFlow id="Flow_CheckSuccessGateway" name="" sourceRef="Intermediate_Feedback" targetRef="Gateway_AppSuccessful" />

    <!-- Interview Flow -->
    <bpmn:sequenceFlow id="Flow_InterviewSuccessGateway" sourceRef="Task_NegotiateInterview" targetRef="Gateway_InterviewSuccessful" />
    
    <!-- Probation Flows -->
    <bpmn:sequenceFlow id="Flow_ProbationYes" name="yes" sourceRef="Gateway_InterviewSuccessful" targetRef="Task_ProbationPhase" />
    <bpmn:sequenceFlow id="Flow_AppLoopBackNoInterview" name="no" sourceRef="Gateway_InterviewSuccessful" targetRef="Start_Unemployed" />

    <!-- Probation End Flow -->
    <bpmn:sequenceFlow id="Flow_ProbationFinishedEvent" sourceRef="Task_ProbationPhase" targetRef="Intermediate_ProbationEnd" />
    
    <!-- Rating Flows -->
    <bpmn:sequenceFlow id="Flow_RateCompanyTask" sourceRef="Intermediate_ProbationEnd" targetRef="Task_RateCompany" />
    <bpmn:sequenceFlow id="Flow_FeedbackToService" sourceRef="Task_RateCompany" targetRef="Service_ReceiveFeedback" />

    <!-- Feedback Reporting -->
    <bpmn:sequenceFlow id="Flow_ReportFeedback" sourceRef="Service_ReceiveFeedback" targetRef="Task_ReportFeedback" />
    
    <!-- Convergence before Permanent Check (Simplified for XML structure) -->
    <bpmn:sequenceFlow id="Flow_ConvergeBeforePermanentCheck" sourceRef="Task_ReportFeedback" targetRef="Parallel_Gateway_Permanent" />

    <!-- Permanent Job Logic -->
    <bpmn:sequenceFlow id="Flow_CheckPermanentJob" sourceRef="Parallel_Gateway_Permanent" targetRef="Gateway_Permanent" />
    
    <!-- Rating Check Logic (Assuming "Yes" to permanent leads here) -->
    <bpmn:sequenceFlow id="Flow_RatingCheckYes" name="" sourceRef="Gateway_Permanent" targetRef="Gateway_RatingCheck" />

    <!-- Low Rating / No Permanent Flow -->
    <bpmn:sequenceFlow id="Flow_UnemployedEndNo" name="no" sourceRef="Gateway_Permanent" targetRef="Start_Unemployed" />
    
    <!-- High Rating (Above C) Logic - Loop back to application -->
    <bpmn:sequenceFlow id="Flow_ConvergeEndYesRating" name="yes" sourceRef="Gateway_RatingCheck" targetRef="Task_WriteApplication" />

    <!-- Low Rating / No Permanent Flow to Offers Loop -->
    <bpmn:sequenceFlow id="Flow_ContinueOffersNoRating" name="no" sourceRef="Gateway_RatingCheck" targetRef="Service_JobOffer" />

    <!-- Offer Loop Back (Simplified) - Continue receiving offers without reporting -->
    <bpmn:sequenceFlow id="Flow_ConvergeEndYesRatingLoop" sourceRef="Service_JobOffer" targetRef="Start_Unemployed" />

  </bpmn:process>
</bpmn:definitions>