<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_RoboticBurgerSeller_1">
  <bpmn:collaboration>
    <bpmn:participant id="Participant_BurgerRobot" name="Robotic Burger Seller Service" processRef="Process_ProcessExecution"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_ProcessExecution" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_OrderReceived" name="Order Received">
      <bpmn:outgoing>bpmnSequenceFlow_AskMenu</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Ask Menu or Burger Only -->
    <bpmn:userTask id="Task_AskMenuChoice" name="Ask Customer (Menu vs. Burger)">
      <bpmn:incoming>bpmnSequenceFlow_AskMenu</bpmn:incoming>
      <bpmn:outgoing>bpmnSequenceFlow_MenuDecision</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway 1: Menu Decision -->
    <bpmn:exclusiveGateway id="Gateway_MenuChoice" name="Menu?">
      <bpmn:incoming>bpmnSequenceFlow_MenuDecision</bpmn:incoming>
      <bpmn:outgoing>bpmnSequenceFlow_YesPath</bpmn:outgoing> <!-- Menu -->
      <bpmn:outgoing>bpmnSequenceFlow_NoPath</bpmn:outgoing>  <!-- Just Burger -->
    </bpmn:exclusiveGateway>

    <!-- Parallel Gateway for Drink & Sides (Menu Path) -->
    <bpmn:parallelGateway id="Parallel_Split" name="">
      <bpmn:incoming>bpmnSequenceFlow_YesPath</bpmn:incoming>
      <bpmn:outgoing>bpmnSequenceFlow_DrinkPrep</bpmn:outgoing>
      <bpmn:outgoing>bpmnSequenceFlow_SideSelection</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Prepare Drink -->
    <bpmn:serviceTask id="Task_PrepareDrink" name="Prepare Drink (Variable Time)">
      <bpmn:incoming>bpmnSequenceFlow_DrinkPrep</bpmn:incoming>
      <bpmn:outgoing>bpmnSequenceFlow_DrinkDone</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Task: Ask Fries or Wedges -->
    <bpmn:userTask id="Task_AskSides" name="Ask Customer (Fries vs. Wedges)">
      <bpmn:incoming>bpmnSequenceFlow_SideSelection</bpmn:incoming>
      <bpmn:outgoing>bpmnSequenceFlow_FriesWedgesChoice</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway 2: Fries or Wedges -->
    <bpmn:exclusiveGateway id="Gateway_Sides" name="Fries?">
      <bpmn:incoming>bpmnSequenceFlow_FriesWedgesChoice</bpmn:incoming>
      <bpmn:outgoing>bpmnSequenceFlow_PrepareFries</bpmn:outgoing> <!-- Yes -->
      <bpmn:outgoing>bpmnSequenceFlow_PrepareWedges</bpmn:outgoing><!-- No (Wedges) -->
    </bpmn:exclusiveGateway>

    <!-- Task: Prepare Fries -->
    <bpmn:serviceTask id="Task_PrepareFries" name="Prepare Fries">
      <bpmn:incoming>bpmnSequenceFlow_PrepareFries</bpmn:incoming>
      <bpmn:outgoing>bpmnSequenceFlow_SidesDone_Fries</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Task: Prepare Wedges -->
    <bpmn:serviceTask id="Task_PrepareWedges" name="Prepare Wedges">
      <bpmn:incoming>bpmnSequenceFlow_PrepareWedges</bpmn:incoming>
      <bpmn:outgoing>bpmnSequenceFlow_SidesDone_Wedges</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Parallel Join for Drink & Sides -->
    <bpmn:parallelGateway id="Parallel_Join" name="">
      <bpmn:incoming>bpmnSequenceFlow_DrinkDone</bpmn:incoming>
      <bpmn:incoming>bpmnSequenceFlow_SidesDone_Fries</bpmn:incoming>
      <bpmn:incoming>bpmnSequenceFlow_SidesDone_Wedges</bpmn:incoming>
      <bpmn:outgoing>bpmnSequenceFlow_MenuReady</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Convergence Gateway (Menu Path vs No Menu Path) -->
    <bpmn:exclusiveGateway id="Gateway_Converge" name="">
      <bpmn:incoming>bpmnSequenceFlow_MenuReady</bpmn:incoming>
      <bpmn:incoming>bpmnSequenceFlow_NoPath</bpmn:incoming>
      <bpmn:outgoing>bpmnSequenceFlow_BurgerPrepStart</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Prepare Burger -->
    <bpmn:serviceTask id="Task_PrepareBurger" name="Prepare Burger (Variable Time)">
      <bpmn:incoming>bpmnSequenceFlow_BurgerPrepStart</bpmn:incoming>
      <bpmn:outgoing>bpmnSequenceFlow_StatusUpdates</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Task/Activity for Status Updates -->
    <bpmn:userTask id="Task_Updates" name="Give Enthusiastic Status Updates (Every 30s)">
      <bpmn:incoming>bpmnSequenceFlow_StatusUpdates</bpmn:incoming>
      <bpmn:outgoing>bpmnSequenceFlow_DeliveryReady</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_OrderDelivered" name="Order Delivered">
      <bpmn:incoming>bpmnSequenceFlow_DeliveryReady</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="bpmnSequenceFlow_AskMenu" sourceRef="StartEvent_OrderReceived" targetRef="Task_AskMenuChoice"/>
    <bpmn:sequenceFlow id="bpmnSequenceFlow_MenuDecision" sourceRef="Task_AskMenuChoice" targetRef="Gateway_MenuChoice"/>

    <!-- Menu Path -->
    <bpmn:sequenceFlow id="bpmnSequenceFlow_YesPath" name="Yes (Menu)" sourceRef="Gateway_MenuChoice" targetRef="Parallel_Split"/>
    
    <!-- Parallel Split Branches -->
    <bpmn:sequenceFlow id="bpmnSequenceFlow_DrinkPrep" sourceRef="Parallel_Split" targetRef="Task_PrepareDrink"/>
    <bpmn:sequenceFlow id="bpmnSequenceFlow_SideSelection" sourceRef="Parallel_Split" targetRef="Task_AskSides"/>

    <!-- Side Selection Logic -->
    <bpmn:sequenceFlow id="bpmnSequenceFlow_FriesWedgesChoice" sourceRef="Task_AskSides" targetRef="Gateway_Sides"/>
    
    <!-- Fries/Wedges Paths -->
    <bpmn:sequenceFlow id="bpmnSequenceFlow_PrepareFries" name="Yes (Fries)" sourceRef="Gateway_Sides" targetRef="Task_PrepareFries"/>
    <bpmn:sequenceFlow id="bpmnSequenceFlow_PrepareWedges" name="No (Wedges)" sourceRef="Gateway_Sides" targetRef="Task_PrepareWedges"/>

    <!-- Convergence of Drink & Sides -->
    <bpmn:sequenceFlow id="bpmnSequenceFlow_DrinkDone" sourceRef="Task_PrepareDrink" targetRef="Parallel_Join"/>
    <bpmn:sequenceFlow id="bpmnSequenceFlow_SidesDone_Fries" name="" sourceRef="Task_PrepareFries" targetRef="Parallel_Join"/> <!-- Fries -->
    <bpmn:sequenceFlow id="bpmnSequenceFlow_SidesDone_Wedges" name="" sourceRef="Task_PrepareWedges" targetRef="Parallel_Join"/> <!-- Wedges (via SidesDone) - Note: Need to merge flows into ParallelJoin correctly. In BPMN, multiple incoming can go to one gateway if logic allows. Here Fries and Wedges both feed 'Sides Done' flow conceptually before Join.) -->

    <!-- No Menu Path (Direct) -->
    <bpmn:sequenceFlow id="bpmnSequenceFlow_NoPath" name="No (Burger Only)" sourceRef="Gateway_MenuChoice" targetRef="Gateway_Converge"/>

    <!-- Main Convergence to Burger Prep -->
    <bpmn:sequenceFlow id="bpmnSequenceFlow_MenuReady" sourceRef="Parallel_Join" targetRef="Gateway_Converge"/>
    
    <!-- To Gateway_Converge from Menu Path (Internal Join) and No Path. 
         Note: In strict BPMN, ExclusiveJoin waits for one token. ParallelJoin waits for all tokens of the split.
         Here we have a Hybrid logic: Yes-Branch has internal parallelism that converges to 1 token before reaching Gateway_Converge?
         Actually, if I use an ExclusiveGateway at 'Parallel_Join', it's invalid (must be Parallel). 
         So Internal Join is ParallelJoin -> Output Token. This flows to Gateway_Converge. No-Path also flows to Gateway_Converge.
    -->

    <!-- Burger Prep Flow -->
    <bpmn:sequenceFlow id="bpmnSequenceFlow_BurgerPrepStart" sourceRef="Gateway_Converge" targetRef="Task_PrepareBurger"/>
    
    <!-- Status Updates & Delivery -->
    <bpmn:sequenceFlow id="bpmnSequenceFlow_StatusUpdates" name="" sourceRef="Task_PrepareBurger" targetRef="Task_Updates"/>
    <bpmn:sequenceFlow id="bpmnSequenceFlow_DeliveryReady" sourceRef="Task_Updates" targetRef="EndEvent_OrderDelivered"/>

  </bpmn:process>
</bpmn:definitions>