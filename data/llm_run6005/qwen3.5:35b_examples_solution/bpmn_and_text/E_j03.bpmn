<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_WorkAccident_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_WorkAccident">
    <bpmn:participant id="Participant_EGovernmentProcess" name="Work Accident Reporting Process" processRef="Process_WorkAccident"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_WorkAccident" isExecutable="false">
    <bpmn:startEvent id="Start_IncidentHappens" name="Incident Happens">
      <bpmn:outgoing>Flow_AssessmentTool</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="User_StartAssessment" name="Start Assessment Tool">
      <bpmn:incoming>Flow_AssessmentTool</bpmn:incoming>
      <bpmn:outgoing>Flow_EnterIncidentType</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="User_EnterIncidentType" name="Enter Incident Type">
      <bpmn:incoming>Flow_EnterIncidentType</bpmn:incoming>
      <bpmn:outgoing>Gateway_IncidentClassification</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_IncidentClassification" name="Classify Incident">
      <bpmn:incoming>Flow_EnterIncidentType</bpmn:incoming>
      <bpmn:outgoing>Flow_AccidentReported</bpmn:outgoing>
      <bpmn:outgoing>Flow_AlmostAccidentReported</bpmn:outgoing>
      <bpmn:outgoing>Flow_SafetyRiskReported</bpmn:outgoing>
      <bpmn:outgoing>Flow_DefectReported</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="User_Accident" name="Accident Report">
      <bpmn:incoming>Flow_AccidentReported</bpmn:incoming>
      <bpmn:outgoing>Flow_ConvergeClassification</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="User_AlmostAccident" name="Almost Accident Report">
      <bpmn:incoming>Flow_AlmostAccidentReported</bpmn:incoming>
      <bpmn:outgoing>Flow_ConvergeClassification2</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="User_SafetyRisk" name="Safety/Health Risk Report">
      <bpmn:incoming>Flow_SafetyRiskReported</bpmn:incoming>
      <bpmn:outgoing>Flow_ConvergeClassification3</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="User_Defect" name="Defective Equipment Report">
      <bpmn:incoming>Flow_DefectReported</bpmn:incoming>
      <bpmn:outgoing>Flow_ConvergeClassification4</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_VictimType" name="Victim Type">
      <bpmn:incoming>Flow_ConvergeClassification5</bpmn:incoming>
      <bpmn:outgoing>Flow_StudentCheck</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="User_EnterVictimData" name="Enter Victim Data">
      <bpmn:incoming>Flow_ConvergeClassification5</bpmn:incoming>
      <bpmn:outgoing>Flow_SelfEmployedCheck</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_SelfEmployed" name="Self-Employed?">
      <bpmn:incoming>Flow_SelfEmployedCheck</bpmn:incoming>
      <bpmn:outgoing>Flow_EnterOwnData</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="User_EnterOwnData" name="Enter Own Data">
      <bpmn:incoming>Flow_EnterOwnData</bpmn:incoming>
      <bpmn:outgoing>Flow_SelfEmployedCheck2</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_StudentVictim" name="Is Student?">
      <bpmn:incoming>Flow_ConvergeClassification5</bpmn:incoming>
      <bpmn:outgoing>Flow_SchoolReportPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="User_EnterVictimData2" name="Enter Victim Data">
      <bpmn:incoming>Flow_ConvergeClassification5</bpmn:incoming>
      <bpmn:outgoing>Flow_SelfEmployedCheck3</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_Fatality" name="Fatality/Serious Injury?">
      <bpmn:incoming>Flow_ConvergeClassification5</bpmn:incoming>
      <bpmn:outgoing>Flow_LabourInspectorateReport</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="User_ReportLabourInspectorate" name="Report to Labour Inspectorate">
      <bpmn:incoming>Flow_LabourInspectorateReport</bpmn:incoming>
      <bpmn:outgoing>Flow_InsuranceCheck</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_AlreadyReported" name="Already Reported?">
      <bpmn:incoming>Flow_LabourInspectorateReport</bpmn:incoming>
      <bpmn:outgoing>Flow_InsuranceCheck2</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="User_ReportAccidentInsurer" name="Report to Accident Insurance Provider">
      <bpmn:incoming>Flow_LabourInspectorateReport</bpmn:incoming>
      <bpmn:outgoing>Flow_InsuranceCheck3</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:parallelGateway id="Parallel_ReportActions" name="">
      <bpmn:incoming>Flow_LabourInspectorateReport</bpmn:incoming>
      <bpmn:outgoing>Flow_InsuranceCheck4</bpmn:outgoing>
      <bpmn:outgoing>Flow_SchoolReportPath2</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:userTask id="User_ReportSuperiors" name="Contact Superiors">
      <bpmn:incoming>Flow_LabourInspectorateReport</bpmn:incoming>
      <bpmn:outgoing>Flow_ConvergeReporting</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_SchoolPath" name="">
      <bpmn:incoming>Flow_LabourInspectorateReport</bpmn:incoming>
      <bpmn:outgoing>Flow_ConvergeReporting2</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="User_ReportPrincipal" name="Contact Principal">
      <bpmn:incoming>Flow_LabourInspectorateReport</bpmn:incoming>
      <bpmn:outgoing>Flow_ConvergeReporting3</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_PrivateInsurance" name="Private Insurance?">
      <bpmn:incoming>Flow_LabourInspectorateReport</bpmn:incoming>
      <bpmn:outgoing>Flow_ReportPrivateInsurer</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="User_ReportPrivateInsurance" name="Contact Private Insurance">
      <bpmn:incoming>Flow_ReportPrivateInsurer</bpmn:incoming>
      <bpmn:outgoing>Flow_ConvergeReporting4</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="End_Completed" name="Process Completed">
      <bpmn:incoming>Flow_ConvergeReporting5</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Flow_AssessmentTool" sourceRef="Start_IncidentHappens" targetRef="User_StartAssessment"/>
    <bpmn:sequenceFlow id="Flow_EnterIncidentType" sourceRef="User_StartAssessment" targetRef="User_EnterIncidentType"/>

    <!-- Classification Gateway -->
    <bpmn:sequenceFlow id="Flow_AccidentReported" name="Accident" sourceRef="Gateway_IncidentClassification" targetRef="User_Accident"/>
    <bpmn:sequenceFlow id="Flow_AlmostAccidentReported" name="Almost Accident" sourceRef="Gateway_IncidentClassification" targetRef="User_AlmostAccident"/>
    <bpmn:sequenceFlow id="Flow_SafetyRiskReported" name="Safety Risk" sourceRef="Gateway_IncidentClassification" targetRef="User_SafetyRisk"/>
    <bpmn:sequenceFlow id="Flow_DefectReported" name="Defect Report" sourceRef="Gateway_IncidentClassification" targetRef="User_Defect"/>

    <!-- Convergence after classification -->
    <bpmn:sequenceFlow id="Flow_ConvergeClassification5" sourceRef="User_Accident" targetRef="Gateway_VictimType"/>
    
    <!-- Victim type decision paths -->
    <bpmn:sequenceFlow id="Flow_StudentCheck" name="Yes - Student/Schoolchild" sourceRef="Gateway_StudentVictim" targetRef="User_ReportPrincipal"/>

    <!-- Fatality check -->
    <bpmn:sequenceFlow id="Flow_LabourInspectorateReport" name="Yes - Fatal/Serious Injury" sourceRef="Gateway_Fatality" targetRef="User_ReportLabourInspectorate"/>
    
  </bpmn:process>
</bpmn:definitions>