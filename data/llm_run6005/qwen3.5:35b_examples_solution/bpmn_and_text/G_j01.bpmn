<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_FarmingBot_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_FarmingBot">
    <bpmn:participant id="Participant_FarmingBotProcess" name="Farming Bot Service" processRef="Process_FarmingExecution"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_FarmingExecution" isExecutable="false">
    
    <!-- Data Objects -->
    <bpmn:dataObject id="DataResourceList" name="Selected Resources List" />
    <bpmn:dataObject id="DataTablelist" name="Tool Requirements List" />

    <!-- Start Event -->
    <bpmn:startEvent id="Start_CreateBot" name="Create Custom Farming Bot">
      <bpmn:outgoing>Flow_StartToResourceSelection</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Resource Selection Phase (Parallel) -->
    <bpmn:parallelGateway id="GW_ParallelResources" name="Select Resources in Parallel">
      <bpmn:incoming>Flow_StartToResourceSelection</bpmn:incoming>
      <bpmn:outgoing>Flow_Resource1</bpmn:outgoing>
      <bpmn:outgoing>Flow_Resource2</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Resource Tasks (Up to 10, simplified for example) -->
    <bpmn:userTask id="Task_SelectResource1" name="Select Urgent Resources">
      <bpmn:incoming>Flow_Resource1</bpmn:incoming>
      <bpmn:outgoing>Flow_ConvergeResources</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_SelectResource2" name="Select Standard Resources">
      <bpmn:incoming>Flow_Resource2</bpmn:incoming>
      <bpmn:outgoing>Flow_ConvergeResources</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Tool Creation Dependencies -->
    <bpmn:exclusiveGateway id="GW_ToolCheck" name="Tools Required?">
      <bpmn:incoming>Flow_ConvergeResources</bpmn:incoming>
      <bpmn:outgoing>Flow_CreateTool1</bpmn:outgoing>
      <bpmn:outgoing>Flow_StartFarming</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Tool Creation Tasks -->
    <bpmn:userTask id="Task_CreateTools" name="Create Required Tools">
      <bpmn:incoming>Flow_CreateTool1</bpmn:incoming>
      <bpmn:outgoing>Flow_StartFarming</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Main Farming Loop -->
    <bpmn:startEvent id="Start_Farm" name="Begin Farming">
      <bpmn:incoming>Flow_StartFarming</bpmn:incoming>
      <bpmn:outgoing>Flow_GatherResources</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Gathering Resources -->
    <bpmn:userTask id="Task_Farm" name="Gather Resources">
      <bpmn:incoming>Flow_GatherResources</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckMilestone</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Milestone Check -->
    <bpmn:exclusiveGateway id="GW_Milestone" name="Milestone Reached?">
      <bpmn:incoming>Flow_CheckMilestone</bpmn:incoming>
      <bpmn:outgoing>Flow_NotifyPlayer</bpmn:outgoing>
      <bpmn:outgoing>Flow_ContinueFarming</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Notification -->
    <bpmn:userTask id="Task_Notification" name="Notify Player">
      <bpmn:incoming>Flow_NotifyPlayer</bpmn:incoming>
      <bpmn:outgoing>Flow_ContinueFarming</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Update List Loop -->
    <bpmn:exclusiveGateway id="GW_UpdateList" name="Update Materials?">
      <bpmn:incoming>Flow_CheckMilestone</bpmn:incoming>
      <bpmn:outgoing>Flow_ContinueFarming</bpmn:outgoing>
      <bpmn:outgoing>Flow_AdjustMaterials</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Adjust Materials -->
    <bpmn:userTask id="Task_AdjustList" name="Adjust Farming List">
      <bpmn:incoming>Flow_AdjustMaterials</bpmn:incoming>
      <bpmn:outgoing>Flow_ContinueFarming</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Natural Disaster Handling -->
    <bpmn:intermediateCatchEvent id="Event_Disaster" name="Natural Disaster">
      <bpmn:incoming>Flow_GatherResources</bpmn:incoming>
      <bpmn:outgoing>Flow_ResumeFarming</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- End of Farming -->
    <bpmn:endEvent id="End_FarmComplete" name="Bot Finished">
      <bpmn:incoming>Flow_EndProcess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Post-Farming Options -->
    <bpmn:exclusiveGateway id="GW_PostFarmOptions" name="Share Results?">
      <bpmn:incoming>Flow_EndProcess</bpmn:incoming>
      <bpmn:outgoing>Flow_BragToFriends</bpmn:outgoing>
      <bpmn:outgoing>Flow_SendMaterials</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Bragging -->
    <bpmn:userTask id="Task_Brag" name="Brag to Friends">
      <bpmn:incoming>Flow_BragToFriends</bpmn:incoming>
      <bpmn:outgoing>Flow_FinalEnd</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Sending Materials -->
    <bpmn:userTask id="Task_SendMaterials" name="Send Materials to Friends">
      <bpmn:incoming>Flow_SendMaterials</bpmn:incoming>
      <bpmn:outgoing>Flow_FinalEnd</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Final End -->
    <bpmn:endEvent id="End_ProcessComplete" name="Process Complete">
      <bpmn:incoming>Flow_FinalEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Flow_StartToResourceSelection" sourceRef="Start_CreateBot" targetRef="GW_ParallelResources"/>
    
    <bpmn:sequenceFlow id="Flow_Resource1" name="Urgent Resources" sourceRef="GW_ParallelResources" targetRef="Task_SelectResource1"/>
    <bpmn:sequenceFlow id="Flow_Resource2" name="Standard Resources" sourceRef="GW_ParallelResources" targetRef="Task_SelectResource2"/>

    <bpmn:sequenceFlow id="Flow_ConvergeResources" sourceRef="Task_SelectResource1" targetRef="GW_ToolCheck"/>
    <bpmn:sequenceFlow id="Flow_StartFarming" name="Start Farming" sourceRef="GW_ToolCheck" targetRef="Start_Farm"/>

    <!-- Tool Creation Flow -->
    <bpmn:sequenceFlow id="Flow_CreateTool1" name="Tools Needed" sourceRef="GW_ToolCheck" targetRef="Task_CreateTools"/>
    
    <!-- Main Loop Flows -->
    <bpmn:sequenceFlow id="Flow_GatherResources" sourceRef="Start_Farm" targetRef="Task_Farm"/>

    <!-- Milestone Flow -->
    <bpmn:sequenceFlow id="Flow_CheckMilestone" name="Check Progress" sourceRef="Task_Farm" targetRef="GW_Milestone"/>
    
    <!-- Notification Flow -->
    <bpmn:sequenceFlow id="Flow_NotifyPlayer" name="Yes - Milestone Reached" sourceRef="GW_Milestone" targetRef="Task_Notification"/>

    <!-- Continue Farming Flows -->
    <bpmn:sequenceFlow id="Flow_ContinueFarming" name="No / After Notification" sourceRef="GW_Milestone" targetRef="Start_Farm"/>
    
    <!-- Update List Flow -->
    <bpmn:sequenceFlow id="Flow_AdjustMaterials" name="Update Materials" sourceRef="GW_UpdateList" targetRef="Task_AdjustList"/>

    <!-- Disaster Handling Flows -->
    <bpmn:sequenceFlow id="Flow_ResumeFarming" sourceRef="Event_Disaster" targetRef="Start_Farm"/>

    <!-- End of Farming Flow -->
    <bpmn:sequenceFlow id="Flow_EndProcess" name="Bot Finished" sourceRef="GW_Milestone" targetRef="GW_PostFarmOptions"/>

    <!-- Post-Farming Options Flows -->
    <bpmn:sequenceFlow id="Flow_BragToFriends" name="Brag to Friends" sourceRef="GW_PostFarmOptions" targetRef="Task_Brag"/>
    
    <bpmn:sequenceFlow id="Flow_SendMaterials" name="Send Materials" sourceRef="GW_PostFarmOptions" targetRef="Task_SendMaterials"/>

    <!-- Final End Flow -->
    <bpmn:sequenceFlow id="Flow_FinalEnd" sourceRef="Task_Brag" targetRef="End_ProcessComplete"/>
  </bpmn:process>
</bpmn:definitions>