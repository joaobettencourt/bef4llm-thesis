<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_LuxuryAirplane_1">
  <bpmn:collaboration id="Collaboration_AirplaneManufacturer">
    <bpmn:participant id="Participant_Manufacturer" name="Luxury Airplane Manufacturer" processRef="Process_ProcessExecution"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_ProcessExecution" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_OrderReceived" name="Order received">
      <bpmn:outgoing>SequenceFlow_DefineRequirements</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Define Requirements Task -->
    <bpmn:userTask id="Task_DefineRequirements" name="Define requirements">
      <bpmn:incoming>SequenceFlow_DefineRequirements</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckCustomization</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Check if customization needed -->
    <bpmn:exclusiveGateway id="Gateway_CustomizationCheck" name="base model?">
      <bpmn:incoming>SequenceFlow_CheckCustomization</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OrderPartsStandard</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_DesignIndividualParts</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Standard Parts Path -->
    <bpmn:serviceTask id="Task_OrderPartsStandard" name="Order parts">
      <bpmn:incoming>SequenceFlow_OrderPartsStandard</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConvergeManufacturing</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Custom Design Path -->
    <bpmn:userTask id="Task_DesignIndividualParts" name="Design individual parts">
      <bpmn:incoming>SequenceFlow_DesignIndividualParts</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConvergeManufacturing</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Convergence of Parts Design/Ordering -->
    <bpmn:exclusiveGateway id="Gateway_ManufacturingConvergence" name="">
      <bpmn:incoming>SequenceFlow_OrderPartsStandard</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_DesignIndividualParts</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AssemblePlane</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Parallel Manufacturing of Specific Parts (Teams) -->
    <bpmn:parallelGateway id="ParallelGateway_Manufacturing" name="">
      <bpmn:incoming>SequenceFlow_ConvergeManufacturing</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MakeVodkaBar</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_MakeWhiskeyBar</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Vodka Bar Manufacturing (Russian team) -->
    <bpmn:userTask id="Task_MakeVodkaBar" name="Manufacture vodka bar">
      <bpmn:incoming>SequenceFlow_MakeVodkaBar</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConvergeParts</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Whiskey Bar Manufacturing (Irish team) -->
    <bpmn:userTask id="Task_MakeWhiskeyBar" name="Manufacture whiskey bar">
      <bpmn:incoming>SequenceFlow_MakeWhiskeyBar</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConvergeParts</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Convergence of Parts Manufacturing -->
    <bpmn:parallelGateway id="ParallelGateway_PartsConvergence" name="">
      <bpmn:incoming>SequenceFlow_MakeVodkaBar</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_MakeWhiskeyBar</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AssemblePlane</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Assemble Plane -->
    <bpmn:userTask id="Task_AssemblePlane" name="Assemble plane">
      <bpmn:incoming>SequenceFlow_ConvergeParts</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TestFlight</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Test Flight -->
    <bpmn:userTask id="Task_TestFlight" name="Make test flight">
      <bpmn:incoming>SequenceFlow_TestFlight</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CreateProtocol</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Create Test Protocol -->
    <bpmn:serviceTask id="Task_CreateProtocol" name="Create test protocol">
      <bpmn:incoming>SequenceFlow_CreateProtocol</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConvergeTestResults</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Converge Test Results -->
    <bpmn:parallelGateway id="ParallelGateway_TestConvergence" name="">
      <bpmn:incoming>SequenceFlow_CreateProtocol</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckTestSuccess</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Check Test Success -->
    <bpmn:exclusiveGateway id="Gateway_TestSuccessful" name="Test successful?">
      <bpmn:incoming>SequenceFlow_CheckTestSuccess</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FixProblems</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NotifyCustomer</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Fix Problems -->
    <bpmn:userTask id="Task_FixProblems" name="Fix problems">
      <bpmn:incoming>SequenceFlow_FixProblems</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RetryTestFlight</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Retry Test Flight -->
    <bpmn:sequenceFlow id="SequenceFlow_RetryTestFlight" sourceRef="Task_FixProblems" targetRef="ParallelGateway_TestConvergence"/>

    <!-- Notify Customer -->
    <bpmn:serviceTask id="Task_NotifyCustomer" name="Notify customer">
      <bpmn:incoming>SequenceFlow_NotifyCustomer</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckSatisfaction</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Check Customer Satisfaction -->
    <bpmn:exclusiveGateway id="Gateway_CustomerSatisfied" name="Customer satisfied?">
      <bpmn:incoming>SequenceFlow_CheckSatisfaction</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DeliverPlane</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RenegotiateContract</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Deliver Plane -->
    <bpmn:userTask id="Task_DeliverPlane" name="Deliver plane">
      <bpmn:incoming>SequenceFlow_DeliverPlane</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OrderCompleted</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Renegotiate Contract -->
    <bpmn:userTask id="Task_RenegotiateContract" name="Renegotiate contract">
      <bpmn:incoming>SequenceFlow_RenegotiateContract</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConvergeSatisfactionCheck</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Converge Satisfaction Check -->
    <bpmn:exclusiveGateway id="Gateway_SatisfactionConvergence" name="">
      <bpmn:incoming>SequenceFlow_DeliverPlane</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ConvergeSatisfactionCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OrderCompleted</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_OrderCompleted" name="order completed">
      <bpmn:incoming>SequenceFlow_OrderCompleted</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_DefineRequirements" sourceRef="StartEvent_OrderReceived" targetRef="Task_DefineRequirements"/>
    <bpmn:sequenceFlow id="SequenceFlow_CheckCustomization" sourceRef="Task_DefineRequirements" targetRef="Gateway_CustomizationCheck"/>
    <bpmn:sequenceFlow id="SequenceFlow_OrderPartsStandard" name="" sourceRef="Gateway_CustomizationCheck" targetRef="Task_OrderPartsStandard"/>
    <bpmn:sequenceFlow id="SequenceFlow_DesignIndividualParts" name="" sourceRef="Gateway_CustomizationCheck" targetRef="Task_DesignIndividualParts"/>
    <bpmn:sequenceFlow id="SequenceFlow_ConvergeManufacturing" sourceRef="Task_OrderPartsStandard" targetRef="ParallelGateway_Manufacturing"/>
    <bpmn:sequenceFlow id="SequenceFlow_MakeVodkaBar" name="" sourceRef="ParallelGateway_Manufacturing" targetRef="Task_MakeVodkaBar"/>
    <bpmn:sequenceFlow id="SequenceFlow_MakeWhiskeyBar" name="" sourceRef="ParallelGateway_Manufacturing" targetRef="Task_MakeWhiskeyBar"/>
    <bpmn:sequenceFlow id="SequenceFlow_ConvergeParts" sourceRef="Task_MakeVodkaBar" targetRef="ParallelGateway_PartsConvergence"/>
    <bpmn:sequenceFlow id="SequenceFlow_AssemblePlane" name="" sourceRef="ParallelGateway_Manufacturing" targetRef="Task_AssemblePlane"/>
    <bpmn:sequenceFlow id="SequenceFlow_TestFlight" sourceRef="Task_AssemblePlane" targetRef="Task_TestFlight"/>
    <bpmn:sequenceFlow id="SequenceFlow_CreateProtocol" name="" sourceRef="Task_TestFlight" targetRef="Task_CreateProtocol"/>
    <bpmn:sequenceFlow id="SequenceFlow_CheckTestSuccess" sourceRef="ParallelGateway_PartsConvergence" targetRef="Gateway_TestSuccessful"/>
    <bpmn:sequenceFlow id="SequenceFlow_FixProblems" name="" sourceRef="Gateway_TestSuccessful" targetRef="Task_FixProblems"/>
    <bpmn:sequenceFlow id="SequenceFlow_NotifyCustomer" name="" sourceRef="Gateway_TestSuccessful" targetRef="Task_NotifyCustomer"/>
    <bpmn:sequenceFlow id="SequenceFlow_CheckSatisfaction" sourceRef="Task_NotifyCustomer" targetRef="Gateway_CustomerSatisfied"/>
    <bpmn:sequenceFlow id="SequenceFlow_DeliverPlane" name="" sourceRef="Gateway_CustomerSatisfied" targetRef="Task_DeliverPlane"/>
    <bpmn:sequenceFlow id="SequenceFlow_RenegotiateContract" name="" sourceRef="Gateway_CustomerSatisfied" targetRef="Task_RenegotiateContract"/>
    <bpmn:sequenceFlow id="SequenceFlow_ConvergeSatisfactionCheck" sourceRef="Task_RenegotiateContract" targetRef="Gateway_SatisfactionConvergence"/>
    <bpmn:sequenceFlow id="SequenceFlow_OrderCompleted" name="" sourceRef="Gateway_SatisfactionConvergence" targetRef="EndEvent_OrderCompleted"/>

  </bpmn:process>
</bpmn:definitions>