<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_LANParty_1">
  <bpmn:collaboration>
    <bpmn:participant id="Participant_Organizer" name="LAN Party Organizer" processRef="Process_LANPlanning"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_LANPlanning">
    
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Send invitations to friends">
      <bpmn:outgoing>SequenceFlow_SendInvites</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Send Invitations (Action) -->
    <bpmn:userTask id="Task_SendInvites" name="Send invitations to 10 friends">
      <bpmn:incoming>SequenceFlow_SendInvites</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SplitPlanning</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel Gateway Split -->
    <bpmn:parallelGateway id="Gateway_PlanSplit" name="">
      <bpmn:incoming>SequenceFlow_SplitPlanning</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AppointDatePath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_GamesBeerPath</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Path 1: Date Selection Loop -->
    <bpmn:userTask id="Task_AppointDate" name="Appoint a date">
      <bpmn:incoming>SequenceFlow_AppointDatePath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckAgreement</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway Check Date Agreement -->
    <bpmn:exclusiveGateway id="Gateway_DateCheck" name="8+ agree?">
      <bpmn:incoming>SequenceFlow_CheckAgreement</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ContinueDateYes</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_AppointAgainNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Path 2: Games & Beer Preparation -->
    <bpmn:userTask id="Task_CollectGamesList" name="Find out which games they want to play">
      <bpmn:incoming>SequenceFlow_GamesBeerPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckGamesAvail</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway Check Games Availability -->
    <bpmn:exclusiveGateway id="Gateway_GamesCheck" name="All games available?">
      <bpmn:incoming>SequenceFlow_CheckGamesAvail</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DownloadMissingNo</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CheckBeerYes</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task Download Missing Games -->
    <bpmn:userTask id="Task_DownloadGames" name="Download missing games">
      <bpmn:incoming>SequenceFlow_DownloadMissingNo</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeToBeerCheck</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Merge Download Path with Available Games Path before Beer Check -->
    <bpmn:parallelGateway id="Gateway_GamesMerge" name="">
      <bpmn:incoming>SequenceFlow_CheckBeerYes</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_MergeToBeerCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BeerRequirement</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task Beer Requirement -->
    <bpmn:userTask id="Task_CalculateBeer" name="Find out how much beer is required">
      <bpmn:incoming>SequenceFlow_BeerRequirement</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckBeerAvail</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway Check Beer Availability -->
    <bpmn:exclusiveGateway id="Gateway_BeerCheck" name="Enough beer?">
      <bpmn:incoming>SequenceFlow_CheckBeerAvail</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BuyMissingNo</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ConvergePrepYes</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task Buy Missing Beer -->
    <bpmn:userTask id="Task_BuyBeer" name="Buy what's missing">
      <bpmn:incoming>SequenceFlow_BuyMissingNo</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConvergePrepYes</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Convergence of Date Path and Prep Path before Party Start -->
    <bpmn:parallelGateway id="Gateway_PlanConverge" name="">
      <bpmn:incoming>SequenceFlow_ContinueDateYes</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ConvergePrepYes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StartParty</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Final Task / End -->
    <bpmn:userTask id="Task_EnjoyParty" name="Enjoy the LAN party">
      <bpmn:incoming>SequenceFlow_StartParty</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndProcess</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_1" name="LAN Party Completed">
      <bpmn:incoming>SequenceFlow_EndProcess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_SendInvites" sourceRef="StartEvent_1" targetRef="Task_SendInvites"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_SplitPlanning" sourceRef="Task_SendInvites" targetRef="Gateway_PlanSplit"/>

    <!-- Date Selection Path -->
    <bpmn:sequenceFlow id="SequenceFlow_AppointDatePath" sourceRef="Gateway_PlanSplit" targetRef="Task_AppointDate"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_CheckAgreement" sourceRef="Task_AppointDate" targetRef="Gateway_DateCheck"/>

    <!-- Date Loop Back -->
    <bpmn:sequenceFlow id="SequenceFlow_AppointAgainNo" name="no" sourceRef="Gateway_DateCheck" targetRef="Task_AppointDate">
      <bpmn:name>no</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Games & Beer Path -->
    <bpmn:sequenceFlow id="SequenceFlow_GamesBeerPath" sourceRef="Gateway_PlanSplit" targetRef="Task_CollectGamesList"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_CheckGamesAvail" sourceRef="Task_CollectGamesList" targetRef="Gateway_GamesCheck"/>

    <!-- Download Missing Games -->
    <bpmn:sequenceFlow id="SequenceFlow_DownloadMissingNo" name="no" sourceRef="Gateway_GamesCheck" targetRef="Task_DownloadGames">
      <bpmn:name>no</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Merge Games Paths -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckBeerYes" sourceRef="Gateway_GamesCheck" targetRef="Gateway_GamesMerge"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_MergeToBeerCheck" sourceRef="Task_DownloadGames" targetRef="Gateway_GamesMerge"/>

    <!-- Beer Path -->
    <bpmn:sequenceFlow id="SequenceFlow_BeerRequirement" sourceRef="Gateway_GamesMerge" targetRef="Task_CalculateBeer"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_CheckBeerAvail" sourceRef="Task_CalculateBeer" targetRef="Gateway_BeerCheck"/>

    <!-- Buy Missing Beer -->
    <bpmn:sequenceFlow id="SequenceFlow_BuyMissingNo" name="no" sourceRef="Gateway_BeerCheck" targetRef="Task_BuyBeer">
      <bpmn:name>no</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Converge Paths -->
    <bpmn:sequenceFlow id="SequenceFlow_ContinueDateYes" name="yes" sourceRef="Gateway_DateCheck" targetRef="Gateway_PlanConverge">
      <bpmn:name>yes</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ConvergePrepYes" name="yes" sourceRef="Gateway_BeerCheck" targetRef="Gateway_PlanConverge">
      <bpmn:name>yes</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Final Path -->
    <bpmn:sequenceFlow id="SequenceFlow_StartParty" sourceRef="Gateway_PlanConverge" targetRef="Task_EnjoyParty"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_EndProcess" sourceRef="Task_EnjoyParty" targetRef="EndEvent_1"/>

  </bpmn:process>
</bpmn:definitions>