<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Chainsaw_1">

  <bpmn:collaboration id="Collaboration_Chainsaw">
    <!-- Manufacturer Pool -->
    <bpmn:participant id="Participant_Manufacturer" name="Production Chainsaw GmbH" processRef="Process_Production"/>
    
    <!-- Customer Pool (External) -->
    <bpmn:participant id="Participant_Customer" name="Customer"/>

  </bpmn:collaboration>

  <bpmn:process id="Process_Production" isExecutable="false">
    
    <!-- Lane Set for Organization -->
    <bpmn:laneSet id="LaneSet_Manufacturing">
      <bpmn:lane id="Lane_CustomerService" name="Customer Service Department">
        <bpmn:flowNodeRef>StartEvent_OrderRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendRequestProps</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Production" name="Warehouse Department">
        <bpmn:flowNodeRef>Gateway_OrderParts_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OrderGuideBar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OrderChain</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OrderColor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OrderShield</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OrderMotor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Parts_Converge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_AllPartsReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InspectParts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssembleSaw</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_OrderRequest" name="Chainsaw order request">
      <bpmn:outgoing>SequenceFlow_StartToOrder</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Send Task to Customer for Properties -->
    <bpmn:sendTask id="Task_SendRequestProps" name="Send Request for properties">
      <bpmn:incoming>SequenceFlow_StartToOrder</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RequestSent</bpmn:outgoing>
    </bpmn:sendTask>

    <!-- Manual Task to Set Properties -->
    <bpmn:manualTask id="Task_SetProperties" name="Set properties">
      <bpmn:incoming>SequenceFlow_PropertiesReceived</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PropertiesSet</bpmn:outgoing>
    </bpmn:manualTask>

    <!-- Parallel Gateway Split for Ordering Parts -->
    <bpmn:parallelGateway id="Gateway_OrderParts_Split" name="">
      <bpmn:incoming>SequenceFlow_PropertiesSet</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OrderGuideBar</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_OrderChain</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_OrderColor</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_OrderShield</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_OrderMotor</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Service Tasks for Ordering Parts -->
    <bpmn:serviceTask id="Task_OrderGuideBar" name="Order guide bar">
      <bpmn:incoming>SequenceFlow_OrderGuideBar</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GuideArrived</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_OrderChain" name="Order chain">
      <bpmn:incoming>SequenceFlow_OrderChain</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ChainArrived</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_OrderColor" name="Order color">
      <bpmn:incoming>SequenceFlow_OrderColor</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ColorArrived</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_OrderShield" name="Order protective shield">
      <bpmn:incoming>SequenceFlow_OrderShield</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ShieldArrived</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_OrderMotor" name="Order motor">
      <bpmn:incoming>SequenceFlow_OrderMotor</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MotorArrived</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Intermediate Catch Event for Parts Arrival -->
    <bpmn:intermediateCatchEvent id="Event_AllPartsReceived" name="All parts received">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SequenceFlow_PartsConverged</bpmn:incoming>
    </bpmn:intermediateCatchEvent>

    <!-- Parallel Gateway Converge for Parts Arrival -->
    <bpmn:parallelGateway id="Gateway_Parts_Converge" name="">
      <bpmn:incoming>SequenceFlow_GuideArrived</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ChainArrived</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ColorArrived</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ShieldArrived</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_MotorArrived</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StartInspection</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Manual Task for Inspection -->
    <bpmn:manualTask id="Task_InspectParts" name="Manual inspection">
      <bpmn:incoming>SequenceFlow_PartsConverged</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AssemblyStart</bpmn:outgoing>
    </bpmn:manualTask>

    <!-- Manual Task for Assembly -->
    <bpmn:manualTask id="Task_AssembleSaw" name="Assemble parts">
      <bpmn:incoming>SequenceFlow_AssemblyStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FirstSawReady</bpmn:outgoing>
    </bpmn:manualTask>

    <!-- Send First Saw to Customer -->
    <bpmn:sendTask id="Task_SendFirstSaw" name="Send chainsaw to customer">
      <bpmn:incoming>SequenceFlow_FirstSawReady</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SentToCustomer</bpmn:outgoing>
    </bpmn:sendTask>

    <!-- Receive Feedback from Customer -->
    <bpmn:receiveTask id="Event_ReceiveFeedback" name="Receive feedback">
       <bpmn:messageEventDefinition/>
      <bpmn:incoming>SequenceFlow_SentToCustomer</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FeedbackReceived</bpmn:outgoing>
    </bpmn:receiveTask>

    <!-- Exclusive Gateway for Feedback Decision -->
    <bpmn:exclusiveGateway id="Gateway_CustomerLikes" name="Customer likes chainsaw?">
      <bpmn:incoming>SequenceFlow_FeedbackReceived</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_YesFeedback</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoFeedback</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_OrderCompleted" name="Chainsaw order completed">
      <bpmn:incoming>SequenceFlow_YesFeedback</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows for Logic Connections -->
    
    <!-- Start Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToOrder" sourceRef="StartEvent_OrderRequest" targetRef="Task_SendRequestProps"/>
    
    <!-- Request/Receive Properties (Simplified internal flow) -->
    <bpmn:exclusiveGateway id="Gateway_PropertiesReceived">
        <bpmn:incoming>SequenceFlow_RequestSent</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow_ReceivePropsDone</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Properties Set Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_PropertiesSet" sourceRef="Task_SetProperties" targetRef="Gateway_OrderParts_Split"/>
    
    <!-- Order Parts Flows (Split) -->
    <bpmn:sequenceFlow id="SequenceFlow_OrderGuideBar" name="" sourceRef="Gateway_OrderParts_Split" targetRef="Task_OrderGuideBar"/>
    <bpmn:sequenceFlow id="SequenceFlow_OrderChain" name="" sourceRef="Gateway_OrderParts_Split" targetRef="Task_OrderChain"/>
    <bpmn:sequenceFlow id="SequenceFlow_OrderColor" name="" sourceRef="Gateway_OrderParts_Split" targetRef="Task_OrderColor"/>
    <bpmn:sequenceFlow id="SequenceFlow_OrderShield" name="" sourceRef="Gateway_OrderParts_Split" targetRef="Task_OrderShield"/>
    <bpmn:sequenceFlow id="SequenceFlow_OrderMotor" name="" sourceRef="Gateway_OrderParts_Split" targetRef="Task_OrderMotor"/>

    <!-- Order Parts Flows (Converge) -->
    <bpmn:sequenceFlow id="SequenceFlow_GuideArrived" name="" sourceRef="Task_OrderGuideBar" targetRef="Gateway_Parts_Converge"/>
    <bpmn:sequenceFlow id="SequenceFlow_ChainArrived" name="" sourceRef="Task_OrderChain" targetRef="Gateway_Parts_Converge"/>
    <bpmn:sequenceFlow id="SequenceFlow_ColorArrived" name="" sourceRef="Task_OrderColor" targetRef="Gateway_Parts_Converge"/>
    <bpmn:sequenceFlow id="SequenceFlow_ShieldArrived" name="" sourceRef="Task_OrderShield" targetRef="Gateway_Parts_Converge"/>
    <bpmn:sequenceFlow id="SequenceFlow_MotorArrived" name="" sourceRef="Task_OrderMotor" targetRef="Gateway_Parts_Converge"/>

    <!-- Inspection & Assembly Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_StartInspection" name="" sourceRef="Gateway_Parts_Converge" targetRef="Event_AllPartsReceived">
        <bpmn:name>Wait for parts</bpmn:name>
    </bpmn:sequenceFlow>

     <!-- Correction on Flow to Inspection Task -->
    <bpmn:sequenceFlow id="SequenceFlow_StartInspection2" name="" sourceRef="Event_AllPartsReceived" targetRef="Task_InspectParts"/>

    <bpmn:sequenceFlow id="SequenceFlow_AssemblyStart" name="" sourceRef="Task_InspectParts" targetRef="Task_AssembleSaw"/>
    
    <!-- First Saw Ready Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_FirstSawReady" name="" sourceRef="Task_AssembleSaw" targetRef="Task_SendFirstSaw"/>

    <!-- Feedback Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_SentToCustomer" name="" sourceRef="Task_SendFirstSaw" targetRef="Event_ReceiveFeedback">
        <bpmn:name>Send to Customer</bpmn:name>
    </bpmn:sequenceFlow>

     <!-- Feedback Received Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_FeedbackReceived" name="" sourceRef="Event_ReceiveFeedback" targetRef="Gateway_CustomerLikes"/>

    <!-- Decision Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_YesFeedback" name="yes" sourceRef="Gateway_CustomerLikes" targetRef="EndEvent_OrderCompleted">
        <bpmn:name>Produce rest</bpmn:name>
    </bpmn:sequenceFlow>

     <!-- Loop Back if No Feedback -->
    <bpmn:sequenceFlow id="SequenceFlow_NoFeedback" name="no" sourceRef="Gateway_CustomerLikes" targetRef="Task_SendRequestProps">
        <bpmn:name>No feedback</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>

</bpmn:definitions>