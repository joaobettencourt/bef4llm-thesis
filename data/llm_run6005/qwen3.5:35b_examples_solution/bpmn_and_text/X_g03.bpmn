<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_ViennaNightRun_1">
  <bpmn:collaboration id="Collaboration_RunnerApp">
    <bpmn:participant id="Participant_ProcessExecution" name="Vienna Night Run App Process" processRef="Process_RunEvent"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_RunEvent" isExecutable="false">
    
    <!-- Data Objects -->
    <bpmn:dataObject id="DataAppInput" name="Runner Input (App)" />
    <bpmn:dataObject id="DataFitnessGadget" name="Running Time Measurement (Fitness Gadget)" />

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Participate">
      <bpmn:outgoing>SequenceFlow_SelectBlock</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Select Starting Block -->
    <bpmn:task id="Task_SelectStartingBlock" name="Select starting block">
      <bpmn:incoming>SequenceFlow_SelectBlock</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SplitRunMeasure</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway 1 (Diverging) -->
    <bpmn:parallelGateway id="ParallelSplit_RunMeasure" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow_SplitRunMeasure</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TaskRun5km</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_TaskMeasureTimeStart</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 2: Run for 5 km -->
    <bpmn:task id="Task_Run5km" name="Run for 5 km">
      <bpmn:incoming>SequenceFlow_TaskRun5km</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConvergeMeasure</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3: Measure time -->
    <bpmn:task id="Task_MeasureTime" name="Measure the time">
      <bpmn:incoming>SequenceFlow_TaskMeasureTimeStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConvergeMeasure</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway 2 (Converging) -->
    <bpmn:parallelGateway id="ParallelMerge_RunMeasure" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow_ConvergeMeasure</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckTimeResult</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 4: Get total running time -->
    <bpmn:task id="Task_GetTotalTime" name="Get total running time">
      <bpmn:incoming>SequenceFlow_CheckTimeResult</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_25MinutesCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway 1: Less than 25 minutes? -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_TimeResult" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow_25MinutesCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TrainLoop</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_GetStartingNumber</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 5: Do Training (if not satisfied) -->
    <bpmn:task id="Task_DoTraining" name="Do training">
      <bpmn:incoming>SequenceFlow_TrainLoop</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReturnToRunMeasure</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 6: Get starting number -->
    <bpmn:task id="Task_GetStartingNumber" name="Get your starting number">
      <bpmn:incoming>SequenceFlow_GetStartingNumber</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WorkTimeCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway 2: Work time check -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_WorkTime" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow_WorkTimeCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GoFromHome</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_GoDirectlyWork</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 7: Go from home -->
    <bpmn:task id="Task_GoFromHome" name="Go to the run from home">
      <bpmn:incoming>SequenceFlow_GoFromHome</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConvergeBeforeRun</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 8: Go directly from work -->
    <bpmn:task id="Task_GoDirectlyWork" name="Go directly after work to the run">
      <bpmn:incoming>SequenceFlow_GoDirectlyWork</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConvergeBeforeRun</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway 3 (Convergence) -->
    <bpmn:exclusiveGateway id="ExclusiveMerge_BeforeRun" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow_ConvergeBeforeRun</bpmn:outgoing>
      <bpmn:incoming>SequenceFlow_GoFromHome</bpmn:incoming> <!-- Correction below -->
    </bpmn:exclusiveGateway>

    <!-- Parallel Gateway 4 (Diverging for Run and Drink) -->
    <bpmn:parallelGateway id="ParallelSplit_RunDrink" gatewayDirection="Diverging">
      <bpmn:outgoing>SequenceFlow_TaskRunNight</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_TaskDrinkIsoSport</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 9: Run the night run -->
    <bpmn:task id="Task_RunNightRun" name="Run the Night Run">
      <bpmn:incoming>SequenceFlow_TaskRunNight</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ConvergeEndProcess</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 10: Drink iso sport -->
    <bpmn:task id="Task_DrinkIsoSport" name="Drink iso sport">
      <bpmn:incoming>SequenceFlow_TaskDrinkIsoSport</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ConvergeEndProcess</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway 5 (Convergence) -->
    <bpmn:parallelGateway id="ParallelMerge_RunDrink" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow_ConvergeEndProcess</bpmn:outgoing>
      <bpmn:incoming>SequenceFlow_TaskRunNight</bpmn:incoming> <!-- Correction below -->
    </bpmn:parallelGateway>

    <!-- Task 11: Receive final running time -->
    <bpmn:task id="Task_ReceiveFinalTime" name="Receive your final running time">
      <bpmn:incoming>SequenceFlow_ConvergeEndProcess</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_EndEvent</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_RunFinished">
      <bpmn:incoming>SequenceFlow_EndEvent</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_SelectBlock" sourceRef="StartEvent_Participate" targetRef="Task_SelectStartingBlock"/>
    <bpmn:sequenceFlow id="SequenceFlow_SplitRunMeasure" sourceRef="Task_SelectStartingBlock" targetRef="ParallelSplit_RunMeasure"/>
    <bpmn:sequenceFlow id="SequenceFlow_TaskRun5km" sourceRef="ParallelSplit_RunMeasure" targetRef="Task_Run5km"/>
    <bpmn:sequenceFlow id="SequenceFlow_TaskMeasureTimeStart" sourceRef="ParallelSplit_RunMeasure" targetRef="Task_MeasureTime"/>
    <bpmn:sequenceFlow id="SequenceFlow_ConvergeMeasure" sourceRef="Task_Run5km" targetRef="ParallelMerge_RunMeasure"/>
    <bpmn:sequenceFlow id="SequenceFlow_CheckTimeResult" sourceRef="ParallelSplit_RunMeasure" targetRef="ParallelMerge_RunMeasure"/> <!-- Correction below -->
    
  </bpmn:process>

</bpmn:definitions>