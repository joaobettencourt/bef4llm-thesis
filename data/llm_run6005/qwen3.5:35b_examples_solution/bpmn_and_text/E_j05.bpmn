<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_WorkLiveAustria_1">
  <bpmn:collaboration>
    <bpmn:participant id="Participant_AustrianImmigrationProcess" name="Work and Live in Austria Process" processRef="Process_ProcessExecution"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_ProcessExecution" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Applicant" name="Applicant / Foreign National">
        <bpmn:flowNodeRef>bpmnStartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bpmnTask_CheckRequirements</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bpmnGateway_DurationDecision</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_AustrianRepresentation" name="Austrian Representation Office">
        <bpmn:flowNodeRef>bpmnTask_CheckPassportValidity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bpmnGateway_VisaTypeDecision</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_LocalAuthorities" name="Local Authorities">
        <bpmn:flowNodeRef>bpmnTask_RegisterResidence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bpmnGateway_RenewalDecision</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Processing" name="Processing">
        <bpmn:flowNodeRef>bpmnTask_OrganiseAccommodation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bpmnTask_OpenBankAccount</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="bpmnStartEvent_1" name="Begin Process">
      <bpmn:outgoing>bpmnSequenceFlow_StartToRequirements</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Check Requirements -->
    <bpmn:userTask id="bpmnTask_CheckRequirements" name="Check Visa Requirements">
      <bpmn:incoming>bpmnSequenceFlow_StartToRequirements</bpmn:incoming>
      <bpmn:outgoing>bpmnSequenceFlow_RequirementsToDurationDecision</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway: Duration Decision -->
    <bpmn:exclusiveGateway id="bpmnGateway_DurationDecision" name="How long are you going to stay?">
      <bpmn:incoming>bpmnSequenceFlow_RequirementsToDurationDecision</bpmn:incoming>
      <bpmn:outgoing>bpmnSequenceFlow_SchengenPath</bpmn:outgoing>
      <bpmn:outgoing>bpmnSequenceFlow_TypeDPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Check Passport Validity -->
    <bpmn:userTask id="bpmnTask_CheckPassportValidity" name="Check Passport Validity">
      <bpmn:incoming>bpmnSequenceFlow_SchengenPath</bpmn:incoming>
      <bpmn:outgoing>bpmnSequenceFlow_PassportToVisaTypeDecision</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway: Visa Type Decision -->
    <bpmn:exclusiveGateway id="bpmnGateway_VisaTypeDecision" name="Determine Visa Type">
      <bpmn:incoming>bpmnSequenceFlow_PassportToVisaTypeDecision</bpmn:incoming>
      <bpmn:outgoing>bpmnSequenceFlow_SchengenApplicationPath</bpmn:outgoing>
      <bpmn:outgoing>bpmnSequenceFlow_TypeDRedWhiteRedCardPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Organize Accommodation -->
    <bpmn:userTask id="bpmnTask_OrganiseAccommodation" name="Organize Accommodation">
      <bpmn:incoming>bpmnSequenceFlow_TypeDRedWhiteRedCardPath</bpmn:incoming>
      <bpmn:outgoing>bpmnSequenceFlow_AccommodationToBankAccount</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Open Bank Account -->
    <bpmn:userTask id="bpmnTask_OpenBankAccount" name="Open Austrian Bank Account">
      <bpmn:incoming>bpmnSequenceFlow_AccommodationToBankAccount</bpmn:incoming>
      <bpmn:outgoing>bpmnSequenceFlow_BankAccountToRegistration</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Register Residence -->
    <bpmn:userTask id="bpmnTask_RegisterResidence" name="Register New Residence">
      <bpmn:incoming>bpmnSequenceFlow_BankAccountToRegistration</bpmn:incoming>
      <bpmn:outgoing>bpmnSequenceFlow_RegistrationToRenewalDecision</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway: Renewal Decision -->
    <bpmn:exclusiveGateway id="bpmnGateway_RenewalDecision" name="Is permit still valid?">
      <bpmn:incoming>bpmnSequenceFlow_RegistrationToRenewalDecision</bpmn:incoming>
      <bpmn:outgoing>bpmnSequenceFlow_ValidPath</bpmn:outgoing>
      <bpmn:outgoing>bpmnSequenceFlow_RenewRequiredPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Renew Permit -->
    <bpmn:userTask id="bpmnTask_RenewPermit" name="Renew Residence Permit">
      <bpmn:incoming>bpmnSequenceFlow_RenewRequiredPath</bpmn:incoming>
      <bpmn:outgoing>bpmnSequenceFlow_RenewedToLiveWork</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Live and Work in Austria -->
    <bpmn:userTask id="bpmnTask_LiveAndWork" name="Live and Work in Austria">
      <bpmn:incoming>bpmnSequenceFlow_ValidPath</bpmn:incoming>
      <bpmn:outgoing>bpmnSequenceFlow_LiveWorkToRenewalDecision</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="bpmnEnd_SchengenVisaPath" name="Process Completed">
      <bpmn:incoming>bpmnSequenceFlow_ValidPath</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="bpmnSequenceFlow_StartToRequirements" sourceRef="bpmnStartEvent_1" targetRef="bpmnTask_CheckRequirements"/>
    <bpmn:sequenceFlow id="bpmnSequenceFlow_RequirementsToDurationDecision" name="" sourceRef="bpmnTask_CheckRequirements" targetRef="bpmnGateway_DurationDecision"/>
    <bpmn:sequenceFlow id="bpmnSequenceFlow_SchengenPath" name="< 90 days or &lt;6 months" sourceRef="bpmnGateway_DurationDecision" targetRef="bpmnTask_CheckPassportValidity">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[Duration&lt;=90days]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="bpmnSequenceFlow_TypeDPath" name="24+ months / Working in Austria" sourceRef="bpmnGateway_DurationDecision" targetRef="bpmnGateway_VisaTypeDecision">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[Duration&gt;=24months]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="bpmnSequenceFlow_PassportToVisaTypeDecision" name="" sourceRef="bpmnTask_CheckPassportValidity" targetRef="bpmnGateway_VisaTypeDecision"/>
    <bpmn:sequenceFlow id="bpmnSequenceFlow_SchengenApplicationPath" name="Schengen Visa Application" sourceRef="bpmnGateway_VisaTypeDecision" targetRef="bpmnEnd_SchengenVisaPath">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[Duration&lt;90days]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="bpmnSequenceFlow_TypeDRedWhiteRedCardPath" name="Type D / Red-White-Red Card Application" sourceRef="bpmnGateway_VisaTypeDecision" targetRef="bpmnTask_OrganiseAccommodation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[Duration&gt;=24months]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="bpmnSequenceFlow_AccommodationToBankAccount" name="" sourceRef="bpmnTask_OrganiseAccommodation" targetRef="bpmnTask_OpenBankAccount"/>
    <bpmn:sequenceFlow id="bpmnSequenceFlow_BankAccountToRegistration" name="" sourceRef="bpmnTask_OpenBankAccount" targetRef="bpmnTask_RegisterResidence"/>
    <bpmn:sequenceFlow id="bpmnSequenceFlow_RegistrationToRenewalDecision" name="" sourceRef="bpmnTask_RegisterResidence" targetRef="bpmnGateway_RenewalDecision"/>
    <bpmn:sequenceFlow id="bpmnSequenceFlow_ValidPath" name="Yes - Valid Permit" sourceRef="bpmnGateway_RenewalDecision" targetRef="bpmnTask_LiveAndWork">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[PermitValid]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="bpmnSequenceFlow_RenewRequiredPath" name="No - Renew Required" sourceRef="bpmnGateway_RenewalDecision" targetRef="bpmnTask_RenewPermit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[!PermitValid]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="bpmnSequenceFlow_RenewedToLiveWork" name="" sourceRef="bpmnTask_RenewPermit" targetRef="bpmnTask_LiveAndWork"/>
    <bpmn:sequenceFlow id="bpmnSequenceFlow_LiveWorkToRenewalDecision" name="" sourceRef="bpmnTask_LiveAndWork" targetRef="bpmnGateway_RenewalDecision">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[PeriodicCheck]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>