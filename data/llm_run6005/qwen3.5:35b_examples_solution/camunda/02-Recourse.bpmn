<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_RecourseProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_RecourseClerk">
    <bpmn:participant id="Participant_RecourseClerk" name="Recourse Clerk" processRef="Process_Recourse01"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Recourse01" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_ProbableRecourseDetected" name="Probable Recourse Detected">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SF_CheckCase</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1 -->
    <bpmn:task id="Task_CheckCase" name="Check Case">
      <bpmn:incoming>SF_CheckCase</bpmn:incoming>
      <bpmn:outgoing>SF_RecoursePossibleGateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1 -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_RecoursePossible" name="Recourse Possible?">
      <bpmn:incoming>SF_RecoursePossibleGateway</bpmn:incoming>
      <bpmn:outgoing>SF_SendPaymentRequestYes</bpmn:outgoing>
      <bpmn:outgoing>SF_CloseCaseNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 2 -->
    <bpmn:task id="Task_SendPaymentRequest" name="Send Request for Payment">
      <bpmn:incoming>SF_SendPaymentRequestYes</bpmn:incoming>
      <bpmn:outgoing>SF_MakeReminder</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3 -->
    <bpmn:task id="Task_CloseCaseNoRecourse" name="Close Case">
      <bpmn:incoming>SF_CloseCaseNo</bpmn:incoming>
      <bpmn:outgoing>SF_EndClosed1</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 1 -->
    <bpmn:endEvent id="EndEvent_CaseClosed1" name="Case Closed">
      <bpmn:incoming>SF_EndClosed1</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task 4 -->
    <bpmn:task id="Task_MakeReminder" name="Make Reminder">
      <bpmn:incoming>SF_MakeReminder</bpmn:incoming>
      <bpmn:outgoing>SF_EventBasedGatewayWaitForEvents</bpmn:outgoing>
    </bpmn:task>

    <!-- Event Based Gateway -->
    <bpmn:eventBasedGateway id="EventBasedGateway_WaitForEvents">
      <bpmn:incoming>SF_EventBasedGatewayWaitForEvents</bpmn:incoming>
      <bpmn:outgoing>SF_DisagreementLetterReceivedPath</bpmn:outgoing>
      <bpmn:outgoing>SF_MoneyReceivedPath</bpmn:outgoing>
      <bpmn:outgoing>SF_ReminderDuePath</bpmn:outgoing>
    </bpmn:eventBasedGateway>

    <!-- Intermediate Catch Event 1 -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_DisagreementLetter" name="Disagreement Letter Received">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SF_DisagreementLetterReceivedPath</bpmn:incoming>
      <bpmn:outgoing>SF_CheckReasoning</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task 5 -->
    <bpmn:task id="Task_CheckReasoning" name="Check Reasoning">
      <bpmn:incoming>SF_CheckReasoning</bpmn:incoming>
      <bpmn:outgoing>SF_InsurantRightGateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2 -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_InsurantRight" name="Is Insurant Right?">
      <bpmn:incoming>SF_InsurantRightGateway</bpmn:incoming>
      <bpmn:outgoing>SF_CloseCaseReasoningYes</bpmn:outgoing>
      <bpmn:outgoing>SF_ForwardToCollectionNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 6 -->
    <bpmn:task id="Task_CloseCaseReasoning" name="Close Case">
      <bpmn:incoming>SF_CloseCaseReasoningYes</bpmn:incoming>
      <bpmn:outgoing>SF_EndClosed2</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 2 -->
    <bpmn:endEvent id="EndEvent_CaseClosed2" name="Case Closed">
      <bpmn:incoming>SF_EndClosed2</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task 7 -->
    <bpmn:task id="Task_ForwardToCollectionAgencyInsurantWrong" name="Forward to Collection Agency">
      <bpmn:incoming>SF_ForwardToCollectionNo</bpmn:incoming>
      <bpmn:outgoing>SF_EndOpen1</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 3 -->
    <bpmn:endEvent id="EndEvent_CaseOpen" name="Case Open">
      <bpmn:incoming>SF_EndOpen1</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Intermediate Catch Event 2 (Timer) -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_ReminderDue" name="Reminder Due">
      <bpmn:timerEventDefinition/>
      <bpmn:incoming>SF_ReminderDuePath</bpmn:incoming>
      <bpmn:outgoing>SF_ForwardToCollectionAgencyDeadlineReached</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task 8 -->
    <bpmn:task id="Task_ForwardToCollectionAgencyDeadline" name="Forward to Collection Agency">
      <bpmn:incoming>SF_ForwardToCollectionAgencyDeadlineReached</bpmn:incoming>
      <bpmn:outgoing>SF_EndOpen2</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 4 -->
    <bpmn:endEvent id="EndEvent_CaseOpen2" name="Case Open">
      <bpmn:incoming>SF_EndOpen2</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Intermediate Catch Event 3 (Message) -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_MoneyReceived" name="Money Received">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SF_MoneyReceivedPath</bpmn:incoming>
      <bpmn:outgoing>SF_MakeBooking</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task 9 -->
    <bpmn:task id="Task_MakeBooking" name="Make Booking">
      <bpmn:incoming>SF_MakeBooking</bpmn:incoming>
      <bpmn:outgoing>SF_CloseCaseMoneyReceived</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 10 -->
    <bpmn:task id="Task_CloseCaseMoney" name="Close Case">
      <bpmn:incoming>SF_CloseCaseMoneyReceived</bpmn:incoming>
      <bpmn:outgoing>SF_EndClosed3</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 5 -->
    <bpmn:endEvent id="EndEvent_CaseClosed3" name="Case Closed">
      <bpmn:incoming>SF_EndClosed3</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SF_CheckCase" sourceRef="StartEvent_ProbableRecourseDetected" targetRef="Task_CheckCase"/>
    
    <bpmn:sequenceFlow id="SF_RecoursePossibleGateway" sourceRef="Task_CheckCase" targetRef="ExclusiveGateway_RecoursePossible"/>

    <bpmn:sequenceFlow id="SF_SendPaymentRequestYes" name="yes" sourceRef="ExclusiveGateway_RecoursePossible" targetRef="Task_SendPaymentRequest"/>
    
    <bpmn:sequenceFlow id="SF_CloseCaseNo" name="no" sourceRef="ExclusiveGateway_RecoursePossible" targetRef="Task_CloseCaseNoRecourse"/>

    <bpmn:sequenceFlow id="SF_EndClosed1" sourceRef="Task_CloseCaseNoRecourse" targetRef="EndEvent_CaseClosed1"/>
    
    <bpmn:sequenceFlow id="SF_MakeReminder" sourceRef="Task_SendPaymentRequest" targetRef="Task_MakeReminder"/>

    <bpmn:sequenceFlow id="SF_EventBasedGatewayWaitForEvents" sourceRef="Task_MakeReminder" targetRef="EventBasedGateway_WaitForEvents"/>
    
    <!-- Disagreement Letter Path -->
    <bpmn:sequenceFlow id="SF_DisagreementLetterReceivedPath" sourceRef="EventBasedGateway_WaitForEvents" targetRef="IntermediateCatchEvent_DisagreementLetter"/>

    <bpmn:sequenceFlow id="SF_CheckReasoning" sourceRef="IntermediateCatchEvent_DisagreementLetter" targetRef="Task_CheckReasoning"/>
    
    <!-- Insurant Right/Wrong Gateway -->
    <bpmn:sequenceFlow id="SF_InsurantRightGateway" sourceRef="Task_CheckReasoning" targetRef="ExclusiveGateway_InsurantRight"/>

    <bpmn:sequenceFlow id="SF_CloseCaseReasoningYes" name="yes" sourceRef="ExclusiveGateway_InsurantRight" targetRef="Task_CloseCaseReasoning"/>
    
    <bpmn:sequenceFlow id="SF_ForwardToCollectionNo" name="no" sourceRef="ExclusiveGateway_InsurantRight" targetRef="Task_ForwardToCollectionAgencyInsurantWrong"/>

    <bpmn:sequenceFlow id="SF_EndClosed2" sourceRef="Task_CloseCaseReasoning" targetRef="EndEvent_CaseClosed2"/>
    
    <!-- Deadline Reached Path -->
    <bpmn:sequenceFlow id="SF_ReminderDuePath" sourceRef="EventBasedGateway_WaitForEvents" targetRef="IntermediateCatchEvent_ReminderDue"/>

    <bpmn:sequenceFlow id="SF_ForwardToCollectionAgencyDeadlineReached" sourceRef="IntermediateCatchEvent_ReminderDue" targetRef="Task_ForwardToCollectionAgencyDeadline"/>
    
    <!-- Money Received Path -->
    <bpmn:sequenceFlow id="SF_MoneyReceivedPath" sourceRef="EventBasedGateway_WaitForEvents" targetRef="IntermediateCatchEvent_MoneyReceived"/>

    <bpmn:sequenceFlow id="SF_EndOpen1" sourceRef="Task_ForwardToCollectionAgencyInsurantWrong" targetRef="EndEvent_CaseOpen"/>
    
    <!-- Money Received Flow -->
    <bpmn:sequenceFlow id="SF_MakeBooking" sourceRef="IntermediateCatchEvent_MoneyReceived" targetRef="Task_MakeBooking"/>

    <bpmn:sequenceFlow id="SF_CloseCaseMoneyReceived" sourceRef="Task_MakeBooking" targetRef="Task_CloseCaseMoney"/>
    
    <!-- Deadline Reached Flow -->
    <bpmn:sequenceFlow id="SF_EndOpen2" sourceRef="Task_ForwardToCollectionAgencyDeadline" targetRef="EndEvent_CaseOpen2"/>

    <bpmn:sequenceFlow id="SF_EndClosed3" sourceRef="Task_CloseCaseMoney" targetRef="EndEvent_CaseClosed3"/>
  </bpmn:process>
</bpmn:definitions>