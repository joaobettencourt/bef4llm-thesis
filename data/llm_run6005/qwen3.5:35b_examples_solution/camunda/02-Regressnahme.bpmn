<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Regressnahme_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_RegressProzess">
    <bpmn:participant id="Participant_Sachbearbeiter" name="Regressnahme Sachbearbeiter" processRef="Process_Regress_01"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Regress_01" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_VermerkRegress" name="Regressverdacht gemeldet">
      <bpmn:messageEventDefinition />
      <bpmn:outgoing>SequenceFlow_StartPruefen</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1 -->
    <bpmn:task id="Task_FallPruefung" name="Fall prüfen">
      <bpmn:incoming>SequenceFlow_StartPruefen</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PruefGateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1 -->
    <bpmn:exclusiveGateway id="Gateway_RegressMoeglich" name="Regress möglich?">
      <bpmn:incoming>SequenceFlow_PruefGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Zahlungsaufforderung</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_VorgangSchliessen1</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 2 -->
    <bpmn:task id="Task_Zahlungsaufforderung" name="Zahlungsaufforderung an VN schicken">
      <bpmn:incoming>SequenceFlow_Zahlungsaufforderung</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WiedervorlageSetzen</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3 -->
    <bpmn:task id="Task_WiedervorlageSetzen" name="Vorgang auf Wiedervorlage setzen">
      <bpmn:incoming>SequenceFlow_WiedervorlageSetzen</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EventBasedGatewayIn</bpmn:outgoing>
    </bpmn:task>

    <!-- Event Based Gateway -->
    <bpmn:eventBasedGateway id="EventBasedGateway_01">
      <bpmn:incoming>SequenceFlow_EventBasedGatewayIn</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GeldEingangWait</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_WiderspruchWait</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_FristAblaufWait</bpmn:outgoing>
    </bpmn:eventBasedGateway>

    <!-- Intermediate Catch Event - Geld -->
    <bpmn:intermediateCatchEvent id="Intermediate_GeldEingang" name="Geld eingegangen">
      <bpmn:messageEventDefinition />
      <bpmn:incoming>SequenceFlow_GeldEingangWait</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EingangVerbuchen</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task 4 -->
    <bpmn:task id="Task_Geldeingang" name="Geldeingang verbuchen">
      <bpmn:incoming>SequenceFlow_EingangVerbuchen</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CloseCaseMoney</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 1 -->
    <bpmn:endEvent id="EndEvent_VorgangGeschlossen2" name="Vorgang geschlossen">
      <bpmn:incoming>SequenceFlow_CloseCaseMoney</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Intermediate Catch Event - Widerspruch -->
    <bpmn:intermediateCatchEvent id="Intermediate_WiderspruchErhalten" name="Widerspruch erhalten">
      <bpmn:messageEventDefinition />
      <bpmn:incoming>SequenceFlow_WiderspruchWait</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PruefWiderspruch</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task 5 -->
    <bpmn:task id="Task_WiderspruchPruefen" name="Widerspruch prüfen">
      <bpmn:incoming>SequenceFlow_PruefWiderspruch</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GerechtfertigtGateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2 -->
    <bpmn:exclusiveGateway id="Gateway_Gerechtfertigt" name="Gerechtfertigt?">
      <bpmn:incoming>SequenceFlow_GerechtfertigtGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CloseCaseObjection</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_InkassoFromObjection</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 6 -->
    <bpmn:task id="Task_SchliessenObjection" name="Vorgang schließen">
      <bpmn:incoming>SequenceFlow_CloseCaseObjection</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToEnd3</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 2 -->
    <bpmn:endEvent id="EndEvent_VorgangGeschlossen3" name="Vorgang geschlossen">
      <bpmn:incoming>SequenceFlow_ToEnd3</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task 7 -->
    <bpmn:task id="Task_InkassoFromObjection" name="Vorgang an Inkasso-Dienstleister geben">
      <bpmn:incoming>SequenceFlow_InkassoFromObjection</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToEndInkasso1</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 3 -->
    <bpmn:endEvent id="EndEvent_VorgangOffen1" name="Vorgang offen">
      <bpmn:incoming>SequenceFlow_ToEndInkasso1</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Intermediate Catch Event - Frist -->
    <bpmn:intermediateCatchEvent id="Intermediate_FristAblauf" name="Wiedervorlage fällig">
      <bpmn:timerEventDefinition />
      <bpmn:incoming>SequenceFlow_FristAblaufWait</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToInkassoTimer</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task 8 -->
    <bpmn:task id="Task_InkassoFromDeadline" name="Vorgang an Inkasso-Dienstleister geben">
      <bpmn:incoming>SequenceFlow_ToInkassoTimer</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToEndInkasso2</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 4 -->
    <bpmn:endEvent id="EndEvent_VorgangOffen2" name="Vorgang offen">
      <bpmn:incoming>SequenceFlow_ToEndInkasso2</bpmn:incoming>
    </bpmn:endEvent>

    <!-- End Event 5 -->
    <bpmn:endEvent id="EndEvent_VorgangGeschlossen1" name="Vorgang geschlossen">
      <bpmn:incoming>SequenceFlow_VorgangSchliessen1</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartPruefen" sourceRef="StartEvent_VermerkRegress" targetRef="Task_FallPruefung"/>
    <bpmn:sequenceFlow id="SequenceFlow_PruefGateway" sourceRef="Task_FallPruefung" targetRef="Gateway_RegressMoeglich"/>
    <bpmn:sequenceFlow id="SequenceFlow_Zahlungsaufforderung" name="Ja" sourceRef="Gateway_RegressMoeglich" targetRef="Task_Zahlungsaufforderung"/>
    <bpmn:sequenceFlow id="SequenceFlow_VorgangSchliessen1" name="Nein" sourceRef="Gateway_RegressMoeglich" targetRef="EndEvent_VorgangGeschlossen1"/>
    <bpmn:sequenceFlow id="SequenceFlow_WiedervorlageSetzen" sourceRef="Task_Zahlungsaufforderung" targetRef="Task_WiedervorlageSetzen"/>
    <bpmn:sequenceFlow id="SequenceFlow_EventBasedGatewayIn" sourceRef="Task_WiedervorlageSetzen" targetRef="EventBasedGateway_01"/>

    <!-- Geld Path -->
    <bpmn:sequenceFlow id="SequenceFlow_GeldEingangWait" sourceRef="EventBasedGateway_01" targetRef="Intermediate_GeldEingang"/>
    <bpmn:sequenceFlow id="SequenceFlow_EingangVerbuchen" sourceRef="Intermediate_GeldEingang" targetRef="Task_Geldeingang"/>
    <bpmn:sequenceFlow id="SequenceFlow_CloseCaseMoney" sourceRef="Task_Geldeingang" targetRef="EndEvent_VorgangGeschlossen2"/>

    <!-- Widerspruch Path -->
    <bpmn:sequenceFlow id="SequenceFlow_WiderspruchWait" sourceRef="EventBasedGateway_01" targetRef="Intermediate_WiderspruchErhalten"/>
    <bpmn:sequenceFlow id="SequenceFlow_PruefWiderspruch" sourceRef="Intermediate_WiderspruchErhalten" targetRef="Task_WiderspruchPruefen"/>

    <!-- Gateway 2 Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_GerechtfertigtGateway" sourceRef="Task_WiderspruchPruefen" targetRef="Gateway_Gerechtfertigt"/>
    <bpmn:sequenceFlow id="SequenceFlow_CloseCaseObjection" name="Ja" sourceRef="Gateway_Gerechtfertigt" targetRef="Task_SchliessenObjection"/>
    <bpmn:sequenceFlow id="SequenceFlow_ToEnd3" sourceRef="Task_SchliessenObjection" targetRef="EndEvent_VorgangGeschlossen3"/>

    <!-- Inkasso from Objection -->
    <bpmn:sequenceFlow id="SequenceFlow_InkassoFromObjection" name="Nein" sourceRef="Gateway_Gerechtfertigt" targetRef="Task_InkassoFromObjection"/>
    <bpmn:sequenceFlow id="SequenceFlow_ToEndInkasso1" sourceRef="Task_InkassoFromObjection" targetRef="EndEvent_VorgangOffen1"/>

    <!-- Frist Path -->
    <bpmn:sequenceFlow id="SequenceFlow_FristAblaufWait" sourceRef="EventBasedGateway_01" targetRef="Intermediate_FristAblauf"/>
    <bpmn:sequenceFlow id="SequenceFlow_ToInkassoTimer" sourceRef="Intermediate_FristAblauf" targetRef="Task_InkassoFromDeadline"/>
    <bpmn:sequenceFlow id="SequenceFlow_ToEndInkasso2" sourceRef="Task_InkassoFromDeadline" targetRef="EndEvent_VorgangOffen2"/>

  </bpmn:process>
</bpmn:definitions>