<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_RestaurantOrdering" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_RestaurantProcess">
    <bpmn:participant id="Participant_Guest" name="Guest" processRef="Process_Guest"/>
    <bpmn:participant id="Participant_Employee" name="Employee" processRef="Process_Employee"/>
    <bpmn:participant id="Participant_Chef" name="Chef" processRef="Process_Chef"/>

    <!-- Message Flows -->
    <bpmn:messageFlow id="Message_GuestToEmp_OrderPlaced" sourceRef="Task_GuestPlaceOrder" targetRef="StartEvent_EmpOrderReceived"/>
    <bpmn:messageFlow id="Message_EmpToChef_ReadyNeeded" sourceRef="Task_EmployeeInformChef" targetRef="StartEvent_ChefMealNeeded"/>
    <bpmn:messageFlow id="Message_ChempToEmp_MealPrepared" sourceRef="Task_ChefInformEmployee" targetRef="IntermediateCatch_EmpWaitForMealReady"/>

  </bpmn:collaboration>

  <!-- Guest Process -->
  <bpmn:process id="Process_Guest">
    <bpmn:startEvent id="StartEvent_GuestArrival" name="Guest Arrives">
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_GuestEnterRestaurant" name="Enters Restaurant">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_GuestChooseDish" name="Chooses Dish">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
    </bpmn:task>

    <bpmn:intermediateCatchEvent id="IntermediateWaitTurn" name="Waits for Turn">
       <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:task id="Task_GuestPlaceOrder" name="Places Order">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
    </bpmn:task>

    <!-- Wait for Buzzer Signal (Message from Employee) -->
    <bpmn:intermediateCatchEvent id="Intermediate_GuestBuzzerRing" name="Buzzer Rings">
      <bpmn:messageEventDefinition/>
       <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:task id="Task_GuestPickUpMeal" name="Picks Up Meal">
       <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
    </bpmn:task>

     <bpmn:endEvent id="End_GuestFinished" name="Guest Finished">
       <bpmn:incoming>SequenceFlow_7</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_GuestArrival" targetRef="Task_GuestEnterRestaurant"/>
    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="Task_GuestEnterRestaurant" targetRef="Task_GuestChooseDish"/>
    <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="Task_GuestChooseDish" targetRef="IntermediateWaitTurn"/>
    <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="IntermediateWaitTurn" targetRef="Task_GuestPlaceOrder"/>
    <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="Task_GuestPlaceOrder" targetRef="Intermediate_GuestBuzzerRing"/>
     <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="Intermediate_GuestBuzzerRing" targetRef="Task_GuestPickUpMeal"/>
    <bpmn:sequenceFlow id="SequenceFlow_7" sourceRef="Task_GuestPickUpMeal" targetRef="End_GuestFinished"/>

  </bpmn:process>

  <!-- Employee Process -->
  <bpmn:process id="Process_Employee">
     <bpmn:startEvent id="StartEvent_EmpOrderReceived" name="Order Received">
      <bpmn:messageEventDefinition/>
       <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_EmployeeEnterPOS" name="Enters Order into POS">
      <bpmn:incoming>SequenceFlow_10</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_11</bpmn:outgoing>
    </bpmn:task>

     <bpmn:task id="Task_EmployeeCollectMoney" name="Collects Money">
      <bpmn:incoming>SequenceFlow_11</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_12</bpmn:outgoing>
    </bpmn:task>

     <bpmn:task id="Task_EmployeeSetBuzzer" name="Sets up Buzzer">
      <bpmn:incoming>SequenceFlow_12</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_13</bpmn:outgoing>
    </bpmn:task>

     <bpmn:task id="Task_EmployeeHandBuzzer" name="Hands Buzzer to Guest">
      <bpmn:incoming>SequenceFlow_13</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_14</bpmn:outgoing>
    </bpmn:task>

     <bpmn:task id="Task_EmployeeInformChef" name="Informs Chef">
      <bpmn:incoming>SequenceFlow_14</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_15</bpmn:outgoing>
    </bpmn:task>

     <!-- Wait for Meal Ready Notification from Chef -->
    <bpmn:intermediateCatchEvent id="IntermediateCatch_EmpWaitForMealReady" name="Meal is Ready">
      <bpmn:messageEventDefinition/>
       <bpmn:incoming>SequenceFlow_15</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_16</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

     <!-- Ring Buzzer -->
    <bpmn:task id="Task_EmployeeRingBuzzer" name="Sets off Guest's Buzzer">
      <bpmn:incoming>SequenceFlow_16</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_20</bpmn:outgoing>
    </bpmn:task>

     <!-- Event Based Gateway for Guest Reaction -->
    <bpmn:eventBasedGateway id="Event_GuestReaction">
      <bpmn:incoming>SequenceFlow_20</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_17</bpmn:outgoing> <!-- Path 1: Guest Appears -->
       <bpmn:outgoing>SequenceFlow_18</bpmn:outgoing> <!-- Path 2: Timeout (5 mins) -->
    </bpmn:eventBasedGateway>

     <!-- Wait for Guest to appear at hatch -->
    <bpmn:intermediateCatchEvent id="Intermediate_EmpWaitGuestAppears" name="Guest Appears">
      <bpmn:messageEventDefinition/>
       <bpmn:incoming>SequenceFlow_17</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_23</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

     <!-- Hand over meal -->
    <bpmn:task id="Task_EmployeeHandMeal" name="Hands Over Meal">
      <bpmn:incoming>SequenceFlow_23</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_24</bpmn:outgoing>
    </bpmn:task>

     <!-- End Event -->
    <bpmn:endEvent id="End_EmployeeOrderProcessed" name="Order Processed">
      <bpmn:incoming>SequenceFlow_24</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Retry Logic Path (Timer) -->
     <bpmn:intermediateCatchEvent id="Intermediate_EmpWait5Min" name="After 5 Minutes">
      <bpmn:timerEventDefinition/>
       <bpmn:incoming>SequenceFlow_18</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_21</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

     <!-- Call Guest -->
    <bpmn:task id="Task_EmployeeCallGuest" name="Calls for Guest">
      <bpmn:incoming>SequenceFlow_21</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_20</bpmn:outgoing>
    </bpmn:task>

     <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="StartEvent_EmpOrderReceived" targetRef="Task_EmployeeEnterPOS"/>
    <bpmn:sequenceFlow id="SequenceFlow_11" sourceRef="Task_EmployeeEnterPOS" targetRef="Task_EmployeeCollectMoney"/>
     <bpmn:sequenceFlow id="SequenceFlow_12" sourceRef="Task_EmployeeCollectMoney" targetRef="Task_EmployeeSetBuzzer"/>
    <bpmn:sequenceFlow id="SequenceFlow_13" sourceRef="Task_EmployeeSetBuzzer" targetRef="Task_EmployeeHandBuzzer"/>
     <bpmn:sequenceFlow id="SequenceFlow_14" sourceRef="Task_EmployeeHandBuzzer" targetRef="Task_EmployeeInformChef"/>
    <bpmn:sequenceFlow id="SequenceFlow_15" sourceRef="Task_EmployeeInformChef" targetRef="IntermediateCatch_EmpWaitForMealReady"/>

     <!-- Post Meal Ready Logic -->
    <bpmn:sequenceFlow id="SequenceFlow_16" sourceRef="IntermediateCatch_EmpWaitForMealReady" targetRef="Task_EmployeeRingBuzzer"/>
    <bpmn:sequenceFlow id="SequenceFlow_20" sourceRef="Task_EmployeeRingBuzzer" targetRef="Event_GuestReaction"/>

     <!-- Guest Appears Path -->
    <bpmn:sequenceFlow id="SequenceFlow_17" name="Guest appears at hatch" sourceRef="Event_GuestReaction" targetRef="Intermediate_EmpWaitGuestAppears"/>
    <bpmn:sequenceFlow id="SequenceFlow_23" sourceRef="Intermediate_EmpWaitGuestAppears" targetRef="Task_EmployeeHandMeal"/>

     <!-- Retry Path -->
    <bpmn:sequenceFlow id="SequenceFlow_18" name="5 minutes passed" sourceRef="Event_GuestReaction" targetRef="Intermediate_EmpWait5Min"/>
    <bpmn:sequenceFlow id="SequenceFlow_21" sourceRef="Intermediate_EmpWait5Min" targetRef="Task_EmployeeCallGuest"/>

     <!-- End Path -->
    <bpmn:sequenceFlow id="SequenceFlow_24" sourceRef="Task_EmployeeHandMeal" targetRef="End_EmployeeOrderProcessed"/>

  </bpmn:process>

  <!-- Chef Process -->
  <bpmn:process id="Process_Chef">
     <bpmn:startEvent id="StartEvent_ChefMealNeeded" name="Meal Needed">
      <bpmn:messageEventDefinition/>
       <bpmn:outgoing>SequenceFlow_30</bpmn:outgoing>
    </bpmn:startEvent>

     <!-- Prepare Meal -->
    <bpmn:task id="Task_ChefPrepareMeal" name="Prepares Meal">
      <bpmn:incoming>SequenceFlow_30</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_31</bpmn:outgoing>
    </bpmn:task>

     <!-- Place in Hatch -->
    <bpmn:task id="Task_ChefPlaceInHatch" name="Places Meal in Service Hatch">
      <bpmn:incoming>SequenceFlow_31</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_32</bpmn:outgoing>
    </bpmn:task>

     <!-- Inform Employee -->
    <bpmn:task id="Task_ChefInformEmployee" name="Informs Employee">
      <bpmn:incoming>SequenceFlow_32</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_33</bpmn:outgoing>
    </bpmn:task>

     <!-- End Event -->
    <bpmn:endEvent id="End_ChefMealPrepared" name="Meal Prepared">
      <bpmn:incoming>SequenceFlow_33</bpmn:incoming>
    </bpmn:endEvent>

     <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_30" sourceRef="StartEvent_ChefMealNeeded" targetRef="Task_ChefPrepareMeal"/>
    <bpmn:sequenceFlow id="SequenceFlow_31" sourceRef="Task_ChefPrepareMeal" targetRef="Task_ChefPlaceInHatch"/>
     <bpmn:sequenceFlow id="SequenceFlow_32" sourceRef="Task_ChefPlaceInHatch" targetRef="Task_ChefInformEmployee"/>
    <bpmn:sequenceFlow id="SequenceFlow_33" sourceRef="Task_ChefInformEmployee" targetRef="End_ChefMealPrepared"/>

  </bpmn:process>

</bpmn:definitions>