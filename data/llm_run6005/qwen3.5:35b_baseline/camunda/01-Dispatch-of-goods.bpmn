<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_ShippingProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_0a1b2c3d">
    <bpmn:participant id="Participant_HardwareCompany" name="Hardware Company Shipping Process" processRef="Process_ShippingFlow" />
  </bpmn:collaboration>

  <bpmn:process id="Process_ShippingFlow" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane name="Secretary" id="Lane_Secretary">
        <bpmn:flowNodeRef>Task_ClariyMethod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_LargeAmount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GetOffers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectCompany</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WriteLabel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_InsuranceCheck</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane name="Warehousemen" id="Lane_Warehouse">
        <bpmn:flowNodeRef>Task_PackageGoods</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PreparePickup</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane name="Logistics Dept Head" id="Lane_Logistics">
        <bpmn:flowNodeRef>Task_InsureParcel</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="Start_ShipGoods" name="Ship Goods">
      <bpmn:outgoing>Seq_StartToClarify</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Clarify Shipment Method (Secretary) -->
    <bpmn:task id="Task_ClariyMethod" name="Clarify shipment method">
      <bpmn:incoming>Seq_StartToClarify</bpmn:outgoing></bpmn:incoming>
       <bpmn:outgoing>Seq_ClarifyToParallelSplit</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway (Start of Concurrency) -->
    <bpmn:parallelGateway id="GW_ParallelSplit" name="Concurrent Processing">
      <bpmn:incoming>Seq_ClarifyToParallelSplit</bpmn:outgoing></bpmn:incoming>
       <bpmn:outgoing>Seq_WarehousePackage</bpmn:outgoing>
      <bpmn:outgoing>Seq_SecurtyDecisionLogic</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Parallel Path 1: Warehouse -->
    <bpmn:task id="Task_PackageGoods" name="Package goods">
      <bpmn:incoming>Seq_WarehousePackage</bpmn:outgoing></bpmn:incoming>
       <bpmn:outgoing>Seq_PackToMerge1</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Path 2: Secretary Decision Logic -->
    <bpmn:exclusiveGateway id="Gateway_LargeAmount" name="Large Amount?">
      <bpmn:incoming>Seq_SecurtyDecisionLogic</bpmn:outgoing></bpmn:incoming>
       <bpmn:outgoing>Seq_LargePathYes</bpmn:outgoing>
      <bpmn:outgoing>Seq_SmallPathNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Large Amount Path -->
    <bpmn:task id="Task_GetOffers" name="Get 3 offers from logistic companies">
      <bpmn:incoming>Seq_LargePathYes</bpmn:outgoing></bpmn:incoming>
       <bpmn:outgoing>Seq_OfferToSelect</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Select Company -->
    <bpmn:task id="Task_SelectCompany" name="Select logistic company and place order">
      <bpmn:incoming>Seq_OfferToSelect</bpmn:outgoing></bpmn:incoming>
       <bpmn:outgoing>Seq_SelectToMerge1</bpmn:outgoing>
    </bpmn:task>

    <!-- Small Amount Path -->
    <bpmn:task id="Task_WriteLabel" name="Write package label">
      <bpmn:incoming>Seq_SmallPathNo</bpmn:outgoing></bpmn:incoming>
       <bpmn:outgoing>Seq_LabelToInsuranceCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Insurance Check -->
    <bpmn:exclusiveGateway id="Gateway_InsuranceCheck" name="Insure Parcel?">
      <bpmn:incoming>Seq_LabelToInsuranceCheck</bpmn:outgoing></bpmn:incoming>
       <bpmn:outgoing>Seq_YesInsure</bpmn:outgoing>
      <bpmn:outgoing>Seq_NoSkip</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Insurance Task -->
    <bpmn:task id="Task_InsureParcel" name="Take parcel insurance">
      <bpmn:incoming>Seq_YesInsure</bpmn:outgoing></bpmn:incoming>
       <bpmn:outgoing>Seq_InsuranceToMerge2</bpmn:outgoing>
    </bpmn:task>

    <!-- Merge Point -->
    <bpmn:parallelGateway id="GW_MergeAll" name="Everything Ready?">
      <bpmn:incoming>Seq_PackToMerge1</bpmn:outgoing></bpmn:incoming>
       <bpmn:incoming>Seq_SelectToMerge1</bpmn:outgoing></bpmn:incoming>
       <bpmn:incoming>Seq_InsuranceToMerge2</bpmn:outgoing></bpmn:incoming>
      <bpmn:incoming>Seq_NoSkip</bpmn:outgoing></bpmn:incoming>
       <bpmn:outgoing>Seq_FinalToPrepare</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- End Event -->
    <bpmn:endEvent id="End_ShipmentPrepared" name="Shipment Prepared">
      <bpmn:incoming>Seq_PrepToEndEvent</bpmn:outgoing></bpmn:incoming>
    </bpmn:endEvent>

    <!-- Final Task -->
    <bpmn:task id="Task_PreparePickup" name="Prepare for picking up goods">
      <bpmn:incoming>Seq_FinalToPrepare</bpmn:outgoing></bpmn:incoming>
       <bpmn:outgoing>Seq_PrepToEndEvent</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flows -->
    
    <bpmn:sequenceFlow id="Seq_StartToClarify" sourceRef="Start_ShipGoods" targetRef="Task_ClariyMethod">
      <bpmn:name>Ship Goods</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Seq_ClarifyToParallelSplit" sourceRef="Task_ClariyMethod" targetRef="GW_ParallelSplit">
      <bpmn:name>Clarified</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Seq_WarehousePackage" sourceRef="GW_ParallelSplit" targetRef="Task_PackageGoods">
      <bpmn:name>In the meantime</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Seq_SecurtyDecisionLogic" sourceRef="GW_ParallelSplit" targetRef="Gateway_LargeAmount">
      <bpmn:name>Check Amount</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Seq_LargePathYes" sourceRef="Gateway_LargeAmount" targetRef="Task_GetOffers">
      <bpmn:name>Large Amount (yes)</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Seq_SmallPathNo" sourceRef="Gateway_LargeAmount" targetRef="Task_WriteLabel">
      <bpmn:name>Small Amount (no)</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Seq_OfferToSelect" sourceRef="Task_GetOffers" targetRef="Task_SelectCompany">
      <bpmn:name>Select Company</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Seq_LabelToInsuranceCheck" sourceRef="Task_WriteLabel" targetRef="Gateway_InsuranceCheck">
      <bpmn:name>Write Label</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Seq_YesInsure" sourceRef="Gateway_InsuranceCheck" targetRef="Task_InsureParcel">
      <bpmn:name>Necessary (yes)</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Seq_NoSkip" sourceRef="Gateway_InsuranceCheck" targetRef="GW_MergeAll">
      <bpmn:name>Necessary (no)</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Seq_PackToMerge1" sourceRef="Task_PackageGoods" targetRef="GW_MergeAll">
      <bpmn:name>Packed</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Seq_SelectToMerge1" sourceRef="Task_SelectCompany" targetRef="GW_MergeAll">
      <bpmn:name>Order Placed</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Seq_InsuranceToMerge2" sourceRef="Task_InsureParcel" targetRef="GW_MergeAll">
      <bpmn:name>Insured</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Seq_FinalToPrepare" sourceRef="GW_MergeAll" targetRef="Task_PreparePickup">
      <bpmn:name>All Ready</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Seq_PrepToEndEvent" sourceRef="Task_PreparePickup" targetRef="End_ShipmentPrepared">
      <bpmn:name>Pick Up Ready</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>