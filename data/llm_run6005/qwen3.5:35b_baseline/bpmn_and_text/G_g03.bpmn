<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_BlizzardCharacterGenerator" targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:collaboration id="Collab_CharacterCreation">
    <bpmn:participant name="Blizzard Online Character Generator Process" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:message id="Message_FutureExpansionNotification" name="Expansion Released Notification"/>

  <bpmn:process id="Process_1" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="Start_Event_CharacterCreation" name="Character Creation Started">
      <bpmn:outgoing>SequenceFlow_Start_Parallel</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Parallel Gateway to split account setup and character selection -->
    <bpmn:parallelGateway id="Parallel_Gateway_AccountCharacter" name="Start Account &amp; Character Setup">
      <bpmn:incoming>SequenceFlow_Start_Parallel</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckBattleNet</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SelectCharacterDetails</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Account Setup Branch -->
    
    <!-- Check Battle.net account -->
    <bpmn:exclusiveGateway id="Exclusive_Gateway_BattleNet" name="Has battle.net account?">
      <bpmn:incoming>SequenceFlow_CheckBattleNet</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_HasAccount_LogIn</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoAccount_Create</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Create new account -->
    <bpmn:task id="Task_EnterAccountInfo" name="Enter Account Information">
      <bpmn:incoming>SequenceFlow_NoAccount_Create</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConfirmLink_Clicked</bpmn:outgoing>
    </bpmn:task>

    <!-- Click confirmation link -->
    <bpmn:task id="Task_ConfirmationLink" name="Click Confirmation Link from Email">
      <bpmn:incoming>SequenceFlow_ConfirmLink_Clicked</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckSubscription</bpmn:outgoing>
    </bpmn:task>

    <!-- Log in if already has account -->
    <bpmn:task id="Task_LogIn" name="Log into Game">
      <bpmn:incoming>SequenceFlow_HasAccount_LogIn</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckSubscription</bpmn:outgoing>
    </bpmn:task>

    <!-- Check subscription -->
    <bpmn:exclusiveGateway id="Exclusive_Gateway_Subscription" name="Has active WoW subscription?">
      <bpmn:incoming>SequenceFlow_ConfirmLink_Clicked</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_HasSub_LogIn</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoSub_PaymentMethod</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Has subscription - proceed to character creation -->
    <bpmn:task id="Task_LogIn_HasSubscription" name="Log into Game">
      <bpmn:incoming>SequenceFlow_HasSub_LogIn</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SelectRealmRaceClass</bpmn:outgoing>
    </bpmn:task>

    <!-- No subscription - select payment method -->
    <bpmn:exclusiveGateway id="Exclusive_Gateway_PaymentMethod" name="Select Payment Method">
      <bpmn:incoming>SequenceFlow_NoSub_PaymentMethod</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CreditCard_Info</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_BankAccount_Info</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Credit card payment -->
    <bpmn:task id="Task_EnterCreditCard" name="Enter Credit Card Information">
      <bpmn:incoming>SequenceFlow_CreditCard_Info</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PaymentComplete_LogIn</bpmn:outgoing>
    </bpmn:task>

    <!-- Bank account payment -->
    <bpmn:task id="Task_EnterBankInfo" name="Enter IBAN and BIC Numbers">
      <bpmn:incoming>SequenceFlow_BankAccount_Info</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PaymentComplete_LogIn2</bpmn:outgoing>
    </bpmn:task>

    <!-- Payment complete - log in -->
    <bpmn:task id="Task_LogIn_AfterPayment" name="Log into Game">
      <bpmn:incoming>SequenceFlow_PaymentComplete_LogIn</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SelectRealmRaceClass2</bpmn:outgoing>
    </bpmn:task>

    <!-- Character Selection Branch -->
    
    <!-- Select realm, race, class -->
    <bpmn:exclusiveGateway id="Exclusive_Gateway_CharacterDetails" name="Select Realm, Race &amp; Class">
      <bpmn:incoming>SequenceFlow_SelectRealmRaceClass</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EnterNames_Start</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Enter character names -->
    <bpmn:task id="Task_EnterCharacterName" name="Enter Character Name">
      <bpmn:incoming>SequenceFlow_EnterNames_Start</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NameAvailable_Check</bpmn:outgoing>
    </bpmn:task>

    <!-- Check if name available -->
    <bpmn:exclusiveGateway id="Exclusive_Gateway_NameAvailability" name="Name Available?">
      <bpmn:incoming>SequenceFlow_NameAvailable_Check</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Yes_Confirmation</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_No_EnterAnotherName</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Enter another name if not available -->
    <bpmn:task id="Task_EnterAnotherName" name="Enter Another Name">
      <bpmn:incoming>SequenceFlow_No_EnterAnotherName</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NameAvailable_Check2</bpmn:outgoing>
    </bpmn:task>

    <!-- Confirmation received -->
    <bpmn:endEvent id="End_Event_Confirmation" name="Character Created - Get Selfies">
      <bpmn:incoming>SequenceFlow_Yes_Confirmation</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>

  <!-- Sequence Flows -->
  
  <bpmn:sequenceFlow id="SequenceFlow_Start_Parallel" sourceRef="Start_Event_CharacterCreation" targetRef="Parallel_Gateway_AccountCharacter">
    <bpmn:name>New Character Creation</bpmn:name>
  </bpmn:sequenceFlow>

  <!-- Account Setup Flows -->
  
  <bpmn:sequenceFlow id="SequenceFlow_CheckBattleNet" sourceRef="Parallel_Gateway_AccountCharacter" targetRef="Exclusive_Gateway_BattleNet">
    <bpmn:name>Check Battle.net</bpmn:name>
  </bpmn:sequenceFlow>

  <bpmn:sequenceFlow id="SequenceFlow_NoAccount_Create" name="No - Create Account" sourceRef="Exclusive_Gateway_BattleNet" targetRef="Task_EnterAccountInfo">
    <bpmn:name>No</bpmn:name>
  </bpmn:sequenceFlow>

  <bpmn:sequenceFlow id="SequenceFlow_HasAccount_LogIn" name="Yes - Log In" sourceRef="Exclusive_Gateway_BattleNet" targetRef="Task_LogIn">
    <bpmn:name>Yes</bpmn:name>
  </bpmn:sequenceFlow>

  <bpmn:sequenceFlow id="SequenceFlow_ConfirmLink_Clicked" name="Confirmation Link Clicked" sourceRef="Task_EnterAccountInfo" targetRef="Exclusive_Gateway_Subscription">
    <bpmn:name>Email Confirmation</bpmn:name>
  </bpmn:sequenceFlow>

  <!-- Payment Method Flows -->
  
  <bpmn:sequenceFlow id="SequenceFlow_HasSub_LogIn" name="Yes - Has Subscription" sourceRef="Exclusive_Gateway_Subscription" targetRef="Task_LogIn_HasSubscription">
    <bpmn:name>Has Active Sub</bpmn:name>
  </bpmn:sequenceFlow>

  <bpmn:sequenceFlow id="SequenceFlow_NoSub_PaymentMethod" name="No - Select Payment Method" sourceRef="Exclusive_Gateway_Subscription" targetRef="Exclusive_Gateway_PaymentMethod">
    <bpmn:name>No Active Sub</bpmn:name>
  </bpmn:sequenceFlow>

  <!-- Credit Card Path -->
  
  <bpmn:sequenceFlow id="SequenceFlow_CreditCard_Info" name="Credit Card Selected" sourceRef="Exclusive_Gateway_PaymentMethod" targetRef="Task_EnterCreditCard">
    <bpmn:name>Credit Card</bpmn:name>
  </bpmn:sequenceFlow>

  <!-- Bank Account Path -->
  
  <bpmn:sequenceFlow id="SequenceFlow_BankAccount_Info" name="Bank Account Selected" sourceRef="Exclusive_Gateway_PaymentMethod" targetRef="Task_EnterBankInfo">
    <bpmn:name>Bank Account</bpmn:name>
  </bpmn:sequenceFlow>

  <!-- Payment Complete Flows -->
  
  <bpmn:sequenceFlow id="SequenceFlow_PaymentComplete_LogIn" name="Payment Completed - Log In" sourceRef="Task_EnterCreditCard" targetRef="Task_LogIn_AfterPayment">
    <bpmn:name>Credit Card Paid</bpmn:name>
  </bpmn:sequenceFlow>

  <bpmn:sequenceFlow id="SequenceFlow_PaymentComplete_LogIn2" name="Bank Payment Completed - Log In" sourceRef="Task_EnterBankInfo" targetRef="Task_LogIn_AfterPayment">
    <bpmn:name>Bank Account Paid</bpmn:name>
  </bpmn:sequenceFlow>

  <!-- Character Selection Flows -->
  
  <bpmn:sequenceFlow id="SequenceFlow_SelectRealmRaceClass" name="Select Realm, Race &amp; Class" sourceRef="Task_LogIn_HasSubscription" targetRef="Exclusive_Gateway_CharacterDetails">
    <bpmn:name>Character Setup</bpmn:name>
  </bpmn:sequenceFlow>

  <bpmn:sequenceFlow id="SequenceFlow_EnterNames_Start" name="Enter Character Names" sourceRef="Exclusive_Gateway_CharacterDetails" targetRef="Task_EnterCharacterName">
    <bpmn:name>Select Details</bpmn:name>
  </bpmn:sequenceFlow>

  <!-- Name Availability Flows -->
  
  <bpmn:sequenceFlow id="SequenceFlow_NameAvailable_Check" name="Check Name Available" sourceRef="Task_EnterCharacterName" targetRef="Exclusive_Gateway_NameAvailability">
    <bpmn:name>Name Submitted</bpmn:name>
  </bpmn:sequenceFlow>

  <bpmn:sequenceFlow id="SequenceFlow_Yes_Confirmation" name="Yes - Name Available" sourceRef="Exclusive_Gateway_NameAvailability" targetRef="End_Event_Confirmation">
    <bpmn:name>Name Accepted</bpmn:name>
  </bpmn:sequenceFlow>

  <bpmn:sequenceFlow id="SequenceFlow_No_EnterAnotherName" name="No - Enter Another Name" sourceRef="Exclusive_Gateway_NameAvailability" targetRef="Task_EnterAnotherName">
    <bpmn:name>Name Taken</bpmn:name>
  </bpmn:sequenceFlow>

  <!-- Loop back for another name -->
  
  <bpmn:sequenceFlow id="SequenceFlow_NameAvailable_Check2" sourceRef="Task_EnterAnotherName" targetRef="Exclusive_Gateway_NameAvailability">
    <bpmn:name>Check Another Name</bpmn:name>
  </bpmn:sequenceFlow>

  <!-- Character Creation Branch from Parallel Gateway -->
  
  <bpmn:sequenceFlow id="SequenceFlow_SelectCharacterDetails" sourceRef="Parallel_Gateway_AccountCharacter" targetRef="Exclusive_Gateway_CharacterDetails">
    <bpmn:name>Select Realm, Race &amp; Class</bpmn:name>
  </bpmn:sequenceFlow>

  <!-- Character Setup from Payment -->
  
  <bpmn:sequenceFlow id="SequenceFlow_SelectRealmRaceClass2" sourceRef="Task_LogIn_AfterPayment" targetRef="Exclusive_Gateway_CharacterDetails">
    <bpmn:name>Select Details After Login</bpmn:name>
  </bpmn:sequenceFlow>

</bpmn:definitions>