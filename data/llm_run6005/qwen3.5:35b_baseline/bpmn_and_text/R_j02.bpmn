<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_InspectionProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_MachineInspection">
    <bpmn:participant id="Participant_InspectionApp" name="Energy Drink Machine Inspection App" processRef="Proc_InspectionFlow"/>
  </bpmn:collaboration>

  <bpmn:process id="Proc_InspectionFlow" isExecutable="false">
    <bpmn:laneSet id="LaneSet_MachineOps">
      <bpmn:lane id="Lane_Operator" name="Machine Inspector">
        <bpmn:flowNodeRef>StartEvent_MachineDetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_QuestionsInput</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_DisplayResults</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_CheckAdditionalQuestions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AdditionalQs</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="System Interface">
        <bpmn:flowNodeRef>ServiceTask_AutoCollectData</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_MachineDetails" name="Machine Details Entered">
      <bpmn:outgoing>SequenceFlow_EnterInfo</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Enter Info (Context) -->
    <bpmn:userTask id="Task_EnterInfo" name="Enter Machine Type &amp; Serial Number">
      <bpmn:incoming>SequenceFlow_EnterInfo</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StartInspection</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task 2: Standard Questions -->
    <bpmn:userTask id="Task_QuestionsInput" name="Ask Questions &amp; Input Values">
      <bpmn:incoming>SequenceFlow_StartInspection</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InitiateCollection</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Service Task 3: Auto Collect -->
    <bpmn:serviceTask id="ServiceTask_AutoCollectData" name="Press Buttons &amp; Collect Data">
      <bpmn:incoming>SequenceFlow_InitiateCollection</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ShowResults</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Task 4: Display Results -->
    <bpmn:userTask id="UserTask_DisplayResults" name="Show Collected Values to Operator">
      <bpmn:incoming>SequenceFlow_ShowResults</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckDecision</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway -->
    <bpmn:exclusiveGateway id="Gw_CheckAdditionalQuestions" name="Need Additional Questions?">
      <bpmn:incoming>SequenceFlow_CheckDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AdditionalYes</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_AdditionalNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 5: Additional Questions (Conditional) -->
    <bpmn:userTask id="Task_AdditionalQs" name="Ask Additional Questions">
      <bpmn:incoming>SequenceFlow_AdditionalYes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FinishInspection</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Complete" name="Inspection Complete">
      <bpmn:incoming>SequenceFlow_AdditionalNo</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_FinishInspection</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_EnterInfo" sourceRef="StartEvent_MachineDetails" targetRef="Task_EnterInfo"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_StartInspection" name="Begin Inspection" sourceRef="Task_EnterInfo" targetRef="Task_QuestionsInput"/>

    <bpmn:sequenceFlow id="SequenceFlow_InitiateCollection" sourceRef="Task_QuestionsInput" targetRef="ServiceTask_AutoCollectData"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ShowResults" name="Display Results" sourceRef="ServiceTask_AutoCollectData" targetRef="UserTask_DisplayResults"/>

    <bpmn:sequenceFlow id="SequenceFlow_CheckDecision" sourceRef="UserTask_DisplayResults" targetRef="Gw_CheckAdditionalQuestions"/>

    <bpmn:sequenceFlow id="SequenceFlow_AdditionalYes" name="Yes - Additional Needed" sourceRef="Gw_CheckAdditionalQuestions" targetRef="Task_AdditionalQs">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${needMoreCheck}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_AdditionalNo" name="No - Complete Inspection" sourceRef="Gw_CheckAdditionalQuestions" targetRef="EndEvent_Complete">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!needMoreCheck}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_FinishInspection" sourceRef="Task_AdditionalQs" targetRef="EndEvent_Complete"/>

  </bpmn:process>
</bpmn:definitions>