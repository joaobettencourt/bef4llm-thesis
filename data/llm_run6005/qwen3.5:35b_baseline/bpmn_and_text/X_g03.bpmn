<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ViennaNightRun">
  <bpmn:collaboration id="Collab_NightRunApp">
    <bpmn:participant name="Vienna Night Run App Process" processRef="Process_ViennaNightRun"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_ViennaNightRun" isExecutable="false">
    
    <!-- Lane Set -->
    <bpmn:laneSet id="Lane_Set_Process">
      <bpmn:lane id="Lane_User" name="Runner (User)">
        <bpmn:flowNodeRef>Task_SelectBlock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_CheckPerformance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GetNumber</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_TransportDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GoHome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LeaveWork</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Fitness Gadgets / System">
        <bpmn:flowNodeRef>StartEvent_Participate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RunMeasureTime</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TrainCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RaceRunDrink</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_FinalTime</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Participate" name="Participate in Vienna Night Run">
      <bpmn:outgoing>SequenceFlow_SelectBlock</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Select Starting Block -->
    <bpmn:task id="Task_SelectBlock" name="Select Starting Block">
      <bpmn:incoming>SequenceFlow_SelectBlock</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RunMeasureTime</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Run and Measure Time -->
    <bpmn:task id="Task_RunMeasureTime" name="Run 5km &amp; Measure Time">
      <bpmn:incoming>SequenceFlow_RunMeasureTime</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckPerformance</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Check Performance (< 25 min) -->
    <bpmn:exclusiveGateway id="Gw_CheckPerformance" name="Time &lt; 25 mins?">
      <bpmn:incoming>SequenceFlow_CheckPerformance</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GoToNumber</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_TrainLoop</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Get Starting Number -->
    <bpmn:task id="Task_GetNumber" name="Get Starting Number">
      <bpmn:incoming>SequenceFlow_GoToNumber</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TransportDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Transport Decision (> 1 hour left?) -->
    <bpmn:exclusiveGateway id="Gw_TransportDecision" name="Time Left &gt; 1h?">
      <bpmn:incoming>SequenceFlow_TransportDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GoHomePath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_LeaveWorkPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Go From Home -->
    <bpmn:task id="Task_GoHome" name="Go from Home">
      <bpmn:incoming>SequenceFlow_GoHomePath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RaceStartMerge</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Leave Directly from Work -->
    <bpmn:task id="Task_LeaveWork" name="Leave directly from work">
      <bpmn:incoming>SequenceFlow_LeaveWorkPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RaceStartMerge2</bpmn:outgoing>
    </bpmn:task>

    <!-- Merge Gateway for Transport Paths -->
    <bpmn:exclusiveGateway id="Gw_MergeTransport" name="Merge Transport">
      <bpmn:incoming>SequenceFlow_RaceStartMerge</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_RaceStartMerge2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RaceRunDrink</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Run Night Run (Drink) -->
    <bpmn:task id="Task_RaceRunDrink" name="Run &amp; Drink at Race">
      <bpmn:incoming>SequenceFlow_RaceRunDrink</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FinalTime</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Train and Check (Loop) -->
    <bpmn:task id="Task_TrainCheck" name="Train &amp; Re-check Goal">
      <bpmn:incoming>SequenceFlow_TrainLoop</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RunMeasureTime2</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_FinalTime" name="Receive Final Running Time">
      <bpmn:incoming>SequenceFlow_FinalTime</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    
    <!-- Start to Select Block -->
    <bpmn:sequenceFlow id="SequenceFlow_SelectBlock" sourceRef="StartEvent_Participate" targetRef="Task_SelectBlock"/>

    <!-- Select Block to Run/Measure -->
    <bpmn:sequenceFlow id="SequenceFlow_RunMeasureTime" name="Run 5km Start" sourceRef="Task_SelectBlock" targetRef="Task_RunMeasureTime"/>

    <!-- Run/Measure to Check Gateway -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckPerformance" name="Time Measured" sourceRef="Task_RunMeasureTime" targetRef="Gw_CheckPerformance"/>

    <!-- Check Yes (Goal Achieved) -> Get Number -->
    <bpmn:sequenceFlow id="SequenceFlow_GoToNumber" name="Yes (&lt; 25 min)" sourceRef="Gw_CheckPerformance" targetRef="Task_GetNumber"/>

    <!-- Check No (Train) -> Train Task -->
    <bpmn:sequenceFlow id="SequenceFlow_TrainLoop" name="No (&gt; 25 min)" sourceRef="Gw_CheckPerformance" targetRef="Task_TrainCheck"/>

    <!-- Get Number to Transport Decision -->
    <bpmn:sequenceFlow id="SequenceFlow_TransportDecision" name="Get Ready for Race" sourceRef="Task_GetNumber" targetRef="Gw_TransportDecision"/>

    <!-- Transport Yes (Home) -->
    <bpmn:sequenceFlow id="SequenceFlow_GoHomePath" name="Yes (&gt; 1h)" sourceRef="Gw_TransportDecision" targetRef="Task_GoHome"/>

    <!-- Transport No (Work) -->
    <bpmn:sequenceFlow id="SequenceFlow_LeaveWorkPath" name="No (&lt;= 1h)" sourceRef="Gw_TransportDecision" targetRef="Task_LeaveWork"/>

    <!-- From Home to Merge Gateway -->
    <bpmn:sequenceFlow id="SequenceFlow_RaceStartMerge" name="From Home" sourceRef="Task_GoHome" targetRef="Gw_MergeTransport"/>

    <!-- From Work to Merge Gateway -->
    <bpmn:sequenceFlow id="SequenceFlow_RaceStartMerge2" name="From Work" sourceRef="Task_LeaveWork" targetRef="Gw_MergeTransport"/>

    <!-- Train Loop back to Run/Measure -->
    <bpmn:sequenceFlow id="SequenceFlow_RunMeasureTime2" name="Re-check Goal" sourceRef="Task_TrainCheck" targetRef="Task_RunMeasureTime"/>

    <!-- Merge Gateway to Race Task -->
    <bpmn:sequenceFlow id="SequenceFlow_RaceRunDrink" name="Start Race" sourceRef="Gw_MergeTransport" targetRef="Task_RaceRunDrink"/>

    <!-- Race Run Drink to Final Time End Event -->
    <bpmn:sequenceFlow id="SequenceFlow_FinalTime" name="Race Completed" sourceRef="Task_RaceRunDrink" targetRef="EndEvent_FinalTime"/>

  </bpmn:process>
</bpmn:definitions>