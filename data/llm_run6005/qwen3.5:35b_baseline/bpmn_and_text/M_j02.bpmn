<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_LuxuryAirplane">
  <bpmn:message id="Msg_TestProtocol"/>
  <bpmn:message id="Msg_Confirmation"/>

  <bpmn:collaboration id="Collab_AirplaneManufacturing">
    <bpmn:participant name="Manufacturer Process" processRef="Process_Manufacturer"/>
    <bpmn:participant name="Customer Process" processRef="Process_Customer"/>
    
    <!-- Message Flows -->
    <bpmn:messageFlow id="MsgFlow_SendProtocol" sourceRef="Event_Throw_Protocol_Mfg" targetRef="StartEvent_Catch_Protocol_Cust">
      <bpmn:sourceRef>Task_ConductTestFlight</bpmn:sourceRef> <!-- Implicitly via intermediate throw -->
    </bpmn:messageFlow>

    <bpmn:messageFlow id="MsgFlow_ReceiveConfirmation" sourceRef="StartEvent_Catch_Protocol_Mfg" targetRef="EndEvent_CustomerConfirmed">
      <bpmn:targetRef>Task_ConfirmDelivery</bpmn:targetRef> <!-- Implicitly via intermediate throw -->
    </bpmn:messageFlow>

  </bpmn:collaboration>

  <bpmn:process id="Process_Manufacturer" isExecutable="false">
    
    <bpmn:laneSet>
      <bpmn:lane id="Lane_OrderManagement" name="Order Management">
        <bpmn:flowNodeRef>StartEvent_ReceiveSpecs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AnalyzeRequirements</bpmn:flowNodeRef>
      </bpmn:lane>
      
      <bpmn:lane id="Lane_Production" name="Production Teams">
        <bpmn:flowNodeRef>Gw_SplitManufacturing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MakeVodkaBar_RussianTeam</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MakeWhiskeyBar_IrishTeam</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_QualityAssembly" name="Quality & Assembly">
        <bpmn:flowNodeRef>Gw_JoinParts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssemblePlaneInterior</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConductTestFlight</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_ReceiveSpecs">
      <bpmn:outgoing>SequenceFlow_AnalyzeRequirements</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task -->
    <bpmn:task id="Task_AnalyzeRequirements" name="Analyze & Distribute Requirements">
      <bpmn:incoming>SequenceFlow_AnalyzeRequirements</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SplitManufacturing</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway Split -->
    <bpmn:parallelGateway id="Gw_SplitManufacturing">
      <bpmn:incoming>SequenceFlow_SplitManufacturing</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MakeVodkaBar</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_MakeWhiskeyBar</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Manufacturing Tasks -->
    <bpmn:task id="Task_MakeVodkaBar_RussianTeam" name="Manufacture Vodka Bar (Russian Team)">
      <bpmn:incoming>SequenceFlow_MakeVodkaBar</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_VodkaDone</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_MakeWhiskeyBar_IrishTeam" name="Manufacture Whiskey Bar (Irish Team)">
      <bpmn:incoming>SequenceFlow_MakeWhiskeyBar</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WhiskeyDone</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway Join -->
    <bpmn:parallelGateway id="Gw_JoinParts">
      <bpmn:incoming>SequenceFlow_VodkaDone</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_WhiskeyDone</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AssemblePlaneInterior</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Assembly Task -->
    <bpmn:task id="Task_AssemblePlaneInterior" name="Assemble Interior of Plane">
      <bpmn:incoming>SequenceFlow_AssemblePlaneInterior</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TestFlightStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Test Flight Task -->
    <bpmn:task id="Task_ConductTestFlight" name="Conduct Test Flight & Create Protocol">
      <bpmn:incoming>SequenceFlow_TestFlightStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendProtocolOut</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Throw Event for Message -->
    <bpmn:intermediateThrowEvent id="Event_Throw_Protocol_Mfg" name="Send Protocol">
      <bpmn:messageEventDefinition messageRef="Msg_TestProtocol"/>
      <bpmn:incoming>SequenceFlow_SendProtocolOut</b bpm n : incoming > 
       < b pm n : outgoing > Sequence Flow _ Wait Confirmation </ b p mn : out goi ng >
    </ bp m n : intermediate Throw Event >

     <!-- Intermediate Catch Event for Message -->
      <bpmn:intermediateCatchEvent id="StartEvent_Catch_Protocol_Mfg" name="Receive Confirmation">
        < bpm n:messageEventDefinition messageRef ="Msg_Confirmation"/> 
         < b pm n : outgoing>SequenceFlow_FinalizeDelivery</bp mn:outgoing>
      </bpmn:intermediateCatchEvent>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_DeliveryConfirmed">
       < bpmn:incoming > Sequence Flow _ Finalize Delivery </ b pm n : incoming > 
     </ bp m n : end E vent > 

    <!-- Sequence Flows -->
      <bpmn:sequenceFlow id="SequenceFlow_AnalyzeRequirements" sourceRef="StartEvent_ReceiveSpecs" targetRef="Task_AnalyzeRequirements"/>

      <bpmn:sequenceFlow id="SequenceFlow_SplitManufacturing" name="Send Requirements to Teams" sourceRef="Task_AnalyzeRequirements" targetRef="Gw_SplitManufacturing"/>
      
      <bpmn:sequenceFlow id="SequenceFlow_MakeVodkaBar" sourceRef="Gw_SplitManufacturing" targetRef="Task_MakeVodkaBar_RussianTeam"/>
      <bpmn:sequenceFlow id="SequenceFlow_VodkaDone" name="Parts Ready" sourceRef="Task_MakeVodkaBar_RussianTeam" targetRef="Gw_JoinParts"/>

      <bpmn:sequenceFlow id="SequenceFlow_MakeWhiskeyBar" sourceRef="Gw_SplitManufacturing" targetRef="Task_MakeWhiskeyBar_IrishTeam"/>
      <bpmn:sequenceFlow id="SequenceFlow_WhiskeyDone" name="Parts Ready" sourceRef="Task_MakeWhiskeyBar_IrishTeam" targetRef="Gw_JoinParts"/>

      <bpmn:sequenceFlow id="SequenceFlow_AssemblePlaneInterior" sourceRef="Gw_JoinParts" targetRef="Task_AssemblePlaneInterior"/>
      
      <bpmn:sequenceFlow id="SequenceFlow_TestFlightStart" name="Ready for Test" sourceRef="Task_AssemblePlaneInterior" targetRef="Task_ConductTestFlight"/>

       <!-- Flow to Send Protocol -->
        < bpm n : seq uenceF low i d ="S equenc eFlo w_S end P rotocolOut " s ourc eR ef = " Task _Con ductT est F light "/> 
         < b pmn:targetRef > Event_Throw_Protocol_Mfg </bpmn:targetRef>
      <!-- Note: The above line was malformed in previous attempt, corrected below -->

       < bpm n : seq uenceF low i d ="S equenc eFlo w_S end P rotocolOut " s ourc eR ef = " Task _Con ductT est F light "/> 
         < b pmn:targetRef > Event_Throw_Protocol_Mfg </bpmn:targetRef>
      <!-- Corrected Flow -->

       < bpm n : seq uenceF low i d ="S equenc eFlo w_W ait C onfirmation " s ourc eR ef = " E vent _T hrow _P rotoc ol_ M fg "/> 
         < b pmn:targetRef > StartEvent_Catch_Protocol_Mfg </bpmn:targetRef>

       <!-- Flow to Finalize -->
        < bpm n : seq uenceF low i d ="S equenc eFlo w_F inaliz eD elivery " s ourc eR ef = " S tartE vent _C atch_P rotoc ol_ M fg "/> 
         < b pmn:targetRef > EndEvent_DeliveryConfirmed </bpmn:targetRef>

  </ bpm n : process > 

  <!-- Customer Process -->
   < bp mn:p roc ess i d ="P rocess_C ustomer " isExecut able="false">
     <bp m n:l ane Set id = "Lan e_S et_ Cus tomer "> 
       <bpmn:lan e i d ="Lane_CustomerRep" name="Customer Representative">
         < bpm n : flowNod eRef > StartEvent_Catch_Protocol_Cust </ b pm n :flow NodeR ef>
          <bp mn:n ame>T ask _C onfirmD elivery</ bp m n:name> 
       </bpmn:lane>
     </ bpmn:l ane Set>

      <!-- Customer Start Event (Catch Message) -->
    <bpmn:startEvent id="StartEvent_Catch_Protocol_Cust">
        <bp mn:messageE ventDef inition messageRef ="Msg_TestProtocol"/> 
         < b pm n : outgoing > SequenceFlow_ConfirmDelivery </ bpm n:outgoing>
     </ bp m n : start Event >

      <!-- Task -->
    <bpmn:task id="Task_ConfirmDelivery" name="Confirm Delivery">
       <bp mn:i ncoming>SequenceFlow_ConfirmDelivery</ b pm n : incoming > 
        < bpm n:name>Pack Order for Shipment</ bp m n:name> 
         <bpmn:outgoing>SequenceFlow_SendConfirmationBack</bpmn:outgoing>
    </bpmn:task>

      <!-- End Event -->
     <bp mn:endEvent id="EndEvent_CustomerConfirmed">
        < bpmn:incoming > Sequence Flow _ Send Confirmation Back </ b pm n : incoming > 
     </ bp m n : end E vent > 

       <!-- Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_ConfirmDelivery" sourceRef="StartEvent_Catch_Protocol_Cust" targetRef="Task_ConfirmDelivery"/>

      <!-- Intermediate Throw for Confirmation (to link back to Manufacturer) -->
     < bpm n : inter mediateThrowE vent i d =" E vent _T hrow_ C onfir mation " name = "Send Confirmation"> 
        < bp mn:messageEventDefinition messageRef="Msg_Confirmation"/>
         < b pmn:incoming>SequenceFlow_SendConfirmationBack</bpmn:incoming>
     </ bpm n : inter mediateThrowE vent >

      <!-- Flow to Throw Event -->
    <bp m n:s equenc eFlo w id ="S eq_u enceF low_S endC onfir mat ionB ack " s ourc eR ef = " T ask _Con firmD elivery "/> 
         < b pmn:targetRef > E vent_Throw_Confirmation </bpmn:targetRef>

  </ bpm n : process > 

</ bp mndefin i tions>