<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_DIY_Repair">
  <bpmn:collaboration id="Collab_DiyRepairProcess">
    <bpmn:participant name="DIY Smartphone Repair Process" processRef="Process_DIY_Repairs"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_DIY_Repairs" isExecutable="false">
    
    <!-- Flow Elements -->
    
    <bpmn:startEvent id="Start_Event_EnterModel" name="Enter Model & Issue">
      <bpmn:outgoing>SequenceFlow_Start_Recommendations</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:endEvent id="End_Event_Success" name="Repair Successful - Review Sent">
      <bpmn:incoming>SequenceFlow_Review_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="End_Event_Fail" name="Expert Handover Required">
      <bpmn:incoming>SequenceFlow_Expert_End</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Tasks -->
    
    <bpmn:task id="Task_GetRecommendations" name="Get Recommendations & Choices">
      <bpmn:incoming>SequenceFlow_Start_Recommendations</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckSourcing</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_BorrowFromFriends" name="Contact Friends (Borrow)">
      <bpmn:incoming>SequenceFlow_SourcingYes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeSourcing1</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_PurchaseMaterials" name="Purchase Materials (Rest)">
      <bpmn:incoming>SequenceFlow_SourcingYes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeSourcing2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_ReceiveInstructions" name="Receive Repair Instructions">
      <bpmn:incoming>SequenceFlow_SkipSourcing</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_MergeSourcing1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StartRepair</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_PerformRepair" name="Perform Repair">
      <bpmn:incoming>SequenceFlow_StartRepair</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckOutcome</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_SendReviewVideo" name="Send Review & Video">
      <bpmn:incoming>SequenceFlow_OutcomeSuccess</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Review_End</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_SentToExpert" name="Send to Expert">
      <bpmn:incoming>SequenceFlow_OutcomeFail</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Expert_End</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateways -->
    
    <bpmn:exclusiveGateway id="Gw_SourcingDecision" name="Need External Sourcing?">
      <bpmn:incoming>SequenceFlow_CheckSourcing</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SkipSourcing</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SourcingYes</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:parallelGateway id="Gw_MergeBeforeInstruction" name="Merge Sourcing">
      <bpmn:incoming>SequenceFlow_SkipSourcing</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_MergeSourcing1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StartInstructions</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:exclusiveGateway id="Gw_RepairOutcome" name="Repair Successful?">
      <bpmn:incoming>SequenceFlow_CheckOutcome</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OutcomeSuccess</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_OutcomeFail</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flows -->
    
    <bpmn:sequenceFlow id="SequenceFlow_Start_Recommendations" name="Start Process">
      <bpmn:sourceRef>Start_Event_EnterModel</bpmn:sourceRef>
      <bpmn:targetRef>Task_GetRecommendations</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_CheckSourcing" name="Check Inventory">
      <bpmn:sourceRef>Task_GetRecommendations</bpmn:sourceRef>
      <bpmn:targetRef>Gw_SourcingDecision</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <bpmn:parallelGateway id="Gw_SourceSplit" name="Source Items">
       <bpmn:incoming>SequenceFlow_SourcingYes</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_BorrowTask</bpmn:outgoing>
       <bpmn:outgoing>SequenceFlow_PurchaseTask</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:sequenceFlow id="SequenceFlow_SkipSourcing" name="Have All Items">
      <bpmn:sourceRef>Gw_SourcingDecision</bpmn:sourceRef>
      <bpmn:targetRef>Gw_MergeBeforeInstruction</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_SourcingYes" name="Need Sourcing">
       <bpmn:sourceRef>Gw_SourcingDecision</bpmn:sourceRef>
      <bpmn:targetRef>Gw_SourceSplit</bpmn:targetRef>
    </bpmn:sequenceFlow>

     <bpmn:sequenceFlow id="SequenceFlow_BorrowTask" name="Borrow">
      <bpmn:sourceRef>Gw_SourceSplit</bpmn:sourceRef>
      <bpmn:targetRef>Task_BorrowFromFriends</bpmn:targetRef>
    </bpmn:sequenceFlow>

     <bpmn:sequenceFlow id="SequenceFlow_PurchaseTask" name="Buy">
       <bpmn:sourceRef>Gw_SourceSplit</bpmn:sourceRef>
      <bpmn:targetRef>Task_PurchaseMaterials</bpmn:targetRef>
    </bpmn:sequenceFlow>

     <bpmn:sequenceFlow id="SequenceFlow_MergeSourcing1" name="">
       <bpmn:sourceRef>Task_BorrowFromFriends</bpmn:sourceRef>
      <bpmn:targetRef>Gw_MergeBeforeInstruction</bpmn:targetRef>
    </bpmn:sequenceFlow>

     <bpmn:sequenceFlow id="SequenceFlow_MergeSourcing2" name="">
       <bpmn:sourceRef>Task_PurchaseMaterials</bpmn:sourceRef>
      <bpmn:targetRef>Gw_MergeBeforeInstruction</bpmn:targetRef>
    </bpmn:sequenceFlow>

     <bpmn:sequenceFlow id="SequenceFlow_StartInstructions" name="">
       <bpmn:sourceRef>Gw_MergeBeforeInstruction</bpmn:sourceRef>
      <bpmn:targetRef>Task_ReceiveInstructions</bpmn:targetRef>
    </bpmn:sequenceFlow>

     <bpmn:sequenceFlow id="SequenceFlow_StartRepair" name="">
       <bpmn:sourceRef>Task_ReceiveInstructions</bpmn:sourceRef>
      <bpmn:targetRef>Task_PerformRepair</bpmn:targetRef>
    </bpmn:sequenceFlow>

     <bpmn:sequenceFlow id="SequenceFlow_CheckOutcome" name="">
       <bpmn:sourceRef>Task_PerformRepair</bpmn:sourceRef>
      <bpmn:targetRef>Gw_RepairOutcome</bpmn:targetRef>
    </bpmn:sequenceFlow>

     <bpmn:sequenceFlow id="SequenceFlow_OutcomeSuccess" name="Yes">
       <bpmn:sourceRef>Gw_RepairOutcome</bpmn:sourceRef>
      <bpmn:targetRef>Task_SendReviewVideo</bpmn:targetRef>
    </bpmn:sequenceFlow>

     <bpmn:sequenceFlow id="SequenceFlow_OutcomeFail" name="No">
       <bpmn:sourceRef>Gw_RepairOutcome</bpmn:sourceRef>
      <bpmn:targetRef>Task_SentToExpert</bpmn:targetRef>
    </bpmn:sequenceFlow>

     <bpmn:sequenceFlow id="SequenceFlow_Review_End" name="">
       <bpmn:sourceRef>Task_SendReviewVideo</bpmn:sourceRef>
      <bpmn:targetRef>End_Event_Success</bpmn:targetRef>
    </bpmn:sequenceFlow>

     <bpmn:sequenceFlow id="SequenceFlow_Expert_End" name="">
       <bpmn:sourceRef>Task_SentToExpert</bpmn:sourceRef>
      <bpmn:targetRef>End_Event_Fail</bpmn:targetRef>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>