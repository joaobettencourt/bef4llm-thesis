<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Data Validation Error Resolution Process" processRef="Process_1" />
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_IS" name="Information System">
        <bpmn:flowNodeRef>StartEvent_Notification</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Technician" name="Support Technician">
        <bpmn:flowNodeRef>Task_CheckTypos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_IsTypo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CustomerCorrectionCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CanCorrect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ScourPublicSources</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:endEvent_ref>EndEvent_Resolved</bpmn:endEvent_ref>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Notification" name="IS Notified: Data Validation Error">
      <bpmn:outgoing>SequenceFlow_StartToCheckTypos</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Resolved" name="Issue Resolved">
      <bpmn:incoming>SequenceFlow_TypoFoundResolve</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_CustomerFixesIt</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_SolutionFound</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Tasks -->
    <bpmn:task id="Task_CheckTypos" name="Check for Typos">
      <bpmn:incoming>SequenceFlow_StartToCheckTypos</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TypoDecision</bpmn:outgoing>
    </bpmn:task>

    <bpmn:userTask id="Task_CustomerCorrectionCheck" name="Check if Customer can Correct">
      <bpmn:incoming>SequenceFlow_NotTypoPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CorrectionDecision</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:task id="Task_ScourPublicSources" name="Scour Public Sources for Solutions">
      <bpmn:incoming>SequenceFlow_NoCorrectionPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SolutionFound</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateways -->
    <bpmn:exclusiveGateway id="Gateway_IsTypo" name="Is it a Typo?">
      <bpmn:incoming>SequenceFlow_TypoDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TypoFoundResolve</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NotTypoPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:exclusiveGateway id="Gateway_CanCorrect" name="Can Customer Correct?">
      <bpmn:incoming>SequenceFlow_CorrectionDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CustomerFixesIt</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoCorrectionPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToCheckTypos" name="Notification Received" sourceRef="StartEvent_Notification" targetRef="Task_CheckTypos">
      <bpmn:name>Notification Received</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_TypoDecision" sourceRef="Task_CheckTypos" targetRef="Gateway_IsTypo" />

    <bpmn:sequenceFlow id="SequenceFlow_NotTypoPath" name="No - Not a Typo" sourceRef="Gateway_IsTypo" targetRef="Task_CustomerCorrectionCheck">
      <bpmn:name>No</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_TypoFoundResolve" name="" sourceRef="Gateway_IsTypo" targetRef="EndEvent_Resolved">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_CorrectionDecision" sourceRef="Task_CustomerCorrectionCheck" targetRef="Gateway_CanCorrect" />

    <bpmn:sequenceFlow id="SequenceFlow_NoCorrectionPath" name="No - Cannot Correct" sourceRef="Gateway_CanCorrect" targetRef="Task_ScourPublicSources">
      <bpmn:name>No</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_CustomerFixesIt" name="" sourceRef="Gateway_CanCorrect" targetRef="EndEvent_Resolved">
      <bpmn:name/>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>