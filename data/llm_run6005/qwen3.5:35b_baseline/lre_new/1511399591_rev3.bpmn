<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_WebDevProcess">
  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="Pool_1" name="Website Development Process" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_BusinessAnalyst" name="Business Analyst">
        <bpmn:flowNodeRef>StartEvent_CollectData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AnalystCollectData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DesignAdjustmentNeeded</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_WebDesigner" name="Web Designer">
        <bpmn:flowNodeRef>Task_WD_IntegrateDesignInitial</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WD_AdjustReintegrate</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Developer" name="PHP/HTML/CSS Specialist">
        <bpmn:flowNodeRef>Task_Dev_IntegrateImpl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Dev_AdjustTestResults</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Tester" name="Tester">
        <bpmn:flowNodeRef>Gateway_TestOK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Tester_FinalTest</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_End" name="End">
         <bpmn:flowNodeRef>EndEvent_ProcessComplete</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_CollectData" name="Collect Data &amp; Conduct Analysis">
      <bpmn:outgoing>SequenceFlow_AnalystToWD</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1 -->
    <bpmn:task id="Task_AnalystCollectData" name="Business Analyst Collects Data">
      <bpmn:incoming>SequenceFlow_StartToAnalyst</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WD_IntegrateInitial</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2 -->
    <bpmn:task id="Task_WD_IntegrateDesignInitial" name="Integrate Design &amp; Decide Placement">
      <bpmn:incoming>SequenceFlow_AnalystToWD</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_AnalystCheckDesign</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3 -->
    <bpmn:task id="Task_AnalystCheckDesign" name="Check Design &amp; Provide Feedback">
      <bpmn:incoming>SequenceFlow_WD_IntegrateInitial</bpmn:outgoing>
      <bpmn:incoming>SequenceFlow_DesignLoopBack</bpmn:incoming>
      <bpmn:outgoing>Gateway_DesignAdjustmentNeeded</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1 -->
    <bpmn:exclusiveGateway id="Gateway_DesignAdjustmentNeeded" name="Design Adjustment Needed?">
      <bpmn:incoming>SequenceFlow_AnalystCheckDesign</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_WD_AdjustLoop</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_DevIntegratePath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 4 (Adjustment Loop) -->
    <bpmn:task id="Task_WD_AdjustReintegrate" name="Change Design &amp; Re-integrate">
      <bpmn:incoming>SequenceFlow_WD_AdjustLoop</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_DesignLoopBack</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 5 -->
    <bpmn:task id="Task_Dev_IntegrateImpl" name="Integrate Implementation">
      <bpmn:incoming>SequenceFlow_DevIntegratePath</bpmn:outgoing>
      <bpmn:incoming>SequenceFlow_TestLoopBack</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_TesterTestFinal</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 6 -->
    <bpmn:task id="Task_Dev_AdjustTestResults" name="Adjust Implementation based on Tests">
      <bpmn:incoming>SequenceFlow_TestNotOKPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_TestLoopBack</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 7 -->
    <bpmn:task id="Task_Tester_FinalTest" name="Test Final Website">
      <bpmn:incoming>SequenceFlow_DevIntegratePath</bpmn:outgoing>
      <bpmn:incoming>SequenceFlow_TestLoopBack</bpmn:outgoing>
      <bpmn:outgoing>Gateway_TestOK</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2 -->
    <bpmn:exclusiveGateway id="Gateway_TestOK" name="Test OK?">
      <bpmn:incoming>SequenceFlow_TesterTestFinal</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ProcessEndPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_TestNotOKPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_ProcessComplete" name="Process Ends">
      <bpmn:incoming>SequenceFlow_ProcessEndPath</bpmn:outgoing>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToAnalyst" sourceRef="StartEvent_CollectData" targetRef="Task_AnalystCollectData">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_WD_IntegrateInitial" name="" sourceRef="Task_AnalystCollectData" targetRef="Task_WD_IntegrateDesignInitial"/>
    
    <!-- Fixing Task 2 incoming/outgoing logic -->
    <bpmn:task id="Task_WD_IntegrateDesignInitial">
       <bpmn:incoming>SequenceFlow_WD_IntegrateInitial</bpmn:outgoing>
       <bpmn:outgoing>SequenceFlow_AnalystCheckDesign</bpmn:outgoing>
    </bpmn:task>

    <!-- Fixing Task 3 incoming -->
    <bpmn:sequenceFlow id="SequenceFlow_AnalystCheckDesign" sourceRef="Task_WD_IntegrateDesignInitial" targetRef="Task_AnalystCheckDesign">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <!-- Fixing Task 3 incoming/outgoing -->
    <bpmn:task id="Task_AnalystCheckDesign" name="Check Design &amp; Provide Feedback">
       <bpmn:incoming>SequenceFlow_AnalystCheckDesign</bpmn:outgoing>
       <bpmn:outgoing>Gateway_DesignAdjustmentNeeded</bpmn:outgoing>
    </bpmn:task>

    <!-- Fixing Gateway 1 incoming -->
    <bpmn:exclusiveGateway id="Gateway_DesignAdjustmentNeeded" name="Design Adjustment Needed?">
       <bpmn:incoming>SequenceFlow_AnalystCheckDesign</bpmn:outgoing>
       <bpmn:outgoing>SequenceFlow_WD_AdjustLoop</bpmn:outgoing>
       <bpmn:outgoing>SequenceFlow_DevIntegratePath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Fixing Task 4 -->
    <bpmn:task id="Task_WD_AdjustReintegrate" name="Change Design &amp; Re-integrate">
       <bpmn:incoming>SequenceFlow_WD_AdjustLoop</bpmn:outgoing>
       <bpmn:outgoing>SequenceFlow_DesignLoopBack</bpmn:outgoing>
    </bpmn:task>

    <!-- Fixing Sequence Flow 4 -->
    <bpmn:sequenceFlow id="SequenceFlow_WD_AdjustLoop" sourceRef="Gateway_DesignAdjustmentNeeded" targetRef="Task_WD_AdjustReintegrate">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <!-- Fixing Sequence Flow 5 -->
    <bpmn:sequenceFlow id="SequenceFlow_DesignLoopBack" sourceRef="Task_WD_AdjustReintegrate" targetRef="Task_AnalystCheckDesign">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <!-- Fixing Sequence Flow 6 -->
    <bpmn:sequenceFlow id="SequenceFlow_DevIntegratePath" sourceRef="Gateway_DesignAdjustmentNeeded" targetRef="Task_Dev_IntegrateImpl">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <!-- Fixing Task 5 -->
    <bpmn:task id="Task_Dev_IntegrateImpl" name="Integrate Implementation">
       <bpmn:incoming>SequenceFlow_DevIntegratePath</bpmn:outgoing>
       <bpmn:incoming>SequenceFlow_TestLoopBack</bpmn:outgoing>
       <bpmn:outgoing>SequenceFlow_TesterTestFinal</bpmn:outgoing>
    </bpmn:task>

    <!-- Fixing Sequence Flow 7 -->
    <bpmn:sequenceFlow id="SequenceFlow_TestLoopBack" sourceRef="Task_Dev_AdjustTestResults" targetRef="Task_Dev_IntegrateImpl">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <!-- Fixing Task 6 -->
    <bpmn:task id="Task_Dev_AdjustTestResults" name="Adjust Implementation based on Tests">
       <bpmn:incoming>SequenceFlow_TestNotOKPath</bpmn:outgoing>
       <bpmn:outgoing>SequenceFlow_TestLoopBack</bpmn:outgoing>
    </bpmn:task>

    <!-- Fixing Sequence Flow 8 -->
    <bpmn:sequenceFlow id="SequenceFlow_TesterTestFinal" sourceRef="Task_Dev_IntegrateImpl" targetRef="Task_Tester_FinalTest">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <!-- Fixing Task 7 -->
    <bpmn:task id="Task_Tester_FinalTest" name="Test Final Website">
       <bpmn:incoming>SequenceFlow_DevIntegratePath</bpmn:outgoing>
       <bpmn:incoming>SequenceFlow_TestLoopBack</bpmn:outgoing>
       <bpmn:outgoing>Gateway_TestOK</bpmn:outgoing>
    </bpmn:task>

    <!-- Fixing Gateway 2 -->
    <bpmn:exclusiveGateway id="Gateway_TestOK" name="Test OK?">
       <bpmn:incoming>SequenceFlow_TesterTestFinal</bpmn:outgoing>
       <bpmn:outgoing>SequenceFlow_ProcessEndPath</bpmn:outgoing>
       <bpmn:outgoing>SequenceFlow_TestNotOKPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Fixing Sequence Flow 9 -->
    <bpmn:sequenceFlow id="SequenceFlow_ProcessEndPath" sourceRef="Gateway_TestOK" targetRef="EndEvent_ProcessComplete">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <!-- Fixing Sequence Flow 10 -->
    <bpmn:sequenceFlow id="SequenceFlow_TestNotOKPath" sourceRef="Gateway_TestOK" targetRef="Task_Dev_AdjustTestResults">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <!-- End Event Fixing -->
    <bpmn:endEvent id="EndEvent_ProcessComplete" name="Process Ends">
       <bpmn:incoming>SequenceFlow_ProcessEndPath</bpmn:outgoing>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>