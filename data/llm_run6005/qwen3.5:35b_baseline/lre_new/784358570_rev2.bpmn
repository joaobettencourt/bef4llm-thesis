<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_OrderFulfillment">
    <bpmn:participant id="Pool_FulfillmentOrg" name="Order Fulfillment Org" processRef="Process_FulfillmentOrg" />
    <bpmn:participant id="Pool_Customer" name="Customer" processRef="Process_Customer" />
    <bpmn:participant id="Pool_CourierCompany" name="Courier Company" processRef="Process_CourierCompany" />

    <!-- Message Flows -->
    <bpmn:messageFlow id="Message_FulfillmentToCustomer_Delay" sourceRef="Task_InformDelay" targetRef="Event_CustomerReceiveDelayNotification" />
    <bpmn:messageFlow id="Message_FulfillmentToCustomer_Discontinued" sourceRef="Task_InformDiscontinued" targetRef="Event_CustomerReceiveUnavailableInfo" />
    <bpmn:messageFlow id="Message_CourierToClient_Delay" sourceRef="Task_CourierInformDelay" targetRef="Event_ClientReceiveCourierNotification" />

  </bpmn:collaboration>

  <!-- Process for Order Fulfillment Org -->
  <bpmn:process id="Process_FulfillmentOrg" isExecutable="false">
    <bpmn:startEvent id="StartEvent_OrderReceived" name="Receive Customer Order">
      <bpmn:outgoing>SequenceFlow_CheckStock</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_CheckStock" name="Check Item Availability">
      <bpmn:incoming>SequenceFlow_CheckStock</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ItemsAvailableDecision</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_ItemsAvailable" name="All items available?">
      <bpmn:incoming>SequenceFlow_ItemsAvailableDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MissingItemsPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_DiscontinuedItemPath</bpmn:outgoing>
    </bpmn:endEvent>

    <!-- Path 1: Missing Items -->
    <bpmn:task id="Task_InformDelay" name="Inform Customer of Delay">
      <bpmn:incoming>SequenceFlow_MissingItemsPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OrderMissingProducts</bpmn:outgoing>
    </bpmn:endEvent>

    <bpmn:task id="Task_OrderMissingProducts" name="Order Missing Products">
      <bpmn:incoming>SequenceFlow_OrderMissingProducts</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitForDelivery</bpmn:outgoing>
    </bpmn:endEvent>

    <!-- Timer Event -->
    <bpmn:startEvent id="StartTimerWait" name="Wait for Delivery">
       <bpmn:timerDefinition xsi:type="bpmn:TimeDurationExpression">P3D</bpmn:timerDefinition>
      <bpmn:outgoing>SequenceFlow_CheckAgain</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Intermediate Catch Event for Timer -->
    <bpmn:endEvent id="EndOrderCancelled" name="Order Cancelled">
      <bpmn:incoming>SequenceFlow_CancelOrder</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Path 2: Discontinued Item -->
    <bpmn:task id="Task_InformDiscontinued" name="Inform Customer of Unavailable Items">
      <bpmn:incoming>SequenceFlow_DiscontinuedItemPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CancelOrder</bpmn:outgoing>
    </bpmn:endEvent>

    <!-- Path 3: All OK -->
    <bpmn:task id="Task_RecollectPackage" name="Recollect &amp; Prepare Package">
       <bpmn:incoming>SequenceFlow_ItemsAvailableDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendToCourier</bpmn:outgoing>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckStock" sourceRef="StartEvent_OrderReceived" targetRef="Task_CheckStock" />
    <bpmn:sequenceFlow id="SequenceFlow_ItemsAvailableDecision" name="" sourceRef="Task_CheckStock" targetRef="Gateway_ItemsAvailable" />

  </bpmn:endeventref></bpmn:startEvent/>
</bmmn:collaboration>