<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_ACME_Inc" name="ACME Inc." processRef="Process_1" />
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Financial_Dept" name="Financial Department">
        <bpmn:flowNodeRef>StartEvent_InvoiceReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckPurchaseInvoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendToDepartment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MergePayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TriggerERPPayment</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Receiving_Dept" name="Receiving Department">
        <bpmn:flowNodeRef>Gateway_AmountCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VerifyRegisterSAPERION</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Department_Head" name="Department Head">
        <bpmn:flowNodeRef>Task_ApproveInvoice_SAPERION</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_InvoiceReceived" name="Receive Invoice">
      <bpmn:outgoing>SequenceFlow_CheckInvoice</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Tasks in Financial Department Lane -->
    <bpmn:task id="Task_CheckPurchaseInvoice" name="Check Purchase Invoice">
      <bpmn:incoming>SequenceFlow_CheckInvoice</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendToDept</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_SendToDepartment" name="Send Invoice to Department">
      <bpmn:incoming>SequenceFlow_SendToDept</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_VerifyInvoice</bpmn:outgoing>
    </bpmn:task>

    <!-- Tasks in Receiving Department Lane -->
    <bpmn:task id="Task_VerifyRegisterSAPERION" name="Check Factual Correctness &amp; Register SAPERION">
      <bpmn:incoming>SequenceFlow_VerifyInvoice</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckAmount</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for Amount Check -->
    <bpmn:exclusiveGateway id="Gateway_AmountCheck" name="Amount &gt; $500?">
      <bpmn:incoming>SequenceFlow_CheckAmount</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ApprovalPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PaymentDirectPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task in Department Head Lane -->
    <bpmn:userTask id="Task_ApproveInvoice_SAPERION" name="Approve Invoice via SAPERION">
      <bpmn:incoming>SequenceFlow_ApprovalPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToMergePayment</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Merge Gateway -->
    <bpmn:exclusiveGateway id="Gateway_MergePayment" name="Converge Payment">
      <bpmn:incoming>SequenceFlow_PaymentDirectPath</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ToMergePayment</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TriggerERP</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Final Task in Financial Department Lane -->
    <bpmn:task id="Task_TriggerERPPayment" name="Trigger ERP System for Payment">
      <bpmn:incoming>SequenceFlow_TriggerERP</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndProcess</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_ProcessEnded" name="Payment Processed">
      <bpmn:incoming>SequenceFlow_EndProcess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckInvoice" sourceRef="StartEvent_InvoiceReceived" targetRef="Task_CheckPurchaseInvoice" />
    
    <bpmn:sequenceFlow id="SequenceFlow_SendToDept" name="Send to Department" sourceRef="Task_SendToDepartment" targetRef="Gateway_AmountCheck">
      <!-- Note: Flow crosses lanes implicitly via sequence flow connection -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_VerifyInvoice" sourceRef="Task_SendToDepartment" targetRef="Task_VerifyRegisterSAPERION" />
    
    <bpmn:sequenceFlow id="SequenceFlow_CheckAmount" name="" sourceRef="Gateway_AmountCheck" targetRef="Task_VerifyRegisterSAPERION">
      <!-- Correction: Flow should go FROM Task TO Gateway -->
    </bpmn:sequenceFlow>

    <!-- Correcting Sequence Flows for Logic Accuracy based on previous draft logic fix -->
    
  </bpmn:process>
</bpmn:definitions>