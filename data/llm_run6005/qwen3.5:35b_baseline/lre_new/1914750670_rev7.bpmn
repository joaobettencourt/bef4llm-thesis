<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_AccountCreation">
    <bpmn:participant id="Participant_BankProcess" name="Account Creation Process" processRef="Process_AccountCreation" />
  </bpmn:collaboration>

  <bpmn:process id="Process_AccountCreation" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Customer" name="Customer">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GenerateRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DataObject_RequestPDF</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrintDocument</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitPostOffice</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_PostOffice" name="Post Office">
        <bpmn:flowNodeRef>Task_CheckIdentity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendRequestToBank</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_BankOfficer" name="Bank Officer">
        <bpmn:flowNodeRef>Gateway_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MailAccountDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Accepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendRefusalLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Rejected</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Visit Website">
      <bpmn:outgoing>SequenceFlow_StartToGenerate</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Data Object for PDF Document -->
    <bpmn:dataObjectReference id="DataObject_RequestPDF" name="Account Request (PDF)" />

    <!-- Tasks - Customer Lane -->
    <bpmn:task id="Task_GenerateRequest" name="Fill Personal Data &amp; Generate PDF">
      <bpmn:incoming>SequenceFlow_StartToGenerate</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GenToPrint</bpmn:outgoing>
    </bpmn:task>

    <!-- Association for Data Object -->
    <bpmn:association id="Assoc_RequestPDF">
      <bpmn:sourceRef>DataObject_RequestPDF</bpmn:sourceRef>
      <bpmn:targetRef>Task_GenerateRequest</bpmn:targetRef>
    </bpmn:association>

    <!-- Tasks - Customer Lane -->
    <bpmn:task id="Task_PrintDocument" name="Print Document">
      <bpmn:incoming>SequenceFlow_GenToPrint</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PrintSubmit</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow - Customer to Post Office -->
    <bpmn:sequenceFlow id="SequenceFlow_PrintSubmit" sourceRef="Task_PrintDocument" targetRef="Task_SubmitPostOffice">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:task id="Task_SubmitPostOffice" name="Visit Post Office &amp; Send Documents">
      <bpmn:incoming>SequenceFlow_PrintSubmit</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SubmitToCheckIdentity</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow - Customer to Post Office -->
    <bpmn:sequenceFlow id="SequenceFlow_SubmitToCheckIdentity" sourceRef="Task_SubmitPostOffice" targetRef="Task_CheckIdentity">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <!-- Tasks - Post Office Lane -->
    <bpmn:task id="Task_CheckIdentity" name="Check Customer Identity">
      <bpmn:incoming>SequenceFlow_SubmitToCheckIdentity</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_IdentitySendRequest</bpmn:outgoing>
    </bpmn:task>

    <!-- Tasks - Post Office Lane -->
    <bpmn:task id="Task_SendRequestToBank" name="Mail Request to Bank">
      <bpmn:incoming>SequenceFlow_IdentitySendRequest</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendToReceive</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow - Post Office to Bank Officer -->
    <bpmn:sequenceFlow id="SequenceFlow_SendToReceive" sourceRef="Task_SendRequestToBank" targetRef="Task_ReceiveRequest">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <!-- Tasks - Bank Officer Lane -->
    <bpmn:task id="Task_ReceiveRequest" name="Check Customer Data &amp; Review Request">
      <bpmn:incoming>SequenceFlow_SendToReceive</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckToDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway -->
    <bpmn:exclusiveGateway id="Gateway_Decision" name="Accept Request?">
      <bpmn:incoming>SequenceFlow_CheckToDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AcceptPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RejectPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flow - Decision to Accept Task -->
    <bpmn:sequenceFlow id="SequenceFlow_AcceptPath" sourceRef="Gateway_Decision" targetRef="Task_MailAccountDocs">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <!-- Tasks - Bank Officer Lane (Accept Path) -->
    <bpmn:task id="Task_MailAccountDocs" name="Mail Account Documents to Customer">
      <bpmn:incoming>SequenceFlow_AcceptPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DocsToAcceptEnd</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event - Accepted -->
    <bpmn:endEvent id="EndEvent_Accepted" name="Account Created">
      <bpmn:incoming>SequenceFlow_DocsToAcceptEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flow - Decision to Reject Task -->
    <bpmn:sequenceFlow id="SequenceFlow_RejectPath" sourceRef="Gateway_Decision" targetRef="Task_SendRefusalLetter">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <!-- Tasks - Bank Officer Lane (Reject Path) -->
    <bpmn:task id="Task_SendRefusalLetter" name="Mail Letter of Refusal to Customer">
      <bpmn:incoming>SequenceFlow_RejectPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RefusalToRejectEnd</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event - Rejected -->
    <bpmn:endEvent id="EndEvent_Rejected" name="Request Rejected">
      <bpmn:incoming>SequenceFlow_RefusalToRejectEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flow for Gateway Incoming -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckToDecision" sourceRef="Task_ReceiveRequest" targetRef="Gateway_Decision">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <!-- Remaining sequence flows with proper attributes -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToGenerate" sourceRef="StartEvent_1" targetRef="Task_GenerateRequest">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_GenToPrint" sourceRef="Task_GenerateRequest" targetRef="Task_PrintDocument">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_IdentitySendRequest" sourceRef="Task_CheckIdentity" targetRef="Task_SendRequestToBank">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_DocsToAcceptEnd" sourceRef="Task_MailAccountDocs" targetRef="EndEvent_Accepted">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_RefusalToRejectEnd" sourceRef="Task_SendRefusalLetter" targetRef="EndEvent_Rejected">
      <bpmn:name/>
    </bpmn:sequenceFlow>
  </bpmn:process>
</bpmn:definitions>