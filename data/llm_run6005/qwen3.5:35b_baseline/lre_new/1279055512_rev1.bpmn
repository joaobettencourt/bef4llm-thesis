<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_SSP_Invoice_Processing">
    <bpmn:participant id="Participant_SSP_Org" name="SSP Organization Invoice Processing" processRef="Process_1" />
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Mail_Centre" name="Mail Centre Office">
        <bpmn:flowNodeRef>StartEvent_InvoiceReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CategorizeInvoice</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Administration" name="Administration Department">
        <bpmn:flowNodeRef>SubProcess_ProcessInvoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_StoreInCollectionBox</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Data_Entry" name="Data Entry Office">
        <bpmn:flowNodeRef>Timer_Daily10AM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_EnterSAPSystem</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Validation" name="Validation Office">
        <bpmn:flowNodeRef>Timer_HourlyReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_ValidateInvoices</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Payment" name="Payment Office">
        <bpmn:flowNodeRef>Timer_StartOfWeek</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_ExecutePayment</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Registry" name="Registry Office">
        <bpmn:flowNodeRef>Task_ArchiveInvoices</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_InvoiceArchived</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_InvoiceReceived" name="Receive Invoice from Client">
      <bpmn:outgoing>SequenceFlow_CategorizeInvoice</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Categorization -->
    <bpmn:task id="Task_CategorizeInvoice" name="Categorize Invoice by Staff Member">
      <bpmn:incoming>SequenceFlow_CategorizeInvoice</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AdminProcessStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Subprocess 1: Admin Processing -->
    <bpmn:subProcess id="SubProcess_ProcessInvoice" name="Complex Invoice Process">
      <bpmn:startEvent id="SP_Start_01">
        <bpmn:outgoing>SequenceFlow_SP_Task_01</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:endEvent id="SP_End_01" />
    </bpmn:subProcess>

    <!-- Task 2: Store in Box -->
    <bpmn:task id="Task_StoreInCollectionBox" name="Store Invoices in Collection Box">
      <bpmn:incoming>SequenceFlow_AdminToStorage</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Wait10AM</bpmn:outgoing>
    </bpmn:task>

    <!-- Timer Event 1: Wait for Daily 10 AM -->
    <bpmn:intermediateCatchEvent id="Timer_Daily10AM" name="Wait until Workday at 10am">
      <bpmn:incoming>SequenceFlow_Wait10AM</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EnterSAPStart</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Subprocess 2: SAP Data Entry -->
    <bpmn:subProcess id="SubProcess_EnterSAPSystem" name="Enter Data in SAP System">
      <bpmn:startEvent id="SP_Start_02">
        <bpmn:outgoing>SequenceFlow_SP_Task_02</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:endEvent id="SP_End_02" />
    </bpmn:subProcess>

    <!-- Timer Event 2: Hourly Review Trigger -->
    <bpmn:intermediateCatchEvent id="Timer_HourlyReview" name="Hourly System Review">
      <bpmn:incoming>SequenceFlow_SAPToReview</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ValidationStart</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Subprocess 3: Validation -->
    <bpmn:subProcess id="SubProcess_ValidateInvoices" name="Big Process of Validating Invoices">
      <bpmn:startEvent id="SP_Start_03">
        <bpmn:outgoing>SequenceFlow_SP_Task_03</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:endEvent id="SP_End_03" />
    </bpmn:subProcess>

    <!-- Timer Event 3: Wait for Start of Week -->
    <bpmn:intermediateCatchEvent id="Timer_StartOfWeek" name="Wait until Beginning of Week">
      <bpmn:incoming>SequenceFlow_ValidationToPayment</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PaymentStart</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Subprocess 4: Payment -->
    <bpmn:subProcess id="SubProcess_ExecutePayment" name="Execute Payment of Validated Invoices">
      <bpmn:startEvent id="SP_Start_04">
        <bpmn:outgoing>SequenceFlow_SP_Task_04</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:endEvent id="SP_End_04" />
    </bpmn:subProcess>

    <!-- Task 5: Archive -->
    <bpmn:task id="Task_ArchiveInvoices" name="Archive Invoices">
      <bpmn:incoming>SequenceFlow_PaymentToArchive</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FinalizeArchiving</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_InvoiceArchived" name="Invoice Archived">
      <bpmn:incoming>SequenceFlow_FinalizeArchiving</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_CategorizeInvoice" sourceRef="StartEvent_InvoiceReceived" targetRef="Task_CategorizeInvoice">
      <bpmn:name>Categorize Invoice</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_AdminProcessStart" name="" sourceRef="Task_CategorizeInvoice" targetRef="SubProcess_ProcessInvoice" />

    <bpmn:sequenceFlow id="SequenceFlow_AdminToStorage" sourceRef="SubProcess_ProcessInvoice" targetRef="Task_StoreInCollectionBox">
      <bpmn:name>Store in Box</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Flow crossing lanes from Storage (Admin) to Timer (Data Entry) -->
    <bpmn:sequenceFlow id="SequenceFlow_Wait10AM" sourceRef="Task_StoreInCollectionBox" targetRef="Timer_Daily10AM">
      <bpmn:name>Wait for 10am</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Flow crossing lanes from Timer (Data Entry) to SubProcess (Data Entry) -->
    <bpmn:sequenceFlow id="SequenceFlow_EnterSAPStart" sourceRef="Timer_Daily10AM" targetRef="SubProcess_EnterSAPSystem">
      <bpmn:name>Enter SAP Data</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Flow crossing lanes from SubProcess (Data Entry) to Timer (Mail Centre/Validation Trigger) -->
    <bpmn:sequenceFlow id="SequenceFlow_SAPToReview" sourceRef="SubProcess_EnterSAPSystem" targetRef="Timer_HourlyReview">
      <bpmn:name>Trigger Hourly Review</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Flow crossing lanes from Timer (Validation) to SubProcess (Validation) -->
    <bpmn:sequenceFlow id="SequenceFlow_ValidationStart" sourceRef="Timer_HourlyReview" targetRef="SubProcess_ValidateInvoices">
      <bpmn:name>Forward for Validation</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Flow crossing lanes from SubProcess (Validation) to Timer (Payment) -->
    <bpmn:sequenceFlow id="SequenceFlow_ValidationToPayment" sourceRef="SubProcess_ValidateInvoices" targetRef="Timer_StartOfWeek">
      <bpmn:name>Ready for Payment</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Flow crossing lanes from Timer (Payment) to SubProcess (Payment) -->
    <bpmn:sequenceFlow id="SequenceFlow_PaymentStart" sourceRef="Timer_StartOfWeek" targetRef="SubProcess_ExecutePayment">
      <bpmn:name>Execute Payment</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Flow crossing lanes from SubProcess (Payment) to Task (Registry) -->
    <bpmn:sequenceFlow id="SequenceFlow_PaymentToArchive" sourceRef="SubProcess_ExecutePayment" targetRef="Task_ArchiveInvoices">
      <bpmn:name>To Archive</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Flow to End Event -->
    <bpmn:sequenceFlow id="SequenceFlow_FinalizeArchiving" sourceRef="Task_ArchiveInvoices" targetRef="EndEvent_InvoiceArchived">
      <bpmn:name>Archive Complete</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>