<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_NewClientAcquisition" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="Participant_Process" name="New Client Acquisition Process" processRef="Process_Acquisition"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Acquisition" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Management" name="Management">
        <bpmn:flowNodeRef>StartEvent_NeedIndication</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendDetailedOffer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ClientAccepts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareContract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Signed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AnalyzeFailureReasons</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_FailureAnalysisComplete</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Marketing" name="Marketing Team">
        <bpmn:flowNodeRef>Task_AnalyzeMarket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepPresentation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendOffersToPotentialClients</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CatchEvent_ClientResponses</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InformManagementAboutResponses</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_NeedIndication" name="New Clients Needed Indicated">
      <bpmn:outgoing>SequenceFlow_StartToAnalysis</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Marketing Tasks -->
    <bpmn:task id="Task_AnalyzeMarket" name="Perform Market Analysis">
      <bpmn:incoming>SequenceFlow_StartToAnalysis</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AnalysisToPresentation</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_PrepPresentation" name="Prepare Portfolio Presentation">
      <bpmn:incoming>SequenceFlow_AnalysisToPresentation</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PresentationToOffers</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_SendOffersToPotentialClients" name="Send Offers to Potential Clients">
      <bpmn:incoming>SequenceFlow_PresentationToOffers</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OffersSentToCatchEvent</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Event for Responses -->
    <bpmn:intermediateCatchEvent id="CatchEvent_ClientResponses" name="Receive Client Responses">
      <bpmn:incoming>SequenceFlow_OffersSentToCatchEvent</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CatchToInformManagement</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Handover to Management -->
    <bpmn:task id="InformManagementAboutResponses" name="Inform Management About Responses">
      <bpmn:incoming>SequenceFlow_CatchToInformManagement</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InformToNegotiationStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Management Tasks -->
    <bpmn:task id="Task_SendDetailedOffer" name="Send Detailed Offer to Client">
      <bpmn:incoming>SequenceFlow_InformToNegotiationStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OfferSentToGateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway -->
    <bpmn:exclusiveGateway id="Gateway_ClientAccepts" name="Client Accept Offer?">
      <bpmn:incoming>SequenceFlow_OfferSentToGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AcceptPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RejectPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Success Path -->
    <bpmn:task id="Task_PrepareContract" name="Prepare Contract">
      <bpmn:incoming>SequenceFlow_AcceptPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ContractToSign</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event for Success -->
    <bpmn:endEvent id="EndEvent_Signed" name="Contract Signed">
      <bpmn:incoming>SequenceFlow_ContractToSign</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Failure Path -->
    <bpmn:task id="Task_AnalyzeFailureReasons" name="Analyze Reason for Offer Failure">
      <bpmn:incoming>SequenceFlow_RejectPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AnalysisToImprove</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event for Analysis -->
    <bpmn:endEvent id="EndEvent_FailureAnalysisComplete" name="Process Improved">
      <bpmn:incoming>SequenceFlow_AnalysisToImprove</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToAnalysis" sourceRef="StartEvent_NeedIndication" targetRef="Task_AnalyzeMarket"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_AnalysisToPresentation" sourceRef="Task_AnalyzeMarket" targetRef="Task_PrepPresentation"/>

    <bpmn:sequenceFlow id="SequenceFlow_PresentationToOffers" sourceRef="Task_PrepPresentation" targetRef="Task_SendOffersToPotentialClients"/>

    <bpmn:sequenceFlow id="SequenceFlow_OffersSentToCatchEvent" sourceRef="Task_SendOffersToPotentialClients" targetRef="CatchEvent_ClientResponses"/>

    <bpmn:sequenceFlow id="SequenceFlow_CatchToInformManagement" sourceRef="CatchEvent_ClientResponses" targetRef="InformManagementAboutResponses"/>

    <bpmn:sequenceFlow id="SequenceFlow_InformToNegotiationStart" sourceRef="InformManagementAboutResponses" targetRef="Task_SendDetailedOffer"/>

    <bpmn:sequenceFlow id="SequenceFlow_OfferSentToGateway" sourceRef="Task_SendDetailedOffer" targetRef="Gateway_ClientAccepts"/>
    
    <!-- Gateway Outcomes -->
    <bpmn:sequenceFlow id="SequenceFlow_AcceptPath" name="Yes - Client Accepts" sourceRef="Gateway_ClientAccepts" targetRef="Task_PrepareContract">
      <bpmn:name>yes</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_RejectPath" name="No - Offer Failed" sourceRef="Gateway_ClientAccepts" targetRef="Task_AnalyzeFailureReasons">
      <bpmn:name>no</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Success Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_ContractToSign" sourceRef="Task_PrepareContract" targetRef="EndEvent_Signed"/>

    <!-- Failure Analysis Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_AnalysisToImprove" name="Analyze and Improve Future Process" sourceRef="Task_AnalyzeFailureReasons" targetRef="EndEvent_FailureAnalysisComplete"/>

  </bpmn:process>
</bpmn:definitions>