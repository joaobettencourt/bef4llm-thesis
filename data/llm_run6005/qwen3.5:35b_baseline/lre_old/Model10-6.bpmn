<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_DismissalProcess">
    <bpmn:participant id="Pool_MSPN" name="MSPN" processRef="Proc_MSPN"/>
    <bpmn:participant id="Pool_MSPO" name="MSPO" processRef="Proc_MSPO"/>
  </bpmn:collaboration>

  <bpmn:message id="Msg_DismissalSent" />

  <bpmn:process id="Proc_MSPN">
    <bpmn:startEvent id="Start_SendDismissal" name="Initiate Dismissal Process">
      <bpmn:outgoing>Seq_StartToTask</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_SendDismissingDocument" name="Send dismissal to MSPO">
      <bpmn:incoming>Seq_StartToTask</bpmn:incoming>
      <bpmn:outgoing>Seq_TaskToEnd</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="End_DismissalSent" name="Dismissal Sent">
      <bpmn:incoming>Seq_TaskToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:messageFlow id="MsgFlow_SendToMSPO" sourceRef="Task_SendDismissingDocument" targetRef="Start_ReceiveDismissal"/>

  </bpmn:process>

  <bpmn:process id="Proc_MSPO">
    <bpmn:startEvent id="Start_ReceiveDismissal" name="Received Dismissal Notification">
      <bpmn:messageEventDefinition messageRef="Msg_DismissalSent"/>
      <bpmn:outgoing>Seq_StartToReview</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_ReviewDismissal" name="Reviews the dismissal of MSPN">
      <bpmn:incoming>Seq_StartToReview</bpmn:incoming>
      <bpmn:outgoing>Seq_ReviewToGateway</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_Decision" name="Decision on Dismissal">
      <bpmn:incoming>Seq_ReviewToGateway</bpmn:incoming>
      <bpmn:outgoing>Seq_RejectPath</bpmn:outgoing>
      <bpmn:outgoing>Seq_ConfirmPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="End_Rejected" name="Dismissal Rejected">
      <bpmn:incoming>Seq_RejectPath</bpmn:incoming/>
    </bpmn:endEvent>

    <bpmn:endEvent id="End_Confirmed" name="Dismissal Confirmed">
      <bpmn:incoming>Seq_ConfirmPath</bpmn:incoming/>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Seq_StartToReview" sourceRef="Start_ReceiveDismissal" targetRef="Task_ReviewDismissal"/>
    <bpmn:sequenceFlow id="Seq_ReviewToGateway" sourceRef="Task_ReviewDismissal" targetRef="Gateway_Decision"/>
    <bpmn:sequenceFlow id="Seq_RejectPath" name="Rejects dismissal" sourceRef="Gateway_Decision" targetRef="End_Rejected"/>
    <bpmn:sequenceFlow id="Seq_ConfirmPath" name="Confirms dismissal" sourceRef="Gateway_Decision" targetRef="End_Confirmed"/>

  </bpmn:process>

</bpmn:definitions>