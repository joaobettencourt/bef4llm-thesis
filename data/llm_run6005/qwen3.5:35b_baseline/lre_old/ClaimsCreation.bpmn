<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ClaimsProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_InsuranceClaims">
    <bpmn:participant id="Participant_CloudSystem" name="Insurance Claims Management" processRef="Proc_ClaimWorkflow"/>
  </bpmn:collaboration>

  <bpmn:process id="Proc_ClaimWorkflow" isExecutable="false">
    
    <!-- Lane Set for Roles -->
    <bpmn:laneSet id="LaneSet_01">
      <bpmn:lane id="Lane_Handler" name="Claims Handler">
        <bpmn:flowNodeRef>Task_CompileDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CalculateEstimate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateActionPlan</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Manager" name="Claims Manager">
        <bpmn:flowNodeRef>Task_NegotiateSettlement</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="Start_AccidentReport" name="Receive Accident Report">
      <bpmn:outgoing>Seq_StartToCompile</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Compile Documents (Handler) -->
    <bpmn:task id="Task_CompileDocs" name="Search Police Report &amp; Create File">
      <bpmn:incoming>Seq_StartToCompile</bpmn:incoming>
      <bpmn:outgoing>Seq_DocsReady</bpmn:outgoing>
    </bpmn:task>

    <!-- Data Object 1: Claim Documentation Package -->
    <bpmn:dataObject id="Data_ClaimPackage" name="Claim Documentation Package"/>

    <!-- Association for Task Output to Data Object -->
    <bpmn:association id="Assoc_TaskToDocOutput" sourceRef="Task_CompileDocs" targetRef="Data_ClaimPackage">
      <bpmn:messageFlowDirection>OUTGOING</bpmn:messageFlowDirection>
    </bpmn:association>

    <!-- Task 2: Calculate Estimate (Handler) -->
    <bpmn:task id="Task_CalculateEstimate" name="Calculate Initial Claim Estimate">
      <bpmn:incoming>Seq_DocsReady</bpmn:incoming>
      <bpmn:outgoing>Seq_EstimateCreated</bpmn:outgoing>
    </bpmn:task>

    <!-- Data Object 2: Initial Claim Estimate -->
    <bpmn:dataObject id="Data_InitialEstimate" name="Initial Claim Estimate"/>

    <!-- Association for Task Output to Data Object -->
    <bpmn:association id="Assoc_TaskToEstimateOutput" sourceRef="Task_CalculateEstimate" targetRef="Data_InitialEstimate">
      <bpmn:messageFlowDirection>OUTGOING</bpmn:messageFlowDirection>
    </bpmn:association>

    <!-- Task 3: Create Action Plan (Handler) -->
    <bpmn:task id="Task_CreateActionPlan" name="Create Action Plan">
      <bpmn:incoming>Seq_EstimateCreated</bpmn:incoming>
      <bpmn:outgoing>Seq_PlanReady</bpmn:outgoing>
    </bpmn:task>

    <!-- Data Object 3: Action Plan Checklist (Input) -->
    <bpmn:dataObject id="Data_Checklist" name="Action Plan Checklist"/>

    <!-- Association for Task Input from Data Object -->
    <bpmn:association id="Assoc_DocToTaskChecklist" sourceRef="Data_Checklist" targetRef="Task_CreateActionPlan">
      <bpmn:messageFlowDirection>INCOMING</bpmn:messageFlowDirection>
    </bpmn:association>

    <!-- Data Object 4: Created Action Plan (Output) -->
    <bpmn:dataObject id="Data_ActionPlan" name="Created Action Plan"/>

    <!-- Association for Task Output to Data Object -->
    <bpmn:association id="Assoc_TaskToActionPlanOutput" sourceRef="Task_CreateActionPlan" targetRef="Data_ActionPlan">
      <bpmn:messageFlowDirection>OUTGOING</bpmn:messageFlowDirection>
    </bpmn:association>

    <!-- Task 4: Negotiate Settlement (Manager) -->
    <bpmn:task id="Task_NegotiateSettlement" name="Negotiate Claim Estimate">
      <bpmn:incoming>Seq_PlanReady</bpmn:incoming>
      <bpmn:outgoing>Seq_FinalizeProcess</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="End_InformClaimant" name="Inform Claimant of Outcome">
      <bpmn:incoming>Seq_FinalizeProcess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows (Flow Elements Only) -->
    <bpmn:sequenceFlow id="Seq_StartToCompile" sourceRef="Start_AccidentReport" targetRef="Task_CompileDocs"/>
    
    <bpmn:sequenceFlow id="Seq_DocsReady" name="Documents Ready" sourceRef="Task_CompileDocs" targetRef="Task_CalculateEstimate"/>
    
    <bpmn:sequenceFlow id="Seq_EstimateCreated" name="Estimate Created" sourceRef="Task_CalculateEstimate" targetRef="Task_CreateActionPlan"/>
    
    <bpmn:sequenceFlow id="Seq_PlanReady" name="Plan Ready" sourceRef="Task_CreateActionPlan" targetRef="Task_NegotiateSettlement"/>
    
    <bpmn:sequenceFlow id="Seq_FinalizeProcess" sourceRef="Task_NegotiateSettlement" targetRef="End_InformClaimant"/>

  </bpmn:process>
</bpmn:definitions>