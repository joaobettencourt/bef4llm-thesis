<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_RecruitmentProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_Recruitment">
    <bpmn:participant id="Participant_Recruitment" name="Vacancy Management Process" processRef="Proc_Recruitment"/>
  </bpmn:collaboration>

  <bpmn:process id="Proc_Recruitment" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Requester" name="Requester (I)">
        <bpmn:flowNodeRef>StartEvent_DetectRequirements</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReportVacancy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_QuestionsDuringCreation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProvideClarifications</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewJobDescription</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ApprovalDecision</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PersonnelDept" name="Personnel Department">
        <bpmn:flowNodeRef>Task_CreateJobDescriptionDraft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_QuestionsDuringCreation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviseJobDescription</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AdvertiseVacancy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Complete</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_DetectRequirements" name="Detect Personnel Requirements">
      <bpmn:outgoing>SequenceFlow_ReportVacancy</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Report Vacancy -->
    <bpmn:task id="Task_ReportVacancy" name="Report Vacancy to HR">
      <bpmn:incoming>SequenceFlow_ReportVacancy</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CreateDraft</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: Create Draft -->
    <bpmn:task id="Task_CreateJobDescriptionDraft" name="Create Job Description">
      <bpmn:incoming>SequenceFlow_CreateDraft</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckQuestionsCreation</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Questions during creation -->
    <bpmn:exclusiveGateway id="Gateway_QuestionsDuringCreation" name="HR has questions?">
      <bpmn:incoming>SequenceFlow_CheckQuestionsCreation</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProvideClarificationsPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ReadyForReview</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 3: Provide Clarifications -->
    <bpmn:task id="Task_ProvideClarifications" name="Provide Clarifications">
      <bpmn:incoming>SequenceFlow_ProvideClarificationsPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BackToDrafting</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2: Approval Decision -->
    <bpmn:exclusiveGateway id="Gateway_ApprovalDecision" name="Approve Description?">
      <bpmn:incoming>SequenceFlow_ReviewToApproval</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AdvertisePath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CorrectionsNeeded</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 4: Review Job Description -->
    <bpmn:task id="Task_ReviewJobDescription" name="Review Job Description">
      <bpmn:incoming>SequenceFlow_ReadyForReview</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReviewToApproval</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 5: Revise Job Description -->
    <bpmn:task id="Task_ReviseJobDescription" name="Revise Job Description">
      <bpmn:incoming>SequenceFlow_CorrectionsNeeded</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReCheckApproval</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 6: Advertise Vacancy -->
    <bpmn:task id="Task_AdvertiseVacancy" name="Advertise Vacancy">
      <bpmn:incoming>SequenceFlow_AdvertisePath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndProcess</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Complete" name="Vacancy Advertised">
      <bpmn:incoming>SequenceFlow_EndProcess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_ReportVacancy" sourceRef="StartEvent_DetectRequirements" targetRef="Task_ReportVacancy"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_CreateDraft" sourceRef="Task_ReportVacancy" targetRef="Task_CreateJobDescriptionDraft"/>

    <bpmn:sequenceFlow id="SequenceFlow_CheckQuestionsCreation" sourceRef="Task_CreateJobDescriptionDraft" targetRef="Gateway_QuestionsDuringCreation"/>
    
    <!-- Yes Path -->
    <bpmn:sequenceFlow id="SequenceFlow_ProvideClarificationsPath" name="Yes, questions exist" sourceRef="Gateway_QuestionsDuringCreation" targetRef="Task_ProvideClarifications"/>

    <!-- Loop back to Drafting -->
    <bpmn:sequenceFlow id="SequenceFlow_BackToDrafting" sourceRef="Task_ProvideClarifications" targetRef="Task_CreateJobDescriptionDraft"/>

    <!-- No Path (Ready for Review) -->
    <bpmn:sequenceFlow id="SequenceFlow_ReadyForReview" name="No questions, ready to review" sourceRef="Gateway_QuestionsDuringCreation" targetRef="Task_ReviewJobDescription"/>

    <!-- To Approval Gateway -->
    <bpmn:sequenceFlow id="SequenceFlow_ReviewToApproval" sourceRef="Task_ReviewJobDescription" targetRef="Gateway_ApprovalDecision"/>

    <!-- Approved Path -->
    <bpmn:sequenceFlow id="SequenceFlow_AdvertisePath" name="Approved" sourceRef="Gateway_ApprovalDecision" targetRef="Task_AdvertiseVacancy"/>

    <!-- Corrections Needed Path -->
    <bpmn:sequenceFlow id="SequenceFlow_CorrectionsNeeded" name="Corrections needed" sourceRef="Gateway_ApprovalDecision" targetRef="Task_ReviseJobDescription"/>

    <!-- Loop back to Approval Check after Revision (Simplified loop) -->
    <bpmn:sequenceFlow id="SequenceFlow_ReCheckApproval" sourceRef="Task_ReviseJobDescription" targetRef="Gateway_ApprovalDecision"/>

  </bpmn:process>
</bpmn:definitions>