<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_SwitchOverProcess">
    <bpmn:participant name="Customer Service (Sales &amp; Distribution)" processRef="Proc_CustomerService"/>
    <bpmn:participant name="CIS System" processRef="Proc_CISSystem"/>
    <bpmn:participant name="Grid Operator" processRef="Proc_GridOperator"/>
  </bpmn:collaboration>

  <!-- Customer Service Process -->
  <bpmn:process id="Proc_CustomerService">
    <bpmn:startEvent id="Start_SwitchOverRequest" name="Switch-over Request Initiated">
      <bpmn:outgoing>Seq_ReceiveCustomerData</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_ReceiveCustomerData" name="Receive Customer Data">
      <bpmn:incoming>Seq_ReceiveCustomerData</bpmn:incoming>
      <bpmn:outgoing>Seq_EnterCRMSystem</bpmn:outgoing>
    </bpmn:task>

    <bpmn:dataObject id="Data_CustomerObject" name="Customer Data Object"/>
    
    <bpmn:exclusiveGateway id="XGateway_DataValidation" name="Check Completeness &amp; Plausibility">
      <bpmn:incoming>XSeq_EnterCRMSystem</bpmn:incoming>
      <bpmn:outgoing>Seq_CorrectErrors</bpmn:outgoing>
      <bpmn:outgoing>Seq_CheckCustomerExists</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_AnalyzeErrorList" name="Analyze Error List">
      <bpmn:incoming>XSeq_CorrectErrors</bpmn:incoming>
      <bpmn:outgoing>Seq_EnterCRMSystemLoopback</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="End_Withdrawal" name="Process Ended (Withdrawal)">
      <bpmn:incoming>XSeq_ProcessEnded</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Message Flow to CIS System -->
  </bpmn:process>

  <!-- CIS System Process -->
  <bpmn:process id="Proc_CISSystem">
    <bpmn:startEvent id="Start_ContractCheck" name="Contract Check Request Received"/>

    <bpmn:task id="Task_AutomatedContractCheck" name="Automated Contract Document Check">
      <bpmn:incoming>Msg_ReceiveFromCustomerService</bpmn:incoming>
      <bpmn:outgoing>XGateway_CheckResult</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="End_GridOperatorProcess" name="Grid Operator Process Ended">
      <bpmn:incoming>XSeq_ProcessEnded</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>

  <!-- Grid Operator Process -->
  <bpmn:process id="Proc_GridOperator">
    <bpmn:startEvent id="Start_SwitchRequest" name="Switch-over Request Received"/>

    <bpmn:task id="Task_CheckSupplierConcurrence" name="Check Supplier Concurrence">
      <bpmn:incoming>Msg_ReceiveFromCustomerService</bpmn:incoming>
      <bpmn:outgoing>XGateway_ConcurrenceResult</bpmn:outgoing>
    </bpmn:task>

  </bpmn:process>

  <!-- Message Flows -->
  <bpmn:messageFlow id="Msg_ReceiveFromCustomerService" name="Contract Check Request">
    <bpmn:sourceRef>XSeq_PrepareContractDocuments</bpmn:sourceRef>
    <bpmn:targetRef>Task_AutomatedContractCheck</bpmn:targetRef>
  </bpmn:messageFlow>

  <!-- Sequence Flows -->
  <bpmn:sequenceFlow id="Seq_ReceiveCustomerData" sourceRef="Start_SwitchOverRequest" targetRef="Task_ReceiveCustomerData"/>
  <bpmn:sequenceFlow id="Seq_EnterCRMSystem" sourceRef="Task_ReceiveCustomerData" targetRef="XGateway_DataValidation"/>

</bpmn:definitions>