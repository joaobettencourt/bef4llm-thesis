<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_FaultProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_1">
    <bpmn:participant name="Fault Management Service" processRef="Proc_Fault"/>
  </bpmn:collaboration>

  <bpmn:process id="Proc_Fault" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="Start_1" name="Failure Reported/Suspected">
      <bpmn:outgoing>SF_ExamineFailure</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Examine Failure -->
    <bpmn:task id="Task_ExamineFailure" name="Examine Failure">
      <bpmn:incoming>SF_ExamineFailure</bpmn:incoming>
      <bpmn:outgoing>SF_DecideConfirm</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Confirm Decision -->
    <bpmn:exclusiveGateway id="GW_ConfirmDecision" name="Confirm Failure?">
      <bpmn:incoming>SF_ExamineFailure</bpmn:incoming>
      <bpmn:outgoing>SF_RejectFault</bpmn:outgoing>
      <bpmn:outgoing>SF_ContinueProcess</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event: Rejected -->
    <bpmn:endEvent id="End_Rejected" name="Rejected">
      <bpmn:incoming>SF_RejectFault</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Parallel Gateway Split 1 (Initial Notifications) -->
    <bpmn:parallelGateway id="GW_SplitNotifyFaults" name="Split Initial Notify">
      <bpmn:incoming>SF_ContinueProcess</bpmn:incoming>
      <bpmn:outgoing>SF_NotifyCustomerFault</bpmn:outgoing>
      <bpmn:outgoing>SF_NotifyManagerFault</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Notify Customer (Fault) -->
    <bpmn:task id="Task_NotifyCustomerFault" name="Inform Customer (Fault)">
      <bpmn:incoming>SF_NotifyCustomerFault</bpmn:incoming>
      <bpmn:outgoing>SF_JoinNotify1</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Notify Manager (Fault) -->
    <bpmn:task id="Task_NotifyManagerFault" name="Inform Manager (Fault)">
      <bpmn:incoming>SF_NotifyManagerFault</bpmn:incoming>
      <bpmn:outgoing>SF_JoinNotify1</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway Join 1 -->
    <bpmn:parallelGateway id="GW_JoinNotify1" name="Join Initial Notify">
      <bpmn:incoming>SF_NotifyCustomerFault</bpmn:incoming>
      <bpmn:incoming>SF_NotifyManagerFault</bpmn:incoming>
      <bpmn:outgoing>SF_FixFaultFlow</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Fix Fault -->
    <bpmn:task id="Task_FixFault" name="Fix Fault at Device">
      <bpmn:incoming>SF_FixFaultFlow</bpmn:incoming>
      <bpmn:outgoing>SF_ShareResultsDetector</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Share Results with Detector -->
    <bpmn:task id="Task_ShareResultsDetector" name="Share Repair Results">
      <bpmn:incoming>SF_ShareResultsDetector</bpmn:incoming>
      <bpmn:outgoing>SF_SplitFinalNotify</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway Split 2 (Resolution Notifications) -->
    <bpmn:parallelGateway id="GW_SplitFinalNotifications" name="Split Final Notify">
      <bpmn:incoming>SF_SplitFinalNotify</bpmn:incoming>
      <bpmn:outgoing>SF_NotifyCustomerRes</bpmn:outgoing>
      <bpmn:outgoing>SF_NotifyManagerRes</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Notify Customer (Resolution) -->
    <bpmn:task id="Task_NotifyCustomerResolution" name="Inform Customer (Resolution)">
      <bpmn:incoming>SF_NotifyCustomerRes</bpmn:incoming>
      <bpmn:outgoing>SF_JoinFinalNotify</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Notify Manager (Resolution) -->
    <bpmn:task id="Task_NotifyManagerResolution" name="Inform Manager (Resolution)">
      <bpmn:incoming>SF_NotifyManagerRes</bpmn:incoming>
      <bpmn:outgoing>SF_JoinFinalNotify</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway Join 2 -->
    <bpmn:parallelGateway id="GW_JoinFinalNotifications" name="Join Final Notify">
      <bpmn:incoming>SF_NotifyCustomerRes</bpmn:incoming>
      <bpmn:incoming>SF_NotifyManagerRes</bpmn:incoming>
      <bpmn:outgoing>SF_EndProcessFlow</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- End Event -->
    <bpmn:endEvent id="End_Completed" name="Resolution Reported">
      <bpmn:incoming>SF_EndProcessFlow</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>