<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_GO_Process">
    <bpmn:participant id="Pool_GovernmentOffice" name="Government Office (GO)" processRef="Process_Deregistration"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Deregistration" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_ReceiveDeregistration" name="MSPO Deregisters at GO">
      <bpmn:outgoing>SequenceFlow_VerifyRequest</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task -->
    <bpmn:task id="Task_VerifyDeregistration" name="Verify Deregistration of MSPO">
      <bpmn:incoming>SequenceFlow_VerifyRequest</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DecisionPoint</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway -->
    <bpmn:exclusiveGateway id="Gateway_Decision" name="Reject or Confirm?">
      <bpmn:incoming>SequenceFlow_DecisionPoint</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RejectPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ConfirmPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event (Reject) -->
    <bpmn:endEvent id="EndEvent_Rejected" name="Deregistration Rejected">
      <bpmn:incoming>SequenceFlow_RejectPath</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task (Assign MSP) -->
    <bpmn:task id="Task_AssignMSP" name="GO Assigns Himself as MSP">
      <bpmn:incoming>SequenceFlow_ConfirmPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SplitNotifications</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway (Split) -->
    <bpmn:parallelGateway id="Parallel_GatewaySplit" name="Inform Parties">
      <bpmn:incoming>SequenceFlow_SplitNotifications</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InformMSPO</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_InformMPO</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_InformSP</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task (Inform MSPO) -->
    <bpmn:task id="Task_InformMSPO" name="Inform MSPO about Assignment Change">
      <bpmn:incoming>SequenceFlow_InformMSPO</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_JoinNotifications</bpmn:outgoing>
    </bpmn:task>

    <!-- Task (Inform MPO) -->
    <bpmn:task id="Task_InformMPO" name="Inform MPO about GO Assignment">
      <bpmn:incoming>SequenceFlow_InformMPO</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_JoinNotifications</bpmn:outgoing>
    </bpmn:task>

    <!-- Task (Inform SP) -->
    <bpmn:task id="Task_InformSP" name="Inform SP about GO Assignment">
      <bpmn:incoming>SequenceFlow_InformSP</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_JoinNotifications</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway (Join) -->
    <bpmn:parallelGateway id="Parallel_GatewayJoin">
      <bpmn:incoming>SequenceFlow_JoinNotifications</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FinalizeProcess</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- End Event (Success) -->
    <bpmn:endEvent id="EndEvent_Completed" name="Assignment Processed">
      <bpmn:incoming>SequenceFlow_FinalizeProcess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_VerifyRequest" sourceRef="StartEvent_ReceiveDeregistration" targetRef="Task_VerifyDeregistration"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_DecisionPoint" name="Verification Complete" sourceRef="Task_VerifyDeregistration" targetRef="Gateway_Decision"/>

    <bpmn:sequenceFlow id="SequenceFlow_RejectPath" name="Reject Deregistration" sourceRef="Gateway_Decision" targetRef="EndEvent_Rejected"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ConfirmPath" name="Confirm Preliminarily" sourceRef="Gateway_Decision" targetRef="Task_AssignMSP"/>

    <bpmn:sequenceFlow id="SequenceFlow_SplitNotifications" sourceRef="Task_AssignMSP" targetRef="Parallel_GatewaySplit"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_InformMSPO" name="Inform MSPO" sourceRef="Parallel_GatewaySplit" targetRef="Task_InformMSPO"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_InformMPO" name="Inform MPO" sourceRef="Parallel_GatewaySplit" targetRef="Task_InformMPO"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_InformSP" name="Inform SP" sourceRef="Parallel_GatewaySplit" targetRef="Task_InformSP"/>

    <bpmn:sequenceFlow id="SequenceFlow_JoinNotifications" sourceRef="Task_InformMSPO" targetRef="Parallel_GatewayJoin"/>
    
    <!-- Note: Sequence flows from MPO and SP tasks also go to Join, but need explicit definitions for all incoming paths in BPMN 2.0 -->
    <bpmn:sequenceFlow id="SequenceFlow_JoinMPOPath" sourceRef="Task_InformMPO" targetRef="Parallel_GatewayJoin"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_JoinSPPath" sourceRef="Task_InformSP" targetRef="Parallel_GatewayJoin"/>

    <bpmn:sequenceFlow id="SequenceFlow_FinalizeProcess" name="All Notifications Sent" sourceRef="Parallel_GatewayJoin" targetRef="EndEvent_Completed"/>
    
  </bpmn:process>
</bpmn:definitions>