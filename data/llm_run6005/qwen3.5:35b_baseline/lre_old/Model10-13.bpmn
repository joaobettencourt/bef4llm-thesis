<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_INQ_IP_Process">
    <bpmn:participant id="Pool_INQ" name="INQ System" processRef="Proc_INQ"/>
    <bpmn:participant id="Pool_IP" name="IP System" processRef="Proc_IP"/>

    <!-- Message Flow 1: INQ Request to IP -->
    <bpmn:messageFlow id="MsgFlow_Request" sourceRef="Task_TransmitRequest" targetRef="StartEvent_ReceiveRequest"/>

    <!-- Message Flows for Answers back to INQ -->
    <bpmn:messageFlow id="MsgFlow_DataAnswer" sourceRef="EndEvent_DataTransmitted" targetRef="IntermediateCatch_AnswerReceived"/>
    <bpmn:messageFlow id="MsgFlow_RejectAnswer" sourceRef="EndEvent_Rejected" targetRef="IntermediateCatch_AnswerReceived"/>

  </bpmn:collaboration>

  <!-- Process for INQ -->
  <bpmn:process id="Proc_INQ">
    <bpmn:startEvent id="StartEvent_RequestInitiated" name="Request Initiated">
      <bpmn:outgoing>SequenceFlow_Transmit</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_TransmitRequest" name="Transmit Transaction Data Request">
      <bpmn:incoming>SequenceFlow_Transmit</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitAnswer</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_ProcessCompleted" name="Process Completed">
       <!-- Implicitly reached after receiving answer -->
    </bpmn:endEvent>

     <bpmn:intermediateCatchEvent id="IntermediateCatch_AnswerReceived" name="Receive Answer">
      <bpmn:incoming>SequenceFlow_WaitAnswer</bpmn:incoming> 
       <bpmn:outgoing>SequenceFlow_ProcessCompleted</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

     <bpmn:sequenceFlow id="SequenceFlow_Transmit" sourceRef="StartEvent_RequestInitiated" targetRef="Task_TransmitRequest"/>
     <bpmn:sequenceFlow id="SequenceFlow_WaitAnswer" sourceRef="Task_TransmitRequest" targetRef="IntermediateCatch_AnswerReceived"/>
     <bpmn:sequenceFlow id="SequenceFlow_ProcessCompleted" sourceRef="IntermediateCatch_AnswerReceived" targetRef="EndEvent_ProcessCompleted"/>

  </bpmn:process>

  <!-- Process for IP -->
  <bpmn:process id="Proc_IP">
    <bpmn:startEvent id="StartEvent_ReceiveRequest" name="Receive Request">
      <bpmn:outgoing>SequenceFlow_Check</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_CheckRequest" name="Check Request of INQ">
       <bpmn:incoming>SequenceFlow_Check</bpmn:incoming>
      <bpmn:outgoing>Gateway_ExaminationOutcome</bpmn:outgoing>
    </bpmn:task>

     <bpmn:exclusiveGateway id="Gateway_ExaminationOutcome" name="Examination Outcome">
       <bpmn:incoming>SequenceFlow_Check</bpmn:incoming> 
      <bpmn:outgoing>SeqPath_DataTransmitted</bpmn:outgoing>
        <bpmn:outgoing>SeqPath_Rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>

     <!-- Path 1: Transmission of Data -->
      <bpmn:endEvent id="EndEvent_DataTransmitted" name="Data Transmitted">
        <bpmn:incoming>SequenceFlow_PathToAnswer</bpmn:outgoing/> 
         <bpmn:incoming>SeqPath_DataTransmitted</bpmn:incoming>
      </bpmn:endEvent>

       <!-- Path 2: Rejected -->
     <bpmn:endEvent id="EndEvent_Rejected" name="Rejected">
        <bpmn:outgoing/> 
         <bpmn:incoming>SeqPath_Rejected</bpmn:incoming>
      </bpmn:endEvent>

    <!-- Sequence Flows within IP Process -->
     <bpmn:sequenceFlow id="SequenceFlow_Check" sourceRef="StartEvent_ReceiveRequest" targetRef="Task_CheckRequest"/>
       <bpmn:sequenceFlow id="SeqPath_DataTransmitted" name="Transmission of data" sourceRef="Gateway_ExaminationOutcome" targetRef="EndEvent_DataTransmitted"/>
        <bpmn:sequenceFlow id="SeqPath_Rejected" name="Rejected" sourceRef="Gateway_ExaminationOutcome" targetRef="EndEvent_Rejected"/>

  </bpmn:process>

</bpmn:definitions>