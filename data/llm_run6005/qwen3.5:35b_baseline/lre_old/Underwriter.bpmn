<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_IPO_Underwriting" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_IPO_Process">
    <bpmn:participant name="IPO Underwriting Process" processRef="Process_IPO_01"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_IPO_01" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_DecisionIPO" name="Decision to Go Public">
      <bpmn:outgoing>SequenceFlow_SelectUnderwriters</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Select Underwriters -->
    <bpmn:task id="Task_SelectUnderwriters" name="Select Underwriters">
      <bpmn:incoming>SequenceFlow_SelectUnderwriters</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FairnessCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Fairness Check -->
    <bpmn:exclusiveGateway id="Gateway_FairnessCheck" name="Facts Presented Fairly?">
      <bpmn:incoming>SequenceFlow_FairnessCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProceedToRegistration</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event 1: Rejected -->
    <bpmn:endEvent id="EndEvent_Rejected" name="Process Aborted">
      <bpmn:incoming>SequenceFlow_ReasonNotFair</bpmn:outgoing/> 
    </bpmn:endEvent>

    <!-- Sequence Flow for Fairness Check (No) -->
    <bpmn:sequenceFlow id="SequenceFlow_ReasonNotFair" name="no" sourceRef="Gateway_FairnessCheck" targetRef="EndEvent_Rejected"/>

    <!-- Parallel Split after Approval -->
    <bpmn:parallelGateway id="ParallelSplit_Processing">
      <bpmn:incoming>SequenceFlow_ProceedToRegistration</bpmn:outgoing/> 
      <bpmn:outgoing>Seq_PrepareRegStatement</bpmn:outgoing/> 
      <bpmn:outgoing>Seq_RoadShowFirmUp</bpmn:outgoing/>
    </bpmn:parallelGateway>

    <!-- Task 2: Prepare Registration Statement -->
    <bpmn:task id="Task_PrepareRegStatement" name="Prepare Registration Statement">
      <bpmn:incoming>Seq_PrepareRegStatement</bpmn:outgoing/> 
       <bpmn:outgoing>SequenceFlow_WaitSECApproval</bpmn:outgoing/> 
    </bpmn:task>

    <!-- Intermediate Event 1: SEC Clearance -->
    <bpmn:intermediateCatchEvent id="Event_SECApprovalReceived" name="SEC Clearance Received">
      <bpmn:incoming>SequenceFlow_WaitSECApproval</bpmn:outgoing/> 
       <bpmn:outgoing>Seq_ToMergePricesReady</bpmn:outgoing/> 
    </bpmn:intermediateCatchEvent>

    <!-- Task 3: Road Show / Firm Up Price Work -->
    <bpmn:task id="Task_RoadShowFirmUp" name="Road Show &amp; Firm Up Issue">
      <bpmn:incoming>Seq_RoadShowFirmUp</bpmn:outgoing/> 
       <bpmn:outgoing>SequenceFlow_ToMergePricesReady</bpmn:outgoing/> 
    </bpmn:task>

     <!-- Task 4: Check Blue-Sky Laws -->
    <bpmn:task id="Task_BlueSkyCheck" name="Check Blue-Sky Laws Compliance">
      <bpmn:incoming>Seq_BlueSkyCheck</bpmn:outgoing/> 
       <bpmn:outgoing>SequenceFlow_ToMergePricesReady</bpmn:outgoing/> 
    </bpmn:task>

     <!-- Parallel Merge Gateway -->
    <bpmn:parallelGateway id="ParallelMerge_PricesReady">
      <bpmn:incoming>Seq_ToMergePricesReady</bpmn:outgoing/> 
       <bpmn:outgoing>SequenceFlow_FixIssuePriceFinalize</bpmn:outgoing/> 
    </bpmn:parallelGateway>

     <!-- Task 5: Fix Issue Price (After Merge) -->
    <bpmn:task id="Task_FixIssuePrice" name="Fix Issue Price">
      <bpmn:incoming>SequenceFlow_ToMergePricesReady</bpmn:outgoing/> 
       <bpmn:outgoing>SequenceFlow_CheckReasonsNotToProceed</bpmn:outgoing/> 
    </bpmn:task>

     <!-- Gateway 2: Check Reasons Not To Proceed -->
    <bpmn:exclusiveGateway id="Gateway_ReasonCheck" name="Reason Not to Proceed?">
      <bpmn:incoming>SequenceFlow_CheckReasonsNotToProceed</bpmn:outgoing/> 
       <bpmn:outgoing>SequenceFlow_ProceedCommitment</bpmn:outgoing/> 
    </bpmn:exclusiveGateway>

     <!-- End Event 2: Cancelled -->
    <bpmn:endEvent id="EndEvent_Cancelled" name="Offer Stopped">
      <bpmn:incoming>SequenceFlow_ReasonExists</bpmn:outgoing/> 
       <bpmn:outgoing /> 
    </bpmn:endEvent>

     <!-- Sequence Flow for Reason Check (Yes) -->
    <bpmn:sequenceFlow id="SequenceFlow_ReasonExists" name="yes" sourceRef="Gateway_ReasonCheck" targetRef="EndEvent_Cancelled"/>

    <!-- Task 6: Enter Firm Commitment -->
    <bpmn:task id="Task_EnterCommitment" name="Enter Firm Commitment (Buy Stock)">
      <bpmn:incoming>SequenceFlow_ProceedCommitment</bpmn:outgoing/> 
       <bpmn:outgoing>SequenceFlow_OfferPublic</bpmn:outgoing/> 
    </bpmn:task>

     <!-- Task 7: Offer to Public -->
    <bpmn:task id="Task_OfferPublic" name="Offer Stock to Public">
      <bpmn:incoming>SequenceFlow_OfferPublic</bpmn:outgoing/> 
       <bpmn:outgoing>SequenceFlow_CompletedIPO</bpmn:outgoing/> 
    </bpmn:task>

     <!-- End Event 3: Completed -->
    <bpmn:endEvent id="EndEvent_IPOCompleted" name="Issue Sold">
      <bpmn:incoming>SequenceFlow_CompletedIPO</bpmn:outgoing/> 
       <bpmn:outgoing /> 
    </bpmn:endEvent>

     <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_SelectUnderwriters" sourceRef="StartEvent_DecisionIPO" targetRef="Task_SelectUnderwriters"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_FairnessCheck" name="yes" sourceRef="Task_SelectUnderwriters" targetRef="Gateway_FairnessCheck"/>

    <bpmn:sequenceFlow id="SequenceFlow_ProceedToRegistration" sourceRef="Gateway_FairnessCheck" targetRef="ParallelSplit_Processing"/>
    
    <!-- Parallel Branches -->
    <bpmn:sequenceFlow id="Seq_PrepareRegStatement" name="" sourceRef="ParallelSplit_Processing" targetRef="Task_PrepareRegStatement"/>
    <bpmn:sequenceFlow id="SequenceFlow_WaitSECApproval" sourceRef="Task_PrepareRegStatement" targetRef="Event_SECApprovalReceived"/>

    <bpmn:sequenceFlow id="Seq_RoadShowFirmUp" name="" sourceRef="ParallelSplit_Processing" targetRef="Task_RoadShowFirmUp"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ToMergePricesReady" sourceRef="Event_SECApprovalReceived" targetRef="ParallelMerge_PricesReady"/>

     <!-- Note: In BPMN, a Parallel Gateway merge requires all incoming flows to be active. 
          To ensure valid flow from Task_RoadShowFirmUp and Task_BlueSkyCheck into the Merge -->
    <bpmn:sequenceFlow id="Seq_FlowToMerge1" sourceRef="Task_RoadShowFirmUp" targetRef="ParallelMerge_PricesReady"/>
    <bpmn:sequenceFlow id="Seq_FlowToMerge2" sourceRef="Task_BlueSkyCheck" targetRef="ParallelMerge_PricesReady"/>

    <!-- Post Merge -->
    <bpmn:sequenceFlow id="SequenceFlow_FixIssuePriceFinalize" name="" sourceRef="ParallelMerge_PricesReady" targetRef="Task_FixIssuePrice"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_CheckReasonsNotToProceed" sourceRef="Task_FixIssuePrice" targetRef="Gateway_ReasonCheck"/>

    <!-- Commitment Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_ProceedCommitment" name="no reason not to proceed" sourceRef="Gateway_ReasonCheck" targetRef="Task_EnterCommitment"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_OfferPublic" sourceRef="Task_EnterCommitment" targetRef="Task_OfferPublic"/>

    <!-- Final Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_CompletedIPO" name="" sourceRef="Task_OfferPublic" targetRef="EndEvent_IPOCompleted"/>

  </bpmn:process>
</bpmn:definitions>