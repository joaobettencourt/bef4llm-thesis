<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_DismissalProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_DismissalInteraction">
    <bpmn:participant id="Participant_MPON" name="MPON" processRef="Proc_Mpon_Send"/>
    <bpmn:participant id="Participant_MPOO" name="MPOO" processRef="Proc_Mpoo_Review"/>
    <bpmn:messageFlow id="MessageFlow_DismissalSend">
      <bpmn:sourceElement>Task_SendDismissal</bpmn:sourceElement>
      <bpmn:targetElement>StartEvent_ReceivedDismissing</bpmn:targetElement>
    </bpmn:messageFlow>
  </bpmn:collaboration>

  <bpmn:process id="Proc_Mpon_Send" isExecutable="false">
    <bpmn:startEvent id="StartEvent_InitiateDismissal" name="Initiate Dismissal Process">
      <bpmn:outgoing>SequenceFlow_StartToTask</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_SendDismissal" name="Send Dismissal to MPOO">
      <bpmn:incoming>SequenceFlow_StartToTask</bpmn:incoming>
      <bpmn:outgoing>MessageFlow_DismissalSend</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="End_Task_Mpon" name="Dismissal Sent">
      <bpmn:incoming>SequenceFlow_StartToTask</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:message id="Message_DismissalNotification"/>
  </bpmn:process>

  <bpmn:process id="Proc_Mpoo_Review" isExecutable="false">
    <bpmn:startEvent id="StartEvent_ReceivedDismissing" name="Receive Dismissal Request">
      <bpmn:messageRef>bpmnMessage_DismissalNotification</bpmn:messageRef>
      <bpmn:outgoing>SequenceFlow_StartToReviewTask</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_ReviewDismissal" name="Review Dismissal">
      <bpmn:incoming>SequenceFlow_StartToReviewTask</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReviewToGateway</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="XGateway_DecisionOutcome" name="Decision on Dismissal">
      <bpmn:incoming>SequenceFlow_ReviewToGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OpposeDismissal</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ConfirmDismissal</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="EndEvent_DismissalOpposed" name="Dismissing Opposed">
      <bpmn:incoming>SequenceFlow_OpposeDismissal</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_DismissalConfirmed" name="Dismissing Confirmed">
      <bpmn:incoming>SequenceFlow_ConfirmDismissal</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow_StartToTask" sourceRef="StartEvent_InitiateDismissal" targetRef="Task_SendDismissal"/>
    <bpmn:sequenceFlow id="SequenceFlow_StartToReviewTask" name="Proceed to Review" sourceRef="StartEvent_ReceivedDismissing" targetRef="Task_ReviewDismissal"/>
    <bpmn:sequenceFlow id="SequenceFlow_ReviewToGateway" sourceRef="Task_ReviewDismissal" targetRef="XGateway_DecisionOutcome"/>
    <bpmn:sequenceFlow id="SequenceFlow_OpposeDismissal" name="Opposes Dismissal" sourceRef="XGateway_DecisionOutcome" targetRef="EndEvent_DismissalOpposed"/>
    <bpmn:sequenceFlow id="SequenceFlow_ConfirmDismissal" name="Confirms Dismissal" sourceRef="XGateway_DecisionOutcome" targetRef="EndEvent_DismissalConfirmed"/>

  </bpmn:process>

</bpmn:definitions>