<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_MeetingProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="Pool_Process" name="Meeting Management Process" processRef="Proc_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Proc_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_CoordUnit" name="Coordination Unit">
        <bpmn:flowNodeRef>Task_QA_Check</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SupportOffice" name="Support Office">
        <bpmn:flowNodeRef>StartEvent_DatesFinalized</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateCalendars</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateFolders</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UploadDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyMembers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProduceMinutes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendMinutes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateRecords</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Committee" name="Committee Members">
        <bpmn:flowNodeRef>Task_HoldMeeting</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_DatesFinalized" name="Dates Finalized">
       <bpmn:outgoing>SequenceFlow_StartToCalendars</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Support Office Tasks (Preparation) -->
    <bpmn:task id="Task_UpdateCalendars" name="Update Group Calendars">
      <bpmn:incoming>SequenceFlow_StartToCalendars</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CalendarsToFolders</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_CreateFolders" name="Create Meeting Folders">
      <bpmn:incoming>SequenceFlow_CalendarsToFolders</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FoldersToDocs</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_UploadDocs" name="Ensure Documents Uploaded">
      <bpmn:incoming>SequenceFlow_FoldersToDocs</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DocsToNotify</bpmn:outgoing>
    </bpmn:task>

    <!-- Notification -->
    <bpmn:task id="Task_NotifyMembers" name="Advise Committee Members">
       <bpmn:description>A week before meeting to read documents</bpmn:description>
      <bpmn:incoming>SequenceFlow_DocsToNotify</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NotifyToMeeting</bpmn:outgoing>
    </bpmn:task>

    <!-- Committee Meeting -->
    <bpmn:task id="Task_HoldMeeting" name="Hold Committee Meeting">
       <bpmn:description>Committee Members hold meeting</bpmn:description>
      <bpmn:incoming>SequenceFlow_NotifyToMeeting</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MeetingToMinutes</bpmn:outgoing>
    </bpmn:task>

    <!-- Minutes Production -->
    <bpmn:task id="Task_ProduceMinutes" name="Produce Minutes &amp; Action Points">
       <bpmn:description>Including any Action Points for each Committee Member</bpmn:description>
      <bpmn:incoming>SequenceFlow_MeetingToMinutes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MinutesToQA</bpmn:outgoing>
    </bpmn:task>

    <!-- QA Check -->
    <bpmn:task id="Task_QA_Check" name="Conduct QA Check on Minutes">
       <bpmn:description>Within 5 working days of minutes production</bpmn:description>
      <bpmn:incoming>SequenceFlow_MinutesToQA</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_QAToSendMinutes</bpmn:outgoing>
    </bpmn:task>

    <!-- Send Minutes -->
    <bpmn:task id="Task_SendMinutes" name="Send Minutes to Committee Members">
       <bpmn:description>Sent after QA check approval</bpmn:description>
      <bpmn:incoming>SequenceFlow_QAToSendMinutes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MinutesToRecordsUpdate</bpmn:outgoing>
    </bpmn:task>

    <!-- Final Update -->
    <bpmn:task id="Task_UpdateRecords" name="Update Departmental Records">
       <bpmn:description>Final step by Support Officer</bpmn:description>
      <bpmn:incoming>SequenceFlow_MinutesToRecordsUpdate</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RecordsToEnd</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="End_Event_Complete" name="Process Complete">
       <bpmn:description>All records updated and minutes distributed</bpmn:description>
      <bpmn:incoming>SequenceFlow_RecordsToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToCalendars" sourceRef="StartEvent_DatesFinalized" targetRef="Task_UpdateCalendars"/>
    <bpmn:sequenceFlow id="SequenceFlow_CalendarsToFolders" sourceRef="Task_UpdateCalendars" targetRef="Task_CreateFolders"/>
    <bpmn:sequenceFlow id="SequenceFlow_FoldersToDocs" sourceRef="Task_CreateFolders" targetRef="Task_UploadDocs"/>
    <bpmn:sequenceFlow id="SequenceFlow_DocsToNotify" sourceRef="Task_UploadDocs" targetRef="Task_NotifyMembers"/>
    <bpmn:sequenceFlow id="SequenceFlow_NotifyToMeeting" sourceRef="Task_NotifyMembers" targetRef="Task_HoldMeeting"/>
    <bpmn:sequenceFlow id="SequenceFlow_MeetingToMinutes" sourceRef="Task_HoldMeeting" targetRef="Task_ProduceMinutes"/>
    <bpmn:sequenceFlow id="SequenceFlow_MinutesToQA" sourceRef="Task_ProduceMinutes" targetRef="Task_QA_Check"/>
    <bpmn:sequenceFlow id="SequenceFlow_QAToSendMinutes" sourceRef="Task_QA_Check" targetRef="Task_SendMinutes"/>
    <bpmn:sequenceFlow id="SequenceFlow_MinutesToRecordsUpdate" sourceRef="Task_SendMinutes" targetRef="Task_UpdateRecords"/>
    <bpmn:sequenceFlow id="SequenceFlow_RecordsToEnd" sourceRef="Task_UpdateRecords" targetRef="End_Event_Complete"/>

  </bpmn:process>
</bpmn:definitions>