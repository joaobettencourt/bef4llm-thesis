<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="BlizzardOnlineCharacterGenerator"
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <process id="Process_1" isExecutable="false">
    <startEvent id="StartEvent_1" name="New WoW character wanted">
      <outgoing>SequenceFlow_0</outgoing>
    </startEvent>

    <serviceTask id="ServiceTask_1" name="Check existence of battle.net account"
                 implementation="##WebService">
      <incoming>SequenceFlow_0</incoming>
      <outgoing>SequenceFlow_1</outgoing>
    </serviceTask>

    <exclusiveGateway id="ExclusiveGateway_1" gatewayDirection="Diverging" name="battle.net account exists?">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
      <outgoing>SequenceFlow_3</outgoing>
    </exclusiveGateway>

    <serviceTask id="ServiceTask_2" name="Receive email with confirmation link"
                 implementation="##WebService">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_4</outgoing>
    </serviceTask>

    <manualTask id="ManualTask_1" name="Confirm account information via email link">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_5</outgoing>
    </manualTask>

    <exclusiveGateway id="ExclusiveGateway_2" gatewayDirection="Converging" name="">
      <incoming>SequenceFlow_3</incoming>
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </exclusiveGateway>

    <serviceTask id="ServiceTask_3" name="Check availablity of character name"
                 implementation="##WebService">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </serviceTask>

    <exclusiveGateway id="ExclusiveGateway_3" gatewayDirection="Diverging" name="Character name available?">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_8</outgoing>
      <outgoing>SequenceFlow_9</outgoing>
    </exclusiveGateway>

    <serviceTask id="ServiceTask_4" name="Receive confirmation and character selfies"
                 implementation="##WebService">
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_10</outgoing>
    </serviceTask>

    <endEvent id="EndEvent_1" name="Character created">
      <incoming>SequenceFlow_10</incoming>
    </endEvent>

    <sequenceFlow id="SequenceFlow_0" sourceRef="StartEvent_1" targetRef="ServiceTask_1"/>
    <sequenceFlow id="SequenceFlow_1" sourceRef="ServiceTask_1" targetRef="ExclusiveGateway_1"/>
    <sequenceFlow id="SequenceFlow_2" sourceRef="ExclusiveGateway_1" targetRef="ServiceTask_2"/>
    <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_1" targetRef="ManualTask_1"/>
    <sequenceFlow id="SequenceFlow_4" sourceRef="ServiceTask_2" targetRef="ManualTask_1"/>
    <sequenceFlow id="SequenceFlow_5" sourceRef="ManualTask_1" targetRef="ExclusiveGateway_2"/>
    <sequenceFlow id="SequenceFlow_6" sourceRef="ExclusiveGateway_2" targetRef="ServiceTask_3"/>
    <sequenceFlow id="SequenceFlow_7" sourceRef="ServiceTask_3" targetRef="ExclusiveGateway_3"/>
    <sequenceFlow id="SequenceFlow_8" sourceRef="ExclusiveGateway_3" targetRef="ServiceTask_4"/>
    <sequenceFlow id="SequenceFlow_9" sourceRef="ExclusiveGateway_3" targetRef="EndEvent_1"/>
    <sequenceFlow id="SequenceFlow_10" sourceRef="ServiceTask_4" targetRef="EndEvent_1"/>
  </process>
</bpmn:definitions>