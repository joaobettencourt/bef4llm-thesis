<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_0geryc1">
    <bpmn:participant id="Participant_0ygkg4f" name="Machine Inspection Application" processRef="Process_1"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Enter machine type and serial number">
      <bpmn:outgoing>SequenceFlow_0iu9po7</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask_1" name="Choose configuration">
      <bpmn:incoming>SequenceFlow_0iu9po7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1j94oja</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask_1" name="Print error codes">
      <bpmn:incoming>SequenceFlow_1j94oja</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0kz5g1t</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway_1" name="Error exists?">
      <bpmn:incoming>SequenceFlow_0kz5g1t</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2j94oja</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_3j94oja</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask_2" name="Turn off testing device">
      <bpmn:incoming>SequenceFlow_2j94oja</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4j94oja</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask_2" name="Read error codes">
      <bpmn:incoming>SequenceFlow_3j94oja</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5j94oja</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UserTask_3" name="Perform test run">
      <bpmn:incoming>SequenceFlow_4j94oja</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6j94oja</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_1" name="Inspection completed">
      <bpmn:incoming>SequenceFlow_5j94oja</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_6j94oja</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow_0iu9po7" sourceRef="StartEvent_1" targetRef="UserTask_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_1j94oja" sourceRef="UserTask_1" targetRef="ServiceTask_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_2j94oja" sourceRef="ExclusiveGateway_1" targetRef="UserTask_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_3j94oja" sourceRef="ExclusiveGateway_1" targetRef="ServiceTask_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_4j94oja" sourceRef="UserTask_2" targetRef="UserTask_3"/>
    <bpmn:sequenceFlow id="SequenceFlow_5j94oja" sourceRef="ServiceTask_2" targetRef="EndEvent_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_6j94oja" sourceRef="UserTask_3" targetRef="EndEvent_1"/>
  </bpmn:process>
</bpmn:definitions>