<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/BPMN20.xsd">
  <bpmn:process id="InstructArtistToCreate3DModelPrintItOn3DPrinter" isExecutable="false">
    <startEvent id="StartEvent_1" name="Start">
      <outgoing>SequenceFlow_ID_0</outgoing>
    </startEvent>
    <sequenceFlow id="SequenceFlow_ID_0" sourceRef="StartEvent_1" targetRef="UserTask_1"/>
    <userTask id="UserTask_1" name="Instruct an artist to create a 3D model">
      <incoming>SequenceFlow_ID_0</incoming>
      <outgoing>SequenceFlow_ID_1</outgoing>
    </userTask>
    <sequenceFlow id="SequenceFlow_ID_1" sourceRef="UserTask_1" targetRef="ExclusiveGateway_1"/>
    <exclusiveGateway id="ExclusiveGateway_1" gatewayDirection="Diverging" name="Have you the color at home?">
      <incoming>SequenceFlow_ID_1</incoming>
      <outgoing>SequenceFlow_ID_2</outgoing>
      <outgoing>SequenceFlow_ID_3</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_ID_2" sourceRef="ExclusiveGateway_1" targetRef="UserTask_2"/>
    <userTask id="UserTask_2" name="Tell artist what to change">
      <incoming>SequenceFlow_ID_2</incoming>
      <outgoing>SequenceFlow_ID_4</outgoing>
    </userTask>
    <sequenceFlow id="SequenceFlow_ID_3" sourceRef="ExclusiveGateway_1" targetRef="UserTask_3"/>
    <userTask id="UserTask_3" name="Choose a plastic color for model">
      <incoming>SequenceFlow_ID_3</incoming>
      <outgoing>SequenceFlow_ID_5</outgoing>
    </userTask>
    <sequenceFlow id="SequenceFlow_ID_4" sourceRef="UserTask_2" targetRef="ExclusiveGateway_2"/>
    <exclusiveGateway id="ExclusiveGateway_2" gatewayDirection="Diverging" name="Satisfied with the result?">
      <incoming>SequenceFlow_ID_4</incoming>
      <outgoing>SequenceFlow_ID_6</outgoing>
      <outgoing>SequenceFlow_ID_7</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_ID_5" sourceRef="UserTask_3" targetRef="ExclusiveGateway_3"/>
    <exclusiveGateway id="ExclusiveGateway_3" gatewayDirection="Diverging" name="Is it under 100 grams?">
      <incoming>SequenceFlow_ID_5</incoming>
      <outgoing>SequenceFlow_ID_8</outgoing>
      <outgoing>SequenceFlow_ID_9</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_ID_6" sourceRef="ExclusiveGateway_2" targetRef="UserTask_4"/>
    <userTask id="UserTask_4" name="Put it on your shopping list">
      <incoming>SequenceFlow_ID_6</incoming>
      <outgoing>SequenceFlow_ID_10</outgoing>
    </userTask>
    <sequenceFlow id="SequenceFlow_ID_7" sourceRef="ExclusiveGateway_2" targetRef="UserTask_5"/>
    <userTask id="UserTask_5" name="Order it">
      <incoming>SequenceFlow_ID_7</incoming>
      <outgoing>SequenceFlow_ID_11</outgoing>
    </userTask>
    <sequenceFlow id="SequenceFlow_ID_8" sourceRef="ExclusiveGateway_3" targetRef="UserTask_6"/>
    <userTask id="UserTask_6" name="Put it on your shopping list">
      <incoming>SequenceFlow_ID_8</incoming>
      <outgoing>SequenceFlow_ID_12</outgoing>
    </userTask>
    <sequenceFlow id="SequenceFlow_ID_9" sourceRef="ExclusiveGateway_3" targetRef="UserTask_7"/>
    <userTask id="UserTask_7" name="Order it">
      <incoming>SequenceFlow_ID_9</incoming>
      <outgoing>SequenceFlow_ID_13</outgoing>
    </userTask>
    <sequenceFlow id="SequenceFlow_ID_10" sourceRef="UserTask_4" targetRef="ExclusiveGateway_4"/>
    <exclusiveGateway id="ExclusiveGateway_4" gatewayDirection="Converging" name="">
      <incoming>SequenceFlow_ID_10</incoming>
      <incoming>SequenceFlow_ID_14</incoming>
      <outgoing>SequenceFlow_ID_15</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_ID_11" sourceRef="UserTask_5" targetRef="ExclusiveGateway_4"/>
    <sequenceFlow id="SequenceFlow_ID_12" sourceRef="UserTask_6" targetRef="ExclusiveGateway_4"/>
    <sequenceFlow id="SequenceFlow_ID_13" sourceRef="UserTask_7" targetRef="ExclusiveGateway_4"/>
    <serviceTask id="ServiceTask_1" name="Program generates gcode file from STL">
      <incoming>SequenceFlow_ID_15</incoming>
      <outgoing>SequenceFlow_ID_16</outgoing>
    </serviceTask>
    <sequenceFlow id="SequenceFlow_ID_14" sourceRef="UserTask_4" targetRef="ServiceTask_1"/>
    <parallelGateway id="ParallelGateway_1" gatewayDirection="Diverging" name="">
      <incoming>SequenceFlow_ID_16</incoming>
      <outgoing>SequenceFlow_ID_17</outgoing>
      <outgoing>SequenceFlow_ID_18</outgoing>
      <outgoing>SequenceFlow_ID_19</outgoing>
      <outgoing>SequenceFlow_ID_20</outgoing>
    </parallelGateway>
    <sequenceFlow id="SequenceFlow_ID_15" sourceRef="ExclusiveGateway_4" targetRef="ServiceTask_1"/>
    <serviceTask id="ServiceTask_2" name="Program executed printing">
      <incoming>SequenceFlow_ID_17</incoming>
      <outgoing>SequenceFlow_ID_21</outgoing>
    </serviceTask>
    <sequenceFlow id="SequenceFlow_ID_16" sourceRef="ServiceTask_1" targetRef="ParallelGateway_1"/>
    <endEvent id="EndEvent_1" name="End">
      <incoming>SequenceFlow_ID_21</incoming>
    </endEvent>
  </bpmn:process>
</bpmn:definitions>