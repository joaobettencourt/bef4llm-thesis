<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/BPMN20.xsd">
  <bpmn:process id="AppForParticipatingAtTheViennaNightRun" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Participate Night Run">
      <bpmn:outgoing>SequenceFlow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_2" name="Select starting block">
      <bpmn:incoming>SequenceFlow_0</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="ParallelGateway_3" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_5" name="Run 5 km">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="ExclusiveGateway_7" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_8</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_11" name="Stop to measure the time">
      <bpmn:incoming>SequenceFlow_8</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="ParallelGateway_13" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow_12</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_14</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_16</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_17" name="Get total running time">
      <bpmn:incoming>SequenceFlow_16</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="ExclusiveGateway_19" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow_18</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_20</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_23" name="Satisfied with the result">
      <bpmn:incoming>SequenceFlow_20</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_24</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_25" name="Do Training">
      <bpmn:incoming>SequenceFlow_22</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_26</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="ExclusiveGateway_27" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow_24</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_28</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_30</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_31" name="Get starting number">
      <bpmn:incoming>SequenceFlow_28</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_32</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="ExclusiveGateway_33" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow_30</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_34</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_36</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_37" name="Go to the run from home">
      <bpmn:incoming>SequenceFlow_34</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_38</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_39" name="Go directly after work to the run">
      <bpmn:incoming>SequenceFlow_36</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_40</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="ExclusiveGateway_41" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow_38</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_40</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_42</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="ParallelGateway_43" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow_42</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_44</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_46</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_47" name="Run the night run">
      <bpmn:incoming>SequenceFlow_44</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_48</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_49" name="Drink iso sport">
      <bpmn:incoming>SequenceFlow_46</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_50</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="ParallelGateway_51" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow_48</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_50</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_52</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_53" name="Receive final running time">
      <bpmn:incoming>SequenceFlow_52</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_54</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_55" name="Run finished">
      <bpmn:incoming>SequenceFlow_54</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:sequenceFlow id="SequenceFlow_0" sourceRef="StartEvent_1" targetRef="Task_2"/>
  <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="Task_2" targetRef="ParallelGateway_3"/>
  <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="ParallelGateway_3" targetRef="Task_5"/>
  <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="ParallelGateway_3" targetRef="ExclusiveGateway_7"/>
  <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="Task_5" targetRef="ExclusiveGateway_7"/>
  <bpmn:sequenceFlow id="SequenceFlow_8" sourceRef="ExclusiveGateway_7" targetRef="Task_11"/>
  <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="ExclusiveGateway_7" targetRef="ParallelGateway_13"/>
  <bpmn:sequenceFlow id="SequenceFlow_12" sourceRef="Task_11" targetRef="ParallelGateway_13"/>
  <bpmn:sequenceFlow id="SequenceFlow_14" sourceRef="ParallelGateway_13" targetRef="Task_17"/>
  <bpmn:sequenceFlow id="SequenceFlow_16" sourceRef="ParallelGateway_13" targetRef="ExclusiveGateway_19"/>
  <bpmn:sequenceFlow id="SequenceFlow_18" sourceRef="Task_17" targetRef="ExclusiveGateway_19"/>
  <bpmn:sequenceFlow id="SequenceFlow_20" sourceRef="ExclusiveGateway_19" targetRef="Task_23"/>
  <bpmn:sequenceFlow id="SequenceFlow_22" sourceRef="ExclusiveGateway_19" targetRef="Task_25"/>
  <bpmn:sequenceFlow id="SequenceFlow_24" sourceRef="Task_23" targetRef="ExclusiveGateway_27"/>
  <bpmn:sequenceFlow id="SequenceFlow_26" sourceRef="Task_25" targetRef="ExclusiveGateway_27"/>
  <bpmn:sequenceFlow id="SequenceFlow_28" sourceRef="ExclusiveGateway_27" targetRef="Task_31"/>
  <bpmn:sequenceFlow id="SequenceFlow_30" sourceRef="ExclusiveGateway_27" targetRef="ExclusiveGateway_33"/>
  <bpmn:sequenceFlow id="SequenceFlow_32" sourceRef="Task_31" targetRef="ExclusiveGateway_33"/>
  <bpmn:sequenceFlow id="SequenceFlow_34" sourceRef="ExclusiveGateway_33" targetRef="Task_37"/>
  <bpmn:sequenceFlow id="SequenceFlow_36" sourceRef="ExclusiveGateway_33" targetRef="Task_39"/>
  <bpmn:sequenceFlow id="SequenceFlow_38" sourceRef="Task_37" targetRef="ExclusiveGateway_41"/>
  <bpmn:sequenceFlow id="SequenceFlow_40" sourceRef="Task_39" targetRef="ExclusiveGateway_41"/>
  <bpmn:sequenceFlow id="SequenceFlow_42" sourceRef="ExclusiveGateway_41" targetRef="ParallelGateway_43"/>
  <bpmn:sequenceFlow id="SequenceFlow_44" sourceRef="ParallelGateway_43" targetRef="Task_47"/>
  <bpmn:sequenceFlow id="SequenceFlow_46" sourceRef="ParallelGateway_43" targetRef="Task_49"/>
  <bpmn:sequenceFlow id="SequenceFlow_48" sourceRef="Task_47" targetRef="ParallelGateway_51"/>
  <bpmn:sequenceFlow id="SequenceFlow_50" sourceRef="Task_49" targetRef="ParallelGateway_51"/>
  <bpmn:sequenceFlow id="SequenceFlow_52" sourceRef="ParallelGateway_51" targetRef="Task_53"/>
  <bpmn:sequenceFlow id="SequenceFlow_54" sourceRef="Task_53" targetRef="EndEvent_55"/>
</bpmn:definitions>