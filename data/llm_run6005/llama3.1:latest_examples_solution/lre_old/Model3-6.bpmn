        <bpmn:flowNodeRef>Task_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:sequenceFlow id="SequenceFlow_11" sourceRef="Task_5" targetRef="EndEvent_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="ExclusiveGateway_1" targetRef="Task_3"/>
    <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="ExclusiveGateway_2" targetRef="Task_5"/>
