    <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="Task_1" targetRef="EndEvent_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_8" sourceRef="Task_4" targetRef="ExclusiveGateway_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="ExclusiveGateway_0" targetRef="Task_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_9" sourceRef="ExclusiveGateway_2" targetRef="ExclusiveGateway_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_0" sourceRef="StartEvent_1" targetRef="Task_0"/>
    <bpmn:startEvent name="" id="StartEvent_1">
      <bpmn:outgoing>SequenceFlow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task name="Check customer details" id="Task_0">
      <bpmn:incoming>SequenceFlow_0</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway name="" id="ExclusiveGateway_0">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
