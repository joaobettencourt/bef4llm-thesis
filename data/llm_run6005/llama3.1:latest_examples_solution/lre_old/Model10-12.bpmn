<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_0" name="EC" processRef="Pool_0"/>
    <bpmn:participant id="Participant_1" name="INQ" processRef="Pool_1"/>
    <bpmn:participant id="Participant_2" name="IP" processRef="Pool_2"/>
  </bpmn:collaboration>
  <bpmn:process id="Pool_0" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_0" name="">
        <bpmn:flowNodeRef>StartNoneEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndMessageEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent name="" id="StartNoneEvent_1">
      <bpmn:outgoing>SequenceFlow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task name="Inform" id="Task_0">
      <bpmn:incoming>SequenceFlow_0</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent name="" id="EndMessageEvent_1">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:process id="Pool_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_1" name="">
        <bpmn:flowNodeRef>StartMessageEvent_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndNoneEvent_0</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent name="" id="StartMessageEvent_0">
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task name="Notify about change" id="Task_1">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent name="" id="EndNoneEvent_0">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:process id="Pool_2" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_2" name="">
        <bpmn:flowNodeRef>StartMessageEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Exclusive_Databased_Gateway_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent name="" id="StartMessageEvent_1">
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task name="Check" id="Task_2">
      <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway name="" id="Exclusive_Databased_Gateway_0">
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task name="Confirm" id="Task_3">
      <bpmn:incoming>SequenceFlow_7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_9</bpmn:outgoing>
    </bpmn:task>
  </bpmn:process>
  <bpmn:messageFlow id="MessageFlow_0" sourceRef="IntermediateMessageEventThrowing_1" targetRef="StartMessageEvent_1"/>
  <bpmn:messageFlow id="MessageFlow_1" sourceRef="Task_2" targetRef="IntermediateMessageEventCatching_0"/>
</bpmn:definitions>