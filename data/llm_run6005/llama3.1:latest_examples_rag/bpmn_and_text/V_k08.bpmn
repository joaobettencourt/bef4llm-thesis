<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
             targetNamespace="http://bpmn.io/schema/bpmn"
             id="Definitions_1"
             name="Ordering in an Online Shop">
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Login">
      <bpmn:outgoing>SequenceFlow_14a0oky</bpmn:outgoing>
    </bpmn:startEvent>
    <exclusiveGateway id="ExclusiveGateway_0p2e5vq"
                       gatewayDirection="Diverging"
                       name="Was login successful?">
      <bpmn:incoming>SequenceFlow_1j94oja</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_14a0oky</bpmn:outgoing>
    </exclusiveGateway>
    <serviceTask id="ServiceTask_12j0pib"
                 implementation="##WebService"
                 isForCompensation="false"
                 name="Select products">
      <bpmn:incoming>SequenceFlow_1dlbln9</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0kz5g1t</bpmn:outgoing>
    </serviceTask>
    <exclusiveGateway id="ExclusiveGateway_1dgb4sg"
                       gatewayDirection="Diverging"
                       name="Was product added to shopping cart?">
      <bpmn:incoming>SequenceFlow_0kz5g1t</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_023hzxi</bpmn:outgoing>
    </exclusiveGateway>
    <serviceTask id="ServiceTask_05ftug5"
                 implementation="##WebService"
                 isForCompensation="false"
                 name="Save product">
      <bpmn:incoming>SequenceFlow_023hzxi</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0mp5byl</bpmn:outgoing>
    </serviceTask>
    <exclusiveGateway id="ExclusiveGateway_1ouv9kf"
                       gatewayDirection="Diverging"
                       name="Was all products selected?">
      <bpmn:incoming>SequenceFlow_0mp5byl</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_035vf60</bpmn:outgoing>
    </exclusiveGateway>
    <serviceTask id="ServiceTask_0e6hvnj"
                 implementation="##WebService"
                 isForCompensation="false"
                 name="Payment confirmation">
      <bpmn:incoming>SequenceFlow_035vf60</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0v64x8b</bpmn:outgoing>
    </serviceTask>
    <exclusiveGateway id="ExclusiveGateway_1mpgzhg"
                       gatewayDirection="Diverging"
                       name="Was payment and shipping address entered?">
      <bpmn:incoming>SequenceFlow_0v64x8b</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_06kfaev</bpmn:outgoing>
    </exclusiveGateway>
    <endEvent id="EndEvent_1fx9yp3" name="Order was shipped">
      <bpmn:incoming>SequenceFlow_0v64x8b</bpmn:incoming>
    </endEvent>
  </bpmn:process>
</bpmn:definitions>