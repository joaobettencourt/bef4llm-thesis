<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <bpmn:process id="Building a House" isExecutable="false">
    <bpmn:startEvent id="Start_Event">
      <bpmn:outgoing>Sequence Flow_0</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Collect requirements -->
    <bpmn:userTask id="Collect_Requirements" name="Collect Requirements">
      <bpmn:incoming>Sequence Flow_0</bpmn:incoming>
      <bpmn:outgoing>Sequence Flow_1</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Send requirements to architect -->
    <bpmn:sequenceFlow id="Sequence_Flow_1" sourceRef="Collect_Requirements" targetRef="Send_Requirements_to_Architect"/>

    <!-- Receive draft from architect -->
    <bpmn:userTask id="Receive_Draft" name="Receive Draft">
      <bpmn:incoming>Sequence Flow_1</bpmn:incoming>
      <bpmn:outgoing>Sequence Flow_2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Refine draft -->
    <bpmn:sequenceFlow id="Sequence_Flow_2" sourceRef="Receive_Draft" targetRef="Refine_Draft"/>

    <!-- Create list of needed materials -->
    <bpmn:userTask id="Create_List_of_Needed_Materials" name="Create List of Needed Materials">
      <bpmn:incoming>Sequence Flow_2</bpmn:incoming>
      <bpmn:outgoing>Sequence Flow_3</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Order materials -->
    <bpmn:sequenceFlow id="Sequence_Flow_3" sourceRef="Create_List_of_Needed_Materials" targetRef="Order_Materials"/>

    <!-- Send messages to friends -->
    <bpmn:userTask id="Send_Messages_to_Friends" name="Send Messages to Friends">
      <bpmn:incoming>Sequence Flow_3</bpmn:incoming>
      <bpmn:outgoing>Sequence Flow_4</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Build house -->
    <bpmn:sequenceFlow id="Sequence_Flow_4" sourceRef="Send_Messages_to_Friends" targetRef="Build_House"/>

    <!-- Send invitations for treehouse party -->
    <bpmn:userTask id="Send_Invitations_for_Treehouse_Party" name="Send Invitations for Treehouse Party">
      <bpmn:incoming>Sequence Flow_4</bpmn:incoming>
      <bpmn:outgoing>Sequence Flow_5</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Create list of people attending party -->
    <bpmn:sequenceFlow id="Sequence_Flow_5" sourceRef="Send_Invitations_for_Treehouse_Party" targetRef="Create_List_of_People_Attending_Party"/>

    <!-- Buy snacks for party -->
    <bpmn:endEvent id="End_Event">
      <bpmn:incoming>Sequence Flow_5</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>