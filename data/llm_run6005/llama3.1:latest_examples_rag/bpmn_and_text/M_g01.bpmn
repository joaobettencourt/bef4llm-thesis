<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_1"
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Instruct artist to create a 3D model">
      <bpmn:outgoing>SequenceFlow_0</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Sequence Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_0" sourceRef="StartEvent_1" targetRef="Task_1"/>

    <!-- Task 1: Instruct artist to create a 3D model -->
    <bpmn:task id="Task_1" name="Instruct artist to create a 3D model">
      <bpmn:incoming>SequenceFlow_0</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="Task_1" targetRef="ExclusiveGateway_1"/>

    <!-- Exclusive Gateway 1: Check if color is available at home -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_1" name="Check if color is available at home">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="ExclusiveGateway_1" targetRef="Task_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_1" targetRef="ServiceTask_1"/>

    <!-- Task 2: Check color availability at home -->
    <bpmn:task id="Task_2" name="Check color availability at home">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="Task_2" targetRef="ExclusiveGateway_2"/>

    <!-- Exclusive Gateway 2: Check if color is ordered or available -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_2" name="Check if color is ordered or available">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="ExclusiveGateway_2" targetRef="Task_3"/>
    <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="ExclusiveGateway_2" targetRef="ServiceTask_2"/>

    <!-- Task 3: Generate gcode file -->
    <bpmn:task id="Task_3" name="Generate gcode file">
      <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_7" sourceRef="Task_3" targetRef="ServiceTask_3"/>

    <!-- Service Task 1: Order color if not available at home -->
    <bpmn:serviceTask id="ServiceTask_1" name="Order color if not available at home">
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_8</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Sequence Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_8" sourceRef="ServiceTask_1" targetRef="ExclusiveGateway_3"/>

    <!-- Exclusive Gateway 3: Check if color is received or not -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_3" name="Check if color is received or not">
      <bpmn:incoming>SequenceFlow_8</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_9</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_9" sourceRef="ExclusiveGateway_3" targetRef="Task_4"/>
    <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="ExclusiveGateway_3" targetRef="ServiceTask_4"/>

    <!-- Task 4: Print model -->
    <bpmn:task id="Task_4" name="Print model">
      <bpmn:incoming>SequenceFlow_9</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_11</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_11" sourceRef="Task_4" targetRef="EndEvent_1"/>

    <!-- Service Task 2: Order color if not available at home (alternative path) -->
    <bpmn:serviceTask id="ServiceTask_2" name="Order color if not available at home (alternative path)">
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_12</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Sequence Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_12" sourceRef="ServiceTask_2" targetRef="ExclusiveGateway_4"/>

    <!-- Exclusive Gateway 4: Check if color is received or not (alternative path) -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_4" name="Check if color is received or not (alternative path)">
      <bpmn:incoming>SequenceFlow_12</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_13</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_13" sourceRef="ExclusiveGateway_4" targetRef="Task_5"/>
    <bpmn:sequenceFlow id="SequenceFlow_14" sourceRef="ExclusiveGateway_4" targetRef="ServiceTask_5"/>

    <!-- Task 5: Print model (alternative path) -->
    <bpmn:task id="Task_5" name="Print model (alternative path)">
      <bpmn:incoming>SequenceFlow_13</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_15</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_15" sourceRef="Task_5" targetRef="EndEvent_2"/>

    <!-- Service Task 3: Generate gcode file (alternative path) -->
    <bpmn:serviceTask id="ServiceTask_3" name="Generate gcode file (alternative path)">
      <bpmn:incoming>SequenceFlow_7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_16</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Sequence Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_16" sourceRef="ServiceTask_3" targetRef="EndEvent_2"/>

    <!-- Service Task 4: Receive color (alternative path) -->
    <bpmn:serviceTask id="ServiceTask_4" name="Receive color (alternative path)">
      <bpmn:incoming>SequenceFlow_10</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_17</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Sequence Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_17" sourceRef="ServiceTask_4" targetRef="EndEvent_2"/>

    <!-- End Event 1: Process completed -->
    <bpmn:endEvent id="EndEvent_1" name="Process completed">
      <bpmn:incoming>SequenceFlow_11</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Service Task 5: Receive color (alternative path) -->
    <bpmn:serviceTask id="ServiceTask_5" name="Receive color (alternative path)">
      <bpmn:incoming>SequenceFlow_14</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_18</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Sequence Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_18" sourceRef="ServiceTask_5" targetRef="EndEvent_2"/>

    <!-- End Event 2: Alternative path completed -->
    <bpmn:endEvent id="EndEvent_2" name="Alternative path completed">
      <bpmn:incoming>SequenceFlow_15</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_16</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_17</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_18</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>