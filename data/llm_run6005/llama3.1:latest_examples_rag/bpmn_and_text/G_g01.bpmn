<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="LAN Party Planning">
      <bpmn:outgoing>SequenceFlow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway gatewayDirection="Diverging" id="ParallelGateway_1">
      <bpmn:incoming>SequenceFlow_0</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_20</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="ServiceTask_0" name="Send Invitations">
      <bpmn:incoming>SequenceFlow_10</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_30</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="SequenceFlow_0" sourceRef="StartEvent_1" targetRef="ParallelGateway_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="ParallelGateway_1" targetRef="ServiceTask_0"/>
    <bpmn:serviceTask id="ServiceTask_1" name="Find Out Which Games to Play">
      <bpmn:incoming>SequenceFlow_20</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_40</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="SequenceFlow_20" sourceRef="ParallelGateway_1" targetRef="ServiceTask_1"/>
    <bpmn:exclusiveGateway gatewayDirection="Diverging" id="ExclusiveGateway_0">
      <bpmn:incoming>SequenceFlow_30</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_50</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_60</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="SequenceFlow_30" sourceRef="ServiceTask_0" targetRef="ExclusiveGateway_0"/>
    <bpmn:serviceTask id="ServiceTask_2" name="Download Missing Games">
      <bpmn:incoming>SequenceFlow_50</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_70</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="SequenceFlow_40" sourceRef="ServiceTask_1" targetRef="ExclusiveGateway_0"/>
    <bpmn:sequenceFlow id="SequenceFlow_50" sourceRef="ExclusiveGateway_0" targetRef="ServiceTask_2"/>
    <bpmn:endEvent id="EndEvent_1" name="LAN Party Prepared">
      <bpmn:incoming>SequenceFlow_70</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow_60" sourceRef="ExclusiveGateway_0" targetRef="ServiceTask_3"/>
    <bpmn:serviceTask id="ServiceTask_3" name="Find Out How Much Beer to Buy">
      <bpmn:incoming>SequenceFlow_60</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_80</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="SequenceFlow_70" sourceRef="ServiceTask_2" targetRef="EndEvent_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_80" sourceRef="ServiceTask_3" targetRef="EndEvent_1"/>
  </bpmn:process>
</bpmn:definitions>