<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <bpmn:process id="Process_1" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Read order from automatic order management system">
      <bpmn:outgoing>SequenceFlow_0</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Exclusive Gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_1" gatewayDirection="Diverging" name="Is first product in stock?">
      <bpmn:incoming>SequenceFlow_0</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_20</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Service Task -->
    <bpmn:serviceTask id="ServiceTask_1" name="Withdraw product from warehouse">
      <bpmn:incoming>SequenceFlow_10</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_30</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Exclusive Gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_2" gatewayDirection="Diverging" name="Is product in stock?">
      <bpmn:incoming>SequenceFlow_30</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_40</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Service Task -->
    <bpmn:serviceTask id="ServiceTask_2" name="Reorder product from wholesaler">
      <bpmn:incoming>SequenceFlow_40</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_50</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Exclusive Gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_3" gatewayDirection="Diverging" name="Is product in stock?">
      <bpmn:incoming>SequenceFlow_50</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_60</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Service Task -->
    <bpmn:serviceTask id="ServiceTask_3" name="Register product in stock management system">
      <bpmn:incoming>SequenceFlow_60</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_70</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Exclusive Gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_4" gatewayDirection="Diverging" name="Is order ready for shipment?">
      <bpmn:incoming>SequenceFlow_70</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_80</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Service Task -->
    <bpmn:serviceTask id="ServiceTask_4" name="Request courier and pack products">
      <bpmn:incoming>SequenceFlow_80</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_90</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_1" name="Shipment prepared">
      <bpmn:incoming>SequenceFlow_90</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_0" sourceRef="StartEvent_1" targetRef="ExclusiveGateway_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="ExclusiveGateway_1" targetRef="ServiceTask_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_20" sourceRef="ExclusiveGateway_1" targetRef="ExclusiveGateway_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_30" sourceRef="ServiceTask_1" targetRef="ExclusiveGateway_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_40" sourceRef="ExclusiveGateway_2" targetRef="ServiceTask_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_50" sourceRef="ServiceTask_2" targetRef="ExclusiveGateway_3"/>
    <bpmn:sequenceFlow id="SequenceFlow_60" sourceRef="ExclusiveGateway_3" targetRef="ServiceTask_3"/>
    <bpmn:sequenceFlow id="SequenceFlow_70" sourceRef="ServiceTask_3" targetRef="ExclusiveGateway_4"/>
    <bpmn:sequenceFlow id="SequenceFlow_80" sourceRef="ExclusiveGateway_4" targetRef="ServiceTask_4"/>
    <bpmn:sequenceFlow id="SequenceFlow_90" sourceRef="ServiceTask_4" targetRef="EndEvent_1"/>
  </bpmn:process>
</bpmn:definitions>