    <!-- Core Flow Elements -->
    <bpmn:startEvent id="StartEvent_0" name="Ship goods">
      <bpmn:outgoing>SequenceFlow_14a0oky</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="ParallelGateway_0" name="">
