<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Check requirements for working and living in Austria">
      <bpmn:outgoing>SequenceFlow_0</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Sequence Flow 1 -->
    <bpmn:sequenceFlow id="SequenceFlow_0" sourceRef="StartEvent_1" targetRef="Task_1">
      <bpmn:text>Organize accommodation and bank account</bpmn:text>
    </bpmn:sequenceFlow>

    <!-- Task 1 -->
    <bpmn:task id="Task_1" name="Organize accommodation and bank account">
      <bpmn:incoming>SequenceFlow_0</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow 2 -->
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="Task_1" targetRef="ExclusiveGateway_1">
      <bpmn:text>Negotiation</bpmn:text>
    </bpmn:sequenceFlow>

    <!-- Exclusive Gateway 1 -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_1" name="Check if visa is required">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flow 3 -->
    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="ExclusiveGateway_1" targetRef="Task_2">
      <bpmn:text>Yes, visa is required</bpmn:text>
    </bpmn:sequenceFlow>

    <!-- Task 2 -->
    <bpmn:task id="Task_2" name="Apply for visa">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow 4 -->
    <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_1" targetRef="Task_3">
      <bpmn:text>No, visa is not required</bpmn:text>
    </bpmn:sequenceFlow>

    <!-- Task 3 -->
    <bpmn:task id="Task_3" name="Check if Rot-Weiss-Rot Card is required">
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow 5 -->
    <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="Task_2" targetRef="ExclusiveGateway_2">
      <bpmn:text>Apply for visa</bpmn:text>
    </bpmn:sequenceFlow>

    <!-- Exclusive Gateway 2 -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_2" name="Check if Rot-Weiss-Rot Card is required">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flow 6 -->
    <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="Task_3" targetRef="ExclusiveGateway_2">
      <bpmn:text>Yes, Rot-Weiss-Rot Card is required</bpmn:text>
    </bpmn:sequenceFlow>

    <!-- Sequence Flow 7 -->
    <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="ExclusiveGateway_2" targetRef="Task_4">
      <bpmn:text>Apply for Rot-Weiss-Rot Card</bpmn:text>
    </bpmn:sequenceFlow>

    <!-- Task 4 -->
    <bpmn:task id="Task_4" name="Apply for Rot-Weiss-Rot Card">
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_8</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow 8 -->
    <bpmn:sequenceFlow id="SequenceFlow_7" sourceRef="ExclusiveGateway_2" targetRef="Task_5">
      <bpmn:text>No, Rot-Weiss-Rot Card is not required</bpmn:text>
    </bpmn:sequenceFlow>

    <!-- Task 5 -->
    <bpmn:task id="Task_5" name="Check if other documents are required">
      <bpmn:incoming>SequenceFlow_7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_9</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow 9 -->
    <bpmn:sequenceFlow id="SequenceFlow_8" sourceRef="Task_4" targetRef="EndEvent_1">
      <bpmn:text>Apply for Rot-Weiss-Rot Card</bpmn:text>
    </bpmn:sequenceFlow>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_1" name="Process finished">
      <bpmn:incoming>SequenceFlow_8</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flow 10 -->
    <bpmn:sequenceFlow id="SequenceFlow_9" sourceRef="Task_5" targetRef="ExclusiveGateway_3">
      <bpmn:text>Yes, other documents are required</bpmn:text>
    </bpmn:sequenceFlow>

    <!-- Exclusive Gateway 3 -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_3" name="Check if other documents are required">
      <bpmn:incoming>SequenceFlow_9</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flow 11 -->
    <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="ExclusiveGateway_3" targetRef="Task_6">
      <bpmn:text>Apply for other documents</bpmn:text>
    </bpmn:sequenceFlow>

    <!-- Task 6 -->
    <bpmn:task id="Task_6" name="Apply for other documents">
      <bpmn:incoming>SequenceFlow_10</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_12</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow 12 -->
    <bpmn:sequenceFlow id="SequenceFlow_11" sourceRef="ExclusiveGateway_3" targetRef="EndEvent_2">
      <bpmn:text>No, other documents are not required</bpmn:text>
    </bpmn:sequenceFlow>

    <!-- End Event 2 -->
    <bpmn:endEvent id="EndEvent_2" name="Process finished">
      <bpmn:incoming>SequenceFlow_11</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flow 13 -->
    <bpmn:sequenceFlow id="SequenceFlow_12" sourceRef="Task_6" targetRef="EndEvent_3">
      <bpmn:text>Apply for other documents</bpmn:text>
    </bpmn:sequenceFlow>

    <!-- End Event 3 -->
    <bpmn:endEvent id="EndEvent_3" name="Process finished">
      <bpmn:incoming>SequenceFlow_12</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>