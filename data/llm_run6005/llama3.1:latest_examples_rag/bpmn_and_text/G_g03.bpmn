<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  targetNamespace="http://bpmn.io/schema/bpmn" id="Definitions_1">
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="wish to enroll in course">
      <bpmn:outgoing>SequenceFlow_14a0oky</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask_1" name="select course" completionQuantity="1"
                    implementation="##WebService" isForCompensation="false">
      <bpmn:incoming>SequenceFlow_14a0oky</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1j94oja</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway_1" gatewayDirection="Diverging"
                            name="free spots?">
      <bpmn:incoming>SequenceFlow_1j94oja</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0kz5g1t</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask_2" name="system shows parallel courses and dates"
                    completionQuantity="1" implementation="##WebService"
                    isForCompensation="false">
      <bpmn:incoming>SequenceFlow_0kz5g1t</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0mp5byl</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway_2" gatewayDirection="Diverging"
                            name="already registered?">
      <bpmn:incoming>SequenceFlow_0mp5byl</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1dlbln9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask_3" name="check if registered at eligible university"
                    completionQuantity="1" implementation="##WebService"
                    isForCompensation="false">
      <bpmn:incoming>SequenceFlow_1dlbln9</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0iu9po7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_1" name="end process">
      <bpmn:incoming>SequenceFlow_0v64x8b</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:sequenceFlow id="SequenceFlow_14a0oky" sourceRef="StartEvent_1"
                      targetRef="UserTask_1"/>
  <bpmn:sequenceFlow id="SequenceFlow_1j94oja" sourceRef="UserTask_1"
                      targetRef="ExclusiveGateway_1"/>
  <bpmn:sequenceFlow id="SequenceFlow_0kz5g1t" sourceRef="ExclusiveGateway_1"
                      targetRef="UserTask_2"/>
  <bpmn:sequenceFlow id="SequenceFlow_0mp5byl" sourceRef="UserTask_2"
                      targetRef="ExclusiveGateway_2"/>
  <bpmn:sequenceFlow id="SequenceFlow_1dlbln9" sourceRef="ExclusiveGateway_2"
                      targetRef="UserTask_3"/>
  <bpmn:sequenceFlow id="SequenceFlow_0iu9po7" sourceRef="UserTask_3"
                      targetRef="EndEvent_1"/>
</bpmn:definitions>