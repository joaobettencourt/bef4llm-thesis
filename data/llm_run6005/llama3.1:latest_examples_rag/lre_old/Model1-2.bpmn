        <bpmn:flowNodeRef>Task_0s79ile2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SequenceFlow_0ajhekx2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1fx9yp32</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Customer brings in a defective computer">
      <bpmn:outgoing>SequenceFlow_14a0oky</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="ExclusiveGateway_0p2e5vq">
      <bpmn:incoming>SequenceFlow_14a0oky</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1j94oja</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_1dlbln9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_12j0pib" name="CRS checks the defect">
      <bpmn:incoming>SequenceFlow_1j94oja</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0kz5g1t</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_1j94oja" name="If the defect is confirmed"
                        sourceRef="ExclusiveGateway_0p2e5vq"
                        targetRef="Task_12j0pib"/>
    <bpmn:task id="Task_0jsoxba" name="Customer decides whether to proceed with repair">
      <bpmn:incoming>SequenceFlow_1dlbln9</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0mp5byl</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_1dlbln9" name="If the customer decides to proceed"
