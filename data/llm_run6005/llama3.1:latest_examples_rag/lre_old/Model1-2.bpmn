    <bpmn:sequenceFlow id="SequenceFlow_1rss71o" sourceRef="Task_0vaxgaa"
                        targetRef="ExclusiveGateway_1mpgzhg"/>
    <bpmn:task id="Task_0e6hvnj" name="Check and configure software">
      <bpmn:incoming>SequenceFlow_1xv6wk4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1pq8ub3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_1xv6wk4" name="yes"
                        sourceRef="ExclusiveGateway_1mpgzhg"
                        targetRef="Task_0e6hvnj"/>
    <bpmn:task id="Task_0s79ile" name="Test system functionality">
      <bpmn:incoming>SequenceFlow_1pq8ub3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0ajhekx</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_1pq8ub3" sourceRef="Task_0e6hvnj"
                        targetRef="Task_0s79ile"/>
    <bpmn:endEvent id="EndEvent_1fx9yp32" name="Repair finished">
      <bpmn:incoming>SequenceFlow_0ajhekx</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:process id="Process_2" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_1viot5w2" name="CRS">
        <bpmn:flowNodeRef>StartNoneEvent_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateMessageEventThrowing_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateMessageEventCatching_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndNoneEvent_3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartNoneEvent_3" name="CRS receives repair request">
      <bpmn:outgoing>SequenceFlow_17</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_10" name="CRS checks the defect and hands out a repair cost calculation">
      <bpmn:incoming>SequenceFlow_17</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateThrowEvent id="IntermediateMessageEventThrowing_1">
      <bpmn:incoming>SequenceFlow_18</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_20</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="EndNoneEvent_3" name="Repair request processed">
      <bpmn:incoming>SequenceFlow_19</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
