<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Restaurant Process" targetNamespace="http://example.com/bpmn">
   <process id="restaurantProcess" isExecutable="true">
     <startEvent id="startEvent1" name="Guest Enters Restaurant">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="task1"/>

     <userTask id="task1" name="Choose Dish and Wait for Turn">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow2" sourceRef="task1" targetRef="intermediateCatchEvent1"/>

     <intermediateCatchEvent id="intermediateCatchEvent1" name="Wait for Turn">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
       <conditionalEventDefinition>
         <condition xsi:type="tFormalExpression">true</condition>
       </conditionalEventDefinition>
     </intermediateCatchEvent>

     <sequenceFlow id="sequenceFlow3" sourceRef="intermediateCatchEvent1" targetRef="task2"/>

     <userTask id="task2" name="Place Order">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow4</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow4" sourceRef="task2" targetRef="task3"/>

     <userTask id="task3" name="Pay Money and Get Buzzer">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow5</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow5" sourceRef="task3" targetRef="task4"/>

     <userTask id="task4" name="Inform Chef">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow6</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow6" sourceRef="task4" targetRef="intermediateCatchEvent2"/>

     <intermediateCatchEvent id="intermediateCatchEvent2" name="Meal Ready">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow7</outgoing>
       <messageEventDefinition messageRef="mealReady"/>
     </intermediateCatchEvent>

     <sequenceFlow id="sequenceFlow7" sourceRef="intermediateCatchEvent2" targetRef="task5"/>

     <userTask id="task5" name="Set Off Buzzer">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow8</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow8" sourceRef="task5" targetRef="eventBasedGateway1"/>

     <eventBasedGateway id="eventBasedGateway1">
       <incoming>sequenceFlow8</incoming>
       <incoming>sequenceFlow9</incoming>
       <outgoing>sequenceFlow10</outgoing>
       <outgoing>sequenceFlow11</outgoing>
     </eventBasedGateway>

     <intermediateCatchEvent id="intermediateCatchEvent3" name="Guest Appears">
       <incoming>sequenceFlow10</incoming>
       <outgoing>sequenceFlow12</outgoing>
       <messageEventDefinition messageRef="guestAppears"/>
     </intermediateCatchEvent>

     <sequenceFlow id="sequenceFlow10" sourceRef="eventBasedGateway1" targetRef="intermediateCatchEvent3"/>

     <userTask id="task6" name="Hand Over Meal">
       <incoming>sequenceFlow12</incoming>
       <outgoing>sequenceFlow13</outgoing>
     </userTask>

     <endEvent id="endEvent1" name="Order Processed">
       <incoming>sequenceFlow13</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow13" sourceRef="task6" targetRef="endEvent1"/>

     <intermediateCatchEvent id="intermediateCatchEvent4" name="5 Minutes Passed">
       <incoming>sequenceFlow11</incoming>
       <outgoing>sequenceFlow14</outgoing>
       <timerEventDefinition>
         <timeCycle xsi:type="tFormalExpression">PT5M</timeCycle>
       </timerEventDefinition>
     </intermediateCatchEvent>

     <sequenceFlow id="sequenceFlow11" sourceRef="eventBasedGateway1" targetRef="intermediateCatchEvent4"/>

     <userTask id="task7" name="Call Guest">
       <incoming>sequenceFlow14</incoming>
       <outgoing>sequenceFlow15</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow14" sourceRef="intermediateCatchEvent4" targetRef="task7"/>

     <sequenceFlow id="sequenceFlow15" sourceRef="task7" targetRef="eventBasedGateway1"/>
   </process>
   <message id="mealReadyMessage" name="Meal Ready Message"/>
   <message id="guestAppearsMessage" name="Guest Appears Message"/>
</definitions>