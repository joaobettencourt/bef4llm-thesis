<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             targetNamespace="http://bpmn.io/schema/bpmn"
             id="definitions" name="Measuring Point Change Process">

   <process id="measuringPointChangeProcess" isExecutable="true">
     <startEvent id="startEvent" name="Start Measuring Point Change Process">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent" targetRef="exclusiveGateway1"/>

     <exclusiveGateway id="exclusiveGateway1" name="Change Request Source?">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
       <outgoing>sequenceFlow3</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow2" sourceRef="exclusiveGateway1" targetRef="taskRequestChange">
       <conditionExpression xsi:type="tFormalExpression">changeRequestedBySPPUGO</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="sequenceFlow3" sourceRef="exclusiveGateway1" targetRef="taskCauseChangeByMPO">
       <conditionExpression xsi:type="tFormalExpression">changeRequestedByMPO</conditionExpression>
     </sequenceFlow>

     <userTask id="taskRequestChange" name="Request Change from SP/PU/GO">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow4</outgoing>
     </userTask>

     <userTask id="taskCauseChangeByMPO" name="Cause Change by MPO Himself">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow5</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow4" sourceRef="taskRequestChange" targetRef="exclusiveGateway2"/>

     <sequenceFlow id="sequenceFlow5" sourceRef="taskCauseChangeByMPO" targetRef="exclusiveGateway2"/>

     <exclusiveGateway id="exclusiveGateway2" name="Approve Change Request?">
       <incoming>sequenceFlow4</incoming>
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow6</outgoing>
       <outgoing>sequenceFlow7</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow6" sourceRef="exclusiveGateway2" targetRef="taskPerformChange">
       <conditionExpression xsi:type="tFormalExpression">approveChangeRequest</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="sequenceFlow7" sourceRef="exclusiveGateway2" targetRef="taskRejectRequest">
       <conditionExpression xsi:type="tFormalExpression">rejectChangeRequest</conditionExpression>
     </sequenceFlow>

     <userTask id="taskPerformChange" name="Perform Measuring Point Change">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow8</outgoing>
     </userTask>

     <userTask id="taskRejectRequest" name="Reject Request">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow9</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow8" sourceRef="taskPerformChange" targetRef="exclusiveGateway3"/>

     <sequenceFlow id="sequenceFlow9" sourceRef="taskRejectRequest" targetRef="endEvent1"/>

     <exclusiveGateway id="exclusiveGateway3" name="Change Successful?">
       <incoming>sequenceFlow8</incoming>
       <outgoing>sequenceFlow10</outgoing>
       <outgoing>sequenceFlow11</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow10" sourceRef="exclusiveGateway3" targetRef="taskSendReport">
       <conditionExpression xsi:type="tFormalExpression">changeSuccessful</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="sequenceFlow11" sourceRef="exclusiveGateway3" targetRef="taskInformFailure">

     </sequenceFlow>

     <userTask id="taskSendReport" name="Send Implementation Report to SP/PU/GO">
       <incoming>sequenceFlow10</incoming>
       <outgoing>sequenceFlow12</outgoing>
     </userTask>

     <userTask id="taskInformFailure" name="Inform SP/PU/GO about Failure of Changes">
       <incoming>sequenceFlow11</incoming>
       <outgoing>sequenceFlow13</outgoing>
     </userTask>

     <endEvent id="endEvent1" name="Process Failed">
       <incoming>sequenceFlow9</incoming>
     </endEvent>

     <endEvent id="endEvent2" name="Process Completed Successfully">
       <incoming>sequenceFlow12</incoming>
     </endEvent>

     <endEvent id="endEvent3" name="Inform Failure Completed">
       <incoming>sequenceFlow13</incoming>
     </endEvent>
   </process>
</definitions>