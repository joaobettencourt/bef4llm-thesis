<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Lead Processing" targetNamespace="http://example.com/bpmn">

   <process id="leadProcessing" isExecutable="true">
     <laneSet>
       <lane id="salesAssistantLane1" name="Sales Assistant">
         <flowNodeRef>callContactPersonTask</flowNodeRef>
         <flowNodeRef>exclusiveGateway1</flowNodeRef>
       </lane>
       <lane id="managerLane1" name="Manager">
         <flowNodeRef>startEvent1</flowNodeRef>
         <flowNodeRef>checkOpenLeadsTask1</flowNodeRef>
         <flowNodeRef>selectTopFiveLeadsTask1</flowNodeRef>
         <flowNodeRef>processLeadTask1</flowNodeRef>
       </lane>
     </laneSet>

     <startEvent id="startEvent1" name="Start">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="checkOpenLeadsTask1"/>

     <userTask id="checkOpenLeadsTask1" name="Check Open Leads">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow2" sourceRef="checkOpenLeadsTask1" targetRef="selectTopFiveLeadsTask1"/>

     <userTask id="selectTopFiveLeadsTask1" name="Select Top Five Leads">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow3" sourceRef="selectTopFiveLeadsTask1" targetRef="callContactPersonTask"/>

     <userTask id="callContactPersonTask" name="Call Contact Person">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow4</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow4" sourceRef="callContactPersonTask" targetRef="exclusiveGateway1"/>

     <exclusiveGateway id="exclusiveGateway1">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow5</outgoing>
       <outgoing>sequenceFlow6</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow5" sourceRef="exclusiveGateway1" targetRef="processLeadTask1">
       <conditionExpression xsi:type="tFormalExpression">interested</conditionExpression>
     </sequenceFlow>

     <userTask id="processLeadTask1" name="Process Lead">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow7</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow6" sourceRef="exclusiveGateway1" targetRef="callContactPersonTask"/>

     <sequenceFlow id="sequenceFlow7" sourceRef="processLeadTask1" targetRef="endEvent1"/>

     <endEvent id="endEvent1" name="End">
       <incoming>sequenceFlow7</incoming>
     </endEvent>
   </process>
</definitions>