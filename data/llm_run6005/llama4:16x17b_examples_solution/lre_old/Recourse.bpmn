<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Recourse Process">

   <process id="recourseProcess" isExecutable="true">
     <startEvent id="startEvent" name="Probable Recourse Detected">
       <outgoing>sequenceFlow1</outgoing>
       <messageEventDefinition/>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent" targetRef="task1"/>

     <userTask id="task1" name="Check Case">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow2" sourceRef="task1" targetRef="exclusiveGateway1"/>

     <exclusiveGateway id="exclusiveGateway1" name="Recourse Possible?">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
       <outgoing>sequenceFlow4</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow3" sourceRef="exclusiveGateway1" targetRef="task2">
       <conditionExpression xsi:type="tFormalExpression">recoursePossible</conditionExpression>
     </sequenceFlow>

     <userTask id="task2" name="Send Request for Payment">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow5</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow5" sourceRef="task2" targetRef="task3"/>

     <userTask id="task3" name="Send Reminder">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow6</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow6" sourceRef="task3" targetRef="eventBasedGateway1"/>

     <eventBasedGateway id="eventBasedGateway1">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow7</outgoing>
       <outgoing>sequenceFlow8</outgoing>
       <outgoing>sequenceFlow9</outgoing>
     </eventBasedGateway>

     <intermediateCatchEvent id="intermediateCatchEvent1" name="Disagreement Letter Received">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow10</outgoing>
       <messageEventDefinition/>
     </intermediateCatchEvent>

     <sequenceFlow id="sequenceFlow7" sourceRef="eventBasedGateway1" targetRef="intermediateCatchEvent1"/>

     <userTask id="task4" name="Check Reasoning">
       <incoming>sequenceFlow10</incoming>
       <outgoing>sequenceFlow11</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow10" sourceRef="intermediateCatchEvent1" targetRef="task4"/>

     <exclusiveGateway id="exclusiveGateway2" name="OK?">
       <incoming>sequenceFlow11</incoming>
       <outgoing>sequenceFlow12</outgoing>
       <outgoing>sequenceFlow13</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow11" sourceRef="task4" targetRef="exclusiveGateway2"/>

     <sequenceFlow id="sequenceFlow12" name="yes" sourceRef="exclusiveGateway2" targetRef="task5"/>
     <sequenceFlow id="sequenceFlow13" name="no" sourceRef="exclusiveGateway2" targetRef="task6"/>

     <userTask id="task5" name="Close Case">
       <incoming>sequenceFlow12</incoming>
       <outgoing>sequenceFlow14</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow14" sourceRef="task5" targetRef="endEvent1"/>

     <userTask id="task6" name="Hand Over to Collection Agency">
       <incoming>sequenceFlow13</incoming>
       <incoming>sequenceFlow15</incoming>
       <outgoing>sequenceFlow16</outgoing>
     </userTask>

     <intermediateCatchEvent id="intermediateCatchEvent2" name="Reminder is Due">
       <incoming>sequenceFlow9</incoming>
       <outgoing>sequenceFlow15</outgoing>
       <timerEventDefinition/>
     </intermediateCatchEvent>

     <sequenceFlow id="sequenceFlow9" sourceRef="eventBasedGateway1" targetRef="intermediateCatchEvent2"/>
     <sequenceFlow id="sequenceFlow15" sourceRef="intermediateCatchEvent2" targetRef="task6"/>

     <endEvent id="endEvent1" name="Case Closed">
       <incoming>sequenceFlow14</incoming>
     </endEvent>

     <endEvent id="endEvent2" name="Case Opened at Collection Agency">
       <incoming>sequenceFlow16</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow16" sourceRef="task6" targetRef="endEvent2"/>

     <intermediateCatchEvent id="intermediateCatchEvent3" name="Money Received">
       <incoming>sequenceFlow8</incoming>
       <outgoing>sequenceFlow17</outgoing>
       <messageEventDefinition/>
     </intermediateCatchEvent>

     <sequenceFlow id="sequenceFlow8" sourceRef="eventBasedGateway1" targetRef="intermediateCatchEvent3"/>
     <sequenceFlow id="sequenceFlow17" sourceRef="intermediateCatchEvent3" targetRef="task7"/>

     <userTask id="task7" name="Make Booking">
       <incoming>sequenceFlow17</incoming>
       <outgoing>sequenceFlow18</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow18" sourceRef="task7" targetRef="task8"/>

     <userTask id="task8" name="Close Case">
       <incoming>sequenceFlow18</incoming>
       <outgoing>sequenceFlow19</outgoing>
     </userTask>

     <endEvent id="endEvent3" name="Case Closed">
       <incoming>sequenceFlow19</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow19" sourceRef="task8" targetRef="endEvent3"/>
   </process>
</definitions>