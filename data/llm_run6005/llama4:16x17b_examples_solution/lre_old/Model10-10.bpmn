<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Fault Detection and Resolution Process" targetNamespace="http://example.com/bpmn">

    <process id="faultDetectionProcess" isExecutable="true">
      <startEvent id="startEvent1" name="Fault Detector Reports Failure or User Suspects Fault">
        <outgoing>sequenceFlow1</outgoing>
      </startEvent>

      <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="exclusiveGateway1"/>

      <exclusiveGateway id="exclusiveGateway1">
        <incoming>sequenceFlow1</incoming>
        <outgoing>sequenceFlow2</outgoing>
        <outgoing>sequenceFlow3</outgoing>
      </exclusiveGateway>

      <sequenceFlow id="sequenceFlow2" sourceRef="exclusiveGateway1" targetRef="task1"/>
      <sequenceFlow id="sequenceFlow3" sourceRef="exclusiveGateway1" targetRef="intermediateCatchEvent1"/>

      <intermediateCatchEvent id="intermediateCatchEvent1">
        <incoming>sequenceFlow3</incoming>
        <outgoing>sequenceFlow4</outgoing>
      </intermediateCatchEvent>

      <sequenceFlow id="sequenceFlow4" sourceRef="intermediateCatchEvent1" targetRef="task1"/>

      <task id="task1" name="Examine Failure">
        <incoming>sequenceFlow2</incoming>
        <incoming>sequenceFlow4</incoming>
        <outgoing>sequenceFlow5</outgoing>
      </task>

      <sequenceFlow id="sequenceFlow5" sourceRef="task1" targetRef="exclusiveGateway2"/>

      <exclusiveGateway id="exclusiveGateway2">
        <incoming>sequenceFlow5</incoming>
        <outgoing>sequenceFlow6</outgoing>
        <outgoing>sequenceFlow7</outgoing>
      </exclusiveGateway>

      <sequenceFlow id="sequenceFlow6" sourceRef="exclusiveGateway2" targetRef="task2"/>
      <sequenceFlow id="sequenceFlow7" sourceRef="exclusiveGateway2" targetRef="endEvent1"/>

      <task id="task2" name="Inform Customer and Manager">
        <incoming>sequenceFlow6</incoming>
        <outgoing>sequenceFlow8</outgoing>
      </task>

      <sequenceFlow id="sequenceFlow8" sourceRef="task2" targetRef="task3"/>

      <task id="task3" name="Fix Fault at Measuring Device">
        <incoming>sequenceFlow8</incoming>
        <outgoing>sequenceFlow9</outgoing>
      </task>

      <sequenceFlow id="sequenceFlow9" sourceRef="task3" targetRef="task4"/>

      <task id="task4" name="Share Repair Results with Fault Detector">
        <incoming>sequenceFlow9</incoming>
        <outgoing>sequenceFlow10</outgoing>
      </task>

      <sequenceFlow id="sequenceFlow10" sourceRef="task4" targetRef="task5"/>

      <task id="task5" name="Inform Customer about Resolution">
        <incoming>sequenceFlow10</incoming>
        <outgoing>sequenceFlow11</outgoing>
      </task>

      <sequenceFlow id="sequenceFlow11" sourceRef="task5" targetRef="task6"/>

      <task id="task6" name="Inform Manager about Resolution">
        <incoming>sequenceFlow11</incoming>
        <outgoing>sequenceFlow12</outgoing>
      </task>

      <sequenceFlow id="sequenceFlow12" sourceRef="task6" targetRef="endEvent1"/>

      <endEvent id="endEvent1" name="Process Complete">
        <incoming>sequenceFlow7</incoming>
        <incoming>sequenceFlow12</incoming>
      </endEvent>
    </process>
</definitions>