<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" 
             name="Design Process"
             targetNamespace="http://bpmn.io/schema/bpmn">

   <process id="designProcess" isExecutable="true">
     <startEvent id="startEvent1">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="task1"/>

     <userTask id="task1" name="Locate and Distribute Existing Designs">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow2" sourceRef="task1" targetRef="parallelGateway1"/>

     <parallelGateway id="parallelGateway1">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
       <outgoing>sequenceFlow4</outgoing>
     </parallelGateway>

     <sequenceFlow id="sequenceFlow3" sourceRef="parallelGateway1" targetRef="task2"/>

     <userTask id="task2" name="Review and Update Electrical Design">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow5</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow4" sourceRef="parallelGateway1" targetRef="task3"/>

     <userTask id="task3" name="Review and Update Physical Design">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow6</outgoing>
     </userTask>

     <exclusiveGateway id="exclusiveGateway1">
       <incoming>sequenceFlow5</incoming>
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow8</outgoing>
     </exclusiveGateway>

     <boundaryEvent id="boundaryEvent1" attachedToRef="task3">
       <outgoing>sequenceFlow7</outgoing>
       <signalEventDefinition/>
     </boundaryEvent>

     <sequenceFlow id="sequenceFlow5" sourceRef="task2" targetRef="exclusiveGateway1"/>

     <sequenceFlow id="sequenceFlow6" sourceRef="task3" targetRef="exclusiveGateway2"/>

     <exclusiveGateway id="exclusiveGateway2">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow9</outgoing>
     </exclusiveGateway>

     <parallelGateway id="parallelGateway2">
       <incoming>sequenceFlow8</incoming>
       <incoming>sequenceFlow10</incoming>
       <outgoing>sequenceFlow11</outgoing>
     </parallelGateway>

     <sequenceFlow id="sequenceFlow8" sourceRef="exclusiveGateway1" targetRef="task4"/>

     <userTask id="task4" name="Test Electrical Design">
       <incoming>sequenceFlow8</incoming>
       <outgoing>sequenceFlow10</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow9" sourceRef="exclusiveGateway2" targetRef="parallelGateway2"/>

     <sequenceFlow id="sequenceFlow10" sourceRef="task4" targetRef="parallelGateway2"/>

     <task id="task5" name="Test Combined Design">
       <incoming>sequenceFlow11</incoming>
       <outgoing>sequenceFlow12</outgoing>
     </task>

     <exclusiveGateway id="exclusiveGateway3">
       <incoming>sequenceFlow12</incoming>
       <outgoing>sequenceFlow13</outgoing>
       <outgoing>sequenceFlow14</outgoing>
     </exclusiveGateway>

     <endEvent id="endEvent1">
       <incoming>sequenceFlow13</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow11" sourceRef="parallelGateway2" targetRef="task5"/>

     <sequenceFlow id="sequenceFlow12" sourceRef="task5" targetRef="exclusiveGateway3"/>

     <sequenceFlow id="sequenceFlow13" sourceRef="exclusiveGateway3" targetRef="endEvent1"/>

     <sequenceFlow id="sequenceFlow14" sourceRef="exclusiveGateway3" targetRef="startEvent1"/>
     <sequenceFlow id="sequenceFlow7" sourceRef="boundaryEvent1" targetRef="exclusiveGateway1"/>
   </process>
</definitions>