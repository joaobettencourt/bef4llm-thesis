<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Room Service Process" targetNamespace="http://bpmn.io/schema/bpmn">
   <process id="roomServiceProcess" isExecutable="true">
     <startEvent id="startEvent1" name="Guest Calls Room Service">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="task1"/>

     <userTask id="task1" name="Take Down Order">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow2" sourceRef="task1" targetRef="exclusiveGateway1"/>

     <exclusiveGateway id="exclusiveGateway1" name="Alcoholic Beverages Ordered?">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
       <outgoing>sequenceFlow4</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow3" sourceRef="exclusiveGateway1" targetRef="task2">
       <conditionExpression xsi:type="tFormalExpression">yes</conditionExpression>
     </sequenceFlow>

     <userTask id="task2" name="Give Order to Sommelier">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow5</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow5" sourceRef="task2" targetRef="parallelGateway1"/>

     <sequenceFlow id="sequenceFlow4" name="No" sourceRef="exclusiveGateway1" targetRef="parallelGateway1"/>

     <parallelGateway id="parallelGateway1">
       <incoming>sequenceFlow4</incoming>
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow6</outgoing>
       <outgoing>sequenceFlow7</outgoing>
     </parallelGateway>

     <sequenceFlow id="sequenceFlow6" sourceRef="parallelGateway1" targetRef="task3"/>

     <userTask id="task3" name="Submit Order Ticket to Kitchen">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow8</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow7" sourceRef="parallelGateway1" targetRef="task4"/>

     <userTask id="task4" name="Ready Cart">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow9</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow8" sourceRef="task3" targetRef="parallelGateway2"/>

     <sequenceFlow id="sequenceFlow9" sourceRef="task4" targetRef="exclusiveGateway2"/>

     <parallelGateway id="parallelGateway2">
       <incoming>sequenceFlow8</incoming>
       <outgoing>sequenceFlow10</outgoing>
       <outgoing>sequenceFlow11</outgoing>
     </parallelGateway>

     <sequenceFlow id="sequenceFlow10" sourceRef="parallelGateway2" targetRef="task5"/>

     <userTask id="task5" name="Assign Order to Waiter">
       <incoming>sequenceFlow10</incoming>
       <outgoing>sequenceFlow12</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow11" sourceRef="parallelGateway2" targetRef="task6"/>

     <userTask id="task6" name="Prepare Alcoholic Beverages">
       <incoming>sequenceFlow11</incoming>
       <outgoing>sequenceFlow13</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow12" sourceRef="task5" targetRef="exclusiveGateway2"/>

     <exclusiveGateway id="exclusiveGateway2">
       <incoming>sequenceFlow9</incoming>
       <incoming>sequenceFlow12</incoming>
       <outgoing>sequenceFlow14</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow13" sourceRef="task6" targetRef="parallelGateway3"/>

     <sequenceFlow id="sequenceFlow14" sourceRef="exclusiveGateway2" targetRef="task7"/>

     <userTask id="task7" name="Prepare Meal">
       <incoming>sequenceFlow14</incoming>
       <outgoing>sequenceFlow15</outgoing>
     </userTask>

     <parallelGateway id="parallelGateway3">
       <incoming>sequenceFlow13</incoming>
       <incoming>sequenceFlow15</incoming>
       <outgoing>sequenceFlow16</outgoing>
     </parallelGateway>

     <sequenceFlow id="sequenceFlow15" sourceRef="task7" targetRef="parallelGateway3"/>

     <sequenceFlow id="sequenceFlow16" sourceRef="parallelGateway3" targetRef="task8"/>

     <userTask id="task8" name="Deliver to Guest's Room">
       <incoming>sequenceFlow16</incoming>
       <outgoing>sequenceFlow17</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow17" sourceRef="task8" targetRef="task9"/>

     <userTask id="task9" name="Return to Room-Service Station">
       <incoming>sequenceFlow17</incoming>
       <outgoing>sequenceFlow18</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow18" sourceRef="task9" targetRef="endEvent1"/>

     <endEvent id="endEvent1" name="End of Process">
       <incoming>sequenceFlow18</incoming>
     </endEvent>
   </process>
 </definitions>