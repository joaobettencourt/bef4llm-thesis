<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="File Preparation Process" targetNamespace="http://example.com/bpmn">

   <process id="filePreparationProcess" isExecutable="true">
     <startEvent id="startEvent1" name="Start of File Preparation">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="task1"/>

     <userTask id="task1" name="Check Files">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow2" sourceRef="task1" targetRef="exclusiveGateway1"/>

     <exclusiveGateway id="exclusiveGateway1" name="Files Missing?">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
       <outgoing>sequenceFlow4</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow3" sourceRef="exclusiveGateway1" targetRef="task2">
       <conditionExpression xsi:type="tFormalExpression">filesMissing</conditionExpression>
     </sequenceFlow>

     <userTask id="task2" name="Initiate Search">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow5</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow5" sourceRef="task2" targetRef="exclusiveGateway2"/>

     <exclusiveGateway id="exclusiveGateway2">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow6</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow4" name="No" sourceRef="exclusiveGateway1" targetRef="task3"/>

     <userTask id="task3" name="Track Physical Files">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow7</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow7" sourceRef="task3" targetRef="parallelGateway1"/>

     <parallelGateway id="parallelGateway1">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow8</outgoing>
       <outgoing>sequenceFlow9</outgoing>
     </parallelGateway>

     <sequenceFlow id="sequenceFlow8" sourceRef="parallelGateway1" targetRef="task4"/>

     <userTask id="task4" name="Hand Files to Associate">
       <incoming>sequenceFlow8</incoming>
       <outgoing>sequenceFlow10</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow9" sourceRef="parallelGateway1" targetRef="task5"/>

     <userTask id="task5" name="Distribute Judge's Lawlist">
       <incoming>sequenceFlow9</incoming>
       <outgoing>sequenceFlow11</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow10_2" sourceRef="task4" targetRef="parallelGateway2"/>
     <sequenceFlow id="sequenceFlow11_2" sourceRef="task5" targetRef="parallelGateway2"/>

     <parallelGateway id="parallelGateway2">
       <incoming>sequenceFlow10_2</incoming>
       <incoming>sequenceFlow11_2</incoming>
       <outgoing>sequenceFlow12</outgoing>
     </parallelGateway>

     <sequenceFlow id="sequenceFlow12" sourceRef="parallelGateway2" targetRef="task6"/>

     <userTask id="task6" name="Conduct Directions Hearings">
       <incoming>sequenceFlow12</incoming>
       <outgoing>sequenceFlow13</outgoing>
     </userTask>

     <endEvent id="endEvent1" name="End of File Preparation">
       <incoming>sequenceFlow13</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow13" sourceRef="task6" targetRef="endEvent1"/>
   </process>
</definitions>