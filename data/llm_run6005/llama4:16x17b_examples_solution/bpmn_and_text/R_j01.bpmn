<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/BPMN20.xsd"
             id="definitions" name="OEE Process">

   <process id="oeeProcess" isExecutable="true">
     <startEvent id="startEvent1">
       <outgoing>collectInfo</outgoing>
     </startEvent>

     <sequenceFlow id="collectInfoSeq" sourceRef="startEvent1" targetRef="checkConnection"/>

     <serviceTask id="checkConnection" name="Check connection">
       <incoming>collectInfoSeq</incoming>
       <outgoing>isConnected</outgoing>
     </serviceTask>

     <exclusiveGateway id="isConnectedGw">
       <incoming>checkConnection</incoming>
       <outgoing>connected</outgoing>
       <outgoing>notConnected</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="connected" name="yes" sourceRef="isConnectedGw" targetRef="collectMachineInfo"/>

     <sequenceFlow id="notConnected" name="no" sourceRef="isConnectedGw" targetRef="endEvent1"/>

     <serviceTask id="collectMachineInfo" name="Collect information from machine">
       <incoming>connected</incoming>
       <outgoing>calculateOee</outgoing>
     </serviceTask>

     <sequenceFlow id="calculateOeeSeq" sourceRef="collectMachineInfo" targetRef="evaluateOee"/>

     <exclusiveGateway id="evaluateOeeGw">
       <incoming>calculateOeeSeq</incoming>
       <outgoing>oeeSufficient</outgoing>
       <outgoing>oeeInsufficient</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="oeeSufficient" name="yes" sourceRef="evaluateOeeGw" targetRef="continueMeasuring"/>

     <sequenceFlow id="oeeInsufficient" name="no" sourceRef="evaluateOeeGw" targetRef="stopMachine"/>

     <userTask id="stopMachine" name="Stop the machine">
       <incoming>oeeInsufficient</incoming>
       <outgoing>sendNotificationSeq</outgoing>
     </userTask>

     <sequenceFlow id="sendNotificationSeq" sourceRef="stopMachine" targetRef="sendNotification"/>

     <serviceTask id="sendNotification" name="Send engineer notification">
       <incoming>sendNotificationSeq</incoming>
       <outgoing>engineerRespondedGw</outgoing>
     </serviceTask>

     <exclusiveGateway id="engineerRespondedGw">
       <incoming>sendNotification</incoming>
       <outgoing>restartMachine</outgoing>
       <outgoing>continueSeq</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="restartMachine" name="yes" sourceRef="engineerRespondedGw" targetRef="restart"/>

     <sequenceFlow id="continueSeq" name="no" sourceRef="engineerRespondedGw" targetRef="endEvent1"/>

     <serviceTask id="restart" name="Restart machine">
       <incoming>restartMachine</incoming>
       <outgoing>collectMachineInfoAgain</outgoing>
     </serviceTask>

     <sequenceFlow id="collectMachineInfoAgain" sourceRef="restart" targetRef="collectMachineInfo"/>

   </process>

   <endEvent id="endEvent1"/>
   
</definitions>