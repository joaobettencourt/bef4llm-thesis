<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definition" 
             name="Work Accident Process"
             targetNamespace="http://example.com/workaccident">

   <process id="workAccidentProcess" isExecutable="true">
     <startEvent id="incidentHappens">
       <outgoing>informEmployer</outgoing>
     </startEvent>

     <sequenceFlow id="sf_informEmployer" sourceRef="incidentHappens" targetRef="informEmployerTask"/>

     <task id="informEmployerTask" name="Inform Employer">
       <incoming>sf_informEmployer</incoming>
       <outgoing>determineTypeOfAccident</outgoing>
     </task>

     <sequenceFlow id="sf_determineTypeOfAccident" sourceRef="informEmployerTask" targetRef="exclusiveGateway"/>

     <exclusiveGateway id="exclusiveGateway">
       <incoming>sf_determineTypeOfAccident</incoming>
       <outgoing>isWorkAccident</outgoing>
       <outgoing>notWorkAccident</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sf_isWorkAccident" sourceRef="exclusiveGateway" targetRef="reportToLabourInspectorate">
       <conditionExpression xsi:type="tFormalExpression">is work accident</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="sf_notWorkAccident" sourceRef="exclusiveGateway" targetRef="endEvent">
       <conditionExpression xsi:type="tFormalExpression">not work accident</conditionExpression>
     </sequenceFlow>

     <task id="reportToLabourInspectorate" name="Report to Labour Inspectorate">
       <incoming>sf_isWorkAccident</incoming>
       <outgoing>sf_reportToAccidentInsuranceProvider</outgoing>
     </task>

     <sequenceFlow id="sf_reportToAccidentInsuranceProvider" sourceRef="reportToLabourInspectorate" targetRef="parallelGateway"/>

     <parallelGateway id="parallelGateway">
       <incoming>sf_reportToAccidentInsuranceProvider</incoming>
       <outgoing>contactAuthorities</outgoing>
       <outgoing>notifySuperiors</outgoing>
     </parallelGateway>

     <sequenceFlow id="sf_contactAuthorities" sourceRef="parallelGateway" targetRef="taskContactAuthorities"/>

     <task id="taskContactAuthorities" name="Contact Authorities">
       <incoming>sf_contactAuthorities</incoming>
     </task>

     <sequenceFlow id="sf_notifySuperiors" sourceRef="parallelGateway" targetRef="taskNotifySuperiors"/>

     <task id="taskNotifySuperiors" name="Notify Superiors">
       <incoming>sf_notifySuperiors</incoming>
     </task>

     <endEvent id="endEvent">
       <incoming>sf_notWorkAccident</incoming>
     </endEvent>
   </process>
</definitions>