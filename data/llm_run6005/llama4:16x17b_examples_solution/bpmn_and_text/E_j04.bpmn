<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definition" 
             name="Internship Process"
             targetNamespace="http://example.com/internship">

   <process id="InternshipProcess" isExecutable="true">
     <startEvent id="StartEvent1">
       <outgoing>SequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow1" sourceRef="StartEvent1" targetRef="UserTask1"/>

     <userTask id="UserTask1" name="Enter desired topic and amount of money.">
       <incoming>SequenceFlow1</incoming>
       <outgoing>SequenceFlow2</outgoing>
     </userTask>

     <sequenceFlow id="SequenceFlow2" sourceRef="UserTask1" targetRef="ServiceTask1"/>

     <serviceTask id="ServiceTask1" name="Offers arrival">
       <incoming>SequenceFlow2</incoming>
       <outgoing>SequenceFlow3</outgoing>
     </serviceTask>

     <sequenceFlow id="SequenceFlow3" sourceRef="ServiceTask1" targetRef="ExclusiveGateway1"/>

     <exclusiveGateway id="ExclusiveGateway1">
       <incoming>SequenceFlow3</incoming>
       <outgoing>SequenceFlow4</outgoing>
       <outgoing>SequenceFlow5</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow4" sourceRef="ExclusiveGateway1" targetRef="UserTask2">
       <conditionExpression xsi:type="tFormalExpression">accept offer</conditionExpression>
     </sequenceFlow>

     <userTask id="UserTask2" name="Accept Offer">
       <incoming>SequenceFlow4</incoming>
       <outgoing>SequenceFlow6</outgoing>
     </userTask>

     <sequenceFlow id="SequenceFlow5" sourceRef="ExclusiveGateway1" targetRef="ServiceTask2">
       <conditionExpression xsi:type="tFormalExpression">deny offer</conditionExpression>
     </sequenceFlow>

     <serviceTask id="ServiceTask2" name="Invalid other offers">
       <incoming>SequenceFlow5</incoming>
       <outgoing>SequenceFlow7</outgoing>
     </serviceTask>

     <sequenceFlow id="SequenceFlow6" sourceRef="UserTask2" targetRef="ParallelGateway1"/>

     <parallelGateway id="ParallelGateway1">
       <incoming>SequenceFlow6</incoming>
       <outgoing>SequenceFlow8</outgoing>
       <outgoing>SequenceFlow9</outgoing>
     </parallelGateway>

     <sequenceFlow id="SequenceFlow7" sourceRef="ServiceTask2" targetRef="EndEvent1"/>

     <endEvent id="EndEvent1">
       <incoming>SequenceFlow7</incoming>
     </endEvent>

     <userTask id="UserTask3" name="Write status updates about internship.">
       <incoming>SequenceFlow8</incoming>
     </userTask>

     <sequenceFlow id="SequenceFlow8" sourceRef="ParallelGateway1" targetRef="UserTask3"/>

     <userTask id="UserTask4" name="Company writes status updates about you.">
       <incoming>SequenceFlow9</incoming>
     </userTask>

     <sequenceFlow id="SequenceFlow9" sourceRef="ParallelGateway1" targetRef="UserTask4"/>

     <exclusiveGateway id="ExclusiveGateway2">
       <outgoing>SequenceFlow10</outgoing>
       <outgoing>SequenceFlow11</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow10" sourceRef="UserTask3" targetRef="ExclusiveGateway2"/>

     <sequenceFlow id="SequenceFlow11" sourceRef="UserTask4" targetRef="ExclusiveGateway2"/>

     <userTask id="UserTask5" name="Recommend company to friends via Twitter.">
       <incoming>SequenceFlow12</incoming>
     </userTask>

     <parallelGateway id="ParallelGateway2">
       <outgoing>SequenceFlow13</outgoing>
     </parallelGateway>

     <sequenceFlow id="SequenceFlow12" sourceRef="ExclusiveGateway2" targetRef="ParallelGateway2"/>

     <sequenceFlow id="SequenceFlow13" sourceRef="ParallelGateway2" targetRef="UserTask5"/>
   </process>
 </definitions>