<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definition" name="Farming Bot Process" targetNamespace="http://example.com">

   <process id="farmingBotProcess" isExecutable="true">
     <startEvent id="startGame">
       <outgoing>createFarmingList</outgoing>
     </startEvent>

     <sequenceFlow id="sf1" sourceRef="startGame" targetRef="createFarmingListTask"/>
     <userTask id="createFarmingListTask" name="Create Farming List">
       <incoming>sf1</incoming>
       <outgoing>sf2</outgoing>
     </userTask>

     <sequenceFlow id="sf2" sourceRef="createFarmingListTask" targetRef="checkAvailableResourcesTask"/>
     <scriptTask id="checkAvailableResourcesTask" name="Check available resources">
       <incoming>sf2</incoming>
       <outgoing>sf3</outgoing>
     </scriptTask>

     <sequenceFlow id="sf3" sourceRef="checkAvailableResourcesTask" targetRef="pg1"/>
     <parallelGateway id="pg1">
       <incoming>sf3</incoming>
       <outgoing>sf4</outgoing>
       <outgoing>sf5</outgoing>
     </parallelGateway>

     <sequenceFlow id="sf4" sourceRef="pg1" targetRef="farmingTask"/>
     <serviceTask id="farmingTask" name="Collect Materials">
       <incoming>sf4</incoming>
       <outgoing>sf6</outgoing>
     </serviceTask>

     <sequenceFlow id="sf6" sourceRef="farmingTask" targetRef="exclusiveGateway1"/>
     <exclusiveGateway id="exclusiveGateway1">
       <incoming>sf6</incoming>
       <outgoing>sf7</outgoing>
       <outgoing>sf8</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sf7" sourceRef="exclusiveGateway1" targetRef="notifyPlayer"/>
     <serviceTask id="notifyPlayer" name="Notify player">
       <incoming>sf7</incoming>
       <outgoing>sf9</outgoing>
     </serviceTask>

     <sequenceFlow id="sf9" sourceRef="notifyPlayer" targetRef="exclusiveGateway2"/>
     <exclusiveGateway id="exclusiveGateway2">
       <incoming>sf9</incoming>
       <outgoing>sf10</outgoing>
       <outgoing>sf11</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sf10" sourceRef="exclusiveGateway2" targetRef="userTaskBrag"/>
     <userTask id="userTaskBrag" name="Brag about materials">
       <incoming>sf10</incoming>
       <outgoing>sf12</outgoing>
     </userTask>

     <sequenceFlow id="sf11" sourceRef="exclusiveGateway2" targetRef="userTaskSendMaterials"/>
     <userTask id="userTaskSendMaterials" name="Send materials to friends">
       <incoming>sf11</incoming>
       <outgoing>sf12</outgoing>
     </userTask>

     <sequenceFlow id="sf12" sourceRef="userTaskBrag" targetRef="endEvent"/>
     <sequenceFlow id="sf13" sourceRef="userTaskSendMaterials" targetRef="endEvent"/>

     <sequenceFlow id="sf8" sourceRef="exclusiveGateway1" targetRef="intermediateCatchEvent"/>
     <intermediateCatchEvent id="intermediateCatchEvent">
       <incoming>sf8</incoming>
       <outgoing>sf14</outgoing>
     </intermediateCatchEvent>

     <sequenceFlow id="sf14" sourceRef="intermediateCatchEvent" targetRef="farmingTask"/>

     <sequenceFlow id="sf5" sourceRef="pg1" targetRef="userTaskUpdateFarmingList"/>
     <userTask id="userTaskUpdateFarmingList" name="Adjust Farming List">
       <incoming>sf5</incoming>
       <outgoing>sf15</outgoing>
     </userTask>

     <sequenceFlow id="sf15" sourceRef="userTaskUpdateFarmingList" targetRef="farmingTask"/>

     <endEvent id="endEvent">
       <incoming>sf12</incoming>
       <incoming>sf13</incoming>
     </endEvent>
   </process>
 </definitions>