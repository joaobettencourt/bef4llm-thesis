<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definition" 
             targetNamespace="http://bpmn.io/schema/bpmn">

   <process id="Process_1" isExecutable="true">
     <laneSet>
       <lane id="Lane_MailCentre" name="Mail Centre">
         <flowNodeRef>StartEvent_1</flowNodeRef>
         <flowNodeRef>Task_CategorizeInvoice</flowNodeRef>
         <flowNodeRef>Task_ForwardInvoiceToAdmin</flowNodeRef>
         <flowNodeRef>CatchEvent_EveryHour</flowNodeRef>
       </lane>

       <lane id="Lane_Administration" name="Administration Department">
         <flowNodeRef>SubProcess_ProcessInvoice</flowNodeRef>
         <flowNodeRef>Task_PutInCollectionBox</flowNodeRef>
       </lane>

       <lane id="Lane_DataEntry" name="Data Entry">
         <flowNodeRef>CatchEvent_DailyAt10am</flowNodeRef>
         <flowNodeRef>SubProcess_EnterDataInSAP</flowNodeRef>
       </lane>

       <lane id="Lane_Validation" name="Validation Office">
         <flowNodeRef>Task_ValidateInvoice</flowNodeRef>
       </lane>

       <lane id="Lane_Payment" name="Payment Office">
         <flowNodeRef>CatchEvent_Weekly</flowNodeRef>
         <flowNodeRef>SubProcess_ProcessPayment</flowNodeRef>
       </lane>

       <lane id="Lane_Registry" name="Registry Office">
         <flowNodeRef>Task_ArchiveInvoice</flowNodeRef>
         <flowNodeRef>EndEvent_1</flowNodeRef>
       </lane>
     </laneSet>

     <startEvent id="StartEvent_1" name="Invoice Received">
       <outgoing>SequenceFlow_Start_To_Categorize</outgoing>
       <messageEventDefinition/>
     </startEvent>

     <sequenceFlow id="SequenceFlow_Start_To_Categorize" sourceRef="StartEvent_1" targetRef="Task_CategorizeInvoice"/>

     <task id="Task_CategorizeInvoice" name="Categorize Invoice by Staff Member">
       <incoming>SequenceFlow_Start_To_Categorize</incoming>
       <outgoing>SequenceFlow_Categorize_To_Forward</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_Categorize_To_Forward" sourceRef="Task_CategorizeInvoice" targetRef="Task_ForwardInvoiceToAdmin"/>

     <task id="Task_ForwardInvoiceToAdmin" name="Forward Invoice to Administration Department">
       <incoming>SequenceFlow_Categorize_To_Forward</incoming>
       <outgoing>SequenceFlow_Forward_To_Process</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_Forward_To_Process" sourceRef="Task_ForwardInvoiceToAdmin" targetRef="SubProcess_ProcessInvoice"/>

     <subProcess id="SubProcess_ProcessInvoice" name="Process Invoice">
       <incoming>SequenceFlow_Forward_To_Process</incoming>
       <outgoing>SequenceFlow_Process_To_PutInBox</outgoing>
     </subProcess>

     <sequenceFlow id="SequenceFlow_Process_To_PutInBox" sourceRef="SubProcess_ProcessInvoice" targetRef="Task_PutInCollectionBox"/>

     <task id="Task_PutInCollectionBox" name="Put Invoices in Collection Box">
       <incoming>SequenceFlow_Process_To_PutInBox</incoming>
       <outgoing>SequenceFlow_PutInBox_To_DailyAt10am</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_PutInBox_To_DailyAt10am" sourceRef="Task_PutInCollectionBox" targetRef="CatchEvent_DailyAt10am"/>

     <intermediateCatchEvent id="CatchEvent_DailyAt10am">
       <incoming>SequenceFlow_PutInBox_To_DailyAt10am</incoming>
       <outgoing>SequenceFlow_DailyAt10am_To_EnterData</outgoing>
       <timerEventDefinition/>
     </intermediateCatchEvent>

     <sequenceFlow id="SequenceFlow_DailyAt10am_To_EnterData" sourceRef="CatchEvent_DailyAt10am" targetRef="SubProcess_EnterDataInSAP"/>

     <subProcess id="SubProcess_EnterDataInSAP" name="Enter Data in SAP">
       <incoming>SequenceFlow_DailyAt10am_To_EnterData</incoming>
       <outgoing>SequenceFlow_EnterData_To_EveryHour</outgoing>
     </subProcess>

     <sequenceFlow id="SequenceFlow_EnterData_To_EveryHour" sourceRef="SubProcess_EnterDataInSAP" targetRef="CatchEvent_EveryHour"/>

     <intermediateCatchEvent id="CatchEvent_EveryHour">
       <incoming>SequenceFlow_EnterData_To_EveryHour</incoming>
       <outgoing>SequenceFlow_EveryHour_To_ForwardForValidation</outgoing>
       <timerEventDefinition/>
     </intermediateCatchEvent>

     <sequenceFlow id="SequenceFlow_EveryHour_To_ForwardForValidation" sourceRef="CatchEvent_EveryHour" targetRef="Task_ForwardInvoiceForValidation"/>

     <task id="Task_ForwardInvoiceForValidation" name="Forward Invoice for Validation">
       <incoming>SequenceFlow_EveryHour_To_ForwardForValidation</incoming>
       <outgoing>SequenceFlow_ForwardForValidation_To_Validate</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_ForwardForValidation_To_Validate" sourceRef="Task_ForwardInvoiceForValidation" targetRef="Task_ValidateInvoice"/>

     <subProcess id="Task_ValidateInvoice" name="Validate Invoice">
       <incoming>SequenceFlow_ForwardForValidation_To_Validate</incoming>
       <outgoing>SequenceFlow_Validate_To_Weekly</outgoing>
     </subProcess>

     <sequenceFlow id="SequenceFlow_Validate_To_Weekly" sourceRef="Task_ValidateInvoice" targetRef="CatchEvent_Weekly"/>

     <intermediateCatchEvent id="CatchEvent_Weekly">
       <incoming>SequenceFlow_Validate_To_Weekly</incoming>
       <outgoing>SequenceFlow_Weekly_To_ProcessPayment</outgoing>
       <timerEventDefinition/>
     </intermediateCatchEvent>

     <sequenceFlow id="SequenceFlow_Weekly_To_ProcessPayment" sourceRef="CatchEvent_Weekly" targetRef="SubProcess_ProcessPayment"/>

     <subProcess id="SubProcess_ProcessPayment" name="Process Payment">
       <incoming>SequenceFlow_Weekly_To_ProcessPayment</incoming>
       <outgoing>SequenceFlow_ProcessPayment_To_Archive</outgoing>
     </subProcess>

     <sequenceFlow id="SequenceFlow_ProcessPayment_To_Archive" sourceRef="SubProcess_ProcessPayment" targetRef="Task_ArchiveInvoice"/>

     <task id="Task_ArchiveInvoice" name="Archive Invoice">
       <incoming>SequenceFlow_ProcessPayment_To_Archive</incoming>
       <outgoing>SequenceFlow_Archive_To_End</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_Archive_To_End" sourceRef="Task_ArchiveInvoice" targetRef="EndEvent_1"/>

     <endEvent id="EndEvent_1" name="Invoice Process Completed">
       <incoming>SequenceFlow_Archive_To_End</incoming>
     </endEvent>
   </process>
 </definitions>