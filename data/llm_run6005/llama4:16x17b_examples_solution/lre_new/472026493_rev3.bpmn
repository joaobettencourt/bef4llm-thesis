<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definitions" 
             targetNamespace="http://bpmn.io/schema/bpmn">
  <process id="Process_0od3h12" isExecutable="true">
    <laneSet>
      <lane id="Lane_IT_Department" name="IT Department">
        <flowNodeRef>StartEvent_1</flowNodeRef>
        <flowNodeRef>Task_Analyze_Request</flowNodeRef>
        <flowNodeRef>ExclusiveGateway_Denial_Approval</flowNodeRef>
        <flowNodeRef>EndEvent_Informed_About_Denial</flowNodeRef>
        <flowNodeRef>Task_Edit_and_Complete_Request</flowNodeRef>
        <flowNodeRef>IntermediateThrowEvent_Ask_Supplier_Prices</flowNodeRef>
        <flowNodeRef>Task_Prepare_Order</flowNodeRef>
        <flowNodeRef>IntermediateThrowEvent_Send_Order</flowNodeRef>
      </lane>
      <lane id="Lane_Management" name="Management">
        <flowNodeRef>Task_Analyze_Request_Management</flowNodeRef>
        <flowNodeRef>ExclusiveGateway_Management_Approval</flowNodeRef>
      </lane>
      <lane id="Lane_Finance" name="Finance">
        <flowNodeRef>Task_Find_Finance_Resources</flowNodeRef>
        <flowNodeRef>EndEvent_Pay_Invoice</flowNodeRef>
      </lane>
    </laneSet>

    <startEvent id="StartEvent_1" name="Receive Request for New HW">
      <outgoing>SequenceFlow_Start_To_Task_Analyze_Request</outgoing>
      <messageEventDefinition/>
    </startEvent>

    <sequenceFlow id="SequenceFlow_Start_To_Task_Analyze_Request"
                  sourceRef="StartEvent_1"
                  targetRef="Task_Analyze_Request"/>

    <task id="Task_Analyze_Request" name="Analyze Request">
      <incoming>SequenceFlow_Start_To_Task_Analyze_Request</incoming>
      <outgoing>SequenceFlow_Task_Analyze_Request_To_ExclusiveGateway_Denial_Approval</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_Task_Analyze_Request_To_ExclusiveGateway_Denial_Approval"
                  sourceRef="Task_Analyze_Request"
                  targetRef="ExclusiveGateway_Denial_Approval"/>

    <exclusiveGateway id="ExclusiveGateway_Denial_Approval">
      <incoming>SequenceFlow_Task_Analyze_Request_To_ExclusiveGateway_Denial_Approval</incoming>
      <outgoing>SequenceFlow_Approved</outgoing>
      <outgoing>SequenceFlow_Denied</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow_Denied"
                  sourceRef="ExclusiveGateway_Denial_Approval"
                  targetRef="EndEvent_Informed_About_Denial"/>

    <endEvent id="EndEvent_Informed_About_Denial" name="Inform about denial">
      <incoming>SequenceFlow_Denied</incoming>
      <messageEventDefinition/>
    </endEvent>

    <sequenceFlow id="SequenceFlow_Approved"
                  sourceRef="ExclusiveGateway_Denial_Approval"
                  targetRef="Task_Edit_and_Complete_Request"/>

    <task id="Task_Edit_and_Complete_Request" name="Edit and complete request">
      <incoming>SequenceFlow_Approved</incoming>
      <outgoing>SequenceFlow_Task_Edit_and_Complete_Request_To_IntermediateThrowEvent_Ask_Supplier_Prices</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_Task_Edit_and_Complete_Request_To_IntermediateThrowEvent_Ask_Supplier_Prices"
                  sourceRef="Task_Edit_and_Complete_Request"
                  targetRef="IntermediateThrowEvent_Ask_Supplier_Prices"/>

    <intermediateThrowEvent id="IntermediateThrowEvent_Ask_Supplier_Prices" name="Ask Supplier Prices">
      <incoming>SequenceFlow_Task_Edit_and_Complete_Request_To_IntermediateThrowEvent_Ask_Supplier_Prices</incoming>
      <outgoing>SequenceFlow_IntermediateThrowEvent_Ask_Supplier_Prices_To_Task_Fill_Form_Send_Management</outgoing>
      <messageEventDefinition/>
    </intermediateThrowEvent>

    <sequenceFlow id="SequenceFlow_IntermediateThrowEvent_Ask_Supplier_Prices_To_Task_Fill_Form_Send_Management"
                  sourceRef="IntermediateThrowEvent_Ask_Supplier_Prices"
                  targetRef="Task_Fill_Form_Send_Management"/>

    <task id="Task_Fill_Form_Send_Management" name="Fill Form Send Management">
      <incoming>SequenceFlow_IntermediateThrowEvent_Ask_Supplier_Prices_To_Task_Fill_Form_Send_Management</incoming>
      <outgoing>SequenceFlow_Task_Fill_Form_Send_Management_To_Task_Analyze_Request_Management</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_Task_Fill_Form_Send_Management_To_Task_Analyze_Request_Management"
                  sourceRef="Task_Fill_Form_Send_Management"
                  targetRef="Task_Analyze_Request_Management"/>

    <task id="Task_Analyze_Request_Management" name="Analyze Request Management">
      <incoming>SequenceFlow_Task_Fill_Form_Send_Management_To_Task_Analyze_Request_Management</incoming>
      <outgoing>SequenceFlow_Task_Analyze_Request_Management_To_ExclusiveGateway_Management_Approval</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_Task_Analyze_Request_Management_To_ExclusiveGateway_Management_Approval"
                  sourceRef="Task_Analyze_Request_Management"
                  targetRef="ExclusiveGateway_Management_Approval"/>

    <exclusiveGateway id="ExclusiveGateway_Management_Approval">
      <incoming>SequenceFlow_Task_Analyze_Request_Management_To_ExclusiveGateway_Management_Approval</incoming>
      <outgoing>SequenceFlow_Management_Approved</outgoing>
      <outgoing>SequenceFlow_Management_Not_Approved_Rework</outgoing>
      <outgoing>SequenceFlow_Management_Denied</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow_Management_Approved"
                  sourceRef="ExclusiveGateway_Management_Approval"
                  targetRef="Task_Prepare_Order"/>

    <task id="Task_Prepare_Order" name="Prepare Order">
      <incoming>SequenceFlow_Management_Approved</incoming>
      <outgoing>SequenceFlow_Task_Prepare_Order_To_IntermediateThrowEvent_Send_Order</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_Task_Prepare_Order_To_IntermediateThrowEvent_Send_Order"
                  sourceRef="Task_Prepare_Order"
                  targetRef="IntermediateThrowEvent_Send_Order"/>

    <intermediateThrowEvent id="IntermediateThrowEvent_Send_Order" name="Send Order">
      <incoming>SequenceFlow_Task_Prepare_Order_To_IntermediateThrowEvent_Send_Order</incoming>
      <outgoing>SequenceFlow_IntermediateThrowEvent_Send_Order_To_Task_Find_Finance_Resources</outgoing>
      <messageEventDefinition/>
    </intermediateThrowEvent>

    <sequenceFlow id="SequenceFlow_IntermediateThrowEvent_Send_Order_To_Task_Find_Finance_Resources"
                  sourceRef="IntermediateThrowEvent_Send_Order"
                  targetRef="Task_Find_Finance_Resources"/>

    <task id="Task_Find_Finance_Resources" name="Find Finance Resources">
      <incoming>SequenceFlow_IntermediateThrowEvent_Send_Order_To_Task_Find_Finance_Resources</incoming>
      <outgoing>SequenceFlow_Task_Find_Finance_Resources_To_EndEvent_Pay_Invoice</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_Task_Find_Finance_Resources_To_EndEvent_Pay_Invoice"
                  sourceRef="Task_Find_Finance_Resources"
                  targetRef="EndEvent_Pay_Invoice"/>

    <endEvent id="EndEvent_Pay_Invoice">
      <incoming>SequenceFlow_Task_Find_Finance_Resources_To_EndEvent_Pay_Invoice</incoming>
    </endEvent>

    <sequenceFlow id="SequenceFlow_Management_Not_Approved_Rework"
                  sourceRef="ExclusiveGateway_Management_Approval"
                  targetRef="Task_Edit_and_Complete_Request"/>

    <sequenceFlow id="SequenceFlow_Management_Denied"
                  sourceRef="ExclusiveGateway_Management_Approval"
                  targetRef="EndEvent_Informed_About_Denial"/>
  </process>
</definitions>