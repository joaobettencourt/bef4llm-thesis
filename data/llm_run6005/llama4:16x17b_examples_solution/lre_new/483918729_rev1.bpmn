<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/06-02-01.xsd" 
             id="definitions" name="BPMN Process Model" targetNamespace="http://bpmn.io/schema/bpmn">
   <collaboration id="Collaboration_1">
     <participant id="Participant_1" processRef="Process_1"/>
     <messageFlow id="MessageFlow_1" sourceRef="Customer" targetRef="StartEvent_1"/>
     <messageFlow id="MessageFlow_2" sourceRef="Task_2" targetRef="Customer"/>
     <messageFlow id="MessageFlow_3" sourceRef="Participant_0fxuytk" targetRef="SubProcess_1"/>
   </collaboration>
   <process id="Process_1" isExecutable="true">
     <laneSet>
       <lane id="Lane_1">
         <flowNodeRef>Task_1</flowNodeRef>
       </lane>
     </laneSet>
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
       <messageEventDefinition messageRef="Message_1"/>
     </startEvent>
     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>
     <task id="Task_1" name="Identify necessary parts">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="ExclusiveGateway_1"/>
     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_4</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_1" targetRef="Task_2">
       <conditionExpression xsi:type="tFormalExpression">${question.needed}</conditionExpression>
     </sequenceFlow>
     <task id="Task_2" name="Elicit information from customer">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_1" targetRef="Task_3"/>
     <task id="Task_3" name="Check availability">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_2" targetRef="Task_3"/>
     <exclusiveGateway id="ExclusiveGateway_2">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_7</outgoing>
       <outgoing>SequenceFlow_8</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_3" targetRef="ExclusiveGateway_2"/>
     <task id="Task_4" name="Record petition and order to Daisuki">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_7" sourceRef="ExclusiveGateway_2" targetRef="Task_4"/>
     <subProcess id="SubProcess_1" name="Order and receive part from Daisuki">
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_10</outgoing>
     </subProcess>
     <sequenceFlow id="SequenceFlow_8" sourceRef="ExclusiveGateway_2" targetRef="Task_5"/>
     <task id="Task_5" name="Supply to customer">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_11</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_4" targetRef="SubProcess_1"/>
     <sequenceFlow id="SequenceFlow_10" sourceRef="SubProcess_1" targetRef="Task_6"/>
     <task id="Task_6" name="Contact customer">
       <incoming>SequenceFlow_10</incoming>
       <outgoing>SequenceFlow_12</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_11" sourceRef="Task_5" targetRef="EndEvent_1"/>
     <sequenceFlow id="SequenceFlow_12" sourceRef="Task_6" targetRef="Task_7"/>
     <task id="Task_7" name="Receive final payment">
       <incoming>SequenceFlow_12</incoming>
       <outgoing>SequenceFlow_13</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_13" sourceRef="Task_7" targetRef="EndEvent_1"/>
     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_11</incoming>
       <incoming>SequenceFlow_13</incoming>
     </endEvent>
   </process>
   <message id="Message_1" name="Request from customer"/>
   <participant id="Customer" type="ParticipantType"/> 
  </definitions>