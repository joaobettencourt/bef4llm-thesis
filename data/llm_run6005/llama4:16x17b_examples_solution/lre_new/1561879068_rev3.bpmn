<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definition" name="BPMN Process Model" targetNamespace="http://example.com/bpmn">
  <process id="Process_1" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>
    <task id="Task_1" name="Check availability of products and credit rating">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="ExclusiveGateway_1"/>
    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
      <outgoing>SequenceFlow_4</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_1">
      <conditionExpression xsi:type="tFormalExpression">${creditRating > 9000}</conditionExpression>
    </sequenceFlow>
    <endEvent id="EndEvent_1">
      <incoming>SequenceFlow_3</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_1" targetRef="Task_2"/>
    <task id="Task_2" name="Create interim customer dataset record">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_5</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_5" sourceRef="Task_2" targetRef="ParallelGateway_1"/>
    <parallelGateway id="ParallelGateway_1">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_6</outgoing>
      <outgoing>SequenceFlow_7</outgoing>
    </parallelGateway>
    <sequenceFlow id="SequenceFlow_6" sourceRef="ParallelGateway_1" targetRef="SubProcess_1"/>
    <subProcess id="SubProcess_1" name="Device provision process">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </subProcess>
    <sequenceFlow id="SequenceFlow_8" sourceRef="SubProcess_1" targetRef="ParallelGateway_2"/>
    <parallelGateway id="ParallelGateway_2">
      <incoming>SequenceFlow_8</incoming>
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_10</outgoing>
    </parallelGateway>
    <sequenceFlow id="SequenceFlow_7" sourceRef="ParallelGateway_1" targetRef="SubProcess_2"/>
    <subProcess id="SubProcess_2" name="Register customer account at ISP nodes">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_9</outgoing>
    </subProcess>
    <sequenceFlow id="SequenceFlow_9" sourceRef="SubProcess_2" targetRef="ParallelGateway_2"/>
    <task id="Task_3" name="Create and send Welcome-Package">
      <incoming>SequenceFlow_10</incoming>
      <outgoing>SequenceFlow_11</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_10" sourceRef="ParallelGateway_2" targetRef="Task_3"/>
    <endEvent id="EndEvent_2">
      <incoming>SequenceFlow_11</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_11" sourceRef="Task_3" targetRef="EndEvent_2"/>
  </process>
</definitions>