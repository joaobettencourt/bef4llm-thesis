<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definition" name="BPMN Process Model">
  <process id="Process_1" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>
    <task id="Task_1" name="Receive expense report">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="ExclusiveGateway_1"/>
    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
      <outgoing>SequenceFlow_28</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_1" targetRef="IntermediateThrowEvent_1">
      <conditionExpression xsi:type="tFormalExpression">${daysPassed >= 28}</conditionExpression>
    </sequenceFlow>
    <intermediateThrowEvent id="IntermediateThrowEvent_1" name="Send resubmit email">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_4</outgoing>
      <messageEventDefinition/>
    </intermediateThrowEvent>
    <sequenceFlow id="SequenceFlow_4" sourceRef="IntermediateThrowEvent_1" targetRef="EndEvent_2"/>
    <endEvent id="EndEvent_2">
      <incoming>SequenceFlow_4</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_28" sourceRef="ExclusiveGateway_1" targetRef="Task_3"/>
    <task id="Task_3" name="Check if employee has an account">
      <incoming>SequenceFlow_28</incoming>
      <outgoing>SequenceFlow_5</outgoing>
      <outgoing>SequenceFlow_29</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_5" sourceRef="Task_3" targetRef="Task_4">
      <conditionExpression xsi:type="tFormalExpression">${hasAccount == true}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="SequenceFlow_29" sourceRef="Task_3" targetRef="Task_5"/>
    <task id="Task_5" name="Create new account">
      <incoming>SequenceFlow_29</incoming>
      <outgoing>SequenceFlow_30</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_30" sourceRef="Task_5" targetRef="Task_4"/>
    <task id="Task_4" name="Review expense report">
      <incoming>SequenceFlow_5</incoming>
      <incoming>SequenceFlow_30</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_6" sourceRef="Task_4" targetRef="ExclusiveGateway_2"/>
    <exclusiveGateway id="ExclusiveGateway_2">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_7</outgoing>
      <outgoing>SequenceFlow_8</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_7" sourceRef="ExclusiveGateway_2" targetRef="EndEvent_1">
      <conditionExpression xsi:type="tFormalExpression">${expenseAmount <= 200}</conditionExpression>
    </sequenceFlow>
    <endEvent id="EndEvent_1">
      <incoming>SequenceFlow_7</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_8" sourceRef="ExclusiveGateway_2" targetRef="Task_6"/>
    <task id="Task_6" name="Request approval from supervisor">
      <incoming>SequenceFlow_8</incoming>
      <outgoing>SequenceFlow_9</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_9" sourceRef="Task_6" targetRef="ExclusiveGateway_3"/>
    <exclusiveGateway id="ExclusiveGateway_3">
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_10</outgoing>
      <outgoing>SequenceFlow_11</outgoing>
      <outgoing>SequenceFlow_12</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_10" sourceRef="ExclusiveGateway_3" targetRef="Task_7">
      <conditionExpression xsi:type="tFormalExpression">${approvalStatus == 'approved' && daysPassed <= 7}</conditionExpression>
    </sequenceFlow>
    <task id="Task_7" name="Send approved notification and reimburse employee">
      <incoming>SequenceFlow_10</incoming>
      <outgoing>SequenceFlow_13</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_13" sourceRef="Task_7" targetRef="EndEvent_1"/>
    <sequenceFlow id="SequenceFlow_11" sourceRef="ExclusiveGateway_3" targetRef="Task_8">
      <conditionExpression xsi:type="tFormalExpression">${approvalStatus == 'rejected' && daysPassed <= 7}</conditionExpression>
    </sequenceFlow>
    <task id="Task_8" name="Send rejection email to employee">
      <incoming>SequenceFlow_11</incoming]
    </task>
    <intermediateCatchEvent id="IntermediateCatchEvent_1" name="Send approval in progress email">
      <incoming>SequenceFlow_12</incoming>
      <outgoing>SequenceFlow_14</outgoing>
      <timerEventDefinition/>
    </intermediateCatchEvent>
    <sequenceFlow id="SequenceFlow_14" sourceRef="IntermediateCatchEvent_1" targetRef="Task_6"/>
  </process>
</definitions>