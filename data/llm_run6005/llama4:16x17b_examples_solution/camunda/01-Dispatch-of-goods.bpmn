<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" 
             targetNamespace="http://bpmn.io/schema/bpmn">
  <process id="Process_1" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_0vaxgaa"/>
    <task id="Task_0vaxgaa" name="Clarify shipment method">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_0vaxgaa" targetRef="ExclusiveGateway_1"/>
    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
      <outgoing>SequenceFlow_4</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_1" targetRef="Task_0e6hvnj">
      <conditionExpression xsi:type="tFormalExpression">shipmentType == 'special'</conditionExpression>
    </sequenceFlow>
    <task id="Task_0e6hvnj" name="Get 3 offers from logistic companies">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_5</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_5" sourceRef="Task_0e6hvnj" targetRef="Task_0s79ile"/>
    <task id="Task_0s79ile" name="Select logistic company and place order">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_6" sourceRef="Task_0s79ile" targetRef="ParallelGateway_1"/>
    <parallelGateway id="ParallelGateway_1">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_7</outgoing>
      <outgoing>SequenceFlow_8</outgoing>
    </parallelGateway>
    <sequenceFlow id="SequenceFlow_7" sourceRef="ParallelGateway_1" targetRef="Task_05ftug5"/>
    <task id="Task_05ftug5" name="Package goods">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_9</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_8" sourceRef="ParallelGateway_1" targetRef="Task_0jsoxba"/>
    <task id="Task_0jsoxba" name="Write package label">
      <incoming>SequenceFlow_8</incoming>
      <outgoing>SequenceFlow_10</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_9" sourceRef="Task_05ftug5" targetRef="ExclusiveGateway_2"/>
    <exclusiveGateway id="ExclusiveGateway_2">
      <incoming>SequenceFlow_9</incoming>
      <incoming>SequenceFlow_10</incoming>
      <outgoing>SequenceFlow_11</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_10" sourceRef="Task_0jsoxba" targetRef="ExclusiveGateway_2"/>
    <task id="Task_12j0pib" name="Insure parcel if necessary">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_12</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_1" targetRef="Task_12j0pib">
      <conditionExpression xsi:type="tFormalExpression">shipmentType == 'normal'</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="SequenceFlow_11" sourceRef="ExclusiveGateway_2" targetRef="Task_0sl26uo"/>
    <task id="Task_0sl26uo" name="Prepare for picking up goods">
      <incoming>SequenceFlow_11</incoming>
    </task>
    <endEvent id="EndEvent_1">
      <incoming>SequenceFlow_12</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_12" sourceRef="Task_0sl26uo" targetRef="EndEvent_1"/>
  </process>
</definitions>