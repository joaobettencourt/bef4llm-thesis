<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="BPMN Process Model">
   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
       <messageEventDefinition/>
     </startEvent>
     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>
     <task id="Task_1" name="Get information about possible subrogation">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="ExclusiveGateway_1"/>
     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_4</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_1" targetRef="Task_2">
       <conditionExpression xsi:type="tFormalExpression">subrogationPossible  == true</conditionExpression>
     </sequenceFlow>
     <task id="Task_2" name="Check case and send request for payment">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_2">
       <conditionExpression xsi:type="tFormalExpression">subrogationPossible  == false</conditionExpression>
     </sequenceFlow>
     <endEvent id="EndEvent_2">
       <incoming>SequenceFlow_4</incoming>
     </endEvent>
     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_2" targetRef="ParallelGateway_1"/>
     <parallelGateway id="ParallelGateway_1">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_6</outgoing>
       <outgoing>SequenceFlow_7</outgoing>
     </parallelGateway>
     <sequenceFlow id="SequenceFlow_6" sourceRef="ParallelGateway_1" targetRef="Task_3"/>
     <task id="Task_3" name="Send reminder and make booking">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_8</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_7" sourceRef="ParallelGateway_1" targetRef="EventBasedGateway_1"/>
     <eventBasedGateway id="EventBasedGateway_1">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_9</outgoing>
       <outgoing>SequenceFlow_10</outgoing>
       <outgoing>SequenceFlow_11</outgoing>
     </eventBasedGateway>
     <intermediateCatchEvent id="IntermediateCatchEvent_1" name="Disagreement letter received">
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_12</outgoing>
       <messageEventDefinition/>
     </intermediateCatchEvent>
     <sequenceFlow id="SequenceFlow_9" sourceRef="EventBasedGateway_1" targetRef="IntermediateCatchEvent_1"/>
     <task id="Task_4" name="Check reasoning">
       <incoming>SequenceFlow_12</incoming>
       <outgoing>SequenceFlow_13</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_12" sourceRef="IntermediateCatchEvent_1" targetRef="Task_4"/>
     <exclusiveGateway id="ExclusiveGateway_2">
       <incoming>SequenceFlow_13</incoming>
       <outgoing>SequenceFlow_14</outgoing>
       <outgoing>SequenceFlow_15</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_13" sourceRef="Task_4" targetRef="ExclusiveGateway_2"/>
     <endEvent id="EndEvent_3">
       <incoming>SequenceFlow_14</incoming>
     </endEvent>
     <sequenceFlow id="SequenceFlow_14" sourceRef="ExclusiveGateway_2" targetRef="EndEvent_3"> 
       <conditionExpression xsi:type="tFormalExpression">isValid  == true</conditionExpression>
     </sequenceFlow>
     <task id="Task_5" name="Hand over to collection agency">
       <incoming>SequenceFlow_15</incoming>
       <outgoing>SequenceFlow_16</outgoing>
     </task>
     <endEvent id="EndEvent_4">
       <incoming>SequenceFlow_16</incoming>
     </endEvent>
     <sequenceFlow id="SequenceFlow_15" sourceRef="ExclusiveGateway_2" targetRef="Task_5"> 
       <conditionExpression xsi:type="tFormalExpression">isValid  == false</conditionExpression>
     </sequenceFlow>
     <sequenceFlow id="SequenceFlow_16" sourceRef="Task_5" targetRef="EndEvent_4"/>
     <intermediateCatchEvent id="IntermediateCatchEvent_2" name="Deadline for disagreement reached">
       <incoming>SequenceFlow_10</incoming>
       <outgoing>SequenceFlow_17</outgoing>
       <timerEventDefinition/>
     </intermediateCatchEvent>
     <sequenceFlow id="SequenceFlow_10" sourceRef="EventBasedGateway_1" targetRef="IntermediateCatchEvent_2"/>
     <task id="Task_6">
       <incoming>SequenceFlow_17</incoming>
       <outgoing>SequenceFlow_18</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_17" sourceRef="IntermediateCatchEvent_2" targetRef="Task_6"/>
     <sequenceFlow id="SequenceFlow_18" sourceRef="Task_6" targetRef="EndEvent_4"/>
     <intermediateCatchEvent id="IntermediateCatchEvent_3" name="Money received">
       <incoming>SequenceFlow_11</incoming>
       <outgoing>SequenceFlow_19</outgoing>
       <messageEventDefinition/>
     </intermediateCatchEvent>
     <sequenceFlow id="SequenceFlow_11" sourceRef="EventBasedGateway_1" targetRef="IntermediateCatchEvent_3"/>
     <task id="Task_7">
       <incoming>SequenceFlow_19</incoming>
       <outgoing>SequenceFlow_20</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_19" sourceRef="IntermediateCatchEvent_3" targetRef="Task_7"/>
     <endEvent id="EndEvent_5">
       <incoming>SequenceFlow_20</incoming>
     </endEvent>
     <sequenceFlow id="SequenceFlow_20" sourceRef="Task_7" targetRef="EndEvent_5"/>
   </process>
</definitions>