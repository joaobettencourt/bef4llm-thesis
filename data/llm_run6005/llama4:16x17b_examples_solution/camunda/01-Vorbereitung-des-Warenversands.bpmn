             id="definition" 
             targetNamespace="http://bpmn.io/schema/bpmn">
  <process id="Process_1" isExecutable="true">
    <laneSet>
      <lane id="Lane_1" name="Sekretariat">
        <flowNodeRef>Task_0vaxgaa</flowNodeRef>
        <flowNodeRef>Task_0e6hvnj</flowNodeRef>
        <flowNodeRef>Task_0s79ile</flowNodeRef>
        <flowNodeRef>Task_0jsoxba</flowNodeRef>
        <flowNodeRef>ExclusiveGateway_1mpgzhg</flowNodeRef>
      </lane>
      <lane id="Lane_2" name="Leiter Logistik">
        <flowNodeRef>Task_12j0pib</flowNodeRef>
      </lane>
      <lane id="Lane_3" name="Lagerarbeiter">
        <flowNodeRef>Task_05ftug5</flowNodeRef>
        <flowNodeRef>Task_0sl26uo</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_0vaxgaa"/>
    <task id="Task_0vaxgaa" name="Versandart klären">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_0vaxgaa" targetRef="ExclusiveGateway_1mpgzhg"/>
    <exclusiveGateway id="ExclusiveGateway_1mpgzhg">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
      <outgoing>SequenceFlow_4</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_1mpgzhg" targetRef="Task_0e6hvnj">
      <conditionExpression xsi:type="tFormalExpression">große Menge</conditionExpression>
    </sequenceFlow>
    <task id="Task_0e6hvnj" name="Angebote von 3 Spediteuren einholen">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_5</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_5" sourceRef="Task_0e6hvnj" targetRef="Task_0s79ile"/>
    <task id="Task_0s79ile" name="Spediteur beauftragen">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_6" sourceRef="Task_0s79ile" targetRef="ParallelGateway_1"/>
    <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_1mpgzhg" targetRef="InclusiveGateway_0p2e5vq">
      <conditionExpression xsi:type="tFormalExpression">kleine Menge</conditionExpression>
    </sequenceFlow>
    <inclusiveGateway id="InclusiveGateway_0p2e5vq">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_7</outgoing>
      <outgoing>SequenceFlow_8</outgoing>
    </inclusiveGateway>
    <task id="Task_0jsoxba" name="Paketschein ausfüllen">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_9</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_7" sourceRef="InclusiveGateway_0p2e5vq" targetRef="Task_0jsoxba"/>
    <sequenceFlow id="SequenceFlow_8" sourceRef="InclusiveGateway_0p2e5vq" targetRef="Task_12j0pib">
      <conditionExpression xsi:type="tFormalExpression">Versicherung erforderlich</conditionExpression>
    </sequenceFlow>
    <task id="Task_12j0pib" name="Versicherung abschließen">
      <incoming>SequenceFlow_8</incoming>
      <outgoing>SequenceFlow_10</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_9" sourceRef="Task_0jsoxba" targetRef="ParallelGateway_1"/>
    <parallelGateway id="ParallelGateway_1">
      <incoming>SequenceFlow_6</incoming>
      <incoming>SequenceFlow_10</incoming>
      <outgoing>SequenceFlow_11</outgoing>
      <outgoing>SequenceFlow_12</outgoing>
    </parallelGateway>
    <sequenceFlow id="SequenceFlow_10" sourceRef="Task_12j0pib" targetRef="ParallelGateway_1"/>
    <task id="Task_05ftug5" name="Ware verpacken">
      <incoming>SequenceFlow_11</incoming>
      <outgoing>SequenceFlow_13</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_11" sourceRef="ParallelGateway_1" targetRef="Task_05ftug5"/>
    <task id="Task_0sl26uo" name="Ware bereitstellen">
      <incoming>SequenceFlow_13</incoming>
    </task>
    <sequenceFlow id="SequenceFlow_12" sourceRef="ParallelGateway_1" targetRef="Task_0sl26uo"/>
    <sequenceFlow id="SequenceFlow_13" sourceRef="Task_05ftug5" targetRef="Task_0sl26uo"/>
    <endEvent id="EndEvent_1">
      <incoming>SequenceFlow_14</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_14" sourceRef="Task_0sl26uo" targetRef="EndEvent_1"/>
  </process>
