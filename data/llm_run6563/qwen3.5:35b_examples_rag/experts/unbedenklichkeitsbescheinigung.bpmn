<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Unbedenklichkeitsbescheinigung Prozess" processRef="Process_1" />
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Anfrage eingegangen">
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_InitProcess" name="Prozess initialisieren &amp; Zähler setzen">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="ExclusiveGateway_CheckSender" name="Person im System?">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_TransferNoSender</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_CreateLetter" name="Anschreiben erstellen">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TransferNoRole</bpmn:outgoing>
    </bpmn:task>

    <bpmn:userTask id="UserTask_TransferCaseWorker" name="Fall an Sachbearbeiter übergeben">
      <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndTransfer</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndEvent_Transfer" name="Fall an Sachbearbeiter übergeben">
      <bpmn:incoming>SequenceFlow_EndTransfer</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:exclusiveGateway id="ExclusiveGateway_CheckRole" name="Arbeitgeber-Rolle?">
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CheckInsuranceTimes</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="ServiceTask_CheckInsurance" name="Versicherungszeiten prüfen">
      <bpmn:incoming>SequenceFlow_CheckInsuranceTimes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="ExclusiveGateway_ProofsCount" name="Anzahl Nachweise korrekt?">
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckAmounts</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_TransferProofError</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="ServiceTask_CheckContribution" name="Beitragshöhe prüfen">
      <bpmn:incoming>SequenceFlow_CheckAmounts</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="ExclusiveGateway_Doubts" name="Unsicherheiten Betrag?">
      <bpmn:incoming>SequenceFlow_7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckEstimates</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SkipEstimateCheck</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="ServiceTask_CheckEstimates" name="Beitragsschätzungen prüfen">
      <bpmn:incoming>SequenceFlow_CheckEstimates</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_8</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="ExclusiveGateway_MergeCheck" name="">
      <bpmn:incoming>SequenceFlow_SkipEstimateCheck</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_8</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckClaims</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="ServiceTask_CheckOutstanding" name="Offene Forderungen prüfen">
      <bpmn:incoming>SequenceFlow_CheckClaims</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Assessment</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="ExclusiveGateway_Assess" name="Bewertung der Unbedenklichkeit">
      <bpmn:incoming>SequenceFlow_Assessment</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_IssueFullCert</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_IssuePartialCert</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_TransferAssessmentFail</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_IssueFull" name="Bescheinigung ausstellen (Vollständig)">
      <bpmn:incoming>SequenceFlow_IssueFullCert</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_LogHistory1</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_IssuePartial" name="Bescheinigung ausstellen (Mit Hinweis)">
      <bpmn:incoming>SequenceFlow_IssuePartialCert</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_LogHistory2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="ExclusiveGateway_MergeLog" name="">
      <bpmn:incoming>SequenceFlow_LogHistory1</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_LogHistory2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_LogHistory" name="Eintrag in Kontakthistorie">
      <bpmn:incoming>SequenceFlow_9</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndCertIssued</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_Cert" name="Bescheinigung ausgestellt">
      <bpmn:incoming>SequenceFlow_EndCertIssued</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_InitProcess" />
    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="Task_InitProcess" targetRef="ExclusiveGateway_CheckSender" />

    <!-- Sender Check -->
    <bpmn:sequenceFlow id="SequenceFlow_TransferNoSender" name="Nein (Person nicht bekannt)" sourceRef="ExclusiveGateway_CheckSender" targetRef="UserTask_TransferCaseWorker">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!personKnown}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_3" name="Ja (Person bekannt)" sourceRef="ExclusiveGateway_CheckSender" targetRef="ExclusiveGateway_CheckRole">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${personKnown}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Role Check -->
    <bpmn:sequenceFlow id="SequenceFlow_4" name="Nein (Keine Arbeitgeber-Rolle)" sourceRef="ExclusiveGateway_CheckRole" targetRef="Task_CreateLetter">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!isEmployer}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_CheckInsuranceTimes" name="Ja (Arbeitgeber-Rolle)" sourceRef="ExclusiveGateway_CheckRole" targetRef="ServiceTask_CheckInsurance">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${isEmployer}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Transfer Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_TransferNoRole" sourceRef="Task_CreateLetter" targetRef="UserTask_TransferCaseWorker">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="UserTask_TransferCaseWorker" targetRef="EndEvent_Transfer">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Checks -->
    <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="ServiceTask_CheckInsurance" targetRef="ExclusiveGateway_ProofsCount">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Proofs Check -->
    <bpmn:sequenceFlow id="SequenceFlow_TransferProofError" name="Nein (Anzahl falsch)" sourceRef="ExclusiveGateway_ProofsCount" targetRef="UserTask_TransferCaseWorker">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!proofsCorrect}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_CheckAmounts" name="Ja (Anzahl korrekt)" sourceRef="ExclusiveGateway_ProofsCount" targetRef="ServiceTask_CheckContribution">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${proofsCorrect}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Amount Check -->
    <bpmn:sequenceFlow id="SequenceFlow_7" sourceRef="ServiceTask_CheckContribution" targetRef="ExclusiveGateway_Doubts">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Doubts Check -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckEstimates" name="Ja (Unsicherheiten)" sourceRef="ExclusiveGateway_Doubts" targetRef="ServiceTask_CheckEstimates">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${hasDoubts}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_SkipEstimateCheck" name="Nein (Keine Unsicherheiten)" sourceRef="ExclusiveGateway_Doubts" targetRef="ExclusiveGateway_MergeCheck">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!hasDoubts}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Merge -->
    <bpmn:sequenceFlow id="SequenceFlow_8" sourceRef="ServiceTask_CheckEstimates" targetRef="ExclusiveGateway_MergeCheck">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Claims Check -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckClaims" sourceRef="ExclusiveGateway_MergeCheck" targetRef="ServiceTask_CheckOutstanding">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Assessment -->
    <bpmn:sequenceFlow id="SequenceFlow_Assessment" sourceRef="ServiceTask_CheckOutstanding" targetRef="ExclusiveGateway_Assess">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Assessment Outcomes -->
    <bpmn:sequenceFlow id="SequenceFlow_IssueFullCert" name="Vollständige Unbedenklichkeit" sourceRef="ExclusiveGateway_Assess" targetRef="Task_IssueFull">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${fullStanding}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_TransferAssessmentFail" name="Voraussetzungen nicht erfüllt" sourceRef="ExclusiveGateway_Assess" targetRef="UserTask_TransferCaseWorker">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!prerequisitesMet}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_IssuePartialCert" name="Offene Beträge / Unvollständig" sourceRef="ExclusiveGateway_Assess" targetRef="Task_IssuePartial">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${partialStanding}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Logging & End -->
    <bpmn:sequenceFlow id="SequenceFlow_LogHistory1" sourceRef="Task_IssueFull" targetRef="ExclusiveGateway_MergeLog">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_LogHistory2" sourceRef="Task_IssuePartial" targetRef="ExclusiveGateway_MergeLog">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_9" sourceRef="ExclusiveGateway_MergeLog" targetRef="Task_LogHistory">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_EndCertIssued" sourceRef="Task_LogHistory" targetRef="EndEvent_Cert">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>