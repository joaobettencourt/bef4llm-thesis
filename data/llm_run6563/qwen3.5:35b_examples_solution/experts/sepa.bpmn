<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1a8j3f5">
    <bpmn:participant id="Participant_2s4y6v0" name="SEPA-Mandat Bearbeitung" processRef="Process_3k9m7l4" />
  </bpmn:collaboration>

  <bpmn:process id="Process_3k9m7l4" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1x2y0z8" name="Daten für SEPA-Mandat eingegangen">
      <bpmn:outgoing>SequenceFlow_5h7j9p4</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- IBAN Check & Country Determination -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_8q1w3e4" name="IBAN vorhanden?">
      <bpmn:incoming>SequenceFlow_5h7j9p4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6t9r0u2</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_1k4l8m2</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Script Task for Country Determination -->
    <bpmn:scriptTask id="ScriptTask_3k8m2q1" name="Land aus IBAN ermitteln">
      <bpmn:incoming>SequenceFlow_6t9r0u2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_7y5u9i3</bpmn:outgoing>
    </bpmn:scriptTask>

    <!-- Person Search -->
    <bpmn:userTask id="UserTask_2p6o9i3" name="Person im System suchen">
      <bpmn:incoming>SequenceFlow_7y5u9i3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0j7h5g2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Data Validation Gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_1x4l6m8" name="Alle Daten vollständig?">
      <bpmn:incoming>SequenceFlow_0j7h5g2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_9w3e5t1</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_4v8t0r7</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Manual Check for Missing Signature -->
    <bpmn:userTask id="UserTask_5r7t9y1" name="Manuelle Prüfung fehlender Daten">
      <bpmn:incoming>SequenceFlow_4v8t0r7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3u5y9i0</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Automatic Letter for Missing Signature -->
    <bpmn:serviceTask id="ServiceTask_8q1w2e4" name="Schreiben zur Unterschrift anfordern">
      <bpmn:incoming>SequenceFlow_9w3e5t1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_7k2j4h6</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Timer Boundary Event for 28 Days -->
    <bpmn:boundaryEvent id="BoundaryEvent_1m3d5f" attachedToRef="ServiceTask_8q1w2e4">
      <bpmn:outgoing>SequenceFlow_0a6g8h9</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P28D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>

    <!-- Receive Task for Feedback -->
    <bpmn:receiveTask id="ReceiveTask_0z7x9c1" name="Auf Rückmeldung warten">
      <bpmn:incoming>SequenceFlow_7k2j4h6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_8w1e3r5</bpmn:outgoing>
    </bpmn:receiveTask>

    <!-- Bank Connection Check -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_2a4s6d8" name="Bankverbindung gültig?">
      <bpmn:incoming>SequenceFlow_3u5y9i0</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1q3w5e7</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_6t8r2y4</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Manual Bank Check -->
    <bpmn:userTask id="UserTask_9i1u3o5" name="Bankverbindung manuell prüfen">
      <bpmn:incoming>SequenceFlow_6t8r2y4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0p2l4k6</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Create Bank Connection -->
    <bpmn:serviceTask id="ServiceTask_7j9h1g3" name="Bankverbindung anlegen">
      <bpmn:incoming>SequenceFlow_0p2l4k6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5f8d2s1</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Existing Mandate Check -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_4k6j8h0" name="Aktives SEPA-Mandat existiert?">
      <bpmn:incoming>SequenceFlow_5f8d2s1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3l9m7