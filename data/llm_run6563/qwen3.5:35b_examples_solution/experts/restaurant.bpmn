<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1a8j3f5" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1k9m7l4">
    <bpmn:participant id="Participant_gast" name="Gast - Nahrungsaufnahme" processRef="Process_Gast"/>
    <bpmn:participant id="Participant_angestellter" name="Angestellter - Bestellungsbearbeitung" processRef="Process_Angestellter"/>
    <bpmn:participant id="Participant_koch" name="Koch - Mahlzeitzubereitung" processRef="Process_Koch"/>
    
    <!-- Message Flows between participants -->
    <bpmn:messageFlow id="Message_1_GastToAngestellter_BestellungAufgeben" sourceRef="Task_gast_bestellen" targetRef="Start_Angestellter_Empfangen"/>
    <bpmn:messageFlow id="Message_2_AngestellterZuGast_PieperUebergeben" sourceRef="Task_angestellter_pieferuebergeben" targetRef="Event_gast_wartenAufPieper"/>
    <bpmn:messageFlow id="Message_3_AngestellterZuKoch_BestellungInformieren" sourceRef="Task_angestellter_kocheninformieren" targetRef="Start_Koch_Zubereiten"/>
    <bpmn:messageFlow id="Message_4_KochZuAngestellter_FertigMelden" sourceRef="Task_koch_fertigmelden" targetRef="Event_Angestellter_WartenAufFertig"/>
  </bpmn:collaboration>

  <!-- Guest Process -->
  <bpmn:process id="Process_Gast" isExecutable="false">
    <bpmn:startEvent id="Start_gast_Hunger" name="Hunger festgestellt">
      <bpmn:outgoing>Sequence_1_StartZuBetreten</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_gast_BetretenRestaurant" name="Restaurant betreten">
      <bpmn:incoming>Sequence_1_StartZuBetreten</bpmn:incoming>
      <bpmn:outgoing>Sequence_2_ZumAuswahlen</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_gast_GerichtAussuchen" name="Gericht auswählen">
      <bpmn:incoming>Sequence_2_ZumAuswahlen</bpmn:incoming>
      <bpmn:outgoing>Sequence_3_WartenAufReihe</bpmn:outgoing>
    </bpmn:task>

    <bpmn:intermediateCatchEvent id="Event_gast_Reihe" name="An der Reihe">
      <bpmn:incoming>Sequence_3_WartenAufReihe</bpmn:incoming>
      <bpmn:outgoing>Sequence_4_Bestellen</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:task id="Task_gast_bestellen" name="Bestellung aufgeben">
      <bpmn:incoming>Sequence_4_Bestellen</bpmn:incoming>
      <bpmn:outgoing>Sequence_5_PieperErhalten</bpmn:outgoing>
    </bpmn:task>

    <bpmn:intermediateCatchEvent id="Event_gast_wartenAufPieper" name="Warte auf Pieper">
      <bpmn:incoming>Sequence_5_PieperErhalten</bpmn:incoming>
      <bpmn:outgoing>Sequence_6_EssenAbholen</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:task id="Task_gast_abholen" name="Essen abholen">
      <bpmn:incoming>Sequence_6_EssenAbholen</bpmn:incoming>
      <bpmn:outgoing>Sequence_7_Verzehren</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_gast_verzehren" name="Mahlzeit verzehren">
      <bpmn:incoming>Sequence_7_Verzehren</bpmn:incoming>
      <bpmn:outgoing>Sequence_8_Ende</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="End_gast_HungerGestillt" name="Hunger gestillt">
      <bpmn:incoming>Sequence_8_Ende</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Sequence_1_StartZuBetreten" sourceRef="Start_gast_Hunger" targetRef="Task_gast_BetretenRestaurant"/>
    <bpmn:sequenceFlow id="Sequence_2_ZumAuswahlen" sourceRef="Task_gast_BetretenRestaurant" targetRef="Task_gast_GerichtAussuchen"/>
    <bpmn:sequenceFlow id="Sequence_3_WartenAufReihe" sourceRef="Task_gast_GerichtAussuchen" targetRef="Event_gast_Reihe"/>
    <bpmn:sequenceFlow id="Sequence_4_Bestellen" sourceRef="Event_gast_Reihe" targetRef="Task_gast_bestellen"/>
    <bpmn:sequenceFlow id="Sequence_5_PieperErhalten" sourceRef="Task_gast_bestellen" targetRef="Event_gast_wartenAufPieper"/>
    <bpmn:sequenceFlow id="Sequence_6_EssenAbholen" sourceRef="Event_gast_wartenAufPieper" targetRef="Task_gast_abholen"/>
    <bpmn:sequenceFlow id="Sequence_7_Verzehren" sourceRef="Task_gast_abholen" targetRef="Task_gast_verzehren"/>
    <bpmn:sequenceFlow id="Sequence_8_Ende" sourceRef="Task_gast_verzehren" targetRef="End_gast_HungerGestillt"/>

  </bpmn:process>

  <!-- Employee Process -->
  <bpmn:process id="Process_Angestellter">
    <bpmn:startEvent id="Start_Angestellter_Empfangen" name="Bestellung erhalten">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>Sequence_1_BestellenEingeben</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_angestellter_kassieren" name="Bestellung eingeben und kassieren">
      <bpmn:incoming>Sequence_1_BestellenEingeben</bpmn:incoming>
      <bpmn:outgoing>Sequence_2_PieperEinstellen</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_angestellter_pieferstellen" name="Pieper einstellen">
      <bpmn:incoming>Sequence_2_PieperEinstellen</bpmn:incoming>
      <bpmn:outgoing>Sequence_3_Pieperuebergeben</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_angestellter_pieferuebergeben" name="Pieper übergeben">
      <bpmn:incoming>Sequence_3_Pieperuebergeben</bpmn:incoming>
      <bpmn:outgoing>Sequence_4_KochenInformieren</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_angestellter_kocheninformieren" name="Koch informieren">
      <bpmn:incoming>Sequence_4_KochenInformieren</bpmn:incoming>
      <bpmn:outgoing>Sequence_5_WartenAufFertig</bpmn:outgoing>
    </bpmn:task>

    <bpmn:intermediateCatchEvent id="Event_Angestellter_WartenAufFertig" name="Essen fertig">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>Sequence_5_WartenAufFertig</bpmn:incoming>
      <bpmn:outgoing>Sequence_6_PieperAusloesen</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:task id="Task_angestellter_pieferausloesen" name="Pieper auslösen">
      <bpmn:incoming>Sequence_6_PieperAusloesen</bpmn:incoming>
      <bpmn:outgoing>Sequence_7_EventBasedGateway</bpmn:outgoing>
    </bpmn:task>

    <bpmn:eventBasedGateway id="Event_Based_Gateway_Ausrufen" name="Kunde erscheint oder Timeout">
      <bpmn:incoming>Sequence_7_EventBasedGateway</bpmn:incoming>
      <bpmn:outgoing>Sequence_8_KundeErscheint</bpmn:outgoing>
      <bpmn:outgoing>Sequence_9_Timeout5Minuten</bpmn:outgoing>
    </bpmn:eventBasedGateway>

    <bpmn:intermediateCatchEvent id="Event_Angestellter_KundeErscheint" name="Kunde erscheint">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>Sequence_8_KundeErscheint</bpmn:incoming>
      <bpmn:outgoing>Sequence_10_EssenUebergeben</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:task id="Task_angestellter_essenuebergeben" name="Essen übergeben">
      <bpmn:incoming>Sequence_10_EssenUebergeben</bpmn:incoming>
      <bpmn:outgoing>Sequence_End_Angestellter</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="End_Angestellter_Bearbeitet" name="Bestellung bearbeitet">
      <bpmn:incoming>Sequence_End_Angestellter</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Timeout Path -->
    <bpmn:intermediateCatchEvent id="Timer_5Minuten" name="5 Minuten warten">
      <bpmn:timerEventDefinition/>
      <bpmn:incoming>Sequence_9_Timeout5Minuten</bpmn:incoming>
      <bpmn:outgoing>Sequence_Ausrufen</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:task id="Task_angestellter_kundenAusrufen" name="Kunden ausrufen">
      <bpmn:incoming>Sequence_Ausrufen</bpmn:incoming>
      <bpmn:outgoing>Loop_Back_Gateway_SequenceFlow</bpmn:outgoing>
    </bpmn:task>

    <!-- Loop back to gateway for multiple calls -->
    <bpmn:sequenceFlow id="Loop_Back_Gateway_SequenceFlow" name="Mehrmaliges Ausrufen möglich" sourceRef="Task_angestellter_kundenAusrufen" targetRef="Event_Based_Gateway_Ausrufen"/>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Sequence_1_BestellenEingeben" sourceRef="Start_Angestellter_Empfangen" targetRef="Task_angestellter_kassieren"/>
    <bpmn:sequenceFlow id="Sequence_2_PieperEinstellen" sourceRef="Task_angestellter_kassieren" targetRef="Task_angestellter_pieferstellen"/>
    <bpmn:sequenceFlow id="Sequence_3_Pieperuebergeben" sourceRef="Task_angestellter_pieferstellen" targetRef="Task_angestellter_pieferuebergeben"/>
    <bpmn:sequenceFlow id="Sequence_4_KochenInformieren" sourceRef="Task_angestellter_pieferuebergeben" targetRef="Task_angestellter_kocheninformieren"/>
    <bpmn:sequenceFlow id="Sequence_5_WartenAufFertig" sourceRef="Task_angestellter_kocheninformieren" targetRef="Event_Angestellter_WartenAufFertig"/>
    <bpmn:sequenceFlow id="Sequence_6_PieperAusloesen" sourceRef="Event_Angestellter_WartenAufFertig" targetRef="Task_angestellter_pieferausloesen"/>
    <bpmn:sequenceFlow id="Sequence_7_EventBasedGateway" sourceRef="Task_angestellter_pieferausloesen" targetRef="Event_Based_Gateway_Ausrufen"/>
    <bpmn:sequenceFlow id="Sequence_8_KundeErscheint" sourceRef="Event_Based_Gateway_Ausrufen" targetRef="Event_Angestellter_KundeErscheint"/>
    <bpmn:sequenceFlow id="Sequence_9_Timeout5Minuten" sourceRef="Event_Based_Gateway_Ausrufen" targetRef="Timer_5Minuten"/>
    <bpmn:sequenceFlow id="Sequence_10_EssenUebergeben" sourceRef="Event_Angestellter_KundeErscheint" targetRef="Task_angestellter_essenuebergeben"/>
    <bpmn:sequenceFlow id="Loop_Back_Gateway_SequenceFlow" name="Mehrmaliges Ausrufen möglich" sourceRef="Task_angestellter_kundenAusrufen" targetRef="Event_Based_Gateway_Ausrufen"/>

  </bpmn:process>

  <!-- Cook Process -->
  <bpmn:process id="Process_Koch">
    <bpmn:startEvent id="Start_Koch_Zubereiten" name="Mahlzeit zuzubereiten">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>Sequence_1_MahlZubereiten</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_koch_zubereiten" name="Mahlzeit zubereiten">
      <bpmn:incoming>Sequence_1_MahlZubereiten</bpmn:incoming>
      <bpmn:outgoing>Sequence_2_DurchreicheStellen</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_koch_durchreichestellen" name="Essen in Durchreiche stellen">
      <bpmn:incoming>Sequence_2_DurchreicheStellen</bpmn:incoming>
      <bpmn:outgoing>Sequence_3_Fertigmelden</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_koch_fertigmelden" name="Angestellten informieren">
      <bpmn:incoming>Sequence_3_Fertigmelden</bpmn:incoming>
      <bpmn:outgoing>Sequence_End_Koch</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="End_Koch_Zubereitet" name="Mahlzeit zubereitet">
      <bpmn:incoming>Sequence_End_Koch</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Sequence_1_MahlZubereiten" sourceRef="Start_Koch_Zubereiten" targetRef="Task_koch_zubereiten"/>
    <bpmn:sequenceFlow id="Sequence_2_DurchreicheStellen" sourceRef="Task_koch_zubereiten" targetRef="Task_koch_durchreichestellen"/>
    <bpmn:sequenceFlow id="Sequence_3_Fertigmelden" sourceRef="Task_koch_durchreichestellen" targetRef="Task_koch_fertigmelden"/>
    <bpmn:sequenceFlow id="Sequence_End_Koch" sourceRef="Task_koch_fertigmelden" targetRef="End_Koch_Zubereitet"/>

  </bpmn:process>

</bpmn:definitions>