<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1a8j3f5" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1jmxybt">
    <bpmn:participant id="Participant_0ygkg4f" name="Unbedenklichkeitsbescheinigung Prozess" processRef="Process_3k9m7l4" />
  </bpmn:collaboration>

  <bpmn:process id="Process_3k9m7l4" isExecutable="true">
    <bpmn:laneSet id="LaneSet_01m91on">
      <bpmn:lane id="Lane_Automated" name="Automatisierte Bearbeitung">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InitProcess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_PersonExists</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_EmployerRole</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckInsuranceTimes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_ContributionUncertainty</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckEstimates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckOutstandingClaims</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_PrerequisitesMet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_GoodStanding</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IssueFullCert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IssuePartialCert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LogHistory</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Manual" name="Manuelle Bearbeitung">
        <bpmn:flowNodeRef>Gw_PersonExists</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RequestInfoLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HandoverClerk</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Anfrage Eingang">
      <bpmn:outgoing>SequenceFlow_Init</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Initialize Process & Set Count to Zero -->
    <bpmn:serviceTask id="Task_InitProcess" name="Vorgang initialisieren&#10;Anzahl auf null setzen">
      <bpmn:incoming>SequenceFlow_Init</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckPerson</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Gateway 1: Person in System? -->
    <bpmn:exclusiveGateway id="Gw_PersonExists" name="Person im&#10;System vorhanden?">
      <bpmn:incoming>SequenceFlow_CheckPerson</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_YesPerson</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoPerson</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 2 (Manual): Request Info Letter -->
    <bpmn:userTask id="Task_RequestInfoLetter" name="Anschreiben&#10;erstellen">
      <bpmn:incoming>SequenceFlow_NoPerson</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_LetterDone</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway 2: Employer Role? (Only if Person Exists) -->
    <bpmn:exclusiveGateway id="Gw_EmployerRole" name="Rolle Arbeitgeber&#10;vorhanden?">
      <bpmn:incoming>SequenceFlow_YesPerson</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_YesEmployer</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoEmployer</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 3 (Manual): Request Info Letter for Employer Role -->
    <bpmn:userTask id="Task_RequestInfoLetterRole" name="Anschreiben&#10;erstellen">
      <bpmn:incoming>SequenceFlow_NoEmployer</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EmployerDone</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task 4: Check Insurance Times & Contributions Count -->
    <bpmn:serviceTask id="Task_CheckInsuranceTimes" name="Versicherungszeiten&#10;und Beitragsnachweise prüfen">
      <bpmn:incoming>SequenceFlow_YesEmployer</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ContributionCheck</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Gateway 3: Contribution Uncertainty? -->
    <bpmn:exclusiveGateway id="Gw_ContributionUncertainty" name="Unsicherheit&#10;Beitragshöhe?">
      <bpmn:incoming>SequenceFlow_ContributionCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_UncertainYes</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_UncertainNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 5 (Conditional): Check Estimates -->
    <bpmn:serviceTask id="Task_CheckEstimates" name="Beitragsschätzungen&#10;prüfen">
      <bpmn:incoming>SequenceFlow_UncertainYes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EstimateDone</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Task 6: Check Outstanding Claims/Contributions -->
    <bpmn:serviceTask id="Task_CheckOutstandingClaims" name="Offene Forderungen&#10;prüfen">
      <bpmn:incoming>SequenceFlow_UncertainNo</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_EstimateDone</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AssessmentIn</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Gateway 4: Prerequisites Met? -->
    <bpmn:exclusiveGateway id="Gw_PrerequisitesMet" name="Voraussetzungen&#10;für Bescheinigung erfüllt?">
      <bpmn:incoming>SequenceFlow_AssessmentIn</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NoPrereq</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_YesPrereq</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 7 (Manual): Handover to Clerk -->
    <bpmn:userTask id="Task_HandoverClerk" name="Fall an Sachbearbeiter&#10;übergeben">
      <bpmn:incoming>SequenceFlow_NoPrereq</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ClerkDone</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway 5: Good Standing Assessment (Logic) -->
    <bpmn:exclusiveGateway id="Gw_GoodStanding" name="Unbedenklichkeit&#10;vollständig?">
      <bpmn:incoming>SequenceFlow_YesPrereq</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FullGood</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PartialGood</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 8: Issue Full Certificate -->
    <bpmn:serviceTask id="Task_IssueFullCert" name="Bescheinigung&#10;austellen (Vollständig)">
      <bpmn:incoming>SequenceFlow_FullGood</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CertDone</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Task 9: Issue Conditional Certificate -->
    <bpmn:serviceTask id="Task_IssuePartialCert" name="Bescheinigung&#10;austellen (Hinweis)">
      <bpmn:incoming>SequenceFlow_PartialGood</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CertDone2</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Task 10: Log History (Common Step) -->
    <bpmn:serviceTask id="Task_LogHistory" name="Eintrag in&#10;Kontakthistorie">
      <bpmn:incoming>SequenceFlow_ClerkDone</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_HistoryIn1</bpmn:incoming>
    </bpmn:serviceTask>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_Handover" name="Fall an Sachbearbeiter">
      <bpmn:incoming>SequenceFlow_ClerkDone2</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_Completed" name="Prozess abgeschlossen">
      <bpmn:incoming>SequenceFlow_HistoryDone</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_Init" sourceRef="StartEvent_1" targetRef="Task_InitProcess" />
    
    <bpmn:sequenceFlow id="SequenceFlow_CheckPerson" sourceRef="Task_InitProcess" targetRef="Gw_PersonExists" />

    <!-- Person Exists Path -->
    <bpmn:sequenceFlow id="SequenceFlow_YesPerson" name="Ja" sourceRef="Gw_PersonExists" targetRef="Gw_EmployerRole" />
    
    <!-- No Person -> Manual Letter (Loop back) -->
    <bpmn:sequenceFlow id="SequenceFlow_NoPerson" name="Nein" sourceRef="Gw_PersonExists" targetRef="Task_RequestInfoLetter" />

    <!-- Employer Role Path -->
    <bpmn:sequenceFlow id="SequenceFlow_YesEmployer" name="Ja" sourceRef="Gw_EmployerRole" targetRef="Task_CheckInsuranceTimes" />
    
    <!-- No Employer -> Manual Letter (Loop back) -->
    <bpmn:sequenceFlow id="SequenceFlow_NoEmployer" name="Nein" sourceRef="Gw_EmployerRole" targetRef="Task_RequestInfoLetterRole" />

    <!-- Checks Path -->
    <bpmn:sequenceFlow id="SequenceFlow_ContributionCheck" sourceRef="Task_CheckInsuranceTimes" targetRef="Gw_ContributionUncertainty" />

    <!-- Uncertainty Check -->
    <bpmn:sequenceFlow id="SequenceFlow_UncertainYes" name="Ja (Unsicherheit)" sourceRef="Gw_ContributionUncertainty" targetRef="Task_CheckEstimates" />
    
    <bpmn:sequenceFlow id="SequenceFlow_EstimateDone" sourceRef="Task_CheckEstimates" targetRef="Task_CheckOutstandingClaims" />

    <!-- Uncertain No Path -->
    <bpmn:sequenceFlow id="SequenceFlow_UncertainNo" name="Nein (Keine Unsicherheit)" sourceRef="Gw_ContributionUncertainty" targetRef="Task_CheckOutstandingClaims" />

    <!-- Outstanding Claims Check -->
    <bpmn:sequenceFlow id="SequenceFlow_AssessmentIn" sourceRef="Task_CheckOutstandingClaims" targetRef="Gw_PrerequisitesMet" />

    <!-- Prerequisites Decision -->
    <bpmn:sequenceFlow id="SequenceFlow_NoPrereq" name="Nein (Nicht erfüllt)" sourceRef="Gw_PrerequisitesMet" targetRef="Task_HandoverClerk" />
    
    <bpmn:sequenceFlow id="SequenceFlow_YesPrereq" name="Ja" sourceRef="Gw_PrerequisitesMet" targetRef="Gw_GoodStanding" />

    <!-- Good Standing Decision -->
    <bpmn:sequenceFlow id="SequenceFlow_FullGood" name="Vollständig" sourceRef="Gw_GoodStanding" targetRef="Task_IssueFullCert" />
    
    <bpmn:sequenceFlow id="SequenceFlow_PartialGood" name="Teilweise / Offene Beträge" sourceRef="Gw_GoodStanding" targetRef="Task_IssuePartialCert" />

    <!-- Certificate Issuance Merge -->
    <bpmn:sequenceFlow id="SequenceFlow_CertDone" sourceRef="Task_IssueFullCert" targetRef="Task_LogHistory" />
    
    <bpmn:sequenceFlow id="SequenceFlow_HistoryIn1" name="" sourceRef="Task_IssuePartialCert" targetRef="Task_LogHistory" />

    <!-- Manual Handover Merge -->
    <bpmn:sequenceFlow id="SequenceFlow_LetterDone" sourceRef="Task_RequestInfoLetter" targetRef="Gw_PersonExists">
      <bpmn:description>Loop back after info provided</bpmn:description>
    </bpmn:sequenceFlow>

     <!-- Correction for flow consistency in XML -->
    <bpmn:sequenceFlow id="SequenceFlow_EmployerDone" sourceRef="Task_RequestInfoLetterRole" targetRef="Gw_EmployerRole">
      <bpmn:description>Loop back after info provided</bpmn:description>
    </bpmn:sequenceFlow>

     <!-- Handover to Clerk End -->
    <bpmn:sequenceFlow id="SequenceFlow_ClerkDone" sourceRef="Task_HandoverClerk" targetRef="EndEvent_Handover" />

    <!-- Log History End -->
    <bpmn:sequenceFlow id="SequenceFlow_HistoryIn2" name="" sourceRef="Task_LogHistory" targetRef="EndEvent_Completed" />

  </bpmn:process>
</bpmn:definitions>