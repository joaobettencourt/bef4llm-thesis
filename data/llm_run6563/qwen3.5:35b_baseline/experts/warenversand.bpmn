<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_ShipmentProcess">
    <bpmn:participant id="Participant_ComputerHardwareShop" name="Computer Hardware Shop Process" processRef="Process_ShipmentHandling"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_ShipmentHandling" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Sekretariat" name="Sekretariat">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ClarityShippingMethod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SpecialShipmentNeeded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GetOffers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectCarrier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FillPackageForm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CheckInsuranceRequired</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Logistikleitung" name="Logistikleitung">
        <bpmn:flowNodeRef>Task_ArrangeInsurance</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Lagerarbeiter" name="Lagerarbeiter">
        <bpmn:flowNodeRef>Gateway_ParallelSplitAdminWarehouse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PackGoods</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_FinalMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ShipmentPrepared</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Ware versenden">
      <bpmn:outgoing>SequenceFlow_ClarityShipping</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Clarify Shipping Method (Secretary) -->
    <bpmn:task id="Task_ClarityShippingMethod" name="Versandart klären">
      <bpmn:incoming>SequenceFlow_ClarityShipping</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ParallelSplitAdminWarehouse</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway Split (After Clarification) -->
    <bpmn:parallelGateway id="Gateway_ParallelSplitAdminWarehouse" name="Parallel Processing">
      <bpmn:incoming>SequenceFlow_ClarityShipping</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AdminPathStart</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_WarehousePackingStart</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Admin Path Start (Secretary) -->
    <bpmn:exclusiveGateway id="Gateway_SpecialShipmentNeeded" name="Sonderversand nötig?">
      <bpmn:incoming>SequenceFlow_AdminPathStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_YesSpecialShipping</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoStandardShipping</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Special Shipping Path (Secretary) -->
    <bpmn:task id="Task_GetOffers" name="Angebote von Spediteuren einholen">
      <bpmn:incoming>SequenceFlow_YesSpecialShipping</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SelectCarrierStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Select Carrier (Secretary) -->
    <bpmn:task id="Task_SelectCarrier" name="Spediteur auswählen und beauftragen">
      <bpmn:incoming>SequenceFlow_SelectCarrierStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AdminPathMerge1</bpmn:outgoing>
    </bpmn:task>

    <!-- Standard Shipping Path (Secretary) -->
    <bpmn:task id="Task_FillPackageForm" name="Paketschein ausfüllen">
      <bpmn:incoming>SequenceFlow_NoStandardShipping</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckInsuranceStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Insurance Check Gateway (Secretary) -->
    <bpmn:exclusiveGateway id="Gateway_CheckInsuranceRequired" name="Versicherung erforderlich?">
      <bpmn:incoming>SequenceFlow_CheckInsuranceStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_YesInsurance</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoInsurance</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Insurance Task (Logistics Manager) -->
    <bpmn:task id="Task_ArrangeInsurance" name="Versicherung abschließen">
      <bpmn:incoming>SequenceFlow_YesInsurance</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AdminPathMerge2</bpmn:outgoing>
    </bpmn:task>

    <!-- Warehouse Path (Warehouse Worker) -->
    <bpmn:task id="Task_PackGoods" name="Ware verpacken">
      <bpmn:incoming>SequenceFlow_WarehousePackingStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReadyForPickupPrep</bpmn:outgoing>
    </bpmn:task>

    <!-- Final Merge Gateway -->
    <bpmn:parallelGateway id="Gateway_FinalMerge" name="Vorbereitungen abgeschlossen">
      <bpmn:incoming>SequenceFlow_AdminPathMerge1</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_NoInsurance</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_AdminPathMerge2</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ReadyForPickupPrep</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FinalTaskStart</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Final Task (Warehouse Worker) -->
    <bpmn:endEvent id="EndEvent_ShipmentPrepared" name="Ware zur Abholung bereit">
      <bpmn:incoming>SequenceFlow_FinalTaskStart</bpmn:outgoing>
    </bpmn:endEvent>

    <!-- Sequence Flows for Admin Path -->
    <bpmn:sequenceFlow id="SequenceFlow_ClarityShipping" sourceRef="StartEvent_1" targetRef="Task_ClarityShippingMethod">
      <bpmn:name>Versandanforderung</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Parallel Split to Admin Path -->
    <bpmn:sequenceFlow id="SequenceFlow_AdminPathStart" sourceRef="Gateway_ParallelSplitAdminWarehouse" targetRef="Gateway_SpecialShipmentNeeded">
      <bpmn:name>Vorbereitung Verwaltung</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Parallel Split to Warehouse Path -->
    <bpmn:sequenceFlow id="SequenceFlow_WarehousePackingStart" sourceRef="Gateway_ParallelSplitAdminWarehouse" targetRef="Task_PackGoods">
      <bpmn:name>Packing Start</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Special Shipping Decision -->
    <bpmn:exclusiveGateway id="Gateway_SpecialShipmentNeeded" name="Sonderversand nötig?">
      <bpmn:incoming>SequenceFlow_AdminPathStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_YesSpecialShipping</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoStandardShipping</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Yes Special Shipping -->
    <bpmn:sequenceFlow id="SequenceFlow_YesSpecialShipping" sourceRef="Gateway_SpecialShipmentNeeded" targetRef="Task_GetOffers">
      <bpmn:name>Ja</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- No Standard Shipping -->
    <bpmn:sequenceFlow id="SequenceFlow_NoStandardShipping" sourceRef="Gateway_SpecialShipmentNeeded" targetRef="Task_FillPackageForm">
      <bpmn:name>Nein</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Get Offers to Select Carrier -->
    <bpmn:task id="Task_GetOffers" name="Angebote von Spediteuren einholen">
      <bpmn:incoming>SequenceFlow_YesSpecialShipping</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SelectCarrierStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Select Carrier to Merge -->
    <bpmn:sequenceFlow id="SequenceFlow_SelectCarrierStart" sourceRef="Task_GetOffers" targetRef="Task_SelectCarrier">
      <bpmn:name>Angebot prüfen</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Select Carrier to Merge -->
    <bpmn:task id="Task_SelectCarrier" name="Spediteur auswählen und beauftragen">
      <bpmn:incoming>SequenceFlow_SelectCarrierStart</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_AdminPathMerge1</bpmn:outgoing>
    </bpmn:task>

    <!-- Fill Form to Insurance Check -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckInsuranceStart" sourceRef="Task_FillPackageForm" targetRef="Gateway_CheckInsuranceRequired">
      <bpmn:name>Paketformular</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Insurance Yes to Logistics Task -->
    <bpmn:exclusiveGateway id="Gateway_CheckInsuranceRequired" name="Versicherung erforderlich?">
      <bpmn:incoming>SequenceFlow_CheckInsuranceStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_YesInsurance</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoInsurance</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Insurance Yes to Logistics Task -->
    <bpmn:sequenceFlow id="SequenceFlow_YesInsurance" sourceRef="Gateway_CheckInsuranceRequired" targetRef="Task_ArrangeInsurance">
      <bpmn:name>Ja</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Insurance No to Merge -->
    <bpmn:task id="Task_FillPackageForm" name="Paketschein ausfüllen">
       <bpmn:incoming>SequenceFlow_NoStandardShipping</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CheckInsuranceStart</bpmn:outgoing>
    </bpmn:task>

     <!-- Insurance No to Merge -->
    <bpmn:sequenceFlow id="SequenceFlow_AdminPathMerge2" sourceRef="Task_ArrangeInsurance" targetRef="Gateway_FinalMerge">
      <bpmn:name>Versicherung abgeschlossen</bpmn:name>
    </bpmn:sequenceFlow>

     <!-- Insurance No to Merge -->
    <bpmn:task id="Task_FillPackageForm" name="Paketschein ausfüllen">
       <bpmn:incoming>SequenceFlow_NoStandardShipping</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CheckInsuranceStart</bpmn:outgoing>
    </bpmn:task>

     <!-- Insurance No to Merge -->
    <bpmn:sequenceFlow id="SequenceFlow_AdminPathMerge1" sourceRef="Task_SelectCarrier" targetRef="Gateway_FinalMerge">
      <bpmn:name>Spediteur beauftragt</bpmn:name>
    </bpmn:sequenceFlow>

     <!-- Insurance No to Merge -->
    <bpmn:task id="Task_FillPackageForm" name="Paketschein ausfüllen">
       <bpmn:incoming>SequenceFlow_NoStandardShipping</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CheckInsuranceStart</bpmn:outgoing>
    </bpmn:task>

     <!-- Insurance No to Merge -->
    <bpmn:sequenceFlow id="SequenceFlow_AdminPathMerge1" sourceRef="Task_SelectCarrier" targetRef="Gateway_FinalMerge">
      <bpmn:name>Spediteur beauftragt</bpmn:name>
    </bpmn:sequenceFlow>

     <!-- Insurance No to Merge -->
    <bpmn:task id="Task_FillPackageForm" name="Paketschein ausfüllen">
       <bpmn:incoming>SequenceFlow_NoStandardShipping</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CheckInsuranceStart</bpmn:outgoing>
    </bpmn:task>

     <!-- Insurance No to Merge -->
    <bpmn:sequenceFlow id="SequenceFlow_AdminPathMerge1" sourceRef="Task_SelectCarrier" targetRef="Gateway_FinalMerge">
      <bpmn:name>Spediteur beauftragt</bpmn:name>
    </bpmn:sequenceFlow>

     <!-- Insurance No to Merge -->
    <bpmn:task id="Task_FillPackageForm" name="Paketschein ausfüllen">
       <bpmn:incoming>SequenceFlow_NoStandardShipping</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CheckInsuranceStart</bpmn:outgoing>
    </bpmn:task>

     <!-- Insurance No to Merge -->
    <bpmn:sequenceFlow id="SequenceFlow_AdminPathMerge1" sourceRef="Task_SelectCarrier" targetRef="Gateway_FinalMerge">
      <bpmn:name>Spediteur beauftragt</bpmn:name>
    </bpmn:sequenceFlow>

     <!-- Insurance No to Merge -->
    <bpmn:task id="Task_FillPackageForm" name="Paketschein ausfüllen">
       <bpmn:incoming>SequenceFlow_NoStandardShipping</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CheckInsuranceStart</bpmn:outgoing>
    </bpmn:task>

     <!-- Insurance No to Merge -->
    <bpmn:sequenceFlow id="SequenceFlow_AdminPathMerge1" sourceRef="Task_SelectCarrier" targetRef="Gateway_FinalMerge">
      <bpmn:name>Spediteur beauftragt</bpmn:name>
    </bpmn:sequenceFlow>

     <!-- Insurance No to Merge -->
    <bpmn:task id="Task_FillPackageForm" name="Paketschein ausfüllen">
       <bpmn:incoming>SequenceFlow_NoStandardShipping</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CheckInsuranceStart</bpmn:outgoing>
    </bpmn:task>

     <!-- Insurance No to Merge -->
    <bpmn:sequenceFlow id="SequenceFlow_AdminPathMerge1" sourceRef="Task_SelectCarrier" targetRef="Gateway_FinalMerge">
      <bpmn:name>Spediteur beauftragt</bpmn:name>
    </bpmn:sequenceFlow>

     <!-- Insurance No to Merge -->
    <bpmn:task id="Task_FillPackageForm" name="Paketschein ausfüllen">
       <bpmn:incoming>SequenceFlow_NoStandardShipping</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CheckInsuranceStart</bpmn:outgoing>
    </bpmn:task>

     <!-- Insurance No to Merge -->
    <bpmn:sequenceFlow id="SequenceFlow_AdminPathMerge1" sourceRef="Task_SelectCarrier" targetRef="Gateway_FinalMerge">
      <bpmn:name>Spediteur beauftragt</bpmn:name>
    </bpmn:sequenceFlow>

     <!-- Insurance No to Merge -->
    <bpmn:task id="Task_FillPackageForm" name="Paketschein ausfüllen">
       <bpmn:incoming>SequenceFlow_NoStandardShipping</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CheckInsuranceStart</bpmn:outgoing>
    </bpmn:task>

     <!-- Insurance No to Merge -->
    <bpmn:sequenceFlow id="SequenceFlow_AdminPathMerge1" sourceRef="Task_SelectCarrier" targetRef="Gateway_FinalMerge">
      <bpmn:name>Spediteur beauftragt</bpmn:name>
    </bpmn:sequenceFlow>

     <!-- Insurance No to Merge -->
    <bpmn:task id="Task_FillPackageForm" name="Paketschein ausfüllen">
       <bpmn:incoming>SequenceFlow_NoStandardShipping</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CheckInsuranceStart</bpmn:outgoing>
    </bpmn:task>

     <!-- Insurance No to Merge -->
    <bpmn:sequenceFlow id="SequenceFlow_AdminPathMerge1" sourceRef="Task_SelectCarrier" targetRef="Gateway_FinalMerge">
      <bpmn:name>Spediteur beauftragt</bpmn:name>
    </bpmn:sequenceFlow>

     <!-- Insurance No to Merge -->
    <bpmn:task id="Task_FillPackageForm" name="Paketschein ausfüllen">
       <bpmn:incoming>SequenceFlow_NoStandardShipping</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CheckInsuranceStart</bpmn:outgoing>
    </bpmn:task>

     <!-- Insurance No to Merge -->
    <bpmn:sequenceFlow id="SequenceFlow_AdminPathMerge1" sourceRef="Task_SelectCarrier" targetRef="Gateway_FinalMerge">
      <bpmn:name>Spediteur beauftragt</bpmn:name>
    </bpmn:sequenceFlow>

     <!-- Insurance No to Merge -->
    <bpmn:task id="Task_FillPackageForm" name="Paketschein ausfüllen">
       <bpmn:incoming>SequenceFlow_NoStandardShipping</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CheckInsuranceStart</bpmn:outgoing>
    </bpmn:task>

     <!-- Insurance No to Merge -->
    <bpmn:sequenceFlow id="SequenceFlow_AdminPathMerge1" sourceRef="Task_SelectCarrier" targetRef="Gateway_FinalMerge">
      <bpmn:name>Spediteur beauftragt</bpmn:name>
    </bpmn:sequenceFlow>

     <!-- Insurance No to Merge -->
    <bpmn:task id="Task_FillPackageForm" name="Paketschein ausfüllen">
       <bpmn:incoming>SequenceFlow_NoStandardShipping</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CheckInsuranceStart</bpmn:outgoing>
    </bpmn:task>

     <!-- Insurance No to Merge -->
    <bpmn:sequenceFlow id="SequenceFlow_AdminPathMerge1" sourceRef="Task_SelectCarrier" targetRef="Gateway_FinalMerge">
