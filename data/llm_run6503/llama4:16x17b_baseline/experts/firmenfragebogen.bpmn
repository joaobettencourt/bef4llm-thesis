<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">

  <process id="companyRegistrationProcess" isExecutable="true">
    <startEvent id="startEvent">
      <outgoing>sequenceFlow1</outgoing>
    </startEvent>

    <sequenceFlow id="sequenceFlow1" sourceRef="startEvent" targetRef="task1"/>

    <task id="task1" name="Erfassen und verarbeiten des Firmenfragebogens">
      <incoming>sequenceFlow1</incoming>
      <outgoing>sequenceFlow2</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow2" sourceRef="task1" targetRef="exclusiveGateway1"/>

    <exclusiveGateway id="exclusiveGateway1">
      <incoming>sequenceFlow2</incoming>
      <outgoing>sequenceFlow3</outgoing>
      <outgoing>sequenceFlow4</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequenceFlow3" sourceRef="exclusiveGateway1" targetRef="task2">
      <conditionExpression xsi:type="tFormalExpression">Partnerunternehmen gefunden</conditionExpression>
    </sequenceFlow>

    <task id="task2" name="Überprüfung relevanter Unternehmensdaten">
      <incoming>sequenceFlow3</incoming>
      <outgoing>sequenceFlow5</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow4" sourceRef="exclusiveGateway1" targetRef="task3">
      <conditionExpression xsi:type="tFormalExpression">Kein Partnerunternehmen gefunden oder keine eindeutige Zuordnung möglich</conditionExpression>
    </sequenceFlow>

    <task id="task3" name="Manuelle Prüfung durch Sachbearbeiter">
      <incoming>sequenceFlow4</incoming>
      <outgoing>sequenceFlow6</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow5" sourceRef="task2" targetRef="exclusiveGateway2"/>

    <exclusiveGateway id="exclusiveGateway2">
      <incoming>sequenceFlow5</incoming>
      <outgoing>sequenceFlow7</outgoing>
      <outgoing>sequenceFlow8</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequenceFlow6" sourceRef="task3" targetRef="exclusiveGateway2"/>

    <sequenceFlow id="sequenceFlow7" sourceRef="exclusiveGateway2" targetRef="task4">
      <conditionExpression xsi:type="tFormalExpression">Unternehmensdaten korrekt</conditionExpression>
    </sequenceFlow>

    <task id="task4" name="Überprüfung des Meldezeitraums und der Umlageversicherungszeiten">
      <incoming>sequenceFlow7</incoming>
      <outgoing>sequenceFlow9</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow8" sourceRef="exclusiveGateway2" targetRef="task5">
      <conditionExpression xsi:type="tFormalExpression">Unternehmensdaten nicht korrekt</conditionExpression>
    </sequenceFlow>

    <task id="task5" name="Bearbeitung durch zuständigen Mitarbeiter">
      <incoming>sequenceFlow8</incoming>
      <outgoing>sequenceFlow10</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow9" sourceRef="task4" targetRef="task6"/>

    <task id="task6" name="Überprüfung der Kontaktdaten des Unternehmens">
      <incoming>sequenceFlow9</incoming>
      <outgoing>sequenceFlow11</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow10" sourceRef="task5" targetRef="endEvent"/>

    <sequenceFlow id="sequenceFlow11" sourceRef="task6" targetRef="endEvent"/>

    <endEvent id="endEvent">
      <incoming>sequenceFlow10</incoming>
      <incoming>sequenceFlow11</incoming>
    </endEvent>

  </process>

</definitions>