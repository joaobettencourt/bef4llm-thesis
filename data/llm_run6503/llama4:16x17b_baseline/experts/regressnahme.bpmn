<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">

   <process id="regressProcess" isExecutable="true">
     <startEvent id="startEvent1">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="task1"/>

     <task id="task1" name="Prüfen ob Regress möglich">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
       <outgoing>sequenceFlow3</outgoing>
     </task>

     <exclusiveGateway id="exclusiveGateway1">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow4</outgoing>
       <outgoing>sequenceFlow5</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow2" sourceRef="task1" targetRef="exclusiveGateway1"/>

     <sequenceFlow id="sequenceFlow3" sourceRef="task1" targetRef="endEvent1"/>

     <task id="task2" name="Zahlungsaufforderung an VN">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow6</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow4" sourceRef="exclusiveGateway1" targetRef="task2"/>

     <intermediateEvent id="intermediateEvent1">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow7</outgoing>
     </intermediateEvent>

     <sequenceFlow id="sequenceFlow6" sourceRef="task2" targetRef="intermediateEvent1"/>

     <task id="task3" name="Eingang verbuchen">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow8</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow7" sourceRef="intermediateEvent1" targetRef="task3"/>

     <endEvent id="endEvent1">
       <incoming>sequenceFlow3</incoming>
       <incoming>sequenceFlow8</incoming>
     </endEvent>

     <exclusiveGateway id="exclusiveGateway2">
       <incoming>sequenceFlow9</incoming>
       <outgoing>sequenceFlow10</outgoing>
       <outgoing>sequenceFlow11</outgoing>
     </exclusiveGateway>

     <task id="task4" name="Widerspruch prüfen">
       <incoming>sequenceFlow12</incoming>
       <outgoing>sequenceFlow9</outgoing>
     </task>

     <intermediateEvent id="intermediateEvent2">
       <incoming>sequenceFlow8</incoming>
       <outgoing>sequenceFlow12</outgoing>
     </intermediateEvent>

     <sequenceFlow id="sequenceFlow12" sourceRef="intermediateEvent2" targetRef="task4"/>

     <serviceTask id="serviceTask1">
       <incoming>sequenceFlow10</incoming>
     </serviceTask>

     <sequenceFlow id="sequenceFlow9" sourceRef="task4" targetRef="exclusiveGateway2"/>
     <sequenceFlow id="sequenceFlow10" sourceRef="exclusiveGateway2" targetRef="serviceTask1"/>
     <sequenceFlow id="sequenceFlow11" sourceRef="exclusiveGateway2" targetRef="endEvent1"/>
   </process>
</definitions>