<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_HealthPromotion_v2" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_0a8j9f5">
    <bpmn:participant id="Participant_2s4y6v0" name="Betriebliche Gesundheitsförderung" processRef="Process_3k9m7l4" />
  </bpmn:collaboration>

  <bpmn:process id="Process_3k9m7l4" isExecutable="false">
    <bpmn:laneSet id="LaneSet_0ijnsza">
      <bpmn:lane id="Lane_Participants" name="Teilnehmer">
        <bpmn:flowNodeRef>StartEvent_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TrainingInstruction</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CatchEvent_CounselingRequest</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Medical" name="Sportmediziner / Coaches">
        <bpmn:flowNodeRef>Task_HealthCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WAI_BloodSample</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Merge_Init</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreatePlan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TrainingPhase1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CatchEvent_Timer_Phase1_End</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MidCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Split_Groups</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TrainingPhase2_A</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TrainingPhase2_B</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CatchEvent_Timer_Phase2_End</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Merge_Final</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Counseling</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FinalCheck</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Start" name="Programmstart">
      <bpmn:outgoing>SequenceFlow_PG_Split</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Initial Parallel Split (Check vs Instruction) -->
    <bpmn:parallelGateway id="PG_InitSplit" name="Initial Phase">
      <bpmn:incoming>SequenceFlow_PG_Split</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_InstructionPath</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Medical Tasks -->
    <bpmn:task id="Task_HealthCheck" name="Gesundheits-Check durchführen">
      <bpmn:incoming>SequenceFlow_CheckPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WAI_BloodSample</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_WAI_BloodSample" name="WAI &amp; Blutprobe">
      <bpmn:incoming>SequenceFlow_WAI_BloodSample</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Merge_Init_In1</bpmn:outgoing>
    </bpmn:task>

    <!-- Participant Instruction Task -->
    <bpmn:task id="Task_TrainingInstruction" name="Einweisung App &amp; Wearables">
      <bpmn:incoming>SequenceFlow_InstructionPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Merge_Init_In2</bpmn:outgoing>
    </bpmn:task>

    <!-- Merge Initial Phase -->
    <bpmn:parallelGateway id="Gateway_Merge_Init" name="Initial Check Complete">
      <bpmn:incoming>SequenceFlow_Merge_Init_In1</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_Merge_Init_In2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CreatePlan</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Plan Creation -->
    <bpmn:task id="Task_CreatePlan" name="Trainings- &amp; Ernährungsplan erstellen">
      <bpmn:incoming>SequenceFlow_CreatePlan</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TrainingPhase1_Start</bpmn:outgoing>
    </bpmn:task>

    <!-- Training Phase 1 -->
    <bpmn:task id="Task_TrainingPhase1" name="Trainingsphase 1 (6 Monate)">
      <bpmn:incoming>SequenceFlow_TrainingPhase1_Start</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Timer_Phase1_End_In</bpmn:outgoing>
    </bpmn:task>

    <!-- Timer Event for Phase 1 End -->
    <bpmn:intermediateCatchEvent id="CatchEvent_Timer_Phase1_End" name="Nach 6 Monaten">
      <bpmn:incoming>SequenceFlow_Timer_Phase1_End_In</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MidCheck_Start</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_001" />
    </bpmn:intermediateCatchEvent>

    <!-- Mid Check -->
    <bpmn:task id="Task_MidCheck" name="Zwischen-Check durchführen">
      <bpmn:incoming>SequenceFlow_MidCheck_Start</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GroupSplit_In</bpmn:outgoing>
    </bpmn:task>

    <!-- Group Split -->
    <bpmn:exclusiveGateway id="Gateway_Split_Groups" name="Gruppeneinteilung">
      <bpmn:incoming>SequenceFlow_GroupSplit_In</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Path_A</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_Path_B</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Path A (Independent) -->
    <bpmn:task id="Task_TrainingPhase2_A" name="Training ohne Wearables">
      <bpmn:incoming>SequenceFlow_Path_A</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Timer_Phase2_End_InA</bpmn:outgoing>
    </bpmn:task>

    <!-- Path B (Supported) -->
    <bpmn:task id="Task_TrainingPhase2_B" name="Training mit App &amp; Wearables">
      <bpmn:incoming>SequenceFlow_Path_B</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Timer_Phase2_End_InB</bpmn:outgoing>
    </bpmn:task>

    <!-- Timer Event for Phase 2 End -->
    <bpmn:intermediateCatchEvent id="CatchEvent_Timer_Phase2_End" name="Nach weiteren 6 Monaten">
      <bpmn:incoming>SequenceFlow_Timer_Phase2_End_InA</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_Timer_Phase2_End_InB</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FinalCheck_Start</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_002" />
    </bpmn:intermediateCatchEvent>

    <!-- Final Check -->
    <bpmn:task id="Task_FinalCheck" name="Abschluss-Check durchführen">
      <bpmn:incoming>SequenceFlow_MergeFinal_ToCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_End_Programm</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Programm" name="Programm abgeschlossen">
      <bpmn:incoming>SequenceFlow_End_Programm</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Optional Counseling Loop (Parallel to Training) -->
    <bpmn:intermediateCatchEvent id="CatchEvent_CounselingRequest" name="Anfrage Ernährungsberatung">
      <bpmn:outgoing>SequenceFlow_TriggerCounseling</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Counseling Task -->
    <bpmn:task id="Task_Counseling" name="Ernährungsberatung">
      <bpmn:incoming>SequenceFlow_TriggerCounseling</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeFinal_In2</bpmn:outgoing>
    </bpmn:task>

    <!-- Merge before Final Check -->
    <bpmn:parallelGateway id="Gateway_Merge_Final" name="Vor Abschluss-Check">
      <bpmn:incoming>SequenceFlow_Timer_Phase2_End_InA</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_Timer_Phase2_End_InB</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeFinal_ToCheck</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_PG_Split" sourceRef="StartEvent_Start" targetRef="PG_InitSplit" />
    
    <bpmn:sequenceFlow id="SequenceFlow_CheckPath" name="Gesundheits-Check" sourceRef="PG_InitSplit" targetRef="Task_HealthCheck" />
    <bpmn:sequenceFlow id="SequenceFlow_WAI_BloodSample" name="WAI &amp; Blutprobe" sourceRef="Task_HealthCheck" targetRef="Task_WAI_BloodSample" />
    
    <bpmn:sequenceFlow id="SequenceFlow_Merge_Init_In1" sourceRef="Task_WAI_BloodSample" targetRef="Gateway_Merge_Init" />
    
    <bpmn:sequenceFlow id="SequenceFlow_InstructionPath" name="Einweisung" sourceRef="PG_InitSplit" targetRef="Task_TrainingInstruction" />
    <bpmn:sequenceFlow id="SequenceFlow_Merge_Init_In2" sourceRef="Task_TrainingInstruction" targetRef="Gateway_Merge_Init" />
    
    <bpmn:sequenceFlow id="SequenceFlow_CreatePlan" name="Erstellung Plan" sourceRef="Gateway_Merge_Init" targetRef="Task_CreatePlan" />
    
    <bpmn:sequenceFlow id="SequenceFlow_TrainingPhase1_Start" name="Start Training 1" sourceRef="Task_CreatePlan" targetRef="Task_TrainingPhase1" />
    
    <bpmn:sequenceFlow id="SequenceFlow_Timer_Phase1_End_In" sourceRef="Task_TrainingPhase1" targetRef="CatchEvent_Timer_Phase1_End" />
    
    <bpmn:sequenceFlow id="SequenceFlow_MidCheck_Start" name="Zwischen-Check Start" sourceRef="CatchEvent_Timer_Phase1_End" targetRef="Task_MidCheck" />
    
    <bpmn:sequenceFlow id="SequenceFlow_GroupSplit_In" name="Gruppeneinteilung" sourceRef="Task_MidCheck" targetRef="Gateway_Split_Groups" />
    
    <bpmn:sequenceFlow id="SequenceFlow_Path_A" name="Gruppe A (ohne Wearables)" sourceRef="Gateway_Split_Groups" targetRef="Task_TrainingPhase2_A" />
    <bpmn:sequenceFlow id="SequenceFlow_Path_B" name="Gruppe B (mit App &amp; Wearables)" sourceRef="Gateway_Split_Groups" targetRef="Task_TrainingPhase2_B" />
    
    <bpmn:sequenceFlow id="SequenceFlow_Timer_Phase2_End_InA" sourceRef="Task_TrainingPhase2_A" targetRef="CatchEvent_Timer_Phase2_End" />
    <bpmn:sequenceFlow id="SequenceFlow_Timer_Phase2_End_InB" sourceRef="Task_TrainingPhase2_B" targetRef="CatchEvent_Timer_Phase2_End" />
    
    <bpmn:sequenceFlow id="SequenceFlow_FinalCheck_Start" name="Abschluss-Check Start" sourceRef="CatchEvent_Timer_Phase2_End" targetRef="Gateway_Merge_Final" />
    
    <!-- Counseling Loop -->
    <bpmn:sequenceFlow id="SequenceFlow_TriggerCounseling" sourceRef="CatchEvent_CounselingRequest" targetRef="Task_Counseling" />
    <bpmn:sequenceFlow id="SequenceFlow_MergeFinal_In2" name="Ernährungsberatung abgeschlossen" sourceRef="Task_Counseling" targetRef="Gateway_Merge_Final" />
    
    <!-- Final Check Merge -->
    <bpmn:sequenceFlow id="SequenceFlow_MergeFinal_ToCheck" name="Zu Abschluss-Check" sourceRef="Gateway_Merge_Final" targetRef="Task_FinalCheck" />
    
    <bpmn:sequenceFlow id="SequenceFlow_End_Programm" name="Programmende" sourceRef="Task_FinalCheck" targetRef="EndEvent_Programm" />

  </bpmn:process>

</bpmn:definitions>