<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Firmenfragebogen Prozess" processRef="Process_1" />
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_System" name="Systemverarbeitung">
        <bpmn:flowNodeRef>StartEvent_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Erfassen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Service_PartnerSuche</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PartnerMatch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DataVerify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Service_BetriebsnummerPruefung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ContributionsCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ContactVerify</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Manual" name="Manuelle Bearbeitung">
        <bpmn:flowNodeRef>User_TaskManualCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>User_ExceptionHandling</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_0" name="Firmenfragebogen eingegangen">
      <bpmn:outgoing>Sequence_Erfassen</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Capture Task -->
    <bpmn:task id="Task_Erfassen" name="Erfassen &amp; im System verarbeiten">
      <bpmn:incoming>Sequence_Erfassen</bpmn:incoming>
      <bpmn:outgoing>Sequence_PartnerSuche</bpmn:outgoing>
    </bpmn:task>

    <!-- Partner Search -->
    <bpmn:serviceTask id="Service_PartnerSuche" name="Automatische Partnersuche">
      <bpmn:incoming>Sequence_PartnerSuche</bpmn:incoming>
      <bpmn:outgoing>Sequence_PartnerMatchCheck</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Partner Match Gateway -->
    <bpmn:exclusiveGateway id="Gateway_PartnerMatch" name="Partner gefunden?">
      <bpmn:incoming>Sequence_PartnerMatchCheck</bpmn:incoming>
      <bpmn:outgoing>Sequence_ManualCheckPath</bpmn:outgoing>
      <bpmn:outgoing>Sequence_DataVerifyStart</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Manual Check Task -->
    <bpmn:userTask id="User_TaskManualCheck" name="Manuelle Prüfung durch Sachbearbeiter">
      <bpmn:incoming>Sequence_ManualCheckPath</bpmn:incoming>
      <bpmn:outgoing>Sequence_DataVerifyStartMerge</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Data Verification -->
    <bpmn:task id="Task_DataVerify" name="Überprüfung relevanter Unternehmensdaten">
      <bpmn:incoming>Sequence_DataVerifyStart</bpmn:incoming>
      <bpmn:outgoing>Sequence_BetriebsnummerCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Specific Checks (Simplified as Service Tasks for System Logic) -->
    <bpmn:serviceTask id="Service_BetriebsnummerPruefung" name="Kontrolle Betriebs-/Betriebsstättennummer">
      <bpmn:incoming>Sequence_BetriebsnummerCheck</bpmn:incoming>
      <bpmn:outgoing>Sequence_U1InsolvencyCheck</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- U1 & Insolvency Check -->
    <bpmn:task id="Task_U1Insolvency" name="Prüfung U1-Verfahren und Insolvenzrücklage">
      <bpmn:incoming>Sequence_U1InsolvencyCheck</bpmn:incoming>
      <bpmn:outgoing>Sequence_EmployerID</bpmn:outgoing>
    </bpmn:task>

    <!-- Employer ID -->
    <bpmn:serviceTask id="Service_EmployerIdentify" name="Eindeutige Arbeitgeber-Identifikation">
      <bpmn:incoming>Sequence_EmployerID</bpmn:incoming>
      <bpmn:outgoing>Sequence_PeriodCheckStart</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Reporting Period Check -->
    <bpmn:task id="Task_PeriodCheck" name="Kontrolle Meldezeitraum">
      <bpmn:incoming>Sequence_PeriodCheckStart</bpmn:incoming>
      <bpmn:outgoing>Sequence_ContributionsDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Contributions Decision -->
    <bpmn:exclusiveGateway id="Gateway_ContributionsCheck" name="Umlageversicherungszeiten vorhanden?">
      <bpmn:incoming>Sequence_ContributionsDecision</bpmn:incoming>
      <bpmn:outgoing>Sequence_VerifyContribs</bpmn:outgoing>
      <bpmn:outgoing>Sequence_CreateNewContribs</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Verify Existing -->
    <bpmn:serviceTask id="Service_VerifyContribs" name="Überprüfe vorhandene Einträge">
      <bpmn:incoming>Sequence_VerifyContribs</bpmn:incoming>
      <bpmn:outgoing>Sequence_ContribsMerge</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Create New -->
    <bpmn:task id="Task_CreateNewContribs" name="Neue Umlageversicherungszeiten anlegen">
      <bpmn:incoming>Sequence_CreateNewContribs</bpmn:incoming>
      <bpmn:outgoing>Sequence_ContribsMerge</bpmn:outgoing>
    </bpmn:task>

    <!-- Contact Data Verification -->
    <bpmn:task id="Task_ContactVerify" name="Prüfung Kontaktdaten (Tel, Fax, Adresse)">
      <bpmn:incoming>Sequence_ContribsMerge</bpmn:incoming>
      <bpmn:outgoing>Sequence_ProblemCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Problem Check Gateway -->
    <bpmn:exclusiveGateway id="Gateway_ProblemCheck" name="Problem oder Klärungsbedarf?">
      <bpmn:incoming>Sequence_ProblemCheck</bpmn:incoming>
      <bpmn:outgoing>Sequence_SuccessEnd</bpmn:outgoing>
      <bpmn:outgoing>Sequence_ExceptionHandlingPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Exception Handling Task -->
    <bpmn:userTask id="User_ExceptionHandling" name="Zuständiger Mitarbeiter zur weiteren Bearbeitung">
      <bpmn:incoming>Sequence_ExceptionHandlingPath</bpmn:incoming>
      <bpmn:outgoing>Sequence_ManualCheckLoopBack</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="End_Success" name="Daten erfolgreich geprüft">
      <bpmn:incoming>Sequence_SuccessEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Sequence_Erfassen" sourceRef="StartEvent_0" targetRef="Task_Erfassen" />
    
    <bpmn:sequenceFlow id="Sequence_PartnerSuche" sourceRef="Task_Erfassen" targetRef="Service_PartnerSuche" />

    <bpmn:sequenceFlow id="Sequence_PartnerMatchCheck" name="Automatische Suche abgeschlossen" sourceRef="Service_PartnerSuche" targetRef="Gateway_PartnerMatch" />
    
    <!-- Gateway Logic -->
    <bpmn:sequenceFlow id="Sequence_ManualCheckPath" name="Nein (Kein Partner)" sourceRef="Gateway_PartnerMatch" targetRef="User_TaskManualCheck">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!partner_found}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Sequence_DataVerifyStart" name="Ja (Partner gefunden)" sourceRef="Gateway_PartnerMatch" targetRef="Task_DataVerify">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${partner_found}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Merge Manual Check -->
    <bpmn:exclusiveGateway id="Gateway_ManualMerge" name="Manuelle Prüfung abgeschlossen?">
      <bpmn:incoming>Sequence_DataVerifyStart</bpmn:incoming>
      <bpmn:incoming>Sequence_ManualCheckPath</bpmn:incoming> <!-- Wait, this is wrong logic for merge. Manual check should go to Data Verify start -->
    </bpmn:exclusiveGateway>

    <!-- Correcting Merge Logic manually in flow definitions below -->
    
    <bpmn:sequenceFlow id="Sequence_DataVerifyStartMerge" sourceRef="User_TaskManualCheck" targetRef="Task_DataVerify">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${manual_check_done}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Data Verification Flow -->
    <bpmn:sequenceFlow id="Sequence_BetriebsnummerCheck" sourceRef="Task_DataVerify" targetRef="Service_BetriebsnummerPruefung">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${data_verification_start}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Sequence_U1InsolvencyCheck" sourceRef="Service_BetriebsnummerPruefung" targetRef="Task_U1Insolvency">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${check_complete}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Sequence_EmployerID" sourceRef="Task_U1Insolvency" targetRef="Service_EmployerIdentify">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${u1_insol_check_done}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Period Check Flow -->
    <bpmn:sequenceFlow id="Sequence_PeriodCheckStart" sourceRef="Service_EmployerIdentify" targetRef="Task_PeriodCheck">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${employer_identified}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Contributions Decision Flow -->
    <bpmn:sequenceFlow id="Sequence_ContributionsDecision" sourceRef="Task_PeriodCheck" targetRef="Gateway_ContributionsCheck">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${period_checked}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Contributions Logic -->
    <bpmn:sequenceFlow id="Sequence_VerifyContribs" name="Ja (Vorhanden)" sourceRef="Gateway_ContributionsCheck" targetRef="Service_VerifyContribs">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${contributions_exist}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Sequence_CreateNewContribs" name="Nein (Fehlend)" sourceRef="Gateway_ContributionsCheck" targetRef="Task_CreateNewContribs">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!contributions_exist}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Merge Contributions -->
    <bpmn:exclusiveGateway id="Gateway_ContribMerge" name="Umlagezeiten bearbeitet?">
      <bpmn:incoming>Sequence_VerifyContribs</bpmn:incoming>
      <bpmn:incoming>Sequence_CreateNewContribs</bpmn:incoming>
    </bpmn:exclusiveGateway>

    <!-- Contact Data Flow -->
    <bpmn:sequenceFlow id="Sequence_ContribsMerge" sourceRef="Gateway_ContribMerge" targetRef="Task_ContactVerify">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${contributions_done}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Problem Check Flow -->
    <bpmn:sequenceFlow id="Sequence_ProblemCheck" sourceRef="Task_ContactVerify" targetRef="Gateway_ProblemCheck">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${contact_check_done}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Exception Handling Flow -->
    <bpmn:sequenceFlow id="Sequence_ExceptionHandlingPath" name="Problem/Klärungsbedarf" sourceRef="Gateway_ProblemCheck" targetRef="User_ExceptionHandling">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${problem_found}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Loop Back -->
    <bpmn:sequenceFlow id="Sequence_ManualCheckLoopBack" sourceRef="User_ExceptionHandling" targetRef="Task_DataVerify">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${issue_resolved}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Success End Flow -->
    <bpmn:sequenceFlow id="Sequence_SuccessEnd" name="Kein Problem" sourceRef="Gateway_ProblemCheck" targetRef="End_Success">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${no_problem}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>