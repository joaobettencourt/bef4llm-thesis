<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_Unbedenklichkeit">
    <bpmn:participant id="Participant_Process" name="Unbedenklichkeitsbescheinigung Prozess" processRef="Process_1" />
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_AutomatedChecks" name="System Automation &amp; Checks">
        <bpmn:flowNodeRef>StartEvent_AnfrageEingang</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VorgangInitialisierung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PersonExistiert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RolleArbeitgeber</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VersicherungszeitenPruefen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BeitragsnachweisePruefen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BeitragsschaetzungenPruefen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OffeneForderungenPruefen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_UnbedenklichkeitBewertung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BescheinigungAusstellen_Ganzheitlich</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BescheinigungAusstellen_MitHinweis</bpmn:flowNodeRef>
        <bpmn:endEvent id="EndEvent_SuccessfulIssuance">
          <bpmn:name>Bescheinigung erfolgreich</bpmn:name>
        </bpmn:endEvent>
      </bpmn:lane>

      <bpmn:lane id="Lane_ManualHandling" name="Manual Handling &amp; Exceptions">
        <bpmn:flowNodeRef>Task_AnscreibenErstellen</bpmn:flowNodeRef>
        <bpmn:endEvent id="EndEvent_InfoRequested">
          <bpmn:name>Info angefordert</bpmn:name>
        </bpmn:endEvent>
        <bpmn:flowNodeRef>Task_FallAnSachbearbeiterUebergeben</bpmn:flowNodeRef>
        <bpmn:endEvent id="EndEvent_ManualReview">
          <bpmn:name>Manuelle Bearbeitung</bpmn:name>
        </bpmn:endEvent>
      </bpmn:lane>

      <bpmn:lane id="Lane_Logistics" name="System Logs">
        <bpmn:flowNodeRef>Task_KontakthistorieEintrag</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_AnfrageEingang" name="Anfrage Eingang">
      <bpmn:outgoing>SequenceFlow_VorgangInitialisierung</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Initialization -->
    <bpmn:task id="Task_VorgangInitialisierung" name="Vorgang initialisieren &amp; Anzahl auf null setzen">
      <bpmn:incoming>SequenceFlow_VorgangInitialisierung</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PersonExistiertCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Person Exists -->
    <bpmn:exclusiveGateway id="Gateway_PersonExistiert" name="Person im System?">
      <bpmn:incoming>SequenceFlow_PersonExistiertCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RolleArbeitgeberPruefen</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Gateway 2: Employer Role -->
    <bpmn:exclusiveGateway id="Gateway_RolleArbeitgeber" name="Rolle Arbeitgeber?">
      <bpmn:incoming>SequenceFlow_RolleArbeitgeberPruefen</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AnscreibenErstellen</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 3a: Create Letter (No Employer) -->
    <bpmn:task id="Task_AnscreibenErstellen" name="Anschreiben erstellen">
      <bpmn:incoming>SequenceFlow_AnscreibenErstellen</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InfoRequestedEnd</bpmn:outgoing>
    </bpmn:task>

    <!-- Task Sequence for Checks (Employer Path) -->
    <bpmn:task id="Task_VersicherungszeitenPruefen" name="Versicherungszeiten im Beitragsmonat prüfen">
      <bpmn:incoming>SequenceFlow_RolleArbeitgeberCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BeitragsnachweisePruefen</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_BeitragsnachweisePruefen" name="Anzahl Beitragsnachweise prüfen">
      <bpmn:incoming>SequenceFlow_BeitragsnachweisePruefen</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SchaetzungenPruefen</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_BeitragsschaetzungenPruefen" name="Beitragsschätzungen prüfen (0,00 €)">
      <bpmn:incoming>SequenceFlow_SchaetzungenPruefen</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OffeneForderungenCheck</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_OffeneForderungenPruefen" name="Offene Forderungen prüfen">
      <bpmn:incoming>SequenceFlow_OffeneForderungenCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BewertungGateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 3: Evaluation -->
    <bpmn:exclusiveGateway id="Gateway_UnbedenklichkeitBewertung" name="Unbedenklichkeitsbewertung">
      <bpmn:incoming>SequenceFlow_BewertungGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CertificateFullStanding</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CertificatePartialNote</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_HandoverOfficer</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 4a: Issue Full Standing Certificate -->
    <bpmn:task id="Task_BescheinigungAusstellen_Ganzheitlich" name="Bescheinigung ausstellen (Vollständig)">
      <bpmn:incoming>SequenceFlow_CertificateFullStanding</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_LogHistoryMerge1</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 4b: Issue Certificate with Note -->
    <bpmn:task id="Task_BescheinigungAusstellen_MitHinweis" name="Bescheinigung ausstellen (Mit Hinweis)">
      <bpmn:incoming>SequenceFlow_CertificatePartialNote</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_LogHistoryMerge2</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 5: Log History -->
    <bpmn:task id="Task_KontakthistorieEintrag" name="Kontakthistorie Eintrag">
      <bpmn:incoming>SequenceFlow_LogHistoryMerge1</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_LogHistoryMerge2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SuccessEnd</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 6: Handover to Officer -->
    <bpmn:task id="Task_FallAnSachbearbeiterUebergeben" name="Fall an Sachbearbeiter übergeben">
      <bpmn:incoming>SequenceFlow_HandoverOfficer</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ManualReviewEnd</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 1: Info Requested -->
    <bpmn:endEvent id="EndEvent_InfoRequested" name="Info angefordert">
      <bpmn:incoming>SequenceFlow_InfoRequestedEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- End Event 2: Successful Issuance -->
    <bpmn:endEvent id="EndEvent_SuccessfulIssuance" name="Bescheinigung erfolgreich">
      <bpmn:incoming>SequenceFlow_SuccessEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- End Event 3: Manual Review -->
    <bpmn:endEvent id="EndEvent_ManualReview" name="Manuelle Bearbeitung">
      <bpmn:incoming>SequenceFlow_ManualReviewEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_VorgangInitialisierung" sourceRef="StartEvent_AnfrageEingang" targetRef="Task_VorgangInitialisierung">
      <bpmn:name>Antrag eingegangen</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_PersonExistiertCheck" sourceRef="Task_VorgangInitialisierung" targetRef="Gateway_PersonExistiert">
      <bpmn:name>Vorgang initialisiert</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Implicit path for Person Exists = Yes -->
    <bpmn:sequenceFlow id="SequenceFlow_RolleArbeitgeberPruefen" sourceRef="Gateway_PersonExistiert" targetRef="Gateway_RolleArbeitgeber">
      <bpmn:name>Ja</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Implicit path for Person Exists = No (End) -->

    <bpmn:sequenceFlow id="SequenceFlow_AnscreibenErstellen" sourceRef="Gateway_RolleArbeitgeber" targetRef="Task_AnscreibenErstellen">
      <bpmn:name>Rolle nicht Arbeitgeber</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Implicit path for Employer Role = Yes -->
    <bpmn:sequenceFlow id="SequenceFlow_RolleArbeitgeberCheck" sourceRef="Gateway_RolleArbeitgeber" targetRef="Task_VersicherungszeitenPruefen">
      <bpmn:name>Rolle Arbeitgeber</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_BeitragsnachweisePruefen" sourceRef="Task_VersicherungszeitenPruefen" targetRef="Task_BeitragsnachweisePruefen">
      <bpmn:name>Vorprüfung abgeschlossen</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_SchaetzungenPruefen" sourceRef="Task_BeitragsnachweisePruefen" targetRef="Task_BeitragsschaetzungenPruefen">
      <bpmn:name>Nachweiszahl korrekt</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_OffeneForderungenCheck" sourceRef="Task_BeitragsschaetzungenPruefen" targetRef="Task_OffeneForderungenPruefen">
      <bpmn:name>Schätzung geprüft</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_BewertungGateway" sourceRef="Task_OffeneForderungenPruefen" targetRef="Gateway_UnbedenklichkeitBewertung">
      <bpmn:name>Fragen geprüft</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Evaluation Outcomes -->
    <bpmn:sequenceFlow id="SequenceFlow_CertificateFullStanding" sourceRef="Gateway_UnbedenklichkeitBewertung" targetRef="Task_BescheinigungAusstellen_Ganzheitlich">
      <bpmn:name>Vollständige Unbedenklichkeit</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_CertificatePartialNote" sourceRef="Gateway_UnbedenklichkeitBewertung" targetRef="Task_BescheinigungAusstellen_MitHinweis">
      <bpmn:name>Bedingte Unbedenklichkeit</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_HandoverOfficer" sourceRef="Gateway_UnbedenklichkeitBewertung" targetRef="Task_FallAnSachbearbeiterUebergeben">
      <bpmn:name>Voraussetzungen nicht erfüllt</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Merge to Log -->
    <bpmn:sequenceFlow id="SequenceFlow_LogHistoryMerge1" sourceRef="Task_BescheinigungAusstellen_Ganzheitlich" targetRef="Task_KontakthistorieEintrag">
      <bpmn:name>Cert issued</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_LogHistoryMerge2" sourceRef="Task_BescheinigungAusstellen_MitHinweis" targetRef="Task_KontakthistorieEintrag">
      <bpmn:name>Cert issued</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- End Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_SuccessEnd" sourceRef="Task_KontakthistorieEintrag" targetRef="EndEvent_SuccessfulIssuance">
      <bpmn:name>Erfolgreich</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_InfoRequestedEnd" sourceRef="Task_AnscreibenErstellen" targetRef="EndEvent_InfoRequested">
      <bpmn:name>Anfrage abgeschlossen</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ManualReviewEnd" sourceRef="Task_FallAnSachbearbeiterUebergeben" targetRef="EndEvent_ManualReview">
      <bpmn:name>Zur Bearbeitung</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>