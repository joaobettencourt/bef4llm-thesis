<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_HealthProgram_v2" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_HealthPromotion">
    <bpmn:participant id="Participant_Process" name="Betriebliches Gesundheitsförderungsprogramm" processRef="Process_1" />
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Participants" name="Teilnehmer">
        <bpmn:flowNodeRef>StartEvent_Programm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AppInstruction</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CounselingLoop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NutritionalCounseling</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TrainingPhase1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_GroupSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IndependentTraining</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SupportedTraining</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Coaches" name="Gesundheitscoaches &amp; Personal">
        <bpmn:flowNodeRef>Gateway_InitialSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ComprehensiveHealthCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PlanMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateIndividualPlans</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IntermediateCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_FinalJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FinalHealthCheck</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Programm" name="Programmstart">
      <bpmn:outgoing>SequenceFlow_StartToSplit</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Initial Parallel Split (Health Check & App Instruction) -->
    <bpmn:parallelGateway id="Gateway_InitialSplit" name="Start Phase">
      <bpmn:incoming>SequenceFlow_StartToSplit</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MedicalTasks</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_AppInstructionTask</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Medical Tasks -->
    <bpmn:task id="Task_ComprehensiveHealthCheck" name="Gesundheits-Check (Parameter, WAI, Blutprobe)">
      <bpmn:incoming>SequenceFlow_MedicalTasks</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckToMerge</bpmn:outgoing>
    </bpmn:task>

    <!-- Participant Tasks -->
    <bpmn:task id="Task_AppInstruction" name="Einweisung App &amp; Wearables">
      <bpmn:incoming>SequenceFlow_AppInstructionTask</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InstructionToMerge</bpmn:outgoing>
    </bpmn:task>

    <!-- Plan Creation Merge -->
    <bpmn:parallelGateway id="Gateway_PlanMerge" name="Daten &amp; Instruktion bereit">
      <bpmn:incoming>SequenceFlow_CheckToMerge</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_InstructionToMerge</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PlanCreationStart</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Plan Creation Task -->
    <bpmn:task id="Task_CreateIndividualPlans" name="Trainings- &amp; Ernährungspläne erstellen">
      <bpmn:incoming>SequenceFlow_PlanCreationStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TrainingPhase1Start</bpmn:outgoing>
    </bpmn:task>

    <!-- Training Phase 1 (6 Months) -->
    <bpmn:exclusiveGateway id="Gateway_CounselingLoop" name="Beratung nötig?">
      <bpmn:incoming>SequenceFlow_TrainingPhase1Start</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NeedCounselingYes</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Optional Counseling Task -->
    <bpmn:task id="Task_NutritionalCounseling" name="Zusätzliche Ernährungsberatung">
      <bpmn:incoming>SequenceFlow_NeedCounselingYes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CounselingBackToLoop</bpmn:outgoing>
    </bpmn:task>

    <!-- Loop Logic for Counseling -->
    <bpmn:sequenceFlow id="SequenceFlow_NeedCounselingYes" sourceRef="Gateway_CounselingLoop" targetRef="Task_NutritionalCounseling">
      <bpmn:name>Jawohl</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Re-joining flow for loop -->
    <bpmn:exclusiveGateway id="Gateway_CounselingDecision" name="Noch Beratung?">
        <bpmn:incoming>SequenceFlow_CounselingBackToLoop</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_TrainingContinue</bpmn:outgoing>
    </bpmn:exclusiveGateway>

     <!-- Loop Back -->
    <bpmn:sequenceFlow id="SequenceFlow_CounselingBackToLoop" sourceRef="Task_NutritionalCounseling" targetRef="Gateway_CounselingDecision">
      <bpmn:name>Beratung abgeschlossen</bpmn:name>
    </bpmn:sequenceFlow>

     <!-- Decision for Loop -->
    <bpmn:exclusiveGateway id="Gateway_TrainingContinueCheck" name="Noch Beratung?">
        <bpmn:incoming>SequenceFlow_CounselingBackToLoop</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_MidCheckStart</bpmn:outgoing>
    </bpmn:exclusiveGateway>

     <!-- Loop Back to Start of Phase 1 Logic (Simplified for XML validity) -->
    <bpmn:sequenceFlow id="SequenceFlow_TrainingContinue" sourceRef="Gateway_CounselingLoop" targetRef="Task_NutritionalCounseling">
      <bpmn:name>Ja</bpmn:name>
    </bpmn:sequenceFlow>

     <!-- Loop Back to Start of Phase 1 Logic (Simplified for XML validity) -->
    <bpmn:exclusiveGateway id="Gateway_TrainingLoopDecision" name="Beratung abgeschlossen?">
        <bpmn:incoming>SequenceFlow_CounselingBackToLoop</bpmn:outgoing>
            <bpmn:outgoing>SequenceFlow_MidCheckStart</bpmn:outgoing>
    </bpmn:exclusiveGateway>

     <!-- Mid-Point Check -->
    <bpmn:task id="Task_IntermediateCheck" name="Zwischen-Check (Fortschrittsdokumentation)">
      <bpmn:incoming>SequenceFlow_MidCheckStart</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow_GroupSplitDecision</bpmn:outgoing>
    </bpmn:task>

     <!-- Sequence Flow from Training Phase 1 Start to Counseling Loop -->
    <bpmn:sequenceFlow id="SequenceFlow_TrainingPhase1Start" sourceRef="Task_CreateIndividualPlans" targetRef="Gateway_CounselingLoop">
      <bpmn:name>Training Phase 6 Monate</bpmn:name>
    </bpmn:sequenceFlow>

     <!-- Sequence Flow from Counseling Loop to Mid Check -->
    <bpmn:exclusiveGateway id="Gateway_TrainingToMidCheck" name="Beratung abgeschlossen?">
        <bpmn:incoming>SequenceFlow_CounselingBackToLoop</bpmn:outgoing>
            <bpmn:outgoing>SequenceFlow_MidCheckStart</bpmn:outgoing>
    </bpmn:exclusiveGateway>

     <!-- Mid Check Start Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_CounselingBackToLoop" sourceRef="Task_NutritionalCounseling" targetRef="Gateway_TrainingToMidCheck">
      <bpmn:name>Zurück zum Training</bpmn:name>
    </bpmn:sequenceFlow>

     <!-- Mid Check Start Flow -->
    <bpmn:exclusiveGateway id="Gateway_CounselingOption2" name="Noch Beratung?">
        <bpmn:incoming>SequenceFlow_TrainingPhase1Start</bpmn:outgoing>
            <bpmn:outgoing>SequenceFlow_MidCheckStart</bpmn:outgoing>
    </bpmn:exclusiveGateway>

     <!-- Mid Check Start Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_TrainingPhase1Loop" sourceRef="Task_NutritionalCounseling" targetRef="Gateway_CounselingOption2">
      <bpmn:name>Beratung abgeschlossen</bpmn:name>
    </bpmn:sequenceFlow>

     <!-- Mid Check Start Flow -->
    <bpmn:exclusiveGateway id="Gateway_TrainingLoopFinal" name="Noch Beratung?">
        <bpmn:incoming>SequenceFlow_CounselingBackToLoop</bpmn:outgoing>
            <bpmn:outgoing>SequenceFlow_MidCheckStart</bpmn:outgoing>
    </bpmn:exclusiveGateway>

     <!-- Mid Check Start Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_TrainingPhase1Loop2" sourceRef="Task_NutritionalCounseling" targetRef="Gateway_CounselingOption2">
      <bpmn:name>Beratung abgeschlossen</bpmn:name>
    </bpmn:sequenceFlow>

     <!-- Mid Check Start Flow -->
