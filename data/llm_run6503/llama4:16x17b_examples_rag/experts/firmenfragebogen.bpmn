<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definition" name="Nach Eingang eines Firmenfragebogens" targetNamespace="http://example.com/bpmn">

   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>

     <task id="Task_1" name="Erfassen und Verarbeiten des Fragebogens">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="ExclusiveGateway_1"/>

     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_4</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_1" targetRef="Task_2"/>
     <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_1" targetRef="UserTask_1"/>

     <task id="Task_2" name="Automatische Suche nach Partnerunternehmen">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_2" targetRef="ExclusiveGateway_2"/>

     <exclusiveGateway id="ExclusiveGateway_2">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_6</outgoing>
       <outgoing>SequenceFlow_7</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_6" sourceRef="ExclusiveGateway_2" targetRef="Task_3"/>
     <sequenceFlow id="SequenceFlow_7" sourceRef="ExclusiveGateway_2" targetRef="UserTask_1"/>

     <task id="Task_3" name="Überprüfung relevanter Unternehmensdaten">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_8</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_8" sourceRef="Task_3" targetRef="Task_4"/>

     <task id="Task_4" name="Meldezeitraum kontrollieren">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_4" targetRef="ExclusiveGateway_3"/>

     <exclusiveGateway id="ExclusiveGateway_3">
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_10</outgoing>
       <outgoing>SequenceFlow_11</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_10" sourceRef="ExclusiveGateway_3" targetRef="Task_5"/>
     <sequenceFlow id="SequenceFlow_11" sourceRef="ExclusiveGateway_3" targetRef="UserTask_2"/>

     <task id="Task_5" name="Überprüfung der Vollständigkeit und Richtigkeit der Kontaktdaten">
       <incoming>SequenceFlow_10</incoming>
       <outgoing>SequenceFlow_12</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_12" sourceRef="Task_5" targetRef="EndEvent_1"/>

     <userTask id="UserTask_1" name="Manuelle Prüfung durch Sachbearbeiter">
       <incoming>SequenceFlow_4</incoming>
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_13</outgoing>
     </userTask>

     <sequenceFlow id="SequenceFlow_13" sourceRef="UserTask_1" targetRef="EndEvent_1"/>

     <userTask id="UserTask_2" name="Manuelle Anlage von Umlageversicherungszeiten">
       <incoming>SequenceFlow_11</incoming>
       <outgoing>SequenceFlow_14</outgoing>
     </userTask>

     <sequenceFlow id="SequenceFlow_14" sourceRef="UserTask_2" targetRef="EndEvent_1"/>

     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_12</incoming>
       <incoming>SequenceFlow_13</incoming>
       <incoming>SequenceFlow_14</incoming>
     </endEvent>
   </process>
 </definitions>