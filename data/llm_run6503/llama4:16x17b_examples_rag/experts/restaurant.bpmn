<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/pec/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/pec/20100524/MODEL BPMN20.xsd"
             id="definition" 
             targetNamespace="http://bpmn.io/schema/bpmn">

   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_Gast_Bestellung"/>

     <task id="Task_Gast_Bestellung" name="Gast bestellt Essen">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_Gast_Bestellung" targetRef="Task_Angestellter_nimmt_Bestellung_auf"/>

     <task id="Task_Angestellter_nimmt_Bestellung_auf" name="Angestellter nimmt Bestellung auf">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_3" sourceRef="Task_Angestellter_nimmt_Bestellung_auf" targetRef="Task_Angestellter_kassiert_Geld"/>

     <task id="Task_Angestellter_kassiert_Geld" name="Angestellter kassiert Geld">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_4</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_4" sourceRef="Task_Angestellter_kassiert_Geld" targetRef="Task_Angestellter_uebergibt_Pieper"/>

     <task id="Task_Angestellter_uebergibt_Pieper" name="Angestellter übergibt Pieper">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_Angestellter_uebergibt_Pieper" targetRef="Task_Koch_bereitet_Essen_zubereiten"/>

     <task id="Task_Koch_bereitet_Essen_zubereiten" name="Koch bereitet Essen zu">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_Koch_bereitet_Essen_zubereiten" targetRef="Task_Koch_informiert_Angestellten"/>

     <task id="Task_Koch_informiert_Angestellten" name="Koch informiert Angestellten">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_7</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_7" sourceRef="Task_Koch_informiert_Angestellten" targetRef="Task_Angestellter_loest_Pieper_aus"/>

     <task id="Task_Angestellter_loest_Pieper_aus" name="Angestellter löst Pieper aus">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_8</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_8" sourceRef="Task_Angestellter_loest_Pieper_aus" targetRef="EndEvent_1"/>

     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_8</incoming>
     </endEvent>
   </process>
</definitions>