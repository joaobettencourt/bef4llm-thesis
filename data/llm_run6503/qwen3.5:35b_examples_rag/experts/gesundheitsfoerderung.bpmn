<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_HealthPromotion" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_Gesundheit">
    <bpmn:participant id="Participant_Gesundheit" name="Betriebliche Gesundheitsförderung" processRef="Process_HealthPromotion" />
  </bpmn:collaboration>

  <bpmn:process id="Process_HealthPromotion" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Gesundheit">
      <bpmn:lane id="Lane_Teilnehmer" name="Teilnehmer">
        <bpmn:flowNodeRef>StartEvent_Programmstart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InitialCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SplitInitial</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TrainingPhase1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IntermediateCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_GroupSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TrainingPhase2A</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TrainingPhase2B</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_JoinTraining1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FinalCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Programmende</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Coaches" name="Gesundheitscoaches / System">
        <bpmn:flowNodeRef>Task_Onboarding</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_JoinInitial</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PlanCreation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CounselingSupport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_GroupSplitLogic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_JoinPhase2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Programmstart" name="Programmstart">
      <bpmn:outgoing>SequenceFlow_SplitInitial</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Initial Health Check (Participant) -->
    <bpmn:userTask id="Task_InitialCheck" name="Gesundheits-Check durchführen">
      <bpmn:incoming>SequenceFlow_SplitInitial</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToJoinInitial</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Onboarding to App and Wearables (Coaches) -->
    <bpmn:userTask id="Task_Onboarding" name="Einweisung in App und Wearables">
      <bpmn:incoming>SequenceFlow_SplitInitial</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ToJoinInitial</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Join after initial phase -->
    <bpmn:parallelGateway id="Gateway_JoinInitial">
      <bpmn:incoming>SequenceFlow_FromCheck</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_FromOnboarding</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToPlanCreation</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Plan Creation -->
    <bpmn:userTask id="Task_PlanCreation" name="Individuelle Trainings- und Ernährungspläne erstellen">
      <bpmn:incoming>SequenceFlow_ToPlanCreation</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TrainingStart</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Training Phase 1 -->
    <bpmn:userTask id="Task_TrainingPhase1" name="Trainingsphase 1 (6 Monate)">
      <bpmn:incoming>SequenceFlow_TrainingStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToIntermediateCheck</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Counseling Support -->
    <bpmn:userTask id="Task_CounselingSupport" name="Ernährungsberatung anbieten">
      <bpmn:incoming>SequenceFlow_TrainingStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToTraining1</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Join Training Phase 1 -->
    <bpmn:parallelGateway id="Gateway_JoinTraining1">
      <bpmn:incoming>SequenceFlow_FromTrainingPhase1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToIntermediateCheck</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Intermediate Check -->
    <bpmn:userTask id="Task_IntermediateCheck" name="Zwischen-Check durchführen">
      <bpmn:incoming>SequenceFlow_ToIntermediateCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GroupSplit</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Group Split -->
    <bpmn:exclusiveGateway id="Gateway_GroupSplit">
      <bpmn:incoming>SequenceFlow_FromIntermediateCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToGroupA</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ToGroupB</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Group A Training (without wearables) -->
    <bpmn:userTask id="Task_TrainingPhase2A" name="Trainingsphase 2 - Gruppe A (ohne Wearables)">
      <bpmn:incoming>SequenceFlow_ToGroupA</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToJoinPhase2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Group B Training (with wearables) -->
    <bpmn:userTask id="Task_TrainingPhase2B" name="Trainingsphase 2 - Gruppe B (mit Wearables)">
      <bpmn:incoming>SequenceFlow_ToGroupB</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToJoinPhase2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Join Phase 2 -->
    <bpmn:parallelGateway id="Gateway_JoinPhase2">
      <bpmn:incoming>SequenceFlow_FromGroupA</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToFinalCheck</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Final Check -->
    <bpmn:userTask id="Task_FinalCheck" name="Abschluss-Gesundheits-Check">
      <bpmn:incoming>SequenceFlow_FromJoinPhase2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToEndEvent</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Programmende" name="Programmende">
      <bpmn:incoming>SequenceFlow_FromFinalCheck</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_SplitInitial" sourceRef="StartEvent_Programmstart" targetRef="Task_InitialCheck" />
    <bpmn:sequenceFlow id="SequenceFlow_FromOnboarding" name="Parallel Onboarding" sourceRef="Gateway_SplitInitial" targetRef="Task_Onboarding" />

    <!-- Join Initial Phase -->
    <bpmn:parallelGateway id="Gateway_JoinInitial">
      <bpmn:incoming>SequenceFlow_FromCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToPlanCreation</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Plan Creation -->
    <bpmn:userTask id="Task_PlanCreation" name="Individuelle Trainings- und Ernährungspläne erstellen">
      <bpmn:incoming>SequenceFlow_ToPlanCreation</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TrainingStart</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Training Phase 1 -->
    <bpmn:userTask id="Task_TrainingPhase1" name="Trainingsphase 1 (6 Monate)">
      <bpmn:incoming>SequenceFlow_TrainingStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToIntermediateCheck</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Counseling Support -->
    <bpmn:userTask id="Task_CounselingSupport" name="Ernährungsberatung anbieten">
      <bpmn:incoming>SequenceFlow_TrainingStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToTraining1</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Join Training Phase 1 -->
    <bpmn:parallelGateway id="Gateway_JoinTraining1">
      <bpmn:incoming>SequenceFlow_FromTrainingPhase1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToIntermediateCheck</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Intermediate Check -->
    <bpmn:userTask id="Task_IntermediateCheck" name="Zwischen-Check durchführen">
      <bpmn:incoming>SequenceFlow_FromJoinTraining1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GroupSplit</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Group Split -->
    <bpmn:exclusiveGateway id="Gateway_GroupSplit">
      <bpmn:incoming>SequenceFlow_FromIntermediateCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToGroupA</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ToGroupB</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Group A Training (without wearables) -->
    <bpmn:userTask id="Task_TrainingPhase2A" name="Trainingsphase 2 - Gruppe A (ohne Wearables)">
      <bpmn:incoming>SequenceFlow_ToGroupA</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToJoinPhase2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Group B Training (with wearables) -->
    <bpmn:userTask id="Task_TrainingPhase2B" name="Trainingsphase 2 - Gruppe B (mit Wearables)">
      <bpmn:incoming>SequenceFlow_ToGroupB</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToJoinPhase2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Join Phase 2 -->
    <bpmn:parallelGateway id="Gateway_JoinPhase2">
      <bpmn:incoming>SequenceFlow_FromGroupA</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToFinalCheck</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Final Check -->
    <bpmn:userTask id="Task_FinalCheck" name="Abschluss-Gesundheits-Check">
      <bpmn:incoming>SequenceFlow_FromJoinPhase2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToEndEvent</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Programmende" name="Programmende">
      <bpmn:incoming>SequenceFlow_FromFinalCheck</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_SplitInitial" sourceRef="StartEvent_Programmstart" targetRef="Gateway_SplitInitial" />
    <bpmn:sequenceFlow id="SequenceFlow_FromCheck" name="Gesundheits-Check abgeschlossen" sourceRef="Task_InitialCheck" targetRef="Gateway_JoinInitial" />
    <bpmn:sequenceFlow id="SequenceFlow_ToJoinInitial" name="Parallel Onboarding" sourceRef="Gateway_SplitInitial" targetRef="Task_Onboarding" />

    <!-- Join Initial Phase -->
    <bpmn:parallelGateway id="Gateway_JoinInitial">
      <bpmn:incoming>SequenceFlow_FromCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToPlanCreation</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Plan Creation -->
    <bpmn:userTask id="Task_PlanCreation" name="Individuelle Trainings- und Ernährungspläne erstellen">
      <bpmn:incoming>SequenceFlow_ToPlanCreation</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TrainingStart</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Training Phase 1 -->
    <bpmn:userTask id="Task_TrainingPhase1" name="Trainingsphase 1 (6 Monate)">
      <bpmn:incoming>SequenceFlow_TrainingStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToIntermediateCheck</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Counseling Support -->
    <bpmn:userTask id="Task_CounselingSupport" name="Ernährungsberatung anbieten">
      <bpmn:incoming>SequenceFlow_TrainingStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToTraining1</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Join Training Phase 1 -->
    <bpmn:parallelGateway id="Gateway_JoinTraining1">
      <bpmn:incoming>SequenceFlow_FromTrainingPhase1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToIntermediateCheck</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Intermediate Check -->
    <bpmn:userTask id="Task_IntermediateCheck" name="Zwischen-Check durchführen">
      <bpmn:incoming>SequenceFlow_FromJoinTraining1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GroupSplit</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Group Split -->
    <bpmn:exclusiveGateway id="Gateway_GroupSplit">
      <bpmn:incoming>SequenceFlow_FromIntermediateCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToGroupA</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ToGroupB</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Group A Training (without wearables) -->
    <bpmn:userTask id="Task_TrainingPhase2A" name="Trainingsphase 2 - Gruppe A (ohne Wearables)">
      <bpmn:incoming>SequenceFlow_ToGroupA</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToJoinPhase2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Group B Training (with wearables) -->
    <bpmn:userTask id="Task_TrainingPhase2B" name="Trainingsphase 2 - Gruppe B (mit Wearables)">
      <bpmn:incoming>SequenceFlow_ToGroupB</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToJoinPhase2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Join Phase 2 -->
    <bpmn:parallelGateway id="Gateway_JoinPhase2">
      <bpmn:incoming>SequenceFlow_FromGroupA</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToFinalCheck</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Final Check -->
    <bpmn:userTask id="Task_FinalCheck" name="Abschluss-Gesundheits-Check">
      <bpmn:incoming>SequenceFlow_FromJoinPhase2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToEndEvent</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Programmende" name="Programmende">
      <bpmn:incoming>SequenceFlow_FromFinalCheck</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_SplitInitial" sourceRef="StartEvent_Programmstart" targetRef="Gateway_SplitInitial" />
    <bpmn:sequenceFlow id="SequenceFlow_FromCheck" name="Gesundheits-Check abgeschlossen" sourceRef="Task_InitialCheck" targetRef="Gateway_JoinInitial" />
    <bpmn:sequenceFlow id="SequenceFlow_ToJoinInitial" name="Parallel Onboarding" sourceRef="Gateway_SplitInitial" targetRef="Task_Onboarding" />

    <!-- Join Initial Phase -->
    <bpmn:parallelGateway id="Gateway_JoinInitial">
      <bpmn:incoming>SequenceFlow_FromCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToPlanCreation</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Plan Creation -->
    <bpmn:userTask id="Task_PlanCreation" name="Individuelle Trainings- und Ernährungspläne erstellen">
      <bpmn:incoming>SequenceFlow_ToPlanCreation</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TrainingStart</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Training Phase 1 -->
    <bpmn:userTask id="Task_TrainingPhase1" name="Trainingsphase 1 (6 Monate)">
      <bpmn:incoming>SequenceFlow_TrainingStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToIntermediateCheck</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Counseling Support -->
    <bpmn:userTask id="Task_CounselingSupport" name="Ernährungsberatung anbieten">
      <bpmn:incoming>SequenceFlow_TrainingStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToTraining1</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Join Training Phase 1 -->
    <bpmn:parallelGateway id="Gateway_JoinTraining1">
      <bpmn:incoming>SequenceFlow_FromTrainingPhase1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToIntermediateCheck</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Intermediate Check -->
    <bpmn:userTask id="Task_IntermediateCheck" name="Zwischen-Check durchführen">
      <bpmn:incoming>SequenceFlow_FromJoinTraining1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GroupSplit</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Group Split -->
    <bpmn:exclusiveGateway id="Gateway_GroupSplit">
      <bpmn:incoming>SequenceFlow_FromIntermediateCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToGroupA</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ToGroupB</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Group A Training (without wearables) -->
