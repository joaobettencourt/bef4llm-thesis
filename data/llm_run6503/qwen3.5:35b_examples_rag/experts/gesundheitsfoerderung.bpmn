      <bpmn:incoming>SequenceFlow_TrainingStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToTraining1</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Join Training Phase 1 -->
    <bpmn:parallelGateway id="Gateway_JoinTraining1">
      <bpmn:incoming>SequenceFlow_FromTrainingPhase1</bpmn:incoming>
