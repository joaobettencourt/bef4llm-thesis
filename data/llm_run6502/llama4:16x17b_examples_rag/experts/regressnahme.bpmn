<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://bpmn.io/schema/bpmn">

  <process id="insurance_process" isExecutable="true">
    <startEvent id="start_event">
      <outgoing>sequence_flow_1</outgoing>
    </startEvent>

    <sequenceFlow id="sequence_flow_1" sourceRef="start_event" targetRef="task_check_case"/>

    <userTask id="task_check_case" name="Fall prüfen">
      <incoming>sequence_flow_1</incoming>
      <outgoing>sequence_flow_2</outgoing>
      <outgoing>sequence_flow_3</outgoing>
    </userTask>

    <exclusiveGateway id="exclusive_gateway_1">
      <incoming>sequence_flow_2</incoming>
      <outgoing>sequence_flow_4</outgoing>
      <outgoing>sequence_flow_5</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequence_flow_2" sourceRef="task_check_case" targetRef="exclusive_gateway_1"/>

    <sequenceFlow id="sequence_flow_3" name="nein" sourceRef="task_check_case" targetRef="end_event_1"/>

    <userTask id="task_send_payment_request" name="Zahlungsaufforderung senden">
      <incoming>sequence_flow_4</incoming>
      <outgoing>sequence_flow_6</outgoing>
    </userTask>

    <sequenceFlow id="sequence_flow_4" name="ja" sourceRef="exclusive_gateway_1" targetRef="task_send_payment_request"/>

    <serviceTask id="task_set_reminder" name="Auf Wiedervorlage setzen">
      <incoming>sequence_flow_6</incoming>
      <outgoing>sequence_flow_7</outgoing>
    </serviceTask>

    <sequenceFlow id="sequence_flow_5" name="nein" sourceRef="exclusive_gateway_1" targetRef="end_event_1"/>

    <sequenceFlow id="sequence_flow_6" sourceRef="task_send_payment_request" targetRef="task_set_reminder"/>

    <userTask id="task_check_objection" name="Widerspruch prüfen">
      <incoming>sequence_flow_9</incoming>
      <outgoing>sequence_flow_10</outgoing>
      <outgoing>sequence_flow_11</outgoing>
    </userTask>

    <exclusiveGateway id="exclusive_gateway_2">
      <incoming>sequence_flow_10</incoming>
      <outgoing>sequence_flow_12</outgoing>
      <outgoing>sequence_flow_13</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequence_flow_7" sourceRef="task_set_reminder" targetRef="user_task_check_payment"/>

    <userTask id="user_task_check_payment" name="Geldeingang prüfen">
      <incoming>sequence_flow_7</incoming>
      <outgoing>sequence_flow_8</outgoing>
      <outgoing>sequence_flow_9</outgoing>
    </userTask>

    <sequenceFlow id="sequence_flow_8" sourceRef="user_task_check_payment" targetRef="end_event_1"/>

    <sequenceFlow id="sequence_flow_9" name="VN widerspricht" sourceRef="user_task_check_payment" targetRef="task_check_objection"/>

    <sequenceFlow id="sequence_flow_10" name="ja" sourceRef="task_check_objection" targetRef="exclusive_gateway_2"/>

    <sequenceFlow id="sequence_flow_11" name="nein" sourceRef="task_check_objection" targetRef="service_task_send_to_collection"/>

    <sequenceFlow id="sequence_flow_12" name="ja" sourceRef="exclusive_gateway_2" targetRef="end_event_1"/>

    <sequenceFlow id="sequence_flow_13" name="nein" sourceRef="exclusive_gateway_2" targetRef="service_task_send_to_collection"/>

    <serviceTask id="service_task_send_to_collection" name="An Inkasso-Dienstleister senden">
      <incoming>sequence_flow_11</incoming>
      <incoming>sequence_flow_13</incoming>
      <outgoing>sequence_flow_14</outgoing>
    </serviceTask>

    <sequenceFlow id="sequence_flow_14" sourceRef="service_task_send_to_collection" targetRef="end_event_1"/>

    <endEvent id="end_event_1">
      <incoming>sequence_flow_3</incoming>
      <incoming>sequence_flow_8</incoming>
      <incoming>sequence_flow_12</incoming>
      <incoming>sequence_flow_14</incoming>
    </endEvent>

  </process>

</definitions>