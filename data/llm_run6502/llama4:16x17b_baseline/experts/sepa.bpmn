<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
                 id="definitions" name="SEPA Mandat Process">

  <bpmn:process id="sepaMandatProcess" isExecutable="true">
    <bpmn:startEvent id="startEvent1">
      <bpmn:outgoing>sequenceFlow1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="taskCheckIBAN" name="Prüfung IBAN">
      <bpmn:incoming>sequenceFlow1</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow2</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="taskCheckIBAN"/>

    <bpmn:exclusiveGateway id="exclusiveGateway1">
      <bpmn:incoming>sequenceFlow2</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow3</bpmn:outgoing>
      <bpmn:outgoing>sequenceFlow4</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="sequenceFlow2" sourceRef="taskCheckIBAN" targetRef="exclusiveGateway1"/>

    <bpmn:userTask id="taskSearchPerson" name="Suche nach Person">
      <bpmn:incoming>sequenceFlow3</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow5</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:sequenceFlow id="sequenceFlow3" sourceRef="exclusiveGateway1" targetRef="taskSearchPerson"/>

    <bpmn:exclusiveGateway id="exclusiveGateway2">
      <bpmn:incoming>sequenceFlow5</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow6</bpmn:outgoing>
      <bpmn:outgoing>sequenceFlow7</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="sequenceFlow5" sourceRef="taskSearchPerson" targetRef="exclusiveGateway2"/>

    <bpmn:userTask id="taskManualCheck1" name="Manuelle Prüfung">
      <bpmn:incoming>sequenceFlow6</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow8</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:sequenceFlow id="sequenceFlow6" sourceRef="exclusiveGateway2" targetRef="taskManualCheck1"/>

    <bpmn:userTask id="taskCreateLetter1" name="Erstellung Schreiben">
      <bpmn:incoming>sequenceFlow7</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow9</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:sequenceFlow id="sequenceFlow7" sourceRef="exclusiveGateway2" targetRef="taskCreateLetter1"/>

    <bpmn:intermediateEvent id="intermediateEvent1">
      <bpmn:incoming>sequenceFlow9</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow10</bpmn:outgoing>
    </bpmn:intermediateEvent>

    <bpmn:sequenceFlow id="sequenceFlow9" sourceRef="taskCreateLetter1" targetRef="intermediateEvent1"/>

    <bpmn:exclusiveGateway id="exclusiveGateway3">
      <bpmn:incoming>sequenceFlow10</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow11</bpmn:outgoing>
      <bpmn:outgoing>sequenceFlow12</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="sequenceFlow10" sourceRef="intermediateEvent1" targetRef="exclusiveGateway3"/>

    <bpmn:userTask id="taskCheckMandat1" name="Prüfung Mandat">
      <bpmn:incoming>sequenceFlow11</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow13</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:sequenceFlow id="sequenceFlow11" sourceRef="exclusiveGateway3" targetRef="taskCheckMandat1"/>

    <bpmn:serviceTask id="taskCreateBankConnection1" name="Anlage Bankverbindung">
      <bpmn:incoming>sequenceFlow13</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow14</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="sequenceFlow13" sourceRef="taskCheckMandat1" targetRef="taskCreateBankConnection1"/>

    <bpmn:exclusiveGateway id="exclusiveGateway4">
      <bpmn:incoming>sequenceFlow14</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow15</bpmn:outgoing>
      <bpmn:outgoing>sequenceFlow16</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="sequenceFlow14" sourceRef="taskCreateBankConnection1" targetRef="exclusiveGateway4"/>

    <bpmn:userTask id="taskCheckOpenInvoices1" name="Prüfung offene Forderungen">
      <bpmn:incoming>sequenceFlow15</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow17</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:sequenceFlow id="sequenceFlow15" sourceRef="exclusiveGateway4" targetRef="taskCheckOpenInvoices1"/>

    <bpmn:endEvent id="endEvent1">
      <bpmn:incoming>sequenceFlow17</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="sequenceFlow17" sourceRef="taskCheckOpenInvoices1" targetRef="endEvent1"/>
  </bpmn:process>
</bpmn:definitions>