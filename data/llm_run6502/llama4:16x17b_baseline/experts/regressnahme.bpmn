<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" 
             targetNamespace="http://example.com/bpmn">

   <process id="regressforderung" isExecutable="true">
     <startEvent id="startEvent1">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="task1"/>

     <userTask id="task1" name="Prüfung ob Regressforderung möglich">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
       <outgoing>sequenceFlow3</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow2" sourceRef="task1" targetRef="exclusiveGateway1"/>

     <sequenceFlow id="sequenceFlow3" sourceRef="task1" targetRef="endEvent1">
       <conditionExpression xsi:type="tFormalExpression">${possibility == false}</conditionExpression>
     </sequenceFlow>

     <exclusiveGateway id="exclusiveGateway1">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow4</outgoing>
       <outgoing>sequenceFlow5</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow4" sourceRef="exclusiveGateway1" targetRef="task2"/>

     <sequenceFlow id="sequenceFlow5" sourceRef="exclusiveGateway1" targetRef="task3">
       <conditionExpression xsi:type="tFormalExpression">${paymentReceived == false}</conditionExpression>
     </sequenceFlow>

     <userTask id="task2" name="Verbuchung des Eingangs und Abschluss des Vorgangs">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow6</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow6" sourceRef="task2" targetRef="endEvent1"/>

     <userTask id="task3" name="Widerspruch des Versicherungsnehmers prüfen">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow7</outgoing>
       <outgoing>sequenceFlow8</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow7" sourceRef="task3" targetRef="exclusiveGateway2"/>

     <sequenceFlow id="sequenceFlow8" sourceRef="task3" targetRef="serviceTask1">
       <conditionExpression xsi:type="tFormalExpression">${objectionJustified == false}</conditionExpression>
     </sequenceFlow>

     <exclusiveGateway id="exclusiveGateway2">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow9</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow9" sourceRef="exclusiveGateway2" targetRef="endEvent1"/>

     <serviceTask id="serviceTask1" name="Übergabe an Inkasso-Dienstleister">
       <incoming>sequenceFlow8</incoming>
       <outgoing>sequenceFlow10</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlow10" sourceRef="serviceTask1" targetRef="endEvent1"/>

     <endEvent id="endEvent1" name="Abschluss des Vorgangs">
     </endEvent>

   </process>

</definitions>