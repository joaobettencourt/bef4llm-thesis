<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
                 id="Definitions" targetNamespace="http://example.com/schufascoring">

   <bpmn:collaboration id="Collaboration_1">
     <bpmn:participant id="Participant_1" name="Kreditvergabe Frontend  (Bank)" processRef="Process_Frontend"/>
     <bpmn:participant id="Participant_2" name="Schufascoring  (Bank)" processRef="Process_Scoring"/>
     <bpmn:participant id="Participant_3" name="Scoringservice  (Schufa)" processRef="Process_Schufa"/>

     <bpmn:messageFlow id="MessageFlow_1" sourceRef="Participant_1" targetRef="StartEvent_Scoring"/>
     <bpmn:messageFlow id="MessageFlow_2" sourceRef="Task_ScoreSend" targetRef="Participant_1"/>
     <bpmn:messageFlow id="MessageFlow_3" sourceRef="IntermediateCatchEvent_DelayedScore" targetRef="Task_NotifyDelay"/>

   </bpmn:collaboration>

   <bpmn:process id="Process_Frontend" isExecutable="true">
     <!-- Start Event  -->
     <bpmn:startEvent id="StartEvent_Frontend" name="Schufascoring angefragt">
       <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
       <bpmn:messageEventDefinition/>
     </bpmn:startEvent>

     <!-- Task: Notify user of delayed score  -->
     <bpmn:task id="Task_NotifyDelay" name="Verzögerung melden">
       <bpmn:incoming>MessageFlow_3</bpmn:incoming>
     </bpmn:task>

     <!-- End Event  -->
     <bpmn:endEvent id="EndEvent_Frontend" name="Schufascoring abgeschlossen">
      <bpmn:incoming>SequenceFlow_Finalize</bpmn:incoming>
    </bpmn:endEvent>
   </bpmn:process>

   <bpmn:process id="Process_Scoring" isExecutable="true">
     <!-- Start Event  -->
     <bpmn:startEvent id="StartEvent_Scoring" name="Schufascoring gestartet">
       <bpmn:incoming>MessageFlow_1</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
       <bpmn:messageEventDefinition/>
     </bpmn:startEvent>

     <!-- Task: Send scoring request to Schufa  -->
     <bpmn:task id="Task_RequestScore" name="Scoringanfrage senden">
       <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
     </bpmn:task>

     <!-- Event-Based Gateway  -->
     <bpmn:eventBasedGateway id="EventBasedGateway_1" name="Schufascore verfügbar?">
       <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
       <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
     </bpmn:eventBasedGateway>

     <!-- Intermediate Catch Event: Immediate score result  -->
     <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_ImmediateScore" name="Schufascore sofort ermittelt">
       <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
       <bpmn:messageEventDefinition/>
     </bpmn:intermediateCatchEvent>

     <!-- Intermediate Catch Event: Delayed score result  -->
     <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_DelayedScore" name="Schufascore verzögert">
       <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
       <bpmn:outgoing>MessageFlow_3</bpmn:outgoing>
       <bpmn:messageEventDefinition/>
     </bpmn:intermediateCatchEvent>

     <!-- Task: Send score result  -->
     <bpmn:task id="Task_ScoreSend" name="Schufascore senden">
       <bpmn:incoming>SequenceFlow_7</bpmn:incoming>
       <bpmn:outgoing>MessageFlow_2</bpmn:outgoing>
     </bpmn:task>

    <!-- Sequence Flows  -->
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_Frontend" targetRef="Participant_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="StartEvent_Scoring" targetRef="Task_RequestScore"/>
    <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="Task_RequestScore" targetRef="EventBasedGateway_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="EventBasedGateway_1" targetRef="IntermediateCatchEvent_ImmediateScore"/>
    <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="EventBasedGateway_1" targetRef="IntermediateCatchEvent_DelayedScore"/>
    <bpmn:sequenceFlow id="SequenceFlow_7" sourceRef="IntermediateCatchEvent_ImmediateScore" targetRef="Task_ScoreSend"/>
     <bpmn:sequenceFlow id="SequenceFlow_Finalize" sourceRef="Task_ScoreSend" targetRef="EndEvent_Frontend"/> 
   </bpmn:process>

</bpmn:definitions>