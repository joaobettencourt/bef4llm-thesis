<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
                 id="definitions" targetNamespace="http://example.com/process">

  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="participant" name="Schadensprozess" processRef="process"/>
  </bpmn:collaboration>

  <bpmn:process id="process" isExecutable="true">

    <!-- Start Event -->
    <bpmn:startEvent id="start-event" name="Schadensmeldung durch Kunden">
      <bpmn:outgoing>sequence-flow-1</bpmn:outgoing>
      <bpmn:messageEventDefinition/>
    </bpmn:startEvent>

    <!-- Task: Aufnahme des Anliegens -->
    <bpmn:manualTask id="aufnahme-anliegens" name="Aufnahme des Anliegens">
      <bpmn:incoming>sequence-flow-1</bpmn:incoming>
      <bpmn:outgoing>sequence-flow-2</bpmn:outgoing>
    </bpmn:manualTask>

    <!-- Exclusive Gateway: Wird das Anliegen zurückgewiesen? -->
    <bpmn:exclusiveGateway id="gateway-1" name="Wird das Anliegen zurückgewiesen?">
      <bpmn:incoming>sequence-flow-2</bpmn:incoming>
      <bpmn:outgoing>sequence-flow-3</bpmn:outgoing>
      <bpmn:outgoing>sequence-flow-4</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event: Fallabschluss -->
    <bpmn:endEvent id="end-event-1" name="Fallabschluss">
      <bpmn:incoming>sequence-flow-3</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Intermediate Throw Event: Übergabe des Falls an das Versicherungsmanagement -->
    <bpmn:intermediateThrowEvent id="intermediate-throw-event-1" name="Übergabe des Falls an das Versicherungsmanagement">
      <bpmn:incoming>sequence-flow-4</bpmn:incoming>
      <bpmn:outgoing>sequence-flow-5</bpmn:outgoing>
      <bpmn:messageEventDefinition/>
    </bpmn:intermediateThrowEvent>

    <!-- Task: Kontrolle der Unterlagen auf Vollständigkeit -->
    <bpmn:manualTask id="kontrolle-unterlagen" name="Kontrolle der eingereichten Unterlagen auf Vollständigkeit">
      <bpmn:incoming>sequence-flow-5</bpmn:incoming>
      <bpmn:outgoing>sequence-flow-6</bpmn:outgoing>
    </bpmn:manualTask>

    <!-- Exclusive Gateway: Müssen Rückfragen an den Einreicher gestellt werden? -->
    <bpmn:exclusiveGateway id="gateway-2" name="Müssen Rückfragen an den Einreicher gestellt werden?">
      <bpmn:incoming>sequence-flow-6</bpmn:incoming>
      <bpmn:outgoing>sequence-flow-7</bpmn:outgoing>
      <bpmn:outgoing>sequence-flow-8</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="sequence-flow-1" sourceRef="start-event" targetRef="aufnahme-anliegens"/>
    <bpmn:sequenceFlow id="sequence-flow-2" sourceRef="aufnahme-anliegens" targetRef="gateway-1"/>
    <bpmn:sequenceFlow id="sequence-flow-3" name="Ja" sourceRef="gateway-1" targetRef="end-event-1"/>
    <bpmn:sequenceFlow id="sequence-flow-4" name="Nein" sourceRef="gateway-1" targetRef="intermediate-throw-event-1"/>

    <bpmn:sequenceFlow id="sequence-flow-5" sourceRef="intermediate-throw-event-1" targetRef="kontrolle-unterlagen"/>
    <bpmn:sequenceFlow id="sequence-flow-6" sourceRef="kontrolle-unterlagen" targetRef="gateway-2"/>
    <bpmn:sequenceFlow id="sequence-flow-7" name="Nein" sourceRef="gateway-2" targetRef="manual-task-1"/>
    <bpmn:sequenceFlow id="sequence-flow-8" name="Ja" sourceRef="gateway-2" targetRef="send-task-1"/>

    <!-- Send Task -->
    <bpmn:sendTask id="send-task-1" name="Klärung der Rückfragen mit Einreicher">
      <bpmn:incoming>sequence-flow-8</bpmn:incoming>
      <bpmn:outgoing>sequence-flow-9</bpmn:outgoing>
    </bpmn:sendTask>

    <!-- Receive Task -->
    <bpmn:receiveTask id="receive-task-1" name="Erhalten der Rückantwort">
      <bpmn:incoming>sequence-flow-9</bpmn:incoming>
      <bpmn:outgoing>sequence-flow-10</bpmn:outgoing>
    </bpmn:receiveTask>

    <!-- Sequence Flow -->
    <bpmn:sequenceFlow id="sequence-flow-9" sourceRef="send-task-1" targetRef="receive-task-1"/>
    <bpmn:sequenceFlow id="sequence-flow-10" sourceRef="receive-task-1" targetRef="gateway-3"/>

    <!-- Exclusive Gateway -->
    <bpmn:exclusiveGateway id="gateway-3">
      <bpmn:incoming>sequence-flow-10</bpmn:incoming>
      <bpmn:outgoing>sequence-flow-11</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Manual Task -->
    <bpmn:manualTask id="manual-task-1" name="Ursachenermittlung und rechtliche Beurteilung">
      <bpmn:incoming>sequence-flow-7</bpmn:incoming>
      <bpmn:outgoing>sequence-flow-11</bpmn:outgoing>
    </bpmn:manualTask>

    <!-- Sequence Flow -->
    <bpmn:sequenceFlow id="sequence-flow-11" sourceRef="manual-task-1" targetRef="end-event-2"/>

    <!-- End Event -->
    <bpmn:endEvent id="end-event-2" name="Abschluss der Bearbeitung">
      <bpmn:incoming>sequence-flow-11</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>

</bpmn:definitions>