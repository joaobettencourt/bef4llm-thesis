<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
                 id="Definitions_1" targetNamespace="http://example.com/Unbedenklichkeitsbescheinigung">

  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="true">

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Ensure process traceability and set certificate count to zero -->
    <bpmn:serviceTask id="Task_1" name="Ensure Process Traceability and Initialize Certificate Count">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Sequence Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="ExclusiveGateway_1"/>

    <!-- Exclusive Gateway: Check if requester is already in the system -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_1">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_3" name="Yes" sourceRef="ExclusiveGateway_1" targetRef="Task_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_4" name="No" sourceRef="ExclusiveGateway_1" targetRef="Task_3"/>

    <!-- Task: Verify requester information -->
    <bpmn:userTask id="Task_2" name="Verify Requester Information">
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Create a new request for more information -->
    <bpmn:userTask id="Task_3" name="Request More Information from Customer">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Sequence Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="Task_2" targetRef="ExclusiveGateway_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="Task_3" targetRef="StartEvent_1"/>

    <!-- Exclusive Gateway: Check if requester has employer role -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_2">
      <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_7" name="Yes" sourceRef="ExclusiveGateway_2" targetRef="Task_4"/>
    <bpmn:sequenceFlow id="SequenceFlow_8" name="No" sourceRef="ExclusiveGateway_2" targetRef="Task_5"/>

    <!-- Task: Verify insurance periods and contribution notifications -->
    <bpmn:serviceTask id="Task_4" name="Verify Insurance Periods and Contribution Notifications">
      <bpmn:incoming>SequenceFlow_7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_9</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Task: Create notification for missing information -->
    <bpmn:userTask id="Task_5" name="Create Notification for Missing Information">
      <bpmn:incoming>SequenceFlow_8</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Sequence Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_9" sourceRef="Task_4" targetRef="ExclusiveGateway_3"/>
    <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="Task_5" targetRef="EndEvent_1"/>

    <!-- Exclusive Gateway: Evaluate unbedenklichkeit -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_3">
      <bpmn:incoming>SequenceFlow_9</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_11</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_11" name="Fulfilled" sourceRef="ExclusiveGateway_3" targetRef="Task_6"/>
    <bpmn:sequenceFlow id="SequenceFlow_12" name="Not Fulfilled" sourceRef="ExclusiveGateway_3" targetRef="Task_7"/>

    <!-- Task: Issue certificate -->
    <bpmn:serviceTask id="Task_6" name="Issue Certificate">
      <bpmn:incoming>SequenceFlow_11</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_13</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Task: Issue notification with note -->
    <bpmn:serviceTask id="Task_7" name="Issue Notification with Note">
      <bpmn:incoming>SequenceFlow_12</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_14</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Sequence Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_13" sourceRef="Task_6" targetRef="EndEvent_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_14" sourceRef="Task_7" targetRef="EndEvent_2"/>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_1">
      <bpmn:incoming>SequenceFlow_10</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_2">
      <bpmn:incoming>SequenceFlow_13</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_14</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>