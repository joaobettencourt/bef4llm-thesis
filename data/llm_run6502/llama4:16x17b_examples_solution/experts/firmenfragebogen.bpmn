<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
                 id="definitions" targetNamespace="http://example.com/process">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Firmenfragebogen Prozess" processRef="Process_1"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="true">

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Erfasse und verarbeite Fragebogen -->
    <bpmn:serviceTask id="Task_1" name="Erfasse und verarbeite Fragebogen">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Exclusive Gateway: Automatische Suche nach Partnerunternehmen -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_1">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="ExclusiveGateway_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_3" name="Ja" sourceRef="ExclusiveGateway_1" targetRef="Task_3"/>
    <bpmn:sequenceFlow id="SequenceFlow_4" name="Nein" sourceRef="ExclusiveGateway_1" targetRef="Task_2"/>

    <!-- Task: Manuelle Prüfung durch Sachbearbeiter -->
    <bpmn:userTask id="Task_2" name="Manuelle Prüfung durch Sachbearbeiter">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Sequence Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="Task_2" targetRef="ExclusiveGateway_2"/>

    <!-- Exclusive Gateway: Überprüfung relevanter Unternehmensdaten -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_2">
      <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_6" name="Ja" sourceRef="ExclusiveGateway_2" targetRef="Task_3"/>
    <bpmn:sequenceFlow id="SequenceFlow_7" name="Nein" sourceRef="ExclusiveGateway_2" targetRef="Task_4"/>

    <!-- Task: Überprüfung relevanter Unternehmensdaten -->
    <bpmn:serviceTask id="Task_3" name="Überprüfung relevanter Unternehmensdaten">
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_8</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Task: Umlageversicherungszeiten prüfen -->
    <bpmn:serviceTask id="Task_4" name="Umlageversicherungszeiten prüfen">
      <bpmn:incoming>SequenceFlow_7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_9</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Sequence Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_8" sourceRef="Task_3" targetRef="ExclusiveGateway_3"/>

    <!-- Exclusive Gateway: Kontaktdaten überprüfen -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_3">
      <bpmn:incoming>SequenceFlow_8</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_10" name="Ja" sourceRef="ExclusiveGateway_3" targetRef="EndEvent_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_11" name="Nein" sourceRef="ExclusiveGateway_3" targetRef="Task_5"/>

    <!-- Task: Nachbearbeitung -->
    <bpmn:userTask id="Task_5" name="Nachbearbeitung">
      <bpmn:incoming>SequenceFlow_11</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_12</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Sequence Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_12" sourceRef="Task_5" targetRef="EndEvent_1"/>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_1">
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_10</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_12</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>