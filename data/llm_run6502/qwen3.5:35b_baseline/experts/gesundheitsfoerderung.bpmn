<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_HealthPromo" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_GesundheitsForderung">
    <bpmn:participant id="Participant_Programm" name="Betriebliche Gesundheitsförderung" processRef="Process_HealthPromo" />
  </bpmn:collaboration>

  <bpmn:process id="Process_HealthPromo" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Coaches" name="Coaches &amp; Administration">
        <bpmn:flowNodeRef>StartEvent_Programm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_StartParallel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GesundheitsCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_JoinPlanning</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PlanErstellen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CounselingOption</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_JoinPhase1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ZwischenCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_GroupSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_JoinPhase2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AbschlussCheck</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Participants" name="Teilnehmer">
        <bpmn:flowNodeRef>InclusiveGateway_JoinPlanning</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EinweisungApp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CounselingOption</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_JoinPhase1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TrainingPhase2A</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TrainingPhase2B</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Programm" name="Programmstart">
      <bpmn:outgoing>SequenceFlow_StartParallel</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Parallel Split for Check & Instruction -->
    <bpmn:parallelGateway id="Gateway_StartParallel">
      <bpmn:incoming>SequenceFlow_StartParallel</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_InstructionPath</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Lane Coaches Task -->
    <bpmn:task id="Task_GesundheitsCheck" name="Gesundheits-Check durchführen">
      <bpmn:incoming>SequenceFlow_CheckPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_JoinPlanning</bpmn:outgoing>
    </bpmn:task>

    <!-- Lane Participants Task -->
    <bpmn:task id="Task_EinweisungApp" name="Einweisung in App &amp; Wearables">
      <bpmn:incoming>SequenceFlow_InstructionPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_JoinPlanning2</bpmn:outgoing>
    </bpmn:task>

    <!-- Join Planning Phase (After Check and Instruction) -->
    <bpmn:inclusiveGateway id="InclusiveGateway_JoinPlanning">
      <bpmn:incoming>SequenceFlow_JoinPlanning</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_JoinPlanning2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PlanStart</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Lane Coaches Task -->
    <bpmn:task id="Task_PlanErstellen" name="Trainings- &amp; Ernährungspläne erstellen">
      <bpmn:incoming>SequenceFlow_PlanStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TrainingPhase1</bpmn:outgoing>
    </bpmn:task>

    <!-- Training Phase 1 with Optional Counseling -->
    <bpmn:exclusiveGateway id="Gateway_CounselingOption" name="Ernährungsberatung?">
      <bpmn:incoming>SequenceFlow_TrainingPhase1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NoCounseling</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_YesCounseling</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Lane Participants Task -->
    <bpmn:task id="Task_TrainingPhase1" name="Trainingsphase I (6 Monate)">
      <bpmn:incoming>SequenceFlow_PlanStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CounselingDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Counseling Task -->
    <bpmn:task id="Task_Ernaehrungsberatung" name="Ernährungsberatung anbieten">
      <bpmn:incoming>SequenceFlow_YesCounseling</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_JoinPhase1</bpmn:outgoing>
    </bpmn:task>

    <!-- Join Phase 1 -->
    <bpmn:inclusiveGateway id="InclusiveGateway_JoinPhase1">
      <bpmn:incoming>SequenceFlow_NoCounseling</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_YesCounseling2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MidCheckStart</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Lane Coaches Task -->
    <bpmn:task id="Task_ZwischenCheck" name="Zwischen-Check durchführen">
      <bpmn:incoming>SequenceFlow_MidCheckStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GroupSplit</bpmn:outgoing>
    </bpmn:task>

    <!-- Group Split Decision -->
    <bpmn:exclusiveGateway id="Gateway_GroupSplit" name="Gruppeneinteilung">
      <bpmn:incoming>SequenceFlow_GroupSplitIn</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PathA_NoWearables</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PathB_WithApp</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Lane Participants Tasks -->
    <bpmn:task id="Task_TrainingPhase2A" name="Training ohne Wearables">
      <bpmn:incoming>SequenceFlow_PathA_NoWearables</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_JoinPhase2Start</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_TrainingPhase2B" name="Training mit App &amp; Wearables">
      <bpmn:incoming>SequenceFlow_PathB_WithApp</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_JoinPhase2Start2</bpmn:outgoing>
    </bpmn:task>

    <!-- Join Phase 2 -->
    <bpmn:inclusiveGateway id="InclusiveGateway_JoinPhase2">
      <bpmn:incoming>SequenceFlow_PathA_NoWearables2</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_PathB_WithApp2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FinalCheckStart</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Lane Coaches Task -->
    <bpmn:task id="Task_AbschlussCheck" name="Abschluss-Check durchführen">
      <bpmn:incoming>SequenceFlow_FinalCheckStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndProgramm</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Programm" name="Programmende">
      <bpmn:incoming>SequenceFlow_EndProgramm</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows (Corrected for Logic) -->
    <bpmn:sequenceFlow id="SequenceFlow_StartParallel" sourceRef="StartEvent_Programm" targetRef="Gateway_StartParallel">
      <bpmn:name>Programmstart</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_CheckPath" name="Gesundheits-Check" sourceRef="Gateway_StartParallel" targetRef="Task_GesundheitsCheck">
      <bpmn:name>Gesundheits-Check</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_InstructionPath" name="Einweisung" sourceRef="Gateway_StartParallel" targetRef="Task_EinweisungApp">
      <bpmn:name>Einführung App &amp; Wearables</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_JoinPlanning" sourceRef="Task_GesundheitsCheck" targetRef="InclusiveGateway_JoinPlanning">
      <bpmn:name>Gesundheitsdaten bereit</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_JoinPlanning2" sourceRef="Task_EinweisungApp" targetRef="InclusiveGateway_JoinPlanning">
      <bpmn:name>Einführung abgeschlossen</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_PlanStart" sourceRef="InclusiveGateway_JoinPlanning" targetRef="Task_PlanErstellen">
      <bpmn:name>Planung starten</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_TrainingPhase1" sourceRef="Task_PlanErstellen" targetRef="Gateway_CounselingOption">
      <bpmn:name>Training Phase 1 starten</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_NoCounseling" sourceRef="Gateway_CounselingOption" targetRef="InclusiveGateway_JoinPhase1">
      <bpmn:name>Keine Beratung</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_YesCounseling" sourceRef="Gateway_CounselingOption" targetRef="Task_Ernaehrungsberatung">
      <bpmn:name>Beratung ja</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_YesCounseling2" sourceRef="Task_Ernaehrungsberatung" targetRef="InclusiveGateway_JoinPhase1">
      <bpmn:name>Beratung abgeschlossen</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_MidCheckStart" sourceRef="InclusiveGateway_JoinPhase1" targetRef="Task_ZwischenCheck">
      <bpmn:name>Zwischen-Check starten</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_GroupSplit" sourceRef="Task_ZwischenCheck" targetRef="Gateway_GroupSplit">
      <bpmn:name>Fortschritt dokumentiert</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_GroupSplitIn" name="" sourceRef="Gateway_GroupSplit" targetRef="Task_TrainingPhase2A">
      <bpmn:name>Ohne Wearables</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_PathB_WithApp" name="" sourceRef="Gateway_GroupSplit" targetRef="Task_TrainingPhase2B">
      <bpmn:name>Mit App &amp; Wearables</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_PathA_NoWearables" sourceRef="Gateway_GroupSplit" targetRef="Task_TrainingPhase2A">
      <bpmn:name>Ohne Wearables</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_PathB_WithApp2" sourceRef="Task_TrainingPhase2B" targetRef="InclusiveGateway_JoinPhase2">
      <bpmn:name>Mit App &amp; Wearables</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_PathA_NoWearables2" sourceRef="Task_TrainingPhase2A" targetRef="InclusiveGateway_JoinPhase2">
      <bpmn:name>Ohne Wearables</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_FinalCheckStart" sourceRef="InclusiveGateway_JoinPhase2" targetRef="Task_AbschlussCheck">
      <bpmn:name>Abschluss-Check starten</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_EndProgramm" sourceRef="Task_AbschlussCheck" targetRef="EndEvent_Programm">
      <bpmn:name>Programm beenden</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>

  <!-- Data Objects (Added as missing information) -->
  <bpmn:dataObject id="Data_HealthParams" name="Gesundheitsparameter">
    <bpmn:name>Gesundheitsparameter</bpmn:name>
  </bpmn:dataObject>

  <bpmn:association id="Assoc_Check_Data" sourceRef="Task_GesundheitsCheck" targetRef="Data_HealthParams" />

</bpmn:definitions>