<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions id="Definitions_1" targetNamespace="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Firmenfragebogen-Verarbeitung" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_System" name="System/Automatisierung">
        <bpmn:flowNodeRef>StartEvent_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Erfassen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_SuchePartner</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PartnerFound</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_Gateway_DataChecks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PruefungBetriebsnummer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PruefungU1Insolvenz</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IdentifikationAG</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_UmlageZeitenVorhanden</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_ÜberprüfungBestehenderZeiten</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_AnlageNeuerUmlagezeiten</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_Gateway_Kontaktdaten</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PruefungKontaktdaten</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Manual" name="Manuelle Bearbeitung">
        <bpmn:flowNodeRef>UserTask_ManuellePartnerPrüfung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_BearbeitungMitarbeiter</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_001" name="Firmenfragebogen eingegangen">
      <bpmn:messageEventDefinition id="MessageDef_001"/>
      <bpmn:outgoing>SequenceFlow_Erfassen</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Erfassung -->
    <bpmn:userTask id="Task_Erfassen" name="Erfassen &amp; im System verarbeiten">
      <bpmn:incoming>SequenceFlow_Erfassen</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SuchePartner</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task 2: Automatisierte Partnersuche -->
    <bpmn:serviceTask id="ServiceTask_SuchePartner" name="Automatische Suche nach Partnerunternehmen">
      <bpmn:incoming>SequenceFlow_SuchePartner</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PartnerFoundCheck</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Gateway 1: Partner gefunden? -->
    <bpmn:exclusiveGateway id="Gateway_PartnerFound" name="Partner eindeutig gefunden?">
      <bpmn:incoming>SequenceFlow_PartnerFoundCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ManuellePruefung</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_DatenChecksStart</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Path A: Manual Partner Check -->
    <bpmn:userTask id="UserTask_ManuellePartnerPrüfung" name="Manuelle Prüfung des Partners">
      <bpmn:incoming>SequenceFlow_ManuellePruefung</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeToDataChecks</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Path B: Direct to Data Checks -->
    <bpmn:sequenceFlow id="SequenceFlow_DatenChecksStart" sourceRef="Gateway_PartnerFound" targetRef="Join_Gateway_DataChecks"/>

    <!-- Join Point for Partner Check Paths -->
    <bpmn:exclusiveGateway id="Join_Gateway_DataChecks">
      <bpmn:incoming>SequenceFlow_MergeToDataChecks</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_DatenChecksStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PruefungBetriebsnummer</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 3a: Check Betriebs-/Betriebsstättennummer -->
    <bpmn:userTask id="Task_PruefungBetriebsnummer" name="Prüfung der Betriebs- und Betriebsstättennummer">
      <bpmn:incoming>SequenceFlow_PruefungBetriebsnummer</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PruefungU1Insolvenz</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task 3b: Check U1 &amp; Insolvenzrücklage -->
    <bpmn:userTask id="Task_PruefungU1Insolvenz" name="Prüfung U1-Verfahren und Insolvenzrücklage">
      <bpmn:incoming>SequenceFlow_PruefungU1Insolvenz</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_IdentifikationAG</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task 3c: Identify Employer -->
    <bpmn:userTask id="Task_IdentifikationAG" name="Eindeutige Identifizierung des Arbeitgebers">
      <bpmn:incoming>SequenceFlow_IdentifikationAG</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MeldezeitraumCheck</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task 4: Check Reporting Period -->
    <bpmn:userTask id="Task_PruefungMeldezeitraum" name="Kontrolle des Meldezeitraums">
      <bpmn:incoming>SequenceFlow_MeldezeitraumCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_UmlageZeitenVorhandenCheck</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway 2: Umlageversicherungszeiten vorhanden? -->
    <bpmn:exclusiveGateway id="Gateway_UmlageZeitenVorhanden" name="Umlageversicherungszeiten im System hinterlegt?">
      <bpmn:incoming>SequenceFlow_UmlageZeitenVorhandenCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ÜberprüfungBestehenderZeiten</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_AnlageNeuerUmlagezeiten</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Path Yes -->
    <bpmn:userTask id="ServiceTask_ÜberprüfungBestehenderZeiten" name="Überprüfen bestehender Umlageversicherungszeiten">
      <bpmn:incoming>SequenceFlow_ÜberprüfungBestehenderZeiten</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeToContactData</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Path No -->
    <bpmn:userTask id="ServiceTask_AnlageNeuerUmlagezeiten" name="Anlegen neuer Umlageversicherungszeiten">
      <bpmn:incoming>SequenceFlow_AnlageNeuerUmlagezeiten</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeToContactData</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Join Point for Contribution Times -->
    <bpmn:exclusiveGateway id="Join_Gateway_Kontaktdaten">
      <bpmn:incoming>SequenceFlow_ÜberprüfungBestehenderZeiten</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_AnlageNeuerUmlagezeiten</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PruefungKontaktdatenStart</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 5: Check Contact Data -->
    <bpmn:userTask id="Task_PruefungKontaktdaten" name="Prüfung der Kontaktdaten (Telefon, Fax, Adresse)">
      <bpmn:incoming>SequenceFlow_PruefungKontaktdatenStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProcessEnd</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_Erfassen" sourceRef="StartEvent_001" targetRef="Task_Erfassen"/>
    <bpmn:sequenceFlow id="SequenceFlow_SuchePartner" sourceRef="Task_Erfassen" targetRef="ServiceTask_SuchePartner"/>
    <bpmn:sequenceFlow id="SequenceFlow_PartnerFoundCheck" sourceRef="ServiceTask_SuchePartner" targetRef="Gateway_PartnerFound"/>

    <!-- Partner Search Branches -->
    <bpmn:sequenceFlow id="SequenceFlow_ManuellePruefung" name="Nein/Unklar" sourceRef="Gateway_PartnerFound" targetRef="UserTask_ManuellePartnerPrüfung">
      <bpmn:conditionExpression>${!partnerFound || !uniqueMatch}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Merge to Data Checks -->
    <bpmn:sequenceFlow id="SequenceFlow_MergeToDataChecks" sourceRef="UserTask_ManuellePartnerPrüfung" targetRef="Join_Gateway_DataChecks"/>

    <!-- Data Check Sequence -->
    <bpmn:sequenceFlow id="SequenceFlow_PruefungBetriebsnummer" name="Check Betriebsnummern" sourceRef="Join_Gateway_DataChecks" targetRef="Task_PruefungBetriebsnummer"/>
    <bpmn:sequenceFlow id="SequenceFlow_PruefungU1Insolvenz" sourceRef="Task_PruefungBetriebsnummer" targetRef="Task_PruefungU1Insolvenz"/>
    <bpmn:sequenceFlow id="SequenceFlow_IdentifikationAG" sourceRef="Task_PruefungU1Insolvenz" targetRef="Task_IdentifikationAG"/>

    <!-- Reporting Period Sequence -->
    <bpmn:sequenceFlow id="SequenceFlow_MeldezeitraumCheck" name="Prüfung Meldezeitraum" sourceRef="Task_IdentifikationAG" targetRef="Task_PruefungMeldezeitraum"/>
    <bpmn:sequenceFlow id="SequenceFlow_UmlageZeitenVorhandenCheck" sourceRef="Task_PruefungMeldezeitraum" targetRef="Gateway_UmlageZeitenVorhanden"/>

    <!-- Contribution Times Branches -->
    <bpmn:sequenceFlow id="SequenceFlow_ÜberprüfungBestehenderZeiten" name="Ja, vorhanden" sourceRef="Gateway_UmlageZeitenVorhanden" targetRef="ServiceTask_ÜberprüfungBestehenderZeiten">
      <bpmn:conditionExpression>${existingTimesFound}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_AnlageNeuerUmlagezeiten" name="Nein, neu anlegen" sourceRef="Gateway_UmlageZeitenVorhanden" targetRef="ServiceTask_AnlageNeuerUmlagezeiten">
      <bpmn:conditionExpression>${!existingTimesFound}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Merge to Contact Data -->
    <bpmn:sequenceFlow id="SequenceFlow_MergeToContactData" sourceRef="Join_Gateway_Kontaktdaten" targetRef="Task_PruefungKontaktdaten"/>

    <!-- Contact Data Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_ProcessEnd" name="Prozess abgeschlossen" sourceRef="Task_PruefungKontaktdaten" targetRef="EndEvent_Successful"/>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_Successful" name="Firmendaten erfolgreich geprüft">
      <bpmn:incoming>SequenceFlow_ProcessEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Exception Handling (Boundary Event) -->
    <bpmn:boundaryEvent id="Error_Boundary_1" attachedToRef="Task_PruefungBetriebsnummer">
      <bpmn:errorEventDefinition/>
      <bpmn:outgoing>SequenceFlow_ErrorHandling</bpmn:outgoing>
    </bpmn:boundaryEvent>

    <bpmn:userTask id="UserTask_BearbeitungMitarbeiter" name="Bearbeitung durch zuständigen Mitarbeiter">
      <bpmn:incoming>SequenceFlow_ErrorHandling</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ManualEnd</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndEvent_Escalated" name="Manuelle Klärung erforderlich">
      <bpmn:incoming>SequenceFlow_ManualEnd</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow_ErrorHandling" sourceRef="Error_Boundary_1" targetRef="UserTask_BearbeitungMitarbeiter"/>
    <bpmn:sequenceFlow id="SequenceFlow_ManualEnd" sourceRef="UserTask_BearbeitungMitarbeiter" targetRef="EndEvent_Escalated"/>

  </bpmn:process>
</bpmn:definitions>