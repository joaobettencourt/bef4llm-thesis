<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Regressnahme Sachbearbeiter" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_001" name="Regressverdacht gemeldet">
      <bpmn:outgoing>SequenceFlow_001</bpmn:outgoing>
      <bpmn:messageEventDefinition/>
    </bpmn:startEvent>

    <!-- Task 1: Examine case -->
    <bpmn:task id="Task_002" name="Fall prüfen">
      <bpmn:incoming>SequenceFlow_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_002</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Is regression possible? -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_003" name="Regress möglich?">
      <bpmn:incoming>SequenceFlow_002</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_004</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_015</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flow 2 -->
    <bpmn:sequenceFlow id="SequenceFlow_002" sourceRef="Task_002" targetRef="ExclusiveGateway_003"/>

    <!-- Task 2: Send payment demand (if regression possible) -->
    <bpmn:task id="Task_005" name="Zahlungsaufforderung an VN schicken">
      <bpmn:incoming>SequenceFlow_004</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_006</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow 3 -->
    <bpmn:sequenceFlow id="SequenceFlow_004" name="Ja" sourceRef="ExclusiveGateway_003" targetRef="Task_005"/>

    <!-- Task 3: Set for follow-up review (Wiedervorlage) -->
    <bpmn:task id="Task_007" name="Vorgang auf Wiedervorlage setzen">
      <bpmn:incoming>SequenceFlow_006</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_018</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow 4 -->
    <bpmn:sequenceFlow id="SequenceFlow_006" sourceRef="Task_005" targetRef="Task_007"/>

    <!-- Event-Based Gateway for waiting on multiple events -->
    <bpmn:eventBasedGateway id="EventBasedGateway_019">
      <bpmn:incoming>SequenceFlow_018</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_026</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_035</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_017</bpmn:outgoing>
    </bpmn:eventBasedGateway>

    <!-- Sequence Flow 5 -->
    <bpmn:sequenceFlow id="SequenceFlow_018" sourceRef="Task_007" targetRef="EventBasedGateway_019"/>

    <!-- Path A: Payment received (message event) -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_020" name="Geld eingegangen">
      <bpmn:incoming>SequenceFlow_017</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_036</bpmn:outgoing>
      <bpmn:messageEventDefinition/>
    </bpmn:intermediateCatchEvent>

    <!-- Sequence Flow 6 -->
    <bpmn:sequenceFlow id="SequenceFlow_017" sourceRef="EventBasedGateway_019" targetRef="IntermediateCatchEvent_020"/>

    <!-- Task A-2: Book payment received -->
    <bpmn:task id="Task_021" name="Geldeingang verbuchen">
      <bpmn:incoming>SequenceFlow_036</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_041</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow 7 -->
    <bpmn:sequenceFlow id="SequenceFlow_036" sourceRef="IntermediateCatchEvent_020" targetRef="Task_021"/>

    <!-- Task A-3: Close process (payment path) -->
    <bpmn:task id="Task_022" name="Vorgang schließen">
      <bpmn:incoming>SequenceFlow_041</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_053</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow 8 -->
    <bpmn:sequenceFlow id="SequenceFlow_041" sourceRef="Task_021" targetRef="Task_022"/>

    <!-- Path B: Objection received (message event) -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_037" name="Widerspruch erhalten">
      <bpmn:incoming>SequenceFlow_026</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_048</bpmn:outgoing>
      <bpmn:messageEventDefinition/>
    </bpmn:intermediateCatchEvent>

    <!-- Sequence Flow 9 -->
    <bpmn:sequenceFlow id="SequenceFlow_026" sourceRef="EventBasedGateway_019" targetRef="IntermediateCatchEvent_037"/>

    <!-- Task B-2: Check objection justification -->
    <bpmn:task id="Task_045" name="Widerspruch prüfen">
      <bpmn:incoming>SequenceFlow_048</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_062</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow 10 -->
    <bpmn:sequenceFlow id="SequenceFlow_048" sourceRef="IntermediateCatchEvent_037" targetRef="Task_045"/>

    <!-- Gateway B-3: Is objection justified? -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_061" name="Gerechtfertigt?">
      <bpmn:incoming>SequenceFlow_062</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_054</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_019</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flow 11 -->
    <bpmn:sequenceFlow id="SequenceFlow_062" sourceRef="Task_045" targetRef="ExclusiveGateway_061"/>

    <!-- Task B-4a: Close process (objection justified) -->
    <bpmn:task id="Task_073" name="Vorgang schließen">
      <bpmn:incoming>SequenceFlow_054</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_068</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow 12 -->
    <bpmn:sequenceFlow id="SequenceFlow_054" name="Ja" sourceRef="ExclusiveGateway_061" targetRef="Task_073"/>

    <!-- Task B-4b: Send to collection agency (objection not justified) -->
    <bpmn:task id="Task_082" name="Vorgang an Inkasso-Dienstleister geben">
      <bpmn:incoming>SequenceFlow_019</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_074</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow 13 -->
    <bpmn:sequenceFlow id="SequenceFlow_019" name="Nein" sourceRef="ExclusiveGateway_061" targetRef="Task_082"/>

    <!-- Path C: Follow-up deadline passed (timer event) -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_075" name="Wiedervorlage fällig">
      <bpmn:incoming>SequenceFlow_035</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_081</bpmn:outgoing>
      <bpmn:timerEventDefinition/>
    </bpmn:intermediateCatchEvent>

    <!-- Sequence Flow 14 -->
    <bpmn:sequenceFlow id="SequenceFlow_035" sourceRef="EventBasedGateway_019" targetRef="IntermediateCatchEvent_075"/>

    <!-- Task C-2: Send to collection agency (deadline passed) -->
    <bpmn:task id="Task_086" name="Vorgang an Inkasso-Dienstleister geben">
      <bpmn:incoming>SequenceFlow_081</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_079</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow 15 -->
    <bpmn:sequenceFlow id="SequenceFlow_081" sourceRef="IntermediateCatchEvent_075" targetRef="Task_086"/>

    <!-- End Events -->
    
    <!-- End Event A-4: Process closed (payment received) -->
    <bpmn:endEvent id="EndEvent_092" name="Vorgang geschlossen">
      <bpmn:incoming>SequenceFlow_053</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flow 16 -->
    <bpmn:sequenceFlow id="SequenceFlow_053" sourceRef="Task_022" targetRef="EndEvent_092"/>

    <!-- End Event B-5a: Process closed (objection justified) -->
    <bpmn:endEvent id="EndEvent_104" name="Vorgang geschlossen">
      <bpmn:incoming>SequenceFlow_068</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flow 17 -->
    <bpmn:sequenceFlow id="SequenceFlow_068" sourceRef="Task_073" targetRef="EndEvent_104"/>

    <!-- End Event B-5b/C-3: Process open (sent to collection) -->
    <bpmn:endEvent id="EndEvent_129" name="Vorgang offen">
      <bpmn:incoming>SequenceFlow_074</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_079</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flow 18 -->
    <bpmn:sequenceFlow id="SequenceFlow_074" sourceRef="Task_082" targetRef="EndEvent_129"/>

    <!-- End Event C-3a: Process open (deadline passed) -->
    <bpmn:endEvent id="EndEvent_156" name="Vorgang offen">
      <bpmn:incoming>SequenceFlow_079</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flow 19 -->
    <bpmn:sequenceFlow id="SequenceFlow_079" sourceRef="Task_086" targetRef="EndEvent_156"/>

    <!-- Path D: No regression possible (close process) -->
    
    <!-- Task D-1: Close process immediately -->
    <bpmn:task id="Task_134" name="Vorgang schließen">
      <bpmn:incoming>SequenceFlow_015</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_167</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow 20 -->
    <bpmn:sequenceFlow id="SequenceFlow_015" name="Nein" sourceRef="ExclusiveGateway_003" targetRef="Task_134"/>

    <!-- End Event D-2: Process closed (no regression possible) -->
    <bpmn:endEvent id="EndEvent_178" name="Vorgang geschlossen">
      <bpmn:incoming>SequenceFlow_167</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flow 21 -->
    <bpmn:sequenceFlow id="SequenceFlow_167" sourceRef="Task_134" targetRef="EndEvent_178"/>

    <!-- Initial sequence flow from start event -->
    <bpmn:sequenceFlow id="SequenceFlow_001" sourceRef="StartEvent_001" targetRef="Task_002">
      <bpmn:messageEventDefinition/>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>