<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_WorkAccident">
    <bpmn:participant id="Participant_ManagementSystem" name="Work Accident Reporting System" processRef="Process_WorkAccidentReporting" />
  </bpmn:collaboration>

  <bpmn:process id="Process_WorkAccidentReporting" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_InsuredPerson" name="Insured Person / Reporter">
        <bpmn:flowNodeRef>StartEvent_Accident</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_VerifyCriteria</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>XGateway_IsWorkAccident</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>XGateway_DetermineRole</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_EmployerFacility" name="Employer / Educational Facility">
        <bpmn:flowNodeRef>UserTask_ReportToEmployer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>XGateway_SeverityCheck</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Authorities" name="Authorities &amp; Providers">
        <bpmn:flowNodeRef>UserTask_ReportInspectorate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_ReportInsuranceProvider</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_SelfEmployed" name="Self-Employed">
        <bpmn:flowNodeRef>UserTask_ReportSelfInsured</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_PrivateInsurance" name="Private Insurance Policyholder">
        <bpmn:flowNodeRef>UserTask_ReportPrivateInsurance</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Accident" name="Accident Occurs">
      <bpmn:outgoing>SequenceFlow_VerifyCriteria</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Verify Criteria (Work Accident Definition) -->
    <bpmn:userTask id="UserTask_VerifyCriteria" name="Verify Work Accident&#10;Criteria">
      <bpmn:description>Check if accident correlates to employment, school, training, route, or volunteer activity.</bpmn:description>
      <bpmn:incoming>SequenceFlow_VerifyCriteria</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckWorkAccident</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway: Is it a Work Accident? -->
    <bpmn:exclusiveGateway id="XGateway_IsWorkAccident" name="Is Covered&#10;by Insurance?">
      <bpmn:incoming>SequenceFlow_CheckWorkAccident</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NotCoveredPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CoveredPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event: Not Covered -->
    <bpmn:endEvent id="EndEvent_NotCovered" name="Not a Work&#10;Accident">
      <bpmn:incoming>SequenceFlow_NotCoveredPath</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Gateway: Determine Reporting Role -->
    <bpmn:exclusiveGateway id="XGateway_DetermineRole" name="Determine&#10;Reporting Obligation">
      <bpmn:incoming>SequenceFlow_CoveredPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EmployeeReport</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SelfEmployedReport</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PrivateInsuranceReport</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Path 1: Employee Reporting -->
    <bpmn:userTask id="UserTask_ReportToEmployer" name="Inform Employer&#10;Immediately">
      <bpmn:description>Report accident, near-miss, risk or defect.</bpmn:description>
      <bpmn:incoming>SequenceFlow_EmployeeReport</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EmployerAssessSeverity</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Path 2: Self-Employed Reporting -->
    <bpmn:userTask id="UserTask_ReportSelfInsured" name="Report to Insurance&#10;Provider">
      <bpmn:description>Ensure self-employed report accidents involving them.</bpmn:description>
      <bpmn:incoming>SequenceFlow_SelfEmployedReport</bpmn:incoming>
    </bpmn:userTask>

    <!-- Path 3: Private Insurance Reporting -->
    <bpmn:userTask id="UserTask_ReportPrivateInsurance" name="Written Report&#10;to Insurer">
      <bpmn:description>Immediate written report. Fatalities within 3 days.</bpmn:description>
      <bpmn:incoming>SequenceFlow_PrivateInsuranceReport</bpmn:incoming>
    </bpmn:userTask>

    <!-- Gateway: Severity Check by Employer -->
    <bpmn:exclusiveGateway id="XGateway_SeverityCheck" name="Fatality or&#10;Serious Injury?">
      <bpmn:incoming>SequenceFlow_EmployerAssessSeverity</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReportInspectoratePath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ReportInsuranceProviderPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Report to Labour Inspectorate -->
    <bpmn:userTask id="UserTask_ReportInspectorate" name="Report to&#10;Labour Inspectorate">
      <bpmn:description>If fatality or serious injury not reported to emergency services.</bpmn:description>
      <bpmn:incoming>SequenceFlow_ReportInspectoratePath</bpmn:incoming>
    </bpmn:userTask>

    <!-- Task: Report to Insurance Provider -->
    <bpmn:userTask id="UserTask_ReportInsuranceProvider" name="Report Accident&#10;to Insurer">
      <bpmn:description>Killed or unable to work &gt;3 days. Within 5 days.</bpmn:description>
      <bpmn:incoming>SequenceFlow_ReportInsuranceProviderPath</bpmn:incoming>
    </bpmn:userTask>

    <!-- End Event: Reported Inspectorate -->
    <bpmn:endEvent id="EndEvent_ReportedInspectorate" name="Reported to&#10;Labour Inspectorate">
      <bpmn:incoming>SequenceFlow_InsuredPath</bpmn:incoming>
    </bpmn:endEvent>

    <!-- End Event: Reported Insurance -->
    <bpmn:endEvent id="EndEvent_ReportedInsurance" name="Reported to&#10;Accident Insurer">
      <bpmn:incoming>SequenceFlow_InsuredPath</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    
    <!-- Initial Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_VerifyCriteria" sourceRef="StartEvent_Accident" targetRef="UserTask_VerifyCriteria" />
    <bpmn:sequenceFlow id="SequenceFlow_CheckWorkAccident" name="Check Criteria" sourceRef="UserTask_VerifyCriteria" targetRef="XGateway_IsWorkAccident" />

    <!-- Coverage Decision -->
    <bpmn:sequenceFlow id="SequenceFlow_NotCoveredPath" name="No" sourceRef="XGateway_IsWorkAccident" targetRef="EndEvent_NotCovered" />
    <bpmn:sequenceFlow id="SequenceFlow_CoveredPath" name="Yes" sourceRef="XGateway_IsWorkAccident" targetRef="XGateway_DetermineRole" />

    <!-- Role Decision -->
    <bpmn:sequenceFlow id="SequenceFlow_EmployeeReport" name="Employee/Student&#10;Reporting" sourceRef="XGateway_DetermineRole" targetRef="UserTask_ReportToEmployer" />
    <bpmn:sequenceFlow id="SequenceFlow_SelfEmployedReport" name="Self-Employed" sourceRef="XGateway_DetermineRole" targetRef="UserTask_ReportSelfInsured" />
    <bpmn:sequenceFlow id="SequenceFlow_PrivateInsuranceReport" name="Private Insurance&#10;Policyholder" sourceRef="XGateway_DetermineRole" targetRef="UserTask_ReportPrivateInsurance" />

    <!-- Employer Processing -->
    <bpmn:sequenceFlow id="SequenceFlow_EmployerAssessSeverity" sourceRef="UserTask_ReportToEmployer" targetRef="XGateway_SeverityCheck" />
    
    <!-- Inspectorate Reporting Flow (Fatality/Serious Injury) -->
    <bpmn:sequenceFlow id="SequenceFlow_ReportInspectoratePath" name="Yes&#10;(Fatal/Severe)" sourceRef="XGateway_SeverityCheck" targetRef="UserTask_ReportInspectorate" />

    <!-- Insurance Provider Reporting Flow (>3 days/Killed) -->
    <bpmn:sequenceFlow id="SequenceFlow_ReportInsuranceProviderPath" name="Injured &gt; 3 Days&#10;/Killed (5 Days)" sourceRef="XGateway_SeverityCheck" targetRef="UserTask_ReportInsuranceProvider" />

    <!-- End Flows for Reporting -->
    <bpmn:sequenceFlow id="SequenceFlow_InsuredPath" name="Completed Report" sourceRef="UserTask_ReportInspectorate" targetRef="EndEvent_ReportedInspectorate" />
    <bpmn:sequenceFlow id="SequenceFlow_InsuranceProviderComplete" sourceRef="UserTask_ReportInsuranceProvider" targetRef="EndEvent_ReportedInsurance" />

  </bpmn:process>
</bpmn:definitions>