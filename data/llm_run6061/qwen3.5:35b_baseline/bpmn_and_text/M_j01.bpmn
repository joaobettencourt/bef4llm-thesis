<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_ChainsawProcess">
    <bpmn:participant id="Participant_Manufacturer" name="Chainsaw Manufacturer" processRef="Process_CustomProduction" />
  </bpmn:collaboration>

  <bpmn:process id="Process_CustomProduction" isExecutable="false">
    
    <!-- Lane Set -->
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Sales" name="Sales &amp; Customer Service">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_RecordOrderDetails</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Procurement" name="Procurement">
        <bpmn:flowNodeRef>InclusiveGateway_OrderParts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_OrderGuideBarSupplier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_OrderChainSupplier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_OrderMotorEngineSupplier</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Production" name="Production &amp; Assembly">
        <bpmn:flowNodeRef>InclusiveGateway_JoinParts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_ManualInspection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_SendUpdate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_AssemblyLoop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_AssembleFirstSaw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_DeliverFirstSaw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_CustomerApproval</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Order Received">
      <bpmn:outgoing>SequenceFlow_StartToRecord</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Record Order Details (Properties) -->
    <bpmn:userTask id="UserTask_RecordOrderDetails" name="Record Customer Properties&#10;(Guide Bar, Chain Width, Type)">
      <bpmn:incoming>SequenceFlow_StartToRecord</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RecToProcurement</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel Split for Ordering Parts -->
    <bpmn:parallelGateway id="InclusiveGateway_OrderParts" name="Order&#10;Parts">
      <bpmn:incoming>SequenceFlow_RecToProcurement</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OrderGuideBar</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_OrderChain</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_OrderMotorEngine</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Parallel Tasks for Ordering Parts -->
    <bpmn:userTask id="UserTask_OrderGuideBarSupplier" name="Order Guide Bar Supplier">
      <bpmn:incoming>SequenceFlow_OrderGuideBar</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GuideArrives</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="UserTask_OrderChainSupplier" name="Order Chain Supplier">
      <bpmn:incoming>SequenceFlow_OrderChain</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ChainArrives</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="UserTask_OrderMotorEngineSupplier" name="Order Motor/Engine Supplier">
      <bpmn:incoming>SequenceFlow_OrderMotorEngine</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MotorArrives</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Join Parts -->
    <bpmn:parallelGateway id="InclusiveGateway_JoinParts" name="All&#10;Parts Arrived">
      <bpmn:incoming>SequenceFlow_GuideArrives</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ChainArrives</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_MotorArrives</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToInspection</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Inspection -->
    <bpmn:userTask id="UserTask_ManualInspection" name="Manual&#10;Inspection">
      <bpmn:incoming>SequenceFlow_ToInspection</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InspectToAssemblyStart</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Update Notification (Internal Step) -->
    <bpmn:userTask id="UserTask_SendUpdate" name="Send&#10;Updates">
      <bpmn:incoming>SequenceFlow_InspectToAssemblyStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StartLoop</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Assembly Loop / Production -->
    <bpmn:parallelGateway id="InclusiveGateway_AssemblyLoop" name="Production&#10;Phase">
       <bpmn:incoming>SequenceFlow_StartLoop</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_ToFirstSaw</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Assemble First Saw -->
    <bpmn:userTask id="UserTask_AssembleFirstSaw" name="Assemble&#10;First Saw">
      <bpmn:incoming>SequenceFlow_ToFirstSaw</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DeliverToCustomer</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Deliver First Saw (Internal Step) -->
    <bpmn:userTask id="UserTask_DeliverFirstSaw" name="Deliver&#10;First Saw">
      <bpmn:incoming>SequenceFlow_DeliverToCustomer</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitForFeedback</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Wait for Feedback (Implicitly handled by Gateway logic in this model) -->
    <bpmn:exclusiveGateway id="InclusiveGateway_CustomerApproval" name="Customer&#10;Likes First Saw?">
      <bpmn:incoming>SequenceFlow_WaitForFeedback</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ApprovedPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RejectedPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Path Approved -->
    <bpmn:userTask id="UserTask_ProduceRest" name="Produce&#10;Rest of Order">
      <bpmn:incoming>SequenceFlow_ApprovedPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FinalDelivery</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Path Rejected -->
    <bpmn:endEvent id="End_EventRejected" name="Order&#10;Cancelled">
       <bpmn:incoming>SequenceFlow_RejectedPath</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Final End Event -->
    <bpmn:endEvent id="End_EventCompleted" name="Production&#10;Complete">
      <bpmn:incoming>SequenceFlow_FinalDelivery</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToRecord" sourceRef="StartEvent_1" targetRef="UserTask_RecordOrderDetails" />
    
    <bpmn:sequenceFlow id="SequenceFlow_RecToProcurement" name="Properties&#10;Confirmed" sourceRef="UserTask_RecordOrderDetails" targetRef="InclusiveGateway_OrderParts" />

    <!-- Parallel Ordering Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_OrderGuideBar" sourceRef="InclusiveGateway_OrderParts" targetRef="UserTask_OrderGuideBarSupplier" name="Order Guide Bar" />
    <bpmn:sequenceFlow id="SequenceFlow_OrderChain" sourceRef="InclusiveGateway_OrderParts" targetRef="UserTask_OrderChainSupplier" name="Order Chain" />
    <bpmn:sequenceFlow id="SequenceFlow_OrderMotorEngine" sourceRef="InclusiveGateway_OrderParts" targetRef="UserTask_OrderMotorEngineSupplier" name="Order Motor/Engine" />

    <!-- Arrival Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_GuideArrives" sourceRef="UserTask_OrderGuideBarSupplier" targetRef="InclusiveGateway_JoinParts" />
    <bpmn:sequenceFlow id="SequenceFlow_ChainArrives" sourceRef="UserTask_OrderChainSupplier" targetRef="InclusiveGateway_JoinParts" />
    <bpmn:sequenceFlow id="SequenceFlow_MotorArrives" sourceRef="UserTask_OrderMotorEngineSupplier" targetRef="InclusiveGateway_JoinParts" />

    <!-- Production Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_ToInspection" sourceRef="InclusiveGateway_JoinParts" targetRef="UserTask_ManualInspection" name="All Parts&#10;Arrived" />
    
    <bpmn:sequenceFlow id="SequenceFlow_InspectToAssemblyStart" sourceRef="UserTask_ManualInspection" targetRef="UserTask_SendUpdate" name="Pass Inspection" />

    <!-- Update Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_StartLoop" sourceRef="UserTask_SendUpdate" targetRef="InclusiveGateway_AssemblyLoop" name="Send&#10;Updates" />

    <!-- Assembly to Delivery -->
    <bpmn:sequenceFlow id="SequenceFlow_ToFirstSaw" sourceRef="InclusiveGateway_AssemblyLoop" targetRef="UserTask_AssembleFirstSaw" name="Start Production" />
    
    <bpmn:sequenceFlow id="SequenceFlow_DeliverToCustomer" sourceRef="UserTask_AssembleFirstSaw" targetRef="UserTask_DeliverFirstSaw" name="Deliver First&#10;Saw to Customer" />

    <!-- Decision Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_WaitForFeedback" sourceRef="UserTask_DeliverFirstSaw" targetRef="InclusiveGateway_CustomerApproval" name="Await Feedback" />
    
    <bpmn:sequenceFlow id="SequenceFlow_ApprovedPath" name="Yes - Likes It" sourceRef="InclusiveGateway_CustomerApproval" targetRef="UserTask_ProduceRest" />
    
    <bpmn:sequenceFlow id="SequenceFlow_RejectedPath" name="No - Cancelled" sourceRef="InclusiveGateway_CustomerApproval" targetRef="End_EventRejected" />

    <!-- Final Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_FinalDelivery" sourceRef="UserTask_ProduceRest" targetRef="End_EventCompleted" name="Complete Order" />

  </bpmn:process>
</bpmn:definitions>