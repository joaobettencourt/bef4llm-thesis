<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_DIYRepair_01" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_DiyProcess">
    <bpmn:participant id="Participant_DIYUser" name="DIY Smartphone Repair Process" processRef="Process_DIYRepair_01" />
  </bpmn:collaboration>

  <bpmn:process id="Process_DIYRepair_01" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Diyer" name="DIY User">
        <bpmn:flowNodeRef>StartEvent_EnterModel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_CheckInventory</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SourceParts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_ContactFriends</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_BuyRest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MergeSourcing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_FixPhone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ResultCheck</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ToolSystem" name="Online Repair Tool">
        <bpmn:flowNodeRef>UserTask_GetPartsList</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_ProvideInstructions</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_EnterModel" name="Enter Model &amp; Issue">
      <bpmn:outgoing>SequenceFlow_StartToList</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Get Parts List from Tool -->
    <bpmn:userTask id="UserTask_GetPartsList" name="Get Materials &amp; Tools List">
      <bpmn:incoming>SequenceFlow_StartToList</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ListToInventoryCheck</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Check Inventory -->
    <bpmn:userTask id="UserTask_CheckInventory" name="Check Existing Items">
      <bpmn:incoming>SequenceFlow_ListToInventoryCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InventoryDecision</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway: Source Parts Strategy -->
    <bpmn:exclusiveGateway id="Gateway_SourceParts" name="Need to Acquire&#10;Missing Items?">
      <bpmn:incoming>SequenceFlow_InventoryDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BuyOrBorrow</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Contact Friends -->
    <bpmn:userTask id="UserTask_ContactFriends" name="Contact Friends&#10;(Borrow/Buy)">
      <bpmn:incoming>SequenceFlow_BuyOrBorrow</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FriendsToMerge</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Buy Rest -->
    <bpmn:userTask id="UserTask_BuyRest" name="Buy Remaining&#10;Parts/Tools">
      <bpmn:incoming>SequenceFlow_BuyOrBorrow</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BuyToMerge</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway: Merge Sourcing Paths -->
    <bpmn:exclusiveGateway id="Gateway_MergeSourcing" name="Parts&#10;Ready?">
      <bpmn:incoming>SequenceFlow_FriendsToMerge</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_BuyToMerge</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SourcingComplete</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Receive Instructions -->
    <bpmn:userTask id="UserTask_ProvideInstructions" name="Receive Repair&#10;Instructions">
      <bpmn:incoming>SequenceFlow_SourcingComplete</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InstructionToFix</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Fix Phone -->
    <bpmn:userTask id="UserTask_FixPhone" name="Perform Repair">
      <bpmn:incoming>SequenceFlow_InstructionToFix</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ResultCheckReq</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway: Result Check -->
    <bpmn:exclusiveGateway id="Gateway_ResultCheck" name="Repair&#10;Successful?">
      <bpmn:incoming>SequenceFlow_ResultCheckReq</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SuccessPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_FailPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Send Review/Video -->
    <bpmn:userTask id="UserTask_SendReview" name="Send Review&#10;and Video">
      <bpmn:incoming>SequenceFlow_SuccessPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReviewToEnd</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Send to Expert -->
    <bpmn:userTask id="UserTask_SendExpert" name="Send Device&#10;to Expert">
      <bpmn:incoming>SequenceFlow_FailPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ExpertToEnd</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event 1 -->
    <bpmn:endEvent id="EndEvent_Success" name="DIY&#10;Completed">
      <bpmn:incoming>SequenceFlow_ReviewToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- End Event 2 -->
    <bpmn:endEvent id="EndEvent_Fail" name="Expert&#10;Handover">
      <bpmn:incoming>SequenceFlow_ExpertToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToList" sourceRef="StartEvent_EnterModel" targetRef="UserTask_GetPartsList" />
    
    <bpmn:sequenceFlow id="SequenceFlow_ListToInventoryCheck" name="Get List" sourceRef="UserTask_GetPartsList" targetRef="UserTask_CheckInventory" />

    <bpmn:sequenceFlow id="SequenceFlow_InventoryDecision" name="Items Missing?" sourceRef="UserTask_CheckInventory" targetRef="Gateway_SourceParts" />
    
    <!-- Sourcing Logic -->
    <bpmn:sequenceFlow id="SequenceFlow_BuyOrBorrow" name="Yes, Acquire Parts" sourceRef="Gateway_SourceParts" targetRef="Gateway_MergeSourcing">
      <bpmn:name>Acquire Missing Items</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_FriendsToMerge" name="Contact Friends" sourceRef="UserTask_ContactFriends" targetRef="Gateway_MergeSourcing" />
    
    <bpmn:sequenceFlow id="SequenceFlow_BuyToMerge" name="Buy Rest" sourceRef="UserTask_BuyRest" targetRef="Gateway_MergeSourcing" />

    <!-- Post-Sourcing -->
    <bpmn:sequenceFlow id="SequenceFlow_SourcingComplete" name="Parts Ready" sourceRef="Gateway_MergeSourcing" targetRef="UserTask_ProvideInstructions" />

    <bpmn:sequenceFlow id="SequenceFlow_InstructionToFix" name="Get Instructions" sourceRef="UserTask_ProvideInstructions" targetRef="UserTask_FixPhone" />
    
    <!-- Outcome Logic -->
    <bpmn:sequenceFlow id="SequenceFlow_ResultCheckReq" name="Repair Done?" sourceRef="UserTask_FixPhone" targetRef="Gateway_ResultCheck" />

    <bpmn:sequenceFlow id="SequenceFlow_SuccessPath" name="Yes" sourceRef="Gateway_ResultCheck" targetRef="UserTask_SendReview" />
    
    <bpmn:sequenceFlow id="SequenceFlow_FailPath" name="No" sourceRef="Gateway_ResultCheck" targetRef="UserTask_SendExpert" />

    <!-- End Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_ReviewToEnd" name="Submit Review" sourceRef="UserTask_SendReview" targetRef="EndEvent_Success" />
    
    <bpmn:sequenceFlow id="SequenceFlow_ExpertToEnd" name="Send to Expert" sourceRef="UserTask_SendExpert" targetRef="EndEvent_Fail" />

  </bpmn:process>
</bpmn:definitions>