<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_NewApplication">
    <bpmn:participant id="Participant_CourseRegistration" name="Course Registration Process" processRef="Process_CourseRegistration" />
  </bpmn:collaboration>

  <bpmn:process id="Process_CourseRegistration" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_User" name="User/Student">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_SelectCourse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_CheckAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_LoginExisting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_CheckEligibility</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_RegisterAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_RequestActivation</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="System">
        <bpmn:flowNodeRef>UserTask_ShowCourses</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_TweetFriends</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_CompleteRegistration</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_ProvidePayment</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="New Application">
      <bpmn:outgoing>SequenceFlow_SelectCourse</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Show Courses Task (System) -->
    <bpmn:userTask id="UserTask_ShowCourses" name="Show courses and dates">
      <bpmn:incoming>SequenceFlow_SelectCourse</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_UserSelectsCourse</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Select Course Task (User) -->
    <bpmn:userTask id="UserTask_SelectCourse" name="Select a course from available slots">
      <bpmn:incoming>SequenceFlow_UserSelectsCourse</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckAccount</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Check Account Gateway (User) -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_CheckAccount" name="Have account?">
      <bpmn:incoming>SequenceFlow_UserSelectsCourse</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_HaveAccountYes</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_HaveAccountNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Login Existing Account (User) -->
    <bpmn:userTask id="UserTask_LoginExisting" name="Log into existing account">
      <bpmn:incoming>SequenceFlow_HaveAccountYes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReadyToRegister</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Check Eligibility Gateway (User) -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_CheckEligibility" name="Registered at eligible university?">
      <bpmn:incoming>SequenceFlow_HaveAccountNo</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EligibleYes</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_EligibleNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Register Account (User) -->
    <bpmn:userTask id="UserTask_RegisterAccount" name="Register your account">
      <bpmn:incoming>SequenceFlow_EligibleYes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AccountRegistered</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Request Activation (User) -->
    <bpmn:userTask id="UserTask_RequestActivation" name="Request activation and wait for response">
      <bpmn:incoming>SequenceFlow_EligibleNo</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ActivationReceived</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Tweet Friends Task (System) -->
    <bpmn:userTask id="UserTask_TweetFriends" name="Tweet to friends about joining">
      <bpmn:incoming>SequenceFlow_ReadyToRegister</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CompleteRegistration</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Complete Registration (System) -->
    <bpmn:userTask id="UserTask_CompleteRegistration" name="Complete course registration">
      <bpmn:incoming>SequenceFlow_AccountRegistered</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProvidePaymentInfo</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Provide Payment (System) -->
    <bpmn:userTask id="UserTask_ProvidePayment" name="Provide payment information">
      <bpmn:incoming>SequenceFlow_CompleteRegistration</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendTicket</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_1" name="Receive course ticket">
      <bpmn:incoming>SequenceFlow_SendTicket</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows - User Lane -->
    <bpmn:sequenceFlow id="SequenceFlow_SelectCourse" sourceRef="StartEvent_1" targetRef="UserTask_ShowCourses" />
    
    <!-- Show courses to user and they select one -->
    <bpmn:sequenceFlow id="SequenceFlow_UserSelectsCourse" name="User selects course" sourceRef="UserTask_ShowCourses" targetRef="ExclusiveGateway_CheckAccount" />

    <!-- Account Check Paths -->
    <bpmn:sequenceFlow id="SequenceFlow_HaveAccountYes" name="yes - have account" sourceRef="ExclusiveGateway_CheckAccount" targetRef="UserTask_LoginExisting" />
    
    <bpmn:sequenceFlow id="SequenceFlow_HaveAccountNo" name="no - need new account" sourceRef="ExclusiveGateway_CheckAccount" targetRef="ExclusiveGateway_CheckEligibility" />

    <!-- Eligibility Check Paths -->
    <bpmn:sequenceFlow id="SequenceFlow_EligibleYes" name="yes - eligible university" sourceRef="ExclusiveGateway_CheckEligibility" targetRef="UserTask_RegisterAccount" />
    
    <bpmn:sequenceFlow id="SequenceFlow_EligibleNo" name="no - request activation" sourceRef="ExclusiveGateway_CheckEligibility" targetRef="UserTask_RequestActivation" />

    <!-- Account Registration Paths -->
    <bpmn:sequenceFlow id="SequenceFlow_AccountRegistered" name="account ready" sourceRef="UserTask_RegisterAccount" targetRef="UserTask_CompleteRegistration" />
    
    <bpmn:sequenceFlow id="SequenceFlow_ActivationReceived" name="activation received" sourceRef="UserTask_RequestActivation" targetRef="UserTask_LoginExisting" />

    <!-- Registration Flow Paths -->
    <bpmn:sequenceFlow id="SequenceFlow_ReadyToRegister" name="ready to register" sourceRef="UserTask_LoginExisting" targetRef="UserTask_TweetFriends" />
    
    <bpmn:sequenceFlow id="SequenceFlow_CompleteRegistration" name="complete registration" sourceRef="UserTask_TweetFriends" targetRef="UserTask_ProvidePayment" />

    <!-- Payment and End Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_SendTicket" name="send ticket to user" sourceRef="UserTask_ProvidePayment" targetRef="EndEvent_1" />

  </bpmn:process>
</bpmn:definitions>