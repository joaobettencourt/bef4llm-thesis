<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_WorkLiveAustria_Corrected" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_WorkAndLive_Auth">
    <bpmn:participant id="Participant_ApplicantProcess" name="Applicant Process - Work and Live Austria" processRef="Process_WorkAndLiveAustria_Corrected" />
  </bpmn:collaboration>

  <bpmn:process id="Process_WorkAndLiveAustria_Corrected" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_ApplicantActions" name="Applicant Actions">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckRequirements</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_SplitPrep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ArrangeHousingBank</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_DocCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_Competence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitApplication</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AuthorityReview" name="Authority Review (BMEIA/Police)">
        <bpmn:flowNodeRef>InclusiveGateway_DocCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewApplication</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Data Objects -->
    <bpmn:dataObject id="Data_Passport" name="Travel Document (Passport)" />
    <bpmn:dataObject id="Data_Insurance" name="Health Insurance Policy (30k Euro, Schengen)" />
    <bpmn:dataObject id="Data_Funds" name="Proof of Subsistence Funds" />
    <bpmn:dataObject id="Data_Photograph" name="Passport Photo (35x45mm)" />

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Intent to Work/Live">
      <bpmn:outgoing>SequenceFlow_StartToCheck</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Check Requirements -->
    <bpmn:userTask id="Task_CheckRequirements" name="Check Eligibility &amp; Visa Type">
      <bpmn:incoming>SequenceFlow_StartToCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckToParallel</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel Gateway for Preparation -->
    <bpmn:parallelGateway id="ParallelGateway_SplitPrep">
      <bpmn:incoming>SequenceFlow_CheckToParallel</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PrepDocsPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_HousingBankPath</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Prepare Documents -->
    <bpmn:userTask id="Task_PrepareDocuments" name="Prepare Required Documentation">
      <bpmn:incoming>SequenceFlow_PrepDocsPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DocsToCheckMerge</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Arrange Housing & Bank -->
    <bpmn:userTask id="Task_ArrangeHousingBank" name="Organize Accommodation and Negotiate Bank Account">
      <bpmn:incoming>SequenceFlow_HousingBankPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_HousingToCheckMerge</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Inclusive Gateway for Document Validation -->
    <bpmn:inclusiveGateway id="InclusiveGateway_DocCheck">
      <bpmn:incoming>SequenceFlow_DocsToCheckMerge</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_HousingToCheckMerge</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckToCompetence</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Exclusive Gateway for Competent Authority Determination -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_Competence" name="Determine&#10;Competent Office">
      <bpmn:incoming>SequenceFlow_CheckToCompetence</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CompetenceBMEIA</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CompetencePolice</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Submit Application -->
    <bpmn:userTask id="Task_SubmitApplication" name="Submit to Representation Office&#10;or Police HQ">
      <bpmn:incoming>SequenceFlow_CompetenceBMEIA</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AppToReview</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Authority Review -->
    <bpmn:userTask id="Task_ReviewApplication" name="Verify Documents&#10;(Validity, Insurance 30k Euro)">
      <bpmn:incoming>SequenceFlow_CompetencePolice</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AppToDecision</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Decision Point -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_DocDecision" name="Documents&#10;Valid?">
      <bpmn:incoming>SequenceFlow_AppToReview</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DecisionApproved</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_DecisionRejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event: Success -->
    <bpmn:endEvent id="End_EventSuccess" name="Visa Issued&#10;(Rot-Weiss-Rot Card)">
      <bpmn:incoming>SequenceFlow_DecisionApproved</bpmn:incoming>
    </bpmn:endEvent>

    <!-- End Event: Failure -->
    <bpmn:endEvent id="End_EventRejected" name="Application&#10;Rejected">
      <bpmn:incoming>SequenceFlow_DecisionRejected</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToCheck" sourceRef="StartEvent_1" targetRef="Task_CheckRequirements">
      <bpmn:name>Begin Process</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_CheckToParallel" sourceRef="Task_CheckRequirements" targetRef="ParallelGateway_SplitPrep">
      <bpmn:name>Start Prep</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_PrepDocsPath" sourceRef="ParallelGateway_SplitPrep" targetRef="Task_PrepareDocuments">
       <!-- Data Association for Passport, Photo -->
      <bpmn:dataAssociation>
        <bpmn:sourceDataRefs>Data_Passport</bpmn:sourceDataRefs>
        <bpmn:targetDataRefs>Data_Insurance</bpmn:targetDataRefs>
      </bpmn:dataAssociation>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_HousingBankPath" sourceRef="ParallelGateway_SplitPrep" targetRef="Task_ArrangeHousingBank">
       <!-- Data Association for Funds -->
      <bpmn:dataAssociation>
        <bpmn:sourceDataRefs>Data_Funds</bpmn:sourceDataRefs>
      </bpmn:dataAssociation>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_DocsToCheckMerge" sourceRef="Task_PrepareDocuments" targetRef="InclusiveGateway_DocCheck">
       <!-- Data Association for Photo -->
      <bpmn:dataAssociation>
        <bpmn:sourceDataRefs>Data_Photograph</bpmn:sourceDataRefs>
      </bpmn:dataAssociation>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_HousingToCheckMerge" sourceRef="Task_ArrangeHousingBank" targetRef="InclusiveGateway_DocCheck">
       <!-- Data Association for Funds -->
      <bpmn:dataAssociation>
        <bpmn:sourceDataRefs>Data_Funds</bpmn:sourceDataRefs>
      </bpmn:dataAssociation>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_CheckToCompetence" sourceRef="InclusiveGateway_DocCheck" targetRef="ExclusiveGateway_Competence">
       <!-- Data Association for Insurance -->
      <bpmn:dataAssociation>
        <bpmn:sourceDataRefs>Data_Insurance</bpmn:sourceDataRefs>
      </bpmn:dataAssociation>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_CompetenceBMEIA" name="Main Destination / Residence" sourceRef="ExclusiveGateway_Competence" targetRef="Task_SubmitApplication">
       <!-- Logic for BMEIA -->
      <bpmn:name>BMEIA</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_CompetencePolice" name="First Entry / Border Control" sourceRef="ExclusiveGateway_Competence" targetRef="Task_ReviewApplication">
       <!-- Logic for Police/Border -->
      <bpmn:name>Police HQ</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_AppToReview" sourceRef="Task_SubmitApplication" targetRef="ExclusiveGateway_DocDecision">
       <!-- Logic for Review -->
      <bpmn:dataAssociation>
        <bpmn:sourceDataRefs>Data_Funds</bpmn:sourceDataRefs>
      </bpmn:dataAssociation>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_AppToDecision" sourceRef="Task_ReviewApplication" targetRef="ExclusiveGateway_DocDecision">
       <!-- Logic for Review -->
      <bpmn:name>Submit Application</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_DecisionApproved" name="Valid &amp; Complete" sourceRef="ExclusiveGateway_DocDecision" targetRef="End_EventSuccess">
       <!-- Logic for Approval -->
      <bpmn:name>Approved</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_DecisionRejected" name="Invalid / Missing Docs" sourceRef="ExclusiveGateway_DocDecision" targetRef="End_EventRejected">
       <!-- Logic for Rejection -->
      <bpmn:name>Rejected</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
  
  <!-- Associations (Logical connections to data objects) -->
  <bpmn:dataAssociation id="Assoc_PassportCheck" sourceRef="Task_PrepareDocuments" targetRef="Data_Passport">
      <bpmn:name>Passport Check</bpmn:name>
  </bpmn:dataAssociation>
  
  <bpmn:dataAssociation id="Assoc_InsuranceCheck" sourceRef="InclusiveGateway_DocCheck" targetRef="Data_Insurance">
      <bpmn:name>30k Euro Insurance Validity</bpmn:name>
  </bpmn:dataAssociation>

</bpmn:definitions>