<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_001">
    <bpmn:participant id="Participant_Restaurant" name="Restaurant Service Process" processRef="Process_001"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_001" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Guest" name="Guest">
        <bpmn:flowNodeRef>StartEvent_Arrive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ChooseDish</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WaitTurn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_GuestWaitBuzzer</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Employee" name="Employee">
        <bpmn:flowNodeRef>Task_EnterPOS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CollectMoney</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SetBuzzerPassive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SplitWait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_MealReadySignal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RingBuzzerActive</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Chef" name="Chef">
        <bpmn:flowNodeRef>Event_OrderReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareMeal</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Arrive" name="Guest Arrives Hungry">
      <bpmn:outgoing>SequenceFlow_ChooseDish</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Guest Tasks -->
    <bpmn:task id="Task_ChooseDish" name="Choose Dish from Range">
      <bpmn:incoming>SequenceFlow_ChooseDish</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitTurn</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_WaitTurn" name="Wait for Turn">
      <bpmn:incoming>SequenceFlow_WaitTurn</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PlaceOrder</bpmn:outgoing>
    </bpmn:task>

    <!-- Employee Tasks -->
    <bpmn:task id="Task_EnterPOS" name="Enter Order into POS System">
      <bpmn:incoming>SequenceFlow_PlaceOrder</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CollectMoney</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_CollectMoney" name="Collect Money">
      <bpmn:incoming>SequenceFlow_CollectMoney</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SetBuzzerPassive</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_SetBuzzerPassive" name="Set Buzzer &amp; Give to Guest">
      <bpmn:incoming>SequenceFlow_SetBuzzerPassive</bpmn:incoming>
      <bpmn:outgoing>Gateway_SplitWait</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway for Splitting Flow -->
    <bpmn:parallelGateway id="Gateway_SplitWait" name="Split Wait">
      <bpmn:incoming>SequenceFlow_SetBuzzerPassive</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InformChef</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_WaitSignal</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Chef Lane Start -->
    <bpmn:startEvent id="StartEvent_ChefOrder" name="Chef Receives Order">
       <bpmn:incoming>SequenceFlow_InformChef</bpmn:incoming> 
       <bpmn:outgoing>SequenceFlow_PrepareMeal</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Chef Task -->
    <bpmn:task id="Task_PrepareMeal" name="Prepare Meal">
      <bpmn:incoming>SequenceFlow_PrepareMeal</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PlaceInHatch</bpmn:outgoing>
    </bpmn:task>

    <!-- Employee Wait for Signal -->
    <bpmn:intermediateCatchEvent id="Event_MealReadySignal" name="Wait Meal Ready">
      <bpmn:incoming>SequenceFlow_WaitSignal</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RingBuzzerActive</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Employee Task after Signal -->
    <bpmn:task id="Task_RingBuzzerActive" name="Ring Buzzer &amp; Hand Meal">
      <bpmn:incoming>SequenceFlow_RingBuzzerActive</bpmn:incoming>
      <bpmn:outgoing>Gateway_JoinPickup</bpmn:outgoing>
    </bpmn:task>

    <!-- Guest Wait for Pickup -->
    <bpmn:endEvent id="EndEvent_PickUpMeal" name="Process Completed">
       <bpmn:incoming>SequenceFlow_GuestWaitBuzzer</bpmn:incomming> 
    </bpmn:endEvent>

     <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_ChooseDish" sourceRef="StartEvent_Arrive" targetRef="Task_ChooseDish">
      <bpmn:name>Select Dish</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_WaitTurn" sourceRef="Task_ChooseDish" targetRef="Task_WaitTurn"/>

    <bpmn:sequenceFlow id="SequenceFlow_PlaceOrder" sourceRef="Task_WaitTurn" targetRef="Task_EnterPOS">
      <bpmn:name>Place Order</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_CollectMoney" sourceRef="Task_EnterPOS" targetRef="Task_CollectMoney"/>

    <bpmn:sequenceFlow id="SequenceFlow_SetBuzzerPassive" sourceRef="Task_CollectMoney" targetRef="Task_SetBuzzerPassive">
      <bpmn:name>Set Buzzer</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_InformChef" sourceRef="Gateway_SplitWait" targetRef="StartEvent_ChefOrder"/>

    <bpmn:sequenceFlow id="SequenceFlow_PrepareMeal" sourceRef="StartEvent_ChefOrder" targetRef="Task_PrepareMeal">
      <bpmn:name>Chef Starts</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_PlaceInHatch" sourceRef="Task_PrepareMeal" targetRef="Event_MealReadySignal"/> <!-- Simplified for flow -->

     <bpmn:sequenceFlow id="SequenceFlow_WaitSignal" sourceRef="Gateway_SplitWait" targetRef="Event_MealReadySignal">
      <bpmn:name>Notify Employee</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_RingBuzzerActive" sourceRef="Event_MealReadySignal" targetRef="Task_RingBuzzerActive"/>

     <!-- Join Gateway for End -->
    <bpmn:parallelGateway id="Gateway_JoinPickup">
       <bpmn:incoming>SequenceFlow_GuestWaitBuzzer</bpmn:incomming> 
      <bpmn:incoming>SequenceFlow_RingBuzzerActive</bpmn:incomming> 
    </bpmn:parallelGateway>

     <!-- Guest Wait Logic (Simplified for Validity) -->
    <bpmn:endEvent id="EndEvent_GuestWait" name="Guest Waits">
       <bpmn:incoming>SequenceFlow_WaitTurn</bpmn:incomming> 
    </bpmn:endEvent>

     <!-- Corrected End Event for Process Completion -->
    <bpmn:endEvent id="EndEvent_Completed" name="Process Completed">
      <bpmn:incoming>Gateway_JoinPickup</bpmn:outgoing>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>