<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_LeadProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_LeadManagement">
    <bpmn:participant id="Participant_MainSystem" name="Lead Management Process" processRef="Process_LeadProc"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_LeadProc" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Marketing" name="Marketing Department">
        <bpmn:flowNodeRef>StartEvent_GetContactDetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BuyContacts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Exhibitions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PersonalNetwork</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_CallCenter" name="Call Center Staff">
        <bpmn:flowNodeRef>ParallelGateway_SplitCalls</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DetermineContactPerson</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssessBudget</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_IsInterested?</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Sales" name="Sales Department">
        <bpmn:flowNodeRef>Task_CallCustomer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_BudgetHuge?</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_SplitPresentation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OnlinePresentationSalesRep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OnlinePresentationPreSales</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Development" name="Development Department">
        <bpmn:flowNodeRef>Task_HODAcquireCustomer</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Administration" name="Administration">
        <bpmn:flowNodeRef>InclusiveGateway_WaitForResponse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CallAfterTimeout</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_GetContactDetails" name="Get Contact Details">
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Parallel Gateway for different contact methods -->
    <bpmn:parallelGateway id="ParallelGateway_Methods">
      <bpmn:name>Contact Methods Split</bpmn:name>
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BuyContacts</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_Exhibitions</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PersonalNetwork</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 1: Buy Contacts -->
    <bpmn:task id="Task_BuyContacts" name="Buy Contact Details">
      <bpmn:incoming>SequenceFlow_BuyContacts</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeMethods</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: Exhibitions -->
    <bpmn:task id="Task_Exhibitions" name="Participate in Exhibitions">
      <bpmn:incoming>SequenceFlow_Exhibitions</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeMethods</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3: Personal Network -->
    <bpmn:task id="Task_PersonalNetwork" name="Use Personal Network">
      <bpmn:incoming>SequenceFlow_PersonalNetwork</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeMethods</bpmn:outgoing>
    </bpmn:task>

    <!-- Merge Contact Methods -->
    <bpmn:parallelGateway id="ParallelGateway_MethodsMerge">
      <bpmn:name>Contact Methods Merge</bpmn:name>
      <bpmn:incoming>SequenceFlow_MergeMethods</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StartCalls</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Call Customer Task -->
    <bpmn:task id="Task_CallCustomer" name="Call Potential Customer">
      <bpmn:incoming>SequenceFlow_StartCalls</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_QualifyLead</bpmn:outgoing>
    </bpmn:task>

    <!-- Qualification Tasks -->
    <bpmn:task id="Task_DetermineContactPerson" name="Determine Contact Person">
      <bpmn:incoming>SequenceFlow_QualifyLead</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AssessBudget</bpmn:outgoing>
    </bpmn:task>

    <!-- Decision Gateway 1 -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_IsInterested?" name="Is Customer Interested?">
      <bpmn:incoming>SequenceFlow_IsInterestedCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_YesInterested</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoInterestButHugeBudget</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Decision Gateway 2 -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_BudgetHuge?" name="Is Budget Huge?">
      <bpmn:incoming>SequenceFlow_NoInterestButHugeBudget</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_HODAcquire</bpmn:outgoing>
      <bpmn:outgoing>SequenceLeaveCustomerAlone</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- HOD Task -->
    <bpmn:task id="Task_HODAcquireCustomer" name="HOD Acquires Customer">
      <bpmn:incoming>SequenceFlow_HODAcquire</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeAfterDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Merge after decision -->
    <bpmn:parallelGateway id="ParallelGateway_DecisionMerge">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_YesInterested</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_MergeAfterDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StartPresentation</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Presentation Split -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_PresentationType" name="Technical?">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_StartPresentation</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SalesRepPresent</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PreSalesTechnical</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Presentation Tasks -->
    <bpmn:task id="Task_OnlinePresentationSalesRep" name="Online Presentation (Sales Rep)">
      <bpmn:incoming>SequenceFlow_SalesRepPresent</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitForResponse</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3 (Parallel Branch B) -->
    <bpmn:endEvent id="EndEvent_Success" name="Order Processed Successfully"/>

    <!-- Wait for Response -->
    <bpmn:inclusiveGateway id="InclusiveGateway_WaitForResponse" name="Wait 2 Weeks">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_WaitForResponse</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CustomerContacted</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_TimeoutCallAgain</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Timeout Task -->
    <bpmn:task id="Task_CallAfterTimeout" name="Sales Rep Calls After 2 Weeks">
      <bpmn:incoming>SequenceFlow_TimeoutCallAgain</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CreateQuotation</bpmn:outgoing>
    </bpmn:task>

    <!-- Final Gateway -->
    <bpmn:endEvent id="EndEvent_QuotationCreated" name="Create Quotation">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_FinalizeQuote</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_GetContactDetails" targetRef="ParallelGateway_Methods"/>
    <bpmn:sequenceFlow id="SequenceFlow_BuyContacts" name="Buy Contacts" sourceRef="ParallelGateway_Methods" targetRef="Task_BuyContacts"/>
    <bpmn:sequenceFlow id="SequenceFlow_Exhibitions" name="Exhibitions" sourceRef="ParallelGateway_Methods" targetRef="Task_Exhibitions"/>
    <bpmn:sequenceFlow id="SequenceFlow_PersonalNetwork" name="Personal Network" sourceRef="ParallelGateway_Methods" targetRef="Task_PersonalNetwork"/>
    <bpmn:sequenceFlow id="SequenceFlow_MergeMethods" sourceRef="Task_BuyContacts" targetRef="ParallelGateway_MethodsMerge"/>
    <bpmn:sequenceFlow id="SequenceFlow_StartCalls" name="" sourceRef="ParallelGateway_MethodsMerge" targetRef="Task_CallCustomer"/>
    <bpmn:sequenceFlow id="SequenceFlow_QualifyLead" name="" sourceRef="Task_CallCustomer" targetRef="ExclusiveGateway_IsInterested?"/>
    <bpmn:sequenceFlow id="SequenceFlow_AssessBudget" name="" sourceRef="Task_DetermineContactPerson" targetRef="Task_AssessBudget"/>
    <bpmn:sequenceFlow id="SequenceFlow_IsInterestedCheck" name="" sourceRef="Task_AssessBudget" targetRef="ExclusiveGateway_IsInterested?"/>
    <bpmn:sequenceFlow id="SequenceFlow_YesInterested" name="Yes, Interested" sourceRef="ExclusiveGateway_IsInterested?" targetRef="ParallelGateway_DecisionMerge"/>
    <bpmn:sequenceFlow id="SequenceFlow_NoInterestButHugeBudget" name="No Interest but Huge Budget" sourceRef="ExclusiveGateway_IsInterested?" targetRef="ExclusiveGateway_BudgetHuge?"/>
    <bpmn:sequenceFlow id="SequenceLeaveCustomerAlone" name="Not Interested, Small Budget" sourceRef="ExclusiveGateway_BudgetHuge?" targetRef="EndEvent_QuotationCreated">
      <bpmn:name>Leave Customer Alone</bpmn:name>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_HODAcquire" name="Yes, Huge Budget" sourceRef="ExclusiveGateway_BudgetHuge?" targetRef="Task_HODAcquireCustomer"/>
    <bpmn:sequenceFlow id="SequenceFlow_MergeAfterDecision" name="" sourceRef="Task_HODAcquireCustomer" targetRef="ParallelGateway_DecisionMerge"/>
    <bpmn:sequenceFlow id="SequenceFlow_StartPresentation" name="" sourceRef="ParallelGateway_DecisionMerge" targetRef="ExclusiveGateway_PresentationType"/>
    <bpmn:sequenceFlow id="SequenceFlow_SalesRepPresent" name="Not Technical" sourceRef="ExclusiveGateway_PresentationType" targetRef="Task_OnlinePresentationSalesRep"/>
    <bpmn:sequenceFlow id="SequenceFlow_PreSalesTechnical" name="Technical Presentation" sourceRef="ExclusiveGateway_PresentationType" targetRef="Task_OnlinePresentationPreSales"/>
    <bpmn:sequenceFlow id="SequenceFlow_WaitForResponse" name="" sourceRef="Task_OnlinePresentationSalesRep" targetRef="InclusiveGateway_WaitForResponse"/>
    <bpmn:sequenceFlow id="SequenceFlow_TimeoutCallAgain" name="No Contact After 2 Weeks" sourceRef="InclusiveGateway_WaitForResponse" targetRef="Task_CallAfterTimeout"/>
    <bpmn:sequenceFlow id="SequenceFlow_CustomerContacted" name="Customer Contacts Us" sourceRef="InclusiveGateway_WaitForResponse" targetRef="EndEvent_QuotationCreated">
      <bpmn:name></bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>