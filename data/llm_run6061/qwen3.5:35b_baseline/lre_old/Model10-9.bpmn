<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_ChangeProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_0a1b2c3d">
    <bpmn:participant id="Participant_MPOSystem" name="MPO Change Management System" processRef="Process_ChangeProc"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_ChangeProc" isExecutable="false">
    <bpmn:dataObjectReference id="DataChangeRequest" name="Change Request"/>
    
    <bpmn:laneSet>
      <bpmn:lane id="Lane_MPO_Ops" name="MPO Operations">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RejectNotify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Failure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ChangePoint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReportImpl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Success</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Change Request Initiated">
      <bpmn:outgoing>SequenceFlow_InitiateReview</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1 -->
    <bpmn:task id="Task_ReviewRequest" name="Review Change Request">
      <bpmn:incoming>SequenceFlow_InitiateReview</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway -->
    <bpmn:exclusiveGateway id="Gateway_Decision" name="Approve Request?">
      <bpmn:incoming>SequenceFlow_ToDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RejectPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ConfirmPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_InitiateReview" sourceRef="StartEvent_1" targetRef="Task_ReviewRequest"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ToDecision" name="Submit for Review" sourceRef="Task_ReviewRequest" targetRef="Gateway_Decision"/>

    <!-- Reject Path -->
    <bpmn:task id="Task_RejectNotify" name="Report Failure to SP/PU/GO">
      <bpmn:incoming>SequenceFlow_RejectPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FailureEnd</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_Failure" name="Change Failed">
      <bpmn:incoming>SequenceFlow_FailureEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Confirm Path -->
    <bpmn:task id="Task_ChangePoint" name="Perform Measuring Point Change">
      <bpmn:incoming>SequenceFlow_ConfirmPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToReportImpl</bpmn:outgoing>
    </bpmn:task>

    <!-- Reporting Path -->
    <bpmn:task id="Task_ReportImpl" name="Report Implementation to SP/PU/GO">
      <bpmn:incoming>SequenceFlow_ToReportImpl</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SuccessEnd</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_Success" name="Change Successful">
      <bpmn:incoming>SequenceFlow_SuccessEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flow Connections -->
    <bpmn:sequenceFlow id="SequenceFlow_RejectPath" name="Reject" sourceRef="Gateway_Decision" targetRef="Task_RejectNotify"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ConfirmPath" name="Confirm" sourceRef="Gateway_Decision" targetRef="Task_ChangePoint"/>

    <bpmn:sequenceFlow id="SequenceFlow_FailureEnd" sourceRef="Task_RejectNotify" targetRef="EndEvent_Failure"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ToReportImpl" name="Implementation Complete" sourceRef="Task_ChangePoint" targetRef="Task_ReportImpl"/>

    <bpmn:sequenceFlow id="SequenceFlow_SuccessEnd" sourceRef="Task_ReportImpl" targetRef="EndEvent_Success"/>
  </bpmn:process>
</bpmn:definitions>