<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_ComputerRepair" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_ComputerRepair">
    <bpmn:participant id="Participant_CRS" name="Computer Repair Service" processRef="Process_01"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_01" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_CRS" name="CRS Staff">
        <bpmn:flowNodeRef>StartEvent_CustomerArrival</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckDefectAndCosts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>XORGateway_CostAcceptance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParellelSplit_RepairStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckRepairHardware</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>XORGateway_HardwareTestResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RepairSoftwareConfig</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>XORGateway_SoftwareTestResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParellelMerge_FinishRepair</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Customer" name="Customer">
        <bpmn:flowNodeRef>XORGateway_CostAcceptanceDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_TakeHomeUnrepaired</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_CustomerArrival" name="Customer Arrives with Defective Computer">
      <bpmn:outgoing>SequenceFlow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1 -->
    <bpmn:task id="Task_CheckDefectAndCosts" name="Check Defect and Calculate Repair Costs">
      <bpmn:incoming>SequenceFlow_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_02</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1 - Cost Acceptance Decision -->
    <bpmn:exclusiveGateway id="XORGateway_CostAcceptance" name="Costs Acceptable?">
      <bpmn:incoming>SequenceFlow_02</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AcceptRepair</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RejectRepair</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flow 1 -->
    <bpmn:sequenceFlow id="SequenceFlow_01" sourceRef="StartEvent_CustomerArrival" targetRef="Task_CheckDefectAndCosts"/>
    
    <!-- Sequence Flow 2 - to decision gateway -->
    <bpmn:sequenceFlow id="SequenceFlow_02" name="Present Cost Calculation" sourceRef="Task_CheckDefectAndCosts" targetRef="XORGateway_CostAcceptance"/>

    <!-- Parallel Split for Repair Activities -->
    <bpmn:parallelGateway id="ParellelSplit_RepairStart">
      <bpmn:name>Repair Start</bpmn:name>
      <bpmn:incoming>SequenceFlow_AcceptRepair</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_HardwarePath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SoftwarePath</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 2 - Hardware Repair -->
    <bpmn:task id="Task_CheckRepairHardware" name="Check and Repair Hardware">
      <bpmn:incoming>SequenceFlow_HardwarePath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_HWTest</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3 - Software Configuration -->
    <bpmn:task id="Task_RepairSoftwareConfig" name="Check and Configure Software">
      <bpmn:incoming>SequenceFlow_SoftwarePath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SWTest</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2 - Hardware Test Result -->
    <bpmn:exclusiveGateway id="XORGateway_HardwareTestResult" name="Hardware Functional?">
      <bpmn:incoming>SequenceFlow_HWTest</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_HardwareOK</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_HardwareError</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Gateway 3 - Software Test Result -->
    <bpmn:exclusiveGateway id="XORGateway_SoftwareTestResult" name="Software Functional?">
      <bpmn:incoming>SequenceFlow_SWTest</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SoftwareOK</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SoftwareError</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Parallel Merge for Repair Completion -->
    <bpmn:parallelGateway id="ParellelMerge_FinishRepair">
      <bpmn:name>Finish Repair</bpmn:name>
      <bpmn:incoming>SequenceFlow_HardwareOK</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_SoftwareOK</bpmn:incoming>
    </bpmn:parallelGateway>

    <!-- End Event - Customer Takes Home Unrepaired -->
    <bpmn:endEvent id="EndEvent_TakeHomeUnrepaired" name="Computer Taken Home Unrepaired">
      <bpmn:incoming>SequenceFlow_RejectRepair</bpmn:incoming>
    </bpmn:endEvent>

    <!-- End Event - Repair Finished -->
    <bpmn:endEvent id="EndEvent_RepairsFinished" name="Computer Repaired and Ready">
      <bpmn:incoming>SequenceFlow_Final</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows for Decision Paths -->
    <bpmn:sequenceFlow id="SequenceFlow_AcceptRepair" name="Accept Costs" sourceRef="XORGateway_CostAcceptance" targetRef="ParellelSplit_RepairStart"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_RejectRepair" name="Reject Costs" sourceRef="XORGateway_CostAcceptance" targetRef="EndEvent_TakeHomeUnrepaired"/>

    <!-- Sequence Flows for Parallel Repair Paths -->
    <bpmn:sequenceFlow id="SequenceFlow_HardwarePath" name="" sourceRef="ParellelSplit_RepairStart" targetRef="Task_CheckRepairHardware"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_SoftwarePath" name="" sourceRef="ParellelSplit_RepairStart" targetRef="Task_RepairSoftwareConfig"/>

    <!-- Sequence Flows for Test Results -->
    <bpmn:sequenceFlow id="SequenceFlow_HWTest" name="Test Hardware Functionality" sourceRef="Task_CheckRepairHardware" targetRef="XORGateway_HardwareTestResult"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_SWTest" name="Test Software Functionality" sourceRef="Task_RepairSoftwareConfig" targetRef="XORGateway_SoftwareTestResult"/>

    <!-- Sequence Flows for OK Paths -->
    <bpmn:sequenceFlow id="SequenceFlow_HardwareOK" name="Functional - No Error" sourceRef="XORGateway_HardwareTestResult" targetRef="ParellelMerge_FinishRepair"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_SoftwareOK" name="Functional - No Error" sourceRef="XORGateway_SoftwareTestResult" targetRef="ParellelMerge_FinishRepair"/>

    <!-- Sequence Flows for Retry Paths -->
    <bpmn:sequenceFlow id="SequenceFlow_HardwareError" name="Not Functional - Repair Needed" sourceRef="XORGateway_HardwareTestResult" targetRef="Task_CheckRepairHardware"/>

    <bpmn:sequenceFlow id="SequenceFlow_SoftwareError" name="Not Functional - Repair Needed" sourceRef="XORGateway_SoftwareTestResult" targetRef="Task_RepairSoftwareConfig"/>

    <!-- Final Sequence Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_Final" name="" sourceRef="ParellelMerge_FinishRepair" targetRef="EndEvent_RepairsFinished"/>

  </bpmn:process>
</bpmn:definitions>