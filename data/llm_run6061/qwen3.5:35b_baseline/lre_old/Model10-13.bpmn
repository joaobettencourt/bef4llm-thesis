<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_OrdrTransmit" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_TransactionSystem">
    <bpmn:participant id="Participant_MainProcess" name="Transaction System" processRef="Proc_TransactionFlow"/>
  </bpmn:collaboration>

  <bpmn:process id="Proc_TransactionFlow" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_INQ" name="INQ (Inquiry)">
        <bpmn:flowNodeRef>StartEvent_Initiate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TransmitRequest</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_IP" name="IP (Information Provider)">
        <bpmn:flowNodeRef>Task_CheckRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ExaminationOutcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TransmitDataAnswer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RejectRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Failed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Initiate" name="Initiate Transaction Data Request">
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: INQ Transmits -->
    <bpmn:task id="Task_TransmitRequest" name="Transmit transaction data request to IP">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow 1 -->
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_Initiate" targetRef="Task_TransmitRequest"/>

    <!-- Task 2: IP Checks (Crossing Lane) -->
    <bpmn:task id="Task_CheckRequest" name="Check the request of INQ">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow 2 -->
    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="Task_TransmitRequest" targetRef="Task_CheckRequest"/>

    <!-- Gateway: Examination Outcome -->
    <bpmn:exclusiveGateway id="Gateway_ExaminationOutcome" name="Examination Outcome">
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DataTransmitPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RejectPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flow 3 -->
    <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="Task_CheckRequest" targetRef="Gateway_ExaminationOutcome"/>

    <!-- Path A: Transmission of Data (Answer) -->
    <bpmn:task id="Task_TransmitDataAnswer" name="Transmit data / Answer Question">
      <bpmn:incoming>SequenceFlow_DataTransmitPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow Data -->
    <bpmn:sequenceFlow id="SequenceFlow_DataTransmitPath" name="Transmission of data" sourceRef="Gateway_ExaminationOutcome" targetRef="Task_TransmitDataAnswer"/>

    <!-- Path B: Rejected (Answer) -->
    <bpmn:task id="Task_RejectRequest" name="Reject Request / Answer Question">
      <bpmn:incoming>SequenceFlow_RejectPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow Reject -->
    <bpmn:sequenceFlow id="SequenceFlow_RejectPath" name="Rejected" sourceRef="Gateway_ExaminationOutcome" targetRef="Task_RejectRequest"/>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_Success" name="Transaction Completed">
      <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_Failed" name="Request Rejected">
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flow to Success End -->
    <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="Task_TransmitDataAnswer" targetRef="EndEvent_Success"/>

    <!-- Sequence Flow to Failed End -->
    <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="Task_RejectRequest" targetRef="EndEvent_Failed"/>

  </bpmn:process>
</bpmn:definitions>