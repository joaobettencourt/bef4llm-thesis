<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_MeasurementProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_MeasurementProcess">
    <bpmn:participant id="Pool_GO" name="GO (Government Organization)" processRef="Proc_GO"/>
    <bpmn:participant id="Pool_MSP" name="MSP (Measurement Service Provider)" processRef="Proc_MSP"/>
    <bpmn:participant id="Pool_SP" name="SP (Service Provider)" processRef="Proc_SP"/>

    <!-- Message Flows -->
    <bpmn:messageFlow id="Msg_GO_RequestToMSP" sourceRef="Task_GO_RequestMeasurements" targetRef="Event_MSP_CatchRequest"/>
    <bpmn:messageFlow id="Msg_MSP_DenialToGO" sourceRef="Task_MSP_InformDenial" targetRef="Event_GO_ErrorHandling"/>
    <bpmn:messageFlow id="Msg_MSP_FailureReadingToGO" sourceRef="Task_MSP_InformFailureReading" targetRef="Event_GO_ErrorHandling"/>
    <bpmn:messageFlow id="Msg_MSP_ValuesToGO" sourceRef="Task_MSP_TransmitMeasuredValues" targetRef="Event_GO_CatchValues"/>
    <bpmn:messageFlow id="Msg_GO_ChangedToMSP" sourceRef="Task_GO_SendChangedValues" targetRef="Event_MSP_CatchChanged"/>
    <bpmn:messageFlow id="Msg_GO_ReadingsToSP" sourceRef="Task_GO_TransmitReadingsToSP" targetRef="Event_SP_CatchReadings"/>

  </bpmn:collaboration>

  <!-- Process GO -->
  <bpmn:process id="Proc_GO">
    <bpmn:startEvent id="StartEvent_GO_RequestInitiation" name="Request Measurements Initiated">
      <bpmn:outgoing>SequenceFlow_GO_StartToTask</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:endEvent id="EndEvent_GO_Success" name="Process Complete"/>

    <!-- Intermediate Catch Event for Values (Success Path) -->
    <bpmn:startEvent id="StartEvent_GO_CatchValues" name="Receive Measured Values">
      <bpmn:incoming>MessageFlowRef_Msg_MSP_ValuesToGO</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GO_ProcessTask</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Intermediate Catch Event for Changed Values (Return) -->
    <bpmn:endEvent id="EndEvent_GO_ErrorHandling" name="Error Handling"/>

    <!-- Task Process Measured Values -->
    <bpmn:task id="Task_GO_ProcessMeasuredValues" name="GO processes the measured values">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_GO_ProcessTask</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_GO_SendChangedToMSP</bpmn:outgoing>
    </bpmn:task>

    <!-- Task Send Changed Values -->
    <bpmn:task id="Task_GO_SendChangedValues" name="GO sends the changed values to MSP">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_GO_SendChangedToMSP</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_GO_TransmitTaskStart</bpmn:outgoing>
    </bpmn:task>

     <!-- Task Transmit Readings to SP -->
    <bpmn:task id="Task_GO_TransmitReadingsToSP" name="GO transmit the readings to the SP">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_GO_TransmitTaskStart</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_GO_EndSuccess</bpmn:outgoing>
    </bpmn:task>

     <!-- Task Request Measurements -->
    <bpmn:startEvent id="StartEvent_GO_RequestMeasurements" name="GO requests measurements of MSP">
        <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_GO_StartToTask</bpmn:outgoing>
      <bpmn:outgoing>MessageFlowRef_Msg_GO_RequestToMSP</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_GO_StartToTask" sourceRef="StartEvent_GO_RequestInitiation" targetRef="StartEvent_GO_RequestMeasurements"/>
    <bpmn:sequenceFlow id="SequenceFlow_GO_ProcessTask" sourceRef="StartEvent_GO_CatchValues" targetRef="Task_GO_ProcessMeasuredValues"/>
    <bpmn:sequenceFlow id="SequenceFlow_GO_SendChangedToMSP" name="Send Changed Values" sourceRef="Task_GO_ProcessMeasuredValues" targetRef="Task_GO_SendChangedValues"/>
    <bpmn:sequenceFlow id="SequenceFlow_GO_TransmitTaskStart" sourceRef="Task_GO_SendChangedValues" targetRef="Task_GO_TransmitReadingsToSP"/>
    <bpmn:sequenceFlow id="SequenceFlow_GO_EndSuccess" name="Transmitted to SP" sourceRef="Task_GO_TransmitReadingsToSP" targetRef="EndEvent_GO_Success"/>

  </bpmn:process>
</bpmn:definitions>