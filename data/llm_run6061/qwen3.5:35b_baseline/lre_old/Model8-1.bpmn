<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_RecruitmentProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_Recruitment">
    <bpmn:participant id="Participant_HRSystem" name="HR Recruitment System" processRef="Proc_01"/>
  </bpmn:collaboration>

  <bpmn:process id="Proc_01" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_FunctionalDept" name="Functional Department">
        <bpmn:flowNodeRef>StartEvent_Demand</bpmn:flowNodeRef>
      </bpmn:lane>
      
      <bpmn:lane id="Lane_HRTeam" name="HR Team">
        <bpmn:flowNodeRef>Task_AdvertisePost</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveApplications</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CheckCandidates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConcludeContract</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Demand" name="Demand for Post Filling">
      <bpmn:outgoing>SequenceFlow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Advertise -->
    <bpmn:task id="Task_AdvertisePost" name="Advertise Position">
      <bpmn:incoming>SequenceFlow_02</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_03</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: Receive Applications -->
    <bpmn:task id="Task_ReceiveApplications" name="Collect &amp; Review Applications">
      <bpmn:incoming>SequenceFlow_03</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_04</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Check Candidates -->
    <bpmn:exclusiveGateway id="Gateway_CheckCandidates" name="Suitable Candidate Found?">
      <bpmn:incoming>SequenceFlow_04</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_05</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 3: Conclude Contract -->
    <bpmn:task id="Task_ConcludeContract" name="Conclude Employment Contract">
      <bpmn:incoming>SequenceFlow_05</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_06</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_PostFilled" name="Post Filled (Contract Signed)">
      <bpmn:incoming>SequenceFlow_06</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_01" sourceRef="StartEvent_Demand" targetRef="Task_AdvertisePost"/>
    
  </bpmn:process>
</bpmn:definitions>