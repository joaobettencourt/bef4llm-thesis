<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_CourtHearingProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="Participant_MainPool" name="Court Hearing Preparation Process" processRef="Process_HearingPrep"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_HearingPrep" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_AdminStaff" name="Court Administration Staff">
        <bpmn:flowNodeRef>StartEvent_Morning</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckFiles</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_FilesMissing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InitiateSearch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TrackPhysically</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_AssociateTeam" name="Associate &amp; Support Team">
        <bpmn:flowNodeRef>ParallelGateway_FilesReady</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelSplit_ConcurrentTasks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HandFilesToAssociate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DistributeLawlist</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_PreHearingReady</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConductDirectionsHearings</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Morning" name="Morning Routine">
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Check Files -->
    <bpmn:task id="Task_CheckFiles" name="Check Files for Court Hearing">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Decision on Files -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_FilesMissing">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SearchPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_TrackPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Path 1: Search Initiated -->
    <bpmn:task id="Task_InitiateSearch" name="Initiate File Search">
      <bpmn:incoming>SequenceFlow_SearchPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
    </bpmn:task>

    <!-- Path 2: Track Physically -->
    <bpmn:task id="Task_TrackPhysically" name="Track Files to Location">
      <bpmn:incoming>SequenceFlow_TrackPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
    </bpmn:task>

    <!-- Join Point for File Readiness -->
    <bpmn:parallelGateway id="ParallelGateway_FilesReady">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConcurrentStart</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Sequence Flows for Paths -->
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_Morning" targetRef="Task_CheckFiles"/>
    <bpmn:sequenceFlow id="SequenceFlow_2" name="Check Result" sourceRef="Task_CheckFiles" targetRef="ExclusiveGateway_FilesMissing">
      <bpmn:name></bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Decision Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_SearchPath" name="Yes, Missing" sourceRef="ExclusiveGateway_FilesMissing" targetRef="Task_InitiateSearch">
      <bpmn:name></bpmn:name>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_TrackPath" name="No, OK" sourceRef="ExclusiveGateway_FilesMissing" targetRef="Task_TrackPhysically">
      <bpmn:name></bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Merge Flows to Ready Gateway -->
    <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="Task_InitiateSearch" targetRef="ParallelGateway_FilesReady"/>
    <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="Task_TrackPhysically" targetRef="ParallelGateway_FilesReady"/>

    <!-- Parallel Split for Concurrent Tasks -->
    <bpmn:parallelGateway id="ParallelSplit_ConcurrentTasks">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_ConcurrentStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_HandFilesPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_LawlistPath</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Concurrent Task 1 -->
    <bpmn:task id="Task_HandFilesToAssociate" name="Hand Files to Associate">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_HandFilesPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
    </bpmn:task>

    <!-- Concurrent Task 2 -->
    <bpmn:task id="Task_DistributeLawlist" name="Distribute Judges Lawlist">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_LawlistPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flows for Split -->
    <bpmn:sequenceFlow id="SequenceFlow_ConcurrentStart" sourceRef="ParallelGateway_FilesReady" targetRef="ParallelSplit_ConcurrentTasks"/>
    <bpmn:sequenceFlow id="SequenceFlow_HandFilesPath" name="Hand Files" sourceRef="ParallelSplit_ConcurrentTasks" targetRef="Task_HandFilesToAssociate">
      <bpmn:name></bpmn:name>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_LawlistPath" name="Distribute Lawlist" sourceRef="ParallelSplit_ConcurrentTasks" targetRef="Task_DistributeLawlist">
      <bpmn:name></bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Join Point for Hearings -->
    <bpmn:parallelGateway id="ParallelGateway_PreHearingReady">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_HearingsStart</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Final Task -->
    <bpmn:task id="Task_ConductDirectionsHearings" name="Conduct Directions Hearings">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_HearingsStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndProcess</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Completed" name="Hearings Conducted">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_EndProcess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Final Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="Task_HandFilesToAssociate" targetRef="ParallelGateway_PreHearingReady"/>
    <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="Task_DistributeLawlist" targetRef="ParallelGateway_PreHearingReady"/>
    <bpmn:sequenceFlow id="SequenceFlow_HearingsStart" name="All Ready" sourceRef="ParallelGateway_PreHearingReady" targetRef="Task_ConductDirectionsHearings">
      <bpmn:name></bpmn:name>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_EndProcess" name="" sourceRef="Task_ConductDirectionsHearings" targetRef="EndEvent_Completed"/>

  </bpmn:process>
</bpmn:definitions>