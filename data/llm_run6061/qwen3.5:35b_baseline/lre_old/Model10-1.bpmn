<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_OrdrFulfilment" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_MPON_MPOO">
    <bpmn:participant id="Participant_MPON" name="MPON (Manager)" processRef="Process_MPON"/>
    <bpmn:participant id="Participant_MPOO" name="MPOO (Officer)" processRef="Process_MPOO"/>
    <bpmn:messageFlow id="MessageFlow_DismissalSend" sourceRef="Task_SendDismissal" targetRef="StartEvent_ReceiveDismissing">
      <!-- Message flow connects MPON Task to MPOO Start Event -->
    </bpmn:messageFlow>
  </bpmn:collaboration>

  <bpmn:process id="Process_MPON" isExecutable="false">
    <bpmn:startEvent id="StartEvent_InitiateDismissing" name="Initiate Dismissal Request">
      <bpmn:outgoing>SequenceFlow_SendDismissal</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_SendDismissal" name="Send Dismissal to MPOO">
      <bpmn:incoming>SequenceFlow_SendDismissal</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndRequestSent</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_RequestSent" name="Request Sent">
      <bpmn:incoming>SequenceFlow_EndRequestSent</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow_SendDismissal" sourceRef="StartEvent_InitiateDismissing" targetRef="Task_SendDismissal"/>
    <bpmn:sequenceFlow id="SequenceFlow_EndRequestSent" sourceRef="Task_SendDismissal" targetRef="EndEvent_RequestSent"/>
  </bpmn:process>

  <bpmn:message id="Msg_Dismissal" name="Dismissal Notification"/>

  <bpmn:process id="Process_MPOO" isExecutable="false">
    <bpmn:startEvent id="StartEvent_ReceiveDismissing" name="Receive Dismissal Request">
      <bpmn:messageRef>Msg_Dismissal</bpmn:messageRef>
      <bpmn:outgoing>SequenceFlow_StartToReview</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_ReviewDismissal" name="Review Dismissal">
      <bpmn:incoming>SequenceFlow_StartToReview</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToGateway</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_Decide" name="Decision">
      <bpmn:incoming>SequenceFlow_ToGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OpposePath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ConfirmPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="EndEvent_DismissalOpposed" name="Dismissal Opposed">
      <bpmn:incoming>SequenceFlow_OpposePath</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_DismissalConfirmed" name="Dismissal Confirmed">
      <bpmn:incoming>SequenceFlow_ConfirmPath</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow_StartToReview" sourceRef="StartEvent_ReceiveDismissing" targetRef="Task_ReviewDismissal"/>
    <bpmn:sequenceFlow id="SequenceFlow_ToGateway" sourceRef="Task_ReviewDismissal" targetRef="Gateway_Decide"/>
    <bpmn:sequenceFlow id="SequenceFlow_OpposePath" name="Oppose" sourceRef="Gateway_Decide" targetRef="EndEvent_DismissalOpposed"/>
    <bpmn:sequenceFlow id="SequenceFlow_ConfirmPath" name="Confirm" sourceRef="Gateway_Decide" targetRef="EndEvent_DismissalConfirmed"/>
  </bpmn:process>

</bpmn:definitions>