<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_RoomServiceProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_RoomService">
    <bpmn:participant id="Participant_MainSystem" name="Room Service Process - The Evanstonian" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Manager" name="Room-Service Manager">
        <bpmn:flowNodeRef>StartEvent_GuestCall</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TakeOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_AlcoholCheck</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Kitchen" name="Kitchen Staff">
        <bpmn:flowNodeRef>Task_PrepareFood</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Sommelier" name="Sommelier (Wine Waiter)">
        <bpmn:flowNodeRef>Task_FetchAlcohol</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Waiter" name="Waiter">
        <bpmn:flowNodeRef>Gw_SplitTasks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReadiesCart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_MergeAllReady</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_BillingWait</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Admin" name="Administration">
        <bpmn:flowNodeRef>Task_DebitAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_OrderComplete</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_GuestCall" name="Guest Calls Room Service">
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Manager takes order -->
    <bpmn:task id="Task_TakeOrder" name="Take Order from Guest">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Decision for alcohol -->
    <bpmn:exclusiveGateway id="Gw_AlcoholCheck">
      <bpmn:name>Order includes Alcohol?</bpmn:name>
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToKitchen</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SommelierPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Parallel Gateway for splitting to Kitchen, Sommelier, Waiter -->
    <bpmn:parallelGateway id="Gw_SplitTasks">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_ToKitchen</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_KitchenPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_WaiterCartPath</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Kitchen Task -->
    <bpmn:task id="Task_PrepareFood" name="Prepare Food">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_KitchenPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FoodReadyToMerge</bpmn:outgoing>
    </bpmn:task>

    <!-- Sommelier Task (only if alcohol ordered) -->
    <bpmn:task id="Task_FetchAlcohol" name="Fetch Wine &amp; Alcoholic Beverages">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_SommelierPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AlcoholReadyToMerge</bpmn:outgoing>
    </bpmn:task>

    <!-- Waiter Task -->
    <bpmn:task id="Task_ReadiesCart" name="Readies Cart (Tablecloth &amp; Silverware)">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_WaiterCartPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CartReadyToMerge</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2: Merge all ready -->
    <bpmn:exclusiveGateway id="Gw_MergeAllReady">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_FoodReadyToMerge</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_AlcoholReadyToMerge</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_CartReadyToMerge</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DeliveryPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Delivery Task -->
    <bpmn:task id="Task_DeliverOrder" name="Deliver to Guest's Room">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_DeliveryPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReturnedToStation</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 3: Billing decision -->
    <bpmn:parallelGateway id="Gw_BillingWait">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_ReturnedToStation</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DebitAccountPath</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Billing Task -->
    <bpmn:task id="Task_DebitAccount" name="Debit Guest's Account">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_DebitAccountPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OrderComplete</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_OrderComplete" name="Order Process Complete">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_OrderComplete</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_GuestCall" targetRef="Task_TakeOrder"/>
    <bpmn:sequenceFlow id="SequenceFlow_2" name="Submit Order Ticket" sourceRef="Task_TakeOrder" targetRef="Gw_AlcoholCheck"/>

    <!-- Alcohol Decision -->
    <bpmn:sequenceFlow id="SequenceFlow_SommelierPath" name="Yes (80%)" sourceRef="Gw_AlcoholCheck" targetRef="Gw_SplitTasks">
      <bpmn:name>Order includes alcohol</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- No Alcohol Path -->
    <bpmn:sequenceFlow id="SequenceFlow_ToKitchen" name="No (20%)" sourceRef="Gw_AlcoholCheck" targetRef="Gw_SplitTasks">
      <bpmn:name>No alcohol needed</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Parallel Split -->
    <bpmn:sequenceFlow id="SequenceFlow_KitchenPath" sourceRef="Gw_SplitTasks" targetRef="Task_PrepareFood"/>
    <bpmn:sequenceFlow id="SequenceFlow_WaiterCartPath" name="Assign to Waiter" sourceRef="Gw_SplitTasks" targetRef="Task_ReadiesCart">
      <bpmn:name></bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Merge Paths -->
    <bpmn:sequenceFlow id="SequenceFlow_FoodReadyToMerge" name="" sourceRef="Task_PrepareFood" targetRef="Gw_MergeAllReady"/>
    <bpmn:sequenceFlow id="SequenceFlow_AlcoholReadyToMerge" name="" sourceRef="Task_FetchAlcohol" targetRef="Gw_MergeAllReady">
      <bpmn:name></bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Waiter Cart Path -->
    <bpmn:sequenceFlow id="SequenceFlow_CartReadyToMerge" name="" sourceRef="Task_ReadiesCart" targetRef="Gw_MergeAllReady"/>

    <!-- Delivery and Billing -->
    <bpmn:sequenceFlow id="SequenceFlow_DeliveryPath" name="Deliver Order" sourceRef="Gw_MergeAllReady" targetRef="Task_DeliverOrder">
      <bpmn:name></bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Return and Billing -->
    <bpmn:sequenceFlow id="SequenceFlow_ReturnedToStation" name="" sourceRef="Task_DeliverOrder" targetRef="Gw_BillingWait"/>
    <bpmn:sequenceFlow id="SequenceFlow_DebitAccountPath" name="" sourceRef="Gw_BillingWait" targetRef="Task_DebitAccount">
      <bpmn:name></bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Final Completion -->
    <bpmn:sequenceFlow id="SequenceFlow_OrderComplete" name="" sourceRef="Task_DebitAccount" targetRef="EndEvent_OrderComplete"/>

  </bpmn:process>
</bpmn:definitions>