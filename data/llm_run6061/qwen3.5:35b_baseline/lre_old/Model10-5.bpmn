<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_DeviceTakeover_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_DeviceTakeover_1">
    <bpmn:participant id="Participant_MPON_MPOO" name="Device Takeover Process" processRef="Process_Takeover_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Takeover_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_MPON_1" name="MPON">
        <bpmn:flowNodeRef>StartEvent_RequestBid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendRequestForBid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PlaceOrder</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_MPOO_1" name="MPOO">
        <bpmn:flowNodeRef>InclusiveGateway_TenderCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendTender</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConfirmOrderAndMasterData</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_RequestBid" name="Request Device Takeover Bid">
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- MPON Task 1 -->
    <bpmn:task id="Task_SendRequestForBid" name="Send Request for Device Takeover Bid">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:task>

    <!-- MPOO Gateway -->
    <bpmn:inclusiveGateway id="InclusiveGateway_TenderCheck" name="Tender Received">
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- MPOO Task 1 -->
    <bpmn:task id="Task_SendTender" name="Send Tender for Equipment Takeover">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
    </bpmn:task>

    <!-- MPON Task 2 -->
    <bpmn:task id="Task_PlaceOrder" name="Place Order at MPOO">
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
    </bpmn:task>

    <!-- MPOO Task 2 -->
    <bpmn:task id="Task_ConfirmOrderAndMasterData" name="Confirm Order and Send Master Data">
      <bpmn:incoming>SequenceFlow_7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndProcess</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Completed" name="Takeover Process Completed">
      <bpmn:incoming>SequenceFlow_EndProcess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_RequestBid" targetRef="Task_SendRequestForBid"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_2" name="Send Request for Bid" sourceRef="Task_SendRequestForBid" targetRef="InclusiveGateway_TenderCheck">
      <bpmn:name>MPON to MPOO</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Flow from Gateway back through MPON -->
    <bpmn:sequenceFlow id="SequenceFlow_3" name="Request Received by MPOO" sourceRef="InclusiveGateway_TenderCheck" targetRef="Task_SendTender">
      <bpmn:name>MPOO receives request</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Flow from Tender to Order -->
    <bpmn:sequenceFlow id="SequenceFlow_4" name="Send Tender for Equipment Takeover" sourceRef="Task_SendTender" targetRef="InclusiveGateway_TenderCheck">
      <bpmn:name>MPOO sends tender</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Flow from MPOO back to MPON Order -->
    <bpmn:sequenceFlow id="SequenceFlow_5" name="Tender Sent - Ready for Order" sourceRef="InclusiveGateway_TenderCheck" targetRef="Task_PlaceOrder">
      <bpmn:name>MPOO to MPON</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Flow from Place Order -->
    <bpmn:sequenceFlow id="SequenceFlow_6" name="Place Order at MPOO" sourceRef="Task_PlaceOrder" targetRef="InclusiveGateway_TenderCheck">
      <bpmn:name>MPON to MPOO</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Flow from Order Confirmation -->
    <bpmn:sequenceFlow id="SequenceFlow_7" name="Confirm Order and Send Master Data" sourceRef="Task_PlaceOrder" targetRef="Task_ConfirmOrderAndMasterData">
      <bpmn:name>MPOO confirms</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Final Flow to End -->
    <bpmn:sequenceFlow id="SequenceFlow_EndProcess" name="Takeover Completed" sourceRef="Task_ConfirmOrderAndMasterData" targetRef="EndEvent_Completed">
      <bpmn:name>MPOO completes process</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>