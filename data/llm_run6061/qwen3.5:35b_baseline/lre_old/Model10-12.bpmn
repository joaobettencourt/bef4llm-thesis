<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_MasterDataChange" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="Participant_MainSystem" name="Master Data Change Process" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_EC" name="EC (Employee Customer)">
        <bpmn:flowNodeRef>StartEvent_Request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EC_Tell_INQ</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_INQ" name="INQ (Inquiry)">
        <bpmn:flowNodeRef>Task_INQ_Notify_IP</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_IP" name="IP (Information Processor)">
        <bpmn:flowNodeRef>Task_IP_Check_Feasibility</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CanChange</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Confirm_Changes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Success</bpmn:flowNodeRef>
      </bpmn:lane>

       <!-- Rejected Path Lane -->
       <bpmn:lane id="Lane_IP_Reject" name="IP (Information Processor)">
         <bpmn:flowNodeRef>Task_Reject_Changes</bpmn:flowNodeRef>
         <bpmn:flowNodeRef>EndEvent_Failure</bpmn:flowNodeRef>
       </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Request" name="Master Data Change Request">
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: EC tells INQ -->
    <bpmn:task id="Task_EC_Tell_INQ" name="Tell INQ about change">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: INQ notifies IP -->
    <bpmn:task id="Task_INQ_Notify_IP" name="Notify IP of the change">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3: IP checks feasibility -->
    <bpmn:task id="Task_IP_Check_Feasibility" name="Check if change possible at desired time">
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckResult</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway Decision -->
    <bpmn:exclusiveGateway id="Gateway_CanChange" name="Can change at desired time?">
      <bpmn:incoming>SequenceFlow_CheckResult</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConfirmPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RejectPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 4: Confirm changes -->
    <bpmn:task id="Task_Confirm_Changes" name="Confirm changes of INQ">
      <bpmn:incoming>SequenceFlow_ConfirmPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToSuccessEnd</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 5: Reject changes -->
    <bpmn:task id="Task_Reject_Changes" name="Reject changes of INQ">
      <bpmn:incoming>SequenceFlow_RejectPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToFailureEnd</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 1 -->
    <bpmn:endEvent id="EndEvent_Success" name="Changes Confirmed">
      <bpmn:incoming>SequenceFlow_ToSuccessEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- End Event 2 -->
    <bpmn:endEvent id="EndEvent_Failure" name="Changes Rejected">
      <bpmn:incoming>SequenceFlow_ToFailureEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_Request" targetRef="Task_EC_Tell_INQ"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_2" name="Request Sent" sourceRef="Task_EC_Tell_INQ" targetRef="Task_INQ_Notify_IP"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_3" name="Notification Received" sourceRef="Task_INQ_Notify_IP" targetRef="Task_IP_Check_Feasibility"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_CheckResult" name="Check Complete" sourceRef="Task_IP_Check_Feasibility" targetRef="Gateway_CanChange"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ConfirmPath" name="Yes, feasible" sourceRef="Gateway_CanChange" targetRef="Task_Confirm_Changes"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ToSuccessEnd" name="Confirmed" sourceRef="Task_Confirm_Changes" targetRef="EndEvent_Success"/>

    <!-- Reject Path -->
    <bpmn:sequenceFlow id="SequenceFlow_RejectPath" name="No, not feasible" sourceRef="Gateway_CanChange" targetRef="Task_Reject_Changes"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ToFailureEnd" name="Rejected" sourceRef="Task_Reject_Changes" targetRef="EndEvent_Failure"/>

  </bpmn:process>
</bpmn:definitions>