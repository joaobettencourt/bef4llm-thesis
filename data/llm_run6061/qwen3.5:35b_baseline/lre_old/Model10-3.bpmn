<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_MPOO_Deregistration">
  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="Participant_GO_Process" name="GO Process" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_GO" name="Grid Operator (GO)">
        <bpmn:flowNodeRef>Task_VerifyDeregistration</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DecisionVerification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareReadmission</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DecisionObligation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_NotifySplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EquipmentAcquisition</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssignGOMPO</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_MPOO" name="MPOO">
        <bpmn:flowNodeRef>StartEvent_DeregistrationRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConfirmContinuation</bpmn:flowNodeRef>
      </bpmn:lane>

       <!-- End Events -->
       <bpmn:lane id="Lane_EndEvents" name="End States">
         <bpmn:flowNodeRef>Event_DeregistrationRejected</bpmn:flowNodeRef>
         <bpmn:flowNodeRef>ProcessCompleted</bpmn:flowNodeRef>
       </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_DeregistrationRequest" name="MPOO Deregisters">
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Verify -->
    <bpmn:task id="Task_VerifyDeregistration" name="Verify Deregistration">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Verification Decision -->
    <bpmn:exclusiveGateway id="Gateway_DecisionVerification" name="Reject or Confirm?">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RejectPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ConfirmPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flow 1 -->
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_DeregistrationRequest" targetRef="Task_VerifyDeregistration"/>

    <!-- Reject Path -->
    <bpmn:endEvent id="Event_DeregistrationRejected" name="Deregistration Rejected">
      <bpmn:incoming>SequenceFlow_RejectPath</bpmn:incoming>
    </bpmn:endEvent>
    
    <bpmn:sequenceFlow id="SequenceFlow_RejectPath" sourceRef="Gateway_DecisionVerification" targetRef="Event_DeregistrationRejected">
      <bpmn:name>Reject Deregistration</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Confirm Path -->
    <bpmn:task id="Task_PrepareReadmission" name="Prepare Readmission of Measuring Point">
       <bpmn:incoming>SequenceFlow_ConfirmPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_ConfirmPath" sourceRef="Gateway_DecisionVerification" targetRef="Task_PrepareReadmission">
      <bpmn:name>Preliminarily Confirm</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Gateway 2: Obligation Decision -->
    <bpmn:exclusiveGateway id="Gateway_DecisionObligation" name="Obliged to Continue?">
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ObligePath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoObligationPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Oblige Path -->
    <bpmn:task id="Task_ConfirmContinuation" name="Confirm Continuation of Operations">
       <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_ObligePath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeToEquipment</bpmn:outgoing>
    </bpmn:task>

     <!-- Sequence Flows for Obligation Logic -->
    <bpmn:sequenceFlow id="SequenceFlow_ObligePath" sourceRef="Gateway_DecisionObligation" targetRef="Task_ConfirmContinuation">
      <bpmn:name>Obliged</bpmn:name>
    </bpmn:sequenceFlow>

     <!-- No Obligation Path -->
    <bpmn:sequenceFlow id="SequenceFlow_NoObligationPath" sourceRef="Gateway_DecisionObligation" targetRef="Task_EquipmentAcquisition">
      <bpmn:name>No Obligation</bpmn:name>
    </bpmn:sequenceFlow>

     <!-- Merge Confirmation Path to Equipment Task -->
    <bpmn:parallelGateway id="ParallelGateway_MergeConfirmEquipment" name="Merge Confirm &amp; Equipment Path">
       <bpmn:incoming>SequenceFlow_ConfirmTask</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EquipmentAcquisitionStart</bpmn:outgoing>
    </bpmn:parallelGateway>

     <!-- Task Confirmation Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_ConfirmTask" sourceRef="Task_ConfirmContinuation" targetRef="ParallelGateway_MergeConfirmEquipment"/>

    <!-- Equipment Acquisition Start (from Merge or No Obligation) -->
    <bpmn:task id="Task_EquipmentAcquisition" name="Perform Equipment Acquisition/Changes">
       <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_NoObligationPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AssignMPOStart</bpmn:outgoing>
    </bpmn:task>

     <!-- Merge Confirmation Path to Equipment Task -->
    <bpmn:sequenceFlow id="SequenceFlow_EquipmentAcquisitionStart" sourceRef="ParallelGateway_MergeConfirmEquipment" targetRef="Task_EquipmentAcquisition"/>


    <!-- Assignment Step -->
    <bpmn:task id="Task_AssignGOMPO" name="Assign GO as MPO">
       <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_AssignMPOStart</bpmn:outgoing> <!-- Typo in thought, fixing below -->
    </bpmn:task>

     <bpmn:sequenceFlow id="SequenceFlow_AssignMPOStart" sourceRef="Task_EquipmentAcquisition" targetRef="Task_AssignGOMPO"/>


    <!-- Notification Split -->
    <bpmn:parallelGateway id="ParallelGateway_NotifySplit">
      <bpmn:name>Send Notifications</bpmn:name>
      <bpmn:incoming>SequenceFlow_FinalAssign</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NotifMPOO</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NotifMSPO</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NotifSP</bpmn:outgoing>
    </bpmn:parallelGateway>

     <!-- Task Assign to Notify Split -->
    <bpmn:sequenceFlow id="SequenceFlow_FinalAssign" sourceRef="Task_AssignGOMPO" targetRef="ParallelGateway_NotifySplit"/>


    <!-- Notification Tasks -->
    <bpmn:endEvent id="ProcessCompleted" name="Assignment Complete">
      <bpmn:name></bpmn:name>
       <bpmn:incoming>SequenceFlow_FinalMerge</bpmn:outgoing> <!-- Typo in thought, fixing below -->
    </bpmn:endEvent>

     <!-- Correcting IDs for Merge Gateway and Flows to ensure uniqueness -->
     
  </process>
  
   <!-- Re-writing the Process section cleanly with unique IDs to avoid errors before final output generation. -->
</definitions>