<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_VacationRequest_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_VacReq_001">
    <bpmn:participant id="Participant_OrgSystem_001" name="Vacation Request System" processRef="Process_VacReqProc_001"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_VacReqProc_001" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Employee_001" name="Employee (Applicant)">
        <bpmn:flowNodeRef>StartEvent_SubmitRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewRejectionReasons</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Supervisor_001" name="Supervisor">
        <bpmn:flowNodeRef>Task_RegisterAndReceiveRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_Decision</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_HR_001" name="Human Resources Representative">
        <bpmn:flowNodeRef>Task_CompleteManagementProcedures</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_SubmitRequest" name="Submit Vacation Request">
      <bpmn:outgoing>SequenceFlow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Registration and Handover -->
    <bpmn:task id="Task_RegisterAndReceiveRequest" name="Register Requirement &amp; Receive Request">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_02</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_03</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Decision -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_Decision" name="Approve or Reject?">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_03</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RejectPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ApprovePath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 2 (Rejected Path) -->
    <bpmn:task id="Task_ReviewRejectionReasons" name="Review Rejection Reasons">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_RejectPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndRejected</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3 (Approved Path) -->
    <bpmn:task id="Task_CompleteManagementProcedures" name="Complete Management Procedures">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_ApprovePath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndProcessed</bpmn:outgoing>
    </bpmn:task>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_Rejected" name="Request Rejected">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_EndRejected</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_Processed" name="Process Completed">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_EndProcessed</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_01" sourceRef="StartEvent_SubmitRequest" targetRef="Task_RegisterAndReceiveRequest"/>
    
    <!-- Note: Flow crosses lanes implicitly in BPMN logic. 
         For single process model with lanes, we connect directly across lane boundaries for internal handover -->
    <bpmn:sequenceFlow id="SequenceFlow_02" sourceRef="StartEvent_SubmitRequest" targetRef="Task_RegisterAndReceiveRequest"/>

    <!-- Correction to ensure valid flow structure (Single Start -> Task) -->
    
  </process>
</definitions>