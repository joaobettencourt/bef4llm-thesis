<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_OrdrProc" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_GOProcess">
    <bpmn:participant id="Participant_GO" name="General Organization (GO)" processRef="Process_Main"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Main" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="Start_1" name="Measurement Registration by MSPN">
      <bpmn:outgoing>Seq_StartToExamine</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Examine Application -->
    <bpmn:task id="Task_ExamineApp" name="Examine Application of MSPN">
      <bpmn:incoming>Seq_StartToExamine</bpmn:incoming>
      <bpmn:outgoing>Seq_ExamToDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Decision (Reject or Confirm) -->
    <bpmn:exclusiveGateway id="Gw_Decision" name="Confirm Application?">
      <bpmn:incoming>Seq_ExamToDecision</bpmn:incoming>
      <bpmn:outgoing>Seq_RejectPath</bpmn:outgoing>
      <bpmn:outgoing>Seq_ConfirmPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event 1 -->
    <bpmn:endEvent id="End_Reject" name="Application Rejected">
      <bpmn:incoming>Seq_RejectPath</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task 2: Assign MSPN (Confirm Path) -->
    <bpmn:task id="Task_AssignMSPN" name="Assign MSPN">
      <bpmn:incoming>Seq_ConfirmPath</bpmn:incoming>
      <bpmn:outgoing>Seq_SplitInform</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2: Parallel Split (Notify Parties) -->
    <bpmn:parallelGateway id="Gw_NotifySplit" name="Notify Parties">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>Seq_SplitInform</bpmn:incoming>
      <bpmn:outgoing>Seq_InformMSPO</bpmn:outgoing>
      <bpmn:outgoing>Seq_InformMPO</bpmn:outgoing>
      <bpmn:outgoing>Seq_InformSP</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 3: Inform MSPO -->
    <bpmn:task id="Task_InformMSPO" name="Inform MSPO about Assignment">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>Seq_InformMSPO</bpmn:incoming>
      <bpmn:outgoing>Seq_MSPOtoMerge</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 4: Inform MPO -->
    <bpmn:task id="Task_InformMPO" name="Inform MPO about Assignment">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>Seq_InformMPO</bpmn:incoming>
      <bpmn:outgoing>Seq_MPotoMerge</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 5: Inform SP -->
    <bpmn:task id="Task_InformSP" name="Inform SP about Assignment">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>Seq_InformSP</bpmn:incoming>
      <bpmn:outgoing>Seq_SptoMerge</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 3: Parallel Merge -->
    <bpmn:parallelGateway id="Gw_NotifyMerge" name="All Notified">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>Seq_MSPOtoMerge</bpmn:incoming>
      <bpmn:incoming>Seq_MPotoMerge</bpmn:incoming>
      <bpmn:incoming>Seq_SptoMerge</bpmn:incoming>
      <bpmn:outgoing>Seq_ToEndComplete</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- End Event 2 -->
    <bpmn:endEvent id="End_Complete" name="Process Completed">
      <bpmn:incoming>Seq_ToEndComplete</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Seq_StartToExamine" sourceRef="Start_1" targetRef="Task_ExamineApp"/>
    <bpmn:sequenceFlow id="Seq_ExamToDecision" name="Application Review" sourceRef="Task_ExamineApp" targetRef="Gw_Decision"/>
    
    <!-- Decision Paths -->
    <bpmn:sequenceFlow id="Seq_RejectPath" name="Reject Application" sourceRef="Gw_Decision" targetRef="End_Reject"/>
    <bpmn:sequenceFlow id="Seq_ConfirmPath" name="Confirm Application" sourceRef="Gw_Decision" targetRef="Task_AssignMSPN"/>

    <!-- Notification Split -->
    <bpmn:sequenceFlow id="Seq_SplitInform" sourceRef="Task_AssignMSPN" targetRef="Gw_NotifySplit"/>
    
    <!-- Parallel Tasks and Merge Flows -->
    <bpmn:sequenceFlow id="Seq_InformMSPO" name="To MSPO" sourceRef="Gw_NotifySplit" targetRef="Task_InformMSPO"/>
    <bpmn:sequenceFlow id="Seq_MSPOtoMerge" sourceRef="Task_InformMSPO" targetRef="Gw_NotifyMerge"/>

    <bpmn:sequenceFlow id="Seq_InformMPO" name="To MPO" sourceRef="Gw_NotifySplit" targetRef="Task_InformMPO"/>
    <bpmn:sequenceFlow id="Seq_MPotoMerge" sourceRef="Task_InformMPO" targetRef="Gw_NotifyMerge"/>

    <bpmn:sequenceFlow id="Seq_InformSP" name="To SP" sourceRef="Gw_NotifySplit" targetRef="Task_InformSP"/>
    <bpmn:sequenceFlow id="Seq_SptoMerge" sourceRef="Task_InformSP" targetRef="Gw_NotifyMerge"/>

    <!-- Final Flow -->
    <bpmn:sequenceFlow id="Seq_ToEndComplete" name="All Notified" sourceRef="Gw_NotifyMerge" targetRef="End_Complete"/>

  </bpmn:process>
</bpmn:definitions>