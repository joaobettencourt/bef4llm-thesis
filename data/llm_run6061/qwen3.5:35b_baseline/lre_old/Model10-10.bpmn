<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_FaultProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_OrdrFulfilment">
    <bpmn:participant id="Participant_UserSystem" name="Fault Management System" processRef="Proc_FaultMgmt"/>
  </bpmn:collaboration>

  <bpmn:process id="Proc_FaultMgmt" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_ServiceUser" name="Service User">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExamineFailure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ConfirmFault</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_FalseAlarm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InitialNotification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FixFault</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ShareResultsDetector</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ResolveNotifyCustomer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ResolveNotifyManager</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ProcessComplete</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Fault Reported or Suspicion">
      <bpmn:outgoing>SequenceFlow_Examine</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1 -->
    <bpmn:task id="Task_ExamineFailure" name="Examine Failure">
      <bpmn:incoming>SequenceFlow_Examine</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DecideFault</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway -->
    <bpmn:exclusiveGateway id="Gateway_ConfirmFault" name="Confirm Fault?">
      <bpmn:incoming>SequenceFlow_DecideFault</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RejectPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ConfirmPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_Examine" sourceRef="StartEvent_1" targetRef="Task_ExamineFailure"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_DecideFault" name="Examination Result" sourceRef="Task_ExamineFailure" targetRef="Gateway_ConfirmFault"/>

    <!-- Reject Path -->
    <bpmn:endEvent id="EndEvent_FalseAlarm" name="False Alarm">
      <bpmn:incoming>SequenceFlow_RejectPath</bpmn:incoming>
    </bpmn:endEvent>
    
    <bpmn:sequenceFlow id="SequenceFlow_RejectPath" sourceRef="Gateway_ConfirmFault" targetRef="EndEvent_FalseAlarm">
      <bpmn:name>User Rejects Fault</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Confirm Path -->
    <bpmn:task id="Task_InitialNotification" name="Inform Customer and Manager of Failure">
      <bpmn:incoming>SequenceFlow_ConfirmPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FixFault</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_ConfirmPath" sourceRef="Gateway_ConfirmFault" targetRef="Task_InitialNotification">
      <bpmn:name>User Confirms Fault</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Fixing Process -->
    <bpmn:task id="Task_FixFault" name="Fix Fault at Measuring Device">
      <bpmn:incoming>SequenceFlow_FixFault</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ShareResults</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_FixFault" sourceRef="Task_InitialNotification" targetRef="Task_FixFault"/>

    <!-- Sharing Results -->
    <bpmn:task id="Task_ShareResultsDetector" name="Share Repair Results with Fault Detector">
      <bpmn:incoming>SequenceFlow_ShareResults</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ResolveNotifyCust</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_ShareResults" sourceRef="Task_FixFault" targetRef="Task_ShareResultsDetector"/>

    <!-- Resolution Notifications -->
    <bpmn:endEvent id="EndEvent_ProcessComplete" name="Interference Resolved">
      <bpmn:incoming>SequenceFlow_ResolveNotifyMgr</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:task id="Task_ResolveNotifyManager" name="Inform Manager about Resolution">
      <bpmn:incoming>SequenceFlow_ResolveNotifyMgr</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FinalizeProcess</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_ResolveNotifyMgr" sourceRef="Task_ShareResultsDetector" targetRef="Task_ResolveNotifyManager"/>

    <bpmn:sequenceFlow id="SequenceFlow_FinalizeProcess" sourceRef="Task_ResolveNotifyManager" targetRef="EndEvent_ProcessComplete"/>
    
    <!-- Customer notification task -->
    <bpmn:task id="Task_ResolveNotifyCustomer" name="Inform Customer about Resolution">
      <bpmn:incoming>SequenceFlow_ResolveNotifyCust</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ResolveNotifyMgr</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_ResolveNotifyCust" sourceRef="Task_ShareResultsDetector" targetRef="Task_ResolveNotifyCustomer"/>

  </bpmn:process>
</bpmn:definitions>