<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_WebDevProcess" name="Customer Feedback Module Development Process" processRef="Process_1" />
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_BusinessAnalyst" name="Business Analyst">
        <bpmn:name>Business Analyst</bpmn:name>
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CollectDataAnalysis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_DesignCheck</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_WebDesigner" name="Web Designer">
        <bpmn:name>Web Designer</bpmn:name>
        <bpmn:flowNodeRef>InclusiveGateway_DesignAdjustmentLoopback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IntegrateDesignPlacement</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Developer" name="PHP/HTML/CSS Specialist">
        <bpmn:name>PHP/HTML/CSS Specialist</bpmn:name>
        <bpmn:flowNodeRef>InclusiveGateway_TestAdjustmentLoopback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IntegrateOverallImplementation</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Tester" name="Tester">
        <bpmn:name>Tester</bpmn:name>
        <bpmn:flowNodeRef>InclusiveGateway_TestResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TestFinalWebsite</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Process Initiated">
      <bpmn:outgoing>SequenceFlow_CollectData</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Business Analyst Task -->
    <bpmn:task id="Task_CollectDataAnalysis" name="Collect data and conduct business analysis regarding customer feedback">
      <bpmn:incoming>SequenceFlow_CollectData</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DesignStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Web Designer Task -->
    <bpmn:task id="Task_IntegrateDesignPlacement" name="Integrates design and decides where customer feedback module should be placed">
      <bpmn:incoming>SequenceFlow_DesignStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AnalystWaitForDesign</bpmn:outgoing>
    </bpmn:task>

    <!-- Design Check Gateway -->
    <bpmn:inclusiveGateway id="InclusiveGateway_DesignCheck" name="Design OK?">
      <bpmn:incoming>SequenceFlow_AnalystWaitForDesign</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AdjustmentNeeded</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_DesignApproved</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Adjustment Needed Flow (Loopback to Designer) -->
    <bpmn:sequenceFlow id="SequenceFlow_AdjustmentNeeded" name="No - Needs adjustment">
      <bpmn:sourceRef>InclusiveGateway_DesignCheck</bpmn:sourceRef>
      <bpmn:targetRef>Task_IntegrateDesignPlacement</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Design Approved Flow (To Developer) -->
    <bpmn:sequenceFlow id="SequenceFlow_DesignApproved" name="Yes - OK">
      <bpmn:sourceRef>InclusiveGateway_DesignCheck</bpmn:sourceRef>
      <bpmn:targetRef>Task_IntegrateOverallImplementation</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Developer Task -->
    <bpmn:task id="Task_IntegrateOverallImplementation" name="Integrates with overall implementation">
      <bpmn:incoming>SequenceFlow_DesignApproved</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TestingStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Tester Task -->
    <bpmn:task id="Task_TestFinalWebsite" name="Tests the final website to make sure everything is going well">
      <bpmn:incoming>SequenceFlow_TestingStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GatewayTestResult</bpmn:outgoing>
    </bpmn:task>

    <!-- Test Result Gateway -->
    <bpmn:inclusiveGateway id="InclusiveGateway_TestResult" name="Test OK?">
      <bpmn:incoming>SequenceFlow_GatewayTestResult</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProcessEnds</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_TestFailedLoopback</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Process End -->
    <bpmn:endEvent id="EndEvent_1" name="Process Completed">
      <bpmn:incoming>SequenceFlow_ProcessEnds</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flow from BA to Designer Task -->
    <bpmn:sequenceFlow id="SequenceFlow_DesignStart" sourceRef="Task_CollectDataAnalysis" targetRef="Task_IntegrateDesignPlacement">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <!-- Sequence Flow from Designer Task to Design Check Gateway -->
    <bpmn:sequenceFlow id="SequenceFlow_AnalystWaitForDesign" sourceRef="Task_IntegrateDesignPlacement" targetRef="InclusiveGateway_DesignCheck">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <!-- Sequence Flow from Developer Task to Testing Start -->
    <bpmn:sequenceFlow id="SequenceFlow_TestingStart" sourceRef="Task_IntegrateOverallImplementation" targetRef="InclusiveGateway_DesignCheck">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <!-- Correction for Tester Flow to Gateway Test Result -->
    <bpmn:sequenceFlow id="SequenceFlow_GatewayTestResult" sourceRef="Task_TestFinalWebsite" targetRef="InclusiveGateway_TestResult">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <!-- Sequence Flow from Design Check to Developer Task -->
    <bpmn:sequenceFlow id="SequenceFlow_DesignApprovedToDev" sourceRef="InclusiveGateway_DesignCheck" targetRef="Task_IntegrateOverallImplementation">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <!-- Sequence Flow from Test Failed to Developer Task -->
    <bpmn:sequenceFlow id="SequenceFlow_TestFailedLoopback" sourceRef="InclusiveGateway_TestResult" targetRef="Task_IntegrateOverallImplementation">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <!-- Sequence Flow from Test Result Gateway to End Event -->
    <bpmn:sequenceFlow id="SequenceFlow_ProcessEnds" sourceRef="InclusiveGateway_TestResult" targetRef="EndEvent_1">
      <bpmn:name/>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>