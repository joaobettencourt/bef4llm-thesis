<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_ProvisionTeam" name="Provision Team Process" processRef="Process_ProvisionTeam"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_ProvisionTeam" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Team" name="Provision Team">
        <bpmn:name>Provision Team</bpmn:name>
        <bpmn:flowNodeRef>StartEvent_RequestReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_QuestionsExist</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IdentifyParts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateCatchEvent_WaitResponse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_MergeCheckAvailability</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckPartsAvailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_PartsAvailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SupplyParts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecordPetition</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OrderDaisuki</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_MergeOrderPath</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateCatchEvent_WaitCollectionTeam</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ContactCustomer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_MergeRecollectionPath</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateCatchEvent_WaitRecollectedByCustomer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceivePayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ProcessComplete</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_RequestReceived" name="Request Received">
      <bpmn:outgoing>SequenceFlow_IdentifyParts</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Identify Parts -->
    <bpmn:task id="Task_IdentifyParts" name="Identify necessary parts">
      <bpmn:incoming>SequenceFlow_IdentifyParts</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_QuestionsExist</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Questions Exist? -->
    <bpmn:exclusiveGateway id="InclusiveGateway_QuestionsExist" name="Questions exist?">
      <bpmn:incoming>SequenceFlow_QuestionsExist</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AskInfoPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_DirectCheckPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Path Yes: Ask Info -->
    <bpmn:task id="Task_AskInfo" name="Ask for more information">
      <bpmn:incoming>SequenceFlow_AskInfoPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitResponseStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Event 1: Wait for Response -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_WaitResponse" name="Wait for Customer Info">
      <bpmn:incoming>SequenceFlow_WaitResponseStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeCheckAvailability</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Path No: Direct to Check -->
    <bpmn:sequenceFlow id="SequenceFlow_DirectCheckPath" name="No questions">
      <bpmn:sourceRef>InclusiveGateway_QuestionsExist</bpmn:sourceRef>
      <bpmn:name>If no questions, proceed directly.</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Gateway 2: Merge before Check Availability -->
    <bpmn:inclusiveGateway id="InclusiveGateway_MergeCheckAvailability" name="Merge Info Paths">
      <bpmn:incoming>SequenceFlow_WaitResponseStart</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_DirectCheckPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckAvailability</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Task 2: Check Availability -->
    <bpmn:task id="Task_CheckPartsAvailable" name="Check if parts are available">
      <bpmn:incoming>SequenceFlow_CheckAvailability</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PartsDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 3: Parts Available? -->
    <bpmn:exclusiveGateway id="InclusiveGateway_PartsAvailable" name="Parts available?">
      <bpmn:incoming>SequenceFlow_PartsDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SupplyPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_OrderPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Path Yes: Supply Parts -->
    <bpmn:task id="Task_SupplyParts" name="Supply parts to customer">
      <bpmn:incoming>SequenceFlow_SupplyPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeRecollectionStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Path No: Order Process -->
    <bpmn:task id="Task_RecordPetition" name="Record petition">
      <bpmn:incoming>SequenceFlow_OrderPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OrderDaisukiStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3: Order Daisuki -->
    <bpmn:task id="Task_OrderDaisuki" name="Make order to Daisuki">
      <bpmn:incoming>SequenceFlow_OrderDaisukiStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitCollectionTeamStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Event 2: Wait for Team Collection -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_WaitCollectionTeam" name="Wait until collected by team">
      <bpmn:incoming>SequenceFlow_WaitCollectionTeamStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ContactCustomerPath</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task 4: Contact Customer -->
    <bpmn:task id="Task_ContactCustomer" name="Contact customer">
      <bpmn:incoming>SequenceFlow_ContactCustomerPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeRecollectionStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 4: Merge Order Path -->
    <bpmn:inclusiveGateway id="InclusiveGateway_MergeOrderPath" name="Merge Order Path">
      <bpmn:incoming>SequenceFlow_WaitCollectionTeamStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ContactCustomerPath</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Gateway 5: Merge Recollection Paths -->
    <bpmn:exclusiveGateway id="InclusiveGateway_MergeRecollectionPath" name="Merge for Payment Wait">
      <bpmn:incoming>SequenceFlow_SupplyPath</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ContactCustomerPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitRecollectedStart</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Intermediate Event 3: Wait for Recollection -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_WaitRecollectedByCustomer" name="Wait for Customer Recollected">
      <bpmn:incoming>SequenceFlow_WaitRecollectedStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReceivePaymentPath</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task 5: Receive Payment -->
    <bpmn:task id="Task_ReceivePayment" name="Receive final payment">
      <bpmn:incoming>SequenceFlow_ReceivePaymentPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndProcess</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_ProcessComplete" name="Shipment Prepared">
      <bpmn:incoming>SequenceFlow_EndProcess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows Definitions -->
    <bpmn:sequenceFlow id="SequenceFlow_IdentifyParts" sourceRef="StartEvent_RequestReceived" targetRef="Task_IdentifyParts">
      <bpmn:name>Process Start</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_QuestionsExist" sourceRef="Task_IdentifyParts" targetRef="InclusiveGateway_QuestionsExist">
      <bpmn:name>After Identify Parts</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_AskInfoPath" sourceRef="InclusiveGateway_QuestionsExist" targetRef="Task_AskInfo">
      <bpmn:name>If questions exist</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_WaitResponseStart" sourceRef="Task_AskInfo" targetRef="IntermediateCatchEvent_WaitResponse">
      <bpmn:name>Request Info Sent</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_MergeCheckAvailability" sourceRef="InclusiveGateway_QuestionsExist" targetRef="Task_CheckPartsAvailable">
       <!-- Note: Logic corrected to merge at Gateway 2 -->
      <bpmn:name>No Questions</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_DirectCheckPath" sourceRef="InclusiveGateway_QuestionsExist" targetRef="InclusiveGateway_MergeCheckAvailability">
      <bpmn:name>No Questions</bpmn:name>
    </bpmn:sequenceFlow>

     <!-- Correcting the flow logic for XML validity -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckAvailability" sourceRef="InclusiveGateway_MergeCheckAvailability" targetRef="Task_CheckPartsAvailable">
      <bpmn:name>To Check Availability</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_PartsDecision" sourceRef="Task_CheckPartsAvailable" targetRef="InclusiveGateway_PartsAvailable">
      <bpmn:name>Check Result</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_SupplyPath" sourceRef="InclusiveGateway_PartsAvailable" targetRef="Task_SupplyParts">
      <bpmn:name>If Available</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_OrderPath" sourceRef="InclusiveGateway_PartsAvailable" targetRef="Task_RecordPetition">
      <bpmn:name>If Not Available</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_MergeRecollectionStart" sourceRef="Task_SupplyParts" targetRef="InclusiveGateway_MergeOrderPath">
       <!-- Merging Supply Path to Order Merge Gateway for logic flow -->
      <bpmn:name>To Recollected Wait</bpmn:name>
    </bpmn:sequenceFlow>

     <bpmn:sequenceFlow id="SequenceFlow_OrderDaisukiStart" sourceRef="Task_RecordPetition" targetRef="Task_OrderDaisuki">
       <bpmn:name>Record Petition Done</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_WaitCollectionTeamStart" sourceRef="Task_OrderDaisuki" targetRef="IntermediateCatchEvent_WaitCollectionTeam">
       <bpmn:name>Order Placed</bpmn:name>
    </bpmn:sequenceFlow>

     <!-- Correcting Merge Order Path Logic -->
    <bpmn:inclusiveGateway id="InclusiveGateway_MergeRecollection" name="Merge for Payment Wait">
      <bpmn:incoming>SequenceFlow_SupplyPath</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ContactCustomerPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitRecollectedStart</bpmn:outgoing>
    </bpmn:inclusiveGateway>

     <!-- Re-assigning Gateway IDs to ensure uniqueness and flow logic -->
  </bpmn:process>
</bpmn:definitions>