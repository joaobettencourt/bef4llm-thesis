<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Client Acquisition Process" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_MarketingTeam" name="Marketing Team">
        <bpmn:name>Marketing Team</bpmn:name>
        <bpmn:flowNodeRef>StartEvent_NewClientsNeeded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Analysis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Presentation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendOffers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformResponses</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Management" name="Management">
        <bpmn:name>Management</bpmn:name>
        <bpmn:flowNodeRef>Task_DetailedOffer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_ClientDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareContract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SignContract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ContractSigned</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AnalyzeFailure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ImproveFuture</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ProcessImproved</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_NewClientsNeeded" name="New Clients Needed Indication">
      <bpmn:outgoing>SequenceFlow_Analysis</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Marketing Tasks -->
    <bpmn:task id="Task_Analysis" name="Perform Market Analysis">
      <bpmn:incoming>SequenceFlow_Analysis</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Presentation</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_Presentation" name="Prepare Portfolio Presentation">
      <bpmn:incoming>SequenceFlow_Presentation</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendOffers</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_SendOffers" name="Send Offers to Potential Clients">
      <bpmn:incoming>SequenceFlow_SendOffers</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InformResponses</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_InformResponses" name="Inform Management about Responses">
      <bpmn:incoming>SequenceFlow_InformResponses</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DetailedOfferStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Negotiation Phase (Management) -->
    <bpmn:task id="Task_DetailedOffer" name="Send Detailed Offer to Client">
      <bpmn:incoming>SequenceFlow_DetailedOfferStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ClientDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Decision Gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_ClientDecision" name="Client Accepts Offer?">
      <bpmn:incoming>SequenceFlow_ClientDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AcceptPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RejectPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Success Path -->
    <bpmn:task id="Task_PrepareContract" name="Prepare Contract">
      <bpmn:incoming>SequenceFlow_AcceptPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SignContract</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_SignContract" name="Sign Contract">
      <bpmn:incoming>SequenceFlow_SignContract</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ContractSignedEnd</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_ContractSigned" name="Contract Signed">
      <bpmn:incoming>SequenceFlow_ContractSignedEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Failure Path -->
    <bpmn:task id="Task_AnalyzeFailure" name="Analyze Reason for Offer Failure">
      <bpmn:incoming>SequenceFlow_RejectPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ImproveFutureStart</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_ImproveFuture" name="Implement Improvements for Future">
      <bpmn:incoming>SequenceFlow_ImproveFutureStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProcessImprovedEnd</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_ProcessImproved" name="Process Improved">
      <bpmn:incoming>SequenceFlow_ProcessImprovedEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_Analysis" sourceRef="StartEvent_NewClientsNeeded" targetRef="Task_Analysis"/>
    <bpmn:sequenceFlow id="SequenceFlow_Presentation" sourceRef="Task_Analysis" targetRef="Task_Presentation"/>
    <bpmn:sequenceFlow id="SequenceFlow_SendOffers" sourceRef="Task_Presentation" targetRef="Task_SendOffers"/>
    <bpmn:sequenceFlow id="SequenceFlow_InformResponses" sourceRef="Task_SendOffers" targetRef="Task_InformResponses"/>

    <!-- Cross-Lane Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_DetailedOfferStart" sourceRef="Task_InformResponses" targetRef="Task_DetailedOffer"/>

    <bpmn:sequenceFlow id="SequenceFlow_ClientDecision" name="Client Response Received" sourceRef="Task_DetailedOffer" targetRef="ExclusiveGateway_ClientDecision"/>

    <!-- Gateway Outgoing Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_AcceptPath" name="Accepts Offer" sourceRef="ExclusiveGateway_ClientDecision" targetRef="Task_PrepareContract">
      <bpmn:name>Client accepts offer</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_RejectPath" name="Offer Failed" sourceRef="ExclusiveGateway_ClientDecision" targetRef="Task_AnalyzeFailure">
      <bpmn:name>Client rejects offer</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Success Path Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_SignContract" sourceRef="Task_PrepareContract" targetRef="Task_SignContract"/>
    <bpmn:sequenceFlow id="SequenceFlow_ContractSignedEnd" name="Success" sourceRef="Task_SignContract" targetRef="EndEvent_ContractSigned"/>

    <!-- Failure Path Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_ImproveFutureStart" sourceRef="Task_AnalyzeFailure" targetRef="Task_ImproveFuture"/>
    <bpmn:sequenceFlow id="SequenceFlow_ProcessImprovedEnd" name="Analysis Complete" sourceRef="Task_ImproveFuture" targetRef="EndEvent_ProcessImproved"/>

  </bpmn:process>
</bpmn:definitions>