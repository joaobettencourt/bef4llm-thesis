<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_RegistrationProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_Registration">
    <bpmn:participant id="Participant_Registration" name="Customer Registration Process" processRef="Process_1" />
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_CustomerRegistration" name="Customer Registration System">
        <bpmn:name>Cashier Service Representative</bpmn:name>
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FillForm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_Checks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProductCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreditCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_JoinChecks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_DecisionCredit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Unsuccessful</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateDataset</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_Subprocesses</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DeviceProvision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegisterISP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_WelcomeJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendWelcomePackage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Success</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Registration Request">
      <bpmn:outgoing>SequenceFlow_FillForm</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Fill Form -->
    <bpmn:task id="Task_FillForm" name="Fill registration form">
      <bpmn:incoming>SequenceFlow_FillForm</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ChecksSplit</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway 1 (Checks) -->
    <bpmn:parallelGateway id="ParallelGateway_Checks" name="Check Availability &amp; Credit">
      <bpmn:incoming>SequenceFlow_ChecksSplit</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProductCheck</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CreditCheck</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Check Product Availability -->
    <bpmn:task id="Task_ProductCheck" name="Check product availability">
      <bpmn:incoming>SequenceFlow_ProductCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ChecksJoin</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Check Credit Rating -->
    <bpmn:task id="Task_CreditCheck" name="Check credit rating (Schufa)">
      <bpmn:incoming>SequenceFlow_CreditCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ChecksJoin</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway 2 (Join Checks) -->
    <bpmn:parallelGateway id="ParallelGateway_JoinChecks">
      <bpmn:incoming>SequenceFlow_ProductCheck</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_CreditCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DecisionCredit</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Exclusive Gateway (Decision) -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_DecisionCredit" name="Rating &gt; 9000?">
      <bpmn:incoming>SequenceFlow_DecisionCredit</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_UnsuccessfulPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SuccessfulPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flow to Unsuccessful End -->
    <bpmn:sequenceFlow id="SequenceFlow_UnsuccessfulPath" name="Yes (Unsuccessful)">
      <bpmn:sourceRef>ExclusiveGateway_DecisionCredit</bpmn:sourceRef>
      <bpmn:targetRef>EndEvent_Unsuccessful</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- End Event Unsuccessful -->
    <bpmn:endEvent id="EndEvent_Unsuccessful" name="Registration Unsuccessful">
      <bpmn:incoming>SequenceFlow_UnsuccessfulPath</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flow to Successful Path (Dataset Creation) -->
    <bpmn:sequenceFlow id="SequenceFlow_SuccessfulPath" name="No (&lt;= 9000)">
      <bpmn:sourceRef>ExclusiveGateway_DecisionCredit</bpmn:sourceRef>
      <bpmn:targetRef>Task_CreateDataset</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Task: Create Interim Dataset -->
    <bpmn:task id="Task_CreateDataset" name="Create interim customer dataset record">
      <bpmn:incoming>SequenceFlow_SuccessfulPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SubprocessesSplit</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway 3 (Sub-processes Split) -->
    <bpmn:parallelGateway id="ParallelGateway_Subprocesses" name="Start Sub-processes">
      <bpmn:incoming>SequenceFlow_SubprocessesSplit</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DeviceProvisionPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RegisterISPPart</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Device Provision -->
    <bpmn:task id="Task_DeviceProvision" name="Device provision">
      <bpmn:incoming>SequenceFlow_DeviceProvisionPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WelcomeJoin</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Register Customer Account at ISP Nodes -->
    <bpmn:task id="Task_RegisterISP" name="Register customer account at ISP nodes">
      <bpmn:incoming>SequenceFlow_RegisterISPPart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WelcomeJoin</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway 4 (Welcome Join) -->
    <bpmn:parallelGateway id="ParallelGateway_WelcomeJoin">
      <bpmn:incoming>SequenceFlow_DeviceProvisionPath</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_RegisterISPPart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendPackagePath</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Sequence Flow to Send Package -->
    <bpmn:sequenceFlow id="SequenceFlow_SendPackagePath" name="All sub-processes finished">
      <bpmn:sourceRef>ParallelGateway_WelcomeJoin</bpmn:sourceRef>
      <bpmn:targetRef>Task_SendWelcomePackage</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Task: Create and Send Welcome Package -->
    <bpmn:task id="Task_SendWelcomePackage" name="Create &amp; send welcome package">
      <bpmn:incoming>SequenceFlow_SendPackagePath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SuccessEnd</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow to Success End -->
    <bpmn:sequenceFlow id="SequenceFlow_SuccessEnd" name="Registration completed successfully">
      <bpmn:sourceRef>Task_SendWelcomePackage</bpmn:sourceRef>
      <bpmn:targetRef>EndEvent_Success</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- End Event Success -->
    <bpmn:endEvent id="EndEvent_Success" name="Process Completed">
      <bpmn:incoming>SequenceFlow_SuccessEnd</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>