<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="_NewClientProcess_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_NewClient_001">
    <bpmn:participant id="Participant_Organization_001" name="Organization Process" processRef="Process_NewClient_001" />
    <bpmn:participant id="Participant_Client_002" name="Potential Client" />
  </bpmn:collaboration>

  <bpmn:process id="Process_NewClient_001" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Marketing_001" name="Marketing Team">
        <bpmn:flowNodeRef>Task_AnalyzeMarket_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepPresentation_002</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_MergeOffers_003</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateThrowEvent_SendOffer_004</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformManagement_005</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Management_002" name="Management Team">
        <bpmn:flowNodeRef>StartEvent_NewClientsNeeded_006</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_SplitInitiation_007</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateCatchEvent_ResponseReceived_008</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_StartNegotiations_009</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_DecisionPoint_010</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateThrowEvent_SendDetailedOffer_011</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareContract_012</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SignContract_013</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ContractSigned_014</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateCatchEvent_DecisionReceived_015</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AnalyzeFailure_016</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ProcessImproved_017</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_NewClientsNeeded_006" name="New clients needed">
      <bpmn:outgoing>SequenceFlow_InitiateProcess_018</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Gateway 1 (Split) -->
    <bpmn:inclusiveGateway id="InclusiveGateway_SplitInitiation_007">
      <bpmn:incoming>SequenceFlow_InitiateProcess_018</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AnalyzeMarket_019</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PrepPresentation_020</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Task 1 -->
    <bpmn:task id="Task_AnalyzeMarket_001" name="Analyze market">
      <bpmn:incoming>SequenceFlow_AnalyzeMarket_019</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeOffers_021</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2 -->
    <bpmn:task id="Task_PrepPresentation_002" name="Prepare portfolio presentation">
      <bpmn:incoming>SequenceFlow_PrepPresentation_020</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeOffers_021</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2 (Merge) -->
    <bpmn:inclusiveGateway id="InclusiveGateway_MergeOffers_003">
      <bpmn:incoming>SequenceFlow_MergeOffers_021</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendOfferEvent_022</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Intermediate Throw Event (Message) -->
    <bpmn:intermediateThrowEvent id="IntermediateThrowEvent_SendOffer_004" name="Send offer">
      <bpmn:messageEventDefinition />
      <bpmn:incoming>SequenceFlow_SendOfferEvent_022</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitResponse_023</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <!-- Sequence Flow to Catch Event -->
    <bpmn:sequenceFlow id="SequenceFlow_WaitResponse_023" sourceRef="IntermediateThrowEvent_SendOffer_004" targetRef="Task_InformManagement_005">
      <bpmn:name>Wait for response</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Task 3 -->
    <bpmn:task id="Task_InformManagement_005" name="Inform management about responses">
      <bpmn:incoming>SequenceFlow_WaitResponse_023</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ManagementNegotiationStart_024</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow to Management Lane -->
    <bpmn:sequenceFlow id="SequenceFlow_ManagementNegotiationStart_024" sourceRef="Task_InformManagement_005" targetRef="IntermediateCatchEvent_ResponseReceived_008">
      <bpmn:name>Inform management</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Intermediate Catch Event (Message) -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_ResponseReceived_008" name="Response received">
      <bpmn:messageEventDefinition />
      <bpmn:incoming>SequenceFlow_ManagementNegotiationStart_024</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StartNegotiationsTask_025</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task 4 -->
    <bpmn:task id="Task_StartNegotiations_009" name="Start negotiations">
      <bpmn:incoming>SequenceFlow_StartNegotiationsTask_025</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendDetailedOfferEvent_026</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow to Throw Event -->
    <bpmn:sequenceFlow id="SequenceFlow_SendDetailedOfferEvent_026" sourceRef="Task_StartNegotiations_009" targetRef="IntermediateThrowEvent_SendDetailedOffer_011">
      <bpmn:name>Send detailed offer</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Intermediate Throw Event (Message) -->
    <bpmn:intermediateThrowEvent id="IntermediateThrowEvent_SendDetailedOffer_011" name="Send detailed offer">
      <bpmn:messageEventDefinition />
      <bpmn:incoming>SequenceFlow_SendDetailedOfferEvent_026</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitDecision_027</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <!-- Sequence Flow to Catch Event -->
    <bpmn:sequenceFlow id="SequenceFlow_WaitDecision_027" sourceRef="IntermediateThrowEvent_SendDetailedOffer_011" targetRef="Task_StartNegotiations_009">
      <bpmn:name>Wait for decision</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Intermediate Catch Event (Message) -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_DecisionReceived_015" name="Client decision">
      <bpmn:messageEventDefinition />
      <bpmn:incoming>SequenceFlow_WaitDecision_027</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GatewayDecider_028</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Gateway 3 (Exclusive) -->
    <bpmn:exclusiveGateway id="InclusiveGateway_DecisionPoint_010">
      <bpmn:incoming>SequenceFlow_GatewayDecider_028</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AcceptPath_029</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_FailPath_030</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flow to Accept Path -->
    <bpmn:sequenceFlow id="SequenceFlow_AcceptPath_029" name="Accept">
      <bpmn:sourceRef>InclusiveGateway_DecisionPoint_010</bpmn:sourceRef>
      <bpmn:targetRef>Task_PrepareContract_012</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Task 5 -->
    <bpmn:task id="Task_PrepareContract_012" name="Prepare contract">
      <bpmn:incoming>SequenceFlow_AcceptPath_029</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SignContract_031</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 6 -->
    <bpmn:task id="Task_SignContract_013" name="Sign contract">
      <bpmn:incoming>SequenceFlow_SignContract_031</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndSigned_032</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 1 -->
    <bpmn:endEvent id="EndEvent_ContractSigned_014" name="Contract signed">
      <bpmn:incoming>SequenceFlow_EndSigned_032</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flow to Fail Path -->
    <bpmn:sequenceFlow id="SequenceFlow_FailPath_030" name="Fail">
      <bpmn:sourceRef>InclusiveGateway_DecisionPoint_010</bpmn:sourceRef>
      <bpmn:targetRef>Task_AnalyzeFailure_016</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Task 7 -->
    <bpmn:task id="Task_AnalyzeFailure_016" name="Analyze reasons for failure">
      <bpmn:incoming>SequenceFlow_FailPath_030</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndImproved_033</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 2 -->
    <bpmn:endEvent id="EndEvent_ProcessImproved_017" name="Process improved">
      <bpmn:incoming>SequenceFlow_EndImproved_033</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Message Flows to Client Participant -->
    <bpmn:messageFlow id="MessageFlow_OfferToClient_034" sourceRef="IntermediateThrowEvent_SendOffer_004">
      <bpmn:name>Send Offer</bpmn:name>
      <bpmn:targetRef>Participant_Client_StartReceiveOffer_100</bpmn:targetRef>
    </bpmn:messageFlow>

    <bpmn:messageFlow id="MessageFlow_DecisionToOrg_035" sourceRef="IntermediateCatchEvent_ResponseReceived_008">
      <bpmn:name>Response Received</bpmn:name>
      <bpmn:targetRef>Participant_Client_StartReceiveOffer_100</bpmn:targetRef>
    </bpmn:messageFlow>

    <bpmn:messageFlow id="MessageFlow_DetailedOfferToClient_036" sourceRef="IntermediateThrowEvent_SendDetailedOffer_011">
      <bpmn:name>Detailed Offer</bpmn:name>
      <bpmn:targetRef>Participant_Client_StartReceiveDecision_200</bpmn:targetRef>
    </bpmn:messageFlow>

    <bpmn:messageFlow id="MessageFlow_DecisionToOrgDetailed_037" sourceRef="IntermediateCatchEvent_DecisionReceived_015">
      <bpmn:name>Client Decision</bpmn:name>
      <bpmn:targetRef>Participant_Client_StartReceiveDecision_200</bpmn:targetRef>
    </bpmn:messageFlow>

  </bpmn:process>

  <!-- Client Participant Elements (Implicit Start Events as Message Sinks) -->
  <bpmn:startEvent id="Participant_Client_StartReceiveOffer_100" name="Receive Offer">
     <bpmn:messageEventDefinition />
  </bpmn:startEvent>
  
  <bpmn:startEvent id="Participant_Client_StartReceiveDecision_200" name="Receive Decision">
    <bpmn:messageEventDefinition />
  </bpmn:startEvent>

</bpmn:definitions>