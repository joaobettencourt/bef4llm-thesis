<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="_CreditProcess_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_CreditReview_001">
    <bpmn:participant id="Participant_CreditCompany_001" name="Credit Company" processRef="Process_CreditReview_001" />
    <bpmn:participant id="Participant_Customer_002" name="Customer" />

    <!-- Message Flows -->
    <bpmn:messageFlow id="MessageFlow_StartInfo_001" sourceRef="Participant_Customer_002" targetRef="StartEvent_ReceiveInfo_001" />
    
    <bpmn:messageFlow id="MessageFlow_EndAccept_001" sourceRef="EndEvent_CreditAccepted_001" targetRef="Participant_Customer_002" />

    <bpmn:messageFlow id="MessageFlow_EndReject_001" sourceRef="EndEvent_CreditRejected_001" targetRef="Participant_Customer_002" />
  </bpmn:collaboration>

  <bpmn:process id="Process_CreditReview_001" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_ReceiveInfo_001" name="Credit Information Received">
      <bpmn:messageEventDefinition />
      <bpmn:outgoing>SequenceFlow_CollectInfo_001</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task -->
    <bpmn:task id="Task_CollectCreditInformation_001" name="Collect Credit Information">
      <bpmn:incoming>SequenceFlow_CollectInfo_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckAmount_001</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Check Amount -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_CheckAmount_001" name="Amount &gt; 1M$?">
      <bpmn:incoming>SequenceFlow_CheckAmount_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RequestApproval_Amount_001</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_AssessRisk_001</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 2: Assess Risk -->
    <bpmn:task id="Task_AssessCreditRisk_001" name="Assess Credit Risk">
      <bpmn:incoming>SequenceFlow_AssessRisk_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckRiskResult_001</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2: Check Risk -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_CheckRisk_001" name="Risk High?">
      <bpmn:incoming>SequenceFlow_CheckRiskResult_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RequestApproval_Risk_001</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_AcceptCredit_Direct_001</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Gateway 3: Merge Approval Paths -->
    <bpmn:inclusiveGateway id="InclusiveGateway_MergeApprovalPaths_001">
      <bpmn:incoming>SequenceFlow_RequestApproval_Amount_001</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_RequestApproval_Risk_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TaskRequestApproval_001</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Task 3: Request Approval -->
    <bpmn:task id="Task_RequestApproval_002" name="Request Approval">
      <bpmn:incoming>SequenceFlow_TaskRequestApproval_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ApprovalResultDecision_001</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 4: Approval Result -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_ApprovalResult_002" name="Approval Decision?">
      <bpmn:incoming>SequenceFlow_ApprovalResultDecision_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RejectCredit_Path_001</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_AcceptedFromApproval_001</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 4: Accept Credit -->
    <bpmn:task id="Task_AcceptCredit_002" name="Accept Credit">
      <bpmn:incoming>SequenceFlow_AcceptedFromApproval_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendEmailAccepted_001</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 5: Reject Credit -->
    <bpmn:task id="Task_RejectCredit_002" name="Reject Credit">
      <bpmn:incoming>SequenceFlow_RejectCredit_Path_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendEmailRejected_001</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 1 -->
    <bpmn:endEvent id="EndEvent_CreditAccepted_001" name="Credit Accepted">
      <bpmn:messageEventDefinition />
      <bpmn:incoming>SequenceFlow_SendEmailAccepted_001</bpmn:incoming>
    </bpmn:endEvent>

    <!-- End Event 2 -->
    <bpmn:endEvent id="EndEvent_CreditRejected_001" name="Credit Rejected">
      <bpmn:messageEventDefinition />
      <bpmn:incoming>SequenceFlow_SendEmailRejected_001</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    
    <!-- Start to Collect Info -->
    <bpmn:sequenceFlow id="SequenceFlow_CollectInfo_001" sourceRef="StartEvent_ReceiveInfo_001" targetRef="Task_CollectCreditInformation_001">
      <bpmn:name>Received</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Collect Info to Check Amount -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckAmount_001" sourceRef="Task_CollectCreditInformation_001" targetRef="ExclusiveGateway_CheckAmount_001">
      <bpmn:name>Info Collected</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Check Amount > 1M to Request Approval -->
    <bpmn:sequenceFlow id="SequenceFlow_RequestApproval_Amount_001" sourceRef="ExclusiveGateway_CheckAmount_001" targetRef="InclusiveGateway_MergeApprovalPaths_001">
      <bpmn:name>Yes (&gt; 1M$)</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Check Amount <= 1M to Assess Risk -->
    <bpmn:sequenceFlow id="SequenceFlow_AssessRisk_001" sourceRef="ExclusiveGateway_CheckAmount_001" targetRef="Task_AssessCreditRisk_001">
      <bpmn:name>No (&lt;= 1M$)</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Assess Risk to Check Risk Result -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckRiskResult_001" sourceRef="Task_AssessCreditRisk_001" targetRef="ExclusiveGateway_CheckRisk_001">
      <bpmn:name>Risk Assessed</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Risk High to Merge Approval Paths -->
    <bpmn:sequenceFlow id="SequenceFlow_RequestApproval_Risk_001" sourceRef="ExclusiveGateway_CheckRisk_001" targetRef="InclusiveGateway_MergeApprovalPaths_001">
      <bpmn:name>Yes (High Risk)</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Risk Low to Accept Credit -->
    <bpmn:sequenceFlow id="SequenceFlow_AcceptCredit_Direct_001" sourceRef="ExclusiveGateway_CheckRisk_001" targetRef="Task_AcceptCredit_002">
      <bpmn:name>No (Low Risk)</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Merge Approval Paths to Request Approval Task -->
    <bpmn:sequenceFlow id="SequenceFlow_TaskRequestApproval_001" sourceRef="InclusiveGateway_MergeApprovalPaths_001" targetRef="Task_RequestApproval_002">
      <bpmn:name>Proceed</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Request Approval to Decision -->
    <bpmn:sequenceFlow id="SequenceFlow_ApprovalResultDecision_001" sourceRef="Task_RequestApproval_002" targetRef="ExclusiveGateway_ApprovalResult_002">
      <bpmn:name>Request Sent</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Approval Rejected to Reject Credit -->
    <bpmn:sequenceFlow id="SequenceFlow_RejectCredit_Path_001" sourceRef="ExclusiveGateway_ApprovalResult_002" targetRef="Task_RejectCredit_002">
      <bpmn:name>Rejected</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Approval Accepted to Accept Credit -->
    <bpmn:sequenceFlow id="SequenceFlow_AcceptedFromApproval_001" sourceRef="ExclusiveGateway_ApprovalResult_002" targetRef="Task_AcceptCredit_002">
      <bpmn:name>Accepted</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Accept Credit to End Event -->
    <bpmn:sequenceFlow id="SequenceFlow_SendEmailAccepted_001" sourceRef="Task_AcceptCredit_002" targetRef="EndEvent_CreditAccepted_001">
      <bpmn:name>Email Sent</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Reject Credit to End Event -->
    <bpmn:sequenceFlow id="SequenceFlow_SendEmailRejected_001" sourceRef="Task_RejectCredit_002" targetRef="EndEvent_CreditRejected_001">
      <bpmn:name>Email Sent</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>