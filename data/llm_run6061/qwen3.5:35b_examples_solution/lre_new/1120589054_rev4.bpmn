<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="_OrderToCash_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_OrderToCash_001">
    <bpmn:participant id="Participant_OTC_001" name="Order to Cash Process" processRef="Process_OTC_001" />
  </bpmn:collaboration>

  <bpmn:process id="Process_OTC_001" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_OrderMgmt_001" name="Order Management">
        <bpmn:flowNodeRef>StartEvent_CustomerOrderReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProcessCustomerOrder</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Warehouse_001" name="Warehouse">
        <bpmn:flowNodeRef>Task_SendToWarehouse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DetermineParts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PartsMissing_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OrderMissingParts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_Gateway_AllPartsReady_001</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Production_001" name="Production">
        <bpmn:flowNodeRef>Task_StartProduction</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_QualityChecks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_QCPassed_001</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_CustomerOrderReceived" name="Customer Order Received">
      <bpmn:outgoing>SequenceFlow_StartToProcess</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1 -->
    <bpmn:task id="Task_ProcessCustomerOrder" name="Process Customer Order">
      <bpmn:incoming>SequenceFlow_StartToProcess</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProcessToSendWarehouse</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2 -->
    <bpmn:task id="Task_SendToWarehouse" name="Send to Warehouse">
      <bpmn:incoming>SequenceFlow_ProcessToSendWarehouse</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToDetermineParts</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3 -->
    <bpmn:task id="Task_DetermineParts" name="Determine Required Parts">
      <bpmn:incoming>SequenceFlow_ToDetermineParts</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PartsToGateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1 -->
    <bpmn:exclusiveGateway id="Gateway_PartsMissing_001" name="Parts Missing?">
      <bpmn:incoming>SequenceFlow_PartsToGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NoOrderNeeded</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_OrderMissing_001</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 4 -->
    <bpmn:task id="Task_OrderMissingParts" name="Order Missing Parts">
      <bpmn:incoming>SequenceFlow_OrderMissing_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToJoinAllReady</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2 (Merge) -->
    <bpmn:exclusiveGateway id="Join_Gateway_AllPartsReady_001" name="All Parts Ready">
      <bpmn:incoming>SequenceFlow_NoOrderNeeded</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ToJoinAllReady</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StartProduction_001</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 5 -->
    <bpmn:task id="Task_StartProduction" name="Start Production">
      <bpmn:incoming>SequenceFlow_StartProduction_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToQualityChecks</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 6 -->
    <bpmn:task id="Task_QualityChecks" name="Perform Quality Checks">
      <bpmn:incoming>SequenceFlow_ToQualityChecks</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckToGateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 3 -->
    <bpmn:exclusiveGateway id="Gateway_QCPassed_001" name="QC Passed?">
      <bpmn:incoming>SequenceFlow_CheckToGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PackagingPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 7 -->
    <bpmn:task id="Task_PackageAndLabel" name="Package and Label">
      <bpmn:incoming>SequenceFlow_PackagingPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReturnToWarehouse_001</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 8 -->
    <bpmn:task id="Task_ReturnStock" name="Return to Warehouse">
      <bpmn:incoming>SequenceFlow_ReturnToWarehouse_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InformSales_001</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 9 -->
    <bpmn:task id="Task_InformSales" name="Inform Sales Team">
      <bpmn:incoming>SequenceFlow_InformSales_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SellProduct_001</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 10 -->
    <bpmn:task id="Task_SellToCustomer" name="Sell Product to Customer">
      <bpmn:incoming>SequenceFlow_SellProduct_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToEndEvent</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_OrderCompleted" name="Order Completed">
      <bpmn:incoming>SequenceFlow_ToEndEvent</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToProcess" sourceRef="StartEvent_CustomerOrderReceived" targetRef="Task_ProcessCustomerOrder" />
    <bpmn:sequenceFlow id="SequenceFlow_ProcessToSendWarehouse" name="Send to Warehouse" sourceRef="Task_ProcessCustomerOrder" targetRef="Task_SendToWarehouse" />
    <bpmn:sequenceFlow id="SequenceFlow_ToDetermineParts" sourceRef="Task_SendToWarehouse" targetRef="Task_DetermineParts" />
    <bpmn:sequenceFlow id="SequenceFlow_PartsToGateway" name="Check Availability" sourceRef="Task_DetermineParts" targetRef="Gateway_PartsMissing_001" />
    
    <!-- Gateway 1 Outgoing -->
    <bpmn:sequenceFlow id="SequenceFlow_NoOrderNeeded" name="Yes (Available)" sourceRef="Gateway_PartsMissing_001" targetRef="Join_Gateway_AllPartsReady_001">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${parts_available}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    
    <!-- Gateway 2 Outgoing -->
    <bpmn:sequenceFlow id="SequenceFlow_OrderMissing_001" name="No (Order)" sourceRef="Gateway_PartsMissing_001" targetRef="Task_OrderMissingParts">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${parts_missing}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Gateway 2 Incoming -->
    <bpmn:sequenceFlow id="SequenceFlow_ToJoinAllReady" sourceRef="Task_OrderMissingParts" targetRef="Join_Gateway_AllPartsReady_001">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${parts_ordered}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Gateway 2 Outgoing -->
    <bpmn:sequenceFlow id="SequenceFlow_StartProduction_001" sourceRef="Join_Gateway_AllPartsReady_001" targetRef="Task_StartProduction">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${all_parts_ready}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Production Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_ToQualityChecks" sourceRef="Task_StartProduction" targetRef="Task_QualityChecks">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${production_finished}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- QC Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckToGateway" sourceRef="Task_QualityChecks" targetRef="Gateway_QCPassed_001">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${qc_completed}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- QC Decision -->
    <bpmn:sequenceFlow id="SequenceFlow_PackagingPath" name="Passed" sourceRef="Gateway_QCPassed_001" targetRef="Task_PackageAndLabel">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${qc_passed}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Packaging Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_ReturnToWarehouse_001" sourceRef="Task_PackageAndLabel" targetRef="Task_ReturnStock">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${packaged}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Return Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_InformSales_001" sourceRef="Task_ReturnStock" targetRef="Task_InformSales">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${in_warehouse}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Sales Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_SellProduct_001" sourceRef="Task_InformSales" targetRef="Task_SellToCustomer">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${sales_informed}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- End Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_ToEndEvent" sourceRef="Task_SellToCustomer" targetRef="EndEvent_OrderCompleted">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${sold}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>