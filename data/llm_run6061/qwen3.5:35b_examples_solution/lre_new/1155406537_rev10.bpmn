<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="_PayPalAccountCreation_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_PayPal_Account_001">
    <bpmn:participant id="Participant_PayPal_System_001" name="PayPal Account Creation Process" processRef="Process_PayPal_Account_001" />
  </bpmn:collaboration>

  <bpmn:message id="Message_AccountCreation">
    <bpmn:name>Account Creation Request</bpmn:name>
  </bpmn:message>

  <bpmn:process id="Process_PayPal_Account_001" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Client_User_001" name="PayPal Client User">
        <bpmn:flowNodeRef>StartEvent_CreateAccount_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DetermineType_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_AccountChoice_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectPersonal_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectPremium_002</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_MergeDetails_003</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterLoginDetails_004</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterPersonalContact_005</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DeclarePEPStatus_006</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ClickCreateAccount_007</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_System_PayPal_002" name="PayPal System">
        <bpmn:flowNodeRef>Ice_ReceiveRequest_009</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ValidateInputFields_010</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_InputValid_011</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ite_NotifyClient_012</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GenerateWelcomeEmail_013</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_AccountCreated_014</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_CreateAccount_001" name="Create PayPal Account">
      <bpmn:outgoing>SequenceFlow_StartToDetermineType_001</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1 -->
    <bpmn:userTask id="Task_DetermineType_001" name="Determine Account Type">
      <bpmn:incoming>SequenceFlow_StartToDetermineType_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TypeChoiceGw_002</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway 1 -->
    <bpmn:exclusiveGateway id="Gw_AccountChoice_001">
      <bpmn:incoming>SequenceFlow_TypeChoiceGw_002</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PersonalPath_003</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PremiumPath_004</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Tasks for Account Type Selection -->
    <bpmn:userTask id="Task_SelectPersonal_001" name="Select Personal Account">
      <bpmn:incoming>SequenceFlow_PersonalPath_003</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToMergeDetails_005</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_SelectPremium_002" name="Select Premium Account">
      <bpmn:incoming>SequenceFlow_PremiumPath_004</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToMergeDetails_006</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway 2 (Merge) -->
    <bpmn:exclusiveGateway id="Gw_MergeDetails_003">
      <bpmn:incoming>SequenceFlow_ToMergeDetails_005</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ToMergeDetails_006</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EnterLoginDetails_007</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Data Entry Tasks -->
    <bpmn:userTask id="Task_EnterLoginDetails_004" name="Enter Login Details (Email/Password)">
      <bpmn:incoming>SequenceFlow_EnterLoginDetails_007</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToPersonalContact_008</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_EnterPersonalContact_005" name="Enter Personal Details (Name/DOB/Tel/Address)">
      <bpmn:incoming>SequenceFlow_ToPersonalContact_008</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DeclarePEPStatus_009</bpmn:outgoing>
    </bpmn:userTask>

    <!-- PEP Declaration -->
    <bpmn:userTask id="Task_DeclarePEPStatus_006" name="Declare Politically Exposed Person Affiliation">
      <bpmn:incoming>SequenceFlow_DeclarePEPStatus_009</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ClickCreateAccount_010</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Submit Action -->
    <bpmn:userTask id="Task_ClickCreateAccount_007" name="Click Create Account Button">
      <bpmn:incoming>SequenceFlow_ClickCreateAccount_010</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendRequestToSystem_011</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Message Send (Client Side) -->
    <bpmn:intermediateThrowEvent id="Ite_SendRequest_008" name="Submit Account Details">
      <bpmn:messageEventDefinition />
      <bpmn:incoming>SequenceFlow_SendRequestToSystem_011</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SystemReceiveMessage_012</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <!-- Message Receive (System Side) -->
    <bpmn:intermediateCatchEvent id="Ice_ReceiveRequest_009" name="Account Request Received">
      <bpmn:messageEventDefinition />
      <bpmn:incoming>SequenceFlow_SystemReceiveMessage_012</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ValidateInputFields_013</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Validation Task -->
    <bpmn:userTask id="Task_ValidateInputFields_010" name="Validate Input Fields">
      <bpmn:incoming>SequenceFlow_ValidateInputFields_013</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckValidityGw_014</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Validation Gateway -->
    <bpmn:exclusiveGateway id="Gw_InputValid_011">
      <bpmn:incoming>SequenceFlow_CheckValidityGw_014</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ValidPath_015</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_InvalidPath_016</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Error Handling Path -->
    <bpmn:intermediateThrowEvent id="Ite_NotifyClient_012" name="Notify Client of Invalid Fields">
      <bpmn:messageEventDefinition />
      <bpmn:incoming>SequenceFlow_InvalidPath_016</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ClientCorrectDetailsLoop_017</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <!-- Loop Back -->
    <bpmn:userTask id="Task_EnterLoginDetails_Loop" name="Enter Login Details (Correction)">
      <bpmn:incoming>SequenceFlow_ClientCorrectDetailsLoop_017</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToPersonalContact_Correction</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Success Path -->
    <bpmn:userTask id="Task_GenerateWelcomeEmail_013" name="Generate Welcome Email">
      <bpmn:incoming>SequenceFlow_ValidPath_015</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendToEndEvent_018</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_AccountCreated_014" name="Account Created">
      <bpmn:incoming>SequenceFlow_SendToEndEvent_018</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToDetermineType_001" sourceRef="StartEvent_CreateAccount_001" targetRef="Task_DetermineType_001" />
    <bpmn:sequenceFlow id="SequenceFlow_TypeChoiceGw_002" sourceRef="Task_DetermineType_001" targetRef="Gw_AccountChoice_001" />
    <bpmn:sequenceFlow id="SequenceFlow_PersonalPath_003" name="Personal Account" sourceRef="Gw_AccountChoice_001" targetRef="Task_SelectPersonal_001" />
    <bpmn:sequenceFlow id="SequenceFlow_PremiumPath_004" name="Premium Account" sourceRef="Gw_AccountChoice_001" targetRef="Task_SelectPremium_002" />
    <bpmn:sequenceFlow id="SequenceFlow_ToMergeDetails_005" sourceRef="Task_SelectPersonal_001" targetRef="Gw_MergeDetails_003" />
    <bpmn:sequenceFlow id="SequenceFlow_ToMergeDetails_006" sourceRef="Task_SelectPremium_002" targetRef="Gw_MergeDetails_003" />
    <bpmn:sequenceFlow id="SequenceFlow_EnterLoginDetails_007" sourceRef="Gw_MergeDetails_003" targetRef="Task_EnterLoginDetails_004" />
    <bpmn:sequenceFlow id="SequenceFlow_ToPersonalContact_008" sourceRef="Task_EnterLoginDetails_004" targetRef="Task_EnterPersonalContact_005" />
    <bpmn:sequenceFlow id="SequenceFlow_DeclarePEPStatus_009" sourceRef="Task_EnterPersonalContact_005" targetRef="Task_DeclarePEPStatus_006" />
    <bpmn:sequenceFlow id="SequenceFlow_ClickCreateAccount_010" sourceRef="Task_DeclarePEPStatus_006" targetRef="Task_ClickCreateAccount_007" />
    <bpmn:sequenceFlow id="SequenceFlow_SendRequestToSystem_011" sourceRef="Task_ClickCreateAccount_007" targetRef="Ite_SendRequest_008" />
    <bpmn:messageFlow id="MessageFlow_AccountCreation_001">
      <bpmn:sourceRef>Ite_SendRequest_008</bpmn:sourceRef>
      <bpmn:targetRef>Ice_ReceiveRequest_009</bpmn:targetRef>
    </bpmn:messageFlow>
    <bpmn:sequenceFlow id="SequenceFlow_SystemReceiveMessage_012" sourceRef="Ite_SendRequest_008" targetRef="Ice_ReceiveRequest_009">
      <bpmn:name>Submit Account Details</bpmn:name>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_ValidateInputFields_013" sourceRef="Ice_ReceiveRequest_009" targetRef="Task_ValidateInputFields_010" />
    <bpmn:sequenceFlow id="SequenceFlow_CheckValidityGw_014" sourceRef="Task_ValidateInputFields_010" targetRef="Gw_InputValid_011" />
    <bpmn:sequenceFlow id="SequenceFlow_ValidPath_015" name="Valid Input Fields" sourceRef="Gw_InputValid_011" targetRef="Task_GenerateWelcomeEmail_013" />
    <bpmn:sequenceFlow id="SequenceFlow_InvalidPath_016" name="Invalid Input Fields" sourceRef="Gw_InputValid_011" targetRef="Ite_NotifyClient_012" />
    <bpmn:sequenceFlow id="SequenceFlow_ClientCorrectDetailsLoop_017" name="Correct Details" sourceRef="Ite_NotifyClient_012" targetRef="Task_EnterLoginDetails_Loop">
      <bpmn:name>Correct Details</bpmn:name>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_ToPersonalContact_Correction" sourceRef="Task_EnterLoginDetails_Loop" targetRef="Gw_MergeDetails_003" />
    <bpmn:sequenceFlow id="SequenceFlow_SendToEndEvent_018" sourceRef="Task_GenerateWelcomeEmail_013" targetRef="EndEvent_AccountCreated_014" />

  </bpmn:process>
</bpmn:definitions>