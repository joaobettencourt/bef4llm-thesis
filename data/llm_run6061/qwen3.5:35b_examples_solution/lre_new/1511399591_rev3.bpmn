<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="_AddFeedbackModule_Definitions_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="_Collab_AddFeedback_001">
    <bpmn:participant id="_Participant_AddFeedback_001" name="Add customer feedback module to the website&#10;" processRef="_Process_AddFeedback_001"/>
  </bpmn:collaboration>

  <bpmn:process id="_Process_AddFeedback_001" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="_Lane_BusinessAnalyst_001" name="Business Analyst&#10;">
        <bpmn:flowNodeRef>_StartEvent_AppReceived_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Task_CollectDataAnalysis_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_CatchEvent_DesignComplete_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Task_CheckDesignFeedback_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Gateway_DesignDecision_001</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="_Lane_WebDesigner_002" name="Web Designer&#10;">
        <bpmn:flowNodeRef>_Task_IntegrateDesignModule_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Task_ChangeDesign_001</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="_Lane_PHPHTMLCSSSpecialist_003" name="PHP/HTML/CSS Specialist&#10;">
        <bpmn:flowNodeRef>_Task_IntegrateImplementation_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Task_AdjustAccordingToTestResults_001</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="_Lane_Tester_004" name="Tester">
        <bpmn:flowNodeRef>_Gateway_TestDecision_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Task_TestFinalWebsite_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_EndEvent_ProcessEnded_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Task_ProvideTestResults_001</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="_StartEvent_AppReceived_001" name="Application Received">
      <bpmn:outgoing>_SequenceFlow_StartToCollectData_001</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1 -->
    <bpmn:task id="_Task_CollectDataAnalysis_001" name="Collect data conduct business analysis regarding customer feedback">
      <bpmn:incoming>_SequenceFlow_StartToCollectData_001</bpmn:incoming>
      <bpmn:outgoing>_SequenceFlow_AnalysisToIntegrateDesign_001</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2 -->
    <bpmn:task id="_Task_IntegrateDesignModule_001" name="Integrate Design and decide where customer feedback module should be placed">
      <bpmn:incoming>_SequenceFlow_AnalysisToIntegrateDesign_001</bpmn:incoming>
      <bpmn:outgoing>_SequenceFlow_IntegrateToCatchEvent_001</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Catch Event -->
    <bpmn:intermediateCatchEvent id="_CatchEvent_DesignComplete_001" name="Design complete">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>_SequenceFlow_IntegrateToCatchEvent_001</bpmn:incoming>
      <bpmn:outgoing>_SequenceFlow_CatchToCheckDesign_001</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task 3 -->
    <bpmn:task id="_Task_CheckDesignFeedback_001" name="Check design and provide feedback">
      <bpmn:incoming>_SequenceFlow_CatchToCheckDesign_001</bpmn:incoming>
      <bpmn:outgoing>_SequenceFlow_CheckToDecisionGateway_001</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1 -->
    <bpmn:exclusiveGateway id="_Gateway_DesignDecision_001">
      <bpmn:incoming>_SequenceFlow_CheckToDecisionGateway_001</bpmn:incoming>
      <bpmn:outgoing>_SequenceFlow_DecisionOKToIntegrateImpl_001</bpmn:outgoing>
      <bpmn:outgoing>_SequenceFlow_DecisionAdjust_ChangeDesign_001</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 4 (Loop Back) -->
    <bpmn:task id="_Task_ChangeDesign_001" name="Change design">
      <bpmn:incoming>_SequenceFlow_DecisionAdjust_ChangeDesign_001</bpmn:incoming>
      <bpmn:outgoing>_SequenceFlow_ChangeToIntegrateAgain_001</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 5 -->
    <bpmn:task id="_Task_IntegrateImplementation_001" name="Integrate with the overall implementation">
      <bpmn:incoming>_SequenceFlow_DecisionOKToIntegrateImpl_001</bpmn:incoming>
      <bpmn:incoming>_SequenceFlow_ChangeToIntegrateAgain_001</bpmn:incoming>
      <bpmn:outgoing>_SequenceFlow_IntegrateToTest_001</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 6 -->
    <bpmn:task id="_Task_TestFinalWebsite_001" name="Test the final website to make sure everything is going well">
      <bpmn:incoming>_SequenceFlow_IntegrateToTest_001</bpmn:incoming>
      <bpmn:outgoing>_SequenceFlow_TestToDecisionGateway_001</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2 -->
    <bpmn:exclusiveGateway id="_Gateway_TestDecision_001">
      <bpmn:incoming>_SequenceFlow_TestToDecisionGateway_001</bpmn:incoming>
      <bpmn:outgoing>_SequenceFlow_DecisionOK_EndProcess_001</bpmn:outgoing>
      <bpmn:outgoing>_SequenceFlow_DecisionFail_ProvideResults_001</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 7 -->
    <bpmn:task id="_Task_ProvideTestResults_001" name="Provide test results">
      <bpmn:incoming>_SequenceFlow_DecisionFail_ProvideResults_001</bpmn:incoming>
      <bpmn:outgoing>_SequenceFlow_ProvideResults_ToAdjust_001</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 8 -->
    <bpmn:task id="_Task_AdjustAccordingToTestResults_001" name="Adjust according to test results">
      <bpmn:incoming>_SequenceFlow_ProvideResults_ToAdjust_001</bpmn:incoming>
      <bpmn:outgoing>_SequenceFlow_AdjustToIntegrateAgain_001</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="_EndEvent_ProcessEnded_001" name="Process Ended">
      <bpmn:incoming>_SequenceFlow_DecisionOK_EndProcess_001</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="_SequenceFlow_StartToCollectData_001" sourceRef="_StartEvent_AppReceived_001" targetRef="_Task_CollectDataAnalysis_001"/>
    <bpmn:sequenceFlow id="_SequenceFlow_AnalysisToIntegrateDesign_001" sourceRef="_Task_CollectDataAnalysis_001" targetRef="_Task_IntegrateDesignModule_001"/>
    <bpmn:sequenceFlow id="_SequenceFlow_IntegrateToCatchEvent_001" sourceRef="_Task_IntegrateDesignModule_001" targetRef="_CatchEvent_DesignComplete_001"/>
    <bpmn:sequenceFlow id="_SequenceFlow_CatchToCheckDesign_001" sourceRef="_CatchEvent_DesignComplete_001" targetRef="_Task_CheckDesignFeedback_001"/>
    <bpmn:sequenceFlow id="_SequenceFlow_CheckToDecisionGateway_001" sourceRef="_Task_CheckDesignFeedback_001" targetRef="_Gateway_DesignDecision_001"/>
    <bpmn:sequenceFlow id="_SequenceFlow_DecisionOKToIntegrateImpl_001" name="Design OK&#10;" sourceRef="_Gateway_DesignDecision_001" targetRef="_Task_IntegrateImplementation_001"/>
    <bpmn:sequenceFlow id="_SequenceFlow_DecisionAdjust_ChangeDesign_001" name="Need adjustments&#10;" sourceRef="_Gateway_DesignDecision_001" targetRef="_Task_ChangeDesign_001"/>
    <bpmn:sequenceFlow id="_SequenceFlow_ChangeToIntegrateAgain_001" sourceRef="_Task_ChangeDesign_001" targetRef="_Task_IntegrateImplementation_001"/>
    <bpmn:sequenceFlow id="_SequenceFlow_IntegrateToTest_001" sourceRef="_Task_IntegrateImplementation_001" targetRef="_Task_TestFinalWebsite_001"/>
    <bpmn:sequenceFlow id="_SequenceFlow_TestToDecisionGateway_001" sourceRef="_Task_TestFinalWebsite_001" targetRef="_Gateway_TestDecision_001"/>
    <bpmn:sequenceFlow id="_SequenceFlow_DecisionOK_EndProcess_001" name="Test OK&#10;" sourceRef="_Gateway_TestDecision_001" targetRef="_EndEvent_ProcessEnded_001"/>
    <bpmn:sequenceFlow id="_SequenceFlow_DecisionFail_ProvideResults_001" name="Not OK&#10;" sourceRef="_Gateway_TestDecision_001" targetRef="_Task_ProvideTestResults_001"/>
    <bpmn:sequenceFlow id="_SequenceFlow_ProvideResults_ToAdjust_001" sourceRef="_Task_ProvideTestResults_001" targetRef="_Task_AdjustAccordingToTestResults_001"/>
    <bpmn:sequenceFlow id="_SequenceFlow_AdjustToIntegrateAgain_001" sourceRef="_Task_AdjustAccordingToTestResults_001" targetRef="_Task_IntegrateImplementation_001"/>

  </bpmn:process>
</bpmn:definitions>