<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_PaymentProcess_001">
    <bpmn:participant id="Participant_SSP_001" name="SSP Payment Office" processRef="Process_Payment_001" />
    <bpmn:participant id="Participant_Client_002" name="Client" />
  </bpmn:collaboration>

  <bpmn:process id="Process_Payment_001" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_PaymentOffice_001" name="Payment Office of SSP">
        <bpmn:flowNodeRef>StartEvent_WeeklyCycle_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GenerateReport_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PayVendor_002</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_DistributeReports_003</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AccountsReceivable_002" name="Accounts Receivable Department">
        <bpmn:flowNodeRef>InclusiveGateway_DecisionPoint_AR_004</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GenerateMonthlyInvoice_005</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ChargeClientFee_006</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_RegistryOffice_003" name="Registry Office">
        <bpmn:flowNodeRef>InclusiveGateway_DecisionPoint_Reg_007</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectPaidInvoices_008</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ArchivePerVendor_009</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TrackPayments_010</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_WeeklyCycle_001" name="End of Week">
      <bpmn:outgoing>SequenceFlow_StartToReportGen_001</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Payment Office Tasks -->
    <bpmn:task id="Task_GenerateReport_001" name="Generate Payment Report">
      <bpmn:incoming>SequenceFlow_StartToReportGen_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReportToPayVendor_002</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_PayVendor_002" name="Pay the Vendor">
      <bpmn:incoming>SequenceFlow_ReportToPayVendor_002</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_VendorPaidToDistribute_003</bpmn:outgoing>
    </bpmn:task>

    <!-- Inclusive Gateway for Report Distribution -->
    <bpmn:inclusiveGateway id="InclusiveGateway_DistributeReports_003">
      <bpmn:incoming>SequenceFlow_VendorPaidToDistribute_003</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToAccountsReceivable_004</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ToRegistryOffice_005</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Accounts Receivable Department Tasks -->
    <bpmn:task id="Task_GenerateMonthlyInvoice_005" name="Generate Monthly Invoice for Clients">
      <bpmn:incoming>SequenceFlow_ToAccountsReceivable_004</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InvoiceToChargeFee_006</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_ChargeClientFee_006" name="Charge $35 per Invoice and Notify Client">
      <bpmn:incoming>SequenceFlow_InvoiceToChargeFee_006</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FeeChargedEndAR_007</bpmn:outgoing>
    </bpmn:task>

    <!-- Registry Office Tasks -->
    <bpmn:exclusiveGateway id="InclusiveGateway_DecisionPoint_Reg_007">
      <bpmn:incoming>SequenceFlow_ToRegistryOffice_005</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SelectPaidToArchive_008</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_SelectPaidInvoices_008" name="Select Paper-Based Paid Invoices">
      <bpmn:incoming>SequenceFlow_ToRegistryOffice_005</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PaidToArchivePerVendor_009</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_ArchivePerVendor_009" name="Archive Invoices per Vendor">
      <bpmn:incoming>SequenceFlow_PaidToArchivePerVendor_009</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_VendorArchivedEndReg_010</bpmn:outgoing>
    </bpmn:task>

    <!-- End Events -->
    <bpmn:endEvent id="End_AR_Process_007">
      <bpmn:incoming>SequenceFlow_FeeChargedEndAR_007</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="End_Reg_ArchivePerVendor_010">
      <bpmn:incoming>SequenceFlow_VendorArchivedEndReg_010</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Message Flow to Client -->
    <bpmn:message id="Message_PaymentInvoice_001" name="Payment Invoice">
      <bpmn:name>Payment Invoice with Report</bpmn:name>
    </bpmn:message>

  </bpmn:process>

  <!-- Message Flows -->
  <bpmn:messageFlow id="MessageFlow_ClientNotification_001" sourceRef="Task_ChargeClientFee_006" targetRef="Participant_Client_002">
    <bpmn:name>Charge $35 per invoice and notify client</bpmn:name>
  </bpmn:messageFlow>

  <!-- Data Objects -->
  <bpmn:dataObject id="Data_PaymentReport_001" name="Payment Report" />
  <bpmn:dataObject id="Data_MonthlyInvoice_002" name="Monthly Invoice" />

</bpmn:definitions>