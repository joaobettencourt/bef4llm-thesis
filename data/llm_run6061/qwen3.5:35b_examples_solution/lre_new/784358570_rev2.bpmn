<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_OrderDelivery_001">
    <bpmn:participant id="Participant_EshopStaff_001" name="E-shop Staff" processRef="Process_OrderReview_001" />
    <bpmn:participant id="Participant_CourierCompany_002" name="Courier Company" processRef="Process_Delivery_002" />
  </bpmn:collaboration>

  <bpmn:process id="Process_OrderReview_001" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_EshopStaff_001" name="E-shop Staff">
        <bpmn:flowNodeRef>StartEvent_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_CheckItemsAvailable_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_ItemsCheck_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_InformDelay_002</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_ItemStatus_002</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_InformUnavailable_003</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_OrderMissingItems_004</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateThrowEvent_WaitDelivery_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_CheckProductsStore_005</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_ProductsOK_003</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_RecollectItems_006</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_PreparePackage_007</bpmn:flowNodeRef>
      </bpmn:laneSet>

      <!-- Start Event -->
      <bpmn:startEvent id="StartEvent_001" name="Review Order">
        <bpmn:outgoing>SequenceFlow_StartToCheckItems_001</bpmn:outgoing>
      </bpmn:startEvent>

      <!-- Task 1 -->
      <bpmn:userTask id="UserTask_CheckItemsAvailable_001" name="Check if all requested items are available">
        <bpmn:incoming>SequenceFlow_StartToCheckItems_001</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow_ItemsCheckGateway_002</bpmn:outgoing>
      </bpmn:userTask>

      <!-- Gateway 1 -->
      <bpmn:exclusiveGateway id="ExclusiveGateway_ItemsCheck_001">
        <bpmn:incoming>SequenceFlow_ItemsCheckGateway_002</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow_ItemsOKToWait_003</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow_MissingItemsPath_004</bpmn:outgoing>
      </bpmn:exclusiveGateway>

      <!-- Task 2 -->
      <bpmn:userTask id="UserTask_InformDelay_002" name="Inform customer about potential delay">
        <bpmn:incoming>SequenceFlow_MissingItemsPath_004</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow_DelayToItemStatus_005</bpmn:outgoing>
      </bpmn:userTask>

      <!-- Gateway 2 -->
      <bpmn:exclusiveGateway id="ExclusiveGateway_ItemStatus_002">
        <bpmn:incoming>SequenceFlow_DelayToItemStatus_005</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow_DiscontinuedPath_006</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow_MissingOrderingPath_007</bpmn:outgoing>
      </bpmn:exclusiveGateway>

      <!-- Task 3 -->
      <bpmn:userTask id="UserTask_InformUnavailable_003" name="Inform customer about unavailable items">
        <bpmn:incoming>SequenceFlow_DiscontinuedPath_006</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow_UnavailableToWait_008</bpmn:outgoing>
      </bpmn:userTask>

      <!-- Task 4 -->
      <bpmn:userTask id="UserTask_OrderMissingItems_004" name="Order missing products from supplier">
        <bpmn:incoming>SequenceFlow_MissingOrderingPath_007</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow_OrderedToWait_009</bpmn:outgoing>
      </bpmn:userTask>

      <!-- Intermediate Throw Event -->
      <bpmn:intermediateThrowEvent id="IntermediateThrowEvent_WaitDelivery_001" name="x days - supplier delivery time">
        <bpmn:incoming>SequenceFlow_UnavailableToWait_008</bpmn:outgoing>
        <bpmn:incoming>SequenceFlow_OrderedToWait_009</bpmn:outgoing>
      </bpmn:intermediateThrowEvent>

      <!-- Task 5 -->
      <bpmn:userTask id="UserTask_CheckProductsStore_005" name="Check if all products are on store">
        <bpmn:incoming>SequenceFlow_WaitToCheckStore_010</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow_StoreCheckGateway_011</bpmn:outgoing>
      </bpmn:userTask>

      <!-- Gateway 3 -->
      <bpmn:exclusiveGateway id="ExclusiveGateway_ProductsOK_003">
        <bpmn:incoming>SequenceFlow_StoreCheckGateway_011</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow_ItemsReadyToRecollect_012</bpmn:outgoing>
      </bpmn:exclusiveGateway>

      <!-- Task 6 -->
      <bpmn:userTask id="UserTask_RecollectItems_006" name="Recollect all products">
        <bpmn:incoming>SequenceFlow_ItemsReadyToRecollect_012</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow_RecollectedToPackage_013</bpmn:outgoing>
      </bpmn:userTask>

      <!-- Task 7 -->
      <bpmn:userTask id="UserTask_PreparePackage_007" name="Prepare package">
        <bpmn:incoming>SequenceFlow_RecollectedToPackage_013</bpmn:outgoing>
        <bpmn:outgoing>MessageFlow_InformCourier_002</bpmn:outgoing>
      </bpmn:userTask>

    </bpmn:process>

  <!-- Courier Company Process -->
  <bpmn:process id="Process_Delivery_002" isExecutable="false">
    <bpmn:laneSet>
      <bmm:bpmn:lane id="Lane_CourierCompany_001" name="Courier Company">
        <bpmn:flowNodeRef>CatchEvent_StartDelivery_003</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_InformClientDelay_008</bpmn:flowNodeRef>
        <bmm:bpmn:exclusiveGateway id="ExclusiveGateway_HumanResourcesCheck_004">
          <bpmn:incoming>SequenceFlow_DelayToResourceCheck_015</bpmn:outgoing>
          <bpmn:outgoing>SequenceFlow_EngoughDriversYesPath_016</bmm:bpmn:outgoing>
          <bpmn:outgoing>SequenceFlow_NotEnoughDriversNoPath_017</bmm:bpmn:outgoing>
        </bmm:bpmn:exclusiveGateway>
        <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_WaitDriver_002" name="Wait for free driver">
          <bpmn:timerEventDefinition />
          <bpmn:incoming>SequenceFlow_NotEnoughDriversNoPath_017</bmm:bpmn:outgoing>
        </bpmn:intermediateCatchEvent>
        <bpmn:userTask id="UserTask_PickupPackage_009" name="Pick up package by driver">
          <bpmn:incoming>SequenceFlow_EngoughDriversYesPath_016</bmm:bpmn:outgoing>
          <bpmn:incoming>SequenceFlow_WaitDriverToPickup_018</bmm:bpmn:outgoing>
        </bpmn:userTask>
        <bpmn:serviceTask id="ServiceTask_DecideRoute_005" name="Decide best route for all packages">
          <bpmn:incoming>SequenceFlow_PickupToDecideRoute_019</bmm:bpmn:outgoing>
          <bpmn:outgoing>SequenceFlow_RouteDecidedToDeliver_020</bmm:bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:userTask id="UserTask_DeliverPackage_010" name="Deliver package to customer">
          <bpmn:incoming>SequenceFlow_RouteDecidedToDeliver_020</bmm:bpmn:outgoing>
          <bpmn:outgoing>SequenceFlow_DeliveryCompleteToUpdateSystem_021</bmm:bpmn:outgoing>
        </bpmn:userTask>
        <bpmn:userTask id="UserTask_UpdateSystem_011" name="Update system - notify stakeholders">
          <bpmn:incoming>SequenceFlow_DeliveryCompleteToUpdateSystem_021</bmm:bpmn:outgoing>
          <bpmn:messageEventDefinition />
        </bpmn:userTask>
      </bmm:bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="CatchEvent_StartDelivery_003" name="Customer wants delivery">
      <bpmn:messageEventDefinition />
      <bpmn:outgoing>SequenceFlow_StartToInformDelayCheck_022</bmm:bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 8 -->
    <bpmn:userTask id="UserTask_InformClientDelay_008" name="Inform client about potential delay">
      <bpmn:incoming>SequenceFlow_StartToInformDelayCheck_022</bmm:bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_DelayInfoToResourcesCheck_015</bmm:bpmn:outgoing>
    </bpmn:userTask>

  <!-- Gateway 4 -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_HumanResourcesCheck_004">
      <bpmn:incoming>SequenceFlow_DelayInfoToResourcesCheck_015</bmm:bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_EngoughDriversYesPath_016</bmm:bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NotEnoughDriversNoPath_017</bmm:bpmn:outgoing>
    </bpmn:exclusiveGateway>

  <!-- Intermediate Catch Event -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_WaitDriver_002" name="Wait for free driver">
      <bpmn:timerEventDefinition />
      <bpmn:incoming>SequenceFlow_NotEnoughDriversNoPath_017</bmm:bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

  <!-- Task 9 -->
    <bpmn:userTask id="UserTask_PickupPackage_009" name="Pick up package by driver">
      <bpmn:incoming>SequenceFlow_EngoughDriversYesPath_016</bmm:bpmn:outgoing>
      <bpmn:incoming>SequenceFlow_WaitDriverToPickup_018</bmm:bpmn:outgoing>
    </bpmn:userTask>

  <!-- Task 10 -->
    <bpmn:serviceTask id="ServiceTask_DecideRoute_005" name="Decide best route for all packages">
      <bpmn:incoming>SequenceFlow_PickupToDecideRoute_019</bmm:bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RouteDecidedToDeliver_020</bmm:bpmn:outgoing>
    </bpmn:serviceTask>

  <!-- Task 11 -->
    <bpmn:userTask id="UserTask_DeliverPackage_010" name="Deliver package to customer">
      <bpmn:incoming>SequenceFlow_RouteDecidedToDeliver_020</bmm:bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_DeliveryCompleteToUpdateSystem_021</bmm:bpmn:outgoing>
    </bpmn:userTask>

  <!-- Task 12 -->
    <bpmn:userTask id="UserTask_UpdateSystem_011" name="Update system - notify stakeholders">
      <bpmn:incoming>SequenceFlow_DeliveryCompleteToUpdateSystem_021</bmm:bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:userTask>

  <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToInformDelayCheck_022" sourceRef="CatchEvent_StartDelivery_003" targetRef="UserTask_InformClientDelay_008">
      <bpmn:name>Customer delivery request</bmm:bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_DelayInfoToResourcesCheck_015" sourceRef="UserTask_InformClientDelay_008" targetRef="ExclusiveGateway_HumanResourcesCheck_004">
      <bmm:bpmn:name>Inform client</bmm:bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_EngoughDriversYesPath_016" sourceRef="ExclusiveGateway_HumanResourcesCheck_004" targetRef="UserTask_PickupPackage_009">
      <bmm:bpmn:name>Sufficient resources</bmm:bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_NotEnoughDriversNoPath_017" sourceRef="ExclusiveGateway_HumanResourcesCheck_004" targetRef="IntermediateCatchEvent_WaitDriver_002">
      <bmm:bpmn:name>Wait for resources</bmm:bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_WaitDriverToPickup_018" sourceRef="IntermediateCatchEvent_WaitDriver_002" targetRef="UserTask_PickupPackage_009">
      <bmm:bpmn:name>Resources available</bmm:bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_PickupToDecideRoute_019" sourceRef="UserTask_PickupPackage_009" targetRef="ServiceTask_DecideRoute_005">
      <bmm:bpmn:name>Packages collected</bmm:bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_RouteDecidedToDeliver_020" sourceRef="ServiceTask_DecideRoute_005" targetRef="UserTask_DeliverPackage_010">
      <bmm:bpmn:name>Best route decided</bmm:bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_DeliveryCompleteToUpdateSystem_021" sourceRef="UserTask_DeliverPackage_010" targetRef="UserTask_UpdateSystem_011">
      <bmm:bpmn:name>Delivery complete</bmm:bpmn:name>
    </bpmn:sequenceFlow>

  <!-- Message Flows -->
    <bpmn:messageFlow id="MessageFlow_InformCourier_002" sourceRef="UserTask_PreparePackage_007" targetRef="CatchEvent_StartDelivery_003">
      <bmm:bpmn:name>Courier informed about package</bmm:bpmn:name>
    </bpmn:messageFlow>

  <!-- Order Review Process Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToCheckItems_001" sourceRef="StartEvent_001" targetRef="UserTask_CheckItemsAvailable_001">
      <bmm:bpmn:name>Process starts</bmm:bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ItemsCheckGateway_002" sourceRef="UserTask_CheckItemsAvailable_001" targetRef="ExclusiveGateway_ItemsCheck_001">
      <bmm:bpmn:name>Check availability</bmm:bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ItemsOKToWait_003" sourceRef="ExclusiveGateway_ItemsCheck_001" targetRef="IntermediateThrowEvent_WaitDelivery_001">
      <bmm:bpmn:name>All items available</bmm:bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_MissingItemsPath_004" sourceRef="ExclusiveGateway_ItemsCheck_001" targetRef="UserTask_InformDelay_002">
      <bmm:bpmn:name>Items missing</bmm:bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_DelayToItemStatus_005" sourceRef="UserTask_InformDelay_002" targetRef="ExclusiveGateway_ItemStatus_002">
      <bmm:bpmn:name>Determine item status</bmm:bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_DiscontinuedPath_006" sourceRef="ExclusiveGateway_ItemStatus_002" targetRef="UserTask_InformUnavailable_003">
      <bmm:bpmn:name>Item discontinued</bmm:bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_MissingOrderingPath_007" sourceRef="ExclusiveGateway_ItemStatus_002" targetRef="UserTask_OrderMissingItems_004">
      <bmm:bpmn:name>Item available from supplier</bmm:bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_UnavailableToWait_008" sourceRef="UserTask_InformUnavailable_003" targetRef="IntermediateThrowEvent_WaitDelivery_001">
      <bmm:bpmn:name>Awaiting delivery</bmm:bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_OrderedToWait_009" sourceRef="UserTask_OrderMissingItems_004" targetRef="IntermediateThrowEvent_WaitDelivery_001">
      <bmm:bpmn:name>Awaiting delivery</bmm:bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_WaitToCheckStore_010" sourceRef="IntermediateThrowEvent_WaitDelivery_001" targetRef="UserTask_CheckProductsStore_005">
      <bmm:bpmn:name>x days passed</bmm:bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_StoreCheckGateway_011" sourceRef="UserTask_CheckProductsStore_005" targetRef="ExclusiveGateway_ProductsOK_003">
      <bmm:bpmn:name>All products on store</bmm:bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ItemsReadyToRecollect_012" sourceRef="ExclusiveGateway_ProductsOK_003" targetRef="UserTask_RecollectItems_006">
      <bmm:bpmn:name>All products OK</bmm:bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_RecollectedToPackage_013" sourceRef="UserTask_RecollectItems_006" targetRef="UserTask_PreparePackage_007">
      <bmm:bpmn:name>Packages ready</bmm:bpmn:name>
    </bpmn:sequenceFlow>

  <!-- End Event -->
    <bpmn:endEvent id="EndEvent_StakeholdersNotified_012" name="Stakeholders notified">
      <bpmn:messageEventDefinition />
      <bpmn:incoming>SequenceFlow_DeliveryCompleteToUpdateSystem_021</bmm:bpmn:outgoing>
    </bpmn:endEvent>

  </bpmn:process>

</bpmn:definitions>