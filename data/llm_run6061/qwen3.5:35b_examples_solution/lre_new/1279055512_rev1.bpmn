<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="_InvoiceProcess_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_Invoice_001">
    <bpmn:participant id="Pool_SSP_001" name="SSP" processRef="Process_Invoice_001" />
    <bpmn:participant id="Pool_Client_002" name="Client" />
  </bpmn:collaboration>

  <bpmn:process id="Process_Invoice_001" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_MailCentre_001" name="Mail Centre Office">
        <bpmn:flowNodeRef>StartEvent_Received_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Categorize_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ForwardAdmin_002</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateCatchEvent_HourlyReview_003</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AdminDept_002" name="Administration Department">
        <bpmn:flowNodeRef>SubProcess_ProcessInvoice_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PutInBox_003</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_DataEntry_003" name="Data Entry Office">
        <bpmn:flowNodeRef>IntermediateCatchEvent_TenAM_004</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_EnterSAP_002</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ValidationOffice_004" name="Validation Office">
        <bpmn:flowNodeRef>Task_ForwardValidate_005</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_ValidateInvoice_003</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PaymentOffice_005" name="Payment Office">
        <bpmn:flowNodeRef>IntermediateCatchEvent_StartWeek_006</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_ProcessPayment_004</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_RegistryOffice_006" name="Registry Office">
        <bpmn:flowNodeRef>Task_ArchiveInvoice_007</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Completed_001</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Received_001" name="Invoice Received">
      <bpmn:messageEventDefinition />
      <bpmn:outgoing>SequenceFlow_StartToCategorize_001</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Mail Centre Tasks -->
    <bpmn:task id="Task_Categorize_001" name="Categorize invoice by staff member">
      <bpmn:incoming>SequenceFlow_StartToCategorize_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CategorizeToForward_002</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_StartToCategorize_001" sourceRef="StartEvent_Received_001" targetRef="Task_Categorize_001" />
    
    <bpmn:task id="Task_ForwardAdmin_002" name="Forward invoice to Admin Department">
      <bpmn:incoming>SequenceFlow_CategorizeToForward_002</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FwdToProcessInvoice_003</bpmn:outgoing>
    </bpmn:task>

    <!-- Admin Dept Tasks -->
    <bpmn:subProcess id="SubProcess_ProcessInvoice_001" name="Process Invoice">
      <bpmn:incoming>SequenceFlow_FwdToProcessInvoice_003</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProcInvToBox_004</bpmn:outgoing>
    </bpmn:subProcess>

    <bpmn:task id="Task_PutInBox_003" name="Put invoices in collection box">
      <bpmn:incoming>SequenceFlow_ProcInvToBox_004</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BoxToTenAM_005</bpmn:outgoing>
    </bpmn:task>

    <!-- Data Entry Trigger (Timer) -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_TenAM_004" name="At 10 am workday">
      <bpmn:incoming>SequenceFlow_BoxToTenAM_005</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TenAMToSAP_006</bpmn:outgoing>
      <bpmn:timerEventDefinition />
    </bpmn:intermediateCatchEvent>

    <!-- Data Entry Task -->
    <bpmn:subProcess id="SubProcess_EnterSAP_002" name="Enter data in SAP system">
      <bpmn:incoming>SequenceFlow_TenAMToSAP_006</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SAPToHourlyReview_007</bpmn:outgoing>
    </bpmn:subProcess>

    <!-- Hourly Review Trigger -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_HourlyReview_003" name="Every hour">
      <bpmn:incoming>SequenceFlow_SAPToHourlyReview_007</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_HourlyForwardValidate_008</bpmn:outgoing>
      <bpmn:timerEventDefinition />
    </bpmn:intermediateCatchEvent>

    <!-- Validation Forward Task -->
    <bpmn:task id="Task_ForwardValidate_005" name="Forward invoice for validation">
      <bpmn:incoming>SequenceFlow_HourlyForwardValidate_008</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FwdToValidationSubProc_009</bpmn:outgoing>
    </bpmn:task>

    <!-- Validation SubProcess -->
    <bpmn:subProcess id="SubProcess_ValidateInvoice_003" name="Validate Invoice">
      <bpmn:incoming>SequenceFlow_FwdToValidationSubProc_009</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ValidToPaymentTimer_010</bpmn:outgoing>
    </bpmn:subProcess>

    <!-- Weekly Payment Trigger -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_StartWeek_006" name="Beginning of every week">
      <bpmn:incoming>SequenceFlow_ValidToPaymentTimer_010</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PaymentStart_011</bpmn:outgoing>
      <bpmn:timerEventDefinition />
    </bpmn:intermediateCatchEvent>

    <!-- Payment SubProcess -->
    <bpmn:subProcess id="SubProcess_ProcessPayment_004" name="Execute payment">
      <bpmn:incoming>SequenceFlow_PaymentStart_011</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PayToArchive_012</bpmn:outgoing>
    </bpmn:subProcess>

    <!-- Archive Task -->
    <bpmn:task id="Task_ArchiveInvoice_007" name="Archive invoice">
      <bpmn:incoming>SequenceFlow_PayToArchive_012</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ArchiveToEnd_013</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Completed_001" name="Invoice Process completed">
      <bpmn:incoming>SequenceFlow_ArchiveToEnd_013</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>