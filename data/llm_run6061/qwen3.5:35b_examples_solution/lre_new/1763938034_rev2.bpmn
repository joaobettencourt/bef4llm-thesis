<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="_RewardsAndTraining_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_Rewards_001">
    <bpmn:participant id="Participant_Rewards_001" name="Rewards and training" processRef="Process_Rewards_001" />
  </bpmn:collaboration>

  <bpmn:process id="Process_Rewards_001" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Management_001" name="Management">
        <bpmn:flowNodeRef>StartEvent_CheckPerf_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckPerformance_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_PerformanceCheck_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SuggestDismissal_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SuggestTraining_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SuggestReward_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_RewardType_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ChooseBenefit_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_MergeReward_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AnnounceMonth_001</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_HR_002" name="HR">
        <bpmn:flowNodeRef>Task_DismissEmployee_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProvideTraining_001</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Finance_003" name="Finance">
        <bpmn:flowNodeRef>Task_CalculateReward_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PayReward_001</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_CheckPerf_001" name="Check employee performance">
      <bpmn:outgoing>SeqFlow_StartToTask_001</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1 -->
    <bpmn:task id="Task_CheckPerformance_001" name="Check employee performance">
      <bpmn:incoming>SeqFlow_StartToTask_001</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_TaskToGwPerf_001</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1 -->
    <bpmn:exclusiveGateway id="Gw_PerformanceCheck_001">
      <bpmn:incoming>SeqFlow_TaskToGwPerf_001</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_GwDismissal_001</bpmn:outgoing>
      <bpmn:outgoing>SeqFlow_GwTraining_001</bpmn:outgoing>
      <bpmn:outgoing>SeqFlow_GwReward_001</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Path 1: Dismissal -->
    <bpmn:task id="Task_SuggestDismissal_001" name="Suggest employee dismissal">
      <bpmn:incoming>SeqFlow_GwDismissal_001</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_DismissToHR_001</bpmn:outgoing>
    </bpmn:task>

    <!-- Path 2: Training -->
    <bpmn:task id="Task_SuggestTraining_001" name="Suggest training">
      <bpmn:incoming>SeqFlow_GwTraining_001</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_TrainingToHR_001</bpmn:outgoing>
    </bpmn:task>

    <!-- Path 3: Reward -->
    <bpmn:task id="Task_SuggestReward_001" name="Suggest for reward">
      <bpmn:incoming>SeqFlow_GwReward_001</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_RewardToGwType_001</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2 -->
    <bpmn:exclusiveGateway id="Gw_RewardType_001">
      <bpmn:incoming>SeqFlow_RewardToGwType_001</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_FinancialReward_001</bpmn:outgoing>
      <bpmn:outgoing>SeqFlow_OtherBenefit_001</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Financial Reward Path -->
    <bpmn:task id="Task_CalculateReward_001" name="Calculate reward">
      <bpmn:incoming>SeqFlow_FinancialReward_001</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_PayToPay_001</bpmn:outgoing>
    </bpmn:task>

    <!-- Financial Reward Path -->
    <bpmn:task id="Task_PayReward_001" name="Pay reward">
      <bpmn:incoming>SeqFlow_PayToPay_001</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_FinanceMerge_001</bpmn:outgoing>
    </bpmn:task>

    <!-- Other Benefit Path -->
    <bpmn:task id="Task_ChooseBenefit_001" name="Choose appropriate benefit">
      <bpmn:incoming>SeqFlow_OtherBenefit_001</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_BenefitMerge_001</bpmn:outgoing>
    </bpmn:task>

    <!-- Merge Gateway -->
    <bpmn:exclusiveGateway id="Gw_MergeReward_001">
      <bpmn:incoming>SeqFlow_FinanceMerge_001</bpmn:incoming>
      <bpmn:incoming>SeqFlow_BenefitMerge_001</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_MergeToAnnounce_001</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- HR Tasks -->
    <bpmn:task id="Task_DismissEmployee_001" name="Dismiss employee">
      <bpmn:incoming>SeqFlow_DismissToHR_001</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_HRDismissEnd_001</bpmn:outgoing>
    </bpmn:task>

    <!-- HR Tasks -->
    <bpmn:task id="Task_ProvideTraining_001" name="Provide training">
      <bpmn:incoming>SeqFlow_TrainingToHR_001</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_HRTrainEnd_001</bpmn:outgoing>
    </bpmn:task>

    <!-- Announcement Task -->
    <bpmn:task id="Task_AnnounceMonth_001" name="Announce employee of the month">
      <bpmn:incoming>SeqFlow_MergeToAnnounce_001</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_AnounceToEnd_001</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SeqFlow_StartToTask_001" sourceRef="StartEvent_CheckPerf_001" targetRef="Task_CheckPerformance_001" />
    <bpmn:sequenceFlow id="SeqFlow_TaskToGwPerf_001" sourceRef="Task_CheckPerformance_001" targetRef="Gw_PerformanceCheck_001" />

    <!-- Gateway 1 Outflows -->
    <bpmn:sequenceFlow id="SeqFlow_GwDismissal_001" name="performance &lt; 20%" sourceRef="Gw_PerformanceCheck_001" targetRef="Task_SuggestDismissal_001" />
    <bpmn:sequenceFlow id="SeqFlow_GwTraining_001" name="20% &lt; performance &lt; 50%" sourceRef="Gw_PerformanceCheck_001" targetRef="Task_SuggestTraining_001" />
    <bpmn:sequenceFlow id="SeqFlow_GwReward_001" name="performance &gt; 75%" sourceRef="Gw_PerformanceCheck_001" targetRef="Task_SuggestReward_001" />

    <!-- Gateway 2 Outflows -->
    <bpmn:sequenceFlow id="SeqFlow_RewardToGwType_001" sourceRef="Task_SuggestReward_001" targetRef="Gw_RewardType_001" />
    <bpmn:sequenceFlow id="SeqFlow_FinancialReward_001" name="financial reward" sourceRef="Gw_RewardType_001" targetRef="Task_CalculateReward_001" />
    <bpmn:sequenceFlow id="SeqFlow_OtherBenefit_001" name="other benefit" sourceRef="Gw_RewardType_001" targetRef="Task_ChooseBenefit_001" />

    <!-- HR Flow -->
    <bpmn:sequenceFlow id="SeqFlow_DismissToHR_001" sourceRef="Task_SuggestDismissal_001" targetRef="Task_DismissEmployee_001" />
    <bpmn:sequenceFlow id="SeqFlow_TrainingToHR_001" sourceRef="Task_SuggestTraining_001" targetRef="Task_ProvideTraining_001" />

    <!-- Finance Flow -->
    <bpmn:sequenceFlow id="SeqFlow_PayToPay_001" sourceRef="Task_CalculateReward_001" targetRef="Task_PayReward_001" />

    <!-- Merge Flows -->
    <bpmn:sequenceFlow id="SeqFlow_FinanceMerge_001" sourceRef="Task_PayReward_001" targetRef="Gw_MergeReward_001" />
    <bpmn:sequenceFlow id="SeqFlow_BenefitMerge_001" sourceRef="Task_ChooseBenefit_001" targetRef="Gw_MergeReward_001" />

    <!-- Announcement Flow -->
    <bpmn:sequenceFlow id="SeqFlow_MergeToAnnounce_001" sourceRef="Gw_MergeReward_001" targetRef="Task_AnnounceMonth_001" />

    <!-- End Events -->
    <bpmn:endEvent id="EndDismissal_001">
      <bpmn:incoming>SeqFlow_HRDismissEnd_001</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndTraining_002">
      <bpmn:incoming>SeqFlow_HRTrainEnd_001</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndReward_003" name="Employee of the month announced">
      <bpmn:incoming>SeqFlow_AnounceToEnd_001</bpmn:incoming>
    </bpmn:endEvent>

    <!-- End Event Connections -->
    <bpmn:sequenceFlow id="SeqFlow_HRDismissEnd_001" sourceRef="Task_DismissEmployee_001" targetRef="EndDismissal_001" />
    <bpmn:sequenceFlow id="SeqFlow_HRTrainEnd_001" sourceRef="Task_ProvideTraining_001" targetRef="EndTraining_002" />
    <bpmn:sequenceFlow id="SeqFlow_AnounceToEnd_001" sourceRef="Task_AnnounceMonth_001" targetRef="EndReward_003" />

  </bpmn:process>
</bpmn:definitions>