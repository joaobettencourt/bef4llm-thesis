<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_RestaurantProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_RestaurantOrdering">
    <bpmn:participant id="Participant_Guest" name="Gast (Kunde)" processRef="Process_Guest"/>
    <bpmn:participant id="Participant_Employee" name="Angestellter (Service)" processRef="Process_Employee"/>
    <bpmn:participant id="Participant_Cook" name="Koch (Zubereitung)" processRef="Process_Cook"/>

    <!-- Message Flows -->
    <bpmn:messageFlow id="Message_OrderPlaced" sourceRef="Task_GuestPlaceOrder" targetRef="StartEvent_EmployeeReceiveOrder"/>
    <bpmn:messageFlow id="Message_ReadyNotification" sourceRef="Task_CookNotifyStaff" targetRef="IntermediateCatchEvent_EmployeeFoodReady"/>
  </bpmn:collaboration>

  <!-- Guest Process -->
  <bpmn:process id="Process_Guest">
    <bpmn:startEvent id="StartEvent_GuestHunger" name="Gast betritt Restaurant (Hunger)">
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_EnterRestaurant" name="Restaurant betreten">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_ChooseDish" name="Gericht auswählen">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
    </bpmn:task>

    <!-- Waiting for turn -->
    <bpmn:intermediateCatchEvent id="IntermediateWaitTurn" name="Warten bis an der Reihe">
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Placing Order -->
    <bpmn:task id="Task_GuestPlaceOrder" name="Bestellung aufgeben">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
    </bpmn:task>

    <!-- Receiving Pager -->
    <bpmn:intermediateCatchEvent id="IntermediatePagerReceived" name="Pieper erhalten">
      <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Waiting for Food Ready Signal -->
    <bpmn:intermediateCatchEvent id="IntermediateFoodReadySignal" name="Pieper meldet sich (Essen fertig)">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Picking up Food -->
    <bpmn:task id="Task_PickUpFood" name="Essen abholen">
      <bpmn:incoming>SequenceFlow_7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_8</bpmn:outgoing>
    </bpmn:task>

    <!-- Eating -->
    <bpmn:task id="Task_ConsumeMeal" name="Mahlzeit verzehren">
      <bpmn:incoming>SequenceFlow_8</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndGuest</bpmn:outgoing>
    </bpmn:task>

    <!-- End -->
    <bpmn:endEvent id="EndEvent_GuestHungrySatisfied" name="Hunger gestillt">
      <bpmn:incoming>SequenceFlow_EndGuest</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows Guest -->
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_GuestHunger" targetRef="Task_EnterRestaurant"/>
    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="Task_EnterRestaurant" targetRef="Task_ChooseDish"/>
    <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="Task_ChooseDish" targetRef="IntermediateWaitTurn"/>
    <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="IntermediateWaitTurn" targetRef="Task_GuestPlaceOrder"/>
    <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="Task_GuestPlaceOrder" targetRef="IntermediatePagerReceived"/>
    <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="IntermediatePagerReceived" targetRef="IntermediateFoodReadySignal"/>
    <bpmn:sequenceFlow id="SequenceFlow_7" sourceRef="IntermediateFoodReadySignal" targetRef="Task_PickUpFood"/>
    <bpmn:sequenceFlow id="SequenceFlow_8" sourceRef="Task_PickUpFood" targetRef="Task_ConsumeMeal"/>
    <bpmn:sequenceFlow id="SequenceFlow_EndGuest" sourceRef="Task_ConsumeMeal" targetRef="EndEvent_GuestHungrySatisfied"/>

  </bpmn:process>

  <!-- Employee Process -->
  <bpmn:process id="Process_Employee">
    <bpmn:startEvent id="StartEvent_EmployeeReceiveOrder" name="Bestellung erhalten (Gast)">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- POS & Payment -->
    <bpmn:task id="Task_EmployeeEnterOrder" name="Bestellung eingeben (Kassensystem)">
      <bpmn:incoming>SequenceFlow_10</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_11</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_EmployeeCollectMoney" name="Geld kassieren">
      <bpmn:incoming>SequenceFlow_11</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_12</bpmn:outgoing>
    </bpmn:task>

    <!-- Pager Setup -->
    <bpmn:task id="Task_EmployeeSetPager" name="Pieper einstellen">
      <bpmn:incoming>SequenceFlow_12</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_13</bpmn:outgoing>
    </bpmn:task>

    <!-- Handover Pager -->
    <bpmn:task id="Task_EmployeeHandOverPager" name="Pieper übergeben">
      <bpmn:incoming>SequenceFlow_13</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_14</bpmn:outgoing>
    </bpmn:task>

    <!-- Inform Cook -->
    <bpmn:task id="Task_EmployeeInformCook" name="Koch informieren">
      <bpmn:incoming>SequenceFlow_14</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_15</bpmn:outgoing>
    </bpmn:task>

    <!-- Wait for Food Ready Notification -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_EmployeeFoodReady" name="Essen fertig (Koch)">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SequenceFlow_15</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_16</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Trigger Pager Signal to Guest -->
    <bpmn:task id="Task_EmployeeTriggerPager" name="Pieper auslösen">
      <bpmn:incoming>SequenceFlow_16</bpmn:incoming>
      <bpmn:messageOutputEventDefinition/>
      <bpmn:outgoing>SequenceFlow_GatewayStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Event Based Gateway for Timeout vs Customer Appearance -->
    <bpmn:eventBasedGateway id="Gateway_EmployeeWait" name="Warten auf Gast oder Zeitablauf">
      <bpmn:incoming>SequenceFlow_GatewayStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitCustomerAppearance</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_Timeout5Min</bpmn:outgoing>
    </bpmn:eventBasedGateway>

    <!-- Branch 1: Customer Appears -->
    <bpmn:intermediateCatchEvent id="IntermediateWaitCustomerAppearance" name="Gast erscheint an Ausgabe">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SequenceFlow_WaitCustomerAppearance</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_HandoverFood</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Branch 2: Timeout -->
    <bpmn:intermediateCatchEvent id="IntermediateTimer5Min" name="5 Minuten Timer">
      <bpmn:timerEventDefinition/>
      <bpmn:incoming>SequenceFlow_Timeout5Min</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CallOutCustomer</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Call Out Task -->
    <bpmn:task id="Task_EmployeeCallOut" name="Gast ausrufen">
      <bpmn:incoming>SequenceFlow_CallOutCustomer</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_LoopBackToWait</bpmn:outgoing>
    </bpmn:task>

    <!-- Handover Food -->
    <bpmn:task id="Task_EmployeeHandOverFood" name="Essen übergeben">
      <bpmn:incoming>SequenceFlow_HandoverFood</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndEmployee</bpmn:outgoing>
    </bpmn:task>

    <!-- End -->
    <bpmn:endEvent id="EndEvent_EmployeeOrderProcessed" name="Bestellung bearbeitet">
      <bpmn:incoming>SequenceFlow_EndEmployee</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows Employee -->
    <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="StartEvent_EmployeeReceiveOrder" targetRef="Task_EmployeeEnterOrder"/>
    <bpmn:sequenceFlow id="SequenceFlow_11" sourceRef="Task_EmployeeEnterOrder" targetRef="Task_EmployeeCollectMoney"/>
    <bpmn:sequenceFlow id="SequenceFlow_12" sourceRef="Task_EmployeeCollectMoney" targetRef="Task_EmployeeSetPager"/>
    <bpmn:sequenceFlow id="SequenceFlow_13" sourceRef="Task_EmployeeSetPager" targetRef="Task_EmployeeHandOverPager"/>
    <bpmn:sequenceFlow id="SequenceFlow_14" sourceRef="Task_EmployeeHandOverPager" targetRef="Task_EmployeeInformCook"/>
    
    <!-- Note: Inform Cook sends message to Process_Cook StartEvent -->
    <bpmn:sequenceFlow id="SequenceFlow_15" sourceRef="Task_EmployeeInformCook" targetRef="IntermediateCatchEvent_EmployeeFoodReady"/> 
    
    <bpmn:sequenceFlow id="SequenceFlow_16" sourceRef="IntermediateCatchEvent_EmployeeFoodReady" targetRef="Task_EmployeeTriggerPager"/>
    <bpmn:sequenceFlow id="SequenceFlow_GatewayStart" sourceRef="Task_EmployeeTriggerPager" targetRef="Gateway_EmployeeWait"/>
    
    <!-- Gateway Outgoing -->
    <bpmn:sequenceFlow id="SequenceFlow_WaitCustomerAppearance" name="Kunde erscheint" sourceRef="Gateway_EmployeeWait" targetRef="IntermediateWaitCustomerAppearance"/>
    <bpmn:sequenceFlow id="SequenceFlow_Timeout5Min" name="Nach 5 Min" sourceRef="Gateway_EmployeeWait" targetRef="IntermediateTimer5Min"/>

    <!-- Loop Back -->
    <bpmn:sequenceFlow id="SequenceFlow_CallOutCustomer" sourceRef="IntermediateTimer5Min" targetRef="Task_EmployeeCallOut"/>
    <bpmn:sequenceFlow id="SequenceFlow_LoopBackToWait" name="Nochmal ausrufen?" sourceRef="Task_EmployeeCallOut" targetRef="Gateway_EmployeeWait"/>

    <!-- Handover Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_HandoverFood" sourceRef="IntermediateWaitCustomerAppearance" targetRef="Task_EmployeeHandOverFood"/>
    
    <!-- End Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_EndEmployee" sourceRef="Task_EmployeeHandOverFood" targetRef="EndEvent_EmployeeOrderProcessed"/>

  </bpmn:process>

  <!-- Cook Process -->
  <bpmn:process id="Process_Cook">
    <bpmn:startEvent id="StartEvent_CookReceiveInfo" name="Mahlzeit zuzubereiten (Bestellung erhalten)">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_20</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Prepare Meal -->
    <bpmn:task id="Task_CookPrepareMeal" name="Mahlzeit zubereiten">
      <bpmn:incoming>SequenceFlow_20</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_21</bpmn:outgoing>
    </bpmn:task>

    <!-- Put in Pass-through -->
    <bpmn:task id="Task_CookPlaceInPassThrough" name="Essen in Durchreiche stellen">
      <bpmn:incoming>SequenceFlow_21</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_22</bpmn:outgoing>
    </bpmn:task>

    <!-- Notify Staff -->
    <bpmn:intermediateThrowEvent id="Task_CookNotifyStaff" name="Angestellten informieren">
      <bpmn:messageOutputEventDefinition/>
      <bpmn:incoming>SequenceFlow_22</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndCook</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <!-- End -->
    <bpmn:endEvent id="EndEvent_CookMealPrepared" name="Mahlzeit zubereitet">
      <bpmn:incoming>SequenceFlow_EndCook</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows Cook -->
    <bpmn:sequenceFlow id="SequenceFlow_20" sourceRef="StartEvent_CookReceiveInfo" targetRef="Task_CookPrepareMeal"/>
    <bpmn:sequenceFlow id="SequenceFlow_21" sourceRef="Task_CookPrepareMeal" targetRef="Task_CookPlaceInPassThrough"/>
    <bpmn:sequenceFlow id="SequenceFlow_22" sourceRef="Task_CookPlaceInPassThrough" targetRef="Task_CookNotifyStaff"/>
    <bpmn:sequenceFlow id="SequenceFlow_EndCook" sourceRef="Task_CookNotifyStaff" targetRef="EndEvent_CookMealPrepared"/>

  </bpmn:process>

</bpmn:definitions>