<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_RestaurantOrdering">
    <bpmn:participant id="Participant_Guest" name="Guest food consumption" processRef="Process_Guest"/>
    <bpmn:participant id="Participant_Employee" name="Employee order processing" processRef="Process_Employee"/>
    <bpmn:participant id="Participant_Chef" name="Chef meal preparation" processRef="Process_Chef"/>

    <!-- Message Flows between participants -->
    <bpmn:messageFlow id="Message_GuestToEmployee_OrderReceived" sourceRef="Task_GuestPlaceOrder" targetRef="StartEvent_EmployeeOrderReceived"/>
    <bpmn:messageFlow id="Message_EmployeeToGuest_BuzzerReady" sourceRef="Task_HandOverBuzzer" targetRef="IntermediateCatch_GuestMealReady"/>
    <bpmn:messageFlow id="Message_EmployeeToChef_OrderInfo" sourceRef="Task_EmployeeInformChef" targetRef="StartEvent_ChefOrderNeeded"/>
    <bpmn:messageFlow id="Message_ChefToEmployee_MealInHatch" sourceRef="Task_ChefInformEmployee" targetRef="IntermediateCatch_EmployeeMealReady"/>

  </bpmn:collaboration>

  <!-- Guest Process -->
  <bpmn:process id="Process_Guest">
    <bpmn:startEvent id="StartEvent_HungerNoticed" name="Hunger noticed">
      <bpmn:outgoing>SequenceFlow_StartToEnterRestaurant</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_EnterRestaurant" name="Enter restaurant">
      <bpmn:incoming>SequenceFlow_StartToEnterRestaurant</bpmn:incoming/>
      <bpmn:outgoing>SequenceFlow_ToChooseDish</bpmn:outgoing/>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_StartToEnterRestaurant" sourceRef="StartEvent_HungerNoticed" targetRef="Task_EnterRestaurant"/>

    <bpmn:task id="Task_ChooseDish" name="Choose dish">
      <bpmn:incoming>SequenceFlow_ToChooseDish</bpmn:incoming/>
      <bpmn:outgoing>SequenceFlow_WaitForTurn</bpmn:outgoing/>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_ToChooseDish" sourceRef="Task_EnterRestaurant" targetRef="Task_ChooseDish"/>

    <bpmn:intermediateCatchEvent id="IntermediateCatch_WaitForTurn" name="Wait for turn">
      <bpmn:incoming>SequenceFlow_WaitForTurn</bpmn:incoming/>
      <bpmn:outgoing>SequenceFlow_ToPlaceOrder</bpmn:outgoing/>
    </bpmn:intermediateCatchEvent>

    <bpmn:sequenceFlow id="SequenceFlow_WaitForTurn" sourceRef="Task_ChooseDish" targetRef="IntermediateCatch_WaitForTurn"/>

    <bpmn:task id="Task_GuestPlaceOrder" name="Place order">
      <bpmn:incoming>SequenceFlow_ToPlaceOrder</bpmn:incoming/>
      <bpmn:outgoing>SequenceFlow_PayMoney</bpmn:outgoing/>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_ToPlaceOrder" sourceRef="IntermediateCatch_WaitForTurn" targetRef="Task_GuestPlaceOrder"/>

    <bpmn:intermediateCatchEvent id="IntermediateCatch_GuestMealReady" name="Buzzer rings">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SequenceFlow_PayMoney</bpmn:incoming/>
      <bpmn:outgoing>SequenceFlow_ToGetMeal</bpmn:outgoing/>
    </bpmn:intermediateCatchEvent>

    <bpmn:task id="Task_GuestGetMeal" name="Pick up meal">
      <bpmn:incoming>SequenceFlow_ToGetMeal</bpmn:incoming/>
      <bpmn:outgoing>SequenceFlow_EatMeal</bpmn:outgoing/>
    </bpmn:task>

    <bpmn:endEvent id="End_NotHungryAnymore">
      <bpmn:incoming>SequenceFlow_EatMeal</bpmn:incoming/>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow_PayMoney" sourceRef="Task_GuestPlaceOrder" targetRef="IntermediateCatch_GuestMealReady"/>
    <bpmn:sequenceFlow id="SequenceFlow_ToGetMeal" sourceRef="IntermediateCatch_GuestMealReady" targetRef="Task_GuestGetMeal"/>
    <bpmn:sequenceFlow id="SequenceFlow_EatMeal" sourceRef="Task_GuestGetMeal" targetRef="End_NotHungryAnymore"/>

  </bpmn:process>

  <!-- Employee Process -->
  <bpmn:process id="Process_Employee">
    <bpmn:startEvent id="StartEvent_EmployeeOrderReceived" name="Order received">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_EnterPOS</bpmn:outgoing/>
    </bpmn:startEvent>

    <bpmn:task id="Task_EmployeeEnterPOS" name="Enter order in POS system">
      <bpmn:incoming>SequenceFlow_EnterPOS</bpmn:incoming/>
      <bpmn:outgoing>SequenceFlow_CollectMoney</bpmn:outgoing/>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_EnterPOS" sourceRef="StartEvent_EmployeeOrderReceived" targetRef="Task_EmployeeEnterPOS"/>

    <bpmn:task id="Task_CollectMoney" name="Collect money">
      <bpmn:incoming>SequenceFlow_CollectMoney</bpmn:incoming/>
      <bpmn:outgoing>SequenceFlow_SetBuzzer</bpmn:outgoing/>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_CollectMoney" sourceRef="Task_EmployeeEnterPOS" targetRef="Task_CollectMoney"/>

    <bpmn:task id="Task_SetBuzzer" name="Set up buzzer">
      <bpmn:incoming>SequenceFlow_SetBuzzer</bpmn:incoming/>
      <bpmn:outgoing>SequenceFlow_HandOverBuzzer</bpmn:outgoing/>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_SetBuzzer" sourceRef="Task_CollectMoney" targetRef="Task_SetBuzzer"/>

    <bpmn:task id="Task_HandOverBuzzer" name="Hand over buzzer">
      <bpmn:incoming>SequenceFlow_HandOverBuzzer</bpmn:incoming/>
      <bpmn:outgoing>SequenceFlow_InformChef</bpmn:outgoing/>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_HandOverBuzzer" sourceRef="Task_SetBuzzer" targetRef="Task_HandOverBuzzer"/>

    <bpmn:task id="Task_EmployeeInformChef" name="Inform chef of order">
      <bpmn:incoming>SequenceFlow_InformChef</bpmn:incoming/>
      <bpmn:outgoing>SequenceFlow_WaitMealReady</bpmn:outgoing/>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_InformChef" sourceRef="Task_HandOverBuzzer" targetRef="Task_EmployeeInformChef"/>

    <bpmn:intermediateCatchEvent id="IntermediateCatch_EmployeeMealReady" name="Meal ready">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SequenceFlow_WaitMealReady</bpmn:incoming/>
      <bpmn:outgoing>SequenceFlow_SetOffBuzzer</bpmn:outgoing/>
    </bpmn:intermediateCatchEvent>

    <bpmn:sequenceFlow id="SequenceFlow_WaitMealReady" sourceRef="Task_EmployeeInformChef" targetRef="IntermediateCatch_EmployeeMealReady"/>

    <bpmn:task id="Task_SetOffBuzzer" name="Set off buzzer">
      <bpmn:incoming>SequenceFlow_SetOffBuzzer</bpmn:incoming/>
      <bpmn:outgoing>SequenceFlow_EventBasedGateway</bpmn:outgoing/>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_SetOffBuzzer" sourceRef="IntermediateCatch_EmployeeMealReady" targetRef="Task_SetOffBuzzer"/>

    <!-- Event-based gateway for guest appearing or timeout -->
    <bpmn:eventBasedGateway id="EventBased_GuestOrTimeout">
      <bpmn:incoming>SequenceFlow_EventBasedGateway</bpmn:incoming/>
      <bpmn:outgoing>SequenceFlow_ToGuestAppears</bpmn:outgoing/>
      <bpmn:outgoing>SequenceFlow_ToTimer5Min</bpmn:outgoing/>
    </bpmn:eventBasedGateway>

    <bpmn:sequenceFlow id="SequenceFlow_EventBasedGateway" sourceRef="Task_SetOffBuzzer" targetRef="EventBased_GuestOrTimeout"/>

    <!-- Guest appears path -->
    <bpmn:intermediateCatchEvent id="IntermediateCatch_GuestAppears" name="Guest appears">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SequenceFlow_ToGuestAppears</bpmn:incoming/>
      <bpmn:outgoing>SequenceFlow_HandOverMeal</bpmn:outgoing/>
    </bpmn:intermediateCatchEvent>

    <bpmn:sequenceFlow id="SequenceFlow_ToGuestAppears" sourceRef="EventBased_GuestOrTimeout" targetRef="IntermediateCatch_GuestAppears"/>

    <!-- 5 minute timeout path -->
    <bpmn:intermediateCatchEvent id="Timer_5Minutes">
      <bpmn:timerEventDefinition/>
      <bpmn:incoming>SequenceFlow_ToTimer5Min</bpmn:incoming/>
      <bpmn:outgoing>SequenceFlow_CallGuest</bpmn:outgoing/>
    </bpmn:intermediateCatchEvent>

    <bpmn:sequenceFlow id="SequenceFlow_ToTimer5Min" sourceRef="EventBased_GuestOrTimeout" targetRef="Timer_5Minutes"/>

    <!-- Call guest task -->
    <bpmn:task id="Task_CallGuest" name="Call guest">
      <bpmn:incoming>SequenceFlow_CallGuest</bpmn:incoming/>
      <bpmn:outgoing>SequenceFlow_BackToGateway</bpmn:outgoing/>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_ToCallGuest" sourceRef="Timer_5Minutes" targetRef="Task_CallGuest"/>
    <bpmn:sequenceFlow id="SequenceFlow_BackToGateway" sourceRef="Task_CallGuest" targetRef="EventBased_GuestOrTimeout"/>

    <!-- Hand over meal -->
    <bpmn:task id="Task_HandOverMeal" name="Hand over meal">
      <bpmn:incoming>SequenceFlow_HandOverMeal</bpmn:incoming/>
      <bpmn:outgoing>SequenceFlow_EndOrderProcessed</bpmn:outgoing/>
    </bpmn:task>

    <bpmn:endEvent id="End_OrderProcessed">
      <bpmn:incoming>SequenceFlow_EndOrderProcessed</bpmn:incoming/>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow_HandOverMeal" sourceRef="IntermediateCatch_GuestAppears" targetRef="Task_HandOverMeal"/>
    <bpmn:sequenceFlow id="SequenceFlow_EndOrderProcessed" sourceRef="Task_HandOverMeal" targetRef="End_OrderProcessed"/>

  </bpmn:process>

  <!-- Chef Process -->
  <bpmn:process id="Process_Chef">
    <bpmn:startEvent id="StartEvent_ChefOrderNeeded" name="Meal needed">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_PrepareMeal</bpmn:outgoing/>
    </bpmn:startEvent>

    <bpmn:task id="Task_ChefPrepareMeal" name="Prepare meal">
      <bpmn:incoming>SequenceFlow_PrepareMeal</bpmn:incoming/>
      <bpmn:outgoing>SequenceFlow_PlaceInHatch</bpmn:outgoing/>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_PrepareMeal" sourceRef="StartEvent_ChefOrderNeeded" targetRef="Task_ChefPrepareMeal"/>

    <bpmn:task id="Task_PlaceInHatch" name="Place meal in service hatch">
      <bpmn:incoming>SequenceFlow_PlaceInHatch</bpmn:incoming/>
      <bpmn:outgoing>SequenceFlow_InformEmployee</bpmn:outgoing/>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_PlaceInHatch" sourceRef="Task_ChefPrepareMeal" targetRef="Task_PlaceInHatch"/>

    <bpmn:task id="Task_ChefInformEmployee" name="Inform employee">
      <bpmn:incoming>SequenceFlow_InformEmployee</bpmn:incoming/>
      <bpmn:outgoing>SequenceFlow_EndMealPrepared</bpmn:outgoing/>
    </bpmn:task>

    <bpmn:endEvent id="End_MealPrepared">
      <bpmn:incoming>SequenceFlow_EndMealPrepared</bpmn:incoming/>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow_InformEmployee" sourceRef="Task_PlaceInHatch" targetRef="Task_ChefInformEmployee"/>
    <bpmn:sequenceFlow id="SequenceFlow_EndMealPrepared" sourceRef="Task_ChefInformEmployee" targetRef="End_MealPrepared"/>

  </bpmn:process>
</bpmn:definitions>