<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_CourtProcess">
    <bpmn:participant id="Participant_CourtAdmin" name="Court Administration Process" processRef="Process_CourtHearing"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_CourtHearing" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_AdminStaff" name="Court Administration Staff">
        <bpmn:flowNodeRef>StartEvent_CheckFiles</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckFiles</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_FilesMissing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InitiateSearch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TrackFiles</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_FilesReady</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_PrepTasksSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HandFiles</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DistributeLawlist</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_PrepTasksJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConductHearings</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_HearingDone</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_CheckFiles" name="Check Files for Hearing">
      <bpmn:outgoing>SFlow_StartToCheck</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Check files in order -->
    <bpmn:task id="Task_CheckFiles" name="Check files in order">
      <bpmn:incoming>SFlow_StartToCheck</bpmn:incoming>
      <bpmn:outgoing>SFlow_CheckToDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Decision (Files Missing?) -->
    <bpmn:exclusiveGateway id="Gw_FilesMissing" name="Files missing?">
      <bpmn:incoming>SFlow_CheckToDecision</bpmn:incoming>
      <bpmn:outgoing>SFlow_SearchPath</bpmn:outgoing>
      <bpmn:outgoing>SFlow_TrackPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 2: Initiate search -->
    <bpmn:task id="Task_InitiateSearch" name="Initiate search">
      <bpmn:incoming>SFlow_SearchPath</bpmn:incoming>
      <bpmn:outgoing>SFlow_SearchToMerge</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3: Track physical files -->
    <bpmn:task id="Task_TrackFiles" name="Track physical files">
      <bpmn:incoming>SFlow_TrackPath</bpmn:incoming>
      <bpmn:outgoing>SFlow_TrackToMerge</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2: Merge (Files Ready) -->
    <bpmn:exclusiveGateway id="Gw_FilesReady" name="">
      <bpmn:incoming>SFlow_SearchToMerge</bpmn:incoming>
      <bpmn:incoming>SFlow_TrackToMerge</bpmn:incoming>
      <bpmn:outgoing>SFlow_ToParallelSplit</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Gateway 3: Parallel Split (Hand files AND Distribute Lawlist) -->
    <bpmn:parallelGateway id="Gw_PrepTasksSplit" name="">
      <bpmn:incoming>SFlow_ToParallelSplit</bpmn:incoming>
      <bpmn:outgoing>SFlow_HandFilesPath</bpmn:outgoing>
      <bpmn:outgoing>SFlow_DistributeLawlistPath</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 4: Hand files to associate -->
    <bpmn:task id="Task_HandFiles" name="Hand files to Associate">
      <bpmn:incoming>SFlow_HandFilesPath</bpmn:incoming>
      <bpmn:outgoing>SFlow_ToJoinHearings</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 5: Distribute judge's lawlist -->
    <bpmn:task id="Task_DistributeLawlist" name="Distribute Judge's Lawlist">
      <bpmn:incoming>SFlow_DistributeLawlistPath</bpmn:incoming>
      <bpmn:outgoing>SFlow_ToJoinHearings2</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 4: Parallel Join (Before Hearings) -->
    <bpmn:parallelGateway id="Gw_PrepTasksJoin" name="">
      <bpmn:incoming>SFlow_ToJoinHearings</bpmn:incoming>
      <bpmn:incoming>SFlow_ToJoinHearings2</bpmn:incoming>
      <bpmn:outgoing>SFlow_StartHearings</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 6: Conduct directions hearings -->
    <bpmn:task id="Task_ConductHearings" name="Conduct directions hearings">
      <bpmn:incoming>SFlow_StartHearings</bpmn:incoming>
      <bpmn:outgoing>SFlow_ToEndEvent</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_HearingDone" name="">
      <bpmn:incoming>SFlow_ToEndEvent</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SFlow_StartToCheck" sourceRef="StartEvent_CheckFiles" targetRef="Task_CheckFiles"/>
    <bpmn:sequenceFlow id="SFlow_CheckToDecision" name="" sourceRef="Task_CheckFiles" targetRef="Gw_FilesMissing"/>
    
    <!-- Decision Paths -->
    <bpmn:sequenceFlow id="SFlow_SearchPath" name="Yes (missing)" sourceRef="Gw_FilesMissing" targetRef="Task_InitiateSearch"/>
    <bpmn:sequenceFlow id="SFlow_TrackPath" name="No (otherwise)" sourceRef="Gw_FilesMissing" targetRef="Task_TrackFiles"/>

    <!-- Merge Paths -->
    <bpmn:sequenceFlow id="SFlow_SearchToMerge" sourceRef="Task_InitiateSearch" targetRef="Gw_FilesReady"/>
    <bpmn:sequenceFlow id="SFlow_TrackToMerge" sourceRef="Task_TrackFiles" targetRef="Gw_FilesReady"/>

    <!-- Parallel Split Paths -->
    <bpmn:sequenceFlow id="SFlow_ToParallelSplit" name="" sourceRef="Gw_FilesReady" targetRef="Gw_PrepTasksSplit"/>
    <bpmn:sequenceFlow id="SFlow_HandFilesPath" sourceRef="Gw_PrepTasksSplit" targetRef="Task_HandFiles"/>
    <bpmn:sequenceFlow id="SFlow_DistributeLawlistPath" name="" sourceRef="Gw_PrepTasksSplit" targetRef="Task_DistributeLawlist"/>

    <!-- Parallel Join Paths -->
    <bpmn:sequenceFlow id="SFlow_ToJoinHearings" sourceRef="Task_HandFiles" targetRef="Gw_PrepTasksJoin"/>
    <bpmn:sequenceFlow id="SFlow_ToJoinHearings2" name="" sourceRef="Task_DistributeLawlist" targetRef="Gw_PrepTasksJoin"/>

    <!-- Final Flow -->
    <bpmn:sequenceFlow id="SFlow_StartHearings" sourceRef="Gw_PrepTasksJoin" targetRef="Task_ConductHearings"/>
    <bpmn:sequenceFlow id="SFlow_ToEndEvent" name="" sourceRef="Task_ConductHearings" targetRef="EndEvent_HearingDone"/>

  </bpmn:process>
</bpmn:definitions>