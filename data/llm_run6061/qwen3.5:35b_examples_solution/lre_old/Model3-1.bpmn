<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_WarrantProcess">
    <bpmn:participant id="Participant_SmallClaimsRegistryOperations" name="Small Claims Registry Operations" processRef="Process_WarrantPossession"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_WarrantPossession" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_ClientServiceBackOffice" name="Client Service Back Office">
        <bpmn:flowNodeRef>StartEvent_RequestReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RetrieveSCTTFile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DistributeWarrantPossession</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateCatchEvent_ReportReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RetrieveSCTFile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AttachNewSCTDocument</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_StoreExpandedPhysicalFile</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_OtherMCInternalStaff" name="Other MC Internal Staff">
        <bpmn:flowNodeRef>EndEvent_ProcessComplete</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_RequestReceived" name="Warrant Possession Request Received">
      <bpmn:outgoing>SFlow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Retrieve SCTT File -->
    <bpmn:task id="Task_RetrieveSCTTFile" name="Retrieve SCTT File">
      <bpmn:incoming>SFlow_01</bpmn:incoming>
      <bpmn:outgoing>SFlow_02</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: Distribute Warrant Possession -->
    <bpmn:task id="Task_DistributeWarrantPossession" name="Distribute SCT Warrant Possession">
      <bpmn:incoming>SFlow_02</bpmn:incoming>
      <bpmn:outgoing>SFlow_03</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Catch Event: Wait for Police Report -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_ReportReceived" name="Police Report Received">
      <bpmn:incoming>SFlow_03</bpmn:incoming>
      <bpmn:outgoing>SFlow_04</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task 3: Retrieve SCT File -->
    <bpmn:task id="Task_RetrieveSCTFile" name="Retrieve SCT File">
      <bpmn:incoming>SFlow_04</bpmn:incoming>
      <bpmn:outgoing>SFlow_05</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 4: Attach New Document -->
    <bpmn:task id="Task_AttachNewSCTDocument" name="Attach new SCT Document">
      <bpmn:incoming>SFlow_05</bpmn:incoming>
      <bpmn:outgoing>SFlow_06</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 5: Store Expanded Physical File -->
    <bpmn:task id="Task_StoreExpandedPhysicalFile" name="Store expanded SCT physical file">
      <bpmn:incoming>SFlow_06</bpmn:incoming>
      <bpmn:outgoing>SFlow_EndProcess</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_ProcessComplete" name="Warrant Possession Process Complete">
      <bpmn:incoming>SFlow_EndProcess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SFlow_01" sourceRef="StartEvent_RequestReceived" targetRef="Task_RetrieveSCTTFile"/>
    <bpmn:sequenceFlow id="SFlow_02" sourceRef="Task_RetrieveSCTTFile" targetRef="Task_DistributeWarrantPossession"/>
    <bpmn:sequenceFlow id="SFlow_03" name="Awaiting Police Report" sourceRef="Task_DistributeWarrantPossession" targetRef="IntermediateCatchEvent_ReportReceived"/>
    <bpmn:sequenceFlow id="SFlow_04" sourceRef="IntermediateCatchEvent_ReportReceived" targetRef="Task_RetrieveSCTFile"/>
    <bpmn:sequenceFlow id="SFlow_05" sourceRef="Task_RetrieveSCTFile" targetRef="Task_AttachNewSCTDocument"/>
    <bpmn:sequenceFlow id="SFlow_06" sourceRef="Task_AttachNewSCTDocument" targetRef="Task_StoreExpandedPhysicalFile"/>
    <bpmn:sequenceFlow id="SFlow_EndProcess" name="Out of scope handover" sourceRef="Task_StoreExpandedPhysicalFile" targetRef="EndEvent_ProcessComplete"/>

  </bpmn:process>
</bpmn:definitions>