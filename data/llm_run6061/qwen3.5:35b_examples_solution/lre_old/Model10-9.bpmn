<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_MPO">
    <bpmn:participant id="Participant_MPO" name="MPO" processRef="Process_ChangeRequest"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_ChangeRequest" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_MPO_Ops" name="MPO Operations">
        <bpmn:flowNodeRef>Start_Initiated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_SourceCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tsk_RequestChange</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tsk_SelfInitiated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_MergeReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tsk_ReviewRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_ApprovalDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tsk_PerformChange</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_ResultCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tsk_ReportSuccess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tsk_NotifyFail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Failure</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="Start_Initiated" name="Change Request Initiated">
      <bpmn:outgoing>SFlow_SourceCheck</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Gateway to distinguish source of change (SP/PU/GO vs MPO) -->
    <bpmn:exclusiveGateway id="Gw_SourceCheck" name="Source of Change?">
      <bpmn:incoming>SFlow_SourceCheck</bpmn:incoming>
      <bpmn:outgoing>SFlow_RequestPath</bpmn:outgoing>
      <bpmn:outgoing>SFlow_SelfPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task for External Request -->
    <bpmn:task id="Tsk_RequestChange" name="Request a change">
      <bpmn:incoming>SFlow_RequestPath</bpmn:incoming>
      <bpmn:outgoing>SFlow_MergeReview_1</bpmn:outgoing>
    </bpmn:task>

    <!-- Task for Self-Initiated Change -->
    <bpmn:task id="Tsk_SelfInitiated" name="Cause change by itself">
      <bpmn:incoming>SFlow_SelfPath</bpmn:incoming>
      <bpmn:outgoing>SFlow_MergeReview_2</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway to merge initiation paths before review -->
    <bpmn:inclusiveGateway id="Gw_MergeReview" name="">
      <bpmn:incoming>SFlow_MergeReview_1</bpmn:incoming>
      <bpmn:incoming>SFlow_MergeReview_2</bpmn:incoming>
      <bpmn:outgoing>SFlow_ToReview</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Task for Review -->
    <bpmn:task id="Tsk_ReviewRequest" name="Review the change request">
      <bpmn:incoming>SFlow_ToReview</bpmn:incoming>
      <bpmn:outgoing>SFlow_ApprovalDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for Approval Decision -->
    <bpmn:exclusiveGateway id="Gw_ApprovalDecision" name="Reject or Confirm?">
      <bpmn:incoming>SFlow_ApprovalDecision</bpmn:incoming>
      <bpmn:outgoing>SFlow_RejectPath</bpmn:outgoing>
      <bpmn:outgoing>SFlow_ConfirmPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event for Rejection -->
    <bpmn:endEvent id="End_Rejected" name="Request Denied">
      <bpmn:incoming>SFlow_RejectPath</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task to Perform Change (Only if Confirmed) -->
    <bpmn:task id="Tsk_PerformChange" name="Perform the measuring point change">
      <bpmn:incoming>SFlow_ConfirmPath</bpmn:incoming>
      <bpmn:outgoing>SFlow_ImplementationResult</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for Implementation Result -->
    <bpmn:exclusiveGateway id="Gw_ResultCheck" name="Change Successful?">
      <bpmn:incoming>SFlow_ImplementationResult</bpmn:incoming>
      <bpmn:outgoing>SFlow_SuccessPath</bpmn:outgoing>
      <bpmn:outgoing>SFlow_FailurePath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task for Reporting Success -->
    <bpmn:task id="Tsk_ReportSuccess" name="Report implementation">
      <bpmn:incoming>SFlow_SuccessPath</bpmn:incoming>
      <bpmn:outgoing>SFlow_EndSuccess</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event for Success -->
    <bpmn:endEvent id="End_Success" name="Implementation Reported">
      <bpmn:incoming>SFlow_EndSuccess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task for Notifying Failure -->
    <bpmn:task id="Tsk_NotifyFail" name="Notify failure of changes">
      <bpmn:incoming>SFlow_FailurePath</bpmn:incoming>
      <bpmn:outgoing>SFlow_EndFailure</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event for Failure -->
    <bpmn:endEvent id="End_Failure" name="Change Failed">
      <bpmn:incoming>SFlow_EndFailure</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SFlow_SourceCheck" sourceRef="Start_Initiated" targetRef="Gw_SourceCheck"/>
    <bpmn:sequenceFlow id="SFlow_RequestPath" name="SP/PU/GO Request" sourceRef="Gw_SourceCheck" targetRef="Tsk_RequestChange"/>
    <bpmn:sequenceFlow id="SFlow_SelfPath" name="MPO Self-Initiated" sourceRef="Gw_SourceCheck" targetRef="Tsk_SelfInitiated"/>
    <bpmn:sequenceFlow id="SFlow_MergeReview_1" sourceRef="Tsk_RequestChange" targetRef="Gw_MergeReview"/>
    <bpmn:sequenceFlow id="SFlow_MergeReview_2" name="" sourceRef="Tsk_SelfInitiated" targetRef="Gw_MergeReview"/>
    <bpmn:sequenceFlow id="SFlow_ToReview" sourceRef="Gw_MergeReview" targetRef="Tsk_ReviewRequest"/>
    <bpmn:sequenceFlow id="SFlow_ApprovalDecision" name="Ready to Review" sourceRef="Tsk_ReviewRequest" targetRef="Gw_ApprovalDecision"/>
    <bpmn:sequenceFlow id="SFlow_RejectPath" name="Reject" sourceRef="Gw_ApprovalDecision" targetRef="End_Rejected"/>
    <bpmn:sequenceFlow id="SFlow_ConfirmPath" name="Confirm" sourceRef="Gw_ApprovalDecision" targetRef="Tsk_PerformChange"/>
    <bpmn:sequenceFlow id="SFlow_ImplementationResult" sourceRef="Tsk_PerformChange" targetRef="Gw_ResultCheck"/>
    <bpmn:sequenceFlow id="SFlow_SuccessPath" name="Success" sourceRef="Gw_ResultCheck" targetRef="Tsk_ReportSuccess"/>
    <bpmn:sequenceFlow id="SFlow_EndSuccess" sourceRef="Tsk_ReportSuccess" targetRef="End_Success"/>
    <bpmn:sequenceFlow id="SFlow_FailurePath" name="Failure" sourceRef="Gw_ResultCheck" targetRef="Tsk_NotifyFail"/>
    <bpmn:sequenceFlow id="SFlow_EndFailure" sourceRef="Tsk_NotifyFail" targetRef="End_Failure"/>

  </bpmn:process>
</bpmn:definitions>