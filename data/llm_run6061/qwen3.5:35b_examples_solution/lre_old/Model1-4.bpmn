<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_IPO_Process">
    <bpmn:participant id="Participant_Underwriter" name="Underwriting Process" processRef="Process_IPO"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_IPO" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Underwriter_Ops" name="Underwriting Operations">
        <bpmn:flowNodeRef>StartEvent_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tsk_SelectUnderwriters</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_FactsFairnessCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Pg_ConcurrentPrepAndRoadshow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tsk_PrepRegistrationLaws</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntEvent_WaitSECClearance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tsk_RoadshowInvestors</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Pg_SyncBeforePriceFixing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tsk_FixIssuePrice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_CommitmentReasonCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tsk_BuyStockCommitment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tsk_OfferToPublic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_SuccessIPO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_RejectIssue</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Decision" name="Company decides to go public">
      <bpmn:outgoing>SFlow_SelectUnderwriters</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Select Underwriters -->
    <bpmn:task id="Tsk_SelectUnderwriters" name="Select Underwriters">
      <bpmn:incoming>SFlow_SelectUnderwriters</bpmn:incoming>
      <bpmn:outgoing>SFlow_CheckFacts</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Check Facts Fairness -->
    <bpmn:exclusiveGateway id="Gw_FactsFairnessCheck" name="Facts presented fairly?">
      <bpmn:incoming>SFlow_CheckFacts</bpmn:incoming>
      <bpmn:outgoing>SFlow_ProceedToPrep</bpmn:outgoing>
      <bpmn:outgoing>SFlow_RejectIssue</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event 1: Rejection -->
    <bpmn:endEvent id="EndEvent_RejectIssue" name="Issue Not Approved">
      <bpmn:incoming>SFlow_RejectIssue</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Parallel Gateway for Prep & Roadshow (While awaiting approval) -->
    <bpmn:parallelGateway id="Pg_ConcurrentPrepAndRoadshow" name="Parallel Start">
      <bpmn:incoming>SFlow_ProceedToPrep</bpmn:incoming>
      <bpmn:outgoing>SFlow_PrepRegLaws</bpmn:outgoing>
      <bpmn:outgoing>SFlow_RoadshowStart</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 2: Prepare Registration & Laws -->
    <bpmn:task id="Tsk_PrepRegistrationLaws" name="Prepare Reg Statement &amp; Check Blue-Sky Laws">
      <bpmn:incoming>SFlow_PrepRegLaws</bpmn:incoming>
      <bpmn:outgoing>SFlow_WaitSECClearance</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Catch Event: Wait for SEC -->
    <bpmn:intermediateCatchEvent id="IntEvent_WaitSECClearance" name="Awaiting SEC Clearance">
      <bpmn:incoming>SFlow_WaitSECClearance</bpmn:incoming>
      <bpmn:outgoing>SFlow_SECClearedToPriceFix</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task 3: Roadshow -->
    <bpmn:task id="Tsk_RoadshowInvestors" name="Road Show &amp; Talk to Investors">
      <bpmn:incoming>SFlow_RoadshowStart</bpmn:incoming>
      <bpmn:outgoing>SFlow_InvestorFeedbackReady</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway for Synchronization -->
    <bpmn:parallelGateway id="Pg_SyncBeforePriceFixing" name="Sync SEC &amp; Roadshow">
      <bpmn:incoming>SFlow_SECClearedToPriceFix</bpmn:incoming>
      <bpmn:incoming>SFlow_InvestorFeedbackReady</bpmn:incoming>
      <bpmn:outgoing>SFlow_FixIssuePriceStart</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 4: Fix Issue Price -->
    <bpmn:task id="Tsk_FixIssuePrice" name="Fix Issue Price">
      <bpmn:incoming>SFlow_FixIssuePriceStart</bpmn:incoming>
      <bpmn:outgoing>SFlow_CheckCommitmentReasons</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2: Check Reasons Not to Proceed -->
    <bpmn:exclusiveGateway id="Gw_CommitmentReasonCheck" name="Any reason not to proceed?">
      <bpmn:incoming>SFlow_CheckCommitmentReasons</bpmn:incoming>
      <bpmn:outgoing>SFlow_ProceedToBuyStock</bpmn:outgoing>
      <bpmn:outgoing>SFlow_StopProcess</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 5: Commit to Buy Stock -->
    <bpmn:task id="Tsk_BuyStockCommitment" name="Enter Firm Commitment">
      <bpmn:incoming>SFlow_ProceedToBuyStock</bpmn:incoming>
      <bpmn:outgoing>SFlow_OfferPublicStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 6: Offer to Public -->
    <bpmn:task id="Tsk_OfferToPublic" name="Offer Stock to Public">
      <bpmn:incoming>SFlow_OfferPublicStart</bpmn:incoming>
      <bpmn:outgoing>SFlow_IPOCompleted</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 2: Success -->
    <bpmn:endEvent id="EndEvent_SuccessIPO" name="IPO Completed">
      <bpmn:incoming>SFlow_IPOCompleted</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SFlow_SelectUnderwriters" sourceRef="StartEvent_Decision" targetRef="Tsk_SelectUnderwriters"/>
    <bpmn:sequenceFlow id="SFlow_CheckFacts" sourceRef="Tsk_SelectUnderwriters" targetRef="Gw_FactsFairnessCheck"/>
    <bpmn:sequenceFlow id="SFlow_ProceedToPrep" name="Yes, proceed" sourceRef="Gw_FactsFairnessCheck" targetRef="Pg_ConcurrentPrepAndRoadshow"/>
    <bpmn:sequenceFlow id="SFlow_RejectIssue" name="No facts fair" sourceRef="Gw_FactsFairnessCheck" targetRef="EndEvent_RejectIssue"/>

    <!-- Parallel Split Flows -->
    <bpmn:sequenceFlow id="SFlow_PrepRegLaws" sourceRef="Pg_ConcurrentPrepAndRoadshow" targetRef="Tsk_PrepRegistrationLaws"/>
    <bpmn:sequenceFlow id="SFlow_RoadshowStart" sourceRef="Pg_ConcurrentPrepAndRoadshow" targetRef="Tsk_RoadshowInvestors"/>

    <!-- Wait & Roadjoin Flows -->
    <bpmn:sequenceFlow id="SFlow_WaitSECClearance" sourceRef="Tsk_PrepRegistrationLaws" targetRef="IntEvent_WaitSECClearance"/>
    <bpmn:sequenceFlow id="SFlow_SECClearedToPriceFix" name="SEC Clearance Received" sourceRef="IntEvent_WaitSECClearance" targetRef="Pg_SyncBeforePriceFixing"/>
    <bpmn:sequenceFlow id="SFlow_InvestorFeedbackReady" sourceRef="Tsk_RoadshowInvestors" targetRef="Pg_SyncBeforePriceFixing"/>

    <!-- Post-Approval Flows -->
    <bpmn:sequenceFlow id="SFlow_FixIssuePriceStart" name="All Clear &amp; Ready" sourceRef="Pg_SyncBeforePriceFixing" targetRef="Tsk_FixIssuePrice"/>
    <bpmn:sequenceFlow id="SFlow_CheckCommitmentReasons" sourceRef="Tsk_FixIssuePrice" targetRef="Gw_CommitmentReasonCheck"/>
    <bpmn:sequenceFlow id="SFlow_ProceedToBuyStock" name="No reasons to stop" sourceRef="Gw_CommitmentReasonCheck" targetRef="Tsk_BuyStockCommitment"/>
    <bpmn:sequenceFlow id="SFlow_StopProcess" name="Stop Process" sourceRef="Gw_CommitmentReasonCheck" targetRef="EndEvent_RejectIssue"/>

    <!-- Final Steps -->
    <bpmn:sequenceFlow id="SFlow_OfferPublicStart" sourceRef="Tsk_BuyStockCommitment" targetRef="Tsk_OfferToPublic"/>
    <bpmn:sequenceFlow id="SFlow_IPOCompleted" name="Offered to Public" sourceRef="Tsk_OfferToPublic" targetRef="EndEvent_SuccessIPO"/>

  </bpmn:process>
</bpmn:definitions>