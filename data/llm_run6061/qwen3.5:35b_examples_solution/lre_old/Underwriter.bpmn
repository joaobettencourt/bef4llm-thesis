<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_IPO_Underwriting">
    <bpmn:participant id="Participant_IPO_Process" name="IPO Underwriting Process" processRef="Process_IPO_1" />
  </bpmn:collaboration>

  <bpmn:process id="Process_IPO_1" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Decision" name="Decision to go public">
      <bpmn:outgoing>SFlow_SelectUnderwriters</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Select Underwriters (First task per description) -->
    <bpmn:task id="Task_SelectUnderwriters" name="Select the underwriters">
      <bpmn:incoming>SFlow_SelectUnderwriters</bpmn:incoming>
      <bpmn:outgoing>SFlow_CheckFactsAndRegsLaws</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway for Fact Check and Registration/Law Checks -->
    <bpmn:parallelGateway id="PG_FactCheck_Registration" name="Fact Check &amp; Registration">
      <bpmn:incoming>SFlow_CheckFactsAndRegsLaws</bpmn:incoming>
      <bpmn:outgoing>SFlow_CheckFactsTask</bpmn:outgoing>
      <bpmn:outgoing>SFlow_PrepRegStatementSeq</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 2a: Check Facts Presented (Reputation check) -->
    <bpmn:task id="Task_CheckFacts" name="Check Facts Presented">
      <bpmn:incoming>SFlow_CheckFactsTask</bpmn:incoming>
      <bpmn:outgoing>SFlow_FactCheckGatewayIn</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway for Fact Check -->
    <bpmn:exclusiveGateway id="GW_FactCheck" name="All Right?">
      <bpmn:incoming>SFlow_FactCheckGatewayIn</bpmn:incoming>
      <bpmn:outgoing>SFlow_ContinueProcessYes</bpmn:outgoing>
      <bpmn:outgoing>SFlow_StopHandlingNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event 1: Stop Handling Issue if Facts Not OK -->
    <bpmn:endEvent id="EndEvent_StopHandling">
      <bpmn:incoming>SFlow_StopHandlingNo</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task 2b: Prepare Registration Statement for SEC approval (Parallel path) -->
    <bpmn:task id="Task_PrepRegStatement" name="Prepare registration statement for SEC approval">
      <bpmn:incoming>SFlow_PrepRegStatementSeq</bpmn:incoming>
      <bpmn:outgoing>SFlow_MergeRegsLawsOut1</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2c: Check Compliance with Blue-Sky Laws (Parallel path) -->
    <bpmn:task id="Task_CheckBlueSky" name="Check compliance with blue-sky laws">
      <bpmn:incoming>SFlow_PrepRegStatementSeq</bpmn:incoming>
      <bpmn:outgoing>SFlow_MergeRegsLawsOut2</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway to merge Registration and Law Checks -->
    <bpmn:parallelGateway id="PG_RegLawsMerge" name="Registration &amp; Laws">
      <bpmn:incoming>SFlow_MergeRegsLawsOut1</bpmn:incoming>
      <bpmn:incoming>SFlow_MergeRegsLawsOut2</bpmn:incoming>
      <bpmn:outgoing>SFlow_TalkInvestorsSeq</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 3: Talk to Potential Investors (Road Show) -->
    <bpmn:task id="Task_RoadShow" name="Talk to potential investors">
      <bpmn:incoming>SFlow_TalkInvestorsSeq</bpmn:incoming>
      <bpmn:outgoing>SFlow_WaitSECAnswerIn</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Catch Event: Wait for SEC Approval -->
    <bpmn:intermediateCatchEvent id="ECW_SECApproval" name="Wait for SEC Approval">
      <bpmn:incoming>SFlow_WaitSECAnswerIn</bpmn:incoming>
      <bpmn:outgoing>SFlow_GatewayApprovedCheckSeq</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Exclusive Gateway for Approval Decision -->
    <bpmn:exclusiveGateway id="GW_Approved" name="SEC Approved?">
      <bpmn:incoming>SFlow_GatewayApprovedCheckSeq</bpmn:incoming>
      <bpmn:outgoing>SFlow_FixPriceYesIn</bpmn:outgoing>
      <bpmn:outgoing>SFlow_ApprovalNoEndSeq</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event 2: No Approval -->
    <bpmn:endEvent id="EndEvent_NoApproval">
      <bpmn:incoming>SFlow_ApprovalNoEndSeq</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task 4: Fix Issue Price (After SEC approval) -->
    <bpmn:task id="Task_FixPrice" name="Fix issue price">
      <bpmn:incoming>SFlow_FixPriceYesIn</bpmn:incoming>
      <bpmn:outgoing>SFlow_BuyStockSeq1</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 5: Enter firm commitment to buy stock -->
    <bpmn:task id="Task_FirmCommit" name="Enter firm commitment to buy stock">
      <bpmn:incoming>SFlow_BuyStockSeq1</bpmn:incoming>
      <bpmn:outgoing>SFlow_OfferPublicInSeq2</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 6: Offer stock to public -->
    <bpmn:task id="Task_OfferPublic" name="Offer stock to public">
      <bpmn:incoming>SFlow_OfferPublicInSeq2</bpmn:incoming>
      <bpmn:outgoing>SFlow_SuccessEndFinal</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 3: Successful Process Completion -->
    <bpmn:endEvent id="EndEvent_Success">
      <bpmn:incoming>SFlow_SuccessEndFinal</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SFlow_SelectUnderwriters" sourceRef="StartEvent_Decision" targetRef="Task_SelectUnderwriters"/>
    
    <bpmn:sequenceFlow id="SFlow_CheckFactsAndRegsLaws" name="" sourceRef="Task_SelectUnderwriters" targetRef="PG_FactCheck_Registration"/>

    <!-- Fact Check Path -->
    <bpmn:sequenceFlow id="SFlow_CheckFactsTask" name="" sourceRef="PG_FactCheck_Registration" targetRef="Task_CheckFacts"/>
    
    <bpmn:sequenceFlow id="SFlow_FactCheckGatewayIn" name="" sourceRef="Task_CheckFacts" targetRef="GW_FactCheck"/>

    <!-- Fact Check Gateway Outcomes -->
    <bpmn:sequenceFlow id="SFlow_ContinueProcessYes" name="Yes" sourceRef="GW_FactCheck" targetRef="PG_RegLawsMerge">
      <bpmn:name>Yes</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SFlow_StopHandlingNo" name="No" sourceRef="GW_FactCheck" targetRef="EndEvent_StopHandling"/>

    <!-- Registration and Law Checks (Parallel) -->
    <bpmn:sequenceFlow id="SFlow_PrepRegStatementSeq" name="" sourceRef="PG_FactCheck_Registration" targetRef="Task_PrepRegStatement"/>
    
    <bpmn:sequenceFlow id="SFlow_CheckBlueSkyLawsIn" name="" sourceRef="PG_FactCheck_Registration" targetRef="Task_CheckBlueSky"/>

    <!-- Merge Registration and Law Checks -->
    <bpmn:sequenceFlow id="SFlow_MergeRegsLawsOut1" name="" sourceRef="Task_PrepRegStatement" targetRef="PG_RegLawsMerge"/>
    
    <bpmn:sequenceFlow id="SFlow_MergeRegsLawsOut2" name="" sourceRef="Task_CheckBlueSky" targetRef="PG_RegLawsMerge"/>

    <!-- Road Show -->
    <bpmn:sequenceFlow id="SFlow_TalkInvestorsSeq" name="" sourceRef="PG_RegLawsMerge" targetRef="Task_RoadShow"/>

    <!-- Wait for SEC Approval -->
    <bpmn:sequenceFlow id="SFlow_WaitSECAnswerIn" name="" sourceRef="Task_RoadShow" targetRef="ECW_SECApproval"/>

    <!-- Gateway Approved Check -->
    <bpmn:sequenceFlow id="SFlow_GatewayApprovedCheckSeq" name="" sourceRef="ECW_SECApproval" targetRef="GW_Approved"/>

    <!-- Approval Outcomes -->
    <bpmn:sequenceFlow id="SFlow_FixPriceYesIn" name="Yes" sourceRef="GW_Approved" targetRef="Task_FixPrice">
      <bpmn:name>Yes</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SFlow_ApprovalNoEndSeq" name="No" sourceRef="GW_Approved" targetRef="EndEvent_NoApproval">
      <bpmn:name>No</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Final Process Flow -->
    <bpmn:sequenceFlow id="SFlow_BuyStockSeq1" name="" sourceRef="Task_FixPrice" targetRef="Task_FirmCommit"/>
    
    <bpmn:sequenceFlow id="SFlow_OfferPublicInSeq2" name="" sourceRef="Task_FirmCommit" targetRef="Task_OfferPublic"/>

    <!-- Final End Event -->
    <bpmn:sequenceFlow id="SFlow_SuccessEndFinal" name="" sourceRef="Task_OfferPublic" targetRef="EndEvent_Success"/>

  </bpmn:process>
</bpmn:definitions>