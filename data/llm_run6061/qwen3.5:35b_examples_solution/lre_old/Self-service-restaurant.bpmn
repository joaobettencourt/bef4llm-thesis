<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_RestaurantService">
    <bpmn:participant id="Participant_Guest" name="Guest" processRef="Process_Guest"/>
    <bpmn:participant id="Participant_Employee" name="Employee" processRef="Process_Employee"/>
    <bpmn:participant id="Participant_Chef" name="Chef" processRef="Process_Chef"/>

    <!-- Message Flows -->
    <bpmn:messageFlow id="Msg_Guest_OrderToEmp" sourceRef="Task_Guest_PlaceOrder" targetRef="StartEvent_Emp_ReceivedOrder"/>
    <bpmn:messageFlow id="Msg_Emp_InformChef" sourceRef="Task_Emp_InformChef" targetRef="StartEvent_Chef_Needed"/>
    <bpmn:messageFlow id="Msg_Chef_InfoEmpMealReady" sourceRef="Task_Chef_InformEmployee" targetRef="IntermediateCatch_Employee_MealReady"/>
  </bpmn:collaboration>

  <!-- Guest Process -->
  <bpmn:process id="Process_Guest" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Guest_Hunger" name="Hunger noticed">
      <bpmn:outgoing>SeqFlow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_Guest_EnterRestaurant" name="Enter restaurant">
      <bpmn:incoming>SeqFlow_01</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_02</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_Guest_ChooseDish" name="Choose dish">
      <bpmn:incoming>SeqFlow_02</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_03</bpmn:outgoing>
    </bpmn:task>

    <bpmn:intermediateCatchEvent id="IntermediateCatch_Guest_WaitTurn" name="Wait for turn">
      <bpmn:incoming>SeqFlow_03</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_04</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:task id="Task_Guest_PlaceOrder" name="Place order">
      <bpmn:incoming>SeqFlow_04</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_05</bpmn:outgoing>
    </bpmn:task>

    <!-- Guest waits for buzzer signal -->
    <bpmn:intermediateCatchEvent id="IntermediateCatch_Guest_MealReady" name="Meal ready">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SeqFlow_05</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_06</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:task id="Task_Guest_PickUpMeal" name="Pick up meal">
      <bpmn:incoming>SeqFlow_06</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_07</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_Guest_Eat" name="Eat meal">
      <bpmn:incoming>SeqFlow_07</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SeqFlow_01" sourceRef="StartEvent_Guest_Hunger" targetRef="Task_Guest_EnterRestaurant"/>
    <bpmn:sequenceFlow id="SeqFlow_02" sourceRef="Task_Guest_EnterRestaurant" targetRef="Task_Guest_ChooseDish"/>
    <bpmn:sequenceFlow id="SeqFlow_03" sourceRef="Task_Guest_ChooseDish" targetRef="IntermediateCatch_Guest_WaitTurn"/>
    <bpmn:sequenceFlow id="SeqFlow_04" sourceRef="IntermediateCatch_Guest_WaitTurn" targetRef="Task_Guest_PlaceOrder"/>
    <bpmn:sequenceFlow id="SeqFlow_05" sourceRef="Task_Guest_PlaceOrder" targetRef="IntermediateCatch_Guest_MealReady"/>
    <bpmn:sequenceFlow id="SeqFlow_06" sourceRef="IntermediateCatch_Guest_MealReady" targetRef="Task_Guest_PickUpMeal"/>
    <bpmn:sequenceFlow id="SeqFlow_07" sourceRef="Task_Guest_PickUpMeal" targetRef="EndEvent_Guest_Eat"/>

  </bpmn:process>

  <!-- Employee Process -->
  <bpmn:process id="Process_Employee" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Emp_ReceivedOrder" name="Order received">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SeqFlow_E01</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_Emp_EnterPOS" name="Enter order into POS">
      <bpmn:incoming>SeqFlow_E01</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_E02</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_Emp_CollectMoney" name="Collect money">
      <bpmn:incoming>SeqFlow_E02</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_E03</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_Emp_SetBuzzer" name="Set up buzzer">
      <bpmn:incoming>SeqFlow_E03</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_E04</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_Emp_HandBuzzer" name="Hand over buzzer">
      <bpmn:incoming>SeqFlow_E04</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_E05</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_Emp_InformChef" name="Inform chef">
      <bpmn:incoming>SeqFlow_E05</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_E06</bpmn:outgoing>
    </bpmn:task>

    <!-- Wait for Chef to finish -->
    <bpmn:intermediateCatchEvent id="IntermediateCatch_Employee_MealReady" name="Meal ready">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SeqFlow_E06</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_E07</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:task id="Task_Emp_RingBuzzer" name="Set off buzzer">
      <bpmn:incoming>SeqFlow_E07</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_E08</bpmn:outgoing>
    </bpmn:task>

    <!-- Event Based Gateway for Guest Reaction vs Timeout -->
    <bpmn:eventBasedGateway id="Gateway_Emp_GuestReaction">
      <bpmn:incoming>SeqFlow_E08</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_E9a</bpmn:outgoing> <!-- Guest Appears -->
      <bpmn:outgoing>SeqFlow_E9b</bpmn:outgoing> <!-- Timeout 5 mins -->
    </bpmn:eventBasedGateway>

    <bpmn:intermediateCatchEvent id="IntermediateCatch_GuestAppears" name="Guest appears">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SeqFlow_E9a</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_E10</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:task id="Task_Emp_HandMeal" name="Hand over meal">
      <bpmn:incoming>SeqFlow_E10</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_E11</bpmn:outgoing>
    </bpmn:task>

    <!-- Timeout Path -->
    <bpmn:intermediateCatchEvent id="IntermediateCatch_Timeout" name="5 minutes">
      <bpmn:timerEventDefinition/>
      <bpmn:incoming>SeqFlow_E9b</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_E12</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:task id="Task_Emp_CallGuest" name="Call guest">
      <bpmn:incoming>SeqFlow_E12</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_E08</bpmn:outgoing> <!-- Loop back to ring buzzer -->
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_Emp_Processed" name="Order processed">
      <bpmn:incoming>SeqFlow_E11</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SeqFlow_E01" sourceRef="StartEvent_Emp_ReceivedOrder" targetRef="Task_Emp_EnterPOS"/>
    <bpmn:sequenceFlow id="SeqFlow_E02" sourceRef="Task_Emp_EnterPOS" targetRef="Task_Emp_CollectMoney"/>
    <bpmn:sequenceFlow id="SeqFlow_E03" sourceRef="Task_Emp_CollectMoney" targetRef="Task_Emp_SetBuzzer"/>
    <bpmn:sequenceFlow id="SeqFlow_E04" sourceRef="Task_Emp_SetBuzzer" targetRef="Task_Emp_HandBuzzer"/>
    <bpmn:sequenceFlow id="SeqFlow_E05" sourceRef="Task_Emp_HandBuzzer" targetRef="Task_Emp_InformChef"/>
    <bpmn:sequenceFlow id="SeqFlow_E06" sourceRef="Task_Emp_InformChef" targetRef="IntermediateCatch_Employee_MealReady"/>
    <bpmn:sequenceFlow id="SeqFlow_E07" sourceRef="IntermediateCatch_Employee_MealReady" targetRef="Task_Emp_RingBuzzer"/>
    <bpmn:sequenceFlow id="SeqFlow_E08" sourceRef="Task_Emp_RingBuzzer" targetRef="Gateway_Emp_GuestReaction"/>
    <bpmn:sequenceFlow id="SeqFlow_E9a" sourceRef="Gateway_Emp_GuestReaction" targetRef="IntermediateCatch_GuestAppears"/>
    <bpmn:sequenceFlow id="SeqFlow_E10" sourceRef="IntermediateCatch_GuestAppears" targetRef="Task_Emp_HandMeal"/>
    <bpmn:sequenceFlow id="SeqFlow_E9b" sourceRef="Gateway_Emp_GuestReaction" targetRef="IntermediateCatch_Timeout"/>
    <bpmn:sequenceFlow id="SeqFlow_E12" sourceRef="IntermediateCatch_Timeout" targetRef="Task_Emp_CallGuest"/>

  </bpmn:process>

  <!-- Chef Process -->
  <bpmn:process id="Process_Chef" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Chef_Needed" name="Meal needed">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SeqFlow_C01</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_Chef_Prepare" name="Prepare meal">
      <bpmn:incoming>SeqFlow_C01</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_C02</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_Chef_PlaceHatch" name="Place in service hatch">
      <bpmn:incoming>SeqFlow_C02</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_C03</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_Chef_InformEmployee" name="Inform employee">
      <bpmn:incoming>SeqFlow_C03</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_C04</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_Chef_Prepared" name="Meal prepared">
      <bpmn:incoming>SeqFlow_C04</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SeqFlow_C01" sourceRef="StartEvent_Chef_Needed" targetRef="Task_Chef_Prepare"/>
    <bpmn:sequenceFlow id="SeqFlow_C02" sourceRef="Task_Chef_Prepare" targetRef="Task_Chef_PlaceHatch"/>
    <bpmn:sequenceFlow id="SeqFlow_C03" sourceRef="Task_Chef_PlaceHatch" targetRef="Task_Chef_InformEmployee"/>
    <bpmn:sequenceFlow id="SeqFlow_C04" sourceRef="Task_Chef_InformEmployee" targetRef="EndEvent_Chef_Prepared"/>

  </bpmn:process>
</bpmn:definitions>