<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_HiringProcess">
    <bpmn:participant id="Participant_Main" name="Recruitment Process" processRef="Process_Hiring"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Hiring" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_FunctionalDept" name="Functional Department">
        <bpmn:flowNodeRef>Start_Demand</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_HR" name="HR Department">
        <bpmn:flowNodeRef>Task_Advertise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckApp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Contract</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Applicant" name="Applicant">
        <bpmn:flowNodeRef>Task_Apply</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="Start_Demand" name="Demand to fill post">
      <bpmn:outgoing>SFlow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Advertise Post (HR) -->
    <bpmn:task id="Task_Advertise" name="Advertise Post">
      <bpmn:incoming>SFlow_1</bpmn:incoming>
      <bpmn:outgoing>SFlow_2</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: Apply (Applicant) -->
    <bpmn:task id="Task_Apply" name="Apply for Post">
      <bpmn:incoming>SFlow_2</bpmn:incoming>
      <bpmn:outgoing>SFlow_3</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3: Check Applications (HR) -->
    <bpmn:task id="Task_CheckApp" name="Check Application">
      <bpmn:incoming>SFlow_3</bpmn:incoming>
      <bpmn:outgoing>SFlow_4</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 4: Conclude Contract (HR) -->
    <bpmn:task id="Task_Contract" name="Conclude Employment Contract">
      <bpmn:incoming>SFlow_4</bpmn:incoming>
      <bpmn:outgoing>SFlow_5</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="End_Filled" name="Post Filled">
      <bpmn:incoming>SFlow_5</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SFlow_1" sourceRef="Start_Demand" targetRef="Task_Advertise"/>
    <bpmn:sequenceFlow id="SFlow_2" name="Post Advertised" sourceRef="Task_Advertise" targetRef="Task_Apply"/>
    <bpmn:sequenceFlow id="SFlow_3" name="Application Submitted" sourceRef="Task_Apply" targetRef="Task_CheckApp"/>
    <bpmn:sequenceFlow id="SFlow_4" name="Applications Checked" sourceRef="Task_CheckApp" targetRef="Task_Contract"/>
    <bpmn:sequenceFlow id="SFlow_5" name="Contract Concluded" sourceRef="Task_Contract" targetRef="End_Filled"/>

  </bpmn:process>
</bpmn:definitions>