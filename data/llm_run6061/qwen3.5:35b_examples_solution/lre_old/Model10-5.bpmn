<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_MPON" name="MPON" processRef="Process_MPON"/>
    <bpmn:participant id="Participant_MPOO" name="MPOO" processRef="Process_MPOO"/>

    <!-- Message Flows -->
    <bpmn:messageFlow id="MessageFlow_1" sourceRef="Task_RequestBid" targetRef="StartEvent_TenderReceived"/>
    <bpmn:messageFlow id="MessageFlow_2" sourceRef="Task_SendTender" targetRef="IntermediateCatchReceiveTender_MPON"/>
    <bpmn:messageFlow id="MessageFlow_3" sourceRef="Task_PlaceOrder" targetRef="StartEvent_OrderReceived_MPOO"/>
    <bpmn:messageFlow id="MessageFlow_4" sourceRef="EndEvent_ConfirmationSent" targetRef="IntermediateCatchReceiveConfirm_MPON"/>
  </bpmn:collaboration>

  <!-- MPON Process -->
  <bpmn:process id="Process_MPON" isExecutable="false">
    <bpmn:startEvent id="StartNoneEvent_MPON" name="">
      <bpmn:outgoing>SFlow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_RequestBid" name="Request a device takeover bid">
      <bpmn:incoming>SFlow_01</bpmn:incoming>
      <bpmn:outgoing>SFlow_02</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Catch Event for receiving Tender -->
    <bpmn:startEvent id="IntermediateCatchReceiveTender_MPON" name="">
       <bpmn:incoming>SFlow_TenderReceived</bpmn:incoming>
      <bpmn:outgoing>SFlow_03</bpmn:outgoing>
    </bpmn:startEvent>

     <!-- Intermediate Catch Event for receiving Confirmation -->
    <bpmn:endEvent id="EndNoneEvent_MPON" name="">
       <bpmn:incoming>SFlow_ConfirmationReceived</bpmn:incoming>
      </bpmn:endEvent> 

    <bpmn:task id="Task_PlaceOrder" name="Place an order at the MPOO">
      <bpmn:incoming>SFlow_03</bpmn:incoming>
       <bpmn:outgoing>SFlow_04</bpmn:outgoing>
    </bpmn:task>

     <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SFlow_01" sourceRef="StartNoneEvent_MPON" targetRef="Task_RequestBid"/>
    
    <!-- Note: In strict BPMN, a sequence flow cannot cross pools. The message flow handles the interaction. 
         To keep valid XML structure within one process definition for this task description: -->
     <bpmn:sequenceFlow id="SFlow_02" sourceRef="Task_RequestBid">
       <!-- Implicitly triggers Message Flow to MPOO Start Event in Collaboration section -->
        targetRef="IntermediateCatchReceiveTender_MPON"/> 
    </bpmn:sequenceFlow>

     <bpmn:sequenceFlow id="SFlow_03" sourceRef="IntermediateCatchReceiveTender_MPON" targetRef="Task_PlaceOrder"/>
     
      <!-- Sequence Flow to End Event (Waiting for confirmation) -->
       <bpmn:sequenceFlow id="SFlow_ConfirmationReceived" name="" sourceRef="EndNoneEvent_MPON"> 
            targetRef="IntermediateCatchReceiveConfirm_MPON"/> 

    </bpmn:process>

  <!-- MPOO Process -->
  <bpmn:process id="Process_MPOO" isExecutable="false">
    
     <!-- Start Event triggered by MPON Request (via Message Flow) -->
    <bpmn:startEvent id="StartEvent_TenderReceived" name="">
      <bpmn:incoming>SFlow_05</bpmn:incoming>
       <bpmn:outgoing>SFlow_MPOO_Start</bpmn:outgoing>
     </bpmn:endEvent> 

    <!-- Start Event triggered by MPON Order (via Message Flow) -->
    <bpmn:startEvent id="StartEvent_OrderReceived_MPOO" name="">
      <bpmn:incoming>SFlow_06</bpmn:incoming>
       <bpmn:outgoing>SFlow_ConfirmOrder</bpmn:outgoing>
     </bpmn:endEvent> 

    <!-- Task 1 -->
    <bpmn:task id="Task_SendTender" name="Send tender for equipment takeover">
      <bpmn:incoming>SFlow_MPOO_Start</bpmn:incoming>
       <bpmn:outgoing>SFlow_05</bpmn:outgoing>
    </bpmn:task>

     <!-- Task 2 -->
    <bpmn:endEvent id="EndNoneEvent_MPOO" name="">
      <bpmn:incoming>SFlow_ConfirmOrder</bpmn:incoming>
       <bpmn:outgoing>SFlow_FinalSendConfirm</bpmn:outgoing> 
     </bpmn:endEvent> 

    <!-- Task 3 -->
    <bpmn:startEvent id="IntermediateCatchReceiveConfirm_MPON" name="">
      <bpmn:incoming>SFlow_ConfirmationReceived</bpmn:incoming>
       <bpmn:outgoing>SFlow_FinalSendConfirm</bpmn:outgoing> 
     </bpmn:startEvent> 

    <!-- Task 4 -->
    <bpmn:endEvent id="EndNoneEvent_MPOO_2" name="">
      <bpmn:incoming>SFlow_ConfirmationSent</bpmn:incoming>
       </bpmn:endEvent>

     <!-- Sequence flows within MPOO process -->
    <bpmn:sequenceFlow id="SFlow_MPOO_Start" sourceRef="StartNoneEvent_MPON"> 
           targetRef="Task_SendTender"/> 

      <bpmn:startEvent id="IntermediateCatchReceiveConfirm_MPON_2" name="">
       </bpmn:startEvent>

    <!-- Corrected Sequence Flows for MPOO -->
     <bpmn:sequenceFlow id="SFlow_ConfirmOrder" sourceRef="StartEvent_OrderReceived_MPOO"> 
           targetRef="Task_SendTender"/> 

      <bpmn:endEvent id="EndNoneEvent_MPOO_3" name="">
       </bpmn:endEvent>

    <!-- Task 5 -->
     <bpmn:task id="Task_ConfirmOrderAndSendMasterData" name="Confirm order and send master data">
      <bpmn:incoming>SFlow_ConfirmationReceived</bpmn:incoming>
       <bpmn:outgoing>SFlow_FinalSendConfirm</bpmn:outgoing> 
     </bpmn:task>

    <!-- Sequence flows within MPOO process -->
    <bpmn:sequenceFlow id="SFlow_05" sourceRef="Task_SendTender"> 
           targetRef="StartEvent_TenderReceived"/> 

      <bpmn:startEvent id="IntermediateCatchReceiveConfirm_MPON_Final" name="">
       </bpmn:startEvent>

    <!-- Sequence flows within MPOO process -->
     <bpmn:sequenceFlow id="SFlow_ConfirmationSent" sourceRef="Task_SendTender"> 
           targetRef="EndNoneEvent_MPOO_3"/> 

  </bpmn:process>

</bpmn:definitions>