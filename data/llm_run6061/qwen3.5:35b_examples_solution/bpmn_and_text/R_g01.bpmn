<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_DIY_Repair" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_DIY_Repair" isExecutable="false">

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Hardware issue detected">
      <bpmn:outgoing>SequenceFlow_StartToEnterDetails</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- User Task: Enter Details -->
    <bpmn:userTask id="UserTask_EnterDetails" name="Enter model and broken part info">
      <bpmn:incoming>SequenceFlow_StartToEnterDetails</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AnalysisStart</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Service Task: Tool Analysis -->
    <bpmn:serviceTask id="ServiceTask_Analysis" name="Tool generates list of materials, tools &amp; ordering choices">
      <bpmn:incoming>SequenceFlow_AnalysisStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_HaveItemsCheck</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Exclusive Gateway: Inventory Check -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_HaveItems" name="Have all required items?">
      <bpmn:incoming>SequenceFlow_HaveItemsCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DirectToInstructions</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NeedSourcing</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Inclusive Gateway: Sourcing Options -->
    <bpmn:inclusiveGateway id="InclusiveGateway_Sourcing" name="Sourcing Options">
      <bpmn:incoming>SequenceFlow_NeedSourcing</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ContactFriends</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_BuyOnline</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- User Task: Contact Friends -->
    <bpmn:userTask id="UserTask_ContactFriends" name="Contact friends (borrow/buy cheap)">
      <bpmn:incoming>SequenceFlow_ContactFriends</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeSourcing1</bpmn:outgoing>
    </bpmn:userTask>

    <!-- User Task / Service Task: Buy Online -->
    <bpmn:userTask id="UserTask_BuyOnline" name="Purchase remaining items online">
      <bpmn:incoming>SequenceFlow_BuyOnline</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeSourcing2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Inclusive Gateway: Sourcing Convergence -->
    <bpmn:inclusiveGateway id="InclusiveGateway_SourcingDone" name="">
      <bpmn:incoming>SequenceFlow_MergeSourcing1</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_MergeSourcing2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToInstructionsMerge</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Inclusive Gateway: Merge Before Instructions -->
    <bpmn:inclusiveGateway id="InclusiveGateway_MergeBeforeInstruction" name="">
      <bpmn:incoming>SequenceFlow_DirectToInstructions</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ToInstructionsMerge</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReceiveInstructions</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Service Task: Instructions -->
    <bpmn:serviceTask id="ServiceTask_Instructions" name="Receive repair instructions">
      <bpmn:incoming>SequenceFlow_ReceiveInstructions</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StartRepair</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Manual Task: Repair -->
    <bpmn:manualTask id="ManualTask_Repair" name="Repair device">
      <bpmn:incoming>SequenceFlow_StartRepair</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckResult</bpmn:outgoing>
    </bpmn:manualTask>

    <!-- Exclusive Gateway: Result Check -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_Result" name="Is issue fixed?">
      <bpmn:incoming>SequenceFlow_CheckResult</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SuccessPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFailurePath_Expert</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Inclusive Gateway for Feedback Options -->
    <bpmn:inclusiveGateway id="InclusiveGateway_Feedback" name="Feedback options">
      <bpmn:incoming>SequenceFlow_SuccessPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WriteReview</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_UploadVideo</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- User Task: Write Review -->
    <bpmn:userTask id="UserTask_WriteReview" name="Send review">
      <bpmn:incoming>SequenceFlow_WriteReview</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeFeedback1</bpmn:outgoing>
    </bpmn:userTask>

    <!-- User Task: Upload Video -->
    <bpmn:userTask id="UserTask_UploadVideo" name="Send video of fixing it">
      <bpmn:incoming>SequenceFlow_UploadVideo</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeFeedback2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Inclusive Gateway for Feedback Convergence -->
    <bpmn:inclusiveGateway id="InclusiveGateway_FeedbackDone" name="">
      <bpmn:incoming>SequenceFlow_MergeFeedback1</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_MergeFeedback2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToEndSuccess</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- End Event: Success -->
    <bpmn:endEvent id="EndEvent_Success" name="Hardware issue fixed">
      <bpmn:incoming>SequenceFlow_ToEndSuccess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- User Task / Manual Task: Send to Expert -->
    <bpmn:userTask id="UserTask_SendExpert" name="Send device to an expert">
      <bpmn:incoming>SequenceFailurePath_Expert</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToEndExpert</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event: Expert -->
    <bpmn:endEvent id="EndEvent_Expert" name="Sent to expert">
      <bpmn:incoming>SequenceFlow_ToEndExpert</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToEnterDetails" sourceRef="StartEvent_1" targetRef="UserTask_EnterDetails"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_AnalysisStart" sourceRef="UserTask_EnterDetails" targetRef="ServiceTask_Analysis"/>

    <bpmn:sequenceFlow id="SequenceFlow_HaveItemsCheck" sourceRef="ServiceTask_Analysis" targetRef="ExclusiveGateway_HaveItems"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_DirectToInstructions" name="Yes (Have items)" sourceRef="ExclusiveGateway_HaveItems" targetRef="InclusiveGateway_MergeBeforeInstruction">
      <bpmn:name>Yes</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_NeedSourcing" name="No (Need items)" sourceRef="ExclusiveGateway_HaveItems" targetRef="InclusiveGateway_Sourcing">
      <bpmn:name>No</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Sourcing Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_ContactFriends" sourceRef="InclusiveGateway_Sourcing" targetRef="UserTask_ContactFriends"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_BuyOnline" sourceRef="InclusiveGateway_Sourcing" targetRef="UserTask_BuyOnline"/>

    <!-- Sourcing Convergence -->
    <bpmn:sequenceFlow id="SequenceFlow_MergeSourcing1" name="" sourceRef="UserTask_ContactFriends" targetRef="InclusiveGateway_SourcingDone">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_MergeSourcing2" name="" sourceRef="UserTask_BuyOnline" targetRef="InclusiveGateway_SourcingDone">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <!-- Merge Before Instructions -->
    <bpmn:sequenceFlow id="SequenceFlow_ToInstructionsMerge" sourceRef="InclusiveGateway_SourcingDone" targetRef="InclusiveGateway_MergeBeforeInstruction"/>

    <!-- Instructions Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_ReceiveInstructions" name="" sourceRef="InclusiveGateway_MergeBeforeInstruction" targetRef="ServiceTask_Instructions">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <!-- Repair Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_StartRepair" name="" sourceRef="ServiceTask_Instructions" targetRef="ManualTask_Repair">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_CheckResult" name="" sourceRef="ManualTask_Repair" targetRef="ExclusiveGateway_Result">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <!-- Result Path Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_SuccessPath" name="Yes (Fixed)" sourceRef="ExclusiveGateway_Result" targetRef="InclusiveGateway_Feedback">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFailurePath_Expert" name="No (Not Fixed)" sourceRef="ExclusiveGateway_Result" targetRef="UserTask_SendExpert"/>

    <!-- Feedback Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_WriteReview" sourceRef="InclusiveGateway_Feedback" targetRef="UserTask_WriteReview"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_UploadVideo" sourceRef="InclusiveGateway_Feedback" targetRef="UserTask_UploadVideo"/>

    <!-- Feedback Convergence -->
    <bpmn:sequenceFlow id="SequenceFlow_MergeFeedback1" name="" sourceRef="UserTask_WriteReview" targetRef="InclusiveGateway_FeedbackDone">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_MergeFeedback2" name="" sourceRef="UserTask_UploadVideo" targetRef="InclusiveGateway_FeedbackDone">
       <bpmn:name/>
    </bpmn:sequenceFlow>

    <!-- End Event Success -->
    <bpmn:sequenceFlow id="SequenceFlow_ToEndSuccess" sourceRef="InclusiveGateway_FeedbackDone" targetRef="EndEvent_Success"/>

    <!-- Expert Path Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_ToEndExpert" name="" sourceRef="UserTask_SendExpert" targetRef="EndEvent_Expert">
      <bpmn:name/>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>