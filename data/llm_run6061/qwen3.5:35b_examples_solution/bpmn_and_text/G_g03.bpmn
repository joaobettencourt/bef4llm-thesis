<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_AccountCreation">
    <bpmn:participant id="Participant_BlizzardTool" name="Blizzard Online Character Generator" processRef="Process_CharacterCreation"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_CharacterCreation" isExecutable="false">
    
    <!-- Lane Set -->
    <bpmn:laneSet>
      <bpmn:lane id="Lane_UserActions" name="User Actions">
        <bpmn:flowNodeRef>StartEvent_NewCharacter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserConfirmEmailLink</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SelectPaymentMethod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EnterCreditCardInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EnterBankAccountInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LoginGame</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SelectRealm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SelectRace</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SelectClass</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EnterCharacterNameLoop</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_SystemChecks" name="System Checks">
        <bpmn:flowNodeRef>ServiceCheckBattleNetAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ReceiveEmailLink</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceCheckSubscription</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceCheckNameAvailability</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_NewCharacter" name="New WoW character wanted">
      <bpmn:outgoing>bpmn_flow_StartToCheckAccount</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Service Task: Check Battle.net Account -->
    <bpmn:serviceTask id="ServiceCheckBattleNetAccount" name="Check existence of battle.net account">
      <bpmn:incoming>bpmn_flow_StartToCheckAccount</bpmn:incoming>
      <bpmn:outgoing>bpmn_flow_CheckAccountResult</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Exclusive Gateway: Account Exists? -->
    <bpmn:exclusiveGateway id="Exclusive_Gateway_AccountExists" name="battle.net account exists?">
      <bpmn:incoming>bpmn_flow_CheckAccountResult</bpmn:incoming>
      <bpmn:outgoing>bpmn_flow_CreateNewAccount</bpmn:outgoing>
      <bpmn:outgoing>bpmn_flow_HasExistingAccount</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Manual Task: Create New Account -->
    <bpmn:manualTask id="Task_CreateAccount" name="Create new battle.net account">
      <bpmn:incoming>bpmn_flow_CreateNewAccount</bpmn:incoming>
      <bpmn:outgoing>bpmn_flow_AccountCreatedTriggerEmail</bpmn:outgoing>
    </bpmn:manualTask>

    <!-- Service Task: Receive Email Link -->
    <bpmn:serviceTask id="ReceiveEmailLink" name="Receive email with confirmation link">
      <bpmn:incoming>bpmn_flow_AccountCreatedTriggerEmail</bpmn:incoming>
      <bpmn:outgoing>bpmn_flow_EmailReceivedToUserAction</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Manual Task: Confirm Email Link -->
    <bpmn:manualTask id="UserConfirmEmailLink" name="Confirm account information via email link">
      <bpmn:incoming>bpmn_flow_EmailReceivedToUserAction</bpmn:incoming>
      <bpmn:outgoing>bpmn_flow_ConfirmationComplete</bpmn:outgoing>
    </bpmn:manualTask>

    <!-- Service Task: Check Subscription -->
    <bpmn:serviceTask id="ServiceCheckSubscription" name="Check WoW subscription">
      <bpmn:incoming>bpmn_flow_HasExistingAccount</bpmn:incoming>
      <bpmn:outgoing>bpmn_flow_SubscriptionResult</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Exclusive Gateway: Subscription Present? -->
    <bpmn:exclusiveGateway id="Exclusive_Gateway_Subscription" name="Subscription present?">
      <bpmn:incoming>bpmn_flow_ConfirmationComplete</bpmn:incoming>
      <bpmn:outgoing>bpmn_flow_NoSubSelectPayment</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Manual Task: Select Payment Method -->
    <bpmn:manualTask id="SelectPaymentMethod" name="Select payment method">
      <bpmn:incoming>bpmn_flow_NoSubSelectPayment</bpmn:incoming>
      <bpmn:outgoing>bpmn_flow_PaymentSelectionResult</bpmn:outgoing>
    </bpmn:manualTask>

    <!-- Exclusive Gateway: Payment Method? -->
    <bpmn:exclusiveGateway id="Exclusive_Gateway_PaymentMethod" name="Payment Method?">
      <bpmn:incoming>bpmn_flow_PaymentSelectionResult</bpmn:incoming>
      <bpmn:outgoing>bpmn_flow_CreditCardPath</bpmn:outgoing>
      <bpmn:outgoing>bpmn_flow_BankAccountPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Manual Task: Enter Credit Card Info -->
    <bpmn:manualTask id="EnterCreditCardInfo" name="Enter credit card information">
      <bpmn:incoming>bpmn_flow_CreditCardPath</bpmn:incoming>
      <bpmn:outgoing>bpmn_flow_CCEntryComplete</bpmn:outgoing>
    </bpmn:manualTask>

    <!-- Manual Task: Enter Bank Account Info -->
    <bpmn:manualTask id="EnterBankAccountInfo" name="Enter bank account information">
      <bpmn:incoming>bpmn_flow_BankAccountPath</bpmn:incoming>
      <bpmn:outgoing>bpmn_flow_BankEntryComplete</bpmn:outgoing>
    </bpmn:manualTask>

    <!-- Exclusive Gateway: Payment Converge -->
    <bpmn:exclusiveGateway id="Exclusive_Gateway_PaymentConverge" name="">
      <bpmn:incoming>bpmn_flow_CCEntryComplete</bpmn:incoming>
      <bpmn:incoming>bpmn_flow_BankEntryComplete</bpmn:incoming>
      <bpmn:outgoing>bpmn_flow_PaymentConvergeToLoginCheck</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Manual Task: Login Game -->
    <bpmn:manualTask id="LoginGame" name="Log into game">
      <bpmn:incoming>bpmn_flow_PaymentConvergeToLoginCheck</bpmn:incoming>
      <bpmn:outgoing>bpmn_flow_LoginCompleteDiverge</bpmn:outgoing>
    </bpmn:manualTask>

    <!-- Parallel Gateway Diverging for Character Selection -->
    <bpmn:parallelGateway id="Parallel_Gateway_CharacterSelection" name="">
      <bpmn:incoming>bpmn_flow_LoginCompleteDiverge</bpmn:incoming>
      <bpmn:outgoing>bpmn_flow_SelectRealmPath</bpmn:outgoing>
      <bpmn:outgoing>bpmn_flow_SelectRacePath</bpmn:outgoing>
      <bpmn:outgoing>bpmn_flow_SelectClassPath</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Manual Task: Select Realm -->
    <bpmn:manualTask id="SelectRealm" name="Select realm of your character">
      <bpmn:incoming>bpmn_flow_SelectRealmPath</bpmn:incoming>
      <bpmn:outgoing>bpmn_flow_RealmSelectedConverge</bpmn:outgoing>
    </bpmn:manualTask>

    <!-- Manual Task: Select Race -->
    <bpmn:manualTask id="SelectRace" name="Select race of your character">
      <bpmn:incoming>bpmn_flow_SelectRacePath</bpmn:incoming>
      <bpmn:outgoing>bpmn_flow_RaceSelectedConverge</bpmn:outgoing>
    </bpmn:manualTask>

    <!-- Manual Task: Select Class -->
    <bpmn:manualTask id="SelectClass" name="Select class of your character">
      <bpmn:incoming>bpmn_flow_SelectClassPath</bpmn:incoming>
      <bpmn:outgoing>bpmn_flow_ClassSelectedConverge</bpmn:outgoing>
    </bpmn:manualTask>

    <!-- Parallel Gateway Converging Character Selection -->
    <bpmn:parallelGateway id="Parallel_Gateway_CharacterSelectionEnd" name="">
      <bpmn:incoming>bpmn_flow_RealmSelectedConverge</bpmn:incoming>
      <bpmn:incoming>bpmn_flow_RaceSelectedConverge</bpmn:incoming>
      <bpmn:incoming>bpmn_flow_ClassSelectedConverge</bpmn:incoming>
      <bpmn:outgoing>bpmn_flow_CharacterDetailsCompleteToNameLoop</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Manual Task: Enter Character Name (Start of Loop) -->
    <bpmn:manualTask id="EnterCharacterNameLoop" name="Enter character name">
      <bpmn:incoming>bpmn_flow_CharacterDetailsCompleteToNameLoop</bpmn:incoming>
      <bpmn:outgoing>bpmn_flow_NameEnteredCheckAvailability</bpmn:outgoing>
    </bpmn:manualTask>

    <!-- Service Task: Check Name Availability -->
    <bpmn:serviceTask id="ServiceCheckNameAvailability" name="Check availability of character name">
      <bpmn:incoming>bpmn_flow_NameEnteredCheckAvailability</bpmn:incoming>
      <bpmn:outgoing>bpmn_flow_CheckResultToGateway</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Exclusive Gateway: Name Available? -->
    <bpmn:exclusiveGateway id="Exclusive_Gateway_NameAvailable" name="Character name available?">
      <bpmn:incoming>bpmn_flow_CheckResultToGateway</bpmn:incoming>
      <bpmn:outgoing>bpmn_flow_NoNameLoopBack</bpmn:outgoing>
      <bpmn:outgoing>bpmn_flow_YesNameSuccessPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Service Task: Receive Confirmation -->
    <bpmn:serviceTask id="ReceiveConfirmation" name="Receive confirmation and character selfies">
      <bpmn:incoming>bpmn_flow_YesNameSuccessPath</bpmn:incoming>
      <bpmn:outgoing>bpmn_flow_ConfirmationToEndEvent</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_CharacterCreated" name="Character created">
      <bpmn:incoming>bpmn_flow_ConfirmationToEndEvent</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    
    <!-- Account Setup Flow -->
    <bpmn:sequenceFlow id="bpmn_flow_StartToCheckAccount" sourceRef="StartEvent_NewCharacter" targetRef="ServiceCheckBattleNetAccount"/>
    <bpmn:sequenceFlow id="bpmn_flow_CheckAccountResult" name="" sourceRef="ServiceCheckBattleNetAccount" targetRef="Exclusive_Gateway_AccountExists">
      <bpmn:name/>
    </bpmn:sequenceFlow>
    
    <!-- No Account Path -->
    <bpmn:sequenceFlow id="bpmn_flow_CreateNewAccount" name="no" sourceRef="Exclusive_Gateway_AccountExists" targetRef="Task_CreateAccount">
      <bpmn:name/>
    </bpmn:sequenceFlow>
    
    <!-- Email Flow -->
    <bpmn:sequenceFlow id="bpmn_flow_AccountCreatedTriggerEmail" name="" sourceRef="Task_CreateAccount" targetRef="ReceiveEmailLink"/>
    <bpmn:sequenceFlow id="bpmn_flow_EmailReceivedToUserAction" name="" sourceRef="ReceiveEmailLink" targetRef="UserConfirmEmailLink"/>
    
    <!-- Confirm Flow -->
    <bpmn:sequenceFlow id="bpmn_flow_ConfirmationComplete" name="" sourceRef="UserConfirmEmailLink" targetRef="ServiceCheckSubscription">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <!-- Existing Account Path (Converge to Subscription Check) -->
    <bpmn:sequenceFlow id="bpmn_flow_HasExistingAccount" name="yes" sourceRef="Exclusive_Gateway_AccountExists" targetRef="ServiceCheckSubscription">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <!-- Subscription Flow -->
    <bpmn:sequenceFlow id="bpmn_flow_SubscriptionResult" name="" sourceRef="ServiceCheckSubscription" targetRef="Exclusive_Gateway_Subscription"/>
    
    <!-- No Sub Path (Payment) -->
    <bpmn:sequenceFlow id="bpmn_flow_NoSubSelectPayment" name="no" sourceRef="Exclusive_Gateway_Subscription" targetRef="SelectPaymentMethod">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <!-- Payment Selection -->
    <bpmn:sequenceFlow id="bpmn_flow_PaymentSelectionResult" name="" sourceRef="SelectPaymentMethod" targetRef="Exclusive_Gateway_PaymentMethod"/>
    
    <!-- Credit Card Path -->
    <bpmn:sequenceFlow id="bpmn_flow_CreditCardPath" name="Credit card" sourceRef="Exclusive_Gateway_PaymentMethod" targetRef="EnterCreditCardInfo">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <!-- Bank Account Path -->
    <bpmn:sequenceFlow id="bpmn_flow_BankAccountPath" name="Bank account" sourceRef="Exclusive_Gateway_PaymentMethod" targetRef="EnterBankAccountInfo">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <!-- Payment Convergence -->
    <bpmn:sequenceFlow id="bpmn_flow_CCEntryComplete" name="" sourceRef="EnterCreditCardInfo" targetRef="Exclusive_Gateway_PaymentConverge"/>
    <bpmn:sequenceFlow id="bpmn_flow_BankEntryComplete" name="" sourceRef="EnterBankAccountInfo" targetRef="Exclusive_Gateway_PaymentConverge"/>

    <!-- Payment to Login Convergence -->
    <bpmn:sequenceFlow id="bpmn_flow_PaymentConvergeToLoginCheck" name="" sourceRef="Exclusive_Gateway_PaymentConverge" targetRef="LoginGame">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <!-- Login to Character Selection -->
    <bpmn:sequenceFlow id="bpmn_flow_LoginCompleteDiverge" name="" sourceRef="LoginGame" targetRef="Parallel_Gateway_CharacterSelection"/>
    
    <!-- Parallel Divergence for Realm/Race/Class -->
    <bpmn:sequenceFlow id="bpmn_flow_SelectRealmPath" name="" sourceRef="Parallel_Gateway_CharacterSelection" targetRef="SelectRealm">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="bpmn_flow_SelectRacePath" name="" sourceRef="Parallel_Gateway_CharacterSelection" targetRef="SelectRace"/>
    
    <bpmn:sequenceFlow id="bpmn_flow_SelectClassPath" name="" sourceRef="Parallel_Gateway_CharacterSelection" targetRef="SelectClass"/>

    <!-- Parallel Convergence -->
    <bpmn:sequenceFlow id="bpmn_flow_RealmSelectedConverge" name="" sourceRef="SelectRealm" targetRef="Parallel_Gateway_CharacterSelectionEnd">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="bpmn_flow_RaceSelectedConverge" name="" sourceRef="SelectRace" targetRef="Parallel_Gateway_CharacterSelectionEnd"/>
    
    <bpmn:sequenceFlow id="bpmn_flow_ClassSelectedConverge" name="" sourceRef="SelectClass" targetRef="Parallel_Gateway_CharacterSelectionEnd"/>

    <!-- Name Selection Loop -->
    <bpmn:sequenceFlow id="bpmn_flow_CharacterDetailsCompleteToNameLoop" name="" sourceRef="Parallel_Gateway_CharacterSelectionEnd" targetRef="EnterCharacterNameLoop">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <!-- Name Check Flow -->
    <bpmn:sequenceFlow id="bpmn_flow_NameEnteredCheckAvailability" name="" sourceRef="EnterCharacterNameLoop" targetRef="ServiceCheckNameAvailability"/>
    
    <bpmn:sequenceFlow id="bpmn_flow_CheckResultToGateway" name="" sourceRef="ServiceCheckNameAvailability" targetRef="Exclusive_Gateway_NameAvailable">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <!-- Loop Back Path -->
    <bpmn:sequenceFlow id="bpmn_flow_NoNameLoopBack" name="no" sourceRef="Exclusive_Gateway_NameAvailable" targetRef="EnterCharacterNameLoop">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <!-- Success Path -->
    <bpmn:sequenceFlow id="bpmn_flow_YesNameSuccessPath" name="yes" sourceRef="Exclusive_Gateway_NameAvailable" targetRef="ReceiveConfirmation"/>
    
    <!-- Final Confirmation to End Event -->
    <bpmn:sequenceFlow id="bpmn_flow_ConfirmationToEndEvent" name="" sourceRef="ReceiveConfirmation" targetRef="EndEvent_CharacterCreated">
      <bpmn:name/>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>