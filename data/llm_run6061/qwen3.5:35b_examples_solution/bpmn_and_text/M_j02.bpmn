<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_LuxuryAirplane">
    <bpmn:participant id="Participant_Manufacturing" name="Luxury Airplane Manufacturing Process" processRef="Process_AirplaneManufacturing"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_AirplaneManufacturing" isExecutable="false">
    
    <!-- Lane Set for different teams -->
    <bpmn:laneSet>
      <bpmn:lane id="Lane_CustomerService" name="Customer Service">
        <bpmn:flowNodeRef>StartEvent_ReceiveOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DefineRequirements</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Manufacturing" name="Manufacturing Teams">
        <bpmn:flowNodeRef>InclusiveGateway_CheckCustomization</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RussianTeam_VodkaBar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IrishTeam_WhiskeyBar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_PartsReceived</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Assembly" name="Assembly">
        <bpmn:flowNodeRef>Task_AssembleInterior</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Testing" name="Testing & Delivery">
        <bpmn:flowNodeRef>InclusiveGateway_TestSuccessful</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateTestProtocol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DeliverPlane</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_ReceiveOrder" name="Customer Order Received">
      <bpmn:description>Customer specifies bars, seats, color, water amount</bpmn:description>
      <bpmn:outgoing>bpmn_flow_OrderToRequirements</bpmn:flowNodeRef>
    </bpmn:startEvent>

    <!-- Task for Requirements Definition -->
    <bpmn:userTask id="Task_DefineRequirements" name="Define Custom Interior Specifications">
      <bpmn:description>Create specifications based on customer preferences (5 bars, seats, color, water)</bpmn:description>
      <bpmn:incoming>bpmn_flow_OrderToRequirements</bpmn:flowNodeRef>
      <bpmn:outgoing>bpmn_flow_RequirementsToGateway</bpmn:flowNodeRef>
    </bpmn:userTask>

    <!-- Inclusive Gateway for Customization Check -->
    <bpmn:inclusiveGateway id="InclusiveGateway_CheckCustomization" name="Check Base Model">
      <bpmn:description>Determine if customization needed beyond base model</bpmn:description>
      <bpmn:incoming>bpmn_flow_RequirementsToGateway</bpmn:flowNodeRef>
      <bpmn:outgoing>bpmn_flow_ManufacturingTeams_Start</bpmn:flowNodeRef>
    </bpmn:inclusiveGateway>

    <!-- Parallel Manufacturing Tasks -->
    <bpmn:userTask id="Task_RussianTeam_VodkaBar" name="Manufacture Vodka Bar (Russian Team)">
      <bpmn:description>Russian team produces vodka bar component</bpmn:description>
      <bpmn:incoming>bpmn_flow_ManufacturingTeams_Start</bpmn:flowNodeRef>
      <bpmn:outgoing>bpmn_flow_VodkaBarToConverge</bpmn:flowNodeRef>
    </bpmn:userTask>

    <bpmn:userTask id="Task_IrishTeam_WhiskeyBar" name="Manufacture Whiskey Bar (Irish Team)">
      <bpmn:description>Irish team produces whiskey bar component</bpmn:description>
      <bpmn:incoming>bpmn_flow_ManufacturingTeams_Start2</bpmn:flowNodeRef>
      <bpmn:outgoing>bpmn_flow_WhiskeyBarToConverge</bpmn:flowNodeRef>
    </bpmn:userTask>

    <!-- Inclusive Gateway for Parts Received -->
    <bpmn:inclusiveGateway id="InclusiveGateway_PartsReceived" name="All Parts Received">
      <bpmn:description>All custom components received from manufacturing teams</bpmn:description>
      <bpmn:incoming>bpmn_flow_VodkaBarToConverge</bpmn:flowNodeRef>
      <bpmn:incoming>bpmn_flow_WhiskeyBarToConverge</bpmn:flowNodeRef>
      <bpmn:outgoing>bpmn_flow_PartsToAssembly</bpmn:flowNodeRef>
    </bpmn:inclusiveGateway>

    <!-- Task for Interior Assembly -->
    <bpmn:userTask id="Task_AssembleInterior" name="Assemble Plane Interior">
      <bpmn:description>Install custom interior components into base airplane model</bpmn:description>
      <bpmn:incoming>bpmn_flow_PartsToAssembly</bpmn:flowNodeRef>
      <bpmn:outgoing>bpmn_flow_AssemblyToTestFlight</bpmn:flowNodeRef>
    </bpmn:userTask>

    <!-- Task for Test Flight -->
    <bpmn:userTask id="Task_TestFlight" name="Conduct Test Flight">
      <bpmn:description>Pilot performs test flight of completed airplane</bpmn:description>
      <bpmn:incoming>bpmn_flow_AssemblyToTestFlight</bpmn:flowNodeRef>
      <bpmn:outgoing>bpmn_flow_TestFlightToProtocol</bpmn:flowNodeRef>
    </bpmn:userTask>

    <!-- Task for Test Protocol Creation -->
    <bpmn:serviceTask id="Task_CreateTestProtocol" name="Create Test Protocol">
      <bpmn:description>Create and distribute test protocol to company and customer</bpmn:description>
      <bpmn:incoming>bpmn_flow_TestFlightToProtocol</bpmn:flowNodeRef>
      <bpmn:outgoing>bpmn_flow_ProtocolToGateway</bpmn:flowNodeRef>
    </bpmn:serviceTask>

    <!-- Exclusive Gateway for Test Results -->
    <bpmn:exclusiveGateway id="InclusiveGateway_TestSuccessful" name="Test Successful?">
      <bpmn:description>Evaluate test flight results and protocol</bpmn:description>
      <bpmn:incoming>bpmn_flow_ProtocolToGateway</bpmn:flowNodeRef>
      <bpmn:outgoing>bpmn_flow_TestPass_ToDelivery</bpmn:flowNodeRef>
      <bpmn:outgoing>bpmn_flow_TestFail_FixProblems</bpmn:flowNodeRef>
    </bpmn:exclusiveGateway>

    <!-- Manual Task for Fixing Problems -->
    <bpmn:userTask id="Task_FixProblems" name="Fix Test Flight Issues">
      <bpmn:description>Address and resolve any issues identified during test flight</bpmn:description>
      <bpmn:incoming>bpmn_flow_TestFail_FixProblems</bpmn:flowNodeRef>
      <bpmn:outgoing>bpmn_flow_ProblemFixed_ToTestFlight</bpmn:flowNodeRef>
    </bpmn:userTask>

    <!-- Task for Delivery -->
    <bpmn:userTask id="Task_DeliverPlane" name="Deliver Plane to Customer">
      <bpmn:description>Transport completed airplane to customer location</bpmn:description>
      <bpmn:incoming>bpmn_flow_TestPass_ToDelivery</bpmn:flowNodeRef>
      <bpmn:outgoing>bpmn_flow_DeliveryToConfirmation</bpmn:flowNodeRef>
    </bpmn:userTask>

    <!-- Exclusive Gateway for Customer Satisfaction -->
    <bpmn:exclusiveGateway id="InclusiveGateway_CustomerSatisfied" name="Customer Satisfied?">
      <bpmn:description>Check if customer accepts the delivered airplane</bpmn:description>
      <bpmn:incoming>bpmn_flow_DeliveryToConfirmation</bpmn:flowNodeRef>
      <bpmn:outgoing>bpmn_flow_CustomerAccepts_Complete</bpmn:flowNodeRef>
      <bpmn:outgoing>bpmn_flow_CustomerRejects_Renegotiate</bpmn:flowNodeRef>
    </bpmn:exclusiveGateway>

    <!-- Manual Task for Renegotiation -->
    <bpmn:userTask id="Task_RenegotiateContract" name="Renegotiate Contract">
      <bpmn:description>Negotiate contract adjustments with customer</bpmn:description>
      <bpmn:incoming>bpmn_flow_CustomerRejects_Renegotiate</bpmn:flowNodeRef>
      <bpmn:outgoing>bpmn_flow_ContractRenegotiated_ToDelivery</bpmn:flowNodeRef>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_OrderComplete" name="Order Completed">
      <bpmn:description>All requirements fulfilled and customer confirmed acceptance</bpmn:description>
      <bpmn:incoming>bpmn_flow_CustomerAccepts_Complete</bpmn:flowNodeRef>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="bpmn_flow_OrderToRequirements" name="" sourceRef="StartEvent_ReceiveOrder" targetRef="Task_DefineRequirements"/>
    
    <bpmn:sequenceFlow id="bpmn_flow_RequirementsToGateway" name="" sourceRef="Task_DefineRequirements" targetRef="InclusiveGateway_CheckCustomization"/>
    
    <bpmn:sequenceFlow id="bpmn_flow_ManufacturingTeams_Start" name="" sourceRef="InclusiveGateway_CheckCustomization" targetRef="Task_RussianTeam_VodkaBar">
      <bpmn:name>Start Manufacturing</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="bpmn_flow_ManufacturingTeams_Start2" name="" sourceRef="InclusiveGateway_CheckCustomization" targetRef="Task_IrishTeam_WhiskeyBar">
      <bpmn:name>Start Manufacturing</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="bpmn_flow_VodkaBarToConverge" name="" sourceRef="Task_RussianTeam_VodkaBar" targetRef="InclusiveGateway_PartsReceived"/>
    
    <bpmn:sequenceFlow id="bpmn_flow_WhiskeyBarToConverge" name="" sourceRef="Task_IrishTeam_WhiskeyBar" targetRef="InclusiveGateway_PartsReceived"/>
    
    <bpmn:sequenceFlow id="bpmn_flow_PartsToAssembly" name="" sourceRef="InclusiveGateway_PartsReceived" targetRef="Task_AssembleInterior"/>
    
    <bpmn:sequenceFlow id="bpmn_flow_AssemblyToTestFlight" name="" sourceRef="Task_AssembleInterior" targetRef="Task_TestFlight"/>
    
    <bpmn:sequenceFlow id="bpmn_flow_TestFlightToProtocol" name="" sourceRef="Task_TestFlight" targetRef="Task_CreateTestProtocol"/>
    
    <bpmn:sequenceFlow id="bpmn_flow_ProtocolToGateway" name="" sourceRef="Task_CreateTestProtocol" targetRef="InclusiveGateway_TestSuccessful"/>
    
    <bpmn:sequenceFlow id="bpmn_flow_TestPass_ToDelivery" name="Yes - Test Passed" sourceRef="InclusiveGateway_TestSuccessful" targetRef="Task_DeliverPlane">
      <bpmn:name>Test Successful</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="bpmn_flow_TestFail_FixProblems" name="No - Issues Found" sourceRef="InclusiveGateway_TestSuccessful" targetRef="Task_FixProblems">
      <bpmn:name>Test Failed</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="bpmn_flow_ProblemFixed_ToTestFlight" name="" sourceRef="Task_FixProblems" targetRef="InclusiveGateway_TestSuccessful"/>
    
    <bpmn:sequenceFlow id="bpmn_flow_DeliveryToConfirmation" name="" sourceRef="Task_DeliverPlane" targetRef="InclusiveGateway_CustomerSatisfied"/>
    
    <bpmn:sequenceFlow id="bpmn_flow_CustomerAccepts_Complete" name="Yes - Customer Accepts" sourceRef="InclusiveGateway_CustomerSatisfied" targetRef="EndEvent_OrderComplete">
      <bpmn:name>Customer Satisfied</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="bpmn_flow_CustomerRejects_Renegotiate" name="No - Customer Rejects" sourceRef="InclusiveGateway_CustomerSatisfied" targetRef="Task_RenegotiateContract">
      <bpmn:name>Customer Not Satisfied</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="bpmn_flow_ContractRenegotiated_ToDelivery" name="" sourceRef="Task_RenegotiateContract" targetRef="InclusiveGateway_CustomerSatisfied"/>

  </bpmn:process>
</bpmn:definitions>