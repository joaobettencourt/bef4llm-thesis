<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_WorkLiveAustria">
    <bpmn:participant id="Participant_Applicant" name="Applicant Process" processRef="Process_VisaApplication"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_VisaApplication" isExecutable="false">
    
    <!-- Lane Set -->
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Applicant" name="Applicant">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_VisaTypeCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckPassportValidity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_DocumentCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OrganizeAccommodationBank</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BPMNEvent_VisaApprovedEnd</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Begin Visa Application Process">
      <bpmn:outgoing>bpmn_flow_StartToVisaType</bpmn:flowNodeRef>
    </bpmn:startEvent>

    <!-- Inclusive Gateway for Visa Type Check -->
    <bpmn:inclusiveGateway id="InclusiveGateway_VisaTypeCheck" name="Determine Visa Type">
      <bpmn:incoming>bpmn_flow_StartToVisaType</bpmn:flowNodeRef>
      <bpmn:outgoing>InclusiveGateway_TerritorialCheck_1</bpmn:flowNodeRef>
    </bpmn:inclusiveGateway>

    <!-- Exclusive Gateway for Territorial Competence -->
    <bpmn:exclusiveGateway id="InclusiveGateway_TerritorialCheck" name="Territorial Check">
      <bpmn:incoming>InclusiveGateway_VisaTypeCheck_1</bpmn:flowNodeRef>
      <bpmn:outgoing>Task_CheckPassportValidity_2</bpmn:flowNodeRef>
    </bpmn:exclusiveGateway>

    <!-- Task for Passport Validity Check -->
    <bpmn:userTask id="Task_CheckPassportValidity" name="Check Passport Validity">
      <bpmn:description>Verify passport validity exceeds visa duration by 3 months, issued within last 10 years</bpmn:description>
      <bpmn:incoming>InclusiveGateway_TerritorialCheck_2</bpmn:flowNodeRef>
      <bpmn:outgoing>bpmn_flow_PassportToDocuments</bpmn:flowNodeRef>
    </bpmn:userTask>

    <!-- Task for Document Preparation -->
    <bpmn:userTask id="Task_PrepareDocuments" name="Prepare Required Documents">
      <bpmn:description>Collect visa application form, passport photo (35x45mm), health insurance proof</bpmn:description>
      <bpmn:incoming>bpmn_flow_PassportToDocuments</bpmn:flowNodeRef>
      <bpmn:outgoing>InclusiveGateway_DocumentCheck_1</bpmn:flowNodeRef>
    </bpmn:userTask>

    <!-- Inclusive Gateway for Document Check -->
    <bpmn:inclusiveGateway id="InclusiveGateway_DocumentCheck" name="Document Verification">
      <bpmn:incoming>InclusiveGateway_VisaTypeCheck_1</bpmn:flowNodeRef>
      <bpmn:outgoing>bpmn_flow_CheckDocumentsToAccommodation</bpmn:flowNodeRef>
    </bpmn:inclusiveGateway>

    <!-- Task for Accommodation Organization -->
    <bpmn:userTask id="Task_OrganizeAccommodationBank" name="Organize Accommodation &amp; Bank Account">
      <bpmn:description>Negotiate and secure accommodation in Austria, open bank account</bpmn:description>
      <bpmn:incoming>bpmn_flow_CheckDocumentsToAccommodation</bpmn:flowNodeRef>
      <bpmn:outgoing>InclusiveGateway_AccommodationCheck_1</bpmn:flowNodeRef>
    </bpmn:userTask>

    <!-- Inclusive Gateway for Accommodation Check -->
    <bpmn:inclusiveGateway id="InclusiveGateway_AccommodationCheck" name="Accommodation &amp; Bank Account Complete">
      <bpmn:incoming>bpmn_flow_CheckDocumentsToAccommodation</bpmn:flowNodeRef>
      <bpmn:outgoing>InclusiveGateway_VisaTypeCheck_1</bpmn:flowNodeRef>
    </bpmn:inclusiveGateway>

    <!-- End Event for Visa Approved -->
    <bpmn:endEvent id="BPMNEvent_VisaApprovedEnd" name="Visa Application Processed">
      <bpmn:description>Rot-Weiss-Rot Card issued or visa granted</bpmn:description>
      <bpmn:incoming>BPMNEvent_RepresentativeEnd_1</bpmn:flowNodeRef>
    </bpmn:endEvent>

    <!-- Flow Definitions -->
    <bpmn:sequenceFlow id="bpmn_flow_StartToVisaType" name="Start Application Process" sourceRef="StartEvent_1" targetRef="InclusiveGateway_VisaTypeCheck">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="InclusiveGateway_TerritorialCheck_1" sourceRef="InclusiveGateway_VisaTypeCheck" name="Determine Competent Office" targetRef="InclusiveGateway_TerritorialCheck"/>
    
    <bpmn:sequenceFlow id="Task_CheckPassportValidity_2" sourceRef="InclusiveGateway_TerritorialCheck" name="Verify Passport Requirements" targetRef="Task_CheckPassportValidity">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="bpmn_flow_PassportToDocuments" sourceRef="Task_CheckPassportValidity" name="Proceed to Document Preparation" targetRef="Task_PrepareDocuments"/>
    
    <bpmn:sequenceFlow id="InclusiveGateway_DocumentCheck_1" sourceRef="Task_PrepareDocuments" name="Submit Documents for Review" targetRef="InclusiveGateway_DocumentCheck">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="bpmn_flow_CheckDocumentsToAccommodation" sourceRef="InclusiveGateway_DocumentCheck" name="Complete Document Verification" targetRef="Task_OrganizeAccommodationBank"/>
    
    <bpmn:sequenceFlow id="InclusiveGateway_AccommodationCheck_1" sourceRef="Task_OrganizeAccommodationBank" name="Proceed to Bank Account" targetRef="BPMNEvent_VisaApprovedEnd">
      <bpmn:name/>
    </bpmn:sequenceFlow>

  </bpmn:process>

</bpmn:definitions>