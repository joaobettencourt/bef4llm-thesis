<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Contract_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_Contract">
    <bpmn:participant id="Participant_ContractProcess" name="Contract Project Process" processRef="Process_Contract"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Contract" isExecutable="false">
    
    <!-- Lane Set -->
    <bpmn:laneSet>
      <bpmn:lane id="Lane_ProjectManagement" name="Project Management">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_QueryShops</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BPMNTask_CompareDetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BPMNTask_CreateOrderList</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_SupplierManagement" name="Supplier Management">
        <bpmn:flowNodeRef>BPMNTask_QueryWebShops</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_OrderParts</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Production" name="Production">
        <bpmn:flowNodeRef>BPMNTask_BuildItem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_CheckStockLevel</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Contract Project">
      <bpmn:outgoing>bpmn_flow_StartToQuery</bpmn:flowNodeRef>
    </bpmn:startEvent>

    <!-- Task to Query Web Shops -->
    <bpmn:task id="BPMNTask_QueryWebShops" name="Query webshops for parts">
      <bpmn:incoming>bpmn_flow_StartToQuery</bpmn:flowNodeRef>
      <bpmn:outgoing>bpmn_flow_QueriesComplete</bpmn:flowNodeRef>
    </bpmn:task>

    <!-- Inclusive Gateway for Querying Multiple Shops -->
    <bpmn:inclusiveGateway id="InclusiveGateway_QueryShops" name="Query All Webshops">
      <bpmn:incoming>bpmn_flow_QueriesComplete</bpmn:flowNodeRef>
      <bpmn:outgoing>BPMNTask_CompareDetails_Out1</bpmn:flowNodeRef>
    </bpmn:inclusiveGateway>

    <!-- Task to Compare Details -->
    <bpmn:task id="BPMNTask_CompareDetails" name="Compare prices and delivery times">
      <bpmn:incoming>BPMNTask_QueryWebShops_Out1</bpmn:flowNodeRef>
      <bpmn:outgoing>bpmn_flow_CreateOrderList</bpmn:flowNodeRef>
    </bpmn:task>

    <!-- Task to Create Order List -->
    <bpmn:task id="BPMNTask_CreateOrderList" name="Create list of parts from each shop">
      <bpmn:incoming>bpmn_flow_CreateOrderList</bpmn:flowNodeRef>
      <bpmn:outgoing>BPMNTask_OrderParts_In1</bpmn:flowNodeRef>
    </bpmn:task>

    <!-- Inclusive Gateway for Ordering Parts -->
    <bpmn:inclusiveGateway id="InclusiveGateway_OrderParts" name="Order from Cheapest Shops">
      <bpmn:incoming>BPMNTask_CreateOrderList_Out1</bpmn:flowNodeRef>
      <bpmn:outgoing>bpmn_flow_PartsOrdered</bpmn:flowNodeRef>
    </bpmn:inclusiveGateway>

    <!-- Task to Order Parts -->
    <bpmn:task id="BPMNTask_OrderParts" name="Order parts (cheapest)">
      <bpmn:incoming>BPMNTask_CreateOrderList_Out1</bpmn:flowNodeRef>
      <bpmn:outgoing>bpmn_flow_PartsOrdered</bpmn:flowNodeRef>
    </bpmn:task>

    <!-- Intermediate Catch Event for Part Arrival -->
    <bpmn:intermediateCatchEvent id="BPMNEvent_PartArrived" name="Part Arrived">
      <bpmn:incoming>bpmn_flow_PartsOrdered</bpmn:flowNodeRef>
      <bpmn:outgoing>BPMNTask_BuildItem_In1</bpmn:flowNodeRef>
    </bpmn:intermediateCatchEvent>

    <!-- Task to Build Item -->
    <bpmn:task id="BPMNTask_BuildItem" name="Build item">
      <bpmn:incoming>BPMNEvent_PartArrived_Out1</bpmn:flowNodeRef>
      <bpmn:outgoing>bpmn_flow_CheckStockLevel</bpmn:flowNodeRef>
    </bpmn:task>

    <!-- Inclusive Gateway for Stock Check -->
    <bpmn:inclusiveGateway id="InclusiveGateway_StockCheck" name="Reorder Parts?">
      <bpmn:incoming>bpmn_flow_CheckStockLevel</bpmn:flowNodeRef>
      <bpmn:outgoing>BPMNTask_UpdateAccounting_In1</bpmn:flowNodeRef>
    </bpmn:inclusiveGateway>

    <!-- Inclusive Gateway for Stock Level Check -->
    <bpmn:exclusiveGateway id="InclusiveGateway_CheckStockLevel" name="Check Stock">
      <bpmn:incoming>BPMNTask_UpdateAccounting_Out1</bpmn:flowNodeRef>
      <bpmn:outgoing>bpmn_flow_ReorderCheapest</bpmn:flowNodeRef>
      <bpmn:outgoing>bpmn_flow_ReorderFastest</bpmn:flowNodeRef>
    </bpmn:exclusiveGateway>

    <!-- Task to Reorder Cheapest -->
    <bpmn:task id="BPMNTask_ReorderCheapest" name="Reorder cheapest part">
      <bpmn:incoming>bpmn_flow_ReorderCheapest</bpmn:flowNodeRef>
      <bpmn:outgoing>BPMNEvent_PartArrived_In1</bpmn:flowNodeRef>
    </bpmn:task>

    <!-- Task to Reorder Fastest -->
    <bpmn:task id="BPMNTask_ReorderFastest" name="Reorder fastest part">
      <bpmn:incoming>bpmn_flow_ReorderFastest</bpmn:flowNodeRef>
      <bpmn:outgoing>BPMNEvent_PartArrived_In2</bpmn:flowNodeRef>
    </bpmn:task>

    <!-- Task to Write Complaint Email -->
    <bpmn:task id="BPMNTask_WriteComplaint" name="Write complaint email">
      <bpmn:incoming>bpmn_flow_StockZero</bpmn:flowNodeRef>
      <bpmn:outgoing>BPMNEvent_PartArrived_In3</bpmn:flowNodeRef>
    </bpmn:task>

    <!-- Task to Update Accounting -->
    <bpmn:task id="BPMNTask_UpdateAccounting" name="Update accounting">
      <bpmn:incoming>BPMNEvent_PartArrived_Out2</bpmn:flowNodeRef>
      <bpmn:outgoing>bpmn_flow_CheckStockLevelAgain</bpmn:flowNodeRef>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_ContractFinished" name="Contract Finished">
      <bpmn:incoming>BPMNTask_UpdateAccounting_Out2</bpmn:flowNodeRef>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="bpmn_flow_StartToQuery" name="" sourceRef="StartEvent_1" targetRef="BPMNTask_QueryWebShops"/>
    
    <bpmn:sequenceFlow id="bpmn_flow_QueriesComplete" name="" sourceRef="InclusiveGateway_QueryShops" targetRef="BPMNTask_CompareDetails">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="BPMNTask_CompareDetails_Out1" name="" sourceRef="BPMNTask_CompareDetails" targetRef="InclusiveGateway_QueryShops"/>
    
    <bpmn:sequenceFlow id="BPMNTask_CreateOrderList_In1" name="" sourceRef="BPMNTask_CompareDetails" targetRef="BPMNTask_CreateOrderList">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="BPMNTask_CreateOrderList_Out1" name="" sourceRef="BPMNTask_CreateOrderList" targetRef="InclusiveGateway_OrderParts"/>
    
    <bpmn:sequenceFlow id="BPMNTask_QueryWebShops_Out1" name="" sourceRef="BPMNTask_QueryWebShops" targetRef="InclusiveGateway_QueryShops">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="BPMNTask_OrderParts_In1" name="" sourceRef="InclusiveGateway_OrderParts" targetRef="BPMNTask_OrderParts"/>
    
    <bpmn:sequenceFlow id="bpmn_flow_PartsOrdered" name="" sourceRef="BPMNTask_OrderParts" targetRef="BPMNEvent_PartArrived">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="BPMNEvent_PartArrived_Out1" name="" sourceRef="BPMNEvent_PartArrived" targetRef="InclusiveGateway_StockCheck"/>
    
    <bpmn:sequenceFlow id="BPMNTask_BuildItem_In1" name="" sourceRef="BPMNEvent_PartArrived" targetRef="BPMNTask_BuildItem">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="bpmn_flow_CheckStockLevel" name="" sourceRef="InclusiveGateway_StockCheck" targetRef="InclusiveGateway_CheckStockLevel"/>
    
    <bpmn:sequenceFlow id="BPMNTask_BuildItem_Out1" name="" sourceRef="BPMNTask_BuildItem" targetRef="InclusiveGateway_StockCheck">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="BPMNEvent_PartArrived_In1" name="" sourceRef="BPMNTask_ReorderCheapest" targetRef="BPMNEvent_PartArrived"/>
    
    <bpmn:sequenceFlow id="BPMNEvent_PartArrived_Out2" name="" sourceRef="InclusiveGateway_StockCheck" targetRef="BPMNTask_UpdateAccounting">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="BPMNTask_ReorderCheapest_In1" name="" sourceRef="InclusiveGateway_CheckStockLevel" targetRef="BPMNTask_ReorderCheapest"/>
    
    <bpmn:sequenceFlow id="BPMNEvent_PartArrived_In2" name="" sourceRef="BPMNTask_ReorderFastest" targetRef="BPMNEvent_PartArrived">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="BPMNTask_UpdateAccounting_Out1" name="" sourceRef="InclusiveGateway_CheckStockLevel" targetRef="BPMNTask_ReorderFastest"/>
    
    <bpmn:sequenceFlow id="BPMNEvent_PartArrived_In3" name="" sourceRef="BPMNTask_WriteComplaint" targetRef="BPMNEvent_PartArrived">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="BPMNTask_UpdateAccounting_Out2" name="" sourceRef="InclusiveGateway_CheckStockLevel" targetRef="EndEvent_ContractFinished"/>
    
    <bpmn:sequenceFlow id="bpmn_flow_ReorderCheapest" name="Below 5 (cheapest)" sourceRef="InclusiveGateway_CheckStockLevel" targetRef="BPMNTask_ReorderCheapest">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="bpmn_flow_ReorderFastest" name="Below 3 (fastest)" sourceRef="InclusiveGateway_CheckStockLevel" targetRef="BPMNTask_ReorderFastest">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="bpmn_flow_StockZero" name="At 0 (complaint)" sourceRef="InclusiveGateway_CheckStockLevel" targetRef="BPMNTask_WriteComplaint">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="bpmn_flow_CheckStockLevelAgain" name="" sourceRef="BPMNTask_UpdateAccounting" targetRef="InclusiveGateway_StockCheck"/>
    
  </bpmn:process>

</bpmn:definitions>