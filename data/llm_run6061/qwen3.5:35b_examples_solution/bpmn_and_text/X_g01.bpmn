<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_NewApplicationUSI">
    <bpmn:participant id="Participant_UserRegistration" name="New Application for USI Course Registration" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    
    <!-- Lane Set -->
    <bpmn:laneSet>
      <bpmn:lane id="Lane_UserActions" name="User Actions">
        <bpmn:flowNodeRef>StartEvent_WishToEnroll</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_SelectCourse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_CheckAccountStatus</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_UniversityEligibilityCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_RegisterAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_RequestActivation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_LoginToAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_ConnectTwitter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_InviteFriends</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_ProvidePaymentInfo</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_SystemActions" name="System Actions">
        <bpmn:flowNodeRef>ServiceTask_ShowCoursesAndDates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_CheckAnotherCourseInteresting</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_WishToEnroll" name="Wish to enroll in course">
      <bpmn:outgoing>bpmn_flow_StartToSelectCourse</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- User Task: Select Course -->
    <bpmn:userTask id="UserTask_SelectCourse" name="Select a course">
      <bpmn:incoming>bpmn_flow_StartToSelectCourse</bpmn:incoming>
      <bpmn:outgoing>bpmn_flow_SelectCourseToFreeSpotsCheck</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Exclusive Gateway: Free spots? -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_FreeSpots" name="free spots?">
      <bpmn:incoming>bpmn_flow_SelectCourseToFreeSpotsCheck</bpmn:incoming>
      <bpmn:outgoing>bpmn_flow_FreeSpotsYesToShowCourses</bpmn:outgoing>
      <bpmn:outgoing>bpmn_flow_FreeSpotsNo_CheckAnother</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Service Task: System shows courses and dates -->
    <bpmn:serviceTask id="ServiceTask_ShowCoursesAndDates" name="System shows parallel courses and dates">
      <bpmn:incoming>bpmn_flow_FreeSpotsYesToShowCourses</bpmn:incoming>
      <bpmn:outgoing>bpmn_flow_CoursesShownToSelectSpecificCourse</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- User Task: Select specific course -->
    <bpmn:userTask id="UserTask_SelectSpecificCourse" name="select one">
      <bpmn:incoming>bpmn_flow_CoursesShownToSelectSpecificCourse</bpmn:incoming>
      <bpmn:outgoing>bpmn_flow_SpecificSelected_ToAccountCheck</bpmn:outgoing>
    </bpmn:userTask>

    <!-- User Task: Check if another course is interesting -->
    <bpmn:userTask id="UserTask_CheckAnotherCourseInteresting" name="check if another course is interesting">
      <bpmn:incoming>bpmn_flow_FreeSpotsNo_CheckAnother</bpmn:incoming>
      <bpmn:outgoing>bpmn_flow_AnotherInterestedToSelectAgain</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Exclusive Gateway: Already registered? -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_AlreadyRegistered" name="already registered at sports institute?">
      <bpmn:incoming>bpmn_flow_SpecificSelected_ToAccountCheck</bpmn:incoming>
      <bpmn:outgoing>bpmn_flow_YesAlreadyLoggedInToLoginTask</bpmn:outgoing>
      <bpmn:outgoing>bpmn_flow_NoNotRegistered_CheckUniversityEligibility</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- User Task: Check if registered at eligible university -->
    <bpmn:userTask id="UserTask_UniversityEligibilityCheck" name="check whether you are registered at an eligible university">
      <bpmn:incoming>bpmn_flow_NoNotRegistered_CheckUniversityEligibility</bpmn:incoming>
      <bpmn:outgoing>bpmn_flow_EligibleChecked_ToEligibleGateway</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Exclusive Gateway: Eligible university? -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_EligibleUniversity" name="eligible university?">
      <bpmn:incoming>bpmn_flow_EligibleChecked_ToEligibleGateway</bpmn:incoming>
      <bpmn:outgoing>bpmn_flow_YesEligibleToRegisterAccount</bpmn:outgoing>
      <bpmn:outgoing>bpmn_flow_NoNotEligible_RequestActivation</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- User Task: Register account -->
    <bpmn:userTask id="UserTask_RegisterAccount" name="register your account">
      <bpmn:incoming>bpmn_flow_YesEligibleToRegisterAccount</bpmn:incoming>
      <bpmn:outgoing>bpmn_flow_AccountRegistered_ToLoginCheck</bpmn:outgoing>
    </bpmn:userTask>

    <!-- User Task: Request activation -->
    <bpmn:userTask id="UserTask_RequestActivation" name="request an activation and wait for a response">
      <bpmn:incoming>bpmn_flow_NoNotEligible_RequestActivation</bpmn:incoming>
      <bpmn:outgoing>bpmn_flow_ActivationRequested_ToCheckAgain</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Exclusive Gateway: Person eligible? (after activation wait) -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_PersonEligible" name="person eligible after response?">
      <bpmn:incoming>bpmn_flow_ActivationRequested_ToCheckAgain</bpmn:incoming>
      <bpmn:outgoing>bpmn_flow_YesNowEligibleToRegisterAccountRetry</bpmn:outgoing>
      <bpmn:outgoing>bpmn_flow_NoStillNotEligible_EndProcess</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- User Task: Log into account -->
    <bpmn:userTask id="UserTask_LoginToAccount" name="log into it">
      <bpmn:incoming>bpmn_flow_YesAlreadyLoggedInToLoginTask</bpmn:incoming>
      <bpmn:outgoing>bpmn_flow_LogInDone_ToParallelGateway</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel Gateway (diverging) -->
    <bpmn:parallelGateway id="ParallelGateway_LoginToTwitterAndPayment" name="">
      <bpmn:incoming>bpmn_flow_LogInDone_ToParallelGateway</bpmn:incoming>
      <bpmn:outgoing>bpmn_flow_TwitterPath_ConnectTwitter</bpmn:outgoing>
      <bpmn:outgoing>bpmn_flow_PaymentPath_ProvidePaymentInfo</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- User Task: Connect to twitter account -->
    <bpmn:userTask id="UserTask_ConnectTwitter" name="connect to your twitter account">
      <bpmn:incoming>bpmn_flow_TwitterPath_ConnectTwitter</bpmn:incoming>
      <bpmn:outgoing>bpmn_flow_TwitterConnected_ToInviteFriends</bpmn:outgoing>
    </bpmn:userTask>

    <!-- User Task: Invite friends to course -->
    <bpmn:userTask id="UserTask_InviteFriends" name="tweet to friends who might want to join you">
      <bpmn:incoming>bpmn_flow_TwitterConnected_ToInviteFriends</bpmn:incoming>
      <bpmn:outgoing>bpmn_flow_FriendsInvited_ToParallelConverge</bpmn:outgoing>
    </bpmn:userTask>

    <!-- User Task: Provide payment info -->
    <bpmn:userTask id="UserTask_ProvidePaymentInfo" name="provide the payment information">
      <bpmn:incoming>bpmn_flow_PaymentPath_ProvidePaymentInfo</bpmn:incoming>
      <bpmn:outgoing>bpmn_flow_PaymentDone_ToParallelConverge</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel Gateway (converging) -->
    <bpmn:parallelGateway id="ParallelGateway_TwitterAndPaymentMerge" name="">
      <bpmn:incoming>bpmn_flow_FriendsInvited_ToParallelConverge</bpmn:incoming>
      <bpmn:incoming>bpmn_flow_PaymentDone_ToParallelConverge</bpmn:incoming>
      <bpmn:outgoing>bpmn_flow_BothPathsComplete_SystemIssuesTicket</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Service Task: System issues course tickets -->
    <bpmn:serviceTask id="ServiceTask_IssueCourseTickets" name="system issues course ticket">
      <bpmn:incoming>bpmn_flow_BothPathsComplete_SystemIssuesTicket</bpmn:incoming>
      <bpmn:outgoing>bpmn_flow_TicketIssued_ToEndEvent</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_ProcessComplete" name="receive a course ticket">
      <bpmn:incoming>bpmn_flow_TicketIssued_ToEndEvent</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Exclusive Gateway for Another Course Interesting (yes/no) -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_AnotherCourseInteresting" name="">
      <bpmn:incoming>bpmn_flow_AnotherInterestedToSelectAgain</bpmn:incoming>
      <bpmn:outgoing>bpmn_flow_YesAnotherCourse_ToStartOver</bpmn:outgoing>
      <bpmn:outgoing>bpmn_flow_NoNotInteresting_ToAccountCheck</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="bpmn_flow_StartToSelectCourse" name="" sourceRef="StartEvent_WishToEnroll" targetRef="UserTask_SelectCourse"/>
    
    <bpmn:sequenceFlow id="bpmn_flow_SelectCourseToFreeSpotsCheck" name="" sourceRef="UserTask_SelectCourse" targetRef="ExclusiveGateway_FreeSpots"/>
    
    <bpmn:sequenceFlow id="bpmn_flow_FreeSpotsYesToShowCourses" name="yes" sourceRef="ExclusiveGateway_FreeSpots" targetRef="ServiceTask_ShowCoursesAndDates"/>
    
    <bpmn:sequenceFlow id="bpmn_flow_CoursesShownToSelectSpecificCourse" name="" sourceRef="ServiceTask_ShowCoursesAndDates" targetRef="UserTask_SelectSpecificCourse"/>
    
    <bpmn:sequenceFlow id="bpmn_flow_SpecificSelected_ToAccountCheck" name="" sourceRef="UserTask_SelectSpecificCourse" targetRef="ExclusiveGateway_AlreadyRegistered"/>
    
    <bpmn:sequenceFlow id="bpmn_flow_FreeSpotsNo_CheckAnother" name="no" sourceRef="ExclusiveGateway_FreeSpots" targetRef="UserTask_CheckAnotherCourseInteresting"/>
    
    <bpmn:sequenceFlow id="bpmn_flow_AnotherInterestedToSelectAgain" name="" sourceRef="UserTask_CheckAnotherCourseInteresting" targetRef="ExclusiveGateway_AnotherCourseInteresting"/>
    
    <bpmn:sequenceFlow id="bpmn_flow_YesAnotherCourse_ToStartOver" name="yes" sourceRef="ExclusiveGateway_AnotherCourseInteresting" targetRef="UserTask_SelectCourse">
      <bpmn:name/>
    </bpmn:sequenceFlow>
    
    <bpmn:sequenceFlow id="bpmn_flow_NoNotInterested_ToAccountCheck" name="no" sourceRef="ExclusiveGateway_AnotherCourseInteresting" targetRef="ExclusiveGateway_AlreadyRegistered"/>
    
    <bpmn:sequenceFlow id="bpmn_flow_YesAlreadyLoggedInToLoginTask" name="" sourceRef="ExclusiveGateway_AlreadyRegistered" targetRef="UserTask_LoginToAccount">
      <bpmn:name/>
    </bpmn:sequenceFlow>
    
    <bpmn:sequenceFlow id="bpmn_flow_NoNotRegistered_CheckUniversityEligibility" name="no" sourceRef="ExclusiveGateway_AlreadyRegistered" targetRef="UserTask_UniversityEligibilityCheck"/>
    
    <bpmn:sequenceFlow id="bpmn_flow_EligibleChecked_ToEligibleGateway" name="" sourceRef="UserTask_UniversityEligibilityCheck" targetRef="ExclusiveGateway_EligibleUniversity"/>
    
    <bpmn:sequenceFlow id="bpmn_flow_YesEligibleToRegisterAccount" name="yes" sourceRef="ExclusiveGateway_EligibleUniversity" targetRef="UserTask_RegisterAccount"/>
    
    <bpmn:sequenceFlow id="bpmn_flow_NoNotEligible_RequestActivation" name="no" sourceRef="ExclusiveGateway_EligibleUniversity" targetRef="UserTask_RequestActivation"/>
    
    <bpmn:sequenceFlow id="bpmn_flow_AccountRegistered_ToLoginCheck" name="" sourceRef="UserTask_RegisterAccount" targetRef="ExclusiveGateway_PersonEligible">
      <bpmn:name/>
    </bpmn:sequenceFlow>
    
    <bpmn:sequenceFlow id="bpmn_flow_ActivationRequested_ToCheckAgain" name="" sourceRef="UserTask_RequestActivation" targetRef="ExclusiveGateway_PersonEligible"/>
    
    <bpmn:sequenceFlow id="bpmn_flow_YesNowEligibleToRegisterAccountRetry" name="yes" sourceRef="ExclusiveGateway_PersonEligible" targetRef="UserTask_RegisterAccount">
      <bpmn:name/>
    </bpmn:sequenceFlow>
    
    <bpmn:sequenceFlow id="bpmn_flow_NoStillNotEligible_EndProcess" name="no" sourceRef="ExclusiveGateway_PersonEligible" targetRef="EndEvent_ProcessComplete"/>
    
    <bpmn:sequenceFlow id="bpmn_flow_LogInDone_ToParallelGateway" name="" sourceRef="UserTask_LoginToAccount" targetRef="ParallelGateway_LoginToTwitterAndPayment"/>
    
    <bpmn:sequenceFlow id="bpmn_flow_TwitterPath_ConnectTwitter" name="" sourceRef="ParallelGateway_LoginToTwitterAndPayment" targetRef="UserTask_ConnectTwitter"/>
    
    <bpmn:sequenceFlow id="bpmn_flow_PaymentPath_ProvidePaymentInfo" name="" sourceRef="ParallelGateway_LoginToTwitterAndPayment" targetRef="UserTask_ProvidePaymentInfo"/>
    
    <bpmn:sequenceFlow id="bpmn_flow_TwitterConnected_ToInviteFriends" name="" sourceRef="UserTask_ConnectTwitter" targetRef="UserTask_InviteFriends"/>
    
    <bpmn:sequenceFlow id="bpmn_flow_FriendsInvited_ToParallelConverge" name="" sourceRef="UserTask_InviteFriends" targetRef="ParallelGateway_TwitterAndPaymentMerge"/>
    
    <bpmn:sequenceFlow id="bpmn_flow_PaymentDone_ToParallelConverge" name="" sourceRef="UserTask_ProvidePaymentInfo" targetRef="ParallelGateway_TwitterAndPaymentMerge"/>
    
    <bpmn:sequenceFlow id="bpmn_flow_BothPathsComplete_SystemIssuesTicket" name="" sourceRef="ParallelGateway_TwitterAndPaymentMerge" targetRef="ServiceTask_IssueCourseTickets"/>
    
    <bpmn:sequenceFlow id="bpmn_flow_TicketIssued_ToEndEvent" name="" sourceRef="ServiceTask_IssueCourseTickets" targetRef="EndEvent_ProcessComplete"/>

  </bpmn:process>

</bpmn:definitions>