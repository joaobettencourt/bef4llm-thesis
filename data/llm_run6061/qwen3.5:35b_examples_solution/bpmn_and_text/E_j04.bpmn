<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Internship_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_Internship_001" isExecutable="false">

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Apply" name="Internship Application">
      <bpmn:outgoing>SequenceFlow_StartToDetails</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Enter Details -->
    <bpmn:userTask id="Task_EnterDetails" name="Enter Topic, Money, Experience &amp; Hobbies">
      <bpmn:incoming>SequenceFlow_StartToDetails</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DetailsToOffers</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Service Task: Check Offers (Looping) -->
    <bpmn:serviceTask id="ServiceTask_CheckOffers" name="Check for New Offers">
      <bpmn:incoming>SequenceFlow_WaitForMore</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OffersToDecision</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Gateway: Accept Offer? -->
    <bpmn:exclusiveGateway id="Gateway_AcceptOffer" name="Accept Offer?">
      <bpmn:incoming>SequenceFlow_OffersToDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OfferAccepted_Internship</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_Deny_WaitMore</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Gateway: Internship Start (Parallel Split) -->
    <bpmn:parallelGateway id="Gateway_InternshipStart" name="">
      <bpmn:incoming>SequenceFlow_OfferAccepted_Internship</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ApplicantUpdates</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Applicant Status Update -->
    <bpmn:userTask id="Task_ApplicantUpdate" name="Write Internship Status Update">
      <bpmn:incoming>SequenceFlow_ApplicantUpdates</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckAppCount</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway: Applicant Count Check -->
    <bpmn:exclusiveGateway id="Gateway_ApplCheck" name="Updates &lt; 3?">
      <bpmn:incoming>SequenceFlow_CheckAppCount</bpmn:incoming>
      <bpmn:outgoing>SequenceLoop_ApplicantUpdate</bpmn:outgoing>
      <bpmn:outgoing>Sequence_ApplDone_CompanyCheck</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Company Status Update -->
    <bpmn:userTask id="Task_CompanyUpdate" name="Company Writes About You">
      <bpmn:incoming>SequenceFlow_CheckCompCount</bpmn:incoming>
      <bpmn:outgoing>SequenceLoop_CompanyUpdate</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway: Company Count Check -->
    <bpmn:exclusiveGateway id="Gateway_CompCheck" name="Updates &lt; 3?">
      <bpmn:incoming>SequenceLoop_CompanyUpdate</bpmn:incoming>
      <bpmn:outgoing>Sequence_ApplDone_InternshipEnd</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Gateway: Internship End (Converging) -->
    <bpmn:parallelGateway id="Gateway_InternshipEnd" name="">
      <bpmn:incoming>Sequence_ApplDone_CompanyCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InternshipToRec</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Gateway: Recommendation Decision -->
    <bpmn:exclusiveGateway id="Gateway_Recommend" name="Recommend Company?">
      <bpmn:incoming>SequenceFlow_InternshipToRec</bpmn:incoming>
      <bpmn:outgoing>Sequence_NoRec_EndProcess</bpmn:outgoing>
      <bpmn:outgoing>Sequence_YesRec_Tweets</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Gateway: Tweets Parallel Split -->
    <bpmn:parallelGateway id="Gateway_TweetSplit" name="">
      <bpmn:incoming>Sequence_YesRec_Tweets</bpmn:incoming>
      <bpmn:outgoing>SequenceTweet_Friend1</bpmn:outgoing>
      <bpmn:outgoing>SequenceTweet_Friend2</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Send Tasks for Tweets -->
    <bpmn:sendTask id="SendTask_Tweet1" name="Tweet Friend 1">
      <bpmn:incoming>SequenceTweet_Friend1</bpmn:incoming>
      <bpmn:outgoing>Sequence_ConvergeTweets</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:sendTask id="SendTask_Tweet2" name="Tweet Friend 2">
      <bpmn:incoming>SequenceTweet_Friend2</bpmn:incoming>
      <bpmn:outgoing>Sequence_ConvergeTweets</bpmn:outgoing>
    </bpmn:sendTask>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_ProcessComplete" name="Process Complete">
      <bpmn:incoming>Sequence_NoRec_EndProcess</bpmn:incoming>
      <bpmn:incoming>Sequence_ConvergeTweets</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToDetails" sourceRef="StartEvent_Apply" targetRef="Task_EnterDetails">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_DetailsToOffers" sourceRef="Task_EnterDetails" targetRef="ServiceTask_CheckOffers"/>

    <bpmn:sequenceFlow id="SequenceFlow_OffersToDecision" sourceRef="ServiceTask_CheckOffers" targetRef="Gateway_AcceptOffer"/>

    <bpmn:sequenceFlow id="SequenceFlow_OfferAccepted_Internship" name="Accept Offer" sourceRef="Gateway_AcceptOffer" targetRef="Gateway_InternshipStart"/>

    <bpmn:sequenceFlow id="SequenceFlow_Deny_WaitMore" name="Deny / Wait More" sourceRef="Gateway_AcceptOffer" targetRef="ServiceTask_CheckOffers"/>

    <!-- Internship Parallel Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_ApplicantUpdates" sourceRef="Gateway_InternshipStart" targetRef="Task_ApplicantUpdate"/>

    <bpmn:sequenceFlow id="SequenceLoop_ApplicantUpdate" name="" sourceRef="Gateway_ApplCheck" targetRef="Task_ApplicantUpdate"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_CheckAppCount" sourceRef="Task_ApplicantUpdate" targetRef="Gateway_ApplCheck"/>

    <!-- Company Updates -->
    <bpmn:parallelGateway id="Gateway_InternshipStart2" name="">
      <bpmn:incoming>Sequence_ApplDone_CompanyCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckCompCount</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:sequenceFlow id="SequenceLoop_CompanyUpdate" name="" sourceRef="Gateway_CompCheck" targetRef="Task_CompanyUpdate"/>

    <!-- Converge after both paths -->
    <bpmn:exclusiveGateway id="Gateway_InternshipEnd2" name="">
      <bpmn:incoming>Sequence_ApplDone_CompanyCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InternshipToRec</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Recommendation Decision -->
    <bpmn:sequenceFlow id="Sequence_ApplDone_CompanyCheck" sourceRef="Gateway_CompCheck" targetRef="Gateway_InternshipEnd2"/>

    <bpmn:sequenceFlow id="SequenceFlow_CheckCompCount" sourceRef="Task_ApplicantUpdate" targetRef="Task_CompanyUpdate"/>
    
    <!-- Tweets -->
    <bpmn:parallelGateway id="Gateway_TweetSplit" name="">
      <bpmn:incoming>Sequence_YesRec_Tweets</bpmn:incoming>
      <bpmn:outgoing>SequenceTweet_Friend1</bpmn:outgoing>
      <bpmn:outgoing>SequenceTweet_Friend2</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Send Tasks for Tweets -->
    <bpmn:sendTask id="SendTask_Tweet1" name="Tweet Friend 1">
      <bpmn:incoming>SequenceTweet_Friend1</bpmn:incoming>
      <bpmn:outgoing>Sequence_ConvergeTweets</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:sendTask id="SendTask_Tweet2" name="Tweet Friend 2">
      <bpmn:incoming>SequenceTweet_Friend2</bpmn:incoming>
      <bpmn:outgoing>Sequence_ConvergeTweets</bpmn:outgoing>
    </bpmn:sendTask>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_ProcessComplete" name="Process Complete">
      <bpmn:incoming>Sequence_NoRec_EndProcess</bpmn:incoming>
      <bpmn:incoming>Sequence_ConvergeTweets</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>