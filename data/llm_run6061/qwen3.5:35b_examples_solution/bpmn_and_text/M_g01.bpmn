<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_CustomModelPrint">
    <bpmn:participant id="Participant_CustomModelProcess" name="Custom Model Printing Process" processRef="Process_CustomModel"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_CustomModel" isExecutable="false">
    
    <!-- Lane Set -->
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Customer" name="Customer">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_SatisfiedWithResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_CreateSketches</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_SendSketchesToArtist</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_TellArtistChanges</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_HaveColorAtHome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_ChoosePlasticColor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_Under100Grams</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_PutOnShoppingList</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_OrderPlasticColor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_EnoughPlastic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_PrepareModelForPrinting</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Artist" name="Artist">
        <bpmn:flowNodeRef>UserTask_Create3DModel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_SendSTLFileToCustomer</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Printer" name="Printer">
        <bpmn:flowNodeRef>InclusiveGateway_ParallelPreparation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_TurnOnPrinter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_HeatUpBed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_HeatUpExtruder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_ExtruderStatusFeedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_ConvergePreparation</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Create Custom Model Request">
      <bpmn:outgoing>SequenceFlow_StartToSketches</bpmn:flowNodeRef>
    </bpmn:startEvent>

    <!-- User Task: Create Sketches -->
    <bpmn:userTask id="UserTask_CreateSketches" name="Create sketches">
      <bpmn:incoming>SequenceFlow_StartToSketches</bpmn:flowNodeRef>
      <bpmn:outgoing>SequenceFlow_SketchesToSendArtist</bpmn:flowNodeRef>
    </bpmn:userTask>

    <!-- User Task: Send Sketches to Artist -->
    <bpmn:userTask id="UserTask_SendSketchesToArtist" name="Send sketches to artist">
      <bpmn:incoming>SequenceFlow_SketchesToSendArtist</bpmn:flowNodeRef>
      <bpmn:outgoing>SequenceFlow_ArtistReceivesRequest</bpmn:flowNodeRef>
    </bpmn:userTask>

    <!-- User Task: Artist Creates Model -->
    <bpmn:userTask id="UserTask_Create3DModel" name="Artist creates 3D model">
      <bpmn:incoming>SequenceFlow_ArtistReceivesRequest</bpmn:flowNodeRef>
      <bpmn:outgoing>SequenceFlow_ModelReadyForReview</bpmn:flowNodeRef>
    </bpmn:userTask>

    <!-- User Task: Receive STL File -->
    <bpmn:userTask id="UserTask_SendSTLFileToCustomer" name="Receive 3D model from artist">
      <bpmn:incoming>SequenceFlow_ModelReadyForReview</bpmn:flowNodeRef>
      <bpmn:outgoing>SequenceFlow_ReadyForSatisfactionCheck</bpmn:flowNodeRef>
    </bpmn:userTask>

    <!-- Inclusive Gateway: Satisfied with Result? -->
    <bpmn:inclusiveGateway id="InclusiveGateway_SatisfiedWithResult" name="Satisfied&#10;with result?">
      <bpmn:incoming>SequenceFlow_ReadyForSatisfactionCheck</bpmn:flowNodeRef>
      <bpmn:outgoing>SequenceFlow_ArtistNeedsChanges</bpmn:flowNodeRef>
      <bpmn:outgoing>SequenceFlow_ProceedToColorSelection</bpmn:flowNodeRef>
    </bpmn:inclusiveGateway>

    <!-- User Task: Tell Artist What to Change -->
    <bpmn:userTask id="UserTask_TellArtistChanges" name="Tell artist what&#10;to change">
      <bpmn:incoming>SequenceFlow_ArtistNeedsChanges</bpmn:flowNodeRef>
      <bpmn:outgoing>SequenceFlow_ReturnToModelCreation</bpmn:flowNodeRef>
    </bpmn:userTask>

    <!-- User Task: Choose Plastic Color -->
    <bpmn:userTask id="UserTask_ChoosePlasticColor" name="Choose plastic&#10;color for model">
      <bpmn:incoming>SequenceFlow_ProceedToColorSelection</bpmn:flowNodeRef>
      <bpmn:outgoing>SequenceFlow_CheckIfHaveAtHome</bpmn:flowNodeRef>
    </bpmn:userTask>

    <!-- Inclusive Gateway: Have Color at Home? -->
    <bpmn:inclusiveGateway id="InclusiveGateway_HaveColorAtHome" name="Have color&#10;at home?">
      <bpmn:incoming>SequenceFlow_CheckIfHaveAtHome</bpmn:flowNodeRef>
      <bpmn:outgoing>SequenceFlow_YesCheckQuantity</bpmn:flowNodeRef>
      <bpmn:outgoing>SequenceFlow_NoOrderPlastic</bpmn:flowNodeRef>
    </bpmn:inclusiveGateway>

    <!-- Inclusive Gateway: Under 100 Grams? -->
    <bpmn:exclusiveGateway id="InclusiveGateway_Under100Grams" name="Under&#10;100 grams?">
      <bpmn:incoming>SequenceFlow_YesCheckQuantity</bpmn:flowNodeRef>
      <bpmn:outgoing>SequenceFlow_AddToShoppingList</bpmn:flowNodeRef>
      <bpmn:outgoing>SequenceFlow_SufficientStock</bpmn:flowNodeRef>
    </bpmn:exclusiveGateway>

    <!-- User Task: Put on Shopping List -->
    <bpmn:userTask id="UserTask_PutOnShoppingList" name="Put it on&#10;shopping list">
      <bpmn:incoming>SequenceFlow_AddToShoppingList</bpmn:flowNodeRef>
      <bpmn:outgoing>SequenceFlow_ShoppingListComplete</bpmn:flowNodeRef>
    </bpmn:userTask>

    <!-- User Task: Order Plastic Color -->
    <bpmn:userTask id="UserTask_OrderPlasticColor" name="Order plastic&#10;color">
      <bpmn:incoming>SequenceFlow_NoOrderPlastic</bpmn:flowNodeRef>
      <bpmn:outgoing>SequenceFlow_PlasticOrderedComplete</bpmn:flowNodeRef>
    </bpmn:userTask>

    <!-- Inclusive Gateway Converge After Color Check -->
    <bpmn:inclusiveGateway id="InclusiveGateway_ConvergeColorCheck" name="">
      <bpmn:incoming>SequenceFlow_ShoppingListComplete</bpmn:flowNodeRef>
      <bpmn:incoming>SequenceFlow_SufficientStock</bpmn:flowNodeRef>
      <bpmn:outgoing>SequenceFlow_PlasticReadyForPrinting</bpmn:flowNodeRef>
    </bpmn:inclusiveGateway>

    <!-- Inclusive Gateway Converge After Order -->
    <bpmn:exclusiveGateway id="InclusiveGateway_ConvergeOrder" name="">
      <bpmn:incoming>SequenceFlow_PlasticOrderedComplete</bpmn:flowNodeRef>
      <bpmn:outgoing>SequenceFlow_OrderConvergenceToColorCheck</bpmn:flowNodeRef>
    </bpmn:exclusiveGateway>

    <!-- Inclusive Gateway: Enough Plastic? -->
    <bpmn:inclusiveGateway id="InclusiveGateway_EnoughPlastic" name="Enough&#10;plastic?">
      <bpmn:incoming>SequenceFlow_PlasticReadyForPrinting</bpmn:flowNodeRef>
      <bpmn:outgoing>SequenceFlow_ProceedToPreparation</bpmn:flowNodeRef>
    </bpmn:inclusiveGateway>

    <!-- User Task: Prepare Model for Printing -->
    <bpmn:userTask id="UserTask_PrepareModelForPrinting" name="Prepare model&#10;for printing">
      <bpmn:incoming>SequenceFlow_ProceedToPreparation</bpmn:flowNodeRef>
      <bpmn:outgoing>SequenceFlow_StartParallelPrinterTasks</bpmn:flowNodeRef>
    </bpmn:userTask>

    <!-- Parallel Gateway for Printer Preparation -->
    <bpmn:parallelGateway id="InclusiveGateway_ParallelPreparation" name="">
      <bpmn:incoming>SequenceFlow_StartParallelPrinterTasks</bpmn:flowNodeRef>
      <bpmn:outgoing>SequenceFlow_TurnOnPrinterTask</bpmn:flowNodeRef>
      <bpmn:outgoing>SequenceFlow_HeatUpBedTask</bpmn:flowNodeRef>
      <bpmn:outgoing>SequenceFlow_GenerateGcodeFile</bpmn:flowNodeRef>
    </bpmn:parallelGateway>

    <!-- User Task: Turn On Printer -->
    <bpmn:userTask id="UserTask_TurnOnPrinter" name="Turn on printer">
      <bpmn:incoming>SequenceFlow_TurnOnPrinterTask</bpmn:flowNodeRef>
      <bpmn:outgoing>SequenceFlow_PrinterReadyForHeating</bpmn:flowNodeRef>
    </bpmn:userTask>

    <!-- User Task: Heat Up Bed -->
    <bpmn:userTask id="UserTask_HeatUpBed" name="Heat up bed">
      <bpmn:incoming>SequenceFlow_HeatUpBedTask</bpmn:flowNodeRef>
      <bpmn:outgoing>SequenceFlow_BedHeatedComplete</bpmn:flowNodeRef>
    </bpmn:userTask>

    <!-- User Task: Heat Up Extruder -->
    <bpmn:userTask id="UserTask_HeatUpExtruder" name="Heat up extruder">
      <bpmn:incoming>SequenceFlow_GenerateGcodeFile</bpmn:flowNodeRef>
      <bpmn:outgoing>SequenceFlow_ExtruderHeatedComplete</bpmn:flowNodeRef>
    </bpmn:userTask>

    <!-- Service Task: Extruder Status Feedback -->
    <bpmn:serviceTask id="ServiceTask_ExtruderStatusFeedback" name="Extruder sends&#10;status feedback">
      <bpmn:incoming>SequenceFlow_PrinterReadyForHeating</bpmn:flowNodeRef>
      <bpmn:outgoing>SequenceFlow_StatusReceivedComplete</bpmn:flowNodeRef>
    </bpmn:serviceTask>

    <!-- Service Task: Generate Gcode File -->
    <bpmn:serviceTask id="ServiceTask_GenerateGcodeFile" name="Generate gcode&#10;file from STL">
      <bpmn:incoming>SequenceFlow_ExtruderHeatedComplete</bpmn:flowNodeRef>
      <bpmn:outgoing>SequenceFlow_GcodeReadyForPrinting</bpmn:flowNodeRef>
    </bpmn:serviceTask>

    <!-- Parallel Gateway Converge Printer Preparation -->
    <bpmn:parallelGateway id="InclusiveGateway_ConvergePreparation" name="">
      <bpmn:incoming>SequenceFlow_PrinterReadyForHeating</bpmn:flowNodeRef>
      <bpmn:incoming>SequenceFlow_BedHeatedComplete</bpmn:flowNodeRef>
      <bpmn:incoming>SequenceFlow_ExtruderHeatedComplete</bpmn:flowNodeRef>
      <bpmn:outgoing>SequenceFlow_PrinterFullyPrepared</bpmn:flowNodeRef>
    </bpmn:parallelGateway>

    <!-- User Task: Request Print in Program -->
    <bpmn:userTask id="UserTask_RequestPrintInProgram" name="Request print&#10;in program">
      <bpmn:incoming>SequenceFlow_PrinterFullyPrepared</bpmn:flowNodeRef>
      <bpmn:outgoing>SequenceFlow_StartActualPrinting</bpmn:flowNodeRef>
    </bpmn:userTask>

    <!-- Service Task: Execute Printing -->
    <bpmn:serviceTask id="ServiceTask_ExecutePrinting" name="Execute printing">
      <bpmn:incoming>SequenceFlow_StartActualPrinting</bpmn:flowNodeRef>
      <bpmn:outgoing>SequenceFlow_PrintingCompleteToEndEvent</bpmn:flowNodeRef>
    </bpmn:serviceTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_1" name="Model Printed">
      <bpmn:incoming>SequenceFlow_PrintingCompleteToEndEvent</bpmn:flowNodeRef>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToSketches" sourceRef="StartEvent_1" targetRef="UserTask_CreateSketches"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_SketchesToSendArtist" sourceRef="UserTask_CreateSketches" targetRef="UserTask_SendSketchesToArtist"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ArtistReceivesRequest" name="" sourceRef="UserTask_SendSketchesToArtist" targetRef="InclusiveGateway_SatisfiedWithResult">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ModelReadyForReview" sourceRef="UserTask_Create3DModel" targetRef="UserTask_SendSTLFileToCustomer"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ReadyForSatisfactionCheck" name="" sourceRef="UserTask_SendSTLFileToCustomer" targetRef="InclusiveGateway_SatisfiedWithResult">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ArtistNeedsChanges" name="No - Needs Changes" sourceRef="InclusiveGateway_SatisfiedWithResult" targetRef="UserTask_TellArtistChanges">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ProceedToColorSelection" name="Yes - Satisfied" sourceRef="InclusiveGateway_SatisfiedWithResult" targetRef="UserTask_ChoosePlasticColor">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ReturnToModelCreation" name="" sourceRef="UserTask_TellArtistChanges" targetRef="InclusiveGateway_SatisfiedWithResult"/>

    <bpmn:sequenceFlow id="SequenceFlow_CheckIfHaveAtHome" sourceRef="UserTask_ChoosePlasticColor" targetRef="InclusiveGateway_HaveColorAtHome"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_YesCheckQuantity" name="Yes - Have at Home" sourceRef="InclusiveGateway_HaveColorAtHome" targetRef="InclusiveGateway_Under100Grams">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_NoOrderPlastic" name="No - Order Plastic" sourceRef="InclusiveGateway_HaveColorAtHome" targetRef="UserTask_OrderPlasticColor">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_AddToShoppingList" name="Yes - Under 100g" sourceRef="InclusiveGateway_Under100Grams" targetRef="UserTask_PutOnShoppingList">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_SufficientStock" name="No - Sufficient Stock" sourceRef="InclusiveGateway_Under100Grams" targetRef="InclusiveGateway_ConvergeColorCheck">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ShoppingListComplete" name="" sourceRef="UserTask_PutOnShoppingList" targetRef="InclusiveGateway_ConvergeOrder"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_OrderConvergenceToColorCheck" sourceRef="InclusiveGateway_ConvergeOrder" targetRef="InclusiveGateway_ConvergeColorCheck">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_PlasticOrderedComplete" name="" sourceRef="UserTask_OrderPlasticColor" targetRef="InclusiveGateway_ConvergeOrder"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_PlasticReadyForPrinting" sourceRef="InclusiveGateway_ConvergeColorCheck" targetRef="InclusiveGateway_EnoughPlastic">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ProceedToPreparation" name="" sourceRef="InclusiveGateway_EnoughPlastic" targetRef="UserTask_PrepareModelForPrinting"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_StartParallelPrinterTasks" sourceRef="UserTask_PrepareModelForPrinting" targetRef="InclusiveGateway_ParallelPreparation">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_TurnOnPrinterTask" name="" sourceRef="InclusiveGateway_ParallelPreparation" targetRef="UserTask_TurnOnPrinter"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_HeatUpBedTask" name="" sourceRef="InclusiveGateway_ParallelPreparation" targetRef="UserTask_HeatUpBed">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_GenerateGcodeFile" name="" sourceRef="InclusiveGateway_ParallelPreparation" targetRef="ServiceTask_GenerateGcodeFile"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_PrinterReadyForHeating" sourceRef="UserTask_TurnOnPrinter" targetRef="ServiceTask_ExtruderStatusFeedback">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_BedHeatedComplete" name="" sourceRef="UserTask_HeatUpBed" targetRef="InclusiveGateway_ConvergePreparation"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ExtruderHeatedComplete" name="" sourceRef="ServiceTask_ExtruderStatusFeedback" targetRef="InclusiveGateway_ParallelPreparation">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_GcodeReadyForPrinting" name="" sourceRef="ServiceTask_GenerateGcodeFile" targetRef="UserTask_RequestPrintInProgram"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_PrinterFullyPrepared" sourceRef="InclusiveGateway_ConvergePreparation" targetRef="UserTask_RequestPrintInProgram">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_StartActualPrinting" name="" sourceRef="UserTask_RequestPrintInProgram" targetRef="ServiceTask_ExecutePrinting"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_PrintingCompleteToEndEvent" name="" sourceRef="ServiceTask_ExecutePrinting" targetRef="EndEvent_1">
      <bpmn:name/>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>