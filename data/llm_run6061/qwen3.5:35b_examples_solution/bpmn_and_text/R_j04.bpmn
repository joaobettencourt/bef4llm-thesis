<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_CarService_v2" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Process" name="Car Service Process" processRef="Process_CarService"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_CarService" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_TimerCheck" name="Timer Check (Due Date)">
      <bpmn:outgoing>SequenceFlow_CheckRegistration</bpmn:outgoing>
      <bpmn:timerEventDefinition xsi:type="bpmn:TimeDateExpression"/>
    </bpmn:startEvent>

    <!-- Service Task -->
    <bpmn:serviceTask id="ServiceTask_CheckRegistration" name="Check if car is registered">
      <bpmn:incoming>SequenceFlow_CheckRegistration</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_IsRegistered</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Exclusive Gateway -->
    <bpmn:exclusiveGateway id="Gateway_IsRegistered" name="Is Car Registered?">
      <bpmn:incoming>SequenceFlow_IsRegistered</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NotifyOwner_Yes</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_EndNotReg_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Service Task -->
    <bpmn:serviceTask id="ServiceTask_NotifyOwner" name="Notify Car Owner">
      <bpmn:incoming>SequenceFlow_NotifyOwner_Yes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitTimer</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Intermediate Catch Event -->
    <bpmn:intermediateCatchEvent id="IntermediateEvent_WaitCheck" name="Wait / Check Time Passed">
      <bpmn:incoming>SequenceFlow_WaitTimer</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TimePassedGateway</bpmn:outgoing>
      <bpmn:timerEventDefinition xsi:type="bpmn:TimeDateExpression"/>
    </bpmn:intermediateCatchEvent>

    <!-- Exclusive Gateway -->
    <bpmn:exclusiveGateway id="Gateway_TimePassed" name="Time Passed &gt; 30 Days?">
      <bpmn:incoming>SequenceFlow_TimePassedGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendFine_Yes</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_EnterProblems_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Service Task -->
    <bpmn:serviceTask id="ServiceTask_SendFine" name="Send Fine to Car Owner">
      <bpmn:incoming>SequenceFlow_SendFine_Yes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndFined</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Fined" name="Fine Issued">
      <bpmn:incoming>SequenceFlow_EndFined</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Manual Task (Facility) -->
    <bpmn:manualTask id="ManualTask_EnterProblems" name="Enter Car Problems at Facility">
      <bpmn:incoming>SequenceFlow_EnterProblems_No</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ParallelSplit</bpmn:outgoing>
    </bpmn:manualTask>

    <!-- Parallel Gateway -->
    <bpmn:parallelGateway id="Gateway_ParallelSplit" name="Start Repair &amp; Updates">
      <bpmn:incoming>SequenceFlow_ParallelSplit</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RepairCar</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SendEmailUpdates</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Manual Task -->
    <bpmn:manualTask id="ManualTask_RepairCar" name="Repair Car">
      <bpmn:incoming>SequenceFlow_RepairCar</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ParallelConverge_1</bpmn:outgoing>
    </bpmn:manualTask>

    <!-- Service Task -->
    <bpmn:serviceTask id="ServiceTask_SendEmailUpdates" name="Send Status Updates via Email">
      <bpmn:incoming>SequenceFlow_SendEmailUpdates</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ParallelConverge_2</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Parallel Gateway -->
    <bpmn:parallelGateway id="Gateway_ParallelConverge" name="Repair &amp; Updates Complete">
      <bpmn:incoming>SequenceFlow_ParallelConverge_1</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ParallelConverge_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PayViaApp</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Manual Task -->
    <bpmn:manualTask id="ManualTask_PayViaApp" name="Pay Through App">
      <bpmn:incoming>SequenceFlow_PayViaApp</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConfirmPayment</bpmn:outgoing>
    </bpmn:manualTask>

    <!-- Service Task -->
    <bpmn:serviceTask id="ServiceTask_ConfirmReceipt" name="Confirm Receipt of Payment">
      <bpmn:incoming>SequenceFlow_ConfirmPayment</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConfirmRepair</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Manual Task -->
    <bpmn:manualTask id="ManualTask_ConfirmPickerl" name="Confirm Successful Repair and Grant Pickerl">
      <bpmn:incoming>SequenceFlow_ConfirmRepair</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SetNextService</bpmn:outgoing>
    </bpmn:manualTask>

    <!-- Manual Task -->
    <bpmn:manualTask id="ManualTask_SetNextService" name="Enter Time for Next Service">
      <bpmn:incoming>SequenceFlow_SetNextService</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndComplete</bpmn:outgoing>
    </bpmn:manualTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_ProcessComplete" name="Process Complete">
      <bpmn:incoming>SequenceFlow_EndComplete</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckRegistration" sourceRef="StartEvent_TimerCheck" targetRef="ServiceTask_CheckRegistration"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_IsRegistered" name="" sourceRef="ServiceTask_CheckRegistration" targetRef="Gateway_IsRegistered"/>

    <bpmn:sequenceFlow id="SequenceFlow_NotifyOwner_Yes" name="Is Registered? Yes" sourceRef="Gateway_IsRegistered" targetRef="ServiceTask_NotifyOwner"/>
    
    <!-- End Event for Unregistered -->
    <bpmn:endEvent id="EndEvent_NotRegistered_No" name="Car Not Registered">
      <bpmn:incoming>SequenceFlow_EndNotReg_No</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow_EndNotReg_No" sourceRef="Gateway_IsRegistered" targetRef="EndEvent_NotRegistered_No"/>

    <bpmn:sequenceFlow id="SequenceFlow_WaitTimer" name="" sourceRef="ServiceTask_NotifyOwner" targetRef="IntermediateEvent_WaitCheck"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_TimePassedGateway" name="" sourceRef="IntermediateEvent_WaitCheck" targetRef="Gateway_TimePassed"/>

    <bpmn:sequenceFlow id="SequenceFlow_SendFine_Yes" name="&gt; 30 Days (No Service)" sourceRef="Gateway_TimePassed" targetRef="ServiceTask_SendFine"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_EnterProblems_No" name="Car Arrived / &lt; 30 Days" sourceRef="Gateway_TimePassed" targetRef="ManualTask_EnterProblems"/>

    <bpmn:sequenceFlow id="SequenceFlow_ParallelSplit" name="" sourceRef="ManualTask_EnterProblems" targetRef="Gateway_ParallelSplit"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_RepairCar" name="" sourceRef="Gateway_ParallelSplit" targetRef="ManualTask_RepairCar"/>

    <bpmn:sequenceFlow id="SequenceFlow_SendEmailUpdates" name="" sourceRef="Gateway_ParallelSplit" targetRef="ServiceTask_SendEmailUpdates"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ParallelConverge_1" name="" sourceRef="ManualTask_RepairCar" targetRef="Gateway_ParallelConverge"/>

    <bpmn:sequenceFlow id="SequenceFlow_ParallelConverge_2" name="" sourceRef="ServiceTask_SendEmailUpdates" targetRef="Gateway_ParallelConverge"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_PayViaApp" name="" sourceRef="Gateway_ParallelConverge" targetRef="ManualTask_PayViaApp"/>

    <bpmn:sequenceFlow id="SequenceFlow_ConfirmPayment" name="" sourceRef="ManualTask_PayViaApp" targetRef="ServiceTask_ConfirmReceipt"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ConfirmRepair" name="" sourceRef="ServiceTask_ConfirmReceipt" targetRef="ManualTask_ConfirmPickerl"/>

    <bpmn:sequenceFlow id="SequenceFlow_SetNextService" name="" sourceRef="ManualTask_ConfirmPickerl" targetRef="ManualTask_SetNextService"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_EndComplete" name="" sourceRef="ManualTask_SetNextService" targetRef="EndEvent_ProcessComplete"/>

  </bpmn:process>
</bpmn:definitions>