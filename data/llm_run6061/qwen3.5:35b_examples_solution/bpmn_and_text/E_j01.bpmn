<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_JobSearch">
    <bpmn:participant id="Participant_MainProcess" name="Job Search Process" processRef="Process_JobSearch"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_JobSearch" isExecutable="false">
    
    <!-- Lane Set -->
    <bpmn:laneSet>
      <bpmn:lane id="Lane_JobSeeker" name="Job Seeker">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_ReportLoop_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WriteApplication_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_ProbationStart_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_PermanentJob_1</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Company" name="Company / HR System">
        <bpmn:flowNodeRef>InclusiveGateway_NewOffers_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConfirmApplication_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BPMNEvent_InterviewOffered_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_ProbationEnd_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RateCompany_1</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Unemployed">
      <bpmn:outgoing>bpmn_flow_StartToReportLoop</bpmn:flowNodeRef>
    </bpmn:startEvent>

    <!-- Inclusive Gateway for Reporting Loop -->
    <bpmn:inclusiveGateway id="InclusiveGateway_ReportLoop_1" name="Continue Job Search?">
      <bpmn:incoming>bpmn_flow_StartToReportLoop</bpmn:flowNodeRef>
      <bpmn:outgoing>InclusiveGateway_NewOffers_2</bpmn:flowNodeRef>
    </bpmn:inclusiveGateway>

    <!-- Task for Writing Application -->
    <bpmn:task id="Task_WriteApplication_1" name="Write Job Application">
      <bpmn:incoming>bpmn_flow_StartToReportLoop</bvmn:flowNodeRef>
      <bpmn:outgoing>InclusiveGateway_NewOffers_2</bpmn:flowNodeRef>
    </bpmn:task>

    <!-- Inclusive Gateway for New Offers -->
    <bpmn:inclusiveGateway id="InclusiveGateway_NewOffers_1" name="New Job Offer?">
      <bpmn:incoming>InclusiveGateway_ReportLoop_2</bvmn:flowNodeRef>
      <bpmn:outgoing>bpmn_flow_ConfirmationPath</bpmn:flowNodeRef>
    </bpmn:inclusiveGateway>

    <!-- Task for Company Confirmation -->
    <bpmn:task id="Task_ConfirmApplication_1" name="Confirm Receipt & Rate Application">
      <bpmn:incoming>bpmn_flow_ConfirmationPath</bvmn:flowNodeRef>
      <bpmn:outgoing>BPMNEvent_InterviewOffered_2</bvmn:flowNodeRef>
    </bpmn:task>

    <!-- Intermediate Throw Event for Interview Offer -->
    <bpmn:messageThrowEvent id="BPMNEvent_InterviewOffered_1" name="Interview Offer">
      <bpmn:incoming>bpmn_flow_ConfirmationPath</bvmn:flowNodeRef>
      <bpmn:outgoing>InclusiveGateway_ProbationStart_2</bvmn:flowNodeRef>
    </bpmn:messageThrowEvent>

    <!-- Inclusive Gateway for Probation Start -->
    <bpmn:inclusiveGateway id="InclusiveGateway_ProbationStart_1" name="Accept Offer?">
      <bpmn:incoming>BPMNEvent_InterviewOffered_2</bvmn:flowNodeRef>
      <bpmn:outgoing>InclusiveGateway_ReportLoop_3</bvmn:flowNodeRef>
    </bpmn:inclusiveGateway>

    <!-- Inclusive Gateway for Probation End -->
    <bpmn:inclusiveGateway id="InclusiveGateway_ProbationEnd_1" name="Probation Finished?">
      <bpmn:incoming>InclusiveGateway_ReportLoop_3</bvmn:flowNodeRef>
      <bpmn:outgoing>bpmn_flow_RatingPhase</bvmn:flowNodeRef>
    </bpmn:inclusiveGateway>

    <!-- Task for Rating Company -->
    <bpmn:task id="Task_RateCompany_1" name="Rate Company">
      <bpmn:incoming>InclusiveGateway_ProbationEnd_2</bvmn:flowNodeRef>
      <bpmn:outgoing>bpmn_flow_CompanyRatingReceived</bvmn:flowNodeRef>
    </bpmn:task>

    <!-- Exclusive Gateway for Permanent Job Check -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_PermanentJob_1" name="Permanent Position?">
      <bpmn:incoming>bpmn_flow_CompanyRatingReceived</bvmn:flowNodeRef>
      <bpmn:outgoing>InclusiveGateway_ReportLoop_4</bvmn:flowNodeRef>
    </bpmn:exclusiveGateway>

    <!-- Exclusive Gateway for Rating Check -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_RatingCheck_1" name="Rating > C?">
      <bpmn:incoming>InclusiveGateway_ReportLoop_4</bvmn:flowNodeRef>
      <bpmn:outgoing>bpmn_flow_EndProcess</bvmn:flowNodeRef>
    </bpmn:exclusiveGateway>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Success_1" name="Permanent Job">
      <bpmn:incoming>bpmn_flow_EndProcess</bvmn:flowNodeRef>
    </bpmn:endEvent>

    <!-- Flow Definitions -->
    
    <bpmn:sequenceFlow id="bpmn_flow_StartToReportLoop" sourceRef="StartEvent_1" targetRef="InclusiveGateway_ReportLoop_1">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="InclusiveGateway_NewOffers_2" name="Receive Offers & Confirm" sourceRef="Task_WriteApplication_1" targetRef="Task_ConfirmApplication_1"/>

    <bpmn:sequenceFlow id="InclusiveGateway_ReportLoop_2" sourceRef="ExclusiveGateway_PermanentJob_1" targetRef="InclusiveGateway_NewOffers_1">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="BPMNEvent_InterviewOffered_2" name="Interview Offer Sent" sourceRef="Task_ConfirmApplication_1" targetRef="InclusiveGateway_ProbationStart">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="InclusiveGateway_ReportLoop_3" name="Accept & Start Probation" sourceRef="InclusiveGateway_ProbationStart_1" targetRef="InclusiveGateway_ProbationEnd">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="bpmn_flow_RatingPhase" name="Probation Finished & Rate" sourceRef="InclusiveGateway_ProbationEnd_1" targetRef="Task_RateCompany">
      <bvmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="bpmn_flow_CompanyRatingReceived" name="Ratings Complete" sourceRef="InclusiveGateway_ProbationEnd_2" targetRef="ExclusiveGateway_PermanentJob">
      <bvmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="InclusiveGateway_ReportLoop_4" name="Permanent? Yes, Rating > C?" sourceRef="ExclusiveGateway_PermanentJob_1" targetRef="ExclusiveGateway_RatingCheck">
      <bvmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="InclusiveGateway_ReportLoop_5" name="Permanent? No, Continue Offers" sourceRef="ExclusiveGateway_PermanentJob_1" targetRef="Task_WriteApplication">
       <bvmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="bpmn_flow_EndProcess" name="Rating > C (Permanent)" sourceRef="ExclusiveGateway_RatingCheck_1" targetRef="EndEvent_Success_1"/>

  </bpmn:process>

</bpmn:definitions>