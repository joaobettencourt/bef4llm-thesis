<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_ViennaNightRun" isExecutable="false">

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Participate" name="Participate Night Run">
      <bpmn:outgoing>SequenceFlow_SelectBlock</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Select Starting Block (App Input) -->
    <bpmn:task id="Task_SelectStartingBlock" name="Select starting block">
      <bpmn:incoming>SequenceFlow_SelectBlock</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StartMeasureRun</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway for Run & Measure -->
    <bpmn:parallelGateway id="ParallelGateway_RunStart" name="">
      <bpmn:incoming>SequenceFlow_StartMeasureRun</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MeasureTime</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_Run5km</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Start Measure Time (Fitness Gadget) -->
    <bpmn:task id="Task_StartMeasure" name="Start to measure time">
      <bpmn:incoming>SequenceFlow_MeasureTime</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConvergeRunStop</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Run 5km -->
    <bpmn:task id="Task_Run5km" name="Run for 5 km">
      <bpmn:incoming>SequenceFlow_Run5km</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConvergeRunStop</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway Converging -->
    <bpmn:parallelGateway id="ParallelGateway_RunEnd" name="">
      <bpmn:incoming>SequenceFlow_MeasureTime</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_Run5km</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StopMeasure</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Stop Measure Time (Fitness Gadget) -->
    <bpmn:task id="Task_StopMeasure" name="Stop to measure the time">
      <bpmn:incoming>SequenceFlow_ConvergeRunStop</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GetTotalTime</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Get Total Running Time -->
    <bpmn:task id="Task_GetTotalTime" name="Get total running time">
      <bpmn:incoming>SequenceFlow_StopMeasure</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Check25Min</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway: Check Time -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_TimeCheck" name="Took less than 25 minutes?">
      <bpmn:incoming>SequenceFlow_Check25Min</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Qualified</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NotQualified</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Path: Qualified -->
    <bpmn:task id="Task_GetStartingNumber" name="Get starting number">
      <bpmn:incoming>SequenceFlow_Qualified</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WorkCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Path: Not Qualified (Loop) -->
    <bpmn:task id="Task_DoTraining" name="Do Training">
      <bpmn:incoming>SequenceFlow_NotQualified</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RetryRunStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow for Retry Loop -->
    <bpmn:sequenceFlow id="SequenceFlow_RetryRunStart" sourceRef="Task_DoTraining" targetRef="ParallelGateway_RunStart">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <!-- Exclusive Gateway: Work Day Check -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_WorkCheck" name="Ends workday &gt;1h before starting time?">
      <bpmn:incoming>SequenceFlow_WorkCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GoHome</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_FromWork</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Go from Home -->
    <bpmn:task id="Task_GoFromHome" name="Go to the run from home">
      <bpmn:incoming>SequenceFlow_GoHome</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConvergeTravel1</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Go From Work -->
    <bpmn:task id="Task_FromWork" name="Go directly after work to the run">
      <bpmn:incoming>SequenceFlow_FromWork</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConvergeTravel2</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway Converging Travel -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_TravelConverge" name="">
      <bpmn:incoming>SequenceFlow_ConvergeTravel1</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ConvergeTravel2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StartNightRunEvent</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Parallel Gateway for Run & Drink -->
    <bpmn:parallelGateway id="ParallelGateway_RunDrink" name="">
      <bpmn:incoming>SequenceFlow_StartNightRunEvent</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ActualRun</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_DrinkIsoSport</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Run Night Run -->
    <bpmn:task id="Task_ActualRun" name="Run the night run">
      <bpmn:incoming>SequenceFlow_ActualRun</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConvergeFinish1</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Drink Iso Sport -->
    <bpmn:task id="Task_DrinkIsoSport" name="Drink iso sport">
      <bpmn:incoming>SequenceFlow_DrinkIsoSport</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConvergeFinish2</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway Converging Finish -->
    <bpmn:parallelGateway id="ParallelGateway_Finish" name="">
      <bpmn:incoming>SequenceFlow_ActualRun</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_DrinkIsoSport</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReceiveTime</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Receive Final Time -->
    <bpmn:task id="Task_ReceiveFinalTime" name="Receive final running time">
      <bpmn:incoming>SequenceFlow_ConvergeFinish1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndEvent</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_RunFinished" name="Run finished">
      <bpmn:incoming>SequenceFlow_ConvergeFinish2</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows Definitions -->
    <bpmn:sequenceFlow id="SequenceFlow_SelectBlock" sourceRef="StartEvent_Participate" targetRef="Task_SelectStartingBlock">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_StartMeasureRun" sourceRef="Task_SelectStartingBlock" targetRef="ParallelGateway_RunStart"/>

    <bpmn:sequenceFlow id="SequenceFlow_MeasureTime" sourceRef="ParallelGateway_RunStart" targetRef="Task_StartMeasure"/>

    <bpmn:sequenceFlow id="SequenceFlow_Run5km" sourceRef="ParallelGateway_RunStart" targetRef="Task_Run5km"/>

    <bpmn:sequenceFlow id="SequenceFlow_ConvergeRunStop" sourceRef="ParallelGateway_RunEnd" targetRef="Task_StopMeasure"/>

    <bpmn:sequenceFlow id="SequenceFlow_GetTotalTime" sourceRef="Task_StopMeasure" targetRef="Task_GetTotalTime"/>

    <bpmn:sequenceFlow id="SequenceFlow_Check25Min" sourceRef="Task_GetTotalTime" targetRef="ExclusiveGateway_TimeCheck"/>

    <bpmn:sequenceFlow id="SequenceFlow_Qualified" name="yes" sourceRef="ExclusiveGateway_TimeCheck" targetRef="Task_GetStartingNumber"/>

    <bpmn:sequenceFlow id="SequenceFlow_NotQualified" name="no" sourceRef="ExclusiveGateway_TimeCheck" targetRef="Task_DoTraining"/>

    <bpmn:sequenceFlow id="SequenceFlow_WorkCheck" sourceRef="Task_GetStartingNumber" targetRef="ExclusiveGateway_WorkCheck"/>

    <bpmn:sequenceFlow id="SequenceFlow_GoHome" name="yes (&gt;1h)" sourceRef="ExclusiveGateway_WorkCheck" targetRef="Task_GoFromHome"/>

    <bpmn:sequenceFlow id="SequenceFlow_FromWork" name="no (&lt;1h)" sourceRef="ExclusiveGateway_WorkCheck" targetRef="Task_FromWork"/>

    <bpmn:sequenceFlow id="SequenceFlow_ConvergeTravel1" sourceRef="Task_GoFromHome" targetRef="ExclusiveGateway_TravelConverge"/>

    <bpmn:sequenceFlow id="SequenceFlow_ConvergeTravel2" sourceRef="Task_FromWork" targetRef="ExclusiveGateway_TravelConverge"/>

    <bpmn:sequenceFlow id="SequenceFlow_StartNightRunEvent" sourceRef="ExclusiveGateway_TravelConverge" targetRef="ParallelGateway_RunDrink"/>

    <bpmn:sequenceFlow id="SequenceFlow_ActualRun" sourceRef="ParallelGateway_RunDrink" targetRef="Task_ActualRun"/>

    <bpmn:sequenceFlow id="SequenceFlow_DrinkIsoSport" sourceRef="ParallelGateway_RunDrink" targetRef="Task_DrinkIsoSport"/>

    <bpmn:sequenceFlow id="SequenceFlow_ConvergeFinish1" sourceRef="Task_ActualRun" targetRef="ParallelGateway_Finish"/>

    <bpmn:sequenceFlow id="SequenceFlow_ConvergeFinish2" sourceRef="Task_DrinkIsoSport" targetRef="EndEvent_RunFinished"/>

    <bpmn:sequenceFlow id="SequenceFlow_ReceiveTime" sourceRef="ParallelGateway_Finish" targetRef="Task_ReceiveFinalTime"/>

    <bpmn:sequenceFlow id="SequenceFlow_EndEvent" sourceRef="Task_ReceiveFinalTime" targetRef="EndEvent_RunFinished"/>

  </bpmn:process>
</bpmn:definitions>