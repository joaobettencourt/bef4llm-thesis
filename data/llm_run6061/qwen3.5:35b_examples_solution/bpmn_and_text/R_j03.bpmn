<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_FridgeRepair_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_FridgeService">
    <bpmn:participant id="Participant_CustomerProcess" name="Fridge Repair Service Process" processRef="Process_FridgeRepair"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_FridgeRepair" isExecutable="false">
    
    <!-- Lane Set -->
    <bpmn:laneSet>
      <bpmn:lane id="Lane_CustomerServiceCenter" name="Customer Service Center">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_DescribeSymptoms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_SendReportToServiceCenter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_SelectLocalFacility</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_ServiceTechnician" name="Service Technician">
        <bpmn:flowNodeRef>UserTask_ScheduleAppointment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateCatchEvent_WaitForArrival</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_RepairFridge</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Customer" name="Customer">
        <bpmn:flowNodeRef>UserTask_ConfirmRepairedOK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_SubmitRating</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Fridge makes strange noises">
      <bpmn:outgoing>SequenceFlow_StartToDescribeSymptoms</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- User Task: Describe Symptoms -->
    <bpmn:userTask id="UserTask_DescribeSymptoms" name="Describe the symptoms">
      <bpmn:incoming>SequenceFlow_StartToDescribeSymptoms</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SymptomsToReport</bpmn:outgoing>
    </bpmn:userTask>

    <!-- User Task: Send Report to Service Center -->
    <bpmn:userTask id="UserTask_SendReportToServiceCenter" name="Send report to fridge service center">
      <bpmn:incoming>SequenceFlow_SymptomsToReport</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReportToSelectFacility</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Service Task: Select Local Facility -->
    <bpmn:serviceTask id="ServiceTask_SelectLocalFacility" name="Select local service facility">
      <bpmn:incoming>SequenceFlow_ReportToSelectFacility</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FacilityToScheduleAppointment</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- User Task: Schedule Appointment -->
    <bpmn:userTask id="UserTask_ScheduleAppointment" name="Schedule an appointment for fridge repair">
      <bpmn:incoming>SequenceFlow_FacilityToScheduleAppointment</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AppointmentToWaitArrival</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Intermediate Catch Event: Wait for Arrival -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_WaitForArrival" name="Wait until service facility arrives">
      <bpmn:incoming>SequenceFlow_AppointmentToWaitArrival</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ArrivalToRepairFridge</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- User Task: Repair Fridge -->
    <bpmn:userTask id="UserTask_RepairFridge" name="Repair the fridge">
      <bpmn:incoming>SequenceFlow_ArrivalToRepairFridge</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RepairsDecisionGateway</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Exclusive Gateway: Additional Parts Needed? -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_AdditionalPartsNeeded" name="Additional parts needed?">
      <bpmn:incoming>SequenceFlow_RepairsDecisionGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PartsNotNeededToConfirmOK</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PartsNeededOrderParts</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Service Task: Order Additional Parts -->
    <bpmn:serviceTask id="ServiceTask_OrderAdditionalParts" name="Service orders additional parts">
      <bpmn:incoming>SequenceFlow_PartsNeededOrderParts</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OrdersToWaitForPartsArrival</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Intermediate Catch Event: Wait for Parts -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_WaitForParts" name="Additional parts arrive">
      <bpmn:incoming>SequenceFlow_OrdersToWaitForPartsArrival</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PartsArrivedBackRepairGateway</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Exclusive Gateway: Converge after parts or direct repair -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_ConvergeAfterParts" name="">
      <bpmn:incoming>SequenceFlow_PartsArrivedBackRepairGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BackToScheduleAppointment</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- User Task: Confirm Repaired OK -->
    <bpmn:userTask id="UserTask_ConfirmRepairedOK" name="Confirm that fridge is okay">
      <bpmn:incoming>SequenceFlow_PartsNotNeededToConfirmOK</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConfirmRatingGateway</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Exclusive Gateway: Submit Rating? -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_SubmitRating" name="Submit a rating?">
      <bpmn:incoming>SequenceFlow_ConfirmRatingGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RatingYesToRateFacility</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RatingNoToEndEvent</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- User Task: Rate Service Facility -->
    <bpmn:userTask id="UserTask_RateServiceFacility" name="Rate Service Facility">
      <bpmn:incoming>SequenceFlow_RatingYesToRateFacility</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RatedToEndEvent</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_ProcessComplete" name="Repair process over">
      <bpmn:incoming>SequenceFlow_EndFromRatingNo</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_RatedToEndEvent</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToDescribeSymptoms" name="" sourceRef="StartEvent_1" targetRef="UserTask_DescribeSymptoms"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_SymptomsToReport" name="" sourceRef="UserTask_DescribeSymptoms" targetRef="UserTask_SendReportToServiceCenter"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ReportToSelectFacility" name="" sourceRef="UserTask_SendReportToServiceCenter" targetRef="ServiceTask_SelectLocalFacility"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_FacilityToScheduleAppointment" name="" sourceRef="ServiceTask_SelectLocalFacility" targetRef="UserTask_ScheduleAppointment"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_AppointmentToWaitArrival" name="" sourceRef="UserTask_ScheduleAppointment" targetRef="IntermediateCatchEvent_WaitForArrival"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ArrivalToRepairFridge" name="" sourceRef="IntermediateCatchEvent_WaitForArrival" targetRef="UserTask_RepairFridge"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_RepairsDecisionGateway" name="" sourceRef="UserTask_RepairFridge" targetRef="ExclusiveGateway_AdditionalPartsNeeded"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_PartsNotNeededToConfirmOK" name="No. Fridge is repaired" sourceRef="ExclusiveGateway_AdditionalPartsNeeded" targetRef="UserTask_ConfirmRepairedOK"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_PartsNeededOrderParts" name="Yes. Additional parts needed" sourceRef="ExclusiveGateway_AdditionalPartsNeeded" targetRef="ServiceTask_OrderAdditionalParts"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_OrdersToWaitForPartsArrival" name="" sourceRef="ServiceTask_OrderAdditionalParts" targetRef="IntermediateCatchEvent_WaitForParts"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_PartsArrivedBackRepairGateway" name="" sourceRef="IntermediateCatchEvent_WaitForParts" targetRef="ExclusiveGateway_ConvergeAfterParts"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_BackToScheduleAppointment" name="" sourceRef="ExclusiveGateway_ConvergeAfterParts" targetRef="UserTask_ScheduleAppointment"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ConfirmRatingGateway" name="" sourceRef="UserTask_ConfirmRepairedOK" targetRef="ExclusiveGateway_SubmitRating"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_RatingYesToRateFacility" name="Submit a rating" sourceRef="ExclusiveGateway_SubmitRating" targetRef="UserTask_RateServiceFacility"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_RatingNoToEndEvent" name="Do not submit a rating" sourceRef="ExclusiveGateway_SubmitRating" targetRef="EndEvent_ProcessComplete"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_EndFromRatingNo" name="" sourceRef="UserTask_ConfirmRepairedOK" targetRef="EndEvent_ProcessComplete"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_RatedToEndEvent" name="" sourceRef="UserTask_RateServiceFacility" targetRef="EndEvent_ProcessComplete"/>

  </bpmn:process>
</bpmn:definitions>