<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_ClaimsProcess">
    <bpmn:participant id="Participant_Organization" name="Claims Management Organization" processRef="Process_ClaimsNotification"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_ClaimsNotification" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Administration" name="Claims Administration">
        <bpmn:flowNodeRef>StartEvent_ClaimReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckInsuranceStatus</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_InsuredCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformRejection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ClaimRejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EvaluateSeverity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_SeverityCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendFormsSimple</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendFormsComplex</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_FormsReturned</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_CompletenessCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegisterClaim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ProcessComplete</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_ClaimReceived" name="Claim Received">
      <bpmn:outgoing>SequenceFlow_Start_CheckInsurance</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Check Insurance Status -->
    <bpmn:task id="Task_CheckInsuranceStatus" name="Check if claimant is insured">
      <bpmn:incoming>SequenceFlow_Start_CheckInsurance</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Insured_Gateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Insured Check -->
    <bpmn:exclusiveGateway id="InclusiveGateway_InsuredCheck" name="Claimant insured?">
      <bpmn:incoming>SequenceFlow_Insured_Gateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RejectionPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ProceedToSeverity</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 2: Inform Rejection -->
    <bpmn:task id="Task_InformRejection" name="Inform claimant of rejection">
      <bpmn:incoming>SequenceFlow_RejectionPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToRejectedEnd</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 1: Claim Rejected -->
    <bpmn:endEvent id="EndEvent_ClaimRejected" name="Claim Rejected">
      <bpmn:incoming>SequenceFlow_ToRejectedEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task 3: Evaluate Severity -->
    <bpmn:task id="Task_EvaluateSeverity" name="Evaluate claim severity">
      <bpmn:incoming>SequenceFlow_ProceedToSeverity</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Severity_Gateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2: Severity Decision -->
    <bpmn:exclusiveGateway id="InclusiveGateway_SeverityCheck" name="Claim type?">
      <bpmn:incoming>SequenceFlow_Severity_Gateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendSimpleForms</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SendComplexForms</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 4a: Send Simple Forms -->
    <bpmn:task id="Task_SendFormsSimple" name="Send simple claim forms">
      <bpmn:incoming>SequenceFlow_SendSimpleForms</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Simple_ToReturned</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 4b: Send Complex Forms -->
    <bpmn:task id="Task_SendFormsComplex" name="Send complex claim forms">
      <bpmn:incoming>SequenceFlow_SendComplexForms</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Complex_ToReturned</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 3: Forms Returned -->
    <bpmn:inclusiveGateway id="InclusiveGateway_FormsReturned" name="Forms returned?">
      <bpmn:incoming>SequenceFlow_Simple_ToReturned</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_Complex_ToReturned</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckCompleteness</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Gateway 4: Completeness Check -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_CompletenessCheck" name="Forms complete?">
      <bpmn:incoming>SequenceFlow_CheckCompleteness</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RegistrationPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_UpdateRequest</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 5a: Register Claim -->
    <bpmn:task id="Task_RegisterClaim" name="Register in Claims Management system">
      <bpmn:incoming>SequenceFlow_RegistrationPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToCompleteEnd</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 2: Process Complete -->
    <bpmn:endEvent id="EndEvent_ProcessComplete" name="Claims Notification complete">
      <bpmn:incoming>SequenceFlow_ToCompleteEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task 5b: Request Update (for incomplete forms) -->
    <bpmn:task id="Task_RequestUpdate" name="Inform claimant to update forms">
      <bpmn:incoming>SequenceFlow_UpdateRequest</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReturnToCheckCompleteness</bpmn:outgoing>
    </bpmn:task>

  </bpmn:process>

  <!-- Sequence Flows -->
  <bpmn:sequenceFlow id="SequenceFlow_Start_CheckInsurance" name="" sourceRef="StartEvent_ClaimReceived" targetRef="Task_CheckInsuranceStatus"/>
  
  <bpmn:sequenceFlow id="SequenceFlow_Insured_Gateway" name="" sourceRef="Task_CheckInsuranceStatus" targetRef="InclusiveGateway_InsuredCheck"/>
  
  <bpmn:sequenceFlow id="SequenceFlow_RejectionPath" name="No - Not insured" sourceRef="InclusiveGateway_InsuredCheck" targetRef="Task_InformRejection">
    <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${insured == false}</bpmn:conditionExpression>
  </bpmn:sequenceFlow>

  <bpmn:sequenceFlow id="SequenceFlow_ProceedToSeverity" name="Yes - Insured" sourceRef="InclusiveGateway_InsuredCheck" targetRef="Task_EvaluateSeverity">
    <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${insured == true}</bpmn:conditionExpression>
  </bpmn:sequenceFlow>

  <bpmn:sequenceFlow id="SequenceFlow_ToRejectedEnd" name="" sourceRef="Task_InformRejection" targetRef="EndEvent_ClaimRejected"/>

  <bpmn:sequenceFlow id="SequenceFlow_Severity_Gateway" name="" sourceRef="Task_EvaluateSeverity" targetRef="InclusiveGateway_SeverityCheck"/>
  
  <bpmn:sequenceFlow id="SequenceFlow_SendSimpleForms" name="Simple claim" sourceRef="InclusiveGateway_SeverityCheck" targetRef="Task_SendFormsSimple">
    <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${claimType == 'simple'}</bpmn:conditionExpression>
  </bpmn:sequenceFlow>

  <bpmn:sequenceFlow id="SequenceFlow_SendComplexForms" name="Complex claim" sourceRef="InclusiveGateway_SeverityCheck" targetRef="Task_SendFormsComplex">
    <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${claimType == 'complex'}</bpmn:conditionExpression>
  </bpmn:sequenceFlow>

  <bpmn:sequenceFlow id="SequenceFlow_Simple_ToReturned" name="" sourceRef="Task_SendFormsSimple" targetRef="InclusiveGateway_FormsReturned"/>
  
  <bpmn:sequenceFlow id="SequenceFlow_Complex_ToReturned" name="" sourceRef="Task_SendFormsComplex" targetRef="InclusiveGateway_FormsReturned"/>

  <bpmn:sequenceFlow id="SequenceFlow_CheckCompleteness" name="" sourceRef="InclusiveGateway_FormsReturned" targetRef="ExclusiveGateway_CompletenessCheck"/>
  
  <bpmn:sequenceFlow id="SequenceFlow_RegistrationPath" name="Yes - Complete" sourceRef="ExclusiveGateway_CompletenessCheck" targetRef="Task_RegisterClaim">
    <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${formsComplete == true}</bpmn:conditionExpression>
  </bpmn:sequenceFlow>

  <bpmn:sequenceFlow id="SequenceFlow_UpdateRequest" name="No - Incomplete" sourceRef="ExclusiveGateway_CompletenessCheck" targetRef="Task_RequestUpdate">
    <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${formsComplete == false}</bpmn:conditionExpression>
  </bpmn:sequenceFlow>

  <bpmn:sequenceFlow id="SequenceFlow_ToCompleteEnd" name="" sourceRef="Task_RegisterClaim" targetRef="EndEvent_ProcessComplete"/>

</definitions>