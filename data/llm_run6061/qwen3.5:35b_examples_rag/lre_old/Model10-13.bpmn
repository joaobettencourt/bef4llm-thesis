<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_INQ" name="INQ" processRef="Process_INQ"/>
    <bpmn:participant id="Participant_IP" name="IP" processRef="Process_IP"/>
    <bpmn:messageFlow id="MessageFlow_Request" sourceRef="ThrowEvent_TransmitRequest" targetRef="CatchEvent_ReceiveRequest">
      <bpmn:name>Transaction Data Request</bpmn:name>
    </bpmn:messageFlow>
  </bpmn:collaboration>

  <!-- INQ Process -->
  <bpmn:process id="Process_INQ" isExecutable="false">
    <bpmn:startEvent id="StartEvent_RequestInitiated" name="Request Initiated">
      <bpmn:outgoing>SequenceFlow_Start_Transmit</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_TransmitData" name="Transmit Transaction Data Request">
      <bpmn:incoming>SequenceFlow_Start_Transmit</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendMessage</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_RequestSent" name="Request Sent">
      <bpmn:incoming>SequenceFlow_End_Transmit</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:intermediateThrowEvent id="ThrowEvent_TransmitRequest" name="Send Request Message">
      <bpmn:outgoing>SequenceFlow_SendMessage</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <bpmn:sequenceFlow id="SequenceFlow_Start_Transmit" sourceRef="StartEvent_RequestInitiated" targetRef="Task_TransmitData"/>
    <bpmn:sequenceFlow id="SequenceFlow_SendMessage" sourceRef="Task_TransmitData" targetRef="ThrowEvent_TransmitRequest">
      <bpmn:name>Prepare Request</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>

  <!-- IP Process -->
  <bpmn:process id="Process_IP" isExecutable="false">
    <bpmn:startEvent id="CatchEvent_ReceiveRequest" name="Request Received">
      <bpmn:outgoing>SequenceFlow_Start_Check</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:endEvent id="EndEvent_DataTransmitted" name="Data Transmitted">
      <bpmn:incoming>SequenceFlow_SendTransmission</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_Rejected" name="Request Rejected">
      <bpmn:incoming>SequenceFlow_SendRejection</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:task id="Task_CheckRequest" name="Check Request of INQ">
      <bpmn:incoming>SequenceFlow_Start_Check</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Gateway_Decision</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="ExclusiveGateway_Examination" name="Examination Outcome?">
      <bpmn:incoming>SequenceFlow_Gateway_Decision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendTransmission</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SendRejection</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="SequenceFlow_Start_Check" sourceRef="CatchEvent_ReceiveRequest" targetRef="Task_CheckRequest"/>
    <bpmn:sequenceFlow id="SequenceFlow_Gateway_Decision" sourceRef="Task_CheckRequest" targetRef="ExclusiveGateway_Examination">
      <bpmn:name>Examination Complete</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>