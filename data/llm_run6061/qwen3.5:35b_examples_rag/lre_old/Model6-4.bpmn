<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Customer Acquisition Process" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Marketing" name="Marketing Department">
        <bpmn:flowNodeRef>Task_GetContactDetails</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CallCenter" name="Call Center">
        <bpmn:flowNodeRef>Task_DetermineContactInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_Interest</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Development" name="Head of Development">
        <bpmn:flowNodeRef>Task_AcquireCustomer</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sales" name="Sales Department">
        <bpmn:flowNodeRef>ExclusiveGateway_PresentationType</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_WaitResponse</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="Start_Event_01" name="New Potential Customer">
      <bpmn:outgoing>SequenceFlow_Start_GetDetails</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Determine Contact Details -->
    <bpmn:task id="Task_GetContactDetails" name="Determine Contact Details">
      <bpmn:incoming>SequenceFlow_Start_GetDetails</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Details_CallCenter</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: Determine Contact Person & Budget -->
    <bpmn:task id="Task_DetermineContactInfo" name="Determine Contact Person &amp; Budget">
      <bpmn:incoming>SequenceFlow_Details_CallCenter</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Info_InterestCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Is customer interested? -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_Interest" name="Customer Interested?">
      <bpmn:incoming>SequenceFlow_Info_InterestCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Gw_BigBudgetAcquire</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_Gw_PresentationStart</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 3: Head of Development acquires customer -->
    <bpmn:task id="Task_AcquireCustomer" name="Head Acquires Customer">
      <bpmn:incoming>SequenceFlow_Gw_BigBudgetAcquire</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Acquire_PresentationStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2: Presentation type decision -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_PresentationType" name="Technical Presentation?">
      <bpmn:incoming>SequenceFlow_Gw_PresentationStart</bpmn:incoaming>
      <bpmn:outgoing>SequenceFlow_SalesRepPresentation</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 4a: Sales rep presentation -->
    <bpmn:task id="Task_PresentationSales" name="Online Presentation (Sales Rep)">
      <bpmn:incoming>SequenceFlow_SalesRepPresentation</bpmn:incoaming>
      <bpmn:outgoing>SequenceFlow_Presentation_WaitTimer</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 4b: Pre-sales presentation -->
    <bpmn:task id="Task_PresentationPreSales" name="Online Presentation (Pre-Sales)">
      <bpmn:incoming>SequenceFlow_PreSalesPresentation</bpmn:incoaming>
      <bpmn:outgoing>SequenceFlow_Presentation_WaitTimer</bpmn:outgoing>
    </bpmn:task>

    <!-- Inclusive Gateway for presentation paths -->
    <bpmn:inclusiveGateway id="InclusiveGateway_WaitResponse" name="Presentation Complete">
      <bpmn:incoming>SequenceFlow_Presentation_WaitTimer</bpmn:incoaming>
      <bpmn:outgoing>SequenceFlow_Inclusive_WaitResponse</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Intermediate Catch Event with Timer -->
    <bpmn:intermediateCatchEvent id="Intermediate_Catch_Timer" name="Wait for Response (2 weeks)">
      <bpmn:incoming>SequenceFlow_Inclusive_WaitResponse</bpmn:incoaming>
      <bpmn:outgoing>SequenceFlow_Timer_CustomerContacted</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_1">
        <bpmn:timeDuration>P2W</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>

    <!-- Gateway 3: Customer contacted? -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_Contacted" name="Customer Contacted?">
      <bpmn:incoming>SequenceFlow_Timer_CustomerContacted</bpmn:incoaming>
      <bpmn:outgoing>SequenceFlow_Gw_CreateQuotation</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 5a: Sales rep calls back -->
    <bpmn:task id="Task_CallBack" name="Sales Rep Calls Back">
      <bpmn:incoming>SequenceFlow_Gw_CustomerNotContacted</bpmn:incoaming>
      <bpmn:outgoing>SequenceFlow_Callback_CreateQuotation</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 6: Create quotation -->
    <bpmn:task id="Task_CreateQuotation" name="Create Quotation">
      <bpmn:incoming>SequenceFlow_Gw_CustomerContacted</bpmn:incoaming>
      <bpmn:outgoing>SequenceFlow_Quotation_EndEvent</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="End_Event_01" name="Customer Acquired">
      <bpmn:incoming>SequenceFlow_Quotation_EndEvent</bpmn:incoaming>
    </bpmn:endEvent>

  </bpmn:process>

  <!-- Sequence Flows -->
  <bpmn:sequenceFlow id="SequenceFlow_Start_GetDetails" sourceRef="Start_Event_01" targetRef="Task_GetContactDetails"/>
  
  <bpmn:sequenceFlow id="SequenceFlow_Details_CallCenter" name="Get Contact Details Methods" sourceRef="Task_GetContactDetails" targetRef="Task_DetermineContactInfo"/>

  <!-- Call center flow -->
  <bpmn:sequenceFlow id="SequenceFlow_Info_InterestCheck" sourceRef="Task_DetermineContactInfo" targetRef="ExclusiveGateway_Interest"/>

  <!-- Interest decision flows -->
  <bpmn:sequenceFlow id="SequenceFlow_Gw_BigBudgetAcquire" name="Not Interested BUT Big Budget" conditionExpression="${!interested AND budgetHuge}" sourceRef="ExclusiveGateway_Interest" targetRef="Task_AcquireCustomer"/>
  
  <bpmn:sequenceFlow id="SequenceFlow_Gw_PresentationStart" name="Interested OR Not Acquired" conditionExpression="${interested OR !budgetHuge}" sourceRef="ExclusiveGateway_Interest" targetRef="InclusiveGateway_WaitResponse"/>

  <!-- Acquisition flow -->
  <bpmn:sequenceFlow id="SequenceFlow_Acquire_PresentationStart" sourceRef="Task_AcquireCustomer" targetRef="InclusiveGateway_WaitResponse"/>

  <!-- Presentation type decision flows -->
  <bpmn:sequenceFlow id="SequenceFlow_SalesRepPresentation" name="Not Technical" conditionExpression="${!technical}" sourceRef="ExclusiveGateway_PresentationType" targetRef="Task_PresentationSales"/>
  
  <bpmn:sequenceFlow id="SequenceFlow_PreSalesPresentation" name="Technical" conditionExpression="${technical}" sourceRef="ExclusiveGateway_PresentationType" targetRef="Task_PresentationPreSales"/>

  <!-- Wait for response flow -->
  <bpmn:sequenceFlow id="SequenceFlow_Inclusive_WaitResponse" sourceRef="InclusiveGateway_WaitResponse" targetRef="Intermediate_Catch_Timer"/>

  <!-- Timer to customer contacted decision -->
  <bpmn:sequenceFlow id="SequenceFlow_Timer_CustomerContacted" name="After 2 weeks or Contact Received" sourceRef="Intermediate_Catch_Timer" targetRef="ExclusiveGateway_Contacted"/>

  <!-- Customer contact flows -->
  <bpmn:sequenceFlow id="SequenceFlow_Gw_CreateQuotation" name="Customer Contacted Within Time" conditionExpression="${contactWithinTime}" sourceRef="ExclusiveGateway_Contacted" targetRef="Task_CreateQuotation"/>
  
  <bpmn:sequenceFlow id="SequenceFlow_Gw_CustomerNotContacted" name="No Response After Timeout" conditionExpression="${!contactWithinTime}" sourceRef="ExclusiveGateway_Contacted" targetRef="Task_CallBack"/>

  <!-- Callback flow -->
  <bpmn:sequenceFlow id="SequenceFlow_Callback_CreateQuotation" sourceRef="Task_CallBack" targetRef="Task_CreateQuotation"/>

  <!-- Quotation to end event -->
  <bpmn:sequenceFlow id="SequenceFlow_Quotation_EndEvent" name="Create Final Quotation" sourceRef="Task_CreateQuotation" targetRef="End_Event_01"/>

</definitions>