<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_Internal_Members">
    <bpmn:participant id="Participant_Internal" name="Internal Team" processRef="Process_Internal"/>
    <bpmn:participant id="Participant_CommitteeMembers" name="Committee Members" processRef="Process_Committee"/>
  </bpmn:collaboration>

  <!-- Internal Process -->
  <bpmn:process id="Process_Internal" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_SupportOfficer" name="Support Officer">
        <bpmn:flowNodeRef>StartEvent_DatesFinalized</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateCalendars</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateFolders</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UploadDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateThrow_AdviseMembers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateCatch_MeetingDone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProduceMinutes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ProcessComplete</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CoordinationUnit" name="Coordination Unit">
        <bpmn:flowNodeRef>Task_QACheckMinutes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateThrow_SendResults</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_DatesFinalized" name="Dates Finalized">
      <bpmn:outgoing>SequenceFlow_Start_UpdateCalendars</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_ProcessComplete" name="Process Complete">
      <bpmn:incoming>SequenceFlow_End_RecordsUpdated</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Tasks Support Officer Lane -->
    <bpmn:task id="Task_UpdateCalendars" name="Update group calendars">
      <bpmn:incoming>SequenceFlow_Start_UpdateCalendars</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CreateFolders</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_CreateFolders" name="Create meeting folders">
      <bpmn:incoming>SequenceFlow_CreateFolders</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_UploadDocs</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_UploadDocs" name="Ensure documents uploaded">
      <bpmn:incoming>SequenceFlow_UploadDocs</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AdviseMembers</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Throw Event -->
    <bpmn:intermediateThrowEvent id="IntermediateThrow_AdviseMembers" name="Advise members a week before">
      <bpmn:incoming>SequenceFlow_AdviseMembers</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitMeetingDone</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <!-- Intermediate Catch Event -->
    <bpmn:intermediateCatchEvent id="IntermediateCatch_MeetingDone" name="Wait for meeting completion">
      <bpmn:incoming>SequenceFlow_WaitMeetingDone</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProduceMinutes</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Tasks Coordination Unit Lane -->
    <bpmn:task id="Task_QACheckMinutes" name="QA check on minutes">
      <bpmn:incoming>SequenceFlow_MinutesReady</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendResults</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Throw Event -->
    <bpmn:intermediateThrowEvent id="IntermediateThrow_SendResults" name="Send minutes to members">
      <bpmn:incoming>SequenceFlow_SendResults</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_UpdateRecords</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <!-- Task Support Officer Lane -->
    <bpmn:task id="Task_ProduceMinutes" name="Produce minutes with Action Points">
      <bpmn:incoming>SequenceFlow_ProduceMinutes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MinutesReady</bpmn:outgoing>
    </bpmn:task>

  </bpmn:process>

  <!-- Committee Members Process -->
  <bpmn:process id="Process_Committee" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Members" name="Committee Members">
        <bpmn:flowNodeRef>StartEvent_Advised</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReadDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HoldMeeting</bpmn:flowNodeRef>
      </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Advised" name="Advised to read documents">
      <bpmn:outgoing>SequenceFlow_ReadDocs</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task Read Docs -->
    <bpmn:task id="Task_ReadDocs" name="Read related documents">
      <bpmn:incoming>SequenceFlow_ReadDocs</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_HoldMeeting</bpmn:outgoing>
    </bpmn:task>

    <!-- Task Hold Meeting -->
    <bpmn:task id="Task_HoldMeeting" name="Hold meeting">
      <bpmn:incoming>SequenceFlow_HoldMeeting</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MeetingDone</bpmn:outgoing>
    </bpmn:task>

  </bpmn:process>

  <!-- Sequence Flows Internal -->
  <bpmn:sequenceFlow id="SequenceFlow_Start_UpdateCalendars" sourceRef="StartEvent_DatesFinalized" targetRef="Task_UpdateCalendars"/>
  <bpmn:sequenceFlow id="SequenceFlow_CreateFolders" name="" sourceRef="Task_UpdateCalendars" targetRef="Task_CreateFolders"/>
  <bpmn:sequenceFlow id="SequenceFlow_UploadDocs" name="" sourceRef="Task_CreateFolders" targetRef="Task_UploadDocs"/>
  <bpmn:sequenceFlow id="SequenceFlow_AdviseMembers" name="" sourceRef="Task_UploadDocs" targetRef="IntermediateThrow_AdviseMembers"/>
  <bpmn:sequenceFlow id="SequenceFlow_WaitMeetingDone" name="" sourceRef="IntermediateThrow_AdviseMembers" targetRef="IntermediateCatch_MeetingDone"/>
  <bpmn:sequenceFlow id="SequenceFlow_ProduceMinutes" name="" sourceRef="IntermediateCatch_MeetingDone" targetRef="Task_ProduceMinutes"/>
  <bpmn:sequenceFlow id="SequenceFlow_MinutesReady" name="" sourceRef="Task_ProduceMinutes" targetRef="Task_QACheckMinutes">
    <!-- Note: Flow crosses lanes, typically handled by sequence flow in BPMN -->
  </bpmn:sequenceFlow>

  <!-- Sequence Flows Coordination Unit Lane (Internal) -->
  <bpmn:sequenceFlow id="SequenceFlow_SendResults" name="" sourceRef="Task_QACheckMinutes" targetRef="IntermediateThrow_SendResults"/>
  <bpmn:sequenceFlow id="SequenceFlow_UpdateRecords" name="" sourceRef="IntermediateThrow_SendResults" targetRef="EndEvent_ProcessComplete">
    <!-- Note: Flow crosses lanes back to Support Officer lane for final update -->
  </bpmn:sequenceFlow>

  <!-- Sequence Flows Committee Members Internal -->
  <bpmn:sequenceFlow id="SequenceFlow_ReadDocs" name="" sourceRef="StartEvent_Advised" targetRef="Task_ReadDocs"/>
  <bpmn:sequenceFlow id="SequenceFlow_HoldMeeting" name="" sourceRef="Task_ReadDocs" targetRef="Task_HoldMeeting"/>
  <bpmn:sequenceFlow id="SequenceFlow_MeetingDone" name="" sourceRef="Task_HoldMeeting" targetRef="EndEvent_CommitteeComplete">
    <!-- Note: End event for committee process -->
  </bpmn:sequenceFlow>

  <!-- Message Flows Collaboration -->
  <bpmn:message id="Message_AdviseMembers" />
  <bpmn:message id="Message_MeetingDone" />
  
  <bpmn:messageFlow id="MsgFlow_Advise" sourceRef="IntermediateThrow_AdviseMembers" targetRef="StartEvent_Advised">
    <bpmn:sourceRef>IntermediateThrow_AdviseMembers</bpmn:sourceRef>
    <bpmn:targetRef>StartEvent_Advised</bpmn:targetRef>
  </bpmn:messageFlow>

  <!-- Note: Intermediate Catch Event in Internal Process needs to catch the message from Committee -->
  <!-- To make this valid, we link Sequence Flow WaitMeetingDone -> Message Throw (Committee) or similar. 
       However, for strict XML validity without complex event definitions on flows:
       We assume a logical connection via sequence flow between processes is not possible directly in one process definition.
       In BPMN 2.0 Collaboration, Intermediate Catch Events can catch messages from other participants. -->

</bpmn:definitions>