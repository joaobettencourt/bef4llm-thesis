<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Recruitment Process" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="true">
    
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_VacancyReported" name="Vacancy reported">
      <bpmn:outgoing>SequenceFlow_Start_CreateDescription</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Create Job Description -->
    <bpmn:task id="Task_CreateJobDescription" name="Create job description from information">
      <bpmn:incoming>SequenceFlow_Start_CreateDescription</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Description_ConfusionCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Confusion Check -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_Confusion" name="Confusion in message?">
      <bpmn:incoming>SequenceFlow_Description_ConfusionCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Confused_AskDepartment</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoConfusion_SubmitApproval</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Intermediate Message Event for Confusion -->
    <bpmn:intermediateCatchEvent id="IntermediateMessage_Confused" name="Ask Department">
      <bpmn:incoming>SequenceFlow_Confused_AskDepartment</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Clarity_ReturnToDescription</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task 2: Submit for Approval -->
    <bpmn:task id="Task_SubmitForApproval" name="Submit job description for consideration and approval">
      <bpmn:incoming>SequenceFlow_NoConfusion_SubmitApproval</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Approval_WaitResponse</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Message Event for Approval -->
    <bpmn:intermediateCatchEvent id="IntermediateMessage_Approval" name="Wait for approval/rejection">
      <bpmn:incoming>SequenceFlow_Approval_WaitResponse</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Response_DecisionGateway</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Gateway 2: Approval Decision -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_Approved" name="Approved?">
      <bpmn:incoming>SequenceFlow_Response_DecisionGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Rejected_CorrectDescription</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_Approved_PostJob</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 3: Correct Description -->
    <bpmn:task id="Task_CorrectDescription" name="Correct the description">
      <bpmn:incoming>SequenceFlow_Rejected_CorrectDescription</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Correction_ResubmitApproval</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_VacancyPosted" name="Vacancy posted">
      <bpmn:incoming>SequenceFlow_Approved_PostJob</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_Start_CreateDescription" sourceRef="StartEvent_VacancyReported" targetRef="Task_CreateJobDescription"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_Description_ConfusionCheck" name="" sourceRef="Task_CreateJobDescription" targetRef="ExclusiveGateway_Confusion">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_Confused_AskDepartment" name="Yes - confusion exists" sourceRef="ExclusiveGateway_Confusion" targetRef="IntermediateMessage_Confused">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${confusionExists}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_NoConfusion_SubmitApproval" name="No confusion - proceed to approval" sourceRef="ExclusiveGateway_Confusion" targetRef="Task_SubmitForApproval">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${!confusionExists}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_Clarity_ReturnToDescription" sourceRef="IntermediateMessage_Confused" targetRef="Task_CreateJobDescription"/>

    <bpmn:sequenceFlow id="SequenceFlow_Approval_WaitResponse" name="" sourceRef="Task_SubmitForApproval" targetRef="IntermediateMessage_Approval">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_Response_DecisionGateway" name="" sourceRef="IntermediateMessage_Approval" targetRef="ExclusiveGateway_Approved">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_Rejected_CorrectDescription" name="Rejected - needs correction" sourceRef="ExclusiveGateway_Approved" targetRef="Task_CorrectDescription">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${!approved}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_Approved_PostJob" name="Approved - post job" sourceRef="ExclusiveGateway_Approved" targetRef="EndEvent_VacancyPosted">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${approved}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_Correction_ResubmitApproval" name="" sourceRef="Task_CorrectDescription" targetRef="Task_SubmitForApproval">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>