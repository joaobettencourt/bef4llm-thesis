<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                 xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                 xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                 xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
                 id="Definitions_NewClientAcquisition" targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:collaboration id="Collaboration_ClientAcquisition">
    <bpmn:participant id="Participant_ManagementMarketing" name="New Client Acquisition Process" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="true">
    
    <!-- Lane Set for different roles -->
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Management" name="Management">
        <bpmn:flowNodeRef>StartEvent_NewClientsNeeded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AnalyzeOfferFailure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ClientResponse</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Marketing" name="Marketing Team">
        <bpmn:flowNodeRef>Task_PerformMarketAnalysis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PreparePortfolioPresentation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendOffersToClients</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_NewClientsNeeded" name="New Clients Needed">
      <bpmn:description>Management indicates need for new clients</bpmn:description>
      <bpmn:outgoing>SequenceFlow_StartToAnalysis</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Marketing Tasks -->
    <bpmn:userTask id="Task_PerformMarketAnalysis" name="Perform market analysis">
      <bpmn:description>Analyze current market conditions and opportunities</bpmn:description>
      <bpmn:incoming>SequenceFlow_StartToAnalysis</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AnalysisToPresentation</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_PreparePortfolioPresentation" name="Prepare portfolio presentation">
      <bpmn:description>Create comprehensive client presentation materials</bpmn:description>
      <bpmn:incoming>SequenceFlow_AnalysisToPresentation</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PresentationToOffers</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Send Offers Task -->
    <bpmn:userTask id="Task_SendOffersToClients" name="Send offers to potential clients">
      <bpmn:description>Distribute offer proposals to identified prospects</bpmn:description>
      <bpmn:incoming>SequenceFlow_PresentationToOffers</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OffersToManagementNotification</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway for Client Response -->
    <bpmn:exclusiveGateway id="Gateway_ClientResponse" name="Client responded?">
      <bpmn:description>Determine if client has provided feedback on offer</bpmn:description>
      <bpmn:incoming>SequenceFlow_OffersToManagementNotification</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ClientAcceptedOffer</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_OfferRejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Detailed Offer Task -->
    <bpmn:userTask id="Task_SendDetailedOffer" name="Send detailed offer to client">
      <bpmn:description>Negotiate and send comprehensive offer details</bpmn:description>
      <bpmn:incoming>SequenceFlow_ClientAcceptedOffer</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DetailedToContractPreparation</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Contract Preparation Task -->
    <bpmn:userTask id="Task_PrepareContract" name="Prepare contract">
      <bpmn:description>Create formal agreement document for client signature</bpmn:description>
      <bpmn:incoming>SequenceFlow_DetailedToContractPreparation</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ContractToSigning</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Contract Signing End Event -->
    <bpmn:endEvent id="EndEvent_ContractSigned" name="Contract Signed">
      <bpmn:description>New client successfully acquired and contract finalized</bpmn:description>
      <bpmn:incoming>SequenceFlow_ContractToSigning</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Failure Analysis Task -->
    <bpmn:userTask id="Task_AnalyzeOfferFailure" name="Analyze offer failure">
      <bpmn:description>Evaluate reasons for rejected offers to improve future processes</bpmn:description>
      <bpmn:incoming>SequenceFlow_OfferRejected</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AnalysisToImprovement</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Failure End Event -->
    <bpmn:endEvent id="EndEvent_ProcessImproved" name="Process Improved">
      <bpmn:description>Lessons learned from failed offer incorporated into future processes</bpmn:description>
      <bpmn:incoming>SequenceFlow_AnalysisToImprovement</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToAnalysis" sourceRef="StartEvent_NewClientsNeeded" targetRef="Task_PerformMarketAnalysis">
      <bpmn:description>Initiate market analysis process</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_AnalysisToPresentation" sourceRef="Task_PerformMarketAnalysis" targetRef="Task_PreparePortfolioPresentation">
      <bpmn:description>Moving from market analysis to presentation preparation</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_PresentationToOffers" sourceRef="Task_PreparePortfolioPresentation" targetRef="Task_SendOffersToClients">
      <bpmn:description>Presentation ready for client outreach</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_OffersToManagementNotification" sourceRef="Task_SendOffersToClients" targetRef="Gateway_ClientResponse">
      <bpmn:description>Awaiting client responses to offers</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ClientAcceptedOffer" name="Client accepted offer" sourceRef="Gateway_ClientResponse" targetRef="Task_SendDetailedOffer">
      <bpmn:description>Positive client response - proceed with detailed negotiations</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_OfferRejected" name="Client rejected offer" sourceRef="Gateway_ClientResponse" targetRef="Task_AnalyzeOfferFailure">
      <bpmn:description>Negative client response - analyze for improvement</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_DetailedToContractPreparation" sourceRef="Task_SendDetailedOffer" targetRef="Task_PrepareContract">
      <bpmn:description>Detailed offer accepted - prepare formal contract</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ContractToSigning" sourceRef="Task_PrepareContract" targetRef="EndEvent_ContractSigned">
      <bpmn:description>Contract ready for client signature and finalization</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_AnalysisToImprovement" sourceRef="Task_AnalyzeOfferFailure" targetRef="EndEvent_ProcessImproved">
      <bpmn:description>Analysis complete - process improvements implemented</bpmn:description>
    </bpmn:sequenceFlow>

  </bpmn:process>

</bpmn:definitions>