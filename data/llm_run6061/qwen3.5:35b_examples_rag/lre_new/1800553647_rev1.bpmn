<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_PurchaseProcess">
    <bpmn:participant id="Participant_ACMEInc" name="ACME Inc." processRef="Process_PurchaseOrder" />
  </bpmn:collaboration>

  <bpmn:process id="Process_PurchaseOrder" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_DemandDepartment" name="Demand Department">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckStockAvailability</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DemandDecision</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_CentralProcurement" name="Central Procurement">
        <bpmn:flowNodeRef>Task_CreatePurchaseRequisition</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SupplierCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckSupplierInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateNewSupplier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateOrderTemplate</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Approver" name="Approver">
        <bpmn:flowNodeRef>Gateway_OrderApprovalDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ApproveOrder</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Demand Identified">
      <bpmn:outgoing>SequenceFlow_StartToStockCheck</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Check Stock Availability -->
    <bpmn:userTask id="Task_CheckStockAvailability" name="Check if goods available in stock">
      <bpmn:incoming>SequenceFlow_StartToStockCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StockDecision</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway: Demand Decision (Enough Stock?) -->
    <bpmn:exclusiveGateway id="Gateway_DemandDecision" name="Goods available in stock?">
      <bpmn:incoming>SequenceFlow_StockDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SufficientStock</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CreateRequisition</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event 1: Local Consumption -->
    <bpmn:endEvent id="EndEvent_LocalConsumption" name="Goods Consumed Locally">
      <bpmn:incoming>SequenceFlow_SufficientStock</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task: Create Purchase Requisition -->
    <bpmn:userTask id="Task_CreatePurchaseRequisition" name="Create purchase requisition in ERP system">
      <bpmn:incoming>SequenceFlow_CreateRequisition</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RequisitionToSupplierCheck</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway: Supplier Check -->
    <bpmn:exclusiveGateway id="Gateway_SupplierCheck" name="Supplier information available?">
      <bpmn:incoming>SequenceFlow_RequisitionToSupplierCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NewSupplierRequired</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_KnownSupplierProceed</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Check Supplier Info -->
    <bpmn:userTask id="Task_CheckSupplierInfo" name="Check supplier information in ERP system">
      <bpmn:incoming>SequenceFlow_RequisitionToSupplierCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SupplierDecision</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Create New Supplier -->
    <bpmn:userTask id="Task_CreateNewSupplier" name="Create new supplier in ERP system">
      <bpmn:incoming>SequenceFlow_NewSupplierRequired</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SupplierCreatedProceed</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Create Order Template -->
    <bpmn:userTask id="Task_CreateOrderTemplate" name="Create order template in ERP system">
      <bpmn:incoming>SequenceFlow_KnownSupplierProceed</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_SupplierCreatedProceed</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TemplateToApprovalGateway</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway: Order Approval Decision -->
    <bpmn:exclusiveGateway id="Gateway_OrderApprovalDecision" name="Order ready for approval?">
      <bpmn:incoming>SequenceFlow_TemplateToApprovalGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ApprovalRequired</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Approve Order -->
    <bpmn:userTask id="Task_ApproveOrder" name="Approve order and trigger purchase">
      <bpmn:incoming>SequenceFlow_ApprovalRequired</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OrderTriggeredToEnd</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event 2: Purchase Order Triggered -->
    <bpmn:endEvent id="EndEvent_PurchaseOrder" name="Purchase Order Triggered">
      <bpmn:incoming>SequenceFlow_OrderTriggeredToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToStockCheck" sourceRef="StartEvent_1" targetRef="Task_CheckStockAvailability">
      <bpmn:description>Demand identified within department</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_StockDecision" name="Check stock availability" sourceRef="Task_CheckStockAvailability" targetRef="Gateway_DemandDecision">
      <bpmn:description>Determine if goods available in inventory</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_SufficientStock" name="Yes - Sufficient Stock" sourceRef="Gateway_DemandDecision" targetRef="EndEvent_LocalConsumption">
      <bpmn:description>Goods consumed locally, no further action required</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_CreateRequisition" name="No - Insufficient Stock" sourceRef="Gateway_DemandDecision" targetRef="Task_CreatePurchaseRequisition">
      <bpmn:description>Create purchase requisition in ERP system</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_RequisitionToSupplierCheck" sourceRef="Task_CreatePurchaseRequisition" targetRef="Gateway_SupplierCheck">
      <bpmn:description>Purchase requisition processed by Central Procurement</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_NewSupplierRequired" name="No - New Supplier Required" sourceRef="Gateway_SupplierCheck" targetRef="Task_CreateNewSupplier">
      <bpmn:description>Create new supplier in ERP system first</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_KnownSupplierProceed" name="Yes - Known Supplier" sourceRef="Gateway_SupplierCheck" targetRef="Task_CreateOrderTemplate">
      <bpmn:description>Use requisition to create order template</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_SupplierCreatedProceed" sourceRef="Task_CreateNewSupplier" targetRef="Task_CreateOrderTemplate">
      <bpmn:description>New supplier created, proceed to order template</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_TemplateToApprovalGateway" sourceRef="Task_CreateOrderTemplate" targetRef="Gateway_OrderApprovalDecision">
      <bpmn:description>Order template ready for approval review</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ApprovalRequired" name="Yes - Approval Required" sourceRef="Gateway_OrderApprovalDecision" targetRef="Task_ApproveOrder">
      <bpmn:description>Purchase order requires approver approval</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_OrderTriggeredToEnd" name="Approved - Order Triggered" sourceRef="Task_ApproveOrder" targetRef="EndEvent_PurchaseOrder">
      <bpmn:description>Purchase order triggered from ERP system</bpmn:description>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>