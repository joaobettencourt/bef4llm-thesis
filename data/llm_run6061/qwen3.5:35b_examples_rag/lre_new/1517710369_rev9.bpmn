<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_CreditCardAddition_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_UserProcess_001" name="Credit Card Addition Process" processRef="Process_CreditCardAddition_001" />
  </bpmn:collaboration>

  <bpmn:process id="Process_CreditCardAddition_001" isExecutable="true">
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_ChosePayment_001" name="Choose Credit Card Payment">
      <bpmn:outgoing>SequenceFlow_StartToDetails_001</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Enter Credit Card Details -->
    <bpmn:userTask id="Task_EnterCardDetails_001" name="Enter credit card details">
      <bpmn:incoming>SequenceFlow_StartToDetails_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DetailsToAddressCheck_001</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway: Check Billing Address -->
    <bpmn:exclusiveGateway id="Gateway_AddressCheck_001" name="Billing address correct?">
      <bpmn:incoming>SequenceFlow_DetailsToAddressCheck_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InvalidAddress_001</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ValidAddress_001</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Modify Address (loop back) -->
    <bpmn:userTask id="Task_ModifyAddress_001" name="Modify billing address">
      <bpmn:incoming>SequenceFlow_InvalidAddress_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ModifiedToDetails_001</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Click Continue Button -->
    <bpmn:userTask id="Task_ClickContinue_001" name="Click continue button">
      <bpmn:incoming>SequenceFlow_ValidAddress_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ContinueToVerification_001</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Service Task: Verify Credit Card -->
    <bpmn:serviceTask id="ServiceTask_VerifyCard_001" name="Verify credit card with Authority">
      <bpmn:incoming>SequenceFlow_ContinueToVerification_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ResultCheck_001</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Gateway: Check Verification Result -->
    <bpmn:exclusiveGateway id="Gateway_VerificationResult_001" name="Card validated?">
      <bpmn:incoming>SequenceFlow_ResultCheck_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Validated_001</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NotValidated_001</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Add Credit Card (Success) -->
    <bpmn:userTask id="Task_AddCard_001" name="Add credit card to account">
      <bpmn:incoming>SequenceFlow_Validated_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SuccessToEnd_001</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Cancel Addition (Failure) -->
    <bpmn:userTask id="Task_CancelAddition_001" name="Cancel credit card addition">
      <bpmn:incoming>SequenceFlow_NotValidated_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FailureToEnd_001</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event: Success -->
    <bpmn:endEvent id="EndEvent_Success_001" name="Credit card added">
      <bpmn:incoming>SequenceFlow_SuccessToEnd_001</bpmn:incoming>
    </bpmn:endEvent>

    <!-- End Event: Failure -->
    <bpmn:endEvent id="EndEvent_Failure_001" name="Addition cancelled">
      <bpmn:incoming>SequenceFlow_FailureToEnd_001</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToDetails_001" sourceRef="StartEvent_ChosePayment_001" targetRef="Task_EnterCardDetails_001">
      <bpmn:name>User chooses to pay with credit card</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_DetailsToAddressCheck_001" sourceRef="Task_EnterCardDetails_001" targetRef="Gateway_AddressCheck_001">
      <bpmn:name>Credit card details entered</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_InvalidAddress_001" sourceRef="Gateway_AddressCheck_001" targetRef="Task_ModifyAddress_001">
      <bpmn:name>No - Incorrect</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ValidAddress_001" sourceRef="Gateway_AddressCheck_001" targetRef="Task_ClickContinue_001">
      <bpmn:name>Yes - Correct</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ModifiedToDetails_001" sourceRef="Task_ModifyAddress_001" targetRef="Gateway_AddressCheck_001">
      <bpmn:name>User modifies address</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ContinueToVerification_001" sourceRef="Task_ClickContinue_001" targetRef="ServiceTask_VerifyCard_001">
      <bpmn:name>User clicks continue</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ResultCheck_001" sourceRef="ServiceTask_VerifyCard_001" targetRef="Gateway_VerificationResult_001">
      <bpmn:name>Credit card verification result</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_Validated_001" sourceRef="Gateway_VerificationResult_001" targetRef="Task_AddCard_001">
      <bpmn:name>Yes - Validated</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_NotValidated_001" sourceRef="Gateway_VerificationResult_001" targetRef="Task_CancelAddition_001">
      <bpmn:name>No - Not Validated</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_SuccessToEnd_001" sourceRef="Task_AddCard_001" targetRef="EndEvent_Success_001">
      <bpmn:name>Credit card added</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_FailureToEnd_001" sourceRef="Task_CancelAddition_001" targetRef="EndEvent_Failure_001">
      <bpmn:name>Addition cancelled</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>

  <!-- BPMN Diagram Information -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_001">
    <bpmndi:BPMNPlane id="BPMNPlane_CreditCardAddition" bpmnElement="Process_CreditCardAddition_001">
      <!-- Basic plane declaration for valid BPMN structure -->
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>