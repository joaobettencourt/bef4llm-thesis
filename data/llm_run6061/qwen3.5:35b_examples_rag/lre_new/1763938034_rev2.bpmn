<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" 
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI" 
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" 
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_RewardTraining_001" targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:collaboration id="Collaboration_EmployeeRewardProcess">
    <bpmn:participant id="Participant_MainProcess" name="Employee Reward and Training Process" processRef="Process_RewardTraining_001"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_RewardTraining_001" isExecutable="true">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Management" name="Management Department">
        <bpmn:flowNodeRef>StartEvent_PerformanceCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckPerformance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Decision1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RewardType</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SuggestDismissal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SuggestTraining</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ChooseBenefit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AnnounceEmployeeMonth</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_HR" name="Human Resources Department">
        <bpmn:flowNodeRef>Task_DismissEmployee</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProvideTraining</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Finance" name="Finance Department">
        <bpmn:flowNodeRef>Task_CalculateFinancialReward</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_PerformanceCheck" name="Performance Check">
      <bpmn:outgoing>SequenceFlow_CheckToDecision1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Management checks performance -->
    <bpmn:userTask id="Task_CheckPerformance" name="Check employee performance">
      <bpmn:incoming>SequenceFlow_CheckToDecision1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PerformanceResult</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway 1: Performance Decision -->
    <bpmn:exclusiveGateway id="Gateway_Decision1" name="Performance Level?">
      <bpmn:incoming>SequenceFlow_PerformanceResult</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DismissalPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_TrainingPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RewardPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Suggest Dismissal -->
    <bpmn:userTask id="Task_SuggestDismissal" name="Suggest employee dismissal to HR">
      <bpmn:incoming>SequenceFlow_DismissalPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToHRDismiss</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Dismiss Employee -->
    <bpmn:userTask id="Task_DismissEmployee" name="Dismiss employee">
      <bpmn:incoming>SequenceFlow_ToHRDismiss</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndDismissal</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Suggest Training -->
    <bpmn:userTask id="Task_SuggestTraining" name="Suggest training to HR">
      <bpmn:incoming>SequenceFlow_TrainingPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToHRProvide</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Provide Training -->
    <bpmn:userTask id="Task_ProvideTraining" name="Provide training to employee">
      <bpmn:incoming>SequenceFlow_ToHRProvide</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndTraining</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway 2: Reward Type Decision -->
    <bpmn:exclusiveGateway id="Gateway_RewardType" name="Reward Type?">
      <bpmn:incoming>SequenceFlow_RewardPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FinancialReward</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_BenefitReward</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Calculate Financial Reward -->
    <bpmn:userTask id="Task_CalculateFinancialReward" name="Calculate and pay financial reward">
      <bpmn:incoming>SequenceFlow_FinancialReward</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToAnnouncement</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Choose Benefit -->
    <bpmn:userTask id="Task_ChooseBenefit" name="Choose appropriate benefit">
      <bpmn:incoming>SequenceFlow_BenefitReward</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToAnnouncement2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Announce Employee of Month -->
    <bpmn:userTask id="Task_AnnounceEmployeeMonth" name="Announce employee as Employee of the Month">
      <bpmn:incoming>SequenceFlow_ToAnnouncement</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ToAnnouncement2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndRewardProcess</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_Dismissal" name="Employee Dismissed">
      <bpmn:incoming>SequenceFlow_EndDismissal</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_Training" name="Training Completed">
      <bpmn:incoming>SequenceFlow_EndTraining</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_RewardProcess" name="Reward Process Complete">
      <bpmn:incoming>SequenceFlow_EndRewardProcess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckToDecision1" sourceRef="StartEvent_PerformanceCheck" targetRef="Task_CheckPerformance"/>

    <bpmn:sequenceFlow id="SequenceFlow_PerformanceResult" name="Performance Result" sourceRef="Task_CheckPerformance" targetRef="Gateway_Decision1">
      <bpmn:description>Determine which performance category</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Dismissal Path (< 20%) -->
    <bpmn:sequenceFlow id="SequenceFlow_DismissalPath" name="< 20%" sourceRef="Gateway_Decision1" targetRef="Task_SuggestDismissal">
      <bpmn:description>Performance below threshold</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Training Path (20% - 50%) -->
    <bpmn:sequenceFlow id="SequenceFlow_TrainingPath" name="20%-50%" sourceRef="Gateway_Decision1" targetRef="Task_SuggestTraining">
      <bpmn:description>Performance requires improvement</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Reward Path (> 75%) -->
    <bpmn:sequenceFlow id="SequenceFlow_RewardPath" name="> 75%" sourceRef="Gateway_Decision1" targetRef="Gateway_RewardType">
      <bpmn:description>High performance - eligible for reward</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- HR Dismissal Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_ToHRDismiss" sourceRef="Task_SuggestDismissal" targetRef="Task_DismissEmployee">
      <bpmn:description>Suggestion forwarded to HR for action</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Training Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_ToHRProvide" sourceRef="Task_SuggestTraining" targetRef="Task_ProvideTraining">
      <bpmn:description>Suggestion forwarded to HR for training</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Financial Reward Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_FinancialReward" name="Financial Reward" sourceRef="Gateway_RewardType" targetRef="Task_CalculateFinancialReward">
      <bpmn:description>Select financial reward option</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Benefit Reward Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_BenefitReward" name="Other Benefit" sourceRef="Gateway_RewardType" targetRef="Task_ChooseBenefit">
      <bpmn:description>Select non-financial benefit option</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Flow to Announcement -->
    <bpmn:sequenceFlow id="SequenceFlow_ToAnnouncement" sourceRef="Task_CalculateFinancialReward" targetRef="Task_AnnounceEmployeeMonth">
      <bpmn:description>After financial reward processed</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Flow to Announcement 2 -->
    <bpmn:sequenceFlow id="SequenceFlow_ToAnnouncement2" sourceRef="Task_ChooseBenefit" targetRef="Task_AnnounceEmployeeMonth">
      <bpmn:description>After benefit selected</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- End Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_EndDismissal" sourceRef="Task_DismissEmployee" targetRef="EndEvent_Dismissal">
      <bpmn:description>Dismissal process complete</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_EndTraining" sourceRef="Task_ProvideTraining" targetRef="EndEvent_Training">
      <bpmn:description>Training completed successfully</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_EndRewardProcess" sourceRef="Task_AnnounceEmployeeMonth" targetRef="EndEvent_RewardProcess">
      <bpmn:description>Reward process complete - employee recognized</bpmn:description>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>