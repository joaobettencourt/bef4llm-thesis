<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_InvoiceProcess">
    <bpmn:participant id="Participant_SSP" name="SSP Mail Centre Process" processRef="Process_InvoiceProcessing" />
  </bpmn:collaboration>

  <bpmn:process id="Process_InvoiceProcessing" isExecutable="true">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_MailCentre" name="Mail Centre Office">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CategorizeInvoice</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Administration" name="Administration Department">
        <bpmn:flowNodeRef>Task_ProcessInvoiceComplex</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PutInCollectionBox</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_DataEntry" name="Data Entry Office">
        <bpmn:flowNodeRef>IntermediateTimerDaily10am</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterSAPSystemComplex</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Validation" name="Validation Office">
        <bpmn:flowNodeRef>Gateway_ForwardForValidation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ValidateInvoiceComplex</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Payment" name="Payment Office">
        <bpmn:flowNodeRef>IntermediateTimerWeeklyBeginning</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExecutePaymentComplex</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Registry" name="Registry Office">
        <bpmn:flowNodeRef>Task_ArchiveInvoices</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Completed</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Invoice Received from Client">
      <bpmn:outgoing>SequenceFlow_StartToCategorize</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Categorize Invoice -->
    <bpmn:userTask id="Task_CategorizeInvoice" name="Categorize invoice by staff member">
      <bpmn:incoming>SequenceFlow_StartToCategorize</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToAdministration</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Process Invoice (Complex) -->
    <bpmn:task id="Task_ProcessInvoiceComplex" name="Process invoice">
      <bpmn:description>Complex process - detailed steps not shown</bpmn:description>
      <bpmn:incoming>SequenceFlow_ToAdministration</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PutInCollectionBox</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Put in Collection Box -->
    <bpmn:userTask id="Task_PutInCollectionBox" name="Put all invoices into collection box">
      <bpmn:incoming>SequenceFlow_PutInCollectionBox</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToDataEntryTimer</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Timer Event: Daily 10am -->
    <bpmn:startEvent id="IntermediateTimerDaily10am" name="Every workday at 10 am">
      <bpmn:timerEventDefinition xsi:type="bpmn:TimeDateExpression"/>
      <bpmn:outgoing>SequenceFlow_DailyToSAPEntry</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Enter SAP System (Complex) -->
    <bpmn:task id="Task_EnterSAPSystemComplex" name="Enter all data in SAP system">
      <bpmn:description>Complex process - detailed steps not shown</bpmn:description>
      <bpmn:incoming>SequenceFlow_DailyToSAPEntry</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SAPEnterReviewTimer</bpmn:outgoing>
    </bpmn:task>

    <!-- Timer Event: Hourly Review -->
    <bpmn:startEvent id="IntermediateTimerHourlyReview" name="Every hour">
      <bpmn:timerEventDefinition xsi:type="bpmn:TimeDateExpression"/>
      <bpmn:outgoing>SequenceFlow_HourlyToGateway</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Gateway: Forward for Validation -->
    <bpmn:exclusiveGateway id="Gateway_ForwardForValidation" name="New invoices available?">
      <bpmn:incoming>SequenceFlow_HourlyToGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ValidInvoices</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Validate Invoice (Complex) -->
    <bpmn:userTask id="Task_ValidateInvoiceComplex" name="Execute validation process">
      <bpmn:description>Big complex process - detailed steps not shown</bpmn:description>
      <bpmn:incoming>SequenceFlow_ValidInvoices</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ValidationToPaymentTimer</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Timer Event: Weekly Beginning -->
    <bpmn:startEvent id="IntermediateTimerWeeklyBeginning" name="Every week beginning">
      <bpmn:timerEventDefinition xsi:type="bpmn:TimeDateExpression"/>
      <bpmn:outgoing>SequenceFlow_WeeklyToPayment</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Execute Payment (Complex) -->
    <bpmn:userTask id="Task_ExecutePaymentComplex" name="Execute payment of validated invoices">
      <bpmn:description>Big complex process - detailed steps not shown</bpmn:description>
      <bpmn:incoming>SequenceFlow_WeeklyToPayment</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PaymentToArchive</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Archive Invoices -->
    <bpmn:userTask id="Task_ArchiveInvoices" name="Archive all invoices">
      <bpmn:incoming>SequenceFlow_PaymentToArchive</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ArchiveToEndEvent</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Completed" name="Process Completed">
      <bpmn:incoming>SequenceFlow_ArchiveToEndEvent</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToCategorize" sourceRef="StartEvent_1" targetRef="Task_CategorizeInvoice">
      <bpmn:description>Client sends invoice to Mail Centre</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ToAdministration" name="Forward to Administration Department" sourceRef="Task_CategorizeInvoice" targetRef="Task_ProcessInvoiceComplex">
      <bpmn:description>Categorized invoice forwarded for processing</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_PutInCollectionBox" sourceRef="Task_ProcessInvoiceComplex" targetRef="Task_PutInCollectionBox">
      <bpmn:description>Processed invoices ready for collection</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ToDataEntryTimer" sourceRef="Task_PutInCollectionBox" targetRef="IntermediateTimerDaily10am">
      <bpmn:description>Invoices collected for data entry</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_DailyToSAPEntry" sourceRef="IntermediateTimerDaily10am" targetRef="Task_EnterSAPSystemComplex">
      <bpmn:description>Daily 10 am trigger for SAP data entry</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_SAPEnterReviewTimer" sourceRef="Task_EnterSAPSystemComplex" targetRef="IntermediateTimerHourlyReview">
      <bpmn:description>SAP entry complete, hourly review trigger</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_HourlyToGateway" sourceRef="IntermediateTimerHourlyReview" targetRef="Gateway_ForwardForValidation">
      <bpmn:description>Every hour review for new invoices</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ValidInvoices" sourceRef="Gateway_ForwardForValidation" targetRef="Task_ValidateInvoiceComplex">
      <bpmn:description>New invoices available, forward for validation</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ValidationToPaymentTimer" sourceRef="Task_ValidateInvoiceComplex" targetRef="IntermediateTimerWeeklyBeginning">
      <bpmn:description>Validated invoices ready for payment</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_WeeklyToPayment" sourceRef="IntermediateTimerWeeklyBeginning" targetRef="Task_ExecutePaymentComplex">
      <bpmn:description>Weekly beginning trigger for payments</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_PaymentToArchive" sourceRef="Task_ExecutePaymentComplex" targetRef="Task_ArchiveInvoices">
      <bpmn:description>Paid invoices ready for archiving</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ArchiveToEndEvent" sourceRef="Task_ArchiveInvoices" targetRef="EndEvent_Completed">
      <bpmn:description>All invoices archived, process complete</bpmn:description>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>