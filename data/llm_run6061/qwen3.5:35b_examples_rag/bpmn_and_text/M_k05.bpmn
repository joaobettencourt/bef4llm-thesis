<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_BuildHouse_01" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_HouseBuilding">
    <bpmn:participant id="Participant_Main" name="Tree House Building Process" processRef="Process_TreeHouse"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_TreeHouse" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Homeowner" name="Homeowner">
        <bpmn:flowNodeRef>StartEvent_CollectRequirements</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendRequirementsToArchitect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_RefinePlan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_DraftApproved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateMaterialsList</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_OrderMaterials</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_InviteBuilders</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendPartyInvitations</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CreateGuestListForSnacks</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_CollectRequirements" name="Collect Requirements">
      <bpmn:outgoing>SF_StartToArchitect</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Tasks -->
    <bpmn:task id="Task_SendRequirementsToArchitect" name="Send requirements to architect">
      <bpmn:incoming>SF_StartToArchitect</bpmn:incoming>
      <bpmn:outgoing>SF_ArchitectDraftReceived</bpmn:outgoing>
    </bpmn:task>

    <!-- Receive Task for Architect Draft -->
    <bpmn:receiveTask id="ReceiveTask_DraftFromArchitect" name="Receive draft from architect">
      <bpmn:incoming>SF_ArchitectDraftReceived</bpmn:incoming>
      <bpmn:outgoing>SF_RefinePlanDecision</bpmn:outgoing>
    </bpmn:receiveTask>

    <!-- Refinement Task -->
    <bpmn:task id="Task_RefineWithAdditionalRequirements" name="Refine plan with additional requirements">
      <bpmn:incoming>SF_ContinueRefining</bpmn:incoming>
      <bpmn:outgoing>SF_SendBackToArchitect</bpmn:outgoing>
    </bpmn:task>

    <!-- Materials List Task -->
    <bpmn:task id="Task_CreateMaterialsList" name="Create list of needed materials">
      <bpmn:incoming>SF_DraftApproved</bpmn:incoming>
      <bpmn:outgoing>SF_OrderMaterialsStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Material Ordering Tasks (Parallel) -->
    <bpmn:serviceTask id="ServiceTask_OrderCategory1" name="Order materials - Category 1">
      <bpmn:incoming>SF_MaterialsToOrder</bpmn:incoming>
      <bpmn:outgoing>SF_Category1Ordered</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="ServiceTask_OrderCategory2" name="Order materials - Category 2">
      <bpmn:incoming>SF_MaterialsToOrder</bpmn:incoming>
      <bpmn:outgoing>SF_Category2Ordered</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="ServiceTask_OrderCategory3" name="Order materials - Category 3">
      <bpmn:incoming>SF_MaterialsToOrder</bpmn:incoming>
      <bpmn:outgoing>SF_Category3Ordered</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Builder Invitation Tasks (Parallel) -->
    <bpmn:sendTask id="SendTask_InviteFriend1" name="Message friend 1 to build">
      <bpmn:incoming>SF_SendBuilderInvites</bpmn:incoming>
      <bpmn:outgoing>SF_Friend1Notified</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:sendTask id="SendTask_InviteFriend2" name="Message friend 2 to build">
      <bpmn:incoming>SF_SendBuilderInvites</bpmn:incoming>
      <bpmn:outgoing>SF_Friend2Notified</bpmn:outgoing>
    </bpmn:sendTask>

    <!-- Party Invitation Task -->
    <bpmn:task id="Task_SendPartyInvitations" name="Send invitations for tree house party">
      <bpmn:incoming>SF_HouseBuilt</bpmn:incoming>
      <bpmn:outgoing>SF_InviteSentToSnacks</bpmn:outgoing>
    </bpmn:task>

    <!-- Guest List Task -->
    <bpmn:task id="Task_CreateGuestListForSnacks" name="Create list of people attending party">
      <bpmn:incoming>SF_InviteSentToSnacks</bpmn:incoming>
      <bpmn:outgoing>SF_GuestListReady</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateways -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_DraftApproved" name="Draft approved?">
      <bpmn:incoming>SF_RefinePlanDecision</bpmn:incoming>
      <bpmn:outgoing>SF_ContinueRefining</bpmn:outgoing>
      <bpmn:outgoing>SF_DraftApproved</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:parallelGateway id="ParallelGateway_OrderMaterials" name="">
      <bpmn:incoming>SF_OrderMaterialsStart</bpmn:incoming>
      <bpmn:outgoing>SF_MaterialsToOrder1</bpmn:outgoing>
      <bpmn:outgoing>SF_MaterialsToOrder2</bpmn:outgoing>
      <bpmn:outgoing>SF_MaterialsToOrder3</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Convergence of material orders -->
    <bpmn:parallelGateway id="ParallelGateway_ConvergeOrders" gatewayDirection="Converging">
      <bpmn:incoming>SF_Category1Ordered</bpmn:incoming>
      <bpmn:incoming>SF_Category2Ordered</bpmn:incoming>
      <bpmn:incoming>SF_Category3Ordered</bpmn:incoming>
      <bpmn:outgoing>SF_StartBuilderInvites</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Inclusive Gateway for Builder Invitations -->
    <bpmn:inclusiveGateway id="InclusiveGateway_InviteBuilders" name="">
      <bpmn:incoming>SF_StartBuilderInvites</bpmn:incoming>
      <bpmn:outgoing>SF_SendBuilderInvites1</bpmn:outgoing>
      <bpmn:outgoing>SF_SendBuilderInvites2</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Parallel Gateway for Builder Notifications -->
    <bpmn:parallelGateway id="ParallelGateway_BuilderNotifications" name="">
      <bpmn:incoming>SF_Friend1Notified</bpmn:incoming>
      <bpmn:incoming>SF_Friend2Notified</bpmn:incoming>
      <bpmn:outgoing>SF_AllBuildersInvited</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_PartyPrepared" name="Party prepared">
      <bpmn:incoming>SF_GuestListReady</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SF_StartToArchitect" sourceRef="StartEvent_CollectRequirements" targetRef="Task_SendRequirementsToArchitect"/>
    
    <bpmn:sequenceFlow id="SF_ArchitectDraftReceived" name="Receive draft from architect" sourceRef="Task_SendRequirementsToArchitect" targetRef="ReceiveTask_DraftFromArchitect"/>

    <bpmn:sequenceFlow id="SF_RefinePlanDecision" sourceRef="ReceiveTask_DraftFromArchitect" targetRef="ExclusiveGateway_DraftApproved"/>
    
    <bpmn:sequenceFlow id="SF_ContinueRefining" name="Not approved - refine more" sourceRef="ExclusiveGateway_DraftApproved" targetRef="Task_RefineWithAdditionalRequirements"/>

    <bpmn:sequenceFlow id="SF_SendBackToArchitect" name="Send refined plan" sourceRef="Task_RefineWithAdditionalRequirements" targetRef="ReceiveTask_DraftFromArchitect"/>
    
    <bpmn:sequenceFlow id="SF_DraftApproved" name="Draft approved" sourceRef="ExclusiveGateway_DraftApproved" targetRef="Task_CreateMaterialsList"/>

    <bpmn:sequenceFlow id="SF_OrderMaterialsStart" sourceRef="Task_CreateMaterialsList" targetRef="ParallelGateway_OrderMaterials"/>
    
    <bpmn:sequenceFlow id="SF_MaterialsToOrder1" name="" sourceRef="ParallelGateway_OrderMaterials" targetRef="ServiceTask_OrderCategory1"/>
    
    <bpmn:sequenceFlow id="SF_MaterialsToOrder2" name="" sourceRef="ParallelGateway_OrderMaterials" targetRef="ServiceTask_OrderCategory2"/>
    
    <bpmn:sequenceFlow id="SF_MaterialsToOrder3" name="" sourceRef="ParallelGateway_OrderMaterials" targetRef="ServiceTask_OrderCategory3"/>

    <!-- Convergence of material orders -->
    <bpmn:parallelGateway id="ParallelGateway_ConvergeOrders" gatewayDirection="Converging">
      <bpmn:incoming>SF_Category1Ordered</bpmn:incoming>
      <bpmn:incoming>SF_Category2Ordered</bpmn:incoming>
      <bpmn:incoming>SF_Category3Ordered</bpmn:incoming>
      <bpmn:outgoing>SF_StartBuilderInvites</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Fix the gateway reference -->
    
  </process>