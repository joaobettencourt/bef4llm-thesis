<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_LuxuryAirplane_01" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_Airplane_Manufacturing">
    <bpmn:participant id="Participant_Pool" name="Luxury Airplane Manufacturing Process" processRef="Process_LuxuryAirplane"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_LuxuryAirplane" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Customer_Specification" name="Customer Specification Team">
        <bpmn:flowNodeRef>StartEvent_ReceiveOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CollectSpecifications</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Manufacturing_Teams" name="Manufacturing Teams">
        <bpmn:flowNodeRef>ParallelGateway_SplitRequirements</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RussianTeam_VodkaBar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IrishTeam_WhiskeyBar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SeatsManufacturing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ColorApplication</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_JoinParts</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Assembly_Testing" name="Assembly &amp; Testing">
        <bpmn:flowNodeRef>Task_InteriorAssembly</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TestFlight</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CreateTestProtocol</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_ReceiveOrder" name="Customer Order Received">
      <bpmn:outgoing>SF_StartToSpecs</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Customer Specification Tasks -->
    <bpmn:task id="Task_CollectSpecifications" name="Collect Airplane Specifications">
      <bpmn:incoming>SF_StartToSpecs</bpmn:incoming>
      <bpmn:outgoing>SF_SendRequirements</bpmn:outgoing>
    </bpmn:task>

    <!-- Manufacturing Teams Tasks -->
    <bpmn:parallelGateway id="ParallelGateway_SplitRequirements" name="Split Requirements">
      <bpmn:incoming>SF_SendRequirements</bpmn:incoming>
      <bpmn:outgoing>SF_RussianTeam_VodkaBar</bpmn:outgoing>
      <bpmn:outgoing>SF_IrishTeam_WhiskeyBar</bpmn:outgoing>
      <bpmn:outgoing>SF_SeatsManufacturing</bpmn:outgoing>
      <bpmn:outgoing>SF_ColorApplication</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:task id="Task_RussianTeam_VodkaBar" name="Russian Team - Manufacture Vodka Bar">
      <bpmn:incoming>SF_RussianTeam_VodkaBar</bpmn:incoming>
      <bpmn:outgoing>SF_PartReady1</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_IrishTeam_WhiskeyBar" name="Irish Team - Manufacture Whiskey Bar">
      <bpmn:incoming>SF_IrishTeam_WhiskeyBar</bpmn:incoming>
      <bpmn:outgoing>SF_PartReady2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_SeatsManufacturing" name="Seats Manufacturing Team - Manufacture Seats">
      <bpmn:incoming>SF_SeatsManufacturing</bpmn:incoming>
      <bpmn:outgoing>SF_PartReady3</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_ColorApplication" name="Color Team - Apply Custom Color">
      <bpmn:incoming>SF_ColorApplication</bpmn:incoming>
      <bpmn:outgoing>SF_PartReady4</bpmn:outgoing>
    </bpmn:task>

    <!-- Join Parts -->
    <bpmn:parallelGateway id="ParallelGateway_JoinParts" name="Join All Parts">
      <bpmn:incoming>SF_PartReady1</bpmn:incoming>
      <bpmn:incoming>SF_PartReady2</bpmn:incoming>
      <bpmn:incoming>SF_PartReady3</bpmn:incoming>
      <bpmn:incoming>SF_PartReady4</bpmn:incoming>
      <bpmn:outgoing>SF_ToInteriorAssembly</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Assembly & Testing Tasks -->
    <bpmn:task id="Task_InteriorAssembly" name="Assemble Interior">
      <bpmn:incoming>SF_ToInteriorAssembly</bpmn:incoming>
      <bpmn:outgoing>SF_StartTestFlight</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_TestFlight" name="Conduct Test Flight">
      <bpmn:incoming>SF_StartTestFlight</bpmn:incoming>
      <bpmn:outgoing>SF_CreateProtocol</bpmn:outgoing>
    </bpmn:task>

    <!-- Create Protocol -->
    <bpmn:task id="CreateTestProtocol" name="Create Test Protocol">
      <bpmn:incoming>SF_CreateProtocol</bpmn:incoming>
      <bpmn:outgoing>SF_SendToCustomerAndCompany</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_CustomerConfirmation" name="Customer Confirmation Received">
      <bpmn:incoming>SF_FinalDelivery</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SF_StartToSpecs" sourceRef="StartEvent_ReceiveOrder" targetRef="Task_CollectSpecifications"/>
    
    <bpmn:sequenceFlow id="SF_SendRequirements" name="Send Requirements to Teams" sourceRef="Task_CollectSpecifications" targetRef="ParallelGateway_SplitRequirements"/>

    <!-- Manufacturing Team Flows -->
    <bpmn:sequenceFlow id="SF_RussianTeam_VodkaBar" sourceRef="ParallelGateway_SplitRequirements" targetRef="Task_RussianTeam_VodkaBar"/>
    
    <bpmn:sequenceFlow id="SF_IrishTeam_WhiskeyBar" sourceRef="ParallelGateway_SplitRequirements" targetRef="Task_IrishTeam_WhiskeyBar"/>

    <bpmn:sequenceFlow id="SF_SeatsManufacturing" name="Seats Manufacturing" sourceRef="ParallelGateway_SplitRequirements" targetRef="Task_SeatsManufacturing"/>
    
    <bpmn:sequenceFlow id="SF_ColorApplication" name="Color Application" sourceRef="ParallelGateway_SplitRequirements" targetRef="Task_ColorApplication"/>

    <!-- Part Ready Flows -->
    <bpmn:sequenceFlow id="SF_PartReady1" sourceRef="Task_RussianTeam_VodkaBar" targetRef="ParallelGateway_JoinParts"/>
    
    <bpmn:sequenceFlow id="SF_PartReady2" sourceRef="Task_IrishTeam_WhiskeyBar" targetRef="ParallelGateway_JoinParts"/>

    <bpmn:sequenceFlow id="SF_PartReady3" name="Seats Ready" sourceRef="Task_SeatsManufacturing" targetRef="ParallelGateway_JoinParts"/>
    
    <bpmn:sequenceFlow id="SF_PartReady4" name="Color Applied" sourceRef="Task_ColorApplication" targetRef="ParallelGateway_JoinParts"/>

    <!-- Assembly & Testing Flows -->
    <bpmn:sequenceFlow id="SF_ToInteriorAssembly" name="All Parts Ready - Assemble Interior" sourceRef="ParallelGateway_JoinParts" targetRef="Task_InteriorAssembly"/>
    
    <bpmn:sequenceFlow id="SF_StartTestFlight" sourceRef="Task_InteriorAssembly" targetRef="Task_TestFlight"/>

    <!-- Protocol & Delivery Flows -->
    <bpmn:sequenceFlow id="SF_CreateProtocol" name="Create Test Protocol During Flight" sourceRef="Task_TestFlight" targetRef="CreateTestProtocol"/>
    
    <bpmn:sequenceFlow id="SF_SendToCustomerAndCompany" name="Send Protocol to Customer &amp; Company" sourceRef="CreateTestProtocol" targetRef="EndEvent_CustomerConfirmation">
      <!-- Note: In real BPMN, this would involve message flows between participants -->
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>