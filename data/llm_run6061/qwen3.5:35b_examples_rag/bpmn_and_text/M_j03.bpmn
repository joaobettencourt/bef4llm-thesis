<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Contract_01" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_Contract_01">
    <bpmn:participant id="Participant_Pool" name="Contract Parts Procurement Process" processRef="Process_Main"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Main" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Purchasing" name="Purchasing Department">
        <bpmn:flowNodeRef>StartEvent_Contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IdentifyParts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_QueryShops</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_WebShopQuery1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_WebShopQuery2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_WebShopQuery3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_ComparePrices</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateOrderList</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_CheckSingleShop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_OrderCheapest1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_OrderMultipleShops</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Manufacturing" name="Manufacturing">
        <bpmn:flowNodeRef>InclusiveGateway_PartsArrive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_StartBuilding</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_MonitorStock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_ReorderCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_OrderCheapest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_OrderFastest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_SendComplaintEmail</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Contract" name="Contract Project&#10;Started">
      <bpmn:outgoing>SF_StartToIdentify</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Tasks - Purchasing Lane -->
    <bpmn:task id="Task_IdentifyParts" name="Create List of&#10;Required Parts">
      <bpmn:incoming>SF_StartToIdentify</bpmn:incoming>
      <bpmn:outgoing>SF_ToQueryShops</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway - Query Shops (Parallel) -->
    <bpmn:parallelGateway id="InclusiveGateway_QueryShops" name="">
       <bpmn:incoming>SF_ToQueryShops</bpmn:incoming>
       <bpmn:outgoing>SF_WebShop1</bpmn:outgoing>
       <bpmn:outgoing>SF_WebShop2</bpmn:outgoing>
       <bpmn:outgoing>SF_WebShop3</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Service Tasks - Query Web Shops -->
    <bpmn:serviceTask id="ServiceTask_WebShopQuery1" name="Query Shop 1&#10;(Parts, Price,&#10;Delivery)">
      <bpmn:incoming>SF_WebShop1</bpmn:incoming>
      <bpmn:outgoing>SF_ShopResponse1</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="ServiceTask_WebShopQuery2" name="Query Shop 2&#10;(Parts, Price,&#10;Delivery)">
      <bpmn:incoming>SF_WebShop2</bpmn:incoming>
      <bpmn:outgoing>SF_ShopResponse2</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="ServiceTask_WebShopQuery3" name="Query Shop 3&#10;(Parts, Price,&#10;Delivery)">
      <bpmn:incoming>SF_WebShop3</bpmn:incoming>
      <bpmn:outgoing>SF_ShopResponse3</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Gateway - Compare Prices -->
    <bpmn:parallelGateway id="InclusiveGateway_ComparePrices" name="">
       <bpmn:incoming>SF_ShopResponse1</bpmn:incoming>
       <bpmn:incoming>SF_ShopResponse2</bpmn:incoming>
       <bpmn:incoming>SF_ShopResponse3</bpmn:incoming>
       <bpmn:outgoing>SF_CreateOrderList</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task - Create Order List -->
    <bpmn:task id="Task_CreateOrderList" name="Create Parts&#10;Order List">
      <bpmn:incoming>SF_CreateOrderList</bpmn:incoming>
      <bpmn:outgoing>SF_CheckSingleShop</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway - Check if Single Shop Sufficient -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_CheckSingleShop" name="One shop has&#10;enough parts?">
      <bpmn:incoming>SF_CheckSingleShop</bpmn:incoming>
      <bpmn:outgoing>SF_OrderCheapest</bpmn:outgoing>
      <bpmn:outgoing>SF_OrderMultipleShops</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Tasks - Order Parts -->
    <bpmn:serviceTask id="ServiceTask_OrderCheapest1" name="Order from&#10;cheapest shop">
      <bpmn:incoming>SF_OrderCheapest</bpmn:incoming>
      <bpmn:outgoing>SF_PartsOrdered</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="ServiceTask_OrderMultipleShops" name="Order from&#10;several shops">
      <bpmn:incoming>SF_OrderMultipleShops</bpmn:incoming>
      <bpmn:outgoing>SF_PartsOrdered</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Gateway - Parts Arrive (Intermediate Catch Event) -->
    <bpmn:parallelGateway id="InclusiveGateway_PartsArrive" name="">
       <bpmn:incoming>SF_PartsOrdered</bpmn:incoming>
       <bpmn:outgoing>SF_StartBuildingFlow</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task - Start Building -->
    <bpmn:startEvent id="StartEvent_Building" name="First Parts&#10;Arrived">
      <bpmn:incoming>SF_PartsOrdered</bpmn:incoming>
      <bpmn:outgoing>SF_StartBuildingFlow2</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task - Start Building -->
    <bpmn:task id="Task_StartBuilding" name="Start Building">
      <bpmn:incoming>SF_StartBuildingFlow2</bpmn:incoming>
      <bpmn:outgoing>SF_MonitorStock</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway - Monitor Stock Level -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_StockCheck5" name="Stock &lt; 5?">
      <bpmn:incoming>SF_MonitorStock</bpmn:incoming>
      <bpmn:outgoing>SF_OrderCheapestFlow</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Gateway - Stock Below 3 -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_Below3" name="Stock &lt; 3?">
      <bpmn:incoming>SF_MonitorStock</bpmn:incoming>
      <bpmn:outgoing>SF_OrderFastestFlow</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Gateway - Stock Zero -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_Zero" name="Stock = 0?">
      <bpmn:incoming>SF_MonitorStock</bpmn:incoming>
      <bpmn:outgoing>SF_SendComplaintEmailFlow</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Gateway - Reorder Decision -->
    <bpmn:inclusiveGateway id="InclusiveGateway_ReorderDecision" name="">
       <bpmn:incoming>SF_OrderCheapestFlow</bpmn:incoming>
       <bpmn:outgoing>SF_StockCheckAgain</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Task - Reorder Cheapest -->
    <bpmn:serviceTask id="ServiceTask_OrderCheapest" name="Reorder (cheapest)">
      <bpmn:incoming>SF_OrderCheapestFlow</bpmn:incoming>
      <bpmn:outgoing>SF_StockCheckAgain2</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Task - Reorder Fastest -->
    <bpmn:serviceTask id="ServiceTask_OrderFastest" name="Reorder (fastest)">
      <bpmn:incoming>SF_OrderFastestFlow</bpmn:incoming>
      <bpmn:outgoing>SF_StockCheckAgain2</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Task - Send Complaint Email -->
    <bpmn:userTask id="UserTask_SendComplaintEmail" name="Write mail to&#10;friends (complain)">
      <bpmn:incoming>SF_SendComplaintEmailFlow</bpmn:incoming>
      <bpmn:outgoing>SF_StockCheckAgain2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SF_StartToIdentify" sourceRef="StartEvent_Contract" targetRef="Task_IdentifyParts"/>
    
    <bpmn:sequenceFlow id="SF_ToQueryShops" name="" sourceRef="Task_IdentifyParts" targetRef="InclusiveGateway_QueryShops"/>

    <bpmn:sequenceFlow id="SF_WebShop1" sourceRef="InclusiveGateway_QueryShops" targetRef="ServiceTask_WebShopQuery1"/>
    <bpmn:sequenceFlow id="SF_WebShop2" sourceRef="InclusiveGateway_QueryShops" targetRef="ServiceTask_WebShopQuery2"/>
    <bpmn:sequenceFlow id="SF_WebShop3" sourceRef="InclusiveGateway_QueryShops" targetRef="ServiceTask_WebShopQuery3"/>

    <bpmn:sequenceFlow id="SF_ShopResponse1" name="" sourceRef="ServiceTask_WebShopQuery1" targetRef="InclusiveGateway_ComparePrices"/>
    <bpmn:sequenceFlow id="SF_ShopResponse2" name="" sourceRef="ServiceTask_WebShopQuery2" targetRef="InclusiveGateway_ComparePrices"/>
    <bpmn:sequenceFlow id="SF_ShopResponse3" name="" sourceRef="ServiceTask_WebShopQuery3" targetRef="InclusiveGateway_ComparePrices"/>

    <bpmn:sequenceFlow id="SF_CreateOrderList" name="" sourceRef="InclusiveGateway_ComparePrices" targetRef="Task_CreateOrderList"/>
    
    <bpmn:sequenceFlow id="SF_CheckSingleShop" name="" sourceRef="Task_CreateOrderList" targetRef="ExclusiveGateway_CheckSingleShop"/>

    <bpmn:sequenceFlow id="SF_OrderCheapest" name="One shop OK" sourceRef="ExclusiveGateway_CheckSingleShop" targetRef="ServiceTask_OrderCheapest1"/>
    <bpmn:sequenceFlow id="SF_OrderMultipleShops" name="Need several shops" sourceRef="ExclusiveGateway_CheckSingleShop" targetRef="ServiceTask_OrderMultipleShops"/>

    <bpmn:sequenceFlow id="SF_PartsOrdered" name="" sourceRef="ServiceTask_OrderCheapest1" targetRef="InclusiveGateway_PartsArrive"/>
    <bpmn:sequenceFlow id="SF_StartBuildingFlow2" name="" sourceRef="StartEvent_Building" targetRef="Task_StartBuilding"/>

    <!-- Stock Monitoring Loop -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_MonitorStock" name="">
      <bpmn:incoming>SF_MonitorStock</bpmn:incoming>
      <bpmn:outgoing>SF_StockCheck5Flow</bpmn:outgoing>
      <bpmn:outgoing>SF_Below3ReorderFastest</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Reordering Logic -->
    <bpmn:sequenceFlow id="SF_StockCheck5Flow" name="" sourceRef="ExclusiveGateway_MonitorStock" targetRef="ExclusiveGateway_StockCheck5"/>
    
    <!-- Stock Below 3 - Reorder Fastest -->
    <bpmn:sequenceFlow id="SF_Below3ReorderFastest" name="" sourceRef="ExclusiveGateway_MonitorStock" targetRef="ExclusiveGateway_Below3"/>

    <!-- Complaint Email Flow -->
    <bpmn:sequenceFlow id="SF_SendComplaintEmailFlow" name="" sourceRef="ExclusiveGateway_Zero" targetRef="UserTask_SendComplaintEmail"/>

    <!-- Reorder Cheapest Flow -->
    <bpmn:sequenceFlow id="SF_OrderCheapestFlow" name="" sourceRef="ExclusiveGateway_StockCheck5" targetRef="ServiceTask_OrderCheapest"/>
    
    <!-- Reorder Fastest Flow -->
    <bpmn:sequenceFlow id="SF_OrderFastestFlow" name="" sourceRef="ExclusiveGateway_Below3" targetRef="ServiceTask_OrderFastest"/>

    <!-- Stock Check Again Loop Back -->
    <bpmn:sequenceFlow id="SF_StockCheckAgain2" name="" sourceRef="ServiceTask_OrderCheapest" targetRef="InclusiveGateway_ReorderDecision"/>
    
  </process>
</bpmn:definitions>