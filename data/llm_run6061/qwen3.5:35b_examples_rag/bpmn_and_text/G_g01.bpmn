<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_LANParty_01" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_LANParty">
    <bpmn:participant id="Pool_Organizer" name="LAN Party Organizer" processRef="Process_Main"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Main" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="Start_1" name="Plan LAN Party">
      <bpmn:outgoing>SF_SendInvites</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Send Invitations Task -->
    <bpmn:task id="Task_SendInvites" name="Send invitations to 10 friends">
      <bpmn:incoming>SF_SendInvites</bpmn:incoming>
      <bpmn:outgoing>SF_CollectGames</bpmn:outgoing>
    </bpmn:task>

    <!-- Collect Games Task -->
    <bpmn:task id="Task_CollectGames" name="Find out which games they want to play">
      <bpmn:incoming>SF_CollectGames</bpmn:incoming>
      <bpmn:outgoing>SF_ParallelStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway Start -->
    <bpmn:parallelGateway id="GW_StartParallel">
      <bpmn:incoming>SF_ParallelStart</bpmn:incoming>
      <bpmn:outgoing>SF_AppointDate</bpmn:outgoing>
      <bpmn:outgoing>SF_CheckGames</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Date Appointment Task -->
    <bpmn:task id="Task_AppointDate" name="Appoint a date">
      <bpmn:incoming>SF_AppointDate</bpmn:incoming>
      <bpmn:outgoing>SF_CheckAgreement</bpmn:outgoing>
    </bpmn:task>

    <!-- Date Agreement Check Gateway -->
    <bpmn:exclusiveGateway id="GW_AgreeCheck" name="8+ agree?">
      <bpmn:incoming>SF_CheckAgreement</bpmn:incoming>
      <bpmn:outgoing>SF_GoToBeer_Yes</bpmn:outgoing>
      <bpmn:outgoing>SF_AppointDate_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Check Games Task -->
    <bpmn:task id="Task_CheckGames" name="Check if all games are available">
      <bpmn:incoming>SF_CheckGames</bpmn:incoming>
      <bpmn:outgoing>SF_GW_MissingCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Missing Games Check Gateway -->
    <bpmn:exclusiveGateway id="GW_MissingCheck" name="Any missing?">
      <bpmn:incoming>SF_GW_MissingCheck</bpmn:incoming>
      <bpmn:outgoing>SF_Converge_Yes</bpmn:outgoing>
      <bpmn:outgoing>SF_DownloadGames_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Download Games Task -->
    <bpmn:task id="Task_DownloadGames" name="Download missing games">
      <bpmn:incoming>SF_DownloadGames_No</bpmn:incoming>
      <bpmn:outgoing>SF_Converge_Yes2</bpmn:outgoing>
    </bpmn:task>

    <!-- Convergence Gateway -->
    <bpmn:parallelGateway id="GW_Converge">
      <bpmn:incoming>SF_GoToBeer_Yes</bpmn:incoming>
      <bpmn:incoming>SF_Converge_Yes2</bpmn:incoming>
    </bpmn:parallelGateway>

    <!-- Buy Beer Task -->
    <bpmn:task id="Task_BuyBeer" name="Buy beer if missing">
      <bpmn:incoming>SF_GoToBeer_Yes</bpmn:incoming>
      <bpmn:outgoing>SF_EndParty</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="End_Party" name="Enjoy LAN Party">
      <bpmn:incoming>SF_EndParty</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows - Date Path Loop Back -->
    <bpmn:sequenceFlow id="SF_SendInvites" sourceRef="Start_1" targetRef="Task_SendInvites"/>
    <bpmn:sequenceFlow id="SF_CollectGames" sourceRef="Task_SendInvites" targetRef="Task_CollectGames"/>
    <bpmn:sequenceFlow id="SF_ParallelStart" sourceRef="Task_CollectGames" targetRef="GW_StartParallel"/>

    <!-- Date Path Flows -->
    <bpmn:sequenceFlow id="SF_AppointDate" name="" sourceRef="GW_StartParallel" targetRef="Task_AppointDate"/>
    <bpmn:sequenceFlow id="SF_CheckAgreement" sourceRef="Task_AppointDate" targetRef="GW_AgreeCheck"/>
    <bpmn:sequenceFlow id="SF_GoToBeer_Yes" name="yes (8+ agree)" sourceRef="GW_AgreeCheck" targetRef="GW_Converge"/>
    <bpmn:sequenceFlow id="SF_AppointDate_No" name="no (< 8 agree)" sourceRef="GW_AgreeCheck" targetRef="Task_AppointDate"/>

    <!-- Game Path Flows -->
    <bpmn:sequenceFlow id="SF_CheckGames" name="" sourceRef="GW_StartParallel" targetRef="Task_CheckGames"/>
    <bpmn:sequenceFlow id="SF_GW_MissingCheck" sourceRef="Task_CheckGames" targetRef="GW_MissingCheck"/>
    <bpmn:sequenceFlow id="SF_Converge_Yes" name="" sourceRef="GW_MissingCheck" targetRef="GW_Converge"/>
    <bpmn:sequenceFlow id="SF_DownloadGames_No" name="yes (missing)" sourceRef="GW_MissingCheck" targetRef="Task_DownloadGames"/>

    <!-- Convergence to Beer -->
    <bpmn:sequenceFlow id="SF_GoToBeer_Yes2" name="" sourceRef="GW_Converge" targetRef="Task_BuyBeer">
      <bpmn:name>Proceed</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>