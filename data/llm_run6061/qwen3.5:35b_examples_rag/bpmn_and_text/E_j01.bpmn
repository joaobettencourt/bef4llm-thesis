<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_FindJob_01" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_FindJob_01">
    <bpmn:participant id="Participant_JobProcess" name="Find a Job Process" processRef="Process_Main"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Main" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Applicant" name="Job Applicant">
        <bpmn:flowNodeRef>StartEvent_01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReportApplications</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_InterviewNegotiation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProbationPhase</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RateCompany</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ContinueOrEnd</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Company" name="Employing Company">
        <bpmn:flowNodeRef>Task_ConfirmReceipt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RateApplication</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_HireDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NegotiateInterview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ProvisionalOffer</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_01" name="Regular Reporting">
      <bpmn:outgoing>SF_ReportApplications</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Applicant Tasks -->
    <bpmn:userTask id="Task_ReportApplications" name="Report Job Applications">
      <bpmn:incoming>SF_ContinueReporting</bpmn:incoming>
      <bpmn:outgoing>SF_SendToCompany</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Company Tasks -->
    <bpmn:userTask id="Task_ConfirmReceipt" name="Confirm Receipt">
      <bpmn:incoming>SF_SendToCompany</bpmn:incoming>
      <bpmn:outgoing>SF_RateApplicationFlow</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_RateApplication" name="Rate Application">
      <bpmn:incoming>SF_RateApplicationFlow</bpmn:incoming>
      <bpmn:outgoing>SF_HireDecisionGateway</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Interview Negotiation (Optional) -->
    <bpmn:userTask id="Task_NegotiateInterview" name="Negotiate Job Interview">
      <bpmn:incoming>SF_InterviewPath</bpmn:incoming>
      <bpmn:outgoing>SF_HireDecisionGateway</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateways -->
    <bpmn:exclusiveGateway id="Gateway_InterviewNegotiation" name="Interview&#10;Needed?">
      <bpmn:incoming>SF_HireDecisionFlow</bpmn:incoming>
      <bpmn:outgoing>SF_NegotiatePath</bpmn:outgoing>
      <bpmn:outgoing>SF_ProceedToHiring</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:exclusiveGateway id="Gateway_HireDecision" name="Wants to&#10;hire?">
      <bpmn:incoming>SF_RateApplicationFlow</bpmn:incoming>
      <bpmn:incoming>SF_InterviewPath</bpmn:incoming>
      <bpmn:outgoing>SF_ProvisionalOfferEnd</bpmn:outgoing>
      <bpmn:outgoing>SF_HireDecisionFlow</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Probation Phase -->
    <bpmn:userTask id="Task_ProbationPhase" name="Probation Period">
      <bpmn:incoming>SF_StartProbation</bpmn:incoming>
      <bpmn:outgoing>SF_RatingTime</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Rating Tasks -->
    <bpmn:userTask id="Task_CompanyRateApplicant" name="Company Rates Applicant">
      <bpmn:incoming>SF_StartRating</bpmn:incoming>
      <bpmn:outgoing>SF_ApplicantRatesFlow</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_RateCompany" name="Applicant Rates Company">
      <bpmn:incoming>SF_ApplicantRatesFlow</bpmn:incoming>
      <bpmn:outgoing>SF_ContinueOrEndGateway</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_ProvisionalOffer" name="No Hire">
      <bpmn:incoming>SF_NoHireFlow</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_PermanentPosition" name="Permanent&#10;Position">
      <bpmn:incoming>SF_EndProcess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Decision Gateway -->
    <bpmn:exclusiveGateway id="Gateway_ContinueOrEnd" name="Rating C or less?">
      <bpmn:incoming>SF_RatingCompleteFlow</bpmn:incoming>
      <bpmn:outgoing>SF_EndProcess</bpmn:outgoing>
      <bpmn:outgoing>SF_ContinueReporting</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SF_ReportApplications" sourceRef="StartEvent_01" targetRef="Task_ReportApplications"/>
    
    <bpmn:sequenceFlow id="SF_SendToCompany" name="Submit Application" sourceRef="Task_ReportApplications" targetRef="Task_ConfirmReceipt">
      <bpmn:documentation>Applicant submits applications to company</bpmn:documentation>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SF_RateApplicationFlow" name="Rate Application" sourceRef="Task_ConfirmReceipt" targetRef="Task_RateApplication"/>
    
    <bpmn:sequenceFlow id="SF_HireDecisionGateway" sourceRef="Task_RateApplication" targetRef="Gateway_HireDecision"/>

    <!-- Interview Path -->
    <bpmn:sequenceFlow id="SF_InterviewPath" name="Negotiate Interview" sourceRef="Gateway_InterviewNegotiation" targetRef="Task_NegotiateInterview">
      <bpmn:documentation>Optional interview negotiation</bpmn:documentation>
    </bpmn:sequenceFlow>

    <!-- Hiring Decision -->
    <bpmn:sequenceFlow id="SF_HireDecisionFlow" name="Wants to hire" sourceRef="Gateway_HireDecision" targetRef="Task_ProbationPhase">
      <bpmn:documentation>Hiring decision made</bpmn:documentation>
    </bpmn:sequenceFlow>

    <!-- No Hire Path -->
    <bpmn:sequenceFlow id="SF_NoHireFlow" name="No hire" sourceRef="Gateway_HireDecision" targetRef="EndEvent_ProvisionalOffer">
      <bpmn:documentation>No employment offer made</bpmn:documentation>
    </bpmn:sequenceFlow>

    <!-- Probation to Rating -->
    <bpmn:sequenceFlow id="SF_StartProbation" name="Start probation" sourceRef="Gateway_HireDecision" targetRef="Task_ProbationPhase"/>
    
    <bpmn:sequenceFlow id="SF_RatingTime" name="After probation period" sourceRef="Task_ProbationPhase" targetRef="Task_CompanyRateApplicant">
      <bpmn:documentation>Rating phase begins after probation</bpmn:documentation>
    </bpmn:sequenceFlow>

    <!-- Rating Flow -->
    <bpmn:sequenceFlow id="SF_StartRating" name="Start rating period" sourceRef="Task_ProbationPhase" targetRef="Task_CompanyRateApplicant"/>
    
    <bpmn:sequenceFlow id="SF_ApplicantRatesFlow" name="Both parties rate each other" sourceRef="Task_CompanyRateApplicant" targetRef="Task_RateCompany">
      <bpmn:documentation>Reciprocal rating after probation</bpmn:documentation>
    </bpmn:sequenceFlow>

    <!-- Continue or End Decision -->
    <bpmn:sequenceFlow id="SF_ContinueOrEndGateway" sourceRef="Task_RateCompany" targetRef="Gateway_ContinueOrEnd"/>
    
    <bpmn:sequenceFlow id="SF_EndProcess" name="Rating better than C" sourceRef="Gateway_ContinueOrEnd" targetRef="EndEvent_PermanentPosition">
      <bpmn:documentation>Permanent position achieved</bpmn:documentation>
    </bpmn:sequenceFlow>

    <!-- Continue Reporting Path -->
    <bpmn:sequenceFlow id="SF_ContinueReporting" name="Rating C or less, continue offers" sourceRef="Gateway_ContinueOrEnd" targetRef="Task_ReportApplications">
      <bpmn:documentation>No longer required to report but continues receiving offers</bpmn:documentation>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>