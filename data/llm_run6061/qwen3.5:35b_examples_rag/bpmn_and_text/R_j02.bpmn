<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_InspectionApp" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_InspectionProcess">
    <bpmn:participant id="Participant_AppUser" name="Machine Inspection Application" processRef="Process_Main"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Main" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Inspector" name="Inspector / User">
        <bpmn:flowNodeRef>StartEvent_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_EnterDetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_AnswerQuestions</bpmn:flowNodeRef>
      </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Start" name="Start Inspection">
      <bpmn:outgoing>SF_InitiateInspection</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Tasks -->
    <bpmn:userTask id="UserTask_EnterDetails" name="Enter Machine Details (Type &amp; Serial)">
      <bpmn:incoming>SF_InitiateInspection</bpmn:incoming>
      <bpmn:outgoing>SF_StartDataCollection</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Service Task for automated data collection -->
    <bpmn:serviceTask id="ServiceTask_CollectValues" name="Collect Values from Machine">
      <bpmn:description>Buttons pressed, values automatically collected and shown</bpmn:description>
      <bpmn:incoming>SF_StartDataCollection</bpmn:incoming>
      <bpmn:outgoing>SF_CheckResults</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- User Task for conditional questions -->
    <bpmn:userTask id="UserTask_AnswerQuestions" name="Ask Additional Questions">
      <bpmn:description>User inputs values based on inspection results</bpmn:description>
      <bpmn:incoming>SF_AskAdditionalQs</bpmn:incoming>
      <bpmn:outgoing>SF_EndInspectionFlow</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateways -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_CheckResults" name="Additional Questions&#10;Required?">
      <bpmn:incoming>SF_StartDataCollection</bpmn:incoming>
      <bpmn:outgoing>SF_AskAdditionalQs</bpmn:outgoing>
      <bpmn:outgoing>SF_EndInspectionFlow</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SF_InitiateInspection" sourceRef="StartEvent_Start" targetRef="UserTask_EnterDetails"/>
    
    <bpmn:sequenceFlow id="SF_StartDataCollection" name="Begin Inspection Data Collection" sourceRef="UserTask_EnterDetails" targetRef="ServiceTask_CollectValues"/>

    <bpmn:sequenceFlow id="SF_CheckResults" sourceRef="ServiceTask_CollectValues" targetRef="ExclusiveGateway_CheckResults"/>
    
    <bpmn:sequenceFlow id="SF_AskAdditionalQs" name="Yes - Additional Questions Required" sourceRef="ExclusiveGateway_CheckResults" targetRef="UserTask_AnswerQuestions"/>

    <bpmn:sequenceFlow id="SF_EndInspectionFlow" name="No - Inspection Complete" sourceRef="ExclusiveGateway_CheckResults" targetRef="EndEvent_Complete">
      <!-- This flow goes directly to end event -->
    </bpmn:sequenceFlow>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Complete" name="Inspection Completed"/>

  </process>
</bpmn:definitions>