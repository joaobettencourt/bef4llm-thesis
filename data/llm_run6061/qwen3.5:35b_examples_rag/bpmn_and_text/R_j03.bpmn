<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_FridgeService_01" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_Fridge_Service">
    <bpmn:participant id="Pool_ServiceProcess" name="Fridge Service Process" processRef="Proc_Main"/>
  </bpmn:collaboration>

  <bpmn:process id="Proc_Main" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Customer" name="Customer">
        <bpmn:flowNodeRef>StartEvent_Request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DescribeSymptoms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConfirmOK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RateService</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CentralCenter" name="Central Service Center">
        <bpmn:flowNodeRef>Task_SelectFacility</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_LocalFacility" name="Local Service Facility">
        <bpmn:flowNodeRef>Task_MakeAppointment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ArriveRandomTime</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_PartsAvailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RepairFridge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OrderPartsLeave</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Request" name="Request Service">
      <bpmn:outgoing>SF_StartToDescribe</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Customer Tasks -->
    <bpmn:task id="Task_DescribeSymptoms" name="Describe Symptoms &amp; Send Info">
      <bpmn:incoming>SF_StartToDescribe</bpmn:incoming>
      <bpmn:outgoing>SF_SendToCenter</bpmn:outgoing>
    </bpmn:task>

    <!-- Central Center Task -->
    <bpmn:task id="Task_SelectFacility" name="Select Local Facility">
      <bpmn:incoming>SF_SendToCenter</bpmn:incoming>
      <bpmn:outgoing>SF_ToAppointment</bpmn:outgoing>
    </bpmn:task>

    <!-- Local Facility Tasks -->
    <bpmn:task id="Task_MakeAppointment" name="Make Appointment">
      <bpmn:incoming>SF_ToAppointment</bpmn:incoming>
      <bpmn:outgoing>SF_ArriveRandomTime</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_ArriveRandomTime" name="Arrive at Random Time">
      <bpmn:incoming>SF_ArriveRandomTime</bpmn:incoming>
      <bpmn:outgoing>SF_CheckPartsDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway -->
    <bpmn:exclusiveGateway id="GW_PartsAvailable" name="Parts&#10;Available?">
       <bpmn:incoming>SF_CheckPartsDecision</bpmn:incoming>
       <bpmn:outgoing>SF_RepairPath</bpmn:outgoing>
       <bpmn:outgoing>SF_NoPartsPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Repair Path -->
    <bpmn:task id="Task_RepairFridge" name="Repair Fridge">
      <bpmn:incoming>SF_RepairPath</bpmn:incoming>
      <bpmn:outgoing>SF_ConfirmOKFlow</bpmn:outgoing>
    </bpmn:task>

    <!-- No Parts Path -->
    <bpmn:task id="Task_OrderPartsLeave" name="Order Additional&#10;Parts / Leave">
      <bpmn:incoming>SF_NoPartsPath</bpmn:incoming>
      <bpmn:outgoing>SF_ReturnVisitLoop</bpmn:outgoing>
    </bpmn:task>

    <!-- Customer Confirmation & Rating -->
    <bpmn:task id="Task_ConfirmOK" name="Confirm Fridge OK">
       <bpmn:incoming>SF_ConfirmOKFlow</bpmn:incoming>
       <bpmn:outgoing>SF_RateServiceFlow</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_RateService" name="Rate Service Facility">
      <bpmn:incoming>SF_RateServiceFlow</bpmn:incoming>
      <bpmn:outgoing>SF_EndProcess</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Completed" name="Service Completed">
       <bpmn:incoming>SF_EndProcess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SF_StartToDescribe" sourceRef="StartEvent_Request" targetRef="Task_DescribeSymptoms"/>
    
    <bpmn:sequenceFlow id="SF_SendToCenter" name="Send Info to Center" sourceRef="Task_DescribeSymptoms" targetRef="Task_SelectFacility">
        <!-- Note: Cross-lane flow -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SF_ToAppointment" sourceRef="Task_SelectFacility" targetRef="Task_MakeAppointment"/>
    
    <bpmn:sequenceFlow id="SF_ArriveRandomTime" name="Arrival Flow" sourceRef="Task_MakeAppointment" targetRef="Task_ArriveRandomTime"/>

    <bpmn:sequenceFlow id="SF_CheckPartsDecision" sourceRef="Task_ArriveRandomTime" targetRef="GW_PartsAvailable"/>
    
    <!-- Gateway Outgoing Flows -->
    <bpmn:sequenceFlow id="SF_RepairPath" name="Yes - Parts Available" sourceRef="GW_PartsAvailable" targetRef="Task_RepairFridge"/>
    
    <bpmn:sequenceFlow id="SF_NoPartsPath" name="No - Need Parts" sourceRef="GW_PartsAvailable" targetRef="Task_OrderPartsLeave"/>

    <!-- Loop Back for No Parts -->
    <bpmn:sequenceFlow id="SF_ReturnVisitLoop" name="Return Visit / Wait" sourceRef="Task_OrderPartsLeave" targetRef="Task_ArriveRandomTime">
        <!-- Note: This creates a loop back to arrival logic until parts are available or process ends. 
             In strict BPMN, looping on tasks is valid but ensure no infinite loops in execution context. -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SF_ConfirmOKFlow" sourceRef="Task_RepairFridge" targetRef="Task_ConfirmOK"/>

    <!-- Cross-lane flow back to Customer Lane for confirmation -->
    <bpmn:sequenceFlow id="SF_RateServiceFlow" name="Confirm &amp; Rate" sourceRef="Task_ConfirmOK" targetRef="Task_RateService">
        <!-- Note: Task_ConfirmOK is in Customer lane, so this flow stays within or goes to another customer task -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SF_EndProcess" sourceRef="Task_RateService" targetRef="EndEvent_Completed"/>

  </bpmn:process>
</bpmn:definitions>