<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
                 id="definitions" name="Unbedenklichkeitsbescheinigung Process">

  <bpmn:process id="unbedenklichkeitsbescheinigungProcess" isExecutable="true">
    <bpmn:startEvent id="anfrageEingang">
      <bpmn:outgoing>sequenceFlow1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="vorgangNachvollziehbarMachen">
      <bpmn:incoming>sequenceFlow1</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow2</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="sequenceFlow1" sourceRef="anfrageEingang" targetRef="vorgangNachvollziehbarMachen"/>

    <bpmn:sequenceFlow id="sequenceFlow2" sourceRef="vorgangNachvollziehbarMachen" targetRef="anzahlBescheinigungenZuruecksetzen"/>

    <bpmn:serviceTask id="anzahlBescheinigungenZuruecksetzen">
      <bpmn:incoming>sequenceFlow2</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow3</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="sequenceFlow3" sourceRef="anzahlBescheinigungenZuruecksetzen" targetRef="absenderPruefen"/>

    <bpmn:exclusiveGateway id="absenderPruefen">
      <bpmn:incoming>sequenceFlow3</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow4</bpmn:outgoing>
      <bpmn:outgoing>sequenceFlow5</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="sequenceFlow4" sourceRef="absenderPruefen" targetRef="rollePruefen">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${absenderImSystemVorhanden}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="sequenceFlow5" sourceRef="absenderPruefen" targetRef="anschreibenErstellen">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${not absenderImSystemVorhanden}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:serviceTask id="anschreibenErstellen">
      <bpmn:incoming>sequenceFlow5</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow16</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="sequenceFlow16" sourceRef="anschreibenErstellen" targetRef="ende"/>

    <bpmn:serviceTask id="rollePruefen">
      <bpmn:incoming>sequenceFlow4</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow7</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="rollePruefenGateway">
      <bpmn:incoming>sequenceFlow7</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow8</bpmn:outgoing>
      <bpmn:outgoing>sequenceFlow9</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="sequenceFlow7" sourceRef="rollePruefen" targetRef="rollePruefenGateway">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${absenderHatArbeitgeberRolle}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="sequenceFlow8" sourceRef="rollePruefenGateway" targetRef="versicherungszeitenPruefen">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${absenderHatArbeitgeberRolle}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="sequenceFlow9" sourceRef="rollePruefenGateway" targetRef="anschreibenErstellen">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${not absenderHatArbeitgeberRolle}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:serviceTask id="versicherungszeitenPruefen">
      <bpmn:incoming>sequenceFlow8</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow10</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="sequenceFlow10" sourceRef="versicherungszeitenPruefen" targetRef="beitragsnachweisePruefen"/>

    <bpmn:serviceTask id="beitragsnachweisePruefen">
      <bpmn:incoming>sequenceFlow10</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow11</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="sequenceFlow11" sourceRef="beitragsnachweisePruefen" targetRef="offeneForderungenPruefen"/>

    <bpmn:serviceTask id="offeneForderungenPruefen">
      <bpmn:incoming>sequenceFlow11</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow12</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="unbedenklichkeitBewerten">
      <bpmn:incoming>sequenceFlow12</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow13</bpmn:outgoing>
      <bpmn:outgoing>sequenceFlow14</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="sequenceFlow12" sourceRef="offeneForderungenPruefen" targetRef="unbedenklichkeitBewerten"/>

    <bpmn:sequenceFlow id="sequenceFlow13" sourceRef="unbedenklichkeitBewerten" targetRef="bescheinigungAusstellen">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${unbedenklichkeitVorhanden}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="sequenceFlow14" sourceRef="unbedenklichkeitBewerten" targetRef="fallAnSachbearbeiterUbergeben">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${not unbedenklichkeitVorhanden}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:serviceTask id="bescheinigungAusstellen">
      <bpmn:incoming>sequenceFlow13</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow15</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="sequenceFlow15" sourceRef="bescheinigungAusstellen" targetRef="eintragInKontakthistorie"/>

    <bpmn:serviceTask id="fallAnSachbearbeiterUbergeben">
      <bpmn:incoming>sequenceFlow14</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow17</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="sequenceFlow17" sourceRef="fallAnSachbearbeiterUbergeben" targetRef="ende"/>

    <bpmn:serviceTask id="eintragInKontakthistorie">
      <bpmn:incoming>sequenceFlow15</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow18</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="sequenceFlow18" sourceRef="eintragInKontakthistorie" targetRef="ende"/>

    <bpmn:endEvent id="ende">
      <bpmn:incoming>sequenceFlow16</bpmn:incoming>
      <bpmn:incoming>sequenceFlow17</bpmn:incoming>
      <bpmn:incoming>sequenceFlow18</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>

</bpmn:definitions>