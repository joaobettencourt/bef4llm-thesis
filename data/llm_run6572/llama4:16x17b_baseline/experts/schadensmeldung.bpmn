<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Schadensmeldung Prozess">

  <process id="schadensmeldungProzess" isExecutable="true">
    <startEvent id="startEvent1">
      <outgoing>sequenceFlow1</outgoing>
    </startEvent>

    <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="exclusiveGateway1"/>

    <exclusiveGateway id="exclusiveGateway1">
      <incoming>sequenceFlow1</incoming>
      <outgoing>sequenceFlow2</outgoing>
      <outgoing>sequenceFlow3</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequenceFlow2" sourceRef="exclusiveGateway1" targetRef="taskGültigkeitPrüfen">
      <conditionExpression xsi:type="tFormalExpression">${gültig} == true</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="sequenceFlow3" sourceRef="exclusiveGateway1" targetRef="endEventKundeInformieren">
      <conditionExpression xsi:type="tFormalExpression">${gültig} == false</conditionExpression>
    </sequenceFlow>

    <task id="taskGültigkeitPrüfen" name="Gültigkeit prüfen">
      <incoming>sequenceFlow2</incoming>
      <outgoing>sequenceFlow4</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow4" sourceRef="taskGültigkeitPrüfen" targetRef="serviceTaskUnterlagenPrüfen"/>

    <serviceTask id="serviceTaskUnterlagenPrüfen" name="Unterlagen prüfen">
      <incoming>sequenceFlow4</incoming>
      <outgoing>sequenceFlow5</outgoing>
    </serviceTask>

    <sequenceFlow id="sequenceFlow5" sourceRef="serviceTaskUnterlagenPrüfen" targetRef="exclusiveGateway2"/>

    <exclusiveGateway id="exclusiveGateway2">
      <incoming>sequenceFlow5</incoming>
      <outgoing>sequenceFlow6</outgoing>
      <outgoing>sequenceFlow7</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequenceFlow6" sourceRef="exclusiveGateway2" targetRef="taskFachabteilungWeiterleiten">
      <conditionExpression xsi:type="tFormalExpression">${unterlagenVollständig} == true</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="sequenceFlow7" sourceRef="exclusiveGateway2" targetRef="taskKundeInformieren">
      <conditionExpression xsi:type="tFormalExpression">${unterlagenVollständig} == false</conditionExpression>
    </sequenceFlow>

    <task id="taskFachabteilungWeiterleiten" name="Fachabteilung weiterleiten">
      <incoming>sequenceFlow6</incoming>
      <outgoing>sequenceFlow8</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow8" sourceRef="taskFachabteilungWeiterleiten" targetRef="serviceTaskVertiefteValidierung"/>

    <serviceTask id="serviceTaskVertiefteValidierung" name="Vertiefte Validierung">
      <incoming>sequenceFlow8</incoming>
      <outgoing>sequenceFlow9</outgoing>
    </serviceTask>

    <sequenceFlow id="sequenceFlow9" sourceRef="serviceTaskVertiefteValidierung" targetRef="taskRechtlicheEinschätzungEinreichen"/>

    <task id="taskRechtlicheEinschätzungEinreichen" name="Rechtliche Einschätzung einreichen">
      <incoming>sequenceFlow9</incoming>
      <outgoing>sequenceFlow10</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow10" sourceRef="taskRechtlicheEinschätzungEinreichen" targetRef="endEventKundeInformierenEndgültig"/>

    <endEvent id="endEventKundeInformieren">
      <incoming>sequenceFlow3</incoming>
    </endEvent>

    <endEvent id="endEventKundeInformierenEndgültig">
      <incoming>sequenceFlow10</incoming>
    </endEvent>

    <task id="taskKundeInformieren" name="Kunde informieren">
      <incoming>sequenceFlow7</incoming>
      <outgoing>sequenceFlow11</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow11" sourceRef="taskKundeInformieren" targetRef="endEventKundeInformieren"/>

  </process>
</definitions>