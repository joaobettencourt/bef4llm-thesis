<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://bpmn.io/schema/bpmn">
  <collaboration id="Collaboration_1">
    <participant id="Participant_1" name="Dispatch of goods&#10;Computer Hardware Shop" processRef="Process_1"/>
  </collaboration>
  <process id="Process_1" isExecutable="true">
    <laneSet id="LaneSet_1">
      <lane id="Lane_0" name="Secretary">
        <flowNodeRef>StartEvent_1</flowNodeRef>
        <flowNodeRef>InclusiveGateway_0</flowNodeRef>
        <flowNodeRef>Task_0s79ile</flowNodeRef>
        <flowNodeRef>ExclusiveGateway_1</flowNodeRef>
        <flowNodeRef>Task_0e6hvnj</flowNodeRef>
        <flowNodeRef>Task_12j0pib</flowNodeRef>
      </lane>
      <lane id="Lane_1" name="Logistics">
        <flowNodeRef>InclusiveGateway_1</flowNodeRef>
        <flowNodeRef>Task_0jsoxba</flowNodeRef>
      </lane>
      <lane id="Lane_2" name="Warehouse">
        <flowNodeRef>ParallelGateway_0</flowNodeRef>
        <flowNodeRef>Task_05ftug5</flowNodeRef>
        <flowNodeRef>ExclusiveGateway_0</flowNodeRef>
        <flowNodeRef>EndEvent_1</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="StartEvent_1" name="Ship goods">
      <outgoing>SequenceFlow_0</outgoing>
    </startEvent>
    <parallelGateway id="ParallelGateway_0">
      <incoming>SequenceFlow_0</incoming>
      <outgoing>SequenceFlow_1</outgoing>
      <outgoing>SequenceFlow_2</outgoing>
    </parallelGateway>
    <sequenceFlow id="SequenceFlow_0" sourceRef="StartEvent_1" targetRef="ParallelGateway_0"/>
    <task id="Task_05ftug5" name="Package goods">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_3</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_1" sourceRef="ParallelGateway_0" targetRef="Task_05ftug5"/>
    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_5</outgoing>
      <outgoing>SequenceFlow_6</outgoing>
    </exclusiveGateway>
    <task id="Task_0e6hvnj" name="Get 3 offers&#10;from logistic&#10;companies">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_5" sourceRef="ExclusiveGateway_1" targetRef="Task_0e6hvnj"/>
    <task id="Task_0s79ile" name="Select logistic&#10;company and&#10;place order">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_7" sourceRef="Task_0e6hvnj" targetRef="Task_0s79ile"/>
    <inclusiveGateway id="InclusiveGateway_0">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_9</outgoing>
      <outgoing>SequenceFlow_10</outgoing>
    </inclusiveGateway>
    <sequenceFlow id="SequenceFlow_2" sourceRef="ParallelGateway_0" targetRef="InclusiveGateway_0"/>
    <task id="Task_12j0pib" name="Insure parcel">
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_11</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_9" sourceRef="InclusiveGateway_0" targetRef="Task_12j0pib"/>
    <task id="Task_0jsoxba" name="Write package&#10;label">
      <incoming>SequenceFlow_10</incoming>
      <outgoing>SequenceFlow_12</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_10" sourceRef="InclusiveGateway_0" targetRef="Task_0jsoxba"/>
    <exclusiveGateway id="ExclusiveGateway_0">
      <incoming>SequenceFlow_14</incoming>
      <incoming>SequenceFlow_15</incoming>
      <outgoing>SequenceFlow_16</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_3" sourceRef="Task_05ftug5" targetRef="ExclusiveGateway_0"/>
    <task id="Task_0sl26uo" name="Prepare for&#10;picking up&#10;goods">
      <incoming>SequenceFlow_16</incoming>
      <outgoing>SequenceFlow_17</outgoing>
    </task>
    <endEvent id="EndEvent_1" name="Shipment&#10;prepared">
      <incoming>SequenceFlow_17</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_4" sourceRef="Task_0s79ile" targetRef="ExclusiveGateway_1"/>
    <inclusiveGateway id="InclusiveGateway_1">
      <incoming>SequenceFlow_12</incoming>
      <outgoing>SequenceFlow_13</outgoing>
    </inclusiveGateway>
    <sequenceFlow id="SequenceFlow_11" sourceRef="Task_12j0pib" targetRef="InclusiveGateway_1"/>
    <sequenceFlow id="SequenceFlow_8" sourceRef="Task_0s79ile" targetRef="ExclusiveGateway_0"/>
    <sequenceFlow id="SequenceFlow_6" name="no" sourceRef="ExclusiveGateway_1" targetRef="InclusiveGateway_0"/>
    <sequenceFlow id="SequenceFlow_13" sourceRef="InclusiveGateway_1" targetRef="ExclusiveGateway_0"/>
    <sequenceFlow id="SequenceFlow_15" sourceRef="Task_0jsoxba" targetRef="ExclusiveGateway_0"/>
    <sequenceFlow id="SequenceFlow_14" sourceRef="Task_12j0pib" targetRef="ExclusiveGateway_0"/>
    <sequenceFlow id="SequenceFlow_16" sourceRef="ExclusiveGateway_0" targetRef="Task_0sl26uo"/>
    <sequenceFlow id="SequenceFlow_17" sourceRef="Task_0sl26uo" targetRef="EndEvent_1"/>
  </process>
</definitions>