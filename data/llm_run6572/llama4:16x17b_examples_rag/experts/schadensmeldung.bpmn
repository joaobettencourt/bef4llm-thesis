<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Schadensmeldung Bearbeitung">

  <process id="schadensmeldungBearbeitung" isExecutable="true">
    <startEvent id="startEvent1">
      <outgoing>sequenceFlow1</outgoing>
    </startEvent>

    <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="exclusiveGateway"/>

    <exclusiveGateway id="exclusiveGateway">
      <incoming>sequenceFlow1</incoming>
      <outgoing>sequenceFlow2</outgoing>
      <outgoing>sequenceFlow3</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequenceFlow2" name="Schaden nicht gültig" sourceRef="exclusiveGateway" targetRef="taskKundeInformieren"/>

    <task id="taskKundeInformieren" name="Kunde informieren">
      <incoming>sequenceFlow2</incoming>
      <outgoing>sequenceFlow4</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow4" sourceRef="taskKundeInformieren" targetRef="endEvent1"/>

    <sequenceFlow id="sequenceFlow3" name="Schaden gültig" sourceRef="exclusiveGateway" targetRef="parallelGateway">
      <conditionExpression xsi:type="tFormalExpression">${schaden.gültig}  == true</conditionExpression>
    </sequenceFlow>

    <parallelGateway id="parallelGateway1">
      <incoming>sequenceFlow3</incoming>
      <outgoing>sequenceFlow5</outgoing>
      <outgoing>sequenceFlow6</outgoing>
    </parallelGateway>

    <sequenceFlow id="sequenceFlow5" sourceRef="parallelGateway1" targetRef="taskUnterlagenPrüfen"/>

    <task id="taskUnterlagenPrüfen" name="Unterlagen prüfen">
      <incoming>sequenceFlow5</incoming>
      <outgoing>sequenceFlow7</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow7" sourceRef="taskUnterlagenPrüfen" targetRef="serviceTaskSchadensakteErstellen"/>

    <serviceTask id="serviceTaskSchadensakteErstellen1" name="Schadensakte erstellen">
      <incoming>sequenceFlow7</incoming>
      <outgoing>sequenceFlow8</outgoing>
    </serviceTask>

    <sequenceFlow id="sequenceFlow8" sourceRef="serviceTaskSchadensakteErstellen1" targetRef="exclusiveGateway2"/>

    <exclusiveGateway id="exclusiveGateway2">
      <incoming>sequenceFlow8</incoming>
      <outgoing>sequenceFlow9</outgoing>
      <outgoing>sequenceFlow10</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequenceFlow9" sourceRef="exclusiveGateway2" targetRef="taskRechtlicheEinschätzungEinholen">
      <conditionExpression xsi:type="tFormalExpression">${schadensakte.rechtlicheEinschätzungErforderlich}  == true</conditionExpression>
    </sequenceFlow>

    <task id="taskRechtlicheEinschätzungEinholen1" name="Rechtliche Einschätzung einholen">
      <incoming>sequenceFlow9</incoming>
      <outgoing>sequenceFlow11</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow11" sourceRef="taskRechtlicheEinschätzungEinholen1" targetRef="taskSchadensstatistikAktualisieren"/>

    <sequenceFlow id="sequenceFlow10" sourceRef="exclusiveGateway2" targetRef="taskSchadensstatistikAktualisieren">
      <conditionExpression xsi:type="tFormalExpression">${schadensakte.rechtlicheEinschätzungErforderlich}  == false</conditionExpression>
    </sequenceFlow>

    <task id="taskSchadensstatistikAktualisieren1" name="Schadensstatistik aktualisieren">
      <incoming>sequenceFlow10</incoming>
      <incoming>sequenceFlow11</incoming>
      <outgoing>sequenceFlow12</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow12" sourceRef="taskSchadensstatistikAktualisieren1" targetRef="endEvent1"/>

    <sequenceFlow id="sequenceFlow6" sourceRef="parallelGateway1" targetRef="taskSchadensmeldungInStatistikErfassen"/>

    <task id="taskSchadensmeldungInStatistikErfassen1" name="Schadensmeldung in Statistik erfassen">
      <incoming>sequenceFlow6</incoming>
    </task>

    <endEvent id="endEvent1" name="Bearbeitung abgeschlossen">
      <incoming>sequenceFlow4</incoming>
      <incoming>sequenceFlow12</incoming>
    </endEvent>

  </process>
</definitions>