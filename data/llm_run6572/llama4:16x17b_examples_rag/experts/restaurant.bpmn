<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/DD/20100524/DC http://www.omg.org/spec/DD/20100524/DI"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" 
             id="definitions" name="Restaurant Process"
             targetNamespace="http://example.com">

   <process id="restaurantProcess" isExecutable="true">
     <laneSet>
       <lane id="waiterLane" name="Angestellter">
         <flowNodeRef>startEvent</flowNodeRef>
         <flowNodeRef>taskOrderInput_1</flowNodeRef>
         <flowNodeRef>taskPay_2</flowNodeRef>
         <flowNodeRef>taskInformCook_3</flowNodeRef>
         <flowNodeRef>exclusiveGatewayCheckPieper_4</flowNodeRef>
         <flowNodeRef>taskCallGuest_5</flowNodeRef>
         <flowNodeRef>serviceTaskNotifyGuest_6</flowNodeRef>
       </lane>
       <lane id="cookLane" name="Koch">
         <flowNodeRef>taskPrepareFood_7</flowNodeRef>
       </lane>
     </laneSet>

     <startEvent id="startEvent_1" name="Gast betritt Restaurant">
       <outgoing>sequenceFlowStartToOrderInput_8</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlowStartToOrderInput_8" sourceRef="startEvent_1" targetRef="taskOrderInput_1"/>

     <userTask id="taskOrderInput_1" name="Bestellung aufnehmen">
       <incoming>sequenceFlowStartToOrderInput_8</incoming>
       <outgoing>sequenceFlowOrderInputToPay_9</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlowOrderInputToPay_9" sourceRef="taskOrderInput_1" targetRef="taskPay_2"/>

     <userTask id="taskPay_2" name="Bezahlung">
       <incoming>sequenceFlowOrderInputToPay_9</incoming>
       <outgoing>sequenceFlowPayToInformCook_10</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlowPayToInformCook_10" sourceRef="taskPay_2" targetRef="taskInformCook_3"/>

     <userTask id="taskInformCook_3" name="Koch informieren">
       <incoming>sequenceFlowPayToInformCook_10</incoming>
       <outgoing>sequenceFlowInformCookToPrepareFood_11</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlowInformCookToPrepareFood_11" sourceRef="taskInformCook_3" targetRef="taskPrepareFood_7"/>

     <userTask id="taskPrepareFood_7" name="Essen zubereiten">
       <incoming>sequenceFlowInformCookToPrepareFood_11</incoming>
       <outgoing>sequenceFlowPrepareFoodToNotifyWaiter_12</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlowPrepareFoodToNotifyWaiter_12" sourceRef="taskPrepareFood_7" targetRef="serviceTaskNotifyWaiter_13"/>

     <serviceTask id="serviceTaskNotifyWaiter_13" name="Angestellten informieren">
       <incoming>sequenceFlowPrepareFoodToNotifyWaiter_12</incoming>
       <outgoing>sequenceFlowNotifyWaiterToCheckPieper_14</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlowNotifyWaiterToCheckPieper_14" sourceRef="serviceTaskNotifyWaiter_13" targetRef="exclusiveGatewayCheckPieper_4"/>

     <exclusiveGateway id="exclusiveGatewayCheckPieper_4">
       <incoming>sequenceFlowNotifyWaiterToCheckPieper_14</incoming>
       <outgoing>sequenceFlowCheckPieperToCallGuest_15</outgoing>
       <outgoing>sequenceFlowCheckPieperToNotifyGuest_16</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlowCheckPieperToCallGuest_15" sourceRef="exclusiveGatewayCheckPieper_4" targetRef="taskCallGuest_5"/>

     <userTask id="taskCallGuest_5" name="Gast aufrufen">
       <incoming>sequenceFlowCheckPieperToCallGuest_15</incoming>
       <outgoing>sequenceFlowCallGuestToEnd_17</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlowCallGuestToEnd_17" sourceRef="taskCallGuest_5" targetRef="endEventOrderFinished_18"/>

     <serviceTask id="serviceTaskNotifyGuest_6" name="Gast informieren">
       <incoming>sequenceFlowCheckPieperToNotifyGuest_16</incoming>
       <outgoing>sequenceFlowNotifyGuestToEnd_19</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlowNotifyGuestToEnd_19" sourceRef="serviceTaskNotifyGuest_6" targetRef="endEventOrderFinished_18"/>

     <endEvent id="endEventOrderFinished_18" name="Bestellung fertig">
       <incoming>sequenceFlowCallGuestToEnd_17</incoming>
       <incoming>sequenceFlowNotifyGuestToEnd_19</incoming>
     </endEvent>

   </process>
</definitions>