<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" name="Schufa Scoring Prozess">

   <process id="schufaScoringProzess" isExecutable="true">
     <startEvent id="startEvent">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <serviceTask id="scoringAnfrage" name="Scoringanfrage an Schufa senden">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </serviceTask>

     <exclusiveGateway id="verzogerungGateway">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow4</outgoing>
       <outgoing>sequenceFlow5</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent" targetRef="scoringAnfrage"/>
     <sequenceFlow id="sequenceFlow2" sourceRef="scoringAnfrage" targetRef="verzogerungGateway"/>

     <task id="level1Scoring" name="Level 1 Scoring durchführen">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow6</outgoing>
     </task>

     <serviceTask id="scoringergebnisAnBankMelden" name="Scoringergebnis an Bank melden">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow7</outgoing>
     </serviceTask>

     <endEvent id="prozessBeendet">
       <incoming>sequenceFlow7</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow3" sourceRef="scoringAnfrage" targetRef="verzogerungGateway"/>
     <sequenceFlow id="sequenceFlow4" name="keine Verzögerung" sourceRef="verzogerungGateway" targetRef="level1Scoring">
       <conditionExpression xsi:type="tFormalExpression">${verzögerung == false}</conditionExpression>
     </sequenceFlow>

     <task id="level2Scoring" name="Level 2 Scoring durchführen">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow8</outgoing>
     </task>

     <serviceTask id="finalesScoringergebnisAnBankMelden" name="Finales Scoringergebnis an Bank melden">
       <incoming>sequenceFlow8</incoming>
       <outgoing>sequenceFlow9</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlow5" name="Verzögerung" sourceRef="verzogerungGateway" targetRef="level2Scoring">
       <conditionExpression xsi:type="tFormalExpression">${verzögerung == true}</conditionExpression>
     </sequenceFlow>
     <sequenceFlow id="sequenceFlow6" sourceRef="level1Scoring" targetRef="scoringergebnisAnBankMelden"/>
     <sequenceFlow id="sequenceFlow7" sourceRef="scoringergebnisAnBankMelden" targetRef="prozessBeendet"/>
     <sequenceFlow id="sequenceFlow8" sourceRef="level2Scoring" targetRef="finalesScoringergebnisAnBankMelden"/>
     <sequenceFlow id="sequenceFlow9" sourceRef="finalesScoringergebnisAnBankMelden" targetRef="prozessBeendet"/>

   </process>
</definitions>