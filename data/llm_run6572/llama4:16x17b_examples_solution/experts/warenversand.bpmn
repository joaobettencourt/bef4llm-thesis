<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="Definitions_1" targetNamespace="http://example.com/orderprocess">

    <collaboration id="Collaboration_1">
      <participant id="Participant_1" name="Goods Dispatch Process" processRef="Process_1"/>
    </collaboration>

    <process id="Process_1" isExecutable="true">

      <!-- Start Event  -->
      <startEvent id="StartEvent_1" name="Ship Goods">
        <outgoing>SequenceFlow_1</outgoing>
      </startEvent>

      <!-- Lane Set  -->
      <laneSet>
        <lane id="Lane_1" name="Logistics Manager">
          <flowNodeRef>Task_2</flowNodeRef>
        </lane>
        <lane id="Lane_2" name="Secretariat">
          <flowNodeRef>Task_1</flowNodeRef>
          <flowNodeRef>Task_3</flowNodeRef>
          <flowNodeRef>ExclusiveGateway_1</flowNodeRef>
        </lane>
        <lane id="Lane_3" name="Warehouse Worker">
          <flowNodeRef>Task_5</flowNodeRef>
          <flowNodeRef>Task_6</flowNodeRef>
          <flowNodeRef>EndEvent_1</flowNodeRef>
        </lane>
      </laneSet>

      <!-- Task: Determine shipping method  -->
      <task id="Task_1" name="Determine Shipping Method">
        <incoming>SequenceFlow_1</incoming>
        <outgoing>SequenceFlow_2</outgoing>
      </task>

      <!-- Exclusive Gateway: Special handling needed?  -->
      <exclusiveGateway id="ExclusiveGateway_1" name="Special Handling Needed?">
        <incoming>SequenceFlow_2</incoming>
        <outgoing>SequenceFlow_3</outgoing>
        <outgoing>SequenceFlow_4</outgoing>
      </exclusiveGateway>

      <!-- Sequence Flows  -->
      <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>
      <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="ExclusiveGateway_1"/>

      <!-- Task: Package goods  (if regular shipment)  -->
      <task id="Task_5" name="Package Goods">
        <incoming>SequenceFlow_6</incoming>
        <outgoing>SequenceFlow_7</outgoing>
      </task>

      <!-- Task: Prepare for picking up goods  (if special shipment)  -->
      <task id="Task_3" name="Get Quotes from 3 Forwarders">
        <incoming>SequenceFlow_3</incoming>
        <outgoing>SequenceFlow_5</outgoing>
      </task>

      <!-- Exclusive Gateway: Is package insured?  -->
      <exclusiveGateway id="ExclusiveGateway_2" name="Is Package Insured?">
        <incoming>SequenceFlow_5</incoming>
        <outgoing>SequenceFlow_8</outgoing>
        <outgoing>SequenceFlow_9</outgoing>
      </exclusiveGateway>

      <!-- Sequence Flows  -->
      <sequenceFlow id="SequenceFlow_3" name="yes" sourceRef="ExclusiveGateway_1" targetRef="Task_3"/>
      <sequenceFlow id="SequenceFlow_4" name="no" sourceRef="ExclusiveGateway_1" targetRef="Task_5"/>

      <!-- Task: Insure package  -->
      <task id="Task_2" name="Insure Package">
        <incoming>SequenceFlow_8</incoming>
        <outgoing>SequenceFlow_6</outgoing>
      </task>

      <!-- Sequence Flows  -->
      <sequenceFlow id="SequenceFlow_5" sourceRef="Task_3" targetRef="ExclusiveGateway_2"/>
      <sequenceFlow id="SequenceFlow_6" sourceRef="Task_2" targetRef="Task_5"/>

      <!-- Task: Fill out shipment label  -->
      <task id="Task_4" name="Fill Out Shipment Label">
        <incoming>SequenceFlow_9</incoming>
        <outgoing>SequenceFlow_10</outgoing>
      </task>

      <!-- Sequence Flows  -->
      <sequenceFlow id="SequenceFlow_8" name="yes" sourceRef="ExclusiveGateway_2" targetRef="Task_2"/>
      <sequenceFlow id="SequenceFlow_9" name="no" sourceRef="ExclusiveGateway_2" targetRef="Task_4"/>

      <!-- Task: Provide goods for pickup  -->
      <task id="Task_6" name="Provide Goods for Pickup">
        <incoming>SequenceFlow_7</incoming>
        <outgoing>SequenceFlow_11</outgoing>
      </task>

      <!-- Parallel Gateway -->
      <parallelGateway id="ParallelGateway_1">
        <incoming>SequenceFlow_4</incoming>
        <incoming>SequenceFlow_10</incoming>
        <outgoing>SequenceFlow_12</outgoing>
      </parallelGateway>

      <!-- End Event  -->
      <endEvent id="EndEvent_1" name="Goods Dispatched">
        <incoming>SequenceFlow_11</incoming>
      </endEvent>

      <!-- Sequence Flows  -->
      <sequenceFlow id="SequenceFlow_7" sourceRef="Task_5" targetRef="Task_6"/>
      <sequenceFlow id="SequenceFlow_10" sourceRef="Task_4" targetRef="ParallelGateway_1"/>
      <sequenceFlow id="SequenceFlow_11" sourceRef="Task_6" targetRef="EndEvent_1"/>
      <sequenceFlow id="SequenceFlow_12" sourceRef="ParallelGateway_1" targetRef="Task_5"/>

    </process>
</definitions>