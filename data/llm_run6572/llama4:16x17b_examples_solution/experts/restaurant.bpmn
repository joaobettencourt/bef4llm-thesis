<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
                 id="Definitions" targetNamespace="http://example.com/restaurantprocess">

  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Gast" processRef="Process_1"/>
    <bpmn:participant id="Participant_2" name="Angestellter" processRef="Process_2"/>
    <bpmn:participant id="Participant_3" name="Koch" processRef="Process_3"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="true">

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Hunger festgestellt">
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Restaurant betreten -->
    <bpmn:task id="Task_1" name="Restaurant betreten">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="IntermediateCatchEvent_1"/>

    <!-- Intermediate Catch Event: an der Reihe -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_1" name="an der Reihe">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Sequence Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="IntermediateCatchEvent_1" targetRef="Task_2"/>

    <!-- Task: Bestellung aufgeben -->
    <bpmn:task id="Task_2" name="Bestellung aufgeben">
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="Task_2" targetRef="Process_2"/>

  </bpmn:process>

  <bpmn:process id="Process_2" isExecutable="true">

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_2" name="Bestellung erhalten">
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Bestellung bearbeiten -->
    <bpmn:task id="Task_3" name="Bestellung bearbeiten">
      <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="StartEvent_2" targetRef="Task_3"/>
    <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="Task_3" targetRef="Process_1"/>

  </bpmn:process>

  <bpmn:process id="Process_3" isExecutable="true">

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_3" name="Mahlzeit zuzubereiten">
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Mahlzeit zubereiten -->
    <bpmn:task id="Task_4" name="Mahlzeit zubereiten">
      <bpmn:incoming>SequenceFlow_7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_8</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_1" name="Mahlzeit zubereitet">
      <bpmn:incoming>SequenceFlow_8</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_7" sourceRef="StartEvent_3" targetRef="Task_4"/>
    <bpmn:sequenceFlow id="SequenceFlow_8" sourceRef="Task_4" targetRef="EndEvent_1"/>

  </bpmn:process>

</bpmn:definitions>