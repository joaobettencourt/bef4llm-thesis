<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.4.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="SEPA_Mandat_Processing" targetNamespace="http://example.com/sepaMandat">
    <collaboration id="Collaboration_1">
        <participant id="Participant_1" name="SEPA Mandat Processing" processRef="Process_1"/>
    </collaboration>

    <process id="Process_1" isExecutable="true">

        <!-- Start Event  -->
        <startEvent id="StartEvent_1" name="Data for SEPA mandate received">
            <outgoing>SequenceFlow_1</outgoing>
        </startEvent>

        <!-- Task: Check IBAN presence and country registration -->
        <task id="Task_1" name="Check IBAN and determine country of registration">
            <incoming>SequenceFlow_1</incoming>
            <outgoing>SequenceFlow_2</outgoing>
        </task>

        <!-- Sequence Flow -->
        <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>
        <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="Task_2"/>

        <!-- Task: Search for associated person in the system -->
        <task id="Task_2" name="Search for associated person and check required information">
            <incoming>SequenceFlow_2</incoming>
            <outgoing>SequenceFlow_3</outgoing>
            <outgoing>SequenceFlow_4</outgoing>
        </task>

        <!-- Exclusive Gateway: Are all necessary details available? -->
        <exclusiveGateway id="ExclusiveGateway_1">
            <incoming>SequenceFlow_3</incoming>
            <outgoing>SequenceFlow_5</outgoing>
            <outgoing>SequenceFlow_6</outgoing>
        </exclusiveGateway>

        <!-- Sequence Flows -->
        <sequenceFlow id="SequenceFlow_3" sourceRef="Task_2" targetRef="ExclusiveGateway_1"/>
        <sequenceFlow id="SequenceFlow_4" name="No" sourceRef="Task_2" targetRef="ExclusiveGateway_1"/>

        <!-- Task: Manual check of missing data -->
        <task id="Task_3" name="Manually check and complete missing data">
            <incoming>SequenceFlow_6</incoming>
            <outgoing>SequenceFlow_7</outgoing>
        </task>

        <!-- Sequence Flow -->
        <sequenceFlow id="SequenceFlow_5" name="Yes" sourceRef="ExclusiveGateway_1" targetRef="Task_4"/>
        <sequenceFlow id="SequenceFlow_6" name="No" sourceRef="ExclusiveGateway_1" targetRef="Task_3"/>
        <sequenceFlow id="SequenceFlow_7" sourceRef="Task_3" targetRef="StartEvent_1"/>

        <!-- Task: Validate "Valid from" date and bank connection -->
        <task id="Task_4" name="Validate 'Valid from' date, signature location & bank connection">
            <incoming>SequenceFlow_5</incoming>
            <outgoing>SequenceFlow_8</outgoing>
        </task>

        <!-- Exclusive Gateway: Does a valid SEPA mandate exist? -->
        <exclusiveGateway id="ExclusiveGateway_2">
            <incoming>SequenceFlow_8</incoming>
            <outgoing>SequenceFlow_9</outgoing>
            <outgoing>SequenceFlow_10</outgoing>
        </exclusiveGateway>

        <!-- Sequence Flows -->
        <sequenceFlow id="SequenceFlow_8" sourceRef="Task_4" targetRef="ExclusiveGateway_2"/>

        <!-- Task: Create or update SEPA mandate -->
        <task id="Task_5" name="Create/update SEPA mandate in the system">
            <incoming>SequenceFlow_9</incoming>
            <outgoing>SequenceFlow_11</outgoing>
        </task>

        <!-- End Event -->
        <endEvent id="EndEvent_1" name="SEPA Mandat Processing completed">
            <incoming>SequenceFlow_11</incoming>
        </endEvent>

        <!-- Sequence Flows -->
        <sequenceFlow id="SequenceFlow_9" sourceRef="ExclusiveGateway_2" targetRef="Task_5"/>
        <sequenceFlow id="SequenceFlow_10" name="No" sourceRef="ExclusiveGateway_2" targetRef="EndEvent_1"/>
        <sequenceFlow id="SequenceFlow_11" sourceRef="Task_5" targetRef="EndEvent_1"/>

    </process>
</definitions>