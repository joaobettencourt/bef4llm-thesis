<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
                 id="Definitions_1" targetNamespace="http://example.com/bpmn">

  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Gesundheitsförderung" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="true">

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Programmbeginn">
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Gesundheits-Check -->
    <bpmn:manualTask id="Task_1" name="Gesundheits-Check durchführen">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:manualTask>

    <!-- Sequence Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="Task_2"/>

    <!-- Task: Einweisung in App und Wearables -->
    <bpmn:manualTask id="Task_2" name="Einweisung in App und Wearables">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
    </bpmn:manualTask>

    <!-- Sequence Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="Task_2" targetRef="Task_3"/>

    <!-- Task: Erstellung Trainings- und Ernährungspläne -->
    <bpmn:manualTask id="Task_3" name="Erstellung Trainings- und Ernährungspläne">
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
    </bpmn:manualTask>

    <!-- Sequence Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="Task_3" targetRef="IntermediateCatchEvent_1"/>

    <!-- Intermediate Catch Event: 6 Monate warten -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_1" name="6 Monate warten">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
      <bpmn:timerEventDefinition/>
    </bpmn:intermediateCatchEvent>

    <!-- Sequence Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="IntermediateCatchEvent_1" targetRef="ExclusiveGateway_1"/>

    <!-- Exclusive Gateway: Aufteilung in Gruppen -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_1">
      <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_6" name="Mit Wearables" sourceRef="ExclusiveGateway_1" targetRef="Task_4"/>
    <bpmn:sequenceFlow id="SequenceFlow_7" name="Ohne Wearables" sourceRef="ExclusiveGateway_1" targetRef="Task_5"/>

    <!-- Tasks: Training durchführen -->
    <bpmn:manualTask id="Task_4" name="Training mit Wearables">
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_8</bpmn:outgoing>
    </bpmn:manualTask>

    <bpmn:manualTask id="Task_5" name="Training ohne Wearables">
      <bpmn:incoming>SequenceFlow_7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_9</bpmn:outgoing>
    </bpmn:manualTask>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_8" sourceRef="Task_4" targetRef="IntermediateCatchEvent_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_9" sourceRef="Task_5" targetRef="IntermediateCatchEvent_2"/>

    <!-- Intermediate Catch Event: 6 Monate warten -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_2" name="Weitere 6 Monate warten">
      <bpmn:incoming>SequenceFlow_8</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_9</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
      <bpmn:timerEventDefinition/>
    </bpmn:intermediateCatchEvent>

    <!-- Sequence Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="IntermediateCatchEvent_2" targetRef="Task_6"/>

    <!-- Task: Abschlussuntersuchung -->
    <bpmn:manualTask id="Task_6" name="Abschlussuntersuchung durchführen">
      <bpmn:incoming>SequenceFlow_10</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_11</bpmn:outgoing>
    </bpmn:manualTask>

    <!-- Sequence Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_11" sourceRef="Task_6" targetRef="EndEvent_1"/>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_1" name="Programmende">
      <bpmn:incoming>SequenceFlow_11</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>