<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="Definitions" targetNamespace="http://example.com/regressprozess">

    <collaboration id="Collaboration_1">
      <participant id="Participant_1" name="Regressnahme Sachbearbeiter" processRef="Process_1"/>
    </collaboration>

    <process id="Process_1" isExecutable="true">

      <!-- Start Event: Regressverdacht gemeldet -->
      <startEvent id="StartEvent_1" name="Regressverdacht gemeldet">
        <outgoing>SequenceFlow_1</outgoing>
        <messageEventDefinition/>
      </startEvent>

      <!-- Task: Fall prüfen  -->
      <task id="Task_1" name="Fall prüfen">
        <incoming>SequenceFlow_1</incoming>
        <outgoing>SequenceFlow_2</outgoing>
      </task>

      <!-- Sequence Flow: Start to Prüfen --> 
      <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>

      <!-- Exclusive Gateway: Regress möglich?  -->
      <exclusiveGateway id="ExclusiveGateway_1" name="Regress möglich?">
        <incoming>SequenceFlow_2</incoming>
        <outgoing>SequenceFlow_3</outgoing>
        <outgoing>SequenceFlow_4</outgoing>
      </exclusiveGateway>

      <!-- Sequence Flow: Prüfen to Regress möglich --> 
      <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="ExclusiveGateway_1"/>

      <!-- Task: Zahlungsaufforderung an VN schicken, Vorgang auf Wiedervorlage setzen -->
      <task id="Task_2" name="Zahlungsaufforderung an VN schicken">
        <incoming>SequenceFlow_3</incoming>
        <outgoing>SequenceFlow_5</outgoing>
      </task>

      <!-- Task: Vorgang schließen (Regress nicht möglich) --> 
      <task id="Task_3" name="Vorgang schließen">
        <incoming>SequenceFlow_4</incoming>
        <outgoing>SequenceFlow_6</outgoing>
      </task>

      <!-- Sequence Flows --> 
      <sequenceFlow id="SequenceFlow_3" name="Ja" sourceRef="ExclusiveGateway_1" targetRef="Task_2"/>
      <sequenceFlow id="SequenceFlow_4" name="Nein" sourceRef="ExclusiveGateway_1" targetRef="Task_3"/>

      <!-- End Event: Vorgang geschlossen --> 
      <endEvent id="EndEvent_1" name="Vorgang geschlossen">
        <incoming>SequenceFlow_6</incoming>
      </endEvent>

      <!-- Sequence Flow: Vorgang schließen to EndEvent --> 
      <sequenceFlow id="SequenceFlow_6" sourceRef="Task_3" targetRef="EndEvent_1"/>

      <!-- Task: Vorgang auf Wiedervorlage setzen -->
      <task id="Task_4" name="Vorgang auf Wiedervorlage setzen">
        <incoming>SequenceFlow_5</incoming>
        <outgoing>SequenceFlow_7</outgoing>
      </task>

      <!-- Sequence Flow: Zahlungsaufforderung to Vorgang auf Wiedervorlage --> 
      <sequenceFlow id="SequenceFlow_5" sourceRef="Task_2" targetRef="Task_4"/>

      <!-- Event-Based Gateway for various events (Widerspruch, Wiedervorlage) -->
      <eventBasedGateway id="EventBasedGateway_1">
        <incoming>SequenceFlow_7</incoming>
        <outgoing>SequenceFlow_8</outgoing>
        <outgoing>SequenceFlow_9</outgoing>
        <outgoing>SequenceFlow_10</outgoing>
      </eventBasedGateway>

      <!-- Sequence Flow: Vorgang auf Wiedervorlage to Event-Based Gateway --> 
      <sequenceFlow id="SequenceFlow_7" sourceRef="Task_4" targetRef="EventBasedGateway_1"/>

      <!-- Intermediate Catch Event: Widerspruch erhalten -->
      <intermediateCatchEvent id="IntermediateCatchEvent_1" name="Widerspruch erhalten">
        <incoming>SequenceFlow_8</incoming>
        <outgoing>SequenceFlow_11</outgoing>
        <messageEventDefinition/>
      </intermediateCatchEvent>

      <!-- Sequence Flow: Event-Base  to Widerspruch --> 
      <sequenceFlow id="SequenceFlow_8" sourceRef="EventBasedGateway_1" targetRef="IntermediateCatchEvent_1"/>

      <!-- Task: Widerspruch prüfen -->
      <task id="Task_5" name="Widerspruch prüfen">
        <incoming>SequenceFlow_11</incoming>
        <outgoing>SequenceFlow_12</outgoing>
      </task>

      <!-- Sequence Flow: Widerspruch to Prüfung --> 
      <sequenceFlow id="SequenceFlow_11" sourceRef="IntermediateCatchEvent_1" targetRef="Task_5"/>

      <!-- Exclusive Gateway: Gerechtfertigt? -->
      <exclusiveGateway id="ExclusiveGateway_2" name="Gerechtfertigt?">
        <incoming>SequenceFlow_12</incoming>
        <outgoing>SequenceFlow_13</outgoing>
        <outgoing>SequenceFlow_14</outgoing>
      </exclusiveGateway>

      <!-- Sequence Flow: Prüfung to Gerechtfertigt --> 
      <sequenceFlow id="SequenceFlow_12" sourceRef="Task_5" targetRef="ExclusiveGateway_2"/>

      <!-- Task: Vorgang schließen (Widerspruch gerechtfertigt) -->
      <task id="Task_6" name="Vorgang schließen">
        <incoming>SequenceFlow_13</incoming>
        <outgoing>SequenceFlow_15</outgoing>
      </task>

      <!-- Sequence Flows for Gerechtfertigt --> 
      <sequenceFlow id="SequenceFlow_13" name="Ja" sourceRef="ExclusiveGateway_2" targetRef="Task_6"/>
      <sequenceFlow id="SequenceFlow_14" name="Nein" sourceRef="ExclusiveGateway_2" targetRef="Task_7"/>

      <!-- Task: Vorgang an Inkasso-Dienstleister geben -->
      <task id="Task_7" name="Vorgang an Inkasso-Dienstleister geben">
        <incoming>SequenceFlow_14</incoming>
        <outgoing>SequenceFlow_16</outgoing>
      </task>

      <!-- Sequence Flow: Gerechtfertigt Nein to Inkasso --> 
      <sequenceFlow id="SequenceFlow_14" sourceRef="ExclusiveGateway_2" targetRef="Task_7"/>

      <!-- End Event: Vorgang geschlossen after gerechtfertigter Widerspruch -->
      <endEvent id="EndEvent_2" name="Vorgang geschlossen">
        <incoming>SequenceFlow_15</incoming>
      </endEvent>

      <!-- Sequence Flow: Vorgang schließen to EndEvent nach Widerspruchsprüfung --> 
      <sequenceFlow id="SequenceFlow_15" sourceRef="Task_6" targetRef="EndEvent_2"/>

      <!-- Intermediate Catch Event: Wiedervorlage fällig or Geld eingegangen -->
      <intermediateCatchEvent id="IntermediateCatchEvent_2" name="Wiedervorlage fällig">
        <incoming>SequenceFlow_9</incoming>
        <outgoing>SequenceFlow_17</outgoing>
        <timerEventDefinition/>
      </intermediateCatchEvent>

      <!-- Sequence Flow: Event-Based Gateway to Wiedervorlage --> 
      <sequenceFlow id="SequenceFlow_9" sourceRef="EventBasedGateway_1" targetRef="IntermediateCatchEvent_2"/>

      <!-- Task: Vorgang an Inkasso-Dienstleister geben (Wiedervorlage) -->
      <task id="Task_8" name="Vorgang an Inkasso-Dienstleister geben">
        <incoming>SequenceFlow_17</incoming>
        <outgoing>SequenceFlow_18</outgoing>
      </task>

      <!-- Sequence Flow: Wiedervorlage fällig to Inkasso --> 
      <sequenceFlow id="SequenceFlow_17" sourceRef="IntermediateCatchEvent_2" targetRef="Task_8"/>

      <!-- End Event: Vorgang offen after sending to Inkasso -->
      <endEvent id="EndEvent_3" name="Vorgang offen">
        <incoming>SequenceFlow_18</incoming>
      </endEvent>

      <!-- Sequence Flow: Task 7 or 8 to EndEvent offen --> 
      <sequenceFlow id="SequenceFlow_16" sourceRef="Task_7" targetRef="EndEvent_3"/>
      <sequenceFlow id="SequenceFlow_18" sourceRef="Task_8" targetRef="EndEvent_3"/>

      <!-- Intermediate Catch Event: Geld eingegangen -->
      <intermediateCatchEvent id="IntermediateCatchEvent_3" name="Geld eingegangen">
        <incoming>SequenceFlow_10</incoming>
        <outgoing>SequenceFlow_19</outgoing>
        <messageEventDefinition/>
      </intermediateCatchEvent>

      <!-- Sequence Flow: Event-Based Gateway to Geld eingegangen --> 
      <sequenceFlow id="SequenceFlow_10" sourceRef="EventBasedGateway_1" targetRef="IntermediateCatchEvent_3"/>

      <!-- Task: Geldeingang verbuchen and Vorgang schließen -->
      <task id="Task_9" name="Geldeingang verbuchen">
        <incoming>SequenceFlow_19</incoming>
        <outgoing>SequenceFlow_20</outgoing>
      </task>

      <!-- Sequence Flow: Geld eingegangen to Geldeingang verbuchen --> 
      <sequenceFlow id="SequenceFlow_19" sourceRef="IntermediateCatchEvent_3" targetRef="Task_9"/>

      <!-- Task: Vorgang schließen after payment -->
      <task id="Task_10" name="Vorgang schließen">
        <incoming>SequenceFlow_20</incoming>
        <outgoing>SequenceFlow_21</outgoing>
      </task>

      <!-- Sequence Flow: Geldeingang verbuchen to EndEvent geschlossen --> 
      <sequenceFlow id="SequenceFlow_20" sourceRef="Task_9" targetRef="Task_10"/>
      <sequenceFlow id="SequenceFlow_21" sourceRef="Task_10" targetRef="EndEvent_2"/>

    </process>
</definitions>