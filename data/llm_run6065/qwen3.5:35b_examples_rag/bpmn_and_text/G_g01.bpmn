<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_LANParty_01" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_LAN_Party_01">
    <bpmn:participant id="Participant_Organizer" name="LAN Party Organizer" processRef="Process_LANParty_01" />
  </bpmn:collaboration>

  <bpmn:process id="Process_LANParty_01" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Organizer_01">
      <bpmn:lane id="Lane_MainOrganizer" name="Main Organizer">
        <bpmn:flowNodeRef>StartEvent_PlanLAN</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendInvitations</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CollectGames</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_PrepDiverge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AppointDate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_CheckAgreement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReAppointDate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckGames</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_GamesMissing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DownloadGames</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_PrepConverge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckBeer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_BeerEnough</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BuyBeer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_PartyReadyJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_EnjoyParty</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_PlanLAN" name="Plan LAN Party">
      <bpmn:outgoing>SequenceFlow_SendInvites</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Send Invitations -->
    <bpmn:task id="Task_SendInvitations" name="Send invitations to friends">
      <bpmn:incoming>SequenceFlow_SendInvites</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CollectGames</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: Collect Game Preferences -->
    <bpmn:task id="Task_CollectGames" name="Collect game preferences">
      <bpmn:incoming>SequenceFlow_CollectGames</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PrepDiverge</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway Divergence (Date & Games Prep) -->
    <bpmn:parallelGateway id="Gw_PrepDiverge" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow_PrepDiverge</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AppointDateBranch</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CheckGamesBranch</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Branch 1: Date Scheduling Loop -->
    <bpmn:task id="Task_AppointDate" name="Appoint date for LAN party">
      <bpmn:incoming>SequenceFlow_AppointDateBranch</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckAgreementIn</bpmn:outgoing>
    </bpmn:task>

    <!-- Decision Gateway: Check Attendance -->
    <bpmn:exclusiveGateway id="Gw_CheckAgreement" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow_CheckAgreementIn</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AgreeYes</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Loop Back for Re-appointment -->
    <bpmn:task id="Task_ReAppointDate" name="Re-appoint date">
      <bpmn:incoming>SequenceFlow_AgreeNo</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckAgreementInLoop</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow for Agreement Check (Yes) -->
    <bpmn:sequenceFlow id="SequenceFlow_AgreeNo" name="Less than 8 agree">
      <bpmn:conditionExpression xsi:type="tFormalExpression"><![CDATA[attendees &lt;= 7]]></bpmn:conditionExpression>
      <bpmn:sourceRef>Gw_CheckAgreement</bpmn:sourceRef>
      <bpmn:targetRef>Task_ReAppointDate</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Sequence Flow for Agreement Check (No) - Loop Back -->
    <bpmn:sequenceFlow id="SequenceFlow_AgreeYes" name="8 or more agree">
      <bpmn:conditionExpression xsi:type="tFormalExpression"><![CDATA[attendees &gt;= 8]]></bpmn:conditionExpression>
      <bpmn:sourceRef>Gw_CheckAgreement</bpmn:sourceRef>
      <bpmn:targetRef>Gw_PrepConverge</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Loop Back Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckAgreementInLoop" name="">
       <bpmn:sourceRef>Task_ReAppointDate</bpmn:sourceRef>
      <bpmn:targetRef>Gw_CheckAgreement</bpmn:targetRef>
    </bpmn:sequenceFlow>

     <!-- Initial Check Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckAgreementIn" name="">
       <bpmn:sourceRef>Task_AppointDate</bpmn:sourceRef>
      <bpmn:targetRef>Gw_CheckAgreement</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Branch 2: Game Availability Check -->
    <bpmn:task id="Task_CheckGames" name="Check game availability">
       <bpmn:incoming>SequenceFlow_CheckGamesBranch</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GamesMissingDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Decision Gateway for Games -->
    <bpmn:exclusiveGateway id="Gw_GamesMissing" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow_GamesMissingDecision</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_DownloadGames</bpmn:outgoing>
    </bpmn:exclusiveGateway>

     <!-- Sequence Flow for Games Missing -->
    <bpmn:sequenceFlow id="SequenceFlow_GamesMissingDecision" name="">
      <bpmn:sourceRef>Task_CheckGames</bpmn:sourceRef>
       <bpmn:targetRef>Gw_GamesMissing</bpmn:targetRef>
    </bpmn:sequenceFlow>

     <!-- Task Download Games -->
    <bpmn:task id="Task_DownloadGames" name="Download missing games">
      <bpmn:incoming>SequenceFlow_YesGamesNeeded</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_GamesReadyJoin</bpmn:outgoing>
    </bpmn:task>

     <!-- Sequence Flow for Downloading -->
    <bpmn:sequenceFlow id="SequenceFlow_YesGamesNeeded" name="Missing games">
      <bpmn:conditionExpression xsi:type="tFormalExpression"><![CDATA[games_missing]]></bpmn:conditionExpression>
       <bpmn:sourceRef>Gw_GamesMissing</bpmn:sourceRef>
        <bpmn:targetRef>Task_DownloadGames</bpmn:targetRef>
    </bpmn:sequenceFlow>

     <!-- Sequence Flow for Games Ready (No missing) -->
      <bpmn:sequenceFlow id="SequenceFlow_GamesReadyJoin" name="">
       <bpmn:sourceRef>Gw_GamesMissing</bpmn:sourceRef>
        <bpmn:targetRef>Gw_PrepConverge</bpmn:targetRef>
    </bpmn:sequenceFlow>

     <!-- Parallel Gateway Convergence -->
      <bpmn:parallelGateway id="Gw_PrepConverge" gatewayDirection="Converging">
        <bpmn:incoming>SequenceFlow_AgreeYes</bpmn:incoming>
         <bpmn:incoming>SequenceFlow_GamesReadyJoin</bpmn:incoming>
          <bpmn:outgoing>SequenceFlow_CheckBeerPrep</bpmn:outgoing>
      </bpmn:parallelGateway>

    <!-- Task 3: Beer Preparation -->
     <bpmn:task id="Task_CheckBeer" name="Calculate beer requirements">
       <bpmn:incoming>SequenceFlow_CheckBeerPrep</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow_BeerEnoughDecision</bpmn:outgoing>
    </bpmn:task>

     <!-- Decision Gateway for Beer -->
      <bpmn:exclusiveGateway id="Gw_BeerEnough" gatewayDirection="Converging">
        <bpmn:incoming>SequenceFlow_BeerEnoughDecision</bpmn:incoming>
         <bpmn:outgoing>SequenceFlow_EnoughBeer</bpmn:outgoing>
      </bpmn:exclusiveGateway>

       <!-- Sequence Flow for Beer Check -->
        <bpmn:sequenceFlow id="SequenceFlow_BeerEnoughDecision" name="">
          <bpmn:sourceRef>Task_CheckBeer</bpmn:sourceRef>
           <bpmn:targetRef>Gw_BeerEnough</bpmn:targetRef>
      </bpmn:sequenceFlow>

       <!-- Task Buy Beer -->
        <bpmn:task id="Task_BuyBeer" name="Buy missing beer">
          <bpmn:incoming>SequenceFlow_NotEnoughBeer</bpmn:incoming>
           <bpmn:outgoing>SequenceFlow_PartyReadyJoinFromBuy</bpmn:outgoing>
        </bpmn:task>

         <!-- Sequence Flow for Not Enough Beer -->
          <bpmn:sequenceFlow id="SequenceFlow_NotEnoughBeer" name="Not enough beer">
            <bpmn:conditionExpression xsi:type="tFormalExpression"><![CDATA[beer_insufficient]]></bpmn:conditionExpression>
             <bpmn:sourceRef>Gw_BeerEnough</bpmn:sourceRef>
              <bpmn:targetRef>Task_BuyBeer</bpmn:targetRef>
        </bpmn:sequenceFlow>

         <!-- Sequence Flow for Enough Beer -->
          <bpmn:sequenceFlow id="SequenceFlow_EnoughBeer" name="">
            <bpmn:sourceRef>Gw_BeerEnough</bpmn:sourceRef>
             <bpmn:targetRef>Gw_PartyReadyJoin</bpmn:targetRef>
        </bpmn:sequenceFlow>

         <!-- Final Convergence for Party Start -->
          <bpmn:parallelGateway id="Gw_PartyReadyJoin" gatewayDirection="Converging">
            <bpmn:incoming>SequenceFlow_EnoughBeer</bpmn:incoming>
             <bpmn:incoming>SequenceFlow_PartyReadyJoinFromBuy</bpmn:incoming>
              <bpmn:outgoing>SequenceFlow_StartParty</bpmn:outgoing>
          </bpmn:parallelGateway>

           <!-- Sequence Flow from Buy to Join -->
            <bpmn:sequenceFlow id="SequenceFlow_PartyReadyJoinFromBuy" name="">
             <bpmn:sourceRef>Task_BuyBeer</bpmn:sourceRef>
              <bpmn:targetRef>Gw_PartyReadyJoin</bpmn:targetRef>
            </bpmn:sequenceFlow>

    <!-- End Event -->
     <bpmn:endEvent id="EndEvent_EnjoyParty" name="Enjoy LAN Party">
       <bpmn:incoming>SequenceFlow_StartParty</bpmn:incoming>
      </bpmn:endEvent>

        <!-- Sequence Flow to Start Party -->
         <bpmn:sequenceFlow id="SequenceFlow_StartParty" name="">
           <bpmn:sourceRef>Gw_PartyReadyJoin</bpmn:sourceRef>
            <bpmn:targetRef>EndEvent_EnjoyParty</bpmn:targetRef>
        </bpmn:sequenceFlow>

    <!-- Initial Sequence Flows -->
     <bpmn:sequenceFlow id="SequenceFlow_SendInvites" name="">
       <bpmn:sourceRef>StartEvent_PlanLAN</bpmn:sourceRef>
         <bpmn:targetRef>Task_SendInvitations</bpmn:targetRef>
    </bpmn:sequenceFlow>

     <bpmn:sequenceFlow id="SequenceFlow_CollectGames" name="">
       <bpmn:sourceRef>Task_SendInvitations</bpmn:sourceRef>
         <bpmn:targetRef>Task_CollectGames</bpmn:targetRef>
    </bpmn:sequenceFlow>

     <!-- Diverge Flows -->
      <bpmn:sequenceFlow id="SequenceFlow_PrepDiverge" name="">
        <bpmn:sourceRef>Gw_PrepDiverge</bpmn:sourceRef>
         <bpmn:targetRef>Task_AppointDate</bpmn:targetRef>
    </bpmn:sequenceFlow>

     <bpmn:sequenceFlow id="SequenceFlow_CheckGamesBranch" name="">
        <bpmn:sourceRef>Gw_PrepDiverge</bpmn:sourceRef>
         <bpmn:targetRef>Task_CheckGames</bpmn:targetRef>
    </bpmn:sequenceFlow>

     <!-- Beer Prep Flow -->
      <bpmn:sequenceFlow id="SequenceFlow_CheckBeerPrep" name="">
        <bpmn:sourceRef>Gw_PrepConverge</bpmn:sourceRef>
         <bpmn:targetRef>Task_CheckBeer</bpmn:targetRef>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>