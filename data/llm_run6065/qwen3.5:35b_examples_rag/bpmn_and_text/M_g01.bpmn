<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_Custom3DPrinting_01" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_3DPrintProcess_01">
    <bpmn:participant id="Participant_UserArtist_01" name="Custom Model Creation Process" processRef="Process_CustomPrinting_01"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_CustomPrinting_01" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="Start_Event_CustomModelRequest_01" name="Custom Model Request">
      <bpmn:outgoing>SequenceFlow_SendSketches_01</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Instruct Artist / Send Sketches -->
    <bpmn:task id="Task_InstructArtist_01" name="Instruct Artist &amp; Send Sketches">
      <bpmn:incoming>SequenceFlow_SendSketches_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckSatisfaction_01</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Satisfied? -->
    <bpmn:exclusiveGateway id="Gw_SatisfactionCheck_01" name="Artist Result&#10;Satisfied?" gatewayDirection="Unspecified">
      <bpmn:incoming>SequenceFlow_CheckSatisfaction_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProvideFeedback_01</bpmn:outgoing> <!-- No -->
      <bpmn:outgoing>SequenceFlow_ChooseColor_01</bpmn:outgoing>     <!-- Yes -->
    </bpmn:exclusiveGateway>

    <!-- Task: Provide Feedback (Loop) -->
    <bpmn:task id="Task_ProvideFeedback_01" name="Provide Changes&#10;to Artist">
      <bpmn:incoming>SequenceFlow_ProvideFeedback_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendSketchesLoop_01</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow for Loop -->
    <bpmn:sequenceFlow id="SequenceFlow_ProvideFeedback_01" sourceRef="Gw_SatisfactionCheck_01" targetRef="Task_ProvideFeedback_01"/>
    <bpmn:sequenceFlow id="SequenceFlow_SendSketchesLoop_01" name="" sourceRef="Task_ProvideFeedback_01" targetRef="Gw_SatisfactionCheck_01"/>

    <!-- Task: Choose Plastic Color (After Satisfaction) -->
    <bpmn:task id="Task_ChooseColor_01" name="Choose Plastic&#10;Color">
      <bpmn:incoming>SequenceFlow_ChooseColor_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckStock_01</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Have Color at Home? -->
    <bpmn:exclusiveGateway id="Gw_HaveColor_01" name="Have&#10;Color?" gatewayDirection="Unspecified">
      <bpmn:incoming>SequenceFlow_CheckStock_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OrderColor_01</bpmn:outgoing> <!-- No -->
      <bpmn:outgoing>SequenceFlow_CheckQuantity_01</bpmn:outgoing> <!-- Yes -->
    </bpmn:exclusiveGateway>

    <!-- Task: Order Color (If not at home) -->
    <bpmn:task id="Task_OrderColor_01" name="Order Plastic&#10;Color">
      <bpmn:incoming>SequenceFlow_OrderColor_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_JoinPrep_01</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Check Quantity (If at home) -->
    <bpmn:task id="Task_CheckQuantity_01" name="Check Stock&#10;Level">
      <bpmn:incoming>SequenceFlow_CheckQuantity_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_LowStockDecision_01</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Low Stock? (<100g) -->
    <bpmn:exclusiveGateway id="Gw_LowStock_01" name="Under&#10;100g?" gatewayDirection="Unspecified">
      <bpmn:incoming>SequenceFlow_LowStockDecision_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BuyMore_01</bpmn:outgoing> <!-- Yes -->
      <bpmn:outgoing>SequenceFlow_JoinPrepDirect_01</bpmn:outgoing> <!-- No (Sufficient) -->
    </bpmn:exclusiveGateway>

    <!-- Task: Buy More / Add to List (If low stock) -->
    <bpmn:task id="Task_BuyMore_01" name="Add Color&#10;to Shopping&#10;List">
      <bpmn:incoming>SequenceFlow_BuyMore_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_JoinPrepBuy_01</bpmn:outgoing>
    </bpmn:task>

    <!-- Join Point for Plastic Procurement -->
    <bpmn:exclusiveGateway id="Gw_PlasticReady_01" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow_JoinPrep_01</bpmn:outgoing>       (From Order)
      <bpmn:incoming>SequenceFlow_JoinPrepDirect_01</bpmn:outgoing>(From Sufficient Stock)
      <bpmn:incoming>SequenceFlow_JoinPrepBuy_01</bpmn:outgoing>  (From Shopping List)
      <bpmn:outgoing>SequenceFlow_StartPrintingTasks_01</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Parallel Gateway for Printing Prep -->
    <bpmn:parallelGateway id="Gw_PrepStart_01" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow_StartPrintingTasks_01</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_HeatPrinter_01</bpmn:outgoing>   (Branch 1)
      <bpmn:outgoing>SequenceFlow_GenerateGCode_01</bpmn:outgoing>(Branch 2)
    </bpmn:parallelGateway>

    <!-- Task: Heat Printer -->
    <bpmn:task id="Task_HeatPrinter_01" name="Turn on&#10;Heater &amp;&#10;Extruder">
      <bpmn:incoming>SequenceFlow_HeatPrinter_01</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_JoinPrintStart_01</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Generate G-code -->
    <bpmn:task id="Task_GenerateGCode_01" name="Generate&#10;gcode from&#10;STL">
      <bpmn:incoming>SequenceFlow_GenerateGCode_01</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_JoinPrintStart_01</bpmn:outgoing>
    </bpmn:task>

    <!-- Join Point for Printing Prep -->
    <bpmn:parallelGateway id="Gw_PrepEnd_01" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow_JoinPrintStart_01</bpmn:outgoing> (Wait, incoming) -> Correction below in XML structure.
       <!-- Correcting logic for valid sequence flow references -->
    </bpmn:parallelGateway>

    <!-- Sequence Flows Definition Block -->
    
  </bpmn:process>
  
  <bpmn:endEvent id="End_Event_ModelPrinted_01" name="Model Printed">
      <bpmn:incoming>SequenceFlow_PrintStart</bpmn:outgoing> 
       (Wait, incoming) -> Correction in final XML generation.
    </bpmn:endEvent>

  <!-- Correcting the flow logic for valid sequence flows -->
  
</definitions>