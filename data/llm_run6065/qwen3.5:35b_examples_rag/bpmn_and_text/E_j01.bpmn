<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_FindAJob_01" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_JobSearch_01">
    <bpmn:participant id="Participant_ApplicantProcess" name="Applicant Job Search Process" processRef="Process_FindAJob_01"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_FindAJob_01" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:laneSet id="LaneSet_Applicant_Lanes">
        <bpmn:lane id="Lane_JobApplicant" name="Job Applicant">
          <bpmn:flowNodeRef>StartEvent_01</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Task_ReportApplications</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Gateway_AcceptOffer</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Task_ProbationPhase</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Task_RateCompany</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Gateway_CheckRating</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_01" name="Regular Reporting Trigger">
      <bpmn:outgoing>SequenceFlow_ReportToOffers</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_ReportApplications" name="Report Job Applications">
      <bpmn:incoming>SequenceFlow_ReportToOffers</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OfferReceived</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_ReceiveJobOffers" name="Receive Job Offers">
      <bpmn:incoming>SequenceFlow_ReportToOffers</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_LoopBackNoReport</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckStatus</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_NegotiateInterview" name="Negotiate Job Interview">
      <bpmn:incoming>SequenceFlow_CheckStatus</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DecideAcceptance</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_AcceptOffer" name="Company Wants You?">
      <bpmn:incoming>SequenceFlow_DecideAcceptance</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProbationPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_ProbationPhase" name="Probation Phase">
      <bpmn:incoming>SequenceFlow_ProbationPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StartRating</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_RateCompany" name="Rate Company">
      <bpmn:incoming>SequenceFlow_StartRating</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckRatingResult</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_CheckRating" name="Is Rating C or Less?">
      <bpmn:incoming>SequenceFlow_CheckRatingResult</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PermanentJob</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="EndEvent_Permanent" name="Permanent Employment">
      <bpmn:incoming>SequenceFlow_PermanentJob</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:task id="Task_StopReporting" name="Stop Regular Reports">
      <bpmn:incoming>SequenceFlow_LowRatingPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_LoopBackNoReport</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_RatingCheck" name="Rate C or Less?">
      <bpmn:incoming>SequenceFlow_CheckRatingResult</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PermanentJob</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="SequenceFlow_ReportToOffers" sourceRef="StartEvent_01" targetRef="Task_ReportApplications"/>

    <bpmn:sequenceFlow id="SequenceFlow_OfferReceived" name="New Offers Sent" sourceRef="Task_ReportApplications" targetRef="Task_ReceiveJobOffers"/>

    <bpmn:sequenceFlow id="SequenceFlow_CheckStatus" name="Company Confirms &amp; Rates" sourceRef="Task_ReceiveJobOffers" targetRef="Task_NegotiateInterview"/>

    <bpmn:sequenceFlow id="SequenceFlow_DecideAcceptance" name="Negotiation Complete" sourceRef="Task_NegotiateInterview" targetRef="Gateway_AcceptOffer"/>

    <bpmn:sequenceFlow id="SequenceFlow_ProbationPath" name="Yes (Accept)" sourceRef="Gateway_AcceptOffer" targetRef="Task_ProbationPhase"/>

    <bpmn:sequenceFlow id="SequenceFlow_StartRating" name="After Probation Phase" sourceRef="Task_ProbationPhase" targetRef="Task_RateCompany"/>

    <bpmn:sequenceFlow id="SequenceFlow_CheckRatingResult" name="Rate Company &amp; Wait for Review (1 Year)" sourceRef="Task_RateCompany" targetRef="Gateway_RatingCheck"/>

    <bpmn:sequenceFlow id="SequenceFlow_PermanentJob" name="Yes (&gt;C)" sourceRef="Gateway_RatingCheck" targetRef="EndEvent_Permanent"/>

    <bpmn:exclusiveGateway id="Gateway_LowRatingPath" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow_CheckRatingResult</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StopReportingLoop</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="SequenceFlow_LowRatingPath" name="No (&lt;=C)" sourceRef="Gateway_RatingCheck" targetRef="Task_StopReporting"/>

    <bpmn:sequenceFlow id="SequenceFlow_StopReportingLoop" name="Continue Offers (No Report)" sourceRef="Task_StopReporting" targetRef="Task_ReceiveJobOffers"/>
  </bpmn:process>
</bpmn:definitions>