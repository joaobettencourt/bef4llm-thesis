<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_WorkAccident_01" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_Work_Accident_01">
    <bpmn:participant id="Participant_Work_Accident_Process" name="Work Accident Reporting &amp; Handling Process" processRef="Process_WorkAccident_01" />
  </bpmn:collaboration>

  <bpmn:process id="Process_WorkAccident_01" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Work_Accident_01">
      <bpmn:lane id="Lane_Employee_Schools" name="Employee / School / Self-Employed">
        <bpmn:flowNodeRef>StartEvent_IncidentDetected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReportToEmployer</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Employers_Authorities" name="Employer / Educational Facility">
        <bpmn:flowNodeRef>Gateway_SeverityCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReportToInspectorate</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Insurance_Providers" name="Accident Insurance Provider / Private Insurer">
        <bpmn:flowNodeRef>Gateway_AbsenceCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReportToProvider</bpmn:flowNodeRef>
      </bpmn:lane>

       <bpmn:lane id="Lane_Information_Gathering" name="Accident Assessment">
         <bpmn:flowNodeRef>Gateway_WorkAccidentCheck</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Task_VerifyCircumstances</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_IncidentDetected" name="Incident Detected / Reported">
       <bpmn:outgoing>SequenceFlow_ReportToEmployer</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Employee Reporting Task -->
     <bpmn:task id="Task_ReportToEmployer" name="Report Accident to Employer / School">
       <bpmn:incoming>SequenceFlow_ReportToEmployer</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow_EmployerReceivesInfo</bpmn:outgoing>
    </bpmn:task>

     <!-- Flow to Employer -->
      <bpmn:sequenceFlow id="SequenceFlow_ReportToEmployer" sourceRef="StartEvent_IncidentDetected" targetRef="Task_ReportToEmployer">
        <bpmn:name>Immediate Reporting</bpmn:name>
       </bpmn:sequenceFlow>

    <!-- Flow to Employer Lane -->
     <bpmn:sequenceFlow id="SequenceFlow_EmployerReceivesInfo" sourceRef="Task_ReportToEmployer" targetRef="Gateway_SeverityCheck">
        <bpmn:name>Information Transferred</bpmn:name>
       </bpmn:sequenceFlow>

    <!-- Severity Check Gateway -->
     <bpmn:exclusiveGateway id="Gateway_SeverityCheck" name="Fatality or Serious Injury?">
      <bpmn:incoming>SequenceFlow_EmployerReceivesInfo</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_ReportInspectorateYes</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow_AbsenceCheckNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

     <!-- Report to Inspectorate -->
      <bpmn:task id="Task_ReportToInspectorate" name="Report Fatality/Serious Injury">
       <bpmn:incoming>SequenceFlow_ReportInspectorateYes</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow_ToInsuranceProviderCheck</bpmn:outgoing>
    </bpmn:task>

     <!-- Flow to Inspectorate -->
      <bpmn:sequenceFlow id="SequenceFlow_ReportInspectorateYes" sourceRef="Gateway_SeverityCheck" targetRef="Task_ReportToInspectorate">
        <bpmn:name>Immediate Reporting</bpmn:name>
       </bpmn:sequenceFlow>

    <!-- Flow to Insurance Provider Check -->
     <bpmn:sequenceFlow id="SequenceFlow_ToInsuranceProviderCheck" sourceRef="Task_ReportToInspectorate" targetRef="Gateway_AbsenceCheck">
        <bpmn:name>Proceed</bpmn:name>
       </bpmn:sequenceFlow>

    <!-- Absence Check Gateway -->
     <bpmn:exclusiveGateway id="Gateway_AbsenceCheck" name="Unable to work &gt;3 days?">
      <bpmn:incoming>SequenceFlow_ToInsuranceProviderCheck</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_ReportToProviderYes</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow_AssessmentNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

     <!-- Report to Provider -->
      <bpmn:task id="Task_ReportToProvider" name="Report Accident (Within 5 Days)">
       <bpmn:incoming>SequenceFlow_ReportToProviderYes</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow_AssessmentNo</bpmn:outgoing>
    </bpmn:task>

     <!-- Flow to Provider -->
      <bpmn:sequenceFlow id="SequenceFlow_ReportToProviderYes" sourceRef="Gateway_AbsenceCheck" targetRef="Task_ReportToProvider">
        <bpmn:name>&gt;3 Days Absence</bpmn:name>
       </bpmn:sequenceFlow>

    <!-- Assessment Gateway -->
     <bpmn:exclusiveGateway id="Gateway_WorkAccidentCheck" name="Qualifies as Work Accident?">
      <bpmn:incoming>SequenceFlow_AssessmentNo</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow_VerifyCircumstancesYes</bpmn:outgoing>
         <bpmn:outgoing>SequenceFlow_EndProcessNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

     <!-- Verify Circumstances -->
      <bpmn:task id="Task_VerifyCircumstances" name="Verify Accident Criteria (Commute, Training, etc.)">
       <bpmn:incoming>SequenceFlow_VerifyCircumstancesYes</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow_EndProcessYes</bpmn:outgoing>
    </bpmn:task>

     <!-- Flow to Verify -->
      <bpmn:sequenceFlow id="SequenceFlow_VerifyCircumstancesYes" sourceRef="Gateway_WorkAccidentCheck" targetRef="Task_VerifyCircumstances">
        <bpmn:name>Potential Work Accident</bpmn:name>
       </bpmn:sequenceFlow>

    <!-- End Event -->
     <bpmn:endEvent id="EndEvent_ProcessComplete" name="Information Gathered / Case Closed">
      <bpmn:incoming>SequenceFlow_EndProcessYes</bpmn:incoming>
        <bpmn:incoming>SequenceFlow_AssessmentNo</bpmn:incoming>
         <bpmn:incoming>SequenceFlow_EndProcessNo</bpmn:incoming>
    </bpmn:endEvent>

     <!-- Flow to End (Yes) -->
      <bpmn:sequenceFlow id="SequenceFlow_EndProcessYes" sourceRef="Task_VerifyCircumstances" targetRef="EndEvent_ProcessComplete">
        <bpmn:name>Covered</bpmn:name>
       </bpmn:sequenceFlow>

     <!-- Flow to End (No) -->
      <bpmn:sequenceFlow id="SequenceFlow_EndProcessNo" sourceRef="Gateway_WorkAccidentCheck" targetRef="EndEvent_ProcessComplete">
        <bpmn:name>Not Covered</bpmn:name>
       </bpmn:sequenceFlow>

     <!-- Flow to End (Assessment No) -->
      <bpmn:sequenceFlow id="SequenceFlow_AssessmentNo" sourceRef="Gateway_AbsenceCheck" targetRef="EndEvent_ProcessComplete">
        <bpmn:name>No Reporting Required</bpmn:name>
       </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>