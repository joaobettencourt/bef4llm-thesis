<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_CarService_01" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_Car_Service_01">
    <bpmn:participant id="Participant_CarServiceProcess" name="Car Service Process" processRef="Process_CarService_01" />
  </bpmn:collaboration>

  <bpmn:process id="Process_CarService_01" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lanelset id="LaneSet_Car_Service_01">
        <bpmn:lane id="Lane_PoliceApp" name="Police App System">
          <bpmn:flowNodeRef>StartEvent_Reminder</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Gw_CarRegistered</bpmn:flowNodeRef>
        </bpmn:lane>

        <bpmn:lane id="Lane_Customer" name="Customer">
          <bpmn:flowNodeRef>UserTask_NotifyUser</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>UserTask_PayThroughApp</bpmn:flowNodeRef>
        </bpmn:lane>

        <bpmn:lane id="Lane_ServiceFacility" name="Car Service Facility">
          <bpmn:flowNodeRef>IntermediateEvent_30DaysTimer</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>UserTask_EnterProblems</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>UserTask_ConfirmRepairSuccess</bpmn:flowNodeRef>
        </bpmn:lane>

        <bpmn:lane id="Lane_System" name="System">
          <bpmn:flowNodeRef>IntermediateEvent_EmailUpdates</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>UserTask_IssuePickerl</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:lanelset>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Reminder" name="Service Reminder">
      <bpmn:outgoing>SequenceFlow_CheckRegistration</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Registration Check Gateway -->
    <bpmn:exclusiveGateway id="Gw_CarRegistered" gatewayDirection="Diverging" name="Car Registered?">
      <bpmn:incoming>SequenceFlow_CheckRegistration</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NotifyCustomer</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Notification Task -->
    <bpmn:userTask id="UserTask_NotifyUser" name="Notify Customer">
      <bpmn:incoming>SequenceFlow_NotifyCustomer</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitForService</bpmn:outgoing>
    </bpmn:userTask>

    <!-- 30 Days Timer for Fine -->
    <bpmn:intermediateCatchEvent id="IntermediateEvent_30DaysTimer" name="Wait 30 days">
      <bpmn:incoming>SequenceFlow_WaitForService</bpmn:outgoing>
      <bpmn:timerEventDefinition timeDuration="P30D"/>
    </bpmn:intermediateCatchEvent>

    <!-- Fine Task -->
    <bpmn:userTask id="UserTask_IssueFine" name="Issue Fine">
      <bpmn:incoming>SequenceFlow_WaitForService</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_EndProcess1</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Service Facility Tasks -->
    <bpmn:userTask id="UserTask_EnterProblems" name="Enter Car Problems">
      <bpmn:incoming>SequenceFlow_ServiceArrival</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StartWaitingPeriod</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Email Updates Parallel Path -->
    <bpmn:intermediateCatchEvent id="IntermediateEvent_EmailUpdates" name="Email Status Update">
      <bpmn:incoming>SequenceFlow_WaitingStarted</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RepairComplete</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Repair Completion -->
    <bpmn:userTask id="UserTask_ConfirmRepairSuccess" name="Confirm Successful Repair">
      <bpmn:incoming>SequenceFlow_RepairComplete</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PayAndPickerl</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Payment Task -->
    <bpmn:userTask id="UserTask_PayThroughApp" name="Pay Through App">
      <bpmn:incoming>SequenceFlow_RepairComplete</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_IssuePickerlFinal</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Pickerl Task -->
    <bpmn:userTask id="UserTask_IssuePickerl" name="Issue Pickerl">
      <bpmn:incoming>SequenceFlow_PayComplete</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SetNextService</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Set Next Service -->
    <bpmn:userTask id="UserTask_SetNextService" name="Set Next Service Time">
      <bpmn:incoming>SequenceFlow_SetNextService</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndProcess2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_Fine" name="Fine Issued">
      <bpmn:incoming>SequenceFlow_EndProcess1</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_Complete" name="Service Complete">
      <bpmn:incoming>SequenceFlow_EndProcess2</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckRegistration" sourceRef="StartEvent_Reminder" targetRef="Gw_CarRegistered"/>

    <bpmn:sequenceFlow id="SequenceFlow_NotifyCustomer" name="Yes, Registered" sourceRef="Gw_CarRegistered" targetRef="UserTask_NotifyUser"/>

    <bpmn:parallelGateway id="ParallelGateway_ServiceStart" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow_WaitForService</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ServiceArrival</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:sequenceFlow id="SequenceFlow_WaitForService" sourceRef="UserTask_NotifyUser" targetRef="ParallelGateway_ServiceStart"/>

    <bpmn:sequenceFlow id="SequenceFlow_IssueFinePath" name="No Service After 30 Days" sourceRef="IntermediateEvent_30DaysTimer" targetRef="UserTask_IssueFine"/>

    <bpmn:parallelGateway id="ParallelGateway_WaitingStart" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow_ServiceArrival</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_StartWaitingPeriod</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:sequenceFlow id="SequenceFlow_ServiceArrival" sourceRef="ParallelGateway_ServiceStart" targetRef="UserTask_EnterProblems"/>

    <bpmn:sequenceFlow id="SequenceFlow_StartWaitingPeriod" name="Service Started" sourceRef="UserTask_EnterProblems" targetRef="IntermediateEvent_EmailUpdates"/>

    <!-- Payment and Pickerl Flow -->
    <bpmn:parallelGateway id="ParallelGateway_RepairComplete" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow_RepairComplete</bpmn:outgoing>
      <bpmn:incoming>SequenceFlow_PaymentReady</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:sequenceFlow id="SequenceFlow_RepairComplete" sourceRef="IntermediateEvent_EmailUpdates" targetRef="ParallelGateway_RepairComplete"/>

    <bpmn:sequenceFlow id="SequenceFlow_PaymentReady" name="Repair Done - Ready to Pay" sourceRef="UserTask_ConfirmRepairSuccess" targetRef="ParallelGateway_RepairComplete"/>

    <!-- Payment and Pickerl Sequence -->
    <bpmn:parallelGateway id="ParallelGateway_Finalize" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow_PayAndPickerl</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_IssuePickerlFinal</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:sequenceFlow id="SequenceFlow_PayComplete" sourceRef="UserTask_ConfirmRepairSuccess" targetRef="ParallelGateway_Finalize"/>

    <bpmn:sequenceFlow id="SequenceFlow_IssuePickerlFinal" name="Pay Complete - Issue Pickerl" sourceRef="UserTask_PayThroughApp" targetRef="UserTask_IssuePickerl"/>

    <!-- Final Service Setup -->
    <bpmn:parallelGateway id="ParallelGateway_SetNextService" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow_SetNextService</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:sequenceFlow id="SequenceFlow_EndProcess1" sourceRef="UserTask_IssueFine" targetRef="EndEvent_Fine"/>

    <!-- Final End Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_SetNextServiceFinal" name="Set Next Service Time" sourceRef="UserTask_SetNextService" targetRef="EndEvent_Complete"/>

  </bpmn:process>
</bpmn:definitions>