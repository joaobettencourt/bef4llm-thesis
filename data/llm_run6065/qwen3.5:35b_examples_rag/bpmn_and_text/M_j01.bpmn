<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Chainsaw_01" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_Chainsaw_Manufacturing">
    <bpmn:participant id="Participant_SalesProcess" name="Chainsaw Manufacturing Process" processRef="Process_Chainsaw_01" />
  </bpmn:collaboration>

  <bpmn:process id="Process_Chainsaw_01" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="Start_Event_OrderReceived" name="Receive Order (Properties)">
      <bpmn:outgoing>SequenceFlow_DetermineParts</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Determine Parts based on properties -->
    <bpmn:task id="Task_Determine_Parts" name="Determine Required Parts">
      <bpmn:incoming>SequenceFlow_DetermineParts</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OrderStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway for Ordering (Various Sources) -->
    <bpmn:parallelGateway id="Parallel_Gateway_Orders" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow_OrderStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Order_Bar</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_Order_Chain</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_Order_Motor</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Parallel Tasks for Ordering Parts -->
    <bpmn:task id="Task_Order_Bar" name="Order Guide Bar">
      <bpmn:incoming>SequenceFlow_Order_Bar</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Arrival_Converge_1</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_Order_Chain" name="Order Chain">
      <bpmn:incoming>SequenceFlow_Order_Chain</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Arrival_Converge_2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_Order_Motor" name="Order Motor/Engine">
      <bpmn:incoming>SequenceFlow_Order_Motor</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Arrival_Converge_3</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway for Parts Arrival -->
    <bpmn:parallelGateway id="Parallel_Gateway_PartsArrived" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow_Arrival_Converge_1</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_Arrival_Converge_2</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_Arrival_Converge_3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StartInspection</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Inspection Task -->
    <bpmn:task id="Task_Inspect_Parts" name="Manual Inspection of Parts">
      <bpmn:incoming>SequenceFlow_StartInspection</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AssemblyStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Production Phase with Updates -->
    <!-- Split flow for Assembly and Regular Customer Updates during production -->
    <bpmn:parallelGateway id="Parallel_Gateway_Production" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow_AssemblyStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Prod_1stSaw</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SendUpdate</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Produce First Saw -->
    <bpmn:task id="Task_Produce_FirstSaw" name="Produce First Chainsaw">
      <bpmn:incoming>SequenceFlow_Prod_1stSaw</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendPrototype</bpmn:outgoing>
    </bpmn:task>

    <!-- Task/Activity: Send Updates (Parallel to production) -->
    <bpmn:task id="Task_Send_Updates" name="Send Regular Production Updates">
      <bpmn:incoming>SequenceFlow_SendUpdate</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Update_Converge</bpmn:outgoing>
    </bpmn:task>

    <!-- Converging Gateway for Production Phase -->
    <bpmn:parallelGateway id="Parallel_Gateway_ProductionEnd" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow_SendPrototype</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_Update_Converge</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DecisionFeedback</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Decision Gateway -->
    <bpmn:exclusiveGateway id="Exclusive_Gateway_CustomerLikes" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow_DecisionFeedback</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProduceRest_Yes</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_Cancel_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Yes Path -->
    <bpmn:task id="Task_Produce_Rest" name="Produce Rest of Order">
      <bpmn:incoming>SequenceFlow_ProduceRest_Yes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_End_Success</bpmn:outgoing>
    </bpmn:task>

    <!-- No Path -->
    <bpmn:endEvent id="End_Event_Cancelled" name="Order Cancelled">
       <bpmn:incoming>SequenceFlow_Cancel_No</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Success End Event -->
    <bpmn:endEvent id="End_Event_Success" name="Production Complete">
      <bpmn:incoming>SequenceFlow_End_Success</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows Definitions -->
    <bpmn:sequenceFlow id="SequenceFlow_DetermineParts" sourceRef="Start_Event_OrderReceived" targetRef="Task_Determine_Parts" />
    
    <bpmn:sequenceFlow id="SequenceFlow_OrderStart" sourceRef="Task_Determine_Parts" targetRef="Parallel_Gateway_Orders" />

    <bpmn:sequenceFlow id="SequenceFlow_Order_Bar" sourceRef="Parallel_Gateway_Orders" targetRef="Task_Order_Bar" />
    <bpmn:sequenceFlow id="SequenceFlow_Order_Chain" sourceRef="Parallel_Gateway_Orders" targetRef="Task_Order_Chain" />
    <bpmn:sequenceFlow id="SequenceFlow_Order_Motor" sourceRef="Parallel_Gateway_Orders" targetRef="Task_Order_Motor" />

    <bpmn:sequenceFlow id="SequenceFlow_Arrival_Converge_1" sourceRef="Task_Order_Bar" targetRef="Parallel_Gateway_PartsArrived" />
    <bpmn:sequenceFlow id="SequenceFlow_Arrival_Converge_2" sourceRef="Task_Order_Chain" targetRef="Parallel_Gateway_PartsArrived" />
    <bpmn:sequenceFlow id="SequenceFlow_Arrival_Converge_3" sourceRef="Task_Order_Motor" targetRef="Parallel_Gateway_PartsArrived" />

    <bpmn:sequenceFlow id="SequenceFlow_StartInspection" sourceRef="Parallel_Gateway_PartsArrived" targetRef="Task_Inspect_Parts" />
    
    <bpmn:sequenceFlow id="SequenceFlow_AssemblyStart" sourceRef="Task_Inspect_Parts" targetRef="Parallel_Gateway_Production" />

    <bpmn:sequenceFlow id="SequenceFlow_Prod_1stSaw" sourceRef="Parallel_Gateway_Production" targetRef="Task_Produce_FirstSaw" />
    <bpmn:sequenceFlow id="SequenceFlow_SendUpdate" sourceRef="Parallel_Gateway_Production" targetRef="Task_Send_Updates" />

    <bpmn:sequenceFlow id="SequenceFlow_SendPrototype" sourceRef="Task_Produce_FirstSaw" targetRef="Parallel_Gateway_ProductionEnd" />
    <bpmn:sequenceFlow id="SequenceFlow_Update_Converge" sourceRef="Task_Send_Updates" targetRef="Parallel_Gateway_ProductionEnd" />

    <bpmn:sequenceFlow id="SequenceFlow_DecisionFeedback" sourceRef="Parallel_Gateway_ProductionEnd" targetRef="Exclusive_Gateway_CustomerLikes" name="Send Prototype to Customer">
      <!-- Note: The label is on the flow, but logically this represents sending prototype -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ProduceRest_Yes" sourceRef="Exclusive_Gateway_CustomerLikes" targetRef="Task_Produce_Rest">
      <!-- Label "Customer Likes It?" on Gateway, Flow label "Yes" -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_Cancel_No" sourceRef="Exclusive_Gateway_CustomerLikes" targetRef="End_Event_Cancelled">
       <!-- Label "No" or similar implied by logic -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_End_Success" sourceRef="Task_Produce_Rest" targetRef="End_Event_Success" />

  </bpmn:process>
</bpmn:definitions>