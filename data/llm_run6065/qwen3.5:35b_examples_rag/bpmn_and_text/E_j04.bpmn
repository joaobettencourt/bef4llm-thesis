<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Internship_01" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_Internship_01">
    <bpmn:participant id="Participant_EGovernmentSystem" name="E-Government Internship Process" processRef="Process_Internship_01"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Internship_01" isExecutable="false">
    <bpmn:startEvent id="StartEvent_ApplyInternship" name="Apply for Internship">
      <bpmn:outgoing>SequenceFlow_EnterDetails</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="UserTask_EnterDetails" name="Enter Topic, Money, Experience &amp; Hobbies">
      <bpmn:incoming>SequenceFlow_EnterDetails</bpmn:incomming>
      <bpmn:outgoing>SequenceFlow_WaitForOffers</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:parallelGateway id="ParallelGateway_Offers" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow_WaitForOffers</bpmn:incomming>
      <bpmn:outgoing>SequenceFlow_ReceiveOffer1</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:userTask id="UserTask_AcceptDeny" name="Accept or Deny Offer">
      <bpmn:incoming>SequenceFlow_ReceiveOffer1</bpmn:incomming>
      <bpmn:outgoing>SequenceFlow_DecideInternship</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="ExclusiveGateway_Accept" gatewayDirection="Diverging">
      <bpmn:name/>
      <bpmn:incoming>SequenceFlow_DecideInternship</bpmn:incomming>
      <bpmn:outgoing>SequenceFlow_DenyOfferLoop</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_StartInternshipPhase</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="UserTask_WriteUpdate" name="Write Status Update">
      <bpmn:name/>
      <bpmn:incoming>SequenceFlow_UserLoopBack</bpmn:incomming>
      <bpmn:outgoing>SequenceFlow_CheckUpdatesCount</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="ExclusiveGateway_UpdateCount" gatewayDirection="Diverging">
      <bpmn:name/>
      <bpmn:incoming>SequenceFlow_CheckUpdatesCount</bpmn:incomming>
      <bpmn:outgoing>SequenceFlow_UserLoopBack</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ConvergeInternshipEnd1</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="UserTask_CompanyReview" name="Company Review User">
      <bpmn:name/>
      <bpmn:incoming>SequenceFlow_CompLoopBack</bpmn:incomming>
      <bpmn:outgoing>SequenceFlow_CheckCompCount</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="ExclusiveGateway_ReviewCount" gatewayDirection="Diverging">
      <bpmn:name/>
      <bpmn:incoming>SequenceFlow_CheckCompCount</bpmn:incomming>
      <bpmn:outgoing>SequenceFlow_CompLoopBack</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ConvergeInternshipEnd2</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="UserTask_Tweet1" name="Tweet Recommendation 1">
      <bpmn:name/>
      <bpmn:incoming>SequenceFlow_StartTwitterParallel</bpmn:incomming>
      <bpmn:outgoing>SequenceFlow_ConvergeEnd1</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="UserTask_Tweet2" name="Tweet Recommendation 2">
      <bpmn:name/>
      <bpmn:incoming>SequenceFlow_StartTwitterParallel</bpmn:incomming>
      <bpmn:outgoing>SequenceFlow_ConvergeEnd2</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndEvent_InternshipFinished" name="Internship Finished">
      <bpmn:name/>
      <bpmn:incoming>SequenceFlow_EndProcess</bpmn:incomming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_EnterDetails" sourceRef="StartEvent_ApplyInternship" targetRef="UserTask_EnterDetails"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_WaitForOffers" name="" sourceRef="UserTask_EnterDetails" targetRef="ParallelGateway_Offers"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ReceiveOffer1" name="" sourceRef="ParallelGateway_Offers" targetRef="UserTask_AcceptDeny"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_DecideInternship" name="" sourceRef="UserTask_AcceptDeny" targetRef="ExclusiveGateway_Accept"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_DenyOfferLoop" name="Deny Offer" sourceRef="ExclusiveGateway_Accept" targetRef="ParallelGateway_Offers"/>
    
    <bpmn:parallelGateway id="ParallelGateway_InternshipStart" gatewayDirection="Diverging">
      <bpmn:name/>
      <bpmn:incoming>SequenceFlow_StartInternshipPhase</bpmn:incomming>
      <bpmn:outgoing>SequenceFlow_UserUpdatesLoop</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CompanyReviewsLoop</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:sequenceFlow id="SequenceFlow_StartInternshipPhase" name="Accept Offer" sourceRef="ExclusiveGateway_Accept" targetRef="ParallelGateway_InternshipStart"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_UserUpdatesLoop" name="" sourceRef="ParallelGateway_InternshipStart" targetRef="UserTask_WriteUpdate"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_CheckUpdatesCount" name="" sourceRef="UserTask_WriteUpdate" targetRef="ExclusiveGateway_UpdateCount"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_UserLoopBack" name="" sourceRef="ExclusiveGateway_UpdateCount" targetRef="UserTask_WriteUpdate"/>
    
    <bpmn:parallelGateway id="ParallelGateway_InternshipConverge1" gatewayDirection="Converging">
      <bpmn:name/>
      <bpmn:incoming>SequenceFlow_ConvergeInternshipEnd1</bpmn:incomming>
      <bpmn:outgoing>SequenceFlow_StartTwitterParallel</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:sequenceFlow id="SequenceFlow_CompanyReviewsLoop" name="" sourceRef="ParallelGateway_InternshipStart" targetRef="UserTask_CompanyReview"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_CheckCompCount" name="" sourceRef="UserTask_CompanyReview" targetRef="ExclusiveGateway_ReviewCount"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_CompLoopBack" name="" sourceRef="ExclusiveGateway_ReviewCount" targetRef="UserTask_CompanyReview"/>
    
    <bpmn:parallelGateway id="ParallelGateway_InternshipConverge2" gatewayDirection="Converging">
      <bpmn:name/>
      <bpmn:incoming>SequenceFlow_ConvergeInternshipEnd2</bpmn:incomming>
      <bpmn:outgoing>SequenceFlow_StartTwitterParallel</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:sequenceFlow id="SequenceFlow_ConvergeInternshipEnd1" name="" sourceRef="ExclusiveGateway_UpdateCount" targetRef="ParallelGateway_InternshipConverge1"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ConvergeInternshipEnd2" name="" sourceRef="ExclusiveGateway_ReviewCount" targetRef="ParallelGateway_InternshipConverge2"/>

    <!-- Twitter Parallel Tweets -->
    <bpmn:parallelGateway id="ParallelGateway_TwitterStart" gatewayDirection="Diverging">
      <bpmn:name/>
      <bpmn:incoming>SequenceFlow_StartTwitterParallel</bpmn:incomming>
      <bpmn:outgoing>SequenceFlow_SendTweet1</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SendTweet2</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:sequenceFlow id="SequenceFlow_StartTwitterParallel" name="" sourceRef="ParallelGateway_InternshipConverge1" targetRef="ParallelGateway_TwitterStart"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_SendTweet1" name="" sourceRef="ParallelGateway_TwitterStart" targetRef="UserTask_Tweet1"/>
    
    <bpmn:parallelGateway id="ParallelGateway_EndConverge" gatewayDirection="Converging">
      <bpmn:name/>
      <bpmn:incoming>SequenceFlow_ConvergeEnd1</bpmn:incomming>
      <bpmn:outgoing>SequenceFlow_SendTweet2ToConverge</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:sequenceFlow id="SequenceFlow_ConvergeEnd1" name="" sourceRef="UserTask_Tweet1" targetRef="ParallelGateway_EndConverge"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_SendTweet2ToConverge" name="" sourceRef="UserTask_Tweet2" targetRef="ParallelGateway_EndConverge"/>

    <!-- Final End Flow -->
    <bpmn:parallelGateway id="ParallelGateway_FinalEnd" gatewayDirection="Diverging">
      <bpmn:name/>
      <bpmn:incoming>SequenceFlow_SendTweet1ToFinal</bpmn:incomming>
      <bpmn:outgoing>SequenceFlow_EndProcess</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:sequenceFlow id="SequenceFlow_ConvergeEnd2" name="" sourceRef="UserTask_Tweet2" targetRef="ParallelGateway_FinalEnd"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_SendTweet1ToFinal" name="" sourceRef="ParallelGateway_EndConverge" targetRef="ParallelGateway_FinalEnd"/>

    <bpmn:sequenceFlow id="SequenceFlow_EndProcess" name="" sourceRef="ParallelGateway_FinalEnd" targetRef="EndEvent_InternshipFinished"/>
  </bpmn:process>
</bpmn:definitions>