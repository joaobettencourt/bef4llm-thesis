<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_LuxuryAirplane_01" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_Airplane_Manufacturing_01">
    <bpmn:participant id="Participant_SalesProcess" name="Luxury Airplane Manufacturing Process" processRef="Process_LuxuryAirplane_01"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_LuxuryAirplane_01" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_SalesDepartment" name="Sales Department">
        <bpmn:flowNodeRef>StartEvent_OrderReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CollectSpecifications</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Logistics" name="Logistics &amp; Scheduling">
        <bpmn:flowNodeRef>ParallelGateway_SendRequirements</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendRussianTeam</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendIrishTeam</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Manufacturing" name="Manufacturing Teams">
        <bpmn:flowNodeRef>ParallelGateway_ManufactureParts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RussianTeam_VodkaBar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IrishTeam_WhiskeyBar</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Assembly" name="Assembly Team">
        <bpmn:flowNodeRef>InclusiveGateway_InteriorAssembly</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InteriorAssembly</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_QualityTesting" name="Quality Testing">
        <bpmn:flowNodeRef>ParallelGateway_TestFlightPrep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TestFlight</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Delivery" name="Delivery &amp; Customer Service">
        <bpmn:flowNodeRef>InclusiveGateway_SendProtocols</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateTestProtocol</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Customer" name="Customer">
        <bpmn:flowNodeRef>EndEvent_ConfirmationReceived</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_OrderReceived" name="Order Received">
      <bpmn:outgoing>SequenceFlow_StartToSpecs</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Collect Specifications Task -->
    <bpmn:task id="Task_CollectSpecifications" name="Collect Customer Specifications">
      <bpmn:incoming>SequenceFlow_StartToSpecs</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SpecsToSendRequirements</bpmn:outgoing>
    </bpmn:task>

    <!-- Send Requirements Parallel Gateway -->
    <bpmn:parallelGateway id="ParallelGateway_SendRequirements" name="Send to Teams">
      <bpmn:incoming>SequenceFlow_SpecsToSendRequirements</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToRussianTeam</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ToIrishTeam</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Russian Team Task -->
    <bpmn:task id="Task_SendRussianTeam" name="Send Requirements to Russian Team">
      <bpmn:incoming>SequenceFlow_ToRussianTeam</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RussianManufactureStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Irish Team Task -->
    <bpmn:task id="Task_SendIrishTeam" name="Send Requirements to Irish Team">
      <bpmn:incoming>SequenceFlow_ToIrishTeam</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_IrishManufactureStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Manufacturing Parallel Gateway -->
    <bpmn:parallelGateway id="ParallelGateway_ManufactureParts" name="Manufacture Parts">
      <bpmn:incoming>SequenceFlow_RussianManufactureStart</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_IrishManufactureStart</bpmn:incoming>
    </bpmn:parallelGateway>

    <!-- Russian Team Vodka Bar Manufacturing -->
    <bpmn:task id="Task_RussianTeam_VodkaBar" name="Russian Team Manufactures Vodka Bar">
      <bpmn:incoming>SequenceFlow_ManufactureVodka</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_VodkaComplete</bpmn:outgoing>
    </bpmn:task>

    <!-- Irish Team Whiskey Bar Manufacturing -->
    <bpmn:task id="Task_IrishTeam_WhiskeyBar" name="Irish Team Manufactures Whiskey Bar">
      <bpmn:incoming>SequenceFlow_ManufactureWhiskey</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WhiskeyComplete</bpmn:outgoing>
    </bpmn:task>

    <!-- Interior Assembly Inclusive Gateway -->
    <bpmn:inclusiveGateway id="InclusiveGateway_InteriorAssembly" name="All Parts Ready?">
      <bpmn:incoming>SequenceFlow_VodkaComplete</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_WhiskeyComplete</bpmn:incoming>
    </bpmn:inclusiveGateway>

    <!-- Interior Assembly Task -->
    <bpmn:task id="Task_InteriorAssembly" name="Assemble Plane Interior">
      <bpmn:incoming>SequenceFlow_AssemblyStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AssemblyCompleteToTestFlight</bpmn:outgoing>
    </bpmn:task>

    <!-- Test Flight Preparation Parallel Gateway -->
    <bpmn:parallelGateway id="ParallelGateway_TestFlightPrep" name="Prepare for Test">
      <bpmn:incoming>SequenceFlow_AssemblyCompleteToTestFlight</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StartTestFlight</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Test Flight Task -->
    <bpmn:task id="Task_TestFlight" name="Conduct Test Flight">
      <bpmn:incoming>SequenceFlow_StartTestFlight</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FlightCompleteToProtocol</bpmn:outgoing>
    </bpmn:task>

    <!-- Create Protocol Inclusive Gateway -->
    <bpmn:inclusiveGateway id="InclusiveGateway_SendProtocols" name="Send Protocols">
      <bpmn:incoming>SequenceFlow_FlightCompleteToProtocol</bpmn:incoming>
    </bpmn:inclusiveGateway>

    <!-- Create Test Protocol Task -->
    <bpmn:task id="Task_CreateTestProtocol" name="Create Test Protocol">
      <bpmn:incoming>SequenceFlow_ProtocolStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProtocolsReadyToDelivery</bpmn:outgoing>
    </bpmn:task>

    <!-- Delivery Parallel Gateway -->
    <bpmn:parallelGateway id="ParallelGateway_DeliveryPrep" name="Prepare for Delivery">
      <bpmn:incoming>SequenceFlow_ProtocolsReadyToDelivery</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendProtocolsInternal</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Send Protocols to Customer Task -->
    <bpmn:task id="Task_SendProtocolsToCustomer" name="Send Protocol to Customer">
      <bpmn:incoming>SequenceFlow_ProtocolSentInternal</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CustomerReceivesProtocol</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_ConfirmationReceived" name="Customer Confirmation Received">
      <bpmn:incoming>SequenceFlow_FinalConfirmation</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToSpecs" sourceRef="StartEvent_OrderReceived" targetRef="Task_CollectSpecifications"/>
    <bpmn:sequenceFlow id="SequenceFlow_SpecsToSendRequirements" name="Send Requirements to Teams" sourceRef="Task_CollectSpecifications" targetRef="ParallelGateway_SendRequirements"/>

    <!-- Russian Team Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_ToRussianTeam" sourceRef="ParallelGateway_SendRequirements" targetRef="Task_SendRussianTeam"/>
    <bpmn:sequenceFlow id="SequenceFlow_RussianManufactureStart" name="Vodka Bar Manufacturing Required" sourceRef="Task_SendRussianTeam" targetRef="ParallelGateway_ManufactureParts"/>

    <!-- Irish Team Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_ToIrishTeam" sourceRef="ParallelGateway_SendRequirements" targetRef="Task_SendIrishTeam"/>
    <bpmn:sequenceFlow id="SequenceFlow_IrishManufactureStart" name="Whiskey Bar Manufacturing Required" sourceRef="Task_SendIrishTeam" targetRef="ParallelGateway_ManufactureParts"/>

    <!-- Manufacturing Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_ManufactureVodka" sourceRef="ParallelGateway_ManufactureParts" targetRef="Task_RussianTeam_VodkaBar"/>
    <bpmn:sequenceFlow id="SequenceFlow_ManufactureWhiskey" sourceRef="ParallelGateway_ManufactureParts" targetRef="Task_IrishTeam_WhiskeyBar"/>

    <!-- Assembly Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_VodkaComplete" name="Vodka Bar Complete" sourceRef="Task_RussianTeam_VodkaBar" targetRef="InclusiveGateway_InteriorAssembly"/>
    <bpmn:sequenceFlow id="SequenceFlow_WhiskeyComplete" name="Whiskey Bar Complete" sourceRef="Task_IrishTeam_WhiskeyBar" targetRef="InclusiveGateway_InteriorAssembly"/>

    <!-- Interior Assembly Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_AssemblyStart" sourceRef="InclusiveGateway_InteriorAssembly" targetRef="Task_InteriorAssembly"/>
    <bpmn:sequenceFlow id="SequenceFlow_AssemblyCompleteToTestFlight" name="All Parts Assembled" sourceRef="Task_InteriorAssembly" targetRef="ParallelGateway_TestFlightPrep"/>

    <!-- Test Flight Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_StartTestFlight" sourceRef="ParallelGateway_TestFlightPrep" targetRef="Task_TestFlight"/>
    <bpmn:sequenceFlow id="SequenceFlow_FlightCompleteToProtocol" name="Test Complete" sourceRef="Task_TestFlight" targetRef="InclusiveGateway_SendProtocols"/>

    <!-- Protocol Creation Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_ProtocolStart" sourceRef="InclusiveGateway_SendProtocols" targetRef="Task_CreateTestProtocol"/>
    <bpmn:sequenceFlow id="SequenceFlow_ProtocolsReadyToDelivery" name="Create Test Protocol" sourceRef="Task_CreateTestProtocol" targetRef="ParallelGateway_DeliveryPrep"/>

    <!-- Delivery Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_SendProtocolsInternal" name="Send to Company &amp; Customer" sourceRef="ParallelGateway_DeliveryPrep" targetRef="InclusiveGateway_SendProtocols"/>
    <bpmn:sequenceFlow id="SequenceFlow_ProtocolSentInternal" sourceRef="ParallelGateway_DeliveryPrep" targetRef="Task_SendProtocolsToCustomer"/>

    <!-- Final Confirmation Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_CustomerReceivesProtocol" name="Deliver Plane &amp; Send Protocol" sourceRef="Task_SendProtocolsToCustomer" targetRef="EndEvent_ConfirmationReceived"/>
  </bpmn:process>

</bpmn:definitions>