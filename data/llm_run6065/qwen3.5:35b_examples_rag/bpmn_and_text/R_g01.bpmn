<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_DIY_Repair_01" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_DiyRepair_01">
    <bpmn:participant id="Participant_UserProcess" name="DIY Smartphone Repair Process" processRef="Process_DIY_Repair_01" />
  </bpmn:collaboration>

  <bpmn:process id="Process_DIY_Repair_01" isExecutable="false">
    <bpmn:laneSet id="LaneSet_User_01">
      <bpmn:lane id="Lane_Customer" name="Customer / User">
        <bpmn:flowNodeRef>StartEvent_EnterInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_GetMaterialList</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_CheckInventory</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_AcquireMethod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_BorrowFromFriend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_BuyMaterialsOnline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_MergeAcquisition</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_GetInstructions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_PerformRepair</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_RepairSuccess</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_EnterInfo" name="Enter Model &amp; Issue">
      <bpmn:outgoing>SequenceFlow_StartToList</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Get Material List from Tool -->
    <bpmn:userTask id="UserTask_GetMaterialList" name="Get Materials &amp; Tools List">
      <bpmn:incoming>SequenceFlow_StartToList</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ListToInventoryCheck</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway: Check Inventory -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_CheckInventory" name="Do I have all materials?">
      <bpmn:incoming>SequenceFlow_ListToInventoryCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_HaveAll_Materials</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NeedMaterials</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Gateway: Acquisition Method -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_AcquireMethod" name="Borrow or Buy?">
      <bpmn:incoming>SequenceFlow_NeedMaterials</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BorrowPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_BuyPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Borrow from Friend -->
    <bpmn:userTask id="UserTask_BorrowFromFriend" name="Contact Friends">
      <bpmn:incoming>SequenceFlow_BorrowPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AcquireDone</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Buy Materials Online -->
    <bpmn:userTask id="UserTask_BuyMaterialsOnline" name="Buy Missing Items">
      <bpmn:incoming>SequenceFlow_BuyPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AcquireDone2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway: Merge Acquisition Paths -->
    <bpmn:parallelGateway id="ParallelGateway_MergeAcquisition" name="">
      <bpmn:incoming>SequenceFlow_HaveAll_Materials</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_AcquireDone</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GetInstructions</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Get Instructions -->
    <bpmn:userTask id="UserTask_GetInstructions" name="Receive Repair Instructions">
      <bpmn:incoming>SequenceFlow_GetInstructions</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DoRepair</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Perform DIY Repair -->
    <bpmn:userTask id="UserTask_PerformRepair" name="Perform DIY Repair">
      <bpmn:incoming>SequenceFlow_DoRepair</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckSuccess</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway: Check Success -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_RepairSuccess" name="Did it work?">
      <bpmn:incoming>SequenceFlow_CheckSuccess</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SuccessPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_FailPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event: Send Review -->
    <bpmn:endEvent id="EndEvent_Review" name="Send Review / Video">
      <bpmn:incoming>SequenceFlow_SuccessPath</bpmn:incoming>
    </bpmn:endEvent>

    <!-- End Event: Send to Expert -->
    <bpmn:endEvent id="EndEvent_Expert" name="Send to Expert">
      <bpmn:incoming>SequenceFlow_FailPath</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToList" sourceRef="StartEvent_EnterInfo" targetRef="UserTask_GetMaterialList">
      <bpmn:name><![CDATA[Enter Info]]></bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ListToInventoryCheck" sourceRef="UserTask_GetMaterialList" targetRef="ExclusiveGateway_CheckInventory">
      <bpmn:name><![CDATA[List Received]]></bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_HaveAll_Materials" name="Yes, I have all items" sourceRef="ExclusiveGateway_CheckInventory" targetRef="ParallelGateway_MergeAcquisition">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${haveMaterials}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_NeedMaterials" name="No, need to acquire" sourceRef="ExclusiveGateway_CheckInventory" targetRef="ExclusiveGateway_AcquireMethod">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!haveMaterials}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_BorrowPath" name="Borrow from friend" sourceRef="ExclusiveGateway_AcquireMethod" targetRef="UserTask_BorrowFromFriend">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${canBorrow}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_BuyPath" name="Buy online" sourceRef="ExclusiveGateway_AcquireMethod" targetRef="UserTask_BuyMaterialsOnline">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!canBorrow}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_AcquireDone" sourceRef="UserTask_BorrowFromFriend" targetRef="ParallelGateway_MergeAcquisition">
      <bpmn:name><![CDATA[Borrowed]]></bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_AcquireDone2" sourceRef="UserTask_BuyMaterialsOnline" targetRef="ParallelGateway_MergeAcquisition">
      <bpmn:name><![CDATA[Bought]]></bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_GetInstructions" name="" sourceRef="ParallelGateway_MergeAcquisition" targetRef="UserTask_GetInstructions">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_DoRepair" name="" sourceRef="UserTask_GetInstructions" targetRef="UserTask_PerformRepair">
      <bpmn:name><![CDATA[Start Repair]]></bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_CheckSuccess" name="" sourceRef="UserTask_PerformRepair" targetRef="ExclusiveGateway_RepairSuccess">
      <bpmn:name><![CDATA[Check Result]]></bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_SuccessPath" name="Yes, it worked" sourceRef="ExclusiveGateway_RepairSuccess" targetRef="EndEvent_Review">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${repairSuccessful}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_FailPath" name="No, failed" sourceRef="ExclusiveGateway_RepairSuccess" targetRef="EndEvent_Expert">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!repairSuccessful}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>