<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_RobotBurger_01" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_Burger_Seller_01">
    <bpmn:participant id="Participant_RobotProcess" name="Robotic Burger Seller Process" processRef="Process_Burger_Fulfillment_01" />
  </bpmn:collaboration>

  <bpmn:process id="Process_Burger_Fulfillment_01" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="Start_Event_OrderReceived" name="Order Received">
      <bpmn:outgoing>SequenceFlow_StartToAsk</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Ask Menu or Just Burger -->
    <bpmn:task id="Task_AskMenuChoice" name="Ask Customer&#10;Menu vs. Just Burger">
      <bpmn:incoming>SequenceFlow_StartToAsk</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AskToGwMenu</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway: Is it a Menu? -->
    <bpmn:exclusiveGateway id="Gw_IsMenu" name="Is it a menu?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow_AskToGwMenu</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_YesPath_Menu</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoPath_BurgerOnly</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Yes Path (Menu): Parallel Drink Prep and Side Selection -->
    <bpmn:parallelGateway id="Gw_MenuParallel" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow_YesPath_Menu</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TaskDrinkPrep</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SideSelectionAsk</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Prepare Drink -->
    <bpmn:task id="Task_PrepareDrink" name="Prepare&#10;Drink">
      <bpmn:incoming>SequenceFlow_TaskDrinkPrep</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DrinkToConverge</bpmn:outgoing>
    </bpmn:task>

    <!-- Task/Decision: Ask Fries or Wedges -->
    <bpmn:exclusiveGateway id="Gw_SideChoice" name="Fries&#10;or Wedges?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow_SideSelectionAsk</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PrepareFries</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PrepareWedges</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Prepare Fries -->
    <bpmn:task id="Task_PrepareFries" name="Prepare&#10;Fries">
      <bpmn:incoming>SequenceFlow_PrepareFries</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FriesToConverge</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Prepare Wedges -->
    <bpmn:task id="Task_PrepareWedges" name="Prepare&#10;Wedges">
      <bpmn:incoming>SequenceFlow_PrepareWedges</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WedgesToConverge</bpmn:outgoing>
    </bpmn:task>

    <!-- Converging Gateway for Menu Path -->
    <bpmn:parallelGateway id="Gw_MenuConverge" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow_DrinkToConverge</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_FriesToConverge</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_WedgesToConverge</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConvergeToBurgerPrep</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Prepare Burger -->
    <bpmn:task id="Task_PrepareBurger" name="Prepare&#10;Burger&#10;(Updates every 30s)">
      <bpmn:incoming>SequenceFlow_ConvergeToBurgerPrep</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BurgerToDelivery</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event: Delivery via Conveyor -->
    <bpmn:endEvent id="End_Event_Delivery" name="Order Delivered&#10;via Conveyor">
      <bpmn:incoming>SequenceFlow_BurgerToDelivery</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToAsk" sourceRef="Start_Event_OrderReceived" targetRef="Task_AskMenuChoice">
      <bpmn:name></bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_AskToGwMenu" sourceRef="Task_AskMenuChoice" targetRef="Gw_IsMenu">
      <bpmn:name></bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_YesPath_Menu" name="" sourceRef="Gw_IsMenu" targetRef="Gw_MenuParallel">
      <bpmn:name>Yes</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_NoPath_BurgerOnly" name="" sourceRef="Gw_IsMenu" targetRef="Task_PrepareBurger">
      <bpmn:name>No</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_TaskDrinkPrep" sourceRef="Gw_MenuParallel" targetRef="Task_PrepareDrink">
      <bpmn:name></bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_SideSelectionAsk" sourceRef="Gw_MenuParallel" targetRef="Gw_SideChoice">
      <bpmn:name></bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_PrepareFries" name="" sourceRef="Gw_SideChoice" targetRef="Task_PrepareFries">
      <bpmn:name>Fries</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_PrepareWedges" name="" sourceRef="Gw_SideChoice" targetRef="Task_PrepareWedges">
      <bpmn:name>Wedges</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_DrinkToConverge" sourceRef="Task_PrepareDrink" targetRef="Gw_MenuConverge">
      <bpmn:name></bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_FriesToConverge" sourceRef="Task_PrepareFries" targetRef="Gw_MenuConverge">
      <bpmn:name></bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_WedgesToConverge" sourceRef="Task_PrepareWedges" targetRef="Gw_MenuConverge">
      <bpmn:name></bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ConvergeToBurgerPrep" sourceRef="Gw_MenuConverge" targetRef="Task_PrepareBurger">
      <bpmn:name></bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_BurgerToDelivery" sourceRef="Task_PrepareBurger" targetRef="End_Event_Delivery">
      <bpmn:name></bpmn:name>
    </bpmn:sequenceFlow>
  </bpmn:process>
</bpmn:definitions>