<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_RegressProcess">
    <bpmn:participant id="Participant_Sachbearbeiter" name="Sachbearbeiter Regressabwicklung" processRef="Process_RegressHandling"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_RegressHandling" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Regressmeldung erhalten">
      <bpmn:description>Meldung dass Versicherungsnehmer möglicherweise in Regress genommen werden kann</bpmn:description>
      <bpmn:outgoing>SequenceFlow_CheckPossibility</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Check Case -->
    <bpmn:userTask id="Task_1" name="Fall prüfen">
      <bpmn:description>Möglichkeit der Regressnahme überprüfen</bpmn:description>
      <bpmn:incoming>SequenceFlow_CheckPossibility</bpmn:outgoing>
      <bpmn:outgoing>Gateway_PossibilityExists</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Exclusive Gateway: Possibility Exists? -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_1" name="Möglichkeit besteht?">
      <bpmn:description>Determines if regressive claim possibility actually exists</bpmn:description>
      <bpmn:incoming>SequenceFlow_CheckPossibility</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoPossibility</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_YesPossibility</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Send Payment Request -->
    <bpmn:userTask id="Task_2" name="Zahlungsaufforderung senden">
      <bpmn:description>Zahlungsaufforderung an Versicherungsnehmer versenden</bpmn:description>
      <bpmn:incoming>SequenceFlow_YesPossibility</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Set for Follow-up -->
    <bpmn:userTask id="Task_3" name="Vorgang auf Wiedervorlage setzen">
      <bpmn:description>Fall für spätere Überprüfung markieren</bpmn:description>
      <bpmn:incoming>SequenceFlow_SendPaymentRequest</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Intermediate Catching Event: Money Received -->
    <bpmn:startEvent id="StartEvent_2" name="Geldeingang">
      <bpmn:description>Ereignis wenn Zahlung vom Versicherungsnehmer eingeht</bpmn:description>
      <bpmn:outgoing>SequenceFlow_MoneyReceived</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Book Receipt -->
    <bpmn:userTask id="Task_4" name="Eingang verbuchen">
      <bpmn:description>Zahlungseingang im System erfassen und buchen</bpmn:description>
      <bpmn:incoming>SequenceFlow_MoneyReceived</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Exclusive Gateway: Objection Exists? -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_2" name="Widerspruch eingegangen?">
      <bpmn:description>Determines if policyholder has objected to the claim</bpmn:description>
      <bpmn:incoming>SequenceFlow_WaitForObjectionOrDeadline</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Check Objection -->
    <bpmn:userTask id="Task_5" name="Widerspruch prüfen">
      <bpmn:description>Begründung des Widerspruchs auf Rechtfertigung überprüfen</bpmn:description>
      <bpmn:incoming>SequenceFlow_CheckObjection</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Exclusive Gateway: Objection Justified? -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_3" name="Widerspruch gerechtfertigt?">
      <bpmn:description>Determines if the objection is valid</bpmn:description>
      <bpmn:incoming>SequenceFlow_CheckObjectionResult</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Hand to Collection Agency -->
    <bpmn:userTask id="Task_6" name="An Inkasso-Dienstleister abgeben">
      <bpmn:description>Fall an externen Inkassodienstleister übergeben</bpmn:description>
      <bpmn:incoming>SequenceFlow_HandToCollectionAgency</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event: Case Closed -->
    <bpmn:endEvent id="EndEvent_1" name="Vorgang geschlossen">
      <bpmn:description>Fall erfolgreich abgeschlossen ohne weitere Maßnahmen</bpmn:description>
      <bpmn:incoming>SequenceFlow_CloseCase_NoPossibility</bpmn:outgoing>
    </bpmn:endEvent>

    <!-- End Event: Case Closed After Payment -->
    <bpmn:endEvent id="EndEvent_2" name="Vorgang nach Zahlung geschlossen">
      <bpmn:description>Fall abgeschlossen nachdem Zahlung eingegangen ist</bpmn:description>
      <bpmn:incoming>SequenceFlow_CloseCase_PaymentReceived</bpmn:outgoing>
    </bpmn:endEvent>

    <!-- End Event: Case Closed After Justified Objection -->
    <bpmn:endEvent id="EndEvent_3" name="Vorgang nach gerechtfertigtem Widerspruch geschlossen">
      <bpmn:description>Fall abgeschlossen nachdem Widerspruch als berechtigt eingestuft wurde</bpmn:description>
      <bpmn:incoming>SequenceFlow_CloseCase_JustifiedObjection</bpmn:outgoing>
    </bpmn:endEvent>

    <!-- End Event: Case Handed to Collection Agency -->
    <bpmn:endEvent id="EndEvent_4" name="Vorgang an Inkasso übergeben">
      <bpmn:description>Fall wurde zur weiteren Bearbeitung an externen Dienstleister abgegeben</bpmn:description>
      <bpmn:incoming>SequenceFlow_CloseCase_CollectionAgency</bpmn:outgoing>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckPossibility" name="" sourceRef="StartEvent_1" targetRef="Task_1">
      <bpmn:description>Hauptfluss vom Startereignis zur Fallprüfung</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- No Possibility Path -->
    <bpmn:sequenceFlow id="SequenceFlow_NoPossibility" name="nein" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_1">
      <bpmn:description>Fall wird geschlossen da keine Regressmöglichkeit besteht</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Yes Possibility Path -->
    <bpmn:sequenceFlow id="SequenceFlow_YesPossibility" name="ja" sourceRef="ExclusiveGateway_1" targetRef="Task_2">
      <bpmn:description>Fall wird weiterbearbeitet da Regressmöglichkeit besteht</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Payment Request Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_SendPaymentRequest" name="" sourceRef="Task_2" targetRef="Task_3">
      <bpmn:description>Nach Zahlungsaufforderung wird Fall auf Wiedervorlage gesetzt</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Follow-up Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_SetFollowUp" name="" sourceRef="Task_3" targetRef="ExclusiveGateway_WaitForEvents">
      <bpmn:description>Fall wird für spätere Überprüfung markiert</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Gateway for Waiting Events -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_WaitForEvents" name="Warten auf Ereignisse">
      <bpmn:description>Kombiniert verschiedene mögliche Ereignispfade nach Wiedervorlage</bpmn:description>
      <bpmn:incoming>SequenceFlow_SetFollowUp</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Money Received Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_MoneyReceived" name="" sourceRef="StartEvent_2" targetRef="Task_4">
      <bpmn:description>Zahlungseingang führt zur Verbuchung</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Book Receipt Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_CloseCase_PaymentReceived" name="" sourceRef="Task_4" targetRef="EndEvent_2">
      <bpmn:description>Nach Verbuchung wird Fall geschlossen</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Objection Received Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_WaitForObjectionOrDeadline" name="" sourceRef="ExclusiveGateway_2" targetRef="Task_5">
      <bpmn:description>Widerspruch führt zur Prüfung</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Check Objection Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckObjectionResult" name="" sourceRef="Task_5" targetRef="ExclusiveGateway_3">
      <bpmn:description>Nach Prüfung wird über Rechtfertigung entschieden</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Justified Objection Path -->
    <bpmn:sequenceFlow id="SequenceFlow_CloseCase_JustifiedObjection" name="ja, gerechtfertigt" sourceRef="ExclusiveGateway_3" targetRef="EndEvent_3">
      <bpmn:description>Fall wird geschlossen da Widerspruch berechtigt ist</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Unjustified Objection Path -->
    <bpmn:sequenceFlow id="SequenceFlow_HandToCollectionAgency" name="nein, nicht gerechtfertigt" sourceRef="ExclusiveGateway_3" targetRef="Task_6">
      <bpmn:description>Fall wird an Inkassodienstleister übergeben</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Deadline Expired Path -->
    <bpmn:sequenceFlow id="SequenceFlow_DeadlineExpired" name="" sourceRef="ExclusiveGateway_WaitForEvents" targetRef="Task_6">
      <bpmn:description>Frist abgelaufen ohne Zahlung oder Widerspruch</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Hand to Collection Agency Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_CloseCase_CollectionAgency" name="" sourceRef="Task_6" targetRef="EndEvent_4">
      <bpmn:description>Fall wurde an Inkassodienstleister übergeben</bpmn:description>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>