<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1a2b3c">
    <bpmn:participant id="Participant_ComputerHardwareShop" name="Dispatch of goods&#10;Computer Hardware Shop" processRef="Process_OrderProcessing"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_OrderProcessing" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1x59gc4">
      <bpmn:lane id="Lane_Secretary" name="Secretary">
        <bpmn:flowNodeRef>StartEvent_NewOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ClarityShipmentMethod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_SpecialHandling</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GetOffersFromLogisticsCompanies</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectAndOrderLogisticCompany</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_InsuranceNecessary</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WritePackageLabel</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_LogisticsManager" name="Logistics Manager">
        <bpmn:flowNodeRef>InclusiveGateway_InsuranceNecessary</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConcludeInsurancePolicy</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_WarehouseWorker" name="Warehouse Worker">
        <bpmn:flowNodeRef>InclusiveGateway_ParallelSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PackageGoods</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_ConvergencePoint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareForPickup</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_NewOrder" name="Ship goods">
      <bpmn:outgoing>SequenceFlow_ParallelSplit_01</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Parallel Split Gateway (Admin vs Warehouse) -->
    <bpmn:parallelGateway id="InclusiveGateway_ParallelSplit" name="Order Processing Split">
      <bpmn:incoming>SequenceFlow_ParallelSplit_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AdminWorkStart</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_WarehousePacking</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Admin Work Path (Secretary) -->
    <bpmn:task id="Task_ClarityShipmentMethod" name="Clarify shipment method">
      <bpmn:description>Determine if special handling is needed.</bpmn:description>
      <bpmn:incoming>SequenceFlow_AdminWorkStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SpecialHandlingCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Decision Gateway 1 (Large vs Small) -->
    <bpmn:exclusiveGateway id="InclusiveGateway_SpecialHandling" name="Special handling?">
      <bpmn:description>Determine if large quantity requires special shipping.</bpmn:description>
      <bpmn:incoming>SequenceFlow_SpecialHandlingCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_LargeQuantityPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SmallQuantityPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Large Quantity Path -->
    <bpmn:task id="Task_GetOffersFromLogisticsCompanies" name="Get 3 offers from logistic companies">
      <bpmn:description>Contact freight forwarders for special shipping.</bpmn:description>
      <bpmn:incoming>SequenceFlow_LargeQuantityPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SelectAndOrderLogisticCompanyStart</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_SelectAndOrderLogisticCompany" name="Select logistic company and place order">
      <bpmn:description>Select offer and contract logistics provider.</bpmn:description>
      <bpmn:incoming>SequenceFlow_SelectAndOrderLogisticCompanyStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AdminWorkConverge1</bpmn:outgoing>
    </bpmn:task>

    <!-- Small Quantity Path -->
    <bpmn:task id="Task_WritePackageLabel" name="Write package label">
      <bpmn:description>Fill out standardized shipping form.</bpmn:description>
      <bpmn:incoming>SequenceFlow_SmallQuantityPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InsuranceCheckStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Decision Gateway 2 (Insurance) -->
    <bpmn:exclusiveGateway id="InclusiveGateway_InsuranceNecessary" name="If insurance necessary">
      <bpmn:description>Determine if goods need additional insurance.</bpmn:description>
      <bpmn:incoming>SequenceFlow_InsuranceCheckStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_YesInsurance</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoInsuranceDirectly</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Insurance Task (Logistics Manager) -->
    <bpmn:task id="Task_ConcludeInsurancePolicy" name="Insure parcel">
      <bpmn:description>Conclude insurance policy with logistics manager.</bpmn:description>
      <bpmn:incoming>SequenceFlow_YesInsurance</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConcludeInsurancePolicyOut</bpmn:outgoing>
    </bpmn:task>

    <!-- Warehouse Work Path -->
    <bpmn:task id="Task_PackageGoods" name="Package goods">
      <bpmn:description>Pack the hardware items.</bpmn:description>
      <bpmn:incoming>SequenceFlow_WarehousePacking</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WarehouseConverge1</bpmn:outgoing>
    </bpmn:task>

    <!-- Convergence of Admin Paths -->
    <bpmn:exclusiveGateway id="InclusiveGateway_AdminConverge" name="Admin Work Complete">
      <bpmn:description>Merge paths from Large and Small quantity processing.</bpmn:description>
      <bpmn:incoming>SequenceFlow_SelectAndOrderLogisticCompanyOut</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ConcludeInsurancePolicyOut</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AdminWorkConverge2</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Parallel Join Gateway (Wait for Admin & Warehouse) -->
    <bpmn:parallelGateway id="InclusiveGateway_ConvergencePoint" name="All Preparations Complete">
      <bpmn:description>Synchronize admin work and packing.</bpmn:description>
      <bpmn:incoming>SequenceFlow_AdminWorkConverge2</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_WarehouseConverge1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FinalStep</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Final Task -->
    <bpmn:endEvent id="EndEvent_ShipmentPrepared" name="Shipment prepared">
      <bpmn:description>All preparations completed.</bpmn:description>
      <bpmn:incoming>SequenceFlow_FinalStep</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_ParallelSplit_01" name="" sourceRef="StartEvent_NewOrder" targetRef="InclusiveGateway_ParallelSplit">
      <bpmn:description>Main flow from start event</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Admin Split -->
    <bpmn:sequenceFlow id="SequenceFlow_AdminWorkStart" name="" sourceRef="InclusiveGateway_ParallelSplit" targetRef="Task_ClarityShipmentMethod">
      <bpmn:description>Pays the customer's order</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Warehouse Split -->
    <bpmn:sequenceFlow id="SequenceFlow_WarehousePacking" name="" sourceRef="InclusiveGateway_ParallelSplit" targetRef="Task_PackageGoods">
      <bpmn:description>Pays the customer's order</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Admin Decision -->
    <bpmn:sequenceFlow id="SequenceFlow_SpecialHandlingCheck" name="" sourceRef="Task_ClarityShipmentMethod" targetRef="InclusiveGateway_SpecialHandling">
      <bpmn:description>Pays the customer's order</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Large Path -->
    <bpmn:sequenceFlow id="SequenceFlow_LargeQuantityPath" name="" sourceRef="InclusiveGateway_SpecialHandling" targetRef="Task_GetOffersFromLogisticsCompanies">
      <bpmn:description>Pays the customer's order</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Small Path -->
    <bpmn:sequenceFlow id="SequenceFlow_SmallQuantityPath" name="" sourceRef="InclusiveGateway_SpecialHandling" targetRef="Task_WritePackageLabel">
      <bpmn:description>Pays the customer's order</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Large Path Merge -->
    <bpmn:sequenceFlow id="SequenceFlow_SelectAndOrderLogisticCompanyStart" name="" sourceRef="Task_GetOffersFromLogisticsCompanies" targetRef="Task_SelectAndOrderLogisticCompany">
      <bpmn:description>Pays the customer's order</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Small Path Merge -->
    <bpmn:sequenceFlow id="SequenceFlow_InsuranceCheckStart" name="" sourceRef="Task_WritePackageLabel" targetRef="InclusiveGateway_InsuranceNecessary">
      <bpmn:description>Pays the customer's order</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Insurance Yes -->
    <bpmn:sequenceFlow id="SequenceFlow_YesInsurance" name="" sourceRef="InclusiveGateway_InsuranceNecessary" targetRef="Task_ConcludeInsurancePolicy">
      <bpmn:description>Pays the customer's order</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Insurance No (Skip) -->
    <bpmn:sequenceFlow id="SequenceFlow_NoInsuranceDirectly" name="" sourceRef="InclusiveGateway_InsuranceNecessary" targetRef="Task_WritePackageLabel">
      <bpmn:description>Pays the customer's order</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Admin Convergence -->
    <bpmn:sequenceFlow id="SequenceFlow_SelectAndOrderLogisticCompanyOut" name="" sourceRef="Task_SelectAndOrderLogisticCompany" targetRef="InclusiveGateway_AdminConverge">
      <bpmn:description>Pays the customer's order</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Admin Convergence 2 -->
    <bpmn:sequenceFlow id="SequenceFlow_ConcludeInsurancePolicyOut" name="" sourceRef="Task_ConcludeInsurancePolicy" targetRef="InclusiveGateway_AdminConverge">
      <bpmn:description>Pays the customer's order</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Final Convergence -->
    <bpmn:sequenceFlow id="SequenceFlow_WarehouseConverge1" name="" sourceRef="Task_PackageGoods" targetRef="InclusiveGateway_ConvergencePoint">
      <bpmn:description>Pays the customer's order</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Final Step -->
    <bpmn:sequenceFlow id="SequenceFlow_AdminWorkConverge2" name="" sourceRef="InclusiveGateway_AdminConverge" targetRef="InclusiveGateway_ConvergencePoint">
      <bpmn:description>Pays the customer's order</bpmn:description>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>