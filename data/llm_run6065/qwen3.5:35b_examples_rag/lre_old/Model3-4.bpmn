<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_ClaimHandling">
    <bpmn:participant id="Participant_ClaimHandler" name="Claim Handling Process" processRef="Process_ClaimHandling"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_ClaimHandling" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="Start_Event_1" name="Send Questionnaire Request">
      <bpmn:outgoing>SequenceFlow_StartToTask</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Send Questionnaire -->
    <bpmn:task id="Task_SendQuestionnaire" name="Send questionnaire to claimant">
      <bpmn:incoming>SequenceFlow_StartToTask</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TaskToTimer</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Catch Timer Event (Wait 5 days) -->
    <bpmn:intermediateCatchEvent id="Timer_WaitDays" name="Wait for response">
      <bpmn:timerDefinition xsi:type="bpmn:TimeCycle"/>
      <bpmn:incoming>SequenceFlow_TaskToTimer</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TimerToGateway</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Exclusive Gateway -->
    <bpmn:exclusiveGateway id="Gateway_ResponseReceived" name="Response Received?">
      <bpmn:incoming>SequenceFlow_TimerToGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GatewayToEnd</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_GatewayToReminder</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event 1 -->
    <bpmn:endEvent id="End_Event_Completed" name="Questionnaire Received">
      <bpmn:incoming>SequenceFlow_GatewayToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task 2: Send Reminder -->
    <bpmn:task id="Task_SendReminder" name="Send reminder to claimant">
      <bpmn:incoming>SequenceFlow_GatewayToReminder</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ReminderBackTimer</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToTask" sourceRef="Start_Event_1" targetRef="Task_SendQuestionnaire"/>
    <bpmn:sequenceFlow id="SequenceFlow_TaskToTimer" sourceRef="Task_SendQuestionnaire" targetRef="Timer_WaitDays"/>
    <bpmn:sequenceFlow id="SequenceFlow_TimerToGateway" sourceRef="Timer_WaitDays" targetRef="Gateway_ResponseReceived"/>
    
    <!-- Flow for Yes/Completed -->
    <bpmn:sequenceFlow id="SequenceFlow_GatewayToEnd" name="Yes - Received" sourceRef="Gateway_ResponseReceived" targetRef="End_Event_Completed"/>
    
    <!-- Flow for No/Reminder -->
    <bpmn:sequenceFlow id="SequenceFlow_GatewayToReminder" name="No - Send Reminder" sourceRef="Gateway_ResponseReceived" targetRef="Task_SendReminder"/>

  </bpmn:process>
</bpmn:definitions>