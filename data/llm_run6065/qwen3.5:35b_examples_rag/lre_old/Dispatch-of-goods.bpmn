<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_ShippingProcess">
    <bpmn:participant id="Participant_OrderFulfillment" name="Order Fulfillment Process" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Secretary" name="Secretary">
        <bpmn:flowNodeRef>Task_ClariyShipping</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_LargeAmounts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InviteCompanies</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectCompany</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WriteLabel</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_LogisticsHead" name="Logistics Department Head">
        <bpmn:flowNodeRef>Task_CheckInsurance</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Warehousemen" name="Warehousemen">
        <bpmn:flowNodeRef>Task_PackageGoods</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="Start_ShipGoods" name="Ship goods">
      <bpmn:outgoing>Flow_Start</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Secretary clarifies shipping method -->
    <bpmn:userTask id="Task_ClariyShipping" name="Clarify who will do the shipping">
      <bpmn:incoming>Flow_Start</bpmn:incoming>
      <bpmn:outgoing>Flow_Decision1</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Exclusive Gateway 1: Large amounts decision -->
    <bpmn:exclusiveGateway id="Gateway_LargeAmounts" name="Large amount?">
      <bpmn:incoming>Flow_Decision1</bpmn:incoming>
      <bpmn:outgoing>Flow_SpecialShipping</bpmn:outgoing>
      <bpmn:outgoing>Flow_NormalPost</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Large Amounts Path -->
    <bpmn:userTask id="Task_InviteCompanies" name="Invite 3 logistic companies for offers">
      <bpmn:incoming>Flow_SpecialShipping</bpmn:incoming>
      <bpmn:outgoing>Flow_SelectCompany</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_SelectCompany" name="Select logistic company">
      <bpmn:incoming>Flow_SelectCompany</bpmn:incoming>
      <bpmn:outgoing>Flow_Merge1</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Normal Post Path -->
    <bpmn:userTask id="Task_WriteLabel" name="Write package label">
      <bpmn:incoming>Flow_NormalPost</bpmn:incoming>
      <bpmn:outgoing>Flow_Merge2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel Gateway for Insurance and Packaging -->
    <bpmn:parallelGateway id="Parallel_Gateway" name="Prepare in parallel">
      <bpmn:incoming>Flow_Merge1</bpmn:incoming>
      <bpmn:outgoing>Flow_InsuranceCheck</bpmn:outgoing>
      <bpmn:outgoing>Flow_PackageGoods</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Insurance Task (Logistics Head) -->
    <bpmn:userTask id="Task_CheckInsurance" name="Take parcel insurance if necessary">
      <bpmn:incoming>Flow_InsuranceCheck</bpmn:incoming>
      <bpmn:outgoing>Flow_Merge3</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Packaging Task (Warehousemen) -->
    <bpmn:userTask id="Task_PackageGoods" name="Package goods">
      <bpmn:incoming>Flow_PackageGoods</bpmn:incoming>
      <bpmn:outgoing>Flow_Merge3</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Merge Gateway -->
    <bpmn:parallelGateway id="Parallel_Gateway2" name="All ready">
      <bpmn:incoming>Flow_Merge2</bpmn:incoming>
      <bpmn:incoming>Flow_Merge3</bpmn:incoming>
      <bpmn:outgoing>Flow_PreparePickup</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Final Task -->
    <bpmn:userTask id="Task_PreparePickup" name="Prepare goods for pickup">
      <bpmn:incoming>Flow_PreparePickup</bpmn:incoming>
      <bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="End_ShipmentReady" name="Shipment prepared">
      <bpmn:incoming>Flow_End</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Flow_Start" sourceRef="Start_ShipGoods" targetRef="Task_ClariyShipping"/>
    <bpmn:sequenceFlow id="Flow_Decision1" sourceRef="Task_ClariyShipping" targetRef="Gateway_LargeAmounts"/>
    
    <!-- Large Amount Path -->
    <bpmn:sequenceFlow id="Flow_SpecialShipping" name="yes - large amount" sourceRef="Gateway_LargeAmounts" targetRef="Task_InviteCompanies"/>
    <bpmn:sequenceFlow id="Flow_SelectCompany" sourceRef="Task_InviteCompanies" targetRef="Task_SelectCompany"/>
    
    <!-- Normal Post Path -->
    <bpmn:sequenceFlow id="Flow_NormalPost" name="no - normal post" sourceRef="Gateway_LargeAmounts" targetRef="Task_WriteLabel"/>
    
    <!-- Merge after label writing and company selection -->
    <bpmn:sequenceFlow id="Flow_Merge1" sourceRef="Task_SelectCompany" targetRef="Parallel_Gateway"/>
    <bpmn:sequenceFlow id="Flow_Merge2" sourceRef="Task_WriteLabel" targetRef="Parallel_Gateway2"/>
    
    <!-- Parallel preparation -->
    <bpmn:sequenceFlow id="Flow_InsuranceCheck" name="insurance check" sourceRef="Parallel_Gateway" targetRef="Task_CheckInsurance"/>
    <bpmn:sequenceFlow id="Flow_PackageGoods" name="packaging" sourceRef="Parallel_Gateway" targetRef="Task_PackageGoods"/>
    
    <!-- Merge after parallel tasks -->
    <bpmn:sequenceFlow id="Flow_Merge3" sourceRef="Task_CheckInsurance" targetRef="Parallel_Gateway2"/>
    <bpmn:sequenceFlow id="Flow_PreparePickup" name="all ready" sourceRef="Parallel_Gateway2" targetRef="Task_PreparePickup"/>
    
    <!-- End -->
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_PreparePickup" targetRef="End_ShipmentReady"/>

  </bpmn:process>
</bpmn:definitions>