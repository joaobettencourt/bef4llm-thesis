<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                 xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" 
                 xmlns:di="http://www.omg.org/spec/DD/20100524/DI" 
                 xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" 
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:collaboration id="Collaboration_BicycleProcess">
    <bpmn:participant id="Participant_Company" name="Bicycle Manufacturing Company" processRef="Process_OrderFulfillment"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_OrderFulfillment" isExecutable="false">
    
    <!-- Lane Set -->
    <bpmn:laneSet>
      <bpmn:lane id="Lane_SalesDept" name="Sales Department">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RejectAcceptOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DecisionRejectAccept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_AcceptSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_OrderRejected</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Storehouse" name="Storehouse">
        <bpmn:flowNodeRef>Task_ProcessPartList</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Engineering" name="Engineering Department">
        <bpmn:flowNodeRef>Task_PrepareAssembly</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_MergeReady</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssembleBicycle</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Order Received">
      <bpmn:outgoing>SequenceFlow_StartToTask</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Sales Reject/Accept -->
    <bpmn:task id="Task_RejectAcceptOrder" name="Reject or Accept Order">
      <bpmn:incoming>SequenceFlow_StartToTask</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TaskToGateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Decision -->
    <bpmn:exclusiveGateway id="Gateway_DecisionRejectAccept" name="Order Accepted?">
      <bpmn:incoming>SequenceFlow_TaskToGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RejectPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_AcceptSplit</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event: Rejected -->
    <bpmn:endEvent id="EndEvent_OrderRejected" name="Order Rejected">
      <bpmn:incoming>SequenceFlow_RejectPath</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Parallel Gateway: Split to Storehouse & Engineering -->
    <bpmn:parallelGateway id="ParallelGateway_AcceptSplit" name="Inform Departments">
      <bpmn:incoming>SequenceFlow_AcceptSplit</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StorehousePath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_EngineeringPrepPath</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Storehouse Process Parts -->
    <bpmn:task id="Task_ProcessPartList" name="Process Part List &amp; Reserve">
      <bpmn:incoming>SequenceFlow_StorehousePath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StorehouseToMerge</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Engineering Prepare Assembly -->
    <bpmn:task id="Task_PrepareAssembly" name="Prepare for Assembling">
      <bpmn:incoming>SequenceFlow_EngineeringPrepPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EngToMerge</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway: Merge before Assembly -->
    <bpmn:parallelGateway id="ParallelGateway_MergeReady" name="Parts &amp; Prep Ready">
      <bpmn:incoming>SequenceFlow_StorehouseToMerge</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_EngToMerge</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AssemblyStart</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Assemble Bicycle -->
    <bpmn:task id="Task_AssembleBicycle" name="Assemble Bicycle">
      <bpmn:incoming>SequenceFlow_AssemblyStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToShipping</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Ship to Customer -->
    <bpmn:task id="Task_ShipToCustomer" name="Ship Bicycle">
      <bpmn:incoming>SequenceFlow_ToShipping</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FinalEnd</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_ProcessFinished" name="Process Finished">
      <bpmn:incoming>SequenceFlow_FinalEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToTask" sourceRef="StartEvent_1" targetRef="Task_RejectAcceptOrder"/>
    <bpmn:sequenceFlow id="SequenceFlow_TaskToGateway" sourceRef="Task_RejectAcceptOrder" targetRef="Gateway_DecisionRejectAccept"/>
    <bpmn:sequenceFlow id="SequenceFlow_RejectPath" name="No" sourceRef="Gateway_DecisionRejectAccept" targetRef="EndEvent_OrderRejected"/>
    <bpmn:sequenceFlow id="SequenceFlow_AcceptSplit" name="Yes" sourceRef="Gateway_DecisionRejectAccept" targetRef="ParallelGateway_AcceptSplit"/>
    
    <!-- Split Paths -->
    <bpmn:sequenceFlow id="SequenceFlow_StorehousePath" sourceRef="ParallelGateway_AcceptSplit" targetRef="Task_ProcessPartList"/>
    <bpmn:sequenceFlow id="SequenceFlow_EngineeringPrepPath" name="Inform Eng Dept" sourceRef="ParallelGateway_AcceptSplit" targetRef="Task_PrepareAssembly"/>

    <!-- Merge Paths -->
    <bpmn:sequenceFlow id="SequenceFlow_StorehouseToMerge" sourceRef="Task_ProcessPartList" targetRef="ParallelGateway_MergeReady"/>
    <bpmn:sequenceFlow id="SequenceFlow_EngToMerge" name="Prep Finished" sourceRef="Task_PrepareAssembly" targetRef="ParallelGateway_MergeReady"/>

    <!-- Assembly & Shipping -->
    <bpmn:sequenceFlow id="SequenceFlow_AssemblyStart" sourceRef="ParallelGateway_MergeReady" targetRef="Task_AssembleBicycle"/>
    <bpmn:sequenceFlow id="SequenceFlow_ToShipping" name="Ship to Customer" sourceRef="Task_AssembleBicycle" targetRef="Task_ShipToCustomer"/>
    <bpmn:sequenceFlow id="SequenceFlow_FinalEnd" sourceRef="Task_ShipToCustomer" targetRef="EndEvent_ProcessFinished"/>

  </bpmn:process>

</bpmn:definitions>