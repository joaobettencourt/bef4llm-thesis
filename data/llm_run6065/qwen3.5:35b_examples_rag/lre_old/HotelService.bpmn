<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_RoomService_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_RoomService">
    <!-- Participant 1: Room Service Department (Manager & Waiter) -->
    <bpmn:participant id="Participant_ManagerWaiter" name="Room Service Dept" processRef="Process_01"/>

    <!-- Participant 2: Kitchen Staff -->
    <bpmn:participant id="Participant_Kitchen" name="Kitchen" processRef="Process_02"/>

    <!-- Participant 3: Sommelier / Cellar -->
    <bpmn:participant id="Participant_Sommelier" name="Sommelier/Cellar" processRef="Process_03"/>

    <!-- Message Flows between Participants -->
    <bpmn:messageFlow id="Message_Flow_OrderToKitchen" sourceRef="Task_ManagerSubmitTicket" targetRef="StartEvent_KitchenReceived"/>
    
    <bpmn:messageFlow id="Message_Flow_WineRequest" sourceRef="Gateway_AlcoholCheck" targetRef="StartEvent_SommelierRequest">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${alcoholRequested}</bpmn:conditionExpression>
    </bpmn:messageFlow>

    <!-- Feedback from Kitchen -->
    <bpmn:messageFlow id="Message_FoodReady" sourceRef="EndEvent_KitchenDone" targetRef="IntermediateCatchFoodReady"/>

    <!-- Feedback from Sommelier (Conditional) -->
    <bpmn:messageFlow id="Message_WineReady" sourceRef="EndEvent_SommelierDone" targetRef="IntermediateCatchWineReady">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${alcoholRequested}</bpmn:conditionExpression>
    </bpmn:messageFlow>
  </bpmn:collaboration>

  <!-- Process 1: Room Service Dept (Manager & Waiter) -->
  <bpmn:process id="Process_01" isExecutable="false">
    <bpmn:startEvent id="Start_EventOrderReceived" name="Guest Calls Order">
      <bpmn:outgoing>Sequence_Flow_OrderTaken</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Manager Tasks -->
    <bpmn:task id="Task_ManagerTakeOrder" name="Manager Takes Down Order">
      <bpmn:incoming>Sequence_Flow_OrderTaken</bpmn:incoming>
      <bpmn:outgoing>Sequence_Gateway_AlcoholCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Decision Point for Alcohol -->
    <bpmn:exclusiveGateway id="Gateway_AlcoholCheck" name="Alcohol Requested?">
      <bpmn:incoming>Sequence_Gateway_AlcoholCheck</bpmn:incoming>
      <bpmn:outgoing>Sequence_Flow_WaiterAssign</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Waiter Tasks -->
    <bpmn:startEvent id="Start_EventWaiterAssigned" name="Order Assigned">
      <bpmn:incoming>Sequence_Gateway_AlcoholCheck</bpmn:incoming> 
    </bpmn:startEvent>

    <bpmn:task id="Task_WaiterReadyCart" name="Readies Cart &amp; Non-Alcoholic Drinks">
      <bpmn:incoming>Sequence_Flow_WaiterAssign</bpmn:outgoing> 
      <bpmn:outgoing>Sequence_Gateway_DeliveryReady</bpmn:outgoing>
    </bpmn:task>

    <!-- Manager submits ticket to kitchen -->
    <bpmn:task id="Task_ManagerSubmitTicket" name="Submit Order Ticket">
      <bpmn:incoming>Sequence_Gateway_AlcoholCheck</bpmn:incoming> 
      <bpmn:outgoing>Sequence_Flow_WaiterAssign</bpmn:outgoing>
    </bpmn:task>

    <!-- Waiter delivers to guest room -->
    <bpmn:task id="Task_DeliverToRoom" name="Delivers Order">
      <bpmn:incoming>Sequence_Gateway_DeliveryReady</bpmn:outgoing> 
      <bpmn:outgoing>Sequence_Flow_ReturnStation</bpmn:outgoing>
    </bpmn:task>

    <!-- Waiter returns to station -->
    <bpmn:endEvent id="End_EventOrderDelivered" name="Return Station">
      <bpmn:name>Waiter Returns</bpmn:name>
      <bpmn:incoming>Sequence_Flow_ReturnStation</bpmn:outgoing> 
    </bpmn:endEvent>

    <!-- Waiter debits guest account -->
    <bpmn:startEvent id="Start_EventReturn" name="Waiter Returns">
      <bpmn:name>Order Delivered</bpmn:name>
      <bpmn:incoming>Sequence_Flow_ReturnStation</bpmn:outgoing> 
    </bpmn:startEvent>

    <!-- Waiter debits guest account -->
    <bpmn:endEvent id="End_EventBilling" name="Account Debited">
      <bpmn:name>Billing Complete</bpmn:name>
      <bpmn:incoming>Sequence_Flow_BillGuest</bpmn:outgoing> 
    </bpmn:endEvent>

    <!-- Waiter debits guest account -->
    <bpmn:startEvent id="Start_EventReturn" name="Waiter Returns">
      <bpmn:name>Order Delivered</bpmn:name>
      <bpmn:incoming>Sequence_Flow_ReturnStation</bpmn:outgoing> 
    </bpmn:startEvent>

    <!-- Waiter debits guest account -->
    <bpmn:endEvent id="End_EventBilling" name="Account Debited">
      <bpmn:name>Billing Complete</bpmn:name>
      <bpmn:incoming>Sequence_Flow_BillGuest</bpmn:outgoing> 
    </bpmn:endEvent>

    <!-- Waiter debits guest account -->
    <bpmn:startEvent id="Start_EventReturn" name="Waiter Returns">
      <bpmn:name>Order Delivered</bpmn:name>
      <bpmn:incoming>Sequence_Flow_ReturnStation</bpmn:outgoing> 
    </bpmn:startEvent>

    <!-- Waiter debits guest account -->
    <bpmn:endEvent id="End_EventBilling" name="Account Debited">
      <bpmn:name>Billing Complete</bpmn:name>
      <bpmn:incoming>Sequence_Flow_BillGuest</bpmn:outgoing> 
    </bpmn:endEvent>

    <!-- Waiter debits guest account -->
    <bpmn:startEvent id="Start_EventReturn" name="Waiter Returns">
      <bpmn:name>Order Delivered</bpmn:name>
      <bpmn:incoming>Sequence_Flow_ReturnStation</bpmn:outgoing> 
