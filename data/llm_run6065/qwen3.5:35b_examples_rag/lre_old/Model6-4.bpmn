<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_NewClientAcquisition">
    <bpmn:participant id="Participant_CustomerAcquisition" name="Customer Acquisition Process" processRef="Process_Acquisition"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Acquisition" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_MarketingTeam" name="Marketing Team">
        <bpmn:flowNodeRef>Task_GetContactDetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_InitialDecision</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CallCenter" name="Call Center Staff">
        <bpmn:flowNodeRef>Task_InitiateContact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_InterestCheck</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_DevelopmentHead" name="Head of Development">
        <bpmn:flowNodeRef>Task_SpecialAcquisition</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SalesTeam" name="Sales &amp; Pre-sales Team">
        <bpmn:flowNodeRef>Gateway_PresentationType</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OnlinePresentation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TechnicalPresentation</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="Start_Event1" name="New Potential Customer">
      <bpmn:outgoing>Flow_StartToMarketing</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Marketing Team Tasks -->
    <bpmn:task id="Task_GetContactDetails" name="Determine Contact Details of Potential Customers">
      <bpmn:incoming>Flow_StartToMarketing</bpmn:incoming>
      <bpmn:outgoing>Flow_MarketingDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Initial Decision Gateway (How contact details obtained) -->
    <bpmn:exclusiveGateway id="Gateway_InitialDecision" name="Contact Details Source">
      <bpmn:incoming>Flow_MarketingDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_ToCallCenter</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Call Center Tasks -->
    <bpmn:task id="Task_InitiateContact" name="Start Calling Customer">
      <bpmn:incoming>Flow_ToCallCenter</bpmn:incoming>
      <bpmn:outgoing>Flow_CallToInterestCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Interest Check Gateway -->
    <bpmn:exclusiveGateway id="Gateway_InterestCheck" name="Customer Generally Interested?">
      <bpmn:incoming>Flow_CallToInterestCheck</bpmn:incoming>
      <bpmn:outgoing>Flow_SpecialAcquisition</bpmn:outgoing>
      <bpmn:outgoing>Flow_LeaveAlone</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Special Acquisition for High Budget -->
    <bpmn:task id="Task_SpecialAcquisition" name="Head of Development Acquires Customer">
      <bpmn:incoming>Flow_SpecialAcquisition</bpmn:incoming>
      <bpmn:outgoing>Flow_ToPresentationCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event for Uninterested Customers -->
    <bpmn:endEvent id="End_Uninterested" name="Customer Left Alone">
      <bpmn:incoming>Flow_LeaveAlone</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Presentation Type Decision -->
    <bpmn:exclusiveGateway id="Gateway_PresentationType" name="Presentation Type">
      <bpmn:incoming>Flow_ToPresentationCheck</bpmn:incoming>
      <bpmn:outgoing>Flow_StandardPresentation</bpmn:outgoing>
      <bpmn:outgoing>Flow_TechnicalPresentation</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Standard Presentation -->
    <bpmn:task id="Task_OnlinePresentation" name="Detailed Online Presentation (Sales Rep)">
      <bpmn:incoming>Flow_StandardPresentation</bpmn:incoming>
      <bpmn:outgoing>Flow_WaitForResponse</bpmn:outgoing>
    </bpmn:task>

    <!-- Technical Presentation -->
    <bpmn:task id="Task_TechnicalPresentation" name="Detailed Online Presentation (Pre-sales)">
      <bpmn:incoming>Flow_TechnicalPresentation</bpmn:incoming>
      <bpmn:outgoing>Flow_WaitForResponse</bpmn:outgoing>
    </bpmn:task>

    <!-- Wait for Response -->
    <bpmn:intermediateCatchEvent id="IntermediateWaitCustomer" name="Wait 2 Weeks or Contact">
      <bpmn:incoming>Flow_WaitForResponse</bpmn:incoming>
      <bpmn:outgoing>Flow_FollowUpDecision</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Follow-up Decision -->
    <bpmn:exclusiveGateway id="Gateway_FollowUp" name="Customer Contacted?">
      <bpmn:incoming>Flow_FollowUpDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_NoContactWithin2Weeks</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Follow-up Call -->
    <bpmn:task id="Task_FollowUpCall" name="Sales Representative Calls Customer">
      <bpmn:name>Sales Rep Follows Up After 2 Weeks</bpmn:name>
      <bpmn:incoming>Flow_NoContactWithin2Weeks</bpmn:incoming>
    </bpmn:task>

    <!-- End Event for Successful Acquisition -->
    <bpmn:endEvent id="End_Success" name="Quotation Created">
      <bpmn:name>Customer Acquired - Quotation Phase</bpmn:name>
      <bpmn:incoming>Flow_ToQuotationCreation</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Flow_StartToMarketing" sourceRef="Start_Event1" targetRef="Task_GetContactDetails"/>
    <bpmn:sequenceFlow id="Flow_MarketingDecision" name="Determine Contact Details Source" sourceRef="Task_GetContactDetails" targetRef="Gateway_InitialDecision"/>
    <bpmn:sequenceFlow id="Flow_ToCallCenter" name="Proceed to Call Center" sourceRef="Gateway_InterestCheck" targetRef="Task_InitiateContact"/>
    <bpmn:sequenceFlow id="Flow_CallToInterestCheck" name="Determine Contact Person &amp; Budget" sourceRef="Task_InitiateContact" targetRef="Gateway_InterestCheck"/>
    <bpmn:sequenceFlow id="Flow_SpecialAcquisition" name="High Budget - Not Interested" sourceRef="Gateway_InterestCheck" targetRef="Task_SpecialAcquisition"/>
    <bpmn:sequenceFlow id="Flow_LeaveAlone" name="Low Budget - Leave Alone" sourceRef="Gateway_InterestCheck" targetRef="End_Uninterested"/>
    <bpmn:sequenceFlow id="Flow_ToPresentationCheck" name="Customer Interested After Acquisition Effort" sourceRef="Task_SpecialAcquisition" targetRef="Gateway_PresentationType"/>
    <bpmn:sequenceFlow id="Flow_StandardPresentation" name="General Presentation (Sales Rep)" sourceRef="Gateway_PresentationType" targetRef="Task_OnlinePresentation"/>
    <bpmn:sequenceFlow id="Flow_TechnicalPresentation" name="Technical Presentation (Pre-sales)" sourceRef="Gateway_PresentationType" targetRef="Task_TechnicalPresentation"/>
    <bpmn:sequenceFlow id="Flow_WaitForResponse" name="Wait for Customer Response" sourceRef="Task_OnlinePresentation" targetRef="IntermediateWaitCustomer"/>
    <bpmn:sequenceFlow id="Flow_FollowUpDecision" name="2 Weeks Timeout or Contact" sourceRef="IntermediateWaitCustomer" targetRef="Gateway_FollowUp"/>
    <bpmn:sequenceFlow id="Flow_NoContactWithin2Weeks" name="No Contact Within 2 Weeks" sourceRef="Gateway_FollowUp" targetRef="Task_FollowUpCall"/>
    <bpmn:sequenceFlow id="Flow_ToQuotationCreation" name="Customer Acquired - Proceed to Quotation" sourceRef="Task_FollowUpCall" targetRef="End_Success"/>

  </bpmn:process>
</bpmn:definitions>