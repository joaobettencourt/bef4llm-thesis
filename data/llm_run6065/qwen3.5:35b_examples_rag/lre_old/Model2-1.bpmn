<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_TELECO">
    <bpmn:participant id="Participant_TELECO" name="TELECO Operations" processRef="Process_Main"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Main" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_CustomerService" name="Customer Service Dept.">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SignificanceCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_CS_Premium</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SystemAutomation" name="System Automation">
        <bpmn:flowNodeRef>Task_SLAComparison</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PrioritizeLoop</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ServiceManagement" name="Service Management">
        <bpmn:flowNodeRef>Task_CreateDetailedReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AnalyzableCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SMAnalysis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareFinalStatusReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CounterMeasuresDecision</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Service Degradation Detected">
      <bpmn:outgoing>SequenceFlow_Init</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Enter Report -->
    <bpmn:task id="Task_EnterReport" name="Enter Problem Report into System T">
      <bpmn:incoming>SequenceFlow_Init</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SLACompare</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: SLA Comparison -->
    <bpmn:task id="Task_SLAComparison" name="Compare with Customer SLA &amp; Determine Measures">
      <bpmn:incoming>SequenceFlow_SLACompare</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PrioritizeLoopIn</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Significance Check -->
    <bpmn:exclusiveGateway id="Gateway_SignificanceCheck" name="Customer Significant?">
      <bpmn:incoming>SequenceFlow_PrioritizeLoopIn</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_LinkExtraProcess</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CreateReport</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event for Premium Link -->
    <bpmn:endEvent id="EndEvent_CS_Premium" name="Link to Extra Process">
      <bpmn:name>Extra Problem Fix</bpmn:name>
      <bpmn:incoming>SequenceFlow_LinkExtraProcess</bpmn:outgoing>
    </bpmn:endEvent>

    <!-- Task 3: Create Detailed Report -->
    <bpmn:task id="Task_CreateDetailedReport" name="Create Detailed Problem Report">
      <bpmn:name>Create Detailed Problem Report</bpmn:name>
      <bpmn:incoming>SequenceFlow_CreateReport</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SendToSM</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2: Analyzable Check -->
    <bpmn:exclusiveGateway id="Gateway_AnalyzableCheck" name="Analyzable by SM?">
      <bpmn:name>SM Can Analyze?</bpmn:name>
      <bpmn:incoming>SequenceFlow_SendToSM</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SMAnalysisPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RPForwarding</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 4: SM Analysis -->
    <bpmn:task id="Task_SMAnalysis" name="Perform Problem Analysis">
      <bpmn:name>SM Perform Analysis</bpmn:name>
      <bpmn:incoming>SequenceFlow_SMAnalysisPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CreateTroubleReport</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 5: Create Trouble Report -->
    <bpmn:task id="Task_CreateTroubleReport" name="Create Trouble Report">
      <bpmn:name>Create Trouble Report (SM)</bpmn:name>
      <bpmn:incoming>SequenceFlow_CreateTroubleReport</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SendStatusToCS</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 6: Prepare Final Status Report -->
    <bpmn:task id="Task_PrepareFinalStatusReport" name="Prepare Final Status Report">
      <bpmn:name>Prepare Final Status Report</bpmn:name>
      <bpmn:incoming>SequenceFlow_SendStatusToCS</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CounterMeasuresDecisionIn</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 3: Counter Measures Decision -->
    <bpmn:exclusiveGateway id="Gateway_CounterMeasuresDecision" name="Counter Measure Type?">
      <bpmn:name>Determine Actions</bpmn:name>
      <bpmn:incoming>SequenceFlow_CounterMeasuresDecisionIn</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoProblemPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_MinorActionPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RestorationRequestPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Path 1: No Problem -->
    <bpmn:endEvent id="EndEvent_NoProblem" name="No Problem Detected">
      <bpmn:name>No Problem (Performance)</bpmn:name>
      <bpmn:incoming>SequenceFlow_SendToCS</bpmn:outgoing>
    </bpmn:endEvent>

    <!-- Path 2: Minor Actions -->
    <bpmn:task id="Task_MinorActions" name="Undertake Corrective Actions">
      <bpmn:name>SM Undertake Actions</bpmn:name>
      <bpmn:incoming>SequenceFlow_MinorActionPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CreateResolutionReport2</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3.1: Create Resolution Report -->
    <bpmn:task id="Task_CreateResolutionReport" name="Create Problem Resolution Report">
      <bpmn:name>Create Resolution Report</bpmn:name>
      <bpmn:incoming>SequenceFlow_MinorActionPath2</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SendToCS_Final</bpmn:outgoing>
    </bpmn:task>

    <!-- Path 3: Restoration Request -->
    <bpmn:endEvent id="EndEvent_CS_End" name="Process Ends (CS)">
      <bpmn:name>Service Management End</bpmn:name>
      <bpmn:incoming>SequenceFlow_SendToCS_Final</bpmn:outgoing>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>