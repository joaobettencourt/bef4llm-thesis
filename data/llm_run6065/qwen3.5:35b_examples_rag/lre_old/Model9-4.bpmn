<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_CommitteeProcess">
    <bpmn:participant id="Participant_Main" name="Committee Management Process" processRef="Process_Coordination"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Coordination" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_CoordinationUnit" name="Coordination Unit">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_QACheckMinutes</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SupportOfficer" name="Support Officer">
        <bpmn:flowNodeRef>ParallelGateway_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateCalendars</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateFolders</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UploadDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_Join1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateThrow_NotifyMembers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CommitteeMeeting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProduceMinutes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateThrow_SendMinutes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Dates Finalized">
      <bpmn:outgoing>SequenceFlow_Start_GW</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Parallel Gateway for Initial Tasks -->
    <bpmn:parallelGateway id="ParallelGateway_1">
      <bpmn:incoming>SequenceFlow_Start_GW</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Task_Calendars</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_Task_Folders</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_Task_Docs</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Support Officer Tasks -->
    <bpmn:task id="Task_UpdateCalendars" name="Update Group Calendars">
      <bpmn:incoming>SequenceFlow_Task_Calendars</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Join1_Calendars</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_CreateFolders" name="Create Meeting Folders">
      <bpmn:incoming>SequenceFlow_Task_Folders</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Join1_Folders</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_UploadDocs" name="Ensure Documents Uploaded">
      <bpmn:incoming>SequenceFlow_Task_Docs</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Join1_Docs</bpmn:outgoing>
    </bpmn:task>

    <!-- Join Parallel Tasks -->
    <bpmn:parallelGateway id="ParallelGateway_Join1">
      <bpmn:incoming>SequenceFlow_Join1_Calendars</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_Join1_Folders</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_Join1_Docs</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NotifyMembers</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Notify Members -->
    <bpmn:intermediateThrowEvent id="IntermediateThrow_NotifyMembers" name="Advise Committee (1 week before)">
      <bpmn:incoming>SequenceFlow_NotifyMembers</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MeetingWait</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <!-- Committee Meeting -->
    <bpmn:task id="Task_CommitteeMeeting" name="Hold Committee Meeting">
      <bpmn:incoming>SequenceFlow_MeetingWait</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProduceMinutes</bpmn:outgoing>
    </bpmn:task>

    <!-- Produce Minutes -->
    <bpmn:task id="Task_ProduceMinutes" name="Produce Minutes with Action Points">
      <bpmn:incoming>SequenceFlow_ProduceMinutes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_QACheck</bpmn:outgoing>
    </bpmn:task>

    <!-- QA Check (Coordination Unit) -->
    <bpmn:task id="Task_QACheckMinutes" name="QA Check Minutes">
      <bpmn:name>QA Check Minutes</bpmn:name>
      <bpmn:incoming>SequenceFlow_QACheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendToMembers</bpmn:outgoing>
    </bpmn:task>

    <!-- Send Minutes -->
    <bpmn:intermediateThrowEvent id="IntermediateThrow_SendMinutes" name="Send Minutes to Committee">
      <bpmn:name>Send Minutes to Committee</bpmn:name>
      <bpmn:incoming>SequenceFlow_SendToMembers</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_UpdateRecords</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <!-- Final Task -->
    <bpmn:endEvent id="EndEvent_1" name="Departmental Records Updated">
      <bpmn:name>Process Complete</bpmn:name>
      <bpmn:incoming>SequenceFlow_UpdateRecords</bpmn:outgoing>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_Start_GW" sourceRef="StartEvent_1" targetRef="ParallelGateway_1"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_Task_Calendars" name="Update Calendars" sourceRef="ParallelGateway_1" targetRef="Task_UpdateCalendars"/>
    <bpmn:sequenceFlow id="SequenceFlow_Task_Folders" name="Create Folders" sourceRef="ParallelGateway_1" targetRef="Task_CreateFolders"/>
    <bpmn:sequenceFlow id="SequenceFlow_Task_Docs" name="Upload Docs" sourceRef="ParallelGateway_1" targetRef="Task_UploadDocs"/>

    <bpmn:sequenceFlow id="SequenceFlow_Join1_Calendars" sourceRef="Task_UpdateCalendars" targetRef="ParallelGateway_Join1"/>
    <bpmn:sequenceFlow id="SequenceFlow_Join1_Folders" sourceRef="Task_CreateFolders" targetRef="ParallelGateway_Join1"/>
    <bpmn:sequenceFlow id="SequenceFlow_Join1_Docs" sourceRef="Task_UploadDocs" targetRef="ParallelGateway_Join1"/>

    <bpmn:sequenceFlow id="SequenceFlow_NotifyMembers" name="Notify Members" sourceRef="ParallelGateway_Join1" targetRef="IntermediateThrow_NotifyMembers"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_MeetingWait" sourceRef="IntermediateThrow_NotifyMembers" targetRef="Task_CommitteeMeeting"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ProduceMinutes" name="Produce Minutes" sourceRef="Task_CommitteeMeeting" targetRef="Task_ProduceMinutes"/>

    <!-- Handover to Coordination Unit for QA -->
    <bpmn:sequenceFlow id="SequenceFlow_QACheck" sourceRef="Task_ProduceMinutes" targetRef="Task_QACheckMinutes"/>

    <bpmn:sequenceFlow id="SequenceFlow_SendToMembers" name="Send Minutes" sourceRef="Task_QACheckMinutes" targetRef="IntermediateThrow_SendMinutes"/>
    
    <!-- Final Step -->
    <bpmn:endEvent id="EndEvent_1_Final">
      <bpmn:name>Process Complete</bpmn:name>
      <bpmn:incoming>SequenceFlow_UpdateRecords</bpmn:outgoing>
    </bpmn:endEvent>

    <!-- Correction for End Event ID consistency -->
    
  </bpmn:process>
  
  <!-- Corrected Sequence Flow to Final Task and End -->
  <bpmn:task id="Task_FinalUpdate" name="Update Departmental Records">
      <bpmn:name>Update Departmental Records</bpmn:name>
      <bpmn:incoming>SequenceFlow_UpdateRecords</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_EndProcess</bpmn:outgoing>
  </bpmn:task>

  <!-- Re-organizing to ensure valid XML structure within Process tag -->
  
</definitions>