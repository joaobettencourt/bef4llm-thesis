<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_ExaminationProcess">
    <bpmn:participant id="Participant_ExamProc" name="Examination Process" processRef="Process_ExamProc" />
  </bpmn:collaboration>

  <bpmn:process id="Process_ExamProc" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_OutpatientPhysician" name="Outpatient Physician">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExaminationDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_NeedExam</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FillExaminationForm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PlaceOrderRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformPatientRisks</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Patient" name="Patient">
        <bpmn:flowNodeRef>Gateway_ConsentAgree</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SignConsent</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_WardDelegate" name="Ward Delegate">
        <bpmn:flowNodeRef>Gateway_ArrangeAppointment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SamplePreparation</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_WardPhysician" name="Ward Physician">
        <bpmn:flowNodeRef>Gateway_TakeSample</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendToLab</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_LabPhysician" name="Laboratory Physician">
        <bpmn:flowNodeRef>Gateway_ValidateSample</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ValidateResults</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_MedicalAssistant" name="Medical Technical Assistant">
        <bpmn:flowNodeRef>Task_PerformAnalysis</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_OutpatientDeptPhysician" name="Outpatient Department Physician">
        <bpmn:flowNodeRef>Gateway_MakeDiagnosis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrescribeTherapy</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Patient Examination">
      <bpmn:outgoing>Flow_Examination</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Physician examines patient and decides -->
    <bpmn:task id="Task_ExaminationDecision" name="Examine Patient &amp; Decide">
      <bpmn:incoming>Flow_Examination</bpmn:incoming>
      <bpmn:outgoing>Flow_DecisionPoint</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Decision if additional examination needed -->
    <bpmn:exclusiveGateway id="Gateway_NeedExam" name="Needs Additional Examination?">
      <bpmn:incoming>Flow_DecisionPoint</bpmn:incoming>
      <bpmn:outgoing>Flow_HealthyPath</bpmn:outgoing>
      <bpmn:outgoing>Flow_ExamNeededPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Path A: Healthy Patient -->
    <bpmn:task id="Task_FillExaminationForm" name="Fill Examination Form">
      <bpmn:incoming>Flow_HealthyPath</bpmn:incoming>
      <bpmn:outgoing>Flow_PatientLeave</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event for Healthy Patient -->
    <bpmn:endEvent id="EndEvent_HealthyPatient" name="Patient Leaves">
      <bpmn:incoming>Flow_PatientLeave</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Path B: Additional Examination Needed -->
    <bpmn:task id="Task_PlaceOrderRequest" name="Place Order &amp; Fill Request Form">
      <bpmn:incoming>Flow_ExamNeededPath</bpmn:incoming>
      <bpmn:outgoing>Flow_InformRisks</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: Inform patient about risks -->
    <bpmn:task id="Task_InformPatientRisks" name="Inform Patient About Risks">
      <bpmn:incoming>Flow_InformRisks</bpmn:incoming>
      <bpmn:outgoing>Flow_ConsentDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2: Patient Consent Decision -->
    <bpmn:exclusiveGateway id="Gateway_ConsentAgree" name="Patient Agrees?">
      <bpmn:incoming>Flow_ConsentDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_AgreePath</bpmn:outgoing>
      <bpmn:outgoing>Flow_DisagreePath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event for Disagreement -->
    <bpmn:endEvent id="EndEvent_Refused" name="Procedure Refused">
      <bpmn:incoming>Flow_DisagreePath</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task 3: Patient signs consent -->
    <bpmn:task id="Task_SignConsent" name="Sign Informed Consent">
      <bpmn:incoming>Flow_AgreePath</bpmn:incoming>
      <bpmn:outgoing>Flow_AppointmentArranged</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 3: Arrange Appointment -->
    <bpmn:exclusiveGateway id="Gateway_ArrangeAppointment" name="Arrange Appointment">
      <bpmn:incoming>Flow_AppointmentArranged</bpmn:incoming>
      <bpmn:outgoing>Flow_SamplePreparation</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 4: Sample Preparation -->
    <bpmn:task id="Task_SamplePreparation" name="Prepare Examination &amp; Sampling">
      <bpmn:incoming>Flow_SamplePreparation</bpmn:incoming>
      <bpmn:outgoing>Flow_TakeSample</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 4: Take Sample -->
    <bpmn:exclusiveGateway id="Gateway_TakeSample" name="Take Requested Sample">
      <bpmn:incoming>Flow_TakeSample</bpmn:incoming>
      <bpmn:outgoing>Flow_SendToLab</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 5: Send to Lab -->
    <bpmn:task id="Task_SendToLab" name="Send Sample to Lab">
      <bpmn:incoming>Flow_TakeSample</bpmn:incoming>
      <bpmn:outgoing>Flow_LabReceive</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 5: Validate Sample -->
    <bpmn:exclusiveGateway id="Gateway_ValidateSample" name="Sample Valid?">
      <bpmn:incoming>Flow_LabReceive</bpmn:incoming>
      <bpmn:outgoing>Flow_AnalysisPath</bpmn:outgoing>
      <bpmn:outgoing>Flow_NewSampleRequired</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 6: Perform Analysis -->
    <bpmn:task id="Task_PerformAnalysis" name="Perform Laboratory Analysis">
      <bpmn:incoming>Flow_AnalysisPath</bpmn:incoming>
      <bpmn:outgoing>Flow_ValidateResults</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 7: Validate Results -->
    <bpmn:task id="Task_ValidateResults" name="Validate Analysis Results">
      <bpmn:incoming>Flow_AnalysisComplete</bpmn:incoming>
      <bpmn:outgoing>Flow_DiagnosisDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 6: Make Diagnosis -->
    <bpmn:exclusiveGateway id="Gateway_MakeDiagnosis" name="Make Diagnosis">
      <bpmn:incoming>Flow_ResultsValidated</bpmn:incoming>
      <bpmn:outgoing>Flow_PrescribeTherapy</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 8: Prescribe Therapy -->
    <bpmn:task id="Task_PrescribeTherapy" name="Prescribe Therapy">
      <bpmn:incoming>Flow_DiagnosisMade</bpmn:incoming>
      <bpmn:outgoing>Flow_ProcessComplete</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event for Process Complete -->
    <bpmn:endEvent id="EndEvent_ProcessComplete" name="Process Complete">
      <bpmn:name>Diagnosis &amp; Therapy Prescribed</bpmn:name>
      <bpmn:incoming>Flow_ProcessComplete</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Flow_Examination" sourceRef="StartEvent_1" targetRef="Task_ExaminationDecision" />
    <bpmn:sequenceFlow id="Flow_DecisionPoint" sourceRef="Task_ExaminationDecision" targetRef="Gateway_NeedExam" />

    <!-- Healthy Path -->
    <bpmn:sequenceFlow id="Flow_HealthyPath" name="No Additional Exam Needed" sourceRef="Gateway_NeedExam" targetRef="Task_FillExaminationForm" />
    <bpmn:sequenceFlow id="Flow_PatientLeave" sourceRef="Task_FillExaminationForm" targetRef="EndEvent_HealthyPatient" />

    <!-- Examination Needed Path -->
    <bpmn:sequenceFlow id="Flow_ExamNeededPath" name="Additional Exam Required" sourceRef="Gateway_NeedExam" targetRef="Task_PlaceOrderRequest" />
    <bpmn:sequenceFlow id="Flow_InformRisks" sourceRef="Task_PlaceOrderRequest" targetRef="Task_InformPatientRisks" />

    <!-- Consent Decision -->
    <bpmn:sequenceFlow id="Flow_ConsentDecision" name="Inform Patient About Risks" sourceRef="Task_InformPatientRisks" targetRef="Gateway_ConsentAgree" />
    <bpmn:sequenceFlow id="Flow_AgreePath" name="Yes - Agrees to Continue" sourceRef="Gateway_ConsentAgree" targetRef="Task_SignConsent" />
    <bpmn:sequenceFlow id="Flow_DisagreePath" name="No - Refuses Procedure" sourceRef="Gateway_ConsentAgree" targetRef="EndEvent_Refused" />

    <!-- Appointment & Sample Flow -->
    <bpmn:sequenceFlow id="Flow_AppointmentArranged" sourceRef="Task_SignConsent" targetRef="Gateway_ArrangeAppointment" />
    <bpmn:sequenceFlow id="Flow_SamplePreparation" name="Prepare Examination &amp; Sampling" sourceRef="Gateway_ArrangeAppointment" targetRef="Task_SamplePreparation" />

    <!-- Sample Preparation -->
    <bpmn:sequenceFlow id="Flow_TakeSample" name="Take Requested Sample" sourceRef="Task_SamplePreparation" targetRef="Gateway_TakeSample" />

    <!-- Send to Lab -->
    <bpmn:sequenceFlow id="Flow_SendToLab" sourceRef="Gateway_TakeSample" targetRef="Task_SendToLab" />
    <bpmn:sequenceFlow id="Flow_LabReceive" name="Send Sample to Lab" sourceRef="Task_SendToLab" targetRef="Gateway_ValidateSample" />

    <!-- Analysis Flow -->
    <bpmn:sequenceFlow id="Flow_AnalysisPath" name="Valid - Proceed with Analysis" sourceRef="Gateway_ValidateSample" targetRef="Task_PerformAnalysis" />
    <bpmn:sequenceFlow id="Flow_NewSampleRequired" name="Contaminated - New Sample Required" sourceRef="Gateway_ValidateSample" targetRef="Task_SamplePreparation" />

    <!-- Results Validation -->
    <bpmn:sequenceFlow id="Flow_AnalysisComplete" sourceRef="Task_PerformAnalysis" targetRef="Task_ValidateResults" />
    <bpmn:sequenceFlow id="Flow_ResultsValidated" name="Analyze Complete &amp; Validated" sourceRef="Task_ValidateResults" targetRef="Gateway_MakeDiagnosis" />

    <!-- Diagnosis & Therapy -->
    <bpmn:sequenceFlow id="Flow_DiagnosisMade" sourceRef="Gateway_MakeDiagnosis" targetRef="Task_PrescribeTherapy" />
    <bpmn:sequenceFlow id="Flow_ProcessComplete" name="Prescribed Therapy" sourceRef="Task_PrescribeTherapy" targetRef="EndEvent_ProcessComplete" />

  </bpmn:process>
</bpmn:definitions>