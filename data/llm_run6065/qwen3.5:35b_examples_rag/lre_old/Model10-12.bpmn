<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_MasterDataChange">
    <bpmn:participant id="Participant_EC" name="EC (Entity/Client)" processRef="Process_EC"/>
    <bpmn:participant id="Participant_INQ" name="INQ (Inquiry System)" processRef="Process_INQ"/>
    <bpmn:participant id="Participant_IP" name="IP (Processing System)" processRef="Process_IP"/>
    
    <!-- Message Flow from EC to INQ -->
    <bpmn:messageFlow id="MessageFlow_EC_TO_INQ" sourceRef="IntermediateThrowEvent_EC" targetRef="StartCatchEvent_INQ"/>
    
    <!-- Message Flow from INQ to IP -->
    <bpmn:messageFlow id="MessageFlow_INQ_TO_IP" sourceRef="IntermediateThrowEvent_INQ" targetRef="StartCatchEvent_IP"/>
  </bpmn:collaboration>

  <!-- EC Process (Entity/Client) -->
  <bpmn:process id="Process_EC" isExecutable="false">
    <bpmn:startEvent id="StartEC_1" name="Initiate Master Data Change Request">
      <bpmn:outgoing>SequenceFlow_EC_Start</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_EC_Request" name="Submit Change Request to INQ">
      <bpmn:incoming>SequenceFlow_EC_Start</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EC_Task</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Throw Event for Message -->
    <bpmn:intermediateThrowEvent id="IntermediateThrowEvent_EC" name="Send Change Notification">
      <bpmn:incoming>SequenceFlow_EC_Task</bpmn:incoming>
      <bpmn:outgoing>MessageFlow_EC_TO_INQ</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <!-- End Event -->
    <bpmn:endEvent id="EndEC_1" name="Request Submitted">
      <bpmn:incoming>SequenceFlow_EC_End</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_EC_Start" sourceRef="StartEC_1" targetRef="Task_EC_Request"/>
    <bpmn:sequenceFlow id="SequenceFlow_EC_Task" sourceRef="Task_EC_Request" targetRef="IntermediateThrowEvent_EC"/>
    <bpmn:sequenceFlow id="SequenceFlow_EC_End" sourceRef="EndEC_1" targetRef="StartCatchEvent_INQ">
      <!-- End event for EC process -->
    </bpmn:sequenceFlow>
  </bpmn:process>

  <!-- INQ Process (Inquiry System) -->
  <bpmn:process id="Process_INQ" isExecutable="false">
    <bpmn:startEvent id="StartCatchEvent_INQ" name="Receive Change Notification from EC">
      <bpmn:incoming>MessageFlow_EC_TO_INQ</bpmn:outgoing/>
      <bpmn:outgoing>SequenceFlow_INQ_Start</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_INQ_Process" name="Process Change Request">
      <bpmn:incoming>SequenceFlow_INQ_Start</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_INQ_Task</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Throw Event for Message to IP -->
    <bpmn:intermediateThrowEvent id="IntermediateThrowEvent_INQ" name="Notify IP of Change">
      <bpmn:incoming>SequenceFlow_INQ_Task</bpmn:incoming/>
      <bpmn:outgoing>MessageFlow_INQ_TO_IP</bpmn:outgoing/>
    </bpmn:intermediateThrowEvent>

    <!-- End Event -->
    <bpmn:endEvent id="EndINQ_1" name="Notification Sent">
      <bpmn:incoming>SequenceFlow_INQ_End</bpmn:incoming/>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_INQ_Start" sourceRef="StartCatchEvent_INQ" targetRef="Task_INQ_Process"/>
    <bpmn:sequenceFlow id="SequenceFlow_INQ_Task" sourceRef="Task_INQ_Process" targetRef="IntermediateThrowEvent_INQ"/>
    <bpmn:sequenceFlow id="SequenceFlow_INQ_End" sourceRef="EndINQ_1" targetRef="StartCatchEvent_IP">
      <!-- End event for INQ process -->
    </bpmn:sequenceFlow>
  </bpmn:process>

  <!-- IP Process (Processing System) - Contains Decision Logic -->
  <bpmn:process id="Process_IP" isExecutable="false">
    <bpmn:startEvent id="StartCatchEvent_IP" name="Receive Change Notification from INQ">
      <bpmn:incoming>MessageFlow_INQ_TO_IP</bpmn:outgoing/>
      <bpmn:outgoing>SequenceFlow_IP_Start</bpmn:outgoing/>
    </bpmn:startEvent>

    <!-- Task to Check if Change Can Be Made -->
    <bpmn:task id="Task_IP_Check" name="Check Master Data Change Feasibility">
      <bpmn:incoming>SequenceFlow_IP_Start</bpmn:incoming/>
      <bpmn:outgoing>SequenceFlow_IP_Task</bpmn:outgoing/>
    </bpmn:task>

    <!-- Exclusive Gateway for Decision -->
    <bpmn:exclusiveGateway id="Gateway_IP_Decision" name="Can Change Be Made?">
      <bpmn:incoming>SequenceFlow_IP_GatewayIn</bpmn:incoming/>
      <bpmn:outgoing>SequenceFlow_IP_Confirm</bpmn:outgoing/>
      <bpmn:outgoing>SequenceFlow_IP_Reject</bpmn:outgoing/>
    </bpmn:exclusiveGateway>

    <!-- Task for Confirm -->
    <bpmn:task id="Task_IP_Confirm" name="Confirm Change to INQ">
      <bpmn:incoming>SequenceFlow_IP_Confirm</bpmn:incoming/>
      <bpmn:outgoing>SequenceFlow_IP_End1</bpmn:outgoing/>
    </bpmn:task>

    <!-- Task for Reject -->
    <bpmn:task id="Task_IP_Reject" name="Reject Change to INQ">
      <bpmn:incoming>SequenceFlow_IP_Reject</bpmn:incoming/>
      <bpmn:outgoing>SequenceFlow_IP_End2</bpmn:outgoing/>
    </bpmn:task>

    <!-- End Events -->
    <bpmn:endEvent id="EndIP_Confirm" name="Change Confirmed">
      <bpmn:incoming>SequenceFlow_IP_End1</bpmn:incoming/>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndIP_Reject" name="Change Rejected">
      <bpmn:incoming>SequenceFlow_IP_End2</bpmn:incoming/>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_IP_Start" sourceRef="StartCatchEvent_IP" targetRef="Task_IP_Check"/>
    <bpmn:sequenceFlow id="SequenceFlow_IP_Task" sourceRef="Task_IP_Check" targetRef="Gateway_IP_Decision"/>
    <bpmn:sequenceFlow id="SequenceFlow_IP_GatewayIn" sourceRef="Gateway_IP_Decision">
      <!-- Gateway incoming flow -->
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_IP_Confirm" name="Yes - Can Change" sourceRef="Gateway_IP_Decision" targetRef="Task_IP_Confirm"/>
    <bpmn:sequenceFlow id="SequenceFlow_IP_Reject" name="No - Cannot Change" sourceRef="Gateway_IP_Decision" targetRef="Task_IP_Reject"/>
    <bpmn:sequenceFlow id="SequenceFlow_IP_End1" sourceRef="Task_IP_Confirm" targetRef="EndIP_Confirm"/>
    <bpmn:sequenceFlow id="SequenceFlow_IP_End2" sourceRef="Task_IP_Reject" targetRef="EndIP_Reject"/>
  </bpmn:process>

</bpmn:definitions>