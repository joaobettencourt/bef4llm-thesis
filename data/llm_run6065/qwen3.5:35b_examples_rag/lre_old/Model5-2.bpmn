<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_VacReq">
    <bpmn:participant id="Participant_Org" name="Organization" processRef="Process_VacRequest"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_VacRequest" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Employee" name="Employee">
        <bpmn:flowNodeRef>StartEvent_Submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegisterRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewRejection</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Supervisor" name="Supervisor">
        <bpmn:flowNodeRef>Gateway_ApproveReject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewRequest</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_HR" name="Human Resources">
        <bpmn:flowNodeRef>Task_GenerateNotification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CompleteProcedures</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Submit" name="Vacation Request Submitted">
      <bpmn:outgoing>Flow_Register</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Register the request requirement -->
    <bpmn:task id="Task_RegisterRequest" name="Register Vacation Requirement">
      <bpmn:incoming>Flow_Register</bpmn:incoming>
      <bpmn:outgoing>Flow_SupervisorReview</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: Supervisor reviews the request -->
    <bpmn:task id="Task_ReviewRequest" name="Supervisor Reviews Request">
      <bpmn:incoming>Flow_SupervisorReview</bpmn:incoming>
      <bpmn:outgoing>Flow_DecisionPoint</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway for Approval/Rejection Decision -->
    <bpmn:exclusiveGateway id="Gateway_ApproveReject" name="Request Approved?">
      <bpmn:incoming>Flow_DecisionPoint</bpmn:incoming>
      <bpmn:outgoing>Flow_RejectPath</bpmn:outgoing>
      <bpmn:outgoing>Flow_ApprovedPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 3: Rejection - Return to employee with reasons -->
    <bpmn:task id="Task_ReviewRejection" name="Employee Reviews Rejection Reasons">
      <bpmn:incoming>Flow_RejectPath</bpmn:incoming>
      <bpmn:outgoing>Flow_RegisterRequestAgain</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 4: Notification to HR -->
    <bpmn:task id="Task_GenerateNotification" name="Generate Approval Notification">
      <bpmn:incoming>Flow_ApprovedPath</bpmn:incoming>
      <bpmn:outgoing>Flow_HRProcedures</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 5: HR completes management procedures -->
    <bpmn:task id="Task_CompleteProcedures" name="Complete Management Procedures">
      <bpmn:incoming>Flow_HRProcedures</bpmn:incoming>
      <bpmn:outgoing>Flow_EndProcess</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Completed" name="Vacation Process Completed">
      <bpmn:incoming>Flow_EndProcess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Flow_Register" sourceRef="StartEvent_Submit" targetRef="Task_RegisterRequest"/>
    <bpmn:sequenceFlow id="Flow_SupervisorReview" name="To Supervisor Review" sourceRef="Task_RegisterRequest" targetRef="Task_ReviewRequest"/>
    <bpmn:sequenceFlow id="Flow_DecisionPoint" sourceRef="Task_ReviewRequest" targetRef="Gateway_ApproveReject"/>
    <bpmn:sequenceFlow id="Flow_RejectPath" name="Rejected - Return to Employee" sourceRef="Gateway_ApproveReject" targetRef="Task_ReviewRejection">
      <bpmn:name>Rejected</bpmn:name>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_RegisterRequestAgain" name="Resubmit Request" sourceRef="Task_ReviewRejection" targetRef="Task_RegisterRequest"/>
    <bpmn:sequenceFlow id="Flow_ApprovedPath" name="Approved - Notify HR" sourceRef="Gateway_ApproveReject" targetRef="Task_GenerateNotification">
      <bpmn:name>Approved</bpmn:name>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_HRProcedures" name="To HR Procedures" sourceRef="Task_GenerateNotification" targetRef="Task_CompleteProcedures"/>
    <bpmn:sequenceFlow id="Flow_EndProcess" sourceRef="Task_CompleteProcedures" targetRef="EndEvent_Completed"/>

  </bpmn:process>
</bpmn:definitions>