<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_LeadsProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_LeadsProcess">
    <bpmn:participant id="Participant_ManagementTeam" name="Lead Management Process" processRef="Process_LeadsManagement" />
  </bpmn:collaboration>

  <bpmn:process id="Process_LeadsManagement" isExecutable="false">
    <bpmn:dataObjectReference id="DataObject_LeadsList" name="Open Leads" />
    
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Manager" name="Manager">
        <bpmn:flowNodeRef>StartEvent_CheckLeads</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewLeads</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectTop5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_InterestedDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProcessLead</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SalesAssistant" name="Sales Assistant">
        <bpmn:flowNodeRef>Task_CallCustomer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_AllLeadsProcessed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_CheckLeads" name="Check Open Leads">
      <bpmn:outgoing>SequenceFlow_ReviewLeads</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Review leads -->
    <bpmn:task id="Task_ReviewLeads" name="Check Open Leads">
      <bpmn:incoming>SequenceFlow_ReviewLeads</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SelectTop5</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: Select top five leads -->
    <bpmn:task id="Task_SelectTop5" name="Select Top Five Leads">
      <bpmn:incoming>SequenceFlow_SelectTop5</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CallCustomerLoop</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3: Call customer (in loop) -->
    <bpmn:task id="Task_CallCustomer" name="Call Customer">
      <bpmn:incoming>SequenceFlow_CallCustomerLoop</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DecisionInterested</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway for Interest Decision -->
    <bpmn:exclusiveGateway id="Gateway_InterestedDecision" name="Customer Interested?">
      <bpmn:incoming>SequenceFlow_DecisionInterested</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProcessLeadPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CallNextPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 4: Process lead (if interested) -->
    <bpmn:task id="Task_ProcessLead" name="Process Lead">
      <bpmn:incoming>SequenceFlow_ProcessLeadPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckMoreLeads</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_AllLeadsProcessed" name="All Leads Processed">
      <bpmn:incoming>SequenceFlow_CallNextPath</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_CheckMoreLeads</bpmn:outgoing>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_ReviewLeads" sourceRef="StartEvent_CheckLeads" targetRef="Task_ReviewLeads">
      <bpmn:name>Check Open Leads</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Decision flow to gateway -->
    <bpmn:sequenceFlow id="SequenceFlow_CallCustomerLoop" sourceRef="Gateway_InterestedDecision" targetRef="Task_CallCustomer">
      <bpmn:dataInputAssociation>
        <bpmn:sourceRef>DataObject_LeadsList</bpmn:sourceRef>
        <bpmn:targetRef>Task_CallCustomer</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:sequenceFlow>

    <!-- Decision flow to gateway -->
    <bpmn:sequenceFlow id="SequenceFlow_DecisionInterested" sourceRef="Task_CallCustomer" targetRef="Gateway_InterestedDecision">
      <bpmn:name>Call Result</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- If interested - process lead -->
    <bpmn:sequenceFlow id="SequenceFlow_ProcessLeadPath" name="Yes, Interested" sourceRef="Gateway_InterestedDecision" targetRef="Task_ProcessLead">
      <bpmn:dataInputAssociation>
        <bpmn:sourceRef>DataObject_LeadsList</bpmn:sourceRef>
        <bpmn:targetRef>Task_ProcessLead</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:sequenceFlow>

    <!-- If not interested - call next customer -->
    <bpmn:sequenceFlow id="SequenceFlow_CallNextPath" name="No, Not Interested" sourceRef="Gateway_InterestedDecision" targetRef="Task_CallCustomer">
      <bpmn:dataInputAssociation>
        <bpmn:sourceRef>DataObject_LeadsList</bpmn:sourceRef>
        <bpmn:targetRef>Task_CallCustomer</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:sequenceFlow>

    <!-- Check if more leads to process -->
    <bpmn:exclusiveGateway id="Gateway_MoreLeads" name="More Leads?">
      <bpmn:incoming>SequenceFlow_CheckMoreLeads</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CallCustomerLoop2</bpmn:outgoing>
    </bpmn:exclusiveGateway>

  </bpmn:process>
</bpmn:definitions>