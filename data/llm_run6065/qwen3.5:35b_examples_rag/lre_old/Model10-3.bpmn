<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_MPOO_GO">
    <bpmn:participant id="Participant_MPOO" name="MPOO" processRef="Process_MPOO"/>
    <bpmn:participant id="Participant_GO" name="GO" processRef="Process_GO"/>
    <bpmn:messageFlow id="MessageFlow_DeregistrationRequest" sourceRef="IntermediateThrowEvent_MPOO_SendDeregister" targetRef="StartMessageEvent_GO_Verify"/>
  </bpmn:collaboration>

  <!-- MPOO Process -->
  <bpmn:process id="Process_MPOO">
    <bpmn:startEvent id="StartNoneMPOO_01" name="Deregistration Request Initiated">
      <bpmn:outgoing>SequenceFlow_MPOO_Init</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_MPOO_Deregister" name="Register Deregistration at GO">
      <bpmn:incoming>SequenceFlow_MPOO_Init</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MPOO_SendRequest</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndNoneMPOO_01" name="Deregistration Process Completed">
      <bpmn:incoming>SequenceFlow_MPOO_Complete</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Optional continuation confirmation -->
    <bpmn:startMessageEvent id="StartNoneMPOO_02" name="Confirmation Request Received">
      <bpmn:messageRef>Message_ContinuationRequest</bpmn:messageRef>
      <bpmn:outgoing>SequenceFlow_MPOO_Confirm</bpmn:outgoing>
    </bpmn:startMessageEvent>

    <!-- Intermediate throw event for sending confirmation -->
    <bpmn:intermediateThrowEvent id="IntermediateThrowEvent_MPOO_SendConfirmation" name="">
      <bpmn:messageRef>Message_ContinuationConfirmation</bpmn:messageRef>
      <bpmn:incoming>SequenceFlow_MPOO_ConfirmTask</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MPOO_Complete</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

  </bpmn:process>

  <!-- GO Process (Main) -->
  <bpmn:process id="Process_GO">
    <bpmn:startMessageEvent id="StartNoneGO_01" name="">
      <bpmn:messageRef>Message_DeregistrationRequest</bpmn:messageRef>
      <bpmn:outgoing>SequenceFlow_GO_Start</bpmn:outgoing>
    </bpmn:startMessageEvent>

    <!-- Task for verification -->
    <bpmn:task id="Task_GO_VerifyDeregistration" name="Verify Deregistration">
      <bpmn:incoming>SequenceFlow_GO_Start</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GO_DecisionPoint</bpmn:outgoing>
    </bpmn:task>

    <!-- Decision Gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_GO_Decide" name="">
      <bpmn:incoming>SequenceFlow_GO_DecisionPoint</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GO_RejectPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_GO_ConfirmPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Reject Path -->
    <bpmn:endEvent id="EndNoneGO_01" name="">
      <bpmn:name>Deregistration Rejected</bpmn:name>
      <bpmn:incoming>SequenceFlow_GO_RejectPath</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Confirm Path -->
    <!-- Task for preliminary confirmation -->
    <bpmn:task id="Task_GO_PreliminaryConfirm" name="Preliminarily Confirm Deregistration">
      <bpmn:incoming>SequenceFlow_GO_ConfirmPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GO_PrepareReadmission</bpmn:outgoing>
    </bpmn:task>

    <!-- Task for preparing readmission -->
    <bpmn:task id="Task_GO_PrepareReadmission" name="Prepare Readmission of Measuring Point">
      <bpmn:incoming>SequenceFlow_GO_PrepareReadmission</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GO_ObligationDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Optional Obligation Decision -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_GO_Obligate" name="">
      <bpmn:incoming>SequenceFlow_GO_ObligationDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GO_SkipObligation</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_GO_RequireContinuation</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Skip Obligation Path -->
    <bpmn:endEvent id="EndNoneGO_02" name="">
      <bpmn:name/>
      <bpmn:incoming>SequenceFlow_GO_SkipObligation</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Require Continuation Path -->
    <!-- Task for equipment acquisition/changes -->
    <bpmn:task id="Task_GO_EquipmentAcquisition" name="Perform Equipment Acquisition and/or Changes">
      <bpmn:incoming>SequenceFlow_GO_RequireContinuation</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GO_AssignMPO</bpmn:outgoing>
    </bpmn:task>

    <!-- Task for assigning GO as MPO -->
    <bpmn:task id="Task_GO_AssignAsMPO" name="Assign GO as MPO">
      <bpmn:incoming>SequenceFlow_GO_AssignMPO</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GO_InformParties</bpmn:outgoing>
    </bpmn:task>

    <!-- Task for informing MPOO -->
    <bpmn:task id="Task_GO_InformMPOO" name="Inform MPOO about Assignment">
      <bpmn:incoming>SequenceFlow_GO_InformParties</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GO_ContinueToMSPO</bpmn:outgoing>
    </bpmn:task>

    <!-- Task for informing MSPO -->
    <bpmn:task id="Task_GO_InformMSPO" name="Inform MSPO about Assignment">
      <bpmn:incoming>SequenceFlow_GO_ContinueToMSPO</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GO_ContinueToSP</bpmn:outgoing>
    </bpmn:task>

    <!-- Task for informing SP -->
    <bpmn:task id="Task_GO_InformSP" name="Inform SP about Assignment">
      <bpmn:incoming>SequenceFlow_GO_ContinueToSP</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GO_FinalEnd</bpmn:outgoing>
    </bpmn:task>

    <!-- Final End Event -->
    <bpmn:endEvent id="EndNoneGO_03" name="">
      <bpmn:name>Deregistration Process Completed Successfully</bpmn:name>
      <bpmn:incoming>SequenceFlow_GO_FinalEnd</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>

  <!-- Message Flows -->
  <bpmn:message id="Message_DeregistrationRequest" name="Deregistration Request"/>
  <bpmn:message id="Message_ContinuationConfirmation" name="Continuation Confirmation"/>
  <bpmn:message id="Message_ContinuationRequest" name="Continuation Request"/>

</bpmn:definitions>