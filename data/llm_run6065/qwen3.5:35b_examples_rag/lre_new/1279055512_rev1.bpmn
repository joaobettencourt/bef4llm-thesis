<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_SSP_InvoiceProcess">
    <bpmn:participant id="Participant_SSP_Org" name="SSP Organization" processRef="Process_InvoiceProcessing"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_InvoiceProcessing" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_MailCentre_Office" name="Mail Centre Office">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CategorizeInvoice</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Administration_Department" name="Administration Department">
        <bpmn:flowNodeRef>Task_ProcessInvoiceComplex</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_CollectionBox</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_DataEntry_Office" name="Data Entry Office">
        <bpmn:flowNodeRef>Timer_StartDaily10AM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterSAPSystemComplex</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Validation_Office" name="Validation Office">
        <bpmn:flowNodeRef>Timer_StartHourlyReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ValidateInvoiceBigProcess</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Payment_Office" name="Payment Office">
        <bpmn:flowNodeRef>Timer_StartWeeklyBeginning</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExecutePaymentBigProcess</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Registry_Office" name="Registry Office">
        <bpmn:flowNodeRef>Task_ArchiveInvoices</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Final</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event - Invoice Received -->
    <bpmn:startEvent id="StartEvent_1" name="Invoice from Client">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_Categorize</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Mail Centre Tasks -->
    <bpmn:userTask id="Task_CategorizeInvoice" name="Categorize Invoice by Staff Member">
      <bpmn:incoming>SequenceFlow_Categorize</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ForwardAdmin</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Administration Department Tasks -->
    <bpmn:task id="Task_ProcessInvoiceComplex" name="Process Invoice (Complex Process)">
      <bpmn:incoming>SequenceFlow_ForwardAdmin</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CollectionBoxTrigger</bpmn:outgoing>
    </bpmn:task>

    <!-- Collection Box Event -->
    <bpmn:startEvent id="Timer_StartDaily10AM" name="Every Workday at 10 AM">
      <bpmn:timerEventDefinition xsi:type="bpmn:TimeCycle">R/PT24H</bpmn:timerEventDefinition>
      <bpmn:outgoing>SequenceFlow_EnterSAP</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Data Entry Office Tasks -->
    <bpmn:userTask id="Task_EnterSAPSystemComplex" name="Enter All Data in SAP System (Complex Process)">
      <bpmn:incoming>SequenceFlow_EnterSAP</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ValidationTrigger</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Validation Office Tasks -->
    <bpmn:startEvent id="Timer_StartHourlyReview" name="Every Hour">
      <bpmn:timerEventDefinition xsi:type="bpmn:TimeCycle">R/PT1H</bpmn:timerEventDefinition>
      <bpmn:outgoing>SequenceFlow_ValidationTrigger</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_ValidateInvoiceBigProcess" name="Execute Validation Process (Big Process)">
      <bpmn:incoming>SequenceFlow_ValidationTrigger</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PaymentTrigger</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Payment Office Tasks -->
    <bpmn:startEvent id="Timer_StartWeeklyBeginning" name="Beginning of Every Week">
      <bpmn:timerEventDefinition xsi:type="bpmn:TimeDate">R/1W</bpmn:timerEventDefinition>
      <bpmn:outgoing>SequenceFlow_ExecutePayment</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_ExecutePaymentBigProcess" name="Execute Payment Process (Big Process)">
      <bpmn:incoming>SequenceFlow_ExecutePayment</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ArchiveTrigger</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Registry Office Tasks -->
    <bpmn:userTask id="Task_ArchiveInvoices" name="Archive All Invoices">
      <bpmn:incoming>SequenceFlow_ArchiveTrigger</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FinalEnd</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Final" name="Invoices Archived">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SequenceFlow_FinalEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_Categorize" sourceRef="StartEvent_1" targetRef="Task_CategorizeInvoice"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ForwardAdmin" name="Forward to Administration Department">
      <bpmn:name>Forward Invoice</bpmn:name>
      <bpmn:sourceRef>Task_CategorizeInvoice</bpmn:sourceRef>
      <bpmn:targetRef>Task_ProcessInvoiceComplex</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Collection Box to Data Entry -->
    <bpmn:startEvent id="Timer_StartDaily10AM" name="Every Workday at 10 AM">
      <bpmn:timerEventDefinition xsi:type="bpmn:TimeCycle">R/PT24H</bpmn:timerEventDefinition>
      <bpmn:outgoing>SequenceFlow_EnterSAP</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Data Entry Office Tasks -->
    <bpmn:userTask id="Task_EnterSAPSystemComplex" name="Enter All Data in SAP System (Complex Process)">
      <bpmn:incoming>SequenceFlow_EnterSAP</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ValidationTrigger</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Validation Office Tasks -->
    <bpmn:startEvent id="Timer_StartHourlyReview" name="Every Hour">
      <bpmn:timerEventDefinition xsi:type="bpmn:TimeCycle">R/PT1H</bpmn:timerEventDefinition>
      <bpmn:outgoing>SequenceFlow_ValidationTrigger</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_ValidateInvoiceBigProcess" name="Execute Validation Process (Big Process)">
      <bpmn:incoming>SequenceFlow_ValidationTrigger</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PaymentTrigger</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Payment Office Tasks -->
    <bpmn:startEvent id="Timer_StartWeeklyBeginning" name="Beginning of Every Week">
      <bpmn:timerEventDefinition xsi:type="bpmn:TimeDate">R/1W</bpmn:timerEventDefinition>
      <bpmn:outgoing>SequenceFlow_ExecutePayment</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_ExecutePaymentBigProcess" name="Execute Payment Process (Big Process)">
      <bpmn:incoming>SequenceFlow_ExecutePayment</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ArchiveTrigger</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Registry Office Tasks -->
    <bpmn:userTask id="Task_ArchiveInvoices" name="Archive All Invoices">
      <bpmn:incoming>SequenceFlow_ArchiveTrigger</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FinalEnd</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Final" name="Invoices Archived">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SequenceFlow_FinalEnd</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>