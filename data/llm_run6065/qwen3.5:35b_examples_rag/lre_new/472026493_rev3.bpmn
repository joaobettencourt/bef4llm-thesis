<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_HardwarePurchase">
    <bpmn:participant id="Participant_HWProcess" name="Hardware Purchase Process" processRef="Process_HW"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_HW" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Employee" name="Employee">
        <bpmn:flowNodeRef>LaneTask_Request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LaneEvent_DeniedNotification</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IT" name="IT Department">
        <bpmn:flowNodeRef>LaneTask_AnalyzeRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LaneGateway_InitialDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LaneTask_EditComplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LaneTask_PrepareOrder</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Supplier" name="Supplier">
        <bpmn:flowNodeRef>LaneEvent_OfferReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LaneTask_OrderAccepted</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Management" name="Management">
        <bpmn:flowNodeRef>LaneGateway_MgmtDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LaneTask_AnalyzeRequestMgmt</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Finance" name="Financial Department">
        <bpmn:flowNodeRef>LaneGateway_ResourcesFound</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LaneTask_FindResources</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LaneTask_ProcessInvoice</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="Start_None_1" name="Request for new hardware received">
      <bpmn:outgoing>bpmn:SequenceFlow_Start</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- IT Department Initial Analysis -->
    <bpmn:userTask id="LaneTask_AnalyzeRequest" name="Analyze request for new hardware">
      <bpmn:incoming>bpmn:SequenceFlow_Start</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_InitialDecision</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Initial Decision Gateway -->
    <bpmn:exclusiveGateway id="LaneGateway_InitialDecision">
      <bpmn:incoming>bpmn:SequenceFlow_InitialDecision</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_DeniedPath</bpmn:outgoing>
      <bpmn:outgoing>bpmn:SequenceFlow_ApprovedPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Denied Path -->
    <bpmn:userTask id="LaneEvent_DeniedNotification" name="Inform employee via email about denial">
      <bpmn:incoming>bpmn:SequenceFlow_DeniedPath</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_EndDenied</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Approved Path - Edit and Complete Request -->
    <bpmn:userTask id="LaneTask_EditComplete" name="Edit and complete request">
      <bpmn:incoming>bpmn:SequenceFlow_ApprovedPath</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_SendToSupplier</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Send Email to Supplier -->
    <bpmn:messageEvent id="LaneMessage_SupplierRequest" name="Send email asking about prices">
      <bpmn:incoming>bpmn:SequenceFlow_SendToSupplier</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_WaitOffer</bpmn:outgoing>
    </bpmn:messageEvent>

    <!-- Wait for Supplier Offer -->
    <bpmn:intermediateCatchEvent id="LaneEvent_OfferReceived" name="Receive supplier offer">
      <bpmn:incoming>bpmn:SequenceFlow_WaitOffer</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_FillForm</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Fill Form and Send to Management -->
    <bpmn:userTask id="LaneTask_SendToMgmt" name="Fill form and send request to management">
      <bpmn:incoming>bpmn:SequenceFlow_FillForm</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_MgmtAnalysis</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Management Analysis -->
    <bpmn:userTask id="LaneTask_AnalyzeRequestMgmt" name="Management analyses request">
      <bpmn:incoming>bpmn:SequenceFlow_MgmtAnalysis</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_MgmtDecision</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Management Decision Gateway -->
    <bpmn:exclusiveGateway id="LaneGateway_MgmtDecision">
      <bpmn:incoming>bpmn:SequenceFlow_MgmtDecision</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_ApprovedByMgmt</bpmn:outgoing>
      <bpmn:outgoing>bpmn:SequenceFlow_ReworkPath</bpmn:outgoing>
      <bpmn:outgoing>bpmn:SequenceFlow_DeniedByMgmt</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Approved by Management Path -->
    <bpmn:userTask id="LaneTask_ForwardOffer" name="Forward offer to financial and IT departments">
      <bpmn:incoming>bpmn:SequenceFlow_ApprovedByMgmt</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_SplitParallel</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel Split for Financial and IT -->
    <bpmn:parallelGateway id="LaneGateway_ParallelSplit">
      <bpmn:incoming>bpmn:SequenceFlow_SplitParallel</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_FinanceResources</bpmn:outgoing>
      <bpmn:outgoing>bpmn:SequenceFlow_ITOrderPrep</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Financial Department - Find Resources -->
    <bpmn:userTask id="LaneTask_FindResources" name="Find financial resources">
      <bpmn:incoming>bpmn:SequenceFlow_FinanceResources</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_ResourcesFound</bpmn:outgoing>
    </bpmn:userTask>

    <!-- IT Department - Prepare Order -->
    <bpmn:userTask id="LaneTask_PrepareOrder" name="Prepare order and send to supplier">
      <bpmn:incoming>bpmn:SequenceFlow_ITOrderPrep</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_SendOrderToSupplier</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Wait for Order Acceptance -->
    <bpmn:messageEvent id="LaneMessage_OrderAccepted" name="Receive order acceptance from supplier">
      <bpmn:incoming>bpmn:SequenceFlow_SendOrderToSupplier</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_WaitAcceptance</bpmn:outgoing>
    </bpmn:messageEvent>

    <!-- Parallel Join for Resources and Acceptance -->
    <bpmn:parallelGateway id="LaneGateway_ParallelJoin">
      <bpmn:incoming>bpmn:SequenceFlow_ResourcesFound</bpmn:incoming>
      <bpmn:incoming>bpmn:SequenceFlow_WaitAcceptance</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_HardwareReceived</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Hardware Received -->
    <bpmn:userTask id="LaneEvent_HardwareReceived" name="Receive hardware">
      <bpmn:incoming>bpmn:SequenceFlow_HardwareReceived</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_ProcessInvoice</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Process Invoice -->
    <bpmn:userTask id="LaneTask_ProcessInvoice" name="Process invoice">
      <bpmn:incoming>bpmn:SequenceFlow_ProcessInvoice</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_EndSuccess</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Rework Path -->
    <bpmn:userTask id="LaneEvent_ReworkNotification" name="Send request back for rework">
      <bpmn:incoming>bpmn:SequenceFlow_ReworkPath</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_ReturnToEditComplete</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Denied by Management Path -->
    <bpmn:endEvent id="End_DeniedByMgmt" name="Request denied">
      <bpmn:incoming>bpmn:SequenceFlow_DeniedByMgmt</bpmn:incoming>
    </bpmn:endEvent>

    <!-- End Events -->
    <bpmn:endEvent id="End_Success" name="Hardware purchased successfully">
      <bpmn:incoming>bpmn:SequenceFlow_EndSuccess</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="End_DeniedInitial" name="Request denied initially">
      <bpmn:incoming>bpmn:SequenceFlow_EndDenied</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_Start" sourceRef="Start_None_1" targetRef="LaneTask_AnalyzeRequest"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_InitialDecision" name="Analyzed?" sourceRef="LaneTask_AnalyzeRequest" targetRef="LaneGateway_InitialDecision">
      <bpmn:name>Analyzed?</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_DeniedPath" name="Denied" sourceRef="LaneGateway_InitialDecision" targetRef="LaneEvent_DeniedNotification">
      <bpmn:name conditionExpression xsi:type="formalExpression">${approved=false}</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ApprovedPath" name="Approved" sourceRef="LaneGateway_InitialDecision" targetRef="LaneTask_EditComplete">
      <bpmn:name conditionExpression xsi:type="formalExpression">${approved=true}</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_EndDenied" sourceRef="LaneEvent_DeniedNotification" targetRef="End_DeniedInitial"/>

    <bpmn:sequenceFlow id="SequenceFlow_SendToSupplier" name="Send email to supplier" sourceRef="LaneTask_EditComplete" targetRef="LaneMessage_SupplierRequest">
      <bpmn:name conditionExpression xsi:type="formalExpression">${requestCompleted}</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_WaitOffer" sourceRef="LaneMessage_SupplierRequest" targetRef="LaneEvent_OfferReceived"/>

    <bpmn:sequenceFlow id="SequenceFlow_FillForm" name="Fill form and send to management" sourceRef="LaneEvent_OfferReceived" targetRef="LaneTask_SendToMgmt">
      <bpmn:name conditionExpression xsi:type="formalExpression">${offerReceived}</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_MgmtAnalysis" sourceRef="LaneTask_SendToMgmt" targetRef="LaneTask_AnalyzeRequestMgmt"/>

    <bpmn:sequenceFlow id="SequenceFlow_MgmtDecision" name="Management decision?" sourceRef="LaneTask_AnalyzeRequestMgmt" targetRef="LaneGateway_MgmtDecision">
      <bpmn:name conditionExpression xsi:type="formalExpression">${requestSubmitted}</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ApprovedByMgmt" name="Approved by management" sourceRef="LaneGateway_MgmtDecision" targetRef="LaneTask_ForwardOffer">
      <bpmn:name conditionExpression xsi:type="formalExpression">${approved=true}</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ReworkPath" name="Send back for rework" sourceRef="LaneGateway_MgmtDecision" targetRef="LaneEvent_ReworkNotification">
      <bpmn:name conditionExpression xsi:type="formalExpression">${reworkRequired}</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_DeniedByMgmt" name="Denied by management" sourceRef="LaneGateway_MgmtDecision" targetRef="End_DeniedByMgmt">
      <bpmn:name conditionExpression xsi:type="formalExpression">${approved=false}</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_SplitParallel" sourceRef="LaneTask_ForwardOffer" targetRef="LaneGateway_ParallelSplit"/>

    <bpmn:sequenceFlow id="SequenceFlow_FinanceResources" name="Find resources" sourceRef="LaneGateway_ParallelSplit" targetRef="LaneTask_FindResources">
      <bpmn:name conditionExpression xsi:type="formalExpression">${forwardedToFinance}</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ITOrderPrep" name="Prepare order" sourceRef="LaneGateway_ParallelSplit" targetRef="LaneTask_PrepareOrder">
      <bpmn:name conditionExpression xsi:type="formalExpression">${forwardedToIT}</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ResourcesFound" sourceRef="LaneTask_FindResources" targetRef="LaneGateway_ParallelJoin">
      <bpmn:name conditionExpression xsi:type="formalExpression">${resourcesAvailable}</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_SendOrderToSupplier" sourceRef="LaneTask_PrepareOrder" targetRef="LaneMessage_OrderAccepted">
      <bpmn:name conditionExpression xsi:type="formalExpression">${orderPrepared}</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_WaitAcceptance" sourceRef="LaneMessage_OrderAccepted" targetRef="LaneGateway_ParallelJoin">
      <bpmn:name conditionExpression xsi:type="formalExpression">${orderAccepted}</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_HardwareReceived" sourceRef="LaneGateway_ParallelJoin" targetRef="LaneEvent_HardwareReceived">
      <bpmn:name conditionExpression xsi:type="formalExpression">${resourcesFound AND orderAccepted}</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ProcessInvoice" sourceRef="LaneEvent_HardwareReceived" targetRef="LaneTask_ProcessInvoice">
      <bpmn:name conditionExpression xsi:type="formalExpression">${hardwareReceived}</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_EndSuccess" sourceRef="LaneTask_ProcessInvoice" targetRef="End_Success"/>

    <!-- Rework Loop Back -->
    <bpmn:sequenceFlow id="SequenceFlow_ReturnToEditComplete" name="Return to edit and complete request" sourceRef="LaneEvent_ReworkNotification" targetRef="LaneTask_EditComplete">
      <bpmn:name conditionExpression xsi:type="formalExpression">${reworkRequired}</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>