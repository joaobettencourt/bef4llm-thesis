<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                 xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                 xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                 xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
                 id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Website Development Process" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_DesignTeam" name="Web Design Team">
        <bpmn:flowNodeRef>LaneTask_Meeting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LaneGateway_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LaneTask_Storyboard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LaneTask_DesignDev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LaneGateway_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LaneParallel_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LaneTask_ContentDraft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LaneGateway_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LaneParallel_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LaneTask_ContentFinal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LaneTask_BuildReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LaneGateway_4</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Marketing" name="Marketing Team">
        <bpmn:flowNodeRef>LaneTask_ContentReview</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Informational Meeting">
      <bpmn:outgoing>bpmn:SequenceFlow_Meeting</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Informational meeting -->
    <bpmn:userTask id="LaneTask_Meeting" name="Conduct informational meeting">
      <bpmn:incoming>bpmn:SequenceFlow_Meeting</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_StoryboardAgreement</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway 1: Meeting successful? -->
    <bpmn:exclusiveGateway id="LaneGateway_1">
      <bpmn:incoming>bpmn:SequenceFlow_MeetingSuccessCheck</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_EndProcess</bpmn:outgoing>
      <bpmn:outgoing>bpmn:SequenceFlow_StoryboardCreation</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Create storyboard -->
    <bpmn:userTask id="LaneTask_Storyboard" name="Create storyboard">
      <bpmn:incoming>bpmn:SequenceFlow_StoryboardAgreement</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_AgreementCheck</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway 2: Agreement on storyboard -->
    <bpmn:exclusiveGateway id="LaneGateway_2">
      <bpmn:incoming>bpmn:SequenceFlow_AgreementCheck</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_DesignDevStart</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Parallel Gateway for simultaneous work -->
    <bpmn:parallelGateway id="LaneParallel_1">
      <bpmn:incoming>bpmn:SequenceFlow_DesignDevStart</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_ContentPrep</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Design and development -->
    <bpmn:userTask id="LaneTask_DesignDev" name="Design and develop website">
      <bpmn:incoming>bpmn:SequenceFlow_ContentPrep</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_BuildReviewStart1</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Prepare initial content draft -->
    <bpmn:userTask id="LaneTask_ContentDraft" name="Prepare initial content draft">
      <bpmn:incoming>bpmn:SequenceFlow_DesignDevStart</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_ReviewNeededCheck</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway 3: Review needed? -->
    <bpmn:exclusiveGateway id="LaneGateway_3">
      <bpmn:incoming>bpmn:SequenceFlow_ReviewNeededCheck</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_MarketingReview</bpmn:outgoing>
      <bpmn:outgoing>bpmn:SequenceFlow_ContentFinalStart</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Marketing review -->
    <bpmn:userTask id="LaneTask_ContentReview" name="Conduct content review">
      <bpmn:incoming>bpmn:SequenceFlow_MarketingReview</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_FinalContentStart</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Create final content -->
    <bpmn:userTask id="LaneTask_ContentFinal" name="Create final version of content">
      <bpmn:incoming>bpmn:SequenceFlow_FinalContentStart</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_BuildReviewJoin2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel Gateway for joining -->
    <bpmn:parallelGateway id="LaneParallel_2">
      <bpmn:incoming>bpmn:SequenceFlow_DesignDevComplete</bpmn:incoming>
      <bpmn:incoming>bpmn:SequenceFlow_ContentFinalJoin</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_BuildReviewStart2</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Build and review website -->
    <bpmn:userTask id="LaneTask_BuildReview" name="Build and review website">
      <bpmn:incoming>bpmn:SequenceFlow_BuildReviewStart2</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_ApprovalCheck</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway 4: Site approved? -->
    <bpmn:exclusiveGateway id="LaneGateway_4">
      <bpmn:incoming>bpmn:SequenceFlow_ApprovalCheck</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_EndProcessSuccess</bpmn:outgoing>
      <bpmn:outgoing>bpmn:SequenceFlow_BuildReviewLoopback</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_1" name="Process Completed">
      <bpmn:incoming>bpmn:SequenceFlow_EndProcessSuccess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_Meeting" sourceRef="StartEvent_1" targetRef="LaneTask_Meeting"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_MeetingSuccessCheck" name="Meeting successful?" 
                       sourceRef="LaneTask_Meeting" targetRef="LaneGateway_1">
      <bpmn:name>Is meeting successful?</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_EndProcess" name="No - End Process" 
                       sourceRef="LaneGateway_1" targetRef="EndEvent_1">
      <bpmn:name>No</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_StoryboardCreation" name="Yes - Continue" 
                       sourceRef="LaneGateway_1" targetRef="LaneTask_Storyboard">
      <bpmn:name>Yes</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_AgreementCheck" name="Agreement reached?" 
                       sourceRef="LaneTask_Storyboard" targetRef="LaneGateway_2">
      <bpmn:name>Is agreement on storyboard?</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_DesignDevStart" name="Storyboard agreed" 
                       sourceRef="LaneGateway_2" targetRef="LaneParallel_1"/>

    <bpmn:sequenceFlow id="SequenceFlow_ContentPrep" name="Simultaneous work starts - Design/Dev" 
                       sourceRef="LaneParallel_1" targetRef="LaneTask_DesignDev">
      <bpmn:name>Start design and development</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ContentDraftStart" name="Simultaneous work starts - Content" 
                       sourceRef="LaneParallel_1" targetRef="LaneTask_ContentDraft">
      <bpmn:name>Prepare initial content draft</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_DesignDevComplete" name="Design complete" 
                       sourceRef="LaneTask_DesignDev" targetRef="LaneParallel_2">
      <bpmn:name>Design and development completed</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ContentDraftComplete" name="Content draft complete" 
                       sourceRef="LaneTask_ContentDraft" targetRef="LaneGateway_3">
      <bpmn:name>Draft content completed</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_MarketingReview" name="Yes - Review needed" 
                       sourceRef="LaneGateway_3" targetRef="LaneTask_ContentReview">
      <bpmn:name>Marketing review required</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_FinalContentStart" name="No - Skip review" 
                       sourceRef="LaneGateway_3" targetRef="LaneTask_ContentFinal">
      <bpmn:name>No marketing review needed</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_FinalContentComplete" name="Review complete" 
                       sourceRef="LaneTask_ContentReview" targetRef="LaneParallel_2">
      <bpmn:name>Marketing review completed</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceContentFinalJoin" name="Content final complete" 
                       sourceRef="LaneTask_ContentFinal" targetRef="LaneParallel_2">
      <bpmn:name>Final content completed</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_BuildReviewStart1" name="Design complete - join gateway" 
                       sourceRef="LaneTask_DesignDev" targetRef="LaneParallel_2">
      <bpmn:name>Join parallel flow</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_BuildReviewStart2" name="Both complete - Build website" 
                       sourceRef="LaneParallel_2" targetRef="LaneTask_BuildReview">
      <bpmn:name>All components ready</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ApprovalCheck" name="Site approved?" 
                       sourceRef="LaneTask_BuildReview" targetRef="LaneGateway_4">
      <bpmn:name>Is site approved?</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_EndProcessSuccess" name="Yes - Completed" 
                       sourceRef="LaneGateway_4" targetRef="EndEvent_1">
      <bpmn:name>Site approved</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_BuildReviewLoopback" name="No - Rebuild" 
                       sourceRef="LaneGateway_4" targetRef="LaneTask_BuildReview">
      <bpmn:name>Site not approved</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>