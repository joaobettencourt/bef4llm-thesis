<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Web Development Process" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_BusinessAnalyst" name="Business Analyst">
        <bpmn:flowNodeRef>Task_CollectData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CheckDesign</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_WebDesigner" name="Web Designer">
        <bpmn:flowNodeRef>Task_IntegrateDesign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AdjustDesign</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Specialist" name="PHP/HTML/CSS Specialist">
        <bpmn:flowNodeRef>Task_IntegrateImplementation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AdjustImplementation</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Tester" name="Tester">
        <bpmn:flowNodeRef>Task_TestWebsite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CheckTest</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Process Starts">
      <bpmn:outgoing>bpmn:SequenceFlow_Start</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Business Analyst Tasks & Gateway -->
    <bpmn:userTask id="Task_CollectData" name="Collect Data &amp; Conduct Analysis">
      <bpmn:incoming>bpmn:SequenceFlow_Start</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_ToDesign</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Web Designer Tasks -->
    <bpmn:userTask id="Task_IntegrateDesign" name="Integrate Design &amp; Decide Placement">
      <bpmn:incoming>bpmn:SequenceFlow_ToDesign</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_AnalystCheck</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Design Adjustment Loop -->
    <bpmn:userTask id="Task_AdjustDesign" name="Change &amp; Integrate Again">
      <bpmn:incoming>bpmn:SequenceFlow_NeedAdjustment</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_AnalystCheckAgain</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Design Decision Gateway -->
    <bpmn:exclusiveGateway id="Gateway_CheckDesign" name="Design OK?">
      <bpmn:incoming>bpmn:SequenceFlow_AnalystCheck</bpmn:incoming>
      <bpmn:incoming>bpmn:SequenceFlow_AnalystCheckAgain</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_DesignOK</bpmn:outgoing>
      <bpmn:outgoing>bpmn:SequenceFlow_NeedAdjustment</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Implementation Phase -->
    <bpmn:userTask id="Task_IntegrateImplementation" name="Integrate with Overall Implementation">
      <bpmn:incoming>bpmn:SequenceFlow_DesignOK</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_ToTest</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Testing Phase -->
    <bpmn:userTask id="Task_TestWebsite" name="Test Final Website">
      <bpmn:incoming>bpmn:SequenceFlow_ToTest</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_CheckResult</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Test Decision Gateway -->
    <bpmn:exclusiveGateway id="Gateway_CheckTest" name="Test OK?">
      <bpmn:incoming>bpmn:SequenceFlow_CheckResult</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_TestOK</bpmn:outgoing>
      <bpmn:outgoing>bpmn:SequenceFlow_NeedFix</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Test Adjustment Loop -->
    <bpmn:userTask id="Task_AdjustImplementation" name="Adjust &amp; Integrate Again">
      <bpmn:incoming>bpmn:SequenceFlow_NeedFix</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_ToTestAgain</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_1" name="Process Ends">
      <bpmn:incoming>bpmn:SequenceFlow_TestOK</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_Start" sourceRef="StartEvent_1" targetRef="Task_CollectData"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ToDesign" name="Then Web Designer Works" sourceRef="Task_CollectData" targetRef="Task_IntegrateDesign">
      <bpmn:description>BA Waits for Design</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- BA Check Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_AnalystCheck" name="Then she checks design" sourceRef="Task_IntegrateDesign" targetRef="Gateway_CheckDesign">
      <bpmn:description>Analyst Checks Design</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Adjustment Loop Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_AnalystCheckAgain" name="Re-check after adjustment" sourceRef="Task_AdjustDesign" targetRef="Gateway_CheckDesign"/>

    <!-- Design OK Path -->
    <bpmn:sequenceFlow id="SequenceFlow_DesignOK" name="If design is OK" sourceRef="Gateway_CheckDesign" targetRef="Task_IntegrateImplementation">
      <bpmn:description>Yes</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Design Adjustment Path -->
    <bpmn:sequenceFlow id="SequenceFlow_NeedAdjustment" name="If needs adjustment" sourceRef="Gateway_CheckDesign" targetRef="Task_AdjustDesign">
      <bpmn:description>No</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Implementation to Test -->
    <bpmn:sequenceFlow id="SequenceFlow_ToTest" name="Then Tester Tests" sourceRef="Task_IntegrateImplementation" targetRef="Task_TestWebsite"/>

    <!-- Test Result Path -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckResult" name="Check Results" sourceRef="Task_TestWebsite" targetRef="Gateway_CheckTest">
      <bpmn:description>Tester Checks</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Test OK Path -->
    <bpmn:sequenceFlow id="SequenceFlow_TestOK" name="If test is OK" sourceRef="Gateway_CheckTest" targetRef="EndEvent_1">
      <bpmn:description>Yes</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Test Fix Loop Path -->
    <bpmn:sequenceFlow id="SequenceFlow_NeedFix" name="If test is not ok" sourceRef="Gateway_CheckTest" targetRef="Task_AdjustImplementation">
      <bpmn:description>No</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Fix Loop Back to Test -->
    <bpmn:sequenceFlow id="SequenceFlow_ToTestAgain" name="Then test again" sourceRef="Task_AdjustImplementation" targetRef="Task_TestWebsite"/>

  </bpmn:process>
</bpmn:definitions>