<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_RewardTraining">
    <bpmn:participant id="Participant_ManagementHRFinance" name="Reward and Training Process" processRef="Process_RewardTraining"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_RewardTraining" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Management" name="Management Department">
        <bpmn:flowNodeRef>LaneTask_PerformanceCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LaneGateway_Threshold1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LaneGateway_RewardType</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_HR" name="Human Resources Department">
        <bpmn:flowNodeRef>LaneTask_DismissEmployee</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LaneTask_ProvideTraining</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Finance" name="Finance Department">
        <bpmn:flowNodeRef>LaneTask_CalculateReward</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_PerformanceCheck" name="Employee Performance Check">
      <bpmn:outgoing>bpmn:SequenceFlow_StartToManagement</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Management Tasks and Gateways -->
    <bpmn:userTask id="LaneTask_PerformanceCheck" name="Check Employee Performance">
      <bpmn:incoming>bpmn:SequenceFlow_StartToManagement</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_ManagementToGateway1</bpmn:outgoing>
    </bpmn:userTask>

    <!-- First Gateway - Performance Threshold Check -->
    <bpmn:exclusiveGateway id="LaneGateway_Threshold1">
      <bpmn:incoming>bpmn:SequenceFlow_ManagementToGateway1</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_DismissalPath</bpmn:outgoing>
      <bpmn:outgoing>bpmn:SequenceFlow_TrainingPath</bpmn:outgoing>
      <bpmn:outgoing>bpmn:SequenceFlow_RewardPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Dismissal Path (< 20%) -->
    <bpmn:userTask id="LaneTask_DismissEmployee" name="Dismiss Employee">
      <bpmn:incoming>bpmn:SequenceFlow_ManagementToHR</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_HRToEnd1</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Training Path (20% - 50%) -->
    <bpmn:userTask id="LaneTask_ProvideTraining" name="Provide Employee Training">
      <bpmn:incoming>bpmn:SequenceFlow_ManagementToHR_Training</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_HRToEnd2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Reward Path (> 75%) -->
    <bpmn:exclusiveGateway id="LaneGateway_RewardType">
      <bpmn:incoming>bpmn:SequenceFlow_ManagementToRewardGate</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_FinancialPath</bpmn:outgoing>
      <bpmn:outgoing>bpmn:SequenceFlow_BenefitPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Financial Reward Path -->
    <bpmn:userTask id="LaneTask_CalculateReward" name="Calculate and Pay Financial Reward">
      <bpmn:incoming>bpmn:SequenceFlow_FinanceToCalc</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_ManagementToEnd3</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Benefit Path -->
    <bpmn:userTask id="LaneTask_ChooseBenefit" name="Choose Appropriate Benefit">
      <bpmn:incoming>bpmn:SequenceFlow_ManagementToChoose</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_ManagementToEnd4</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Announce Employee of Month -->
    <bpmn:userTask id="LaneTask_AnnounceEmployee" name="Announce Employee of the Month">
      <bpmn:incoming>bpmn:SequenceFlow_ManagementToAnnounce</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_EndAllPaths</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_Dismissal" name="Employee Dismissed">
      <bpmn:incoming>bpmn:SequenceFlow_HRToEnd1</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_Training" name="Training Completed">
      <bpmn:incoming>bpmn:SequenceFlow_HRToEnd2</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_RewardFinancial" name="Reward Processed - Financial">
      <bpmn:incoming>bpmn:SequenceFlow_ManagementToEnd3</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_Benefit" name="Benefit Assigned">
      <bpmn:incoming>bpmn:SequenceFlow_ManagementToEnd4</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToManagement" sourceRef="StartEvent_PerformanceCheck" targetRef="LaneTask_PerformanceCheck"/>

    <bpmn:sequenceFlow id="SequenceFlow_ManagementToGateway1" name="Performance Check Complete" sourceRef="LaneTask_PerformanceCheck" targetRef="LaneGateway_Threshold1">
      <bpmn:name>Is Performance &lt; 20%?</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Dismissal Path -->
    <bpmn:sequenceFlow id="SequenceFlow_DismissalPath" name="Performance &lt;= 20%" sourceRef="LaneGateway_Threshold1" targetRef="EndEvent_Dismissal">
      <bpmn:name conditionExpression xsi:type="formalExpression">${performancePercent &lt;= 20}</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Training Path -->
    <bpmn:sequenceFlow id="SequenceFlow_TrainingPath" name="Performance 20% - 50%" sourceRef="LaneGateway_Threshold1" targetRef="EndEvent_Training">
      <bpmn:name conditionExpression xsi:type="formalExpression">${performancePercent &gt;= 20 AND performancePercent &lt; 50}</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Reward Path -->
    <bpmn:sequenceFlow id="SequenceFlow_RewardPath" name="Performance > 75%" sourceRef="LaneGateway_Threshold1" targetRef="LaneGateway_RewardType">
      <bpmn:name conditionExpression xsi:type="formalExpression">${performancePercent &gt;= 75}</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Reward Type Decision -->
    <bpmn:sequenceFlow id="SequenceFlow_FinancialPath" name="Financial Reward" sourceRef="LaneGateway_RewardType" targetRef="EndEvent_Dismissal">
      <bpmn:name conditionExpression xsi:type="formalExpression">${rewardType == 'financial'}</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Benefit Path -->
    <bpmn:sequenceFlow id="SequenceFlow_BenefitPath" name="Other Benefit" sourceRef="LaneGateway_RewardType" targetRef="EndEvent_Dismissal">
      <bpmn:name conditionExpression xsi:type="formalExpression">${rewardType == 'benefit'}</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>