<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="ERICS Company Reimbursement Process" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Administration" name="Administration Department">
        <bpmn:flowNodeRef>LaneTask_CreateContact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LaneGateway_CustomerType</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Finance" name="Finance Department">
        <bpmn:flowNodeRef>LaneTask_ChooseBeneficiary</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LaneTask_DeterminePeriod</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CustomerService" name="Customer Service">
        <bpmn:flowNodeRef>LaneTask_SelectGroupAssociation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LaneTask_ManualSelection</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Reimbursement Request Received">
      <bpmn:outgoing>bpmn:SequenceFlow_Start</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Administration Tasks and Gateway -->
    <bpmn:userTask id="LaneTask_CreateContact" name="Create Reimbursement Contact">
      <bpmn:incoming>bpmn:SequenceFlow_Start</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_1</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Finance Tasks -->
    <bpmn:userTask id="LaneTask_ChooseBeneficiary" name="Choose Beneficiary">
      <bpmn:incoming>bpmn:SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_3</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="LaneTask_DeterminePeriod" name="Determine Refund Period">
      <bpmn:incoming>bpmn:SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_5</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Customer Service Tasks -->
    <bpmn:userTask id="LaneTask_SelectGroupAssociation" name="Select Group Association">
      <bpmn:incoming>bpmn:SequenceFlow_6</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_7</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="LaneTask_ManualSelection" name="Manual Customer Selection">
      <bpmn:incoming>bpmn:SequenceFlow_8</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_9</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway for Customer Type Check -->
    <bpmn:exclusiveGateway id="LaneGateway_CustomerType">
      <bpmn:incoming>bpmn:SequenceFlow_5</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_6</bpmn:outgoing>
      <bpmn:outgoing>bpmn:SequenceFlow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Parallel Gateway for End Activities -->
    <bpmn:parallelGateway id="LaneParallel_End">
      <bpmn:incoming>bpmn:SequenceFlow_7</bpmn:incoming>
      <bpmn:incoming>bpmn:SequenceFlow_9</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_CreditNote</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- End Activities -->
    <bpmn:userTask id="LaneTask_SetThreshold" name="Set Threshold">
      <bpmn:incoming>bpmn:SequenceFlow_10</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_CreditNote</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel End Activities -->
    <bpmn:userTask id="LaneTask_PrintCreditNote" name="Print and Send Credit Note">
      <bpmn:incoming>bpmn:SequenceFlow_CreditNote</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_End1</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="LaneTask_Payment" name="Calculate and Pay Reimbursement">
      <bpmn:incoming>bpmn:SequenceFlow_5</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_End2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_Success">
      <bpmn:incoming>bpmn:SequenceFlow_End1</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_Payment" name="Reimbursement Processed">
      <bpmn:incoming>bpmn:SequenceFlow_End2</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_Start" sourceRef="StartEvent_1" targetRef="LaneTask_CreateContact"/>

    <bpmn:sequenceFlow id="SequenceFlow_2" name="After Contact Created" sourceRef="LaneTask_CreateContact" targetRef="LaneTask_ChooseBeneficiary"/>

    <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="LaneTask_ChooseBeneficiary" targetRef="LaneParallel_End"/>

    <bpmn:sequenceFlow id="SequenceFlow_4" name="After Beneficiary Chosen" sourceRef="LaneParallel_End" targetRef="LaneTask_DeterminePeriod"/>

    <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="LaneTask_DeterminePeriod" targetRef="LaneGateway_CustomerType"/>

    <!-- Customer Type Decision -->
    <bpmn:sequenceFlow id="SequenceFlow_6" name="Verband Member" sourceRef="LaneGateway_CustomerType" targetRef="LaneTask_SelectGroupAssociation"/>

    <bpmn:sequenceFlow id="SequenceFlow_8" name="Normal Subsidiary" sourceRef="LaneGateway_CustomerType" targetRef="LaneTask_ManualSelection"/>

    <!-- Convergence after Customer Selection -->
    <bpmn:parallelGateway id="LaneParallel_CustomerSelect">
      <bpmn:incoming>bpmn:SequenceFlow_7</bpmn:incoming>
      <bpmn:incoming>bpmn:SequenceFlow_9</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_10</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Threshold Setting -->
    <bpmn:sequenceFlow id="SequenceFlow_7" sourceRef="LaneTask_SelectGroupAssociation" targetRef="LaneParallel_CustomerSelect"/>
    <bpmn:sequenceFlow id="SequenceFlow_9" sourceRef="LaneTask_ManualSelection" targetRef="LaneParallel_CustomerSelect"/>

    <!-- Threshold and Payment Parallel -->
    <bpmn:parallelGateway id="LaneParallel_StartEnd">
      <bpmn:incoming>bpmn:SequenceFlow_10</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_SetThreshold</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Threshold Setting Path -->
    <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="LaneParallel_CustomerSelect" targetRef="LaneTask_SetThreshold"/>
    <bpmn:sequenceFlow id="SequenceFlow_SetThreshold" name="After Refund Period Ends" sourceRef="LaneTask_SetThreshold" targetRef="LaneParallel_End"/>

    <!-- Payment Path -->
    <bpmn:parallelGateway id="LaneParallel_PaymentStart">
      <bpmn:incoming>bpmn:SequenceFlow_5</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_CalculatePayment</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Payment Calculation -->
    <bpmn:sequenceFlow id="SequenceFlow_CalculatePayment" sourceRef="LaneParallel_PaymentStart" targetRef="LaneTask_Payment"/>
    <bpmn:sequenceFlow id="SequenceFlow_End2" name="After Payment Made" sourceRef="LaneTask_Payment" targetRef="EndEvent_Payment"/>

  </bpmn:process>
</bpmn:definitions>