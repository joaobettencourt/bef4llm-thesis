<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_WarrantProcess_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_WarrantPossession_001">
    <bpmn:participant id="Participant_SmallClaimsRegistry" name="Small Claims Registry Operations" processRef="Process_WarrantOps_001"/>
    <bpmn:messageFlow id="MessageFlow_PoliceReport" sourceRef="Task_ForwardWarrantPossession" targetRef="StartEvent_PoliceReport">
      <bpmn:sourceRef>Participant_SmallClaimsRegistry</bpmn:sourceRef>
      <bpmn:targetRef>Pool_Police_001</bpmn:targetRef>
    </bpmn:messageFlow>
  </bpmn:collaboration>

  <bpmn:process id="Process_WarrantOps_001">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_ClientServiceBackOffice" name="Client Service Back Office">
        <bpmn:flowNodeRef>StartEvent_RequestReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RetrieveSCTTFile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ForwardWarrantPossession</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateEvent_AwaitReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_PoliceReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RetrieveSCTFile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AttachNewDocument</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_StoreExpandedFile</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_RequestReceived" name="Warrant Possession Request Received">
      <bpmn:outgoing>SequenceFlow_StartToRetrieve</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Tasks -->
    <bpmn:task id="Task_RetrieveSCTTFile" name="Retrieve SCTT File"/>
    
    <bpmn:task id="Task_ForwardWarrantPossession" name="Forward SCT Warrant Possession to Queensland Police">
      <bpmn:outgoing>SequenceFlow_StoreSCTTFile</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Catch Event for waiting report -->
    <bpmn:startEvent id="StartEvent_PoliceReport" name="Police Report Received">
      <bpmn:incoming/>
      <bpmn:outgoing>SequenceFlow_ReportToRetrieve</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Intermediate Catch Event for waiting -->
    <bpmn:intermediateCatchEvent id="IntermediateEvent_AwaitReport" name="Await Police Report">
      <bpmn:incoming>SequenceFlow_StoreSCTTFile</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReportReceivedToRetrieve</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Message -->
    <bpmn:message id="Message_PoliceReport" name="Police Possession Report"/>

    <bpmn:task id="Task_RetrieveSCTFile" name="Retrieve SCT File">
      <bpmn:incoming>SequenceFlow_ReportReceivedToRetrieve</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToAttachDocument</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_AttachNewDocument" name="Attach New SCT Document">
      <bpmn:incoming>SequenceFlow_ToAttachDocument</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StoreExpandedFile</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_StoreExpandedFile" name="Store Expanded SCT Physical File">
      <bpmn:incoming>SequenceFlow_StoreExpandedFile</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToOtherStaff</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_FilePassed" name="File Passed to Other MC Internal Staff">
      <bpmn:incoming>SequenceFlow_ToOtherStaff</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToRetrieve" sourceRef="StartEvent_RequestReceived" targetRef="Task_RetrieveSCTTFile"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ToForwardWarrant" sourceRef="Task_RetrieveSCTTFile" targetRef="Task_ForwardWarrantPossession">
      <bpmn:name>To Forward Warrant</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_StoreSCTTFile" sourceRef="Task_ForwardWarrantPossession" targetRef="IntermediateEvent_AwaitReport">
      <bpmn:name>To Store File</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ReportReceivedToRetrieve" sourceRef="StartEvent_PoliceReport" targetRef="Task_RetrieveSCTFile">
      <bpmn:name>To Retrieve File</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ToAttachDocument" sourceRef="Task_RetrieveSCTFile" targetRef="Task_AttachNewDocument"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_StoreExpandedFile" sourceRef="Task_AttachNewDocument" targetRef="Task_StoreExpandedFile">
      <bpmn:name>To Store Expanded File</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ToOtherStaff" sourceRef="Task_StoreExpandedFile" targetRef="EndEvent_FilePassed"/>

  </bpmn:process>

</bpmn:definitions>