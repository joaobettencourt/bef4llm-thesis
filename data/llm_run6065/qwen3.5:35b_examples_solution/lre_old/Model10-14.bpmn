<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_BillProcessing_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_BillProcess_001">
    <bpmn:participant id="Pool_MPOO_001" name="MPOO" processRef="Proc_MPOO_001"/>
    <bpmn:participant id="Pool_MSPO_002" name="MSPO" processRef="Proc_MSPO_002"/>
    <bpmn:participant id="Pool_GO_003" name="GO" processRef="Proc_GO_003"/>
    <bpmn:participant id="Pool_MPON_004" name="MPON" processRef="Proc_MPON_004"/>

    <!-- Message Flows -->
    <bpmn:messageFlow id="Msg_MPOO_GoMeteringOps_001">
      <bpmn:sourceRef>Task_SendBillMPOOGOMetering_001</bpmn:sourceRef>
      <bpmn:targetRef>CatchEvent_GO_MeteringOps_003</bpmn:targetRef>
    </bpmn:messageFlow>

    <bpmn:messageFlow id="Msg_MSPO_GoMeasurement_002">
      <bpmn:sourceRef>Task_SendBillMSPOGOMeasurement_005</bpmn:sourceRef>
      <bpmn:targetRef>CatchEvent_GO_Measurement_003</bpmn:targetRef>
    </bpmn:messageFlow>

    <bpmn:messageFlow id="Msg_MSPO_GoReadings_002">
      <bpmn:sourceRef>Task_SendBillMSPOAdditionalReadings_005</bpmn:sourceRef>
      <bpmn:targetRef>CatchEvent_GO_AdditionalReadings_003</bpmn:targetRef>
    </bpmn:messageFlow>

    <bpmn:messageFlow id="Msg_MPOO_MPONEquipment_001">
      <bpmn:sourceRef>Task_SendBillMPOOMPONEquipment_001</bpmn:sourceRef>
      <bpmn:targetRef>CatchEvent_MPON_EquipmentAcquisition_004</bpmn:targetRef>
    </bpmn:messageFlow>

    <bpmn:messageFlow id="Msg_MPOO_GOEquipment_001">
      <bpmn:sourceRef>Task_SendBillMPOOGOEquipment_001</bpmn:sourceRef>
      <bpmn:targetRef>CatchEvent_GO_EquipmentAcquisition_003</bpmn:targetRef>
    </bpmn:messageFlow>

    <!-- Response Flows -->
    <bpmn:messageFlow id="Resp_GoToMPOO_Metering_001">
      <bpmn:sourceRef>Task_ConfirmBill_GO_003</bpmn:sourceRef>
      <bpmn:targetRef>CatchEvent_MPOO_ResponseMetering_001</bpmn:targetRef>
    </bpmn:messageFlow>

    <bpmn:messageFlow id="Resp_MPONToMPOO_Equipment_004">
      <bpmn:sourceRef>Task_ConfirmBill_MPON_004</bpmn:sourceRef>
      <bpmn:targetRef>CatchEvent_MPOO_ResponseEquipment_001</bpmn:targetRef>
    </bpmn:messageFlow>

  </bpmn:collaboration>

  <!-- MPOO Process -->
  <bpmn:process id="Proc_MPOO_001" isExecutable="false">
    <bpmn:startEvent id="StartMPOO_BillMetering_001">
      <bpmn:name>Metering Bill Ready</bpmn:name>
      <bpmn:outgoing>Seq_StartToSendMetering_001</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:startEvent id="StartMPOO_BillEquipment_001">
      <bpmn:name>Equipment Bill Ready</bpmn:name>
      <bpmn:outgoing>Seq_StartToEquipDecision_001</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task to send Metering Bill to GO -->
    <bpmn:task id="Task_SendBillMPOOGOMetering_001" name="Send Bill (Metering Operations)">
      <bpmn:name>Send Bill (Metering Operations)</bpmn:name>
      <bpmn:incoming>Seq_StartToSendMetering_001</bpmn:incoming>
    </bpmn:task>

    <!-- Task to send Equipment Bill -->
    <bpmn:exclusiveGateway id="Gate_EquipRecipient_001" name="Select Recipient">
      <bpmn:name>Select Recipient (MPON/GO)</bpmn:name>
      <bpmn:incoming>Seq_StartToEquipDecision_001</bpmn:incoming>
      <bpmn:outgoing>Seq_SendToMPONEquipment_001</bpmn:outgoing>
      <bpmn:outgoing>Seq_SendToGOEquipment_001</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task to send Equipment Bill to MPON -->
    <bpmn:task id="Task_SendBillMPOOMPONEquipment_001" name="Send Bill (Equip - MPON)">
      <bpmn:name>Send Bill (Equipment Acquisition)</bpmn:name>
      <bpmn:incoming>Seq_SendToMPONEquipment_001</bpmn:incoming>
    </bpmn:task>

    <!-- Task to send Equipment Bill to GO -->
    <bpmn:task id="Task_SendBillMPOOGOEquipment_001" name="Send Bill (Equip - GO)">
      <bpmn:name>Send Bill (Equipment Acquisition)</bpmn:name>
      <bpmn:incoming>Seq_SendToGOEquipment_001</bpmn:incoming>
    </bpmn:task>

    <!-- Wait for Response -->
    <bpmn:intermediateCatchEvent id="CatchEvent_MPOO_ResponseMetering_001" name="Wait for Bill Result">
      <bpmn:name>Receive Payment Advice/Rejection</bpmn:name>
      <bpmn:incoming>Resp_GoToMPOO_Metering_001</bpmn:incoming>
    </bpmn:intermediateCatchEvent>

    <!-- Wait for Response Equipment -->
    <bpmn:intermediateCatchEvent id="CatchEvent_MPOO_ResponseEquipment_001" name="Wait for Bill Result">
      <bpmn:name>Receive Payment Advice/Rejection</bpmn:name>
      <bpmn:incoming>Resp_MPONToMPOO_Equipment_004</bpmn:incoming>
    </bpmn:intermediateCatchEvent>

    <!-- End Events -->
    <bpmn:endEvent id="End_Metering_001">
      <bpmn:name>Metering Bill Processed</bpmn:name>
      <bpmn:incoming>CatchEvent_MPOO_ResponseMetering_001</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="End_Equipment_001">
      <bpmn:name>Equipment Bill Processed</bpmn:name>
      <bpmn:incoming>CatchEvent_MPOO_ResponseEquipment_001</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Seq_StartToSendMetering_001" sourceRef="StartMPOO_BillMetering_001" targetRef="Task_SendBillMPOOGOMetering_001"/>
    <bpmn:sequenceFlow id="Seq_StartToEquipDecision_001" sourceRef="StartMPOO_BillEquipment_001" targetRef="Gate_EquipRecipient_001"/>
    <bpmn:sequenceFlow id="Seq_SendToMPONEquipment_001" sourceRef="Gate_EquipRecipient_001" targetRef="Task_SendBillMPOOMPONEquipment_001"/>
    <bpmn:sequenceFlow id="Seq_SendToGOEquipment_001" sourceRef="Gate_EquipRecipient_001" targetRef="Task_SendBillMPOOGOEquipment_001"/>

  </bpmn:process>

  <!-- MSPO Process -->
  <bpmn:process id="Proc_MSPO_002" isExecutable="false">
    <bpmn:startEvent id="StartMSPO_BillMeasurement_005">
      <bpmn:name>Measurement Bill Ready</bpmn:name>
      <bpmn:outgoing>Seq_StartToSendMeasurement_005</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:startEvent id="StartMSPO_BillReadings_005">
      <bpmn:name>Add. Readings Bill Ready</bpmn:name>
      <bpmn:outgoing>Seq_StartToSendReadings_005</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task to send Measurement Bill -->
    <bpmn:task id="Task_SendBillMSPOGOMeasurement_005" name="Send Bill (Measurement)">
      <bpmn:name>Send Bill (Temporary Continuation)</bpmn:name>
      <bpmn:incoming>Seq_StartToSendMeasurement_005</bpmn:incoming>
    </bpmn:task>

    <!-- Task to send Additional Readings -->
    <bpmn:task id="Task_SendBillMSPOAdditionalReadings_005" name="Send Bill (Readings)">
      <bpmn:name>Send Bill (Additional Readings)</bpmn:name>
      <bpmn:incoming>Seq_StartToSendReadings_005</bpmn:incoming>
    </bpmn:task>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Seq_StartToSendMeasurement_005" sourceRef="StartMSPO_BillMeasurement_005" targetRef="Task_SendBillMSPOGOMeasurement_005"/>
    <bpmn:sequenceFlow id="Seq_StartToSendReadings_005" sourceRef="StartMSPO_BillReadings_005" targetRef="Task_SendBillMSPOAdditionalReadings_005"/>

  </bpmn:process>


  <!-- GO Process -->
  <bpmn:process id="Proc_GO_003" isExecutable="false">
    <bpmn:startEvent id="StartGO_Waiting_003">
      <bpmn:name>Waiting for Bills</bpmn:name>
      <bpmn:outgoing>Seq_StartToGateway_003</bpmn:outgoing>
    </bpmn:startEvent>

     <!-- Event Based Gateway to catch multiple bill types -->
    <bpmn:eventBasedGateway id="Gate_GO_ReceiveBills_003" name="Bill Type">
      <bpmn:name>Select Bill Type Received</bpmn:name>
      <bpmn:incoming>Seq_StartToGateway_003</bpmn:incoming>
      <bpmn:outgoing>Seq_GoMeteringOps_003</bpmn:outgoing>
      <bpmn:outgoing>Seq_GO_Measurement_003</bpmn:outgoing>
      <bpmn:outgoing>Seq_GO_AdditionalReadings_003</bpmn:outgoing>
      <bpmn:outgoing>Seq_GO_EquipmentAcq_003</bpmn:outgoing>
    </bpmn:eventBasedGateway>

     <!-- Catching Events -->
    <bpmn:intermediateCatchEvent id="CatchEvent_GO_MeteringOps_003" name="Bill (Metering Ops)">
      <bpmn:name>Metering Bill Received</bpmn:name>
      <bpmn:incoming>CatchEvent_GO_MeteringOps_003</bpmn:incoming> <!-- Placeholder for message flow -->
    </bpmn:intermediateCatchEvent>

     <bpmn:intermediateCatchEvent id="CatchEvent_GO_Measurement_003" name="Bill (Measurement)">
      <bpmn:name>Measurement Bill Received</bpmn:name>
      <bpmn:incoming>CatchEvent_GO_Measurement_003</bpmn:incoming> <!-- Placeholder for message flow -->
    </bpmn:intermediateCatchEvent>

     <bpmn:intermediateCatchEvent id="CatchEvent_GO_AdditionalReadings_003" name="Bill (Additional Readings)">
      <bpmn:name>Add. Readings Bill Received</bpmn:name>
      <bpmn:incoming>CatchEvent_GO_AdditionalReadings_003</bpmn:incoming> <!-- Placeholder for message flow -->
    </bpmn:intermediateCatchEvent>

     <bpmn:intermediateCatchEvent id="CatchEvent_GO_EquipmentAcquisition_003" name="Bill (Equipment)">
      <bpmn:name>Equip Bill Received</bpmn:name>
      <bpmn:incoming>CatchEvent_GO_EquipmentAcquisition_003</bpmn:incoming> <!-- Placeholder for message flow -->
    </bpmn:intermediateCatchEvent>

     <!-- Task to Examine Bill (Common) -->
    <bpmn:task id="Task_ExamineBill_003" name="Examine Bill">
      <bpmn:name>Examine the Bill</bpmn:name>
      <bpmn:incoming>CatchEvent_GO_MeteringOps_003</bpmn:incoming> <!-- Simplified for flow -->
    </bpmn:task>

     <!-- Decision Gateway -->
    <bpmn:exclusiveGateway id="Gate_DecideConfirmReject_003" name="Decision">
      <bpmn:name>Confirm or Reject?</bpmn:name>
      <bpmn:incoming>CatchEvent_GO_MeteringOps_003</bpmn:incoming> <!-- Simplified for flow -->
      <bpmn:outgoing>Seq_ConfirmBill_003</bpmn:outgoing>
      <bpmn:outgoing>Seq_RejectBill_003</bpmn:outgoing>
    </bpmn:exclusiveGateway>

     <!-- Send Response Tasks (Simplified) -->
    <bpmn:task id="Task_ConfirmBill_GO_003" name="Confirm Bill">
      <bpmn:name>Confirm with Payment Advice</bpmn:name>
      <bpmn:incoming>CatchEvent_GO_MeteringOps_003</bpmn:incoming> <!-- Simplified for flow -->
    </bpmn:task>

     <bpmn:endEvent id="End_Go_Processed_003">
      <bpmn:name>Bills Processed</bpmn:name>
      <bpmn:outgoing/> 
    </bpmn:endEvent>

  </bpmn:process>


  <!-- MPON Process -->
  <bpmn:process id="Proc_MPON_004" isExecutable="false">
     <bpmn:startEvent id="StartMPON_Waiting_004" name="Waiting for Bills"/>

      <!-- Event Based Gateway to catch Equipment Bill -->
    <bpmn:eventBasedGateway id="Gate_MPON_ReceiveBills_004" name="Bill Type">
       <bpmn:name>Select Bill Type Received</bpmn:name>
        <bpmn:incoming>CatchEvent_GO_MeteringOps_003</bpmn:incoming> <!-- Simplified for flow -->
    </bpmn:eventBasedGateway>

     <!-- Catching Event Equipment -->
    <bpmn:intermediateCatchEvent id="CatchEvent_MPON_EquipmentAcquisition_004" name="Bill (Equipment)">
      <bpmn:name>Equip Bill Received</bpmn:name>
       <bpmn:incoming>CatchEvent_GO_MeteringOps_003</bpmn:incoming> <!-- Simplified for flow -->
    </bpmn:intermediateCatchEvent>

     <!-- Task to Examine Bill (Common) -->
    <bpmn:task id="Task_ExamineBill_MPON_004" name="Examine Bill">
      <bpmn:name>Examine the Bill</bpmn:name>
       <bpmn:incoming>CatchEvent_GO_MeteringOps_003</bpmn:incoming> <!-- Simplified for flow -->
    </bpmn:task>

     <!-- Decision Gateway -->
    <bpmn:exclusiveGateway id="Gate_DecideConfirmReject_MPON_004" name="Decision">
      <bpmn:name>Confirm or Reject?</bpmn:name>
       <bpmn:incoming>CatchEvent_GO_MeteringOps_003</bpmn:incoming> <!-- Simplified for flow -->
    </bpmn:exclusiveGateway>

     <!-- Send Response Tasks (Simplified) -->
    <bpmn:task id="Task_ConfirmBill_MPON_004" name="Confirm Bill">
      <bpmn:name>Confirm with Payment Advice</bpmn:name>
       <bpmn:incoming>CatchEvent_GO_MeteringOps_003</bpmn:incoming> <!-- Simplified for flow -->
    </bpmn:task>

     <bpmn:endEvent id="End_MPON_Processed_004">
      <bpmn:name>Bills Processed</bpmn:name>
       <bpmn:outgoing/> 
    </bpmn:endEvent>

  </bpmn:process>


<!-- Note: The above XML is a simplified representation of the logic. To ensure full validity and correct message flow connections, I will now generate the final clean version with proper IDs matching across pools -->
</definitions>