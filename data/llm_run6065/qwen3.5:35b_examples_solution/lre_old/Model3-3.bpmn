<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ClaimProcess_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_ClaimHandling_001">
    <bpmn:participant id="Participant_ClaimSystem_001" name="Claims Handling System" processRef="Process_ClaimHandling_001"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_ClaimHandling_001" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_ClaimsOfficer_001" name="Claims Officer">
        <bpmn:flowNodeRef>StartEvent_RegisterClaim_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExamineClaim_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WriteRecommendation_001</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SeniorOfficer_001" name="Senior Claims Officer">
        <bpmn:flowNodeRef>Gateway_CheckOK_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Completed_001</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_RegisterClaim_001" name="Register Claim">
      <bpmn:outgoing>SeqFlow_StartToExamine_001</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Examine claim -->
    <bpmn:task id="Task_ExamineClaim_001" name="Examine Claim">
      <bpmn:incoming>SeqFlow_StartToExamine_001</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_ToWriteRecommendation_001</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: Write settlement recommendation -->
    <bpmn:task id="Task_WriteRecommendation_001" name="Write Settlement Recommendation">
      <bpmn:incoming>SeqFlow_ToWriteRecommendation_001</bpmn:incoming>
      <bpmn:incoming>SeqFlow_LoopBackFromNotOK_001</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_ToCheckDecision_001</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Check if OK or Not OK -->
    <bpmn:exclusiveGateway id="Gateway_CheckOK_001" name="Claim OK?">
      <bpmn:incoming>SeqFlow_ToCheckDecision_001</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_OKToComplete_001</bpmn:outgoing>
      <bpmn:outgoing>SeqFlow_NotOKLoopBack_001</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Completed_001" name="Claim Processed">
      <bpmn:incoming>SeqFlow_OKToComplete_001</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SeqFlow_StartToExamine_001" sourceRef="StartEvent_RegisterClaim_001" targetRef="Task_ExamineClaim_001"/>
    
    <bpmn:sequenceFlow id="SeqFlow_ToWriteRecommendation_001" sourceRef="Task_ExamineClaim_001" targetRef="Task_WriteRecommendation_001"/>

    <bpmn:sequenceFlow id="SeqFlow_ToCheckDecision_001" sourceRef="Task_WriteRecommendation_001" targetRef="Gateway_CheckOK_001"/>

    <bpmn:sequenceFlow id="SeqFlow_OKToComplete_001" name="Yes (OK)" sourceRef="Gateway_CheckOK_001" targetRef="EndEvent_Completed_001"/>

    <bpmn:sequenceFlow id="SeqFlow_NotOKLoopBack_001" name="No (Not OK)" sourceRef="Gateway_CheckOK_001" targetRef="Task_WriteRecommendation_001"/>
  </bpmn:process>
</bpmn:definitions>