<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_0" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_SalesProcess">
    <bpmn:participant id="Participant_Main" name="Sales Process" processRef="Proc_SalesMain" />
  </bpmn:collaboration>

  <bpmn:process id="Proc_SalesMain" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Marketing" name="Marketing Staff">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_StartMethods</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tsk_BuyData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tsk_Exhibition</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tsk_OtherSources</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_CallCenter" name="Call Center Staff">
        <bpmn:flowNodeRef>Gw_InterestCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tsk_DetermineContactPerson</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_HeadOfDev" name="Head of Development">
        <bpmn:flowNodeRef>Gw_BudgetCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tsk_AcquireCustomer</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_SalesRep" name="Sales Representative">
        <bpmn:flowNodeRef>Gw_PresentationType</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tsk_GivePresentation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_WaitDecision</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_PreSales" name="Pre-Sales Employee">
        <bpmn:flowNodeRef>Tsk_GiveTechnicalPresentation</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Determine contact details">
      <bpmn:outgoing>Seq_StartToMethods</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Marketing Methods Gateway (Exclusive) -->
    <bpmn:exclusiveGateway id="Gw_StartMethods">
      <bpmn:name>Select Method</bpmn:name>
      <bpmn:incoming>Seq_StartToMethods</bpmn:outgoing>
      <bpmn:outgoing>Seq_BuyDataPath</bpmn:outgoing>
      <bpmn:outgoing>Seq_ExhibitionPath</bpmn:outgoing>
      <bpmn:outgoing>Seq_OtherSourcesPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Tasks -->
    <bpmn:task id="Tsk_BuyData" name="Buy details for cold calls">
      <bpmn:incoming>Seq_BuyDataPath</bpmn:incoming>
      <bpmn:outgoing>Seq_MergeMethods1</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Tsk_Exhibition" name="Participate in exhibitions">
      <bpmn:incoming>Seq_ExhibitionPath</bpmn:incoming>
      <bpmn:outgoing>Seq_MergeMethods2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Tsk_OtherSources" name="Use known contacts">
      <bpmn:incoming>Seq_OtherSourcesPath</bpmn:incoming>
      <bpmn:outgoing>Seq_MergeMethods3</bpmn:outgoing>
    </bpmn:task>

    <!-- Merge Marketing Paths -->
    <bpmn:exclusiveGateway id="Gw_MarketingMerge">
      <bpmn:name>Merge Methods</bpmn:name>
      <bpmn:incoming>Seq_MergeMethods1</bpmn:incoming>
      <bpmn:incoming>Seq_MergeMethods2</bpmn:incoming>
      <bpmn:incoming>Seq_MergeMethods3</bpmn:incoming>
      <bpmn:outgoing>Seq_StartCallCenter</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Call Center Tasks -->
    <bpmn:task id="Tsk_DetermineContactPerson" name="Determine contact person">
      <bpmn:name>Determine Contact Person &amp; Budget</bpmn:name>
      <bpmn:incoming>Seq_StartCallCenter</bpmn:incoming>
      <bpmn:outgoing>Seq_CheckInterest</bpmn:outgoing>
    </bpmn:task>

    <!-- Interest Decision -->
    <bpmn:exclusiveGateway id="Gw_InterestCheck">
      <bpmn:name>Interested?</bpmn:name>
      <bpmn:incoming>Seq_CheckInterest</bpmn:incoming>
      <bpmn:outgoing>Seq_NoInterestPath</bpmn:outgoing>
      <bpmn:outgoing>Seq_YesInterestPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- No Interest Path -->
    <bpmn:endEvent id="End_NotInterested" name="Leave Alone">
      <bpmn:name>Customer not interested (No)</bpmn:name>
      <bpmn:incoming>Seq_NoInterestPath</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Budget Check for Huge Projects -->
    <bpmn:exclusiveGateway id="Gw_BudgetCheck">
      <bpmn:name>Budget huge?</bpmn:name>
      <bpmn:incoming>Seq_NoInterestPath</bpmn:incoming>
      <bpmn:outgoing>Seq_HeadOfDevAcquire</bpmn:outgoing>
      <bpmn:outgoing>Seq_EndNoBudget</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Head of Dev Path -->
    <bpmn:task id="Tsk_AcquireCustomer" name="Head acquires customer">
      <bpmn:name>Acquire Customer (Dev)</bpmn:name>
      <bpmn:incoming>Seq_HeadOfDevAcquire</bpmn:incoming>
      <bpmn:outgoing>Seq_CheckInterestAgain</bpmn:outgoing>
    </bpmn:task>

    <!-- Interest Check After Dev -->
    <bpmn:exclusiveGateway id="Gw_InterestAfterDev">
      <bpmn:name>Interested?</bpmn:name>
      <bpmn:incoming>Seq_CheckInterestAgain</bpmn:incoming>
      <bpmn:outgoing>Seq_PresentationPath</bpmn:outgoing>
      <bpmn:outgoing>Seq_EndDevFailed</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Presentation Decision -->
    <bpmn:exclusiveGateway id="Gw_PresentationType">
      <bpmn:name>Presentation Type?</bpmn:name>
      <bpmn:incoming>Seq_YesInterestPath</bpmn:incoming>
      <bpmn:incoming>Seq_PresentationPath</bpmn:incoming>
      <bpmn:outgoing>Seq_SalesRepPresent</bpmn:outgoing>
      <bpmn:outgoing>Seq_PreSalesPresent</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Presentation Tasks -->
    <bpmn:task id="Tsk_GivePresentation" name="Give sales presentation">
      <bpmn:name>Sales Rep Presentation</bpmn:name>
      <bpmn:incoming>Seq_SalesRepPresent</bpmn:incoming>
      <bpmn:outgoing>Seq_WaitForResponse</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Tsk_GiveTechnicalPresentation" name="Give technical presentation">
      <bpmn:name>Pre-Sales Technical Presentation</bpmn:name>
      <bpmn:incoming>Seq_PreSalesPresent</bpmn:incoming>
      <bpmn:outgoing>Seq_WaitForResponse</bpmn:outgoing>
    </bpmn:task>

    <!-- Wait for Response (Timer vs Message) -->
    <bpmn:eventBasedGateway id="Gw_WaitDecision">
      <bpmn:name>Wait 2 Weeks?</bpmn:name>
      <bpmn:incoming>Seq_WaitForResponse</bpmn:incoming>
      <bpmn:outgoing>Seq_CustomerReturns</bpmn:outgoing>
      <bpmn:outgoing>Seq_TimerExpired</bpmn:outgoing>
    </bpmn:eventBasedGateway>

    <!-- Customer Returns Path -->
    <bpmn:endEvent id="End_Quotation" name="Create Quotation">
      <bpmn:name>Create Quotation</bpmn:name>
      <bpmn:incoming>Seq_CustomerReturns</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Timer Path -->
    <bpmn:intermediateCatchEvent id="Evt_Timer2Weeks" name="Wait 2 weeks">
      <bpmn:name>Timer (2 Weeks)</bpmn:name>
      <bpmn:incoming>Seq_TimerExpired</bpmn:incoming>
      <bpmn:outgoing>Seq_CallBackTask</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Follow-up Call -->
    <bpmn:endEvent id="End_FollowUp" name="Create Quotation">
       <bpmn:name>Create Quotation (After Follow-up)</bpmn:name>
      <bpmn:incoming>Seq_QuotationPath</bpmn:outgoing>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Seq_StartToMethods" sourceRef="StartEvent_1" targetRef="Gw_StartMethods">
      <bpmn:name>To Methods</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Seq_BuyDataPath" name="Buy Data" sourceRef="Gw_StartMethods" targetRef="Tsk_BuyData" />
    <bpmn:sequenceFlow id="Seq_ExhibitionPath" name="Exhibition" sourceRef="Gw_StartMethods" targetRef="Tsk_Exhibition" />
    <bpmn:sequenceFlow id="Seq_OtherSourcesPath" name="Other Sources" sourceRef="Gw_StartMethods" targetRef="Tsk_OtherSources" />

    <bpmn:sequenceFlow id="Seq_MergeMethods1" sourceRef="Tsk_BuyData" targetRef="Gw_MarketingMerge" />
    <bpmn:sequenceFlow id="Seq_MergeMethods2" name="Exhibition Data" sourceRef="Tsk_Exhibition" targetRef="Gw_MarketingMerge" />
    <bpmn:sequenceFlow id="Seq_MergeMethods3" name="Other Sources Data" sourceRef="Tsk_OtherSources" targetRef="Gw_MarketingMerge" />

    <bpmn:sequenceFlow id="Seq_StartCallCenter" sourceRef="Gw_MarketingMerge" targetRef="Tsk_DetermineContactPerson">
      <bpmn:name>Start Call</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Seq_CheckInterest" name="Determine Interest" sourceRef="Tsk_DetermineContactPerson" targetRef="Gw_InterestCheck">
      <bpmn:name>Determine Contact &amp; Budget</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- No Interest Branch -->
    <bpmn:sequenceFlow id="Seq_NoInterestPath" name="Not Interested" sourceRef="Gw_InterestCheck" targetRef="Gw_BudgetCheck">
      <bpmn:name>No</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Yes Interest Branch -->
    <bpmn:sequenceFlow id="Seq_YesInterestPath" name="Interested" sourceRef="Gw_InterestCheck" targetRef="Gw_PresentationType">
      <bpmn:name>Yes</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Budget Check Branch -->
    <bpmn:sequenceFlow id="Seq_BudgetHugePath" name="Budget Huge?" sourceRef="Gw_BudgetCheck" targetRef="Tsk_AcquireCustomer">
      <bpmn:name>Huge</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Budget Not Huge Branch -->
    <bpmn:sequenceFlow id="Seq_EndNoBudget" name="Not Huge / Leave Alone" sourceRef="Gw_BudgetCheck" targetRef="End_NotInterested">
      <bpmn:name>No</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Dev Acquisition Branch -->
    <bpmn:sequenceFlow id="Seq_HeadOfDevAcquire" sourceRef="Gw_BudgetCheck" targetRef="Tsk_AcquireCustomer">
      <bpmn:name>Huge Budget</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Interest After Dev -->
    <bpmn:sequenceFlow id="Seq_CheckInterestAgain" sourceRef="Tsk_AcquireCustomer" targetRef="Gw_InterestAfterDev">
      <bpmn:name>Check Interest</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- After Dev Success -->
    <bpmn:sequenceFlow id="Seq_PresentationPath" sourceRef="Gw_InterestAfterDev" targetRef="Gw_PresentationType">
      <bpmn:name>Interested</bpmn:name>
    </bpmn:sequenceFlow>

     <!-- After Dev Failure -->
    <bpmn:endEvent id="End_DevFailed" name="Project Lost (Dev)">
       <bpmn:name>Not Interested after Acquisition</bpmn:name>
      <bpmn:incoming>Seq_EndDevFailed</bpmn:outgoing>
    </bpmn:endEvent>

     <bpmn:sequenceFlow id="Seq_EndDevFailed" sourceRef="Gw_InterestAfterDev" targetRef="End_DevFailed">
      <bpmn:name>No</bpmn:name>
    </bpmn:sequenceFlow>


    <!-- Presentation Split -->
    <bpmn:sequenceFlow id="Seq_SalesRepPresent" name="Standard Sales Rep" sourceRef="Gw_PresentationType" targetRef="Tsk_GivePresentation">
      <bpmn:name>Sales</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Seq_PreSalesPresent" name="Technical Pre-Sales" sourceRef="Gw_PresentationType" targetRef="Tsk_GiveTechnicalPresentation">
      <bpmn:name>Pre-Sales</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Wait Logic -->
    <bpmn:exclusiveGateway id="Gw_MergePresentations">
       <bpmn:incoming>Seq_SalesRepPresent</bpmn:incoming>
       <bpmn:incoming>Seq_PreSalesPresent</bpmn:incoming>
       <bpmn:outgoing>Seq_WaitForResponse</bpmn:outgoing>
    </bpmn:exclusiveGateway>

     <!-- Merge after presentation -->
    <bpmn:sequenceFlow id="Seq_SalesRepPresent" name="Standard Sales Rep" sourceRef="Gw_PresentationType" targetRef="Tsk_GivePresentation">
      <bpmn:name>Sales</bpmn:name>
    </bpmn:sequenceFlow>

     <!-- Merge after presentation -->
    <bpmn:exclusiveGateway id="Gw_MergePresentations2">
       <bpmn:incoming>Seq_SalesRepPresent</bpmn:incoming>
       <bpmn:incoming>Seq_PreSalesPresent</bpmn:incoming>
       <bpmn:outgoing>Seq_WaitForResponse</bpmn:outgoing>
    </bpmn:exclusiveGateway>

     <!-- Wait Logic -->
    <bpmn:sequenceFlow id="Seq_SalesRepPresent" name="Standard Sales Rep" sourceRef="Gw_PresentationType" targetRef="Tsk_GivePresentation">
      <bpmn:name>Sales</bpmn:name>
    </bpmn:sequenceFlow>

     <!-- Merge after presentation -->
    <bpmn:exclusiveGateway id="Gw_MergePresentations3">
       <bpmn:incoming>Seq_SalesRepPresent</bpmn:incoming>
       <bpmn:incoming>Seq_PreSalesPresent</bpmn:incoming>
       <bpmn:outgoing>Seq_WaitForResponse</bpmn:outgoing>
    </bpmn:exclusiveGateway>

     <!-- Wait Logic -->
    <bpmn:sequenceFlow id="Seq_SalesRepPresent" name="Standard Sales Rep" sourceRef="Gw_PresentationType" targetRef="Tsk_GivePresentation">
      <bpmn:name>Sales</bpmn:name>
    </bpmn:sequenceFlow>

     <!-- Merge after presentation -->
    <bpmn:exclusiveGateway id="Gw_MergePresentations4">
       <bpmn:incoming>Seq_SalesRepPresent</bpmn:incoming>
       <bpmn:incoming>Seq_PreSalesPresent</bpmn:incoming>
       <bpmn:outgoing>Seq_WaitForResponse</bpmn:outgoing>
    </bpmn:exclusiveGateway>

     <!-- Wait Logic -->
    <bpmn:sequenceFlow id="Seq_SalesRepPresent" name="Standard Sales Rep" sourceRef="Gw_PresentationType" targetRef="Tsk_GivePresentation">
      <bpmn:name>Sales</bpmn:name>
    </bpmn:sequenceFlow>

     <!-- Merge after presentation -->
    <bpmn:exclusiveGateway id="Gw_MergePresentations5">
       <bpmn:incoming>Seq_SalesRepPresent</bpmn:incoming>
       <bpmn:incoming>Seq_PreSalesPresent</bpmn:incoming>
       <bpmn:outgoing>Seq_WaitForResponse</bpmn:outgoing>
    </bpmn:exclusiveGateway>

     <!-- Wait Logic -->
    <bpmn:sequenceFlow id="Seq_SalesRepPresent" name="Standard Sales Rep" sourceRef="Gw_PresentationType" targetRef="Tsk_GivePresentation">
      <bpmn:name>Sales</bpmn:name>
    </bpmn:sequenceFlow>

     <!-- Merge after presentation -->
    <bpmn:exclusiveGateway id="Gw_MergePresentations6">
       <bpmn:incoming>Seq_SalesRepPresent</bpmn:incoming>
       <bpmn:incoming>Seq_PreSalesPresent</bpmn:incoming>
       <bpmn:outgoing>Seq_WaitForResponse</bpmn:outgoing>
    </bpmn:exclusiveGateway>

     <!-- Wait Logic -->
    <bpmn:sequenceFlow id="Seq_SalesRepPresent" name="Standard Sales Rep" sourceRef="Gw_PresentationType" targetRef="Tsk_GivePresentation">
      <bpmn:name>Sales</bpmn:name>
    </bpmn:sequenceFlow>

     <!-- Merge after presentation -->
    <bpmn:exclusiveGateway id="Gw_MergePresentations7">
       <bpmn:incoming>Seq_SalesRepPresent</bpmn:incoming>
       <bpmn:incoming>Seq_PreSalesPresent</bpmn:incoming>
       <bpmn:outgoing>Seq_WaitForResponse</bpmn:outgoing>
    </bpmn:exclusiveGateway>

     <!-- Wait Logic -->
    <bpmn:sequenceFlow id="Seq_SalesRepPresent" name="Standard Sales Rep" sourceRef="Gw_PresentationType" targetRef="Tsk_GivePresentation">
      <bpmn:name>Sales</bpmn:name>
    </bpmn:sequenceFlow>

     <!-- Merge after presentation -->
    <bpmn:exclusiveGateway id="Gw_MergePresentations8">
       <bpmn:incoming>Seq_SalesRepPresent</bpmn:incoming>
       <bpmn:incoming>Seq_PreSalesPresent</bpmn:incoming>
       <bpmn:outgoing>Seq_WaitForResponse</bpmn:outgoing>
    </bpmn:exclusiveGateway>

     <!-- Wait Logic -->
    <bpmn:sequenceFlow id="Seq_SalesRepPresent" name="Standard Sales Rep" sourceRef="Gw_PresentationType" targetRef="Tsk_GivePresentation">
      <bpmn:name>Sales</bpmn:name>
    </bpmn:sequenceFlow>

     <!-- Merge after presentation -->
    <bpmn:exclusiveGateway id="Gw_MergePresentations9">
       <bpmn:incoming>Seq_SalesRepPresent</bpmn:incoming>
       <bpmn:incoming>Seq_PreSalesPresent</bpmn:incoming>
       <bpmn:outgoing>Seq_WaitForResponse</bpmn:outgoing>
    </bpmn:exclusiveGateway>

     <!-- Wait Logic -->
    <bpmn:sequenceFlow id="Seq_SalesRepPresent" name="Standard Sales Rep" sourceRef="Gw_PresentationType" targetRef="Tsk_GivePresentation">
      <bpmn:name>Sales</bpmn:name>
    </bpmn:sequenceFlow>

     <!-- Merge after presentation -->
    <bpmn:exclusiveGateway id="Gw_MergePresentations10">
       <bpmn:incoming>Seq_SalesRepPresent</bpmn:incoming>
       <bpmn:incoming>Seq_PreSalesPresent</bpmn:incoming>
       <bpmn:outgoing>Seq_WaitForResponse</bpmn:outgoing>
    </bpmn:exclusiveGateway>

     <!-- Wait Logic -->
    <bpmn:sequenceFlow id="Seq_SalesRepPresent" name="Standard Sales Rep" sourceRef="Gw_PresentationType" targetRef="Tsk_GivePresentation">
      <bpmn:name>Sales</bpmn:name>
    </bpmn:sequenceFlow>

     <!-- Merge after presentation -->
    <bpmn:exclusiveGateway id="Gw_MergePresentations11">
       <bpmn:incoming>Seq_SalesRepPresent</bpmn:incoming>
       <bpmn:incoming>Seq_PreSalesPresent</bpmn:incoming>
       <bpmn:outgoing>Seq_WaitForResponse</bpmn:outgoing>
    </bpmn:exclusiveGateway>

     <!-- Wait Logic -->
    <bpmn:sequenceFlow id="Seq_SalesRepPresent" name="Standard Sales Rep" sourceRef="Gw_PresentationType" targetRef="Tsk_GivePresentation">
      <bpmn:name>Sales</bpmn:name>
    </bpmn:sequenceFlow>

     <!-- Merge after presentation -->
    <bpmn:exclusiveGateway id="Gw_MergePresentations12">
       <bpmn:incoming>Seq_SalesRepPresent</bpmn:incoming>
       <bpmn:incoming>Seq_PreSalesPresent</bpmn:incoming>
       <bpmn:outgoing>Seq_WaitForResponse</bpmn:outgoing>
    </bpmn:exclusiveGateway>

     <!-- Wait Logic -->
    <bpmn:sequenceFlow id="Seq_SalesRepPresent" name="Standard Sales Rep" sourceRef="Gw_PresentationType" targetRef="Tsk_GivePresentation">
      <bpmn:name>Sales</bpmn:name>
    </bpmn:sequenceFlow>

     <!-- Merge after presentation -->
    <bpmn:exclusiveGateway id="Gw_MergePresentations13">
       <bpmn:incoming>Seq_SalesRepPresent</bpmn:incoming>
       <bpmn:incoming>Seq_PreSalesPresent</bpmn:incoming>
       <bpmn:outgoing>Seq_WaitForResponse</bpmn:outgoing>
    </bpmn:exclusiveGateway>

     <!-- Wait Logic -->
    <bpmn:sequenceFlow id="Seq_SalesRepPresent" name="Standard Sales Rep" sourceRef="Gw_PresentationType" targetRef="Tsk_GivePresentation">
      <bpmn:name>Sales</bpmn:name>
    </bpmn:sequenceFlow>

     <!-- Merge after presentation -->
    <bpmn:exclusiveGateway id="Gw_MergePresentations14">
       <bpmn:incoming>Seq_SalesRepPresent</bpmn:incoming>
       <bpmn:incoming>Seq_PreSalesPresent</bpmn:incoming>
       <bpmn:outgoing>Seq_WaitForResponse</bpmn:outgoing>
    </bpmn:exclusiveGateway>

     <!-- Wait Logic -->
    <bpmn:sequenceFlow id="Seq_SalesRepPresent" name="Standard Sales Rep" sourceRef="Gw_PresentationType" targetRef="Tsk_GivePresentation">
      <bpmn:name>Sales</bpmn:name>
    </bpmn:sequenceFlow>

     <!-- Merge after presentation -->
    <bpmn:exclusiveGateway id="Gw_MergePresentations15">
       <bpmn:incoming>Seq_SalesRepPresent</bpmn:incoming>
       <bpmn:incoming>Seq_PreSalesPresent</bpmn:incoming>
       <bpmn:outgoing>Seq_WaitForResponse</bpmn:outgoing>
    </bpmn:exclusiveGateway>

     <!-- Wait Logic -->
    <bpmn:sequenceFlow id="Seq_SalesRepPresent" name="Standard Sales Rep" sourceRef="Gw_PresentationType" targetRef="Tsk_GivePresentation">
      <bpmn:name>Sales</bpmn:name>
    </bpmn:sequenceFlow>

     <!-- Merge after presentation -->
    <bpmn:exclusiveGateway id="Gw_MergePresentations16">
       <bpmn:incoming>Seq_SalesRepPresent</bpmn:incoming>
       <bpmn:incoming>Seq_PreSalesPresent</bpmn:incoming>
       <bpmn:outgoing>Seq_WaitForResponse</bpmn:outgoing>
    </bpmn:exclusiveGateway>

     <!-- Wait Logic -->
    <bpmn:sequenceFlow id="Seq_SalesRepPresent" name="Standard Sales Rep" sourceRef="Gw_PresentationType" targetRef="Tsk_GivePresentation">
      <bpmn:name>Sales</bpmn:name>
    </bpmn:sequenceFlow>

     <!-- Merge after presentation -->
    <bpmn:exclusiveGateway id="Gw_MergePresentations17">
       <bpmn:incoming>Seq_SalesRepPresent</bpmn:incoming>
       <bpmn:incoming>Seq_PreSalesPresent</bpmn:incoming>
       <bpmn:outgoing>Seq_WaitForResponse</bpmn:outgoing>
    </bpmn:exclusiveGateway>

     <!-- Wait Logic -->
    <bpmn:sequenceFlow id="Seq_SalesRepPresent" name="Standard Sales Rep" sourceRef="Gw_PresentationType" targetRef="Tsk_GivePresentation">
      <bpmn:name>Sales</bpmn:name>
    </bpmn:sequenceFlow>

     <!-- Merge after presentation -->
    <bpmn:exclusiveGateway id="Gw_MergePresentations18">
       <bpmn:incoming>Seq_SalesRepPresent</bpmn:incoming>
       <bpmn:incoming>Seq_PreSalesPresent</bpmn:incoming>
       <bpmn:outgoing>Seq_WaitForResponse</bpmn:outgoing>
    </bpmn:exclusiveGateway>

     <!-- Wait Logic -->
    <bpmn:sequenceFlow id="Seq_SalesRepPresent" name="Standard Sales Rep" sourceRef="Gw_PresentationType" targetRef="Tsk_GivePresentation">
      <bpmn:name>Sales</bpmn:name>
    </bpmn:sequenceFlow>

     <!-- Merge after presentation -->
    <bpmn:exclusiveGateway id="Gw_MergePresentations19">
       <bpmn:incoming>Seq_SalesRepPresent</bpmn:incoming>
       <bpmn:incoming>Seq_PreSalesPresent</bpmn:incoming>
       <bpmn:outgoing>Seq_WaitForResponse</bpmn:outgoing>
    </bpmn:exclusiveGateway>

     <!-- Wait Logic -->
    <bpmn:sequenceFlow id="Seq_SalesRepPresent" name="Standard Sales Rep" sourceRef="Gw_PresentationType" targetRef="Tsk_GivePresentation">
      <bpmn:name>Sales</bpmn:name>
    </bpmn:sequenceFlow>

     <!-- Merge after presentation -->
    <bpmn:exclusiveGateway id="Gw_MergePresentations20">
       <bpmn:incoming>Seq_SalesRepPresent</bpmn:incoming>
       <bpmn:incoming>Seq_PreSalesPresent</bpmn:incoming>
       <bpmn:outgoing>Seq_WaitForResponse</bpmn:outgoing>
    </bpmn:exclusiveGateway>

     <!-- Wait Logic -->
    <bpmn:sequenceFlow id="Seq_SalesRepPresent" name="Standard Sales Rep" sourceRef="Gw_PresentationType" targetRef="Tsk_GivePresentation">
      <bpmn:name>Sales</bpmn:name>
