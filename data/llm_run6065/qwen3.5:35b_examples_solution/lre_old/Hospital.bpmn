<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 id="Definitions_ExaminationProcess_001" targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:collaboration id="Collab_HospitalExamination">
    <bpmn:participant id="Participant_Hospital" name="Hospital Examination Process" processRef="Proc_Examination"/>
  </bpmn:collaboration>

  <bpmn:process id="Proc_Examination" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="Start_PatientExamination" name="Patient Examination Requested">
      <bpmn:outgoing>Flow_StartToPhysician</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Outpatient Physician Tasks and Decisions -->
    <bpmn:task id="Task_PhysicianExamine" name="Patient examined by outpatient physician">
      <bpmn:incoming>Flow_StartToPhysician</bpmn:incoming>
      <bpmn:outgoing>Flow_ToHealthDecision</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gate_HealthyOrAdditional" name="Patient healthy or needs additional examination?">
      <bpmn:incoming>Flow_ToHealthDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_HealthyToFormFill</bpmn:outgoing>
      <bpmn:outgoing>Flow_AdditionalOrderExam</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Healthy Path -->
    <bpmn:task id="Task_FillExaminationForm" name="Fill out examination form">
      <bpmn:incoming>Flow_HealthyToFormFill</bpmn:incoming>
      <bpmn:outgoing>Flow_PatientLeaves</bpmn:outgoing>
    </bpmn:task>

    <!-- Additional Examination Path -->
    <bpmn:task id="Task_OrderExamTreatment" name="Place examination and follow-up treatment order">
      <bpmn:incoming>Flow_AdditionalOrderExam</bpmn:incoming>
      <bpmn:outgoing>Flow_FillRequestForm</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_FillRequestForm" name="Fill out request form">
      <bpmn:incoming>Flow_FillRequestForm</bpmn:incoming>
      <bpmn:outgoing>Flow_InformRisks</bpmn:outgoing>
    </bpmn:task>

    <!-- Patient Consent -->
    <bpmn:task id="Task_InformPatient" name="Inform patient about potential risks">
      <bpmn:incoming>Flow_InformRisks</bpmn:incoming>
      <bpmn:outgoing>Flow_PatientConsentDecision</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gate_PatientAgrees" name="Patient signs informed consent and agrees?">
      <bpmn:incoming>Flow_PatientConsentDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_AgreeToAppointment</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Appointment Arrangement -->
    <bpmn:task id="Task_ArrangeAppointment" name="Delegate arranges appointment with ward">
      <bpmn:incoming>Flow_AgreeToAppointment</bpmn:incoming>
      <bpmn:outgoing>Flow_WardTakesSample</bpmn:outgoing>
    </bpmn:task>

    <!-- Ward Activities -->
    <bpmn:exclusiveGateway id="Gate_BeforeAppointment" name="Before appointment?">
      <bpmn:incoming>Flow_AgreeToAppointment</bpmn:incoming>
      <bpmn:outgoing>Flow_PrepareExamSampling</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_NursePrepare" name="Nurse prepares examination and sampling">
      <bpmn:incoming>Flow_PrepareExamSampling</bpmn:incoming>
      <bpmn:outgoing>Flow_WardPhysicianTakesSample</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_PhysicianWard" name="Ward physician takes sample">
      <bpmn:incoming>Flow_WardPhysicianTakesSample</bpmn:incoming>
      <bpmn:outgoing>Flow_SendToLabTreatment</bpmn:outgoing>
    </bpmn:task>

    <!-- Lab Activities -->
    <bpmn:exclusiveGateway id="Gate_SampleValid" name="Sample valid for analysis?">
      <bpmn:incoming>Flow_SendToLabTreatment</bpmn:incoming>
      <bpmn:outgoing>Flow_AnalysisProceeds</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_LabValidateSample" name="Physician validates sample state">
      <bpmn:incoming>Flow_SendToLabTreatment</bpmn:incoming>
      <bpmn:outgoing>Flow_SampleValidDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Analysis Path -->
    <bpmn:task id="Task_Analysis" name="Medical technical assistant performs analysis">
      <bpmn:incoming>Flow_AnalysisProceeds</bpmn:incoming>
      <bpmn:outgoing>Flow_ValidateResults</bpmn:outgoing>
    </bpmn:task>

    <!-- Results Validation -->
    <bpmn:task id="Task_LabPhysicianValidate" name="Lab physician validates results">
      <bpmn:incoming>Flow_ValidateResults</bpmn:incoming>
      <bpmn:outgoing>Flow_OutpatientDiagnosis</bpmn:outgoing>
    </bpmn:task>

    <!-- Final Diagnosis -->
    <bpmn:task id="Task_FinalDiagnosis" name="Physician makes diagnosis and prescribes therapy">
      <bpmn:incoming>Flow_OutpatientDiagnosis</bpmn:incoming>
      <bpmn:outgoing>Flow_ProcessComplete</bpmn:outgoing>
    </bpmn:task>

    <!-- End Events -->
    <bpmn:endEvent id="End_PatientLeaves" name="Patient leaves">
      <bpmn:incoming>Flow_PatientLeaves</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="End_ProcessComplete" name="Process Complete - Therapy Prescribed">
      <bpmn:incoming>Flow_ProcessComplete</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Flow_StartToPhysician" sourceRef="Start_PatientExamination" targetRef="Task_PhysicianExamine"/>
    
    <bpmn:sequenceFlow id="Flow_ToHealthDecision" name="Healthy or additional?" sourceRef="Task_PhysicianExamine" targetRef="Gate_HealthyOrAdditional"/>
    
    <!-- Healthy Path -->
    <bpmn:sequenceFlow id="Flow_HealthyToFormFill" name="Patient healthy" sourceRef="Gate_HealthyOrAdditional" targetRef="Task_FillExaminationForm"/>
    <bpmn:sequenceFlow id="Flow_PatientLeaves" sourceRef="Task_FillExaminationForm" targetRef="End_PatientLeaves"/>

    <!-- Additional Examination Path -->
    <bpmn:sequenceFlow id="Flow_AdditionalOrderExam" name="Needs additional examination" sourceRef="Gate_HealthyOrAdditional" targetRef="Task_OrderExamTreatment"/>
    
    <bpmn:sequenceFlow id="Flow_FillRequestForm" sourceRef="Task_OrderExamTreatment" targetRef="Task_FillRequestForm"/>
    <bpmn:sequenceFlow id="Flow_InformRisks" name="Inform about risks" sourceRef="Task_FillRequestForm" targetRef="Task_InformPatient"/>

    <!-- Patient Consent -->
    <bpmn:sequenceFlow id="Flow_PatientConsentDecision" sourceRef="Task_InformPatient" targetRef="Gate_PatientAgrees"/>
    
    <bpmn:sequenceFlow id="Flow_AgreeToAppointment" name="Yes - agrees to continue" sourceRef="Gate_PatientAgrees" targetRef="Task_ArrangeAppointment"/>

    <!-- Ward Activities -->
    <bpmn:sequenceFlow id="Flow_WardTakesSample" sourceRef="Task_ArrangeAppointment" targetRef="Gate_BeforeAppointment"/>
    
    <bpmn:sequenceFlow id="Flow_PrepareExamSampling" name="Before appointment - prepare" sourceRef="Gate_BeforeAppointment" targetRef="Task_NursePrepare"/>
    <bpmn:sequenceFlow id="Flow_WardPhysicianTakesSample" sourceRef="Task_NursePrepare" targetRef="Task_PhysicianWard"/>

    <!-- Lab Activities -->
    <bpmn:sequenceFlow id="Flow_SendToLabTreatment" name="Send to lab and treatment" sourceRef="Task_PhysicianWard" targetRef="Gate_SampleValid"/>
    
    <bpmn:sequenceFlow id="Flow_LabValidateSample" sourceRef="Gate_SampleValid" targetRef="Task_LabValidateSample"/>
    <bpmn:sequenceFlow id="Flow_AnalysisProceeds" name="Yes - sample valid for analysis" sourceRef="Gate_SampleValid" targetRef="Task_Analysis"/>

    <!-- Results and Final Diagnosis -->
    <bpmn:sequenceFlow id="Flow_ValidateResults" sourceRef="Task_Analysis" targetRef="Task_LabPhysicianValidate"/>
    
    <bpmn:sequenceFlow id="Flow_OutpatientDiagnosis" name="Return to outpatient department" sourceRef="Task_LabPhysicianValidate" targetRef="Task_FinalDiagnosis"/>

    <!-- Process Completion -->
    <bpmn:sequenceFlow id="Flow_ProcessComplete" sourceRef="Task_FinalDiagnosis" targetRef="End_ProcessComplete"/>

  </bpmn:process>

</bpmn:definitions>