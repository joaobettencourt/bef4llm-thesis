<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_001">
    <bpmn:messageFlow id="MsgFlow_ScheduleToMembers" sourceRef="ThrowEvent_SendScheduleToMembers" targetRef="CatchEvent_MembersReceive"/>
    <bpmn:messageFlow id="MsgFlow_ConflictsToCoordination" sourceRef="ThrowEvent_AdviseConflicts" targetRef="CatchEvent_CoordinationReceivesAdvice"/>
  </bpmn:collaboration>

  <!-- Coordination Unit Process -->
  <bpmn:process id="Process_CoordinationUnit" isExecutable="false">
    <bpmn:startEvent id="StartTimer_November" name="November Each Year">
      <bpmn:timerEventDefinition/>
      <bpmn:outgoing>SeqFlow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_DraftSchedule" name="Draft Schedule of Meetings">
      <bpmn:name>Draft schedule for next calendar year</bpmn:name>
      <bpmn:incoming>SeqFlow_01</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_02</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_AddDraftDates" name="Add Draft Dates to Calendars">
      <bpmn:name>Add draft dates to all calendars</bpmn:name>
      <bpmn:incoming>SeqFlow_02</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_03</bpmn:outgoing>
    </bpmn:task>

    <bpmn:intermediateThrowEvent id="ThrowEvent_SendScheduleToMembers" name="Send Schedule to Members">
      <bpmn:name>Send schedule by email</bpmn:name>
      <bpmn:incoming>SeqFlow_03</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_04</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <bpmn:task id="Task_RecheckDates" name="Recheck All Dates">
      <bpmn:name>Recheck dates for conflicts</bpmn:name>
      <bpmn:incoming>SeqFlow_04</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_05</bpmn:outgoing>
    </bpmn:task>

    <bpmn:intermediateCatchEvent id="CatchEvent_CoordinationReceivesAdvice" name="Receive Conflict Advice">
      <bpmn:name>Receive advice from members</bpmn:name>
      <bpmn:incoming>SeqFlow_05</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_FinalizeSchedule</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:endEvent id="End_Complete" name="Process Complete">
      <bpmn:name>Schedule finalized and conflicts resolved</bpmn:name>
      <bpmn:incoming>SeqFlow_FinalizeSchedule</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SeqFlow_01" sourceRef="StartTimer_November" targetRef="Task_DraftSchedule"/>
    <bpmn:sequenceFlow id="SeqFlow_02" sourceRef="Task_DraftSchedule" targetRef="Task_AddDraftDates"/>
    <bpmn:sequenceFlow id="SeqFlow_03" sourceRef="Task_AddDraftDates" targetRef="ThrowEvent_SendScheduleToMembers"/>
    <bpmn:sequenceFlow id="SeqFlow_04" sourceRef="ThrowEvent_SendScheduleToMembers" targetRef="Task_RecheckDates"/>
    <bpmn:sequenceFlow id="SeqFlow_05" sourceRef="Task_RecheckDates" targetRef="CatchEvent_CoordinationReceivesAdvice"/>
    <bpmn:sequenceFlow id="SeqFlow_FinalizeSchedule" sourceRef="CatchEvent_CoordinationReceivesAdvice" targetRef="End_Complete"/>

  </bpmn:process>

</bpmn:definitions>