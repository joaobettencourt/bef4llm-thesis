<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_BicycleManufacturing">
    <bpmn:participant id="Participant_Company" name="Company Manufacturing Customized Bicycles" processRef="Process_001"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_001" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_SalesDepartment" name="Sales Department">
        <bpmn:flowNodeRef>StartEvent_OrderReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RejectAcceptOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AcceptReject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_OrderRejected</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Storehouse" name="Storehouse">
        <bpmn:flowNodeRef>Task_ProcessPartList</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PartAvailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReservePart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BackOrderPart</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Engineering" name="Engineering Department">
        <bpmn:flowNodeRef>Gateway_SynchronizePrepAssembly</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareAssembling</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Assembly" name="Assembly">
        <bpmn:flowNodeRef>Gateway_SynchronizePrepAssembly</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssembleBicycle</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Delivery" name="Delivery">
        <bpmn:flowNodeRef>Task_ShipToCustomer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ProcessFinished</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Information" name="Sales Department (Inform)">
        <bpmn:flowNodeRef>Task_InformStorehouseEng</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Parallel_Gateway_Inform</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_OrderReceived" name="Order Received">
      <bpmn:name>Receive Order for Customized Bike</bpmn:name>
      <bpmn:outgoing>SeqFlow_StartToDecision</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_OrderRejected" name="Order Rejected">
      <bpmn:name>Process Instance Finished (Rejection)</bpmn:name>
      <bpmn:incoming>SeqFlow_RejectToReject</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_ProcessFinished" name="Order Completed">
      <bpmn:name>Process Instance Finished (Success)</bpmn:name>
      <bpmn:incoming>SeqFlow_ShipToFinish</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Tasks -->
    <bpmn:task id="Task_RejectAcceptOrder" name="Reject or Accept Order">
      <bpmn:name>Member Rejects/Accepts Order</bpmn:name>
      <bpmn:incoming>SeqFlow_StartToDecision</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_DecisionToAcceptOrReject</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_InformStorehouseEng" name="Inform Departments">
      <bpmn:name>Informs Storehouse and Engineering Department</bpmn:name>
      <bpmn:incoming>SeqFlow_AcceptToInform</bpmn:incoming>
    </bpmn:task>

    <bpmn:task id="Task_ProcessPartList" name="Process Part List">
      <bpmn:name>Processes Part List of Order</bpmn:name>
      <bpmn:incoming>SeqFlow_StorehouseCheckParts</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_CheckQuantity</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_ReservePart" name="Reserve Part">
      <bpmn:name>Reserved In-House Part</bpmn:name>
      <bpmn:incoming>SeqFlow_YesAvailableToReserve</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_ReserveBackCheckMore</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_BackOrderPart" name="Back-Order Part">
      <bpmn:name>Back-Ordered In-House Part</bpmn:name>
      <bpmn:incoming>SeqFlow_NoAvailableToBackorder</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_ReserveBackCheckMore</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_PrepareAssembling" name="Prepare Assembling">
      <bpmn:name>Prepares Everything for Assembly</bpmn:name>
      <bpmn:incoming>SeqFlow_EngineeringPrepare</bpmn:incoming>
    </bpmn:task>

    <bpmn:task id="Task_AssembleBicycle" name="Assemble Bicycle">
      <bpmn:name>Assembles the Ordered Bicycle</bpmn:name>
      <bpmn:incoming>SeqFlow_SynchronizeToAssembly</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_AssemblyToShip</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_ShipToCustomer" name="Ship to Customer">
      <bpmn:name>Ships Bicycle to Customer</bpmn:name>
      <bpmn:incoming>SeqFlow_AssemblyToShip</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_ShipToFinish</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateways -->
    <bpmn:exclusiveGateway id="Gateway_AcceptReject" name="Accept Order?">
      <bpmn:name>Member Accepts/Rejects?</bpmn:name>
      <bpmn:incoming>SeqFlow_DecisionToAcceptOrReject</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_RejectOrder</bpmn:outgoing>
      <bpmn:outgoing>SeqFlow_AcceptOrder</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:parallelGateway id="Parallel_Gateway_Inform" name="Inform Departments">
      <bpmn:name>Informs Both Departments (Split)</bpmn:name>
      <bpmn:incoming>SeqFlow_AcceptToInform</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_StorehouseCheckParts</bpmn:outgoing>
      <bpmn:outgoing>SeqFlow_EngineeringPrepare</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:exclusiveGateway id="Gateway_PartAvailable" name="Part Available?">
      <bpmn:name>In-House Part Available?</bpmn:name>
      <bpmn:incoming>SeqFlow_CheckQuantity</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_YesAvailableToReserve</bpmn:outgoing>
      <bpmn:outgoing>SeqFlow_NoAvailableToBackorder</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:parallelGateway id="Parallel_Gateway_Synchronize" name="Synchronize">
      <bpmn:name>Synchronizes Storehouse &amp; Engineering (Join)</bpmn:name>
      <bpmn:incoming>SeqFlow_ReserveBackCheckMore</bpmn:incoming>
      <bpmn:incoming>SeqFlow_EngineeringPrepareDone</bpmn:incoming>
    </bpmn:parallelGateway>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SeqFlow_StartToDecision" sourceRef="StartEvent_OrderReceived" targetRef="Task_RejectAcceptOrder">
      <bpmn:name>To Decision</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SeqFlow_DecisionToAcceptOrReject" sourceRef="Gateway_AcceptReject" targetRef="Task_RejectAcceptOrder"/>

    <bpmn:sequenceFlow id="SeqFlow_RejectToReject" name="Rejected">
      <bpmn:name>Rejection Path</bpmn:name>
      <bpmn:sourceRef>Gateway_AcceptReject</bpmn:sourceRef>
      <bpmn:targetRef>EndEvent_OrderRejected</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SeqFlow_AcceptOrder" name="Accepted">
      <bpmn:name>Acceptance Path</bpmn:name>
      <bpmn:sourceRef>Gateway_AcceptReject</bpmn:sourceRef>
      <bpmn:targetRef>Task_InformStorehouseEng</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SeqFlow_AcceptToInform" sourceRef="Gateway_AcceptReject" targetRef="Parallel_Gateway_Inform">
      <bpmn:name>To Inform Departments</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SeqFlow_StorehouseCheckParts" name="To Storehouse Check Parts">
      <bpmn:name>Storehouse Path (Split)</bpmn:name>
      <bpmn:sourceRef>Parallel_Gateway_Inform</bpmn:sourceRef>
      <bpmn:targetRef>Task_ProcessPartList</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SeqFlow_EngineeringPrepare" name="To Engineering Prepare">
      <bpmn:name>Engineering Path (Split)</bpmn:name>
      <bpmn:sourceRef>Parallel_Gateway_Inform</bpmn:sourceRef>
      <bpmn:targetRef>Task_PrepareAssembling</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SeqFlow_CheckQuantity" sourceRef="Task_ProcessPartList" targetRef="Gateway_PartAvailable">
      <bpmn:name>To Check Availability</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SeqFlow_YesAvailableToReserve" name="In-House Available">
      <bpmn:name>In-House Part Available?</bpmn:name>
      <bpmn:sourceRef>Gateway_PartAvailable</bpmn:sourceRef>
      <bpmn:targetRef>Task_ReservePart</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SeqFlow_NoAvailableToBackorder" name="Not Available">
      <bpmn:name>In-House Part Not Available?</bpmn:name>
      <bpmn:sourceRef>Gateway_PartAvailable</bpmn:sourceRef>
      <bpmn:targetRef>Task_BackOrderPart</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SeqFlow_ReserveBackCheckMore" sourceRef="Gateway_PartAvailable" targetRef="Parallel_Gateway_Synchronize">
      <bpmn:name>To Synchronization Gateway (Join)</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SeqFlow_EngineeringPrepareDone" name="Preparation Done">
      <bpmn:name>Engineering Preparation Complete</bpmn:name>
      <bpmn:sourceRef>Task_PrepareAssembling</bpmn:sourceRef>
      <bpmn:targetRef>Parallel_Gateway_Synchronize</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SeqFlow_SynchronizeToAssembly" sourceRef="Parallel_Gateway_Synchronize" targetRef="Task_AssembleBicycle">
      <bpmn:name>To Assembly (Join)</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SeqFlow_AssemblyToShip" name="After Assembly">
      <bpmn:name>Assembly Complete</bpmn:name>
      <bpmn:sourceRef>Task_AssembleBicycle</bpmn:sourceRef>
      <bpmn:targetRef>Task_ShipToCustomer</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SeqFlow_ShipToFinish" sourceRef="Task_ShipToCustomer" targetRef="EndEvent_ProcessFinished">
      <bpmn:name>To Process End</bpmn:name>
    </bpmn:sequenceFlow>
  </bpmn:process>

  <!-- Reusable Elements -->
  <bpmn:message id="Message_OrderReceived"/>
  <bpmn:message id="Message_PartReserved"/>
  <bpmn:message id="Message_BackOrdered"/>
</bpmn:definitions>