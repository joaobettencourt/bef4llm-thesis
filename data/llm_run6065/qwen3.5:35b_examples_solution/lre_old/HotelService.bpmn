<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_RoomService">
    <bpmn:participant id="Participant_Hotel" name="The Evanstonian Hotel" processRef="Process_RoomService"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_RoomService" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Manager" name="Room-Service Manager">
        <bpmn:flowNodeRef>StartEvent_Call</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TakeOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_AlcoholicCheck</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Kitchen" name="Kitchen">
        <bpmn:flowNodeRef>Task_PrepareFood</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Sommelier" name="Sommelier">
        <bpmn:flowNodeRef>Gw_AlcoholicCheck2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FetchWine</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Waiter" name="Waiter">
        <bpmn:flowNodeRef>Gw_CartReady</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReadiesCart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DeliverToRoom</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Returned</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DebitAccount</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Call" name="Guest calls room service">
      <bpmn:outgoing>SeqFlow_TakeOrder</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- End Events -->
    <bpmn:endEvent id="End_Completed" name="Service completed">
      <bpmn:incoming>SeqFlow_DebitAccount</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Tasks - Room-Service Manager Lane -->
    <bpmn:task id="Task_TakeOrder" name="Take down order and submit ticket">
      <bpmn:incoming>SeqFlow_TakeOrder</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_AlcoholicCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Tasks - Kitchen Lane -->
    <bpmn:task id="Task_PrepareFood" name="Prepare food">
      <bpmn:incoming>SeqFlow_SubmitTicket</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_FoodReady</bpmn:outgoing>
    </bpmn:task>

    <!-- Tasks - Sommelier Lane -->
    <bpmn:task id="Task_FetchWine" name="Fetch wine and prepare alcoholic beverages">
      <bpmn:incoming>SeqFlow_GiveOrderSommelier</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_WineReady</bpmn:outgoing>
    </bpmn:task>

    <!-- Tasks - Waiter Lane -->
    <bpmn:task id="Task_ReadiesCart" name="Readies cart (tablecloth, silverware)">
      <bpmn:incoming>SeqFlow_AssignOrder</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_CartReady</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_DeliverToRoom" name="Deliver to guest's room">
      <bpmn:incoming>SeqFlow_AllReady</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_Returned</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_DebitAccount" name="Debit guest's account">
      <bpmn:incoming>SeqFlow_Returned</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_Completed</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateways -->
    
    <!-- Exclusive Gateway for Alcoholic Beverages (80% probability) - Manager Lane -->
    <bpmn:exclusiveGateway id="Gw_AlcoholicCheck" name="Alcoholic beverages ordered?">
      <bpmn:incoming>SeqFlow_AlcoholicCheck</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_SubmitTicket</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Exclusive Gateway for Alcoholic Beverages - Sommelier Lane -->
    <bpmn:exclusiveGateway id="Gw_AlcoholicCheck2" name="Alcoholic beverages ordered?">
      <bpmn:incoming>SeqFlow_GiveOrderSommelier</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_WineReady</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Parallel Gateway for Cart Readiness - Waiter Lane -->
    <bpmn:parallelGateway id="Gw_CartReady" name="Cart Ready">
      <bpmn:incoming>SeqFlow_AssignOrder</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_ReadiesCart</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Parallel Gateway for Convergence - Waiter Lane -->
    <bpmn:parallelGateway id="Gw_Returned" name="All Ready">
      <bpmn:incoming>SeqFlow_FoodReady</bpmn:incoming>
      <bpmn:incoming>SeqFlow_WineReady</bpmn:incoming>
      <bpmn:incoming>SeqFlow_CartReady</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_DeliverToRoom</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Sequence Flows -->
    
    <!-- Manager Lane Flow -->
    <bpmn:sequenceFlow id="SeqFlow_TakeOrder" sourceRef="StartEvent_Call" targetRef="Task_TakeOrder"/>
    <bpmn:sequenceFlow id="SeqFlow_AlcoholicCheck" name="Alcohol ordered?" sourceRef="Task_TakeOrder" targetRef="Gw_AlcoholicCheck">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${hasAlcoholicBeverage}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Kitchen Lane Flow -->
    <bpmn:sequenceFlow id="SeqFlow_SubmitTicket" sourceRef="Gw_AlcoholicCheck" targetRef="Task_PrepareFood"/>
    
    <!-- Sommelier Lane Flow (Conditional) -->
    <bpmn:sequenceFlow id="SeqFlow_GiveOrderSommelier" name="Give order to sommelier" sourceRef="Gw_AlcoholicCheck2" targetRef="Task_FetchWine">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${hasAlcoholicBeverage}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Waiter Lane Flow -->
    <bpmn:sequenceFlow id="SeqFlow_AssignOrder" sourceRef="Gw_AlcoholicCheck2" targetRef="Task_ReadiesCart"/>
    
    <!-- Convergence Flows to Parallel Gateway -->
    <bpmn:sequenceFlow id="SeqFlow_FoodReady" name="Food ready" sourceRef="Task_PrepareFood" targetRef="Gw_Returned"/>
    <bpmn:sequenceFlow id="SeqFlow_WineReady" name="Wine ready" sourceRef="Task_FetchWine" targetRef="Gw_Returned">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${hasAlcoholicBeverage}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    
    <!-- Cart Readiness Flow -->
    <bpmn:sequenceFlow id="SeqFlow_ReadiesCart" sourceRef="Task_ReadiesCart" targetRef="Gw_CartReady"/>
    <bpmn:sequenceFlow id="SeqFlow_CartReady" name="Cart ready" sourceRef="Gw_CartReady" targetRef="Gw_Returned"/>

    <!-- Delivery and Billing Flow -->
    <bpmn:sequenceFlow id="SeqFlow_DeliverToRoom" sourceRef="Gw_Returned" targetRef="Task_DeliverToRoom"/>
    <bpmn:sequenceFlow id="SeqFlow_Returned" name="Returned to station" sourceRef="Task_DeliverToRoom" targetRef="Gw_Returned">
      <!-- Note: This represents the waiter returning after delivery -->
    </bpmn:sequenceFlow>

    <bpmn:parallelGateway id="Gw_BillingCheck" name="Billing Ready">
      <bpmn:incoming>SeqFlow_Returned</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_DebitAccount</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Final Flow -->
    <bpmn:sequenceFlow id="SeqFlow_Completed" sourceRef="Task_DebitAccount" targetRef="End_Completed"/>

  </bpmn:process>
</bpmn:definitions>