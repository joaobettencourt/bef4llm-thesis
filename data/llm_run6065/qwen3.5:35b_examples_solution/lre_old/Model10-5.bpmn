<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_OrderTakeover">
    <bpmn:participant id="Participant_MPON" name="MPON" processRef="Process_MPON"/>
    <bpmn:participant id="Participant_MPOO" name="MPOO" processRef="Process_MPOO"/>
    
    <!-- Message Flows between participants -->
    <bpmn:messageFlow id="MsgFlow_RequestBid">
      <bpmn:name>Request device takeover bid</bpmn:name>
      <bpmn:sourceRef="Task_MPON_RequestBid" />
      <bpmn:targetRef="StartMessage_MPOO_Tender" />
    </bpmn:messageFlow>
    
    <bpmn:messageFlow id="MsgFlow_SendTender">
      <bpmn:name>Tender for equipment takeover</bpmn:name>
      <bpmn:sourceRef="Task_MPOO_SendTender" />
      <bpmn:targetRef="StartMessage_MPON_Order" />
    </bpmn:messageFlow>
    
    <bpmn:messageFlow id="MsgFlow_ConfirmOrder">
      <bpmn:name>Confirm order and master data</bpmn:name>
      <bpmn:sourceRef="Task_MPOO_ConfirmOrder" />
      <bpmn:targetRef="End_MPON_Complete" />
    </bpmn:messageFlow>
  </bpmn:collaboration>

  <!-- MPON Process -->
  <bpmn:process id="Process_MPON" isExecutable="false">
    <bpmn:startEvent id="StartNone_MPON_RequestBid" name="Request device takeover bid">
      <bpmn:outgoing>SeqFlow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_MPON_RequestBid" name="Request a device takeover bid">
      <bpmn:name>Request a device takeover bid</bpmn:name>
      <bpmn:incoming>SeqFlow_01</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_02</bpmn:outgoing>
    </bpmn:task>

    <bpmn:startEvent id="StartMessage_MPON_Order" name="Receive Tender">
      <bpmn:messageRef="Msg_TenderReceived"/>
      <bpmn:outgoing>SeqFlow_03</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_MPON_Order" name="Place order at MPOO">
      <bpmn:name>Place order at MPOO</bpmn:name>
      <bpmn:incoming>SeqFlow_03</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_04</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="End_MPON_Complete" name="Order completed">
      <bpmn:name>Order Completed Successfully</bpmn:name>
      <bpmn:incoming>SeqFlow_04</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SeqFlow_01" sourceRef="StartNone_MPON_RequestBid" targetRef="Task_MPON_RequestBid">
      <bpmn:name>To Request Bid</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SeqFlow_02" sourceRef="Task_MPON_RequestBid" targetRef="StartNone_MPON_RequestBid"/>

    <bpmn:sequenceFlow id="SeqFlow_03" sourceRef="StartMessage_MPON_Order" targetRef="Task_MPON_Order"/>

    <bpmn:sequenceFlow id="SeqFlow_04" sourceRef="Task_MPON_Order" targetRef="End_MPON_Complete">
      <bpmn:name>Order Placed</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Messages -->
    <bpmn:message id="Msg_BidRequest"/>
    <bpmn:message id="Msg_TenderReceived"/>
  </bpmn:process>

  <!-- MPOO Process -->
  <bpmn:process id="Process_MPOO" isExecutable="false">
    <bpmn:startEvent id="StartMessage_MPOO_Tender" name="Receive Bid Request">
      <bpmn:messageRef="Msg_BidRequest"/>
      <bpmn:outgoing>SeqFlow_10</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_MPOO_SendTender" name="Send tender for equipment takeover">
      <bpmn:name>Tender Equipment Takeover</bpmn:name>
      <bpmn:incoming>SeqFlow_10</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_11</bpmn:outgoing>
    </bpmn:task>

    <bpmn:startEvent id="StartMessage_MPOO_Order" name="Receive Order">
      <bpmn:messageRef="Msg_OrderReceived"/>
      <bpmn:outgoing>SeqFlow_12</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:endEvent id="End_MPOO_Complete" name="Order Confirmed">
      <bpmn:name>MPOO Process Complete</bpmn:name>
      <bpmn:incoming>SeqFlow_13</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task for confirming order -->
    <bpmn:task id="Task_MPOO_ConfirmOrder" name="Confirm order and send master data">
      <bpmn:name>Confirm Order Send Master Data</bpmn:name>
      <bpmn:incoming>SeqFlow_12</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_13</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SeqFlow_10" sourceRef="StartMessage_MPOO_Tender" targetRef="Task_MPOO_SendTender"/>

    <bpmn:sequenceFlow id="SeqFlow_11" sourceRef="Task_MPOO_SendTender" targetRef="End_MPOO_Complete">
      <bpmn:name>Tender Sent</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SeqFlow_12" sourceRef="StartMessage_MPOO_Order" targetRef="Task_MPOO_ConfirmOrder"/>

    <bpmn:sequenceFlow id="SeqFlow_13" sourceRef="Task_MPOO_ConfirmOrder" targetRef="End_MPOO_Complete">
      <bpmn:name>Confirmation Sent</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Messages -->
    <bpmn:message id="Msg_OrderReceived"/>
  </bpmn:process>
</bpmn:definitions>