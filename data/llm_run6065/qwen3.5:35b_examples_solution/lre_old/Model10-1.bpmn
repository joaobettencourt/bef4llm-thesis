<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_DismissalProcess">
    <bpmn:participant id="Participant_MPON" name="MPON" processRef="Pool_MPON"/>
    <bpmn:participant id="Participant_MPOO" name="MPOO" processRef="Pool_MPOO"/>
    
    <!-- Message Flow for sending dismissal -->
    <bpmn:messageFlow id="Message_SendDismissal">
      <bpmn:name>Send Dismissal</bpmn:name>
      <bpmn:sourceRef>ThrowEvent_DismissalSent</bpmn:sourceRef>
      <bpmn:targetRef>CatchEvent_DismissalReceived</bpmn:targetRef>
    </bpmn:messageFlow>
  </bpmn:collaboration>

  <!-- MPON Process -->
  <bpmn:process id="Pool_MPON" isExecutable="false">
    <bpmn:startEvent id="Start_MPON_01">
      <bpmn:name>Initiate Dismissal</bpmn:name>
      <bpmn:outgoing>SeqFlow_StartToThrow</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:endEvent id="End_MPON_01">
      <bpmn:name>Dismissal Sent</bpmn:name>
      <bpmn:incoming>SeqFlow_EndMPON</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Intermediate Throw Event for sending dismissal -->
    <bpmn:intermediateThrowEvent id="ThrowEvent_DismissalSent">
      <bpmn:name>Dismissal Sent to MPOO</bpmn:name>
      <bpmn:incoming>SeqFlow_ThrowToEnd</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_EndMPON</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SeqFlow_StartToThrow" sourceRef="Start_MPON_01" targetRef="ThrowEvent_DismissalSent">
      <bpmn:name>To Send Dismissal</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SeqFlow_ThrowToEnd" sourceRef="ThrowEvent_DismissalSent" targetRef="End_MPON_01">
      <bpmn:name>To End MPON</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>

  <!-- MPOO Process -->
  <bpmn:process id="Pool_MPOO" isExecutable="false">
    
    <!-- Start Event - Message Catching for dismissal received -->
    <bpmn:startEvent id="StartMessage_01">
      <bpmn:name>Dismissal Received</bpmn:name>
      <bpmn:outgoing>SeqFlow_StartToReview</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- End Events -->
    <bpmn:endEvent id="End_MPOO_Oppose">
      <bpmn:name>Dismissal Opposed</bpmn:name>
      <bpmn:incoming>SeqFlow_EndOppose</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="End_MPOO_Confirm">
      <bpmn:name>Dismissal Confirmed</bpmn:name>
      <bpmn:incoming>SeqFlow_EndConfirm</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task - Review Dismissal -->
    <bpmn:task id="Task_Review">
      <bpmn:name>Review the dismissal</bpmn:name>
      <bpmn:incoming>SeqFlow_StartToReview</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_ToGateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway for decision -->
    <bpmn:exclusiveGateway id="Gateway_Decision">
      <bpmn:name>Decision on Dismissal</bpmn:name>
      <bpmn:incoming>SeqFlow_ToGateway</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_OpposePath</bpmn:outgoing>
      <bpmn:outgoing>SeqFlow_ConfirmPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SeqFlow_StartToReview" sourceRef="StartMessage_01" targetRef="Task_Review">
      <bpmn:name>To Review</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SeqFlow_ToGateway" sourceRef="Task_Review" targetRef="Gateway_Decision">
      <bpmn:name>To Decision Gateway</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Oppose Path -->
    <bpmn:sequenceFlow id="SeqFlow_OpposePath" sourceRef="Gateway_Decision" targetRef="End_MPOO_Oppose">
      <bpmn:name>Oppose Dismissal</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Confirm Path -->
    <bpmn:sequenceFlow id="SeqFlow_ConfirmPath" sourceRef="Gateway_Decision" targetRef="End_MPOO_Confirm">
      <bpmn:name>Confirm Dismissal</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>

</bpmn:definitions>