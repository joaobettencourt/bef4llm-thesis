<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_001">
    <bpmn:participant id="Participant_001" name="Claims Processing System" processRef="Process_001"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_001" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Clerk" name="Clerk">
        <bpmn:flowNodeRef>StartEvent_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SearchPoliceReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ComposeFile</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ClaimsHandler" name="Claims Handler">
        <bpmn:flowNodeRef>Task_CalculateEstimate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateActionPlan</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ClaimsManager" name="Claims Manager">
        <bpmn:flowNodeRef>Task_NegotiateSettlement</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_001" name="Receive Claim">
      <bpmn:outgoing>SequenceFlow_001</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_Success_001" name="Claim Processed Successfully">
      <bpmn:incoming>SequenceFlow_006</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Tasks - Clerk Lane -->
    <bpmn:task id="Task_SearchPoliceReport" name="Search Police Report Database">
      <bpmn:incoming>SequenceFlow_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_002</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_ComposeFile" name="Compose File with Claim Documentation">
      <bpmn:incoming>SequenceFlow_002</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_003</bpmn:outgoing>
    </bpmn:task>

    <!-- Tasks - Claims Handler Lane -->
    <bpmn:task id="Task_CalculateEstimate" name="Calculate Initial Claim Estimate">
      <bpmn:incoming>SequenceFlow_003</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_004</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_CreateActionPlan" name="Create Action Plan from Checklist">
      <bpmn:incoming>SequenceFlow_004</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_005</bpmn:outgoing>
    </bpmn:task>

    <!-- Tasks - Claims Manager Lane -->
    <bpmn:task id="Task_NegotiateSettlement" name="Negotiate Settlement on Claim Estimate">
      <bpmn:incoming>SequenceFlow_005</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_006</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_001" sourceRef="StartEvent_001" targetRef="Task_SearchPoliceReport"/>
    <bpmn:sequenceFlow id="SequenceFlow_002" name="To Compose File" sourceRef="Task_SearchPoliceReport" targetRef="Task_ComposeFile"/>
    <bpmn:sequenceFlow id="SequenceFlow_003" name="To Claims Handler" sourceRef="Task_ComposeFile" targetRef="Task_CalculateEstimate"/>
    <bpmn:sequenceFlow id="SequenceFlow_004" sourceRef="Task_CalculateEstimate" targetRef="Task_CreateActionPlan"/>
    <bpmn:sequenceFlow id="SequenceFlow_005" name="To Claims Manager" sourceRef="Task_CreateActionPlan" targetRef="Task_NegotiateSettlement"/>
    <bpmn:sequenceFlow id="SequenceFlow_006" name="To Notify Claimant" sourceRef="Task_NegotiateSettlement" targetRef="EndEvent_Success_001"/>

  </bpmn:process>
</bpmn:definitions>