<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ShippingProcess_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_ShippingDispatch">
    <bpmn:participant id="Participant_MainPool" name="Shipping Dispatch Process" processRef="Process_Shipping_001"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Shipping_001" isExecutable="false">
    <!-- Lane Configuration -->
    <bpmn:laneSet id="LaneSet_MainPool">
      <bpmn:lane id="Lane_Secretary" name="Secretary">
        <bpmn:flowNodeRef>StartEvent_ShipGoods</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ClariyShipmentMethod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DecideSpecialHandling</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_LogisticsDepartment" name="Logistics Department">
         <bpmn:flowNodeRef>Task_Get3OffersFromCompanies</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectCompanyAndPlaceOrder</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Warehouse" name="Warehouse">
         <bpmn:flowNodeRef>InclusiveGateway_NormalShippingPath</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WritePackageLabel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InsureParcelIfNecessary</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_ShipGoods" name="Ship goods">
        <bpmn:outgoing>SF_StartToParallelGateway</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Parallel Gateway for splitting paths -->
    <bpmn:parallelGateway id="ParallelGateway_MainSplit" name="">
      <bpmn:incoming>SF_StartToParallelGateway</bpmn:incoming>
       <bpmn:outgoing>SF_ToSecretaryPath</bpmn:outgoing>
        <bpmn:outgoing>SF_ToWarehousePackaging</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 1 - Secretary clarifies shipment method -->
     <bpmn:task id="Task_ClariyShipmentMethod" name="Clarify shipment method">
        <bpmn:incoming>SF_ToSecretaryPath</bpmn:incoming>
       <bpmn:outgoing>SF_DecideSpecialHandlingFlow</bpmn:outgoing>
    </task>

     <!-- Exclusive Gateway - Decision point for special handling -->
      <bpmn:exclusiveGateway id="Gateway_DecideSpecialHandling" name="Large amounts?">
        <bpmn:incoming>SF_DecideSpecialHandlingFlow</bpmn:incoming>
       <bpmn:outgoing>SF_SpecialShippingPath</bpmn:outgoing>
         <bpmn:outgoing>SF_NormalShippingPathToInclusiveGateway</bpmn:outgoing>
      </bpmn:exclusiveGateway>

    <!-- Task 2 - Get offers from logistic companies (for large amounts) -->
     <bpmn:task id="Task_Get3OffersFromCompanies" name="Get 3 offers&#10;from logistic&#10;companies">
        <bpmn:incoming>SF_SpecialShippingPath</bpmn:incoming>
       <bpmn:outgoing>SF_SelectCompanyFlow</bpmn:outgoing>
    </task>

     <!-- Task 3 - Select company and place order -->
      <bpmn:task id="Task_SelectCompanyAndPlaceOrder" name="Select logistic&#10;company and&#10;place order">
        <bpmn:incoming>SF_SelectCompanyFlow</bpmn:incoming>
       <bpmn:outgoing>SF_ToMergeGateway2</bpmn:outgoing>
    </task>

     <!-- Inclusive Gateway for normal shipping path (small amounts) -->
      <bpmn:inclusiveGateway id="InclusiveGateway_NormalShippingPath">
        <bpmn:incoming>SF_NormalShippingPathToInclusiveGateway</bpmn:incoming>
       <bpmn:outgoing>SF_WritePackageLabelFlow</bpmn:outgoing>
         <bpmn:outgoing>SF_InsureParcelIfNecessaryFlow</bpmn:outgoing>
      </bpmn:inclusiveGateway>

     <!-- Task 4 - Write package label -->
       <bpmn:task id="Task_WritePackageLabel" name="Write package&#10;label">
        <bpmn:incoming>SF_WritePackageLabelFlow</bpmn:incoming>
       <bpmn:outgoing>SF_ToMergeGateway1</bpmn:outgoing>
    </task>

     <!-- Task 5 - Insure parcel if necessary -->
      <bpmn:task id="Task_InsureParcelIfNecessary" name="Insure parcel">
        <bpmn:incoming>SF_InsureParcelIfNecessaryFlow</bpmn:incoming>
       <bpmn:outgoing>SF_ToMergeGateway1</bpmn:outgoing>
    </task>

     <!-- Inclusive Gateway to merge paths -->
      <bpmn:inclusiveGateway id="InclusiveGateway_MergePaths">
        <bpmn:incoming>SF_ToMergeGateway1</bpmn:incoming>
       <bpmn:incoming>SF_SpecialShippingPathToFinalDecisionPoint</bpmn:outgoing>
         <bpmn:outgoing>SF_ToFinalDecisionPoint</bpmn:outgoing>
      </bpmn:inclusiveGateway>

     <!-- Task 6 - Package goods (Warehouse) -->
       <bpmn:task id="Task_PackageGoods" name="Package goods">
        <bpmn:incoming>SF_ToWarehousePackaging</bpmn:incoming>
       <bpmn:outgoing>SF_ToFinalDecisionPoint2</bpmn:outgoing>
    </task>

     <!-- Exclusive Gateway for final merge -->
      <bpmn:exclusiveGateway id="ExclusiveGateway_MergePaths3">
        <bpmn:incoming>SF_ToMergeGateway1</bpmn:incoming>
         <bpmn:incoming>SF_PackageGoodsToFinalDecisionPoint2</bpmn:outgoing>
       <bpmn:outgoing>SF_PrepareForPickupFlow</bpmn:outgoing>
      </bpmn:exclusiveGateway>

     <!-- Task 7 - Prepare for pickup -->
       <bpmn:task id="Task_PrepareForPickup" name="Prepare for&#10;picking up&#10;goods">
        <bpmn:incoming>SF_ToFinalDecisionPoint</bpmn:outgoing>
         <bpmn:outgoing>SF_FinalEndEventFlow</bpmn:outgoing>
    </task>

     <!-- End Event -->
      <bpmn:endEvent id="EndEvent_ShipmentPrepared" name="Shipment&#10;prepared">
        <bpmn:incoming>SF_FinalEndEventFlow</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
      <bpmn:sequenceFlow id="SF_StartToParallelGateway" sourceRef="StartEvent_ShipGoods" targetRef="ParallelGateway_MainSplit"/>
       <bpmn:sequenceFlow id="SF_ToSecretaryPath" sourceRef="ParallelGateway_MainSplit" targetRef="Task_ClariyShipmentMethod"/>
        <bpmn:sequenceFlow id="SF_DecideSpecialHandlingFlow" sourceRef="Task_ClariyShipmentMethod" targetRef="Gateway_DecideSpecialHandling"/>
         <bpmn:sequenceFlow id="SF_SpecialShippingPath" name="yes" sourceRef="Gateway_DecideSpecialHandling" targetRef="Task_Get3OffersFromCompanies"/>
          <bpmn:sequenceFlow id="SF_NormalShippingPathToInclusiveGateway" name="no" sourceRef="Gateway_DecideSpecialHandling" targetRef="InclusiveGateway_NormalShippingPath"/>
           <bpmn:sequenceFlow id="SF_SelectCompanyFlow" sourceRef="Task_Get3OffersFromCompanies" targetRef="Task_SelectCompanyAndPlaceOrder"/>
            <bpmn:sequenceFlow id="SF_ToMergeGateway2" name="" sourceRef="Task_SelectCompanyAndPlaceOrder" targetRef="InclusiveGateway_MergePaths"/>
             <bpmn:sequenceFlow id="SF_WritePackageLabelFlow" sourceRef="InclusiveGateway_NormalShippingPath" targetRef="Task_WritePackageLabel"/>
              <bpmn:sequenceFlow id="SF_InsureParcelIfNecessaryFlow" name="" sourceRef="InclusiveGateway_NormalShippingPath" targetRef="Task_InsureParcelIfNecessary"/>
               <bpmn:sequenceFlow id="SF_ToMergeGateway1" sourceRef="Task_WritePackageLabel" targetRef="ExclusiveGateway_MergePaths3"/>
                <bpmn:sequenceFlow id="SF_PackageGoodsToFinalDecisionPoint2" name="" sourceRef="InclusiveGateway_NormalShippingPath" targetRef="Task_InsureParcelIfNecessary"/>
                 <bpmn:sequenceFlow id="SF_ToWarehousePackaging" sourceRef="ParallelGateway_MainSplit" targetRef="Task_PackageGoods"/>
                  <bpmn:sequenceFlow id="SF_ToFinalDecisionPoint2" name="" sourceRef="ExclusiveGateway_MergePaths3" targetRef="Task_PrepareForPickup"/>
                   <bpmn:sequenceFlow id="SF_FinalEndEventFlow" sourceRef="Task_PrepareForPickup" targetRef="EndEvent_ShipmentPrepared"/>

  </bpmn:process>
</bpmn:definitions>