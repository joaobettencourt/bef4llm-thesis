<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_3DPrintingProcess">
  <bpmn:collaboration>
    <bpmn:participant id="Participant_CustomPrintService" name="Custom Print Service" processRef="Process_PrintExecution"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_PrintExecution" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_RequestModel" name="Request Custom Model">
      <bpmn:outgoing>SequenceFlow_SendSketches</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Send Sketches -->
    <bpmn:userTask id="Task_SendSketches" name="Send sketches to artist">
      <bpmn:incoming>SequenceFlow_SendSketches</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ArtistStartsWork</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Artist Creates Model -->
    <bpmn:serviceTask id="Task_ArtistModel" name="Artist creates 3D model">
      <bpmn:incoming>SequenceFlow_ArtistStartsWork</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReceiveSTL</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Task: Receive STL -->
    <bpmn:userTask id="Task_ReceiveSTL" name="Receive STL from artist">
      <bpmn:incoming>SequenceFlow_ReceiveSTL</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckSatisfaction</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway: Satisfied with result? -->
    <bpmn:exclusiveGateway id="Gateway_Satisfied" name="Satisfied&#10;with the result?">
      <bpmn:incoming>SequenceFlow_CheckSatisfaction</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TellChanges</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ChoseColor</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Tell Artist Changes -->
    <bpmn:userTask id="Task_TellChanges" name="Tell artist what to change">
      <bpmn:incoming>SequenceFlow_TellChanges</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ArtistStartsWorkLoop</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Choose Color -->
    <bpmn:userTask id="Task_ChooseColor" name="Choose plastic color">
      <bpmn:incoming>SequenceFlow_ChoseColor</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckStockHome</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway: Have color at home? -->
    <bpmn:exclusiveGateway id="Gateway_HomeColor" name="Have&#10;color at home?">
      <bpmn:incoming>SequenceFlow_CheckStockHome</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OrderPlastic</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CheckAmount</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Gateway: Check Amount -->
    <bpmn:exclusiveGateway id="Gateway_CheckAmount" name="Under&#10;100 grams?">
      <bpmn:incoming>SequenceFlow_CheckAmount</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ShopList</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ConvergeStock</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Shopping List -->
    <bpmn:userTask id="Task_ShoppingList" name="Put on shopping list">
      <bpmn:incoming>SequenceFlow_ShopList</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConvergeStock2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Order Plastic -->
    <bpmn:userTask id="Task_OrderPlastic" name="Order plastic">
      <bpmn:incoming>SequenceFlow_OrderPlastic</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConvergeStock3</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Converge Stock Paths -->
    <bpmn:exclusiveGateway id="Gateway_ConvergeStock" name="">
      <bpmn:incoming>SequenceFlow_OrderPlastic</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ShopList</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PreparePrinter</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Parallel Split for Printing Prep -->
    <bpmn:parallelGateway id="Gateway_PrepSplit" name="">
      <bpmn:incoming>SequenceFlow_PreparePrinter</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PrinterOn</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_GenerateGCode</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Turn Printer On / Heat -->
    <bpmn:userTask id="Task_PrinterOn" name="Turn printer on&#10;and heat up">
      <bpmn:incoming>SequenceFlow_PrinterOn</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConvergePrep</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Generate GCode -->
    <bpmn:serviceTask id="Task_GenerateGCode" name="Generate gcode file">
      <bpmn:incoming>SequenceFlow_GenerateGCode</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConvergePrep2</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Converge Prep -->
    <bpmn:parallelGateway id="Gateway_PrepConverge" name="">
      <bpmn:incoming>SequenceFlow_PrinterOn</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_GenerateGCode</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StartPrint</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Print Model -->
    <bpmn:userTask id="Task_PrintModel" name="Print model">
      <bpmn:incoming>SequenceFlow_StartPrint</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndProcess</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_ModelPrinted" name="Model Printed">
      <bpmn:incoming>SequenceFlow_EndProcess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows for Logic -->
    <bpmn:sequenceFlow id="SequenceFlow_SendSketches" sourceRef="StartEvent_RequestModel" targetRef="Task_SendSketches"/>
    <bpmn:sequenceFlow id="SequenceFlow_ArtistStartsWork" sourceRef="Task_SendSketches" targetRef="Task_ArtistModel"/>
    <bpmn:sequenceFlow id="SequenceFlow_ReceiveSTL" sourceRef="Task_ArtistModel" targetRef="Task_ReceiveSTL"/>
    <bpmn:sequenceFlow id="SequenceFlow_CheckSatisfaction" name="" sourceRef="Task_ReceiveSTL" targetRef="Gateway_Satisfied"/>
    
    <!-- Satisfied Gateway Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_TellChanges" name="No" sourceRef="Gateway_Satisfied" targetRef="Task_TellChanges"/>
    <bpmn:sequenceFlow id="SequenceFlow_ArtistStartsWorkLoop" sourceRef="Task_TellChanges" targetRef="Task_ArtistModel"/>
    <bpmn:sequenceFlow id="SequenceFlow_ChoseColor" name="Yes" sourceRef="Gateway_Satisfied" targetRef="Task_ChooseColor"/>

    <!-- Stock Logic Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckStockHome" sourceRef="Task_ChooseColor" targetRef="Gateway_HomeColor"/>
    <bpmn:sequenceFlow id="SequenceFlow_OrderPlastic" name="No" sourceRef="Gateway_HomeColor" targetRef="Task_OrderPlastic"/>
    <bpmn:sequenceFlow id="SequenceFlow_CheckAmount" name="Yes" sourceRef="Gateway_HomeColor" targetRef="Gateway_CheckAmount"/>
    <bpmn:sequenceFlow id="SequenceFlow_ShopList" name="Under 100g" sourceRef="Gateway_CheckAmount" targetRef="Task_ShoppingList"/>

    <!-- Converge Stock Paths -->
    <bpmn:sequenceFlow id="SequenceFlow_ConvergeStock2" sourceRef="Task_OrderPlastic" targetRef="Gateway_ConvergeStock"/>
    <bpmn:sequenceFlow id="SequenceFlow_ConvergeStock3" sourceRef="Task_ShoppingList" targetRef="Gateway_ConvergeStock"/>

    <!-- Printing Prep Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_PreparePrinter" name="" sourceRef="Gateway_ConvergeStock" targetRef="Gateway_PrepSplit"/>
    <bpmn:sequenceFlow id="SequenceFlow_PrinterOn" sourceRef="Gateway_PrepSplit" targetRef="Task_PrinterOn"/>
    <bpmn:sequenceFlow id="SequenceFlow_GenerateGCode" name="" sourceRef="Gateway_PrepSplit" targetRef="Task_GenerateGCode"/>

    <!-- Converge Prep -->
    <bpmn:sequenceFlow id="SequenceFlow_ConvergePrep2" sourceRef="Task_PrinterOn" targetRef="Gateway_PrepConverge"/>
    <bpmn:sequenceFlow id="SequenceFlow_StartPrint" name="" sourceRef="Gateway_PrepConverge" targetRef="Task_PrintModel"/>

    <!-- End Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_EndProcess" sourceRef="Task_PrintModel" targetRef="EndEvent_ModelPrinted"/>

  </bpmn:process>
</bpmn:definitions>