<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_NewApplication_USICourse_1">
  <bpmn:collaboration>
    <bpmn:participant id="Participant_CourseRegistration" name="Course Registration Process" processRef="Process_CourseRegistration"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_CourseRegistration">
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Wish to enroll in course">
      <bpmn:outgoing>SequenceFlow_StartToSelectCourse</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Select Course Task -->
    <bpmn:userTask id="UserTask_SelectCourse1" name="Select a course">
      <bpmn:incoming>SequenceFlow_StartToSelectCourse</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SelectToCheckSlots</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Check Slots Gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_CheckSlots" name="Free spots?">
      <bpmn:incoming>SequenceFlow_SelectToCheckSlots</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SlotsYesToShowCourses</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SlotsNoSelectAnother</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- System Shows Courses Task -->
    <bpmn:serviceTask id="ServiceTask_ShowCourses" name="System shows courses and dates">
      <bpmn:incoming>SequenceFlow_SlotsYesToShowCourses</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CoursesToSelectSpecific</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Select Specific Course Task -->
    <bpmn:userTask id="UserTask_SelectCourse2" name="Select specific course">
      <bpmn:incoming>SequenceFlow_CoursesToSelectSpecific</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SpecificToCheckAccount</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Check Account Gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_CheckAccount" name="Already registered?">
      <bpmn:incoming>SequenceFlow_SpecificToCheckAccount</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AccountYesLogin</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_AccountNoCheckEligibility</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Check Eligible University Task -->
    <bpmn:userTask id="UserTask_CheckUniversity" name="Check if registered at eligible university">
      <bpmn:incoming>SequenceFlow_AccountNoCheckEligibility</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EligibilityToGateway</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Eligible University Gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_CheckEligibility" name="Eligible university?">
      <bpmn:incoming>SequenceFlow_EligibilityToGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EligibleYesRegisterAccount</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NotEligibleRequestActivation</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Register Account Task -->
    <bpmn:userTask id="UserTask_RegisterAccount" name="Register account">
      <bpmn:incoming>SequenceFlow_EligibleYesRegisterAccount</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AccountRegisteredToLoginCheck</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Request Activation Task -->
    <bpmn:userTask id="UserTask_RequestActivation" name="Request activation">
      <bpmn:incoming>SequenceFlow_NotEligibleRequestActivation</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ActivationToWaitResponse</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Wait for Response Task -->
    <bpmn:serviceTask id="ServiceTask_WaitResponse" name="System waits for activation response">
      <bpmn:incoming>SequenceFlow_ActivationToWaitResponse</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ResponseReceivedToEligibilityCheck2</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Second Eligibility Check Gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_CheckEligibility2" name="Person eligible?">
      <bpmn:incoming>SequenceFlow_ResponseReceivedToEligibilityCheck2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EligibleYesProceedLogin</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NotEligibleEndProcess</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Login Account Task -->
    <bpmn:userTask id="UserTask_Login" name="Log into account">
      <bpmn:incoming>SequenceFlow_AccountYesLogin</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_EligibleYesProceedLogin</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_LoggedInToParallelSplit</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel Gateway for Twitter and Registration -->
    <bpmn:parallelGateway id="ParallelGateway_Split" name="">
      <bpmn:incoming>SequenceFlow_LoggedInToParallelSplit</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TwitterConnect</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PaymentInfo</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Connect Twitter Task -->
    <bpmn:userTask id="UserTask_ConnectTwitter" name="Connect to twitter account">
      <bpmn:incoming>SequenceFlow_TwitterConnect</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TweetFriends</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Tweet Friends Task -->
    <bpmn:userTask id="UserTask_Tweet" name="Tweet to friends who might want to join">
      <bpmn:incoming>SequenceFlow_TweetFriends</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TwitterToConverge</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Payment Info Task -->
    <bpmn:userTask id="UserTask_Payment" name="Provide payment information">
      <bpmn:incoming>SequenceFlow_PaymentInfo</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PaymentToConverge</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Converging Parallel Gateway -->
    <bpmn:parallelGateway id="ParallelGateway_Converge" name="">
      <bpmn:incoming>SequenceFlow_TwitterToConverge</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_PaymentToConverge</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToIssueTicket</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Issue Ticket Service Task -->
    <bpmn:serviceTask id="ServiceTask_IssueTicket" name="System issues course ticket">
      <bpmn:incoming>SequenceFlow_ToIssueTicket</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TicketToEndEvent</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_1" name="Receive course ticket">
      <bpmn:incoming>SequenceFlow_TicketToEndEvent</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Cancelled Order End (for not eligible) -->
    <bpmn:endEvent id="EndEvent_2" name="Registration cancelled">
      <bpmn:incoming>SequenceFlow_NotEligibleEndProcess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToSelectCourse" sourceRef="StartEvent_1" targetRef="UserTask_SelectCourse1"/>
    <bpmn:sequenceFlow id="SequenceFlow_SelectToCheckSlots" name="" sourceRef="UserTask_SelectCourse1" targetRef="ExclusiveGateway_CheckSlots"/>
    <bpmn:sequenceFlow id="SequenceFlow_SlotsYesToShowCourses" name="yes" sourceRef="ExclusiveGateway_CheckSlots" targetRef="ServiceTask_ShowCourses"/>
    <bpmn:sequenceFlow id="SequenceFlow_CoursesToSelectSpecific" name="" sourceRef="ServiceTask_ShowCourses" targetRef="UserTask_SelectCourse2"/>
    <bpmn:sequenceFlow id="SequenceFlow_SpecificToCheckAccount" name="" sourceRef="UserTask_SelectCourse2" targetRef="ExclusiveGateway_CheckAccount"/>
    <bpmn:sequenceFlow id="SequenceFlow_AccountYesLogin" name="yes" sourceRef="ExclusiveGateway_CheckAccount" targetRef="UserTask_Login"/>
    <bpmn:sequenceFlow id="SequenceFlow_AccountNoCheckEligibility" name="no" sourceRef="ExclusiveGateway_CheckAccount" targetRef="UserTask_CheckUniversity"/>
    <bpmn:sequenceFlow id="SequenceFlow_EligibilityToGateway" name="" sourceRef="UserTask_CheckUniversity" targetRef="ExclusiveGateway_CheckEligibility"/>
    <bpmn:sequenceFlow id="SequenceFlow_EligibleYesRegisterAccount" name="yes" sourceRef="ExclusiveGateway_CheckEligibility" targetRef="UserTask_RegisterAccount"/>
    <bpmn:sequenceFlow id="SequenceFlow_NotEligibleRequestActivation" name="no" sourceRef="ExclusiveGateway_CheckEligibility" targetRef="UserTask_RequestActivation"/>
    <bpmn:sequenceFlow id="SequenceFlow_ActivationToWaitResponse" name="" sourceRef="UserTask_RequestActivation" targetRef="ServiceTask_WaitResponse"/>
    <bpmn:sequenceFlow id="SequenceFlow_ResponseReceivedToEligibilityCheck2" name="" sourceRef="ServiceTask_WaitResponse" targetRef="ExclusiveGateway_CheckEligibility2"/>
    <bpmn:sequenceFlow id="SequenceFlow_EligibleYesProceedLogin" name="yes" sourceRef="ExclusiveGateway_CheckEligibility2" targetRef="UserTask_Login"/>
    <bpmn:sequenceFlow id="SequenceFlow_NotEligibleEndProcess" name="no" sourceRef="ExclusiveGateway_CheckEligibility2" targetRef="EndEvent_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_AccountRegisteredToLoginCheck" name="" sourceRef="UserTask_RegisterAccount" targetRef="ExclusiveGateway_CheckAccount"/>
    <bpmn:sequenceFlow id="SequenceFlow_SlotsNoSelectAnother" name="no" sourceRef="ExclusiveGateway_CheckSlots" targetRef="UserTask_SelectCourse1"/>
    <bpmn:sequenceFlow id="SequenceFlow_LoggedInToParallelSplit" name="" sourceRef="UserTask_Login" targetRef="ParallelGateway_Split"/>
    <bpmn:sequenceFlow id="SequenceFlow_TwitterConnect" name="" sourceRef="ParallelGateway_Split" targetRef="UserTask_ConnectTwitter"/>
    <bpmn:sequenceFlow id="SequenceFlow_PaymentInfo" name="" sourceRef="ParallelGateway_Split" targetRef="UserTask_Payment"/>
    <bpmn:sequenceFlow id="SequenceFlow_TweetFriends" name="" sourceRef="UserTask_ConnectTwitter" targetRef="UserTask_Tweet"/>
    <bpmn:sequenceFlow id="SequenceFlow_TwitterToConverge" name="" sourceRef="UserTask_Tweet" targetRef="ParallelGateway_Converge"/>
    <bpmn:sequenceFlow id="SequenceFlow_PaymentToConverge" name="" sourceRef="UserTask_Payment" targetRef="ParallelGateway_Converge"/>
    <bpmn:sequenceFlow id="SequenceFlow_ToIssueTicket" name="" sourceRef="ParallelGateway_Converge" targetRef="ServiceTask_IssueTicket"/>
    <bpmn:sequenceFlow id="SequenceFlow_TicketToEndEvent" name="" sourceRef="ServiceTask_IssueTicket" targetRef="EndEvent_1"/>

  </bpmn:process>
</bpmn:definitions>