<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_BuildingHouse_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_BuildingTreehouse">
    <bpmn:participant id="Participant_Customer" name="Customer (You)" processRef="Process_CustomerExecution"/>
    <bpmn:participant id="Participant_Architect" name="Architect"/>
  </bpmn:collaboration>

  <bpmn:message id="Message_DraftPlan" name="Draft Plan"/>
  <bpmn:message id="Message_OrderConfirmation" name="Order Confirmation"/>
  <bpmn:message id="Message_InvitationRequest" name="Build Request"/>

  <bpmn:process id="Process_CustomerExecution" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_BuildHouse" name="Wish to build a house">
      <bpmn:outgoing>SequenceFlow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Collect Requirements Task -->
    <bpmn:userTask id="Task_CollectRequirements" name="Collect requirements">
      <bpmn:incoming>SequenceFlow_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_02</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Send Requirements Task -->
    <bpmn:userTask id="Task_SendRequirements" name="Send requirements to architect">
      <bpmn:incoming>SequenceFlow_02</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_03</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Intermediate Catch Event for Draft -->
    <bpmn:intermediateCatchEvent id="IntermediateCatch_DraftReceived" name="Draft received">
      <bpmn:incoming>SequenceFlow_04</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_05</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Refine Requirements Task -->
    <bpmn:userTask id="Task_RefineRequirements" name="Refine requirements">
      <bpmn:incoming>SequenceFlow_06</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_07</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Draft Sufficient Gateway -->
    <bpmn:exclusiveGateway id="Gateway_DraftSufficient" name="Draft sufficient?">
      <bpmn:incoming>SequenceFlow_05</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_08</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_06</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Create Materials List Task -->
    <bpmn:userTask id="Task_CreateMaterialsList" name="Create materials list">
      <bpmn:incoming>SequenceFlow_08</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_09</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Place Orders Task -->
    <bpmn:userTask id="Task_PlaceOrders" name="Place orders from online stores">
      <bpmn:incoming>SequenceFlow_09</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Intermediate Catch Event for Order -->
    <bpmn:intermediateCatchEvent id="IntermediateCatch_OrderReceived" name="Order received">
      <bpmn:incoming>SequenceFlow_12</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_13</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Call Friends Task -->
    <bpmn:userTask id="Task_CallFriends" name="Call friends to build house">
      <bpmn:incoming>SequenceFlow_10</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_14</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Intermediate Catch Event for Build Request -->
    <bpmn:intermediateCatchEvent id="IntermediateCatch_BuildRequestSent" name="Build request sent">
      <bpmn:incoming>SequenceFlow_15</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_16</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Send Party Invitations Task -->
    <bpmn:userTask id="Task_SendPartyInvitations" name="Send party invitations">
      <bpmn:incoming>SequenceFlow_16</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_17</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Create Guest List Task -->
    <bpmn:userTask id="Task_CreateGuestList" name="Create guest list">
      <bpmn:incoming>SequenceFlow_18</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_19</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_HouseFinished" name="House finished">
      <bpmn:incoming>SequenceFlow_20</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Parallel Gateway for splitting to orders and friends -->
    <bpmn:parallelGateway id="ParallelGateway_SplitOrdersFriends" name="">
      <bpmn:incoming>SequenceFlow_13</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_20</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_14</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_01" sourceRef="StartEvent_BuildHouse" targetRef="Task_CollectRequirements"/>
    <bpmn:sequenceFlow id="SequenceFlow_02" sourceRef="Task_CollectRequirements" targetRef="Task_SendRequirements"/>
    <bpmn:sequenceFlow id="SequenceFlow_03" name="" sourceRef="Task_SendRequirements" targetRef="IntermediateCatch_DraftReceived">
      <bpmn:messageEventDefinition messageRef="Message_DraftPlan"/>
    </bpmn:sequenceFlow>

    <!-- Message Flow to Architect -->
    <bpmn:messageFlow id="MessageFlow_01" sourceRef="Task_SendRequirements" targetRef="Participant_Architect">
      <bpmn:name>Send requirements</bpmn:name>
    </bpmn:messageFlow>

    <bpmn:sequenceFlow id="SequenceFlow_04" name="" sourceRef="IntermediateCatch_DraftReceived" targetRef="Gateway_DraftSufficient"/>
    
    <!-- Message Flow from Architect -->
    <bpmn:messageFlow id="MessageFlow_02" sourceRef="Participant_Architect" targetRef="Task_SendRequirements">
      <bpmn:name>Draft plan</bpmn:name>
    </bpmn:messageFlow>

    <bpmn:sequenceFlow id="SequenceFlow_05" name="" sourceRef="Gateway_DraftSufficient" targetRef="IntermediateCatch_DraftReceived"/>
    
    <!-- Loop back from Refine to Gateway -->
    <bpmn:sequenceFlow id="SequenceFlow_06" name="No - Refine" sourceRef="Task_RefineRequirements" targetRef="Gateway_DraftSufficient">
      <bpmn:name>No</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_07" name="" sourceRef="IntermediateCatch_DraftReceived" targetRef="Task_RefineRequirements"/>
    
    <!-- Yes - Sufficient path -->
    <bpmn:sequenceFlow id="SequenceFlow_08" name="Yes - Sufficient" sourceRef="Gateway_DraftSufficient" targetRef="Task_CreateMaterialsList">
      <bpmn:name>Yes</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Loop back from Refine to Gateway -->
    <bpmn:sequenceFlow id="SequenceFlow_09" name="" sourceRef="Task_RefineRequirements" targetRef="Gateway_DraftSufficient"/>

    <bpmn:sequenceFlow id="SequenceFlow_10" name="" sourceRef="Task_CreateMaterialsList" targetRef="Task_PlaceOrders"/>
    
    <!-- Message Flow to Online Stores -->
    <bpmn:messageFlow id="MessageFlow_03" sourceRef="Task_PlaceOrders" targetRef="Participant_Customer">
      <bpmn:name>Order placed</bpmn:name>
    </bpmn:messageFlow>

    <bpmn:sequenceFlow id="SequenceFlow_12" name="" sourceRef="Task_PlaceOrders" targetRef="IntermediateCatch_OrderReceived"/>
    
    <!-- Message Flow for Order Confirmation -->
    <bpmn:messageFlow id="MessageFlow_04" sourceRef="Participant_Customer" targetRef="Task_PlaceOrders">
      <bpmn:name>Order confirmation</bpmn:name>
    </bpmn:messageFlow>

    <bpmn:sequenceFlow id="SequenceFlow_13" name="" sourceRef="IntermediateCatch_OrderReceived" targetRef="ParallelGateway_SplitOrdersFriends"/>
    
    <!-- Parallel path to call friends -->
    <bpmn:sequenceFlow id="SequenceFlow_14" name="" sourceRef="Task_CallFriends" targetRef="IntermediateCatch_BuildRequestSent">
      <bpmn:messageEventDefinition messageRef="Message_InvitationRequest"/>
    </bpmn:sequenceFlow>

    <!-- Message Flow for invitations -->
    <bpmn:messageFlow id="MessageFlow_05" sourceRef="Task_CallFriends" targetRef="Participant_Customer">
      <bpmn:name>Build request sent</bpmn:name>
    </bpmn:messageFlow>

    <bpmn:sequenceFlow id="SequenceFlow_16" name="" sourceRef="IntermediateCatch_BuildRequestSent" targetRef="Task_SendPartyInvitations"/>
    
    <!-- Message Flow for invitations -->
    <bpmn:messageFlow id="MessageFlow_06" sourceRef="Task_SendPartyInvitations" targetRef="Participant_Customer">
      <bpmn:name>Send invitation</bpmn:name>
    </bpmn:messageFlow>

    <bpmn:sequenceFlow id="SequenceFlow_17" name="" sourceRef="Task_SendPartyInvitations" targetRef="Task_CreateGuestList"/>
    
    <!-- Message Flow for invitations -->
    <bpmn:messageFlow id="MessageFlow_07" sourceRef="Task_CallFriends" targetRef="Participant_Customer">
      <bpmn:name>Build request sent</bpmn:name>
    </bpmn:messageFlow>

    <bpmn:sequenceFlow id="SequenceFlow_18" name="" sourceRef="Task_CreateGuestList" targetRef="EndEvent_HouseFinished"/>
    
    <!-- Parallel path to end -->
    <bpmn:sequenceFlow id="SequenceFlow_20" name="" sourceRef="ParallelGateway_SplitOrdersFriends" targetRef="EndEvent_HouseFinished"/>

  </bpmn:process>

</bpmn:definitions>