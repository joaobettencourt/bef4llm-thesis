<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_BecomingAParent_1">
  <bpmn:collaboration>
    <bpmn:participant id="Participant_ParentLeaveProcess" name="Parent Leave Management Service" processRef="Process_ProcessExecution"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_ProcessExecution" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Request Maternity Leave">
      <bpmn:outgoing>SequenceFlow_FetchInfo</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Fetch Information about potential models -->
    <bpmn:userTask id="UserTask_1" name="Fetch information on leave models">
      <bpmn:description>Potential months duration, split between parents</bpmn:description>
      <bpmn:incoming>SequenceFlow_FetchInfo</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SelectModel</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task 2: Let parent select -->
    <bpmn:userTask id="UserTask_2" name="Select leave model">
      <bpmn:description>Select duration and split between parents</bpmn:description>
      <bpmn:incoming>SequenceFlow_SelectModel</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CollectInfo</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task 3: Collect relevant information -->
    <bpmn:userTask id="UserTask_3" name="Collect relevant personal info">
      <bpmn:incoming>SequenceFlow_CollectInfo</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NotifyParties</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway 1: Notify Social Security & Company in time -->
    <bpmn:parallelGateway id="ParallelGateway_1" name="Notify Parties">
      <bpmn:incoming>SequenceFlow_NotifyParties</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NotifSS</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NotifCompany</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 4a: Notify Social Security -->
    <bpmn:userTask id="UserTask_4" name="Notify Social Security">
      <bpmn:description>In time before leave starts</bpmn:description>
      <bpmn:incoming>SequenceFlow_NotifSS</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Converge1</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task 4b: Notify Company -->
    <bpmn:userTask id="UserTask_5" name="Notify Employer">
      <bpmn:description>In time before leave starts</bpmn:description>
      <bpmn:incoming>SequenceFlow_NotifCompany</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Converge1</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway 2: Converge notifications -->
    <bpmn:parallelGateway id="ParallelGateway_2" name="">
      <bpmn:incoming>SequenceFlow_Converge1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GatherInfo</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 5: Gather information from companies -->
    <bpmn:userTask id="UserTask_6" name="Gather info from employers">
      <bpmn:description>Verify employment and leave eligibility</bpmn:description>
      <bpmn:incoming>SequenceFlow_GatherInfo</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StartLeave</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task 6: Take Maternity Leave -->
    <bpmn:manualTask id="UserTask_7" name="Take maternity leave">
      <bpmn:description>Duration as selected in model</bpmn:description>
      <bpmn:incoming>SequenceFlow_StartLeave</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DecideExtension</bpmn:outgoing>
    </bpmn:manualTask>

    <!-- Gateway 3: Decision on extension -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_1" name="Extend leave?">
      <bpmn:incoming>SequenceFlow_DecideExtension</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_YesExtend</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoEnd</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 7a: Extend Leave -->
    <bpmn:userTask id="UserTask_8" name="Process extension request">
      <bpmn:description>New notification and approval required</bpmn:description>
      <bpmn:incoming>SequenceFlow_YesExtend</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndExtension</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event 1 -->
    <bpmn:endEvent id="EndEvent_1" name="Leave Extended">
      <bpmn:incoming>SequenceFlow_EndExtension</bpmn:incoming>
    </bpmn:endEvent>

    <!-- End Event 2 -->
    <bpmn:endEvent id="EndEvent_2" name="Process Completed">
      <bpmn:incoming>SequenceFlow_NoEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_FetchInfo" sourceRef="StartEvent_1" targetRef="UserTask_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_SelectModel" name="" sourceRef="UserTask_1" targetRef="UserTask_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_CollectInfo" sourceRef="UserTask_2" targetRef="UserTask_3"/>
    <bpmn:sequenceFlow id="SequenceFlow_NotifyParties" name="" sourceRef="UserTask_3" targetRef="ParallelGateway_1"/>
    
    <!-- Parallel Gateway 1 Outgoing Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_NotifSS" name="" sourceRef="ParallelGateway_1" targetRef="UserTask_4"/>
    <bpmn:sequenceFlow id="SequenceFlow_NotifCompany" name="" sourceRef="ParallelGateway_1" targetRef="UserTask_5"/>

    <!-- Parallel Gateway 2 -->
    <bpmn:sequenceFlow id="SequenceFlow_Converge1" name="" sourceRef="UserTask_4" targetRef="ParallelGateway_2">
      <bpmn:sourceRef>UserTask_4</bpmn:sourceRef>
      <bpmn:targetRef>ParallelGateway_2</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Fix Converge flow from UserTask 5 -->
    <bpmn:sequenceFlow id="SequenceFlow_Converge1_UserTask5" name="" sourceRef="UserTask_5" targetRef="ParallelGateway_2"/>

    <bpmn:sequenceFlow id="SequenceFlow_GatherInfo" name="" sourceRef="ParallelGateway_2" targetRef="UserTask_6"/>
    
    <!-- Continue flow -->
    <bpmn:sequenceFlow id="SequenceFlow_StartLeave" name="" sourceRef="UserTask_6" targetRef="UserTask_7"/>
    <bpmn:sequenceFlow id="SequenceFlow_DecideExtension" name="" sourceRef="UserTask_7" targetRef="ExclusiveGateway_1"/>

    <!-- Extension Decision Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_YesExtend" name="yes" sourceRef="ExclusiveGateway_1" targetRef="UserTask_8"/>
    <bpmn:sequenceFlow id="SequenceFlow_NoEnd" name="no" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_2"/>

    <!-- Extension Process Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_EndExtension" name="" sourceRef="UserTask_8" targetRef="EndEvent_1"/>

  </bpmn:process>
</bpmn:definitions>