<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_InspectionMachine" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_MachineInspection" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_InspReady" name="Inspection Ready">
      <bpmn:outgoing>SequenceFlow_EnterDetails</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task to enter machine details as per description -->
    <bpmn:userTask id="UserTask_EnterDetails" name="Enter Machine Details (Type &amp; Serial Number)">
      <bpmn:incoming>SequenceFlow_EnterDetails</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StartInspectionLoop</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task 1: Ask Questions / Input Values -->
    <bpmn:userTask id="UserTask_AskQuestions" name="Ask Questions &amp; Input Values">
      <bpmn:incoming>SequenceFlow_LoopBack</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CollectData</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task 2: Collect Data / Show Results (Automatic) -->
    <bpmn:serviceTask id="ServiceTask_CollectData" name="Collect Machine Values &amp; Display">
      <bpmn:incoming>SequenceFlow_CollectData</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckResults</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Gateway for Conditional Logic -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_MoreQuestions" name="Additional questions required?">
      <bpmn:incoming>SequenceFlow_CheckResults</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_LoopBack</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_EndInspection</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Completed" name="Inspection Completed">
      <bpmn:incoming>SequenceFlow_EndInspection</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    
    <!-- From Start to Enter Details -->
    <bpmn:sequenceFlow id="SequenceFlow_EnterDetails" sourceRef="StartEvent_InspReady" targetRef="UserTask_EnterDetails"/>

    <!-- From Enter Details to Loop Start (First Inspection Step) -->
    <bpmn:sequenceFlow id="SequenceFlow_StartInspectionLoop" sourceRef="UserTask_EnterDetails" targetRef="UserTask_AskQuestions"/>

    <!-- From Ask Questions to Collect Data -->
    <bpmn:sequenceFlow id="SequenceFlow_CollectData" sourceRef="UserTask_AskQuestions" targetRef="ServiceTask_CollectData"/>

    <!-- From Collect Data to Gateway (Check Results) -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckResults" sourceRef="ServiceTask_CollectData" targetRef="ExclusiveGateway_MoreQuestions"/>

    <!-- Loop Back Path (Yes - More Questions) -->
    <bpmn:sequenceFlow id="SequenceFlow_LoopBack" sourceRef="ExclusiveGateway_MoreQuestions" targetRef="UserTask_AskQuestions"/>

    <!-- Exit Path (No - Inspection Done) -->
    <bpmn:sequenceFlow id="SequenceFlow_EndInspection" sourceRef="ExclusiveGateway_MoreQuestions" targetRef="EndEvent_Completed"/>

  </bpmn:process>
</bpmn:definitions>