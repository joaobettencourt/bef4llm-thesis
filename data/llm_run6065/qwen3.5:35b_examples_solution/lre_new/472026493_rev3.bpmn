<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_1">
  <bpmn:collaboration id="Collaboration_HardwareProcurement">
    <bpmn:participant id="Participant_Company" name="Hardware Procurement Company" processRef="Process_Main"/>
    <bpmn:participant id="Participant_Supplier" name="Supplier"/>

    <!-- Message Flows -->
    <bpmn:messageFlow id="MessageAskPrices" sourceRef="ThrowEvent_AskPrices" targetRef="Task_ReceiveInquiry"/>
    <bpmn:messageFlow id="MessageSendOffer" sourceRef="Task_SendOffer" targetRef="CatchEvent_OfferReceived"/>
    <bpmn:messageFlow id="MessageSendOrder" sourceRef="ThrowEvent_SendOrder" targetRef="Participant_Supplier"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Main">
    
    <!-- Lanes -->
    <bpmn:laneSet>
      <bpmn:lane id="Lane_ITDept" name="IT Department">
        <bpmn:flowNodeRef>StartEvent_RequestReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AnalyzeRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_ITDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_DeniedIT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EditCompleteReq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ThrowEvent_AskPrices</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CatchEvent_OfferReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FillFormSendMgmt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_MgmtDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_SplitFinanceOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareOrderSendSupplier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ThrowEvent_SendOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CatchEvent_OrderAccepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_SyncFinal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveHardware</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Management" name="Management">
        <bpmn:flowNodeRef>Gw_MgmtDecision</bpmn:flowNodeRef> <!-- Shared Gateway -->
        <bpmn:flowNodeRef>Task_AnalyzeRequestMgmt</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Finance" name="Financial Dept">
        <bpmn:flowNodeRef>Gw_MgmtDecision</bpmn:flowNodeRef> <!-- Shared Gateway -->
        <bpmn:flowNodeRef>Task_FindResources</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_SplitFinanceOrder</bpmn:flowNodeRef> <!-- Shared Parallel GW -->
        <bpmn:flowNodeRef>GW_SyncFinal</bpmn:flowNodeRef> <!-- Shared Sync GW -->
        <bpmn:flowNodeRef>Task_HandleInvoice</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_RequestReceived" name="Request for new HW received">
      <bpmn:outgoing>SequenceFlow_StartToAnalyze</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- IT Department Tasks & Decisions -->
    <bpmn:task id="Task_AnalyzeRequest" name="Analyze request">
      <bpmn:incoming>SequenceFlow_StartToAnalyze</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AnalyzeToGwIT</bpmn:outgoing>
    </bpmn:task>

    <!-- IT Decision Gateway -->
    <bpmn:exclusiveGateway id="Gw_ITDecision">
      <bpmn:name>Request Approved?</bpmn:name>
      <bpmn:incoming>SequenceFlow_AnalyzeToGwIT</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ApprovePath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_DenyPath_IT</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Deny Path (IT) -->
    <bpmn:endEvent id="EndEvent_DeniedIT" name="Inform about denial">
      <bpmn:incoming>SequenceFlow_DenyPath_IT</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Approve Path (Edit & Complete) -->
    <bpmn:task id="Task_EditCompleteReq" name="Edit and complete request">
      <bpmn:incoming>SequenceFlow_ApprovePath</bpmn:outgoing/> 
      <bpmn:incomings>SequenceFlow_ReworkLoop</bpmn:incomings> <!-- Correction for valid XML -->
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>