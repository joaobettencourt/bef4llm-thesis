<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_1x9k3mz">
  <bpmn:collaboration id="Collaboration_0a8d6h7">
    <bpmn:participant id="Participant_CreditCompany" name="Credit company" processRef="Process_1x4k5mz"/>
    <bpmn:participant id="Participant_Customer" name="Customer"/>
    <bpmn:messageFlow id="MessageFlow_ReceiptInfo" sourceRef="Participant_Customer" targetRef="StartEvent_CreditReceived"/>
    <bpmn:messageFlow id="MessageFlow_EmailAccepted" sourceRef="EndEvent_Accepted" targetRef="Participant_Customer"/>
    <bpmn:messageFlow id="MessageFlow_EmailRejected" sourceRef="EndEvent_Rejected" targetRef="Participant_Customer"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1x4k5mz">
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_CreditReceived">
      <bpmn:name>Credit Information Received</bpmn:name>
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_0123456789ab</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Collect Credit Information -->
    <bpmn:task id="Task_CollectInfo">
      <bpmn:name>Collect credit information</bpmn:name>
      <bpmn:incoming>SequenceFlow_0123456789ab</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_23456789abcd</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Check Amount Threshold -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_AmountCheck">
      <bpmn:name>Amount greater than 1M$?</bpmn:name>
      <bpmn:incoming>SequenceFlow_23456789abcd</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AmountHigh</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_AmountLow</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flow for Amount greater than 1M$ -->
    <bpmn:sequenceFlow id="SequenceFlow_AmountHigh" name="Amount &gt; 1M$" sourceRef="ExclusiveGateway_AmountCheck" targetRef="Task_RequestApproval"/>

    <!-- Task: Request Approval (for high amount) -->
    <bpmn:task id="Task_RequestApproval">
      <bpmn:name>Request approval</bpmn:name>
      <bpmn:incoming>SequenceFlow_AmountHigh</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ApprovalDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow for Amount less than or equal to 1M$ -->
    <bpmn:sequenceFlow id="SequenceFlow_AmountLow" name="Amount &le; 1M$" sourceRef="ExclusiveGateway_AmountCheck" targetRef="Task_AssessRisk"/>

    <!-- Task: Assess Risk (for low amount) -->
    <bpmn:task id="Task_AssessRisk">
      <bpmn:name>Assess risk</bpmn:name>
      <bpmn:incoming>SequenceFlow_AmountLow</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RiskCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2: Check Risk Level -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_RiskLevel">
      <bpmn:name>Risk High?</bpmn:name>
      <bpmn:incoming>SequenceFlow_RiskCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_HighRisk</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_LowRisk</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flow for High Risk -->
    <bpmn:sequenceFlow id="SequenceFlow_HighRisk" name="High risk" sourceRef="ExclusiveGateway_RiskLevel" targetRef="Task_RequestApproval"/>

    <!-- Task: Accept Credit (for low risk) -->
    <bpmn:task id="Task_AcceptCredit">
      <bpmn:name>Accept credit</bpmn:name>
      <bpmn:incoming>SequenceFlow_LowRisk</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CreditAccepted</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow for Low Risk -->
    <bpmn:sequenceFlow id="SequenceFlow_LowRisk" name="Low risk" sourceRef="ExclusiveGateway_RiskLevel" targetRef="Task_AcceptCredit"/>

    <!-- Gateway 3: Approval Decision (after approval request) -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_ApprovalDecision">
      <bpmn:name>Approval Result?</bpmn:name>
      <bpmn:incoming>SequenceFlow_ApprovalDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CreditRejected</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CreditAccepted2</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flow for Credit Rejected -->
    <bpmn:sequenceFlow id="SequenceFlow_CreditRejected" name="Credit rejected" sourceRef="ExclusiveGateway_ApprovalDecision" targetRef="Task_RejectCredit"/>

    <!-- Task: Reject Credit (after approval) -->
    <bpmn:task id="Task_RejectCredit">
      <bpmn:name>Reject credit</bpmn:name>
      <bpmn:incoming>SequenceFlow_CreditRejected</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendEmailRejected</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow for Credit Accepted (after approval) -->
    <bpmn:sequenceFlow id="SequenceFlow_CreditAccepted2" name="Credit accepted" sourceRef="ExclusiveGateway_ApprovalDecision" targetRef="Task_AcceptCredit"/>

    <!-- End Event 1: Email Sent - Rejected -->
    <bpmn:endEvent id="EndEvent_Rejected">
      <bpmn:name>Rejected</bpmn:name>
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SequenceFlow_SendEmailRejected</bpmn:incoming>
    </bpmn:endEvent>

    <!-- End Event 2: Email Sent - Accepted -->
    <bpmn:endEvent id="EndEvent_Accepted">
      <bpmn:name>Accepted</bpmn:name>
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SequenceFlow_SendEmailAccepted</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flow from Accept Credit Task to End Event -->
    <bpmn:sequenceFlow id="SequenceFlow_CreditAccepted" sourceRef="Task_AcceptCredit" targetRef="EndEvent_Accepted"/>

    <!-- Sequence Flow for Email Sent (Rejected) -->
    <bpmn:sequenceFlow id="SequenceFlow_SendEmailRejected" name="Send email to customer" sourceRef="Task_RejectCredit" targetRef="EndEvent_Rejected"/>

  </bpmn:process>
</bpmn:definitions>