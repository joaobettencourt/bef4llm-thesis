<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1a8d6h7">
    <bpmn:participant id="Participant_SSP" name="SSP Mail Centre" processRef="Process_InvoiceProcessing"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_InvoiceProcessing">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_MailCentre" name="Mail Centre Office">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CategorizeInvoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateCatch_HourlyReview</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_AdminDept" name="Administration Department">
        <bpmn:flowNodeRef>Task_ProcessInvoiceComplex</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateCatch_InvoiceReceived</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_DataEntry" name="Data Entry Office">
        <bpmn:flowNodeRef>Task_EnterSAPDataComplex</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateCatch_Daily10AM</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_ValidationOffice" name="Validation Office">
        <bpmn:flowNodeRef>Task_ValidateInvoiceComplex</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_PaymentOffice" name="Payment Office">
        <bpmn:flowNodeRef>IntermediateCatch_WeeklyBeginning</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProcessPaymentComplex</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_RegistryOffice" name="Registry Office">
        <bpmn:flowNodeRef>Task_ArchiveInvoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Completed</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_CollectionBox" name="Collection Box">
        <bpmn:flowNodeRef>Task_PutInCollectionBox</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Invoice Received from Client">
      <bpmn:outgoing>SequenceFlow_StartToCategorize</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>

    <!-- Mail Centre Tasks -->
    <bpmn:task id="Task_CategorizeInvoice" name="Categorize Invoice by Staff Member">
      <bpmn:incoming>SequenceFlow_StartToCategorize</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CategorizeToForward</bpmn:outgoing>
    </bpmn:task>

    <!-- Administration Department Tasks -->
    <bpmn:intermediateCatchEvent id="IntermediateCatch_InvoiceReceived" name="Invoice Received">
      <bpmn:incoming>SequenceFlow_ForwardToAdmin</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AdminStartProcess</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:subProcess id="Task_ProcessInvoiceComplex" name="Process Invoice (Complex)">
      <bpmn:incoming>SequenceFlow_AdminStartProcess</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ComplexToCollectionBox</bpmn:outgoing>
    </bpmn:subProcess>

    <!-- Collection Box Task -->
    <bpmn:task id="Task_PutInCollectionBox" name="Put Invoices in Collection Box">
      <bpmn:incoming>SequenceFlow_ComplexToCollectionBox</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CollectionToDataEntry</bpmn:outgoing>
    </bpmn:task>

    <!-- Data Entry Office Tasks -->
    <bpmn:intermediateCatchEvent id="IntermediateCatch_Daily10AM" name="At 10 AM Every Workday">
      <bpmn:incoming>SequenceFlow_CollectionToDataEntry</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DataEntryStartProcess</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:subProcess id="Task_EnterSAPDataComplex" name="Enter Data in SAP (Complex)">
      <bpmn:incoming>SequenceFlow_DataEntryStartProcess</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SAPToHourlyReview</bpmn:outgoing>
    </bpmn:subProcess>

    <!-- Hourly Review Timer -->
    <bpmn:intermediateCatchEvent id="IntermediateCatch_HourlyReview" name="Every 1 Hour">
      <bpmn:incoming>SequenceFlow_SAPToHourlyReview</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReviewForwardValidation</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Validation Office Tasks -->
    <bpmn:subProcess id="Task_ValidateInvoiceComplex" name="Validate Invoice (Big Process)">
      <bpmn:incoming>SequenceFlow_ReviewForwardValidation</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ValidToWeeklyPayment</bpmn:outgoing>
    </bpmn:subProcess>

    <!-- Weekly Payment Timer -->
    <bpmn:intermediateCatchEvent id="IntermediateCatch_WeeklyBeginning" name="Beginning of Every Week">
      <bpmn:incoming>SequenceFlow_ValidToWeeklyPayment</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PaymentStartProcess</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Payment Office Tasks -->
    <bpmn:subProcess id="Task_ProcessPaymentComplex" name="Execute Payment (Big Process)">
      <bpmn:incoming>SequenceFlow_PaymentStartProcess</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PaymentToArchive</bpmn:outgoing>
    </bpmn:subProcess>

    <!-- Registry Office Tasks -->
    <bpmn:task id="Task_ArchiveInvoice" name="Archive Invoice">
      <bpmn:incoming>SequenceFlow_PaymentToArchive</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ArchiveToEnd</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Completed" name="Invoice Process Completed">
      <bpmn:incoming>SequenceFlow_ArchiveToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToCategorize" sourceRef="StartEvent_1" targetRef="Task_CategorizeInvoice"/>
    <bpmn:sequenceFlow id="SequenceFlow_CategorizeToForward" sourceRef="Task_CategorizeInvoice" targetRef="IntermediateCatch_InvoiceReceived"/>
    <bpmn:sequenceFlow id="SequenceFlow_ForwardToAdmin" name="Forward to Admin Department" sourceRef="Task_CategorizeInvoice" targetRef="IntermediateCatch_InvoiceReceived"/>
    <bpmn:sequenceFlow id="SequenceFlow_AdminStartProcess" sourceRef="IntermediateCatch_InvoiceReceived" targetRef="Task_ProcessInvoiceComplex"/>
    <bpmn:sequenceFlow id="SequenceFlow_ComplexToCollectionBox" name="After Processing" sourceRef="Task_ProcessInvoiceComplex" targetRef="Task_PutInCollectionBox"/>
    <bpmn:sequenceFlow id="SequenceFlow_CollectionToDataEntry" sourceRef="Task_PutInCollectionBox" targetRef="IntermediateCatch_Daily10AM"/>
    <bpmn:sequenceFlow id="SequenceFlow_DataEntryStartProcess" sourceRef="IntermediateCatch_Daily10AM" targetRef="Task_EnterSAPDataComplex"/>
    <bpmn:sequenceFlow id="SequenceFlow_SAPToHourlyReview" name="After SAP Entry" sourceRef="Task_EnterSAPDataComplex" targetRef="IntermediateCatch_HourlyReview"/>
    <bpmn:sequenceFlow id="SequenceFlow_ReviewForwardValidation" name="Every Hour Review" sourceRef="IntermediateCatch_HourlyReview" targetRef="Task_ValidateInvoiceComplex"/>
    <bpmn:sequenceFlow id="SequenceFlow_ValidToWeeklyPayment" sourceRef="Task_ValidateInvoiceComplex" targetRef="IntermediateCatch_WeeklyBeginning"/>
    <bpmn:sequenceFlow id="SequenceFlow_PaymentStartProcess" name="Every Week Start" sourceRef="IntermediateCatch_WeeklyBeginning" targetRef="Task_ProcessPaymentComplex"/>
    <bpmn:sequenceFlow id="SequenceFlow_PaymentToArchive" sourceRef="Task_ProcessPaymentComplex" targetRef="Task_ArchiveInvoice"/>
    <bpmn:sequenceFlow id="SequenceFlow_ArchiveToEnd" name="After Payment" sourceRef="Task_ArchiveInvoice" targetRef="EndEvent_Completed"/>

  </bpmn:process>
</bpmn:definitions>