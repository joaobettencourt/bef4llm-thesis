<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_1x9k3mz" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_0a8d6h7">
    <bpmn:participant id="Participant_1q2jv9p" name="Add customer feedback module to the website" processRef="Process_1x4k5mz" />
  </bpmn:collaboration>

  <bpmn:process id="Process_1x4k5mz">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_BusinessAnalyst" name="Business Analyst">
        <bpmn:flowNodeRef>StartEvent_OrderReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CollectDataAnalysis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CatchEvent_DesignComplete</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_WebDesigner" name="Web Designer">
        <bpmn:flowNodeRef>Task_IntegrateDesignModulePlacement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ChangeDesign</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_PHPHTMLCSS" name="PHP/HTML/CSS Specialist">
        <bpmn:flowNodeRef>Task_IntegrateOverallImplementation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AdjustAccordingToTestResults</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Tester" name="Tester">
        <bpmn:flowNodeRef>Task_TestFinalWebsite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DesignOK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_TestResultsOK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProvideTestResults</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_OrderReceived">
      <bpmn:name>Order Received</bpmn:name>
      <bpmn:outgoing>SequenceFlow_0123456789ab</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Business Analyst Tasks -->
    <bpmn:task id="Task_CollectDataAnalysis">
      <bpmn:name>Collect data and conduct business analysis regarding customer feedback</bpmn:name>
      <bpmn:incoming>SequenceFlow_0123456789ab</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_23456789abcd</bpmn:outgoing>
    </bpmn:task>

    <!-- Web Designer Task -->
    <bpmn:task id="Task_IntegrateDesignModulePlacement">
      <bpmn:name>Integrate design and decide where customer feedback module should be placed</bpmn:name>
      <bpmn:incoming>SequenceFlow_23456789abcd</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_0hspd4v</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0anbprw</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Catch Event for waiting -->
    <bpmn:intermediateCatchEvent id="CatchEvent_DesignComplete">
      <bpmn:name>Design complete</bpmn:name>
      <bpmn:messageEventDefinition />
      <bpmn:incoming>SequenceFlow_0anbprw</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_v7g9ce</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Business Analyst Feedback Task -->
    <bpmn:task id="Task_ProvideFeedback">
      <bpmn:name>Check design and provide feedback</bpmn:name>
      <bpmn:incoming>SequenceFlow_v7g9ce</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0t0dbgx</bpmn:outgoing>
    </bpmn:task>

    <!-- Design OK Gateway -->
    <bpmn:exclusiveGateway id="Gateway_DesignOK">
      <bpmn:name>Design OK?</bpmn:name>
      <bpmn:incoming>SequenceFlow_0t0dbgx</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1cnd77d</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_05mk4m5</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Web Designer Change Design Task -->
    <bpmn:task id="Task_ChangeDesign">
      <bpmn:name>Change design</bpmn:name>
      <bpmn:incoming>SequenceFlow_05mk4m5</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0hspd4v</bpmn:outgoing>
    </bpmn:task>

    <!-- PHP/HTML/CSS Specialist Integration Task -->
    <bpmn:task id="Task_IntegrateOverallImplementation">
      <bpmn:name>Integrate with the overall implementation</bpmn:name>
      <bpmn:incoming>SequenceFlow_1cnd77d</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_0bqorpx</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0cbjta7</bpmn:outgoing>
    </bpmn:task>

    <!-- Tester Task -->
    <bpmn:task id="Task_TestFinalWebsite">
      <bpmn:name>Test the final website to make sure everything is going well</bpmn:name>
      <bpmn:incoming>SequenceFlow_0cbjta7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1tbmwte</bpmn:outgoing>
    </bpmn:task>

    <!-- Test Results OK Gateway -->
    <bpmn:exclusiveGateway id="Gateway_TestResultsOK">
      <bpmn:name>Test results OK?</bpmn:name>
      <bpmn:incoming>SequenceFlow_1tbmwte</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1q0hzge</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_1npk4me</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_ProcessComplete">
      <bpmn:name>Process Complete</bpmn:name>
      <bpmn:incoming>SequenceFlow_1q0hzge</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Tester Provide Results Task -->
    <bpmn:task id="Task_ProvideTestResults">
      <bpmn:name>Provide test results</bpmn:name>
      <bpmn:incoming>SequenceFlow_1npk4me</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0gxv78c</bpmn:outgoing>
    </bpmn:task>

    <!-- Specialist Adjustment Task -->
    <bpmn:task id="Task_AdjustAccordingToTestResults">
      <bpmn:name>Adjust according to test results</bpmn:name>
      <bpmn:incoming>SequenceFlow_0gxv78c</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0bqorpx</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_0123456789ab" sourceRef="StartEvent_OrderReceived" targetRef="Task_CollectDataAnalysis">
      <bpmn:name>Order Received</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_23456789abcd" sourceRef="Task_CollectDataAnalysis" targetRef="Task_IntegrateDesignModulePlacement">
      <bpmn:name>Data Analysis Complete</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_0anbprw" sourceRef="Task_IntegrateDesignModulePlacement" targetRef="CatchEvent_DesignComplete">
      <bpmn:name>Design Ready</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_v7g9ce" sourceRef="CatchEvent_DesignComplete" targetRef="Task_ProvideFeedback">
      <bpmn:name>Wait for Design Complete</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_0t0dbgx" sourceRef="Task_ProvideFeedback" targetRef="Gateway_DesignOK">
      <bpmn:name>Provide Feedback</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_1cnd77d" name="Design OK" sourceRef="Gateway_DesignOK" targetRef="Task_IntegrateOverallImplementation">
      <bpmn:text>Yes</bpmn:text>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_05mk4m5" name="Need adjustments" sourceRef="Gateway_DesignOK" targetRef="Task_ChangeDesign">
      <bpmn:text>No</bpmn:text>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_0hspd4v" sourceRef="Task_ChangeDesign" targetRef="Task_IntegrateDesignModulePlacement">
      <bpmn:name>Re-integrate Design</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_0cbjta7" sourceRef="Task_IntegrateOverallImplementation" targetRef="Task_TestFinalWebsite">
      <bpmn:name>Integration Complete</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_1tbmwte" sourceRef="Task_TestFinalWebsite" targetRef="Gateway_TestResultsOK">
      <bpmn:name>Testing Complete</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_1q0hzge" name="Test OK" sourceRef="Gateway_TestResultsOK" targetRef="EndEvent_ProcessComplete">
      <bpmn:text>Yes</bpmn:text>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_1npk4me" name="Not OK" sourceRef="Gateway_TestResultsOK" targetRef="Task_ProvideTestResults">
      <bpmn:text>No</bpmn:text>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_0gxv78c" sourceRef="Task_ProvideTestResults" targetRef="Task_AdjustAccordingToTestResults">
      <bpmn:name>Provide Results</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_0bqorpx" sourceRef="Task_AdjustAccordingToTestResults" targetRef="Task_IntegrateOverallImplementation">
      <bpmn:name>Re-integrate</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>