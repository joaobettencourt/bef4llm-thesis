<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_RoboticBurgerSeller" targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:collaboration id="Collab_BurgerRobotProcess">
    <bpmn:participant name="Robotic Burger Seller Process" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    
    <!-- Lane Set for Organization -->
    <bpmn:laneSet id="Lane_Set_Processing">
      <bpmn:lane id="Lane_CustomerService" name="Customer Service Robot">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MenuChoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepDrink</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_FriesOrWedges</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareFries</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareWedges</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_BurgerPrepStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepBurger</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Delivery</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Order Received">
      <bpmn:outgoing>SequenceFlow_Start_Gateway</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Exclusive Gateway - Menu Choice Decision -->
    <bpmn:exclusiveGateway id="Gateway_MenuChoice" name="Menu or Just Burger?">
      <bpmn:incoming>SequenceFlow_Start_Gateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Yes_Menu</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_No_BurgerOnly</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task - Prepare Drink (for menu) -->
    <bpmn:task id="Task_PrepDrink" name="Prepare Drink">
      <bpmn:incoming>SequenceFlow_Yes_Menu</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Drink_GatewayFries</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway - Fries or Wedges Decision -->
    <bpmn:exclusiveGateway id="Gateway_FriesOrWedges" name="Fries or Wedges?">
      <bpmn:incoming>SequenceFlow_Drink_GatewayFries</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Yes_Fries</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_No_Wedges</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task - Prepare Fries -->
    <bpmn:task id="Task_PrepareFries" name="Prepare Fries">
      <bpmn:incoming>SequenceFlow_Yes_Fries</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Fries_GatewayBurger</bpmn:outgoing>
    </bpmn:task>

    <!-- Task - Prepare Wedges -->
    <bpmn:task id="Task_PrepareWedges" name="Prepare Wedges">
      <bpmn:incoming>SequenceFlow_No_Wedges</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Wedges_GatewayBurger</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway - Burger Preparation Start -->
    <bpmn:parallelGateway id="Gw_BurgerPrepStart" name="Prepare Burger">
      <bpmn:incoming>SequenceFlow_No_BurgerOnly</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_Fries_GatewayBurger</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_Wedges_GatewayBurger</bpmn:incoming>
    </bpmn:parallelGateway>

    <!-- Task - Prepare Burger -->
    <bpmn:task id="Task_PrepBurger" name="Prepare Burger">
      <bpmn:incoming>Gw_BurgerPrepStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Burger_Conveyor</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Timer Event - Status Update Every 30 Seconds -->
    <bpmn:startEvent id="StartTimer_1" name="Status Update">
      <bpmn:timerDuration>P30S</bpmn:timerDuration>
      <bpmn:outgoing>SequenceFlow_Timer_StatusUpdate</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task - Status Update -->
    <bpmn:task id="Task_StatusUpdate" name="Enthusiastic Status Update">
      <bpmn:incoming>SequenceFlow_Timer_StatusUpdate</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Update_BurgerPrepLoop</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway - Burger Preparation Complete -->
    <bpmn:exclusiveGateway id="Gw_BurgerComplete" name="Burger Ready?">
      <bpmn:incoming>SequenceFlow_Update_BurgerPrepLoop</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Yes_Delivery</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event - Delivery via Conveyor Belt -->
    <bpmn:endEvent id="EndEvent_Delivery" name="Order Delivered">
      <bpmn:incoming>SequenceFlow_Yes_Delivery</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    
    <!-- Start to Menu Choice Gateway -->
    <bpmn:sequenceFlow id="SequenceFlow_Start_Gateway" name="Order Received">
      <bpmn:sourceRef>StartEvent_1</bpmn:sourceRef>
      <bpmn:targetRef>Gateway_MenuChoice</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Menu Choice - Yes (Menu) -->
    <bpmn:sequenceFlow id="SequenceFlow_Yes_Menu" name="Want Menu">
      <bpmn:sourceRef>Gateway_MenuChoice</bpmn:sourceRef>
      <bpmn:targetRef>Task_PrepDrink</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Menu Choice - No (Just Burger) -->
    <bpmn:sequenceFlow id="SequenceFlow_No_BurgerOnly" name="Just Burger">
      <bpmn:sourceRef>Gateway_MenuChoice</bpmn:sourceRef>
      <bpmn:targetRef>Gw_BurgerPrepStart</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Drink Preparation to Fries/Wedges Decision -->
    <bpmn:sequenceFlow id="SequenceFlow_Drink_GatewayFries" name="Drink Ready">
      <bpmn:sourceRef>Task_PrepDrink</bpmn:sourceRef>
      <bpmn:targetRef>Gateway_FriesOrWedges</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Fries/Wedges Decision - Yes (Fries) -->
    <bpmn:sequenceFlow id="SequenceFlow_Yes_Fries" name="Want Fries">
      <bpmn:sourceRef>Gateway_FriesOrWedges</bpmn:sourceRef>
      <bpmn:targetRef>Task_PrepareFries</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Fries/Wedges Decision - No (Wedges) -->
    <bpmn:sequenceFlow id="SequenceFlow_No_Wedges" name="Want Wedges">
      <bpmn:sourceRef>Gateway_FriesOrWedges</bpmn:sourceRef>
      <bpmn:targetRef>Task_PrepareWedges</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Fries Preparation to Burger Prep -->
    <bpmn:sequenceFlow id="SequenceFlow_Fries_GatewayBurger" name="Fries Ready">
      <bpmn:sourceRef>Task_PrepareFries</bpmn:sourceRef>
      <bpmn:targetRef>Gw_BurgerPrepStart</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Wedges Preparation to Burger Prep -->
    <bpmn:sequenceFlow id="SequenceFlow_Wedges_GatewayBurger" name="Wedges Ready">
      <bpmn:sourceRef>Task_PrepareWedges</bpmn:sourceRef>
      <bpmn:targetRef>Gw_BurgerPrepStart</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Timer Event to Status Update Task -->
    <bpmn:sequenceFlow id="SequenceFlow_Timer_StatusUpdate" name="Every 30 Seconds">
      <bpmn:sourceRef>StartTimer_1</bpmn:sourceRef>
      <bpmn:targetRef>Task_StatusUpdate</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Status Update to Burger Complete Gateway -->
    <bpmn:sequenceFlow id="SequenceFlow_Update_BurgerPrepLoop" name="Status Check">
      <bpmn:sourceRef>Task_StatusUpdate</bpmn:sourceRef>
      <bpmn:targetRef>Gw_BurgerComplete</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Burger Complete to Delivery -->
    <bpmn:sequenceFlow id="SequenceFlow_Yes_Delivery" name="Burger Ready">
      <bpmn:sourceRef>Gw_BurgerComplete</bpmn:sourceRef>
      <bpmn:targetRef>EndEvent_Delivery</bpmn:targetRef>
    </bpmn:sequenceFlow>

  </bpmn:process>

</bpmn:definitions>