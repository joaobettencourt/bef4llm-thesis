<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_BuildTreeHouse">
  <bpmn:collaboration id="Collab_TreeHouseProject">
    <bpmn:participant name="Homeowner / Project Manager" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    
    <!-- Lane Set -->
    <bpmn:laneSet id="Lane_Set_ProjectManagement">
      <bpmn:lane name="Construction Management">
        <bpmn:flowNodeRef>StartEvent_CollectRequirements</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendToArchitect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateCatchEvent_ReceiveDraft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_DraftReady</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RefineRequirements</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateMaterialList</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_OrderSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OnlineStoreA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendMessagesToFriends</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_MaterialsReady</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BuildHouse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendPartyInvites</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateGuestList</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_PartyReady</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_CollectRequirements" name="Collect Requirements">
      <bpmn:outgoing>SequenceFlow_StartToArchitect</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Send to Architect -->
    <bpmn:task id="Task_SendToArchitect" name="Send Requirements to Architect">
      <bpmn:incoming>SequenceFlow_RefineToSend</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ArchitectRequest</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Catch Event (Simulated as Task for Single Pool Validity) -->
    <bpmn:startEvent id="IntermediateCatchEvent_ReceiveDraft" name="Architect Sends Draft">
      <bpmn:incoming>SequenceFlow_ArchitectRequest</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DraftToGateway</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Gateway: Is Final? -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_DraftReady" name="Draft Ready">
      <bpmn:incoming>SequenceFlow_DraftToGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RefineLoop</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_MaterialListStart</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Refine Requirements -->
    <bpmn:task id="Task_RefineRequirements" name="Refine with Additional Req">
      <bpmn:incoming>SequenceFlow_RefineLoop</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RefineToSend</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Create Material List -->
    <bpmn:task id="Task_CreateMaterialList" name="Create Materials List">
      <bpmn:incoming>SequenceFlow_MaterialListStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OrderSplit</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway: Order vs Invite -->
    <bpmn:parallelGateway id="ParallelGateway_OrderSplit" name="Order &amp; Build Prep">
      <bpmn:incoming>SequenceFlow_OrderSplit</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OnlineStoreA</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SendMessagesStart</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Order Materials A -->
    <bpmn:task id="Task_OnlineStoreA" name="Order Category 1">
      <bpmn:incoming>SequenceFlow_OnlineStoreA</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MaterialsReadyIn</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Invite Builders -->
    <bpmn:task id="Task_SendMessagesToFriends" name="Send Messages to Friends">
      <bpmn:incoming>SequenceFlow_SendMessagesStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MaterialsReadyIn</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway: Merge -->
    <bpmn:parallelGateway id="ParallelGateway_MaterialsReady" name="All Ready">
      <bpmn:incoming>SequenceFlow_SendMessagesEnd</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_MaterialsReadyIn</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BuildStart</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Build House -->
    <bpmn:task id="Task_BuildHouse" name="Build Tree House">
      <bpmn:incoming>SequenceFlow_BuildStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PartyPrep</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Send Party Invites -->
    <bpmn:task id="Task_SendPartyInvites"