<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_InternshipProcess">
  <bpmn:message id="Message_OfferReceived" name="Offer Received"/>

  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="Pool_System" name="Internship Management System" processRef="Proc_Internship"/>
  </bpmn:collaboration>

  <bpmn:process id="Proc_Internship" isExecutable="false">
    
    <!-- Lane Set -->
    <bpmn:laneSet id="Lane_Set_1">
      <bpmn:lane id="Lane_Candidate">
        <bpmn:name>Candidate (You)</bpmn:name>
        <bpmn:flowNodeRef>StartEvent_Submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterDetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CatchEvent_WaitOffer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_AcceptDeny</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Pg_InternshipStart</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Company">
        <bpmn:name>Company (Employer)</bpmn:name>
        <bpmn:flowNodeRef>Pg_InternshipStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tk_CandidateUpdate1</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Submit" name="Submit Application">
      <bpmn:outgoing>Seq_Start_Task</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Enter Details -->
    <bpmn:task id="Task_EnterDetails" name="Enter Topic, Money, Experience &amp; Hobbies">
      <bpmn:incoming>Seq_Start_Task</bpmn:incoming>
      <bpmn:outgoing>Seq_Details_WaitOffer</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Catch Event for Offers -->
    <bpmn:startEvent id="CatchEvent_WaitOffer" name="Wait for Offer">
      <bpmn:messageRef>Message_OfferReceived</bpmn:messageRef>
      <bpmn:incoming>Seq_Details_WaitOffer</bpmn:incoming>
      <bpmn:outgoing>Seq_Gateway_AcceptDeny</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Gateway for Accept/Deny -->
    <bpmn:exclusiveGateway id="Gw_AcceptDeny">
      <bpmn:name>Accept or Deny?</bpmn:name>
      <bpmn:incoming>Seq_Gateway_AcceptDeny</bpmn:incoming>
      <bpmn:outgoing>Seq_Yes_Shipping</bpmn:outgoing>
      <bpmn:outgoing>Seq_No_Cancel</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Parallel Gateway for Internship Start -->
    <bpmn:parallelGateway id="Pg_InternshipStart">
      <bpmn:name>Internship Started</bpmn:name>
      <bpmn:incoming>Seq_Yes_Shipping</bpmn:incoming>
      <bpmn:outgoing>Seq_CandidateUpdate1</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task for Candidate Status Update -->
    <bpmn:task id="Tk_CandidateUpdate1" name="Write Status Update 1">
      <bpmn:name>Candidate writes update</bpmn:name>
      <bpmn:incoming>Seq_CandidateUpdate1</bpmn:incoming>
      <bpmn:outgoing>Seq_CompanyUpdate1</bpmn:outgoing>
    </bpmn:task>

    <!-- Task for Company Status Update -->
    <bpmn:task id="Tk_CompanyUpdate1" name="Company writes about you">
      <bpmn:name>Company status update 1</bpmn:name>
      <bpmn:incoming>Seq_CandidateUpdate1</bpmn:incoming>
      <bpmn:outgoing>Seq_End_Internship</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="End_Event_Success" name="Internship Completed">
      <bpmn:name>Recommend to Friends via Twitter</bpmn:name>
      <bpmn:incoming>Seq_End_Internship</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Seq_Start_Task" name="Start Application">
      <bpmn:sourceRef>StartEvent_Submit</bpmn:sourceRef>
      <bpmn:targetRef>Task_EnterDetails</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Seq_Details_WaitOffer" name="Submit Details">
      <bpmn:sourceRef>Task_EnterDetails</bpmn:sourceRef>
      <bpmn:targetRef>CatchEvent_WaitOffer</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Seq_Gateway_AcceptDeny" name="Receive Offer">
      <bpmn:sourceRef>CatchEvent_WaitOffer</bpmn:sourceRef>
      <bpmn:targetRef>Gw_AcceptDeny</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Seq_Yes_Shipping" name="Accept Offer">
      <bpmn:name>Accepted - Start Internship</bpmn:name>
      <bpmn:sourceRef>Gw_AcceptDeny</bpmn:sourceRef>
      <bpmn:targetRef>Pg_InternshipStart</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Seq_No_Cancel" name="Deny Offer">
      <bpmn:name>Denied - End Process</bpmn:name>
      <bpmn:sourceRef>Gw_AcceptDeny</bpmn:sourceRef>
      <bpmn:targetRef>CatchEvent_WaitOffer</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Seq_CandidateUpdate1" name="Write Update">
      <bpmn:name>Candidate writes update 1/3</bpmn:name>
      <bpmn:sourceRef>Pg_InternshipStart</bpmn:sourceRef>
      <bpmn:targetRef>Tk_CandidateUpdate1</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Seq_CompanyUpdate1" name="Company Update">
      <bpmn:name>Company writes update 1/3</bpmn:name>
      <bpmn:sourceRef>Tk_CandidateUpdate1</bpmn:sourceRef>
      <bpmn:targetRef>Tk_CompanyUpdate1</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Seq_End_Internship" name="Complete">
      <bpmn:name>Internship Complete - Recommend via Twitter</bpmn:name>
      <bpmn:sourceRef>Tk_CompanyUpdate1</bpmn:sourceRef>
      <bpmn:targetRef>End_Event_Success</bpmn:targetRef>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>