<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_FarmingBot">
  <bpmn:collaboration id="Collab_0FarmingBot">
    <bpmn:participant name="Farming Bot Service" processRef="Process_FarmBotExecution"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_FarmBotExecution" isExecutable="false">
    
    <!-- Lane Set -->
    <bpmn:laneSet>
      <bpmn:lane id="Lane_PlayerConfig" name="Player Interface">
        <bpmn:flowNodeRef>StartEvent_CreateBot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DefinePreferences</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SystemExecution" name="System Execution">
        <bpmn:flowNodeRef>Gw_ValidateDependencies</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_ParallelCollectionStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_CollectionMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_StartBotFarming</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BoundaryEvent_Disaster</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_MonitorUpdates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckMilestones</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Success</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_CreateBot" name="Create Custom Bot">
      <bpmn:outgoing>SequenceFlow_Start_Define</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Define Preferences -->
    <bpmn:task id="Task_DefinePreferences" name="Select Resources & Dependencies">
      <bpmn:incoming>SequenceFlow_Start_Define</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Define_GwValidate</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Validate Logic -->
    <bpmn:exclusiveGateway id="Gw_ValidateDependencies" name="Check Tool Dependencies">
      <bpmn:incoming>SequenceFlow_Define_GwValidate</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Valid_ParallelStart</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Gateway: Parallel Collection Start -->
    <bpmn:parallelGateway id="Gw_ParallelCollectionStart">
      <bpmn:incoming>SequenceFlow_Valid_ParallelStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Collect_Res1</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Collect Resource 1 -->
    <bpmn:task id="Task_Collect_Res1" name="Collect Basic Resources">
      <bpmn:incoming>SequenceFlow_Collect_Res1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Req_Tool2</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Collect Tool 2 (Dependent) -->
    <bpmn:task id="Task_Collect_Res2" name="Create Tools for Advanced Resources">
      <bpmn:incoming>SequenceFlow_Req_Tool2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Gather_Advance</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Collect Resource 3 (Parallel) -->
    <bpmn:task id="Task_Collect_Res3" name="Gather Advanced Resources">
      <bpmn:incoming>SequenceFlow_Gather_Advance</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Merge_FarmStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Collection Merge -->
    <bpmn:parallelGateway id="Gw_CollectionMerge">
      <bpmn:incoming>SequenceFlow_Gather_Advance</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Merge_FarmStart</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Start Farming -->
    <bpmn:task id="Task_StartBotFarming" name="Execute Bot Farming">
      <bpmn:incoming>SequenceFlow_Merge_FarmStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Farm_CheckMilestones</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Boundary Event (Disaster) -->
    <bpmn:startEvent id="BoundaryEvent_Disaster" name="Natural Disaster">
      <bpmn:boundaryAttachedToRef>Task_StartBotFarming</bpmn:boundaryAttachedToRef>
      <bpmn:outgoing>SequenceFlow_Recover_FarmStart</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Recover from Disaster -->
    <bpmn:task id="Task_Recovery" name="Recover Bot State">
      <bpmn:incoming>SequenceFlow_Recover_FarmStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Merge_FarmStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Monitor Updates & Milestones -->
    <bpmn:parallelGateway id="Gw_MonitorUpdates">
      <bpmn:incoming>SequenceFlow_Farm_CheckMilestones</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProgressLoop</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_EndCheck</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Check Milestones -->
    <bpmn:task id="Task_CheckMilestones" name="Monitor Progress">
      <bpmn:incoming>SequenceFlow_ProgressLoop</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Notify_Milestone</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Send Notification -->
    <bpmn:task id="Task_SendNotification" name="Notify Milestone Reached">
      <bpmn:incoming>SequenceFlow_Notify_Milestone</bpmn:incoming>
      <bpmn:outgoing>SequenceLoop_BackToFarm</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Farm Finished Check -->
    <bpmn:exclusiveGateway id="Gw_FarmFinished" name="Farming Complete?">
      <bpmn:incoming>SequenceFlow_EndCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BragSend</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Parallel Gateway for Brag/Send -->
    <bpmn:parallelGateway id="Gw_BragSendSplit">
      <bpmn:incoming>SequenceFlow_BragSend</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ActionBrag</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ActionSend</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Brag -->
    <bpmn:task id="Task_Brag" name="Brag to Friends">
      <bpmn:incoming>SequenceFlow_ActionBrag</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeEnd</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Send Materials -->
    <bpmn:task id="Task_SendMaterials" name="Send Materials to Friends">
      <bpmn:incoming>SequenceFlow_ActionSend</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeEnd_2</bpmn:outgoing>
    </bpmn:task>

    <!-- Merge End -->
    <bpmn:parallelGateway id="Gw_EndMerge">
      <bpmn:incoming>SequenceFlow_MergeEnd</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_MergeEnd_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Final_Success</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Success" name="Bot Finished">
      <bpmn:incoming>SequenceFlow_Final_Success</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows for Collection Logic (Simplified) -->
    <bpmn:sequenceFlow id="SequenceFlow_Start_Define" sourceRef="StartEvent_CreateBot" targetRef="Task_DefinePreferences">
      <bpmn:name>Initiate</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_Define_GwValidate" sourceRef="Task_DefinePreferences" targetRef="Gw_ValidateDependencies"/>

    <bpmn:sequenceFlow id="SequenceFlow_Valid_ParallelStart" sourceRef="Gw_ValidateDependencies" targetRef="Gw_ParallelCollectionStart">
      <bpmn:name>Valid</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_Collect_Res1" sourceRef="Gw_ParallelCollectionStart" targetRef="Task_Collect_Res1"/>

    <bpmn:sequenceFlow id="SequenceFlow_Req_Tool2" sourceRef="Task_Collect_Res1" targetRef="Task_Collect_Res2">
      <bpmn:name>Need Tools</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_Gather_Advance" sourceRef="Task_Collect_Res2" targetRef="Gw_ParallelCollectionStart"/>

    <bpmn:sequenceFlow id="SequenceFlow_Merge_FarmStart" sourceRef="Gw_ParallelCollectionStart" targetRef="Task_StartBotFarming">
      <bpmn:name>Ready to Farm</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Correcting End Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_BragSend" sourceRef="Gw_FarmFinished" targetRef="Gw_BragSendSplit">
      <bpmn:name>Finish</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Correcting Merge End Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_MergeEnd" sourceRef="Task_Brag" targetRef="Gw_EndMerge">
      <bpmn:name>Done</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Correcting Merge End Flow 2 -->
    <bpmn:sequenceFlow id="SequenceFlow_MergeEnd_2" sourceRef="Task_SendMaterials" targetRef="Gw_EndMerge">
      <bpmn:name>Done</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Correcting Final Success Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_Final_Success" sourceRef="Gw_EndMerge" targetRef="EndEvent_Success">
      <bpmn:name>Complete</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process> 
</bpmn:definitions>