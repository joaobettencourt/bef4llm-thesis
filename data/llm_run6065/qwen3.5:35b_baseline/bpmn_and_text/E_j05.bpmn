<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_VisaProcess_Austria">
  <bpmn:collaboration id="Collab_WorkLiveAustria">
    <bpmn:participant name="Work and Live in Austria Application Process" processRef="Proc_VisaApplication"/>
  </bpmn:collaboration>

  <bpmn:process id="Proc_VisaApplication" isExecutable="false">
    
    <!-- Lane Set -->
    <bpmn:laneSet id="Lane_Set_01">
      <bpmn:lane name="Applicant Actions" id="Lane_Applicant">
        <bpmn:flowNodeRef>StartEvent_VisaCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_VisaTypeDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AccommodationBank</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_CompetenceCheck</bpmn:flowNodeRef>
      </bpmn:lane>
      
      <bpmn:lane name="Authority Processing" id="Lane_Authority">
        <bpmn:flowNodeRef>Task_SubmitApplication</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_ApplicationDecision</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_VisaCheck" name="Start Application Process">
      <bpmn:outgoing>SequenceFlow_StartToType</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Gateway 1: Visa Type Determination -->
    <bpmn:exclusiveGateway id="Gw_VisaTypeDecision" name="Determine Visa Category">
      <bpmn:incoming>SequenceFlow_StartToType</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TypeDSchengen</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Tasks -->
    
    <!-- Task 1: Accommodation & Bank Account Negotiation (Included Requirement) -->
    <bpmn:task id="Task_AccommodationBank" name="Organize Accommodation and Bank Account">
      <bpmn:incoming>SequenceFlow_TypeDSchengen</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BankToDocs</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: Document Preparation (Included Requirements) -->
    <bpmn:task id="Task_PrepareDocuments" name="Prepare Application Documents">
      <bpmn:incoming>SequenceFlow_BankToDocs</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DocsToCompetence</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2: Territorial Competence Check -->
    <bpmn:exclusiveGateway id="Gw_CompetenceCheck" name="Determine Submission Location">
      <bpmn:incoming>SequenceFlow_DocsToCompetence</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MainDestRep</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_TypeDAustrian</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 3: Submission -->
    <bpmn:task id="Task_SubmitApplication" name="Submit Application to Representation">
      <bpmn:incoming>SequenceFlow_MainDestRep</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReviewProcess</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 3: Decision -->
    <bpmn:exclusiveGateway id="Gw_ApplicationDecision" name="Visa Application Result">
      <bpmn:incoming>SequenceFlow_ReviewProcess</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Approved</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Events -->
    
    <bpmn:endEvent id="End_VisaIssued" name="Visa Issued (Rot-Weiss-Rot Card)">
      <bpmn:incoming>SequenceFlow_Approved</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    
    <bpmn:sequenceFlow id="SequenceFlow_StartToType" name="Begin Process">
      <bpmn:sourceRef>StartEvent_VisaCheck</bpmn:sourceRef>
      <bpmn:targetRef>Gw_VisaTypeDecision</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Flow to Accommodation/Bank (Parallel or Sequential logic implied) -->
    <bpmn:sequenceFlow id="SequenceFlow_TypeDSchengen" name="Check Eligibility">
      <bpmn:sourceRef>Gw_VisaTypeDecision</bpmn:sourceRef>
      <bpmn:targetRef>Task_AccommodationBank</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Flow to Documents -->
    <bpmn:sequenceFlow id="SequenceFlow_BankToDocs" name="Negotiate &amp; Prepare">
      <bpmn:sourceRef>Task_AccommodationBank</bpmn:sourceRef>
      <bpmn:targetRef>Task_PrepareDocuments</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Flow to Competence Check -->
    <bpmn:sequenceFlow id="SequenceFlow_DocsToCompetence" name="Ready for Submission">
      <bpmn:sourceRef>Task_PrepareDocuments</bpmn:sourceRef>
      <bpmn:targetRef>Gw_CompetenceCheck</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Competence Logic Flows -->
    
    <!-- Main Destination Rule -->
    <bpmn:sequenceFlow id="SequenceFlow_MainDestRep" name="Main Dest / First Entry">
      <bpmn:sourceRef>Gw_CompetenceCheck</bpmn:sourceRef>
      <bpmn:targetRef>Task_SubmitApplication</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Type D Rule -->
    <bpmn:sequenceFlow id="SequenceFlow_TypeDAustrian" name="Type D Visa">
      <bpmn:sourceRef>Gw_CompetenceCheck</bpmn:sourceRef>
      <bpmn:targetRef>Task_SubmitApplication</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Submission to Decision -->
    <bpmn:sequenceFlow id="SequenceFlow_ReviewProcess" name="Authority Review">
      <bpmn:sourceRef>Task_SubmitApplication</bpmn:sourceRef>
      <bpmn:targetRef>Gw_ApplicationDecision</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Approval Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_Approved" name="Approved">
      <bpmn:sourceRef>Gw_ApplicationDecision</bpmn:sourceRef>
      <bpmn:targetRef>End_VisaIssued</bpmn:targetRef>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>