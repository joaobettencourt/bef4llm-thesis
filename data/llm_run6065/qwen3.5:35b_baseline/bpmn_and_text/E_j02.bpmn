<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_MaternityLeave">
  <bpmn:collaboration id="Collab_Leavesupport">
    <bpmn:participant name="Maternity Leave Support Process" processRef="Process_MaternalSupport"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_MaternalSupport" isExecutable="false">
    
    <!-- Lane Set -->
    <bpmn:laneSet id="Lane_Set_1">
      <bpmn:lane id="Lane_Parent" name="Parent / Citizen">
        <bpmn:flowNodeRef>Event_StartIntent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectModel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CollectInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ExtensionDecision</bpmn:flowNodeRef>
      </bpmn:lane>
      
      <bpmn:lane id="Lane_Admin" name="System / Administration">
        <bpmn:flowNodeRef>Task_FetchModelsInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_NotifySplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifySS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyCompany</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_NotifyMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GatherInfoCompanies</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="Event_StartIntent" name="Parent Intent to Take Leave">
      <bpmn:outgoing>SequenceFlow_FetchModels</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Tasks (Planning Phase) -->
    <bpmn:task id="Task_FetchModelsInfo" name="Fetch Information about Models">
       <bpmn:incoming>SequenceFlow_FetchModels</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_ReviewReady</bpmn:outgoing>
    </bpmn:task>

     <!-- Gateway for Selection (Implicit decision point) -->
    <bpmn:exclusiveGateway id="Gateway_SelectModelDecision">
      <bpmn:incoming>SequenceFlow_ReviewReady</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_SubmitAppStart</bpmn:outgoing>
    </bpmn:exclusiveGateway>

     <!-- Task (Selection) -->
    <bpmn:task id="Task_SelectModel" name="Select Leave Model">
      <bpmn:incoming>SequenceFlow_ReviewReady</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_SubmitAppStart2</bpmn:outgoing>
    </bpmn:task>

     <!-- Task (Collection) -->
    <bpmn:task id="Task_CollectInfo" name="Collect Relevant Information">
      <bpmn:incoming>SequenceFlow_SelectModelDone</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_StartNotifications</bpmn:outgoing>
    </bpmn:task>

     <!-- Parallel Gateway for Notifications -->
    <bpmn:parallelGateway id="Gateway_NotifySplit">
      <bpmn:incoming>SequenceFlow_SubmitAppStart2</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_NotifySSStart</bpmn:outgoing>
       <bpmn:outgoing>SequenceFlow_NotifyCompanyStart</bpmn:outgoing>
    </bpmn:parallelGateway>

     <!-- Task (Notify SS) -->
    <bpmn:task id="Task_NotifySS" name="Notify Social Security">
      <bpmn:incoming>SequenceFlow_SubmitAppStart2</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_SSNotified</bpmn:outgoing>
    </bpmn:task>

     <!-- Task (Notify Company) -->
    <bpmn:task id="Task_NotifyCompany" name="Notify Employer">
      <bpmn:incoming>SequenceFlow_SubmitAppStart2</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_CmpNotified</bpmn:outgoing>
    </bpmn:task>

     <!-- Merge Gateway -->
    <bpmn:parallelGateway id="Gateway_NotifyMerge">
      <bpmn:incoming>SequenceFlow_SSNotified</bpmn:incoming>
       <bpmn:incoming>SequenceFlow_CmpNotified</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_GatherInfoStart</bpmn:outgoing>
    </bpmn:parallelGateway>

     <!-- Task (Gather Info) -->
    <bpmn:task id="Task_GatherInfoCompanies" name="Gather Information from Companies">
      <bpmn:incoming>SequenceFlow_GatherInfoStart</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_WaitPeriodEnd</bpmn:outgoing>
    </bpmn:task>

     <!-- Intermediate Catch Timer (Time) -->
    <bpmn:startEvent id="Timer_EndOfLeave" name="Start Leave Period">
      <bpmn:incoming>SequenceFlow_WaitPeriodEnd</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_TimerWaitToDecide</bpmn:outgoing>
    </bpmn:startEvent>

     <!-- Intermediate Catch Timer (Time) -->
    <bpmn:endEvent id="End_Event_Extended"