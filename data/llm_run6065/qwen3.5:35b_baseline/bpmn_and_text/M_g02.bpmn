<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_LegoMachineProcess" targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:collaboration id="Collab_1">
    <bpmn:participant name="Custom Machine Project" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    
    <!-- Lane Set -->
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane name="Project Lead">
        <bpmn:flowNodeRef>Task_DevelopDesign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OrderSets</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_PartsCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReorderParts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ComponentLoopStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_TestResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RedesignRebuild</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_ComponentsDone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssembleMachine</bpmn:flowNodeRef>
      </bpmn:lane>
      
      <bpmn:lane name="Sorting Team">
        <bpmn:flowNodeRef>Task_SortParts</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="Start_Event_1" name="Project Initiated">
      <bpmn:outgoing>SequenceFlow_Start_Design</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- End Events -->
    <bpmn:endEvent id="End_Event_Success" name="Machine Assembled">
      <bpmn:incoming>SequenceFlow_Assemble_End</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Tasks -->
    <bpmn:task id="Task_DevelopDesign" name="Develop Basic Design">
      <bpmn:incoming>SequenceFlow_Start_Design</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Design_OrderSets</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_OrderSets" name="Order Lego Brick Sets">
      <bpmn:incoming>SequenceFlow_Design_OrderSets</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Order_SortParts</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_SortParts" name="Sort Parts into Containers">
      <bpmn:incoming>SequenceFlow_Order_SortParts</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Sort_ComponentLoopStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for Component Loop Start -->
    <bpmn:exclusiveGateway id="Gateway_ComponentLoopStart" name="More Components?">
      <bpmn:incoming>SequenceFlow_Sort_ComponentLoopStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Start_BuildCycle</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Build Subcomponent -->
    <bpmn:task id="Task_BuildSubcomp" name="Build Individual Subcomponent">
      <bpmn:incoming>SequenceFlow_Start_BuildCycle</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_Build_PartsCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for Parts Check -->
    <bpmn:exclusiveGateway id="Gw_PartsCheck" name="Parts Available?">
      <bpmn:incoming>SequenceFlow_Build_PartsCheck</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_No_Reorder</bpmn:outgoing>
       <bpmn:outgoing>SequenceFlow_Yes_Test</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Reorder Parts -->
    <bpmn:task id="Task_ReorderParts" name="Reorder Individual Parts">
      <bpmn:incoming>SequenceFlow_No_Reorder</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_Reorder_BuildCycle</bpmn:outgoing>
    </bpmn:task>

    <!-- Test Subcomponent -->
    <bpmn:task id="Task_TestSubcomp" name="Test Individual Component">
      <bpmn:incoming>SequenceFlow_Yes_Test</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_Test_ResultCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for Test Result -->
    <bpmn:exclusiveGateway id="Gw_TestResult" name="Test Successful?">
      <bpmn:incoming>SequenceFlow_Test_ResultCheck</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_Fail_Redesign</bpmn:outgoing>
       <bpmn:outgoing>SequenceFlow_Pass_ComponentsDone</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Redesign and Rebuild -->
    <bpmn:task id="Task_RedesignRebuild" name="Redesign &amp; Rebuild">
      <bpmn:incoming>SequenceFlow_Fail_Redesign</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_Rebuild_BuildCycle</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for All Components Done -->
    <bpmn:exclusiveGateway id="Gw_ComponentsDone" name="All Tested?">
      <bpmn:incoming>SequenceFlow_Pass_ComponentsDone</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_No_LoopBack</bpmn:outgoing>
       <bpmn:outgoing>SequenceFlow_Yes_Assemble</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Assemble Machine -->
    <bpmn:task id="Task_AssembleMachine" name="Assemble Subcomponents">
      <bpmn:incoming>SequenceFlow_Yes_Assemble</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_Assemble_End</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flows -->
    
    <bpmn:sequenceFlow id="SequenceFlow_Start_Design" sourceRef="Start_Event_1" targetRef="Task_DevelopDesign"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_Design_OrderSets" name="After Design" sourceRef="Task_DevelopDesign" targetRef="Task_OrderSets"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_Order_SortParts" name="Receive Sets" sourceRef="Task_OrderSets" targetRef="Task_SortParts"/>
    
    <!-- Loop Start to Build -->
    <bpmn:sequenceFlow id="SequenceFlow_Start_BuildCycle" name="Start Cycle" sourceRef="Gateway_ComponentLoopStart" targetRef="Task_BuildSubcomp"/>

    <!-- Parts Check Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_Build_PartsCheck" sourceRef="Task_BuildSubcomp" targetRef="Gw_PartsCheck"/>
    
    <!-- Reorder Logic -->
    <bpmn:sequenceFlow id="SequenceFlow_No_Reorder" name="No Parts" sourceRef="Gw_PartsCheck" targetRef="Task_ReorderParts"/>
    <bpmn:sequenceFlow id="SequenceFlow_Reorder_BuildCycle" name="Reordered" sourceRef="Task_ReorderParts" targetRef="Gateway_ComponentLoopStart"/>

    <!-- Test Logic -->
    <bpmn:sequenceFlow id="SequenceFlow_Yes_Test" name="Parts OK" sourceRef="Gw_PartsCheck" targetRef="Task_TestSubcomp"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_Test_ResultCheck" sourceRef="Task_TestSubcomp" targetRef="Gw_TestResult"/>

    <!-- Redesign Logic -->
    <bpmn:sequenceFlow id="SequenceFlow_Fail_Redesign" name="Failed Test" sourceRef="Gw_TestResult" targetRef="Task_RedesignRebuild"/>
    <bpmn:sequenceFlow id="SequenceFlow_Rebuild_BuildCycle" name="Redesigned" sourceRef="Task_RedesignRebuild" targetRef="Gateway_ComponentLoopStart"/>

    <!-- Completion Logic -->
    <bpmn:sequenceFlow id="SequenceFlow_Pass_ComponentsDone" name="Passed Test" sourceRef="Gw_TestResult" targetRef="Gw_ComponentsDone"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_No_LoopBack" name="More Components?" sourceRef="Gw_ComponentsDone" targetRef="Gateway_ComponentLoopStart"/>

    <!-- Assembly Logic -->
    <bpmn:sequenceFlow id="SequenceFlow_Yes_Assemble" name="All Done" sourceRef="Gw_ComponentsDone" targetRef="Task_AssembleMachine"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_Assemble_End" sourceRef="Task_AssembleMachine" targetRef="End_Event_Success"/>

  </bpmn:process>

</bpmn:definitions>