<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_FridgeService">
  <bpmn:collaboration id="Collab_ServiceProcess">
    <bpmn:participant name="Fridge Service Center" processRef="Process_ServiceFlow"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_ServiceFlow" isExecutable="false">
    
    <!-- Lane Set -->
    <bpmn:laneSet id="Lane_Set_ServiceOrg">
      <bpmn:lane id="Lane_CentralCoordination" name="Central Coordination">
        <bpmn:flowNodeRef>Task_SelectFacility</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_PartsAvailable</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_LocalTechnician" name="Local Technician">
        <bpmn:flowNodeRef>Task_AppointmentVisit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RepairFridge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OrderParts</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="Start_RequestReceived" name="Receive Complaint">
      <bpmn:outgoing>SequenceFlow_Start_Select</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- End Events -->
    <bpmn:endEvent id="End_SuccessfulRepair" name="Service Completed &amp; Rated">
       <bpmn:incoming>SequenceFlow_Rating_End</bpmn:incoming>
     </bpmn:endEvent>

    <!-- Tasks -->
    <bpmn:task id="Task_SelectFacility" name="Select Local Facility">
      <bpmn:incoming>SequenceFlow_Start_Select</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_Facility_Visit</bpmn:outgoing> 
     </bpmn:task>

    <bpmn:task id="Task_AppointmentVisit" name="Make Appointment &amp; Visit">
      <bpmn:incoming>SequenceFlow_Facility_Visit</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_Visit_CheckParts</bpmn:outgoing> 
     </bpmn:task>

    <bpmn:task id="Task_RepairFridge" name="Repair Fridge">
      <bpmn:incoming>SequenceFlow_Parts_Yes</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_Repair_Confirm</bpmn:outgoing> 
     </bpmn:task>

    <bpmn:task id="Task_OrderParts" name="Order Additional Parts">
      <bpmn:incoming>SequenceFlow_Parts_No</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_ReturnVisit</bpmn:outgoing> 
     </bpmn:task>

    <!-- Gateway -->
    <bpmn:exclusiveGateway id="Gw_PartsAvailable">
      <bpmn:name>Name></bpmn:name>
       <bpmn:name>Parts Available?</bpmn:name> 
         <bpmn:incoming>SequenceFlow_Visit_CheckStock</bpmn:incoming>
          <bpmn:outgoing>SequenceFlow_Parts_Yes</bpmn:outgoing>
           <bpmn:outgoing>SequenceFlow_Parts_No</bpmn:outgoing> 
    </bpmn:exclusiveGateway>

    <!-- Sequence Flows -->
       <bpmn:sequenceFlow id="SequenceFlow_Start_Select" name ="Request Received"> 
         <bpmn:sourceRef>Start_RequestReceived</bpmn:sourceRef >
          <bpmn:targetRef>Task_SelectFacility</bpmn:targetRef/> 
       </bpmn:sequenceFlow>

      <bpmn:sequenceFlow id="SequenceFlow_Facility_Visit" name ="Assign Facility">
        <bpmn:sourceRef>Task_SelectFacility</bpmn:sourceRef /> 
         <bpmn:targetRef>Task_AppointmentVisit</bpmn:targetRef/>
      </bpmn:sequenceFlow>

       <!-- Flow from Gateway -->
     <bpmn:sequenceFlow id="SequenceFlow_Parts_Yes" name="Parts Available"> 
        <bpmn:sourceRef>Gw_PartsAvailable</bpmn:sourceRef />
         <bpmn:targetRef>Task_RepairFridge</bpmn:targetRef/>
      </bpmn:sequenceFlow >

       <!-- Flow from Gateway -->
     <bpmn:sequenceFlow id="SequenceFlow_Parts_No" name ="No Stock">
         <bpmn:sourceRef>Gw_PartsAvailable</bpmn:sourceRef /> 
          <bpmn:targetRef>Task_OrderParts</bpmn:targetRef/>
      </bpmn:sequenceFlow >

     <!-- Flow from Repair Task -->
      <bpmn:sequenceFlow id="SequenceFlow_Repair_Confirm" name ="Repair Done"> 
        <bpmn:sourceRef>Task_RepairFridge</bpmn:sourceRef />
          <bpmn:targetRef>End_SuccessfulRepair</bpmn:targetRef/>
      </bpmn:sequenceFlow >

       <!-- Flow from Order Parts Task (Loop) -->
     <bpmn:sequenceFlow id="SequenceFlow_ReturnVisit" name ="Return Later"> 
        <bpmn:sourceRef>Task_OrderParts</bpmn:sourceRef />
          <bpmn:targetRef>Gw_PartsAvailable</bpmn:targetRef/>
      </bpmn:sequenceFlow >

  </bpmn:process> 
</bpmn:definitions>