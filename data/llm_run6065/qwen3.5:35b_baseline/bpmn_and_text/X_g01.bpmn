<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_RegistrationProcess">

  <bpmn:collaboration id="Collab_CourseRegistration">
    <bpmn:participant name="Sports Institute Registration System" processRef="Proc_Registration"/>
  </bpmn:collaboration>

  <bpmn:process id="Proc_Registration" isExecutable="false">
    
    <!-- Lane Set -->
    <bpmn:laneSet id="LaneSet_UserProcess">
      <bpmn:lane name="User Registration Flow">
        <bpmn:flowNodeRef>StartEvent_Register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_CheckSlots</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectCourse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_HaveAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Cancelled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LoginExisting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckUniReg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_EligibleUni</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegisterAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RequestActivation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CatchEvent_WaitResponse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TweetFriends</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CompleteRegPayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ThrowEvent_SendTicket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ReceivedTicket</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Register" name="Register for USI Course">
      <bpmn:outgoing>Seq_Start_CheckSlots</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_Cancelled" name="Registration Cancelled (No Slots)">
       <bpmn:incoming>Seq_Slots_No</bpmn:incoming>
     </bpmn:endEvent>
     
     <bpmn:endEvent id="EndEvent_ReceivedTicket" name="Course Ticket Received">
      <bpmn:incoming>Seq_SendTicket_End</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Gateways -->
    <bpmn:exclusiveGateway id="Gw_CheckSlots" name="Check Slot Availability?">
       <bpmn:incoming>Seq_Start_CheckSlots</bpmn:incoming>
       <bpmn:outgoing>Seq_Slots_Yes</bpmn:outgoing>
       <bpmn:outgoing>Seq_Slots_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>

     <bpmn:exclusiveGateway id="Gw_HaveAccount" name="Existing Account?">
      <bpmn:incoming>Seq_Select_Course_AccountCheck</bpmn:incoming>
       <bpmn:outgoing>Seq_Acc_Yes_Login</bpmn:outgoing> 
       <bpmn:outgoing>Seq_Acc_No_UniReg</bpmn:outgoing>
    </bpmn:exclusiveGateway>

     <bpmn:exclusiveGateway id="Gw_EligibleUni" name="Eligible University?">
      <bpmn:incoming>Seq_CheckUni_RegCheck</bpmn:incoming> 
       <bpmn:outgoing>Seq_Uni_Yes_RegAcc</bpmn:outgoing> 
       <bpmn:outgoing>Seq_Uni_No_Activate</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Tasks -->
     <bpmn:task id="Task_SelectCourse" name="Select Course &amp; Date">
      <bpmn:incoming>Seq_Slots_Yes_CourseSel</bpmn:incoming> 
       <bpmn:outgoing>Seq_Select_Course_AccountCheck</bpmn:outgoing>
    </bpmn:task>

     <bpmn:task id="Task_LoginExisting" name="Log into Account">
      <bpmn:incoming>Seq_Acc_Yes_LoginIn</bpmn:incoming> 
       <bpmn:outgoing>Seq_Login_TweetFriends</bpmn:outgoing>
    </bpmn:task>

     <bpmn:task id="Task_CheckUniReg" name="Check University Registration">
      <bpmn:incoming>Seq_Acc_No_UniReg</bpmn:incoming> 
       <bpmn:outgoing>Seq_CheckUni_RegCheck</bpmn:outgoing>
    </bpmn:task>

     <bpmn:task id="Task_RegisterAccount" name="Register Account">
      <bpmn:incoming>Seq_Uni_Yes_RegAccIn</bpmn:incoming> 
       <bpmn:outgoing>Seq_RegAcc_LoginIn</bpmn:outgoing>
    </bpmn:task>

     <bpmn:task id="Task_RequestActivation" name="Request Activation">
      <bpmn:incoming>Seq_Uni_No_ActivateIn</bpmn:incoming> 
       <bpmn:outgoing>Seq_ReqAct_Wait</bpmn:outgoing>
    </bpmn:task>

     <bpmn:task id="Task_TweetFriends" name="Tweet Friends">
      <bpmn:incoming>Seq_Login_TweetFriendsIn</bpmn:incoming> 
       <bpmn:outgoing>Seq_Tweet_RegPay</bpmn:outgoing>
    </bpmn:task>

     <bpmn:task id="Task_CompleteRegPayment" name="Complete Registration &amp; Payment">
      <bpmn:incoming>Seq_Tweet_RegPayIn</bpmn:incoming> 
       <bpmn:outgoing>Seq_CompTicketSend</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Events -->
     <bpmn:intermediateCatchEvent id="CatchEvent_WaitResponse" name="Wait for Activation Response">
      <bpmn:incoming>Seq_ReqAct_WaitIn</bpmn:incoming> 
       <bpmn:outgoing>Seq_WaitResponse_LoginIn</bpmn:outgoing>
        <bpmn:timerDefinition xsi:type="bpmn:TimerEventDefinition">
          <bpmn:timeDuration>P1D</bpmn:timeDuration>
        </bpmn:timerDefinition> 
    </bpmn:intermediateCatchEvent>

     <bpmn:intermediateThrowEvent id="ThrowEvent_SendTicket" name="Send Course Ticket">
      <bpmn:incoming>Seq_CompTicketSendIn</bpmn:incoming> 
       <bpmn:outgoing>Seq_SendTicket_End</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <!-- Sequence Flows -->
     <bpmn:sequenceFlow id="Seq_Start_CheckSlots" sourceRef="StartEvent_Register" targetRef="Gw_CheckSlots"/>
     
     <bpmn:sequenceFlow id="Seq_Slots_Yes_CourseSel" name="Available" sourceRef="Gw_CheckSlots" targetRef="Task_SelectCourse"/>
     <bpmn:sequenceFlow id="Seq_Slots_No" name="Not Available" sourceRef="Gw_CheckSlots" targetRef="EndEvent_Cancelled"/>

     <bpmn:sequenceFlow id="Seq_Select_Course_AccountCheck" sourceRef="Task_SelectCourse" targetRef="Gw_HaveAccount"/>
     
     <!-- Account Branches -->
     <bpmn:sequenceFlow id="Seq_Acc_Yes_LoginIn" name="Yes - Existing" sourceRef="Gw_HaveAccount" targetRef="Task_LoginExisting"/>
     <bpmn:sequenceFlow id="Seq_Acc_No_UniReg" name="No - New User" sourceRef="Gw_HaveAccount" targetRef="Task_CheckUniReg"/>

     <!-- University Branches -->
     <bpmn:sequenceFlow id="Seq_Che ckUn i_RegC hec k" sourceRef="Task_CheckUniReg" targetRef="Gw_EligibleUni"/>
     
     <bpmn:sequenceFlow id="Seq_Uni_Yes_RegAccIn" name="Yes - Eligible" sourceRef="Gw_EligibleUni" targetRef="Task_RegisterAccount"/>
     <bpmn:sequenceFlow id="Seq_Uni_No_ActivateIn" name="No - Request Activation" sourceRef="Gw_EligibleUni" targetRef="Task_RequestActivation"/>

     <!-- Convergence to Login -->
     <bpmn:sequenceFlow id="Seq_RegAcc_LoginIn" sourceRef="Task_RegisterAccount" targetRef="Task_LoginExisting"/>
     
     <bpmn:sequenceFlow id="Seq_ReqAct_WaitIn" name="" sourceRef="Task_RequestActivation" targetRef="CatchEvent_WaitResponse"/>
     <bpmn:sequenceFlow id="Seq_WaitResponse_LoginIn" sourceRef="CatchEvent_WaitResponse" targetRef="Task_LoginExisting"/>

     <!-- Post Login Flow -->
     <bpmn:sequenceFlow id="Seq_Login_TweetFriendsIn" name="" sourceRef="Task_LoginExisting" targetRef="Task_TweetFriends"/>
     
     <bpmn:sequenceFlow id="Seq_Tweet_RegPayIn" sourceRef="Task_TweetFriends" targetRef="Task_CompleteRegPayment"/>

     <!-- Finalization -->
     <bpmn:sequenceFlow id="Seq_CompTicketSendIn" name="" sourceRef="Task_CompleteRegPayment" targetRef="ThrowEvent_SendTicket"/>
     
     <bpmn:sequenceFlow id="Seq_SendTicket_End" sourceRef="ThrowEvent_SendTicket" targetRef="EndEvent_ReceivedTicket"/>

  </bpmn:process> 
</bpmn:definitions>