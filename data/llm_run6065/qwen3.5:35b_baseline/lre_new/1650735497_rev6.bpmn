<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_PayPalVerification">
    <bpmn:participant id="Participant_MainProcess" name="PayPal Bank Verification Process" processRef="Process_Verification_1" />
  </bpmn:collaboration>

  <bpmn:process id="Process_Verification_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_ClientActions" name="PayPal Client Actions">
        <bpmn:flowNodeRef>StartEvent_SelectPayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterBankDetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateCatchTimer_WaitNotification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VerifyDepositAmounts</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_SystemProcessing" name="PayPal System Processing">
        <bpmn:flowNodeRef>Task_InitiateDepositsAndSubmit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CheckValuesMatch</bpmn:flowNodeRef>
      </bpmn:lane>

      <!-- End Events placed in the process scope, logically concluding lanes -->
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_SelectPayment" name="Select Bank Account Payment">
      <bpmn:outgoing>SequenceFlow_StartToEnterDetails</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:endEvent id="EndEvent_AccountConfirmed" name="Account Confirmed">
      <bpmn:incoming>SequenceFlow_ConfirmedPath</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_AccountRejected" name="Account Rejected">
      <bpmn:incoming>SequenceFlow_RejectedPath</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:userTask id="Task_EnterBankDetails" name="Enter Bank Details &amp; Continue">
      <bpmn:documentation>Client enters first name, bank name, account type, BSB and account number.</bpmn:documentation>
      <bpmn:incoming>SequenceFlow_StartToEnterDetails</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EnterDetailsToInitiateDeposits</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:task id="Task_InitiateDepositsAndSubmit" name="Submit Details &amp; Initiate Deposits">
      <bpmn:documentation>System submits details and makes two random deposits to bank account.</bpmn:documentation>
      <bpmn:incoming>SequenceFlow_EnterDetailsToInitiateDeposits</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InitiateToTimerWait</bpmn:outgoing>
    </bpmn:task>

    <bpmn:intermediateCatchEvent id="IntermediateCatchTimer_WaitNotification" name="Wait 3-5 Working Days">
      <bpmn:timerDefinition xsi:type="bpmn:TimeDuration">P3D</bpmn:timerDefinition>
      <bpmn:incoming>SequenceFlow_InitiateToTimerWait</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TimerToVerifyAmounts</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:userTask id="Task_VerifyDepositAmounts" name="Enter Deposit Amounts &amp; Verify">
      <bpmn:documentation>Client logs in, enters amounts from two deposits and clicks verify.</bpmn:documentation>
      <bpmn:incoming>SequenceFlow_TimerToVerifyAmounts</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_VerifyToCheckValues</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:task id="Task_CheckVerification" name="Check Verification Values">
      <bpmn:documentation>System checks entered values against stored deposit amounts.</bpmn:documentation>
      <bpmn:incoming>SequenceFlow_VerifyToCheckValues</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckToGateway</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_CheckValuesMatch" name="Do Values Match?">
      <bpmn:incoming>SequenceFlow_CheckToGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConfirmedPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RejectedPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToEnterDetails" sourceRef="StartEvent_SelectPayment" targetRef="Task_EnterBankDetails">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_EnterDetailsToInitiateDeposits" name="Submit Details" sourceRef="Task_EnterBankDetails" targetRef="Task_InitiateDepositsAndSubmit">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_InitiateToTimerWait" name="Initiate Deposits &amp; Wait" sourceRef="Task_InitiateDepositsAndSubmit" targetRef="IntermediateCatchTimer_WaitNotification">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_TimerToVerifyAmounts" name="Notify Client (3-5 Days)" sourceRef="IntermediateCatchTimer_WaitNotification" targetRef="Task_VerifyDepositAmounts">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_VerifyToCheckValues" name="Verify Amounts" sourceRef="Task_VerifyDepositAmounts" targetRef="Task_CheckVerification">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_CheckToGateway" name="Submit for Check" sourceRef="Task_CheckVerification" targetRef="Gateway_CheckValuesMatch">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ConfirmedPath" name="Yes - Match Found" sourceRef="Gateway_CheckValuesMatch" targetRef="EndEvent_AccountConfirmed">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_RejectedPath" name="No - Values Do Not Match" sourceRef="Gateway_CheckValuesMatch" targetRef="EndEvent_AccountRejected">
      <bpmn:name/>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>