<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_RewardProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Process" name="Reward and Training Process" processRef="Process_RewardTraining" />
  </bpmn:collaboration>

  <bpmn:process id="Process_RewardTraining" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Management" name="Management">
        <bpmn:flowNodeRef>StartEvent_CheckPerformance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckEmployeePerformance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PerformanceLevel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SuggestDismissal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SuggestTraining</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SuggestReward</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RewardType</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ChooseBenefit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MergeRewardPath</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AnnounceEmployeeOfTheMonth</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_HR" name="Human Resources">
        <bpmn:flowNodeRef>Gateway_PerformanceLevel</bpmn:flowNodeRef> <!-- Shared reference for flow logic -->
        <bpmn:flowNodeRef>Task_DismissEmployee</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProvideTraining</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Finance" name="Finance Department">
        <bpmn:flowNodeRef>Gateway_MergeRewardPath</bpmn:flowNodeRef> <!-- Shared reference for flow logic -->
        <bpmn:flowNodeRef>Task_CalculateAndPayReward</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_CheckPerformance" name="Check Employee Performance">
      <bpmn:outgoing>SequenceFlow_StartToTask1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:endEvent id="End_Dismissed" name="Employee Dismissed">
      <bpmn:incoming>SequenceFlow_TaskDismissalToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="End_TrainingDone" name="Training Completed">
      <bpmn:incoming>SequenceFlow_ProvideTrainingToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="End_RewardCompleted" name="Reward Process Complete">
      <bpmn:incoming>SequenceFlow_AnnounceToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="End_NoActionRequired" name="Performance Normal - No Action">
      <bpmn:incoming>SequenceFlow_DefaultPathToDone</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:task id="Task_CheckEmployeePerformance" name="Check Employee Performance">
      <bpmn:incoming>SequenceFlow_StartToTask1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Task1ToGatewayLevel</bpmn:outgoing>
    </bpmn:endEvent>

    <!-- Corrected Task Definition -->
    <bpmn:task id="Task_CheckEmployeePerformance" name="Check Employee Performance">
      <bpmn:incoming>SequenceFlow_StartToTask1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Task1ToGatewayLevel</bpmn:outgoing>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>