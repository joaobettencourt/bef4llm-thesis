<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_HardwareProcurement">
    <bpmn:participant id="Participant_Company" name="Hardware Procurement Process"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_ITDepartment" name="IT Department">
        <bpmn:flowNodeRef>StartEvent_ReceiveRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AnalyzeRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ITApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EditCompleteRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RequestQuote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CatchEvent_ReceiveOffer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FillFormSendMgmt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MergeReady</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CatchEvent_ReceiveAcceptance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveHardware</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Management" name="Management">
        <bpmn:flowNodeRef>Gateway_MgmtDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AnalysisRequestMgmt</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_FinancialDept" name="Financial Department">
        <bpmn:flowNodeRef>Gateway_SplitFinanceIT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FindResources</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProcessInvoice</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_ReceiveRequest" name="Receive Hardware Request">
      <bpmn:outgoing>SequenceFlow_Analyze</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Analyze Request (IT) -->
    <bpmn:task id="Task_AnalyzeRequest" name="Analyse Hardware Request">
      <bpmn:incoming>SequenceFlow_Analyze</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ITApprovalDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: IT Approval Decision -->
    <bpmn:exclusiveGateway id="Gateway_ITApproval" name="Request Approved?">
      <bpmn:incoming>SequenceFlow_ITApprovalDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DenyPathIT</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ApprovePathIT</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Send Denial Email (Deny Path) -->
    <bpmn:task id="Task_SendDenialEmail" name="Inform Employee of Denial">
      <bpmn:incoming>SequenceFlow_DenyPathIT</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendDenialEmail</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event: Denied by IT -->
    <bpmn:endEvent id="EndEvent_DeniedByIT" name="Process Ended">
      <bpmn:incoming>SequenceFlow_SendDenialEmail</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task: Edit and Complete Request (Approve Path) -->
    <bpmn:task id="Task_EditCompleteRequest" name="Edit and Complete Request">
      <bpmn:incoming>SequenceFlow_ApprovePathIT</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RequestQuote</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Send Email to Supplier (Request Quote) -->
    <bpmn:task id="Task_RequestQuote" name="Request Prices from Supplier">
      <bpmn:incoming>SequenceFlow_RequestQuote</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitForOffer</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Catch Event: Receive Offer -->
    <bpmn:startEvent id="CatchEvent_ReceiveOffer" name="Receive Supplier Offer">
      <bpmn:incoming>SequenceFlow_WaitForOffer</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FillFormMgmt</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Fill Form and Send to Management -->
    <bpmn:task id="Task_FillFormSendMgmt" name="Fill Request Form">
      <bpmn:incoming>SequenceFlow_FillFormMgmt</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendToManagementAnalysis</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Analysis Request Mgmt (Management) -->
    <bpmn:task id="Task_AnalysisRequestMgmt" name="Analyse Management Request">
      <bpmn:incoming>SequenceFlow_SendToManagementAnalysis</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MgmtDecisionGateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Mgmt Decision -->
    <bpmn:exclusiveGateway id="Gateway_MgmtDecision" name="Management Approval?">
      <bpmn:incoming>SequenceFlow_MgmtDecisionGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReworkPathMgmt</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_DenyPathMgmt</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ApprovePathMgmt</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event: Denied by Management -->
    <bpmn:endEvent id="EndEvent_DeniedByMgmt" name="Process Ended">
      <bpmn:incoming>SequenceFlow_DenyPathMgmt</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Parallel Gateway Split (Finance & IT) -->
    <bpmn:parallelGateway id="Gateway_SplitFinanceIT" name="Split Finance &amp; IT Tasks">
      <bpmn:incoming>SequenceFlow_ApprovePathMgmt</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FinanceTask</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ITOrderTask</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Find Resources (Financial) -->
    <bpmn:task id="Task_FindResources" name="Find Financial Resources">
      <bpmn:incoming>SequenceFlow_FinanceTask</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReadyForHardwareFinance</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Prepare Order (IT) -->
    <bpmn:task id="Task_PrepareOrder" name="Prepare and Send Order">
      <bpmn:incoming>SequenceFlow_ITOrderTask</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitForAcceptance</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Catch Event: Receive Acceptance -->
    <bpmn:startEvent id="CatchEvent_ReceiveAcceptance" name="Receive Order Acceptance">
      <bpmn:incoming>SequenceFlow_WaitForAcceptance</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeReadyIT</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Parallel Gateway Merge -->
    <bpmn:parallelGateway id="Gateway_MergeReady" name="All Conditions Met?">
      <bpmn:incoming>SequenceFlow_ReadyForHardwareFinance</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_MergeReadyIT</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReceiveHardwareTask</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Receive Hardware (IT) -->
    <bpmn:task id="Task_ReceiveHardware" name="Receive Hardware">
      <bpmn:incoming>SequenceFlow_ReceiveHardwareTask</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProcessInvoiceStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Process Invoice (Financial) -->
    <bpmn:task id="Task_ProcessInvoice" name="Process Supplier Invoice">
      <bpmn:incoming>SequenceFlow_ProcessInvoiceStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndCompleted</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event: Completed -->
    <bpmn:endEvent id="EndEvent_Completed" name="Process Ended">
      <bpmn:incoming>SequenceFlow_EndCompleted</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_Analyze" sourceRef="StartEvent_ReceiveRequest" targetRef="Task_AnalyzeRequest"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ITApprovalDecision" name="" sourceRef="Task_AnalyzeRequest" targetRef="Gateway_ITApproval"/>

    <bpmn:sequenceFlow id="SequenceFlow_DenyPathIT" name="No - Denied" sourceRef="Gateway_ITApproval" targetRef="Task_SendDenialEmail">
      <bpmn:name>No</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ApprovePathIT" name="Yes - Approved" sourceRef="Gateway_ITApproval" targetRef="Task_EditCompleteRequest"/>

    <bpmn:sequenceFlow id="SequenceFlow_RequestQuote" name="" sourceRef="Task_EditCompleteRequest" targetRef="Task_RequestQuote"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_WaitForOffer" name="" sourceRef="Task_RequestQuote" targetRef="CatchEvent_ReceiveOffer"/>

    <bpmn:sequenceFlow id="SequenceFlow_FillFormMgmt" name="" sourceRef="CatchEvent_ReceiveOffer" targetRef="Task_FillFormSendMgmt"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_SendToManagementAnalysis" name="" sourceRef="Task_FillFormSendMgmt" targetRef="Task_AnalysisRequestMgmt"/>

    <bpmn:sequenceFlow id="SequenceFlow_MgmtDecisionGateway" name="" sourceRef="Task_AnalysisRequestMgmt" targetRef="Gateway_MgmtDecision"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ReworkPathMgmt" name="Rework Required" sourceRef="Gateway_MgmtDecision" targetRef="Task_EditCompleteRequest">
      <bpmn:name>Rework</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_DenyPathMgmt" name="Deny Request" sourceRef="Gateway_MgmtDecision" targetRef="EndEvent_DeniedByMgmt">
      <bpmn:name>No</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ApprovePathMgmt" name="Approved by Mgmt" sourceRef="Gateway_MgmtDecision" targetRef="Gateway_SplitFinanceIT">
      <bpmn:name>Yes</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_FinanceTask" name="Find Resources" sourceRef="Gateway_SplitFinanceIT" targetRef="Task_FindResources"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ITOrderTask" name="Prepare Order" sourceRef="Gateway_SplitFinanceIT" targetRef="Task_PrepareOrder"/>

    <bpmn:sequenceFlow id="SequenceFlow_WaitForAcceptance" name="" sourceRef="Task_PrepareOrder" targetRef="CatchEvent_ReceiveAcceptance"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_MergeReadyIT" name="Order Accepted" sourceRef="CatchEvent_ReceiveAcceptance" targetRef="Gateway_MergeReady"/>

    <bpmn:sequenceFlow id="SequenceFlow_ReadyForHardwareFinance" name="Resources Found" sourceRef="Task_FindResources" targetRef="Gateway_MergeReady"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ReceiveHardwareTask" name="" sourceRef="Gateway_MergeReady" targetRef="Task_ReceiveHardware"/>

    <bpmn:sequenceFlow id="SequenceFlow_ProcessInvoiceStart" name="" sourceRef="Task_ReceiveHardware" targetRef="Task_ProcessInvoice"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_EndCompleted" name="" sourceRef="Task_ProcessInvoice" targetRef="EndEvent_Completed"/>

  </bpmn:process>
</bpmn:definitions>