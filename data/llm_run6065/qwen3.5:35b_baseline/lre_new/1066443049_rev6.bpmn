<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_WebDesignProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_WebDesign">
    <bpmn:participant id="Participant_WebTeam" name="Web Design Team" processRef="Process_WebDesign"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_WebDesign" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_DesignTeam" name="Web Design Team">
        <bpmn:flowNodeRef>StartEvent_Meeting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GwMeetingSuccess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TskStoryboard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PgSplitDevContent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GwReviewNeeded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TskFinalizeContent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PgMergeComplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TskBuildSite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GwApproved</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Marketing" name="Marketing Team">
        <bpmn:flowNodeRef>TskContentReview</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Meeting" name="Informational Meeting">
      <bpmn:outgoing>SF_StartToMeetingCheck</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_ProcessFailed" name="Process Failed - Unsuccessful Meeting"/>
    <bpmn:endEvent id="EndEvent_Completed" name="Website Published Successfully">
      <bpmn:incoming>SF_ApprovedToDone</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Gateway: Meeting Success -->
    <bpmn:exclusiveGateway id="GwMeetingSuccess" name="Meeting Successful?">
      <bpmn:incoming>SF_StartToMeetingCheck</bpmn:incoming>
      <bpmn:outgoing>SF_YesStoryboard</bpmn:outgoing>
      <bpmn:outgoing>SF_NoEndProcess</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Create Storyboard -->
    <bpmn:task id="TskStoryboard" name="Create Storyboard">
      <bpmn:incoming>SF_YesStoryboard</bpmn:incoming>
      <bpmn:outgoing>SF_SplitDevContent</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway: Split Dev & Content -->
    <bpmn:parallelGateway id="PgSplitDevContent" name="Start Development and Draft">
      <bpmn:incoming>SF_SplitDevContent</bpmn:incoming>
      <bpmn:outgoing>SF_PathDevelopment</bpmn:outgoing>
      <bpmn:outgoing>SF_PathInitialDraft</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Design and Development -->
    <bpmn:task id="TskDesignDev" name="Website Design &amp; Development">
      <bpmn:incoming>SF_PathDevelopment</bpmn:incoming>
      <bpmn:outgoing>SF_DevelopmentCompleteToMerge</bpmn:outgoing>
    </bpmn:task>

    <!-- User Task: Initial Content Draft -->
    <bpmn:userTask id="TskInitialDraft" name="Prepare Initial Content Draft">
      <bpmn:incoming>SF_PathInitialDraft</bpmn:incoming>
      <bpmn:outgoing>SF_DraftToReviewCheck</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway: Review Needed? -->
    <bpmn:exclusiveGateway id="GwReviewNeeded" name="Content Review Required?">
      <bpmn:incoming>SF_DraftToReviewCheck</bpmn:incoming>
      <bpmn:outgoing>SF_NoMarketingSkip</bpmn:outgoing>
      <bpmn:outgoing>SF_YesMarketingReview</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- User Task: Marketing Review -->
    <bpmn:userTask id="TskContentReview" name="Conduct Content Review">
      <bpmn:incoming>SF_YesMarketingReview</bpmn:incoming>
      <bpmn:outgoing>SF_ReviewToFinalizeContent</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Finalize Content -->
    <bpmn:task id="TskFinalizeContent" name="Create Final Version of Content">
      <bpmn:incoming>SF_NoMarketingSkip</bpmn:incoming>
      <bpmn:incoming>SF_ReviewToFinalizeContent</bpmn:incoming>
      <bpmn:outgoing>SF_ContentCompleteToMerge</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway: Merge Dev & Content -->
    <bpmn:parallelGateway id="PgMergeComplete" name="Both Complete">
      <bpmn:incoming>SF_DevelopmentCompleteToMerge</bpmn:incoming>
      <bpmn:incoming>SF_ContentCompleteToMerge</bpmn:incoming>
      <bpmn:outgoing>SF_MergeToBuildSite</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Build Website -->
    <bpmn:task id="TskBuildSite" name="Build and Review Website">
      <bpmn:incoming>SF_MergeToBuildSite</bpmn:incoming>
      <bpmn:outgoing>SF_BuiltToApprovalCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Site Approved? -->
    <bpmn:exclusiveGateway id="GwApproved" name="Site Approved?">
      <bpmn:incoming>SF_BuiltToApprovalCheck</bpmn:incoming>
      <bpmn:outgoing>SF_ApprovedEndProcess</bpmn:outgoing>
      <bpmn:outgoing>SF_NotApprovedRebuild</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SF_StartToMeetingCheck" sourceRef="StartEvent_Meeting" targetRef="GwMeetingSuccess"/>
    
    <bpmn:sequenceFlow id="SF_YesStoryboard" name="Successful Meeting" sourceRef="GwMeetingSuccess" targetRef="TskStoryboard">
      <bpmn:name>yes</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SF_NoEndProcess" name="Unsuccessful Meeting" sourceRef="GwMeetingSuccess" targetRef="EndEvent_ProcessFailed"/>

    <bpmn:sequenceFlow id="SF_SplitDevContent" name="Storyboard Agreed" sourceRef="TskStoryboard" targetRef="PgSplitDevContent"/>
    
    <bpmn:sequenceFlow id="SF_PathDevelopment" name="" sourceRef="PgSplitDevContent" targetRef="TskDesignDev">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SF_PathInitialDraft" name="" sourceRef="PgSplitDevContent" targetRef="TskInitialDraft"/>
    
    <bpmn:sequenceFlow id="SF_DraftToReviewCheck" name="" sourceRef="TskInitialDraft" targetRef="GwReviewNeeded">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SF_NoMarketingSkip" name="No Review Needed" sourceRef="GwReviewNeeded" targetRef="TskFinalizeContent"/>
    
    <bpmn:sequenceFlow id="SF_YesMarketingReview" name="Review Required" sourceRef="GwReviewNeeded" targetRef="TskContentReview">
      <bpmn:name>yes</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SF_ReviewToFinalizeContent" name="" sourceRef="TskContentReview" targetRef="TskFinalizeContent"/>

    <bpmn:sequenceFlow id="SF_DevelopmentCompleteToMerge" name="" sourceRef="TskDesignDev" targetRef="PgMergeComplete">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SF_ContentCompleteToMerge" name="" sourceRef="TskFinalizeContent" targetRef="PgMergeComplete"/>

    <bpmn:sequenceFlow id="SF_MergeToBuildSite" name="Both Complete" sourceRef="PgMergeComplete" targetRef="TskBuildSite"/>
    
    <bpmn:sequenceFlow id="SF_BuiltToApprovalCheck" name="" sourceRef="TskBuildSite" targetRef="GwApproved">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SF_ApprovedEndProcess" name="Yes - Approved" sourceRef="GwApproved" targetRef="EndEvent_Completed"/>
    
    <bpmn:sequenceFlow id="SF_NotApprovedRebuild" name="No - Not Approved (Loop Back)" sourceRef="GwApproved" targetRef="TskBuildSite">
      <bpmn:name>no</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>