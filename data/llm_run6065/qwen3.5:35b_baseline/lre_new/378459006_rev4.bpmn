<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_SSP_Payment_Process">
    <bpmn:participant id="Participant_SSP_Org" name="SSP Organization" processRef="Process_SPP_1" />
  </bpmn:collaboration>

  <bpmn:process id="Process_SPP_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_PaymentOffice" name="Payment Office of SSP">
        <bpmn:flowNodeRef>StartEvent_Timer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GenerateReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PayVendor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DistributeReports</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_AccountsReceivable" name="Accounts Receivable Department">
        <bpmn:flowNodeRef>Task_GenerateMonthlyInvoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ChargeAndNotifyClient</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_RegistryOffice" name="Registry Office">
        <bpmn:flowNodeRef>Task_SelectPaidInvoices</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ArchiveInvoices</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TrackPayment</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Client" name="Client">
        <bpmn:flowNodeRef>EndEvent_ClientsNotified</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_Timer" name="Weekly Trigger">
      <bpmn:timerEventDefinition />
      <bpmn:outgoing>SequenceFlow_GenReport</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:endEvent id="EndProcess_Complete" name="Payment Process Complete">
      <bpmn:incoming>SequenceFlow_MergeComplete</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_ClientsNotified" name="Clients Notified">
      <bpmn:incoming>SequenceFlow_ClientSendDone</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:task id="Task_GenerateReport" name="Generate Payment Report">
      <bpmn:incoming>SequenceFlow_GenReport</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PayVendor</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_PayVendor" name="Pay Vendor">
      <bpmn:incoming>SequenceFlow_PayVendor</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DistributeStart</bpmn:outgoing>
    </bpmn:task>

    <bpmn:parallelGateway id="Gateway_DistributeReports">
      <bpmn:incoming>SequenceFlow_DistributeStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendToClient</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SendToRegistry</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SendToAR</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:task id="Task_SendToClient" name="Send Report &amp; Invoice to Clients">
      <bpmn:incoming>SequenceFlow_SendToClient</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ClientSendDone</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_GenReport" sourceRef="StartEvent_Timer" targetRef="Task_GenerateReport">
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_PayVendor" name="" sourceRef="Task_GenerateReport" targetRef="Task_PayVendor">
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_DistributeStart" name="" sourceRef="Task_PayVendor" targetRef="Gateway_DistributeReports">
    </bpmn:sequenceFlow>

    <bpmn:task id="Task_SendToRegistry" name="Send Report to Registry Office">
      <bpmn:incoming>SequenceFlow_SendToRegistry</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RegistryStartTasks</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_SendToClient" name="" sourceRef="Gateway_DistributeReports" targetRef="Task_SendToClient">
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_SendToRegistry" name="" sourceRef="Gateway_DistributeReports" targetRef="Task_SendToRegistry">
    </bpmn:sequenceFlow>

    <bpmn:task id="Task_SendToAR" name="Send Report to Accounts Receivable Dept">
      <bpmn:incoming>SequenceFlow_SendToAR</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ARStartTasks</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_SendToAR" name="" sourceRef="Gateway_DistributeReports" targetRef="Task_SendToAR">
    </bpmn:sequenceFlow>

    <!-- Accounts Receivable Lane Tasks -->
    <bpmn:task id="Task_GenerateMonthlyInvoice" name="Generate Monthly Invoice for Clients">
      <bpmn:incoming>SequenceFlow_ARStartTasks</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ChargeNotify</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_ARStartTasks" name="" sourceRef="Task_SendToAR" targetRef="Task_GenerateMonthlyInvoice">
    </bpmn:sequenceFlow>

    <bpmn:task id="Task_ChargeAndNotifyClient" name="Charge $35 &amp; Notify Client">
      <bpmn:incoming>SequenceFlow_ChargeNotify</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ARComplete</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_ChargeNotify" name="" sourceRef="Task_GenerateMonthlyInvoice" targetRef="Task_ChargeAndNotifyClient">
    </bpmn:sequenceFlow>

    <!-- Registry Office Lane Tasks -->
    <bpmn:task id="Task_SelectPaidInvoices" name="Select Paper-based Paid Invoices">
      <bpmn:incoming>SequenceFlow_RegistryStartTasks</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ArchivePath</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_RegistryStartTasks" name="" sourceRef="Task_SendToRegistry" targetRef="Task_SelectPaidInvoices">
    </bpmn:sequenceFlow>

    <bpmn:task id="Task_ArchiveInvoices" name="Archive Invoices (Vendor &amp; Payment Data)">
      <bpmn:incoming>SequenceFlow_ArchivePath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TrackPaymentStart</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_ArchivePath" name="" sourceRef="Task_SelectPaidInvoices" targetRef="Task_ArchiveInvoices">
    </bpmn:sequenceFlow>

    <bpmn:task id="Task_TrackPayment" name="Track Down Payment">
      <bpmn:incoming>SequenceFlow_TrackPaymentStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RegistryComplete</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_TrackPaymentStart" name="" sourceRef="Task_ArchiveInvoices" targetRef="Task_TrackPayment">
    </bpmn:sequenceFlow>

    <!-- Merging Flows -->
    <bpmn:parallelGateway id="Gateway_MergeComplete">
      <bpmn:incoming>SequenceFlow_ClientSendDone</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ARComplete</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_RegistryComplete</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeComplete</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:sequenceFlow id="SequenceFlow_ClientSendDone" name="" sourceRef="Task_SendToClient" targetRef="EndEvent_ClientsNotified">
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ARComplete" name="" sourceRef="Task_ChargeAndNotifyClient" targetRef="Gateway_MergeComplete">
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_RegistryComplete" name="" sourceRef="Task_TrackPayment" targetRef="Gateway_MergeComplete">
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_MergeComplete" name="" sourceRef="Gateway_MergeComplete" targetRef="EndProcess_Complete">
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>