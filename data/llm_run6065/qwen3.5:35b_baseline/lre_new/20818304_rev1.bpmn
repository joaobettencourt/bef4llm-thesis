<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_CreditProcess">
    <bpmn:participant id="Participant_CreditCompany" name="Credit Company Process" processRef="Process_CreditApproval" />
  </bpmn:collaboration>

  <bpmn:process id="Process_CreditApproval" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Assessment" name="Credit Assessment Team">
        <bpmn:flowNodeRef>LaneStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TaskCollectInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GwAmountCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TaskAssessRisk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GwRiskLevel</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Approval" name="Approval Management">
        <bpmn:flowNodeRef>TaskRequestApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GwDecisionOutcome</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_CustomerService" name="Customer Service">
        <bpmn:flowNodeRef>TaskSendEmailNotification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GwDirectAcceptanceMerge</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:endEvent id="EndEvent_CreditRejected" name="Credit Rejected">
        <bpmn:incoming>SequenceFlow_RejectToEmail</bpmn:incoming>
      </bpmn:endEvent>

      <bpmn:endEvent id="EndEvent_CreditAccepted" name="Credit Accepted">
        <bpmn:incoming>SequenceFlow_AcceptToEmail</bpmn:incoming>
      </bpmn:endEvent>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_ReceiveInfo" name="Receive Credit Information">
      <bpmn:outgoing>SequenceFlow_StartCollect</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="TaskCollectInfo" name="Collect Customer Data">
      <bpmn:incoming>SequenceFlow_StartCollect</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CollectToAmountCheck</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="GwAmountCheck" name="Requested Amount &gt; $1M?">
      <bpmn:incoming>SequenceFlow_CollectToAmountCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AmountHighPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_AmountLowPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="TaskRequestApproval" name="Request Approval">
      <bpmn:incoming>SequenceFlow_HighAmountToReqApprove</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_RiskHighPathToReqApprove</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReqApprovalToDecision</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="TaskAssessRisk" name="Assess Credit Risk">
      <bpmn:incoming>SequenceFlow_AmountLowPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AssessToRiskCheck</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="GwDecisionOutcome" name="Approval Decision">
      <bpmn:incoming>SequenceFlow_ReqApprovalToDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ApprovedPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RejectedPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:exclusiveGateway id="GwRiskLevel" name="Risk Level High?">
      <bpmn:incoming>SequenceFlow_AssessToRiskCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RiskHighPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RiskLowPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="TaskSendEmailNotification" name="Send Email Notification">
      <bpmn:incoming>SequenceFlow_AcceptToEmail</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_RejectToEmail</bpmn:incoming>
    </bpmn:userTask>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartCollect" sourceRef="StartEvent_ReceiveInfo" targetRef="TaskCollectInfo">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_CollectToAmountCheck" sourceRef="TaskCollectInfo" targetRef="GwAmountCheck">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_AmountHighPath" name="Yes (&gt; $1M)" sourceRef="GwAmountCheck" targetRef="TaskRequestApproval">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_RiskHighPathToReqApprove" name="Yes (High Risk)" sourceRef="GwRiskLevel" targetRef="TaskRequestApproval">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_AmountLowPath" name="No (<= $1M)" sourceRef="GwAmountCheck" targetRef="TaskAssessRisk">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_AssessToRiskCheck" sourceRef="TaskAssessRisk" targetRef="GwRiskLevel">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_RiskLowPath" name="No (Low Risk)" sourceRef="GwRiskLevel" targetRef="EndEvent_CreditAccepted">
       <!-- Direct acceptance path -->
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ReqApprovalToDecision" sourceRef="TaskRequestApproval" targetRef="GwDecisionOutcome">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ApprovedPath" name="Approved" sourceRef="GwDecisionOutcome" targetRef="EndEvent_CreditAccepted">
       <!-- Merging to acceptance flow -->
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_RejectedPath" name="Rejected" sourceRef="GwDecisionOutcome" targetRef="EndEvent_CreditRejected">
       <!-- Merging to rejection flow -->
      <bpmn:name/>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>