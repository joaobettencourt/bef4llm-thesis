<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_OrgCustomer">
    <bpmn:participant id="Participant_ProvisionTeam" name="Provision Team Organization" processRef="Process_ProvisionTeam" />
    <bpmn:participant id="Participant_Customer" name="Customer" processRef="Process_Customer" />
  </bpmn:collaboration>

  <!-- Process for Provision Team -->
  <bpmn:process id="Process_ProvisionTeam" isExecutable="false">
    
    <!-- Start Event (Receiving Request) -->
    <bpmn:startEvent id="Start_ReceiveRequest" name="Receive Customer Request">
      <bpmn:outgoing>SequenceFlow_IdentifyParts</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Identify Parts -->
    <bpmn:task id="Task_IdentifyParts" name="Identify Necessary Parts">
      <bpmn:incoming>SequenceFlow_IdentifyParts</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_QuestionsCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Questions? -->
    <bpmn:exclusiveGateway id="Gateway_HaveQuestions" name="Have questions about request?">
      <bpmn:incoming>SequenceFlow_QuestionsCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AskCustomerYes</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CheckAvailabilityNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Intermediate Throw Event (Ask Info) -->
    <bpmn:intermediateThrowEvent id="Event_AskInfo" name="Request More Information">
      <bpmn:incoming>SequenceFlow_AskCustomerYes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitForReply</bpmn:outgoing>
    </bpmn:endThrowEvent>

    <!-- Intermediate Catch Event (Wait for Reply) -->
    <bpmn:intermediateCatchEvent id="Event_ReceiveReply" name="Receive Customer Reply">
      <bpmn:incoming>SequenceFlow_WaitForCustomer</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CheckAvailabilityNo2</bpmn:outgoing>
    </bpmn:endCatchEvent>

    <!-- Task: Check Availability -->
    <bpmn:task id="Task_CheckStock" name="Check Part Availability">
      <bpmn:incoming>SequenceFlow_CheckAvailabilityNo</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AvailabilityDecision</bpmn:outgoing>
    </bpmn:endCatchEvent>

    <!-- Gateway: Parts Available? -->
    <bpmn:exclusiveGateway id="Gateway_PartsAvailable" name="All parts available?">
      <bpmn:incoming>SequenceFlow_AvailabilityDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SupplyItemsYes</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_OrderDaisukiNo</bpmn:outgoing>
    </bpmn:endCatchEvent>

    <!-- Task: Supply Items -->
    <bpmn:task id="Task_SupplyItems" name="Supply Parts to Customer">
      <bpmn:incoming>SequenceFlow_SupplyItemsYes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndSuccess</bpmn:outgoing>
    </bpmn:endCatchEvent>

    <!-- End Event (Success) -->
    <bpmn:endEvent id="End_Success" name="Order Fulfilled">
      <bpmn:incoming>SequenceFlow_EndSuccess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task: Record Petition & Order Daisuki (Sequential) -->
    <bpmn:task id="Task_RecordPetition" name="Record Petition">
      <bpmn:incoming>SequenceFlow_OrderDaisukiNo</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_OrderDaisukiNext</bpmn:outgoing>
    </bpmn:endCatchEvent>

    <!-- Task: Order Daisuki -->
    <bpmn:task id="Task_OrderDaisuki" name="Order from Daisuki">
      <bpmn:incoming>SequenceFlow_OrderDaisukiNext</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_WaitCollection</bpmn:outgoing>
    </bpmn:endCatchEvent>

    <!-- Intermediate Catch Event (Wait for Collection) -->
    <bpmn:startEvent id="Start_PartsCollected" name="Parts Collected">
      <bpmn:incoming>SequenceFlow_WaitCollection</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ContactCustomerMsg</bpmn:outgoing>
    </bpmn:endCatchEvent>

    <!-- Task: Contact Customer -->
    <bpmn:startEvent id="Start_ContactCustomer" name="Notify Collection Ready">
      <bpmn:incoming>SequenceFlow_ContactCustomerMsg</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_WaitPayment</bpmn:outgoing>
    </bpmn:endCatchEvent>

    <!-- Intermediate Catch Event (Wait for Payment/Recollection) -->
    <bpmn:startEvent id="Start_PaymentReceived" name="Receive Final Payment">
      <bpmn:incoming>SequenceFlow_WaitPayment</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_EndSuccess2</bpmn:outgoing>
    </bpmn:endCatchEvent>

    <!-- End Event (Final) -->
    <bpmn:endEvent id="End_PaymentReceived" name="Payment Received">
      <bpmn:incoming>SequenceFlow_EndSuccess2</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>

  <!-- Process for Customer -->
  <bpmn:process id="Process_Customer" isExecutable="false">
    
    <bpmn:startEvent id="StartCustomer_RequestSent" name="Send Request">
      <bpmn:outgoing>SequenceFlow_Cust_SendRequest</bpmn:outgoing>
    </bpmn:endCatchEvent>

  </bpmn:process>

</bpmn:definitions>