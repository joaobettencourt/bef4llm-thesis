<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_ACMEProcurement" name="ACME Inc Procurement Process" processRef="Process_1" />
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    
    <!-- Lane Definitions -->
    <bpmn:laneSet>
      <bpmn:lane id="Lane_RequestingDept" name="Requesting Department">
        <bpmn:flowNodeRef>StartEvent_Demand</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_StockCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DefineGoods</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Fulfilled</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Procurement" name="Central Procurement">
        <bpmn:flowNodeRef>Task_CreateRequisition</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SupplierCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckSupplierInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateNewSupplier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SupplierReady</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateOrderTemplate</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Approver" name="Approver">
        <bpmn:flowNodeRef>Gateway_OrderReady</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ApproveOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_POTriggered</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Demand" name="Demand Identified">
      <bpmn:outgoing>SequenceFlow_StartToStockCheck</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_Fulfilled" name="Local Consumption">
      <bpmn:incoming>SequenceFlow_StockSufficient</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_POTriggered" name="Purchase Order Triggered">
      <bpmn:incoming>SequenceFlow_ApprovalComplete</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Tasks -->
    <bpmn:task id="Task_DefineGoods" name="Define Goods &amp; Amounts">
      <bpmn:incoming>SequenceFlow_NoStockAvailable</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GoodsDefinedToRequisition</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_CreateRequisition" name="Create Purchase Requisition (ERP)">
      <bpmn:incoming>SequenceFlow_GoodsDefinedToRequisition</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReqCreatedToCheckSupplier</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_CheckSupplierInfo" name="Check Supplier Info (ERP)">
      <bpmn:incoming>SequenceFlow_ReqCreatedToCheckSupplier</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SupplierCheckedToGateway</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_CreateNewSupplier" name="Create New Supplier (ERP)">
      <bpmn:incoming>SequenceFlow_NewSupplierPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SupplierCreatedToMerge</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_CreateOrderTemplate" name="Create Order Template (ERP)">
      <bpmn:incoming>SequenceFlow_MergeSupplierReady</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TemplateToApprovalGateway</bpmn:outgoing>
    </bpmn:task>

    <bpmn:userTask id="Task_ApproveOrder" name="Approve &amp; Trigger Purchase Order">
      <bpmn:incoming>SequenceFlow_TemplateToApprovalGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ApprovalComplete</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateways -->
    <bpmn:exclusiveGateway id="Gateway_StockCheck" name="Sufficient Stock?">
      <bpmn:incoming>SequenceFlow_StartToStockCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StockSufficient</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoStockAvailable</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:exclusiveGateway id="Gateway_SupplierCheck" name="New Supplier?">
      <bpmn:incoming>SequenceFlow_SupplierCheckedToGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NewSupplierPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ExistingSupplierPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Merging Gateways -->
    <bpmn:inclusiveGateway id="Gateway_SupplierReady" name="Merge Supplier Status">
      <bpmn:incoming>SequenceFlow_SupplierCreatedToMerge</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ExistingSupplierPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeSupplierReady</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Approval Handover Gateway -->
    <bpmn:exclusiveGateway id="Gateway_OrderReady" name="Order Ready?">
       <bpmn:incoming>SequenceFlow_TemplateToApprovalGateway</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_ApprovalComplete</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToStockCheck" sourceRef="StartEvent_Demand" targetRef="Gateway_StockCheck">
      <bpmn:name>Demand Identified</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_NoStockAvailable" name="No - Insufficient Stock" sourceRef="Gateway_StockCheck" targetRef="Task_DefineGoods">
      <bpmn:description>No</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_GoodsDefinedToRequisition" name="Define Goods &amp; Amounts" sourceRef="Task_DefineGoods" targetRef="Task_CreateRequisition">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceStockSufficient" name="Yes - Sufficient Stock" sourceRef="Gateway_StockCheck" targetRef="EndEvent_Fulfilled">
       <bpmn:description>Yes</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ReqCreatedToCheckSupplier" name="Requisition Created" sourceRef="Task_CreateRequisition" targetRef="Task_CheckSupplierInfo">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_SupplierCheckedToGateway" name="Check Info Complete" sourceRef="Task_CheckSupplierInfo" targetRef="Gateway_SupplierCheck">
       <bpmn:description/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_NewSupplierPath" name="Yes - New Supplier" sourceRef="Gateway_SupplierCheck" targetRef="Task_CreateNewSupplier">
      <bpmn:description>New</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ExistingSupplierPath" name="No - Known Supplier" sourceRef="Gateway_SupplierCheck" targetRef="Gateway_SupplierReady">
      <bpmn:description>Known</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_SupplierCreatedToMerge" name="Supplier Created" sourceRef="Task_CreateNewSupplier" targetRef="Gateway_SupplierReady">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_MergeSupplierReady" name="Proceed to Order Template" sourceRef="Gateway_SupplierReady" targetRef="Task_CreateOrderTemplate">
       <bpmn:description/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_TemplateToApprovalGateway" name="Create Order Template" sourceRef="Task_CreateOrderTemplate" targetRef="Gateway_OrderReady">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <!-- Data Objects -->
    <bpmn:dataObjectReference id="Data_PurchaseRequisition" name="Purchase Requisition"/>
    <bpmn:dataObjectReference id="Data_SupplierInfo" name="Supplier Information"/>
    <bpmn:dataObjectReference id="Data_OrderTemplate" name="Order Template"/>

    <!-- Associations -->
    <bpmn:association id="Assoc_ReqCreate">
      <bpmn:sourceRef>Task_CreateRequisition</bpmn:sourceRef>
      <bpmn:targetRef>Data_PurchaseRequisition</bpmn:targetRef>
    </bpmn:association>

    <bpmn:association id="Assoc_SupplierCheck">
      <bpmn:sourceRef>Task_CheckSupplierInfo</bpmn:sourceRef>
      <bpmn:targetRef>Data_SupplierInfo</bpmn:targetRef>
    </bpmn:association>

    <bpmn:association id="Assoc_OrderTemplate">
      <bpmn:sourceRef>Task_CreateOrderTemplate</bpmn:sourceRef>
      <bpmn:targetRef>Data_OrderTemplate</bpmn:targetRef>
    </bpmn:association>

  </bpmn:process>
</bpmn:definitions>