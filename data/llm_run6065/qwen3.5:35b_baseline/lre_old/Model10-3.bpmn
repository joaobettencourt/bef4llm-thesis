<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_DeregistrationProcess">
    <bpmn:participant name="Deregistration Process" processRef="Proc_DeregisterMPOO"/>
  </bpmn:collaboration>

  <bpmn:process id="Proc_DeregisterMPOO" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Deregistration Request by MPOO">
      <bpmn:outgoing>SequenceFlow_StartToVerify</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1 -->
    <bpmn:task id="Task_Verify" name="GO verifies deregistration">
      <bpmn:incoming>SequenceFlow_StartToVerify</bpmn:incoming>
      <bpmn:outgoing>Gateway_DecisionRejectConfirm</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1 - Decision -->
    <bpmn:exclusiveGateway id="Gateway_DecisionRejectConfirm" name="Decision">
      <bpmn:incoming>Task_Verify</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RejectPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ConfirmPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event - Rejected -->
    <bpmn:endEvent id="EndEvent_Reject" name="Deregistration Rejected">
      <bpmn:incoming>SequenceFlow_RejectPath</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task 2 - Confirm Path -->
    <bpmn:task id="Task_PrepareReadmission" name="GO prepares readmission of measuring point">
      <bpmn:incoming>SequenceFlow_ConfirmPath</bpmn:incoming>
      <bpmn:outgoing>Gateway_ObligationDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2 - Optional Obligation Decision -->
    <bpmn:exclusiveGateway id="Gateway_ObligationDecision" name="Obliged to continue operations?">
      <bpmn:incoming>Task_PrepareReadmission</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BindPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoBindPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 3 - Bind Path -->
    <bpmn:task id="Task_BindMPOO" name="GO binds MPOO to continue operations">
      <bpmn:incoming>SequenceFlow_BindPath</bpmn:incoming>
      <bpmn:outgoing>Gateway_MergeAfterBind</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 4 - MPOO Confirmation -->
    <bpmn:task id="Task_ConfirmContinuation" name="MPOO confirms continuation">
      <bpmn:incoming>Gateway_MergeAfterBind</bpmn:outgoing/>
      <bpmn:outgoing>SequenceFlow_EquipmentAcquisitionPath1</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 3 - Merge after obligation decision -->
    <bpmn:exclusiveGateway id="Gateway_MergeAfterBind" name="">
      <bpmn:incoming>Task_BindMPOO</bpmn:outgoing/>
      <bpmn:outgoing>SequenceFlow_EquipmentAcquisitionPath1</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Gateway 4 - Merge No Bind Path -->
    <bpmn:exclusiveGateway id="Gateway_MergeNoBind" name="">
      <bpmn:incoming>SequenceFlow_NoBindPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EquipmentAcquisitionPath2</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 5 - Equipment Acquisition -->
    <bpmn:task id="Task_Equipment" name="GO performs equipment acquisition and/or changes">
      <bpmn:incoming>SequenceFlow_EquipmentAcquisitionPath1</bpmn:incoming/>
      <bpmn:incoming>SequenceFlow_EquipmentAcquisitionPath2</bpmn:incoming/>
      <bpmn:outgoing>Gateway_AssignMPO</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 5 - Merge before assignment -->
    <bpmn:exclusiveGateway id="Gateway_MergeBeforeAssign" name="">
      <bpmn:incoming>Task_ConfirmContinuation</bpmn:outgoing/>
      <bpmn:outgoing>SequenceFlow_AssignMPOPath1</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Gateway 6 - Merge No Bind Path -->
    <bpmn:exclusiveGateway id="Gateway_MergeNoBind2" name="">
      <bpmn:incoming>SequenceFlow_NoBindPath</bpmn:incoming/>
      <bpmn:outgoing>SequenceFlow_AssignMPOPath2</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 6 - Assign GO as MPO -->
    <bpmn:task id="Task_AssignGO" name="Assign GO as new MPO">
      <bpmn:incoming>SequenceFlow_EquipmentAcquisitionPath1</bpmn:incoming/>
      <bpmn:incoming>SequenceFlow_EquipmentAcquisitionPath2</bpmn:incoming/>
      <bpmn:outgoing>Gateway_InformMPOO</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 7 - Merge before informing -->
    <bpmn:exclusiveGateway id="Gateway_MergeBeforeInform" name="">
      <bpmn:incoming>Task_ConfirmContinuation</bpmn:outgoing/>
      <bpmn:outgoing>SequenceFlow_InformMPOOPart1</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 7 - Inform MPOO -->
    <bpmn:task id="Task_InformMPOO" name="Inform MPOO about end/start of assignment">
      <bpmn:incoming>SequenceFlow_AssignGOPath1</bpmn:incoming/>
      <bpmn:incoming>SequenceFlow_AssignGOPath2</bpmn:incoming/>
      <bpmn:outgoing>Gateway_InformMSPOSP</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 8 - Merge before informing MSPO/SP -->
    <bpmn:exclusiveGateway id="Gateway_MergeBeforeInform2" name="">
      <bpmn:incoming>Task_ConfirmContinuation</bpmn:outgoing/>
      <bpmn:outgoing>SequenceFlow_InformMSPOSPPart1</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 8 - Inform MSPO -->
    <bpmn:task id="Task_InformMSPO" name="Inform MSPO about assignment of GO">
      <bpmn:incoming>SequenceFlow_AssignGOPath1</bpmn:incoming/>
      <bpmn:incoming>SequenceFlow_AssignGOPath2</bpmn:incoming/>
      <bpmn:outgoing>Gateway_InformSPFinal</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 9 - Merge before informing SP -->
    <bpmn:exclusiveGateway id="Gateway_MergeBeforeInform3" name="">
      <bpmn:incoming>Task_ConfirmContinuation</bpmn:outgoing/>
      <bpmn:outgoing>SequenceFlow_InformSPFinalPart1</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 9 - Inform SP -->
    <bpmn:task id="Task_InformSP" name="Inform SP about assignment of GO">
      <bpmn:incoming>SequenceFlow_AssignGOPath1</bpmn:incoming/>
      <bpmn:incoming>SequenceFlow_AssignGOPath2</bpmn:incoming/>
      <bpmn:outgoing>EndEvent_Complete</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event - Complete -->
    <bpmn:endEvent id="EndEvent_Complete" name="Process Completed">
      <bpmn:incoming>SequenceFlow_InformSPFinalPart1</bpmn:incoming/>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToVerify" sourceRef="StartEvent_1" targetRef="Task_Verify"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_RejectPath" name="Reject Deregistration" sourceRef="Gateway_DecisionRejectConfirm" targetRef="EndEvent_Reject"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ConfirmPath" name="Preliminarily Confirm" sourceRef="Gateway_DecisionRejectConfirm" targetRef="Task_PrepareReadmission"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_BindPath" name="Yes - Bind MPOO" sourceRef="Gateway_ObligationDecision" targetRef="Task_BindMPOO"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_NoBindPath" name="No Obligation" sourceRef="Gateway_ObligationDecision" targetRef="Task_ConfirmContinuation"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_EquipmentAcquisitionPath1" sourceRef="Gateway_MergeAfterBind" targetRef="Task_Equipment"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_EquipmentAcquisitionPath2" sourceRef="Gateway_MergeNoBind" targetRef="Task_Equipment"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_AssignMPOPath1" sourceRef="Gateway_MergeBeforeAssign" targetRef="Task_AssignGO"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_AssignMPOPath2" sourceRef="Gateway_MergeNoBind2" targetRef="Task_AssignGO"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_InformMPOOPart1" sourceRef="Gateway_MergeBeforeInform" targetRef="Task_InformMPOO"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_InformMSPOSPPart1" sourceRef="Gateway_MergeBeforeInform2" targetRef="Task_InformMSPO"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_InformSPFinalPart1" name="" sourceRef="Gateway_MergeBeforeInform3" targetRef="EndEvent_Complete"/>

  </bpmn:process>
</bpmn:definitions>