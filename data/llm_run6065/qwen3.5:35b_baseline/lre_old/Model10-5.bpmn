<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_DeviceTakeover">
    <bpmn:participant id="Participant_Mpon" name="MPON" processRef="Process_Mpon"/>
    <bpmn:participant id="Participant_Mpoo" name="MPOO" processRef="Process_Mpoa"/>

    <!-- Message Flows -->
    <bpmn:messageFlow id="MsgFlow_RequestBid" sourceRef="Task_ReqBid" targetRef="Event_CatchRequest"/>
    <bpmn:messageFlow id="MsgFlow_TenderOffer" sourceRef="Task_SendTender" targetRef="Event_MponCatchTender"/>
    <bpmn:messageFlow id="MsgFlow_OrderPlacement" sourceRef="Task_PlaceOrder" targetRef="Event_CatchOrder"/>
    <bpmn:messageFlow id="MsgFlow_Confirmation" sourceRef="Task_SendConfirmation" targetRef="Event_MponCatchConfirm"/>

    <!-- Messages -->
    <bpmn:message id="Message_RequestBid" name="Device Takeover Bid Request"/>
    <bpmn:message id="Message_TenderOffer" name="Tender Offer"/>
    <bpmn:message id="Message_OrderPlacement" name="Order Placement"/>
    <bpmn:message id="Message_Confirmation" name="Confirmation &amp; Master Data"/>

  </bpmn:collaboration>

  <!-- MPON Process -->
  <bpmn:process id="Process_Mpon">
    <bpmn:startEvent id="Start_ReqBidInitiate">
      <bpmn:outgoing>Sequence_StartToTask</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_ReqBid" name="Request Device Takeover Bid">
      <bpmn:incoming>Sequence_StartToTask</bpmn:incoming>
      <bpmn:messageRef>bpmn:Message_RequestBid</bpmn:messageRef>
    </bpmn:task>

    <bpmn:intermediateCatchEvent id="Event_MponCatchTender" name="Receive Tender">
      <bpmn:incoming>Sequence_TenderReceived</bpmn:incoming>
      <bpmn:outgoing>Sequence_OrderFlow</bpmn:outgoing>
      <bpmn:messageRef>bpmn:Message_TenderOffer</bpmn:messageRef>
    </bpmn:intermediateCatchEvent>

    <bpmn:task id="Task_PlaceOrder" name="Place Order at MPOO">
      <bpmn:incoming>Sequence_OrderFlow</bpmn:incoming>
      <bpmn:outgoing>Sequence_SendOrderMsg</bpmn:outgoing>
    </bpmn:task>

    <bpmn:intermediateCatchEvent id="Event_MponCatchConfirm" name="Receive Confirmation &amp; Data">
      <bpmn:incoming>Sequence_ConfirmReceived</bpmn:incoming>
      <bpmn:messageRef>bpmn:Message_Confirmation</bpmn:messageRef>
    </bpmn:intermediateCatchEvent>

    <bpmn:endEvent id="End_MponProcess" name="Order Process Complete">
      <bpmn:incoming>Sequence_EndFlow</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Sequence_StartToTask" sourceRef="Start_ReqBidInitiate" targetRef="Task_ReqBid"/>
    <bpmn:sequenceFlow id="Sequence_TenderReceived" name="Tender Received" sourceRef="Event_MponCatchTender" targetRef="Task_PlaceOrder">
      <!-- Note: Catch event triggers flow after message received -->
    </bpmn:sequenceFlow>

  </bpmn:process>

  <!-- MPOO Process -->
  <bpmn:process id="Process_Mpoa">
    <bpmn:startEvent id="Start_CatchRequest" name="Receive Bid Request">
      <bpmn:messageRef>bpmn:Message_RequestBid</bpmn:messageRef>
      <bpmn:outgoing>Sequence_SendTenderFlow</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_SendTender" name="Send Tender for Equipment Takeover">
      <bpmn:incoming>Sequence_SendTenderFlow</bpmn:incoming>
      <bpmn:messageRef>bpmn:Message_TenderOffer</bpmn:messageRef>
    </bpmn:task>

    <bpmn:intermediateCatchEvent id="Event_CatchOrder" name="Receive Order">
      <bpmn:incoming>Sequence_OrderReceivedFlow</bpmn:incoming>
      <bpmn:outgoing>Sequence_ConfirmationFlow</bpmn:outgoing>
      <bpmn:messageRef>bpmn:Message_OrderPlacement</bpmn:messageRef>
    </bpmn:intermediateCatchEvent>

    <bpmn:task id="Task_SendConfirmation" name="Confirm Order &amp; Send Master Data">
      <bpmn:incoming>Sequence_ConfirmationFlow</bpmn:incoming>
      <bpmn:messageRef>bpmn:Message_Confirmation</bpmn:messageRef>
    </bpmn:task>

    <bpmn:endEvent id="End_MpooProcess" name="Order Process Complete">
      <bpmn:incoming>Sequence_EndFlowMpoa</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Sequence_SendTenderFlow" sourceRef="Start_CatchRequest" targetRef="Task_SendTender"/>
    <bpmn:sequenceFlow id="Sequence_OrderReceivedFlow" name="Order Received" sourceRef="Event_CatchOrder" targetRef="Task_SendConfirmation">
      <!-- Note: Catch event triggers flow after message received -->
    </bpmn:sequenceFlow>

  </bpmn:process>

</bpmn:definitions>