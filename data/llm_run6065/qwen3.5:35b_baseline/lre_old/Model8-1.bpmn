<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_RecruitmentProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_Recruitment">
    <bpmn:participant name="Post Filling Process" processRef="Proc_01" />
  </bpmn:collaboration>

  <bpmn:process id="Proc_01" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_FunctionalDept" name="Functional Department">
        <bpmn:flowNodeRef>StartEvent_Demand</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_HR" name="Human Resources">
        <bpmn:flowNodeRef>Task_AdvertisePosition</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveApplications</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckApplications</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SuitableCandidate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConcludeContract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_PostFilled</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Demand" name="Demand for Post Filling">
      <bpmn:outgoing>SequenceFlow_StartToAdvertise</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Advertise -->
    <bpmn:task id="Task_AdvertisePosition" name="Post is Advertised">
      <bpmn:incoming>SequenceFlow_StartToAdvertise</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AdvToReceiveApps</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: Applicants Apply -->
    <bpmn:task id="Task_ReceiveApplications" name="Applicants Apply">
      <bpmn:incoming>SequenceFlow_AdvToReceiveApps</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AppsToCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3: Check Applications -->
    <bpmn:task id="Task_CheckApplications" name="Applications are Checked">
      <bpmn:incoming>SequenceFlow_AppsToCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckToGateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for Decision -->
    <bpmn:exclusiveGateway id="Gateway_SuitableCandidate" name="Suitable Candidate Found?">
      <bpmn:incoming>SequenceFlow_CheckToGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GatewayYesContract</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 4: Conclude Contract -->
    <bpmn:task id="Task_ConcludeContract" name="Conclude Employment Contract">
      <bpmn:incoming>SequenceFlow_GatewayYesContract</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ContractToEnd</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_PostFilled" name="Post Filled">
      <bpmn:incoming>SequenceFlow_ContractToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToAdvertise" sourceRef="StartEvent_Demand" targetRef="Task_AdvertisePosition">
      <bpmn:name>Demand Received</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_AdvToReceiveApps" sourceRef="Task_AdvertisePosition" targetRef="Task_ReceiveApplications">
      <bpmn:name>Advertisement Complete</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_AppsToCheck" sourceRef="Task_ReceiveApplications" targetRef="Task_CheckApplications">
      <bpmn:name>Applications Received</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_CheckToGateway" sourceRef="Task_CheckApplications" targetRef="Gateway_SuitableCandidate">
      <bpmn:name>Candidates Evaluated</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_GatewayYesContract" sourceRef="Gateway_SuitableCandidate" targetRef="Task_ConcludeContract">
      <bpmn:name>Suitable Candidate Found</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ContractToEnd" sourceRef="Task_ConcludeContract" targetRef="EndEvent_PostFilled">
      <bpmn:name>Contract Concluded</bpmn:name>
    </bpmn:sequenceFlow>
  </bpmn:process>
</bpmn:definitions>