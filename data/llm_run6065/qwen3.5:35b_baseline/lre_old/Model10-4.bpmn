<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_EquipmentChangeProcess">
    <bpmn:participant name="Equipment Change Process" processRef="Proc_EquipChange"/>
  </bpmn:collaboration>

  <bpmn:process id="Proc_EquipChange" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_MPON" name="MPON">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyIntent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DismountType</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MergeReading</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FinalReading</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DismountOldEquipment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MountNewDevice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReadMeterCount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendValuesToGO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TellGODetails</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_MPOO" name="MPOO">
        <bpmn:flowNodeRef>Task_AnnounceSelfDismounting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyNoSelfDismounting</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GO" name="GO">
        <bpmn:flowNodeRef>Task_NotifyMSPDetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Complete</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Initiate Equipment Change">
      <bpmn:outgoing>SequenceFlow_NotifyIntent</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- MPON Tasks & Gateways (Lane_MPON) -->
    <bpmn:task id="Task_NotifyIntent" name="Notify MPOO about equipment change intentions">
      <bpmn:incoming>SequenceFlow_NotifyIntent</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DismountTypeCheck</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_DismountType" name="Self Dismounting?">
      <bpmn:incoming>SequenceFlow_DismountTypeCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AnnounceSelf</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NotifyNoSelf</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- MPOO Tasks (Lane_MPOO) -->
    <bpmn:task id="Task_AnnounceSelfDismounting" name="Announces self dismounting to MPON">
      <bpmn:incoming>SequenceFlow_AnnounceSelf</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeReading1</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_NotifyNoSelfDismounting" name="Notify MPON about no self-dismounting">
      <bpmn:incoming>SequenceFlow_NotifyNoSelf</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeReading2</bpmn:outgoing>
    </bpmn:task>

    <!-- Merge Point (Lane_MPON) -->
    <bpmn:exclusiveGateway id="Gateway_MergeReading" name="Merge Reading Path">
      <bpmn:incoming>SequenceFlow_MergeReading1</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_MergeReading2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FinalReadingStart</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Field Tasks (Lane_MPON) -->
    <bpmn:task id="Task_FinalReading" name="Perform final reading">
      <bpmn:incoming>SequenceFlow_FinalReadingStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DismountOld</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_DismountOldEquipment" name="Dismount old equipment">
      <bpmn:incoming>SequenceFlow_DismountOld</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MountNewDevice</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_MountNewDevice" name="Mount new device">
      <bpmn:incoming>SequenceFlow_MountNewDevice</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReadMeterCount</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_ReadMeterCount" name="Read meter count from installed meter">
      <bpmn:incoming>SequenceFlow_ReadMeterCount</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendValuesToGO</bpmn:outgoing>
    </bpmn:task>

    <!-- Handover to GO (Lane_MPON) -->
    <bpmn:task id="Task_SendValuesToGO" name="Send values of final reading to GO">
      <bpmn:incoming>SequenceFlow_SendValuesToGO</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TellGODetails</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_TellGODetails" name="Tell GO about device changes, master data and meter count at installation">
      <bpmn:incoming>SequenceFlow_TellGODetails</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NotifyMSPTrigger</bpmn:outgoing>
    </bpmn:task>

    <!-- GO Task (Lane_GO) -->
    <bpmn:task id="Task_NotifyMSPDetails" name="Notify MSP about device changes, master data and meter counts">
      <bpmn:incoming>SequenceFlow_NotifyMSPTrigger</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndProcess</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event (Lane_GO) -->
    <bpmn:endEvent id="EndEvent_Complete" name="Equipment Change Process Complete">
      <bpmn:incoming>SequenceFlow_EndProcess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_NotifyIntent" sourceRef="StartEvent_1" targetRef="Task_NotifyIntent"/>
    <bpmn:sequenceFlow id="SequenceFlow_DismountTypeCheck" sourceRef="Task_NotifyIntent" targetRef="Gateway_DismountType"/>

    <!-- MPOO Branches -->
    <bpmn:sequenceFlow id="SequenceFlow_AnnounceSelf" name="Yes (Self Dismounting)" sourceRef="Gateway_DismountType" targetRef="Task_AnnounceSelfDismounting">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${selfDismonuting}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_NotifyNoSelf" name="No (Notify No Self)" sourceRef="Gateway_DismountType" targetRef="Task_NotifyNoSelfDismounting">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!selfDismonuting}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Merge -->
    <bpmn:sequenceFlow id="SequenceFlow_MergeReading1" sourceRef="Task_AnnounceSelfDismounting" targetRef="Gateway_MergeReading"/>
    <bpmn:sequenceFlow id="SequenceFlow_MergeReading2" sourceRef="Task_NotifyNoSelfDismounting" targetRef="Gateway_MergeReading"/>

    <!-- Field Operations -->
    <bpmn:sequenceFlow id="SequenceFlow_FinalReadingStart" sourceRef="Gateway_MergeReading" targetRef="Task_FinalReading"/>
    <bpmn:sequenceFlow id="SequenceFlow_DismountOld" sourceRef="Task_FinalReading" targetRef="Task_DismountOldEquipment"/>
    <bpmn:sequenceFlow id="SequenceFlow_MountNewDevice" sourceRef="Task_DismountOldEquipment" targetRef="Task_MountNewDevice"/>
    <bpmn:sequenceFlow id="SequenceFlow_ReadMeterCount" sourceRef="Task_MountNewDevice" targetRef="Task_ReadMeterCount"/>

    <!-- GO Handover -->
    <bpmn:sequenceFlow id="SequenceFlow_SendValuesToGO" sourceRef="Task_ReadMeterCount" targetRef="Task_SendValuesToGO"/>
    <bpmn:sequenceFlow id="SequenceFlow_TellGODetails" sourceRef="Task_SendValuesToGO" targetRef="Task_TellGODetails"/>

    <!-- MSP Notification -->
    <bpmn:sequenceFlow id="SequenceFlow_NotifyMSPTrigger" sourceRef="Task_TellGODetails" targetRef="Task_NotifyMSPDetails"/>
    <bpmn:sequenceFlow id="SequenceFlow_EndProcess" sourceRef="Task_NotifyMSPDetails" targetRef="EndEvent_Complete"/>

  </bpmn:process>
</bpmn:definitions>