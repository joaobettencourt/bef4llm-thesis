<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_TownPlanningAuthority">
    <bpmn:participant id="Participant_Authority" name="Town Planning Authority" processRef="Process_ScheduleCreation"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_ScheduleCreation" isExecutable="false">
    <bpmn:startEvent id="StartEvent_NovemberCycle" name="November Cycle Start">
      <bpmn:outgoing>SequenceFlow_DraftSchedule</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:laneSet>
      <bpmn:lane id="Lane_CoordUnit" name="Coordination Unit">
        <bpmn:flowNodeRef>Task_DraftSchedule</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ConflictCheck</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SupportOfficer" name="Support Officer">
        <bpmn:flowNodeRef>Task_CheckDates</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Task 1: Draft Schedule -->
    <bpmn:task id="Task_DraftSchedule" name="Draft Meeting Schedule">
      <bpmn:incoming>SequenceFlow_DraftSchedule</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SupportCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: Support Officer Check -->
    <bpmn:task id="Task_CheckDates" name="Check Dates &amp; Suggest Modifications">
      <bpmn:incoming>SequenceFlow_SupportCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RecheckConflicts</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3: Recheck Conflicts -->
    <bpmn:task id="Task_RecheckConflicts" name="Recheck Dates for Conflicts">
      <bpmn:incoming>SequenceFlow_RecheckConflicts</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendEmail</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 4: Send Email -->
    <bpmn:sendTask id="Task_SendSchedule" name="Send Final Schedule via Email">
      <bpmn:incoming>SequenceFlow_SendEmail</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitFeedback</bpmn:outgoing>
    </bpmn:sendTask>

    <!-- Intermediate Event: Wait for Committee Feedback -->
    <bpmn:intermediateCatchEvent id="Event_CatchFeedback" name="Receive Advice on Conflicts">
      <bpmn:incoming>SequenceFlow_WaitFeedback</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckConflictsAdvice</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Gateway: Check if Conflicts Advised? -->
    <bpmn:exclusiveGateway id="Gateway_ConflictCheck" name="Conflicts Advised?">
      <bpmn:incoming>SequenceFlow_CheckConflictsAdvice</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ResolveConflict</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_FinalizeSchedule</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_ScheduleFinalized" name="Schedule Finalized">
      <bpmn:incoming>SequenceFlow_FinalizeSchedule</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_DraftSchedule" sourceRef="StartEvent_NovemberCycle" targetRef="Task_DraftSchedule"/>
    <bpmn:sequenceFlow id="SequenceFlow_SupportCheck" sourceRef="Task_DraftSchedule" targetRef="Task_CheckDates">
      <bpmn:name>Support Officer Check</bpmn:name>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_RecheckConflicts" sourceRef="Task_CheckDates" targetRef="Task_RecheckConflicts"/>
    <bpmn:sequenceFlow id="SequenceFlow_SendEmail" sourceRef="Task_RecheckConflicts" targetRef="Task_SendSchedule">
      <bpmn:name>Send to Committee Members</bpmn:name>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_WaitFeedback" sourceRef="Task_SendSchedule" targetRef="Event_CatchFeedback"/>
    <bpmn:sequenceFlow id="SequenceFlow_CheckConflictsAdvice" sourceRef="Event_CatchFeedback" targetRef="Gateway_ConflictCheck">
      <bpmn:name>Receive Feedback</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Loop Back if Conflicts Advised -->
    <bpmn:sequenceFlow id="SequenceFlow_ResolveConflict" sourceRef="Gateway_ConflictCheck" targetRef="Task_RecheckConflicts">
      <bpmn:name>Yes</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- End Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_FinalizeSchedule" sourceRef="Gateway_ConflictCheck" targetRef="EndEvent_ScheduleFinalized">
      <bpmn:name>No</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>

</bpmn:definitions>