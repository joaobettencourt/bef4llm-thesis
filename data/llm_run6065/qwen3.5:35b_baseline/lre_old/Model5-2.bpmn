<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_VacationRequest" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_0VacReq">
    <bpmn:participant name="Organization Process" processRef="Proc_5832k7l"/>
  </bpmn:collaboration>

  <bpmn:process id="Proc_5832k7l" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Employee" name="Employee">
        <bpmn:flowNodeRef>StartEvent_SubmitRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegisterRequirement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Denied</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Supervisor" name="Supervisor">
        <bpmn:flowNodeRef>Task_ReviewRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ApprovalDecision</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_HR" name="HR Representative">
        <bpmn:flowNodeRef>Task_NotifyHR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CompleteProcedures</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Processed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_SubmitRequest" name="Submit Vacation Request">
      <bpmn:outgoing>SequenceFlow_RegisterReq</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_RegisterRequirement" name="Register Requirement">
      <bpmn:incoming>SequenceFlow_RegisterReq</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToSupervisor</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_ReviewRequest" name="Approve or Reject Request">
      <bpmn:incoming>SequenceFlow_ToSupervisor</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DecisionPoint</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_ApprovalDecision" name="Request Approved?">
      <bpmn:incoming>SequenceFlow_DecisionPoint</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RejectPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ApprovePath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="EndEvent_Denied" name="Request Denied">
      <bpmn:incoming>SequenceFlow_ToEndDenied</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:startEvent id="StartEvent_ReviewRejectionTrigger" name="">
      <bpmn:outgoing>SequenceFlow_StartToReviewRej</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_ReviewRejection" name="Review Rejection Reasons">
      <bpmn:incoming>SequenceFlow_RejectPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToEndDenied</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_Processed" name="Vacation Processed">
      <bpmn:incoming>SequenceFlow_ToEndProcessed</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow_RegisterReq" sourceRef="StartEvent_SubmitRequest" targetRef="Task_RegisterRequirement"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ToSupervisor" name="" sourceRef="Task_RegisterRequirement" targetRef="Task_ReviewRequest"/>

    <bpmn:sequenceFlow id="SequenceFlow_DecisionPoint" sourceRef="Task_ReviewRequest" targetRef="Gateway_ApprovalDecision"/>

    <bpmn:sequenceFlow id="SequenceFlow_RejectPath" name="Rejected" sourceRef="Gateway_ApprovalDecision" targetRef="Task_ReviewRejection"/>

    <bpmn:sequenceFlow id="SequenceFlow_ToEndDenied" sourceRef="Task_ReviewRejection" targetRef="EndEvent_Denied"/>

    <bpmn:sequenceFlow id="SequenceFlow_StartToReviewRej" name="" sourceRef="StartEvent_ReviewRejectionTrigger" targetRef="Gateway_ApprovalDecision"/>

    <bpmn:sequenceFlow id="SequenceFlow_ApprovePath" name="Approved" sourceRef="Gateway_ApprovalDecision" targetRef="Task_NotifyHR"/>

    <bpmn:startEvent id="StartEvent_HRNotificationTrigger" name="">
      <bpmn:outgoing>SequenceFlow_StartToNotify</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_NotifyHR" name="Generate Notification to HR">
      <bpmn:incoming>SequenceFlow_ApprovePath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToProcedures</bpmn:outgoing>
    </bpmn:task>

    <bpmn:startEvent id="StartEvent_CompleteProcTrigger" name="">
      <bpmn:outgoing>SequenceFlow_StartToComplete</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_CompleteProcedures" name="Complete Management Procedures">
      <bpmn:incoming>SequenceFlow_ToProcedures</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToEndProcessed</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_ToProcedures" sourceRef="Task_NotifyHR" targetRef="Task_CompleteProcedures"/>

    <bpmn:sequenceFlow id="SequenceFlow_StartToNotify" name="" sourceRef="StartEvent_HRNotificationTrigger" targetRef="Gateway_ApprovalDecision"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ToEndProcessed" sourceRef="Task_CompleteProcedures" targetRef="EndEvent_Processed"/>

  </bpmn:process>
</bpmn:definitions>