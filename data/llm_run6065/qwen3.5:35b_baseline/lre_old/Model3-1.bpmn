<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_SmallClaimsRegistry">
    <bpmn:participant id="Participant_BackOffice" name="Small Claims Registry Operations" processRef="Process_WarrantPossession"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_WarrantPossession" isExecutable="false">
    
    <!-- LaneSet -->
    <bpmn:laneSet>
      <bpmn:lane id="Lane_ClientServiceBackOffice" name="Client Service Back Office">
        <bpmn:flowNodeRef>StartEvent_RequestReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RetrieveSCTTFile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ForwardWarrantPossession</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CatchEvent_PoliceReportReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RetrieveSCTFile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AttachAndStore</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_HandoverInternalStaff</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Data Objects -->
    <bpmn:dataObject id="DataObject_SCTTFile" name="SCTT File"/>
    <bpmn:dataObject id="DataObject_ExpandedSCTFile" name="Expanded SCT Physical File"/>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_RequestReceived" name="Warrant Possession Request Received">
      <bpmn:outgoing>SequenceFlow_Retrieve</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Retrieve SCTT File -->
    <bpmn:task id="Task_RetrieveSCTTFile" name="Retrieve SCTT File">
      <bpmn:incoming>SequenceFlow_Retrieve</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ForwardWarrant</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: Forward Warrant Possession -->
    <bpmn:task id="Task_ForwardWarrantPossession" name="Forward SCT Warrant Possession to Queensland Police">
      <bpmn:incoming>SequenceFlow_ForwardWarrant</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitReport</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Catch Event (Awaiting Report) -->
    <bpmn:startEvent id="CatchEvent_PoliceReportReceived" name="">
       <!-- Using StartEvent ID for catch event logic in this context to ensure flow continuity, but logically represents a wait state. 
            Ideally an intermediateCatchEvent is used. To avoid abstract type errors and keep valid structure: -->
    </bpmn:startEvent>

    <!-- Correction: Use Intermediate Catch Event properly defined if possible without layouting issues. 
         However, standard StartEvents cannot be catch events in some schemas unless specific types are allowed. 
         I will use an intermediateCatchEvent with a message reference or just generic event to represent the wait state correctly for BPMN 2.0 validity regarding flow control -->
    <!-- Replacing CatchEvent_PoliceReportReceived definition above with proper Intermediate Event type if supported, but StartEvent is safer for ID uniqueness in simple models without DI. 
         To strictly follow "Awaiting Report", an intermediate catch event is best. I will use the specific element name 'intermediateCatchEvent' -->
    <bpmn:intermediateCatchEvent id="IntermediateCatch_PoliceReportReceived" name="Receive Police Report">
        <!-- Implicitly waiting for message from external party (Police) -->
      </bpmn:intermediateCatchEvent>

    <!-- Task 3: Retrieve SCT File after report received -->
    <bpmn:task id="Task_RetrieveSCTFile" name="Retrieve respective SCT file">
       <bpmn:incoming>SequenceFlow_WaitReport</bpmn:incoming> 
      </bpmn:task>

    <!-- Task 4: Attach and Store -->
    <bpmn:task id="Task_AttachAndStore" name="Attach new document &amp; store expanded file">
       <bpmn:outgoing>SequenceFlow_Handover</bpmn:outgoing> 
      </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_HandoverInternalStaff" name="Hand over to Internal Staff">
        <bpmn:incoming>SequenceFlow_Handover</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_Retrieve" sourceRef="StartEvent_RequestReceived" targetRef="Task_RetrieveSCTTFile"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ForwardWarrant" sourceRef="Task_RetrieveSCTTFile" targetRef="Task_ForwardWarrantPossession"/>

    <!-- Flow to Wait State -->
    <bpmn:sequenceFlow id="SequenceFlow_WaitReport" sourceRef="Task_ForwardWarrantPossession" targetRef="IntermediateCatch_PoliceReportReceived"/>

    <!-- Flow from Wait State to Next Task (Need a valid ID for the catch event in flowNodeRef) -->
    <bpmn:sequenceFlow id="SequenceFlow_RetrieveAfterWait" sourceRef="IntermediateCatch_PoliceReportReceived" targetRef="Task_RetrieveSCTFile"/>

    <!-- Flow from Retrieve to Attach/Store (Implicitly connected via Task sequence, need explicit flow for validity) -->
    <bpmn:sequenceFlow id="SequenceFlow_AttachPrep" sourceRef="Task_RetrieveSCTFile" targetRef="Task_AttachAndStore"/>

    <!-- Final Handover Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_Handover" sourceRef="Task_AttachAndStore" targetRef="EndEvent_HandoverInternalStaff"/>

  </bpmn:process>
</bpmn:definitions>