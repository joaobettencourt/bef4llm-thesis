<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_BillProcessing">
    <bpmn:participant name="MPOO" processRef="Proc_MPOO"/>
    <bpmn:participant name="GO" processRef="Proc_GO"/>
    <bpmn:participant name="MSPO" processRef="Proc_MSPO"/>
    <bpmn:participant name="MPON" processRef="Proc_MPON"/>

    <!-- Message Flows -->
    <bpmn:messageFlow id="MsgFlow_SendToGO_1" sourceRef="StartMPOO_Bill1" targetRef="StartGO_Bill1">
      <bpmn:name>Bill for temporary continuation of metering point operations</bpmn:name>
    </bpmn:messageFlow>

    <bpmn:messageFlow id="MsgFlow_SendToMPON_GO_2a" sourceRef="StartMPOO_Bill2" targetRef="StartGO_Bill4">
      <bpmn:name>Bill for equipment acquisition</bpmn:name>
    </bpmn:messageFlow>

    <bpmn:messageFlow id="MsgFlow_SendToMPON_2a" sourceRef="StartMPOO_Bill2" targetRef="StartMPON_Bill">
      <bpmn:name>Bill for equipment acquisition</bpmn:name>
    </bpmn:messageFlow>

    <bpmn:messageFlow id="MsgFlow_SendToGO_3" sourceRef="StartMSPO_Bill1" targetRef="StartGO_Bill2">
      <bpmn:name>Bill for temporary continuation of measurement</bpmn:name>
    </bpmn:messageFlow>

    <bpmn:messageFlow id="MsgFlow_SendToGO_4" sourceRef="StartMSPO_Bill2" targetRef="StartGO_Bill3">
      <bpmn:name>Bill for additional readings</bpmn:name>
    </bpmn:messageFlow>

    <!-- Payment Advice Message Flows -->
    <bpmn:messageFlow id="MsgFlow_PaymentAdvice1" sourceRef="End_GO_Confirmed" targetRef="StartMPOO_Bill2">
      <bpmn:name>Payment Advice</bpmn:name>
    </bpmn:messageFlow>

    <bpmn:messageFlow id="MsgFlow_PaymentAdvice3" sourceRef="End_GO_Confirmed" targetRef="StartMSPO_Bill1">
      <bpmn:name>Payment Advice</bpmn:name>
    </bpmn:messageFlow>

    <!-- Rejection Message Flows -->
    <bpmn:messageFlow id="MsgFlow_Rejection1" sourceRef="End_GO_Rejected" targetRef="StartMPOO_Bill2">
      <bpmn:name>Invoice Rejected</bpmn:name>
    </bpmn:messageFlow>

    <bpmn:messageFlow id="MsgFlow_Rejection3" sourceRef="End_GO_Rejected" targetRef="StartMSPO_Bill1">
      <bpmn:name>Invoice Rejected</bpmn:name>
    </bpmn:messageFlow>
  </bpmn:collaboration>

  <!-- MPOO Process -->
  <bpmn:process id="Proc_MPOO" isExecutable="false">
    <bpmn:startEvent id="StartMPOO_Bill1" name="Bill for temporary continuation of metering point operations">
      <bpmn:outgoing>SeqFlow_SendToGO_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:startEvent id="StartMPOO_Bill2" name="Bill for equipment acquisition">
      <bpmn:outgoing>SeqFlow_SendToMPON_GO_2</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:endEvent id="End_MPOO_Confirmed" name="Invoice Confirmed with Payment Advice">
      <bpmn:incoming>MsgFlow_PaymentAdvice1</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="End_MPOO_Rejected" name="Invoice Rejected">
      <bpmn:incoming>MsgFlow_Rejection1</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>

  <!-- GO Process -->
  <bpmn:process id="Proc_GO" isExecutable="false">
    <bpmn:startEvent id="StartGO_Bill1" name="Receive Bill from MPOO (metering point operations)">
      <bpmn:outgoing>SeqFlow_ExamineBill_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:startEvent id="StartGO_Bill2" name="Receive Bill from MSPO (temporary continuation of measurement)">
      <bpmn:outgoing>SeqFlow_ExamineBill_2</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:startEvent id="StartGO_Bill3" name="Receive Bill from MSPO (additional readings)">
      <bpmn:outgoing>SeqFlow_ExamineBill_3</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:startEvent id="StartGO_Bill4" name="Receive Bill for equipment acquisition">
      <bpmn:outgoing>SeqFlow_ExamineBill_4</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:endEvent id="End_GO_Confirmed" name="Invoice Confirmed with Payment Advice">
      <bpmn:incoming>XFlow_Approve_1</bpmn:incoming>
      <bpmn:incoming>XFlow_Approve_2</bpmn:incoming>
      <bpmn:incoming>XFlow_Approve_3</bpmn:incoming>
      <bpmn:incoming>XFlow_Approve_4</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="End_GO_Rejected" name="Invoice Rejected">
      <bpmn:incoming>XFlow_Reject_1</bpmn:incoming>
      <bpmn:incoming>XFlow_Reject_2</bpmn:incoming>
      <bpmn:incoming>XFlow_Reject_3</bpmn:incoming>
      <bpmn:incoming>XFlow_Reject_4</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Tasks -->
    <bpmn:task id="Task_ExamineBill_1" name="Examine Bill (metering point operations)">
      <bpmn:incoming>SeqFlow_ExamineBill_1</bpmn:incoming>
      <bpmn:outgoing>XGateway_Decision_1</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="XGateway_Decision_1" name="Approve Bill?">
      <bpmn:incoming>Task_ExamineBill_1</bpmn:incoming>
      <bpmn:outgoing>XFlow_Approve_1</bpmn:outgoing>
      <bpmn:outgoing>XFlow_Reject_1</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_ExamineBill_2" name="Examine Bill (temporary continuation of measurement)">
      <bpmn:incoming>SeqFlow_ExamineBill_2</bpmn:incoming>
      <bpmn:outgoing>XGateway_Decision_2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="XGateway_Decision_2" name="Approve Bill?">
      <bpmn:incoming>Task_ExamineBill_2</bpmn:incoming>
      <bpmn:outgoing>XFlow_Approve_2</bpmn:outgoing>
      <bpmn:outgoing>XFlow_Reject_2</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_ExamineBill_3" name="Examine Bill (additional readings)">
      <bpmn:incoming>SeqFlow_ExamineBill_3</bpmn:incoming>
      <bpmn:outgoing>XGateway_Decision_3</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="XGateway_Decision_3" name="Approve Bill?">
      <bpmn:incoming>Task_ExamineBill_3</bpmn:incoming>
      <bpmn:outgoing>XFlow_Approve_3</bpmn:outgoing>
      <bpmn:outgoing>XFlow_Reject_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_ExamineBill_4" name="Examine Bill (equipment acquisition)">
      <bpmn:incoming>SeqFlow_ExamineBill_4</bpmn:incoming>
      <bpmn:outgoing>XGateway_Decision_4</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="XGateway_Decision_4" name="Approve Bill?">
      <bpmn:incoming>Task_ExamineBill_4</bpmn:incoming>
      <bpmn:outgoing>XFlow_Approve_4</bpmn:outgoing>
      <bpmn:outgoing>XFlow_Reject_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SeqFlow_ExamineBill_1" sourceRef="StartGO_Bill1" targetRef="Task_ExamineBill_1"/>
    <bpmn:sequenceFlow id="XFlow_Approve_1" name="Yes" sourceRef="XGateway_Decision_1" targetRef="End_GO_Confirmed"/>
    <bpmn:sequenceFlow id="XFlow_Reject_1" name="No" sourceRef="XGateway_Decision_1" targetRef="End_GO_Rejected"/>

    <bpmn:sequenceFlow id="SeqFlow_ExamineBill_2" sourceRef="StartGO_Bill2" targetRef="Task_ExamineBill_2"/>
    <bpmn:sequenceFlow id="XFlow_Approve_2" name="Yes" sourceRef="XGateway_Decision_2" targetRef="End_GO_Confirmed"/>
    <bpmn:sequenceFlow id="XFlow_Reject_2" name="No" sourceRef="XGateway_Decision_2" targetRef="End_GO_Rejected"/>

    <bpmn:sequenceFlow id="SeqFlow_ExamineBill_3" sourceRef="StartGO_Bill3" targetRef="Task_ExamineBill_3"/>
    <bpmn:sequenceFlow id="XFlow_Approve_3" name="Yes" sourceRef="XGateway_Decision_3" targetRef="End_GO_Confirmed"/>
    <bpmn:sequenceFlow id="XFlow_Reject_3" name="No" sourceRef="XGateway_Decision_3" targetRef="End_GO_Rejected"/>

    <bpmn:sequenceFlow id="SeqFlow_ExamineBill_4" sourceRef="StartGO_Bill4" targetRef="Task_ExamineBill_4"/>
    <bpmn:sequenceFlow id="XFlow_Approve_4" name="Yes" sourceRef="XGateway_Decision_4" targetRef="End_GO_Confirmed"/>
    <bpmn:sequenceFlow id="XFlow_Reject_4" name="No" sourceRef="XGateway_Decision_4" targetRef="End_GO_Rejected"/>

  </bpmn:process>

  <!-- MSPO Process -->
  <bpmn:process id="Proc_MSPO" isExecutable="false">
    <bpmn:startEvent id="StartMSPO_Bill1" name="Bill for temporary continuation of measurement">
      <bpmn:outgoing>SeqFlow_SendToGO_3</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:startEvent id="StartMSPO_Bill2" name="Bill for additional readings">
      <bpmn:outgoing>SeqFlow_SendToGO_4</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:endEvent id="End_MSPO_Confirmed" name="Invoice Confirmed with Payment Advice">
      <bpmn:incoming>XFlow_Approve_3</bpmn:incoming>
      <bpmn:incoming>XFlow_Approve_4</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="End_MSPO_Rejected" name="Invoice Rejected">
      <bpmn:incoming>XFlow_Reject_3</bpmn:incoming>
      <bpmn:incoming>XFlow_Reject_4</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>

  <!-- MPON Process -->
  <bpmn:process id="Proc_MPON" isExecutable="false">
    <bpmn:startEvent id="StartMPON_Bill" name="Receive Bill for equipment acquisition from MPOO">
      <bpmn:outgoing>SeqFlow_ExamineBill_5</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:endEvent id="End_MPON_Confirmed" name="Invoice Confirmed with Payment Advice">
      <bpmn:incoming>XFlow_Approve_5</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="End_MPON_Rejected" name="Invoice Rejected">
      <bpmn:incoming>XFlow_Reject_5</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task -->
    <bpmn:task id="Task_ExamineBill_5" name="Examine Bill (equipment acquisition)">
      <bpmn:incoming>SeqFlow_ExamineBill_5</bpmn:incoming>
      <bpmn:outgoing>XGateway_Decision_5</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway -->
    <bpmn:exclusiveGateway id="XGateway_Decision_5" name="Approve Bill?">
      <bpmn:incoming>Task_ExamineBill_5</bpmn:incoming>
      <bpmn:outgoing>XFlow_Approve_5</bpmn:outgoing>
      <bpmn:outgoing>XFlow_Reject_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SeqFlow_ExamineBill_5" sourceRef="StartMPON_Bill" targetRef="Task_ExamineBill_5"/>
    <bpmn:sequenceFlow id="XFlow_Approve_5" name="Yes" sourceRef="XGateway_Decision_5" targetRef="End_MPON_Confirmed"/>
    <bpmn:sequenceFlow id="XFlow_Reject_5" name="No" sourceRef="XGateway_Decision_5" targetRef="End_MPON_Rejected"/>

  </bpmn:process>

</bpmn:definitions>