<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ClaimHandling" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_ClaimProcess">
    <bpmn:participant name="Claim Handling System" processRef="Proc_5832k7l"/>
  </bpmn:collaboration>

  <bpmn:process id="Proc_5832k7l" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_NeedInfo" name="Need Additional Info">
      <bpmn:outgoing>SequenceFlow_SendInitial</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Send Initial Questionnaire -->
    <bpmn:task id="Task_SendQuestionnaire" name="Send Questionnaire to Claimant">
      <bpmn:incoming>SequenceFlow_SendInitial</bpmn:outgoing/>
      <bpmn:outgoing>SequenceFlow_Wait5Days</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Catching Timer Event (Wait 5 Days) -->
    <bpmn:intermediateCatchEvent id="Timer_WaitDeadline" name="Wait for Response">
      <bpmn:timerEventDefinition xsi:type="bpmn:TTimeDuration"/>
        <bpmn:incoming>SequenceFlow_Wait5Days</bpmn:outgoing/>
      <bpmn:outgoing>SequenceFlow_CheckReceived</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Exclusive Gateway to Check Response -->
    <bpmn:exclusiveGateway id="Gateway_CheckReceived" name="Response Received?">
       <bpmn:incoming>SequenceFlow_Wait5Days</bpmn:outgoing/> 
        <bpmn:outgoing>SequenceFlow_YesContinue</bpmn:outgoing>
         <bpmn:outgoing>SequenceFlow_NoReminder</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 2: Send Reminder -->
    <bpmn:task id="Task_SendReminder" name="Send Reminder to Claimant">
      <bpmn:incoming>SequenceFlow_NoReminder</bpmn:outgoing/> 
       <bpmn:outgoing>SequenceLoop_WaitAgain</bpmn:outgoing>
    </bpmn:task>

     <!-- End Event for Successful Response -->
    <bpmn:endEvent id="End_Event_Received" name="Questionnaire Received">
      <bpmn:incoming>SequenceFlow_YesContinue</bpmn:outgoing/> 
    </bpmn:endEvent> 

    <!-- Sequence Flows -->
     <sequenceFlow id="SequenceFlow_SendInitial" sourceRef="StartEvent_NeedInfo" targetRef="Task_SendQuestionnaire"/>  
      <sequenceFlow id="SequenceFlow_Wait5Days" sourceRef="Task_SendQuestionnaire" targetRef="Timer_WaitDeadline"/> 
       <!-- Note: In a real engine, the timer event would have its own definition for P5D -->
    </bpmn:process>

</bpmn:definitions>