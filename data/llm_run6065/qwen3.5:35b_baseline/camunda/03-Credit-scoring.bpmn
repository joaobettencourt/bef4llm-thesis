<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_CreditScoringProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_ScoringService">
    <bpmn:participant id="Participant_BankSystem" name="Banking System" processRef="Proc_BankingSystem"/>
    <bpmn:participant id="Participant_Agency" name="Credit Protection Agency (Schufa)" processRef="Proc_AgencyScoring"/>
  </bpmn:collaboration>

  <!-- Banking System Process -->
  <bpmn:process id="Proc_BankingSystem" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane name="Sales Clerk / Frontend" id="Lane_SalesClerk">
        <bpmn:flowNodeRef>StartEvent_RequestReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendScoringRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Intermediate_CatchResponse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ResultImmediate?</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DisplayResultToClerk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ShowDelayMessage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Intermediate_CatchFinalScore</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_RequestReceived" name="Credit Scoring Request">
      <bpmn:outgoing>SeqFlow_StartToRequest</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Send Request -->
    <bpmn:task id="Task_SendScoringRequest" name="Send Scoring Request to Agency">
      <bpmn:incoming>SeqFlow_StartToRequest</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RequestSentToGateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Catch Event for Response -->
    <bpmn:intermediateCatchEvent id="Intermediate_CatchResponse" name="Receive Scoring Info">
      <bpmn:incoming>SequenceFlow_RequestSentToGateway</bpmn:outgoing></bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_ResponseReceivedToDecision</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Gateway for Decision -->
    <bpmn:exclusiveGateway id="Gateway_ResultImmediate?" name="Result Immediate?">
      <bpmn:incoming>SequenceFlow_ResponseReceivedToDecision</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_YesDisplayResult</bpmn:outgoing>
      <bpmn:outgoing>SeqFlow_NoDelayMessage</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Display Result -->
    <bpmn:task id="Task_DisplayResultToClerk" name="Display Scoring Result to Clerk">
      <bpmn:incoming>SeqFlow_YesDisplayResult</bpmn:outgoing></bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_ResultEndEvent</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Show Delay Message -->
     <bpmn:task id="Task_ShowDelayMessage" name="Show 'Check Later' Notification">
      <bpmn:incoming>SeqFlow_NoDelayMessage</bpmn:outgoing></bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_DelayToFinalWait</bpmn:outgoing>
    </bpmn:task>

     <!-- Intermediate Catch Event for Final Score -->
      <bpmn:intermediateCatchEvent id="Intermediate_CatchFinalScore" name="Receive Final Score">
        <bpmn:incoming>SequenceFlow_DelayToFinalWait</bpmn:outgoing></bpmn:incoming>
         <bpmn:outgoing>SequenceFlow_FinalResultDisplay</bpmn:outgoing>
      </bpmn:intermediateCatchEvent>

    <!-- End Event -->
     <bpmn:endEvent id="EndEvent_ProcessComplete" name="Process Complete">
        <bpmn:incoming>SequenceFlow_ResultEndEvent</bpmn:outgoing></bpmn:incoming>
         <bpmn:incoming>SequenceFlow_FinalResultDisplay</bpmn:outgoing>
      </bpmn:endEvent>

    <!-- Sequence Flows -->
     <bpmn:sequenceFlow id="SeqFlow_StartToRequest" sourceRef="StartEvent_RequestReceived" targetRef="Task_SendScoringRequest">
        <bpmn:name>Initiate Request</bpmn:name>
      </bpmn:sequenceFlow>

       <bpmn:sequenceFlow id="SequenceFlow_ResponseReceivedToDecision" name="Response Received" sourceRef="Intermediate_CatchResponse" targetRef="Gateway_ResultImmediate?"></bpmn:sequenceFlow>

     <bpmn:exclusiveGateway id="Gateway_DelayPathBank" name="Delay Required?">
        <bpmn:incoming>SeqFlow_NoDelayMessage</bpmn:outgoing></bpmn:incoming>
         <bpmn:outgoing>SequenceFlow_DelayToFinalWait</bpmn:outgoing>
      </bpmn:exclusiveGateway>

       <bpmn:sequenceFlow id="SequenceFlow_RequestSentToGateway" sourceRef="Task_SendScoringRequest" targetRef="Intermediate_CatchResponse"></bpmn:sequenceFlow>

     <bpmn:sequenceFlow id="SeqFlow_YesDisplayResult" name="Immediate Result" sourceRef="Gateway_ResultImmediate?" targetRef="Task_DisplayResultToClerk">
        <!-- Condition 'yes' -->
      </bpmn:sequenceFlow>

       <bpmn:startEvent id="CatchMessage_ReceiveFinalScore" name="Wait for Final Score"></bpmn:startEvent>

     <bpmn:exclusiveGateway id="Gateway_ResultImmediate?" name="Result Immediate?">
        <bpmn:incoming>SequenceFlow_ResponseReceivedToDecision</bpmn:outgoing></bpmn:incoming>
         <bpmn:outgoing>SeqFlow_YesDisplayResult</bpmn:outgoing>
      <bpmn:outgoing>SeqFlow_NoDelayMessage</bpmn:outgoing>
    </bpmn:exclusiveGateway>

       <bpmn:startEvent id="CatchMessage_ReceiveFinalScore" name="Wait for Final Score"></bpmn:startEvent>

     <!-- Correction for Lane References -->
      <bpmn:endEvent id="EndEvent_ProcessComplete" name="Process Complete">
        <bpmn:incoming>SequenceFlow_ResultEndEvent</bpmn:outgoing></bpmn:incoming>
         <bpmn:incoming>SequenceFlow_FinalResultDisplay</bpmn:outgoing>
      </bpmn:endEvent>

       <bpmn:startEvent id="CatchMessage_ReceiveFinalScore" name="Wait for Final Score"></bpmn:startEvent>

     <!-- Correction for Lane References -->
    <bpmn:laneSet>
        <bpmn:lane id="Lane_SalesClerk" name="Sales Clerk / Frontend">
            <bpmn:flowNodeRef>StartEvent_RequestReceived</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Task_SendScoringRequest</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Intermediate_CatchResponse</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Gateway_ResultImmediate?</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Task_DisplayResultToClerk</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Task_ShowDelayMessage</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Intermediate_CatchFinalScore</bpmn:flowNodeRef>
        </bpmn:lane>
    </bpmn:laneSet>

  <!-- Re-organizing for valid XML structure without duplicate IDs -->
  </bpmn:process>
</bpmn:definitions>