<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_OrderProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_0geryc1">
    <bpmn:participant id="Participant_ComputerHardwareShop" name="Computer Hardware Shop Dispatch of Goods" processRef="Process_OrderDispatch"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_OrderDispatch" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane name="Secretary" id="Lane_Secretary">
        <bpmn:flowNodeRef>Task_CheckShipmentMethod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_QuantityCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GetFreightOffers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectLogisticCompany</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FillPackageLabel</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane name="Warehouse" id="Lane_Warehouse">
        <bpmn:flowNodeRef>Task_PackGoods</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AllPreparationsComplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ShipmentReady</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_GoodsToShip" name="Goods to Ship">
      <bpmn:outgoing>SequenceFlow_StartToCheckMethod</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Check Shipment Method (Secretary) -->
    <bpmn:task id="Task_CheckShipmentMethod" name="Clarify shipment method">
      <bpmn:incoming>SequenceFlow_StartToCheckMethod</bpmn:outgoing></bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_CheckMethodToGateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Quantity Check (Secretary) -->
    <bpmn:exclusiveGateway id="Gateway_QuantityCheck" name="Large quantities?">
      <bpmn:incoming>SequenceFlow_CheckMethodToGateway</bpmn:outgoing></bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_LargeQuantitiesYes</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SmallQuantitiesNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Get Freight Offers (Secretary) - for large quantities -->
    <bpmn:task id="Task_GetFreightOffers" name="Get 3 offers from logistic companies">
      <bpmn:incoming>SequenceFlow_LargeQuantitiesYes</bpmn:outgoing></bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_OffersToSelectCompany</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Select Logistic Company (Secretary) - for large quantities -->
    <bpmn:task id="Task_SelectLogisticCompany" name="Select logistic company and place order">
      <bpmn:incoming>SequenceFlow_OffersToSelectCompany</bpmn:outgoing></bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_CompanySelectedToEndGateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Fill Package Label (Secretary) - for small quantities -->
    <bpmn:task id="Task_FillPackageLabel" name="Write package label">
      <bpmn:incoming>SequenceFlow_SmallQuantitiesNo</bpmn:outgoing></bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_LabelToInsuranceGateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Insurance Check (Secretary) -->
    <bpmn:exclusiveGateway id="Gateway_InsuranceCheck" name="Insurance necessary?">
      <bpmn:incoming>SequenceFlow_LabelToInsuranceGateway</bpmn:outgoing></bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_InsuranceYes</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_InsuranceNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Arrange Insurance (Logistics Manager) - if insurance required -->
    <bpmn:task id="Task_ArrangeInsurance" name="Insure parcel">
      <bpmn:incoming>SequenceFlow_InsuranceYes</bpmn:outgoing></bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_InsuranceToFinalGateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Pack Goods (Warehouse) - parallel activity -->
    <bpmn:task id="Task_PackGoods" name="Package goods">
      <bpmn:incoming>SequenceFlow_StartToCheckMethod</bpmn:outgoing></bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_PackedToEndGateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: All Preparations Complete (Warehouse) -->
    <bpmn:exclusiveGateway id="Gateway_AllPreparationsComplete" name="All preparations complete?">
      <bpmn:incoming>SequenceFlow_CompanySelectedToEndGateway</bpmn:outgoing></bpmn:incoming>
       <bpmn:incoming>SequenceFlow_InsuranceToFinalGateway</bpmn:outgoing></bpmn:incoming>
       <bpmn:incoming>SequenceFlow_PackedToEndGateway</bpmn:outgoing></bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_PreparationsCompleteToEndEvent</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_ShipmentReady" name="Shipment prepared">
      <bpmn:incoming>SequenceFlow_PreparationsCompleteToEndEvent</bpmn:outgoing></bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToCheckMethod" sourceRef="StartEvent_GoodsToShip" targetRef="Task_CheckShipmentMethod"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_CheckMethodToGateway" name="Determine shipment type" sourceRef="Task_CheckShipmentMethod" targetRef="Gateway_QuantityCheck"/>

    <bpmn:sequenceFlow id="SequenceFlow_LargeQuantitiesYes" name="Large quantities (yes)" sourceRef="Gateway_QuantityCheck" targetRef="Task_GetFreightOffers"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_SmallQuantitiesNo" name="Small quantities (no)" sourceRef="Gateway_QuantityCheck" targetRef="Task_FillPackageLabel"/>

    <bpmn:sequenceFlow id="SequenceFlow_OffersToSelectCompany" sourceRef="Task_GetFreightOffers" targetRef="Task_SelectLogisticCompany"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_CompanySelectedToEndGateway" name="Order placed (large)" sourceRef="Task_SelectLogisticCompany" targetRef="Gateway_AllPreparationsComplete"/>

    <bpmn:sequenceFlow id="SequenceFlow_LabelToInsuranceGateway" sourceRef="Task_FillPackageLabel" targetRef="Gateway_InsuranceCheck"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_InsuranceYes" name="Insurance required (yes)" sourceRef="Gateway_InsuranceCheck" targetRef="Task_ArrangeInsurance"/>

    <bpmn:sequenceFlow id="SequenceFlow_InsuranceNo" name="Insurance not needed (no)" sourceRef="Gateway_InsuranceCheck" targetRef="Gateway_AllPreparationsComplete"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_PackedToEndGateway" sourceRef="Task_PackGoods" targetRef="Gateway_AllPreparationsComplete"/>

    <bpmn:sequenceFlow id="SequenceFlow_PreparationsCompleteToEndEvent" name="All preparations complete (yes)" sourceRef="Gateway_AllPreparationsComplete" targetRef="EndEvent_ShipmentReady"/>
  </bpmn:process>
</bpmn:definitions>