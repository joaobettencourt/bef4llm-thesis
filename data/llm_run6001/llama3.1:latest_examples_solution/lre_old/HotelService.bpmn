<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_0" name="Hotel" processRef="Process_1"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_0" name="Sommelier">
        <bpmn:flowNodeRef>Task_10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_0</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1" name="Kitchen">
        <bpmn:flowNodeRef>Task_12</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Waiter">
        <bpmn:flowNodeRef>Task_13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_0</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3" name="Room-Service Manager">
        <bpmn:flowNodeRef>StartEvent_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_0" name="Guest calls room service">
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_16" name="Take down order ">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="ParallelGateway_1">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_17" name="Assign order to waiter">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_0" targetRef="Task_16"/>
    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="Task_16" targetRef="ParallelGateway_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="ParallelGateway_1" targetRef="Task_18"/>
    <bpmn:task id="Task_18" name="Submit order ticket to kitchen">
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="ParallelGateway_1" targetRef="Task_19"/>
    <bpmn:task id="Task_19" name="Give order to sommelier">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="Task_17" targetRef="Task_19"/>
    <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="Task_18" targetRef="ParallelGateway_2"/>
    <bpmn:parallelGateway id="ParallelGateway_2">
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_8</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_9</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="SequenceFlow_7" sourceRef="Task_19" targetRef="ParallelGateway_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_8" sourceRef="ParallelGateway_2" targetRef="Task_20"/>
    <bpmn:task id="Task_20" name="Prepare meal">
      <bpmn:incoming>SequenceFlow_8</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_9" sourceRef="ParallelGateway_2" targetRef="Task_21"/>
    <bpmn:task id="Task_21" name="Ready cart">
      <bpmn:incoming>SequenceFlow_9</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="Task_21" targetRef="InclusiveGateway_0"/>
    <bpmn:inclusiveGateway id="InclusiveGateway_0">
      <bpmn:incoming>SequenceFlow_10</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_13</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_14</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:sequenceFlow id="SequenceFlow_11" sourceRef="Task_20" targetRef="InclusiveGateway_0"/>
    <bpmn:sequenceFlow id="SequenceFlow_12" sourceRef="Task_21" targetRef="InclusiveGateway_0"/>
    <bpmn:sequenceFlow id="SequenceFlow_13" sourceRef="InclusiveGateway_0" targetRef="Task_22"/>
    <bpmn:task id="Task_22" name="Deliver to guest's room">
      <bpmn:incoming>SequenceFlow_13</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_14" sourceRef="InclusiveGateway_0" targetRef="Task_23"/>
    <bpmn:task id="Task_23" name="Return to room-service ">
      <bpmn:incoming>SequenceFlow_14</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_0" name="Shipment prepared">
      <bpmn:incoming>SequenceFlow_15</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow_15" sourceRef="Task_22" targetRef="EndEvent_0"/>
    <bpmn:sequenceFlow id="SequenceFlow_16" sourceRef="Task_23" targetRef="EndEvent_0"/>
  </bpmn:process>
</bpmn:definitions>