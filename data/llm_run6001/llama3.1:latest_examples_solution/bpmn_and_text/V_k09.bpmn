<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
  targetNamespace="http://bpmn.io/schema/bpmn"
  id="Definitions_1" xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/BPMN20.xsd">
  
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Storage management"></bpmn:startEvent>
    
    <bpmn:serviceTask completionQuantity="1"
      id="Read_order"
      implementation="##WebService"
      isForCompensation="false"
      name="Read order"
      startQuantity="1">
      <bpmn:incoming>sid-F36859E7-9F48-46CB-8209-BD541541DA1E</bpmn:incoming>
    </bpmn:serviceTask>
    
    <bpmn:exclusiveGateway gatewayDirection="Diverging"
      id="Is_product_in_stock"
      name="Is product in stock?">
      <bpmn:incoming>sid-9347549C-BD85-4390-BB7E-60C4FC204BA1</bpmn:incoming>
    </bpmn:exclusiveGateway>
    
    <bpmn:serviceTask completionQuantity="1"
      id="Check_if_product_is_in_stock"
      implementation="##WebService"
      isForCompensation="false"
      name="Check if product is in stock"
      startQuantity="1">
      <bpmn:incoming>sid-9347549C-BD85-4390-BB7E-60C4FC204BA1</bpmn:incoming>
    </bpmn:serviceTask>
    
    <bpmn:sequenceFlow id="SequenceFlow_1"
      sourceRef="Read_order"
      targetRef="Is_product_in_stock">
    </bpmn:sequenceFlow>
    
    <bpmn:exclusiveGateway gatewayDirection="Converging"
      id="Is_product_in_stock_convergence"
      name="Is product in stock?">
      <bpmn:incoming>sid-9347549C-BD85-4390-BB7E-60C4FC204BA1</bpmn:incoming>
    </bpmn:exclusiveGateway>
    
    <bpmn:serviceTask completionQuantity="1"
      id="Withdraw_product_from_warehouse"
      implementation="##WebService"
      isForCompensation="false"
      name="Withdraw product from warehouse"
      startQuantity="1">
      <bpmn:incoming>sid-7B6E2FF9-8CB8-4626-8262-09729DA46A79</bpmn:incoming>
    </bpmn:serviceTask>
    
    <bpmn:sequenceFlow id="SequenceFlow_2"
      sourceRef="Is_product_in_stock"
      targetRef="Withdraw_product_from_warehouse">
    </bpmn:sequenceFlow>
    
    <bpmn:exclusiveGateway gatewayDirection="Diverging"
      id="Arrived_after_more_than_ten_days"
      name="Arrived after more than ten days?">
      <bpmn:incoming>sid-5566593E-D902-45C2-B6A7-CD13BC0A53F6</bpmn:incoming>
    </bpmn:exclusiveGateway>
    
    <bpmn:serviceTask completionQuantity="1"
      id="Demand_delivery_delay_penalty_from_wholesaler"
      implementation="##WebService"
      isForCompensation="false"
      name="Demand delivery delay penalty from wholesaler"
      startQuantity="1">
      <bpmn:incoming>sid-5BAAB2B4-6585-426B-B761-B4A0EF0D3490</bpmn:incoming>
    </bpmn:serviceTask>
    
    <bpmn:endEvent id="EndEvent_1" name="Order was shipped"></bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>