<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  targetNamespace="http://bpmn.io/schema/bpmn" id="Definitions_1">
  
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Open E-Shop Homepage"></bpmn:startEvent>
    
    <bpmn:manualTask id="ManualTask_1" name="customer logs into E-Shop" completionQuantity="1" startQuantity="1">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:manualTask>
    
    <bpmn:serviceTask id="ServiceTask_1" name="customer credentials being checked by system" completionQuantity="1" startQuantity="1">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    
    <bpmn:exclusiveGateway id="ExclusiveGateway_1" name="succesful login?">
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <bpmn:manualTask id="ManualTask_2" name="customer selects a product" completionQuantity="1" startQuantity="1">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
    </bpmn:manualTask>
    
    <bpmn:manualTask id="ManualTask_3" name="customer adds product to shopping cart" completionQuantity="1" startQuantity="1">
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
    </bpmn:manualTask>
    
    <bpmn:manualTask id="ManualTask_4" name="customer saves product" completionQuantity="1" startQuantity="1">
      <bpmn:incoming>SequenceFlow_7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_8</bpmn:outgoing>
    </bpmn:manualTask>
    
    <bpmn:manualTask id="ManualTask_5" name="customer checks if product was already selected" completionQuantity="1" startQuantity="1">
      <bpmn:incoming>SequenceFlow_8</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_9</bpmn:outgoing>
    </bpmn:manualTask>
    
    <bpmn:exclusiveGateway id="ExclusiveGateway_2" name="has customer selected all desired products?">
      <bpmn:incoming>SequenceFlow_9</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <bpmn:parallelGateway id="ParallelGateway_1" name="">
      <bpmn:incoming>SequenceFlow_10</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_12</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_13</bpmn:outgoing>
    </bpmn:parallelGateway>
    
    <bpmn:serviceTask id="ServiceTask_2" name="Payment is prepared by system" completionQuantity="1" startQuantity="1">
      <bpmn:incoming>SequenceFlow_12</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_14</bpmn:outgoing>
    </bpmn:serviceTask>
    
    <bpmn:serviceTask id="ServiceTask_3" name="Shipment is prepared by system" completionQuantity="1" startQuantity="1">
      <bpmn:incoming>SequenceFlow_13</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_15</bpmn:outgoing>
    </bpmn:serviceTask>
    
    <bpmn:manualTask id="ManualTask_6" name="customer enters payment data" completionQuantity="1" startQuantity="1">
      <bpmn:incoming>SequenceFlow_14</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_16</bpmn:outgoing>
    </bpmn:manualTask>
    
    <bpmn:parallelGateway id="ParallelGateway_2" name="">
      <bpmn:incoming>SequenceFlow_15</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_17</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_18</bpmn:outgoing>
    </bpmn:parallelGateway>
    
    <bpmn:endEvent id="EndEvent_1" name="Close E-Shop Homepage">
      <bpmn:incoming>SequenceFlow_19</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  
  <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="ManualTask_1"></bpmn:sequenceFlow>
  <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="ManualTask_1" targetRef="ServiceTask_1"></bpmn:sequenceFlow>
  <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="ServiceTask_1" targetRef="ExclusiveGateway_1"></bpmn:sequenceFlow>
  <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_1" targetRef="ManualTask_2"></bpmn:sequenceFlow>
  <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="ExclusiveGateway_1" targetRef="ParallelGateway_1"></bpmn:sequenceFlow>
  <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="ManualTask_2" targetRef="ManualTask_3"></bpmn:sequenceFlow>
  <bpmn:sequenceFlow id="SequenceFlow_7" sourceRef="ManualTask_3" targetRef="ManualTask_4"></bpmn:sequenceFlow>
  <bpmn:sequenceFlow id="SequenceFlow_8" sourceRef="ManualTask_4" targetRef="ManualTask_5"></bpmn:sequenceFlow>
  <bpmn:sequenceFlow id="SequenceFlow_9" sourceRef="ManualTask_5" targetRef="ExclusiveGateway_2"></bpmn:sequenceFlow>
  <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="ExclusiveGateway_2" targetRef="ParallelGateway_1"></bpmn:sequenceFlow>
  <bpmn:sequenceFlow id="SequenceFlow_11" sourceRef="ExclusiveGateway_2" targetRef="ManualTask_6"></bpmn:sequenceFlow>
  <bpmn:sequenceFlow id="SequenceFlow_12" sourceRef="ParallelGateway_1" targetRef="ServiceTask_2"></bpmn:sequenceFlow>
  <bpmn:sequenceFlow id="SequenceFlow_13" sourceRef="ParallelGateway_1" targetRef="ServiceTask_3"></bpmn:sequenceFlow>
  <bpmn:sequenceFlow id="SequenceFlow_14" sourceRef="ServiceTask_2" targetRef="ManualTask_6"></bpmn:sequenceFlow>
  <bpmn:sequenceFlow id="SequenceFlow_15" sourceRef="ServiceTask_3" targetRef="ParallelGateway_2"></bpmn:sequenceFlow>
  <bpmn:sequenceFlow id="SequenceFlow_16" sourceRef="ManualTask_6" targetRef="ParallelGateway_2"></bpmn:sequenceFlow>
  <bpmn:sequenceFlow id="SequenceFlow_17" sourceRef="ParallelGateway_2" targetRef="EndEvent_1"></bpmn:sequenceFlow>
  <bpmn:sequenceFlow id="SequenceFlow_18" sourceRef="ParallelGateway_2" targetRef="ManualTask_7"></bpmn:sequenceFlow>
  <bpmn:sequenceFlow id="SequenceFlow_19" sourceRef="ManualTask_7" targetRef="EndEvent_1"></bpmn:sequenceFlow>
</bpmn:definitions>