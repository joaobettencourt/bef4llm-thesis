<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Chainsaw order request"></bpmn:startEvent>
    
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>
    
    <bpmn:task id="Task_1" name="Request properties">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="Task_2"/>
    
    <bpmn:task id="Task_2" name="Set properties">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="Task_2" targetRef="ParallelGateway_1"/>
    
    <bpmn:parallelGateway id="ParallelGateway_1" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
    </bpmn:parallelGateway>
    
    <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="ParallelGateway_1" targetRef="Task_3"/>
    
    <bpmn:task id="Task_3" name="Order guide bar">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="ParallelGateway_1" targetRef="Task_4"/>
    
    <bpmn:task id="Task_4" name="Order chain">
      <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="Task_3" targetRef="ExclusiveGateway_1"/>
    
    <bpmn:exclusiveGateway id="ExclusiveGateway_1">
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_8</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <bpmn:sequenceFlow id="SequenceFlow_7" sourceRef="Task_4" targetRef="ExclusiveGateway_1"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_8" sourceRef="ExclusiveGateway_1" targetRef="Task_5"/>
    
    <bpmn:task id="Task_5" name="Order color">
      <bpmn:incoming>SequenceFlow_8</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:sequenceFlow id="SequenceFlow_9" sourceRef="ExclusiveGateway_1" targetRef="Task_6"/>
    
    <bpmn:task id="Task_6" name="Order protective shield">
      <bpmn:incoming>SequenceFlow_9</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_11</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="Task_5" targetRef="ExclusiveGateway_2"/>
    
    <bpmn:exclusiveGateway id="ExclusiveGateway_2">
      <bpmn:incoming>SequenceFlow_10</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_12</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <bpmn:sequenceFlow id="SequenceFlow_11" sourceRef="Task_6" targetRef="ExclusiveGateway_2"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_12" sourceRef="ExclusiveGateway_2" targetRef="Task_7"/>
    
    <bpmn:task id="Task_7" name="Inspect parts">
      <bpmn:incoming>SequenceFlow_12</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_14</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:sequenceFlow id="SequenceFlow_13" sourceRef="ExclusiveGateway_2" targetRef="Task_8"/>
    
    <bpmn:task id="Task_8" name="Assemble parts">
      <bpmn:incoming>SequenceFlow_13</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_15</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:sequenceFlow id="SequenceFlow_14" sourceRef="Task_7" targetRef="IntermediateCatchEvent_1"/>
    
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_1">
      <bpmn:incoming>SequenceFlow_14</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_16</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    
    <bpmn:sequenceFlow id="SequenceFlow_15" sourceRef="Task_8" targetRef="IntermediateCatchEvent_1"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_16" sourceRef="IntermediateCatchEvent_1" targetRef="ExclusiveGateway_3"/>
    
    <bpmn:exclusiveGateway id="ExclusiveGateway_3">
      <bpmn:incoming>SequenceFlow_16</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_17</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <bpmn:sequenceFlow id="SequenceFlow_17" sourceRef="ExclusiveGateway_3" targetRef="Task_9"/>
    
    <bpmn:task id="Task_9" name="Send update">
      <bpmn:incoming>SequenceFlow_17</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_19</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:sequenceFlow id="SequenceFlow_18" sourceRef="ExclusiveGateway_3" targetRef="Task_10"/>
    
    <bpmn:task id="Task_10" name="Send chainsaw to customer">
      <bpmn:incoming>SequenceFlow_18</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_20</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:sequenceFlow id="SequenceFlow_19" sourceRef="Task_9" targetRef="EndEvent_1"/>
    
    <bpmn:endEvent id="EndEvent_1" name="Chainsaw order completed"></bpmn:endEvent>
    
    <bpmn:sequenceFlow id="SequenceFlow_20" sourceRef="Task_10" targetRef="EndEvent_1"/>
  </bpmn:process>
</bpmn:definitions>