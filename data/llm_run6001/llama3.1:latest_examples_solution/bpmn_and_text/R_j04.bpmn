<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  targetNamespace="http://bpmn.io/schema/bpmn" id="Definitions_1">
  
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Process start event"></bpmn:startEvent>
    
    <!-- Check if car is registered -->
    <serviceTask id="ServiceTask_1" name="Check if car is registered">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </serviceTask>
    
    <!-- Notify car owner if car is registered -->
    <exclusiveGateway id="ExclusiveGateway_1" gatewayDirection="Diverging">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
      <outgoing>SequenceFlow_4</outgoing>
    </exclusiveGateway>
    
    <!-- Send fine to car owner if car is not registered -->
    <serviceTask id="ServiceTask_2" name="Send fine to car owner">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_5</outgoing>
    </serviceTask>
    
    <!-- Enter car problems at service facility -->
    <manualTask id="ManualTask_1" name="Enter car problems at service facility">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </manualTask>
    
    <!-- Send status updates to car owner via email -->
    <serviceTask id="ServiceTask_3" name="Send status updates to car owner via email">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </serviceTask>
    
    <!-- Select payment method -->
    <manualTask id="ManualTask_2" name="Select payment method">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </manualTask>
    
    <!-- Pay via app -->
    <serviceTask id="ServiceTask_4" name="Pay via app">
      <incoming>SequenceFlow_8</incoming>
      <outgoing>SequenceFlow_9</outgoing>
    </serviceTask>
    
    <!-- Confirm receipt of payment -->
    <manualTask id="ManualTask_3" name="Confirm receipt of payment">
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_10</outgoing>
    </manualTask>
    
    <!-- Confirm successful repair and grant "Pickerl" -->
    <manualTask id="ManualTask_4" name="Confirm successful repair and grant &quot;Pickerl&quot;">
      <incoming>SequenceFlow_10</incoming>
      <outgoing>SequenceFlow_11</outgoing>
    </manualTask>
    
    <!-- Check if car was transferred to service facility -->
    <serviceTask id="ServiceTask_5" name="Check if car was transferred to service facility">
      <incoming>SequenceFlow_11</incoming>
      <outgoing>SequenceFlow_12</outgoing>
    </serviceTask>
    
    <!-- Enter time for next service -->
    <manualTask id="ManualTask_5" name="Enter time for next service">
      <incoming>SequenceFlow_12</incoming>
      <outgoing>SequenceFlow_13</outgoing>
    </manualTask>
    
    <!-- End event -->
    <bpmn:endEvent id="EndEvent_1" name="Process end event"></bpmn:endEvent>
    
    <!-- Sequence flows -->
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="ServiceTask_1"/>
    <sequenceFlow id="SequenceFlow_2" sourceRef="ServiceTask_1" targetRef="ExclusiveGateway_1"/>
    <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_1" targetRef="ManualTask_1"/>
    <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_1" targetRef="ServiceTask_2"/>
    <sequenceFlow id="SequenceFlow_5" sourceRef="ServiceTask_2" targetRef="EndEvent_1"/>
    <sequenceFlow id="SequenceFlow_6" sourceRef="ManualTask_1" targetRef="ServiceTask_3"/>
    <sequenceFlow id="SequenceFlow_7" sourceRef="ServiceTask_3" targetRef="ManualTask_2"/>
    <sequenceFlow id="SequenceFlow_8" sourceRef="ManualTask_2" targetRef="ServiceTask_4"/>
    <sequenceFlow id="SequenceFlow_9" sourceRef="ServiceTask_4" targetRef="ManualTask_3"/>
    <sequenceFlow id="SequenceFlow_10" sourceRef="ManualTask_3" targetRef="ManualTask_4"/>
    <sequenceFlow id="SequenceFlow_11" sourceRef="ManualTask_4" targetRef="ServiceTask_5"/>
    <sequenceFlow id="SequenceFlow_12" sourceRef="ServiceTask_5" targetRef="ManualTask_5"/>
    <sequenceFlow id="SequenceFlow_13" sourceRef="ManualTask_5" targetRef="EndEvent_1"/>
  </bpmn:process>
</bpmn:definitions>