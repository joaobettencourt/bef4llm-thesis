<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Collect credit information">
      <bpmn:outgoing>SequenceFlow_0kz5g1t</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="ExclusiveGateway_1mpgzhg" name="Is amount greater than 1M$?">
      <bpmn:incoming>SequenceFlow_0kz5g1t</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1j94oja</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_1dlbln9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_12j0pib" name="Assess risk of credit">
      <bpmn:incoming>SequenceFlow_1dlbln9</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0mp5byl</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="ExclusiveGateway_0p2e5vq" name="Is risk high?">
      <bpmn:incoming>SequenceFlow_0mp5byl</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1xv6wk4</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_023hzxi</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_0jsoxba" name="Request approval">
      <bpmn:incoming>SequenceFlow_1xv6wk4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0iu9po7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_1fx9yp3" name="Credit accepted">
      <bpmn:incoming>SequenceFlow_023hzxi</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow_0kz5g1t" sourceRef="StartEvent_1" targetRef="ExclusiveGateway_1mpgzhg" />
    <bpmn:sequenceFlow id="SequenceFlow_1j94oja" name="Yes" sourceRef="ExclusiveGateway_1mpgzhg" targetRef="Task_12j0pib" />
    <bpmn:sequenceFlow id="SequenceFlow_1dlbln9" name="No" sourceRef="ExclusiveGateway_1mpgzhg" targetRef="Task_0jsoxba" />
    <bpmn:sequenceFlow id="SequenceFlow_0mp5byl" sourceRef="Task_12j0pib" targetRef="ExclusiveGateway_0p2e5vq" />
    <bpmn:sequenceFlow id="SequenceFlow_1xv6wk4" name="Yes" sourceRef="ExclusiveGateway_0p2e5vq" targetRef="Task_0jsoxba" />
    <bpmn:sequenceFlow id="SequenceFlow_023hzxi" name="No" sourceRef="ExclusiveGateway_0p2e5vq" targetRef="EndEvent_1fx9yp3" />
  </bpmn:process>
</bpmn:definitions>