    <bpmn:task id="Task_0vaxgaa" name="Place order with employee">
      <bpmn:incoming>SequenceFlow_0mp5byl</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1rss71o</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_1rss71o" sourceRef="Task_0vaxgaa" targetRef="Task_05ftug5"/>
    <bpmn:task id="Task_05ftug5" name="Employee enters order into POS system and collects money from guest">
      <bpmn:incoming>SequenceFlow_1rss71o</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0kz5g1t</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_0kz5g1t" sourceRef="Task_05ftug5" targetRef="Task_0e6hvnj"/>
    <bpmn:task id="Task_0e6hvnj" name="Employee sets up buzzer and passes it on to guest">
      <bpmn:incoming>SequenceFlow_0kz5g1t</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1pq8ub3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_1pq8ub3" sourceRef="Task_0e6hvnj" targetRef="Task_0s79ile"/>
    <bpmn:task id="Task_0s79ile" name="Employee informs chef of new meal order">
      <bpmn:incoming>SequenceFlow_1pq8ub3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_035vf60</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_035vf60" sourceRef="Task_0s79ile" targetRef="Task_12j1pib"/>
    <bpmn:task id="Task_12j1pib" name="Chef prepares meal and places it in service hatch">
      <bpmn:incoming>SequenceFlow_035vf60</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0v64x8b</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_0v64x8b" sourceRef="Task_12j1pib" targetRef="Task_05ftug6"/>
    <bpmn:task id="Task_05ftug6" name="Chef informs employee that meal is ready">
      <bpmn:incoming>SequenceFlow_0v64x8b</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1ujhfx4</bpmn:outgoing>
    </bpmn:task>
