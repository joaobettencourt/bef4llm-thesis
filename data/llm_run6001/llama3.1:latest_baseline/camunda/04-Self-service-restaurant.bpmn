    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_0ajhekx" sourceRef="Task_0e6hvnj2" targetRef="Task_12j1pib2"/>
    <bpmn:task id="Task_12j1pib2" name="Guest picks up meal">
      <bpmn:incoming>SequenceFlow_0ajhekx</bpmn:incoming>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_1fx9yp3" name="Guest eats meal">
      <bpmn:incoming>SequenceFlow_0ajhekx</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
