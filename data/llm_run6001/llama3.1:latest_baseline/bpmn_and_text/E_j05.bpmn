<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Check requirements">
      <bpmn:outgoing>SequenceFlow_0iu9po7</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:sequenceFlow id="SequenceFlow_0iu9po7" sourceRef="StartEvent_1" targetRef="Task_12j0pib"/>

    <bpmn:task id="Task_12j0pib" name="Organize accommodation and bank account">
      <bpmn:incoming>SequenceFlow_0iu9po7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1j94oja</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_1j94oja" sourceRef="Task_12j0pib" targetRef="Task_0jsoxba"/>

    <bpmn:task id="Task_0jsoxba" name="Check visa requirements">
      <bpmn:incoming>SequenceFlow_1j94oja</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0mp5byl</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_0mp5byl" sourceRef="Task_0jsoxba" targetRef="Task_05ftug5"/>

    <bpmn:task id="Task_05ftug5" name="Apply for visa">
      <bpmn:incoming>SequenceFlow_0mp5byl</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0kz5g1t</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_0kz5g1t" sourceRef="Task_05ftug5" targetRef="ExclusiveGateway_1mpgzhg"/>

    <bpmn:exclusiveGateway id="ExclusiveGateway_1mpgzhg">
      <bpmn:incoming>SequenceFlow_0kz5g1t</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_023hzxi</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="SequenceFlow_023hzxi" sourceRef="ExclusiveGateway_1mpgzhg" targetRef="Task_0vaxgaa"/>

    <bpmn:task id="Task_0vaxgaa" name="Wait for visa decision">
      <bpmn:incoming>SequenceFlow_023hzxi</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1rss71o</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_1rss71o" sourceRef="Task_0vaxgaa" targetRef="ExclusiveGateway_1dgb4sg"/>

    <bpmn:inclusiveGateway id="ExclusiveGateway_1dgb4sg">
      <bpmn:incoming>SequenceFlow_1rss71o</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0buzwss</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <bpmn:sequenceFlow id="SequenceFlow_0buzwss" sourceRef="ExclusiveGateway_1dgb4sg" targetRef="EndEvent_1fx9yp3"/>

    <bpmn:endEvent id="EndEvent_1fx9yp3" name="Process completed">
      <bpmn:incoming>SequenceFlow_0buzwss</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>