    <!-- Core Flow Elements -->
    <bpmn:startEvent id="StartEvent_1" name="Plan LAN Party">
      <bpmn:outgoing>SequenceFlow_0kz5g1t</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_12j0pib" name="Send invitations to 10 friends">
      <bpmn:incoming>SequenceFlow_0kz5g1t</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1j94oja</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_0kz5g1t" sourceRef="StartEvent_1"
