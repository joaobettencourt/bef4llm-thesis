<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_OnlineShopOrdering" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_OrderProcess">
    <bpmn:participant id="Participant_CustomerSystem" name="Customer System Process" processRef="Process_Main"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Main" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Customer" name="Customer">
        <bpmn:flowNodeRef>StartEvent_Login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectProduct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AddToCart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterPaymentData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterShippingAddress</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="System">
        <bpmn:flowNodeRef>InclusiveGateway_LoginCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckCredentials</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_ProductSelected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_PaymentShipment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckAllProducts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_AddressPaymentDone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_OrderFinished</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Login" name="Customer Login">
      <bpmn:outgoing>SF_StartToCheck</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Tasks -->
    <bpmn:task id="Task_CheckCredentials" name="Wait for login confirmation&#10;(credentials checked)">
      <bpmn:incoming>SF_StartToCheck</bpmn:incoming>
      <bpmn:outgoing>SF_CredentialsChecked</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_SelectProduct" name="Select product">
      <bpmn:incoming>SF_ProductLoopBack</bpmn:incoming>
      <bpmn:outgoing>SF_AddToCart</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_AddToCart" name="Add to shopping cart&#10;and save product">
      <bpmn:incoming>SF_AddToCart</bpmn:incoming>
      <bpmn:outgoing>SF_CheckAllProducts</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_EnterPaymentData" name="Enter payment data">
      <bpmn:incoming>SF_PaymentStart</bpmn:incoming>
      <bpmn:outgoing>SF_WaitBankConfirm</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_EnterShippingAddress" name="Enter shipping address">
      <bpmn:incoming>SF_AddressStart</bpmn:incoming>
      <bpmn:outgoing>SF_AddressDone</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateways -->
    <bpmn:inclusiveGateway id="InclusiveGateway_LoginCheck" name="Login successful?">
      <bpmn:incoming>SF_CredentialsChecked</bpmn:incoming>
      <bpmn:outgoing>SF_ContinueShopping</bpmn:outgoing>
      <bpmn:outgoing>SF_StopExperience</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <bpmn:exclusiveGateway id="ExclusiveGateway_ProductSelected" name="All products selected?">
      <bpmn:incoming>SF_CheckAllProducts</bpmn:incoming>
      <bpmn:outgoing>SF_PaymentShipmentStart</bpmn:outgoing>
      <bpmn:outgoing>SF_ProductLoopBack</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:parallelGateway id="InclusiveGateway_PaymentShipment" name="Payment &amp; Shipment">
      <bpmn:incoming>SF_PaymentShipmentStart</bpmn:incoming>
      <bpmn:outgoing>SF_PaymentProcess</bpmn:outgoing>
      <bpmn:outgoing>SF_AddressProcess</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:exclusiveGateway id="ExclusiveGateway_AddressPaymentDone" name="Address &amp; Payment done?">
      <bpmn:incoming>SF_PaymentConfirm</bpmn:incoming>
      <bpmn:incoming>SF_AddressDone</bpmn:incoming>
      <bpmn:outgoing>SF_OrderFinished</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_OrderFinished" name="Order finished">
      <bpmn:incoming>SF_OrderFinished</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SF_StartToCheck" sourceRef="StartEvent_Login" targetRef="Task_CheckCredentials"/>

    <bpmn:sequenceFlow id="SF_CredentialsChecked" name="Successful" sourceRef="Task_CheckCredentials" targetRef="InclusiveGateway_LoginCheck">
      <bpmn:name>Yes - Login successful</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SF_StopExperience" name="No - Stop experience" sourceRef="InclusiveGateway_LoginCheck" targetRef="EndEvent_OrderFinished"/>

    <bpmn:sequenceFlow id="SF_ContinueShopping" sourceRef="InclusiveGateway_LoginCheck" targetRef="Task_SelectProduct"/>

    <bpmn:sequenceFlow id="SF_AddToCart" name="" sourceRef="Task_SelectProduct" targetRef="Task_AddToCart"/>

    <bpmn:sequenceFlow id="SF_CheckAllProducts" sourceRef="Task_AddToCart" targetRef="ExclusiveGateway_ProductSelected"/>

    <bpmn:sequenceFlow id="SF_PaymentShipmentStart" name="Yes - All selected" sourceRef="ExclusiveGateway_ProductSelected" targetRef="InclusiveGateway_PaymentShipment">
      <bpmn:name>Order finished by system</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SF_ProductLoopBack" name="No - More products needed" sourceRef="ExclusiveGateway_ProductSelected" targetRef="Task_SelectProduct"/>

    <bpmn:parallelGateway id="Parallel_Gateway_PaymentAddressConverge">
      <bpmn:incoming>SF_AddressDone</bpmn:incoming>
      <bpmn:incoming>SF_PaymentConfirm</bpmn:incoming>
      <bpmn:outgoing>SF_OrderFinished</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:sequenceFlow id="SF_AddressProcess" sourceRef="InclusiveGateway_PaymentShipment" targetRef="Task_EnterShippingAddress"/>

    <bpmn:sequenceFlow id="SF_AddressDone" name="" sourceRef="Task_EnterShippingAddress" targetRef="Parallel_Gateway_PaymentAddressConverge"/>

    <bpmn:sequenceFlow id="SF_PaymentProcess" sourceRef="InclusiveGateway_PaymentShipment" targetRef="Task_EnterPaymentData"/>

    <bpmn:sequenceFlow id="SF_WaitBankConfirm" name="" sourceRef="Task_EnterPaymentData" targetRef="Parallel_Gateway_BankWait">
      <bpmn:name>Wait for bank confirmation</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:endEvent id="EndEvent_PaymentConfirmed" name="Bank confirms payment"/>

    <bpmn:parallelGateway id="Parallel_Gateway_BankWait">
      <bpmn:incoming>SF_WaitBankConfirm</bpmn:incoming>
      <bpmn:outgoing>SF_PaymentConfirm</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:sequenceFlow id="SF_PaymentConfirm" name="" sourceRef="Parallel_Gateway_BankWait" targetRef="ExclusiveGateway_AddressPaymentDone"/>

    <bpmn:sequenceFlow id="SF_OrderFinished" sourceRef="ExclusiveGateway_AddressPaymentDone" targetRef="EndEvent_OrderFinished">
      <bpmn:name>Order finished by system</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>