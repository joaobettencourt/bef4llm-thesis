<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Austria_Immigration" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_Austria_Process">
    <bpmn:participant id="Participant_Citizen" name="Citizen Application Process" processRef="Process_Main"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Main" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Citizen" name="Citizen/Applicant">
        <bpmn:flowNodeRef>StartEvent_Application</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckRequirements</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_AccommodationBank</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_VisaDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OrganizeAccommodation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OpenBankAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareVisaDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_DocsComplete</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Authorities" name="Austrian Authorities/BMEIA">
        <bpmn:flowNodeRef>InclusiveGateway_VisaReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InitialVisaCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_DecisionApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_VisaApproved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RequestAdditionalDocs</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Application" name="Begin Application Process">
      <bpmn:outgoing>SF_StartToRequirements</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Tasks - Citizen Lane -->
    <bpmn:task id="Task_CheckRequirements" name="Check Requirements for Work &amp; Living in Austria">
      <bpmn:incoming>SF_StartToRequirements</bpmn:incoming>
      <bpmn:outgoing>SF_ReviewAccommodationBank</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway for Accommodation and Bank Account -->
    <bpmn:parallelGateway id="ParallelGateway_AccommodationBank" name="">
      <bpmn:incoming>SF_ReviewAccommodationBank</bpmn:incoming>
      <bpmn:outgoing>SF_OrganizeAccommodation</bpmn:outgoing>
      <bpmn:outgoing>SF_OpenBankAccount</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Accommodation Task -->
    <bpmn:task id="Task_OrganizeAccommodation" name="Organize Accommodation">
      <bpmn:incoming>SF_OrganizeAccommodation</bpmn:incoming>
      <bpmn:outgoing>SF_AccommodationComplete</bpmn:outgoing>
    </bpmn:task>

    <!-- Bank Account Task -->
    <bpmn:task id="Task_OpenBankAccount" name="Open Bank Account (Negotiation)">
      <bpmn:incoming>SF_OpenBankAccount</bpmn:incoming>
      <bpmn:outgoing>SF_BankComplete</bpmn:outgoing>
    </bpmn:task>

    <!-- Visa Documents Preparation -->
    <bpmn:inclusiveGateway id="InclusiveGateway_VisaDocs" name="">
      <bpmn:incoming>SF_AccommodationComplete</bpmn:incoming>
      <bpmn:incoming>SF_BankComplete</bpmn:incoming>
      <bpmn:outgoing>SF_PrepareVisaApplicationForm</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Visa Document Tasks -->
    <bpmn:task id="Task_VisaAppForm" name="Complete Visa Application Form">
      <bpmn:incoming>SF_PrepareVisaApplicationForm</bpmn:incoming>
      <bpmn:outgoing>SF_FormReady</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_TravelDocument" name="Prepare Valid Travel Document (Passport)">
      <bpmn:incoming>SF_PrepareTravelDoc</bpmn:incoming>
      <bpmn:outgoing>SF_DocReady</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_PassportPhoto" name="Prepare Passport Photo (35x45mm)">
      <bpmn:incoming>SF_PreparePhoto</bpmn:incoming>
      <bpmn:outgoing>SF_PhotoReady</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_HealthInsurance" name="Obtain Travel Health Insurance (30,000 Euro)">
      <bpmn:incoming>SF_PrepareInsurance</bpmn:incoming>
      <bpmn:outgoing>SF_InsReady</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_MeansSubsistence" name="Prepare Proof of Means of Subsistence">
      <bpmn:incoming>SF_PrepareMeans</bpmn:incoming>
      <bpmn:outgoing>SF_MeansReady</bpmn:outgoing>
    </bpmn:task>

    <!-- Visa Review Gateway -->
    <bpmn:inclusiveGateway id="InclusiveGateway_VisaReview" name="">
      <bpmn:incoming>SF_FormReady</bpmn:incoming>
      <bpmn:incoming>SF_DocReady</bpmn:incoming>
      <bpmn:incoming>SF_PhotoReady</bpmn:incoming>
      <bpmn:incoming>SF_InsReady</bpmn:incoming>
      <bpmn:incoming>SF_MeansReady</bpmn:incoming>
      <bpmn:outgoing>SF_SubmitToAuthorities</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Submit to Authorities -->
    <bpmn:task id="Task_PrepareVisaDocs" name="Prepare All Visa Documents">
      <bpmn:incoming>SF_VisaReviewComplete</bpmn:incoming>
      <bpmn:outgoing>SF_SubmitToAuthorities</bpmn:outgoing>
    </bpmn:task>

    <!-- Decision Gateway - Docs Complete -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_DocsComplete" name="All Documents&#10;Ready?">
      <bpmn:incoming>SF_SubmitToAuthorities</bpmn:incoming>
      <bpmn:outgoing>SF_InitialVisaCheck</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Authority Tasks -->
    <bpmn:task id="Task_InitialVisaCheck" name="Perform Initial Visa Check">
      <bpmn:incoming>SF_InitialVisaCheck</bpmn:incoming>
      <bpmn:outgoing>SF_DecisionApproval</bpmn:outgoing>
    </bpmn:task>

    <!-- Decision Gateway - Approval -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_DecisionApproval" name="Visa&#10;Approved?">
      <bpmn:incoming>SF_DecisionApproval</bpmn:incoming>
      <bpmn:outgoing>SF_ApprovedFlow</bpmn:outgoing>
      <bpmn:outgoing>SF_RequestAdditionalDocs</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_VisaApproved" name="Visa Approved&#10;(Rot-Weiss-Rot Card)">
      <bpmn:incoming>SF_ApprovedFlow</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Additional Docs Task -->
    <bpmn:task id="Task_RequestAdditionalDocs" name="Request Additional Documents">
      <bpmn:incoming>SF_RequestAdditionalDocs</bpmn:incoming>
      <bpmn:outgoing>SF_ReviewRequirementsAgain</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SF_StartToRequirements" sourceRef="StartEvent_Application" targetRef="Task_CheckRequirements"/>
    
    <bpmn:sequenceFlow id="SF_ReviewAccommodationBank" name="" sourceRef="Task_CheckRequirements" targetRef="ParallelGateway_AccommodationBank"/>
    
    <bpmn:sequenceFlow id="SF_OrganizeAccommodation" name="" sourceRef="ParallelGateway_AccommodationBank" targetRef="Task_OrganizeAccommodation"/>
    
    <bpmn:sequenceFlow id="SF_OpenBankAccount" name="" sourceRef="ParallelGateway_AccommodationBank" targetRef="Task_OpenBankAccount"/>
    
    <bpmn:sequenceFlow id="SF_AccommodationComplete" name="" sourceRef="Task_OrganizeAccommodation" targetRef="InclusiveGateway_VisaDocs"/>
    
    <bpmn:sequenceFlow id="SF_BankComplete" name="" sourceRef="Task_OpenBankAccount" targetRef="InclusiveGateway_VisaDocs"/>

    <!-- Visa Document Preparation Flows -->
    <bpmn:sequenceFlow id="SF_PrepareVisaApplicationForm" name="" sourceRef="InclusiveGateway_VisaDocs" targetRef="Task_VisaAppForm"/>
    
    <bpmn:sequenceFlow id="SF_PrepareTravelDoc" name="" sourceRef="InclusiveGateway_VisaDocs" targetRef="Task_TravelDocument"/>
    
    <bpmn:sequenceFlow id="SF_PreparePhoto" name="" sourceRef="InclusiveGateway_VisaDocs" targetRef="Task_PassportPhoto"/>
    
    <bpmn:sequenceFlow id="SF_PrepareInsurance" name="" sourceRef="InclusiveGateway_VisaDocs" targetRef="Task_HealthInsurance"/>
    
    <bpmn:sequenceFlow id="SF_PrepareMeans" name="" sourceRef="InclusiveGateway_VisaDocs" targetRef="Task_MeansSubsistence"/>

    <!-- Document Completion Flows -->
    <bpmn:sequenceFlow id="SF_FormReady" name="" sourceRef="Task_VisaAppForm" targetRef="InclusiveGateway_VisaReview"/>
    
    <bpmn:sequenceFlow id="SF_DocReady" name="" sourceRef="Task_TravelDocument" targetRef="InclusiveGateway_VisaReview"/>
    
    <bpmn:sequenceFlow id="SF_PhotoReady" name="" sourceRef="Task_PassportPhoto" targetRef="InclusiveGateway_VisaReview"/>
    
    <bpmn:sequenceFlow id="SF_InsReady" name="" sourceRef="Task_HealthInsurance" targetRef="InclusiveGateway_VisaReview"/>
    
    <bpmn:sequenceFlow id="SF_MeansReady" name="" sourceRef="Task_MeansSubsistence" targetRef="InclusiveGateway_VisaReview"/>

    <!-- Authority Review Flows -->
    <bpmn:sequenceFlow id="SF_SubmitToAuthorities" name="" sourceRef="Task_PrepareVisaDocs" targetRef="ExclusiveGateway_DocsComplete"/>
    
    <bpmn:sequenceFlow id="SF_InitialVisaCheck" name="" sourceRef="ExclusiveGateway_DocsComplete" targetRef="Task_InitialVisaCheck"/>
    
    <bpmn:sequenceFlow id="SF_DecisionApproval" name="" sourceRef="Task_InitialVisaCheck" targetRef="ExclusiveGateway_DecisionApproval"/>

    <!-- Approval/Rejection Flows -->
    <bpmn:sequenceFlow id="SF_ApprovedFlow" name="yes" sourceRef="ExclusiveGateway_DecisionApproval" targetRef="EndEvent_VisaApproved"/>
    
    <bpmn:sequenceFlow id="SF_RequestAdditionalDocs" name="no - Additional Docs Needed" sourceRef="ExclusiveGateway_DecisionApproval" targetRef="Task_RequestAdditionalDocs"/>

  </bpmn:process>
</bpmn:definitions>