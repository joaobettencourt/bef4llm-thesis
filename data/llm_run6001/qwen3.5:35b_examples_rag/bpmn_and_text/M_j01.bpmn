<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                 xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" 
                 xmlns:di="http://www.omg.org/spec/DD/20100524/DI" 
                 xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" 
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 id="Definitions_ChainsawProcess" targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:collaboration id="Collab_ChainsawManufacturing">
    <bpmn:participant id="Participant_Manufacturing" name="Chainsaw Manufacturing Process" processRef="Process_ChainsawProduction"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_ChainsawProduction" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="Start_CustomerOrderReceived" name="Customer Order Received">
      <bpmn:outgoing>SF_StartToParallelOrders</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Parallel Gateway for ordering parts from various sources -->
    <bpmn:parallelGateway id="GW_ParallelOrdering" name="">
      <bpmn:incoming>SF_StartToParallelOrders</bpmn:incoming>
      <bpmn:outgoing>SF_OrderGuideBar</bpmn:outgoing>
      <bpmn:outgoing>SF_OrderChainWidth</bpmn:outgoing>
      <bpmn:outgoing>SF_OrderMotorElectric</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Order Guide Bar -->
    <bpmn:userTask id="Task_OrderGuideBar" name="Order guide bar">
      <bpmn:incoming>SF_OrderGuideBar</bpmn:incoming>
      <bpmn:outgoing>SF_GuideBarArrived</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Order Chain Width -->
    <bpmn:userTask id="Task_OrderChainWidth" name="Order chain width">
      <bpmn:incoming>SF_OrderChainWidth</bpmn:incoming>
      <bpmn:outgoing>SF_ChainArrived</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Order Motor/Electric -->
    <bpmn:userTask id="Task_OrderMotorElectric" name="Order motor/electric parts">
      <bpmn:incoming>SF_OrderMotorElectric</bpmn:incoming>
      <bpmn:outgoing>SF_MotorArrived</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Intermediate Events for Parts Arriving -->
    <bpmn:intermediateCatchEvent id="Int_Event_GuideBar" name="Guide bar arrived">
      <bpmn:incoming>SF_GuideBarArrived</bpmn:incoming>
      <bpmn:outgoing>SF_PartInspectionGateway1</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:intermediateCatchEvent id="Int_Event_Chain" name="Chain arrived">
      <bpmn:incoming>SF_ChainArrived</bpmn:incoming>
      <bpmn:outgoing>SF_PartInspectionGateway2</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:intermediateCatchEvent id="Int_Event_Motor" name="Motor arrived">
      <bpmn:incoming>SF_MotorArrived</bpmn:incoming>
      <bpmn:outgoing>SF_PartInspectionGateway3</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Convergence of all parts arriving -->
    <bpmn:parallelGateway id="GW_PartsConverge" name="">
      <bpmn:incoming>SF_PartInspectionGateway1</bpmn:incoming>
      <bpmn:incoming>SF_PartInspectionGateway2</bpmn:incoming>
      <bpmn:incoming>SF_PartInspectionGateway3</bpmn:incoming>
      <bpm