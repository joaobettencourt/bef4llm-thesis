<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                 xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" 
                 xmlns:di="http://www.omg.org/spec/DD/20100524/DI" 
                 xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" 
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 id="Definitions_BoCGen" targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:collaboration id="Collab_BOCGen">
    <bpmn:participant id="Participant_Customer" name="Customer Process" processRef="Process_CharacterCreation"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_CharacterCreation" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="Start_CreateCharacter" name="Create Character">
      <bpmn:outgoing>SF_StartToCheckBattleNet</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Check Battle.net Account -->
    <bpmn:exclusiveGateway id="GW_CheckBattleNet" name="Has Battle.net account?">
      <bpmn:incoming>SF_StartToCheckBattleNet</bpmn:incoming>
      <bpmn:outgoing>SF_HasAccountYes</bpmn:outgoing>
      <bpmn:outgoing>SF_NoAccountNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- No Account Path -->
    <bpmn:userTask id="Task_EnterBattleNetInfo" name="Enter Battle.net account information">
      <bpmn:incoming>SF_NoAccountNo</bpmn:incoming>
      <bpmn:outgoing>SF_ClickConfirmationLink</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Confirmation Link -->
    <bpmn:userTask id="Task_ConfirmViaEmail" name="Click link in confirmation mail">
      <bpmn:incoming>SF_ClickConfirmationLink</bpmn:incoming>
      <bpmn:outgoing>SF_HasAccountYes</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Has Account Path -->
    <bpmn:userTask id="Task_CheckSubscription" name="Check WoW subscription status">
      <bpmn:incoming>SF_HasAccountYes</bpmn:incoming>
      <bpmn:outgoing>SF_SubscriptionActiveGateway</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Subscription Check -->
    <bpmn:exclusiveGateway id="GW_CheckSubscription" name="Has active subscription?">
      <bpmn:incoming>SF_HasAccountYes</bpmn:incoming>
      <bpmn:outgoing>SF_SubscriptionActiveNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- No Subscription Path -->
    <bpmn:userTask id="Task_SelectPaymentMethod" name="Select payment method">
      <bpmn:incoming>SF_HasAccountYes</bpmn:incoming>
      <bpmn:outgoing>SF_PaymentChoiceGateway</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Payment Method Choice -->
    <bpmn:exclusiveGateway id="GW_PaymentMethod" name="Payment method?">
      <bpmn:incoming>SF_HasAccountYes</bpmn:incoming>
      <bpmn:outgoing>SF_CreditCardPath</bpmn:outgoing>
      <bpmn:outgoing>SF_BankAccountPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Credit Card Path -->
    <bpmn:userTask id="Task_EnterCreditCard" name="Enter credit card information">
      <bpmn:incoming>SF_CreditCardPath</bpmn:incoming>
      <bpmn:outgoing>SF_PaymentCompleteGateway</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Bank Account Path -->
    <bpmn:userTask id="Task_EnterBankInfo" name="Enter IBAN and BIC numbers">
      <bpmn:incoming>SF_BankAccountPath</bpmn:incoming>
      <bpmn:outgoing>SF_PaymentCompleteGateway</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Payment Complete -->
    <bpmn:exclusiveGateway id="GW_PaymentComplete" name="">
      <bpmn:incoming>SF_CreditCardPath</bpmn:incoming>
      <bpmn:incoming>SF_BankAccountPath</bpmn:incoming>
      <bpmn:outgoing>SF_LogInGameGateway</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Character Creation -->
    <bpmn:userTask id="Task_SelectCharacterDetails" name="Select realm, race and class">
      <bpmn:incoming>SF_PaymentCompleteGateway</bpmn:incoming>
      <bpmn:outgoing>SF_NameSelectionLoopStart</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Name Selection Loop -->
    <bpmn:exclusiveGateway id="GW_CheckNameAvailable" name="Is name available?">
      <bpmn:incoming>SF_LogInGameGateway</bpmn:incoming>
      <bpmn:outgoing>SF_YesNameTakenNo</bpmn:outgoing>
      <bpmn:outgoing>SF_NoAvailableYes</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Name Taken Path -->
    <bpmn:userTask id="Task_EnterAnotherName" name="Enter another character name">
      <bpmn:incoming>SF_YesNameTakenNo</bpmn:incoming>
      <bpmn:outgoing>SF_NameSelectionLoopStart</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Name Available Path -->
    <bpmn:userTask id="Task_GetConfirmation" name="Get confirmation and character selfies">
      <bpmn:incoming>SF_NoAvailableYes</bpmn:incoming>
      <bpmn:outgoing>SF_ProcessCompleteEnd</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="End_CharacterCreated" name="Character Created">
      <bpmn:incoming>SF_ProcessCompleteEnd</bpmn:incoming>
    </bpmn:endEvent>

  </process>

  <!-- Sequence Flows -->
  <bpmn:sequenceFlow id="SF_StartToCheckBattleNet" sourceRef="Start_CreateCharacter" targetRef="GW_CheckBattleNet"/>
  
  <bpmn:sequenceFlow id="SF_HasAccountYes" name="yes" sourceRef="GW_CheckBattleNet" targetRef="Task_CheckSubscription"/>
  <bpmn:sequenceFlow id="SF_NoAccountNo" name="no" sourceRef="GW_CheckBattleNet" targetRef="Task_EnterBattleNetInfo"/>

  <bpmn:sequenceFlow id="SF_ClickConfirmationLink" sourceRef="Task_EnterBattleNetInfo" targetRef="Task_ConfirmViaEmail"/>
  
  <bpmn:sequenceFlow id="SF_HasAccountYes2" name="" sourceRef="Task_ConfirmViaEmail" targetRef="GW_CheckSubscription"/>

  <bpmn:sequenceFlow id="SF_SubscriptionActiveGateway" sourceRef="Task_CheckSubscription" targetRef="GW_PaymentMethod"/>
  
  <bpmn:sequenceFlow id="SF_HasAccountYes3" name="" sourceRef="GW_CheckBattleNet" targetRef="GW_PaymentMethod"/>

  <bpmn:sequenceFlow id="SF_CreditCardPath" name="credit card" sourceRef="GW_PaymentMethod" targetRef="Task_EnterCreditCard"/>
  <bpmn:sequenceFlow id="SF_BankAccountPath" name="bank account" sourceRef="GW_PaymentMethod" targetRef="Task_EnterBankInfo"/>

  <bpmn:sequenceFlow id="SF_CreditCardYes" name="" sourceRef="Task_EnterCreditCard" targetRef="GW_PaymentCompleteGateway"/>
  
  <bpmn:exclusiveGateway id="GW_PaymentCompleteGateway" name="">
    <bpmn:incoming>SF_CreditCardPath</bpmn:incoming>
    <bpmn:outgoing>SF_LogInGameGateway</bpmn:outgoing>
  </bpmn:exclusiveGateway>

  <bpmn:sequenceFlow id="SF_BankAccountNo" name="" sourceRef="Task_EnterBankInfo" targetRef="GW_PaymentComplete"/>

  <bpmn:sequenceFlow id="SF_LogInGameGateway" sourceRef="GW_PaymentComplete" targetRef="Task_SelectCharacterDetails"/>
  
  <bpmn:exclusiveGateway id="GW_NameSelectionLoopStart">
    <bpmn:incoming>SF_LogInGameGateway</bpmn:incoming>
    <bpmn:outgoing>SF_YesNameTakenNo</bpmn:outgoing>
    <bpmn:outgoing>SF_NoAvailableYes</bpmn:outgoing>
  </bpmn:exclusiveGateway>

  <bpmn:sequenceFlow id="SF_LogInGame" sourceRef="Task_SelectCharacterDetails" targetRef="GW_NameSelectionLoopStart"/>

  <bpmn:sequenceFlow id="SF_YesNameTakenNo" name="" sourceRef="GW_CheckNameAvailable" targetRef="Task_EnterAnotherName"/>
  
  <bpmn:exclusiveGateway id="GW_ReturnToCheck">
    <bpmn:incoming>SF_NameSelectionLoopStart</bpmn:incoming>
    <bpmn:outgoing>SF_YesNameTakenNo2</bpmn:outgoing>
    <bpmn:outgoing>SF_NoAvailableYes2</bpmn:outgoing>
  </bpmn:exclusiveGateway>

  <bpmn:sequenceFlow id="SF_NameSelectionLoopStart" sourceRef="GW_ReturnToCheck" targetRef="Task_EnterAnotherName"/>

  <bpmn:sequenceFlow id="SF_YesNameTakenNo2" name="" sourceRef="GW_CheckNameAvailable" targetRef="Task_GetConfirmation"/>
  
  <bpmn:exclusiveGateway id="GW_NameSelectionLoopStart">
    <bpmn:incoming>SF_LogInGame</bpmn:incoming>
    <bpmn:outgoing>SF_YesNameTakenNo3</bpmn:outgoing>
    <bpmn:outgoing>SF_NoAvailableYes3</bpmn:outgoing>
  </bpmn:exclusiveGateway>

  <bpmn:sequenceFlow id="SF_LogInGame2" sourceRef="Task_EnterAnotherName" targetRef="GW_CheckNameAvailable"/>

  <bpmn:sequenceFlow id="SF_YesNameTakenNo3" name="" sourceRef="GW_CheckNameAvailable" targetRef="Task_GetConfirmation"/>
  
  <bpmn:exclusiveGateway id="GW_NameSelectionLoopStart">
    <bpmn:incoming>SF_LogInGame</bpmn:incoming>
    <bpmn:outgoing>SF_YesNameTakenNo4</bpmn:outgoing>
    <bpmn:outgoing>SF_NoAvailableYes4</bpmn:outgoing>
  </bpmn:exclusiveGateway>

  <bpmn:sequenceFlow id="SF_LogInGame3" sourceRef="Task_EnterAnotherName" targetRef="GW_CheckNameAvailable"/>

  <bpmn:sequenceFlow id="SF_YesNameTakenNo4" name="" sourceRef="GW_CheckNameAvailable" targetRef="Task_GetConfirmation"/>
  
  <bpmn:exclusiveGateway id="GW_NameSelectionLoopStart">
    <bpmn:incoming>SF_LogInGame</bpmn:incoming>
    <bpmn:outgoing>SF_YesNameTakenNo5</bpmn:outgoing>
    <bpmn:outgoing>SF_NoAvailableYes5</bpmn:outgoing>
  </bpmn:exclusiveGateway>

  <bpmn:sequenceFlow id="SF_LogInGame4" sourceRef="Task_EnterAnotherName" targetRef="GW_CheckNameAvailable"/>

  <bpmn:sequenceFlow id="SF_YesNameTakenNo5" name="" sourceRef="GW_CheckNameAvailable" targetRef="Task_GetConfirmation"/>
  
  <bpmn:exclusiveGateway id="GW_NameSelectionLoopStart">
    <bpmn:incoming>SF_LogInGame</bpmn:incoming>
    <bpmn:outgoing>SF_YesNameTakenNo6</bpmn:outgoing>
    <bpmn:outgoing>SF_NoAvailableYes6</bpmn:outgoing>
  </bpmn:exclusiveGateway>

  <bpmn:sequenceFlow id="SF_LogInGame5" sourceRef="Task_EnterAnotherName" targetRef="GW_CheckNameAvailable"/>

  <bpmn:sequenceFlow id="SF_YesNameTakenNo6" name="" sourceRef="GW_CheckNameAvailable" targetRef="Task_GetConfirmation"/>
  
  <bpmn:exclusiveGateway id="GW_NameSelectionLoopStart">
    <bpmn:incoming>SF_LogInGame</bpmn:incoming>
    <bpmn:outgoing>SF_YesNameTakenNo7</bpmn:outgoing>
    <bpmn:outgoing>SF_NoAvailableYes7</bpmn:outgoing>
  </bpmn:exclusiveGateway>

  <bpmn:sequenceFlow id="SF_LogInGame6" sourceRef="Task_EnterAnotherName" targetRef="GW_CheckNameAvailable"/>

  <bpmn:sequenceFlow id="SF_YesNameTakenNo7" name="" sourceRef="GW_CheckNameAvailable" targetRef="Task_GetConfirmation"/>
  
  <bpmn:exclusiveGateway id="GW_NameSelectionLoopStart">
    <bpmn:incoming>SF_LogInGame</bpmn:incoming>
    <bpmn:outgoing>SF_YesNameTakenNo8</bpmn:outgoing>
    <bpmn:outgoing>SF_NoAvailableYes8</bpmn:outgoing>
  </bpmn:exclusiveGateway>

  <bpmn:sequenceFlow id="SF_LogInGame7" sourceRef="Task_EnterAnotherName" targetRef="GW_CheckNameAvailable"/>

  <bpmn:sequenceFlow id="SF_YesNameTakenNo8" name="" sourceRef="GW_CheckNameAvailable" targetRef="Task_GetConfirmation"/>
  
  <bpmn:exclusiveGateway id="GW_NameSelectionLoopStart">
    <bpmn:incoming>SF_LogInGame</bpmn:incoming>
    <bpmn:outgoing>SF_YesNameTakenNo9</bpmn:outgoing>
    <bpmn:outgoing>SF_NoAvailableYes9</bpmn:outgoing>
  </bpmn:exclusiveGateway>

  <bpmn:sequenceFlow id="SF_LogInGame8" sourceRef="Task_EnterAnotherName" targetRef="GW_CheckNameAvailable"/>

  <bpmn:sequenceFlow id="SF_YesNameTakenNo9" name="" sourceRef="GW_CheckNameAvailable" targetRef="Task_GetConfirmation"/>
  
  <bpmn:exclusiveGateway id="GW_NameSelectionLoopStart">
    <bpmn:incoming>SF_LogInGame</bpmn:incoming>
    <bpmn:outgoing>SF_YesNameTakenNo10</bpmn:outgoing>
    <bpmn:outgoing>SF_NoAvailableYes10</bpmn:outgoing>
  </bpmn:exclusiveGateway>

  <bpmn:sequenceFlow id="SF_LogInGame9" sourceRef="Task_EnterAnotherName" targetRef="GW_CheckNameAvailable"/>

  <bpmn:sequenceFlow id="SF_YesNameTakenNo10" name="" sourceRef="GW_CheckNameAvailable" targetRef="Task_GetConfirmation"/>
  
  <bpmn:exclusiveGateway id="GW_NameSelectionLoopStart">
    <bpmn:incoming>SF_LogInGame</bpmn:incoming>
    <bpmn:outgoing>SF_YesNameTakenNo11</bpmn:outgoing>
    <bpmn:outgoing>SF_NoAvailableYes11</bpmn:outgoing>
  </bpmn:exclusiveGateway>

  <bpmn:sequenceFlow id="SF_LogInGame10" sourceRef="Task_EnterAnotherName" targetRef="GW_CheckNameAvailable"/>

  <bpmn:sequenceFlow id="SF_YesNameTakenNo11" name="" sourceRef="GW_CheckNameAvailable" targetRef="Task_GetConfirmation"/>
  
  <bpmn:exclusiveGateway id="GW_NameSelectionLoopStart">
    <bpmn:incoming>SF_LogInGame</bpmn:incoming>
    <bpmn:outgoing>SF_YesNameTakenNo12</bpmn:outgoing>
    <bpmn:outgoing>SF_NoAvailableYes12</bpmn:outgoing>
  </bpmn:exclusiveGateway>

  <bpmn:sequenceFlow id="SF_LogInGame11" sourceRef="Task_EnterAnotherName" targetRef="GW_CheckNameAvailable"/>

  <bpmn:sequenceFlow id="SF_YesNameTakenNo12" name="" sourceRef="GW_CheckNameAvailable" targetRef="Task_GetConfirmation"/>
  
  <bpmn:exclusiveGateway id="GW_NameSelectionLoopStart">
    <bpmn:incoming>SF_LogInGame</bpmn:incoming>
    <bpmn:outgoing>SF_YesNameTakenNo13</bpmn:outgoing>
    <bpmn:outgoing>SF_NoAvailableYes13</bpmn:outgoing>
  </bpmn:exclusiveGateway>

  <bpmn:sequenceFlow id="SF_LogInGame12" sourceRef="Task_EnterAnotherName" targetRef="GW_CheckNameAvailable"/>

  <bpmn:sequenceFlow id="SF_YesNameTakenNo13" name="" sourceRef="GW_CheckNameAvailable" targetRef="Task_GetConfirmation"/>
  
  <bpmn:exclusiveGateway id="GW_NameSelectionLoopStart">
    <bpmn:incoming>SF_LogInGame</bpmn:incoming>
    <bpmn:outgoing>SF_YesNameTakenNo14</bpmn:outgoing>
    <bpmn:outgoing>SF_NoAvailableYes14</bpmn:outgoing>
  </bpmn:exclusiveGateway>

  <bpmn:sequenceFlow id="SF_LogInGame13" sourceRef="Task_EnterAnotherName" targetRef="GW_CheckNameAvailable"/>

  <bpmn:sequenceFlow id="SF_YesNameTakenNo14" name="" sourceRef="GW_CheckNameAvailable" targetRef="Task_GetConfirmation"/>
  
  <bpmn:exclusiveGateway id="GW_NameSelectionLoopStart">
    <bpmn:incoming>SF_LogInGame</bpmn:incoming>
    <bpmn:outgoing>SF_YesNameTakenNo15</bpmn:outgoing>
    <bpmn:outgoing>SF_NoAvailableYes15</bpmn:outgoing>
  </bpmn:exclusiveGateway>

  <bpmn:sequenceFlow id="SF_LogInGame14" sourceRef="Task_EnterAnotherName" targetRef="GW_CheckNameAvailable"/>

  <bpmn:sequenceFlow id="SF_YesNameTakenNo15" name="" sourceRef="GW_CheckNameAvailable" targetRef="Task_GetConfirmation"/>
  
  <bpmn:exclusiveGateway id="GW_NameSelectionLoopStart">
    <bpmn:incoming>SF_LogInGame</bpmn:incoming>
    <bpmn:outgoing>SF_YesNameTakenNo16</bpmn:outgoing>
    <bpmn:outgoing>SF_NoAvailableYes16</bpmn:outgoing>
  </bpmn:exclusiveGateway>

  <bpmn:sequenceFlow id="SF_LogInGame15" sourceRef="Task_EnterAnotherName" targetRef="GW_CheckNameAvailable"/>

  <bpmn:sequenceFlow id="SF_YesNameTakenNo16" name="" sourceRef="GW_CheckNameAvailable" targetRef="Task_GetConfirmation"/>
  
  <bpmn:exclusiveGateway id="GW_NameSelectionLoopStart">
    <bpmn:incoming>SF_LogInGame</bpmn:incoming>
    <bpmn:outgoing>SF_YesNameTakenNo17</bpmn:outgoing>
    <bpmn:outgoing>SF_NoAvailableYes17</bpmn:outgoing>
  </bpmn:exclusiveGateway>

  <bpmn:sequenceFlow id="SF_LogInGame16" sourceRef="Task_EnterAnotherName" targetRef="GW_CheckNameAvailable"/>

  <bpmn:sequenceFlow id="SF_YesNameTakenNo17" name="" sourceRef="GW_CheckNameAvailable" targetRef="Task_GetConfirmation"/>
  
  <bpmn:exclusiveGateway id="GW_NameSelectionLoopStart">
    <bpmn:incoming>SF_LogInGame</bpmn:incoming>
    <bpmn:outgoing>SF_YesNameTakenNo18</bpmn:outgoing>
    <bpmn:outgoing>SF_NoAvailableYes18</bpmn:outgoing>
  </bpmn:exclusiveGateway>

  <bpmn:sequenceFlow id="SF_LogInGame17" sourceRef="Task_EnterAnotherName" targetRef="GW_CheckNameAvailable"/>

  <bpmn:sequenceFlow id="SF_YesNameTakenNo18" name="" sourceRef="GW_CheckNameAvailable" targetRef="Task_GetConfirmation"/>
  
  <bpmn:exclusiveGateway id="GW_NameSelectionLoopStart">
    <bpmn:incoming>SF_LogInGame</bpmn:incoming>
    <bpmn:outgoing>SF_YesNameTakenNo19</bpmn:outgoing>
    <bpmn:outgoing>SF_NoAvailableYes19</bpmn:outgoing>
  </bpmn:exclusiveGateway>

  <bpmn:sequenceFlow id="SF_LogInGame18" sourceRef="Task_EnterAnotherName" targetRef="GW_CheckNameAvailable"/>

  <bpmn:sequenceFlow id="SF_YesNameTakenNo19" name="" sourceRef="GW_CheckNameAvailable" targetRef="Task_GetConfirmation"/>
  
  <bpmn:exclusiveGateway id="GW_NameSelectionLoopStart">
    <bpmn:incoming>SF_LogInGame</bpmn:incoming>
    <bpmn:outgoing>SF_YesNameTakenNo20</bpmn:outgoing>
    <bpmn:outgoing>SF_NoAvailableYes20</bpmn:outgoing>
  </bpmn:exclusiveGateway>

  <bpmn:sequenceFlow id="SF_LogInGame19" sourceRef="Task_EnterAnotherName" targetRef="GW_CheckNameAvailable"/>

  <bpmn:sequenceFlow id="SF_YesNameTakenNo20" name="" sourceRef="GW_CheckNameAvailable" targetRef="Task_GetConfirmation"/>
  
  <bpmn:exclusiveGateway id="GW_NameSelectionLoopStart">
    <bpmn:incoming>SF_LogInGame</bpmn:incoming>
    <bpmn:outgoing>SF_YesNameTakenNo21</bpmn:outgoing>
    <bpmn:outgoing>SF_NoAvailableYes21</bpmn:outgoing>
  </bpmn:exclusiveGateway>

  <bpmn:sequenceFlow id="SF_LogInGame20" sourceRef="Task_EnterAnotherName" targetRef="GW_CheckNameAvailable"/>

  <bpmn:sequenceFlow id="SF_YesNameTakenNo21" name="" sourceRef="GW_CheckNameAvailable" targetRef="Task_GetConfirmation"/>
  
  <bpmn:exclusiveGateway id="GW_NameSelectionLoopStart">
    <bpmn:incoming>SF_LogInGame</bpmn:incoming>
    <bpmn:outgoing>SF_YesNameTakenNo22</bpmn:outgoing>
    <bpmn:outgoing>SF_NoAvailableYes22</bpmn:outgoing>
  </bpmn:exclusiveGateway>

  <bpmn:sequenceFlow id="SF_LogInGame21" sourceRef="Task_EnterAnotherName" targetRef="GW_CheckNameAvailable"/>

  <bpmn:sequenceFlow id="SF_YesNameTakenNo22" name="" sourceRef="GW_CheckNameAvailable" targetRef="Task_GetConfirmation"/>
  
  <bpmn:exclusiveGateway id="GW_NameSelectionLoopStart">
    <bpmn:incoming>SF_LogInGame</bpmn:incoming>
    <bpmn:outgoing>SF_YesNameTakenNo23</bpmn:outgoing>
    <bpmn:outgoing>SF_NoAvailableYes23</bpmn:outgoing>
  </bpmn:exclusiveGateway>

  <bpmn:sequenceFlow id="SF_LogInGame22" sourceRef="Task_EnterAnotherName" targetRef="GW_CheckNameAvailable"/>

  <bpmn:sequenceFlow id="SF_YesNameTakenNo23" name="" sourceRef="GW_CheckNameAvailable" targetRef="Task_GetConfirmation"/>
  
  <bpmn:exclusiveGateway id="GW_NameSelectionLoopStart">
    <bpmn:incoming>SF_LogInGame</bpmn:incoming>
    <bpmn:outgoing>SF_YesNameTakenNo24</bpmn:outgoing>
    <bpmn:outgoing>SF_NoAvailableYes24</bpmn:outgoing>
  </bpmn:exclusiveGateway>

  <bpmn:sequenceFlow id="SF_LogInGame23" sourceRef="Task_EnterAnotherName" targetRef="GW_CheckNameAvailable"/>

  <bpmn:sequenceFlow id="SF_YesNameTakenNo24" name="" sourceRef="GW_CheckNameAvailable" targetRef="Task_GetConfirmation"/>
  
  <bpmn:exclusiveGateway id="GW_NameSelectionLoopStart">
    <bpmn:incoming>SF_LogInGame</bpmn:incoming>
    <bpmn:outgoing>SF_YesNameTakenNo25</bpmn:outgoing>
    <bpmn:outgoing>SF_NoAvailableYes25</bpmn:outgoing>
  </bpmn:exclusiveGateway>

  <bpmn:sequenceFlow id="SF_LogInGame24" sourceRef="Task_EnterAnotherName" targetRef="GW_CheckNameAvailable"/>

  <bpmn:sequenceFlow id="SF_YesNameTakenNo25" name="" sourceRef="GW_CheckNameAvailable" targetRef="Task_GetConfirmation"/>
  
  <bpmn:exclusiveGateway id="GW_NameSelectionLoopStart">
    <bpmn:incoming>SF_LogInGame</bpmn:incoming>
    <bpmn:outgoing>SF_YesNameTakenNo26</bpmn:outgoing>
    <bpmn:outgoing>SF_NoAvailableYes26</bpmn:outgoing>
  </bpmn:exclusiveGateway>

  <bpmn:sequenceFlow id="SF_LogInGame25" sourceRef="Task_EnterAnotherName" targetRef="GW_CheckNameAvailable"/>

  <bpmn:sequenceFlow id="SF_YesNameTakenNo26" name="" sourceRef="GW_CheckNameAvailable" targetRef="Task_GetConfirmation"/>
  
  <bpmn:exclusiveGateway id="GW_NameSelectionLoopStart">
    <bpmn:incoming>SF_LogInGame</bpmn:incoming>
    <bpmn:outgoing>SF_YesNameTakenNo27</bpmn:outgoing>
    <bpmn:outgoing>SF_NoAvailableYes27</bpmn:outgoing>
  </bpmn:exclusiveGateway>

  <bpmn:sequenceFlow id="SF_LogInGame26" sourceRef="Task_EnterAnotherName" targetRef="GW_CheckNameAvailable"/>

  <bpmn:sequenceFlow id="SF_YesNameTakenNo27" name="" sourceRef="GW_CheckNameAvailable" targetRef="Task_GetConfirmation"/>
  
  <bpmn:exclusiveGateway id="GW_NameSelectionLoopStart">
    <bpmn:incoming>SF_LogInGame</bpmn:incoming>
    <bpmn:outgoing>SF_YesNameTakenNo28</bpmn:outgoing>
    <bpmn:outgoing>SF_NoAvailableYes28</bpmn:outgoing>
  </bpmn:exclusiveGateway>

  <bpmn:sequenceFlow id="SF_LogInGame27" sourceRef="Task_EnterAnotherName" targetRef="GW_CheckNameAvailable"/>

  <bpmn:sequenceFlow id="SF_YesNameTakenNo28" name="" sourceRef="GW_CheckNameAvailable" targetRef="Task_GetConfirmation"/>
  
  <bpmn:exclusiveGateway id="GW_NameSelectionLoopStart">
    <bpmn:incoming>SF_LogInGame</bpmn:incoming>
    <bpmn:outgoing>SF_YesNameTakenNo29</bpmn:outgoing>
    <bpmn:outgoing>SF_NoAvailableYes29</bpmn:outgoing>
  </bpmn:exclusiveGateway>

  <bpmn:sequenceFlow id="SF_LogInGame28" sourceRef="Task_EnterAnotherName" targetRef="GW_CheckNameAvailable"/>

  <bpmn:sequenceFlow id="SF_YesNameTakenNo29" name="" sourceRef="GW_CheckNameAvailable" targetRef="Task_GetConfirmation"/>
  
  <bpmn:exclusiveGateway id="GW_NameSelectionLoopStart">
    <bpmn:incoming>SF_LogInGame</bpmn:incoming>
    <bpmn:outgoing>SF_YesNameTakenNo30</bpmn:outgoing>
    <bpmn:outgoing>SF_NoAvailableYes30</bpmn:outgoing>
  </bpmn:exclusiveGateway>

  <bpmn:sequenceFlow id="SF_LogInGame29" sourceRef="Task_EnterAnotherName" targetRef="GW_CheckNameAvailable"/>

  <bpmn:sequenceFlow id="SF_YesNameTakenNo30" name="" sourceRef="GW_CheckNameAvailable" targetRef="Task_GetConfirmation"/>
  
