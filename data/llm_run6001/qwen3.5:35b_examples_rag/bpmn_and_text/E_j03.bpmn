<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_WorkAccident_01" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_WorkAccident">
    <bpmn:participant id="Participant_Pool" name="Work Accident Reporting Process" processRef="Process_Main"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Main" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Reporter" name="Accident Reporter">
        <bpmn:flowNodeRef>StartEvent_Report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssessIncidentType</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Employee" name="Employee">
        <bpmn:flowNodeRef>ExclusiveGateway_IsInsured</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_ReportPath</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Employer" name="Employer">
        <bpmn:flowNodeRef>Task_ImmediateReportFatality</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_ReportToInsurance</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Report" name="Report Accident or Incident">
      <bpmn:outgoing>SF_AssessIncident</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Initial Assessment Task -->
    <bpmn:task id="Task_AssessIncidentType" name="Assess Incident Type and Reporter">
      <bpmn:incoming>SF_AssessIncident</bpmn:incoming>
      <bpmn:outgoing>SF_DetermineReporterPath</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for Insurance Status -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_IsInsured" name="Has Accident&#10;Insurance?">
      <bpmn:incoming>SF_DetermineReporterPath</bpmn:incoming>
      <bpmn:outgoing>SF_EmployeeReport</bpmn:outgoing>
      <bpmn:outgoing>SF_PrivateInsured</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Employee Reporting Path -->
    <bpmn:task id="Task_ImmediateReportFatality" name="Report Fatality/Serious Injury&#10;to Labour Inspectorate">
      <bpmn:incoming>SF_EmployeeReport</bpmn:incoming>
      <bpmn:outgoing>SF_ReportToInsuranceEmployee</bpmn:outgoing>
    </bpmn:task>

    <!-- Inclusive Gateway for Employee Reporting -->
    <bpmn:inclusiveGateway id="InclusiveGateway_ReportPath" name="">
      <bpmn:incoming>SF_DetermineReporterPath</bpmn:incoming>
      <bpmn:outgoing>SF_EmployeeReport</bpmn:outgoing>
      <bpmn:outgoing>SF_PrivateInsured</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Inclusive Gateway for Reporting to Insurance -->
    <bpmn:inclusiveGateway id="InclusiveGateway_ReportToInsurance" name="">
      <bpmn:incoming>SF_ReportToInsuranceEmployee</bpmn:incoming>
      <bpmn:outgoing>SF_EmployeeReportComplete</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Private Insurance Path -->
    <bpmn:task id="Task_PrivateWrittenReport" name="Submit Written Report&#10;to Provider">
      <bpmn:incoming>SF_PrivateInsured</bpmn:incoming>
      <bpmn:outgoing>SF_FatalityCheckPrivate</bpmn:outgoing>
    </bpmn:task>

    <!-- Private Insurance Inclusive Gateway -->
    <bpmn:inclusiveGateway id="InclusiveGateway_PrivateFatality" name="">
      <bpmn:incoming>SF_FatalityCheckPrivate</bpmn:incoming>
      <bpmn:outgoing>SF_PrivateComplete</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_EmployeeReport" name="Employee Report&#10;Complete">
      <bpmn:incoming>SF_ReportToInsuranceEmployee</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_PrivateReport" name="Private Insurance&#10;Report Complete">
      <bpmn:incoming>SF_FatalityCheckPrivate</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SF_AssessIncident" sourceRef="StartEvent_Report" targetRef="Task_AssessIncidentType"/>
    
    <bpmn:sequenceFlow id="SF_DetermineReporterPath" name="" sourceRef="Task_AssessIncidentType" targetRef="InclusiveGateway_ReportPath">
      <bpmn:name>Assessment Complete</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Employee Path Flows -->
    <bpmn:sequenceFlow id="SF_EmployeeReport" name="" sourceRef="InclusiveGateway_ReportPath" targetRef="Task_ImmediateReportFatality"/>
    
    <bpmn:sequenceFlow id="SF_PrivateInsured" name="" sourceRef="ExclusiveGateway_IsInsured" targetRef="Task_PrivateWrittenReport"/>

    <!-- Reporting to Insurance Flows -->
    <bpmn:sequenceFlow id="SF_ReportToInsuranceEmployee" name="" sourceRef="Task_ImmediateReportFatality" targetRef="InclusiveGateway_ReportToInsurance"/>
    
    <bpmn:sequenceFlow id="SF_EmployeeReportComplete" name="" sourceRef="InclusiveGateway_ReportToInsurance" targetRef="EndEvent_EmployeeReport"/>

    <!-- Private Insurance Flows -->
    <bpmn:sequenceFlow id="SF_FatalityCheckPrivate" name="" sourceRef="Task_PrivateWrittenReport" targetRef="InclusiveGateway_PrivateFatality"/>
    
    <bpmn:sequenceFlow id="SF_PrivateComplete" name="" sourceRef="InclusiveGateway_PrivateFatality" targetRef="EndEvent_PrivateReport"/>

  </process>
</bpmn:definitions>