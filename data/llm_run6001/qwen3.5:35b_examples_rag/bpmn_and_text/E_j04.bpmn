<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Internship_01" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_Internship">
    <bpmn:participant id="Participant_Pool" name="Internship Process" processRef="Process_Main"/>
  </bpmn:collaboration>

  <bpmn:message id="Msg_OfferReceived" />

  <bpmn:process id="Process_Main" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Candidate" name="Candidate">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterDetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CatchEvent_WaitOffer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_AcceptOffer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PWG_InternshipStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WriteStatusUpdate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_MoreUpdates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PWG_InternshipEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecommendCompany</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Company" name="Company">
        <bpmn:flowNodeRef>PWG_InternshipStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WriteFeedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_MoreFeedback</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Internship Application">
      <bpmn:outgoing>SF_StartToDetails</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Tasks -->
    <bpmn:task id="Task_EnterDetails" name="Enter Details&#10;(Topic, Money,&#10;Experience)">
      <bpmn:incoming>SF_StartToDetails</bpmn:incoming>
      <bpmn:outgoing>SF_DetailsToWaitOffer</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Catch Event (Message) -->
    <bpmn:intermediateCatchEvent id="CatchEvent_WaitOffer" name="Receive Offer">
      <bpmn:messageRef>Msg_OfferReceived</bpmn:messageRef>
      <bpmn:incoming>SF_DetailsToWaitOffer</bpmn:incoming>
      <bpmn:outgoing>SF_CatchToAcceptDecide</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Gateway for Offer Decision -->
    <bpmn:exclusiveGateway id="GW_AcceptOffer" name="Accept&#10;Offer?">
      <bpmn:incoming>SF_CatchToAcceptDecide</bpmn:incoming>
      <bpmn:outgoing>SF_DenyLoopBack</bpmn:outgoing>
      <bpmn:outgoing>SF_AcceptProceed</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Parallel Gateway for Internship Phase -->
    <bpmn:parallelGateway id="PWG_InternshipStart" name="">
      <bpmn:incoming>SF_AcceptProceed</bpmn:incoming>
      <bpmn:outgoing>SF_CandidateUpdatesLoop</bpmn:outgoing>
      <bpmn:outgoing>SF_CompanyFeedbackLoop</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Candidate Loop for Status Updates -->
    <bpmn:task id="Task_WriteStatusUpdate" name="Write Status&#10;Update">
      <bpmn:incoming>SF_CandidateUpdatesLoop</bpmn:incoming>
      <bpmn:outgoing>SF_UpdateToCheckCount</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for Update Count -->
    <bpmn:exclusiveGateway id="GW_MoreUpdates" name="More&#10;updates?">
      <bpmn:incoming>SF_UpdateToCheckCount</bpmn:incoming>
      <bpmn:outgoing>SF_LoopBackUpdate</bpmn:outgoing>
      <bpmn:outgoing>SF_ContinueInternshipEnd</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Company Loop for Feedback -->
    <bpmn:task id="Task_WriteFeedback" name="Write Feedback&#10;about Candidate">
      <bpmn:incoming>SF_CompanyFeedbackLoop</bpmn:incoming>
      <bpmn:outgoing>SF_FeedbackToCheckCount</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for Feedback Count -->
    <bpmn:exclusiveGateway id="GW_MoreFeedback" name="More&#10;feedback?">
      <bpmn:incoming>SF_FeedbackToCheckCount</bpmn:incoming>
      <bpmn:outgoing>SF_LoopBackFeedback</bpmn:outgoing>
      <bpmn:outgoing>SF_ContinueInternshipEndComp</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Parallel Gateway for Internship End -->
    <bpmn:parallelGateway id="PWG_InternshipJoin" name="">
      <bpmn:incoming>SF_CandidateUpdatesDone</bpmn:incoming>
      <bpmn:incoming>SF_CompanyFeedbackDone</bpmn:incoming>
      <bpmn:outgoing>SF_JoinToRecTask</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Recommendation Phase -->
    <bpmn:task id="Task_RecommendCompany" name="Recommend&#10;via Twitter">
      <bpmn:incoming>SF_JoinToRecTask</bpmn:incoming>
      <bpmn:outgoing>SF_RecToParallelTweets</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway for Tweets -->
    <bpmn:parallelGateway id="GW_SendTweetsSplit" name="">
      <bpmn:incoming>SF_RecToParallelTweets</bpmn:incoming>
      <bpmn:outgoing>SF_Tweet1Send</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_InternshipFinished" name="Internship&#10;Finished">
      <bpmn:incoming>SF_TweetsJoinToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SF_StartToDetails" sourceRef="StartEvent_1" targetRef="Task_EnterDetails"/>
    <bpmn:sequenceFlow id="SF_DetailsToWaitOffer" sourceRef="Task_EnterDetails" targetRef="CatchEvent_WaitOffer"/>
    <bpmn:sequenceFlow id="SF_CatchToAcceptDecide" sourceRef="CatchEvent_WaitOffer" targetRef="GW_AcceptOffer"/>

    <!-- Offer Decision -->
    <bpmn:sequenceFlow id="SF_DenyLoopBack" name="Deny" sourceRef="GW_AcceptOffer" targetRef="CatchEvent_WaitOffer"/>
    <bpmn:sequenceFlow id="SF_AcceptProceed" name="Accept" sourceRef="GW_AcceptOffer" targetRef="PWG_InternshipStart"/>

    <!-- Internship Parallel Split -->
    <bpmn:sequenceFlow id="SF_CandidateUpdatesLoop" sourceRef="PWG_InternshipStart" targetRef="Task_WriteStatusUpdate"/>
    <bpmn:sequenceFlow id="SF_CompanyFeedbackLoop" sourceRef="PWG_InternshipStart" targetRef="Task_WriteFeedback"/>

    <!-- Candidate Loop -->
    <bpmn:sequenceFlow id="SF_UpdateToCheckCount" sourceRef="Task_WriteStatusUpdate" targetRef="GW_MoreUpdates"/>
    <bpmn:sequenceFlow id="SF_LoopBackUpdate" name="Yes" sourceRef="GW_MoreUpdates" targetRef="Task_WriteStatusUpdate"/>
    <bpmn:sequenceFlow id="SF_ContinueInternshipEnd" name="No (3 updates)" sourceRef="GW_MoreUpdates" targetRef="PWG_InternshipJoin"/>

    <!-- Company Loop -->
    <bpmn:sequenceFlow id="SF_FeedbackToCheckCount" sourceRef="Task_WriteFeedback" targetRef="GW_MoreFeedback"/>
    <bpmn:sequenceFlow id="SF_LoopBackFeedback" name="Yes" sourceRef="GW_MoreFeedback" targetRef="Task_WriteFeedback"/>
    <bpmn:sequenceFlow id="SF_ContinueInternshipEndComp" name="No (3 feedback)" sourceRef="GW_MoreFeedback" targetRef="PWG_InternshipJoin"/>

    <!-- Recommendation -->
    <bpmn:sequenceFlow id="SF_JoinToRecTask" sourceRef="PWG_InternshipJoin" targetRef="Task_RecommendCompany"/>

    <!-- Parallel Tweets (Simplified) -->
    <bpmn:task id="Task_Tweet1" name="Send Tweet&#10;Friend A">
      <bpmn:incoming>SF_Tweet1Send</bpmn:incoming>
      <bpmn:outgoing>SF_TweetsJoinToEnd</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SF_RecToParallelTweets" sourceRef="Task_RecommendCompany" targetRef="GW_SendTweetsSplit"/>
    <bpmn:sequenceFlow id="SF_Tweet1Send" sourceRef="GW_SendTweetsSplit" targetRef="Task_Tweet1"/>

  </bpmn:process>
</bpmn:definitions>