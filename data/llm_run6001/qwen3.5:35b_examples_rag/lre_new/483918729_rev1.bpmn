<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_ProvisionProcess">
    <bpmn:participant id="Participant_Organization" name="Provision Team Organization" processRef="Process_PartitioningOrder"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_PartitioningOrder" isExecutable="true">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_ProvisionTeam" name="Provision Team">
        <bpmn:flowNodeRef>Task_IdentifyParts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_QuestionsAboutRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckAvailability</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PartsAvailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecordPetition</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OrderFromDaisuki</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_CustomerInteraction" name="Customer Interaction">
        <bpmn:flowNodeRef>StartEvent_CustomerRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SupplyPartsToCustomer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateThrowMessage_RequestMoreInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateCatchEvent_CustomerResponse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ContactCustomerWaitForCollection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_PaymentReceived</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_CustomerRequest" name="Customer Request Received">
      <bpmn:outgoing>SequenceFlow_StartToIdentify</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Identify Necessary Parts -->
    <bpmn:userTask id="Task_IdentifyParts" name="Identify necessary parts">
      <bpmn:incoming>SequenceFlow_StartToIdentify</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToQuestionsGateway</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway: Questions About Request -->
    <bpmn:exclusiveGateway id="Gateway_QuestionsAboutRequest" name="Any questions about request?">
      <bpmn:incoming>SequenceFlow_ToQuestionsGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RequestMoreInfo</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoQuestionsProceed</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Intermediate Throw Message -->
    <bpmn:intermediateThrowEvent id="IntermediateThrowMessage_RequestMoreInfo" name="Request More Information">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SequenceFlow_RequestMoreInfo</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitForCustomerResponse</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <!-- Intermediate Catch Event -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_CustomerResponse" name="Customer Response">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SequenceFlow_WaitForCustomerResponse</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ResponseToIdentifyParts</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Gateway: Parts Available -->
    <bpmn:exclusiveGateway id="Gateway_PartsAvailable" name="All parts available?">
      <bpmn:incoming>SequenceFlow_CheckAvailabilityResult</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AvailablePath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NotAvailablePath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Check Availability -->
    <bpmn:userTask id="Task_CheckAvailability" name="Check parts availability">
      <bpmn:incoming>SequenceFlow_NoQuestionsProceed</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AvailabilityResultToGateway</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Record Petition -->
    <bpmn:userTask id="Task_RecordPetition" name="Record petition">
      <bpmn:incoming>SequenceFlow_NotAvailablePath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PetitionToOrderDaisuki</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Order from Daisuki -->
    <bpmn:userTask id="Task_OrderFromDaisuki" name="Make order to Daisuki">
      <bpmn:incoming>SequenceFlow_PetitionToOrderDaisuki</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OrderToContactCustomer</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Contact Customer Wait for Collection -->
    <bpmn:userTask id="Task_ContactCustomerWaitForCollection" name="Contact customer (wait for collection)">
      <bpmn:incoming>SequenceFlow_OrderToContactCustomer</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CollectionToPaymentGateway</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Supply Parts to Customer -->
    <bpmn:userTask id="Task_SupplyPartsToCustomer" name="Supply parts to customer">
      <bpmn:incoming>SequenceFlow_AvailablePath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PartsSuppliedToEndEvent</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_PaymentReceived" name="Payment Received">
      <bpmn:incoming>SequenceFlow_CollectionToPaymentGateway</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_PartsSuppliedToEndEvent</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToIdentify" sourceRef="StartEvent_CustomerRequest" targetRef="Task_IdentifyParts">
      <bpmn:description>Customer request received by Provision Team</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ToQuestionsGateway" sourceRef="Task_IdentifyParts" targetRef="Gateway_QuestionsAboutRequest">
      <bpmn:description>Parts identified, check for questions</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Questions Branch -->
    <bpmn:sequenceFlow id="SequenceFlow_RequestMoreInfo" name="Yes - Ask Customer" sourceRef="Gateway_QuestionsAboutRequest" targetRef="IntermediateThrowMessage_RequestMoreInfo">
      <bpmn:description>Team has questions about request</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- No Questions Branch -->
    <bpmn:sequenceFlow id="SequenceFlow_NoQuestionsProceed" name="No - Proceed to Check Availability" sourceRef="Gateway_QuestionsAboutRequest" targetRef="Task_CheckAvailability">
      <bpmn:description>No questions, proceed with availability check</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Customer Response Loop -->
    <bpmn:sequenceFlow id="SequenceFlow_WaitForCustomerResponse" sourceRef="IntermediateThrowMessage_RequestMoreInfo" targetRef="IntermediateCatchEvent_CustomerResponse">
      <bpmn:description>Wait for customer response to information request</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Response Back to Identify Parts -->
    <bpmn:sequenceFlow id="SequenceFlow_ResponseToIdentifyParts" sourceRef="IntermediateCatchEvent_CustomerResponse" targetRef="Task_IdentifyParts">
      <bpmn:description>Customer provided additional information</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Availability Check Result -->
    <bpmn:sequenceFlow id="SequenceFlow_AvailabilityResultToGateway" sourceRef="Task_CheckAvailability" targetRef="Gateway_PartsAvailable">
      <bpmn:description>Parts availability check completed</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Available Path -->
    <bpmn:sequenceFlow id="SequenceFlow_AvailablePath" name="Yes - Parts Available" sourceRef="Gateway_PartsAvailable" targetRef="Task_SupplyPartsToCustomer">
      <bpmn:description>All parts are available in stock</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Not Available Path -->
    <bpmn:sequenceFlow id="SequenceFlow_NotAvailablePath" name="No - Parts Unavailable" sourceRef="Gateway_PartsAvailable" targetRef="Task_RecordPetition">
      <bpmn:description>Some parts not available, need to order</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Petition to Order -->
    <bpmn:sequenceFlow id="SequenceFlow_PetitionToOrderDaisuki" sourceRef="Task_RecordPetition" targetRef="Task_OrderFromDaisuki">
      <bpmn:description>Petition recorded, proceed with external order</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Order to Contact Customer -->
    <bpmn:sequenceFlow id="SequenceFlow_OrderToContactCustomer" sourceRef="Task_OrderFromDaisuki" targetRef="Task_ContactCustomerWaitForCollection">
      <bpmn:description>Daisuki order placed, contact customer</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Collection to Payment -->
    <bpmn:sequenceFlow id="SequenceFlow_CollectionToPaymentGateway" sourceRef="Task_ContactCustomerWaitForCollection" targetRef="EndEvent_PaymentReceived">
      <bpmn:description>Items collected by customer, final payment received</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Parts Supplied to End -->
    <bpmn:sequenceFlow id="SequenceFlow_PartsSuppliedToEndEvent" sourceRef="Task_SupplyPartsToCustomer" targetRef="EndEvent_PaymentReceived">
      <bpmn:description>Parts supplied, process complete</bpmn:description>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>