<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_AccountCreation">
    <bpmn:participant id="Participant_Client" name="PayPal Client&#10;" processRef="Process_Client"/>
    <bpmn:participant id="Participant_System" name="PayPal System&#10;">
      <bpmn:processRef="Process_System"/>
    </bpmn:participant>
  </bpmn:collaboration>

  <bpmn:process id="Process_Client">
    <bpmn:startEvent id="StartEvent_CreateAccount" name="Create PayPal Account&#10;">
      <bpmn:outgoing>SequenceFlow_StartToTypeSelection</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_SelectAccountType" name="Select account type">
      <bpmn:incoming>SequenceFlow_StartToTypeSelection</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TypeToDetailsEntry</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_AccountChoice" name="Account Type">
      <bpmn:incoming>SequenceFlow_StartToTypeSelection</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PersonalPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PremiumPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_EnterLoginDetails" name="Enter login details&#10;(email, password)">
      <bpmn:incoming>SequenceFlow_TypeToDetailsEntry</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DetailsToPersonalInfo</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_EnterPersonalDetails" name="Enter personal details&#10;(name, date of birth)">
      <bpmn:incoming>SequenceFlow_DetailsToPersonalInfo</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PersonalToContact</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_EnterContactDetails" name="Enter contact details&#10;(telephone, address)">
      <bpmn:incoming>SequenceFlow_PersonalToContact</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ContactToPEPDeclaration</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_PEPAffiliation" name="Declare PEP affiliation">
      <bpmn:incoming>SequenceFlow_ContactToPEPDeclaration</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PEPToSubmitAccount</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_SubmitCreateRequest" name="Click create account button">
      <bpmn:incoming>SequenceFlow_PEPToSubmitAccount</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SubmitToSystemMessage</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndEvent_AccountCreated" name="Account Created">
      <bpmn:incoming>SequenceFlow_ValidValidationToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToTypeSelection" sourceRef="StartEvent_CreateAccount" targetRef="Gateway_AccountChoice">
      <bpmn:description>Determine desired account type</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_PersonalPath" name="Personal Account&#10;" sourceRef="Gateway_AccountChoice" targetRef="Task_EnterLoginDetails">
      <bpmn:description>Select personal account</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_PremiumPath" name="Premium Account&#10;" sourceRef="Gateway_AccountChoice" targetRef="Task_EnterLoginDetails">
      <bpmn:description>Select premium account</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_TypeToDetailsEntry" name="Proceed to details entry&#10;" sourceRef="Gateway_AccountChoice" targetRef="Task_EnterLoginDetails">
      <bpmn:description>Merge account type paths</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_DetailsToPersonalInfo" name="Enter login details&#10;" sourceRef="Task_EnterLoginDetails" targetRef="Task_EnterPersonalDetails">
      <bpmn:description>Login credentials entered</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_PersonalToContact" name="Enter personal details&#10;" sourceRef="Task_EnterPersonalDetails" targetRef="Task_EnterContactDetails">
      <bpmn:description>Name and DOB entered</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ContactToPEPDeclaration" name="Enter contact details&#10;" sourceRef="Task_EnterContactDetails" targetRef="Task_PEPAffiliation">
      <bpmn:description>Contact information entered</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_PEPToSubmitAccount" name="Declare PEP affiliation&#10;" sourceRef="Task_PEPAffiliation" targetRef="Task_SubmitCreateRequest">
      <bpmn:description>PEP declaration completed</bpmn:description>
    </bpmn:sequenceFlow>

  </bpmn:process>

  <bpmn:process id="Process_System" isExecutable="true">
    <!-- System Lane -->
    <bpmn:startEvent id="StartEvent_SystemReceiveRequest" name="Account Creation Request Received&#10;">
      <bpmn:outgoing>SequenceFlow_StartToValidation</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_ValidateInputFields" name="Validate input fields">
      <bpmn:incoming>SequenceFlow_StartToValidation</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ValidationsResult</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_ValidationCheck" name="All fields valid?">
      <bpmn:incoming>SequenceFlow_ValidationsResult</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ValidPathToEmail</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_InvalidPathToNotifyClient</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Client Notification for Invalid Data -->
    <bpmn:userTask id="Task_NotifyInvalidData" name="Send notification to client">
      <bpmn:incoming>SequenceFlow_InvalidPathToNotifyClient</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ClientRetryLoop</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Welcome Email Generation -->
    <bpmn:userTask id="Task_GenerateWelcomeEmail" name="Generate welcome email&#10;">
      <bpmn:incoming>SequenceFlow_ValidPathToEmail</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EmailToSendClient</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_SystemSuccess" name="Account Created Successfully&#10;">
      <bpmn:incoming>SequenceFlow_EmailToSystemEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows for System Process -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToValidation" sourceRef="StartEvent_SystemReceiveRequest" targetRef="Task_ValidateInputFields">
      <bpmn:description>System receives account creation request</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ValidationsResult" name="Validation Result&#10;" sourceRef="Task_ValidateInputFields" targetRef="Gateway_ValidationCheck">
      <bpmn:description>All fields validated</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ValidPathToEmail" name="All valid&#10;" sourceRef="Gateway_ValidationCheck" targetRef="Task_GenerateWelcomeEmail">
      <bpmn:description>All input fields are valid</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ClientRetryLoop" name="Client notified&#10;" sourceRef="Gateway_ValidationCheck" targetRef="Task_NotifyInvalidData">
      <bpmn:description>Data validation failed</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_EmailToSendClient" name="Send welcome email&#10;" sourceRef="Task_GenerateWelcomeEmail" targetRef="EndEvent_SystemSuccess">
      <bpmn:description>Welcome email sent to client</bpmn:description>
    </bpmn:sequenceFlow>

  </bpmn:process>

  <!-- Message Flows between Client and System -->
  <bpmn:message id="Message_AccountCreationRequest" name="Create Account Request">
    <bpmn:name>Create PayPal Account Creation</bpmn:name>
  </bpmn:message>

  <bpmn:messageFlow id="MessageFlow_AccountCreationRequest" sourceRef="Task_SubmitCreateRequest" targetRef="StartEvent_SystemReceiveRequest">
    <bpmn:sourceRef>Task_SubmitCreateRequest</bpmn:sourceRef>
    <bpmn:targetRef>StartEvent_SystemReceiveRequest</bpmn:targetRef>
  </bpmn:messageFlow>

  <bpmn:message id="Message_InvalidDataNotification" name="Invalid Data Notification">
    <bpmn:name>Data Validation Failed - Retry Required</bpmn:name>
  </bpmn:message>

  <bpmn:messageFlow id="MessageFlow_InvalidNotification" sourceRef="Task_NotifyInvalidData" targetRef="Participant_Client">
    <bpmn:sourceRef>Task_NotifyInvalidData</bpmn:sourceRef>
    <bpmn:targetRef>StartEvent_CreateAccount</bpmn:targetRef>
  </bpmn:messageFlow>

  <bpmn:message id="Message_WelcomeEmail" name="Welcome Email">
    <bpmn:name>Welcome email sent to client account</bpmn:name>
  </bpmn:message>

  <bpmn:messageFlow id="MessageFlow_WelcomeEmail" sourceRef="Task_GenerateWelcomeEmail" targetRef="Participant_Client">
    <bpmn:sourceRef>Task_GenerateWelcomeEmail</bpmn:sourceRef>
    <bpmn:targetRef>EndEvent_AccountCreated</bpmn:targetRef>
  </bpmn:messageFlow>

</bpmn:definitions>