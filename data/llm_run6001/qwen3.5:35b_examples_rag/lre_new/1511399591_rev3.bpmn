<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_WebSiteDevelopment" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_WebsiteDev">
    <bpmn:participant id="Participant_WebTeam" name="Web Development Team" processRef="Process_WebsiteDevelopment" />
  </bpmn:collaboration>

  <bpmn:process id="Process_WebsiteDevelopment" isExecutable="true">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_BusinessAnalyst" name="Business Analyst">
        <bpmn:flowNodeRef>StartEvent_Process</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CollectDataAnalysis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DesignAdjustmentNeeded</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_WebDesigner" name="Web Designer">
        <bpmn:flowNodeRef>Task_IntegrateDesignModulePlacement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ChangeDesignLoopBack</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_PHPHTMLCSS" name="PHP/HTML/CSS Specialist">
        <bpmn:flowNodeRef>Task_IntegrateImplementation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AdjustImplementationLoopBack</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Tester" name="Tester">
        <bpmn:flowNodeRef>Task_TestWebsite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_TestPassed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProvideTestResults</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Process" name="Process Started">
      <bpmn:outgoing>SequenceFlow_StartToAnalysis</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Business Analyst collects data and conducts analysis -->
    <bpmn:userTask id="Task_CollectDataAnalysis" name="Collect data &amp; conduct business analysis">
      <bpmn:incoming>SequenceFlow_StartToAnalysis</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AnalysisToDesign</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Web Designer integrates design and decides module placement -->
    <bpmn:userTask id="Task_IntegrateDesignModulePlacement" name="Integrate design &amp; decide feedback module placement">
      <bpmn:incoming>SequenceFlow_AnalysisToDesign</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DesignToAnalystCheck</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Business Analyst checks design and provides feedback -->
    <bpmn:userTask id="Task_AnalystChecksDesign" name="Check design &amp; provide feedback">
      <bpmn:incoming>SequenceFlow_DesignToAnalystCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckResultGateway</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway: Design Adjustment Needed? -->
    <bpmn:exclusiveGateway id="Gateway_DesignAdjustmentNeeded" name="Design adjustment needed?">
      <bpmn:incoming>SequenceFlow_CheckResultGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AdjustDesignLoopBack</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_DesignOKProceed</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Web Designer changes design (loop back) -->
    <bpmn:userTask id="Task_ChangeDesignLoopBack" name="Change design &amp; decide module placement">
      <bpmn:incoming>SequenceFlow_AdjustDesignLoopBack</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DesignToAnalystCheck</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: PHP/HTML/CSS Specialist integrates implementation -->
    <bpmn:userTask id="Task_IntegrateImplementation" name="Integrate with overall implementation">
      <bpmn:incoming>SequenceFlow_DesignOKProceed</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ImplementToTest</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Tester tests final website -->
    <bpmn:userTask id="Task_TestWebsite" name="Test final website">
      <bpmn:incoming>SequenceFlow_ImplementToTest</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TestResultGateway</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway: Test Passed? -->
    <bpmn:exclusiveGateway id="Gateway_TestPassed" name="Test passed?">
      <bpmn:incoming>SequenceFlow_TestResultGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PassToEndEvent</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_FailAdjustLoopBack</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Tester provides test results -->
    <bpmn:userTask id="Task_ProvideTestResults" name="Provide test results">
      <bpmn:incoming>SequenceFlow_FailAdjustLoopBack</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ResultsToSpecialist</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: PHP/HTML/CSS Specialist adjusts implementation (loop back) -->
    <bpmn:userTask id="Task_AdjustImplementationLoopBack" name="Adjust according to test results &amp; integrate">
      <bpmn:incoming>SequenceFlow_ResultsToSpecialist</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SpecialistIntegrateAgain</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_ProcessCompleted" name="Process Completed">
      <bpmn:incoming>SequenceFlow_PassToEndEvent</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    
    <bpmn:sequenceFlow id="SequenceFlow_StartToAnalysis" sourceRef="StartEvent_Process" targetRef="Task_CollectDataAnalysis">
      <bpmn:description>Process begins with data collection</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_AnalysisToDesign" sourceRef="Task_CollectDataAnalysis" targetRef="Task_IntegrateDesignModulePlacement">
      <bpmn:description>Data analysis complete, proceed with design</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_DesignToAnalystCheck" sourceRef="Task_IntegrateDesignModulePlacement" targetRef="Task_AnalystChecksDesign">
      <bpmn:description>Web designer completes design, analyst reviews</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_CheckResultGateway" sourceRef="Task_AnalystChecksDesign" targetRef="Gateway_DesignAdjustmentNeeded">
      <bpmn:description>Analyze feedback and determine if adjustments needed</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_AdjustDesignLoopBack" name="Yes - Needs adjustment" sourceRef="Gateway_DesignAdjustmentNeeded" targetRef="Task_ChangeDesignLoopBack">
      <bpmn:description>Web designer must revise design</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_DesignOKProceed" name="No - Design is OK" sourceRef="Gateway_DesignAdjustmentNeeded" targetRef="Task_IntegrateImplementation">
      <bpmn:description>Design approved, proceed with implementation</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ImplementToTest" sourceRef="Task_IntegrateImplementation" targetRef="Task_TestWebsite">
      <bpmn:description>Integration complete, proceed with testing</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_TestResultGateway" sourceRef="Task_TestWebsite" targetRef="Gateway_TestPassed">
      <bpmn:description>Evaluate test results</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_PassToEndEvent" name="Yes - All tests passed" sourceRef="Gateway_TestPassed" targetRef="EndEvent_ProcessCompleted">
      <bpmn:description>All requirements met, process complete</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_FailAdjustLoopBack" name="No - Tests failed" sourceRef="Gateway_TestPassed" targetRef="Task_ProvideTestResults">
      <bpmn:description>Tests did not pass, provide feedback</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ResultsToSpecialist" sourceRef="Task_ProvideTestResults" targetRef="Task_AdjustImplementationLoopBack">
      <bpmn:description>Share test results with specialist</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_SpecialistIntegrateAgain" sourceRef="Task_AdjustImplementationLoopBack" targetRef="Task_IntegrateImplementation">
      <bpmn:description>SPECIALIST adjusts and re-integrates</bpmn:description>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>