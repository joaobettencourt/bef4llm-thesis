<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_WebsiteDev" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_WebsiteProject">
    <bpmn:participant id="Participant_ProjectTeam" name="Web Design Project Team" processRef="Process_1" />
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_DesignTeam" name="Web Design Team">
        <bpmn:flowNodeRef>StartEvent_Meeting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_HoldMeeting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_MeetingSuccess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_CreateStoryboard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_StoryboardAgreement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelSplit_DesignContent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_DevelopWebsite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_ReviewNeeded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_FinalizeContent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelJoin_BuildWait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_BuildReviewSite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_SiteApproved</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_MarketingTeam" name="Marketing Team">
        <bpmn:flowNodeRef>UserTask_PrepareDraftContent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_ConductReview</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Meeting" name="Informational Meeting">
      <bpmn:outgoing>SequenceFlow_StartToMeeting</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Hold Informational Meeting -->
    <bpmn:userTask id="UserTask_HoldMeeting" name="Hold informational meeting">
      <bpmn:incoming>SequenceFlow_StartToMeeting</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MeetingDecision</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway 1: Meeting Success -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_MeetingSuccess" name="Meeting Successful?">
      <bpmn:incoming>SequenceFlow_MeetingDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FailedProcess</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SuccessStoryboard</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event 1 -->
    <bpmn:endEvent id="EndEvent_ProcessFailed" name="Process Ended">
      <bpmn:incoming>SequenceFlow_FailedProcess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task: Create Storyboard -->
    <bpmn:userTask id="UserTask_CreateStoryboard" name="Create storyboard">
      <bpmn:incoming>SequenceFlow_SuccessStoryboard</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StoryboardAgreementCheck</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway 2: Storyboard Agreement (Inclusive to allow loop or skip) -->
    <bpmn:inclusiveGateway id="InclusiveGateway_StoryboardAgreement" name="Storyboards Agreed?">
      <bpmn:incoming>SequenceFlow_StoryboardAgreementCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceLoop_BackToStoryboard</bpmn:outgoing>
      <bpmn:outgoing>Sequence_StartParallelWork</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Parallel Split -->
    <bpmn:parallelGateway id="ParallelSplit_DesignContent" name="Start Work">
      <bpmn:incoming>Sequence_StartParallelWork</bpmn:incoming>
      <bpmn:outgoing>SeqPath_Development</bpmn:outgoing>
      <bpmn:outgoing>SeqPath_ContentDraft</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Path 1: Design & Development -->
    <bpmn:userTask id="UserTask_DevelopWebsite" name="Design and develop website">
      <bpmn:incoming>SeqPath_Development</bpmn:incoming>
      <bpmn:outgoing>Sequence_DevToJoin</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Path 2: Content Draft -->
    <bpmn:userTask id="UserTask_PrepareDraftContent" name="Prepare initial draft of content">
      <bpmn:incoming>SeqPath_ContentDraft</bpmn:incoming>
      <bpmn:outgoing>Sequence_DraftToReviewCheck</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway 3: Review Needed -->
    <bpmn:exclusiveGateway id="InclusiveGateway_ReviewNeeded" name="Review needed?">
      <bpmn:incoming>Sequence_DraftToReviewCheck</bpmn:incoming>
      <bpmn:outgoing>SeqPath_NoReview</bpmn:outgoing>
      <bpmn:outgoing>SeqPath_YesReview</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Path 2a: No Review -->
    <bpmn:userTask id="UserTask_SkipContent" name="Skip review (if applicable)">
      <bpmn:incoming>SeqPath_NoReview</bpmn:incoming>
      <bpmn:outgoing>Sequence_ContentToJoin1</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Path 2b: Yes Review -->
    <bpmn:userTask id="UserTask_ConductReview" name="Conduct review of draft">
      <bpmn:incoming>SeqPath_YesReview</bpmn:incoming>
      <bpmn:outgoing>Sequence_MarketingToFinalize</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task Final Content -->
    <bpmn:userTask id="UserTask_FinalizeContent" name="Create final version of content">
      <bpmn:incoming>Sequence_MarketingToFinalize</bpmn:incoming>
      <bpmn:outgoing>Sequence_ContentToJoin2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel Join -->
    <bpmn:parallelGateway id="ParallelJoin_BuildWait" name="All Ready?">
      <bpmn:incoming>Sequence_DevToJoin</bpmn:incoming>
      <bpmn:incoming>Sequence_ContentToJoin1</bpmn:incoming>
      <bpmn:incoming>Sequence_ContentToJoin2</bpmn:incoming>
      <bpmn:outgoing>Sequence_StartBuildReview</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task Build & Review -->
    <bpmn:userTask id="UserTask_BuildReviewSite" name="Build and review website">
      <bpmn:incoming>Sequence_StartBuildReview</bpmn:incoming>
      <bpmn:outgoing>Sequence_SiteApprovalCheck</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway 4: Site Approval -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_SiteApproved" name="Site Approved?">
      <bpmn:incoming>Sequence_SiteApprovalCheck</bpmn:incoming>
      <bpmn:outgoing>SeqPath_Approved</bpmn:outgoing>
      <bpmn:outgoing>Loop_BackToBuild</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event 2 -->
    <bpmn:endEvent id="EndEvent_Completed" name="Process Completed">
      <bpmn:incoming>SeqPath_Approved</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToMeeting" sourceRef="StartEvent_Meeting" targetRef="UserTask_HoldMeeting">
      <bpmn:description>Process starts with meeting</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_MeetingDecision" name="Success?" sourceRef="UserTask_HoldMeeting" targetRef="ExclusiveGateway_MeetingSuccess">
      <bpmn:description>If not successful, process ends</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_FailedProcess" name="No - Failed" sourceRef="ExclusiveGateway_MeetingSuccess" targetRef="EndEvent_ProcessFailed">
      <bpmn:description>Meeting unsuccessful</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_SuccessStoryboard" name="Yes - Proceed" sourceRef="ExclusiveGateway_MeetingSuccess" targetRef="UserTask_CreateStoryboard">
      <bpmn:description>Meeting successful</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_StoryboardAgreementCheck" name="" sourceRef="UserTask_CreateStoryboard" targetRef="InclusiveGateway_StoryboardAgreement">
      <bpmn:description>Create storyboard</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceLoop_BackToStoryboard" name="No - Revise Storyboard" sourceRef="InclusiveGateway_StoryboardAgreement" targetRef="UserTask_CreateStoryboard">
      <bpmn:description>Revisit storyboard creation</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Sequence_StartParallelWork" name="Yes - Agreement Reached" sourceRef="InclusiveGateway_StoryboardAgreement" targetRef="ParallelSplit_DesignContent">
      <bpmn:description>Proceed to parallel work</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Parallel Paths -->
    <bpmn:sequenceFlow id="SeqPath_Development" sourceRef="ParallelSplit_DesignContent" targetRef="UserTask_DevelopWebsite">
      <bpmn:description>Design and development</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SeqPath_ContentDraft" name="" sourceRef="ParallelSplit_DesignContent" targetRef="UserTask_PrepareDraftContent">
      <bpmn:description>Prepare content draft</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Content Review Logic -->
    <bpmn:sequenceFlow id="Sequence_DraftToReviewCheck" name="" sourceRef="UserTask_PrepareDraftContent" targetRef="InclusiveGateway_ReviewNeeded">
      <bpmn:description>Draft ready for review check</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SeqPath_NoReview" name="No Review Needed" sourceRef="InclusiveGateway_ReviewNeeded" targetRef="UserTask_SkipContent">
      <bpmn:description>Skip review step</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SeqPath_YesReview" name="Review Needed" sourceRef="InclusiveGateway_ReviewNeeded" targetRef="UserTask_ConductReview">
      <bpmn:description>Marketing team reviews</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Merge Paths -->
    <bpmn:sequenceFlow id="Sequence_ContentToJoin1" name="" sourceRef="UserTask_SkipContent" targetRef="ParallelJoin_BuildWait">
      <bpmn:description>No review, proceed</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Join to Build -->
    <bpmn:sequenceFlow id="Sequence_DevToJoin" sourceRef="UserTask_DevelopWebsite" targetRef="ParallelJoin_BuildWait">
      <bpmn:description>Development complete</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Join to Build -->
    <bpmn:sequenceFlow id="Sequence_ContentToJoin2" sourceRef="UserTask_FinalizeContent" targetRef="ParallelJoin_BuildWait">
      <bpmn:description>Final content ready</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Build & Review -->
    <bpmn:sequenceFlow id="Sequence_StartBuildReview" sourceRef="ParallelJoin_BuildWait" targetRef="UserTask_BuildReviewSite">
      <bpmn:description>All components ready</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Approval Loop -->
    <bpmn:sequenceFlow id="Sequence_SiteApprovalCheck" name="" sourceRef="UserTask_BuildReviewSite" targetRef="ExclusiveGateway_SiteApproved">
      <bpmn:description>Sit review complete</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SeqPath_Approved" name="Yes - Approved" sourceRef="ExclusiveGateway_SiteApproved" targetRef="EndEvent_Completed">
      <bpmn:description>Sit approved, process ends</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Loop_BackToBuild" name="No - Revise Site" sourceRef="ExclusiveGateway_SiteApproved" targetRef="UserTask_BuildReviewSite">
      <bpmn:description>Sit not approved, go back to building</bpmn:description>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>