<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1">
  <bpmn:collaboration id="Collaboration_ClaimHandling">
    <bpmn:participant id="Participant_ClaimProcess" name="Claims Handling Process" processRef="Process_ClaimHandling"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_ClaimHandling" isExecutable="true">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_ClaimsOfficer" name="Claims Officer">
        <bpmn:flowNodeRef>StartEvent_01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExamineClaim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WriteRecommendation</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SeniorOfficer" name="Senior Claims Officer">
        <bpmn:flowNodeRef>Task_CheckRecommendation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DecisionOK</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_01" name="Claim Registered">
      <bpmn:outgoing>SequenceFlow_Start_Examine</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Examine Claim (Claims Officer) -->
    <bpmn:task id="Task_ExamineClaim" name="Examine Claim">
      <bpmn:incoming>SequenceFlow_Start_Examine</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Examine_WriteRec</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: Write Recommendation (Claims Officer) -->
    <bpmn:task id="Task_WriteRecommendation" name="Write Settlement Recommendation">
      <bpmn:incoming>SequenceFlow_Examine_WriteRec</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_NotOK_Repeat</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Write_CheckRec</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3: Check Recommendation (Senior Claims Officer) -->
    <bpmn:task id="Task_CheckRecommendation" name="Check Recommendation">
      <bpmn:incoming>SequenceFlow_Write_CheckRec</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Check_Decision</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Decision (Senior Claims Officer) -->
    <bpmn:exclusiveGateway id="Gateway_DecisionOK" name="Recommendation OK?">
      <bpmn:incoming>SequenceFlow_Check_Decision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OK_Proceed</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NotOK_Repeat</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_01" name="Recommendation Approved">
      <bpmn:incoming>SequenceFlow_OK_Proceed</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_Start_Examine" sourceRef="StartEvent_01" targetRef="Task_ExamineClaim"/>
    <bpmn:sequenceFlow id="SequenceFlow_Examine_WriteRec" name="Examination Complete" sourceRef="Task_ExamineClaim" targetRef="Task_WriteRecommendation"/>
    <bpmn:sequenceFlow id="SequenceFlow_Write_CheckRec" sourceRef="Task_WriteRecommendation" targetRef="Task_CheckRecommendation"/>
    <bpmn:sequenceFlow id="SequenceFlow_Check_Decision" name="Check Complete" sourceRef="Task_CheckRecommendation" targetRef="Gateway_DecisionOK"/>

    <!-- Loop Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_NotOK_Repeat" name="Not OK - Repeat Recommendation" sourceRef="Gateway_DecisionOK" targetRef="Task_WriteRecommendation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${recommendationApproved == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Proceed Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_OK_Proceed" name="OK - Process Continues" sourceRef="Gateway_DecisionOK" targetRef="EndEvent_01">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${recommendationApproved == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>