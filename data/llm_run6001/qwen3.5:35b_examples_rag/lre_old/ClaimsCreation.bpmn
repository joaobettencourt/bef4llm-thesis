<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Claims Processing Process" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_ClaimsHandler" name="Claims Handler">
        <bpmn:flowNodeRef>Task_SearchPoliceReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CalculateEstimate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateActionPlan</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ClaimsManager" name="Claims Manager">
        <bpmn:flowNodeRef>Task_NegotiateSettlement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="Start_Event_01" name="Accident Report Received">
      <bpmn:outgoing>SequenceFlow_Start_Search</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Search Police Report -->
    <bpmn:task id="Task_SearchPoliceReport" name="Search &amp; File Police Report">
      <bpmn:incoming>SequenceFlow_Start_Search</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_File_Documentation</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: Calculate Initial Estimate -->
    <bpmn:task id="Task_CalculateEstimate" name="Calculate Claim Estimate">
      <bpmn:incoming>SequenceFlow_File_Documentation</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Estimate_ActionPlan</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3: Create Action Plan -->
    <bpmn:task id="Task_CreateActionPlan" name="Create Action Plan">
      <bpmn:incoming>SequenceFlow_Estimate_ActionPlan</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ActionPlan_Negotiate</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1 -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_1" name="Negotiation Successful?">
      <bpmn:incoming>SequenceFlow_ActionPlan_Negotiate</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Success_Inform</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_Fail_Renegotiate</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 4: Negotiate Settlement -->
    <bpmn:task id="Task_NegotiateSettlement" name="Negotiate Claim Estimate">
      <bpmn:incoming>SequenceFlow_ActionPlan_Negotiate</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Success_Inform</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="End_Event_01" name="Claimant Informed">
      <bpmn:incoming>SequenceFlow_Success_Inform</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_Start_Search" sourceRef="Start_Event_01" targetRef="Task_SearchPoliceReport"/>
    <bpmn:sequenceFlow id="SequenceFlow_File_Documentation" name="File Created" sourceRef="Task_SearchPoliceReport" targetRef="Task_CalculateEstimate"/>
    <bpmn:sequenceFlow id="SequenceFlow_Estimate_ActionPlan" sourceRef="Task_CalculateEstimate" targetRef="Task_CreateActionPlan"/>
    <bpmn:sequenceFlow id="SequenceFlow_ActionPlan_Negotiate" name="Based on Action Plan" sourceRef="Task_CreateActionPlan" targetRef="ExclusiveGateway_1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${negotiationSuccessful = true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_Success_Inform" name="Yes - Inform Claimant" sourceRef="ExclusiveGateway_1" targetRef="End_Event_01"/>
    <bpmn:sequenceFlow id="SequenceFlow_Fail_Renegotiate" name="No - Renegotiate" sourceRef="ExclusiveGateway_1" targetRef="Task_NegotiateSettlement">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${negotiationSuccessful = false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>