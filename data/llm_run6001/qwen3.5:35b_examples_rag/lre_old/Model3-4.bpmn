<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Claim Handling Process" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_ClaimHandler" name="Claim Handler">
        <bpmn:flowNodeRef>StartEvent_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendQuestionnaire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateTimerEvent_Wait1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_ResponseReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckCompleteness</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Completed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_0" name="Send Questionnaire">
      <bpmn:outgoing>SequenceFlow_SendQuestionnaire</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Send Initial Questionnaire -->
    <bpmn:task id="Task_SendQuestionnaire" name="Send questionnaire to claimant">
      <bpmn:incoming>SequenceFlow_SendQuestionnaire</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Wait1</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Timer Event 1 -->
    <bpmn:intermediateCatchEvent id="IntermediateTimerEvent_Wait1" name="Wait for response (5 days)">
      <bpmn:incoming>SequenceFlow_Wait1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckResponse</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Gateway 1 -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_ResponseReceived" name="Questionnaire returned?">
      <bpmn:incoming>SequenceFlow_CheckResponse</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckCompleteness_Flow</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SendReminder</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 2: Check Completeness -->
    <bpmn:task id="Task_CheckCompleteness" name="Check questionnaire completeness">
      <bpmn:incoming>SequenceFlow_CheckCompleteness_Flow</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndProcess</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3: Send Reminder -->
    <bpmn:task id="Task_SendReminder" name="Send reminder to claimant">
      <bpmn:incoming>SequenceFlow_SendReminder</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Wait2</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Timer Event 2 -->
    <bpmn:intermediateCatchEvent id="IntermediateTimerEvent_Wait2" name="Wait for response (5 days)">
      <bpmn:incoming>SequenceFlow_Wait2</bpmn:incoming>
      <bpmn:outgoing>SequenceLoopBack_CheckResponse</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Completed" name="Questionnaire completed">
      <bpmn:incoming>SequenceFlow_EndProcess</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>

  <!-- Sequence Flows -->
  <bpmn:sequenceFlow id="SequenceFlow_SendQuestionnaire" name="" sourceRef="StartEvent_0" targetRef="Task_SendQuestionnaire"/>
  <bpmn:sequenceFlow id="SequenceFlow_Wait1" name="" sourceRef="Task_SendQuestionnaire" targetRef="IntermediateTimerEvent_Wait1"/>
  <bpmn:sequenceFlow id="SequenceFlow_CheckResponse" name="Yes - Response received" sourceRef="IntermediateTimerEvent_Wait1" targetRef="ExclusiveGateway_ResponseReceived"/>
  <bpmn:sequenceFlow id="SequenceFlow_SendReminder" name="No - Send reminder" sourceRef="ExclusiveGateway_ResponseReceived" targetRef="Task_SendReminder">
    <bpmn:conditionExpression xsi:type="tFormalExpression">${response = false}</bpmn:conditionExpression>
  </bpmn:sequenceFlow>
  <bpmn:sequenceFlow id="SequenceLoopBack_CheckResponse" name="" sourceRef="IntermediateTimerEvent_Wait2" targetRef="ExclusiveGateway_ResponseReceived"/>
  <bpmn:sequenceFlow id="SequenceFlow_EndProcess" name="Yes - Complete questionnaire" sourceRef="Task_CheckCompleteness" targetRef="EndEvent_Completed">
    <bpmn:conditionExpression xsi:type="tFormalExpression">${complete = true}</bpmn:conditionExpression>
  </bpmn:sequenceFlow>

</definitions>