<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_1">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Pool_CustomerService" name="Customer Service (TELECO)" processRef="Process_CS"/>
    <bpmn:participant id="Pool_ServiceManagement" name="Service Management" processRef="Process_SM"/>
    <bpmn:participant id="Pool_ResourceProvisioning" name="Resource Provisioning" processRef="Process_RP"/>
  </bpmn:collaboration>

  <!-- Customer Service Process -->
  <bpmn:process id="Process_CS">
    <bpmn:startEvent id="Start_Event_1" name="Service Degradation Detected">
      <bpmn:outgoing>SequenceFlow_Start_Task</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_EnterReport" name="Enter Problem Report into System T">
      <bpmn:incoming>SequenceFlow_Start_Task</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SLA_Compare</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_SLADecision" name="SLA Check">
      <bpmn:incoming>SequenceFlow_SLA_Compare</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DetermineMeasures</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_MeasurePriorities" name="Determine Counter Measures & Priorities">
      <bpmn:incoming>SequenceFlow_DetermineMeasures</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SignificanceCheck</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_Premium" name="Customer Premium?">
      <bpmn:incoming>SequenceFlow_SignificanceCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_LinkExtraProcess</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_ElectronicService" name="Determine Customer Significance">
      <bpmn:incoming>SequenceFlow_SignificanceCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PrioritizeLoop</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_RePrioritize" name="Significance Affects Measures?">
      <bpmn:incoming>SequenceFlow_PrioritizeLoop</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DetermineMeasures_LoopBack</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_CreateDetailedReport" name="Create Detailed Problem Report">
      <bpmn:incoming>SequenceFlow_DetermineMeasures_LoopBack</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendToSM</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="End_Event_1" name="Process Ended">
      <bpmn:incoming>SequenceFlow_End_CS_All</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>

  <!-- Service Management Process -->
  <bpmn:process id="Process_SM">
     <bpmn:startEvent id="Start_Event_SM" name="Receive Detailed Report">
       <bpmn:outgoing>SequenceFlow_AnalyzeDecision</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:exclusiveGateway id="Gateway_SMAble" name="Analyzable by SM?">
      <bpmn:incoming>SequenceFlow_AnalyzeDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SMAnalyzePath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_SMAlyze" name="Perform Analysis">
      <bpmn:incoming>SequenceFlow_SMAnalyzePath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CreateTroubleReportSM</bpmn:outgoing>
    </bpmn:userTask>

  </bpmn:process>

   <!-- Resource Provisioning Process -->
  <bpmn:process id="Process_RP">
     <bpmn:startEvent id="Start_Event_RP" name="Receive Detailed Report / Request">
       <bpmn:outgoing>SequenceFlow_CheckProblems</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_CheckPossibleProbs" name="Check for Possible Problems">
      <bpmn:incoming>SequenceFlow_CheckProblems</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_ProblemDetectedDecide</bpmn:outgoing>
    </bpmn:userTask>

     <bpmn:exclusiveGateway id="Gateway_Probs" name="Problem Detected?">
      <bpmn:incoming>SequenceFlow_ProblemDetectedDecide</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_NoProbPath</bpmn:outgoing>
       <bpmn:outgoing>SequenceFlow_AnalyzeRPPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

     <bpmn:userTask id="Task_CreateNotification" name="Create Normal Execution Notification">
      <bpmn:incoming>SequenceFlow_NoProbPath</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_SendStatusToSM</bpmn:outgoing>
    </bpmn:userTask>

     <bpmn:userTask id="Task_AnalyzeRP" name="Analyze & Create Trouble Report">
      <bpmn:incoming>SequenceFlow_AnalyzeRPPath</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_SendStatusToSM</bpmn:outgoing>
    </bpmn:userTask>

  </bpmn:process>

   <!-- Message Flows (Collaboration) -->
    <bpmn:message id="Msg_DetailedReport" name="Detailed Problem Report"/>
    <bpmn:message id="Msg_StatusInfo" name="Status Information / Trouble Reports"/>
    <bpmn:message id="Msg_RestorationRequest" name="Restoration Request"/>

  </bpmn:definitions>