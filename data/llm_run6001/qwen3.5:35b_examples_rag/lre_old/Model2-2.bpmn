<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_1">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_CustomerService" name="Customer Service (Shared)" processRef="Process_CustomerService"/>
    <bpmn:participant id="Participant_GridOperator" name="Grid Operator" processRef="Process_GridOperator"/>
  </bpmn:collaboration>

  <!-- Customer Service Process -->
  <bpmn:process id="Process_CustomerService" isExecutable="true">
    <bpmn:startEvent id="Start_SwitchRequest" name="Switch-over Request Received">
      <bpmn:outgoing>SequenceFlow_Start_DataEntry</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_EnterCRMData" name="Enter Customer Data in CRM System">
      <bpmn:incoming>SequenceFlow_Start_DataEntry</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CompareDB</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_CheckCustomer" name="Customer Exists?">
      <bpmn:incoming>SequenceFlow_CompareDB</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CreateNewCustomer</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ExistingData</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_NewCustomerObject" name="Create New Customer Object">
      <bpmn:incoming>SequenceFlow_CreateNewCustomer</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PrepareContract</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_ErrorCheck" name="Data Complete?">
      <bpmn:incoming>SequenceFlow_CompareDB</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CorrectErrors</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ValidData</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_PrepareContract" name="Prepare Contract Documents">
      <bpmn:incoming>SequenceFlow_ExistingData</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ValidData</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AutoCheckCIS</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_CISCheck" name="Contract Valid?">
      <bpmn:incoming>SequenceFlow_AutoCheckCIS</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AnalyzeIssues</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ContractOK</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_AnalyzeResolve" name="Analyze and Resolve Issues">
      <bpmn:incoming>SequenceFlow_AnalyzeIssues</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RegenerateContract</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_RegenerateContract" sourceRef="Task_AnalyzeResolve" targetRef="Gateway_CISCheck"/>

    <bpmn:endEvent id="End_CustomerService_Withdrawal" name="Process Ends (Withdrawal)">
      <bpmn:incoming>SequenceFlow_Withdrawal</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>

  <!-- Grid Operator Process -->
  <bpmn:process id="Process_GridOperator" isExecutable="true">
    <bpmn:startEvent id="Start_MeterDataRequest" name="Meter Data Available">
      <bpmn:outgoing>SequenceFlow_TransmitData</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_ComputeFinalBilling" name="Compute Final Billing">
      <bpmn:incoming>SequenceFlow_TransmitData</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendToOldSupplier</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="End_GridOperator" name="Process Ends">
      <bpmn:incoming>SequenceFlow_ComputeFinalBilling</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>

  <!-- Message Flows -->
  <bpmn:message id="Message_SwitchRequest" name="Switch-over Request"/>
  <bpmn:message id="Message_ConfirmationDoc" name="Confirmation Document"/>
  <bpmn:message id="Message_GridCheckResponse" name="Grid Operator Response"/>

</definitions>