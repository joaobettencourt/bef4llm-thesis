<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" 
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI" 
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Room Service Process" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="true">
    
    <!-- Lane Set for different roles -->
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Manager" name="Room Service Manager">
        <bpmn:flowNodeRef>StartEvent_01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TakeOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_01</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Kitchen" name="Kitchen">
        <bpmn:flowNodeRef>Task_PrepareFood</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Sommelier" name="Sommelier">
        <bpmn:flowNodeRef>InclusiveGateway_01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GetWine</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Waiter" name="Waiter">
        <bpmn:flowNodeRef>InclusiveGateway_02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareCart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DeliverOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_01</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_01" name="Order Received">
      <bpmn:outgoing>SequenceFlow_Start_Manager</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Manager Tasks -->
    <bpmn:task id="Task_TakeOrder" name="Take Order and Submit Ticket">
      <bpmn:incoming>SequenceFlow_Start_Manager</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Manager_ParallelGw</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway for Kitchen and Sommelier -->
    <bpmn:parallelGateway id="ParallelGateway_01" name="Start Preparation">
      <bpmn:incoming>SequenceFlow_Manager_ParallelGw</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Kitchen_Start</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_Sommelier_Gateway</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Kitchen Task -->
    <bpmn:task id="Task_PrepareFood" name="Prepare Food">
      <bpmn:incoming>SequenceFlow_Kitchen_Start</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Food_Ready_Gw2</bpmn:outgoing>
    </bpmn:task>

    <!-- Inclusive Gateway for Wine (80% probability) -->
    <bpmn:inclusiveGateway id="InclusiveGateway_01" name="Wine Required?">
      <bpmn:incoming>SequenceFlow_Sommelier_Gateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Wine_Task</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Sommelier Task -->
    <bpmn:task id="Task_GetWine" name="Fetch Wine and Alcoholic Beverages">
      <bpmn:incoming>SequenceFlow_Wine_Task</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Wine_Ready_Gw2</bpmn:outgoing>
    </bpmn:task>

    <!-- Waiter Task - Cart Preparation -->
    <bpmn:task id="Task_PrepareCart" name="Prepare Service Cart">
      <bpmn:incoming>SequenceFlow_Waiter_Start_Gw2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Cart_Ready_Gw3</bpmn:outgoing>
    </bpmn:task>

    <!-- Inclusive Gateway to wait for all components -->
    <bpmn:inclusiveGateway id="InclusiveGateway_02" name="All Ready?">
      <bpmn:incoming>SequenceFlow_Food_Ready_Gw2</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_Wine_Ready_Gw2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Delivery_Start</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Delivery Task -->
    <bpmn:task id="Task_DeliverOrder" name="Deliver Order to Guest Room">
      <bpmn:incoming>SequenceFlow_Delivery_Start</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Return_Billing_Gw3</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_01" name="Order Delivered and Billed">
      <bpmn:incoming>SequenceFlow_Return_Billing_Gw3</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>

  <!-- Sequence Flows - All inside process element -->
  <bpmn:sequenceFlow id="SequenceFlow_Start_Manager" sourceRef="StartEvent_01" targetRef="Task_TakeOrder"/>
  
  <bpmn:sequenceFlow id="SequenceFlow_Manager_ParallelGw" name="Submit Order Ticket and Assign Tasks" 
                     sourceRef="Task_TakeOrder" targetRef="ParallelGateway_01"/>

  <!-- Kitchen Flow -->
  <bpmn:sequenceFlow id="SequenceFlow_Kitchen_Start" sourceRef="ParallelGateway_01" targetRef="Task_PrepareFood"/>
  
  <bpmn:sequenceFlow id="SequenceFlow_Food_Ready_Gw2" name="Food Ready" 
                     sourceRef="Task_PrepareFood" targetRef="InclusiveGateway_02"/>

  <!-- Sommelier Flow -->
  <bpmn:sequenceFlow id="SequenceFlow_Sommelier_Gateway" name="Order Wine/Alcohol (80%)" 
                     sourceRef="ParallelGateway_01" targetRef="InclusiveGateway_01"/>

  <bpmn:sequenceFlow id="SequenceFlow_Wine_Task" name="Wine Required" 
                     sourceRef="InclusiveGateway_01" targetRef="Task_GetWine"/>
  
  <bpmn:sequenceFlow id="SequenceFlow_Wine_Ready_Gw2" name="Beverages Ready" 
                     sourceRef="Task_GetWine" targetRef="InclusiveGateway_02"/>

  <!-- Waiter Flow -->
  <bpmn:sequenceFlow id="SequenceFlow_Waiter_Start_Gw2" name="Cart Preparation" 
                     sourceRef="ParallelGateway_01" targetRef="Task_PrepareCart"/>

  <bpmn:sequenceFlow id="SequenceFlow_Cart_Ready_Gw3" name="Cart Ready" 
                     sourceRef="Task_PrepareCart" targetRef="InclusiveGateway_02"/>

  <!-- Delivery Flow -->
  <bpmn:sequenceFlow id="SequenceFlow_Delivery_Start" name="All Components Ready" 
                     sourceRef="InclusiveGateway_02" targetRef="Task_DeliverOrder"/>

  <bpmn:sequenceFlow id="SequenceFlow_Return_Billing_Gw3" name="Return and Bill Guest" 
                     sourceRef="Task_DeliverOrder" targetRef="EndEvent_01"/>

</bpmn:definitions>