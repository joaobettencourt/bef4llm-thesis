<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_1">
  <bpmn:collaboration id="Collaboration_DesignProcess">
    <bpmn:participant id="Participant_DesignProcess" name="Design Process" processRef="Process_Design"/>
    <bpmn:participant id="Participant_Manufacturing" name="Manufacturing Process" />
  </bpmn:collaboration>

  <bpmn:message id="Message_SignalComplete" name="Signal Design Complete" />

  <bpmn:process id="Process_Design">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_InitialSetup" name="Design Initiation">
        <bpmn:flowNodeRef>StartEvent_01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LocateDistribute</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Electrical" name="Electrical Design">
        <bpmn:flowNodeRef>ParallelGateway_Split_01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewElec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PlanElec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateRevisedElec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_TestElec</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Physical" name="Physical Design">
        <bpmn:flowNodeRef>ParallelGateway_Split_01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewPhys</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PlanPhys</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateRevisedPhys</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_TestPhys</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_01" name="Process Started">
      <bpmn:outgoing>SequenceFlow_Start_Locate</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Initial Task -->
    <bpmn:task id="Task_LocateDistribute" name="Locate and Distribute Designs">
      <bpmn:incoming>SequenceFlow_Start_Locate</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Locate_Split</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Split -->
    <bpmn:parallelGateway id="ParallelGateway_Split_01" name="Start Design">
      <bpmn:incoming>SequenceFlow_Locate_Split</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Elec_Start</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_Phy_Start</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Electrical Lane Tasks -->
    <bpmn:task id="Task_ReviewElec" name="Review Existing Designs">
       <bpmn:incoming>SequenceFlow_Elec_Start</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PlanElec</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_PlanElec" name="Create Update Plan">
       <bpmn:incoming>SequenceFlow_PlanElec</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CreateRevisedElec</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_CreateRevisedElec" name="Create Revised Design">
       <bpmn:incoming>SequenceFlow_CreateRevisedElec</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TestElec</bpmn:outgoing>
    </bpmn:task>

    <!-- Electrical Test Gateway -->
    <bpmn:exclusiveGateway id="Gateway_TestElec" name="Test Pass?">
       <bpmn:incoming>SequenceFlow_TestElec</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Elec_Pass</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_Elec_Fail</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Physical Lane Tasks -->
    <bpmn:task id="Task_ReviewPhys" name="Review Existing Designs">
       <bpmn:incoming>SequenceFlow_Phy_Start</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PlanPhys</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_PlanPhys" name="Create Update Plan">
       <bpmn:incoming>SequenceFlow_PlanPhys</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CreateRevisedPhys</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_CreateRevisedPhys" name="Create Revised Design">
       <bpmn:incoming>SequenceFlow_CreateRevisedPhys</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TestPhys</bpmn:outgoing>
    </bpmn:task>

    <!-- Physical Test Gateway -->
    <bpmn:exclusiveGateway id="Gateway_TestPhys" name="Test Pass?">
       <bpmn:incoming>SequenceFlow_TestPhys</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Phy_Pass</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_Phy_Fail</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Join Revisions -->
    <bpmn:parallelGateway id="ParallelGateway_Join_01" name="Both Revised">
      <bpmn:incoming>SequenceFlow_Elec_Pass</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_Phy_Pass</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Combine_Start</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Combined Task -->
    <bpmn:task id="Task_CombineTest" name="Combine and Test">
       <bpmn:incoming>SequenceFlow_Combine_Start</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Final_TestGw</bpmn:outgoing>
    </bpmn:task>

    <!-- Final Gateway -->
    <bpmn:exclusiveGateway id="Gateway_Final" name="Combined Pass?">
       <bpmn:incoming>SequenceFlow_Final_TestGw</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Success</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_Fail_Restart</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event -->
    <bpmn:endEvent id="End_Event_01" name="Send to Manufacturing">
       <bpmn:incoming>SequenceFlow_Success</bpmn:incoming>
      <bpmn:messageEventDefinition ref="Message_SignalComplete"/>
    </bpmn:endEvent>

  </bpmn:process>

  <!-- Sequence Flows -->
  <bpmn:sequenceFlow id="SequenceFlow_Start_Locate" sourceRef="StartEvent_01" targetRef="Task_LocateDistribute"/>
  <bpmn:sequenceFlow id="SequenceFlow_Locate_Split" name="Split to Design" sourceRef="Task_LocateDistribute" targetRef="ParallelGateway_Split_01"/>

  <!-- Electrical Flow -->
  <bpmn:sequenceFlow id="SequenceFlow_Elec_Start" sourceRef="ParallelGateway_Split_01" targetRef="Task_ReviewElec"/>
  <bpmn:sequenceFlow id="SequenceFlow_PlanElec" sourceRef="Task_ReviewElec" targetRef="Task_PlanElec"/>
  <bpmn:sequenceFlow id="SequenceFlow_CreateRevisedElec" sourceRef="Task_PlanElec" targetRef="Task_CreateRevisedElec"/>
  <bpmn:sequenceFlow id="SequenceFlow_TestElec" sourceRef="Task_CreateRevisedElec" targetRef="Gateway_TestElec"/>

  <!-- Electrical Loop -->
  <bpmn:sequenceFlow id="SequenceFlow_Elec_Fail" name="Fail - Review Again" conditionExpression="${!testPassed}" sourceRef="Gateway_TestElec" targetRef="Task_ReviewElec"/>
  <bpmn:sequenceFlow id="SequenceFlow_Elec_Pass" name="Pass" sourceRef="Gateway_TestElec" targetRef="ParallelGateway_Join_01"/>

  <!-- Physical Flow -->
  <bpmn:sequenceFlow id="SequenceFlow_Phy_Start" sourceRef="ParallelGateway_Split_01" targetRef="Task_ReviewPhys"/>
  <bpmn:sequenceFlow id="SequenceFlow_PlanPhys" sourceRef="Task_ReviewPhys" targetRef="Task_PlanPhys"/>
  <bpmn:sequenceFlow id="SequenceFlow_CreateRevisedPhys" sourceRef="Task_PlanPhys" targetRef="Task_CreateRevisedPhys"/>
  <bpmn:sequenceFlow id="SequenceFlow_TestPhys" sourceRef="Task_CreateRevisedPhys" targetRef="Gateway_TestPhys"/>

  <!-- Physical Loop -->
  <bpmn:sequenceFlow id="SequenceFlow_Phy_Fail" name="Fail - Review Again" conditionExpression="${!testPassed}" sourceRef="Gateway_TestPhys" targetRef="Task_ReviewPhys"/>
  <bpmn:sequenceFlow id="SequenceFlow_Phy_Pass" name="Pass" sourceRef="Gateway_TestPhys" targetRef="ParallelGateway_Join_01"/>

  <!-- Combined Flow -->
  <bpmn:sequenceFlow id="SequenceFlow_Combine_Start" sourceRef="ParallelGateway_Join_01" targetRef="Task_CombineTest"/>
  <bpmn:sequenceFlow id="SequenceFlow_Final_TestGw" sourceRef="Task_CombineTest" targetRef="Gateway_Final"/>

  <!-- Final Loop -->
  <bpmn:sequenceFlow id="SequenceFlow_Fail_Restart" name="Fail - Restart Cycle" conditionExpression="${!combinedPassed}" sourceRef="Gateway_Final" targetRef="ParallelGateway_Split_01"/>
  
  <!-- Success Flow to End -->
  <bpmn:sequenceFlow id="SequenceFlow_Success" name="Pass - Send Out" sourceRef="Gateway_Final" targetRef="End_Event_01"/>

</definitions>