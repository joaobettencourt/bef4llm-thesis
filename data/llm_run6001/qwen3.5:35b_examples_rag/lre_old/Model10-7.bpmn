<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_MSPN" name="MSPN" processRef="Process_MSPN"/>
    <bpmn:participant id="Participant_GO" name="GO" processRef="Process_GO"/>
    <bpmn:messageFlow id="MessageFlow_1" sourceRef="IntermediateThrowEvent_Register" targetRef="StartCatchEvent_Examination"/>
  </bpmn:collaboration>

  <!-- MSPN Process -->
  <bpmn:process id="Process_MSPN" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_1" name="">
        <bpmn:flowNodeRef>StartEvent_Register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MeasurementRegistration</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateThrowEvent_Register</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Register" name="Register Measurement">
      <bpmn:outgoing>SequenceFlow_Start_Task</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1 -->
    <bpmn:task id="Task_MeasurementRegistration" name="Perform measurement registration">
      <bpmn:incoming>SequenceFlow_Start_Task</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Task_ThrowEvent</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Throw Event -->
    <bpmn:intermediateThrowEvent id="IntermediateThrowEvent_Register" name="Send Registration">
      <bpmn:incoming>SequenceFlow_Task_ThrowEvent</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_End_MSPN</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_MSPN" name="Registration Sent">
      <bpmn:incoming>SequenceFlow_End_MSPN</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_Start_Task" sourceRef="StartEvent_Register" targetRef="Task_MeasurementRegistration"/>
    <bpmn:sequenceFlow id="SequenceFlow_Task_ThrowEvent" sourceRef="Task_MeasurementRegistration" targetRef="IntermediateThrowEvent_Register"/>
    <bpmn:sequenceFlow id="SequenceFlow_End_MSPN" sourceRef="IntermediateThrowEvent_Register" targetRef="EndEvent_MSPN"/>

  </bpmn:process>

  <!-- GO Process -->
  <bpmn:process id="Process_GO" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_2" name="">
        <bpmn:flowNodeRef>StartCatchEvent_Examination</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GoExamineApplication</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RejectApplication</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_GO_Reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConfirmApplication</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssignMSPN</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_NotifyAll</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformMSPO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformMPO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformSP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_GO_Complete</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartCatchEvent_Examination" name="Receive Registration">
      <bpmn:outgoing>SequenceFlow_Start_Task_GO</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1 - Examine Application -->
    <bpmn:task id="Task_GoExamineApplication" name="Examine MSPN application">
      <bpmn:incoming>SequenceFlow_Start_Task_GO</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Examination_Decision</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway - Decision Point -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_Decision" name="Application Approved?">
      <bpmn:incoming>SequenceFlow_Examination_Decision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Reject_Path</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_Confirm_Path</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 2 - Reject -->
    <bpmn:task id="Task_RejectApplication" name="Reject application">
      <bpmn:incoming>SequenceFlow_Reject_Path</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Reject_End</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event - Reject -->
    <bpmn:endEvent id="EndEvent_GO_Reject" name="Application Rejected">
      <bpmn:incoming>SequenceFlow_Reject_End</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task 3 - Confirm Application -->
    <bpmn:task id="Task_ConfirmApplication" name="Confirm application">
      <bpmn:incoming>SequenceFlow_Confirm_Path</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Confirm_Assign</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 4 - Assign MSPN -->
    <bpmn:task id="Task_AssignMSPN" name="Assign MSPN">
      <bpmn:incoming>SequenceFlow_Confirm_Assign</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Assign_NotifyAll</bpmn:outgoing>
    </bpmn:task>

    <!-- Inclusive Gateway - Parallel Notifications -->
    <bpmn:inclusiveGateway id="InclusiveGateway_NotifyAll" name="Notify All Parties">
      <bpmn:incoming>SequenceFlow_Assign_NotifyAll</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Notif_MSPO</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_Notif_MPO</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_Notif_SP</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Task 5 - Inform MSPO -->
    <bpmn:task id="Task_InformMSPO" name="Inform MSPO about assignment">
      <bpmn:incoming>SequenceFlow_Notif_MSPO</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MSPN_Converge</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 6 - Inform MPO -->
    <bpmn:task id="Task_InformMPO" name="Inform MPO about assignment">
      <bpmn:incoming>SequenceFlow_Notif_MPO</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MPO_Converge</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 7 - Inform SP -->
    <bpmn:task id="Task_InformSP" name="Inform SP about assignment">
      <bpmn:incoming>SequenceFlow_Notif_SP</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SP_Converge</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event - Complete -->
    <bpmn:endEvent id="EndEvent_GO_Complete" name="Assignment Processed">
      <bpmn:incoming>SequenceFlow_All_NotificationsComplete</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_Start_Task_GO" sourceRef="StartCatchEvent_Examination" targetRef="Task_GoExamineApplication"/>
    <bpmn:sequenceFlow id="SequenceFlow_Examination_Decision" name="Decision on Application" sourceRef="Task_GoExamineApplication" targetRef="ExclusiveGateway_Decision"/>

    <!-- Reject Path -->
    <bpmn:sequenceFlow id="SequenceFlow_Reject_Path" name="Reject application" sourceRef="ExclusiveGateway_Decision" targetRef="Task_RejectApplication">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${approved = false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Confirm Path -->
    <bpmn:sequenceFlow id="SequenceFlow_Confirm_Path" name="Confirm application" sourceRef="ExclusiveGateway_Decision" targetRef="Task_ConfirmApplication">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${approved = true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Post-Confirmation Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_Reject_End" sourceRef="Task_RejectApplication" targetRef="EndEvent_GO_Reject"/>
    <bpmn:sequenceFlow id="SequenceFlow_Confirm_Assign" sourceRef="Task_ConfirmApplication" targetRef="Task_AssignMSPN"/>

    <!-- Notification Gateway Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_Assign_NotifyAll" sourceRef="Task_AssignMSPN" targetRef="InclusiveGateway_NotifyAll"/>

    <!-- Parallel Notifications -->
    <bpmn:sequenceFlow id="SequenceFlow_Notif_MSPO" name="Inform MSPO" sourceRef="InclusiveGateway_NotifyAll" targetRef="Task_InformMSPO"/>
    <bpmn:sequenceFlow id="SequenceFlow_Notif_MPO" name="Inform MPO" sourceRef="InclusiveGateway_NotifyAll" targetRef="Task_InformMPO"/>
    <bpmn:sequenceFlow id="SequenceFlow_Notif_SP" name="Inform SP" sourceRef="InclusiveGateway_NotifyAll" targetRef="Task_InformSP"/>

    <!-- Convergence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_MSPN_Converge" sourceRef="Task_InformMSPO" targetRef="EndEvent_GO_Complete"/>
    <bpmn:sequenceFlow id="SequenceFlow_MPO_Converge" sourceRef="Task_InformMPO" targetRef="EndEvent_GO_Complete"/>
    <bpmn:sequenceFlow id="SequenceFlow_SP_Converge" sourceRef="Task_InformSP" targetRef="EndEvent_GO_Complete"/>

  </bpmn:process>
</bpmn:definitions>