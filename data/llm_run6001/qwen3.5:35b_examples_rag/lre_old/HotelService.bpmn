<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
                  id="Definitions_1">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="The Evanstonian Room Service" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="true">
    <!-- Lane Definitions -->
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Manager" name="Room-Service Manager">
        <bpmn:flowNodeRef>StartEvent_01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TakeOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_SplitPrep</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Preparation" name="Kitchen &amp; Sommelier">
        <bpmn:flowNodeRef>Task_KitchenPrep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_JoinDelivery</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Waiter" name="Waiter">
        <bpmn:flowNodeRef>Task_CartReadiness</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_JoinDelivery</bpmn:flowNodeRef> 
        <bpmn:flowNodeRef>Task_DeliverOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReturnStation</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_01" name="Guest Calls Room Service">
      <bpmn:messageEventDefinition />
      <bpmn:outgoing>SequenceFlow_TakeOrder</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Manager Tasks -->
    <bpmn:task id="Task_TakeOrder" name="Take Down Order">
      <bpmn:incoming>SequenceFlow_TakeOrder</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DecisionWine</bpmn:outgoing>
    </bpmn:task>

    <!-- Decision Gateway for Wine -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_Wine" name="Alcoholic Beverage Needed?">
      <bpmn:incoming>SequenceFlow_DecisionWine</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AssignSommelierYes</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SkipSommelierNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sommelier Task (Conditional) -->
    <bpmn:task id="Task_AssignSommelier" name="Assign Wine Order">
      <bpmn:incoming>SequenceFlow_AssignSommelierYes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergePrepStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Inclusive Gateway to Split Preparation Tasks (Conditional Parallelism) -->
    <bpmn:inclusiveGateway id="InclusiveGateway_SplitPrep">
      <bpmn:incoming>SequenceFlow_MergePrepStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_KitchenTask</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_WaiterCartTask</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Kitchen Prep Task -->
    <bpmn:task id="Task_KitchenPrep" name="Prepare Food">
      <bpmn:incoming>SequenceFlow_KitchenTask</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FoodReadyToJoin</bpmn:outgoing>
    </bpmn:task>

    <!-- Waiter Cart Readiness Task -->
    <bpmn:task id="Task_CartReadiness" name="Ready Delivery Cart">
      <bpmn:incoming>SequenceFlow_WaiterCartTask</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaiterReadyToJoin</bpmn:outgoing>
    </bpmn:task>

    <!-- Inclusive Gateway Join for Delivery (Waits for active paths) -->
    <bpmn:inclusiveGateway id="InclusiveGateway_JoinDelivery">
      <bpmn:incoming>SequenceFlow_FoodReadyToJoin</bpmn:incoming> 
      <bpmn:incoming>SequenceFlow_WaiterReadyToJoin</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DeliverOrderStart</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Delivery Task -->
    <bpmn:task id="Task_DeliverOrder" name="Deliver to Guest Room">
      <bpmn:incoming>SequenceFlow_DeliverOrderStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReturnStation</bpmn:outgoing>
    </bpmn:task>

    <!-- Return Task -->
    <bpmn:task id="Task_ReturnStation" name="Return to Station">
      <bpmn:incoming>SequenceFlow_ReturnStation</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DecisionBilling</bpmn:outgoing>
    </bpmn:task>

    <!-- Decision Gateway for Billing Timing -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_Billing" name="Another Order?">
      <bpmn:incoming>SequenceFlow_DecisionBilling</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitForOrder</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_DebitAccountNow</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Billing Task -->
    <bpmn:task id="Task_DebitAccount" name="Debit Guest Account">
      <bpmn:incoming>SequenceFlow_DebitAccountNow</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndOrderProcessed</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_01" name="Order Processed">
      <bpmn:incoming>SequenceFlow_EndOrderProcessed</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows for Conditional Paths (Simplified Logic) -->
    
    <!-- Manager Flow to Decision -->
    <bpmn:sequenceFlow id="SequenceFlow_TakeOrder" sourceRef="StartEvent_01" targetRef="Task_TakeOrder"/>
    <bpmn:sequenceFlow id="SequenceFlow_DecisionWine" sourceRef="Task_TakeOrder" targetRef="ExclusiveGateway_Wine"/>

    <!-- Conditional Wine Assignment Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_AssignSommelierYes" name="Alcohol Needed (80%)" sourceRef="ExclusiveGateway_Wine" targetRef="Task_AssignSommelier">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${wineNeeded == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Merge Assignment Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_MergePrepStart" sourceRef="Task_AssignSommelier" targetRef="InclusiveGateway_SplitPrep"/>
    
    <!-- Skip Somm Flow (Implicitly handled by Gateway logic, but need flow to Inclusive) -->
     <bpmn:sequenceFlow id="SequenceFlow_SkipSommelierNo" name="Skip Wine Assignment" sourceRef="ExclusiveGateway_Wine" targetRef="InclusiveGateway_SplitPrep"/>

    <!-- Parallel Split of Execution Tasks (Conditional) -->
    <bpmn:sequenceFlow id="SequenceFlow_KitchenTask" name="Always Active" sourceRef="InclusiveGateway_SplitPrep" targetRef="Task_KitchenPrep">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Waiter Cart Task -->
    <bpmn:sequenceFlow id="SequenceFlow_WaiterCartTask" name="Always Active" sourceRef="InclusiveGateway_SplitPrep" targetRef="Task_CartReadiness">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Join Delivery -->
    <bpmn:sequenceFlow id="SequenceFlow_FoodReadyToJoin" sourceRef="Task_KitchenPrep" targetRef="InclusiveGateway_JoinDelivery"/>
    
    <!-- Waiter Cart to Join (Note: In BPMN, multiple incoming flows must be defined) -->
    <bpmn:sequenceFlow id="SequenceFlow_WaiterReadyToJoin" name="Waiter Ready" sourceRef="Task_CartReadiness" targetRef="InclusiveGateway_JoinDelivery"/>

    <!-- Delivery Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_DeliverOrderStart" sourceRef="InclusiveGateway_JoinDelivery" targetRef="Task_DeliverOrder"/>
    
    <!-- Return & Billing Logic -->
    <bpmn:sequenceFlow id="SequenceFlow_ReturnStation" name="Return to Station" sourceRef="Task_DeliverOrder" targetRef="Task_ReturnStation"/>
    <bpmn:sequenceFlow id="SequenceFlow_DecisionBilling" sourceRef="Task_ReturnStation" targetRef="ExclusiveGateway_Billing"/>

    <!-- Billing Decision -->
    <bpmn:sequenceFlow id="SequenceFlow_WaitForOrder" name="Wait for Other Orders" sourceRef="ExclusiveGateway_Billing" targetRef="StartEvent_01">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${hasAnotherOrder == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Debit Account -->
    <bpmn:sequenceFlow id="SequenceFlow_DebitAccountNow" name="Debit Now" sourceRef="ExclusiveGateway_Billing" targetRef="Task_DebitAccount">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${hasAnotherOrder == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- End Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_EndOrderProcessed" sourceRef="Task_DebitAccount" targetRef="EndEvent_01"/>

  </bpmn:process>
</bpmn:definitions>