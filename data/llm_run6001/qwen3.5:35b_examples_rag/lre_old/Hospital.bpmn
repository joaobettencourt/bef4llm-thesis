<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_1">
  <bpmn:collaboration id="Collaboration_ExaminationProcess">
    <bpmn:participant id="Participant_OutpatientDepartment" name="Examination Process" processRef="Process_Examination"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Examination" isExecutable="true">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_OutpatientPhysician" name="Outpatient Physician">
        <bpmn:flowNodeRef>Task_InitialExamination</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_HealthyDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FillFormHealthy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateOrderRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformPatientRisks</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Patient" name="Patient">
        <bpmn:flowNodeRef>InclusiveGateway_ConsentDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SignConsent</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_WardDelegate" name="Ward Delegate">
        <bpmn:flowNodeRef>Task_ArrangeAppointment</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Nurse" name="Nurse (Ward)">
        <bpmn:flowNodeRef>Task_PrepareExaminationSampling</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_WardPhysician" name="Ward Physician">
        <bpmn:flowNodeRef>Task_TakeSample</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendToLab</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FollowUpTreatment</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_LabPhysician" name="Lab Physician">
        <bpmn:flowNodeRef>InclusiveGateway_SampleValidation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ValidateSampleState</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_MTA" name="Medical Technical Assistant">
        <bpmn:flowNodeRef>Task_PerformAnalysis</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_LabPhysicianResults" name="Lab Physician (Validation)">
        <bpmn:flowNodeRef>Task_ValidateResults</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_OutpatientDepartmentFinal" name="Outpatient Department">
        <bpmn:flowNodeRef>ExclusiveGateway_DiagnosisDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MakeDiagnosisPrescribeTherapy</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="Start_Event_InitialExamination" name="Patient Examination">
      <bpmn:outgoing>SequenceFlow_Start_Examination</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Initial Examination Task -->
    <bpmn:task id="Task_InitialExamination" name="Conduct Initial Examination">
      <bpmn:incoming>SequenceFlow_Start_Examination</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Examination_DecisionGw</bpmn:outgoing>
    </bpmn:task>

    <!-- Decision Gateway 1 -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_HealthyDecision" name="Patient Healthy?">
      <bpmn:incoming>SequenceFlow_Examination_DecisionGw</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Gateway_FillForm</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_Gateway_CreateOrder</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Path A - Healthy -->
    <bpmn:task id="Task_FillFormHealthy" name="Fill Examination Form">
      <bpmn:incoming>SequenceFlow_Gateway_FillForm</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Healthy_EndProcess</bpmn:outgoing>
    </bpmn:task>

    <!-- Path B - Needs Additional Examination -->
    <bpmn:task id="Task_CreateOrderRequest" name="Create Order &amp; Request Form">
      <bpmn:incoming>SequenceFlow_Gateway_CreateOrder</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Order_Request_InformRisks</bpmn:outgoing>
    </bpmn:task>

    <!-- Inform Patient -->
    <bpmn:task id="Task_InformPatientRisks" name="Inform About Potential Risks">
      <bpmn:incoming>SequenceFlow_Order_Request_InformRisks</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Risks_ConsentGw</bpmn:outgoing>
    </bpmn:task>

    <!-- Consent Decision -->
    <bpmn:exclusiveGateway id="InclusiveGateway_ConsentDecision" name="Patient Signs Consent?">
      <bpmn:incoming>SequenceFlow_Risks_ConsentGw</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Consent_ArrangeAppointment</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Arrange Appointment -->
    <bpmn:task id="Task_ArrangeAppointment" name="Arrange Ward Appointment">
      <bpmn:incoming>SequenceFlow_Consent_ArrangeAppointment</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Appointment_PrepareExamSampling</bpmn:outgoing>
    </bpmn:task>

    <!-- Prepare Examination -->
    <bpmn:task id="Task_PrepareExaminationSampling" name="Prepare Examination &amp; Sampling">
      <bpmn:incoming>SequenceFlow_Appointment_PrepareExamSampling</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Prep_TakeSample</bpmn:outgoing>
    </bpmn:task>

    <!-- Take Sample -->
    <bpmn:task id="Task_TakeSample" name="Take Requested Sample">
      <bpmn:incoming>SequenceFlow_Prep_TakeSample</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Sample_SendToLab</bpmn:outgoing>
    </bpmn:task>

    <!-- Send to Lab -->
    <bpmn:task id="Task_SendToLab" name="Send Sample to Indicated Lab">
      <bpmn:incoming>SequenceFlow_Sample_SendToLab</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Lab_ValidateSampleState</bpmn:outgoing>
    </bpmn:task>

    <!-- Follow-up Treatment -->
    <bpmn:task id="Task_FollowUpTreatment" name="Conduct Follow-Up Treatment">
      <bpmn:incoming>SequenceFlow_Sample_SendToLab</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Treatment_LabValidationStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Lab Sample Validation -->
    <bpmn:exclusiveGateway id="InclusiveGateway_SampleValidation" name="Sample Valid?">
      <bpmn:incoming>SequenceFlow_Lab_ValidateSampleState</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Valid_AnalysisStart</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Validate Sample State -->
    <bpmn:task id="Task_ValidateSampleState" name="Validate Sample State">
      <bpmn:incoming>SequenceFlow_Lab_ValidateSampleState</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Valid_AnalysisStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Perform Analysis -->
    <bpmn:task id="Task_PerformAnalysis" name="Perform Laboratory Analysis">
      <bpmn:incoming>SequenceFlow_Valid_AnalysisStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Analysis_ValidateResults</bpmn:outgoing>
    </bpmn:task>

    <!-- Validate Results -->
    <bpmn:task id="Task_ValidateResults" name="Validate Analysis Results">
      <bpmn:incoming>SequenceFlow_Analysis_ValidateResults</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Validation_DiagnosisGw</bpmn:outgoing>
    </bpmn:task>

    <!-- Final Decision -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_DiagnosisDecision" name="Diagnosis Complete?">
      <bpmn:incoming>SequenceFlow_Validation_DiagnosisGw</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Decision_MakeDiagnosis</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Make Diagnosis -->
    <bpmn:task id="Task_MakeDiagnosisPrescribeTherapy" name="Make Diagnosis &amp; Prescribe Therapy">
      <bpmn:incoming>SequenceFlow_Decision_MakeDiagnosis</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Diagnosis_EndProcess</bpmn:outgoing>
    </bpmn:task>

    <!-- End Events -->
    <bpmn:endEvent id="End_Event_HealthyPatient" name="Examination Complete">
      <bpmn:incoming>SequenceFlow_Healthy_EndProcess</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="End_Event_FinalDiagnosis" name="Therapy Prescribed">
      <bpmn:incoming>SequenceFlow_Diagnosis_EndProcess</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>

  <!-- Sequence Flows -->
  <bpmn:sequenceFlow id="SequenceFlow_Start_Examination" sourceRef="Start_Event_InitialExamination" targetRef="Task_InitialExamination"/>
  <bpmn:sequenceFlow id="SequenceFlow_Examination_DecisionGw" name="Decision Point" sourceRef="Task_InitialExamination" targetRef="ExclusiveGateway_HealthyDecision"/>

  <!-- Healthy Path -->
  <bpmn:sequenceFlow id="SequenceFlow_Gateway_FillForm" name="Yes - Patient is healthy" sourceRef="ExclusiveGateway_HealthyDecision" targetRef="Task_FillFormHealthy"/>
  <bpmn:sequenceFlow id="SequenceFlow_Healthy_EndProcess" sourceRef="Task_FillFormHealthy" targetRef="End_Event_HealthyPatient"/>

  <!-- Additional Examination Path -->
  <bpmn:sequenceFlow id="SequenceFlow_Gateway_CreateOrder" name="No - Needs additional examination" sourceRef="ExclusiveGateway_HealthyDecision" targetRef="Task_CreateOrderRequest"/>
  <bpmn:sequenceFlow id="SequenceFlow_Order_Request_InformRisks" sourceRef="Task_CreateOrderRequest" targetRef="Task_InformPatientRisks"/>

  <!-- Consent Flow -->
  <bpmn:sequenceFlow id="SequenceFlow_Risks_ConsentGw" name="Inform Patient Risks" sourceRef="Task_InformPatientRisks" targetRef="InclusiveGateway_ConsentDecision"/>
  <bpmn:sequenceFlow id="SequenceFlow_Consent_ArrangeAppointment" name="Consent Signed - Continue Procedure" sourceRef="InclusiveGateway_ConsentDecision" targetRef="Task_ArrangeAppointment"/>

  <!-- Ward Process -->
  <bpmn:sequenceFlow id="SequenceFlow_Appointment_PrepareExamSampling" sourceRef="Task_ArrangeAppointment" targetRef="Task_PrepareExaminationSampling"/>
  <bpmn:sequenceFlow id="SequenceFlow_Prep_TakeSample" name="Before Appointment Preparation Complete" sourceRef="Task_PrepareExaminationSampling" targetRef="Task_TakeSample"/>

  <!-- Sample Handling -->
  <bpmn:sequenceFlow id="SequenceFlow_Sample_SendToLab" sourceRef="Task_TakeSample" targetRef="Task_SendToLab"/>
  
  <!-- Lab Process -->
  <bpmn:sequenceFlow id="SequenceFlow_Lab_ValidateSampleState" name="Send to Lab &amp; Treatment Start" sourceRef="Task_SendToLab" targetRef="InclusiveGateway_SampleValidation"/>

  <!-- Results -->
  <bpmn:sequenceFlow id="SequenceFlow_Valid_AnalysisStart" name="Valid Sample - Proceed to Analysis" sourceRef="InclusiveGateway_SampleValidation" targetRef="Task_PerformAnalysis"/>
  <bpmn:sequenceFlow id="SequenceFlow_Analysis_ValidateResults" sourceRef="Task_PerformAnalysis" targetRef="Task_ValidateResults"/>
  <bpmn:sequenceFlow id="SequenceFlow_Validation_DiagnosisGw" name="Results Validated" sourceRef="Task_ValidateResults" targetRef="ExclusiveGateway_DiagnosisDecision"/>

  <!-- Final Diagnosis -->
  <bpmn:sequenceFlow id="SequenceFlow_Decision_MakeDiagnosis" name="Ready for Diagnosis" sourceRef="ExclusiveGateway_DiagnosisDecision" targetRef="Task_MakeDiagnosisPrescribeTherapy"/>
  <bpmn:sequenceFlow id="SequenceFlow_Diagnosis_EndProcess" sourceRef="Task_MakeDiagnosisPrescribeTherapy" targetRef="End_Event_FinalDiagnosis"/>

</definitions>