<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Recruitment Process" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_HR_Clerk" name="HR Clerk">
        <bpmn:flowNodeRef>StartMessageEvent_VacancyReported</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReportVacancy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_ReviewDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateMessageEventCatching_JobDescriptionReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateJobDescription</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_ApprovalDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateMessageEventCatching_CorrectionsRequired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProvideClarifications</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_QuestionsDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateMessageEventCatching_ApprovalReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AdvertiseJob</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndNoneEvent_Complete</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartMessageEvent_VacancyReported" name="Vacancy Reported">
      <bpmn:outgoing>SequenceFlow_Start_Report</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Report Vacancy -->
    <bpmn:task id="Task_ReportVacancy" name="Report vacancy to Personnel Department">
      <bpmn:incoming>SequenceFlow_Start_Report</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Report_ReviewDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Review Decision -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_ReviewDecision" name="Job Description Ready?">
      <bpmn:incoming>SequenceFlow_Report_ReviewDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Decision_WaitDescription</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Intermediate Event 1: Wait for Job Description -->
    <bpmn:intermediateCatchEvent id="IntermediateMessageEventCatching_JobDescriptionReceived" name="Job Description Received">
      <bpmn:incoming>SequenceFlow_Decision_WaitDescription</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Description_CreateTask</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task 2: Create Job Description -->
    <bpmn:task id="Task_CreateJobDescription" name="Create job description">
      <bpmn:incoming>SequenceFlow_Description_CreateTask</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Create_ApprovalDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2: Approval Decision -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_ApprovalDecision" name="Approval Required?">
      <bpmn:incoming>SequenceFlow_Create_ApprovalDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Decision_QuestionsCheck</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Intermediate Event 2: Wait for Corrections -->
    <bpmn:intermediateCatchEvent id="IntermediateMessageEventCatching_CorrectionsRequired" name="Corrections Required">
      <bpmn:incoming>SequenceFlow_Decision_QuestionsCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Correct_ProvideClarifications</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task 3: Provide Clarifications -->
    <bpmn:task id="Task_ProvideClarifications" name="Provide clarifications">
      <bpmn:incoming>SequenceFlow_Correct_ProvideClarifications</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Clari_ApprovalDecision2</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 3: Questions Decision -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_QuestionsDecision" name="Questions About Tasks?">
      <bpmn:incoming>SequenceFlow_Clari_ApprovalDecision2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Decision_WaitApproval</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Intermediate Event 3: Wait for Approval -->
    <bpmn:intermediateCatchEvent id="IntermediateMessageEventCatching_ApprovalReceived" name="Job Description Approved">
      <bpmn:incoming>SequenceFlow_Decision_WaitApproval</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Approve_AdvertiseTask</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task 4: Advertise Job -->
    <bpmn:task id="Task_AdvertiseJob" name="Advertise job">
      <bpmn:incoming>SequenceFlow_Approve_AdvertiseTask</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Advertise_EndEvent</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndNoneEvent_Complete" name="Job Advertised">
      <bpmn:incoming>SequenceFlow_Advertise_EndEvent</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>

  <!-- Sequence Flows -->
  <bpmn:sequenceFlow id="SequenceFlow_Start_Report" sourceRef="StartMessageEvent_VacancyReported" targetRef="Task_ReportVacancy"/>
  <bpmn:sequenceFlow id="SequenceFlow_Report_ReviewDecision" name="After reporting vacancy" sourceRef="Task_ReportVacancy" targetRef="ExclusiveGateway_ReviewDecision"/>
  <bpmn:sequenceFlow id="SequenceFlow_Decision_WaitDescription" name="Wait for description review" sourceRef="ExclusiveGateway_ReviewDecision" targetRef="IntermediateMessageEventCatching_JobDescriptionReceived"/>
  <bpmn:sequenceFlow id="SequenceFlow_Description_CreateTask" sourceRef="IntermediateMessageEventCatching_JobDescriptionReceived" targetRef="Task_CreateJobDescription"/>
  <bpmn:sequenceFlow id="SequenceFlow_Create_ApprovalDecision" name="Submit for approval" sourceRef="Task_CreateJobDescription" targetRef="ExclusiveGateway_ApprovalDecision"/>
  <bpmn:sequenceFlow id="SequenceFlow_Decision_QuestionsCheck" name="Questions about tasks?" sourceRef="ExclusiveGateway_ApprovalDecision" targetRef="IntermediateMessageEventCatching_CorrectionsRequired"/>
  <bpmn:sequenceFlow id="SequenceFlow_Correct_ProvideClarifications" sourceRef="IntermediateMessageEventCatching_CorrectionsRequired" targetRef="Task_ProvideClarifications"/>
  <bpmn:sequenceFlow id="SequenceFlow_Clari_ApprovalDecision2" name="After clarifications provided" sourceRef="Task_ProvideClarifications" targetRef="ExclusiveGateway_QuestionsDecision"/>
  <bpmn:sequenceFlow id="SequenceFlow_Decision_WaitApproval" name="Wait for approval decision" sourceRef="ExclusiveGateway_QuestionsDecision" targetRef="IntermediateMessageEventCatching_ApprovalReceived"/>
  <bpmn:sequenceFlow id="SequenceFlow_Approve_AdvertiseTask" name="Approved - proceed to advertise" sourceRef="IntermediateMessageEventCatching_ApprovalReceived" targetRef="Task_AdvertiseJob"/>
  <bpmn:sequenceFlow id="SequenceFlow_Advertise_EndEvent" sourceRef="Task_AdvertiseJob" targetRef="EndNoneEvent_Complete"/>

</bpmn:definitions>