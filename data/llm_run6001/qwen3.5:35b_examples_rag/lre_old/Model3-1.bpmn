<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_1">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_SmallClaimsRegistry" name="Small Claims Registry Operations" processRef="Process_WarrantPossession"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_WarrantPossession" isExecutable="true">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_ClientServiceBackOffice" name="Client Service Back Office">
        <bpmn:flowNodeRef>StartEvent_01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RetrieveSCTTFile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateEvent_WaitReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_StorePhysicalFile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RetrieveSCTFileAfterReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AttachNewDocument</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_StoreExpandedFile</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_01" name="Warrant Possession Request">
      <bpmn:outgoing>SequenceFlow_Start_ReceiveRequest</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Receive request -->
    <bpmn:task id="Task_ReceiveRequest" name="Receive warrant possession request">
      <bpmn:incoming>SequenceFlow_Start_ReceiveRequest</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Request_RetrieveSCTTFile</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: Retrieve SCTT file -->
    <bpmn:task id="Task_RetrieveSCTTFile" name="Retrieve SCTT file">
      <bpmn:incoming>SequenceFlow_Request_RetrieveSCTTFile</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SCTTFWardToPolice</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3: Forward to Queensland Police -->
    <bpmn:task id="Task_FowardSCTtoQueensland" name="Forward SCT Warrant Possession">
      <bpmn:incoming>SequenceFlow_SCTTFWardToPolice</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StorePhysicalFile</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Event: Wait for Police report -->
    <bpmn:startEvent id="IntermediateEvent_WaitReport" name="Police Report Received">
      <bpmn:incoming>SequenceFlow_FowardToStore</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Report_RetrieveSCTFileAfterReport</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 4: Store physical file awaiting report -->
    <bpmn:task id="Task_StorePhysicalFile" name="Store SCTT physical file">
      <bpmn:incoming>SequenceFlow_FowardToStore</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitForReport</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 5: Retrieve SCT file after report -->
    <bpmn:task id="Task_RetrieveSCTFileAfterReport" name="Retrieve respective SCT file">
      <bpmn:incoming>SequenceFlow_Report_RetrieveSCTFileAfterReport</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AttachNewDocument</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 6: Attach new SCT document -->
    <bpmn:task id="Task_AttachNewDocument" name="Attach new SCT document">
      <bpmn:incoming>SequenceFlow_AttachNewDocument</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StoreExpandedFile</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 7: Store expanded SCT physical file -->
    <bpmn:task id="Task_StoreExpandedFile" name="Store expanded SCT physical file">
      <bpmn:incoming>SequenceFlow_StoreExpandedFile</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndProcess</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_01" name="SCT File Ready for MC Staff">
      <bpmn:incoming>SequenceFlow_EndProcess</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>

  <!-- Sequence Flows -->
  <bpmn:sequenceFlow id="SequenceFlow_Start_ReceiveRequest" sourceRef="StartEvent_01" targetRef="Task_ReceiveRequest"/>
  <bpmn:sequenceFlow id="SequenceFlow_Request_RetrieveSCTTFile" sourceRef="Task_ReceiveRequest" targetRef="Task_RetrieveSCTTFile"/>
  <bpmn:sequenceFlow id="SequenceFlow_SCTTFWardToPolice" sourceRef="Task_RetrieveSCTTFile" targetRef="Task_FowardSCTtoQueensland"/>
  <bpmn:sequenceFlow id="SequenceFlow_StorePhysicalFile" sourceRef="Task_FowardSCTtoQueensland" targetRef="IntermediateEvent_WaitReport"/>
  <bpmn:sequenceFlow id="SequenceFlow_Report_RetrieveSCTFileAfterReport" sourceRef="IntermediateEvent_WaitReport" targetRef="Task_RetrieveSCTFileAfterReport"/>
  <bpmn:sequenceFlow id="SequenceFlow_AttachNewDocument" sourceRef="Task_RetrieveSCTFileAfterReport" targetRef="Task_AttachNewDocument"/>
  <bpmn:sequenceFlow id="SequenceFlow_StoreExpandedFile" sourceRef="Task_AttachNewDocument" targetRef="Task_StoreExpandedFile"/>
  <bpmn:sequenceFlow id="SequenceFlow_EndProcess" sourceRef="Task_StoreExpandedFile" targetRef="EndEvent_01"/>

</definitions>