<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Dispatch of goods Computer Hardware Shop" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Secretary" name="Secretary">
        <bpmn:flowNodeRef>StartEvent_01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_ClarifyShipping</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_AmountSize</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_InviteLogisticsCompanies</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_SelectLogisticCompany</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Logistics" name="Logistics Department Head">
        <bpmn:flowNodeRef>UserTask_PackageLabel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_InsuranceNecessary</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_InsureParcel</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Warehouse" name="Warehouse">
        <bpmn:flowNodeRef>ParallelGateway_PackagingStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_PackageGoods</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_01" name="Ship goods">
      <bpmn:outgoing>SequenceFlow_Start_Clarify</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task - Clarify shipment method (Secretary) -->
    <bpmn:userTask id="UserTask_ClarifyShipping" name="Clarify shipment method">
      <bpmn:incoming>SequenceFlow_Start_Clarify</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Clarify_AmountSizeGw</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway - Large amount? -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_AmountSize" name="Large amount?">
      <bpmn:incoming>SequenceFlow_Clarify_AmountSizeGw</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_LargeAmount_Logistics</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SmallAmount_Label</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task - Invite logistics companies (Secretary) -->
    <bpmn:userTask id="UserTask_InviteLogisticsCompanies" name="Get 3 offers from logistic companies">
      <bpmn:incoming>SequenceFlow_LargeAmount_Logistics</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Logistics_CompanySelected</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task - Select logistic company (Secretary) -->
    <bpmn:userTask id="UserTask_SelectLogisticCompany" name="Select logistic company and place order">
      <bpmn:incoming>SequenceFlow_Logistics_CompanySelected</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OrderPlaced_ReadyGw</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task - Write package label (Logistics Dept Head) -->
    <bpmn:userTask id="UserTask_PackageLabel" name="Write package label">
      <bpmn:incoming>SequenceFlow_SmallAmount_Label</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_LabelWritten_InsuranceGw</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway - Insurance necessary? -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_InsuranceNecessary" name="Special handling?">
      <bpmn:incoming>SequenceFlow_LabelWritten_InsuranceGw</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_YesInsure_PackageGoods</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoSkip_SkipInsure</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task - Insure parcel (Logistics Dept Head) -->
    <bpmn:userTask id="UserTask_InsureParcel" name="Insure parcel">
      <bpmn:incoming>SequenceFlow_YesInsure_PackageGoods</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Insured_ReadyGw</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel Gateway - Start packaging in parallel -->
    <bpmn:parallelGateway id="ParallelGateway_PackagingStart">
      <bpmn:incoming>SequenceFlow_Start_Clarify</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WarehousePackaging_GoToReadyGw</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task - Package goods (Warehouse) -->
    <bpmn:userTask id="UserTask_PackageGoods" name="Package goods">
      <bpmn:incoming>SequenceFlow_WarehousePackaging_GoToReadyGw</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Packaged_ReadyGw</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway - Ready for pickup -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_ReadyForPickup" name="Everything ready?">
      <bpmn:incoming>SequenceFlow_OrderPlaced_ReadyGw</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_Packaged_ReadyGw</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PreparePickup_Task</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task - Prepare for picking up goods -->
    <bpmn:userTask id="UserTask_PrepareForPickup" name="Prepare for picking up goods">
      <bpmn:incoming>SequenceFlow_PreparePickup_Task</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PickupPrepared_EndEvent</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_01" name="Shipment prepared">
      <bpmn:incoming>SequenceFlow_PickupPrepared_EndEvent</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>

  <!-- Sequence Flows -->
  <bpmn:sequenceFlow id="SequenceFlow_Start_Clarify" sourceRef="StartEvent_01" targetRef="UserTask_ClarifyShipping"/>
  <bpmn:sequenceFlow id="SequenceFlow_Clarify_AmountSizeGw" sourceRef="UserTask_ClarifyShipping" targetRef="ExclusiveGateway_AmountSize"/>
  <bpmn:sequenceFlow id="SequenceFlow_LargeAmount_Logistics" name="yes - Large amount" sourceRef="ExclusiveGateway_AmountSize" targetRef="UserTask_InviteLogisticsCompanies"/>
  <bpmn:sequenceFlow id="SequenceFlow_SmallAmount_Label" name="no - Small amount" sourceRef="ExclusiveGateway_AmountSize" targetRef="UserTask_PackageLabel"/>
  <bpmn:sequenceFlow id="SequenceFlow_Logistics_CompanySelected" sourceRef="UserTask_InviteLogisticsCompanies" targetRef="UserTask_SelectLogisticCompany"/>
  <bpmn:sequenceFlow id="SequenceFlow_OrderPlaced_ReadyGw" sourceRef="UserTask_SelectLogisticCompany" targetRef="ExclusiveGateway_ReadyForPickup"/>
  <bpmn:sequenceFlow id="SequenceFlow_LabelWritten_InsuranceGw" sourceRef="UserTask_PackageLabel" targetRef="ExclusiveGateway_InsuranceNecessary"/>
  <bpmn:sequenceFlow id="SequenceFlow_YesInsure_PackageGoods" name="yes - Special handling" sourceRef="ExclusiveGateway_InsuranceNecessary" targetRef="UserTask_InsureParcel"/>
  <bpmn:sequenceFlow id="SequenceFlow_NoSkip_SkipInsure" name="no - Normal post shipment" sourceRef="ExclusiveGateway_InsuranceNecessary" targetRef="ParallelGateway_PackagingStart">
    <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${insuranceNotRequired}</bpmn:conditionExpression>
  </bpmn:sequenceFlow>
  <bpmn:sequenceFlow id="SequenceFlow_Insured_ReadyGw" sourceRef="UserTask_InsureParcel" targetRef="ExclusiveGateway_ReadyForPickup"/>
  <bpmn:sequenceFlow id="SequenceFlow_WarehousePackaging_GoToReadyGw" name="In parallel - Package goods" sourceRef="ParallelGateway_PackagingStart" targetRef="UserTask_PackageGoods"/>
  <bpmn:sequenceFlow id="SequenceFlow_Packaged_ReadyGw" sourceRef="UserTask_PackageGoods" targetRef="ExclusiveGateway_ReadyForPickup"/>
  <bpmn:sequenceFlow id="SequenceFlow_PreparePickup_Task" name="yes - Everything ready" sourceRef="ExclusiveGateway_ReadyForPickup" targetRef="UserTask_PrepareForPickup"/>
  <bpmn:sequenceFlow id="SequenceFlow_PickupPrepared_EndEvent" sourceRef="UserTask_PrepareForPickup" targetRef="EndEvent_01"/>

</bpmn:definitions>