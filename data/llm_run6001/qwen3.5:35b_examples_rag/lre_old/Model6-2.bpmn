<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1">
  <bpmn:collaboration id="Collaboration_OrderProcess">
    <bpmn:participant id="Participant_AssemblerAG" name="Assembler AG" processRef="Process_Assembler"/>
    <bpmn:participant id="Participant_Supplier" name="Supplier" processRef="Process_Supplier"/>

    <!-- Message Flow 1: Order Request -->
    <bpmn:messageFlow id="MessageFlow_OrderRequest" sourceRef="Task_PlaceOrder" targetRef="StartEvent_ReceiveOrder">
      <bpmn:name>Place Order</bpmn:name>
    </bpmn:messageFlow>

    <!-- Message Flow 2: Invoice -->
    <bpmn:messageFlow id="MessageFlow_Invoice" sourceRef="Task_ProcessOrder" targetRef="IntermediateCatch_ReceiveInvoice">
      <bpmn:name>Send Invoice</bpmn:name>
    </bpmn:messageFlow>

  </bpmn:collaboration>

  <!-- Assembler AG Process -->
  <bpmn:process id="Process_Assembler" isExecutable="true">
    <bpmn:startEvent id="Start_Timer_01" name="Monthly Order Request">
      <bpmn:timerEventDefinition/>
      <bpmn:outgoing>SequenceFlow_Start_Task</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_PlaceOrder" name="Place Order with Supplier">
      <bpmn:incoming>SequenceFlow_Start_Task</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Task_WaitInvoice</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:intermediateCatchEvent id="IntermediateCatch_ReceiveInvoice" name="Receive Invoice">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SequenceFlow_Task_WaitInvoice</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Invoice_End</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:endEvent id="End_ProcessComplete" name="Order Process Complete">
      <bpmn:incoming>SequenceFlow_Invoice_End</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>

  <!-- Supplier Process -->
  <bpmn:process id="Process_Supplier" isExecutable="true">
    <bpmn:startEvent id="StartEvent_ReceiveOrder" name="Order Received from Assembler AG">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_Start_Task</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_ProcessOrder" name="Process Order Request">
      <bpmn:incoming>SequenceFlow_Start_Task</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_End_Supplier</bpmn:outgoing>
    </bpmn:userTask>

  </bpmn:process>

  <!-- Sequence Flows -->
  <bpmn:sequenceFlow id="SequenceFlow_Start_Task" sourceRef="Start_Timer_01" targetRef="Task_PlaceOrder"/>
  <bpmn:sequenceFlow id="SequenceFlow_Task_WaitInvoice" sourceRef="Task_PlaceOrder" targetRef="IntermediateCatch_ReceiveInvoice"/>
  <bpmn:sequenceFlow id="SequenceFlow_Invoice_End" sourceRef="IntermediateCatch_ReceiveInvoice" targetRef="End_ProcessComplete"/>

</definitions>