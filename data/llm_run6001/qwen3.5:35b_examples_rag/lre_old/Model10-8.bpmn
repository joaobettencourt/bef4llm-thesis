<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_1">
  <bpmn:collaboration id="Collaboration_MSPO_GO">
    <bpmn:participant id="Participant_MSPO" name="MSPO" processRef="Process_MSPO"/>
    <bpmn:participant id="Participant_GO" name="GO" processRef="Process_GO"/>
  </bpmn:collaboration>

  <!-- MSPO Process -->
  <bpmn:process id="Process_MSPO">
    <bpmn:startEvent id="Start_Event_MSPO_Deregister" name="Deregistration Requested">
      <bpmn:outgoing>SequenceFlow_Start_Task</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_MSPO_Deregister" name="MSPO deregisters at the GO">
      <bpmn:incoming>SequenceFlow_Start_Task</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Task_End</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="End_Event_MSPO">
      <bpmn:name>Deregistration Requested</bpmn:name>
      <bpmn:incoming>SequenceFlow_Task_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow_Start_Task" sourceRef="Start_Event_MSPO_Deregister" targetRef="Task_MSPO_Deregister"/>
    <bpmn:sequenceFlow id="SequenceFlow_Task_End" sourceRef="Task_MSPO_Deregister" targetRef="End_Event_MSPO"/>

  </bpmn:process>

  <!-- GO Process -->
  <bpmn:process id="Process_GO">
    <bpmn:startEvent id="Start_Event_GO_Verify" name="Deregistration Received">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_Start_Gateway</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_GO_Verify" name="GO verifies the deregistration">
      <bpmn:incoming>SequenceFlow_Start_Gateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Verify_Gw</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gw_GO_Decision" name="Reject or Confirm?">
      <bpmn:incoming>SequenceFlow_Verify_Gw</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Reject_End</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_Confirm_Assign</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Reject Path -->
    <bpmn:endEvent id="End_Event_GO_Rejected" name="Deregistration Rejected">
      <bpmn:incoming>SequenceFlow_Reject_End</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Confirm Path -->
    <bpmn:task id="Task_GO_Assign" name="GO assigns himself as MSP">
       <bpmn:incoming>SequenceFlow_Confirm_Assign</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Assign_InformMSPO</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_GO_Inform_MSPO" name="Inform MSPO about assignment">
       <bpmn:incoming>SequenceFlow_Assign_InformMSPO</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MSPo_MPO</bpmn:outgoing>
    </bpmn:task>

     <bpmn:task id="Task_GO_Inform_MPO" name="Inform MPO about assignment">
       <bpmn:incoming>SequenceFlow_MSPo_MPO</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MPO_SP</bpmn:outgoing>
    </bpmn:task>

     <bpmn:task id="Task_GO_Inform_SP" name="Inform SP about assignment">
       <bpmn:incoming>SequenceFlow_MPO_SP</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_End_Complete</bpmn:outgoing>
    </bpmn:task>

     <bpmn:endEvent id="End_Event_GO_Success" name="Deregistration Confirmed &amp; Assignment Complete">
       <bpmn:incoming>SequenceFlow_End_Complete</bpmn:incoming>
    </bpmn:endEvent>

     <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_Start_Gateway" sourceRef="Start_Event_GO_Verify" targetRef="Task_GO_Verify"/>
    <bpmn:sequenceFlow id="SequenceFlow_Verify_Gw" sourceRef="Task_GO_Verify" targetRef="Gw_GO_Decision"/>
    <bpmn:sequenceFlow id="SequenceFlow_Reject_End" name="Rejects deregistration" sourceRef="Gw_GO_Decision" targetRef="End_Event_GO_Rejected"/>
    <bpmn:sequenceFlow id="SequenceFlow_Confirm_Assign" name="Preliminarily confirms" sourceRef="Gw_GO_Decision" targetRef="Task_GO_Assign"/>
    <bpmn:sequenceFlow id="SequenceFlow_Assign_InformMSPO" sourceRef="Task_GO_Assign" targetRef="Task_GO_Inform_MSPO"/>
    <bpmn:sequenceFlow id="SequenceFlow_MSPo_MPO" sourceRef="Task_GO_Inform_MSPO" targetRef="Task_GO_Inform_MPO"/>
    <bpmn:sequenceFlow id="SequenceFlow_MPO_SP" sourceRef="Task_GO_Inform_MPO" targetRef="Task_GO_Inform_SP"/>
    <bpmn:sequenceFlow id="SequenceFlow_End_Complete" sourceRef="Task_GO_Inform_SP" targetRef="End_Event_GO_Success"/>

  </bpmn:process>

  <!-- Message Flows -->
  <bpmn:messageFlow id="MessageFlow_Deregister_Request">
    <bpmn:sourceRef>Task_MSPO_Deregister</bpmn:sourceRef>
    <bpmn:targetRef>Start_Event_GO_Verify</bpmn:targetRef>
  </bpmn:messageFlow>

</definitions>