<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_1">
  <bpmn:collaboration id="Collaboration_IPO_Process">
    <bpmn:participant id="Participant_IPO" name="IPO Process" processRef="Process_IPO"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_IPO" isExecutable="true">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Company" name="Company">
        <bpmn:flowNodeRef>StartEvent_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectUnderwriters</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Underwriter" name="Underwriters">
        <bpmn:flowNodeRef>ExclusiveGateway_FactsFair</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareRegistration</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CatchEvent_SEC_Clearance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RoadShow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FixIssuePrice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_ReasonsNotToSell</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterCommitmentOffer</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Decision" name="Decision to go public">
      <bpmn:outgoing>SequenceFlow_Start_Select</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1 -->
    <bpmn:task id="Task_SelectUnderwriters" name="Select Underwriters">
      <bpmn:incoming>SequenceFlow_Start_Select</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Select_GatewayFacts</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1 -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_FactsFair" name="Facts Fairly Presented?">
      <bpmn:incoming>SequenceFlow_Select_GatewayFacts</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NoDecline</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_YesPrepareReg</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event 1 -->
    <bpmn:endEvent id="EndEvent_Decline" name="Decline Issue">
      <bpmn:incoming>SequenceFlow_NoDecline</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task 2 -->
    <bpmn:task id="Task_PrepareRegistration" name="Prepare Registration &amp; Check Blue Sky Laws">
      <bpmn:incoming>SequenceFlow_YesPrepareReg</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SubmitSEC_Split</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2 (Parallel Split) -->
    <bpmn:parallelGateway id="ParallelGateway_Split" name="Wait for SEC / Roadshow">
      <bpmn:incoming>SequenceFlow_SubmitSEC_Split</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitSEC_GatewayJoin</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RoadShow_Join</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Intermediate Catch Event -->
    <bpmn:intermediateCatchEvent id="CatchEvent_SEC_Clearance" name="Receive SEC Clearance">
      <bpmn:incoming>SequenceFlow_WaitSEC_GatewayJoin</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Clearance_FixPrice</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task 3 -->
    <bpmn:task id="Task_RoadShow" name="Road Show &amp; Firm Up Price Prep">
      <bpmn:incoming>SequenceFlow_RoadShow_Join</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RoadShow_GatewayJoin</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 3 (Parallel Join) -->
    <bpmn:parallelGateway id="ParallelGateway_Join" name="Merge SEC &amp; Roadshow">
      <bpmn:incoming>SequenceFlow_Clearance_FixPrice</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_RoadShow_GatewayJoin</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Join_FixIssuePrice</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 4 -->
    <bpmn:task id="Task_FixIssuePrice" name="Fix Issue Price">
      <bpmn:incoming>SequenceFlow_Join_FixIssuePrice</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Price_GatewayReasons</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 4 -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_ReasonsNotToSell" name="Any Reasons Not To Sell?">
      <bpmn:incoming>SequenceFlow_Price_GatewayReasons</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NoOffer_EndCancel</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_Offer_Commitment</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event 2 -->
    <bpmn:endEvent id="EndEvent_Cancel" name="Cancel Offer">
      <bpmn:incoming>SequenceFlow_NoOffer_EndCancel</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task 5 -->
    <bpmn:task id="Task_EnterCommitmentOffer" name="Enter Firm Commitment &amp; Offer Stock">
      <bpmn:incoming>SequenceFlow_Offer_Commitment</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Commit_EndIPO</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 3 -->
    <bpmn:endEvent id="EndEvent_IPO" name="Offer Completed">
      <bpmn:incoming>SequenceFlow_Commit_EndIPO</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_Start_Select" sourceRef="StartEvent_Decision" targetRef="Task_SelectUnderwriters"/>
    <bpmn:sequenceFlow id="SequenceFlow_Select_GatewayFacts" name="Select Underwriter" sourceRef="Task_SelectUnderwriters" targetRef="ExclusiveGateway_FactsFair"/>
    <bpmn:sequenceFlow id="SequenceFlow_NoDecline" name="No (Unfair Facts)" sourceRef="ExclusiveGateway_FactsFair" targetRef="EndEvent_Decline"/>
    <bpmn:sequenceFlow id="SequenceFlow_YesPrepareReg" name="Yes (Facts Fair)" sourceRef="ExclusiveGateway_FactsFair" targetRef="Task_PrepareRegistration"/>
    <bpmn:sequenceFlow id="SequenceFlow_SubmitSEC_Split" sourceRef="Task_PrepareRegistration" targetRef="ParallelGateway_Split"/>
    <bpmn:sequenceFlow id="SequenceFlow_WaitSEC_GatewayJoin" name="Await SEC Approval" sourceRef="ParallelGateway_Split" targetRef="CatchEvent_SEC_Clearance"/>
    <bpmn:sequenceFlow id="SequenceFlow_RoadShow_Join" name="Road Show Prep" sourceRef="ParallelGateway_Split" targetRef="Task_RoadShow"/>
    <bpmn:sequenceFlow id="SequenceFlow_Clearance_FixPrice" sourceRef="CatchEvent_SEC_Clearance" targetRef="ParallelGateway_Join"/>
    <bpmn:sequenceFlow id="SequenceFlow_RoadShow_GatewayJoin" name="Road Show Complete" sourceRef="Task_RoadShow" targetRef="ParallelGateway_Join"/>
    <bpmn:sequenceFlow id="SequenceFlow_Join_FixIssuePrice" sourceRef="ParallelGateway_Join" targetRef="Task_FixIssuePrice"/>
    <bpmn:sequenceFlow id="SequenceFlow_Price_GatewayReasons" name="Fix Price Complete" sourceRef="Task_FixIssuePrice" targetRef="ExclusiveGateway_ReasonsNotToSell"/>
    <bpmn:sequenceFlow id="SequenceFlow_NoOffer_EndCancel" name="Yes (Reasons Found)" sourceRef="ExclusiveGateway_ReasonsNotToSell" targetRef="EndEvent_Cancel"/>
    <bpmn:sequenceFlow id="SequenceFlow_Offer_Commitment" name="No Reasons Found" sourceRef="ExclusiveGateway_ReasonsNotToSell" targetRef="Task_EnterCommitmentOffer"/>
    <bpmn:sequenceFlow id="SequenceFlow_Commit_EndIPO" sourceRef="Task_EnterCommitmentOffer" targetRef="EndEvent_IPO"/>

  </bpmn:process>
</bpmn:definitions>