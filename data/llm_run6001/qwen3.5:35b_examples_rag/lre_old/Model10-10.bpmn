<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_1">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Fault Detection and Repair Process" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="true">
    
    <!-- Start Event -->
    <bpmn:startEvent id="Start_Event_FaultReported" name="Fault Reported or Suspected">
      <bpmn:outgoing>SequenceFlow_Start_Examine</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Examine Failure -->
    <bpmn:task id="Task_ExamineFailure" name="Examine the failure">
      <bpmn:incoming>SequenceFlow_Start_Examine</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Examine_GatewayDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Decision - Reject or Confirm -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_Decision" name="Confirm Failure?">
      <bpmn:incoming>SequenceFlow_Examine_GatewayDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Reject_End</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_Confirm_InformCustomerManager</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event for Rejection -->
    <bpmn:endEvent id="End_Event_Rejected" name="Failure Rejected">
      <bpmn:incoming>SequenceFlow_Reject_End</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Parallel Gateway after confirmation -->
    <bpmn:parallelGateway id="ParallelGateway_Confirmation" name="Inform Customer &amp; Manager">
      <bpmn:incoming>SequenceFlow_Confirm_InformCustomerManager</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InformCustomer</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_InformManager</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 2: Inform Customer about confirmation -->
    <bpmn:task id="Task_InformCustomerConfirm" name="Inform customer of failure">
      <bpmn:incoming>SequenceFlow_InformCustomer</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Confirm_GatewayFixFault</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3: Inform Manager about confirmation -->
    <bpmn:task id="Task_InformManagerConfirm" name="Inform manager of failure">
      <bpmn:incoming>SequenceFlow_InformManager</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Manager_GatewayFixFault</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2: Join after informing -->
    <bpmn:parallelGateway id="ParallelGateway_JoinConfirm" name="Join Confirmation">
      <bpmn:incoming>SequenceFlow_Confirm_GatewayFixFault</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_Manager_GatewayFixFault</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FixFault</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 4: Fix the fault -->
    <bpmn:task id="Task_FixFault" name="Fix the fault at measuring device">
      <bpmn:incoming>SequenceFlow_FixFault</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ShareResults</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 5: Share results with fault detector -->
    <bpmn:task id="Task_ShareResults" name="Share repair results with fault detector">
      <bpmn:incoming>SequenceFlow_ShareResults</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GatewayResolutionInform</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 3: Decision for resolution notification -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_Resolution" name="Notify Resolution?">
      <bpmn:incoming>SequenceFlow_GatewayResolutionInform</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NotifyCustomerRes</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NotifyManagerRes</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 6: Inform customer about resolution -->
    <bpmn:task id="Task_InformCustomerResolution" name="Inform customer of resolution">
      <bpmn:incoming>SequenceFlow_NotifyCustomerRes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Customer_GatewayEnd</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 7: Inform manager about resolution -->
    <bpmn:task id="Task_InformManagerResolution" name="Inform manager of resolution">
      <bpmn:incoming>SequenceFlow_NotifyManagerRes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Manager_GatewayEnd</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 4: Join before end -->
    <bpmn:parallelGateway id="ParallelGateway_JoinResolution" name="Join Resolution">
      <bpmn:incoming>SequenceFlow_Customer_GatewayEnd</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_Manager_GatewayEnd</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_End_ProcessComplete</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- End Event -->
    <bpmn:endEvent id="End_Event_Complete" name="Process Complete">
      <bpmn:incoming>SequenceFlow_End_ProcessComplete</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>

  <!-- Sequence Flows -->
  <bpmn:sequenceFlow id="SequenceFlow_Start_Examine" sourceRef="Start_Event_FaultReported" targetRef="Task_ExamineFailure"/>
  
  <bpmn:sequenceFlow id="SequenceFlow_Examine_GatewayDecision" sourceRef="Task_ExamineFailure" targetRef="ExclusiveGateway_Decision"/>
  
  <bpmn:sequenceFlow id="SequenceFlow_Reject_End" name="Reject Failure" sourceRef="ExclusiveGateway_Decision" targetRef="End_Event_Rejected">
    <bpmn:conditionExpression xsi:type="tFormalExpression">${user rejects failure}</bpmn:conditionExpression>
  </bpmn:sequenceFlow>

  <bpmn:sequenceFlow id="SequenceFlow_Confirm_InformCustomerManager" name="Confirm Failure" sourceRef="ExclusiveGateway_Decision" targetRef="ParallelGateway_Confirmation">
    <bpmn:conditionExpression xsi:type="tFormalExpression">${user confirms failure}</bpmn:conditionExpression>
  </bpmn:sequenceFlow>

  <bpmn:sequenceFlow id="SequenceFlow_InformCustomer" sourceRef="ParallelGateway_Confirmation" targetRef="Task_InformCustomerConfirm"/>
  
  <bpmn:sequenceFlow id="SequenceFlow_InformManager" sourceRef="ParallelGateway_Confirmation" targetRef="Task_InformManagerConfirm"/>

  <bpmn:sequenceFlow id="SequenceFlow_Confirm_GatewayFixFault" sourceRef="Task_InformCustomerConfirm" targetRef="ParallelGateway_JoinConfirm"/>
  
  <bpmn:sequenceFlow id="SequenceFlow_Manager_GatewayFixFault" sourceRef="Task_InformManagerConfirm" targetRef="ParallelGateway_JoinConfirm"/>

  <bpmn:sequenceFlow id="SequenceFlow_FixFault" sourceRef="ParallelGateway_JoinConfirm" targetRef="Task_FixFault"/>
  
  <bpmn:sequenceFlow id="SequenceFlow_ShareResults" sourceRef="Task_FixFault" targetRef="Task_ShareResults"/>

  <bpmn:sequenceFlow id="SequenceFlow_GatewayResolutionInform" sourceRef="Task_ShareResults" targetRef="ExclusiveGateway_Resolution"/>
  
  <bpmn:sequenceFlow id="SequenceFlow_NotifyCustomerRes" name="Notify Customer Resolution" sourceRef="ExclusiveGateway_Resolution" targetRef="Task_InformCustomerResolution">
    <bpmn:conditionExpression xsi:type="tFormalExpression">${notify customer}</bpmn:conditionExpression>
  </bpmn:sequenceFlow>

  <bpmn:sequenceFlow id="SequenceFlow_NotifyManagerRes" name="Notify Manager Resolution" sourceRef="ExclusiveGateway_Resolution" targetRef="Task_InformManagerResolution">
    <bpmn:conditionExpression xsi:type="tFormalExpression">${notify manager}</bpmn:conditionExpression>
  </bpmn:sequenceFlow>

  <bpmn:sequenceFlow id="SequenceFlow_Customer_GatewayEnd" sourceRef="Task_InformCustomerResolution" targetRef="ParallelGateway_JoinResolution"/>
  
  <bpmn:sequenceFlow id="SequenceFlow_Manager_GatewayEnd" sourceRef="Task_InformManagerResolution" targetRef="ParallelGateway_JoinResolution"/>

  <bpmn:sequenceFlow id="SequenceFlow_End_ProcessComplete" sourceRef="ParallelGateway_JoinResolution" targetRef="End_Event_Complete"/>
  
</bpmn:definitions>