<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_EC" name="EC (Employee)" processRef="Process_EC"/>
    <bpmn:participant id="Participant_INQ" name="INQ (Inquiry Handler)" processRef="Process_INQ"/>
    <bpmn:participant id="Participant_IP" name="IP (Information Processor)" processRef="Process_IP"/>

    <!-- Message Flows between participants -->
    <bpmn:messageFlow id="MessageFlow_1" sourceRef="IntermediateThrow_EC_MasterDataChange" targetRef="StartCatch_INQ_MasterDataRequest"/>
    <bpmn:messageFlow id="MessageFlow_2" sourceRef="Task_INQ_NotifyIP" targetRef="StartCatch_IP_CheckMasterData"/>
  </bpmn:collaboration>

  <!-- EC Process -->
  <bpmn:process id="Process_EC" isExecutable="false">
    <bpmn:startEvent id="StartEC_None" name="Change Request Initiated">
      <bpmn:outgoing>SequenceFlow_StartToTask</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_EC_RequestMasterData" name="Request Master Data Change">
      <bpmn:incoming>SequenceFlow_StartToTask</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ThrowMessage</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Message Throw Event -->
    <bpmn:messageThrowEvent id="IntermediateThrow_EC_MasterDataChange" name="Send to INQ">
      <bpmn:incoming>SequenceFlow_ThrowMessage</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndToCompleteEC</bpmn:outgoing>
    </bpmn:messageThrowEvent>

    <!-- End Event -->
    <bpmn:endEvent id="EndEC_Complete" name="Request Sent">
      <bpmn:incoming>SequenceFlow_EndToCompleteEC</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToTask" sourceRef="StartEC_None" targetRef="Task_EC_RequestMasterData"/>
    <bpmn:sequenceFlow id="SequenceFlow_ThrowMessage" sourceRef="Task_EC_RequestMasterData" targetRef="IntermediateThrow_EC_MasterDataChange"/>
  </bpmn:process>

  <!-- INQ Process -->
  <bpmn:process id="Process_INQ" isExecutable="false">
    <bpmn:startEvent id="StartCatch_INQ_MasterDataRequest" name="Receive Change Request">
      <bpmn:outgoing>SequenceFlow_StartToTask</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task -->
    <bpmn:endEvent id="End_INQ_Complete" name="Request Forwarded">
      <bpmn:incoming>SequenceFlow_ThrowMessageINQ</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToTask_INQ" sourceRef="StartCatch_INQ_MasterDataRequest" targetRef="Task_INQ_NotifyIP"/>
  </bpmn:process>

  <!-- IP Process -->
  <bpmn:process id="Process_IP" isExecutable="false">
    <bpmn:startEvent id="StartCatch_IP_CheckMasterData" name="Receive Change Notification">
      <bpmn:outgoing>SequenceFlow_StartToCheck</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task -->
    <bpmn:task id="Task_IP_CheckChangeTime" name="Check Master Data Change Time">
      <bpmn:incoming>SequenceFlow_StartToCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToGateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_IP_Decision" name="Change Allowed?">
      <bpmn:incoming>SequenceFlow_ToGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConfirmPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RejectPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Tasks for Decision Outcomes -->
    <bpmn:task id="Task_IP_ConfirmChange" name="Confirm Change">
      <bpmn:incoming>SequenceFlow_ConfirmPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndToCompleteIP1</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_IP_RejectChange" name="Reject Change">
      <bpmn:incoming>SequenceFlow_RejectPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndToCompleteIP2</bpmn:outgoing>
    </bpmn:task>

    <!-- End Events -->
    <bpmn:endEvent id="End_IP_Confirmed" name="Change Confirmed">
      <bpmn:incoming>SequenceFlow_EndToCompleteIP1</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="End_IP_Rejected" name="Change Rejected">
      <bpmn:incoming>SequenceFlow_EndToCompleteIP2</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToCheck_IP" sourceRef="StartCatch_IP_CheckMasterData" targetRef="Task_IP_CheckChangeTime"/>
    <bpmn:sequenceFlow id="SequenceFlow_ToGateway" sourceRef="Task_IP_CheckChangeTime" targetRef="ExclusiveGateway_IP_Decision"/>
    <bpmn:sequenceFlow id="SequenceFlow_ConfirmPath" name="Yes - Allowed" sourceRef="ExclusiveGateway_IP_Decision" targetRef="Task_IP_ConfirmChange"/>
    <bpmn:sequenceFlow id="SequenceFlow_RejectPath" name="No - Not Allowed" sourceRef="ExclusiveGateway_IP_Decision" targetRef="Task_IP_RejectChange"/>

  </bpmn:process>

</bpmn:definitions>