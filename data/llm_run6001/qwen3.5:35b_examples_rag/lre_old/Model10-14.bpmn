<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_BillProcessing">
    <bpmn:participant id="Participant_MPOO" name="MPOO" processRef="Process_MPOO"/>
    <bpmn:participant id="Participant_MSPO" name="MSPO" processRef="Process_MSPO"/>
    <bpmn:participant id="Participant_GO_MPON" name="GO/MPON" processRef="Process_GO_MPON"/>

    <!-- Message Flows -->
    <bpmn:messageFlow id="MessageFlow_MPOO_Bill_Continuation" sourceRef="Task_MPOO_SendBill_Operations" targetRef="IntermediateCatchEvent_GO_ReceiveBill1"/>
    <bpmn:messageFlow id="MessageFlow_MSPO_Bill_Continuation" sourceRef="Task_MSPO_SendBill_Measurement" targetRef="IntermediateCatchEvent_GO_ReceiveBill2"/>
    <bpmn:messageFlow id="MessageFlow_MSPO_Bill_AdditionalReadings" sourceRef="Task_MSPO_SendBill_Readings" targetRef="IntermediateCatchEvent_GO_ReceiveBill3"/>
    <bpmn:messageFlow id="MessageFlow_MPOO_Bill_Equipment" sourceRef="Task_MPOO_SendBill_Equipment" targetRef="ExclusiveGateway_MPON_OR_GO_ReceiveEquipment"/>
    <bpmn:messageFlow id="MessageFlow_Confirmation_PaymentAdvice" sourceRef="Task_GOPPON_ConfirmInvoice" targetRef="IntermediateCatchEvent_MSPO_ReceiveConfirmation"/>
    <bpmn:messageFlow id="MessageFlow_Rejection_InvoiceRejected" sourceRef="Task_GO_MPON_RejectInvoice" targetRef="IntermediateCatchEvent_MPOO_MSPO_RejectBill"/>

  </bpmn:collaboration>

  <!-- MPOO Process -->
  <bpmn:process id="Process_MPOO" isExecutable="false">
    <bpmn:startEvent id="StartEvent_MPOO_1" name="Receive Bill Request">
      <bpmn:outgoing>SequenceFlow_StartToTasks</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- MPOO Tasks -->
    <bpmn:task id="Task_MPOO_SendBill_Operations" name="Send Bill for Temporary Continuation of Metering Point Operations">
      <bpmn:incoming>SequenceFlow_StartToTasks</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToGateway1</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_MPOO_SendBill_Equipment" name="Send Bill for Equipment Acquisition">
      <bpmn:incoming>SequenceFlow_StartToTasks</bpmn:incoming>
      <bpmn:outgoing>MessageFlow_MPOO_Bill_Equipment</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for MPOO -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_MPOO_1" name="Bill Type?">
      <bpmn:incoming>SequenceFlow_StartToTasks</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToTask_Operations</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ToTask_Equipment</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- MPOO End Event -->
    <bpmn:endEvent id="EndEvent_MPOO_1" name="Bill Sent">
      <bpmn:incoming>SequenceFlow_ToTask_Operations</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows for MPOO -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToTasks" sourceRef="StartEvent_MPOO_1" targetRef="ExclusiveGateway_MPOO_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_ToTask_Operations" name="Operations Bill" sourceRef="ExclusiveGateway_MPOO_1" targetRef="EndEvent_MPOO_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_ToTask_Equipment" name="Equipment Bill" sourceRef="ExclusiveGateway_MPOO_1" targetRef="Task_MPOO_SendBill_Equipment"/>

  </bpmn:process>

  <!-- MSPO Process -->
  <bpmn:process id="Process_MSPO" isExecutable="false">
    <bpmn:startEvent id="StartEvent_MSPO_1" name="Receive Bill Request">
      <bpmn:outgoing>SequenceFlow_StartToTasks</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- MSPO Tasks -->
    <bpmn:task id="Task_MSPO_SendBill_Measurement" name="Send Bill for Temporary Continuation of Measurement">
      <bpmn:incoming>SequenceFlow_StartToTasks</bpmn:incoming>
      <bpmn:outgoing>MessageFlow_MSPO_Bill_Continuation</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_MSPO_SendBill_Readings" name="Send Bill for Additional Readings">
      <bpmn:incoming>SequenceFlow_StartToTasks</bpmn:incoming>
      <bpmn:outgoing>MessageFlow_MSPO_Bill_AdditionalReadings</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for MSPO -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_MSPO_1" name="Bill Type?">
      <bpmn:incoming>SequenceFlow_StartToTasks</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToTask_Measurement</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ToTask_Readings</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- MSPO End Event -->
    <bpmn:endEvent id="EndEvent_MSPO_1" name="Bill Sent">
      <bpmn:incoming>SequenceFlow_StartToTasks</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows for MSPO -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToTasks_MSPO" sourceRef="StartEvent_MSPO_1" targetRef="ExclusiveGateway_MSPO_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_ToTask_Measurement" name="Measurement Bill" sourceRef="ExclusiveGateway_MSPO_1" targetRef="EndEvent_MSPO_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_ToTask_Readings" name="Additional Readings Bill" sourceRef="ExclusiveGateway_MSPO_1" targetRef="Task_MSPO_SendBill_Readings"/>

  </bpmn:process>

  <!-- GO/MPON Process -->
  <bpmn:process id="Process_GO_MPON" isExecutable="false">
    <bpmn:startEvent id="StartEvent_GO_1" name="Receive Bill Request">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_StartToGateway</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Intermediate Catch Events for Bills -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_GO_ReceiveBill1" name="Receive Bill - Operations">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>MessageFlow_MPOO_Bill_Continuation</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToGatewayExamining</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_GO_ReceiveBill2" name="Receive Bill - Measurement">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>MessageFlow_MSPO_Bill_Continuation</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToGatewayExamining</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_GO_ReceiveBill3" name="Receive Bill - Additional Readings">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>MessageFlow_MSPO_Bill_AdditionalReadings</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToGatewayExamining</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Gateway for Equipment Bill -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_MPON_OR_GO_ReceiveEquipment" name="MPON or GO?">
      <bpmn:incoming>MessageFlow_MPOO_Bill_Equipment</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ExamineBill1</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task for Examining Bills -->
    <bpmn:task id="Task_GO_MPON_ExamineBill" name="Examine Bill">
      <bpmn:incoming>SequenceFlow_ToGatewayExamining</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToDecisionPoint</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for Decision -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_Decision" name="Confirm or Reject?">
      <bpmn:incoming>SequenceFlow_ExamineBill1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConfirmInvoice</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RejectInvoice</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Decision Tasks -->
    <bpmn:task id="Task_GOPPON_ConfirmInvoice" name="Confirm Invoice with Payment Advice">
      <bpmn:incoming>SequenceFlow_ToDecisionPoint</bpmn:incoming>
      <bpmn:outgoing>MessageFlow_Confirmation_PaymentAdvice</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_GO_MPON_RejectInvoice" name="Reject Invoice">
      <bpmn:incoming>SequenceFlow_ToDecisionPoint</bpmn:incoming>
      <bpmn:outgoing>MessageFlow_Rejection_InvoiceRejected</bpmn:outgoing>
    </bpmn:task>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_GO_1" name="Bill Processed">
      <bpmn:incoming>SequenceFlow_ExamineBill1</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows for GO/MPON -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToGateway" sourceRef="StartEvent_GO_1" targetRef="ExclusiveGateway_Decision"/>
    <bpmn:sequenceFlow id="SequenceFlow_ExamineBill1" name="Examine Equipment Bill" sourceRef="ExclusiveGateway_MPON_OR_GO_ReceiveEquipment" targetRef="EndEvent_GO_1"/>

  </bpmn:process>

</bpmn:definitions>