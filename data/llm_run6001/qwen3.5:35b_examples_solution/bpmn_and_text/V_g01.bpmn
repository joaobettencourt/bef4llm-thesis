<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_rob_burger_seller_fixed" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_RobotBurgerSeller_Fixed">
    <bpmn:participant id="Participant_BurgerRobot_Fixed" name="Robotic Burger Seller Process" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    
    <!-- Lane Set -->
    <bpmn:laneSet>
      <bpmn:lane id="Lane_RobotOperations_Fixed" name="Robot Operations">
        <bpmn:flowNodeRef>StartEvent_OrderReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_MenuDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_DrinkSizeInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_PrepDrink</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_FriesWedgesDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_PrepFries</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_PrepWedges</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_SidesComplete_Fixed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_BurgerStart_Fixed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_StatusUpdateLoop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_OrderCompleteCheck_Fixed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_PrepBurger</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_OrderReceived" name="Order Received">
      <bpmn:outgoing>SequenceFlow_StartToMenuDecision</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Menu Decision Gateway (Exclusive) -->
    <bpmn:exclusiveGateway id="InclusiveGateway_MenuDecision" name="Menu or Just Burger?">
      <bpmn:incoming>SequenceFlow_StartToMenuDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MenueYes_PrepDrink_Fixed</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_JustBurger_SkipDrinks_Fixed</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Drink Preparation (for Menu) -->
    <bpmn:userTask id="UserTask_DrinkSizeInfo" name="Ask drink size">
      <bpmn:incoming>SequenceFlow_MenueYes_PrepDrink_Fixed</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SizeToPrepDrink_Fixed</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Prepare Drink -->
    <bpmn:serviceTask id="ServiceTask_PrepDrink" name="Prepare drink">
      <bpmn:incoming>SequenceFlow_SizeToPrepDrink_Fixed</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DrinkDone_ToAskSides_Fixed</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Ask Fries or Wedges -->
    <bpmn:userTask id="UserTask_SideChoice" name="Ask fries or wedges?">
      <bpmn:incoming>SequenceFlow_DrinkDone_ToAskSides_Fixed</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AskToSideDecision_Fixed</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Fries/Wedges Decision Gateway -->
    <bpmn:exclusiveGateway id="InclusiveGateway_FriesWedgesDecision" name="Fries or Wedges?">
      <bpmn:incoming>SequenceFlow_AskToSideDecision_Fixed</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FriesYes_PrepFries_Fixed</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_WedgesNo_PrepWedges_Fixed</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Prepare Fries -->
    <bpmn:serviceTask id="ServiceTask_PrepFries" name="Prepare fries">
      <bpmn:incoming>SequenceFlow_FriesYes_PrepFries_Fixed</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FriesDone_ToSidesComplete_Fixed</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Prepare Wedges -->
    <bpmn:serviceTask id="ServiceTask_PrepWedges" name="Prepare wedges">
      <bpmn:incoming>SequenceFlow_WedgesNo_PrepWedges_Fixed</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WedgesDone_ToSidesComplete_Fixed</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Sides Complete Gateway (Converging) -->
    <bpmn:exclusiveGateway id="InclusiveGateway_SidesComplete_Fixed" name="">
      <bpmn:incoming>SequenceFlow_FriesDone_ToSidesComplete_Fixed</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_WedgesDone_ToSidesComplete_Fixed</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SidesToBurgerStart_Fixed</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Parallel Gateway for Burger Preparation -->
    <bpmn:parallelGateway id="ParallelGateway_BurgerStart_Fixed" name="">
      <bpmn:incoming>SequenceFlow_MenueYes_PrepDrink_Fixed</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SidesToBurgerStart_Fixed</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Burger Preparation -->
    <bpmn:serviceTask id="ServiceTask_PrepBurger" name="Prepare burger">
      <bpmn:incoming>SequenceFlow_BurgerFromParallel_Fixed</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BurgerToStatusLoop_Fixed</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Status Update Loop (every 30 seconds) -->
    <bpmn:userTask id="UserTask_StatusUpdateLoop" name="Give status updates">
      <bpmn:incoming>SequenceFlow_BurgerToStatusLoop_Fixed</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReviewOrderCompleteCheck_Fixed</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Order Complete Check Gateway -->
    <bpmn:exclusiveGateway id="InclusiveGateway_OrderCompleteCheck_Fixed" name="All ingredients ready?">
      <bpmn:incoming>SequenceFlow_ReviewOrderCompleteCheck_Fixed</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NotReady_BackToStatusLoop_Fixed</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_OrderDone_ToDelivery_Fixed</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Order Delivery -->
    <bpmn:serviceTask id="ServiceTask_Delivery" name="Deliver via conveyor belt">
      <bpmn:incoming>SequenceFlow_OrderDone_ToDelivery_Fixed</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DeliveredToEndEvent_Fixed</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_OrderDelivered" name="Order Delivered">
      <bpmn:incoming>SequenceFlow_DeliveredToEndEvent_Fixed</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToMenuDecision" sourceRef="StartEvent_OrderReceived" targetRef="InclusiveGateway_MenuDecision"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_MenueYes_PrepDrink_Fixed" name="Menu selected" sourceRef="InclusiveGateway_MenuDecision" targetRef="UserTask_DrinkSizeInfo">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_JustBurger_SkipDrinks_Fixed" name="Just burger" default="true" sourceRef="InclusiveGateway_MenuDecision" targetRef="ParallelGateway_BurgerStart_Fixed">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_SizeToPrepDrink_Fixed" sourceRef="UserTask_DrinkSizeInfo" targetRef="ServiceTask_PrepDrink"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_DrinkDone_ToAskSides_Fixed" name="" sourceRef="ServiceTask_PrepDrink" targetRef="UserTask_SideChoice">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_AskToSideDecision_Fixed" sourceRef="UserTask_SideChoice" targetRef="InclusiveGateway_FriesWedgesDecision"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_FriesYes_PrepFries_Fixed" name="Fries selected" sourceRef="InclusiveGateway_FriesWedgesDecision" targetRef="ServiceTask_PrepFries">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_WedgesNo_PrepWedges_Fixed" name="Wedges selected" sourceRef="InclusiveGateway_FriesWedgesDecision" targetRef="ServiceTask_PrepWedges">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_FriesDone_ToSidesComplete_Fixed" name="" sourceRef="ServiceTask_PrepFries" targetRef="InclusiveGateway_SidesComplete_Fixed"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_WedgesDone_ToSidesComplete_Fixed" name="" sourceRef="ServiceTask_PrepWedges" targetRef="InclusiveGateway_SidesComplete_Fixed">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_SidesToBurgerStart_Fixed" sourceRef="InclusiveGateway_SidesComplete_Fixed" targetRef="ParallelGateway_BurgerStart_Fixed"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_BurgerFromParallel_Fixed" name="" sourceRef="ParallelGateway_BurgerStart_Fixed" targetRef="ServiceTask_PrepBurger">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_BurgerToStatusLoop_Fixed" sourceRef="ServiceTask_PrepBurger" targetRef="UserTask_StatusUpdateLoop"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ReviewOrderCompleteCheck_Fixed" name="" sourceRef="UserTask_StatusUpdateLoop" targetRef="InclusiveGateway_OrderCompleteCheck_Fixed">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_NotReady_BackToStatusLoop_Fixed" name="Not ready yet" sourceRef="InclusiveGateway_OrderCompleteCheck_Fixed" targetRef="UserTask_StatusUpdateLoop">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_OrderDone_ToDelivery_Fixed" name="All ingredients ready" sourceRef="InclusiveGateway_OrderCompleteCheck_Fixed" targetRef="ServiceTask_Delivery"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_DeliveredToEndEvent_Fixed" sourceRef="ServiceTask_Delivery" targetRef="EndEvent_OrderDelivered">
      <bpmn:name/>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>