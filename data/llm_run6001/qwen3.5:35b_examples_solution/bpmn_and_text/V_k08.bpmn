<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_OnlineShopOrdering" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_OrderingInOnlineShop" isExecutable="false">

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_LoginInitiation" name="Open E-Shop Homepage">
      <bpmn:outgoing>SequenceFlow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- User Task: Login -->
    <bpmn:userTask id="Task_CustomerLogin" name="Customer logs into E-Shop">
      <bpmn:incoming>SequenceFlow_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_02</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Service Task: Credentials Check -->
    <bpmn:serviceTask id="Service_CheckCredentials" name="Customer credentials being checked by system">
      <bpmn:incoming>SequenceFlow_02</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_03</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Gateway: Successful Login? -->
    <bpmn:exclusiveGateway id="Gateway_LoginSuccess" name="Successful login?">
      <bpmn:incoming>SequenceFlow_03</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_04_Success</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_05_Fail</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event: Login Failed -->
    <bpmn:endEvent id="End_LoginFailed" name="Close E-Shop Homepage">
      <bpmn:incoming>SequenceFlow_05_Fail</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Loop Start Gateway (Converging from loop back) -->
    <bpmn:exclusiveGateway id="Gateway_LoopStart" name="">
      <bpmn:outgoing>SequenceFlow_06_SelectProduct</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- User Task: Select Product -->
    <bpmn:userTask id="Task_SelectProduct" name="Customer selects a product">
      <bpmn:incoming>SequenceFlow_06_SelectProduct</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_07_AddCart</bpmn:outgoing>
    </bpmn:userTask>

    <!-- User Task: Add to Cart -->
    <bpmn:userTask id="Task_AddToCart" name="Customer adds product to shopping cart">
      <bpmn:incoming>SequenceFlow_07_AddCart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_08_SaveProduct</bpmn:outgoing>
    </bpmn:userTask>

    <!-- User Task: Save Product -->
    <bpmn:userTask id="Task_SaveProduct" name="Customer saves product">
      <bpmn:incoming>SequenceFlow_08_SaveProduct</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_09_CheckSelection</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway: All Products Selected? -->
    <bpmn:exclusiveGateway id="Gateway_AllProductsSelected" name="Has customer selected all desired products?">
      <bpmn:incoming>SequenceFlow_09_CheckSelection</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_10_LoopBack</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_11_ProceedToOrderPrep</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Parallel Gateway Diverging (Start of Order Prep & Customer Actions) -->
    <bpmn:parallelGateway id="Parallel_OrderInitiation" name="">
      <bpmn:incoming>SequenceFlow_11_ProceedToOrderPrep</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_12_PaymentPrepare</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_13_ShipmentPrepare</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Service Task: Payment Prepared -->
    <bpmn:serviceTask id="Service_PaymentPrepared" name="Payment is prepared by system">
      <bpmn:incoming>SequenceFlow_12_PaymentPrepare</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_14_ConvergeSystemTasks</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Service Task: Shipment Prepared -->
    <bpmn:serviceTask id="Service_ShipmentPrepared" name="Shipment is prepared by system">
      <bpmn:incoming>SequenceFlow_13_ShipmentPrepare</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_14_ConvergeSystemTasks</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Parallel Gateway Converging (After System Prep) -->
    <bpmn:parallelGateway id="Parallel_SystemPrepDone" name="">
      <bpmn:incoming>SequenceFlow_14_ConvergeSystemTasks</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_15_EnterPaymentData</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- User Task: Enter Payment Data -->
    <bpmn:userTask id="Task_EnterPaymentData" name="Customer enters payment data">
      <bpmn:incoming>SequenceFlow_15_EnterPaymentData</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_16_SplitWaitAddress</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel Gateway Diverging (Concurrent Wait & Address Entry) -->
    <bpmn:parallelGateway id="Parallel_WaitAndAddress" name="">
      <bpmn:incoming>SequenceFlow_16_SplitWaitAddress</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_17_WaitBankConfirm</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_18_EnterShippingAddr</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task/Service: Wait for Bank Confirmation -->
    <bpmn:userTask id="Task_WaitBankConfirm" name="Customer waits until bank confirms payment">
      <bpmn:incoming>SequenceFlow_17_WaitBankConfirm</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_20_ConvergeFinalTasks</bpmn:outgoing>
    </bpmn:userTask>

    <!-- User Task: Enter Shipping Address -->
    <bpmn:userTask id="Task_EnterShippingAddress" name="Customer enters shipping address">
      <bpmn:incoming>SequenceFlow_18_EnterShippingAddr</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_21_CheckBillingMatch</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway: Shipping == Billing? -->
    <bpmn:exclusiveGateway id="Gateway_BillingCheck" name="If shipping address == billing address?">
      <bpmn:incoming>SequenceFlow_21_CheckBillingMatch</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_23_ConvergeAddressPathYes</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_24_EnterIndependentBilling</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- User Task: Enter Independent Billing Address -->
    <bpmn:userTask id="Task_EnterIndependentBilling" name="Customer enters an independent billing address">
      <bpmn:incoming>SequenceFlow_24_EnterIndependentBilling</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_19_ShippingDoneToFinalMerge</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway Converging Address Path -->
    <bpmn:exclusiveGateway id="Gateway_AddressConvergence" name="">
      <bpmn:incoming>SequenceFlow_23_ConvergeAddressPathYes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_19_ShippingDoneToFinalMerge</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Parallel Gateway Converging Final Tasks (Wait + Address) -->
    <bpmn:parallelGateway id="Parallel_FinalConvergence" name="">
      <bpmn:incoming>SequenceFlow_20_ConvergeFinalTasks</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_19_ShippingDoneToFinalMerge</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_25_FinishOrderSystem</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Service Task: Order Finished by System -->
    <bpmn:serviceTask id="Service_OrderFinished" name="Order is being finished by system">
      <bpmn:incoming>SequenceFlow_25_FinishOrderSystem</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_26_FinalEndEvent</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- End Event -->
    <bpmn:endEvent id="End_OrderCompleted" name="Close E-Shop Homepage">
      <bpmn:incoming>SequenceFlow_26_FinalEndEvent</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_01" name="" sourceRef="StartEvent_LoginInitiation" targetRef="Task_CustomerLogin"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_02" name="" sourceRef="Task_CustomerLogin" targetRef="Service_CheckCredentials"/>

    <bpmn:sequenceFlow id="SequenceFlow_03" name="" sourceRef="Service_CheckCredentials" targetRef="Gateway_LoginSuccess"/>

    <bpmn:sequenceFlow id="SequenceFlow_04_Success" name="Yes" sourceRef="Gateway_LoginSuccess" targetRef="Gateway_LoopStart"/>

    <bpmn:sequenceFlow id="SequenceFlow_05_Fail" name="No" sourceRef="Gateway_LoginSuccess" targetRef="End_LoginFailed"/>

    <!-- Loop Back Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_10_LoopBack" name="No" sourceRef="Gateway_AllProductsSelected" targetRef="Task_SelectProduct"/>

    <bpmn:sequenceFlow id="SequenceFlow_11_ProceedToOrderPrep" name="Yes" sourceRef="Gateway_AllProductsSelected" targetRef="Parallel_OrderInitiation"/>

    <!-- System Prep Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_12_PaymentPrepare" name="" sourceRef="Parallel_OrderInitiation" targetRef="Service_PaymentPrepared"/>

    <bpmn:sequenceFlow id="SequenceFlow_13_ShipmentPrepare" name="" sourceRef="Parallel_OrderInitiation" targetRef="Service_ShipmentPrepared"/>

    <!-- Convergence of System Prep -->
    <bpmn:sequenceFlow id="SequenceFlow_14_ConvergeSystemTasks" name="" sourceRef="Service_PaymentPrepared" targetRef="Parallel_SystemPrepDone"/>

    <!-- Customer Actions Start -->
    <bpmn:sequenceFlow id="SequenceFlow_15_EnterPaymentData" name="" sourceRef="Parallel_SystemPrepDone" targetRef="Task_EnterPaymentData"/>

    <!-- Split for Wait & Address -->
    <bpmn:sequenceFlow id="SequenceFlow_16_SplitWaitAddress" name="" sourceRef="Task_EnterPaymentData" targetRef="Parallel_WaitAndAddress"/>

    <!-- Parallel Branches -->
    <bpmn:sequenceFlow id="SequenceFlow_17_WaitBankConfirm" name="" sourceRef="Parallel_WaitAndAddress" targetRef="Task_WaitBankConfirm"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_18_EnterShippingAddr" name="" sourceRef="Parallel_WaitAndAddress" targetRef="Task_EnterShippingAddress"/>

    <!-- Address Logic -->
    <bpmn:sequenceFlow id="SequenceFlow_21_CheckBillingMatch" name="" sourceRef="Task_EnterShippingAddress" targetRef="Gateway_BillingCheck"/>

    <bpmn:sequenceFlow id="SequenceFlow_23_ConvergeAddressPathYes" name="" sourceRef="Gateway_AddressConvergence" targetRef="Parallel_FinalConvergence"/>

    <bpmn:sequenceFlow id="SequenceFlow_24_EnterIndependentBilling" name="No (Different)" sourceRef="Gateway_BillingCheck" targetRef="Task_EnterIndependentBilling"/>

    <!-- Final Convergence -->
    <bpmn:sequenceFlow id="SequenceFlow_19_ShippingDoneToFinalMerge" name="" sourceRef="Task_EnterIndependentBilling" targetRef="Parallel_FinalConvergence"/>

    <!-- Final Finish & End -->
    <bpmn:sequenceFlow id="SequenceFlow_20_ConvergeFinalTasks" name="" sourceRef="Task_WaitBankConfirm" targetRef="Parallel_FinalConvergence"/>

    <bpmn:sequenceFlow id="SequenceFlow_25_FinishOrderSystem" name="" sourceRef="Parallel_FinalConvergence" targetRef="Service_OrderFinished"/>

    <bpmn:sequenceFlow id="SequenceFlow_26_FinalEndEvent" name="" sourceRef="Service_OrderFinished" targetRef="End_OrderCompleted"/>

  </bpmn:process>
</bpmn:definitions>