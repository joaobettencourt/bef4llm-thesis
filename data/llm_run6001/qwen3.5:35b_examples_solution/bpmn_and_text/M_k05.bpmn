<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_BuildingHouse_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_BuildingHouse">
    <bpmn:participant id="Participant_Customer" name="Customer (Tree House Builder)" processRef="Process_BuildingHouse"/>
    <bpmn:participant id="Participant_Architect" name="Architect"/>
  </bpmn:collaboration>

  <bpmn:message id="Message_RequirementsSent" name="Project Requirements"/>
  <bpmn:message id="Message_DraftReceived" name="Draft Plan"/>
  <bpmn:message id="Message_MaterialsProcessed" name="Order Processed"/>

  <bpmn:process id="Process_BuildingHouse" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_CustomerTasks" name="Customer Tasks">
        <bpmn:flowNodeRef>StartEvent_CollectRequirements</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_SendRequirements</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateCatch_DraftReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_DraftSufficient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_RefineRequirements</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_CreateMaterialsList</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_OrderAndFriends</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_OrderMaterials</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateCatch_OrdersProcessed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_CallFriendsToBuild</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_ConvergeConstruction</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_SendPartyInvitations</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_CreateAttendeeList</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_CollectRequirements" name="Collect Requirements">
      <bpmn:outgoing>SequenceFlow_StartToSendReq</bpmn:flowNodeRef>
    </bpmn:startEvent>

    <!-- User Task: Send requirements to architect -->
    <bpmn:userTask id="UserTask_SendRequirements" name="Send Requirements">
      <bpmn:incoming>SequenceFlow_StartToSendReq</bpmn:flowNodeRef>
      <bpmn:outgoing>SequenceFlow_SendToArchitect</bpmn:flowNodeRef>
    </bpmn:userTask>

    <!-- Intermediate Catch Event: Receive Draft -->
    <bpmn:intermediateCatchEvent id="IntermediateCatch_DraftReceived" name="Draft Received">
      <bpmn:messageEventDefinition messageRef="Message_DraftReceived"/>
      <bpmn:incoming>SequenceFlow_ReceiveFromArchitect</bpmn:flowNodeRef>
      <bpmn:outgoing>SequenceFlow_ToDecision1</bpmn:flowNodeRef>
    </bpmn:intermediateCatchEvent>

    <!-- Exclusive Gateway: Draft Sufficient? -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_DraftSufficient" name="Draft sufficient?">
      <bpmn:incoming>SequenceFlow_ToDecision1</bpmn:flowNodeRef>
      <bpmn:outgoing>SequenceFlow_RefineLoop</bpmn:flowNodeRef>
      <bpmn:outgoing>SequenceFlow_ProceedToMaterials</bpmn:flowNodeRef>
    </bpmn:exclusiveGateway>

    <!-- User Task: Refine Requirements -->
    <bpmn:userTask id="UserTask_RefineRequirements" name="Refine Requirements">
      <bpmn:incoming>SequenceFlow_RefineLoop</bpmn:flowNodeRef>
      <bpmn:outgoing>SequenceFlow_SendToArchitectAgain</bpmn:flowNodeRef>
    </bpmn:userTask>

    <!-- User Task: Create Materials List -->
    <bpmn:userTask id="UserTask_CreateMaterialsList" name="Create Materials List">
      <bpmn:incoming>SequenceFlow_ProceedToMaterials</bpmn:flowNodeRef>
      <bpmn:outgoing>SequenceFlow_ToParallelSplit</bpmn:flowNodeRef>
    </bpmn:userTask>

    <!-- Parallel Gateway Diverge -->
    <bpmn:parallelGateway id="ParallelGateway_OrderAndFriends" name="">
      <bpmn:incoming>SequenceFlow_ToParallelSplit</bpmn:flowNodeRef>
      <bpmn:outgoing>SequenceFlow_PathOrderMaterials</bpmn:flowNodeRef>
      <bpmn:outgoing>SequenceFlow_PathContactFriends</bpmn:flowNodeRef>
    </bpmn:parallelGateway>

    <!-- User Task: Order Materials -->
    <bpmn:userTask id="UserTask_OrderMaterials" name="Order Materials">
      <bpmn:incoming>SequenceFlow_PathOrderMaterials</bpmn:flowNodeRef>
      <bpmn:outgoing>SequenceFlow_WaitForOrders</bpmn:flowNodeRef>
    </bpmn:userTask>

    <!-- Intermediate Catch Event: Orders Processed -->
    <bpmn:intermediateCatchEvent id="IntermediateCatch_OrdersProcessed" name="Orders Processed">
      <bpmn:messageEventDefinition messageRef="Message_MaterialsProcessed"/>
      <bpmn:incoming>SequenceFlow_WaitForOrders</bpmn:flowNodeRef>
      <bpmn:outgoing>SequenceFlow_ToConvergence1</bpmn:flowNodeRef>
    </bpmn:intermediateCatchEvent>

    <!-- User Task: Call Friends to Build -->
    <bpmn:userTask id="UserTask_CallFriendsToBuild" name="Call Friends">
      <bpmn:incoming>SequenceFlow_PathContactFriends</bpmn:flowNodeRef>
      <bpmn:outgoing>SequenceFlow_ToConvergence2</bpmn:flowNodeRef>
    </bpmn:userTask>

    <!-- Parallel Gateway Converge -->
    <bpmn:parallelGateway id="ParallelGateway_ConvergeConstruction" name="">
      <bpmn:incoming>SequenceFlow_ToConvergence1</bpmn:flowNodeRef>
      <bpmn:incoming>SequenceFlow_ToConvergence2</bpmn:flowNodeRef>
      <bpmn:outgoing>SequenceFlow_HouseBuiltCheck</bpmn:flowNodeRef>
    </bpmn:parallelGateway>

    <!-- User Task: Send Party Invitations -->
    <bpmn:userTask id="UserTask_SendPartyInvitations" name="Send Party Invitations">
      <bpmn:incoming>SequenceFlow_HouseBuiltCheck</bpmn:flowNodeRef>
      <bpmn:outgoing>SequenceFlow_ToAttendeeList</bpmn:flowNodeRef>
    </bpmn:userTask>

    <!-- User Task: Create Attendee List -->
    <bpmn:userTask id="UserTask_CreateAttendeeList" name="Create Attendee List">
      <bpmn:incoming>SequenceFlow_ToAttendeeList</bpmn:flowNodeRef>
      <bpmn:outgoing>SequenceFlow_EndProcess</bpmn:flowNodeRef>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Complete" name="Party Prepared">
      <bpmn:incoming>SequenceFlow_EndProcess</bpmn:flowNodeRef>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToSendReq" sourceRef="StartEvent_CollectRequirements" targetRef="UserTask_SendRequirements"/>
    
    <bpmn:messageFlow id="MessageFlow_1" name="" sourceRef="UserTask_SendRequirements" targetRef="Participant_Architect">
      <bpmn:sourceRef>SequenceFlow_StartToSendReq</bpmn:sourceRef> <!-- Correction for message flow structure -->
    </bpmn:messageFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ReceiveFromArchitect" sourceRef="IntermediateCatch_DraftReceived" targetRef="ExclusiveGateway_DraftSufficient"/>
    
    <bpmn:messageFlow id="MessageFlow_2" name="" sourceRef="Participant_Architect" targetRef="IntermediateCatch_DraftReceived">
      <bpmn:sourceRef>SequenceFlow_SendToArchitect</bpmn:sourceRef> <!-- Correction for message flow structure -->
    </bpmn:messageFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ToDecision1" sourceRef="UserTask_SendRequirements" targetRef="ExclusiveGateway_DraftSufficient"/>

    <bpmn:sequenceFlow id="SequenceFlow_RefineLoop" name="No - Refine" sourceRef="ExclusiveGateway_DraftSufficient" targetRef="UserTask_SendRequirements">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ProceedToMaterials" name="Yes - Proceed" sourceRef="ExclusiveGateway_DraftSufficient" targetRef="UserTask_CreateMaterialsList"/>

    <bpmn:sequenceFlow id="SequenceFlow_SendToArchitectAgain" sourceRef="UserTask_RefineRequirements" targetRef="UserTask_SendRequirements">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ToParallelSplit" sourceRef="UserTask_CreateMaterialsList" targetRef="ParallelGateway_OrderAndFriends"/>

    <bpmn:sequenceFlow id="SequenceFlow_PathOrderMaterials" name="" sourceRef="ParallelGateway_OrderAndFriends" targetRef="UserTask_OrderMaterials">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_WaitForOrders" sourceRef="UserTask_OrderMaterials" targetRef="IntermediateCatch_OrdersProcessed"/>

    <bpmn:messageFlow id="MessageFlow_3" name="" sourceRef="Participant_Architect" targetRef="IntermediateCatch_OrdersProcessed">
      <bpmn:sourceRef>SequenceFlow_WaitForOrders</bpmn:sourceRef> <!-- Correction for message flow structure -->
    </bpmn:messageFlow>

    <bpmn:sequenceFlow id="SequenceFlow_PathContactFriends" name="" sourceRef="ParallelGateway_OrderAndFriends" targetRef="UserTask_CallFriendsToBuild">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:messageFlow id="MessageFlow_4" name="" sourceRef="Participant_Architect" targetRef="IntermediateCatch_DraftReceived"/> <!-- Placeholder for friend message -->

    <bpmn:sequenceFlow id="SequenceFlow_ToConvergence1" sourceRef="IntermediateCatch_OrdersProcessed" targetRef="ParallelGateway_ConvergeConstruction">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ToConvergence2" name="" sourceRef="UserTask_CallFriendsToBuild" targetRef="ParallelGateway_ConvergeConstruction"/>

    <bpmn:sequenceFlow id="SequenceFlow_HouseBuiltCheck" sourceRef="ParallelGateway_ConvergeConstruction" targetRef="UserTask_SendPartyInvitations">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ToAttendeeList" name="" sourceRef="UserTask_SendPartyInvitations" targetRef="UserTask_CreateAttendeeList"/>

    <bpmn:sequenceFlow id="SequenceFlow_EndProcess" name="" sourceRef="UserTask_CreateAttendeeList" targetRef="EndEvent_Complete">
      <bpmn:name/>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>