<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_BecomingParent">
    <bpmn:participant id="Participant_ParentProcess" name="Becoming A Parent Process" processRef="Process_MaternityLeave"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_MaternityLeave" isExecutable="false">
    
    <!-- Lane Set -->
    <bpmn:laneSet>
      <bpmn:lane id="Lane_ParentEmployee" name="Parent/Employee">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_FetchModels</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_SelectModel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_CollectInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_ExtensionDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_DecideExtension</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Employer" name="Employer">
        <bpmn:flowNodeRef>InclusiveGateway_NotifyCompany</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_NotifyInTime</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_SocialSecurity" name="Social Security">
        <bpmn:flowNodeRef>InclusiveGateway_NotifySS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_GatherInfoFromSS</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Becoming Parent">
      <bpmn:outgoing>SequenceFlow_StartToFetchModels</bpmn:flowNodeRef>
    </bpmn:startEvent>

    <!-- Fetch Information Task -->
    <bpmn:userTask id="UserTask_FetchModels" name="Fetch potential models (duration, split)">
      <bpmn:incoming>SequenceFlow_StartToFetchModels</bpmn:flowNodeRef>
      <bpmn:outgoing>SequenceFlow_FetchToSelectModel</bpmn:flowNodeRef>
    </bpmn:userTask>

    <!-- Select Model Task -->
    <bpmn:userTask id="UserTask_SelectModel" name="Let parent select model">
      <bpmn:incoming>SequenceFlow_FetchToSelectModel</bpmn:flowNodeRef>
      <bpmn:outgoing>SequenceFlow_SelectToCollectInfo</bpmn:flowNodeRef>
    </bpmn:userTask>

    <!-- Collect Information Task -->
    <bpmn:userTask id="UserTask_CollectInfo" name="Collect relevant information">
      <bpmn:incoming>SequenceFlow_SelectToCollectInfo</bpmn:flowNodeRef>
      <bpmn:outgoing>SequenceFlow_CollectToNotifySS</bpmn:flowNodeRef>
    </bpmn:userTask>

    <!-- Notify Social Security -->
    <bpmn:exclusiveGateway id="InclusiveGateway_NotifySS" name="Notify SS?">
      <bpmn:incoming>SequenceFlow_CollectToNotifySS</bpmn:flowNodeRef>
      <bpmn:outgoing>SequenceFlow_SSNotificationYes</bpmn:flowNodeRef>
    </bpmn:exclusiveGateway>

    <!-- Notify Company -->
    <bpmn:exclusiveGateway id="InclusiveGateway_NotifyCompany" name="Notify Employer?">
      <bpmn:incoming>SequenceFlow_CollectToCollectInfo</bpmn:flowNodeRef>
      <bpmn:outgoing>SequenceFlow_EmployerNotificationYes</bpmn:flowNodeRef>
    </bpmn:exclusiveGateway>

    <!-- Notify In Time Tasks -->
    <bpmn:userTask id="UserTask_NotifyInTime" name="Notify in time">
      <bpmn:incoming>SequenceFlow_SSNotificationYes</bpmn:flowNodeRef>
      <bpmn:outgoing>SequenceFlow_NotifyToGatherInfoSS</bpmn:flowNodeRef>
    </bpmn:userTask>

    <!-- Gather Information Tasks -->
    <bpmn:userTask id="UserTask_GatherInfoFromSS" name="Gather info from Social Security">
      <bpmn:incoming>SequenceFlow_NotifyToGatherInfoSS</bpmn:flowNodeRef>
      <bpmn:outgoing>SequenceFlow_SSCompleteToEndEvent</bpmn:flowNodeRef>
    </bpmn:userTask>

    <!-- Parallel Gateway for concurrent notifications -->
    <bpmn:parallelGateway id="InclusiveGateway_ModelSelection" name="Concurrent Notifications">
      <bpmn:incoming>SequenceFlow_SelectToCollectInfo</bpmn:flowNodeRef>
      <bpmn:outgoing>SequenceFlow_CollectToNotifySS</bpmn:flowNodeRef>
    </bpmn:parallelGateway>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_1" name="Maternity Leave Taken">
      <bpmn:incoming>SequenceFlow_SSCompleteToEndEvent</bpmn:flowNodeRef>
    </bpmn:endEvent>

    <!-- Extension Decision Gateway (at end of period) -->
    <bpmn:exclusiveGateway id="InclusiveGateway_ExtensionDecision" name="Extend leave?">
      <bpmn:incoming>SequenceFlow_EndFromParallel</bpmn:flowNodeRef>
      <bpmn:outgoing>SequenceFlow_DecideYes</bpmn:flowNodeRef>
    </bpmn:exclusiveGateway>

    <!-- Decide Extension Task -->
    <bpmn:userTask id="UserTask_DecideExtension" name="Decide about extension">
      <bpmn:incoming>SequenceFlow_DecideYes</bpmn:flowNodeRef>
      <bpmn:outgoing>SequenceFlow_ExtendToEndEvent</bpmn:flowNodeRef>
    </bpmn:userTask>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToFetchModels" name="" sourceRef="StartEvent_1" targetRef="UserTask_FetchModels"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_FetchToSelectModel" name="" sourceRef="UserTask_FetchModels" targetRef="UserTask_SelectModel"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_SelectToCollectInfo" name="" sourceRef="UserTask_SelectModel" targetRef="InclusiveGateway_ModelSelection"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_CollectToNotifySS" name="" sourceRef="InclusiveGateway_ModelSelection" targetRef="InclusiveGateway_NotifySS"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_SSNotificationYes" name="yes" sourceRef="InclusiveGateway_NotifySS" targetRef="UserTask_NotifyInTime"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_CollectToCollectInfo" name="" sourceRef="UserTask_SelectModel" targetRef="InclusiveGateway_ModelSelection"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_NotifyToGatherInfoSS" name="" sourceRef="UserTask_NotifyInTime" targetRef="UserTask_GatherInfoFromSS"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_SSCompleteToEndEvent" name="" sourceRef="UserTask_GatherInfoFromSS" targetRef="EndEvent_1"/>

  </bpmn:process>

</bpmn:definitions>