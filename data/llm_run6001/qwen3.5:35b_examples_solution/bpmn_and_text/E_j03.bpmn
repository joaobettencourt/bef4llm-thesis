<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_WorkAccident_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_WorkAccident">
    <bpmn:participant id="Participant_WorkAccident_Process" name="Work Accident Reporting Process" processRef="Process_WorkAccident_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_WorkAccident_1" isExecutable="false">
    
    <!-- Lane Set -->
    <bpmn:laneSet>
      <bpmn:lane id="Lane_HumanAction" name="Human Action">
        <bpmn:flowNodeRef>StartEvent_Incident</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssessIncidentType</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_VictimStudent</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_SystemAction" name="System Action">
        <bpmn:flowNodeRef>Gateway_WorkAccidentCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EmployeeInformEmployer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EmployerReportInspectorate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReportInsuranceProvider</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Incident" name="Incident Happens">
      <bpmn:outgoing>SequenceFlow_StartToAssessment</bpmn:flowNodeRef>
    </bpmn:startEvent>

    <!-- Task for Initial Assessment -->
    <bpmn:task id="Task_AssessIncidentType" name="Start Incident Assessment Tool">
      <bpmn:incoming>SequenceFlow_StartToAssessment</bpmn:flowNodeRef>
      <bpmn:outgoing>SequenceFlow_AssessmentToGateway</bpmn:flowNodeRef>
    </bpmn:task>

    <!-- Gateway for Work Accident Classification -->
    <bpmn:exclusiveGateway id="Gateway_WorkAccidentCheck" name="Work Accident?">
      <bpmn:incoming>SequenceFlow_AssessmentToGateway</bpmn:flowNodeRef>
      <bpmn:outgoing>SequenceFlow_IsWorkAccident</bpmn:flowNodeRef>
      <bpmn:outgoing>SequenceFlow_AlmostAccident</bpmn:flowNodeRef>
    </bpmn:exclusiveGateway>

    <!-- Task for Employee Reporting -->
    <bpmn:task id="Task_EmployeeInformEmployer" name="Employee Informs Employer">
      <bpmn:incoming>SequenceFlow_IsWorkAccident</bpmn:flowNodeRef>
      <bpmn:outgoing>SequenceFlow_InformToInspectorateCheck</bpmn:flowNodeRef>
    </bpmn:task>

    <!-- Task for Employer Reporting -->
    <bpmn:task id="Task_EmployerReportInspectorate" name="Employer Reports to Labour Inspectorate">
      <bpmn:incoming>SequenceFlow_InformToInspectorateCheck</bpmn:flowNodeRef>
      <bpmn:outgoing>SequenceFlow_InsuranceProviderReporting</bpmn:flowNodeRef>
    </bpmn:task>

    <!-- Task for Insurance Provider Reporting -->
    <bpmn:task id="Task_ReportInsuranceProvider" name="Report to Accident Insurance Provider">
      <bpmn:incoming>SequenceFlow_InsuranceProviderReporting</bpmn:flowNodeRef>
      <bpmn:outgoing>SequenceFlow_VictimStudentCheck</bpmn:flowNodeRef>
    </bpmn:task>

    <!-- Gateway for Victim Type -->
    <bpmn:exclusiveGateway id="Gateway_VictimStudent" name="Victim is Student?">
      <bpmn:incoming>SequenceFlow_VictimStudentCheck</bpmn:flowNodeRef>
      <bpmn:outgoing>SequenceFlow_YesStudent</bpmn:flowNodeRef>
      <bpmn:outgoing>SequenceFlow_NoStudent</bpmn:flowNodeRef>
    </bpmn:exclusiveGateway>

    <!-- End Event for Process Completion -->
    <bpmn:endEvent id="EndEvent_ProcessComplete" name="Process Complete">
      <bpmn:incoming>SequenceFlow_FatalityCheckDone</bpmn:flowNodeRef>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToAssessment" sourceRef="StartEvent_Incident" targetRef="Task_AssessIncidentType"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_AssessmentToGateway" name="" sourceRef="Task_AssessIncidentType" targetRef="Gateway_WorkAccidentCheck"/>

    <bpmn:sequenceFlow id="SequenceFlow_IsWorkAccident" name="Yes - Work Accident" sourceRef="Gateway_WorkAccidentCheck" targetRef="Task_EmployeeInformEmployer"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_AlmostAccident" name="Almost Accident / Risk Report" sourceRef="Gateway_WorkAccidentCheck" targetRef="EndEvent_ProcessComplete"/>

    <bpmn:sequenceFlow id="SequenceFlow_InformToInspectorateCheck" sourceRef="Task_EmployeeInformEmployer" targetRef="Gateway_Fatality"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_InsuranceProviderReporting" name="" sourceRef="Task_EmployerReportInspectorate" targetRef="Task_ReportInsuranceProvider"/>

    <bpmn:sequenceFlow id="SequenceFlow_VictimStudentCheck" sourceRef="Task_ReportInsuranceProvider" targetRef="Gateway_VictimStudent"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_YesStudent" name="Yes - Student/Schoolchild" sourceRef="Gateway_VictimStudent" targetRef="EndEvent_ProcessComplete"/>

    <bpmn:sequenceFlow id="SequenceFlow_NoStudent" name="No - Not a Student" sourceRef="Gateway_VictimStudent" targetRef="Task_PrivateInsuranceReport"/>
    
    <bpmn:exclusiveGateway id="Gateway_Fatality" name="Fatality?">
      <bpmn:incoming>SequenceFlow_YesStudent</bpmn:flowNodeRef>
      <bpmn:outgoing>SequenceFlow_YesFatality</bpmn:flowNodeRef>
    </bpmn:exclusiveGateway>

    <!-- Task for Private Insurance Reporting -->
    <bpmn:task id="Task_PrivateInsuranceReport" name="Private Insurance Report">
      <bpmn:incoming>SequenceFlow_NoStudent</bpmn:flowNodeRef>
      <bpmn:outgoing>SequenceFlow_FatalityCheckDone</bpmn:flowNodeRef>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_YesFatality" name="Yes - Fatality/Severe Injury (3+ days)" sourceRef="Gateway_Fatality" targetRef="EndEvent_ProcessComplete"/>

  </bpmn:process>

</bpmn:definitions>