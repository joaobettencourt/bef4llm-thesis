<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_LegoMachine_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_LegoProcess">
    <bpmn:participant id="Participant_MachineBuilding" name="Lego Machine Building Process" processRef="Process_BuildMachine"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_BuildMachine" isExecutable="false">
    
    <!-- Lane Set -->
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Designer" name="Designer/Engineer">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OrderSets</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_MoreSubcomponents</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_CheckStock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BuildSubcomponent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TestSubcomponent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_PassedTest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReworkRedesign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssembleMachine</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Children" name="Children/Specialists">
        <bpmn:flowNodeRef>Task_SortParts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReorderIndividualParts</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Custom machine building">
      <bpmn:outgoing>bpmn_flow_StartToDesign</bpmn:flowNodeRef>
    </bpmn:startEvent>

    <!-- Task: Develop Basic Design (Implicitly first step) -->
    <bpmn:userTask id="Task_OrderSets" name="Develop basic design">
      <bpmn:incoming>bpmn_flow_StartToDesign</bpmn:flowNodeRef>
      <bpmn:outgoing>bpmn_flow_DesignToOrder</bpmn:flowNodeRef>
    </bpmn:userTask>

    <!-- Task: Order Sets -->
    <bpmn:userTask id="Task_OrderSets" name="Order lego brick sets">
      <bpmn:incoming>bpmn_flow_DesignToOrder</bpmn:flowNodeRef>
      <bpmn:outgoing>bpmn_flow_OrderToSort</bpmn:flowNodeRef>
    </bpmn:userTask>

    <!-- Task: Sort Parts (Children) -->
    <bpmn:userTask id="Task_SortParts" name="Sort parts into containers">
      <bpmn:incoming>bpmn_flow_OrderToSort</bpmn:flowNodeRef>
      <bpmn:outgoing>bpmn_flow_SortToLoopCheck</bpmn:flowNodeRef>
    </bpmn:userTask>

    <!-- Gateway: More Subcomponents Needed? -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_MoreSubcomponents" name="More subcomponents needed?" gatewayDirection="Diverging">
      <bpmn:incoming>bpmn_flow_SortToLoopCheck</bpmn:flowNodeRef>
      <bpmn:outgoing>bpmn_flow_YesBuildCycle</bpmn:flowNodeRef>
      <bpmn:outgoing>bpmn_flow_NoAssembleEnd</bpmn:flowNodeRef>
    </bpmn:exclusiveGateway>

    <!-- Gateway: Check Stock -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_CheckStock" name="Parts available in container?" gatewayDirection="Diverging">
      <bpmn:incoming>bpmn_flow_YesBuildCycle</bpmn:flowNodeRef>
      <bpmn:outgoing>bpmn_flow_NoReorder</bpmn:flowNodeRef>
      <bpmn:outgoing>bpmn_flow_YesBuildTask</bpmn:flowNodeRef>
    </bpmn:exclusiveGateway>

    <!-- Task: Reorder Individual Parts -->
    <bpmn:userTask id="Task_ReorderIndividualParts" name="Reorder individual parts">
      <bpmn:incoming>bpmn_flow_NoReorder</bpmn:flowNodeRef>
      <bpmn:outgoing>bpmn_flow_ReloadToBuildCheck</bpmn:flowNodeRef>
    </bpmn:userTask>

    <!-- Gateway Merge for Reordered Parts -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_MergeReorder" name="" gatewayDirection="Converging">
      <bpmn:incoming>bpmn_flow_YesBuildTask</bpmn:flowNodeRef>
      <bpmn:incoming>bpmn_flow_ReloadToBuildCheck</bpmn:flowNodeRef>
      <bpmn:outgoing>bpmn_flow_BuildSubcomponentFlow</bpmn:flowNodeRef>
    </bpmn:exclusiveGateway>

    <!-- Task: Build Subcomponent -->
    <bpmn:userTask id="Task_BuildSubcomponent" name="Build subcomponent">
      <bpmn:incoming>bpmn_flow_BuildSubcomponentFlow</bpmn:flowNodeRef>
      <bpmn:outgoing>bpmn_flow_TestSubcomponentFlow</bpmn:flowNodeRef>
    </bpmn:userTask>

    <!-- Task: Test Subcomponent -->
    <bpmn:userTask id="Task_TestSubcomponent" name="Test subcomponent">
      <bpmn:incoming>bpmn_flow_TestSubcomponentFlow</bpmn:flowNodeRef>
      <bpmn:outgoing>bpmn_flow_CheckPassedResult</bpmn:flowNodeRef>
    </bpmn:userTask>

    <!-- Gateway: Test Passed? -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_PassedTest" name="Did it pass the test?" gatewayDirection="Diverging">
      <bpmn:incoming>bpmn_flow_CheckPassedResult</bpmn:flowNodeRef>
      <bpmn:outgoing>bpmn_flow_NoRework</bpmn:flowNodeRef>
      <bpmn:outgoing>bpmn_flow_YesLoopCheck</bpmn:flowNodeRef>
    </bpmn:exclusiveGateway>

    <!-- Task: Redesign & Rebuild -->
    <bpmn:userTask id="Task_ReworkRedesign" name="Redesign and rebuild">
      <bpmn:incoming>bpmn_flow_NoRework</bpmn:flowNodeRef>
      <bpmn:outgoing>bpmn_flow_RedirectToBuild</bpmn:flowNodeRef>
    </bpmn:userTask>

    <!-- Task: Assemble Machine -->
    <bpmn:userTask id="Task_AssembleMachine" name="Assemble machine">
      <bpmn:incoming>bpmn_flow_NoAssembleEnd</bpmn:flowNodeRef>
      <bpmn:outgoing>bpmn_flow_EndProcessFlow</bpmn:flowNodeRef>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_1" name="Machine Built">
      <bpmn:incoming>bpmn_flow_EndProcessFlow</bpmn:flowNodeRef>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="bpmn_flow_StartToDesign" sourceRef="StartEvent_1" targetRef="Task_OrderSets">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="bpmn_flow_DesignToOrder" name="" sourceRef="Task_OrderSets" targetRef="Task_OrderSets"/> <!-- Correction needed for unique IDs -->
    
    <!-- Re-structuring to ensure valid flow without duplicate Task IDs in my thought process above. 
         Let's fix the ID conflict: Start -> Design (Task) -> Order Sets (Task). 
         In previous draft I had two tasks with same ID 'Task_OrderSets'. Fixing this now. -->
         
    <bpmn:userTask id="Task_DevelopDesign" name="Develop basic design">
      <bpmn:incoming>bpmn_flow_StartToDesign</bpmn:flowNodeRef>
      <bpmn:outgoing>bpmn_flow_DesignToOrderSets</bpmn:flowNodeRef>
    </bpmn:userTask>

    <!-- Task: Order Sets -->
    <bpmn:userTask id="Task_OrderSets" name="Order lego brick sets">
      <bpmn:incoming>bpmn_flow_DesignToOrderSets</bpmn:flowNodeRef>
      <bpmn:outgoing>bpmn_flow_OrderToSort</bpmn:flowNodeRef>
    </bpmn:userTask>

    <!-- Task: Sort Parts (Children) -->
    <bpmn:userTask id="Task_SortParts" name="Sort parts into containers">
      <bpmn:incoming>bpmn_flow_OrderToSort</bpmn:flowNodeRef>
      <bpmn:outgoing>bpmn_flow_SortToLoopCheck</bpmn:flowNodeRef>
    </bpmn:userTask>

    <!-- Gateway: More Subcomponents Needed? -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_MoreSubcomponents" name="More subcomponents needed?" gatewayDirection="Diverging">
      <bpmn:incoming>bpmn_flow_SortToLoopCheck</bpmn:flowNodeRef>
      <bpmn:outgoing>bpmn_flow_YesBuildCycle</bpmn:flowNodeRef>
      <bpmn:outgoing>bpmn_flow_NoAssembleEnd</bpmn:flowNodeRef>
    </bpmn:exclusiveGateway>

    <!-- Gateway: Check Stock -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_CheckStock" name="Parts available in container?" gatewayDirection="Diverging">
      <bpmn:incoming>bpmn_flow_YesBuildCycle</bpmn:flowNodeRef>
      <bpmn:outgoing>bpmn_flow_NoReorder</bpmn:flowNodeRef>
      <bpmn:outgoing>bpmn_flow_YesBuildTask</bpmn:flowNodeRef>
    </bpmn:exclusiveGateway>

    <!-- Task: Reorder Individual Parts -->
    <bpmn:userTask id="Task_ReorderIndividualParts" name="Reorder individual parts">
      <bpmn:incoming>bpmn_flow_NoReorder</bpmn:flowNodeRef>
      <bpmn:outgoing>bpmn_flow_ReloadToBuildCheck</bpmn:flowNodeRef>
    </bpmn:userTask>

    <!-- Gateway Merge for Reordered Parts -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_MergeReorder" name="" gatewayDirection="Converging">
      <bpmn:incoming>bpmn_flow_YesBuildTask</bpmn:flowNodeRef>
      <bpmn:incoming>bpmn_flow_ReloadToBuildCheck</bpmn:flowNodeRef>
      <bpmn:outgoing>bpmn_flow_BuildSubcomponentFlow</bpmn:flowNodeRef>
    </bpmn:exclusiveGateway>

    <!-- Task: Build Subcomponent -->
    <bpmn:userTask id="Task_BuildSubcomponent" name="Build subcomponent">
      <bpmn:incoming>bpmn_flow_BuildSubcomponentFlow</bpmn:flowNodeRef>
      <bpmn:outgoing>bpmn_flow_TestSubcomponentFlow</bpmn:flowNodeRef>
    </bpmn:userTask>

    <!-- Task: Test Subcomponent -->
    <bpmn:userTask id="Task_TestSubcomponent" name="Test subcomponent">
      <bpmn:incoming>bpmn_flow_TestSubcomponentFlow</bpmn:flowNodeRef>
      <bpmn:outgoing>bpmn_flow_CheckPassedResult</bpmn:flowNodeRef>
    </bpmn:userTask>

    <!-- Gateway: Test Passed? -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_PassedTest" name="Did it pass the test?" gatewayDirection="Diverging">
      <bpmn:incoming>bpmn_flow_CheckPassedResult</bpmn:flowNodeRef>
      <bpmn:outgoing>bpmn_flow_NoRework</bpmn:flowNodeRef>
      <bpmn:outgoing>bpmn_flow_YesLoopCheck</bpmn:flowNodeRef>
    </bpmn:exclusiveGateway>

    <!-- Task: Redesign & Rebuild -->
    <bpmn:userTask id="Task_ReworkRedesign" name="Redesign and rebuild">
      <bpmn:incoming>bpmn_flow_NoRework</bpmn:flowNodeRef>
      <bpmn:outgoing>bpmn_flow_RedirectToBuild</bpmn:flowNodeRef>
    </bpmn:userTask>

    <!-- Task: Assemble Machine -->
    <bpmn:userTask id="Task_AssembleMachine" name="Assemble machine">
      <bpmn:incoming>bpmn_flow_NoAssembleEnd</bpmn:flowNodeRef>
      <bpmn:outgoing>bpmn_flow_EndProcessFlow</bpmn:flowNodeRef>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_1" name="Machine Built">
      <bpmn:incoming>bpmn_flow_EndProcessFlow</bpmn:flowNodeRef>
    </bpmn:endEvent>

    <!-- Sequence Flows (Re-ordered for clarity and validity) -->
    
    <bpmn:sequenceFlow id="bpmn_flow_StartToDesign" sourceRef="StartEvent_1" targetRef="Task_DevelopDesign"/>
    
    <bpmn:sequenceFlow id="bpmn_flow_DesignToOrderSets" name="" sourceRef="Task_DevelopDesign" targetRef="Task_OrderSets"/>

    <bpmn:sequenceFlow id="bpmn_flow_OrderToSort" sourceRef="Task_OrderSets" targetRef="Task_SortParts"/>
    
    <bpmn:sequenceFlow id="bpmn_flow_SortToLoopCheck" name="" sourceRef="Task_SortParts" targetRef="ExclusiveGateway_MoreSubcomponents"/>

    <!-- Loop Start -->
    <bpmn:sequenceFlow id="bpmn_flow_YesBuildCycle" name="Yes (More needed)" sourceRef="ExclusiveGateway_MoreSubcomponents" targetRef="ExclusiveGateway_CheckStock"/>
    
    <!-- End of Build Cycle / Assemble Path -->
    <bpmn:sequenceFlow id="bpmn_flow_NoAssembleEnd" name="No (All done)" sourceRef="ExclusiveGateway_MoreSubcomponents" targetRef="Task_AssembleMachine"/>

    <!-- Stock Check Paths -->
    <bpmn:sequenceFlow id="bpmn_flow_YesBuildTask" name="Parts Available" sourceRef="ExclusiveGateway_CheckStock" targetRef="ExclusiveGateway_MergeReorder"/>
    
    <bpmn:sequenceFlow id="bpmn_flow_NoReorder" name="No Parts (Empty)" sourceRef="ExclusiveGateway_CheckStock" targetRef="Task_ReorderIndividualParts"/>

    <!-- Reorder Merge -->
    <bpmn:sequenceFlow id="bpmn_flow_ReloadToBuildCheck" sourceRef="Task_ReorderIndividualParts" targetRef="ExclusiveGateway_MergeReorder"/>

    <!-- Build Flow -->
    <bpmn:sequenceFlow id="bpmn_flow_BuildSubcomponentFlow" name="" sourceRef="ExclusiveGateway_MergeReorder" targetRef="Task_BuildSubcomponent"/>

    <!-- Test Flow -->
    <bpmn:sequenceFlow id="bpmn_flow_TestSubcomponentFlow" sourceRef="Task_BuildSubcomponent" targetRef="Task_TestSubcomponent"/>

    <!-- Rework Loop Back to Build Check (Merge) -->
    <bpmn:sequenceFlow id="bpmn_flow_RedirectToBuild" name="" sourceRef="Task_ReworkRedesign" targetRef="ExclusiveGateway_MergeReorder"/>

    <!-- Test Passed Paths -->
    <bpmn:sequenceFlow id="bpmn_flow_NoRework" name="Failed (No)" sourceRef="ExclusiveGateway_PassedTest" targetRef="Task_ReworkRedesign"/>

    <bpmn:sequenceFlow id="bpmn_flow_YesLoopCheck" name="Passed (Yes)" sourceRef="ExclusiveGateway_PassedTest" targetRef="ExclusiveGateway_MoreSubcomponents"/>

    <!-- Final Assembly Flow -->
    <bpmn:sequenceFlow id="bpmn_flow_EndProcessFlow" sourceRef="Task_AssembleMachine" targetRef="EndEvent_1"/>

  </bpmn:process>
</bpmn:definitions>