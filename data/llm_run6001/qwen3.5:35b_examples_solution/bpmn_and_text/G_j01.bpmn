<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_FarmingBot_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_FarmingBot">
    <bpmn:participant id="Participant_FarmingBot" name="Farming Bot Process" processRef="Process_FarmingBot"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_FarmingBot" isExecutable="false">
    
    <!-- Data Objects -->
    <bpmn:dataObject id="DataResourceList" name="Selected Resources List"/>
    <bpmn:dataObject id="DataTableTools" name="Tool Requirements List"/>
    <bpmn:dataObject id="DataFarmingProgress" name="Bot Progress Status"/>

    <!-- Start Event -->
    <bpmn:startEvent id="Start_CreateBot" name="Create Custom Farming Bot">
      <bpmn:outgoing>Flow_StartToResourceSelection</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Select Resources (up to 10 in parallel) -->
    <bpmn:userTask id="Task_SelectResources" name="Select Up To 10 Resources">
      <bpmn:incoming>Flow_StartToResourceSelection</bpmn:incoming>
      <bpmn:outgoing>Flow_ResourcesSelected</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel Gateway for Resource Collection -->
    <bpmn:parallelGateway id="Parallel_ResourceCollection" name="Collect Resources">
      <bpmn:incoming>Flow_ResourcesSelected</bpmn:incoming>
      <bpmn:outgoing>Flow_CollectResource1</bpmn:outgoing>
      <bpmn:outgoing>Flow_CollectResource2</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Resource Collection Tasks (representing up to 10 parallel resources) -->
    <bpmn:userTask id="Task_CollectRes1" name="Collect Urgent Resources">
      <bpmn:incoming>Flow_CollectResource1</bpmn:incoming>
      <bpmn:outgoing>Flow_Res1Complete</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task for Tool Creation -->
    <bpmn:userTask id="Task_CreateTools" name="Create Tools for Other Resources">
      <bpmn:incoming>Flow_ResourcesSelected</bpmn:incoming>
      <bpmn:outgoing>Flow_ToolsCreated</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Exclusive Gateway: Check if tools needed -->
    <bpmn:exclusiveGateway id="Gateway_ToolCheck" name="Tools Needed?">
      <bpmn:incoming>Flow_ResourcesSelected</bpmn:incoming>
      <bpmn:outgoing>Flow_CreateToolsPath</bpmn:outgoing>
      <bpmn:outgoing>Flow_StartFarmingPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Event-Based Gateway for Natural Disasters -->
    <bpmn:eventBasedGateway id="Event_DisasterOrMilestone" name="Disaster or Milestone">
      <bpmn:incoming>Flow_FarmingLoop</bpmn:incoming>
      <bpmn:outgoing>Flow_NaturalDisasterPath</bpmn:outgoing>
      <bpmn:outgoing>Flow_MilestoneReachedPath</bpmn:outgoing>
    </bpmn:eventBasedGateway>

    <!-- Intermediate Catch Event: Natural Disaster -->
    <bpmn:intermediateCatchEvent id="Event_NaturalDisaster" name="Natural Disaster">
      <bpmn:incoming>Flow_NaturalDisasterPath</bpmn:incoming>
      <bpmn:outgoing>Flow_DisasterRecovery</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task: Recovery from Disaster -->
    <bpmn:userTask id="Task_RecoverFromDisaster" name="Bot Set Back - Recover">
      <bpmn:incoming>Flow_DisasterRecovery</bpmn:incoming>
      <bpmn:outgoing>Flow_ResumeFarming</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Intermediate Catch Event: Milestone Reached -->
    <bpmn:intermediateCatchEvent id="Event_MilestoneReached" name="Milestone">
      <bpmn:incoming>Flow_MilestoneReachedPath</bpmn:incoming>
      <bpmn:outgoing>Flow_NotifyPlayer</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Service Task: Notify Player -->
    <bpmn:serviceTask id="ServiceNotify" name="Notify Player of Milestone">
      <bpmn:incoming>Flow_NotifyPlayer</bpmn:incoming>
      <bpmn:outgoing>Flow_ContinueFarmingPath2</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Exclusive Gateway: Update List? -->
    <bpmn:exclusiveGateway id="Gateway_UpdateList" name="Update Materials List?">
      <bpmn:incoming>Flow_FarmingLoop</bpmn:incoming>
      <bpmn:outgoing>Flow_ContinueFarmingPath</bpmn:outgoing>
      <bpmn:outgoing>Flow_UpdateListPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Update Materials List -->
    <bpmn:userTask id="Task_UpdateMaterials" name="Update Farming Materials">
      <bpmn:incoming>Flow_UpdateListPath</bpmn:incoming>
      <bpmn:outgoing>Flow_ResumeFarmingAfterUpdate</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel Gateway for Final Actions -->
    <bpmn:parallelGateway id="Parallel_FinalActions" name="Final Actions">
      <bpmn:incoming>Flow_FarmComplete</bpmn:incoming>
      <bpmn:outgoing>Flow_BragToFriendsPath</bpmn:outgoing>
      <bpmn:outgoing>Flow_SendMaterialsPath</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- User Task: Brag to Friends -->
    <bpmn:userTask id="Task_BragToFriends" name="Brag to Selected Friends">
      <bpmn:incoming>Flow_BragToFriendsPath</bpmn:incoming>
      <bpmn:outgoing>Flow_FinalConverge1</bpmn:outgoing>
    </