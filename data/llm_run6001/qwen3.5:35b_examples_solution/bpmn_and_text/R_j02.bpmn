<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_InspectionMachine" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_MachineInspection">
    <bpmn:participant id="Participant_InspectionProcess" name="Energy Drink Bottling Machine Inspection" processRef="Process_Inspection"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Inspection" isExecutable="false">
    
    <!-- Lane Set -->
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Operator" name="Machine Operator">
        <bpmn:flowNodeRef>StartEvent_Connected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_Configuration</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_VisualInspection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_FinalReport</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_System" name="Automated System">
        <bpmn:flowNodeRef>InclusiveGateway_ErrorCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_ClearErrors</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BPMNEvent_InspectionComplete</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Connected" name="Testing device connected">
      <bpmn:outgoing>bpmn_flow_StartToConfig</bpmn:flowNodeRef>
    </bpmn:startEvent>

    <!-- User Task for Configuration Input -->
    <bpmn:userTask id="UserTask_Configuration" name="Enter machine type and serial number">
      <bpmn:incoming>bpmn_flow_StartToConfig</bpmn:flowNodeRef>
      <bpmn:outgoing>bpmn_flow_ConfToInspectionStart</bpmn:flowNodeRef>
    </bpmn:userTask>

    <!-- Parallel Gateway for Inspection Activities -->
    <bpmn:parallelGateway id="ParallelGateway_Inspection" name="">
      <bpmn:incoming>bpmn_flow_ConfToInspectionStart</bpmn:flowNodeRef>
      <bpmn:outgoing>bpmn_flow_VisualCheck</bpmn:flowNodeRef>
      <bpmn:outgoing>bpmn_flow_AutoDataCollection</bpmn:flowNodeRef>
    </bpmn:parallelGateway>

    <!-- Manual Task for Visual Inspection -->
    <bpmn:userTask id="UserTask_VisualInspection" name="Visual inspection">
      <bpmn:incoming>bpmn_flow_VisualCheck</bpmn:flowNodeRef>
      <bpmn:outgoing>bpmn_flow_VisualToConverge</bpmn:flowNodeRef>
    </bpmn:userTask>

    <!-- Service Task for Automated Data Collection -->
    <bpmn:serviceTask id="ServiceTask_DataCollection" name="Collect machine data automatically">
      <bpmn:incoming>bpmn_flow_AutoDataCollection</bpmn:flowNodeRef>
      <bpmn:outgoing>bpmn_flow_CollectionToConverge</bpmn:flowNodeRef>
    </bpmn:serviceTask>

    <!-- Parallel Gateway for Convergence -->
    <bpmn:parallelGateway id="ParallelGateway_Converge" name="">
      <bpmn:incoming>bpmn_flow_VisualToConverge</bpmn:flowNodeRef>
      <bpmn:incoming>bpmn_flow_CollectionToConverge</bpmn:flowNodeRef>
      <bpmn:outgoing>bpmn_flow_ConvergeToErrorCheck</bpmn:flowNodeRef>
    </bpmn:parallelGateway>

    <!-- Exclusive Gateway for Error Check -->
    <bpmn:exclusiveGateway id="InclusiveGateway_ErrorCheck" name="Errors detected?">
      <bpmn:incoming>bpmn_flow_ConvergeToErrorCheck</bpmn:flowNodeRef>
      <bpmn:outgoing>bpmn_flow_YesClearErrors</bpmn:flowNodeRef>
      <bpmn:outgoing>bpmn_flow_NoProceedReport</bpmn:flowNodeRef>
    </bpmn:exclusiveGateway>

    <!-- User Task for Clearing Errors -->
    <bpmn:userTask id="UserTask_ClearErrors" name="Clear error codes">
      <bpmn:incoming>bpmn_flow_YesClearErrors</bpmn:flowNodeRef>
      <bpmn:outgoing>bpmn_flow_ClearedToReportCheck</bpmn:flowNodeRef>
    </bpmn:userTask>

    <!-- Exclusive Gateway for Final Decision -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_ReportDecision" name="Proceed to report?">
      <bpmn:incoming>bpmn_flow_ClearedToReportCheck</bpmn:flowNodeRef>
      <bpmn:outgoing>bpmn_flow_ProceedFinalReport</bpmn:flowNodeRef>
    </bpmn:exclusiveGateway>

    <!-- User Task for Final Report -->
    <bpmn:userTask id="UserTask_FinalReport" name="Write final inspection report">
      <bpmn:incoming>bpmn_flow_ProceedFinalReport</bpmn:flowNodeRef>
      <bpmn:outgoing>bpmn_flow_ReportToShutdown</bpmn:flowNodeRef>
    </bpmn:userTask>

    <!-- User Task for Shutdown -->
    <bpmn:userTask id="UserTask_Shutdown" name="Shut down machine">
      <bpmn:incoming>bpmn_flow_ReportToShutdown</bpmn:flowNodeRef>
      <bpmn:outgoing>bpmn_flow_ShutdownToEnd</bpmn:flowNodeRef>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="BPMNEvent_InspectionComplete" name="Inspection completed">
      <bpmn:incoming>bpmn_flow_ShutdownToEnd</bpmn:flowNodeRef>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="bpmn_flow_StartToConfig" name="" sourceRef="StartEvent_Connected" targetRef="UserTask_Configuration"/>
    
    <bpmn:sequenceFlow id="bpmn_flow_ConfToInspectionStart" name="" sourceRef="UserTask_Configuration" targetRef="ParallelGateway_Inspection"/>
    
    <bpmn:sequenceFlow id="bpmn_flow_VisualCheck" name="" sourceRef="ParallelGateway_Inspection" targetRef="UserTask_VisualInspection"/>
    
    <bpmn:sequenceFlow id="bpmn_flow_AutoDataCollection" name="" sourceRef="ParallelGateway_Inspection" targetRef="ServiceTask_DataCollection"/>
    
    <bpmn:sequenceFlow id="bpmn_flow_CollectionToConverge" name="" sourceRef="ServiceTask_DataCollection" targetRef="ParallelGateway_Converge"/>
    
    <bpmn:sequenceFlow id="bpmn_flow_VisualToConverge" name="" sourceRef="UserTask_VisualInspection" targetRef="ParallelGateway_Converge"/>
    
    <bpmn:sequenceFlow id="bpmn_flow_ConvergeToErrorCheck" name="" sourceRef="ParallelGateway_Converge" targetRef="InclusiveGateway_ErrorCheck"/>
    
    <bpmn:sequenceFlow id="bpmn_flow_YesClearErrors" name="Yes - Errors exist" sourceRef="InclusiveGateway_ErrorCheck" targetRef="UserTask_ClearErrors">
      <bpmn:name/>
    </bpmn:sequenceFlow>
    
    <bpmn:sequenceFlow id="bpmn_flow_NoProceedReport" name="No errors found" sourceRef="InclusiveGateway_ErrorCheck" targetRef="ExclusiveGateway_ReportDecision"/>
    
    <bpmn:sequenceFlow id="bpmn_flow_ClearedToReportCheck" name="" sourceRef="UserTask_ClearErrors" targetRef="ExclusiveGateway_ReportDecision"/>
    
    <bpmn:sequenceFlow id="bpmn_flow_ProceedFinalReport" name="Proceed to report" sourceRef="ExclusiveGateway_ReportDecision" targetRef="UserTask_FinalReport">
      <bpmn:name/>
    </bpmn:sequenceFlow>
    
    <bpmn:sequenceFlow id="bpmn_flow_ReportToShutdown" name="" sourceRef="UserTask_FinalReport" targetRef="UserTask_Shutdown"/>
    
    <bpmn:sequenceFlow id="bpmn_flow_ShutdownToEnd" name="" sourceRef="UserTask_Shutdown" targetRef="BPMNEvent_InspectionComplete"/>

  </bpmn:process>

</bpmn:definitions>