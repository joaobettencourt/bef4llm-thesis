<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ChainsawProcess_v2" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Manufacturer" name="Chainsaw Manufacturer" processRef="Process_1"/>
    <bpmn:participant id="Participant_Customer" name="Customer"/>

    <!-- Message Flows -->
    <bpmn:messageFlow id="Message_Flow_Properties" sourceRef="Task_SetProperties" targetRef="Event_StartOrderRequest">
      <bpmn:name>Send Properties</bpmn:name>
    </bpmn:messageFlow>
    <bpmn:messageFlow id="Message_Flow_Update" sourceRef="Task_SendUpdate" targetRef="Participant_Customer"/>
    <bpmn:messageFlow id="Message_Flow_FirstSaw" sourceRef="Task_SendFirstSaw" targetRef="Participant_Customer"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false" name="Chainsaw Production Process">
    
    <!-- Lane Set -->
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Production" name="Production Team">
        <bpmn:flowNodeRef>Event_StartOrderRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SetProperties</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_ParallelStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Service_OrderGuideBar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Service_OrderChain</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Service_OrderMotor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Service_OrderColor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Service_OrderShield</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_ParallelEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_AllPartsReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InspectParts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssembleParts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_UpdateLoop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_TimerUpdate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendUpdate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendFirstSaw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_LikesIt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_ReceiveFeedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RequestQuantity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_ProduceRest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Service_ProduceRest1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Completed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="Event_StartOrderRequest" name="Chainsaw order request">
      <bpmn:outgoing>Sequence_Flow_StartToProperties</bpmn:flowNodeRef>
    </bpmn:startEvent>

    <!-- Task: Set Properties -->
    <bpmn:manualTask id="Task_SetProperties" name="Set properties">
      <bpmn:incoming>Sequence_Flow_StartToProperties</bpmn:flowNodeRef>
      <bpmn:outgoing>Sequence_PropertiesToParallelStart</bpmn:flowNodeRef>
    </bpmn:manualTask>

    <!-- Parallel Gateway Diverging -->
    <bpmn:parallelGateway id="Gw_ParallelStart" name="">
      <bpmn:incoming>Sequence_PropertiesToParallelStart</bpmn:flowNodeRef>
      <bpmn:outgoing>Seq_OrderGuideBar</bpmn:flowNodeRef>
      <bpmn:outgoing>Seq_OrderChain</bpmn:flowNodeRef>
      <bpmn:outgoing>Seq_OrderMotor</bpmn:flowNodeRef>
      <bpmn:outgoing>Seq_OrderColor</bpmn:flowNodeRef>
      <bpmn:outgoing>Seq_OrderShield</bpmn:flowNodeRef>
    </bpmn:parallelGateway>

    <!-- Service Tasks for Ordering Parts (Parallel) -->
    <bpmn:serviceTask id="Service_OrderGuideBar" name="Order guide bar">
      <bpmn:incoming>Seq_OrderGuideBar</bpmn:flowNodeRef>
      <bpmn:outgoing>Sequence_GuideToConverge</bpmn:flowNodeRef>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Service_OrderChain" name="Order chain">
      <bpmn:incoming>Seq_OrderChain</bpmn:flowNodeRef>
      <bpmn:outgoing>Sequence_ChainToConverge</bpmn:flowNodeRef>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Service_OrderMotor" name="Order motor">
      <bpmn:incoming>Seq_OrderMotor</bpmn:flowNodeRef>
      <bpmn:outgoing>Sequence_MotorToConverge</bpmn:flowNodeRef>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Service_OrderColor" name="Order color">
      <bpmn:incoming>Seq_OrderColor</bpmn:flowNodeRef>
      <bpmn:outgoing>Sequence_ColorToConverge</bpmn:flowNodeRef>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Service_OrderShield" name="Order protective shield">
      <bpmn:incoming>Seq_OrderShield</bpmn:flowNodeRef>
      <bpmn:outgoing>Sequence_ShieldToConverge</bpmn:flowNodeRef>
    </bpmn:serviceTask>

    <!-- Parallel Gateway Converging -->
    <bpmn:parallelGateway id="Gw_ParallelEnd" name="">
      <bpmn:incoming>Sequence_GuideToConverge</bpmn:flowNodeRef>
      <bpmn:incoming>Sequence_ChainToConverge</bpmn:flowNodeRef>
      <bpmn:incoming>Sequence_MotorToConverge</bpmn:flowNodeRef>
      <bpmn:incoming>Sequence_ColorToConverge</bpmn:flowNodeRef>
      <bpmn:incoming>Sequence_ShieldToConverge</bpmn:flowNodeRef>
      <bpmn:outgoing>Seq_ParallelEndToEvent</bpmn:flowNodeRef>
    </bpmn:parallelGateway>

    <!-- Intermediate Catch Event (Parts Arrived) -->
    <bpmn:intermediateCatchEvent id="Event_AllPartsReceived" name="All parts received">
      <bpmn:incoming>Seq_ParallelEndToEvent</bpmn:flowNodeRef>
      <bpmn:outgoing>Sequence_EventToInspect</bpmn:flowNodeRef>
    </bpmn:intermediateCatchEvent>

    <!-- Manual Task: Inspect Parts -->
    <bpmn:manualTask id="Task_InspectParts" name="Inspect parts">
      <bpmn:incoming>Sequence_EventToInspect</bpmn:flowNodeRef>
      <bpmn:outgoing>Seq_InspectToAssemble</bpmn:flowNodeRef>
    </bpmn:manualTask>

    <!-- Manual Task: Assemble Parts -->
    <bpmn:manualTask id="Task_AssembleParts" name="Assemble parts">
      <bpmn:incoming>Seq_InspectToAssemble</bpmn:flowNodeRef>
      <bpmn:outgoing>Sequence_AssemblyComplete</bpmn:flowNodeRef>
    </bpmn:manualTask>

    <!-- Update Loop Logic -->
    <bpmn:eventBasedGateway id="Gw_UpdateLoop" name="">
      <bpmn:incoming>Sequence_AssemblyComplete</bpmn:flowNodeRef>
      <bpmn:outgoing>Seq_TimerTriggeredUpdate</bpmn:flowNodeRef>
      <bpmn:outgoing>Seq_SendFirstSawPath</bpmn:flowNodeRef>
    </bpmn:eventBasedGateway>

    <!-- Timer Intermediate Event for Regular Updates -->
    <bpmn:intermediateCatchEvent id="Event_TimerUpdate" name="24 hours passed">
      <bpmn:incoming>Seq_TimerTriggeredUpdate</bpmn:flowNodeRef>
      <bpmn:outgoing>Sequence_SendUpdateTask</bpmn:flowNodeRef>
    </bpmn:intermediateCatchEvent>

    <!-- Send Update Task -->
    <bpmn:sendTask id="Task_SendUpdate" name="Send update">
      <bpmn:incoming>Sequence_SendUpdateTask</bpmn:flowNodeRef>
      <bpmn:outgoing>Seq_UpdateLoopBackToGateway</bpmn:flowNodeRef>
    </bpmn:sendTask>

    <!-- Send First Saw Task -->
    <bpmn:sendTask id="Task_SendFirstSaw" name="Send chainsaw to customer">
      <bpmn:incoming>Seq_SendFirstSawPath</bpmn:flowNodeRef>
      <bpmn:outgoing>Sequence_SentToFeedbackGateway</bpmn:flowNodeRef>
    </bpmn:sendTask>

    <!-- Receive Feedback Event -->
    <bpmn:endEvent id="EndEvent_Completed" name="Chainsaw order completed">
      <bpmn:incoming>Seq_OrderCompletedFlow</bpmn:flowNodeRef>
    </bpmn:endEvent>

    <!-- Exclusive Gateway for Customer Decision -->
    <bpmn:exclusiveGateway id="Gw_LikesIt" name="Customer likes chainsaw?">
      <bpmn:incoming>Sequence_SentToFeedbackGateway</bpmn:flowNodeRef>
      <bpmn:outgoing>Seq_YesPath</bpmn:flowNodeRef>
      <bpmn:outgoing>Seq_NoPath</bpmn:flowNodeRef>
    </bpmn:exclusiveGateway>

    <!-- Task: Request Quantity -->
    <bpmn:sendTask id="Task_RequestQuantity" name="Request number of chainsaws needed">
      <bpmn:incoming>Seq_YesPath</bpmn:flowNodeRef>
      <bpmn:outgoing>Sequence_QtyToGatewayProduce</bpmn:flowNodeRef>
    </bpmn:sendTask>

    <!-- Gateway for Production Rest -->
    <bpmn:exclusiveGateway id="Gw_ProduceRest" name="Number of chainsaws needed produced?">
      <bpmn:incoming>Sequence_QtyToGatewayProduce</bpmn:flowNodeRef>
      <bpmn:outgoing>Seq_ProdMoreFlow</bpmn:flowNodeRef>
    </bpmn:exclusiveGateway>

    <!-- Service Task for Producing Rest -->
    <bpmn:serviceTask id="Service_ProduceRest1" name="Produce remaining chainsaws">
      <bpmn:incoming>Seq_ProdMoreFlow</bpmn:flowNodeRef>
      <bpmn:outgoing>Sequence_OrderCompletedFlow</bpmn:flowNodeRef>
    </bpmn:serviceTask>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Sequence_Flow_StartToProperties" sourceRef="Event_StartOrderRequest" targetRef="Task_SetProperties"/>
    
    <bpmn:sequenceFlow id="Sequence_PropertiesToParallelStart" name="" sourceRef="Task_SetProperties" targetRef="Gw_ParallelStart"/>

    <!-- Parallel Outgoing Flows -->
    <bpmn:sequenceFlow id="Seq_OrderGuideBar" sourceRef="Gw_ParallelStart" targetRef="Service_OrderGuideBar"/>
    <bpmn:sequenceFlow id="Seq_OrderChain" sourceRef="Gw_ParallelStart" targetRef="Service_OrderChain"/>
    <bpmn:sequenceFlow id="Seq_OrderMotor" sourceRef="Gw_ParallelStart" targetRef="Service_OrderMotor"/>
    <bpmn:sequenceFlow id="Seq_OrderColor" sourceRef="Gw_ParallelStart" targetRef="Service_OrderColor"/>
    <bpmn:sequenceFlow id="Seq_OrderShield" sourceRef="Gw_ParallelStart" targetRef="Service_OrderShield"/>

    <!-- Parallel Incoming Flows -->
    <bpmn:sequenceFlow id="Sequence_GuideToConverge" name="" sourceRef="Service_OrderGuideBar" targetRef="Gw_ParallelEnd"/>
    <bpmn:sequenceFlow id="Sequence_ChainToConverge" name="" sourceRef="Service_OrderChain" targetRef="Gw_ParallelEnd"/>
    <bpmn:sequenceFlow id="Sequence_MotorToConverge" name="" sourceRef="Service_OrderMotor" targetRef="Gw_ParallelEnd"/>
    <bpmn:sequenceFlow id="Sequence_ColorToConverge" name="" sourceRef="Service_OrderColor" targetRef="Gw_ParallelEnd"/>
    <bpmn:sequenceFlow id="Sequence_ShieldToConverge" name="" sourceRef="Service_OrderShield" targetRef="Gw_ParallelEnd"/>

    <!-- Post-Parallel Flow -->
    <bpmn:sequenceFlow id="Seq_ParallelEndToEvent" sourceRef="Gw_ParallelEnd" targetRef="Event_AllPartsReceived"/>
    
    <bpmn:sequenceFlow id="Sequence_EventToInspect" name="" sourceRef="Event_AllPartsReceived" targetRef="Task_InspectParts"/>
    <bpmn:sequenceFlow id="Seq_InspectToAssemble" name="" sourceRef="Task_InspectParts" targetRef="Task_AssembleParts"/>

    <!-- Update Loop Flows -->
    <bpmn:sequenceFlow id="Sequence_AssemblyComplete" sourceRef="Task_AssembleParts" targetRef="Gw_UpdateLoop"/>
    
    <bpmn:sequenceFlow id="Seq_TimerTriggeredUpdate" name="" sourceRef="Gw_UpdateLoop" targetRef="Event_TimerUpdate">
      <bpmn:name>Regular Update</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Sequence_SendUpdateTask" sourceRef="Event_TimerUpdate" targetRef="Task_SendUpdate"/>
    
    <!-- Loop Back for Updates -->
    <bpmn:sequenceFlow id="Seq_UpdateLoopBackToGateway" name="" sourceRef="Task_SendUpdate" targetRef="Gw_UpdateLoop">
      <bpmn:name>Continue Production</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- First Saw Flow -->
    <bpmn:sequenceFlow id="Seq_SendFirstSawPath" name="" sourceRef="Gw_UpdateLoop" targetRef="Task_SendFirstSaw">
      <bpmn:name>Sent to Customer</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Feedback Flow -->
    <bpmn:sequenceFlow id="Sequence_SentToFeedbackGateway" sourceRef="Task_SendFirstSaw" targetRef="Gw_LikesIt"/>

    <!-- Decision Flows -->
    <bpmn:sequenceFlow id="Seq_YesPath" name="yes" sourceRef="Gw_LikesIt" targetRef="Task_RequestQuantity">
      <bpmn:name>Customer likes it</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- No Path (Loop back to start or cancel - modeled as loop for simplicity based on description logic) -->
    <bpmn:sequenceFlow id="Seq_NoPath" name="no" sourceRef="Gw_LikesIt" targetRef="Event_StartOrderRequest">
      <bpmn:name>Re-order</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Production Rest Flow -->
    <bpmn:sequenceFlow id="Sequence_QtyToGatewayProduce" sourceRef="Task_RequestQuantity" targetRef="Gw_ProduceRest"/>
    
    <bpmn:sequenceFlow id="Seq_ProdMoreFlow" name="" sourceRef="Gw_ProduceRest" targetRef="Service_ProduceRest1">
      <bpmn:name>Produce Rest</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- End Flow -->
    <bpmn:sequenceFlow id="Sequence_OrderCompletedFlow" sourceRef="Service_ProduceRest1" targetRef="EndEvent_Completed"/>

  </bpmn:process>
</bpmn:definitions>