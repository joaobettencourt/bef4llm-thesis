<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_DispatchGoods">
    <bpmn:participant id="Participant_DispatchGoods" name="Dispatch of goods - Computer Hardware Shop" processRef="Process_DispatchGoods"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_DispatchGoods" isExecutable="false">
    
    <!-- Lane Set -->
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Secretary" name="Secretary">
        <bpmn:flowNodeRef>StartEvent_ShipeGoods</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ClarifyShipmentMethod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SpecialHandling</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_NormalShipping</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Get3Offers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectLogisticCompany</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_MergeShippingPaths</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Logistics" name="Logistics">
        <bpmn:flowNodeRef>Task_InsureParcel</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Warehouse" name="Warehouse">
        <bpmn:flowNodeRef>Task_PackageGoods</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AllReadyForPickup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareForPickUp</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_ShipeGoods" name="Ship goods">
      <bpmn:outgoing>SequenceFlow_StartToParallel</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Parallel Gateway - Split into two paths (shipping arrangement and packaging) -->
    <bpmn:parallelGateway id="ParallelGateway_StartSplit">
      <bpmn:incoming>SequenceFlow_StartToParallel</bpmn:incoming/>
      <bpmn:outgoing>SequenceFlow_SecretaryPath</bpmn:outgoing/>
      <bpmn:outgoing>SequenceFlow_WarehousePath</bpmn:outgoing/>
    </bpmn:parallelGateway>

    <!-- Secretary Lane Tasks -->
    <bpmn:task id="Task_ClarifyShipmentMethod" name="Clarify shipment method">
      <bpmn:incoming>SequenceFlow_SecretaryPath</bpmn:incoming/>
      <bpmn:outgoing>SequenceFlow_ToSpecialHandlingGateway</bpmn:outgoing/>
    </bpmn:task>

    <!-- Exclusive Gateway - Special handling decision -->
    <bpmn:exclusiveGateway id="Gateway_SpecialHandling" name="Special sandling?">
      <bpmn:incoming>SequenceFlow_ToSpecialHandlingGateway</bpmn:incoming/>
      <bpmn:outgoing>SequenceFlow_NoSpecialHandling</bpmn:outgoing/>
      <bpmn:outgoing>SequenceFlow_YesSpecialHandling</bpmn:outgoing/>
    </bpmn:exclusiveGateway>

    <!-- Normal Shipping Path (Small amounts) -->
    <bpmn:inclusiveGateway id="InclusiveGateway_NormalShipping">
      <bpmn:incoming>SequenceFlow_NoSpecialHandling</bpmn:incoming/>
      <bpmn:outgoing>SequenceFlow_WritePackageLabel</bpmn:outgoing/>
      <bpmn:outgoing>SequenceFlow_InsureParcelIfNecessary</bpmn:outgoing/>
    </bpmn:inclusiveGateway>

    <!-- Task - Write package label -->
    <bpmn:task id="Task_WritePackageLabel" name="Write package label">
      <bpmn:incoming>SequenceFlow_WritePackageLabel</bpmn:incoming/>
      <bpmn:outgoing>SequenceFlow_ToMergeShippingPaths</bpmn:outgoing/>
    </bpmn:task>

    <!-- Task - Insure parcel if necessary -->
    <bpmn:task id="Task_InsureParcel" name="Insure parcel">
      <bpmn:incoming>SequenceFlow_InsureParcelIfNecessary</bpmn:incoming/>
      <bpmn:outgoing>SequenceFlow_ToMergeShippingPaths2</bpmn:outgoing/>
    </bpmn:task>

    <!-- Special Shipping Path (Large amounts) -->
    <bpmn:task id="Task_Get3Offers" name="Get 3 offers from logistic companies">
      <bpmn:incoming>SequenceFlow_YesSpecialHandling</bpmn:incoming/>
      <bpmn:outgoing>SequenceFlow_ToSelectCompany</bpmn:outgoing/>
    </bpmn:task>

    <!-- Task - Select logistic company and place order -->
    <bpmn:task id="Task_SelectLogisticCompany" name="Select logistic company and place order">
      <bpmn:incoming>SequenceFlow_ToSelectCompany</bpmn:incoming/>
      <bpmn:outgoing>SequenceFlow_SpecialShippingToMergeGateway</bpmn:outgoing/>
    </bpmn:task>

    <!-- Inclusive Gateway - Merge shipping paths -->
    <bpmn:inclusiveGateway id="InclusiveGateway_MergeShippingPaths">
      <bpmn:incoming>SequenceFlow_ToMergeShippingPaths</bpmn:incoming/>
      <bpmn:incoming>SequenceFlow_SpecialShippingToMergeGateway</bpmn:inoming/>
    </bpmn:inclusiveGateway>

    <!-- Warehouse Lane Tasks -->
    <bpmn:task id="Task_PackageGoods" name="Package goods">
      <bpmn:incoming>SequenceFlow_WarehousePath</bpmn:incoming/>
      <bpmn:outgoing>SequenceFlow_ToAllReadyGateway</bpmn:outgoing/>
    </bpmn:task>

    <!-- Exclusive Gateway - Check if everything is ready -->
    <bpmn:exclusiveGateway id="Gateway_AllReadyForPickup">
      <bpmn:incoming>SequenceFlow_MergedPathToEndCheck</bpmn:inoming/>
      <bpmn:incoming>SequenceFlow_ToAllReadyGateway</bpmn:inoming/>
      <bpmn:outgoing>SequenceFlow_PrepareForPickup</bpmn:outgoing/>
    </bpmn:exclusiveGateway>

    <!-- Task - Prepare for pickup -->
    <bpmn:task id="Task_PrepareForPickUp" name="Prepare for picking up goods">
      <bpmn:incoming>SequenceFlow_PrepareForPickup</bpmn:inoming/>
      <bpmn:outgoing>SequenceFlow_ToEndEvent</bpmn:outgoing/>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_ShipmentPrepared" name="Shipment prepared">
      <bpmn:incoming>SequenceFlow_ToEndEvent</bpmn:inoming/>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToParallel" sourceRef="StartEvent_ShipeGoods" targetRef="ParallelGateway_StartSplit"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_SecretaryPath" name="" sourceRef="ParallelGateway_StartSplit" targetRef="Task_ClarifyShipmentMethod"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_WarehousePath" name="" sourceRef="ParallelGateway_StartSplit" targetRef="Task_PackageGoods"/>

    <bpmn:sequenceFlow id="SequenceFlow_ToSpecialHandlingGateway" sourceRef="Task_ClarifyShipmentMethod" targetRef="Gateway_SpecialHandling"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_NoSpecialHandling" name="no (small amounts)" sourceRef="Gateway_SpecialHandling" targetRef="InclusiveGateway_NormalShipping"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_YesSpecialHandling" name="yes (large amounts)" sourceRef="Gateway_SpecialHandling" targetRef="Task_Get3Offers"/>

    <bpmn:sequenceFlow id="SequenceFlow_WritePackageLabel" name="" sourceRef="InclusiveGateway_NormalShipping" targetRef="Task_WritePackageLabel"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_InsureParcelIfNecessary" name="if necessary" sourceRef="InclusiveGateway_NormalShipping" targetRef="Task_InsureParcel"/>

    <bpmn:sequenceFlow id="SequenceFlow_ToMergeShippingPaths" sourceRef="Task_WritePackageLabel" targetRef="InclusiveGateway_MergeShippingPaths"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_SpecialShippingToMergeGateway" name="" sourceRef="Task_SelectLogisticCompany" targetRef="InclusiveGateway_MergeShippingPaths"/>

    <bpmn:sequenceFlow id="SequenceFlow_ToSelectCompany" sourceRef="Task_Get3Offers" targetRef="Task_SelectLogisticCompany"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ToAllReadyGateway" name="" sourceRef="Task_PackageGoods" targetRef="Gateway_AllReadyForPickup"/>

    <bpmn:sequenceFlow id="SequenceFlow_MergedPathToEndCheck" sourceRef="InclusiveGateway_MergeShippingPaths" targetRef="Gateway_AllReadyForPickup"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_PrepareForPickup" name="" sourceRef="Gateway_AllReadyForPickup" targetRef="Task_PrepareForPickUp"/>

    <bpmn:sequenceFlow id="SequenceFlow_ToEndEvent" sourceRef="Task_PrepareForPickUp" targetRef="EndEvent_ShipmentPrepared"/>
  </bpmn:process>
</bpmn:definitions>