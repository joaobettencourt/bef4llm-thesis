<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_Regressnahme">
    <bpmn:participant id="Participant_Sachbearbeiter" name="Regressnahme Sachbearbeiter" processRef="Process_Regress"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Regress" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="Start_Event_1" name="Regressverdacht gemeldet">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_StartToCheck</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Check Case -->
    <bpmn:task id="Task_CheckCase" name="Fall prüfen">
      <bpmn:incoming>SequenceFlow_StartToCheck</bpmn:incoming/>
      <bpmn:outgoing>SequenceFlow_CheckToGateway1</bpmn:outgoing/>
    </bpmn:task>

    <!-- Gateway 1: Is Regressive Possible? -->
    <bpmn:exclusiveGateway id="Gateway_1" name="Regress möglich?">
      <bpmn:incoming>SequenceFlow_CheckToGateway1</bpmn:incoming/>
      <bpmn:outgoing>SequenceFlow_GatewayYesToPaymentRequest</bpmn:outgoing/>
      <bpmn:outgoing>SequenceFlow_GatewayNoToEndClose</bpmn:outgoing/>
    </bpmn:exclusiveGateway>

    <!-- Path YES -->
    <bpmn:task id="Task_SendPaymentRequest" name="Zahlungsaufforderung an VN schicken">
      <bpmn:incoming>SequenceFlow_GatewayYesToPaymentRequest</bpmn:incoming/>
      <bpmn:outgoing>SequenceFlow_PaymentReqToFollowUp</bpmn:outgoing/>
    </bpmn:task>

    <!-- Path NO -->
    <bpmn:endEvent id="End_CloseProcess" name="Vorgang geschlossen">
      <bpmn:incoming>SequenceFlow_GatewayNoToEndClose</bpmn:incoming/>
    </bpmn:endEvent>

    <!-- Task: Set Follow-up -->
    <bpmn:task id="Task_SetFollowUp" name="Vorgang auf Wiedervorlage setzen">
      <bpmn:incoming>SequenceFlow_PaymentReqToFollowUp</bpmn:incoming/>
      <bpmn:outgoing>SequenceFlow_FollowUpToEventGateway</bpmn:outgoing/>
    </bpmn:task>

    <!-- Event-Based Gateway -->
    <bpmn:eventBasedGateway id="Gateway_Event" name="">
      <bpmn:incoming>SequenceFlow_FollowUpToEventGateway</bpmn:incoming/>
      <bpmn:outgoing>SequenceFlow_EventHandlerMoneyReceived</bpmn:outgoing/>
      <bpmn:outgoing>SequenceFlow_HandlerObjection</bpmn:outgoing/>
      <bpmn:outgoing>SequenceFlow_HandlerDeadlineReached</bpmn:outgoing/>
    </bpmn:eventBasedGateway>

    <!-- Path 1: Money Received -->
    <bpmn:intermediateCatchEvent id="Event_MoneyReceived" name="Geld eingegangen">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SequenceFlow_EventHandlerMoneyReceived</bpmn:incoming/>
      <bpmn:outgoing>SequenceFlow_MoneyToBookReceipt</bpmn:outgoing/>
    </bpmn:intermediateCatchEvent>

    <!-- Task: Book Receipt -->
    <bpmn:task id="Task_BookReceipt" name="Geldeingang verbuchen">
      <bpmn:incoming>SequenceFlow_MoneyToBookReceipt</bpmn:incoming/>
      <bpmn:outgoing>SequenceFlow_ReceiptToEndClose2</bpmn:outgoing/>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="End_CloseProcess_1" name="Vorgang geschlossen">
      <bpmn:incoming>SequenceFlow_ReceiptToEndClose2</bpmn:incoming/>
    </bpmn:endEvent>

    <!-- Path 2: Objection Received -->
    <bpmn:intermediateCatchEvent id="Event_ObjectionReceived" name="Widerspruch erhalten">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SequenceFlow_HandlerObjection</bpmn:incoming/>
      <bpmn:outgoing>SequenceFlow_ObjectionToCheckObjection</bpmn:outgoing/>
    </bpmn:intermediateCatchEvent>

    <!-- Task: Check Objection -->
    <bpmn:task id="Task_CheckObjection" name="Widerspruch prüfen">
      <bpmn:incoming>SequenceFlow_ObjectionToCheckObjection</bpmn:incoming/>
      <bpmn:outgoing>SequenceFlow_CheckObjToGateway2</bpmn:outgoing/>
    </bpmn:task>

    <!-- Gateway 2: Is Objection Justified? -->
    <bpmn:exclusiveGateway id="Gateway_2" name="Gerechtfertigt?">
      <bpmn:incoming>SequenceFlow_CheckObjToGateway2</bpmn:incoming/>
      <bpmn:outgoing>SequenceFlow_GatewayYesToEndClose3</bpmn:outgoing/>
      <bpmn:outgoing>SequenceFlow_GatewayNoToCollectionAgency</bpmn:outgoing/>
    </bpmn:exclusiveGateway>

    <!-- Path 2 YES -->
    <bpmn:endEvent id="End_CloseProcess_2" name="Vorgang geschlossen">
      <bpmn:incoming>SequenceFlow_GatewayYesToEndClose3</bpmn:incoming/>
    </bpmn:endEvent>

    <!-- Path 2 NO & Path 3 -->
    <bpmn:task id="Task_CollectionAgency" name="Vorgang an Inkasso-Dienstleister geben">
      <bpmn:incoming>SequenceFlow_GatewayNoToCollectionAgency</bpmn:incoming/>
      <bpmn:outgoing>SequenceFlow_CollecToEndOpen</bpmn:outgoing/>
    </bpmn:task>

    <!-- Path 3: Deadline Reached -->
    <bpmn:intermediateCatchEvent id="Event_DeadlineReached" name="Wiedervorlage fällig">
      <bpmn:timerEventDefinition/>
      <bpmn:incoming>SequenceFlow_HandlerDeadlineReached</bpmn:incoming/>
      <bpmn:outgoing>SequenceFlow_DealineToCollectionAgency</bpmn:outgoing/>
    </bpmn:intermediateCatchEvent>

    <!-- End Event -->
    <bpmn:endEvent id="End_OpenProcess" name="Vorgang offen">
      <bpmn:incoming>SequenceFlow_CollecToEndOpen</bpmn:incoming/>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToCheck" sourceRef="Start_Event_1" targetRef="Task_CheckCase"/>
    <bpmn:sequenceFlow id="SequenceFlow_CheckToGateway1" sourceRef="Task_CheckCase" targetRef="Gateway_1"/>
    
    <!-- Gateway 1 -->
    <bpmn:sequenceFlow id="SequenceFlow_GatewayYesToPaymentRequest" name="Ja" sourceRef="Gateway_1" targetRef="Task_SendPaymentRequest"/>
    <bpmn:sequenceFlow id="SequenceFlow_GatewayNoToEndClose" name="Nein" sourceRef="Gateway_1" targetRef="End_CloseProcess"/>

    <!-- Follow-up -->
    <bpmn:sequenceFlow id="SequenceFlow_PaymentReqToFollowUp" sourceRef="Task_SendPaymentRequest" targetRef="Task_SetFollowUp"/>
    
    <!-- Event Gateway paths -->
    <bpmn:sequenceFlow id="SequenceFlow_FollowUpToEventGateway" sourceRef="Task_SetFollowUp" targetRef="Gateway_Event"/>
    <bpmn:sequenceFlow id="SequenceFlow_EventHandlerMoneyReceived" sourceRef="Gateway_Event" targetRef="Event_MoneyReceived"/>
    <bpmn:sequenceFlow id="SequenceFlow_HandlerObjection" sourceRef="Gateway_Event" targetRef="Event_ObjectionReceived"/>
    <bpmn:sequenceFlow id="SequenceFlow_HandlerDeadlineReached" sourceRef="Gateway_Event" targetRef="Event_DeadlineReached"/>

    <!-- Money Received path -->
    <bpmn:sequenceFlow id="SequenceFlow_MoneyToBookReceipt" sourceRef="Event_MoneyReceived" targetRef="Task_BookReceipt"/>
    
    <!-- Objection path -->
    <bpmn:sequenceFlow id="SequenceFlow_ObjectionToCheckObjection" sourceRef="Event_ObjectionReceived" targetRef="Task_CheckObjection"/>

    <!-- Gateway 2 paths -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckObjToGateway2" sourceRef="Task_CheckObjection" targetRef="Gateway_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_GatewayYesToEndClose3" name="Ja" sourceRef="Gateway_2" targetRef="End_CloseProcess_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_GatewayNoToCollectionAgency" name="Nein" sourceRef="Gateway_2" targetRef="Task_CollectionAgency"/>

    <!-- Deadline path -->
    <bpmn:sequenceFlow id="SequenceFlow_DealineToCollectionAgency" sourceRef="Event_DeadlineReached" targetRef="Task_CollectionAgency"/>

  </bpmn:process>
</bpmn:definitions>