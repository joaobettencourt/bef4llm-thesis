<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_FaultResolution">
    <bpmn:participant id="Participant_UserProcess" name="Fault Detection and Resolution Process" processRef="Process_FaultResolution"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_FaultResolution" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_FaultDetected" name="Fault Detected or User Suspicion">
      <bpmn:outgoing>SFlow_ExamineFailure</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Examine Failure -->
    <bpmn:task id="Task_ExamineFailure" name="Examine the failure">
      <bpmn:incoming>SFlow_ExamineFailure</bpmn:incoming>
      <bpmn:outgoing>SFlow_DecideConfirmation</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway -->
    <bpmn:exclusiveGateway id="Gateway_ConfirmReject" name="Confirm failure?">
      <bpmn:incoming>SFlow_DecideConfirmation</bpmn:incoming>
      <bpmn:outgoing>SFlow_RejectPath</bpmn:outgoing>
      <bpmn:outgoing>SFlow_ConfirmPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 2: Reject Failure -->
    <bpmn:task id="Task_RejectFailure" name="Reject failure report">
      <bpmn:incoming>SFlow_RejectPath</bpmn:incoming>
      <bpmn:outgoing>SFlow_EndRejected</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event for Rejected Path -->
    <bpmn:endEvent id="EndEvent_Resolved" name="Process Resolved">
      <bpmn:incoming>SFlow_EndConfirmed</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task 3: Inform Customer about Failure (Confirm Path) -->
    <bpmn:task id="Task_InformCustomerFailure" name="Inform customer of failure">
      <bpmn:incoming>SFlow_ConfirmPath</bpmn:incoming>
      <bpmn:outgoing>SFlow_InformManagerFailure</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 4: Inform Manager about Failure (Confirm Path) -->
    <bpmn:task id="Task_InformManagerFailure" name="Inform manager of failure">
      <bpmn:incoming>SFlow_InformManagerFailure</bpmn:incoming>
      <bpmn:outgoing>SFlow_FixFault</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 5: Fix Fault at Measuring Device -->
    <bpmn:task id="Task_FixFault" name="Fix fault at measuring device">
      <bpmn:incoming>SFlow_FixFault</bpmn:incoming>
      <bpmn:outgoing>SFlow_ShareResultsDetector</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 6: Share Results with Fault Detector -->
    <bpmn:task id="Task_ShareResults" name="Share repair results with fault detector">
      <bpmn:incoming>SFlow_ShareResultsDetector</bpmn:incoming>
      <bpmn:outgoing>SFlow_InformCustomerResolution</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 7: Inform Customer about Resolution -->
    <bpmn:task id="Task_InformCustomerResolution" name="Inform customer of resolution">
      <bpmn:incoming>SFlow_InformCustomerResolution</bpmn:incoming>
      <bpmn:outgoing>SFlow_InformManagerResolution</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 8: Inform Manager about Resolution -->
    <bpmn:task id="Task_InformManagerResolution" name="Inform manager of resolution">
      <bpmn:incoming>SFlow_InformManagerResolution</bpmn:incoming>
      <bpmn:outgoing>SFlow_EndConfirmed</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event for Confirmed Path -->
    <bpmn:endEvent id="EndEvent_Rejected" name="Failure Rejected">
      <bpmn:incoming>SFlow_EndRejected</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SFlow_ExamineFailure" sourceRef="StartEvent_FaultDetected" targetRef="Task_ExamineFailure"/>
    
    <bpmn:sequenceFlow id="SFlow_DecideConfirmation" name="" sourceRef="Task_ExamineFailure" targetRef="Gateway_ConfirmReject"/>
    
    <!-- Reject Path -->
    <bpmn:sequenceFlow id="SFlow_RejectPath" name="No, reject failure" sourceRef="Gateway_ConfirmReject" targetRef="Task_RejectFailure">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${reject}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Confirm Path -->
    <bpmn:sequenceFlow id="SFlow_ConfirmPath" name="Yes, confirm failure" sourceRef="Gateway_ConfirmReject" targetRef="Task_InformCustomerFailure">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${confirm}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Confirm Path Sequence Flows -->
    <bpmn:sequenceFlow id="SFlow_InformManagerFailure" sourceRef="Task_InformCustomerFailure" targetRef="Task_InformManagerFailure"/>
    
    <bpmn:sequenceFlow id="SFlow_FixFault" sourceRef="Task_InformManagerFailure" targetRef="Task_FixFault"/>
    
    <bpmn:sequenceFlow id="SFlow_ShareResultsDetector" sourceRef="Task_FixFault" targetRef="Task_ShareResults"/>
    
    <bpmn:sequenceFlow id="SFlow_InformCustomerResolution" sourceRef="Task_ShareResults" targetRef="Task_InformCustomerResolution"/>
    
    <bpmn:sequenceFlow id="SFlow_InformManagerResolution" sourceRef="Task_InformCustomerResolution" targetRef="Task_InformManagerResolution"/>

    <!-- End Sequence Flows -->
    <bpmn:sequenceFlow id="SFlow_EndRejected" name="" sourceRef="Task_RejectFailure" targetRef="EndEvent_Rejected"/>
    
    <bpmn:sequenceFlow id="SFlow_EndConfirmed" name="" sourceRef="Task_InformManagerResolution" targetRef="EndEvent_Resolved"/>

  </bpmn:process>
</bpmn:definitions>