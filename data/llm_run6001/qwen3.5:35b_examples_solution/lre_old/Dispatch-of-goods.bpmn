<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Dispatch of goods Computer Hardware Shop" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Logistics" name="Logistics">
        <bpmn:flowNodeRef>Task_InsureParcel</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Secretary" name="Secretary">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tsk_ClarifyShipmentMethod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_SpecialHandling</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tsk_Get3Offers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tsk_SelectLogisticCompany</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_MergeAfterSpecialShipping</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tsk_WritePackageLabel</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Warehouse" name="Warehouse">
        <bpmn:flowNodeRef>Gw_ParallelStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tsk_PackageGoods</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Ship goods">
      <bpmn:outgoing>SFlow_StartToParallel</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Parallel Gateway to split paths (Secretary and Warehouse) -->
    <bpmn:parallelGateway id="Gw_ParallelStart" name="">
      <bpmn:incoming>SFlow_StartToParallel</bpmn:incoming>
      <bpmn:outgoing>SFlow_ToClarifyShipmentMethod</bpmn:outgoing>
      <bpmn:outgoing>SFlow_ToPackageGoods</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Clarify shipment method (Secretary) -->
    <bpmn:task id="Tsk_ClarifyShipmentMethod" name="Clarify shipment method">
      <bpmn:incoming>SFlow_ToClarifyShipmentMethod</bpmn:incoming>
      <bpmn:outgoing>SFlow_ToSpecialHandlingGateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway for Special Handling decision -->
    <bpmn:exclusiveGateway id="Gw_SpecialHandling" name="Large amounts?">
      <bpmn:incoming>SFlow_ToSpecialHandlingGateway</bpmn:incoming>
      <bpmn:outgoing>SFlow_YesToGetOffers</bpmn:outgoing>
      <bpmn:outgoing>SFlow_NoToInclusiveGateway</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Get 3 offers from logistic companies (Secretary) -->
    <bpmn:task id="Tsk_Get3Offers" name="Get 3 offers from logistic companies">
      <bpmn:incoming>SFlow_YesToGetOffers</bpmn:incoming>
      <bpmn:outgoing>SFlow_ToSelectCompany</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Select logistic company and place order (Secretary) -->
    <bpmn:task id="Tsk_SelectLogisticCompany" name="Select logistic company and place order">
      <bpmn:incoming>SFlow_ToSelectCompany</bpmn:incoming>
      <bpmn:outgoing>SFlow_ToMergeAfterSpecialShipping</bpmn:outgoing>
    </bpmn:task>

    <!-- Inclusive Gateway for small amounts path (Write label + Insure if necessary) -->
    <bpmn:inclusiveGateway id="InclusiveGateway_1" name="">
      <bpmn:incoming>SFlow_NoToInclusiveGateway</bpmn:incoming>
      <bpmn:outgoing>SFlow_ToWritePackageLabel</bpmn:outgoing>
      <bpmn:outgoing>SFlow_ToInsureParcel</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Task: Write package label (Secretary) -->
    <bpmn:task id="Tsk_WritePackageLabel" name="Write package label">
      <bpmn:incoming>SFlow_ToWritePackageLabel</bpmn:incoming>
      <bpmn:outgoing>SFlow_ToMergeAfterSpecialShipping2</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Insure parcel (Logistics) -->
    <bpmn:task id="Task_InsureParcel" name="Take parcel insurance">
      <bpmn:incoming>SFlow_ToInsureParcel</bpmn:incoming>
      <bpmn:outgoing>SFlow_ToMergeAfterSpecialShipping2</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway to merge paths -->
    <bpmn:exclusiveGateway id="Gw_MergeAfterSpecialShipping" name="">
      <bpmn:incoming>SFlow_ToMergeAfterSpecialShipping</bpmn:incoming>
      <bpmn:outgoing>SFlow_ToFinalExclusiveGateway</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Exclusive Gateway to merge all paths before final preparation -->
    <bpmn:exclusiveGateway id="Gw_MergeAllPaths" name="">
      <bpmn:incoming>SFlow_ToMergeAfterSpecialShipping2</bpmn:incoming>
      <bpmn:outgoing>SFlow_ToFinalExclusiveGateway</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Package goods (Warehouse) -->
    <bpmn:task id="Tsk_PackageGoods" name="Package goods">
      <bpmn:incoming>SFlow_ToPackageGoods</bpmn:incoming>
      <bpmn:outgoing>SFlow_ToFinalExclusiveGateway2</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway to merge all paths -->
    <bpmn:exclusiveGateway id="Gw_FinalMerge" name="">
      <bpmn:incoming>SFlow_ToFinalExclusiveGateway</bpmn:incoming>
      <bpmn:outgoing>SFlow_PrepareForPickup</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Prepare for picking up goods -->
    <bpmn:task id="Tsk_PrepareForPickup" name="Prepare for picking up goods">
      <bpmn:incoming>SFlow_ToFinalExclusiveGateway2</bpmn:incoming>
      <bpmn:outgoing>SFlow_EndEvent</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_1" name="Shipment prepared">
      <bpmn:incoming>SFlow_PrepareForPickup</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SFlow_StartToParallel" sourceRef="StartEvent_1" targetRef="Gw_ParallelStart"/>
    <bpmn:sequenceFlow id="SFlow_ToClarifyShipmentMethod" name="" sourceRef="Gw_ParallelStart" targetRef="Tsk_ClarifyShipmentMethod"/>
    <bpmn:sequenceFlow id="SFlow_ToPackageGoods" name="" sourceRef="Gw_ParallelStart" targetRef="Tsk_PackageGoods"/>
    <bpmn:sequenceFlow id="SFlow_ToSpecialHandlingGateway" name="" sourceRef="Tsk_ClarifyShipmentMethod" targetRef="Gw_SpecialHandling"/>
    <bpmn:sequenceFlow id="SFlow_YesToGetOffers" name="Large amounts (yes)" sourceRef="Gw_SpecialHandling" targetRef="Tsk_Get3Offers"/>
    <bpmn:sequenceFlow id="SFlow_NoToInclusiveGateway" name="Small amounts (no)" sourceRef="Gw_SpecialHandling" targetRef="InclusiveGateway_1"/>
    <bpmn:sequenceFlow id="SFlow_ToSelectCompany" name="" sourceRef="Tsk_Get3Offers" targetRef="Tsk_SelectLogisticCompany"/>
    <bpmn:sequenceFlow id="SFlow_ToMergeAfterSpecialShipping" name="" sourceRef="Tsk_SelectLogisticCompany" targetRef="Gw_MergeAfterSpecialShipping"/>
    <bpmn:sequenceFlow id="SFlow_ToWritePackageLabel" name="" sourceRef="InclusiveGateway_1" targetRef="Tsk_WritePackageLabel"/>
    <bpmn:sequenceFlow id="SFlow_ToInsureParcel" name="If necessary" sourceRef="InclusiveGateway_1" targetRef="Task_InsureParcel"/>
    <bpmn:sequenceFlow id="SFlow_ToMergeAfterSpecialShipping2" name="" sourceRef="Tsk_WritePackageLabel" targetRef="Gw_MergeAllPaths"/>
    <bpmn:sequenceFlow id="SFlow_ToFinalExclusiveGateway" name="" sourceRef="Task_InsureParcel" targetRef="Gw_FinalMerge"/>
    <bpmn:sequenceFlow id="SFlow_ToFinalExclusiveGateway2" name="" sourceRef="Tsk_PackageGoods" targetRef="Gw_MergeAllPaths"/>
    <bpmn:sequenceFlow id="SFlow_PrepareForPickup" name="" sourceRef="Gw_FinalMerge" targetRef="EndEvent_1"/>

  </bpmn:process>
</bpmn:definitions>