<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_DismissalProcess">
    <bpmn:participant id="Participant_MPON" name="MPON" processRef="Process_MPON"/>
    <bpmn:participant id="Participant_MPOO" name="MPOO" processRef="Process_MPOO"/>
    <bpmn:messageFlow id="MessageFlow_DismissalSend" sourceRef="IntermediateThrowEvent_SendDismissal" targetRef="StartMessage_ReceiveDismissal">
      <bpmn:sourceRef>Participant_MPON</bpmn:sourceRef>
      <bpmn:targetRef>Participant_MPOO</bpmn:targetRef>
    </bpmn:messageFlow>
  </bpmn:collaboration>

  <!-- MPON Process -->
  <bpmn:process id="Process_MPON" isExecutable="false">
    <bpmn:startEvent id="Start_None_MPON" name="Initiate Dismissal">
      <bpmn:outgoing>SFlow_StartToTask_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_ConductDismissal_MPON" name="Conduct dismissal process">
      <bpmn:incoming>SFlow_StartToTask_1</bpmn:incoming>
      <bpmn:outgoing>SFlow_TaskToThrow_2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="End_None_MPON" name="Dismissal Process Complete">
      <bpmn:incoming>SFlow_EndFromThrow_3</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:intermediateThrowEvent id="IntermediateThrowEvent_SendDismissal" name="Send Dismissal to MPOO">
      <bpmn:incoming>SFlow_TaskToThrow_2</bpmn:incoming>
      <bpmn:outgoing>SFlow_EndFromThrow_3</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <bpmn:sequenceFlow id="SFlow_StartToTask_1" sourceRef="Start_None_MPON" targetRef="Task_ConductDismissal_MPON"/>
    <bpmn:sequenceFlow id="SFlow_TaskToThrow_2" sourceRef="Task_ConductDismissal_MPON" targetRef="IntermediateThrowEvent_SendDismissal"/>
    <bpmn:sequenceFlow id="SFlow_EndFromThrow_3" sourceRef="IntermediateThrowEvent_SendDismissal" targetRef="End_None_MPON"/>

  </bpmn:process>

  <!-- MPOO Process -->
  <bpmn:process id="Process_MPOO" isExecutable="false">
    <bpmn:startEvent id="StartMessage_ReceiveDismissal" name="Receive Dismissal Notification">
      <bpmn:outgoing>SFlow_StartToReview_4</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:endEvent id="End_Oppose_MPOO" name="Dismissal Opposed">
      <bpmn:incoming>SFlow_EndFromOppose_7</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="End_Confirm_MPOO" name="Dismissal Confirmed">
      <bpmn:incoming>SFlow_EndFromConfirm_8</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:exclusiveGateway id="Exclusive_Gateway_Decision" name="Decision on Dismissal">
      <bpmn:incoming>SFlow_ToGateway_5</bpmn:incoming>
      <bpmn:outgoing>SFlow_OpposePath_6</bpmn:outgoing>
      <bpmn:outgoing>SFlow_ConfirmPath_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_ReviewDismissal_MPOO" name="Review dismissal of MPON">
      <bpmn:incoming>SFlow_StartToReview_4</bpmn:incoming>
      <bpmn:outgoing>SFlow_ToGateway_5</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_OpposeDismissal_MPOO" name="Oppose the dismissal of MPON">
      <bpmn:incoming>SFlow_OpposePath_6</bpmn:incoming>
      <bpmn:outgoing>SFlow_EndFromOppose_7</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_ConfirmDismissal_MPOO" name="Confirm the dismissal of MPON">
      <bpmn:incoming>SFlow_ConfirmPath_7</bpmn:incoming>
      <bpmn:outgoing>SFlow_EndFromConfirm_8</bpmn:outgoing>
    </bpmn:task>

    <bpmn:message id="Message_Dismissal" name="Dismissal Notification"/>

    <bpmn:sequenceFlow id="SFlow_StartToReview_4" sourceRef="StartMessage_ReceiveDismissal" targetRef="Task_ReviewDismissal_MPOO">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SFlow_ToGateway_5" sourceRef="Task_ReviewDismissal_MPOO" targetRef="Exclusive_Gateway_Decision"/>

    <bpmn:sequenceFlow id="SFlow_OpposePath_6" name="Oppose Dismissal" sourceRef="Exclusive_Gateway_Decision" targetRef="Task_OpposeDismissal_MPOO">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${oppose}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SFlow_ConfirmPath_7" name="Confirm Dismissal" sourceRef="Exclusive_Gateway_Decision" targetRef="Task_ConfirmDismissal_MPOO">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${confirm}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SFlow_EndFromOppose_7" sourceRef="Task_OpposeDismissal_MPOO" targetRef="End_Oppose_MPOO"/>

    <bpmn:sequenceFlow id="SFlow_EndFromConfirm_8" sourceRef="Task_ConfirmDismissal_MPOO" targetRef="End_Confirm_MPOO"/>
  </bpmn:process>
</bpmn:definitions>