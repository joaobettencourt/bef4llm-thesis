<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_CommitteeProcess">
    <bpmn:participant id="Participant_Main" name="Committee Meeting Process" processRef="Process_MeetingManagement"/>
    <bpmn:messageFlow id="Message_AdviseMembers" sourceRef="IntermediateThrowEvent_AdviceReminder" targetRef="StartEvent_CommitteeMeeting"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_MeetingManagement" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_CoordinationUnit" name="Coordination Unit">
        <bpmn:flowNodeRef>Task_FinalizeDates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateCatchEvent_QATimer</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SupportOfficer" name="Support Officer">
        <bpmn:flowNodeRef>StartEvent_ProcessInitiated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateCalendars</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateMeetingFolders</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UploadDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateThrowEvent_AdviceReminder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProduceMinutes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_QAApproved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateThrowEvent_SendMinutes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateRecords</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_ProcessInitiated" name="Process Initiated">
      <bpmn:outgoing>SFlow_InitToDates</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Coordination Unit Task: Finalize Dates -->
    <bpmn:task id="Task_FinalizeDates" name="Finalize Meeting Dates">
      <bpmn:incoming>SFlow_DatesReadyToCalendars</bpmn:incoming>
      <bpmn:outgoing>SFlow_CalendarsNext</bpmn:outgoing>
    </bpmn:task>

    <!-- Support Officer Tasks -->
    <bpmn:task id="Task_UpdateCalendars" name="Update Group Calendars">
      <bpmn:incoming>SFlow_InitToDates</bpmn:incoming>
      <bpmn:outgoing>SFlow_CalendarsFolders</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_CreateMeetingFolders" name="Create Meeting Folders">
      <bpmn:incoming>SFlow_CalendarsFolders</bpmn:incoming>
      <bpmn:outgoing>SFlow_FoldersUploads</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_UploadDocuments" name="Upload Documents to System">
      <bpmn:incoming>SFlow_FoldersUploads</bpmn:incoming>
      <bpmn:outgoing>SFlow_DocumentsReadyReminder</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Throw Event: Advise Members 1 Week Before -->
    <bpmn:intermediateThrowEvent id="IntermediateThrowEvent_AdviceReminder" name="Advise Committee Members (1 week before)">
      <bpmn:incoming>SFlow_DocumentsReadyReminder</bpmn:incoming>
      <bpmn:outgoing>SFlow_ReminderToMeeting</bpmn:outgoing>
      <bpmn:messageEventDefinition/>
    </bpmn:intermediateThrowEvent>

    <!-- Task: Produce Minutes -->
    <bpmn:task id="Task_ProduceMinutes" name="Produce Meeting Minutes with Action Points">
      <bpmn:incoming>SFlow_MinutesReadyToQA</bpmn:incoming>
      <bpmn:outgoing>SFlow_QAReviewStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway for QA Check -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_QAApproved" name="QA Approved?">
      <bpmn:incoming>SFlow_MinutesReadyToQA</bpmn:incoming>
      <bpmn:outgoing>SFlow_SendMinutesYes</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Intermediate Throw Event: Send Minutes to Members -->
    <bpmn:intermediateThrowEvent id="IntermediateThrowEvent_SendMinutes" name="Send Minutes to Committee Members">
      <bpmn:incoming>SFlow_SendMinutesYes</bpmn:incoming>
      <bpmn:outgoing>SFlow_MinutesSentToRecords</bpmn:outgoing>
      <bpmn:messageEventDefinition/>
    </bpmn:intermediateThrowEvent>

    <!-- Task: Update Records -->
    <bpmn:task id="Task_UpdateRecords" name="Update Departmental Records">
      <bpmn:incoming>SFlow_MinutesSentToRecords</bpmn:incoming>
      <bpmn:outgoing>SFlow_ProcessComplete</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Catch Event: QA Check Timer (5 working days) -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_QATimer" name="QA Check Within 5 Working Days">
      <bpmn:incoming>SFlow_MinutesReadyToQA</bpmn:incoming>
      <bpmn:outgoing>SFlow_QAReviewComplete</bpmn:outgoing>
      <bpmn:timerEventDefinition/>
    </bpmn:intermediateCatchEvent>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_ProcessCompleted" name="Process Completed">
      <bpmn:incoming>SFlow_ProcessComplete</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SFlow_InitToDates" sourceRef="StartEvent_ProcessInitiated" targetRef="Task_UpdateCalendars"/>
    <bpmn:sequenceFlow id="SFlow_DatesReadyToCalendars" name="" sourceRef="Task_FinalizeDates" targetRef="Task_UpdateCalendars">
      <!-- Dates finalized triggers calendar updates -->
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SFlow_CalendarsFolders" sourceRef="Task_UpdateCalendars" targetRef="Task_CreateMeetingFolders"/>
    <bpmn:sequenceFlow id="SFlow_FoldersUploads" sourceRef="Task_CreateMeetingFolders" targetRef="Task_UploadDocuments"/>
    <bpmn:sequenceFlow id="SFlow_DocumentsReadyReminder" name="" sourceRef="Task_UploadDocuments" targetRef="IntermediateThrowEvent_AdviceReminder">
      <!-- Documents uploaded, reminder sent -->
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SFlow_ReminderToMeeting" name="" sourceRef="IntermediateThrowEvent_AdviceReminder" targetRef="Task_ProduceMinutes"/>
    <bpmn:sequenceFlow id="SFlow_MinutesReadyToQA" sourceRef="Task_ProduceMinutes" targetRef="ExclusiveGateway_QAApproved">
      <!-- Minutes ready for QA -->
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SFlow_SendMinutesYes" name="" sourceRef="ExclusiveGateway_QAApproved" targetRef="IntermediateThrowEvent_SendMinutes"/>
    <bpmn:sequenceFlow id="SFlow_MinutesSentToRecords" sourceRef="IntermediateThrowEvent_SendMinutes" targetRef="Task_UpdateRecords"/>
    <bpmn:sequenceFlow id="SFlow_ProcessComplete" name="" sourceRef="Task_UpdateRecords" targetRef="EndEvent_ProcessCompleted">
      <!-- Records updated, process complete -->
    </bpmn:sequenceFlow>

  </bpmn:process>

</bpmn:definitions>