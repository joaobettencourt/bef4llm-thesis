<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_BillExamination">
    <bpmn:participant id="Participant_MPOO" name="MPOO" processRef="Process_MPOO"/>
    <bpmn:participant id="Participant_GO" name="GO" processRef="Process_GO"/>
    <bpmn:participant id="Participant_MSPO" name="MSPO" processRef="Process_MSPO"/>
    <bpmn:participant id="Participant_MPON" name="MPON" processRef="Process_MPON"/>

    <!-- Message Flows -->
    <bpmn:messageFlow id="Message_MPOO_GO_Bill1" sourceRef="Task_MPOO_SendBill1" targetRef="IntermediateCatchEvent_GO_ReceiveBill1"/>
    <bpmn:messageFlow id="Message_MSPO_GO_Bill2" sourceRef="Task_MSPO_SendBill2" targetRef="IntermediateCatchEvent_GO_ReceiveBill2"/>
    <bpmn:messageFlow id="Message_MSPO_GO_Bill3" sourceRef="Task_MSPO_SendBill3" targetRef="IntermediateCatchEvent_GO_ReceiveBill3"/>
    <bpmn:messageFlow id="Message_MPOO_MPON_GOBill4" sourceRef="Task_MPOO_SendBill4" targetRef="IntermediateCatchEvent_MPON_OR_GO_ReceiveBill4"/>

  </bpmn:collaboration>

  <!-- MPOO Process - Bill Sender -->
  <bpmn:process id="Process_MPOO" isExecutable="false">
    <bpmn:startEvent id="StartMPOO_1" name="Bill Creation Initiated">
      <bpmn:outgoing>SequenceFlow_StartToGateway</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:endEvent id="EndMPOO_ConfirmationReceived">
      <bpmn:incoming>SequenceFlow_EndConfirmation</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task 1: Send bill for temporary continuation to GO -->
    <bpmn:task id="Task_MPOO_SendBill1" name="Send Bill (Temp Continuation) to GO">
      <bpmn:incoming>SequenceFlow_Task1Path</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_EndConfirmation</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: Send bill for equipment acquisition -->
    <bpmn:task id="Task_MPOO_SendBill4" name="Send Bill (Equipment Acquisition) to MPON/GO">
      <bpmn:incoming>SequenceFlow_Task5Path</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_EndConfirmation</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for bill type selection -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_BillType" name="Bill Type Selection">
      <bpmn:incoming>SequenceFlow_StartToGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Task1Path</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_Task5Path</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToGateway" sourceRef="StartMPOO_1" targetRef="ExclusiveGateway_BillType"/>
    <bpmn:sequenceFlow id="SequenceFlow_Task1Path" name="Temp Continuation Bill" sourceRef="ExclusiveGateway_BillType" targetRef="Task_MPOO_SendBill1">
      <bpmn:name>Send to GO</bpmn:name>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_Task5Path" name="Equipment Acquisition Bill" sourceRef="ExclusiveGateway_BillType" targetRef="Task_MPOO_SendBill4">
      <bpmn:name>Send to MPON/GO</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>

  <!-- GO Process - Bill Examiner -->
  <bpmn:process id="Process_GO" isExecutable="false">
    <bpmn:startEvent id="StartGO_1" name="Bill Received for Examination">
      <bpmn:outgoing>SequenceFlow_StartToGateway</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Intermediate Catch Events -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_GO_ReceiveBill1" name="Receive Bill (Temp Continuation)">
      <bpmn:incoming>Message_MPOO_GO_Bill1</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CatchToTaskExamine1</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_GO_ReceiveBill2" name="Receive Bill (Temp Measurement)">
      <bpmn:incoming>Message_MSPO_GO_Bill2</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CatchToTaskExamine2</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_GO_ReceiveBill3" name="Receive Bill (Additional Readings)">
      <bpmn:incoming>Message_MSPO_GO_Bill3</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CatchToTaskExamine3</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task 1: Examine Bill (Temp Continuation) -->
    <bpmn:task id="Task_GO_ExamineBill1" name="Examine Bill">
      <bpmn:incoming>SequenceFlow_CatchToTaskExamine1</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_TaskToGatewayDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: Examine Bill (Temp Measurement) -->
    <bpmn:task id="Task_GO_ExamineBill2" name="Examine Bill">
      <bpmn:incoming>SequenceFlow_CatchToTaskExamine2</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_TaskToGatewayDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3: Examine Bill (Additional Readings) -->
    <bpmn:task id="Task_GO_ExamineBill3" name="Examine Bill">
      <bpmn:incoming>SequenceFlow_CatchToTaskExamine3</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_TaskToGatewayDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for Decision -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_GO_Decision" name="Invoice Examination Result">
      <bpmn:incoming>SequenceFlow_TaskToGatewayDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConfirmPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RejectPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 4: Confirm Invoice -->
    <bpmn:task id="Task_GO_ConfirmInvoice" name="Confirm Invoice with Payment Advice">
      <bpmn:incoming>SequenceFlow_ConfirmPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_EndConfirmation</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 5: Reject Invoice -->
    <bpmn:task id="Task_GO_RejectInvoice" name="Reject Invoice">
      <bpmn:incoming>SequenceFlow_RejectPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_EndConfirmation</bpmn:outgoing>
    </bpmn:task>

    <!-- End Events -->
    <bpmn:endEvent id="EndGO_ConfirmationSent">
      <bpmn:incoming>SequenceFlow_EndConfirmation</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToGateway" sourceRef="StartGO_1" targetRef="ExclusiveGateway_GO_Decision"/>
    <bpmn:sequenceFlow id="SequenceFlow_CatchToTaskExamine1" name="Bill Type 1" sourceRef="IntermediateCatchEvent_GO_ReceiveBill1" targetRef="Task_GO_ExamineBill1">
      <bpmn:name>Temp Continuation</bpmn:name>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_CatchToTaskExamine2" name="Bill Type 2" sourceRef="IntermediateCatchEvent_GO_ReceiveBill2" targetRef="Task_GO_ExamineBill2">
      <bpmn:name>Temp Measurement</bpmn:name>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_CatchToTaskExamine3" name="Bill Type 3" sourceRef="IntermediateCatchEvent_GO_ReceiveBill3" targetRef="Task_GO_ExamineBill3">
      <bpmn:name>Additional Readings</bpmn:name>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_TaskToGatewayDecision" sourceRef="Task_GO_ExamineBill1" targetRef="ExclusiveGateway_GO_Decision"/>

  </bpmn:process>

  <!-- MSPO Process - Bill Sender -->
  <bpmn:process id="Process_MSPO" isExecutable="false">
    <bpmn:startEvent id="StartMSPO_1" name="Bill Creation Initiated">
      <bpmn:outgoing>SequenceFlow_StartToGateway</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- End Event for Response -->
    <bpmn:endEvent id="EndMSPO_ConfirmationReceived">
      <bpmn:incoming>SequenceFlow_EndConfirmation</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task 1: Send bill (Temp Measurement) to GO -->
    <bpmn:task id="Task_MSPO_SendBill2" name="Send Bill (Temp Measurement) to GO">
      <bpmn:outgoing>SequenceFlow_EndConfirmation</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: Send bill (Additional Readings) to GO -->
    <bpmn:task id="Task_MSPO_SendBill3" name="Send Bill (Additional Readings) to GO">
      <bpmn:outgoing>SequenceFlow_EndConfirmation</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for bill type selection -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_MSPO_BillType" name="Bill Type Selection">
      <bpmn:incoming>SequenceFlow_StartToTask</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_Task2Path</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_Task3Path</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToTask" sourceRef="StartMSPO_1" targetRef="ExclusiveGateway_MSPO_BillType"/>
    <bpmn:sequenceFlow id="SequenceFlow_Task2Path" name="Temp Measurement Bill" sourceRef="ExclusiveGateway_MSPO_BillType" targetRef="Task_MSPO_SendBill2">
      <bpmn:name>Send to GO</bpmn:name>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_Task3Path" name="Additional Readings Bill" sourceRef="ExclusiveGateway_MSPO_BillType" targetRef="Task_MSPO_SendBill3">
      <bpmn:name>Send to GO</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>

  <!-- MPON Process - Bill Examiner (Alternative) -->
  <bpmn:process id="Process_MPON" isExecutable="false">
    <bpmn:startEvent id="StartMPON_1" name="Bill Received for Examination">
      <bpmn:outgoing>SequenceFlow_StartToCatch</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Intermediate Catch Event -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_MPON_OR_GO_ReceiveBill4" name="Receive Bill (Equipment Acquisition)">
      <bpmn:incoming>Message_MPOO_MPON_GOBill4</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CatchToTaskExamineMPON</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task 1: Examine Bill (Equipment Acquisition) -->
    <bpmn:task id="Task_MPON_ExamineBill4" name="Examine Equipment Bill">
      <bpmn:incoming>SequenceFlow_CatchToTaskExamineMPON</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_TaskToGatewayDecisionMPON</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for Decision -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_MPON_Decision" name="Invoice Examination Result">
      <bpmn:incoming>SequenceFlow_TaskToGatewayDecisionMPON</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ConfirmPathMPON</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RejectPathMPON</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 2: Confirm Invoice -->
    <bpmn:task id="Task_MPON_ConfirmInvoice" name="Confirm Invoice with Payment Advice">
      <bpmn:incoming>SequenceFlow_ConfirmPathMPON</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_EndConfirmation</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3: Reject Invoice -->
    <bpmn:task id="Task_MPON_RejectInvoice" name="Reject Invoice">
      <bpmn:incoming>SequenceFlow_RejectPathMPON</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_EndConfirmation</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndMPON_ConfirmationSent">
      <bpmn:incoming>SequenceFlow_EndConfirmation</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToCatch" sourceRef="StartMPON_1" targetRef="IntermediateCatchEvent_MPON_OR_GO_ReceiveBill4"/>
    <bpmn:sequenceFlow id="SequenceFlow_CatchToTaskExamineMPON" name="Equipment Bill Received" sourceRef="IntermediateCatchEvent_MPON_OR_GO_ReceiveBill4" targetRef="Task_MPON_ExamineBill4">
      <bpmn:name>Equipment Acquisition</bpmn:name>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_TaskToGatewayDecisionMPON" sourceRef="Task_MPON_ExamineBill4" targetRef="ExclusiveGateway_MPON_Decision"/>

  </bpmn:process>

</bpmn:definitions>