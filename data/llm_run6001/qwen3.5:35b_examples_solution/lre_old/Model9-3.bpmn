<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Authority" name="Town Planning Authority" processRef="Process_Authority"/>
    <bpmn:participant id="Participant_Members" name="Committee Members" processRef="Process_Members"/>
    
    <!-- Message Flow 1: Send Schedule -->
    <bpmn:messageFlow id="MessageFlow_SendSchedule" sourceRef="IntermediateThrowEvent_SendToMembers" targetRef="StartMessageEvent_ReceiveSchedule"/>
    
    <!-- Message Flow 2: Advise Conflicts -->
    <bpmn:messageFlow id="MessageFlow_AdviseConflicts" sourceRef="IntermediateThrowEvent_AdviseConflicts" targetRef="IntermediateCatchEvent_ReceiveAdvice"/>
  </bpmn:collaboration>

  <!-- Process for Town Planning Authority -->
  <bpmn:process id="Process_Authority" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_CoordUnit" name="Coordination Unit">
        <bpmn:flowNodeRef>StartTimerEvent_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DraftSchedule</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecheckDates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateThrowEvent_SendToMembers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateCatchEvent_ReceiveAdvice</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SupportOfficer" name="Support Officer">
        <bpmn:flowNodeRef>Task_CheckDatesModify</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartTimerEvent_0" name="November">
      <bpmn:outgoing>SFlow_StartToDraft</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Draft Schedule (Coordination Unit) -->
    <bpmn:task id="Task_DraftSchedule" name="Draft schedule and add dates">
      <bpmn:incoming>SFlow_StartToDraft</bpmn:incoming>
      <bpmn:outgoing>SFlow_DraftToCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: Check Dates (Support Officer) -->
    <bpmn:task id="Task_CheckDatesModify" name="Check dates and suggest modifications">
      <bpmn:incoming>SFlow_DraftToCheck</bpmn:incoming>
      <bpmn:outgoing>SFlow_ModifyToRecheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3: Recheck Dates (Coordination Unit) -->
    <bpmn:task id="Task_RecheckDates" name="Recheck dates and look for conflicts">
      <bpmn:incoming>SFlow_ModifyToRecheck</bpmn:incoming>
      <bpmn:outgoing>SFlow_ReadyToSend</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Throw Event -->
    <bpmn:intermediateThrowEvent id="IntermediateThrowEvent_SendToMembers" name="Send schedule to members">
      <bpmn:incoming>SFlow_ReadyToSend</bpmn:incoming>
      <bpmn:outgoing>SFlow_ToCatchAdvice</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <!-- Intermediate Catch Event -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_ReceiveAdvice" name="Receive advice of conflicts">
      <bpmn:incoming>SFlow_ToCatchAdvice</bpmn:incoming>
      <bpmn:outgoing>SFlow_EndProcess</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- End Event -->
    <bpmn:endEvent id="End_Authority" name="Schedule finalized">
      <bpmn:incoming>SFlow_EndProcess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SFlow_StartToDraft" sourceRef="StartTimerEvent_0" targetRef="Task_DraftSchedule"/>
    <bpmn:sequenceFlow id="SFlow_DraftToCheck" name="" sourceRef="Task_DraftSchedule" targetRef="Task_CheckDatesModify"/>
    <bpmn:sequenceFlow id="SFlow_ModifyToRecheck" name="" sourceRef="Task_CheckDatesModify" targetRef="Task_RecheckDates"/>
    <bpmn:sequenceFlow id="SFlow_ReadyToSend" name="" sourceRef="Task_RecheckDates" targetRef="IntermediateThrowEvent_SendToMembers"/>
    <bpmn:sequenceFlow id="SFlow_ToCatchAdvice" name="" sourceRef="IntermediateThrowEvent_SendToMembers" targetRef="IntermediateCatchEvent_ReceiveAdvice"/>
    <bpmn:sequenceFlow id="SFlow_EndProcess" name="" sourceRef="IntermediateCatchEvent_ReceiveAdvice" targetRef="End_Authority"/>

  </bpmn:process>

  <!-- Process for Committee Members -->
  <bpmn:process id="Process_Members" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_CommitteeMembers" name="">
        <bpmn:flowNodeRef>StartMessageEvent_ReceiveSchedule</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckDiariesAdvise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateThrowEvent_AdviseConflicts</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event (Message) -->
    <bpmn:startEvent id="StartMessageEvent_ReceiveSchedule" name="Receive meeting schedule">
      <bpmn:outgoing>SFlow_StartToCheck</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Check Diaries -->
    <bpmn:task id="Task_CheckDiariesAdvise" name="Check diaries and advise conflicts">
      <bpmn:incoming>SFlow_StartToCheck</bpmn:incoming>
      <bpmn:outgoing>SFlow_AdviseConflictsOut</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Throw Event -->
    <bpmn:intermediateThrowEvent id="IntermediateThrowEvent_AdviseConflicts" name="Advise schedule conflicts">
      <bpmn:incoming>SFlow_AdviseConflictsOut</bpmn:incoming>
      <bpmn:outgoing>SFlow_EndMembersProcess</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <!-- End Event -->
    <bpmn:endEvent id="End_Members" name="">
      <bpmn:incoming>SFlow_EndMembersProcess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SFlow_StartToCheck" sourceRef="StartMessageEvent_ReceiveSchedule" targetRef="Task_CheckDiariesAdvise"/>
    <bpmn:sequenceFlow id="SFlow_AdviseConflictsOut" name="" sourceRef="Task_CheckDiariesAdvise" targetRef="IntermediateThrowEvent_AdviseConflicts"/>
    <bpmn:sequenceFlow id="SFlow_EndMembersProcess" name="" sourceRef="IntermediateThrowEvent_AdviseConflicts" targetRef="End_Members"/>

  </bpmn:process>
</bpmn:definitions>