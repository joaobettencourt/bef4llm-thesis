<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_ZooClubMembership">
    <bpmn:participant id="Participant_Visitor" name="Visitor" processRef="Process_Visitor"/>
    <bpmn:participant id="Participant_ZooClub" name="Zoo Club Department" processRef="Process_ZooClub"/>
    <bpmn:participant id="Participant_Billing" name="Billing Department" processRef="Process_Billing"/>
    <bpmn:messageFlow id="Message_VisitorToZooClub" sourceRef="Task_VisitorSendInfo" targetRef="StartEvent_ZooClubReceive"/>
    <bpmn:messageFlow id="Message_ZooClubToVisitorCard" sourceRef="EndEvent_CardDelivered" targetRef="IntermediateCatch_EventReceived"/>
    <bpmn:messageFlow id="Message_BillingToZooClubPaymentConfirm" sourceRef="Task_ProcessPaymentInfo" targetRef="IntermediateCatch_PaymentConfirmed"/>
  </bpmn:collaboration>

  <!-- Visitor Process -->
  <bpmn:process id="Process_Visitor">
    <bpmn:startEvent id="StartEvent_MembershipDecision" name="Membership Decision Requested">
      <bpmn:outgoing>SFlow_StartDecision"/>
    </bpmn:startEvent>

    <bpmn:task id="Task_DecideType" name="Decide Individual or Family Membership">
      <bpmn:incoming>SFlow_StartDecision</bpmn:incoming>
      <bpmn:outgoing>SFlow_GatewayToChoice"/>
    </bpmn:task>

    <bpmn:exclusiveGateway id="ExclusiveGateway_MembershipType" name="Individual Membership?">
      <bpmn:incoming>SFlow_DecisionToGateway</bpmn:incoming>
      <bpmn:outgoing>SFlow_YesPersonalInfo"/>
      <bpmn:outgoing>SFlow_NoFamilyInfo"/>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_PersonalInfo" name="Prepare Personal Information">
      <bpmn:incoming>SFlow_YesPersonalInfo</bpmn:incoming>
      <bpmn:outgoing>SFlow_GatewayMerge1"/>
    </bpmn:task>

    <bpmn:task id="Task_FamilyInfo" name="Prepare Family Information (Spouse &amp; Spawn)">
      <bpmn:incoming>SFlow_NoFamilyInfo</bpmn:incoming>
      <bpmn:outgoing>SFlow_GatewayMerge1"/>
    </bpmn:task>

    <bpmn:exclusiveGateway id="ExclusiveGateway_InfoPrepared">
      <bpmn:incoming>SFlow_PersonalToMerge</bpmn:incoming>
      <bpmn:incoming>SFlow_FamilyToMerge</bpmn:incoming>
      <bpmn:outgoing>SFlow_SendInfo"/>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_VisitorSendInfo" name="Send Information to ZooClub Department">
      <bpmn:incoming>SFlow_GatewayMerge1</bpmn:incoming>
      <bpmn:outgoing>SFlow_WaitCard"/>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_VisitorDone" name="Membership Process Complete">
      <bpmn:incoming>SFlow_FinalGoHome</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SFlow_StartDecision" sourceRef="StartEvent_MembershipDecision" targetRef="Task_DecideType"/>
    <bpmn:sequenceFlow id="SFlow_GatewayToChoice" name="" sourceRef="ExclusiveGateway_MembershipType" targetRef="Task_PersonalInfo">
      <bpmn:bpmndi:name>Yes</bpmn:bpmndi:name>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SFlow_NoFamilyInfo" name="" sourceRef="ExclusiveGateway_MembershipType" targetRef="Task_FamilyInfo">
      <bpmn:bpmndi:name>No</bpmn:bpmndi:name>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SFlow_PersonalToMerge" sourceRef="Task_PersonalInfo" targetRef="ExclusiveGateway_InfoPrepared"/>
    <bpmn:sequenceFlow id="SFlow_FamilyToMerge" sourceRef="Task_FamilyInfo" targetRef="ExclusiveGateway_InfoPrepared"/>
    <bpmn:sequenceFlow id="SFlow_SendInfo" sourceRef="ExclusiveGateway_InfoPrepared" targetRef="Task_VisitorSendInfo"/>

  </bpmn:process>

  <!-- Zoo Club Department Process -->
  <bpmn:process id="Process_ZooClub">
    <bpmn:startEvent id="StartEvent_ZooClubReceive" name="Receive Visitor Information">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SFlow_EnterSystem"/>
    </bpmn:startEvent>

    <bpmn:task id="Task_EnterData" name="Enter Personal Data into System">
      <bpmn:incoming>SFlow_ZooStart</bpmn:incoming>
      <bpmn:outgoing>SFlow_ParallelSplit"/>
    </bpmn:task>

    <bpmn:parallelGateway id="ParallelGateway_Split" name="">
      <bpmn:incoming>SFlow_EnterDataToSplit</bpmn:incoming>
      <bpmn:outgoing>SFlow_ToBillingRequest</bpmn:outgoing>
      <bpmn:outgoing>SFlow_ToMarketingForward"/>
    </bpmn:parallelGateway>

    <bpmn:task id="Task_SendPaymentReq" name="Send Payment Request to Billing Department">
      <bpmn:incoming>SFlow_ParallelToBilling</bpmn:incoming>
      <bpmn:outgoing>SFlow_WaitConfirmation"/>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_ZooClubComplete" name="Membership Process Complete">
      <bpmn:incoming>SFlow_FinalDeliver</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Marketing Task -->
    <bpmn:task id="Task_ForwardToMarketing" name="Forward Information to Marketing Department">
      <bpmn:incoming>SFlow_ParallelToMarket</bpmn:incoming>
      <bpmn:outgoing>SFlow_MarketingMail"/>
    </bpmn:task>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SFlow_ZooStart" sourceRef="StartEvent_ZooClubReceive" targetRef="Task_EnterData"/>
    <bpmn:sequenceFlow id="SFlow_ParallelToBilling" sourceRef="ParallelGateway_Split" targetRef="Task_SendPaymentReq"/>
    <bpmn:sequenceFlow id="SFlow_ToMarketingForward" name="" sourceRef="ParallelGateway_Split" targetRef="Task_ForwardToMarketing">
      <bpmn:bpmndi:name>Split</bpmn:bpmndi:name>
    </bpmn:sequenceFlow>

  </bpmn:process>

  <!-- Billing Department Process -->
  <bpmn:process id="Process_Billing">
    <bpmn:startEvent id="StartEvent_BillingReceive" name="Payment Request Received">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SFlow_ProcessRequest"/>
    </bpmn:startEvent>

    <bpmn:endEvent id="EndEvent_BillingComplete" name="Payment Processed">
      <bpmn:incoming>SFlow_FinalCharge</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SFlow_ProcessRequest" sourceRef="StartEvent_BillingReceive" targetRef="Task_ProcessPaymentInfo"/>
    <bpmn:sequenceFlow id="SFlow_ChargeAccount" name="" sourceRef="Task_ProcessPaymentInfo" targetRef="EndEvent_BillingComplete">
      <bpmn:bpmndi:name>Process Payment</bpmn:bpmndi:name>
    </bpmn:sequenceFlow>

  </bpmn:process>

</bpmn:definitions>