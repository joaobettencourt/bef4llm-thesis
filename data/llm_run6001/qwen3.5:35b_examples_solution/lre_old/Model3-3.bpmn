<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_ClaimHandling">
    <bpmn:participant id="Participant_ClaimProcess" name="Claims Handling Process" processRef="Process_ClaimHandling"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_ClaimHandling" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_ClaimsOfficer" name="Claims Officer">
        <bpmn:flowNodeRef>Task_ExamineClaim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WriteRecommendation</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SeniorOfficer" name="Senior Claims Officer">
        <bpmn:flowNodeRef>Task_CheckRecommendation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DecisionOK</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_ClaimRegistered" name="Claim Registered">
      <bpmn:outgoing>SFlow_StartToExamine</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Examine Claim (Claims Officer) -->
    <bpmn:task id="Task_ExamineClaim" name="Examine claim">
      <bpmn:incoming>SFlow_StartToExamine</bpmn:incoming>
      <bpmn:outgoing>SFlow_ExamineToWriteRec</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Write Recommendation (Claims Officer) -->
    <bpmn:task id="Task_WriteRecommendation" name="Write settlement recommendation">
      <bpmn:incoming>SFlow_ExamineToWriteRec</bpmn:incoming>
      <bpmn:incoming>SFlow_LoopBackNotOK</bpmn:incoming>
      <bpmn:outgoing>SFlow_WriteRecToCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Check Recommendation (Senior Claims Officer) -->
    <bpmn:task id="Task_CheckRecommendation" name="Check recommendation">
      <bpmn:incoming>SFlow_WriteRecToCheck</bpmn:incoming>
      <bpmn:outgoing>SFlow_CheckToDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Decision (Senior Claims Officer) -->
    <bpmn:exclusiveGateway id="Gateway_DecisionOK" name="Claim OK?">
      <bpmn:incoming>SFlow_CheckToDecision</bpmn:incoming>
      <bpmn:outgoing>SFlow_OKProceeds</bpmn:outgoing>
      <bpmn:outgoing>SFlow_NotOKLoopBack</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_ProcessProceeds" name="Process proceeds">
      <bpmn:incoming>SFlow_OKProceeds</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SFlow_StartToExamine" sourceRef="StartEvent_ClaimRegistered" targetRef="Task_ExamineClaim"/>
    
    <bpmn:sequenceFlow id="SFlow_ExamineToWriteRec" name="" sourceRef="Task_ExamineClaim" targetRef="Task_WriteRecommendation"/>

    <bpmn:sequenceFlow id="SFlow_WriteRecToCheck" name="" sourceRef="Task_WriteRecommendation" targetRef="Task_CheckRecommendation"/>
    
    <bpmn:sequenceFlow id="SFlow_CheckToDecision" name="" sourceRef="Task_CheckRecommendation" targetRef="Gateway_DecisionOK"/>

    <!-- OK Path -->
    <bpmn:sequenceFlow id="SFlow_OKProceeds" name="Yes (OK)" sourceRef="Gateway_DecisionOK" targetRef="EndEvent_ProcessProceeds"/>

    <!-- Not OK Path (Loop) -->
    <bpmn:sequenceFlow id="SFlow_NotOKLoopBack" name="No (Not OK)" sourceRef="Gateway_DecisionOK" targetRef="Task_WriteRecommendation"/>
  </bpmn:process>
</bpmn:definitions>