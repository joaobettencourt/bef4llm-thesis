<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_ClaimsProcess">
    <bpmn:participant id="Participant_ClaimsProcess" name="Claims Management Process" processRef="Process_Claims"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Claims" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Clerk" name="Clerk/Administrative Staff">
        <bpmn:flowNodeRef>StartEvent_AccidentReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SearchPoliceReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ComposeFile</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Handler" name="Claims Handler">
        <bpmn:flowNodeRef>Task_CalculateEstimate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateActionPlan</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Manager" name="Claims Manager">
        <bpmn:flowNodeRef>Task_NegotiateSettlement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyClaimant</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_AccidentReport" name="Accident Report Received">
      <bpmn:outgoing>SFlow_StartToSearch</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Search Police Report -->
    <bpmn:task id="Task_SearchPoliceReport" name="Search Police Report Database">
      <bpmn:incoming>SFlow_StartToSearch</bpmn:incoming>
      <bpmn:outgoing>SFlow_SearchToFile</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: Compose File -->
    <bpmn:task id="Task_ComposeFile" name="Compose File with Claim Documentation">
      <bpmn:incoming>SFlow_SearchToFile</bpmn:incoming>
      <bpmn:outgoing>SFlow_FileToHandler</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3: Calculate Estimate -->
    <bpmn:task id="Task_CalculateEstimate" name="Calculate Initial Claim Estimate">
      <bpmn:incoming>SFlow_FileToHandler</bpmn:incoming>
      <bpmn:outgoing>SFlow_EstimateToPlan</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 4: Create Action Plan -->
    <bpmn:task id="Task_CreateActionPlan" name="Create Action Plan">
      <bpmn:incoming>SFlow_EstimateToPlan</bpmn:incoming>
      <bpmn:outgoing>SFlow_PlanToNegotiate</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 5: Negotiate Settlement -->
    <bpmn:task id="Task_NegotiateSettlement" name="Negotiate Claim Estimate">
      <bpmn:incoming>SFlow_PlanToNegotiate</bpmn:incoming>
      <bpmn:outgoing>SFlow_NegotiateToNotify</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 6: Notify Claimant -->
    <bpmn:task id="Task_NotifyClaimant" name="Inform Claimant of Outcome">
      <bpmn:incoming>SFlow_NegotiateToNotify</bpmn:incoming>
      <bpmn:outgoing>SFlow_EndProcess</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_ProcessComplete" name="Claim Process Completed">
      <bpmn:incoming>SFlow_EndProcess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SFlow_StartToSearch" sourceRef="StartEvent_AccidentReport" targetRef="Task_SearchPoliceReport"/>
    <bpmn:sequenceFlow id="SFlow_SearchToFile" name="Compile Report &amp; Docs" sourceRef="Task_SearchPoliceReport" targetRef="Task_ComposeFile"/>
    <bpmn:sequenceFlow id="SFlow_FileToHandler" name="Submit File for Review" sourceRef="Task_ComposeFile" targetRef="Task_CalculateEstimate"/>
    <bpmn:sequenceFlow id="SFlow_EstimateToPlan" name="Proceed to Planning" sourceRef="Task_CalculateEstimate" targetRef="Task_CreateActionPlan"/>
    <bpmn:sequenceFlow id="SFlow_PlanToNegotiate" name="Initiate Negotiation" sourceRef="Task_CreateActionPlan" targetRef="Task_NegotiateSettlement"/>
    <bpmn:sequenceFlow id="SFlow_NegotiateToNotify" name="Outcome Determined" sourceRef="Task_NegotiateSettlement" targetRef="Task_NotifyClaimant"/>
    <bpmn:sequenceFlow id="SFlow_EndProcess" sourceRef="Task_NotifyClaimant" targetRef="EndEvent_ProcessComplete"/>

  </bpmn:process>
</bpmn:definitions>