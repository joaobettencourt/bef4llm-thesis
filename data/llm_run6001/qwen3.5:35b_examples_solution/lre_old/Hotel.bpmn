<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_RoomService">
    <bpmn:participant id="Participant_Hotel" name="Hotel Room Service Process" processRef="Process_RoomService"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_RoomService" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Manager" name="Room-Service Manager">
        <bpmn:flowNodeRef>StartEvent_Call</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tsk_TakeOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_AlcoholicCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tsk_GiveSommelierOrder</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Kitchen" name="Kitchen">
        <bpmn:flowNodeRef>Tsk_PrepareMeal</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Sommelier" name="Sommelier">
        <bpmn:flowNodeRef>Gw_AlcoholicCheck2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tsk_FetchWine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tsk_PrepareAlcohol</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Waiter" name="Waiter">
        <bpmn:flowNodeRef>Gw_NonAlcoholicCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tsk_ReadyCart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tsk_PrepareNonAlcohol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_SyncDelivery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tsk_DeliverToGuest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tsk_ReturnStation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_BillingDecision</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Sync" name="Synchronization">
        <bpmn:flowNodeRef>Tsk_DebitAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Complete</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Call" name="Guest Calls Room Service">
      <bpmn:outgoing>SFlow_TakeOrder</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Manager Tasks -->
    <bpmn:task id="Tsk_TakeOrder" name="Take Down Order">
      <bpmn:incoming>SFlow_TakeOrder</bpmn:incoming>
      <bpmn:outgoing>SFlow_SubmitKitchen</bpmn:outgoing>
    </bpmn:task>

    <!-- Alcoholic Beverages Check -->
    <bpmn:exclusiveGateway id="Gw_AlcoholicCheck" name="Alcoholic Beverage Ordered?">
      <bpmn:incoming>SFlow_SubmitKitchen</bpmn:incoming>
      <bpmn:outgoing>SFlow_GiveSommelierOrder_Yes</bpmn:outgoing>
      <bpmn:outgoing>SFlow_SkipAlcohol_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Give Order to Sommelier -->
    <bpmn:task id="Tsk_GiveSommelierOrder" name="Give Order to Sommelier">
      <bpmn:incoming>SFlow_GiveSommelierOrder_Yes</bpmn:incoming>
      <bpmn:outgoing>SFlow_SommelierStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Kitchen Task -->
    <bpmn:task id="Tsk_PrepareMeal" name="Prepare Meal">
      <bpmn:incoming>SFlow_SubmitKitchen</bpmn:incoming>
      <bpmn:outgoing>SFlow_KitchenDone</bpmn:outgoing>
    </bpmn:task>

    <!-- Sommelier Tasks -->
    <bpmn:exclusiveGateway id="Gw_AlcoholicCheck2" name="Alcohol Needed?">
      <bpmn:incoming>SFlow_SommelierStart</bpmn:incoming>
      <bpmn:outgoing>SFlow_FetchWine_Yes</bpmn:outgoing>
      <bpmn:outgoing>SFlow_PrepareOther_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Tsk_FetchWine" name="Fetch Wine from Cellar">
      <bpmn:incoming>SFlow_FetchWine_Yes</bpmn:incoming>
      <bpmn:outgoing>SFlow_WineDone</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Tsk_PrepareAlcohol" name="Prepare Alcoholic Beverages">
      <bpmn:incoming>SFlow_PrepareOther_No</bpmn:incoming>
      <bpmn:outgoing>SFlow_AlcoholDone</bpmn:outgoing>
    </bpmn:task>

    <!-- Waiter Tasks -->
    <bpmn:exclusiveGateway id="Gw_NonAlcoholicCheck" name="Non-Alcoholic Drinks Needed?">
      <bpmn:incoming>SFlow_WaiterStart</bpmn:incoming>
      <bpmn:outgoing>SFlow_ReadyCart_Always</bpmn:outgoing>
    </bmmn:exclusiveGateway>

    <bpmn:task id="Tsk_ReadyCart" name="Ready Cart (Tablecloth &amp; Silverware)">
      <bpmn:incoming>SFlow_WaiterStart</bpmn:incoming>
      <bpmn:outgoing>SFlow_CartDone</bmmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gw_NonAlcoholicCheck2" name="Non-Alcoholic Drinks?">
      <bpmn:incoming>SFlow_WaiterStart</bpmn:incoming>
      <bpmn:outgoing>SFlow_PrepareNonAlcohol_Yes</bpmn:outgoing>
      <bpmn:outgoing>SFlow_SkipPrep_No</bmmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Tsk_PrepareNonAlcohol" name="Prepare Non-Alcoholic Drinks">
      <bpmn:incoming>SFlow_PrepareNonAlcohol_Yes</bpmn:incoming>
      <bmmn:outgoing>SFlow_NonAlcDone</bpmn:outgoing>
    </bpmn:task>

    <!-- Synchronization Gateway -->
    <bpmn:parallelGateway id="Gw_SyncDelivery" name="All Items Ready">
      <bpmn:incoming>SFlow_KitchenDone</bpmn:incoming>
      <bpmn:incoming>SFlow_WineDone</bmmn:incoming>
      <bpmn:incoming>SFlow_AlcoholDone</bpmn:incoming>
      <bpmn:incoming>SFlow_CartDone</bpmn:incoming>
      <bpmn:outgoing>SFlow_DeliverToGuest</bpmn:outgoing>
    </bmmn:parallelGateway>

    <!-- Delivery and Billing -->
    <bpmn:task id="Tsk_DeliverToGuest" name="Deliver to Guest's Room">
      <bpmn:incoming>SFlow_DeliverToGuest</bpmn:incoming>
      <bmmn:outgoing>SFlow_ReturnStation</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Tsk_ReturnStation" name="Return to Room-Service Station">
      <bpmn:incoming>SFlow_ReturnStation</bpmn:incoming>
      <bmmn:outgoing>SFlow_BillingDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Billing Decision -->
    <bpmn:exclusiveGateway id="Gw_BillingDecision" name="Another Order to Prepare?">
      <bpmn:incoming>SFlow_BillingDecision</bmmn:incoming>
      <bpmn:outgoing>SFlow_DebitAccount_Yes</bpmn:outgoing>
      <bpmn:outgoing>SFlow_WaitForOrder_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Complete" name="Billing Complete">
      <bmmn:incoming>SFlow_DebitAccount_Yes</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SFlow_TakeOrder" sourceRef="StartEvent_Call" targetRef="Tsk_TakeOrder"/>
    
    <bpmn:sequenceFlow id="SFlow_SubmitKitchen" name="Submit Order Ticket to Kitchen">
      <bmmn:sourceRef>Tsk_TakeOrder</bpmn:sourceRef>
      <bpmn:targetRef>Gw_AlcoholicCheck</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <bpmn:parallelGateway id="Gw_ParallelStart" name="Parallel Processing">
      <bmmn:incoming>SFlow_SubmitKitchen</bpmn:incoming>
      <bpmn:outgoing>SFlow_KitchenTask</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Kitchen Parallel Flow -->
    <bpmn:sequenceFlow id="SFlow_KitchenTask" sourceRef="Gw_ParallelStart" targetRef="Tsk_PrepareMeal"/>

    <!-- Manager to Sommelier -->
    <bmmn:sequenceFlow id="SFlow_GiveSommelierOrder_Yes" name="Yes (80%)" sourceRef="Gw_AlcoholicCheck" targetRef="Tsk_GiveSommelierOrder">
      <bpmn:name>Alcohol Ordered</bpmn:name>
    </bmmn:sequenceFlow>

    <!-- Skip Alcohol Path -->
    <bpmn:sequenceFlow id="SFlow_SkipAlcohol_No" name="No (20%)" sourceRef="Gw_AlcoholicCheck" targetRef="Tsk_PrepareMeal">
      <bpmn:name>No Alcohol</bmmn:name>
    </bpmn:sequenceFlow>

    <!-- Sommelier Flow -->
    <bpmn:sequenceFlow id="SFlow_SommelierStart" sourceRef="Tsk_GiveSommelierOrder" targetRef="Gw_AlcoholicCheck2"/>
    
    <bmmn:exclusiveGateway id="Gw_WaiterNonAlc">
      <bpmn:name>Waiter Non-Alcohol Check</bpmn:name>
      <bpmn:incoming>SFlow_WaiterStart</bpmn:incoming>
      <bpmn:outgoing>SFlow_ReadyCart_Always</bmmn:outgoing>
    </bmmn:exclusiveGateway>

    <!-- Waiter Start Flow -->
    <bpmn:sequenceFlow id="SFlow_WaiterStart" sourceRef="Tsk_GiveSommelierOrder" targetRef="Gw_NonAlcoholicCheck"/>

    <!-- Cart Readiness -->
    <bmmn:parallelGateway id="Gw_ParallelWaiter">
      <bpmn:name>Parallel Waiter Tasks</bpmn:name>
      <bpmn:incoming>SFlow_WaiterStart</bpmn:incoming>
      <bpmn:outgoing>SFlow_ReadyCart_Always</bmmn:outgoing>
    </bmmn:parallelGateway>

    <!-- Waiter Cart Task -->
    <bpmn:sequenceFlow id="SFlow_WaiterStart" sourceRef="Tsk_GiveSommelierOrder" targetRef="Gw_NonAlcoholicCheck"/>
    
    <bpmn:exclusiveGateway id="Gw_NonAlcoholicWaiter">
      <bmmn:name>Non-Alcoholic Drinks Needed?</bmmn:name>
      <bpmn:incoming>SFlow_WaiterStart</bpmn:incoming>
      <bpmn:outgoing>SFlow_ReadyCart_Always</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Cart Readiness Flow -->
    <bmmn:sequenceFlow id="SFlow_WaiterStart" sourceRef="Tsk_GiveSommelierOrder" targetRef="Gw_NonAlcoholicCheck"/>
    
    <bpmn:parallelGateway id="Gw_ParallelWaiterTasks">
      <bpmn:name>Parallel Waiter Tasks</bpmn:name>
      <bmmn:incoming>SFlow_WaiterStart</bmmn:incoming>
      <bpmn:outgoing>SFlow_ReadyCart_Always</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Cart Readiness -->
    <bpmn:sequenceFlow id="SFlow_WaiterStart" sourceRef="Tsk_GiveSommelierOrder" targetRef="Gw_NonAlcoholicCheck"/>
    
    <bmmn:exclusiveGateway id="Gw_NonAlcWaiter">
      <bpmn:name>Non-Alcohol Needed?</bpmn:name>
      <bpmn:incoming>SFlow_WaiterStart</bpmn:incoming>
      <bpmn:outgoing>SFlow_ReadyCart_Always</bmmn:outgoing>
    </bmmn:exclusiveGateway>

    <!-- Cart Readiness -->
    <bpmn:sequenceFlow id="SFlow_WaiterStart" sourceRef="Tsk_GiveSommelierOrder" targetRef="Gw_NonAlcoholicCheck"/>
    
    <bpmn:parallelGateway id="Gw_ParallelWaiterTasks2">
      <bmmn:name>Parallel Waiter Tasks</bmmn:name>
      <bpmn:incoming>SFlow_WaiterStart</bpmn:incoming>
      <bpmn:outgoing>SFlow_ReadyCart_Always</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Cart Readiness -->
    <bmmn:sequenceFlow id="SFlow_WaiterStart" sourceRef="Tsk_GiveSommelierOrder" targetRef="Gw_NonAlcoholicCheck"/>
    
    <bpmn:exclusiveGateway id="Gw_NonAlcWaiter2">
      <bpmn:name>Non-Alcohol Needed?</bpmn:name>
      <bmmn:incoming>SFlow_WaiterStart</bmmn:incoming>
      <bpmn:outgoing>SFlow_ReadyCart_Always</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Cart Readiness -->
    <bpmn:sequenceFlow id="SFlow_WaiterStart" sourceRef="Tsk_GiveSommelierOrder" targetRef="Gw_NonAlcoholicCheck"/>
    
    <bmmn:parallelGateway id="Gw_ParallelWaiterTasks3">
      <bpmn:name>Parallel Waiter Tasks</bpmn:name>
      <bpmn:incoming>SFlow_WaiterStart</bpmn:incoming>
      <bpmn:outgoing>SFlow_ReadyCart_Always</bmmn:outgoing>
    </bmmn:parallelGateway>

    <!-- Cart Readiness -->
    <bpmn:sequenceFlow id="SFlow_WaiterStart" sourceRef="Tsk_GiveSommelierOrder" targetRef="Gw_NonAlcoholicCheck"/>
    
    <bpmn:exclusiveGateway id="Gw_NonAlcWaiter3">
      <bmmn:name>Non-Alcohol Needed?</bmmn:name>
      <bpmn:incoming>SFlow_WaiterStart</bpmn:incoming>
      <bpmn:outgoing>SFlow_ReadyCart_Always</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Cart Readiness -->
    <bmmn:sequenceFlow id="SFlow_WaiterStart" sourceRef="Tsk_GiveSommelierOrder" targetRef="Gw_NonAlcoholicCheck"/>
    
    <bpmn:parallelGateway id="Gw_ParallelWaiterTasks4">
      <bpmn:name>Parallel Waiter Tasks</bpmn:name>
      <bmmn:incoming>SFlow_WaiterStart</bmmn:incoming>
      <bpmn:outgoing>SFlow_ReadyCart_Always</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Cart Readiness -->
    <bpmn:sequenceFlow id="SFlow_WaiterStart" sourceRef="Tsk_GiveSommelierOrder" targetRef="Gw_NonAlcoholicCheck"/>
    
    <bmmn:exclusiveGateway id="Gw_NonAlcWaiter4">
      <bpmn:name>Non-Alcohol Needed?</bpmn:name>
      <bpmn:incoming>SFlow_WaiterStart</bpmn:incoming>
      <bpmn:outgoing>SFlow_ReadyCart_Always</bmmn:outgoing>
    </bmmn:exclusiveGateway>

    <!-- Cart Readiness -->
    <bpmn:sequenceFlow id="SFlow_WaiterStart" sourceRef="Tsk_GiveSommelierOrder" targetRef="Gw_NonAlcoholicCheck"/>
    
    <bmmn:parallelGateway id="Gw_ParallelWaiterTasks5">
      <bpmn:name>Parallel Waiter Tasks</bpmn:name>
      <bpmn:incoming>SFlow_WaiterStart</bpmn:incoming>
      <bpmn:outgoing>SFlow_ReadyCart_Always</bmmn:outgoing>
    </bmmn:parallelGateway>

    <!-- Cart Readiness -->
    <bpmn:sequenceFlow id="SFlow_WaiterStart" sourceRef="Tsk_GiveSommelierOrder" targetRef="Gw_NonAlcoholicCheck"/>
    
    <bpmn:exclusiveGateway id="Gw_NonAlcWaiter5">
      <bmmn:name>Non-Alcohol Needed?</bmmn:name>
      <bpmn:incoming>SFlow_WaiterStart</bpmn:incoming>
      <bpmn:outgoing>SFlow_ReadyCart_Always</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Cart Readiness -->
    <bmmn:sequenceFlow id="SFlow_WaiterStart" sourceRef="Tsk_GiveSommelierOrder" targetRef="Gw_NonAlcoholicCheck"/>
    
    <bpmn:parallelGateway id="Gw_ParallelWaiterTasks6">
      <bpmn:name>Parallel Waiter Tasks</bpmn:name>
      <bmmn:incoming>SFlow_WaiterStart</bmmn:incoming>
      <bpmn:outgoing>SFlow_ReadyCart_Always</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Cart Readiness -->
    <bpmn:sequenceFlow id="SFlow_WaiterStart" sourceRef="Tsk_GiveSommelierOrder" targetRef="Gw_NonAlcoholicCheck"/>
    
    <bmmn:exclusiveGateway id="Gw_NonAlcWaiter6">
      <bpmn:name>Non-Alcohol Needed?</bpmn:name>
      <bpmn:incoming>SFlow_WaiterStart</bpmn:incoming>
      <bpmn:outgoing>SFlow_ReadyCart_Always</bmmn:outgoing>
    </bmmn:exclusiveGateway>

    <!-- Cart Readiness -->
    <bpmn:sequenceFlow id="SFlow_WaiterStart" sourceRef="Tsk_GiveSommelierOrder" targetRef="Gw_NonAlcoholicCheck"/>
    
    <bmmn:parallelGateway id="Gw_ParallelWaiterTasks7">
      <bpmn:name>Parallel Waiter Tasks</bpmn:name>
      <bpmn:incoming>SFlow_WaiterStart</bpmn:incoming>
      <bpmn:outgoing>SFlow_ReadyCart_Always</bmmn:outgoing>
    </bmmn:parallelGateway>

    <!-- Cart Readiness -->
    <bpmn:sequenceFlow id="SFlow_WaiterStart" sourceRef="Tsk_GiveSommelierOrder" targetRef="Gw_NonAlcoholicCheck"/>
    
    <bmmn:exclusiveGateway id="Gw_NonAlcWaiter7">
      <bpmn:name>Non-Alcohol Needed?</bpmn:name>
      <bpmn:incoming>SFlow_WaiterStart</bpmn:incoming>
      <bpmn:outgoing>SFlow_ReadyCart_Always</bmmn:outgoing>
    </bmmn:exclusiveGateway>

    <!-- Cart Readiness -->
    <bpmn:sequenceFlow id="SFlow_WaiterStart" sourceRef="Tsk_GiveSommelierOrder" targetRef="Gw_NonAlcoholicCheck"/>
    
    <bmmn:parallelGateway id="Gw_ParallelWaiterTasks8">
      <bpmn:name>Parallel Waiter Tasks</bpmn:name>
      <bpmn:incoming>SFlow_WaiterStart</bpmn:incoming>
      <bpmn:outgoing>SFlow_ReadyCart_Always</bmmn:outgoing>
    </bmmn:parallelGateway>

    <!-- Cart Readiness -->
    <bpmn:sequenceFlow id="SFlow_WaiterStart" sourceRef="Tsk_GiveSommelierOrder" targetRef="Gw_NonAlcoholicCheck"/>
    
    <bmmn:exclusiveGateway id="Gw_NonAlcWaiter8">
      <bpmn:name>Non-Alcohol Needed?</bpmn:name>
      <bpmn:incoming>SFlow_WaiterStart</bpmn:incoming>
      <bpmn:outgoing>SFlow_ReadyCart_Always</bmmn:outgoing>
    </bmmn:exclusiveGateway>

    <!-- Cart Readiness -->
    <bpmn:sequenceFlow id="SFlow_WaiterStart" sourceRef="Tsk_GiveSommelierOrder" targetRef="Gw_NonAlcoholicCheck"/>
    
    <bmmn:parallelGateway id="Gw_ParallelWaiterTasks9">
      <bpmn:name>Parallel Waiter Tasks</bpmn:name>
      <bpmn:incoming>SFlow_WaiterStart</bpmn:incoming>
      <bpmn:outgoing>SFlow_ReadyCart_Always</bmmn:outgoing>
    </bmmn:parallelGateway>

    <!-- Cart Readiness -->
    <bpmn:sequenceFlow id="SFlow_WaiterStart" sourceRef="Tsk_GiveSommelierOrder" targetRef="Gw_NonAlcoholicCheck"/>
    
    <bmmn:exclusiveGateway id="Gw_NonAlcWaiter9">
      <bpmn:name>Non-Alcohol Needed?</bpmn:name>
      <bpmn:incoming>SFlow_WaiterStart</bpmn:incoming>
      <bpmn:outgoing>SFlow_ReadyCart_Always</bmmn:outgoing>
    </bmmn:exclusiveGateway>

    <!-- Cart Readiness -->
    <bpmn:sequenceFlow id="SFlow_WaiterStart" sourceRef="Tsk_GiveSommelierOrder" targetRef="Gw_NonAlcoholicCheck"/>
    
    <bmmn:parallelGateway id="Gw_ParallelWaiterTasks10">
      <bpmn:name>Parallel Waiter Tasks</bpmn:name>
      <bpmn:incoming>SFlow_WaiterStart</bpmn:incoming>
      <bpmn:outgoing>SFlow_ReadyCart_Always</bmmn:outgoing>
    </bmmn:parallelGateway>

    <!-- Cart Readiness -->
    <bpmn:sequenceFlow id="SFlow_WaiterStart" sourceRef="Tsk_GiveSommelierOrder" targetRef="Gw_NonAlcoholicCheck"/>
    
    <bmmn:exclusiveGateway id="Gw_NonAlcWaiter10">
      <bpmn:name>Non-Alcohol Needed?</bpmn:name>
      <bpmn:incoming>SFlow_WaiterStart</bpmn:incoming>
      <bpmn:outgoing>SFlow_ReadyCart_Always</bmmn:outgoing>
    </bmmn:exclusiveGateway>

    <!-- Cart Readiness -->
    <bpmn:sequenceFlow id="SFlow_WaiterStart" sourceRef="Tsk_GiveSommelierOrder" targetRef="Gw_NonAlcoholicCheck"/>
    
    <bmmn:parallelGateway id="Gw_ParallelWaiterTasks11">
      <bpmn:name>Parallel Waiter Tasks</bpmn:name>
      <bpmn:incoming>SFlow_WaiterStart</bpmn:incoming>
      <bpmn:outgoing>SFlow_ReadyCart_Always</bmmn:outgoing>
    </bmmn:parallelGateway>

    <!-- Cart Readiness -->
    <bpmn:sequenceFlow id="SFlow_WaiterStart" sourceRef="Tsk_GiveSommelierOrder" targetRef="Gw_NonAlcoholicCheck"/>
    
    <bmmn:exclusiveGateway id="Gw_NonAlcWaiter11">
      <bpmn:name>Non-Alcohol Needed?</bpmn:name>
      <bpmn:incoming>SFlow_WaiterStart</bpmn:incoming>
      <bpmn:outgoing>SFlow_ReadyCart_Always</bmmn:outgoing>
    </bmmn:exclusiveGateway>

    <!-- Cart Readiness -->
    <bpmn:sequenceFlow id="SFlow_WaiterStart" sourceRef="Tsk_GiveSommelierOrder" targetRef="Gw_NonAlcoholicCheck"/>
    
    <bmmn:parallelGateway id="Gw_ParallelWaiterTasks12">
      <bpmn:name>Parallel Waiter Tasks</bpmn:name>
      <bpmn:incoming>SFlow_WaiterStart</bpmn:incoming>
      <bpmn:outgoing>SFlow_ReadyCart_Always</bmmn:outgoing>
    </bmmn:parallelGateway>

    <!-- Cart Readiness -->
    <bpmn:sequenceFlow id="SFlow_WaiterStart" sourceRef="Tsk_GiveSommelierOrder" targetRef="Gw_NonAlcoholicCheck"/>
    
    <bmmn:exclusiveGateway id="Gw_NonAlcWaiter12">
      <bpmn:name>Non-Alcohol Needed?</bpmn:name>
      <bpmn:incoming>SFlow_WaiterStart</bpmm:incoming>
      <bpmn:outgoing>SFlow_ReadyCart_Always</bmmn:outgoing>
    </bmmn:exclusiveGateway>

    <!-- Cart Readiness -->
    <bpmn:sequenceFlow id="SFlow_WaiterStart" sourceRef="Tsk_GiveSommelierOrder" targetRef="Gw_NonAlcoholicCheck"/>
    
    <bmmn:parallelGateway id="Gw_ParallelWaiterTasks13">
      <bpmn:name>Parallel Waiter Tasks</bpmn:name>
      <bpmn:incoming>SFlow_WaiterStart</bpmm:incoming>
      <bpmn:outgoing>SFlow_ReadyCart_Always</bmmn:outgoing>
    </bmmn:parallelGateway>

    <!-- Cart Readiness -->
    <bpmn:sequenceFlow id="SFlow_WaiterStart" sourceRef="Tsk_GiveSommelierOrder" targetRef="Gw_NonAlcoholicCheck"/>
    
    <bmmn:exclusiveGateway id="Gw_NonAlcWaiter13">
      <bpmn:name>Non-Alcohol Needed?</bpmn:name>
      <bpmn:incoming>SFlow_WaiterStart</bpmm:incoming>
      <bpmn:outgoing>SFlow_ReadyCart_Always</bmmn:outgoing>
    </bmmn:exclusiveGateway>

    <!-- Cart Readiness -->
    <bpmn:sequenceFlow id="SFlow_WaiterStart" sourceRef="Tsk_GiveSommelierOrder" targetRef="Gw_NonAlcoholicCheck"/>
    
    <bmmn:parallelGateway id="Gw_ParallelWaiterTasks14">
      <bpmn:name>Parallel Waiter Tasks</bpmn:name>
      <bpmn:incoming>SFlow_WaiterStart</bpmm:incoming>
      <bpmn:outgoing>SFlow_ReadyCart_Always</bmmn:outgoing>
    </bmmn:parallelGateway>

    <!-- Cart Readiness -->
