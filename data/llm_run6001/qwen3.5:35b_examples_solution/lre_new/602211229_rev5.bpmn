<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="_ReimbursementProcess_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_Reimb_001">
    <bpmn:participant id="Participant_ERICS_001" name="ERICS Company" processRef="_Process_Reimbursement_001" />
    <bpmn:participant id="Participant_Customer_002" name="Customer" />
  </bpmn:collaboration>

  <bpmn:process id="_Process_Reimbursement_001" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Administration_001" name="Administration">
        <bpmn:flowNodeRef>_StartEvent_RequestReceived_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Task_CreateContract_002</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Task_SelectBeneficiary_003</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Task_DetermineDuration_004</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_ExclusiveGateway_CheckVerband_005</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Task_SelectAssociation_006</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Task_ManualSelection_007</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_InclusiveGateway_MergePaths_008</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Task_SetThresholds_009</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_CatchEvent_PeriodEnd_010</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_ParallelGateway_SplitTasks_011</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Task_PrintCreditNote_012</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_ThrowEvent_SendNotification_013</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_ParallelGateway_MergeEnds_014</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Task_CalculateReimbursement_015</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Task_PayReimbursement_016</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_EndEvent_ProcessEnded_017</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="_StartEvent_RequestReceived_001" name="Reimbursement Request Received">
      <bpmn:messageEventDefinition />
      <bpmn:outgoing>_SequenceFlow_StartToContract_020</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Tasks -->
    <bpmn:task id="_Task_CreateContract_002" name="Create Reimbursement Contract">
      <bpmn:incoming>_SequenceFlow_StartToContract_020</bpmn:incoming>
      <bpmn:outgoing>_SequenceFlow_ContractToBeneficiary_021</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="_Task_SelectBeneficiary_003" name="Select Beneficiary">
      <bpmn:incoming>_SequenceFlow_ContractToBeneficiary_021</bpmn:incoming>
      <bpmn:outgoing>_SequenceFlow_BeneficiaryToDuration_022</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="_Task_DetermineDuration_004" name="Determine Refund Period &amp; Contract Duration">
      <bpmn:incoming>_SequenceFlow_BeneficiaryToDuration_022</bpmn:incoming>
      <bpmn:outgoing>_SequenceFlow_DurationToVerbandCheck_023</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1 -->
    <bpmn:exclusiveGateway id="_ExclusiveGateway_CheckVerband_005" name="Customer part of Verband?">
      <bpmn:incoming>_SequenceFlow_DurationToVerbandCheck_023</bpmn:incoming>
      <bpmn:outgoing>_SequenceFlow_VerbandYes_TaskAssoc_024</bpmn:outgoing>
      <bpmn:outgoing>_SequenceFlow_VerbandNo_ManualSel_025</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Tasks for Decision Paths -->
    <bpmn:task id="_Task_SelectAssociation_006" name="Select Association as Customer Group">
      <bpmn:incoming>_SequenceFlow_VerbandYes_TaskAssoc_024</bpmn:incoming>
      <bpmn:outgoing>_SequenceFlow_AssocToMerge_026</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="_Task_ManualSelection_007" name="Select Customers Manually">
      <bpmn:incoming>_SequenceFlow_VerbandNo_ManualSel_025</bpmn:incoming>
      <bpmn:outgoing>_SequenceFlow_ManualToMerge_027</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2 (Merge) -->
    <bpmn:inclusiveGateway id="_InclusiveGateway_MergePaths_008">
      <bpmn:incoming>_SequenceFlow_AssocToMerge_026</bpmn:incoming>
      <bpmn:incoming>_SequenceFlow_ManualToMerge_027</bpmn:incoming>
      <bpmn:outgoing>_SequenceFlow_MergeToThresholds_028</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Task Threshold -->
    <bpmn:task id="_Task_SetThresholds_009" name="Set Thresholds">
      <bpmn:incoming>_SequenceFlow_MergeToThresholds_028</bpmn:incoming>
      <bpmn:outgoing>_SequenceFlow_ThresholdsToTimer_029</bpmn:outgoing>
    </bpmn:task>

    <!-- Timer Catch Event -->
    <bpmn:intermediateCatchEvent id="_CatchEvent_PeriodEnd_010" name="Refund Period Ended">
      <bpmn:incoming>_SequenceFlow_ThresholdsToTimer_029</bpmn:incoming>
      <bpmn:outgoing>_SequenceFlow_TimerToParallelSplit_030</bpmn:outgoing>
      <bpmn:timerEventDefinition />
    </bpmn:intermediateCatchEvent>

    <!-- Parallel Gateway Split -->
    <bpmn:parallelGateway id="_ParallelGateway_SplitTasks_011">
      <bpmn:incoming>_SequenceFlow_TimerToParallelSplit_030</bpmn:incoming>
      <bpmn:outgoing>_SequenceFlow_ParallelPrintNote_031</bpmn:outgoing>
      <bpmn:outgoing>_SequenceFlow_ParallelCalcPay_032</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Branch 1 -->
    <bpmn:task id="_Task_PrintCreditNote_012" name="Print Credit Note">
      <bpmn:incoming>_SequenceFlow_ParallelPrintNote_031</bpmn:incoming>
      <bpmn:outgoing>_SequenceFlow_NoteToMessageSend_033</bpmn:outgoing>
    </bpmn:task>

    <!-- Message Throw Event -->
    <bpmn:message id="Msg_CreditNoteSent" name="Credit Note Sent" />
    
    <bpmn:intermediateThrowEvent id="_ThrowEvent_SendNotification_013">
      <bpmn:incoming>_SequenceFlow_NoteToMessageSend_033</bpmn:incoming>
      <bpmn:messageEventDefinition messageRef="Msg_CreditNoteSent" />
    </bpmn:intermediateThrowEvent>

    <!-- Branch 2 -->
    <bpmn:task id="_Task_CalculateReimbursement_015" name="Calculate Reimbursement">
      <bpmn:incoming>_SequenceFlow_ParallelCalcPay_032</bpmn:incoming>
      <bpmn:outgoing>_SequenceFlow_CalcToPay_034</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="_Task_PayReimbursement_016" name="Pay Reimbursement">
      <bpmn:incoming>_SequenceFlow_CalcToPay_034</bpmn:incoming>
      <bpmn:outgoing>_SequenceFlow_PayToEndMerge_035</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway Merge -->
    <bpmn:parallelGateway id="_ParallelGateway_MergeEnds_014">
      <bpmn:incoming>_SequenceFlow_PayToEndMerge_035</bpmn:incoming>
      <bpmn:outgoing>_SequenceFlow_SendToFinalEvent_036</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- End Event -->
    <bpmn:endEvent id="_EndEvent_ProcessEnded_017" name="Process Ended">
      <bpmn:incoming>_SequenceFlow_SendToFinalEvent_036</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="_SequenceFlow_StartToContract_020" sourceRef="_StartEvent_RequestReceived_001" targetRef="_Task_CreateContract_002" />
    <bpmn:sequenceFlow id="_SequenceFlow_ContractToBeneficiary_021" sourceRef="_Task_CreateContract_002" targetRef="_Task_SelectBeneficiary_003" />
    <bpmn:sequenceFlow id="_SequenceFlow_BeneficiaryToDuration_022" sourceRef="_Task_SelectBeneficiary_003" targetRef="_Task_DetermineDuration_004" />
    <bpmn:sequenceFlow id="_SequenceFlow_DurationToVerbandCheck_023" sourceRef="_Task_DetermineDuration_004" targetRef="_ExclusiveGateway_CheckVerband_005" />
    
    <!-- Decision Paths -->
    <bpmn:sequenceFlow id="_SequenceFlow_VerbandYes_TaskAssoc_024" name="Customer part of Verband" sourceRef="_ExclusiveGateway_CheckVerband_005" targetRef="_Task_SelectAssociation_006" />
    <bpmn:sequenceFlow id="_SequenceFlow_VerbandNo_ManualSel_025" name="Normal subsidiaries" sourceRef="_ExclusiveGateway_CheckVerband_005" targetRef="_Task_ManualSelection_007" />

    <!-- Merge Paths -->
    <bpmn:sequenceFlow id="_SequenceFlow_AssocToMerge_026" sourceRef="_Task_SelectAssociation_006" targetRef="_InclusiveGateway_MergePaths_008" />
    <bpmn:sequenceFlow id="_SequenceFlow_ManualToMerge_027" sourceRef="_Task_ManualSelection_007" targetRef="_InclusiveGateway_MergePaths_008" />

    <!-- Thresholds to Timer -->
    <bpmn:sequenceFlow id="_SequenceFlow_MergeToThresholds_028" sourceRef="_InclusiveGateway_MergePaths_008" targetRef="_Task_SetThresholds_009" />
    <bpmn:sequenceFlow id="_SequenceFlow_ThresholdsToTimer_029" sourceRef="_Task_SetThresholds_009" targetRef="_CatchEvent_PeriodEnd_010" />

    <!-- Timer to Split -->
    <bpmn:sequenceFlow id="_SequenceFlow_TimerToParallelSplit_030" sourceRef="_CatchEvent_PeriodEnd_010" targetRef="_ParallelGateway_SplitTasks_011" />

    <!-- Parallel Branches Start -->
    <bpmn:sequenceFlow id="_SequenceFlow_ParallelPrintNote_031" sourceRef="_ParallelGateway_SplitTasks_011" targetRef="_Task_PrintCreditNote_012" />
    <bpmn:sequenceFlow id="_SequenceFlow_NoteToMessageSend_033" sourceRef="_Task_PrintCreditNote_012" targetRef="_ThrowEvent_SendNotification_013" />

    <!-- Parallel Branch 2 -->
    <bpmn:sequenceFlow id="_SequenceFlow_ParallelCalcPay_032" sourceRef="_ParallelGateway_SplitTasks_011" targetRef="_Task_CalculateReimbursement_015" />
    <bpmn:sequenceFlow id="_SequenceFlow_CalcToPay_034" sourceRef="_Task_CalculateReimbursement_015" targetRef="_Task_PayReimbursement_016" />

    <!-- Merge to End -->
    <bpmn:sequenceFlow id="_SequenceFlow_SendToFinalEvent_036" name="Notification Sent &amp; Payment Made" sourceRef="_ThrowEvent_SendNotification_013" targetRef="_ParallelGateway_MergeEnds_014">
      <!-- Note: In strict BPMN, Throw Events don't block flow unless correlated. 
           For valid XML structure merging logic here, we connect the throw event to the merge gateway via sequenceFlow -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="_SequenceFlow_PayToEndMerge_035" sourceRef="_Task_PayReimbursement_016" targetRef="_ParallelGateway_MergeEnds_014" />

  </bpmn:process>
</bpmn:definitions>