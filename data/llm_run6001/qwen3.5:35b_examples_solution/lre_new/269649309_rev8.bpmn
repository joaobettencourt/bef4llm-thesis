<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="_BagHandlingProcessDefinition_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_BagHandling_001">
    <bpmn:participant id="Participant_CVS_001" name="CVS" processRef="Process_BagHandling_001" />
  </bpmn:collaboration>

  <bpmn:process id="Process_BagHandling_001" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_NotCollectedBag_001" name="Not collected bag identified&#10;">
      <bpmn:outgoing>SequenceFlow_StartToCheckRetries_001</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1 -->
    <bpmn:task id="Task_CheckRetries_001" name="Check number of resolution retries conducted&#10;">
      <bpmn:incoming>SequenceFlow_StartToCheckRetries_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RetriesToGateway1_001</bpmn:outgoing>
      <bpmn:dataInputAssociation id="DataInAssoc_CheckRetries_001">
        <bpmn:sourceRef>DataObjectRetryCountLabel_001</bpmn:sourceRef>
        <bpmn:targetRef>Property_RetryCheck_Input_001</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>

    <!-- Gateway 1 -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_CheckLimit_001" default="SequenceFlow_Gateway1ToContact_001">
      <bpmn:incoming>SequenceFlow_RetriesToGateway1_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Gateway1ToDisassemble_001</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 2 -->
    <bpmn:task id="Task_ContactCustomer_001" name="Try to contact customer by phone&#10;">
      <bpmn:incoming>SequenceFlow_Gateway1ToContact_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ContactToGateway2_001</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2 -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_OutcomeCheck_001">
      <bpmn:incoming>SequenceFlow_ContactToGateway2_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Gateway2ToDisassemble_001</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 3 (Disassemble) -->
    <bpmn:task id="Task_DisassembleBag_001" name="Return to production area for disassemble&#10;">
      <bpmn:incoming>SequenceFlow_Gateway1ToDisassemble_001</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_Gateway2ToDisassemble_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DisassembleToEndJoin_001</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 4 (Increase Count) -->
    <bpmn:task id="Task_IncreaseRetryCount_001" name="Increase retry count on bag label&#10;">
      <bpmn:incoming>SequenceFlow_Gateway2ToIncreaseCount_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_IncreaseToEndJoin_001</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutAssoc_IncreaseRetry_001">
        <bpmn:sourceRef>Property_RetryUpdate_Output_001</bpmn:sourceRef>
        <bpmn:targetRef>DataObjectRetryCountLabel_001</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>

    <!-- Join Gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_JoinEnd_001">
      <bpmn:incoming>SequenceFlow_DisassembleToEndJoin_001</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_IncreaseToEndJoin_001</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_BagHandled_001" name="Not collected bag managed&#10;">
      <bpmn:incoming>SequenceFlow_JoinToEndEvent_001</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Data Objects -->
    <bpmn:dataObject id="DataObjectRetryCountLabel_001" name="Retry count label on bag&#10;" />

    <!-- Sequence Flows with Conditions (Implicit via Gateway logic or Names) -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToCheckRetries_001" sourceRef="StartEvent_NotCollectedBag_001" targetRef="Task_CheckRetries_001" />

    <!-- Condition for Path 1 (retries > X) -->
    <bpmn:sequenceFlow id="SequenceFlow_Gateway1ToDisassemble_001" name="retries # &#62; specified number&#10;" sourceRef="ExclusiveGateway_CheckLimit_001" targetRef="Task_DisassembleBag_001">
      <!-- Condition expression would typically be here in full implementation -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_Gateway1ToContact_001" sourceRef="ExclusiveGateway_CheckLimit_001" targetRef="Task_ContactCustomer_001" />

    <!-- Condition for Path A (Withdrawn) -->
    <bpmn:sequenceFlow id="SequenceFlow_Gateway2ToDisassemble_001" name="contact successful, customer withdrawn the order&#10;" sourceRef="ExclusiveGateway_OutcomeCheck_001" targetRef="Task_DisassembleBag_001">
      <!-- Condition expression would typically be here in full implementation -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_Gateway2ToIncreaseCount_001" name="contact successful, customer promised to pick-up&#10; or contact unsuccessful&#10;" sourceRef="ExclusiveGateway_OutcomeCheck_001" targetRef="Task_IncreaseRetryCount_001">
      <!-- Condition expression would typically be here in full implementation -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_DisassembleToEndJoin_001" sourceRef="Task_DisassembleBag_001" targetRef="ExclusiveGateway_JoinEnd_001" />

    <!-- Property Placeholders for Data Associations (inside tasks) -->
    <bpmn:task id="Property_RetryCheck_Input_Task_001">
      <bpmn:property id="Property_RetryCheck_Input_001" name="__targetRef_placeholder" />
    </bpmn:task>

    <!-- Property Placeholders for Data Associations (inside tasks) -->
    <bpmn:task id="Property_RetryUpdate_Output_Task_001">
      <bpmn:property id="Property_RetryUpdate_Output_001" name="__sourceRef_placeholder" />
    </bpmn:task>

  </bpmn:process>
</bpmn:definitions>