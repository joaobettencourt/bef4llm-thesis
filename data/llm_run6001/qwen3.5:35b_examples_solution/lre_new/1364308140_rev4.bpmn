<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="_SO_Process_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_SO_001">
    <bpmn:participant id="Participant_SO_Main_001" name="SO: Angebot/Auftrag" processRef="Process_SO_001" />
    <bpmn:participant id="Participant_AddressMgmt_002" name="SO: Address-Management" processRef="Process_AddressMgmt_002" />
  </bpmn:collaboration>

  <bpmn:process id="Process_SO_001" isExecutable="false">
    <bpmn:startEvent id="StartEvent_SubOrderReceived_001" name="Subsidiary Order Received">
      <bpmn:outgoing>SequenceFlow_StartToParallelSplit_001</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:parallelGateway id="ParallelGateway_Split_001">
      <bpmn:incoming>SequenceFlow_StartToParallelSplit_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToPrepareGoods_001</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ToPrepareInvoicing_002</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:task id="Task_PrepareGoods_001" name="Prepare goods for shipment">
      <bpmn:incoming>SequenceFlow_ToPrepareGoods_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GoodsToShip_002</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_ShipGoods_003" name="Ship goods">
      <bpmn:incoming>SequenceFlow_GoodsToShip_002</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ShipToMerge_004</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="ExclusiveGateway_CustomerType_001">
      <bpmn:incoming>SequenceFlow_InvoicingDecisionPoint_003</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_IsSubsidiaryYes_005</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_IsIndependentOrModeled_006</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_PrepareInvoicing_002" name="Prepare invoicing">
      <bpmn:incoming>SequenceFlow_ToPrepareInvoicing_002</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InvoicingDecisionPoint_003</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="ExclusiveGateway_RelationshipModeled_002">
      <bpmn:incoming>SequenceFlow_IsSubsidiaryYes_005</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AlreadyModeled_007</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NotYetModeled_008</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_AddParentAddress_003" name="Add parent company as invoicing address">
      <bpmn:incoming>SequenceFlow_NotYetModeled_008</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AddressToMerge_009</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="ExclusiveGateway_MergeBeforeInvoice_003">
      <bpmn:incoming>SequenceFlow_AlreadyModeled_007</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_IsIndependentOrModeled_006</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_AddressToMerge_009</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToCreateInvoice_010</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_CreateInvoice_004" name="Create invoice">
      <bpmn:incoming>SequenceFlow_ToCreateInvoice_010</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InvoiceToMerge_011</bpmn:outgoing>
    </bpmn:task>

    <bpmn:parallelGateway id="ParallelGateway_MergeBeforeEnd_004">
      <bpmn:incoming>SequenceFlow_ShipToMerge_004</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_InvoiceToMerge_011</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToEndEvent_012</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:endEvent id="EndEvent_ShipmentComplete_005" name="Invoice Sent">
      <bpmn:incoming>SequenceFlow_ToEndEvent_012</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToParallelSplit_001" sourceRef="StartEvent_SubOrderReceived_001" targetRef="ParallelGateway_Split_001" />
    <bpmn:sequenceFlow id="SequenceFlow_ToPrepareGoods_001" name="Ship goods path" sourceRef="ParallelGateway_Split_001" targetRef="Task_PrepareGoods_001" />
    <bpmn:sequenceFlow id="SequenceFlow_GoodsToShip_002" sourceRef="Task_PrepareGoods_001" targetRef="Task_ShipGoods_003" />
    <bpmn:sequenceFlow id="SequenceFlow_ToPrepareInvoicing_002" name="Invoice path" sourceRef="ParallelGateway_Split_001" targetRef="Task_PrepareInvoicing_002" />
    <bpmn:sequenceFlow id="SequenceFlow_InvoicingDecisionPoint_003" sourceRef="Task_PrepareInvoicing_002" targetRef="ExclusiveGateway_CustomerType_001" name="Customer type check" />
    <bpmn:sequenceFlow id="SequenceFlow_IsSubsidiaryYes_005" name="Is subsidiary?" sourceRef="ExclusiveGateway_CustomerType_001" targetRef="ExclusiveGateway_RelationshipModeled_002" />
    <bpmn:sequenceFlow id="SequenceFlow_IsIndependentOrModeled_006" name="Customer independent or relationship modeled in ERP" sourceRef="ExclusiveGateway_CustomerType_001" targetRef="ExclusiveGateway_MergeBeforeInvoice_003" />
    <bpmn:sequenceFlow id="SequenceFlow_AlreadyModeled_007" name="Already modeled in ERP" sourceRef="ExclusiveGateway_RelationshipModeled_002" targetRef="ExclusiveGateway_MergeBeforeInvoice_003" />
    <bpmn:sequenceFlow id="SequenceFlow_NotYetModeled_008" name="Not yet modeled - add parent address" sourceRef="ExclusiveGateway_RelationshipModeled_002" targetRef="Task_AddParentAddress_003" />
    <bpmn:sequenceFlow id="SequenceFlow_AddressToMerge_009" sourceRef="Task_AddParentAddress_003" targetRef="ExclusiveGateway_MergeBeforeInvoice_003" />
    <bpmn:sequenceFlow id="SequenceFlow_ToCreateInvoice_010" name="Proceed to invoice creation" sourceRef="ExclusiveGateway_MergeBeforeInvoice_003" targetRef="Task_CreateInvoice_004" />
    <bpmn:sequenceFlow id="SequenceFlow_InvoiceToMerge_011" sourceRef="Task_CreateInvoice_004" targetRef="ParallelGateway_MergeBeforeEnd_004" name="Create invoice complete" />
    <bpmn:sequenceFlow id="SequenceFlow_ShipToMerge_004" sourceRef="Task_ShipGoods_003" targetRef="ParallelGateway_MergeBeforeEnd_004" name="Ship goods complete" />
    <bpmn:sequenceFlow id="SequenceFlow_ToEndEvent_012" sourceRef="ParallelGateway_MergeBeforeEnd_004" targetRef="EndEvent_ShipmentComplete_005" name="All paths merged - process ends" />

  </bpmn:process>
</bpmn:definitions>