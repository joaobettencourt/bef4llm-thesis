<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="_PurchaseProcess_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_Purchase_001">
    <bpmn:participant id="Participant_ACME_Inc_001" name="ACME Inc. Purchase Process" processRef="Process_Purchase_001" />
  </bpmn:collaboration>

  <bpmn:process id="Process_Purchase_001" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Department_001" name="Department">
        <bpmn:flowNodeRef>StartEvent_DemandIdentified_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CheckStock_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConsumeFromStock_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_LocalConsumption_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SpecifyDemandAndRequisition_001</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CentralProcurement_002" name="Central procurement department">
        <bpmn:flowNodeRef>Task_CheckSupplierInfo_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SupplierAvailable_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateNewSupplier_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MergeSuppliers_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateOrderTemplate_001</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Approver_003" name="Approver">
        <bpmn:flowNodeRef>Task_ApproveAndTriggerOrder_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_OrderTriggered_002</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_DemandIdentified_001" name="Demand identified">
      <bpmn:outgoing>SequenceFlow_StartToStockCheck_001</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Gateway 1: Stock Check -->
    <bpmn:exclusiveGateway id="Gateway_CheckStock_001">
      <bpmn:incoming>SequenceFlow_StartToStockCheck_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GoodsInStockPath_001</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoGoodsInStockPath_001</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 1: Consume from stock -->
    <bpmn:task id="Task_ConsumeFromStock_001" name="Consume goods from local stock">
      <bpmn:incoming>SequenceFlow_GoodsInStockPath_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_LocalConsumptionToEnd_001</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 1 -->
    <bpmn:endEvent id="EndEvent_LocalConsumption_001" name="No further action required">
      <bpmn:incoming>SequenceFlow_LocalConsumptionToEnd_001</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task 2: Specify Demand & Create Requisition -->
    <bpmn:task id="Task_SpecifyDemandAndRequisition_001" name="Specify demand and create purchase requisition">
      <bpmn:incoming>SequenceFlow_NoGoodsInStockPath_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RequisitionToProcurementCheck_001</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3: Check Supplier Info -->
    <bpmn:task id="Task_CheckSupplierInfo_001" name="Check supplier information in ERP">
      <bpmn:incoming>SequenceFlow_RequisitionToProcurementCheck_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SupplierCheckResultToGateway_001</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2: Supplier Available? -->
    <bpmn:exclusiveGateway id="Gateway_SupplierAvailable_001">
      <bpmn:incoming>SequenceFlow_SupplierCheckResultToGateway_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NewSupplierPath_001</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_KnownSupplierPath_001</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 4: Create New Supplier -->
    <bpmn:task id="Task_CreateNewSupplier_001" name="Create new supplier in ERP">
      <bpmn:incoming>SequenceFlow_NewSupplierPath_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SupplierCreatedToMerge_001</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 3: Merge Paths -->
    <bpmn:inclusiveGateway id="Gateway_MergeSuppliers_001">
      <bpmn:incoming>SequenceFlow_KnownSupplierPath_001</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_SupplierCreatedToMerge_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TemplateToApproval_001</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Task 5: Create Order Template -->
    <bpmn:task id="Task_CreateOrderTemplate_001" name="Create order template from purchase requisition">
      <bpmn:incoming>SequenceFlow_TemplateToApproval_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OrderTemplateToApprover_001</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 6: Approve and Trigger -->
    <bpmn:task id="Task_ApproveAndTriggerOrder_001" name="Approve and trigger purchase order">
      <bpmn:incoming>SequenceFlow_OrderTemplateToApprover_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ApprovalToFinalEnd_001</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 2 -->
    <bpmn:endEvent id="EndEvent_OrderTriggered_002" name="Purchase Order triggered">
      <bpmn:incoming>SequenceFlow_ApprovalToFinalEnd_001</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToStockCheck_001" sourceRef="StartEvent_DemandIdentified_001" targetRef="Gateway_CheckStock_001" />
    
    <bpmn:sequenceFlow id="SequenceFlow_GoodsInStockPath_001" name="Goods in stock?" sourceRef="Gateway_CheckStock_001" targetRef="Task_ConsumeFromStock_001" />
    
    <bpmn:sequenceFlow id="SequenceFlow_NoGoodsInStockPath_001" name="No goods in stock" sourceRef="Gateway_CheckStock_001" targetRef="Task_SpecifyDemandAndRequisition_001" />

    <bpmn:sequenceFlow id="SequenceFlow_RequisitionToProcurementCheck_001" sourceRef="Task_SpecifyDemandAndRequisition_001" targetRef="Task_CheckSupplierInfo_001" />
    
    <bpmn:sequenceFlow id="SequenceFlow_SupplierCheckResultToGateway_001" name="Check supplier info result" sourceRef="Task_CheckSupplierInfo_001" targetRef="Gateway_SupplierAvailable_001" />

    <bpmn:sequenceFlow id="SequenceFlow_NewSupplierPath_001" name="New Supplier?" sourceRef="Gateway_SupplierAvailable_001" targetRef="Task_CreateNewSupplier_001" />
    
    <bpmn:sequenceFlow id="SequenceFlow_KnownSupplierPath_001" name="Known Supplier" sourceRef="Gateway_SupplierAvailable_001" targetRef="Gateway_MergeSuppliers_001" />

    <bpmn:sequenceFlow id="SequenceFlow_SupplierCreatedToMerge_001" sourceRef="Task_CreateNewSupplier_001" targetRef="Gateway_MergeSuppliers_001" />
    
    <bpmn:sequenceFlow id="SequenceFlow_TemplateToApproval_001" name="Order Template Created" sourceRef="Gateway_MergeSuppliers_001" targetRef="Task_CreateOrderTemplate_001" />

    <bpmn:sequenceFlow id="SequenceFlow_OrderTemplateToApprover_001" sourceRef="Task_CreateOrderTemplate_001" targetRef="Task_ApproveAndTriggerOrder_001" />
    
    <bpmn:sequenceFlow id="SequenceFlow_ApprovalToFinalEnd_001" name="Purchase Order Triggered" sourceRef="Task_ApproveAndTriggerOrder_001" targetRef="EndEvent_OrderTriggered_002" />

  </bpmn:process>
</bpmn:definitions>