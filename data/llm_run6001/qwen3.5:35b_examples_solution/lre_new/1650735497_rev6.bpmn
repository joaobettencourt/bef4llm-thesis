<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_BankAccountAddition_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_BankAccount_001">
    <bpmn:participant id="Participant_PayPalSystem_001" name="PayPal System&#10;" processRef="Process_BankAddition_001" />
  </bpmn:collaboration>

  <bpmn:process id="Process_BankAddition_001" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Client_002" name="PayPal Client&#10;">
        <bpmn:flowNodeRef>StartEvent_OptionSelected_003</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterDetails_004</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ClickContinue_005</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateCatchEvent_DetailsReceived_012</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System_006" name="PayPal System&#10;">
        <bpmn:flowNodeRef>Task_MakeDeposits_007</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateThrowEvent_DepositInfo_008</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TimerCatch_Notification_009</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CompareValues_013</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_MatchCheck_014</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Confirmed_015</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_OptionSelected_003" name="Pay with bank account Payment option selected&#10;">
      <bpmn:outgoing>SequenceFlow_StartToEnterDetails_025</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1 -->
    <bpmn:task id="Task_EnterDetails_004" name="Enter Bank Details&#10;">
      <bpmn:incoming>SequenceFlow_StartToEnterDetails_025</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DetailsToContinue_026</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2 -->
    <bpmn:task id="Task_ClickContinue_005" name="Click Continue&#10;">
      <bpmn:incoming>SequenceFlow_DetailsToContinue_026</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConfirmSubmit_027</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Throw Event (Client Side) -->
    <bpmn:intermediateThrowEvent id="IntermediateThrowEvent_SubmitDetails_016" name="Submit Bank Details to System&#10;">
      <bpmn:incoming>SequenceFlow_ConfirmSubmit_027</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SystemReceiveStart_028</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>

    <!-- Intermediate Catch Event (System Side) -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_DetailsReceived_012" name="Bank Detail Submitted&#10;">
      <bpmn:incoming>SequenceFlow_SystemReceiveStart_028</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StartDeposits_029</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>

    <!-- Task 3 -->
    <bpmn:task id="Task_MakeDeposits_007" name="Make two random deposits in Bank Account&#10;">
      <bpmn:incoming>SequenceFlow_StartDeposits_029</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DepositInfoStart_030</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Throw Event (System Side) -->
    <bpmn:intermediateThrowEvent id="IntermediateThrowEvent_DepositInfo_008" name="Two deposits made to bank account&#10;">
      <bpmn:incoming>SequenceFlow_DepositInfoStart_030</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TimerWaitStart_031</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <!-- Timer Event -->
    <bpmn:timerCatch id="TimerCatch_Notification_009" name="After 3-5 working days&#10;">
      <bpmn:incoming>SequenceFlow_TimerWaitStart_031</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ClientCheckDeposits_032</bpmn:outgoing>
    </bpmn:timerCatch>

    <!-- Task 4 -->
    <bpmn:task id="Task_CompareValues_013" name="Compare values provided&#10;">
      <bpmn:incoming>SequenceFlow_ClientVerifySubmit_045</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GatewayCheckStart_046</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_MatchCheck_014">
      <bpmn:incoming>SequenceFlow_GatewayCheckStart_046</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_LinkAccountPath_047</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RemoveAccountPath_048</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 5 (Link) -->
    <bpmn:task id="Task_LinkDetails" name="Link Bank Details to Account&#10;">
      <bpmn:incoming>SequenceFlow_LinkAccountPath_047</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConfirmedEndStart_052</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 1 -->
    <bpmn:endEvent id="EndEvent_Confirmed_015" name="Bank account confirmed&#10;">
      <bpmn:incoming>SequenceFlow_ConfirmedEndStart_052</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task 6 (Remove) -->
    <bpmn:task id="Task_RemoveDetails" name="Remove bank account details from account&#10;">
      <bpmn:incoming>SequenceFlow_RemoveAccountPath_048</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_UnconfirmedEndStart_055</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 2 -->
    <bpmn:endEvent id="EndEvent_Unconfirmed" name="Bank account unconfirmed&#10;">
      <bpmn:incoming>SequenceFlow_UnconfirmedEndStart_055</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToEnterDetails_025" sourceRef="StartEvent_OptionSelected_003" targetRef="Task_EnterDetails_004" />
    <bpmn:sequenceFlow id="SequenceFlow_DetailsToContinue_026" name="First Name, Bank Name, Account Type, BSB and Account Number&#10;" sourceRef="Task_EnterDetails_004" targetRef="Task_ClickContinue_005" />
    <bpmn:sequenceFlow id="SequenceFlow_ConfirmSubmit_027" sourceRef="Task_ClickContinue_005" targetRef="IntermediateThrowEvent_SubmitDetails_016" />
    <bpmn:sequenceFlow id="SequenceFlow_SystemReceiveStart_028" name="" sourceRef="IntermediateThrowEvent_SubmitDetails_016" targetRef="IntermediateCatchEvent_DetailsReceived_012" />
    <bpmn:sequenceFlow id="SequenceFlow_StartDeposits_029" sourceRef="IntermediateCatchEvent_DetailsReceived_012" targetRef="Task_MakeDeposits_007" />
    <bpmn:sequenceFlow id="SequenceFlow_DepositInfoStart_030" name="" sourceRef="Task_MakeDeposits_007" targetRef="IntermediateThrowEvent_DepositInfo_008" />
    <bpmn:sequenceFlow id="SequenceFlow_TimerWaitStart_031" sourceRef="IntermediateThrowEvent_DepositInfo_008" targetRef="TimerCatch_Notification_009" />

    <!-- Client Side Tasks for Verification -->
    <bpmn:task id="Task_ClientCheckDeposits" name="Check deposits received in Bank Account&#10;">
      <bpmn:incoming>SequenceFlow_TimerWaitStartToClient_033</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ClientLoginPath_049</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_TimerWaitStartToClient_033" sourceRef="TimerCatch_Notification_009" targetRef="Task_ClientCheckDeposits" />

    <bpmn:task id="Task_ClientLoginPayPal" name="Log into PayPal account&#10;">
      <bpmn:incoming>SequenceFlow_ClientLoginPath_049</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EnterAmountsPath_050</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_ClientLoginPath_049" sourceRef="Task_ClientCheckDeposits" targetRef="Task_ClientLoginPayPal" />

    <bpmn:task id="Task_EnterAmountsVerify" name="Enter amounts of two deposits&#10;">
      <bpmn:incoming>SequenceFlow_EnterAmountsPath_050</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ClientClickVerify_051</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_EnterAmountsPath_050" sourceRef="Task_ClientLoginPayPal" targetRef="Task_EnterAmountsVerify" />

    <bpmn:task id="Task_ClickVerifyClient" name="Click Verify&#10;">
      <bpmn:incoming>SequenceFlow_ClientClickVerify_051</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ClientVerifySubmit_045</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_ClientClickVerify_051" sourceRef="Task_EnterAmountsVerify" targetRef="Task_ClickVerifyClient" />

    <!-- Back to System for Logic -->
    <bpmn:sequenceFlow id="SequenceFlow_ClientVerifySubmit_045" name="" sourceRef="Task_ClickVerifyClient" targetRef="Task_CompareValues_013" />

    <!-- Gateway Paths -->
    <bpmn:sequenceFlow id="SequenceFlow_GatewayCheckStart_046" sourceRef="Task_CompareValues_013" targetRef="ExclusiveGateway_MatchCheck_014" />

    <bpmn:sequenceFlow id="SequenceFlow_LinkAccountPath_047" name="Values match&#10;" sourceRef="ExclusiveGateway_MatchCheck_014" targetRef="Task_LinkDetails" />
    <bpmn:sequenceFlow id="SequenceFlow_ConfirmedEndStart_052" sourceRef="Task_LinkDetails" targetRef="EndEvent_Confirmed_015" />

    <bpmn:sequenceFlow id="SequenceFlow_RemoveAccountPath_048" name="Values do not match&#10;" sourceRef="ExclusiveGateway_MatchCheck_014" targetRef="Task_RemoveDetails" />
    <bpmn:sequenceFlow id="SequenceFlow_UnconfirmedEndStart_055" sourceRef="Task_RemoveDetails" targetRef="EndEvent_Unconfirmed" />

  </bpmn:process>
</bpmn:definitions>