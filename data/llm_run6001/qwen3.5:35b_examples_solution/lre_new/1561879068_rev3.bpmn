<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="_RegistrationProcess_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_Registration_001" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="Start_Event_VisitorFillForm" name="Visitor fills out Registration-Form&#10;">
      <bpmn:outgoing>SequenceFlow_StartToCheckProducts</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1 -->
    <bpmn:task id="Task_CheckProductAvailability" name="Check availability of products&#10;">
      <bpmn:incoming>SequenceFlow_StartToCheckProducts</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProductsToCreditRating</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2 -->
    <bpmn:task id="Task_CheckCreditRating" name="Check credit Rating at Schufa&#10;">
      <bpmn:incoming>SequenceFlow_ProductsToCreditRating</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CreditToGateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1 (Exclusive) -->
    <bpmn:exclusiveGateway id="Gateway_CheckSchufa" name="Credit Rating according to Schufa &#62; 9000&#10;">
      <bpmn:incoming>SequenceFlow_CreditToGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_UnsuccessfulPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SuccessfulPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event 1 -->
    <bpmn:endEvent id="End_Event_Unsuccessful" name="Unsuccessful customer registration&#10;">
      <bpmn:incoming>SequenceFlow_UnsuccessfulPath</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task 3 (Interim Record) -->
    <bpmn:task id="Task_CreateInterimRecord" name="Creating interim customer dataset record&#10;">
      <bpmn:incoming>SequenceFlow_SuccessfulPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RecordToSplitGateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2 (Parallel Split) -->
    <bpmn:parallelGateway id="ParallelGateway_Split" name="">
      <bpmn:incoming>SequenceFlow_RecordToSplitGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DeviceProvisionPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RegisterISPPart</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- SubProcess 1 -->
    <bpmn:subProcess id="SubProcess_DeviceProvision" name="Device provision process&#10;">
      <bpmn:incoming>SequenceFlow_DeviceProvisionPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DevProvToJoinGateway</bpmn:outgoing>
    </bpmn:subProcess>

    <!-- SubProcess 2 -->
    <bpmn:subProcess id="SubProcess_RegisterISP" name="Register customer account at ISP nodes&#10;">
      <bpmn:incoming>SequenceFlow_RegisterISPPart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ISPRegToJoinGateway</bpmn:outgoing>
    </bpmn:subProcess>

    <!-- Gateway 3 (Parallel Join) -->
    <bpmn:parallelGateway id="ParallelGateway_Join" name="">
      <bpmn:incoming>SequenceFlow_DevProvToJoinGateway</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ISPRegToJoinGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_JoinToWelcomePackage</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 4 (Welcome Package) -->
    <bpmn:task id="Task_WelcomePackage" name="Create and send Welcome-Package&#10;">
      <bpmn:incoming>SequenceFlow_JoinToWelcomePackage</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PackToSuccessEnd</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 2 -->
    <bpmn:endEvent id="End_Event_Successful" name="Successful customer registration&#10;">
      <bpmn:incoming>SequenceFlow_PackToSuccessEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows (Standard) -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToCheckProducts" sourceRef="Start_Event_VisitorFillForm" targetRef="Task_CheckProductAvailability" />
    <bpmn:sequenceFlow id="SequenceFlow_ProductsToCreditRating" sourceRef="Task_CheckProductAvailability" targetRef="Task_CheckCreditRating" />
    <bpmn:sequenceFlow id="SequenceFlow_CreditToGateway" sourceRef="Task_CheckCreditRating" targetRef="Gateway_CheckSchufa" />

    <!-- Condition Flows for Exclusive Gateway -->
    <bpmn:sequenceFlow id="SequenceFlow_UnsuccessfulPath" name="Unsuccessful (Score &gt; 9000)" sourceRef="Gateway_CheckSchufa" targetRef="End_Event_Unsuccessful">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${creditRating &amp;gt;= 9000}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_SuccessfulPath" name="Successful (Score &lt;= 9000)" sourceRef="Gateway_CheckSchufa" targetRef="Task_CreateInterimRecord">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${creditRating &amp;lt;= 9000}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Parallel Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_RecordToSplitGateway" sourceRef="Task_CreateInterimRecord" targetRef="ParallelGateway_Split" />

    <bpmn:sequenceFlow id="SequenceFlow_DeviceProvisionPath" sourceRef="ParallelGateway_Split" targetRef="SubProcess_DeviceProvision" />
    <bpmn:sequenceFlow id="SequenceFlow_RegisterISPPart" sourceRef="ParallelGateway_Split" targetRef="SubProcess_RegisterISP" />

    <!-- Join Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_DevProvToJoinGateway" sourceRef="SubProcess_DeviceProvision" targetRef="ParallelGateway_Join" />
    <bpmn:sequenceFlow id="SequenceFlow_ISPRegToJoinGateway" sourceRef="SubProcess_RegisterISP" targetRef="ParallelGateway_Join" />

    <!-- Final Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_JoinToWelcomePackage" sourceRef="ParallelGateway_Join" targetRef="Task_WelcomePackage" />
    <bpmn:sequenceFlow id="SequenceFlow_PackToSuccessEnd" sourceRef="Task_WelcomePackage" targetRef="End_Event_Successful" />

  </bpmn:process>
</bpmn:definitions>