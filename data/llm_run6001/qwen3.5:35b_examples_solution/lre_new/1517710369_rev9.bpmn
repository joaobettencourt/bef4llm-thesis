<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_CreditCard_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_AddCreditCard_001">
    <bpmn:participant id="Participant_UserProcess_001" name="Add Credit Card Process" processRef="Process_CreditCard_001" />
    <bpmn:participant id="Participant_CCAuthority_002" name="Credit Card Authority" />
    <bpmn:messageFlow id="MessageFlow_VerifyRequest_001" sourceRef="IntermediateThrowEvent_VerifyCC_001" targetRef="Participant_CCAuthority_002" />
    <bpmn:messageFlow id="MessageFlow_VerifyResponse_002" sourceRef="Participant_CCAuthority_002" targetRef="IntermediateCatchEvent_VerifyResult_001" />
  </bpmn:collaboration>

  <bpmn:process id="Process_CreditCard_001" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_UserActions_001" name="User Actions">
        <bpmn:flowNodeRef>StartEvent_ProcessStarted_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterCardDetails_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_BillingCheck_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ModifyBillingAddress_002</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_ProceedDecision_002</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ClickContinue_003</bpmn:flowNodeRef>
      </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_ProcessStarted_001" name="Process Started">
      <bpmn:outgoing>SequenceFlow_StartToEnterDetails_001</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1 -->
    <bpmn:task id="Task_EnterCardDetails_001" name="Enter Credit Card Details">
      <bpmn:incoming>SequenceFlow_StartToEnterDetails_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DetailsToBillingCheck_002</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3 -->
    <bpmn:task id="Task_ClickContinue_003" name="Click Continue Button">
      <bpmn:incoming>SequenceFlow_ProceedToContinue_005</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ConfirmToVerifyCC_006</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1 -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_BillingCheck_001">
      <bpmn:incoming>SequenceFlow_DetailsToBillingCheck_002</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AddressCorrectPath_003</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_AddressIncorrectLoopback_004</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 2 -->
    <bpmn:task id="Task_ModifyBillingAddress_002" name="Modify Billing Address">
      <bpmn:incoming>SequenceFlow_AddressIncorrectLoopback_004</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ProceedToContinue_005</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2 -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_ProceedDecision_002">
      <bpmn:incoming>SequenceFlow_ModifiedToProceedDecision_005</bpmn:outgoing>
      <bpmn:incomming>SequenceFlow_AddressCorrectPath_003</bmm:bmpm:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Intermediate Throw Event -->
    <bpmn:intermediateThrowEvent id="IntermediateThrowEvent_VerifyCC_001" name="Verify Credit Card">
      <bpmn:messageEventDefinition />
      <bmm:bmpm:incoming>SequenceFlow_ConfirmToVerifyCC_006</bmm:bmpm:outgoing>
    </bpmn:intermediateThrowEvent>

    <!-- Intermediate Catch Event -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_VerifyResult_001" name="Verification Result Received">
      <bpmn:messageEventDefinition />
      <bmm:bmpm:incoming>SequenceFlow_ResultToCheckResponse_007</bmm:bmpm:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task 4 -->
    <bpmn:task id="Task_CheckVerificationResult_003" name="Check Verification Result">
      <bpmn:incoming>SequenceFlow_ResultToCheckResponse_007</bmm:bmpm:outgoing>
      <bpmn:outgoing>SequenceFlow_ResponseToFinalGateway_008</bmm:bmpm:outgoing>
    </bpmn:task>

    <!-- Gateway 3 -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_FinalDecision_001">
      <bpmn:incoming>SequenceFlow_ResponseToFinalGateway_008</bmm:bmpm:outgoing>
      <bpmn:outgoing>SequenceFlow_ValidPath_AddCard_009</bmm:bmpm:outgoing>
      <bpmn:outgoing>SequenceFlow_InvalidPath_Cancel_010</bmm:bmpm:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 5 -->
    <bpmn:task id="Task_AddCreditCard_004" name="Add Credit Card to Account">
      <bpmn:incoming>SequenceFlow_ValidPath_AddCard_009</bmm:bmpm:outgoing>
      <bpmn:outgoing>SequenceFlow_CardAddedToEndEvent_011</bmm:bmpm:outgoing>
    </bpmn:task>

    <!-- End Event 1 -->
    <bpmn:endEvent id="EndEvent_SuccessfulAddition_001" name="Credit Card Added">
      <bpmn:incoming>SequenceFlow_CardAddedToEndEvent_011</bmm:bmpm:outgoing>
    </bpmn:endEvent>

    <!-- End Event 2 -->
    <bpmn:endEvent id="EndEvent_AdditionCancelled_002" name="Addition Cancelled">
      <bpmn:incoming>SequenceFlow_CancellationToEndEvent_012</bmm:bmpm:outgoing>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToEnterDetails_001" sourceRef="StartEvent_ProcessStarted_001" targetRef="Task_EnterCardDetails_001" />
    <bpmn:sequenceFlow id="SequenceFlow_DetailsToBillingCheck_002" sourceRef="Task_EnterCardDetails_001" targetRef="ExclusiveGateway_BillingCheck_001" />
    <bpmn:sequenceFlow id="SequenceFlow_AddressCorrectPath_003" name="Address Correct" sourceRef="ExclusiveGateway_BillingCheck_001" targetRef="Task_ClickContinue_003" />
    <bpmn:sequenceFlow id="SequenceFlow_AddressIncorrectLoopback_004" name="Address Incorrect" sourceRef="ExclusiveGateway_BillingCheck_001" targetRef="Task_ModifyBillingAddress_002" />
    <bpmn:sequenceFlow id="SequenceFlow_ProceedToContinue_005" name="Proceed to Continue" sourceRef="Task_ModifyBillingAddress_002" targetRef="ExclusiveGateway_ProceedDecision_002" />
    <bmm:bmpm:outgoing>SequenceFlow_ConfirmToVerifyCC_006</bpmn:sequenceFlow id="SequenceFlow_ConfirmToContinue_005">
      <bpmn:sourceRef>Task_ClickContinue_003</bpmn:targetRef>IntermediateThrowEvent_VerifyCC_001</bmm:bmpm:outgoing>
    </bpmn:sequenceFlow id="SequenceFlow_ResultToCheckResponse_007" sourceRef="IntermediateCatchEvent_VerifyResult_001" targetRef="Task_CheckVerificationResult_003" />
    <bmm:bmpm:outgoing>SequenceFlow_ValidPath_AddCard_009</bpmn:sequenceFlow id="SequenceFlow_ValidPath_AddCard_009">
      <bpmn:name sourceRef="Validated">ExclusiveGateway_FinalDecision_001</bpmn:targetRef>Task_AddCreditCard_004</bmm:bmpm:outgoing>
    </bpmn:sequenceFlow id="SequenceFlow_CardAddedToEndEvent_011" name="Addition Successful" sourceRef="Task_AddCreditCard_004" targetRef="EndEvent_SuccessfulAddition_001" />
    <bmm:bmpm:outgoing>SequenceFlow_InvalidPath_Cancel_010</bpmn:sequenceFlow id="SequenceFlow_InvalidPath_Cancel_010">
      <bpmn:name sourceRef="Not Validated">ExclusiveGateway_FinalDecision_001</bpmn:targetRef>EndEvent_AdditionCancelled_002</bmm:bmpm:outgoing>
    </bpmn:sequenceFlow id="SequenceFlow_CancellationToEndEvent_012" name="Addition Cancelled" sourceRef="ExclusiveGateway_FinalDecision_001" targetRef="EndEvent_AdditionCancelled_002" />

  </bmm:bmpm:process>
</bpmn:definitions>