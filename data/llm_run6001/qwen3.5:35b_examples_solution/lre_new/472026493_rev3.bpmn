<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="_HardwareProcurement_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_HardwareProcurement_001">
    <bpmn:participant id="Participant_InternalProcess_001" name="Hardware Procurement Process" processRef="Process_HardwareProcurement_001" />
    <bpmn:participant id="Participant_Supplier_002" name="Supplier" />
    <bpmn:messageFlow id="MsgFlow_AskPrices_001" sourceRef="Event_SendAskPrices_003" targetRef="Participant_Supplier_002" />
    <bpmn:messageFlow id="MsgFlow_OfferReceived_004" sourceRef="Participant_Supplier_002" targetRef="Event_ReceiveOffer_005" />
    <bpmn:messageFlow id="MsgFlow_SendOrder_013" sourceRef="Task_PrepareOrderSend_016" targetRef="Participant_Supplier_002" />
  </bpmn:collaboration>

  <bpmn:process id="Process_HardwareProcurement_001">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_ITDept_001" name="IT Department">
        <bpmn:flowNodeRef>StartEvent_RequestReceived_002</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AnalyzeRequest_003</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ITDecision_004</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_SendAskPrices_003</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EditCompleteRequest_012</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_OrderAccepted_017</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Management_002" name="Management">
        <bpmn:flowNodeRef>Task_FillFormSendMgmt_006</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MgmtDecision_014</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_FinanceDept_003" name="Financial Department">
        <bpmn:flowNodeRef>Task_FindResources_020</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ParallelJoin_019</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_RequestReceived_002" name="Receive Request for New HW">
      <bpmn:messageEventDefinition />
      <bpmn:outgoing>SequenceFlow_StartToAnalyze_010</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- IT Dept Task -->
    <bpmn:task id="Task_AnalyzeRequest_003" name="Analyze Request">
      <bpmn:incoming>SequenceFlow_StartToAnalyze_010</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AnalyzeToITDecision_011</bpmn:outgoing>
    </bpmn:task>

    <!-- IT Decision Gateway -->
    <bpmn:exclusiveGateway id="Gateway_ITDecision_004">
      <bpmn:incoming>SequenceFlow_AnalyzeToITDecision_011</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DenyPath_025</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ApprovePath_036</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- IT Dept Intermediate Throw Event (Ask Prices) -->
    <bpmn:intermediateThrowEvent id="Event_SendAskPrices_003" name="Send Ask Prices to Supplier">
      <bpmn:messageEventDefinition />
      <bpmn:incoming>SequenceFlow_EditToAskPrices_015</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AskToWaitOffer_037</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <!-- IT Dept Intermediate Catch Event (Receive Offer) -->
    <bpmn:intermediateCatchEvent id="Event_ReceiveOffer_005" name="Receive Supplier Offer">
      <bpmn:messageEventDefinition />
      <bpmn:incoming>SequenceFlow_AskToWaitOffer_037</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OfferReceivedToForm_016</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- IT Dept Task (Fill Form) -->
    <bpmn:task id="Task_FillFormSendMgmt_006" name="Fill Form and Send to Management">
      <bpmn:incoming>SequenceFlow_OfferReceivedToForm_016</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FormToSendMgmt_027</bpmn:outgoing>
    </bpmn:task>

    <!-- Management Task -->
    <bpmn:task id="Task_MgmtAnalyzeRequest_013" name="Analyze Request">
      <bpmn:incoming>SequenceFlow_FormToSendMgmt_027</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AnalysisToDecision_045</bpmn:outgoing>
    </bpmn:task>

    <!-- Management Decision Gateway -->
    <bpmn:exclusiveGateway id="Gateway_MgmtDecision_014">
      <bpmn:incoming>SequenceFlow_AnalysisToDecision_045</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ApproveMgmtPath_028</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ReworkMgmtPath_039</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_DenyMgmtPath_046</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Parallel Split Gateway (After Mgmt Approval) -->
    <bpmn:parallelGateway id="Gateway_ParallelSplit_015">
      <bpmn:incoming>SequenceFlow_ApproveMgmtPath_028</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SplitToFinance_034</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SplitToITOrder_051</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Finance Task (Find Resources) -->
    <bpmn:task id="Task_FindResources_020" name="Find Financial Resources">
      <bpmn:incoming>SequenceFlow_SplitToFinance_034</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FinanceReadyToJoin_056</bpmn:outgoing>
    </bpmn:task>

    <!-- IT Task (Prepare Order) -->
    <bpmn:task id="Task_PrepareOrderSend_016" name="Prepare and Send Order">
      <bpmn:incoming>SequenceFlow_SplitToITOrder_051</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OrderSentToWaitAcceptance_048</bpmn:outgoing>
    </bpmn:task>

    <!-- IT Intermediate Catch Event (Order Accepted) -->
    <bpmn:intermediateCatchEvent id="Event_OrderAccepted_017" name="Receive Order Acceptance">
      <bpmn:messageEventDefinition />
      <bpmn:incoming>SequenceFlow_OrderSentToWaitAcceptance_048</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AcceptedToJoin_057</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Parallel Join Gateway (Convergence) -->
    <bpmn:parallelGateway id="Gateway_ParallelJoin_019">
      <bpmn:incoming>SequenceFlow_FinanceReadyToJoin_056</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_AcceptedToJoin_057</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_JoinToReceiveHW_021</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- IT Task (Receive Hardware) -->
    <bpmn:task id="Task_ReceiveHardware_023" name="Receive Hardware">
      <bpmn:incoming>SequenceFlow_JoinToReceiveHW_021</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_HWReceivedToInvoice_058</bpmn:outgoing>
    </bpmn:task>

    <!-- Finance Task (Handle Invoice) -->
    <bpmn:task id="Task_HandleInvoice_024" name="Take Care of Invoice">
      <bpmn:incoming>SequenceFlow_HWReceivedToInvoice_058</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InvoiceDoneToEnd_061</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event (Process Completed) -->
    <bpmn:endEvent id="EndEvent_ProcessCompleted_025" name="Process Ended">
      <bpmn:messageEventDefinition />
      <bpmn:incoming>SequenceFlow_InvoiceDoneToEnd_061</bpmn:incoming>
    </bpmn:endEvent>

    <!-- End Event (IT Denial) -->
    <bpmn:endEvent id="EndEvent_ITDenial_029" name="Inform Employee">
      <bpmn:messageEventDefinition />
      <bpmn:incoming>SequenceFlow_DenyPath_025</bpmn:incoming>
    </bpmn:endEvent>

    <!-- End Event (Management Denial) -->
    <bpmn:endEvent id="EndEvent_MgmtDeny_031" name="Request Denied">
      <bpmn:messageEventDefinition />
      <bpmn:incoming>SequenceFlow_DenyMgmtPath_046</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToAnalyze_010" sourceRef="StartEvent_RequestReceived_002" targetRef="Task_AnalyzeRequest_003" />
    
    <bpmn:sequenceFlow id="SequenceFlow_DenyPath_025" name="Deny (IT)" sourceRef="Gateway_ITDecision_004" targetRef="EndEvent_ITDenial_029">
      <!-- Note: Target is End Event, so incoming flow -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ApprovePath_036" name="Approve (IT)" sourceRef="Gateway_ITDecision_004" targetRef="Task_EditCompleteRequest_012">
      <!-- Note: Target is Task -->
    </bpmn:sequenceFlow>

    <bpmn:task id="Task_EditCompleteRequest_012" name="Edit and Complete Request">
       <bpmn:incoming>SequenceFlow_ApprovePath_036</bpmn:incoming>
       <bpmn:incoming>SequenceFlow_ReworkMgmtLoopBack_049</bpmn:incoming> <!-- Loop back from Mgmt -->
       <bpmn:outgoing>SequenceFlow_EditToAskPrices_015</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_AskToWaitOffer_037" sourceRef="Event_SendAskPrices_003" targetRef="Event_ReceiveOffer_005">
      <!-- Logic flow for internal process representation of message exchange -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_OfferReceivedToForm_016" sourceRef="Event_ReceiveOffer_005" targetRef="Task_FillFormSendMgmt_006">
      <!-- Logic flow for internal process representation of message exchange -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_FormToSendMgmt_027" sourceRef="Task_FillFormSendMgmt_006" targetRef="Task_MgmtAnalyzeRequest_013">
      <!-- Logic flow for internal process representation of message exchange -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_AnalysisToDecision_045" sourceRef="Task_MgmtAnalyzeRequest_013" targetRef="Gateway_MgmtDecision_014">
      <!-- Logic flow for internal process representation of message exchange -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ApproveMgmtPath_028" name="Approved (Mgmt)" sourceRef="Gateway_MgmtDecision_014" targetRef="Gateway_ParallelSplit_015">
      <!-- Logic flow for internal process representation of message exchange -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ReworkMgmtPath_039" name="Rework (Not Approved)" sourceRef="Gateway_MgmtDecision_014" targetRef="Task_EditCompleteRequest_012">
      <!-- Logic flow for internal process representation of message exchange -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_DenyMgmtPath_046" name="Deny (Mgmt)" sourceRef="Gateway_MgmtDecision_014" targetRef="EndEvent_MgmtDeny_031">
      <!-- Logic flow for internal process representation of message exchange -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_SplitToFinance_034" sourceRef="Gateway_ParallelSplit_015" targetRef="Task_FindResources_020">
      <!-- Logic flow for internal process representation of message exchange -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_SplitToITOrder_051" sourceRef="Gateway_ParallelSplit_015" targetRef="Task_PrepareOrderSend_016">
      <!-- Logic flow for internal process representation of message exchange -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_OrderSentToWaitAcceptance_048" sourceRef="Task_PrepareOrderSend_016" targetRef="Event_OrderAccepted_017">
      <!-- Logic flow for internal process representation of message exchange -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_FinanceReadyToJoin_056" sourceRef="Task_FindResources_020" targetRef="Gateway_ParallelJoin_019">
      <!-- Logic flow for internal process representation of message exchange -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_AcceptedToJoin_057" sourceRef="Event_OrderAccepted_017" targetRef="Gateway_ParallelJoin_019">
      <!-- Logic flow for internal process representation of message exchange -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_JoinToReceiveHW_021" sourceRef="Gateway_ParallelJoin_019" targetRef="Task_ReceiveHardware_023">
      <!-- Logic flow for internal process representation of message exchange -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_HWReceivedToInvoice_058" sourceRef="Task_ReceiveHardware_023" targetRef="Task_HandleInvoice_024">
      <!-- Logic flow for internal process representation of message exchange -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_InvoiceDoneToEnd_061" sourceRef="Task_HandleInvoice_024" targetRef="EndEvent_ProcessCompleted_025">
      <!-- Logic flow for internal process representation of message exchange -->
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>