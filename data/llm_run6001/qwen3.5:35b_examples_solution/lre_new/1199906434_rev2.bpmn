<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_DataValidation_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_DataValidation_001">
    <bpmn:participant id="Participant_SupportProcess_001" name="Support Process" processRef="Process_DataValidation_001" />
    <bpmn:participant id="Participant_Customer_002" name="Customer" />
  </bpmn:collaboration>

  <bpmn:process id="Process_DataValidation_001" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Notified_001" name="IS notified about data validation error&#10;">
      <bpmn:outgoing>SequenceFlow_Start_ToCheckTypos_001</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1 -->
    <bpmn:task id="Task_CheckTypingErrors_002" name="Check for typing errors&#10;">
      <bpmn:incoming>SequenceFlow_Start_ToCheckTypos_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TyposToGateway_003</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1 -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_TypoCheck_004">
      <bpmn:incoming>SequenceFlow_TyposToGateway_003</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Gateway_ToCustomerFixable_005</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_Gateway_ToResolved_012</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flow 3 -->
    <bpmn:sequenceFlow id="SequenceFlow_Start_ToCheckTypos_001" sourceRef="StartEvent_Notified_001" targetRef="Task_CheckTypingErrors_002" />
    
    <!-- Sequence Flow 4 -->
    <bpmn:sequenceFlow id="SequenceFlow_TyposToGateway_003" sourceRef="Task_CheckTypingErrors_002" targetRef="ExclusiveGateway_TypoCheck_004" />

    <!-- Task 2 (Customer Check) -->
    <bpmn:task id="Task_CustomerCorrection_006" name="Check if customer is able to provide fixed data&#10;">
      <bpmn:incoming>SequenceFlow_Gateway_ToCustomerFixable_005</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CustToGateway2_007</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2 -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_CustomerFixable_008">
      <bpmn:incoming>SequenceFlow_CustToGateway2_007</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Gateway_ToPublicSources_013</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_Gateway_ToResolved_014</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flow 5 -->
    <bpmn:sequenceFlow id="SequenceFlow_Gateway_ToCustomerFixable_005" name="Not found&#10;" sourceRef="ExclusiveGateway_TypoCheck_004" targetRef="Task_CustomerCorrection_006" />

    <!-- Sequence Flow 7 -->
    <bpmn:sequenceFlow id="SequenceFlow_CustToGateway2_007" sourceRef="Task_CustomerCorrection_006" targetRef="ExclusiveGateway_CustomerFixable_008" />

    <!-- Task 3 (Public Sources) -->
    <bpmn:task id="Task_PublicSources_015" name="Check data fixes from public sources&#10;">
      <bpmn:incoming>SequenceFlow_Gateway_ToPublicSources_013</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SourcesToGateway3_016</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 3 -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_PublicSources_017">
      <bpmn:incoming>SequenceFlow_SourcesToGateway3_016</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Gateway_ToResolved_024</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_Gateway_ToUnresolved_025</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flow 13 -->
    <bpmn:sequenceFlow id="SequenceFlow_Gateway_ToPublicSources_013" name="No&#10;" sourceRef="ExclusiveGateway_CustomerFixable_008" targetRef="Task_PublicSources_015" />

    <!-- Sequence Flow 16 -->
    <bpmn:sequenceFlow id="SequenceFlow_SourcesToGateway3_016" sourceRef="Task_PublicSources_015" targetRef="ExclusiveGateway_PublicSources_017" />

    <!-- End Event: Resolved (Path from Typo Check) -->
    <bpmn:endEvent id="EndEvent_IssueResolved_020" name="Issue was resolved&#10;">
      <bpmn:incoming>SequenceFlow_Gateway_ToResolved_012</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_Gateway_ToResolved_014</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_Gateway_ToResolved_024</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flow 12 -->
    <bpmn:sequenceFlow id="SequenceFlow_Gateway_ToResolved_012" name="found&#10;" sourceRef="ExclusiveGateway_TypoCheck_004" targetRef="EndEvent_IssueResolved_020" />

    <!-- Sequence Flow 14 -->
    <bpmn:sequenceFlow id="SequenceFlow_Gateway_ToResolved_014" name="Yes&#10;" sourceRef="ExclusiveGateway_CustomerFixable_008" targetRef="EndEvent_IssueResolved_020" />

    <!-- End Event: Unresolved -->
    <bpmn:endEvent id="EndEvent_Unresolvable_030" name="Issue was un-resolvable&#10;">
      <bpmn:incoming>SequenceFlow_Gateway_ToUnresolved_025</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flow 24 -->
    <bpmn:sequenceFlow id="SequenceFlow_Gateway_ToResolved_024" name="Data fixed&#10;" sourceRef="ExclusiveGateway_PublicSources_017" targetRef="EndEvent_IssueResolved_020" />

    <!-- Sequence Flow 25 -->
    <bpmn:sequenceFlow id="SequenceFlow_Gateway_ToUnresolved_025" name="Not found&#10;" sourceRef="ExclusiveGateway_PublicSources_017" targetRef="EndEvent_Unresolvable_030" />

  </bpmn:process>
</bpmn:definitions>