<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Provision_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_ProvisionProcess_001">
    <bpmn:participant id="Participant_ProvisionTeam_001" name="Provision Team" processRef="Proc_LoanReview_002" />
    <bpmn:participant id="Participant_Customer_003" name="Customer" />
    <bpmn:participant id="Participant_Daisuki_004" name="Daisuki" />

    <!-- Message Flows -->
    <bpmn:messageFlow id="MsgFlw_RequestReceived_001" sourceRef="Participant_Customer_003" targetRef="StartEvent_ProvisionRequest_005">
      <bpmn:sourceRef>Participant_Customer_003</bpmn:sourceRef>
      <bpmn:targetRef>StartEvent_ProvisionRequest_005</bpmn:targetRef>
    </bpmn:messageFlow>

    <bpmn:messageFlow id="MsgFlw_QuestionToCustomer_002" sourceRef="Task_AskForMoreInfo_013" targetRef="Participant_Customer_003">
      <bpmn:sourceRef>Task_AskForMoreInfo_013</bpmn:sourceRef>
      <bpmn:targetRef>Participant_Customer_003</bpmn:targetRef>
    </bpmn:messageFlow>

    <bpmn:messageFlow id="MsgFlw_OrderToDaisuki_003" sourceRef="Task_MakeOrderFromDaisuki_015" targetRef="Participant_Daisuki_004">
      <bpmn:sourceRef>Task_MakeOrderFromDaisuki_015</bpmn:sourceRef>
      <bpmn:targetRef>Participant_Daisuki_004</bpmn:targetRef>
    </bpmn:messageFlow>

    <bpmn:messageFlow id="MsgFlw_CustomerContacted_004" sourceRef="Task_ContactCustomerWhenCollected_016" targetRef="Participant_Customer_003">
      <bpmn:sourceRef>Task_ContactCustomerWhenCollected_016</bpmn:sourceRef>
      <bpmn:targetRef>Participant_Customer_003</bpmn:targetRef>
    </bpmn:messageFlow>

    <bpmn:messageFlow id="MsgFlw_PaymentReceived_005" sourceRef="Task_FinalPaymentReceived_019" targetRef="Participant_Customer_003">
      <bpmn:sourceRef>Task_FinalPaymentReceived_019</bpmn:sourceRef>
      <bpmn:targetRef>Participant_Customer_003</bpmn:targetRef>
    </bpmn:messageFlow>

  </bpmn:collaboration>

  <bpmn:process id="Proc_LoanReview_002" isExecutable="false">

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_ProvisionRequest_005" name="Provision Request Received">
      <bpmn:messageEventDefinition />
      <bpmn:outgoing>SeqFlow_StartToIdentifyParts_021</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Identify parts -->
    <bpmn:task id="Task_IdentifyParts_006" name="Identify necessary parts">
      <bpmn:incoming>SeqFlow_StartToIdentifyParts_021</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_IdentifyToQuestionDecision_022</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Questions about request? -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_QuestionDecision_007" name="Questions about request?">
      <bpmn:incoming>SeqFlow_IdentifyToQuestionDecision_022</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_NoQuestionsToCheckAvailability_023</bpmn:outgoing>
      <bpmn:outgoing>SeqFlow_AskForMoreInfo_024</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 4: Ask for more information -->
    <bpmn:task id="Task_AskForMoreInfo_013" name="Ask customer for more information">
      <bpmn:incoming>SeqFlow_AskForMoreInfo_024</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_InfoReceivedToCheckAvailability_025</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 5: Check availability -->
    <bpmn:task id="Task_CheckPartsAvailable_014" name="Check if all parts are available">
      <bpmn:incoming>SeqFlow_NoQuestionsToCheckAvailability_023</bpmn:incoming>
      <bpmn:incoming>SeqFlow_InfoReceivedToCheckAvailability_025</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_CheckPartsDecisionGateway_026</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2: Parts available? -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_PartsAvailable_017" name="All parts available?">
      <bpmn:incoming>SeqFlow_CheckPartsDecisionGateway_026</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_AvailableToSupplyCustomer_028</bpmn:outgoing>
      <bpmn:outgoing>SeqFlow_NotAvailableRecordPetition_031</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 7a: Supply to customer -->
    <bpmn:task id="Task_SupplyToCustomer_029" name="Supply parts to customer">
      <bpmn:incoming>SeqFlow_AvailableToSupplyCustomer_028</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_SuppliedToItemsCollected_034</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 7b1: Record petition -->
    <bpmn:task id="Task_RecordPetition_025" name="Record the petition">
      <bpmn:incoming>SeqFlow_NotAvailableRecordPetition_031</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_PetitionToOrderDaisuki_036</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 7b2: Order from Daisuki -->
    <bpmn:subProcess id="Task_MakeOrderFromDaisuki_015" name="Make order to Daisuki">
      <bpmn:incoming>SeqFlow_PetitionToOrderDaisuki_036</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_OrderCompleteContactCustomer_042</bpmn:outgoing>
    </bpmn:subProcess>

    <!-- Task 7c: Contact customer when collected -->
    <bpmn:task id="Task_ContactCustomerWhenCollected_016" name="Contact customer (parts collected)">
      <bpmn:incoming>SeqFlow_OrderCompleteContactCustomer_042</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_CustomerNotifiedToItemsCollected_039</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 3: Merge paths -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_MergePaths_018" name="">
      <bpmn:incoming>SeqFlow_SuppliedToItemsCollected_034</bpmn:incoming>
      <bpmn:incoming>SeqFlow_CustomerNotifiedToItemsCollected_039</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_MergeToCustomerCollection_041</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 8: Items recollected by customer -->
    <bpmn:task id="Task_ItemsCollectedByCustomer_035" name="Items collected by customer">
      <bpmn:incoming>SeqFlow_MergeToCustomerCollection_041</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_CollectionToFinalPayment_046</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 9: Final payment received -->
    <bpmn:task id="Task_FinalPaymentReceived_019" name="Receive final payment">
      <bpmn:incoming>SeqFlow_CollectionToFinalPayment_046</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_PaymentToEndEvent_052</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_ProcessComplete_037" name="Process Complete">
      <bpmn:incoming>SeqFlow_PaymentToEndEvent_052</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SeqFlow_StartToIdentifyParts_021" sourceRef="StartEvent_ProvisionRequest_005" targetRef="Task_IdentifyParts_006">
      <bpmn:name>Provision request received</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SeqFlow_IdentifyToQuestionDecision_022" sourceRef="Task_IdentifyParts_006" targetRef="ExclusiveGateway_QuestionDecision_007">
      <bpmn:name>After identification</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SeqFlow_NoQuestionsToCheckAvailability_023" sourceRef="ExclusiveGateway_QuestionDecision_007" targetRef="Task_CheckPartsAvailable_014">
      <bpmn:name>No questions</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SeqFlow_AskForMoreInfo_024" sourceRef="ExclusiveGateway_QuestionDecision_007" targetRef="Task_AskForMoreInfo_013">
      <bpmn:name>Questions exist</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SeqFlow_InfoReceivedToCheckAvailability_025" sourceRef="Task_AskForMoreInfo_013" targetRef="Task_CheckPartsAvailable_014">
      <bpmn:name>Information received</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SeqFlow_CheckPartsDecisionGateway_026" sourceRef="Task_CheckPartsAvailable_014" targetRef="ExclusiveGateway_PartsAvailable_017">
      <bpmn:name>Availability check complete</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SeqFlow_AvailableToSupplyCustomer_028" sourceRef="ExclusiveGateway_PartsAvailable_017" targetRef="Task_SupplyToCustomer_029">
      <bpmn:name>All parts available</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SeqFlow_NotAvailableRecordPetition_031" sourceRef="ExclusiveGateway_PartsAvailable_017" targetRef="Task_RecordPetition_025">
      <bpmn:name>Petition recorded</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SeqFlow_PetitionToOrderDaisuki_036" sourceRef="Task_RecordPetition_025" targetRef="Task_MakeOrderFromDaisuki_015">
      <bpmn:name>Petition recorded</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SeqFlow_OrderCompleteContactCustomer_042" sourceRef="Task_MakeOrderFromDaisuki_015" targetRef="Task_ContactCustomerWhenCollected_016">
      <bpmn:name>Parts collected</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SeqFlow_SuppliedToItemsCollected_034" sourceRef="Task_SupplyToCustomer_029" targetRef="ExclusiveGateway_MergePaths_018">
      <bpmn:name>Parts supplied</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SeqFlow_CustomerNotifiedToItemsCollected_039" sourceRef="Task_ContactCustomerWhenCollected_016" targetRef="ExclusiveGateway_MergePaths_018">
      <bpmn:name>Contacted</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SeqFlow_MergeToCustomerCollection_041" sourceRef="ExclusiveGateway_MergePaths_018" targetRef="Task_ItemsCollectedByCustomer_035">
      <bpmn:name>Merged paths</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SeqFlow_CollectionToFinalPayment_046" sourceRef="Task_ItemsCollectedByCustomer_035" targetRef="Task_FinalPaymentReceived_019">
      <bpmn:name>Items collected</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SeqFlow_PaymentToEndEvent_052" sourceRef="Task_FinalPaymentReceived_019" targetRef="EndEvent_ProcessComplete_037">
      <bpmn:name>Final payment received</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>