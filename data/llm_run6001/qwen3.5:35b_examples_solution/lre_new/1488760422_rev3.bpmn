<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="_InvoiceProcess_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_InvoiceReview_001">
    <bpmn:participant id="Participant_SSP_001" name="SSP (Admin Office)" processRef="Process_InvoiceReview_001" />
    <bpmn:participant id="Participant_Client_002" name="Client" />
    <bpmn:messageFlow id="MessageFlow_StartInvoice_001" sourceRef="Participant_Client_002" targetRef="StartEvent_InvoiceReceived_001">
      <bpmn:name>Receive Invoice</bpmn:name>
    </bpmn:messageFlow>
    <bpmn:messageFlow id="MessageFlow_EndNotComplete_001" sourceRef="EndEvent_NotCompleted_002" targetRef="Participant_Client_002">
      <bpmn:name>Invoice Not Complete</bpmn:name>
    </bpmn:messageFlow>
    <bpmn:messageFlow id="MessageFlow_ReminderSent_001" sourceRef="Task_SendReminder_005" targetRef="Participant_Client_002">
      <bpmn:name>Send Reminder</bpmn:name>
    </bpmn:messageFlow>
  </bpmn:collaboration>

  <bpmn:process id="Process_InvoiceReview_001" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_AdminOffice_001" name="Admin Office">
        <bpmn:flowNodeRef>StartEvent_InvoiceReceived_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiptInvoice_002</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SortClient_003</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SortVendor_004</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AttachForm_005</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_EnterInfo_006</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CompletenessCheck_007</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SLAEntry_008</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PriorityCheck_009</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RedStamp_010</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ComplianceMerge_011</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckCompliance_012</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AllocationDecision_013</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ActionSelection_014</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendExperienceStaff_015</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProcessNonCompliance_016</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MergeAction_017</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CallClient_018</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RequestInfoCall_019</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MergeAction2_020</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PostalMail_021</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CatchEvent_Timer_022</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendReminder_023</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MergeAllActions_024</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AllocateDEO_025</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_CompletedAllocation_026</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_InvoiceReceived_001" name="Receive Invoice">
      <bpmn:messageEventDefinition />
      <bpmn:outgoing>SequenceFlow_StartToReceipt_026</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Tasks -->
    <bpmn:task id="Task_ReceiptInvoice_002" name="Receive the invoice">
      <bpmn:incoming>SequenceFlow_StartToReceipt_026</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReceiptToSortClient_027</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_SortClient_003" name="Sort the invoice per client">
      <bpmn:incoming>SequenceFlow_ReceiptToSortClient_027</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SortClientToVendor_028</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_SortVendor_004" name="Sort the invoice per vendor">
      <bpmn:incoming>SequenceFlow_SortClientToVendor_028</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_VendorToAttachForm_029</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_AttachForm_005" name="Attach invoice entry form to invoice">
      <bpmn:incoming>SequenceFlow_VendorToAttachForm_029</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AttachToEnterInfo_030</bpmn:outgoing>
    </bpmn:task>

    <!-- Subprocess for entering info -->
    <bpmn:subProcess id="SubProcess_EnterInfo_006" name="Entered required info on the invoice entry form">
      <bpmn:incoming>SequenceFlow_AttachToEnterInfo_030</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InfoToCheckCompleteness_031</bpmn:outgoing>
    </bpmn:subProcess>

    <!-- Gateway 1: Completeness Check -->
    <bpmn:exclusiveGateway id="Gateway_CompletenessCheck_007">
      <bpmn:incoming>SequenceFlow_InfoToCheckCompleteness_031</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckNotComplete_032</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CheckComplete_033</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event for Not Complete -->
    <bpmn:endEvent id="EndEvent_NotCompleted_002" name="Invoice not completed">
      <bpmn:messageEventDefinition />
      <bpmn:incoming>SequenceFlow_CheckNotComplete_032</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task SLA Entry -->
    <bpmn:task id="Task_SLAEntry_008" name="Enter the info for the SLA">
      <bpmn:incoming>SequenceFlow_CheckComplete_033</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SLAToPriorityCheck_034</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2: Priority Check -->
    <bpmn:exclusiveGateway id="Gateway_PriorityCheck_009">
      <bpmn:incoming>SequenceFlow_SLAToPriorityCheck_034</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_HighPriority_035</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NormalPriority_036</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task Red Stamp -->
    <bpmn:task id="Task_RedStamp_010" name="Apply the red stamp on entry invoice">
      <bpmn:incoming>SequenceFlow_HighPriority_035</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StampsToComplianceMerge_037</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 3: Merge Priority Paths -->
    <bpmn:exclusiveGateway id="Gateway_ComplianceMerge_011">
      <bpmn:incoming>SequenceFlow_StampsToComplianceMerge_037</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_NormalPriority_036</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeToCheckCompliance_038</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task Check Compliance -->
    <bpmn:task id="Task_CheckCompliance_012" name="Check invoice compliance">
      <bpmn:incoming>SequenceFlow_MergeToCheckCompliance_038</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CompleteAllocatable_039</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_IncompleteActionSelect_040</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 4: Allocation Decision -->
    <bpmn:exclusiveGateway id="Gateway_AllocationDecision_013">
      <bpmn:incoming>SequenceFlow_CompleteAllocatable_039</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DirectToAllocate_041</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Gateway 5: Action Selection (Non-Compliant) -->
    <bpmn:exclusiveGateway id="Gateway_ActionSelection_014">
      <bpmn:incoming>SequenceFlow_IncompleteActionSelect_040</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendExperienceStaff_042</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CallClientPath_043</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PostalMailPath_044</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Path 1: Experience Staff -->
    <bpmn:task id="Task_SendExperienceStaff_015" name="Send to experience staff">
      <bpmn:incoming>SequenceFlow_SendExperienceStaff_042</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StffToProcessNonComp_045</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_ProcessNonCompliance_016" name="Process the non-compliance invoice">
      <bpmn:incoming>SequenceFlow_StffToProcessNonComp_045</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProcToMergeAction_046</bpmn:outgoing>
    </bpmn:task>

    <!-- Path 2: Call Client -->
    <bpmn:task id="Task_CallClient_018" name="Call the client">
      <bpmn:incoming>SequenceFlow_CallClientPath_043</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CallToRequestInfo_047</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_RequestInfoCall_019" name="Request for information">
      <bpmn:incoming>SequenceFlow_CallToRequestInfo_047</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InfoReqToMergeAction2_048</bpmn:outgoing>
    </bpmn:task>

    <!-- Path 3: Postal Mail -->
    <bpmn:task id="Task_PostalMail_021" name="Send a postal mail requesting the information complete">
      <bpmn:incoming>SequenceFlow_PostalMailPath_044</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MailToTimerWait_049</bpmn:outgoing>
    </bpmn:task>

    <!-- Timer Event (10 Hours) -->
    <bpmn:intermediateCatchEvent id="CatchEvent_Timer_022" name="After 10 hours">
      <bpmn:incoming>SequenceFlow_MailToTimerWait_049</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TimerToSendReminder_050</bpmn:outgoing>
      <bpmn:timerEventDefinition />
    </bpmn:intermediateCatchEvent>

    <!-- Task Send Reminder -->
    <bpmn:task id="Task_SendReminder_023" name="Send reminder">
      <bpmn:incoming>SequenceFlow_TimerToSendReminder_050</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReminderToMergeAllActions_051</bpmn:outgoing>
    </bpmn:task>

    <!-- Merge Points -->
    <bpmn:exclusiveGateway id="Gateway_MergeAction_017">
      <bpmn:incoming>SequenceFlow_ProcToMergeAction_046</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ActionMergedToAllActions_052</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:exclusiveGateway id="Gateway_MergeAction2_020">
      <bpmn:incoming>SequenceFlow_InfoReqToMergeAction2_048</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ActionMergedToAllActions_053</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Final Merge for all Non-Compliance Paths -->
    <bpmn:inclusiveGateway id="Gateway_MergeAllActions_024">
      <bpmn:incoming>SequenceFlow_ActionMergedToAllActions_052</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ActionMergedToAllActions_053</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ReminderToMergeAllActions_051</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AllPathsToAllocateDecision_054</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Final Allocation -->
    <bpmn:task id="Task_AllocateDEO_025" name="Allocate invoice to DEO">
      <bpmn:incoming>SequenceFlow_DirectToAllocate_041</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_AllPathsToAllocateDecision_054</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AllocateToEndEvent_055</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_CompletedAllocation_026" name="Shipment prepared">
      <bpmn:messageEventDefinition />
      <bpmn:incoming>SequenceFlow_AllocateToEndEvent_055</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToReceipt_026" sourceRef="StartEvent_InvoiceReceived_001" targetRef="Task_ReceiptInvoice_002" />
    <bpmn:sequenceFlow id="SequenceFlow_ReceiptToSortClient_027" sourceRef="Task_ReceiptInvoice_002" targetRef="Task_SortClient_003" />
    <bpmn:sequenceFlow id="SequenceFlow_SortClientToVendor_028" sourceRef="Task_SortClient_003" targetRef="Task_SortVendor_004" />
    <bpmn:sequenceFlow id="SequenceFlow_VendorToAttachForm_029" sourceRef="Task_SortVendor_004" targetRef="Task_AttachForm_005" />
    <bpmn:sequenceFlow id="SequenceFlow_AttachToEnterInfo_030" sourceRef="Task_AttachForm_005" targetRef="SubProcess_EnterInfo_006" />
    <bpmn:sequenceFlow id="SequenceFlow_InfoToCheckCompleteness_031" sourceRef="SubProcess_EnterInfo_006" targetRef="Gateway_CompletenessCheck_007" />

    <!-- Completeness Check Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckNotComplete_032" name="Not complete" sourceRef="Gateway_CompletenessCheck_007" targetRef="EndEvent_NotCompleted_002" />
    <bpmn:sequenceFlow id="SequenceFlow_CheckComplete_033" name="Complete" sourceRef="Gateway_CompletenessCheck_007" targetRef="Task_SLAEntry_008" />

    <!-- Priority Check Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_SLAToPriorityCheck_034" sourceRef="Task_SLAEntry_008" targetRef="Gateway_PriorityCheck_009" />
    <bpmn:sequenceFlow id="SequenceFlow_HighPriority_035" name="High priority" sourceRef="Gateway_PriorityCheck_009" targetRef="Task_RedStamp_010" />
    <bpmn:sequenceFlow id="SequenceFlow_NormalPriority_036" name="Low/Normal" sourceRef="Gateway_PriorityCheck_009" targetRef="Gateway_ComplianceMerge_011" />

    <!-- Compliance Merge Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StampsToComplianceMerge_037" sourceRef="Task_RedStamp_010" targetRef="Gateway_ComplianceMerge_011" />
    <bpmn:sequenceFlow id="SequenceFlow_MergeToCheckCompliance_038" sourceRef="Gateway_ComplianceMerge_011" targetRef="Task_CheckCompliance_012" />

    <!-- Compliance Decision Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_CompleteAllocatable_039" name="Complete" sourceRef="Task_CheckCompliance_012" targetRef="Gateway_AllocationDecision_013" />
    <bpmn:sequenceFlow id="SequenceFlow_IncompleteActionSelect_040" name="Not Complete" sourceRef="Task_CheckCompliance_012" targetRef="Gateway_ActionSelection_014" />

    <!-- Allocation Decision Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_DirectToAllocate_041" sourceRef="Gateway_AllocationDecision_013" targetRef="Task_AllocateDEO_025" />

    <!-- Action Selection Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_SendExperienceStaff_042" name="Send to experience staff" sourceRef="Gateway_ActionSelection_014" targetRef="Task_SendExperienceStaff_015" />
    <bpmn:sequenceFlow id="SequenceFlow_CallClientPath_043" name="Call the client" sourceRef="Gateway_ActionSelection_014" targetRef="Task_CallClient_018" />
    <bpmn:sequenceFlow id="SequenceFlow_PostalMailPath_044" name="Postal mail" sourceRef="Gateway_ActionSelection_014" targetRef="Task_PostalMail_021" />

    <!-- Experience Staff Path -->
    <bpmn:sequenceFlow id="SequenceFlow_StffToProcessNonComp_045" sourceRef="Task_SendExperienceStaff_015" targetRef="Task_ProcessNonCompliance_016" />
    <bpmn:sequenceFlow id="SequenceFlow_ProcToMergeAction_046" sourceRef="Task_ProcessNonCompliance_016" targetRef="Gateway_MergeAction_017" />

    <!-- Call Client Path -->
    <bpmn:sequenceFlow id="SequenceFlow_CallToRequestInfo_047" name="Request for information" sourceRef="Task_CallClient_018" targetRef="Task_RequestInfoCall_019" />
    <bpmn:sequenceFlow id="SequenceFlow_InfoReqToMergeAction2_048" sourceRef="Task_RequestInfoCall_019" targetRef="Gateway_MergeAction2_020" />

    <!-- Postal Mail Path -->
    <bpmn:sequenceFlow id="SequenceFlow_MailToTimerWait_049" name="After 10 hours (wait)" sourceRef="Task_PostalMail_021" targetRef="CatchEvent_Timer_022" />

    <!-- Reminder Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_TimerToSendReminder_050" sourceRef="CatchEvent_Timer_022" targetRef="Task_SendReminder_023" />
    <bpmn:sequenceFlow id="SequenceFlow_ReminderToMergeAllActions_051" name="After reminder sent" sourceRef="Task_SendReminder_023" targetRef="Gateway_MergeAllActions_024" />

    <!-- Merge Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_ActionMergedToAllActions_052" sourceRef="Gateway_MergeAction_017" targetRef="Gateway_MergeAllActions_024" />
    <bpmn:sequenceFlow id="SequenceFlow_ActionMergedToAllActions_053" sourceRef="Gateway_MergeAction2_020" targetRef="Gateway_MergeAllActions_024" />

    <!-- Final Allocation Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_AllPathsToAllocateDecision_054" name="Info obtained" sourceRef="Gateway_MergeAllActions_024" targetRef="Task_AllocateDEO_025" />
    <bpmn:sequenceFlow id="SequenceFlow_AllocateToEndEvent_055" sourceRef="Task_AllocateDEO_025" targetRef="EndEvent_CompletedAllocation_026" />

  </bpmn:process>
</bpmn:definitions>