<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                 xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" 
                 xmlns:di="http://www.omg.org/spec/DD/20100524/DI" 
                 xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" 
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 id="Definitions_PurchaseOrder_001" targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:collaboration id="Collaboration_ACMEInc_001">
    <bpmn:participant id="Participant_ACMEInc_001" name="ACME Inc." processRef="Process_PurchaseOrder_001"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_PurchaseOrder_001" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Finance_001" name="Finance"/>
      <bpmn:lane id="Lane_Department_002" name="Department"/>
      <bpmn:lane id="Lane_DepartmentHead_003" name="Department Head"/>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_PurchaseOrder_001">
      <bpmn:name>Purchase Order to Delivery</bpmn:name>
      <bpmn:outgoing>SequenceFlow_StartToCheckFormally_001</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1 -->
    <bpmn:task id="Task_CheckInvoiceFormally_001">
      <bpmn:name>Check purchase invoice formally</bpmn:name>
      <bpmn:incoming>SequenceFlow_StartToCheckFormally_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FormalToFactual_001</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2 -->
    <bpmn:task id="Task_CheckInvoiceFactual_001">
      <bpmn:name>Check for factually correct purchase invoice</bpmn:name>
      <bpmn:incoming>SequenceFlow_FormalToFactual_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FactualToGateway_001</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1 -->
    <bpmn:exclusiveGateway id="Gateway_AmountCheck_001">
      <bpmn:name>$500 Threshold</bpmn:name>
      <bpmn:incoming>SequenceFlow_FactualToGateway_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GatewayOver500_001</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_GatewayUnder500_001</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 3 -->
    <bpmn:task id="Task_ApproveInvoiceSaperion_001">
      <bpmn:name>Approve purchase invoice</bpmn:name>
      <bpmn:incoming>SequenceFlow_GatewayOver500_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ApprovalToMerge_001</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2 -->
    <bpmn:exclusiveGateway id="Gateway_AmountCheck_002">
      <bpmn:name>Merge Payment Path</bpmn:name>
      <bpmn:incoming>SequenceFlow_ApprovalToMerge_001</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_GatewayUnder500_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeToPayment_002</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 4 -->
    <bpmn:task id="Task_TriggerPaymentERP_001">
      <bpmn:name>Trigger payment</bpmn:name>
      <bpmn:incoming>SequenceFlow_MergeToPayment_002</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PaymentToEnd_001</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_ProcessFinished_001">
      <bpmn:name>Process Finished</bpmn:name>
      <bpmn:incoming>SequenceFlow_PaymentToEnd_001</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Data Stores -->
    <bpmn:dataStoreReference id="DataStoreReference_SAPERION_001">
      <bpmn:name>SAPERION Workflow</bpmn:name>
    </bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="DataStoreReference_ERPSys_001">
      <bpmn:name>ERP System</bpmn:name>
    </bpmn:dataStoreReference>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToCheckFormally_001" sourceRef="StartEvent_PurchaseOrder_001" targetRef="Task_CheckInvoiceFormally_001"/>
    <bpmn:sequenceFlow id="SequenceFlow_FormalToFactual_001" sourceRef="Task_CheckInvoiceFormally_001" targetRef="Task_CheckInvoiceFactual_001"/>
    <bpmn:sequenceFlow id="SequenceFlow_FactualToGateway_001" sourceRef="Task_CheckInvoiceFactual_001" targetRef="Gateway_AmountCheck_001"/>
    <bpmn:sequenceFlow id="SequenceFlow_GatewayOver500_001" name="Amount &gt; $500" sourceRef="Gateway_AmountCheck_001" targetRef="Task_ApproveInvoiceSaperion_001"/>
    <bpmn:sequenceFlow id="SequenceFlow_GatewayUnder500_001" name="Amount &lt;= $500" sourceRef="Gateway_AmountCheck_001" targetRef="Gateway_AmountCheck_002"/>
    <bpmn:sequenceFlow id="SequenceFlow_ApprovalToMerge_001" sourceRef="Task_ApproveInvoiceSaperion_001" targetRef="Gateway_AmountCheck_002"/>
    <bpmn:sequenceFlow id="SequenceFlow_MergeToPayment_002" sourceRef="Gateway_AmountCheck_002" targetRef="Task_TriggerPaymentERP_001"/>
    <bpmn:sequenceFlow id="SequenceFlow_PaymentToEnd_001" sourceRef="Task_TriggerPaymentERP_001" targetRef="EndEvent_ProcessFinished_001"/>

  </bpmn:process>
</bpmn:definitions>