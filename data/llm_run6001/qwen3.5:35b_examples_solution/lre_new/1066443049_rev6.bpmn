<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_WebDesignProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_WebDesign_001">
    <bpmn:participant id="Participant_DesignTeam_001" name="Web Design Process" processRef="Process_WebDesign_001"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_WebDesign_001" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_DesignTeam_001" name="Web design team">
        <bpmn:flowNodeRef>StartEvent_Meeting_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InfoMeeting_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_Successful_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Terminated_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Storyboard_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_StartWork_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Development_002</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ContentDraft_003</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_ReviewNeeded_002</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FinalVersion_003</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_MergeContent_002</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BuildWebsite_004</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_Approved_003</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Completed_001</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Meeting_001" name="Informational meeting">
      <bpmn:outgoing>SequenceFlow_StartToMeeting_001</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1 -->
    <bpmn:task id="Task_InfoMeeting_001" name="Informational meeting">
      <bpmn:incoming>SequenceFlow_StartToMeeting_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MeetingToDecision_001</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1 - Meeting Success Decision -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_Successful_001" name="Meeting successful?">
      <bpmn:incoming>SequenceFlow_MeetingToDecision_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SuccessPath_001</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_FailPath_001</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event 1 - Process terminated -->
    <bpmn:endEvent id="EndEvent_Terminated_001" name="Process ended">
      <bpmn:incoming>SequenceFlow_FailPath_001</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task 2 - Storyboard -->
    <bpmn:task id="Task_Storyboard_001" name="Create storyboard">
      <bpmn:incoming>SequenceFlow_SuccessPath_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StoryboardToParallel_001</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2 - Parallel Split for simultaneous work -->
    <bpmn:parallelGateway id="ParallelGateway_StartWork_001" name="Start parallel tasks">
      <bpmn:incoming>SequenceFlow_StoryboardToParallel_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DesignPath_002</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ContentDraft_003</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 3 - Design and Development -->
    <bpmn:task id="Task_Development_002" name="Design and development">
      <bpmn:incoming>SequenceFlow_DesignPath_002</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DevToMergeContent_001</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 4 - Initial content draft -->
    <bpmn:task id="Task_ContentDraft_003" name="Prepare initial content draft">
      <bpmn:incoming>SequenceFlow_ContentDraft_003</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DraftToReviewDecision_001</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 3 - Review Needed Decision -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_ReviewNeeded_002" name="Review needed?">
      <bpmn:incoming>SequenceFlow_DraftToReviewDecision_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NoReviewPath_004</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 5 - Final content version -->
    <bpmn:task id="Task_FinalVersion_003" name="Create final content">
      <bpmn:incoming>SequenceFlow_NoReviewPath_004</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FinalToMergeBuild_001</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 4 - Merge Development and Content -->
    <bpmn:parallelGateway id="ParallelGateway_MergeContent_002" name="Wait for both">
      <bpmn:incoming>SequenceFlow_DevToMergeContent_001</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_FinalToMergeBuild_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeToBuilding_003</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 6 - Build website -->
    <bpmn:task id="Task_BuildWebsite_004" name="Build and review site">
      <bpmn:incoming>SequenceFlow_MergeToBuilding_003</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BuiltToApprovalDecision_001</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 5 - Approval Decision -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_Approved_003" name="Site approved?">
      <bpmn:incoming>SequenceFlow_BuiltToApprovalDecision_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ApprovePath_005</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RejectPath_006</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event 2 - Process completed -->
    <bpmn:endEvent id="EndEvent_Completed_001" name="Process complete">
      <bpmn:incoming>SequenceFlow_ApprovePath_005</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToMeeting_001" sourceRef="StartEvent_Meeting_001" targetRef="Task_InfoMeeting_001"/>
    <bpmn:sequenceFlow id="SequenceFlow_MeetingToDecision_001" sourceRef="Task_InfoMeeting_001" targetRef="ExclusiveGateway_Successful_001"/>
    <bpmn:sequenceFlow id="SequenceFlow_SuccessPath_001" name="yes" sourceRef="ExclusiveGateway_Successful_001" targetRef="Task_Storyboard_001"/>
    <bpmn:sequenceFlow id="SequenceFlow_FailPath_001" name="no" sourceRef="ExclusiveGateway_Successful_001" targetRef="EndEvent_Terminated_001"/>
    <bpmn:sequenceFlow id="SequenceFlow_StoryboardToParallel_001" sourceRef="Task_Storyboard_001" targetRef="ParallelGateway_StartWork_001"/>
    <bpmn:sequenceFlow id="SequenceFlow_DesignPath_002" name="Design &amp; Development" sourceRef="ParallelGateway_StartWork_001" targetRef="Task_Development_002"/>
    <bpmn:sequenceFlow id="SequenceFlow_ContentDraft_003" name="Content Draft" sourceRef="ParallelGateway_StartWork_001" targetRef="Task_ContentDraft_003"/>
    <bpmn:sequenceFlow id="SequenceFlow_DevToMergeContent_001" sourceRef="Task_Development_002" targetRef="ParallelGateway_MergeContent_002"/>
    <bpmn:sequenceFlow id="SequenceFlow_DraftToReviewDecision_001" sourceRef="Task_ContentDraft_003" targetRef="ExclusiveGateway_ReviewNeeded_002"/>
    <bpmn:sequenceFlow id="SequenceFlow_NoReviewPath_004" name="no review needed" sourceRef="ExclusiveGateway_ReviewNeeded_002" targetRef="Task_FinalVersion_003"/>
    <bpmn:sequenceFlow id="SequenceFlow_FinalToMergeBuild_001" sourceRef="Task_FinalVersion_003" targetRef="ParallelGateway_MergeContent_002"/>
    <bpmn:sequenceFlow id="SequenceFlow_MergeToBuilding_003" sourceRef="ParallelGateway_MergeContent_002" targetRef="Task_BuildWebsite_004"/>
    <bpmn:sequenceFlow id="SequenceFlow_BuiltToApprovalDecision_001" sourceRef="Task_BuildWebsite_004" targetRef="ExclusiveGateway_Approved_003"/>
    <bpmn:sequenceFlow id="SequenceFlow_ApprovePath_005" name="yes, approved" sourceRef="ExclusiveGateway_Approved_003" targetRef="EndEvent_Completed_001"/>
    <bpmn:sequenceFlow id="SequenceFlow_RejectPath_006" name="no, needs revision" sourceRef="ExclusiveGateway_Approved_003" targetRef="Task_BuildWebsite_004"/>

  </bpmn:process>
</bpmn:definitions>