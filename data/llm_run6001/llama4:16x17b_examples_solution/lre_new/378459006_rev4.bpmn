<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" 
             targetNamespace="http://bpmn.io/schema/bpmn">
   <collaboration id="Collaboration_1">
     <participant id="Participant_1" processRef="Process_1"/>
     <participant id="Participant_2" name="The client"/>
     <messageFlow id="MessageFlow_1" sourceRef="Task_0" targetRef="Participant_2"/>
   </collaboration>
   <process id="Process_1" isExecutable="true">
     <laneSet>
       <lane id="Lane_1" name="The payment office">
         <flowNodeRef>StartEvent_1</flowNodeRef>
         <flowNodeRef>Task_0</flowNodeRef>
         <flowNodeRef>Task_1</flowNodeRef>
         <flowNodeRef>Task_2</flowNodeRef>
         <flowNodeRef>Task_3</flowNodeRef>
       </lane>
       <lane id="Lane_2" name="Accounts Receivable Department">
         <flowNodeRef>Task_4</flowNodeRef>
         <flowNodeRef>Task_5</flowNodeRef>
         <flowNodeRef>EndEvent_1</flowNodeRef>
       </lane>
       <lane id="Lane_3" name="Registry">
         <flowNodeRef>Task_6</flowNodeRef>
         <flowNodeRef>ExclusiveGateway_1</flowNodeRef>
         <flowNodeRef>Task_7</flowNodeRef>
         <flowNodeRef>Task_8</flowNodeRef>
         <flowNodeRef>EndEvent_2</flowNodeRef>
       </lane>
     </laneSet>
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>
     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_0"/>
     <task id="Task_0" name="Generate a Payment report">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_0" targetRef="Task_1"/>
     <task id="Task_1" name="Pay the vendor">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_3" sourceRef="Task_1" targetRef="ParallelGateway_1"/>
     <parallelGateway id="ParallelGateway_1">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_4</outgoing>
       <outgoing>SequenceFlow_5</outgoing>
       <outgoing>SequenceFlow_6</outgoing>
     </parallelGateway>
     <sequenceFlow id="SequenceFlow_4" sourceRef="ParallelGateway_1" targetRef="Task_2"/>
     <task id="Task_2" name="Send the payment report to Accounts Receivable Department">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_7</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_5" sourceRef="ParallelGateway_1" targetRef="Task_3"/>
     <task id="Task_3" name="Send payment report to registry">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_8</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_6" sourceRef="ParallelGateway_1" targetRef="EndEvent_0"/>
     <endEvent id="EndEvent_0">
       <incoming>SequenceFlow_6</incoming>
     </endEvent>
     <sequenceFlow id="SequenceFlow_7" sourceRef="Task_2" targetRef="Task_4"/>
     <task id="Task_4" name="Generate monthly invoice for clients">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_8" sourceRef="Task_3" targetRef="Task_6"/>
     <task id="Task_5" name="Charge the client $35 per invoice">
       <incoming>SequenceFlow_10</incoming>
       <outgoing>SequenceFlow_11</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_4" targetRef="Task_5"/>
     <sequenceFlow id="SequenceFlow_10" sourceRef="Task_4" targetRef="Task_5"/>
     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_11</incoming>
     </endEvent>
     <sequenceFlow id="SequenceFlow_11" sourceRef="Task_5" targetRef="EndEvent_1"/>
     <task id="Task_6" name="Selects the paper-based invoices that have been paid">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_12</outgoing>
     </task>
     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_12</incoming>
       <outgoing>SequenceFlow_13</outgoing>
       <outgoing>SequenceFlow_14</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_12" sourceRef="Task_6" targetRef="ExclusiveGateway_1"/>
     <task id="Task_7" name="Archive the invoices per vendor">
       <incoming>SequenceFlow_13</incoming>
       <outgoing>SequenceFlow_15</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_13" sourceRef="ExclusiveGateway_1" targetRef="Task_7"/>
     <task id="Task_8" name="Track down payment">
       <incoming>SequenceFlow_14</incoming>
       <outgoing>SequenceFlow_16</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_14" sourceRef="ExclusiveGateway_1" targetRef="Task_8"/>
     <endEvent id="EndEvent_2">
       <incoming>SequenceFlow_16</incoming>
     </endEvent>
     <sequenceFlow id="SequenceFlow_15" sourceRef="Task_7" targetRef="EndEvent_3"/>
     <endEvent id="EndEvent_3">
       <!-- Add some details here -->
     </endEvent>
     <sequenceFlow id="SequenceFlow_16" sourceRef="Task_8" targetRef="EndEvent_2"/>
   </process>
</definitions>