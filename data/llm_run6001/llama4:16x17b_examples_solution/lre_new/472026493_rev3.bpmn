<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" 
             targetNamespace="http://bpmn.io/schema/bpmn">
  <collaboration id="Collaboration_1">
    <participant id="Participant_1" processRef="Process_1"/>
    <participant id="Participant_2" name="Supplier"/>
    <messageFlow id="MessageFlow_1" sourceRef="Task_3" targetRef="Participant_2"/>
    <messageFlow id="MessageFlow_2" sourceRef="Participant_2" targetRef="IntermediateCatchEvent_1"/>
  </collaboration>
  <process id="Process_1" isExecutable="true">
    <laneSet>
      <lane id="Lane_1" name="IT Department">
        <flowNodeRef>StartEvent_1</flowNodeRef>
        <flowNodeRef>Task_1</flowNodeRef>
        <flowNodeRef>ExclusiveGateway_1</flowNodeRef>
        <flowNodeRef>Task_2</flowNodeRef>
        <flowNodeRef>IntermediateThrowEvent_1</flowNodeRef>
        <flowNodeRef>EndEvent_1</flowNodeRef>
      </lane>
      <lane id="Lane_2" name="Management">
        <flowNodeRef>Task_5</flowNodeRef>
        <flowNodeRef>ExclusiveGateway_2</flowNodeRef>
        <flowNodeRef>ExclusiveGateway_3</flowNodeRef>
      </lane>
      <lane id="Lane_3" name="Finance">
        <flowNodeRef>Task_7</flowNodeRef>
        <flowNodeRef>EndEvent_2</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="StartEvent_1" name="Receive request for new hardware">
      <outgoing>SequenceFlow_1</outgoing>
      <messageEventDefinition/>
    </startEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>
    <task id="Task_1" name="Analyze request">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="ExclusiveGateway_1"/>
    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
      <outgoing>SequenceFlow_4</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_3" name="approved" sourceRef="ExclusiveGateway_1" targetRef="Task_2"/>
    <sequenceFlow id="SequenceFlow_4" name="denied" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_1"/>
    <task id="Task_2" name="Edit and complete request">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_5</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_5" sourceRef="Task_2" targetRef="IntermediateThrowEvent_1"/>
    <intermediateThrowEvent id="IntermediateThrowEvent_1" name="Ask supplier about prices">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>MessageFlow_1</outgoing>
      <messageEventDefinition/>
    </intermediateThrowEvent>
    <intermediateCatchEvent id="IntermediateCatchEvent_1" name="Receive offer">
      <incoming>MessageFlow_2</incoming>
      <outgoing>SequenceFlow_6</outgoing>
      <messageEventDefinition/>
    </intermediateCatchEvent>
    <sequenceFlow id="SequenceFlow_6" sourceRef="IntermediateCatchEvent_1" targetRef="Task_3"/>
    <task id="Task_3" name="Fill in form and send to management">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_7" sourceRef="Task_3" targetRef="Task_5"/>
    <task id="Task_5" name="Analyze request">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_8" sourceRef="Task_5" targetRef="ExclusiveGateway_2"/>
    <exclusiveGateway id="ExclusiveGateway_2">
      <incoming>SequenceFlow_8</incoming>
      <outgoing>SequenceFlow_9</outgoing>
      <outgoing>SequenceFlow_10</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_9" name="approved" sourceRef="ExclusiveGateway_2" targetRef="Task_6"/>
    <sequenceFlow id="SequenceFlow_10" name="not approved" sourceRef="ExclusiveGateway_2" targetRef="ExclusiveGateway_3"/>
    <exclusiveGateway id="ExclusiveGateway_3">
      <incoming>SequenceFlow_10</incoming>
      <outgoing>SequenceFlow_11</outgoing>
      <outgoing>SequenceFlow_12</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_11" name="rework" sourceRef="ExclusiveGateway_3" targetRef="Task_2"/>
    <sequenceFlow id="SequenceFlow_12" name="denied" sourceRef="ExclusiveGateway_3" targetRef="EndEvent_1"/>
    <task id="Task_6" name="Prepare order">
      <incoming>SequenceFlow_9</incoming>
      <outgoing>MessageFlow_3</outgoing>
    </task>
    <sequenceFlow id="MessageFlow_3" sourceRef="Task_6" targetRef="Participant_2"/>
    <intermediateCatchEvent id="IntermediateCatchEvent_2" name="Order accepted">
      <incoming>MessageFlow_4</incoming>
      <outgoing>SequenceFlow_13</outgoing>
      <messageEventDefinition/>
    </intermediateCatchEvent>
    <messageFlow id="MessageFlow_4" sourceRef="Participant_2" targetRef="IntermediateCatchEvent_2"/>
    <sequenceFlow id="SequenceFlow_13" sourceRef="IntermediateCatchEvent_2" targetRef="Task_7"/>
    <task id="Task_7" name="Find financial resources and receive HW">
      <incoming>SequenceFlow_13</incoming>
      <outgoing>SequenceFlow_14</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_14" sourceRef="Task_7" targetRef="EndEvent_2"/>
    <endEvent id="EndEvent_1" name="Inform about denial">
      <incoming>SequenceFlow_4</incoming>
      <incoming>SequenceFlow_12</incoming>
    </endEvent>
    <endEvent id="EndEvent_2">
      <incoming>SequenceFlow_14</incoming>
    </endEvent>
  </process>
</definitions>