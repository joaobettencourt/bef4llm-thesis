<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/pec/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/pec/20100524/MODEL http://www.omg.org/spec/DD/20100524/DC/06-02-01.xsd" 
             id="definition">
   <process id="Process_1" isExecutable="true">
     <laneSet>
       <lane id="Lane_1" name="Department">
         <flowNodeRef>StartEvent_1</flowNodeRef>
         <flowNodeRef>Task_1</flowNodeRef>
         <flowNodeRef>Task_2</flowNodeRef>
         <flowNodeRef>ExclusiveGateway_1</flowNodeRef>
         <flowNodeRef>EndEvent_1</flowNodeRef>
       </lane>
       <lane id="Lane_2" name="Central Procurement Department">
         <flowNodeRef>Task_3</flowNodeRef>
         <flowNodeRef>ExclusiveGateway_2</flowNodeRef>
         <flowNodeRef>Task_4</flowNodeRef>
         <flowNodeRef>Task_5</flowNodeRef>
       </lane>
       <lane id="Lane_3" name="Approver">
         <flowNodeRef>Task_6</flowNodeRef>
         <flowNodeRef>EndEvent_2</flowNodeRef>
       </lane>
     </laneSet>
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>
     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="ExclusiveGateway_1"/>
     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
       <outgoing>SequenceFlow_3</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_2" name="Goods in stock" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_1"/>
     <sequenceFlow id="SequenceFlow_3" name="Goods not in stock" sourceRef="ExclusiveGateway_1" targetRef="Task_1"/>
     <task id="Task_1" name="Specify and quantify the demand">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_4</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_4" sourceRef="Task_1" targetRef="Task_2"/>
     <task id="Task_2" name="Create purchase requisition">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_2" targetRef="Task_3"/>
     <task id="Task_3" name="Check purchase requisition">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </task>
     <exclusiveGateway id="ExclusiveGateway_2">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_7</outgoing>
       <outgoing>SequenceFlow_8</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_3" targetRef="ExclusiveGateway_2"/>
     <sequenceFlow id="SequenceFlow_7" name="Supplier exists" sourceRef="ExclusiveGateway_2" targetRef="Task_4"/>
     <sequenceFlow id="SequenceFlow_8" name="Create supplier in ERP" sourceRef="ExclusiveGateway_2" targetRef="Task_5"/>
     <task id="Task_4" name="Create order template from purchase requisition">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_4" targetRef="Task_6"/>
     <task id="Task_5" name="Create supplier in ERP">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_10</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_10" sourceRef="Task_5" targetRef="Task_4"/>
     <task id="Task_6" name="Approve  & trigger order">
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_11</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_11" sourceRef="Task_6" targetRef="EndEvent_2"/>
     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_2</incoming>
     </endEvent>
     <endEvent id="EndEvent_2">
       <incoming>SequenceFlow_11</incoming>
     </endEvent>
   </process>
 </definitions>