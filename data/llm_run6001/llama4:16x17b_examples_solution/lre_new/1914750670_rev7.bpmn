<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:xsi="http://www.w3.4.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" 
             targetNamespace="http://bpmn.io/schema/bpmn">
   <collaboration id="Collaboration_1">
     <participant id="Participant_Customer" processRef="Process_Customer"/>
     <participant id="Participant_PostOffice" processRef="Process_PostOffice"/>
     <participant id="Participant_Bank" processRef="Process_Bank"/>
     <messageFlow id="MessageFlow_1" sourceRef="Task_GeneratePDF" targetRef="StartEvent_PostOffice"/>
     <messageFlow id="MessageFlow_2" sourceRef="Task_MailAccountRequest" targetRef="StartEvent_Bank"/>
   </collaboration>
   <process id="Process_Customer">
     <startEvent id="StartEvent_Customer">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>
     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_Customer" targetRef="Task_VisitBankWebsite"/>
     <task id="Task_VisitBankWebsite" name="Visit Bank Website">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_VisitBankWebsite" targetRef="Task_FillInPersonalData"/>
     <task id="Task_FillInPersonalData" name="Fill in personal data">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_3" sourceRef="Task_FillInPersonalData" targetRef="Task_GeneratePDF"/>
     <task id="Task_GeneratePDF" name="Generate and print Pdf">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_4</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_4" sourceRef="Task_GeneratePDF" targetRef="ExclusiveGateway_Customer"/>
     <eventBasedGateway id="ExclusiveGateway_Customer">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_5</outgoing>
       <outgoing>SequenceFlow_6</outgoing>
     </eventBasedGateway>
     <sequenceFlow id="SequenceFlow_5" sourceRef="ExclusiveGateway_Customer" targetRef="EndEvent_Refusal"/>
     <sequenceFlow id="SequenceFlow_6" sourceRef="ExclusiveGateway_Customer" targetRef="EndEvent_AccountDocuments"/>
     <endEvent id="EndEvent_Refusal">
       <incoming>SequenceFlow_5</incoming>
     </endEvent>
     <endEvent id="EndEvent_AccountDocuments">
       <incoming>SequenceFlow_6</incoming>
     </endEvent>
   </process>
   <process id="Process_PostOffice">
     <startEvent id="StartEvent_PostOffice">
       <incoming>MessageFlow_1</incoming>
       <outgoing>SequenceFlow_7</outgoing>
     </startEvent>
     <sequenceFlow id="SequenceFlow_7" sourceRef="StartEvent_PostOffice" targetRef="Task_AuthenticateCustomer"/>
     <task id="Task_AuthenticateCustomer" name="Authenticate Bank Customer">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_8</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_8" sourceRef="Task_AuthenticateCustomer" targetRef="Task_MailAccountRequest"/>
     <task id="Task_MailAccountRequest" name="Mail Account Request">
       <incoming>SequenceFlow_8</incoming>
     </task>
   </process>
   <process id="Process_Bank">
     <startEvent id="StartEvent_Bank">
       <incoming>MessageFlow_2</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </startEvent>
     <sequenceFlow id="SequenceFlow_9" sourceRef="StartEvent_Bank" targetRef="Task_CheckCustomerData"/>
     <task id="Task_CheckCustomerData" name="Check Customer Data">
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_10</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_10" sourceRef="Task_CheckCustomerData" targetRef="ExclusiveGateway_Bank"/>
     <exclusiveGateway id="ExclusiveGateway_Bank">
       <incoming>SequenceFlow_10</incoming>
       <outgoing>SequenceFlow_11</outgoing>
       <outgoing>SequenceFlow_12</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_11" sourceRef="ExclusiveGateway_Bank" targetRef="Task_MailAccountDocuments"/>
     <task id="Task_MailAccountDocuments" name="Mail Account Documents">
       <incoming>SequenceFlow_11</incoming>
     </task>
     <sequenceFlow id="SequenceFlow_12" sourceRef="ExclusiveGateway_Bank" targetRef="Task_MailLetterOfRefusal"/>
     <task id="Task_MailLetterOfRefusal" name="Mail letter of refusal">
       <incoming>SequenceFlow_12</incoming>
     </task>
   </process>
</definitions>