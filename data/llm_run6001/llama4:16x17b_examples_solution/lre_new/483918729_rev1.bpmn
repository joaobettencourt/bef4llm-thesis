<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:SchemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Provision Team Process"
             targetNamespace="http://bpmn.io/schema/bpmn">
   <collaboration id="Collaboration_1">
     <participant id="Participant_1" processRef="Process_1"/>
     <participant id="Participant_2" name="Customer"/>
     <participant id="Participant_3" name="Daisuki"/>
     <messageFlow id="MessageFlow_1" sourceRef="Participant_2" targetRef="Task_Identify_Parts"/>
     <messageFlow id="MessageFlow_2" sourceRef="Participant_2" targetRef="Task_Elicit_Info_From_Customer"/>
     <messageFlow id="MessageFlow_3" sourceRef="Task_Send_Contract_Customer" targetRef="Participant_2"/>
     <messageFlow id="MessageFlow_4" sourceRef="Task_Collect_Parts" targetRef="Participant_2"/>
     <messageFlow id="MessageFlow_5" sourceRef="Participant_2" targetRef="Task_Receive_Final_Payment"/>
     <messageFlow id="MessageFlow_6" sourceRef="Participant_3" targetRef="Subprocess_Order_and_Receive_Parts_From_Daisuki"/>
     <messageFlow id="MessageFlow_7" sourceRef="Subprocess_Order_and_Receive_Parts_From_Daisuki" targetRef="Participant_3"/>
   </collaboration>
   <process id="Process_1" isExecutable="true">
     <startEvent id="Start_Event_1">
       <outgoing>Sequence_Flow_1</outgoing>
       <messageEventDefinition/>
     </startEvent>
     <sequenceFlow id="Sequence_Flow_1" sourceRef="Start_Event_1" targetRef="Task_Identify_Parts"/>
     <task id="Task_Identify_Parts">
       <incoming>Sequence_Flow_1</incoming>
       <outgoing>Sequence_Flow_2</outgoing>
       <outgoing>Sequence_Flow_3</outgoing>
     </task>
     <sequenceFlow id="Sequence_Flow_2" sourceRef="Task_Identify_Parts" targetRef="Task_Elicit_Info_From_Customer"/>
     <sequenceFlow id="Sequence_Flow_3" sourceRef="Task_Identify_Parts" targetRef="Task_Check_Availability"/>
     <exclusiveGateway id="Exclusive_Gateway_1">
       <incoming>Sequence_Flow_2</incoming>
       <outgoing>Sequence_Flow_4</outgoing>
       <outgoing>Sequence_Flow_5</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="Sequence_Flow_4" sourceRef="Exclusive_Gateway_1" targetRef="Task_Elicit_Info_From_Customer"/>
     <task id="Task_Elicit_Info_From_Customer">
       <incoming>Sequence_Flow_4</incoming>
       <outgoing>Sequence_Flow_6</outgoing>
     </task>
     <sequenceFlow id="Sequence_Flow_5" sourceRef="Exclusive_Gateway_1" targetRef="Task_Check_Availability"/>
     <sequenceFlow id="Sequence_Flow_6" sourceRef="Task_Elicit_Info_From_Customer" targetRef="Task_Identify_Parts"/>
     <task id="Task_Check_Availability">
       <incoming>Sequence_Flow_3</incoming>
       <incoming>Sequence_Flow_6</incoming>
       <outgoing>Sequence_Flow_7</outgoing>
     </task>
     <sequenceFlow id="Sequence_Flow_7" sourceRef="Task_Check_Availability" targetRef="Exclusive_Gateway_2"/>
     <exclusiveGateway id="Exclusive_Gateway_2">
       <incoming>Sequence_Flow_7</incoming>
       <outgoing>Sequence_Flow_8</outgoing>
       <outgoing>Sequence_Flow_9</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="Sequence_Flow_8" sourceRef="Exclusive_Gateway_2" targetRef="Task_Supply_To_Customer"/>
     <task id="Task_Supply_To_Customer">
       <incoming>Sequence_Flow_8</incoming>
       <outgoing>Sequence_Flow_11</outgoing>
     </task>
     <sequenceFlow id="Sequence_Flow_9" sourceRef="Exclusive_Gateway_2" targetRef="Subprocess_Order_and_Receive_Parts_From_Daisuki"/>
     <subProcess id="Subprocess_Order_and_Receive_Parts_From_Daisuki">
       <incoming>Sequence_Flow_9</incoming>
       <outgoing>Sequence_Flow_12</outgoing>
     </subProcess>
     <sequenceFlow id="Sequence_Flow_11" sourceRef="Task_Supply_To_Customer" targetRef="End_Event_1"/>
     <task id="Task_Send_Contract_Customer">
       <incoming>Sequence_Flow_12</incoming>
       <outgoing>Sequence_Flow_13</outgoing>
     </task>
     <sequenceFlow id="Sequence_Flow_12" sourceRef="Subprocess_Order_and_Receive_Parts_From_Daisuki" targetRef="Task_Send_Contract_Customer"/>
     <task id="Task_Collect_Parts">
       <incoming>Sequence_Flow_13</incoming>
       <outgoing>Sequence_Flow_14</outgoing>
     </task>
     <sequenceFlow id="Sequence_Flow_13" sourceRef="Task_Send_Contract_Customer" targetRef="Task_Collect_Parts"/>
     <task id="Task_Receive_Final_Payment">
       <incoming>Sequence_Flow_14</incoming>
       <outgoing>Sequence_Flow_15</outgoing>
     </task>
     <sequenceFlow id="Sequence_Flow_14" sourceRef="Task_Collect_Parts" targetRef="Task_Receive_Final_Payment"/>
     <endEvent id="End_Event_1">
       <incoming>Sequence_Flow_11</incoming>
     </endEvent>
   </process>
</definitions>