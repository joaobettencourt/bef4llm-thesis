<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" 
             targetNamespace="http://bpmn.io/schema/bpmn">
   <collaboration id="Collaboration_1">
     <participant id="Participant_1" processRef="Process_1"/>
   </collaboration>
   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>
     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>
     <task id="Task_1" name="Vendor located in SAP system">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
       <outgoing>SequenceFlow_3</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="SubProcess_1"/>
     <sequenceFlow id="SequenceFlow_3" sourceRef="Task_1" targetRef="Task_7"/>
     <subProcess id="SubProcess_1">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_4</outgoing>
       <startEvent id="StartEvent_Subprocess_1">
         <outgoing>SequenceFlow_5</outgoing>
       </startEvent>
       <sequenceFlow id="SequenceFlow_5" sourceRef="StartEvent_Subprocess_1" targetRef="Task_2"/>
       <task id="Task_2" name="Fill out request for new Vendor Master Record form">
         <incoming>SequenceFlow_5</incoming>
         <outgoing>SequenceFlow_6</outgoing>
       </task>
       <sequenceFlow id="SequenceFlow_6" sourceRef="Task_2" targetRef="Task_3"/>
       <task id="Task_3" name="Staple request to invoice">
         <incoming>SequenceFlow_6</incoming>
         <outgoing>SequenceFlow_7</outgoing>
       </task>
       <sequenceFlow id="SequenceFlow_7" sourceRef="Task_3" targetRef="Task_4"/>
       <task id="Task_4" name="Place invoice in internal outbox for new vendors">
         <incoming>SequenceFlow_7</incoming>
         <outgoing>SequenceFlow_8</outgoing>
       </task>
       <sequenceFlow id="SequenceFlow_8" sourceRef="Task_4" targetRef="ExclusiveGateway_1"/>
       <exclusiveGateway id="ExclusiveGateway_1">
         <incoming>SequenceFlow_8</incoming>
         <outgoing>SequenceFlow_9</outgoing>
         <outgoing>SequenceFlow_10</outgoing>
       </exclusiveGateway>
       <sequenceFlow id="SequenceFlow_9" name="urgent invoice" sourceRef="ExclusiveGateway_1" targetRef="IntermediateCatchEvent_1"/>
       <sequenceFlow id="SequenceFlow_10" name="non-urgent invoice" sourceRef="ExclusiveGateway_1" targetRef="IntermediateCatchEvent_2"/>
       <intermediateCatchEvent id="IntermediateCatchEvent_1">
         <incoming>SequenceFlow_9</incoming>
         <outgoing>SequenceFlow_11</outgoing>
         <timerEventDefinition/>
       </intermediateCatchEvent>
       <sequenceFlow id="SequenceFlow_11" sourceRef="IntermediateCatchEvent_1" targetRef="End_Subprocess_1"/>
       <endEvent id="End_Subprocess_1">
         <incoming>SequenceFlow_11</incoming>
       </endEvent>
       <intermediateCatchEvent id="IntermediateCatchEvent_2">
         <incoming>SequenceFlow_10</incoming>
         <outgoing>SequenceFlow_12</outgoing>
         <timerEventDefinition/>
       </intermediateCatchEvent>
       <sequenceFlow id="SequenceFlow_12" sourceRef="IntermediateCatchEvent_2" targetRef="End_Subprocess_1"/>
     </subProcess>
     <sequenceFlow id="SequenceFlow_4" name="Vendor exists" sourceRef="End_Subprocess_1" targetRef="Task_7"/>
     <task id="Task_7" name="SAP Vendor number added to invoice">
       <incoming>SequenceFlow_3</incoming>
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_13</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_13" sourceRef="Task_7" targetRef="ExclusiveGateway_2"/>
     <exclusiveGateway id="ExclusiveGateway_2">
       <incoming>SequenceFlow_13</incoming>
       <outgoing>SequenceFlow_14</outgoing>
       <outgoing>SequenceFlow_15</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_14" name="sort by vendor" sourceRef="ExclusiveGateway_2" targetRef="Task_8"/>
     <task id="Task_8" name="Invoices sorted by Vendor">
       <incoming>SequenceFlow_14</incoming>
       <outgoing>SequenceFlow_16</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_16" sourceRef="Task_8" targetRef="ExclusiveGateway_3"/>
     <exclusiveGateway id="ExclusiveGateway_3">
       <incoming>SequenceFlow_16</incoming>
       <outgoing>SequenceFlow_17</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_17" sourceRef="ExclusiveGateway_3" targetRef="Task_9"/>
     <task id="Task_9" name="Invoices entered into SAP system">
       <incoming>SequenceFlow_17</incoming>
       <outgoing>SequenceFlow_18</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_15" sourceRef="ExclusiveGateway_2" targetRef="Task_10"/>
     <task id="Task_10" name="Invoices sorted by amount">
       <incoming>SequenceFlow_15</incoming>
       <outgoing>SequenceFlow_19</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_19" sourceRef="Task_10" targetRef="ExclusiveGateway_3"/>
     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_18</incoming>
     </endEvent>
   </process>
</definitions>