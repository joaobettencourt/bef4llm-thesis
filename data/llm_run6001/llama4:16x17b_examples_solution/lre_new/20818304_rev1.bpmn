<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Credit Process">
   <collaboration id="Collaboration_1">
     <participant id="Participant_1" processRef="Process_1"/>
     <messageFlow id="MessageFlow_1" sourceRef="Customer" targetRef="StartEvent_1"/> 
     <messageFlow id="MessageFlow_2" sourceRef="EndEvent_Accepted" targetRef="Customer"/> 
     <messageFlow id="MessageFlow_3" sourceRef="EndEvent_Rejected" targetRef="Customer"/> 
   </collaboration>
   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
       <messageEventDefinition/>
     </startEvent>
     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_CollectCreditInfo"/>
     <task id="Task_CollectCreditInfo">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_CollectCreditInfo" targetRef="ExclusiveGateway_1"/>
     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_4</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_3" name="Amount > 1M$" sourceRef="ExclusiveGateway_1" targetRef="Task_RequestApproval"/>
     <task id="Task_RequestApproval">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_RequestApproval" targetRef="ExclusiveGateway_2"/>
     <exclusiveGateway id="ExclusiveGateway_2">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_6</outgoing>
       <outgoing>SequenceFlow_7</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_6" name="Credit = accepted" sourceRef="ExclusiveGateway_2" targetRef="EndEvent_Accepted"/>
     <endEvent id="EndEvent_Accepted">
       <incoming>SequenceFlow_6</incoming>
       <messageEventDefinition/>
     </endEvent>
     <sequenceFlow id="SequenceFlow_7" name="Credit = rejected" sourceRef="ExclusiveGateway_2" targetRef="Task_RejectCredit"/>
     <task id="Task_RejectCredit">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_8</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_8" sourceRef="Task_RejectCredit" targetRef="EndEvent_Rejected"/>
     <endEvent id="EndEvent_Rejected">
       <incoming>SequenceFlow_8</incoming>
       <messageEventDefinition/>
     </endEvent>
     <sequenceFlow id="SequenceFlow_4" name="Amount <= 1M$" sourceRef="ExclusiveGateway_1" targetRef="Task_AssessRisk"/>
     <task id="Task_AssessRisk">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_AssessRisk" targetRef="ExclusiveGateway_3"/>
     <exclusiveGateway id="ExclusiveGateway_3">
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_10</outgoing>
       <outgoing>SequenceFlow_11</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_10" name="Risk = low" sourceRef="ExclusiveGateway_3" targetRef="EndEvent_Accepted"/>
     <sequenceFlow id="SequenceFlow_11" name="Risk = high" sourceRef="ExclusiveGateway_3" targetRef="Task_RequestApproval"/>
   </process>
</definitions>