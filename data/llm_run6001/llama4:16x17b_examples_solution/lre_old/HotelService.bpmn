<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" targetNamespace="http://www.example.com">

   <process id="RoomServiceProcess" isExecutable="true">
     <laneSet>
       <lane id="RoomServiceManagerLane" name="Room-Service Manager">
         <flowNodeRef>StartEvent</flowNodeRef>
         <flowNodeRef>Task_TakeDownOrder</flowNodeRef>
         <flowNodeRef>ParallelGateway_PrepareOrder</flowNodeRef>
         <flowNodeRef>Task_AssignOrderToWaiter</flowNodeRef>
       </lane>
       <lane id="KitchenLane" name="Kitchen">
         <flowNodeRef>Task_PrepareMeal</flowNodeRef>
       </lane>
       <lane id="SommelierLane" name="Sommelier">
         <flowNodeRef>Task_FetchWineAndBeverages</flowNodeRef>
       </lane>
       <lane id="WaiterLane" name="Waiter">
         <flowNodeRef>Task_ReadyCart</flowNodeRef>
         <flowNodeRef>Task_DeliverToGuestRoom</flowNodeRef>
         <flowNodeRef>Task_ReturnToStationAndDebitAccount</flowNodeRef>
       </lane>
     </laneSet>

     <startEvent id="StartEvent">
       <outgoing>SequenceFlow_TakeOrder</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_TakeOrder" sourceRef="StartEvent" targetRef="Task_TakeDownOrder"/>

     <task id="Task_TakeDownOrder" name="Take down order">
       <outgoing>SequenceFlow_SubmitOrder</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_SubmitOrder" sourceRef="Task_TakeDownOrder" targetRef="ParallelGateway_PrepareOrder"/>

     <parallelGateway id="ParallelGateway_PrepareOrder">
       <incoming>SequenceFlow_SubmitOrder</incoming>
       <outgoing>SequenceFlow_PrepareMeal</outgoing>
       <outgoing>SequenceFlow_FetchWineAndBeverages</outgoing>
       <outgoing>SequenceFlow_AssignOrderToWaiter</outgoing>
     </parallelGateway>

     <sequenceFlow id="SequenceFlow_PrepareMeal" sourceRef="ParallelGateway_PrepareOrder" targetRef="Task_PrepareMeal"/>

     <task id="Task_PrepareMeal" name="Prepare meal">
       <outgoing>SequenceFlow_MealPrepared</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_MealPrepared" sourceRef="Task_PrepareMeal" targetRef="ParallelGateway_WaiterTasks"/>

     <sequenceFlow id="SequenceFlow_FetchWineAndBeverages" sourceRef="ParallelGateway_PrepareOrder" targetRef="Task_FetchWineAndBeverages"/>

     <task id="Task_FetchWineAndBeverages" name="Fetch wine and prepare beverages">
       <outgoing>SequenceFlow_WinePrepared</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_WinePrepared" sourceRef="Task_FetchWineAndBeverages" targetRef="ExclusiveGateway_NonAlcoholicDrinks"/>

     <exclusiveGateway id="ExclusiveGateway_NonAlcoholicDrinks">
       <incoming>SequenceFlow_WinePrepared</incoming>
       <outgoing>SequenceFlow_PrepareNonAlcoholicDrinks</outgoing>
       <outgoing>SequenceFlow_NoNonAlcoholicDrinks</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_AssignOrderToWaiter" sourceRef="ParallelGateway_PrepareOrder" targetRef="Task_AssignOrderToWaiter"/>

     <task id="Task_AssignOrderToWaiter" name="Assign order to waiter">
       <outgoing>SequenceFlow_OrderAssigned</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_OrderAssigned" sourceRef="Task_AssignOrderToWaiter" targetRef="ExclusiveGateway_NonAlcoholicDrinks"/>

     <sequenceFlow id="SequenceFlow_PrepareNonAlcoholicDrinks" sourceRef="ExclusiveGateway_NonAlcoholicDrinks" targetRef="Task_PrepareNonAlcoholicDrinks"/>
     <task id="Task_PrepareNonAlcoholicDrinks" name="Prepare non-alcoholic drinks">
       <outgoing>SequenceFlow_NonAlcoholicPrepared</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_NoNonAlcoholicDrinks" sourceRef="ExclusiveGateway_NonAlcoholicDrinks" targetRef="ParallelGateway_WaiterTasks"/>

     <parallelGateway id="ParallelGateway_WaiterTasks">
       <incoming>SequenceFlow_MealPrepared</incoming>
       <incoming>SequenceFlow_NonAlcoholicPrepared</incoming>
       <outgoing>SequenceFlow_TasksCompleted</outgoing>
     </parallelGateway>

     <sequenceFlow id="SequenceFlow_TasksCompleted" sourceRef="ParallelGateway_WaiterTasks" targetRef="Task_ReadyCart"/>

     <task id="Task_ReadyCart" name="Ready cart">
       <outgoing>SequenceFlow_CartReady</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_CartReady" sourceRef="Task_ReadyCart" targetRef="Task_DeliverToGuestRoom"/>
     <task id="Task_DeliverToGuestRoom" name="Deliver to guest's room">
       <outgoing>SequenceFlow_Delivered</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_Delivered" sourceRef="Task_DeliverToGuestRoom" targetRef="Task_ReturnToStationAndDebitAccount"/>
     <task id="Task_ReturnToStationAndDebitAccount" name="Return to room-service station and debit guest's account">
       <outgoing>SequenceFlow_Complete</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_Complete" sourceRef="Task_ReturnToStationAndDebitAccount" targetRef="EndEvent"/>

     <endEvent id="EndEvent">
       <incoming>SequenceFlow_Complete</incoming>
     </endEvent>
   </process>
</definitions>