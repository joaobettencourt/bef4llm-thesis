<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" targetNamespace="http://www.example.com">

   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
       <messageEventDefinition/>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>

     <task id="Task_1" name="Get information about possible subrogation">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="ExclusiveGateway_1"/>

     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_4</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_1" targetRef="Task_2">
       <conditionExpression xsi:type="tFormalExpression">${subrogation.possible  == true}</conditionExpression>
     </sequenceFlow>

     <task id="Task_2" name="Check case and send request for payment">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_2" targetRef="Task_3"/>

     <task id="Task_3" name="Send reminder">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_3" targetRef="EventBasedGateway_1"/>

     <eventBasedGateway id="EventBasedGateway_1">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_7</outgoing>
       <outgoing>SequenceFlow_8</outgoing>
       <outgoing>SequenceFlow_9</outgoing>
     </eventBasedGateway>

     <intermediateCatchEvent id="IntermediateCatchEvent_1" name="Disagreement letter received">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_10</outgoing>
       <messageEventDefinition/>
     </intermediateCatchEvent>

     <sequenceFlow id="SequenceFlow_7" sourceRef="EventBasedGateway_1" targetRef="IntermediateCatchEvent_1"/>

     <task id="Task_4" name="Check reasoning">
       <incoming>SequenceFlow_10</incoming>
       <outgoing>SequenceFlow_11</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_10" sourceRef="IntermediateCatchEvent_1" targetRef="Task_4"/>

     <exclusiveGateway id="ExclusiveGateway_2">
       <incoming>SequenceFlow_11</incoming>
       <outgoing>SequenceFlow_12</outgoing>
       <outgoing>SequenceFlow_13</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_11" sourceRef="Task_4" targetRef="ExclusiveGateway_2"/>

     <task id="Task_5" name="Close case">
       <incoming>SequenceFlow_12</incoming>
       <outgoing>SequenceFlow_14</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_12" sourceRef="ExclusiveGateway_2" targetRef="Task_5">
       <conditionExpression xsi:type="tFormalExpression">${reasoning.OK  == true}</conditionExpression>
     </sequenceFlow>

     <endEvent id="EndEvent_1" name="Case closed">
       <incoming>SequenceFlow_14</incoming>
     </endEvent>

     <sequenceFlow id="SequenceFlow_14" sourceRef="Task_5" targetRef="EndEvent_1"/>

     <intermediateCatchEvent id="IntermediateCatchEvent_2" name="Deadline for disagreement reached or Money received">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_15</outgoing>
       <timerEventDefinition/>
     </intermediateCatchEvent>

     <sequenceFlow id="SequenceFlow_8" sourceRef="EventBasedGateway_1" targetRef="IntermediateCatchEvent_2"/>

     <task id="Task_6" name="Hand over to collection agency or make booking">
       <incoming>SequenceFlow_15</incoming>
       <outgoing>SequenceFlow_16</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_15" sourceRef="IntermediateCatchEvent_2" targetRef="Task_6"/>

     <endEvent id="EndEvent_2" name="Case forwarded or closed">
       <incoming>SequenceFlow_16</incoming>
     </endEvent>

     <sequenceFlow id="SequenceFlow_16" sourceRef="Task_6" targetRef="EndEvent_2"/>
   </process>
</definitions>