<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" targetNamespace="http://www.example.com">

   <collaboration id="Collaboration_0">
     <participant id="Participant_0" name="MSP" processRef="Process_0"/>
     <participant id="Participant_1" name="GO" processRef="Process_1"/>
     <messageFlow id="MessageFlow_0" sourceRef="Task_6" targetRef="StartEvent_2"/>
     <messageFlow id="MessageFlow_1" sourceRef="IntermediateCatchEvent_1" targetRef="Task_5"/>
   </collaboration>

   <process id="Process_0" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_0"/>

     <task id="Task_0" name="Request measurements from GO">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_0" targetRef="ExclusiveGateway_0"/>

     <exclusiveGateway id="ExclusiveGateway_0">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_4</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_0" targetRef="Task_1">
       <conditionExpression xsi:type="tFormalExpression">${measurements.granted = true}</conditionExpression>
     </sequenceFlow>

     <task id="Task_1" name="Perform measurements">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_0" targetRef="Task_2"/>

     <task id="Task_2" name="Deny request">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_1" targetRef="IntermediateCatchEvent_0"/>

     <intermediateCatchEvent id="IntermediateCatchEvent_0">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_7</outgoing>
     </intermediateCatchEvent>

     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_2" targetRef="EndEvent_0"/>

     <endEvent id="EndEvent_0">
       <incoming>SequenceFlow_6</incoming>
     </endEvent>

     <sequenceFlow id="SequenceFlow_7" sourceRef="IntermediateCatchEvent_0" targetRef="Task_3"/>

     <task id="Task_3" name="Transmit measured values to GO">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_8</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_8" sourceRef="Task_3" targetRef="EndEvent_1"/>

     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_8</incoming>
     </endEvent>
   </process>

   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_2">
       <incoming>MessageFlow_0</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_9" sourceRef="StartEvent_2" targetRef="Task_4"/>

     <task id="Task_4" name="Process measured values">
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_10</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_10" sourceRef="Task_4" targetRef="Task_5"/>

     <task id="Task_5" name="Send changed values to MSP">
       <incoming>SequenceFlow_10</incoming>
       <outgoing>MessageFlow_1</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_11" sourceRef="IntermediateCatchEvent_1" targetRef="Task_6"/>

     <intermediateCatchEvent id="IntermediateCatchEvent_1">
       <incoming>MessageFlow_1</incoming>
       <outgoing>SequenceFlow_11</outgoing>
     </intermediateCatchEvent>

     <task id="Task_6" name="Transmit readings to SP">
       <incoming>SequenceFlow_11</incoming>
     </task>
   </process>
</definitions>