<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" targetNamespace="http://www.example.com">

   <process id="ExpenseReportProcess" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="ExclusiveGateway_AccountExists"/>

     <exclusiveGateway id="ExclusiveGateway_AccountExists">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
       <outgoing>SequenceFlow_3</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_2" sourceRef="ExclusiveGateway_AccountExists" targetRef="Task_ReviewForAutoApproval">
       <conditionExpression xsi:type="tFormalExpression">${employee.hasAccount()}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_AccountExists" targetRef="Task_CreateAccount">
       <conditionExpression xsi:type="tFormalExpression">${!employee.hasAccount()}</conditionExpression>
     </sequenceFlow>

     <task id="Task_CreateAccount" name="Create Account for Employee">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_4</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_4" sourceRef="Task_CreateAccount" targetRef="Task_ReviewForAutoApproval"/>

     <task id="Task_ReviewForAutoApproval" name="Review for Automatic Approval">
       <incoming>SequenceFlow_2</incoming>
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_ReviewForAutoApproval" targetRef="ExclusiveGateway_AutoApprove"/>

     <exclusiveGateway id="ExclusiveGateway_AutoApprove">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_6</outgoing>
       <outgoing>SequenceFlow_7</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_6" sourceRef="ExclusiveGateway_AutoApprove" targetRef="Task_SendForPayment">
       <conditionExpression xsi:type="tFormalExpression">${expenseReport.amount  < 200}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="SequenceFlow_7" sourceRef="ExclusiveGateway_AutoApprove" targetRef="Task_ConductSupervisorReview">
       <conditionExpression xsi:type="tFormalExpression">${expenseReport.amount  >= 200}</conditionExpression>
     </sequenceFlow>

     <task id="Task_SendForPayment" name="Send for Payment">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_8</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_8" sourceRef="Task_SendForPayment" targetRef="EndEvent_PaymentSuccessful"/>

     <endEvent id="EndEvent_PaymentSuccessful">
       <incoming>SequenceFlow_8</incoming>
     </endEvent>

     <task id="Task_ConductSupervisorReview" name="Conduct Supervisor Review">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_ConductSupervisorReview" targetRef="ExclusiveGateway_ApprovePayment"/>

     <exclusiveGateway id="ExclusiveGateway_ApprovePayment">
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_10</outgoing>
       <outgoing>SequenceFlow_11</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_10" sourceRef="ExclusiveGateway_ApprovePayment" targetRef="Task_SendRejectionNotice">
       <conditionExpression xsi:type="tFormalExpression">${supervisor.approved == false}</conditionExpression>
     </sequenceFlow>

     <task id="Task_SendRejectionNotice" name="Send Rejection Notice by Email">
       <incoming>SequenceFlow_10</incoming>
       <outgoing>SequenceFlow_12</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_11" sourceRef="ExclusiveGateway_ApprovePayment" targetRef="Task_SendForPaymentApproved">
       <conditionExpression xsi:type="tFormalExpression">${supervisor.approved == true}</conditionExpression>
     </sequenceFlow>

     <task id="Task_SendForPaymentApproved" name="Send for Payment Approved">
       <incoming>SequenceFlow_11</incoming>
       <outgoing>SequenceFlow_13</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_12" sourceRef="Task_SendRejectionNotice" targetRef="EndEvent_Rejected"/>

     <endEvent id="EndEvent_Rejected">
       <incoming>SequenceFlow_12</incoming>
     </endEvent>

     <sequenceFlow id="SequenceFlow_13" sourceRef="Task_SendForPaymentApproved" targetRef="IntermediateCatchEvent_InProgressEmail"/>


     <intermediateCatchEvent id="IntermediateCatchEvent_InProgressEmail">
       <incoming>SequenceFlow_13</incoming>
       <outgoing>SequenceFlow_14</outgoing>
     </intermediateCatchEvent>

     <sequenceFlow id="SequenceFlow_14" sourceRef="IntermediateCatchEvent_InProgressEmail" targetRef="EndEvent_Cancelled"/>


     <endEvent id="EndEvent_Cancelled">
       <!--<incoming>SequenceFlow_15</incoming>-->
     </endEvent>

     <intermediateTimerEvent id="IntermediateTimerEvent_CancellationNotice">
       <outgoing>SequenceFlow_16</outgoing>
     </intermediateTimerEvent>

     <sequenceFlow id="SequenceFlow_16" sourceRef="IntermediateTimerEvent_CancellationNotice" targetRef="Task_SendCancellationNotice"/>


     <task id="Task_SendCancellationNotice" name="Send Cancellation Notice by Email and Advise to Re-Submit Expense Report">
       <incoming>SequenceFlow_16</incoming>
       <!--<outgoing>SequenceFlow_17</outgoing>-->
     </task>

   </process>
</definitions>