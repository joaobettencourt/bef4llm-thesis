<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
                 id="definition" targetNamespace="http://www.example.com">

  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_0" name="MPON" processRef="Pool_0"/>
    <bpmn:participant id="Participant_1" name="MPOO" processRef="Pool_1"/>
    <bpmn:messageFlow id="MessageFlow_2" sourceRef="Task_0" targetRef="StartEvent_1"/>
    <bpmn:messageFlow id="MessageFlow_1" sourceRef="Task_1" targetRef="Task_2"/>
    <bpmn:messageFlow id="MessageFlow_3" sourceRef="Task_3" targetRef="EndEvent_0"/>
  </bpmn:collaboration>

  <bpmn:process id="Pool_0" isExecutable="true">
    <bpmn:startEvent id="StartEvent_0">
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_0" name="Request a device takeover bid">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_0" targetRef="Task_0"/>
    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="Task_0" targetRef="Task_1"/>

    <bpmn:task id="Task_1" name="Order">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="Task_1" targetRef="EndEvent_0"/>

    <bpmn:endEvent id="EndEvent_0">
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>

  <bpmn:process id="Pool_1" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_2" name="Tender the equipment takeover">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="StartEvent_1" targetRef="Task_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="Task_2" targetRef="Task_3"/>

    <bpmn:task id="Task_3" name="Confirm order and transmission of master data">
      <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="Task_3" targetRef="EndEvent_1"/>

    <bpmn:endEvent id="EndEvent_1">
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>

</bpmn:definitions>