<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" targetNamespace="http://www.example.com">

  <process id="claimHandlingProcess" isExecutable="true">
    <startEvent id="registerClaim">
      <outgoing>examineClaim</outgoing>
    </startEvent>

    <sequenceFlow id="examineClaimFlow" sourceRef="registerClaim" targetRef="examineClaim"/>

    <task id="examineClaim" name="Examine claim">
      <incoming>examineClaimFlow</incoming>
      <outgoing>writeRecommendation</outgoing>
    </task>

    <sequenceFlow id="writeRecommendationFlow" sourceRef="examineClaim" targetRef="writeRecommendation"/>

    <task id="writeRecommendation" name="Write settlement recommendation">
      <incoming>writeRecommendationFlow</incoming>
      <outgoing>checkRecommendation</outgoing>
    </task>

    <sequenceFlow id="checkRecommendationFlow" sourceRef="writeRecommendation" targetRef="checkRecommendation"/>

    <task id="checkRecommendation" name="Check recommendation">
      <incoming>checkRecommendationFlow</incoming>
      <outgoing>claimDecision</outgoing>
    </task>

    <exclusiveGateway id="claimDecision">
      <incoming>claimDecisionIncoming</incoming>
      <outgoing>okFlow</outgoing>
      <outgoing>notOkFlow</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="claimDecisionIncoming" sourceRef="checkRecommendation" targetRef="claimDecision"/>

    <sequenceFlow id="okFlow" name="OK" sourceRef="claimDecision" targetRef="endEvent">
      <conditionExpression xsi:type="tFormalExpression">${recommendation.approved == true}</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="notOkFlow" name="Not OK" sourceRef="claimDecision" targetRef="examineClaim">
      <conditionExpression xsi:type="tFormalExpression">${recommendation.approved == false}</conditionExpression>
    </sequenceFlow>

    <endEvent id="endEvent">
      <incoming>okFlow</incoming>
    </endEvent>
  </process>
</definitions>