<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" targetNamespace="http://www.example.com">

   <process id="Process_1" isExecutable="true">
     <laneSet>
       <lane id="Lane_MailProcessingUnit" name="Mail Processing Unit">
         <flowNodeRef>StartEvent_1</flowNodeRef>
         <flowNodeRef>Task_CollectMail</flowNodeRef>
         <flowNodeRef>Task_SortUnopenedMail</flowNodeRef>
       </lane>
       <lane id="Lane_Registry" name="Registry">
         <flowNodeRef>Task_SortOpenedMail</flowNodeRef>
         <flowNodeRef>Task_RegisterMail</flowNodeRef>
         <flowNodeRef>Task_CheckCompliance</flowNodeRef>
         <flowNodeRef>ExclusiveGateway_Compliance</flowNodeRef>
         <flowNodeRef>Task_PrepareRejection</flowNodeRef>
         <flowNodeRef>EndEvent_Rejected</flowNodeRef>
       </lane>
       <lane id="Lane_Cashier" name="Cashier">
         <flowNodeRef>ExclusiveGateway_Proceed</flowNodeRef>
         <flowNodeRef>Task_CaptureDetails</flowNodeRef>
         <flowNodeRef>Task_PrintFile</flowNodeRef>
         <flowNodeRef>EndEvent_FilePrinted</flowNodeRef>
       </lane>
     </laneSet>

     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_StartToCollectMail</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_StartToCollectMail" sourceRef="StartEvent_1" targetRef="Task_CollectMail"/>

     <task id="Task_CollectMail" name="Collect mail">
       <incoming>SequenceFlow_StartToCollectMail</incoming>
       <outgoing>SequenceFlow_CollectToSortUnopenedMail</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_CollectToSortUnopenedMail" sourceRef="Task_CollectMail" targetRef="Task_SortUnopenedMail"/>

     <task id="Task_SortUnopenedMail" name="Sort unopened mail">
       <incoming>SequenceFlow_CollectToSortUnopenedMail</incoming>
       <outgoing>SequenceFlow_SortUnopenedToSortOpenedMail</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_SortUnopenedToSortOpenedMail" sourceRef="Task_SortUnopenedMail" targetRef="Task_SortOpenedMail"/>

     <task id="Task_SortOpenedMail" name="Sort opened mail">
       <incoming>SequenceFlow_SortUnopenedToSortOpenedMail</incoming>
       <outgoing>SequenceFlow_SortOpenedToRegisterMail</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_SortOpenedToRegisterMail" sourceRef="Task_SortOpenedMail" targetRef="Task_RegisterMail"/>

     <task id="Task_RegisterMail" name="Register mail">
       <incoming>SequenceFlow_SortOpenedToRegisterMail</incoming>
       <outgoing>SequenceFlow_RegisterToCheckCompliance</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_RegisterToCheckCompliance" sourceRef="Task_RegisterMail" targetRef="Task_CheckCompliance"/>

     <task id="Task_CheckCompliance" name="Check mail compliance">
       <incoming>SequenceFlow_RegisterToCheckCompliance</incoming>
       <outgoing>SequenceFlow_ComplianceToExclusiveGateway</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_ComplianceToExclusiveGateway" sourceRef="Task_CheckCompliance" targetRef="ExclusiveGateway_Compliance"/>

     <exclusiveGateway id="ExclusiveGateway_Compliance">
       <incoming>SequenceFlow_ComplianceToExclusiveGateway</incoming>
       <outgoing>SequenceFlow_Rejected</outgoing>
       <outgoing>SequenceFlow_Approved</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_Rejected" name="No" sourceRef="ExclusiveGateway_Compliance" targetRef="Task_PrepareRejection"/>

     <task id="Task_PrepareRejection" name="Compile mail document requisition">
       <incoming>SequenceFlow_Rejected</incoming>
       <outgoing>SequenceFlow_RejectionToEndEvent</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_RejectionToEndEvent" sourceRef="Task_PrepareRejection" targetRef="EndEvent_Rejected"/>

     <endEvent id="EndEvent_Rejected">
       <incoming>SequenceFlow_RejectionToEndEvent</incoming>
     </endEvent>

     <sequenceFlow id="SequenceFlow_Approved" name="Yes" sourceRef="ExclusiveGateway_Compliance" targetRef="Task_CaptureDetails"/>

     <exclusiveGateway id="ExclusiveGateway_Proceed">
       <incoming>SequenceFlow_Approved</incoming>
       <outgoing>SequenceFlow_DetailsCaptured</outgoing>
       <outgoing>SequenceFlow_FilePrinted</outgoing>
     </exclusiveGateway>

     <task id="Task_CaptureDetails" name="Capture P&E party details and receipt fee payment">
       <incoming>SequenceFlow_Approved</incoming>
       <outgoing>SequenceFlow_DetailsCapturedToProceed</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_DetailsCapturedToProceed" sourceRef="Task_CaptureDetails" targetRef="ExclusiveGateway_Proceed"/>

     <sequenceFlow id="SequenceFlow_DetailsCaptured" sourceRef="ExclusiveGateway_Proceed" targetRef="EndEvent_FilePrinted"/>

     <task id="Task_PrintFile" name="Print physical file">
       <incoming>SequenceFlow_FilePrinted</incoming>
     </task>

     <endEvent id="EndEvent_FilePrinted">
       <incoming>SequenceFlow_DetailsCaptured</incoming>
     </endEvent>
   </process>
</definitions>