<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" targetNamespace="http://www.example.com">

  <collaboration id="Collaboration_1">
    <participant id="Participant_0" name="" processRef="Pool_0"/>
  </collaboration>

  <process id="Pool_0" isExecutable="true">
    <laneSet>
      <lane id="Lane_0" name="Functional Department">
        <flowNodeRef>StartEvent_1</flowNodeRef>
        <flowNodeRef>Task_0</flowNodeRef>
        <flowNodeRef>EndEvent_1</flowNodeRef>
      </lane>
      <lane id="Lane_1" name="HR Department">
        <flowNodeRef>Task_1</flowNodeRef>
        <flowNodeRef>Task_2</flowNodeRef>
        <flowNodeRef>Task_3</flowNodeRef>
      </lane>
      <lane id="Lane_2" name="Applicant">
        <flowNodeRef>Task_4</flowNodeRef>
      </lane>
    </laneSet>

    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_0"/>
    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_0" targetRef="Task_1"/>
    <sequenceFlow id="SequenceFlow_3" sourceRef="Task_1" targetRef="Task_4"/>
    <sequenceFlow id="SequenceFlow_4" sourceRef="Task_4" targetRef="Task_2"/>
    <sequenceFlow id="SequenceFlow_5" sourceRef="Task_2" targetRef="Task_3"/>
    <sequenceFlow id="SequenceFlow_6" sourceRef="Task_3" targetRef="EndEvent_1"/>

    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>

    <task id="Task_0" name="Report vacancy">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </task>

    <endEvent id="EndEvent_1">
      <incoming>SequenceFlow_6</incoming>
    </endEvent>

    <task id="Task_1" name="Advertise post">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
    </task>

    <task id="Task_4" name="Apply">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_4</outgoing>
    </task>

    <task id="Task_2" name="Check application">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_5</outgoing>
    </task>

    <task id="Task_3" name="Fill post">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </task>
  </process>
</definitions>