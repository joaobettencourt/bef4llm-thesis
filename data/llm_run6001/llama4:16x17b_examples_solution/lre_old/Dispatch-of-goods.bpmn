<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" targetNamespace="http://www.example.com">

  <process id="Process_1" isExecutable="true">
    <laneSet>
      <lane id="Lane_Secretary" name="Secretary">
        <flowNodeRef>Task_ClarifyShipmentMethod</flowNodeRef>
        <flowNodeRef>Task_GetOffers</flowNodeRef>
        <flowNodeRef>Task_SelectLogisticCompany</flowNodeRef>
        <flowNodeRef>Task_WritePackageLabel</flowNodeRef>
        <flowNodeRef>StartEvent_ShipGoods</flowNodeRef>
        <flowNodeRef>InclusiveGateway_PrepareShipment</flowNodeRef>
        <flowNodeRef>ExclusiveGateway_SpecialHandling</flowNodeRef>
      </lane>
      <lane id="Lane_Logistics" name="Logistics">
        <flowNodeRef>Task_InsureParcel</flowNodeRef>
      </lane>
      <lane id="Lane_Warehouse" name="Warehouse">
        <flowNodeRef>Task_PackageGoods</flowNodeRef>
        <flowNodeRef>Task_PrepareForPickingUp</flowNodeRef>
        <flowNodeRef>EndEvent_ShipmentPrepared</flowNodeRef>
      </lane>
    </laneSet>

    <startEvent id="StartEvent_ShipGoods" name="Ship goods">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>

    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_ShipGoods" targetRef="Task_ClarifyShipmentMethod"/>

    <task id="Task_ClarifyShipmentMethod" name="Clarify shipment method">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_ClarifyShipmentMethod" targetRef="ExclusiveGateway_SpecialHandling"/>

    <exclusiveGateway id="ExclusiveGateway_SpecialHandling" name="Special handling?">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
      <outgoing>SequenceFlow_4</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_SpecialHandling" targetRef="Task_GetOffers">
      <conditionExpression xsi:type="tFormalExpression">${shipment.amount > 100}</conditionExpression>
    </sequenceFlow>

    <task id="Task_GetOffers" name="Get offers from logistic companies">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_5</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_5" sourceRef="Task_GetOffers" targetRef="Task_SelectLogisticCompany"/>

    <task id="Task_SelectLogisticCompany" name="Select logistic company and place order">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_6" sourceRef="Task_SelectLogisticCompany" targetRef="InclusiveGateway_PrepareShipment"/>

    <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_SpecialHandling" targetRef="Task_WritePackageLabel"/>

    <task id="Task_WritePackageLabel" name="Write package label">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_7" sourceRef="Task_WritePackageLabel" targetRef="InclusiveGateway_PrepareShipment"/>

    <inclusiveGateway id="InclusiveGateway_PrepareShipment">
      <incoming>SequenceFlow_6</incoming>
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </inclusiveGateway>

    <sequenceFlow id="SequenceFlow_8" sourceRef="InclusiveGateway_PrepareShipment" targetRef="Task_InsureParcel"/>

    <task id="Task_InsureParcel" name="Insure parcel">
      <incoming>SequenceFlow_8</incoming>
      <outgoing>SequenceFlow_9</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_9" sourceRef="Task_InsureParcel" targetRef="ParallelGateway_PrepareGoods"/>

    <parallelGateway id="ParallelGateway_PrepareGoods">
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_10</outgoing>
      <outgoing>SequenceFlow_11</outgoing>
    </parallelGateway>

    <sequenceFlow id="SequenceFlow_10" sourceRef="ParallelGateway_PrepareGoods" targetRef="Task_PackageGoods"/>

    <task id="Task_PackageGoods" name="Package goods">
      <incoming>SequenceFlow_10</incoming>
      <outgoing>SequenceFlow_12</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_12" sourceRef="Task_PackageGoods" targetRef="ExclusiveGateway_PrepareForPickingUp"/>

    <sequenceFlow id="SequenceFlow_11" sourceRef="ParallelGateway_PrepareGoods" targetRef="Task_PrepareForPickingUp"/>

    <exclusiveGateway id="ExclusiveGateway_PrepareForPickingUp">
      <incoming>SequenceFlow_12</incoming>
      <outgoing>SequenceFlow_13</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow_13" sourceRef="ExclusiveGateway_PrepareForPickingUp" targetRef="Task_PrepareForPickingUp"/>

    <task id="Task_PrepareForPickingUp" name="Prepare for picking up goods">
      <incoming>SequenceFlow_13</incoming>
      <outgoing>SequenceFlow_14</outgoing>
    </task>

    <endEvent id="EndEvent_ShipmentPrepared" name="Shipment prepared">
      <incoming>SequenceFlow_14</incoming>
    </endEvent>
  </process>
</definitions>