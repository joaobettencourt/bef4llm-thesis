    </task>

    <sequenceFlow id="SequenceFlow_1dcy43t" sourceRef="Task_0ekvey0" targetRef="IntermediateThrowEvent_0jin50e"/>

    <intermediateCatchEvent id="IntermediateThrowEvent_0jin50e" name="Remind Committee Members">
      <incoming>SequenceFlow_1dcy43t</incoming>
      <outgoing>SequenceFlow_07rt3zk</outgoing>
