<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" targetNamespace="http://www.example.com">

  <process id="OfficeSupplyRequestProcess" isExecutable="true">
    <laneSet>
      <lane id="EmployeeLane" name="Employee">
        <flowNodeRef>StartEvent</flowNodeRef>
        <flowNodeRef>Task_RegisterOfficeSupplyRequest</flowNodeRef>
        <flowNodeRef>Task_ReviewComments</flowNodeRef>
      </lane>
      <lane id="SupervisorLane" name="Supervisor">
        <flowNodeRef>Task_ApproveOfficeSupplyRequest</flowNodeRef>
        <flowNodeRef>ExclusiveGateway_RequestApproved</flowNodeRef>
        <flowNodeRef>Task_NotifyRequiredChange</flowNodeRef>
        <flowNodeRef>Task_NotifyRejection</flowNodeRef>
      </lane>
      <lane id="PurchaseDepartmentLane" name="Purchase Department">
        <flowNodeRef>SubProcess_MakeQuotations</flowNodeRef>
        <flowNodeRef>Task_GeneratePurchaseOrder</flowNodeRef>
        <flowNodeRef>Task_ProcessInvoice</flowNodeRef>
      </lane>
    </laneSet>

    <startEvent id="StartEvent">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>

    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent" targetRef="Task_RegisterOfficeSupplyRequest"/>

    <task id="Task_RegisterOfficeSupplyRequest" name="Register office supply request">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_RegisterOfficeSupplyRequest" targetRef="Task_ApproveOfficeSupplyRequest"/>

    <task id="Task_ApproveOfficeSupplyRequest" name="Approve office supply request">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
    </task>

    <exclusiveGateway id="ExclusiveGateway_RequestApproved">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_4</outgoing>
      <outgoing>SequenceFlow_5</outgoing>
      <outgoing>SequenceFlow_6</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_RequestApproved" targetRef="SubProcess_MakeQuotations">
      <conditionExpression xsi:type="tFormalExpression">${approved == true}</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="SequenceFlow_5" sourceRef="ExclusiveGateway_RequestApproved" targetRef="Task_NotifyRequiredChange">
      <conditionExpression xsi:type="tFormalExpression">${changeRequested == true}</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="SequenceFlow_6" sourceRef="ExclusiveGateway_RequestApproved" targetRef="Task_NotifyRejection">
      <conditionExpression xsi:type="tFormalExpression">${rejected == true}</conditionExpression>
    </sequenceFlow>

    <subProcess id="SubProcess_MakeQuotations" name="Make quotations and select vendor">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </subProcess>

    <sequenceFlow id="SequenceFlow_7" sourceRef="SubProcess_MakeQuotations" targetRef="Task_GeneratePurchaseOrder"/>

    <task id="Task_GeneratePurchaseOrder" name="Generate purchase order">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_8" sourceRef="Task_GeneratePurchaseOrder" targetRef="IntermediateEvent_ProductsReceived"/>

    <intermediateCatchEvent id="IntermediateEvent_ProductsReceived">
      <incoming>SequenceFlow_8</incoming>
      <outgoing>SequenceFlow_9</outgoing>
    </intermediateCatchEvent>

    <sequenceFlow id="SequenceFlow_9" sourceRef="IntermediateEvent_ProductsReceived" targetRef="Task_ProcessInvoice"/>

    <task id="Task_ProcessInvoice" name="Process invoice">
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_10</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_10" sourceRef="Task_ProcessInvoice" targetRef="EndEvent_ProcessCompleted"/>

    <endEvent id="EndEvent_ProcessCompleted">
      <incoming>SequenceFlow_10</incoming>
    </endEvent>

    <task id="Task_NotifyRequiredChange" name="Notify about required change">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_11</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_11" sourceRef="Task_NotifyRequiredChange" targetRef="Task_ReviewComments"/>

    <task id="Task_ReviewComments" name="Review comments">
      <incoming>SequenceFlow_11</incoming>
      <outgoing>SequenceFlow_12</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_12" sourceRef="Task_ReviewComments" targetRef="Task_RegisterOfficeSupplyRequest"/>

    <task id="Task_NotifyRejection" name="Notify about rejection">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_13</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_13" sourceRef="Task_NotifyRejection" targetRef="EndEvent_ProcessRejected"/>

    <endEvent id="EndEvent_ProcessRejected">
      <incoming>SequenceFlow_13</incoming>
    </endEvent>
  </process>
</definitions>