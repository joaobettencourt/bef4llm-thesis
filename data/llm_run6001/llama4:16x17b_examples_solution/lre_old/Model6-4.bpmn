<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" targetNamespace="http://www.example.com">

   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_4</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="ExclusiveGateway_1"/>

     <task id="Task_1" name="Buy data">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_2" sourceRef="ExclusiveGateway_1" targetRef="Task_1"/>

     <task id="Task_2" name="Visit exhibition">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_1" targetRef="Task_2"/>

     <task id="Task_3" name="Use other sources">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_7</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_1" targetRef="Task_3"/>

     <exclusiveGateway id="ExclusiveGateway_2">
       <incoming>SequenceFlow_5</incoming>
       <incoming>SequenceFlow_6</incoming>
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_8</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_1" targetRef="ExclusiveGateway_2"/>
     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_2" targetRef="ExclusiveGateway_2"/>
     <sequenceFlow id="SequenceFlow_7" sourceRef="Task_3" targetRef="ExclusiveGateway_2"/>

     <task id="Task_4" name="Determine contact person and budget">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_8" sourceRef="ExclusiveGateway_2" targetRef="Task_4"/>

     <exclusiveGateway id="ExclusiveGateway_3">
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_10</outgoing>
       <outgoing>SequenceFlow_11</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_4" targetRef="ExclusiveGateway_3"/>

     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_10</incoming>
     </endEvent>

     <sequenceFlow id="SequenceFlow_10" name="not interested and small budget" sourceRef="ExclusiveGateway_3" targetRef="EndEvent_1"/>

     <task id="Task_5" name="Contact customer (Call Center)">
       <incoming>SequenceFlow_11</incoming>
       <outgoing>SequenceFlow_12</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_11" sourceRef="ExclusiveGateway_3" targetRef="Task_5"/>

     <exclusiveGateway id="ExclusiveGateway_4">
       <incoming>SequenceFlow_12</incoming>
       <outgoing>SequenceFlow_13</outgoing>
       <outgoing>SequenceFlow_14</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_12" sourceRef="Task_5" targetRef="ExclusiveGateway_4"/>

     <task id="Task_6" name="Head of development acquire customer">
       <incoming>SequenceFlow_13</incoming>
       <outgoing>SequenceFlow_15</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_13" name="big budget and not interested" sourceRef="ExclusiveGateway_4" targetRef="Task_6"/>

     <exclusiveGateway id="ExclusiveGateway_5">
       <incoming>SequenceFlow_14</incoming>
       <outgoing>SequenceFlow_16</outgoing>
       <outgoing>SequenceFlow_17</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_14" sourceRef="ExclusiveGateway_4" targetRef="ExclusiveGateway_5"/>

     <task id="Task_7" name="Online presentation (Sales/Pre-Sales)">
       <incoming>SequenceFlow_16</incoming>
       <outgoing>SequenceFlow_18</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_16" sourceRef="ExclusiveGateway_5" targetRef="Task_7"/>

     <intermediateCatchEvent id="IntermediateCatchEvent_1">
       <incoming>SequenceFlow_18</incoming>
       <outgoing>SequenceFlow_19</outgoing>
       <timerEventDefinition/>
     </intermediateCatchEvent>

     <sequenceFlow id="SequenceFlow_18" sourceRef="Task_7" targetRef="IntermediateCatchEvent_1"/>

     <task id="Task_8" name="Follow-up (Sales)">
       <incoming>SequenceFlow_17</incoming>
       <outgoing>SequenceFlow_20</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_17" sourceRef="ExclusiveGateway_5" targetRef="Task_8"/>

     <endEvent id="EndEvent_2">
       <incoming>SequenceFlow_15</incoming>
     </endEvent>

     <sequenceFlow id="SequenceFlow_15" sourceRef="Task_6" targetRef="EndEvent_2"/>

     <task id="Task_9" name="Create quotation">
       <incoming>SequenceFlow_19</incoming>
       <outgoing>SequenceFlow_21</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_19" sourceRef="IntermediateCatchEvent_1" targetRef="Task_9"/>

     <endEvent id="EndEvent_3">
       <incoming>SequenceFlow_20</incoming>
     </endEvent>

     <sequenceFlow id="SequenceFlow_20" sourceRef="Task_8" targetRef="EndEvent_3"/>

     <endEvent id="EndEvent_4">
       <incoming>SequenceFlow_21</incoming>
     </endEvent>

     <sequenceFlow id="SequenceFlow_21" sourceRef="Task_9" targetRef="EndEvent_4"/>
   </process>
</definitions>