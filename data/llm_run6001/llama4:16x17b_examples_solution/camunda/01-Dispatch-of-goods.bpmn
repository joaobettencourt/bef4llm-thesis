<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com/bpmn">
  <process id="shipment_process" isExecutable="true">
    <startEvent id="start_event">
      <outgoing>sequence_flow_1</outgoing>
    </startEvent>
    <sequenceFlow id="sequence_flow_1" sourceRef="start_event" targetRef="exclusive_gateway_1"/>
    <exclusiveGateway id="exclusive_gateway_1">
      <incoming>sequence_flow_1</incoming>
      <outgoing>sequence_flow_2</outgoing>
      <outgoing>sequence_flow_3</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="sequence_flow_2" sourceRef="exclusive_gateway_1" targetRef="task_1"/>
    <sequenceFlow id="sequence_flow_3" sourceRef="exclusive_gateway_1" targetRef="parallel_gateway_1"/>
    <task id="task_1">
      <incoming>sequence_flow_2</incoming>
      <outgoing>sequence_flow_4</outgoing>
    </task>
    <sequenceFlow id="sequence_flow_4" sourceRef="task_1" targetRef="inclusive_gateway_1"/>
    <parallelGateway id="parallel_gateway_1">
      <incoming>sequence_flow_3</incoming>
      <outgoing>sequence_flow_5</outgoing>
      <outgoing>sequence_flow_6</outgoing>
    </parallelGateway>
    <task id="task_2">
      <incoming>sequence_flow_5</incoming>
    </task>
    <sequenceFlow id="sequence_flow_5" sourceRef="parallel_gateway_1" targetRef="task_2"/>
    <task id="task_3">
      <incoming>sequence_flow_6</incoming>
    </task>
    <sequenceFlow id="sequence_flow_6" sourceRef="parallel_gateway_1" targetRef="task_3"/>
    <inclusiveGateway id="inclusive_gateway_1">
      <incoming>sequence_flow_4</incoming>
      <outgoing>sequence_flow_7</outgoing>
    </inclusiveGateway>
    <sequenceFlow id="sequence_flow_7" sourceRef="inclusive_gateway_1" targetRef="exclusive_gateway_2"/>
    <exclusiveGateway id="exclusive_gateway_2">
      <incoming>sequence_flow_7</incoming>
      <outgoing>sequence_flow_8</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="sequence_flow_8" sourceRef="exclusive_gateway_2" targetRef="end_event"/>
    <endEvent id="end_event">
      <incoming>sequence_flow_8</incoming>
    </endEvent>
  </process>
</definitions>