<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" name="Regressnahme Prozess"
             targetNamespace="http://example.com/bpmn">

   <process id="regressProcess" isExecutable="true">
     <startEvent id="startEvent1">
       <outgoing>sequenceFlow1</outgoing>
       <messageEventDefinition messageRef="regressVerdacht"/>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="taskPruefen"/>

     <task id="taskPruefen" name="Fall prüfen">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </task>

     <exclusiveGateway id="exclusiveGateway1">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
       <outgoing>sequenceFlow4</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow2" sourceRef="taskPruefen" targetRef="exclusiveGateway1"/>

     <sequenceFlow id="sequenceFlow3" name="Ja" sourceRef="exclusiveGateway1" targetRef="taskZahlungsaufforderung">
       <!-- conditionExpression -->
     </sequenceFlow>

     <sequenceFlow id="sequenceFlow4" name="Nein" sourceRef="exclusiveGateway1" targetRef="endEventVorgangGeschlossen">
       <!-- conditionExpression -->
     </sequenceFlow>

     <task id="taskZahlungsaufforderung" name="Zahlungsaufforderung an VN schicken">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow5</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow5" sourceRef="taskZahlungsaufforderung" targetRef="eventBasedGateway1"/>

     <eventBasedGateway id="eventBasedGateway1">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow6</outgoing>
       <outgoing>sequenceFlow7</outgoing>
       <outgoing>sequenceFlow8</outgoing>
     </eventBasedGateway>

     <intermediateCatchEvent id="intermediateCatchEventWiderspruch1">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow9</outgoing>
       <messageEventDefinition/>
     </intermediateCatchEvent>

     <sequenceFlow id="sequenceFlow6" sourceRef="eventBasedGateway1" targetRef="intermediateCatchEventWiderspruch1"/>

     <task id="taskWiderspruchPruefen1" name="Widerspruch prüfen">
       <incoming>sequenceFlow9</incoming>
       <outgoing>sequenceFlow10</outgoing>
     </task>

     <exclusiveGateway id="exclusiveGateway2">
       <incoming>sequenceFlow10</incoming>
       <outgoing>sequenceFlow11</outgoing>
       <outgoing>sequenceFlow12</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow9" sourceRef="intermediateCatchEventWiderspruch1" targetRef="taskWiderspruchPruefen1"/>

     <sequenceFlow id="sequenceFlow10" sourceRef="taskWiderspruchPruefen1" targetRef="exclusiveGateway2"/>

     <sequenceFlow id="sequenceFlow11" name="Ja" sourceRef="exclusiveGateway2" targetRef="endEventVorgangGeschlossen">
       <!-- conditionExpression -->
     </sequenceFlow>

     <sequenceFlow id="sequenceFlow12" name="Nein" sourceRef="exclusiveGateway2" targetRef="taskInkassoDienstleister1">
       <!-- conditionExpression -->
     </sequenceFlow>

     <intermediateCatchEvent id="intermediateCatchEventWiedervorlage1">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow13</outgoing>
       <timerEventDefinition/>
     </intermediateCatchEvent>

     <sequenceFlow id="sequenceFlow7" sourceRef="eventBasedGateway1" targetRef="intermediateCatchEventWiedervorlage1"/>

     <task id="taskInkassoDienstleister1" name="Vorgang an Inkasso- Dienstleister geben">
       <incoming>sequenceFlow12</incoming>
       <incoming>sequenceFlow13</incoming>
       <outgoing>sequenceFlow14</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow13" sourceRef="intermediateCatchEventWiedervorlage1" targetRef="taskInkassoDienstleister1"/>

     <endEvent id="endEventVorgangOffen">
       <incoming>sequenceFlow14</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow14" sourceRef="taskInkassoDienstleister1" targetRef="endEventVorgangOffen"/>

     <intermediateCatchEvent id="intermediateCatchEventGeldEingegangen1">
       <incoming>sequenceFlow8</incoming>
       <outgoing>sequenceFlow15</outgoing>
       <messageEventDefinition/>
     </intermediateCatchEvent>

     <sequenceFlow id="sequenceFlow8" sourceRef="eventBasedGateway1" targetRef="intermediateCatchEventGeldEingegangen1"/>

     <task id="taskGeldeingangVerbuchen1" name="Geldeingang verbuchen">
       <incoming>sequenceFlow15</incoming>
       <outgoing>sequenceFlow16</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow15" sourceRef="intermediateCatchEventGeldEingegangen1" targetRef="taskGeldeingangVerbuchen1"/>

     <endEvent id="endEventVorgangGeschlossen">
       <incoming>sequenceFlow16</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow16" sourceRef="taskGeldeingangVerbuchen1" targetRef="endEventVorgangGeschlossen"/>
   </process>
 </definitions>