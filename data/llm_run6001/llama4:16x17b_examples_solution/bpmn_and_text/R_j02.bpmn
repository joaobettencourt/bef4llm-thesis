<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/ BPMN20.xsd"
             id="definition" name="Inspection of an Energy Drink Bottling Machine"
             targetNamespace="http://bpmn.io/schema/bpmn">
  <process id="inspection_process" isExecutable="true">
    <startEvent id="start_event_1">
      <outgoing>sequence_flow_1</outgoing>
    </startEvent>
    <userTask id="choose_configuration_1" name="Choose configuration">
      <incoming>sequence_flow_1</incoming>
      <outgoing>sequence_flow_2</outgoing>
    </userTask>
    <sequenceFlow id="sequence_flow_1" sourceRef="start_event_1" targetRef="choose_configuration_1"/>
    <exclusiveGateway id="error_exists_1">
      <incoming>sequence_flow_2</incoming>
      <outgoing>sequence_flow_3</outgoing>
      <outgoing>sequence_flow_4</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="sequence_flow_2" sourceRef="choose_configuration_1" targetRef="error_exists_1"/>
    <serviceTask id="read_error_codes_1" name="Read error codes">
      <incoming>sequence_flow_3</incoming>
      <outgoing>sequence_flow_5</outgoing>
    </serviceTask>
    <sequenceFlow id="sequence_flow_3" sourceRef="error_exists_1" targetRef="read_error_codes_1"/>
    <parallelGateway id="parallel_gateway_1">
      <incoming>sequence_flow_5</incoming>
      <outgoing>sequence_flow_6</outgoing>
      <outgoing>sequence_flow_7</outgoing>
    </parallelGateway>
    <sequenceFlow id="sequence_flow_4" name="No" sourceRef="error_exists_1" targetRef="parallel_gateway_1"/>
    <sequenceFlow id="sequence_flow_5" sourceRef="read_error_codes_1" targetRef="parallel_gateway_1"/>
    <userTask id="visual_inspection_1" name="Visual inspection">
      <incoming>sequence_flow_6</incoming>
      <outgoing>sequence_flow_8</outgoing>
    </userTask>
    <sequenceFlow id="sequence_flow_6" sourceRef="parallel_gateway_1" targetRef="visual_inspection_1"/>
    <serviceTask id="clear_error_codes_1" name="Clear error codes">
      <incoming>sequence_flow_7</incoming>
      <outgoing>sequence_flow_9</outgoing>
    </serviceTask>
    <sequenceFlow id="sequence_flow_7" sourceRef="parallel_gateway_1" targetRef="clear_error_codes_1"/>
    <exclusiveGateway id="repair_decision_1">
      <incoming>sequence_flow_8</incoming>
      <outgoing>sequence_flow_10</outgoing>
      <outgoing>sequence_flow_11</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="sequence_flow_8" sourceRef="visual_inspection_1" targetRef="repair_decision_1"/>
    <userTask id="perform_test_run_1" name="Perform test run">
      <incoming>sequence_flow_10</incoming>
      <outgoing>sequence_flow_12</outgoing>
    </userTask>
    <sequenceFlow id="sequence_flow_9" sourceRef="clear_error_codes_1" targetRef="repair_decision_1"/>
    <sequenceFlow id="sequence_flow_10" name="Yes" sourceRef="repair_decision_1" targetRef="perform_test_run_1"/>
    <userTask id="write_final_report_1" name="Write final report">
      <incoming>sequence_flow_12</incoming>
      <outgoing>sequence_flow_13</outgoing>
    </userTask>
    <sequenceFlow id="sequence_flow_11" name="No" sourceRef="repair_decision_1" targetRef="write_final_report_1"/>
    <endEvent id="end_event_1">
      <incoming>sequence_flow_13</incoming>
    </endEvent>
    <sequenceFlow id="sequence_flow_12" sourceRef="perform_test_run_1" targetRef="write_final_report_1"/>
    <sequenceFlow id="sequence_flow_13" sourceRef="write_final_report_1" targetRef="end_event_1"/>
  </process>
</definitions>