<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/06-02-01.xsd"
             id="definition" name="Luxury Airplane Process" targetNamespace="http://example.com">

   <process id="luxuryAirplaneProcess" isExecutable="true">
     <startEvent id="orderReceived">
       <outgoing>defineRequirements</outgoing>
     </startEvent>

     <sequenceFlow id="flow1" sourceRef="orderReceived" targetRef="defineRequirements"/>

     <userTask id="defineRequirements">
       <incoming>flow1</incoming>
       <outgoing>designIndividualParts</outgoing>
     </userTask>

     <sequenceFlow id="flow2" sourceRef="defineRequirements" targetRef="designIndividualParts"/>

     <exclusiveGateway id="baseModelDecision">
       <incoming>flow2</incoming>
       <outgoing>orderBaseModel</outgoing>
       <outgoing>orderCustomizedModel</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="flow3" sourceRef="baseModelDecision" targetRef="orderBaseModel"/>
     <sequenceFlow id="flow4" sourceRef="baseModelDecision" targetRef="orderCustomizedModel"/>

     <serviceTask id="orderBaseModel">
       <incoming>flow3</incoming>
       <outgoing>assemblePlane</outgoing>
     </serviceTask>

     <sequenceFlow id="flow5" sourceRef="orderBaseModel" targetRef="assemblePlane"/>

     <userTask id="designIndividualParts">
       <incoming>flow2</incoming>
       <outgoing>customization</outgoing>
     </userTask>

     <parallelGateway id="customization">
       <incoming>customization</incoming>
       <outgoing>manufactureVodkaBar</outgoing>
       <outgoing>manufactureWhiskeyBar</outgoing>
     </parallelGateway>

     <sequenceFlow id="flow6" sourceRef="customization" targetRef="manufactureVodkaBar"/>
     <sequenceFlow id="flow7" sourceRef="customization" targetRef="manufactureWhiskeyBar"/>

     <serviceTask id="manufactureVodkaBar">
       <incoming>flow6</incoming>
       <outgoing>assembleCustomizedParts</outgoing>
     </serviceTask>

     <sequenceFlow id="flow8" sourceRef="manufactureVodkaBar" targetRef="assembleCustomizedParts"/>

     <serviceTask id="manufactureWhiskeyBar">
       <incoming>flow7</incoming>
       <outgoing>assembleCustomizedParts</outgoing>
     </serviceTask>

     <sequenceFlow id="flow9" sourceRef="manufactureWhiskeyBar" targetRef="assembleCustomizedParts"/>

     <userTask id="assemblePlane">
       <incoming>flow5</incoming>
       <incoming>flow8</incoming>
       <outgoing>makeTestFlight</outgoing>
     </userTask>

     <sequenceFlow id="flow10" sourceRef="assemblePlane" targetRef="makeTestFlight"/>

     <userTask id="makeTestFlight">
       <incoming>flow10</incoming>
       <outgoing>createTestProtocol</outgoing>
     </userTask>

     <sequenceFlow id="flow11" sourceRef="makeTestFlight" targetRef="createTestProtocol"/>

     <serviceTask id="createTestProtocol">
       <incoming>flow11</incoming>
       <outgoing>notifyCustomer</outgoing>
     </serviceTask>

     <sequenceFlow id="flow12" sourceRef="createTestProtocol" targetRef="notifyCustomer"/>

     <serviceTask id="notifyCustomer">
       <incoming>flow12</incoming>
       <outgoing>deliverPlane</outgoing>
     </serviceTask>

     <sequenceFlow id="flow13" sourceRef="notifyCustomer" targetRef="deliverPlane"/>

     <userTask id="deliverPlane">
       <incoming>flow13</incoming>
       <outgoing>confirmDelivery</outgoing>
     </userTask>

     <sequenceFlow id="flow14" sourceRef="deliverPlane" targetRef="endEvent"/>

     <endEvent id="endEvent">
       <incoming>flow14</incoming>
     </endEvent>

   </process>

</definitions>