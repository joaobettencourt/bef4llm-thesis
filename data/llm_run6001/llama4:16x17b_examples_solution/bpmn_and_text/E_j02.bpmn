<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/06-02-01.xsd"
             id="definition" name="Becoming A Parent" targetNamespace="http://example.com/bpmn">
   <process id="becoming_a_parent_process" isExecutable="true">
     <startEvent id="start_event_1">
       <outgoing>sequence_flow_1</outgoing>
     </startEvent>
     <userTask id="choose_employment_type_task">
       <incoming>sequence_flow_1</incoming>
       <outgoing>sequence_flow_2</outgoing>
     </userTask>
     <sequenceFlow id="sequence_flow_1" sourceRef="start_event_1" targetRef="choose_employment_type_task"/>
     <exclusiveGateway id="parental_leave_gateway">
       <incoming>sequence_flow_2</incoming>
       <outgoing>sequence_flow_3</outgoing>
       <outgoing>sequence_flow_4</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="sequence_flow_2" sourceRef="choose_employment_type_task" targetRef="parental_leave_gateway"/>
     <userTask id="select_parent_type_task">
       <incoming>sequence_flow_3</incoming>
       <outgoing>sequence_flow_5</outgoing>
     </userTask>
     <sequenceFlow id="sequence_flow_3" sourceRef="parental_leave_gateway" targetRef="select_parent_type_task"/>
     <exclusiveGateway id="mother_or_father_gateway">
       <incoming>sequence_flow_5</incoming>
       <outgoing>sequence_flow_6</outgoing>
       <outgoing>sequence_flow_7</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="sequence_flow_5" sourceRef="select_parent_type_task" targetRef="mother_or_father_gateway"/>
     <manualTask id="take_protection_period_task">
       <incoming>sequence_flow_6</incoming>
       <outgoing>sequence_flow_8</outgoing>
     </manualTask>
     <sequenceFlow id="sequence_flow_6" sourceRef="mother_or_father_gateway" targetRef="take_protection_period_task"/>
     <exclusiveGateway id="extension_gateway">
       <incoming>sequence_flow_8</incoming>
       <incoming>sequence_flow_9</incoming>
       <outgoing>sequence_flow_10</outgoing>
     </exclusiveGateway>
     <userTask id="notify_social_security_and_company_task">
       <incoming>sequence_flow_10</incoming>
       <outgoing>sequence_flow_11</outgoing>
     </userTask>
     <sequenceFlow id="sequence_flow_10" sourceRef="extension_gateway" targetRef="notify_social_security_and_company_task"/>
     <parallelGateway id="gather_information_gateway">
       <incoming>sequence_flow_11</incoming>
       <outgoing>sequence_flow_12</outgoing>
       <outgoing>sequence_flow_13</outgoing>
     </parallelGateway>
     <sequenceFlow id="sequence_flow_11" sourceRef="notify_social_security_and_company_task" targetRef="gather_information_gateway"/>
     <serviceTask id="gather_info_from_companies_task">
       <incoming>sequence_flow_12</incoming>
       <outgoing>sequence_flow_14</outgoing>
     </serviceTask>
     <sequenceFlow id="sequence_flow_12" sourceRef="gather_information_gateway" targetRef="gather_info_from_companies_task"/>
     <userTask id="collect_relevant_information_task">
       <incoming>sequence_flow_13</incoming>
       <outgoing>sequence_flow_15</outgoing>
     </userTask>
     <sequenceFlow id="sequence_flow_13" sourceRef="gather_information_gateway" targetRef="collect_relevant_information_task"/>
     <exclusiveGateway id="final_extension_gateway">
       <incoming>sequence_flow_14</incoming>
       <incoming>sequence_flow_15</incoming>
       <outgoing>sequence_flow_16</outgoing>
       <outgoing>sequence_flow_17</outgoing>
    </exclusiveGateway>
     <sequenceFlow id="sequence_flow_14" sourceRef="gather_info_from_companies_task" targetRef="final_extension_gateway"/>
     <sequenceFlow id="sequence_flow_15" sourceRef="collect_relevant_information_task" targetRef="final_extension_gateway"/>
     <endEvent id="end_event">
       <incoming>sequence_flow_16</incoming>
     </endEvent>
     <sequenceFlow id="sequence_flow_16" sourceRef="final_extension_gateway" targetRef="end_event"/>
   </process>
</definitions>