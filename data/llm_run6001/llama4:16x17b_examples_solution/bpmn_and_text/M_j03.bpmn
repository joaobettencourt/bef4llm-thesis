<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/06-02-01.xsd" 
             id="definition" name="Business Process Model">
   <process id="contract_project" isExecutable="true">
     <startEvent id="start_event">
       <outgoing>sequence_flow_1</outgoing>
     </startEvent>
     <serviceTask id="query_webshops" name="Query webshops for parts">
       <incoming>sequence_flow_1</incoming>
       <outgoing>sequence_flow_2</outgoing>
     </serviceTask>
     <sequenceFlow id="sequence_flow_1" sourceRef="start_event" targetRef="query_webshops"/>
     <exclusiveGateway id="all_parts_covered">
       <incoming>sequence_flow_3</incoming>
       <outgoing>sequence_flow_4</outgoing>
       <outgoing>sequence_flow_5</outgoing>
     </exclusiveGateway>
     <serviceTask id="compare_prices" name="Compare prices and select cheapest parts">
       <incoming>sequence_flow_2</incoming>
       <outgoing>sequence_flow_3</outgoing>
     </serviceTask>
     <sequenceFlow id="sequence_flow_2" sourceRef="query_webshops" targetRef="compare_prices"/>
     <sequenceFlow id="sequence_flow_3" sourceRef="compare_prices" targetRef="all_parts_covered"/>
     <sequenceFlow id="sequence_flow_4" name="yes" sourceRef="all_parts_covered" targetRef="order_parts"/>
     <sequenceFlow id="sequence_flow_5" name="no" sourceRef="all_parts_covered" targetRef="compare_prices"/>
     <serviceTask id="order_parts" name="Order parts">
       <incoming>sequence_flow_4</incoming>
       <outgoing>sequence_flow_6</outgoing>
     </serviceTask>
     <sequenceFlow id="sequence_flow_6" sourceRef="order_parts" targetRef="build_item"/>
     <manualTask id="build_item" name="Build item">
       <incoming>sequence_flow_6</incoming>
       <outgoing>sequence_flow_7</outgoing>
     </manualTask>
     <intermediateCatchEvent id="part_arrived">
       <incoming>sequence_flow_8</incoming>
       <outgoing>sequence_flow_9</outgoing>
     </intermediateCatchEvent>
     <parallelGateway id="split_building_and_checking">
       <incoming>sequence_flow_6</incoming>
       <outgoing>sequence_flow_8</outgoing>
       <outgoing>sequence_flow_10</outgoing>
     </parallelGateway>
     <sequenceFlow id="sequence_flow_7" sourceRef="build_item" targetRef="check_parts_quantity"/>
     <manualTask id="check_parts_quantity" name="Check parts quantity">
       <incoming>sequence_flow_7</incoming>
       <outgoing>sequence_flow_11</outgoing>
     </manualTask>
     <exclusiveGateway id="quantity_decision">
       <incoming>sequence_flow_11</incoming>
       <outgoing>sequence_flow_12</outgoing>
       <outgoing>sequence_flow_13</outgoing>
       <outgoing>sequence_flow_14</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="sequence_flow_11" sourceRef="check_parts_quantity" targetRef="quantity_decision"/>
     <serviceTask id="reorder_part" name="Reorder part">
       <incoming>sequence_flow_12</incoming>
       <outgoing>sequence_flow_15</outgoing>
     </serviceTask>
     <sequenceFlow id="sequence_flow_12" name="below 5" sourceRef="quantity_decision" targetRef="reorder_part"/>
     <serviceTask id="reorder_part_fastest" name="Reorder part fastest">
       <incoming>sequence_flow_13</incoming>
       <outgoing>sequence_flow_16</outgoing>
     </serviceTask>
     <sequenceFlow id="sequence_flow_13" name="below 3" sourceRef="quantity_decision" targetRef="reorder_part_fastest"/>
     <manualTask id="complain_to_friends" name="Complain to friends">
       <incoming>sequence_flow_14</incoming>
     </manualTask>
     <endEvent id="end_event">
       <incoming>sequence_flow_16</incoming>
     </endEvent>
     <sequenceFlow id="sequence_flow_8" sourceRef="split_building_and_checking" targetRef="part_arrived"/>
     <sequenceFlow id="sequence_flow_9" sourceRef="part_arrived" targetRef="build_item"/>
     <sequenceFlow id="sequence_flow_10" sourceRef="split_building_and_checking" targetRef="check_parts_quantity"/>
     <sequenceFlow id="sequence_flow_14" name="zero" sourceRef="quantity_decision" targetRef="complain_to_friends"/>
     <sequenceFlow id="sequence_flow_15" sourceRef="reorder_part" targetRef="check_parts_quantity"/>
     <sequenceFlow id="sequence_flow_16" sourceRef="reorder_part_fastest" targetRef="end_event"/>
   </process>
</definitions>