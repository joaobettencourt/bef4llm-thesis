<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/BPMN20.xsd" 
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="definitions" name="Ordering in an Online Shop" targetNamespace="http://bpmn.io/schema/bpmn">
   <process id="ordering_process" isExecutable="true">
     <startEvent id="open_e_shop_homepage">
       <outgoing>login</outgoing>
     </startEvent>

     <manualTask id="customer_logs_into_e_shop" name="Customer logs into E-Shop">
       <incoming>login</incoming>
       <outgoing>credentials_checked</outgoing>
     </manualTask>

     <serviceTask id="check_credentials" name="Check customer credentials">
       <incoming>credentials_checked</incoming>
       <outgoing>login_decision_made</outgoing>
     </serviceTask>

     <exclusiveGateway id="login_decision_gateway">
       <incoming>login_decision_made</incoming>
       <outgoing>login_successful_flow</outgoing>
       <outgoing>login_unsuccessful_flow</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="login" sourceRef="open_e_shop_homepage" targetRef="customer_logs_into_e_shop"/>
     <sequenceFlow id="credentials_checked" sourceRef="customer_logs_into_e_shop" targetRef="check_credentials"/>
     <sequenceFlow id="login_decision_made" sourceRef="check_credentials" targetRef="login_decision_gateway"/>
     <sequenceFlow id="login_successful_flow" sourceRef="login_decision_gateway" targetRef="select_product"/>
     <sequenceFlow id="login_unsuccessful_flow" sourceRef="login_decision_gateway" targetRef="order_finished"/>

     <manualTask id="select_product" name="Select product">
       <incoming>login_successful_flow</incoming>
       <outgoing>add_to_cart</outgoing>
     </manualTask>

     <sequenceFlow id="add_to_cart" sourceRef="select_product" targetRef="add_product_to_cart"/>

     <manualTask id="add_product_to_cart" name="Add product to cart">
       <incoming>add_to_cart</incoming>
       <outgoing>save_product_flow</outgoing>
     </manualTask>

     <sequenceFlow id="save_product_flow" sourceRef="add_product_to_cart" targetRef="check_products_selected"/>

     <manualTask id="check_products_selected" name="Check products selected">
       <incoming>save_product_flow</incoming>
       <outgoing>all_products_selected_flow</outgoing>
     </manualTask>

     <exclusiveGateway id="all_products_selected_gateway">
       <incoming>all_products_selected_flow</incoming>
       <outgoing>yes_all_selected_flow</outgoing>
       <outgoing>no_more_selection_flow</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="all_products_selected_flow" sourceRef="check_products_selected" targetRef="all_products_selected_gateway"/>
     <sequenceFlow id="yes_all_selected_flow" sourceRef="all_products_selected_gateway" targetRef="prepare_payment_and_shipment"/>

     <parallelGateway id="prepare_payment_and_shipment">
       <incoming>yes_all_selected_flow</incoming>
       <outgoing>payment_preparation_flow</outgoing>
       <outgoing>shipment_preparation_flow</outgoing>
     </parallelGateway>

     <sequenceFlow id="payment_preparation_flow" sourceRef="prepare_payment_and_shipment" targetRef="enter_payment_data"/>
     <sequenceFlow id="shipment_preparation_flow" sourceRef="prepare_payment_and_shipment" targetRef="enter_shipping_address"/>

     <manualTask id="enter_payment_data" name="Enter payment data">
       <incoming>payment_preparation_flow</incoming>
       <outgoing>wait_for_payment_confirmation_flow</outgoing>
     </manualTask>

     <sequenceFlow id="wait_for_payment_confirmation_flow" sourceRef="enter_payment_data" targetRef="task_waiting_for_bank"/>

     <task id="task_waiting_for_bank" name="Wait for bank confirmation">
       <incoming>wait_for_payment_confirmation_flow</incoming>
       <outgoing>bank_confirmed_payment_flow</outgoing>
     </task>

     <sequenceFlow id="bank_confirmed_payment_flow" sourceRef="task_waiting_for_bank" targetRef="parallel_gateway_convergence"/>

     <manualTask id="enter_shipping_address" name="Enter shipping address">
       <incoming>shipment_preparation_flow</incoming>
       <outgoing>shipping_address_saved_flow</outgoing>
     </manualTask>

     <sequenceFlow id="shipping_address_saved_flow" sourceRef="enter_shipping_address" targetRef="parallel_gateway_convergence"/>

     <parallelGateway id="parallel_gateway_convergence">
       <incoming>bank_confirmed_payment_flow</incoming>
       <incoming>shipping_address_saved_flow</incoming>
       <outgoing>finish_order_flow</outgoing>
     </parallelGateway>

     <sequenceFlow id="finish_order_flow" sourceRef="parallel_gateway_convergence" targetRef="finish_order"/>

     <serviceTask id="finish_order" name="Finish order by system">
       <incoming>finish_order_flow</incoming>
       <outgoing>order_finished_flow</outgoing>
     </serviceTask>

     <sequenceFlow id="order_finished_flow" sourceRef="finish_order" targetRef="order_finished"/>

     <endEvent id="order_finished">
       <incoming>order_finished_flow</incoming>
     </endEvent>

     <no_more_selection_flow name="" sourceRef="all_products_selected_gateway" targetRef="select_product"/>
   </process>
</definitions>