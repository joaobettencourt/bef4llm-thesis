<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/06-02-01.xsd"
             id="definition" 
             targetNamespace="http://example.com/bpmn">
   <process id="robotic_burger_seller_process_1" isExecutable="true">
     <startEvent id="start_event_1">
       <outgoing>sequence_flow_1</outgoing>
     </startEvent>
     <serviceTask id="receive_order_1" name="The Robot receives an order">
       <incoming>sequence_flow_1</incoming>
       <outgoing>sequence_flow_2</outgoing>
     </serviceTask>
     <sequenceFlow id="sequence_flow_1" sourceRef="start_event_1" targetRef="receive_order_1"/>
     <exclusiveGateway id="menu_decision_1">
       <incoming>sequence_flow_2</incoming>
       <outgoing>sequence_flow_3</outgoing>
       <outgoing>sequence_flow_4</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="sequence_flow_2" sourceRef="receive_order_1" targetRef="menu_decision_1"/>
     <serviceTask id="prepare_drink_1" name="The Robot starts to make the drink">
       <incoming>sequence_flow_3</incoming>
       <outgoing>sequence_flow_5</outgoing>
     </serviceTask>
     <sequenceFlow id="sequence_flow_3" sourceRef="menu_decision_1" targetRef="prepare_drink_1"/>
     <parallelGateway id="fries_wedges_decision_1">
       <incoming>sequence_flow_5</incoming>
       <outgoing>sequence_flow_6</outgoing>
       <outgoing>sequence_flow_7</outgoing>
     </parallelGateway>
     <sequenceFlow id="sequence_flow_5" sourceRef="prepare_drink_1" targetRef="fries_wedges_decision_1"/>
     <serviceTask id="ask_fries_or_wedges_1" name="The Robot asks fries or wedges">
       <incoming>sequence_flow_6</incoming>
       <outgoing>sequence_flow_8</outgoing>
     </serviceTask>
     <sequenceFlow id="sequence_flow_6" sourceRef="fries_wedges_decision_1" targetRef="ask_fries_or_wedges_1"/>
     <exclusiveGateway id="fries_decision_1">
       <incoming>sequence_flow_8</incoming>
       <outgoing>sequence_flow_9</outgoing>
       <outgoing>sequence_flow_10</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="sequence_flow_8" sourceRef="ask_fries_or_wedges_1" targetRef="fries_decision_1"/>
     <serviceTask id="prepare_fries_1" name="The Robot makes the fries">
       <incoming>sequence_flow_9</incoming>
       <outgoing>sequence_flow_11</outgoing>
     </serviceTask>
     <sequenceFlow id="sequence_flow_9" sourceRef="fries_decision_1" targetRef="prepare_fries_1"/>
     <serviceTask id="prepare_wedges_1" name="The Robot makes the wedges">
       <incoming>sequence_flow_10</incoming>
       <outgoing>sequence_flow_12</outgoing>
     </serviceTask>
     <sequenceFlow id="sequence_flow_10" sourceRef="fries_decision_1" targetRef="prepare_wedges_1"/>
     <exclusiveGateway id="convergence_fries_wedges_1">
       <incoming>sequence_flow_11</incoming>
       <incoming>sequence_flow_12</incoming>
       <outgoing>sequence_flow_13</outgoing>
     </exclusiveGateway>
     <parallelGateway id="burger_preparation_1">
       <incoming>sequence_flow_13</incoming>
       <incoming>sequence_flow_4</incoming>
       <outgoing>sequence_flow_14</outgoing>
     </parallelGateway>
     <sequenceFlow id="sequence_flow_11" sourceRef="prepare_fries_1" targetRef="convergence_fries_wedges_1"/>
     <sequenceFlow id="sequence_flow_12" sourceRef="prepare_wedges_1" targetRef="convergence_fries_wedges_1"/>
     <sequenceFlow id="sequence_flow_13" sourceRef="convergence_fries_wedges_1" targetRef="burger_preparation_1"/>
     <serviceTask id="prepare_burger_2" name="The Robot prepares the burger">
       <incoming>sequence_flow_14</incoming>
       <outgoing>sequence_flow_15</outgoing>
     </serviceTask>
     <sequenceFlow id="sequence_flow_14" sourceRef="burger_preparation_1" targetRef="prepare_burger_2"/>
     <serviceTask id="give_status_updates_1" name="The Robot gives an order status">
       <incoming>sequence_flow_15</incoming>
       <outgoing>sequence_flow_16</outgoing>
     </serviceTask>
     <sequenceFlow id="sequence_flow_15" sourceRef="prepare_burger_2" targetRef="give_status_updates_1"/>
     <exclusiveGateway id="order_finished_decision_1">
       <incoming>sequence_flow_16</incoming>
       <outgoing>sequence_flow_17</outgoing>
       <outgoing>sequence_flow_18</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="sequence_flow_16" sourceRef="give_status_updates_1" targetRef="order_finished_decision_1"/>
     <serviceTask id="deliver_order_1" name="An order delivered via conveyor belt">
       <incoming>sequence_flow_17</incoming>
       <outgoing>sequence_flow_19</outgoing>
     </serviceTask>
     <sequenceFlow id="sequence_flow_17" sourceRef="order_finished_decision_1" targetRef="deliver_order_1"/>
     <userTask id="customer_receives_order_1" name="The customer receives an order">
       <incoming>sequence_flow_19</incoming>
       <outgoing>sequence_flow_20</outgoing>
     </userTask>
     <sequenceFlow id="sequence_flow_19" sourceRef="deliver_order_1" targetRef="customer_receives_order_1"/>
     <endEvent id="end_event_2">
       <incoming>sequence_flow_20</incoming>
     </endEvent>
     <sequenceFlow id="sequence_flow_20" sourceRef="customer_receives_order_1" targetRef="end_event_2"/>
     <sequenceFlow id="sequence_flow_4" sourceRef="menu_decision_1" targetRef="burger_preparation_1"/>
   </process>
</definitions>