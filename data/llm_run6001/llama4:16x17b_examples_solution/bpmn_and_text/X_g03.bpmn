<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/DD/20100524/DC/05-02-01.xsd" 
             id="definition" name="Business Process Model">
   <process id="app_for_venna_night_run_process" isExecutable="true">
     <startEvent id="start_event_1">
       <outgoing>sequence_flow_1</outgoing>
     </startEvent>
     <task id="select_starting_block_task">
       <incoming>sequence_flow_1</incoming>
       <outgoing>sequence_flow_2</outgoing>
     </task>
     <sequenceFlow id="sequence_flow_1" sourceRef="start_event_1" targetRef="select_starting_block_task"/>
     <parallelGateway id="parallel_gateway_1">
       <incoming>sequence_flow_2</incoming>
       <outgoing>sequence_flow_3</outgoing>
       <outgoing>sequence_flow_23</outgoing>
     </parallelGateway>
     <sequenceFlow id="sequence_flow_2" sourceRef="select_starting_block_task" targetRef="parallel_gateway_1"/>
     <task id="run_and_measure_time">
       <incoming>sequence_flow_3</incoming>
       <outgoing>sequence_flow_4</outgoing>
     </task>
     <sequenceFlow id="sequence_flow_3" sourceRef="parallel_gateway_1" targetRef="run_and_measure_time"/>
     <exclusiveGateway id="exclusive_gateway_1">
       <incoming>sequence_flow_4</incoming>
       <outgoing>sequence_flow_5</outgoing>
       <outgoing>sequence_flow_10</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="sequence_flow_4" sourceRef="run_and_measure_time" targetRef="exclusive_gateway_1"/>
     <task id="get_starting_number">
       <incoming>sequence_flow_5</incoming>
       <outgoing>sequence_flow_6</outgoing>
     </task>
     <sequenceFlow id="sequence_flow_5" sourceRef="exclusive_gateway_1" targetRef="get_starting_number"/>
     <exclusiveGateway id="exclusive_gateway_2">
       <incoming>sequence_flow_6</incoming>
       <outgoing>sequence_flow_7</outgoing>
       <outgoing>sequence_flow_11</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="sequence_flow_6" sourceRef="get_starting_number" targetRef="exclusive_gateway_2"/>
     <task id="go_to_run_from_home">
       <incoming>sequence_flow_7</incoming>
       <outgoing>sequence_flow_8</outgoing>
     </task>
     <sequenceFlow id="sequence_flow_7" sourceRef="exclusive_gateway_2" targetRef="go_to_run_from_home"/>
     <task id="leave_directly_from_work">
       <incoming>sequence_flow_11</incoming>
       <outgoing>sequence_flow_12</outgoing>
     </task>
     <sequenceFlow id="sequence_flow_11" sourceRef="exclusive_gateway_2" targetRef="leave_directly_from_work"/>
     <parallelGateway id="parallel_gateway_2">
       <incoming>sequence_flow_8</incoming>
       <incoming>sequence_flow_12</incoming>
       <outgoing>sequence_flow_13</outgoing>
     </parallelGateway>
     <sequenceFlow id="sequence_flow_8" sourceRef="go_to_run_from_home" targetRef="parallel_gateway_2"/>
     <sequenceFlow id="sequence_flow_12" sourceRef="leave_directly_from_work" targetRef="parallel_gateway_2"/>
     <task id="run_the_night_run">
       <incoming>sequence_flow_13</incoming>
       <outgoing>sequence_flow_14</outgoing>
     </task>
     <sequenceFlow id="sequence_flow_13" sourceRef="parallel_gateway_2" targetRef="run_the_night_run"/>
     <endEvent id="end_event">
       <incoming>sequence_flow_14</incoming>
     </endEvent>
     <sequenceFlow id="sequence_flow_14" sourceRef="run_the_night_run" targetRef="end_event"/>
     <task id="do_training">
       <incoming>sequence_flow_10</incoming>
       <outgoing>sequence_flow_15</outgoing>
     </task>
     <sequenceFlow id="sequence_flow_10" sourceRef="exclusive_gateway_1" targetRef="do_training"/>
     <sequenceFlow id="sequence_flow_15">
       <sourceRef>do_training</sourceRef>
       <targetRef>parallel_gateway_1</targetRef>
     </sequenceFlow>
   </process>
</definitions>