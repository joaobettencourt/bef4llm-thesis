<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definitions" name="App For Participating at the Vienna Night Run">

   <process id="appProcess" isExecutable="true">
     <startEvent id="startEvent1">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="task1"/>

     <userTask id="task1" name="Select starting block">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow2" sourceRef="task1" targetRef="serviceTask1"/>

     <serviceTask id="serviceTask1" name="Run 5km and measure time">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlow3" sourceRef="serviceTask1" targetRef="exclusiveGateway1"/>

     <exclusiveGateway id="exclusiveGateway1">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow4</outgoing>
       <outgoing>sequenceFlow5</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow4" sourceRef="exclusiveGateway1" targetRef="task2">
       <conditionExpression xsi:type="tFormalExpression">${time < 25}</conditionExpression>
     </sequenceFlow>

     <userTask id="task2" name="Get starting number">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow6</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow6" sourceRef="task2" targetRef="exclusiveGateway2"/>

     <sequenceFlow id="sequenceFlow5" sourceRef="exclusiveGateway1" targetRef="task3">
       <conditionExpression xsi:type="tFormalExpression">${time >= 25}</conditionExpression>
     </sequenceFlow>

     <userTask id="task3" name="Train and check time">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow7</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow7" sourceRef="task3" targetRef="serviceTask1"/>

     <exclusiveGateway id="exclusiveGateway2">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow8</outgoing>
       <outgoing>sequenceFlow9</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow8" sourceRef="exclusiveGateway2" targetRef="task4">
       <conditionExpression xsi:type="tFormalExpression">${workdayEnd - startTime > 60}</conditionExpression>
     </sequenceFlow>

     <userTask id="task4" name="Go to starting point from home">
       <incoming>sequenceFlow8</incoming>
       <outgoing>sequenceFlow10</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow10" sourceRef="task4" targetRef="serviceTask2"/>

     <sequenceFlow id="sequenceFlow9" sourceRef="exclusiveGateway2" targetRef="task5">
       <conditionExpression xsi:type="tFormalExpression">${workdayEnd - startTime <= 60}</conditionExpression>
     </sequenceFlow>

     <userTask id="task5" name="Go to starting point from work">
       <incoming>sequenceFlow9</incoming>
       <outgoing>sequenceFlow11</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow11" sourceRef="task5" targetRef="serviceTask2"/>

     <serviceTask id="serviceTask2" name="Run and drink at the Night Run">
       <incoming>sequenceFlow10</incoming>
       <incoming>sequenceFlow11</incoming>
       <outgoing>sequenceFlow12</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlow12" sourceRef="serviceTask2" targetRef="endEvent1"/>

     <endEvent id="endEvent1" name="Receive final running time">
       <incoming>sequenceFlow12</incoming>
     </endEvent>

   </process>

 </definitions>