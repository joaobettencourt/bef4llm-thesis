<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definitions" 
             targetNamespace="http://example.com/bpmn">

    <process id="instructArtistProcess" isExecutable="true">
      <startEvent id="startEvent1">
        <outgoing>sequenceFlow1</outgoing>
      </startEvent>

      <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="task1"/>

      <userTask id="task1" name="Instruct Artist to Create 3D Model">
        <incoming>sequenceFlow1</incoming>
        <outgoing>sequenceFlow2</outgoing>
      </userTask>

      <sequenceFlow id="sequenceFlow2" sourceRef="task1" targetRef="exclusiveGateway1"/>

      <exclusiveGateway id="exclusiveGateway1">
        <incoming>sequenceFlow2</incoming>
        <outgoing>sequenceFlow3</outgoing>
        <outgoing>sequenceFlow4</outgoing>
      </exclusiveGateway>

      <sequenceFlow id="sequenceFlow3" sourceRef="exclusiveGateway1" targetRef="task2">
        <!--<conditionExpression xsi:type="tFormalExpression">${artistSatisfied  == true}</conditionExpression>-->
      </sequenceFlow>

      <userTask id="task2" name="Iterate with Artist until Satisfied">
        <incoming>sequenceFlow3</incoming>
        <outgoing>sequenceFlow5</outgoing>
      </userTask>

      <sequenceFlow id="sequenceFlow5" sourceRef="task2" targetRef="exclusiveGateway1"/>

      <sequenceFlow id="sequenceFlow4" sourceRef="exclusiveGateway1" targetRef="task3">
        <!--<conditionExpression xsi:type="tFormalExpression">${artistSatisfied  == false}</conditionExpression>-->
      </sequenceFlow>

      <userTask id="task3" name="Choose Plastic Color">
        <incoming>sequenceFlow4</incoming>
        <outgoing>sequenceFlow6</outgoing>
      </userTask>

      <sequenceFlow id="sequenceFlow6" sourceRef="task3" targetRef="exclusiveGateway2"/>

      <exclusiveGateway id="exclusiveGateway2">
        <incoming>sequenceFlow6</incoming>
        <outgoing>sequenceFlow7</outgoing>
        <outgoing>sequenceFlow8</outgoing>
      </exclusiveGateway>

      <sequenceFlow id="sequenceFlow7" sourceRef="exclusiveGateway2" targetRef="task4">
        <!--<conditionExpression xsi:type="tFormalExpression">${colorInStock  == true}</conditionExpression>-->
      </sequenceFlow>

      <userTask id="task4" name="Check Color Quantity">
        <incoming>sequenceFlow7</incoming>
        <outgoing>sequenceFlow9</outgoing>
      </userTask>

      <sequenceFlow id="sequenceFlow9" sourceRef="task4" targetRef="exclusiveGateway3"/>

      <exclusiveGateway id="exclusiveGateway3">
        <incoming>sequenceFlow9</incoming>
        <outgoing>sequenceFlow10</outgoing>
        <outgoing>sequenceFlow11</outgoing>
      </exclusiveGateway>

      <sequenceFlow id="sequenceFlow10" sourceRef="exclusiveGateway3" targetRef="task5">
        <!--<conditionExpression xsi:type="tFormalExpression">${quantity  > 100}</conditionExpression>-->
      </sequenceFlow>

      <userTask id="task5" name="Add to Shopping List">
        <incoming>sequenceFlow10</incoming>
        <outgoing>sequenceFlow12</outgoing>
      </userTask>

      <sequenceFlow id="sequenceFlow12" sourceRef="task5" targetRef="serviceTask1"/>

      <sequenceFlow id="sequenceFlow11" sourceRef="exclusiveGateway3" targetRef="serviceTask2"/> 

      <sequenceFlow id="sequenceFlow8" sourceRef="exclusiveGateway2" targetRef="serviceTask2">
        <!--<conditionExpression xsi:type="tFormalExpression">${colorInStock  == false}</conditionExpression>-->
      </sequenceFlow>

      <serviceTask id="serviceTask1" name="Order Plastic Color">
        <incoming>sequenceFlow11</incoming>
        <outgoing>sequenceFlow13</outgoing>
      </serviceTask>

      <sequenceFlow id="sequenceFlow13" sourceRef="serviceTask1" targetRef="serviceTask3"/> 

      <serviceTask id="serviceTask2" name="Prepare 3D Printer">
        <incoming>sequenceFlow8</incoming>
        <incoming>sequenceFlow12</incoming> 
        <outgoing>sequenceFlow14</outgoing>
      </serviceTask>

      <sequenceFlow id="sequenceFlow14" sourceRef="serviceTask2" targetRef="task6"/>

      <userTask id="task6" name="Generate Gcode File">
        <incoming>sequenceFlow14</incoming>
        <outgoing>sequenceFlow15</outgoing>
      </userTask>

      <sequenceFlow id="sequenceFlow15" sourceRef="task6" targetRef="task7"/>

      <serviceTask id="task7" name="Print 3D Model">
        <incoming>sequenceFlow15</incoming>
        <outgoing>sequenceFlow16</outgoing>
      </serviceTask>

      <sequenceFlow id="sequenceFlow16" sourceRef="task7" targetRef="endEvent1"/>

      <endEvent id="endEvent1" name="3D Model Printed">
        <incoming>sequenceFlow16</incoming>
      </endEvent>

    </process>

</definitions>