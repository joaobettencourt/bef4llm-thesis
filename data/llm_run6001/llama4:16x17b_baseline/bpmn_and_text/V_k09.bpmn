<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definitions" name="Storage Management">

   <process id="storageManagementProcess" isExecutable="true">
     <startEvent id="startEvent1">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="readOrderTask"/>

     <serviceTask id="readOrderTask">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlow2" sourceRef="readOrderTask" targetRef="exclusiveGateway1"/>

     <exclusiveGateway id="exclusiveGateway1">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
       <outgoing>sequenceFlow4</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow3" sourceRef="exclusiveGateway1" targetRef="checkProductInStockTask">
       <conditionExpression xsi:type="tFormalExpression">${productInStock == true}</conditionExpression>
     </sequenceFlow>

     <userTask id="checkProductInStockTask">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow5</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow5" sourceRef="checkProductInStockTask" targetRef="withdrawProductFromWarehouseTask"/>

     <serviceTask id="withdrawProductFromWarehouseTask">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow6</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlow6" sourceRef="withdrawProductFromWarehouseTask" targetRef="checkOrderReadyForShipmentExclusiveGateway"/>

     <sequenceFlow id="sequenceFlow4" sourceRef="exclusiveGateway1" targetRef="reorderProductFromWholesalerTask">
       <conditionExpression xsi:type="tFormalExpression">${productInStock == false}</conditionExpression>
     </sequenceFlow>

     <serviceTask id="reorderProductFromWholesalerTask">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow7</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlow7" sourceRef="reorderProductFromWholesalerTask" targetRef="checkWaitingTimeForArrivalExclusiveGateway"/>

     <exclusiveGateway id="checkWaitingTimeForArrivalExclusiveGateway">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow8</outgoing>
       <outgoing>sequenceFlow9</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow8" sourceRef="checkWaitingTimeForArrivalExclusiveGateway" targetRef="registerProductInStockManagementSystemTask">
       <conditionExpression xsi:type="tFormalExpression">${waitingTime <= 10}</conditionExpression>
     </sequenceFlow>

     <serviceTask id="registerProductInStockManagementSystemTask">
       <incoming>sequenceFlow8</incoming>
       <outgoing>sequenceFlow10</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlow10" sourceRef="registerProductInStockManagementSystemTask" targetRef="checkOrderReadyForShipmentExclusiveGateway"/>

     <sequenceFlow id="sequenceFlow9" sourceRef="checkWaitingTimeForArrivalExclusiveGateway" targetRef="demandDeliveryDelayPenaltyTask">
       <conditionExpression xsi:type="tFormalExpression">${waitingTime > 10}</conditionExpression>
     </sequenceFlow>

     <serviceTask id="demandDeliveryDelayPenaltyTask">
       <incoming>sequenceFlow9</incoming>
       <outgoing>sequenceFlow11</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlow11" sourceRef="demandDeliveryDelayPenaltyTask" targetRef="registerProductInStockManagementSystemTask"/>

     <exclusiveGateway id="checkOrderReadyForShipmentExclusiveGateway">
       <incoming>sequenceFlow6</incoming>
       <incoming>sequenceFlow10</incoming>
       <outgoing>sequenceFlow12</outgoing>
       <outgoing>sequenceFlow13</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow12" sourceRef="checkOrderReadyForShipmentExclusiveGateway" targetRef="requestCourierTask">
       <conditionExpression xsi:type="tFormalExpression">${orderReadyForShipment == true}</conditionExpression>
     </sequenceFlow>

     <serviceTask id="requestCourierTask">
       <incoming>sequenceFlow12</incoming>
       <outgoing>sequenceFlow14</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlow14" sourceRef="requestCourierTask" targetRef="packProductsTask"/>

     <serviceTask id="packProductsTask">
       <incoming>sequenceFlow14</incoming>
       <outgoing>sequenceFlow15</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlow15" sourceRef="packProductsTask" targetRef="shipProductsTask"/>

     <serviceTask id="shipProductsTask">
       <incoming>sequenceFlow15</incoming>
       <outgoing>sequenceFlow16</outgoing>
     </serviceTask>

     <endEvent id="endEvent1">
       <incoming>sequenceFlow16</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow13" sourceRef="checkOrderReadyForShipmentExclusiveGateway" targetRef="selectNextProductFromOrderTask">
       <conditionExpression xsi:type="tFormalExpression">${orderReadyForShipment == false}</conditionExpression>
     </sequenceFlow>

     <userTask id="selectNextProductFromOrderTask">
       <incoming>sequenceFlow13</incoming>
       <outgoing>sequenceFlow17</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow17" sourceRef="selectNextProductFromOrderTask" targetRef="exclusiveGateway1"/>

   </process>

</definitions>