<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definitions" 
             targetNamespace="http://example.com/bpmn">

   <process id="newApplicationProcess" isExecutable="true">
     <startEvent id="startEvent1">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="task1"/>

     <userTask id="task1" name="Select a course">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow2" sourceRef="task1" targetRef="exclusiveGateway1"/>

     <exclusiveGateway id="exclusiveGateway1">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
       <outgoing>sequenceFlow4</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow3" sourceRef="exclusiveGateway1" targetRef="task2">
       <conditionExpression xsi:type="tFormalExpression">${slotsAvailable  == true}</conditionExpression>
     </sequenceFlow>

     <userTask id="task2" name="Check course dates and select one">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow5</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow4" sourceRef="exclusiveGateway1" targetRef="endEvent6">
       <conditionExpression xsi:type="tFormalExpression">${slotsAvailable  == false}</conditionExpression>
     </sequenceFlow>

     <endEvent id="endEvent6" name="No slots available">
       <incoming>sequenceFlow4</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow5" sourceRef="task2" targetRef="exclusiveGateway2"/>

     <exclusiveGateway id="exclusiveGateway2">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow6</outgoing>
       <outgoing>sequenceFlow7</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow6" sourceRef="exclusiveGateway2" targetRef="task3">
       <conditionExpression xsi:type="tFormalExpression">${hasAccount  == true}</conditionExpression>
     </sequenceFlow>

     <userTask id="task3" name="Log into your account">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow8</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow7" sourceRef="exclusiveGateway2" targetRef="task4">
       <conditionExpression xsi:type="tFormalExpression">${hasAccount  == false}</conditionExpression>
     </sequenceFlow>

     <userTask id="task4" name="Check if registered at eligible university">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow9</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow9" sourceRef="task4" targetRef="exclusiveGateway3"/>

     <exclusiveGateway id="exclusiveGateway3">
       <incoming>sequenceFlow9</incoming>
       <outgoing>sequenceFlow10</outgoing>
       <outgoing>sequenceFlow11</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow10" sourceRef="exclusiveGateway3" targetRef="task5">
       <conditionExpression xsi:type="tFormalExpression">${registeredAtUniversity  == true}</conditionExpression>
     </sequenceFlow>

     <userTask id="task5" name="Register your account">
       <incoming>sequenceFlow10</incoming>
       <outgoing>sequenceFlow12</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow11" sourceRef="exclusiveGateway3" targetRef="task6">
       <conditionExpression xsi:type="tFormalExpression">${registeredAtUniversity  == false}</conditionExpression>
     </sequenceFlow>

     <userTask id="task6" name="Request activation and wait for response">
       <incoming>sequenceFlow11</incoming>
       <outgoing>sequenceFlow13</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow12" sourceRef="task5" targetRef="task3"/>
     <sequenceFlow id="sequenceFlow13" sourceRef="task6" targetRef="task3"/>

     <sequenceFlow id="sequenceFlow8" sourceRef="task3" targetRef="serviceTask1"/>

     <serviceTask id="serviceTask1" name="Connect to twitter account and tweet to friends">
       <incoming>sequenceFlow8</incoming>
       <outgoing>sequenceFlow14</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlow14" sourceRef="serviceTask1" targetRef="userTask7"/>

     <userTask id="userTask7" name="Complete registration and provide payment information">
       <incoming>sequenceFlow14</incoming>
       <outgoing>sequenceFlow15</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow15" sourceRef="userTask7" targetRef="endEvent1"/>

     <endEvent id="endEvent1" name="Course ticket received">
       <incoming>sequenceFlow15</incoming>
     </endEvent>

   </process>

</definitions>