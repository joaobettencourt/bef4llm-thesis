<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definitions" 
             targetNamespace="http://example.com/bpmn">

   <process id="diyRepairProcess" isExecutable="true">
     <startEvent id="startEvent1">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="task1"/>

     <userTask id="task1" name="Enter model and what's broken">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow2" sourceRef="task1" targetRef="exclusiveGateway1"/>

     <exclusiveGateway id="exclusiveGateway1">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
       <outgoing>sequenceFlow4</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow3" sourceRef="exclusiveGateway1" targetRef="task2"/>

     <userTask id="task2" name="Get instructions to fix phone">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow5</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow5" sourceRef="task2" targetRef="exclusiveGateway4"/>

     <exclusiveGateway id="exclusiveGateway4">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow6</outgoing>
       <outgoing>sequenceFlow7</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow6" sourceRef="exclusiveGateway4" targetRef="endEvent2"/>

     <endEvent id="endEvent2" name="Repair Successful">
       <incoming>sequenceFlow6</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow7" sourceRef="exclusiveGateway4" targetRef="subProcess1"/>

     <subProcess id="subProcess1" name="Order Materials and Tools">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow8</outgoing>

       <userTask id="task3" name="Order materials and tools online">
         <incoming></incoming>
         <outgoing>sequenceFlow81</outgoing>
       </userTask>

       <sequenceFlow id="sequenceFlow81" sourceRef="task3" targetRef="exclusiveGateway2"/>

       <exclusiveGateway id="exclusiveGateway2">
         <incoming>sequenceFlow81</incoming>
         <outgoing>sequenceFlow82</outgoing>
         <outgoing>sequenceFlow83</outgoing>
       </exclusiveGateway>

       <sequenceFlow id="sequenceFlow82" sourceRef="exclusiveGateway2" targetRef="task4"/>

       <userTask id="task4" name="Contact friends for borrowing/buying materials">
         <incoming>sequenceFlow82</incoming>
         <outgoing>sequenceFlow84</outgoing>
       </userTask>

       <sequenceFlow id="sequenceFlow84" sourceRef="task4" targetRef="exclusiveGateway3"/>

       <exclusiveGateway id="exclusiveGateway3">
         <incoming>sequenceFlow84</incoming>
         <outgoing>sequenceFlow85</outgoing>
         <outgoing>sequenceFlow86</outgoing>
       </exclusiveGateway>

       <sequenceFlow id="sequenceFlow85" sourceRef="exclusiveGateway3" targetRef="task5"/>

       <userTask id="task5" name="Buy remaining materials online">
         <incoming>sequenceFlow85</incoming>
         <outgoing>sequenceFlow87</outgoing>
       </userTask>

       <sequenceFlow id="sequenceFlow87" sourceRef="task5" targetRef="endEvent1"/>

       <endEvent id="endEvent1" name="Materials Ready">
         <incoming>sequenceFlow87</incoming>
       </endEvent>

       <sequenceFlow id="sequenceFlow86" sourceRef="exclusiveGateway3" targetRef="serviceTask1"/>

       <serviceTask id="serviceTask1" name="Send to Expert">
         <incoming>sequenceFlow86</incoming>
         <outgoing>sequenceFlow88</outgoing>
       </serviceTask>

       <sequenceFlow id="sequenceFlow88" sourceRef="serviceTask1" targetRef="endEvent3"/>

       <endEvent id="endEvent3" name="Expert Repair">
         <incoming>sequenceFlow88</incoming>
       </endEvent>

     </subProcess>

     <sequenceFlow id="sequenceFlow4" sourceRef="exclusiveGateway1" targetRef="subProcess1"/>

   </process>

</definitions>