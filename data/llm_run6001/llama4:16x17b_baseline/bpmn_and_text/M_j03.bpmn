<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definitions" name="Contract Process">

   <process id="contractProcess" isExecutable="true">
     <startEvent id="startEvent1">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="parallelGateway1"/>

     <parallelGateway id="parallelGateway1">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
       <outgoing>sequenceFlow3</outgoing>
     </parallelGateway>

     <sequenceFlow id="sequenceFlow2" sourceRef="parallelGateway1" targetRef="task1"/>

     <serviceTask id="task1" name="Query Web Shops">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow4</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlow3" sourceRef="parallelGateway1" targetRef="task8"/>

     <userTask id="task8" name="Send Complaint Mail">
       <incoming>sequenceFlow3</incoming>
     </userTask>

     <sequenceFlow id="sequenceFlow4" sourceRef="task1" targetRef="exclusiveGateway1"/>

     <exclusiveGateway id="exclusiveGateway1">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow5</outgoing>
       <outgoing>sequenceFlow6</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow5" sourceRef="exclusiveGateway1" targetRef="task2">
     </sequenceFlow>

     <userTask id="task2" name="Create Order List">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow7</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow6" sourceRef="exclusiveGateway1" targetRef="task3"/>

     <userTask id="task3" name="Order Parts from Multiple Shops">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow7</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow7" sourceRef="task2" targetRef="parallelGateway2"/>
     <sequenceFlow id="sequenceFlow16" sourceRef="task3" targetRef="parallelGateway2"/>

     <parallelGateway id="parallelGateway2">
       <incoming>sequenceFlow7</incoming>
       <incoming>sequenceFlow16</incoming>
       <outgoing>sequenceFlow9</outgoing>
     </parallelGateway>

     <sequenceFlow id="sequenceFlow9" sourceRef="parallelGateway2" targetRef="intermediateEvent1"/>

     <intermediateEvent id="intermediateEvent1">
       <incoming>sequenceFlow9</incoming>
       <outgoing>sequenceFlow10</outgoing>
     </intermediateEvent>

     <sequenceFlow id="sequenceFlow10" sourceRef="intermediateEvent1" targetRef="task4"/>

     <userTask id="task4" name="Build Product">
       <incoming>sequenceFlow10</incoming>
       <outgoing>sequenceFlow11</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow11" sourceRef="task4" targetRef="exclusiveGateway2"/>

     <exclusiveGateway id="exclusiveGateway2">
       <incoming>sequenceFlow11</incoming>
       <outgoing>sequenceFlow12</outgoing>
       <outgoing>sequenceFlow13</outgoing>
       <outgoing>sequenceFlow14</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow12" sourceRef="exclusiveGateway2" targetRef="task5"/>

     <userTask id="task5" name="Monitor Stock Level">
       <incoming>sequenceFlow12</incoming>
       <outgoing>sequenceFlow15</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow13" sourceRef="exclusiveGateway2" targetRef="task6"/>

     <userTask id="task6" name="Reorder Parts (Cheapest)">
       <incoming>sequenceFlow13</incoming>
       <outgoing>sequenceFlow15</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow14" sourceRef="exclusiveGateway2" targetRef="task7"/>

     <userTask id="task7" name="Reorder Parts (Fastest)">
       <incoming>sequenceFlow14</incoming>
       <outgoing>sequenceFlow15</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow15" sourceRef="task5" targetRef="exclusiveGateway3"/>
     <sequenceFlow id="sequenceFlow17" sourceRef="task6" targetRef="exclusiveGateway3"/>
     <sequenceFlow id="sequenceFlow18" sourceRef="task7" targetRef="exclusiveGateway3"/>

     <exclusiveGateway id="exclusiveGateway3">
       <incoming>sequenceFlow15</incoming>
       <incoming>sequenceFlow17</incoming>
       <incoming>sequenceFlow18</incoming>
       <outgoing>sequenceFlow19</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow19" sourceRef="exclusiveGateway3" targetRef="endEvent1"/>

     <endEvent id="endEvent1">
       <incoming>sequenceFlow19</incoming>
     </endEvent>

   </process>

</definitions>