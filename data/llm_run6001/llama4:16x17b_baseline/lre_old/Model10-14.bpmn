<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">

  <process id="InvoiceProcess" isExecutable="true">
    <startEvent id="StartEvent">
      <outgoing>SequenceFlow1</outgoing>
    </startEvent>

    <sequenceFlow id="SequenceFlow1" sourceRef="StartEvent" targetRef="ExclusiveGateway1"/>

    <exclusiveGateway id="ExclusiveGateway1">
      <incoming>SequenceFlow1</incoming>
      <outgoing>SequenceFlow2</outgoing>
      <outgoing>SequenceFlow3</outgoing>
      <outgoing>SequenceFlow4</outgoing>
      <outgoing>SequenceFlow5</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow2" sourceRef="ExclusiveGateway1" targetRef="Task1">
      <conditionExpression xsi:type="tFormalExpression">${sender == 'MPOO' and billType == 'temporaryContinuation'}</conditionExpression>
    </sequenceFlow>

    <task id="Task1" name="Examine Bill from MPOO for Temporary Continuation">
      <incoming>SequenceFlow2</incoming>
      <outgoing>SequenceFlow6</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow3" sourceRef="ExclusiveGateway1" targetRef="Task2">
      <conditionExpression xsi:type="tFormalExpression">${sender == 'MSPO' and (billType == 'temporaryContinuation' or billType == 'additionalReadings')}</conditionExpression>
    </sequenceFlow>

    <task id="Task2" name="Examine Bill from MSPO">
      <incoming>SequenceFlow3</incoming>
      <outgoing>SequenceFlow7</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow4" sourceRef="ExclusiveGateway1" targetRef="Task3">
      <conditionExpression xsi:type="tFormalExpression">${sender == 'MPOO' and billType == 'equipmentAcquisition'}</conditionExpression>
    </sequenceFlow>

    <task id="Task3" name="Examine Bill from MPOO for Equipment Acquisition">
      <incoming>SequenceFlow4</incoming>
      <outgoing>SequenceFlow8</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow5" sourceRef="ExclusiveGateway1" targetRef="Task4">
      <conditionExpression xsi:type="tFormalExpression">${sender == 'MSPO' and billType == 'equipmentAcquisition'}</conditionExpression>
    </sequenceFlow>

    <task id="Task4" name="Examine Bill from MSPO for Equipment Acquisition">
      <incoming>SequenceFlow5</incoming>
      <outgoing>SequenceFlow9</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow6" sourceRef="Task1" targetRef="ExclusiveGateway2"/>

    <exclusiveGateway id="ExclusiveGateway2">
      <incoming>SequenceFlow6</incoming>
      <outgoing>SequenceFlow10</outgoing>
      <outgoing>SequenceFlow11</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow7" sourceRef="Task2" targetRef="ExclusiveGateway2"/>

    <sequenceFlow id="SequenceFlow8" sourceRef="Task3" targetRef="ExclusiveGateway3"/>

    <exclusiveGateway id="ExclusiveGateway3">
      <incoming>SequenceFlow8</incoming>
      <outgoing>SequenceFlow12</outgoing>
      <outgoing>SequenceFlow13</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow9" sourceRef="Task4" targetRef="ExclusiveGateway3"/>

    <sequenceFlow id="SequenceFlow10" sourceRef="ExclusiveGateway2" targetRef="EndEvent1">
      <conditionExpression xsi:type="tFormalExpression">${result == 'confirmed'}</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="SequenceFlow11" sourceRef="ExclusiveGateway2" targetRef="EndEvent2">
      <conditionExpression xsi:type="tFormalExpression">${result == 'rejected'}</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="SequenceFlow12" sourceRef="ExclusiveGateway3" targetRef="EndEvent1"/>

    <sequenceFlow id="SequenceFlow13" sourceRef="ExclusiveGateway3" targetRef="EndEvent2"/>

    <endEvent id="EndEvent1">
      <incoming>SequenceFlow10</incoming>
      <incoming>SequenceFlow12</incoming>
    </endEvent>

    <endEvent id="EndEvent2">
      <incoming>SequenceFlow11</incoming>
      <incoming>SequenceFlow13</incoming>
    </endEvent>
  </process>
</definitions>