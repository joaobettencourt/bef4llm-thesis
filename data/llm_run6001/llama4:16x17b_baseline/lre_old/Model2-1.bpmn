<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">

   <process id="ServiceDegradationProcess" isExecutable="true">
     <!-- Start Event  -->
     <startEvent id="StartEvent1">
       <outgoing>SequenceFlow1</outgoing>
     </startEvent>

     <!-- Sequence Flow 1  -->
     <sequenceFlow id="SequenceFlow1" sourceRef="StartEvent1" targetRef="Task1"/>

     <!-- Task 1: Send Problem Parameters to Customer Service  -->
     <task id="Task1" name="Send problem parameters to TELECO Customer Service">
       <incoming>SequenceFlow1</incoming>
       <outgoing>SequenceFlow2</outgoing>
     </task>

     <!-- Sequence Flow 2  -->
     <sequenceFlow id="SequenceFlow2" sourceRef="Task1" targetRef="Task2"/>

     <!-- Task 2: Enter Problem Report into System T  -->
     <task id="Task2" name="Enter problem report in system T">
       <incoming>SequenceFlow2</incoming>
       <outgoing>SequenceFlow3</outgoing>
     </task>

     <!-- Sequence Flow 3  -->
     <sequenceFlow id="SequenceFlow3" sourceRef="Task2" targetRef="Task3"/>

     <!-- Task 3: Determine Counter Measures and Priorities  -->
     <task id="Task3" name="Determine counter measures and priorities">
       <incoming>SequenceFlow3</incoming>
       <outgoing>SequenceFlow4</outgoing>
     </task>

     <!-- Sequence Flow 4  -->
     <sequenceFlow id="SequenceFlow4" sourceRef="Task3" targetRef="ExclusiveGateway1"/>

     <!-- Exclusive Gateway 1: Compare to Customer SLA  -->
     <exclusiveGateway id="ExclusiveGateway1">
       <incoming>SequenceFlow4</incoming>
       <outgoing>SequenceFlow5</outgoing>
       <outgoing>SequenceFlow6</outgoing>
     </exclusiveGateway>

     <!-- Sequence Flow 5  -->
     <sequenceFlow id="SequenceFlow5" sourceRef="ExclusiveGateway1" targetRef="Task4">
     </sequenceFlow>

     <!-- Task 4: Extra Problem Fix Process (not detailed here)  -->
     <task id="Task4" name="Extra problem fix process for premium customers">
       <incoming>SequenceFlow5</incoming>
     </task>

     <!-- Sequence Flow 6  -->
     <sequenceFlow id="SequenceFlow6" sourceRef="ExclusiveGateway1" targetRef="Task7"/>

     <!-- Task 7: Create Detailed Problem Report  -->
     <task id="Task7" name="Create detailed problem report">
       <incoming>SequenceFlow6</incoming>
       <outgoing>SequenceFlow7</outgoing>
     </task>

     <!-- Sequence Flow 7  -->
     <sequenceFlow id="SequenceFlow7" sourceRef="Task7" targetRef="ServiceManagementSubProcess"/>

     <!-- Sub Process: Service Management  -->
     <subProcess id="ServiceManagementSubProcess">
       <incoming>SequenceFlow7</incoming>
       <outgoing>SequenceFlow8</outgoing>

       <!-- Task 8: Investigate Problem and Create Trouble Report  -->
       <task id="Task8" name="Investigate problem and create trouble report">
         <incoming></incoming>
         <outgoing>SequenceFlow9</outgoing>
       </task>

       <!-- Sequence Flow 9  -->
       <sequenceFlow id="SequenceFlow9" sourceRef="Task8" targetRef="ExclusiveGateway2"/>

       <!-- Exclusive Gateway 2: Send to Resource Provisioning if Necessary  -->
       <exclusiveGateway id="ExclusiveGateway2">
         <incoming>SequenceFlow9</incoming>
         <outgoing>SequenceFlow10</outgoing>
         <outgoing>SequenceFlow11</outgoing>
       </exclusiveGateway>

       <!-- Sequence Flow 10  -->
       <sequenceFlow id="SequenceFlow10" sourceRef="ExclusiveGateway2" targetRef="ResourceProvisioningSubProcess">
       </sequenceFlow>

       <!-- Task 9: Analyze Problem and Create Trouble Report  -->
       <task id="Task9" name="Analyze problem and create trouble report">
         <incoming>SequenceFlow11</incoming>
         <outgoing>SequenceFlow12</outgoing>
       </task>

       <!-- Sequence Flow 12  -->
       <sequenceFlow id="SequenceFlow12" sourceRef="Task9" targetRef="EndEvent1"/>

       <!-- End Event 1: Service Management Ends  -->
       <endEvent id="EndEvent1">
         <incoming>SequenceFlow12</incoming>
       </endEvent>

     </subProcess>

     <!-- Sequence Flow 8  -->
     <sequenceFlow id="SequenceFlow8" sourceRef="ServiceManagementSubProcess" targetRef="ExclusiveGateway3"/>

     <!-- Exclusive Gateway 3: Determine Counter Measures  -->
     <exclusiveGateway id="ExclusiveGateway3">
       <incoming>SequenceFlow8</incoming>
       <outgoing>SequenceFlow13</outgoing>
       <outgoing>SequenceFlow14</outgoing>
       <outgoing>SequenceFlow15</outgoing>
     </exclusiveGateway>

     <!-- Sequence Flow 13  -->
     <sequenceFlow id="SequenceFlow13" sourceRef="ExclusiveGateway3" targetRef="EndEvent2">
     </sequenceFlow>

     <!-- End Event 2: Service Management Ends  -->
     <endEvent id="EndEvent2">
       <incoming>SequenceFlow13</incoming>
     </endEvent>

     <!-- Sequence Flow 14  -->
     <sequenceFlow id="SequenceFlow14" sourceRef="ExclusiveGateway3" targetRef="Task10"/>

     <!-- Task 10: Undertake Corrective Actions  -->
     <task id="Task10" name="Undertake corrective actions">
       <incoming>SequenceFlow14</incoming>
       <outgoing>SequenceFlow16</outgoing>
     </task>

     <!-- Sequence Flow 16  -->
     <sequenceFlow id="SequenceFlow16" sourceRef="Task10" targetRef="EndEvent3"/>

     <!-- End Event 3: Service Management Ends  -->
     <endEvent id="EndEvent3">
       <incoming>SequenceFlow16</incoming>
     </endEvent>

     <!-- Sequence Flow 15  -->
     <sequenceFlow id="SequenceFlow15" sourceRef="ExclusiveGateway3" targetRef="Task11"/>

     <!-- Task 11: Create Request for Automatic Resource Restoration  -->
     <task id="Task11" name="Create request for automatic resource restoration">
       <incoming>SequenceFlow15</incoming>
       <outgoing>SequenceFlow17</outgoing>
     </task>

     <!-- Sequence Flow 17  -->
     <sequenceFlow id="SequenceFlow17" sourceRef="Task11" targetRef="ResourceProvisioningSubProcess2"/>

     <!-- Sub Process: Resource Provisioning (Restoration)  -->
     <subProcess id="ResourceProvisioningSubProcess2">
       <incoming>SequenceFlow17</incoming>
       <outgoing>SequenceFlow18</outgoing>

       <!-- Task 12: Track Errors and Undertake Corrective Actions  -->
       <task id="Task12" name="Track errors and undertake corrective actions">
         <incoming></incoming>
         <outgoing>SequenceFlow19</outgoing>
       </task>

       <!-- Sequence Flow 19  -->
       <sequenceFlow id="SequenceFlow19" sourceRef="Task12" targetRef="EndEvent4"/>

       <!-- End Event 4: Resource Provisioning Ends  -->
       <endEvent id="EndEvent4">
         <incoming>SequenceFlow19</incoming>
       </endEvent>

     </subProcess>

     <!-- Sequence Flow 18  -->
     <sequenceFlow id="SequenceFlow18" sourceRef="ResourceProvisioningSubProcess2" targetRef="Task13"/>

     <!-- Task 13: Create Trouble-Shooting Report and Send to Service Management  -->
     <task id="Task13" name="Create trouble-shooting report and send to Service Management">
       <incoming>SequenceFlow18</incoming>
     </task>

   </process>

   <!-- Sub Process: Resource Provisioning  -->
   <subProcess id="ResourceProvisioningSubProcess">
     <outgoing>SequenceFlow20</outgoing>

     <!-- Task 14: Check for Possible Problems  -->
     <task id="Task14" name="Check for possible problems">
       <incoming></incoming>
       <outgoing>SequenceFlow21</outgoing>
     </task>

     <!-- Sequence Flow 21  -->
     <sequenceFlow id="SequenceFlow21" sourceRef="Task14" targetRef="ExclusiveGateway4"/>

     <!-- Exclusive Gateway 4: Analyze Problem if Necessary  -->
     <exclusiveGateway id="ExclusiveGateway4">
       <incoming>SequenceFlow21</incoming>
       <outgoing>SequenceFlow22</outgoing>
       <outgoing>SequenceFlow23</outgoing>
     </exclusiveGateway>

     <!-- Sequence Flow 22  -->
     <sequenceFlow id="SequenceFlow22" sourceRef="ExclusiveGateway4" targetRef="EndEvent5">
     </sequenceFlow>

     <!-- End Event 5: Normal Service Execution  -->
     <endEvent id="EndEvent5">
       <incoming>SequenceFlow22</incoming>
     </endEvent>

     <!-- Sequence Flow 23  -->
     <sequenceFlow id="SequenceFlow23" sourceRef="ExclusiveGateway4" targetRef="Task15"/>

     <!-- Task 15: Analyze Problem and Create Trouble Report  -->
     <task id="Task15" name="Analyze problem and create trouble report">
       <incoming>SequenceFlow23</incoming>
       <outgoing>SequenceFlow24</outgoing>
     </task>

     <!-- Sequence Flow 24  -->
     <sequenceFlow id="SequenceFlow24" sourceRef="Task15" targetRef="EndEvent6"/>

     <!-- End Event 6: Resource Provisioning Ends  -->
     <endEvent id="EndEvent6">
       <incoming>SequenceFlow24</incoming>
     </endEvent>

     <!-- Sequence Flow 20  -->
     <sequenceFlow id="SequenceFlow20" sourceRef="ResourceProvisioningSubProcess" targetRef="Task9"/>

   </subProcess>

 </definitions>