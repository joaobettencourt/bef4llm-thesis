<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">

  <process id="SwitchOverProcess" isExecutable="true">
    <startEvent id="StartEvent">
      <incoming>none</incoming>
      <outgoing>SequenceFlow1</outgoing>
    </startEvent>

    <sequenceFlow id="SequenceFlow1" sourceRef="StartEvent" targetRef="Task1"/>

    <task id="Task1" name="Receive Customer Data">
      <incoming>SequenceFlow1</incoming>
      <outgoing>SequenceFlow2</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow2" sourceRef="Task1" targetRef="Task2"/>

    <task id="Task2" name="Enter Customer Data into CRM">
      <incoming>SequenceFlow2</incoming>
      <outgoing>SequenceFlow3</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow3" sourceRef="Task2" targetRef="ExclusiveGateway1"/>

    <exclusiveGateway id="ExclusiveGateway1">
      <incoming>SequenceFlow3</incoming>
      <outgoing>SequenceFlow4</outgoing>
      <outgoing>SequenceFlow5</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow4" sourceRef="ExclusiveGateway1" targetRef="Task3">
      <conditionExpression xsi:type="tFormalExpression">${customerExists}</conditionExpression>
    </sequenceFlow>

    <task id="Task3" name="Compare and Correct Customer Data">
      <incoming>SequenceFlow4</incoming>
      <outgoing>SequenceFlow6</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow5" sourceRef="ExclusiveGateway1" targetRef="Task7"/>

    <task id="Task7" name="Create New Customer Object">
      <incoming>SequenceFlow5</incoming>
      <outgoing>SequenceFlow8</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow6" sourceRef="Task3" targetRef="Task8"/>
    <sequenceFlow id="SequenceFlow8" sourceRef="Task7" targetRef="Task8"/>

    <task id="Task8" name="Prepare Contract Documents">
      <incoming>SequenceFlow6</incoming>
      <incoming>SequenceFlow8</incoming>
      <outgoing>SequenceFlow9</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow9" sourceRef="Task8" targetRef="ExclusiveGateway2"/>

    <exclusiveGateway id="ExclusiveGateway2">
      <incoming>SequenceFlow9</incoming>
      <outgoing>SequenceFlow10</outgoing>
      <outgoing>SequenceFlow11</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow10" sourceRef="ExclusiveGateway2" targetRef="Task9">
      <conditionExpression xsi:type="tFormalExpression">${contractDocumentsValid}</conditionExpression>
    </sequenceFlow>

    <task id="Task9" name="Send Confirmation to Customer">
      <incoming>SequenceFlow10</incoming>
      <outgoing>SequenceFlow12</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow11" sourceRef="ExclusiveGateway2" targetRef="Task15"/>

    <task id="Task15" name="Analyze and Resolve Issues">
      <incoming>SequenceFlow11</incoming>
      <outgoing>SequenceFlow16</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow12" sourceRef="Task9" targetRef="Task10"/>
    <sequenceFlow id="SequenceFlow16" sourceRef="Task15" targetRef="Task8"/>

    <task id="Task10" name="Request Grid Operator Response">
      <incoming>SequenceFlow12</incoming>
      <outgoing>SequenceFlow13</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow13" sourceRef="Task10" targetRef="ExclusiveGateway3"/>

    <exclusiveGateway id="ExclusiveGateway3">
      <incoming>SequenceFlow13</incoming>
      <outgoing>SequenceFlow14</outgoing>
      <outgoing>SequenceFlow17</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow14" sourceRef="ExclusiveGateway3" targetRef="Task11">
      <conditionExpression xsi:type="tFormalExpression">${gridOperatorResponse == 'positive'}</conditionExpression>
    </sequenceFlow>

    <task id="Task11" name="Create CIS Contract">
      <incoming>SequenceFlow14</incoming>
      <outgoing>SequenceFlow18</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow17" sourceRef="ExclusiveGateway3" targetRef="EndEvent2"/>

    <endEvent id="EndEvent2">
      <incoming>SequenceFlow17</incoming>
    </endEvent>

    <sequenceFlow id="SequenceFlow18" sourceRef="Task11" targetRef="Task12"/>

    <task id="Task12" name="Customer Checks Contract Details">
      <incoming>SequenceFlow18</incoming>
      <outgoing>SequenceFlow19</outgoing>
      <outgoing>SequenceFlow20</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow19" sourceRef="Task12" targetRef="EndEvent1">
      <conditionExpression xsi:type="tFormalExpression">${customerAcceptsContract}</conditionExpression>
    </sequenceFlow>

    <endEvent id="EndEvent1">
      <incoming>SequenceFlow19</incoming>
    </endEvent>

    <sequenceFlow id="SequenceFlow20" sourceRef="Task12" targetRef="ExclusiveGateway4"/>

    <exclusiveGateway id="ExclusiveGateway4">
      <incoming>SequenceFlow20</incoming>
      <outgoing>SequenceFlow21</outgoing>
      <outgoing>SequenceFlow22</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow21" sourceRef="ExclusiveGateway4" targetRef="EndEvent1">
      <conditionExpression xsi:type="tFormalExpression">${7DaysPassed}</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="SequenceFlow22" sourceRef="ExclusiveGateway4" targetRef="Task13"/>

    <task id="Task13" name="Grid Operator Transmits Meter Data">
      <incoming>SequenceFlow22</incoming>
      <!-- Add more tasks and sequence flows as necessary -->
    </task>

  </process>
</definitions>