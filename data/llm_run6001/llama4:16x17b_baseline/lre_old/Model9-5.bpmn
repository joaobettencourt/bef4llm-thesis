<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="Definitions" targetNamespace="http://www.example.com">

   <process id="ExpenseReportProcess" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_CreateAccount"/>

     <task id="Task_CreateAccount" name="Create new account if necessary">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_CreateAccount" targetRef="ExclusiveGateway_ReviewReport"/>

     <exclusiveGateway id="ExclusiveGateway_ReviewReport">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_4</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_3" name="Automatic Approval" sourceRef="ExclusiveGateway_ReviewReport" targetRef="Task_AutomaticApproval">
     </sequenceFlow>

     <task id="Task_AutomaticApproval" name="Automatically approve expense report">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_AutomaticApproval" targetRef="ExclusiveGateway_ApproveOrReject"/>

     <sequenceFlow id="SequenceFlow_4" name="Supervisor Approval Required" sourceRef="ExclusiveGateway_ReviewReport" targetRef="Task_SupervisorApproval">
     </sequenceFlow>

     <task id="Task_SupervisorApproval" name="Send for supervisor approval">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_6</outgoing>
       <outgoing>SequenceFlow_7</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_SupervisorApproval" targetRef="ExclusiveGateway_ApproveOrReject"/>

     <exclusiveGateway id="ExclusiveGateway_ApproveOrReject">
       <incoming>SequenceFlow_6</incoming>
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_8</outgoing>
       <outgoing>SequenceFlow_9</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_8" sourceRef="ExclusiveGateway_ApproveOrReject" targetRef="Task_ReimburseEmployee"/>

     <task id="Task_ReimburseEmployee" name="Reimburse employee via direct deposit">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_10</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_10" sourceRef="Task_ReimburseEmployee" targetRef="IntermediateCatchEvent_ApprovalInProgress"/>

     <intermediateCatchEvent id="IntermediateCatchEvent_ApprovalInProgress">
       <incoming>SequenceFlow_10</incoming>
       <outgoing>SequenceFlow_11</outgoing>
       <timerEventDefinition>
         <timeDuration>P7D</timeDuration>
       </timerEventDefinition>
     </intermediateCatchEvent>

     <sequenceFlow id="SequenceFlow_11" sourceRef="IntermediateCatchEvent_ApprovalInProgress" targetRef="Task_SendApprovalInProgressEmail"/>

     <task id="Task_SendApprovalInProgressEmail" name="Send approval in progress email to employee">
       <incoming>SequenceFlow_11</incoming>
     </task>

     <intermediateCatchEvent id="IntermediateCatchEvent_CancellationNotice">
       <outgoing>SequenceFlow_12</outgoing>
       <timerEventDefinition>
         <timeDuration>P30D</timeDuration>
       </timerEventDefinition>
     </intermediateCatchEvent>

     <sequenceFlow id="SequenceFlow_12" sourceRef="IntermediateCatchEvent_CancellationNotice" targetRef="EndEvent_CancellationNotice"/>

     <endEvent id="EndEvent_CancellationNotice">
       <incoming>SequenceFlow_12</incoming>
     </endEvent>

     <sequenceFlow id="SequenceFlow_9" sourceRef="ExclusiveGateway_ApproveOrReject" targetRef="EndEvent_RejectionNotice"/>
     <endEvent id="EndEvent_RejectionNotice">
       <incoming>SequenceFlow_7</incoming>
       <incoming>SequenceFlow_9</incoming>
     </endEvent>

     <sequenceFlow id="SequenceFlow_7" sourceRef="Task_SupervisorApproval" targetRef="EndEvent_RejectionNotice"/>
   </process>
</definitions>