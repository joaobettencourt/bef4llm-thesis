<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="Definitions" targetNamespace="http://www.example.com">

  <process id="MeasuringPointChangeProcess" isExecutable="true">
    <startEvent id="StartEvent">
      <outgoing>SequenceFlow1</outgoing>
    </startEvent>

    <sequenceFlow id="SequenceFlow1" sourceRef="StartEvent" targetRef="Task1"/>

    <task id="Task1" name="MPO receives change request from SP/PU/GO or MPO himself">
      <incoming>SequenceFlow1</incoming>
      <outgoing>SequenceFlow2</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow2" sourceRef="Task1" targetRef="ExclusiveGateway1"/>

    <exclusiveGateway id="ExclusiveGateway1">
      <incoming>SequenceFlow2</incoming>
      <outgoing>SequenceFlow3</outgoing>
      <outgoing>SequenceFlow4</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow3" sourceRef="ExclusiveGateway1" targetRef="Task2">
      <conditionExpression xsi:type="tFormalExpression">${changeRequestAccepted == true}</conditionExpression>
    </sequenceFlow>

    <task id="Task2" name="MPO confirms request of SP/PU/GO">
      <incoming>SequenceFlow3</incoming>
      <outgoing>SequenceFlow5</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow4" sourceRef="ExclusiveGateway1" targetRef="EndEvent1">
      <conditionExpression xsi:type="tFormalExpression">${changeRequestAccepted == false}</conditionExpression>
    </sequenceFlow>

    <endEvent id="EndEvent1" name="Change request rejected">
      <incoming>SequenceFlow4</incoming>
    </endEvent>

    <sequenceFlow id="SequenceFlow5" sourceRef="Task2" targetRef="Task3"/>

    <task id="Task3" name="MPO performs measuring point change">
      <incoming>SequenceFlow5</incoming>
      <outgoing>SequenceFlow6</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow6" sourceRef="Task3" targetRef="ExclusiveGateway2"/>

    <exclusiveGateway id="ExclusiveGateway2">
      <incoming>SequenceFlow6</incoming>
      <outgoing>SequenceFlow7</outgoing>
      <outgoing>SequenceFlow8</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow7" sourceRef="ExclusiveGateway2" targetRef="Task4">
      <conditionExpression xsi:type="tFormalExpression">${changeSuccessful == true}</conditionExpression>
    </sequenceFlow>

    <task id="Task4" name="MPO reports implementation to SP/PU/GO">
      <incoming>SequenceFlow7</incoming>
    </task>

    <sequenceFlow id="SequenceFlow8" sourceRef="ExclusiveGateway2" targetRef="Task5">
      <conditionExpression xsi:type="tFormalExpression">${changeSuccessful == false}</conditionExpression>
    </sequenceFlow>

    <task id="Task5" name="MPO notifies SP/PU/GO about failure of changes">
      <incoming>SequenceFlow8</incoming>
    </task>
  </process>
</definitions>