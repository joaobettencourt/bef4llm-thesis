<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="Definitions" targetNamespace="http://www.example.com">

  <process id="ClaimHandlingProcess" isExecutable="true">
    <startEvent id="StartEvent">
      <outgoing>SequenceFlow1</outgoing>
    </startEvent>

    <sequenceFlow id="SequenceFlow1" sourceRef="StartEvent" targetRef="Task1"/>

    <task id="Task1" name="Register Claim">
      <incoming>SequenceFlow1</incoming>
      <outgoing>SequenceFlow2</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow2" sourceRef="Task1" targetRef="Task2"/>

    <task id="Task2" name="Examine Claim and Write Settlement Recommendation">
      <incoming>SequenceFlow2</incoming>
      <outgoing>SequenceFlow3</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow3" sourceRef="Task2" targetRef="Task3"/>

    <task id="Task3" name="Check Settlement Recommendation">
      <incoming>SequenceFlow3</incoming>
      <outgoing>SequenceFlow4</outgoing>
      <outgoing>SequenceFlow5</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow4" sourceRef="Task3" targetRef="Task2">
      <conditionExpression xsi:type="tFormalExpression">${recommendationStatus == 'Not OK'}</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="SequenceFlow5" sourceRef="Task3" targetRef="EndEvent1">
      <conditionExpression xsi:type="tFormalExpression">${recommendationStatus == 'OK'}</conditionExpression>
    </sequenceFlow>

    <endEvent id="EndEvent1">
      <incoming>SequenceFlow5</incoming>
    </endEvent>
  </process>
</definitions>