<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="Definitions" targetNamespace="http://www.example.com">

  <process id="BicycleOrderProcess" isExecutable="true">
    <startEvent id="StartEvent">
      <outgoing>SequenceFlow1</outgoing>
    </startEvent>

    <sequenceFlow id="SequenceFlow1" sourceRef="StartEvent" targetRef="ExclusiveGateway1"/>

    <exclusiveGateway id="ExclusiveGateway1">
      <incoming>SequenceFlow1</incoming>
      <outgoing>SequenceFlow2</outgoing>
      <outgoing>SequenceFlow3</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow2" sourceRef="ExclusiveGateway1" targetRef="EndEvent1">
      <conditionExpression xsi:type="tFormalExpression">${orderAccepted == false}</conditionExpression>
    </sequenceFlow>

    <endEvent id="EndEvent1">
      <incoming>SequenceFlow2</incoming>
    </endEvent>

    <sequenceFlow id="SequenceFlow3" sourceRef="ExclusiveGateway1" targetRef="ParallelGateway1">
      <conditionExpression xsi:type="tFormalExpression">${orderAccepted == true}</conditionExpression>
    </sequenceFlow>

    <parallelGateway id="ParallelGateway1">
      <incoming>SequenceFlow3</incoming>
      <outgoing>SequenceFlow4</outgoing>
      <outgoing>SequenceFlow5</outgoing>
    </parallelGateway>

    <sequenceFlow id="SequenceFlow4" sourceRef="ParallelGateway1" targetRef="Task2"/>

    <task id="Task2" name="Prepare for Assembly">
      <incoming>SequenceFlow4</incoming>
      <outgoing>SequenceFlow6</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow5" sourceRef="ParallelGateway1" targetRef="Task1"/>

    <task id="Task1" name="Process Part List">
      <incoming>SequenceFlow5</incoming>
      <outgoing>SequenceFlow7</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow6" sourceRef="Task2" targetRef="ExclusiveGateway2"/>

    <exclusiveGateway id="ExclusiveGateway2">
      <incoming>SequenceFlow6</incoming>
      <outgoing>SequenceFlow8</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow7" sourceRef="Task1" targetRef="ExclusiveGateway3"/>

    <exclusiveGateway id="ExclusiveGateway3">
      <incoming>SequenceFlow7</incoming>
      <outgoing>SequenceFlow9</outgoing>
      <outgoing>SequenceFlow10</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow8" sourceRef="ExclusiveGateway2" targetRef="Task3"/>

    <task id="Task3" name="Assemble Bicycle">
      <incoming>SequenceFlow8</incoming>
      <outgoing>SequenceFlow11</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow9" sourceRef="ExclusiveGateway3" targetRef="Task1">
      <conditionExpression xsi:type="tFormalExpression">${partAvailable == true}</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="SequenceFlow10" sourceRef="ExclusiveGateway3" targetRef="Task4">
      <conditionExpression xsi:type="tFormalExpression">${partAvailable == false}</conditionExpression>
    </sequenceFlow>

    <task id="Task4" name="Backorder Part">
      <incoming>SequenceFlow10</incoming>
    </task>

    <sequenceFlow id="SequenceFlow11" sourceRef="Task3" targetRef="Task5"/>

    <task id="Task5" name="Ship Bicycle">
      <incoming>SequenceFlow11</incoming>
      <outgoing>SequenceFlow12</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow12" sourceRef="Task5" targetRef="EndEvent2"/>

    <endEvent id="EndEvent2">
      <incoming>SequenceFlow12</incoming>
    </endEvent>
  </process>
</definitions>