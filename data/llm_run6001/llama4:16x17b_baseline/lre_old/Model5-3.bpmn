<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="Definitions" targetNamespace="http://www.example.com">

  <process id="OfficeSupplyRequestProcess" isExecutable="true">
    <startEvent id="StartEvent">
      <outgoing>SequenceFlow1</outgoing>
    </startEvent>

    <sequenceFlow id="SequenceFlow1" sourceRef="StartEvent" targetRef="Task1"/>

    <task id="Task1" name="Submit Office Supply Request">
      <incoming>SequenceFlow1</incoming>
      <outgoing>SequenceFlow2</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow2" sourceRef="Task1" targetRef="ExclusiveGateway1"/>

    <exclusiveGateway id="ExclusiveGateway1">
      <incoming>SequenceFlow2</incoming>
      <outgoing>SequenceFlow3</outgoing>
      <outgoing>SequenceFlow4</outgoing>
      <outgoing>SequenceFlow5</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow3" sourceRef="ExclusiveGateway1" targetRef="Task2">
      <conditionExpression xsi:type="tFormalExpression">${approvalStatus == 'approved'}</conditionExpression>
    </sequenceFlow>

    <task id="Task2" name="Approve Request">
      <incoming>SequenceFlow3</incoming>
      <outgoing>SequenceFlow6</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow4" sourceRef="ExclusiveGateway1" targetRef="EndEvent1">
      <conditionExpression xsi:type="tFormalExpression">${approvalStatus == 'rejected'}</conditionExpression>
    </sequenceFlow>

    <endEvent id="EndEvent1">
      <incoming>SequenceFlow4</incoming>
    </endEvent>

    <sequenceFlow id="SequenceFlow5" sourceRef="ExclusiveGateway1" targetRef="Task3">
      <conditionExpression xsi:type="tFormalExpression">${approvalStatus == 'change required'}</conditionExpression>
    </sequenceFlow>

    <task id="Task3" name="Request Changes">
      <incoming>SequenceFlow5</incoming>
      <outgoing>SequenceFlow8</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow6" sourceRef="Task2" targetRef="SubProcess1"/>

    <subProcess id="SubProcess1" name="Make Quotation and Select Vendor">
      <incoming>SequenceFlow6</incoming>
      <outgoing>SequenceFlow7</outgoing>
    </subProcess>

    <sequenceFlow id="SequenceFlow7" sourceRef="SubProcess1" targetRef="ExclusiveGateway2"/>

    <exclusiveGateway id="ExclusiveGateway2">
      <incoming>SequenceFlow7</incoming>
      <outgoing>SequenceFlow9</outgoing>
      <outgoing>SequenceFlow10</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow9" sourceRef="ExclusiveGateway2" targetRef="Task4">
      <conditionExpression xsi:type="tFormalExpression">${vendorStatus == 'valid'}</conditionExpression>
    </sequenceFlow>

    <task id="Task4" name="Generate and Send Purchase Order">
      <incoming>SequenceFlow9</incoming>
      <outgoing>SequenceFlow11</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow10" sourceRef="ExclusiveGateway2" targetRef="Task5">
      <conditionExpression xsi:type="tFormalExpression">${vendorStatus == 'invalid'}</conditionExpression>
    </sequenceFlow>

    <task id="Task5" name="Select Different Vendor">
      <incoming>SequenceFlow10</incoming>
      <outgoing>SequenceFlow12</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow11" sourceRef="Task4" targetRef="EndEvent2"/>

    <endEvent id="EndEvent2">
      <incoming>SequenceFlow11</incoming>
    </endEvent>

    <sequenceFlow id="SequenceFlow12" sourceRef="Task5" targetRef="Task4"/>

    <sequenceFlow id="SequenceFlow8" sourceRef="Task3" targetRef="Task1"/>
  </process>
</definitions>