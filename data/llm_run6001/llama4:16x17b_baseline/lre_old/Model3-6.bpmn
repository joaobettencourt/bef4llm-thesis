<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="Definitions" targetNamespace="http://www.example.com">

  <process id="ClaimsNotificationProcess" isExecutable="true">
    <startEvent id="StartEvent">
      <outgoing>SequenceFlow1</outgoing>
    </startEvent>

    <sequenceFlow id="SequenceFlow1" sourceRef="StartEvent" targetRef="Task1"/>

    <task id="Task1" name="Check if claimant is insured">
      <incoming>SequenceFlow1</incoming>
      <outgoing>SequenceFlow2</outgoing>
      <outgoing>SequenceFlow3</outgoing>
    </task>

    <exclusiveGateway id="ExclusiveGateway1">
      <incoming>SequenceFlow2</incoming>
      <outgoing>SequenceFlow4</outgoing>
      <outgoing>SequenceFlow5</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow2" sourceRef="Task1" targetRef="ExclusiveGateway1">
      <conditionExpression xsi:type="tFormalExpression">${isInsured == true}</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="SequenceFlow3" sourceRef="Task1" targetRef="EndEvent1">
      <conditionExpression xsi:type="tFormalExpression">${isInsured == false}</conditionExpression>
    </sequenceFlow>

    <task id="Task2" name="Inform claimant about rejection">
      <incoming>SequenceFlow3</incoming>
    </task>

    <endEvent id="EndEvent1">
      <incoming>SequenceFlow3</incoming>
    </endEvent>

    <sequenceFlow id="SequenceFlow4" sourceRef="ExclusiveGateway1" targetRef="Task3"/>

    <task id="Task3" name="Evaluate claim severity">
      <incoming>SequenceFlow4</incoming>
      <outgoing>SequenceFlow6</outgoing>
      <outgoing>SequenceFlow7</outgoing>
    </task>

    <exclusiveGateway id="ExclusiveGateway2">
      <incoming>SequenceFlow6</incoming>
      <outgoing>SequenceFlow8</outgoing>
      <outgoing>SequenceFlow9</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow5" sourceRef="ExclusiveGateway1" targetRef="Task3"/>

    <sequenceFlow id="SequenceFlow6" sourceRef="Task3" targetRef="ExclusiveGateway2">
      <conditionExpression xsi:type="tFormalExpression">${claimSeverity == 'simple'}</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="SequenceFlow7" sourceRef="Task3" targetRef="ExclusiveGateway2">
      <conditionExpression xsi:type="tFormalExpression">${claimSeverity == 'complex'}</conditionExpression>
    </sequenceFlow>

    <task id="Task4" name="Send simple claim form">
      <incoming>SequenceFlow8</incoming>
      <outgoing>SequenceFlow10</outgoing>
    </task>

    <task id="Task5" name="Send complex claim form">
      <incoming>SequenceFlow9</incoming>
      <outgoing>SequenceFlow11</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow8" sourceRef="ExclusiveGateway2" targetRef="Task4"/>

    <sequenceFlow id="SequenceFlow9" sourceRef="ExclusiveGateway2" targetRef="Task5"/>

    <task id="Task6" name="Check form for completeness">
      <incoming>SequenceFlow10</incoming>
      <incoming>SequenceFlow11</incoming>
      <outgoing>SequenceFlow12</outgoing>
      <outgoing>SequenceFlow13</outgoing>
    </task>

    <exclusiveGateway id="ExclusiveGateway3">
      <incoming>SequenceFlow12</incoming>
      <outgoing>SequenceFlow14</outgoing>
      <outgoing>SequenceFlow15</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow10" sourceRef="Task4" targetRef="Task6"/>

    <sequenceFlow id="SequenceFlow11" sourceRef="Task5" targetRef="Task6"/>

    <sequenceFlow id="SequenceFlow12" sourceRef="Task6" targetRef="ExclusiveGateway3">
      <conditionExpression xsi:type="tFormalExpression">${formComplete == true}</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="SequenceFlow13" sourceRef="Task6" targetRef="Task7">
      <conditionExpression xsi:type="tFormalExpression">${formComplete == false}</conditionExpression>
    </sequenceFlow>

    <task id="Task7" name="Inform claimant to update form">
      <incoming>SequenceFlow13</incoming>
      <outgoing>SequenceFlow16</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow14" sourceRef="ExclusiveGateway3" targetRef="Task8"/>

    <task id="Task8" name="Register claim in Claims Management system">
      <incoming>SequenceFlow14</incoming>
    </task>

    <endEvent id="EndEvent2">
      <incoming>SequenceFlow15</incoming>
    </endEvent>

    <sequenceFlow id="SequenceFlow15" sourceRef="ExclusiveGateway3" targetRef="EndEvent2"/>

    <sequenceFlow id="SequenceFlow16" sourceRef="Task7" targetRef="Task6"/>
  </process>
</definitions>