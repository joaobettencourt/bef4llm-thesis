<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="Definitions" targetNamespace="http://www.example.com">

   <process id="LoanApprovalProcess" isExecutable="true">
     <startEvent id="StartEvent1">
       <outgoing>SequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow1" sourceRef="StartEvent1" targetRef="Task1"/>

     <task id="Task1" name="Receive Customer Request">
       <incoming>SequenceFlow1</incoming>
       <outgoing>SequenceFlow2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow2" sourceRef="Task1" targetRef="ServiceTask1"/>

     <serviceTask id="ServiceTask1" name="Invoke Risk Assessment Web Service">
       <incoming>SequenceFlow2</incoming>
       <outgoing>SequenceFlow3</outgoing>
     </serviceTask>

     <sequenceFlow id="SequenceFlow3" sourceRef="ServiceTask1" targetRef="ExclusiveGateway1"/>

     <exclusiveGateway id="ExclusiveGateway1">
       <incoming>SequenceFlow3</incoming>
       <outgoing>SequenceFlow4</outgoing>
       <outgoing>SequenceFlow5</outgoing>
       <outgoing>SequenceFlow6</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow4" sourceRef="ExclusiveGateway1" targetRef="EndEvent1">
       <conditionExpression xsi:type="tFormalExpression">${riskAssessment == 'low' and loanAmount < 10000}</conditionExpression>
     </sequenceFlow>

     <endEvent id="EndEvent1">
       <incoming>SequenceFlow4</incoming>
     </endEvent>

     <sequenceFlow id="SequenceFlow5" sourceRef="ExclusiveGateway1" targetRef="EndEvent2">
       <conditionExpression xsi:type="tFormalExpression">${riskAssessment == 'high'}</conditionExpression>
     </sequenceFlow>

     <endEvent id="EndEvent2">
       <incoming>SequenceFlow5</incoming>
     </endEvent>

     <sequenceFlow id="SequenceFlow6" sourceRef="ExclusiveGateway1" targetRef="ServiceTask2">
       <conditionExpression xsi:type="tFormalExpression">${riskAssessment == 'needs review' or loanAmount >= 10000}</conditionExpression>
     </sequenceFlow>

     <serviceTask id="ServiceTask2" name="Invoke Approver Web Service">
       <incoming>SequenceFlow6</incoming>
       <outgoing>SequenceFlow7</outgoing>
     </serviceTask>

     <sequenceFlow id="SequenceFlow7" sourceRef="ServiceTask2" targetRef="EndEvent3"/>

     <endEvent id="EndEvent3">
       <incoming>SequenceFlow7</incoming>
     </endEvent>
   </process>
 </definitions>