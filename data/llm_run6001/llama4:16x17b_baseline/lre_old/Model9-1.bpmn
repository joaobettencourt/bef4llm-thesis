<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="Definitions" targetNamespace="http://www.example.com">

  <process id="DailyDefaultersProcess" isExecutable="true">
    <startEvent id="StartEvent">
      <outgoing>SequenceFlow1</outgoing>
    </startEvent>

    <sequenceFlow id="SequenceFlow1" sourceRef="StartEvent" targetRef="Task1"/>

    <task id="Task1" name="Backup Database">
      <incoming>SequenceFlow1</incoming>
      <outgoing>SequenceFlow2</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow2" sourceRef="Task1" targetRef="Task2"/>

    <task id="Task2" name="Check for New Defaulters">
      <incoming>SequenceFlow2</incoming>
      <outgoing>SequenceFlow3</outgoing>
      <outgoing>SequenceFlow4</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow3" sourceRef="Task2" targetRef="ExclusiveGateway1">
      <conditionExpression xsi:type="tFormalExpression">${newDefaultersFound}</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="SequenceFlow4" sourceRef="Task2" targetRef="Task3">
      <conditionExpression xsi:type="tFormalExpression">${not newDefaultersFound}</conditionExpression>
    </sequenceFlow>

    <exclusiveGateway id="ExclusiveGateway1">
      <incoming>SequenceFlow3</incoming>
      <outgoing>SequenceFlow5</outgoing>
    </exclusiveGateway>

    <task id="Task3" name="Check CRM for New Returns">
      <incoming>SequenceFlow4</incoming>
      <outgoing>SequenceFlow6</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow5" sourceRef="ExclusiveGateway1" targetRef="Task4"/>

    <task id="Task4" name="Register Defaulting Accounts and Customers">
      <incoming>SequenceFlow5</incoming>
      <outgoing>SequenceFlow7</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow6" sourceRef="Task3" targetRef="ExclusiveGateway2">
      <conditionExpression xsi:type="tFormalExpression">${newReturnsFound}</conditionExpression>
    </sequenceFlow>

    <exclusiveGateway id="ExclusiveGateway2">
      <incoming>SequenceFlow6</incoming>
      <outgoing>SequenceFlow8</outgoing>
    </exclusiveGateway>

    <task id="Task5" name="Produce Defaulting Accounts Report and Send to Account Management">
      <incoming>SequenceFlow7</incoming>
      <outgoing>SequenceFlow9</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow7" sourceRef="Task4" targetRef="Task5"/>

    <sequenceFlow id="SequenceFlow8" sourceRef="ExclusiveGateway2" targetRef="Task5"/>

    <sequenceFlow id="SequenceFlow9" sourceRef="Task5" targetRef="IntermediateCatchEvent1">
      <conditionExpression xsi:type="tFormalExpression">${currentTime > '14:30'}</conditionExpression>
    </sequenceFlow>

    <intermediateCatchEvent id="IntermediateCatchEvent1">
      <incoming>SequenceFlow9</incoming>
      <outgoing>SequenceFlow10</outgoing>
      <timerEventDefinition>
        <timeDate>2024-01-01T14:30:00</timeDate>
      </timerEventDefinition>
    </intermediateCatchEvent>

    <sequenceFlow id="SequenceFlow10" sourceRef="IntermediateCatchEvent1" targetRef="Task6"/>

    <task id="Task6" name="Send Alert to Supervisor">
      <incoming>SequenceFlow10</incoming>
    </task>

    <sequenceFlow id="SequenceFlow11" sourceRef="Task5" targetRef="Task7">

    </sequenceFlow>

    <task id="Task7" name="Reconcile with Existing Account Defaulters Table">
      <incoming>SequenceFlow11</incoming>
      <outgoing>SequenceFlow12</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow12" sourceRef="Task7" targetRef="IntermediateCatchEvent2">
      <conditionExpression xsi:type="tFormalExpression">${currentTime > '16:00'}</conditionExpression>
    </sequenceFlow>

    <intermediateCatchEvent id="IntermediateCatchEvent2">
      <incoming>SequenceFlow12</incoming>
      <outgoing>SequenceFlow13</outgoing>
      <timerEventDefinition>
        <timeDate>2024-01-01T16:00:00</timeDate>
      </timerEventDefinition>
    </intermediateCatchEvent>

    <sequenceFlow id="SequenceFlow13" sourceRef="IntermediateCatchEvent2" targetRef="Task8"/>

    <task id="Task8" name="Send Message to Supervisor">
      <incoming>SequenceFlow13</incoming>
    </task>

    <endEvent id="EndEvent">
      <incoming>SequenceFlow11</incoming>
    </endEvent>

  </process>
</definitions>