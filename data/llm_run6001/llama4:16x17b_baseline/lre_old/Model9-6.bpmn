<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">

   <process id="DesignProcess" isExecutable="true">
     <startEvent id="StartEvent1">
       <outgoing>SequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow1" sourceRef="StartEvent1" targetRef="Task_LocateDistributeDesigns"/>

     <task id="Task_LocateDistributeDesigns" name="Locate and Distribute Designs">
       <incoming>SequenceFlow1</incoming>
       <outgoing>SequenceFlow2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow2" sourceRef="Task_LocateDistributeDesigns" targetRef="ParallelGateway_StartDesigns"/>

     <parallelGateway id="ParallelGateway_StartDesigns">
       <incoming>SequenceFlow2</incoming>
       <outgoing>SequenceFlow3</outgoing>
       <outgoing>SequenceFlow4</outgoing>
     </parallelGateway>

     <sequenceFlow id="SequenceFlow3" sourceRef="ParallelGateway_StartDesigns" targetRef="Task_ElectricalDesign"/>

     <task id="Task_ElectricalDesign" name="Develop Electrical Design">
       <incoming>SequenceFlow3</incoming>
       <outgoing>SequenceFlow5</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow5" sourceRef="Task_ElectricalDesign" targetRef="ExclusiveGateway_ElectricalTest"/>

     <exclusiveGateway id="ExclusiveGateway_ElectricalTest">
       <incoming>SequenceFlow5</incoming>
       <outgoing>SequenceFlow7</outgoing>
       <outgoing>SequenceFlow8</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow7" sourceRef="ExclusiveGateway_ElectricalTest" targetRef="Task_PhysicalDesign">
       <conditionExpression xsi:type="tFormalExpression">${electricalDesignPassed}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="SequenceFlow8" sourceRef="ExclusiveGateway_ElectricalTest" targetRef="Task_ElectricalDesign"/>

     <sequenceFlow id="SequenceFlow4" sourceRef="ParallelGateway_StartDesigns" targetRef="Task_PhysicalDesign"/>

     <task id="Task_PhysicalDesign" name="Develop Physical Design">
       <incoming>SequenceFlow4</incoming>
       <outgoing>SequenceFlow6</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow6" sourceRef="Task_PhysicalDesign" targetRef="ExclusiveGateway_PhysicalTest"/>

     <exclusiveGateway id="ExclusiveGateway_PhysicalTest">
       <incoming>SequenceFlow6</incoming>
       <outgoing>SequenceFlow9</outgoing>
       <outgoing>SequenceFlow10</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow9" sourceRef="ExclusiveGateway_PhysicalTest" targetRef="Task_ElectricalDesign">
       <conditionExpression xsi:type="tFormalExpression">${physicalDesignPassed}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="SequenceFlow10" sourceRef="ExclusiveGateway_PhysicalTest" targetRef="Task_PhysicalDesign"/>

     <parallelGateway id="ParallelGateway_CombineDesigns">
       <incoming>SequenceFlow7</incoming>
       <incoming>SequenceFlow9</incoming>
       <outgoing>SequenceFlow11</outgoing>
     </parallelGateway>

     <sequenceFlow id="SequenceFlow11" sourceRef="ParallelGateway_CombineDesigns" targetRef="Task_CombineTestDesigns"/>

     <task id="Task_CombineTestDesigns" name="Combine and Test Designs">
       <incoming>SequenceFlow11</incoming>
       <outgoing>SequenceFlow12</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow12" sourceRef="Task_CombineTestDesigns" targetRef="ExclusiveGateway_FinalTest"/>

     <exclusiveGateway id="ExclusiveGateway_FinalTest">
       <incoming>SequenceFlow12</incoming>
       <outgoing>SequenceFlow13</outgoing>
       <outgoing>SequenceFlow14</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow13" sourceRef="ExclusiveGateway_FinalTest" targetRef="EndEvent_DesignComplete">
       <conditionExpression xsi:type="tFormalExpression">${designPassedFinalTest}</conditionExpression>
     </sequenceFlow>

     <endEvent id="EndEvent_DesignComplete" name="Design Complete">
       <incoming>SequenceFlow13</incoming>
     </endEvent>

     <sequenceFlow id="SequenceFlow14" sourceRef="ExclusiveGateway_FinalTest" targetRef="ParallelGateway_StartDesigns"/>

   </process>

</definitions>