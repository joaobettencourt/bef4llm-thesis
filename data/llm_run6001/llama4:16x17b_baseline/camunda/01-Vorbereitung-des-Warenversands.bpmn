<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" name="Send Goods Process" targetNamespace="http://example.com/bpmn">

   <process id="sendGoodsProcess" isExecutable="true">
     <laneSet>
       <lane id="secretaryLane" name="Secretariat">
         <flowNodeRef>startEvent</flowNodeRef>
         <flowNodeRef>exclusiveGateway1</flowNodeRef>
         <flowNodeRef>taskGetOffers</flowNodeRef>
         <flowNodeRef>taskSelectLogisticCompany</flowNodeRef>
         <flowNodeRef>inclusiveGateway1</flowNodeRef>
         <flowNodeRef>taskWritePackageLabel</flowNodeRef>
       </lane>

       <lane id="logisticsLane" name="Logistics">
         <flowNodeRef>taskInsureParcel</flowNodeRef>
       </lane>

       <lane id="warehouseLane" name="Warehouse">
         <flowNodeRef>parallelGateway1</flowNodeRef>
         <flowNodeRef>taskPackageGoods</flowNodeRef>
         <flowNodeRef>exclusiveGateway2</flowNodeRef>
         <flowNodeRef>taskPrepareForPickingUpGoods</flowNodeRef>
         <flowNodeRef>endEvent</flowNodeRef>
       </lane>

     </laneSet>

     <startEvent id="startEvent" name="Send Goods">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <exclusiveGateway id="exclusiveGateway1" name="Special Handling?">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
       <outgoing>sequenceFlow3</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent" targetRef="exclusiveGateway1"/>

     <task id="taskGetOffers" name="Get 3 offers from logistic companies">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow4</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow2" sourceRef="exclusiveGateway1" targetRef="taskGetOffers"/>

     <task id="taskSelectLogisticCompany" name="Select logistic company and place order">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow5</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow4" sourceRef="taskGetOffers" targetRef="taskSelectLogisticCompany"/>

     <sequenceFlow id="sequenceFlow5" sourceRef="taskSelectLogisticCompany" targetRef="parallelGateway1"/>

     <parallelGateway id="parallelGateway1">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow6</outgoing>
       <outgoing>sequenceFlow7</outgoing>
     </parallelGateway>

     <task id="taskPackageGoods" name="Package goods">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow8</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow6" sourceRef="parallelGateway1" targetRef="taskPackageGoods"/>

     <exclusiveGateway id="exclusiveGateway2">
       <incoming>sequenceFlow8</incoming>
       <outgoing>sequenceFlow11</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow8" sourceRef="taskPackageGoods" targetRef="exclusiveGateway2"/>

     <task id="taskPrepareForPickingUpGoods" name="Prepare for picking up goods">
       <incoming>sequenceFlow11</incoming>
     </task>

     <sequenceFlow id="sequenceFlow11" sourceRef="exclusiveGateway2" targetRef="taskPrepareForPickingUpGoods"/>

     <endEvent id="endEvent" name="Shipment prepared">
       <incoming>sequenceFlow12</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow12" sourceRef="taskPrepareForPickingUpGoods" targetRef="endEvent"/>

     <inclusiveGateway id="inclusiveGateway1">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow9</outgoing>
     </inclusiveGateway>

     <sequenceFlow id="sequenceFlow3" sourceRef="exclusiveGateway1" targetRef="inclusiveGateway1"/>

     <task id="taskWritePackageLabel" name="Write package label">
       <incoming>sequenceFlow9</incoming>
       <outgoing>sequenceFlow10</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow9" sourceRef="inclusiveGateway1" targetRef="taskWritePackageLabel"/>

     <task id="taskInsureParcel" name="Insure parcel">
       <incoming>sequenceFlow10</incoming>
     </task>

     <sequenceFlow id="sequenceFlow10" sourceRef="taskWritePackageLabel" targetRef="taskInsureParcel"/>
   </process>
</definitions>