<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
                 id="definitions" name="Schufascoring-Process">

  <bpmn:process id="schufa-scoring-prozess" isExecutable="true">
    <bpmn:startEvent id="start-event-1">
      <bpmn:outgoing>sequence-flow-1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="scoring-anfrage-task" name="Scoringanfrage an Schufa senden">
      <bpmn:incoming>sequence-flow-1</bpmn:incoming>
      <bpmn:outgoing>sequence-flow-2</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="sequence-flow-1" sourceRef="start-event-1" targetRef="scoring-anfrage-task"/>

    <bpmn:exclusiveGateway id="verzögerung-gateway-1">
      <bpmn:incoming>sequence-flow-2</bpmn:incoming>
      <bpmn:outgoing>sequence-flow-3</bpmn:outgoing>
      <bpmn:outgoing>sequence-flow-4</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="sequence-flow-2" sourceRef="scoring-anfrage-task" targetRef="verzögerung-gateway-1"/>

    <bpmn:task id="scoring-ergebnis-level-1-task" name="Scoringergebnis Level 1 erhalten">
      <bpmn:incoming>sequence-flow-3</bpmn:incoming>
      <bpmn:outgoing>sequence-flow-5</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="sequence-flow-3" sourceRef="verzögerung-gateway-1" targetRef="scoring-ergebnis-level-1-task"/>

    <bpmn:serviceTask id="scoring-anfrage-level-2-task" name="Scoringanfrage Level 2 an Schufa senden">
      <bpmn:incoming>sequence-flow-4</bpmn:incoming>
      <bpmn:outgoing>sequence-flow-6</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="sequence-flow-4" sourceRef="verzögerung-gateway-1" targetRef="scoring-anfrage-level-2-task"/>

    <bpmn:task id="scoring-ergebnis-level-2-task" name="Scoringergebnis Level 2 erhalten">
      <bpmn:incoming>sequence-flow-6</bpmn:incoming>
      <bpmn:outgoing>sequence-flow-5</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="sequence-flow-5" sourceRef="scoring-ergebnis-level-1-task" targetRef="ende-prozess"/>

    <bpmn:sequenceFlow id="sequence-flow-6" sourceRef="scoring-anfrage-level-2-task" targetRef="scoring-ergebnis-level-2-task"/>

    <bpmn:endEvent id="ende-prozess">
      <bpmn:incoming>sequence-flow-5</bpmn:incoming>
      <bpmn:incoming>sequence-flow-7</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="sequence-flow-7" sourceRef="scoring-ergebnis-level-2-task" targetRef="ende-prozess"/>
  </bpmn:process>
</bpmn:definitions>