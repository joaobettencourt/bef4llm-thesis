<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definition" name="Data Validation Error Process" targetNamespace="http://example.com/bpmn">

   <process id="dataValidationErrorProcess" isExecutable="true">
     <startEvent id="errorNotificationStart" name="IS Notified about Data Validation Error">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <task id="checkForTyposTask" name="Drop-off Tech Checks for Typos">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
       <outgoing>sequenceFlow3</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow1" sourceRef="errorNotificationStart" targetRef="checkForTyposTask"/>

     <exclusiveGateway id="typoCheckResultGateway" name="Typo Check Result">
       <incoming>sequenceFlow2</incoming>
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow4</outgoing>
       <outgoing>sequenceFlow5</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow2" sourceRef="checkForTyposTask" targetRef="typoCheckResultGateway">
       <conditionExpression xsi:type="tFormalExpression">${noTypo}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="sequenceFlow3" sourceRef="checkForTyposTask" targetRef="typoCheckResultGateway">
       <conditionExpression xsi:type="tFormalExpression">${typoFound}</conditionExpression>
     </sequenceFlow>

     <task id="customerCorrectionTask" name="Customer Correction Possible">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow6</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow4" sourceRef="typoCheckResultGateway" targetRef="customerCorrectionTask"/>

     <exclusiveGateway id="correctionResultGateway" name="Correction Result">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow7</outgoing>
       <outgoing>sequenceFlow8</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow6" sourceRef="customerCorrectionTask" targetRef="correctionResultGateway">
       <conditionExpression xsi:type="tFormalExpression">${correctionPossible}</conditionExpression>
     </sequenceFlow>

     <task id="publicSourceSearchTask" name="Public Source Search for Solutions">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow9</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow5" sourceRef="typoCheckResultGateway" targetRef="publicSourceSearchTask"/>

     <endEvent id="issueResolvedEnd" name="Issue Resolved">
       <incoming>sequenceFlow7</incoming>
       <incoming>sequenceFlow8</incoming>
       <incoming>sequenceFlow9</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow7" sourceRef="correctionResultGateway" targetRef="issueResolvedEnd">
       <conditionExpression xsi:type="tFormalExpression">${correctionSuccessful}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="sequenceFlow8" sourceRef="customerCorrectionTask" targetRef="issueResolvedEnd"/>

     <sequenceFlow id="sequenceFlow9" sourceRef="publicSourceSearchTask" targetRef="issueResolvedEnd"/>
   </process>
</definitions>