<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definitions" name="Invoice Process" targetNamespace="http://example.com">

   <process id="invoiceProcess" isExecutable="true">
     <startEvent id="startEvent1">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <task id="locateVendor" name="Locate Vendor in SAP">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
       <outgoing>sequenceFlow3</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="locateVendor"/>
     <sequenceFlow id="sequenceFlow2" name="found" sourceRef="locateVendor" targetRef="addSapNumberToInvoice"/>
     <sequenceFlow id="sequenceFlow3" name="not found" sourceRef="locateVendor" targetRef="fillNewVendorMasterRecordForm"/>

     <subProcess id="newVendorRecord">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow9</outgoing>
       <startEvent id="startSubprocess">
         <outgoing>sequenceFlow7</outgoing>
       </startEvent>

       <task id="fillNewVendorMasterRecordForm" name="Fill New Vendor Master Record Form">
         <incoming>sequenceFlow7</incoming>
         <outgoing>sequenceFlow8</outgoing>
       </task>

       <sequenceFlow id="sequenceFlow7" sourceRef="startSubprocess" targetRef="fillNewVendorMasterRecordForm"/>
       <task id="attachRequestToInvoice1" name="Attach Request to Invoice">
         <incoming>sequenceFlow8</incoming>
         <outgoing>sequenceFlow10</outgoing>
       </task>

       <sequenceFlow id="sequenceFlow8" sourceRef="fillNewVendorMasterRecordForm" targetRef="attachRequestToInvoice1"/>
       <task id="putInInternalOutbox1" name="Put in Internal Outbox for New Vendors">
         <incoming>sequenceFlow10</incoming>
         <outgoing>sequenceFlow11</outgoing>
       </task>

       <sequenceFlow id="sequenceFlow10" sourceRef="attachRequestToInvoice1" targetRef="putInInternalOutbox1"/>
       <exclusiveGateway id="classifyInvoice">
         <incoming>sequenceFlow11</incoming>
         <outgoing>sequenceFlow12</outgoing>
         <outgoing>sequenceFlow13</outgoing>
       </exclusiveGateway>

       <sequenceFlow id="sequenceFlow11" sourceRef="putInInternalOutbox1" targetRef="classifyInvoice"/>
       <task id="urgentRequest" name="Urgent Request">
         <incoming>sequenceFlow12</incoming>
         <outgoing>sequenceFlow14</outgoing>
       </task>

       <sequenceFlow id="sequenceFlow12" sourceRef="classifyInvoice" targetRef="urgentRequest"/>
       <endEvent id="requestFinished">
         <incoming>sequenceFlow14</incoming>
       </endEvent>

       <sequenceFlow id="sequenceFlow14" sourceRef="urgentRequest" targetRef="requestFinished"/>

       <task id="nonUrgentRequest" name="Non-Urgent Request">
         <incoming>sequenceFlow13</incoming>
         <outgoing>sequenceFlow15</outgoing>
       </task>

       <sequenceFlow id="sequenceFlow13" sourceRef="classifyInvoice" targetRef="nonUrgentRequest"/>
       <endEvent id="requestFinishedNonUrgent">
         <incoming>sequenceFlow15</incoming>
       </endEvent>

       <sequenceFlow id="sequenceFlow15" sourceRef="nonUrgentRequest" targetRef="requestFinishedNonUrgent"/>

     </subProcess>

     <task id="addSapNumberToInvoice" name="Add SAP Number to Invoice">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow16</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow9" sourceRef="newVendorRecord" targetRef="addSapNumberToInvoice"/>
     <task id="sortInvoices" name="Sort Invoices">
       <incoming>sequenceFlow16</incoming>
       <outgoing>sequenceFlow17</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow16" sourceRef="addSapNumberToInvoice" targetRef="sortInvoices"/>
     <task id="enterInSapSystem" name="Enter Invoices in SAP System">
       <incoming>sequenceFlow17</incoming>
       <outgoing>sequenceFlow18</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow17" sourceRef="sortInvoices" targetRef="enterInSapSystem"/>
     <endEvent id="invoiceProcessed">
       <incoming>sequenceFlow18</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow18" sourceRef="enterInSapSystem" targetRef="invoiceProcessed"/>

   </process>
 </definitions>