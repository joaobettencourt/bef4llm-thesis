<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definition" name="Purchase Order to Delivery Process">

  <process id="purchaseOrderProcess" isExecutable="true">
    <startEvent id="startEvent1" name="Financial Department Start">
      <outgoing>sequenceFlow1</outgoing>
    </startEvent>

    <task id="checkInvoiceTask" name="Check Purchase Invoice">
      <incoming>sequenceFlow1</incoming>
      <outgoing>sequenceFlow2</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="checkInvoiceTask"/>

    <task id="registerInvoiceTask" name="Register Invoice in SAPERION">
      <incoming>sequenceFlow2</incoming>
      <outgoing>sequenceFlow3</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow2" sourceRef="checkInvoiceTask" targetRef="registerInvoiceTask"/>

    <exclusiveGateway id="exclusiveGateway1" name="Check Invoice Amount">
      <incoming>sequenceFlow3</incoming>
      <outgoing>sequenceFlow4</outgoing>
      <outgoing>sequenceFlow5</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequenceFlow3" sourceRef="registerInvoiceTask" targetRef="exclusiveGateway1"/>

    <task id="departmentHeadApprovalTask" name="Department Head Approval">
      <incoming>sequenceFlow4</incoming>
      <outgoing>sequenceFlow6</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow4" sourceRef="exclusiveGateway1" targetRef="departmentHeadApprovalTask">
      <conditionExpression xsi:type="tFormalExpression">${amount > 500}</conditionExpression>
    </sequenceFlow>

    <task id="erpPaymentTriggerTask" name="ERP Payment Trigger">
      <incoming>sequenceFlow5</incoming>
      <incoming>sequenceFlow6</incoming>
      <outgoing>sequenceFlow7</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow5" sourceRef="exclusiveGateway1" targetRef="erpPaymentTriggerTask">
      <conditionExpression xsi:type="tFormalExpression">${amount <= 500}</conditionExpression>
    </sequenceFlow>

    <endEvent id="endEvent1" name="ERP Payment End">
      <incoming>sequenceFlow7</incoming>
    </endEvent>

    <sequenceFlow id="sequenceFlow6" sourceRef="departmentHeadApprovalTask" targetRef="erpPaymentTriggerTask"/>
    <sequenceFlow id="sequenceFlow7" sourceRef="erpPaymentTriggerTask" targetRef="endEvent1"/>
  </process>
</definitions>