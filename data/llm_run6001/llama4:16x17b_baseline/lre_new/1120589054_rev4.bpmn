<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definitions" name="Order to Cash Process" targetNamespace="http://example.com/orderToCash">

   <process id="orderToCashProcess" isExecutable="true">
     <startEvent id="customerOrderReceived" name="Customer Order Received">
       <outgoing>sf1</outgoing>
     </startEvent>

     <task id="processOrderTask" name="Process Order">
       <incoming>sf1</incoming>
       <outgoing>sf2</outgoing>
     </task>

     <sequenceFlow id="sf1" sourceRef="customerOrderReceived" targetRef="processOrderTask"/>

     <task id="sendToWarehouseTask" name="Send to Warehouse">
       <incoming>sf2</incoming>
       <outgoing>sf3</outgoing>
     </task>

     <sequenceFlow id="sf2" sourceRef="processOrderTask" targetRef="sendToWarehouseTask"/>
     <sequenceFlow id="sf3" sourceRef="sendToWarehouseTask" targetRef="determinePartsRequiredTask"/>

     <task id="determinePartsRequiredTask" name="Determine Parts Required">
       <incoming>sf3</incoming>
       <outgoing>sf4</outgoing>
       <outgoing>sf9</outgoing>
     </task>

     <exclusiveGateway id="partsAvailabilityCheckGw" name="Parts Availability Check">
       <incoming>sf4</incoming>
       <outgoing>sf5</outgoing>
       <outgoing>sf8</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sf4" sourceRef="determinePartsRequiredTask" targetRef="partsAvailabilityCheckGw"/>

     <task id="orderPartsTask" name="Order Parts">
       <incoming>sf8</incoming>
       <outgoing>sf7</outgoing>
     </task>

     <sequenceFlow id="sf8" sourceRef="partsAvailabilityCheckGw" targetRef="orderPartsTask"/>
     <sequenceFlow id="sf7" sourceRef="orderPartsTask" targetRef="waitForPartsToArriveTask"/>

     <task id="waitForPartsToArriveTask" name="Wait for Parts to Arrive">
       <incoming>sf7</incoming>
       <outgoing>sf6</outgoing>
     </task>

     <sequenceFlow id="sf6" sourceRef="waitForPartsToArriveTask" targetRef="partsAvailabilityCheckGw"/>

     <sequenceFlow id="sf5" sourceRef="partsAvailabilityCheckGw" targetRef="startProductionTask">
       <conditionExpression xsi:type="tFormalExpression">${partsAvailable  == true}</conditionExpression>
     </sequenceFlow>

     <task id="startProductionTask" name="Start Production">
       <incoming>sf5</incoming>
       <outgoing>sf10</outgoing>
     </task>

     <sequenceFlow id="sf10" sourceRef="startProductionTask" targetRef="performQualityChecksTask"/>

     <task id="performQualityChecksTask" name="Perform Quality Checks">
       <incoming>sf10</incoming>
       <outgoing>sf11</outgoing>
     </task>

     <sequenceFlow id="sf11" sourceRef="performQualityChecksTask" targetRef="packageAndLabelTask"/>

     <task id="packageAndLabelTask" name="Package and Label">
       <incoming>sf11</incoming>
       <outgoing>sf12</outgoing>
     </task>

     <sequenceFlow id="sf12" sourceRef="packageAndLabelTask" targetRef="informSalesTask"/>

     <task id="informSalesTask" name="Inform Sales">
       <incoming>sf12</incoming>
       <outgoing>sf13</outgoing>
     </task>

     <endEvent id="productionCompletedEvt" name="Production Completed">
       <incoming>sf13</incoming>
     </endEvent>

     <sequenceFlow id="sf13" sourceRef="informSalesTask" targetRef="productionCompletedEvt"/>
   </process>
 </definitions>