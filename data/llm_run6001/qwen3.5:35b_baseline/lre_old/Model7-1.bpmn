<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_LeadProcess">
  <bpmn:collaboration id="Collab_LeadManagement">
    <bpmn:participant id="Participant_SalesDept" name="Sales Department" processRef="Proc_LeadMgmt"/>
  </bpmn:collaboration>

  <bpmn:process id="Proc_LeadMgmt" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Manager" name="Manager">
        <bpmn:flowNodeRef>StartEvent_Leads</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckOpenLeads</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectTopFive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyAssistant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ProcessLead_Task</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_SalesAssistant" name="Sales Assistant">
        <bpmn:flowNodeRef>Task_CallCustomer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Interested?</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendNote</bpmn:flowNodeRef>
      </bpmn:lane>

       <bpmn:lane id="Lane_Admin" name="Administration">
         <bpmn:flowNodeRef>EndEvent_Processed</bpmn:flowNodeRef>
       </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_Leads" name="New Leads Available">
      <bpmn:outgoing>SequenceFlow_Check</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_CheckOpenLeads" name="Check Open Leads">
      <bpmn:incoming>SequenceFlow_Check</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Select</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_SelectTopFive" name="Select Top Five Leads">
      <bpmn:incoming>SequenceFlow_Select</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Notify</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_NotifyAssistant" name="Notify Sales Assistant">
      <bpmn:incoming>SequenceFlow_Notify</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CallStart</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_CallCustomer" name="Call Customer">
      <bpmn:incoming>SequenceFlow_CallStart</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_CallNextPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InterestCheck</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_Interested?" name="Customer Interested?">
      <bpmn:incoming>SequenceFlow_InterestCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendNotePath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CallNextPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="EndEvent_Processed" name="Process Lead Completed">
       <bpmn:incoming>SequenceFlow_EndProc</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_Check" sourceRef="StartEvent_Leads" targetRef="Task_CheckOpenLeads"/>
    <bpmn:sequenceFlow id="SequenceFlow_Select" name="Select Top Five" sourceRef="Task_CheckOpenLeads" targetRef="Task_SelectTopFive"/>
    <bpmn:sequenceFlow id="SequenceFlow_Notify" name="Tell Assistant to Call" sourceRef="Task_SelectTopFive" targetRef="Task_NotifyAssistant"/>
    
    <!-- Crossing Lane Boundary -->
    <bpmn:sequenceFlow id="SequenceFlow_CallStart" sourceRef="Task_NotifyAssistant" targetRef="Task_CallCustomer"/>

    <bpmn:sequenceFlow id="SequenceFlow_InterestCheck" name="Call Result" sourceRef="Task_CallCustomer" targetRef="Gateway_Interested?"/>
    
    <!-- Interest Path -->
    <bpmn:sequenceFlow id="SequenceFlow_SendNotePath" name="Yes - Interested" sourceRef="Gateway_Interested?" targetRef="Task_SendNote"/>

    <!-- Loop Back Path (Not Interested) -->
    <bpmn:sequenceFlow id="SequenceFlow_CallNextPath" name="No - Not Interested" sourceRef="Gateway_Interested?" targetRef="Task_CallCustomer"/>

     <!-- Send Note Task (Assistant) -->
    <bpmn:task id="Task_SendNote" name="Send Note to Manager">
      <bpmn:incoming>SequenceFlow_SendNotePath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProcessLeadStart</bpmn:outgoing>
    </bpmn:task>

     <!-- Process Lead Task (Manager) -->
    <bpmn:task id="ProcessLead_Task" name="Process Lead">
       <bpmn:incoming>SequenceFlow_SendNotePath</bpmn:incoming> 
       Wait, I need to connect Send Note -> Process Lead.
       SequenceFlow_ProcessLeadStart connects Task_SendNote -> ProcessLead_Task? Or just use the ID of the flow connecting them.
    </bpmn:task>

     <!-- End Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_EndProc" sourceRef="ProcessLead_Task" targetRef="EndEvent_Processed"/>

  </bpmn:process>
</bpmn:definitions>