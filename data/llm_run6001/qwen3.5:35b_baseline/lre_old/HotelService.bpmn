<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_RoomServiceProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_RoomService">
    <bpmn:participant id="Participant_HotelSystem" name="The Evanstonian - Room Service Process" processRef="Process_RoomService"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_RoomService" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Manager" name="Room-Service Manager">
        <bpmn:flowNodeRef>StartEvent_GuestCall</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TakeOrder</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Kitchen" name="Kitchen Staff">
        <bpmn:flowNodeRef>ParallelGateway_FoodSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareFood</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Sommelier" name="Sommelier (Wine Waiter)">
        <bpmn:flowNodeRef>ExclusiveGateway_AlcoholRequired?</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FetchAlcoholicBeverages</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Waiter" name="Waiter">
        <bpmn:flowNodeRef>ParallelGateway_Split1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReadiesCart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareNonAlcoholicDrinks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_Merge1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_DeliveryReady?</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DeliverToGuestRoom</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_Split2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReturnToStation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_BillingPending?</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DebitGuestAccount</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_GuestCall" name="Guest Calls Room Service">
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Manager takes order -->
    <bpmn:task id="Task_TakeOrder" name="Take Down Order &amp; Submit Ticket">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Decision about alcohol -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_AlcoholRequired?" name="Alcoholic Beverage Required?">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToKitchen</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Parallel Gateway for Kitchen and Sommelier -->
    <bpmn:parallelGateway id="ParallelGateway_FoodSplit">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_ToKitchen</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3a</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 2: Kitchen prepares food -->
    <bpmn:task id="Task_PrepareFood" name="Prepare Food">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_3a</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FoodReady</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3: Sommelier fetches wine -->
    <bpmn:task id="Task_FetchAlcoholicBeverages" name="Fetch Wine &amp; Prepare Alcoholic Beverages">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_SommelierPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WineReady</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow 1 -->
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_GuestCall" targetRef="Task_TakeOrder"/>

    <!-- Sequence Flow 2 to Gateway -->
    <bpmn:sequenceFlow id="SequenceFlow_2" name="Submit Order Ticket" sourceRef="Task_TakeOrder" targetRef="ExclusiveGateway_AlcoholRequired?"/>

    <!-- To Kitchen (always) -->
    <bpmn:sequenceFlow id="SequenceFlow_ToKitchen" name="Always - Food Preparation" sourceRef="ExclusiveGateway_AlcoholRequired?" targetRef="ParallelGateway_FoodSplit"/>

    <!-- From Parallel Gateway to Task 2 -->
    <bpmn:sequenceFlow id="SequenceFlow_3a" sourceRef="ParallelGateway_FoodSplit" targetRef="Task_PrepareFood"/>

    <!-- To Sommelier (80% of orders) - from Manager lane directly -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_AlcoholRequiredWaiter">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_WaiterCartPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DeliveryDecisionPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Waiter Tasks -->
    <bpmn:task id="Task_ReadiesCart" name="Readies Cart (Tablecloth &amp; Silverware)">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_WaiterCartPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CartReady</bpmn:outgoing>
    </bpmn:task>

    <!-- Waiter prepares non-alcoholic drinks -->
    <bpmn:task id="Task_PrepareNonAlcoholicDrinks" name="Prepare Non-Alcoholic Drinks">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_WaiterCartPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NonAlcReady</bpmn:outgoing>
    </bpmn:task>

    <!-- Waiter Parallel Split -->
    <bpmn:parallelGateway id="ParallelGateway_Split1" name="">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_FoodReady</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaiterCartPath</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Waiter Parallel Merge before delivery decision -->
    <bpmn:parallelGateway id="ParallelGateway_Merge1">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_CartReady</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DeliveryDecisionPath</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Waiter Parallel Merge before delivery decision -->
    <bpmn:sequenceFlow id="SequenceFlow_WaiterCartPath" sourceRef="ParallelGateway_Split1" targetRef="Task_ReadiesCart"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_CartReady" name="" sourceRef="Task_ReadiesCart" targetRef="ExclusiveGateway_DeliveryReady?">
      <bpmn:name></bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Waiter Parallel Split for Cart and Non-Alcoholic Drinks -->
    <bpmn:parallelGateway id="ParallelGateway_WaiterTasks" name="">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_CartReady</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NonAlcPath</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Sequence Flow to Non-Alcoholic Drinks -->
    <bpmn:sequenceFlow id="SequenceFlow_NonAlcPath" sourceRef="ParallelGateway_WaiterTasks" targetRef="Task_PrepareNonAlcoholicDrinks"/>

    <!-- Waiter Parallel Merge before delivery decision -->
    <bpmn:parallelGateway id="ParallelGateway_Merge2">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_NonAlcReady</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DeliveryDecisionPath</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Waiter Parallel Merge before delivery decision -->
    <bpmn:sequenceFlow id="SequenceFlow_NonAlcReady" name="" sourceRef="Task_PrepareNonAlcoholicDrinks" targetRef="ParallelGateway_Merge2">
      <bpmn:name></bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Waiter Parallel Merge before delivery decision -->
    <bpmn:parallelGateway id="ExclusiveGateway_DeliveryReady?" name="">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_FoodReady</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaiterCartPath</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Waiter Parallel Merge before delivery decision -->
    <bpmn:sequenceFlow id="SequenceFlow_DeliveryDecisionPath" name="" sourceRef="ParallelGateway_Merge2" targetRef="ExclusiveGateway_DeliveryReady?">
      <bpmn:name></bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Waiter Parallel Merge before delivery decision -->
    <bpmn:parallelGateway id="ParallelGateway_WaiterMerge" name="">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_CartReady</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NonAlcPath</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Waiter Parallel Merge before delivery decision -->
    <bpmn:sequenceFlow id="SequenceFlow_WaiterCartPath2" sourceRef="ParallelGateway_Split1" targetRef="Task_ReadiesCart"/>

    <!-- Decision Gateway for Delivery Readiness (all items ready) -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_DeliveryReadyFinal?" name="">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_FoodReady</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaiterCartPath3</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Waiter Delivers to Guest Room -->
    <bpmn:task id="Task_DeliverToGuestRoom" name="Deliver Order to Guest's Room">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_AllReady</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ReturnPath</bpmn:outgoing>
    </bpmn:task>

    <!-- Waiter Returns to Station -->
    <bpmn:parallelGateway id="ParallelGateway_Split2" name="">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_ReturnPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BillingDecision</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Waiter Returns to Station -->
    <bpmn:task id="Task_ReturnToStation" name="Return to Room-Service Station">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_AllReady</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ReturnPath2</bpmn:outgoing>
    </bpmn:task>

    <!-- Decision Gateway for Billing (can wait if another order pending) -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_BillingPending?" name="">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_ReturnPath2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DebitNow</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 4: Debit Guest Account -->
    <bpmn:endEvent id="EndEvent_OrderComplete" name="Order Process Complete">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_DebitNow</bpmn:outgoing>
    </bpmn:endEvent>

    <!-- Task 5: Debit Guest Account -->
    <bpmn:task id="Task_DebitGuestAccount" name="Debit Guest's Account">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_ReturnPath2</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_BillingDecisionFinal</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow to Waiter -->
    <bpmn:sequenceFlow id="SequenceFlow_AllReady" name="" sourceRef="ExclusiveGateway_DeliveryReady?" targetRef="Task_DeliverToGuestRoom">
      <bpmn:name>All Items Ready</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Sequence Flow to Waiter -->
    <bpmn:sequenceFlow id="SequenceFlow_ReturnPath" name="" sourceRef="Task_DeliverToGuestRoom" targetRef="ParallelGateway_Split2">
      <bpmn:name></bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Sequence Flow to Waiter -->
    <bpmn:sequenceFlow id="SequenceFlow_BillingDecision" name="" sourceRef="ExclusiveGateway_DeliveryReady?" targetRef="Task_ReturnToStation">
      <bpmn:name></bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Sequence Flow to Waiter -->
    <bpmn:sequenceFlow id="SequenceFlow_WaitBilling" name="" sourceRef="ExclusiveGateway_BillingPending?" targetRef="Task_DebitGuestAccount">
      <bpmn:name>No, Debit Now</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>