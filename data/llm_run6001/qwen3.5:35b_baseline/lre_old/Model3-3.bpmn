<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ClaimHandling" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="Participant_MainProcess" name="Claims Handling Process" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_ClaimsOfficer" name="Claims Officer">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExamineClaim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WriteRecommendation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Proceeds</bpmn:flowNodeRef>
      </bpmn:lane>
      
      <bpmn:lane id="Lane_SeniorOfficer" name="Senior Claims Officer">
        <bpmn:flowNodeRef>Task_CheckRecommendation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Decision</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Claim Registered">
      <bpmn:outgoing>SequenceFlow_Examine</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Examine Claim -->
    <bpmn:task id="Task_ExamineClaim" name="Examine Claim">
      <bpmn:incoming>SequenceFlow_Examine</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WriteRec</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: Write Recommendation -->
    <bpmn:task id="Task_WriteRecommendation" name="Write Settlement Recommendation">
      <bpmn:incoming>SequenceFlow_WriteRec</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_LoopBack</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckRec</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3: Check Recommendation -->
    <bpmn:task id="Task_CheckRecommendation" name="Check Recommendation">
      <bpmn:incoming>SequenceFlow_CheckRec</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DecisionIn</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Decision -->
    <bpmn:exclusiveGateway id="Gateway_Decision" name="Is Claim OK?">
      <bpmn:incoming>SequenceFlow_DecisionIn</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OKPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NotOKPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Proceeds" name="Process Proceeds">
      <bpmn:incoming>SequenceFlow_OKPath</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_Examine" sourceRef="StartEvent_1" targetRef="Task_ExamineClaim"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_WriteRec" name="Write Rec" sourceRef="Task_ExamineClaim" targetRef="Task_WriteRecommendation"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_CheckRec" name="Submit for Check" sourceRef="Task_WriteRecommendation" targetRef="Task_CheckRecommendation"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_DecisionIn" name="Check Complete" sourceRef="Task_CheckRecommendation" targetRef="Gateway_Decision"/>
    
    <!-- OK Path -->
    <bpmn:sequenceFlow id="SequenceFlow_OKPath" name="OK" sourceRef="Gateway_Decision" targetRef="EndEvent_Proceeds"/>
    
    <!-- Not OK Loop Back -->
    <bpmn:sequenceFlow id="SequenceFlow_NotOKPath" name="Not OK" sourceRef="Gateway_Decision" targetRef="Task_WriteRecommendation"/>

  </bpmn:process>
</bpmn:definitions>