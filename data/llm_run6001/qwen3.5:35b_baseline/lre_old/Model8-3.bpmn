<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_RecruitmentProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_Recruitment">
    <bpmn:participant id="Pool_Requester" name="Requesting Department" processRef="Proc_Requester"/>
    <bpmn:participant id="Pool_HRDept" name="HR Personnel Dept" processRef="Proc_HRDepartment"/>
  </bpmn:collaboration>

  <!-- Requester Process -->
  <bpmn:process id="Proc_Requester">
    <bpmn:startEvent id="Start_Req_DetectRequirements" name="Detect Personnel Requirements">
      <bpmn:outgoing>SeqFlow_Start_Report</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_Requester_ReportVacancy" name="Report Vacancy to HR Dept">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SeqFlow_Start_Report</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_Send_VacancyMsg</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="End_Req_AdvertiseJob" name="Advertise Job">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SeqFlow_End_Approve</bpmn:outgoing>
    </bpmn:endEvent>

    <!-- Wait for JD -->
    <bpmn:startEvent id="Start_Req_WaitJD" name="Wait for Job Description">
        <bpmn:messageRef>Msg_JDDelivered</bpmn:messageRef>
      <bpmn:outgoing>SeqFlow_Start_Review</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Wait for Correction Response (Loop) -->
     <bpmn:endEvent id="End_Req_CorrectionSent" name="Correction Sent">
      <bpmn:name></bpmn:name>
       <bpmn:incoming>SeqFlow_Send_Corr</bpmn:outgoing>
    </bpmn:endEvent>

     <!-- Wait for Clarification Response -->
    <bpmn:startEvent id="Start_Req_WaitClarify" name="Wait for HR Questions">
        <bpmn:messageRef>Msg_ClariRequest</bpmn:messageRef>
      <bpmn:outgoing>SeqFlow_Start_Available</bpmn:outgoing>
    </bpmn:startEvent>

     <!-- Wait for Correction Response (Loop) -->
    <bpmn:endEvent id="End_Req_WaitCorrection" name="Wait for Corrected JD">
      <bpmn:name></bpmn:name>
       <bpmn:incoming>SeqFlow_Start_Corr</bpmn:outgoing>
    </bpmn:endEvent>

     <!-- Wait for Clarification Response -->
    <bpmn:userTask id="Task_Requester_Available" name="Available for Clarifications">
      <bpmn:name></bpmn:name>
       <bpmn:incoming>SeqFlow_Start_Available</bpmn:outgoing>
        <bpmn:outgoing>SeqFlow_Send_ClarifyResp</bpmn:outgoing>
    </bpmn:userTask>

     <!-- Wait for JD -->
    <bpmn:startEvent id="Start_Req_WaitJD" name="Wait for Job Description">
        <bpmn:messageRef>Msg_JDDelivered</bpmn:messageRef>
      <bpmn:outgoing>SeqFlow_Start_Review</bpmn:outgoing>
    </bpmn:startEvent>

     <!-- Wait for JD -->
    <bpmn:userTask id="UserTask_Requester_ReviewJD" name="Review Job Description">
       <bpmn:name></bpmn:name>
      <bpmn:incoming>SeqFlow_Start_Review</bpmn:outgoing>
        <bpmn:outgoing>Xor_CorrNeeded</bpmn:outgoing>
    </bpmn:userTask>

     <!-- Wait for JD -->
    <bpmn:endEvent id="End_Req_WaitJD" name="Wait for Job Description">
      <bpmn:name></bpmn:name>
       <bpmn:incoming>Xor_CorrLoop</bpmn:outgoing>
    </bpmn:endEvent>

     <!-- Wait for JD -->
    <bpmn:startEvent id="Start_Req_WaitJD" name="Wait for Job Description">
        <bpmn:messageRef>Msg_JDDelivered</bpmn:messageRef>
      <bpmn:outgoing>SeqFlow_Start_Review</bpmn:outgoing>
    </bpmn:startEvent>

     <!-- Wait for JD -->
