<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_DesignProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_DesignProcess">
    <bpmn:participant id="Participant_MainSystem" name="Design Development Process" processRef="Process_DesignProc"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_DesignProc" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_ElectricalDept" name="Electrical Design Department">
        <bpmn:flowNodeRef>StartEvent_Process</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LocateDistributeDesigns</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_ElectricalReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_ElectricalTestResult</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_PhysicalDept" name="Physical Design Department">
        <bpmn:flowNodeRef>InclusiveGateway_PhysicalReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_PhysicalTestResult</bpmn:flowNodeRef>
      </bpmn:lane>

      <!-- Integration Lane -->
      <bpmn:lane id="Lane_Integration" name="Integration &amp; Testing">
        <bpmn:flowNodeRef>InclusiveGateway_DesignComplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_CombinedTestResult</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Process" name="Process Starts">
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Locate and distribute designs (shared) -->
    <bpmn:task id="Task_LocateDistributeDesigns" name="Locate &amp; Distribute Existing Designs">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SplitParallel</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway for starting both designs -->
    <bpmn:parallelGateway id="ParallelGateway_StartDesigns">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_SplitParallel</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ElectricalStart</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PhysicalStart</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Electrical Design Lane Tasks -->
    <bpmn:task id="Task_ElectricalReview" name="Review Existing Designs">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_ElectricalStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CreateElectricalPlan</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_ElectricalCreateUpdate" name="Create Update Plan">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_CreateElectricalPlan</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ElectricalReviseDesign</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_ElectricalRevised" name="Create Revised Electrical Design">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_ElectricalReviseDesign</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ElectricalTest</bpmn:outgoing>
    </bpmn:task>

    <!-- Physical Design Lane Tasks -->
    <bpmn:task id="Task_PhysicalReview" name="Review Existing Designs">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_PhysicalStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CreatePhysicalPlan</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_PhysicalCreateUpdate" name="Create Update Plan">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_CreatePhysicalPlan</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PhysicalReviseDesign</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_PhysicalRevised" name="Create Revised Physical Design">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_PhysicalReviseDesign</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PhysicalTest</bpmn:outgoing>
    </bpmn:task>

    <!-- Test Gateways -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_ElectricalTestResult" name="Electrical Design Passes?">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_ElectricalTest</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ElectricalPass</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ElectricalFail</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:exclusiveGateway id="ExclusiveGateway_PhysicalTestResult" name="Physical Design Passes?">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_PhysicalTest</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PhysicalPass</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PhysicalFail</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Integration Gateway -->
    <bpmn:parallelGateway id="ParallelGateway_Integration">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_ElectricalPass</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_PhysicalPass</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CombineDesigns</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Combined Design Task -->
    <bpmn:task id="Task_CombinedTest" name="Combine &amp; Test Designs">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_CombineDesigns</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CombinedResult</bpmn:outgoing>
    </bpmn:task>

    <!-- Final Test Gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_CombinedTestResult" name="Combined Design Passes?">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_CombinedResult</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CombinedPass</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CombinedFail</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_SendToManufacturing" name="Send to Manufacturing Process">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_CombinedPass</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Loop Back Gateway -->
    <bpmn:parallelGateway id="ParallelGateway_Restart">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_CombinedFail</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ElectricalRestartLoop</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PhysicalRestartLoop</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_Process" targetRef="Task_LocateDistributeDesigns"/>
    <bpmn:sequenceFlow id="SequenceFlow_SplitParallel" name="" sourceRef="Task_LocateDistributeDesigns" targetRef="ParallelGateway_StartDesigns"/>

    <!-- Electrical Path -->
    <bpmn:sequenceFlow id="SequenceFlow_ElectricalStart" sourceRef="ParallelGateway_StartDesigns" targetRef="Task_ElectricalReview"/>
    <bpmn:sequenceFlow id="SequenceFlow_CreateElectricalPlan" name="" sourceRef="Task_ElectricalReview" targetRef="Task_ElectricalCreateUpdate"/>
    <bpmn:sequenceFlow id="SequenceFlow_ElectricalReviseDesign" name="" sourceRef="Task_ElectricalCreateUpdate" targetRef="Task_ElectricalRevised"/>
    <bpmn:sequenceFlow id="SequenceFlow_ElectricalTest" name="" sourceRef="Task_ElectricalRevised" targetRef="ExclusiveGateway_ElectricalTestResult"/>

    <!-- Physical Path -->
    <bpmn:sequenceFlow id="SequenceFlow_PhysicalStart" sourceRef="ParallelGateway_StartDesigns" targetRef="Task_PhysicalReview"/>
    <bpmn:sequenceFlow id="SequenceFlow_CreatePhysicalPlan" name="" sourceRef="Task_PhysicalReview" targetRef="Task_PhysicalCreateUpdate"/>
    <bpmn:sequenceFlow id="SequenceFlow_PhysicalReviseDesign" name="" sourceRef="Task_PhysicalCreateUpdate" targetRef="Task_PhysicalRevised"/>
    <bpmn:sequenceFlow id="SequenceFlow_PhysicalTest" name="" sourceRef="Task_PhysicalRevised" targetRef="ExclusiveGateway_PhysicalTestResult"/>

    <!-- Test Results -->
    <bpmn:sequenceFlow id="SequenceFlow_ElectricalPass" name="Yes - Passes" sourceRef="ExclusiveGateway_ElectricalTestResult" targetRef="ParallelGateway_Integration"/>
    <bpmn:sequenceFlow id="SequenceFlow_ElectricalFail" name="No - Fails" sourceRef="ExclusiveGateway_ElectricalTestResult" targetRef="Task_ElectricalReview"/>

    <bpmn:sequenceFlow id="SequenceFlow_PhysicalPass" name="Yes - Passes" sourceRef="ExclusiveGateway_PhysicalTestResult" targetRef="ParallelGateway_Integration"/>
    <bpmn:sequenceFlow id="SequenceFlow_PhysicalFail" name="No - Fails" sourceRef="ExclusiveGateway_PhysicalTestResult" targetRef="Task_PhysicalReview"/>

    <!-- Integration Path -->
    <bpmn:sequenceFlow id="SequenceFlow_CombineDesigns" name="" sourceRef="ParallelGateway_Integration" targetRef="Task_CombinedTest"/>
    <bpmn:sequenceFlow id="SequenceFlow_CombinedResult" name="" sourceRef="Task_CombinedTest" targetRef="ExclusiveGateway_CombinedTestResult"/>

    <!-- Final Results -->
    <bpmn:sequenceFlow id="SequenceFlow_CombinedPass" name="Yes - Passes" sourceRef="ExclusiveGateway_CombinedTestResult" targetRef="EndEvent_SendToManufacturing"/>
    <bpmn:sequenceFlow id="SequenceFlow_CombinedFail" name="No - Fails, Restart Cycle" sourceRef="ExclusiveGateway_CombinedTestResult" targetRef="ParallelGateway_Restart"/>

    <!-- Loop Back -->
    <bpmn:sequenceFlow id="SequenceFlow_ElectricalRestartLoop" name="" sourceRef="ParallelGateway_Restart" targetRef="Task_ElectricalReview"/>
    <bpmn:sequenceFlow id="SequenceFlow_PhysicalRestartLoop" name="" sourceRef="ParallelGateway_Restart" targetRef="Task_PhysicalReview"/>

  </bpmn:process>
</bpmn:definitions>