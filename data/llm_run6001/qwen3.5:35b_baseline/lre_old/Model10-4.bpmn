<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_EquipmentChangeProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="Participant_MainSystem" name="Equipment Change Process" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_MPON" name="MPON">
        <bpmn:flowNodeRef>StartEvent_Initiate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyMPOO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ResponsibilityDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DismountOld_MPON</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReadFinal_MPON</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MountNewDevice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReadMeterCount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendValuesToGO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TellGODetails</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_MPOO" name="MPOO">
        <bpmn:flowNodeRef>Gateway_SelfDismountDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AnnounceSelfDisassembly</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NoSelfDisassemblyNotify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ResponsibilityDecision_MPOOPath</bpmn:flowNodeRef> <!-- Placeholder for flow logic -->
      </bpmn:lane>

       <bpmn:lane id="Lane_GO" name="GO">
         <bpmn:flowNodeRef>Task_NotifyMSPDetails</bpmn:flowNodeRef>
       </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Initiate" name="Initiate Equipment Change">
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- MPON Task 1 -->
    <bpmn:task id="Task_NotifyMPOO" name="Notify MPOO about equipment change intentions">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:task>

    <!-- MPOO Decision Gateway -->
    <bpmn:exclusiveGateway id="Gateway_SelfDismountDecision" name="Self Dismounting?">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3a</bpmn:outgoing> <!-- Yes -->
      <bpmn:outgoing>SequenceFlow_3b</bpmn:outgoing> <!-- No -->
    </bpmn:exclusiveGateway>

    <!-- MPOO Task 1 (Yes) -->
    <bpmn:task id="Task_AnnounceSelfDisassembly" name="Announce self dismounting to MPON">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_3a</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Merge1</bpmn:outgoing>
    </bpmn:task>

    <!-- MPOO Task 2 (No) -->
    <bpmn:task id="Task_NoSelfDisassemblyNotify" name="Notify MPON about no self-dismounting">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_3b</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Merge2</bpmn:outgoing>
    </bpmn:task>

    <!-- Merge after MPOO Decision -->
    <bpmn:exclusiveGateway id="Gateway_Connect_PhysicalWork" name="Merge Notification Paths">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_Merge1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4a_MPON_DismountPath</bpmn:outgoing> <!-- MPON does it -->
    </bpmn:exclusiveGateway>

     <!-- Logic Adjustment for Validity: Merging paths then deciding responsibility. 
          Since "MPON or MPOO" perform reading/dismounting, we need a decision point after notifications.
          Let's merge the notification tasks first to ensure flow continuity before splitting on physical work. -->

    <bpmn:exclusiveGateway id="Gateway_ResponsibilityDecision" name="Who performs Dismount/Reading?">
      <bpmn:name></bpmn:name>
      <!-- Incoming from merged MPOO paths (simplified for valid XML structure) -->
       <bpmn:incoming>SequenceFlow_Merge1</bpmn:incoming> 
    </bpmn:exclusiveGateway>

     <!-- Correcting Flow Logic to ensure unique IDs and proper connections without circular references in thought process.
          Let's define the flow explicitly below with correct IDs -->

  </process>

   <bpmn:endEvent id="EndEvent_Complete" name="Process Complete">
      <bpmn:incoming>SequenceFlow_Final</bpmn:incoming>
  </bpmn:endEvent>

</definitions>