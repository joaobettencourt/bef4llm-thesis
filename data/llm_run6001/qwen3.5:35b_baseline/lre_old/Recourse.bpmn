<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_SubrogationProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_Subrogation">
    <bpmn:participant id="Participant_MainSystem" name="Insurance Subrogation Process" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_SubrogationInfo" name="Receive Information about Possible Subrogation">
      <bpmn:outgoing>SequenceFlow_CheckCase</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1 -->
    <bpmn:task id="Task_CheckRecoursePossibility" name="Check Case for Recourse Possibility">
      <bpmn:incoming>SequenceFlow_CheckCase</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RecoursePossible?</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1 -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_RecoursePossible" name="Is Recourse Possible?">
      <bpmn:incoming>SequenceFlow_RecoursePossible?</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendPaymentRequest</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CloseCaseNoRecourse</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Parallel Gateway for Payment Request and Reminder -->
    <bpmn:parallelGateway id="ParallelGateway_SendRequestAndReminder">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_SendPaymentRequest</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RequestPayment</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_MakeReminder</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 2 -->
    <bpmn:task id="Task_SendPaymentRequest" name="Send Request for Payment to Insurant">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_RequestPayment</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitForMoneyOrDisagreement1</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3 -->
    <bpmn:task id="Task_MakeReminder" name="Make Reminder">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_MakeReminder</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitForMoneyOrDisagreement2</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Event for Money Received -->
    <bpmn:startEvent id="StartEvent_MoneyReceived" name="Receive Payment">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_WaitForMoneyOrDisagreement1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Booking</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 4 -->
    <bpmn:task id="Task_MakeBooking" name="Make Booking">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_Booking</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CloseCaseBooked</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Event for Disagreement -->
    <bpmn:startEvent id="StartEvent_Disagreement" name="Receive Insurant Disagreement">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_WaitForMoneyOrDisagreement2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckDisagreement</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 5 -->
    <bpmn:task id="Task_CheckDisagreementReasoning" name="Check Reasoning of Insurant's Disagreement">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_CheckDisagreement</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DisagreementValid?</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2 -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_DisagreementValid" name="Is Insurant Right?">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_DisagreementValid?</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CloseCaseRight</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ForwardToCollectionWrong</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Intermediate Event for Deadline Reached -->
    <bpmn:startEvent id="StartEvent_DeadlineReached" name="Deadline for Disagreement Reached">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_WaitForMoneyOrDisagreement2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ForwardToCollection</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 6 -->
    <bpmn:task id="Task_ForwardToCollection" name="Forward Case to Collection Agency">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_ForwardToCollection</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CloseCaseAfterCollection</bpmn:outgoing>
    </bpmn:task>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_CaseClosedNoRecourse" name="Close Case (No Recourse Possible)">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_CloseCaseNoRecourse</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_CaseClosedBooked" name="Close Case (Money Received)">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_CloseCaseBooked</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_CaseClosedRight" name="Close Case (Insurant Right)">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>SequenceFlow_CloseCaseRight</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckCase" sourceRef="StartEvent_SubrogationInfo" targetRef="Task_CheckRecoursePossibility"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_RecoursePossible?" name="Is Recourse Possible?" sourceRef="Task_CheckRecoursePossibility" targetRef="ExclusiveGateway_RecoursePossible"/>

    <!-- No path from gateway -->
    <bpmn:sequenceFlow id="SequenceFlow_CloseCaseNoRecourse" name="No, Not Possible" sourceRef="ExclusiveGateway_RecoursePossible" targetRef="EndEvent_CaseClosedNoRecourse"/>

    <!-- Yes path - parallel split for payment request and reminder -->
    <bpmn:sequenceFlow id="SequenceFlow_SendPaymentRequest" name="Yes, Possibility Exists" sourceRef="ExclusiveGateway_RecoursePossible" targetRef="ParallelGateway_SendRequestAndReminder"/>

    <bpmn:sequenceFlow id="SequenceFlow_RequestPayment" sourceRef="ParallelGateway_SendRequestAndReminder" targetRef="Task_SendPaymentRequest"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_MakeReminder" sourceRef="ParallelGateway_SendRequestAndReminder" targetRef="Task_MakeReminder"/>

    <!-- Wait for money -->
    <bpmn:sequenceFlow id="SequenceFlow_WaitForMoneyOrDisagreement1" name="" sourceRef="Task_SendPaymentRequest" targetRef="StartEvent_MoneyReceived"/>

    <!-- Booking flow -->
    <bpmn:sequenceFlow id="SequenceFlow_Booking" sourceRef="StartEvent_MoneyReceived" targetRef="Task_MakeBooking"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_CloseCaseBooked" name="" sourceRef="Task_MakeBooking" targetRef="EndEvent_CaseClosedBooked"/>

    <!-- Wait for disagreement -->
    <bpmn:sequenceFlow id="SequenceFlow_WaitForMoneyOrDisagreement2" name="" sourceRef="Task_SendPaymentRequest" targetRef="StartEvent_Disagreement"/>

    <!-- Disagreement flow -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckDisagreement" sourceRef="StartEvent_Disagreement" targetRef="Task_CheckDisagreementReasoning"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_DisagreementValid?" name="" sourceRef="Task_CheckDisagreementReasoning" targetRef="ExclusiveGateway_DisagreementValid"/>

    <!-- Insurant right path -->
    <bpmn:sequenceFlow id="SequenceFlow_CloseCaseRight" name="Yes, Right" sourceRef="ExclusiveGateway_DisagreementValid" targetRef="EndEvent_CaseClosedRight"/>

    <!-- Insurant wrong path - forward to collection -->
    <bpmn:sequenceFlow id="SequenceFlow_ForwardToCollectionWrong" name="No, Wrong" sourceRef="ExclusiveGateway_DisagreementValid" targetRef="Task_ForwardToCollection"/>

    <!-- Deadline reached flow -->
    <bpmn:sequenceFlow id="SequenceFlow_ForwardToCollection" name="" sourceRef="StartEvent_DeadlineReached" targetRef="Task_ForwardToCollection"/>

    <!-- Forward to collection and close case -->
    <bpmn:sequenceFlow id="SequenceFlow_CloseCaseAfterCollection" name="" sourceRef="Task_ForwardToCollection" targetRef="EndEvent_CaseClosedNoRecourse"/>

  </bpmn:process>
</bpmn:definitions>