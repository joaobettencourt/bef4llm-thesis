<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_GO_Process" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="Participant_GO" name="Government Office (GO)" processRef="Process_OrdrProc"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_OrdrProc" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_MSPO_Deregistration" name="MSPO Deregisters at GO">
      <bpmn:outgoing>SequenceFlow_Verify</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1 -->
    <bpmn:task id="Task_VerifyDeregistration" name="Verify Deregistration of MSPO">
      <bpmn:incoming>SequenceFlow_Verify</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DecisionPoint</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1 -->
    <bpmn:exclusiveGateway id="Gateway_DeregistrationDecision" name="Valid Deregistration?">
      <bpmn:incoming>SequenceFlow_DecisionPoint</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RejectPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ConfirmPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_Verify" sourceRef="StartEvent_MSPO_Deregistration" targetRef="Task_VerifyDeregistration"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_DecisionPoint" name="Verification Result" sourceRef="Task_VerifyDeregistration" targetRef="Gateway_DeregistrationDecision"/>

    <!-- Reject Path -->
    <bpmn:task id="Task_InformRejection" name="Inform MSPO of Rejection">
      <bpmn:incoming>SequenceFlow_RejectPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndRejected</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_Rejected" name="Deregistration Rejected">
      <bpmn:incoming>SequenceFlow_EndRejected</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Confirm Path -->
    <bpmn:task id="Task_AssignMSP" name="Assign GO as MSP">
      <bpmn:incoming>SequenceFlow_ConfirmPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SplitNotifications</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway Split -->
    <bpmn:parallelGateway id="Gateway_NotifySplit" name="Notify Parties">
      <bpmn:incoming>SequenceFlow_SplitNotifications</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NotifyMSPO</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NotifyMPO</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NotifySP</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Notification Tasks -->
    <bpmn:task id="Task_NotifyMSPO" name="Inform MSPO of Assignment Change">
      <bpmn:incoming>SequenceFlow_NotifyMSPO</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeNotifications</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_NotifyMPO" name="Inform MPO of Assignment">
      <bpmn:incoming>SequenceFlow_NotifyMPO</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeNotifications</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_NotifySP" name="Inform SP of Assignment">
      <bpmn:incoming>SequenceFlow_NotifySP</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeNotifications</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway Merge -->
    <bpmn:parallelGateway id="Gateway_NotifyMerge" name="All Notifications Sent">
      <bpmn:incoming>SequenceFlow_MergeNotifications</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndActive</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Complete" name="Assignment Active">
      <bpmn:incoming>SequenceFlow_EndActive</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flow Definitions -->
    <bpmn:sequenceFlow id="SequenceFlow_RejectPath" name="Reject Deregistration" sourceRef="Gateway_DeregistrationDecision" targetRef="Task_InformRejection"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ConfirmPath" name="Confirm Deregistration" sourceRef="Gateway_DeregistrationDecision" targetRef="Task_AssignMSP"/>

    <bpmn:sequenceFlow id="SequenceFlow_SplitNotifications" sourceRef="Task_AssignMSP" targetRef="Gateway_NotifySplit"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_NotifyMSPO" name="Inform MSPO" sourceRef="Gateway_NotifySplit" targetRef="Task_NotifyMSPO"/>
    <bpmn:sequenceFlow id="SequenceFlow_NotifyMPO" name="Inform MPO" sourceRef="Gateway_NotifySplit" targetRef="Task_NotifyMPO"/>
    <bpmn:sequenceFlow id="SequenceFlow_NotifySP" name="Inform SP" sourceRef="Gateway_NotifySplit" targetRef="Task_NotifySP"/>

    <bpmn:sequenceFlow id="SequenceFlow_MergeNotifications" sourceRef="Task_NotifyMSPO" targetRef="Gateway_NotifyMerge"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_EndActive" name="Process Complete" sourceRef="Gateway_NotifyMerge" targetRef="EndEvent_Complete"/>

  </bpmn:process>
</bpmn:definitions>