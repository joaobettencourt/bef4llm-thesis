<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_RobotSeller">
    <bpmn:participant id="Participant_VendingRobot" name="Robotic Burger Seller" processRef="Process_BurgerPrep" />
  </bpmn:collaboration>

  <bpmn:process id="Process_BurgerPrep" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="Start_OrderReceived" name="Order Received">
      <bpmn:outgoing>SequenceFlow_01_AskMenu</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Ask Customer Choice -->
    <bpmn:userTask id="UserTask_AskChoice" name="Ask Menu vs Just Burger">
      <bpmn:incoming>SequenceFlow_01_AskMenu</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_03_GatewayDecision</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway 1: Menu or Just Burger -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_MenuChoice" name="Menu&#10;or Burger?">
      <bpmn:incoming>SequenceFlow_03_GatewayDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PathMenu</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PathJustBurger</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Parallel Split for Menu Path -->
    <bpmn:parallelGateway id="ParallelGateway_MenuSplit" name="Start&#10;Prep">
      <bpmn:incoming>SequenceFlow_PathMenu</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DrinkPrepStart</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SideAskStart</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Prepare Drink -->
    <bpmn:userTask id="UserTask_DrinkPrep" name="Prepare Drink">
      <bpmn:incoming>SequenceFlow_DrinkPrepStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeJoinDrink</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Ask Side Selection -->
    <bpmn:userTask id="UserTask_AskSide" name="Ask Fries or Wedges">
      <bpmn:incoming>SequenceFlow_SideAskStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GatewaySideChoice</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway 2: Fries or Wedges -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_SideType" name="Fries&#10;or Wedges?">
      <bpmn:incoming>SequenceFlow_GatewaySideChoice</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PrepareFries</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PrepareWedges</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Prepare Fries -->
    <bpmn:userTask id="UserTask_Fries" name="Prepare Fries">
      <bpmn:incoming>SequenceFlow_PrepareFries</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeJoinSide</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Prepare Wedges -->
    <bpmn:userTask id="UserTask_Wedges" name="Prepare Wedges">
      <bpmn:incoming>SequenceFlow_PrepareWedges</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeJoinSide</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel Join for Menu Path -->
    <bpmn:parallelGateway id="ParallelGateway_MenuMerge" name="Prep&#10;Complete">
      <bpmn:incoming>SequenceFlow_MergeJoinDrink</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_MergeJoinSide</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StartBurgerMenu</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Just Burger Path -->
    <bpmn:userTask id="UserTask_JustBurger" name="Start&#10;Prep">
      <bpmn:incoming>SequenceFlow_PathJustBurger</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StartBurgerDirect</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Convergence Gateway -->
    <bpmn:inclusiveGateway id="ExclusiveGateway_Converge" name="Ready&#10;to Cook?">
      <bpmn:incoming>SequenceFlow_StartBurgerMenu</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_StartBurgerDirect</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PrepareBurgerTask</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Task: Prepare Burger with Timer Boundary Event -->
    <bpmn:userTask id="UserTask_Burger" name="Prepare&#10;Burger">
      <bpmn:incoming>SequenceFlow_PrepareBurgerTask</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DeliverOrder</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Timer Boundary Event for Status Updates -->
    <bpmn:boundaryEvent id="Boundary_Updates" name="Status&#10;Update">
      <bpmn:attachedToRef>UserTask_Burger</bpmn:attachedToRef>
      <bpmn:timerDefinition xsi:type="bpmn:TimeCycleExpression">PT30S</bpmn:timerDefinition>
    </bpmn:boundaryEvent>

    <!-- End Event -->
    <bpmn:endEvent id="End_Delivered" name="Order&#10;Delivered">
      <bpmn:incoming>SequenceFlow_DeliverOrder</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows (Start to Ask Choice) -->
    <bpmn:sequenceFlow id="SequenceFlow_01_AskMenu" sourceRef="Start_OrderReceived" targetRef="UserTask_AskChoice" />
    
    <!-- Ask Choice to Decision Gateway -->
    <bpmn:sequenceFlow id="SequenceFlow_03_GatewayDecision" sourceRef="UserTask_AskChoice" targetRef="ExclusiveGateway_MenuChoice" />

    <!-- Menu Path Split -->
    <bpmn:sequenceFlow id="SequenceFlow_PathMenu" sourceRef="ExclusiveGateway_MenuChoice" targetRef="ParallelGateway_MenuSplit">
      <bpmn:name>If&#10;Menu</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Just Burger Path -->
    <bpmn:sequenceFlow id="SequenceFlow_PathJustBurger" sourceRef="ExclusiveGateway_MenuChoice" targetRef="UserTask_JustBurger">
      <bpmn:name>Just&#10;Burger</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Drink Prep Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_DrinkPrepStart" sourceRef="ParallelGateway_MenuSplit" targetRef="UserTask_DrinkPrep" />

    <!-- Side Ask Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_SideAskStart" sourceRef="ParallelGateway_MenuSplit" targetRef="UserTask_AskSide" />

    <!-- Side Choice Gateway -->
    <bpmn:sequenceFlow id="SequenceFlow_GatewaySideChoice" sourceRef="UserTask_AskSide" targetRef="ExclusiveGateway_SideType" />

    <!-- Fries/Wedges Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_PrepareFries" sourceRef="ExclusiveGateway_SideType" targetRef="UserTask_Fries">
      <bpmn:name>Fries</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_PrepareWedges" sourceRef="ExclusiveGateway_SideType" targetRef="UserTask_Wedges">
      <bpmn:name>Wedges</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Merge Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_MergeJoinDrink" sourceRef="UserTask_DrinkPrep" targetRef="ParallelGateway_MenuMerge" />
    
    <bpmn:sequenceFlow id="SequenceFlow_MergeJoinSide" sourceRef="UserTask_Fries" targetRef="ParallelGateway_MenuMerge">
      <bpmn:name>Fries&#10;Complete</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Merge Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_MergeJoinSide2" sourceRef="UserTask_Wedges" targetRef="ParallelGateway_MenuMerge">
      <bpmn:name>Wedges&#10;Complete</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Merge Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartBurgerMenu" sourceRef="ParallelGateway_MenuMerge" targetRef="ExclusiveGateway_Converge" />
    
    <bpmn:sequenceFlow id="SequenceFlow_StartBurgerDirect" sourceRef="UserTask_JustBurger" targetRef="ExclusiveGateway_Converge">
      <bpmn:name>Ready&#10;Now</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Burger Preparation Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_PrepareBurgerTask" sourceRef="ExclusiveGateway_Converge" targetRef="UserTask_Burger" />

    <!-- Delivery Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_DeliverOrder" sourceRef="UserTask_Burger" targetRef="End_Delivered">
      <bpmn:name>Conveyor&#10;Belt</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
  
  <bpmn:message id="Message_01_OrderConfirmation" name="Order Confirmation"/>
</bpmn:definitions>