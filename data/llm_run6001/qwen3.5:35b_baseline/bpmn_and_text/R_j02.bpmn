<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_InspectionProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_MachineInspection" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Inspector" name="Inspector">
        <bpmn:flowNodeRef>StartEvent_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_EnterDetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_AskQuestions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_AdditionalInquiry</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Inspection System">
        <bpmn:flowNodeRef>ServiceTask_CollectData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_CheckResults</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Start" name="Inspection Initiated">
      <bpmn:outgoing>SequenceFlow_EnterDetails</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Enter Machine Details -->
    <bpmn:userTask id="UserTask_EnterDetails" name="Enter Type &amp; Serial Number">
      <bpmn:incoming>SequenceFlow_EnterDetails</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StartInspection</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Ask Questions / Input Values -->
    <bpmn:userTask id="UserTask_AskQuestions" name="Ask Questions &amp; Input Values">
      <bpmn:incoming>SequenceFlow_StartInspection</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToCollectData</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Service Task: Collect Data from Machine -->
    <bpmn:serviceTask id="ServiceTask_CollectData" name="Press Buttons &amp; Auto-Collect Values">
      <bpmn:incoming>SequenceFlow_ToCollectData</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckResults</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Gateway: Check Results -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_CheckResults" name="Additional&#10;Questions Needed?">
      <bpmn:incoming>SequenceFlow_CheckResults</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_YesPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Additional Questions (Conditional) -->
    <bpmn:userTask id="UserTask_AdditionalInquiry" name="Conduct Additional Inquiry">
      <bpmn:incoming>SequenceFlow_YesPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToEnd</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Completed" name="Inspection&#10;Completed">
      <bpmn:incoming>SequenceFlow_NoPath</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_EnterDetails" name="Machine Details Entered" sourceRef="StartEvent_Start" targetRef="UserTask_EnterDetails">
      <bpmn:name>Machine Details Entered</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Note: Corrected flow from UserTask to ServiceTask -->
    <bpmn:sequenceFlow id="SequenceFlow_StartInspection" name="Begin Inspection" sourceRef="UserTask_EnterDetails" targetRef="ServiceTask_CollectData">
      <bpmn:name>Begin Inspection</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Note: Corrected flow from UserTask to ServiceTask -->
    <bpmn:sequenceFlow id="SequenceFlow_ToCollectData" name="Input Values" sourceRef="UserTask_AskQuestions" targetRef="ServiceTask_CollectData">
      <bpmn:name>Input Values</bpmn:name>
    </bpmn:sequenceLogic>

    <!-- Note: Corrected flow from ServiceTask to Gateway -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckResults" name="Data Displayed" sourceRef="ServiceTask_CollectData" targetRef="ExclusiveGateway_CheckResults">
      <bpmn:name>Data Displayed</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Conditional Paths -->
    <bpmn:sequenceFlow id="SequenceFlow_YesPath" name="Additional Questions Needed" sourceRef="ExclusiveGateway_CheckResults" targetRef="UserTask_AdditionalInquiry">
      <bpmn:name>yes</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_NoPath" name="No Additional Questions Needed" sourceRef="ExclusiveGateway_CheckResults" targetRef="EndEvent_Completed">
      <bpmn:name>no</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Note: Corrected flow from Task to End -->
    <bpmn:sequenceFlow id="SequenceFlow_ToEnd" name="Inquiry Complete" sourceRef="UserTask_AdditionalInquiry" targetRef="EndEvent_Completed">
      <bpmn:name>Inquiry Complete</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>