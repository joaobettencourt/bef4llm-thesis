<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ViennaRunApp">
  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="Participant_AppUser" name="Vienna Night Run App User" processRef="Process_RunParticipation" />
  </bpmn:collaboration>

  <bpmn:process id="Process_RunParticipation" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="Start_1" name="Start Participation">
      <bpmn:outgoing>Seq_SelectBlock</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Select Starting Block -->
    <bpmn:userTask id="Task_SelectBlock" name="Select Starting Block">
      <bpmn:incoming>Seq_SelectBlock</bpmn:incoming>
      <bpmn:outgoing>Seq_RunMeasure</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task 2: Run and Measure -->
    <bpmn:userTask id="Task_Runner" name="Run for 5km &amp; Measure Time">
      <bpmn:incoming>Seq_RunMeasure</bpmn:incoming>
      <bpmn:outgoing>Seq_QualifyCheck</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway 1: Qualification Check -->
    <bpmn:exclusiveGateway id="Gateway_Qualify" name="Time &lt; 25 min?">
      <bpmn:incoming>Seq_QualifyCheck</bpmn:incoming>
      <bpmn:outgoing>Seq_GetNumber</bpmn:outgoing>
      <bpmn:outgoing>Seq_TrainLoop</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 3: Train (Loop) -->
    <bpmn:userTask id="Task_Train" name="Train and Check Goal">
      <bpmn:incoming>Seq_TrainLoop</bpmn:incoming>
      <bpmn:outgoing>Seq_RetryMeasure</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task 4: Get Starting Number -->
    <bpmn:userTask id="Task_GetNumber" name="Get Starting Number">
      <bpmn:incoming>Seq_GetNumber</bpmn:incoming>
      <bpmn:outgoing>Seq_CommuteDecision</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway 2: Commute Decision -->
    <bpmn:exclusiveGateway id="Gateway_Commute" name="&gt; 1 Hour Left?">
      <bpmn:incoming>Seq_CommuteDecision</bpmn:incoming>
      <bpmn:outgoing>Seq_GoHome</bpmn:outgoing>
      <bpmn:outgoing>Seq_LeaveWork</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 5a: Go from Home -->
    <bpmn:userTask id="Task_GoHome" name="Go to Run from Home">
      <bpmn:incoming>Seq_GoHome</bpmn:incoming>
      <bpmn:outgoing>Seq_MergeCommute1</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task 5b: Leave Work Directly -->
    <bpmn:userTask id="Task_LeaveWork" name="Leave directly from work">
      <bpmn:incoming>Seq_LeaveWork</bpmn:incoming>
      <bpmn:outgoing>Seq_MergeCommute2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway 3: Merge Commute Paths -->
    <bpmn:parallelGateway id="Gateway_Merge" name="Merge">
      <bpmn:incoming>Seq_MergeCommute1</bpmn:incoming>
      <bpmn:incoming>Seq_MergeCommute2</bpmn:incoming>
      <bpmn:outgoing>Seq_RunDrink</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 6: Run and Drink -->
    <bpmn:userTask id="Task_RunDrink" name="Run &amp; Drink">
      <bpmn:incoming>Seq_RunDrink</bpmn:incoming>
      <bpmn:outgoing>Seq_FinalTime</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="End_1" name="Receive Final Time">
      <bpmn:incoming>Seq_FinalTime</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    
    <!-- Start to Select Block -->
    <bpmn:sequenceFlow id="Seq_SelectBlock" sourceRef="Start_1" targetRef="Task_SelectBlock">
      <bpmn:name>Select Starting Block</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Select Block to Run/Measure -->
    <bpmn:sequenceFlow id="Seq_RunMeasure" sourceRef="Task_SelectBlock" targetRef="Task_Runner">
      <bpmn:name>Select &amp; Start</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Run to Qualify Gateway -->
    <bpmn:sequenceFlow id="Seq_QualifyCheck" sourceRef="Task_Runner" targetRef="Gateway_Qualify">
      <bpmn:name>Run Complete</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Qualify Gateway Yes Path -->
    <bpmn:sequenceFlow id="Seq_GetNumber" sourceRef="Gateway_Qualify" targetRef="Task_GetNumber">
      <bpmn:name>&lt; 25 min</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Qualify Gateway No Path -->
    <bpmn:sequenceFlow id="Seq_TrainLoop" sourceRef="Gateway_Qualify" targetRef="Task_Train">
      <bpmn:name>&gt;= 25 min</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Train Loop Back -->
    <bpmn:sequenceFlow id="Seq_RetryMeasure" sourceRef="Task_Train" targetRef="Task_Runner">
      <bpmn:name>Train &amp; Retry</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Get Number to Commute Gateway -->
    <bpmn:sequenceFlow id="Seq_CommuteDecision" sourceRef="Task_GetNumber" targetRef="Gateway_Commute">
      <bpmn:name>Get Ready</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Commute Yes Path (Home) -->
    <bpmn:sequenceFlow id="Seq_GoHome" sourceRef="Gateway_Commute" targetRef="Task_GoHome">
      <bpmn:name>&gt; 1 Hour</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Commute No Path (Work) -->
    <bpmn:sequenceFlow id="Seq_LeaveWork" sourceRef="Gateway_Commute" targetRef="Task_LeaveWork">
      <bpmn:name>&lt;= 1 Hour</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Merge Paths -->
    <bpmn:sequenceFlow id="Seq_MergeCommute1" sourceRef="Task_GoHome" targetRef="Gateway_Merge">
      <bpmn:name>Merged Home</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Merge Paths -->
    <bpmn:sequenceFlow id="Seq_MergeCommute2" sourceRef="Task_LeaveWork" targetRef="Gateway_Merge">
      <bpmn:name>Merged Work</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Merge to Run/Drink -->
    <bpmn:sequenceFlow id="Seq_RunDrink" sourceRef="Gateway_Merge" targetRef="Task_RunDrink">
      <bpmn:name>Merged Commute</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- End Event Flow -->
    <bpmn:sequenceFlow id="Seq_FinalTime" sourceRef="Task_RunDrink" targetRef="End_1">
      <bpmn:name>Finish</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>