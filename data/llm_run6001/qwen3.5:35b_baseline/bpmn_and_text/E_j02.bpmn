<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_BecomingParent">
    <bpmn:participant id="Participant_GovPortal" name="E-Government Parent Support System" processRef="Process_MaternityLeave" />
  </bpmn:collaboration>

  <bpmn:process id="Process_MaternityLeave" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Applicant" name="Applicant (Parent)">
        <bpmn:flowNodeRef>StartEvent_Request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_SelectPlan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_CollectInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_DecisionExtension</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Administration" name="Administration (System)">
        <bpmn:flowNodeRef>ServiceTask_FetchModels</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_NotifySS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_NotifyCompany</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_GatherInfoCompanies</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Request" name="Request Leave Planning">
      <bpmn:outgoing>SequenceFlow_StartToFetch</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Fetch Information about potential models -->
    <bpmn:userTask id="ServiceTask_FetchModels" name="Fetch Potential Models&#10;(Duration, Split)">
      <bpmn:incoming>SequenceFlow_StartToFetch</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ModelsReady</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task 2: Let parent select -->
    <bpmn:userTask id="UserTask_SelectPlan" name="Select Leave Plan">
      <bpmn:incoming>SequenceFlow_ModelsReady</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToCollectInfo</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task 3: Collect relevant information -->
    <bpmn:userTask id="UserTask_CollectInfo" name="Collect Relevant Information">
      <bpmn:incoming>SequenceFlow_ToCollectInfo</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NotifyStart</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel Gateway for Notifications -->
    <bpmn:parallelGateway id="ParallelNotify" name="Notifications">
      <bpmn:incoming>SequenceFlow_NotifyStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NotifSS</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NotifCompany</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 4a: Notify Social Security -->
    <bpmn:userTask id="UserTask_NotifySS" name="Notify Social&#10;Security">
      <bpmn:incoming>SequenceFlow_NotifSS</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_JoinNotifsSS</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task 4b: Notify Company -->
    <bpmn:userTask id="UserTask_NotifyCompany" name="Notify Company">
      <bpmn:incoming>SequenceFlow_NotifCompany</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_JoinNotifsComp</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Join Parallel Gateway -->
    <bpmn:parallelGateway id="ParallelJoin" name="Notifications&#10;Complete">
      <bpmn:incoming>SequenceFlow_JoinNotifsSS</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_JoinNotifsComp</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GatherInfoStart</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 5: Gather information from companies -->
    <bpmn:userTask id="UserTask_GatherInfoCompanies" name="Gather Information&#10;from Companies">
      <bpmn:incoming>SequenceFlow_GatherInfoStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ApprovalCheck</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Decision Gateway for Approval -->
    <bpmn:exclusiveGateway id="ExclusiveApproval" name="Approved?">
      <bpmn:incoming>SequenceFlow_ApprovalCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GrantLeave</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RejectLeave</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event for Rejection -->
    <bpmn:endEvent id="EndEvent_Rejected" name="Request&#10;Rejected">
      <bpmn:incoming>SequenceFlow_RejectLeave</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task representing the Leave Period (Time passing) -->
    <bpmn:userTask id="UserTask_LeavingPeriod" name="Maternity&#10;Leave Active">
      <bpmn:incoming>SequenceFlow_GrantLeave</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DecisionStart</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task 6: Decision on Extension -->
    <bpmn:userTask id="UserTask_DecisionExtension" name="Decision&#10;on Extension">
      <bpmn:incoming>SequenceFlow_DecisionStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ExtendCheck</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Decision Gateway for Extension -->
    <bpmn:exclusiveGateway id="ExclusiveExtension" name="Extend?">
      <bpmn:incoming>SequenceFlow_ExtendCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProcessEnd</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_InitiateExt</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event for Completion -->
    <bpmn:endEvent id="EndEvent_Completed" name="Process&#10;Completed">
      <bpmn:incoming>SequenceFlow_ProcessEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task to Initiate Extension (Notify again) -->
    <bpmn:userTask id="UserTask_InitExt" name="Initiate&#10;Extension">
      <bpmn:incoming>SequenceFlow_InitiateExt</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ExtEnd</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event for Extension -->
    <bpmn:endEvent id="EndEvent_Extended" name="Extension&#10;Granted">
      <bpmn:incoming>SequenceFlow_ExtEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToFetch" sourceRef="StartEvent_Request" targetRef="ServiceTask_FetchModels" />
    <bpmn:sequenceFlow id="SequenceFlow_ModelsReady" name="Info Ready" sourceRef="ServiceTask_FetchModels" targetRef="UserTask_SelectPlan" />
    <bpmn:sequenceFlow id="SequenceFlow_ToCollectInfo" sourceRef="UserTask_SelectPlan" targetRef="UserTask_CollectInfo" />
    <bpmn:sequenceFlow id="SequenceFlow_NotifyStart" name="Submit Info" sourceRef="UserTask_CollectInfo" targetRef="ParallelNotify" />

    <!-- Notification Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_NotifSS" sourceRef="ParallelNotify" targetRef="UserTask_NotifySS">
      <bpmn:name>Notify SS</bpmn:name>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_NotifCompany" name="Notify Company" sourceRef="ParallelNotify" targetRef="UserTask_NotifyCompany" />

    <!-- Join Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_JoinNotifsSS" sourceRef="UserTask_NotifySS" targetRef="ParallelJoin">
      <bpmn:name>Notify SS Done</bpmn:name>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_JoinNotifsComp" name="Notify Company Done" sourceRef="UserTask_NotifyCompany" targetRef="ParallelJoin">
      <bpmn:name>Notify Comp Done</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Approval Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_GatherInfoStart" sourceRef="ParallelJoin" targetRef="UserTask_GatherInfoCompanies">
      <bpmn:name>All Notified</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Decision Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_ApprovalCheck" name="Verification Done" sourceRef="UserTask_GatherInfoCompanies" targetRef="ExclusiveApproval">
      <bpmn:name>Ready</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Decision Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_RejectLeave" name="No" sourceRef="ExclusiveApproval" targetRef="EndEvent_Rejected">
      <bpmn:name>Rejected</bpmn:name>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_GrantLeave" name="Yes" sourceRef="ExclusiveApproval" targetRef="UserTask_LeavingPeriod">
      <bpmn:name>Approved</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Extension Logic -->
    <bpmn:sequenceFlow id="SequenceFlow_DecisionStart" name="Leave Active" sourceRef="UserTask_LeavingPeriod" targetRef="UserTask_DecisionExtension">
      <bpmn:name>End of Period</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Extension Decision -->
    <bpmn:sequenceFlow id="SequenceFlow_ExtendCheck" sourceRef="UserTask_DecisionExtension" targetRef="ExclusiveExtension">
      <bpmn:name>Decision Made</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ProcessEnd" name="No Extension" sourceRef="ExclusiveExtension" targetRef="EndEvent_Completed" />
    
    <!-- Initiate Extension Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_InitiateExt" name="Yes, Extend" sourceRef="ExclusiveExtension" targetRef="UserTask_InitExt">
      <bpmn:name>Extend</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Extension End Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_ExtEnd" name="Update Records" sourceRef="UserTask_InitExt" targetRef="EndEvent_Extended">
      <bpmn:name>Extension Initiated</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>