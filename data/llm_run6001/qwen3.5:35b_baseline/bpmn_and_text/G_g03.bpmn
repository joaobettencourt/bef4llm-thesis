<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_BlizzardCharacterGenerator" name="Blizzard Online Character Generator" isExecutable="false">

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_CreateChar" name="Create Character Process">
      <bpmn:outgoing>SequenceFlow_Split_AccountName</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Parallel Gateway Split (Account Setup vs Name Brainstorming) -->
    <bpmn:parallelGateway id="ParallelGateway_AccountVsName">
      <bpmn:incoming>SequenceFlow_Split_AccountName</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CheckBattleNetPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ComingUpWithNames</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Branch A: Account Setup -->
    
    <!-- Check Battle.net Existence -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_CheckBattleNet" name="Have&#10;Battle.net?">
      <bpmn:incoming>SequenceFlow_CheckBattleNetPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_EnterAccountInfo</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_HaveAccountProceed</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- No Account Path -->
    <bpmn:userTask id="UserTask_EnterAccount" name="Enter&#10;Account Info">
      <bpmn:incoming>SequenceFlow_EnterAccountInfo</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_WaitForLink</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Wait for Confirmation Link (Intermediate Catching Message) -->
    <bpmn:intermediateCatchEvent id="Message_CatchConfirmation" name="Wait&#10;for Email">
      <bpmn:messageRef="Message_ConfirmationLink"/>
      <bpmn:incoming>SequenceFlow_WaitForLink</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_AccountConfirmedProceed</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Yes Account Path -->
    <bpmn:sequenceFlow id="SequenceFlow_HaveAccountProceed" name="Yes" sourceRef="ExclusiveGateway_CheckBattleNet" targetRef="ParallelGateway_Join_AccountName">
      <bpmn:name>Have&#10;Account</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Account Confirmation Join -->
    <bpmn:parallelGateway id="ParallelGateway_AfterLinkCheck" name="Join Link Check">
       <bpmn:incoming>SequenceFlow_AccountConfirmedProceed</bpmn:outgoing>
       <bpmn:outgoing>SequenceFlow_CheckSubscriptionPath</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Subscription Check -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_CheckSub" name="Active&#10;WoW Sub?">
      <bpmn:incoming>SequenceFlow_CheckSubscriptionPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SelectPaymentMethod</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SkipToLogin</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Payment Selection -->
    <bpmn:userTask id="UserTask_SelectPay" name="Select&#10;Payment Method">
      <bpmn:incoming>SequenceFlow_SelectPaymentMethod</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PaymentTypeCheck</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Payment Type Decision -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_PayType" name="Payment&#10;Method?">
      <bpmn:incoming>SequenceFlow_PaymentTypeCheck</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_EnterCCInfo</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_EnterBankInfo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Credit Card Path -->
    <bpmn:userTask id="UserTask_CC" name="Enter&#10;Credit Card Info">
      <bpmn:incoming>SequenceFlow_EnterCCInfo</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PaymentDone</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Bank Account Path -->
    <bpmn:userTask id="UserTask_Bank" name="Enter&#10;IBAN &amp;&#10;BIC">
      <bpmn:incoming>SequenceFlow_EnterBankInfo</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PaymentDone</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Payment Done Join -->
    <bpmn:parallelGateway id="ParallelGateway_JoinPayment" name="Join&#10;Payment">
      <bpmn:incoming>SequenceFlow_PaymentDone</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_LogInGamePath</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Skip Payment Path -->
    <bpmn:sequenceFlow id="SequenceFlow_SkipToLogin" name="Yes (Active)" sourceRef="ExclusiveGateway_CheckSub" targetRef="ParallelGateway_JoinPayment">
      <bpmn:name>Already&#10;Active</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Branch B: Name Brainstorming -->
    <bpmn:userTask id="UserTask_BrainstormNames" name="Come up with good character names">
      <bpmn:incoming>SequenceFlow_ComingUpWithNames</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NamesReadyPath</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Convergence of Account Setup and Name Brainstorming -->
    <bpmn:parallelGateway id="ParallelGateway_Join_AccountName" name="Join&#10;Account &amp;&#10;Names">
      <bpmn:incoming>SequenceFlow_NamesReadyPath</bpmn:outgoing>
      <bpmn:incoming>SequenceFlow_HaveAccountProceed</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Log into Game and Create Character -->
    <bpmn:userTask id="UserTask_LogInGame" name="Log&#10;into Game">
      <bpmn:incoming>SequenceFlow_LogInGamePath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SelectCharacterDetails</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Select Character Details -->
    <bpmn:userTask id="UserTask_CharacterSetup" name="Select&#10;Realm, Race &amp;&#10;Class">
      <bpmn:incoming>SequenceFlow_SelectCharacterDetails</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_EnterNamesPath</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Enter Names Loop -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_NameAvailable" name="Name&#10;Available?">
      <bpmn:incoming>SequenceFlow_EnterNamesPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ValidNameFound</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_TryAnotherName</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Valid Name Path -->
    <bpmn:userTask id="UserTask_Confirmation" name="Get&#10;Confirmation &amp;&#10;Selfies">
      <bpmn:incoming>SequenceFlow_ValidNameFound</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ProcessComplete</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Try Another Name Path -->
    <bpmn:sequenceFlow id="SequenceFlow_TryAnotherName" name="No" sourceRef="ExclusiveGateway_NameAvailable" targetRef="UserTask_EnterNamesPath">
      <bpmn:name>Tried&#10;Again</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Process Complete -->
    <bpmn:endEvent id="End_EventSuccessful" name="Character&#10;Created">
      <bpmn:incoming>SequenceFlow_ProcessComplete</bpmn:outgoing>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_Split_AccountName" sourceRef="StartEvent_CreateChar" targetRef="ParallelGateway_AccountVsName">
      <bpmn:name>Create&#10;Character</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Account Setup Path -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckBattleNetPath" sourceRef="ParallelGateway_AccountVsName" targetRef="ExclusiveGateway_CheckBattleNet">
      <bpmn:name>Account&#10;Setup</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Name Brainstorming Path -->
    <bpmn:sequenceFlow id="SequenceFlow_ComingUpWithNames" sourceRef="ParallelGateway_AccountVsName" targetRef="UserTask_BrainstormNames">
      <bpmn:name>Name&#10;Brainstorm</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- No Account Path -->
    <bpmn:sequenceFlow id="SequenceFlow_EnterAccountInfo" sourceRef="ExclusiveGateway_CheckBattleNet" targetRef="UserTask_EnterAccount">
      <bpmn:name>No</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Wait for Link -->
    <bpmn:sequenceFlow id="SequenceFlow_WaitForLink" sourceRef="UserTask_EnterAccount" targetRef="Message_CatchConfirmation">
      <bpmn:name>Click&#10;Email</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Account Confirmed Proceed -->
    <bpmn:sequenceFlow id="SequenceFlow_AccountConfirmedProceed" sourceRef="Message_CatchConfirmation" targetRef="ParallelGateway_AfterLinkCheck">
      <bpmn:name>Email&#10;Received</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Check Subscription Path -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckSubscriptionPath" sourceRef="ParallelGateway_AfterLinkCheck" targetRef="ExclusiveGateway_CheckSub">
      <bpmn:name>Proceed</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Select Payment Method -->
    <bpmn:sequenceFlow id="SequenceFlow_SelectPaymentMethod" sourceRef="ExclusiveGateway_CheckSub" targetRef="UserTask_SelectPay">
      <bpmn:name>No Sub</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Payment Type Check -->
    <bpmn:sequenceFlow id="SequenceFlow_PaymentTypeCheck" sourceRef="UserTask_SelectPay" targetRef="ExclusiveGateway_PayType">
      <bpmn:name>Select</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Enter CC Info -->
    <bpmn:sequenceFlow id="SequenceFlow_EnterCCInfo" sourceRef="ExclusiveGateway_PayType" targetRef="UserTask_CC">
      <bpmn:name>Credit&#10;Card</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Enter Bank Info -->
    <bpmn:sequenceFlow id="SequenceFlow_EnterBankInfo" sourceRef="ExclusiveGateway_PayType" targetRef="UserTask_Bank">
      <bpmn:name>Bank&#10;Account</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Payment Done -->
    <bpmn:sequenceFlow id="SequenceFlow_PaymentDone" sourceRef="UserTask_CC" targetRef="ParallelGateway_JoinPayment">
      <bpmn:name>Credit&#10;Card</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Payment Done -->
    <bpmn:sequenceFlow id="SequenceFlow_PaymentDone2" sourceRef="UserTask_Bank" targetRef="ParallelGateway_JoinPayment">
      <bpmn:name>Bank&#10;Account</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Log In Game Path -->
    <bpmn:sequenceFlow id="SequenceFlow_LogInGamePath" sourceRef="ParallelGateway_JoinPayment" targetRef="UserTask_LogInGame">
      <bpmn:name>Login</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Select Character Details -->
    <bpmn:sequenceFlow id="SequenceFlow_SelectCharacterDetails" sourceRef="UserTask_LogInGame" targetRef="UserTask_CharacterSetup">
      <bpmn:name>Select</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Enter Names Path -->
    <bpmn:sequenceFlow id="SequenceFlow_EnterNamesPath" sourceRef="UserTask_CharacterSetup" targetRef="ExclusiveGateway_NameAvailable">
      <bpmn:name>Name&#10;Entry</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Valid Name Found -->
    <bpmn:sequenceFlow id="SequenceFlow_ValidNameFound" sourceRef="ExclusiveGateway_NameAvailable" targetRef="UserTask_Confirmation">
      <bpmn:name>Yes</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Process Complete -->
    <bpmn:sequenceFlow id="SequenceFlow_ProcessComplete" sourceRef="UserTask_Confirmation" targetRef="End_EventSuccessful">
      <bpmn:name>Done</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>

  <!-- Message Definition -->
  <bpmn:message id="Message_ConfirmationLink" name="Account&#10;Confirmation"/>

</bpmn:definitions>