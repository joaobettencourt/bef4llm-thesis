<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_TreeHouseBuild">
    <bpmn:participant id="Participant_Homeowner" name="Tree House Project Owner" processRef="Process_BuildTreeHouse" />
  </bpmn:collaboration>

  <bpmn:process id="Process_BuildTreeHouse" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_ProjectOwner" name="Project Owner">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CollectRequirements</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DraftApproved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RefinePlan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateMaterialList</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_OrderAndBuildSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InviteFriends</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendInvitations</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DataObject_AttendeeList</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PartyPrepJoin</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Initiate Tree House Build">
      <bpmn:outgoing>SequenceFlow_InitProject</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Collect Requirements -->
    <bpmn:userTask id="Task_CollectRequirements" name="Collect Initial Requirements">
      <bpmn:incoming>SequenceFlow_InitProject</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendToArchitect</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Send to Architect -->
    <bpmn:userTask id="Task_ArchitectInteraction" name="Send Requirements&#10;to Architect">
      <bpmn:incoming>SequenceFlow_SendToArchitect</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReceiveDraftReq</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Receive Draft -->
    <bpmn:userTask id="Task_ArchitectReview" name="Architect Sends&#10;Initial Draft">
      <bpmn:incoming>SequenceFlow_ReceiveDraftReq</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckApproval</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway: Check Approval -->
    <bpmn:exclusiveGateway id="Gateway_DraftApproved" name="Draft&#10;Approved?">
      <bpmn:incoming>SequenceFlow_CheckApproval</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ApprovedPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RefinePath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Refine Plan (Loop) -->
    <bpmn:userTask id="Task_RefinePlan" name="Refine Requirements&#10;with Additional Info">
      <bpmn:incoming>SequenceFlow_RefinePath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ResendToArchitect</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Create Material List (After Approval) -->
    <bpmn:userTask id="Task_CreateMaterialList" name="Create Materials&#10;from Plan">
      <bpmn:incoming>SequenceFlow_ApprovedPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SplitOrderBuild</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway: Split Order & Build -->
    <bpmn:parallelGateway id="Gateway_OrderAndBuildSplit" name="Parallel&#10;Start">
      <bpmn:incoming>SequenceFlow_SplitOrderBuild</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PathOrders</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PathFriends</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Path 1: Order Materials -->
    <bpmn:userTask id="Task_OrderMaterials" name="Order&#10;Online Stores">
      <bpmn:incoming>SequenceFlow_PathOrders</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MaterialsArrive</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Path 2: Recruit Friends -->
    <bpmn:userTask id="Task_InviteFriends" name="Send Messages&#10;to Build House">
      <bpmn:incoming>SequenceFlow_PathFriends</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_HouseBuiltReq</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Join Gateway (Wait for Build & Orders) -->
    <bpmn:parallelGateway id="Gateway_PartyPrepJoin" name="House&#10;Ready?">
      <bpmn:incoming>SequenceFlow_MaterialsArrive</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_HouseBuiltReq</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendInvitations</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Send Party Invitations -->
    <bpmn:userTask id="Task_SendPartyInvites" name="Send&#10;Party Invitations">
      <bpmn:incoming>SequenceFlow_SendInvitations</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CreateAttendeeListReq</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Data Object -->
    <bpmn:dataObject id="DataObject_AttendeeList" name="Attendee List">
      <bpmn:name>DataObject_AttendeeList</bpmn:name>
    </bpmn:dataObject>

    <!-- Task: Create Attendee List (from RSVPs) -->
    <bpmn:userTask id="Task_CreateAttendeeList" name="Create&#10;Attendee List">
      <bpmn:incoming>SequenceFlow_CreateAttendeeListReq</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BuySnacksReq</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Buy Snacks -->
    <bpmn:userTask id="Task_BuySnacks" name="Buy&#10;Party Snacks">
      <bpmn:incoming>SequenceFlow_BuySnacksReq</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FinalizeProcess</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="End_EventComplete" name="Party&#10;Prepared">
      <bpmn:incoming>SequenceFlow_FinalizeProcess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Seq_InitProject" sourceRef="StartEvent_1" targetRef="Task_CollectRequirements">
      <bpmn:name>Initiate Project</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Loop Back Logic -->
    <bpmn:sequenceFlow id="Seq_SendToArchitect" sourceRef="Task_CollectRequirements" targetRef="Task_ArchitectInteraction">
      <bpmn:name>Send Req</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Loop Back Logic -->
    <bpmn:sequenceFlow id="Seq_ResendToArchitect" sourceRef="Task_RefinePlan" targetRef="Task_ArchitectReview">
      <bpmn:name>Resend</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Approval Check -->
    <bpmn:sequenceFlow id="Seq_ReceiveDraftReq" sourceRef="Task_ArchitectInteraction" targetRef="Task_ArchitectReview">
      <bpmn:name>Receive Draft</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Approval Check -->
    <bpmn:sequenceFlow id="Seq_CheckApproval" sourceRef="Task_ArchitectReview" targetRef="Gateway_DraftApproved">
      <bpmn:name>Check Plan</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Seq_ApprovedPath" name="Yes" sourceRef="Gateway_DraftApproved" targetRef="Task_CreateMaterialList" />
    
    <!-- Material List to Split -->
    <bpmn:sequenceFlow id="Seq_SplitOrderBuild" sourceRef="Task_CreateMaterialList" targetRef="Gateway_OrderAndBuildSplit">
      <bpmn:name>Create Materials</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Parallel Paths -->
    <bpmn:sequenceFlow id="Seq_PathOrders" name="Order&#10;Materials" sourceRef="Gateway_OrderAndBuildSplit" targetRef="Task_OrderMaterials">
      <bpmn:name>Order Materials</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Parallel Paths -->
    <bpmn:sequenceFlow id="Seq_PathFriends" name="Recruit&#10;Builders" sourceRef="Gateway_OrderAndBuildSplit" targetRef="Task_InviteFriends">
      <bpmn:name>Recruit Builders</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Join Paths -->
    <bpmn:sequenceFlow id="Seq_MaterialsArrive" name="Orders&#10;Complete" sourceRef="Task_OrderMaterials" targetRef="Gateway_PartyPrepJoin">
      <bpmn:name>Order Complete</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Join Paths -->
    <bpmn:sequenceFlow id="Seq_HouseBuiltReq" name="House&#10;Constructed" sourceRef="Task_InviteFriends" targetRef="Gateway_PartyPrepJoin">
      <bpmn:name>Housing Complete</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Party Prep -->
    <bpmn:sequenceFlow id="Seq_SendInvitations" sourceRef="Gateway_PartyPrepJoin" targetRef="Task_SendPartyInvites">
      <bpmn:name>Send Invitations</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Party Prep -->
    <bpmn:sequenceFlow id="Seq_CreateAttendeeListReq" name="Wait&#10;for RSVPs" sourceRef="Task_SendPartyInvites" targetRef="Task_CreateAttendeeList">
      <bpmn:name>Create List</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Snacks -->
    <bpmn:association id="Assoc_AttendeeData" sourceRef="Task_CreateAttendeeList" targetRef="DataObject_AttendeeList">
      <bpmn:messageFlow />
    </bpmn:association>

    <bpmn:sequenceFlow id="Seq_BuySnacksReq" name="Buy Snacks" sourceRef="Task_CreateAttendeeList" targetRef="Task_BuySnacks">
      <bpmn:name>Create List</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- End -->
    <bpmn:sequenceFlow id="Seq_FinalizeProcess" name="Party&#10;Ready" sourceRef="Task_BuySnacks" targetRef="End_EventComplete">
      <bpmn:name>Finalize</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>