<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_LuxuryAirplane" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Manufacturer" name="Luxury Airplane Manufacturer" processRef="Process_AirplaneProduction" />
  </bpmn:collaboration>

  <bpmn:process id="Process_AirplaneProduction" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_SalesCustomization" name="Sales &amp; Customization">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_DefineSpecs</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Manufacturing" name="Manufacturing Teams">
        <bpmn:flowNodeRef>InclusiveGateway_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_MakeVodkaBar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_MakeWhiskeyBar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_PrepOtherParts</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AssemblyTest" name="Assembly, Test &amp; Delivery">
        <bpmn:flowNodeRef>InclusiveGateway_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_AssembleInterior</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_TestFlight</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_CreateProtocol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_SendInternalReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_DeliverPlane</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Order Received">
      <bpmn:outgoing>SequenceFlow_SpecsRequest</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Define Specs Task -->
    <bpmn:userTask id="UserTask_DefineSpecs" name="Define Interior Specifications&#10;(Bars, Seats, Color, Water)">
      <bpmn:incoming>SequenceFlow_SpecsRequest</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ManufacturingSplit</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Split to Teams -->
    <bpmn:inclusiveGateway id="InclusiveGateway_1" name="Send Requirements">
      <bpmn:incoming>SequenceFlow_ManufacturingSplit</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_VodkaTask</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_WhiskeyTask</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_OtherParts</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Manufacturing Tasks -->
    <bpmn:userTask id="UserTask_MakeVodkaBar" name="Manufacture Vodka Bar&#10;(Russian Team)">
      <bpmn:incoming>SequenceFlow_VodkaTask</bpmn:incoming>
      <bpmn:outgoing>Seq_VodkaToJoin</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="UserTask_MakeWhiskeyBar" name="Manufacture Whiskey Bar&#10;(Irish Team)">
      <bpmn:incoming>SequenceFlow_WhiskeyTask</bpmn:incoming>
      <bpmn:outgoing>Seq_WhiskeyToJoin</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="UserTask_PrepOtherParts" name="Prepare Other Parts&#10;(General Team)">
      <bpmn:incoming>SequenceFlow_OtherParts</bpmn:incoming>
      <bpmn:outgoing>Seq_OtherPartsToJoin</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Join Manufacturing -->
    <bpmn:inclusiveGateway id="InclusiveGateway_2" name="Parts Received">
      <bpmn:incoming>Seq_VodkaToJoin</bpmn:incoming>
      <bpmn:incoming>Seq_WhiskeyToJoin</bpmn:incoming>
      <bpmn:incoming>Seq_OtherPartsToJoin</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AssembleInterior</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Assembly -->
    <bpmn:userTask id="UserTask_AssembleInterior" name="Assemble Interior">
      <bpmn:incoming>SequenceFlow_AssembleInterior</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TestFlightStart</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Test Flight -->
    <bpmn:userTask id="UserTask_TestFlight" name="Conduct Test Flight">
      <bpmn:incoming>SequenceFlow_TestFlightStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CreateProtocol</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Protocol Creation -->
    <bpmn:userTask id="UserTask_CreateProtocol" name="Create Test Protocol">
      <bpmn:incoming>SequenceFlow_CreateProtocol</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DistributeProtocols</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Distribute Protocols -->
    <bpmn:inclusiveGateway id="InclusiveGateway_3" name="Distribute Protocol">
      <bpmn:incoming>SequenceFlow_DistributeProtocols</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendInternalReport</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ShipToCustomer</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Internal Report -->
    <bpmn:userTask id="UserTask_SendInternalReport" name="Send Protocol to Manufacturer">
      <bpmn:incoming>SequenceFlow_SendInternalReport</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConfirmationReceived</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Delivery -->
    <bpmn:userTask id="UserTask_DeliverPlane" name="Deliver Plane to Customer">
      <bpmn:incoming>SequenceFlow_ShipToCustomer</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConfirmationReceived</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="End_Event_1" name="Order Completed">
      <bpmn:incoming>SequenceFlow_ConfirmationReceived</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_SpecsRequest" sourceRef="StartEvent_1" targetRef="UserTask_DefineSpecs">
      <bpmn:name>Order Received</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ManufacturingSplit" name="Send Requirements" sourceRef="UserTask_DefineSpecs" targetRef="InclusiveGateway_1">
      <bpmn:description>Requirements sent to manufacturing teams</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_VodkaTask" name="Order Vodka Bar" sourceRef="InclusiveGateway_1" targetRef="UserTask_MakeVodkaBar">
      <bpmn:description>Russian team manufacturing</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_WhiskeyTask" name="Order Whiskey Bar" sourceRef="InclusiveGateway_1" targetRef="UserTask_MakeWhiskeyBar">
      <bpmn:description>Irish team manufacturing</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_OtherParts" name="General Parts" sourceRef="InclusiveGateway_1" targetRef="UserTask_PrepOtherParts">
      <bpmn:description>All other components</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Join Flows -->
    <bpmn:sequenceFlow id="Seq_VodkaToJoin" name="Ready" sourceRef="UserTask_MakeVodkaBar" targetRef="InclusiveGateway_2">
      <bpmn:description>Vodka bar complete</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Seq_WhiskeyToJoin" name="Ready" sourceRef="UserTask_MakeWhiskeyBar" targetRef="InclusiveGateway_2">
      <bpmn:description>Whiskey bar complete</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Seq_OtherPartsToJoin" name="Ready" sourceRef="UserTask_PrepOtherParts" targetRef="InclusiveGateway_2">
      <bpmn:description>All parts ready</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Assembly Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_AssembleInterior" name="Start Assembly" sourceRef="InclusiveGateway_2" targetRef="UserTask_AssembleInterior">
      <bpmn:description>All parts received</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Test Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_TestFlightStart" name="Begin Flight" sourceRef="UserTask_AssembleInterior" targetRef="UserTask_TestFlight">
      <bpmn:description>Test flight initiated</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Protocol Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_CreateProtocol" name="Create Report" sourceRef="UserTask_TestFlight" targetRef="UserTask_CreateProtocol">
      <bpmn:description>Test protocol generated</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Distribution Split -->
    <bpmn:sequenceFlow id="SequenceFlow_DistributeProtocols" name="Distribution" sourceRef="UserTask_CreateProtocol" targetRef="InclusiveGateway_3">
      <bpmn:description>Duplicate protocol created</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Internal Report -->
    <bpmn:sequenceFlow id="SequenceFlow_SendInternalReport" name="To Manufacturer" sourceRef="InclusiveGateway_3" targetRef="UserTask_SendInternalReport">
      <bpmn:description>Copy for internal records</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Delivery -->
    <bpmn:sequenceFlow id="SequenceFlow_ShipToCustomer" name="To Customer" sourceRef="InclusiveGateway_3" targetRef="UserTask_DeliverPlane">
      <bpmn:description>Physical delivery</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Confirmation -->
    <bpmn:sequenceFlow id="SequenceFlow_ConfirmationReceived" name="Confirm" sourceRef="InclusiveGateway_3" targetRef="End_Event_1">
      <bpmn:description>All processes complete</bpmn:description>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>