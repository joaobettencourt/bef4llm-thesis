<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_LegoMachine" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1LegoProject">
    <bpmn:participant id="Participant_LegoProcess" name="Custom Machine Construction Process" processRef="Process_LegoMachineConstruction" />
  </bpmn:collaboration>

  <bpmn:process id="Process_LegoMachineConstruction" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_LeadEngineer" name="Lead Engineer">
        <bpmn:flowNodeRef>StartEvent_BeginProject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DevelopDesign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OrderSets</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CheckStock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BuildSubcomponent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TestSubcomponent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_TestResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RedesignRebuild</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssembleMachine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_MachineBuilt</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ChildrenSorters" name="Children Sorters">
        <bpmn:flowNodeRef>Task_SortParts</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_BeginProject" name="Begin Project">
      <bpmn:outgoing>SequenceFlow_DevelopDesign</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Tasks -->
    <bpmn:userTask id="Task_DevelopDesign" name="Develop Basic Design">
      <bpmn:incoming>SequenceFlow_DevelopDesign</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OrderSets</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="Task_OrderSets" name="Order Lego Brick Sets">
      <bpmn:incoming>SequenceFlow_OrderSets</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_HandoverSorters</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="Task_SortParts" name="Sort Parts into Containers">
      <bpmn:incoming>SequenceFlow_HandoverSorters</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckStockInit</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_BuildSubcomponent" name="Build Subcomponent">
      <bpmn:incoming>SequenceFlow_StartBuildLoop</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckStockCheck</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_ReorderIndividualParts" name="Reorder Individual Parts">
      <bpmn:incoming>SequenceFlow_NoStockFound</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ContinueBuildLoop</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_TestSubcomponent" name="Test Subcomponent">
      <bpmn:incoming>SequenceFlow_BuildComplete</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckResult</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_RedesignRebuild" name="Redesign and Rebuild">
      <bpmn:incoming>SequenceFlow_TestFailed</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StartBuildLoopRedesign</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_AssembleMachine" name="Assemble Machine">
      <bpmn:incoming>SequenceFlow_AllTestsPassed</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProjectComplete</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateways -->
    <bpmn:exclusiveGateway id="Gateway_CheckStock" name="Parts Available?">
      <bpmn:incoming>SequenceFlow_StartBuildLoop</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BuildWithStock</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoStockFound</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:exclusiveGateway id="Gateway_TestResult" name="Test Successful?">
      <bpmn:incoming>SequenceFlow_CheckResult</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AllTestsPassed</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_TestFailed</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_MachineBuilt" name="Machine Completed">
      <bpmn:incoming>SequenceFlow_ProjectComplete</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_DevelopDesign" sourceRef="StartEvent_BeginProject" targetRef="Task_DevelopDesign">
      <bpmn:name>Develop Design</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_OrderSets" name="Order Sets" sourceRef="Task_DevelopDesign" targetRef="Task_OrderSets" />

    <!-- Handover to Children Lane -->
    <bpmn:sequenceFlow id="SequenceFlow_HandoverSorters" name="Hand Over Parts" sourceRef="Task_OrderSets" targetRef="Task_SortParts" />

    <!-- Return from Sorters to Engineer for Build Phase -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckStockInit" name="Ready to Build" sourceRef="Task_SortParts" targetRef="Gateway_CheckStock" />

    <!-- Stock Check Logic - Parts Available Path -->
    <bpmn:sequenceFlow id="SequenceFlow_BuildWithStock" name="Yes" sourceRef="Gateway_CheckStock" targetRef="Task_TestSubcomponent">
      <bpmn:name>Parts OK</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Stock Check Logic - No Parts Path -->
    <bpmn:sequenceFlow id="SequenceFlow_NoStockFound" name="No Parts Left" sourceRef="Gateway_CheckStock" targetRef="Task_ReorderIndividualParts">
      <bpmn:name>No Stock</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Reordering Logic -->
    <bpmn:sequenceFlow id="SequenceFlow_ContinueBuildLoop" name="Reordered" sourceRef="Task_ReorderIndividualParts" targetRef="Gateway_CheckStock">
      <bpmn:name>Back to Check</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Build to Test Logic -->
    <bpmn:sequenceFlow id="SequenceFlow_BuildComplete" name="Ready to Test" sourceRef="Task_TestSubcomponent" targetRef="Gateway_CheckStock">
      <bpmn:name>Built Successfully</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Testing Logic -->
    <bpmn:sequenceFlow id="SequenceFlow_StartBuildLoop" name="Start Build Loop" sourceRef="Task_BuildSubcomponent" targetRef="Gateway_CheckStock">
      <bpmn:name>To Stock Check</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Test Result Logic -->
    <bpmn:sequenceFlow id="SequenceFlow_AllTestsPassed" name="Yes - All Passed" sourceRef="Gateway_TestResult" targetRef="Task_AssembleMachine">
      <bpmn:name>All Tests Passed</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Test Failed Path -->
    <bpmn:sequenceFlow id="SequenceFlow_TestFailed" name="No - Redesign Needed" sourceRef="Gateway_TestResult" targetRef="Task_RedesignRebuild">
      <bpmn:name>Test Failed</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Redesign Loop -->
    <bpmn:sequenceFlow id="SequenceFlow_StartBuildLoopRedesign" name="Back to Build" sourceRef="Task_RedesignRebuild" targetRef="Gateway_CheckStock">
      <bpmn:name>To Stock Check</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Assembly and End -->
    <bpmn:sequenceFlow id="SequenceFlow_ProjectComplete" name="Assembled" sourceRef="Task_AssembleMachine" targetRef="EndEvent_MachineBuilt">
      <bpmn:name>Machined Complete</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>