<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_FindJob">
    <bpmn:participant id="Participant_JobSeekerProcess" name="Find a Job Process" processRef="Proc_FindJob_01" />
  </bpmn:collaboration>

  <bpmn:process id="Proc_FindJob_01" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Applicant" name="Applicant (You)">
        <bpmn:flowNodeRef>StartEvent_Report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_InterviewNegotiation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConductInterview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_PermanentJob</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CompanySystem" name="Company / System">
        <bpmn:flowNodeRef>Task_SendOffers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConfirmRateApp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_HiringDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProbationPhase</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RateCompanySystem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CheckRatingScore</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Report" name="Report Job Applications">
      <bpmn:outgoing>Seq_Submit</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Applicant Tasks & Events -->
    <bpmn:userTask id="Task_SubmitReport" name="Submit Application Report">
      <bpmn:incoming>Seq_Submit</bpmn:incoming>
      <bpmn:outgoing>Seq_TriggerOffers</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Company/System Tasks & Events -->
    <bpmn:task id="Task_SendOffers" name="Send Potential Job Offers">
      <bpmn:incoming>Seq_TriggerOffers</bpmn:incoming>
      <bpmn:outgoing>Seq_CompanyFeedbackReq</bpmn:outgoing>
    </bpmn:task>

    <!-- Company Confirmation & Rating -->
    <bpmn:userTask id="Task_ConfirmRateApp" name="Confirm Receipt &amp; Rate Application">
      <bpmn:incoming>Seq_CompanyFeedbackReq</bpmn:incoming>
      <bpmn:outgoing>Seq_NegotiationCheck</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Interview Negotiation -->
    <bpmn:exclusiveGateway id="Gateway_InterviewNegotiation" name="Interview&#10;Negotiated?">
      <bpmn:incoming>Seq_NegotiationCheck</bpmn:incoming>
      <bpmn:outgoing>Seq_ConductInterviewPath</bpmn:outgoing>
      <bpmn:outgoing>Seq_SkipInterviewPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Interview Task -->
    <bpmn:userTask id="Task_ConductInterview" name="Conduct Job Interview">
      <bpmn:incoming>Seq_ConductInterviewPath</bpmn:incoming>
      <bpmn:outgoing>Seq_InterviewToDecision</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Hiring Decision -->
    <bpmn:exclusiveGateway id="Gateway_HiringDecision" name="Company&#10;Wants You?">
      <bpmn:incoming>Seq_SkipInterviewPath</bpmn:incoming>
      <bpmn:incoming>Seq_InterviewToDecision</bpmn:incoming>
      <bpmn:outgoing>Seq_ProbationOffer</bpmn:outgoing>
      <bpmn:outgoing>Seq_RejectPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Probation Phase -->
    <bpmn:userTask id="Task_ProbationPhase" name="Enter Probation&#10;Phase">
      <bpmn:incoming>Seq_ProbationOffer</bpmn:incoming>
      <bpmn:outgoing>Seq_RatingExchange</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Rating Exchange -->
    <bpmn:userTask id="Task_RateCompanySystem" name="Rate Company &amp;&#10;Receive Review">
      <bpmn:incoming>Seq_RatingExchange</bpmn:incoming>
      <bpmn:outgoing>Seq_CheckPermanentStatus</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Permanent Job Check -->
    <bpmn:exclusiveGateway id="Gateway_JobPermanentCheck" name="Job&#10;Permanent?">
      <bpmn:incoming>Seq_CheckPermanentStatus</bpmn:incoming>
      <bpmn:outgoing>Seq_EndProcessPath</bpmn:outgoing>
      <bpmn:outgoing>Seq_RatingCheckLoop</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_PermanentJob" name="Permanent&#10;Employment">
      <bpmn:incoming>Seq_EndProcessPath</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Loop Logic for Rating C or Less -->
    <bpmn:userTask id="Task_StopReporting" name="Stop Reporting&#10;Continue Offers">
      <bpmn:incoming>Seq_RatingCheckLoop</bpmn:incoming>
      <bpmn:outgoing>Seq_LoopOffers</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Seq_Submit" sourceRef="StartEvent_Report" targetRef="Task_SubmitReport" />
    
    <bpmn:sequenceFlow id="Seq_TriggerOffers" name="Based on&#10;Applications" sourceRef="Task_SubmitReport" targetRef="Task_SendOffers" />

    <bpmn:sequenceFlow id="Seq_CompanyFeedbackReq" sourceRef="Task_SendOffers" targetRef="Task_ConfirmRateApp" />
    
    <bpmn:sequenceFlow id="Seq_NegotiationCheck" name="Interview&#10;Needed?" sourceRef="Task_ConfirmRateApp" targetRef="Gateway_InterviewNegotiation" />

    <bpmn:sequenceFlow id="Seq_ConductInterviewPath" name="Yes" sourceRef="Gateway_InterviewNegotiation" targetRef="Task_ConductInterview" />
    
    <bpmn:sequenceFlow id="Seq_SkipInterviewPath" name="No/Pass" sourceRef="Gateway_InterviewNegotiation" targetRef="Gateway_HiringDecision" />

    <bpmn:sequenceFlow id="Seq_InterviewToDecision" sourceRef="Task_ConductInterview" targetRef="Gateway_HiringDecision" />
    
    <bpmn:sequenceFlow id="Seq_ProbationOffer" name="Yes (Hire)" sourceRef="Gateway_HiringDecision" targetRef="Task_ProbationPhase" />

    <!-- Loop back for rejection or end -->
    <bpmn:exclusiveGateway id="Gateway_RejectLoop" name="Reject&#10;or Continue?">
      <bpmn:incoming>Seq_RejectPath</bpmn:incoming>
      <bpmn:outgoing>Seq_LoopOffers</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="Seq_RejectPath" name="No (Reject)" sourceRef="Gateway_HiringDecision" targetRef="Gateway_RejectLoop" />

    <!-- Rating Logic -->
    <bpmn:sequenceFlow id="Seq_RatingExchange" sourceRef="Task_ProbationPhase" targetRef="Task_RateCompanySystem" />

    <!-- Note: Merged Gateway IDs for flow continuity in single process -->
    <bpmn:sequenceFlow id="Seq_CheckPermanentStatus" sourceRef="Task_RateCompanySystem" targetRef="Gateway_JobPermanentCheck" />

    <bpmn:sequenceFlow id="Seq_EndProcessPath" name="Yes (Permanent)" sourceRef="Gateway_JobPermanentCheck" targetRef="EndEvent_PermanentJob" />
    
    <!-- Rating Score Check -->
    <bpmn:exclusiveGateway id="Gateway_RatingScore" name="Rated C&#10;or Less?">
      <bpmn:incoming>Seq_RatingCheckLoop</bpmn:incoming>
      <bpmn:outgoing>Seq_StopReportingPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Loop Back -->
    <bpmn:sequenceFlow id="Seq_LoopOffers" sourceRef="Task_StopReporting" targetRef="Task_SendOffers" />
    
    <bpmn:sequenceFlow id="Seq_RatingCheckLoop" name="No (Not Permanent)" sourceRef="Gateway_JobPermanentCheck" targetRef="Gateway_RatingScore" />

    <!-- Rating C or Less Path -->
    <bpmn:sequenceFlow id="Seq_StopReportingPath" name="Yes (&lt;=C)" sourceRef="Gateway_RatingScore" targetRef="Task_StopReporting" />

  </bpmn:process>
</bpmn:definitions>