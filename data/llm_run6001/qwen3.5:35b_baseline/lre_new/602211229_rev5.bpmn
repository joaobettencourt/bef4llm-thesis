<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_ERICS">
    <bpmn:participant id="Participant_ERICS" name="ERICS Reimbursement Process" processRef="Process_Reimbursement"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Reimbursement" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_RequestReceived" name="Reimbursement Request Received">
      <bpmn:outgoing>SequenceFlow_CreateContact</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Create Contact -->
    <bpmn:task id="Task_CreateContact" name="Create Reimbursement Contact">
      <bpmn:incoming>SequenceFlow_CreateContact</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ChooseBeneficiary</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: Choose Beneficiary -->
    <bpmn:task id="Task_ChooseBeneficiary" name="Choose Beneficiary">
      <bpmn:incoming>SequenceFlow_ChooseBeneficiary</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DeterminePeriod</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3: Determine Period -->
    <bpmn:task id="Task_DeterminePeriod" name="Determine Refund Period / Duration">
      <bpmn:incoming>SequenceFlow_DeterminePeriod</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckCustomerType</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Check Customer Type -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_CustomerType" name="Check Customer Group">
      <bpmn:incoming>SequenceFlow_CheckCustomerType</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_VerbandPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NormalPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Path A: Verband -->
    <bpmn:task id="Task_SelectGroupAssoc" name="Select Customer Group Association">
      <bpmn:incoming>SequenceFlow_VerbandPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeSelection1</bpmn:outgoing>
    </bpmn:task>

    <!-- Path B: Normal -->
    <bpmn:task id="Task_ManualSelect" name="Manually Select Customers">
      <bpmn:incoming>SequenceFlow_NormalPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeSelection2</bpmn:outgoing>
    </bpmn:task>

    <!-- Merge Gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_MergeSelection" name="Merge Selection Paths">
      <bpmn:incoming>SequenceFlow_MergeSelection1</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_MergeSelection2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SetThreshold</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 4: Set Threshold -->
    <bpmn:task id="Task_SetThreshold" name="Set Threshold">
      <bpmn:incoming>SequenceFlow_SetThreshold</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitPeriodEnd</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway for Final Phase -->
    <bpmn:parallelGateway id="ParallelGateway_FinalPhase" name="Start Final Phase">
      <bpmn:incoming>SequenceFlow_WaitPeriodEnd</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PrintCreditNote</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CalculateReimbursement</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Branch 1: Credit Note -->
    <bpmn:task id="Task_PrintCreditNote" name="Print and Send Credit Note">
      <bpmn:incoming>SequenceFlow_PrintCreditNote</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeFinalPhase1</bpmn:outgoing>
    </bpmn:task>

    <!-- Branch 2: Reimbursement Calculation & Payment -->
    <bpmn:task id="Task_CalculateReimbursement" name="Calculate Reimbursement">
      <bpmn:incoming>SequenceFlow_CalculateReimbursement</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PayReimbursement</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2.1: Payment -->
    <bpmn:task id="Task_PayReimbursement" name="Pay Reimbursement">
      <bpmn:incoming>SequenceFlow_PayReimbursement</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeFinalPhase2</bpmn:outgoing>
    </bpmn:task>

    <!-- Merge Final Phase -->
    <bpmn:parallelGateway id="ParallelGateway_EndMerge" name="Converge End Tasks">
      <bpmn:incoming>SequenceFlow_MergeFinalPhase1</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_MergeFinalPhase2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToEndEvent</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_ProcessEnded" name="Process Ended">
      <bpmn:incoming>SequenceFlow_ToEndEvent</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_CreateContact" sourceRef="StartEvent_RequestReceived" targetRef="Task_CreateContact"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ChooseBeneficiary" sourceRef="Task_CreateContact" targetRef="Task_ChooseBeneficiary"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_DeterminePeriod" sourceRef="Task_ChooseBeneficiary" targetRef="Task_DeterminePeriod"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_CheckCustomerType" sourceRef="Task_DeterminePeriod" targetRef="ExclusiveGateway_CustomerType"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_VerbandPath" name="Verband" sourceRef="ExclusiveGateway_CustomerType" targetRef="Task_SelectGroupAssoc"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_NormalPath" name="Normal Subsidiaries" sourceRef="ExclusiveGateway_CustomerType" targetRef="Task_ManualSelect"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_MergeSelection1" sourceRef="Task_SelectGroupAssoc" targetRef="ExclusiveGateway_MergeSelection"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_MergeSelection2" sourceRef="Task_ManualSelect" targetRef="ExclusiveGateway_MergeSelection"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_SetThreshold" name="Set Threshold" sourceRef="ExclusiveGateway_MergeSelection" targetRef="Task_SetThreshold"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_WaitPeriodEnd" name="Wait for Period End" sourceRef="Task_SetThreshold" targetRef="ParallelGateway_FinalPhase"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_PrintCreditNote" name="Print Credit Note" sourceRef="ParallelGateway_FinalPhase" targetRef="Task_PrintCreditNote"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_CalculateReimbursement" name="Calculate Reimbursement" sourceRef="ParallelGateway_FinalPhase" targetRef="Task_CalculateReimbursement"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_PayReimbursement" name="Pay Reimbursement" sourceRef="Task_CalculateReimbursement" targetRef="Task_PayReimbursement"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_MergeFinalPhase1" sourceRef="Task_PrintCreditNote" targetRef="ParallelGateway_EndMerge"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_MergeFinalPhase2" name="Payment Made" sourceRef="Task_PayReimbursement" targetRef="ParallelGateway_EndMerge"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ToEndEvent" name="All Tasks Complete" sourceRef="ParallelGateway_EndMerge" targetRef="EndEvent_ProcessEnded"/>

  </bpmn:process>
</bpmn:definitions>