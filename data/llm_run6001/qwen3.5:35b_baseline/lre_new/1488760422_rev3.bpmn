<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_SSP_Admin" name="SSP Admin Office" processRef="Process_1" />
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_AdminOffice" name="Admin Office">
        <bpmn:name>Admin Office</bpmn:name>
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SortClient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SortVendor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AttachForm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CompleteCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Incomplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterSLAInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_HighPriority</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RedStamp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckCompliance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CompliantCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Allocated1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExperienceStaff</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CallClient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PostalMail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CatchEvent_InfoObtained</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Invoice Received">
      <bpmn:outgoing>SequenceFlow_SortClient</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Tasks -->
    <bpmn:task id="Task_SortClient" name="Sort invoice per client">
      <bpmn:incoming>SequenceFlow_SortClient</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SortVendor</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_SortVendor" name="Sort invoice per vendor">
      <bpmn:incoming>SequenceFlow_SortVendor</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AttachForm</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_AttachForm" name="Attach invoice entry form">
      <bpmn:incoming>SequenceFlow_AttachForm</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EnterInfo</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_EnterInfo" name="Enter required info on form">
      <bpmn:incoming>SequenceFlow_EnterInfo</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckCompleteness</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Completeness Check -->
    <bpmn:exclusiveGateway id="Gateway_CompleteCheck" name="Invoice Complete?">
      <bpmn:incoming>SequenceFlow_CheckCompleteness</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendMsgEnd</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_EnterSLAInfo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event for Incomplete -->
    <bpmn:endEvent id="EndEvent_Incomplete" name="Process Finished">
      <bpmn:incoming>SequenceFlow_SendMsgEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task SLA Info & Priority Check -->
    <bpmn:task id="Task_EnterSLAInfo" name="Enter info for SLA and check priority">
      <bpmn:incoming>SequenceFlow_EnterSLAInfo</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_HighPriorityCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2: High Priority -->
    <bpmn:exclusiveGateway id="Gateway_HighPriority" name="High Priority?">
      <bpmn:incoming>SequenceFlow_HighPriorityCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RedStampTask</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CheckComplianceSkip</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task Red Stamp -->
    <bpmn:task id="Task_RedStamp" name="Apply red stamp on entry invoice">
      <bpmn:incoming>SequenceFlow_RedStampTask</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckComplianceMerge</bpmn:outgoing>
    </bpmn:task>

    <!-- Task Check Compliance -->
    <bpmn:task id="Task_CheckCompliance" name="Check invoice compliance">
      <bpmn:incoming>SequenceFlow_CheckComplianceSkip</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_CheckComplianceMerge</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CompliantCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 3: Compliant Check -->
    <bpmn:exclusiveGateway id="Gateway_CompliantCheck" name="Invoice Complete?">
      <bpmn:incoming>SequenceFlow_CompliantCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AllocateDEO1</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ExperienceStaffPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event Allocated -->
    <bpmn:endEvent id="EndEvent_Allocated1" name="Invoice Allocated">
      <bpmn:incoming>SequenceFlow_AllocateDEO1</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Tasks for Non-Compliance Handling (Admin Choice) -->
    <bpmn:task id="Task_ExperienceStaff" name="Process non-compliance invoice">
      <bpmn:incoming>SequenceFlow_ExperienceStaffPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitInfoMerge1</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_CallClient" name="Call client and request info">
      <bpmn:incoming>SequenceFlow_CallerPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitInfoMerge2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_PostalMail" name="Send postal mail requesting info">
      <bpmn:incoming>SequenceFlow_MailPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitInfoMerge3</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Catch Event for Waiting Info -->
    <bpmn:startEvent id="CatchEvent_InfoObtained" name="Missing Information Obtained">
      <bpmn:incoming>SequenceFlow_WaitInfoMerge1</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_WaitInfoMerge2</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_WaitInfoMerge3</bpmn:incoming>
    </bpmn:startEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_SortClient" sourceRef="StartEvent_1" targetRef="Task_SortClient" />
    <bpmn:sequenceFlow id="SequenceFlow_SortVendor" sourceRef="Task_SortClient" targetRef="Task_SortVendor" />
    <bpmn:sequenceFlow id="SequenceFlow_AttachForm" sourceRef="Task_SortVendor" targetRef="Task_AttachForm" />
    <bpmn:sequenceFlow id="SequenceFlow_EnterInfo" sourceRef="Task_AttachForm" targetRef="Task_EnterInfo" />
    <bpmn:sequenceFlow id="SequenceFlow_CheckCompleteness" sourceRef="Task_EnterInfo" targetRef="Gateway_CompleteCheck" />
    <bpmn:sequenceFlow id="SequenceFlow_SendMsgEnd" name="No - Send message and finish" sourceRef="Gateway_CompleteCheck" targetRef="EndEvent_Incomplete">
      <bpmn:name>Invoice not complete, send message</bpmn:name>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_EnterSLAInfo" name="Yes - Invoice Complete" sourceRef="Gateway_CompleteCheck" targetRef="Task_EnterSLAInfo">
      <bpmn:name>If invoice complete</bpmn:name>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_HighPriorityCheck" sourceRef="Task_EnterSLAInfo" targetRef="Gateway_HighPriority" />
    <bpmn:sequenceFlow id="SequenceFlow_RedStampTask" name="Yes - High Priority" sourceRef="Gateway_HighPriority" targetRef="Task_RedStamp">
      <bpmn:name>If high priority</bpmn:name>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_CheckComplianceSkip" name="No - Skip Red Stamp" sourceRef="Gateway_HighPriority" targetRef="Task_CheckCompliance">
      <bpmn:name>If not high priority</bpmn:name>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_CheckComplianceMerge" sourceRef="Task_RedStamp" targetRef="Task_CheckCompliance" />
    <bpmn:sequenceFlow id="SequenceFlow_CompliantCheck" sourceRef="Task_CheckCompliance" targetRef="Gateway_CompliantCheck" />
    <bpmn:sequenceFlow id="SequenceFlow_AllocateDEO1" name="Yes - Complete" sourceRef="Gateway_CompliantCheck" targetRef="EndEvent_Allocated1">
      <bpmn:name>If invoice complete</bpmn:name>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_ExperienceStaffPath" name="No - Experience Staff" sourceRef="Gateway_CompliantCheck" targetRef="Task_ExperienceStaff">
      <bpmn:name>If not complete</bpmn:name>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_CallerPath" name="No - Call Client" sourceRef="Gateway_CompliantCheck" targetRef="Task_CallClient">
      <bpmn:name>If not complete</bpmn:name>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_MailPath" name="No - Postal Mail" sourceRef="Gateway_CompliantCheck" targetRef="Task_PostalMail">
      <bpmn:name>If not complete</bpmn:name>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_WaitInfoMerge1" sourceRef="Task_ExperienceStaff" targetRef="CatchEvent_InfoObtained" />
    <bpmn:sequenceFlow id="SequenceFlow_WaitInfoMerge2" sourceRef="Task_CallClient" targetRef="CatchEvent_InfoObtained" />
    <bpmn:sequenceFlow id="SequenceFlow_WaitInfoMerge3" sourceRef="Task_PostalMail" targetRef="CatchEvent_InfoObtained" />

  </bpmn:process>
</bpmn:definitions>