<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_AccountCreation">
    <bpmn:participant id="Participant_PayPalSystem" name="PayPal Account Creation Process" processRef="Process_AccountCreation" />
  </bpmn:collaboration>

  <bpmn:process id="Process_AccountCreation" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Client">
        <bpmn:name>Client</bpmn:name>
        <bpmn:flowNodeRef>StartEvent_CreateAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_AccountTypeSelection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DetermineAccountType</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterDetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DeclarePEPAffiliation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitRequest</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System">
        <bpmn:name>PayPal System</bpmn:name>
        <bpmn:flowNodeRef>InclusiveGateway_ValidationDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ValidateInputFields</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyClientErrors</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GenerateWelcomeEmail</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_CreateAccount" name="Create Account Request">
      <bpmn:outgoing>SequenceFlow_DetermineType</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Client Task: Determine Type -->
    <bpmn:task id="Task_DetermineAccountType" name="Determine desired account type">
      <bpmn:incoming>SequenceFlow_DetermineType</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SelectTypeDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Client Gateway: Select Type (Personal vs Premium) -->
    <bpmn:inclusiveGateway id="InclusiveGateway_AccountTypeSelection" name="Select Account Type">
      <bpmn:incoming>SequenceFlow_SelectTypeDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PersonalPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PremiumPath</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Client Tasks for Details -->
    <bpmn:task id="Task_EnterDetails" name="Enter login &amp; personal details">
      <bpmn:incoming>SequenceFlow_DetailsJoin</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DeclarePEP</bpmn:outgoing>
    </bpmn:task>

    <!-- Client Task: Declare PEP -->
    <bpmn:task id="Task_DeclarePEPAffiliation" name="Declare politically exposed person affiliation">
      <bpmn:incoming>SequenceFlow_DeclarePEP</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SubmitRequest</bpmn:outgoing>
    </bpmn:task>

    <!-- Client Task: Submit -->
    <bpmn:task id="Task_SubmitRequest" name="Click create account button">
      <bpmn:incoming>SequenceFlow_SubmitRequest</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SystemValidationTrigger</bpmn:outgoing>
    </bpmn:task>

    <!-- System Task: Validate -->
    <bpmn:task id="Task_ValidateInputFields" name="Validate input fields">
      <bpmn:incoming>SequenceFlow_SystemValidationTrigger</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DecisionValid</bpmn:outgoing>
    </bpmn:task>

    <!-- System Gateway: Validation Decision -->
    <bpmn:exclusiveGateway id="InclusiveGateway_ValidationDecision" name="Fields Valid?">
      <bpmn:incoming>SequenceFlow_DecisionValid</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ValidPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_InvalidPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- System Task: Notify Errors -->
    <bpmn:task id="Task_NotifyClientErrors" name="Notify client of invalid fields">
      <bpmn:incoming>SequenceFlow_InvalidPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ClientCorrectionLoop</bpmn:outgoing>
    </bpmn:task>

    <!-- Client Task: Correct Input -->
    <bpmn:task id="Task_CorrectInput" name="Correct input details">
      <bpmn:incoming>SequenceFlow_ClientCorrectionLoop</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ResubmitTrigger</bpmn:outgoing>
    </bpmn:task>

    <!-- System Task: Generate Email -->
    <bpmn:task id="Task_GenerateWelcomeEmail" name="Generate welcome email">
      <bpmn:incoming>SequenceFlow_ValidPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendEmail</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_AccountCreated" name="Account Created">
      <bpmn:incoming>SequenceFlow_SendEmail</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows for Account Type Selection (Split) -->
    <bpmn:sequenceFlow id="SequenceFlow_DetermineType" name="Determine type" sourceRef="StartEvent_CreateAccount" targetRef="Task_DetermineAccountType">
      <bpmn:name>Determine desired account type</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Sequence Flows for Account Type Selection (Join) -->
    <bpmn:inclusiveGateway id="InclusiveGateway_ValidationLoopJoin" name="Account Details Entry Point">
      <bpmn:incoming>SequenceFlow_PersonalPath</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_PremiumPath</bpmn:incoming>
    </bpmn:inclusiveGateway>

    <!-- Sequence Flows for Account Type Selection (Join) -->
    <bpmn:sequenceFlow id="SequenceFlow_DetailsJoin" name="Proceed to PEP Declaration" sourceRef="InclusiveGateway_ValidationLoopJoin" targetRef="Task_EnterDetails">
      <bpmn:name>Enter details</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Main Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_SelectTypeDecision" name="Select type" sourceRef="Task_DetermineAccountType" targetRef="InclusiveGateway_AccountTypeSelection">
      <bpmn:name>Select account type</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Sequence Flows for Account Type Selection (Join) -->
    <bpmn:sequenceFlow id="SequenceFlow_PersonalPath" name="Personal account" sourceRef="InclusiveGateway_AccountTypeSelection" targetRef="Task_EnterDetails">
      <bpmn:name>Client selects personal</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Sequence Flows for Account Type Selection (Join) -->
    <bpmn:sequenceFlow id="SequenceFlow_PremiumPath" name="Premium account" sourceRef="InclusiveGateway_AccountTypeSelection" targetRef="Task_EnterDetails">
      <bpmn:name>Client selects premium</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Client Lane Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_DeclarePEP" name="Enter details" sourceRef="Task_EnterDetails" targetRef="Task_DeclarePEPAffiliation">
      <bpmn:name>Proceed to PEP Declaration</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Client Lane Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_SubmitRequest" name="Submit" sourceRef="Task_DeclarePEPAffiliation" targetRef="Task_SubmitRequest">
      <bpmn:name>Click create account button</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Cross Lane Flow to System -->
    <bpmn:sequenceFlow id="SequenceFlow_SystemValidationTrigger" name="Send Request" sourceRef="Task_SubmitRequest" targetRef="Task_ValidateInputFields">
      <bpmn:name>Details sent to system</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- System Lane Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_DecisionValid" name="Check Validity" sourceRef="Task_ValidateInputFields" targetRef="InclusiveGateway_ValidationDecision">
      <bpmn:name>Initiate validation decision</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- System Lane Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_ValidPath" name="Valid Fields" sourceRef="InclusiveGateway_ValidationDecision" targetRef="Task_GenerateWelcomeEmail">
      <bpmn:name>If valid</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- System Lane Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_InvalidPath" name="Invalid Fields" sourceRef="InclusiveGateway_ValidationDecision" targetRef="Task_NotifyClientErrors">
      <bpmn:name>If invalid</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Cross Lane Flow Back to Client -->
    <bpmn:sequenceFlow id="SequenceFlow_ClientCorrectionLoop" name="Notify &amp; Correct" sourceRef="Task_NotifyClientErrors" targetRef="Task_CorrectInput">
      <bpmn:name>Notification sent</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Correction Loop Back to Validation -->
    <bpmn:sequenceFlow id="SequenceFlow_ResubmitTrigger" name="Resubmit for validation" sourceRef="Task_CorrectInput" targetRef="InclusiveGateway_ValidationDecision">
      <bpmn:name>Corrected details resubmitted</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Final Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_SendEmail" name="Email Sent" sourceRef="Task_GenerateWelcomeEmail" targetRef="EndEvent_AccountCreated">
      <bpmn:name>Welcome email sent</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>