<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                 xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" 
                 xmlns:di="http://www.omg.org/spec/DD/20100524/DI" 
                 xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" 
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:collaboration id="Collaboration_EmployeePerformance">
    <bpmn:participant id="Participant_Process" name="Employee Performance Management Process" processRef="Process_PerformanceManagement"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_PerformanceManagement" isExecutable="false">
    
    <!-- Lane Set for Departments -->
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Management" name="Management"/>
      
      <bpmn:lane id="Lane_HR" name="Human Resources Department"/>

      <bpmn:lane id="Lane_Finance" name="Finance Department"/>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_PerformanceCheck" name="Performance Check">
      <bpmn:outgoing>SequenceFlow_CheckPerformance</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task for Management to check performance -->
    <bpmn:task id="Task_ManagementChecksPerformance" name="Check Employee Performance">
      <bpmn:incoming>SequenceFlow_CheckPerformance</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GatewayDecision1</bpmn:outgoing>
    </bpmn:task>

    <!-- Decision Gateway 1 - Check if performance less than 20% -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_PerformanceCheck" name="Performance &lt; 20%">
      <bpmn:incoming>SequenceFlow_GatewayDecision1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DismissalPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_TrainingOrRewardPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Decision Gateway 2 - Check if performance less