<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Data Validation Error Handling Process" processRef="Process_1" />
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_System">
        <bpmn:name>System</bpmn:name>
        <bpmn:flowNodeRef>StartEvent_DataValidationErrorNotification</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Technicians">
        <bpmn:name>Tech Support Team</bpmn:name>
        <bpmn:flowNodeRef>InclusiveGateway_1TypoCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_2CustomerCorrection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckTypos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CustomerCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ScourSources</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_IssueResolved</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_DataValidationErrorNotification" name="Data Validation Error Notification">
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Check Typos -->
    <bpmn:task id="Task_CheckTypos" name="Check for Typos">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TypoDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Is Typo Found? -->
    <bpmn:exclusiveGateway id="InclusiveGateway_1TypoCheck" name="Is Typo Found?">
      <bpmn:incoming>SequenceFlow_TypoDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ResolvedPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CustomerCheckPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Gateway 2: Can Customer Correct? -->
    <bpmn:inclusiveGateway id="InclusiveGateway_2CustomerCorrection" name="Can Customer Correct?">
      <bpmn:incoming>SequenceFlow_CustomerCheckPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ResolvedPath2</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ScourSourcesPath</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Task 2: Check Customer Correction -->
    <bpmn:task id="Task_CustomerCheck" name="Check if Customer Can Correct">
      <bpmn:incoming>SequenceFlow_TypoNoPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CustomerDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3: Scour Public Sources -->
    <bpmn:task id="Task_ScourSources" name="Scour Public Sources for Solutions">
      <bpmn:incoming>SequenceFlow_ScourPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ResolvedFinal</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_IssueResolved" name="Issue Resolved">
      <bpmn:incoming>SequenceFlow_ResolvedPath</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ResolvedPath2</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ResolvedFinal</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_1" name="Data Validation Error Notification" sourceRef="StartEvent_DataValidationErrorNotification" targetRef="Task_CheckTypos">
      <bpmn:name>Data Validation Error Notification</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Gateway 1 Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_TypoDecision" name="Typos Checked" sourceRef="Task_CheckTypos" targetRef="InclusiveGateway_1TypoCheck">
      <bpmn:name>Typos Checked</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Gateway 2 Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_CustomerDecision" name="Capability Checked" sourceRef="Task_CustomerCheck" targetRef="InclusiveGateway_2CustomerCorrection">
      <bpmn:name>Capability Checked</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Resolved Paths -->
    <bpmn:sequenceFlow id="SequenceFlow_ResolvedPath" name="If Typo Found" sourceRef="InclusiveGateway_1TypoCheck" targetRef="EndEvent_IssueResolved">
      <bpmn:name>If Typo Found</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Next Step Path -->
    <bpmn:sequenceFlow id="SequenceFlow_TypoNoPath" name="If Not Typo" sourceRef="InclusiveGateway_1TypoCheck" targetRef="Task_CustomerCheck">
      <bpmn:name>If Not Typo</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Gateway 2 Resolved Path -->
    <bpmn:sequenceFlow id="SequenceFlow_ResolvedPath2" name="If Customer Can Correct" sourceRef="InclusiveGateway_2CustomerCorrection" targetRef="EndEvent_IssueResolved">
      <bpmn:name>If Customer Can Correct</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Scour Path -->
    <bpmn:sequenceFlow id="SequenceFlow_ScourPath" name="If Customer Cannot Correct" sourceRef="InclusiveGateway_2CustomerCorrection" targetRef="Task_ScourSources">
      <bpmn:name>If Customer Cannot Correct</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Final Resolved Path -->
    <bpmn:sequenceFlow id="SequenceFlow_ResolvedFinal" name="Solution Found" sourceRef="Task_ScourSources" targetRef="EndEvent_IssueResolved">
      <bpmn:name>Solution Found</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>