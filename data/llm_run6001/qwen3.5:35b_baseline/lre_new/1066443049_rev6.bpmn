<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_WebDesignProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Website Development Process" processRef="Process_1" />
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_DesignTeam" name="Web Design Team">
        <bpmn:name>Web Design Team</bpmn:name>
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HoldMeeting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_MeetingSuccess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_FailedProcess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateStoryboard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_AgreementReached</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelSplit_DesignContent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DesignAndDev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_ReviewNeeded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelJoin_BuildStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateFinalVersionContent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_SiteApproved</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_MarketingTeam" name="Marketing Team">
        <bpmn:name>Marketing Team</bpmn:name>
        <bpmn:flowNodeRef>Task_MarketingReviewDraft</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Informational Meeting">
      <bpmn:outgoing>SequenceFlow_HoldMeeting</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Hold Informational Meeting -->
    <bpmn:task id="Task_HoldMeeting" name="Hold informational meeting">
      <bpmn:incoming>SequenceFlow_HoldMeeting</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MeetingSuccessCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Meeting Successful? -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_MeetingSuccess" name="Meeting successful?">
      <bpmn:incoming>SequenceFlow_MeetingSuccessCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProcessEnded</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CreateStoryboard</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event 1: Process Ended (Meeting Failed) -->
    <bpmn:endEvent id="EndEvent_FailedProcess" name="Process ended">
      <bpmn:incoming>SequenceFlow_ProcessEnded</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task 2: Create Storyboard -->
    <bpmn:task id="Task_CreateStoryboard" name="Create storyboard">
      <bpmn:incoming>SequenceFlow_CreateStoryboard</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AgreementCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2: Agreement Reached? -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_AgreementReached" name="Storyboard agreement reached?">
      <bpmn:incoming>SequenceFlow_AgreementCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StoryLoopBack</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SplitDesignContent</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Parallel Split -->
    <bpmn:parallelGateway id="ParallelSplit_DesignContent" name="Simultaneous Work">
      <bpmn:incoming>SequenceFlow_SplitDesignContent</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StartDesignDev</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_StartDraftPrep</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Branch 1: Design & Development -->
    <bpmn:task id="Task_DesignAndDev" name="Design and develop website">
      <bpmn:incoming>SequenceFlow_StartDesignDev</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DevCompleteToJoin</bpmn:outgoing>
    </bpmn:task>

    <!-- Branch 2: Content Preparation -->
    <bpmn:task id="Task_PrepareDraft" name="Prepare initial content draft">
      <bpmn:incoming>SequenceFlow_StartDraftPrep</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckReviewNeeded</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 3: Review Needed? -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_ReviewNeeded" name="Review needed?">
      <bpmn:incoming>SequenceFlow_CheckReviewNeeded</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MarketingReviewPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SkipToFinalVersion</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 3 (Marketing Lane): Review Draft -->
    <bpmn:task id="Task_MarketingReviewDraft" name="Conduct review of draft">
      <bpmn:incoming>SequenceFlow_MarketingReviewPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReviewToFinalVersion</bpmn:outgoing>
    </bpmn:task>

    <!-- Merge Review Paths -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_MergeContent" name="Merge Content Path">
      <bpmn:incoming>SequenceFlow_SkipToFinalVersion</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ReviewToFinalVersion</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CreateFinalContent</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 4 (Web Team): Final Content Version -->
    <bpmn:task id="Task_CreateFinalVersionContent" name="Create final version of content">
      <bpmn:incoming>SequenceFlow_CreateFinalContent</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ContentCompleteToJoin</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Join -->
    <bpmn:parallelGateway id="ParallelJoin_BuildStart" name="Wait for Completion">
      <bpmn:incoming>SequenceFlow_DevCompleteToJoin</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ContentCompleteToJoin</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StartBuildReview</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 5: Build and Review Website -->
    <bpmn:task id="Task_BuildAndReview" name="Build and review website">
      <bpmn:incoming>SequenceFlow_StartBuildReview</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckApproval</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 4: Site Approved? -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_SiteApproved" name="Site approved?">
      <bpmn:incoming>SequenceFlow_CheckApproval</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProcessCompleted</bpmn:outgoing>
      <bpmn:outgoing>SequenceLoop_BackToBuild</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event 2: Completed -->
    <bpmn:endEvent id="EndEvent_Success" name="Process completed">
      <bpmn:incoming>SequenceFlow_ProcessCompleted</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows Definitions -->
    <bpmn:sequenceFlow id="SequenceFlow_HoldMeeting" sourceRef="StartEvent_1" targetRef="Task_HoldMeeting">
      <bpmn:name>Process starts</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_MeetingSuccessCheck" name="Not successful?" sourceRef="Task_HoldMeeting" targetRef="ExclusiveGateway_MeetingSuccess">
      <!-- Logic handled by gateway outgoing -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ProcessEnded" name="No - End Process" sourceRef="ExclusiveGateway_MeetingSuccess" targetRef="EndEvent_FailedProcess">
       <bpmn:name>If not successful</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_CreateStoryboard" name="Yes - Continue" sourceRef="ExclusiveGateway_MeetingSuccess" targetRef="Task_CreateStoryboard">
      <!-- Logic handled by gateway outgoing -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_AgreementCheck" sourceRef="Task_CreateStoryboard" targetRef="ExclusiveGateway_AgreementReached">
       <bpmn:name>After creation</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_SplitDesignContent" name="Agreement Reached" sourceRef="ExclusiveGateway_AgreementReached" targetRef="ParallelSplit_DesignContent">
       <!-- Logic handled by gateway outgoing -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_StartDesignDev" sourceRef="ParallelSplit_DesignContent" targetRef="Task_DesignAndDev">
      <bpmn:name>To Design</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_StartDraftPrep" sourceRef="ParallelSplit_DesignContent" targetRef="Task_PrepareDraft">
       <bpmn:name>To Content Prep</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_CheckReviewNeeded" name="After Draft" sourceRef="Task_PrepareDraft" targetRef="ExclusiveGateway_ReviewNeeded">
       <!-- Logic handled by gateway outgoing -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_MarketingReviewPath" name="Yes - Review Needed" sourceRef="ExclusiveGateway_ReviewNeeded" targetRef="Task_MarketingReviewDraft">
       <!-- Logic handled by gateway outgoing -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_SkipToFinalVersion" name="No - Skip Review" sourceRef="ExclusiveGateway_ReviewNeeded" targetRef="ExclusiveGateway_MergeContent">
       <!-- Logic handled by gateway outgoing -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ReviewToFinalVersion" name="After Marketing Review" sourceRef="Task_MarketingReviewDraft" targetRef="ExclusiveGateway_MergeContent">
       <!-- Logic handled by gateway outgoing -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_CreateFinalContent" sourceRef="ExclusiveGateway_MergeContent" targetRef="Task_CreateFinalVersionContent">
      <bpmn:name>Merged Paths</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_DevCompleteToJoin" name="Design Done" sourceRef="Task_DesignAndDev" targetRef="ParallelJoin_BuildStart">
      <!-- Logic handled by gateway incoming -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ContentCompleteToJoin" name="Content Done" sourceRef="Task_CreateFinalVersionContent" targetRef="ParallelJoin_BuildStart">
       <!-- Logic handled by gateway incoming -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_StartBuildReview" sourceRef="ParallelJoin_BuildStart" targetRef="Task_BuildAndReview">
      <bpmn:name>All Complete</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_CheckApproval" name="After Build/Review" sourceRef="Task_BuildAndReview" targetRef="ExclusiveGateway_SiteApproved">
       <!-- Logic handled by gateway outgoing -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceLoop_BackToBuild" name="No - Rebuild" sourceRef="ExclusiveGateway_SiteApproved" targetRef="Task_BuildAndReview">
      <bpmn:name>If not approved</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ProcessCompleted" name="Yes - Approved" sourceRef="ExclusiveGateway_SiteApproved" targetRef="EndEvent_Success">
      <!-- Logic handled by gateway outgoing -->
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>