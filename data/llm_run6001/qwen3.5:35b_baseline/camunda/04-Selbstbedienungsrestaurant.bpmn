<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_001">
    <bpmn:participant id="Participant_Restaurant" name="Restaurant Service Process" processRef="Process_001"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_001" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Guest" name="Gast">
        <bpmn:flowNodeRef>StartEvent_Arrival</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ChooseDish</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Staff" name="Angestellte">
        <bpmn:flowNodeRef>Task_OrderCashier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SetPager</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformCook</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RingPager</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WaitPickup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BoundaryTimer_01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CallGuest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CheckResponse</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Kitchen" name="Koch">
        <bpmn:flowNodeRef>Task_PrepareMeal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PlaceInWindow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyStaffReady</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Events -->
    <bpmn:startEvent id="StartEvent_Arrival" name="Gast betritt Restaurant">
      <bpmn:outgoing>SequenceFlow_ChooseDish</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:endEvent id="EndEvent_EatFood" name="Mahlzeit verzehrt">
      <bpmn:incoming>SequenceFlow_HandOverFood</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Boundary Timer Event (Interrupting) -->
    <bpmn:startEvent id="BoundaryTimer_01" name="5 Minuten Timeout" cancelActivity="true">
      <bpmn:outgoing>SequenceFlow_TriggerCallGuest</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Tasks -->
    <bpmn:task id="Task_ChooseDish" name="Gericht auswählen &amp; warten">
      <bpmn:incoming>SequenceFlow_ChooseDish</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OrderCashier</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_OrderCashier" name="Bestellung aufgeben &amp; kassieren">
      <bpmn:incoming>SequenceFlow_OrderCashier</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SetPager</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_SetPager" name="Pieper einstellen &amp; übergeben">
      <bpmn:incoming>SequenceFlow_SetPager</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InformCook</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_InformCook" name="Koch über Mahlzeit informieren">
      <bpmn:incoming>SequenceFlow_InformCook</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PrepareMeal</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_PrepareMeal" name="Mahlzeit zubereiten">
      <bpmn:incoming>SequenceFlow_PrepareMeal</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PlaceInWindow</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_PlaceInWindow" name="Essen in Durchreiche stellen">
      <bpmn:incoming>SequenceFlow_PlaceInWindow</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NotifyStaffReady</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_NotifyStaffReady" name="Angestellten informieren">
      <bpmn:incoming>SequenceFlow_NotifyStaffReady</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RingPager</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_RingPager" name="Pieper auslösen">
      <bpmn:incoming>SequenceFlow_NotifyStaffReady</bpmn:incoming> <!-- Corrected sourceRef -->
      <bpmn:outgoing>SequenceFlow_WaitPickup</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_WaitPickup" name="Auf Gast an Ausgabe warten">
      <bpmn:incoming>SequenceFlow_RingPager</bpmn:incoming> <!-- Corrected sourceRef -->
      <bpmn:outgoing>SequenceFlow_CheckResponseLoop</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_CallGuest" name="Gast nach 5 Minuten rufen">
      <bpmn:incoming>SequenceFlow_TriggerCallGuest</bpmn:incoming> <!-- Corrected sourceRef -->
      <bpmn:outgoing>SequenceFlow_CheckResponseLoop2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_CheckResponse" name="Reagiert Gast?">
      <bpmn:incoming>SequenceFlow_WaitPickup</bpmn:incoming> <!-- Normal flow -->
      <bpmn:incoming>SequenceFlow_CallGuestLoop2</bpmn:incoming> <!-- Exception path -->
      <bpmn:outgoing>SequenceFlow_HandOverFood</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_ChooseDish" sourceRef="StartEvent_Arrival" targetRef="Task_ChooseDish"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_OrderCashier" name="Bestellung aufgeben &amp; kassieren" sourceRef="Task_ChooseDish" targetRef="Task_OrderCashier"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_SetPager" name="Pieper einstellen" sourceRef="Task_OrderCashier" targetRef="Task_SetPager"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_InformCook" name="Koch informieren" sourceRef="Task_SetPager" targetRef="Task_InformCook"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_PrepareMeal" name="Mahlzeit zubereiten" sourceRef="Task_InformCook" targetRef="Task_PrepareMeal"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_PlaceInWindow" name="Essen in Durchreiche stellen" sourceRef="Task_PrepareMeal" targetRef="Task_PlaceInWindow"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_NotifyStaffReady" name="Angestellten informieren" sourceRef="Task_PlaceInWindow" targetRef="Task_NotifyStaffReady"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_RingPager" name="Pieper auslösen" sourceRef="Task_NotifyStaffReady" targetRef="Task_RingPager"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_WaitPickup" name="Auf Gast warten" sourceRef="Task_RingPager" targetRef="Task_WaitPickup"/>
    
    <!-- Boundary Timer Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_TriggerCallGuest" sourceRef="BoundaryTimer_01" targetRef="Task_CallGuest"/>
    
    <!-- Wait Loop to Gateway (Normal) -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckResponseLoop" name="Gast reagiert?" sourceRef="Task_WaitPickup" targetRef="Gateway_CheckResponse">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${guestArrived}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Call Guest Loop to Gateway -->
    <bpmn:sequenceFlow id="SequenceFlow_CallGuestLoop2" name="Gast reagiert?" sourceRef="Task_CallGuest" targetRef="Gateway_CheckResponse">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${guestArrived}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Final Handover -->
    <bpmn:sequenceFlow id="SequenceFlow_HandOverFood" name="Essen übergeben &amp; verzehren" sourceRef="Gateway_CheckResponse" targetRef="EndEvent_EatFood"/>

  </bpmn:process>
</bpmn:definitions>