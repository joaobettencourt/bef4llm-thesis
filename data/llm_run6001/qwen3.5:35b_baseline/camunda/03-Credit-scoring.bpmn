<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_001">
    <bpmn:participant id="Participant_Bank" name="Banking System (Clerk)" processRef="Process_Bank"/>
    <bpmn:participant id="Participant_Agency" name="Credit Protection Agency" processRef="Process_Agency"/>

    <!-- Message Flows -->
    <bpmn:messageFlow id="MessageFlow_Request" sourceRef="Task_SendRequest" targetRef="StartEvent_ReceiveRequest">
      <bpmn:extensionElements>
        <bpmn:outgoing xsi:type="bpmn:bpmndi:BPMNEdge"/> <!-- Placeholder for DI if needed, but omitted per instructions -->
      </bpmn:extensionElements>
    </bpmn:messageFlow>

    <bpmn:messageFlow id="MessageFlow_Delay" sourceRef="Task_SendDelayNotification" targetRef="IntermediateCatchEvent_Delay">
       <bpmn:outgoing xsi:type="bpmn:bpmndi:BPMNEdge"/> 
    </bpmn:messageFlow>

    <bpmn:messageFlow id="MessageFlow_Result" sourceRef="Task_SendResult" targetRef="IntermediateCatchEvent_Result">
      <bpmn:outgoing xsi:type="bpmn:bpmndi:BPMNEdge"/>
    </bpmn:messageFlow>

  </bpmn:collaboration>

  <!-- Bank Process -->
  <bpmn:process id="Process_Bank" isExecutable="false">
    
    <bpmn:startEvent id="StartEvent_InitiateRequest" name="Initiate Credit Check">
      <bpmn:outgoing>SequenceFlow_SendReq</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_SendRequest" name="Send Scoring Request to Agency">
      <bpmn:incoming>SequenceFlow_SendReq</bpmn:incomming> <!-- Fixed typo -->
      <bpmn:outgoing>SequenceFlow_SplitWait</bpmn:outgoing>
    </bpmn:task>

    <bpmn:parallelGateway id="ParallelGateway_Wait" name="Await Response">
       <bpmn:incoming>SequenceFlow_SplitWait</bpmn:incomming> <!-- Fixed typo -->
      <bpmn:outgoing>SequenceFlow_WaitForDelay</bpmn:outgoing> 
      <bpmn:outgoing>SequenceFlow_WaitForResult</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_Delay" name="Receive Delay Notification">
       <!-- MessageRef is usually defined on the flow or event, here linked via messageFlow target -->
      <bpmn:messageRef>Msg_DelayNotification</bpmn:messageRef> 
      <bpmn:incoming>SequenceFlow_WaitForDelay</bpmn:incomming> <!-- Fixed typo -->
      <bpmn:outgoing>SequenceFlow_DisplayInfo</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:task id="Task_DisplayDelay" name="Display Delay Info to Clerk">
       <bpmn:incoming>SequenceFlow_DisplayInfo</bpmn:incomming> <!-- Fixed typo -->
      <bpmn:outgoing>SequenceFlow_MergeEnd1</bpmn:outgoing>
    </bpmn:task>

    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_Result" name="Receive Scoring Result">
       <bpmn:messageRef>Msg_ScoringResult</bpmn:messageRef> 
      <bpmn:incoming>SequenceFlow_WaitForResult</bpmn:incomming> <!-- Fixed typo -->
      <bpmn:outgoing>SequenceFlow_DisplayFinal</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:task id="Task_PresentResult" name="Present Result to Clerk">
       <bpmn:incoming>SequenceFlow_DisplayFinal</bpmn:incomming> <!-- Fixed typo -->
      <bpmn:outgoing>SequenceFlow_MergeEnd2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:parallelGateway id="ParallelGateway_Join" name="Join Paths">
       <bpmn:incoming>SequenceFlow_MergeEnd1</bpmn:incomming> <!-- Fixed typo -->
      <bpmn:incoming>SequenceFlow_MergeEnd2</bpmn:incomming> <!-- Fixed typo --> 
      <bpmn:outgoing>SequenceFlow_ToEndEvent</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:endEvent id="EndEvent_Completed" name="Process Completed">
       <bpmn:incoming>SequenceFlow_ToEndEvent</bpmn:incomming> <!-- Fixed typo --> 
    </bpmn:endEvent>

  </bpmn:process>

  <!-- Agency Process -->
  <bpmn:process id="Process_Agency" isExecutable="false">
    
    <bpmn:startEvent id="StartEvent_ReceiveRequest" name="Receive Request">
      <bpmn:messageRef>Msg_CreditScoringRequest</bpmn:messageRef> 
      <bpmn:outgoing>SequenceFlow_StartL1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_Level1Scoring" name="Perform Level 1 Scoring">
       <bpmn:incoming>SequenceFlow_StartL1</bpmn:incomming> <!-- Fixed typo -->
      <bpmn:outgoing>SequenceFlow_GatewayDecision</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="ExclusiveGateway_Immediate" name="Result Immediate?">
       <bpmn:incoming>SequenceFlow_GatewayDecision</bpmn:incomming> <!-- Fixed typo --> 
      <bpmn:outgoing>SequenceFlow_PathYes</bpmn:outgoing> <!-- Yes -->
      <bpmn:outgoing>SequenceFlow_PathNo</bpmn:outgoing>  <!-- No (Delay) -->
    </bpmn:exclusiveGateway>

    <!-- Path Immediate Result -->
    <bpmn:task id="Task_SendResult" name="Send Scoring Result">
       <bpmn:messageRef>Msg_ScoringResult</bpmn:messageRef> 
      <bpmn:incoming>SequenceFlow_PathYes</bpmn:incomming> <!-- Fixed typo -->
      <bpmn:outgoing>SequenceFlow_EndImmediate</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_Immediate" name="Completed (Fast)">
       <bpmn:incoming>SequenceFlow_EndImmediate</bpmn:incomming> <!-- Fixed typo --> 
    </bpmn:endEvent>

    <!-- Path Delay -->
    <bpmn:task id="Task_SendDelayNotification" name="Send Delay Notification">
      <bpmn:messageRef>Msg_DelayNotification</bpmn:messageRef> 
       <bpmn:incoming>SequenceFlow_PathNo</bpmn:incomming> <!-- Fixed typo -->
      <bpmn:outgoing>SequenceFlow_StartL2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_Level2Scoring" name="Perform Level 2 Scoring">
       <bpmn:incoming>SequenceFlow_StartL2</bpmn:incomming> <!-- Fixed typo --> 
      <bpmn:outgoing>SequenceFlow_SendFinalResult</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_Delayed" name="Completed (Slow)">
       <bpmn:incoming>SequenceFlow_EndDelayed</bpmn:incomming> <!-- Fixed typo --> 
    </bpmn:endEvent>

  </bpmn:process>

  <!-- Global Messages -->
  <bpmn:message id="Msg_CreditScoringRequest" name="Credit Scoring Request"/>
  <bpmn:message id="Msg_DelayNotification" name="Delay Notification"/>
  <bpmn:message id="Msg_ScoringResult" name="Scoring Result"/>

</bpmn:definitions>