<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Customer logs in">
      <bpmn:outgoing>SequenceFlow_ID_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="SequenceFlow_ID_1" sourceRef="StartEvent_1" targetRef="ServiceTask_1"/>
    <bpmn:serviceTask id="ServiceTask_1" name="Check login credentials">
      <bpmn:incoming>SequenceFlow_ID_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ID_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="SequenceFlow_ID_2" sourceRef="ServiceTask_1" targetRef="ExclusiveGateway_1"/>
    <bpmn:exclusiveGateway id="ExclusiveGateway_1" name="Login successful?">
      <bpmn:incoming>SequenceFlow_ID_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ID_3</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ID_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="SequenceFlow_ID_3" sourceRef="ExclusiveGateway_1" targetRef="ServiceTask_2"/>
    <bpmn:serviceTask id="ServiceTask_2" name="Select products">
      <bpmn:incoming>SequenceFlow_ID_3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ID_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="SequenceFlow_ID_4" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_1"/>
    <bpmn:endEvent id="EndEvent_1" name="Login failed">
      <bpmn:incoming>SequenceFlow_ID_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow_ID_5" sourceRef="ServiceTask_2" targetRef="ExclusiveGateway_2"/>
    <bpmn:exclusiveGateway id="ExclusiveGateway_2" name="All products selected?">
      <bpmn:incoming>SequenceFlow_ID_5</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ID_6</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ID_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="SequenceFlow_ID_6" sourceRef="ExclusiveGateway_2" targetRef="ServiceTask_3"/>
    <bpmn:serviceTask id="ServiceTask_3" name="Add products to cart">
      <bpmn:incoming>SequenceFlow_ID_6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ID_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="SequenceFlow_ID_7" sourceRef="ExclusiveGateway_2" targetRef="EndEvent_1"/>
    <bpmn:endEvent id="EndEvent_2" name="Order finished">
      <bpmn:incoming>SequenceFlow_ID_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow_ID_8" sourceRef="ServiceTask_3" targetRef="ExclusiveGateway_3"/>
    <bpmn:exclusiveGateway id="ExclusiveGateway_3" name="Payment and shipment prepared?">
      <bpmn:incoming>SequenceFlow_ID_8</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ID_9</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ID_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="SequenceFlow_ID_9" sourceRef="ExclusiveGateway_3" targetRef="ServiceTask_4"/>
    <bpmn:serviceTask id="ServiceTask_4" name="Enter payment data">
      <bpmn:incoming>SequenceFlow_ID_9</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ID_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="SequenceFlow_ID_10" sourceRef="ExclusiveGateway_3" targetRef="ServiceTask_5"/>
    <bpmn:serviceTask id="ServiceTask_5" name="Enter shipping address">
      <bpmn:incoming>SequenceFlow_ID_10</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ID_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="SequenceFlow_ID_11" sourceRef="ServiceTask_4" targetRef="ExclusiveGateway_4"/>
    <bpmn:exclusiveGateway id="ExclusiveGateway_4" name="Payment confirmed?">
      <bpmn:incoming>SequenceFlow_ID_11</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ID_13</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ID_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="SequenceFlow_ID_12" sourceRef="ServiceTask_5" targetRef="ExclusiveGateway_4"/>
    <bpmn:sequenceFlow id="SequenceFlow_ID_13" sourceRef="ExclusiveGateway_4" targetRef="EndEvent_2"/>
    <bpmn:endEvent id="EndEvent_3" name="Order shipped">
      <bpmn:incoming>SequenceFlow_ID_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow_ID_14" sourceRef="ExclusiveGateway_4" targetRef="EndEvent_2"/>
  </bpmn:process>
</bpmn:definitions>