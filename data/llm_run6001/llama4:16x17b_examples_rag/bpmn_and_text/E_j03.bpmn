<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definition" name="Work Accident Process">

   <process id="workAccidentProcess" isExecutable="true">
     <startEvent id="startEvent1" name="Start Work Accident Process">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <userTask id="reportAccidentTask" name="Report Work Accident"
              implementation="##WebService">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="reportAccidentTask"/>

     <exclusiveGateway id="checkInsuranceTypeGateway"
                      name="Check Insurance Type">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
       <outgoing>sequenceFlow4</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow2" sourceRef="reportAccidentTask" targetRef="checkInsuranceTypeGateway"/>

     <userTask id="processWorkAccidentForInsuredTask"
              name="Process Work Accident For Insured">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow5</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow3" sourceRef="checkInsuranceTypeGateway" targetRef="processWorkAccidentForInsuredTask">

     </sequenceFlow>

     <userTask id="processWorkAccidentForUninsuredTask"
              name="Process Work Accident For Uninsured">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow6</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow4" sourceRef="checkInsuranceTypeGateway" targetRef="processWorkAccidentForUninsuredTask">

    </sequenceFlow>

     <serviceTask id="notifyLabourInspectorServiceTask"
                 name="Notify Labour Inspector">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow7</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlow5" sourceRef="processWorkAccidentForInsuredTask" targetRef="notifyLabourInspectorServiceTask"/>

     <endEvent id="workAccidentHandledEndEvent"
              name="Work Accident Handled">
       <incoming>sequenceFlow7</incoming>
       <incoming>sequenceFlow6</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow6" sourceRef="processWorkAccidentForUninsuredTask" targetRef="workAccidentHandledEndEvent"/>
     <sequenceFlow id="sequenceFlow7" sourceRef="notifyLabourInspectorServiceTask" targetRef="workAccidentHandledEndEvent"/>

   </process>
</definitions>