<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/BPMN20.xsd"
             id="definition" name="BPMN Process Model" targetNamespace="http://example.com/bpmn">
   <process id="legoMachineProcess" isExecutable="true">

     <startEvent id="startDesign1" name="Develop Basic Design">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <task id="orderLegoSets1" name="Order Lego Brick Sets">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow1" sourceRef="startDesign1" targetRef="orderLegoSets1"/>

     <serviceTask id="sortLegoParts1" name="Sort Lego Parts">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlow2" sourceRef="orderLegoSets1" targetRef="sortLegoParts1"/>

     <parallelGateway id="buildSubcomponents1" name="">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow4</outgoing>
       <outgoing>sequenceFlow5</outgoing>
     </parallelGateway>

     <sequenceFlow id="sequenceFlow3" sourceRef="sortLegoParts1" targetRef="buildSubcomponents1"/>

     <task id="buildSubcomponent11" name="Build Subcomponent 1">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow6</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow4" sourceRef="buildSubcomponents1" targetRef="buildSubcomponent11"/>

     <exclusiveGateway id="testSubcomponent11" name="Test Subcomponent 1 Successful?">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow7</outgoing>
       <outgoing>sequenceFlow8</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow6" sourceRef="buildSubcomponent11" targetRef="testSubcomponent11"/>

     <task id="redesignSubcomponent11" name="Redesign Subcomponent 1">
       <incoming>sequenceFlow8</incoming>
       <outgoing>sequenceFlow9</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow8" sourceRef="testSubcomponent11" targetRef="redesignSubcomponent11"/>

     <task id="buildSubcomponent21" name="Build Subcomponent 2">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow10</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow5" sourceRef="buildSubcomponents1" targetRef="buildSubcomponent21"/>

     <exclusiveGateway id="testSubcomponent21" name="Test Subcomponent 2 Successful?">
       <incoming>sequenceFlow10</incoming>
       <outgoing>sequenceFlow11</outgoing>
       <outgoing>sequenceFlow12</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow10" sourceRef="buildSubcomponent21" targetRef="testSubcomponent21"/>

     <task id="assembleMachine1" name="Assemble Machine">
       <incoming>sequenceFlow7</incoming>
       <incoming>sequenceFlow11</incoming>
       <outgoing>sequenceFlow13</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow7" sourceRef="testSubcomponent11" targetRef="assembleMachine1"/>

     <sequenceFlow id="sequenceFlow11" sourceRef="testSubcomponent21" targetRef="assembleMachine1"/>

     <endEvent id="machineBuilt1" name="Machine Built">
       <incoming>sequenceFlow13</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow13" sourceRef="assembleMachine1" targetRef="machineBuilt1"/>
   </process>
 </definitions>