<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definition" name="Farming Bot Process">

   <process id="farmingBotProcess" isExecutable="true">
     <startEvent id="startFarmingBot" name="Start Farming Bot">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <task id="selectResources" name="Select Resources">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow1" sourceRef="startFarmingBot" targetRef="selectResources"/>

     <parallelGateway id="resourceSelection" name="Resource Selection">
       <incoming>sequenceFlow2</incoming>
       <!-- Add up to 10 outgoing sequence flows for parallel resource collection -->
       <outgoing>collectResource1</outgoing>
       <outgoing>collectResource2</outgoing>
     </parallelGateway>

     <sequenceFlow id="sequenceFlow2" sourceRef="selectResources" targetRef="resourceSelection"/>

     <!-- Resource Collection Tasks (up to 10) -->
     <task id="collectResource1" name="Collect Resource 1">
       <incoming>collectResource1</incoming>
       <outgoing>sequenceFlow3</outgoing>
     </task>

     <sequenceFlow id="collectResource1" sourceRef="resourceSelection" targetRef="collectResource1"/>

     <task id="collectResource2" name="Collect Resource 2">
       <incoming>collectResource2</incoming>
       <outgoing>sequenceFlow4</outgoing>
     </task>

     <sequenceFlow id="collectResource2" sourceRef="resourceSelection" targetRef="collectResource2"/>

     <task id="createTools" name="Create Tools">
       <incoming>sequenceFlow3</incoming>
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow5</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow3" sourceRef="collectResource1" targetRef="createTools"/>
     <sequenceFlow id="sequenceFlow4" sourceRef="collectResource2" targetRef="createTools"/>

     <task id="farming" name="Farming">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow6</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow5" sourceRef="createTools" targetRef="farming"/>

     <intermediateCatchEvent id="naturalDisaster" name="Natural Disaster">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow7</outgoing>
     </intermediateCatchEvent>

     <sequenceFlow id="sequenceFlow6" sourceRef="farming" targetRef="naturalDisaster"/>

     <task id="notifyMilestone" name="Notify Milestone">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow8</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow7" sourceRef="naturalDisaster" targetRef="notifyMilestone"/>

     <exclusiveGateway id="updateOrContinue" name="Update Resources?">
       <incoming>sequenceFlow8</incoming>
       <outgoing>sequenceFlow9</outgoing>
       <outgoing>sequenceFlow10</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow8" sourceRef="notifyMilestone" targetRef="updateOrContinue"/>

     <task id="updateResources" name="Update Resources">
       <incoming>sequenceFlow9</incoming>
       <!-- outgoing sequence flow back to farming or other tasks -->
     </task>

     <sequenceFlow id="sequenceFlow9" sourceRef="updateOrContinue" targetRef="updateResources"/>

     <task id="bragToFriends" name="Brag to Friends">
       <incoming>sequenceFlow10</incoming>
       <!-- outgoing sequence flow to end event or other tasks -->
     </task>

     <sequenceFlow id="sequenceFlow10" sourceRef="updateOrContinue" targetRef="bragToFriends"/>

     <endEvent id="farmingBotCompleted" name="Farming Bot Completed">
       <!-- incoming sequence flows from previous tasks -->
     </endEvent>
   </process>
</definitions>