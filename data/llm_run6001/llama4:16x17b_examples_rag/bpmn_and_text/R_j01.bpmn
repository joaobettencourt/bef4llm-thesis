<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="oeeProcessDefinition" 
             targetNamespace="http://example.com/oeeProcess">
   <process id="oeeProcess" isExecutable="true">
     <startEvent id="startMeasuring">
       <outgoing>collectMachineData</outgoing>
     </startEvent>

     <sequenceFlow id="collectMachineDataSequenceFlow" sourceRef="startMeasuring" targetRef="collectMachineData"/>

     <task id="collectMachineData">
       <incoming>collectMachineDataSequenceFlow</incoming>
       <outgoing>calculateOEE</outgoing>
     </task>

     <sequenceFlow id="calculateOEESquenceFlow" sourceRef="collectMachineData" targetRef="calculateOEE"/>

     <task id="calculateOEE">
       <incoming>calculateOEESquenceFlow</incoming>
       <outgoing>checkOEEValue</outgoing>
     </task>

     <sequenceFlow id="checkOEESequenceFlow" sourceRef="calculateOEE" targetRef="checkOEEValue"/>

     <exclusiveGateway id="checkOEEValue">
       <incoming>checkOEESequenceFlow</incoming>
       <outgoing>continueMeasuringSequenceFlow</outgoing>
       <outgoing>sendNotificationSequenceFlow</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="continueMeasuringSequenceFlow" sourceRef="checkOEEValue" targetRef="continueMeasuring">
       <conditionExpression xsi:type="tFormalExpression">${oeeValue   >= threshold}</conditionExpression>
     </sequenceFlow>

     <task id="continueMeasuring">
       <incoming>continueMeasuringSequenceFlow</incoming>
       <outgoing>endEventSequenceFlow</outgoing>
     </task>

     <endEvent id="endEvent">
       <incoming>endEventSequenceFlow</incoming>
     </endEvent>

     <sequenceFlow id="endEventSequenceFlow" sourceRef="continueMeasuring" targetRef="endEvent"/>

     <sequenceFlow id="sendNotificationSequenceFlow" sourceRef="checkOEEValue" targetRef="sendNotification">
       <conditionExpression xsi:type="tFormalExpression">${oeeValue  < threshold}</conditionExpression>
     </sequenceFlow>

     <task id="sendNotification">
       <incoming>sendNotificationSequenceFlow</incoming>
       <outgoing>stopMachineSequenceFlow</outgoing>
     </task>

     <sequenceFlow id="stopMachineSequenceFlow" sourceRef="sendNotification" targetRef="stopMachine"/>

     <task id="stopMachine">
       <incoming>stopMachineSequenceFlow</incoming>
       <outgoing>restartMachineSequenceFlow</outgoing>
     </task>

     <sequenceFlow id="restartMachineSequenceFlow" sourceRef="stopMachine" targetRef="restartMachine"/>

     <task id="restartMachine">
       <incoming>restartMachineSequenceFlow</incoming>
       <outgoing>collectMachineDataRestartSequenceFlow</outgoing>
     </task>

     <sequenceFlow id="collectMachineDataRestartSequenceFlow" sourceRef="restartMachine" targetRef="collectMachineData"/>

     <endEvent id="disconnectMachine">
       <incoming>disconnectMachineSequenceFlow</incoming>
     </endEvent>

     <sequenceFlow id="disconnectMachineSequenceFlow" sourceRef="restartMachine" targetRef="disconnectMachine"/>
   </process>
</definitions>