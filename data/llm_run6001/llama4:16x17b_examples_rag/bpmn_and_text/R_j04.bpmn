<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definition" name="BPMN Process Model">
  <process id="carServiceProcess" isExecutable="true">

    <!-- Start Event -->
    <startEvent id="serviceReminder" name="Car Service Reminder">
      <outgoing>sequenceFlow1</outgoing>
    </startEvent>

    <!-- Sequence Flow 1 -->
    <sequenceFlow id="sequenceFlow1" sourceRef="serviceReminder" targetRef="checkRegistrationStatus"/>

    <!-- Exclusive Gateway to check registration status -->
    <exclusiveGateway id="checkRegistrationStatus" name="Is Car Registered?">
      <incoming>sequenceFlow1</incoming>
      <outgoing>sequenceFlow2</outgoing>
      <outgoing>sequenceFlow3</outgoing>
    </exclusiveGateway>

    <!-- Sequence Flow 2: Car is registered -->
    <sequenceFlow id="sequenceFlow2" sourceRef="checkRegistrationStatus" targetRef="notifyCustomer">
      <conditionExpression xsi:type="tFormalExpression">${carRegistered = true}</conditionExpression>
    </sequenceFlow>

    <!-- Sequence Flow 3: Car is not registered -->
    <sequenceFlow id="sequenceFlow3" sourceRef="checkRegistrationStatus" targetRef="fineCustomer">
      <conditionExpression xsi:type="tFormalExpression">${carRegistered = false}</conditionExpression>
    </sequenceFlow>

    <!-- Task to notify customer -->
    <userTask id="notifyCustomer" name="Notify Customer of Service Due">
      <incoming>sequenceFlow2</incoming>
      <outgoing>sequenceFlow4</outgoing>
    </userTask>

    <!-- Sequence Flow 4 -->
    <sequenceFlow id="sequenceFlow4" sourceRef="notifyCustomer" targetRef="waitForService"/>

    <!-- Task to wait for service (can take several days) and get status updates via email -->
    <serviceTask id="waitForService" name="Wait for Service & Provide Status Updates">
      <incoming>sequenceFlow4</incoming>
      <outgoing>sequenceFlow5</outgoing>
    </serviceTask>

    <!-- Sequence Flow 5 -->
    <sequenceFlow id="sequenceFlow5" sourceRef="waitForService" targetRef="enterProblemsAndPay"/>

    <!-- Task for mechanic to enter problems and customer to pay through the app -->
    <userTask id="enterProblemsAndPay" name="Mechanic Enters Problems & Customer Pays">
      <incoming>sequenceFlow5</incoming>
      <outgoing>sequenceFlow6</outgoing>
    </userTask>

    <!-- Sequence Flow 6 -->
    <sequenceFlow id="sequenceFlow6" sourceRef="enterProblemsAndPay" targetRef="repairSuccessful"/>

    <!-- Task to mark repair as successful and next service due date -->
    <userTask id="repairSuccessful" name="Mark Repair Successful & Enter Next Service Due Date">
      <incoming>sequenceFlow6</incoming>
      <outgoing>sequenceFlow7</outgoing>
    </userTask>

    <!-- End Event -->
    <endEvent id="serviceCompleted" name="Service Completed">
      <incoming>sequenceFlow7</incoming>
    </endEvent>

    <!-- Sequence Flow 7 -->
    <sequenceFlow id="sequenceFlow7" sourceRef="repairSuccessful" targetRef="serviceCompleted"/>

    <!-- Task to fine customer if they don't attend service within 30 days -->
    <userTask id="fineCustomer" name="Fine Customer for Not Attending Service">
      <incoming>sequenceFlow3</incoming>
      <outgoing>sequenceFlow8</outgoing>
    </userTask>

    <!-- End Event -->
    <endEvent id="fineApplied" name="Fine Applied">
      <incoming>sequenceFlow8</incoming>
    </endEvent>

    <!-- Sequence Flow 8 -->
    <sequenceFlow id="sequenceFlow8" sourceRef="fineCustomer" targetRef="fineApplied"/>

  </process>
</definitions>