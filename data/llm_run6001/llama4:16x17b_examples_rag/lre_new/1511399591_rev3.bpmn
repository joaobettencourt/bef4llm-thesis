<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" 
             targetNamespace="http://bpmn.io/schema/bpmn">

   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>

     <task id="Task_1" name="Collect data and conduct business analysis regarding customer feedback">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="Task_2"/>

     <task id="Task_2" name="Integrate the design and decide where the customer feedback module should be placed">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_3" sourceRef="Task_2" targetRef="Task_3"/>

     <task id="Task_3" name="Check the design and provide feedback">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_4</outgoing>
       <outgoing>SequenceFlow_5</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_4" sourceRef="Task_3" targetRef="Task_2">
      <conditionExpression xsi:type="tFormalExpression">${design.needAdjustment == true}</conditionExpression>
    </sequenceFlow>

     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_3" targetRef="Task_4">
       <conditionExpression xsi:type="tFormalExpression">${design.needAdjustment == false}</conditionExpression>
     </sequenceFlow>

     <task id="Task_4" name="Integrate with the overall implementation">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_4" targetRef="Task_5"/>

     <task id="Task_5" name="Test the final website">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_7</outgoing>
       <outgoing>SequenceFlow_8</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_7" sourceRef="Task_5" targetRef="EndEvent_1">
      <conditionExpression xsi:type="tFormalExpression">${testResult == 'OK'}</conditionExpression>
    </sequenceFlow>

     <sequenceFlow id="SequenceFlow_8" sourceRef="Task_5" targetRef="Task_6">
       <conditionExpression xsi:type="tFormalExpression">${testResult != 'OK'}</conditionExpression>
     </sequenceFlow>

     <task id="Task_6" name="Provide test results to the PHP/HTML/ CSS specialist and adjust according to the test results">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_6" targetRef="Task_4"/>

     <endEvent id="EndEvent_1" name="Process ends">
       <incoming>SequenceFlow_7</incoming>
     </endEvent>

   </process>
</definitions>