<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" 
             targetNamespace="http://bpmn.io/schema/bpmn">

   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_EnterBankDetails"/>

     <task id="Task_EnterBankDetails" name="Enter bank details">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_EnterBankDetails" targetRef="IntermediateThrowEvent_MakeDeposits"/>

     <intermediateThrowEvent id="IntermediateThrowEvent_MakeDeposits">
       <outgoing>SequenceFlow_3</outgoing>
       <messageEventDefinition/>
     </intermediateThrowEvent>

     <sequenceFlow id="SequenceFlow_3" sourceRef="IntermediateThrowEvent_MakeDeposits" targetRef="Task_MakeTwoRandomDeposits"/>

     <task id="Task_MakeTwoRandomDeposits" name="Make two random deposits">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_4</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_4" sourceRef="Task_MakeTwoRandomDeposits" targetRef="IntermediateCatchEvent_NotifyClient"/>

     <intermediateCatchEvent id="IntermediateCatchEvent_NotifyClient">
       <outgoing>SequenceFlow_5</outgoing>
       <messageEventDefinition/>
     </intermediateCatchEvent>

     <sequenceFlow id="SequenceFlow_5" sourceRef="IntermediateCatchEvent_NotifyClient" targetRef="Task_NotifyClientToVerifyBankAccount"/>

     <task id="Task_NotifyClientToVerifyBankAccount" name="Notify client to verify bank account">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_NotifyClientToVerifyBankAccount" targetRef="Task_EnterDepositAmounts"/>

     <task id="Task_EnterDepositAmounts" name="Enter deposit amounts">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_7</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_7" sourceRef="Task_EnterDepositAmounts" targetRef="ExclusiveGateway_VerifyDeposits"/>

     <exclusiveGateway id="ExclusiveGateway_VerifyDeposits">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_8</outgoing>
       <outgoing>SequenceFlow_9</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_8" name="match" sourceRef="ExclusiveGateway_VerifyDeposits" targetRef="EndEvent_DepositsVerified">
       <conditionExpression xsi:type="tFormalExpression">${depositAmountsMatch  == true}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="SequenceFlow_9" name="no match" sourceRef="ExclusiveGateway_VerifyDeposits" targetRef="Task_RemoveBankAccountFromSystem">
       <conditionExpression xsi:type="tFormalExpression">${depositAmountsMatch  == false}</conditionExpression>
     </sequenceFlow>

     <task id="Task_RemoveBankAccountFromSystem" name="Remove bank account from system">
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_10</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_10" sourceRef="Task_RemoveBankAccountFromSystem" targetRef="EndEvent_DepositsNotVerified"/>

     <endEvent id="EndEvent_DepositsVerified">
       <incoming>SequenceFlow_8</incoming>
     </endEvent>

     <endEvent id="EndEvent_DepositsNotVerified">
       <incoming>SequenceFlow_10</incoming>
     </endEvent>

   </process>
</definitions>