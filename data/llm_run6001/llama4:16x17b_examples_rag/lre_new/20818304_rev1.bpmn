<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="BPMN Process Model">

   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>

     <task id="Task_1" name="Receive Credit Information">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="ExclusiveGateway_1"/>

     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_4</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_3" name="amount > 1M$" sourceRef="ExclusiveGateway_1" targetRef="Task_2">
       <conditionExpression xsi:type="tFormalExpression">${creditInformation.requestedAmount > 1000000}</conditionExpression>
     </sequenceFlow>

     <task id="Task_2" name="Request Approval">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_2" targetRef="ExclusiveGateway_2"/>

     <exclusiveGateway id="ExclusiveGateway_2">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_6</outgoing>
       <outgoing>SequenceFlow_7</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_6" name="approved" sourceRef="ExclusiveGateway_2" targetRef="Task_3">
       <conditionExpression xsi:type="tFormalExpression">${approvalResult.approved == true}</conditionExpression>
     </sequenceFlow>

     <task id="Task_3" name="Send Email to Customer (Approved)">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_8</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_8" sourceRef="Task_3" targetRef="EndEvent_1"/>

     <sequenceFlow id="SequenceFlow_7" name="rejected" sourceRef="ExclusiveGateway_2" targetRef="Task_4">
       <conditionExpression xsi:type="tFormalExpression">${approvalResult.approved == false}</conditionExpression>
     </sequenceFlow>

     <task id="Task_4" name="Send Email to Customer (Rejected)">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_4" targetRef="EndEvent_1"/>

     <sequenceFlow id="SequenceFlow_4" name="amount <= 1M$" sourceRef="ExclusiveGateway_1" targetRef="Task_5">
       <conditionExpression xsi:type="tFormalExpression">${creditInformation.requestedAmount <= 1000000}</conditionExpression>
     </sequenceFlow>

     <task id="Task_5" name="Assess Risk">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_10</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_10" sourceRef="Task_5" targetRef="ExclusiveGateway_3"/>

     <exclusiveGateway id="ExclusiveGateway_3">
       <incoming>SequenceFlow_10</incoming>
       <outgoing>SequenceFlow_11</outgoing>
       <outgoing>SequenceFlow_12</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_11" name="risk low" sourceRef="ExclusiveGateway_3" targetRef="Task_6">
       <conditionExpression xsi:type="tFormalExpression">${riskAssessment.riskLevel == 'low'}</conditionExpression>
     </sequenceFlow>

     <task id="Task_6" name="Accept Credit">
       <incoming>SequenceFlow_11</incoming>
       <outgoing>SequenceFlow_13</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_13" sourceRef="Task_6" targetRef="EndEvent_1"/>

     <sequenceFlow id="SequenceFlow_12" name="risk high" sourceRef="ExclusiveGateway_3" targetRef="Task_2">
       <conditionExpression xsi:type="tFormalExpression">${riskAssessment.riskLevel == 'high'}</conditionExpression>
     </sequenceFlow>

     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_8</incoming>
       <incoming>SequenceFlow_9</incoming>
       <incoming>SequenceFlow_13</incoming>
     </endEvent>

   </process>
 </definitions>