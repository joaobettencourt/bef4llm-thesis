<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="BPMN Process Model">

   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_Check_Performance"/>

     <task id="Task_Check_Performance" name="Check Employee Performance">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_Check_Performance" targetRef="ExclusiveGateway_1"/>

     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_4</outgoing>
       <outgoing>SequenceFlow_5</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_3" name="Performance < 20%" sourceRef="ExclusiveGateway_1" targetRef="Task_Suggest_Dismissal">
       <conditionExpression xsi:type="tFormalExpression">${performance <= 20}</conditionExpression>
     </sequenceFlow>

     <task id="Task_Suggest_Dismissal" name="Suggest Employee's Dismissal to HR">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_Suggest_Dismissal" targetRef="EndEvent_Dismiss"/>

     <endEvent id="EndEvent_Dismiss">
       <incoming>SequenceFlow_6</incoming>
     </endEvent>

     <sequenceFlow id="SequenceFlow_4" name="20% <= Performance < 50%" sourceRef="ExclusiveGateway_1" targetRef="Task_Suggest_Training">
       <conditionExpression xsi:type="tFormalExpression">${performance >= 20 and performance < 50}</conditionExpression>
     </sequenceFlow>

     <task id="Task_Suggest_Training" name="Suggest Training to Employee">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_7</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_7" sourceRef="Task_Suggest_Training" targetRef="EndEvent_Training"/>

     <endEvent id="EndEvent_Training">
       <incoming>SequenceFlow_7</incoming>
     </endEvent>

     <sequenceFlow id="SequenceFlow_5" name="Performance > 75%" sourceRef="ExclusiveGateway_1" targetRef="ExclusiveGateway_2">
       <conditionExpression xsi:type="tFormalExpression">${performance > 75}</conditionExpression>
     </sequenceFlow>

     <exclusiveGateway id="ExclusiveGateway_2">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_8</outgoing>
       <outgoing>SequenceFlow_9</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_8" sourceRef="ExclusiveGateway_2" targetRef="Task_Financial_Reward">
       <!-- Add condition expression here -->
     </sequenceFlow>

     <task id="Task_Financial_Reward" name="Finance Department Provides Financial Reward">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_10</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_10" sourceRef="Task_Financial_Reward" targetRef="EndEvent_Announce"/>

     <endEvent id="EndEvent_Announce">
       <!-- Add incoming sequence flows here -->
     </endEvent>

     <sequenceFlow id="SequenceFlow_9" sourceRef="ExclusiveGateway_2" targetRef="Task_Other_Benefit">
       <!-- Add condition expression here -->
     </sequenceFlow>

     <task id="Task_Other_Benefit" name="Management Chooses Other Benefit for Employee">
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_11</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_11" sourceRef="Task_Other_Benefit" targetRef="EndEvent_Announce"/>
   </process>
</definitions>