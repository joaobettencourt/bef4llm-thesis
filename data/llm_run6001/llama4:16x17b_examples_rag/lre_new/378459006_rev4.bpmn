<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="BPMN Process Model" targetNamespace="http://bpmn.oo/schema/bpmn">
   <collaboration id="Collaboration_1">
     <participant id="Participant_1" name="SSP" processRef="Process_1"/>
     <participant id="Participant_2" name="Client"/>
     <participant id="Participant_3" name="Registry Office"/>
     <participant id="Participant_4" name="Accounts Receivable Department"/>
   </collaboration>
   <process id="Process_1" isExecutable="true">
     <laneSet>
       <lane id="Lane_1" name="Payment Office">
         <flowNodeRef>StartEvent_1</flowNodeRef>
         <flowNodeRef>Task_Generate_Report</flowNodeRef>
         <flowNodeRef>Task_Pay_Vendor</flowNodeRef>
         <flowNodeRef>IntermediateThrowEvent_Send_Reports</flowNodeRef>
       </lane>
       <lane id="Lane_2" name="Registry Office">
         <flowNodeRef>Task_Archive_Invoices</flowNodeRef>
       </lane>
       <lane id="Lane_3" name="Accounts Receivable Department">
         <flowNodeRef>Task_Generate_Monthly_Invoice</flowNodeRef>
         <flowNodeRef>Task_Charge_Client</flowNodeRef>
       </lane>
     </laneSet>

     <startEvent id="StartEvent_1" name="End of Week">
       <outgoing>SequenceFlow_Start</outgoing>
       <timerEventDefinition/>
     </startEvent>

     <sequenceFlow id="SequenceFlow_Start" sourceRef="StartEvent_1" targetRef="Task_Generate_Report"/>

     <task id="Task_Generate_Report" name="Generate Payment Report">
       <incoming>SequenceFlow_Start</incoming>
       <outgoing>SequenceFlow_Report_Generated</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_Report_Generated" sourceRef="Task_Generate_Report" targetRef="Task_Pay_Vendor"/>

     <task id="Task_Pay_Vendor" name="Pay Vendor">
       <incoming>SequenceFlow_Report_Generated</incoming>
       <outgoing>SequenceFlow_Payment_Done</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_Payment_Done" sourceRef="Task_Pay_Vendor" targetRef="IntermediateThrowEvent_Send_Reports"/>

     <intermediateCatchEvent id="IntermediateThrowEvent_Send_Reports">
       <incoming>SequenceFlow_Payment_Done</incoming>
       <outgoing>SequenceFlow_Registry_Office</outgoing>
       <outgoing>SequenceFlow_Client_Notified</outgoing>
       <outgoing>SequenceFlow_Accounts_Department</outgoing>
     </intermediateCatchEvent>

     <sequenceFlow id="SequenceFlow_Registry_Office" sourceRef="IntermediateThrowEvent_Send_Reports" targetRef="Task_Archive_Invoices"/>

     <task id="Task_Archive_Invoices" name="Archive Invoices">
       <incoming>SequenceFlow_Registry_Office</incoming>
     </task>

     <sequenceFlow id="SequenceFlow_Client_Notified" sourceRef="IntermediateThrowEvent_Send_Reports" targetRef="Participant_2"/>

     <messageFlow id="MessageFlow_Client" name="Send Payment Invoice to Client"
                 sourceRef="IntermediateThrowEvent_Send_Reports" targetRef="Participant_2"/>

     <sequenceFlow id="SequenceFlow_Accounts_Department" sourceRef="IntermediateThrowEvent_Send_Reports" targetRef="Task_Generate_Monthly_Invoice"/>

     <task id="Task_Generate_Monthly_Invoice" name="Generate Monthly Invoice">
       <incoming>SequenceFlow_Accounts_Department</incoming>
       <outgoing>SequenceFlow_Monthly_Invoice_Generated</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_Monthly_Invoice_Generated" sourceRef="Task_Generate_Monthly_Invoice" targetRef="Task_Charge_Client"/>

     <task id="Task_Charge_Client" name="Charge Client $35">
       <incoming>SequenceFlow_Monthly_Invoice_Generated</incoming>
     </task>

   </process>
</definitions>