<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" 
             targetNamespace="http://bpmn.io/schema/bpmn">

   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>

     <task id="Task_1" name="Sort invoice per client and vendor">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="Task_2"/>

     <task id="Task_2" name="Attach invoice entry form to invoice">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_3" sourceRef="Task_2" targetRef="Task_3"/>

     <task id="Task_3" name="Enter required info on invoice entry form">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_4</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_4" sourceRef="Task_3" targetRef="ExclusiveGateway_1"/>

     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_5</outgoing>
       <outgoing>SequenceFlow_6</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_5" name="yes" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_1">
       <conditionExpression xsi:type="tFormalExpression">${invoice.isComplete  == true}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="SequenceFlow_6" name="no" sourceRef="ExclusiveGateway_1" targetRef="Task_4">
       <conditionExpression xsi:type="tFormalExpression">${invoice.isComplete  == false}</conditionExpression>
     </sequenceFlow>

     <task id="Task_4" name="Send message to client and finish process">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_7</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_7" sourceRef="Task_4" targetRef="EndEvent_1"/>

     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_5</incoming>
       <incoming>SequenceFlow_7</incoming>
     </endEvent>

     <!-- Admin Office enters info for SLA and checks priority  -->
     <sequenceFlow id="SequenceFlow_8" sourceRef="Task_3" targetRef="Task_5"/>

     <task id="Task_5" name="Enter info for SLA and check priority">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_5" targetRef="ExclusiveGateway_2"/>

     <exclusiveGateway id="ExclusiveGateway_2">
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_10</outgoing>
       <outgoing>SequenceFlow_11</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_10" name="high priority" sourceRef="ExclusiveGateway_2" targetRef="Task_6">
       <conditionExpression xsi:type="tFormalExpression">${invoice.priority  == 'high'}</conditionExpression>
     </sequenceFlow>

     <task id="Task_6" name="Apply red stamp on entry invoice">
       <incoming>SequenceFlow_10</incoming>
       <outgoing>SequenceFlow_12</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_12" sourceRef="Task_6" targetRef="Task_7"/>

     <task id="Task_7" name="Check invoice compliance">
       <incoming>SequenceFlow_12</incoming>
       <outgoing>SequenceFlow_13</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_13" sourceRef="Task_7" targetRef="ExclusiveGateway_3"/>

     <exclusiveGateway id="ExclusiveGateway_3">
       <incoming>SequenceFlow_13</incoming>
       <outgoing>SequenceFlow_14</outgoing>
       <outgoing>SequenceFlow_15</outgoing>
       <outgoing>SequenceFlow_16</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_14" name="complete" sourceRef="ExclusiveGateway_3" targetRef="Task_8">
       <conditionExpression xsi:type="tFormalExpression">${invoice.isComplete  == true}</conditionExpression>
     </sequenceFlow>

     <!-- Admin Office can either send to experience staff, call client or send postal mail  -->
     <sequenceFlow id="SequenceFlow_15" name="non-compliance" sourceRef="ExclusiveGateway_3" targetRef="Task_9">
       <conditionExpression xsi:type="tFormalExpression">${invoice.isComplete  == false}</conditionExpression>
     </sequenceFlow>

     <task id="Task_8" name="Allocate invoice to DEO">
       <incoming>SequenceFlow_14</incoming>
       <outgoing>SequenceFlow_17</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_17" sourceRef="Task_8" targetRef="EndEvent_2"/>

     <!-- Admin Office can either send to experience staff, call client or send postal mail  -->
     <task id="Task_9" name="Send invoice for processing">
       <incoming>SequenceFlow_15</incoming>
       <outgoing>SequenceFlow_18</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_18" sourceRef="Task_9" targetRef="IntermediateCatchEvent_1"/>

     <!-- send postal mail requesting information  -->
     <sequenceFlow id="SequenceFlow_16" name="send postal mail" sourceRef="ExclusiveGateway_3" targetRef="Task_10">
       <conditionExpression xsi:type="tFormalExpression">${invoice.isComplete  == false}</conditionExpression>
     </sequenceFlow>

     <task id="Task_10" name="Send postal mail requesting information">
       <incoming>SequenceFlow_16</incoming>
       <outgoing>SequenceFlow_19</outgoing>
     </task>

     <!-- reminder sent to client after 10 hours  -->
     <intermediateCatchEvent id="IntermediateCatchEvent_1">
       <incoming>SequenceFlow_18</incoming>
       <outgoing>SequenceFlow_20</outgoing>
       <timerEventDefinition/>
     </intermediateCatchEvent>

     <sequenceFlow id="SequenceFlow_19" sourceRef="Task_10" targetRef="EndEvent_2"/>

     <endEvent id="EndEvent_2">
       <incoming>SequenceFlow_17</incoming>
       <incoming>SequenceFlow_19</incoming>
     </endEvent>

     <!-- reminder sent to client after 10 hours  -->
     <sequenceFlow id="SequenceFlow_20" sourceRef="IntermediateCatchEvent_1" targetRef="Task_11"/>

     <task id="Task_11" name="Send reminder to client">
       <incoming>SequenceFlow_20</incoming>
       <outgoing>SequenceFlow_21</outgoing>
     </task>

     <!-- obtain missing information  -->
     <sequenceFlow id="SequenceFlow_21" sourceRef="Task_11" targetRef="EndEvent_2"/>
   </process>
</definitions>