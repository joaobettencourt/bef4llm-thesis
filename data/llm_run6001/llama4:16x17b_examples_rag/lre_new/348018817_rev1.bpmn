<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Expense Report Process">

   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_0"/>

     <task id="Task_0" name="Check if employee has account">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
       <outgoing>SequenceFlow_3</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_0" targetRef="ExclusiveGateway_1">
       <conditionExpression xsi:type="tFormalExpression">${employee.needCreateAccount == false}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="SequenceFlow_3" sourceRef="Task_0" targetRef="Task_1">
       <conditionExpression xsi:type="tFormalExpression">${employee.needCreateAccount == true}</conditionExpression>
     </sequenceFlow>

     <task id="Task_1" name="Create account for employee">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_4</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_4" sourceRef="Task_1" targetRef="ExclusiveGateway_1"/>

     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_2</incoming>
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_5" sourceRef="ExclusiveGateway_1" targetRef="Task_2"/>

     <task id="Task_2" name="Review expense report">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_2" targetRef="ExclusiveGateway_2"/>

     <exclusiveGateway id="ExclusiveGateway_2">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_7</outgoing>
       <outgoing>SequenceFlow_8</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_7" sourceRef="ExclusiveGateway_2" targetRef="Task_3">
       <conditionExpression xsi:type="tFormalExpression">${expenseReport.amount <= 200}</conditionExpression>
     </sequenceFlow>

     <task id="Task_3" name="Reimburse employee directly">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_14</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_14" sourceRef="Task_3" targetRef="EndEvent_1"/>

     <sequenceFlow id="SequenceFlow_8" sourceRef="ExclusiveGateway_2" targetRef="Task_4">
       <conditionExpression xsi:type="tFormalExpression">${expenseReport.amount > 200}</conditionExpression>
     </sequenceFlow>

     <task id="Task_4" name="Request supervisor approval">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_4" targetRef="ExclusiveGateway_3"/>

     <exclusiveGateway id="ExclusiveGateway_3">
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_10</outgoing>
       <outgoing>SequenceFlow_11</outgoing>
       <outgoing>SequenceFlow_12</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_10" sourceRef="ExclusiveGateway_3" targetRef="Task_5">
       <conditionExpression xsi:type="tFormalExpression">${approvalStatus == 'approved'}</conditionExpression>
     </sequenceFlow>

     <task id="Task_5" name="Reimburse employee directly">
       <incoming>SequenceFlow_10</incoming>
       <outgoing>SequenceFlow_15</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_15" sourceRef="Task_5" targetRef="EndEvent_1"/>

     <sequenceFlow id="SequenceFlow_11" sourceRef="ExclusiveGateway_3" targetRef="Task_6">
       <conditionExpression xsi:type="tFormalExpression">${approvalStatus == 'rejected'}</conditionExpression>
     </sequenceFlow>

     <task id="Task_6" name="Notify employee of rejection">
       <incoming>SequenceFlow_11</incoming>
       <outgoing>SequenceFlow_16</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_16" sourceRef="Task_6" targetRef="EndEvent_1"/>

     <sequenceFlow id="SequenceFlow_12" sourceRef="ExclusiveGateway_3" targetRef="IntermediateCatchEvent_1">
       <conditionExpression xsi:type="tFormalExpression">${approvalStatus == null}</conditionExpression>
     </sequenceFlow>

     <intermediateCatchEvent id="IntermediateCatchEvent_1">
       <incoming>SequenceFlow_12</incoming>
       <outgoing>SequenceFlow_13</outgoing>
     </intermediateCatchEvent>

     <sequenceFlow id="SequenceFlow_13" sourceRef="IntermediateCatchEvent_1" targetRef="Task_4"/>

     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_14</incoming>
       <incoming>SequenceFlow_15</incoming>
       <incoming>SequenceFlow_16</incoming>
     </endEvent>

   </process>
</definitions>