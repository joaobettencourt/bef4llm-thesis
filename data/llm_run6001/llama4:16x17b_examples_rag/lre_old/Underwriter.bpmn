<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com/bpmn">
   <process id="goPublicProcess" isExecutable="true">
     <startEvent id="start">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <task id="selectUnderwritersTask" name="Select Underwriters">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow1" sourceRef="start" targetRef="selectUnderwritersTask"/>

     <task id="prepareRegistrationStatementTask" name="Prepare Registration Statement">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow2" sourceRef="selectUnderwritersTask" targetRef="prepareRegistrationStatementTask"/>

     <exclusiveGateway id="gateway1">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow4</outgoing>
       <outgoing>sequenceFlow5</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow3" sourceRef="prepareRegistrationStatementTask" targetRef="gateway1"/>

     <task id="registerWithSecTask" name="Register with SEC">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow6</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow4" sourceRef="gateway1" targetRef="registerWithSecTask"/>

     <intermediateCatchEvent id="secClearanceEvent2">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow7</outgoing>
     </intermediateCatchEvent>

     <sequenceFlow id="sequenceFlow5" sourceRef="gateway1" targetRef="secClearanceEvent2"/>

     <task id="fixIssuePriceTask" name="Fix Issue Price">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow8</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow6" sourceRef="registerWithSecTask" targetRef="fixIssuePriceTask"/>

     <parallelGateway id="gateway2">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow9</outgoing>
       <outgoing>sequenceFlow10</outgoing>
     </parallelGateway>

     <sequenceFlow id="sequenceFlow7" sourceRef="secClearanceEvent2" targetRef="gateway2"/>

     <task id="arrangeRoadShowTask" name="Arrange Road Show">
       <incoming>sequenceFlow9</incoming>
     </task>

     <sequenceFlow id="sequenceFlow9" sourceRef="gateway2" targetRef="arrangeRoadShowTask"/>

     <task id="enterFirmCommitmentTask" name="Enter Firm Commitment">
       <incoming>sequenceFlow10</incoming>
       <outgoing>sequenceFlow11</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow10" sourceRef="gateway2" targetRef="enterFirmCommitmentTask"/>

     <endEvent id="end">
       <incoming>sequenceFlow11</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow11" sourceRef="enterFirmCommitmentTask" targetRef="end"/>
   </process>
 </definitions>