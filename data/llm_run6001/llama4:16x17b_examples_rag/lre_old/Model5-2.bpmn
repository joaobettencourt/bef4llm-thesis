<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <collaboration id="Collaboration_1">
    <participant id="Participant_0" name="Organization" processRef="Pool_0"/>
  </collaboration>
  <process id="Pool_0" isExecutable="false">
    <laneSet>
      <lane id="Lane_1" name="Human Resources Representative">
        <flowNodeRef>Task_3</flowNodeRef>
      </lane>
      <lane id="Lane_0" name="Supervisor">
        <flowNodeRef>Task_2</flowNodeRef>
        <flowNodeRef>Exclusive_Gateway_0</flowNodeRef>
      </lane>
      <lane id="Lane_2" name="Employee">
        <flowNodeRef>StartEvent_1</flowNodeRef>
        <flowNodeRef>Task_0</flowNodeRef>
        <flowNodeRef>Task_4</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="StartEvent_1" name="Vacation Request">
      <outgoing>SequenceFlow_0</outgoing>
    </startEvent>
    <task id="Task_0" name="Register vacation request">
      <incoming>SequenceFlow_0</incoming>
      <outgoing>SequenceFlow_1</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_0" sourceRef="StartEvent_1" targetRef="Task_0"/>
    <sequenceFlow id="SequenceFlow_1" sourceRef="Task_0" targetRef="Task_2"/>
    <task id="Task_2" name="Approve or reject vacation request">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
      <outgoing>SequenceFlow_3</outgoing>
    </task>
    <exclusiveGateway id="Exclusive_Gateway_0" name="Request Approved?">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_4</outgoing>
      <outgoing>SequenceFlow_5</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_2" targetRef="Exclusive_Gateway_0"/>
    <sequenceFlow id="SequenceFlow_4" sourceRef="Exclusive_Gateway_0" targetRef="Task_3">
      <conditionExpression xsi:type="tFormalExpression">approved == true</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="SequenceFlow_5" sourceRef="Exclusive_Gateway_0" targetRef="Task_4">
      <conditionExpression xsi:type="string">approved == false</conditionExpression>
    </sequenceFlow>
    <task id="Task_3" name="Notify Human Resources Representative and complete management procedures">
      <incoming>SequenceFlow_4</incoming>
    </task>
    <task id="Task_4" name="Notify employee about rejection">
      <incoming>SequenceFlow_5</incoming>
    </task>
  </process>
</definitions>