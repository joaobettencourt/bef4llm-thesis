<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com/bpmn">
   <process id="process" isExecutable="true">
     <startEvent id="StartNoneEvent_0">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>
     <task name="Transmit transaction data request" id="Task_0">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_1" sourceRef="StartNoneEvent_0" targetRef="Task_0"/>
     <endEvent id="EndNoneEvent_0">
       <incoming>SequenceFlow_3</incoming>
     </endEvent>
     <exclusiveGateway id="ExclusiveGateway_0">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_4</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_0" targetRef="ExclusiveGateway_0"/>
     <task name="Transmit data" id="Task_1">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_0" targetRef="Task_1"/>
     <endEvent id="EndNoneEvent_1">
       <incoming>SequenceFlow_5</incoming>
     </endEvent>
     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_1" targetRef="EndNoneEvent_1"/>
     <task name="Reject request" id="Task_2">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_0" targetRef="Task_2"/>
     <endEvent id="EndNoneEvent_2">
       <incoming>SequenceFlow_6</incoming>
     </endEvent>
     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_2" targetRef="EndNoneEvent_2"/>
   </process>
</definitions>