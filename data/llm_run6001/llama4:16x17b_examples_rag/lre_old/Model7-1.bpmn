<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20MPT0.2.0.xsd" 
             id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
   <collaboration id="Collaboration_1">
     <participant id="Participant_1" name="Sales Process" processRef="Process_1"/>
   </collaboration>
  
   <process id="Process_1" isExecutable="false">
     <laneSet>
       <lane id="Lane_1" name="Manager">
         <flowNodeRef>StartEvent_1</flowNodeRef>
         <flowNodeRef>Task_0k8j1jy</flowNodeRef>
         <flowNodeRef>InclusiveGateway_1</flowNodeRef>
       </lane>
       <lane id="Lane_2" name="Sales Assistant">
         <flowNodeRef>Task_1la91ms</flowNodeRef>
       </lane>
     </laneSet>

     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_0k8j1jy"/>

     <task id="Task_0k8j1jy" name="Check open leads and select top 5">
       <outgoing>SequenceFlow_2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_0k8j1jy" targetRef="InclusiveGateway_1"/>

     <inclusiveGateway id="InclusiveGateway_1">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_4</outgoing>
     </inclusiveGateway>

     <sequenceFlow id="SequenceFlow_3" sourceRef="InclusiveGateway_1" targetRef="Task_1la91ms"/>

     <task id="Task_1la91ms" name="Call contact persons">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_1la91ms" targetRef="ExclusiveGateway_1"/>

     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_6</outgoing>
       <outgoing>SequenceFlow_7</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_6" name="not interested" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_1"/>

     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_6</incoming>
     </endEvent>

     <sequenceFlow id="SequenceFlow_7" name="interested" sourceRef="ExclusiveGateway_1" targetRef="Task_2"/>

     <task id="Task_2" name="Send note to Manager">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_8</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_8" sourceRef="Task_2" targetRef="ExclusiveGateway_2"/>

     <exclusiveGateway id="ExclusiveGateway_2">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_9</outgoing>
       <outgoing>SequenceFlow_10</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_9" name="process lead" sourceRef="ExclusiveGateway_2" targetRef="Task_3"/>

     <task id="Task_3" name="Process lead">
       <incoming>SequenceFlow_9</incoming>
     </task>

     <sequenceFlow id="SequenceFlow_10" name="not interested in processing" sourceRef="ExclusiveGateway_2" targetRef="EndEvent_2"/>

     <endEvent id="EndEvent_2">
       <incoming>SequenceFlow_10</incoming>
     </endEvent>

   </process>
</definitions>