<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Goods Shipment Process">

  <collaboration id="Collaboration_1">
    <participant id="Participant_1" processRef="Process_1"/>
  </collaboration>

  <process id="Process_1" isExecutable="true">
    <laneSet>
      <lane id="Lane_1" name="Secretary">
        <flowNodeRef>StartEvent_1</flowNodeRef>
        <flowNodeRef>Task_0</flowNodeRef>
        <flowNodeRef>InclusiveGateway_1</flowNodeRef>
        <flowNodeRef>ExclusiveGateway_1</flowNodeRef>
      </lane>
      <lane id="Lane_2" name="Logistics Department Head">
        <flowNodeRef>Task_3</flowNodeRef>
      </lane>
      <lane id="Lane_3" name="Warehousemen">
        <flowNodeRef>Task_5</flowNodeRef>
      </lane>
    </laneSet>

    <startEvent id="StartEvent_1" name="Ship goods">
      <outgoing>SequenceFlow_0</outgoing>
    </startEvent>

    <sequenceFlow id="SequenceFlow_0" sourceRef="StartEvent_1" targetRef="Task_0"/>

    <userTask id="Task_0" name="Clarify who will do the shipping">
      <incoming>SequenceFlow_0</incoming>
      <outgoing>SequenceFlow_1</outgoing>
    </userTask>

    <sequenceFlow id="SequenceFlow_1" sourceRef="Task_0" targetRef="ExclusiveGateway_1"/>

    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
      <outgoing>SequenceFlow_3</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow_2" name="Large amounts" sourceRef="ExclusiveGateway_1" targetRef="Task_1"/>
    <userTask id="Task_1" name="Invite three logistic companies to make offers">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_4</outgoing>
    </userTask>

    <sequenceFlow id="SequenceFlow_4" sourceRef="Task_1" targetRef="Task_2"/>
    <userTask id="Task_2" name="Select logistic company and place order">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_5</outgoing>
    </userTask>

    <sequenceFlow id="SequenceFlow_5" sourceRef="Task_2" targetRef="InclusiveGateway_1"/>

    <inclusiveGateway id="InclusiveGateway_1">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </inclusiveGateway>

    <sequenceFlow id="SequenceFlow_6" sourceRef="InclusiveGateway_1" targetRef="Task_3"/>
    <userTask id="Task_3" name="Write package label and insure parcel if necessary">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </userTask>

    <sequenceFlow id="SequenceFlow_7" sourceRef="Task_3" targetRef="ExclusiveGateway_2"/>

    <exclusiveGateway id="ExclusiveGateway_2">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_8</outgoing>
      <outgoing>SequenceFlow_9</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow_3" name="Small amounts" sourceRef="ExclusiveGateway_1" targetRef="Task_4"/>
    <userTask id="Task_4" name="Write package label">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_10</outgoing>
    </userTask>

    <sequenceFlow id="SequenceFlow_10" sourceRef="Task_4" targetRef="ExclusiveGateway_2"/>

    <sequenceFlow id="SequenceFlow_8" name="Insurance necessary" sourceRef="ExclusiveGateway_2" targetRef="Task_6"/>
    <userTask id="Task_6" name="Insure parcel">
      <incoming>SequenceFlow_8</incoming>
      <outgoing>SequenceFlow_11</outgoing>
    </userTask>

    <sequenceFlow id="SequenceFlow_11" sourceRef="Task_6" targetRef="ExclusiveGateway_3"/>

    <exclusiveGateway id="ExclusiveGateway_3">
      <incoming>SequenceFlow_11</incoming>
      <outgoing>SequenceFlow_12</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow_9" sourceRef="ExclusiveGateway_2" targetRef="ExclusiveGateway_3"/>

    <sequenceFlow id="SequenceFlow_12" sourceRef="ExclusiveGateway_3" targetRef="Task_5"/>
    <userTask id="Task_5" name="Package goods">
      <incoming>SequenceFlow_12</incoming>
      <outgoing>SequenceFlow_13</outgoing>
    </userTask>

    <sequenceFlow id="SequenceFlow_13" sourceRef="Task_5" targetRef="EndEvent_1"/>
    <endEvent id="EndEvent_1" name="Shipment prepared">
      <incoming>SequenceFlow_13</incoming>
    </endEvent>
  </process>
</definitions>