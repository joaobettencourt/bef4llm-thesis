<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Examination Process">

   <process id="examinationProcess" isExecutable="true">
     <startEvent id="startExam" name="Patient Examination Start">
       <outgoing>flow1</outgoing>
     </startEvent>

     <sequenceFlow id="flow1" sourceRef="startExam" targetRef="decisionHealthy"/>

     <exclusiveGateway id="decisionHealthy" name="Is Patient Healthy?">
       <incoming>flow1</incoming>
       <outgoing>flow2</outgoing>
       <outgoing>flow3</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="flow2" name="Yes" sourceRef="decisionHealthy" targetRef="fillForm"/>

     <task id="fillForm" name="Fill Examination Form">
       <incoming>flow2</incoming>
       <outgoing>flow4</outgoing>
     </task>

     <sequenceFlow id="flow4" sourceRef="fillForm" targetRef="endExam1"/>

     <sequenceFlow id="flow3" name="No" sourceRef="decisionHealthy" targetRef="orderAdditionalExamination"/>

     <task id="orderAdditionalExamination" name="Order Additional Examination and Request Form">
       <incoming>flow3</incoming>
       <outgoing>flow5</outgoing>
     </task>

     <sequenceFlow id="flow5" sourceRef="orderAdditionalExamination" targetRef="informPatient"/>

     <task id="informPatient" name="Inform Patient About Risks and Obtain Informed Consent">
       <incoming>flow5</incoming>
       <outgoing>flow6</outgoing>
     </task>

     <sequenceFlow id="flow6" sourceRef="informPatient" targetRef="arrangeAppointment"/>

     <task id="arrangeAppointment" name="Arrange Appointment with Ward">
       <incoming>flow6</incoming>
       <outgoing>flow7</outgoing>
     </task>

     <sequenceFlow id="flow7" sourceRef="arrangeAppointment" targetRef="prepareSample"/>

     <task id="prepareSample" name="Prepare for Sample Taking">
       <incoming>flow7</incoming>
       <outgoing>flow8</outgoing>
     </task>

     <sequenceFlow id="flow8" sourceRef="prepareSample" targetRef="takeSample"/>

     <task id="takeSample" name="Take Sample and Send to Lab">
       <incoming>flow8</incoming>
       <outgoing>flow9</outgoing>
     </task>

     <sequenceFlow id="flow9" sourceRef="takeSample" targetRef="validateSample"/>

     <exclusiveGateway id="validateSample" name="Is Sample Valid?">
       <incoming>flow9</incoming>
       <outgoing>flow10</outgoing>
       <outgoing>flow11</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="flow10" name="Yes" sourceRef="validateSample" targetRef="analyzeSample"/>

     <task id="analyzeSample" name="Analyze Sample">
       <incoming>flow10</incoming>
       <outgoing>flow12</outgoing>
     </task>

     <sequenceFlow id="flow12" sourceRef="analyzeSample" targetRef="validateResults"/>

     <task id="validateResults" name="Validate Results">
       <incoming>flow12</incoming]
       <outgoing>flow13</outgoing>
     </task>

     <sequenceFlow id="flow13" sourceRef="validateResults" targetRef="makeDiagnosis"/>

     <task id="makeDiagnosis1" name="Make Diagnosis and Prescribe Therapy">
       <incoming>flow13</incoming>
       <outgoing>flow14</outgoing>
     </task>

     <sequenceFlow id="flow14" sourceRef="makeDiagnosis1" targetRef="endExam"/>

     <sequenceFlow id="flow11" name="No" sourceRef="validateSample" targetRef="requestNewSample"/>

     <task id="requestNewSample" name="Request New Sample">
       <incoming>flow11</incoming>
       <outgoing>flow15</outgoing>
     </task>

     <sequenceFlow id="flow15" sourceRef="requestNewSample" targetRef="takeSample1"/>

     <task id="takeSample1" name="Take Sample and Send to Lab">
       <incoming>flow15</incoming>
       <outgoing>flow16</outgoing>
     </task>

     <sequenceFlow id="flow16" sourceRef="takeSample1" targetRef="validateSample1"/>

     <exclusiveGateway id="validateSample1" name="Is Sample Valid?">
       <incoming>flow16</incoming>
       <outgoing>flow17</outgoing>
       <outgoing>flow18</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="flow17" name="Yes" sourceRef="validateSample1" targetRef="analyzeSample1"/>

     <task id="analyzeSample1" name="Analyze Sample">
       <incoming>flow17</incoming]
       <outgoing>flow19</outgoing>
     </task>

     <sequenceFlow id="flow19" sourceRef="analyzeSample1" targetRef="validateResults1"/>

     <task id="validateResults1" name="Validate Results">
       <incoming>flow19</incoming>
       <outgoing>flow20</outgoing>
     </task>

     <sequenceFlow id="flow20" sourceRef="validateResults1" targetRef="makeDiagnosis"/>

     <endEvent id="endExam" name="Examination End">
       <incoming>flow4</incoming>
       <incoming>flow14</incoming>
     </endEvent>

     <endEvent id="endExam1" name="Examination End1">
       <incoming>flow13</incoming>
     </endEvent>
   </process>
</definitions>