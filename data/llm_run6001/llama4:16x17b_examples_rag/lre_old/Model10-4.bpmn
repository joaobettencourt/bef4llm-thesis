<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
                 id="definitions" name="MPON and MPOO Process" targetNamespace="http://example.com/bpmn">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_0notify-mpoo"/>

    <bpmn:task id="Task_0notify-mpoo" name="Notify MPOO about equipment change intentions">
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="Task_0notify-mpoo" targetRef="ExclusiveGateway_1"/>

    <bpmn:exclusiveGateway id="ExclusiveGateway_1">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="SequenceFlow_3" name="Self-dismounting" sourceRef="ExclusiveGateway_1" targetRef="Task_0self-dismounting"/>

    <bpmn:task id="Task_0self-dismounting" name="MPOO announces self dismounting to MPON or notify no self-dismounting">
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_4" name="No self-dismounting" sourceRef="ExclusiveGateway_1" targetRef="Task_0notify-mpon"/>

    <bpmn:task id="Task_0notify-mpon" name="MPOO notify MPON about no self-dismounting">
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="Task_0self-dismounting" targetRef="Task_0final-reading"/>
    <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="Task_0notify-mpon" targetRef="Task_0final-reading"/>

    <bpmn:task id="Task_0final-reading" name="Perform final reading">
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_7" sourceRef="Task_0final-reading" targetRef="Task_0dismount-old-equipment"/>

    <bpmn:task id="Task_0dismount-old-equipment" name="Dismount old equipment">
      <bpmn:outgoing>SequenceFlow_8</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_8" sourceRef="Task_0dismount-old-equipment" targetRef="Task_0mount-new-equipment"/>

    <bpmn:task id="Task_0mount-new-equipment" name="Mount new equipment">
      <bpmn:outgoing>SequenceFlow_9</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_9" sourceRef="Task_0mount-new-equipment" targetRef="Task_0read-meter-count"/>

    <bpmn:task id="Task_0read-meter-count" name="Read meter count from installed meter">
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="Task_0read-meter-count" targetRef="Task_0send-values-to-go"/>

    <bpmn:task id="Task_0send-values-to-go" name="Send final reading values to GO">
      <bpmn:outgoing>SequenceFlow_11</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_11" sourceRef="Task_0send-values-to-go" targetRef="Task_0inform-device-changes-master-data-meter-count"/>

    <bpmn:task id="Task_0inform-device-changes-master-data-meter-count" name="Inform GO about device changes, master data and meter count at installation">
      <bpmn:outgoing>SequenceFlow_12</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_12" sourceRef="Task_0inform-device-changes-master-data-meter-count" targetRef="EndEvent_1"/>

    <bpmn:endEvent id="EndEvent_1">
      <bpmn:incoming>SequenceFlow_12</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>