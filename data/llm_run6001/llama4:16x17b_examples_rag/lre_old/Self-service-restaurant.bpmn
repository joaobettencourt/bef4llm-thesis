<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com/bpmn">
  <collaboration id="Collaboration_1">
    <participant id="Participant_1" name="Restaurant Service" processRef="Process_1"/>
  </collaboration>
  <process id="Process_1" isExecutable="true">
    <laneSet id="LaneSet_1">
      <lane id="Lane_1" name="Guest">
        <flowNodeRef>StartEvent_1</flowNodeRef>
      </lane>
      <lane id="Lane_2" name="Waiter/Employee">
        <flowNodeRef>UserTask_1</flowNodeRef>
        <flowNodeRef>ServiceTask_1</flowNodeRef>
        <flowNodeRef>ExclusiveGateway_1</flowNodeRef>
      </lane>
      <lane id="Lane_3" name="Chef">
        <flowNodeRef>ServiceTask_2</flowNodeRef>
      </lane>
    </laneSet>

    <!-- Core Flow Elements -->
    <startEvent id="StartEvent_1" name="Hungry Guest Arrives">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>

    <userTask id="UserTask_1" name="Guest Chooses Dish, Waits for Turn">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </userTask>

    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="UserTask_1"/>

    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_4</outgoing>
      <outgoing>SequenceFlow_5</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow_2" sourceRef="UserTask_1" targetRef="ExclusiveGateway_1"/>

    <userTask id="UserTask_2" name="Place Order with Waiter/Employee">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </userTask>

    <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_1" targetRef="UserTask_2"/>

    <serviceTask id="ServiceTask_1" name="Waiter/Employee Enters Order, Collects Money">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </serviceTask>

    <sequenceFlow id="SequenceFlow_6" sourceRef="UserTask_2" targetRef="ServiceTask_1"/>

    <exclusiveGateway id="ExclusiveGateway_2">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow_7" sourceRef="ServiceTask_1" targetRef="ExclusiveGateway_2"/>

    <serviceTask id="ServiceTask_2" name="Prepare Meal">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_9</outgoing>
    </serviceTask>

    <sequenceFlow id="SequenceFlow_5" sourceRef="ExclusiveGateway_1" targetRef="ServiceTask_2"/>

    <endEvent id="EndEvent_1" name="Guest Eats">
      <incoming>SequenceFlow_9</incoming>
    </endEvent>

    <sequenceFlow id="SequenceFlow_9" sourceRef="ServiceTask_2" targetRef="EndEvent_1"/>
  </process>
</definitions>