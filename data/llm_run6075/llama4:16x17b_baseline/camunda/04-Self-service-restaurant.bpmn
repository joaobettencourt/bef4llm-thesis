<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Restaurant Process" targetNamespace="http://example.com/restaurant">

   <process id="restaurantProcess" isExecutable="true">
     <startEvent id="guestEnters1">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="guestEnters1" targetRef="chooseDish"/>

     <task id="chooseDish" name="Choose a dish from the changing meal range">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow2" sourceRef="chooseDish" targetRef="waitForTurn"/>

     <task id="waitForTurn" name="Wait until it is his turn">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow3" sourceRef="waitForTurn" targetRef="placeOrder"/>

     <task id="placeOrder1" name="Place order with the employee">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow4</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow4" sourceRef="placeOrder1" targetRef="employeeEnterOrder"/>

     <task id="employeeEnterOrder" name="Employee enters the order into the POS system and collects money">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow5</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow5" sourceRef="employeeEnterOrder" targetRef="passOnBuzzer"/>

     <task id="passOnBuzzer1" name="Employee sets up a buzzer and passes it on to the guest">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow9</outgoing>
       <outgoing>sequenceFlow10</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow9" sourceRef="passOnBuzzer1" targetRef="informChef"/>

     <task id="informChef1" name="Employee informs the chef of the new meal order">
       <incoming>sequenceFlow9</incoming>
       <outgoing>sequenceFlow11</outgoing>

     </task>

     <sequenceFlow id="sequenceFlow10" sourceRef="passOnBuzzer1" targetRef="guestWaitForMeal"/>

     <task id="guestWaitForMeal1" name="Guest waits for the meal">
       <incoming>sequenceFlow10</incoming>
    
     </task>

     <sequenceFlow id="sequenceFlow11" sourceRef="informChef1" targetRef="prepareMeal"/>

     <task id="prepareMeal1" name="Chef prepares the meal and places it in the service hatch">
       <incoming>sequenceFlow11</incoming>
       <outgoing>sequenceFlow12</outgoing>

     </task>

     <sequenceFlow id="sequenceFlow12" sourceRef="prepareMeal1" targetRef="chefInformEmployee"/>

     <task id="chefInformEmployee1" name="Chef informs the employee that he has placed the finished meal in the service hatch">
       <incoming>sequenceFlow12</incoming>
       <outgoing>sequenceFlow13</outgoing>

     </task>

     <sequenceFlow id="sequenceFlow13" sourceRef="chefInformEmployee1" targetRef="employeeSetOffBuzzer"/>

     <task id="employeeSetOffBuzzer1" name="Employee sets off the guest's buzzer">
       <incoming>sequenceFlow13</incoming>
       <outgoing>sequenceFlow14</outgoing>

     </task>

     <sequenceFlow id="sequenceFlow14" sourceRef="employeeSetOffBuzzer1" targetRef="guestPicksUpMeal"/>

     <task id="guestPicksUpMeal1" name="Guest picks up his meal">
       <incoming>sequenceFlow14</incoming>
    
     </task>

     <endEvent id="endEvent1">
       <incoming>sequenceFlow14</incoming>
     </endEvent>

   </process>
</definitions>