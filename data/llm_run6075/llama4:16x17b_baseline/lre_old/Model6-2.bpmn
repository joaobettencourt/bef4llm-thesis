<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" 
             targetNamespace="http://example.com/bpmn">

   <process id="orderProcess" isExecutable="true">
     <startEvent id="startEvent1">
       <outgoing>sequenceFlow1</outgoing>
       <timerEventDefinition>
         <timeCycle>P1M</timeCycle>
       </timerEventDefinition>
     </startEvent>

     <serviceTask id="sendOrderToSupplier" name="Send Order to Supplier">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="sendOrderToSupplier"/>

     <serviceTask id="supplierProcessesOrder" name="Process Order">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlow2" sourceRef="sendOrderToSupplier" targetRef="supplierProcessesOrder"/>

     <serviceTask id="sendInvoiceToAssembler" name="Send Invoice to Assembler AG">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow4</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlow3" sourceRef="supplierProcessesOrder" targetRef="sendInvoiceToAssembler"/>

     <serviceTask id="receiveInvoice" name="Receive Invoice">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow5</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlow4" sourceRef="sendInvoiceToAssembler" targetRef="receiveInvoice"/>

     <endEvent id="endEvent1">
       <incoming>sequenceFlow5</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow5" sourceRef="receiveInvoice" targetRef="endEvent1"/>
   </process>
</definitions>