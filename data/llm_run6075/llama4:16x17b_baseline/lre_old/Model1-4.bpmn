<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Go Public Process" targetNamespace="http://example.com/bpmn">

   <process id="goPublicProcess" isExecutable="true">
     <startEvent id="startEvent1">
       <outgoing>selectUnderwriters</outgoing>
     </startEvent>

     <sequenceFlow id="selectUnderwriters" sourceRef="startEvent1" targetRef="selectUnderwritersTask"/>

     <task id="selectUnderwritersTask" name="Select Underwriters">
       <incoming>selectUnderwriters</incoming>
       <outgoing>prepareRegistrationStatement</outgoing>
     </task>

     <sequenceFlow id="prepareRegistrationStatement" sourceRef="selectUnderwritersTask" targetRef="prepareRegistrationStatementTask"/>

     <task id="prepareRegistrationStatementTask" name="Prepare Registration Statement">
       <incoming>prepareRegistrationStatement</incoming>
       <outgoing>registerWithSEC</outgoing>
     </task>

     <sequenceFlow id="registerWithSEC" sourceRef="prepareRegistrationStatementTask" targetRef="registerWithSECTask"/>

     <task id="registerWithSECTask" name="Register with SEC">
       <incoming>registerWithSEC</incoming>
       <outgoing>complyBlueSkyLaws</outgoing>
     </task>

     <sequenceFlow id="complyBlueSkyLaws" sourceRef="registerWithSECTask" targetRef="complyBlueSkyLawsTask"/>

     <task id="complyBlueSkyLawsTask" name="Comply with Blue-Sky Laws">
       <incoming>complyBlueSkyLaws</incoming>
       <outgoing>roadShow</outgoing>
     </task>

     <sequenceFlow id="roadShow" sourceRef="complyBlueSkyLawsTask" targetRef="roadShowTask"/>

     <task id="roadShowTask" name="Road Show">
       <incoming>roadShow</incoming>
       <outgoing>fixIssuePrice</outgoing>
     </task>

     <sequenceFlow id="fixIssuePrice" sourceRef="roadShowTask" targetRef="exclusiveGatewayFixIssue"/>

     <exclusiveGateway id="exclusiveGatewayFixIssue1">
       <incoming>fixIssuePrice</incoming>
       <outgoing>clearanceReceived</outgoing>
       <outgoing>dontProceed</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="clearanceReceived" name="yes" sourceRef="exclusiveGatewayFixIssue1" targetRef="fixAndOfferTask">
       <conditionExpression xsi:type="tFormalExpression">${clearance  == true}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="dontProceed" name="no" sourceRef="exclusiveGatewayFixIssue1" targetRef="endEventDontProceed">
       <conditionExpression xsi:type="tFormalExpression">${clearance  != true}</conditionExpression>
     </sequenceFlow>

     <task id="fixAndOfferTask" name="Fix Issue Price and Offer to Public">
       <incoming>clearanceReceived</incoming>
       <outgoing>endEventSuccessFlow</outgoing>
     </task>

     <sequenceFlow id="endEventSuccessFlow" sourceRef="fixAndOfferTask" targetRef="endEventSuccess"/>

     <endEvent id="endEventSuccess">
       <incoming>endEventSuccessFlow</incoming>
     </endEvent>

     <endEvent id="endEventDontProceed1">
       <incoming>dontProceed</incoming>
     </endEvent>
   </process>
</definitions>