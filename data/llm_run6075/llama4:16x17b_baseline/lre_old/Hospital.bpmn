<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
                  id="definitions" name="Examination Process">

  <bpmn:process id="examinationProcess" isExecutable="true">
    <!-- Start Event -->
    <bpmn:startEvent id="startExam" name="Patient Examination">
      <bpmn:outgoing>sequenceFlow1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Decision by Outpatient Physician -->
    <bpmn:exclusiveGateway id="decision" name="Healthy or Additional Examination?">
      <bpmn:incoming>sequenceFlow1</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow2</bpmn:outgoing>
      <bpmn:outgoing>sequenceFlow3</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="sequenceFlow1" sourceRef="startExam" targetRef="decision"/>
    <bpmn:sequenceFlow id="sequenceFlow2" sourceRef="decision" targetRef="fillForm"/>
    <bpmn:sequenceFlow id="sequenceFlow3" sourceRef="decision" targetRef="orderExamination"/>

    <!-- Healthy -->
    <bpmn:task id="fillForm" name="Fill out Examination Form">
      <bpmn:incoming>sequenceFlow2</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow4</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="sequenceFlow4" sourceRef="fillForm" targetRef="endExam"/>

    <!-- Additional Examination -->
    <bpmn:task id="orderExamination" name="Place Examination and Follow-up Treatment Order">
      <bpmn:incoming>sequenceFlow3</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow5</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="sequenceFlow5" sourceRef="orderExamination" targetRef="requestForm"/>

    <!-- Request Form -->
    <bpmn:task id="requestForm" name="Fill out Request Form">
      <bpmn:incoming>sequenceFlow5</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow6</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="sequenceFlow6" sourceRef="requestForm" targetRef="informPatient"/>

    <!-- Inform Patient -->
    <bpmn:task id="informPatient" name="Inform Patient about Potential Risks">
      <bpmn:incoming>sequenceFlow6</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow7</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="sequenceFlow7" sourceRef="informPatient" targetRef="consent"/>

    <!-- Patient Consent -->
    <bpmn:exclusiveGateway id="consent" name="Does patient consent?">
      <bpmn:incoming>sequenceFlow7</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow8</bpmn:outgoing>
      <bpmn:outgoing>sequenceFlow9</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="sequenceFlow8" sourceRef="consent" targetRef="arrangeAppointment"/>
    <bpmn:sequenceFlow id="sequenceFlow9" sourceRef="consent" targetRef="endExam"/>

    <!-- Agreed -->
    <bpmn:task id="arrangeAppointment" name="Arrange Appointment with Ward">
      <bpmn:incoming>sequenceFlow8</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow10</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="sequenceFlow10" sourceRef="arrangeAppointment" targetRef="prepareExamination"/>

    <!-- Prepare Examination -->
    <bpmn:task id="prepareExamination" name="Prepare Required Examination and Sampling">
      <bpmn:incoming>sequenceFlow10</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow11</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="sequenceFlow11" sourceRef="prepareExamination" targetRef="takeSample"/>

    <!-- Take Sample -->
    <bpmn:task id="takeSample" name="Take Sample">
      <bpmn:incoming>sequenceFlow11</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow12</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="sequenceFlow12" sourceRef="takeSample" targetRef="sendToLab"/>

    <!-- Send to Lab -->
    <bpmn:task id="sendToLab" name="Send Sample to Lab">
      <bpmn:incoming>sequenceFlow12</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow13</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="sequenceFlow13" sourceRef="sendToLab" targetRef="validateSample"/>

    <!-- Validate Sample -->
    <bpmn:exclusiveGateway id="validateSample" name="Is sample valid?">
      <bpmn:incoming>sequenceFlow13</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow14</bpmn:outgoing>
      <bpmn:outgoing>sequenceFlow15</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="sequenceFlow14" sourceRef="validateSample" targetRef="analyseSample"/>
    <bpmn:sequenceFlow id="sequenceFlow15" sourceRef="validateSample" targetRef="endExam"/>

    <!-- Valid -->
    <bpmn:task id="analyseSample" name="Analyse Sample">
      <bpmn:incoming>sequenceFlow14</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow16</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="sequenceFlow16" sourceRef="analyseSample" targetRef="validateResults"/>

    <!-- Validate Results -->
    <bpmn:task id="validateResults" name="Validate Analysis Results">
      <bpmn:incoming>sequenceFlow16</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow17</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="sequenceFlow17" sourceRef="validateResults" targetRef="diagnosis"/>

    <!-- Diagnosis and Therapy -->
    <bpmn:task id="diagnosis" name="Make Diagnosis and Prescribe Therapy">
      <bpmn:incoming>sequenceFlow17</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow18</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="sequenceFlow18" sourceRef="diagnosis" targetRef="endExam"/>

    <!-- End Event -->
    <bpmn:endEvent id="endExam" name="Examination Finished">
      <bpmn:incoming>sequenceFlow4</bpmn:incoming>
      <bpmn:incoming>sequenceFlow9</bpmn:incoming>
      <bpmn:incoming>sequenceFlow15</bpmn:incoming>
      <bpmn:incoming>sequenceFlow18</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>