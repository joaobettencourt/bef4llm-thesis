<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" name="Restaurant Process" targetNamespace="http://example.com/restaurant">

   <process id="restaurantProcess" isExecutable="true">
     <startEvent id="startEvent1">
       <outgoing>sf1</outgoing>
     </startEvent>

     <sequenceFlow id="sf1" sourceRef="startEvent1" targetRef="chooseDish"/>

     <task id="chooseDish" name="Choose a dish from the changing meal range">
       <incoming>sf1</incoming>
       <outgoing>sf2</outgoing>
     </task>

     <sequenceFlow id="sf2" sourceRef="chooseDish" targetRef="waitForTurn"/>

     <task id="waitForTurn" name="Wait until it is his turn">
       <incoming>sf2</incoming>
       <outgoing>sf3</outgoing>
     </task>

     <sequenceFlow id="sf3" sourceRef="waitForTurn" targetRef="placeOrder"/>

     <task id="placeOrder" name="Place order with the employee">
       <incoming>sf3</incoming>
       <outgoing>sf4</outgoing>
     </task>

     <sequenceFlow id="sf4" sourceRef="placeOrder" targetRef="employeeProcessOrder"/>

     <task id="employeeProcessOrder" name="Enter order into POS system and collect money">
       <incoming>sf4</incoming>
       <outgoing>sf5</outgoing>
     </task>

     <sequenceFlow id="sf5" sourceRef="employeeProcessOrder" targetRef="passOnBuzzer"/>

     <task id="passOnBuzzer" name="Pass on buzzer and inform about meal readiness">
       <incoming>sf5</incoming>
       <outgoing>sf6</outgoing>
     </task>

     <sequenceFlow id="sf6" sourceRef="passOnBuzzer" targetRef="informChef"/>

     <task id="informChef" name="Inform the chef of the new meal order">
       <incoming>sf6</incoming>
       <outgoing>sf7</outgoing>
     </task>

     <sequenceFlow id="sf7" sourceRef="informChef" targetRef="chefPrepareMeal"/>

     <task id="chefPrepareMeal" name="Prepare the meal and place it in the service hatch">
       <incoming>sf7</incoming>
       <outgoing>sf8</outgoing>
     </task>

     <sequenceFlow id="sf8" sourceRef="chefPrepareMeal" targetRef="informEmployeeMealReady"/>

     <task id="informEmployeeMealReady" name="Inform employee that meal is ready">
       <incoming>sf8</incoming>
       <outgoing>sf9</outgoing>
     </task>

     <sequenceFlow id="sf9" sourceRef="informEmployeeMealReady" targetRef="employeeNotifyGuest"/>

     <task id="employeeNotifyGuest" name="Set off guest's buzzer to notify about meal readiness">
       <incoming>sf9</incoming>
       <outgoing>sf10</outgoing>
     </task>

     <sequenceFlow id="sf10" sourceRef="employeeNotifyGuest" targetRef="guestPicksUpMeal"/>

     <task id="guestPicksUpMeal" name="Pick up meal">
       <incoming>sf10</incoming>
       <outgoing>sf11</outgoing>
     </task>

     <sequenceFlow id="sf11" sourceRef="guestPicksUpMeal" targetRef="endEvent1"/>

     <endEvent id="endEvent1">
       <incoming>sf11</incoming>
     </endEvent>

   </process>
</definitions>