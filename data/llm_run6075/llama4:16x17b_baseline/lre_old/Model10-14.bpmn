<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Bill Examination Process">

  <process id="billExaminationProcess" isExecutable="true">
    <startEvent id="startEvent1">
      <outgoing>sequenceFlow1</outgoing>
    </startEvent>

    <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="exclusiveGateway"/>

    <exclusiveGateway id="exclusiveGateway">
      <incoming>sequenceFlow1</incoming>
      <outgoing>sequenceFlow2</outgoing>
      <outgoing>sequenceFlow7</outgoing>
      <outgoing>sequenceFlow12</outgoing>
      <outgoing>sequenceFlow17</outgoing>
    </exclusiveGateway>

    <!-- MPOO sends bill for temporary continuation of metering point operations -->
    <sequenceFlow id="sequenceFlow2" sourceRef="exclusiveGateway" targetRef="task1">
      <conditionExpression xsi:type="tFormalExpression">${billType == 'MPOO_temp_continuation'}</conditionExpression>
    </sequenceFlow>

    <userTask id="task1" name="Examine bill for temporary continuation of metering point operations">
      <incoming>sequenceFlow2</incoming>
      <outgoing>sequenceFlow3</outgoing>
    </userTask>

    <sequenceFlow id="sequenceFlow3" sourceRef="task1" targetRef="exclusiveGateway2"/>

    <!-- MSPO sends bill for temporary continuation of measurement -->
    <sequenceFlow id="sequenceFlow7" sourceRef="exclusiveGateway" targetRef="task2">
      <conditionExpression xsi:type="tFormalExpression">${billType == 'MSPO_temp_continuation'}</conditionExpression>
    </sequenceFlow>

    <userTask id="task2" name="Examine bill for temporary continuation of measurement">
      <incoming>sequenceFlow7</incoming>
      <outgoing>sequenceFlow8</outgoing>
    </userTask>

    <sequenceFlow id="sequenceFlow8" sourceRef="task2" targetRef="exclusiveGateway2"/>

    <!-- MSPO sends bill for additional readings -->
    <sequenceFlow id="sequenceFlow12" sourceRef="exclusiveGateway" targetRef="task3">
      <conditionExpression xsi:type="tFormalExpression">${billType == 'MSPO_additional_readings'}</conditionExpression>
    </sequenceFlow>

    <userTask id="task3" name="Examine bill for additional readings">
      <incoming>sequenceFlow12</incoming>
      <outgoing>sequenceFlow13</outgoing>
    </userTask>

    <sequenceFlow id="sequenceFlow13" sourceRef="task3" targetRef="exclusiveGateway2"/>

    <!-- MPOO sends bill for equipment acquisition -->
    <sequenceFlow id="sequenceFlow17" sourceRef="exclusiveGateway" targetRef="task4">
      <conditionExpression xsi:type="tFormalExpression">${billType == 'MPOO_equipment_acquisition'}</conditionExpression>
    </sequenceFlow>

    <userTask id="task4" name="Examine bill for equipment acquisition">
      <incoming>sequenceFlow17</incoming>
      <outgoing>sequenceFlow18</outgoing>
    </userTask>

    <sequenceFlow id="sequenceFlow18" sourceRef="task4" targetRef="exclusiveGateway2"/>

    <exclusiveGateway id="exclusiveGateway2">
      <incoming>sequenceFlow3</incoming>
      <incoming>sequenceFlow8</incoming>
      <incoming>sequenceFlow13</incoming>
      <incoming>sequenceFlow18</incoming>
      <outgoing>sequenceFlow4</outgoing>
      <outgoing>sequenceFlow5</outgoing>
    </exclusiveGateway2>

    <!-- Confirm invoice with payment advice -->
    <sequenceFlow id="sequenceFlow4" sourceRef="exclusiveGateway2" targetRef="task5">
      <conditionExpression xsi:type="tFormalExpression">${confirmation == 'true'}</conditionExpression>
    </sequenceFlow>

    <userTask id="task5" name="Confirm invoice with payment advice">
      <incoming>sequenceFlow4</incoming>
      <outgoing>sequenceFlow6</outgoing>
    </userTask>

    <!-- Reject invoice -->
    <sequenceFlow id="sequenceFlow5" sourceRef="exclusiveGateway2" targetRef="task6">
      <conditionExpression xsi:type="tFormalExpression">${confirmation == 'false'}</conditionExpression>
    </sequenceFlow>

    <userTask id="task6" name="Reject invoice">
      <incoming>sequenceFlow5</incoming>
      <outgoing>sequenceFlow9</outgoing>
    </userTask>

    <endEvent id="endEvent1">
      <incoming>sequenceFlow6</incoming>
      <incoming>sequenceFlow9</incoming>
    </endEvent>

    <sequenceFlow id="sequenceFlow6" sourceRef="task5" targetRef="endEvent1"/>
    <sequenceFlow id="sequenceFlow9" sourceRef="task6" targetRef="endEvent1"/>

  </process>

</definitions>