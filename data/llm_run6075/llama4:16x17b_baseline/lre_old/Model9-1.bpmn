<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Backup and Defaulters Process">

   <process id="backupAndDefaultersProcess" isExecutable="true">
     <startEvent id="startEvent1">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="taskBackupDatabase"/>

     <serviceTask id="taskBackupDatabase">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlow2" sourceRef="taskBackupDatabase" targetRef="exclusiveGateway1"/>

     <exclusiveGateway id="exclusiveGateway1">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
       <outgoing>sequenceFlow4</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow3" sourceRef="exclusiveGateway1" targetRef="taskRegisterDefaulters">
       <conditionExpression xsi:type="tFormalExpression">${newRecordsFound()}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="sequenceFlow4" sourceRef="exclusiveGateway1" targetRef="taskCheckCRMSystem">
       <conditionExpression xsi:type="tFormalExpression">${not newRecordsFound()}</conditionExpression>
     </sequenceFlow>

     <serviceTask id="taskRegisterDefaulters">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow5</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlow5" sourceRef="taskRegisterDefaulters" targetRef="exclusiveGateway2"/>

     <exclusiveGateway id="exclusiveGateway2">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow6</outgoing>
       <outgoing>sequenceFlow7</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow6" sourceRef="exclusiveGateway2" targetRef="endEvent1">
       <conditionExpression xsi:type="tFormalExpression">${previouslyAdvised()}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="sequenceFlow7" sourceRef="exclusiveGateway2" targetRef="taskProduceReport">
       <conditionExpression xsi:type="tFormalExpression">${not previouslyAdvised()}</conditionExpression>
     </sequenceFlow>

     <serviceTask id="taskCheckCRMSystem">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow8</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlow8" sourceRef="taskCheckCRMSystem" targetRef="exclusiveGateway3"/>

     <exclusiveGateway id="exclusiveGateway3">
       <incoming>sequenceFlow8</incoming>
       <outgoing>sequenceFlow9</outgoing>
       <outgoing>sequenceFlow10</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow9" sourceRef="exclusiveGateway3" targetRef="taskRegisterDefaulters">
       <conditionExpression xsi:type="tFormalExpression">${newReturnsFiled()}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="sequenceFlow10" sourceRef="exclusiveGateway3" targetRef="endEvent1">
       <conditionExpression xsi:type="tFormalExpression">${not newReturnsFiled()}</conditionExpression>
     </sequenceFlow>

     <serviceTask id="taskProduceReport">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow11</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlow11" sourceRef="taskProduceReport" targetRef="exclusiveGateway4"/>

     <exclusiveGateway id="exclusiveGateway4">
       <incoming>sequenceFlow11</incoming>
       <outgoing>sequenceFlow12</outgoing>
       <outgoing>sequenceFlow13</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow12" sourceRef="exclusiveGateway4" targetRef="taskReconcileCRM">
       <conditionExpression xsi:type="tFormalExpression">${completedBy1530()}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="sequenceFlow13" sourceRef="exclusiveGateway4" targetRef="taskSendAlertSupervisor">
       <conditionExpression xsi:type="tFormalExpression">${not completedBy1530()}</conditionExpression>
     </sequenceFlow>

     <serviceTask id="taskReconcileCRM">
       <incoming>sequenceFlow12</incoming>
       <outgoing>sequenceFlow14</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlow14" sourceRef="taskReconcileCRM" targetRef="exclusiveGateway5"/>

     <exclusiveGateway id="exclusiveGateway5">
       <incoming>sequenceFlow14</incoming>
       <outgoing>sequenceFlow15</outgoing>
       <outgoing>sequenceFlow16</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow15" sourceRef="exclusiveGateway5" targetRef="endEvent1">
       <conditionExpression xsi:type="tFormalExpression">${completedBy1600()}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="sequenceFlow16" sourceRef="exclusiveGateway5" targetRef="taskSendMessageSupervisor">
       <conditionExpression xsi:type="tFormalExpression">${not completedBy1600()}</conditionExpression>
     </sequenceFlow>

     <serviceTask id="taskSendAlertSupervisor">
       <incoming>sequenceFlow13</incoming/>
     </serviceTask>

     <serviceTask id="taskSendMessageSupervisor">
       <incoming>sequenceFlow16</incoming/>
     </serviceTask>

     <endEvent id="endEvent1">
       <incoming>sequenceFlow6</incoming>
       <incoming>sequenceFlow10</incoming>
       <incoming>sequenceFlow15</incoming>
     </endEvent>
   </process>
 </definitions>