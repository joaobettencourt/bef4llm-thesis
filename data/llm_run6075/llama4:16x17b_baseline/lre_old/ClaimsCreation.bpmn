<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" name="Claims Handling Process" targetNamespace="http://claims.handling.process">

   <process id="claimsHandlingProcess" isExecutable="true">
     <startEvent id="startEvent1">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="taskSearchPoliceReport"/>

     <serviceTask id="taskSearchPoliceReport" name="Search Police Report within Police Report database and put in a file together with the Claim Documentation">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlow2" sourceRef="taskSearchPoliceReport" targetRef="taskCalculateClaimEstimate"/>

     <userTask id="taskCalculateClaimEstimate" name="Calculate initial claim estimate">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow3" sourceRef="taskCalculateClaimEstimate" targetRef="taskCreateActionPlan"/>

     <userTask id="taskCreateActionPlan" name="Create Action Plan based on an Action Plan Checklist">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow4</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow4" sourceRef="taskCreateActionPlan" targetRef="taskNegotiateSettlement"/>

     <userTask id="taskNegotiateSettlement" name="Negotiate a settlement on the claim estimate">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow5</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow5" sourceRef="taskNegotiateSettlement" targetRef="endEvent1"/>

     <endEvent id="endEvent1" name="Inform claimant of the outcome">
       <incoming>sequenceFlow5</incoming>
     </endEvent>
   </process>
</definitions>