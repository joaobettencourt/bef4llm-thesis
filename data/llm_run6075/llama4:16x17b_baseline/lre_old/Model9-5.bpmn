<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Expense Report Process">

   <process id="expenseReportProcess" isExecutable="true">
     <startEvent id="startEvent1">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="taskCreateAccount"/>

     <task id="taskCreateAccount" name="Create new account if necessary">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow2" sourceRef="taskCreateAccount" targetRef="exclusiveGatewayReviewReport"/>

     <exclusiveGateway id="exclusiveGatewayReviewReport">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
       <outgoing>sequenceFlow4</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow3" name="Automatic Approval" sourceRef="exclusiveGatewayReviewReport" targetRef="taskAutoApprove">
       <conditionExpression xsi:type="tFormalExpression">${amount < 200}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="sequenceFlow4" name="Supervisor Approval Required" sourceRef="exclusiveGatewayReviewReport" targetRef="userTaskSupervisorApproval">
       <conditionExpression xsi:type="tFormalExpression">${amount >= 200}</conditionExpression>
     </sequenceFlow>

     <task id="taskAutoApprove" name="Automatic Approve Expense Report">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow5</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow5" sourceRef="taskAutoApprove" targetRef="exclusiveGatewayPayment"/>

     <userTask id="userTaskSupervisorApproval" name="Request Supervisor Approval">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow6</outgoing>
       <outgoing>sequenceFlow7</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow6" name="Approved" sourceRef="userTaskSupervisorApproval" targetRef="exclusiveGatewayPayment">
       <conditionExpression xsi:type="tFormalExpression">${approvalResult == 'approved'}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="sequenceFlow7" name="Rejected" sourceRef="userTaskSupervisorApproval" targetRef="serviceTaskSendRejectionEmail">
       <conditionExpression xsi:type="tFormalExpression">${approvalResult == 'rejected'}</conditionExpression>
     </sequenceFlow>

     <serviceTask id="serviceTaskSendRejectionEmail" name="Send Rejection Email to Employee">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow8</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlow8" sourceRef="serviceTaskSendRejectionEmail" targetRef="endEvent2"/>

     <exclusiveGateway id="exclusiveGatewayPayment">
       <incoming>sequenceFlow5</incoming>
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow9</outgoing>
       <outgoing>sequenceFlow10</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow9" sourceRef="exclusiveGatewayPayment" targetRef="taskReimburseEmployee">
       <!-- <conditionExpression xsi:type="tFormalExpression">${paymentMethod == 'direct deposit'}</conditionExpression> -->
     </sequenceFlow>

     <sequenceFlow id="sequenceFlow10" sourceRef="exclusiveGatewayPayment" targetRef="endEvent1"/>

     <task id="taskReimburseEmployee" name="Reimburse Employee via Direct Deposit">
       <incoming>sequenceFlow9</incoming>
       <!-- <outgoing>sequenceFlow11</outgoing> -->
     </task>

     <intermediateCatchEvent id="intermediateCatchEventInProgress">
       <timerEventDefinition>
         <timeDuration>P7D</timeDuration>
       </timerEventDefinition>
       <incoming>sequenceFlow12</incoming>
       <!-- <outgoing>sequenceFlow13</outgoing> -->
     </intermediateCatchEvent>

     <sequenceFlow id="sequenceFlow12" sourceRef="userTaskSupervisorApproval" targetRef="intermediateCatchEventInProgress"/>

     <serviceTask id="serviceTaskSendInProgressEmail" name="Send Approval In Progress Email to Employee">
       <!-- <incoming>sequenceFlow13</incoming> -->
       <!-- <outgoing>sequenceFlow14</outgoing> -->
     </serviceTask>

     <intermediateCatchEvent id="intermediateCatchEventCancel">
       <timerEventDefinition>
         <timeDuration>P30D</timeDuration>
       </timerEventDefinition>
       <!-- <incoming>sequenceFlow14</incoming> -->
       <!-- <outgoing>sequenceFlow15</outgoing> -->
     </intermediateCatchEvent>

     <serviceTask id="serviceTaskSendCancellationEmail" name="Send Cancellation Email to Employee and Request Resubmission">
       <!-- <incoming>sequenceFlow15</incoming> -->
     </serviceTask>

     <endEvent id="endEvent1">
       <!-- <incoming>sequenceFlow10</incoming> -->
       <!-- <incoming>sequenceFlow11</incoming> -->
     </endEvent>

     <endEvent id="endEvent2">
       <incoming>sequenceFlow8</incoming>
     </endEvent>

   </process>

</definitions>