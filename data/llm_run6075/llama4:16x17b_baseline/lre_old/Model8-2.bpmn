<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" 
             targetNamespace="http://example.com/bpmn">

   <process id="jobPostingProcess" isExecutable="true">
     <startEvent id="vacancyReported">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="vacancyReported" targetRef="taskCreateJobDescription"/>

     <userTask id="taskCreateJobDescription" name="Create Job Description">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
       <outgoing>sequenceFlow3</outgoing>
     </userTask>

     <exclusiveGateway id="gateway1">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow4</outgoing>
       <outgoing>sequenceFlow5</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow2" sourceRef="taskCreateJobDescription" targetRef="gateway1"/>

     <sequenceFlow id="sequenceFlow4" name="need more info" sourceRef="gateway1" targetRef="taskAskDepartmentForInfo">
       <!-- conditionExpression could be added here -->
     </sequenceFlow>

     <userTask id="taskAskDepartmentForInfo" name="Ask Department for Info">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow6</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow6" sourceRef="taskAskDepartmentForInfo" targetRef="taskCreateJobDescription"/>

     <sequenceFlow id="sequenceFlow5" name="enough info" sourceRef="gateway1" targetRef="taskSubmitForApproval">
       <!-- conditionExpression could be added here -->
     </sequenceFlow>

     <userTask id="taskSubmitForApproval" name="Submit for Approval">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow7</outgoing>
     </userTask>

     <exclusiveGateway id="gateway2">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow8</outgoing>
       <outgoing>sequenceFlow9</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow7" sourceRef="taskSubmitForApproval" targetRef="gateway2"/>

     <sequenceFlow id="sequenceFlow8" name="approved" sourceRef="gateway2" targetRef="taskPostJob">
       <!-- conditionExpression could be added here -->
     </sequenceFlow>

     <userTask id="taskPostJob" name="Post Job">
       <incoming>sequenceFlow8</incoming>
       <outgoing>sequenceFlow10</outgoing>
     </userTask>

     <endEvent id="endProcess">
       <incoming>sequenceFlow10</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow10" sourceRef="taskPostJob" targetRef="endProcess"/>

     <sequenceFlow id="sequenceFlow9" name="needs correction" sourceRef="gateway2" targetRef="taskCorrectDescription">
       <!-- conditionExpression could be added here -->
     </sequenceFlow>

     <userTask id="taskCorrectDescription" name="Correct Description">
       <incoming>sequenceFlow9</incoming>
       <outgoing>sequenceFlow11</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow11" sourceRef="taskCorrectDescription" targetRef="taskSubmitForApproval"/>
   </process>
 </definitions>