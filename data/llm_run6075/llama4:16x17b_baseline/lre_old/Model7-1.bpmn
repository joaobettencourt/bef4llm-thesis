<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" targetNamespace="http://www.example.com/bpmn">

  <process id="lead_process" isExecutable="true">
    <laneSet>
      <lane id="manager_lane" name="Manager">
        <flowNodeRef>StartEvent</flowNodeRef>
        <flowNodeRef>Task_Select_Top_Leads</flowNodeRef>
        <flowNodeRef>ExclusiveGateway_Check_Interest</flowNodeRef>
        <flowNodeRef>Task_Process_Lead</flowNodeRef>
        <flowNodeRef>EndEvent</flowNodeRef>
      </lane>
      <lane id="sales_assistant_lane" name="Sales Assistant">
        <flowNodeRef>Task_Call_Customers</flowNodeRef>
      </lane>
    </laneSet>

    <startEvent id="StartEvent" name="Check Open Leads">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>

    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent" targetRef="Task_Select_Top_Leads"/>

    <task id="Task_Select_Top_Leads" name="Select Top Five Leads">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_Select_Top_Leads" targetRef="Task_Call_Customers"/>

    <task id="Task_Call_Customers" name="Call Contact Persons">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_3" sourceRef="Task_Call_Customers" targetRef="ExclusiveGateway_Check_Interest"/>

    <exclusiveGateway id="ExclusiveGateway_Check_Interest">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_4</outgoing>
      <outgoing>SequenceFlow_5</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow_4" name="Interested" sourceRef="ExclusiveGateway_Check_Interest" targetRef="Task_Process_Lead">
      <conditionExpression xsi:type="tFormalExpression">${interest == true}</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="SequenceFlow_5" name="Not Interested" sourceRef="ExclusiveGateway_Check_Interest" targetRef="Task_Call_Customers">
      <conditionExpression xsi:type="tFormalExpression">${interest == false}</conditionExpression>
    </sequenceFlow>

    <task id="Task_Process_Lead" name="Process Lead">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_6" sourceRef="Task_Process_Lead" targetRef="EndEvent"/>

    <endEvent id="EndEvent" name="Lead Processed">
      <incoming>SequenceFlow_6</incoming>
    </endEvent>

  </process>

</definitions>