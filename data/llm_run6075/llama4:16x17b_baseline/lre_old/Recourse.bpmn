<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Subrogation Process">

   <process id="subrogationProcess" isExecutable="true">
     <startEvent id="startEvent1" name="Possible Subrogation Case">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="exclusiveGateway1"/>

     <exclusiveGateway id="exclusiveGateway1">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
       <outgoing>sequenceFlow3</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow2" name="Recourse Possible" sourceRef="exclusiveGateway1" targetRef="userTask1">
       <conditionExpression xsi:type="tFormalExpression">${recoursePossible  == true}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="sequenceFlow3" name="Recourse Not Possible" sourceRef="exclusiveGateway1" targetRef="endEvent2">
       <conditionExpression xsi:type="tFormalExpression">${recoursePossible  == false}</conditionExpression>
     </sequenceFlow>

     <userTask id="userTask1" name="Send Request for Payment and Create Reminder">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow4</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow4" sourceRef="userTask1" targetRef="exclusiveGateway2"/>

     <exclusiveGateway id="exclusiveGateway2">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow5</outgoing>
       <outgoing>sequenceFlow6</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow5" name="Payment Received" sourceRef="exclusiveGateway2" targetRef="userTask2">
       <conditionExpression xsi:type="tFormalExpression">${paymentReceived  == true}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="sequenceFlow6" name="Disagreement or No Payment" sourceRef="exclusiveGateway2" targetRef="exclusiveGateway3"/>

     <userTask id="userTask2" name="Make Booking and Close Case">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow7</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow7" sourceRef="userTask2" targetRef="endEvent1"/>

     <exclusiveGateway id="exclusiveGateway3">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow8</outgoing>
       <outgoing>sequenceFlow9</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow8" name="Insurant Right" sourceRef="exclusiveGateway3" targetRef="endEvent1">
       <conditionExpression xsi:type="tFormalExpression">${insurantRight()}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="sequenceFlow9" name="Forward to Collection Agency" sourceRef="exclusiveGateway3" targetRef="userTask3"/>

     <userTask id="userTask3" name="Forward Case to Collection Agency">
       <incoming>sequenceFlow9</incoming>
     </userTask>

     <endEvent id="endEvent1" name="Case Closed">
       <incoming>sequenceFlow7</incoming>
       <incoming>sequenceFlow8</incoming>
     </endEvent>

     <endEvent id="endEvent2" name="Close Case">
       <incoming>sequenceFlow3</incoming>
     </endEvent>
   </process>
</definitions>