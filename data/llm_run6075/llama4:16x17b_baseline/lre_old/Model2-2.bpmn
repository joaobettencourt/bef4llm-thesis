<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                 xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                 xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                 xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                 xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
                 id="definitions" name="Switch Over Request Process">

  <bpmn:process id="switchOverRequestProcess" isExecutable="true">
    <!-- Start Event -->
    <bpmn:startEvent id="startEvent1" name="Switch-over Request Received">
      <bpmn:outgoing>sequenceFlow1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Sequence Flow 1 -->
    <bpmn:sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="receiveCustomerData"/>

    <!-- Task: Receive Customer Data -->
    <bpmn:task id="receiveCustomerData" name="Receive Customer Data">
      <bpmn:incoming>sequenceFlow1</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow2</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow 2 -->
    <bpmn:sequenceFlow id="sequenceFlow2" sourceRef="receiveCustomerData" targetRef="enterCustomerDataIntoCRM"/>

    <!-- Task: Enter Customer Data into CRM -->
    <bpmn:task id="enterCustomerDataIntoCRM" name="Enter Customer Data into CRM">
      <bpmn:incoming>sequenceFlow2</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow3</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow 3 -->
    <bpmn:sequenceFlow id="sequenceFlow3" sourceRef="enterCustomerDataIntoCRM" targetRef="checkCustomerData"/>

    <!-- Task: Check Customer Data -->
    <bpmn:task id="checkCustomerData" name="Check Customer Data">
      <bpmn:incoming>sequenceFlow3</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow4</bpmn:outgoing>
      <bpmn:outgoing>sequenceFlow5</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow 4 (No Errors) -->
    <bpmn:sequenceFlow id="sequenceFlow4" sourceRef="checkCustomerData" targetRef="createCustomerObject"/>

    <!-- Sequence Flow 5 (Errors) -->
    <bpmn:sequenceFlow id="sequenceFlow5" sourceRef="checkCustomerData" targetRef="correctErrors"/>

    <!-- Task: Correct Errors -->
    <bpmn:task id="correctErrors" name="Correct Errors">
      <bpmn:incoming>sequenceFlow5</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow6</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow 6 -->
    <bpmn:sequenceFlow id="sequenceFlow6" sourceRef="correctErrors" targetRef="createCustomerObject"/>

    <!-- Task: Create Customer Object -->
    <bpmn:task id="createCustomerObject1" name="Create Customer Object">
      <bpmn:incoming>sequenceFlow4</bpmn:incoming>
      <bpmn:incoming>sequenceFlow6</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow7</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow 7 -->
    <bpmn:sequenceFlow id="sequenceFlow7" sourceRef="createCustomerObject1" targetRef="prepareContractDocuments"/>

    <!-- Task: Prepare Contract Documents -->
    <bpmn:task id="prepareContractDocuments1" name="Prepare Contract Documents">
      <bpmn:incoming>sequenceFlow7</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow8</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow 8 -->
    <bpmn:sequenceFlow id="sequenceFlow8" sourceRef="prepareContractDocuments1" targetRef="automatedCheckOfContractDocuments"/>

    <!-- Task: Automated Check of Contract Documents -->
    <bpmn:task id="automatedCheckOfContractDocuments1" name="Automated Check of Contract Documents">
      <bpmn:incoming>sequenceFlow8</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow9</bpmn:outgoing>
      <bpmn:outgoing>sequenceFlow10</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow 9 (Positive Response) -->
    <bpmn:sequenceFlow id="sequenceFlow9" sourceRef="automatedCheckOfContractDocuments1" targetRef="sendConfirmationDocumentToCustomer"/>

    <!-- Sequence Flow 10 (Negative Response) -->
    <bpmn:sequenceFlow id="sequenceFlow10" sourceRef="automatedCheckOfContractDocuments1" targetRef="analyzeAndResolveIssues"/>

    <!-- Task: Analyze and Resolve Issues -->
    <bpmn:task id="analyzeAndResolveIssues1" name="Analyze and Resolve Issues">
      <bpmn:incoming>sequenceFlow10</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow11</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow 11 -->
    <bpmn:sequenceFlow id="sequenceFlow11" sourceRef="analyzeAndResolveIssues1" targetRef="prepareContractDocuments1"/>

    <!-- Task: Send Confirmation Document to Customer -->
    <bpmn:task id="sendConfirmationDocumentToCustomer1" name="Send Confirmation Document to Customer">
      <bpmn:incoming>sequenceFlow9</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow12</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow 12 -->
    <bpmn:sequenceFlow id="sequenceFlow12" sourceRef="sendConfirmationDocumentToCustomer1" targetRef="requestGridOperatorForSupplierConcurrence"/>

    <!-- Task: Request Grid Operator for Supplier Concurrence -->
    <bpmn:task id="requestGridOperatorForSupplierConcurrence1" name="Request Grid Operator for Supplier Concurrence">
      <bpmn:incoming>sequenceFlow12</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow13</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow 13 -->
    <bpmn:sequenceFlow id="sequenceFlow13" sourceRef="requestGridOperatorForSupplierConcurrence1" targetRef="checkForSupplierConcurrence"/>

    <!-- Exclusive Gateway: Check for Supplier Concurrence -->
    <bpmn:exclusiveGateway id="checkForSupplierConcurrence1">
      <bpmn:incoming>sequenceFlow13</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow14</bpmn:outgoing>
      <bpmn:outgoing>sequenceFlow15</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flow 14 (Supplier Concurrence) -->
    <bpmn:sequenceFlow id="sequenceFlow14" sourceRef="checkForSupplierConcurrence1" targetRef="gridOperatorTerminatesSalesAgreement"/>

    <!-- Sequence Flow 15 (No Supplier Concurrence) -->
    <bpmn:sequenceFlow id="sequenceFlow15" sourceRef="checkForSupplierConcurrence1" targetRef="createCISContract"/>

    <!-- Task: Grid Operator Terminates Sales Agreement -->
    <bpmn:task id="gridOperatorTerminatesSalesAgreement1" name="Grid Operator Terminates Sales Agreement">
      <bpmn:incoming>sequenceFlow14</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow16</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow 16 -->
    <bpmn:sequenceFlow id="sequenceFlow16" sourceRef="gridOperatorTerminatesSalesAgreement1" targetRef="customerChecksContractDetails"/>

    <!-- Task: Create CIS Contract -->
    <bpmn:task id="createCISContract1" name="Create CIS Contract">
      <bpmn:incoming>sequenceFlow15</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow17</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow 17 -->
    <bpmn:sequenceFlow id="sequenceFlow17" sourceRef="createCISContract1" targetRef="customerChecksContractDetails"/>

    <!-- Task: Customer Checks Contract Details -->
    <bpmn:task id="customerChecksContractDetails1" name="Customer Checks Contract Details">
      <bpmn:incoming>sequenceFlow16</bpmn:incoming>
      <bpmn:incoming>sequenceFlow17</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow18</bpmn:outgoing>
      <bpmn:outgoing>sequenceFlow19</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow 18 (Confirm) -->
    <bpmn:sequenceFlow id="sequenceFlow18" sourceRef="customerChecksContractDetails1" targetRef="processContinues"/>

    <!-- Sequence Flow 19 (Withdraw) -->
    <bpmn:sequenceFlow id="sequenceFlow19" sourceRef="customerChecksContractDetails1" targetRef="processEnds"/>

    <!-- End Event -->
    <bpmn:endEvent id="processEnds">
      <bpmn:incoming>sequenceFlow19</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>