<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
                 id="definitions" name="Files Processing for Court Hearing">

  <bpmn:process id="filesProcessing" isExecutable="true">
    <bpmn:startEvent id="startEvent">
      <bpmn:outgoing>checkFiles</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:sequenceFlow id="checkFiles" sourceRef="startEvent" targetRef="task_check_files"/>

    <bpmn:userTask id="task_check_files" name="Check files for completeness">
      <bpmn:incoming>checkFiles</bpmn:incoming>
      <bpmn:outgoing>exclusiveGateway_sequence_flow_1</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:sequenceFlow id="exclusiveGateway_sequence_flow_1" sourceRef="task_check_files" targetRef="exclusive_gateway_missing_files"/>

    <bpmn:exclusiveGateway id="exclusive_gateway_missing_files">
      <bpmn:incoming>exclusiveGateway_sequence_flow_1</bpmn:incoming>
      <bpmn:outgoing>search_files</bpmn:outgoing>
      <bpmn:outgoing>files_ready</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="search_files" name="Files missing" sourceRef="exclusive_gateway_missing_files" targetRef="task_search_files">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${filesAreMissing()}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:userTask id="task_search_files" name="Search for files">
      <bpmn:incoming>search_files</bpmn:incoming>
      <bpmn:outgoing>files_ready_after_search</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:sequenceFlow id="files_ready_after_search" sourceRef="task_search_files" targetRef="exclusive_gateway_all_files_ready"/>

    <bpmn:sequenceFlow id="files_ready" name="No files missing" sourceRef="exclusive_gateway_missing_files" targetRef="exclusive_gateway_all_files_ready">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${!filesAreMissing()}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:exclusiveGateway id="exclusive_gateway_all_files_ready">
      <bpmn:incoming>files_ready_after_search</bpmn:incoming>
      <bpmn:incoming>files_ready</bpmn:incoming>
      <bpmn:outgoing>track_and_hand_over_files</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="task_track_and_hand_over_files" name="Track and hand over files to Associate">
      <bpmn:incoming>track_and_hand_over_files</bpmn:incoming>
      <bpmn:outgoing>distribute_judges_lawlist</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:sequenceFlow id="track_and_hand_over_files" sourceRef="exclusive_gateway_all_files_ready" targetRef="task_track_and_hand_over_files"/>

    <bpmn:userTask id="task_distribute_judges_lawlist" name="Distribute Judges Lawlist">
      <bpmn:incoming>distribute_judges_lawlist</bpmn:incoming>
      <bpmn:outgoing>conduct_directions_hearings</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:sequenceFlow id="distribute_judges_lawlist" sourceRef="task_track_and_hand_over_files" targetRef="task_distribute_judges_lawlist"/>

    <bpmn:userTask id="task_conduct_directions_hearings" name="Conduct directions hearings">
      <bpmn:incoming>conduct_directions_hearings</bpmn:incoming>
    </bpmn:userTask>

    <bpmn:sequenceFlow id="conduct_directions_hearings" sourceRef="task_distribute_judges_lawlist" targetRef="task_conduct_directions_hearings"/>

    <bpmn:endEvent id="end_event">
      <bpmn:incoming>conduct_directions_hearings</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>

</bpmn:definitions>