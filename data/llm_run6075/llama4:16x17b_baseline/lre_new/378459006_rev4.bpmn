<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">
  <process id="PaymentProcess" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="GeneratePaymentReport"/>
    <task id="GeneratePaymentReport" name="Generate Payment Report">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_2" sourceRef="GeneratePaymentReport" targetRef="PayVendor"/>
    <task id="PayVendor" name="Pay Vendor">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_3" sourceRef="PayVendor" targetRef="SendPaymentReportToClients"/>
    <task id="SendPaymentReportToClients" name="Send Payment Report to Clients (auto)">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_4</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_4" sourceRef="SendPaymentReportToClients" targetRef="ParallelGateway_1"/>
    <parallelGateway id="ParallelGateway_1">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_5</outgoing>
      <outgoing>SequenceFlow_6</outgoing>
    </parallelGateway>
    <sequenceFlow id="SequenceFlow_5" sourceRef="ParallelGateway_1" targetRef="SendPaymentReportToRegistryOffice"/>
    <task id="SendPaymentReportToRegistryOfficeTask" name="Send Payment Report to Registry Office">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_7" sourceRef="SendPaymentReportToRegistryOfficeTask" targetRef="ArchiveInvoices"/>
    <task id="ArchiveInvoicesTask" name="Archive Invoices (by vendor & payment date)">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_8" sourceRef="ArchiveInvoicesTask" targetRef="TrackPayment"/>
    <task id="TrackPaymentTask" name="Track Payment">
      <incoming>SequenceFlow_8</incoming>
      <outgoing>SequenceFlow_9</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_9" sourceRef="TrackPaymentTask" targetRef="EndEvent_1"/>
    <endEvent id="EndEvent_1">
      <incoming>SequenceFlow_9</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_6" sourceRef="ParallelGateway_1" targetRef="SendPaymentReportToAccountsReceivable"/>
    <task id="SendPaymentReportToAccountsReceivableTask" name="Send Payment Report to Accounts Receivable">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_10</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_10" sourceRef="SendPaymentReportToAccountsReceivableTask" targetRef="GenerateMonthlyInvoice"/>
    <task id="GenerateMonthlyInvoiceTask" name="Generate Monthly Invoice for Clients">
      <incoming>SequenceFlow_10</incoming>
      <outgoing>SequenceFlow_11</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_11" sourceRef="GenerateMonthlyInvoiceTask" targetRef="ChargeClient"/>
    <task id="ChargeClientTask" name="Charge Client $35 per invoice & notify">
      <incoming>SequenceFlow_11</incoming>
      <outgoing>SequenceFlow_12</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_12" sourceRef="ChargeClientTask" targetRef="EndEvent_2"/>
    <endEvent id="EndEvent_2">
      <incoming>SequenceFlow_12</incoming>
    </endEvent>
  </process>
</definitions>