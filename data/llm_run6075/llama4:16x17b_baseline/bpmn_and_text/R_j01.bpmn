<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">
  <process id="oeeProcess" name="OEE Process" isExecutable="true">
    <startEvent id="startEvent1" name="Start OEE Measurement">
      <outgoing>sf1</outgoing>
    </startEvent>
    <sequenceFlow id="sf1" sourceRef="startEvent1" targetRef="task1"/>
    <task id="task1" name="Collect Machine Data">
      <incoming>sf1</incoming>
      <outgoing>sf2</outgoing>
    </task>
    <sequenceFlow id="sf2" sourceRef="task1" targetRef="exclusiveGateway1"/>
    <exclusiveGateway id="exclusiveGateway1" name="Is Machine Running?">
      <incoming>sf2</incoming>
      <outgoing>sf3</outgoing>
      <outgoing>sf4</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="sf3" sourceRef="exclusiveGateway1" targetRef="task2">
      <conditionExpression xsi:type="tFormalExpression">${machineRunning == true}</conditionExpression>
    </sequenceFlow>
    <task id="task2" name="Calculate OEE">
      <incoming>sf3</incoming>
      <outgoing>sf5</outgoing>
    </task>
    <sequenceFlow id="sf5" sourceRef="task2" targetRef="exclusiveGateway2"/>
    <exclusiveGateway id="exclusiveGateway2" name="Is OEE Below Threshold?">
      <incoming>sf5</incoming>
      <outgoing>sf6</outgoing>
      <outgoing>sf7</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="sf6" sourceRef="exclusiveGateway2" targetRef="task3">
      <conditionExpression xsi:type="tFormalExpression">${oeeValue < threshold}</conditionExpression>
    </sequenceFlow>
    <task id="task3" name="Stop Machine and Send Email to Engineer">
      <incoming>sf6</incoming>
      <outgoing>sf8</outgoing>
    </task>
    <sequenceFlow id="sf8" sourceRef="task3" targetRef="exclusiveGateway3"/>
    <exclusiveGateway id="exclusiveGateway3" name="Is Machine Restarted?">
      <incoming>sf8</incoming>
      <outgoing>sf9</outgoing>
      <outgoing>sf10</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="sf9" sourceRef="exclusiveGateway3" targetRef="task1">
      <conditionExpression xsi:type="tFormalExpression">${machineRestarted == true}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="sf10" sourceRef="exclusiveGateway3" targetRef="endEvent1">
      <conditionExpression xsi:type="tFormalExpression">${machineDisconnected == true}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="sf4" sourceRef="exclusiveGateway1" targetRef="endEvent1">
      <conditionExpression xsi:type="tFormalExpression">${machineRunning == false}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="sf7" sourceRef="exclusiveGateway2" targetRef="task1"/>
    <endEvent id="endEvent1" name="Stop OEE Measurement">
      <incoming>sf10</incoming>
      <incoming>sf4</incoming>
    </endEvent>
  </process>
</definitions>