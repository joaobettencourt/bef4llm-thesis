<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">
  <process id="onlineShoppingProcess" name="Online Shopping Process" isExecutable="true">
    <startEvent id="loginStart" name="Login to E-Shop">
      <outgoing>loginConfirmation</outgoing>
    </startEvent>
    <sequenceFlow id="loginConfirmation" sourceRef="loginStart" targetRef="exclusiveGateway1"/>
    <exclusiveGateway id="exclusiveGateway1" name="Is Login Successful?">
      <incoming>loginConfirmation</incoming>
      <outgoing>successfulLogin</outgoing>
      <outgoing>unsuccessfulLogin</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="successfulLogin" sourceRef="exclusiveGateway1" targetRef="selectProduct">
      <conditionExpression xsi:type="tFormalExpression">${loginSuccessful  == true}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="unsuccessfulLogin" sourceRef="exclusiveGateway1" targetRef="endEvent1">
      <conditionExpression xsi:type="tFormalExpression">${loginSuccessful  == false}</conditionExpression>
    </sequenceFlow>
    <task id="selectProduct" name="Select Product">
      <incoming>successfulLogin</incoming>
      <outgoing>addToCart</outgoing>
    </task>
    <sequenceFlow id="addToCart" sourceRef="selectProduct" targetRef="addProductToCart"/>
    <task id="addProductToCart" name="Add Product to Cart">
      <incoming>addToCart</incoming>
      <outgoing>saveProduct</outgoing>
    </task>
    <sequenceFlow id="saveProduct" sourceRef="addProductToCart" targetRef="checkAllProductsSelected"/>
    <exclusiveGateway id="checkAllProductsSelected" name="Are All Products Selected?">
      <incoming>saveProduct</incoming>
      <outgoing>allProductsSelected</outgoing>
      <outgoing>moreProductsToSelect</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="allProductsSelected" sourceRef="checkAllProductsSelected" targetRef="prepareOrder">
      <conditionExpression xsi:type="tFormalExpression">${allProductsSelected  == true}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="moreProductsToSelect" sourceRef="checkAllProductsSelected" targetRef="selectProduct">
      <conditionExpression xsi:type="tFormalExpression">${allProductsSelected  == false}</conditionExpression>
    </sequenceFlow>
    <task id="prepareOrder" name="Prepare Order and Payment/Shipping">
      <incoming>allProductsSelected</incoming>
      <outgoing>parallelGateway1SequenceFlow</outgoing>
    </task>
    <parallelGateway id="parallelGateway1">
      <incoming>parallelGateway1SequenceFlow</incoming>
      <outgoing>paymentConfirmation</outgoing>
      <outgoing>shippingAddressEntrySequenceFlow</outgoing>
    </parallelGateway>
    <sequenceFlow id="parallelGateway1SequenceFlow" sourceRef="prepareOrder" targetRef="parallelGateway1"/>
    <task id="enterPaymentDataTask" name="Enter Payment Data">
      <incoming>paymentConfirmation</incoming>
      <outgoing>waitForPaymentConfirmation</outgoing>
    </task>
    <sequenceFlow id="paymentConfirmation" sourceRef="parallelGateway1" targetRef="enterPaymentDataTask"/>
    <task id="waitForPaymentConfirmation" name="Wait for Payment Confirmation">
      <incoming>enterPaymentDataTask</incoming>
      <outgoing>paymentConfirmed</outgoing>
    </task>
    <sequenceFlow id="paymentConfirmed" sourceRef="waitForPaymentConfirmation" targetRef="exclusiveGateway2"/>
    <exclusiveGateway id="exclusiveGateway2" name="Is Payment Confirmed?">
      <incoming>paymentConfirmed</incoming>
      <outgoing>confirmPayment</outgoing>
      <outgoing>cancelOrder</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="confirmPayment" sourceRef="exclusiveGateway2" targetRef="shippingAddressEntry">
      <conditionExpression xsi:type="tFormalExpression">${paymentConfirmed  == true}</conditionExpression>
    </sequenceFlow>
    <task id="shippingAddressEntry" name="Enter Shipping Address">
      <incoming>parallelGateway1</incoming>
      <incoming>confirmPayment</incoming>
      <outgoing>orderFinished</outgoing>
    </task>
    <sequenceFlow id="shippingAddressEntrySequenceFlow" sourceRef="parallelGateway1" targetRef="shippingAddressEntry"/>
    <sequenceFlow id="orderFinished" sourceRef="shippingAddressEntry" targetRef="endEvent2"/>
    <sequenceFlow id="cancelOrder" sourceRef="exclusiveGateway2" targetRef="endEvent1">
      <conditionExpression xsi:type="tFormalExpression">${paymentConfirmed  == false}</conditionExpression>
    </sequenceFlow>
    <endEvent id="endEvent1" name="Order Cancelled">
      <incoming>unsuccessfulLogin</incoming>
      <incoming>cancelOrder</incoming>
    </endEvent>
    <endEvent id="endEvent2" name="Order Finished Successfully">
      <incoming>orderFinished</incoming>
    </endEvent>
  </process>
</definitions>