<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" targetNamespace="http://www.example.com">
  <process id="inspectionProcess" name="Inspection of an Energy Drink Bottling Machine" isExecutable="true">
    <startEvent id="startEvent" name="Start Inspection">
      <outgoing>sequenceFlow1</outgoing>
    </startEvent>
    <sequenceFlow id="sequenceFlow1" sourceRef="startEvent" targetRef="task1"/>
    <task id="task1" name="Enter Machine Type and Serial Number">
      <incoming>sequenceFlow1</incoming>
      <outgoing>sequenceFlow2</outgoing>
    </task>
    <sequenceFlow id="sequenceFlow2" sourceRef="task1" targetRef="exclusiveGateway1"/>
    <exclusiveGateway id="exclusiveGateway1" name="Is Machine Ready for Inspection?">
      <incoming>sequenceFlow2</incoming>
      <outgoing>sequenceFlow3</outgoing>
      <outgoing>sequenceFlow4</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="sequenceFlow3" sourceRef="exclusiveGateway1" targetRef="task2">
      <conditionExpression xsi:type="tFormalExpression">${machineReady == true}</conditionExpression>
    </sequenceFlow>
    <task id="task2" name="Perform Inspection (Answer Questions)">
      <incoming>sequenceFlow3</incoming>
      <outgoing>sequenceFlow5</outgoing>
    </task>
    <sequenceFlow id="sequenceFlow5" sourceRef="task2" targetRef="exclusiveGateway2"/>
    <exclusiveGateway id="exclusiveGateway2" name="Are Additional Questions Required?">
      <incoming>sequenceFlow5</incoming>
      <outgoing>sequenceFlow6</outgoing>
      <outgoing>sequenceFlow7</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="sequenceFlow6" sourceRef="exclusiveGateway2" targetRef="task3">
      <conditionExpression xsi:type="tFormalExpression">${additionalQuestionsRequired == true}</conditionExpression>
    </sequenceFlow>
    <task id="task3" name="Ask Additional Questions">
      <incoming>sequenceFlow6</incoming>
      <outgoing>sequenceFlow8</outgoing>
    </task>
    <sequenceFlow id="sequenceFlow8" sourceRef="task3" targetRef="exclusiveGateway2"/>
    <sequenceFlow id="sequenceFlow7" sourceRef="exclusiveGateway2" targetRef="endEvent1">
      <conditionExpression xsi:type="tFormalExpression">${additionalQuestionsRequired == false}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="sequenceFlow4" sourceRef="exclusiveGateway1" targetRef="task4">
      <conditionExpression xsi:type="tFormalExpression">${machineReady == false}</conditionExpression>
    </sequenceFlow>
    <task id="task4" name="Notify Maintenance Team">
      <incoming>sequenceFlow4</incoming>
      <outgoing>sequenceFlow9</outgoing>
    </task>
    <sequenceFlow id="sequenceFlow9" sourceRef="task4" targetRef="endEvent1"/>
    <endEvent id="endEvent1" name="Inspection Process End">
      <incoming>sequenceFlow7</incoming>
      <incoming>sequenceFlow8</incoming>
      <incoming>sequenceFlow9</incoming>
    </endEvent>
  </process>
</definitions>