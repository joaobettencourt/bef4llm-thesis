<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" targetNamespace="http://www.example.com">
  <process id="diyRepairProcess" name="DIY Repair of a Broken Smartphone Screen" isExecutable="true">
    <startEvent id="startEvent" name="Start DIY Repair">
      <outgoing>sequenceFlow1</outgoing>
    </startEvent>
    <sequenceFlow id="sequenceFlow1" sourceRef="startEvent" targetRef="task1"/>
    <task id="task1" name="Enter Model and Problem">
      <incoming>sequenceFlow1</incoming>
      <outgoing>sequenceFlow2</outgoing>
    </task>
    <sequenceFlow id="sequenceFlow2" sourceRef="task1" targetRef="exclusiveGateway1"/>
    <exclusiveGateway id="exclusiveGateway1" name="Do you have all necessary materials?">
      <incoming>sequenceFlow2</incoming>
      <outgoing>sequenceFlow3</outgoing>
      <outgoing>sequenceFlow4</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="sequenceFlow3" sourceRef="exclusiveGateway1" targetRef="task2">
      <conditionExpression xsi:type="tFormalExpression">${hasAllMaterials == true}</conditionExpression>
    </sequenceFlow>
    <task id="task2" name="Get Instructions and Repair">
      <incoming>sequenceFlow3</incoming>
      <outgoing>sequenceFlow5</outgoing>
    </task>
    <sequenceFlow id="sequenceFlow5" sourceRef="task2" targetRef="exclusiveGateway2"/>
    <exclusiveGateway id="exclusiveGateway2" name="Was the repair successful?">
      <incoming>sequenceFlow5</incoming>
      <outgoing>sequenceFlow6</outgoing>
      <outgoing>sequenceFlow7</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="sequenceFlow6" sourceRef="exclusiveGateway2" targetRef="task3">
      <conditionExpression xsi:type="tFormalExpression">${repairSuccessful == true}</conditionExpression>
    </sequenceFlow>
    <task id="task3" name="Send Review and/or Video">
      <incoming>sequenceFlow6</incoming>
      <outgoing>sequenceFlow8</outgoing>
    </task>
    <sequenceFlow id="sequenceFlow8" sourceRef="task3" targetRef="endEvent1"/>
    <sequenceFlow id="sequenceFlow7" sourceRef="exclusiveGateway2" targetRef="serviceTask1">
      <conditionExpression xsi:type="tFormalExpression">${repairSuccessful == false}</conditionExpression>
    </sequenceFlow>
    <serviceTask id="serviceTask1" name="Send to Expert">
      <incoming>sequenceFlow7</incoming>
      <outgoing>sequenceFlow9</outgoing>
    </serviceTask>
    <sequenceFlow id="sequenceFlow9" sourceRef="serviceTask1" targetRef="endEvent2"/>
    <task id="task4" name="Order Materials and Tools">
      <incoming>sequenceFlow4</incoming>
      <outgoing>sequenceFlow10</outgoing>
    </task>
    <sequenceFlow id="sequenceFlow10" sourceRef="task4" targetRef="exclusiveGateway3"/>
    <exclusiveGateway id="exclusiveGateway3" name="Can you borrow or buy cheaply?">
      <incoming>sequenceFlow10</incoming>
      <outgoing>sequenceFlow11</outgoing>
      <outgoing>sequenceFlow12</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="sequenceFlow11" sourceRef="exclusiveGateway3" targetRef="task5">
      <conditionExpression xsi:type="tFormalExpression">${canBorrowOrBuyCheaply == true}</conditionExpression>
    </sequenceFlow>
    <task id="task5" name="Contact Friends to Borrow or Buy Cheaply">
      <incoming>sequenceFlow11</incoming>
      <outgoing>sequenceFlow13</outgoing>
    </task>
    <sequenceFlow id="sequenceFlow13" sourceRef="task5" targetRef="exclusiveGateway1"/>
    <sequenceFlow id="sequenceFlow12" sourceRef="exclusiveGateway3" targetRef="task6">
      <conditionExpression xsi:type="tFormalExpression">${canBorrowOrBuyCheaply == false}</conditionExpression>
    </sequenceFlow>
    <task id="task6" name="Buy Materials and Tools Online">
      <incoming>sequenceFlow12</incoming>
      <outgoing>sequenceFlow14</outgoing>
    </task>
    <sequenceFlow id="sequenceFlow14" sourceRef="task6" targetRef="exclusiveGateway1"/>
    <endEvent id="endEvent1" name="Repair Process End">
      <incoming>sequenceFlow8</incoming>
    </endEvent>
    <endEvent id="endEvent2" name="Expert Repair Process End">
      <incoming>sequenceFlow9</incoming>
    </endEvent>
  </process>
</definitions>