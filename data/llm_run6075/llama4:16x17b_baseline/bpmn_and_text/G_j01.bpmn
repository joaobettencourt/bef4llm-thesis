<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" targetNamespace="http://www.example.com">
  <process id="farmingBotProcess" name="Farming Bot Process" isExecutable="true">
    <startEvent id="startEvent" name="Start Farming Bot">
      <outgoing>sequenceFlow1</outgoing>
    </startEvent>
    <sequenceFlow id="sequenceFlow1" sourceRef="startEvent" targetRef="parallelGateway1"/>
    <parallelGateway id="parallelGateway1">
      <incoming>sequenceFlow1</incoming>
      <outgoing>sequenceFlow2</outgoing>
      <outgoing>sequenceFlow3</outgoing>
      <outgoing>sequenceFlow4</outgoing>
      <!-- Add up to 10 resources in parallel -->
      <outgoing>sequenceFlow5</outgoing>
      <outgoing>sequenceFlow6</outgoing>
      <outgoing>sequenceFlow7</outgoing>
      <outgoing>sequenceFlow8</outgoing>
      <outgoing>sequenceFlow9</outgoing>
      <outgoing>sequenceFlow10</outgoing>
    </parallelGateway>
    <!-- Resource selection tasks -->
    <task id="task1" name="Select Resources">
      <incoming>sequenceFlow2</incoming>
      <outgoing>sequenceFlow11</outgoing>
    </task>
    <sequenceFlow id="sequenceFlow2" sourceRef="parallelGateway1" targetRef="task1"/>
    <!-- ... up to 10 tasks for resource selection -->
    <task id="task2" name="Select Tools">
      <incoming>sequenceFlow3</incoming>
      <outgoing>sequenceFlow12</outgoing>
    </task>
    <sequenceFlow id="sequenceFlow3" sourceRef="parallelGateway1" targetRef="task2"/>
    <!-- ... -->
    <exclusiveGateway id="exclusiveGateway1">
      <incoming>sequenceFlow11</incoming>
      <!-- incoming from other resource selection tasks -->
      <outgoing>sequenceFlow13</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="sequenceFlow11" sourceRef="task1" targetRef="exclusiveGateway1"/>
    <!-- ... -->
    <sequenceFlow id="sequenceFlow13" sourceRef="exclusiveGateway1" targetRef="serviceTask1">
      <conditionExpression xsi:type="tFormalExpression">${resourcesSelected}</conditionExpression>
    </sequenceFlow>
    <serviceTask id="serviceTask1" name="Start Farming Bot">
      <incoming>sequenceFlow13</incoming>
      <outgoing>sequenceFlow14</outgoing>
    </serviceTask>
    <intermediateCatchEvent id="intermediateCatchEvent1">
      <incoming>sequenceFlow14</incoming>
      <outgoing>sequenceFlow15</outgoing>
    </intermediateCatchEvent>
    <!-- Natural disaster event -->
    <sequenceFlow id="sequenceFlow14" sourceRef="serviceTask1" targetRef="intermediateCatchEvent1"/>
    <sequenceFlow id="sequenceFlow15" sourceRef="intermediateCatchEvent1" targetRef="exclusiveGateway2">
      <conditionExpression xsi:type="tFormalExpression">${milestoneReached}</conditionExpression>
    </sequenceFlow>
    <exclusiveGateway id="exclusiveGateway2">
      <incoming>sequenceFlow15</incoming>
      <outgoing>sequenceFlow16</outgoing>
      <outgoing>sequenceFlow17</outgoing>
    </exclusiveGateway>
    <!-- Notify user -->
    <task id="task3" name="Notify User">
      <incoming>sequenceFlow16</incoming>
      <outgoing>sequenceFlow18</outgoing>
    </task>
    <sequenceFlow id="sequenceFlow16" sourceRef="exclusiveGateway2" targetRef="task3"/>
    <!-- Update resource list -->
    <userTask id="userTask1" name="Update Resource List">
      <incoming>sequenceFlow18</incoming>
      <outgoing>sequenceFlow19</outgoing>
    </userTask>
    <sequenceFlow id="sequenceFlow18" sourceRef="task3" targetRef="userTask1"/>
    <!-- Brag to friends and/or send materials -->
    <exclusiveGateway id="exclusiveGateway3">
      <incoming>sequenceFlow19</incoming>
      <outgoing>sequenceFlow20</outgoing>
      <outgoing>sequenceFlow21</outgoing>
    </exclusiveGateway>
    <task id="task4" name="Brag to Friends">
      <incoming>sequenceFlow20</incoming>
    </task>
    <sequenceFlow id="sequenceFlow20" sourceRef="exclusiveGateway3" targetRef="task4"/>
    <task id="task5" name="Send Materials">
      <incoming>sequenceFlow21</incoming>
    </task>
    <sequenceFlow id="sequenceFlow21" sourceRef="exclusiveGateway3" targetRef="task5"/>
    <endEvent id="endEvent1" name="Farming Bot Finished">
      <incoming>sequenceFlow22</incoming>
    </endEvent>
  </process>
</definitions>