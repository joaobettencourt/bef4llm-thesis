<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" targetNamespace="http://www.example.com">
  <process id="findJobProcess" name="Find a Job" isExecutable="true">
    <startEvent id="startEvent" name="Start Job Search">
      <outgoing>sequenceFlow1</outgoing>
    </startEvent>
    <sequenceFlow id="sequenceFlow1" sourceRef="startEvent" targetRef="task1"/>
    <task id="task1" name="Report Job Applications">
      <incoming>sequenceFlow1</incoming>
      <outgoing>sequenceFlow2</outgoing>
    </task>
    <sequenceFlow id="sequenceFlow2" sourceRef="task1" targetRef="exclusiveGateway1"/>
    <exclusiveGateway id="exclusiveGateway1" name="Has Company Responded?">
      <incoming>sequenceFlow2</incoming>
      <outgoing>sequenceFlow3</outgoing>
      <outgoing>sequenceFlow4</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="sequenceFlow3" sourceRef="exclusiveGateway1" targetRef="task2">
      <conditionExpression xsi:type="tFormalExpression">${companyResponded == true}</conditionExpression>
    </sequenceFlow>
    <task id="task2" name="Receive Job Offer and Rate Application">
      <incoming>sequenceFlow3</incoming>
      <outgoing>sequenceFlow5</outgoing>
    </task>
    <sequenceFlow id="sequenceFlow5" sourceRef="task2" targetRef="exclusiveGateway2"/>
    <exclusiveGateway id="exclusiveGateway2" name="Is Job Offer Accepted?">
      <incoming>sequenceFlow5</incoming>
      <outgoing>sequenceFlow6</outgoing>
      <outgoing>sequenceFlow7</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="sequenceFlow6" sourceRef="exclusiveGateway2" targetRef="task3">
      <conditionExpression xsi:type="tFormalExpression">${jobOfferAccepted == true}</conditionExpression>
    </sequenceFlow>
    <task id="task3" name="Enter Probation Phase">
      <incoming>sequenceFlow6</incoming>
      <outgoing>sequenceFlow8</outgoing>
    </task>
    <sequenceFlow id="sequenceFlow8" sourceRef="task3" targetRef="exclusiveGateway3"/>
    <exclusiveGateway id="exclusiveGateway3" name="Has Probation Phase Ended?">
      <incoming>sequenceFlow8</incoming>
      <outgoing>sequenceFlow9</outgoing>
      <outgoing>sequenceFlow10</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="sequenceFlow9" sourceRef="exclusiveGateway3" targetRef="task4">
      <conditionExpression xsi:type="tFormalExpression">${probationPhaseEnded == true}</conditionExpression>
    </sequenceFlow>
    <task id="task4" name="Rate Company and Receive Rating">
      <incoming>sequenceFlow9</incoming>
      <outgoing>sequenceFlow11</outgoing>
    </task>
    <sequenceFlow id="sequenceFlow11" sourceRef="task4" targetRef="exclusiveGateway4"/>
    <exclusiveGateway id="exclusiveGateway4" name="Is Rating C or Less?">
      <incoming>sequenceFlow11</incoming>
      <outgoing>sequenceFlow12</outgoing>
      <outgoing>sequenceFlow13</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="sequenceFlow12" sourceRef="exclusiveGateway4" targetRef="endEvent1">
      <conditionExpression xsi:type="tFormalExpression">${rating == 'C' or less}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="sequenceFlow13" sourceRef="exclusiveGateway4" targetRef="endEvent2">
      <conditionExpression xsi:type="tFormalExpression">${rating > 'C'}</conditionExpression>
    </sequenceFlow>
    <endEvent id="endEvent1" name="Continue Receiving Job Offers">
      <incoming>sequenceFlow12</incoming>
    </endEvent>
    <endEvent id="endEvent2" name="Job Becomes Permanent">
      <incoming>sequenceFlow13</incoming>
    </endEvent>
    <sequenceFlow id="sequenceFlow4" sourceRef="exclusiveGateway1" targetRef="task5">
      <conditionExpression xsi:type="tFormalExpression">${companyResponded == false}</conditionExpression>
    </sequenceFlow>
    <task id="task5" name="Receive New Job Offers">
      <incoming>sequenceFlow4</incoming>
      <outgoing>sequenceFlow14</outgoing>
    </task>
    <sequenceFlow id="sequenceFlow14" sourceRef="task5" targetRef="exclusiveGateway1"/>
  </process>
</definitions>