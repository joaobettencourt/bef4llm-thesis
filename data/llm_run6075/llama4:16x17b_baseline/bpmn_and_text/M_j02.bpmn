<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" targetNamespace="http://www.example.com">
  <process id="luxuryAirplaneProcess" name="Luxury Airplane Process" isExecutable="true">
    <startEvent id="startEvent" name="Start Luxury Airplane Process">
      <outgoing>sequenceFlow1</outgoing>
    </startEvent>
    <sequenceFlow id="sequenceFlow1" sourceRef="startEvent" targetRef="task1"/>
    <task id="task1" name="Receive Customer Specifications">
      <incoming>sequenceFlow1</incoming>
      <outgoing>sequenceFlow2</outgoing>
    </task>
    <sequenceFlow id="sequenceFlow2" sourceRef="task1" targetRef="exclusiveGateway1"/>
    <exclusiveGateway id="exclusiveGateway1" name="Determine Bar Type">
      <incoming>sequenceFlow2</incoming>
      <outgoing>sequenceFlow3</outgoing>
      <outgoing>sequenceFlow4</outgoing>
      <outgoing>sequenceFlow5</outgoing>
      <outgoing>sequenceFlow6</outgoing>
      <outgoing>sequenceFlow7</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="sequenceFlow3" sourceRef="exclusiveGateway1" targetRef="task2">
      <conditionExpression xsi:type="tFormalExpression">${barType == 'Vodka'}</conditionExpression>
    </sequenceFlow>
    <task id="task2" name="Send Requirements to Russian Team (Vodka Bar)">
      <incoming>sequenceFlow3</incoming>
      <outgoing>sequenceFlow8</outgoing>
    </task>
    <sequenceFlow id="sequenceFlow8" sourceRef="task2" targetRef="task9"/>
    <sequenceFlow id="sequenceFlow4" sourceRef="exclusiveGateway1" targetRef="task3">
      <conditionExpression xsi:type="tFormalExpression">${barType == 'Whiskey'}</conditionExpression>
    </sequenceFlow>
    <task id="task3" name="Send Requirements to Irish Team (Whiskey Bar)">
      <incoming>sequenceFlow4</incoming>
      <outgoing>sequenceFlow9</outgoing>
    </task>
    <sequenceFlow id="sequenceFlow9" sourceRef="task3" targetRef="task9"/>
    <sequenceFlow id="sequenceFlow5" sourceRef="exclusiveGateway1" targetRef="task4">
      <conditionExpression xsi:type="tFormalExpression">${barType == 'Rum'}</conditionExpression>
    </sequenceFlow>
    <task id="task4" name="Send Requirements to Caribbean Team (Rum Bar)">
      <incoming>sequenceFlow5</incoming>
      <outgoing>sequenceFlow10</outgoing>
    </task>
    <sequenceFlow id="sequenceFlow10" sourceRef="task4" targetRef="task9"/>
    <sequenceFlow id="sequenceFlow6" sourceRef="exclusiveGateway1" targetRef="task5">
      <conditionExpression xsi:type="tFormalExpression">${barType == 'Gin'}</conditionExpression>
    </sequenceFlow>
    <task id="task5" name="Send Requirements to British Team (Gin Bar)">
      <incoming>sequenceFlow6</incoming>
      <outgoing>sequenceFlow11</outgoing>
    </task>
    <sequenceFlow id="sequenceFlow11" sourceRef="task5" targetRef="task9"/>
    <sequenceFlow id="sequenceFlow7" sourceRef="exclusiveGateway1" targetRef="task6">
      <conditionExpression xsi:type="tFormalExpression">${barType == 'Cognac'}</conditionExpression>
    </sequenceFlow>
    <task id="task6" name="Send Requirements to French Team (Cognac Bar)">
      <incoming>sequenceFlow7</incoming>
      <outgoing>sequenceFlow12</outgoing>
    </task>
    <sequenceFlow id="sequenceFlow12" sourceRef="task6" targetRef="task9"/>
    <task id="task9" name="Receive Parts from Teams">
      <incoming>sequenceFlow8</incoming>
      <incoming>sequenceFlow9</incoming>
      <incoming>sequenceFlow10</incoming>
      <incoming>sequenceFlow11</incoming>
      <incoming>sequenceFlow12</incoming>
      <outgoing>sequenceFlow13</outgoing>
    </task>
    <sequenceFlow id="sequenceFlow13" sourceRef="task9" targetRef="task7"/>
    <task id="task7" name="Assemble Interior of Plane">
      <incoming>sequenceFlow13</incoming>
      <outgoing>sequenceFlow14</outgoing>
    </task>
    <sequenceFlow id="sequenceFlow14" sourceRef="task7" targetRef="task8"/>
    <task id="task8" name="Conduct Test Flight and Create Test Protocol">
      <incoming>sequenceFlow14</incoming>
      <outgoing>sequenceFlow15</outgoing>
    </task>
    <sequenceFlow id="sequenceFlow15" sourceRef="task8" targetRef="endEvent1"/>
    <endEvent id="endEvent1" name="Luxury Airplane Process End">
      <incoming>sequenceFlow15</incoming>
    </endEvent>
  </process>
</definitions>