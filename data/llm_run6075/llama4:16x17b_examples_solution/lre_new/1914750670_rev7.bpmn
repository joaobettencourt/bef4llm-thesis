<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/pec/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/pec/20100524/MODEL BPMN20.xsd"
             id="definition" 
             targetNamespace="http://bpmn.io/schema/bpmn">
   <collaboration id="Collaboration_1">
     <participant id="Participant_Customer" name="Bank Customer" processRef="Process_Customer"/>
     <participant id="Participant_PostOfficer" name="Post Officer" processRef="Process_PostOfficer"/>
     <participant id="Participant_BankOfficer" name="Bank Officer" processRef="Process_BankOfficer"/>

     <messageFlow id="MessageFlow_1" sourceRef="Task_GeneratePDF" targetRef="StartEvent_PostRequest"/>
     <messageFlow id="MessageFlow_2" sourceRef="Task_MailAccountRequest" targetRef="StartEvent_BankRequest"/>
   </collaboration>

   <process id="Process_Customer" isExecutable="true">
     <startEvent id="StartEvent_Customer">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_Customer" targetRef="Task_VisitWebsite"/>

     <task id="Task_VisitWebsite" name="Visit Bank Website">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_VisitWebsite" targetRef="Task_FillData"/>

     <task id="Task_FillData" name="Fill in personal data">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_3" sourceRef="Task_FillData" targetRef="Task_GeneratePDF"/>

     <task id="Task_GeneratePDF" name="Generate and print PDF">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_4</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_4" sourceRef="Task_GeneratePDF" targetRef="ExclusiveGateway_Customer"/>

     <eventBasedGateway id="ExclusiveGateway_Customer">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_5</outgoing>
       <outgoing>SequenceFlow_6</outgoing>
     </eventBasedGateway>

     <sequenceFlow id="SequenceFlow_5" sourceRef="ExclusiveGateway_Customer" targetRef="IntermediateCatchEvent_Documents"/>

     <sequenceFlow id="SequenceFlow_6" sourceRef="ExclusiveGateway_Customer" targetRef="IntermediateCatchEvent_Refusal"/>
   </process>

   <process id="Process_PostOfficer">
     <startEvent id="StartEvent_PostRequest">
       <incoming>MessageFlow_1</incoming>
       <outgoing>SequenceFlow_7</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_7" sourceRef="StartEvent_PostRequest" targetRef="Task_AuthenticateCustomer"/>

     <task id="Task_AuthenticateCustomer" name="Check identity of customer">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_8</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_8" sourceRef="Task_AuthenticateCustomer" targetRef="Task_MailAccountRequest"/>

     <task id="Task_MailAccountRequest" name="Mail account request to bank">
       <incoming>SequenceFlow_8</incoming>
     </task>
   </process>

   <process id="Process_BankOfficer">
     <startEvent id="StartEvent_BankRequest">
       <incoming>MessageFlow_2</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_9" sourceRef="StartEvent_BankRequest" targetRef="Task_CheckData"/>

     <task id="Task_CheckData" name="Check customer data">
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_10</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_10" sourceRef="Task_CheckData" targetRef="ExclusiveGateway_BankOfficer"/>

     <exclusiveGateway id="ExclusiveGateway_BankOfficer">
       <incoming>SequenceFlow_10</incoming>
       <outgoing>SequenceFlow_11</outgoing>
       <outgoing>SequenceFlow_12</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_11" sourceRef="ExclusiveGateway_BankOfficer" targetRef="Task_MailDocuments">
       <conditionExpression xsi:type="tFormalExpression">${approved == true}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="SequenceFlow_12" sourceRef="ExclusiveGateway_BankOfficer" targetRef="Task_MailRefusal">
       <conditionExpression xsi:type="tFormalExpression">${approved == false}</conditionExpression>
     </sequenceFlow>

     <subProcess id="Task_MailDocuments" name="Mail account documents">
       <incoming>SequenceFlow_11</incoming>
     </subProcess>

     <task id="Task_MailRefusal" name="Mail letter of refusal">
       <incoming>SequenceFlow_12</incoming>
     </task>

     <intermediateCatchEvent id="IntermediateCatchEvent_Documents">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_13</outgoing>
       <messageEventDefinition/>
     </intermediateCatchEvent>

     <sequenceFlow id="SequenceFlow_13" sourceRef="IntermediateCatchEvent_Documents" targetRef="EndEvent_BankOfficer"/>

     <endEvent id="EndEvent_BankOfficer">
       <incoming>SequenceFlow_13</incoming>
     </endEvent>

     <intermediateCatchEvent id="IntermediateCatchEvent_Refusal">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_14</outgoing>
       <messageEventDefinition/>
     </intermediateCatchEvent>

     <sequenceFlow id="SequenceFlow_14" sourceRef="IntermediateCatchEvent_Refusal" targetRef="EndEvent_BankOfficer"/>

   </process>
</definitions>