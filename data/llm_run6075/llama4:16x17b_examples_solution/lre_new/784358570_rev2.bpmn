<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" name="BPMN Process Model"
             targetNamespace="http://bpmn.io/schema/bpmn">
   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>
     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_ReviewOrder"/>
     <userTask id="Task_ReviewOrder" name="Review order">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </userTask>
     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_ReviewOrder" targetRef="ExclusiveGateway_CheckProducts"/>
     <exclusiveGateway id="ExclusiveGateway_CheckProducts">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_DiscontinuedItem</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_CheckProducts" targetRef="Task_PreparePackage">
       <conditionExpression xsi:type="tFormalExpression">${order.quantity  > 10}</conditionExpression>
     </sequenceFlow>
     <task id="Task_PreparePackage" name="Prepare package">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_4</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_4" sourceRef="Task_PreparePackage" targetRef="EndEvent_DeliveryPrepared"/>
     <endEvent id="EndEvent_DeliveryPrepared">
       <incoming>SequenceFlow_4</incoming>
     </endEvent>

     <!-- Discontinued Item  -->
     <sequenceFlow id="SequenceFlow_DiscontinuedItem" name="Discontinued item" sourceRef="ExclusiveGateway_CheckProducts" targetRef="Task_InformCustomerDiscontinued"/>
     <userTask id="Task_InformCustomerDiscontinued" name="Inform customer about discontinued items">
       <incoming>SequenceFlow_DiscontinuedItem</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </userTask>
     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_InformCustomerDiscontinued" targetRef="EndEvent_CancelOrder"/>
     <endEvent id="EndEvent_CancelOrder">
       <incoming>SequenceFlow_5</incoming>
     </endEvent>

     <!-- Inform Customer and Order Missing Products  -->
     <sequenceFlow id="SequenceFlow_NotOK" name="Something is missing" sourceRef="ExclusiveGateway_CheckProducts" targetRef="Task_InformCustomerDelay"/>
     <userTask id="Task_InformCustomerDelay" name="Inform customer about potential delay">
       <incoming>SequenceFlow_NotOK</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </userTask>
     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_InformCustomerDelay" targetRef="Task_OrderMissingProducts"/>
     <task id="Task_OrderMissingProducts" name="Order missing products">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_7</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_7" sourceRef="Task_OrderMissingProducts" targetRef="ExclusiveGateway_CheckProducts"/>
   </process>
</definitions>