<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" name="BPMN Process Model" targetNamespace="http://bpmn.io/schema/bpmn">
   <process id="Process_1" isExecutable="true">
     <laneSet>
       <lane id="Lane_1" name="Payment Office">
         <flowNodeRef>StartEvent_1</flowNodeRef>
         <flowNodeRef>Task_Generate_Payment_Report</flowNodeRef>
         <flowNodeRef>Task_Pay_Vendor</flowNodeRef>
         <flowNodeRef>ExclusiveGateway_1</flowNodeRef>
       </lane>
       <lane id="Lane_2" name="Accounts Receivable Department">
         <flowNodeRef>Task_Generate_Monthly_Invoice</flowNodeRef>
         <flowNodeRef>Task_Charge_Client</flowNodeRef>
       </lane>
       <lane id="Lane_3" name="Registry Office">
         <flowNodeRef>Task_Send_Payment_Report_to_Registry</flowNodeRef>
         <flowNodeRef>Task_Archive_Invoices_per_Vendor</flowNodeRef>
         <flowNodeRef>Task_Track_Down_Payment</flowNodeRef>
       </lane>
     </laneSet>

     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_Generate_Payment_Report"/>

     <task id="Task_Generate_Payment_Report" name="Generate Payment Report">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_Generate_Payment_Report" targetRef="Task_Pay_Vendor"/>

     <task id="Task_Pay_Vendor" name="Pay Vendor">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_3" sourceRef="Task_Pay_Vendor" targetRef="ExclusiveGateway_1"/>

     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_4</outgoing>
       <outgoing>SequenceFlow_5</outgoing>
       <outgoing>SequenceFlow_6</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_1" targetRef="Task_Send_Payment_Report_to_Accounts_Receivable"/>

     <task id="Task_Send_Payment_Report_to_Accounts_Receivable" name="Send Payment Report to Accounts Receivable Department">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_7</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_7" sourceRef="Task_Send_Payment_Report_to_Accounts_Receivable" targetRef="Task_Generate_Monthly_Invoice"/>

     <task id="Task_Generate_Monthly_Invoice" name="Generate Monthly Invoice for Clients">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_8</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_8" sourceRef="Task_Generate_Monthly_Invoice" targetRef="Task_Charge_Client"/>

     <task id="Task_Charge_Client" name="Charge Client $35 per Invoice">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_Charge_Client" targetRef="EndEvent_1"/>

     <sequenceFlow id="SequenceFlow_5" sourceRef="ExclusiveGateway_1" targetRef="Task_Send_Payment_Report_to_Registry"/>

     <task id="Task_Send_Payment_Report_to_Registry" name="Send Payment Report to Registry Office">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_10</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_10" sourceRef="Task_Send_Payment_Report_to_Registry" targetRef="Task_Select_Invoices"/>

     <task id="Task_Select_Invoices" name="Select Invoices">
       <incoming>SequenceFlow_10</incoming>
       <outgoing>SequenceFlow_11</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_11" sourceRef="Task_Select_Invoices" targetRef="ExclusiveGateway_2"/>

     <exclusiveGateway id="ExclusiveGateway_2">
       <incoming>SequenceFlow_11</incoming>
       <outgoing>SequenceFlow_12</outgoing>
       <outgoing>SequenceFlow_13</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_12" sourceRef="ExclusiveGateway_2" targetRef="Task_Archive_Invoices_per_Vendor"/>

     <task id="Task_Archive_Invoices_per_Vendor" name="Archive Invoices per Vendor">
       <incoming>SequenceFlow_12</incoming>
       <outgoing>SequenceFlow_14</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_13" sourceRef="ExclusiveGateway_2" targetRef="Task_Track_Down_Payment"/>

     <task id="Task_Track_Down_Payment" name="Track Down Payment">
       <incoming>SequenceFlow_13</incoming>
       <outgoing>SequenceFlow_15</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_14" sourceRef="Task_Archive_Invoices_per_Vendor" targetRef="EndEvent_2"/>

     <sequenceFlow id="SequenceFlow_15" sourceRef="Task_Track_Down_Payment" targetRef="EndEvent_3"/>

     <endEvent id="EndEvent_1"/>
     <endEvent id="EndEvent_2"/>
     <endEvent id="EndEvent_3"/>
   </process>
</definitions>