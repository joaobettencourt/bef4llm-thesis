<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definition" name="Invoice Process">

   <process id="invoiceProcess" isExecutable="true">
     <startEvent id="startEvent">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent" targetRef="taskVendorLocation"/>

     <task id="taskVendorLocation" name="Locate Vendor in SAP System">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow2" sourceRef="taskVendorLocation" targetRef="exclusiveGateway1"/>

     <exclusiveGateway id="exclusiveGateway1">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
       <outgoing>sequenceFlow4</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow3" name="Vendor does not exist" sourceRef="exclusiveGateway1" targetRef="taskFillOutRequest"/>

     <subProcess id="subProcessNewVendor">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow14</outgoing>

       <startEvent id="startEventNewVendor">
         <outgoing>sequenceFlow6</outgoing>
       </startEvent>

       <sequenceFlow id="sequenceFlow6" sourceRef="startEventNewVendor" targetRef="taskFillOutRequest"/>

       <task id="taskFillOutRequest" name="Fill out request for new Vendor Master Record form">
         <incoming>sequenceFlow6</incoming>
         <outgoing>sequenceFlow7</outgoing>
       </task>

       <sequenceFlow id="sequenceFlow7" sourceRef="taskFillOutRequest" targetRef="taskStapleRequest"/>

       <task id="taskStapleRequest" name="Staple request to invoice">
         <incoming>sequenceFlow7</incoming>
         <outgoing>sequenceFlow8</outgoing>
       </task>

       <sequenceFlow id="sequenceFlow8" sourceRef="taskStapleRequest" targetRef="taskPlaceInvoiceInOutbox"/>

       <task id="taskPlaceInvoiceInOutbox" name="Place invoice in internal outbox for new vendors">
         <incoming>sequenceFlow8</incoming>
         <outgoing>sequenceFlow9</outgoing>
       </task>

       <sequenceFlow id="sequenceFlow9" sourceRef="taskPlaceInvoiceInOutbox" targetRef="exclusiveGateway2"/>

       <exclusiveGateway id="exclusiveGateway2">
         <incoming>sequenceFlow9</incoming>
         <outgoing>sequenceFlow10</outgoing>
         <outgoing>sequenceFlow11</outgoing>
       </exclusiveGateway>

       <sequenceFlow id="sequenceFlow10" name="Urgent invoice" sourceRef="exclusiveGateway2" targetRef="intermediateCatchEvent1">
       </sequenceFlow>

       <sequenceFlow id="sequenceFlow11" name="Non-urgent invoice" sourceRef="exclusiveGateway2" targetRef="intermediateCatchEvent2">
       </sequenceFlow>

       <intermediateCatchEvent id="intermediateCatchEvent1">
         <incoming>sequenceFlow10</incoming>
         <outgoing>sequenceFlow12</outgoing>
         <timerEventDefinition/>
       </intermediateCatchEvent>

       <intermediateCatchEvent id="intermediateCatchEvent2">
         <incoming>sequenceFlow11</incoming>
         <outgoing>sequenceFlow13</outgoing>
         <timerEventDefinition/>
       </intermediateCatchEvent>

       <sequenceFlow id="sequenceFlow12" sourceRef="intermediateCatchEvent1" targetRef="endSubProcess"/>
       <sequenceFlow id="sequenceFlow13" sourceRef="intermediateCatchEvent2" targetRef="endSubProcess"/>

       <endEvent id="endSubProcess">
         <incoming>sequenceFlow12</incoming>
         <incoming>sequenceFlow13</incoming>
       </endEvent>

     </subProcess>

     <sequenceFlow id="sequenceFlow4" name="Vendor Exists" sourceRef="exclusiveGateway1" targetRef="taskSapVendorNumber"/>
     <sequenceFlow id="sequenceFlow14" sourceRef="endSubProcessNewVendor" targetRef="taskSapVendorNumber"/>

     <task id="taskSapVendorNumber" name="SAP Vendor number added to invoice">
       <incoming>sequenceFlow4</incoming>
       <incoming>sequenceFlow14</incoming>
       <outgoing>sequenceFlow15</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow15" sourceRef="taskSapVendorNumber" targetRef="exclusiveGateway3"/>

     <exclusiveGateway id="exclusiveGateway3">
       <incoming>sequenceFlow15</incoming>
       <outgoing>sequenceFlow16</outgoing>
       <outgoing>sequenceFlow17</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow16" name="Prefers sorting by vendor" sourceRef="exclusiveGateway3" targetRef="taskInvoicesSortedByVendor"/>
     <sequenceFlow id="sequenceFlow17" name="Prefers sorting by amount" sourceRef="exclusiveGateway3" targetRef="taskInvoicesSortedByAmount"/>

     <task id="taskInvoicesSortedByVendor" name="Invoices sorted by Vendor">
       <incoming>sequenceFlow16</incoming>
       <outgoing>sequenceFlow18</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow18" sourceRef="taskInvoicesSortedByVendor" targetRef="exclusiveGateway4"/>

     <task id="taskInvoicesSortedByAmount" name="Invoices sorted by amount">
       <incoming>sequenceFlow17</incoming>
       <outgoing>sequenceFlow19</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow19" sourceRef="taskInvoicesSortedByAmount" targetRef="exclusiveGateway4"/>

     <exclusiveGateway id="exclusiveGateway4">
       <incoming>sequenceFlow18</incoming>
       <incoming>sequenceFlow19</incoming>
       <outgoing>sequenceFlow20</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow20" sourceRef="exclusiveGateway4" targetRef="taskInvoicesEnteredIntoSap"/>

     <task id="taskInvoicesEnteredIntoSap" name="Invoices entered into SAP system">
       <incoming>sequenceFlow20</incoming>
       <outgoing>sequenceFlow21</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow21" sourceRef="taskInvoicesEnteredIntoSap" targetRef="endEvent"/>

     <endEvent id="endEvent">
       <incoming>sequenceFlow21</incoming>
     </endEvent>

   </process>
</definitions>