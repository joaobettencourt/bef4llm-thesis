<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definition" name="BPMN Process Model" targetNamespace="http://bpmn.io/schema/bpmn">
   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>

     <task id="Task_1" name="Process Customer Order">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="IntermediateThrowEvent_1"/>

     <intermediateThrowEvent id="IntermediateThrowEvent_1">
       <incoming>SequenceFlow_2</incoming>
       <messageEventDefinition/>
       <outgoing>MessageFlow_1</outgoing>
     </intermediateThrowEvent>

     <sequenceFlow id="SequenceFlow_3" sourceRef="StartEvent_2" targetRef="Task_2"/>

     <startEvent id="StartEvent_2">
       <incoming messageFlowRef="MessageFlow_1"/>
       <outgoing>SequenceFlow_3</outgoing>
     </startEvent>

     <task id="Task_2" name="Determine Required Parts">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_4</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_4" sourceRef="Task_2" targetRef="ExclusiveGateway_1"/>

     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_5</outgoing>
       <outgoing>SequenceFlow_6</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_5" name="No Parts Missing" sourceRef="ExclusiveGateway_1" targetRef="Task_3"/>

     <task id="Task_3" name="Start Production">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_7</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_7" sourceRef="Task_3" targetRef="Task_4"/>

     <task id="Task_4" name="Perform Quality Checks">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_8</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_8" sourceRef="Task_4" targetRef="ExclusiveGateway_2"/>

     <exclusiveGateway id="ExclusiveGateway_2">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_9</outgoing>
       <outgoing>SequenceFlow_10</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_6" name="Parts Missing" sourceRef="ExclusiveGateway_1" targetRef="Task_5"/>

     <task id="Task_5" name="Order Missing Parts">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_11</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_11" sourceRef="Task_5" targetRef="ExclusiveGateway_2"/>

     <sequenceFlow id="SequenceFlow_9" sourceRef="ExclusiveGateway_2" targetRef="Task_6"/>

     <task id="Task_6" name="Package and Label Product">
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_12</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_12" sourceRef="Task_6" targetRef="IntermediateThrowEvent_2"/>

     <intermediateThrowEvent id="IntermediateThrowEvent_2">
       <incoming>SequenceFlow_12</incoming>
       <messageEventDefinition/>
       <outgoing>MessageFlow_2</outgoing>
     </intermediateThrowEvent>

     <startEvent id="StartEvent_3">
       <incoming messageFlowRef="MessageFlow_2"/>
       <outgoing>SequenceFlow_13</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_10" sourceRef="Task_6" targetRef="EndEvent_1"/>

     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_10</incoming>
       <incoming>SequenceFlow_13</incoming>
     </endEvent>

   </process>
   <messageFlow id="MessageFlow_1" sourceRef="IntermediateThrowEvent_1" targetRef="StartEvent_2"/>
   <messageFlow id="MessageFlow_2" sourceRef="IntermediateThrowEvent_2" targetRef="StartEvent_3"/>

</definitions>