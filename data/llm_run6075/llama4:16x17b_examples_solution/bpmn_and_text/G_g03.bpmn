<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd" 
             id="definition" name="Blizzard Online Character Generator">
   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>
     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_ThinkAboutNames"/>
    
     <task id="Task_ThinkAboutNames" name="Come up with character names">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_ThinkAboutNames" targetRef="ExclusiveGateway_Account"/>
    
     <exclusiveGateway id="ExclusiveGateway_Account">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_4</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_Account" targetRef="Task_CreateBattleNetAccount">
     </sequenceFlow>
     <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_Account" targetRef="ServiceTask_CheckWoWSubscription">
     </sequenceFlow>
    
     <task id="Task_CreateBattleNetAccount" name="Create new battle.net account">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_CreateBattleNetAccount" targetRef="ServiceTask_CheckWoWSubscription"/>
    
     <serviceTask id="ServiceTask_CheckWoWSubscription">
       <incoming>SequenceFlow_4</incoming>
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </serviceTask>
     <sequenceFlow id="SequenceFlow_6" sourceRef="ServiceTask_CheckWoWSubscription" targetRef="ExclusiveGateway_Subscription"/>
    
    <exclusiveGateway id="ExclusiveGateway_Subscription">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_7</outgoing>
      <outgoing>SequenceFlow_8</outgoing>
    </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_7" sourceRef="ExclusiveGateway_Subscription" targetRef="Task_PaymentMethod">
     </sequenceFlow>
     <sequenceFlow id="SequenceFlow_8" sourceRef="ExclusiveGateway_Subscription" targetRef="EndEvent_NoSubscription">
     </sequenceFlow>
    
    <task id="Task_PaymentMethod" name="Select payment method">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_CreditCard</outgoing>
      <outgoing>SequenceFlow_BankAccount</outgoing>
    </task>

     <sequenceFlow id="SequenceFlow_CreditCard" sourceRef="Task_PaymentMethod" targetRef="Task_CreditCardInfo">
     </sequenceFlow>
     <sequenceFlow id="SequenceFlow_BankAccount" sourceRef="Task_PaymentMethod" targetRef="Task_BankAccountInfo">
     </sequenceFlow>

    <task id="Task_CreditCardInfo" name="Enter credit card information">
      <incoming>SequenceFlow_CreditCard</incoming>
      <outgoing>SequenceFlow_9</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_9" sourceRef="Task_CreditCardInfo" targetRef="Task_LogInToGame"/>

     <task id="Task_BankAccountInfo" name="Enter bank account information">
       <incoming>SequenceFlow_BankAccount</incoming>
       <outgoing>SequenceFlow_10</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_10" sourceRef="Task_BankAccountInfo" targetRef="Task_LogInToGame"/>
    
    <task id="Task_LogInToGame" name="Log into game">
      <incoming>SequenceFlow_9</incoming>
      <incoming>SequenceFlow_10</incoming>
      <outgoing>SequenceFlow_Login</outgoing>
    </task>

     <sequenceFlow id="SequenceFlow_Login" sourceRef="Task_LogInToGame" targetRef="ParallelGateway_SelectCharacter"/>
    
     <parallelGateway id="ParallelGateway_SelectCharacter">
       <incoming>SequenceFlow_Login</incoming>
       <outgoing>SequenceFlow_Realm</outgoing>
       <outgoing>SequenceFlow_Race</outgoing>
       <outgoing>SequenceFlow_Class</outgoing>
     </parallelGateway>

    <sequenceFlow id="SequenceFlow_Realm" sourceRef="ParallelGateway_SelectCharacter" targetRef="Task_Realm"/>
    <task id="Task_Realm" name="Select realm of your character">
      <incoming>SequenceFlow_Realm</incoming>
      <outgoing>SequenceFlow_RealmDone</outgoing>
    </task>

     <sequenceFlow id="SequenceFlow_RealmDone" sourceRef="Task_Realm" targetRef="ParallelGateway_DoneCharacterSelection"/>

    <sequenceFlow id="SequenceFlow_Race" sourceRef="ParallelGateway_SelectCharacter" targetRef="Task_Race"/>
    <task id="Task_Race" name="Select race of your character">
      <incoming>SequenceFlow_Race</incoming>
      <outgoing>SequenceFlow_RaceDone</outgoing>
    </task>

     <sequenceFlow id="SequenceFlow_RaceDone" sourceRef="Task_Race" targetRef="ParallelGateway_DoneCharacterSelection"/>

    <sequenceFlow id="SequenceFlow_Class" sourceRef="ParallelGateway_SelectCharacter" targetRef="Task_Class"/>
    <task id="Task_Class" name="Select class of your character">
      <incoming>SequenceFlow_Class</incoming>
      <outgoing>SequenceFlow_ClassDone</outgoing>
    </task>

     <sequenceFlow id="SequenceFlow_ClassDone" sourceRef="Task_Class" targetRef="ParallelGateway_DoneCharacterSelection"/>

    <parallelGateway id="ParallelGateway_DoneCharacterSelection">
      <incoming>SequenceFlow_RealmDone</incoming>
      <incoming>SequenceFlow_RaceDone</incoming>
      <incoming>SequenceFlow_ClassDone</incoming>
      <outgoing>SequenceFlow_DoneSelecting</outgoing>
    </parallelGateway>

     <sequenceFlow id="SequenceFlow_DoneSelecting" sourceRef="ParallelGateway_DoneCharacterSelection" targetRef="Task_EnterCharacterName"/>
    
     <task id="Task_EnterCharacterName" name="Enter character name">
       <incoming>SequenceFlow_DoneSelecting</incoming>
       <outgoing>SequenceFlow_NameEntered</outgoing>
     </task>

    <sequenceFlow id="SequenceFlow_NameEntered" sourceRef="Task_EnterCharacterName" targetRef="ExclusiveGateway_NameAvailable"/>

    <exclusiveGateway id="ExclusiveGateway_NameAvailable">
      <incoming>SequenceFlow_NameEntered</incoming>
      <outgoing>SequenceFlow_Available</outgoing>
      <outgoing>SequenceFlow_NotAvailable</outgoing>
    </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_Available" sourceRef="ExclusiveGateway_NameAvailable" targetRef="ServiceTask_CharacterCreated">
     </sequenceFlow>
     <sequenceFlow id="SequenceFlow_NotAvailable" sourceRef="ExclusiveGateway_NameAvailable" targetRef="Task_EnterCharacterName">
     </sequenceFlow>

    <serviceTask id="ServiceTask_CharacterCreated" name="Receive confirmation and character selfies">
      <incoming>SequenceFlow_Available</incoming>
      <outgoing>SequenceFlow_CharacterCreated</outgoing>
    </serviceTask>

     <sequenceFlow id="SequenceFlow_CharacterCreated" sourceRef="ServiceTask_CharacterCreated" targetRef="EndEvent_CharacterCreated"/>
    
     <endEvent id="EndEvent_NoSubscription">
       <incoming>SequenceFlow_8</incoming>
     </endEvent>

     <endEvent id="EndEvent_CharacterCreated">
       <incoming>SequenceFlow_CharacterCreated</incoming>
     </endEvent>
   </process>
</definitions>