<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="definition" name="New Application for Registering for an USI course">
   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>
     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="UserTask_1"/>
     <userTask id="UserTask_1" name="Select course">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </userTask>
     <sequenceFlow id="SequenceFlow_2" sourceRef="UserTask_1" targetRef="ExclusiveGateway_1"/>
     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_4</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_1" targetRef="ServiceTask_1">
       <conditionExpression xsi:type="tFormalExpression">free spots available</conditionExpression>
     </sequenceFlow>
     <serviceTask id="ServiceTask_1" name="System shows courses and dates">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </serviceTask>
     <sequenceFlow id="SequenceFlow_5" sourceRef="ServiceTask_1" targetRef="UserTask_2"/>
     <userTask id="UserTask_2" name="Select specific course">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </userTask>
     <sequenceFlow id="SequenceFlow_6" sourceRef="UserTask_2" targetRef="ExclusiveGateway_2"/>
     <exclusiveGateway id="ExclusiveGateway_2">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_7</outgoing>
       <outgoing>SequenceFlow_8</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_7" sourceRef="ExclusiveGateway_2" targetRef="ParallelGateway_1">
       <conditionExpression xsi:type="tFormalExpression">already registered</conditionExpression>
     </sequenceFlow>
     <sequenceFlow id="SequenceFlow_8" sourceRef="ExclusiveGateway_2" targetRef="UserTask_3">
       <conditionExpression xsi:type="tFormalExpression">not registered</conditionExpression>
     </sequenceFlow>
     <userTask id="UserTask_3" name="Check if registered at eligible university">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </userTask>
     <sequenceFlow id="SequenceFlow_9" sourceRef="UserTask_3" targetRef="ExclusiveGateway_3"/>
     <exclusiveGateway id="ExclusiveGateway_3">
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_10</outgoing>
       <outgoing>SequenceFlow_11</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_10" sourceRef="ExclusiveGateway_3" targetRef="UserTask_4">
       <conditionExpression xsi:type="tFormalExpression">eligible university</conditionExpression>
     </sequenceFlow>
     <userTask id="UserTask_4" name="Register account">
       <incoming>SequenceFlow_10</incoming>
       <outgoing>SequenceFlow_12</outgoing>
     </userTask>
     <sequenceFlow id="SequenceFlow_12" sourceRef="UserTask_4" targetRef="ParallelGateway_1"/>
     <sequenceFlow id="SequenceFlow_11" sourceRef="ExclusiveGateway_3" targetRef="UserTask_5">
       <conditionExpression xsi:type="tFormalExpression">not eligible university</conditionExpression>
     </sequenceFlow>
     <userTask id="UserTask_5" name="Request activation">
       <incoming>SequenceFlow_11</incoming>
       <outgoing>SequenceFlow_13</outgoing>
     </userTask>
     <sequenceFlow id="SequenceFlow_13" sourceRef="UserTask_5" targetRef="ParallelGateway_1"/>
     <parallelGateway id="ParallelGateway_1">
       <incoming>SequenceFlow_7</incoming>
       <incoming>SequenceFlow_12</incoming>
       <incoming>SequenceFlow_13</incoming>
       <outgoing>SequenceFlow_14</outgoing>
     </parallelGateway>
     <sequenceFlow id="SequenceFlow_14" sourceRef="ParallelGateway_1" targetRef="UserTask_6"/>
     <userTask id="UserTask_6" name="Log into account">
       <incoming>SequenceFlow_14</incoming>
       <outgoing>SequenceFlow_15</outgoing>
     </userTask>
     <sequenceFlow id="SequenceFlow_15" sourceRef="UserTask_6" targetRef="ParallelGateway_2"/>
     <parallelGateway id="ParallelGateway_2">
       <incoming>SequenceFlow_15</incoming>
       <outgoing>SequenceFlow_16</outgoing>
       <outgoing>SequenceFlow_17</outgoing>
     </parallelGateway>
     <sequenceFlow id="SequenceFlow_16" sourceRef="ParallelGateway_2" targetRef="UserTask_7"/>
     <userTask id="UserTask_7" name="Connect to twitter account">
       <incoming>SequenceFlow_16</incoming>
       <outgoing>SequenceFlow_18</outgoing>
     </userTask>
     <sequenceFlow id="SequenceFlow_18" sourceRef="UserTask_7" targetRef="UserTask_8"/>
     <userTask id="UserTask_8" name="Invite friends to course">
       <incoming>SequenceFlow_18</incoming>
     </userTask>
     <sequenceFlow id="SequenceFlow_17" sourceRef="ParallelGateway_2" targetRef="UserTask_9"/>
     <userTask id="UserTask_9" name="Provide payment information">
       <incoming>SequenceFlow_17</incoming>
       <outgoing>SequenceFlow_19</outgoing>
     </userTask>
     <sequenceFlow id="SequenceFlow_19" sourceRef="UserTask_9" targetRef="ServiceTask_2"/>
     <serviceTask id="ServiceTask_2" name="System issues course ticket">
       <incoming>SequenceFlow_19</incoming>
       <outgoing>SequenceFlow_20</outgoing>
     </serviceTask>
     <sequenceFlow id="SequenceFlow_20" sourceRef="ServiceTask_2" targetRef="EndEvent_1"/>
     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_20</incoming>
     </endEvent>
   </process>
 </definitions>