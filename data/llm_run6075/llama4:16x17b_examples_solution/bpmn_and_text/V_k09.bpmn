<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definitions" name="Business Process Model">
  <process id="Process_1" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_ReadOrder"/>
    <serviceTask id="Task_ReadOrder">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </serviceTask>
    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_ReadOrder" targetRef="ExclusiveGateway_IsInStock"/>
    <exclusiveGateway id="ExclusiveGateway_IsInStock">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
      <outgoing>SequenceFlow_4</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_IsInStock" targetRef="Task_WithDrawProduct">
      <conditionExpression xsi:type="tFormalExpression">product is in stock</conditionExpression>
    </sequenceFlow>
    <manualTask id="Task_WithDrawProduct">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_5</outgoing>
    </manualTask>
    <sequenceFlow id="SequenceFlow_5" sourceRef="Task_WithDrawProduct" targetRef="ExclusiveGateway_IsOrderReadyForShipment"/>
    <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_IsInStock" targetRef="Task_ReorderProduct">
      <conditionExpression xsi:type="tFormalExpression">product is not in stock</conditionExpression>
    </sequenceFlow>
    <serviceTask id="Task_ReorderProduct">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </serviceTask>
    <sequenceFlow id="SequenceFlow_6" sourceRef="Task_ReorderProduct" targetRef="ExclusiveGateway_WaitingTime"/>
    <exclusiveGateway id="ExclusiveGateway_WaitingTime">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_7</outgoing>
      <outgoing>SequenceFlow_8</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_7" sourceRef="ExclusiveGateway_WaitingTime" targetRef="Task_DemandDeliveryDelayPenalty">
      <conditionExpression xsi:type="tFormalExpression">arrived after more than ten days</conditionExpression>
    </sequenceFlow>
    <serviceTask id="Task_DemandDeliveryDelayPenalty">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_9</outgoing>
    </serviceTask>
    <sequenceFlow id="SequenceFlow_8" sourceRef="ExclusiveGateway_WaitingTime" targetRef="Task_RegisterInStockManagementSystem"/>
    <manualTask id="Task_RegisterInStockManagementSystem">
      <incoming>SequenceFlow_8</incoming>
      <outgoing>SequenceFlow_10</outgoing>
    </manualTask>
    <sequenceFlow id="SequenceFlow_9" sourceRef="Task_DemandDeliveryDelayPenalty" targetRef="Task_RegisterInStockManagementSystem"/>
    <sequenceFlow id="SequenceFlow_10" sourceRef="Task_RegisterInStockManagementSystem" targetRef="ExclusiveGateway_IsOrderReadyForShipment"/>
    <exclusiveGateway id="ExclusiveGateway_IsOrderReadyForShipment">
      <incoming>SequenceFlow_5</incoming>
      <incoming>SequenceFlow_10</incoming>
      <outgoing>SequenceFlow_RequestCourierAndPack</outgoing>
      <outgoing>SequenceFlow_SelectNextProduct</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_RequestCourierAndPack" sourceRef="ExclusiveGateway_IsOrderReadyForShipment" targetRef="ParallelGateway_CompleteOrder">
      <conditionExpression xsi:type="tFormalExpression">order is ready for shipment</conditionExpression>
    </sequenceFlow>
    <parallelGateway id="ParallelGateway_CompleteOrder">
      <incoming>SequenceFlow_RequestCourierAndPack</incoming>
      <outgoing>SequenceFlow_PackProducts</outgoing>
      <outgoing>SequenceFlow_RequestCourier</outgoing>
    </parallelGateway>
    <manualTask id="Task_PackProducts" name="Packing the products">
      <incoming>SequenceFlow_PackProducts</incoming>
      <outgoing>SequenceFlow_CompleteOrder</outgoing>
    </manualTask>
    <sequenceFlow id="SequenceFlow_PackProducts" sourceRef="ParallelGateway_CompleteOrder" targetRef="Task_PackProducts"/>
    <manualTask id="Task_RequestCourier" name="Request courier">
      <incoming>SequenceFlow_RequestCourier</incoming>
      <outgoing>SequenceFlow_ShipOrder</outgoing>
    </manualTask>
    <sequenceFlow id="SequenceFlow_RequestCourier" sourceRef="ParallelGateway_CompleteOrder" targetRef="Task_RequestCourier"/>
    <endEvent id="EndEvent_OrderShipped">
      <incoming>SequenceFlow_ShipOrder</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_ShipOrder" sourceRef="Task_RequestCourier" targetRef="EndEvent_OrderShipped"/>
    <sequenceFlow id="SequenceFlow_SelectNextProduct" sourceRef="ExclusiveGateway_IsOrderReadyForShipment" targetRef="Task_ReadOrder">
      <conditionExpression xsi:type="tFormalExpression">order is not ready for shipment</conditionExpression>
    </sequenceFlow>
  </process>
</definitions>