<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="definition">
  <process id="Process_1" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_Query_Webshops"/>
    <task id="Task_Query_Webshops" name="Query webshops for parts">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_Query_Webshops" targetRef="ExclusiveGateway_Delivery_Details"/>
    <exclusiveGateway id="ExclusiveGateway_Delivery_Details">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
      <outgoing>SequenceFlow_4</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_Delivery_Details" targetRef="Task_Select_Parts">
      <conditionExpression xsi:type="tFormalExpression">parts available</conditionExpression>
    </sequenceFlow>
    <task id="Task_Select_Parts" name="Select required parts">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_5</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_5" sourceRef="Task_Select_Parts" targetRef="ServiceTask_Generate_List"/>
    <serviceTask id="ServiceTask_Generate_List" name="Generate list of parts with cheapest price">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </serviceTask>
    <sequenceFlow id="SequenceFlow_6" sourceRef="ServiceTask_Generate_List" targetRef="Task_Order_Parts"/>
    <task id="Task_Order_Parts" name="Order parts">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_7" sourceRef="Task_Order_Parts" targetRef="IntermediateCatchEvent_Part_Arrived"/>
    <intermediateCatchEvent id="IntermediateCatchEvent_Part_Arrived">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </intermediateCatchEvent>
    <sequenceFlow id="SequenceFlow_8" sourceRef="IntermediateCatchEvent_Part_Arrived" targetRef="Task_Update_Stock"/>
    <task id="Task_Update_Stock" name="Update stock">
      <incoming>SequenceFlow_8</incoming>
      <outgoing>SequenceFlow_9</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_9" sourceRef="Task_Update_Stock" targetRef="ExclusiveGateway_Quantity"/>
    <exclusiveGateway id="ExclusiveGateway_Quantity">
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_10</outgoing>
      <outgoing>SequenceFlow_11</outgoing>
      <outgoing>SequenceFlow_12</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_Delivery_Details" targetRef="EndEvent_No_Parts">
      <conditionExpression xsi:type="tFormalExpression">no parts available</conditionExpression>
    </sequenceFlow>
    <endEvent id="EndEvent_No_Parts">
      <incoming>SequenceFlow_4</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_10" sourceRef="ExclusiveGateway_Quantity" targetRef="Task_Reorder_Cheapest">
      <conditionExpression xsi:type="tFormalExpression">quantity below 5</conditionExpression>
    </sequenceFlow>
    <task id="Task_Reorder_Cheapest" name="Reorder cheapest part">
      <incoming>SequenceFlow_10</incoming>
    </task>
    <sequenceFlow id="SequenceFlow_11" sourceRef="ExclusiveGateway_Quantity" targetRef="Task_Reorder_Fastest">
      <conditionExpression xsi:type="tFormalExpression">quantity below 3</conditionExpression>
    </sequenceFlow>
    <task id="Task_Reorder_Fastest" name="Reorder fastest part">
      <incoming>SequenceFlow_11</incoming>
    </task>
    <sequenceFlow id="SequenceFlow_12" sourceRef="ExclusiveGateway_Quantity" targetRef="Task_Send_Mail">
      <conditionExpression xsi:type="tFormalExpression">quantity zero</conditionExpression>
    </sequenceFlow>
    <task id="Task_Send_Mail" name="Send mail to friends complaining about webshops">
      <incoming>SequenceFlow_12</incoming>
    </task>
  </process>
</definitions>