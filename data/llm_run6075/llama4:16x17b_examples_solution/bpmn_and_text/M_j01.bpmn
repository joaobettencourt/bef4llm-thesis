<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definition" name="Business Process Model">
  <process id="Process_1" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>
    <task id="Task_1" name="Receive Order Request">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="ExclusiveGateway_1"/>
    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
      <outgoing>SequenceFlow_4</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_1" targetRef="Task_2">
      <conditionExpression xsi:type="tFormalExpression">order valid</conditionExpression>
    </sequenceFlow>
    <task id="Task_2" name="Request properties from customer">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_5</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_1">
      <conditionExpression xsi:type="http://www.w3.org/2001/XMLSchema-instance">order not valid</conditionExpression>
    </sequenceFlow>
    <endEvent id="EndEvent_1">
      <incoming>SequenceFlow_4</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_5" sourceRef="Task_2" targetRef="ParallelGateway_1"/>
    <parallelGateway id="ParallelGateway_1">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_6</outgoing>
      <outgoing>SequenceFlow_7</outgoing>
      <outgoing>SequenceFlow_8</outgoing>
      <outgoing>SequenceFlow_9</outgoing>
    </parallelGateway>
    <sequenceFlow id="SequenceFlow_6" sourceRef="ParallelGateway_1" targetRef="Task_3"/>
    <task id="Task_3" name="Order guide bar">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_14</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_7" sourceRef="ParallelGateway_1" targetRef="Task_4"/>
    <task id="Task_4" name="Order chain">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_15</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_8" sourceRef="ParallelGateway_1" targetRef="Task_5"/>
    <task id="Task_5" name="Order color">
      <incoming>SequenceFlow_8</incoming>
      <outgoing>SequenceFlow_16</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_9" sourceRef="ParallelGateway_1" targetRef="Task_6"/>
    <task id="Task_6" name="Order protective shield">
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_17</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_14" sourceRef="Task_3" targetRef="ParallelGateway_2"/>
    <parallelGateway id="ParallelGateway_2">
      <incoming>SequenceFlow_14</incoming>
      <incoming>SequenceFlow_15</incoming>
      <incoming>SequenceFlow_16</incoming>
      <incoming>SequenceFlow_17</incoming>
      <outgoing>SequenceFlow_18</outgoing>
    </parallelGateway>
    <sequenceFlow id="SequenceFlow_15" sourceRef="Task_4" targetRef="ParallelGateway_2"/>
    <sequenceFlow id="SequenceFlow_16" sourceRef="Task_5" targetRef="ParallelGateway_2"/>
    <sequenceFlow id="SequenceFlow_17" sourceRef="Task_6" targetRef="ParallelGateway_2"/>
    <sequenceFlow id="SequenceFlow_18" sourceRef="ParallelGateway_2" targetRef="Task_7"/>
    <task id="Task_7" name="Inspect parts">
      <incoming>SequenceFlow_18</incoming>
      <outgoing>SequenceFlow_19</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_19" sourceRef="Task_7" targetRef="Task_8"/>
    <task id="Task_8" name="Assemble parts">
      <incoming>SequenceFlow_19</incoming>
      <outgoing>SequenceFlow_20</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_20" sourceRef="Task_8" targetRef="ExclusiveGateway_2"/>
    <exclusiveGateway id="ExclusiveGateway_2">
      <incoming>SequenceFlow_20</incoming>
      <outgoing>SequenceFlow_21</outgoing>
      <outgoing>SequenceFlow_22</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_21" sourceRef="ExclusiveGateway_2" targetRef="Task_9">
      <conditionExpression xsi:type="tFormalExpression">parts assembled</conditionExpression>
    </sequenceFlow>
    <task id="Task_9" name="Send update to customer">
      <incoming>SequenceFlow_21</incoming>
      <outgoing>SequenceFlow_23</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_22" sourceRef="ExclusiveGateway_2" targetRef="EndEvent_2">
      <conditionExpression xsi:type="tFormalExpression">parts not assembled</conditionExpression>
    </sequenceFlow>
    <endEvent id="EndEvent_2">
      <incoming>SequenceFlow_22</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_23" sourceRef="Task_9" targetRef="ExclusiveGateway_3"/>
    <exclusiveGateway id="ExclusiveGateway_3">
      <incoming>SequenceFlow_23</incoming>
      <outgoing>SequenceFlow_24</outgoing>
      <outgoing>SequenceFlow_25</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_24" sourceRef="ExclusiveGateway_3" targetRef="Task_10">
      <conditionExpression xsi:type="tFormalExpression">positive feedback</conditionExpression>
    </sequenceFlow>
    <task id="Task_10" name="Produce additional chainsaws">
      <incoming>SequenceFlow_24</incoming>
      <outgoing>SequenceFlow_26</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_25" sourceRef="ExclusiveGateway_3" targetRef="EndEvent_3">
      <conditionExpression xsi:type="tFormalExpression">negative feedback</conditionExpression>
    </sequenceFlow>
    <endEvent id="EndEvent_3">
      <incoming>SequenceFlow_25</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_26" sourceRef="Task_10" targetRef="EndEvent_4"/>
    <endEvent id="EndEvent_4">
      <incoming>SequenceFlow_26</incoming>
    </endEvent>
  </process>
</definitions>