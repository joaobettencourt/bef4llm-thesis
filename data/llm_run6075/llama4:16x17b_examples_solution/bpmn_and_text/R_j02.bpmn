<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/BPMN20.xsd"
             id="definition" name="Inspection of an Energy Drink Bottling Machine"
             targetNamespace="http://bpmn.io/schema/bpmn">

   <process id="inspection_Process" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <userTask id="UserTask_1" name="Choose configuration">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </userTask>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="UserTask_1"/>

     <serviceTask id="ServiceTask_1" name="Read error codes">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
     </serviceTask>

     <sequenceFlow id="SequenceFlow_2" sourceRef="UserTask_1" targetRef="ServiceTask_1"/>

     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_4</outgoing>
       <outgoing>SequenceFlow_5</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_3" sourceRef="ServiceTask_1" targetRef="ExclusiveGateway_1"/>

     <serviceTask id="ServiceTask_2" name="Print error codes">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </serviceTask>

     <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_1" targetRef="ServiceTask_2">
       <conditionExpression xsi:type="tFormalExpression"> error exists  </conditionExpression>
     </sequenceFlow>

     <parallelGateway id="ParallelGateway_1">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_7</outgoing>
       <outgoing>SequenceFlow_8</outgoing>
     </parallelGateway>

     <sequenceFlow id="SequenceFlow_6" sourceRef="ServiceTask_2" targetRef="ParallelGateway_1"/>

     <manualTask id="ManualTask_1" name="Visual inspection">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </manualTask>

     <sequenceFlow id="SequenceFlow_7" sourceRef="ParallelGateway_1" targetRef="ManualTask_1"/>

     <userTask id="UserTask_2" name="Perform test run">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_10</outgoing>
     </userTask>

     <sequenceFlow id="SequenceFlow_8" sourceRef="ParallelGateway_1" targetRef="UserTask_2"/>

     <parallelGateway id="ConvergingGateway">
       <incoming>SequenceFlow_9</incoming>
       <incoming>SequenceFlow_10</incoming>
       <outgoing>SequenceFlow_11</outgoing>
     </parallelGateway>

     <sequenceFlow id="SequenceFlow_9" sourceRef="ManualTask_1" targetRef="ConvergingGateway"/>
     <sequenceFlow id="SequenceFlow_10" sourceRef="UserTask_2" targetRef="ConvergingGateway"/>

     <exclusiveGateway id="ExclusiveGateway_2">
       <incoming>SequenceFlow_11</incoming>
       <outgoing>SequenceFlow_12</outgoing>
       <outgoing>SequenceFlow_13</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_11" sourceRef="ConvergingGateway" targetRef="ExclusiveGateway_2"/>

     <userTask id="UserTask_3" name="Write final report">
       <incoming>SequenceFlow_12</incoming>
       <outgoing>SequenceFlow_14</outgoing>
     </userTask>

     <sequenceFlow id="SequenceFlow_12" sourceRef="ExclusiveGateway_2" targetRef="UserTask_3"/>

     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_14</incoming>
     </endEvent>

     <sequenceFlow id="SequenceFlow_14" sourceRef="UserTask_3" targetRef="EndEvent_1"/>
   </process>
 </definitions>