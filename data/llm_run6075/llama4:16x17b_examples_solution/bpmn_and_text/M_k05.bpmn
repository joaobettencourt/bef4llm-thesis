<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/BPMN20.xsd" 
             id="definition" name="Building a House Process">

   <process id="buildingHouseProcess" isExecutable="true">
     <startEvent id="startEvent1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="startEvent1" targetRef="sendReqToArchitect"/>

     <userTask id="sendReqToArchitect" name="Send requirements to architect">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </userTask>

     <sequenceFlow id="SequenceFlow_2" sourceRef="sendReqToArchitect" targetRef="refineReq"/>

     <userTask id="refineReq" name="Refine requirements">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
     </userTask>

     <sequenceFlow id="SequenceFlow_3" sourceRef="refineReq" targetRef="createMaterialList"/>

     <userTask id="createMaterialList" name="Create material list">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_4</outgoing>
     </userTask>

     <sequenceFlow id="SequenceFlow_4" sourceRef="createMaterialList" targetRef="parallelGateway1"/>

     <parallelGateway id="parallelGateway1">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_5</outgoing>
       <outgoing>SequenceFlow_6</outgoing>
     </parallelGateway>

     <sequenceFlow id="SequenceFlow_5" sourceRef="parallelGateway1" targetRef="sendMessages"/>

     <userTask id="sendMessages" name="Send messages to friends">
       <incoming>SequenceFlow_5</incoming>
     </userTask>

     <sequenceFlow id="SequenceFlow_6" sourceRef="parallelGateway1" targetRef="intermediateCatchEvent1"/>

     <intermediateCatchEvent id="intermediateCatchEvent1">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_7</outgoing>
     </intermediateCatchEvent>

     <sequenceFlow id="SequenceFlow_7" sourceRef="intermediateCatchEvent1" targetRef="buildTheHouse"/>

     <userTask id="buildTheHouse" name="Build the house">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_8</outgoing>
     </userTask>

     <sequenceFlow id="SequenceFlow_8" sourceRef="buildTheHouse" targetRef="sendInvitations"/>

     <userTask id="sendInvitations" name="Send invitations to friends">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </userTask>

     <sequenceFlow id="SequenceFlow_9" sourceRef="sendInvitations" targetRef="createGuestList"/>

     <userTask id="createGuestList" name="Create guest list">
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_10</outgoing>
     </userTask>

     <sequenceFlow id="SequenceFlow_10" sourceRef="createGuestList" targetRef="endEvent1"/>

     <endEvent id="endEvent1">
       <incoming>SequenceFlow_10</incoming>
     </endEvent>
   </process>
</definitions>