<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Committee Meeting Process" targetNamespace="http://example.com/bpmn">

   <process id="committeeMeetingProcess" isExecutable="true">
     <startEvent id="start" name="Start">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="start" targetRef="finalizeDates"/>

     <userTask id="finalizeDates" name="Finalize Dates">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow2" sourceRef="finalizeDates" targetRef="updateCalendars"/>

     <userTask id="updateCalendars" name="Update Group Calendars and Create Meeting Folders">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow3" sourceRef="updateCalendars" targetRef="uploadDocuments"/>

     <userTask id="uploadDocuments" name="Upload Relevant Documents">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow4</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow4" sourceRef="uploadDocuments" targetRef="remindMembers"/>

     <intermediateCatchEvent id="remindMembers" name="Remind Members to Read Documents a Week Before the Meeting">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow5</outgoing>
       <timerEventDefinition/>
     </intermediateCatchEvent>

     <sequenceFlow id="sequenceFlow5" sourceRef="remindMembers" targetRef="conductMeeting"/>

     <userTask id="conductMeeting" name="Conduct Meeting">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow6</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow6" sourceRef="conductMeeting" targetRef="prepareMinutes"/>

     <userTask id="prepareMinutes" name="Prepare Meeting Minutes">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow7</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow7" sourceRef="prepareMinutes" targetRef="qaCheck"/>

     <userTask id="qaCheck" name="Perform QA Check on Minutes">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow8</outgoing>
       <outgoing>sequenceFlow9</outgoing>
     </userTask>

     <intermediateCatchEvent id="sendMinutes" name="Send Minutes to Committee Members Within 5 Working Days">
       <incoming>sequenceFlow8</incoming>
       <outgoing>sequenceFlow10</outgoing>
       <timerEventDefinition/>
     </intermediateCatchEvent>

     <sequenceFlow id="sequenceFlow8" sourceRef="qaCheck" targetRef="sendMinutes"/>

     <userTask id="updateRecords" name="Update Departmental Records">
       <incoming>sequenceFlow10</incoming>
     </userTask>

     <endEvent id="end" name="Process Complete">
       <incoming>sequenceFlow11</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow10" sourceRef="sendMinutes" targetRef="updateRecords"/>
     <sequenceFlow id="sequenceFlow11" sourceRef="updateRecords" targetRef="end"/>

   </process>
</definitions>