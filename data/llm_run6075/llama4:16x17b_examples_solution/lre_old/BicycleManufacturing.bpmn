<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Customized Bicycle Manufacturing Process">

   <process id="customizedBicycleManufacturingProcess" isExecutable="true">
     <startEvent id="startEvent" name="Receive Order">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent" targetRef="exclusiveGateway1"/>

     <exclusiveGateway id="exclusiveGateway1" name="Accept Order?">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
       <outgoing>sequenceFlow3</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow2" sourceRef="exclusiveGateway1" targetRef="endEvent">
       <conditionExpression xsi:type="tFormalExpression">rejectOrder</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="sequenceFlow3" name="yes" sourceRef="exclusiveGateway1" targetRef="task1"/>

     <userTask id="task1" name="Inform Storehouse and Engineering Department">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow4</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow4" sourceRef="task1" targetRef="parallelGateway1"/>

     <parallelGateway id="parallelGateway1">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow5</outgoing>
       <outgoing>sequenceFlow6</outgoing>
     </parallelGateway>

     <sequenceFlow id="sequenceFlow5" sourceRef="parallelGateway1" targetRef="task2"/>

     <userTask id="task2" name="Process Part List">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow7</outgoing>
       <outgoing>sequenceFlow8</outgoing>
     </userTask>

     <exclusiveGateway id="exclusiveGateway2" name="Available in- house?">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow9</outgoing>
       <outgoing>sequenceFlow10</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow7" sourceRef="task2" targetRef="exclusiveGateway2"/>

     <sequenceFlow id="sequenceFlow9" name="yes" sourceRef="exclusiveGateway2" targetRef="task3"/>

     <userTask id="task3" name="Reserve Part">
       <incoming>sequenceFlow9</incoming>
     </userTask>

     <sequenceFlow id="sequenceFlow10" name="no" sourceRef="exclusiveGateway2" targetRef="task4"/>

     <userTask id="task4" name="Back- order Part">
       <incoming>sequenceFlow10</incoming>
     </userTask>

     <sequenceFlow id="sequenceFlow6" sourceRef="parallelGateway1" targetRef="task5"/>

     <userTask id="task5" name="Prepare for Assembling">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow11</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow11" sourceRef="task5" targetRef="exclusiveGateway3"/>

     <exclusiveGateway id="exclusiveGateway3">
       <incoming>sequenceFlow11</incoming>
       <outgoing>sequenceFlow12</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow12" sourceRef="exclusiveGateway3" targetRef="task6"/>

     <userTask id="task6" name="Assemble Bicycle">
       <incoming>sequenceFlow12</incoming>
       <outgoing>sequenceFlow13</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow13" sourceRef="task6" targetRef="task7"/>

     <userTask id="task7" name="Ship Bicycle to Customer">
       <incoming>sequenceFlow13</incoming>
       <outgoing>sequenceFlow14</outgoing>
     </userTask>

     <endEvent id="endEvent" name="End Process">
       <incoming>sequenceFlow14</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow8" sourceRef="task2" targetRef="exclusiveGateway3"/>
     <sequenceFlow id="sequenceFlow14" sourceRef="task7" targetRef="endEvent"/>

   </process>
</definitions>