<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="ZooClub Membership Process" targetNamespace="http://example.com/bpmn">

    <process id="zooClubMembershipProcess" isExecutable="true">
      <startEvent id="startEvent1" name="Start ZooClub Membership Process">
        <outgoing>sequenceFlow1</outgoing>
      </startEvent>

      <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="exclusiveGateway1"/>

      <exclusiveGateway id="exclusiveGateway1" name="Individual or Family Membership?">
        <incoming>sequenceFlow1</incoming>
        <outgoing>sequenceFlow2</outgoing>
        <outgoing>sequenceFlow3</outgoing>
      </exclusiveGateway>

      <sequenceFlow id="sequenceFlow2" sourceRef="exclusiveGateway1" targetRef="task4"> 
        <conditionExpression xsi:type="tFormalExpression">individualMembershipChosen</conditionExpression>
      </sequenceFlow>

      <userTask id="task4" name="Prepare Personal Information">
        <incoming>sequenceFlow2</incoming>
        <outgoing>sequenceFlow6</outgoing>
      </userTask>

      <sequenceFlow id="sequenceFlow3" sourceRef="exclusiveGateway1" targetRef="task5"> 
        <conditionExpression xsi:type="tFormalExpression">familyMembershipChosen</conditionExpression>
      </sequenceFlow>

      <userTask id="task5" name="Prepare Family Information">
        <incoming>sequenceFlow3</incoming>
        <outgoing>sequenceFlow7</outgoing>
      </userTask>

      <sequenceFlow id="sequenceFlow6" sourceRef="task4" targetRef="exclusiveGateway2"/> 
      <sequenceFlow id="sequenceFlow7" sourceRef="task5" targetRef="exclusiveGateway2"/> 

      <exclusiveGateway id="exclusiveGateway2">
        <incoming>sequenceFlow6</incoming>
        <incoming>sequenceFlow7</incoming>
        <outgoing>sequenceFlow8</outgoing>
      </exclusiveGateway>

      <sequenceFlow id="sequenceFlow8" sourceRef="exclusiveGateway2" targetRef="task1"/> 

      <userTask id="task1" name="Send Information to ZooClub Department">
        <incoming>sequenceFlow8</incoming>
        <outgoing>sequenceFlow9</outgoing>
      </userTask>

      <sequenceFlow id="sequenceFlow9" sourceRef="task1" targetRef="parallelGateway1"/>

      <parallelGateway id="parallelGateway1"> 
        <incoming>sequenceFlow9</incoming>
        <outgoing>sequenceFlow10</outgoing>
        <outgoing>sequenceFlow11</outgoing>
      </parallelGateway>

      <sequenceFlow id="sequenceFlow10" sourceRef="parallelGateway1" targetRef="task2"/> 

      <userTask id="task2" name="Enter Information into System and Send to Billing">
        <incoming>sequenceFlow10</incoming>
        <outgoing>sequenceFlow12</outgoing>
      </userTask>

      <sequenceFlow id="sequenceFlow11" sourceRef="parallelGateway1" targetRef="task3"/> 

      <userTask id="task3" name="Forward Information to Marketing Department">
        <incoming>sequenceFlow11</incoming>
        <outgoing>sequenceFlow13</outgoing>
      </userTask>

      <sequenceFlow id="sequenceFlow12" sourceRef="task2" targetRef="task6"/> 

      <userTask id="task6" name="Send Payment Request to Bank">
        <incoming>sequenceFlow12</incoming>
        <outgoing>sequenceFlow14</outgoing>
      </userTask>

      <sequenceFlow id="sequenceFlow13" sourceRef="task3" targetRef="intermediateCatchEvent1"/> 

      <intermediateCatchEvent id="intermediateCatchEvent1" name="Mail Magazine">
        <incoming>sequenceFlow13</incoming>
      </intermediateCatchEvent>

      <sequenceFlow id="sequenceFlow14" sourceRef="task6" targetRef="intermediateCatchEvent2"/> 

      <intermediateCatchEvent id="intermediateCatchEvent2" name="Payment Confirmed">
        <incoming>sequenceFlow14</incoming>
        <outgoing>sequenceFlow15</outgoing>
        <messageEventDefinition/> 
      </intermediateCatchEvent>

      <sequenceFlow id="sequenceFlow15" sourceRef="intermediateCatchEvent2" targetRef="task7"/> 

      <userTask id="task7" name="Print and Deliver ZooClub Card">
        <incoming>sequenceFlow15</incoming>
        <outgoing>sequenceFlow16</outgoing>
      </userTask>

      <sequenceFlow id="sequenceFlow16" sourceRef="task7" targetRef="endEvent1"/> 

      <endEvent id="endEvent1" name="End of ZooClub Membership Process">
        <incoming>sequenceFlow16</incoming>
      </endEvent>
    </process>
</definitions>