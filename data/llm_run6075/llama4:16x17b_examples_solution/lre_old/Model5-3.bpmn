<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Office Supply Request Process" targetNamespace="http://example.com/bpmn">

   <process id="officeSupplyRequestProcess" isExecutable="true">
     <startEvent id="startEvent1" name="Submit Office Supply Request">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="registerOfficeSupplyRequest"/>

     <userTask id="registerOfficeSupplyRequest" name="Register Office Supply Request">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow2" sourceRef="registerOfficeSupplyRequest" targetRef="exclusiveGateway1"/>

     <exclusiveGateway id="exclusiveGateway1">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
       <outgoing>sequenceFlow4</outgoing>
       <outgoing>sequenceFlow5</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow3" name="approved" sourceRef="exclusiveGateway1" targetRef="taskNotifyApproval">
       <conditionExpression xsi:type="tFormalExpression">${approved}</conditionExpression>
     </sequenceFlow>

     <userTask id="taskNotifyApproval" name="Notify about Approval">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow6</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow6" sourceRef="taskNotifyApproval" targetRef="subProcessMakeQuotations"/>

     <subProcess id="subProcessMakeQuotations">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow7</outgoing>
     </subProcess>

     <sequenceFlow id="sequenceFlow7" sourceRef="subProcessMakeQuotations" targetRef="taskGeneratePurchaseOrder"/>

     <userTask id="taskGeneratePurchaseOrder" name="Generate Purchase Order">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow8</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow8" sourceRef="taskGeneratePurchaseOrder" targetRef="intermediateCatchEventProductsReceived"/>

     <intermediateCatchEvent id="intermediateCatchEventProductsReceived">
       <incoming>sequenceFlow8</incoming>
       <outgoing>sequenceFlow9</outgoing>
     </intermediateCatchEvent>

     <sequenceFlow id="sequenceFlow9" sourceRef="intermediateCatchEventProductsReceived" targetRef="taskProcessInvoice"/>

     <userTask id="taskProcessInvoice" name="Process Invoice">
       <incoming>sequenceFlow9</incoming>
       <outgoing>sequenceFlow10</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow10" sourceRef="taskProcessInvoice" targetRef="endEvent1"/>

     <sequenceFlow id="sequenceFlow4" name="changeRequired" sourceRef="exclusiveGateway1" targetRef="taskNotifyChange">
       <conditionExpression xsi:type="tFormalExpression">${changeRequired}</conditionExpression>
     </sequenceFlow>

     <userTask id="taskNotifyChange" name="Notify about Required Change">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow11</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow11" sourceRef="taskNotifyChange" targetRef="registerOfficeSupplyRequest"/>

     <sequenceFlow id="sequenceFlow5" name="rejected" sourceRef="exclusiveGateway1" targetRef="taskNotifyRejection">
       <conditionExpression xsi:type="tFormalExpression">${rejected}</conditionExpression>
     </sequenceFlow>

     <userTask id="taskNotifyRejection" name="Notify about Rejection">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow12</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow12" sourceRef="taskNotifyRejection" targetRef="endEvent1"/>

     <endEvent id="endEvent1">
       <incoming>sequenceFlow10</incoming>
       <incoming>sequenceFlow12</incoming>
     </endEvent>
   </process>
 </definitions>