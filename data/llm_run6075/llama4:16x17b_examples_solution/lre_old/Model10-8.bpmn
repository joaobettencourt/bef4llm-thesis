<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="MSPO Deregistration Process">

   <process id="mspoDeregistrationProcess" isExecutable="true">
     <startEvent id="startEvent1" name="MSPO Deregisters at GO">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="task1"/>

    <userTask id="verifyDeregistrationTask" name="Verify Deregistration">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow2" sourceRef="verifyDeregistrationTask" targetRef="exclusiveGateway1"/>

     <exclusiveGateway id="exclusiveGateway1" name="Deregistration Decision">
       <incoming>sequenceFlow2</incoming>
       <outgoing>rejectSequenceFlow</outgoing>
       <outgoing>confirmSequenceFlow</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="rejectSequenceFlow" sourceRef="exclusiveGateway1" targetRef="task2">
       <conditionExpression xsi:type="tFormalExpression">deregistrationRejected</conditionExpression>
     </sequenceFlow>

     <userTask id="task2" name="Reject Deregistration">
       <incoming>rejectSequenceFlow</incoming>
       <outgoing>end1SequenceFlow</outgoing>
     </userTask>

     <sequenceFlow id="end1SequenceFlow" sourceRef="task2" targetRef="endEvent1"/>

     <endEvent id="endEvent1" name="Deregistration Rejected">
       <incoming>end1SequenceFlow</incoming>
     </endEvent>

     <sequenceFlow id="confirmSequenceFlow" sourceRef="exclusiveGateway1" targetRef="task3">
       <conditionExpression xsi:type="tFormalExpression">deregistrationConfirmed</conditionExpression>
     </sequenceFlow>

     <userTask id="task3" name="Preliminarily Confirm Deregistration">
       <incoming>confirmSequenceFlow</incoming>
       <outgoing>assignGOSequenceFlow</outgoing>
     </userTask>

     <sequenceFlow id="assignGOSequenceFlow" sourceRef="task3" targetRef="task4"/>

     <userTask id="task4" name="Assign GO as MSP">
       <incoming>assignGOSequenceFlow</incoming>
       <outgoing>informMSPSequenceFlow</outgoing>
     </userTask>

     <sequenceFlow id="informMSPSequenceFlow" sourceRef="task4" targetRef="task5"/>

     <userTask id="task5" name="Inform MSPO about Assignment Change">
       <incoming>informMSPSequenceFlow</incoming>
       <outgoing>informMPOSequenceFlow</outgoing>
     </userTask>

     <sequenceFlow id="informMPOSequenceFlow" sourceRef="task5" targetRef="task6"/>

     <userTask id="task6" name="Inform MPO about Assignment Change">
       <incoming>informMPOSequenceFlow</incoming>
       <outgoing>informSPSequenceFlow</outgoing>
     </userTask>

     <sequenceFlow id="informSPSequenceFlow" sourceRef="task6" targetRef="task7"/>

     <userTask id="task7" name="Inform SP about Assignment Change">
       <incoming>informSPSequenceFlow</incoming>
       <outgoing>end2SequenceFlow</outgoing>
     </userTask>

     <sequenceFlow id="end2SequenceFlow" sourceRef="task7" targetRef="endEvent2"/>

     <endEvent id="endEvent2" name="Assignment Changes Notified">
       <incoming>end2SequenceFlow</incoming>
     </endEvent>
   </process>
</definitions>