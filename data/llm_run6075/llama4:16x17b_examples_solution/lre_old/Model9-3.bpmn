<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org//spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/ spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" name="Town Planning Authority Process">

   <process id="townPlanningAuthorityProcess" isExecutable="true">
     <laneSet>
       <lane id="coordinationUnitLane" name="Coordination Unit">
         <flowNodeRef>startTimerEvent</flowNodeRef>
         <flowNodeRef>draftScheduleTask</flowNodeRef>
         <flowNodeRef>enterDatesTask</flowNodeRef>
         <flowNodeRef>finalizeCalendarTask</flowNodeRef>
         <flowNodeRef>sendScheduleMessageThrowEvent</flowNodeRef>
         <flowNodeRef>updateCalendarsTask</flowNodeRef>
         <flowNodeRef>sendFinalScheduleMessageThrowEvent</flowNodeRef>
         <flowNodeRef>endNoneEvent</flowNodeRef>
       </lane>
       <lane id="supportOfficerLane" name="Support Officer">
         <flowNodeRef>checkDatesTask</flowNodeRef>
       </lane>
     </laneSet>

     <sequenceFlow id="sf1" sourceRef="startTimerEvent" targetRef="draftScheduleTask"/>

     <startEvent id="startTimerEvent" name="November">
       <outgoing>sf1</outgoing>
     </startEvent>

     <userTask id="draftScheduleTask" name="Draft Schedule of Meetings">
       <incoming>sf1</incoming>
       <outgoing>sf2</outgoing>
     </userTask>

     <sequenceFlow id="sf2" sourceRef="draftScheduleTask" targetRef="enterDatesTask"/>

     <userTask id="enterDatesTask" name="Add Draft Dates to Calendars">
       <incoming>sf2</incoming>
       <outgoing>sf3</outgoing>
     </userTask>

     <sequenceFlow id="sf3" sourceRef="enterDatesTask" targetRef="checkDatesTask"/>

     <userTask id="checkDatesTask" name="Check Dates and Suggest Modifications">
       <incoming>sf3</incoming>
       <outgoing>sf4</outgoing>
     </userTask>

     <sequenceFlow id="sf4" sourceRef="checkDatesTask" targetRef="finalizeCalendarTask"/>

     <userTask id="finalizeCalendarTask" name="Recheck Dates and Look for Conflicts">
       <incoming>sf4</incoming>
       <outgoing>sf5</outgoing>
     </userTask>

     <sequenceFlow id="sf5" sourceRef="finalizeCalendarTask" targetRef="sendScheduleMessageThrowEvent"/>

     <intermediateThrowEvent id="sendScheduleMessageThrowEvent" name="Send Schedule to Committee Members">
       <incoming>sf5</incoming>
       <outgoing>sf6</outgoing>
     </intermediateThrowEvent>

     <sequenceFlow id="sf6" sourceRef="sendScheduleMessageThrowEvent" targetRef="updateCalendarsTask"/>

     <userTask id="updateCalendarsTask" name="Update Group Calendars">
       <incoming>sf6</incoming>
       <outgoing>sf7</outgoing>
     </userTask>

     <sequenceFlow id="sf7" sourceRef="updateCalendarsTask" targetRef="sendFinalScheduleMessageThrowEvent"/>

     <intermediateThrowEvent id="sendFinalScheduleMessageThrowEvent" name="Send Final Schedule to Committee Members">
       <incoming>sf7</incoming>
       <outgoing>sf8</outgoing>
     </intermediateThrowEvent>

     <endEvent id="endNoneEvent">
       <incoming>sf8</incoming>
     </endEvent>
   </process>
</definitions>