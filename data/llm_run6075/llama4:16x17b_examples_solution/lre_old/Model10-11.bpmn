<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Measurements Process" targetNamespace="http://example.com/bpmn">

    <collaboration id="measurementsCollaboration">
      <participant id="MSP" name="MSP" processRef="MSPProcess"/>
      <participant id="GO" name="GO" processRef="GOProcess"/>
    </collaboration>

    <process id="MSPProcess" isExecutable="true">
      <startEvent id="startMSP" name="Start MSP Process">
        <outgoing>requestMeasurement</outgoing>
      </startEvent>

      <sequenceFlow id="requestMeasurement" sourceRef="startMSP" targetRef="task1"/> 

      <userTask id="task1" name="Check Request">
        <incoming>requestMeasurement</incoming>
        <outgoing>exclusiveGatewayOutgoing1</outgoing>
      </userTask>

      <sequenceFlow id="exclusiveGatewayOutgoing1" sourceRef="task1" targetRef="exclusiveGateway1"/> 

      <exclusiveGateway id="exclusiveGateway1">
        <incoming>exclusiveGatewayOutgoing1</incoming>
        <outgoing>performMeasurement</outgoing>
        <outgoing>denyRequest</outgoing>
      </exclusiveGateway>

      <sequenceFlow id="performMeasurement" sourceRef="exclusiveGateway1" targetRef="task2"/> 

      <userTask id="task2" name="Perform Measurement">
        <incoming>performMeasurement</incoming>
        <outgoing>informFailureOrTransmitValues</outgoing>
      </userTask>

      <sequenceFlow id="informFailureOrTransmitValues" sourceRef="task2" targetRef="exclusiveGateway2"/> 

      <exclusiveGateway id="exclusiveGateway2">
        <incoming>informFailureOrTransmitValues</incoming>
        <outgoing>informFailure</outgoing>
        <outgoing>transmitMeasuredValues</outgoing>
      </exclusiveGateway>

      <sequenceFlow id="denyRequest" sourceRef="exclusiveGateway1" targetRef="task3"/> 

      <userTask id="task3" name="Deny Request">
        <incoming>denyRequest</incoming>
        <outgoing>endNoneEventOutgoing1</outgoing>
      </userTask>

      <sequenceFlow id="informFailure" sourceRef="exclusiveGateway2" targetRef="task4"/> 

      <userTask id="task4" name="Inform about the failure of the reading">
        <incoming>informFailure</incoming>
        <outgoing>endNoneEventOutgoing2</outgoing>
      </userTask>

      <sequenceFlow id="transmitMeasuredValues" sourceRef="exclusiveGateway2" targetRef="IntermediateCatchEvent_1"/> 

      <intermediateCatchEvent id="IntermediateCatchEvent_1">
        <incoming>transmitMeasuredValues</incoming>
        <outgoing>processMeasuredValues</outgoing>
      </intermediateCatchEvent>

      <sequenceFlow id="endNoneEventOutgoing1" sourceRef="task3" targetRef="EndNoneEvent_1"/> 

      <endEvent id="EndNoneEvent_1">
        <incoming>endNoneEventOutgoing1</incoming>
      </endEvent>

      <sequenceFlow id="endNoneEventOutgoing2" sourceRef="task4" targetRef="EndNoneEvent_2"/> 

      <endEvent id="EndNoneEvent_2">
        <incoming>endNoneEventOutgoing2</incoming>
      </endEvent>

    </process>

    <process id="GOProcess" isExecutable="true">

      <startEvent id="Start_GOP" name="Request Measurements">
        <outgoing>requestMeasurements</outgoing>
      </startEvent>

      <sequenceFlow id="requestMeasurements" sourceRef="Start_GOP" targetRef="Task_6"/> 

      <userTask id="Task_6" name="Request measurement">  
        <incoming>requestMeasurements</incoming>
        <outgoing>SequenceFlow_0</outgoing>
      </userTask>

      <sequenceFlow id="SequenceFlow_0" sourceRef="Task_6" targetRef="IntermediateCatchEvent_0"/> 

      <intermediateCatchEvent id="IntermediateCatchEvent_0">
        <incoming>SequenceFlow_0</incoming>
        <outgoing>SequenceFlow_RequestOK</outgoing>
      </intermediateCatchEvent>

      <sequenceFlow id="SequenceFlow_RequestOK" sourceRef="IntermediateCatchEvent_0" targetRef="Task_7"/> 

      <userTask id="Task_7" name="Process measured values">
        <incoming>SequenceFlow_RequestOK</incoming>
        <outgoing>SequenceFlow_ProcessedValues</outgoing>
      </userTask>

      <sequenceFlow id="SequenceFlow_ProcessedValues" sourceRef="Task_7" targetRef="Task_8"/> 

      <userTask id="Task_8" name="Send changed values">
        <incoming>SequenceFlow_ProcessedValues</incoming>
        <outgoing>SequenceFlow_TransmitReadings</outgoing>
      </userTask>

      <sequenceFlow id="SequenceFlow_TransmitReadings" sourceRef="Task_8" targetRef="Task_9"/> 

      <userTask id="Task_9" name="Transmit readings to SP">
        <incoming>SequenceFlow_TransmitReadings</incoming>
        <outgoing>SequenceFlow_EndEvent</outgoing>
      </userTask>

      <sequenceFlow id="SequenceFlow_EndEvent" sourceRef="Task_9" targetRef="EndEvent_GO"/> 

      <endEvent id="EndEvent_GO">
        <incoming>SequenceFlow_EndEvent</incoming>
      </endEvent>

    </process>

</definitions>