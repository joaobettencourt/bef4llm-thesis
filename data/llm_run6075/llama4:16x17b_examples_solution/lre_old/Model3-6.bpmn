<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Claims Notification Process">

   <process id="claimsNotificationProcess" isExecutable="true">
     <startEvent id="startEvent1" name="Claim Received">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="task1"/>

     <userTask id="task1" name="Check if Claimant is Insured">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow2" sourceRef="task1" targetRef="exclusiveGateway1"/>

     <exclusiveGateway id="exclusiveGateway1" name="Is Claimant Insured?">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
       <outgoing>sequenceFlow4</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow3" sourceRef="exclusiveGateway1" targetRef="task6">
       <conditionExpression xsi:type="tFormalExpression">insured</conditionExpression>
     </sequenceFlow>

     <userTask id="task6" name="Inform Claimant to Reject Claim">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow5</outgoing>
     </userTask>

     <endEvent id="endEvent1" name="Claim Rejected">
       <incoming>sequenceFlow5</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow5" sourceRef="task6" targetRef="endEvent1"/>

     <userTask id="evaluateSeverityTask" name="Evaluate Severity of Claim">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow7</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow7" sourceRef="evaluateSeverityTask" targetRef="exclusiveGateway2"/>

     <exclusiveGateway id="exclusiveGateway2" name="Claim Severity">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow8</outgoing>
       <outgoing>sequenceFlow9</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow8" sourceRef="exclusiveGateway2" targetRef="task3">
       <conditionExpression xsi:type="tFormalExpression">simpleClaim</conditionExpression>
     </sequenceFlow>

     <userTask id="task3" name="Send Simple Claim Forms">
       <incoming>sequenceFlow8</incoming>
       <outgoing>sequenceFlow10</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow10" sourceRef="task3" targetRef="checkFormsCompletenessTask"/>

     <sequenceFlow id="sequenceFlow9" sourceRef="exclusiveGateway2" targetRef="task4">
       <conditionExpression xsi:type="tFormalExpression">complexClaim</conditionExpression>
     </sequenceFlow>

     <userTask id="task4" name="Send Complex Claim Forms">
       <incoming>sequenceFlow9</incoming>
       <outgoing>sequenceFlow11</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow11" sourceRef="task4" targetRef="checkFormsCompletenessTask"/>

     <userTask id="checkFormsCompletenessTask" name="Check Forms for Completeness">
       <incoming>sequenceFlow10</incoming>
       <incoming>sequenceFlow11</incoming>
       <outgoing>sequenceFlow12</outgoing>
     </userTask>

     <exclusiveGateway id="exclusiveGateway3" name="Are Forms Complete?">
       <incoming>sequenceFlow12</incoming>
       <outgoing>sequenceFlow13</outgoing>
       <outgoing>sequenceFlow14</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow12" sourceRef="checkFormsCompletenessTask" targetRef="exclusiveGateway3"/>

     <sequenceFlow id="sequenceFlow13" sourceRef="exclusiveGateway3" targetRef="registerClaimTask">
       <conditionExpression xsi:type="tFormalExpression">complete</conditionExpression>
     </sequenceFlow>

     <userTask id="registerClaimTask" name="Register Claim in Claims Management System">
       <incoming>sequenceFlow13</incoming]
       <outgoing>sequenceFlow15</outgoing>
     </userTask>

     <endEvent id="claimRegisteredEndEvent" name="Claims Notification Process Completed">
       <incoming>sequenceFlow15</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow15" sourceRef="registerClaimTask" targetRef="claimRegisteredEndEvent"/>

     <sequenceFlow id="sequenceFlow14" sourceRef="exclusiveGateway3" targetRef="informClaimantToUpdateFormsTask">
       <conditionExpression xsi:type="tFormalExpression">incomplete</conditionExpression>
     </sequenceFlow>

     <userTask id="informClaimantToUpdateFormsTask" name="Inform Claimant to Update Forms">
       <incoming>sequenceFlow14</incoming]
       <outgoing>sequenceFlow16</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow16" sourceRef="informClaimantToUpdateFormsTask" targetRef="checkFormsCompletenessTask"/>
   </process>
 </definitions>