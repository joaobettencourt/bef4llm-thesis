<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/pec/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/pec/20100524/MODEL http://www.omg.org/spec/DD/20100524/DC/06-02-01.xsd"
             targetNamespace="http://bpmn.oo/schema/bpmn"
             id="definition" name="MSPN Registration Process">

   <process id="mspnRegistrationProcess" isExecutable="true">
     <startEvent id="startEvent1" name="MSPN Registers Measurement at GO">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="task1"/>

     <userTask id="task1" name="GO Examines Application of MSPN">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow2" sourceRef="task1" targetRef="exclusiveGateway1"/>

     <exclusiveGateway id="exclusiveGateway1" name="Application Accepted or Rejected?">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
       <outgoing>sequenceFlow4</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow3" sourceRef="exclusiveGateway1" targetRef="task3">
     </sequenceFlow>

     <sequenceFlow id="sequenceFlow4" sourceRef="exclusiveGateway1" targetRef="endEvent2">
     </sequenceFlow>

     <userTask id="task2" name="GO Rejects Application of MSPN">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow5</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow5" sourceRef="task2" targetRef="endEvent1"/>

     <endEvent id="endEvent1" name="Application Rejected End">
       <incoming>sequenceFlow5</incoming>
     </endEvent>

     <userTask id="task3" name="GO Confirms Application of MSPN and Assigns MSPN">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow6</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow6" sourceRef="task3" targetRef="task4"/>

     <userTask id="task4" name="GO Informs MSPO about Assignment of MSPN">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow7</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow7" sourceRef="task4" targetRef="task5"/>

     <userTask id="task5" name="GO Informs MPO about Assignment of MSPN">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow8</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow8" sourceRef="task5" targetRef="task6"/>

     <userTask id="task6" name="GO Informs SP about Assignment of MSPN">
       <incoming>sequenceFlow8</incoming>
       <outgoing>sequenceFlow9</outgoing>
     </userTask>

     <endEvent id="endEvent2" name="Assignment Notification End">
       <incoming>sequenceFlow9</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow9" sourceRef="task6" targetRef="endEvent2"/>
   </process>
</definitions>