<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Bill Examination Process" targetNamespace="http://bpmn.io/schema/bpmn">

   <process id="billExaminationProcess" isExecutable="true">
     <startEvent id="startEvent1" name="Start Bill Examination">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="exclusiveGateway1"/>

     <exclusiveGateway id="exclusiveGateway1" name="Bill Source?">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
       <outgoing>sequenceFlow3</outgoing>
       <outgoing>sequenceFlow4</outgoing>
       <outgoing>sequenceFlow5</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow2" sourceRef="exclusiveGateway1" targetRef="task1">
       <conditionExpression xsi:type="tFormalExpression">MPOO sends bill for temporary continuation of metering point operations</conditionExpression>
     </sequenceFlow>

     <userTask id="task1" name="Examine Bill">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow6</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow6" sourceRef="task1" targetRef="exclusiveGateway2"/>

     <exclusiveGateway id="exclusiveGateway2" name="Action on Bill">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow7</outgoing>
       <outgoing>sequenceFlow8</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow7" sourceRef="exclusiveGateway2" targetRef="task2">
       <conditionExpression xsi:type="tFormalExpression">Confirm bill with payment advice</conditionExpression>
     </sequenceFlow>

     <userTask id="task2" name="Confirm Bill with Payment Advice">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow9</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow9" sourceRef="task2" targetRef="endEvent1"/>

     <sequenceFlow id="sequenceFlow8" sourceRef="exclusiveGateway2" targetRef="task3">
       <conditionExpression xsi:type="tFormalExpression">Reject bill</conditionExpression>
     </sequenceFlow>

     <userTask id="task3" name="Reject Bill">
       <incoming>sequenceFlow8</incoming>
       <outgoing>sequenceFlow10</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow10" sourceRef="task3" targetRef="endEvent1"/>

     <endEvent id="endEvent1" name="End Bill Examination">
       <incoming>sequenceFlow9</incoming>
       <incoming>sequenceFlow10</incoming>
     </endEvent>

     <!-- Additional Flows for different bill sources  -->

     <sequenceFlow id="sequenceFlow3" sourceRef="exclusiveGateway1" targetRef="task4">
       <conditionExpression xsi:type="tFormalExpression">MSPO sends bill for temporary continuation of measurement</conditionExpression>
     </sequenceFlow>

     <userTask id="task4" name="Examine Bill">
       <incoming>sequenceFlow3</incoming>
       <!-- outgoing flows  -->
     </userTask>

     <sequenceFlow id="sequenceFlow11" sourceRef="exclusiveGateway1" targetRef="task5">
       <conditionExpression xsi:type="tFormalExpression">MSPO sends bill for additional readings</conditionExpression>
     </sequenceFlow>

     <userTask id="task5" name="Examine Bill">
       <incoming>sequenceFlow11</incoming>
       <!-- outgoing flows  -->
     </userTask>

     <sequenceFlow id="sequenceFlow12" sourceRef="exclusiveGateway1" targetRef="task6">
       <conditionExpression xsi:type="tFormalExpression">MPOO sends bill for equipment acquisition</conditionExpression>
     </sequenceFlow>

     <userTask id="task6" name="Examine Bill">
       <incoming>sequenceFlow12</incoming>
       <!-- outgoing flows  -->
     </userTask>
   </process>
</definitions>