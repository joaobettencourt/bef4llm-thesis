<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="MPON MPOO Process" targetNamespace="http://example.com/bpmn">

   <collaboration id="collaboration">
     <participant id="mpon" name="MPON" processRef="mponProcess"/>
     <participant id="mpoo" name="MPOO" processRef="mpooProcess"/>
     <messageFlow id="requestBidMessageFlow" sourceRef="mponProcess" targetRef="mpooProcess"/>
     <messageFlow id="tenderMessageFlow" sourceRef="mpooProcess" targetRef="mponProcess"/>
     <messageFlow id="orderMessageFlow" sourceRef="mponProcess" targetRef="mpooProcess"/>
     <messageFlow id="confirmOrderMessageFlow" sourceRef="mpooProcess" targetRef="mponProcess"/>
   </collaboration>

   <process id="mponProcess" isExecutable="true">
     <startEvent id="startEvent1" name="Start Process">
       <outgoing>requestBidSequenceFlow</outgoing>
     </startEvent>

     <sequenceFlow id="requestBidSequenceFlow1" sourceRef="startEvent1" targetRef="requestBidTask"/>

     <userTask id="requestBidTask" name="Request a device takeover bid">
       <incoming>requestBidSequenceFlow1</incoming>
       <outgoing>tenderSequenceFlow2</outgoing>
     </userTask>

     <sequenceFlow id="tenderSequenceFlow2" sourceRef="requestBidTask" targetRef="orderTask"/>

     <userTask id="orderTask" name="Order">
       <incoming>tenderSequenceFlow2</incoming>
       <outgoing>confirmOrderSequenceFlow3</outgoing>
     </userTask>

     <sequenceFlow id="confirmOrderSequenceFlow3" sourceRef="orderTask" targetRef="endEvent1"/>

     <endEvent id="endEvent1" name="End Process">
       <incoming>confirmOrderSequenceFlow3</incoming>
     </endEvent>
   </process>

   <process id="mpooProcess" isExecutable="true">
     <startEvent id="startMessageEvent2" name="Receive Request for Bid">
       <outgoing>tenderSequenceFlow4</outgoing>
     </startEvent>

     <sequenceFlow id="tenderSequenceFlow4" sourceRef="startMessageEvent2" targetRef="tenderTask"/>

     <userTask id="tenderTask" name="Tender the equipment takeover">
       <incoming>tenderSequenceFlow4</incoming>
       <outgoing>orderSequenceFlow5</outgoing>
     </userTask>

     <sequenceFlow id="orderSequenceFlow5" sourceRef="tenderTask" targetRef="confirmOrderTask"/>

     <userTask id="confirmOrderTask" name="Confirm order and transmission of master data">
       <incoming>orderSequenceFlow5</incoming>
       <outgoing>endSequenceFlow6</outgoing>
     </userTask>

     <sequenceFlow id="endSequenceFlow6" sourceRef="confirmOrderTask" targetRef="endMessageEvent2"/>

     <endEvent id="endMessageEvent2" name="End Process">
       <incoming>endSequenceFlow6</incoming>
     </endEvent>
   </process>
</definitions>