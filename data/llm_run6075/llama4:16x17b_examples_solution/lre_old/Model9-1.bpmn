<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Daily Defaulters Process">

   <process id="dailyDefaultersProcess" isExecutable="true">
     <startEvent id="startEvent" name="Weekday Morning">
       <outgoing>sequenceFlow1</outgoing>
       <timerEventDefinition interval="PT0H" repeat="P1D"/>
     </startEvent>

     <userTask id="backupDatabaseTask" name="Backup Database">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent" targetRef="backupDatabaseTask"/>

     <exclusiveGateway id="checkDefaultersGateway" name="Check Defaulters">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
       <outgoing>sequenceFlow4</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow2" sourceRef="backupDatabaseTask" targetRef="checkDefaultersGateway"/>

     <userTask id="registerDefaultingAccountsTask" name="Register Defaulting Customers & Accounts">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow5</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow3" sourceRef="checkDefaultersGateway" targetRef="registerDefaultingAccountsTask">
       <conditionExpression xsi:type="tFormalExpression">newRecordsFound</conditionExpression>
     </sequenceFlow>

     <exclusiveGateway id="crmCheckGateway" name="CRM Check">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow6</outgoing>
       <outgoing>sequenceFlow7</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow4" sourceRef="checkDefaultersGateway" targetRef="crmCheckGateway">
       <conditionExpression xsi:type="tFormalExpression">noNewRecordsFound</conditionExpression>
     </sequenceFlow>

     <userTask id="alertSupervisor230pmTask" name="Alert Supervisor 2:30 PM">
       <incoming>sequenceFlow8</incoming>
       <outgoing>sequenceFlow9</outgoing>
     </userTask>

     <intermediateCatchEvent id="catchEvent230pm" name="2:30 PM Deadline">
       <timerEventDefinition/>
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow8</outgoing>
     </intermediateCatchEvent>

     <sequenceFlow id="sequenceFlow5" sourceRef="registerDefaultingAccountsTask" targetRef="catchEvent230pm"/>

     <userTask id="checkCrmForNewReturnsTask" name="Check CRM for New Returns">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow10</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow6" sourceRef="crmCheckGateway" targetRef="checkCrmForNewReturnsTask"/>

     <exclusiveGateway id="reconcileGateway" name="Reconcile">
       <incoming>sequenceFlow10</incoming>
       <outgoing>sequenceFlow11</outgoing>
       <outgoing>sequenceFlow12</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow10" sourceRef="checkCrmForNewReturnsTask" targetRef="reconcileGateway">
       <conditionExpression xsi:type="tFormalExpression">newReturnsFound</conditionExpression>
     </sequenceFlow>

     <userTask id="alertSupervisor400pmTask" name="Alert Supervisor 4:00 PM">
       <incoming>sequenceFlow13</incoming>
       <outgoing>sequenceFlow14</outgoing>
     </userTask>

     <intermediateCatchEvent id="catchEvent400pm" name="4:00 PM Deadline">
       <timerEventDefinition/>
       <incoming>sequenceFlow12</incoming>
       <outgoing>sequenceFlow13</outgoing>
     </intermediateCatchEvent>

     <sequenceFlow id="sequenceFlow12" sourceRef="reconcileGateway" targetRef="catchEvent400pm"/>

     <endEvent id="processEnd" name="Process Completed">
       <incoming>sequenceFlow11</incoming>
       <incoming>sequenceFlow9</incoming>
       <incoming>sequenceFlow14</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow11" sourceRef="reconcileGateway" targetRef="processEnd"/>
     <sequenceFlow id="sequenceFlow7" sourceRef="crmCheckGateway" targetRef="registerDefaultingAccountsTask"/>
     <sequenceFlow id="sequenceFlow8" sourceRef="catchEvent230pm" targetRef="alertSupervisor230pmTask"/>
     <sequenceFlow id="sequenceFlow9" sourceRef="alertSupervisor230pmTask" targetRef="processEnd"/>
     <sequenceFlow id="sequenceFlow13" sourceRef="catchEvent400pm" targetRef="alertSupervisor400pmTask"/>
     <sequenceFlow id="sequenceFlow14" sourceRef="alertSupervisor400pmTask" targetRef="processEnd"/>

   </process>
</definitions>