<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Going Public Process">

   <process id="goingPublicProcess" isExecutable="true">
     <startEvent id="startEvent1" name="Decision to Go Public">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="task1"/>

     <userTask id="task1" name="Select Underwriters">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow2" sourceRef="task1" targetRef="exclusiveGateway1"/>

     <exclusiveGateway id="exclusiveGateway1" name="Facts Presented Fairly?">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
       <outgoing>sequenceFlow4</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow3" sourceRef="exclusiveGateway1" targetRef="task2">
       <conditionExpression xsi:type="tFormalExpression">factsPresentedFairly</conditionExpression>
     </sequenceFlow>

     <userTask id="task2" name="Prepare Registration Statement for SEC Approval">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow5</outgoing>
     </userTask>

     <parallelGateway id="parallelGateway1">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow6</outgoing>
       <outgoing>sequenceFlow7</outgoing>
     </parallelGateway>

     <sequenceFlow id="sequenceFlow5" sourceRef="task2" targetRef="parallelGateway1"/>

     <userTask id="task3" name="Check Compliance with Laws">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow8</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow6" sourceRef="parallelGateway1" targetRef="task3"/>

     <intermediateCatchEvent id="intermediateCatchEvent1" name="SEC Approval">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow9</outgoing>
     </intermediateCatchEvent>

     <sequenceFlow id="sequenceFlow7" sourceRef="parallelGateway1" targetRef="intermediateCatchEvent1"/>

     <exclusiveGateway id="exclusiveGateway2">
       <incoming>sequenceFlow9</incoming>
       <outgoing>sequenceFlow10</outgoing>
       <outgoing>sequenceFlow11</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow8" sourceRef="task3" targetRef="intermediateCatchEvent1"/>

     <sequenceFlow id="sequenceFlow9" sourceRef="intermediateCatchEvent1" targetRef="exclusiveGateway2"/>

     <userTask id="task4" name="Fix Issue Price">
       <incoming>sequenceFlow10</incoming>
       <outgoing>sequenceFlow12</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow10" sourceRef="exclusiveGateway2" targetRef="task4"/>

     <parallelGateway id="parallelGateway2">
       <incoming>sequenceFlow12</incoming>
       <outgoing>sequenceFlow13</outgoing>
       <outgoing>sequenceFlow14</outgoing>
     </parallelGateway>

     <sequenceFlow id="sequenceFlow12" sourceRef="task4" targetRef="parallelGateway2"/>

     <userTask id="task5" name="Buy Stock">
       <incoming>sequenceFlow13</incoming>
       <outgoing>sequenceFlow15</outgoing>
     </userTask>

     <userTask id="task6" name="Offer to Public">
       <incoming>sequenceFlow14</incoming>
       <outgoing>sequenceFlow16</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow13" sourceRef="parallelGateway2" targetRef="task5"/>

     <sequenceFlow id="sequenceFlow14" sourceRef="parallelGateway2" targetRef="task6"/>

     <endEvent id="endEvent1" name="Going Public Process Complete">
       <incoming>sequenceFlow15</incoming>
     </endEvent>

     <endEvent id="endEvent2" name="Going Public Process Failed">
       <incoming>sequenceFlow16</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow15" sourceRef="task5" targetRef="endEvent1"/>

     <sequenceFlow id="sequenceFlow16" sourceRef="task6" targetRef="endEvent2"/>
   </process>
</definitions>