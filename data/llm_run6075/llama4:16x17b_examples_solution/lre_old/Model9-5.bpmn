<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Expense Report Process" targetNamespace="http://bpmn.io/schema/bpmn">

   <process id="expenseReportProcess" isExecutable="true">
     <startEvent id="start" name="Receive Expense Report">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="start" targetRef="exclusiveGateway1"/>

     <exclusiveGateway id="exclusiveGateway1" name="Does account exist?">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
       <outgoing>sequenceFlow3</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow2" sourceRef="exclusiveGateway1" targetRef="task3">
       <conditionExpression xsi:type="tFormalExpression">accountExists</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="sequenceFlow3" sourceRef="exclusiveGateway1" targetRef="createAccountTask">
       <conditionExpression xsi:type="tFormalExpression">not accountExists</conditionExpression>
     </sequenceFlow>

     <userTask id="createAccountTask" name="Create Account">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow4</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow4" sourceRef="createAccountTask" targetRef="exclusiveGateway2"/>

     <exclusiveGateway id="exclusiveGateway2" name="Automatic Approval?">
       <incoming>sequenceFlow4</incoming>
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow5</outgoing>
       <outgoing>sequenceFlow6</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow5" sourceRef="exclusiveGateway2" targetRef="sendForPaymentTask">
       <conditionExpression xsi:type="tFormalExpression">amountUnder200</conditionExpression>
     </sequenceFlow>

     <userTask id="sendForPaymentTask" name="Send for Payment">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow7</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow6" sourceRef="exclusiveGateway2" targetRef="conductSupervisorReviewTask">
       <conditionExpression xsi:type="tFormalExpression">amountOver200</conditionExpression>
     </sequenceFlow>

     <userTask id="conductSupervisorReviewTask" name="Conduct Supervisor Review">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow8</outgoing>
     </userTask>

     <exclusiveGateway id="authorizePaymentGateway" name="Authorize Payment?">
       <incoming>sequenceFlow8</incoming>
       <outgoing>sequenceFlow9</outgoing>
       <outgoing>sequenceFlow10</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow9" sourceRef="authorizePaymentGateway" targetRef="transferToEmployeeAccountTask">
       <conditionExpression xsi:type="tFormalExpression">approved</conditionExpression>
     </sequenceFlow>

     <userTask id="transferToEmployeeAccountTask" name="Transfer to Employee Account">
       <incoming>sequenceFlow9</incoming>
       <outgoing>sequenceFlow11</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow10" sourceRef="authorizePaymentGateway" targetRef="notifyEmployeeOfRejectionTask">
       <conditionExpression xsi:type="tFormalExpression">not approved</conditionExpression>
     </sequenceFlow>

     <userTask id="notifyEmployeeOfRejectionTask" name="Notify Employee of Rejection">
       <incoming>sequenceFlow10</incoming>
       <outgoing>sequenceFlow12</outgoing>
     </userTask>

     <intermediateCatchEvent id="timer1" name="7 days">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow13</outgoing>
     </intermediateCatchEvent>

     <userTask id="sendApprovalInProgressEmailTask" name="Send Approval in Progress Email">
       <incoming>sequenceFlow13</incoming>
       <outgoing>sequenceFlow14</outgoing>
     </userTask>

     <intermediateCatchEvent id="timer2" name="30 days">
       <incoming>sequenceFlow14</incoming>
       <outgoing>sequenceFlow15</outgoing>
     </intermediateCatchEvent>

     <userTask id="sendCancellationNoticeAndAdviseToReSubmitTask" name="Send Cancellation Notice and Advise to Re-Submit">
       <incoming>sequenceFlow15</incoming>
       <outgoing>sequenceFlow16</outgoing>
     </userTask>

     <endEvent id="processStoppedEnd" name="Process Stopped">
       <incoming>sequenceFlow16</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow7" sourceRef="sendForPaymentTask" targetRef="timer1"/>

     <sequenceFlow id="sequenceFlow11" sourceRef="transferToEmployeeAccountTask" targetRef="parallelGateway1"/>

     <userTask id="sendApprovalInProgressEmailAfterTimerTask" name="Send Approval in Progress Email After Timer">
       <incoming>sequenceFlow13</incoming>
       <outgoing>sequenceFlow14</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow8" sourceRef="conductSupervisorReviewTask" targetRef="authorizePaymentGateway"/>

     <parallelGateway id="parallelGateway1">
       <incoming>sequenceFlow11</incoming>
       <outgoing>sequenceFlow17</outgoing>
     </parallelGateway>

     <endEvent id="processCompletedEnd" name="Process Completed">
       <incoming>sequenceFlow17</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow13" sourceRef="timer1" targetRef="sendApprovalInProgressEmailTask"/>

     <sequenceFlow id="sequenceFlow14" sourceRef="sendApprovalInProgressEmailTask" targetRef="timer2"/>

     <sequenceFlow id="sequenceFlow15" sourceRef="timer2" targetRef="sendCancellationNoticeAndAdviseToReSubmitTask"/>

     <sequenceFlow id="sequenceFlow16" sourceRef="sendCancellationNoticeAndAdviseToReSubmitTask" targetRef="processStoppedEnd"/>

     <sequenceFlow id="sequenceFlow17" sourceRef="parallelGateway1" targetRef="processCompletedEnd"/>
   </process>
</definitions>