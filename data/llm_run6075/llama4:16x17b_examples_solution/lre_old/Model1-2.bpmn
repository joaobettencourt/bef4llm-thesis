<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" 
             targetNamespace="http://example.com/bpmn">

   <process id="repairProcess" isExecutable="true">
     <startEvent id="startEvent1">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="task1"/>

     <userTask id="task1" name="Bring in defective computer">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow2" sourceRef="task1" targetRef="task2"/>

     <userTask id="task2" name="Check defect and hand out repair cost calculation">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow3" sourceRef="task2" targetRef="exclusiveGateway1"/>

     <exclusiveGateway id="exclusiveGateway1">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow4</outgoing>
       <outgoing>sequenceFlow5</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow4" sourceRef="exclusiveGateway1" targetRef="task3">
       <conditionExpression xsi:type="tFormalExpression">costsAcceptable</conditionExpression>
     </sequenceFlow>

     <userTask id="task3" name="Take computer home unrepaired">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow6</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow5" sourceRef="exclusiveGateway1" targetRef="parallelGateway1"/>

     <parallelGateway id="parallelGateway1">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow7</outgoing>
       <outgoing>sequenceFlow8</outgoing>
     </parallelGateway>

     <sequenceFlow id="sequenceFlow7" sourceRef="parallelGateway1" targetRef="task4"/>

     <userTask id="task4" name="Check and repair hardware">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow9</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow8" sourceRef="parallelGateway1" targetRef="task5"/>

     <userTask id="task5" name="Check and configure software">
       <incoming>sequenceFlow8</incoming>
       <outgoing>sequenceFlow10</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow9" sourceRef="task4" targetRef="exclusiveGateway2"/>

     <exclusiveGateway id="exclusiveGateway2">
       <incoming>sequenceFlow9</incoming>
       <incoming>sequenceFlow10</incoming>
       <outgoing>sequenceFlow11</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow10" sourceRef="task5" targetRef="exclusiveGateway2"/>

     <sequenceFlow id="sequenceFlow11" sourceRef="exclusiveGateway2" targetRef="task6"/>

     <userTask id="task6" name="Test system functionality">
       <incoming>sequenceFlow11</incoming>
       <outgoing>sequenceFlow12</outgoing>
     </userTask>

     <boundaryEvent id="boundaryEvent1" attachedToRef="task6">
       <outgoing>sequenceFlow13</outgoing>
       <errorEventDefinition/>
     </boundaryEvent>

     <sequenceFlow id="sequenceFlow12" sourceRef="task6" targetRef="endEvent1"/>

     <sequenceFlow id="sequenceFlow13" sourceRef="boundaryEvent1" targetRef="parallelGateway1"/>

     <sequenceFlow id="sequenceFlow6" sourceRef="task3" targetRef="endEvent2"/>

     <endEvent id="endEvent1">
       <incoming>sequenceFlow12</incoming>
     </endEvent>

     <endEvent id="endEvent2">
       <incoming>sequenceFlow6</incoming>
     </endEvent>
   </process>
 </definitions>