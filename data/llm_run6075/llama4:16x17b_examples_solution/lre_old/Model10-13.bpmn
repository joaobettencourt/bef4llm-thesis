<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" name="INQ and IP Process" targetNamespace="http://example.com/bpmn/processes">
   <collaboration id="collaboration">
     <participant id="inqParticipant" name="INQ" processRef="inqProcess"/>
     <participant id="ipParticipant" name="IP" processRef="ipProcess"/>
     <messageFlow id="transmitDataRequestMF" sourceRef="inqParticipant" targetRef="ipParticipant"/>
     <messageFlow id="responseMF" sourceRef="ipParticipant" targetRef="inqParticipant"/>
   </collaboration>

   <process id="inqProcess" isExecutable="true">
     <startEvent id="start" name="Start Requesting Data">
       <outgoing>requestDataSF</outgoing>
     </startEvent>

     <sequenceFlow id="requestDataSF" sourceRef="start" targetRef="transmitDataRequest"/>

     <userTask id="transmitDataRequest" name="Transmit Transaction Data Request">
       <incoming>requestDataSF</incoming>
       <outgoing>dataRequestSentSF</outgoing>
     </userTask>

     <sequenceFlow id="dataRequestSentSF" sourceRef="transmitDataRequest" targetRef="receiveResponse"/>

     <intermediateCatchEvent id="receiveResponse">
       <incoming>dataRequestSentSF</incoming>
       <outgoing>processResponseSF</outgoing>
     </intermediateCatchEvent>

     <sequenceFlow id="processResponseSF" sourceRef="receiveResponse" targetRef="exclusiveGateway"/>

     <exclusiveGateway id="exclusiveGateway">
       <incoming>processResponseSF</incoming>
       <outgoing>dataTransmittedSF</outgoing>
       <outgoing>requestRejectedSF</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="dataTransmittedSF" sourceRef="exclusiveGateway" targetRef="endDataTransmitted">
     </sequenceFlow>

     <sequenceFlow id="requestRejectedSF" sourceRef="exclusiveGateway" targetRef="endRequestRejected">
     </sequenceFlow>

     <endEvent id="endDataTransmitted" name="Data Transmitted">
       <incoming>dataTransmittedSF</incoming>
     </endEvent>

     <endEvent id="endRequestRejected" name="Request Rejected">
       <incoming>requestRejectedSF</incoming>
     </endEvent>
   </process>

   <process id="ipProcess" isExecutable="true">
     <startEvent id="startCheckRequest" name="Start Checking Request">
       <incoming>transmitDataRequestMF</incoming>
       <outgoing>checkRequestSF</outgoing>
     </startEvent>

     <sequenceFlow id="checkRequestSF" sourceRef="startCheckRequest" targetRef="checkRequestTask"/>

     <userTask id="checkRequestTask" name="Check Request">
       <incoming>checkRequestSF</incoming>
       <outgoing>checkedSF</outgoing>
     </userTask>

     <sequenceFlow id="checkedSF" sourceRef="checkRequestTask" targetRef="exclusiveGateway2"/>

     <exclusiveGateway id="exclusiveGateway2">
       <incoming>checkedSF</incoming>
       <outgoing>transmitDataSF</outgoing>
       <outgoing>rejectRequestSF</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="transmitDataSF" sourceRef="exclusiveGateway2" targetRef="transmitDataTask"/>

     <userTask id="transmitDataTask" name="Transmit Data">
       <incoming>transmitDataSF</incoming>
       <outgoing>dataTransmittedSF2</outgoing>
     </userTask>

     <sequenceFlow id="dataTransmittedSF2" sourceRef="transmitDataTask" targetRef="endResponseSent"/>

     <sequenceFlow id="rejectRequestSF" sourceRef="exclusiveGateway2" targetRef="rejectRequestTask"/>

     <userTask id="rejectRequestTask" name="Reject Request">
       <incoming>rejectRequestSF</incoming>
       <outgoing>requestRejectedSF2</outgoing>
     </userTask>

     <sequenceFlow id="requestRejectedSF2" sourceRef="rejectRequestTask" targetRef="endResponseSent"/>

     <endEvent id="endResponseSent" name="Response Sent">
       <incoming>dataTransmittedSF2</incoming>
       <incoming>requestRejectedSF2</incoming>
     </endEvent>
   </process>
</definitions>