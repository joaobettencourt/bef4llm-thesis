<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Customer Acquisition Process" targetNamespace="http://example.com/bpmn">

   <process id="customerAcquisitionProcess" isExecutable="true">
     <startEvent id="startEvent1" name="Start Customer Acquisition">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="exclusiveGateway1"/>

     <exclusiveGateway id="exclusiveGateway1">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
       <outgoing>sequenceFlow3</outgoing>
       <outgoing>sequenceFlow4</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow2" sourceRef="exclusiveGateway1" targetRef="taskBuyData"/>
     <sequenceFlow id="sequenceFlow3" sourceRef="exclusiveGateway1" targetRef="taskVisitExhibition"/>
     <sequenceFlow id="sequenceFlow4" sourceRef="exclusiveGateway1" targetRef="taskUseOtherSources"/>

     <userTask id="taskBuyData" name="Buy Data for Cold Calls">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow5</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow5" sourceRef="taskBuyData" targetRef="exclusiveGateway2"/>

     <userTask id="taskVisitExhibition" name="Participate in Exhibition">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow6</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow6" sourceRef="taskVisitExhibition" targetRef="exclusiveGateway2"/>

     <userTask id="taskUseOtherSources" name="Use Other Sources">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow7</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow7" sourceRef="taskUseOtherSources" targetRef="exclusiveGateway2"/>

     <exclusiveGateway id="exclusiveGateway2">
       <incoming>sequenceFlow5</incoming>
       <incoming>sequenceFlow6</incoming>
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow8</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow8" sourceRef="exclusiveGateway2" targetRef="taskDetermineContactPerson"/>

     <userTask id="taskDetermineContactPerson" name="Determine Contact Person and Budget">
       <incoming>sequenceFlow8</incoming>
       <outgoing>sequenceFlow9</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow9" sourceRef="taskDetermineContactPerson" targetRef="exclusiveGateway3"/>

     <exclusiveGateway id="exclusiveGateway3">
       <incoming>sequenceFlow9</incoming>
       <outgoing>sequenceFlow10</outgoing>
       <outgoing>sequenceFlow11</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow10" sourceRef="exclusiveGateway3" targetRef="taskOnlinePresentation"/>
     <sequenceFlow id="sequenceFlow11" sourceRef="exclusiveGateway3" targetRef="endEvent1"/>

     <userTask id="taskOnlinePresentation" name="Give Online Presentation">
       <incoming>sequenceFlow10</incoming>
       <outgoing>sequenceFlow12</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow12" sourceRef="taskOnlinePresentation" targetRef="eventBasedGateway1"/>

     <eventBasedGateway id="eventBasedGateway1">
       <incoming>sequenceFlow12</incoming>
       <outgoing>sequenceFlow13</outgoing>
       <outgoing>sequenceFlow14</outgoing>
     </eventBasedGateway>

     <intermediateCatchEvent id="intermediateCatchEvent1" name="Customer Comes Back Within 2 Weeks">
       <incoming>sequenceFlow13</incoming>
       <outgoing>sequenceFlow15</outgoing>
       <messageEventDefinition/>
     </intermediateCatchEvent>

     <sequenceFlow id="sequenceFlow13" sourceRef="eventBasedGateway1" targetRef="intermediateCatchEvent1"/>
     <sequenceFlow id="sequenceFlow14" sourceRef="eventBasedGateway1" targetRef="intermediateCatchEvent2"/>

     <intermediateCatchEvent id="intermediateCatchEvent2">
       <incoming>sequenceFlow14</incoming>
       <outgoing>sequenceFlow16</outgoing>
       <messageEventDefinition/>
     </intermediateCatchEvent>

     <sequenceFlow id="sequenceFlow15" sourceRef="intermediateCatchEvent1" targetRef="endEvent2"/>
     <sequenceFlow id="sequenceFlow16" sourceRef="intermediateCatchEvent2" targetRef="taskFollowUp"/>

     <userTask id="taskFollowUp" name="Follow Up with Customer">
       <incoming>sequenceFlow16</incoming>
       <outgoing>sequenceFlow17</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow17" sourceRef="taskFollowUp" targetRef="endEvent2"/>

     <endEvent id="endEvent1" name="End Process">
       <incoming>sequenceFlow11</incoming>
     </endEvent>

     <endEvent id="endEvent2" name="Create Quotation">
       <incoming>sequenceFlow15</incoming>
       <incoming>sequenceFlow17</incoming>
     </endEvent>
   </process>
 </definitions>