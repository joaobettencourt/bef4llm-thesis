<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/BPMN20.xsd"
             id="definitions" targetNamespace="http://bpmn.io/schema/bpmn">

  <process id="inspectionProcess" isExecutable="true">
    <startEvent id="startInspection" name="Start Inspection">
      <outgoing>enterMachineDetails</outgoing>
    </startEvent>

    <sequenceFlow id="enterMachineDetails" sourceRef="startInspection" targetRef="enterMachineTypeAndSerialNumber"/>

    <userTask id="enterMachineTypeAndSerialNumber" name="Enter Machine Type and Serial Number">
      <incoming>enterMachineDetails</incoming>
      <outgoing>beginInspection</outgoing>
    </userTask>

    <sequenceFlow id="beginInspection" sourceRef="enterMachineTypeAndSerialNumber" targetRef="askQuestions"/>

    <task id="askQuestions" name="Ask Questions and Input Values">
      <incoming>beginInspection</incoming>
      <outgoing>collectDataFromMachine</outgoing>
    </task>

    <sequenceFlow id="collectDataFromMachine" sourceRef="askQuestions" targetRef="collectDataAutomatically"/>

    <serviceTask id="collectDataAutomatically" name="Collect Data from Machine Automatically">
      <incoming>collectDataFromMachine</incoming>
      <outgoing>evaluateResults</outgoing>
    </serviceTask>

    <sequenceFlow id="evaluateResults" sourceRef="collectDataAutomatically" targetRef="exclusiveGateway"/>

    <exclusiveGateway id="exclusiveGateway" name="Are Additional Questions Needed?">
      <incoming>evaluateResults</incoming>
      <outgoing>additionalQuestionsNeeded</outgoing>
      <outgoing>noAdditionalQuestions</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="additionalQuestionsNeeded" sourceRef="exclusiveGateway" targetRef="askMoreQuestions">
      <conditionExpression xsi:type="tFormalExpression">needs more questions</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="noAdditionalQuestions" sourceRef="exclusiveGateway" targetRef="endInspection">
      <conditionExpression xsi:type="tFormalExpression">no more questions needed</conditionExpression>
    </sequenceFlow>

    <task id="askMoreQuestions" name="Ask More Questions">
      <incoming>additionalQuestionsNeeded</incoming>
      <outgoing>evaluateResultsAgain</outgoing>
    </task>

    <sequenceFlow id="evaluateResultsAgain" sourceRef="askMoreQuestions" targetRef="collectDataAutomatically"/>

    <endEvent id="endInspection" name="End Inspection">
      <incoming>noAdditionalQuestions</incoming>
    </endEvent>
  </process>
</definitions>