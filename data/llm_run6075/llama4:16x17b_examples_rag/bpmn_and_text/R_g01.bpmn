                 xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_0geryc1">
    <bpmn:participant id="Participant_0ygkg4f" name="Online Tool" processRef="Process_1"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Start Repair Process">
      <bpmn:outgoing>SequenceFlow_14a0oky</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="SequenceFlow_14a0oky" sourceRef="StartEvent_1" targetRef="Task_EnterModelAndBrokenPart"/>
    <bpmn:userTask id="Task_EnterModelAndBrokenPart" name="Enter model and what is broken">
      <bpmn:outgoing>SequenceFlow_023hzxi</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="SequenceFlow_023hzxi" sourceRef="Task_EnterModelAndBrokenPart" targetRef="ExclusiveGateway_1"/>
    <bpmn:exclusiveGateway id="ExclusiveGateway_1">
      <bpmn:incoming>SequenceFlow_023hzxi</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1rss71o</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_0buzwss</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="SequenceFlow_1rss71o" sourceRef="ExclusiveGateway_1" targetRef="Task_GetMaterialsAndTools"/>
    <bpmn:userTask id="Task_GetMaterialsAndTools" name="Get materials and tools">
      <bpmn:outgoing>SequenceFlow_0mp5byl</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="SequenceFlow_0mp5byl" sourceRef="Task_GetMaterialsAndTools" targetRef="InclusiveGateway_1"/>
    <bpmn:inclusiveGateway id="InclusiveGateway_1">
      <bpmn:incoming>SequenceFlow_0mp5byl</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_035vf60</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:sequenceFlow id="SequenceFlow_035vf60" sourceRef="InclusiveGateway_1" targetRef="ExclusiveGateway_2"/>
    <bpmn:exclusiveGateway id="ExclusiveGateway_2">
      <bpmn:incoming>SequenceFlow_035vf60</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_06kfaev</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_0v64x8b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="SequenceFlow_06kfaev" sourceRef="ExclusiveGateway_2" targetRef="Task_FixPhone"/>
    <bpmn:userTask id="Task_FixPhone" name="Fix phone">
      <bpmn:outgoing>SequenceFlow_0v64x8b</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="SequenceFlow_0v64x8b" sourceRef="Task_FixPhone" targetRef="EndEvent_SuccessfulRepair"/>
    <bpmn:endEvent id="EndEvent_SuccessfulRepair" name="Successful Repair">
      <bpmn:incoming>SequenceFlow_0v64x8b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow_0buzwss" sourceRef="ExclusiveGateway_1" targetRef="Task_SendToExpert"/>
    <bpmn:userTask id="Task_SendToExpert" name="Send to expert">
      <bpmn:outgoing>SequenceFlow_1j94oja</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="SequenceFlow_1j94oja" sourceRef="Task_SendToExpert" targetRef="EndEvent_UnsuccessfulRepair"/>
    <bpmn:endEvent id="EndEvent_UnsuccessfulRepair" name="Unsuccessful Repair">
      <bpmn:incoming>SequenceFlow_1j94oja</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>