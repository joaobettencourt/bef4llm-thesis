<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/06-02-01.xsd"
             id="definitions" targetNamespace="http://bpmn.io/schema/bpmn">
  <process id="NewApplicationforRegisteringforUSICourse" isExecutable="true">
    <startEvent id="StartEvent_1" name="New Application for Registering for USI course">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>
    <userTask id="Task_1" name="Select a course">
      <outgoing>SequenceFlow_2</outgoing>
    </userTask>
    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="ExclusiveGateway_1"/>
    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
      <outgoing>SequenceFlow_4</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_3" name="Slots available" sourceRef="ExclusiveGateway_1" targetRef="Task_2"/>
    <userTask id="Task_2" name="Check course dates">
      <outgoing>SequenceFlow_5</outgoing>
    </userTask>
    <sequenceFlow id="SequenceFlow_5" sourceRef="Task_2" targetRef="ExclusiveGateway_2"/>
    <exclusiveGateway id="ExclusiveGateway_2">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_6" sourceRef="ExclusiveGateway_2" targetRef="Task_3"/>
    <userTask id="Task_3" name="Check existing account">
      <outgoing>SequenceFlow_7</outgoing>
    </userTask>
    <sequenceFlow id="SequenceFlow_7" sourceRef="Task_3" targetRef="ExclusiveGateway_3"/>
    <exclusiveGateway id="ExclusiveGateway_3">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_8" sourceRef="ExclusiveGateway_3" targetRef="Task_4"/>
    <userTask id="Task_4" name="Connect Twitter account">
      <outgoing>SequenceFlow_9</outgoing>
    </userTask>
    <sequenceFlow id="SequenceFlow_9" sourceRef="Task_4" targetRef="Task_5"/>
    <userTask id="Task_5" name="Complete registration and payment information">
      <outgoing>SequenceFlow_10</outgoing>
    </userTask>
    <sequenceFlow id="SequenceFlow_10" sourceRef="Task_5" targetRef="EndEvent_1"/>
    <endEvent id="EndEvent_1" name="Course registration complete">
      <incoming>SequenceFlow_10</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_4" name="No account" sourceRef="ExclusiveGateway_1" targetRef="Task_6"/>
    <userTask id="Task_6" name="Check university eligibility">
      <outgoing>SequenceFlow_11</outgoing>
    </userTask>
    <sequenceFlow id="SequenceFlow_11" sourceRef="Task_6" targetRef="ExclusiveGateway_4"/>
    <exclusiveGateway id="ExclusiveGateway_4">
      <incoming>SequenceFlow_11</incoming>
      <outgoing>SequenceFlow_12</outgoing>
      <outgoing>SequenceFlow_13</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_12" name="Eligible" sourceRef="ExclusiveGateway_4" targetRef="Task_7"/>
    <userTask id="Task_7" name="Register account">
      <outgoing>SequenceFlow_14</outgoing>
    </userTask>
    <sequenceFlow id="SequenceFlow_14" sourceRef="Task_7" targetRef="EndEvent_1"/>
    <sequenceFlow id="SequenceFlow_13" name="Not Eligible" sourceRef="ExclusiveGateway_4" targetRef="Task_8"/>
    <userTask id="Task_8" name="Request activation">
      <outgoing>SequenceFlow_15</outgoing>
    </userTask>
    <sequenceFlow id="SequenceFlow_15" sourceRef="Task_8" targetRef="EndEvent_1"/>
  </process>
</definitions>