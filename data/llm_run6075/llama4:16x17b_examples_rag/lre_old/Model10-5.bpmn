<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
                 id="Definitions" targetNamespace="http://www.example.com">

  <bpmn:collaboration id="Collaboration">
    <bpmn:participant id="MPON" name="MPON" processRef="Process_MPNO"/>
    <bpmn:participant id="MPOO" name="MPOO" processRef="Process_MPOO"/>
    <bpmn:messageFlow id="MessageFlow_0" sourceRef="Task_RequestBid_MPNO" targetRef="StartEvent_SendTender_MPOO"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_MPNO" isExecutable="true">
    <bpmn:startEvent id="StartEvent_BeginOrderProcess" name="Begin Order Process">
      <bpmn:outgoing>SequenceFlow_0</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:sequenceFlow id="SequenceFlow_0" sourceRef="StartEvent_BeginOrderProcess" targetRef="Task_RequestBid_MPNO"/>

    <bpmn:task id="Task_RequestBid_MPNO" name="Request device takeover bid of the MPOO">
      <bpmn:incoming>SequenceFlow_0</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="Task_RequestBid_MPNO" targetRef="IntermediateCatchEvent_WaitForTender_MPNO"/>

    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_WaitForTender_MPNO" name="Wait for tender">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="IntermediateCatchEvent_WaitForTender_MPNO" targetRef="Task_PlaceOrder_MPNO"/>

    <bpmn:task id="Task_PlaceOrder_MPNO" name="Place an order at the MPOO">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="Task_PlaceOrder_MPNO" targetRef="IntermediateCatchEvent_WaitForConfirmation_MPNO"/>

    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_WaitForConfirmation_MPNO" name="Wait for order confirmation">
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="IntermediateCatchEvent_WaitForConfirmation_MPNO" targetRef="EndEvent_OrderConfirmed_MPNO"/>

    <bpmn:endEvent id="EndEvent_OrderConfirmed_MPNO" name="Order Confirmed">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>

  <bpmn:process id="Process_MPOO" isExecutable="true">
    <bpmn:startEvent id="StartEvent_SendTender_MPOO" name="Send Tender for Equipment Takeover">
      <bpmn:incoming messageRef="MessageFlow_0"/>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="StartEvent_SendTender_MPOO" targetRef="Task_SendTender_MPOO"/>

    <bpmn:task id="Task_SendTender_MPOO" name="Send a tender for the equipment takeover to the MPON">
      <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="Task_SendTender_MPOO" targetRef="IntermediateCatchEvent_WaitForOrder_MPOO"/>

    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_WaitForOrder_MPOO" name="Wait for order">
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:sequenceFlow id="SequenceFlow_7" sourceRef="IntermediateCatchEvent_WaitForOrder_MPOO" targetRef="Task_ConfirmOrder_MPOO"/>

    <bpmn:task id="Task_ConfirmOrder_MPOO" name="Confirm the order of the MPON and send master data">
      <bpmn:incoming>SequenceFlow_7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_8</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_8" sourceRef="Task_ConfirmOrder_MPOO" targetRef="EndEvent_OrderConfirmed_MPOO"/>

    <bpmn:endEvent id="EndEvent_OrderConfirmed_MPOO" name="Order Confirmed">
      <bpmn:incoming>SequenceFlow_8</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>

</bpmn:definitions>