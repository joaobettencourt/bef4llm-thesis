<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
                 id="Definitions" targetNamespace="http://www.example.com">

   <bpmn:collaboration id="Collaboration">
     <bpmn:participant id="Participant_Customer" name="Customer" processRef="Process_Customer"/>
     <bpmn:participant id="Participant_ZooClub" name="ZooClub" processRef="Process_ZooClub"/>
     <bpmn:participant id="Participant_Billing" name="Billing" processRef="Process_Billing"/>
     <bpmn:participant id="Participant_Marketing" name="Marketing" processRef="Process_Marketing"/>
     <bpmn:participant id="Participant_Bank" name="Bank" processRef="Process_Bank"/>

     <bpmn:messageFlow id="MessageFlow_1" sourceRef="Task_SendInformationToZooClub" targetRef="StartEvent_ZooClub"/>
     <bpmn:messageFlow id="MessageFlow_2" sourceRef="Task_SendPaymentRequest" targetRef="StartEvent_Billing"/>
     <bpmn:messageFlow id="MessageFlow_3" sourceRef="Task_PayFee" targetRef="IntermediateCatchEvent_PaymentConfirmed"/>
     <bpmn:messageFlow id="MessageFlow_4" sourceRef="Task_ForwardDataToMarketing" targetRef="StartEvent_Marketing"/>

   </bpmn:collaboration>

   <bpmn:process id="Process_Customer">
     <bpmn:startEvent id="StartEvent_Customer">
       <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
     </bpmn:startEvent>

     <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_Customer" targetRef="ExclusiveGateway_MembershipType"/>

     <bpmn:exclusiveGateway id="ExclusiveGateway_MembershipType">
       <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
       <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
     </bpmn:exclusiveGateway>

     <bpmn:sequenceFlow id="SequenceFlow_2" name="Individual Membership" sourceRef="ExclusiveGateway_MembershipType" targetRef="Task_PreparePersonalData_Individual">
       <bpmn:conditionExpression xsi:type="tFormalExpression">${membershipType  ==  'individual'}</bpmn:conditionExpression>
     </bpmn:sequenceFlow>

     <bpmn:task id="Task_PreparePersonalData_Individual" name="Prepare Personal Data for Individual Membership">
       <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
     </bpmn:task>

     <bpmn:sequenceFlow id="SequenceFlow_3" name="Family Membership" sourceRef="ExclusiveGateway_MembershipType" targetRef="Task_PreparePersonalData_Family">
       <bpmn:conditionExpression xsi:type="tFormalExpression">${membershipType  ==  'family'}</bpmn:conditionExpression>
     </bpmn:sequenceFlow>

     <bpmn:task id="Task_PreparePersonalData_Family" name="Prepare Personal Data for Family Membership">
       <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
     </bpmn:task>

     <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="Task_PreparePersonalData_Individual" targetRef="Task_SendInformationToZooClub"/>
     <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="Task_PreparePersonalData_Family" targetRef="Task_SendInformationToZooClub"/>

     <bpmn:task id="Task_SendInformationToZooClub" name="Send Information to Zoo Club">
       <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
       <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
       <bpmn:outgoing>MessageFlow_1</bpmn:outgoing>
     </bpmn:task>

     <bpmn:endEvent id="EndEvent_Customer" name="Membership Card Received">
       <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
     </bpmn:endEvent>

     <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="Task_ReceiveMembershipCard" targetRef="EndEvent_Customer"/>

   </bpmn:process>

   <bpmn:process id="Process_ZooClub">
     <bpmn:startEvent id="StartEvent_ZooClub">
       <bpmn:incoming>MessageFlow_1</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
     </bpmn:startEvent>

     <bpmn:sequenceFlow id="SequenceFlow_7" sourceRef="StartEvent_ZooClub" targetRef="Task_IntroduceDataIntoSystem"/>

     <bpmn:task id="Task_IntroduceDataIntoSystem" name="Introduce Personal Data into System">
       <bpmn:incoming>SequenceFlow_7</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_8</bpmn:outgoing>
     </bpmn:task>

     <bpmn:sequenceFlow id="SequenceFlow_8" sourceRef="Task_IntroduceDataIntoSystem" targetRef="Task_SendPaymentRequest"/>

     <bpmn:task id="Task_SendPaymentRequest" name="Send Payment Request">
       <bpmn:incoming>SequenceFlow_8</bpmn:incoming>
       <bpmn:outgoing>MessageFlow_2</bpmn:outgoing>
     </bpmn:task>

     <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_PaymentConfirmed" name="Payment Confirmed">
       <bpmn:incoming>MessageFlow_3</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_9</bpmn:outgoing>
     </bpmn:intermediateCatchEvent>

     <bpmn:sequenceFlow id="SequenceFlow_9" sourceRef="IntermediateCatchEvent_PaymentConfirmed" targetRef="Task_PrintAndDeliverCard"/>

     <bpmn:task id="Task_PrintAndDeliverCard" name="Print and Deliver Membership Card">
       <bpmn:incoming>SequenceFlow_9</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
     </bpmn:task>

     <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="Task_PrintAndDeliverCard" targetRef="Task_SendMembershipCard"/>

     <bpmn:task id="Task_SendMembershipCard" name="Send Membership Card">
       <bpmn:incoming>SequenceFlow_10</bpmn:incoming>
     </bpmn:task>

     <bpmn:subProcess id="Task_ForwardDataToMarketing" name="Forward Data to Marketing">
       <bpmn:outgoing>MessageFlow_4</bpmn:outgoing>
     </bpmn:subProcess>

   </bpmn:process>

   <bpmn:process id="Process_Billing">
     <bpmn:startEvent id="StartEvent_Billing">
       <bpmn:incoming>MessageFlow_2</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_11</bpmn:outgoing>
     </bpmn:startEvent>

     <bpmn:sequenceFlow id="SequenceFlow_11" sourceRef="StartEvent_Billing" targetRef="Task_SendPaymentRequestToBank"/>

     <bpmn:task id="Task_SendPaymentRequestToBank" name="Send Payment Request to Bank">
       <bpmn:incoming>SequenceFlow_11</bpmn:incoming>
       <bpmn:outgoing>MessageFlow_3</bpmn:outgoing>
     </bpmn:task>

   </bpmn:process>

   <bpmn:process id="Process_Marketing">
     <bpmn:startEvent id="StartEvent_Marketing">
       <bpmn:incoming>MessageFlow_4</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_12</bpmn:outgoing>
     </bpmn:startEvent>

     <bpmn:sequenceFlow id="SequenceFlow_12" sourceRef="StartEvent_Marketing" targetRef="Task_RequestMagazineSubscription"/>

     <bpmn:task id="Task_RequestMagazineSubscription" name="Request Magazine Subscription">
       <bpmn:incoming>SequenceFlow_12</bpmn:incoming>
     </bpmn:task>

   </bpmn:process>

   <bpmn:process id="Process_Bank">
     <bpmn:startEvent id="StartEvent_Bank">
       <bpmn:incoming>MessageFlow_3</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_13</bpmn:outgoing>
     </bpmn:startEvent>

     <bpmn:sequenceFlow id="SequenceFlow_13" sourceRef="StartEvent_Bank" targetRef="Task_PayFee"/>

     <bpmn:task id="Task_PayFee" name="Pay Fee">
       <bpmn:incoming>SequenceFlow_13</bpmn:incoming>
       <bpmn:outgoing>MessageFlow_3</bpmn:outgoing>
     </bpmn:task>

   </bpmn:process>

</bpmn:definitions>