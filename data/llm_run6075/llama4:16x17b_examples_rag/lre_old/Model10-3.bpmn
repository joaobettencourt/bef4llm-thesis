<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="Definitions" targetNamespace="http://www.example.com">

   <collaboration id="Collaboration">
     <participant id="MPOO" name="MPOO" processRef="Pool_MPOO"/>
     <participant id="GO" name="GO" processRef="Pool_GO"/>
   </collaboration>

   <process id="Pool_MPOO" isExecutable="false">
     <laneSet>
       <lane id="Lane_MPOO" name="">
         <flowNodeRef>StartNoneEvent_0</flowNodeRef>
         <flowNodeRef>Task_Deregister</flowNodeRef>
         <flowNodeRef>EndNoneEvent_MP_OO_End</flowNodeRef>
         <flowNodeRef>Task_ConfirmContinuation</flowNodeRef>
       </lane>
     </laneSet>

     <startEvent id="StartNoneEvent_0" name="Deregister at GO">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <task id="Task_Deregister" name="Deregister">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartNoneEvent_0" targetRef="Task_Deregister"/>

     <intermediateThrowEvent id="IntermediateMessageEventThrowing_0">
       <incoming>SequenceFlow_2</incoming>
     </intermediateThrowEvent>

     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_Deregister" targetRef="IntermediateMessageEventThrowing_0"/>

     <endEvent id="EndNoneEvent_MP_OO_End" name="End">
       <incoming>SequenceFlow_4</incoming>
     </endEvent>

     <task id="Task_ConfirmContinuation" name="Confirm Continuation to MPOO">
       <incoming>SequenceFlow_5</incoming>
     </task>

     <sequenceFlow id="SequenceFlow_4" sourceRef="IntermediateMessageEventCatching_0" targetRef="EndNoneEvent_MP_OO_End"/>
     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_InformeMPOOAssignment" targetRef="Task_ConfirmContinuation"/>

   </process>

   <process id="Pool_GO" isExecutable="false">
     <laneSet>
       <lane id="Lane_GO" name="">
         <flowNodeRef>StartMessageEvent_0</flowNodeRef>
         <flowNodeRef>ExclusiveGateway_1</flowNodeRef>
         <flowNodeRef>Task_RejectDeregistration</flowNodeRef>
         <flowNodeRef>Task_PrepareReadmission</flowNodeRef>
       </lane>
     </laneSet>

     <startEvent id="StartMessageEvent_0" name="Verify Deregistration">
       <outgoing>SequenceFlow_10</outgoing>
     </startEvent>

     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_10</incoming>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_4</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_10" sourceRef="StartMessageEvent_0" targetRef="ExclusiveGateway_1"/>

     <task id="Task_RejectDeregistration" name="Reject Deregistration">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_1" targetRef="Task_RejectDeregistration"/>

     <endEvent id="EndNoneEvent_GO_End" name="End">
       <incoming>SequenceFlow_7</incoming>
     </endEvent>

     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_RejectDeregistration" targetRef="EndNoneEvent_GO_End"/>
     <sequenceFlow id="SequenceFlow_7" sourceRef="Task_RejectDeregistration" targetRef="EndNoneEvent_GO_End"/>

     <task id="Task_PrepareReadmission" name="Prepare Readmission">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_8</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_1" targetRef="Task_PrepareReadmission"/>

     <exclusiveGateway id="ExclusiveGateway_2">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_9</outgoing>
       <outgoing>SequenceFlow_11</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_8" sourceRef="Task_PrepareReadmission" targetRef="ExclusiveGateway_2"/>

     <task id="Task_BindGOasMPO" name="Bind GO as MPO">
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_12</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_9" sourceRef="ExclusiveGateway_2" targetRef="Task_BindGOasMPO"/>

     <task id="Task_InformeMPOOAssignment" name="Inform MPOO">
       <incoming>SequenceFlow_12</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_12" sourceRef="Task_BindGOasMPO" targetRef="Task_InformeMPOOAssignment"/>

     <task id="Task_ObligateContinuation" name="Obligate Continuation">
       <incoming>SequenceFlow_11</incoming>
       <outgoing>SequenceFlow_13</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_11" sourceRef="ExclusiveGateway_2" targetRef="Task_ObligateContinuation"/>

     <intermediateCatchEvent id="IntermediateMessageEventCatching_0">
       <incoming>SequenceFlow_14</incoming>
       <outgoing>SequenceFlow_4</outgoing>
     </intermediateCatchEvent>

     <sequenceFlow id="SequenceFlow_13" sourceRef="Task_ObligateContinuation" targetRef="Task_ConfirmContinuationMPOO"/>

     <task id="Task_ConfirmContinuationMPOO" name="Confirm Continuation">
       <incoming>SequenceFlow_15</incoming>
     </task>

     <sequenceFlow id="SequenceFlow_14" sourceRef="IntermediateMessageEventThrowing_0" targetRef="IntermediateMessageEventCatching_0"/>
   </process>

</definitions>