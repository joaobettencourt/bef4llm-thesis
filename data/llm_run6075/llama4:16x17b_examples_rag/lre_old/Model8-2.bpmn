<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
                  id="definitions" targetNamespace="http://www.example.com">

  <bpmn:process id="jobDescriptionProcess" name="Create Job Description" isExecutable="true">
    <bpmn:laneSet>
      <bpmn:lane id="hrDepartmentLane" name="HR Department">
        <bpmn:flowNodeRef>startEvent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>createJobDescriptionTask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clarifyInformationTask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>isClearGateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef:hasApprovedGateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submitForApprovalTask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>correctDescriptionTask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>jobPostedEndEvent</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="startEvent" name="Vacancy Reported">
      <bpmn:outgoing>sequenceFlow1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="createJobDescriptionTask" name="Create Job Description from Information">
      <bpmn:incoming>sequenceFlow1</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="sequenceFlow1" sourceRef="startEvent" targetRef="createJobDescriptionTask"/>
    <bpmn:sequenceFlow id="sequenceFlow2" sourceRef="createJobDescriptionTask" targetRef="isClearGateway"/>

    <bpmn:exclusiveGateway id="isClearGateway" name="Is Information Clear?">
      <bpmn:incoming>sequenceFlow2</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow3</bpmn:outgoing>
      <bpmn:outgoing>sequenceFlow4</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="sequenceFlow3" sourceRef="isClearGateway" targetRef="submitForApprovalTask">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${informationClear  == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="sequenceFlow4" sourceRef="isClearGateway" targetRef="clarifyInformationTask">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${informationClear  == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:task id="clarifyInformationTask" name="Ask Department for Clarification">
      <bpmn:incoming>sequenceFlow4</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow5</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="sequenceFlow5" sourceRef="clarifyInformationTask" targetRef="createJobDescriptionTask"/>

    <bpmn:task id="submitForApprovalTask" name="Submit Job Description for Approval">
      <bpmn:incoming>sequenceFlow3</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow6</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="sequenceFlow6" sourceRef="submitForApprovalTask" targetRef="hasApprovedGateway"/>

    <bpmn:exclusiveGateway id="hasApprovedGateway" name="Has Job Description Been Approved?">
      <bpmn:incoming>sequenceFlow6</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow7</bpmn:outgoing>
      <bpmn:outgoing>sequenceFlow8</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="sequenceFlow7" sourceRef="hasApprovedGateway" targetRef="jobPostedEndEvent">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${approved  == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:task id="correctDescriptionTask" name="Correct Job Description Based on Feedback">
      <bpmn:incoming>sequenceFlow8</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow9</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="sequenceFlow8" sourceRef="hasApprovedGateway" targetRef="correctDescriptionTask">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${approved  == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="sequenceFlow9" sourceRef="correctDescriptionTask" targetRef="submitForApprovalTask"/>

    <bpmn:endEvent id="jobPostedEndEvent" name="Job Posted">
      <bpmn:incoming>sequenceFlow7</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>

</bpmn:definitions>