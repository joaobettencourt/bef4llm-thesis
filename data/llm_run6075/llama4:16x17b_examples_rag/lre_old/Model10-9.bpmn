<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
                 id="definitions" targetNamespace="http://www.example.com">

  <bpmn:process id="changeRequestProcess" name="Change Request Process" isExecutable="true">
    <bpmn:startEvent id="startEvent_1" name="SP/PU/GO Requests Change or MPO Himself Causes a Change">
      <bpmn:outgoing>sequenceFlow_0</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:sequenceFlow id="sequenceFlow_0" sourceRef="startEvent_1" targetRef="task_mpoReceivesRequest"/>

    <bpmn:task id="task_mpoReceivesRequest" name="MPO Receives Change Request">
      <bpmn:incoming>sequenceFlow_0</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow_1</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="sequenceFlow_1" sourceRef="task_mpoReceivesRequest" targetRef="exclusiveGateway_reviewChangeRequest"/>

    <bpmn:exclusiveGateway id="exclusiveGateway_reviewChangeRequest">
      <bpmn:incoming>sequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow_2</bpmn:outgoing>
      <bpmn:outgoing>sequenceFlow_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="sequenceFlow_2" sourceRef="exclusiveGateway_reviewChangeRequest" targetRef="task_mpoRejectsChange">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${changeRejected}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:task id="task_mpoRejectsChange" name="MPO Rejects Change Request">
      <bpmn:incoming>sequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow_4</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="sequenceFlow_4" sourceRef="task_mpoRejectsChange" targetRef="endEvent_notificationOfRejection"/>

    <bpmn:endEvent id="endEvent_notificationOfRejection">
      <bpmn:incoming>sequenceFlow_4</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="sequenceFlow_3" sourceRef="exclusiveGateway_reviewChangeRequest" targetRef="task_mpoConfirmsChange">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${changeConfirmed}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:task id="task_mpoConfirmsChange" name="MPO Confirms Change Request">
      <bpmn:incoming>sequenceFlow_3</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow_5</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="sequenceFlow_5" sourceRef="task_mpoConfirmsChange" targetRef="task_mpoPerformsMeasuringPointChange"/>

    <bpmn:task id="task_mpoPerformsMeasuringPointChange" name="MPO Performs Measuring Point Change">
      <bpmn:incoming>sequenceFlow_5</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow_6</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="sequenceFlow_6" sourceRef="task_mpoPerformsMeasuringPointChange" targetRef="exclusiveGateway_notification"/>

    <bpmn:exclusiveGateway id="exclusiveGateway_notification">
      <bpmn:incoming>sequenceFlow_6</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow_7</bpmn:outgoing>
      <bpmn:outgoing>sequenceFlow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="sequenceFlow_7" sourceRef="exclusiveGateway_notification" targetRef="task_mpoReportsImplementation">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${implementationSuccessfull}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:task id="task_mpoReportsImplementation" name="MPO Reports Implementation to SP/PU/GO">
      <bpmn:incoming>sequenceFlow_7</bpmn:incoming>
    </bpmn:task>

    <bpmn:sequenceFlow id="sequenceFlow_8" sourceRef="exclusiveGateway_notification" targetRef="task_mpoNotifiesFailure">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${implementationFailed}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:task id="task_mpoNotifiesFailure" name="MPO Notifies SP/PU/GO About Failure of Changes">
      <bpmn:incoming>sequenceFlow_8</bpmn:incoming>
    </bpmn:task>

  </bpmn:process>

</bpmn:definitions>