<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="Definitions" targetNamespace="http://bpmn.io/schema/bpmn">
   <process id="MailProcessing" name="Mail Processing" isExecutable="true">
     <laneSet>
       <lane id="Lane_1" name="Mail Processing Unit">
         <flowNodeRef>Task_SortMail</flowNodeRef>
         <flowNodeRef>StartEvent_1</flowNodeRef>
       </lane>
       <lane id="Lane_2" name="Registry">
         <flowNodeRef>Task_OpenAndSortMail</flowNodeRef>
         <flowNodeRef>Task_PerformQualityCheck</flowNodeRef>
         <flowNodeRef>InclusiveGateway_1</flowNodeRef>
         <flowNodeRef>EndEvent_1</flowNodeRef>
       </lane>
       <lane id="Lane_3" name="Cashier">
         <flowNodeRef>Task_TakeApplicableFees</flowNodeRef>
       </lane>
     </laneSet>

     <startEvent id="StartEvent_1" name="Mail Collection">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_SortMail"/>

     <task id="Task_SortMail" name="Sort Mail">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_SortMail" targetRef="Task_OpenAndSortMail"/>

     <task id="Task_OpenAndSortMail" name="Open and Sort Mail">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_3" sourceRef="Task_OpenAndSortMail" targetRef="Task_PerformQualityCheck"/>

     <task id="Task_PerformQualityCheck" name="Perform Quality Check">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_4</outgoing>
       <outgoing>SequenceFlow_5</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_4" sourceRef="Task_PerformQualityCheck" targetRef="InclusiveGateway_1">
      <conditionExpression xsi:type="tFormalExpression">${mailCompliant  == true}</conditionExpression>
    </sequenceFlow>

     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_PerformQualityCheck" targetRef="EndEvent_MailRejected">
       <conditionExpression xsi:type="tFormalExpression">${mailCompliant  == false}</conditionExpression>
     </sequenceFlow>

     <inclusiveGateway id="InclusiveGateway_1">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_6</outgoing>
       <outgoing>SequenceFlow_7</outgoing>
     </inclusiveGateway>

     <task id="Task_CaptureMatterDetails" name="Capture Matter Details">
       <incoming>SequenceFlow_6</incoming>
     </task>

     <sequenceFlow id="SequenceFlow_6" sourceRef="InclusiveGateway_1" targetRef="Task_CaptureMatterDetails"/>

     <task id="Task_TakeApplicableFees" name="Take Applicable Fees">
       <incoming>SequenceFlow_7</incoming>
     </task>

     <sequenceFlow id="SequenceFlow_7" sourceRef="InclusiveGateway_1" targetRef="Task_TakeApplicableFees"/>
     
     <endEvent id="EndEvent_MailRejected" name="Mail Rejected">
        <incoming> SequenceFlow_5 </incoming>
    </endEvent>

     <task id="Task_PostReceiptAndDocuments" name="Post Receipt and Documents">
       <incoming>SequenceFlow_8</incoming>
     </task>

     <sequenceFlow id="SequenceFlow_8" sourceRef="Task_TakeApplicableFees" targetRef="Task_PostReceiptAndDocuments"/>

     <endEvent id="EndEvent_1" name="Mail Processing Completed">
       <incoming>SequenceFlow_9</incoming>
     </endEvent>

     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_PostReceiptAndDocuments" targetRef="EndEvent_1"/>
   </process>
</definitions>