<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
                 id="definitions" targetNamespace="http://www.example.com">

  <bpmn:process id="RoomServiceProcess" name="Room Service Process" isExecutable="true">
    <bpmn:startEvent id="StartEvent" name="Guest Calls Room Service">
      <bpmn:outgoing>SequenceFlow1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:sequenceFlow id="SequenceFlow1" sourceRef="StartEvent" targetRef="Task_RoomServiceManager"/>

    <bpmn:task id="Task_RoomServiceManager" name="Room-Service Manager Takes Down Order">
      <bpmn:incoming>SequenceFlow1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow2</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow7</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow2" sourceRef="Task_RoomServiceManager" targetRef="Task_Kitchen"/>

    <bpmn:task id="Task_Kitchen" name="Kitchen Prepares Food">
      <bpmn:incoming>SequenceFlow2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow3</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow3" sourceRef="Task_Kitchen" targetRef="ExclusiveGateway_Preparation"/>

    <bpmn:exclusiveGateway id="ExclusiveGateway_Preparation" name="Is Food Ready?">
      <bpmn:incoming>SequenceFlow3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow4</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow5</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="SequenceFlow4" sourceRef="ExclusiveGateway_Preparation" targetRef="ParallelGateway_Preparation">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${foodReady  == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:task id="Task_Sommelier" name="Sommelier Fetches Wine and Prepares Beverages">
      <bpmn:incoming>SequenceFlow7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow8</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow7" sourceRef="Task_RoomServiceManager" targetRef="Task_Sommelier"/>

    <bpmn:sequenceFlow id="SequenceFlow8" sourceRef="Task_Sommelier" targetRef="ExclusiveGateway_BeveragePreparation">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${beveragesReady  == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:exclusiveGateway id="ExclusiveGateway_BeveragePreparation" name="Is Beverage Ready?">
      <bpmn:incoming>SequenceFlow8</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow9</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_Waiter_ReadiesCart" name="Waiter Readies Cart">
      <bpmn:incoming>SequenceFlow6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow10</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow6" sourceRef="Task_RoomServiceManager" targetRef="Task_Waiter_ReadiesCart"/>

    <bpmn:parallelGateway id="ParallelGateway_Preparation" name="Preparation Complete">
      <bpmn:incoming>SequenceFlow4</bpmn:incoming>
      <bpmn:incoming>SequenceFlow9</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow10</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:sequenceFlow id="SequenceFlow9" sourceRef="ExclusiveGateway_BeveragePreparation" targetRef="ParallelGateway_Preparation"/>

    <bpmn:task id="Task_Waiter_Delivers" name="Waiter Delivers and Debits Guest's Account">
      <bpmn:incoming>SequenceFlow10</bpmn:incoming>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow10" sourceRef="ParallelGateway_Preparation" targetRef="Task_Waiter_Delivers"/>

    <bpmn:endEvent id="EndEvent" name="Delivery Complete">
      <bpmn:incoming>SequenceFlow11</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow11" sourceRef="Task_Waiter_Delivers" targetRef="EndEvent"/>
  </bpmn:process>
</bpmn:definitions>