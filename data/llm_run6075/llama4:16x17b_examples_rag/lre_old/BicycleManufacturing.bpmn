<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
                 id="definitions" targetNamespace="http://www.example.com">

  <bpmn:process id="bicycleManufacturingProcess" name="Bicycle Manufacturing Process" isExecutable="true">
    <bpmn:laneSet>
      <bpmn:lane id="salesDepartmentLane" name="Sales Department">
        <bpmn:flowNodeRef>startEvent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>exclusiveGatewayRejectOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>taskShipBicycle</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="storehouseLane" name="Storehouse">
        <bpmn:flowNodeRef>taskProcessPartList</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="engineeringDepartmentLane" name="Engineering Department">
        <bpmn:flowNodeRef>taskPrepareAssembling</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>taskAssembleBicycle</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="startEvent" name="New Order Received">
      <bpmn:outgoing>sequenceFlow1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:sequenceFlow id="sequenceFlow1" sourceRef="startEvent" targetRef="exclusiveGatewayRejectOrder"/>

    <bpmn:exclusiveGateway id="exclusiveGatewayRejectOrder" name="Reject or Accept Order?">
      <bpmn:incoming>sequenceFlow1</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow2</bpmn:outgoing>
      <bpmn:outgoing>sequenceFlow3</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="sequenceFlow2" name="reject" sourceRef="exclusiveGatewayRejectOrder" targetRef="endEventOrderRejected">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${orderRejected == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:endEvent id="endEventOrderRejected" name="Order Rejected">
      <bpmn:incoming>sequenceFlow2</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="sequenceFlow3" name="accept" sourceRef="exclusiveGatewayRejectOrder" targetRef="taskNotifyStorehouseAndEngineeringDept">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${orderAccepted == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:task id="taskNotifyStorehouseAndEngineeringDept" name="Notify Storehouse and Engineering Department">
      <bpmn:incoming>sequenceFlow3</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow4</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="sequenceFlow4" sourceRef="taskNotifyStorehouseAndEngineeringDept" targetRef="taskProcessPartList"/>

    <bpmn:task id="taskProcessPartList" name="Process Part List">
      <bpmn:incoming>sequenceFlow4</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow5</bpmncoming>
    </bpmn:task>

    <bpmn:sequenceFlow id="sequenceFlow5" sourceRef="taskProcessPartList" targetRef="exclusiveGatewayAllPartsReservedOrBackOrdered"/>

    <bpmn:exclusiveGateway id="exclusiveGatewayAllPartsReservedOrBackOrdered" name="Are All Parts Reserved or Back-Ordered?">
      <bpmn:incoming>sequenceFlow5</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow6</bpmn:outgoing>
      <bpmn:outgoing>sequenceFlow7</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="sequenceFlow6" name="yes" sourceRef="exclusiveGatewayAllPartsReservedOrBackOrdered" targetRef="taskPrepareAssembling">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${allPartsAvailable == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:task id="taskPrepareAssembling" name="Prepare for Assembling">
      <bpmn:incoming>sequenceFlow6</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow8</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="sequenceFlow8" sourceRef="taskPrepareAssembling" targetRef="exclusiveGatewayIsPreparationFinished"/>

    <bpmn:exclusiveGateway id="exclusiveGatewayIsPreparationFinished" name="Is Preparation Finished?">
      <bpmn:incoming>sequenceFlow8</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow9</bpmn:outgoing>
      <bpmn:outgoing>sequenceFlow10</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="sequenceFlow9" name="yes" sourceRef="exclusiveGatewayIsPreparationFinished" targetRef="taskAssembleBicycle">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${preparationComplete == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:task id="taskAssembleBicycle" name="Assemble Bicycle">
      <bpmn:incoming>sequenceFlow9</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow11</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="sequenceFlow11" sourceRef="taskAssembleBicycle" targetRef="taskShipBicycle"/>

    <bpmn:task id="taskShipBicycle" name="Ship Bicycle to Customer">
      <bpmn:incoming>sequenceFlow11</bpmn:incoming>
    </bpmn:task>

  </bpmn:process>

</bpmn:definitions>