<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="Definitions" targetNamespace="http://www.example.com">

   <process id="RepairProcess" name="Computer Repair Process" isExecutable="true">
     <laneSet>
       <lane id="Lane_0" name="">
         <flowNodeRef>StartEvent</flowNodeRef>
         <flowNodeRef>UserTask_CheckDefect</flowNodeRef>
         <flowNodeRef>ExclusiveGateway_CostsAcceptable</flowNodeRef>
         <flowNodeRef>ParallelGateway_RepairActivities</flowNodeRef>
         <flowNodeRef>InclusiveGateway_RepairFinished</flowNodeRef>
         <flowNodeRef>EndEvent_RepairCompleted</flowNodeRef>
       </lane>
     </laneSet>

     <startEvent id="StartEvent" name="Customer brings in defective computer">
       <outgoing>SequenceFlow1</outgoing>
     </startEvent>

     <userTask id="UserTask_CheckDefect" name="Check defect and calculate repair cost">
       <incoming>SequenceFlow1</incoming>
       <outgoing>SequenceFlow2</outgoing>
     </userTask>

     <sequenceFlow id="SequenceFlow1" sourceRef="StartEvent" targetRef="UserTask_CheckDefect"/>

     <exclusiveGateway id="ExclusiveGateway_CostsAcceptable" name="Are costs acceptable?">
       <incoming>SequenceFlow2</incoming>
       <outgoing>SequenceFlow3</outgoing>
       <outgoing>SequenceFlow4</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow2" sourceRef="UserTask_CheckDefect" targetRef="ExclusiveGateway_CostsAcceptable"/>

     <sequenceFlow id="SequenceFlow3" name="yes" sourceRef="ExclusiveGateway_CostsAcceptable" targetRef="ParallelGateway_RepairActivities">
       <conditionExpression xsi:type="tFormalExpression">${costsAcceptable == true}</conditionExpression>
     </sequenceFlow>

     <endEvent id="EndEvent_Unrepaired" name="Computer taken home unrepaired">
       <incoming>SequenceFlow4</incoming>
     </endEvent>

     <sequenceFlow id="SequenceFlow4" name="no" sourceRef="ExclusiveGateway_CostsAcceptable" targetRef="EndEvent_Unrepaired">
       <conditionExpression xsi:type="tFormalExpression">${costsAcceptable == false}</conditionExpression>
     </sequenceFlow>

     <parallelGateway id="ParallelGateway_RepairActivities">
       <incoming>SequenceFlow3</incoming>
       <outgoing>SequenceFlow5</outgoing>
       <outgoing>SequenceFlow6</outgoing>
     </parallelGateway>

     <subProcess id="SubProcess_HardwareRepair" name="Check and repair hardware">
       <incoming>SequenceFlow5</incoming>
       <outgoing>SequenceFlow7</outgoing>

       <task id="Task_CheckHardware" name="Check hardware">
         <outgoing>SequenceFlow11</outgoing>
       </task>

       <exclusiveGateway id="ExclusiveGateway_HardwareError" name="Is there a hardware error?">
         <incoming>SequenceFlow11</incoming>
         <outgoing>SequenceFlow12</outgoing>
         <outgoing>SequenceFlow13</outgoing>
       </exclusiveGateway>

       <sequenceFlow id="SequenceFlow11" sourceRef="Task_CheckHardware" targetRef="ExclusiveGateway_HardwareError"/>

       <sequenceFlow id="SequenceFlow12" name="yes" sourceRef="ExclusiveGateway_HardwareError" targetRef="Task_RepairHardware">
         <conditionExpression xsi:type="tFormalExpression">${hardwareError == true}</conditionExpression>
       </sequenceFlow>

       <task id="Task_RepairHardware" name="Repair hardware">
         <incoming>SequenceFlow12</incoming>
         <outgoing>SequenceFlow7</outgoing>
       </task>

       <sequenceFlow id="SequenceFlow13" name="no" sourceRef="ExclusiveGateway_HardwareError" targetRef="Task_CheckHardware">
         <conditionExpression xsi:type="tFormalExpression">${hardwareError == false}</conditionExpression>
       </sequenceFlow>
     </subProcess>

     <sequenceFlow id="SequenceFlow5" sourceRef="ParallelGateway_RepairActivities" targetRef="SubProcess_HardwareRepair"/>

     <subProcess id="SubProcess_SoftwareRepair" name="Check and configure software">
       <incoming>SequenceFlow6</incoming>
       <outgoing>SequenceFlow8</outgoing>

       <task id="Task_CheckSoftware" name="Check software">
         <outgoing>SequenceFlow14</outgoing>
       </task>

       <exclusiveGateway id="ExclusiveGateway_SoftwareError" name="Is there a software error?">
         <incoming>SequenceFlow14</incoming>
         <outgoing>SequenceFlow15</outgoing>
         <outgoing>SequenceFlow16</outgoing>
       </exclusiveGateway>

       <sequenceFlow id="SequenceFlow14" sourceRef="Task_CheckSoftware" targetRef="ExclusiveGateway_SoftwareError"/>

       <sequenceFlow id="SequenceFlow15" name="yes" sourceRef="ExclusiveGateway_SoftwareError" targetRef="Task_RepairSoftware">
         <conditionExpression xsi:type="tFormalExpression">${softwareError == true}</conditionExpression>
       </sequenceFlow>

       <task id="Task_RepairSoftware" name="Repair software">
         <incoming>SequenceFlow15</incoming>
         <outgoing>SequenceFlow8</outgoing>
       </task>

       <sequenceFlow id="SequenceFlow16" name="no" sourceRef="ExclusiveGateway_SoftwareError" targetRef="Task_CheckSoftware">
         <conditionExpression xsi:type="tFormalExpression">${softwareError == false}</conditionExpression>
       </sequenceFlow>
     </subProcess>

     <sequenceFlow id="SequenceFlow6" sourceRef="ParallelGateway_RepairActivities" targetRef="SubProcess_SoftwareRepair"/>

     <inclusiveGateway id="InclusiveGateway_RepairFinished">
       <incoming>SequenceFlow7</incoming>
       <incoming>SequenceFlow8</incoming>
       <outgoing>SequenceFlow9</outgoing>
     </inclusiveGateway>

     <sequenceFlow id="SequenceFlow7" sourceRef="SubProcess_HardwareRepair" targetRef="InclusiveGateway_RepairFinished"/>
     <sequenceFlow id="SequenceFlow8" sourceRef="SubProcess_SoftwareRepair" targetRef="InclusiveGateway_RepairFinished"/>

     <endEvent id="EndEvent_RepairCompleted" name="Repair finished">
       <incoming>SequenceFlow9</incoming>
     </endEvent>

     <sequenceFlow id="SequenceFlow9" sourceRef="InclusiveGateway_RepairFinished" targetRef="EndEvent_RepairCompleted"/>
   </process>
 </definitions>