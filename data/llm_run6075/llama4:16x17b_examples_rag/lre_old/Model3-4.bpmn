<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
                 id="definitions" targetNamespace="http://www.example.com">

  <bpmn:process id="claimHandlingProcess" name="Claim Handling Process" isExecutable="true">
    <bpmn:startEvent id="startEvent" name="Claim Received">
      <bpmn:outgoing>sequenceFlow1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:sequenceFlow id="sequenceFlow1" sourceRef="startEvent" targetRef="task_SendQuestionnaire"/>

    <bpmn:task id="task_SendQuestionnaire" name="Send Questionnaire to Claimant">
      <bpmn:incoming>sequenceFlow1</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="sequenceFlow2" sourceRef="task_SendQuestionnaire" targetRef="intermediateCatchEvent_WaitForResponse"/>

    <bpmn:intermediateCatchEvent id="intermediateCatchEvent_WaitForResponse" name="Wait for Response">
      <bpmn:incoming>sequenceFlow2</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow3</bpmn:outgoing>
      <bpmn:outgoing>sequenceFlow4</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:sequenceFlow id="sequenceFlow3" sourceRef="intermediateCatchEvent_WaitForResponse" targetRef="endEvent_ClaimHandled">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${responseReceived}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="sequenceFlow4" sourceRef="intermediateCatchEvent_WaitForResponse" targetRef="task_SendReminder">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${daysPassed  == 5}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:task id="task_SendReminder" name="Send Reminder to Claimant">
      <bpmn:incoming>sequenceFlow4</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow5</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="sequenceFlow5" sourceRef="task_SendReminder" targetRef="intermediateCatchEvent_WaitForResponse"/>

    <bpmn:endEvent id="endEvent_ClaimHandled" name="Claim Handled">
      <bpmn:incoming>sequenceFlow3</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>

</bpmn:definitions>