<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" targetNamespace="http://www.example.com">
   <bpmn:collaboration id="Collaboration_1">
     <bpmn:participant id="Participant_1" name="Town Planning Authority" processRef="Process_1"/>
     <bpmn:participant id="Participant_2" name="Committee Members" processRef="Process_2"/>
   </bpmn:collaboration>
   <bpmn:process id="Process_1" isExecutable="true">
     <bpmn:laneSet>
       <bpmn:lane id="Lane_1" name="Coordination Unit">
         <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
         <bpmn:flowNodeRef>Task_1</bpmn:flowNodeRef>
         <bpmn:flowNodeRef>Task_2</bpmn:flowNodeRef>
       </bpmn:lane>
       <bpmn:lane id="Lane_2" name="Support Officer">
         <bpmn:flowNodeRef>Task_3</bpmn:flowNodeRef>
         <bpmn:flowNodeRef>IntermediateThrowEvent_1</bpmn:flowNodeRef>
       </bpmn:lane>
     </bpmn:laneSet>
     <bpmn:startEvent id="StartEvent_1" name="Begin in November">
       <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
       <bpmn:timerEventDefinition/>
     </bpmn:startEvent>
     <bpmn:task id="Task_1" name="Draft a schedule of meetings for the next calendar year and add draft dates to all calendars">
       <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
     </bpmn:task>
     <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>
     <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="Task_3"/>
     <bpmn:task id="Task_3" name="Check the dates and suggest modifications">
       <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
     </bpmn:task>
     <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="Task_3" targetRef="Task_2"/>
     <bpmn:task id="Task_2" name="Recheck all dates and look for potential conflicts">
       <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
     </bpmn:task>
     <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="Task_2" targetRef="IntermediateThrowEvent_1"/>
     <bpmn:intermediateThrowEvent id="IntermediateThrowEvent_1" name="Send the final schedule of meeting dates to all independent Committee Members by email">
       <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
       <bpmn:outgoing>MessageFlow_1</bpmn:outgoing>
       <bpmn:messageEventDefinition/>
     </bpmn:intermediateThrowEvent>
     <bpmn:messageFlow id="MessageFlow_1" sourceRef="IntermediateThrowEvent_1" targetRef="StartEvent_2"/>
   </bpmn:process>
   <bpmn:process id="Process_2" isExecutable="true">
     <bpmn:startEvent id="StartEvent_2" name="Receive Schedule">
       <bpmn:incoming>MessageFlow_1</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
       <bpmn:messageEventDefinition/>
     </bpmn:startEvent>
     <bpmn:task id="Task_4" name="Check their diaries and advise the Coordination Unit of any conflicts">
       <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
     </bpmn:task>
     <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="StartEvent_2" targetRef="Task_4"/>
     <bpmn:intermediateThrowEvent id="IntermediateThrowEvent_2" name="Advise of any conflicts">
       <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
     </bpmn:intermediateThrowEvent>
     <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="Task_4" targetRef="IntermediateThrowEvent_2"/>
   </bpmn:process>
   <bpmndi:BPMNDiagram id="BPMNDiagram_1">
   </bpmndi:BPMNDiagram>
</definitions>