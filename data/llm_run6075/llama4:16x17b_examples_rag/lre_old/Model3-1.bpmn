<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="Definitions" targetNamespace="http://www.example.com">

   <process id="WarrantPossessionProcess" name="Warrant Possession Process" isExecutable="true">
     <startEvent id="StartEvent_1" name="Warrant Possession Request">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_RetrieveSCTTFile"/>

     <task id="Task_RetrieveSCTTFile" name="Retrieve SCTT file">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_RetrieveSCTTFile" targetRef="Task_ForwardSCTWarrantPossession"/>

     <task id="Task_ForwardSCTWarrantPossession" name="Forward SCT Warrant Possession to Queensland Police">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_3" sourceRef="Task_ForwardSCTWarrantPossession" targetRef="IntermediateEvent_1"/>

     <intermediateEvent id="IntermediateEvent_1" name="Receive Report from Police">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_4</outgoing>
     </intermediateEvent>

     <sequenceFlow id="SequenceFlow_4" sourceRef="IntermediateEvent_1" targetRef="Task_RetrieveSCTFile"/>

     <task id="Task_RetrieveSCTFile" name="Retrieve SCT file">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_RetrieveSCTFile" targetRef="Task_AttachNewSCTDocument"/>

     <task id="Task_AttachNewSCTDocument" name="Attach new SCT document">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_AttachNewSCTDocument" targetRef="Task_StoreExpandedSCTPhysicalFile"/>

     <task id="Task_StoreExpandedSCTPhysicalFile" name="Store expanded SCT physical file">
       <incoming>SequenceFlow_6</incoming>
     </task>

     <endEvent id="EndEvent_1" name="Warrant Possession Process Complete">
       <incoming>SequenceFlow_6</incoming>
     </endEvent>

   </process>

</definitions>