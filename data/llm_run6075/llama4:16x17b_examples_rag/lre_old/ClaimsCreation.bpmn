<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
                 id="definitions" targetNamespace="http://www.example.com">

  <bpmn:process id="PoliceReportProcess" name="Police Report Process" isExecutable="true">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_ClaimsHandler" name="Claims Handler">
        <bpmn:flowNodeRef>Task_SearchPoliceReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateFile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CalculateInitialClaimEstimate</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ClaimsManager" name="Claims Manager">
        <bpmn:flowNodeRef>Task_NegotiateSettlement</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent" name="Start Process">
      <bpmn:outgoing>SequenceFlow1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:sequenceFlow id="SequenceFlow1" sourceRef="StartEvent" targetRef="Task_SearchPoliceReport"/>

    <bpmn:task id="Task_SearchPoliceReport" name="Search Police Report within database and put in file with Claim Documentation">
      <bpmn:incoming>SequenceFlow1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow2" sourceRef="Task_SearchPoliceReport" targetRef="Task_CalculateInitialClaimEstimate"/>

    <bpmn:task id="Task_CreateFile" name="Create File">
      <bpmn:incoming>SequenceFlow2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow3</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow3" sourceRef="Task_CreateFile" targetRef="Task_CalculateInitialClaimEstimate"/>

    <bpmn:task id="Task_CalculateInitialClaimEstimate" name="Calculate initial claim estimate">
      <bpmn:incoming>SequenceFlow3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow4</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow4" sourceRef="Task_CalculateInitialClaimEstimate" targetRef="Task_CreateActionPlan"/>

    <bpmn:task id="Task_CreateActionPlan" name="Create Action Plan based on Action Plan Checklist">
      <bpmn:incoming>SequenceFlow4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow5</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow5" sourceRef="Task_CreateActionPlan" targetRef="Task_NegotiateSettlement"/>

    <bpmn:task id="Task_NegotiateSettlement" name="Negotiate settlement on claim estimate">
      <bpmn:incoming>SequenceFlow5</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow6</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow6" sourceRef="Task_NegotiateSettlement" targetRef="EndEvent"/>

    <bpmn:endEvent id="EndEvent" name="Inform claimant of outcome">
      <bpmn:incoming>SequenceFlow6</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>

</bpmn:definitions>