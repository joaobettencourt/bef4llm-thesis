<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
                  id="definitions" targetNamespace="http://www.example.com">

  <bpmn:process id="postFillingProcess" name="Post Filling Process" isExecutable="true">
    <bpmn:startEvent id="startEvent" name="Demand for a Post">
      <bpmn:outgoing>sequenceFlow1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:sequenceFlow id="sequenceFlow1" sourceRef="startEvent" targetRef="task_AdvertisePost"/>

    <bpmn:task id="task_AdvertisePost" name="Advertise Post">
      <bpmn:incoming>sequenceFlow1</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="sequenceFlow2" sourceRef="task_AdvertisePost" targetRef="task_CollectApplications"/>

    <bpmn:task id="task_CollectApplications" name="Collect Applications">
      <bpmn:incoming>sequenceFlow2</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow3</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="sequenceFlow3" sourceRef="task_CollectApplications" targetRef="task_CheckApplications"/>

    <bpmn:task id="task_CheckApplications" name="Check Applications">
      <bpmn:incoming>sequenceFlow3</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow4</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="sequenceFlow4" sourceRef="task_CheckApplications" targetRef="exclusiveGateway_IsPostFilled"/>

    <bpmn:exclusiveGateway id="exclusiveGateway_IsPostFilled">
      <bpmn:incoming>sequenceFlow4</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow5</bpmn:outgoing>
      <bpmn:outgoing>sequenceFlow6</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="sequenceFlow5" sourceRef="exclusiveGateway_IsPostFilled" targetRef="task_FillPost">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${postFilled  == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:task id="task_FillPost" name="Fill Post (conclude contract of employment)">
      <bpmn:incoming>sequenceFlow5</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow7</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="sequenceFlow7" sourceRef="task_FillPost" targetRef="endEvent_PostFilled"/>

    <bpmn:endEvent id="endEvent_PostFilled" name="Post Filled">
      <bpmn:incoming>sequenceFlow7</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="sequenceFlow6" sourceRef="exclusiveGateway_IsPostFilled" targetRef="task_AdvertisePost">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${postFilled  == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

  </bpmn:process>

</bpmn:definitions>