<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="Definitions" targetNamespace="http://www.example.com">

   <bpmn:process id="Pool_0" isExecutable="false">
     <bpmn:laneSet>
       <bpmn:lane id="Lane_0" name="">
         <bpmn:flowNodeRef>StartNoneEvent_0</bpmn:flowNodeRef>
         <bpmn:flowNodeRef>Task_RegisterMeasurement</bpmn:flowNodeRef>
         <bpmn:flowNodeRef>EndNoneEvent_0</bpmn:flowNodeRef>
       </bpmn:lane>
     </bpmn:laneSet>

     <bpmn:startEvent id="StartNoneEvent_0">
       <bpmn:outgoing>SequenceFlow_0</bpmn:outgoing>
     </bpmn:startEvent>

     <bpmn:task id="Task_RegisterMeasurement" name="Registers the measurement at GO">
       <bpmn:incoming>SequenceFlow_0</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
     </bpmn:task>

     <bpmn:sequenceFlow id="SequenceFlow_0" sourceRef="StartNoneEvent_0" targetRef="Task_RegisterMeasurement"/>
     <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="Task_RegisterMeasurement" targetRef="EndNoneEvent_0"/>

     <bpmn:endEvent id="EndNoneEvent_0">
       <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
     </bpmn:endEvent>

   </bpmn:process>

   <bpmn:process id="Pool_1" isExecutable="false">
     <bpmn:laneSet>
       <bpmn:lane id="Lane_1" name="">
         <bpmn:flowNodeRef>StartMessageEvent_0</bpmn:flowNodeRef>
         <bpmn:flowNodeRef>Task_ExamineApplication</bpmn:flowNodeRef>
         <bpmn:flowNodeRef>ExclusiveGateway_0</bpmn:flowNodeRef>
         <bpmn:flowNodeRef>Task_ConfirmApplication</bpmn:flowNodeRef>
         <bpmn:flowNodeRef>Task_RejectApplication</bpmn:flowNodeRef>
         <bpmn:flowNodeRef>Task_AssignMSPN</bpmn:flowNodeRef>
         <bpmn:flowNodeRef>Task_InformsMSP</bpmn:flowNodeRef>
         <bpmn:flowNodeRef>Task_InformsMPO</bpmn:flowNodeRef>
         <bpmn:flowNodeRef>Task_InformsMSPO</bpmn:flowNodeRef>
       </bpmn:lane>
     </bpmn:laneSet>

     <bpmn:startEvent id="StartMessageEvent_0">
       <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
     </bpmn:startEvent>

     <bpmn:task id="Task_ExamineApplication" name="Examines the application of MSPN">
       <bpmn:incoming>SequenceFlow_10</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
     </bpmn:task>

     <exclusiveGateway id="ExclusiveGateway_0">
       <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
       <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_10" sourceRef="StartMessageEvent_0" targetRef="Task_ExamineApplication"/>
     <sequenceFlow id="SequenceFlow_4" sourceRef="Task_ExamineApplication" targetRef="ExclusiveGateway_0"/>

     <task id="Task_RejectApplication" name="Rejects the application of MSPN">
       <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_6" sourceRef="ExclusiveGateway_0" targetRef="Task_RejectApplication"/>
     <sequenceFlow id="SequenceFlow_7" sourceRef="Task_RejectApplication" targetRef="EndNoneEvent_1"/>

     <endEvent id="EndNoneEvent_1">
       <bpmn:incoming>SequenceFlow_7</bpmn:incoming>
     </endEvent>

     <task id="Task_ConfirmApplication" name="Confirms the application of MSPN">
       <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_8</bpmn:outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_5" sourceRef="ExclusiveGateway_0" targetRef="Task_ConfirmApplication"/>
     <sequenceFlow id="SequenceFlow_8" sourceRef="Task_ConfirmApplication" targetRef="Task_AssignMSPN"/>

     <task id="Task_AssignMSPN" name="Assigns the MSPN">
       <bpmn:incoming>SequenceFlow_8</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_9</bpmn:outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_AssignMSPN" targetRef="Task_InformsMSP"/>

     <task id="Task_InformsMSP" name="Informs MSP about the assignment of MSPN">
       <bpmn:incoming>SequenceFlow_9</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_11</bpmn:outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_11" sourceRef="Task_InformsMSP" targetRef="Task_InformsMPO"/>

     <task id="Task_InformsMPO" name="Informs MPO about the assignment of MSPN">
       <bpmn:incoming>SequenceFlow_11</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_12</bpmn:outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_12" sourceRef="Task_InformsMPO" targetRef="Task_InformsMSPO"/>

     <task id="Task_InformsMSPO" name="Informs MSPO about the assignment of MSPN">
       <bpmn:incoming>SequenceFlow_12</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_13</bpmn:outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_13" sourceRef="Task_InformsMSPO" targetRef="EndNoneEvent_2"/>

     <endEvent id="EndNoneEvent_2">
       <bpmn:incoming>SequenceFlow_13</bpmn:incoming>
     </endEvent>

   </bpmn:process>

</definitions>