<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" 
             targetNamespace="http://www.example.com">

  <process id="restaurant_process" isExecutable="true">
    <startEvent id="customer_arrives">
      <outgoing>order_food</outgoing>
    </startEvent>

    <sequenceFlow id="order_food" sourceRef="customer_arrives" targetRef="take_order"/>

    <userTask id="take_order" name="Bestellung aufnehmen">
      <incoming>order_food</incoming>
      <outgoing>enter_order</outgoing>
    </userTask>

    <sequenceFlow id="enter_order" sourceRef="take_order" targetRef="collect_money"/>

    <userTask id="collect_money" name="Geld kassieren">
      <incoming>enter_order</incoming>
      <outgoing>pager_customer</outgoing>
    </userTask>

    <sequenceFlow id="pager_customer" sourceRef="collect_money" targetRef="hand_over_pager"/>

    <userTask id="hand_over_pager" name="Pieper aushändigen">
      <incoming>pager_customer</incoming>
      <outgoing>prepare_food</outgoing>
    </userTask>

    <sequenceFlow id="prepare_food" sourceRef="hand_over_pager" targetRef="cook_food"/>

    <serviceTask id="cook_food" name="Mahlzeit zubereiten">
      <incoming>prepare_food</incoming>
      <outgoing>notify_staff</outgoing>
    </serviceTask>

    <sequenceFlow id="notify_staff" sourceRef="cook_food" targetRef="hand_over_food"/>

    <userTask id="hand_over_food" name="Mahlzeit an Angestellten weitergeben">
      <incoming>notify_staff</incoming>
      <outgoing>deliver_food</outgoing>
    </userTask>

    <sequenceFlow id="deliver_food" sourceRef="hand_over_food" targetRef="end_event"/>

    <endEvent id="end_event">
      <incoming>deliver_food</incoming>
    </endEvent>
  </process>
</definitions>