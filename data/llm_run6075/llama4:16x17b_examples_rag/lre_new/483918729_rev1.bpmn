<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definition" name="Business Process Model" targetNamespace="http://example.com/bpmn">

   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_IdentifyParts"/>

     <task id="Task_IdentifyParts" name="Identify necessary parts">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
       <outgoing>SequenceFlow_3</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_IdentifyParts" targetRef="ExclusiveGateway_CheckAvailability"/>

     <exclusiveGateway id="ExclusiveGateway_CheckAvailability">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_4</outgoing>
       <outgoing>SequenceFlow_5</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_3" sourceRef="Task_IdentifyParts" targetRef="Task_RequestClarification">
       <conditionExpression xsi:type="tFormalExpression">${request.clarificationNeeded}</conditionExpression>
     </sequenceFlow>

     <task id="Task_RequestClarification" name="Request clarification from customer">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_RequestClarification" targetRef="Task_IdentifyParts"/>

     <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_CheckAvailability" targetRef="Task_SupplyParts">
       <conditionExpression xsi:type="tFormalExpression">${partsAvailable}</conditionExpression>
     </sequenceFlow>

     <task id="Task_SupplyParts" name="Supply parts to customer">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_7</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_5" sourceRef="ExclusiveGateway_CheckAvailability" targetRef="Task_RecordPetition"/>

     <task id="Task_RecordPetition" name="Record petition and order parts from Daisuki">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_8</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_8" sourceRef="Task_RecordPetition" targetRef="Task_NotifyCustomer"/>

     <task id="Task_NotifyCustomer" name="Notify customer and collect parts">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_7" sourceRef="Task_SupplyParts" targetRef="EndEvent_1"/>

     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_NotifyCustomer" targetRef="EndEvent_1"/>

     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_7</incoming>
       <incoming>SequenceFlow_9</incoming>
     </endEvent>

   </process>
</definitions>