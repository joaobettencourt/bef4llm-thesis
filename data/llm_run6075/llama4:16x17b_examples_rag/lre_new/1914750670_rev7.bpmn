<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definitions" name="Account Creation Process">

   <process id="Process_1" isExecutable="true">
     <laneSet>
       <lane id="Lane_Customer" name="Bank Customer">
         <flowNodeRef>StartEvent_1</flowNodeRef>
         <flowNodeRef>Task_1_Fill_Personal_Data</flowNodeRef>
         <flowNodeRef>Task_2_Send_Documents</flowNodeRef>
       </lane>
       <lane id="Lane_PostOffice" name="Post Office">
         <flowNodeRef>Task_3_Check_Identity</flowNodeRef>
       </lane>
       <lane id="Lane_Bank" name="Bank">
         <flowNodeRef>Task_4_Check_Customer_Data</flowNodeRef>
         <flowNodeRef>ExclusiveGateway_1_Decision</flowNodeRef>
         <flowNodeRef>Task_5_Mail_Account</flowNodeRef>
         <flowNodeRef>Task_6_Mail_Refusal</flowNodeRef>
         <flowNodeRef>EndEvent_1</flowNodeRef>
       </lane>
     </laneSet>

     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1_Fill_Personal_Data"/>

     <task id="Task_1_Fill_Personal_Data" name="Fill in Personal Data and Generate PDF">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1_Fill_Personal_Data" targetRef="Task_2_Send_Documents"/>

     <task id="Task_2_Send_Documents" name="Send Documents to Post Office">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_3" sourceRef="Task_2_Send_Documents" targetRef="Task_3_Check_Identity"/>

     <task id="Task_3_Check_Identity" name="Post Officer Checks Identity and Mails Request">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_4</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_4" sourceRef="Task_3_Check_Identity" targetRef="Task_4_Check_Customer_Data"/>

     <task id="Task_4_Check_Customer_Data" name="Check Customer Data">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_5</outgoing>
       <outgoing>SequenceFlow_6</outgoing>
     </task>

     <exclusiveGateway id="ExclusiveGateway_1_Decision">
       <incoming>SequenceFlow_5</incoming>
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_7</outgoing>
       <outgoing>SequenceFlow_8</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_5" name="Accept Request"
                  sourceRef="Task_4_Check_Customer_Data" targetRef="ExclusiveGateway_1_Decision"/>

     <sequenceFlow id="SequenceFlow_6" name="Reject Request"
                  sourceRef="Task_4_Check_Customer_Data" targetRef="ExclusiveGateway_1_Decision"/>

     <task id="Task_5_Mail_Account" name="Mail Account Documents">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_7" sourceRef="ExclusiveGateway_1_Decision" targetRef="Task_5_Mail_Account"/>

     <task id="Task_6_Mail_Refusal" name="Mail Letter of Refusal">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_10</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_8" sourceRef="ExclusiveGateway_1_Decision" targetRef="Task_6_Mail_Refusal"/>

     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_9</incoming>
       <incoming>SequenceFlow_10</incoming>
     </endEvent>

     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_5_Mail_Account" targetRef="EndEvent_1"/>
     <sequenceFlow id="SequenceFlow_10" sourceRef="Task_6_Mail_Refusal" targetRef="EndEvent_1"/>

   </process>
</definitions>