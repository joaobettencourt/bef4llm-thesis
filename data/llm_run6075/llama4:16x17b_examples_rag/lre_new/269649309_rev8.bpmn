<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/pec/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/pec/20100524/MODEL BPMN20.xsd"
             id="definition" 
             name="Business Process Model"
             targetNamespace="http://example.com/bpmn">

   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_CheckRetries"/>

     <task id="Task_CheckRetries" name="Check resolution retries conducted">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_CheckRetries" targetRef="ExclusiveGateway_RetryCount"/>

     <exclusiveGateway id="ExclusiveGateway_RetryCount">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_4</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_RetryCount" targetRef="Task_Disassemble">
       <conditionExpression xsi:type="tFormalExpression">${retries > threshold}</conditionExpression>
     </sequenceFlow>

     <task id="Task_Disassemble" name="Return to production area for disassemble">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_Disassemble" targetRef="EndEvent_1"/>

     <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_RetryCount" targetRef="Task_NotifyCustomer">
     </sequenceFlow>

     <task id="Task_NotifyCustomer" name="Try to contact customer by phone">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_6</outgoing>
       <outgoing>SequenceFlow_7</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_NotifyCustomer" targetRef="ExclusiveGateway_CustomerResponse">
     </sequenceFlow>

     <exclusiveGateway id="ExclusiveGateway_CustomerResponse">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_8</outgoing>
       <outgoing>SequenceFlow_9</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_7" sourceRef="Task_NotifyCustomer" targetRef="Task_IncreaseRetryCount">
     </sequenceFlow>

     <task id="Task_IncreaseRetryCount" name="Increase retry count on bag label">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_10</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_10" sourceRef="Task_IncreaseRetryCount" targetRef="EndEvent_1"/>

     <sequenceFlow id="SequenceFlow_8" sourceRef="ExclusiveGateway_CustomerResponse" targetRef="Task_DisassembleCustomerWithdraw">
     </sequenceFlow>

     <task id="Task_DisassembleCustomerWithdraw" name="Return to production area for disassemble (customer withdraw)">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_11</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_11" sourceRef="Task_DisassembleCustomerWithdraw" targetRef="EndEvent_1"/>

     <sequenceFlow id="SequenceFlow_9" sourceRef="ExclusiveGateway_CustomerResponse" targetRef="Task_IncreaseRetryCountOnPromise">
     </sequenceFlow>

     <task id="Task_IncreaseRetryCountOnPromise" name="Increase retry count on bag label (on promise)">
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_12</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_12" sourceRef="Task_IncreaseRetryCountOnPromise" targetRef="EndEvent_1"/>

     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_5</incoming>
       <incoming>SequenceFlow_10</incoming>
       <incoming>SequenceFlow_11</incoming>
       <incoming>SequenceFlow_12</incoming>
     </endEvent>

   </process>
</definitions>