<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ReimbursementProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_0reimbproc">
    <bpmn:participant id="Participant_EricsCompany" name="ERICS Company&#10;Reimbursement Process" processRef="Process_Reimb001"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Reimb001" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_FinanceDept" name="Finance Department">
        <bpmn:flowNodeRef>StartEvent_ReceiveRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateContact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CustomerTypeCheck</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AdminDept" name="Administration">
        <bpmn:flowNodeRef>Task_ChooseBeneficiary</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ThresholdSet</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CustomerService" name="Customer Service">
        <bpmn:flowNodeRef>Task_DeterminePeriod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RefundEndCheck</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_ReceiveRequest" name="Reimbursement Request Received">
      <bpmn:outgoing>SequenceFlow_S1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Create Contact -->
    <bpmn:task id="Task_CreateContact" name="Create Reimbursement Contact">
      <bpmn:incoming>SequenceFlow_S1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_T2</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: Choose Beneficiary -->
    <bpmn:task id="Task_ChooseBeneficiary" name="Choose Beneficiary">
      <bpmn:incoming>SequenceFlow_T2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_T3</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3: Determine Refund Period -->
    <bpmn:task id="Task_DeterminePeriod" name="Determine Refund Period">
      <bpmn:incoming>SequenceFlow_T3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_G1</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway: Customer Type Check -->
    <bpmn:exclusiveGateway id="Gateway_CustomerTypeCheck" name="Customer is Verband?">
      <bpmn:incoming>SequenceFlow_T3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_V1</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_N1</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 4a: Select Group Association (Verband) -->
    <bpmn:task id="Task_SelectGroupAssociation" name="Select Customer Group Association">
      <bpmn:incoming>SequenceFlow_V1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Merge1</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 4b: Manual Selection (Normal) -->
    <bpmn:task id="Task_ManualSelection" name="Select Customers Manually">
      <bpmn:incoming>SequenceFlow_N1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Merge2</bpmn:outgoing>
    </bpmn:task>

    <!-- Merge Gateway -->
    <bpmn:exclusiveGateway id="Gateway_ThresholdSet" name="Merge Selection Paths">
      <bpmn:incoming>SequenceFlow_Merge1</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_Merge2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_T4</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 5: Set Threshold -->
    <bpmn:task id="Task_SetThreshold" name="Set Threshold">
      <bpmn:incoming>SequenceFlow_T4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_P1</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway for Concurrent Activities -->
    <bpmn:parallelGateway id="Parallel_ConcurrentTasks" name="Concurrent Tasks">
      <bpmn:incoming>SequenceFlow_T4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_P2</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_P3</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 6a: Print and Send Credit Note -->
    <bpmn:task id="Task_PrintCreditNote" name="Print &amp; Send Credit Note">
      <bpmn:incoming>SequenceFlow_P2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_E1</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 6b: Calculate and Pay Reimbursement -->
    <bpmn:task id="Task_CalculatePay" name="Calculate &amp; Pay Reimbursement">
      <bpmn:incoming>SequenceFlow_P3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_E2</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway for End Check -->
    <bpmn:exclusiveGateway id="Gateway_RefundEndCheck" name="All Tasks Complete?">
      <bpmn:incoming>SequenceFlow_E1</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_E2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_End</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_ProcessComplete" name="Process Complete">
      <bpmn:incoming>SequenceFlow_End</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_S1" sourceRef="StartEvent_ReceiveRequest" targetRef="Task_CreateContact"/>
    <bpmn:sequenceFlow id="SequenceFlow_T2" sourceRef="Task_CreateContact" targetRef="Gateway_CustomerTypeCheck"/>
    <bpmn:sequenceFlow id="SequenceFlow_V1" name="Verband Customer" sourceRef="Gateway_CustomerTypeCheck" targetRef="Task_SelectGroupAssociation"/>
    <bpmn:sequenceFlow id="SequenceFlow_N1" name="Normal Customer" sourceRef="Gateway_CustomerTypeCheck" targetRef="Task_ManualSelection"/>
    <bpmn:sequenceFlow id="SequenceFlow_Merge1" sourceRef="Task_SelectGroupAssociation" targetRef="Gateway_ThresholdSet"/>
    <bpmn:sequenceFlow id="SequenceFlow_Merge2" sourceRef="Task_ManualSelection" targetRef="Gateway_ThresholdSet"/>
    <bpmn:sequenceFlow id="SequenceFlow_T4" name="Merge Selection Paths" sourceRef="Gateway_ThresholdSet" targetRef="Parallel_ConcurrentTasks"/>
    <bpmn:sequenceFlow id="SequenceFlow_P2" sourceRef="Parallel_ConcurrentTasks" targetRef="Task_PrintCreditNote"/>
    <bpmn:sequenceFlow id="SequenceFlow_P3" sourceRef="Parallel_ConcurrentTasks" targetRef="Task_CalculatePay"/>
    <bpmn:sequenceFlow id="SequenceFlow_E1" name="Notification Sent" sourceRef="Task_PrintCreditNote" targetRef="Gateway_RefundEndCheck"/>
    <bpmn:sequenceFlow id="SequenceFlow_E2" name="Payment Made" sourceRef="Task_CalculatePay" targetRef="Gateway_RefundEndCheck"/>
    <bpmn:sequenceFlow id="SequenceFlow_End" sourceRef="Gateway_RefundEndCheck" targetRef="EndEvent_ProcessComplete"/>

  </bpmn:process>
</bpmn:definitions>