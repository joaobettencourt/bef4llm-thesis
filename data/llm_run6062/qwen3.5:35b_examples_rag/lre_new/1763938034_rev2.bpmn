<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_RewardTraining" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Pool" name="Reward and Training Process" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Management" name="Management">
        <bpmn:flowNodeRef>StartEvent_CheckPerformance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckEmployeePerformance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PerformanceCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SuggestDismissal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SuggestTraining</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SuggestReward</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RewardType</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_MergeAnnounce</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ChooseOtherBenefit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AnnounceEmployeeOfTheMonth</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_HR" name="Human Resources">
        <bpmn:flowNodeRef>Gateway_PerformanceCheck</bpmn:flowNodeRef> <!-- Shared reference for flow crossing -->
          <!-- Correction: Flow nodes are referenced by ID, not duplicated in lane refs. The task IDs below must be unique and assigned to lanes correctly. -->
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_CheckPerformance" name="Check Performance">
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_CheckEmployeePerformance" name="Management checks employee performance">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_PerformanceCheck" name="Performance Threshold">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DismissalPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_TrainingPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RewardPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Dismissal Path -->
    <bpmn:task id="Task_SuggestDismissal" name="Suggest dismissal to HR">
      <bpmn:incoming>SequenceFlow_DismissalPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_HR_Dismiss</bpmn:outgoing>
    </bpmn:task>

    <!-- Training Path -->
    <bpmn:task id="Task_SuggestTraining" name="Suggest training">
      <bpmn:incoming>SequenceFlow_TrainingPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_HR_Train</bpmn:outgoing>
    </bpmn:task>

    <!-- Reward Path -->
    <bpmn:task id="Task_SuggestReward" name="Suggest reward">
      <bpmn:incoming>SequenceFlow_RewardPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RewardTypeCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Reward Type Decision -->
    <bpmn:exclusiveGateway id="Gateway_RewardType" name="Reward Type">
      <bpmn:incoming>SequenceFlow_RewardTypeCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FinancialPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_BenefitPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Financial Reward Path -->
    <bpmn:task id="Task_CalculatePayFinancialReward" name="Calculate and pay financial reward">
      <bpmn:incoming>SequenceFlow_FinancialPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeToAnnounce1</bpmn:outgoing>
    </bpmn:task>

    <!-- Other Benefit Path -->
    <bpmn:task id="Task_ChooseOtherBenefit" name="Choose appropriate benefit">
      <bpmn:incoming>SequenceFlow_BenefitPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeToAnnounce2</bpmn:outgoing>
    </bpmn:task>

    <!-- Merge for Announcement -->
    <bpmn:inclusiveGateway id="InclusiveGateway_MergeAnnounce" name="Merge Reward Paths">
      <bpmn:incoming>SequenceFlow_MergeToAnnounce1</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_MergeToAnnounce2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AnnouncementTask</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Announcement Task -->
    <bpmn:task id="Task_AnnounceEmployeeOfTheMonth" name="Announce employee of the month">
      <bpmn:incoming>SequenceFlow_AnnouncementTask</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndReward</bpmn:outgoing>
    </bpmn:task>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_Dismissed" name="Employee Dismissed">
      <bpmn:incoming>SequenceFlow_HR_Dismiss</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_TrainingDone" name="Training Completed">
      <bpmn:incoming>SequenceFlow_HR_Train</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_Anounced" name="Employee of the Month">
      <bpmn:incoming>SequenceFlow_EndReward</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_CheckPerformance" targetRef="Task_CheckEmployeePerformance"/>
    <bpmn:sequenceFlow id="SequenceFlow_2" name="< 50%" sourceRef="Task_CheckEmployeePerformance" targetRef="Gateway_PerformanceCheck"/>

    <bpmn:sequenceFlow id="SequenceFlow_DismissalPath" name="&lt; 20%" sourceRef="Gateway_PerformanceCheck" targetRef="Task_SuggestDismissal"/>
    <bpmn:task id="Task_HR_DismissEmployee" name="Dismiss employee">
       <bpmn:incoming>SequenceFlow_SuggestDismissalToHR</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_EndDismissed</bpmn:outgoing>
    </bpmn:task>

     <!-- Re-structuring flows for valid logic -->
    
  </bpmn:process>
</bpmn:definitions>