<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                 xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" 
                 xmlns:di="http://www.omg.org/spec/DD/20100524/DI" 
                 xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
                 id="Definitions_ProvisionProcess" targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:collaboration id="Collaboration_ProvisionProc">
    <bpmn:participant id="Participant_ProvisionPool" name="Provision Process" processRef="Process_P12345"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_P12345" isExecutable="false">
    <!-- Lane for Provision Team -->
    <bpmn:laneSet>
      <bpmn:lane id="Lane_ProvisionTeam" name="Provision Team">
        <bpmn:flowNodeRef>StartEvent_ReceiveRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IdentifyParts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_QuestionsCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AskForInformation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateEvent_CustomerResponse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_QuestionsMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckAvailability</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PartsAvailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SupplyItems</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateEvent_ItemsCollected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveFinalPayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Completed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event - Customer Request -->
    <bpmn:startEvent id="StartEvent_ReceiveRequest" name="Customer Request Received">
      <bpmn:outgoing>SequenceFlow_S1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Identify Necessary Parts -->
    <bpmn:task id="Task_IdentifyParts" name="Identify Necessary Parts">
      <bpmn:incoming>SequenceFlow_S1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_G1</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Questions Check -->
    <bpmn:exclusiveGateway id="Gateway_QuestionsCheck" name="Questions about request?">
      <bpmn:incoming>SequenceFlow_G1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_YesInfoNeeded</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoInfoNeeded</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 2: Ask for More Information -->
    <bpmn:task id="Task_AskForInformation" name="Ask Customer for More Information">
      <bpmn:incoming>SequenceFlow_YesInfoNeeded</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InfoReceived</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Catch Event - Wait for Customer Response -->
    <bpmn:intermediateCatchEvent id="IntermediateEvent_CustomerResponse" name="Customer Information Received">
      <bpmn:incoming>SequenceFlow_InfoReceived</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_G2CheckAvail</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Gateway 1 Merge Point -->
    <bpmn:exclusiveGateway id="Gateway_QuestionsMerge" name="">
      <bpmn:incoming>SequenceFlow_NoInfoNeeded</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_G2CheckAvail</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckAvailability</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 3: Check Parts Availability -->
    <bpmn:task id="Task_CheckAvailability" name="Check if All Parts Available">
      <bpmn:incoming>SequenceFlow_CheckAvailability</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AvailabilityResult</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2: Parts Available Check -->
    <bpmn:exclusiveGateway id="Gateway_PartsAvailable" name="All parts available?">
      <bpmn:incoming>SequenceFlow_AvailabilityResult</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_YesPartsAvail</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoPartsAvail</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 4a: Supply to Customer -->
    <bpmn:task id="Task_SupplyItems" name="Supply Items to Customer">
      <bpmn:incoming>SequenceFlow_YesPartsAvail</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitRecollection</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Catch Event - Wait for Recollection -->
    <bpmn:intermediateCatchEvent id="IntermediateEvent_ItemsCollected" name="Items Collected by Customer">
      <bpmn:incoming>SequenceFlow_WaitRecollection</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReceivePayment</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task 4b: Receive Final Payment -->
    <bpmn:task id="Task_ReceiveFinalPayment" name="Receive Final Payment">
      <bpmn:incoming>SequenceFlow_ReceivePayment</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndProcess</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 5a: Record Petition -->
    <bpmn:task id="Task_RecordPetition" name="Record Petition">
      <bpmn:incoming>SequenceFlow_NoPartsAvail</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OrderDaisuki</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 5b: Order from Daisuki -->
    <bpmn:task id="Task_OrderFromDaisuki" name="Order Parts from Daisuki">
      <bpmn:incoming>SequenceFlow_OrderDaisuki</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitCollection</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Catch Event - Wait for Parts Collection -->
    <bpmn:intermediateCatchEvent id="IntermediateEvent_PartsCollected" name="Parts Collected">
      <bpmn:incoming>SequenceFlow_WaitCollection</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ContactCustomer</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task 5c: Contact Customer -->
    <bpmn:task id="Task_ContactCustomer" name="Contact Customer">
      <bpmn:incoming>SequenceFlow_ContactCustomer</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeToEnd</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Completed" name="Process Completed">
      <bpmn:incoming>SequenceFlow_EndProcess</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_MergeToEnd</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>