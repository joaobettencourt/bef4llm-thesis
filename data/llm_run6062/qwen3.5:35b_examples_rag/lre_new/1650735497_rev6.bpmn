<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_BankVerification" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_0bankverify">
    <bpmn:participant id="Participant_ClientPool" name="PayPal Client" processRef="Process_C12345"/>
    <bpmn:participant id="Participant_SystemPool" name="PayPal System" processRef="Process_S67890"/>
    
    <!-- Message Flows between participants -->
    <bpmn:messageFlow id="MessageFlow_SubmitDetails" sourceRef="IntermediateClient_Submit" targetRef="StartEvent_System_1">
      <bpmn:text>Submit Bank Details</bpmn:text>
    </bpmn:messageFlow>
    
    <bpmn:messageFlow id="MessageFlow_Deposits" sourceRef="IntermediateSystem_SendDeposits" targetRef="Participant_ClientPool">
      <bpmn:text>Send Deposit Information to Client Bank</bpmn:text>
    </bpmn:messageFlow>
    
    <bpmn:messageFlow id="MessageFlow_Notification" sourceRef="IntermediateSystem_SendNotification" targetRef="UserTask_WaitNotification">
      <bpmn:text>Notify Client to Check Account</bpmn:text>
    </bpmn:messageFlow>
    
    <bpmn:messageFlow id="MessageFlow_VerificationData" sourceRef="IntermediateClient_SendVerification" targetRef="StartEvent_System_ReceiveVerification">
      <bpmn:text>Send Verification Data to System</bpmn:text>
    </bpmn:messageFlow>
  </bpmn:collaboration>

  <!-- PayPal Client Process -->
  <bpmn:process id="Process_C12345" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Client_1" name="Select Bank Account Payment Option">
      <bpmn:outgoing>SequenceFlow_S001</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="UserTask_EnterDetails" name="Enter Bank Details (First Name, Bank Name, Account Type, BSB, Account Number)">
      <bpmn:incoming>SequenceFlow_S001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_S002</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="UserTask_ClickContinue" name="Click Continue">
      <bpmn:incoming>SequenceFlow_S002</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_S003</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:intermediateThrowEvent id="IntermediateClient_Submit" name="Submit Bank Details to System">
      <bpmn:messageEventDefinition messageRef="Message_BankDetails"/>
      <bpmn:incoming>SequenceFlow_S003</bpmn:incoming>
    </bpmn:intermediateThrowEvent>

    <bpmn:userTask id="UserTask_WaitNotification" name="Wait for Notification (3-5 Working Days)">
      <bpmn:incoming>MessageFlow_Notification</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_S005</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="UserTask_LogIn" name="Log into PayPal Account">
      <bpmn:incoming>MessageFlow_Notification</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_S006</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="UserTask_EnterDepositAmounts" name="Enter Amounts from Two Deposits">
      <bpmn:incoming>SequenceFlow_S005</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_S007</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="UserTask_ClickVerify" name="Click Verify">
      <bpmn:incoming>SequenceFlow_S006</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_S008</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:intermediateThrowEvent id="IntermediateClient_SendVerification" name="Send Verification Data to System">
      <bpmn:messageEventDefinition messageRef="Message_VerificationData"/>
      <bpmn:incoming>SequenceFlow_S007</bpmn:incoming>
    </bpmn:intermediateThrowEvent>

  </bpmn:process>

  <!-- PayPal System Process -->
  <bpmn:process id="Process_S67890" isExecutable="false">
    <bpmn:startEvent id="StartEvent_System_1" name="Receive Bank Account Addition Request">
      <bpmn:messageEventDefinition messageRef="Message_BankDetails"/>
      <bpmn:outgoing>SequenceFlow_S101</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="UserTask_System_ProcessData" name="Process Submitted Bank Details">
      <bpmn:incoming>SequenceFlow_S101</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_S102</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="UserTask_System_MakeDeposits" name="Make Two Random Deposits to Client Bank Account">
      <bpmn:incoming>SequenceFlow_S102</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_S103</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:intermediateThrowEvent id="IntermediateSystem_SendDeposits" name="Send Deposit Information to Client Bank">
      <bpmn:messageEventDefinition messageRef="Message_DepositInfo"/>
      <bpmn:incoming>SequenceFlow_S103</bpmn:incoming>
    </bpmn:intermediateThrowEvent>

    <bpmn:userTask id="UserTask_System_WaitNotification" name="Wait 3-5 Working Days">
      <bpmn:incoming>TimerStart_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_S202</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:intermediateThrowEvent id="IntermediateSystem_SendNotification" name="Notify Client to Check Bank Account">
      <bpmn:messageEventDefinition messageRef="Message_Notification"/>
      <bpmn:incoming>SequenceFlow_S201</bpmn:incoming>
    </bpmn:intermediateThrowEvent>

    <bpmn:startEvent id="StartEvent_System_ReceiveVerification" name="Receive Verification Data">
      <bpmn:messageEventDefinition messageRef="Message_VerificationData"/>
      <bpmn:outgoing>SequenceFlow_S301</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="UserTask_System_CheckValues" name="Check Values Against Client Input">
      <bpmn:incoming>SequenceFlow_S301</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Gateway_Validation</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="ExclusiveGateway_Validate" name="Values Match?">
      <bpmn:incoming>SequenceFlow_Gateway_Validation</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MatchYes</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_MatchNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="UserTask_System_ConfirmLink" name="Confirm Bank Account Linked to PayPal">
      <bpmn:incoming>SequenceFlow_MatchYes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndConfirmed</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndEvent_Confirmed" name="Bank Account Confirmed">
      <bpmn:incoming>SequenceFlow_EndConfirmed</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:userTask id="UserTask_System_RemoveAccount" name="Remove Bank Account from PayPal System (Not Confirmed)">
      <bpmn:incoming>SequenceFlow_MatchNo</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndRemoved</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndEvent_Removed" name="Bank Account Removed (Not Confirmed)">
      <bpmn:incoming>SequenceFlow_EndRemoved</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>

  <!-- Messages -->
  <bpmn:message id="Message_BankDetails" name="Bank Details Submission"/>
  <bpmn:message id="Message_DepositInfo" name="Deposit Information to Client Bank"/>
  <bpmn:message id="Message_Notification" name="Notification to Check Account"/>
  <bpmn:message id="Message_VerificationData" name="Verification Data from Client"/>

</bpmn:definitions>