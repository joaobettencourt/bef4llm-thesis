<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_RegistrationProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_RegProc">
    <bpmn:participant id="Participant_RegPool" name="Customer Registration Process" processRef="Process_Reg1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Reg1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_SystemOps" name="System Operations">
        <bpmn:flowNodeRef>StartEvent_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_SplitChecks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckAvailability</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckCreditRating</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_MergeChecks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_CreditDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Unsuccessful</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateInterimRecord</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_SubprocessSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DeviceProvision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegisterAccountISP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_MergeSubprocesses</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WelcomePackageSent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Success</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_0" name="Visitor Submits Registration Form">
      <bpmn:outgoing>SequenceFlow_SplitChecks</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Parallel Gateway for Initial Checks -->
    <bpmn:parallelGateway id="ParallelGateway_SplitChecks" name="Check Availability &amp; Credit">
      <bpmn:incoming>SequenceFlow_SplitChecks</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckAvailability</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CheckCreditRating</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Tasks for Checks -->
    <bpmn:task id="Task_CheckAvailability" name="Check Product Availability">
      <bpmn:incoming>SequenceFlow_CheckAvailability</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeChecks1</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_CheckCreditRating" name="Check Credit Rating (Schufa)">
      <bpmn:incoming>SequenceFlow_CheckCreditRating</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeChecks2</bpmn:outgoing>
    </bpmn:task>

    <!-- Merge Checks -->
    <bpmn:parallelGateway id="ParallelGateway_MergeChecks" name="Merge Check Results">
      <bpmn:incoming>SequenceFlow_MergeChecks1</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_MergeChecks2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CreditDecision</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Decision Gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_CreditDecision" name="Credit Rating &gt; 9000?">
      <bpmn:incoming>SequenceFlow_CreditDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_UnsuccessfulPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SuccessfulPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event for Unsuccessful -->
    <bpmn:endEvent id="EndEvent_Unsuccessful" name="Registration Unsuccessful">
      <bpmn:incoming>SequenceFlow_UnsuccessfulPath</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task Create Record (Successful Path) -->
    <bpmn:task id="Task_CreateInterimRecord" name="Create Interim Customer Dataset">
      <bpmn:incoming>SequenceFlow_SuccessfulPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SubprocessSplit</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway for Sub-processes -->
    <bpmn:parallelGateway id="ParallelGateway_SubprocessSplit" name="Start Sub-processes">
      <bpmn:incoming>SequenceFlow_SubprocessSplit</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DeviceProvisionPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RegisterAccountPath</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Sub-process Tasks -->
    <bpmn:task id="Task_DeviceProvision" name="Device Provision">
      <bpmn:incoming>SequenceFlow_DeviceProvisionPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeSubprocessesIn1</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_RegisterAccountISP" name="Register Customer Account at ISP Nodes">
      <bpmn:incoming>SequenceFlow_RegisterAccountPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeSubprocessesIn2</bpmn:outgoing>
    </bpmn:task>

    <!-- Merge Sub-processes -->
    <bpmn:parallelGateway id="ParallelGateway_MergeSubprocesses" name="Merge Sub-process Completion">
      <bpmn:incoming>SequenceFlow_MergeSubprocessesIn1</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_MergeSubprocessesIn2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WelcomePackagePath</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Final Task -->
    <bpmn:task id="Task_WelcomePackageSent" name="Create &amp; Send Welcome Package">
      <bpmn:incoming>SequenceFlow_WelcomePackagePath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FinalSuccess</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event for Success -->
    <bpmn:endEvent id="EndEvent_Success" name="Registration Completed Successfully">
      <bpmn:incoming>SequenceFlow_FinalSuccess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows with Conditions where applicable -->
    <bpmn:sequenceFlow id="SequenceFlow_SplitChecks" sourceRef="StartEvent_0" targetRef="ParallelGateway_SplitChecks"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_CheckAvailability" name="Check Availability" sourceRef="ParallelGateway_SplitChecks" targetRef="Task_CheckAvailability"/>
    <bpmn:sequenceFlow id="SequenceFlow_CheckCreditRating" name="Check Credit Rating" sourceRef="ParallelGateway_SplitChecks" targetRef="Task_CheckCreditRating"/>

    <bpmn:sequenceFlow id="SequenceFlow_MergeChecks1" sourceRef="Task_CheckAvailability" targetRef="ParallelGateway_MergeChecks"/>
    <bpmn:sequenceFlow id="SequenceFlow_CreditDecision" name="Merge Check Results" sourceRef="ParallelGateway_MergeChecks" targetRef="ExclusiveGateway_CreditDecision"/>

    <!-- Condition on Unsuccessful Path -->
    <bpmn:sequenceFlow id="SequenceFlow_UnsuccessfulPath" name="Credit &gt; 9000" conditionExpression="${creditRating > 9000}" sourceRef="ExclusiveGateway_CreditDecision" targetRef="EndEvent_Unsuccessful"/>

    <!-- Default/Successful Path -->
    <bpmn:sequenceFlow id="SequenceFlow_SuccessfulPath" name="Credit &lt;= 9000" conditionExpression="${creditRating <= 9000}" sourceRef="ExclusiveGateway_CreditDecision" targetRef="Task_CreateInterimRecord"/>

    <bpmn:sequenceFlow id="SequenceFlow_SubprocessSplit" sourceRef="Task_CreateInterimRecord" targetRef="ParallelGateway_SubprocessSplit"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_DeviceProvisionPath" name="Device Provisioning" sourceRef="ParallelGateway_SubprocessSplit" targetRef="Task_DeviceProvision"/>
    <bpmn:sequenceFlow id="SequenceFlow_RegisterAccountPath" name="ISP Registration" sourceRef="ParallelGateway_SubprocessSplit" targetRef="Task_RegisterAccountISP"/>

    <bpmn:sequenceFlow id="SequenceFlow_MergeSubprocessesIn1" sourceRef="Task_DeviceProvision" targetRef="ParallelGateway_MergeSubprocesses"/>
    <bpmn:sequenceFlow id="SequenceFlow_WelcomePackagePath" name="All Sub-processes Done" sourceRef="ParallelGateway_MergeSubprocesses" targetRef="Task_WelcomePackageSent"/>

    <bpmn:sequenceFlow id="SequenceFlow_FinalSuccess" sourceRef="Task_WelcomePackageSent" targetRef="EndEvent_Success"/>
  </bpmn:process>
</bpmn:definitions>