<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_CreditApproval" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_0geryc1">
    <bpmn:participant id="Participant_OrderPool" name="Credit Company Process" processRef="Process_O12345"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_O12345" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="Start_ReceiveInfo" name="Credit Information Received">
      <bpmn:outgoing>SequenceFlow_S1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Gateway 1: Amount Check -->
    <bpmn:exclusiveGateway id="Gateway_AmountCheck" name="Amount &gt; $1M?">
      <bpmn:incoming>SequenceFlow_S1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_YesApproval</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoAssessRisk</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 1: Assess Risk -->
    <bpmn:task id="Task_AssessRisk" name="Assess Credit Risk">
      <bpmn:incoming>SequenceFlow_NoAssessRisk</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_HighRiskCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2: Risk Check -->
    <bpmn:exclusiveGateway id="Gateway_RiskCheck" name="High Risk?">
      <bpmn:incoming>SequenceFlow_HighRiskCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RequestApprovalFromRisk</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_AcceptLowRisk</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 2: Request Approval -->
    <bpmn:task id="Task_RequestApproval" name="Request Credit Approval">
      <bpmn:incoming>SequenceFlow_YesApproval</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_RequestApprovalFromRisk</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ApprovalResultCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 3: Approval Result -->
    <bpmn:exclusiveGateway id="Gateway_ApprovalResult" name="Approved?">
      <bpmn:incoming>SequenceFlow_ApprovalResultCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AcceptedFromApproval</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RejectedFromApproval</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event 1: Direct Acceptance (Low Risk) -->
    <bpmn:endEvent id="End_DirectAccept" name="Credit Accepted">
      <bpmn:incoming>SequenceFlow_AcceptLowRisk</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task 3: Send Acceptance Email -->
    <bpmn:task id="Task_SendEmailAccepted" name="Send Acceptance Email">
      <bpmn:incoming>SequenceFlow_AcceptedFromApproval</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeAcceptEnd</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 4: Send Rejection Email -->
    <bpmn:task id="Task_SendEmailRejected" name="Send Rejection Email">
      <bpmn:incoming>SequenceFlow_RejectedFromApproval</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeRejectEnd</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 2: Final Acceptance -->
    <bpmn:endEvent id="End_FinalAccept" name="Credit Accepted">
      <bpmn:incoming>SequenceFlow_MergeAcceptEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- End Event 3: Final Rejection -->
    <bpmn:endEvent id="End_FinalReject" name="Credit Rejected">
      <bpmn:incoming>SequenceFlow_MergeRejectEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_S1" sourceRef="Start_ReceiveInfo" targetRef="Gateway_AmountCheck"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_YesApproval" name="Amount &gt; $1M" sourceRef="Gateway_AmountCheck" targetRef="Task_RequestApproval"/>
    <bpmn:sequenceFlow id="SequenceFlow_NoAssessRisk" name="Amount ≤ $1M" sourceRef="Gateway_AmountCheck" targetRef="Task_AssessRisk"/>

    <bpmn:sequenceFlow id="SequenceFlow_HighRiskCheck" name="High Risk" sourceRef="Task_AssessRisk" targetRef="Gateway_RiskCheck"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_RequestApprovalFromRisk" name="Yes - High Risk" sourceRef="Gateway_RiskCheck" targetRef="Task_RequestApproval"/>
    <bpmn:sequenceFlow id="SequenceFlow_AcceptLowRisk" name="No - Low Risk" sourceRef="Gateway_RiskCheck" targetRef="End_DirectAccept"/>

    <bpmn:sequenceFlow id="SequenceFlow_ApprovalResultCheck" sourceRef="Task_RequestApproval" targetRef="Gateway_ApprovalResult"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_AcceptedFromApproval" name="Approved" sourceRef="Gateway_ApprovalResult" targetRef="Task_SendEmailAccepted"/>
    <bpmn:sequenceFlow id="SequenceFlow_RejectedFromApproval" name="Rejected" sourceRef="Gateway_ApprovalResult" targetRef="Task_SendEmailRejected"/>

    <bpmn:sequenceFlow id="SequenceFlow_MergeAcceptEnd" sourceRef="Task_SendEmailAccepted" targetRef="End_FinalAccept"/>
    <bpmn:sequenceFlow id="SequenceFlow_MergeRejectEnd" sourceRef="Task_SendEmailRejected" targetRef="End_FinalReject"/>

  </bpmn:process>
</bpmn:definitions>