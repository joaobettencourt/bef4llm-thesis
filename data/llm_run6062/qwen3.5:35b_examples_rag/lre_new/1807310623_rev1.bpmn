<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_PurchaseOrderProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_0PurchaseProc">
    <bpmn:participant id="Participant_ACMEInc" name="ACME Inc." processRef="Process_Purchase1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Purchase1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_FinancialDept" name="Financial Department">
        <bpmn:flowNodeRef>StartEvent_0InvoiceReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_0CheckInvoice</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ReceivingDept" name="Receiving Department">
        <bpmn:flowNodeRef>Gateway_AmountCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_0RegisterSAPERION</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_DeptHead" name="Department Head">
        <bpmn:flowNodeRef>Task_0ApproveInvoice</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_0InvoiceReceived" name="Purchase Invoice Received">
      <bpmn:outgoing>SequenceFlow_S1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task Financial Dept - Check invoice -->
    <bpmn:task id="Task_0CheckInvoice" name="Check Purchase Invoice">
      <bpmn:incoming>SequenceFlow_S1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_T2</bpmn:outgoing>
    </bpmn:task>

    <!-- Task Receiving Dept - Register in SAPERION -->
    <bpmn:task id="Task_0RegisterSAPERION" name="Check Invoice &amp; Register in SAPERION">
      <bpmn:incoming>SequenceFlow_T2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_G1</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway - Amount Check -->
    <bpmn:exclusiveGateway id="Gateway_AmountCheck" name="Amount &gt; $500?">
      <bpmn:incoming>SequenceFlow_G1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Over500</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_Under500</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task Dept Head - Approve Invoice -->
    <bpmn:task id="Task_0ApproveInvoice" name="Approve Invoice in SAPERION">
      <bpmn:incoming>SequenceFlow_Over500</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Merge1</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_PaymentDone" name="Payment Processed">
       <bpmn:incoming>SequenceFlow_Merge1</bpmn:incoming> 
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_S1" sourceRef="StartEvent_0InvoiceReceived" targetRef="Task_0CheckInvoice"/>
    <bpmn:sequenceFlow id="SequenceFlow_T2" name="Send to Receiving Dept" sourceRef="Task_0CheckInvoice" targetRef="Task_0RegisterSAPERION"/>
    <bpmn:sequenceFlow id="SequenceFlow_G1" sourceRef="Task_0RegisterSAPERION" targetRef="Gateway_AmountCheck"/>
    <bpmn:sequenceFlow id="SequenceFlow_Over500" name="Amount &gt; $500" sourceRef="Gateway_AmountCheck" targetRef="Task_0ApproveInvoice"/>
    <bpmn:sequenceFlow id="SequenceFlow_Under500" name="Amount &lt;= $500" sourceRef="Gateway_AmountCheck" targetRef="EndEvent_PaymentDone"/>
    <bpmn:sequenceFlow id="SequenceFlow_Merge1" sourceRef="Task_0ApproveInvoice" targetRef="EndEvent_PaymentDone"/>

  </bpmn:process>
</bpmn:definitions>