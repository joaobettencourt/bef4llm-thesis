<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_WarrantPossessionProcess" targetNamespace="http://example.com/bpmn">
  <bpmn:collaboration id="Collaboration_WarrantRequest">
    <bpmn:participant id="Participant_SmallClaimsRegistry" name="Small Claims Registry Operations" processRef="Process_WarrantPossession"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_WarrantPossession" isExecutable="false">
    <bpmn:startEvent id="StartEvent_RequestReceived" name="Warrant Possession Request Received">
      <bpmn:outgoing>SequenceFlow_001</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_BackOfficeReceiveRequest" name="Client Service Back Office receives request">
      <bpmn:incoming>SequenceFlow_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_002</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_001" sourceRef="StartEvent_RequestReceived" targetRef="Task_BackOfficeReceiveRequest"/>

    <bpmn:task id="Task_RetrieveSCTTFile" name="Retrieve SCTT file">
      <bpmn:incoming>SequenceFlow_002</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_003</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_002" sourceRef="Task_BackOfficeReceiveRequest" targetRef="Task_RetrieveSCTTFile"/>

    <bpmn:task id="Task_ForwardToPolice" name="Forward SCT Warrant Possession to Queensland Police">
      <bpmn:incoming>SequenceFlow_003</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_004</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_003" sourceRef="Task_RetrieveSCTTFile" targetRef="Task_ForwardToPolice"/>

    <bpmn:intermediateCatchEvent id="IntermediateEvent_WaitingForReport">
      <bpmn:incoming>SequenceFlow_004</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_005</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:sequenceFlow id="SequenceFlow_004" sourceRef="Task_ForwardToPolice" targetRef="IntermediateEvent_WaitingForReport"/>

    <bpmn:task id="Task_StoreSCTTFile" name="Store SCTT physical file awaiting police report">
      <bpmn:incoming>SequenceFlow_005</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_006</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_005" sourceRef="IntermediateEvent_WaitingForReport" targetRef="Task_StoreSCTTFile"/>

    <bpmn:intermediateCatchEvent id="IntermediateEvent_ReportReceived">
      <bpmn:incoming>SequenceFlow_006</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_007</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:sequenceFlow id="SequenceFlow_006" sourceRef="Task_StoreSCTTFile" targetRef="IntermediateEvent_ReportReceived"/>

    <bpmn:task id="Task_RetrieveSCTFile" name="Retrieve respective SCT file">
      <bpmn:incoming>SequenceFlow_007</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_008</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_007" sourceRef="IntermediateEvent_ReportReceived" targetRef="Task_RetrieveSCTFile"/>

    <bpmn:task id="Task_AttachNewDocument" name="Attach new SCT document">
      <bpmn:incoming>SequenceFlow_008</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_009</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_008" sourceRef="Task_RetrieveSCTFile" targetRef="Task_AttachNewDocument"/>

    <bpmn:task id="Task_StoreExpandedFile" name="Store expanded SCT physical file">
      <bpmn:incoming>SequenceFlow_009</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_010</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_009" sourceRef="Task_AttachNewDocument" targetRef="Task_StoreExpandedFile"/>

    <bpmn:endEvent id="EndEvent_FileHandedOff" name="MC internal staff receives file (out of scope)">
      <bpmn:incoming>SequenceFlow_010</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow_010" sourceRef="Task_StoreExpandedFile" targetRef="EndEvent_FileHandedOff"/>
  </bpmn:process>
</bpmn:definitions>