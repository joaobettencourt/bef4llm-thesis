<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_DeviceTakeoverProcess" targetNamespace="http://example.com/bpmn">
  <bpmn:collaboration id="Collaboration_DeviceTakeover">
    <bpmn:participant id="Participant_MPON" name="MPON" processRef="Pool_MPON"/>
    <bpmn:participant id="Participant_MPOO" name="MPOO" processRef="Pool_MPOO"/>
    
    <!-- Message flows between participants -->
    <bpmn:messageFlow id="MessageFlow_RequestBid" sourceRef="Task_MPON_RequestTakeoverBid" targetRef="StartEvent_MPOO_ReceiveRequest"/>
    <bpmn:messageFlow id="MessageFlow_TenderSent" sourceRef="IntermediateThrowEvent_MPOO_SendTender" targetRef="CatchEvent_MPON_ReceivingTender"/>
    <bpmn:messageFlow id="MessageFlow_OrderPlaced" sourceRef="Task_MPON_PlaceOrder" targetRef="StartEvent_MPOO_ReceiveOrder"/>
    <bpmn:messageFlow id="MessageFlow_ConfirmationSent" sourceRef="IntermediateThrowEvent_MPOO_SendConfirmation" targetRef="CatchEvent_MPON_ReceivingConfirmation"/>
  </bpmn:collaboration>

  <!-- MPON Process -->
  <bpmn:process id="Pool_MPON" isExecutable="false">
    <bpmn:startEvent id="StartNoneEvent_MPON_0" name="Request device takeover bid">
      <bpmn:outgoing>SequenceFlow_MPON_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_MPON_RequestTakeoverBid" name="Request device takeover bid of MPOO">
      <bpmn:incoming>SequenceFlow_MPON_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MPON_2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:intermediateCatchEvent id="CatchEvent_MPON_ReceivingTender" name="Receive tender for equipment takeover">
      <bpmn:incoming>MessageFlow_TenderSent</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MPON_3</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:task id="Task_MPON_PlaceOrder" name="Place order at MPOO">
      <bpmn:incoming>SequenceFlow_MPON_3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MPON_4</bpmn:outgoing>
    </bpmn:task>

    <bpmn:intermediateCatchEvent id="CatchEvent_MPON_ReceivingConfirmation" name="Receive order confirmation and master data">
      <bpmn:incoming>MessageFlow_ConfirmationSent</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MPON_5</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:endEvent id="EndNoneEvent_MPON" name="Order confirmed">
      <bpmn:incoming>SequenceFlow_MPON_5</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence flows within MPON process -->
    <bpmn:sequenceFlow id="SequenceFlow_MPON_1" sourceRef="StartNoneEvent_MPON_0" targetRef="Task_MPON_RequestTakeoverBid"/>
    <bpmn:sequenceFlow id="SequenceFlow_MPON_2" sourceRef="Task_MPON_RequestTakeoverBid" targetRef="CatchEvent_MPON_ReceivingTender"/>
    <bpmn:sequenceFlow id="SequenceFlow_MPON_3" sourceRef="CatchEvent_MPON_ReceivingTender" targetRef="Task_MPON_PlaceOrder"/>
    <bpmn:sequenceFlow id="SequenceFlow_MPON_4" sourceRef="Task_MPON_PlaceOrder" targetRef="CatchEvent_MPON_ReceivingConfirmation"/>
    <bpmn:sequenceFlow id="SequenceFlow_MPON_5" sourceRef="CatchEvent_MPON_ReceivingConfirmation" targetRef="EndNoneEvent_MPON"/>

  </bpmn:process>

  <!-- MPOO Process -->
  <bpmn:process id="Pool_MPOO" isExecutable="false">
    <bpmn:startEvent id="StartMessageEvent_MPOO_ReceiveRequest" name="Receive device takeover bid request">
      <bpmn:incoming>MessageFlow_RequestBid</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MPOO_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_MPOO_ProcessRequest" name="Process takeover bid request">
      <bpmn:incoming>SequenceFlow_MPOO_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MPOO_2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:startEvent id="StartMessageEvent_MPOO_ReceiveOrder" name="Receive order from MPON">
      <bpmn:incoming>MessageFlow_OrderPlaced</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MPOO_3</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_MPOO_ProcessOrder" name="Process order">
      <bpmn:incoming>SequenceFlow_MPOO_3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MPOO_4</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndNoneEvent_MPOO" name="Order confirmed and master data sent">
      <bpmn:incoming>SequenceFlow_MPOO_5</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Intermediate throw events for sending messages -->
    <bpmn:intermediateThrowEvent id="IntermediateThrowEvent_MPOO_SendTender" name="Send tender">
      <bpmn:incoming>SequenceFlow_MPOO_2</bpmn:incoming>
      <bpmn:outgoing>MessageFlow_TenderSent</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <bpmn:intermediateThrowEvent id="IntermediateThrowEvent_MPOO_SendConfirmation" name="Send confirmation and master data">
      <bpmn:incoming>SequenceFlow_MPOO_5</bpmn:incoming>
      <bpmn:outgoing>MessageFlow_ConfirmationSent</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <!-- Sequence flows within MPOO process -->
    <bpmn:sequenceFlow id="SequenceFlow_MPOO_1" sourceRef="StartMessageEvent_MPOO_ReceiveRequest" targetRef="Task_MPOO_ProcessRequest"/>
    <bpmn:sequenceFlow id="SequenceFlow_MPOO_2" sourceRef="Task_MPOO_ProcessRequest" targetRef="IntermediateThrowEvent_MPOO_SendTender"/>
    <bpmn:sequenceFlow id="SequenceFlow_MPOO_3" sourceRef="StartMessageEvent_MPOO_ReceiveOrder" targetRef="Task_MPOO_ProcessOrder"/>
    <bpmn:sequenceFlow id="SequenceFlow_MPOO_4" sourceRef="Task_MPOO_ProcessOrder" targetRef="IntermediateThrowEvent_MPOO_SendConfirmation"/>

  </bpmn:process>

</bpmn:definitions>