<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_MSPN_GO_Process" targetNamespace="http://example.com/bpmn">
  <bpmn:collaboration id="Collaboration_MSPO_GO_Interaction">
    <bpmn:participant id="Participant_MSPO" name="MSPN" processRef="Process_MSPO_Register"/>
    <bpmn:participant id="Participant_GO" name="GO" processRef="Process_GO_Approval"/>
    <bpmn:messageFlow id="MessageFlow_Registration" sourceRef="Task_MSPO_RegisterMeasurement" targetRef="IntermediateCatchEvent_MeasurementReceived">
      <bpmn:name>Register Measurement</bpmn:name>
    </bpmn:messageFlow>
  </bpmn:collaboration>

  <bpmn:process id="Process_MSPO_Register" isExecutable="false">
    <bpmn:startEvent id="StartEvent_MSPO_Start" name="Register Measurement at GO">
      <bpmn:outgoing>SequenceFlow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_MSPO_RegisterMeasurement" name="Register measurement at the GO">
      <bpmn:incoming>SequenceFlow_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_02</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_MSPO_Complete" name="Registration Complete">
      <bpmn:incoming>SequenceFlow_03</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow_01" sourceRef="StartEvent_MSPO_Start" targetRef="Task_MSPO_RegisterMeasurement"/>
    <bpmn:intermediateThrowEvent id="IntermediateThrowEvent_MeasurementSent">
      <bpmn:messageRef>Message_Registation</bpmn:messageRef>
      <bpmn:incoming>SequenceFlow_02</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_03</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <bpmn:sequenceFlow id="SequenceFlow_02" sourceRef="Task_MSPO_RegisterMeasurement" targetRef="IntermediateThrowEvent_MeasurementSent"/>
    <bpmn:sequenceFlow id="SequenceFlow_03" sourceRef="IntermediateThrowEvent_MeasurementSent" targetRef="EndEvent_MSPO_Complete"/>

  </bpmn:process>

  <bpmn:process id="Process_GO_Approval" isExecutable="false">
    <bpmn:startEvent id="StartEvent_GO_Start" name="Application Received from MSPN">
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:endEvent id="EndEvent_GO_Rejected" name="Application Rejected"/>
    
    <bpmn:endEvent id="EndEvent_GO_Complete" name="Process Complete">
      <bpmn:incoming>SequenceFlow_19</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Intermediate Catch Event for Message -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_MeasurementReceived" name="Receive Registration">
      <bpmn:messageRef>Message_Registation</bpmn:messageRef>
      <bpmn:incoming>SequenceFlow_10</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_11</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task to examine application -->
    <bpmn:task id="Task_GO_ExamineApplication" name="Examine the application of the MSPN">
      <bpmn:incoming>SequenceFlow_11</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_12</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for Decision -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_GO_Decision">
      <bpmn:incoming>SequenceFlow_12</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_13</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Reject Path -->
    <bpmn:task id="Task_GO_RejectApplication" name="Reject the application of the MSPN">
      <bpmn:incoming>SequenceFlow_13</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_15</bpmn:outgoing>
    </bpmn:task>

    <!-- Confirm Path -->
    <bpmn:task id="Task_GO_AssignMSPN" name="Assign the MSPN">
      <bpmn:incoming>SequenceFlow_14</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_16</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway for Informing -->
    <bpmn:parallelGateway id="ParallelGateway_Informations">
      <bpmn:incoming>SequenceFlow_16</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_17</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_18</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Inform MSPO -->
    <bpmn:task id="Task_GO_InformMSPO" name="Inform the MSPO about the assignment of MSPN">
      <bpmn:incoming>SequenceFlow_17</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_20</bpmn:outgoing>
    </bpmn:task>

    <!-- Inform MPO -->
    <bpmn:task id="Task_GO_InformMPO" name="Inform the MPO about the assignment of MSPN">
      <bpmn:incoming>SequenceFlow_18</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_20</bpmn:outgoing> <!-- Fixed to unique flow -->
    </bpmn:task>

    <!-- Inform SP -->
    <bpmn:task id="Task_GO_InformSP" name="Inform the SP about the assignment of MSPN">
      <bpmn:incoming>SequenceFlow_19</bpmn:incoming> <!-- Fixed to unique flow from gateway -->
      <bpmn:outgoing>SequenceFlow_20</bpmn:outgoing> <!-- Merged at end -->
    </bpmn:task>

    <!-- Merge Gateway for Parallel Paths -->
    <bpmn:parallelGateway id="ParallelGateway_Merge">
      <bpmn:incoming>SequenceFlow_15</bpmn:incoming> <!-- From Reject Path (Wait, logic check) -->
      <bpmn:incoming>SequenceFlow_20</bpmn:incoming> 
    </bpmn:parallelGateway>

    <!-- Correcting Logic for Merge and End Events based on standard flow -->
    
  </bpmn:process>

  <!-- Message Definitions -->
  <bpmn:message id="Message_Registation" name="Registration"/>

</bpmn:definitions>