<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_DesignProcess" targetNamespace="http://example.com/bpmn">
  <bpmn:collaboration id="Collaboration_DesignApproval">
    <bpmn:participant id="Participant_DesignSystem" name="Design Process" processRef="Process_DesignCycle"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_DesignCycle" isExecutable="false">
    
    <!-- Global Signal Definitions -->
    <bpmn:signal id="Signal_ElecReady" name="Electrical Design Ready"/>
    <bpmn:signal id="Signal_PhysReady" name="Physical Design Ready"/>

    <bpmn:laneSet>
      <bpmn:lane id="Lane_DesignManager" name="Design Manager">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LocateExistingDesigns</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Electrical" name="Electrical Design">
        <bpmn:flowNodeRef>InclusiveGateway_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewPlanElec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviseDesignElec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_ElecTest</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Physical" name="Physical Design">
        <bpmn:flowNodeRef>InclusiveGateway_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewPlanPhys</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviseDesignPhys</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_PhysTest</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Process Starts">
      <bpmn:outgoing>SequenceFlow_StartToLocate</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Initial Task -->
    <bpmn:task id="Task_LocateExistingDesigns" name="Locate and Distribute Existing Designs">
      <bpmn:incoming>SequenceFlow_StartToLocate</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_LocatoSplit</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Split Gateway -->
    <bpmn:parallelGateway id="ParallelGateway_Split" name="Start Design">
      <bpmn:incoming>SequenceFlow_LocatoSplit</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToElecLoop</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ToPhysLoop</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Electrical Design Loop Start -->
    <bpmn:inclusiveGateway id="InclusiveGateway_1" name="Elec Review">
      <bpmn:incoming>SequenceFlow_FromRestart_Elec</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToReviewPlan_Elec</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Electrical Design Tasks -->
    <bpmn:task id="Task_ReviewPlanElec" name="Create Update Plan (Electrical)">
      <bpmn:incoming>SequenceFlow_ToReviewPlan_Elec</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToRevise_Elec</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_ReviseDesignElec" name="Revised Design (Electrical)">
      <bpmn:incoming>SequenceFlow_ToRevise_Elec</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToTestGateway_Elec</bpmn:outgoing>
    </bpmn:task>

    <!-- Electrical Test Gateway -->
    <bpmn:exclusiveGateway id="InclusiveGateway_ElecTest" name="Elec Design Pass?">
      <bpmn:incoming>SequenceFlow_ToTestGateway_Elec</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TestFail_Elec</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_TestPass_Elec</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Physical Design Loop Start -->
    <bpmn:inclusiveGateway id="InclusiveGateway_2" name="Phys Review">
      <bpmn:incoming>SequenceFlow_FromRestart_Phys</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToReviewPlan_Phys</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Physical Design Tasks -->
    <bpmn:task id="Task_ReviewPlanPhys" name="Create Update Plan (Physical)">
      <bpmn:incoming>SequenceFlow_ToReviewPlan_Phys</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToRevise_Phys</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_ReviseDesignPhys" name="Revised Design (Physical)">
      <bpmn:incoming>SequenceFlow_ToRevise_Phys</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToTestGateway_Phys</bpmn:outgoing>
    </bpmn:task>

    <!-- Physical Test Gateway -->
    <bpmn:exclusiveGateway id="InclusiveGateway_PhysTest" name="Phys Design Pass?">
      <bpmn:incoming>SequenceFlow_ToTestGateway_Phys</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TestFail_Phys</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_TestPass_Phys</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Combined Design Gateway -->
    <bpmn:parallelGateway id="ParallelGateway_Combine" name="Combine Designs">
      <bpmn:incoming>SequenceFlow_ElecComplete</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_PhysComplete</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToFinalTest</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Final Test Gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_FinalTest" name="Combined Design Pass?">
      <bpmn:incoming>SequenceFlow_ToFinalTest</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FailRestart</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PassComplete</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Complete" name="Design Complete">
      <bpmn:incoming>SequenceFlow_PassComplete</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows - Initial Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToLocate" sourceRef="StartEvent_1" targetRef="Task_LocateExistingDesigns"/>
    <bpmn:sequenceFlow id="SequenceFlow_LocatoSplit" sourceRef="Task_LocateExistingDesigns" targetRef="ParallelGateway_Split"/>

    <!-- Sequence Flows - Electrical Loop -->
    <bpmn:sequenceFlow id="SequenceFlow_ToReviewPlan_Elec" name="Start Review" sourceRef="InclusiveGateway_1" targetRef="Task_ReviewPlanElec"/>
    <bpmn:sequenceFlow id="SequenceFlow_FromRestart_Elec" sourceRef="IntermediateCatchEvent_Restart_Elec" targetRef="InclusiveGateway_1"/>

    <!-- Sequence Flows - Physical Loop -->
    <bpmn:sequenceFlow id="SequenceFlow_ToReviewPlan_Phys" name="Start Review" sourceRef="InclusiveGateway_2" targetRef="Task_ReviewPlanPhys"/>
    <bpmn:sequenceFlow id="SequenceFlow_FromRestart_Phys" sourceRef="IntermediateCatchEvent_Restart_Phys" targetRef="InclusiveGateway_2"/>

    <!-- Sequence Flows - Test Logic -->
    <bpmn:sequenceFlow id="SequenceFlow_ToRevise_Elec" name="Create Revised Design" sourceRef="Task_ReviewPlanElec" targetRef="Task_ReviseDesignElec"/>
    <bpmn:sequenceFlow id="SequenceFlow_TestFail_Elec" name="No - Review Again" sourceRef="InclusiveGateway_ElecTest" targetRef="Task_ReviewPlanElec"/>

    <bpmn:sequenceFlow id="SequenceFlow_ToRevise_Phys" name="Create Revised Design" sourceRef="Task_ReviewPlanPhys" targetRef="Task_ReviseDesignPhys"/>
    <bpmn:sequenceFlow id="SequenceFlow_TestFail_Phys" name="No - Review Again" sourceRef="InclusiveGateway_PhysTest" targetRef="Task_ReviewPlanPhys"/>

    <!-- Sequence Flows - Test Gateway Connections -->
    <bpmn:sequenceFlow id="SequenceFlow_ToTestGateway_Elec" sourceRef="Task_ReviseDesignElec" targetRef="InclusiveGateway_ElecTest"/>
    <bpmn:sequenceFlow id="SequenceFlow_TestPass_Elec" name="Yes - Signal Other Dept" sourceRef="InclusiveGateway_ElecTest" targetRef="IntermediateThrowEvent_SignalELECReady"/>

    <bpmn:sequenceFlow id="SequenceFlow_ToTestGateway_Phys" sourceRef="Task_ReviseDesignPhys" targetRef="InclusiveGateway_PhysTest"/>
    <bpmn:sequenceFlow id="SequenceFlow_TestPass_Phys" name="Yes - Signal Other Dept" sourceRef="InclusiveGateway_PhysTest" targetRef="IntermediateThrowEvent_SignalPHYSREADY"/>

    <!-- Sequence Flows - Parallel Split to Departments -->
    <bpmn:sequenceFlow id="SequenceFlow_ToElecLoop" sourceRef="ParallelGateway_Split" targetRef="InclusiveGateway_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_ToPhysLoop" sourceRef="ParallelGateway_Split" targetRef="InclusiveGateway_2"/>

    <!-- Sequence Flows - Completion to Combine -->
    <bpmn:sequenceFlow id="SequenceFlow_ElecComplete" name="Design Complete" sourceRef="IntermediateThrowEvent_SignalELECReady" targetRef="ParallelGateway_Combine"/>
    <bpmn:sequenceFlow id="SequenceFlow_PhysComplete" name="Design Complete" sourceRef="IntermediateThrowEvent_SignalPHYSREADY" targetRef="ParallelGateway_Combine"/>

    <!-- Sequence Flows - Final Test -->
    <bpmn:sequenceFlow id="SequenceFlow_ToFinalTest" sourceRef="ParallelGateway_Combine" targetRef="ExclusiveGateway_FinalTest"/>
    <bpmn:sequenceFlow id="SequenceFlow_FailRestart" name="No - Restart Process" sourceRef="ExclusiveGateway_FinalTest" targetRef="StartEvent_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_PassComplete" name="Yes - Complete" sourceRef="ExclusiveGateway_FinalTest" targetRef="EndEvent_Complete"/>

  </bpmn:process>
</bpmn:definitions>