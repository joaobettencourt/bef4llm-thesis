<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_CourtFilesProcess" targetNamespace="http://example.com/bpmn">
  <bpmn:collaboration id="Collaboration_001">
    <bpmn:participant id="Participant_001" name="Court Files Processing Process" processRef="Process_001"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_001" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_AdminStaff" name="Admin Staff">
        <bpmn:flowNodeRef>StartEvent_MorningCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckFilesOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_FileStatus</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SearchMissingFiles</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TrackFileLocation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_Converge1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HandFilesToAssociate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DistributeLawlist</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_Converge2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConductDirectionsHearings</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_HearingsComplete</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_MorningCheck" name="Morning Check">
      <bpmn:outgoing>SequenceFlow_001</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task to check files order -->
    <bpmn:task id="Task_CheckFilesOrder" name="Check Files for Court Hearing">
      <bpmn:incoming>SequenceFlow_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_002</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow from Start to Check Task -->
    <bpmn:sequenceFlow id="SequenceFlow_001" sourceRef="StartEvent_MorningCheck" targetRef="Task_CheckFilesOrder"/>

    <!-- Exclusive Gateway for File Status Decision -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_FileStatus">
      <bpmn:incoming>SequenceFlow_002</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_003</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_004</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flow from Check Task to Gateway -->
    <bpmn:sequenceFlow id="SequenceFlow_002" sourceRef="Task_CheckFilesOrder" targetRef="ExclusiveGateway_FileStatus"/>

    <!-- Parallel Gateway for Convergence after File Handling and Lawlist Distribution -->
    <bpmn:parallelGateway id="ParallelGateway_Converge1">
      <bpmn:incoming>SequenceFlow_005</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_006</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_007</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Sequence Flow for Missing Files Path -->
    <bpmn:sequenceFlow id="SequenceFlow_003" name="Files Missing" sourceRef="ExclusiveGateway_FileStatus" targetRef="Task_SearchMissingFiles"/>

    <!-- Task to search missing files -->
    <bpmn:task id="Task_SearchMissingFiles" name="Initiate File Search">
      <bpmn:incoming>SequenceFlow_003</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_005</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow from Search Task to Parallel Gateway -->
    <bpmn:sequenceFlow id="SequenceFlow_005" sourceRef="Task_SearchMissingFiles" targetRef="ParallelGateway_Converge1"/>

    <!-- Sequence Flow for Files Ready Path (Track Location) -->
    <bpmn:sequenceFlow id="SequenceFlow_004" name="Files in Order" sourceRef="ExclusiveGateway_FileStatus" targetRef="Task_TrackFileLocation"/>

    <!-- Task to track file location when files are ready -->
    <bpmn:task id="Task_TrackFileLocation" name="Track Files to Intended Location">
      <bpmn:incoming>SequenceFlow_004</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_006</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow from Track Task to Parallel Gateway -->
    <bpmn:sequenceFlow id="SequenceFlow_006" sourceRef="Task_TrackFileLocation" targetRef="ParallelGateway_Converge1"/>

    <!-- Hand Files to Associate and Distribute Lawlist (parallel tasks) -->
    <bpmn:task id="Task_HandFilesToAssociate" name="Hand Files to Associate">
      <bpmn:incoming>SequenceFlow_007</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_008</bpmn:outgoing>
    </bpmn:task>

    <!-- Task for Lawlist Distribution -->
    <bpmn:task id="Task_DistributeLawlist" name="Distribute Judges Lawlist">
      <bpmn:incoming>SequenceFlow_012</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_013</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow from Parallel Gateway to Hand Files Task -->
    <bpmn:sequenceFlow id="SequenceFlow_007" sourceRef="ParallelGateway_Converge1" targetRef="Task_HandFilesToAssociate"/>

    <!-- Sequence Flow for Lawlist Distribution Path (Split) -->
    <bpmn:parallelGateway id="ParallelGateway_Split">
      <bpmn:incoming>SequenceFlow_007</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_012</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_008</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Sequence Flow from Parallel Gateway to Lawlist Task -->
    <bpmn:sequenceFlow id="SequenceFlow_012" sourceRef="ParallelGateway_Split" targetRef="Task_DistributeLawlist"/>

    <!-- Convergence before Hearings -->
    <bpmn:parallelGateway id="ParallelGateway_Converge2">
      <bpmn:incoming>SequenceFlow_008</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_013</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_014</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Sequence Flow from Hand Files Task to Converge Gateway -->
    <bpmn:sequenceFlow id="SequenceFlow_008" sourceRef="Task_HandFilesToAssociate" targetRef="ParallelGateway_Converge2"/>

    <!-- Directions Hearings Conducted Task -->
    <bpmn:task id="Task_ConductDirectionsHearings" name="Conduct Directions Hearings">
      <bpmn:incoming>SequenceFlow_014</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_015</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow from Converge Gateway to Hearings Task -->
    <bpmn:sequenceFlow id="SequenceFlow_014" sourceRef="ParallelGateway_Converge2" targetRef="Task_ConductDirectionsHearings"/>

    <!-- End Event after hearings conducted -->
    <bpmn:endEvent id="EndEvent_HearingsComplete">
      <bpmn:incoming>SequenceFlow_015</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flow from Hearings Task to End Event -->
    <bpmn:sequenceFlow id="SequenceFlow_015" sourceRef="Task_ConductDirectionsHearings" targetRef="EndEvent_HearingsComplete"/>

  </bpmn:process>
</bpmn:definitions>