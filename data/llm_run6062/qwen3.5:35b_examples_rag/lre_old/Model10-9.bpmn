<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_ChangeRequestProcess" targetNamespace="http://example.com/bpmn">
  <bpmn:collaboration id="Collaboration_MPO_Process">
    <bpmn:participant id="Participant_MPO" name="MPO Process Owner" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_MPO_Owner" name="MPO Owner">
        <bpmn:flowNodeRef>StartEvent_ChangeRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewChange</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RejectConfirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NotifyFailureReject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PerformChange</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_OutcomeDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ReportImplementationSuccess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NotifyFailureOutcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Failure</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_ChangeRequest" name="Change Request Received">
      <bpmn:messageEventDefinition />
      <bpmn:outgoing>SequenceFlow_Review</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1 -->
    <bpmn:task id="Task_ReviewChange" name="Review change request">
      <bpmn:incoming>SequenceFlow_Review</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RejectConfirm</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1 -->
    <bpmn:exclusiveGateway id="Gateway_RejectConfirm" name="Reject or Confirm?">
      <bpmn:incoming>SequenceFlow_RejectConfirm</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RejectPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ConfirmPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flow 1 -->
    <bpmn:sequenceFlow id="SequenceFlow_Review" sourceRef="StartEvent_ChangeRequest" targetRef="Task_ReviewChange"/>

    <!-- Task 2 (Reject Path) -->
    <bpmn:task id="NotifyFailureReject" name="Notify about failure of changes">
      <bpmn:incoming>SequenceFlow_RejectPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FailureEnd</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow 2 -->
    <bpmn:sequenceFlow id="SequenceFlow_RejectPath" sourceRef="Gateway_RejectConfirm" targetRef="NotifyFailureReject"/>

    <!-- Task 3 (Perform Change) -->
    <bpmn:task id="Task_PerformChange" name="Perform measuring point change">
      <bpmn:incoming>SequenceFlow_ConfirmPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OutcomeDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow 3 -->
    <bpmn:sequenceFlow id="SequenceFlow_ConfirmPath" sourceRef="Gateway_RejectConfirm" targetRef="Task_PerformChange"/>

    <!-- Gateway 2 -->
    <bpmn:exclusiveGateway id="Gateway_OutcomeDecision" name="Implementation Outcome?">
      <bpmn:incoming>SequenceFlow_OutcomeDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SuccessPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_FailureOutcomePath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flow 4 -->
    <bpmn:sequenceFlow id="SequenceFlow_OutcomeDecision" sourceRef="Task_PerformChange" targetRef="Gateway_OutcomeDecision"/>

    <!-- Task 4 (Report Success) -->
    <bpmn:task id="ReportImplementationSuccess" name="Report implementation to SP/PU/GO">
      <bpmn:incoming>SequenceFlow_SuccessPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SuccessEnd</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow 5 -->
    <bpmn:sequenceFlow id="SequenceFlow_SuccessPath" sourceRef="Gateway_OutcomeDecision" targetRef="ReportImplementationSuccess"/>

    <!-- Task 5 (Notify Failure Outcome) -->
    <bpmn:task id="NotifyFailureOutcome" name="Notifies SP/PU/GO about failure of changes">
      <bpmn:incoming>SequenceFlow_FailureOutcomePath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OutcomeEnd</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow 6 -->
    <bpmn:sequenceFlow id="SequenceFlow_FailureOutcomePath" sourceRef="Gateway_OutcomeDecision" targetRef="NotifyFailureOutcome"/>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_Success" name="Process Completed (Success)">
      <bpmn:incoming>SequenceFlow_SuccessEnd</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_Failure" name="Process Ended (Failure)">
      <bpmn:incoming>SequenceFlow_OutcomeEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows to End Events -->
    <bpmn:sequenceFlow id="SequenceFlow_SuccessEnd" sourceRef="ReportImplementationSuccess" targetRef="EndEvent_Success"/>
    <bpmn:sequenceFlow id="SequenceFlow_OutcomeEnd" sourceRef="NotifyFailureOutcome" targetRef="EndEvent_Failure"/>

  </bpmn:process>
</bpmn:definitions>