<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_MeterChangeProcess" targetNamespace="http://example.com/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_MPON" name="MPON" processRef="Process_MPON"/>
    <bpmn:participant id="Participant_MPOO" name="MPOO" processRef="Process_MPOO"/>
    <bpmn:participant id="Participant_GO" name="GO" processRef="Process_GO"/>

    <!-- Message Flows -->
    <bpmn:messageFlow id="MessageFlow_1" sourceRef="Task_MPON_NotifyMPOO" targetRef="StartEvent_MPOO_Initiate"/>
    <bpmn:messageFlow id="MessageFlow_2" sourceRef="IntermediateThrowEvent_MPOO_Response" targetRef="IntermediateCatchEvent_MPON_WaitResponse"/>

  </bpmn:collaboration>

  <!-- MPON Process -->
  <bpmn:process id="Process_MPON" isExecutable="false">
    <bpmn:startEvent id="StartEvent_MPON_Initiate">
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_MPON_NotifyMPOO" name="Notify MPOO about intentions">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:intermediateThrowEvent id="IntermediateThrowEvent_MPOO_Response">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <bpmn:exclusiveGateway id="ExclusiveGateway_MPON_Decision">
      <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_MPON_DismountOld" name="Dismount old equipment">
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_8</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_MPON_MountNew" name="Mount new device">
      <bpmn:incoming>SequenceFlow_7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_9</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_MPON_ReadMeter" name="Read meter count">
      <bpmn:incoming>SequenceFlow_8</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_MPON_Complete">
      <bpmn:incoming>SequenceFlow_11</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_MPON_Initiate" targetRef="Task_MPON_NotifyMPOO"/>
    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="Task_MPON_NotifyMPOO" targetRef="IntermediateThrowEvent_MPOO_Response"/>

  </bpmn:process>

  <!-- MPOO Process -->
  <bpmn:process id="Process_MPOO" isExecutable="false">
    <bpmn:startEvent id="StartEvent_MPOO_Initiate">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_12</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:exclusiveGateway id="ExclusiveGateway_MPOO_DismountCheck">
      <bpmn:incoming>SequenceFlow_13</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_14</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_MPOO_AnnounceYes" name="Announce self dismounting">
      <bpmn:incoming>SequenceFlow_14</bpmn:incoming>
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_16</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_MPOO_Complete">
      <bpmn:incoming>SequenceFlow_17</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_12" sourceRef="StartEvent_MPOO_Initiate" targetRef="ExclusiveGateway_MPOO_DismountCheck"/>
  </bpmn:process>

  <!-- GO Process -->
  <bpmn:process id="Process_GO" isExecutable="false">
    <bpmn:startEvent id="StartEvent_GO_Initiate">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_18</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_GO_NotifyMSP" name="Notify MSP about changes">
      <bpmn:incoming>SequenceFlow_19</bpmn:incoming>
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_20</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_GO_Complete">
      <bpmn:incoming>SequenceFlow_21</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_18" sourceRef="StartEvent_GO_Initiate" targetRef="Task_GO_NotifyMSP"/>
  </bpmn:process>

</bpmn:definitions>