<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_MeetingScheduleProcess" targetNamespace="http://example.com/bpmn">
  <bpmn:collaboration id="Collaboration_0a8x9kq">
    <bpmn:participant id="Participant_TownPlanningAuthority" name="Town Planning Authority" processRef="Process_ScheduleCreation"/>
    <bpmn:participant id="Participant_CommitteeMembers" name="Committee Members" processRef="Process_MemberReview"/>
    <bpmn:messageFlow id="MessageFlow_01_sendSchedule" sourceRef="IntermediateThrowEvent_SendFinalSchedule" targetRef="IntermediateCatchEvent_ReceiveSchedule"/>
    <bpmn:messageFlow id="MessageFlow_02_conflictReport" sourceRef="Task_ReportConflicts" targetRef="StartEvent_ConflictReceived"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_ScheduleCreation" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_CoordinationUnit" name="Coordination Unit">
        <bpmn:flowNodeRef>Task_DraftSchedule</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_NovemberTrigger</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SupportOfficer" name="Support Officer">
        <bpmn:flowNodeRef>Task_CheckDates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateThrowEvent_SendFinalSchedule</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_NovemberTrigger" name="November each year">
      <bpmn:outgoing>SequenceFlow_01</bpmn:outgoing>
      <bpmn:timerEventDefinition />
    </bpmn:startEvent>

    <bpmn:task id="Task_DraftSchedule" name="Draft meeting schedule for next year">
      <bpmn:incoming>SequenceFlow_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_02</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_01" sourceRef="StartEvent_NovemberTrigger" targetRef="Task_DraftSchedule"/>

    <bpmn:intermediateThrowEvent id="IntermediateThrowEvent_AddDraftDates" name="Add draft dates to calendars">
      <bpmn:incoming>SequenceFlow_02</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_03</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <bpmn:sequenceFlow id="SequenceFlow_02" sourceRef="Task_DraftSchedule" targetRef="IntermediateThrowEvent_AddDraftDates"/>

    <bpmn:task id="Task_CheckDates" name="Check dates and suggest modifications">
      <bpmn:incoming>SequenceFlow_03</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_04</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_03" sourceRef="IntermediateThrowEvent_AddDraftDates" targetRef="Task_CheckDates"/>

    <bpmn:exclusiveGateway id="ExclusiveGateway_ConflictsFound">
      <bpmn:incoming>SequenceFlow_04</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_05</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_06</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="SequenceFlow_04" sourceRef="Task_CheckDates" targetRef="ExclusiveGateway_ConflictsFound"/>

    <bpmn:task id="Task_RecheckConflicts" name="Recheck all dates for conflicts">
      <bpmn:incoming>SequenceFlow_05</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_07</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_05" sourceRef="ExclusiveGateway_ConflictsFound" targetRef="Task_RecheckConflicts"/>

    <bpmn:endEvent id="EndEvent_ScheduleFinalized">
      <bpmn:incoming>SequenceFlow_07</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow_06" sourceRef="ExclusiveGateway_ConflictsFound" targetRef="EndEvent_ScheduleFinalized"/>

    <bpmn:intermediateThrowEvent id="IntermediateThrowEvent_SendFinalSchedule" name="Send final schedule to Committee Members">
      <bpmn:incoming>SequenceFlow_07</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_08</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>

    <bpmn:endEvent id="EndEvent_ProcessComplete">
      <bpmn:incoming>SequenceFlow_08</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow_07" sourceRef="Task_RecheckConflicts" targetRef="IntermediateThrowEvent_SendFinalSchedule"/>
    <bpmn:sequenceFlow id="SequenceFlow_08" sourceRef="IntermediateThrowEvent_SendFinalSchedule" targetRef="EndEvent_ProcessComplete"/>

  </bpmn:process>

  <bpmn:process id="Process_MemberReview" isExecutable="false">
    <bpmn:startEvent id="StartEvent_ConflictReceived" name="Receive conflict report">
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>

    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_ReceiveSchedule" name="Receive final schedule">
      <bpmn:incoming>SequenceFlow_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_09</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>

    <bpmn:task id="Task_CheckDiaries" name="Check diaries for conflicts">
      <bpmn:incoming>SequenceFlow_09</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_09" sourceRef="IntermediateCatchEvent_ReceiveSchedule" targetRef="Task_CheckDiaries"/>

    <bpmn:exclusiveGateway id="ExclusiveGateway_ConflictExists">
      <bpmn:incoming>SequenceFlow_10</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_11</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="Task_CheckDiaries" targetRef="ExclusiveGateway_ConflictExists"/>

    <bpmn:task id="Task_ReportConflicts" name="Advise Coordination Unit of conflicts">
      <bpmn:incoming>SequenceFlow_11</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_13</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_NoConflicts">
      <bpmn:incoming>SequenceFlow_12</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow_11" sourceRef="ExclusiveGateway_ConflictExists" targetRef="Task_ReportConflicts"/>
    <bpmn:sequenceFlow id="SequenceFlow_12" sourceRef="ExclusiveGateway_ConflictExists" targetRef="EndEvent_NoConflicts"/>

    <bpmn:endEvent id="EndEvent_MemberReviewComplete">
      <bpmn:incoming>SequenceFlow_13</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow_13" sourceRef="Task_ReportConflicts" targetRef="EndEvent_MemberReviewComplete"/>

  </bpmn:process>
</bpmn:definitions>