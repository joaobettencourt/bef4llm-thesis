<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_BillProcessing_v2" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Pool_Sender" name="MPOO / MSPO" processRef="Process_Sender"/>
    <bpmn:participant id="Pool_Processor" name="GO / MPON" processRef="Process_Processor"/>

    <!-- Message Flows from Sender to Processor -->
    <bpmn:messageFlow id="MessageFlow_1" sourceRef="ThrowEvent_TempOps" targetRef="CatchEvent_TempOps"/>
    <bpmn:messageFlow id="MessageFlow_2" sourceRef="ThrowEvent_MeasurementCont" targetRef="CatchEvent_MeasCont"/>
    <bpmn:messageFlow id="MessageFlow_3" sourceRef="ThrowEvent_AddReadings" targetRef="CatchEvent_AddReadings"/>
    <bpmn:messageFlow id="MessageFlow_4" sourceRef="ThrowEvent_EquipAcq" targetRef="CatchEvent_EquipAcq"/>

    <!-- Message Flows from Processor to Sender -->
    <bpmn:messageFlow id="MessageFlow_Confirm" sourceRef="ThrowEvent_Confirm" targetRef="CatchEvent_Confirm"/>
    <bpmn:messageFlow id="MessageFlow_Reject" sourceRef="ThrowEvent_Reject" targetRef="CatchEvent_Reject"/>

  </bpmn:collaboration>

  <!-- Process for Sender (MPOO / MSPO) -->
  <bpmn:process id="Process_Sender">
    <bpmn:startEvent id="Start_SendBill_Ops">
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task for MPOO sending bill -->
    <bpmn:task id="Task_MPOO_TempOps" name="Send Bill (Temp Continuation Ops)">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:task>

    <!-- Task for MSPO sending bill -->
    <bpmn:startEvent id="Start_SendBill_Meas">
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_MSPO_TempMeas" name="Send Bill (Temp Measurement)">
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
    </bpmn:task>

    <!-- Additional Readings -->
    <bpmn:startEvent id="Start_SendBill_AddRead">
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_MSPO_AddRead" name="Send Bill (Additional Readings)">
      <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
    </bpmn:task>

    <!-- Equipment Acquisition -->
    <bpmn:startEvent id="Start_SendBill_Equip">
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_MPOO_Equip" name="Send Bill (Equipment Acquisition)">
      <bpmn:incoming>SequenceFlow_7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_8</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Throw Events for Messages -->
    <bpmn:intermediateThrowEvent id="ThrowEvent_TempOps" name="Send Bill Ops">
      <bpmn:messageEventDefinition />
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_End1</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <bpmn:intermediateThrowEvent id="ThrowEvent_MeasurementCont" name="Send Bill Meas">
      <bpmn:messageEventDefinition />
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_End2</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <bpmn:intermediateThrowEvent id="ThrowEvent_AddReadings" name="Send Bill Read">
      <bpmn:messageEventDefinition />
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_End3</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <bpmn:intermediateThrowEvent id="ThrowEvent_EquipAcq" name="Send Bill Equip">
      <bpmn:messageEventDefinition />
      <bpmn:incoming>SequenceFlow_8</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_End4</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="Start_SendBill_Ops" targetRef="Task_MPOO_TempOps"/>
    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="Task_MPOO_TempOps" targetRef="ThrowEvent_TempOps"/>

    <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="Start_SendBill_Meas" targetRef="Task_MSPO_TempMeas"/>
    <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="Task_MSPO_TempMeas" targetRef="ThrowEvent_MeasurementCont"/>

    <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="Start_SendBill_AddRead" targetRef="Task_MSPO_AddRead"/>
    <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="Task_MSPO_AddRead" targetRef="ThrowEvent_AddReadings"/>

    <bpmn:sequenceFlow id="SequenceFlow_7" sourceRef="Start_SendBill_Equip" targetRef="Task_MPOO_Equip"/>
    <bpmn:sequenceFlow id="SequenceFlow_8" sourceRef="Task_MPOO_Equip" targetRef="ThrowEvent_EquipAcq"/>

    <!-- End Events -->
    <bpmn:endEvent id="End1">
      <bpmn:incoming>SequenceFlow_End1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End2">
      <bpmn:incoming>SequenceFlow_End2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End3">
      <bpmn:incoming>SequenceFlow_End3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End4">
      <bpmn:incoming>SequenceFlow_End4</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow_End1" sourceRef="ThrowEvent_TempOps" targetRef="End1"/>
    <bpmn:sequenceFlow id="SequenceFlow_End2" sourceRef="ThrowEvent_MeasurementCont" targetRef="End2"/>
    <bpmn:sequenceFlow id="SequenceFlow_End3" sourceRef="ThrowEvent_AddReadings" targetRef="End3"/>
    <bpmn:sequenceFlow id="SequenceFlow_End4" sourceRef="ThrowEvent_EquipAcq" targetRef="End4"/>

  </bpmn:process>

  <!-- Process for Processor (GO / MPON) -->
  <bpmn:process id="Process_Processor">
    <!-- Catch Events for Incoming Bills -->
    <bpmn:startEvent id="Start_Catch_TempOps" name="Receive Bill Ops">
      <bpmn:messageEventDefinition />
      <bpmn:outgoing>SequenceFlow_Proc_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:startEvent id="Start_Catch_MeasCont" name="Receive Bill Meas">
      <bpmn:messageEventDefinition />
      <bpmn:outgoing>SequenceFlow_Proc_2</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:startEvent id="Start_Catch_AddRead" name="Receive Bill Read">
      <bpmn:messageEventDefinition />
      <bpmn:outgoing>SequenceFlow_Proc_3</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:startEvent id="Start_Catch_Equip" name="Receive Bill Equip">
      <bpmn:messageEventDefinition />
      <bpmn:outgoing>SequenceFlow_Proc_4</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Intermediate Catch Events for Messages -->
    <bpmn:intermediateCatchEvent id="CatchEvent_TempOps" name="Receive Bill Ops">
      <bpmn:messageEventDefinition />
      <bpmn:incoming/>
      <bpmn:outgoing>SequenceFlow_Proc_1</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:intermediateCatchEvent id="CatchEvent_MeasCont" name="Receive Bill Meas">
      <bpmn:messageEventDefinition />
      <bpmn:incoming/>
      <bpmn:outgoing>SequenceFlow_Proc_2</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:intermediateCatchEvent id="CatchEvent_AddReadings" name="Receive Bill Read">
      <bpmn:messageEventDefinition />
      <bpmn:incoming/>
      <bpmn:outgoing>SequenceFlow_Proc_3</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:intermediateCatchEvent id="CatchEvent_EquipAcq" name="Receive Bill Equip">
      <bpmn:messageEventDefinition />
      <bpmn:incoming/>
      <bpmn:outgoing>SequenceFlow_Proc_4</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task to Examine Bill -->
    <bpmn:task id="Task_ExamineBill" name="Examine Bill">
      <bpmn:incoming>SequenceFlow_Proc_Converge</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Gateway_1</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for Decision -->
    <bpmn:exclusiveGateway id="Gateway_Decision" name="Confirm or Reject?">
      <bpmn:incoming>SequenceFlow_Gateway_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConfirmPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RejectPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Confirmation Path -->
    <bpmn:intermediateThrowEvent id="ThrowEvent_Confirm" name="Send Payment Advice">
      <bpmn:messageEventDefinition />
      <bpmn:incoming>SequenceFlow_ConfirmPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Proc_End1</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <!-- Rejection Path -->
    <bpmn:task id="Task_RejectBill" name="Reject Invoice">
       <bpmn:incoming>SequenceFlow_RejectPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Proc_ThrowRej</bpmn:outgoing>
    </bpmn:task>

     <bpmn:intermediateThrowEvent id="ThrowEvent_Reject" name="Send Rejection">
       <bpmn:messageEventDefinition />
      <bpmn:incoming>SequenceFlow_Proc_ThrowRej</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Proc_End2</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <!-- End Events -->
     <bpmn:endEvent id="ProcEnd1">
       <bpmn:incoming>SequenceFlow_Proc_End1</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="ProcEnd2">
      <bpmn:incoming>SequenceFlow_Proc_End2</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_Proc_1" sourceRef="CatchEvent_TempOps" targetRef="Task_ExamineBill"/>
    <bpmn:sequenceFlow id="SequenceFlow_Proc_2" sourceRef="CatchEvent_MeasCont" targetRef="Task_ExamineBill"/>
    <bpmn:sequenceFlow id="SequenceFlow_Proc_3" sourceRef="CatchEvent_AddReadings" targetRef="Task_ExamineBill"/>
    <bpmn:sequenceFlow id="SequenceFlow_Proc_4" sourceRef="CatchEvent_EquipAcq" targetRef="Task_ExamineBill"/>

    <!-- Convergence to Task -->
    <bpmn:parallelGateway id="ParallelGateway_Converge">
      <bpmn:incoming>SequenceFlow_Proc_1</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_Proc_2</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_Proc_3</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_Proc_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Proc_Converge</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:sequenceFlow id="SequenceFlow_Gateway_1" sourceRef="Task_ExamineBill" targetRef="Gateway_Decision"/>

    <bpmn:sequenceFlow id="SequenceFlow_Proc_Converge" sourceRef="ParallelGateway_Converge" targetRef="Task_ExamineBill"/>
    <bpmn:parallelGateway id="ParallelGateway_Start">
      <bpmn:incoming>SequenceFlow_Gateway_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Proc_Converge</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Fix the flow structure -->
    <bpmn:sequenceFlow id="SequenceFlow_Gateway_1" sourceRef="Task_ExamineBill" targetRef="ParallelGateway_Start"/>

    <bpmn:sequenceFlow id="SequenceFlow_ConfirmPath" name="Confirm with Payment Advice" sourceRef="Gateway_Decision" targetRef="ThrowEvent_Confirm"/>
    <bpmn:sequenceFlow id="SequenceFlow_RejectPath" name="Reject Invoice" sourceRef="Gateway_Decision" targetRef="Task_RejectBill"/>

    <bpmn:sequenceFlow id="SequenceFlow_Proc_ThrowRej" sourceRef="Task_RejectBill" targetRef="ThrowEvent_Reject"/>
    <bpmn:parallelGateway id="ParallelGateway_Start">
      <bpmn:incoming>SequenceFlow_Gateway_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Proc_Converge</bpmn:outgoing>
    </bpmn:parallelGateway>

     <bpmn:sequenceFlow id="SequenceFlow_Proc_End1" sourceRef="ThrowEvent_Confirm" targetRef="ProcEnd1"/>
    <bpmn:sequenceFlow id="SequenceFlow_Proc_End2" sourceRef="ThrowEvent_Reject" targetRef="ProcEnd2"/>

  </bpmn:process>

</bpmn:definitions>