<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                 xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                 xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                 xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" 
                 id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:collaboration id="Collaboration_INQ_IP">
    <!-- INQ Pool -->
    <bpmn:participant id="Participant_INQ_Pool" name="INQ" processRef="Process_INQ"/>
    
    <!-- IP Pool -->
    <bpmn:participant id="Participant_IP_Pool" name="IP" processRef="Process_IP"/>

    <!-- Message Flow from INQ to IP (Transaction Data Request) -->
    <bpmn:messageFlow id="MessageFlow_Request" 
                      sourceRef="IntermediateThrowEvent_INQ_SendRequest" 
                      targetRef="StartMessageEvent_IP_ReceiveRequest">
      <bpmn:name>Send Transaction Data Request</bpmn:name>
    </bpmn:messageFlow>

  </bpmn:collaboration>

  <!-- Process for INQ Pool -->
  <bpmn:process id="Process_INQ" isExecutable="false">
    
    <bpmn:startEvent id="StartEvent_INQ_RequestTransaction" name="Initiate Transaction Request">
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_INQ_SendRequest" name="Transmit Data Request to IP">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Throw Event for Message -->
    <bpmn:intermediateThrowEvent id="IntermediateThrowEvent_INQ_SendRequest" name="Send Request">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <!-- End Event for INQ -->
    <bpmn:endEvent id="EndEvent_INQ_AwaitResponse" name="Await Response">
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_INQ_RequestTransaction" targetRef="Task_INQ_SendRequest"/>
    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="Task_INQ_SendRequest" targetRef="IntermediateThrowEvent_INQ_SendRequest"/>
    <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="IntermediateThrowEvent_INQ_SendRequest" targetRef="EndEvent_INQ_AwaitResponse"/>

  </bpmn:process>

  <!-- Process for IP Pool -->
  <bpmn:process id="Process_IP" isExecutable="false">
    
    <bpmn:startEvent id="StartMessageEvent_IP_ReceiveRequest" name="Receive Transaction Request">
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task for IP to check the request -->
    <bpmn:task id="Task_IP_CheckRequest" name="Check/Validate Transaction Request">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway for Decision -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_IP_Decision" name="Examination Result">
      <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task for Transmission of Data -->
    <bpmn:task id="Task_IP_TransmitData" name="Transmit Data">
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_8</bpmn:outgoing>
    </bpmn:task>

    <!-- Task for Rejection -->
    <bpmn:task id="Task_IP_Reject" name="Reject Request">
      <bpmn:incoming>SequenceFlow_7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_9</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event for Transmission -->
    <bpmn:endEvent id="EndEvent_IP_TransmissionComplete" name="Transmission Complete">
      <bpmn:incoming>SequenceFlow_8</bpmn:incoming>
    </bpmn:endEvent>

    <!-- End Event for Rejection -->
    <bpmn:endEvent id="EndEvent_IP_Rejected" name="Request Rejected">
      <bpmn:incoming>SequenceFlow_9</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="StartMessageEvent_IP_ReceiveRequest" targetRef="Task_IP_CheckRequest"/>
    <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="Task_IP_CheckRequest" targetRef="ExclusiveGateway_IP_Decision"/>
    <bpmn:sequenceFlow id="SequenceFlow_6" name="Examination Successful" sourceRef="ExclusiveGateway_IP_Decision" targetRef="Task_IP_TransmitData"/>
    <bpmn:sequenceFlow id="SequenceFlow_7" name="Rejection Required" sourceRef="ExclusiveGateway_IP_Decision" targetRef="Task_IP_Reject"/>
    <bpmn:sequenceFlow id="SequenceFlow_8" sourceRef="Task_IP_TransmitData" targetRef="EndEvent_IP_TransmissionComplete"/>
    <bpmn:sequenceFlow id="SequenceFlow_9" sourceRef="Task_IP_Reject" targetRef="EndEvent_IP_Rejected"/>

  </bpmn:process>

</bpmn:definitions>