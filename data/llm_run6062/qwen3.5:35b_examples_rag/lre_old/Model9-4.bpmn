<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_MeetingProcess" targetNamespace="http://example.com/bpmn">
  <bpmn:collaboration id="Collaboration_0geryc1">
    <bpmn:participant id="Participant_InternalUnit" name="Internal Coordination Unit" processRef="Process_Internal"/>
    <bpmn:participant id="Participant_CommitteeMembers" name="Committee Members" processRef="Process_Members"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Internal" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_CoordinationUnit" name="Coordination Unit">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_QACheckMinutes</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SupportOfficer" name="Support Officer">
        <bpmn:flowNodeRef>Task_UpdateCalendars</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateMeetingFolders</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UploadDocuments</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Dates finalized">
      <bpmn:outgoing>SequenceFlow_Internal_001</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Parallel Gateway for Support Officer Tasks -->
    <bpmn:parallelGateway id="ParallelGateway_SupportTasks" name="Support Tasks">
      <bpmn:incoming>SequenceFlow_Internal_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Internal_002</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Support Officer Tasks (Parallel) -->
    <bpmn:task id="Task_UpdateCalendars" name="Update group calendars">
      <bpmn:incoming>SequenceFlow_Internal_002</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Internal_015</bpmn:outgoing>
    </bpmn:task>

    <!-- Support Officer Tasks (Parallel) -->
    <bpmn:task id="Task_CreateMeetingFolders" name="Create meeting folders">
      <bpmn:incoming>SequenceFlow_Internal_003</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Internal_016</bpmn:outgoing>
    </bpmn:task>

    <!-- Support Officer Tasks (Parallel) -->
    <bpmn:task id="Task_UploadDocuments" name="Ensure documents uploaded">
      <bpmn:incoming>SequenceFlow_Internal_004</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Internal_017</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flows from Parallel Gateway -->
    <bpmn:sequenceFlow id="SequenceFlow_Internal_002" sourceRef="ParallelGateway_SupportTasks" targetRef="Task_UpdateCalendars"/>
    <bpmn:sequenceFlow id="SequenceFlow_Internal_003" sourceRef="ParallelGateway_SupportTasks" targetRef="Task_CreateMeetingFolders"/>
    <bpmn:sequenceFlow id="SequenceFlow_Internal_004" sourceRef="ParallelGateway_SupportTasks" targetRef="Task_UploadDocuments"/>

    <!-- Parallel Gateway to join Support Tasks -->
    <bpmn:parallelGateway id="ParallelGateway_JoinSupport">
      <bpmn:incoming>SequenceFlow_Internal_015</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_Internal_016</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_Internal_017</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Internal_005</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Sequence Flows to Join Gateway -->
    <bpmn:sequenceFlow id="SequenceFlow_Internal_015" sourceRef="Task_UpdateCalendars" targetRef="ParallelGateway_JoinSupport"/>
    <bpmn:sequenceFlow id="SequenceFlow_Internal_016" sourceRef="Task_CreateMeetingFolders" targetRef="ParallelGateway_JoinSupport"/>
    <bpmn:sequenceFlow id="SequenceFlow_Internal_017" sourceRef="Task_UploadDocuments" targetRef="ParallelGateway_JoinSupport"/>

    <!-- Message to Committee Members -->
    <bpmn:intermediateThrowEvent id="IntermediateMessage_AdviseMembers" name="Advise members (1 week before)">
      <bpmn:incoming>SequenceFlow_Internal_005</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Internal_006</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <!-- Support Office produces minutes -->
    <bpmn:task id="Task_ProduceMinutes" name="Produce meeting minutes">
      <bpmn:incoming>SequenceFlow_Internal_018</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Internal_019</bpmn:outgoing>
    </bpmn:task>

    <!-- QA Check by Coordination Unit -->
    <bpmn:task id="Task_QACheckMinutes" name="QA check on minutes">
      <bpmn:incoming>SequenceFlow_Internal_019</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Internal_020</bpmn:outgoing>
    </bpmn:task>

    <!-- Send Minutes to Members -->
    <bpmn:intermediateThrowEvent id="IntermediateMessage_SendMinutes" name="Send minutes to members">
      <bpmn:incoming>SequenceFlow_Internal_020</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Internal_021</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <!-- Support Officer updates records -->
    <bpmn:task id="Task_UpdateRecords" name="Update departmental records">
      <bpmn:incoming>SequenceFlow_Internal_021</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Internal_022</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Final" name="Records updated">
      <bpmn:incoming>SequenceFlow_Internal_022</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows for Minutes Process -->
    <bpmn:sequenceFlow id="SequenceFlow_Internal_005" sourceRef="ParallelGateway_JoinSupport" targetRef="IntermediateMessage_AdviseMembers"/>
    <bpmn:sequenceFlow id="SequenceFlow_Internal_018" sourceRef="Task_ProduceMinutes" targetRef="Task_QACheckMinutes"/>
    <bpmn:sequenceFlow id="SequenceFlow_Internal_019" sourceRef="Task_QACheckMinutes" targetRef="IntermediateMessage_SendMinutes"/>
    <bpmn:sequenceFlow id="SequenceFlow_Internal_020" sourceRef="IntermediateMessage_SendMinutes" targetRef="EndEvent_Final"/>

  </bpmn:process>

  <!-- Committee Members Process -->
  <bpmn:process id="Process_Members" isExecutable="false">
    <bpmn:startEvent id="StartEvent_AdviseMembers" name="Receive meeting advice">
      <bpmn:outgoing>SequenceFlow_Members_001</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Committee Members read documents -->
    <bpmn:task id="Task_ReadDocuments" name="Read related documents">
      <bpmn:incoming>SequenceFlow_Members_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Members_002</bpmn:outgoing>
    </bpmn:task>

    <!-- Committee Members hold meeting -->
    <bpmn:endEvent id="EndEvent_Committee" name="Minutes received">
      <bpmn:incoming>SequenceFlow_Members_003</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows for Members Process -->
    <bpmn:sequenceFlow id="SequenceFlow_Members_001" sourceRef="StartEvent_AdviseMembers" targetRef="Task_ReadDocuments"/>
    <bpmn:sequenceFlow id="SequenceFlow_Members_002" sourceRef="Task_ReadDocuments" targetRef="EndEvent_Committee"/>

  </bpmn:process>

  <!-- Message Flows between pools -->
  <bpmn:messageFlow id="MessageFlow_AdviseMembers" name="Advise meeting schedule">
    <bpmn:sourceRef>IntermediateMessage_AdviseMembers</bpmn:sourceRef>
    <bpmn:targetRef>StartEvent_AdviseMembers</bpmn:targetRef>
  </bpmn:messageFlow>

  <bpmn:messageFlow id="MessageFlow_SendMinutes" name="Send meeting minutes">
    <bpmn:sourceRef>IntermediateMessage_SendMinutes</bpmn:sourceRef>
    <bpmn:targetRef>EndEvent_Committee</bpmn:targetRef>
  </bpmn:messageFlow>

</bpmn:definitions>