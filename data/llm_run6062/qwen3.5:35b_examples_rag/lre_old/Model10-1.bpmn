<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_DismissalProcess_Corrected" targetNamespace="http://example.com/bpmn">
  <bpmn:collaboration id="Collaboration_DismissalApproval">
    <bpmn:participant id="Participant_MPON" name="MPON" processRef="Pool_MPON"/>
    <bpmn:participant id="Participant_MPOO" name="MPOO" processRef="Pool_MPOO"/>
    <bpmn:messageFlow id="MessageFlow_DismissalSent">
      <bpmn:sourceRef>Task_SendDismissal</bpmn:sourceRef>
      <bpmn:targetRef>StartEvent_ReceiveDismissal</bpmn:targetRef>
    </bpmn:messageFlow>
  </bpmn:collaboration>

  <!-- MPON Process -->
  <bpmn:process id="Pool_MPON" isExecutable="false">
    <bpmn:startEvent id="StartEvent_MPONInitiate">
      <bpmn:outgoing>SequenceFlow_Initiate</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:endEvent id="EndEvent_MPONCompleted"/>

    <bpmn:task id="Task_SendDismissal" name="Send Dismissal">
      <bpmn:incoming>SequenceFlow_Initiate</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Dispatched</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_MPONWait"/>

    <bpmn:sequenceFlow id="SequenceFlow_Initiate" sourceRef="StartEvent_MPONInitiate" targetRef="Task_SendDismissal"/>
    <bpmn:sequenceFlow id="SequenceFlow_Dispatched" sourceRef="Task_SendDismissal" targetRef="EndEvent_MPONWait"/>

  </bpmn:process>

  <!-- MPOO Process -->
  <bpmn:process id="Pool_MPOO" isExecutable="false">
    <bpmn:startEvent id="StartEvent_ReceiveDismissal">
      <bpmn:outgoing>SequenceFlow_StartReview</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:endEvent id="EndEvent_Opposed"/>
    <bpmn:endEvent id="EndEvent_Confirmed"/>

    <bpmn:task id="Task_ReviewDismissal" name="Review Dismissal">
      <bpmn:incoming>SequenceFlow_StartReview</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToGateway</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="ExclusiveGateway_Decision">
      <bpmn:incoming>SequenceFlow_ToGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OpposePath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ConfirmPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_OpposeDismissal" name="Oppose Dismissal">
      <bpmn:incoming>SequenceFlow_OpposePath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndOpposed</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_ConfirmDismissal" name="Confirm Dismissal">
      <bpmn:incoming>SequenceFlow_ConfirmPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndConfirmed</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_StartReview" sourceRef="StartEvent_ReceiveDismissal" targetRef="Task_ReviewDismissal"/>
    <bpmn:sequenceFlow id="SequenceFlow_ToGateway" sourceRef="Task_ReviewDismissal" targetRef="ExclusiveGateway_Decision"/>

    <!-- Decision Paths -->
    <bpmn:exclusiveGateway id="InclusiveGateway_Oppose">
      <bpmn:incoming>SequenceFlow_EndOpposed</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FinalizeOpposed</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <bpmn:exclusiveGateway id="InclusiveGateway_Confirm">
      <bpmn:incoming>SequenceFlow_EndConfirmed</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FinalizeConfirmed</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Oppose Path -->
    <bpmn:sequenceFlow id="SequenceFlow_OpposePath" sourceRef="ExclusiveGateway_Decision" targetRef="Task_OpposeDismissal"/>
    <bpmn:sequenceFlow id="SequenceFlow_EndOpposed" sourceRef="Task_OpposeDismissal" targetRef="InclusiveGateway_Oppose"/>

    <!-- Confirm Path -->
    <bpmn:sequenceFlow id="SequenceFlow_ConfirmPath" sourceRef="ExclusiveGateway_Decision" targetRef="Task_ConfirmDismissal"/>
    <bpmn:sequenceFlow id="SequenceFlow_EndConfirmed" sourceRef="Task_ConfirmDismissal" targetRef="InclusiveGateway_Confirm"/>

  </bpmn:process>

</bpmn:definitions>