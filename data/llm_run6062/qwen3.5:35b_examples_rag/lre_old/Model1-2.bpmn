<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_CRSRepairProcess" targetNamespace="http://example.com/bpmn">
  <bpmn:collaboration id="Collaboration_0ygkg4f">
    <bpmn:participant id="Participant_0ygkg4f" name="CRS Repair Process" processRef="Process_CRSRepair"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_CRSRepair" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Customer brings defective computer">
      <bpmn:outgoing>SequenceFlow_001</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: CRS checks defect and calculates cost -->
    <bpmn:task id="Task_CheckDefect" name="Check defect &amp; calculate repair costs">
      <bpmn:incoming>SequenceFlow_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_002</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow to Decision Gateway -->
    <bpmn:sequenceFlow id="SequenceFlow_001" sourceRef="StartEvent_1" targetRef="Task_CheckDefect"/>
    
    <!-- Exclusive Gateway for customer decision on costs -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_CustomerDecision">
      <bpmn:incoming>SequenceFlow_002</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_003</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_014</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flow for customer accepts costs -->
    <bpmn:sequenceFlow id="SequenceFlow_002" sourceRef="Task_CheckDefect" targetRef="ExclusiveGateway_CustomerDecision"/>
    
    <!-- Parallel Gateway to start two repair activities in arbitrary order -->
    <bpmn:parallelGateway id="ParallelGateway_RepairStart">
      <bpmn:incoming>SequenceFlow_003</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_004</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_012</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Sequence Flow for customer accepts costs -->
    <bpmn:sequenceFlow id="SequenceFlow_003" sourceRef="ExclusiveGateway_CustomerDecision" targetRef="ParallelGateway_RepairStart"/>

    <!-- Task 1: Check and repair hardware -->
    <bpmn:task id="Task_HardwareRepair" name="Check &amp; repair hardware">
      <bpmn:incoming>SequenceFlow_004</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_005</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: Check and configure software -->
    <bpmn:task id="Task_SoftwareConfig" name="Check &amp; configure software">
      <bpmn:incoming>SequenceFlow_012</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_013</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow for hardware repair -->
    <bpmn:sequenceFlow id="SequenceFlow_004" sourceRef="ParallelGateway_RepairStart" targetRef="Task_HardwareRepair"/>
    
    <!-- Sequence Flow for software configuration (parallel path) -->
    <bpmn:sequenceFlow id="SequenceFlow_012" sourceRef="ParallelGateway_RepairStart" targetRef="Task_SoftwareConfig"/>

    <!-- Exclusive Gateway after hardware repair to test functionality -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_HardwareTest">
      <bpmn:incoming>SequenceFlow_005</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_006</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_010</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Exclusive Gateway after software test to merge paths -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_SoftwareTest">
      <bpmn:incoming>SequenceFlow_013</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_015</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_020</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flow for hardware test result (no error) -->
    <bpmn:sequenceFlow id="SequenceFlow_005" sourceRef="Task_HardwareRepair" targetRef="ExclusiveGateway_HardwareTest"/>
    
    <!-- Sequence Flow for software test result (no error) -->
    <bpmn:sequenceFlow id="SequenceFlow_013" sourceRef="Task_SoftwareConfig" targetRef="ExclusiveGateway_SoftwareTest"/>

    <!-- Exclusive Gateway to merge both paths after testing -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_Merge">
      <bpmn:incoming>SequenceFlow_006</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_015</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_023</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flow for hardware test (no error) -->
    <bpmn:sequenceFlow id="SequenceFlow_006" sourceRef="ExclusiveGateway_HardwareTest" targetRef="ExclusiveGateway_Merge"/>
    
    <!-- Sequence Flow for software test (no error) -->
    <bpmn:sequenceFlow id="SequenceFlow_015" sourceRef="ExclusiveGateway_SoftwareTest" targetRef="ExclusiveGateway_Merge"/>

    <!-- Task: Another repair activity if errors detected -->
    <bpmn:task id="Task_AdditionalRepair" name="Execute additional repair">
      <bpmn:incoming>SequenceFlow_010</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_024</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow for hardware test (error detected) -->
    <bpmn:sequenceFlow id="SequenceFlow_010" sourceRef="ExclusiveGateway_HardwareTest" targetRef="Task_AdditionalRepair"/>
    
    <!-- Loop back to parallel gateway after additional repair -->
    <bpmn:parallelGateway id="ParallelGateway_RepairLoop">
      <bpmn:incoming>SequenceFlow_024</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_016</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_017</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Sequence Flow for software test (error detected) -->
    <bpmn:sequenceFlow id="SequenceFlow_020" sourceRef="ExclusiveGateway_SoftwareTest" targetRef="Task_AdditionalRepair"/>
    
    <!-- Loop back to parallel gateway after additional repair -->
    <bpmn:parallelGateway id="ParallelGateway_RepairLoop2">
      <bpmn:incoming>SequenceFlow_016</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_025</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_026</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Sequence Flow for additional repair to loop back -->
    <bpmn:sequenceFlow id="SequenceFlow_016" sourceRef="Task_AdditionalRepair" targetRef="ParallelGateway_RepairLoop"/>
    
    <!-- Loop from parallel gateway to hardware task -->
    <bpmn:parallelGateway id="ParallelGateway_Hardware">
      <bpmn:incoming>SequenceFlow_025</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_018</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_019</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Sequence Flow for additional repair to loop back -->
    <bpmn:sequenceFlow id="SequenceFlow_024" sourceRef="Task_AdditionalRepair" targetRef="ParallelGateway_RepairLoop"/>
    
    <!-- Loop from parallel gateway to hardware task -->
    <bpmn:parallelGateway id="ParallelGateway_Software">
      <bpmn:incoming>SequenceFlow_017</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_025</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_026</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Sequence Flow for additional repair to loop back -->
    <bpmn:sequenceFlow id="SequenceFlow_017" sourceRef="Task_AdditionalRepair" targetRef="ParallelGateway_Software"/>
    
    <!-- Loop from parallel gateway to hardware task -->
    <bpmn:endEvent id="EndEvent_CustomerTakesHome">
      <bpmn:name>Customer takes computer home unrepaired</bpmn:name>
      <bpmn:incoming>SequenceFlow_014</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flow for customer rejects costs -->
    <bpmn:sequenceFlow id="SequenceFlow_014" sourceRef="ExclusiveGateway_CustomerDecision" targetRef="EndEvent_CustomerTakesHome"/>

    <!-- End Event after successful repair completion -->
    <bpmn:endEvent id="EndEvent_RepairCompleted">
      <bpmn:name>Repair completed</bpmn:name>
      <bpmn:incoming>SequenceFlow_023</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flow for successful completion -->
    <bpmn:sequenceFlow id="SequenceFlow_023" sourceRef="ExclusiveGateway_Merge" targetRef="EndEvent_RepairCompleted"/>

  </bpmn:process>
</bpmn:definitions>