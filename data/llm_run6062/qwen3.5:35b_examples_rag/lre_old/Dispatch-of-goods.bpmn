<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_ShippingProcess" targetNamespace="http://example.com/bpmn">
  <bpmn:collaboration id="Collaboration_Shipping">
    <bpmn:participant id="Participant_ShippingProcess" name="Shipping Process" processRef="Process_Shipping"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Shipping" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Secretary" name="Secretary">
        <bpmn:flowNodeRef>StartEvent_GoodsToShip</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ClarifyShippingMethod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_LargeAmounts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InviteLogisticCompanies</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectCompany</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SpecialHandling</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_LogisticsHead" name="Logistics Department Head">
        <bpmn:flowNodeRef>Task_WritePackageLabel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_InsuranceNecessary</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TakeParcelInsurance</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Warehousemen" name="Warehousemen">
        <bpmn:flowNodeRef>Gateway_ParallelStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PackageGoods</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_LogisticsCompany" name="Logistic Company">
        <bpmn:flowNodeRef>Gateway_Convergence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareForPickup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ShipmentPrepared</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_GoodsToShip" name="Goods to be shipped">
      <bpmn:outgoing>SequenceFlow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Secretary clarifies shipping method -->
    <bpmn:userTask id="Task_ClarifyShippingMethod" name="Clarify who will do the shipping">
      <bpmn:incoming>SequenceFlow_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_02</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Decision: Large amounts? -->
    <bpmn:exclusiveGateway id="Gateway_LargeAmounts" name="Large amount of goods?">
      <bpmn:incoming>SequenceFlow_02</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_03</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_04</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Large amounts path - Special shipping -->
    <bpmn:userTask id="Task_InviteLogisticCompanies" name="Invite 3 logistic companies for offers">
      <bpmn:incoming>SequenceFlow_03</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_05</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_SelectCompany" name="Select one logistic company">
      <bpmn:incoming>SequenceFlow_05</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_06</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Small amounts path - Normal post shipment -->
    <bpmn:userTask id="Task_WritePackageLabel" name="Write package label">
      <bpmn:incoming>SequenceFlow_04</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_07</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel Gateway for concurrent activities -->
    <bpmn:parallelGateway id="Gateway_ParallelStart">
      <bpmn:incoming>SequenceFlow_06</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_08</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Insurance decision -->
    <bpmn:exclusiveGateway id="Gateway_SpecialHandling" name="Special handling necessary?">
      <bpmn:incoming>SequenceFlow_06</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_09</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Insurance decision -->
    <bpmn:exclusiveGateway id="Gateway_InsuranceNecessary" name="Parcel insurance necessary?">
      <bpmn:incoming>SequenceFlow_07</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Take parcel insurance -->
    <bpmn:userTask id="Task_TakeParcelInsurance" name="Take parcel insurance">
      <bpmn:incoming>SequenceFlow_10</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_11</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Warehousemen package goods (parallel) -->
    <bpmn:task id="Task_PackageGoods" name="Package goods">
      <bpmn:incoming>SequenceFlow_08</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_12</bpmn:outgoing>
    </bpmn:task>

    <!-- Convergence gateway -->
    <bpmn:parallelGateway id="Gateway_Convergence">
      <bpmn:incoming>SequenceFlow_09</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_11</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_12</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_13</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Final preparation -->
    <bpmn:userTask id="Task_PrepareForPickup" name="Prepare for being picked up">
      <bpmn:incoming>SequenceFlow_13</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_14</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_ShipmentPrepared" name="Shipment prepared">
      <bpmn:incoming>SequenceFlow_14</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_01" sourceRef="StartEvent_GoodsToShip" targetRef="Task_ClarifyShippingMethod"/>
    <bpmn:sequenceFlow id="SequenceFlow_02" sourceRef="Task_ClarifyShippingMethod" targetRef="Gateway_LargeAmounts"/>

    <!-- Large amounts path -->
    <bpmn:sequenceFlow id="SequenceFlow_03" name="yes - large amount" sourceRef="Gateway_LargeAmounts" targetRef="Task_InviteLogisticCompanies"/>
    <bpmn:sequenceFlow id="SequenceFlow_05" sourceRef="Task_InviteLogisticCompanies" targetRef="Task_SelectCompany"/>

    <!-- Small amounts path -->
    <bpmn:sequenceFlow id="SequenceFlow_04" name="no - small amount" sourceRef="Gateway_LargeAmounts" targetRef="Task_WritePackageLabel"/>

    <!-- Parallel start for warehousemen -->
    <bpmn:sequenceFlow id="SequenceFlow_06" sourceRef="Task_SelectCompany" targetRef="Gateway_ParallelStart"/>
    <bpmn:sequenceFlow id="SequenceFlow_08" sourceRef="Gateway_ParallelStart" targetRef="Task_PackageGoods"/>

    <!-- Insurance decision -->
    <bpmn:sequenceFlow id="SequenceFlow_10" name="yes - insurance necessary" sourceRef="Gateway_InsuranceNecessary" targetRef="Task_TakeParcelInsurance"/>

    <!-- Convergence flows -->
    <bpmn:sequenceFlow id="SequenceFlow_09" sourceRef="Gateway_SpecialHandling" targetRef="Gateway_Convergence"/>
    <bpmn:sequenceFlow id="SequenceFlow_11" sourceRef="Task_TakeParcelInsurance" targetRef="Gateway_Convergence"/>
    <bpmn:sequenceFlow id="SequenceFlow_12" sourceRef="Task_PackageGoods" targetRef="Gateway_Convergence"/>

    <!-- Final flow -->
    <bpmn:sequenceFlow id="SequenceFlow_13" sourceRef="Gateway_Convergence" targetRef="Task_PrepareForPickup"/>
    <bpmn:sequenceFlow id="SequenceFlow_14" name="everything ready" sourceRef="Task_PrepareForPickup" targetRef="EndEvent_ShipmentPrepared"/>

  </bpmn:process>
</bpmn:definitions>