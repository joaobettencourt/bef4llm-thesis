<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_FarmingBot">
    <bpmn:participant id="Participant_Player" name="Player Bot System" processRef="Process_FarmingBot" />
  </bpmn:collaboration>

  <bpmn:process id="Process_FarmingBot" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Configuration" name="Configuration &amp; Setup">
        <bpmn:flowNodeRef>StartEvent_CreateBot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IdentifyResources</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Farming" name="Farming Operations">
        <bpmn:flowNodeRef>InclusiveGateway_StartFarming</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GatherResources_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GatherResources_2</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Completion" name="Completion &amp; Sharing">
        <bpmn:flowNodeRef>ExclusiveGateway_Finished</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BragToFriends</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendMaterials</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Updates" name="Update Management">
        <bpmn:flowNodeRef>InclusiveGateway_UpdateList</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateMaterials</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Disasters" name="Disaster Management">
        <bpmn:flowNodeRef>InclusiveGateway_NaturalDisaster</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecoverFromDisaster</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Tools" name="Tool Creation">
        <bpmn:flowNodeRef>InclusiveGateway_CreateTools</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CraftTools</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Events" name="Notifications">
        <bpmn:flowNodeRef>IntermediateEvent_MilestoneReached</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <startEvent id="StartEvent_CreateBot" name="Create Custom Farming Bot">
      <outgoing>SequenceFlow_IdentifyResources</outgoing>
    </startEvent>

    <!-- Task: Identify Resources (up to 10) -->
    <task id="Task_IdentifyResources" name="Identify resources needed">
      <incoming>SequenceFlow_IdentifyResources</incoming>
      <outgoing>SequenceFlow_10ParallelCheck</outgoing>
    </task>

    <!-- Parallel Gateway for up to 10 parallel resource collection -->
    <parallelGateway id="InclusiveGateway_10Resources">
      <incoming>SequenceFlow_10ParallelCheck</incoming>
      <outgoing>SequenceFlow_ResourcePath_1</outgoing>
      <outgoing>SequenceFlow_ResourcePath_2</outgoing>
      <outgoing>SequenceFlow_ToolCheckRequired</outgoing>
    </parallelGateway>

    <!-- Exclusive Gateway for Resource Dependencies -->
    <exclusiveGateway id="ExclusiveGateway_ResourceDependencies">
      <incoming>SequenceFlow_StartFarmingNo</incoming>
      <outgoing>SequenceFlow_CreateToolsYes</outgoing>
      <outgoing>SequenceFlow_ToolCheckRequired2</outgoing>
    </exclusiveGateway>

    <!-- Parallel Gateway for Starting Farming -->
    <parallelGateway id="InclusiveGateway_StartFarming">
      <incoming>SequenceFlow_FarmResource_1</incoming>
      <incoming>SequenceFlow_FarmResource_2</incoming>
      <outgoing>SequenceFlow_MilestoneCheck_A</outgoing>
    </parallelGateway>

    <!-- Task: Gather Resources (Example 3 parallel tasks) -->
    <task id="Task_GatherResources_1" name="Gather Resource Type A">
      <incoming>SequenceFlow_FarmResource_1</incoming>
      <outgoing>SequenceFlow_MilestoneCheck_A</outgoing>
    </task>

    <task id="Task_GatherResources_2" name="Gather Resource Type B">
      <incoming>SequenceFlow_FarmResource_2</incoming>
      <outgoing>SequenceFlow_MilestoneCheck_B</outgoing>
    </task>

    <!-- Inclusive Gateway for Milestone Notifications -->
    <inclusiveGateway id="InclusiveGateway_Milestones">
      <incoming>SequenceFlow_MilestoneCheck_A</incoming>
      <incoming>SequenceFlow_MilestoneCheck_B</incoming>
      <outgoing>SequenceFlow_NotifyMilestone</outgoing>
    </inclusiveGateway>

    <!-- Intermediate Event: Milestone Reached -->
    <intermediateCatchEvent id="IntermediateEvent_MilestoneReached" name="Milestone Notification">
      <bpmn:messageEventDefinition />
      <incoming>SequenceFlow_NotifyMilestone</incoming>
      <outgoing>SequenceFlow_ContinueFarming</outgoing>
    </intermediateCatchEvent>

    <!-- Exclusive Gateway for Natural Disaster Check -->
    <exclusiveGateway id="InclusiveGateway_NaturalDisaster">
      <incoming>SequenceFlow_DisasterCheck</incoming>
      <outgoing>SequenceFlow_NoDisaster</outgoing>
      <outgoing>SequenceFlow_YesDisaster</outgoing>
    </exclusiveGateway>

    <!-- Task: Recover from Disaster -->
    <task id="Task_RecoverFromDisaster" name="Recover from Natural Disaster">
      <incoming>SequenceFlow_YesDisaster</incoming>
      <outgoing>SequenceFlow_ResumedFarming</outgoing>
    </task>

    <!-- Exclusive Gateway for Update List -->
    <inclusiveGateway id="InclusiveGateway_UpdateList">
      <incoming>SequenceFlow_CheckUpdateNeeded</incoming>
      <outgoing>SequenceFlow_YesUpdate</outgoing>
      <outgoing>SequenceFlow_NoUpdateContinue</outgoing>
    </inclusiveGateway>

    <!-- Task: Update Materials List -->
    <task id="Task_UpdateMaterials" name="Update Farming Materials">
      <incoming>SequenceFlow_YesUpdate</incoming>
      <outgoing>SequenceFlow_ResumedFarmingAfterUpdate</outgoing>
    </task>

    <!-- Exclusive Gateway for Tool Creation Check -->
    <inclusiveGateway id="InclusiveGateway_CreateTools">
      <incoming>SequenceFlow_ToolCheckRequired</incoming>
      <outgoing>SequenceFlow_CraftYes</outgoing>
      <outgoing>SequenceFlow_StartFarmingNo</outgoing>
    </inclusiveGateway>

    <!-- Task: Craft Tools -->
    <task id="Task_CraftTools" name="Craft Required Tools">
      <incoming>SequenceFlow_CraftYes</incoming>
      <outgoing>SequenceFlow_ToolCheckRequired2</outgoing>
    </task>

    <!-- Exclusive Gateway for Finished Check -->
    <exclusiveGateway id="ExclusiveGateway_Finished">
      <incoming>SequenceFlow_AllResourcesCollected</incoming>
      <outgoing>SequenceFlow_BragToFriends</outgoing>
      <outgoing>SequenceFlow_SendMaterials</outgoing>
    </exclusiveGateway>

    <!-- Task: Brag to Friends -->
    <task id="Task_BragToFriends" name="Brag to Selected Friends">
      <incoming>SequenceFlow_BragToFriends</incoming>
      <outgoing>SequenceFlow_EndProcess</outgoing>
    </task>

    <!-- Task: Send Materials -->
    <task id="Task_SendMaterials" name="Send Materials to Friends">
      <incoming>SequenceFlow_SendMaterials</incoming>
      <outgoing>SequenceFlow_EndProcess2</outgoing>
    </task>

    <!-- End Event -->
    <endEvent id="EndEvent_BotFinished" name="Bot Finished - All Done!">
      <incoming>SequenceFlow_EndProcess</incoming>
      <incoming>SequenceFlow_EndProcess2</incoming>
    </endEvent>

    <!-- Sequence Flows -->
    <sequenceFlow id="SequenceFlow_IdentifyResources" sourceRef="StartEvent_CreateBot" targetRef="Task_IdentifyResources" />
    <sequenceFlow id="SequenceFlow_10ParallelCheck" name="Up to 10 resources in parallel" sourceRef="InclusiveGateway_10Resources" targetRef="ExclusiveGateway_ResourceDependencies" />

    <!-- Resource Path Flows (3 examples of up to 10) -->
    <sequenceFlow id="SequenceFlow_ToolCheckRequired" sourceRef="Task_IdentifyResources" targetRef="InclusiveGateway_CreateTools" />
    <sequenceFlow id="SequenceFlow_CraftYes" name="Create tools required?" sourceRef="InclusiveGateway_CreateTools" targetRef="Task_CraftTools" />

    <!-- Farming Flows -->
    <sequenceFlow id="SequenceFlow_StartFarmingNo" name="Start farming without new tools" sourceRef="ExclusiveGateway_ResourceDependencies" targetRef="InclusiveGateway_StartFarming" />
    <sequenceFlow id="SequenceFlow_ToolCheckRequired2" name="Tools ready, start farming" sourceRef="Task_CraftTools" targetRef="InclusiveGateway_StartFarming" />

    <!-- Parallel Farming Tasks -->
    <sequenceFlow id="SequenceFlow_FarmResource_1" sourceRef="InclusiveGateway_StartFarming" targetRef="Task_GatherResources_1" />
    <sequenceFlow id="SequenceFlow_FarmResource_2" sourceRef="InclusiveGateway_StartFarming" targetRef="Task_GatherResources_2" />

    <!-- Milestone Flows -->
    <sequenceFlow id="SequenceFlow_MilestoneCheck_A" name="Milestone A reached?" sourceRef="Task_GatherResources_1" targetRef="InclusiveGateway_Milestones" />
    <sequenceFlow id="SequenceFlow_MilestoneCheck_B" name="Milestone B reached?" sourceRef="Task_GatherResources_2" targetRef="InclusiveGateway_Milestones" />

    <!-- Notification Flow -->
    <sequenceFlow id="SequenceFlow_NotifyMilestone" sourceRef="InclusiveGateway_Milestones" targetRef="IntermediateEvent_MilestoneReached" />
    <sequenceFlow id="SequenceFlow_ContinueFarming" name="Notify milestone &amp; continue farming" sourceRef="IntermediateEvent_MilestoneReached" targetRef="ExclusiveGateway_Finished" />

    <!-- Disaster Check Flow -->
    <sequenceFlow id="SequenceFlow_DisasterCheck" name="Natural disaster occurred?" sourceRef="InclusiveGateway_StartFarming" targetRef="InclusiveGateway_NaturalDisaster" />
    <sequenceFlow id="SequenceFlow_NoDisaster" name="No disaster, continue farming" sourceRef="InclusiveGateway_NaturalDisaster" targetRef="Task_GatherResources_1" />
    <sequenceFlow id="SequenceFlow_YesDisaster" name="Disaster occurred!" sourceRef="InclusiveGateway_NaturalDisaster" targetRef="Task_RecoverFromDisaster" />

    <!-- Update List Flow -->
    <sequenceFlow id="SequenceFlow_CheckUpdateNeeded" name="Check for updates needed?" sourceRef="ExclusiveGateway_Finished" targetRef="InclusiveGateway_UpdateList" />
    <sequenceFlow id="SequenceFlow_YesUpdate" name="Update materials list" sourceRef="InclusiveGateway_UpdateList" targetRef="Task_UpdateMaterials" />
    <sequenceFlow id="SequenceFlow_NoUpdateContinue" name="No updates needed, finish farming" sourceRef="InclusiveGateway_UpdateList" targetRef="ExclusiveGateway_Finished" />

    <!-- Recovery Flow -->
    <sequenceFlow id="SequenceFlow_ResumedFarming" name="Resume after recovery/update" sourceRef="Task_RecoverFromDisaster" targetRef="ExclusiveGateway_Finished" />
    <sequenceFlow id="SequenceFlow_ResumedFarmingAfterUpdate" name="Resumed farming after update" sourceRef="Task_UpdateMaterials" targetRef="ExclusiveGateway_Finished" />

    <!-- Finished Check Flow -->
    <sequenceFlow id="SequenceFlow_AllResourcesCollected" name="All resources collected?" sourceRef="InclusiveGateway_StartFarming" targetRef="ExclusiveGateway_Finished" />

    <!-- Completion Flows (OR logic) -->
    <sequenceFlow id="SequenceFlow_BragToFriends" name="Brag to friends OR send materials" sourceRef="ExclusiveGateway_Finished" targetRef="Task_BragToFriends" />
    <sequenceFlow id="SequenceFlow_SendMaterials" name="Send materials to friends" sourceRef="ExclusiveGateway_Finished" targetRef="Task_SendMaterials" />

    <!-- End Flow -->
    <sequenceFlow id="SequenceFlow_EndProcess" sourceRef="Task_BragToFriends" targetRef="EndEvent_BotFinished" />
    <sequenceFlow id="SequenceFlow_EndProcess2" name="Send materials &amp; finish" sourceRef="Task_SendMaterials" targetRef="EndEvent_BotFinished" />

  </bpmn:process>
</bpmn:definitions>