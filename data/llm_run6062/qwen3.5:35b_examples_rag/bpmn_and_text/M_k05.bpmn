<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                 xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                 xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                 xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" 
                 id="Definitions_BuildingHouse_1" targetNamespace="http://bpmn.io/schema/bpmn">

  <collaboration id="Collab_HouseBuilding_1">
    <participant id="Participant_Homeowner_1" name="Homeowner"/>
    <participant id="Participant_Architect_1" name="Tree House Architect"/>
    
    <!-- Message Flows -->
    <messageFlow id="Msg_SendRequirements_1" sourceRef="Task_SendToArchitect_1" targetRef="Receive_DraftFromArchitect_2">
      <bpmn:name>Send requirements</bpmn:name>
    </messageFlow>
    
    <messageFlow id="Msg_SendInvitations_1" sourceRef="Task_SendInvitationsFriends_1" targetRef="Participant_Friends_3">
      <bpmn:name>Send invitations</bpmn:name>
    </messageFlow>
  </collaboration>

  <process id="Process_BuildingHouse_1" isExecutable="false">
    
    <!-- Lane Set -->
    <laneSet id="LaneSet_Homeowner_1">
      <lane id="Lane_Homeowner_1" name="Homeowner">
        <flowNodeRef>StartEvent_CollectRequirements_1</flowNodeRef>
        <flowNodeRef>Task_SendToArchitect_1</flowNodeRef>
        <flowNodeRef>Receive_DraftFromArchitect_2</flowNodeRef>
        <flowNodeRef>Gateway_RefinePlanDecision_1</flowNodeRef>
        <flowNodeRef>Task_CreateMaterialsList_1</flowNodeRef>
        <flowNodeRef>ParallelGateway_OrderAndInvite_1</flowNodeRef>
        <flowNodeRef>Task_SendInvitationsFriends_1</flowNodeRef>
        <flowNodeRef>CreateGuestListSnacks_1</flowNodeRef>
      </lane>
    </laneSet>

    <!-- Start Event -->
    <startEvent id="StartEvent_CollectRequirements_1" name="Collect requirements">
      <bpmn:outgoing>SequenceFlow_SendToArchitect_1</bpmn:outgoing>
    </startEvent>

    <!-- Task: Send Requirements to Architect -->
    <task id="Task_SendToArchitect_1" name="Send requirements to architect">
      <incoming>SequenceFlow_SendToArchitect_1</incoming>
      <outgoing>SequenceFlow_AwaitDraft_1</outgoing>
    </task>

    <!-- Receive Task: Draft from Architect (External) -->
    <receiveTask id="Receive_DraftFromArchitect_2" name="Receive draft plan">
      <bpmn:name>Receive draft plan</bpmn:name>
      <incoming>SequenceFlow_AwaitDraft_1</incoming>
      <outgoing>SequenceFlow_DecideRefinement_1</outgoing>
    </receiveTask>

    <!-- Exclusive Gateway: Refine Plan? -->
    <exclusiveGateway id="Gateway_RefinePlanDecision_1" name="Need refinement?">
      <bpmn:name>Need refinement?</bpmn:name>
      <incoming>SequenceFlow_DecideRefinement_1</incoming>
      <outgoing>SequenceFlow_YesRefine_1</outgoing>
      <outgoing>SequenceFlow_NoProceedMaterials_1</outgoing>
    </exclusiveGateway>

    <!-- Task: Refine Plan (Loop back) -->
    <task id="Task_RefinePlan_1" name="Add additional requirements">
      <incoming>SequenceFlow_YesRefine_1</incoming>
      <outgoing>SequenceFlow_SendBackToArchitect_1</outgoing>
    </task>

    <!-- Task: Create Materials List -->
    <task id="Task_CreateMaterialsList_1" name="Create materials list from plan">
      <bpmn:name>Create materials list from plan</bpmn:name>
      <incoming>SequenceFlow_NoProceedMaterials_1</incoming>
      <outgoing>SequenceFlow_SplitOrderInvite_1</outgoing>
    </task>

    <!-- Parallel Gateway: Split to Order Materials and Invite Friends -->
    <parallelGateway id="ParallelGateway_OrderAndInvite_1" name="">
      <bpmn:name></bpmn:name>
      <incoming>SequenceFlow_SplitOrderInvite_1</incoming>
      <outgoing>SequenceFlow_OrderMaterials_1</outgoing>
      <outgoing>SequenceFlow_SendInvitationsFriendsTask_1</outgoing>
    </parallelGateway>

    <!-- Task: Order Materials (Parallel) -->
    <task id="Task_OrderMaterials_1" name="Order materials from online stores">
      <bpmn:name>Order materials from online stores</bpmn:name>
      <incoming>SequenceFlow_OrderMaterials_1</incoming>
      <outgoing>SequenceFlow_MaterialsOrdered_1</outgoing>
    </task>

    <!-- Task: Send Invitations to Friends -->
    <sendTask id="Task_SendInvitationsFriends_1" name="Send invitations for tree house party">
      <bpmn:name>Send invitations for tree house party</bpmn:name>
      <incoming>SequenceFlow_SendInvitationsFriendsTask_1</incoming>
      <outgoing>SequenceFlow_AwaitHouseBuiltEvent_1</outgoing>
    </sendTask>

    <!-- Intermediate Catch Event: House Built -->
    <intermediateCatchEvent id="IntermediateEvent_HouseBuilt_1" name="Tree house built">
      <bpmn:name>Tree house built</bpmn:name>
      <incoming>SequenceFlow_AwaitHouseBuiltEvent_1</incoming>
      <outgoing>SequenceFlow_CreateGuestListSnacksTask_1</outgoing>
    </intermediateCatchEvent>

    <!-- Task: Create Guest List for Snacks -->
    <task id="CreateGuestListSnacks_1" name="Create list of people attending party">
      <bpmn:name>Create guest list for snacks</bpmn:name>
      <incoming>SequenceFlow_CreateGuestListSnacksTask_1</incoming>
      <outgoing>SequenceFlow_EndProcess_1</outgoing>
    </task>

    <!-- End Event -->
    <endEvent id="EndEvent_ProcessComplete_1" name="Party preparations complete">
      <bpmn:name>Party preparations complete</bpmn:name>
      <incoming>SequenceFlow_EndProcess_1</incoming>
    </endEvent>

    <!-- Sequence Flows -->
    <sequenceFlow id="SequenceFlow_SendToArchitect_1" sourceRef="StartEvent_CollectRequirements_1" targetRef="Task_SendToArchitect_1"/>
    
    <sequenceFlow id="SequenceFlow_AwaitDraft_1" name="" sourceRef="Task_SendToArchitect_1" targetRef="Receive_DraftFromArchitect_2">
      <bpmn:name></bpmn:name>
    </sequenceFlow>

    <sequenceFlow id="SequenceFlow_DecideRefinement_1" name="" sourceRef="Receive_DraftFromArchitect_2" targetRef="Gateway_RefinePlanDecision_1"/>
    
    <sequenceFlow id="SequenceFlow_YesRefine_1" name="yes - refine plan" sourceRef="Gateway_RefinePlanDecision_1" targetRef="Task_RefinePlan_1">
      <bpmn:name>yes</bpmn:name>
    </sequenceFlow>

    <sequenceFlow id="SequenceFlow_SendBackToArchitect_1" name="" sourceRef="Task_RefinePlan_1" targetRef="Receive_DraftFromArchitect_2"/>
    
    <sequenceFlow id="SequenceFlow_NoProceedMaterials_1" name="no - proceed to materials list" sourceRef="Gateway_RefinePlanDecision_1" targetRef="Task_CreateMaterialsList_1">
      <bpmn:name>no</bpmn:name>
    </sequenceFlow>

    <sequenceFlow id="SequenceFlow_SplitOrderInvite_1" name="" sourceRef="Task_CreateMaterialsList_1" targetRef="ParallelGateway_OrderAndInvite_1"/>
    
    <sequenceFlow id="SequenceFlow_OrderMaterials_1" name="" sourceRef="ParallelGateway_OrderAndInvite_1" targetRef="Task_OrderMaterials_1">
      <bpmn:name></bpmn:name>
    </sequenceFlow>

    <sequenceFlow id="SequenceFlow_SendInvitationsFriendsTask_1" name="" sourceRef="ParallelGateway_OrderAndInvite_1" targetRef="Task_SendInvitationsFriends_1"/>
    
    <sequenceFlow id="SequenceFlow_MaterialsOrdered_1" name="" sourceRef="Task_OrderMaterials_1" targetRef="IntermediateEvent_HouseBuilt_1">
      <bpmn:name></bpmn:name>
    </sequenceFlow>

    <sequenceFlow id="SequenceFlow_AwaitHouseBuiltEvent_1" name="" sourceRef="Task_SendInvitationsFriends_1" targetRef="IntermediateEvent_HouseBuilt_1"/>
    
    <sequenceFlow id="SequenceFlow_CreateGuestListSnacksTask_1" name="" sourceRef="IntermediateEvent_HouseBuilt_1" targetRef="CreateGuestListSnacks_1">
      <bpmn:name></bpmn:name>
    </sequenceFlow>

    <sequenceFlow id="SequenceFlow_EndProcess_1" name="" sourceRef="CreateGuestListSnacks_1" targetRef="EndEvent_ProcessComplete_1"/>
    
  </process>

</bpmn:definitions>