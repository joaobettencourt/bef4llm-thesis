<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_InspectionMachine" targetNamespace="http://bpmn.io/schema/bpmn">
  <process id="Process_MachineInspection" isExecutable="false">
    <!-- Start Event -->
    <startEvent id="StartEvent_EnterInfo" name="Enter machine type and serial number">
      <outgoing>SequenceFlow_StartToInput</outgoing>
    </startEvent>

    <!-- User Task: Input values for questions -->
    <userTask id="UserTask_InputQuestions" name="Answer inspection questions">
      <incoming>SequenceFlow_StartToInput</incoming>
      <outgoing>SequenceFlow_QuestionsToCollectData</outgoing>
    </userTask>

    <!-- Service Task: Collect data automatically from machine -->
    <serviceTask id="ServiceTask_CollectMachineData" name="Collect values from machine">
      <incoming>SequenceFlow_QuestionsToCollectData</incoming>
      <outgoing>SequenceFlow_DataToDecisionGateway</outgoing>
    </serviceTask>

    <!-- Exclusive Gateway: Decision based on results -->
    <exclusiveGateway id="ExclusiveGateway_CheckAdditionalQuestions" name="Are additional questions needed?">
      <incoming>SequenceFlow_DataToDecisionGateway</incoming>
      <outgoing>SequenceFlow_YesMoreQuestions</outgoing>
      <outgoing>SequenceFlow_NoContinueInspection</outgoing>
    </exclusiveGateway>

    <!-- User Task: Additional inspection questions if needed -->
    <userTask id="UserTask_AdditionalQuestions" name="Answer additional questions">
      <incoming>SequenceFlow_YesMoreQuestions</incoming>
      <outgoing>SequenceFlow_MoreDataToCollect</outgoing>
    </userTask>

    <!-- Service Task: Collect more data if needed -->
    <serviceTask id="ServiceTask_CollectAdditionalMachineData" name="Collect additional values from machine">
      <incoming>SequenceFlow_MoreDataToCollect</incoming>
      <outgoing>SequenceFlow_AdditionalDataBackToGateway</outgoing>
    </serviceTask>

    <!-- End Event: Inspection completed -->
    <endEvent id="EndEvent_InspectionComplete" name="Inspection complete">
      <incoming>SequenceFlow_NoContinueInspection</incoming>
    </endEvent>

    <!-- Sequence Flows -->
    <sequenceFlow id="SequenceFlow_StartToInput" sourceRef="StartEvent_EnterInfo" targetRef="UserTask_InputQuestions"/>
    
    <sequenceFlow id="SequenceFlow_QuestionsToCollectData" sourceRef="UserTask_InputQuestions" targetRef="ServiceTask_CollectMachineData"/>
    
    <sequenceFlow id="SequenceFlow_DataToDecisionGateway" sourceRef="ServiceTask_CollectMachineData" targetRef="ExclusiveGateway_CheckAdditionalQuestions"/>
    
    <sequenceFlow id="SequenceFlow_YesMoreQuestions" name="Yes - More questions needed" sourceRef="ExclusiveGateway_CheckAdditionalQuestions" targetRef="UserTask_AdditionalQuestions"/>
    
    <sequenceFlow id="SequenceFlow_NoContinueInspection" name="No - Continue to end" default="true" sourceRef="ExclusiveGateway_CheckAdditionalQuestions" targetRef="EndEvent_InspectionComplete"/>
    
    <sequenceFlow id="SequenceFlow_MoreDataToCollect" sourceRef="UserTask_AdditionalQuestions" targetRef="ServiceTask_CollectAdditionalMachineData"/>
    
    <sequenceFlow id="SequenceFlow_AdditionalDataBackToGateway" name="Return to decision gateway" sourceRef="ServiceTask_CollectAdditionalMachineData" targetRef="ExclusiveGateway_CheckAdditionalQuestions"/>

  </process>
</bpmn:definitions>