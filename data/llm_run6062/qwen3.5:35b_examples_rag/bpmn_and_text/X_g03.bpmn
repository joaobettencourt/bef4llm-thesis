<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_ViennaNightRun" targetNamespace="http://bpmn.io/schema/bpmn">
  <process id="ViennaNightRunProcess" isExecutable="false">

    <!-- Start Event -->
    <startEvent id="Start_Event_Participate" name="Participate in Vienna Night Run">
      <outgoing>SequenceFlow_SelectStartingBlock</outgoing>
    </startEvent>

    <!-- Task: Select starting block (user input) -->
    <task id="Task_SelectStartingBlock" name="Select starting block">
      <incoming>SequenceFlow_SelectStartingBlock</incoming>
      <outgoing>SequenceFlow_StartRun</outgoing>
    </task>

    <!-- Parallel Gateway for Run and Drink activities during the race -->
    <parallelGateway id="ParallelGateway_RunDrink_Diverge" gatewayDirection="Diverging">
      <incoming>SequenceFlow_StartRun</incoming>
      <outgoing>SequenceFlow_ActivityRunning</outgoing>
      <outgoing>SequenceFlow_ActivityDrinking</outgoing>
    </parallelGateway>

    <!-- Task: Running (fitness gadget measures time) -->
    <task id="Task_Running" name="Run 5km">
      <incoming>SequenceFlow_ActivityRunning</incoming>
      <outgoing>SequenceFlow_MeasureTime</outgoing>
    </task>

    <!-- User Task: Drinking during run (parallel activity) -->
    <userTask id="UserTask_Drinking" name="Drink while running">
      <incoming>SequenceFlow_ActivityDrinking</incoming>
      <outgoing>SequenceFlow_MeasureTimeParallel</outgoing>
    </userTask>

    <!-- Parallel Gateway to converge run and drink activities -->
    <parallelGateway id="ParallelGateway_Converge" gatewayDirection="Converging">
      <incoming>SequenceFlow_MeasureTime</incoming>
      <incoming>SequenceFlow_MeasureTimeParallel</incoming>
      <outgoing>SequenceFlow_CheckTimeResult</outgoing>
    </parallelGateway>

    <!-- Exclusive Gateway: Check if time is less than 25 minutes -->
    <exclusiveGateway id="ExclusiveGateway_TimeCheck" name="Achieved &lt; 25 min?">
      <incoming>SequenceFlow_CheckTimeResult</incoming>
      <outgoing>SequenceFlow_GetStartingNumber</outgoing>
      <outgoing>SequenceFlow_TrainAgain</outgoing>
    </exclusiveGateway>

    <!-- Task: Get starting number (after achieving goal) -->
    <task id="Task_GetStartingNumber" name="Get starting number">
      <incoming>SequenceFlow_GetStartingNumber</incoming>
      <outgoing>SequenceFlow_DecideTransportation</outgoing>
    </task>

    <!-- Exclusive Gateway: Decide transportation based on work day end time -->
    <exclusiveGateway id="ExclusiveGateway_Transport" name="More than 1 hour before start?">
      <incoming>SequenceFlow_DecideTransportation</incoming>
      <outgoing>SequenceFlow_GoFromHome</outgoing>
      <outgoing>SequenceFlow_LeaveFromWork</outgoing>
    </exclusiveGateway>

    <!-- Task: Go from home (if more than 1 hour left) -->
    <task id="Task_GoFromHome" name="Go to race from home">
      <incoming>SequenceFlow_GoFromHome</incoming>
      <outgoing>SequenceFlow_RaceStartEvent</outgoing>
    </task>

    <!-- Task: Leave directly from work (if less than 1 hour left) -->
    <userTask id="UserTask_LeaveWork" name="Leave race preparation at work">
      <incoming>SequenceFlow_LeaveFromWork</incoming>
      <outgoing>SequenceFlow_RaceStartEvent</outgoing>
    </userTask>

    <!-- Parallel Gateway for Race Start (converge both paths) -->
    <parallelGateway id="ParallelGateway_StartRace" gatewayDirection="Converging">
      <incoming>SequenceFlow_GoFromHome</incoming>
      <incoming>SequenceFlow_LeaveFromWork</incoming>
      <outgoing>SequenceFlow_RaceStartEvent2</outgoing>
    </parallelGateway>

    <!-- Task: Race Start (run and drink activities happen here) -->
    <task id="Task_StartRace" name="Run the Vienna Night Run">
      <incoming>SequenceFlow_RaceStartEvent</incoming>
      <incoming>SequenceFlow_RaceStartEvent2</incoming>
      <outgoing>SequenceFlow_FinalTimeReceived</outgoing>
    </task>

    <!-- End Event: Receive final running time -->
    <endEvent id="End_Event_Finish" name="Receive final running time">
      <incoming>SequenceFlow_FinalTimeReceived</incoming>
    </endEvent>

    <!-- Sequence Flows -->
    
    <!-- Initial flow from start to selecting starting block -->
    <sequenceFlow id="SequenceFlow_SelectStartingBlock" sourceRef="Start_Event_Participate" targetRef="Task_SelectStartingBlock">
      <bpmn:name>Select Starting Block</bpmn:name>
    </sequenceFlow>

    <!-- Flow to run activities (diverges into running and drinking) -->
    <sequenceFlow id="SequenceFlow_StartRun" sourceRef="Task_SelectStartingBlock" targetRef="ParallelGateway_RunDrink_Diverge">
      <bpmn:name>Start Run</bpmn:name>
    </sequenceFlow>

    <!-- Running activity flow -->
    <sequenceFlow id="SequenceFlow_ActivityRunning" sourceRef="ParallelGateway_RunDrink_Diverge" targetRef="Task_Running">
      <bpmn:name>Run 5km</bpmn:name>
    </sequenceFlow>

    <!-- Drinking parallel activity -->
    <sequenceFlow id="SequenceFlow_ActivityDrinking" sourceRef="ParallelGateway_RunDrink_Diverge" targetRef="UserTask_Drinking">
      <bpmn:name>Drink while running</bpmn:name>
    </sequenceFlow>

    <!-- Convergence of run and drink activities -->
    <sequenceFlow id="SequenceFlow_MeasureTime" sourceRef="Task_Running" targetRef="ParallelGateway_Converge">
      <bpmn:name>Measure time (fitness gadget)</bpmn:name>
    </sequenceFlow>

    <!-- Convergence of drinking activity -->
    <sequenceFlow id="SequenceFlow_MeasureTimeParallel" sourceRef="UserTask_Drinking" targetRef="ParallelGateway_Converge">
      <bpmn:name>Drink completed</bpmn:name>
    </sequenceFlow>

    <!-- Flow to time check decision gateway -->
    <sequenceFlow id="SequenceFlow_CheckTimeResult" sourceRef="ParallelGateway_Converge" targetRef="ExclusiveGateway_TimeCheck">
      <bpmn:name>Check Time Result</bpmn:name>
    </sequenceFlow>

    <!-- Success path: Got starting number (time &lt; 25 min) -->
    <sequenceFlow id="SequenceFlow_GetStartingNumber" sourceRef="ExclusiveGateway_TimeCheck" targetRef="Task_GetStartingNumber">
      <bpmn:name>Achieved goal</bpmn:name>
    </sequenceFlow>

    <!-- Loop back: Need to train again (time &gt;= 25 min) -->
    <sequenceFlow id="SequenceFlow_TrainAgain" sourceRef="ExclusiveGateway_TimeCheck" targetRef="Task_Running">
      <bpmn:name>Train and check</bpmn:name>
    </sequenceFlow>

    <!-- Flow to transportation decision gateway -->
    <sequenceFlow id="SequenceFlow_DecideTransportation" sourceRef="Task_GetStartingNumber" targetRef="ExclusiveGateway_Transport">
      <bpmn:name>Determine transport method</bpmn:name>
    </sequenceFlow>

    <!-- Go from home path (more than 1 hour before start) -->
    <sequenceFlow id="SequenceFlow_GoFromHome" sourceRef="ExclusiveGateway_Transport" targetRef="Task_StartRace">
      <bpmn:name>Go from home</bpmn:name>
    </sequenceFlow>

    <!-- Leave directly from work path (less than 1 hour before start) -->
    <sequenceFlow id="SequenceFlow_LeaveFromWork" sourceRef="ExclusiveGateway_Transport" targetRef="UserTask_LeaveWork">
      <bpmn:name>Leave from work</bpmn:name>
    </sequenceFlow>

    <!-- Flow to race start parallel gateway convergence -->
    <sequenceFlow id="SequenceFlow_RaceStartEvent" sourceRef="ParallelGateway_StartRace" targetRef="Task_StartRace">
      <bpmn:name>Race Start Path 1</bpmn:name>
    </sequenceFlow>

    <!-- Flow to race start parallel gateway convergence -->
    <sequenceFlow id="SequenceFlow_RaceStartEvent2" sourceRef="ParallelGateway_StartRace" targetRef="Task_StartRace">
      <bpmn:name>Race Start Path 2</bpmn:name>
    </sequenceFlow>

    <!-- Final flow: Receive final running time at end event -->
    <sequenceFlow id="SequenceFlow_FinalTimeReceived" sourceRef="Task_StartRace" targetRef="End_Event_Finish">
      <bpmn:name>Receive final time</bpmn:name>
    </sequenceFlow>

  </process>
</bpmn:definitions>