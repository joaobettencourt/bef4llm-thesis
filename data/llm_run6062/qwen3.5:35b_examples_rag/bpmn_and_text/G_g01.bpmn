<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_LANParty" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Organizer" name="LAN Party Organizer" processRef="Process_LANParty"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_LANParty" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="Start_1">
      <bpmn:name>Plan LAN Party</bpmn:name>
      <bpmn:outgoing>Sequence_SendInvites</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1 -->
    <bpmn:task id="Task_SendInvites">
      <bpmn:name>Send invitations to 10 friends</bpmn:name>
      <bpmn:incoming>Sequence_SendInvites</bpmn:incoming>
      <bpmn:outgoing>Sequence_GetGamesList</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2 -->
    <bpmn:task id="Task_GetGamesList">
      <bpmn:name>Find out which games they want to play</bpmn:name>
      <bpmn:incoming>Sequence_GetGamesList</bpmn:incoming>
      <bpmn:outgoing>Sequence_SplitParallel</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway -->
    <bpmn:parallelGateway id="Gateway_ParallelSplit">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>Sequence_SplitParallel</bpmn:incoming>
      <bpmn:outgoing>Sequence_AppointDate</bpmn:outgoing>
      <bpmn:outgoing>Sequence_CheckGames</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 3 - Date Appointment -->
    <bpmn:task id="Task_AppointDate">
      <bpmn:name>Appoint a date</bpmn:name>
      <bpmn:incoming>Sequence_AppointDate</bpmn:incoming>
      <bpmn:outgoing>Sequence_CheckAgreement</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway - Agreement Check -->
    <bpmn:exclusiveGateway id="Gateway_AgreementCheck">
      <bpmn:name>8+ agree?</bpmn:name>
      <bpmn:incoming>Sequence_CheckAgreement</bpmn:incoming>
      <bpmn:outgoing>Sequence_ContinueDate</bpmn:outgoing>
      <bpmn:outgoing>Sequence_AppointAgain</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flow - Loop Back -->
    <bpmn:sequenceFlow id="Sequence_AppointAgain">
      <bpmn:name>No, appoint another date</bpmn:name>
      <bpmn:sourceRef>Gateway_AgreementCheck</bpmn:sourceRef>
      <bpmn:targetRef>Task_AppointDate</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Task 4 - Check Games -->
    <bpmn:task id="Task_CheckGames">
      <bpmn:name>Find out if you have all games</bpmn:name>
      <bpmn:incoming>Sequence_CheckGames</bpmn:incoming>
      <bpmn:outgoing>Sequence_GamesDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway - Missing Games -->
    <bpmn:exclusiveGateway id="Gateway_MissingGames">
      <bpmn:name>Some missing?</bpmn:name>
      <bpmn:incoming>Sequence_GamesDecision</bpmn:incoming>
      <bpmn:outgoing>Sequence_DownloadMissing</bpmn:outgoing>
      <bpmn:outgoing>Sequence_JoinGames</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 5 - Download Games -->
    <bpmn:task id="Task_Download">
      <bpmn:name>Download missing games</bpmn:name>
      <bpmn:incoming>Sequence_DownloadMissing</bpmn:incoming>
      <bpmn:outgoing>Sequence_JoinGames</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway - Join -->
    <bpmn:parallelGateway id="Gateway_ParallelJoin">
      <bpmn:name></bpmn:name>
      <bpmn:incoming>Sequence_ContinueDate</bpmn:incoming>
      <bpmn:incoming>Sequence_JoinGames</bpmn:incoming>
      <bpmn:outgoing>Sequence_CalculateBeer</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 6 - Beer Needs -->
    <bpmn:task id="Task_BeerNeeds">
      <bpmn:name>Find out how much beer is required</bpmn:name>
      <bpmn:incoming>Sequence_CalculateBeer</bpmn:incoming>
      <bpmn:outgoing>Sequence_EnoughBeerCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway - Beer Stock -->
    <bpmn:exclusiveGateway id="Gateway_BeerStock">
      <bpmn:name>Have enough beer?</bpmn:name>
      <bpmn:incoming>Sequence_EnoughBeerCheck</bpmn:incoming>
      <bpmn:outgoing>Sequence_BuyMissing</bpmn:outgoing>
      <bpmn:outgoing>Sequence_JoinEnd</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 7 - Buy Beer -->
    <bpmn:task id="Task_BuyBeer">
      <bpmn:name>Buy what's missing</bpmn:name>
      <bpmn:incoming>Sequence_BuyMissing</bpmn:incoming>
      <bpmn:outgoing>Sequence_JoinEnd</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="End_EnjoyParty">
      <bpmn:name>Enjoy the LAN Party</bpmn:name>
      <bpmn:incoming>Sequence_JoinEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Sequence_SendInvites">
      <bpmn:sourceRef>Start_1</bpmn:sourceRef>
      <bpmn:targetRef>Task_SendInvites</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Sequence_GetGamesList">
      <bpmn:sourceRef>Task_SendInvites</bpmn:sourceRef>
      <bpmn:targetRef>Task_GetGamesList</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Sequence_SplitParallel">
      <bpmn:sourceRef>Task_GetGamesList</bpmn:sourceRef>
      <bpmn:targetRef>Gateway_ParallelSplit</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Sequence_AppointDate">
      <bpmn:name></bpmn:name>
      <bpmn:sourceRef>Gateway_ParallelSplit</bpmn:sourceRef>
      <bpmn:targetRef>Task_AppointDate</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Sequence_CheckGames">
      <bpmn:name></bpmn:name>
      <bpmn:sourceRef>Gateway_ParallelSplit</bpmn:sourceRef>
      <bpmn:targetRef>Task_CheckGames</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Sequence_CheckAgreement">
      <bpmn:name></bpmn:name>
      <bpmn:sourceRef>Task_AppointDate</bpmn:sourceRef>
      <bpmn:targetRef>Gateway_AgreementCheck</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Sequence_ContinueDate">
      <bpmn:name>Yes (8+ agree)</bpmn:name>
      <bpmn:sourceRef>Gateway_AgreementCheck</bpmn:sourceRef>
      <bpmn:targetRef>Gateway_ParallelJoin</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Sequence_GamesDecision">
      <bpmn:name></bpmn:name>
      <bpmn:sourceRef>Task_CheckGames</bpmn:sourceRef>
      <bpmn:targetRef>Gateway_MissingGames</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Sequence_DownloadMissing">
      <bpmn:name></bpmn:name>
      <bpmn:sourceRef>Gateway_MissingGames</bpmn:sourceRef>
      <bpmn:targetRef>Task_Download</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Sequence_JoinGames">
      <bpmn:name></bpmn:name>
      <bpmn:sourceRef>Gateway_MissingGames</bpmn:sourceRef>
      <bpmn:targetRef>Gateway_ParallelJoin</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Sequence_CalculateBeer">
      <bpmn:name></bpmn:name>
      <bpmn:sourceRef>Gateway_ParallelJoin</bpmn:sourceRef>
      <bpmn:targetRef>Task_BeerNeeds</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Sequence_EnoughBeerCheck">
      <bpmn:name></bpmn:name>
      <bpmn:sourceRef>Task_BeerNeeds</bpmn:sourceRef>
      <bpmn:targetRef>Gateway_BeerStock</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Sequence_BuyMissing">
      <bpmn:name></bpmn:name>
      <bpmn:sourceRef>Gateway_BeerStock</bpmn:sourceRef>
      <bpmn:targetRef>Task_BuyBeer</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Sequence_JoinEnd">
      <bpmn:name></bpmn:name>
      <bpmn:sourceRef>Gateway_BeerStock</bpmn:sourceRef>
      <bpmn:targetRef>End_EnjoyParty</bpmn:targetRef>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>