<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_WorkAccident" targetNamespace="http://bpmn.io/schema/bpmn">
  <process id="Process_WorkAccidentReporting" isExecutable="false">
    <laneSet>
      <lane id="Lane_EmployeeGeneral" name="Employee / General Insurance">
        <flowNodeRef>StartEvent_Accident</flowNodeRef>
        <flowNodeRef>Gateway_IsWorkAccident</flowNodeRef>
        <flowNodeRef>Task_InformEmployer</flowNodeRef>
        <flowNodeRef>Gateway_SeverityCheck</flowNodeRef>
      </lane>
      <lane id="Lane_Education" name="Education Sector">
        <flowNodeRef>Gateway_StudentType</flowNodeRef>
        <flowNodeRef>Task_SchoolReportDirectorate</flowNodeRef>
      </lane>
      <lane id="Lane_SelfEmployed" name="Self-Employed / Private">
        <flowNodeRef>Gateway_PrivateInsurance</flowNodeRef>
        <flowNodeRef>Task_ReportProviderPrivate</flowNodeRef>
      </lane>
    </laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Accident" name="Accident / Near Miss Occurs">
      <bpmn:outgoing>SequenceFlow_CheckCriteria</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Gateway 1: Is it a Work Accident? -->
    <bpmn:exclusiveGateway id="Gateway_IsWorkAccident" name="Is this a work accident?">
      <bpmn:incoming>SequenceFlow_CheckCriteria</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EmployeePath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 1: Employee informs employer -->
    <bpmn:userTask id="Task_InformEmployer" name="Inform Employer Immediately">
      <bpmn:description>Report accident, near miss, risk or defect</bpmn:description>
      <bpmn:incoming>SequenceFlow_EmployeePath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SeverityCheck</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway 2: Severity Check -->
    <bpmn:exclusiveGateway id="Gateway_SeverityCheck" name="Fatality or Serious Injury?">
      <bpmn:incoming>SequenceFlow_SeverityCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReportInspectorate</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 2: Report to Labour Inspectorate -->
    <bpmn:userTask id="Task_ReportInspectorate" name="Report to Labour Inspectorate">
      <bpmn:description>If not reported elsewhere, report immediately</bpmn:description>
      <bpmn:incoming>SequenceFlow_ReportInspectorate</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConvergeInsurance</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway 3: Insurance Provider Reporting -->
    <bpmn:exclusiveGateway id="Gateway_StudentType" name="Is Student/Schoolchild?">
      <bpmn:incoming>SequenceFlow_ConvergeInsurance</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EducationReport</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 3: Education Reporting -->
    <bpmn:userTask id="Task_SchoolReportDirectorate" name="School Reports to Directorate & Provider">
      <bpmn:description>Injury/Death within max 5 days (triplicate)</bpmn:description>
      <bpmn:incoming>SequenceFlow_EducationReport</bpmn:incoming>
    </bpmn:userTask>

    <!-- Gateway 4: Private/Self-Employed Check -->
    <bpmn:exclusiveGateway id="Gateway_PrivateInsurance" name="Self-Employed or Private?">
      <bpmn:incoming>SequenceFlow_ConvergeInsurance</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReportProviderPrivate</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 4: Private Reporting -->
    <bpmn:userTask id="Task_ReportProviderPrivate" name="Report to Accident Provider">
      <bpmn:description>In writing immediately (Fatalities within 3 days)</bpmn:description>
      <bpmn:incoming>SequenceFlow_ReportProviderPrivate</bpmn:incoming>
    </bpmn:userTask>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_ReportedStatutory" name="Report Complete (5 Days)">
       <bpmn:description>Injury preventing work &gt;3 days or Fatal</bpmn:description>
      <bpmn:incoming>SequenceFlow_ConvergeInsurance</bpmn:incoming>
    </bpmn:endEvent>

    <!-- End Event Education -->
    <bpmn:endEvent id="EndEvent_ReportedEducation" name="Report Complete (5 Days)">
       <bpmn:description>School/University reporting obligation met</bpmn:description>
      <bpmn:incoming>SequenceFlow_EducationReport</bpmn:incoming>
    </bpmn:endEvent>

     <!-- End Event Private -->
    <bpmn:endEvent id="EndEvent_ReportedPrivate" name="Report Complete">
       <bpmn:description>Written report submitted to provider</bpmn:description>
      <bpmn:incoming>SequenceFlow_ReportProviderPrivate</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckCriteria" sourceRef="StartEvent_Accident" targetRef="Gateway_IsWorkAccident">
      <bpmn:name>Incident Occurs</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Flow to Employee Lane -->
    <bpmn:sequenceFlow id="SequenceFlow_EmployeePath" sourceRef="Gateway_IsWorkAccident" targetRef="Task_InformEmployer">
      <bpmn:name>Yes, Work Accident</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Flow to Severity Check -->
    <bpmn:sequenceFlow id="SequenceFlow_SeverityCheck" sourceRef="Task_InformEmployer" targetRef="Gateway_SeverityCheck">
      <bpmn:name>Informed</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Flow to Inspectorate -->
    <bpmn:sequenceFlow id="SequenceFlow_ReportInspectorate" sourceRef="Gateway_SeverityCheck" targetRef="Task_ReportInspectorate">
      <bpmn:name>Fatality/Serious Injury</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Flow to Insurance Provider Check (Converging) -->
    <bpmn:sequenceFlow id="SequenceFlow_ConvergeInsurance" sourceRef="Task_ReportInspectorate" targetRef="Gateway_StudentType">
      <bpmn:name>Reported</bpmn:name>
    </bpmn:sequenceFlow>

     <!-- Flow to Education Lane -->
    <bpmn:sequenceFlow id="SequenceFlow_EducationReport" sourceRef="Gateway_StudentType" targetRef="Task_SchoolReportDirectorate">
      <bpmn:name>Yes, Student/School</bpmn:name>
    </bpmn:sequenceFlow>

     <!-- Flow to Private Lane -->
    <bpmn:sequenceFlow id="SequenceFlow_ReportProviderPrivate" sourceRef="Gateway_PrivateInsurance" targetRef="Task_ReportProviderPrivate">
      <bpmn:name>Yes, Self-Employed/Private</bpmn:name>
    </bpmn:sequenceFlow>

  </process>
</bpmn:definitions>