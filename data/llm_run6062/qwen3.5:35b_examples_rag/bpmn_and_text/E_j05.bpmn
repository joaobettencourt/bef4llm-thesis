<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <process id="WorkAndLiveInAustriaProcess" isExecutable="false">
    <laneSet>
      <lane id="Lane_Applicant" name="Applicant">
        <flowNodeRef>StartEvent_BeginApplication</flowNodeRef>
        <flowNodeRef>Task_CheckRequirements</flowNodeRef>
        <flowNodeRef>ParallelGateway_AccommodationBank</flowNodeRef>
        <flowNodeRef>Task_OrganizeAccommodation</flowNodeRef>
        <flowNodeRef>Task_NegotiateBankAccount</flowNodeRef>
        <flowNodeRef>ExclusiveGateway_VisaDocumentsComplete</flowNodeRef>
        <flowNodeRef>EndEvent_SuccessfulApplication</flowNodeRef>
      </lane>
      <lane id="Lane_Authorities" name="Austrian Authorities (BMEIA)">
        <flowNodeRef>Task_SubmitVisaApplication</flowNodeRef>
        <flowNodeRef>ExclusiveGateway_VisaDecision</flowNodeRef>
        <flowNodeRef>EndEvent_ApplicationRejected</flowNodeRef>
      </lane>
    </laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_BeginApplication">
      <bpmn:name>Begin Work and Live Application</bpmn:name>
      <bpmn:outgoing>bpmn:SequenceFlow_CheckRequirements</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1 (Applicant) -->
    <bpmn:task id="Task_CheckRequirements" name="Check requirements for working and living in Austria">
      <bpmn:incoming>bpmn:SequenceFlow_CheckRequirements</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_AccommodationBankSplit</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway (Applicant) -->
    <bpmn:parallelGateway id="ParallelGateway_AccommodationBank" gatewayDirection="Diverging">
      <bpmn:incoming>bpmn:SequenceFlow_AccommodationBankSplit</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_OrganizeAccommodation</bpmn:outgoing>
      <bpmn:outgoing>bpmn:SequenceFlow_NegotiateBankAccount</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 2 (Applicant) -->
    <bpmn:task id="Task_OrganizeAccommodation" name="Organize accommodation">
      <bpmn:incoming>bpmn:SequenceFlow_OrganizeAccommodation</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_AccommodationComplete</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3 (Applicant) -->
    <bpmn:task id="Task_NegotiateBankAccount" name="Negotiate bank account">
      <bpmn:incoming>bpmn:SequenceFlow_NegotiateBankAccount</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_BankComplete</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway Converging (Applicant) -->
    <bpmn:parallelGateway id="ParallelGateway_VisaPreparation" gatewayDirection="Converging">
      <bpmn:incoming>bpmn:SequenceFlow_AccommodationComplete</bpmn:incoming>
      <bpmn:incoming>bpmn:SequenceFlow_BankComplete</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_PrepareVisaDocuments</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 4 (Applicant) -->
    <bpmn:task id="Task_PrepareVisaDocuments" name="Prepare visa documents">
      <bpmn:incoming>bpmn:SequenceFlow_PrepareVisaDocuments</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_VisaDocsComplete</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway (Applicant) -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_VisaDocumentsComplete" gatewayDirection="Diverging">
      <bpmn:incoming>bpmn:SequenceFlow_VisaDocsComplete</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_SubmitToAuthorities</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 5 (Applicant) -->
    <bpmn:task id="Task_SubmitVisaApplication" name="Submit visa application to BMEIA">
      <bpmn:incoming>bpmn:SequenceFlow_SubmitToAuthorities</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_VisaDecisionRequest</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway (Authorities) -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_VisaDecision" gatewayDirection="Diverging">
      <bpmn:incoming>bpmn:SequenceFlow_VisaDecisionRequest</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_Approved</bpmn:outgoing>
      <bpmn:outgoing>bpmn:SequenceFlow_Rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event 1 (Applicant) -->
    <bpmn:endEvent id="EndEvent_SuccessfulApplication">
      <bpmn:name>Visa Approved - Can work and live in Austria</bpmn:name>
      <bpmn:incoming>bpmn:SequenceFlow_Approved</bpmn:incoming>
    </bpmn:endEvent>

    <!-- End Event 2 (Authorities) -->
    <bpmn:endEvent id="EndEvent_ApplicationRejected">
      <bpmn:name>Visa Application Rejected</bpmn:name>
      <bpmn:incoming>bpmn:SequenceFlow_Rejected</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows (Applicant) -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckRequirements" sourceRef="StartEvent_BeginApplication" targetRef="Task_CheckRequirements">
      <bpmn:name>Begin Application Process</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_AccommodationBankSplit" sourceRef="Task_CheckRequirements" targetRef="ParallelGateway_AccommodationBank">
      <bpmn:conditionExpression>${requirementsMet}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_OrganizeAccommodation" sourceRef="ParallelGateway_AccommodationBank" targetRef="Task_OrganizeAccommodation"/>

    <bpmn:sequenceFlow id="SequenceFlow_NegotiateBankAccount" sourceRef="ParallelGateway_AccommodationBank" targetRef="Task_NegotiateBankAccount"/>

    <bpmn:sequenceFlow id="SequenceFlow_AccommodationComplete" sourceRef="Task_OrganizeAccommodation" targetRef="ParallelGateway_VisaPreparation">
      <bpmn:conditionExpression>${accommodationOrganized}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_BankComplete" sourceRef="Task_NegotiateBankAccount" targetRef="ParallelGateway_VisaPreparation">
      <bpmn:conditionExpression>${bankAccountNegotiated}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Sequence Flows (Visa Preparation) -->
    <bpmn:sequenceFlow id="SequenceFlow_PrepareVisaDocuments" sourceRef="ParallelGateway_VisaPreparation" targetRef="Task_PrepareVisaDocuments"/>

    <bpmn:sequenceFlow id="SequenceFlow_VisaDocsComplete" sourceRef="Task_PrepareVisaDocuments" targetRef="ExclusiveGateway_VisaDocumentsComplete">
      <bpmn:conditionExpression>${allDocumentsCollected}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Sequence Flows (Submission and Decision) -->
    <bpmn:sequenceFlow id="SequenceFlow_SubmitToAuthorities" sourceRef="ExclusiveGateway_VisaDocumentsComplete" targetRef="Task_SubmitVisaApplication"/>

    <bpmn:sequenceFlow id="SequenceFlow_VisaDecisionRequest" sourceRef="Task_SubmitVisaApplication" targetRef="ExclusiveGateway_VisaDecision">
      <bpmn:conditionExpression>${applicationSubmitted}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Sequence Flows (Outcomes) -->
    <bpmn:sequenceFlow id="SequenceFlow_Approved" sourceRef="ExclusiveGateway_VisaDecision" targetRef="EndEvent_SuccessfulApplication">
      <bpmn:name>Visa Approved</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_Rejected" sourceRef="ExclusiveGateway_VisaDecision" targetRef="EndEvent_ApplicationRejected">
      <bpmn:name>Visa Rejected - Additional documents required or grounds for refusal exist</bpmn:name>
    </bpmn:sequenceFlow>

  </process>
  
  <!-- Data Objects -->
  <dataObject id="Data_VisaApplicationForm" name="Visa Application Form"/>
  <dataObject id="Data_TravelDocument" name="Travel Document (valid +3 months, issued within 10 years)"/>
  <dataObject id="Data_PassportPhoto" name="Passport Photo (35x45mm portrait format)"/>
  <dataObject id="Data_HealthInsurance" name="Comprehensive Travel Health Insurance (€30,000 Schengen coverage)"/>
  <dataObject id="Data_MeansOfSubsistence" name="Proof of Sufficient Means of Subsistence"/>
  <dataObject id="Data_AdditionalEvidence" name="Additional Evidence (hotel reservations, invitations, return ticket, employment proof etc.)"/>

</bpmn:definitions>