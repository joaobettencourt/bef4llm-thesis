<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <process id="FridgeServiceProcess" isExecutable="false" name="Service for Your Fridge">
    <!-- Start Event -->
    <startEvent id="StartEvent_ReportIssue" name="Customer reports fridge issue">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>

    <!-- Task: Central Service Center selects facility and schedules appointment -->
    <task id="Task_ScheduleAppointment" name="Select local service &amp; schedule appointment">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_CheckPartsAvailability</outgoing>
    </task>

    <!-- Gateway: Check if parts are available at arrival -->
    <exclusiveGateway id="Gateway_PartsCheck" name="Parts needed?">
      <incoming>SequenceFlow_CheckPartsAvailability</incoming>
      <outgoing>SequenceFlow_NoPartsNeeded</outgoing>
      <outgoing>SequenceFlow_YesNeedParts</outgoing>
    </exclusiveGateway>

    <!-- Path: Parts not available (Exception) -->
    <task id="Task_OrderAdditionalParts" name="Order additional parts">
      <incoming>SequenceFlow_NoPartsNeeded</incoming>
      <outgoing>SequenceFlow_EndVisitCancelled</outgoing>
    </task>
    
    <endEvent id="EndEvent_VisitCancelled" name="Visit cancelled (parts needed)">
      <incoming>SequenceFlow_EndVisitCancelled</incoming>
    </endEvent>

    <!-- Path: Parts available -->
    <sequenceFlow id="SequenceFlow_YesNeedParts" sourceRef="Gateway_PartsCheck" targetRef="Task_RepairFridge">
       <bpmn:name>No, parts OK</bpmn:name>
    </sequenceFlow>

    <!-- Task: Repair Fridge -->
    <task id="Task_RepairFridge" name="Repair fridge">
      <incoming>SequenceFlow_YesNeedParts</incoming>
      <outgoing>SequenceFlow_ConfirmOK</outgoing>
    </task>

    <!-- Task: Customer Confirmation -->
    <task id="Task_ConfirmOK" name="Confirm repair is OK">
      <incoming>SequenceFlow_ConfirmOK</incoming>
      <outgoing>SequenceFlow_RateService</outgoing>
    </task>

    <!-- Task: Rate Service (Optional but modeled as final step) -->
    <task id="Task_RateService" name="Rate service facility">
      <incoming>SequenceFlow_RateService</incoming>
      <outgoing>SequenceFlow_EndSuccess</outgoing>
    </task>

    <!-- End Event: Success -->
    <endEvent id="EndEvent_Success" name="Service completed successfully">
      <incoming>SequenceFlow_EndSuccess</incoming>
    </endEvent>

    <!-- Sequence Flows for Parts Needed Path (No) -->
    <sequenceFlow id="SequenceFlow_NoPartsNeeded" sourceRef="Gateway_PartsCheck" targetRef="Task_OrderAdditionalParts">
       <bpmn:name>Yes, need parts</bpmn:name>
    </sequenceFlow>

    <!-- Sequence Flow from Start to Task_ScheduleAppointment -->
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_ReportIssue" targetRef="Task_ScheduleAppointment"/>

    <!-- Sequence Flow for Parts Check Decision (No parts needed path) -->
    <sequenceFlow id="SequenceFlow_CheckPartsAvailability" sourceRef="Task_ScheduleAppointment" targetRef="Gateway_PartsCheck"/>

    <!-- Sequence Flow from OrderAdditionalParts to EndEvent_VisitCancelled -->
    <sequenceFlow id="SequenceFlow_EndVisitCancelled" sourceRef="Task_OrderAdditionalParts" targetRef="EndEvent_VisitCancelled"/>

    <!-- Sequence Flow for Confirmation Task -->
    <sequenceFlow id="SequenceFlow_ConfirmOK" sourceRef="Task_RepairFridge" targetRef="Task_ConfirmOK"/>

    <!-- Sequence Flow from Confirm to Rate Service -->
    <sequenceFlow id="SequenceFlow_RateService" sourceRef="Task_ConfirmOK" targetRef="Task_RateService"/>

    <!-- Sequence Flow for Final End Event -->
    <sequenceFlow id="SequenceFlow_EndSuccess" sourceRef="Task_RateService" targetRef="EndEvent_Success"/>

  </process>
</bpmn:definitions>