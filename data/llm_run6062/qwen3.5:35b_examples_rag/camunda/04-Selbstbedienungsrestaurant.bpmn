<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_RestaurantProcess">
    <bpmn:participant id="Participant_Gast" name="Gast"/>
    <bpmn:participant id="Participant_Restaurant" name="Restaurant" processRef="Process_Restaurant"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Restaurant" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Gast" name="Gast">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_WarteReihe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_GerichtWählen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_EssenVerzehr</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Angestellter" name="Angestellter">
        <bpmn:flowNodeRef>UserTask_BestellungAufnehmen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_KasseSystemEingabe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_PieferEinrichten</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_GastInformierenKoch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_AusgabeEssenÜbergabe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_PieferReaktion</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Koch" name="Koch">
        <bpmn:flowNodeRef>UserTask_MahlzeitZubereiten</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_EssenDurchreicheStellen</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Guest Lane -->
    <bpmn:startEvent id="StartEvent_1" name="Gast betritt Restaurant">
      <bpmn:outgoing>SequenceFlow_GastBetritt</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="UserTask_WarteReihe" name="Warten bis an der Reihe">
      <bpmn:incoming>SequenceFlow_GastBetritt</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReiheErreicht</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Restaurant Staff Lane -->
    <bpmn:userTask id="UserTask_BestellungAufnehmen" name="Bestellung aufnehmen">
      <bpmn:incoming>SequenceFlow_ReiheErreicht</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_KasseSystemEingabe</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Guest Lane -->
    <bpmn:userTask id="UserTask_GerichtWählen" name="Gericht aus Angebot wählen">
      <bpmn:incoming>SequenceFlow_ReiheErreicht</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BestellungAufnehmen</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Restaurant Staff Lane -->
    <bpmn:userTask id="UserTask_KasseSystemEingabe" name="Bestellung in Kassensystem eingeben">
      <bpmn:incoming>SequenceFlow_BestellungAufnehmen</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GeldKassieren</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Restaurant Staff Lane -->
    <bpmn:userTask id="UserTask_PieferEinrichten" name="Pieper einrichten und übergeben">
      <bpmn:incoming>SequenceFlow_GeldKassieren</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_KochInformieren</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Restaurant Staff Lane -->
    <bpmn:userTask id="UserTask_AusgabeEssenÜbergabe" name="Essen an Ausgabe übergeben">
      <bpmn:incoming>SequenceFlow_EssenBereit</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GastErhältEssen</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Restaurant Staff Lane -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_PieferReaktion" name="Pieper-Reaktion?">
      <bpmn:incoming>SequenceFlow_EssenBereit</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GastErhältEssenJa</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NichtReagiert5Minuten</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Restaurant Staff Lane -->
    <bpmn:userTask id="UserTask_GastRufen" name="Gast nach 5 Minuten rufen">
      <bpmn:incoming>SequenceFlow_NichtReagiert5Minuten</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PieferNochMalAusrufen</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Restaurant Staff Lane -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_RuftGastReagiert" name="Gast reagiert?">
      <bpmn:incoming>SequenceFlow_PieferNochMalAusrufen</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GastErhältEssenJa2</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Restaurant Staff Lane -->
    <bpmn:userTask id="UserTask_PieferNochMalAusrufen" name="Pieper erneut ausrufen">
      <bpmn:incoming>SequenceFlow_NichtReagiert5Minuten</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RuftGastReagiert</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Guest Lane End Event -->
    <bpmn:endEvent id="EndEvent_1" name="Essen verzehrt">
      <bpmn:incoming>SequenceFlow_GastErhältEssenJa2</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Guest Lane End Event -->
    <bpmn:userTask id="UserTask_EssenVerzehr" name="Mahlzeit verzehren">
      <bpmn:incoming>SequenceFlow_GastErhältEssen</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndeProzessGast</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Restaurant Staff Lane -->
    <bpmn:endEvent id="EndEvent_Angestellter" name="Essen übergeben">
      <bpmn:incoming>SequenceFlow_GastErhältEssenJa2</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Restaurant Staff Lane -->
    <bpmn:userTask id="UserTask_KochInformieren" name="Koch über Mahlzeit informieren">
      <bpmn:incoming>SequenceFlow_GastInformierenKoch</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MahlzeitZubereitenStart</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Restaurant Staff Lane -->
    <bpmn:startEvent id="StartEvent_Koch" name="Mahlzeit zubereitet">
      <bpmn:incoming/>
      <bpmn:outgoing>SequenceFlow_MahlzeitZubereiten</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Restaurant Staff Lane -->
    <bpmn:userTask id="UserTask_EssenDurchreicheStellen" name="Essen in Durchreiche stellen">
      <bpmn:incoming>SequenceFlow_MahlzeitZubereiten</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_KochInformiertAngestellter</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Restaurant Staff Lane -->
    <bpmn:startEvent id="StartEvent_EssenBereit" name="Essen fertig">
      <bpmn:incoming/>
      <bpmn:outgoing>SequenceFlow_PieferAusrufen</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Restaurant Staff Lane -->
    <bpmn:userTask id="UserTask_MahlzeitZubereiten" name="Mahlzeit zubereiten">
      <bpmn:incoming>SequenceFlow_KochInformieren</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EssenDurchreicheStellenStart</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Restaurant Staff Lane -->
    <bpmn:startEvent id="StartEvent_PieferAusrufen" name="Pieper ausrufen">
      <bpmn:incoming/>
      <bpmn:outgoing>SequenceFlow_EssenBereit</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_GastBetritt" sourceRef="StartEvent_1" targetRef="UserTask_WarteReihe"/>
    <bpmn:sequenceFlow id="SequenceFlow_ReiheErreicht" name="an der Reihe" sourceRef="UserTask_WarteReihe" targetRef="UserTask_BestellungAufnehmen"/>
    <bpmn:sequenceFlow id="SequenceFlow_GerichtWählenStart" sourceRef="StartEvent_1" targetRef="UserTask_GerichtWählen"/>
    <bpmn:sequenceFlow id="SequenceFlow_BestellungAufnehmen" name="Bestellen" sourceRef="UserTask_GerichtWählen" targetRef="UserTask_BestellungAufnehmen"/>
    <bpmn:sequenceFlow id="SequenceFlow_KasseSystemEingabe" sourceRef="UserTask_BestellungAufnehmen" targetRef="UserTask_KasseSystemEingabe"/>
    <bpmn:sequenceFlow id="SequenceFlow_GeldKassieren" name="Geld kassiert" sourceRef="UserTask_KasseSystemEingabe" targetRef="UserTask_PieferEinrichten"/>
    <bpmn:sequenceFlow id="SequenceFlow_KochInformieren" sourceRef="UserTask_PieferEinrichten" targetRef="UserTask_GastInformierenKoch"/>
    <bpmn:sequenceFlow id="SequenceFlow_MahlzeitZubereitenStart" name="Mahlzeit zubereiten starten" sourceRef="UserTask_GastInformierenKoch" targetRef="UserTask_KochInformieren"/>
    <bpmn:sequenceFlow id="SequenceFlow_EssenBereit" sourceRef="ExclusiveGateway_PieferReaktion" targetRef="UserTask_AusgabeEssenÜbergabe"/>
    <bpmn:sequenceFlow id="SequenceFlow_GastErhältEssenJa2" name="Gast reagiert" sourceRef="ExclusiveGateway_RuftGastReagiert" targetRef="EndEvent_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_NichtReagiert5Minuten" name="nicht reagiert (5 Min)" sourceRef="ExclusiveGateway_PieferReaktion" targetRef="UserTask_GastRufen"/>
    <bpmn:sequenceFlow id="SequenceFlow_RuftGastReagiert" sourceRef="UserTask_GastRufen" targetRef="ExclusiveGateway_RuftGastReagiert"/>
    <bpmn:sequenceFlow id="SequenceFlow_PieferNochMalAusrufen" name="Pieper erneut ausrufen" sourceRef="UserTask_PieferNochMalAusrufen" targetRef="ExclusiveGateway_RuftGastReagiert"/>
    <bpmn:sequenceFlow id="SequenceFlow_GastErhältEssenJa" name="reagiert auf Pieper" sourceRef="ExclusiveGateway_PieferReaktion" targetRef="UserTask_AusgabeEssenÜbergabe"/>
    <bpmn:sequenceFlow id="SequenceFlow_EssenBereitStart" sourceRef="StartEvent_EssenBereit" targetRef="ExclusiveGateway_PieferReaktion"/>
    <bpmn:sequenceFlow id="SequenceFlow_MahlzeitZubereiten" name="Mahlzeit zubereitet" sourceRef="UserTask_KochInformieren" targetRef="UserTask_MahlzeitZubereiten"/>
    <bpmn:sequenceFlow id="SequenceFlow_EssenDurchreicheStellenStart" sourceRef="UserTask_MahlzeitZubereiten" targetRef="UserTask_EssenDurchreicheStellen"/>
    <bpmn:sequenceFlow id="SequenceFlow_KochInformiertAngestellter" name="Essen fertig gemeldet" sourceRef="UserTask_EssenDurchreicheStellen" targetRef="StartEvent_EssenBereit"/>

  </bpmn:process>
</bpmn:definitions>