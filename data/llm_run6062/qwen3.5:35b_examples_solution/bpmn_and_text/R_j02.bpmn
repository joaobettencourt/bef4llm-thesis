<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_InspectionProcess" targetNamespace="http://bpmnio.com">
  <bpmn:collaboration id="Collab_MachineInspection">
    <bpmn:participant id="Participant_ServiceTeam" name="Service Team" processRef="Proc_EnergyDrinkMachine"/>
  </bpmn:collaboration>

  <bpmn:process id="Proc_EnergyDrinkMachine" isExecutable="false">
    
    <!-- Lane Organization -->
    <bpmn:laneSet id="Lane_Set_01">
      <bpmn:lane id="Lane_Technician" name="Service Technician">
        <bpmn:flowNodeRef>StartEvent_MachineReady</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_EnterDetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_CollectValues</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_QuestionsNeeded</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_MachineReady" name="Machine Ready">
      <bpmn:outgoing>bpmn:SequenceFlow_StartToEnter</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- User Task - Enter Details -->
    <bpmn:userTask id="UserTask_EnterDetails" name="Enter machine type and serial number">
      <bpmn:incoming>bpmn:SequenceFlow_StartToEnter</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_EnterToCollect</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Service Task - Collect Values -->
    <bpmn:serviceTask id="ServiceTask_CollectValues" name="Collect values from machine">
      <bpmn:incoming>bpmn:SequenceFlow_EnterToCollect</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_CollectToDecision</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Exclusive Gateway - Decision -->
    <bpmn:exclusiveGateway id="Gateway_QuestionsNeeded" name="Additional questions needed?">
      <bpmn:incoming>bpmn:SequenceFlow_CollectToDecision</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_YesLoopBack</bpmn:outgoing>
      <bpmn:outgoing>bpmn:SequenceFlow_NoEndProcess</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Completed" name="Inspection completed">
      <bpmn:incoming>bpmn:SequenceFlow_NoEndProcess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToEnter" sourceRef="StartEvent_MachineReady" targetRef="UserTask_EnterDetails"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_EnterToCollect" sourceRef="UserTask_EnterDetails" targetRef="ServiceTask_CollectValues"/>

    <bpmn:sequenceFlow id="SequenceFlow_CollectToDecision" sourceRef="ServiceTask_CollectValues" targetRef="Gateway_QuestionsNeeded"/>
    
    <!-- Loop back for additional questions -->
    <bpmn:sequenceFlow id="SequenceFlow_YesLoopBack" name="Yes" sourceRef="Gateway_QuestionsNeeded" targetRef="UserTask_EnterDetails"/>

    <bpmn:sequenceFlow id="SequenceFlow_NoEndProcess" name="No" sourceRef="Gateway_QuestionsNeeded" targetRef="EndEvent_Completed"/>
    
  </bpmn:process>
</bpmn:definitions>