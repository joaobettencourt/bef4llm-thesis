<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_USICourseRegistration" targetNamespace="http://bpmnio.com">
  <bpmn:collaboration id="Collab_USICourseProcess">
    <bpmn:participant id="Participant_User" name="Course Registration System" processRef="Proc_CourseRegistration"/>
  </bpmn:collaboration>

  <bpmn:process id="Proc_CourseRegistration" isExecutable="false">
    
    <!-- Lane Organization -->
    <bpmn:laneSet id="Lane_Set_01">
      <bpmn:lane id="Lane_UserActions" name="User Actions">
        <bpmn:flowNodeRef>StartEvent_WishToEnroll</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_SelectCourse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_CheckAnotherCourse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_InviteFriends</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_SystemActions" name="System Actions">
        <bpmn:flowNodeRef>ServiceTask_ShowCoursesAndDates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_CheckEligibleUniversity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_RegisterAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_RequestActivation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_CheckEligibility</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_ConnectTwitter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_ProvidePaymentInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_IssueCourseTickets</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_WishToEnroll" name="Wish to enroll in course">
      <bpmn:outgoing>SequenceFlow_01_Start</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- User Task - Select Course -->
    <bpmn:userTask id="UserTask_SelectCourse" name="Select a course">
      <bpmn:incoming>SequenceFlow_GatewayLoopBackToSelect</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_02_CheckFreeSpots</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Exclusive Gateway - Free Spots? -->
    <bpmn:xorGateway id="Gateway_FreeSpots" name="free spots?">
      <bpmn:incoming>SequenceFlow_02_CheckFreeSpots</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_03_ShowCoursesYes</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_04_ChooseAnotherNo</bpmn:outgoing>
    </bpmn:xorGateway>

    <!-- Service Task - Show Courses -->
    <bpmn:serviceTask id="ServiceTask_ShowCoursesAndDates" name="System shows courses and dates">
      <bpmn:incoming>SequenceFlow_03_ShowCoursesYes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_05_SelectSpecificCourse</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- User Task - Select Specific Course -->
    <bpmn:userTask id="UserTask_SelectSpecific" name="Select specific course">
      <bpmn:incoming>SequenceFlow_05_SelectSpecificCourse</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_06_CheckAccount</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Exclusive Gateway - Already Registered? -->
    <bpmn:xorGateway id="Gateway_AlreadyRegistered" name="already registered?">
      <bpmn:incoming>SequenceFlow_06_CheckAccount</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_07_LogInYes</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_08_CheckUniversityNo</bpmn:outgoing>
    </bpmn:xorGateway>

    <!-- User Task - Check Eligible University -->
    <bpmn:userTask id="UserTask_CheckEligibleUniversity" name="Check if registered at eligible university">
      <bpmn:incoming>SequenceFlow_08_CheckUniversityNo</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_09_EligibilityDecision</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Exclusive Gateway - Eligible University? -->
    <bpmn:xorGateway id="Gateway_EligibleUniversity" name="eligible university?">
      <bpmn:incoming>SequenceFlow_09_EligibilityDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_10_RegisterAccountYes</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_11_RequestActivationNo</bpmn:outgoing>
    </bpmn:xorGateway>

    <!-- User Task - Register Account -->
    <bpmn:userTask id="UserTask_RegisterAccount" name="Register your account">
      <bpmn:incoming>SequenceFlow_10_RegisterAccountYes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_12_LogInAfterRegistration</bpmn:outgoing>
    </bpmn:userTask>

    <!-- User Task - Request Activation -->
    <bpmn:userTask id="UserTask_RequestActivation" name="Request activation and wait for response">
      <bpmn:incoming>SequenceFlow_11_RequestActivationNo</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_13_SystemCheckEligibility</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Service Task - System Checks Eligibility -->
    <bpmn:serviceTask id="ServiceTask_CheckEligibility" name="System checks eligibility">
      <bpmn:incoming>SequenceFlow_13_SystemCheckEligibility</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_14_PersonEligibleDecision</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Exclusive Gateway - Person Eligible? -->
    <bpmn:xorGateway id="Gateway_PersonEligible" name="person eligible?">
      <bpmn:incoming>SequenceFlow_14_PersonEligibleDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_15_ConnectTwitterYes</bpmn:outgoing>
    </bpmn:xorGateway>

    <!-- User Task - Connect Twitter -->
    <bpmn:userTask id="UserTask_ConnectTwitter" name="Connect to twitter account">
      <bpmn:incoming>SequenceFlow_15_ConnectTwitterYes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_17_TwitterIntegration</bpmn:outgoing>
    </bpmn:userTask>

    <!-- User Task - Invite Friends -->
    <bpmn:userTask id="UserTask_InviteFriends" name="Tweet to friends who might want to join">
      <bpmn:incoming>SequenceFlow_17_TwitterIntegration</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_18_ConvergeToPayment</bpmn:outgoing>
    </bpmn:userTask>

    <!-- User Task - Provide Payment Info -->
    <bpmn:userTask id="UserTask_ProvidePaymentInfo" name="Provide payment information">
      <bpmn:incoming>SequenceFlow_19_PaymentParallel</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_20_ConvergeToTickets</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Service Task - Issue Course Tickets -->
    <bpmn:serviceTask id="ServiceTask_IssueCourseTickets" name="System issues course tickets">
      <bpmn:incoming>SequenceFlow_21_ConvergeToTickets</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_23_FinalConvergence</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_CourseTicket" name="Receive course ticket">
      <bpmn:incoming>SequenceFlow_24_EndProcessNo</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_23_FinalConvergence</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Parallel Gateway - After Login -->
    <bpmn:parallelGateway id="Parallel_Gateway_Login" name="">
      <bpmn:incoming>SequenceFlow_FlowToLoginGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_15_ConnectTwitterYes</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_19_PaymentParallel</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Parallel Gateway - Converge -->
    <bpmn:parallelGateway id="Parallel_Gateway_Converge" name="">
      <bpmn:incoming>SequenceFlow_18_ConvergeToPayment</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_20_ConvergeToTickets</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_21_ConvergeToTickets</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Exclusive Gateway - Converge After Twitter -->
    <bpmn:xorGateway id="Gateway_TwitterConvergence" name="">
      <bpmn:incoming>SequenceFlow_23_FinalConvergence</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_24_EndProcessNo</bpmn:outgoing>
    </bpmn:xorGateway>

    <!-- Exclusive Gateway - Converge After Eligibility -->
    <bpmn:xorGateway id="Gateway_EligibleYes" name="">
      <bpmn:incoming>SequenceFlow_10_RegisterAccountYes</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_12_LogInAfterRegistration</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FlowToLoginGateway</bpmn:outgoing>
    </bpmn:xorGateway>

    <!-- User Task - Check Another Course -->
    <bpmn:userTask id="UserTask_CheckAnotherCourse" name="Check if another course is interesting">
      <bpmn:incoming>SequenceFlow_04_ChooseAnotherNo</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GatewayLoopBackToSelect</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Exclusive Gateway - Loop Back -->
    <bpmn:xorGateway id="Gateway_ChooseAnother" name="">
      <bpmn:incoming>SequenceFlow_04_ChooseAnotherNo</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GatewayLoopBackToSelect</bpmn:outgoing>
    </bpmn:xorGateway>

    <!-- User Task - Log In -->
    <bpmn:userTask id="UserTask_LogIn" name="Log into account">
      <bpmn:incoming>SequenceFlow_07_LogInYes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FlowToLoginGateway</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_01_Start" sourceRef="StartEvent_WishToEnroll" targetRef="UserTask_SelectCourse"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_02_CheckFreeSpots" name="" sourceRef="UserTask_SelectCourse" targetRef="Gateway_FreeSpots"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_03_ShowCoursesYes" name="yes" sourceRef="Gateway_FreeSpots" targetRef="ServiceTask_ShowCoursesAndDates"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_04_ChooseAnotherNo" name="no" sourceRef="Gateway_FreeSpots" targetRef="UserTask_CheckAnotherCourse"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_GatewayLoopBackToSelect" name="" sourceRef="Gateway_ChooseAnother" targetRef="UserTask_SelectCourse"/>

    <bpmn:sequenceFlow id="SequenceFlow_05_SelectSpecificCourse" name="" sourceRef="ServiceTask_ShowCoursesAndDates" targetRef="UserTask_SelectSpecific"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_06_CheckAccount" name="" sourceRef="UserTask_SelectSpecific" targetRef="Gateway_AlreadyRegistered"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_07_LogInYes" name="yes" sourceRef="Gateway_AlreadyRegistered" targetRef="UserTask_LogIn"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_08_CheckUniversityNo" name="no" sourceRef="Gateway_AlreadyRegistered" targetRef="UserTask_CheckEligibleUniversity"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_09_EligibilityDecision" name="" sourceRef="UserTask_CheckEligibleUniversity" targetRef="Gateway_EligibleUniversity"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_10_RegisterAccountYes" name="yes" sourceRef="Gateway_EligibleUniversity" targetRef="UserTask_RegisterAccount"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_11_RequestActivationNo" name="" sourceRef="Gateway_EligibleUniversity" targetRef="UserTask_RequestActivation"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_12_LogInAfterRegistration" name="" sourceRef="UserTask_RegisterAccount" targetRef="Gateway_EligibleYes"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_FlowToLoginGateway" name="" sourceRef="UserTask_LogIn" targetRef="Parallel_Gateway_Login"/>

    <bpmn:sequenceFlow id="SequenceFlow_13_SystemCheckEligibility" name="" sourceRef="UserTask_RequestActivation" targetRef="ServiceTask_CheckEligibility"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_14_PersonEligibleDecision" name="" sourceRef="ServiceTask_CheckEligibility" targetRef="Gateway_PersonEligible"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_15_ConnectTwitterYes" name="yes" sourceRef="Parallel_Gateway_Login" targetRef="UserTask_ConnectTwitter"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_17_TwitterIntegration" name="" sourceRef="UserTask_ConnectTwitter" targetRef="UserTask_InviteFriends"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_18_ConvergeToPayment" name="" sourceRef="UserTask_InviteFriends" targetRef="Parallel_Gateway_Converge"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_19_PaymentParallel" name="" sourceRef="Parallel_Gateway_Login" targetRef="UserTask_ProvidePaymentInfo"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_20_ConvergeToTickets" name="" sourceRef="UserTask_ProvidePaymentInfo" targetRef="Parallel_Gateway_Converge"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_21_ConvergeToTickets" name="" sourceRef="Parallel_Gateway_Converge" targetRef="ServiceTask_IssueCourseTickets"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_23_FinalConvergence" name="" sourceRef="ServiceTask_IssueCourseTickets" targetRef="Gateway_TwitterConvergence"/>

  </bpmn:process>
</bpmn:definitions>