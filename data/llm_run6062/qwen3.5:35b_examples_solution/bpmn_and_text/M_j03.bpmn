<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ContractProject_001" targetNamespace="http://bpmnio.com">
  <bpmn:collaboration id="Collab_ProjectTeam_001">
    <bpmn:participant id="Participant_Team_001" name="Contract Project Team" processRef="Process_ContractManagement_001"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_ContractManagement_001" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_ProjectStarted_001" name="Contract Project Started">
      <bpmn:description>Project begins</bpmn:description>
      <bpmn:outgoing>SequenceFlow_QueryShops_001</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Query Web Shops Task -->
    <bpmn:task id="Task_QueryWebShops_001" name="Query Web Shops for Parts">
      <bpmn:description>Determine availability, price, and delivery time</bpmn:description>
      <bpmn:incoming>SequenceFlow_QueryShops_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ComparePrices_001</bpmn:outgoing>
    </bpmn:task>

    <!-- Compare Prices Task -->
    <bpmn:task id="Task_CompareAndSelect_001" name="Compare Prices & Select Cheapest">
      <bpmn:description>Select cheapest parts for order list</bpmn:description>
      <bpmn:incoming>SequenceFlow_ComparePrices_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckAvailability_001</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for Availability Check -->
    <bpmn:xorGateway id="Gateway_AvailabilityCheck_001" name="Sufficient Stock from One Shop?">
      <bpmn:description>If not enough, order from several shops</bpmn:description>
      <bpmn:incoming>SequenceFlow_CheckAvailability_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OrderMultipleShops_001</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PlaceOrderSingleShop_001</bpmn:outgoing>
    </bpmn:xorGateway>

    <!-- Task for Multiple Shops -->
    <bpmn:task id="Task_CreateOrderList_001" name="Create List (Split Order)">
      <bpmn:description>Create list of parts ordered from each shop</bpmn:description>
      <bpmn:incoming>SequenceFlow_OrderMultipleShops_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PlaceOrderMulti_001</bpmn:outgoing>
    </bpmn:task>

    <!-- Task for Placing Orders -->
    <bpmn:task id="Task_PlaceOrders_001" name="Place Orders">
      <bpmn:description>Send orders to selected web shops</bpmn:description>
      <bpmn:incoming>SequenceFlow_PlaceOrderSingleShop_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitForArrival_001</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow for Single Shop Order -->
    <bpmn:sequenceFlow id="SequenceFlow_PlaceOrderSingleShop_001" name="Yes">
      <bpmn:description>Sufficient stock from one shop</bpmn:description>
      <bpmn:sourceRef>Gateway_AvailabilityCheck_001</bpmn:sourceRef>
      <bpmn:targetRef>Task_PlaceOrders_001</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Sequence Flow for Multiple Shops Order -->
    <bpmn:sequenceFlow id="SequenceFlow_OrderMultipleShops_001" name="No">
      <bpmn:description>Need parts from several shops</bpmn:description>
      <bpmn:sourceRef>Gateway_AvailabilityCheck_001</bpmn:sourceRef>
      <bpmn:targetRef>Task_CreateOrderList_001</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Sequence Flow from Create Order List to Place Orders -->
    <bpmn:sequenceFlow id="SequenceFlow_PlaceOrderMulti_001" name="">
      <bpmn:description>Create order list then place orders</bpmn:description>
      <bpmn:sourceRef>Task_CreateOrderList_001</bpmn:sourceRef>
      <bpmn:targetRef>Task_PlaceOrders_001</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Intermediate Catch Event for Parts Arrival -->
    <bpmn:intermediateCatchEvent id="Event_PartsArrived_001" name="Parts Arrive">
      <bpmn:description>Batches arrive in random order (+/- 2 days)</bpmn:description>
      <bpmn:incoming>SequenceFlow_WaitForArrival_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StartBuilding_001</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task for Building -->
    <bpmn:task id="Task_BuildItem_001" name="Start Building">
      <bpmn:description>Begin construction when parts arrive</bpmn:description>
      <bpmn:incoming>SequenceFlow_StartBuilding_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckStockLoop_001</bpmn:outgoing>
    </bpmn:task>

    <!-- Task for Checking Stock -->
    <bpmn:task id="Task_CheckStock_001" name="Check Stock Level">
      <bpmn:description>Monitor stock of single parts during building</bpmn:description>
      <bpmn:incoming>SequenceFlow_StartBuilding_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Gateway_SinglePartCheck_001</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for Stock Check -->
    <bpmn:xorGateway id="Gateway_SinglePartCheck_001" name="Stock Level?">
      <bpmn:description>Monitor stock of single parts</bpmn:description>
      <bpmn:incoming>SequenceFlow_Gateway_SinglePartCheck_001</bpmn:incoming> <!-- Correction needed -->
    </bpmn:xorGateway>

    <!-- Correcting Gateway Incoming Flow Reference in XML Structure above (Logic fix) -->
    
  </bpmn:process>
</bpmn:definitions>