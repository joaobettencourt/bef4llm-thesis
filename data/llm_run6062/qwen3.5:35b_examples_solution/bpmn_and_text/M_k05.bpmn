<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_BuildingHouse" targetNamespace="http://bpmnio.com">
  <bpmn:collaboration id="Collab_TreehouseProcess">
    <bpmn:participant id="Participant_Customer" name="Customer" processRef="Proc_Customer"/>
    <bpmn:participant id="Participant_Architect" name="Architect" processRef="Proc_Architect"/>
  </bpmn:collaboration>

  <!-- Customer Process -->
  <bpmn:process id="Proc_Customer" isExecutable="false">
    
    <bpmn:startEvent id="Start_CollectRequirements" name="Collect requirements">
      <bpmn:outgoing>Seq_SendToArchitect</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_SendRequirements" name="Send to architect">
      <bpmn:incoming>Seq_SendToArchitect</bpmn:incoming>
      <bpmn:outgoing>Seq_WaitDraft</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:intermediateCatchEvent id="IntWait_DraftReceived" name="Receive draft">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>Seq_WaitDraft</bpmn:incoming>
      <bpmn:outgoing>Seq_RefineOrAccept</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:userTask id="Task_ReceiveRefinement" name="Refine requirements">
      <bpmn:incoming>Seq_SendToArchitect2</bpmn:incoming>
      <bpmn:outgoing>Seq_WaitDraft</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gw_DraftSufficient" name="Draft sufficient?">
      <bpmn:incoming>Seq_RefineOrAccept</bpmn:incoming>
      <bpmn:outgoing>Seq_SendToArchitect2</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_CreateMaterialList" name="Create material list">
      <bpmn:incoming>Seq_AcceptDraft</bpmn:incoming>
      <bpmn:outgoing>Seq_ParallelOrderAndFriends</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:parallelGateway id="Gw_OrderParallel" name="">
      <bpmn:incoming>Seq_ParallelOrderAndFriends</bpmn:incoming>
      <bpmn:outgoing>Seq_OnlineStores</bpmn:outgoing>
      <bpmn:outgoing>Seq_SendToFriends</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:userTask id="Task_OrderMaterials" name="Order from online stores">
      <bpmn:incoming>Seq_OnlineStores</bpmn:incoming>
      <bpmn:outgoing>Seq_WaitDelivery</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:intermediateCatchEvent id="IntWait_Delivery" name="Receive materials">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>Seq_WaitDelivery</bpmn:incoming>
      <bpmn:outgoing>Seq_ConvergeOrderFriends</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:userTask id="Task_SendToBuilders" name="Send messages to friends">
      <bpmn:incoming>Seq_SendToFriends</bpmn:incoming>
      <bpmn:outgoing>Seq_WaitConstructionDone</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:intermediateCatchEvent id="IntWait_Construction" name="House built">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>Seq_WaitConstructionDone</bpmn:incoming>
      <bpmn:outgoing>Seq_SendInvitations</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:userTask id="Task_SendPartyInvites" name="Send party invitations">
      <bpmn:incoming>Seq_SendInvitations</bpmn:incoming>
      <bpmn:outgoing>Seq_CreateGuestList</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_GuestList" name="Create guest list">
      <bpmn:incoming>Seq_CreateGuestList</bpmn:incoming>
      <bpmn:outgoing>Seq_EndProcess</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="End_ProcessComplete" name="Party ready">
      <bpmn:incoming>Seq_EndProcess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Seq_SendToArchitect" sourceRef="Start_CollectRequirements" targetRef="Task_SendRequirements"/>
    <bpmn:sequenceFlow id="Seq_WaitDraft" name="" sourceRef="Task_SendRequirements" targetRef="IntWait_DraftReceived"/>
    <bpmn:sequenceFlow id="Seq_RefineOrAccept" name="" sourceRef="IntWait_DraftReceived" targetRef="Gw_DraftSufficient"/>
    <bpmn:sequenceFlow id="Seq_SendToArchitect2" name="Send refinement" sourceRef="Task_ReceiveRefinement" targetRef="Start_CollectRequirements"/>
    <bpmn:sequenceFlow id="Seq_AcceptDraft" name="Yes" sourceRef="Gw_DraftSufficient" targetRef="Task_CreateMaterialList"/>
    <bpmn:sequenceFlow id="Seq_ParallelOrderAndFriends" name="" sourceRef="Task_CreateMaterialList" targetRef="Gw_OrderParallel"/>
    <bpmn:sequenceFlow id="Seq_OnlineStores" name="" sourceRef="Gw_OrderParallel" targetRef="Task_OrderMaterials"/>
    <bpmn:sequenceFlow id="Seq_SendToFriends" name="" sourceRef="Gw_OrderParallel" targetRef="Task_SendToBuilders"/>
    <bpmn:sequenceFlow id="Seq_WaitDelivery" name="" sourceRef="Task_OrderMaterials" targetRef="IntWait_Delivery"/>
    <bpmn:sequenceFlow id="Seq_ConvergeOrderFriends" name="" sourceRef="IntWait_Delivery" targetRef="Gw_ConvergeOrderFriends"/>
    <bpmn:parallelGateway id="Gw_ConvergeOrderFriends">
      <bpmn:incoming>Seq_WaitDelivery</bpmn:incoming>
      <bpmn:outgoing>Seq_SendInvitations</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="Seq_WaitConstructionDone" name="" sourceRef="Task_SendToBuilders" targetRef="IntWait_Construction"/>
    <bpmn:sequenceFlow id="Seq_SendInvitations" name="" sourceRef="IntWait_Construction" targetRef="Task_SendPartyInvites"/>
    <bpmn:sequenceFlow id="Seq_CreateGuestList" name="" sourceRef="Task_SendPartyInvites" targetRef="Task_GuestList"/>
    <bpmn:sequenceFlow id="Seq_EndProcess" name="" sourceRef="Task_GuestList" targetRef="End_ProcessComplete"/>

  </bpmn:process>

  <!-- Architect Process -->
  <bpmn:process id="Proc_Architect" isExecutable="false">
    
    <bpmn:startEvent id="Start_ReceiveRequirements" name="Receive requirements">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>Seq_CreateDraft</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_DraftPlan" name="Create draft plan">
      <bpmn:incoming>Seq_CreateDraft</bpmn:incoming>
      <bpmn:outgoing>Seq_SendToCustomer</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="End_DraftSent" name="Send draft">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>Seq_SendToCustomer</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flow -->
    <bpmn:sequenceFlow id="Seq_CreateDraft" name="" sourceRef="Start_ReceiveRequirements" targetRef="Task_DraftPlan"/>
  </bpmn:process>

  <!-- Message Flows between participants -->
  <bpmn:messageFlow id="Msg_SendToArchitect" name="Send requirements">
    <bpmn:sourceRef>Task_SendRequirements</bpmn:sourceRef>
    <bpmn:targetRef>Start_ReceiveRequirements</bpmn:targetRef>
  </bpmn:messageFlow>

  <bpmn:messageFlow id="Msg_DraftReceived" name="Draft plan">
    <bpmn:sourceRef>End_DraftSent</bpmn:sourceRef>
    <bpmn:targetRef>IntWait_DraftReceived</bpmn:targetRef>
  </bpmn:messageFlow>

</bpmn:definitions>