<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_InternshipProcess_01" targetNamespace="http://bpmnio.com">
  <bpmn:process id="Internship_Process_01" isExecutable="false">

    <!-- Start Event -->
    <bpmn:startEvent id="Start_Event_Apply" name="Internship Application">
      <bpmn:outgoing>Sequence_Flow_StartToDetails</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Enter Details -->
    <bpmn:userTask id="User_Task_Details" name="Enter Topic, Money, Experience &amp; Hobbies">
      <bpmn:incoming>Sequence_Flow_StartToDetails</bpmn:incoming>
      <bpmn:outgoing>Sequence_Flow_DetailsToOffers</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Service Task: Offers Arrival -->
    <bpmn:serviceTask id="Service_Task_Offers" name="Receive Internship Offers">
      <bpmn:incoming>Sequence_Flow_DetailsToOffers</bpmn:incoming>
      <bpmn:outgoing>Sequence_Flow_OfferDecision</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Gateway: Accept Offer -->
    <bpmn:exclusiveGateway id="Exclusive_Gateway_Accept" name="Accept Offer?">
      <bpmn:incoming>Sequence_Flow_OfferDecision</bpmn:incoming>
      <bpmn:outgoing>Sequence_Flow_YesOfferAccepted</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flow: Yes -->
    <bpmn:sequenceFlow id="Sequence_Flow_YesOfferAccepted" name="Accept" sourceRef="Exclusive_Gateway_Accept" targetRef="Parallel_Start_Internship">
      <bpmn:name>Accept</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Parallel Gateway: Start Internship Phase -->
    <bpmn:parallelGateway id="Parallel_Gateway_InternshipStart" name="Internship Starts">
      <bpmn:incoming>Sequence_Flow_YesOfferAccepted</bpmn:incoming>
      <bpmn:outgoing>Sequence_Flow_ApplicantUpdates</bpmn:outgoing>
      <bpmn:outgoing>Sequence_Flow_CompanyReviews</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Branch 1: Applicant Status Updates -->
    <bpmn:userTask id="User_Task_ApplicantUpdate" name="Write Internship Status Update">
      <bpmn:incoming>Sequence_Flow_ApplicantUpdates</bpmn:incoming>
      <bpmn:outgoing>Sequence_Flow_CheckApplicantCount</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway: Check Applicant Count -->
    <bpmn:exclusiveGateway id="Exclusive_Gateway_AppCheck" name="Updates &gt;= 3?">
      <bpmn:incoming>Sequence_Flow_CheckApplicantCount</bpmn:incoming>
      <bpmn:outgoing>Sequence_Flow_YesUpdateDone</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Loop Back for Applicant -->
    <bpmn:sequenceFlow id="Sequence_Floop_Applicant" name="No (Continue)" sourceRef="Exclusive_Gateway_AppCheck" targetRef="User_Task_ApplicantUpdate">
      <bpmn:name>No</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Branch 2: Company Reviews -->
    <bpmn:userTask id="Service_Task_CompanyReview" name="Company Writes Status Updates About You">
      <bpmn:incoming>Sequence_Flow_CompanyReviews</bpmn:incoming>
      <bpmn:outgoing>Sequence_Flow_CheckCompanyCount</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway: Check Company Count -->
    <bpmn:exclusiveGateway id="Exclusive_Gateway_CompanyCheck" name="Updates &gt;= 3?">
      <bpmn:incoming>Sequence_Flow_CheckCompanyCount</bpmn:incoming>
      <bpmn:outgoing>Sequence_Flow_YesUpdateDone2</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Loop Back for Company -->
    <bpmn:sequenceFlow id="Sequence_Floop_Company" name="No (Continue)" sourceRef="Exclusive_Gateway_CompanyCheck" targetRef="Service_Task_CompanyReview">
      <bpmn:name>No</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Parallel Gateway: Join Internship Phase -->
    <bpmn:parallelGateway id="Parallel_Gateway_InternshipEnd" name="">
      <bpmn:incoming>Sequence_Flow_YesUpdateDone</bpmn:incoming>
      <bpmn:incoming>Sequence_Flow_CompanyReviewJoin</bpmn:incoming>
    </bpmn:parallelGateway>

    <!-- Corrected Sequence Flows for Join Logic -->
    <bpmn:sequenceFlow id="Sequence_Flow_ApplicantDone" name="" sourceRef="Exclusive_Gateway_AppCheck" targetRef="Parallel_Gateway_InternshipEnd">
      <bpmn:name>Yes</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Corrected Sequence Flows for Join Logic -->
    <bpmn:sequenceFlow id="Sequence_Flow_CompanyDone" name="" sourceRef="Exclusive_Gateway_CompanyCheck" targetRef="Parallel_Gateway_InternshipEnd">
      <bpmn:name>Yes</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Decision: Recommend Company -->
    <bpmn:exclusiveGateway id="Exclusive_Gateway_Recommend" name="Recommend to Friends?">
      <bpmn:incoming>Sequence_Flow_InternshipEndToRec</bpmn:incoming>
      <bpmn:outgoing>Sequence_Flow_YesRecommend</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Enter Friends List -->
    <bpmn:userTask id="User_Task_EnterFriends" name="Enter Friend Twitter Accounts">
      <bpmn:incoming>Sequence_Flow_YesRecommend</bpmn:incoming>
      <bpmn:outgoing>Sequence_Flow_SendTweetsStart</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel Gateway for Tweets -->
    <bpmn:parallelGateway id="Parallel_Gateway_Tweets" name="">
      <bpmn:incoming>Sequence_Flow_SendTweetsStart</bpmn:incoming>
      <bpmn:outgoing>Sequence_Flow_SingleTweet1</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Service Task for Tweets (Parallel) -->
    <bpmn:serviceTask id="Service_Task_SendTweets" name="Send Separate Tweets in Parallel">
      <bpmn:incoming>Sequence_Flow_SingleTweet1</bpmn:incoming>
      <bpmn:outgoing>Sequence_Flow_TweetsToJoin</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Join Tweets -->
    <bpmn:parallelGateway id="Parallel_Gateway_TweetEnd" name="">
      <bpmn:incoming>Sequence_Flow_SingleTweet1</bpmn:incoming>
      <bpmn:outgoing>Sequence_Flow_EndProcess</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- End Event -->
    <bpmn:endEvent id="End_Event_Process" name="Internship Process Finished">
      <bpmn:incoming>Sequence_Flow_TweetsToJoin</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>