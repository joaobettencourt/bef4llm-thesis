<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_LuxuryAirplane" targetNamespace="http://bpmnio.com">
  <bpmn:collaboration id="Collab_AirplaneManufacturing">
    <bpmn:participant id="Participant_Manufacturer" name="Luxury Airplane Manufacturer" processRef="Proc_AirplaneProcess"/>
  </bpmn:collaboration>

  <bpmn:process id="Proc_AirplaneProcess" isExecutable="false">
    
    <!-- Lane Organization -->
    <bpmn:laneSet id="Lane_Set_01">
      <bpmn:lane id="Lane_SalesTeam" name="Sales Team">
        <bpmn:flowNodeRef>StartEvent_OrderReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DefineRequirements</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Manufacturing" name="Manufacturing Team">
        <bpmn:flowNodeRef>Gateway_CustomPartsNeeded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ManufactureVodkaBar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ManufactureWhiskeyBar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PartsConverge</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Assembly" name="Assembly Team">
        <bpmn:flowNodeRef>Task_AssembleInterior</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_TestSuccessful</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Quality" name="Quality Team">
        <bpmn:flowNodeRef>Task_TestFlight</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_CreateTestProtocol</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_OrderReceived" name="Order Received">
      <bpmn:outgoing>SequenceFlow_01_StartToRequirements</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Define Requirements (Customer Customization) -->
    <bpmn:userTask id="Task_DefineRequirements" name="Define Customer Specifications">
      <bpmn:incoming>SequenceFlow_01_StartToRequirements</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckCustomParts</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway: Check if custom parts needed -->
    <bpmn:xorGateway id="Gateway_CustomPartsNeeded" name="Base Model Only?">
      <bpmn:incoming>SequenceFlow_CheckCustomParts</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ManufactureStandard</bpmn:outgoing>
    </bpmn:xorGateway>

    <!-- Parallel Gateway for Manufacturing Different Parts -->
    <bpmn:parallelGateway id="ParallelGateway_PartsManufacturing" name="">
      <bpmn:incoming>SequenceFlow_CustomPartsRequired</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ManufactureVodkaBar</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Manufacture Vodka Bar (Russian Team) -->
    <bpmn:userTask id="Task_ManufactureVodkaBar" name="Manufacture Vodka Bar">
      <bpmn:incoming>SequenceFlow_ManufactureVodkaBar</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_VodkaReady</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Manufacture Whiskey Bar (Irish Team) -->
    <bpmn:userTask id="Task_ManufactureWhiskeyBar" name="Manufacture Whiskey Bar">
      <bpmn:incoming>SequenceFlow_CustomPartsRequired</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WhiskeyReady</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway: Converge Parts -->
    <bpmn:xorGateway id="Gateway_PartsConverge" name="">
      <bpmn:incoming>SequenceFlow_VodkaReady</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AssembleInterior</bpmn:outgoing>
    </bpmn:xorGateway>

    <!-- Task: Assemble Interior -->
    <bpmn:userTask id="Task_AssembleInterior" name="Assemble Plane Interior">
      <bpmn:incoming>SequenceFlow_AssembleInterior</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TestFlightPrep</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Test Flight -->
    <bpmn:userTask id="Task_TestFlight" name="Conduct Test Flight">
      <bpmn:incoming>SequenceFlow_TestFlightPrep</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CreateProtocol</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Service Task: Create Test Protocol -->
    <bpmn:serviceTask id="ServiceTask_CreateTestProtocol" name="Create Test Protocol">
      <bpmn:incoming>SequenceFlow_CreateProtocol</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckTestResult</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Gateway: Check if test successful -->
    <bpmn:xorGateway id="Gateway_TestSuccessful" name="Test Successful?">
      <bpmn:incoming>SequenceFlow_CheckTestResult</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DeliverPlane</bpmn:outgoing>
    </bpmn:xorGateway>

    <!-- Task: Fix Problems (if test fails) -->
    <bpmn:userTask id="Task_FixProblems" name="Fix Test Issues">
      <bpmn:incoming>SequenceFlow_TestFailed</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RetryTestFlight</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Deliver Plane -->
    <bpmn:userTask id="Task_DeliverPlane" name="Deliver to Customer">
      <bpmn:incoming>SequenceFlow_DeliverPlane</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CustomerConfirm</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_OrderCompleted" name="Order Completed">
      <bpmn:incoming>SequenceFlow_CustomerConfirm</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_01_StartToRequirements" sourceRef="StartEvent_OrderReceived" targetRef="Task_DefineRequirements"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_CheckCustomParts" name="" sourceRef="Task_DefineRequirements" targetRef="Gateway_CustomPartsNeeded"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ManufactureStandard" name="Yes - Standard Only" sourceRef="Gateway_CustomPartsNeeded" targetRef="ParallelGateway_PartsManufacturing"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_CustomPartsRequired" name="No - Custom Parts Needed" sourceRef="Gateway_CustomPartsNeeded" targetRef="ParallelGateway_PartsManufacturing"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ManufactureVodkaBar" sourceRef="ParallelGateway_PartsManufacturing" targetRef="Task_ManufactureVodkaBar"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_VodkaReady" name="" sourceRef="Task_ManufactureVodkaBar" targetRef="Gateway_PartsConverge"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_WhiskeyReady" name="" sourceRef="Task_ManufactureWhiskeyBar" targetRef="Gateway_PartsConverge"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_AssembleInterior" sourceRef="Gateway_PartsConverge" targetRef="Task_AssembleInterior"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_TestFlightPrep" name="" sourceRef="Task_AssembleInterior" targetRef="Task_TestFlight"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_CreateProtocol" name="" sourceRef="Task_TestFlight" targetRef="ServiceTask_CreateTestProtocol"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_CheckTestResult" name="" sourceRef="ServiceTask_CreateTestProtocol" targetRef="Gateway_TestSuccessful"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_DeliverPlane" name="Yes - Test Passed" sourceRef="Gateway_TestSuccessful" targetRef="Task_DeliverPlane"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_CustomerConfirm" name="" sourceRef="Task_DeliverPlane" targetRef="EndEvent_OrderCompleted"/>

  </bpmn:process>
</bpmn:definitions>