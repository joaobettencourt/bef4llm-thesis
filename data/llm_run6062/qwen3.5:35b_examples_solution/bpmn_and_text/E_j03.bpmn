<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_WorkAccident" targetNamespace="http://bpmnio.com">
  <bpmn:collaboration id="Collab_WorkAccidentProcess">
    <bpmn:participant id="Participant_EGovernmentSystem" name="Work Accident Reporting System" processRef="Proc_WorkAccidentReporting"/>
  </bpmn:collaboration>

  <bpmn:process id="Proc_WorkAccidentReporting" isExecutable="false">
    
    <!-- Lane Organization -->
    <bpmn:laneSet id="Lane_Set_01">
      <bpmn:lane id="Lane_VictimOrWitness" name="Victim / Witness">
        <bpmn:startEvent id="Start_AccidentOccurred" name="Accident Occurred"/>
        <bpmn:task id="Task_ReportToEmployer" name="Report to Employer Immediately"/>
      </bpmn:lane>

      <bpmn:lane id="Lane_EmployerOrSchool" name="Employer / School">
        <bpmn:startEvent id="Start_AccidentOccurred" name="Accident Occurred"/> <!-- Shared start -->
        <bpmn:task id="Task_AssessSeverity" name="Assess Severity &amp; Type"/>
        <bpmn:xorGateway id="Gateway_SeverityCheck" name="Fatality or Serious Injury?">
          <bpmn:incoming>SequenceFlow_01_AccidentReported</bpmn:incoming>
          <bpmn:outgoing>SequenceFlow_02_ReportInspectorate</bpmn:outgoing>
        </bpmn:xorGateway>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="Start_AccidentOccurred" name="Accident Occurred">
      <bpmn:outgoing>SequenceFlow_01_StartToReport</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task in Lane 1 -->
    <bpmn:task id="Task_ReportToEmployer" name="Report to Employer Immediately">
      <bpmn:incoming>SequenceFlow_01_StartToReport</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_02_AccidentReported</bpmn:outgoing>
    </bpmn:task>

    <!-- Task in Lane 2 -->
    <bpmn:task id="Task_AssessSeverity" name="Assess Severity &amp; Type">
      <bpmn:incoming>SequenceFlow_02_AccidentReported</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_03_SeverityCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway in Lane 2 -->
    <bpmn:xorGateway id="Gateway_SeverityCheck" name="Fatality or Serious Injury?">
      <bpmn:incoming>SequenceFlow_03_SeverityCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_04_ReportInspectorate</bpmn:outgoing>
    </bpmn:xorGateway>

    <!-- Sequence Flow 1 -->
    <bpmn:sequenceFlow id="SequenceFlow_01_StartToReport" name="">
      <bpmn:sourceRef>Start_AccidentOccurred</bpmn:sourceRef>
      <bpmn:targetRef>Task_ReportToEmployer</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Sequence Flow 2 -->
    <bpmn:sequenceFlow id="SequenceFlow_02_AccidentReported" name="">
      <bpmn:sourceRef>Task_ReportToEmployer</bpmn:sourceRef>
      <bpmn:targetRef>Gateway_SeverityCheck</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Sequence Flow 3 -->
    <bpmn:sequenceFlow id="SequenceFlow_03_SeverityCheck" name="">
      <bpmn:sourceRef>Task_AssessSeverity</bpmn:sourceRef>
      <bpmn:targetRef>Gateway_SeverityCheck</bpmn:targetRef>
    </bpmn:sequenceFlow>

  </bpmn:process>

</bpmn:definitions>