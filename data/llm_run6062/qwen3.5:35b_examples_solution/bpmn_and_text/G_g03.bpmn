<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_BlizzardCharacterGenerator" targetNamespace="http://bpmnio.com">
  <bpmn:collaboration id="Collab_001">
    <bpmn:participant id="Participant_Retailer" name="Blizzard Online Character Generator" processRef="Process_CharacterCreation"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_CharacterCreation" isExecutable="false">
    
    <!-- Lane Organization -->
    <bpmn:laneSet id="Lane_Set_01">
      <bpmn:lane id="Lane_UserActions" name="User Actions">
        <bpmn:flowNodeRef>StartEvent_NewCharacter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CreateBattleNetAccountTask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SelectPaymentMethodTask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CreditCardInfoTask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BankAccountInfoTask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LoginGameTask</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_SystemTasks" name="System Tasks">
        <bpmn:flowNodeRef>CheckBattleNetAccountService</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EmailConfirmationTask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ConfirmEmailLinkTask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CheckWoWSubscriptionService</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SelectRealmTask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SelectRaceTask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SelectClassTask</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_NewCharacter" name="New WoW character wanted">
      <bpmn:outgoing>SequenceFlow_CheckBattleNet</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Service Task - Check Battle.net Account -->
    <bpmn:serviceTask id="CheckBattleNetAccountService" name="Check existence of battle.net account">
      <bpmn:incoming>SequenceFlow_CheckBattleNet</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BattleNetDecision</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Exclusive Gateway - Battle.net Account Exists? -->
    <bpmn:xorGateway id="BattleNetAccountExists" name="battle.net account exists?">
      <bpmn:incoming>SequenceFlow_BattleNetDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CreateNewAccount</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CheckSubscription</bpmn:outgoing>
    </bpmn:xorGateway>

    <!-- Manual Task - Create New Battle.net Account -->
    <bpmn:userTask id="CreateBattleNetAccountTask" name="Create new battle.net account">
      <bpmn:incoming>SequenceFlow_CreateNewAccount</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EmailConfirmation</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Service Task - Receive Email -->
    <bpmn:serviceTask id="EmailConfirmationTask" name="Receive email with confirmation link">
      <bpmn:incoming>SequenceFlow_EmailConfirmation</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConfirmLinkClick</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Manual Task - Confirm Email Link -->
    <bpmn:userTask id="ConfirmEmailLinkTask" name="Confirm account information via email link">
      <bpmn:incoming>SequenceFlow_ConfirmLinkClick</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SubscriptionCheckMerge</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Service Task - Check WoW Subscription -->
    <bpmn:serviceTask id="CheckWoWSubscriptionService" name="Check WoW subscription">
      <bpmn:incoming>SequenceFlow_CheckSubscription</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SubscriptionDecision</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Exclusive Gateway - Subscription Present? -->
    <bpmn:xorGateway id="SubscriptionPresent" name="Subscription present?">
      <bpmn:incoming>SequenceFlow_SubscriptionDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SelectPaymentMethod</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_LoginGameMerge</bpmn:outgoing>
    </bpmn:xorGateway>

    <!-- Manual Task - Select Payment Method -->
    <bpmn:userTask id="SelectPaymentMethodTask" name="Select payment method">
      <bpmn:incoming>SequenceFlow_SelectPaymentMethod</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PaymentDecision</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Exclusive Gateway - Payment Method? -->
    <bpmn:xorGateway id="PaymentMethodChoice" name="Payment Method?">
      <bpmn:incoming>SequenceFlow_PaymentDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CreditCardInfo</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_BankAccountInfo</bpmn:outgoing>
    </bpmn:xorGateway>

    <!-- Manual Task - Enter Credit Card Info -->
    <bpmn:userTask id="CreditCardInfoTask" name="Enter credit card information">
      <bpmn:incoming>SequenceFlow_CreditCardInfo</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PaymentMerge1</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Manual Task - Enter Bank Account Info -->
    <bpmn:userTask id="BankAccountInfoTask" name="Enter bank account information">
      <bpmn:incoming>SequenceFlow_BankAccountInfo</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PaymentMerge2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Exclusive Gateway - Payment Merge -->
    <bpmn:xorGateway id="PaymentMethodMerge" name="">
      <bpmn:incoming>SequenceFlow_PaymentMerge1</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_PaymentMerge2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_LoginGameStart</bpmn:outgoing>
    </bpmn:xorGateway>

    <!-- Manual Task - Login Game -->
    <bpmn:userTask id="LoginGameTask" name="Log into the game">
      <bpmn:incoming>SequenceFlow_LoginGameMerge</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_LoginGameStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CharacterCreationStart</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel Gateway - Character Creation Start -->
    <bpmn:parallelGateway id="CharacterCreationParallel" name="">
      <bpmn:incoming>SequenceFlow_CharacterCreationStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SelectRealm</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SelectRace</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SelectClass</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Service Task - Select Realm -->
    <bpmn:userTask id="SelectRealmTask" name="Select realm of your character">
      <bpmn:incoming>SequenceFlow_SelectRealm</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RealmComplete</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Service Task - Select Race -->
    <bpmn:userTask id="SelectRaceTask" name="Select race of your character">
      <bpmn:incoming>SequenceFlow_SelectRace</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RaceComplete</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Service Task - Select Class -->
    <bpmn:userTask id="SelectClassTask" name="Select class of your character">
      <bpmn:incoming>SequenceFlow_SelectClass</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ClassComplete</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel Gateway - Character Creation Merge -->
    <bpmn:parallelGateway id="CharacterCreationMerge" name="">
      <bpmn:incoming>SequenceFlow_RealmComplete</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_RaceComplete</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ClassComplete</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NameEntryStart</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Manual Task - Enter Character Name -->
    <bpmn:userTask id="EnterCharacterName" name="Enter character name">
      <bpmn:incoming>SequenceFlow_NameEntryStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckNameAvailability</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Service Task - Check Name Availability -->
    <bpmn:serviceTask id="CheckNameAvailability" name="Check availability of character name">
      <bpmn:incoming>SequenceFlow_CheckNameAvailability</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NameAvailableDecision</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Exclusive Gateway - Name Available? -->
    <bpmn:xorGateway id="NameAvailable" name="Character name available?">
      <bpmn:incoming>SequenceFlow_NameAvailableDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RetryNameEntry</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ConfirmationSent</bpmn:outgoing>
    </bpmn:xorGateway>

    <!-- Service Task - Receive Confirmation -->
    <bpmn:serviceTask id="ReceiveConfirmation" name="Receive confirmation and character selfies">
      <bpmn:incoming>SequenceFlow_ConfirmationSent</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProcessComplete</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_CharacterCreated" name="Character created">
      <bpmn:incoming>SequenceFlow_ProcessComplete</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows - Account Setup Path (No Battle.net) -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckBattleNet" name="" sourceRef="StartEvent_NewCharacter" targetRef="CheckBattleNetAccountService"/>
    <bpmn:sequenceFlow id="SequenceFlow_CreateNewAccount" name="no" sourceRef="BattleNetAccountExists" targetRef="CreateBattleNetAccountTask">
      <bpmn:name>no</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Sequence Flows - Account Setup Path (Has Battle.net) -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckSubscription" name="yes" sourceRef="BattleNetAccountExists" targetRef="CheckWoWSubscriptionService">
      <bpmn:name>yes</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Sequence Flows - Email Confirmation Path -->
    <bpmn:sequenceFlow id="SequenceFlow_EmailConfirmation" name="" sourceRef="CreateBattleNetAccountTask" targetRef="EmailConfirmationTask"/>
    <bpmn:sequenceFlow id="SequenceFlow_ConfirmLinkClick" name="" sourceRef="EmailConfirmationTask" targetRef="ConfirmEmailLinkTask"/>

    <!-- Sequence Flows - Subscription Check Path -->
    <bpmn:sequenceFlow id="SequenceFlow_SubscriptionDecision" name="" sourceRef="CheckWoWSubscriptionService" targetRef="SubscriptionPresent"/>
    <bpmn:sequenceFlow id="SequenceFlow_SelectPaymentMethod" name="no" sourceRef="SubscriptionPresent" targetRef="SelectPaymentMethodTask">
      <bpmn:name>no</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Sequence Flows - Payment Method Selection -->
    <bpmn:sequenceFlow id="SequenceFlow_PaymentDecision" name="" sourceRef="SelectPaymentMethodTask" targetRef="PaymentMethodChoice"/>
    <bpmn:sequenceFlow id="SequenceFlow_CreditCardInfo" name="Credit Card" sourceRef="PaymentMethodChoice" targetRef="CreditCardInfoTask">
      <bpmn:name>Credit Card</bpmn:name>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_BankAccountInfo" name="Bank account" sourceRef="PaymentMethodChoice" targetRef="BankAccountInfoTask">
      <bpmn:name>Bank account</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Sequence Flows - Payment Merge -->
    <bpmn:sequenceFlow id="SequenceFlow_PaymentMerge1" name="" sourceRef="CreditCardInfoTask" targetRef="PaymentMethodMerge"/>
    <bpmn:sequenceFlow id="SequenceFlow_PaymentMerge2" name="" sourceRef="BankAccountInfoTask" targetRef="PaymentMethodMerge"/>

    <!-- Sequence Flows - Login Game Path -->
    <bpmn:sequenceFlow id="SequenceFlow_LoginGameStart" name="" sourceRef="PaymentMethodMerge" targetRef="LoginGameTask"/>
    <bpmn:sequenceFlow id="SequenceFlow_SubscriptionCheckMerge" name="" sourceRef="ConfirmEmailLinkTask" targetRef="SubscriptionPresent"/>

    <!-- Sequence Flows - Character Creation Parallel Path -->
    <bpmn:sequenceFlow id="SequenceFlow_CharacterCreationStart" name="" sourceRef="LoginGameTask" targetRef="CharacterCreationParallel"/>
    <bpmn:sequenceFlow id="SequenceFlow_SelectRealm" name="" sourceRef="CharacterCreationParallel" targetRef="SelectRealmTask"/>
    <bpmn:sequenceFlow id="SequenceFlow_SelectRace" name="" sourceRef="CharacterCreationParallel" targetRef="SelectRaceTask"/>
    <bpmn:sequenceFlow id="SequenceFlow_SelectClass" name="" sourceRef="CharacterCreationParallel" targetRef="SelectClassTask"/>

    <!-- Sequence Flows - Character Creation Merge -->
    <bpmn:sequenceFlow id="SequenceFlow_RealmComplete" name="" sourceRef="SelectRealmTask" targetRef="CharacterCreationMerge"/>
    <bpmn:sequenceFlow id="SequenceFlow_RaceComplete" name="" sourceRef="SelectRaceTask" targetRef="CharacterCreationMerge"/>
    <bpmn:sequenceFlow id="SequenceFlow_ClassComplete" name="" sourceRef="SelectClassTask" targetRef="CharacterCreationMerge"/>

    <!-- Sequence Flows - Name Entry Path -->
    <bpmn:sequenceFlow id="SequenceFlow_NameEntryStart" name="" sourceRef="CharacterCreationMerge" targetRef="EnterCharacterName"/>
    <bpmn:sequenceFlow id="SequenceFlow_CheckNameAvailability" name="" sourceRef="EnterCharacterName" targetRef="CheckNameAvailability"/>

    <!-- Sequence Flows - Name Availability Decision -->
    <bpmn:sequenceFlow id="SequenceFlow_NameAvailableDecision" name="" sourceRef="CheckNameAvailability" targetRef="NameAvailable"/>
    <bpmn:sequenceFlow id="SequenceFlow_RetryNameEntry" name="no" sourceRef="NameAvailable" targetRef="CharacterCreationMerge">
      <bpmn:name>no</bpmn:name>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_ConfirmationSent" name="yes" sourceRef="NameAvailable" targetRef="ReceiveConfirmation">
      <bpmn:name>yes</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Sequence Flows - Process Completion -->
    <bpmn:sequenceFlow id="SequenceFlow_ProcessComplete" name="" sourceRef="ReceiveConfirmation" targetRef="EndEvent_CharacterCreated"/>

  </bpmn:process>
</bpmn:definitions>