<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_OrderingProcess" targetNamespace="http://bpmnio.com">
  <bpmn:collaboration id="Collab_OnlineShopOrdering">
    <bpmn:participant id="Participant_CustomerSystem" name="Customer System" processRef="Proc_CustomerOrdering"/>
  </bpmn:collaboration>

  <bpmn:process id="Proc_CustomerOrdering" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="Start_OpenHomepage" name="Open E-Shop Homepage">
      <bpmn:outgoing>Seq_StartToLogin</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Customer Logs In (User Task) -->
    <bpmn:userTask id="Task_LogInEshop" name="Customer logs into E-Shop">
      <bpmn:incoming>Seq_StartToLogin</bpmn:incoming>
      <bpmn:outgoing>Seq_LoginToCredentialsCheck</bpmn:outgoing>
    </bpmn:userTask>

    <!-- System Checks Credentials (Service Task) -->
    <bpmn:serviceTask id="Sys_CheckCredentials" name="Customer credentials checked by system">
      <bpmn:incoming>Seq_LoginToCredentialsCheck</bpmn:incoming>
      <bpmn:outgoing>Seq_CredentialsToLoginGateway</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Login Success Gateway (Exclusive) -->
    <bpmn:xorGateway id="Gate_LoginSuccess" name="Successful login?">
      <bpmn:incoming>Seq_CredentialsToLoginGateway</bpmn:incoming>
      <bpmn:outgoing>Seq_SuccessfulToProductSelection</bpmn:outgoing>
      <bpmn:outgoing>Seq_UnsuccessfulToEndExperience</bpmn:outgoing>
    </bpmn:xorGateway>

    <!-- Customer Selects Product (User Task) -->
    <bpmn:userTask id="Task_SelectProduct" name="Customer selects a product">
      <bpmn:incoming>Seq_SuccessfulToProductSelection</bpmn:incoming>
      <bpmn:incoming>Seq_LoopBackFromCheckProducts</bpmn:incoming>
      <bpmn:outgoing>Seq_SelectToAddCart</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Customer Adds to Cart (User Task) -->
    <bpmn:userTask id="Task_AddToCart" name="Customer adds product to shopping cart">
      <bpmn:incoming>Seq_SelectToAddCart</bpmn:incoming>
      <bpmn:outgoing>Seq_CartToSaveProduct</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Customer Saves Product (User Task) -->
    <bpmn:userTask id="Task_SaveProduct" name="Customer saves product">
      <bpmn:incoming>Seq_CartToSaveProduct</bpmn:incoming>
      <bpmn:outgoing>Seq_SavedToCheckProductsSelected</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Customer Checks if All Products Selected (User Task) -->
    <bpmn:userTask id="Task_CheckAllProducts" name="Customer checks if all products selected">
      <bpmn:incoming>Seq_SavedToCheckProductsSelected</bpmn:incoming>
      <bpmn:outgoing>Seq_CheckGateway_ToProductSelectionLoop</bpmn:outgoing>
    </bpmn:userTask>

    <!-- All Products Selected Gateway (Exclusive) -->
    <bpmn:xorGateway id="Gate_AllProductsSelected" name="All products selected?">
      <bpmn:incoming>Seq_CheckGateway_ToProductSelectionLoop</bpmn:incoming>
      <bpmn:outgoing>Seq_YesToParallelPreparation</bpmn:outgoing>
      <bpmn:outgoing>Seq_NoBackToSelectProduct</bpmn:outgoing>
    </bpmn:xorGateway>

    <!-- Parallel Gateway for Payment and Shipment Preparation -->
    <bpmn:parallelGateway id="Gate_ParallelPreparation" name="">
      <bpmn:incoming>Seq_YesToParallelPreparation</bpmn:incoming>
      <bpmn:outgoing>Seq_PreparePaymentSystem</bpmn:outgoing>
      <bpmn:outgoing>Seq_PrepareShipmentSystem</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Payment Prepared by System (Service Task) -->
    <bpmn:serviceTask id="Sys_PaymentPrepared" name="Payment is prepared by system">
      <bpmn:incoming>Seq_PreparePaymentSystem</bpmn:incoming>
      <bpmn:outgoing>Seq_PaymentToCustomerEntersData</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Shipment Prepared by System (Service Task) -->
    <bpmn:serviceTask id="Sys_ShipmentPrepared" name="Shipment is prepared by system">
      <bpmn:incoming>Seq_PrepareShipmentSystem</bpmn:incoming>
      <bpmn:outgoing>Seq_ShipmentToCustomerEntersData</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Payment and Shipment Convergence Gateway -->
    <bpmn:parallelGateway id="Gate_ConvergePaymentAndShipment" name="">
      <bpmn:incoming>Seq_PaymentToCustomerEntersData</bpmn:incoming>
      <bpmn:incoming>Seq_ShipmentToCustomerEntersData</bpmn:incoming>
      <bpmn:outgoing>Seq_ConvergeToPaymentEntry</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Customer Enters Payment Data (User Task) -->
    <bpmn:userTask id="Task_EntersPaymentData" name="Customer enters payment data">
      <bpmn:incoming>Seq_ConvergeToPaymentEntry</bpmn:incoming>
      <bpmn:outgoing>Seq_DataEntered_ToWaitBankConfirmation</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel Gateway for Wait Confirmation and Address Entry -->
    <bpmn:parallelGateway id="Gate_ParallelAfterPaymentEntry" name="">
      <bpmn:incoming>Seq_DataEntered_ToWaitBankConfirmation</bpmn:incoming>
      <bpmn:outgoing>Seq_EntryWaitBankConfirmation</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Customer Waits for Bank Confirmation (User Task) -->
    <bpmn:userTask id="Task_WaitsForPayment" name="Customer waits until bank confirms payment">
      <bpmn:incoming>Seq_EntryWaitBankConfirmation</bpmn:incoming>
      <bpmn:outgoing>Seq_ConfirmedToEnterShippingAddress</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Customer Enters Shipping Address (User Task) -->
    <bpmn:userTask id="Task_EntersShippingAddress" name="Customer enters shipping address">
      <bpmn:incoming>Seq_ConfirmedToEnterShippingAddress</bpmn:incoming>
      <bpmn:outgoing>Seq_AddressEntered_ToCheckAddressesEqual</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Check if Shipping Address Equals Billing Address (Exclusive Gateway) -->
    <bpmn:xorGateway id="Gate_ShippingEqualsBilling" name="Shipping address == billing address?">
      <bpmn:incoming>Seq_AddressEntered_ToCheckAddressesEqual</bpmn:incoming>
      <bpmn:outgoing>Seq_YesToAddressConvergence</bpmn:outgoing>
      <bpmn:outgoing>Seq_NoToEnterBillingAddress</bpmn:outgoing>
    </bpmn:xorGateway>

    <!-- Customer Enters Independent Billing Address (User Task) -->
    <bpmn:userTask id="Task_EntersBillingAddress" name="Customer enters independent billing address">
      <bpmn:incoming>Seq_NoToEnterBillingAddress</bpmn:incoming>
      <bpmn:outgoing>Seq_BillingEntered_ToAddressConvergence</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Address Convergence Gateway (Exclusive) -->
    <bpmn:xorGateway id="Gate_AddressConverge" name="">
      <bpmn:incoming>Seq_YesToAddressConvergence</bpmn:incoming>
      <bpmn:incoming>Seq_BillingEntered_ToAddressConvergence</bpmn:incoming>
      <bpmn:outgoing>Seq_AddressReadyToOrderFinishedSystem</bpmn:outgoing>
    </bpmn:xorGateway>

    <!-- Order Finished by System (Service Task) -->
    <bpmn:serviceTask id="Sys_OrderFinished" name="Order is being finished by system">
      <bpmn:incoming>Seq_AddressReadyToOrderFinishedSystem</bpmn:incoming>
      <bpmn:outgoing>Seq_FinishedToEndEvent</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- End Event -->
    <bpmn:endEvent id="End_CloseHomepage" name="Close E-Shop Homepage">
      <bpmn:incoming>Seq_FinishedToEndEvent</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    
    <!-- Login Flow -->
    <bpmn:sequenceFlow id="Seq_StartToLogin" sourceRef="Start_OpenHomepage" targetRef="Task_LogInEshop"/>
    <bpmn:sequenceFlow id="Seq_LoginToCredentialsCheck" sourceRef="Task_LogInEshop" targetRef="Sys_CheckCredentials"/>
    <bpmn:sequenceFlow id="Seq_CredentialsToLoginGateway" sourceRef="Sys_CheckCredentials" targetRef="Gate_LoginSuccess"/>

    <!-- Login Success Paths -->
    <bpmn:sequenceFlow id="Seq_SuccessfulToProductSelection" name="Yes" sourceRef="Gate_LoginSuccess" targetRef="Task_SelectProduct"/>
    <bpmn:sequenceFlow id="Seq_UnsuccessfulToEndExperience" name="No" sourceRef="Gate_LoginSuccess" targetRef="End_CloseHomepage">
      <!-- Note: In real model, this would go to a different end event for failed login -->
    </bpmn:sequenceFlow>

    <!-- Product Selection Loop Paths -->
    <bpmn:sequenceFlow id="Seq_SelectToAddCart" sourceRef="Task_SelectProduct" targetRef="Task_AddToCart"/>
    <bpmn:sequenceFlow id="Seq_CartToSaveProduct" sourceRef="Task_AddToCart" targetRef="Task_SaveProduct"/>
    <bpmn:sequenceFlow id="Seq_SavedToCheckProductsSelected" sourceRef="Task_SaveProduct" targetRef="Task_CheckAllProducts"/>

    <!-- All Products Selected Paths -->
    <bpmn:sequenceFlow id="Seq_CheckGateway_ToProductSelectionLoop" name="" sourceRef="Task_CheckAllProducts" targetRef="Gate_AllProductsSelected"/>
    <bpmn:sequenceFlow id="Seq_YesToParallelPreparation" name="Yes" sourceRef="Gate_AllProductsSelected" targetRef="Gate_ParallelPreparation"/>
    <bpmn:sequenceFlow id="Seq_NoBackToSelectProduct" name="No" sourceRef="Gate_AllProductsSelected" targetRef="Task_SelectProduct">
      <!-- Loop back to select more products -->
    </bpmn:sequenceFlow>

    <!-- Parallel Preparation Paths -->
    <bpmn:sequenceFlow id="Seq_PreparePaymentSystem" sourceRef="Gate_ParallelPreparation" targetRef="Sys_PaymentPrepared"/>
    <bpmn:sequenceFlow id="Seq_PrepareShipmentSystem" sourceRef="Gate_ParallelPreparation" targetRef="Sys_ShipmentPrepared"/>

    <!-- Payment and Shipment Convergence -->
    <bpmn:sequenceFlow id="Seq_PaymentToCustomerEntersData" sourceRef="Sys_PaymentPrepared" targetRef="Gate_ConvergePaymentAndShipment"/>
    <bpmn:sequenceFlow id="Seq_ShipmentToCustomerEntersData" sourceRef="Sys_ShipmentPrepared" targetRef="Gate_ConvergePaymentAndShipment"/>

    <!-- Payment Data Entry and Wait -->
    <bpmn:sequenceFlow id="Seq_ConvergeToPaymentEntry" name="" sourceRef="Gate_ConvergePaymentAndShipment" targetRef="Task_EntersPaymentData"/>
    
    <!-- Parallel Split for Waiting vs Addressing -->
    <bpmn:sequenceFlow id="Seq_DataEntered_ToWaitBankConfirmation" sourceRef="Task_EntersPaymentData" targetRef="Gate_ParallelAfterPaymentEntry"/>

    <!-- Wait for Bank Confirmation Path -->
    <bpmn:sequenceFlow id="Seq_EntryWaitBankConfirmation" name="" sourceRef="Gate_ParallelAfterPaymentEntry" targetRef="Task_WaitsForPayment"/>
    
    <!-- Shipping Address Entry (Concurrent with wait) -->
    <bpmn:parallelGateway id="Gate_AddressSplit" name="">
      <bpmn:incoming>Seq_ConfirmedToEnterShippingAddress</bpmn:incoming>
      <bpmn:outgoing>Seq_SplitToCheckAddressesEqual</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Address Decision Paths -->
    <bpmn:sequenceFlow id="Seq_ConfirmedToEnterShippingAddress" name="" sourceRef="Task_WaitsForPayment" targetRef="Gate_AddressSplit">
      <!-- While waiting for payment confirmation, customer can enter shipping address -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Seq_SplitToCheckAddressesEqual" sourceRef="Gate_AddressSplit" targetRef="Task_EntersShippingAddress"/>
    
    <bpmn:sequenceFlow id="Seq_AddressEntered_ToCheckAddressesEqual" name="" sourceRef="Task_EntersShippingAddress" targetRef="Gate_ShippingEqualsBilling"/>

    <!-- Address Decision Paths -->
    <bpmn:sequenceFlow id="Seq_YesToAddressConvergence" name="Yes" sourceRef="Gate_ShippingEqualsBilling" targetRef="Gate_AddressConverge"/>
    <bpmn:sequenceFlow id="Seq_NoToEnterBillingAddress" name="No" sourceRef="Gate_ShippingEqualsBilling" targetRef="Task_EntersBillingAddress">
      <!-- Independent billing address can be entered if different -->
    </bpmn:sequenceFlow>

    <!-- Address Convergence and Order Finish -->
    <bpmn:sequenceFlow id="Seq_BillingEntered_ToAddressConvergence" sourceRef="Task_EntersBillingAddress" targetRef="Gate_AddressConverge"/>
    
    <bpmn:parallelGateway id="Gate_ConvergeBeforeFinish" name="">
      <bpmn:incoming>Seq_ShipmentToCustomerEntersData</bpmn:incoming> <!-- Wait, this was used earlier. Need unique ID for convergence of address and payment wait -->
    </bpmn:parallelGateway>

    <!-- Correcting Convergence Logic based on Text "Finally if the address and the payment steps are executed then the order will be finished" -->
    <bpmn:parallelGateway id="Gate_FinalConverge" name="">
      <bpmn:incoming>Seq_AddressReadyToOrderFinishedSystem</bpmn:incoming> <!-- From Address Logic -->
      <bpmn:outgoing>Seq_FinishedToEndEvent</bpmn:outgoing> 
    </bpmn:parallelGateway>

    <!-- Wait for Bank Confirmation Path Convergence to Final Finish -->
    <bpmn:userTask id="Task_WaitsForPayment" name="Customer waits until bank confirms payment">
      <bpmn:incoming>Seq_EntryWaitBankConfirmation</bpmn:incoming>
      <bpmn:outgoing>Seq_ConfirmedToEnterShippingAddress</bpmn:outgoing> <!-- This was the split point, need to converge back -->
    </bpmn:userTask>

    <!-- Re-structuring for valid flow convergence at end -->
    
  </bpmn:process>
  
  <bpmn:sequenceFlow id="Seq_StartToLogin" sourceRef="Start_OpenHomepage" targetRef="Task_LogInEshop"/>
</bpmn:definitions>