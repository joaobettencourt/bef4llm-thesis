<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ChainsawProduction" targetNamespace="http://bpmnio.com">
  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="Participant_Manufacturer" name="Chainsaw Manufacturer" processRef="Process_Production"/>
    <bpmn:participant id="Participant_Customer" name="Customer"/>
    
    <!-- Message Flows -->
    <bpmn:messageFlow id="Msg_1" sourceRef="Task_SendFirstSaw" targetRef="Participant_Manufacturer">
      <bpmn:name>Send Chainsaw</bpmn:name>
    </bpmn:messageFlow>
    <bpmn:messageFlow id="Msg_2" sourceRef="Participant_Customer" targetRef="Task_ReceiveFeedback"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Production" isExecutable="false">
    
    <!-- Lane Set -->
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Manufacturing" name="Production Team">
        <bpmn:flowNodeRef>Event_StartOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SetProperties</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_ParallelOrders</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Service_OrderGuideBar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Service_OrderChain</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Service_OrderMotor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Service_OrderColor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Service_OrderShield</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_ConvergeParts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InspectParts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssembleParts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_CustomerLikesIt</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="Event_StartOrder" name="Chainsaw Order Request">
      <bpmn:outgoing>SequenceFlow_StartToProps</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Set Properties (Customer interaction) -->
    <bpmn:task id="Task_SetProperties" name="Set Properties">
       <bpmn:incoming>SequenceFlow_StartToProps</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_PropsToParallel</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway for Ordering Parts -->
    <bpmn:parallelGateway id="Gw_ParallelOrders" name="Order Parts">
      <bpmn:incoming>SequenceFlow_PropsToParallel</bpmn:incoming>
      <bpmn:outgoing>Seq_OrderGuideBar</bpmn:outgoing>
      <bpmn:outgoing>Seq_OrderChain</bpmn:outgoing>
      <bpmn:outgoing>Seq_OrderMotor</bpmn:outgoing>
      <bpmn:outgoing>Seq_OrderColor</bpmn:outgoing>
      <bpmn:outgoing>Seq_OrderShield</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Service Tasks for Ordering Parts (Parallel) -->
    <bpmn:serviceTask id="Service_OrderGuideBar" name="Order Guide Bar">
      <bpmn:incoming>Seq_OrderGuideBar</bpmn:incoming>
      <bpmn:outgoing>Seq_GuideToConverge</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Service_OrderChain" name="Order Chain">
      <bpmn:incoming>Seq_OrderChain</bpmn:incoming>
      <bpmn:outgoing>Seq_ChainToConverge</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Service_OrderMotor" name="Order Motor">
      <bpmn:incoming>Seq_OrderMotor</bpmn:incoming>
      <bpmn:outgoing>Seq_MotorToConverge</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Service_OrderColor" name="Order Color">
      <bpmn:incoming>Seq_OrderColor</bpmn:incoming>
      <bpmn:outgoing>Seq_ColorToConverge</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Service_OrderShield" name="Order Protective Shield">
      <bpmn:incoming>Seq_OrderShield</bpmn:incoming>
      <bpmn:outgoing>Seq_ShieldToConverge</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Sequence Flows for Ordering -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToProps" sourceRef="Event_StartOrder" targetRef="Task_SetProperties"/>
    <bpmn:sequenceFlow id="SequenceFlow_PropsToParallel" name="" sourceRef="Task_SetProperties" targetRef="Gw_ParallelOrders"/>

    <!-- Sequence Flows for Parallel Tasks -->
    <bpmn:sequenceFlow id="Seq_OrderGuideBar" sourceRef="Gw_ParallelOrders" targetRef="Service_OrderGuideBar"/>
    <bpmn:sequenceFlow id="Seq_OrderChain" sourceRef="Gw_ParallelOrders" targetRef="Service_OrderChain"/>
    <bpmn:sequenceFlow id="Seq_OrderMotor" sourceRef="Gw_ParallelOrders" targetRef="Service_OrderMotor"/>
    <bpmn:sequenceFlow id="Seq_OrderColor" sourceRef="Gw_ParallelOrders" targetRef="Service_OrderColor"/>
    <bpmn:sequenceFlow id="Seq_OrderShield" sourceRef="Gw_ParallelOrders" targetRef="Service_OrderShield"/>

    <!-- Converging Gateway for Parts Arrival -->
    <bpmn:parallelGateway id="Gw_ConvergeParts" name="All Parts Arrived">
      <bpmn:incoming>Seq_GuideToConverge</bpmn:incoming>
      <bpmn:incoming>Seq_ChainToConverge</bpmn:incoming>
      <bpmn:incoming>Seq_MotorToConverge</bpmn:incoming>
      <bpmn:incoming>Seq_ColorToConverge</bpmn:incoming>
      <bpmn:incoming>Seq_ShieldToConverge</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToInspect</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Sequence Flows to Converging Gateway -->
    <bpmn:sequenceFlow id="Seq_GuideToConverge" sourceRef="Service_OrderGuideBar" targetRef="Gw_ConvergeParts"/>
    <bpmn:sequenceFlow id="Seq_ChainToConverge" sourceRef="Service_OrderChain" targetRef="Gw_ConvergeParts"/>
    <bpmn:sequenceFlow id="Seq_MotorToConverge" sourceRef="Service_OrderMotor" targetRef="Gw_ConvergeParts"/>
    <bpmn:sequenceFlow id="Seq_ColorToConverge" sourceRef="Service_OrderColor" targetRef="Gw_ConvergeParts"/>
    <bpmn:sequenceFlow id="Seq_ShieldToConverge" sourceRef="Service_OrderShield" targetRef="Gw_ConvergeParts"/>

    <!-- Manual Task: Inspect Parts -->
    <bpmn:manualTask id="Task_InspectParts" name="Manual Inspection">
      <bpmn:incoming>SequenceFlow_ToInspect</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AssembleStart</bpmn:outgoing>
    </bpmn:manualTask>

    <!-- Manual Task: Assemble Parts -->
    <bpmn:manualTask id="Task_AssembleParts" name="Assemble Parts">
       <bpmn:incoming>SequenceFlow_AssembleStart</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_SendFirstSaw</bpmn:outgoing>
    </bpmn:manualTask>

    <!-- Sequence Flows for Inspection/Assembly -->
    <bpmn:sequenceFlow id="SequenceFlow_ToInspect" sourceRef="Gw_ConvergeParts" targetRef="Task_InspectParts"/>
    <bpmn:sequenceFlow id="SequenceFlow_AssembleStart" sourceRef="Task_InspectParts" targetRef="Task_AssembleParts"/>

    <!-- Task Send First Saw (Message Flow) -->
    <bpmn:task id="Task_SendFirstSaw" name="Send Chainsaw">
      <bpmn:incoming>SequenceFlow_SendFirstSaw</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_ReceiveFeedback</bpmn:outgoing>
    </bpmn:task>

     <!-- Sequence Flow for First Saw -->
     <bpmn:sequenceFlow id="SequenceFlow_SendFirstSaw" sourceRef="Task_AssembleParts" targetRef="Task_SendFirstSaw"/>

    <!-- Receive Feedback Task (Message) -->
    <bpmn:receiveTask id="Task_ReceiveFeedback" name="Receive Customer Feedback">
      <bpmn:incoming>SequenceFlow_ReceiveFeedback</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_CustomerLikesIt</bpmn:outgoing>
    </bpmn:receiveTask>

     <!-- Sequence Flow for Feedback -->
     <bpmn:sequenceFlow id="SequenceFlow_ReceiveFeedback" sourceRef="Task_SendFirstSaw" targetRef="Task_ReceiveFeedback"/>

    <!-- Exclusive Gateway: Customer Likes It? -->
    <bpmn:exclusiveGateway id="Gw_CustomerLikesIt">
      <bpmn:incoming>SequenceFlow_CustomerLikesIt</bpmn:incoming>
       <bpmn:outgoing>Seq_ProdRestYes</bpmn:outgoing>
        <bpmn:outgoing>Seq_OrderCompleteNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

     <!-- Sequence Flows for Decision -->
      <bpmn:sequenceFlow id="SequenceFlow_CustomerLikesIt" sourceRef="Task_ReceiveFeedback" targetRef="Gw_CustomerLikesIt"/>
       <bpmn:sequenceFlow id="Seq_ProdRestYes" name="Yes">
        <bpmn:name>Customer Likes It?</bpmn:name>
      </bpmn:sequenceFlow>

    <!-- Task Produce Rest / Finish Order -->
     <bpmn:task id="Task_ProduceRest" name="Produce Remaining Orders">
       <bpmn:incoming>Seq_ProdRestYes</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow_EndOrder</bpmn:outgoing>
    </bpmn:task>

     <!-- End Event -->
      <bpmn:endEvent id="End_Event_OrderComplete" name="Chainsaw Order Completed">
       <bpmn:incoming>SequenceFlow_EndOrder</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows for Decision and Completion -->
     <bpmn:sequenceFlow id="Seq_ProdRestYes" sourceRef="Gw_CustomerLikesIt" targetRef="Task_ProduceRest"/>
      <bpmn:sequenceFlow id="SequenceFlow_EndOrder" sourceRef="Task_ProduceRest" targetRef="End_Event_OrderComplete"/>

  </bpmn:process>
</bpmn:definitions>