<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_ProvisionTeam" name="Provision Team" processRef="Process_OrderRequest"/>
    <bpmn:participant id="Participant_Customer" name="Customer"/>
    <bpmn:participant id="Participant_Daisuki" name="Daisuki"/>

    <!-- Message flows -->
    <bpmn:messageFlow id="Message_01" sourceRef="StartEvent_RequestReceived" targetRef="Participant_Customer">
      <bpmn:name>Order Request</bpmn:name>
    </bpmn:messageFlow>
    
    <bpmn:messageFlow id="Message_02" sourceRef="Task_AskForInfo" targetRef="Participant_Customer"/>

    <bpmn:messageFlow id="Message_03" sourceRef="SubProcess_OrderParts" targetRef="Participant_Daisuki"/>

    <bpmn:messageFlow id="Message_04" sourceRef="Task_ContractCustomer" targetRef="Participant_Customer"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_OrderRequest" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_RequestReceived" name="Receive customer request">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Identify parts -->
    <bpmn:task id="Task_IdentifyParts" name="Identify necessary parts">
      <bpmn:incoming>SequenceFlow_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_02</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Questions about request? -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_Questions" name="Questions about request?">
      <bpmn:incoming>SequenceFlow_02</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_03</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_04</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 2: Ask for more information -->
    <bpmn:task id="Task_AskForInfo" name="Ask customer for more information">
      <bpmn:incoming>SequenceFlow_03</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_05</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3: Check availability -->
    <bpmn:task id="Task_CheckAvailability" name="Check if all parts are available">
      <bpmn:incoming>SequenceFlow_04</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_05</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_06</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2: Parts available? -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_Availability" name="Parts available?">
      <bpmn:incoming>SequenceFlow_06</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_07</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_08</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Path 1: Parts available -->
    <bpmn:task id="Task_SupplyParts" name="Supply parts to customer">
      <bpmn:incoming>SequenceFlow_07</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_09</bpmn:outgoing>
    </bpmn:task>

    <!-- Path 2: Parts not available -->
    <bpmn:subProcess id="SubProcess_OrderParts" name="Order and receive parts from Daisuki">
      <bpmn:incoming>SequenceFlow_08</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>

      <!-- Sub-process internal elements -->
      <bpmn:startEvent id="Start_SubProcess" name="">
        <bpmn:outgoing>SequenceFlow_S01</bpmn:outgoing>
      </bpmn:startEvent>

      <bpmn:task id="Task_RecordPetition" name="Record the petition">
        <bpmn:incoming>SequenceFlow_S01</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow_S02</bpmn:outgoing>
      </bpmn:task>

      <bpmn:task id="Task_OrderDaisuki" name="Make order to Daisuki">
        <bpmn:incoming>SequenceFlow_S02</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow_S03</bpmn:outgoing>
      </bpmn:task>

      <bpmn:endEvent id="End_SubProcess" name="">
        <bpmn:incoming>SequenceFlow_S03</bpmn:incoming>
      </bpmn:endEvent>

    </bpmn:subProcess>

    <!-- Gateway 3: Merge paths -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_Merge" name="">
      <bpmn:incoming>SequenceFlow_09</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_S10</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 4: Contact customer -->
    <bpmn:task id="Task_ContractCustomer" name="Contact customer when parts collected">
      <bpmn:incoming>SequenceFlow_S10</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_11</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 5: Receive payment -->
    <bpmn:task id="Task_ReceivePayment" name="Receive final payment">
      <bpmn:incoming>SequenceFlow_11</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_12</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Completed" name="Process completed">
      <bpmn:incoming>SequenceFlow_12</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_01" sourceRef="StartEvent_RequestReceived" targetRef="Task_IdentifyParts"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_02" sourceRef="Task_IdentifyParts" targetRef="ExclusiveGateway_Questions"/>

    <bpmn:sequenceFlow id="SequenceFlow_03" name="Yes - Questions exist" sourceRef="ExclusiveGateway_Questions" targetRef="Task_AskForInfo"/>

    <bpmn:sequenceFlow id="SequenceFlow_04" name="No - No questions" sourceRef="ExclusiveGateway_Questions" targetRef="Task_CheckAvailability"/>

    <bpmn:sequenceFlow id="SequenceFlow_05" sourceRef="Task_AskForInfo" targetRef="Task_CheckAvailability"/>

    <bpmn:sequenceFlow id="SequenceFlow_06" sourceRef="Task_CheckAvailability" targetRef="ExclusiveGateway_Availability"/>

    <bpmn:sequenceFlow id="SequenceFlow_07" name="Yes - Available" sourceRef="ExclusiveGateway_Availability" targetRef="Task_SupplyParts"/>

    <bpmn:sequenceFlow id="SequenceFlow_08" name="No - Not Available" sourceRef="ExclusiveGateway_Availability" targetRef="SubProcess_OrderParts"/>

    <bpmn:sequenceFlow id="SequenceFlow_09" sourceRef="Task_SupplyParts" targetRef="ExclusiveGateway_Merge"/>

    <!-- Sub-process internal flows -->
    <bpmn:sequenceFlow id="SequenceFlow_S01" sourceRef="Start_SubProcess" targetRef="Task_RecordPetition"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_S02" sourceRef="Task_RecordPetition" targetRef="Task_OrderDaisuki"/>

    <bpmn:sequenceFlow id="SequenceFlow_S03" sourceRef="Task_OrderDaisuki" targetRef="End_SubProcess"/>
    
    <!-- Merge flow -->
    <bpmn:sequenceFlow id="SequenceFlow_S10" name="" sourceRef="ExclusiveGateway_Merge" targetRef="Task_ContractCustomer"/>

    <!-- Post-merge flows -->
    <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="SubProcess_OrderParts" targetRef="Task_ContractCustomer"/>

    <bpmn:sequenceFlow id="SequenceFlow_11" name="" sourceRef="Task_ContractCustomer" targetRef="Task_ReceivePayment"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_12" sourceRef="Task_ReceivePayment" targetRef="EndEvent_Completed"/>

  </bpmn:process>
</bpmn:definitions>