<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_AccountCreation">
  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="Participant_Customer" name="Bank Customer" processRef="Process_Customer"/>
    <bpmn:participant id="Participant_PostOfficer" name="Post Officer" processRef="Process_PostOffice"/>
    <bpmn:participant id="Participant_BankOfficer" name="Bank Officer" processRef="Process_Bank"/>

    <!-- Message flows between participants -->
    <bpmn:messageFlow id="MsgFlow_CustomerToPost" sourceRef="Task_CustomerPrintSend" targetRef="StartEvent_PostReceive"/>
  </bpmn:collaboration>

  <!-- Customer Process -->
  <bpmn:process id="Process_Customer">
    <bpmn:startEvent id="StartEvent_Customer" name="Account Request Started">
      <bpmn:outgoing>SeqCustomer_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_CustomerVisitWebsite" name="Visit Bank Website">
      <bpmn:incoming>SeqCustomer_1</bpmn:incoming>
      <bpmn:outgoing>SeqCustomer_2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SeqCustomer_2" sourceRef="Task_CustomerVisitWebsite" targetRef="Task_CustomerFillData"/>

    <bpmn:task id="Task_CustomerFillData" name="Fill in Personal Data">
      <bpmn:incoming>SeqCustomer_2</bpmn:incoming>
      <bpmn:outgoing>SeqCustomer_3</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SeqCustomer_3" sourceRef="Task_CustomerFillData" targetRef="Task_CustomerGeneratePDF"/>

    <bpmn:task id="Task_CustomerGeneratePDF" name="Generate PDF Document">
      <bpmn:incoming>SeqCustomer_3</bpmn:incoming>
      <bpmn:outgoing>SeqCustomer_4</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SeqCustomer_4" sourceRef="Task_CustomerGeneratePDF" targetRef="Task_CustomerPrintSend"/>

    <bpmn:endEvent id="EndEvent_Customer">
      <bpmn:incoming>MsgFlow_Accept</bpmn:incoming>
      <bpmn:incoming>MsgFlow_Reject</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Intermediate events for receiving messages -->
    <bpmn:intermediateCatchEvent id="IntermediateAccept" name="Receive Account Documents">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SeqCustomer_5</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:intermediateCatchEvent id="IntermediateReject" name="Receive Letter of Refusal">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SeqCustomer_6</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

  </bpmn:process>

  <!-- Post Officer Process -->
  <bpmn:process id="Process_PostOffice">
    <bpmn:startEvent id="StartEvent_PostReceive" name="Account Request Received">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SeqPost_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_PostCheckIdentity" name="Check Customer Identity">
      <bpmn:incoming>SeqPost_1</bpmn:incoming>
      <bpmn:outgoing>SeqPost_2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SeqPost_2" sourceRef="Task_PostCheckIdentity" targetRef="Task_PostMailRequest"/>

    <bpmn:endEvent id="EndEvent_Post">
      <bpmn:incoming>MsgFlow_BankReceive</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>

  <!-- Bank Officer Process -->
  <bpmn:process id="Process_Bank">
    <bpmn:startEvent id="StartEvent_BankReceive" name="Account Request Received at Bank">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SeqBank_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_BankCheckData" name="Check Customer Data">
      <bpmn:incoming>SeqBank_1</bpmn:incoming>
      <bpmn:outgoing>SeqBank_2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_Decision" name="Accept Request?">
      <bpmn:incoming>SeqBank_2</bpmn:incoming>
      <bpmn:outgoing>SeqBank_Accept</bpmn:outgoing>
      <bpmn:outgoing>SeqBank_Reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="EndEvent_BankAccept">
      <bpmn:incoming>MsgFlow_Accept</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_BankReject">
      <bpmn:incoming>MsgFlow_Reject</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>

</bpmn:definitions>