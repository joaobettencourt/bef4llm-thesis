<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_WebDesignProcess">
  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="Pool_ProcessOrder" name="Website Development Process" processRef="Proc_WebDevelopment" />
  </bpmn:collaboration>

  <bpmn:process id="Proc_WebDevelopment" isExecutable="false">
    <bpmn:startEvent id="StartMeeting" name="Informational meeting">
      <bpmn:outgoing>Flow_Start_Meeting</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:endEvent id="End_NotSuccessful" name="Process ended">
      <bpmn:incoming>Flow_MeetingFailed</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:laneSet>
      <bpmn:lane id="Lane_DesignTeam" name="Web design team">
        <bpmn:flowNodeRef>StartMeeting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Meeting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Successful</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Storyboard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelSplit_ContentDesign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Design</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Development</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ReviewNeeded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FinalContent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelJoin_BuildReady</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BuildReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Approved</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_MarketingTeam" name="Marketing team">
        <bpmn:flowNodeRef>Task_ReviewDraft</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Core Flow Elements -->
    
    <bpmn:task id="Task_Meeting" name="Informational meeting">
      <bpmn:incoming>Flow_Start_Meeting</bpmn:incoming>
      <bpmn:outgoing>Flow_Meeting_Gateway</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_Successful" name="Meeting successful?">
      <bpmn:incoming>Flow_Meeting_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_StoryboardPath</bpmn:outgoing>
      <bpmn:outgoing>Flow_MeetingFailed</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_Storyboard" name="Create storyboard">
      <bpmn:incoming>Flow_StoryboardPath</bpmn:incoming>
      <bpmn:outgoing>Flow_ParallelSplitIn</bpmn:outgoing>
    </bpmn:task>

    <bpmn:parallelGateway id="ParallelSplit_ContentDesign" name="Start Design &amp; Content">
      <bpmn:incoming>Flow_ParallelSplitIn</bpmn:incoming>
      <bpmn:outgoing>Flow_DesignPath</bpmn:outgoing>
      <bpmn:outgoing>Flow_ContentDraft</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Design Path -->
    <bpmn:task id="Task_Design" name="Design website">
      <bpmn:incoming>Flow_DesignPath</bpmn:incoming>
      <bpmn:outgoing>Flow_DevelopmentStart</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_Development" name="Develop website">
      <bpmn:incoming>Flow_DevelopmentStart</bpmn:incoming>
      <bpmn:outgoing>Flow_BuildReadyIn1</bpmn:outgoing>
    </bpmn:task>

    <!-- Content Path -->
    <bpmn:task id="Task_ContentDraft" name="Prepare initial draft">
      <bpmn:incoming>Flow_ContentDraft</bpmn:incoming>
      <bpmn:outgoing>Flow_ReviewDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Review Decision -->
    <bpmn:exclusiveGateway id="Gateway_ReviewNeeded" name="Review needed?">
      <bpmn:incoming>Flow_ReviewDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_MarketingReviewPath</bpmn:outgoing>
      <bpmn:outgoing>Flow_FinalContentDirect</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Marketing Review -->
    <bpmn:task id="Task_ReviewDraft" name="Review initial draft">
      <bpmn:incoming>Flow_MarketingReviewPath</bpmn:incoming>
      <bpmn:outgoing>Flow_FinalContentIn</bpmn:outgoing>
    </bpmn:task>

    <!-- Final Content -->
    <bpmn:task id="Task_FinalContent" name="Create final version of content">
      <bpmn:incoming>Flow_MarketingReviewPath</bpmn:incoming>
      <bpmn:outgoing>Flow_BuildReadyIn2</bpmn:outgoing>
    </bpmn:task>

    <!-- Merge for Build -->
    <bpmn:parallelGateway id="ParallelJoin_BuildReady" name="Build Ready">
      <bpmn:incoming>Flow_BuildReadyIn1</bpmn:incoming>
      <bpmn:incoming>Flow_BuildReadyIn2</bpmn:incoming>
      <bpmn:outgoing>Flow_ToReviewTask</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Build & Review -->
    <bpmn:endEvent id="End_Success" name="Process completed">
      <bpmn:incoming>Flow_ApprovedPath</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:task id="Task_BuildReview" name="Build and review website">
      <bpmn:incoming>Flow_ToReviewTask</bpmn:incoming>
      <bpmn:outgoing>Flow_ApprovalDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Approval Decision -->
    <bpmn:exclusiveGateway id="Gateway_Approved" name="Site approved?">
      <bpmn:incoming>Flow_ApprovalDecision</bpmn:incoming>
      <bpmn:outgoing>LoopBackPath</bpmn:outgoing>
      <bpmn:outgoing>Flow_ApprovedPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flows -->
    
    <bpmn:sequenceFlow id="Flow_Start_Meeting" sourceRef="StartMeeting" targetRef="Task_Meeting" />
    <bpmn:sequenceFlow id="Flow_Meeting_Gateway" sourceRef="Task_Meeting" targetRef="Gateway_Successful" />
    
    <!-- Meeting Decision -->
    <bpmn:sequenceFlow id="Flow_StoryboardPath" name="yes" sourceRef="Gateway_Successful" targetRef="Task_Storyboard" />
    <bpmn:sequenceFlow id="Flow_MeetingFailed" name="no" sourceRef="Gateway_Successful" targetRef="End_NotSuccessful" />

    <!-- Parallel Split -->
    <bpmn:sequenceFlow id="Flow_ParallelSplitIn" sourceRef="Task_Storyboard" targetRef="ParallelSplit_ContentDesign" />
    
    <!-- Design Path Flows -->
    <bpmn:sequenceFlow id="Flow_DesignPath" name="Design path" sourceRef="ParallelSplit_ContentDesign" targetRef="Task_Design" />
    <bpmn:sequenceFlow id="Flow_DevelopmentStart" sourceRef="Task_Design" targetRef="Task_Development" />

    <!-- Content Path Flows -->
    <bpmn:sequenceFlow id="Flow_ContentDraft" name="Content path" sourceRef="ParallelSplit_ContentDesign" targetRef="Task_ContentDraft" />
    
    <!-- Review Decision Flows -->
    <bpmn:sequenceFlow id="Flow_ReviewDecision" sourceRef="Task_ContentDraft" targetRef="Gateway_ReviewNeeded" />
    <bpmn:sequenceFlow id="Flow_MarketingReviewPath" name="yes - review needed" sourceRef="Gateway_ReviewNeeded" targetRef="Task_ReviewDraft" />
    
    <!-- Final Content Flows -->
    <bpmn:sequenceFlow id="Flow_FinalContentDirect" name="no review needed" sourceRef="Gateway_ReviewNeeded" targetRef="Task_FinalContent" />
    <bpmn:sequenceFlow id="Flow_MarketingReviewPathToFinal" sourceRef="Task_ReviewDraft" targetRef="Task_FinalContent" />

    <!-- Build Merge Flows -->
    <bpmn:sequenceFlow id="Flow_BuildReadyIn1" name="Dev done" sourceRef="Task_Development" targetRef="ParallelJoin_BuildReady" />
    
    <!-- Note: Task_ReviewDraft flows to Final Content, so we need a flow from Review Draft task to Build Ready In2 -->
    <bpmn:sequenceFlow id="Flow_FinalContentInToBuild" name="Content done" sourceRef="Task_FinalContent" targetRef="ParallelJoin_BuildReady" />

    <!-- Wait, I defined Task_ReviewDraft -> Final Content. So Flow_MarketingReviewPath goes to Review Draft. Then Review Draft flows to Final Content? 
         Text: "marketing team will conduct this [review], before the web design team creates the final version".
         My model above had Gateway -> Marketing Review -> Final Version. And also Gateway -> Direct Final Version (No review).
         Let's align IDs properly in Sequence Flows section below to match element definitions exactly -->

    <bpmn:sequenceFlow id="LoopBackPath" name="not approved - rebuild" sourceRef="Gateway_Approved" targetRef="Task_BuildReview" />
    
  </bpmn:process>
</bpmn:definitions>