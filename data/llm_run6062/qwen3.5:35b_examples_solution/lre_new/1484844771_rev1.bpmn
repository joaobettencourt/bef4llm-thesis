<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_InvoiceProcess_Corrected" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="Pool_ProcessOrder" name="Invoice Process System" processRef="Proc_Main"/>
  </bpmn:collaboration>

  <bpmn:process id="Proc_Main" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="Start_1" name="Invoice Process Started">
      <bpmn:outgoing>Flow_Start_Search</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Locate Vendor -->
    <bpmn:task id="Task_LocateVendor" name="Locate vendor in SAP system">
      <bpmn:incoming>Flow_Start_Search</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_ExistsCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Vendor Exists? -->
    <bpmn:exclusiveGateway id="Gateway_VendorExists" name="Vendor exists in SAP?">
      <bpmn:incoming>Flow_Gateway_ExistsCheck</bpmn:incoming>
      <bpmn:outgoing>Seq_NewVendorPath</bpmn:outgoing>
      <bpmn:outgoing>Seq_VendorExistingPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Path 1: New Vendor Process -->
    
    <!-- Task: Fill Form -->
    <bpmn:task id="Task_FillForm" name="Fill new Vendor Master Record form">
      <bpmn:incoming>Seq_NewVendorPath</bpmn:incoming>
      <bpmn:outgoing>Flow_AttachRequest</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Attach Request -->
    <bpmn:task id="Task_Attach" name="Attach request to invoice">
      <bpmn:incoming>Flow_AttachRequest</bpmn:incoming>
      <bpmn:outgoing>Flow_PlaceOutbox</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Place in Outbox -->
    <bpmn:task id="Task_Outbox" name="Place invoice in internal outbox for new vendors">
      <bpmn:incoming>Flow_PlaceOutbox</bpmn:outgoing>
      <bpmn:outgoing>Seq_ClassificationGateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Urgency Classification -->
    <bpmn:exclusiveGateway id="Gateway_Urgency" name="Invoice urgency classification">
      <bpmn:incoming>Seq_ClassificationGateway</bpmn:incoming>
      <bpmn:outgoing>Seq_TimerUrgent</bpmn:outgoing>
      <bpmn:outgoing>Seq_TimerNonUrgent</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Timer Event: Urgent (24 hours) -->
    <bpmn:intermediateCatchEvent id="Timer_Urgent" name="Maximum 24 hr window">
      <bpmn:incoming>Seq_TimerUrgent</bpmn:incoming>
      <bpmn:outgoing>Flow_MergeAfterWait</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_Urgent"/>
    </bpmn:intermediateCatchEvent>

    <!-- Timer Event: Non-Urgent (1-5 working days) -->
    <bpmn:intermediateCatchEvent id="Timer_NonUrgent" name="1-5 working days">
      <bpmn:incoming>Seq_TimerNonUrgent</bpmn:incoming>
      <bpmn:outgoing>Flow_MergeAfterWait</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_NonUrgent"/>
    </bpmn:intermediateCatchEvent>

    <!-- Path 2: Vendor Already Exists -->
    
    <!-- Task: Add SAP Number (Existing) - Merging logic handled by Gateway below or direct flow to task? 
         Text says "If the Vendor is already in the system ... its SAP number is then added". 
         So we can go directly to adding the number, but must merge with New Vendor path completion.
    -->

    <!-- Merge Point for Wait Completion and Existing Vendors -->
    <bpmn:exclusiveGateway id="Gateway_MergeWait" name="Merge after wait or existing">
      <bpmn:incoming>Flow_VendorExistingPath</bpmn:incoming>
      <bpmn:outgoing>Seq_AddSAPNumberTask</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Add SAP Number -->
    <bpmn:task id="Task_AddSap" name="Add SAP number to invoice">
      <bpmn:incoming>Seq_MergeWaitToTask</bpmn:outgoing> 
      <bpmn:outgoing>Flow_SortingDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Correction on Merge Logic above to ensure valid flow -->
    <!-- Re-defining merge logic for clarity and validity below in final block structure -->

  </bpmn:process>
  
  <bpmn:sequenceFlow id="Seq_NewVendorPath" sourceRef="Gateway_VendorExists" targetRef="Task_FillForm">
      <bpmn:name>New Vendor</bpmn:name>
  </bpmn:sequenceFlow>

  <!-- Re-writing the full valid XML structure below to ensure all IDs and Flows are correct -->

</bpmn:definitions>