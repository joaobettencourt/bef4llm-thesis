<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_PurchaseProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="Pool_ACMEInc" name="ACME Inc." processRef="Proc_PurchaseOrders"/>
  </bpmn:collaboration>

  <bpmn:process id="Proc_PurchaseOrders" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Department" name="Department">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_CheckStock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UseGoodsFromStock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Demand identified">
      <bpmn:outgoing>SequenceFlow_StartToGateway</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Decision Gateway - Check Stock Availability -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_CheckStock" name="Goods in stock?">
      <bpmn:incoming>SequenceFlow_StartToGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GoodsInStock</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoGoodsInStock</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task - Use goods from stock -->
    <bpmn:task id="Task_UseGoodsFromStock" name="Use goods from stock">
      <bpmn:incoming>SequenceFlow_GoodsInStock</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToEndEvent1</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event - Local consumption -->
    <bpmn:endEvent id="EndEvent_1" name="Goods consumed locally">
      <bpmn:incoming>SequenceFlow_ToEndEvent1</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>