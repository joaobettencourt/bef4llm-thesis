<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_CustomerFeedbackProcess">
  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="Pool_ProcessOrder" name="Customer Feedback Module Implementation" processRef="Proc_CustomerFeedbackModule" />
  </bpmn:collaboration>

  <bpmn:process id="Proc_CustomerFeedbackModule" isExecutable="false">
    
    <!-- Lane Set -->
    <bpmn:laneSet>
      <bpmn:lane id="Lane_BusinessAnalyst" name="Business Analyst">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CollectDataAnalysis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateCatchEvent_DesignCompleteWait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CheckDesignOK</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_WebDesigner" name="Web Designer">
        <bpmn:flowNodeRef>Task_IntegrateDesignModulePlacement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ChangeDesign</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_PHPHTMLCSS" name="PHP/HTML/CSS Specialist">
        <bpmn:flowNodeRef>Task_IntegrateOverallImplementation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AdjustAccordingToTestResults</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Tester" name="Tester">
        <bpmn:flowNodeRef>Gateway_TestResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TestFinalWebsite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProvideTestResults</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Success</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Collect data and conduct business analysis">
      <bpmn:outgoing>SequenceFlow_AnalysisToDesign</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Business Analyst collects data -->
    <bpmn:task id="Task_CollectDataAnalysis" name="Collect data and conduct business analysis regarding customer feedback">
      <bpmn:incoming>SequenceFlow_AnalysisToDesign</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DesignPhaseStarts</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: Web Designer integrates design -->
    <bpmn:task id="Task_IntegrateDesignModulePlacement" name="Integrate the design and decide where customer feedback module should be placed">
      <bpmn:incoming>SequenceFlow_DesignPhaseStarts</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ChangeLoopBack</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitForAnalystTriggered</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Catch Event for waiting on design completion -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_DesignCompleteWait" name="Design complete">
      <bpmn:messageEventDefinition />
      <bpmn:incoming>SequenceFlow_WaitForAnalystTriggered</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AnalystChecksDesign</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Gateway 1: Check if design needs adjustment -->
    <bpmn:exclusiveGateway id="Gateway_CheckDesignOK" name="Design OK?">
      <bpmn:incoming>SequenceFlow_AnalystChecksDesign</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DesignNeedsAdjustment</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_DesignIsOKProceed</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 3: Change design if needed -->
    <bpmn:task id="Task_ChangeDesign" name="Change the design">
      <bpmn:incoming>SequenceFlow_DesignNeedsAdjustment</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ChangeLoopBack</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 4: PHP/HTML/CSS Specialist integrates -->
    <bpmn:task id="Task_IntegrateOverallImplementation" name="Integrate with the overall implementation">
      <bpmn:incoming>SequenceFlow_DesignIsOKProceed</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_AdjustLoopBack</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StartTestingPhase</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 5: Tester tests final website -->
    <bpmn:task id="Task_TestFinalWebsite" name="Test the final website to make sure everything is going well">
      <bpmn:incoming>SequenceFlow_StartTestingPhase</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GoToResultGateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2: Check if test is OK -->
    <bpmn:exclusiveGateway id="Gateway_TestResult" name="Test OK?">
      <bpmn:incoming>SequenceFlow_GoToResultGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PassToEndEvent</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_FailToProvideResults</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 6: Provide test results if not OK -->
    <bpmn:task id="Task_ProvideTestResults" name="Provide test results">
      <bpmn:incoming>SequenceFlow_FailToProvideResults</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ResultsToAdjustment</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 7: Adjust according to test results -->
    <bpmn:task id="Task_AdjustAccordingToTestResults" name="Adjust according to the test results and integrate overall implementation">
      <bpmn:incoming>SequenceFlow_ResultsToAdjustment</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AdjustLoopBack</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Success" name="Process ends">
      <bpmn:incoming>SequenceFlow_PassToEndEvent</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_AnalysisToDesign" sourceRef="StartEvent_1" targetRef="Task_CollectDataAnalysis">
      <bpmn:name>Collect data</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_DesignPhaseStarts" name="Design phase starts" sourceRef="Task_CollectDataAnalysis" targetRef="Task_IntegrateDesignModulePlacement">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[design needed]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_WaitForAnalystTriggered" name="Design complete notification" sourceRef="Task_IntegrateDesignModulePlacement" targetRef="IntermediateCatchEvent_DesignCompleteWait">
      <bpmn:name>Notify Analyst</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_AnalystChecksDesign" name="Analyst checks design" sourceRef="IntermediateCatchEvent_DesignCompleteWait" targetRef="Gateway_CheckDesignOK">
      <bpmn:name>Analyze</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_NeedAdjustmentToChangeDesign" name="Need adjustments?" sourceRef="Gateway_CheckDesignOK" targetRef="Task_ChangeDesign">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[design needs adjustment]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_DesignIsOKProceed" name="Design OK?" sourceRef="Gateway_CheckDesignOK" targetRef="Task_IntegrateOverallImplementation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[design is OK]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ChangeLoopBack" sourceRef="Task_ChangeDesign" targetRef="Task_IntegrateDesignModulePlacement">
      <bpmn:name>Re-integrate</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_StartTestingPhase" name="Ready for testing" sourceRef="Task_IntegrateOverallImplementation" targetRef="Task_TestFinalWebsite">
      <bpmn:name>Start Test</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_GoToResultGateway" name="Test complete" sourceRef="Task_TestFinalWebsite" targetRef="Gateway_TestResult">
      <bpmn:name>Check Results</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_NotOKToProvideResults" name="Test not OK?" sourceRef="Gateway_TestResult" targetRef="Task_ProvideTestResults">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[test is not ok]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_PassToEndEvent" name="Test OK?" sourceRef="Gateway_TestResult" targetRef="EndEvent_Success">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[test is ok]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ResultsToAdjustment" sourceRef="Task_ProvideTestResults" targetRef="Task_AdjustAccordingToTestResults">
      <bpmn:name>Send Results</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_IntegrationAgainToIntegrateOverallImplementation" name="Integrate again after adjustment" sourceRef="Task_AdjustAccordingToTestResults" targetRef="Task_IntegrateOverallImplementation">
      <bpmn:name>Adjust & Integrate</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>