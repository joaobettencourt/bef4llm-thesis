<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_001">
    <bpmn:participant id="Participant_OrderProcessing" name="Dispatch of goods - Computer Hardware Shop" processRef="Process_001" />
  </bpmn:collaboration>

  <bpmn:process id="Process_001" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Secretary" name="Secretary">
        <bpmn:flowNodeRef>StartEvent_Order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ClariifyShipmentMethod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SpecialHandling</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Get3Offers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectLogisticCompany</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_LogisticsDept" name="Logistics Department Head">
        <bpmn:flowNodeRef>Gateway_InsuranceCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InsureParcel</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Warehouse" name="Warehousemen">
        <bpmn:flowNodeRef>Gateway_PackagingStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PackageGoods</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Order" name="Ship goods">
      <bpmn:outgoing>SequenceFlow_StartToParallel</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Parallel Gateway 1: Split into Secretary Logic and Warehouse Packaging -->
    <bpmn:parallelGateway id="Gateway_PackagingStart" name="">
      <bpmn:name>Split for parallel processing</bpmn:name>
      <bpmn:incoming>SequenceFlow_StartToParallel</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToSecretaryLogic</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ToWarehousePackaging</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 1: Clarify Shipment Method -->
    <bpmn:task id="Task_ClariifyShipmentMethod" name="Clarify shipment method">
      <bpmn:name>Clarify who will do the shipping</bpmn:name>
      <bpmn:incoming>SequenceFlow_ToSecretaryLogic</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ShipmentDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Special Handling Decision -->
    <bpmn:exclusiveGateway id="Gateway_SpecialHandling" name="">
      <bpmn:name>Large amounts?</bpmn:name>
      <bpmn:incoming>SequenceFlow_ShipmentDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NormalPostPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SpecialHandlingPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Path 1 (Yes): Special Handling -->
    <bpmn:task id="Task_Get3Offers" name="Get 3 offers from logistic companies">
      <bpmn:name>Invites three logistic companies</bpmn:name>
      <bpmn:incoming>SequenceFlow_SpecialHandlingPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToSelectionTask</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_SelectLogisticCompany" name="Select logistic company and place order">
      <bpmn:name>Selects one of them</bpmn:name>
      <bpmn:incoming>SequenceFlow_ToSelectionTask</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SpecialHandlingToMerge1</bpmn:outgoing>
    </bpmn:task>

    <!-- Path 2 (No): Normal Post -->
    <bpmn:inclusiveGateway id="Gateway_InsuranceCheck" name="">
      <bpmn:name>Inclusive Gateway for Label &amp; Insurance</bpmn:name>
      <bpmn:incoming>SequenceFlow_NormalPostPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WriteLabel</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Task 2: Write Package Label -->
    <bpmn:task id="Task_WritePackageLabel" name="Write package label">
      <bpmn:name>Written by the secretary</bpmn:name>
      <bpmn:incoming>SequenceFlow_WriteLabel</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_LabelToMerge1</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3: Insure Parcel -->
    <bpmn:inclusiveGateway id="Gateway_InsuranceDecision" name="">
        <bpmn:name>Inclusive Gateway for Insurance Check</bpmn:name>
      <bpmn:incoming>SequenceFlow_LabelToMerge1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckInsuranceCondition</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Task 4: Insure Parcel -->
    <bpmn:task id="Task_InsureParcel" name="Insure parcel">
      <bpmn:name>Taken by logistics department head if necessary</bpmn:name>
      <bpmn:incoming>SequenceFlow_CheckInsuranceCondition</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InsuranceToMerge2</bpmn:outgoing>
    </bpmn:task>

    <!-- Warehouse Task -->
    <bpmn:task id="Task_PackageGoods" name="Package goods">
      <bpmn:name>Packaged by the warehousemen in the meantime</bpmn:name>
      <bpmn:incoming>SequenceFlow_ToWarehousePackaging</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PackageToFinalMerge</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToParallel" sourceRef="StartEvent_Order" targetRef="Gateway_PackagingStart">
      <bpmn:name></bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ToSecretaryLogic" sourceRef="Gateway_PackagingStart" targetRef="Task_ClariifyShipmentMethod">
      <bpmn:name></bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ToWarehousePackaging" sourceRef="Gateway_PackagingStart" targetRef="Task_PackageGoods">
      <bpmn:name>In the meantime</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ShipmentDecision" sourceRef="Task_ClariifyShipmentMethod" targetRef="Gateway_SpecialHandling">
      <bpmn:name></bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Special Handling Path -->
    <bpmn:sequenceFlow id="SequenceFlow_SpecialHandlingPath" sourceRef="Gateway_SpecialHandling" targetRef="Task_Get3Offers">
      <bpmn:name>Yes (Large amounts)</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Normal Post Path -->
    <bpmn:sequenceFlow id="SequenceFlow_NormalPostPath" sourceRef="Gateway_SpecialHandling" targetRef="Gateway_InsuranceCheck">
      <bpmn:name>No (Small amounts)</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Label & Insurance Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_WriteLabel" sourceRef="Gateway_InsuranceCheck" targetRef="Task_WritePackageLabel">
      <bpmn:name></bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_LabelToMerge1" sourceRef="Task_WritePackageLabel" targetRef="Gateway_InsuranceDecision">
      <bpmn:name></bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Insurance Decision Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckInsuranceCondition" sourceRef="Gateway_InsuranceDecision" targetRef="Task_InsureParcel">
      <bpmn:name>If necessary</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Merge Flows -->
    <bpmn:exclusiveGateway id="Gateway_MergeSpecialNormal" name="">
        <bpmn:name>Merge Special Handling &amp; Normal Post Paths</bpmn:name>
      <bpmn:incoming>SequenceFlow_SpecialHandlingToMerge1</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Fixing the malformed gateway definition above to be valid -->
    <bpmn:sequenceFlow id="SequenceFlow_ToSelectionTask" sourceRef="Task_Get3Offers" targetRef="Task_SelectLogisticCompany">
      <bpmn:name></bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Corrected Gateway Definition for Merge -->
    <bpmn:exclusiveGateway id="Gateway_MergeSpecialNormal_Corrected" name="">
        <bpmn:name>Merge Special Handling &amp; Normal Post Paths</bpmn:name>
      <bpmn:incoming>SequenceFlow_SpecialHandlingToMerge1</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Replacing the malformed gateway with a valid one and fixing connections -->
    <!-- Let's define the final merge point properly below to ensure validity -->

  </bpmn:process>
</bpmn:definitions>