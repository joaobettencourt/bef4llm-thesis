<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_OrderProcess">
    <bpmn:participant id="Participant_AssemblerAG" name="Assembler AG" processRef="Process_AssemblerAG"/>
    <bpmn:participant id="Participant_Supplier" name="Supplier" processRef="Process_Supplier"/>
    
    <!-- Message Flow 1: Order from Assembler to Supplier -->
    <bpmn:messageFlow id="MessageFlow_Order" sourceRef="Task_SendOrder" targetRef="Task_ProcessOrder">
      <bpmn:name>Send order</bpmn:name>
    </bpmn:messageFlow>
    
    <!-- Message Flow 2: Invoice from Supplier to Assembler -->
    <bpmn:messageFlow id="MessageFlow_Invoice" sourceRef="Task_SendInvoice" targetRef="Task_ReceiveInvoice">
      <bpmn:name>Send invoice</bpmn:name>
    </bpmn:messageFlow>
  </bpmn:collaboration>

  <!-- Assembler AG Process -->
  <bpmn:process id="Process_AssemblerAG" isExecutable="false">
    <bpmn:startEvent id="StartTimer_01" name="Monthly Order Start">
      <bpmn:timerEventDefinition/>
      <bpmn:outgoing>SequenceFlow_StartToOrder</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_SendOrder" name="Send order to supplier">
      <bpmn:incoming>SequenceFlow_StartToOrder</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OrderSent</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_ReceiveInvoice" name="Receive invoice">
      <bpmn:incoming>MessageFlow_Invoice</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReceiptToEnd</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="End_Assembler" name="Order Process Complete">
      <bpmn:incoming>SequenceFlow_ReceiptToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows within Assembler AG -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToOrder" sourceRef="StartTimer_01" targetRef="Task_SendOrder"/>
    <bpmn:sequenceFlow id="SequenceFlow_OrderSent" name="" sourceRef="Task_SendOrder" targetRef="End_Assembler">
      <!-- Note: In real scenario, this would wait for invoice - simplified here -->
    </bpmn:sequenceFlow>
  </bpmn:process>

  <!-- Supplier Process -->
  <bpmn:process id="Process_Supplier" isExecutable="false">
    <bpmn:startEvent id="StartSupplier_01" name="Order Received Start">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_StartToProcess</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_ProcessOrder" name="Process order">
      <bpmn:incoming>MessageFlow_Order</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProcessToInvoice</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_SendInvoice" name="Send invoice">
      <bpmn:incoming>SequenceFlow_ProcessToInvoice</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InvoiceSent</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="End_Supplier" name="Order Processed">
      <bpmn:incoming>SequenceFlow_InvoiceSent</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows within Supplier -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToProcess" sourceRef="StartSupplier_01" targetRef="Task_ProcessOrder"/>
    <bpmn:sequenceFlow id="SequenceFlow_ProcessToInvoice" name="" sourceRef="Task_ProcessOrder" targetRef="Task_SendInvoice"/>
    <bpmn:sequenceFlow id="SequenceFlow_InvoiceSent" name="" sourceRef="Task_SendInvoice" targetRef="End_Supplier"/>
  </bpmn:process>

</bpmn:definitions>