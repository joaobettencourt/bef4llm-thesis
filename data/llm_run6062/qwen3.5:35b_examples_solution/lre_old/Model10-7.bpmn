<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_001">
    <bpmn:participant id="Participant_MSPN" name="MSPN" processRef="Process_MSPN"/>
    <bpmn:participant id="Participant_GO" name="GO" processRef="Process_GO"/>
    <bpmn:messageFlow id="MessageFlow_01" sourceRef="IntermediateThrowEvent_Register" targetRef="StartMessageEvent_Examine"/>
  </bpmn:collaboration>

  <!-- MSPN Process -->
  <bpmn:process id="Process_MSPN" isExecutable="false">
    <bpmn:startEvent id="StartNone_01" name="">
      <bpmn:outgoing>SequenceFlow_StartRegister</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_Register_MSPN" name="Register measurement">
      <bpmn:incoming>SequenceFlow_StartRegister</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToThrowMessage</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndNone_01" name="">
      <bpmn:incoming>SequenceFlow_EndRegister</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:intermediateThrowEvent id="IntermediateThrowEvent_Register">
      <bpmn:incoming>SequenceFlow_ToThrowMessage</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ThrowToCatch</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <bpmn:endEvent id="EndNone_MSPN" name="">
      <bpmn:incoming>SequenceFlow_EndMSPN</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartRegister" sourceRef="StartNone_01" targetRef="Task_Register_MSPN"/>
    <bpmn:sequenceFlow id="SequenceFlow_ToThrowMessage" sourceRef="Task_Register_MSPN" targetRef="IntermediateThrowEvent_Register"/>
    <bpmn:sequenceFlow id="SequenceFlow_EndMSPN" name="" sourceRef="EndNone_01" targetRef="StartNone_01"/>

  </bpmn:process>

  <!-- GO Process -->
  <bpmn:process id="Process_GO" isExecutable="false">
    <bpmn:startEvent id="StartMessageEvent_Examine" name="">
      <bpmn:outgoing>SequenceFlow_StartExamine</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_Examine_GO" name="Examine application of MSPN">
      <bpmn:incoming>SequenceFlow_StartExamine</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToGateway</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndNone_GO_1" name="">
      <bpmn:incoming>SequenceFlow_EndReject</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndNone_GO_2" name="">
      <bpmn:incoming>SequenceFlow_EndConfirm</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:exclusiveGateway id="ExclusiveGateway_Decision">
      <bpmn:name>Confirm application?</bpmn:name>
      <bpmn:incoming>SequenceFlow_ToGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RejectPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ConfirmPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_Reject_GO" name="Reject application of MSPN">
      <bpmn:incoming>SequenceFlow_RejectPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndReject</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_Confirm_GO" name="Confirm application of MSPN">
      <bpmn:incoming>SequenceFlow_ConfirmPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToAssign</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_Assign_GO" name="Assign MSPN">
      <bpmn:incoming>SequenceFlow_ToAssign</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToInformMSPO</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_InformMSPO_GO" name="Inform MSPO about assignment of MSPN">
      <bpmn:incoming>SequenceFlow_ToInformMSPO</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToInformMPO</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_InformMPO_GO" name="Inform MPO about assignment of MSPN">
      <bpmn:incoming>SequenceFlow_ToInformMPO</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToInformSP</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_InformSP_GO" name="Inform SP about assignment of MSPN">
      <bpmn:incoming>SequenceFlow_ToInformSP</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndConfirm</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartExamine" sourceRef="StartMessageEvent_Examine" targetRef="Task_Examine_GO"/>
    <bpmn:sequenceFlow id="SequenceFlow_ToGateway" sourceRef="Task_Examine_GO" targetRef="ExclusiveGateway_Decision"/>

    <!-- Gateway Paths -->
    <bpmn:sequenceFlow id="SequenceFlow_RejectPath" name="Reject" sourceRef="ExclusiveGateway_Decision" targetRef="Task_Reject_GO"/>
    <bpmn:sequenceFlow id="SequenceFlow_ConfirmPath" name="Confirm" sourceRef="ExclusiveGateway_Decision" targetRef="Task_Confirm_GO"/>

    <!-- Post-Confirmation Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_ToAssign" sourceRef="Task_Confirm_GO" targetRef="Task_Assign_GO"/>
    <bpmn:sequenceFlow id="SequenceFlow_ToInformMSPO" sourceRef="Task_Assign_GO" targetRef="Task_InformMSPO_GO"/>
    <bpmn:sequenceFlow id="SequenceFlow_ToInformMPO" sourceRef="Task_InformMSPO_GO" targetRef="Task_InformMPO_GO"/>
    <bpmn:sequenceFlow id="SequenceFlow_ToInformSP" sourceRef="Task_InformMPO_GO" targetRef="Task_InformSP_GO"/>

    <!-- End Events -->
    <bpmn:sequenceFlow id="SequenceFlow_EndReject" name="" sourceRef="Task_Reject_GO" targetRef="EndNone_GO_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_EndConfirm" name="" sourceRef="Task_InformSP_GO" targetRef="EndNone_GO_2"/>

  </bpmn:process>

</bpmn:definitions>