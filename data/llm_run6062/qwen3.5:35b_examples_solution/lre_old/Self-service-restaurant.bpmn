<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_RestaurantProcess">
    <bpmn:participant id="Participant_Guest" name="Guest" processRef="Process_Guest"/>
    <bpmn:participant id="Participant_Employee" name="Employee" processRef="Process_Employee"/>
    <bpmn:participant id="Participant_Chef" name="Chef" processRef="Process_Chef"/>
    
    <!-- Message Flows -->
    <bpmn:messageFlow id="Message_GuestToEmployee_OrderPlaced" sourceRef="Task_GuestPlaceOrder" targetRef="StartEvent_EmployeeOrderReceived"/>
    <bpmn:messageFlow id="Message_EmployeeToGuest_BuzzerReady" sourceRef="Task_EmployeeHandOverBuzzer" targetRef="IntermediateCatch_GuestWaitForBuzzer"/>
    <bpmn:messageFlow id="Message_EmployeeToChef_OrderSent" sourceRef="Task_EmployeeInformChef" targetRef="StartEvent_ChefMealNeeded"/>
    <bpmn:messageFlow id="Message_ChefToEmployee_MealReady" sourceRef="Task_ChefInformEmployee" targetRef="IntermediateCatch_EmployeeWaitForNotification"/>
  </bpmn:collaboration>

  <!-- Guest Process -->
  <bpmn:process id="Process_Guest" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Hungry" name="Guest feels hungry">
      <bpmn:outgoing>SequenceFlow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_GuestEnterRestaurant" name="Enters restaurant">
      <bpmn:incoming>SequenceFlow_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_02</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_GuestChooseDish" name="Chooses dish from menu">
      <bpmn:incoming>SequenceFlow_02</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_03</bpmn:outgoing>
    </bpmn:task>

    <bpmn:intermediateCatchEvent id="IntermediateCatch_WaitForTurn" name="Waits for turn">
      <bpmn:incoming>SequenceFlow_03</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_04</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:task id="Task_GuestPlaceOrder" name="Places order with employee">
      <bpmn:incoming>SequenceFlow_04</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_05</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_GuestOrderSent" name="Order sent to employee">
      <bpmn:incoming>SequenceFlow_05</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:intermediateCatchEvent id="IntermediateCatch_GuestWaitForBuzzer" name="Waits for buzzer">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_06</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:task id="Task_GuestPickUpMeal" name="Picks up meal">
      <bpmn:incoming>SequenceFlow_06</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_07</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_GuestFinished" name="Guest finished eating">
      <bpmn:incoming>SequenceFlow_07</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_01" sourceRef="StartEvent_Hungry" targetRef="Task_GuestEnterRestaurant"/>
    <bpmn:sequenceFlow id="SequenceFlow_02" sourceRef="Task_GuestEnterRestaurant" targetRef="Task_GuestChooseDish"/>
    <bpmn:sequenceFlow id="SequenceFlow_03" sourceRef="Task_GuestChooseDish" targetRef="IntermediateCatch_WaitForTurn"/>
    <bpmn:sequenceFlow id="SequenceFlow_04" sourceRef="IntermediateCatch_WaitForTurn" targetRef="Task_GuestPlaceOrder"/>
    <bpmn:sequenceFlow id="SequenceFlow_05" sourceRef="Task_GuestPlaceOrder" targetRef="EndEvent_GuestOrderSent"/>

  </bpmn:process>

  <!-- Employee Process -->
  <bpmn:process id="Process_Employee" isExecutable="false">
    <bpmn:startEvent id="StartEvent_EmployeeOrderReceived" name="Order received from guest">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_EmployeeEnterPOS" name="Enters order into POS system">
      <bpmn:incoming>SequenceFlow_10</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_11</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_EmployeeCollectMoney" name="Collects money from guest">
      <bpmn:incoming>SequenceFlow_11</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_12</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_EmployeeSetBuzzer" name="Sets up buzzer">
      <bpmn:incoming>SequenceFlow_12</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_13</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_EmployeeHandOverBuzzer" name="Hands buzzer to guest">
      <bpmn:incoming>SequenceFlow_13</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_14</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_EmployeeInformChef" name="Informs chef of new order">
      <bpmn:incoming>SequenceFlow_14</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_15</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_EmployeeOrderSent" name="Order sent to chef">
      <bpmn:incoming>SequenceFlow_15</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Wait for meal ready notification -->
    <bpmn:intermediateCatchEvent id="IntermediateCatch_EmployeeWaitForNotification" name="Meal is in hatch">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_16</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Wait for guest to appear -->
    <bpmn:task id="Task_EmployeeSetOffBuzzer" name="Sets off buzzer">
      <bpmn:incoming>SequenceFlow_16</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_17</bpmn:outgoing>
    </bpmn:task>

    <!-- Event-based gateway for guest reaction or timeout -->
    <bpmn:eventBasedGateway id="EventBased_GuestReaction">
      <bpmn:incoming>SequenceFlow_18</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_19</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_20</bpmn:outgoing>
    </bpmn:eventBasedGateway>

    <!-- Timer for 5 minutes -->
    <bpmn:intermediateCatchEvent id="IntermediateCatch_Timeout" name="After 5 minutes">
      <bpmn:timerEventDefinition/>
      <bpmn:incoming>SequenceFlow_20</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_21</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Call guest task -->
    <bpmn:task id="Task_EmployeeCallGuest" name="Calls for guest">
      <bpmn:incoming>SequenceFlow_21</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_18</bpmn:outgoing>
    </bpmn:task>

    <!-- Guest appears -->
    <bpmn:intermediateCatchEvent id="IntermediateCatch_GuestAppears" name="Guest at hatch">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SequenceFlow_19</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_22</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Hand over meal -->
    <bpmn:task id="Task_EmployeeHandOverMeal" name="Hands over meal">
      <bpmn:incoming>SequenceFlow_22</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_23</bpmn:outgoing>
    </bpmn:task>

    <!-- End event -->
    <bpmn:endEvent id="EndEvent_EmployeeFinished" name="Order processed">
      <bpmn:incoming>SequenceFlow_23</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="StartEvent_EmployeeOrderReceived" targetRef="Task_EmployeeEnterPOS"/>
    <bpmn:sequenceFlow id="SequenceFlow_11" sourceRef="Task_EmployeeEnterPOS" targetRef="Task_EmployeeCollectMoney"/>
    <bpmn:sequenceFlow id="SequenceFlow_12" sourceRef="Task_EmployeeCollectMoney" targetRef="Task_EmployeeSetBuzzer"/>
    <bpmn:sequenceFlow id="SequenceFlow_13" sourceRef="Task_EmployeeSetBuzzer" targetRef="Task_EmployeeHandOverBuzzer"/>
    <bpmn:sequenceFlow id="SequenceFlow_14" sourceRef="Task_EmployeeHandOverBuzzer" targetRef="Task_EmployeeInformChef"/>
    <bpmn:sequenceFlow id="SequenceFlow_15" sourceRef="Task_EmployeeInformChef" targetRef="EndEvent_EmployeeOrderSent"/>

    <!-- Wait for notification -->
    <bpmn:sequenceFlow id="SequenceFlow_16" sourceRef="IntermediateCatch_EmployeeWaitForNotification" targetRef="Task_EmployeeSetOffBuzzer"/>
    
    <!-- Event-based gateway for guest reaction or timeout -->
    <bpmn:sequenceFlow id="SequenceFlow_17" sourceRef="Task_EmployeeSetOffBuzzer" targetRef="EventBased_GuestReaction"/>

    <!-- Timeout path (5 minutes) -->
    <bpmn:sequenceFlow id="SequenceFlow_20" name="Timeout after 5 min" sourceRef="EventBased_GuestReaction" targetRef="IntermediateCatch_Timeout"/>
    
    <!-- Call guest loop back to gateway -->
    <bpmn:sequenceFlow id="SequenceFlow_18" sourceRef="Task_EmployeeCallGuest" targetRef="EventBased_GuestReaction"/>

    <!-- Guest appears path -->
    <bpmn:sequenceFlow id="SequenceFlow_19" name="Guest appears at hatch" sourceRef="EventBased_GuestReaction" targetRef="IntermediateCatch_GuestAppears"/>

    <!-- Hand over meal after guest appears -->
    <bpmn:sequenceFlow id="SequenceFlow_22" sourceRef="IntermediateCatch_GuestAppears" targetRef="Task_EmployeeHandOverMeal"/>
    
    <!-- Final end event for employee process -->
    <bpmn:sequenceFlow id="SequenceFlow_23" sourceRef="Task_EmployeeHandOverMeal" targetRef="EndEvent_EmployeeFinished"/>

  </bpmn:process>

  <!-- Chef Process -->
  <bpmn:process id="Process_Chef" isExecutable="false">
    <bpmn:startEvent id="StartEvent_ChefMealNeeded" name="New meal order received">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_30</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_ChefPrepareMeal" name="Prepares meal">
      <bpmn:incoming>SequenceFlow_30</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_31</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_ChefPlaceInHatch" name="Places meal in service hatch">
      <bpmn:incoming>SequenceFlow_31</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_32</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_ChefInformEmployee" name="Informs employee meal is ready">
      <bpmn:incoming>SequenceFlow_32</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_33</bpmn:outgoing>
    </bpmn:task>

    <!-- End event -->
    <bpmn:endEvent id="EndEvent_ChefFinished" name="Meal prepared">
      <bpmn:incoming>SequenceFlow_34</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_30" sourceRef="StartEvent_ChefMealNeeded" targetRef="Task_ChefPrepareMeal"/>
    <bpmn:sequenceFlow id="SequenceFlow_31" sourceRef="Task_ChefPrepareMeal" targetRef="Task_ChefPlaceInHatch"/>
    <bpmn:sequenceFlow id="SequenceFlow_32" sourceRef="Task_ChefPlaceInHatch" targetRef="Task_ChefInformEmployee"/>
    <bpmn:sequenceFlow id="SequenceFlow_33" sourceRef="Task_ChefInformEmployee" targetRef="EndEvent_ChefFinished">
      <bpmn:endEvent id="EndEvent_MealPrepared" name="Meal prepared"/>
    </bpmn:sequenceFlow>

  </bpmn:process>

</bpmn:definitions>