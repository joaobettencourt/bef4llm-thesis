<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Process" name="Customer Acquisition Process" processRef="Process_1" />
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Marketing" name="Marketing">
        <bpmn:flowNodeRef>StartEvent_ContactDetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Methods</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BuyData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Exhibition</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_KnowSomeone</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CallCenter" name="Call Center Employee">
        <bpmn:flowNodeRef>Gateway_ContactPerson</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DetermineBudget</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Development" name="Head of Development">
        <bpmn:flowNodeRef>Gateway_BudgetHuge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PersonalAcquisition</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SalesRep" name="Sales Representative">
        <bpmn:flowNodeRef>Gateway_Interested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_TechnicalPresentation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GiveSalesPresentation</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PreSales" name="Pre-Sales Employee">
        <bpmn:flowNodeRef>Task_GiveTechnicalPresentation</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_ContactDetails" name="Determine contact details">
      <bpmn:outgoing>SequenceFlow_StartToMethods</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Marketing Methods Gateway -->
    <bpmn:exclusiveGateway id="Gateway_Methods">
      <bpmn:name>Contact Details Method?</bpmn:name>
      <bpmn:incoming>SequenceFlow_StartToMethods</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BuyDataPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ExhibitionPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_KnowSomeonePath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Marketing Tasks -->
    <bpmn:task id="Task_BuyData" name="Buy data for cold calls">
      <bpmn:incoming>SequenceFlow_BuyDataPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MarketingToCallCenter1</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_Exhibition" name="Participate in exhibitions">
      <bpmn:incoming>SequenceFlow_ExhibitionPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MarketingToCallCenter2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_KnowSomeone" name="Know somebody interested">
      <bpmn:incoming>SequenceFlow_KnowSomeonePath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MarketingToCallCenter3</bpmn:outgoing>
    </bpmn:task>

    <!-- Call Center Tasks -->
    <bpmn:exclusiveGateway id="Gateway_ContactPerson">
      <bpmn:name>Contact person found?</bpmn:name>
      <bpmn:incoming>SequenceFlow_MarketingToCallCenter1</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_MarketingToCallCenter2</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_MarketingToCallCenter3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CallPersonFound</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_DetermineBudget" name="Determine contact person and budget">
      <bpmn:incoming>SequenceFlow_CallPersonFound</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckInterested</bpmn:outgoing>
    </bpmn:task>

    <!-- Interest Check Gateway -->
    <bpmn:exclusiveGateway id="Gateway_Interested">
      <bpmn:name>Customer interested?</bpmn:name>
      <bpmn:incoming>SequenceFlow_CheckInterested</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_YesInterested</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoInterested</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- No Interest Path -->
    <bpmn:task id="Task_PersonalAcquisition" name="Head of Development acquires customer">
      <bpmn:name>Persuade with huge budget</bpmn:name>
      <bpmn:incoming>SequenceFlow_YesHugeBudget</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PersonalToPresentationCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Budget Check Gateway -->
    <bpmn:exclusiveGateway id="Gateway_BudgetHuge">
      <bpmn:name>Budget huge?</bpmn:name>
      <bpmn:incoming>SequenceFlow_NoInterested</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_YesHugeBudget</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Presentation Decision Gateway -->
    <bpmn:exclusiveGateway id="Gateway_TechnicalPresentation">
      <bpmn:name>Technical presentation needed?</bpmn:name>
      <bpmn:incoming>SequenceFlow_YesInterested</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_PersonalToPresentationCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TechnicalPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SalesPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Presentation Tasks -->
    <bpmn:task id="Task_GiveSalesPresentation" name="Give sales presentation">
      <bpmn:name>Detailed online presentation (Sales Rep)</bpmn:name>
      <bpmn:incoming>SequenceFlow_SalesPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PresentationToWait</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_GiveTechnicalPresentation" name="Give technical presentation">
      <bpmn:name>Detailed online presentation (Pre-Sales)</bpmn:name>
      <bpmn:incoming>SequenceFlow_TechnicalPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PresentationToWait2</bpmn:outgoing>
    </bpmn:task>

    <!-- Wait for Customer -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_Waiting" name="Wait 2 weeks">
      <bpmn:name>Customer response timeout (2 weeks)</bpmn:name>
      <bpmn:incoming>SequenceFlow_PresentationToWait</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CustomerResponse</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Customer Response Gateway -->
    <bpmn:exclusiveGateway id="Gateway_Response">
      <bpmn:name>Contacted within 2 weeks?</bpmn:name>
      <bpmn:incoming>SequenceFlow_CustomerResponse</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_YesContacted</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoContacted</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Follow-up Call -->
    <bpmn:task id="Task_FollowUpCall" name="Sales rep calls customer">
      <bpmn:name>Follow up call after 2 weeks</bpmn:name>
      <bpmn:incoming>SequenceFlow_NoContacted</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FollowUpToQuotation</bpmn:outgoing>
    </bpmn:task>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_NotInterested">
      <bpmn:name>Leave customer alone</bpmn:name>
      <bpmn:incoming>SequenceFlow_NoContactedToQuotation</bpmn:outgoing>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_CreateQuotation" name="Create quotation">
      <bpmn:incoming>SequenceFlow_YesContactedToQuotation</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_FollowUpToQuotation</bpmn:outgoing>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToMethods" sourceRef="StartEvent_ContactDetails" targetRef="Gateway_Methods" />
    
    <bpmn:sequenceFlow id="SequenceFlow_BuyDataPath" name="Buy data" sourceRef="Gateway_Methods" targetRef="Task_BuyData" />
    <bpmn:sequenceFlow id="SequenceFlow_ExhibitionPath" name="Exhibitions" sourceRef="Gateway_Methods" targetRef="Task_Exhibition" />
    <bpmn:sequenceFlow id="SequenceFlow_KnowSomeonePath" name="Know someone" sourceRef="Gateway_Methods" targetRef="Task_KnowSomeone" />

    <bpmn:sequenceFlow id="SequenceFlow_MarketingToCallCenter1" sourceRef="Task_BuyData" targetRef="Gateway_ContactPerson" />
    <bpmn:sequenceFlow id="SequenceFlow_MarketingToCallCenter2" sourceRef="Task_Exhibition" targetRef="Gateway_ContactPerson" />
    <bpmn:sequenceFlow id="SequenceFlow_MarketingToCallCenter3" sourceRef="Task_KnowSomeone" targetRef="Gateway_ContactPerson" />

    <bpmn:sequenceFlow id="SequenceFlow_CallPersonFound" name="Yes, contact person found" sourceRef="Gateway_ContactPerson" targetRef="Task_DetermineBudget" />
    
    <bpmn:sequenceFlow id="SequenceFlow_CheckInterested" sourceRef="Task_DetermineBudget" targetRef="Gateway_Interested" />

    <!-- No Interest Path -->
    <bpmn:sequenceFlow id="SequenceFlow_NoInterested" name="No, not interested" sourceRef="Gateway_Interested" targetRef="Gateway_BudgetHuge" />
    
    <bpmn:sequenceFlow id="SequenceFlow_YesHugeBudget" name="Yes, huge budget" sourceRef="Gateway_BudgetHuge" targetRef="Task_PersonalAcquisition" />

    <!-- Interest Decision -->
    <bpmn:sequenceFlow id="SequenceFlow_NoContactedToQuotation" name="" sourceRef="EndEvent_NotInterested" targetRef="EndEvent_CreateQuotation" />
    
    <bpmn:sequenceFlow id="SequenceFlow_YesInterested" name="Yes, interested" sourceRef="Gateway_Interested" targetRef="Gateway_TechnicalPresentation" />

    <!-- Presentation Path Selection -->
    <bpmn:sequenceFlow id="SequenceFlow_SalesPath" name="Standard presentation" sourceRef="Gateway_TechnicalPresentation" targetRef="Task_GiveSalesPresentation" />
    
    <bpmn:sequenceFlow id="SequenceFlow_TechnicalPath" name="Technical presentation needed" sourceRef="Gateway_TechnicalPresentation" targetRef="Task_GiveTechnicalPresentation" />

    <!-- Wait for Customer -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_Waiting">
      <bpmn:name>Wait 2 weeks</bpmn:name>
      <bpmn:incoming>SequenceFlow_PresentationToWait</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CustomerResponse</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Customer Response -->
    <bpmn:sequenceFlow id="SequenceFlow_PresentationToWait" sourceRef="Task_GiveSalesPresentation" targetRef="IntermediateCatchEvent_Waiting" />
    
    <bpmn:sequenceFlow id="SequenceFlow_CustomerResponse" name="" sourceRef="IntermediateCatchEvent_Waiting" targetRef="Gateway_Response" />

    <!-- Response Decision -->
    <bpmn:exclusiveGateway id="Gateway_Response">
      <bpmn:name>Contacted within 2 weeks?</bpmn:name>
      <bpmn:incoming>SequenceFlow_CustomerResponse</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_YesContacted</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Follow-up Call -->
    <bpmn:sequenceFlow id="SequenceFlow_NoContacted" name="No, not contacted within 2 weeks" sourceRef="Gateway_Response" targetRef="Task_FollowUpCall" />
    
    <bpmn:sequenceFlow id="SequenceFlow_YesContactedToQuotation" name="Yes, customer responded" sourceRef="IntermediateCatchEvent_Waiting" targetRef="EndEvent_CreateQuotation" />

  </bpmn:process>
</bpmn:definitions>