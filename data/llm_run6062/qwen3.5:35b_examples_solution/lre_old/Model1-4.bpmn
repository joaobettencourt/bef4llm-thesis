<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_001">
    <bpmn:participant id="Participant_UnderwriterProcess" name="Underwriter Process" processRef="Process_001"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_001" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_UnderwriterOperations" name="Underwriter Operations">
        <bpmn:flowNodeRef>StartEvent_DecisionToGoPublic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectUnderwriters</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_FactsFairlyPresented</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_InitialSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareRegistrationStatement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckBlueSkyLawsCompliance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateCatchEvent_SECApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_InitialMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ArrangeRoadShowInvestors</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_ApprovedDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FixIssuePrice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterFirmCommitmentBuyStock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OfferToPublic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ProcessSuccess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ProcessRejected</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_DecisionToGoPublic" name="Decision to go public">
      <bpmn:outgoing>SequenceFlow_StartToSelectUnderwriters</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1 -->
    <bpmn:task id="Task_SelectUnderwriters" name="Select underwriters">
      <bpmn:incoming>SequenceFlow_StartToSelectUnderwriters</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToFactsCheckGateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1 - Check facts fairly presented -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_FactsFairlyPresented" name="Facts fairly&#10;presented?">
      <bpmn:name>Fair Facts?</bpmn:name>
      <bpmn:incoming>SequenceFlow_ToFactsCheckGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FactsFairProceed</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Parallel Gateway for concurrent activities -->
    <bpmn:parallelGateway id="ParallelGateway_InitialSplit" name="">
      <bpmn:name>Split Activities</bpmn:name>
      <bpmn:incoming>SequenceFlow_FactsFairProceed</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToRegistrationStatement</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ToBlueSkyCheck</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 2 - Registration Statement -->
    <bpmn:task id="Task_PrepareRegistrationStatement" name="Prepare registration&#10;statement for SEC">
      <bpmn:name>SEC Registration</bpmn:name>
      <bpmn:incoming>SequenceFlow_ToRegistrationStatement</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RegistrationToSECCatchEvent</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3 - Blue Sky Laws -->
    <bpmn:task id="Task_CheckBlueSkyLawsCompliance" name="Check compliance&#10;with blue-sky laws">
      <bpmn:name>State Law Compliance</bpmn:name>
      <bpmn:incoming>SequenceFlow_ToBlueSkyCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BlueSkyToMerge</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Catch Event - SEC Approval -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_SECApproval" name="SEC clearance">
      <bpmn:name>Wait for SEC</bpmn:name>
      <bpmn:incoming>SequenceFlow_RegistrationToSECCatchEvent</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SECToMerge</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Parallel Gateway Merge -->
    <bpmn:parallelGateway id="ParallelGateway_InitialMerge" name="">
      <bpmn:name>Merge Activities</bpmn:name>
      <bpmn:incoming>SequenceFlow_BlueSkyToMerge</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_SECToMerge</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeToRoadshow</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 4 - Road Show -->
    <bpmn:task id="Task_ArrangeRoadShowInvestors" name="Arrange road show&#10;to investors">
      <bpmn:name>Road Show</bpmn:name>
      <bpmn:incoming>SequenceFlow_MergeToRoadshow</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RoadshowToDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2 - Decision after SEC approval -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_ApprovedDecision" name="Reason not to&#10;proceed?">
      <bpmn:name>No Objection?</bpmn:name>
      <bpmn:incoming>SequenceFlow_RoadshowToDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Proceeds</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 5 - Fix Issue Price -->
    <bpmn:task id="Task_FixIssuePrice" name="Fix issue price">
      <bpmn:name>Set Final Price</bpmn:name>
      <bpmn:incoming>SequenceFlow_Proceeds</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PriceToCommitment</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 6 - Firm Commitment -->
    <bpmn:task id="Task_EnterFirmCommitmentBuyStock" name="Enter firm commitment&#10;to buy stock">
      <bpmn:name>Firm Commitment</bpmn:name>
      <bpmn:incoming>SequenceFlow_PriceToCommitment</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CommitmentToOffer</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 7 - Offer to Public -->
    <bpmn:task id="Task_OfferToPublic" name="Offer stock&#10;to public">
      <bpmn:name>Sell to Public</bpmn:name>
      <bpmn:incoming>SequenceFlow_CommitmentToOffer</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OfferToEnd</bpmn:outgoing>
    </bpmn:task>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_ProcessSuccess" name="Process completed">
      <bpmn:name>Sale Completed</bpmn:name>
      <bpmn:incoming>SequenceFlow_OfferToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Rejection End Event -->
    <bpmn:endEvent id="EndEvent_ProcessRejected" name="Process rejected">
      <bpmn:name>No Proceed</bpmn:name>
      <bpmn:incoming>SequenceFlow_RejectedToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToSelectUnderwriters" sourceRef="StartEvent_DecisionToGoPublic" targetRef="Task_SelectUnderwriters"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ToFactsCheckGateway" name="" sourceRef="Task_SelectUnderwriters" targetRef="ExclusiveGateway_FactsFairlyPresented"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_FactsFairProceed" name="Yes - proceed" sourceRef="ExclusiveGateway_FactsFairlyPresented" targetRef="ParallelGateway_InitialSplit"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ToRegistrationStatement" sourceRef="ParallelGateway_InitialSplit" targetRef="Task_PrepareRegistrationStatement"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ToBlueSkyCheck" name="" sourceRef="ParallelGateway_InitialSplit" targetRef="Task_CheckBlueSkyLawsCompliance"/>

    <!-- Task Check Blue Sky Laws outgoing -->
    <bpmn:sequenceFlow id="SequenceFlow_BlueSkyToMerge" sourceRef="Task_CheckBlueSkyLawsCompliance" targetRef="ParallelGateway_InitialMerge"/>

    <!-- Task Registration Statement outgoing -->
    <bpmn:sequenceFlow id="SequenceFlow_RegistrationToSECCatchEvent" sourceRef="Task_PrepareRegistrationStatement" targetRef="IntermediateCatchEvent_SECApproval"/>

    <!-- SEC Catch Event to Merge Gateway -->
    <bpmn:sequenceFlow id="SequenceFlow_SECToMerge" sourceRef="IntermediateCatchEvent_SECApproval" targetRef="ParallelGateway_InitialMerge"/>

    <!-- Road Show Task outgoing -->
    <bpmn:sequenceFlow id="SequenceFlow_MergeToRoadshow" sourceRef="ParallelGateway_InitialMerge" targetRef="Task_ArrangeRoadShowInvestors"/>

    <!-- Decision Gateway incoming/outgoing -->
    <bpmn:sequenceFlow id="SequenceFlow_RoadshowToDecision" name="" sourceRef="Task_ArrangeRoadShowInvestors" targetRef="ExclusiveGateway_ApprovedDecision"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_Proceeds" name="No reason not to proceed" sourceRef="ExclusiveGateway_ApprovedDecision" targetRef="Task_FixIssuePrice"/>

    <!-- Fix Issue Price outgoing -->
    <bpmn:sequenceFlow id="SequenceFlow_PriceToCommitment" sourceRef="Task_FixIssuePrice" targetRef="Task_EnterFirmCommitmentBuyStock"/>

    <!-- Firm Commitment outgoing -->
    <bpmn:sequenceFlow id="SequenceFlow_CommitmentToOffer" name="" sourceRef="Task_EnterFirmCommitmentBuyStock" targetRef="Task_OfferToPublic"/>

    <!-- Offer to Public outgoing -->
    <bpmn:sequenceFlow id="SequenceFlow_OfferToEnd" sourceRef="Task_OfferToPublic" targetRef="EndEvent_ProcessSuccess"/>

  </bpmn:process>
</bpmn:definitions>