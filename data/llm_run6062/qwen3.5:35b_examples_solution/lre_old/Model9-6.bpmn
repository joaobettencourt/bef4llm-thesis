<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_DesignProcess">
    <bpmn:participant id="Participant_DesignSystem" name="Design Process System" processRef="Process_Design_001" />
  </bpmn:collaboration>

  <!-- Design Process -->
  <bpmn:process id="Process_Design_001" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_ElectricalDept" name="Electrical Department">
        <bpmn:flowNodeRef>Pg_StartParallel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_ElecReviewStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewElecDesigns</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateUpdatePlanElec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RevisedElectricalDesign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_ElecTestDecision</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PhysicalDept" name="Physical Department">
        <bpmn:flowNodeRef>Pg_StartParallel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_PhyReviewStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewPhyDesigns</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateUpdatePlanPhy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RevisedPhysicalDesign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_PhyTestDecision</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_01" name="Process Starts">
      <bpmn:outgoing>SequenceFlow_StartToLocate</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Locate Designs -->
    <bpmn:task id="Task_LocateDesigns" name="Locate and distribute existing designs">
      <bpmn:incoming>SequenceFlow_StartToLocate</bpmn:outgoing>
      <bpmn:incoming>SequenceFlow_RestartCycle</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_LocateToParallelSplit</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway -->
    <bpmn:parallelGateway id="Pg_StartParallel">
      <bpmn:incoming>SequenceFlow_LocateToParallelSplit</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SplitElec</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SplitPhy</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Electrical Review Start Gateway -->
    <bpmn:exclusiveGateway id="Gw_ElecReviewStart">
        <bpmn:name>Elec. Ready?</bpmn:name>
      <bpmn:incoming>SequenceFlow_SplitElec</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ReviseElectrical</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Physical Review Start Gateway -->
    <bpmn:exclusiveGateway id="Gw_PhyReviewStart">
        <bpmn:name>Phy. Ready?</bpmn:name>
      <bpmn:incoming>SequenceFlow_SplitPhy</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RevisePhysical</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Electrical Tasks -->
    <bpmn:task id="Task_ReviewElecDesigns" name="Review existing electrical designs">
      <bpmn:incoming>SequenceFlow_ElecLoopBack</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ToPlanElec</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_CreateUpdatePlanElec" name="Create Update Plan (Electrical)">
      <bpmn:incoming>SequenceFlow_ToPlanElec</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ReviseDesignStartElec</bpmn:outgoing>
    </bpmn:task>

    <!-- Boundary Event for Electrical Interruption -->
    <bpmn:boundaryEvent id="Boundary_ElecInterrupt">
      <bpmn:name>Restart Signal</bpmn:name>
      <bpmn:attachedToRef>Task_RevisedElectricalDesign</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:boundaryEvent>

    <!-- Physical Tasks -->
    <bpmn:task id="Task_ReviewPhyDesigns" name="Review existing physical designs">
      <bpmn:incoming>SequenceFlow_PhyLoopBack</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ToPlanPhy</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_CreateUpdatePlanPhy" name="Create Update Plan (Physical)">
      <bpmn:incoming>SequenceFlow_ToPlanPhy</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ReviseDesignStartPhy</bpmn:outgoing>
    </bpmn:task>

    <!-- Boundary Event for Physical Interruption -->
    <bpmn:boundaryEvent id="Boundary_PhyInterrupt">
      <bpmn:name>Restart Signal</bpmn:name>
      <bpmn:attachedToRef>Task_RevisedPhysicalDesign</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:boundaryEvent>

    <!-- Test Gateways -->
    <bpmn:exclusiveGateway id="Gw_ElecTestDecision" name="Elec. Design OK?">
        <bpmn:name>Elec. Design OK?</bpmn:name>
      <bpmn:incoming>SequenceFlow_ElecToTest</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ElecPass</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:exclusiveGateway id="Gw_PhyTestDecision" name="Phy. Design OK?">
        <bpmn:name>Phy. Design OK?</bpmn:name>
      <bpmn:incoming>SequenceFlow_PhyToTest</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PhyPass</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Intermediate Catching Events for Synchronization -->
    <bpmn:startEvent id="StartCatch_ElecReady" name="Signal">
      <bpmn:messageEventDefinition />
      <bpmn:outgoing>SequenceFlow_CatchE_ToJoin</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:startEvent id="StartCatch_PhyReady" name="Signal">
      <bpmn:messageEventDefinition />
      <bpmn:outgoing>SequenceFlow_CatchP_ToJoin</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToLocate" sourceRef="StartEvent_01" targetRef="Task_LocateDesigns" />
    <bpmn:sequenceFlow id="SequenceFlow_RestartCycle" name="No" sourceRef="Gw_CombinedTestDecision" targetRef="Task_LocateDesigns" />

    <!-- Split to Lanes -->
    <bpmn:sequenceFlow id="SequenceFlow_SplitElec" sourceRef="Pg_StartParallel" targetRef="Gw_ElecReviewStart" />
    <bpmn:sequenceFlow id="SequenceFlow_SplitPhy" sourceRef="Pg_StartParallel" targetRef="Gw_PhyReviewStart" />

    <!-- Electrical Loop -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_GwE_BackToReview">
        <bpmn:name>Elec. Review?</b bpmn:name>
      <bpmn:incoming>SequenceFlow_ElecLoopBack</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ReviseElectrical</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Physical Loop -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_GwP_BackToReview">
        <bpmn:name>Phy. Review?</b bpmn:name>
      <bpmn:incoming>SequenceFlow_PhyLoopBack</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RevisePhysical</bpmn:outgoing>
    </bpmn:exclusiveGateway>

  </bpmn:process>
</bpmn:definitions>