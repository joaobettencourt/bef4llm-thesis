<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_RecruitmentProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_Recruitment">
    <bpmn:participant id="Participant_HRSystem" name="Hiring Process System" processRef="Process_01" />
  </bpmn:collaboration>

  <bpmn:process id="Process_01" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_FunctionalDept" name="Functional Department">
        <bpmn:flowNodeRef>StartEvent_Demand</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReportVacancy</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_HRDept" name="HR Department">
        <bpmn:flowNodeRef>Task_AdvertisePost</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckApplication</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConcludeContract</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Applicant" name="Applicant">
        <bpmn:flowNodeRef>Task_SubmitApplication</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Demand" name="Demand for Post">
      <bpmn:outgoing>SequenceFlow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Functional Dept Reports Vacancy -->
    <bpmn:task id="Task_ReportVacancy" name="Report Vacancy">
      <bpmn:incoming>SequenceFlow_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_02</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: HR Advertises Post -->
    <bpmn:task id="Task_AdvertisePost" name="Advertise Post">
      <bpmn:incoming>SequenceFlow_02</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_03</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3: Applicant Applies -->
    <bpmn:task id="Task_SubmitApplication" name="Submit Application">
      <bpmn:incoming>SequenceFlow_03</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_04</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 4: HR Checks Applications -->
    <bpmn:task id="Task_CheckApplication" name="Check Application">
      <bpmn:incoming>SequenceFlow_04</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_05</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 5: HR Concludes Contract -->
    <bpmn:task id="Task_ConcludeContract" name="Conclude Employment Contract">
      <bpmn:incoming>SequenceFlow_05</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_06</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_PostFilled" name="Post Filled">
      <bpmn:incoming>SequenceFlow_06</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_01" sourceRef="StartEvent_Demand" targetRef="Task_ReportVacancy" />
    <bpmn:sequenceFlow id="SequenceFlow_02" name="" sourceRef="Task_ReportVacancy" targetRef="Task_AdvertisePost" />
    <bpmn:sequenceFlow id="SequenceFlow_03" name="" sourceRef="Task_AdvertisePost" targetRef="Task_SubmitApplication" />
    <bpmn:sequenceFlow id="SequenceFlow_04" name="" sourceRef="Task_SubmitApplication" targetRef="Task_CheckApplication" />
    <bpmn:sequenceFlow id="SequenceFlow_05" name="" sourceRef="Task_CheckApplication" targetRef="Task_ConcludeContract" />
    <bpmn:sequenceFlow id="SequenceFlow_06" name="" sourceRef="Task_ConcludeContract" targetRef="EndEvent_PostFilled" />

  </bpmn:process>
</bpmn:definitions>