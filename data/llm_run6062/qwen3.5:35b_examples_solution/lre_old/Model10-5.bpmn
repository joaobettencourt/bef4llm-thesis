<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_001">
    <bpmn:participant id="Pool_MPON" name="MPON" processRef="Process_MPON"/>
    <bpmn:participant id="Pool_MPOO" name="MPOO" processRef="Process_MPOO"/>

    <!-- Message Flow 1: MPON Request -> MPOO Receive -->
    <bpmn:messageFlow id="MessageFlow_01">
      <bpmn:name>Request device takeover bid</bpmn:name>
      <bpmn:sourceRef="Task_RequestBid" />
      <bpmn:targetRef="StartEvent_MPOO_BidReceived"/>
    </bpmn:messageFlow>

    <!-- Message Flow 2: MPOO Tender -> MPON Receive -->
    <bpmn:messageFlow id="MessageFlow_02">
      <bpmn:name>Tender for equipment takeover</bpmn:name>
      <bpmn:sourceRef="Task_SendTender" />
      <bpmn:targetRef="IntermediateCatchEvent_MPON_TenderReceived"/>
    </bpmn:messageFlow>

    <!-- Message Flow 3: MPON Order -> MPOO Receive -->
    <bpmn:messageFlow id="MessageFlow_03">
      <bpmn:name>Order placement</bpmn:name>
      <bpmn:sourceRef="Task_PlaceOrder" />
      <bpmn:targetRef="IntermediateCatchEvent_MPOO_OrderReceived"/>
    </bpmn:messageFlow>

    <!-- Message Flow 4: MPOO Confirm -> MPON Receive -->
    <bpmn:messageFlow id="MessageFlow_04">
      <bpmn:name>Confirm order and master data</bpmn:name>
      <bpmn:sourceRef="Task_ConfirmOrder" />
      <bpmn:targetRef="IntermediateCatchEvent_MPON_OrderConfirmed"/>
    </bpmn:messageFlow>

  </bpmn:collaboration>

  <!-- MPON Process -->
  <bpmn:process id="Process_MPON" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_MPON_01" name="Request device takeover bid">
      <bpmn:outgoing>SequenceFlow_MPON_Start</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Request Bid -->
    <bpmn:task id="Task_RequestBid" name="Send request for device takeover bid">
      <bpmn:incoming>SequenceFlow_MPON_Start</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MPON_BidSent</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Catch Event 1: Receive Tender -->
    <bpmn:startEvent id="IntermediateCatchEvent_MPON_TenderReceived" name="Receive tender">
      <bpmn:incoming>bpmndi:MessageFlowRef_MessageFlow_02</bpmn:incoming> 
      <bpmn:outgoing>SequenceFlow_MPON_BidReceived</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 2: Place Order -->
    <bpmn:task id="Task_PlaceOrder" name="Place order at MPOO">
      <bpmn:incoming>SequenceFlow_MPON_BidReceived</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MPON_OrderSent</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Catch Event 2: Receive Confirmation -->
    <bpmn:startEvent id="IntermediateCatchEvent_MPON_OrderConfirmed" name="Receive confirmation">
      <bpmn:incoming>bpmndi:MessageFlowRef_MessageFlow_04</bpmn:incoming> 
      <bpmn:outgoing>SequenceFlow_MPON_Confirmed</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_MPON" name="Process completed">
      <bpmn:incoming>SequenceFlow_MPON_Confirmed</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows (Corrected to remove invalid message flow refs in process) -->
    <bpmn:sequenceFlow id="SequenceFlow_MPON_Start" sourceRef="StartEvent_MPON_01" targetRef="Task_RequestBid"/>
    
    <!-- Note: In valid BPMN XML without DI, we cannot reference Message Flow IDs inside Process Sequence Flows. 
         The connection is logical via the Collaboration definition. For a strictly valid sequence flow chain in MPON process: -->
    <bpmn:sequenceFlow id="SequenceFlow_MPON_BidSent" sourceRef="Task_RequestBid" targetRef="EndEvent_Temp"/> <!-- Placeholder for logic gap filled by Catch Event start -->

  </bpmn:process>

  <!-- MPOO Process -->
  <bpmn:process id="Process_MPOO" isExecutable="false">
    
    <!-- Start Event (Triggered by Message) -->
    <bpmn:startEvent id="StartEvent_MPOO_BidReceived" name="Receive bid request from MPON">
      <bpmn:outgoing>SequenceFlow_MPOO_Request</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Send Tender -->
    <bpmn:task id="Task_SendTender" name="Send tender for equipment takeover">
      <bpmn:incoming>SequenceFlow_MPOO_Request</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MPOO_TenderSent</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Catch Event 1: Receive Order -->
    <bpmn:startEvent id="IntermediateCatchEvent_MPOO_OrderReceived" name="Receive order from MPON">
      <bpmn:incoming>bpmndi:MessageFlowRef_MessageFlow_03</bpmn:incoming> 
      <bpmn:outgoing>SequenceFlow_MPOO_OrderRecvd</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 2: Confirm Order -->
    <bpmn:task id="Task_ConfirmOrder" name="Confirm order and send master data">
      <bpmn:incoming>SequenceFlow_MPOO_OrderRecvd</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MPOO_Final</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_MPOO" name="Process completed">
      <bpmn:incoming>SequenceFlow_MPOO_Final</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows (Corrected) -->
    <bpmn:sequenceFlow id="SequenceFlow_MPOO_Request" sourceRef="StartEvent_MPOO_BidReceived" targetRef="Task_SendTender"/>
    
  </bpmn:process>

</bpmn:definitions>