<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                 xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" 
                 xmlns:di="http://www.omg.org/spec/DD/20100524/DI" 
                 xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" 
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 id="Definitions_001" targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:collaboration id="Collaboration_UserFaultDetector">
    <!-- Message flows between participants -->
    <bpmn:messageFlow id="MessageFlow_ReportFailure" sourceRef="Task_FaultDetectorReport" targetRef="IntermediateEvent_CatchFailure"/>
    <bpmn:messageFlow id="MessageFlow_ResultShare" sourceRef="Task_ShareResults" targetRef="IntermediateEvent_ReceiveResult"/>
  </bpmn:collaboration>

  <!-- User/Service Provider Pool -->
  <bpmn:process id="Process_UserProvider">
    <bpmn:startEvent id="Start_Suspicion" name="Suspicion of fault">
      <bpmn:outgoing>SequenceFlow_ExamineFailure</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Intermediate event for catching failure report from Fault Detector -->
    <bpmn:intermediateCatchEvent id="IntermediateEvent_CatchFailure" name="Receive Failure Report">
      <bpmn:incoming>MessageFlow_ReportFailure</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ExamineFailure</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task to examine failure -->
    <bpmn:task id="Task_Examine" name="Examine the failure">
      <bpmn:incoming>SequenceFlow_ExamineFailure</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DecisionPoint</bpmn:outgoing>
    </bpmn:task>

    <!-- Decision gateway -->
    <bpmn:exclusiveGateway id="Gateway_RejectConfirm" name="Reject or Confirm?">
      <bpmn:incoming>SequenceFlow_DecisionPoint</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_IfReject</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_IfConfirm</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- If reject path -->
    <bpmn:endEvent id="End_Reject" name="Failure rejected">
      <bpmn:incoming>SequenceFlow_IfReject</bpmn:incoming>
    </bpmn:endEvent>

    <!-- If confirm path - inform about failure -->
    <bpmn:task id="Task_InformCustomerFailure" name="Inform customer of failure">
      <bpmn:incoming>SequenceFlow_IfConfirm</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InformManagerFailure</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_InformManagerFailure" name="Inform manager of failure">
      <bpmn:incoming>SequenceFlow_InformManagerFailure</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FixFault</bpmn:outgoing>
    </bpmn:task>

    <!-- Fix the fault -->
    <bpmn:task id="Task_Fix" name="Fix the fault at measuring device">
      <bpmn:incoming>SequenceFlow_FixFault</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ShareResults</bpmn:outgoing>
    </bpmn:task>

    <!-- Share results with Fault Detector -->
    <bpmn:task id="Task_ShareResults" name="Share repair results">
      <bpmn:incoming>SequenceFlow_ShareResults</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InformCustomerResolution</bpmn:outgoing>
    </bpmn:task>

    <!-- Inform about resolution -->
    <bpmn:task id="Task_InformCustomerResolution" name="Inform customer of resolution">
      <bpmn:incoming>SequenceFlow_InformCustomerResolution</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InformManagerResolution</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_InformManagerResolution" name="Inform manager of resolution">
      <bpmn:incoming>SequenceFlow_InformManagerResolution</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndProcess</bpmn:outgoing>
    </bpmn:task>

    <!-- End event -->
    <bpmn:endEvent id="End_Completed" name="Fault resolved">
      <bpmn:incoming>SequenceFlow_EndProcess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence flows for User Provider process -->
    <bpmn:sequenceFlow id="SequenceFlow_ExamineFailure" sourceRef="Start_Suspicion" targetRef="Task_Examine"/>
    <bpmn:sequenceFlow id="SequenceFlow_DecisionPoint" sourceRef="Task_Examine" targetRef="Gateway_RejectConfirm"/>
    <bpmn:sequenceFlow id="SequenceFlow_IfReject" name="Reject failure" sourceRef="Gateway_RejectConfirm" targetRef="End_Reject"/>
    <bpmn:sequenceFlow id="SequenceFlow_IfConfirm" name="Confirm failure" sourceRef="Gateway_RejectConfirm" targetRef="Task_InformCustomerFailure"/>
    <bpmn:sequenceFlow id="SequenceFlow_FixFault" sourceRef="Task_Examine" targetRef="Task_Fix"/>
    <bpmn:sequenceFlow id="SequenceFlow_ShareResults" sourceRef="Task_Fix" targetRef="Task_ShareResults"/>
    <bpmn:sequenceFlow id="SequenceFlow_InformCustomerResolution" sourceRef="Task_ShareResults" targetRef="Task_InformCustomerResolution"/>
    <bpmn:sequenceFlow id="SequenceFlow_EndProcess" sourceRef="Task_InformManagerResolution" targetRef="End_Completed"/>

  </bpmn:process>

</bpmn:definitions>