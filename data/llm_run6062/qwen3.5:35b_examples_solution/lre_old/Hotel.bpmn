<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_001">
    <bpmn:participant id="Participant_HotelRoomService" name="Hotel Room Service Process" processRef="Process_001" />
  </bpmn:collaboration>

  <bpmn:process id="Process_001" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_RoomServiceManager" name="Room-Service Manager">
        <bpmn:flowNodeRef>StartEvent_GuestCall</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TakeDownOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_ManagerSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_AlcoholicBeverages</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitOrderTicketKitchen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GiveOrderToSommelier</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Kitchen" name="Kitchen">
        <bpmn:flowNodeRef>Task_PrepareMeal</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sommelier" name="Sommelier">
        <bpmn:flowNodeRef>InclusiveGateway_AlcoholicTasks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FetchWineFromCellar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareAlcoholicBeverages</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Waiter" name="Waiter">
        <bpmn:flowNodeRef>ParallelGateway_WaiterStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssignOrderToWaiter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_NonAlcoholicDrinks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReadyCart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareNonAlcoholicDrinks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_ConvergenceWaiter</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_GuestCall" name="Guest Calls Room Service">
      <bpmn:outgoing>SequenceFlow_StartToTakeOrder</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1 - Manager takes order -->
    <bpmn:task id="Task_TakeDownOrder" name="Take Down Order">
      <bpmn:incoming>SequenceFlow_StartToTakeOrder</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OrderToParallelSplit</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway - Manager splits into multiple paths -->
    <bpmn:parallelGateway id="ParallelGateway_ManagerSplit">
      <bpmn:incoming>SequenceFlow_OrderToParallelSplit</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToKitchenTicket</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ToAlcoholicCheck</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Sequence Flow to Kitchen -->
    <bpmn:sequenceFlow id="SequenceFlow_OrderToParallelSplit" sourceRef="Task_TakeDownOrder" targetRef="ParallelGateway_ManagerSplit" />
    
    <!-- Task - Submit Order Ticket to Kitchen -->
    <bpmn:task id="Task_SubmitOrderTicketKitchen" name="Submit Order Ticket to Kitchen">
      <bpmn:incoming>SequenceFlow_ToKitchenTicket</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_KitchenToPrepareMeal</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow - Check for Alcoholic Beverages -->
    <bpmn:sequenceFlow id="SequenceFlow_ToKitchenTicket" sourceRef="ParallelGateway_ManagerSplit" targetRef="Task_SubmitOrderTicketKitchen" />
    
    <!-- Exclusive Gateway - Decision on alcoholic beverages (80%) -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_AlcoholicBeverages">
      <bpmn:name>Alcoholic Beverages Ordered?</bpmn:name>
      <bpmn:incoming>SequenceFlow_ToAlcoholicCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_YesToSommelier</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flow - To Alcoholic Check -->
    <bpmn:sequenceFlow id="SequenceFlow_ToAlcoholicCheck" sourceRef="ParallelGateway_ManagerSplit" targetRef="ExclusiveGateway_AlcoholicBeverages" />
    
    <!-- Task - Give Order to Sommelier (Yes path) -->
    <bpmn:task id="Task_GiveOrderToSommelier" name="Give Order to Sommelier">
      <bpmn:incoming>SequenceFlow_YesToSommelier</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SommelierStartTasks</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow - Yes to Sommelier -->
    <bpmn:sequenceFlow id="SequenceFlow_YesToSommelier" name="Yes (80%)" sourceRef="ExclusiveGateway_AlcoholicBeverages" targetRef="Task_GiveOrderToSommelier" />

    <!-- Inclusive Gateway - Alcoholic Tasks Split in Sommelier Lane -->
    <bpmn:inclusiveGateway id="InclusiveGateway_AlcoholicTasks">
      <bpmn:name>Alcoholic Task Split</bpmn:name>
      <bpmn:incoming>SequenceFlow_SommelierStartTasks</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FetchWineTask</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Sequence Flow - Sommelier Start Tasks -->
    <bpmn:sequenceFlow id="SequenceFlow_SommelierStartTasks" sourceRef="Task_GiveOrderToSommelier" targetRef="InclusiveGateway_AlcoholicTasks" />
    
    <!-- Task - Fetch Wine from Cellar -->
    <bpmn:task id="Task_FetchWineFromCellar" name="Fetch Wine from Cellar">
      <bpmn:incoming>SequenceFlow_FetchWineTask</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WineToConvergence1</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow - Fetch Wine Task -->
    <bpmn:sequenceFlow id="SequenceFlow_FetchWineTask" sourceRef="InclusiveGateway_AlcoholicTasks" targetRef="Task_FetchWineFromCellar" />
    
    <!-- Inclusive Gateway - Convergence for Alcoholic Tasks in Sommelier Lane -->
    <bpmn:inclusiveGateway id="InclusiveGateway_SommelierConverge">
      <bpmn:name>Alcoholic Task Converge</bpmn:name>
      <bpmn:incoming>SequenceFlow_WineToConvergence1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AlcoholReadyToWaiterStart</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Sequence Flow - Wine to Convergence 1 -->
    <bpmn:sequenceFlow id="SequenceFlow_WineToConvergence1" sourceRef="Task_FetchWineFromCellar" targetRef="InclusiveGateway_SommelierConverge" />
    
    <!-- Task - Prepare Alcoholic Beverages (alternative to wine) -->
    <bpmn:task id="Task_PrepareAlcoholicBeverages" name="Prepare Other Alcoholic Beverages">
      <bpmn:incoming>SequenceFlow_AlcoholTasks</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AlcoholToConvergence2</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow - Alcohol Tasks (from Inclusive Gateway) -->
    <bpmn:sequenceFlow id="SequenceFlow_AlcoholTasks" sourceRef="InclusiveGateway_AlcoholicTasks" targetRef="Task_PrepareAlcoholicBeverages" />
    
    <!-- Parallel Gateway - Waiter Lane Start after assignment -->
    <bpmn:parallelGateway id="ParallelGateway_WaiterStart">
      <bpmn:name>Waiter Tasks Split</bpmn:name>
      <bpmn:incoming>SequenceFlow_AlcoholReadyToWaiterStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToCartTask</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Sequence Flow - Alcohol Ready to Waiter Start -->
    <bpmn:sequenceFlow id="SequenceFlow_AlcoholReadyToWaiterStart" sourceRef="InclusiveGateway_SommelierConverge" targetRef="ParallelGateway_WaiterStart" />
    
    <!-- Task - Assign Order to Waiter (Manager) -->
    <bpmn:task id="Task_AssignOrderToWaiter" name="Assign Order to Waiter">
      <bpmn:incoming>SequenceFlow_ToCartTask</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaiterStartTasks</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow - To Cart Task -->
    <bpmn:sequenceFlow id="SequenceFlow_ToCartTask" sourceRef="ParallelGateway_ManagerSplit" targetRef="Task_AssignOrderToWaiter" />
    
    <!-- Exclusive Gateway - Non-Alcoholic Drinks Check (Waiter) -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_NonAlcoholicDrinks">
      <bpmn:name>Non-Alcoholic Drinks Ordered?</bpmn:name>
      <bpmn:incoming>SequenceFlow_WaiterStartTasks</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_YesToPrepareDrinks</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flow - Waiter Start Tasks -->
    <bpmn:sequenceFlow id="SequenceFlow_WaiterStartTasks" sourceRef="Task_AssignOrderToWaiter" targetRef="ExclusiveGateway_NonAlcoholicDrinks" />
    
    <!-- Task - Ready Cart (always) -->
    <bpmn:task id="Task_ReadyCart" name="Ready Cart">
      <bpmn:incoming>SequenceFlow_ToCart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CartToConvergenceWaiter</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow - To Cart -->
    <bpmn:sequenceFlow id="SequenceFlow_ToCart" sourceRef="ParallelGateway_WaiterStart" targetRef="Task_ReadyCart" />
    
    <!-- Task - Prepare Non-Alcoholic Drinks (if needed) -->
    <bpmn:task id="Task_PrepareNonAlcoholicDrinks" name="Prepare Non-Alcoholic Drinks">
      <bpmn:incoming>SequenceFlow_YesToPrepareDrinks</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DrinksReadyToConvergenceWaiter</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow - Yes to Prepare Drinks -->
    <bpmn:sequenceFlow id="SequenceFlow_YesToPrepareDrinks" name="Yes" sourceRef="ExclusiveGateway_NonAlcoholicDrinks" targetRef="Task_PrepareNonAlcoholicDrinks" />
    
    <!-- Inclusive Gateway - Convergence for Waiter Tasks (Cart + Drinks) -->
    <bpmn:inclusiveGateway id="InclusiveGateway_ConvergenceWaiter">
      <bpmn:name>Waiter Task Converge</bpmn:name>
      <bpmn:incoming>SequenceFlow_CartToConvergenceWaiter</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaiterReadyToDeliveryGateway</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Sequence Flow - Cart to Convergence Waiter -->
    <bpmn:sequenceFlow id="SequenceFlow_CartToConvergenceWaiter" sourceRef="Task_ReadyCart" targetRef="InclusiveGateway_ConvergenceWaiter" />
    
    <!-- Parallel Gateway - Final convergence for all three streams (Kitchen, Sommelier, Waiter) -->
    <bpmn:parallelGateway id="ParallelGateway_FinalDelivery">
      <bpmn:name>Final Delivery Convergence</bpmn:name>
      <bpmn:incoming>SequenceFlow_WaiterReadyToDeliveryGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToDeliverTask</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Sequence Flow - Waiter Ready to Delivery Gateway -->
    <bpmn:sequenceFlow id="SequenceFlow_WaiterReadyToDeliveryGateway" sourceRef="InclusiveGateway_ConvergenceWaiter" targetRef="ParallelGateway_FinalDelivery" />
    
    <!-- Task - Prepare Meal (Kitchen) -->
    <bpmn:task id="Task_PrepareMeal" name="Prepare Meal">
      <bpmn:incoming>SequenceFlow_KitchenToPrepareMeal</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MealReadyToFinalGateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow - Kitchen to Prepare Meal -->
    <bpmn:sequenceFlow id="SequenceFlow_KitchenToPrepareMeal" sourceRef="Task_SubmitOrderTicketKitchen" targetRef="Task_PrepareMeal" />
    
    <!-- Task - Deliver to Guest's Room (Waiter) -->
    <bpmn:task id="Task_DeliverToGuestRoom" name="Deliver to Guest's Room">
      <bpmn:incoming>SequenceFlow_ToDeliverTask</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReturnToStation</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow - To Deliver Task -->
    <bpmn:sequenceFlow id="SequenceFlow_ToDeliverTask" sourceRef="ParallelGateway_FinalDelivery" targetRef="Task_DeliverToGuestRoom" />
    
    <!-- Task - Return to Room-Service Station (Waiter) -->
    <bpmn:task id="Task_ReturnToStation" name="Return to Room-Service Station">
      <bpmn:incoming>SequenceFlow_ReturnToStation</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToDebitAccount</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow - Return to Station -->
    <bpmn:sequenceFlow id="SequenceFlow_ReturnToStation" sourceRef="Task_DeliverToGuestRoom" targetRef="Task_ReturnToStation" />
    
    <!-- Task - Debit Guest's Account (Waiter) -->
    <bpmn:task id="Task_DebitAccount" name="Debit Guest's Account">
      <bpmn:incoming>SequenceFlow_ToDebitAccount</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AccountDebitedToEndEvent</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow - To Debit Account -->
    <bpmn:sequenceFlow id="SequenceFlow_ToDebitAccount" sourceRef="Task_ReturnToStation" targetRef="Task_DebitAccount" />
    
    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_AccountDebited">
      <bpmn:name>Order Completed</bpmn:name>
      <bpmn:incoming>SequenceFlow_AccountDebitedToEndEvent</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flow - Account Debited to End Event -->
    <bpmn:sequenceFlow id="SequenceFlow_AccountDebitedToEndEvent" sourceRef="Task_DebitAccount" targetRef="EndEvent_AccountDebited" />
    
  </bpmn:process>
</bpmn:definitions>