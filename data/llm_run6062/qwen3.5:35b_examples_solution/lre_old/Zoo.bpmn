<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_001">
    <bpmn:participant id="Participant_Visitor" name="Visitor" processRef="Process_Visitor"/>
    <bpmn:participant id="Participant_ZooClub" name="Zoo Club department" processRef="Process_ZooClub"/>
    <bpmn:participant id="Participant_Billing" name="Billing department" processRef="Process_Billing"/>
    <bpmn:participant id="Participant_Marketing" name="Marketing department" processRef="Process_Marketing"/>
    <bpmn:messageFlow id="MessageFlow_001" sourceRef="Task_Visitor_SendInfo" targetRef="StartEvent_ZooClub_InfoReceived"/>
    <bpmn:messageFlow id="MessageFlow_002" sourceRef="Task_ZooClub_PaymentRequest" targetRef="StartEvent_Billing_RequestReceived"/>
    <bpmn:messageFlow id="MessageFlow_003" sourceRef="Task_ZooClub_MarketingInfo" targetRef="StartEvent_Marketing_InfoReceived"/>
    <bpmn:messageFlow id="MessageFlow_004" sourceRef="Task_Billing_PaymentRequest" targetRef="StartEvent_Bank_RequestReceived"/>
    <bpmn:messageFlow id="MessageFlow_005" sourceRef="Task_ZooClub_MagazineRequest" targetRef="IntermediateCatchEvent_Visitor_MagazineSent"/>
  </bpmn:collaboration>

  <!-- Visitor Process -->
  <bpmn:process id="Process_Visitor">
    <bpmn:startEvent id="StartEvent_Visitor_01" name="Visitor wants membership">
      <bpmn:outgoing>SequenceFlow_Visitor_StartToDecision</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_Visitor_DecideMembershipType" name="Decide individual or family membership">
      <bpmn:incoming>SequenceFlow_Visitor_StartToDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Visitor_DecisionGateway</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="ExclusiveGateway_Visitor_MembershipType" name="Individual membership?">
      <bpmn:incoming>SequenceFlow_Visitor_DecisionGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Visitor_IndividualPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_Visitor_FamilyPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_Visitor_PersonalInfo" name="Prepare personal information">
      <bpmn:incoming>SequenceFlow_Visitor_IndividualPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Visitor_MergeGateway1</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_Visitor_FamilyInfo" name="Prepare spouse and spawn information">
      <bpmn:incoming>SequenceFlow_Visitor_FamilyPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Visitor_MergeGateway1</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="ExclusiveGateway_Visitor_InfoMerge">
      <bpmn:incoming>SequenceFlow_Visitor_MergeGateway1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Visitor_SendToZooClub</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_Visitor_SendInfo" name="Send information to Zoo Club department">
      <bpmn:incoming>SequenceFlow_Visitor_SendToZooClub</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Visitor_WaitCard</bpmn:outgoing>
    </bpmn:task>

    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_Visitor_CardReceived" name="Receive Zoo Club card">
      <bpmn:incoming>MessageFlow_005</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Visitor_GoHome</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:endEvent id="EndEvent_Visitor">
      <bpmn:incoming>SequenceFlow_Visitor_GoHome</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_Visitor_StartToDecision" sourceRef="StartEvent_Visitor_01" targetRef="Task_Visitor_DecideMembershipType"/>
    <bpmn:sequenceFlow id="SequenceFlow_Visitor_DecisionGateway" name="" sourceRef="Task_Visitor_DecideMembershipType" targetRef="ExclusiveGateway_Visitor_MembershipType"/>
    <bpmn:sequenceFlow id="SequenceFlow_Visitor_IndividualPath" name="Yes" sourceRef="ExclusiveGateway_Visitor_MembershipType" targetRef="Task_Visitor_PersonalInfo"/>
    <bpmn:sequenceFlow id="SequenceFlow_Visitor_FamilyPath" name="No" sourceRef="ExclusiveGateway_Visitor_MembershipType" targetRef="Task_Visitor_FamilyInfo"/>
    <bpmn:sequenceFlow id="SequenceFlow_Visitor_MergeGateway1" sourceRef="Task_Visitor_PersonalInfo" targetRef="ExclusiveGateway_Visitor_InfoMerge"/>
    <bpmn:sequenceFlow id="SequenceFlow_Visitor_SendToZooClub" name="" sourceRef="ExclusiveGateway_Visitor_InfoMerge" targetRef="Task_Visitor_SendInfo"/>
    <bpmn:sequenceFlow id="SequenceFlow_Visitor_WaitCard" sourceRef="Task_Visitor_SendInfo" targetRef="IntermediateCatchEvent_Visitor_CardReceived"/>
    <bpmn:sequenceFlow id="SequenceFlow_Visitor_GoHome" name="" sourceRef="IntermediateCatchEvent_Visitor_CardReceived" targetRef="EndEvent_Visitor"/>

  </bpmn:process>

  <!-- Zoo Club Process -->
  <bpmn:process id="Process_ZooClub">
    <bpmn:startEvent id="StartEvent_ZooClub_InfoReceived" name="Receive visitor information">
      <bpmn:outgoing>SequenceFlow_ZooClub_EnterInfo</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_ZooClub_EnterSystem" name="Enter personal data into system">
      <bpmn:incoming>SequenceFlow_ZooClub_EnterInfo</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ZooClub_ParallelSplit1</bpmn:outgoing>
    </bpmn:task>

    <bpmn:parallelGateway id="ParallelGateway_ZooClub_Split">
      <bpmn:incoming>SequenceFlow_ZooClub_ParallelSplit1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ZooClub_BillingPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ZooClub_MarketingPath</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:task id="Task_ZooClub_PaymentRequest" name="Send payment request to Billing department">
      <bpmn:incoming>SequenceFlow_ZooClub_BillingPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ZooClub_WaitPaymentConfirmation</bpmn:outgoing>
    </bpmn:task>

    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_ZooClub_PaymentConfirmed" name="Wait for payment confirmation">
      <bpmn:incoming>SequenceFlow_ZooClub_WaitPaymentConfirmation</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ZooClub_PrintCardPath</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:task id="Task_ZooClub_MarketingInfo" name="Forward information to Marketing department">
      <bpmn:incoming>SequenceFlow_ZooClub_MarketingPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ZooClub_PrintCardMerge</bpmn:outgoing>
    </bpmn:task>

    <bpmn:parallelGateway id="ParallelGateway_ZooClub_Merge">
      <bpmn:incoming>SequenceFlow_ZooClub_PrintCardPath</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ZooClub_PrintCardMerge</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ZooClub_PrintAndDeliver</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:task id="Task_ZooClub_MagazineRequest" name="Mail Zoo Club magazine to visitor">
      <bpmn:incoming>SequenceFlow_ZooClub_PrintCardMerge</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ZooClub_EndProcess</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_ZooClub">
      <bpmn:incoming>SequenceFlow_ZooClub_PrintAndDeliver</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_ZooClub_EnterInfo" sourceRef="StartEvent_ZooClub_InfoReceived" targetRef="Task_ZooClub_EnterSystem"/>
    <bpmn:sequenceFlow id="SequenceFlow_ZooClub_ParallelSplit1" name="" sourceRef="Task_ZooClub_EnterSystem" targetRef="ParallelGateway_ZooClub_Split"/>
    <bpmn:sequenceFlow id="SequenceFlow_ZooClub_BillingPath" name="" sourceRef="ParallelGateway_ZooClub_Split" targetRef="Task_ZooClub_PaymentRequest"/>
    <bpmn:sequenceFlow id="SequenceFlow_ZooClub_MarketingPath" name="" sourceRef="ParallelGateway_ZooClub_Split" targetRef="Task_ZooClub_MarketingInfo"/>
    <bpmn:sequenceFlow id="SequenceFlow_ZooClub_WaitPaymentConfirmation" sourceRef="Task_ZooClub_PaymentRequest" targetRef="IntermediateCatchEvent_ZooClub_PaymentConfirmed"/>
    <bpmn:sequenceFlow id="SequenceFlow_ZooClub_PrintCardPath" name="" sourceRef="IntermediateCatchEvent_ZooClub_PaymentConfirmed" targetRef="ParallelGateway_ZooClub_Merge"/>
    <bpmn:sequenceFlow id="SequenceFlow_ZooClub_PrintCardMerge" name="" sourceRef="Task_ZooClub_MarketingInfo" targetRef="ParallelGateway_ZooClub_Merge"/>
    <bpmn:sequenceFlow id="SequenceFlow_ZooClub_PrintAndDeliver" name="" sourceRef="ParallelGateway_ZooClub_Merge" targetRef="EndEvent_ZooClub"/>

  </bpmn:process>

  <!-- Billing Process -->
  <bpmn:process id="Process_Billing">
    <bpmn:startEvent id="StartEvent_Billing_RequestReceived" name="Receive payment request">
      <bpmn:outgoing>SequenceFlow_Billing_SendToBank</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:endEvent id="EndEvent_Billing"/>

  </bpmn:process>

  <!-- Marketing Process -->
  <bpmn:process id="Process_Marketing">
    <bpmn:startEvent id="StartEvent_Marketing_InfoReceived" name="Receive visitor information from Zoo Club">
      <bpmn:outgoing>SequenceFlow_Marketing_SendMagazine</bpmn:outgoing>
    </bpmn:startEvent>

  </bpmn:process>

  <!-- Bank Process -->
  <bpmn:process id="Process_Bank">
    <bpmn:startEvent id="StartEvent_Bank_RequestReceived" name="Receive payment request from Billing department">
      <bpmn:outgoing>SequenceFlow_Bank_ProcessPayment</bpmn:outgoing>
    </bpmn:startEvent>

  </bpmn:process>

</bpmn:definitions>