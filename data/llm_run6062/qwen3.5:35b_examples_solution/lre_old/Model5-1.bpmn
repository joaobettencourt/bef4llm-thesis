<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" 
                xmlns:di="http://www.omg.org/spec/DD/20100524/DI" 
                xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
                id="Definitions_LoanApproval_001" targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:collaboration id="Collaboration_LoanProcess_001">
    <bpmn:participant id="Participant_LoanSystem_001" name="Loan Approval System" processRef="Process_LoanApproval_001"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_LoanApproval_001" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_ReceiveRequest_001" name="Receive Loan Request">
      <bpmn:outgoing>SequenceFlow_StartToRiskAssessment_001</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Risk Assessment Task -->
    <bpmn:task id="Task_RiskAssessment_001" name="Invoke Risk Assessment Service">
      <bpmn:incoming>SequenceFlow_StartToRiskAssessment_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToGateway_001</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway for Decision -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_Decision_001" name="Loan Assessment Result">
      <bpmn:name>Data Based on Risk &amp; Amount</bpmn:name>
      <bpmn:incoming>SequenceFlow_ToGateway_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ApprovePath_001</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_DenyPath_001</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ReviewPath_001</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Approval Path End Event -->
    <bpmn:endEvent id="EndEvent_Approved_001" name="Loan Approved">
      <bpmn:name>Approve Loan</bpmn:name>
      <bpmn:incoming>SequenceFlow_ApprovePath_001</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Denial Path End Event -->
    <bpmn:endEvent id="EndEvent_Denied_001" name="Loan Denied">
      <bpmn:name>Deny Loan</bpmn:name>
      <bpmn:incoming>SequenceFlow_DenyPath_001</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Review/Approval Request Path -->
    <bpmn:task id="Task_SendToApprover_001" name="Send to Approver Service">
      <bpmn:name>Invoke Loan Approval Web Service</bpmn:name>
      <bpmn:incoming>SequenceFlow_ReviewPath_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToFeedbackEnd_001</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event for Review Path -->
    <bpmn:endEvent id="EndEvent_Feedback_001" name="Awaiting Feedback">
      <bpmn:name>Customer Receives Feedback</bpmn:name>
      <bpmn:incoming>SequenceFlow_ToFeedbackEnd_001</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToRiskAssessment_001" sourceRef="StartEvent_ReceiveRequest_001" targetRef="Task_RiskAssessment_001"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ToGateway_001" sourceRef="Task_RiskAssessment_001" targetRef="ExclusiveGateway_Decision_001"/>

    <!-- Gateway Outgoing Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_ApprovePath_001" name="Small Loan &amp; Low Risk" sourceRef="ExclusiveGateway_Decision_001" targetRef="EndEvent_Approved_001"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_DenyPath_001" name="High Risk" sourceRef="ExclusiveGateway_Decision_001" targetRef="EndEvent_Denied_001"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ReviewPath_001" name="Needs Review OR $10,000+" sourceRef="ExclusiveGateway_Decision_001" targetRef="Task_SendToApprover_001"/>

    <!-- Final Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_ToFeedbackEnd_001" sourceRef="Task_SendToApprover_001" targetRef="EndEvent_Feedback_001"/>

  </bpmn:process>
</bpmn:definitions>