<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_001">
    <bpmn:participant id="Participant_Hospital" name="Hospital" processRef="Process_001" />
  </bpmn:collaboration>

  <bpmn:process id="Process_001" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="Start_ExaminePatient" name="Examine patient">
      <bpmn:outgoing>SequenceFlow_StartToDecision</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Examine Patient (Outpatient Physician) -->
    <bpmn:task id="Task_ExaminePatient" name="Examine patient">
      <bpmn:incoming>SequenceFlow_StartToDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_HealthyOrAdditional</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Additional examination required? -->
    <bpmn:exclusiveGateway id="Gate_AdditionalExam" name="Additional exam&#xa;required?">
      <bpmn:incoming>SequenceFlow_HealthyOrAdditional</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NoExamNeeded</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ExamRequired</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Path 1: No additional exam needed -->
    <bpmn:task id="Task_FillExamForm" name="Fill examination form">
      <bpmn:incoming>SequenceFlow_NoExamNeeded</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReleasePatient</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 1 -->
    <bpmn:endEvent id="End_PatientReleased" name="Release patient">
      <bpmn:incoming>SequenceFlow_ReleasePatient</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Path 2: Additional exam required - Order examination & follow-up treatment -->
    <bpmn:task id="Task_OrderExam" name="Order examination&#xa;&amp; follow-up">
      <bpmn:incoming>SequenceFlow_ExamRequired</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InformRisks</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3: Inform about risks -->
    <bpmn:task id="Task_InformRisks" name="Inform patient&#xa;about risks">
      <bpmn:incoming>SequenceFlow_InformRisks</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PatientAgrees</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2: Patient agrees? -->
    <bpmn:exclusiveGateway id="Gate_PatientAgree" name="Patient&#xa;agrees?">
      <bpmn:incoming>SequenceFlow_PatientAgrees</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AgreeContinue</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Path 2a: Patient agrees - Arrange appointment -->
    <bpmn:task id="Task_ArrangeAppointment" name="Arrange appointment">
      <bpmn:incoming>SequenceFlow_AgreeContinue</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PrepareExam</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 5: Prepare examination -->
    <bpmn:task id="Task_PrepareExam" name="Prepare examination">
      <bpmn:incoming>SequenceFlow_PrepareExam</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TakeSample</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 6: Take sample -->
    <bpmn:task id="Task_TakeSample" name="Take sample">
      <bpmn:incoming>SequenceFlow_TakeSample</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendToLab</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 7: Send to lab -->
    <bpmn:task id="Task_SendToLab" name="Send sample&#xa;to lab">
      <bpmn:incoming>SequenceFlow_SendToLab</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FollowUpTreatment</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 8: Follow-up treatment -->
    <bpmn:task id="Task_FollowUp" name="Follow-up&#xa;treatment">
      <bpmn:incoming>SequenceFlow_FollowUpTreatment</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_LabReceiveSample</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 9: Validate sample state -->
    <bpmn:task id="Task_ValidateState" name="Validate&#xa;sample state">
      <bpmn:incoming>SequenceFlow_LabReceiveSample</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SampleOkDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 3: Sample ok? -->
    <bpmn:exclusiveGateway id="Gate_SampleOK" name="Sample&#xa;ok?">
      <bpmn:incoming>SequenceFlow_SampleOkDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AnalysisOK</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Path 3a: Sample OK - Perform analysis -->
    <bpmn:task id="Task_PerformAnalysis" name="Perform&#xa;analysis">
      <bpmn:incoming>SequenceFlow_AnalysisOK</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ValidateResults</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 10: Validate results -->
    <bpmn:task id="Task_ValidateResults" name="Validate&#xa;results">
      <bpmn:incoming>SequenceFlow_ValidateResults</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MakeDiagnosis</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 11: Make diagnosis -->
    <bpmn:task id="Task_MakeDiagnosis" name="Make&#xa;diagnosis">
      <bpmn:incoming>SequenceFlow_MakeDiagnosis</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PrescribeTherapy</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 12: Prescribe therapy -->
    <bpmn:task id="Task_PrescribeTherapy" name="Prescribe&#xa;therapy">
      <bpmn:incoming>SequenceFlow_PrescribeTherapy</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndProcess</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 2 -->
    <bpmn:endEvent id="End_ProcessComplete" name="Therapy&#xa;prescribed">
      <bpmn:incoming>SequenceFlow_EndProcess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToDecision" sourceRef="Start_ExaminePatient" targetRef="Task_ExaminePatient" />
    
    <bpmn:sequenceFlow id="SequenceFlow_HealthyOrAdditional" name="" sourceRef="Task_ExaminePatient" targetRef="Gate_AdditionalExam" />

    <!-- Path 1 -->
    <bpmn:sequenceFlow id="SequenceFlow_NoExamNeeded" name="No additional exam needed" sourceRef="Gate_AdditionalExam" targetRef="Task_FillExamForm" />
    
    <bpmn:sequenceFlow id="SequenceFlow_ReleasePatient" sourceRef="Task_FillExamForm" targetRef="End_PatientReleased" />

    <!-- Path 2 -->
    <bpmn:sequenceFlow id="SequenceFlow_ExamRequired" name="Additional exam required" sourceRef="Gate_AdditionalExam" targetRef="Task_OrderExam" />
    
    <bpmn:sequenceFlow id="SequenceFlow_InformRisks" sourceRef="Task_OrderExam" targetRef="Task_InformRisks" />

    <!-- Path 2a -->
    <bpmn:sequenceFlow id="SequenceFlow_PatientAgrees" name="" sourceRef="Task_InformRisks" targetRef="Gate_PatientAgree" />
    
    <bpmn:sequenceFlow id="SequenceFlow_AgreeContinue" name="Yes, continue with procedure" sourceRef="Gate_PatientAgree" targetRef="Task_ArrangeAppointment" />

    <!-- Path 2a continued -->
    <bpmn:sequenceFlow id="SequenceFlow_PrepareExam" sourceRef="Task_ArrangeAppointment" targetRef="Task_PrepareExam" />
    
    <bpmn:sequenceFlow id="SequenceFlow_TakeSample" name="" sourceRef="Task_PrepareExam" targetRef="Task_TakeSample" />

    <!-- Path 2a continued -->
    <bpmn:sequenceFlow id="SequenceFlow_SendToLab" sourceRef="Task_TakeSample" targetRef="Task_SendToLab" />
    
    <bpmn:sequenceFlow id="SequenceFlow_FollowUpTreatment" name="" sourceRef="Task_SendToLab" targetRef="Task_FollowUp" />

    <!-- Path 3 -->
    <bpmn:sequenceFlow id="SequenceFlow_LabReceiveSample" sourceRef="Task_FollowUp" targetRef="Task_ValidateState" />
    
    <bpmn:sequenceFlow id="SequenceFlow_SampleOkDecision" name="" sourceRef="Task_ValidateState" targetRef="Gate_SampleOK" />

    <!-- Path 3a -->
    <bpmn:sequenceFlow id="SequenceFlow_AnalysisOK" name="Sample OK for analysis" sourceRef="Gate_SampleOK" targetRef="Task_PerformAnalysis" />
    
    <bpmn:sequenceFlow id="SequenceFlow_ValidateResults" sourceRef="Task_PerformAnalysis" targetRef="Task_ValidateResults" />

    <!-- Path 3a continued -->
    <bpmn:sequenceFlow id="SequenceFlow_MakeDiagnosis" name="" sourceRef="Task_ValidateResults" targetRef="Task_MakeDiagnosis" />
    
    <bpmn:sequenceFlow id="SequenceFlow_PrescribeTherapy" name="" sourceRef="Task_MakeDiagnosis" targetRef="Task_PrescribeTherapy" />

    <!-- End -->
    <bpmn:sequenceFlow id="SequenceFlow_EndProcess" sourceRef="Task_PrescribeTherapy" targetRef="End_ProcessComplete" />

  </bpmn:process>
</bpmn:definitions>