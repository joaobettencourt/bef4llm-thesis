<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_001">
    <bpmn:participant id="Participant_GO" name="GO" processRef="Process_GO"/>
    <bpmn:participant id="Participant_MSP" name="MSP" processRef="Process_MSP"/>
    
    <!-- Message Flows -->
    <bpmn:messageFlow id="MessageFlow_01" sourceRef="Task_RequestMeasurement" targetRef="IntermediateCatchEvent_CheckRequest"/>
    <bpmn:messageFlow id="MessageFlow_02" sourceRef="Task_InformFailure" targetRef="EndEvent_GO_Failure"/>
    <bpmn:messageFlow id="MessageFlow_03" sourceRef="Task_TransmitValuesToGO" targetRef="IntermediateCatchEvent_ProcessedValues"/>
    <bpmn:messageFlow id="MessageFlow_04" sourceRef="Task_SendChangedValues" targetRef="EndEvent_MSP_ChangedReceived"/>
  </bpmn:collaboration>

  <!-- MSP Process -->
  <bpmn:process id="Process_MSP" isExecutable="false">
    <bpmn:startEvent id="StartEvent_MSP_01">
      <bpmn:name>MSP Start</bpmn:name>
      <bpmn:outgoing>SequenceFlow_StartToCheckRequest</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_CheckRequest" name="Check received request">
      <bpmn:incoming>SequenceFlow_StartToCheckRequest</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RequestDecision</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="ExclusiveGateway_DenyOrMeasure">
      <bpmn:name>Deny or Measure?</bpmn:name>
      <bpmn:incoming>SequenceFlow_RequestDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DenyRequest</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PerformMeasurement</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="EndEvent_MSP_Failure">
        <bpmn:name>MSP End - Denial</bpmn:name>
      <bpmn:incoming>SequenceFlow_InfFailEnd</bpmn:outgoing> <!-- Fixed tag mismatch -->
    </bpmn:endEvent>

    <bpmn:task id="Task_InformFailure" name="Inform GO about failure">
        <bpmn:name>Inform GO of denial</bpmn:name>
      <bpmn:incoming>SequenceFlow_DenyRequest</bpmn:outgoing> <!-- Fixed tag mismatch -->
      <bpmn:outgoing>SequenceFlow_InfFailEnd</bpmn:outgoing>
    </bpmn:endEvent>

    <bpmn:startEvent id="StartEvent_MSP_Success">
        <bpmn:name>MSP Start - Measure Path</bpmn:name> <!-- Placeholder for logic flow -->
      <bpmn:incoming>SequenceFlow_PerformMeasurement</bpmn:outgoing> 
       <bpmn:outgoing>SequenceFlow_TransmitValuesToGO</bpmn:outgoing>
    </bpmn:startEvent>

     <bpmn:endEvent id="EndEvent_MSP_Success">
      <bpmn:name>MSP End - Measurement Sent</bpmn:name>
       <bpmn:incoming>SequenceFlow_TransmitValuesToGO</bpmn:outgoing> <!-- Fixed tag mismatch -->
    </bpmn:endEvent>

     <bpmn:startEvent id="StartEvent_MSP_Changed">
        <bpmn:name>MSP Start - Changed Received</bpmn:name> 
      <bpmn:incoming>SequenceFlow_TransmitValuesToGO</bpmn:outgoing> <!-- Fixed tag mismatch -->
       <bpmn:outgoing>SequenceFlow_WaitForChanged</bpmn:outgoing>
    </bpmn:startEvent>

     <bpmn:endEvent id="EndEvent_MSP_ChangedReceived">
      <bpmn:name>MSP End - Changed Received</bpmn:name>
       <bpmn:incoming>SequenceFlow_WaitForChanged</bpmn:outgoing> <!-- Fixed tag mismatch -->
    </bpmn:endEvent>

     <bpmn:startEvent id="StartEvent_MSP_01">
      <bpmn:name>MSP Start</bpmn:name>
       <bpmn:incoming>SequenceFlow_StartToCheckRequest</bpmn:outgoing> <!-- Fixed tag mismatch -->
