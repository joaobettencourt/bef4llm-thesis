<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_001">
    <bpmn:participant id="Participant_ClaimHandling" name="Claim Handling Process" processRef="Process_001" />
  </bpmn:collaboration>

  <bpmn:process id="Process_001" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_ClaimsOfficer" name="Claims Officer">
        <bpmn:flowNodeRef>StartEvent_ClaimRegistered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExamineClaim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WriteRecommendation</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SeniorClaimsOfficer" name="Senior Claims Officer">
        <bpmn:flowNodeRef>ExclusiveGateway_DecisionOKNotOK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ProcessProceeds</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_ClaimRegistered" name="Claim Registered">
      <bpmn:outgoing>SequenceFlow_StartToExamine</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Examine Claim -->
    <bpmn:task id="Task_ExamineClaim" name="Examine claim">
      <bpmn:incoming>SequenceFlow_StartToExamine</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToWriteRecommendation</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: Write Recommendation -->
    <bpmn:task id="Task_WriteRecommendation" name="Write settlement recommendation">
      <bpmn:incoming>SequenceFlow_ToWriteRecommendation</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SeniorCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway for OK/NotOK Decision -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_DecisionOKNotOK" name="Recommendation approved?">
      <bpmn:incoming>SequenceFlow_SeniorCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OKProceeds</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NotOKLoopback</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_ProcessProceeds" name="Process proceeds">
      <bpmn:incoming>SequenceFlow_OKProceeds</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToExamine" sourceRef="StartEvent_ClaimRegistered" targetRef="Task_ExamineClaim">
      <bpmn:name></bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ToWriteRecommendation" sourceRef="Task_ExamineClaim" targetRef="Task_WriteRecommendation">
      <bpmn:name></bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_SeniorCheck" name="" sourceRef="Task_WriteRecommendation" targetRef="ExclusiveGateway_DecisionOKNotOK"></bpmn:sequenceFlow>

    <!-- OK Path -->
    <bpmn:sequenceFlow id="SequenceFlow_OKProceeds" name="Yes (OK)" sourceRef="ExclusiveGateway_DecisionOKNotOK" targetRef="EndEvent_ProcessProceeds">
      <bpmn:name></bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Not OK Path - Loopback -->
    <bpmn:sequenceFlow id="SequenceFlow_NotOKLoopback" name="No (Not OK)" sourceRef="ExclusiveGateway_DecisionOKNotOK" targetRef="Task_WriteRecommendation">
      <bpmn:name></bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>