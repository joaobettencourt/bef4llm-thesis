<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ExpenseReport" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_ExpenseProcess">
    <bpmn:participant id="Participant_EmployeeFinance" name="Employee Finance Process" processRef="Process_ExpenseApproval"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_ExpenseApproval" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_FinanceDept" name="Finance Department">
        <bpmn:flowNodeRef>StartMessageEvent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_MainSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_AccountCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_AmountCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SupervisorApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_ApprovalDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendRejectionEmail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TransferPayment</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartMessageEvent" name="Receive Expense Report">
      <bpmn:outgoing>SequenceFlow_StartToSplit</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Parallel Gateway for Timer and Main Flow Split -->
    <bpmn:parallelGateway id="ParallelGateway_MainSplit" name="">
      <bpmn:incoming>SequenceFlow_StartToSplit</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Timer7DaysPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_AccountCheckPath</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Timer for 7 Days -->
    <bpmn:intermediateCatchEvent id="Timer_7Days" name="After 7 days">
      <bpmn:incoming>SequenceFlow_Timer7DaysPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendProgressEmailTask</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Timer for 30 Days -->
    <bpmn:intermediateCatchEvent id="Timer_30Days" name="After 30 days">
      <bpmn:incoming>SequenceFlow_TimerPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendCancellationEmailTask</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Account Check Gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_AccountCheck" name="Account Exists?">
      <bpmn:name>Data Based Decision</bpmn:name>
      <bpmn:incoming>SequenceFlow_AccountCheckPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CreateAccountPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Create Account -->
    <bpmn:task id="Task_CreateAccount" name="Create Employee Account">
      <bpmn:name>User Task</bpmn:name>
      <bpmn:incoming>SequenceFlow_AccountCheckPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToReviewReport</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Review Report -->
    <bpmn:task id="Task_ReviewReport" name="Review Expense Report">
      <bpmn:name>User Task</bpmn:name>
      <bpmn:incoming>SequenceFlow_ToReviewReport</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AmountCheckPath</bpmn:outgoing>
    </bpmn:task>

    <!-- Amount Check Gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_AmountCheck" name="Amount &lt; $200?">
      <bpmn:name>Data Based Decision</bpmn:name>
      <bpmn:incoming>SequenceFlow_AmountCheckPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_QuickApprovalPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Supervisor Approval -->
    <bpmn:task id="Task_SupervisorApproval" name="Supervisor Review">
      <bpmn:name>User Task</bpmn:name>
      <bpmn:incoming>SequenceFlow_QuickApprovalPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ApprovalDecisionPath</bpmn:outgoing>
    </bpmn:task>

    <!-- Approval Decision Gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_ApprovalDecision" name="Approved?">
      <bpmn:name>Data Based Decision</bpmn:name>
      <bpmn:incoming>SequenceFlow_SupervisorReviewPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendRejectionEmailPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Send Rejection Email -->
    <bpmn:task id="Task_SendRejectionEmail" name="Send Rejection Notice">
      <bpmn:name>User Task</bpmn:name>
      <bpmn:incoming>SequenceFlow_SendRejectionEmailPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToEndRejected</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Transfer Payment -->
    <bpmn:task id="Task_TransferPayment" name="Transfer to Direct Deposit">
      <bpmn:name>User Task</bpmn:name>
      <bpmn:incoming>SequenceFlow_QuickApprovalPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToEndApproved</bpmn:outgoing>
    </bpmn:task>

    <!-- End Events -->
    <bpmn:endEvent id="EndRejected" name="Process Ended - Rejected">
      <bpmn:name>Terminate Event</bpmn:name>
      <bpmn:incoming>SequenceFlow_ToEndRejected</bpmn:incoming>
    </bpmn:endEvent>

    <!-- End Events -->
    <bpmn:endEvent id="EndApproved" name="Process Ended - Approved">
      <bpmn:name>Terminate Event</bpmn:name>
      <bpmn:incoming>SequenceFlow_ToEndApproved</bpmn:incoming>
    </bpmn:endEvent>

    <!-- End Events -->
    <bpmn:endEvent id="EndCancelled" name="Process Ended - Cancelled">
      <bpmn:name>Terminate Event</bpmn:name>
      <bpmn:incoming>SequenceFlow_ToEndCancelled</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToSplit" sourceRef="StartMessageEvent" targetRef="ParallelGateway_MainSplit"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_Timer7DaysPath" name="" sourceRef="ParallelGateway_MainSplit" targetRef="Timer_7Days"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_AccountCheckPath" name="" sourceRef="ParallelGateway_MainSplit" targetRef="ExclusiveGateway_AccountCheck"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_CreateAccountPath" name="No Account Exists" sourceRef="ExclusiveGateway_AccountCheck" targetRef="Task_CreateAccount"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ToReviewReport" name="" sourceRef="Task_CreateAccount" targetRef="Task_ReviewReport"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_AmountCheckPath" name="" sourceRef="Task_ReviewReport" targetRef="ExclusiveGateway_AmountCheck"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_QuickApprovalPath" name="Amount &lt; $200 (Auto-approve)" sourceRef="ExclusiveGateway_AmountCheck" targetRef="Task_TransferPayment"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_SupervisorReviewPath" name="Amount >= $200 (Supervisor Review Required)" sourceRef="ExclusiveGateway_AmountCheck" targetRef="Task_SupervisorApproval"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ApprovalDecisionPath" name="" sourceRef="Task_SupervisorApproval" targetRef="ExclusiveGateway_ApprovalDecision"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_SendRejectionEmailPath" name="Not Approved" sourceRef="ExclusiveGateway_ApprovalDecision" targetRef="Task_SendRejectionEmail"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ToEndRejected" name="" sourceRef="Task_SendRejectionEmail" targetRef="EndRejected"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ToEndApproved" name="" sourceRef="Task_TransferPayment" targetRef="EndApproved"/>

  </bpmn:process>
</bpmn:definitions>