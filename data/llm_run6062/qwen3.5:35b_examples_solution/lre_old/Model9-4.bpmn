<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_001">
    <bpmn:participant id="Participant_CoordinationUnit" name="Coordination Unit" processRef="Process_CoordinationUnit" />
    <bpmn:participant id="Participant_SupportOfficer" name="Support Officer" processRef="Process_SupportOfficer" />
    <bpmn:participant id="Participant_CommitteeMembers" name="Committee Members" processRef="Process_CommitteeMembers" />

    <!-- Message Flows -->
    <bpmn:messageFlow id="MessageFlow_RemindMembers" sourceRef="IntermediateThrowEvent_SupportRemind" targetRef="StartEvent_MembersReminder" />
    <bpmn:messageFlow id="MessageFlow_MinutesSent" sourceRef="Task_SendMinutesToMembers" targetRef="EndEvent_MinutesReceived" />
  </bpmn:collaboration>

  <!-- Coordination Unit Process -->
  <bpmn:process id="Process_CoordinationUnit">
    <bpmn:startEvent id="StartEvent_DatesFinalized" name="Dates finalized">
      <bpmn:outgoing>SequenceFlow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:endEvent id="EndEvent_QADone" name="QA check completed">
      <bpmn:incoming>SequenceFlow_04</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Timer for 5 working days -->
    <bpmn:intermediateCatchEvent id="IntermediateTimer_QA" name="Within 5 working days">
      <bpmn:timerEventDefinition />
      <bpmn:incoming>SequenceFlow_02</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_03</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task for QA check -->
    <bpmn:task id="Task_QACheckMinutes" name="QA check on minutes">
      <bpmn:incoming>SequenceFlow_03</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_04</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_CoordinationUnit" sourceRef="StartEvent_DatesFinalized" targetRef="Task_QACheckMinutes" />
  </bpmn:process>

  <!-- Support Officer Process -->
  <bpmn:process id="Process_SupportOfficer">
    <bpmn:startEvent id="StartEvent_MeetingDue" name="Meeting due">
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Tasks -->
    <bpmn:task id="Task_UpdateCalendars" name="Update group calendars">
      <bpmn:incoming>SequenceFlow_10</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_11</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_CreateMeetingFolders" name="Create meeting folders">
      <bpmn:incoming>SequenceFlow_11</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_12</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_UploadDocuments" name="Upload documents to system">
      <bpmn:incoming>SequenceFlow_12</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_13</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Event for 1 week before meeting -->
    <bpmn:intermediateCatchEvent id="IntermediateTimer_Reminder" name="1 week before meeting">
      <bpmn:timerEventDefinition />
      <bpmn:incoming>SequenceFlow_13</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_14</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task for producing minutes -->
    <bpmn:task id="Task_ProduceMinutes" name="Produce meeting minutes">
      <bpmn:incoming>SequenceFlow_20</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_16</bpmn:outgoing>
    </bpmn:task>

    <!-- Task for updating departmental records -->
    <bpmn:task id="Task_UpdateRecords" name="Update departmental records">
      <bpmn:incoming>SequenceFlow_25</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_18</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Throw Event for sending minutes -->
    <bpmn:intermediateThrowEvent id="Task_SendMinutesToMembers" name="Send minutes to members">
      <bpmn:messageEventDefinition />
      <bpmn:incoming>SequenceFlow_16</bpmn:incoming>
      <bpmn:outgoing>MessageFlow_MinutesSent</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <!-- Intermediate Throw Event for reminding members -->
    <bpmn:intermediateThrowEvent id="IntermediateThrowEvent_SupportRemind" name="Remind to read documents">
      <bpmn:messageEventDefinition />
      <bpmn:incoming>SequenceFlow_14</bpmn:incoming>
      <bpmn:outgoing>MessageFlow_RemindMembers</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_ProcessComplete" name="Records updated">
      <bpmn:incoming>SequenceFlow_18</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="StartEvent_MeetingDue" targetRef="Task_UpdateCalendars" />
    <bpmn:sequenceFlow id="SequenceFlow_11" sourceRef="Task_UpdateCalendars" targetRef="Task_CreateMeetingFolders" />
    <bpmn:sequenceFlow id="SequenceFlow_12" sourceRef="Task_CreateMeetingFolders" targetRef="Task_UploadDocuments" />
    <bpmn:sequenceFlow id="SequenceFlow_13" sourceRef="Task_UploadDocuments" targetRef="IntermediateTimer_Reminder" />
    <bpmn:sequenceFlow id="SequenceFlow_14" sourceRef="IntermediateTimer_Reminder" targetRef="IntermediateThrowEvent_SupportRemind" />
    <bpmn:sequenceFlow id="SequenceFlow_20" name="After meeting held by members" sourceRef="Task_MeetingHeld" targetRef="Task_ProduceMinutes" />
    <bpmn:sequenceFlow id="SequenceFlow_16" sourceRef="Task_ProduceMinutes" targetRef="Task_SendMinutesToMembers" />
    <bpmn:sequenceFlow id="SequenceFlow_25" name="After QA check completed" sourceRef="EndEvent_QADone" targetRef="Task_UpdateRecords" />
    <bpmn:sequenceFlow id="SequenceFlow_18" sourceRef="Task_UpdateRecords" targetRef="EndEvent_ProcessComplete" />
  </bpmn:process>

  <!-- Committee Members Process -->
  <bpmn:process id="Process_CommitteeMembers">
    <!-- Start Event for receiving reminder message -->
    <bpmn:startEvent id="StartEvent_MembersReminder" name="Receive meeting reminder">
      <bpmn:messageEventDefinition />
      <bpmn:outgoing>SequenceFlow_21</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task for conducting meeting -->
    <bpmn:task id="Task_MeetingHeld" name="Hold committee meeting">
      <bpmn:incoming>SequenceFlow_23</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_24</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Catch Event for receiving minutes -->
    <bpmn:endEvent id="EndEvent_MinutesReceived" name="Receive meeting minutes">
      <bpmn:messageEventDefinition />
      <bpmn:incoming>SequenceFlow_24</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_21" sourceRef="StartEvent_MembersReminder" targetRef="Task_ReadDocuments" />
    <bpmn:task id="Task_ReadDocuments" name="Read related documents">
      <bpmn:incoming>SequenceFlow_21</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_23</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_23" sourceRef="Task_ReadDocuments" targetRef="Task_MeetingHeld" />
  </bpmn:process>

</bpmn:definitions>