<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_RecourseProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_RecourseClerk">
    <bpmn:participant id="Participant_Clerk" name="Recourse Clerk" processRef="Process_Recourse_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Recourse_1" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="Start_ProbableRecourse" name="Probable Recourse Detected">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_CheckCase</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task -->
    <bpmn:task id="Task_CheckCase" name="Check Case">
      <bpmn:incoming>SequenceFlow_CheckCase</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DecideRecourse</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway -->
    <bpmn:exclusiveGateway id="Gateways_RecoursePossible" name="Recourse Possible?">
      <bpmn:incoming>SequenceFlow_DecideRecourse</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendPaymentRequest</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CloseCaseNoRecourse</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Tasks -->
    <bpmn:task id="Task_SendPayment" name="Send Request for Payment">
      <bpmn:incoming>SequenceFlow_SendPaymentRequest</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MakeReminder</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_Reminder" name="Make Reminder">
      <bpmn:incoming>SequenceFlow_MakeReminder</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EventBasedGateway</bpmn:outgoing>
    </bpmn:task>

    <!-- End Events -->
    <bpmn:endEvent id="End_CloseCaseNoRecourse" name="Close Case">
      <bpmn:incoming>SequenceFlow_CloseCaseNoRecourse</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="End_CaseClosedPaymentReceived" name="Case Closed (Money Received)">
      <bpmn:incoming>SequenceFlow_FinalCloseAfterBooking</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="End_CloseReasoningOK" name="Case Closed (Disagreement OK)">
      <bpmn:incoming>SequenceFlow_FinaleCloseAfterCheck</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Intermediate Catch Events -->
    <bpmn:intermediateCatchEvent id="Intermediate_MoneyReceived" name="Money Received">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SequenceFlow_WaitForPayment</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BookingTask</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:intermediateCatchEvent id="Intermediate_Disagreement" name="Disagreement Letter Received">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SequenceFlow_WaitForDisagreement</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckReasoningTask</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:intermediateCatchEvent id="Intermediate_TimerDeadline" name="Reminder Due">
      <bpmn:timerEventDefinition/>
      <bpmn:incoming>SequenceFlow_WaitForTimer</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CollectionAgencyTask</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Event-Based Gateway -->
    <bpmn:eventBasedGateway id="Gateways_EventBased" name="Wait for Outcome">
      <bpmn:incoming>SequenceFlow_EventBasedGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitForPayment</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_WaitForDisagreement</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_WaitForTimer</bpmn:outgoing>
    </bpmn:eventBasedGateway>

    <!-- Exclusive Gateway for Reasoning Check -->
    <bpmn:exclusiveGateway id="Gateways_ReasoningOK" name="Disagreement OK?">
      <bpmn:incoming>SequenceFlow_CheckReasoningTask</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CloseAfterCheck</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CollectionAgencyFromDisagreement</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Tasks -->
    <bpmn:task id="Task_Booking" name="Make Booking">
      <bpmn:incoming>SequenceFlow_BookingTask</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FinalCloseAfterBooking</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_CheckReasoning" name="Check Reasoning">
      <bpmn:incoming>SequenceFlow_CheckReasoningTask</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReasoningDecision</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_CollectionAgency" name="Forward to Collection Agency">
      <bpmn:incoming>SequenceFlow_CollectionAgencyFromTimer</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_CollectionAgencyFromDisagreement</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FinalCaseOpen</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckCase" sourceRef="Start_ProbableRecourse" targetRef="Task_CheckCase"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_DecideRecourse" name="Check Results" sourceRef="Task_CheckCase" targetRef="Gateways_RecoursePossible"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_SendPaymentRequest" name="Yes - Recourse Possible" sourceRef="Gateways_RecoursePossible" targetRef="Task_SendPayment"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_CloseCaseNoRecourse" name="No - Not Possible" sourceRef="Gateways_RecoursePossible" targetRef="End_CloseCaseNoRecourse"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_MakeReminder" sourceRef="Task_SendPayment" targetRef="Task_Reminder"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_EventBasedGateway" name="Start Waiting Periods" sourceRef="Task_Reminder" targetRef="Gateways_EventBased"/>

    <!-- Event-Based Gateway Outgoing Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_WaitForPayment" sourceRef="Gateways_EventBased" targetRef="Intermediate_MoneyReceived"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_WaitForDisagreement" name="Wait for Disagreement Letter" sourceRef="Gateways_EventBased" targetRef="Intermediate_Disagreement"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_WaitForTimer" name="Wait for Deadline" sourceRef="Gateways_EventBased" targetRef="Intermediate_TimerDeadline"/>

    <!-- Reasoning Check Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckReasoningTask" sourceRef="Intermediate_Disagreement" targetRef="Task_CheckReasoning"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ReasoningDecision" name="Check Results" sourceRef="Task_CheckReasoning" targetRef="Gateways_ReasoningOK"/>

    <!-- Reasoning Decision Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_CloseAfterCheck" name="Yes - Disagreement OK" sourceRef="Gateways_ReasoningOK" targetRef="End_CloseReasoningOK"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_CollectionAgencyFromDisagreement" name="No - Wrong Reasoning" sourceRef="Gateways_ReasoningOK" targetRef="Task_CollectionAgency"/>

    <!-- Payment Received Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_BookingTask" sourceRef="Intermediate_MoneyReceived" targetRef="Task_Booking"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_FinalCloseAfterBooking" name="Make Booking & Close" sourceRef="Task_Booking" targetRef="End_CaseClosedPaymentReceived"/>

    <!-- Collection Agency Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_CollectionAgencyFromTimer" sourceRef="Intermediate_TimerDeadline" targetRef="Task_CollectionAgency"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_FinalCaseOpen" name="Forward to Collection & Case Open" sourceRef="Task_CollectionAgency" targetRef="End_CloseReasoningOK"/>

  </bpmn:process>
</bpmn:definitions>