<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_SSP_Process_Corrected" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_001">
    <bpmn:participant id="Participant_MainProcess" name="SSP Mail Centre Process" processRef="Process_Operation_Main"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Operation_Main" isExecutable="true">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_MailCentreOffice" name="Mail Centre Office">
        <bpmn:flowNodeRef>Seller_StartEvent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CategorizeInvoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_HourlyReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ForwardForValidation</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AdminDept" name="Administration Department">
        <bpmn:flowNodeRef>Task_ProcessInvoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PutInCollectionBox</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_DataEntryOffice" name="Data Entry Office">
        <bpmn:flowNodeRef>Timer_Daily10am</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterSAPSystem</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ValidationOffice" name="Validation Office">
        <bpmn:flowNodeRef>Task_ValidateInvoices</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PaymentOffice" name="Payment Office">
        <bpmn:flowNodeRef>Timer_WeeklyStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExecutePayment</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_RegistryOffice" name="Registry Office">
        <bpmn:flowNodeRef>Task_ArchiveInvoices</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Seller_EndEvent</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="Seller_StartEvent" name="Receive Invoice from Client">
      <bpmn:outgoing>Seller_Flow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Mail Centre Office Tasks -->
    <bpmn:task id="Task_CategorizeInvoice" name="Categorize Invoice by Staff Member">
      <bpmn:incoming>Seller_Flow_01</bpmn:incoming>
      <bpmn:outgoing>Seller_Flow_02</bpmn:outgoing>
    </bpmn:task>

    <!-- Administration Department Tasks -->
    <bpmn:task id="Task_ProcessInvoice" name="Process Invoice">
      <bpmn:incoming>Seller_Flow_02</bpmn:incoming>
      <bpmn:outgoing>Seller_Flow_03</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_PutInCollectionBox" name="Put Invoices in Collection Box">
      <bpmn:incoming>Seller_Flow_03</bpmn:incoming>
      <bpmn:outgoing>Seller_Flow_DailyTimerTrigger</bpmn:outgoing>
    </bpmn:task>

    <!-- Data Entry Office Timer Trigger (10am Workday) -->
    <bpmn:intermediateCatchEvent id="Timer_Daily10am" name="At 10 am every workday">
      <bpmn:incoming>Seller_Flow_DailyTimerTrigger</bpmn:incoming>
      <bpmn:outgoing>Seller_Flow_DataEntryStart</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Data Entry Office Task -->
    <bpmn:task id="Task_EnterSAPSystem" name="Enter All Data in SAP System">
      <bpmn:incoming>Seller_Flow_DataEntryStart</bpmn:incoming>
      <bpmn:outgoing>Seller_Flow_HourlyReviewTrigger</bpmn:outgoing>
    </bpmn:task>

    <!-- Mail Centre Office Hourly Review Trigger -->
    <bpmn:intermediateCatchEvent id="Timer_HourlyReview" name="Every hour">
      <bpmn:incoming>Seller_Flow_HourlyReviewTrigger</bpmn:incoming>
      <bpmn:outgoing>Seller_Flow_ForwardValidationStart</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Forwarding Task (Mail Centre) -->
    <bpmn:task id="Task_ForwardForValidation" name="Forward New Invoices for Validation">
      <bpmn:incoming>Seller_Flow_ForwardValidationStart</bpmn:incoming>
      <bpmn:outgoing>Seller_Flow_ValidatedStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Validation Office Task -->
    <bpmn:task id="Task_ValidateInvoices" name="Execute Big Process of Validating Invoices">
      <bpmn:incoming>Seller_Flow_ValidatedStart</bpmn:incoming>
      <bpmn:outgoing>Seller_Flow_PaymentWaitTrigger</bpmn:outgoing>
    </bpmn:task>

    <!-- Payment Office Timer Trigger (Beginning of Week) -->
    <bpmn:intermediateCatchEvent id="Timer_WeeklyStart" name="At beginning of every week">
      <bpmn:incoming>Seller_Flow_PaymentWaitTrigger</bpmn:incoming>
      <bpmn:outgoing>Seller_Flow_ExecutePaymentStart</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Payment Office Task -->
    <bpmn:task id="Task_ExecutePayment" name="Execute Payment of Validated Invoices">
      <bpmn:incoming>Seller_Flow_ExecutePaymentStart</bpmn:incoming>
      <bpmn:outgoing>Seller_Flow_ArchiveStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Registry Office Task -->
    <bpmn:task id="Task_ArchiveInvoices" name="Archive All Invoices">
      <bpmn:incoming>Seller_Flow_ArchiveStart</bpmn:incoming>
      <bpmn:outgoing>Seller_Flow_EndEvent</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="Seller_EndEvent" name="Invoices Archived">
      <bpmn:incoming>Seller_Flow_EndEvent</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Seller_Flow_01" sourceRef="Seller_StartEvent" targetRef="Task_CategorizeInvoice"/>
    <bpmn:sequenceFlow id="Seller_Flow_02" sourceRef="Task_CategorizeInvoice" targetRef="Task_ProcessInvoice"/>
    <bpmn:sequenceFlow id="Seller_Flow_03" sourceRef="Task_ProcessInvoice" targetRef="Task_PutInCollectionBox"/>
    <bpmn:sequenceFlow id="Seller_Flow_DailyTimerTrigger" sourceRef="Task_PutInCollectionBox" targetRef="Timer_Daily10am"/>
    <bpmn:sequenceFlow id="Seller_Flow_DataEntryStart" sourceRef="Timer_Daily10am" targetRef="Task_EnterSAPSystem"/>
    <bpmn:sequenceFlow id="Seller_Flow_HourlyReviewTrigger" sourceRef="Task_EnterSAPSystem" targetRef="Timer_HourlyReview"/>
    <bpmn:sequenceFlow id="Seller_Flow_ForwardValidationStart" sourceRef="Timer_HourlyReview" targetRef="Task_ForwardForValidation"/>
    <bpmn:sequenceFlow id="Seller_Flow_ValidatedStart" sourceRef="Task_ForwardForValidation" targetRef="Task_ValidateInvoices"/>
    <bpmn:sequenceFlow id="Seller_Flow_PaymentWaitTrigger" sourceRef="Task_ValidateInvoices" targetRef="Timer_WeeklyStart"/>
    <bpmn:sequenceFlow id="Seller_Flow_ExecutePaymentStart" sourceRef="Timer_WeeklyStart" targetRef="Task_ExecutePayment"/>
    <bpmn:sequenceFlow id="Seller_Flow_ArchiveStart" sourceRef="Task_ExecutePayment" targetRef="Task_ArchiveInvoices"/>
    <bpmn:sequenceFlow id="Seller_Flow_EndEvent" sourceRef="Task_ArchiveInvoices" targetRef="Seller_EndEvent"/>

  </bpmn:process>
</bpmn:definitions>