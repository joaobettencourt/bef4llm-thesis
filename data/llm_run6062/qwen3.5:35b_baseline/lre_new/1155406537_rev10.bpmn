<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_PayPalAccountCreation" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_AccountCreationProcess">
    <bpmn:participant id="Participant_ClientPortal" name="PayPal Account Creation Portal" processRef="Process_AccountCreation1" />
  </bpmn:collaboration>

  <bpmn:process id="Process_AccountCreation1" isExecutable="true">
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_CreateAccount" name="Create PayPal Account">
      <bpmn:outgoing>Flow_SelectAccountType</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Select Account Type -->
    <bpmn:task id="Task_AccountSelection" name="Select Account Type (Personal/Premium)">
      <bpmn:incoming>Flow_SelectAccountType</bpmn:incoming>
      <bpmn:outgoing>Flow_EnterLoginDetails</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Enter Login Details -->
    <bpmn:task id="Task_LoginDetails" name="Enter Login Details (Email, Password)">
      <bpmn:incoming>Flow_EnterLoginDetails</bpmn:incoming>
      <bpmn:outgoing>Flow_EnterPersonalDetails</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Enter Personal Details -->
    <bpmn:task id="Task_PersonalDetails" name="Enter Personal Details (Name, DOB)">
      <bpmn:incoming>Flow_EnterPersonalDetails</bpmn:incoming>
      <bpmn:outgoing>Flow_EnterContactInfo</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Enter Contact Information -->
    <bpmn:task id="Task_ContactInfo" name="Enter Contact Info (Phone, Address)">
      <bpmn:incoming>Flow_EnterContactInfo</bpmn:incoming>
      <bpmn:outgoing>Flow_PEADeclaration</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: PEA Declaration -->
    <bpmn:task id="Task_PEADeclaration" name="Declare Political Exposure Status">
      <bpmn:incoming>Flow_PEADeclaration</bpmn:incoming>
      <bpmn:outgoing>Flow_CreateAccountSubmit</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for Input Validation -->
    <bpmn:exclusiveGateway id="Gateway_InputValidation" name="Input Valid?">
      <bpmn:incoming>Flow_CreateAccountSubmit</bpmn:incoming>
      <bpmn:outgoing>Flow_ValidPath</bpmn:outgoing>
      <bpmn:outgoing>Flow_InvalidPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Notify Client of Invalid Input -->
    <bpmn:task id="Task_NotifyClient" name="Notify Client &amp; Request Correction">
      <bpmn:incoming>Flow_InvalidPath</bpmn:incoming>
      <bpmn:outgoing>Flow_CorrectInput</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Generate Welcome Email -->
    <bpmn:task id="Task_WelcomeEmail" name="Generate &amp; Send Welcome Email">
      <bpmn:incoming>Flow_ValidPath</bpmn:incoming>
      <bpmn:outgoing>Flow_AccountCreatedEnd</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_AccountCreated" name="Account Created">
      <bpmn:incoming>Flow_AccountCreatedEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Flow_SelectAccountType" sourceRef="StartEvent_CreateAccount" targetRef="Task_AccountSelection">
      <bpmn:name>Select Account Type</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_EnterLoginDetails" sourceRef="Task_AccountSelection" targetRef="Task_LoginDetails">
      <bpmn:name>Login Details Entry</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_EnterPersonalDetails" sourceRef="Task_LoginDetails" targetRef="Task_PersonalDetails">
      <bpmn:name>Personal Details Entry</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_EnterContactInfo" sourceRef="Task_PersonalDetails" targetRef="Task_ContactInfo">
      <bpmn:name>Contact Info Entry</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_PEADeclaration" sourceRef="Task_ContactInfo" targetRef="Task_PEADeclaration">
      <bpmn:name>PEA Declaration</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_CreateAccountSubmit" sourceRef="Task_PEADeclaration" targetRef="Gateway_InputValidation">
      <bpmn:name>Create Account Request</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_ValidPath" name="Valid Input" sourceRef="Gateway_InputValidation" targetRef="Task_WelcomeEmail">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${inputIsValid}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_InvalidPath" name="Invalid Input" sourceRef="Gateway_InputValidation" targetRef="Task_NotifyClient">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!inputIsValid}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_CorrectInput" sourceRef="Task_NotifyClient" targetRef="Task_LoginDetails">
      <bpmn:name>Correct and Retry</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_AccountCreatedEnd" sourceRef="Task_WelcomeEmail" targetRef="EndEvent_AccountCreated">
      <bpmn:name>Email Sent Successfully</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>