<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ClientAcquisition" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_ClientAcquisition_1">
    <bpmn:participant id="Participant_MainProcess_1" name="Client Acquisition Process" processRef="Proc_Acquisition_Operation"/>
  </bpmn:collaboration>

  <bpmn:process id="Proc_Acquisition_Operation" isExecutable="true">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_MarketingTeam_1" name="Marketing Team">
        <bpmn:flowNodeRef>Seller_StartEvent_NewClients</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Seller_Task_Analysis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Seller_Task_Presentation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Seller_Task_SendOffers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Seller_Task_InformManagement</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ManagementTeam_1" name="Management Team">
        <bpmn:flowNodeRef>Mgmt_Gateway_ClientDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Mgmt_Task_SendOffer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Mgmt_End_SuccessfulDeal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Mgmt_Task_AnalyzeFailure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Mgmt_Task_ImproveProcess</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="Seller_StartEvent_NewClients" name="Management indicates need">
      <bpmn:outgoing>Seller_Flow_Analysis</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Marketing Lane Tasks -->
    <bpmn:task id="Seller_Task_Analysis" name="Perform Market Analysis">
      <bpmn:incoming>Seller_Flow_Analysis</bpmn:incoming>
      <bpmn:outgoing>Seller_Flow_Presentation</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Seller_Task_Presentation" name="Prepare Portfolio Presentation">
      <bpmn:incoming>Seller_Flow_Presentation</bpmn:incoming>
      <bpmn:outgoing>Seller_Flow_SendOffers</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Seller_Task_SendOffers" name="Send Offers to Potential Clients">
      <bpmn:incoming>Seller_Flow_SendOffers</bpmn:incoming>
      <bpmn:outgoing>Seller_Flow_InformManagement</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Seller_Task_InformManagement" name="Inform Management of Responses">
      <bpmn:incoming>Seller_Flow_InformManagement</bpmn:incoming>
      <bpmn:outgoing>Mgmt_Flow_SendOffer</bpmn:outgoing>
    </bpmn:task>

    <!-- Transition to Management Lane -->
    <bpmn:sequenceFlow id="Mgmt_Flow_SendOffer" sourceRef="Seller_Task_InformManagement" targetRef="Mgmt_Task_SendOffer">
      <bpmn:name>Responses Received</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Negotiation Task -->
    <bpmn:task id="Mgmt_Task_SendOffer" name="Send Detailed Offer (Negotiations)">
      <bpmn:incoming>Mgmt_Flow_SendOffer</bpmn:incoming>
      <bpmn:outgoing>Mgmt_GatewayIn_ClientDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Decision Gateway -->
    <bpmn:exclusiveGateway id="Mgmt_Gateway_ClientDecision" name="Client Accepts Offer?">
      <bpmn:incoming>Mgmt_GatewayIn_ClientDecision</bpmn:incoming>
      <bpmn:outgoing>Mgmt_Flow_AcceptedPath</bpmn:outgoing>
      <bpmn:outgoing>Mgmt_Flow_RejectedPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Path 1: Accepted -->
    <bpmn:sequenceFlow id="Mgmt_Flow_AcceptedPath" sourceRef="Mgmt_Gateway_ClientDecision" targetRef="Seller_EndEvent_SuccessfulDeal">
      <bpmn:name>Accepted</bpmn:name>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${clientAccepts == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Path 2: Rejected -->
    <bpmn:task id="Mgmt_Task_AnalyzeFailure" name="Analyze Reason for Failure">
      <bpmn:incoming>Mgmt_Flow_RejectedPath</bpmn:incoming>
      <bpmn:outgoing>Mgmt_Flow_ImproveIn</bpmn:outgoing>
    </bpmn:task>

    <!-- Path 2 Continued -->
    <bpmn:sequenceFlow id="Mgmt_Flow_RejectedPath" sourceRef="Mgmt_Gateway_ClientDecision" targetRef="Mgmt_Task_AnalyzeFailure">
      <bpmn:name>Rejected</bpmn:name>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${clientAccepts == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Path 2 Task -->
    <bpmn:task id="Mgmt_Task_ImproveProcess" name="Improve Future Process">
      <bpmn:incoming>Mgmt_Flow_ImproveIn</bpmn:incoming>
      <bpmn:outgoing>Seller_EndEvent_SuccessfulDeal</bpmn:outgoing>
    </bpmn:task>

    <!-- Path 1 Task -->
    <bpmn:endEvent id="Seller_EndEvent_SuccessfulDeal" name="Successful Deal">
      <bpmn:incoming>Mgmt_Flow_AcceptedPath</bpmn:incoming>
      <bpmn:incoming>Seller_Flow_ImproveIn</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Flow from Analysis to Improve Process -->
    <bpmn:sequenceFlow id="Mgmt_Flow_ImproveIn" sourceRef="Mgmt_Task_AnalyzeFailure" targetRef="Seller_EndEvent_SuccessfulDeal">
      <bpmn:name>Analyzed</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Marketing Lane Flows -->
    <bpmn:sequenceFlow id="Seller_Flow_Analysis" sourceRef="Seller_StartEvent_NewClients" targetRef="Seller_Task_Analysis">
      <bpmn:name>New Clients Needed</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Seller_Flow_Presentation" sourceRef="Seller_Task_Analysis" targetRef="Seller_Task_Presentation"/>

    <bpmn:sequenceFlow id="Seller_Flow_SendOffers" sourceRef="Seller_Task_Presentation" targetRef="Seller_Task_SendOffers">
      <bpmn:name>Presentation Ready</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Seller_Flow_InformManagement" sourceRef="Seller_Task_SendOffers" targetRef="Seller_Task_InformManagement"/>

  </bpmn:process>
</bpmn:definitions>