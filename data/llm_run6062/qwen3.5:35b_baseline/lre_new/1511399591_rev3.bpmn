<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_WebDevProcess">
  <bpmn:collaboration id="Collab_MainProcess">
    <bpmn:participant id="Pool_Process" name="Website Development Process" processRef="Proc_Development" />
  </bpmn:collaboration>

  <bpmn:process id="Proc_Development" isExecutable="true">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_BusinessAnalyst" name="Business Analyst">
        <bpmn:flowNodeRef>Seller_StartEvent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Seller_Task_Analysis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Seller_Gateway_DesignCheck</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_WebDesigner" name="Web Designer">
        <bpmn:flowNodeRef>Seller_Task_IntegrateDesign</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_PHP_Specialist" name="PHP/HTML/CSS Specialist">
        <bpmn:flowNodeRef>Seller_Task_PHPIntegration</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Seller_Task_AdjustReintegrate</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Tester" name="Tester">
        <bpmn:flowNodeRef>Seller_Gateway_TestCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Seller_Task_FinalTest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Seller_EndEvent_01</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="Seller_StartEvent" name="Collect Data &amp; Conduct Analysis">
      <bpmn:outgoing>Seller_Flow_Analysis</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Business Analyst Task -->
    <bpmn:task id="Seller_Task_Analysis" name="Conduct Business Analysis on Feedback">
      <bpmn:incoming>Seller_Flow_Analysis</bpmn:incoming>
      <bpmn:outgoing>Seller_Flow_DesignHandoff</bpmn:outgoing>
    </bpmn:task>

    <!-- Web Designer Task -->
    <bpmn:task id="Seller_Task_IntegrateDesign" name="Integrate Design &amp; Decide Module Placement">
      <bpmn:incoming>Seller_Flow_DesignHandoff</bpmn:incoming>
      <bpmn:incoming>Seller_Flow_DesignLoopBack</bpmn:incoming>
      <bpmn:outgoing>Seller_Flow_ToCheckDesign</bpmn:outgoing>
    </bpmn:task>

    <!-- Design Check Gateway (Business Analyst) -->
    <bpmn:exclusiveGateway id="Seller_Gateway_DesignCheck" name="Adjustment Needed?">
      <bpmn:incoming>Seller_Flow_ToCheckDesign</bpmn:incoming>
      <bpmn:outgoing>Seller_Flow_DesignLoopBack</bpmn:outgoing>
      <bpmn:outgoing>Seller_Flow_PHPIntegrationStart</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- PHP Specialist Initial Integration -->
    <bpmn:task id="Seller_Task_PHPIntegration" name="Integrate with Overall Implementation">
      <bpmn:incoming>Seller_Flow_PHPIntegrationStart</bpmn:incoming>
      <bpmn:outgoing>Seller_Flow_ToTestMerge</bpmn:outgoing>
    </bpmn:task>

    <!-- PHP Specialist Adjustment/Reintegration -->
    <bpmn:task id="Seller_Task_AdjustReintegrate" name="Adjust &amp; Re-integrate">
      <bpmn:incoming>Seller_Flow_TestFail</bpmn:incoming>
      <bpmn:outgoing>Seller_Flow_ToTestMerge</bpmn:outgoing>
    </bpmn:task>

    <!-- Merge Point before Testing -->
    <bpmn:exclusiveGateway id="Seller_Gateway_BeforeTest" name="Ready for Test?">
      <bpmn:incoming>Seller_Flow_ToTestMerge</bpmn:incoming>
      <bpmn:outgoing>Seller_Flow_StartTesting</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Tester Task -->
    <bpmn:task id="Seller_Task_FinalTest" name="Test Final Website">
      <bpmn:incoming>Seller_Flow_StartTesting</bpmn:incoming>
      <bpmn:outgoing>Seller_Flow_ToCheckResult</bpmn:outgoing>
    </bpmn:task>

    <!-- Test Result Gateway -->
    <bpmn:exclusiveGateway id="Seller_Gateway_TestCheck" name="Test OK?">
      <bpmn:incoming>Seller_Flow_ToCheckResult</bpmn:incoming>
      <bpmn:outgoing>Seller_Flow_EndProcess</bpmn:outgoing>
      <bpmn:outgoing>Seller_Flow_TestFail</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event -->
    <bpmn:endEvent id="Seller_EndEvent_01" name="Process Complete">
      <bpmn:incoming>Seller_Flow_EndProcess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Seller_Flow_Analysis" sourceRef="Seller_StartEvent" targetRef="Seller_Task_Analysis" />
    <bpmn:sequenceFlow id="Seller_Flow_DesignHandoff" name="To Designer" sourceRef="Seller_Task_Analysis" targetRef="Seller_Task_IntegrateDesign" />
    <bpmn:sequenceFlow id="Seller_Flow_ToCheckDesign" name="Ready for Check" sourceRef="Seller_Task_IntegrateDesign" targetRef="Seller_Gateway_DesignCheck" />
    
    <!-- Design Loop -->
    <bpmn:sequenceFlow id="Seller_Flow_DesignLoopBack" name="Adjustment Needed (Yes)" conditionExpression="${adjustmentNeeded}" sourceRef="Seller_Gateway_DesignCheck" targetRef="Seller_Task_IntegrateDesign" />

    <!-- Proceed to PHP Integration -->
    <bpmn:sequenceFlow id="Seller_Flow_PHPIntegrationStart" name="OK (No Adjustment)" sourceRef="Seller_Gateway_DesignCheck" targetRef="Seller_Task_PHPIntegration" />

    <!-- Merge before Testing -->
    <bpmn:sequenceFlow id="Seller_Flow_ToTestMerge" sourceRef="Seller_Task_PHPIntegration" targetRef="Seller_Gateway_BeforeTest" />
    <bpmn:sequenceFlow id="Seller_Flow_AdjustToTest" name="Re-integrated" sourceRef="Seller_Task_AdjustReintegrate" targetRef="Seller_Gateway_BeforeTest" />

    <!-- Testing Flow -->
    <bpmn:sequenceFlow id="Seller_Flow_StartTesting" sourceRef="Seller_Gateway_BeforeTest" targetRef="Seller_Task_FinalTest" />
    
    <!-- Test Result Loop -->
    <bpmn:sequenceFlow id="Seller_Flow_ToCheckResult" name="Completed Testing" sourceRef="Seller_Task_FinalTest" targetRef="Seller_Gateway_TestCheck" />
    <bpmn:sequenceFlow id="Seller_Flow_EndProcess" name="OK (Yes)" conditionExpression="${testPassed}" sourceRef="Seller_Gateway_TestCheck" targetRef="Seller_EndEvent_01" />
    <bpmn:sequenceFlow id="Seller_Flow_TestFail" name="Not OK (No)" conditionExpression="${!testPassed}" sourceRef="Seller_Gateway_TestCheck" targetRef="Seller_Task_AdjustReintegrate" />

  </bpmn:process>
</bpmn:definitions>