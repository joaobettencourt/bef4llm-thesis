<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ACME_Purchasing_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_ACME_PurchaseProcess">
    <bpmn:participant id="Participant_ACME_Inc" name="ACME Inc Purchasing Process" processRef="Proc_ACME_001" />
  </bpmn:collaboration>

  <bpmn:process id="Proc_ACME_001" isExecutable="true">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Department_Requester" name="Department Requester">
        <bpmn:flowNodeRef>Seller_StartEvent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Seller_Task_CheckStockAvailability</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Seller_Gateway_StockCheck</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CentralProcurement" name="Central Procurement Dept">
        <bpmn:flowNodeRef>Cen_Task_CreatePurchaseRequisition</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Cen_Gateway_SupplierCheck</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="Seller_StartEvent" name="Purchase Initiated">
      <bpmn:outgoing>Seller_Flow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task in Department Lane -->
    <bpmn:task id="Seler_Task_CheckStockAvailability" name="Check if goods available in stock">
      <bpmn:incoming>Seller_Flow_01</bpmn:incoming>
      <bpmn:outgoing>Seller_Flow_02</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for Stock Check -->
    <bpmn:exclusiveGateway id="Seller_Gateway_StockCheck" name="Enough goods in stock?">
      <bpmn:incoming>Seller_Flow_02</bpmn:incoming>
      <bpmn:outgoing>Seller_Flow_LocalConsumptionPath</bpmn:outgoing>
      <bpmn:outgoing>Cen_Flow_RequisitionCreationPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event for Local Consumption -->
    <bpmn:endEvent id="Seller_EndEvent_LocalConsumption" name="Goods Consumed Locally">
      <bpmn:incoming>Seller_Flow_03</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task in Procurement Lane -->
    <bpmn:task id="Cen_Task_CreatePurchaseRequisition" name="Create purchase requisition in ERP">
      <bpmn:incoming>Cen_Flow_RequisitionCreationPath</bpmn:incoming>
      <bpmn:outgoing>Cen_Flow_SupplierCheckPath</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for Supplier Check -->
    <bpmn:exclusiveGateway id="Cen_Gateway_SupplierCheck" name="Supplier information available?">
      <bpmn:incoming>Cen_Flow_SupplierCheckPath</bpmn:incoming>
      <bpmn:outgoing>Cen_Flow_CreateNewSupplierPath</bpmn:outgoing>
      <bpmn:outgoing>Cen_Flow_OrderTemplateCreationPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task for Creating New Supplier -->
    <bpmn:task id="Cen_Task_CreateSupplierInERP" name="Create new supplier in ERP">
      <bpmn:incoming>Cen_Flow_06</bpmn:incoming>
      <bpmn:outgoing>Cen_Flow_OrderTemplateCreationPath2</bpmn:outgoing>
    </bpmn:task>

    <!-- Task for Creating Order Template -->
    <bpmn:task id="Cen_Task_CreateOrderTemplate" name="Create order template in ERP">
      <bpmn:incoming>Cen_Flow_07</bpmn:incoming>
      <bpmn:outgoing>Seller_Flow_ApprovalPath</bpmn:outgoing>
    </bpmn:task>

    <!-- Task for Approving Purchase Order -->
    <bpmn:task id="Seller_Task_ApprovePurchaseOrder" name="Approve order template">
      <bpmn:incoming>Seller_Flow_08</bpmn:incoming>
      <bpmn:outgoing>Cen_Flow_PurchaseOrderTriggeredPath</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event for Purchase Order Triggered -->
    <bpmn:endEvent id="Cen_EndEvent_PurchaseOrderTriggered" name="Purchase Order Triggered">
      <bpmn:incoming>Cen_Flow_09</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Seller_Flow_01" sourceRef="Seler_StartEvent" targetRef="Seler_Task_CheckStockAvailability">
      <bpmn:name>Purchase Initiated</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Seller_Flow_02" sourceRef="Seler_Task_CheckStockAvailability" targetRef="Seller_Gateway_StockCheck">
      <bpmn:name>Stock Check Complete</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Seller_Flow_LocalConsumptionPath" name="Yes - Enough goods in stock" sourceRef="Seler_Gateway_StockCheck" targetRef="Seller_EndEvent_LocalConsumption">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${stockAvailable == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Cen_Flow_RequisitionCreationPath" name="No - Not enough goods in stock" sourceRef="Seler_Gateway_StockCheck" targetRef="Cen_Task_CreatePurchaseRequisition">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${stockAvailable == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Seller_Flow_03" sourceRef="Seler_Gateway_StockCheck" targetRef="Seller_EndEvent_LocalConsumption">
      <bpmn:name>Goods Consumed</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Cen_Flow_SupplierCheckPath" name="Create Purchase Requisition in ERP" sourceRef="Cen_Task_CreatePurchaseRequisition" targetRef="Cen_Gateway_SupplierCheck">
      <bpmn:name>Purchase Requisition Created</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Cen_Flow_NewSupplierPath" name="New Supplier - Create in ERP" sourceRef="Cen_Gateway_SupplierCheck" targetRef="Cen_Task_CreateSupplierInERP">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${supplierExists == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Cen_Flow_OrderTemplateCreationPath" name="Known Supplier - Create Order Template" sourceRef="Cen_Gateway_SupplierCheck" targetRef="Cen_Task_CreateOrderTemplate">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${supplierExists == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Cen_Flow_OrderTemplateCreationPath2" name="New Supplier Created - Create Order Template" sourceRef="Cen_Task_CreateSupplierInERP" targetRef="Cen_Gateway_SupplierCheck">
      <bpmn:name>New Supplier in ERP</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Seller_Flow_ApprovalPath" name="Create Order Template - Approval Required" sourceRef="Cen_Task_CreateOrderTemplate" targetRef="Seler_Gateway_StockCheck">
      <bpmn:name>Order Template Created</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Seller_Flow_PurchaseOrderTriggeredPath" name="Approve and Trigger Purchase Order" sourceRef="Seler_Task_ApprovePurchaseOrder" targetRef="Cen_EndEvent_PurchaseOrderTriggered">
      <bpmn:name>Purchase Order Approved</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>