<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_Regressabwicklung">
  <bpmn:collaboration id="Collab_01">
    <bpmn:participant id="Participant_Main" name="Versicherungsunternehmen - Regressbearbeitung" processRef="Process_01" />
  </bpmn:collaboration>

  <bpmn:process id="Process_01" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Sachbearbeiter" name="Sachbearbeiter Regress">
        <bpmn:flowNodeRef>StartEvent_Meldung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FallPruefen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RegressMoeglich</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Schliessen1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Zahlungsaufforderung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Gerechtfertigt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Schliessen2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EingangVerbuchen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Schliessen3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InkassoAbgeben</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Schliessen4</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Meldung" name="Meldung mögliches Regress">
      <bpmn:outgoing>Flow_Start_Pruefen</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1 -->
    <bpmn:task id="Task_FallPruefen" name="Fall prüfen">
      <bpmn:incoming>Flow_Start_Pruefen</bpmn:incoming>
      <bpmn:outgoing>Flow_Pruefen_Gateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1 -->
    <bpmn:exclusiveGateway id="Gateway_RegressMoeglich" name="Regress möglich?">
      <bpmn:incoming>Flow_Pruefen_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Moeglich_Ja</bpmn:outgoing>
      <bpmn:outgoing>Flow_Nein_Schliessen</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event 1 (No Regress) -->
    <bpmn:endEvent id="EndEvent_Schliessen1" name="Vorgang schließen">
      <bpmn:incoming>Flow_Nein_Schliessen</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task 2 (Yes Regress) -->
    <bpmn:task id="Task_Zahlungsaufforderung" name="Zahlungsaufforderung senden &amp; Wiedervorlage setzen">
      <bpmn:incoming>Flow_Moeglich_Ja</bpmn:incoming>
      <bpmn:outgoing>Flow_WartePeriode_Start</bpmn:outgoing>
    </bpmn:task>

    <!-- Boundary Event 1 (Payment) -->
    <bpmn:boundaryEvent id="Boundary_Payment" name="Geld eingegangen" attachedToRef="Task_Zahlungsaufforderung">
      <bpmn:outgoing>Flow_Boundary_Zahlung</bpmn:outgoing>
    </bpmn:boundaryEvent>

    <!-- Task 3 (Record Payment) -->
    <bpmn:task id="Task_EingangVerbuchen" name="Eingang verbuchen">
      <bpmn:incoming>Flow_Boundary_Zahlung</bpmn:incoming>
      <bpmn:outgoing>Flow_Verbuend_Schliessen2</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 2 (Payment) -->
    <bpmn:endEvent id="EndEvent_Schliessen2" name="Vorgang schließen">
      <bpmn:incoming>Flow_Verbuend_Schliessen2</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Boundary Event 2 (Objection) -->
    <bpmn:boundaryEvent id="Boundary_Objection" name="VN widerspricht" attachedToRef="Task_Zahlungsaufforderung">
      <bpmn:outgoing>Flow_Boundary_Pruefung</bpmn:outgoing>
    </bpmn:boundaryEvent>

    <!-- Gateway 2 (Justification) -->
    <bpmn:exclusiveGateway id="Gateway_Gerechtfertigt" name="Widerspruch gerechtfertigt?">
      <bpmn:incoming>Flow_Boundary_Pruefung</bpmn:incoming>
      <bpmn:outgoing>Flow_Ja_Schluss</bpmn:outgoing>
      <bpmn:outgoing>Flow_Ne_Inkasso</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event 3 (Justified Objection) -->
    <bpmn:endEvent id="EndEvent_Schliessen3" name="Vorgang schließen">
      <bpmn:incoming>Flow_Ja_Schluss</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task 4 (Debt Collection) -->
    <bpmn:task id="Task_InkassoAbgeben" name="An Inkassodienstleister abgeben">
      <bpmn:incoming>Flow_Ne_Inkasso</bpmn:incoming>
      <bpmn:outgoing>Flow_Abgabe_Schluss4</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 4 (Debt Collection) -->
    <bpmn:endEvent id="EndEvent_Schliessen4" name="Vorgang schließen">
      <bpmn:incoming>Flow_Abgabe_Schluss4</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows for Main Flow -->
    <bpmn:sequenceFlow id="Flow_Start_Pruefen" sourceRef="StartEvent_Meldung" targetRef="Task_FallPruefen">
      <bpmn:name name="Meldung erhalten"/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_Pruefen_Gateway" sourceRef="Task_FallPruefen" targetRef="Gateway_RegressMoeglich" />

    <bpmn:sequenceFlow id="Flow_Moeglich_Ja" name="Ja, möglich" sourceRef="Gateway_RegressMoeglich" targetRef="Task_Zahlungsaufforderung"/>

    <bpmn:sequenceFlow id="Flow_Nein_Schliessen" name="Nein, nicht möglich" sourceRef="Gateway_RegressMoeglich" targetRef="EndEvent_Schliessen1">
      <bpmn:name name="Nicht möglich"/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_WartePeriode_Start" sourceRef="Task_Zahlungsaufforderung" targetRef="Gateway_Gerechtfertigt">
      <bpmn:name name="Frist abgelaufen"/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_Boundary_Zahlung" sourceRef="Boundary_Payment" targetRef="Task_EingangVerbuchen"/>

    <bpmn:sequenceFlow id="Flow_Verbuend_Schliessen2" sourceRef="Task_EingangVerbuchen" targetRef="EndEvent_Schliessen2"/>

    <bpmn:sequenceFlow id="Flow_Boundary_Pruefung" sourceRef="Boundary_Objection" targetRef="Gateway_Gerechtfertigt"/>

    <bpmn:sequenceFlow id="Flow_Ja_Schluss" name="Ja, gerechtfertigt" sourceRef="Gateway_Gerechtfertigt" targetRef="EndEvent_Schliessen3"/>
    
    <bpmn:sequenceFlow id="Flow_Ne_Inkasso" name="Nein, nicht gerechtfertigt" sourceRef="Gateway_Gerechtfertigt" targetRef="Task_InkassoAbgeben">
      <bpmn:name name="Nicht gerechtfertigt"/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_Abgabe_Schluss4" sourceRef="Task_InkassoAbgeben" targetRef="EndEvent_Schliessen4"/>

  </bpmn:process>
</bpmn:definitions>