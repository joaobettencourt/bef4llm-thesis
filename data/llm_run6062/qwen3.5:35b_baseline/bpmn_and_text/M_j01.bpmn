<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_Chainsaw_001">
  <bpmn:collaboration id="Collaboration_Chainsaw_001">
    <bpmn:participant id="Participant_Manufacturing" name="Chainsaw Manufacturing Process" processRef="Process_Chainsaw_001"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Chainsaw_001" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_CustomerSpecs">
      <bpmn:name>Customer specifies properties</bpmn:name>
      <bpmn:outgoing>SequenceFlow_OrderPartsSplit</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Parallel Gateway Split for Ordering Parts -->
    <bpmn:parallelGateway id="ParallelGateway_Ordering">
      <bpmn:name>Order Parts Online (In Parallel)</bpmn:name>
      <bpmn:incoming>SequenceFlow_OrderPartsSplit</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GuideBar</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ChainWidth</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PowerSource</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Ordering Tasks -->
    <bpmn:task id="Task_OrderGuideBar">
      <bpmn:name>Order Guide Bar Parts</bpmn:name>
      <bpmn:incoming>SequenceFlow_GuideBar</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GuideBarArrived</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_OrderChainWidth">
      <bpmn:name>Order Chain Width Parts</bpmn:name>
      <bpmn:incoming>SequenceFlow_ChainWidth</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ChainPartsArrived</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_OrderPowerSource">
      <bpmn:name>Order Power Source (Electric/Motor)</bpmn:name>
      <bpmn:incoming>SequenceFlow_PowerSource</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PowerSourceArrived</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flows for Ordering -->
    <bpmn:sequenceFlow id="SequenceFlow_OrderPartsSplit" sourceRef="StartEvent_CustomerSpecs" targetRef="ParallelGateway_Ordering"/>
    <bpmn:sequenceFlow id="SequenceFlow_GuideBar" sourceRef="ParallelGateway_Ordering" targetRef="Task_OrderGuideBar"/>
    <bpmn:sequenceFlow id="SequenceFlow_ChainWidth" sourceRef="ParallelGateway_Ordering" targetRef="Task_OrderChainWidth"/>
    <bpmn:sequenceFlow id="SequenceFlow_PowerSource" sourceRef="ParallelGateway_Ordering" targetRef="Task_OrderPowerSource"/>

    <!-- Parallel Gateway Join -->
    <bpmn:parallelGateway id="ParallelGateway_JoinOrders">
      <bpmn:name>Wait for All Parts</bpmn:name>
      <bpmn:incoming>SequenceFlow_GuideBarArrived</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ChainPartsArrived</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_PowerSourceArrived</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PartsArrived</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Sequence Flows Joining -->
    <bpmn:sequenceFlow id="SequenceFlow_GuideBarArrived" sourceRef="Task_OrderGuideBar" targetRef="ParallelGateway_JoinOrders"/>
    <bpmn:sequenceFlow id="SequenceFlow_ChainPartsArrived" sourceRef="Task_OrderChainWidth" targetRef="ParallelGateway_JoinOrders"/>
    <bpmn:sequenceFlow id="SequenceFlow_PowerSourceArrived" sourceRef="Task_OrderPowerSource" targetRef="ParallelGateway_JoinOrders"/>

    <!-- Inspection Task -->
    <bpmn:task id="Task_ManualInspection">
      <bpmn:name>Manual Inspection of all parts</bpmn:name>
      <bpmn:incoming>SequenceFlow_PartsArrived</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InspectionComplete</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow to Production -->
    <bpmn:sequenceFlow id="SequenceFlow_PartsArrived" sourceRef="ParallelGateway_JoinOrders" targetRef="Task_ManualInspection"/>

    <!-- Parallel Gateway for Production Phase (Updates & Assembly) -->
    <bpmn:parallelGateway id="ParallelGateway_Production">
      <bpmn:name>Start Production</bpmn:name>
      <bpmn:incoming>SequenceFlow_InspectionComplete</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StartProductionPhase</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Sequence Flows from Inspection -->
    <bpmn:sequenceFlow id="SequenceFlow_InspectionComplete" sourceRef="Task_ManualInspection" targetRef="ParallelGateway_Production"/>

    <!-- Update Task (During production) -->
    <bpmn:task id="Task_SendUpdates">
      <bpmn:name>Send Regular Production Updates</bpmn:name>
      <bpmn:incoming>SequenceFlow_StartProductionPhase</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_UpdatesSent</bpmn:outgoing>
    </bpmn:task>

    <!-- Produce First Saw Task -->
    <bpmn:task id="Task_ProduceFirstSaw">
      <bpmn:name>Produce and Ship First Chainsaw</bpmn:name>
      <bpmn:incoming>SequenceFlow_StartProductionPhase</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FirstUnitShipped</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flows from Production Gateway -->
    <bpmn:sequenceFlow id="SequenceFlow_StartProductionPhase" sourceRef="ParallelGateway_Production" targetRef="Task_SendUpdates"/>
    <bpmn:sequenceFlow id="SequenceFlow_FirstSawReady" sourceRef="ParallelGateway_Production" targetRef="Task_ProduceFirstSaw"/>

    <!-- Merge after Production Phase -->
    <bpmn:parallelGateway id="ParallelGateway_MergeProduction">
      <bpmn:name>End of First Unit</bpmn:name>
      <bpmn:incoming>SequenceFlow_UpdatesSent</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_FirstUnitShipped</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CustomerFeedbackRequest</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Sequence Flows Merging -->
    <bpmn:sequenceFlow id="SequenceFlow_UpdatesSent" sourceRef="Task_SendUpdates" targetRef="ParallelGateway_MergeProduction"/>
    <bpmn:sequenceFlow id="SequenceFlow_FirstUnitShipped" sourceRef="Task_ProduceFirstSaw" targetRef="ParallelGateway_MergeProduction"/>

    <!-- Decision Gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_CustomerFeedback">
      <bpmn:name>Customer Likes First Saw?</bpmn:name>
      <bpmn:incoming>SequenceFlow_CustomerFeedbackRequest</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_LikesItYes</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_LikesItNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flow to Decision -->
    <bpmn:sequenceFlow id="SequenceFlow_CustomerFeedbackRequest" sourceRef="ParallelGateway_MergeProduction" targetRef="ExclusiveGateway_CustomerFeedback"/>

    <!-- Yes Path (Produce Rest) -->
    <bpmn:task id="Task_ProduceRest">
      <bpmn:name>Produce Remaining Order</bpmn:name>
      <bpmn:incoming>SequenceFlow_LikesItYes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OrderFinished</bpmn:outgoing>
    </bpmn:task>

    <!-- No Path (Cancel) -->
    <bpmn:task id="Task_CancelOrder">
      <bpmn:name>Cancel Order / Stop Production</bpmn:name>
      <bpmn:incoming>SequenceFlow_LikesItNo</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OrderCancelled</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flows from Decision -->
    <bpmn:sequenceFlow id="SequenceFlow_LikesItYes" name="Likes it (Yes)" sourceRef="ExclusiveGateway_CustomerFeedback" targetRef="Task_ProduceRest"/>
    <bpmn:sequenceFlow id="SequenceFlow_LikesItNo" name="Does not like (No)" sourceRef="ExclusiveGateway_CustomerFeedback" targetRef="Task_CancelOrder"/>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_Success">
      <bpmn:name>Order Completed</bpmn:name>
      <bpmn:incoming>SequenceFlow_OrderFinished</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_Cancelled">
      <bpmn:name>Order Cancelled</bpmn:name>
      <bpmn:incoming>SequenceFlow_OrderCancelled</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Final Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_OrderFinished" sourceRef="Task_ProduceRest" targetRef="EndEvent_Success"/>
    <bpmn:sequenceFlow id="SequenceFlow_OrderCancelled" sourceRef="Task_CancelOrder" targetRef="EndEvent_Cancelled"/>

  </bpmn:process>
</bpmn:definitions>