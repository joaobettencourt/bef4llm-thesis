<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_3DPrintingProcess">
  <bpmn:collaboration id="Collaboration_3DP_001">
    <bpmn:participant id="Participant_Manufacturing" name="Custom 3D Model Manufacturing Process" processRef="Process_3DPrint_001"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_3DPrint_001" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_CustomModelRequest">
      <bpmn:name>Custom Model Request</bpmn:name>
      <bpmn:outgoing>SequenceFlow_InstructArtist</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Instruct Artist -->
    <bpmn:task id="Task_SendSketches">
      <bpmn:name>Instruct Artist - Send Sketches</bpmn:name>
      <bpmn:incoming>SequenceFlow_InstructArtist</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ArtistReview</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Review and Revise -->
    <bpmn:task id="Task_ReviseModel">
      <bpmn:name>Tell Artist Changes Until Satisfied</bpmn:name>
      <bpmn:incoming>SequenceFlow_ArtistReviewLoop</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SatisfactionCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway for Satisfaction Check -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_Satisfaction">
      <bpmn:name>Satisfied with Model?</bpmn:name>
      <bpmn:incoming>SequenceFlow_ArtistReview</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ModelApproved</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Choose Plastic Color -->
    <bpmn:task id="Task_ChooseColor">
      <bpmn:name>Choose Plastic Color for Printing</bpmn:name>
      <bpmn:incoming>SequenceFlow_ModelApproved</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ColorSelection</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway for Stock Check -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_StockCheck">
      <bpmn:name>Color In Stock?</bpmn:name>
      <bpmn:incoming>SequenceFlow_ColorSelection</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckQuantity</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Check Quantity -->
    <bpmn:task id="Task_CheckQuantity">
      <bpmn:name>Check Color Quantity Remaining</bpmn:name>
      <bpmn:incoming>SequenceFlow_StockAvailable</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ShoppingListDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway for Shopping List Decision -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_ShoppingList">
      <bpmn:name>Quantity Under 100g?</bpmn:name>
      <bpmn:incoming>SequenceFlow_ShoppingListDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AddToShoppingList</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Add to Shopping List -->
    <bpmn:task id="Task_AddToShoppingList">
      <bpmn:name>Add Color to Shopping List</bpmn:name>
      <bpmn:incoming>SequenceFlow_Under100g</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ShoppingListComplete</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Order Plastic -->
    <bpmn:task id="Task_OrderPlastic">
      <bpmn:name>Order Color from Supplier</bpmn:name>
      <bpmn:incoming>SequenceFlow_NotInStock</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OrderPlasticComplete</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway for Printer Setup -->
    <bpmn:parallelGateway id="ParallelGateway_PrinterSetup">
      <bpmn:name>Printer Setup &amp; GCode Generation</bpmn:name>
      <bpmn:incoming>SequenceFlow_ColorReady</bpmn:outgoing></bpmn:modelreview>

    <!-- Task: Turn On and Heat Printer -->
    <bpmn:task id="Task_HeatPrinter">
      <bpmn:name>Turn on Printer - Heat Bed &amp; Extruder (Monitor Status)</bpmn:name>
      <bpmn:incoming>SequenceFlow_PrinterSetup</bpmn:outgoing></bpmn:modelreview>

    <!-- Task: Generate Gcode -->
    <bpmn:task id="Task_GenerateGCode">
      <bpmn:name>Generate G-code from STL File</bpmn:name>
      <bpmn:incoming>SequenceFlow_PrinterSetup</bpmn:outgoing></bpmn:modelreview>

    <!-- Exclusive Gateway for Print Readiness -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_PrintReady">
      <bpmn:name>All Ready to Print?</bpmn:name>
      <bpmn:incoming>SequenceFlow_HeaterStatus</bpmn:outgoing></bpmn:modelreview>

    <!-- Task: Print Model -->
    <bpmn:task id="Task_PrintModel">
      <bpmn:name>Print 3D Model</bpmn:name>
      <bpmn:incoming>SequenceFlow_AllReady</bpmn:outgoing></bpmn:modelreview>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_PrintComplete">
      <bpmn:name>3D Model Printed Successfully</bpmn:name>
      <bpmn:incoming>SequenceFlow_ModelPrinted</bpmn:outgoing></end-event>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_InstructArtist" sourceRef="StartEvent_CustomModelRequest" targetRef="Task_SendSketches"/>
    <bpmn:sequenceFlow id="SequenceFlow_ArtistReview" name="Send Sketches to Artist" sourceRef="Task_SendSketches" targetRef="ExclusiveGateway_Satisfaction">
      <bpmn:name>Initial Request</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Loop back for revisions -->
    <bpmn:sequenceFlow id="SequenceFlow_ReviseLoop" name="Not Satisfied - Revise" sourceRef="ExclusiveGateway_Satisfaction" targetRef="Task_ReviseModel">
      <bpmn:name>Revision Needed</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Continue when satisfied -->
    <bpmn:sequenceFlow id="SequenceFlow_ModelApproved" name="Satisfied - Proceed to Color Selection" sourceRef="ExclusiveGateway_Satisfaction" targetRef="Task_ChooseColor">
      <bpmn:name>Satisfied</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Continue from color selection -->
    <bpmn:sequenceFlow id="SequenceFlow_ColorSelection" sourceRef="Task_ChooseColor" targetRef="ExclusiveGateway_StockCheck"/>

    <!-- Stock Available Path -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckQuantity" name="Yes - In Stock" sourceRef="ExclusiveGateway_StockCheck" targetRef="Task_CheckQuantity">
      <bpmn:name>In Stock</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Order Path -->
    <bpmn:sequenceFlow id="SequenceFlow_NotInStock" name="No - Not In Stock" sourceRef="ExclusiveGateway_StockCheck" targetRef="Task_OrderPlastic">
      <bpmn:name>Not in Stock</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Shopping List Decision -->
    <bpmn:sequenceFlow id="SequenceFlow_Under100g" name="Under 100 grams" sourceRef="ExclusiveGateway_ShoppingList" targetRef="Task_AddToShoppingList">
      <bpmn:name>&lt;=100g</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Sufficient Stock Path -->
    <bpmn:sequenceFlow id="SequenceFlow_SufficientStock" name="Sufficient Quantity (>=100g)" sourceRef="ExclusiveGateway_ShoppingList" targetRef="ParallelGateway_PrinterSetup">
      <bpmn:name>&gt;=100g</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- From Shopping List to Printer Setup -->
    <bpmn:sequenceFlow id="SequenceFlow_ShoppingListComplete" sourceRef="Task_AddToShoppingList" targetRef="ParallelGateway_PrinterSetup"/>

    <!-- From Order Plastic to Printer Setup (after delivery) -->
    <bpmn:sequenceFlow id="SequenceFlow_OrderPlasticComplete" name="Order Received - Ready for Printing" sourceRef="Task_OrderPlastic" targetRef="ParallelGateway_PrinterSetup">
      <bpmn:name>Color Delivered</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Parallel Paths from Printer Setup -->
    <bpmn:sequenceFlow id="SequenceFlow_PrinterSetup" sourceRef="ParallelGateway_PrinterSetup" targetRef="Task_HeatPrinter"/>
    <bpmn:sequenceFlow id="SequenceFlow_GCodeGeneration" name="Generate G-code in Background" sourceRef="ParallelGateway_PrinterSetup" targetRef="Task_GenerateGCode">
      <bpmn:name>Background Task</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- From Heater Status to Print Ready -->
    <bpmn:sequenceFlow id="SequenceFlow_HeaterStatus" sourceRef="Task_HeatPrinter" targetRef="ExclusiveGateway_PrintReady"/>

    <!-- From G-code Generation to Print Ready -->
    <bpmn:sequenceFlow id="SequenceFlow_GCodeComplete" name="G-code Generated from STL" sourceRef="Task_GenerateGCode" targetRef="ExclusiveGateway_PrintReady">
      <bpmn:name>G-code Complete</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Print Ready Decision -->
    <bpmn:sequenceFlow id="SequenceFlow_AllReady" name="All Systems Ready - Start Printing" sourceRef="ExclusiveGateway_PrintReady" targetRef="Task_PrintModel">
      <bpmn:name>All Ready</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- From Print to End -->
    <bpmn:sequenceFlow id="SequenceFlow_ModelPrinted" sourceRef="Task_PrintModel" targetRef="EndEvent_PrintComplete"/>

  </bpmn:process>
</bpmn:definitions>