<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_Internship_001">
  <bpmn:message id="Message_OfferReceived"/>

  <bpmn:collaboration id="Collaboration_Internship">
    <bpmn:participant id="Participant_Candidate" name="Candidate Process" processRef="Process_Internship_001"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Internship_001" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_SubmitDetails">
      <bpmn:name>Submit Internship Details</bpmn:name>
      <bpmn:description>Enter topic, money, experience and hobbies</bpmn:description>
      <bpmn:outgoing>SequenceFlow_WaitForOffers</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Wait for Offers Phase -->
    <bpmn:intermediateCatchEvent id="Intermediate_CatchOffer">
      <bpmn:name>Receive Offer</bpmn:name>
      <bpmn:messageRef="Message_OfferReceived"/>
      <bpmn:incoming>SequenceFlow_WaitForOffers</bpmn:outgoing></bpmn:intermediateCatchEvent>

    <!-- Decision Gateway -->
    <bpmn:exclusiveGateway id="Exclusive_GatewayAccept">
      <bpmn:name>Accept Offer?</bpmn:name>
      <bpmn:incoming>SequenceFlow_DecideOffer</bpmn:outgoing></bpmn:decision-gateway-ref/>

    <!-- Loop for Deny -->
    <bpmn:sequenceFlow id="SequenceLoop_Deny" sourceRef="Exclusive_GatewayAccept" targetRef="Intermediate_CatchOffer">
      <bpmn:name>Deny</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Internship Phase Start -->
    <bpmn:parallelGateway id="Parallel_InternshipStart">
      <bpmn:incoming>SequenceFlow_StartInternship</bpmn:outgoing></bpmn:gateway-ref/>

    <!-- Candidate Updates -->
    <bpmn:task id="Task_WriteUpdate1">
      <bpmn:name>Write Status Update 1</bpmn:name>
      <bpmn:description>About internship (Week 1)</bpmn:description>
      <bpmn:incoming>Sequence_CandidateUpdates</bpmn:outgoing></task-ref/>

    <!-- Company Feedback -->
    <bpmn:task id="Task_CompanyFeedback1">
      <bpmn:name>Company Status Update 1</bpmn:name>
      <bpmn:description>About candidate (Week 1)</bpmn:description>
      <bpmn:incoming>Sequence_CompanyFeedback</bpmn:outgoing></task-ref/>

    <!-- Recommendation Phase -->
    <bpmn:endEvent id="EndEvent_InternshipFinished">
      <bpmn:name>Internship Finished</bpmn:name>
      <bpmn:incoming>SequenceFlow_Task_Company2</bpmn:outgoing></end-event-ref/>

  </bpmn:process>
</bpmn:definitions>