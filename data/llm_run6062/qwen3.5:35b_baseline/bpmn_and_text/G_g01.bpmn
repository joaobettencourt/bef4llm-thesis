<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_LANParty_01">
  <bpmn:collaboration id="Collaboration_LANParty_01">
    <bpmn:participant id="Participant_Planner" name="LAN Party Planner" processRef="Process_LANParty_01"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_LANParty_01" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_PlanLAN">
      <bpmn:name>Plan LAN Party</bpmn:name>
      <bpmn:outgoing>SequenceFlow_SendInvites</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1 -->
    <bpmn:task id="Task_SendInvites" name="Send Invitations">
      <bpmn:name>Send Invitations to Friends</bpmn:name>
      <bpmn:incoming>SequenceFlow_SendInvites</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CollectGamesList</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2 -->
    <bpmn:task id="Task_CollectGames" name="Collect Game List">
      <bpmn:name>Find Out Games Wanted by Friends</bpmn:name>
      <bpmn:incoming>SequenceFlow_CollectGamesList</bpmn:incoming>
      <bpmn:outgoing>ParallelGateway_SplitPrep</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway Split -->
    <bpmn:parallelGateway id="ParallelGateway_SplitPrep">
      <bpmn:name>Date &amp; Prep Check</bpmn:name>
      <bpmn:incoming>SequenceFlow_CollectGamesList</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AppointDateStart</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_VerifyGamesStart</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Branch A: Date Selection Loop -->
    <bpmn:task id="Task_AppointDate" name="Appoint Date">
      <bpmn:name>Select LAN Party Date</bpmn:name>
      <bpmn:incoming>SequenceFlow_AppointDateStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckAvailability</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for Date Check -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_DateCheck">
      <bpmn:name>8+ People Free?</bpmn:name>
      <bpmn:incoming>SequenceFlow_CheckAvailability</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProceedToGames</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_AppointDateAgain</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Loop back to appoint date -->
    <bpmn:sequenceFlow id="SequenceFlow_AppointDateAgain" name="No - Appoint Another Date">
      <bpmn:name>No - Appoint Another Date</bpmn:name>
      <bpmn:sourceRef>ExclusiveGateway_DateCheck</bpmn:sourceRef>
      <bpmn:targetRef>Task_AppointDate</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Branch B: Game Verification -->
    <bpmn:task id="Task_VerifyGames" name="Verify Games">
      <bpmn:name>Check If All Desired Games Available</bpmn:name>
      <bpmn:incoming>SequenceFlow_VerifyGamesStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckMissingGames</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for Game Check -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_GamesCheck">
      <bpmn:name>All Games Available?</bpmn:name>
      <bpmn:incoming>SequenceFlow_CheckMissingGames</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DownloadMissing</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ProceedToBeer</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Download Missing Games -->
    <bpmn:task id="Task_DownloadGames" name="Download Missing Games">
      <bpmn:name>Download Missing Games</bpmn:name>
      <bpmn:incoming>SequenceFlow_DownloadMissing</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProceedToBeer</bpmn:outgoing>
    </bpmn:task>

    <!-- Beer Calculation -->
    <bpmn:task id="Task_CalculateBeer" name="Calculate Beer Requirements">
      <bpmn:name>Determine How Much Beer Is Needed</bpmn:name>
      <bpmn:incoming>SequenceFlow_ProceedToGames</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckBeerStock</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for Beer Check -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_BeerCheck">
      <bpmn:name>Sufficient Beer?</bpmn:name>
      <bpmn:incoming>SequenceFlow_CheckBeerStock</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PartyTime</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_BuyMoreBeer</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Buy More Beer -->
    <bpmn:task id="Task_BuyBeer" name="Buy Missing Beer">
      <bpmn:name>Purchase Additional Beer</bpmn:name>
      <bpmn:incoming>SequenceFlow_BuyMoreBeer</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PartyTime</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_LANParty">
      <bpmn:name>Lan Party Enjoyed</bpmn:name>
      <bpmn:incoming>SequenceFlow_PartyTime</bpmn:outgoing></end-event>

  </bpmn:process>

</bpmn:definitions>