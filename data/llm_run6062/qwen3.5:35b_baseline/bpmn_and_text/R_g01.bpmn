<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_DIYRepair_001">
  <bpmn:collaboration id="Collaboration_DIY_001">
    <bpmn:participant id="Participant_DiYProcess" name="DIY Smartphone Screen Repair Process" processRef="Process_DIY_001"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_DIY_001" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_EnterModel">
      <bpmn:name>Enter Model &amp; Broken Part</bpmn:name>
      <bpmn:outgoing>SequenceFlow_GetList</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Get Parts List -->
    <bpmn:task id="Task_GetPartsList">
      <bpmn:name>Get Parts &amp; Tools List from Tool</bpmn:name>
      <bpmn:incoming>SequenceFlow_GetList</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckInventory</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway: Need External Items? -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_NeedItems">
      <bpmn:name>Need External Items?</bpmn:name>
      <bpmn:incoming>SequenceFlow_CheckInventory</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ContactFriends</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_BuyParts</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Contact Friends -->
    <bpmn:task id="Task_ContactFriends">
      <bpmn:name>Contact Friends (Borrow/Buy Cheap)</bpmn:name>
      <bpmn:incoming>SequenceFlow_ContactFriends</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SourcingComplete</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Buy Parts -->
    <bpmn:task id="Task_BuyParts">
      <bpmn:name>Buy Missing Parts</bpmn:name>
      <bpmn:incoming>SequenceFlow_BuyParts</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SourcingComplete</bpmn:outgoing>
    </bpmn:task>

    <!-- Inclusive Gateway: Sourcing Complete -->
    <bpmn:inclusiveGateway id="InclusiveGateway_SourcingComplete">
      <bpmn:name>Sourcing Complete</bpmn:name>
      <bpmn:incoming>SequenceFlow_ContactFriends</bpmn:outgoing></contact-friends-outgoing/>
      <bpmn:incoming>SequenceFlow_BuyParts</bpmn:outgoing></buy-parts-outgoing/>

    <!-- Task: Receive Instructions -->
    <bpmn:task id="Task_GetInstructions">
      <bpmn:name>Receive Repair Instructions</bpmn:name>
      <bpmn:incoming>SequenceFlow_SourcingComplete</bpmn:outgoing></sourcing-complete-outgoing/>

    <!-- Exclusive Gateway: Did it work? -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_Worked">
      <bpmn:name>Repair Successful?</bpmn:name>
      <bpmn:incoming>SequenceFlow_InstructionsComplete</bpmn:outgoing></instructions-complete-outgoing/>

    <!-- Task: Send Review -->
    <bpmn:task id="Task_SendReview">
      <bpmn:name>Send Review &amp; Video</bpmn:name>
      <bpmn:incoming>SequenceFlow_SuccessfulRepair</bpmn:outgoing></successful-repair-outgoing/>

    <!-- Task: Send to Expert -->
    <bpmn:task id="Task_SendToExpert">
      <bpmn:name>Send Phone to Expert</bpmn:name>
      <bpmn:incoming>SequenceFlow_UnsuccessfulRepair</bpmn:outgoing></unsuccessful-repair-outgoing/>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Completed">
      <bpmn:name>Process Completed</bpmn:name>
      <bpmn:incoming>SequenceFlow_ReviewComplete</bpmn:outgoing></review-complete-outgoing/>
      <bpmn:incoming>SequenceFlow_ExpertSent</bpmn:outgoing></expert-sent-outgoing/>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_GetList" sourceRef="StartEvent_EnterModel" targetRef="Task_GetPartsList"/>
    <bpmn:sequenceFlow id="SequenceFlow_CheckInventory" sourceRef="Task_GetPartsList" targetRef="ExclusiveGateway_NeedItems"/>
    <bpmn:sequenceFlow id="SequenceFlow_ContactFriends" name="Yes - Borrow/Buy from Friends" sourceRef="ExclusiveGateway_NeedItems" targetRef="Task_ContactFriends"/>
    <bpmn:sequenceFlow id="SequenceFlow_BuyParts" name="No - Buy Parts" sourceRef="ExclusiveGateway_NeedItems" targetRef="Task_BuyParts"/>
    <bpmn:sequenceFlow id="SequenceFlow_SourcingComplete" sourceRef="InclusiveGateway_SourcingComplete" targetRef="Task_GetInstructions"/>
    <bpmn:sequenceFlow id="SequenceFlow_ContactFriendsToSourcing" sourceRef="Task_ContactFriends" targetRef="InclusiveGateway_SourcingComplete"/>
    <bpmn:sequenceFlow id="SequenceFlow_BuyPartsToSourcing" sourceRef="Task_BuyParts" targetRef="InclusiveGateway_SourcingComplete"/>
    <bpmn:sequenceFlow id="SequenceFlow_InstructionsComplete" name="Yes - Repair Worked" sourceRef="ExclusiveGateway_Worked" targetRef="Task_SendReview"/>
    <bpmn:sequenceFlow id="SequenceFlow_UnsuccessfulRepair" name="No - Send to Expert" sourceRef="ExclusiveGateway_Worked" targetRef="Task_SendToExpert"/>
    <bpmn:sequenceFlow id="SequenceFlow_SuccessfulRepair" sourceRef="Task_GetInstructions" targetRef="InclusiveGateway_SourcingComplete"/>

  </bpmn:process>
</bpmn:definitions>