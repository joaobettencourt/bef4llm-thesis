<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_InspectionApp">
  <bpmn:collaboration id="Collaboration_Inspection">
    <bpmn:participant id="Participant_MachineInspection" name="Energy Drink Bottling Machine Inspection System" processRef="Process_Inspection_Main"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Inspection_Main" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Operator" name="Inspector">
        <bpmn:flowNodeRef>UserTask_Questions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_Inspection</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="System Interface">
        <bpmn:flowNodeRef>ServiceTask_AutoCollectData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_CheckResults</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Inspection">
      <bpmn:name>Start Inspection Session</bpmn:name>
      <bpmn:outgoing>SequenceFlow_EnterDetails</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Enter Machine Details -->
    <bpmn:task id="Task_EnterDetails" name="Enter Machine Type &amp; Serial Number">
      <bpmn:name>Enter Machine Type &amp; Serial Number</bpmn:name>
      <bpmn:incoming>SequenceFlow_EnterDetails</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StartInspectionLoop</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: Ask Questions & Input Values -->
    <bpmn:userTask id="UserTask_Questions" name="Ask Inspection Questions">
      <bpmn:name>Ask Inspection Questions</bpmn:name>
      <bpmn:incoming>SequenceFlow_StartInspectionLoop</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToDataCollection</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task 3: Collect Data & Show Results -->
    <bpmn:serviceTask id="ServiceTask_AutoCollectData" name="Press Buttons, Auto-Collect Values">
      <bpmn:name>Press Buttons, Auto-Collect Values</bpmn:name>
      <bpmn:incoming>SequenceFlow_ToDataCollection</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToDecision</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Gateway 1: Check Results -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_CheckResults" name="Additional Questions Needed?">
      <bpmn:name>Additional Questions Needed?</bpmn:name>
      <bpmn:incoming>SequenceFlow_ToDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_LoopBack</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_Complete</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_InspectionComplete">
      <bpmn:name>Inspection Complete</bpmn:name>
      <bpmn:incoming>SequenceFlow_Complete</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_EnterDetails" sourceRef="StartEvent_Inspection" targetRef="Task_EnterDetails"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_StartInspectionLoop" name="Begin Inspection Loop" sourceRef="Task_EnterDetails" targetRef="UserTask_Questions"/>

    <bpmn:sequenceFlow id="SequenceFlow_ToDataCollection" sourceRef="UserTask_Questions" targetRef="ServiceTask_AutoCollectData"/>
    
    <!-- Flow from Data Collection to Gateway -->
    <bpmn:sequenceFlow id="SequenceFlow_ToDecision" name="Results Available" sourceRef="ServiceTask_AutoCollectData" targetRef="ExclusiveGateway_CheckResults"/>

    <!-- Loop Back for Additional Questions -->
    <bpmn:sequenceFlow id="SequenceFlow_LoopBack" name="Yes, More Checks" sourceRef="ExclusiveGateway_CheckResults" targetRef="UserTask_Questions">
      <bpmn:name>Yes, More Checks</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Flow to End -->
    <bpmn:sequenceFlow id="SequenceFlow_Complete" name="No Additional Questions" sourceRef="ExclusiveGateway_CheckResults" targetRef="EndEvent_InspectionComplete"/>

  </bpmn:process>
</bpmn:definitions>