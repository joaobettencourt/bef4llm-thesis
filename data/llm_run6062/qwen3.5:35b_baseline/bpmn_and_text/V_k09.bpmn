<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_StorageManagement">
  <bpmn:collaboration id="Collaboration_StorageMgmt">
    <bpmn:participant id="Participant_Process" name="Storage Management Process" processRef="Process_StorageMgmt"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_StorageMgmt" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_OrderReceived" name="Order Received from System">
      <bpmn:outgoing>SequenceFlow_ReadOrder</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Read Order -->
    <bpmn:task id="Task_ReadOrder" name="Read order from automatic system">
      <bpmn:incoming>SequenceFlow_ReadOrder</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckStockFirstItem</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Check Stock -->
    <bpmn:exclusiveGateway id="Gateway_StockCheck" name="Product in stock?">
      <bpmn:incoming>SequenceFlow_CheckStockFirstItem</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InStockWithdraw</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NotInStockReorder</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Path A: In Stock -->
    <bpmn:task id="Task_WithdrawProduct" name="Withdraw product from warehouse">
      <bpmn:incoming>SequenceFlow_InStockWithdraw</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ItemProcessed_A</bpmn:outgoing>
    </bpmn:task>

    <!-- Path B: Not In Stock -->
    <bpmn:task id="Task_OrderFromWholesaler" name="Reorder product from wholesaler">
      <bpmn:incoming>SequenceFlow_NotInStockReorder</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitArrival</bpmn:outgoing>
    </bpmn:task>

    <!-- Wait for Arrival -->
    <bpmn:task id="Task_WaitArrival" name="Wait for product arrival">
      <bpmn:incoming>SequenceFlow_WaitArrival</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckDelayCondition</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2: Delay Check -->
    <bpmn:exclusiveGateway id="Gateway_DelayCheck" name="Wait &gt; 10 days?">
      <bpmn:incoming>SequenceFlow_CheckDelayCondition</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DemandPenalty</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoPenalty</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Penalty Task -->
    <bpmn:task id="Task_Penalty" name="Demand delivery delay penalty">
      <bpmn:incoming>SequenceFlow_DemandPenalty</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeAfterDelayCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- No Penalty Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_NoPenalty" sourceRef="Gateway_DelayCheck" targetRef="Task_RegisterStock"/>

    <!-- Merge Delay Paths -->
    <bpmn:exclusiveGateway id="Gateway_MergeDelayPaths">
      <bpmn:incoming>SequenceFlow_ItemProcessed_A</bpmn:outgoing></itemprocessed_a/>supplierid="Task_RegisterStock" name="Register product in stock system">
        <bpmn:name>Register Product</bpmn:name>
    </bpmn:task>

  </bpmn:process>

</bpmn:definitions>