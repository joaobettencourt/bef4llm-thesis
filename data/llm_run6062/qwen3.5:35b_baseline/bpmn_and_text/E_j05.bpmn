<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_VisaProcess_001">
  <bpmn:collaboration id="Collaboration_Applicant_Process">
    <bpmn:participant id="Participant_Applicant" name="Applicant Process - Work and Live in Austria" processRef="Process_VisaApplication"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_VisaApplication" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_BeginApplication" name="Begin Application Process">
      <bpmn:name>Begin Application Process</bpmn:name>
      <bpmn:outgoing>SequenceFlow_CheckEligibility</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1 -->
    <bpmn:task id="Task_CheckGeneralRequirements" name="Check General Requirements &amp; Eligibility">
      <bpmn:name>Check General Requirements &amp; Eligibility</bpmn:name>
      <bpmn:incoming>SequenceFlow_CheckEligibility</bpmn:outgoing></bpmn:task>

    <!-- Gateway 1 -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_Eligibility" name="Eligible for Visa?">
      <bpmn:name>Eligible for Visa?</bpmn:name>
      <bpmn:incoming>SequenceFlow_DecideEligible</bpmn:outgoing></bpmn:exclusiveGateway>

    <!-- End Event 1 -->
    <bpmn:endEvent id="EndEvent_Rejected" name="Application Rejected">
      <bpmn:name>Application Rejected</bpmn:name>
      <bpmn:incoming>NoEligibleFlow</bpmn:outgoing></end-event>

    <!-- Data Objects -->
    <bpmn:dataObject id="Data_Passport" name="Travel Document (Passport)"/>
    <bpmn:dataObject id="Data_Insurance" name="Health Insurance Policy"/>

    <!-- Task 2 - Prepare Documents -->
    <bpmn:task id="Task_PrepareDocuments" name="Prepare Required Documents">
      <bpmn:name>Prepare Required Documents</bpmn:name>
      <bpmn:incoming>SequenceFlow_PrepareDocuments</bpmn:outgoing></bpmn:task>

    <!-- Task 3 - Accommodation & Bank -->
    <bpmn:task id="Task_OrganizeAccommodationBank" name="Organise Accommodation &amp; Bank Account">
      <bpmn:name>Organise Accommodation &amp; Bank Account</bpmn:name>
      <bpmn:incoming>SequenceFlow_AccommodationPrep</bpmn:outgoing></bpmn:task>

    <!-- Parallel Gateway -->
    <bpmn:parallelGateway id="ParallelGateway_DocumentsAndAccommodation" name="Preparation Phase">
      <bpmn:name>Preparation Phase</bpmn:name>
      <bpmn:incoming>SequenceFlow_PrepareDocuments</bpmn:outgoing></bpmn:task>

    <!-- Gateway 2 - Submission Location -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_SubmissionLocation" name="Determine Competent Office">
      <bpmn:name>Determine Competent Office</bpmn:name>
      <bpmn:incoming>SequenceFlow_AccomToGateway</bpmn:outgoing></bpmn:task>

    <!-- Task 4 - Submit Application -->
    <bpmn:task id="Task_SubmitApplication" name="Submit Application to Representation">
      <bpmn:name>Submit Application to Representation</bpmn:name>
      <bpmn:incoming>SequenceFlow_DetermineLocation</bpmn:outgoing></bpmn:task>

    <!-- End Event 2 -->
    <bpmn:endEvent id="EndEvent_Completed" name="Application Submitted">
      <bpmn:name>Application Submitted</bpmn:name>
      <bpmn:incoming>SequenceFlow_SubmitToOffice</bpmn:outgoing></end-event>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckEligibility" sourceRef="StartEvent_BeginApplication" targetRef="Task_CheckGeneralRequirements"/>
    <bpmn:sequenceFlow id="SequenceFlow_DecideEligible" name="Yes" sourceRef="Task_CheckGeneralRequirements" targetRef="ExclusiveGateway_Eligibility"/>
    <bpmn:sequenceFlow id="NoEligibleFlow" name="No" sourceRef="ExclusiveGateway_Eligibility" targetRef="EndEvent_Rejected"/>

    <!-- Document Preparation Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_PrepareDocuments" sourceRef="Task_CheckGeneralRequirements" targetRef="ParallelGateway_DocumentsAndAccommodation"/>
    <bpmn:sequenceFlow id="SequenceFlow_AccommodationPrep" name="Prepare Accommodation &amp; Bank Account" sourceRef="ExclusiveGateway_Eligibility" targetRef="Task_OrganizeAccommodationBank"/>

    <!-- Parallel Gateway Flows -->
    <bpmn:parallelGateway id="ParallelGateway_DocumentsAndAccommodation">
      <bpmn:name>Preparation Phase</bpmn:name>
      <bpmn:incoming>SequenceFlow_PrepareDocuments</bpmn:outgoing></bpmn:task>

    <!-- Submission Location Decision -->
    <bpmn:sequenceFlow id="SequenceFlow_AccomToGateway" sourceRef="Task_OrganizeAccommodationBank" targetRef="ParallelGateway_DocumentsAndAccommodation"/>
    <bpmn:exclusiveGateway id="ExclusiveGateway_SubmissionLocation">
      <bpmn:name>Determine Competent Office</bpmn:name>
      <bpmn:incoming>SequenceFlow_AccomToGateway</bpmn:outgoing></bpmn:task>

    <!-- Final Submission Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_DetermineLocation" sourceRef="ExclusiveGateway_SubmissionLocation" targetRef="Task_SubmitApplication"/>
    <bpmn:sequenceFlow id="SequenceFlow_SubmitToOffice" name="Submit to Office" sourceRef="Task_SubmitApplication" targetRef="EndEvent_Completed"/>

  </bpmn:process>

</bpmn:definitions>