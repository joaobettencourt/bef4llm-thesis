<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_LegoMachine_001">
  <bpmn:collaboration id="Collaboration_MachineBuild">
    <bpmn:participant id="Participant_Manufacturer" name="Manufacturer Process" processRef="Process_BuildLegoMachine"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_BuildLegoMachine" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_StartBuild" name="Start Building Machine">
      <bpmn:outgoing>SequenceFlow_DevelopDesign</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Develop Design -->
    <bpmn:task id="Task_DevelopDesign" name="Develop Basic Design">
      <bpmn:incoming>SequenceFlow_DevelopDesign</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OrderSets</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow from Start to Develop -->
    <bpmn:sequenceFlow id="SequenceFlow_DevelopDesign" sourceRef="StartEvent_StartBuild" targetRef="Task_DevelopDesign"/>

    <!-- Task: Order Sets -->
    <bpmn:task id="Task_OrderSets" name="Order Lego Brick Sets">
      <bpmn:incoming>SequenceFlow_OrderSets</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SortParts</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow from Develop to Order -->
    <bpmn:sequenceFlow id="SequenceFlow_OrderSets" sourceRef="Task_DevelopDesign" targetRef="Task_OrderSets"/>

    <!-- Task: Sort Parts by Children -->
    <bpmn:task id="Task_SortParts" name="Sort Parts for Subcomponents">
      <bpmn:incoming>SequenceFlow_SortParts</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckMoreSubcomp</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow from Order to Sort -->
    <bpmn:sequenceFlow id="SequenceFlow_SortParts" sourceRef="Task_OrderSets" targetRef="Task_SortParts"/>

    <!-- Gateway: More Subcomponents? -->
    <bpmn:exclusiveGateway id="Gateway_MoreSubcomp">
      <bpmn:name>More Subcomponents?</bpmn:name>
      <bpmn:incoming>SequenceFlow_CheckMoreSubcomp</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BuildNextComp</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_AssembleMachine</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flow from Sort to Gateway -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckMoreSubcomp" sourceRef="Task_SortParts" targetRef="Gateway_MoreSubcomp"/>

    <!-- Task: Build Subcomponent (when parts available) -->
    <bpmn:task id="Task_BuildSubcomponent" name="Build Subcomponent">
      <bpmn:incoming>SequenceFlow_BuildNextComp</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TestSubcomp</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow from Gateway to Build -->
    <bpmn:sequenceFlow id="SequenceFlow_BuildNextComp" sourceRef="Gateway_MoreSubcomp" targetRef="Task_BuildSubcomponent">
      <bpmn:name>Yes</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Task: Test Subcomponent -->
    <bpmn:task id="Task_TestSubcomponent" name="Test Subcomponent">
      <bpmn:incoming>SequenceFlow_TestSubcomp</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckTestResult</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow from Build to Test -->
    <bpmn:sequenceFlow id="SequenceFlow_TestSubcomp" sourceRef="Task_BuildSubcomponent" targetRef="Task_TestSubcomponent"/>

    <!-- Gateway: Test Successful? -->
    <bpmn:exclusiveGateway id="Gateway_TestResult">
      <bpmn:name>Test Successful?</bpmn:name>
      <bpmn:incoming>SequenceFlow_CheckTestResult</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MoreSubcompLoop</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RedesignPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flow from Test to Gateway -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckTestResult" sourceRef="Task_TestSubcomponent" targetRef="Gateway_TestResult"/>

    <!-- Task: Redesign Subcomponent (if test fails) -->
    <bpmn:task id="Task_Redesign" name="Redesign Subcomponent">
      <bpmn:incoming>SequenceFlow_RedesignPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RebuildSubcomp</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow from Gateway to Redesign -->
    <bpmn:sequenceFlow id="SequenceFlow_RedesignPath" sourceRef="Gateway_TestResult" targetRef="Task_Redesign">
      <bpmn:name>No</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Task: Rebuild Subcomponent -->
    <bpmn:task id="Task_RebuildSubcomp" name="Rebuild Subcomponent">
      <bpmn:incoming>SequenceFlow_RedesignPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TestAgain</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow from Redesign to Rebuild -->
    <bpmn:sequenceFlow id="SequenceFlow_RebuildSubcomp" sourceRef="Task_Redesign" targetRef="Task_RebuildSubcomp"/>

    <!-- Loop back to Test after rebuild -->
    <bpmn:sequenceFlow id="SequenceFlow_TestAgain" sourceRef="Task_RebuildSubcomp" targetRef="Gateway_TestResult"/>

    <!-- Task: Assemble Machine (when all subcomponents done) -->
    <bpmn:task id="Task_AssembleMachine" name="Assemble Subcomponents">
      <bpmn:incoming>SequenceFlow_MoreSubcompLoop</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CompletedBuild</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow from Gateway to Assemble -->
    <bpmn:sequenceFlow id="SequenceFlow_MoreSubcompLoop" sourceRef="Gateway_TestResult" targetRef="Task_AssembleMachine">
      <bpmn:name>No</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_CompletedBuild" name="Machine Built">
      <bpmn:incoming>SequenceFlow_CompletedBuild</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flow from Assemble to End -->
    <bpmn:sequenceFlow id="SequenceFlow_CompletedBuild" sourceRef="Task_AssembleMachine" targetRef="EndEvent_CompletedBuild"/>

  </bpmn:process>
</bpmn:definitions>