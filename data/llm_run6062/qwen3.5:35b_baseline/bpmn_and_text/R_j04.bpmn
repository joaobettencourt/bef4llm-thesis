<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_CarService_001">
  <bpmn:collaboration id="Collaboration_CarService_001">
    <bpmn:participant id="Participant_CarServiceApp" name="Car Service App Process" processRef="Process_CarService_001"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_CarService_001">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_System" name="System/App">
        <bpmn:flowNodeRef>StartEvent_ServiceDue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckRegistration</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_IsRegistered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_NotEligible</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Customer" name="Customer/User">
        <bpmn:flowNodeRef>Task_NotifyUser</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DidGoService</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Mechanic" name="Mechanic/Facility">
        <bpmn:flowNodeRef>Task_GoToService</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterProblems</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendStatusUpdates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CompleteRepair</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PayViaApp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SetNextServiceTime</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_ServiceDue" name="Service Due Reminder Triggered">
      <bpmn:outgoing>SequenceFlow_CheckRegistration</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Check Registration -->
    <bpmn:task id="Task_CheckRegistration" name="Check Car Registration Status">
      <bpmn:incoming>SequenceFlow_CheckRegistration</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_IsRegisteredDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Is Registered? -->
    <bpmn:exclusiveGateway id="Gateway_IsRegistered" name="Is Car Registered?">
      <bpmn:incoming>SequenceFlow_IsRegisteredDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NotifyUserPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RegistrationErrorPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event: Not Eligible -->
    <bpmn:endEvent id="End_NotEligible" name="Service Not Eligible">
      <bpmn:incoming>SequenceFlow_RegistrationErrorPath</bpmn:outgoing></bpmn:registrationerrorpath>
    </bpmn:endEvent>

    <!-- Task: Notify User -->
    <bpmn:task id="Task_NotifyUser" name="Notify User of Service Due Date">
      <bpmn:incoming>SequenceFlow_NotifyUserPath</bpmn:outgoing></bpmn:notifypath>
      <bpmn:outgoing>SequenceFlow_WaitForServiceAction</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Did User Go to Service? -->
    <bpmn:exclusiveGateway id="Gateway_DidGoService" name="Did User Go To Service?">
      <bpmn:incoming>SequenceFlow_WaitForServiceAction</bpmn:outgoing></bpmn:waitforserviceaction>
      <bpmn:outgoing>SequenceFlow_ProceedToMechanicPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_FineAfter30DaysPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Go To Service -->
    <bpmn:task id="Task_GoToService" name="Go To Car Service Facility">
      <bpmn:incoming>SequenceFlow_ProceedToMechanicPath</bpmn:outgoing></bpmn:proceedtomechanicpath>
      <bpmn:outgoing>SequenceFlow_MechanicStartsWork</bpmn:outgoing>
    </bpmn:task>

    <!-- Mechanic Task: Enter Problems -->
    <bpmn:task id="Task_EnterProblems" name="Enter Problems for Reference">
      <bpmn:incoming>SequenceFlow_MechanicStartsWork</bpmn:outgoing></bpmn:mechanicstartswork>
      <bpmn:outgoing>SequenceFlow_SendStatusUpdatesLoop</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Send Status Updates -->
    <bpmn:task id="Task_SendStatusUpdates" name="Send Status Updates via Email">
      <bpmn:incoming>SequenceFlow_SendStatusUpdatesLoop</bpmn:outgoing></bpmn:sendstatusupdatesloop>
      <bpmn:outgoing>SequenceFlow_WaitForRepairCompletion</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Complete Repair -->
    <bpmn:task id="Task_CompleteRepair" name="Mark Repair Successful & Issue Pickerl">
      <bpmn:incoming>SequenceFlow_WaitForRepairCompletion</bpmn:outgoing></bpmn:waitforrepaircompletion>
      <bpmn:outgoing>SequenceFlow_UserPaymentPath</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Pay Via App -->
    <bpmn:task id="Task_PayViaApp" name="Pay Through App">
      <bpmn:incoming>SequenceFlow_UserPaymentPath</bpmn:outgoing></bpmn:userpaymentpath>
      <bpmn:outgoing>SequenceFlow_SetNextServiceTimeInput</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Set Next Service Time -->
    <bpmn:task id="Task_SetNextServiceTime" name="Enter Time for Next Service">
      <bpmn:incoming>SequenceFlow_SetNextServiceTimeInput</bpmn:outgoing></bpmn:setnextservicetimeinput>
      <bpmn:outgoing>SequenceFlow_ProcessEndPath</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event: Service Completed -->
    <bpmn:endEvent id="End_ServiceCompleted" name="Service Completed">
      <bpmn:incoming>SequenceFlow_ProcessEndPath</bpmn:outgoing></bpmn:processendpath>
    </bpmn:endEvent>

    <!-- Intermediate Timer Event (Wait 30 Days) -->
    <bpmn:intermediateTimerEvent id="Event_30DaysTimer" name="Wait for Service">
      <bpmn:incoming>SequenceFlow_FineAfter30DaysPath</bpmn:outgoing></bpmn:fineafter30dayspath>
      <bpmn:outgoing>SequenceFlow_IssueFineTask</bpmn:outgoing>
    </bpmn:intermediateTimerEvent>

    <!-- Task: Issue Fine -->
    <bpmn:task id="Task_IssueFine" name="Issue Service Fine">
      <bpmn:incoming>SequenceFlow_IssueFineTask</bpmn:outgoing></bpmn:issuefinetask>
      <bpmn:outgoing>SequenceFlow_FineEndPath</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event: Service Fined -->
    <bpmn:endEvent id="End_ServiceFined" name="Service Fined">
      <bpmn:incoming>SequenceFlow_FineEndPath</bpmn:outgoing></bpmn:fineendpath>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckRegistration" sourceRef="StartEvent_ServiceDue" targetRef="Task_CheckRegistration"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_IsRegisteredDecision" name="Is Registered?" sourceRef="Gateway_IsRegistered" targetRef="Task_NotifyUser">
      <bpmn:conditionExpression xsi:type="tFormalExpression"><![CDATA[isRegistered == true]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_RegistrationErrorPath" name="Not Registered?" sourceRef="Gateway_IsRegistered" targetRef="End_NotEligible">
      <bpmn:conditionExpression xsi:type="tFormalExpression"><![CDATA[isRegistered == false]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_WaitForServiceAction" sourceRef="Task_NotifyUser" targetRef="Gateway_DidGoService"/>

    <!-- Decision Logic for Service Status -->
    <bpmn:sequenceFlow id="SequenceFlow_ProceedToMechanicPath" name="Yes (Went to Service)" sourceRef="Gateway_DidGoService" targetRef="Task_GoToService">
      <bpmn:conditionExpression xsi:type="tFormalExpression"><![CDATA[serviceTaken == true]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_FineAfter30DaysPath" name="No (Timeout)" sourceRef="Gateway_DidGoService" targetRef="Event_30DaysTimer">
      <bpmn:conditionExpression xsi:type="tFormalExpression"><![CDATA[serviceTaken == false]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Mechanic Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_MechanicStartsWork" sourceRef="Task_GoToService" targetRef="Task_EnterProblems"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_SendStatusUpdatesLoop" name="While Waiting..." sourceRef="Task_EnterProblems" targetRef="Task_SendStatusUpdates"/>

    <!-- Wait for Repair Completion (Simulated by flow logic) -->
    <bpmn:sequenceFlow id="SequenceFlow_WaitForRepairCompletion" sourceRef="Task_SendStatusUpdates" targetRef="Task_CompleteRepair"/>

    <!-- Payment Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_UserPaymentPath" name="When Repair Done" sourceRef="Task_CompleteRepair" targetRef="Task_PayViaApp"/>

    <!-- Finalize Service Time -->
    <bpmn:sequenceFlow id="SequenceFlow_SetNextServiceTimeInput" sourceRef="Task_PayViaApp" targetRef="Task_SetNextServiceTime"/>

    <bpmn:sequenceFlow id="SequenceFlow_ProcessEndPath" name="Process Complete" sourceRef="Task_SetNextServiceTime" targetRef="End_ServiceCompleted"/>
    
    <!-- Fine Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_IssueFineTask" sourceRef="Event_30DaysTimer" targetRef="Task_IssueFine"/>

    <bpmn:sequenceFlow id="SequenceFlow_FineEndPath" name="Process Fined" sourceRef="Task_IssueFine" targetRef="End_ServiceFined"/>
  </bpmn:process>
</bpmn:definitions>