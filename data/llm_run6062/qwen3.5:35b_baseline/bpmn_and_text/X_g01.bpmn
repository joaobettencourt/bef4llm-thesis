<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_NewApplication_001">
  <bpmn:collaboration id="Collaboration_AppRegistration">
    <bpmn:participant id="Participant_UserApplicant" name="Course Registration Application" processRef="Process_Registrations_001"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Registrations_001" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Applicant" name="Applicant">
        <bpmn:flowNodeRef>StartEvent_NewApplication</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectCourseCandidate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CheckSlotsAvailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_NoSlots</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ViewCoursesAndDates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CheckAccountExists</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LoginExistingUser</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckUniversityEligibility</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_IsUniRegistered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_UnregisteredNoAction</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegisterAccountNewUser</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RequestActivationWait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MergeLoginPaths</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_TweetOrRegister</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CompleteRegistrationPayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ReceiveTicket</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_NewApplication" name="New Application">
      <bpmn:name>New Application for USI Course</bpmn:name>
      <bpmn:outgoing>SequenceFlow_SelectCourseCandidate</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_SelectCourseCandidate" name="Select Course Candidate">
      <bpmn:name>Select Course Candidate</bpmn:name>
      <bpmn:incoming>SequenceFlow_SelectCourseCandidate</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckSlotsAvailable</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_CheckSlotsAvailable" name="Check Slot Availability">
      <bpmn:name>Slots Available?</bpmn:name>
      <bpmn:incoming>SequenceFlow_CheckSlotsAvailable</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ShowCoursesIfFree</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="EndEvent_NoSlots" name="No Slots Available">
      <bpmn:name>No Slots Available</bpmn:name>
      <bpmn:incoming>SequenceFlow_SlotsNotAvailable</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:task id="Task_ViewCoursesAndDates" name="System Shows Courses &amp; Dates">
      <bpmn:name>View Courses and Dates</bpmn:name>
      <bpmn:incoming>SequenceFlow_ShowCoursesIfFree</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConfirmSelection</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_CheckAccountExists" name="Check Account Status">
      <bpmn:name>Has Existing Account?</bpmn:name>
      <bpmn:incoming>SequenceFlow_ConfirmSelection</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_HasAccount</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoAccount</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_LoginExistingUser" name="Login to Existing Account">
      <bpmn:name>Login Existing User</bpmn:name>
      <bpmn:incoming>SequenceFlow_HasAccount</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_LoginExistingUserPath</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_IsUniRegistered" name="Check Eligibility">
      <bpmn:name>Eligible University?</bpmn:name>
      <bpmn:incoming>SequenceFlow_CheckUniversityStatus</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_IsEligibleUni</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NotEligibleUni</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="EndEvent_UnregisteredNoAction" name="Process Ineligible">
      <bpmn:name>Not Eligible</bpmn:name>
      <bpmn:incoming>SequenceFlow_NotEligibleUni</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:task id="Task_CheckUniversityEligibility" name="Check University Registration">
      <bpmn:name>Check Eligible University Status</bpmn:name>
      <bpmn:incoming>SequenceFlow_NoAccount</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckUniversityStatus</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_RegisterAccountNewUser" name="Create New USI Account">
      <bpmn:name>Register Account</bpmn:name>
      <bpmn:incoming>SequenceFlow_IsEligibleUni</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RegisterAccountNewUserPath</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_RequestActivationWait" name="Request Activation and Wait">
      <bpmn:name>Request Activation</bpmn:name>
      <bpmn:incoming>SequenceFlow_NotEligibleUni</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RequestActivationWaitPath</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_MergeLoginPaths" name="Merge After Account Check">
      <bpmn:name>Merge Login Paths</bpmn:name>
      <bpmn:incoming>SequenceFlow_LoginExistingUserPath</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_RegisterAccountNewUserPath</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_RequestActivationWaitPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_LoginCompleted</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:parallelGateway id="ParallelGateway_TweetOrRegister" name="Concurrent Actions">
      <bpmn:name>Tweet or Register</bpmn:name>
      <bpmn:incoming>SequenceFlow_LoginCompleted</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SplitToTweet</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SplitToRegister</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:task id="Task_CompleteRegistrationPayment" name="Provide Payment Info and Register">
      <bpmn:name>Complete Registration &amp; Payment</bpmn:name>
      <bpmn:incoming>SequenceFlow_SplitToRegister</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CompleteRegisterPath</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_ReceiveTicket" name="Course Ticket">
      <bpmn:name>Receive Course Ticket</bpmn:name>
      <bpmn:incoming>SequenceFlow_MergeFinalSteps</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow_SelectCourseCandidate" sourceRef="StartEvent_NewApplication" targetRef="Task_SelectCourseCandidate"/>
    <bpmn:sequenceFlow id="SequenceFlow_CheckSlotsAvailable" name="Check Availability" sourceRef="Task_SelectCourseCandidate" targetRef="Gateway_CheckSlotsAvailable"/>
    <bpmn:sequenceFlow id="SequenceFlow_SlotsNotAvailable" name="No Slots Available" sourceRef="Gateway_CheckSlotsAvailable" targetRef="EndEvent_NoSlots"/>
    <bpmn:sequenceFlow id="SequenceFlow_ShowCoursesIfFree" name="Yes, Slots Free" sourceRef="Gateway_CheckSlotsAvailable" targetRef="Task_ViewCoursesAndDates"/>
    <bpmn:sequenceFlow id="SequenceFlow_ConfirmSelection" name="Select One" sourceRef="Task_ViewCoursesAndDates" targetRef="Gateway_CheckAccountExists"/>
    <bpmn:sequenceFlow id="SequenceFlow_HasAccount" name="Yes, Has Account" sourceRef="Gateway_CheckAccountExists" targetRef="Task_LoginExistingUser"/>
    <bpmn:sequenceFlow id="SequenceFlow_NoAccount" name="No Account" sourceRef="Gateway_CheckAccountExists" targetRef="Task_CheckUniversityEligibility"/>
    <bpmn:sequenceFlow id="SequenceFlow_CheckUniversityStatus" name="Check Status" sourceRef="Task_CheckUniversityEligibility" targetRef="Gateway_IsUniRegistered"/>
    <bpmn:sequenceFlow id="SequenceFlow_IsEligibleUni" name="Yes, Eligible Uni" sourceRef="Gateway_IsUniRegistered" targetRef="Task_RegisterAccountNewUser"/>
    <bpmn:sequenceFlow id="SequenceFlow_NotEligibleUni" name="No, Not Registered" sourceRef="Gateway_IsUniRegistered" targetRef="EndEvent_UnregisteredNoAction"/>
    <bpmn:sequenceFlow id="SequenceFlow_LoginExistingUserPath" sourceRef="Task_LoginExistingUser" targetRef="Gateway_MergeLoginPaths"/>
    <bpmn:sequenceFlow id="SequenceFlow_RegisterAccountNewUserPath" name="After Registration" sourceRef="Task_RegisterAccountNewUser" targetRef="Gateway_MergeLoginPaths"/>
    <bpmn:sequenceFlow id="SequenceFlow_RequestActivationWaitPath" name="After Activation Wait" sourceRef="Task_RequestActivationWait" targetRef="Gateway_MergeLoginPaths"/>
    <bpmn:sequenceFlow id="SequenceFlow_LoginCompleted" sourceRef="Gateway_MergeLoginPaths" targetRef="ParallelGateway_TweetOrRegister"/>
    <bpmn:sequenceFlow id="SequenceFlow_SplitToTweet" name="Also Tweet" sourceRef="ParallelGateway_TweetOrRegister" targetRef="Task_CompleteRegistrationPayment"/>
    <bpmn:sequenceFlow id="SequenceFlow_SplitToRegister" name="Complete Registration" sourceRef="ParallelGateway_TweetOrRegister" targetRef="Task_CompleteRegistrationPayment"/>
    <bpmn:sequenceFlow id="SequenceFlow_CompleteRegisterPath" name="After Payment/Reg" sourceRef="Task_CompleteRegistrationPayment" targetRef="EndEvent_ReceiveTicket"/>

  </bpmn:process>
</bpmn:definitions>