<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_LuxuryAirplane_001">
  <bpmn:collaboration id="Collaboration_AirplaneProcurement">
    <bpmn:participant id="Participant_Manufacturer" name="Luxury Airplane Manufacturer" processRef="Process_AirplaneManufacturing"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_AirplaneManufacturing" isExecutable="false">
    <bpmn:startEvent id="StartEvent_SpecsReceived" name="Customer Specifications Received">
      <bpmn:outgoing>SequenceFlow_ProcessOrder</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:dataObjectReference id="Data_CustomerSpecs"/>

    <bpmn:task id="Task_ProcessOrder" name="Process Order &amp; Send Requirements">
      <bpmn:incoming>SequenceFlow_ProcessOrder</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SplitProduction</bpmn:outgoing>
    </bpmn:task>

    <bpmn:parallelGateway id="ParallelGateway_ProductionSplit" name="Start Production Tasks">
      <bpmn:incoming>SequenceFlow_SplitProduction</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BaseModelProd</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_VodkaBarProd</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_WhiskeyBarProd</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_InteriorCustomization</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:laneSet id="LaneSet_Teams">
      <bpmn:lane id="Lane_BaseProduction" name="Base Production Team">
        <bpmn:flowNodeRef>Task_BaseModel</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CustomizationTeams" name="Interior Customization Teams">
        <bpmn:flowNodeRef>Task_VodkaBarProd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WhiskeyBarProd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InteriorCustomization</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AssemblyDelivery" name="Assembly &amp; Delivery">
        <bpmn:flowNodeRef>ParallelGateway_ProductionJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssembleInterior</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TestFlight</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Confirmed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Production Tasks -->
    <bpmn:task id="Task_BaseModel" name="Manufacture Base Model">
      <bpmn:incoming>SequenceFlow_BaseModelProd</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProductionReady1</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_VodkaBarProd" name="Manufacture Vodka Bar (Russian Team)">
      <bpmn:incoming>SequenceFlow_VodkaBarProd</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProductionReady2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_WhiskeyBarProd" name="Manufacture Whiskey Bar (Irish Team)">
      <bpmn:incoming>SequenceFlow_WhiskeyBarProd</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProductionReady3</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_InteriorCustomization" name="Seats, Color &amp; Water System">
      <bpmn:incoming>SequenceFlow_InteriorCustomization</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProductionReady4</bpmn:outgoing>
    </bpmn:task>

    <!-- Join Gateway -->
    <bpmn:parallelGateway id="ParallelGateway_ProductionJoin" name="Wait for Parts">
      <bpmn:incoming>SequenceFlow_ProductionReady1</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ProductionReady2</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ProductionReady3</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ProductionReady4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AssemblyStart</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Assembly -->
    <bpmn:task id="Task_AssembleInterior" name="Assemble Interior Components">
      <bpmn:incoming>SequenceFlow_AssemblyStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlight_TestPrep</bpmn:outgoing>
    </bpmn:task>

    <!-- Test Flight -->
    <bpmn:dataObjectReference id="Data_TestProtocol" name="Test Protocol"/>
    
    <bpmn:task id="Task_TestFlight" name="Conduct Test Flight &amp; Create Protocol">
      <bpmn:incoming>SequenceFlow_TestPrep</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DeliveryStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Delivery -->
    <bpmn:sequenceFlow id="SequenceFlight_TestPrep" sourceRef="Task_AssembleInterior" targetRef="Task_TestFlight"/>

    <bpmn:endEvent id="EndEvent_Confirmed" name="Customer Confirms">
      <bpmn:incoming>SequenceFlow_DeliveryStart</bpmn:outgoing></end-event>

  </bpmn:process>
</bpmn:definitions>