<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_OrderingProcess_001">
  <bpmn:collaboration id="Collaboration_OrderProcurement">
    <bpmn:participant id="Participant_CustomerOrder" name="Online Shop Ordering Process" processRef="Process_Ordering_001"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Ordering_001" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_LoginRequest" name="Login Request">
      <bpmn:name>Login Request</bpmn:name>
      <bpmn:outgoing>SequenceFlow_CheckCredentials</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task -->
    <bpmn:task id="Task_CheckCredentials" name="Check Credentials">
      <bpmn:name>Check Credentials</bpmn:name>
      <bpmn:incoming>SequenceFlow_CheckCredentials</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_LoginResult</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_LoginSuccess" name="Login Successful?">
      <bpmn:name>Login Successful?</bpmn:name>
      <bpmn:incoming>SequenceFlow_LoginResult</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ShoppingStopped</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SelectProductStart</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_ShoppingStopped" name="Shopping Experience Stops">
      <bpmn:name>Shopping Experience Stops</bpmn:name>
      <bpmn:incoming>SequenceFlow_ShoppingStopped</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task -->
    <bpmn:task id="Task_SelectProduct" name="Select Product">
      <bpmn:name>Select Product</bpmn:name>
      <bpmn:incoming>SequenceFlow_SelectProductStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AddToCartSave</bpmn:outgoing>
    </bpmn:task>

    <!-- Task -->
    <bpmn:task id="Task_AddToCartSave" name="Add to Cart &amp; Save">
      <bpmn:name>Add to Cart &amp; Save</bpmn:name>
      <bpmn:incoming>SequenceFlow_AddToCartSave</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckAllProducts</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_AllSelected" name="All Products Selected?">
      <bpmn:name>All Products Selected?</bpmn:name>
      <bpmn:incoming>SequenceFlow_CheckAllProducts</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SelectProductStart</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_OrderPreparationSplit</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Parallel Gateway -->
    <bpmn:parallelGateway id="ParallelGateway_PrepareOrder" name="Prepare Order">
      <bpmn:name>Prepare Order</bpmn:name>
      <bpmn:incoming>SequenceFlow_OrderPreparationSplit</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PaymentBranch</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_AddressBranch</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Payment Branch -->
    <bpmn:task id="Task_EnterPaymentData" name="Enter Payment Data">
      <bpmn:name>Enter Payment Data</bpmn:name>
      <bpmn:incoming>SequenceFlow_PaymentBranch</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitBankConfirmation</bpmn:outgoing>
    </bpmn:task>

    <!-- Task -->
    <bpmn:task id="Task_BankProcessing" name="Wait for Bank Confirmation">
      <bpmn:name>Wait for Bank Confirmation</bpmn:name>
      <bpmn:incoming>SequenceFlow_WaitBankConfirmation</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PaymentReady</bpmn:outgoing>
    </bpmn:task>

    <!-- Address Branch -->
    <bpmn:task id="Task_EnterShippingAddress" name="Enter Shipping Address">
      <bpmn:name>Enter Shipping Address</bpmn:name>
      <bpmn:incoming>SequenceFlow_AddressBranch</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckBillingNeeded</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_BillingCheck" name="Independent Billing?">
      <bpmn:name>Independent Billing?</bpmn:name>
      <bpmn:incoming>SequenceFlow_CheckBillingNeeded</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EnterBillingInfo</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_AddressReadyNoBill</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task -->
    <bpmn:task id="Task_EnterBillingInfo" name="Enter Billing Info">
      <bpmn:name>Enter Billing Info</bpmn:name>
      <bpmn:incoming>SequenceFlow_EnterBillingInfo</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AddressReadyBill</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Join Gateway -->
    <bpmn:parallelGateway id="ParallelGateway_Finalize" name="Finalize Order">
      <bpmn:name>Finalize Order</bpmn:name>
      <bpmn:incoming>SequenceFlow_PaymentReady</bpmn:outgoing></paymentreadyid=Task_BankProcessing"/>
    </parallel-gateway-id=ParallelGateway_Finalize" name="Order Finished">
      <bpmn:name>Finalize Order</bpmn:name>
      <bpmn:incoming>SequenceFlow_PaymentReady</bpmn:outgoing></paymentreadyid=Task_BankProcessing"/>

    <!-- Task -->
    <bpmn:task id="Task_SystemFinishOrder" name="System Finish Order">
      <bpmn:name>System Finish Order</bpmn:name>
      <bpmn:incoming>SequenceFlow_FinalizeTrigger</bpmn:outgoing></finalizetriggerid=ParallelGateway_Finalize"/>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_OrderCompleted" name="Order Completed">
      <bpmn:name>Order Completed</bpmn:name>
      <bpmn:incoming>SequenceFlow_SystemFinishTrigger</bpmn:outgoing></systemfinishtriggerid=Task_SystemFinishOrder"/>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckCredentials" sourceRef="StartEvent_LoginRequest" targetRef="Task_CheckCredentials"/>
    <bpmn:sequenceFlow id="SequenceFlow_LoginResult" name="Check Credentials Result" sourceRef="Task_CheckCredentials" targetRef="ExclusiveGateway_LoginSuccess">
      <bpmn:name>Yes</bpmn:name>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_ShoppingStopped" name="No - Stop Experience" sourceRef="ExclusiveGateway_LoginSuccess" targetRef="EndEvent_ShoppingStopped">
      <bpmn:name>No</bpmn:name>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_SelectProductStart" name="Yes - Continue" sourceRef="ExclusiveGateway_LoginSuccess" targetRef="Task_SelectProduct"/>
    <bpmn:sequenceFlow id="SequenceFlow_AddToCartSave" sourceRef="Task_SelectProduct" targetRef="Task_AddToCartSave"/>
    <bpmn:sequenceFlow id="SequenceFlow_CheckAllProducts" name="Check Products" sourceRef="Task_AddToCartSave" targetRef="ExclusiveGateway_AllSelected"/>
    <bpmn:sequenceFlow id="SequenceFlow_SelectLoopBack" name="Not All Selected" sourceRef="ExclusiveGateway_AllSelected" targetRef="Task_SelectProduct">
      <bpmn:name>No</bpmn:name>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_OrderPreparationSplit" name="All Products Ready" sourceRef="ExclusiveGateway_AllSelected" targetRef="ParallelGateway_PrepareOrder"/>

    <!-- Payment Branch Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_PaymentBranch" sourceRef="ParallelGateway_PrepareOrder" targetRef="Task_EnterPaymentData"/>
    <bpmn:sequenceFlow id="SequenceFlow_WaitBankConfirmation" name="Wait for Bank Confirmation" sourceRef="Task_EnterPaymentData" targetRef="Task_BankProcessing">
      <bpmn:name>Yes</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Address Branch Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_AddressBranch" sourceRef="ParallelGateway_PrepareOrder" targetRef="Task_EnterShippingAddress"/>
    <bpmn:sequenceFlow id="SequenceFlow_CheckBillingNeeded" name="Check Billing Needed" sourceRef="Task_EnterShippingAddress" targetRef="ExclusiveGateway_BillingCheck">
      <bpmn:name>Yes</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Address Internal Merge Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_AddressReadyNoBill" name="Same Billing" sourceRef="ExclusiveGateway_BillingCheck" targetRef="ParallelGateway_Finalize">
      <bpmn:name>No</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Finalization Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_PaymentReady" sourceRef="Task_BankProcessing" targetRef="ParallelGateway_Finalize"/>
    <bpmn:sequenceFlow id="SequenceFlow_AddressBranchComplete" name="Address Complete" sourceRef="ExclusiveGateway_BillingCheck" targetRef="ParallelGateway_Finalize">
      <bpmn:name>Yes</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>