<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_BecomingAParent_001">
  <bpmn:collaboration id="Collaboration_ParentLeave">
    <bpmn:participant id="Participant_Citizen" name="Citizen (Parent)" processRef="Process_MaternityLeave_001"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_MaternityLeave_001" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_RequestMaternityLeave" name="Request Maternity Leave">
      <bpmn:outgoing>SequenceFlow_FetchModels</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Data Objects -->
    <bpmn:dataObjectReference id="DataObj_LeavePlan" name="Selected Leave Plan"/>
    <bpmn:dataObjectReference id="DataObj_ParentInfo" name="Parent Information"/>
    <bpmn:dataObjectReference id="DataObj_CompanyConfirm" name="Company Confirmation"/>

    <!-- Task: Fetch Models -->
    <bpmn:task id="Task_FetchModels">
      <bpmn:name>Fetch Information About Models</bpmn:name>
      <bpmn:description>Determine months duration and split between parents</bpmn:description>
      <bpmn:incoming>SequenceFlow_FetchModels</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SelectPlan</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Select Model -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_SelectModel">
      <bpmn:name>Select Leave Model</bpmn:name>
      <bpmn:incoming>SequenceFlow_SelectPlan</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CollectInfo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Collect Parent Info -->
    <bpmn:task id="Task_CollectParentInfo">
      <bpmn:name>Collect Relevant Information</bpmn:name>
      <bpmn:incoming>SequenceFlow_CollectInfo</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NotifySplit</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway: Split Notifications -->
    <bpmn:parallelGateway id="ParallelGateway_Notifications">
      <bpmn:name>Notify Parties</bpmn:name>
      <bpmn:incoming>SequenceFlow_NotifySplit</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NotifySS</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NotifyCompany</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Notify Social Security -->
    <bpmn:task id="Task_NotifySocialSecurity">
      <bpmn:name>Notify Social Security</bpmn:name>
      <bpmn:incoming>SequenceFlow_NotifySS</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeNotifications-SS</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Notify Company -->
    <bpmn:task id="Task_NotifyCompany">
      <bpmn:name>Notify Company</bpmn:name>
      <bpmn:incoming>SequenceFlow_NotifyCompany</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeNotifications-Company</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway: Merge Notifications -->
    <bpmn:parallelGateway id="ParallelGateway_NotificationsMerge">
      <bpmn:name>Merge Notifications</bpmn:name>
      <bpmn:incoming>SequenceFlow_MergeNotifications-SS</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_MergeNotifications-Company</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GatherCompanyInfo</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Gather Company Info -->
    <bpmn:task id="Task_GatherCompanyInfo">
      <bpmn:name>Gather Information From Companies</bpmn:name>
      <bpmn:incoming>SequenceFlow_GatherCompanyInfo</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StartLeavePeriod</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Timer Event -->
    <bpmn:intermediateTimerEvent id="IntermediateTimer_EndOfPeriod" name="End of Maternity Period">
      <bpmn:incoming>SequenceFlow_StartLeavePeriod</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DecideExtension</bpmn:outgoing>
    </bpmn:intermediateTimerEvent>

    <!-- Gateway: Extension Decision -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_ExtendDecision">
      <bpmn:name>Decide Extension?</bpmn:name>
      <bpmn:incoming>SequenceFlow_DecideExtension</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NoExtension</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_YesExtension</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event 1 -->
    <bpmn:endEvent id="EndEvent_ProcessCompleted" name="Leave Taken">
      <bpmn:name>Process Completed</bpmn:name>
      <bpmn:incoming>SequenceFlow_NoExtension</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task: Request Extension -->
    <bpmn:task id="Task_RequestExtension">
      <bpmn:name>Request Extension</bpmn:name>
      <bpmn:incoming>SequenceFlow_YesExtension</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NotifyForExtension</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 2 -->
    <bpmn:endEvent id="EndEvent_Extended" name="Leave Extended">
      <bpmn:name>Process Completed (Extended)</bpmn:name>
      <bpmn:incoming>SequenceFlow_NotifyForExtension</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_FetchModels" sourceRef="StartEvent_RequestMaternityLeave" targetRef="Task_FetchModels"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_SelectPlan" name="Select Model" sourceRef="Task_FetchModels" targetRef="ExclusiveGateway_SelectModel"/>

    <bpmn:sequenceFlow id="SequenceFlow_CollectInfo" sourceRef="ExclusiveGateway_SelectModel" targetRef="Task_CollectParentInfo"/>

    <bpmn:sequenceFlow id="SequenceFlow_NotifySplit" name="Notify in time" sourceRef="Task_CollectParentInfo" targetRef="ParallelGateway_Notifications"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_NotifySS" sourceRef="ParallelGateway_Notifications" targetRef="Task_NotifySocialSecurity"/>

    <bpmn:sequenceFlow id="SequenceFlow_NotifyCompany" name="Notify Company" sourceRef="ParallelGateway_Notifications" targetRef="Task_NotifyCompany"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_MergeNotifications-SS" sourceRef="Task_NotifySocialSecurity" targetRef="ParallelGateway_NotificationsMerge"/>

    <bpmn:sequenceFlow id="SequenceFlow_MergeNotifications-Company" name="Confirmations Received" sourceRef="Task_NotifyCompany" targetRef="ParallelGateway_NotificationsMerge"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_GatherCompanyInfo" sourceRef="ParallelGateway_NotificationsMerge" targetRef="Task_GatherCompanyInfo"/>

    <bpmn:sequenceFlow id="SequenceFlow_StartLeavePeriod" name="Start Leave Period" sourceRef="Task_GatherCompanyInfo" targetRef="IntermediateTimer_EndOfPeriod"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_DecideExtension" sourceRef="IntermediateTimer_EndOfPeriod" targetRef="ExclusiveGateway_ExtendDecision"/>

    <bpmn:sequenceFlow id="SequenceFlow_NoExtension" name="No Extension Needed" sourceRef="ExclusiveGateway_ExtendDecision" targetRef="EndEvent_ProcessCompleted"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_YesExtension" name="Request Extension" sourceRef="ExclusiveGateway_ExtendDecision" targetRef="Task_RequestExtension"/>

    <bpmn:sequenceFlow id="SequenceFlow_NotifyForExtension" sourceRef="Task_RequestExtension" targetRef="EndEvent_Extended"/>
  </bpmn:process>
</bpmn:definitions>