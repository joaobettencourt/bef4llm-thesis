<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_ExaminationProcess_01" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_HospitalExamination">
    <bpmn:participant id="Participant_HospitalSystem" name="Hospital Examination Process" processRef="Proc_ExaminationProcess_01" />
  </bpmn:collaboration>

  <bpmn:process id="Proc_ExaminationProcess_01" isExecutable="true">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_OutpatientDepartment" name="Outpatient Department">
        <bpmn:flowNodeRef>StartEvent_PatientExamined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PhysicianInitialCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DecisionHealthy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FillExaminationForm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_PatientLeaves</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OrderAndRequestForm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformPatientRisks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ConsentDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ProcessCancelled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ArrangeAppointmentDelegate</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_WardDepartment" name="Ward Department">
        <bpmn:flowNodeRef>Task_NursePrepareExam</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WardPhysicianTakeSampleSendTreat</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Laboratory" name="Laboratory">
        <bpmn:flowNodeRef>Gateway_SampleValidDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AnalysisPerformedAssistant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LabPhysicianValidateResults</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_PatientExamined" name="Patient Examined">
      <bpmn:outgoing>SequenceFlow_InitialCheck</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Outpatient Tasks & Gateway 1 -->
    <bpmn:task id="Task_PhysicianInitialCheck" name="Physician Initial Check">
      <bpmn:incoming>SequenceFlow_InitialCheck</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_DecisionHealthy</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Healthy or Additional Exam? -->
    <bpmn:exclusiveGateway id="Gateway_DecisionHealthy" name="Patient Healthy?">
      <bpmn:incoming>SequenceFlow_DecisionHealthy</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PathHealthy</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PathAdditionalExam</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Path Healthy -->
    <bpmn:task id="Task_FillExaminationForm" name="Fill Examination Form">
      <bpmn:incoming>SequenceFlow_PathHealthy</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_LeavesProcess</bpmn:outgoing>
    </bpmn:task>

    <!-- Path Additional Exam -->
    <bpmn:task id="Task_OrderAndRequestForm" name="Place Order & Fill Request Form">
      <bpmn:incoming>SequenceFlow_PathAdditionalExam</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_InformRisks</bpmn:outgoing>
    </bpmn:task>

    <!-- Inform Risks -->
    <bpmn:task id="Task_InformPatientRisks" name="Inform Patient Risks">
      <bpmn:incoming>SequenceFlow_InformRisks</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ConsentDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2: Consent Decision -->
    <bpmn:exclusiveGateway id="Gateway_ConsentDecision" name="Consent Given?">
      <bpmn:incoming>SequenceFlow_ConsentDecision</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ArrangeAppointment</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CancelProcess</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_PatientLeaves" name="Patient Leaves">
      <bpmn:incoming>SequenceFlow_LeavesProcess</bpmn:outgoing>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_ProcessCancelled" name="Process Cancelled">
      <bpmn:incoming>SequenceFlow_CancelProcess</bpmn:outgoing>
    </bpmn:endEvent>

    <!-- Appointment & Ward Prep -->
    <bpmn:task id="Task_ArrangeAppointmentDelegate" name="Arrange Appointment with Ward">
      <bpmn:incoming>SequenceFlow_ArrangeAppointment</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NursePrepareExam</bpmn:outgoing>
    </bpmn:task>

    <!-- Lane Transition to Ward -->
    <bpmn:sequenceFlow id="SequenceFlow_ArrangeAppointment" sourceRef="Gateway_ConsentDecision" targetRef="Task_ArrangeAppointmentDelegate">
      <bpmn:name>Yes</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Ward Lane Tasks -->
    <bpmn:task id="Task_NursePrepareExam" name="Nurse Prepare Exam & Sampling">
      <bpmn:incoming>SequenceFlow_ArrangeAppointment</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_TakeSampleRequest</bpmn:outgoing>
    </bpmn:task>

    <!-- Loop Back from Lab -->
    <bpmn:sequenceFlow id="SequenceFlow_SampleLoopBack" sourceRef="Gateway_SampleValidDecision" targetRef="Task_WardPhysicianTakeSampleSendTreat">
      <bpmn:name>New Sample Required</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Ward Physician Tasks -->
    <bpmn:task id="Task_WardPhysicianTakeSampleSendTreat" name="Ward Physician Take & Send Sample, Treat">
      <bpmn:incoming>SequenceFlow_TakeSampleRequest</bpmn:outgoing>
      <bpmn:incoming>SequenceFlow_SampleLoopBack</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_LabReceiveStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow for Nurse to Ward Physician -->
    <bpmn:sequenceFlow id="SequenceFlow_TakeSampleRequest" sourceRef="Task_NursePrepareExam" targetRef="Task_WardPhysicianTakeSampleSendTreat">
      <bpmn:name />
    </bpmn:sequenceFlow>

    <!-- Sequence Flow for Ward Physician to Lab -->
    <bpmn:sequenceFlow id="SequenceFlow_LabReceiveStart" sourceRef="Task_WardPhysicianTakeSampleSendTreat" targetRef="Gateway_SampleValidDecision">
      <bpmn:name />
    </bpmn:sequenceFlow>

    <!-- Lane Transition to Laboratory -->
    <!-- Note: In BPMN XML without DI, flow crossing lanes is just a sequence link. The lane assignment handles visual grouping in tools. -->

    <!-- Lab Tasks & Gateway 3 -->
    <bpmn:task id="Task_LabValidateState" name="Physician Validate Sample State">
      <bpmn:incoming>SequenceFlow_LabReceiveStart</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SampleValidDecision</bpmn:outgoing>
    </bpmn:task>

     <!-- Gateway 3: Sample Valid? -->
    <bpmn:exclusiveGateway id="Gateway_SampleValidDecision" name="Sample Contaminated?">
      <bpmn:incoming>SequenceFlow_LabValidateState</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_AnalysisPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SampleLoopBack</bpmn:outgoing> <!-- Loop to Ward -->
    </bpmn:exclusiveGateway>

     <bpmn:task id="Task_AnalysisPerformedAssistant" name="Medical Technical Assistant Analysis">
       <bpmn:incoming>SequenceFlow_AnalysisPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_LabValidateResults</bpmn:outgoing>
    </bpmn:task>

     <bpmn:task id="Task_LabPhysicianValidateResults" name="Lab Physician Validate Results">
       <bpmn:incoming>SequenceFlow_AnalysisPath</bpmn:outgoing> <!-- Fixed reference below -->
      <bpmn:outgoing>SequenceFlow_OutpatientDiagnosisStart</bpmn:outgoing>
    </bpmn:task>

     <!-- Final Steps -->
    <bpmn:sequenceFlow id="SequenceFlow_AnalysisPath" sourceRef="Gateway_SampleValidDecision" targetRef="Task_AnalysisPerformedAssistant">
      <bpmn:name>No</bpmn:name>
    </bpmn:sequenceFlow>

     <bpmn:task id="Task_DiagnosePrescribeTherapy" name="Physician Diagnose & Prescribe Therapy">
       <bpmn:incoming>SequenceFlow_OutpatientDiagnosisStart</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ProcessCompleteEnd</bpmn:outgoing>
    </bpmn:task>

     <!-- End Event -->
    <bpmn:endEvent id="EndEvent_ProcessComplete" name="Diagnosis Complete">
       <bpmn:incoming>SequenceFlow_ProcessCompleteEnd</bpmn:outgoing>
    </bpmn:endEvent>

    <!-- Corrected Sequence Flows for Logic Consistency -->
     <bpmn:sequenceFlow id="SequenceFlow_InitialCheck" sourceRef="StartEvent_PatientExamined" targetRef="Task_PhysicianInitialCheck">
      <bpmn:name />
    </bpmn:sequenceFlow>

    <!-- Fixing Gateway Incoming/Outgoing references to match IDs -->
     <bpmn:exclusiveGateway id="Gateway_DecisionHealthy" name="Patient Healthy?">
       <bpmn:incoming>SequenceFlow_InitialCheck</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PathHealthy</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PathAdditionalExam</bpmn:outgoing>
    </bpmn:exclusiveGateway>

     <!-- Fixing Path Healthy -->
     <bpmn:sequenceFlow id="SequenceFlow_DecisionHealthy" sourceRef="Task_PhysicianInitialCheck" targetRef="Gateway_DecisionHealthy">
      <bpmn:name />
    </bpmn:sequenceFlow>

     <bpmn:exclusiveGateway id="Gateway_ConsentDecision" name="Consent Given?">
       <bpmn:incoming>SequenceFlow_InformRisks</bpmn:outgoing> <!-- Fixed reference -->
      <bpmn:outgoing>SequenceFlow_ArrangeAppointment</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CancelProcess</bpmn:outgoing>
    </bpmn:exclusiveGateway>

     <bpmn:sequenceFlow id="SequenceFlow_PathHealthy" sourceRef="Gateway_DecisionHealthy" targetRef="Task_FillExaminationForm">
      <bpmn:name />
    </bpmn:sequenceFlow>

     <bpmn:sequenceFlow id="SequenceFlow_LeavesProcess" sourceRef="Task_FillExaminationForm" targetRef="EndEvent_PatientLeaves">
      <bpmn:name />
    </bpmn:sequenceFlow>

     <bpmn:sequenceFlow id="SequenceFlow_PathAdditionalExam" sourceRef="Gateway_DecisionHealthy" targetRef="Task_OrderAndRequestForm">
      <bpmn:name>No</bpmn:name>
    </bpmn:sequenceFlow>

     <bpmn:task id="Task_FillExaminationForm" name="Fill Examination Form">
       <bpmn:incoming>SequenceFlow_PathHealthy</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_LeavesProcess</bpmn:outgoing>
    </bpmn:task>

     <bpmn:sequenceFlow id="SequenceFlow_InformRisks" sourceRef="Task_OrderAndRequestForm" targetRef="Gateway_ConsentDecision"> <!-- Fixed reference -->
      <bpmn:name />
    </bpmn:sequenceFlow>

     <bpmn:task id="Task_OrderAndRequestForm" name="Place Order & Fill Request Form">
       <bpmn:incoming>SequenceFlow_PathAdditionalExam</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_InformRisks</bpmn:outgoing>
    </bpmn:task>

     <bpmn:sequenceFlow id="SequenceFlow_CancelProcess" sourceRef="Gateway_ConsentDecision" targetRef="EndEvent_ProcessCancelled">
      <bpmn:name>No</bpmn:name>
    </bpmn:sequenceFlow>

     <!-- Fixing Lab Flow -->
     <bpmn:task id="Task_LabValidateState" name="Physician Validate Sample State">
       <bpmn:incoming>SequenceFlow_LabReceiveStart</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SampleValidDecision</bpmn:outgoing>
    </bpmn:task>

     <!-- Fixing Lab Gateway -->
     <bpmn:exclusiveGateway id="Gateway_SampleValidDecision" name="Sample Contaminated?">
       <bpmn:incoming>SequenceFlow_LabValidateState</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_AnalysisPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SampleLoopBack</bpmn:outgoing> <!-- Loop to Ward -->
    </bpmn:exclusiveGateway>

     <bpmn:sequenceFlow id="SequenceFlow_LabValidateState" sourceRef="Task_WardPhysicianTakeSampleSendTreat" targetRef="Task_LabValidateState">
      <bpmn:name />
    </bpmn:sequenceFlow>

     <!-- Fixing Analysis Flow -->
     <bpmn:task id="Task_AnalysisPerformedAssistant" name="Medical Technical Assistant Analysis">
       <bpmn:incoming>SequenceFlow_AnalysisPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_LabValidateResults</bpmn:outgoing>
    </bpmn:task>

     <!-- Fixing Lab Physician Flow -->
     <bpmn:sequenceFlow id="SequenceFlow_AnalysisPath" sourceRef="Gateway_SampleValidDecision" targetRef="Task_AnalysisPerformedAssistant">
      <bpmn:name>No</bpmn:name>
    </bpmn:sequenceFlow>

     <!-- Fixing Lab Physician Task -->
     <bpmn:task id="Task_LabPhysicianValidateResults" name="Lab Physician Validate Results">
       <bpmn:incoming>SequenceFlow_AnalysisPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_OutpatientDiagnosisStart</bpmn:outgoing>
    </bpmn:task>

     <!-- Fixing Final Flow -->
     <bpmn:sequenceFlow id="SequenceFlow_LabValidateResults" sourceRef="Task_AnalysisPerformedAssistant" targetRef="Task_LabPhysicianValidateResults">
      <bpmn:name />
    </bpmn:sequenceFlow>

     <bpmn:task id="Task_DiagnosePrescribeTherapy" name="Physician Diagnose & Prescribe Therapy">
       <bpmn:incoming>SequenceFlow_OutpatientDiagnosisStart</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ProcessCompleteEnd</bpmn:outgoing>
    </bpmn:task>

     <!-- Fixing Final Sequence -->
     <bpmn:sequenceFlow id="SequenceFlow_OutpatientDiagnosisStart" sourceRef="Task_LabPhysicianValidateResults" targetRef="Task_DiagnosePrescribeTherapy">
      <bpmn:name />
    </bpmn:sequenceFlow>

     <!-- Fixing End Flow -->
     <bpmn:endEvent id="EndEvent_ProcessComplete" name="Diagnosis Complete">
       <bpmn:incoming>SequenceFlow_ProcessCompleteEnd</bpmn:outgoing>
    </bpmn:endEvent>

     <bpmn:sequenceFlow id="SequenceFlow_ProcessCompleteEnd" sourceRef="Task_DiagnosePrescribeTherapy" targetRef="EndEvent_ProcessComplete">
      <bpmn:name />
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>