<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_LeadGenProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_LeadGen_01">
    <bpmn:participant id="Participant_BusinessUnit" name="Business Unit Lead Generation" processRef="Proc_LeadGeneration_01" />
  </bpmn:collaboration>

  <bpmn:process id="Proc_LeadGeneration_01" isExecutable="true">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Sourcing" name="Marketing &amp; Sourcing">
        <bpmn:flowNodeRef>StartEvent_GenerateLead</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GatherContactDetails</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CallCenter" name="Call Center Staff">
        <bpmn:flowNodeRef>InclusiveGateway_CheckInterestInitial</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IdentifyContactPerson</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckBudgetAvailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_CustomerLost</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_HeadOfDev" name="Head of Development">
        <bpmn:flowNodeRef>InclusiveGateway_CheckBudgetHuge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AcquireCustomer</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SalesRep" name="Sales Representative">
        <bpmn:flowNodeRef>InclusiveGateway_CheckInterestAfterAcquisition</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OnlinePresentationSalesRep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FollowUpCall</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Presales" name="Pre-sales Employee">
        <bpmn:flowNodeRef>InclusiveGateway_IsTechnicalPresentation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OnlinePresentationPresales</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_GenerateLead" name="Generate Lead">
      <bpmn:outgoing>SequenceFlow_InitSourcing</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Sourcing Phase -->
    <bpmn:task id="Task_GatherContactDetails" name="Determine Contact Details">
      <bpmn:incoming>SequenceFlow_InitSourcing</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StartCallCenterProcess</bpmn:outgoing>
    </bpmn:task>

    <!-- Call Center Phase -->
    <bpmn:sequenceFlow id="SequenceFlow_StartCallCenterProcess" sourceRef="Task_GatherContactDetails" targetRef="InclusiveGateway_CheckInterestInitial">
      <bpmn:name>Cold Call Initiated</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Decision 1: Initial Interest -->
    <bpmn:inclusiveGateway id="InclusiveGateway_CheckInterestInitial" name="Interested?">
      <bpmn:incoming>SequenceFlow_StartCallCenterProcess</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PresentationPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CheckBudgetHugePath</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Decision 2: Budget Huge? -->
    <bpmn:exclusiveGateway id="InclusiveGateway_CheckBudgetHuge" name="Is Budget Huge?">
      <bpmn:incoming>SequenceFlow_CheckBudgetHugePath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AcquireCustomerTask</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_EndProcessLost</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Head of Dev Task -->
    <bpmn:task id="Task_AcquireCustomer" name="Acquire Customer">
      <bpmn:incoming>SequenceFlow_AcquireCustomerTask</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckInterestAfterAcquisitionPath</bpmn:outgoing>
    </bpmn:task>

    <!-- Decision 3: Interest After Acquisition -->
    <bpmn:exclusiveGateway id="InclusiveGateway_CheckInterestAfterAcquisition" name="Interested Now?">
      <bpmn:incoming>SequenceFlow_AcquireCustomerTask</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PresentationPathFromDev</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_EndProcessLostAfterAcq</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Presentation Decision -->
    <bpmn:inclusiveGateway id="InclusiveGateway_IsTechnicalPresentation" name="Is Technical?">
      <bpmn:incoming>SequenceFlow_PresentationPathFromDev</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_PresentationPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TaskPresalesPresentation</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_TaskSalesRepPresentation</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Presentation Tasks -->
    <bpmn:task id="Task_OnlinePresentationPresales" name="Detailed Online Presentation (Technical)">
      <bpmn:incoming>SequenceFlow_TaskPresalesPresentation</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitForContactEvent</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_OnlinePresentationSalesRep" name="Detailed Online Presentation (Standard)">
      <bpmn:incoming>SequenceFlow_TaskSalesRepPresentation</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitForContactEvent2</bpmn:outgoing>
    </bpmn:task>

    <!-- Wait Logic -->
    <bpmn:intermediateCatchEvent id="IntermediateWaitCustomerResponse" name="Waiting for Response">
      <bpmn:incoming>SequenceFlow_WaitForContactEvent</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_WaitForContactEvent2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProceedToQuotation</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Boundary Timer Event on Wait -->
    <bpmn:boundaryTimer id="Boundary_2Weeks" attachedToRef="IntermediateWaitCustomerResponse">
      <bpmn:timerDefinition xsi:type="bpmn:TimeDurationExpression">P14D</bpmn:timerDefinition> <!-- 2 Weeks -->
      <bpmn:outgoing>SequenceFlow_FollowUpCallPath</bpmn:outgoing>
    </bpmn:boundaryTimer>

    <!-- Follow Up Call Task -->
    <bpmn:task id="Task_FollowUpCall" name="Sales Rep Calls Customer">
      <bpmn:incoming>SequenceFlow_FollowUpCallPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProceedToQuotationFromFollowup</bpmn:outgoing>
    </bpmn:task>

    <!-- Final Phase -->
    <bpmn:task id="Task_CreateQuotation" name="Create Quotation">
      <bpmn:incoming>SequenceFlow_ProceedToQuotation</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ProceedToQuotationFromFollowup</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndProcessComplete</bpmn:outgoing>
    </bpmn:task>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_CustomerLost" name="Customer Lost">
      <bpmn:incoming>SequenceFlow_EndProcessLost</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_EndProcessLostAfterAcq</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_ProcessComplete" name="Quotation Created">
      <bpmn:incoming>SequenceFlow_EndProcessComplete</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_InitSourcing" sourceRef="StartEvent_GenerateLead" targetRef="Task_GatherContactDetails">
      <bpmn:name>Determine Contact Details</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Gateway 1 Outgoing -->
    <bpmn:sequenceFlow id="SequenceFlow_PresentationPath" sourceRef="InclusiveGateway_CheckInterestInitial" targetRef="InclusiveGateway_IsTechnicalPresentation">
      <bpmn:name>If Interested</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Gateway 1 No Path -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckBudgetHugePath" sourceRef="InclusiveGateway_CheckInterestInitial" targetRef="InclusiveGateway_CheckBudgetHuge">
      <bpmn:name>If Not Interested</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Gateway 2 Outgoing -->
    <bpmn:sequenceFlow id="SequenceFlow_AcquireCustomerTask" sourceRef="InclusiveGateway_CheckBudgetHuge" targetRef="Task_AcquireCustomer">
      <bpmn:name>If Budget Huge</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_EndProcessLost" sourceRef="InclusiveGateway_CheckBudgetHuge" targetRef="EndEvent_CustomerLost">
      <bpmn:name>If Not Interested &amp; Low Budget</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Gateway 3 Outgoing -->
    <bpmn:sequenceFlow id="SequenceFlow_PresentationPathFromDev" sourceRef="InclusiveGateway_CheckInterestAfterAcquisition" targetRef="InclusiveGateway_IsTechnicalPresentation">
      <bpmn:name>If Interested Now</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_EndProcessLostAfterAcq" sourceRef="InclusiveGateway_CheckInterestAfterAcquisition" targetRef="EndEvent_CustomerLost">
      <bpmn:name>If Still Not Interested</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Presentation Type -->
    <bpmn:sequenceFlow id="SequenceFlow_TaskPresalesPresentation" sourceRef="InclusiveGateway_IsTechnicalPresentation" targetRef="Task_OnlinePresentationPresales">
      <bpmn:name>If Technical</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_TaskSalesRepPresentation" sourceRef="InclusiveGateway_IsTechnicalPresentation" targetRef="Task_OnlinePresentationSalesRep">
      <bpmn:name>If Standard</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Wait Logic -->
    <bpmn:sequenceFlow id="SequenceFlow_WaitForContactEvent" sourceRef="Task_OnlinePresentationPresales" targetRef="IntermediateWaitCustomerResponse">
      <bpmn:name>Await Response</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Wait Logic (Standard) -->
    <bpmn:sequenceFlow id="SequenceFlow_WaitForContactEvent2" sourceRef="Task_OnlinePresentationSalesRep" targetRef="IntermediateWaitCustomerResponse">
      <bpmn:name>Await Response</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Follow Up Path -->
    <bpmn:sequenceFlow id="SequenceFlow_FollowUpCallPath" sourceRef="Boundary_2Weeks" targetRef="Task_FollowUpCall">
      <bpmn:name>If Not Contacted (2 Weeks)</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Quotation Path -->
    <bpmn:sequenceFlow id="SequenceFlow_ProceedToQuotation" sourceRef="IntermediateWaitCustomerResponse" targetRef="Task_CreateQuotation">
      <bpmn:name>Contact Received</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ProceedToQuotationFromFollowup" sourceRef="Task_FollowUpCall" targetRef="Task_CreateQuotation">
      <bpmn:name>After Follow-up</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- End Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_EndProcessComplete" sourceRef="Task_CreateQuotation" targetRef="EndEvent_ProcessComplete">
      <bpmn:name>Create Quotation</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>