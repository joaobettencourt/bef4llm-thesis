<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_MSPN_Registration" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_MSPN_Process">
    <bpmn:participant id="Participant_MainProcess" name="MSPN Registration Process" processRef="Proc_MSPN_01" />
  </bpmn:collaboration>

  <bpmn:process id="Proc_MSPN_01" isExecutable="true">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Requester" name="MSPN">
        <bpmn:flowNodeRef>StartEvent_Regist</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegisterMeasurement</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GO" name="GO">
        <bpmn:flowNodeRef>InclusiveGateway_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExamineApplication</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssignMSPN</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_NotifySplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyMSPO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyMPO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifySP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_NotifyJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Success</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Regist" name="Measurement Registration">
      <bpmn:outgoing>SequenceFlow_Init</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: MSPN Registers Measurement -->
    <bpmn:task id="Task_RegisterMeasurement" name="Register measurement at GO">
      <bpmn:incoming>SequenceFlow_Init</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToExamine</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: GO Examines Application -->
    <bpmn:task id="Task_ExamineApplication" name="Examine application of MSPN">
      <bpmn:incoming>SequenceFlow_ToExamine</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Decide</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Decision (Reject or Confirm) -->
    <bpmn:exclusiveGateway id="InclusiveGateway_Decision" name="Application Result">
      <bpmn:incoming>SequenceFlow_Decide</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RejectPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ConfirmPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event 1: Rejection -->
    <bpmn:endEvent id="EndEvent_Reject" name="Application Rejected">
      <bpmn:incoming>SequenceFlow_RejectPath</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task 3: GO Assigns MSPN (on Confirm) -->
    <bpmn:task id="Task_AssignMSPN" name="Assign the MSPN">
      <bpmn:incoming>SequenceFlow_ConfirmPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NotifyStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2: Parallel Notifications Split -->
    <bpmn:parallelGateway id="InclusiveGateway_NotifySplit" name="Notify Parties">
      <bpmn:incoming>SequenceFlow_NotifyStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NotifMSPO</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NotifMPO</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NotifSP</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 4: Inform MSPO -->
    <bpmn:task id="Task_NotifyMSPO" name="Inform MSPO about assignment">
      <bpmn:incoming>SequenceFlow_NotifMSPO</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_JoinNotify1</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 5: Inform MPO -->
    <bpmn:task id="Task_NotifyMPO" name="Inform MPO about assignment">
      <bpmn:incoming>SequenceFlow_NotifMPO</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_JoinNotify2</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 6: Inform SP -->
    <bpmn:task id="Task_NotifySP" name="Inform SP about assignment">
      <bpmn:incoming>SequenceFlow_NotifSP</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_JoinNotify3</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 3: Parallel Join -->
    <bpmn:parallelGateway id="InclusiveGateway_NotifyJoin" name="All Notified">
      <bpmn:incoming>SequenceFlow_JoinNotify1</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_JoinNotify2</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_JoinNotify3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Finalize</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- End Event 2: Success -->
    <bpmn:endEvent id="EndEvent_Success" name="Assignment Complete">
      <bpmn:incoming>SequenceFlow_Finalize</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_Init" sourceRef="StartEvent_Regist" targetRef="Task_RegisterMeasurement">
      <bpmn:name>Register Measurement</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ToExamine" sourceRef="Task_RegisterMeasurement" targetRef="Task_ExamineApplication">
      <bpmn:name>To Examination</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_Decide" sourceRef="Task_ExamineApplication" targetRef="InclusiveGateway_Decision">
      <bpmn:name>Examination Complete</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_RejectPath" name="Reject Application" sourceRef="InclusiveGateway_Decision" targetRef="EndEvent_Reject">
      <bpmn:name>Reject</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ConfirmPath" name="Confirm Application" sourceRef="InclusiveGateway_Decision" targetRef="Task_AssignMSPN">
      <bpmn:name>Confirm</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_NotifyStart" name="Assignment Done" sourceRef="Task_AssignMSPN" targetRef="InclusiveGateway_NotifySplit">
      <bpmn:name>To Notifications</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_NotifMSPO" name="Notify MSPO" sourceRef="InclusiveGateway_NotifySplit" targetRef="Task_NotifyMSPO">
      <bpmn:name>To MSPO</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_NotifMPO" name="Notify MPO" sourceRef="InclusiveGateway_NotifySplit" targetRef="Task_NotifyMPO">
      <bpmn:name>To MPO</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_NotifSP" name="Notify SP" sourceRef="InclusiveGateway_NotifySplit" targetRef="Task_NotifySP">
      <bpmn:name>To SP</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_JoinNotify1" name="MSPO Notified" sourceRef="Task_NotifyMSPO" targetRef="InclusiveGateway_NotifyJoin">
      <bpmn:name>To Join</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_JoinNotify2" name="MPO Notified" sourceRef="Task_NotifyMPO" targetRef="InclusiveGateway_NotifyJoin">
      <bpmn:name>To Join</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_JoinNotify3" name="SP Notified" sourceRef="Task_NotifySP" targetRef="InclusiveGateway_NotifyJoin">
      <bpmn:name>To Join</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_Finalize" name="All Notified" sourceRef="InclusiveGateway_NotifyJoin" targetRef="EndEvent_Success">
      <bpmn:name>To End Event</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>