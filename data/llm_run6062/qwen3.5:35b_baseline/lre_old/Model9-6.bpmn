<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_DesignProcess_01" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="CollabDesignProcess_1">
    <bpmn:participant id="Participant_EngineeringDept" name="Engineering Department" processRef="Proc_DesignDevelopment_01" />
  </bpmn:collaboration>

  <bpmn:process id="Proc_DesignDevelopment_01" isExecutable="true">
    <!-- Lane Set for Departments -->
    <bpmn:laneSet>
      <bpmn:lane id="Lane_ElectricalDesign" name="Electrical Design Department">
        <bpmn:flowNodeRef>InclusiveGateway_ElecReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ElecCreateUpdatePlan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ElecReviseDesign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_ElecTestResult</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PhysicalDesign" name="Physical Design Department">
        <bpmn:flowNodeRef>InclusiveGateway_PhyReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PhyCreateUpdatePlan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PhyReviseDesign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_PhyTestResult</bpmn:flowNodeRef>
      </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_DesignInitiation" name="Design Process Initiated">
      <bpmn:outgoing>SequenceFlow_InitiateLocate</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task to locate and distribute existing designs -->
    <bpmn:task id="Task_LocateDistributeExistingDesigns" name="Locate &amp; Distribute Existing Designs">
      <bpmn:incoming>SequenceFlow_InitiateLocate</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SplitParallelDev</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway for parallel development -->
    <bpmn:parallelGateway id="ParallelGateway_DevSplit" name="Start Design Development">
      <bpmn:incoming>SequenceFlow_SplitParallelDev</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ElecDesignPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PhyDesignPath</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Electrical Design Path -->
    <bpmn:inclusiveGateway id="InclusiveGateway_ElecReview" name="Electrical Review">
      <bpmn:incoming>SequenceFlow_ElecDesignPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ElecCreatePlan</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <bpmn:task id="Task_ElecReviewExisting" name="Review Existing Electrical Designs">
      <bpmn:incoming>SequenceFlow_ElecDesignPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ElecCreatePlan</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_ElecCreateUpdatePlan" name="Create Electrical Update Plan">
      <bpmn:incoming>SequenceFlow_ElecReviewExisting</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ElecReviseDesign</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_ElecReviseDesign" name="Revised Electrical Design">
      <bpmn:incoming>SequenceFlow_ElecCreateUpdatePlan</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ElecTestResult</bpmn:outgoing>
    </bpmn:task>

    <!-- Physical Design Path -->
    <bpmn:inclusiveGateway id="InclusiveGateway_PhyReview" name="Physical Review">
      <bpmn:incoming>SequenceFlow_PhyDesignPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PhyCreatePlan</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <bpmn:task id="Task_PhyReviewExisting" name="Review Existing Physical Designs">
      <bpmn:incoming>SequenceFlow_PhyDesignPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PhyCreatePlan</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_PhyCreateUpdatePlan" name="Create Physical Update Plan">
      <bpmn:incoming>SequenceFlow_PhyReviewExisting</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PhyReviseDesign</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_PhyReviseDesign" name="Revised Physical Design">
      <bpmn:incoming>SequenceFlow_PhyCreateUpdatePlan</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PhyTestResult</bpmn:outgoing>
    </bpmn:task>

    <!-- Test Results for Electrical -->
    <bpmn:exclusiveGateway id="InclusiveGateway_ElecTestResult" name="Electrical Design Pass?">
      <bpmn:incoming>SequenceFlow_ElecReviseDesign</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ElecPassNotifyOther</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ElecFailReviewLoop</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Test Results for Physical -->
    <bpmn:exclusiveGateway id="InclusiveGateway_PhyTestResult" name="Physical Design Pass?">
      <bpmn:incoming>SequenceFlow_PhyReviseDesign</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PhyPassNotifyOther</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PhyFailReviewLoop</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Combined Design Gateway -->
    <bpmn:parallelGateway id="ParallelGateway_CombineDesigns" name="Combine Designs">
      <bpmn:incoming>SequenceFlow_ElecPassNotifyOther</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_PhyPassNotifyOther</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CombinedTestInitiate</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Combined Design Task -->
    <bpmn:task id="Task_CombineDesigns" name="Combine Electrical &amp; Physical Designs">
      <bpmn:incoming>SequenceFlow_CombinedTestInitiate</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FinalCombinedTestResult</bpmn:outgoing>
    </bpmn:task>

    <!-- Final Test Result -->
    <bpmn:exclusiveGateway id="InclusiveGateway_FinalTest" name="Final Combined Design Pass?">
      <bpmn:incoming>SequenceFlow_FinalCombinedTestResult</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CycleRestartBoth</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_DesignCompleteManufacturing</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_CycleRestart" name="Design Cycle Restart">
      <bpmn:incoming>SequenceFlow_CycleRestartBoth</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_DesignComplete" name="Design Complete - Send to Manufacturing">
      <bpmn:incoming>SequenceFlow_DesignCompleteManufacturing</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_InitiateLocate" sourceRef="StartEvent_DesignInitiation" targetRef="Task_LocateDistributeExistingDesigns">
      <bpmn:name>Process Starts</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_SplitParallelDev" sourceRef="Task_LocateDistributeExistingDesigns" targetRef="ParallelGateway_DevSplit">
      <bpmn:name>Distribution Complete</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Electrical Path Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_ElecDesignPath" sourceRef="ParallelGateway_DevSplit" targetRef="Task_ElecReviewExisting">
      <bpmn:name>Start Electrical Design</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ElecCreatePlan" sourceRef="Task_ElecReviewExisting" targetRef="Task_ElecCreateUpdatePlan">
      <bpmn:name>Create Update Plan</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ElecReviseDesign" sourceRef="Task_ElecCreateUpdatePlan" targetRef="InclusiveGateway_ElecTestResult">
      <bpmn:name>Create Revised Design</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Physical Path Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_PhyDesignPath" sourceRef="ParallelGateway_DevSplit" targetRef="Task_PhyReviewExisting">
      <bpmn:name>Start Physical Design</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_PhyCreatePlan" sourceRef="Task_PhyReviewExisting" targetRef="Task_PhyCreateUpdatePlan">
      <bpmn:name>Create Update Plan</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_PhyReviseDesign" sourceRef="Task_PhyCreateUpdatePlan" targetRef="InclusiveGateway_PhyTestResult">
      <bpmn:name>Create Revised Design</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Test Result Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_ElecPassNotifyOther" sourceRef="InclusiveGateway_ElecTestResult" targetRef="ParallelGateway_CombineDesigns">
      <bpmn:name>Electrical Pass - Notify Other</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_PhyPassNotifyOther" sourceRef="InclusiveGateway_PhyTestResult" targetRef="ParallelGateway_CombineDesigns">
      <bpmn:name>Physical Pass - Notify Other</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Loop Flows for Failures -->
    <bpmn:sequenceFlow id="SequenceFlow_ElecFailReviewLoop" sourceRef="InclusiveGateway_ElecTestResult" targetRef="Task_ElecCreateUpdatePlan">
      <bpmn:name>Fails Test - Review Again</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_PhyFailReviewLoop" sourceRef="InclusiveGateway_PhyTestResult" targetRef="Task_PhyCreateUpdatePlan">
      <bpmn:name>Fails Test - Review Again</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Combined Design Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_CombinedTestInitiate" sourceRef="ParallelGateway_CombineDesigns" targetRef="Task_CombineDesigns">
      <bpmn:name>Both Designs Ready</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Final Test Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_FinalCombinedTestResult" sourceRef="Task_CombineDesigns" targetRef="InclusiveGateway_FinalTest">
      <bpmn:name>Final Combined Design</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Final Decision Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_CycleRestartBoth" sourceRef="InclusiveGateway_FinalTest" targetRef="EndEvent_CycleRestart">
      <bpmn:name>Fails - Restart Cycle</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_DesignCompleteManufacturing" sourceRef="InclusiveGateway_FinalTest" targetRef="EndEvent_DesignComplete">
      <bpmn:name>Passes - Send to Manufacturing</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>