<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_ClaimsHandling_01" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_ClaimProcess_01">
    <bpmn:participant id="Participant_ClaimSystem" name="Claims Handling Process" processRef="Proc_ClaimsHandling_01" />
  </bpmn:collaboration>

  <bpmn:process id="Proc_ClaimsHandling_01" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_AdminSupport" name="Admin Support">
        <bpmn:flowNodeRef>StartEvent_ClaimReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SearchCompileDocs</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ClaimsHandler" name="Claims Handler">
        <bpmn:flowNodeRef>Task_CalculateInitialEstimate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateActionPlan</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ClaimsManager" name="Claims Manager">
        <bpmn:flowNodeRef>Task_NegotiateSettlement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_InformClaimant</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_ClaimReceived" name="New Claim Received">
      <bpmn:outgoing>SequenceFlow_InitSearch</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Search and Compile -->
    <bpmn:task id="Task_SearchCompileDocs" name="Retrieve Police Report &amp; Claim Docs">
      <bpmn:incoming>SequenceFlow_InitSearch</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_HandoverFile</bpmn:outgoing>
    </bpmn:task>

    <!-- Data Objects -->
    <bpmn:dataObject id="Data_PoliceReportDB" name="Police Report Database">
       <bpmn:name>Data Source</bpmn:name>
    </bpmn:dataObject>
    
    <!-- Task 2: Calculate Estimate -->
    <bpmn:task id="Task_CalculateInitialEstimate" name="Calculate Initial Claim Estimate">
      <bpmn:incoming>SequenceFlow_HandoverFile</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CreatePlanPath</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3: Create Action Plan -->
    <bpmn:dataObject id="Doc_ActionChecklist" name="Action Plan Checklist">
       <bpmn:name>Data Source for Plan</bpmn:name>
    </bpmn:dataObject>
    
    <bpmn:task id="Task_CreateActionPlan" name="Create Action Plan using Checklist">
      <bpmn:incoming>SequenceFlow_CreatePlanPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NegotiateHandover</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 4: Negotiate Settlement -->
    <bpmn:task id="Task_NegotiateSettlement" name="Negotiate Settlement">
      <bpmn:incoming>SequenceFlow_NegotiateHandover</bpmn:outgoing>
       <bpmn:outgoing>SequenceFlow_FinalizeProcess</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_InformClaimant" name="Inform Claimant &amp; Close Process">
      <bpmn:incoming>SequenceFlow_FinalizeProcess</bpmn:outgoing>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_InitSearch" sourceRef="StartEvent_ClaimReceived" targetRef="Task_SearchCompileDocs">
      <bpmn:name>Initiate Search</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Associations for Data Objects -->
    <bpmn:dataAssociation id="Assoc_PoliceReportDB">
       <bpmn:sourceRef>Data_PoliceReportDB</bpmn:sourceRef>
       <bpmn:targetRef>Task_SearchCompileDocs</bpmn:targetRef>
    </bpmn:dataAssociation>

    <bpmn:sequenceFlow id="SequenceFlow_HandoverFile" sourceRef="Task_SearchCompileDocs" targetRef="Task_CalculateInitialEstimate">
      <bpmn:name>Hand over File</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Associations for Data Objects -->
    <bpmn:dataAssociation id="Assoc_ActionChecklist">
       <bpmn:sourceRef>Doc_ActionChecklist</bpmn:sourceRef>
       <bpmn:targetRef>Task_CreateActionPlan</bpmn:targetRef>
    </bpmn:dataAssociation>

    <bpmn:sequenceFlow id="SequenceFlow_CreatePlanPath" sourceRef="Task_CalculateInitialEstimate" targetRef="Task_CreateActionPlan">
      <bpmn:name>Proceed to Plan</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_NegotiateHandover" sourceRef="Task_CreateActionPlan" targetRef="Task_NegotiateSettlement">
      <bpmn:name>Ready for Negotiation</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_FinalizeProcess" sourceRef="Task_NegotiateSettlement" targetRef="EndEvent_InformClaimant">
      <bpmn:name>Outcome Reached</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>