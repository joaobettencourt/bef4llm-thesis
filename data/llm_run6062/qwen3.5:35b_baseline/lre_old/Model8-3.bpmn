<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_RecruitmentProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_Recruitment_01">
    <bpmn:participant id="Participant_Process" name="Personnel Recruitment Process" processRef="Proc_PersonnelReq_01" />
  </bpmn:collaboration>

  <bpmn:process id="Proc_PersonnelReq_01" isExecutable="true">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_HiringManager" name="Hiring Manager (I)">
        <bpmn:flowNodeRef>StartEvent_DetectRequirements</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReportVacancy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_ReviewWait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewDescription</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_ApproveRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Advertised</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_HRSpecialist" name="HR Specialist (Colleague)">
        <bpmn:flowNodeRef>InclusiveGateway_DescriptionMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DescribeJobDesc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_CheckRequirements</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_DetectRequirements" name="Personnel Requirements Detected">
      <bpmn:outgoing>SequenceFlow_InitReport</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Hiring Manager Tasks & Gateways -->
    <bpmn:task id="Task_ReportVacancy" name="Report Vacancy to Personnel Dept">
      <bpmn:incoming>SequenceFlow_InitReport</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToHRStart</bpmn:outgoing>
    </bpmn:task>

    <!-- HR Lane Entry Point (Merge for Revision Loop) -->
    <bpmn:inclusiveGateway id="InclusiveGateway_ReviewWait">
      <bpmn:incoming>SequenceFlow_InitReport</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToDescStart</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- HR Lane Logic -->
    <bpmn:task id="Task_DescribeJobDesc" name="Describe Job Tasks & Requirements">
      <bpmn:incoming>SequenceFlow_FromMergeBeforeDesc</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToReviewStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Decision Point for Questions (HR) -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_CheckRequirements" name="Questions on Tasks?">
      <bpmn:incoming>SequenceFlow_FromMergeBeforeDesc</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_YesClarify</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoDescribe</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Clarification Task (Hiring Manager) -->
    <bpmn:task id="Task_ClariyDetails" name="Clarify Tasks & Requirements">
      <bpmn:incoming>SequenceFlow_YesClarify</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BackToDescStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Review Task (Hiring Manager) -->
    <bpmn:task id="Task_ReviewDescription" name="Review Job Description">
      <bpmn:incoming>SequenceFlow_ToReviewStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ApproveDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Approval Decision (Hiring Manager) -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_ApproveRequest" name="Approve Description?">
      <bpmn:incoming>SequenceFlow_ApproveDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AdvertisePath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CorrectionPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Revision Task (HR) -->
    <bpmn:task id="Task_Revisedescription" name="Revise Job Description">
      <bpmn:incoming>SequenceFlow_CorrectionPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BackToReviewStart</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Advertised" name="Vacancy Advertised">
      <bpmn:incoming>SequenceFlow_AdvertisePath</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    
    <!-- Init Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_InitReport" sourceRef="StartEvent_DetectRequirements" targetRef="Task_ReportVacancy" />
    
    <!-- To HR Lane Start (Merge) -->
    <bpmn:sequenceFlow id="SequenceFlow_ToHRStart" name="To Personnel Dept" sourceRef="Task_ReportVacancy" targetRef="InclusiveGateway_ReviewWait" />

    <!-- Merge Review to Description Logic -->
    <bpmn:sequenceFlow id="SequenceFlow_ToDescStart" sourceRef="InclusiveGateway_ReviewWait" targetRef="ExclusiveGateway_CheckRequirements" />

    <!-- HR Decision Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_YesClarify" name="Questions exist" sourceRef="ExclusiveGateway_CheckRequirements" targetRef="Task_ClariyDetails" />
    <bpmn:sequenceFlow id="SequenceFlow_NoDescribe" name="No questions" sourceRef="ExclusiveGateway_CheckRequirements" targetRef="InclusiveGateway_DescriptionMerge" />

    <!-- Clarification Loop Back -->
    <bpmn:sequenceFlow id="SequenceFlow_BackToDescStart" sourceRef="Task_ClariyDetails" targetRef="InclusiveGateway_DescriptionMerge" />

    <!-- Merge Before Description (HR) -->
    <bpmn:inclusiveGateway id="InclusiveGateway_DescriptionMerge">
      <bpmn:incoming>SequenceFlow_NoDescribe</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_BackToDescStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StartDescriptionTask</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Start Description Task -->
    <bpmn:sequenceFlow id="SequenceFlow_StartDescriptionTask" sourceRef="InclusiveGateway_DescriptionMerge" targetRef="Task_DescribeJobDesc" />

    <!-- To Review (HM) -->
    <bpmn:sequenceFlow id="SequenceFlow_ToReviewStart" name="For Review" sourceRef="Task_DescribeJobDesc" targetRef="Task_ReviewDescription" />

    <!-- Approval Decision Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_ApproveDecision" sourceRef="Task_ReviewDescription" targetRef="ExclusiveGateway_ApproveRequest" />

    <!-- Advertise Path (Success) -->
    <bpmn:sequenceFlow id="SequenceFlow_AdvertisePath" name="Approved & Advertised" sourceRef="ExclusiveGateway_ApproveRequest" targetRef="EndEvent_Advertised" />

    <!-- Correction Loop Back to Review Start -->
    <bpmn:sequenceFlow id="SequenceFlow_CorrectionPath" name="Needs Corrections" sourceRef="ExclusiveGateway_ApproveRequest" targetRef="Task_Revisedescription" />
    
    <!-- Revision Flow back to HM Merge/Review Logic -->
    <bpmn:sequenceFlow id="SequenceFlow_BackToReviewStart" sourceRef="Task_Revisedescription" targetRef="InclusiveGateway_ReviewWait" />

  </bpmn:process>
</bpmn:definitions>