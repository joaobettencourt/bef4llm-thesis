<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_IPO_Process_01" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_IPO_01">
    <bpmn:participant id="Participant_IPO" name="IPO Process Execution" processRef="Process_IPO_01" />
  </bpmn:collaboration>

  <bpmn:process id="Process_IPO_01" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Company" name="Company">
        <bpmn:flowNodeRef>StartEvent_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectUnderwriters</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Underwriter" name="Underwriters">
        <bpmn:flowNodeRef>InclusiveGateway_FactsFair</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareRegistrationBlueSky</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_WaitSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CatchEvent_SECApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RoadShowPricingEstimate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_PriceFixMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FinalizePrice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_NoReasonNotToDoIt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CommitOfferPublic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Success</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Decision" name="Decision to Go Public">
      <bpmn:outgoing>SequenceFlow_InitIPO</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Select Underwriters (Company) -->
    <bpmn:task id="Task_SelectUnderwriters" name="Select the underwriters">
      <bpmn:incoming>SequenceFlow_InitIPO</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckFacts</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Check Facts Fairness (Underwriter) -->
    <bpmn:inclusiveGateway id="InclusiveGateway_FactsFair" name="Facts presented fairly?">
      <bpmn:incoming>SequenceFlow_CheckFacts</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RejectPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ApproveRegistration</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- End Event: Rejection -->
    <bpmn:endEvent id="EndEvent_Reject" name="Underwriting Cancelled">
      <bpmn:incoming>SequenceFlow_RejectPath</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task: Registration & Blue Sky Laws (Underwriter) -->
    <bpmn:task id="Task_PrepareRegistrationBlueSky" name="Prepare registration statement&#10;Check blue-sky laws">
      <bpmn:incoming>SequenceFlow_ApproveRegistration</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StartWaitParallel</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway Split (Wait for SEC / Roadshow) -->
    <bpmn:inclusiveGateway id="InclusiveGateway_WaitSplit" name="Start Wait &amp; Show">
      <bpmn:incoming>SequenceFlow_StartWaitParallel</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitSECPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RoadShowPath</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Intermediate Catching Event for SEC Approval -->
    <bpmn:startEvent id="CatchEvent_SECApproval" name="SEC Clearance Received">
      <!-- No incoming flow defined as it is triggered externally, but referenced by Gateway outgoing in logic context. 
           For XML validity regarding Start/Catch events without explicit trigger definitions: -->
       <bpmn:outgoing>SequenceFlow_MergeToPrice</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Road Show / Pricing Estimate (Underwriter) -->
    <bpmn:task id="Task_RoadShowPricingEstimate" name="Arrange road show&#10;Firm up price estimate">
      <bpmn:incoming>SequenceFlow_RoadShowPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeToPrice</bpmn:outgoing>
    </bpmn:task>

    <!-- Merge Gateway (Wait for both paths) -->
    <bpmn:inclusiveGateway id="InclusiveGateway_PriceFixMerge">
      <bpmn:incoming>SequenceFlow_WaitSECPath</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_MergeToPrice</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FixIssuePrice</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Task: Fix Issue Price (Underwriter) -->
    <bpmn:task id="Task_FinalizePrice" name="Fix the issue price">
      <bpmn:incoming>SequenceFlow_FixIssuePrice</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckReasonNotToDoIt</bpmn:outgoing>
    </bpmn:task>

    <!-- Decision Gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_NoReasonNotToDoIt" name="Found reason not to do it?">
      <bpmn:incoming>SequenceFlow_CheckReasonNotToDoIt</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CommitPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CancelPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event: Success -->
    <bpmn:endEvent id="EndEvent_Success" name="Offer to Public">
      <bpmn:incoming>SequenceFlow_CommitPath</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_InitIPO" sourceRef="StartEvent_Decision" targetRef="Task_SelectUnderwriters" />
    
    <bpmn:sequenceFlow id="SequenceFlow_CheckFacts" sourceRef="Task_SelectUnderwriters" targetRef="InclusiveGateway_FactsFair" />

    <bpmn:sequenceFlow id="SequenceFlow_RejectPath" name="No" sourceRef="InclusiveGateway_FactsFair" targetRef="EndEvent_Reject" />
    
    <bpmn:sequenceFlow id="SequenceFlow_ApproveRegistration" name="Yes" sourceRef="InclusiveGateway_FactsFair" targetRef="Task_PrepareRegistrationBlueSky" />

    <bpmn:sequenceFlow id="SequenceFlow_StartWaitParallel" sourceRef="Task_PrepareRegistrationBlueSky" targetRef="InclusiveGateway_WaitSplit" />
    
    <!-- Note: SequenceFlow to CatchEvent is defined here for flow logic, though event has no incoming tag -->
    <bpmn:sequenceFlow id="SequenceFlow_WaitSECPath" name="Wait SEC" sourceRef="InclusiveGateway_WaitSplit" targetRef="CatchEvent_SECApproval" />

    <bpmn:sequenceFlow id="SequenceFlow_RoadShowPath" name="Road Show" sourceRef="InclusiveGateway_WaitSplit" targetRef="Task_RoadShowPricingEstimate" />
    
    <bpmn:sequenceFlow id="SequenceFlow_MergeToPrice" sourceRef="Task_RoadShowPricingEstimate" targetRef="InclusiveGateway_PriceFixMerge" />

    <!-- Note: SequenceFlow from CatchEvent to Merge Gateway -->
    <bpmn:sequenceFlow id="SequenceFlow_WaitSECPathOut" name="Clearance Received" sourceRef="CatchEvent_SECApproval" targetRef="InclusiveGateway_PriceFixMerge" />

    <bpmn:sequenceFlow id="SequenceFlow_FixIssuePrice" sourceRef="InclusiveGateway_PriceFixMerge" targetRef="Task_FinalizePrice" />
    
    <bpmn:sequenceFlow id="SequenceFlow_CheckReasonNotToDoIt" name="Check Reason" sourceRef="Task_FinalizePrice" targetRef="ExclusiveGateway_NoReasonNotToDoIt" />

    <bpmn:sequenceFlow id="SequenceFlow_CommitPath" name="No reason found" sourceRef="ExclusiveGateway_NoReasonNotToDoIt" targetRef="EndEvent_Success" />
    
    <bpmn:sequenceFlow id="SequenceFlow_CancelPath" name="Found reason" sourceRef="ExclusiveGateway_NoReasonNotToDoIt" targetRef="EndEvent_Reject" />

  </bpmn:process>
</bpmn:definitions>