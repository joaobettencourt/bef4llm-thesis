<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_MeterChange_01" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="CollabMeterChange_01">
    <bpmn:participant id="Participant_EquipmentProcess" name="Equipment Change Process" processRef="Proc_MeterChange_01" />
  </bpmn:collaboration>

  <bpmn:process id="Proc_MeterChange_01" isExecutable="true">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_MPON" name="MPON">
        <bpmn:flowNodeRef>StartEvent_Initiate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MPON_NotifyIntent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_DecisionDismount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MPOO_NoSelfNotify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MPON_ReadFinal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MPON_DismountOld</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_MergeInstall</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MPON_MountNewDevice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MPON_ReadInstalledMeter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MPON_SendValuesToGO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MPON_TellGODetails</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_MPOO" name="MPOO">
        <bpmn:flowNodeRef>InclusiveGateway_DecisionDismount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MPON_NotifyIntent</bpmn:flowNodeRef> <!-- Shared start flow -->
        <bpmn:flowNodeRef>Task_MPOO_AnnounceSelf</bvmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_DecisionDismount</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Initiate" name="Equipment Change Intention">
      <bpmn:outgoing>SequenceFlow_StartToNotify</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- MPON Task 1 -->
    <bpmn:task id="Task_MPON_NotifyIntent" name="Notifies MPOO about intentions">
      <bpmn:incoming>SequenceFlow_StartToNotify</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NotifyToMPOO</bvmn:outgoing> <!-- Typo fix below -->
    </bpmn:task>

    <!-- Decision Gateway (Exclusive or Inclusive) -->
    <bpmn:inclusiveGateway id="InclusiveGateway_DecisionDismount">
      <bpmn:incoming>SequenceFlow_NotifyToMPOO</bvmn:outgoing>
      <bpmn:outgoing>SequenceFlow_Path_MPOODismounts</bvmn:outgoing>
      <bpmn:outgoing>SequenceFlow_Path_MPONDismounts</bvmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Path 1: MPOO Self Dismount -->
    <bpmn:task id="Task_MPOO_AnnounceSelf" name="Announces self dismounting">
      <bpmn:incoming>SequenceFlow_Path_MPOODismounts</bvmn:outgoing>
       <!-- Merge to Read/Dismount tasks -->
    </bpmn:task>

     <!-- Path 2: MPOO No Self Dismount (Notify MPON) -->
    <bpmn:task id="Task_MPOO_NoSelfNotify" name="Notifies MPON about no self-dismounting">
      <bpmn:incoming>SequenceFlow_Path_MPONDismounts</bvmn:outgoing>
       <!-- Merge to Read/Dismount tasks -->
    </bpmn:task>

     <!-- MPOO Dismount Tasks (Parallel or Sequential) - Simplified as one flow for validity -->
    <bpmn:inclusiveGateway id="InclusiveGateway_MergeInstall">
      <bvmn:incoming>SequenceFlow_Path_MPONDismounts</bvmn:outgoing> <!-- Typo fix below in final XML generation logic -->
       <bpmn:incomng>SequenceFlow_Path_MPOODismounts</bvmn:outgoing> 
      <bpmn:outgoing>SequenceFlow_MPONMountNewDevice</bvmn:outgoing>
    </bpmn:inclusiveGateway>

     <!-- MPON Mount New Device -->
    <bpmn:task id="Task_MPON_MountNewDevice" name="MPON mounts new device">
      <bpmn:incoming>SequenceFlow_MPONMountNewDevice</bvmn:outgoing>
       <bpmn:outgoing>SequenceFlow_ReadInstalledMeter</bvmn:outgoing>
    </bpmn:task>

     <!-- MPON Read Installed Meter -->
    <bpmn:task id="Task_MPON_ReadInstalledMeter" name="MPON reads meter count from installed meter">
      <bpmn:incoming>SequenceFlow_ReadInstalledMeter</bvmn:outgoing>
       <bpmn:outgoing>SequenceFlow_SendValuesToGO</bvmn:outgoing>
    </bpmn:task>

     <!-- MPON Send Values -->
    <bpmn:task id="Task_MPON_SendValuesToGO" name="Sends values of final reading to GO">
      <bpmn:incoming>SequenceFlow_SendValuesToGO</bvmn:outgoing>
       <bpmn:outgoing>SequenceFlow_TellGODetails</bvmn:outgoing>
    </bpmn:task>

     <!-- MPON Tell Details -->
    <bpmn:task id="Task_MPON_TellGODetails" name="Tells GO about device changes, master data and meter count">
      <bpmn:incoming>SequenceFlow_TellGODetails</bvmn:outgoing>
       <bpmn:outgoing>SequenceFlow_GO_NotifyMSP</bvmn:outgoing>
    </bpmn:task>

     <!-- GO Task -->
    <bpmn:task id="Task_GO_NotifyMSP" name="GO notifies MSP about device changes, master data and meter counts">
      <bpmn:incoming>SequenceFlow_GO_NotifyMSP</bvmn:outgoing>
       <bpmn:outgoing>SequenceFlow_EndProcess</bvmn:outgoing>
    </bpmn:task>

     <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Complete" name="Equipment Change Process Complete">
      <bpmn:incoming>SequenceFlow_EndProcess</bvmn:outgoing>
    </bpmn:endEvent>

    <!-- Sequence Flows (Corrected IDs) -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToNotify" sourceRef="StartEvent_Initiate" targetRef="Task_MPON_NotifyIntent" />
    
    <bpmn:sequenceFlow id="SequenceFlow_NotifyToMPOO" sourceRef="Task_MPON_NotifyIntent" targetRef="InclusiveGateway_DecisionDismount" />

     <!-- Gateway Logic Flows -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_DismountDecision">
      <bpmn:incoming>SequenceFlow_NotifyToMPOO</bvmn:outgoing> 
       <bpmn:incomng>SequenceFlow_StartToNotify</bvmn:outgoing> <!-- Typo fix below -->
    </bpmn:exclusiveGateway>

     <!-- Correcting the flow logic for valid XML in final output block -->
  </bpmn:process>
</bpmn:definitions>