<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_RoomService_01" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="CollabRoomService_1">
    <bpmn:participant id="Participant_RoomServiceDept" name="The Evanstonian Room Service Dept." processRef="Proc_RoomServiceOrder_01" />
  </bpmn:collaboration>

  <bpmn:process id="Proc_RoomServiceOrder_01" isExecutable="true">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Manager" name="Room-Service Manager">
        <bpmn:flowNodeRef>StartEvent_GuestCall</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TakeOrder</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Kitchen" name="Kitchen Staff">
        <bpmn:flowNodeRef>Task_PrepareFood</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sommelier" name="Sommelier">
        <bpmn:flowNodeRef>InclusiveGateway_AlcoholCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FetchWine</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Waiter" name="Waiter">
        <bpmn:flowNodeRef>InclusiveGateway_DeliveryReady</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReadiesCart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_OrderDelivered</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_GuestCall" name="Guest Calls Room Service">
      <bpmn:outgoing>bpmn:SequenceFlow_InitOrder</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Manager Tasks -->
    <bpmn:task id="Task_TakeOrder" name="Take Down Order &amp; Submit Ticket">
      <bpmn:incoming>bpmn:SequenceFlow_InitOrder</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_SplitTasks</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Split for Kitchen, Sommelier and Waiter -->
    <bpmn:parallelGateway id="ParallelGateway_InitWork" name="Start Preparation">
      <bpmn:incoming>bpmn:SequenceFlow_SplitTasks</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_ToKitchen</bpmn:outgoing>
      <bpmn:outgoing>bpmn:SequenceFlow_ToSommelier</bpmn:outgoing>
      <bpmn:outgoing>bpmn:SequenceFlow_ToCartPrep</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Kitchen Task -->
    <bpmn:task id="Task_PrepareFood" name="Prepare Food">
      <bpmn:incoming>bpmn:SequenceFlow_ToKitchen</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_FoodReady</bpmn:outgoing>
    </bpmn:task>

    <!-- Sommelier Task (Conditional) -->
    <bpmn:inclusiveGateway id="InclusiveGateway_AlcoholCheck" name="Order Includes Alcohol?">
      <bpmn:incoming>bpmn:SequenceFlow_ToSommelier</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_FetchWinePath</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Waiter Task - Cart Preparation -->
    <bpmn:task id="Task_ReadiesCart" name="Readies Cart &amp; Non-Alcoholic Drinks">
      <bpmn:incoming>bpmn:SequenceFlow_ToCartPrep</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_CartReady</bpmn:outgoing>
    </bpmn:task>

    <!-- Delivery Gateway -->
    <bpmn:inclusiveGateway id="InclusiveGateway_DeliveryReady" name="All Ready for Delivery">
      <bpmn:incoming>bpmn:SequenceFlow_FoodReady</bpmn:incoming>
      <bpmn:incoming>bpmn:SequenceFlow_BeverageReady</bpmn:incoming>
      <bpmn:incoming>bpmn:SequenceFlow_CartReady</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_DeliverOrderPath</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_OrderDelivered" name="Order Delivered">
      <bpmn:incoming>bpmn:SequenceFlow_DeliverOrderPath</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_InitOrder" sourceRef="StartEvent_GuestCall" targetRef="Task_TakeOrder">
      <bpmn:name>Guest Calls</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_SplitTasks" sourceRef="Task_TakeOrder" targetRef="ParallelGateway_InitWork">
      <bpmn:name>Submit Order Ticket</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ToKitchen" sourceRef="ParallelGateway_InitWork" targetRef="Task_PrepareFood">
      <bpmn:name>To Kitchen</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ToSommelier" sourceRef="ParallelGateway_InitWork" targetRef="InclusiveGateway_AlcoholCheck">
      <bpmn:name>To Sommelier</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_FetchWinePath" sourceRef="InclusiveGateway_AlcoholCheck" targetRef="Task_FetchWine">
      <bpmn:name>Yes (80%)</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:task id="Task_FetchWine" name="Fetch Wine &amp; Prepare Beverages">
      <bpmn:incoming>bpmn:SequenceFlow_FetchWinePath</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_BeverageReady</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_ToCartPrep" sourceRef="ParallelGateway_InitWork" targetRef="Task_ReadiesCart">
      <bpmn:name>To Waiter Cart Prep</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_FoodReady" sourceRef="Task_PrepareFood" targetRef="InclusiveGateway_DeliveryReady">
      <bpmn:name>Food Ready</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_BeverageReady" sourceRef="Task_FetchWine" targetRef="InclusiveGateway_DeliveryReady">
      <bpmn:name>Beverages Ready</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_CartReady" sourceRef="Task_ReadiesCart" targetRef="InclusiveGateway_DeliveryReady">
      <bpmn:name>Cart &amp; Drinks Ready</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_DeliverOrderPath" sourceRef="InclusiveGateway_DeliveryReady" targetRef="EndEvent_OrderDelivered">
      <bpmn:name>All Items Ready - Deliver</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>