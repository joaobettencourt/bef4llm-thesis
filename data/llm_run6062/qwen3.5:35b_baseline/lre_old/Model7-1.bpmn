<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_SalesProcess_01" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="CollabSalesProcess_1">
    <bpmn:participant id="Participant_SalesDept" name="Sales Department" processRef="Proc_SalesLeads_01" />
  </bpmn:collaboration>

  <bpmn:process id="Proc_SalesLeads_01" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Manager" name="Manager">
        <bpmn:flowNodeRef>StartEvent_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckLeads</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectTopFive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_MoreLeads</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SalesAssistant" name="Sales Assistant">
        <bpmn:flowNodeRef>Task_CallCustomer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_Interested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendNote</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Start" name="Process Starts">
      <bpmn:outgoing>SequenceFlow_Init</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Manager Tasks -->
    <bpmn:task id="Task_CheckLeads" name="Check open leads">
      <bpmn:incoming>SequenceFlow_Init</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SelectFive</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_SelectTopFive" name="Select top five leads">
      <bpmn:incoming>SequenceFlow_SelectFive</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckLoopStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Loop Control Gateway -->
    <bpmn:inclusiveGateway id="InclusiveGateway_MoreLeads">
      <bpmn:incoming>SequenceFlow_ProcessLeadBack</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CallNextCustomer</bpmn:outgoing>
      <!-- Implicit exit to EndEvent via SequenceFlow_ExitProcess -->
    </bpmn:inclusiveGateway>

    <!-- Sales Assistant Tasks & Gateway -->
    <bpmn:task id="Task_CallCustomer" name="Call contact person">
      <bpmn:incoming>SequenceFlow_CallNextCustomer</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckInterest</bpmn:outgoing>
    </bpmn:task>

    <bpmn:inclusiveGateway id="InclusiveGateway_Interested">
      <bpmn:incoming>SequenceFlow_CheckInterest</bpmn:incoming>
      <!-- Paths handled via SequenceFlows -->
    </bpmn:inclusiveGateway>

    <bpmn:endEvent id="EndEvent_ProcessComplete" name="All Leads Processed">
       <bpmn:outgoing /> 
    </bpmn:endEvent>

    <!-- Flow Logic for Loop and Interest Check -->
    
    <!-- SequenceFlow from Manager to Assistant Lane Start of Loop -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckLoopStart" sourceRef="Task_SelectTopFive" targetRef="InclusiveGateway_MoreLeads">
      <bpmn:name>Check for leads</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- SequenceFlow from Loop Gateway to Call Task -->
    <bpmn:sequenceFlow id="SequenceFlow_CallNextCustomer" sourceRef="InclusiveGateway_MoreLeads" targetRef="Task_CallCustomer">
      <bpmn:name>If leads exist</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- SequenceFlow from Call to Interest Gateway -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckInterest" sourceRef="Task_CallCustomer" targetRef="InclusiveGateway_Interested">
      <bpmn:name>Contact made</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Path 1: Interested -->
    <bpmn:task id="Task_SendNote" name="Send note to Manager">
       <bpmn:incoming>SequenceFlow_PathInterested</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_ProcessLead</bpmn:outgoing>
    </bpmn:task>

    <!-- Path 2: Not Interested (Loop back to Call) -->
    <bpmn:sequenceFlow id="SequenceFlow_PathNotInterested" sourceRef="InclusiveGateway_Interested" targetRef="Task_CallCustomer">
      <bpmn:name>No interest</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Path 1 Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_PathInterested" name="Interested?" sourceRef="InclusiveGateway_Interested" targetRef="Task_SendNote">
      <bpmn:name>If interested</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Process Lead Task (Manager) -->
    <bpmn:task id="Task_ProcessLead" name="Process lead">
       <bpmn:incoming>SequenceFlow_ProcessLead</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_LoopBackToCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Loop Back to Check More Leads -->
    <bpmn:sequenceFlow id="SequenceFlow_ProcessLead" sourceRef="Task_SendNote" targetRef="Task_ProcessLead">
      <bpmn:name>Send Note</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Loop Back to Check More Leads -->
    <bpmn:sequenceFlow id="SequenceFlow_LoopBackToCheck" sourceRef="Task_ProcessLead" targetRef="InclusiveGateway_MoreLeads">
      <bpmn:name>Continue</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Initial Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_Init" name="Start Process" sourceRef="StartEvent_Start" targetRef="Task_CheckLeads">
      <bpmn:name />
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>