<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_VacationRequest_01" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_VacationProcess_1">
    <bpmn:participant id="Participant_Process" name="Vacation Request Process" processRef="Proc_VacationRequest_01" />
  </bpmn:collaboration>

  <bpmn:process id="Proc_VacationRequest_01" isExecutable="true">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Employee" name="Employee">
        <bpmn:flowNodeRef>StartEvent_Submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewRejection</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Supervisor" name="Supervisor">
        <bpmn:flowNodeRef>InclusiveGateway_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProcessRequest</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_HR" name="Human Resources Representative">
        <bpmn:flowNodeRef>Task_CompleteProcedures</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Submit" name="Vacation Request Submitted">
      <bpmn:outgoing>SequenceFlow_InitRequest</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Employee Task -->
    <bpmn:task id="Task_ReviewRejection" name="Review Rejection Reasons">
      <bpmn:incoming>SequenceFlow_ReturnRejected</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndDenied</bpmn:outgoing>
    </bpmn:task>

    <!-- Supervisor Task -->
    <bpmn:task id="Task_ProcessRequest" name="Process Vacation Request">
      <bpmn:incoming>SequenceFlow_InitRequest</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Decision Gateway -->
    <bpmn:exclusiveGateway id="InclusiveGateway_Decision" name="Approve Request">
      <bpmn:incoming>SequenceFlow_ToDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ApprovedPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RejectedPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- HR Task -->
    <bpmn:task id="Task_CompleteProcedures" name="Complete Management Procedures">
      <bpmn:incoming>SequenceFlow_ApprovedPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndSuccess</bpmn:outgoing>
    </bpmn:task>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_Denied" name="Request Denied">
      <bpmn:incoming>SequenceFlow_EndDenied</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_Success" name="Vacation Processed">
      <bpmn:incoming>SequenceFlow_EndSuccess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_InitRequest" sourceRef="StartEvent_Submit" targetRef="Task_ProcessRequest">
      <bpmn:name>Submit Request</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ToDecision" sourceRef="Task_ProcessRequest" targetRef="InclusiveGateway_Decision" />

    <bpmn:sequenceFlow id="SequenceFlow_ApprovedPath" name="Approved" sourceRef="InclusiveGateway_Decision" targetRef="Task_CompleteProcedures">
      <bpmn:name>Approval Granted</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_RejectedPath" name="Rejected" sourceRef="InclusiveGateway_Decision" targetRef="Task_ReviewRejection">
      <bpmn:name>Request Rejected</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_EndDenied" name="End Denied" sourceRef="Task_ReviewRejection" targetRef="EndEvent_Denied">
      <bpmn:name>Process Ended</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_EndSuccess" name="Complete Procedures" sourceRef="Task_CompleteProcedures" targetRef="EndEvent_Success">
      <bpmn:name>Process Complete</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>