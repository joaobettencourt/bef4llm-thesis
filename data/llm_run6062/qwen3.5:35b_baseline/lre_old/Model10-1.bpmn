<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_Dismissal_01" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_Dismissal_Process">
    <bpmn:participant id="Participant_DismissalProcess" name="Dismissal Process Management" processRef="Proc_Dismissal_01" />
  </bpmn:collaboration>

  <bpmn:process id="Proc_Dismissal_01" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_MPON" name="MPON">
        <bpmn:flowNodeRef>StartEvent_Initiate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendDismissal</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_MPOO" name="MPOO">
        <bpmn:flowNodeRef>InclusiveGateway_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewDismissal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Opposed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Confirmed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Initiate" name="Dismissal Initiated">
      <bpmn:outgoing>SequenceFlow_StartToSend</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: MPON sends dismissal -->
    <bpmn:task id="Task_SendDismissal" name="Send Dismissal to MPOO">
      <bpmn:incoming>SequenceFlow_StartToSend</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendToReview</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: MPOO reviews dismissal -->
    <bpmn:task id="Task_ReviewDismissal" name="Review Dismissal">
      <bpmn:incoming>SequenceFlow_SendToReview</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReviewToDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for Decision -->
    <bpmn:exclusiveGateway id="InclusiveGateway_Decision" name="Dismissal Outcome">
      <bpmn:incoming>SequenceFlow_ReviewToDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OutcomeOpposed</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_OutcomeConfirmed</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event 1: Opposes -->
    <bpmn:endEvent id="EndEvent_Opposed" name="Dismissal Opposed">
      <bpmn:incoming>SequenceFlow_OutcomeOpposed</bpmn:incoming>
    </bpmn:endEvent>

    <!-- End Event 2: Confirms -->
    <bpmn:endEvent id="EndEvent_Confirmed" name="Dismissal Confirmed">
      <bpmn:incoming>SequenceFlow_OutcomeConfirmed</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToSend" sourceRef="StartEvent_Initiate" targetRef="Task_SendDismissal">
      <bpmn:name>Initiated</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_SendToReview" name="Sent to MPOO" sourceRef="Task_SendDismissal" targetRef="Task_ReviewDismissal">
      <!-- Implicitly crosses lanes -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ReviewToDecision" sourceRef="Task_ReviewDismissal" targetRef="InclusiveGateway_Decision">
       <bpmn:name>Ready for Decision</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_OutcomeOpposed" name="MPOO Opposes" sourceRef="InclusiveGateway_Decision" targetRef="EndEvent_Opposed">
      <!-- Condition expression would go here -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_OutcomeConfirmed" name="MPOO Confirms" sourceRef="InclusiveGateway_Decision" targetRef="EndEvent_Confirmed">
       <!-- Condition expression would go here -->
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>