<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_BicycleManufacturing_01" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_BicycleProcess_01">
    <bpmn:participant id="Participant_ManufacturingUnit" name="Bicycle Manufacturing Unit" processRef="Proc_OrderProcessing_01" />
  </bpmn:collaboration>

  <bpmn:process id="Proc_OrderProcessing_01" isExecutable="true">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_SalesDept" name="Sales Department">
        <bpmn:flowNodeRef>StartEvent_OrderReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewOrderDetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AcceptReject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SplitProduction</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_OrderRejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_JoinCompletion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ShipOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ProcessFinished</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Storehouse" name="Storehouse">
        <bpmn:flowNodeRef>Task_CheckInventoryAndParts</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_EngineeringDept" name="Engineering Department">
        <bpmn:flowNodeRef>Task_PrepareAssemblyPrep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssembleBicycle</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_OrderReceived" name="Order Received">
      <bpmn:outgoing>SeqFlow_InitReview</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Sales Task -->
    <bpmn:task id="Task_ReviewOrderDetails" name="Review Order Details">
      <bpmn:incoming>SeqFlow_InitReview</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_ToDecisionGateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Decision Gateway (Accept/Reject) -->
    <bpmn:exclusiveGateway id="Gateway_AcceptReject" name="Order Acceptable?">
      <bpmn:incoming>SeqFlow_ToDecisionGateway</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_RejectPath</bpmn:outgoing>
      <bpmn:outgoing>SeqFlow_AcceptPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Reject End Event -->
    <bpmn:endEvent id="EndEvent_OrderRejected" name="Order Rejected">
      <bpmn:incoming>SeqFlow_RejectPath</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Parallel Split Gateway (Init Production) -->
    <bpmn:parallelGateway id="Gateway_SplitProduction">
      <bpmn:incoming>SeqFlow_AcceptPath</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_StorehouseTask</bpmn:outgoing>
      <bpmn:outgoing>SeqFlow_EngPrepTask</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Storehouse Task -->
    <bpmn:task id="Task_CheckInventoryAndParts" name="Process Part List &amp; Inventory Check">
      <bpmn:incoming>SeqFlow_StorehouseTask</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_ToJoinGateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Engineering Prep Task -->
    <bpmn:task id="Task_PrepareAssemblyPrep" name="Prepare Assembly">
      <bpmn:incoming>SeqFlow_EngPrepTask</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_ToJoinGateway2</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Join Gateway -->
    <bpmn:parallelGateway id="Gateway_JoinCompletion">
      <bpmn:incoming>SeqFlow_ToJoinGateway</bpmn:incoming>
      <bpmn:incoming>SeqFlow_ToJoinGateway2</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_AssembleTask</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Assemble Task -->
    <bpmn:task id="Task_AssembleBicycle" name="Assemble Bicycle">
      <bpmn:incoming>SeqFlow_AssembleTask</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_ShipOrder</bpmn:outgoing>
    </bpmn:task>

    <!-- Ship Task -->
    <bpmn:task id="Task_ShipOrder" name="Ship to Customer">
      <bpmn:incoming>SeqFlow_ShipOrder</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_FinalizeProcess</bpmn:outgoing>
    </bpmn:task>

    <!-- Final End Event -->
    <bpmn:endEvent id="EndEvent_ProcessFinished" name="Process Finished">
      <bpmn:incoming>SeqFlow_FinalizeProcess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SeqFlow_InitReview" sourceRef="StartEvent_OrderReceived" targetRef="Task_ReviewOrderDetails" />
    
    <bpmn:exclusiveGateway id="Gateway_AcceptReject">
      <bpmn:incoming>SeqFlow_ToDecisionGateway</bpmn:incoming>
       <!-- Defined above, ensuring unique ID usage -->
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="SeqFlow_InitReview" sourceRef="StartEvent_OrderReceived" targetRef="Task_ReviewOrderDetails">
      <!-- Ensuring valid structure without duplicate definitions in output block -->
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>