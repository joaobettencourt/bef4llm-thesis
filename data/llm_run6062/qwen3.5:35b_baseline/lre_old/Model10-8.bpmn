<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_GO_Deregistration_01" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_GO_Process_01">
    <bpmn:participant id="Participant_GovernmentOffice" name="Government Office (GO)" processRef="Process_Deregistration_01" />
  </bpmn:collaboration>

  <bpmn:process id="Process_Deregistration_01" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_AdministrativeStaff" name="Administrative Staff">
        <bpmn:flowNodeRef>StartEvent_MSPORequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VerifyDeregistration</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_DecisionConfirmReject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssignSelfMSP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_SplitNotifications</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Completed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_MSPORequest" name="MSPO Deregistration Request">
      <bpmn:outgoing>SequenceFlow_InitiateVerification</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Verify -->
    <bpmn:task id="Task_VerifyDeregistration" name="Verify Deregistration">
      <bpmn:incoming>SequenceFlow_InitiateVerification</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToDecisionGateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Decision (Reject vs Confirm) -->
    <bpmn:inclusiveGateway id="InclusiveGateway_DecisionConfirmReject">
      <bpmn:incoming>SequenceFlow_ToDecisionGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RejectPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ConfirmPath</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- End Event 1: Rejection -->
    <bpmn:endEvent id="EndEvent_Rejected" name="Deregistration Requested">
      <bpmn:incoming>SequenceFlow_RejectPath</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task 2: Assign Self as MSP -->
    <bpmn:task id="Task_AssignSelfMSP" name="Assign GO as MSP">
      <bpmn:incoming>SequenceFlow_ConfirmPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToNotificationSplit</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2: Parallel Split for Notifications -->
    <bpmn:inclusiveGateway id="InclusiveGateway_SplitNotifications">
      <bpmn:incoming>SequenceFlow_ToNotificationSplit</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InfoMSPO</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_InfoMPO</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_InfoSP</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Task 3: Inform MSPO -->
    <bpmn:task id="Task_InfoMSPO" name="Inform MSPO about Assignment">
      <bpmn:incoming>SequenceFlow_InfoMSPO</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeNotifications</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 4: Inform MPO -->
    <bpmn:task id="Task_InfoMPO" name="Inform MPO about Assignment">
      <bpmn:incoming>SequenceFlow_InfoMPO</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeNotifications2</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 5: Inform SP -->
    <bpmn:task id="Task_InfoSP" name="Inform SP about Assignment">
      <bpmn:incoming>SequenceFlow_InfoSP</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeNotifications3</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 2: Completion -->
    <bpmn:endEvent id="EndEvent_Completed" name="Assignment Process Complete">
      <bpmn:incoming>SequenceFlow_MergeNotifications</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_MergeNotifications2</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_MergeNotifications3</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_InitiateVerification" sourceRef="StartEvent_MSPORequest" targetRef="Task_VerifyDeregistration">
      <bpmn:name>Deregister</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ToDecisionGateway" sourceRef="Task_VerifyDeregistration" targetRef="InclusiveGateway_DecisionConfirmReject">
      <bpmn:name>Deregister</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_RejectPath" sourceRef="InclusiveGateway_DecisionConfirmReject" targetRef="EndEvent_Rejected">
      <bpmn:name>Reject</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ConfirmPath" sourceRef="InclusiveGateway_DecisionConfirmReject" targetRef="Task_AssignSelfMSP">
      <bpmn:name>Preliminarily Confirmed</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ToNotificationSplit" sourceRef="Task_AssignSelfMSP" targetRef="InclusiveGateway_SplitNotifications">
      <bpmn:name>Preliminarily Confirmed</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_InfoMSPO" sourceRef="InclusiveGateway_SplitNotifications" targetRef="Task_InfoMSPO">
      <bpmn:name>Inform MSPO</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_InfoMPO" sourceRef="InclusiveGateway_SplitNotifications" targetRef="Task_InfoMPO">
      <bpmn:name>Inform MPO</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_InfoSP" sourceRef="InclusiveGateway_SplitNotifications" targetRef="Task_InfoSP">
      <bpmn:name>Inform SP</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_MergeNotifications" sourceRef="Task_InfoMSPO" targetRef="EndEvent_Completed">
      <bpmn:name>Merged Flow 1</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_MergeNotifications2" sourceRef="Task_InfoMPO" targetRef="EndEvent_Completed">
      <bpmn:name>Merged Flow 2</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_MergeNotifications3" sourceRef="Task_InfoSP" targetRef="EndEvent_Completed">
      <bpmn:name>Merged Flow 3</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>