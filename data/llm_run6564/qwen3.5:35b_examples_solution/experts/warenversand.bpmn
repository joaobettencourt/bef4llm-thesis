<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Warenversand&#10;Hardware-Händler" processRef="Process_1" />
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Sekretariat" name="Sekretariat">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VersandartKlaeren</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Sonderversand</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_Versicherung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MergeSecretary</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Logistikleiter" name="Leiter Logistik">
        <bpmn:flowNodeRef>Task_VersicherungAbschliessen</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Lagerarbeiter" name="Lagerarbeiter">
        <bpmn:flowNodeRef>Task_WareVerpacken</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MergeAll</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Bereitstellen</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Ware zu versenden">
      <bpmn:outgoing>SequenceFlow_Start</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Parallel Gateway for concurrent processes (Secretary & Warehouse) -->
    <bpmn:parallelGateway id="ParallelGateway_Aufteilung" name="">
      <bpmn:incoming>SequenceFlow_Start</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_VersandartKlaeren</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_WareVerpacken</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Secretary Tasks -->
    <bpmn:task id="Task_VersandartKlaeren" name="Versandart klären">
      <bpmn:incoming>SequenceFlow_VersandartKlaeren</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SonderversandCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway for Special Shipment Decision -->
    <bpmn:exclusiveGateway id="Gateway_Sonderversand" name="Sonderversand?">
      <bpmn:incoming>SequenceFlow_SonderversandCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AngeboteEinholen</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PaketscheinAusfuellen</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Secretary Task for Package Form -->
    <bpmn:task id="Task_PaketscheinAusfuellen" name="Paketschein ausfüllen">
      <bpmn:incoming>SequenceFlow_PaketscheinAusfuellen</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_VersicherungCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Inclusive Gateway for Insurance Decision -->
    <bpmn:inclusiveGateway id="InclusiveGateway_Versicherung" name="Versicherung erforderlich?">
      <bpmn:incoming>SequenceFlow_VersicherungCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_VersicherungAbschliessen</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_MergeSecretaryNoInsure</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Logistics Manager Task for Insurance -->
    <bpmn:task id="Task_VersicherungAbschliessen" name="Versicherung abschließen">
      <bpmn:incoming>SequenceFlow_VersicherungAbschliessen</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeSecretaryInsure</bpmn:outgoing>
    </bpmn:task>

    <!-- Merge Gateway for Secretary Paths (Special vs Normal) -->
    <bpmn:exclusiveGateway id="Gateway_MergeSecretary" name="">
      <bpmn:incoming>SequenceFlow_SonderversandEnde</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_MergeSecretaryNoInsure</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeAllCheck</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Warehouse Worker Task for Packing -->
    <bpmn:task id="Task_WareVerpacken" name="Ware verpacken">
      <bpmn:incoming>SequenceFlow_WareVerpacken</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_MergeAllCheckWarehouse</bpmn:outgoing>
    </bpmn:task>

    <!-- Special Shipment Tasks (Secretary) -->
    <bpmn:task id="Task_AngeboteEinholen" name="Angebote von 3 Spediteuren einholen">
      <bpmn:incoming>SequenceFlow_AngeboteEinholen</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_BeauftragenCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Special Shipment Task (Secretary) -->
    <bpmn:task id="Task_Beauftragen" name="Spediteur beauftragen">
      <bpmn:incoming>SequenceFlow_BeauftragenCheck</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SonderversandEnde</bpmn:outgoing>
    </bpmn:task>

    <!-- Final Merge Gateway (All Paths) -->
    <bpmn:exclusiveGateway id="Gateway_MergeAll" name="">
      <bpmn:incoming>SequenceFlow_MergeSecretaryInsure</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_SonderversandEnde</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BereitstellenCheck</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Warehouse Worker Task for Preparation -->
    <bpmn:task id="Task_Bereitstellen" name="Ware zur Abholung bereitstellen">
      <bpmn:incoming>SequenceFlow_MergeAllCheck</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_EndEvent</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_1" name="Warenversand vorbereitet">
      <bpmn:incoming>SequenceFlow_EndEvent</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_Start" sourceRef="StartEvent_1" targetRef="ParallelGateway_Aufteilung" />
    <bpmn:sequenceFlow id="SequenceFlow_VersandartKlaeren" name="" sourceRef="ParallelGateway_Aufteilung" targetRef="Task_VersandartKlaeren" />
    <bpmn:sequenceFlow id="SequenceFlow_WareVerpacken" name="" sourceRef="ParallelGateway_Aufteilung" targetRef="Task_WareVerpacken" />

    <!-- Secretary Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_SonderversandCheck" name="" sourceRef="Task_VersandartKlaeren" targetRef="Gateway_Sonderversand" />
    <bpmn:sequenceFlow id="SequenceFlow_AngeboteEinholen" name="ja (große Mengen)" sourceRef="Gateway_Sonderversand" targetRef="Task_AngeboteEinholen" />
    <bpmn:sequenceFlow id="SequenceFlow_PaketscheinAusfuellen" name="nein (kleine Mengen)" sourceRef="Gateway_Sonderversand" targetRef="Task_PaketscheinAusfuellen" />

    <!-- Insurance Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_VersicherungCheck" name="" sourceRef="Task_PaketscheinAusfuellen" targetRef="InclusiveGateway_Versicherung" />
    <bpmn:sequenceFlow id="SequenceFlow_VersicherungAbschliessen" name="ja (erforderlich)" sourceRef="InclusiveGateway_Versicherung" targetRef="Task_VersicherungAbschliessen" />

    <!-- Merge Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_MergeSecretaryNoInsure" name="" sourceRef="InclusiveGateway_Versicherung" targetRef="Gateway_MergeAll" />
    <bpmn:sequenceFlow id="SequenceFlow_SonderversandEnde" name="" sourceRef="Task_Beauftragen" targetRef="Gateway_MergeAll" />

    <!-- Final Merge Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_MergeSecretaryInsure" name="" sourceRef="Task_VersicherungAbschliessen" targetRef="Gateway_MergeAll" />
    <bpmn:sequenceFlow id="SequenceFlow_BereitstellenCheck" name="" sourceRef="Gateway_MergeAll" targetRef="Task_Bereitstellen" />

    <!-- End Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_EndEvent" name="" sourceRef="Task_Bereitstellen" targetRef="EndEvent_1" />

  </bpmn:process>
</bpmn:definitions>