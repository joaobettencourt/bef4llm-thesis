<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Unbedenklichkeitsbescheinigung Prozess" processRef="Process_1" />
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:laneSet id="LaneSet_01">
      <bpmn:lane id="Lane_System" name="System/Service Tasks">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InitData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CheckIdentity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_CheckRole</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CheckEmployer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_CheckInsuranceTimes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_CheckContributionsCount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_UncertaintyCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_CheckEstimates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_CheckOutstandingClaims</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Assessment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_FullStanding</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_PartialStanding</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Manual" name="Manuelle Bearbeitung">
        <bpmn:flowNodeRef>UserTask_CreateLetterIdentity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_CreateLetterRole</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_TransferCase</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ManualHandling</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Processing" name="Bearbeitung &amp; Historie">
        <bpmn:flowNodeRef>UserTask_IssueCertificateFull</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_LogHistory1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_IssueCertificatePartial</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_LogHistory2</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Anfrage Eingang">
      <bpmn:outgoing>SequenceFlow_Init</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Initialization Task (Lane System) -->
    <bpmn:serviceTask id="Task_InitData" name="System initialisieren &amp; Zähler setzen">
      <bpmn:incoming>SequenceFlow_Init</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckIdentity</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Identity Check Gateway (Lane System) -->
    <bpmn:exclusiveGateway id="Gateway_CheckIdentity" name="Person im System?">
      <bpmn:incoming>SequenceFlow_CheckIdentity</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_YesIdentity</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoIdentity</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Identity Check - No Path (Lane Manual) -->
    <bpmn:userTask id="UserTask_CreateLetterIdentity" name="Anschreiben zur Info-Einholung erstellen">
      <bpmn:incoming>SequenceFlow_NoIdentity</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ManualEnd1</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Identity Check - Yes Path (Lane System) -->
    <bpmn:sequenceFlow id="SequenceFlow_YesIdentity" name="Ja" sourceRef="Gateway_CheckIdentity" targetRef="ServiceTask_CheckRole">
      <bpmn:dataState xsi:nil="true"/>
    </bpmn:sequenceFlow>

    <!-- Role Check Task (Lane System) -->
    <bpmn:serviceTask id="ServiceTask_CheckRole" name="Rolle des Absenders prüfen (Arbeitgeber)">
      <bpmn:incoming>SequenceFlow_YesIdentity</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RoleCheckOut</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Role Check Gateway (Lane System) -->
    <bpmn:exclusiveGateway id="Gateway_CheckEmployer" name="Arbeitgeber Rolle?">
      <bpmn:incoming>SequenceFlow_RoleCheckOut</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_YesRole</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoRole</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Role Check - No Path (Lane Manual) -->
    <bpmn:userTask id="UserTask_CreateLetterRole" name="Anschreiben zur Info-Einholung erstellen">
      <bpmn:incoming>SequenceFlow_NoRole</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ManualEnd2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Role Check - Yes Path (Lane System) -->
    <bpmn:sequenceFlow id="SequenceFlow_YesRole" name="Ja" sourceRef="Gateway_CheckEmployer" targetRef="ServiceTask_CheckInsuranceTimes">
      <bpmn:dataState xsi:nil="true"/>
    </bpmn:sequenceFlow>

    <!-- Check Insurance Times (Lane System) -->
    <bpmn:serviceTask id="ServiceTask_CheckInsuranceTimes" name="Versicherungszeiten &amp; Meldezeitraum prüfen">
      <bpmn:incoming>SequenceFlow_YesRole</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ContributionsCount</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Check Contributions Count (Lane System) -->
    <bpmn:serviceTask id="ServiceTask_CheckContributionsCount" name="Anzahl Beitragsnachweise prüfen">
      <bpmn:incoming>SequenceFlow_ContributionsCount</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_UncertaintyCheckIn</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Uncertainty Check Gateway (Lane System) -->
    <bpmn:exclusiveGateway id="Gateway_UncertaintyCheck" name="Unsicherheit Beitragshöhe?">
      <bpmn:incoming>SequenceFlow_UncertaintyCheckIn</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckEstimatesYes</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CheckOutstandingClaims</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Check Estimates (Lane System) -->
    <bpmn:serviceTask id="ServiceTask_CheckEstimates" name="Beitragsschätzungen prüfen (0,00 € Nachweise)">
      <bpmn:incoming>SequenceFlow_CheckEstimatesYes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConvergeToClaimsCheck</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Converging Flow for Claims Check -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckOutstandingClaims" name="Nein / Weiterleitung" sourceRef="Gateway_UncertaintyCheck" targetRef="ServiceTask_CheckOutstandingClaims">
      <bpmn:dataState xsi:nil="true"/>
    </bpmn:sequenceFlow>

    <!-- Check Outstanding Claims (Lane System) -->
    <bpmn:serviceTask id="ServiceTask_CheckOutstandingClaims" name="Offene Forderungen prüfen">
      <bpmn:incoming>SequenceFlow_ConvergeToClaimsCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AssessmentIn</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Assessment Gateway (Lane System) -->
    <bpmn:exclusiveGateway id="Gateway_Assessment" name="Bewertung Unbedenklichkeit">
      <bpmn:incoming>SequenceFlow_AssessmentIn</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FullStanding</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PartialStanding</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NotMet</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Full Standing Path (Lane Processing) -->
    <bpmn:userTask id="UserTask_IssueCertificateFull" name="Unbedenklichkeitsbescheinigung ausstellen">
      <bpmn:incoming>SequenceFlow_FullStanding</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_LogHistory1In</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Log History 1 (Lane Processing) -->
    <bpmn:userTask id="UserTask_LogHistory1" name="Eintrag in Kontakthistorie">
      <bpmn:incoming>SequenceFlow_LogHistory1In</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndFull</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Partial Standing Path (Lane Processing) -->
    <bpmn:userTask id="UserTask_IssueCertificatePartial" name="Bescheinigung mit Hinweis ausstellen">
      <bpmn:incoming>SequenceFlow_PartialStanding</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_LogHistory2In</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Log History 2 (Lane Processing) -->
    <bpmn:userTask id="UserTask_LogHistory2" name="Eintrag in Kontakthistorie">
      <bpmn:incoming>SequenceFlow_LogHistory2In</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndPartial</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Not Met Path (Lane Manual) -->
    <bpmn:userTask id="UserTask_TransferCase" name="Fall an Sachbearbeiter übergeben">
      <bpmn:incoming>SequenceFlow_NotMet</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndManual</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_FullStanding" name="Unbedenklichkeit bestätigt">
      <bpmn:incoming>SequenceFlow_EndFull</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_PartialStanding" name="Bescheinigung mit Hinweis erstellt">
      <bpmn:incoming>SequenceFlow_EndPartial</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_ManualHandling" name="Fall zur manuellen Bearbeitung übergeben">
      <bpmn:incoming>SequenceFlow_EndManual</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_Init" sourceRef="StartEvent_1" targetRef="Task_InitData">
      <bpmn:dataState xsi:nil="true"/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_CheckIdentity" name="System initialisiert" sourceRef="Task_InitData" targetRef="Gateway_CheckIdentity">
      <bpmn:dataState xsi:nil="true"/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_NoIdentity" name="Nein (Info fehlt)" sourceRef="Gateway_CheckIdentity" targetRef="UserTask_CreateLetterIdentity">
      <bpmn:dataState xsi:nil="true"/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ManualEnd1" name="" sourceRef="UserTask_CreateLetterIdentity" targetRef="EndEvent_ManualHandling">
      <bpmn:dataState xsi:nil="true"/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_RoleCheckOut" name="" sourceRef="ServiceTask_CheckRole" targetRef="Gateway_CheckEmployer">
      <bpmn:dataState xsi:nil="true"/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_NoRole" name="Nein (Keine Arbeitgeber Rolle)" sourceRef="Gateway_CheckEmployer" targetRef="UserTask_CreateLetterRole">
      <bpmn:dataState xsi:nil="true"/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ManualEnd2" name="" sourceRef="UserTask_CreateLetterRole" targetRef="EndEvent_ManualHandling">
      <bpmn:dataState xsi:nil="true"/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ContributionsCount" name="" sourceRef="ServiceTask_CheckInsuranceTimes" targetRef="ServiceTask_CheckContributionsCount">
      <bpmn:dataState xsi:nil="true"/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_UncertaintyCheckIn" name="" sourceRef="ServiceTask_CheckContributionsCount" targetRef="Gateway_UncertaintyCheck">
      <bpmn:dataState xsi:nil="true"/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_CheckEstimatesYes" name="Ja (Unsicherheit)" sourceRef="Gateway_UncertaintyCheck" targetRef="ServiceTask_CheckEstimates">
      <bpmn:dataState xsi:nil="true"/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ConvergeToClaimsCheck" name="" sourceRef="ServiceTask_CheckEstimates" targetRef="ServiceTask_CheckOutstandingClaims">
      <bpmn:dataState xsi:nil="true"/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_AssessmentIn" name="" sourceRef="ServiceTask_CheckOutstandingClaims" targetRef="Gateway_Assessment">
      <bpmn:dataState xsi:nil="true"/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_FullStanding" name="Vollständige Unbedenklichkeit" sourceRef="Gateway_Assessment" targetRef="UserTask_IssueCertificateFull">
      <bpmn:dataState xsi:nil="true"/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_LogHistory1In" name="" sourceRef="UserTask_IssueCertificateFull" targetRef="UserTask_LogHistory1">
      <bpmn:dataState xsi:nil="true"/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_EndFull" name="" sourceRef="UserTask_LogHistory1" targetRef="EndEvent_FullStanding">
      <bpmn:dataState xsi:nil="true"/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_PartialStanding" name="Offene Beträge / Kein Hinweis" sourceRef="Gateway_Assessment" targetRef="UserTask_IssueCertificatePartial">
      <bpmn:dataState xsi:nil="true"/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_LogHistory2In" name="" sourceRef="UserTask_IssueCertificatePartial" targetRef="UserTask_LogHistory2">
      <bpmn:dataState xsi:nil="true"/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_EndPartial" name="" sourceRef="UserTask_LogHistory2" targetRef="EndEvent_PartialStanding">
      <bpmn:dataState xsi:nil="true"/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_NotMet" name="Voraussetzungen nicht erfüllt" sourceRef="Gateway_Assessment" targetRef="UserTask_TransferCase">
      <bpmn:dataState xsi:nil="true"/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_EndManual" name="" sourceRef="UserTask_TransferCase" targetRef="EndEvent_ManualHandling">
      <bpmn:dataState xsi:nil="true"/>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>