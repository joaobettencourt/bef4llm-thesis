<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Betriebliche Gesundheitsförderung - Ein-Jahres-Programm" processRef="Process_1" />
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Teilnehmer" name="Teilnehmer">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AppEinweisung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WearableEinweisung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ZwischenCheckEvent</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Gesundheitscoaches" name="Gesundheitscoaches">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TrainingsplanErstellen</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Sportmediziner" name="Sportmedizinische Betreuung">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GesundheitsCheck</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Programmstart">
      <bpmn:outgoing>SequenceFlow_Start</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Health Check Task (Sportmedizinische Betreuung) -->
    <bpmn:task id="Task_GesundheitsCheck" name="Gesundheits-Check durchführen">
      <bpmn:incoming>SequenceFlow_Start</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_HealthDataCollected</bpmn:outgoing>
    </bpmn:task>

    <!-- App & Wearable Instruction Tasks (Teilnehmer) -->
    <bpmn:task id="Task_AppEinweisung" name="App-Einweisung">
      <bpmn:incoming>SequenceFlow_Start</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TrainingDataCollectionStarts</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_WearableEinweisung" name="Wearable-Einweisung">
      <bpmn:incoming>SequenceFlow_Start</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TrainingDataCollectionStarts</bpmn:outgoing>
    </bpmn:task>

    <!-- Health Coach Task -->
    <bpmn:task id="Task_TrainingsplanErstellen" name="Individuellen Trainings- und Ernährungsplan erstellen">
      <bpmn:incoming>SequenceFlow_HealthDataCollected</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PlanDelivered</bpmn:outgoing>
    </bpmn:task>

    <!-- Training Phase 1 Gateway -->
    <bpmn:exclusiveGateway id="Gateway_Trainingsphase1_6Monate" name="Trainingsphase von 6 Monaten durchlaufen?">
      <bpmn:incoming>SequenceFlow_PlanDelivered</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MidPointCheck</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Mid-point Check Event -->
    <bpmn:intermediateCatchEvent id="ZwischenCheckEvent" name="Zwischen-Check nach 6 Monaten">
      <bpmn:incoming>SequenceFlow_MidPointCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GroupDivision</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Group Division Gateway -->
    <bpmn:exclusiveGateway id="Gateway_GroupDivision" name="Gruppeneinteilung">
      <bpmn:incoming>SequenceFlow_GroupDivision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NoWearablesGroup</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_WithWearablesGroup</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Training Phase 2 Tasks -->
    <bpmn:task id="Task_TrainingWithoutWearables" name="Eigenständig trainieren (ohne Wearables)">
      <bpmn:incoming>SequenceFlow_NoWearablesGroup</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProgramEndCheck</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_TrainingWithSupport" name="Trainieren mit App- und Wearable-Support">
      <bpmn:incoming>SequenceFlow_WithWearablesGroup</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProgramEndCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Final Check -->
    <bpmn:task id="Task_AbschlussGesundheitsCheck" name="Abschließender Gesundheits-Check">
      <bpmn:incoming>SequenceFlow_ProgramEndCheck</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_EndProgram</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_1" name="Programm abgeschlossen">
      <bpmn:incoming>SequenceFlow_EndProgram</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_Start" sourceRef="StartEvent_1" targetRef="Task_GesundheitsCheck" />
    
    <bpmn:parallelGateway id="ParallelGateway_DataCollection">
      <bpmn:incoming>SequenceFlow_Start</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AppInstructionStarts</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_WearableInstructionStarts</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Health Data Collection -->
    <bpmn:sequenceFlow id="SequenceFlow_HealthDataCollected" sourceRef="Task_GesundheitsCheck" targetRef="ParallelGateway_DataCollection" />

    <!-- Training Plan Creation -->
    <bpmn:sequenceFlow id="SequenceFlow_PlanDelivered" name="Trainingsplan erstellen und übergeben" sourceRef="Task_TrainingsplanErstellen" targetRef="Gateway_Trainingsphase1_6Monate" />

    <!-- Optional Nutrition Counseling Flow (parallel to training) -->
    <bpmn:sequenceFlow id="SequenceFlow_NutritionRequest" name="Zusätzliche Ernährungsberatung anfordern" sourceRef="Task_GesundheitsCheck" targetRef="Gateway_Trainingsphase1_6Monate" />

    <!-- Training Phase 2 Flow (after mid-point check) -->
    <bpmn:sequenceFlow id="SequenceFlow_GroupDivision" name="Gruppeneinteilung nach Zwischen-Check" sourceRef="ZwischenCheckEvent" targetRef="Gateway_GroupDivision" />

    <!-- Group A - No Wearables -->
    <bpmn:sequenceFlow id="SequenceFlow_NoWearablesGroup" name="Gruppe ohne Wearable-Support" sourceRef="Gateway_GroupDivision" targetRef="Task_TrainingWithoutWearables" />

    <!-- Group B - With Support -->
    <bpmn:sequenceFlow id="SequenceFlow_WithWearablesGroup" name="Gruppe mit App- und Wearable-Support" sourceRef="Gateway_GroupDivision" targetRef="Task_TrainingWithSupport" />

    <!-- Final Check Flow (from both groups) -->
    <bpmn:parallelGateway id="ParallelGateway_ProgramEnd">
      <bpmn:incoming>SequenceFlow_ProgramEndCheck</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_EndProgram</bpmn:outgoing>
    </bpmn:parallelGateway>

  </bpmn:process>
</bpmn:definitions>