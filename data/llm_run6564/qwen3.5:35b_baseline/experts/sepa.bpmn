<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions id="Definitions_1" targetNamespace="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC">
  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="Participant_SEPA_Process" name="SEPA Mandat Processing" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_0123456789ab">
      <bpmn:lane id="Lane_SystemAutomation" name="System/Automation">
        <bpmn:flowNodeRef>StartEvent_SEPAMandate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tsk_CheckIBAN</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gtw_IBANValid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tsk_DetermineCountry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tsk_SearchPersonCheckData</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Clerk" name="Sachbearbeiter">
        <bpmn:flowNodeRef>Gtw_DataComplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tsk_ManualCheckMissingData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gtw_SignaturePresent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tsk_CreateLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_TimerWait28Days</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gtw_BankOK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tsk_FixBankConnection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gtw_ActiveMandateExists</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tsk_CreateNewMandate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gtw_MandatRelevant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tsk_EndOldCreateNewMandate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tsk_CheckClaimsCommunicate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gtw_AmountThreshold</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tsk_ManualReviewHighAmount</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_SEPAMandate" name="SEPA Mandat Daten eingegangen">
      <bpmn:outgoing>SqFlow_StartToIBAN</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1 -->
    <bpmn:userTask id="Tsk_CheckIBAN" name="Prüfung IBAN Vorhanden">
      <bpmn:incoming>SqFlow_StartToIBAN</bpmn:incoming>
      <bpmn:outgoing>SqFlow_IBANToGtwValid</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway 1 -->
    <bpmn:exclusiveGateway id="Gtw_IBANValid" name="IBAN Gültig?">
      <bpmn:incoming>SqFlow_IBANToGtwValid</bpmn:incoming>
      <bpmn:outgoing>SqFlow_ValidToCountry</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 2 -->
    <bpmn:userTask id="Tsk_DetermineCountry" name="Land der IBAN bestimmen">
      <bpmn:incoming>SqFlow_ValidToCountry</bpmn:incoming>
      <bpmn:outgoing>SqFlow_CountryToSearch</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task 3 -->
    <bpmn:userTask id="Tsk_SearchPersonCheckData" name="Suche Person &amp; Daten prüfen">
      <bpmn:incoming>SqFlow_CountryToSearch</bpmn:incoming>
      <bpmn:outgoing>SqFlow_DataToGtwComplete</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway 2 -->
    <bpmn:exclusiveGateway id="Gtw_DataComplete" name="Alle Daten vollständig?">
      <bpmn:incoming>SqFlow_DataToGtwComplete</bpmn:incoming>
      <bpmn:outgoing>SqFlow_NoDataToSigCheck</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Gateway 3 -->
    <bpmn:exclusiveGateway id="Gtw_SignaturePresent" name="Unterschrift vorhanden?">
      <bpmn:incoming>SqFlow_NoDataToSigCheck</bpmn:incoming>
      <bpmn:outgoing>SqFlow_YesSigToManualCheck</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 4 -->
    <bpmn:userTask id="Tsk_ManualCheckMissingData" name="Manuelle Prüfung fehlender Daten">
      <bpmn:incoming>SqFlow_YesSigToManualCheck</bpmn:incoming>
      <bpmn:outgoing>SqFlow_ManualBackToComplete</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task 5 -->
    <bpmn:userTask id="Tsk_CreateLetter" name="Schreiben zur Unterschrift erstellen">
      <bpmn:incoming>SqFlow_NoSigToCreateLetter</bpmn:incoming>
      <bpmn:outgoing>SqFlow_LetterToTimer</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Intermediate Event -->
    <bpmn:intermediateCatchEvent id="Event_TimerWait28Days" name="Warte 28 Tage">
      <bpmn:incoming>SqFlow_LetterToTimer</bpmn:incoming>
      <bpmn:outgoing>SqFlow_TimerResponseReceived</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- End Event 1 -->
    <bpmn:endEvent id="End_ErrorTimeout" name="Prozess nicht fortsetzbar">
      <bpmn:incoming>SqFlow_TimerNoResponse</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task Check Valid/Bank Details -->
    <bpmn:userTask id="Tsk_CheckValidFromAndBankDetails" name="Prüfung Gültig von &amp; Bankverbindung">
      <bpmn:incoming>SqFlow_ValidToMandateCheck</bpmn:incoming>
      <bpmn:outgoing>SqFlow_BankOKtoGtw</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway 4 -->
    <bpmn:exclusiveGateway id="Gtw_BankOK" name="Bankverbindung gültig?">
      <bpmn:incoming>SqFlow_BankOKtoGtw</bpmn:incoming>
      <bpmn:outgoing>SqFlow_YesBankToMandateCheck</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 6 -->
    <bpmn:userTask id="Tsk_FixBankConnection" name="Neue Bankverbindung anlegen/prüfen">
      <bpmn:incoming>SqFlow_NoBankToFix</bpmn:incoming>
      <bpmn:outgoing>SqFlow_BankFixedToMandateCheck</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway 5 -->
    <bpmn:exclusiveGateway id="Gtw_ActiveMandateExists" name="Aktives Mandat vorhanden?">
      <bpmn:incoming>SqFlow_ValidToMandateCheck</bpmn:incoming>
      <bpmn:outgoing>SqFlow_NoActiveCreateNew</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 7 -->
    <bpmn:userTask id="Tsk_CreateNewMandate" name="Neues Mandat anlegen">
      <bpmn:incoming>SqFlow_NoActiveCreateNew</bpmn:incoming>
      <bpmn:outgoing>SqFlow_NewToClaimsCheck</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway 6 -->
    <bpmn:exclusiveGateway id="Gtw_MandatRelevant" name="Neues Mandat relevant?">
      <bpmn:incoming>SqFlow_ActiveToCheck</bpmn:incoming>
      <bpmn:outgoing>SqFlow_YesMandateEndOldCreateNew</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 8 -->
    <bpmn:userTask id="Tsk_EndOldCreateNewMandate" name="Bestehendes beenden &amp; Neues anlegen">
      <bpmn:incoming>SqFlow_YesMandateEndOldCreateNew</bpmn:incoming>
      <bpmn:outgoing>SqFlow_NewToClaimsCheck</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task 9 -->
    <bpmn:userTask id="Tsk_CheckClaimsCommunicate" name="Prüfung offene Forderungen &amp; Kommunikation">
      <bpmn:incoming>SqFlow_NewToClaimsCheck</bpmn:incoming>
      <bpmn:outgoing>SqFlow_ClaimsToThreshold</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway 7 -->
    <bpmn:exclusiveGateway id="Gtw_AmountThreshold" name="Forderungen &gt; 5.000 €?">
      <bpmn:incoming>SqFlow_ClaimsToThreshold</bpmn:incoming>
      <bpmn:outgoing>SqFlow_HighAmountReview</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 10 -->
    <bpmn:userTask id="Tsk_ManualReviewHighAmount" name="Manuelle Überprüfung">
      <bpmn:incoming>SqFlow_HighAmountReview</bpmn:incoming>
      <bpmn:outgoing>SqFlow_ReviewToFinalEnd</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event 2 -->
    <bpmn:endEvent id="End_MandateClosed" name="SEPA Mandat abgeschlossen">
      <bpmn:incoming>SqFlow_ReviewToFinalEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SqFlow_StartToIBAN" sourceRef="StartEvent_SEPAMandate" targetRef="Tsk_CheckIBAN"/>
    <bpmn:sequenceFlow id="SqFlow_IBANToGtwValid" name="Ja" sourceRef="Tsk_CheckIBAN" targetRef="Gtw_IBANValid"/>
    <bpmn:sequenceFlow id="SqFlow_ValidToCountry" sourceRef="Gtw_IBANValid" targetRef="Tsk_DetermineCountry"/>
    <bpmn:sequenceFlow id="SqFlow_CountryToSearch" sourceRef="Tsk_DetermineCountry" targetRef="Tsk_SearchPersonCheckData"/>
    <bpmn:sequenceFlow id="SqFlow_DataToGtwComplete" name="Daten geprüft" sourceRef="Tsk_SearchPersonCheckData" targetRef="Gtw_DataComplete"/>

    <!-- Data Completeness Branches -->
    <bpmn:sequenceFlow id="SqFlow_NoDataToSigCheck" name="Nein" sourceRef="Gtw_DataComplete" targetRef="Gtw_SignaturePresent"/>
    <bpmn:sequenceFlow id="SqFlow_YesSigToManualCheck" name="Ja (Unterschrift)" sourceRef="Gtw_SignaturePresent" targetRef="Tsk_ManualCheckMissingData"/>
    <bpmn:sequenceFlow id="SqFlow_ManualBackToComplete" sourceRef="Tsk_ManualCheckMissingData" targetRef="Gtw_DataComplete"/>

    <!-- Signature Missing Branches -->
    <bpmn:sequenceFlow id="SqFlow_NoSigToCreateLetter" name="Nein (Keine Unterschrift)" sourceRef="Gtw_SignaturePresent" targetRef="Tsk_CreateLetter"/>
    <bpmn:sequenceFlow id="SqFlow_LetterToTimer" sourceRef="Tsk_CreateLetter" targetRef="Event_TimerWait28Days"/>

    <!-- Timer Event Logic -->
    <bpmn:intermediateCatchEvent id="Event_TimerTimeout" name="Keine Rückmeldung">
      <bpmn:incoming>SqFlow_LetterToTimer</bpmn:incoming>
      <bpmn:outgoing>SqFlow_TimerNoResponse</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Timer Logic Flows -->
    <bpmn:sequenceFlow id="SqFlow_TimerResponseReceived" sourceRef="Event_TimerWait28Days" targetRef="Gtw_DataComplete"/> 
    <bpmn:sequenceFlow id="SqFlow_TimerNoResponse" name="Timeout (Keine Rückmeldung)" sourceRef="Event_TimerTimeout" targetRef="End_ErrorTimeout"/>

    <!-- Bank Connection Check -->
    <bpmn:sequenceFlow id="SqFlow_ValidToMandateCheck" sourceRef="Gtw_DataComplete" targetRef="Tsk_CheckValidFromAndBankDetails"/> 
    <bpmn:sequenceFlow id="SqFlow_BankOKtoGtw" name="Ja" sourceRef="Tsk_CheckValidFromAndBankDetails" targetRef="Gtw_BankOK"/>
    
    <!-- Bank OK Branches -->
    <bpmn:sequenceFlow id="SqFlow_YesBankToMandateCheck" name="Ja" sourceRef="Gtw_BankOK" targetRef="Tsk_CheckValidFromAndBankDetails"/> 
    <bpmn:sequenceFlow id="SqFlow_NoBankToFix" name="Nein" sourceRef="Gtw_BankOK" targetRef="Tsk_FixBankConnection"/>
    
    <!-- Bank Fixed Branch -->
    <bpmn:sequenceFlow id="SqFlow_BankFixedToMandateCheck" sourceRef="Tsk_FixBankConnection" targetRef="Gtw_ActiveMandateExists"/>

    <!-- Mandate Check Flows -->
    <bpmn:sequenceFlow id="SqFlow_ValidToMandateCheck2" name="Ja (Daten vollständig)" sourceRef="Gtw_DataComplete" targetRef="Tsk_CheckValidFromAndBankDetails"/> 
    <bpmn:sequenceFlow id="SqFlow_ActiveToCheck" name="Nein, aktives Mandat vorhanden?" sourceRef="Gtw_BankOK" targetRef="Gtw_MandatRelevant"/>
    
    <!-- Active Mandate Branches -->
    <bpmn:sequenceFlow id="SqFlow_NoActiveCreateNew" name="Kein aktives Mandat" sourceRef="Gtw_ActiveMandateExists" targetRef="Tsk_CreateNewMandate"/> 
    <bpmn:sequenceFlow id="SqFlow_YesMandateEndOldCreateNew" name="Ja, relevant?" sourceRef="Gtw_MandatRelevant" targetRef="Tsk_EndOldCreateNewMandate"/>

    <!-- Claims Check Flows -->
    <bpmn:sequenceFlow id="SqFlow_NewToClaimsCheck" sourceRef="Tsk_CreateNewMandate" targetRef="Tsk_CheckClaimsCommunicate"/> 
    <bpmn:sequenceFlow id="SqFlow_ClaimsToThreshold" name="Forderungen prüfen" sourceRef="Tsk_CheckClaimsCommunicate" targetRef="Gtw_AmountThreshold"/>

    <!-- Threshold Branches -->
    <bpmn:sequenceFlow id="SqFlow_HighAmountReview" name="Ja &gt; 5.000 €" sourceRef="Gtw_AmountThreshold" targetRef="Tsk_ManualReviewHighAmount"/> 
    <bpmn:sequenceFlow id="SqFlow_ReviewToFinalEnd" sourceRef="Tsk_ManualReviewHighAmount" targetRef="End_MandateClosed"/>
  </bpmn:process>
</bpmn:definitions>