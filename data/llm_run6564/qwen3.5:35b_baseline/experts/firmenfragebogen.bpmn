<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions id="Definitions_1" targetNamespace="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC">
  <bpmn:collaboration id="Collab_0a9876543210">
    <bpmn:participant id="Participant_ProcessOwner" name="Fragenbogenbearbeitung" processRef="Proc_Fragenbogen"/>
  </bpmn:collaboration>

  <bpmn:process id="Proc_Fragenbogen" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="Start_0123456789ab" name="Fragenbogen Eingang">
      <bpmn:outgoing>SqFlow_StartToSearch</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1 -->
    <bpmn:userTask id="Tsk_0123456789ab" name="Erfassen &amp; Verarbeiten im System">
      <bpmn:incoming>SqFlow_StartToSearch</bpmn:incoming>
      <bpmn:outgoing>SqFlow_SearchResult</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway 1 -->
    <bpmn:exclusiveGateway id="Gtw_0123456789ab" name="Partner eindeutig?">
      <bpmn:incoming>SqFlow_SearchResult</bpmn:incoming>
      <bpmn:outgoing>SqFlow_AutoMatch</bpmn:outgoing>
      <bpmn:outgoing>SqFlow_ManualReview</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Path A (Auto) -->
    <bpmn:sequenceFlow id="SqFlow_AutoMatch" sourceRef="Gtw_0123456789ab" targetRef="Tsk_0123456789ef"/>

    <!-- Path B (Manual) -->
    <bpmn:userTask id="Tsk_ManualReview" name="Manuelle Prüfung durch Sachbearbeiter">
      <bpmn:incoming>SqFlow_ManualReview</bpmn:incoming>
      <bpmn:outgoing>SqFlow_ToMergeDataCheck</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Merge Point -->
    <bpmn:exclusiveGateway id="Gtw_MergePoint" name="Join Data Check">
      <bpmn:incoming>SqFlow_AutoMatch</bpmn:incoming>
      <bpmn:incoming>SqFlow_ToMergeDataCheck</bpmn:incoming>
      <bpmn:outgoing>SqFlow_VerifyCompanyData</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 2 -->
    <bpmn:userTask id="Tsk_0123456789ef" name="Unternehmensdaten prüfen">
      <bpmn:incoming>SqFlow_VerifyCompanyData</bpmn:incoming>
      <bpmn:outgoing>SqFlow_ProblemCheck_Data</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Exception Check 1 -->
    <bpmn:exclusiveGateway id="Gtw_0123456789ef" name="Problem bei Datenprüfung?">
      <bpmn:incoming>SqFlow_ProblemCheck_Data</bpmn:incoming>
      <bpmn:outgoing>SqFlow_HandoverTask</bpmn:outgoing>
      <bpmn:outgoing>SqFlow_CheckReportingPeriod</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 3 (Sub-logic for Reporting Period) -->
    <bpmn:userTask id="Tsk_0123456789gh" name="Meldezeitraum kontrollieren">
      <bpmn:incoming>SqFlow_CheckReportingPeriod</bpmn:incoming>
      <bpmn:outgoing>SqFlow_TimesExistCheck</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway 2 (Times Exist) -->
    <bpmn:exclusiveGateway id="Gtw_0123456789gh" name="Umlagezeiten vorhanden?">
      <bpmn:incoming>SqFlow_TimesExistCheck</bpmn:incoming>
      <bpmn:outgoing>SqFlow_VerifyExistingTimes</bpmn:outgoing>
      <bpmn:outgoing>SqFlow_CreateNewTimes</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 3a -->
    <bpmn:userTask id="Tsk_0123456789ij" name="Bestehende Zeiten überprüfen">
      <bpmn:incoming>SqFlow_VerifyExistingTimes</bpmn:incoming>
      <bpmn:outgoing>SqFlow_MergeReportingPeriods</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task 3b -->
    <bpmn:userTask id="Tsk_0123456789kl" name="Umlagezeiten neu anlegen">
      <bpmn:incoming>SqFlow_CreateNewTimes</bpmn:incoming>
      <bpmn:outgoing>SqFlow_MergeReportingPeriods</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Merge Reporting Period -->
    <bpmn:exclusiveGateway id="Gtw_0123456789ij" name="Join Times">
      <bpmn:incoming>SqFlow_MergeReportingPeriods</bpmn:incoming>
      <bpmn:outgoing>SqFlow_ProblemCheck_Times</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Exception Check 2 -->
    <bpmn:exclusiveGateway id="Gtw_0123456789kl" name="Problem bei Zeiten?">
      <bpmn:incoming>SqFlow_ProblemCheck_Times</bpmn:incoming>
      <bpmn:outgoing>SqFlow_HandoverTask</bpmn:outgoing>
      <bpmn:outgoing>SqFlow_CheckContactData</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 4 -->
    <bpmn:userTask id="Tsk_0123456789mn" name="Kontaktdaten überprüfen">
      <bpmn:incoming>SqFlow_CheckContactData</bpmn:incoming>
      <bpmn:outgoing>SqFlow_ProblemCheck_Contacts</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Exception Check 3 -->
    <bpmn:exclusiveGateway id="Gtw_0123456789mn" name="Problem bei Kontakten?">
      <bpmn:incoming>SqFlow_ProblemCheck_Contacts</bpmn:incoming>
      <bpmn:outgoing>SqFlow_HandoverTask</bpmn:outgoing>
      <bpmn:outgoing>SqFlow_SuccessEnd</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Handover Task -->
    <bpmn:userTask id="Tsk_0123456789op" name="An Mitarbeiter übergeben">
      <bpmn:incoming>SqFlow_HandoverTask</bpmn:incoming>
      <bpmn:outgoing>SqFlow_EscalationEnd</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Events -->
    <bpmn:endEvent id="End_0123456789ab" name="Fragenbogen bearbeitet">
      <bpmn:incoming>SqFlow_SuccessEnd</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="End_0123456789cd" name="Prozess eskaliert">
      <bpmn:incoming>SqFlow_EscalationEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SqFlow_StartToSearch" sourceRef="Start_0123456789ab" targetRef="Tsk_0123456789ab"/>
    <bpmn:sequenceFlow id="SqFlow_SearchResult" sourceRef="Tsk_0123456789ab" targetRef="Gtw_0123456789ab"/>
    <bpmn:sequenceFlow id="SqFlow_ManualReview" name="Nein/Unklar" sourceRef="Gtw_0123456789ab" targetRef="Tsk_ManualReview"/>
    <bpmn:sequenceFlow id="SqFlow_ToMergeDataCheck" sourceRef="Tsk_ManualReview" targetRef="Gtw_MergePoint"/>
    
    <bpmn:sequenceFlow id="SqFlow_VerifyCompanyData" sourceRef="Gtw_MergePoint" targetRef="Tsk_0123456789ef"/>
    <bpmn:sequenceFlow id="SqFlow_ProblemCheck_Data" sourceRef="Tsk_0123456789ef" targetRef="Gtw_0123456789ef"/>
    
    <bpmn:sequenceFlow id="SqFlow_CheckReportingPeriod" name="Kein Problem" sourceRef="Gtw_0123456789ef" targetRef="Tsk_0123456789gh"/>
    <bpmn:sequenceFlow id="SqFlow_TimesExistCheck" sourceRef="Tsk_0123456789gh" targetRef="Gtw_0123456789gh"/>
    
    <bpmn:sequenceFlow id="SqFlow_VerifyExistingTimes" name="Ja vorhanden" sourceRef="Gtw_0123456789gh" targetRef="Tsk_0123456789ij"/>
    <bpmn:sequenceFlow id="SqFlow_CreateNewTimes" name="Nein fehlen" sourceRef="Gtw_0123456789gh" targetRef="Tsk_0123456789kl"/>
    
    <bpmn:sequenceFlow id="SqFlow_MergeReportingPeriods" sourceRef="Tsk_0123456789ij" targetRef="Gtw_0123456789ij"/>
    <bpmn:sequenceFlow id="SqFlow_ProblemCheck_Times" name="Kein Problem" sourceRef="Gtw_0123456789ij" targetRef="Tsk_0123456789mn"/>

    <!-- Handover Logic -->
    <bpmn:sequenceFlow id="SqFlow_HandoverTask" name="Problem aufgetreten" sourceRef="Gtw_0123456789ef" targetRef="Tsk_0123456789op"/>
    <bpmn:sequenceFlow id="SqFlow_EscalationEnd" sourceRef="Tsk_0123456789op" targetRef="End_0123456789cd"/>

  </bpmn:process>
</bpmn:definitions>