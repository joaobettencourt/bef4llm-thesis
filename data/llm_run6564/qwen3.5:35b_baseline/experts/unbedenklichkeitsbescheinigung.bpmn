<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions id="Definitions_1" targetNamespace="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <bpmn:collaboration id="Collab_0a9876543210">
    <bpmn:participant id="Participant_CertProcess" name="Unbedenklichkeitsbescheinigung Prozess" processRef="Proc_Unbedenklichkeit"/>
  </bpmn:collaboration>

  <bpmn:process id="Proc_Unbedenklichkeit" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_InquiryReceived" name="Eingang Anfrage für Unbedenklichkeitsbescheinigung">
      <bpmn:outgoing>SqFlow_StartToInit</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Parallel Gateway for Initialization -->
    <bpmn:parallelGateway id="Gw_InitSplit" name="Initialisierung &amp; Reset">
      <bpmn:incoming>SqFlow_StartToInit</bpmn:incoming>
      <bpmn:outgoing>SqFlow_ToTaskCaseTraceable</bpmn:outgoing>
      <bpmn:outgoing>SqFlow_ToTaskResetCounter</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 1 -->
    <bpmn:userTask id="Tsk_InitCase" name="Vorgang im System nachvollziehbar machen">
      <bpmn:incoming>SqFlow_ToTaskCaseTraceable</bpmn:incoming>
      <bpmn:outgoing>SqFlow_CaseToJoinInit</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task 2 -->
    <bpmn:userTask id="Tsk_ResetCounter" name="Anzahl der Bescheinigungen auf null setzen">
      <bpmn:incoming>SqFlow_ToTaskResetCounter</bpmn:incoming>
      <bpmn:outgoing>SqFlow_CounterToJoinInit</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel Gateway Merge -->
    <bpmn:parallelGateway id="Gw_InitMerge" name="Initialisierung abgeschlossen">
      <bpmn:incoming>SqFlow_CaseToJoinInit</bpmn:incoming>
      <bpmn:incoming>SqFlow_CounterToJoinInit</bpmn:incoming>
      <bpmn:outgoing>SqFlow_InitToCheckOriginator</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 3 -->
    <bpmn:userTask id="Tsk_CheckOrigin" name="Prüfung Absender">
      <bpmn:incoming>SqFlow_InitToCheckOriginator</bpmn:incoming>
      <bpmn:outgoing>SqFlow_OriginatorDecision</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway 1 -->
    <bpmn:exclusiveGateway id="Gw_PersonInSystem" name="Person im System?">
      <bpmn:incoming>SqFlow_OriginatorDecision</bpmn:incoming>
      <bpmn:outgoing>SqFlow_HandoverNoPerson</bpmn:outgoing>
      <bpmn:outgoing>SqFlow_PersonFoundContinue</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 4 -->
    <bpmn:userTask id="Tsk_CheckEmployerRole" name="Rolle Arbeitgeber prüfen">
      <bpmn:incoming>SqFlow_PersonFoundContinue</bpmn:incoming>
      <bpmn:outgoing>SqFlow_EmployerDecision</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway 2 -->
    <bpmn:exclusiveGateway id="Gw_IsEmployer" name="Arbeitgeberrolle vorhanden?">
      <bpmn:incoming>SqFlow_EmployerDecision</bpmn:incoming>
      <bpmn:outgoing>SqFlow_CreateLetterNoRole</bpmn:outgoing>
      <bpmn:outgoing>SqFlow_YesEmployerProceed</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 5 -->
    <bpmn:userTask id="Tsk_CreateLetter" name="Anschreiben erstellen">
      <bpmn:incoming>SqFlow_CreateLetterNoRole</bpmn:incoming>
      <bpmn:outgoing>SqFlow_LetterToEndInfoMissing</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event 1 -->
    <bpmn:endEvent id="EndEvent_InfoMissing" name="Informationen fehlten">
      <bpmn:incoming>SqFlow_LetterToEndInfoMissing</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task 6 -->
    <bpmn:userTask id="Tsk_CheckInsuranceTimes" name="Versicherungszeiten prüfen">
      <bpmn:incoming>SqFlow_YesEmployerProceed</bpmn:incoming>
      <bpmn:outgoing>SqFlow_TimesToProofCount</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task 7 -->
    <bpmn:userTask id="Tsk_CheckProofs" name="Anzahl Beitragsnachweise prüfen">
      <bpmn:incoming>SqFlow_TimesToProofCount</bpmn:incoming>
      <bpmn:outgoing>SqFlow_ProofsToAmountCheck</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task 8 -->
    <bpmn:userTask id="Tsk_CheckContributionAmount" name="Beitragshöhe prüfen">
      <bpmn:incoming>SqFlow_ProofsToAmountCheck</bpmn:incoming>
      <bpmn:outgoing>SqFlow_AmountToOpenClaims</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task 9 -->
    <bpmn:userTask id="Tsk_CheckOpenClaims" name="Offene Forderungen prüfen">
      <bpmn:incoming>SqFlow_AmountToOpenClaims</bpmn:incoming>
      <bpmn:outgoing>SqFlow_ClaimsToFinalEval</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway 3 -->
    <bpmn:exclusiveGateway id="Gw_PrereqsMet" name="Voraussetzungen erfüllt?">
      <bpmn:incoming>SqFlow_ClaimsToFinalEval</bpmn:incoming>
      <bpmn:outgoing>SqFlow_HandoverClerkFail</bpmn:outgoing>
      <bpmn:outgoing>SqFlow_CertEligibleProceed</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 10 -->
    <bpmn:userTask id="Tsk_HandOverClerk" name="An Sachbearbeiter übergeben">
      <bpmn:incoming>SqFlow_HandoverNoPerson</bpmn:incoming>
      <bpmn:outgoing>SqFlow_ClerkToHistory</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task 11 -->
    <bpmn:userTask id="Tsk_IssueCertificate" name="Bescheinigung ausstellen">
      <bpmn:incoming>SqFlow_CertEligibleProceed</bpmn:incoming>
      <bpmn:outgoing>SqFlow_CertificateToHistory</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event 2 -->
    <bpmn:endEvent id="EndEvent_Handover" name="Fall an Sachbearbeiter übergeben">
      <bpmn:incoming>SqFlow_ClerkToHistory</bpmn:incoming>
    </bpmn:endEvent>

    <!-- End Event 3 -->
    <bpmn:endEvent id="EndEvent_Completed" name="Bescheinigung ausgestellt">
      <bpmn:incoming>SqFlow_CertificateToHistory</bpmn:outgoing></endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SqFlow_StartToInit" sourceRef="StartEvent_InquiryReceived" targetRef="Gw_InitSplit"/>
    <bpmn:sequenceFlow id="SqFlow_ToTaskCaseTraceable" sourceRef="Gw_InitSplit" targetRef="Tsk_InitCase"/>
    <bpmn:sequenceFlow id="SqFlow_ToTaskResetCounter" sourceRef="Gw_InitSplit" targetRef="Tsk_ResetCounter"/>
    <bpmn:sequenceFlow id="SqFlow_CaseToJoinInit" sourceRef="Tsk_InitCase" targetRef="Gw_InitMerge"/>
    <bpmn:sequenceFlow id="SqFlow_CounterToJoinInit" sourceRef="Tsk_ResetCounter" targetRef="Gw_InitMerge"/>
    <bpmn:sequenceFlow id="SqFlow_InitToCheckOriginator" sourceRef="Gw_InitMerge" targetRef="Tsk_CheckOrigin"/>
    <bpmn:sequenceFlow id="SqFlow_OriginatorDecision" sourceRef="Tsk_CheckOrigin" targetRef="Gw_PersonInSystem"/>
    <bpmn:sequenceFlow id="SqFlow_HandoverNoPerson" sourceRef="Gw_PersonInSystem" targetRef="Tsk_HandOverClerk"/>
    <bpmn:sequenceFlow id="SqFlow_PersonFoundContinue" sourceRef="Gw_PersonInSystem" targetRef="Tsk_CheckEmployerRole"/>
    <bpmn:sequenceFlow id="SqFlow_EmployerDecision" sourceRef="Tsk_CheckEmployerRole" targetRef="Gw_IsEmployer"/>
    <bpmn:sequenceFlow id="SqFlow_CreateLetterNoRole" sourceRef="Gw_IsEmployer" targetRef="Tsk_CreateLetter"/>
    <bpmn:sequenceFlow id="SqFlow_YesEmployerProceed" sourceRef="Gw_IsEmployer" targetRef="Tsk_CheckInsuranceTimes"/>
    <bpmn:sequenceFlow id="SqFlow_LetterToEndInfoMissing" sourceRef="Tsk_CreateLetter" targetRef="EndEvent_InfoMissing"/>
    <bpmn:sequenceFlow id="SqFlow_TimesToProofCount" sourceRef="Tsk_CheckInsuranceTimes" targetRef="Tsk_CheckProofs"/>
    <bpmn:sequenceFlow id="SqFlow_ProofsToAmountCheck" sourceRef="Tsk_CheckProofs" targetRef="Tsk_CheckContributionAmount"/>
    <bpmn:sequenceFlow id="SqFlow_AmountToOpenClaims" sourceRef="Tsk_CheckContributionAmount" targetRef="Tsk_CheckOpenClaims"/>
    <bpmn:sequenceFlow id="SqFlow_ClaimsToFinalEval" sourceRef="Tsk_CheckOpenClaims" targetRef="Gw_PrereqsMet"/>
    <bpmn:sequenceFlow id="SqFlow_HandoverClerkFail" sourceRef="Gw_PrereqsMet" targetRef="Tsk_HandOverClerk"/>
    <bpmn:sequenceFlow id="SqFlow_CertEligibleProceed" sourceRef="Gw_PrereqsMet" targetRef="Tsk_IssueCertificate"/>
    <bpmn:sequenceFlow id="SqFlow_ClerkToHistory" sourceRef="Tsk_HandOverClerk" targetRef="EndEvent_Handover"/>
    <bpmn:sequenceFlow id="SqFlow_CertificateToHistory" sourceRef="Tsk_IssueCertificate" targetRef="EndEvent_Completed"/>

  </bpmn:process>
</bpmn:definitions>