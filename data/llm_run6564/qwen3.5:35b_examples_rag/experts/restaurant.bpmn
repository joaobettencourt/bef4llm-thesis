<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                 xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" 
                 xmlns:di="http://www.omg.org/spec/DD/20100524/DI" 
                 xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" 
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:collaboration id="Collaboration_RestaurantProcess">
    <bpmn:participant id="Participant_Restaurant" name="Restaurant Prozess" processRef="Process_Restaurant"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Restaurant" isExecutable="false">
    
    <!-- Lane Set -->
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Gast" name="Gast">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WahlGericht</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_EssenVerzehren</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Angestellter" name="Angestellter">
        <bpmn:flowNodeRef>Task_BestellungAufnehmen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_KassensystemEingabe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PieperEinstellen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_KochInformieren</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_NichtReagiert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TimerEvent_5Minuten</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GastRufen</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Koch" name="Koch">
        <bpmn:flowNodeRef>Gateway_Bereitstellen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MahlzeitZubereiten</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DurchreicheBereitStellen</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Gast betritt Restaurant">
      <bpmn:outgoing>SequenceFlow_WahlGericht</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Guest Task -->
    <bpmn:task id="Task_WahlGericht" name="Wählt Gericht aus Angebot">
      <bpmn:incoming>SequenceFlow_WahlGericht</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BestellungAufnehmen</bpmn:outgoing>
    </bpmn:task>

    <!-- Staff Tasks -->
    <bpmn:task id="Task_BestellungAufnehmen" name="Bestellung aufnehmen">
      <bpmn:incoming>SequenceFlow_BestellungAufnehmen</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_KassensystemEingabe</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_KassensystemEingabe" name="Bestellung eingeben &amp; Geld kassieren">
      <bpmn:incoming>SequenceFlow_KassensystemEingabe</bpmn:incoming>
      <bpmn:outgoing>ParallelGateway_StartKochen</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway for Cook Notification and Pager Setup -->
    <bpmn:parallelGateway id="ParallelGateway_StartKochen">
      <bpmn:incoming>SequenceFlow_KassensystemEingabe</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PieperEinstellen</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_KochInformieren</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Pager Setup Task -->
    <bpmn:task id="Task_PieperEinstellen" name="Pieper einstellen &amp; an Gast übergeben">
      <bpmn:incoming>SequenceFlow_PieperEinstellen</bpmn:incoming>
      <bpmn:outgoing>Gateway_NichtReagiert</bpmn:outgoing>
    </bpmn:task>

    <!-- Cook Notification Task -->
    <bpmn:task id="Task_KochInformieren" name="Koch über Mahlzeit informieren">
      <bpmn:incoming>SequenceFlow_KochInformieren</bpmn:incoming>
      <bpmn:outgoing>Gateway_Bereitstellen</bpmn:outgoing>
    </bpmn:task>

    <!-- Cook Tasks -->
    <bpmn:exclusiveGateway id="Gateway_Bereitstellen" name="Mahlzeit fertig?">
      <bpmn:incoming>SequenceFlow_KochInformieren</bpmn:incoming>
      <bpmn:outgoing>Task_MahlzeitZubereiten</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Cook Task -->
    <bpmn:task id="Task_MahlzeitZubereiten" name="Mahlzeit zubereiten">
      <bpmn:incoming>SequenceFlow_ZubereitungStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DurchreicheBereitStellen</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow for Cook Task -->
    <bpmn:sequenceFlow id="SequenceFlow_ZubereitungStart" sourceRef="Gateway_Bereitstellen" targetRef="Task_MahlzeitZubereiten"/>

    <bpmn:task id="Task_DurchreicheBereitStellen" name="Mahlzeit in Durchreiche stellen">
      <bpmn:incoming>SequenceFlow_DurchreicheBereitStellen</bpmn:incoming>
      <bpmn:outgoing>Gateway_AngestellterInformiert</bpmn:outgoing>
    </bpmn:task>

    <!-- Staff Notification from Cook -->
    <bpmn:exclusiveGateway id="Gateway_AngestellterInformiert" name="Koch informiert?">
      <bpmn:incoming>SequenceFlow_DurchreicheBereitStellen</bpmn:incoming>
      <bpmn:outgoing>Task_PieperAusloesen</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Guest Notification Trigger -->
    <bpmn:task id="Task_PieperAusloesen" name="Pieper des Gastes auslösen">
      <bpmn:incoming>SequenceFlow_AngestellterInformiert</bpmn:incoming>
      <bpmn:outgoing>Gateway_GastReagiert</bpmn:outgoing>
    </bpmn:task>

    <!-- Guest Pickup Logic -->
    <bpmn:exclusiveGateway id="Gateway_GastReagiert" name="Gast reagiert auf Pieper?">
      <bpmn:incoming>SequenceFlow_PieperAusloesen</bpmn:incoming>
      <bpmn:outgoing>Task_EssenAbholen</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Timer Event for 5 minutes -->
    <bpmn:startEvent id="StartEvent_Timer" name="Timer Start">
        <bpmn:timerDuration>P0DT0H5M0S</bpmn:timerDuration>
      <bpmn:outgoing>SequenceFlow_GastRufen</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Retry Call Task -->
    <bpmn:task id="Task_GastRufen" name="Gast nach 5 Minuten rufen">
      <bpmn:incoming>SequenceFlow_GastRufen</bpmn:incoming>
      <bpmn:outgoing>Gateway_NichtReagiert_Retry</bpmn:outgoing>
    </bpmn:task>

    <!-- Retry Loop Gateway -->
    <bpmn:exclusiveGateway id="Gateway_NichtReagiert_Retry" name="Nochmal rufen?">
      <bpmn:incoming>SequenceFlow_GastRufen</bpmn:incoming>
      <bpmn:outgoing>Task_EssenAbholen</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Guest Pickup Task -->
    <bpmn:task id="Task_EssenAbholen" name="Essen abholen">
      <bpmn:incoming>SequenceFlow_GastReagiert_Yes</bpmn:incoming>
      <bpmn:outgoing>EndEvent_EssenVerzehren</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_EssenVerzehren" name="Mahlzeit verzehrt">
      <bpmn:incoming>SequenceFlow_GastReagiert_Yes</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_WahlGericht" sourceRef="StartEvent_1" targetRef="Task_WahlGericht"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_BestellungAufnehmen" name="Bestellung aufnehmen" sourceRef="Task_WahlGericht" targetRef="Task_BestellungAufnehmen"/>

    <bpmn:sequenceFlow id="SequenceFlow_KassensystemEingabe" sourceRef="Task_BestellungAufnehmen" targetRef="Task_KassensystemEingabe"/>

    <bpmn:sequenceFlow id="SequenceFlow_PieperEinstellen" sourceRef="ParallelGateway_StartKochen" targetRef="Task_PieperEinstellen"/>

    <bpmn:sequenceFlow id="SequenceFlow_KochInformieren" sourceRef="ParallelGateway_StartKochen" targetRef="Task_KochInformieren"/>

    <bpmn:sequenceFlow id="SequenceFlow_DurchreicheBereitStellen" sourceRef="Task_MahlzeitZubereiten" targetRef="Task_DurchreicheBereitStellen"/>

    <bpmn:sequenceFlow id="SequenceFlow_AngestellterInformiert" sourceRef="Task_DurchreicheBereitStellen" targetRef="Gateway_AngestellterInformiert"/>

    <bpmn:sequenceFlow id="SequenceFlow_PieperAusloesen" sourceRef="Gateway_AngestellterInformiert" targetRef="Task_PieperAusloesen"/>

    <bpmn:sequenceFlow id="SequenceFlow_GastReagiert_Yes" name="Ja - Gast reagiert" sourceRef="Gateway_GastReagiert" targetRef="Task_EssenAbholen"/>

    <bpmn:sequenceFlow id="SequenceFlow_GastRufen" sourceRef="StartEvent_Timer" targetRef="Task_GastRufen"/>

  </bpmn:process>
</bpmn:definitions>