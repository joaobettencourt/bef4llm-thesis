<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Fragenbogenbearbeitung" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    
    <!-- Lane Set -->
    <bpmn:laneSet id="LaneSet_001">
      <bpmn:lane id="Lane_System" name="System / Automatisierung">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PartnerSearch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MatchFound</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DataCheck1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DataCheck2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DataValid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReportingPeriod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ContributionTimes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VerifyContributions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateContributions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ContactCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_FinalValidation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Success</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Manual" name="Sachbearbeiter">
        <bpmn:flowNodeRef>UserTask_PartnerReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_DataReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_FinalReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Exception1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Exception2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Exception3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Fragenbogen Eingang">
      <bpmn:outgoing>SequenceFlow_Start</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Partner Search Task (System) -->
    <bpmn:serviceTask id="Task_PartnerSearch" name="Partner suchen &amp; erfassen">
      <bpmn:incoming>SequenceFlow_Start</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SearchToGateway</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Gateway 1: Partner Match -->
    <bpmn:exclusiveGateway id="Gateway_MatchFound" name="Passender Partner gefunden?">
      <bpmn:incoming>SequenceFlow_SearchToGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ManualReview1</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ContinueDataCheck</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Manual Review Task 1 (Lane) -->
    <bpmn:userTask id="UserTask_PartnerReview" name="Manuelle Prüfung / Zuordnung">
      <bpmn:incoming>SequenceFlow_ManualReview1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ExceptionEnd1</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event Exception 1 -->
    <bpmn:endEvent id="EndEvent_Exception1" name="An Sachbearbeiter übergeben">
      <bpmn:incoming>SequenceFlow_ExceptionEnd1</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Data Check Task 1 (System) -->
    <bpmn:serviceTask id="Task_DataCheck1" name="Betriebsnummern &amp; Arbeitgeber prüfen">
      <bpmn:incoming>SequenceFlow_ContinueDataCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Check2Start</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Data Check Task 2 (System) -->
    <bpmn:serviceTask id="Task_DataCheck2" name="U1-Verfahren &amp; Insolvenzrücklage prüfen">
      <bpmn:incoming>SequenceFlow_Check2Start</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GatewayDataValidIn</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Gateway 2: Data Valid -->
    <bpmn:exclusiveGateway id="Gateway_DataValid" name="Daten vollständig &amp; korrekt?">
      <bpmn:incoming>SequenceFlow_GatewayDataValidIn</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ManualReview2</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ContinueReportingPeriod</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Manual Review Task 2 (Lane) -->
    <bpmn:userTask id="UserTask_DataReview" name="Klärung durch Mitarbeiter">
      <bpmn:incoming>SequenceFlow_ManualReview2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ExceptionEnd2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event Exception 2 -->
    <bpmn:endEvent id="EndEvent_Exception2" name="An Sachbearbeiter übergeben">
      <bpmn:incoming>SequenceFlow_ExceptionEnd2</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Reporting Period Check (System) -->
    <bpmn:serviceTask id="Task_ReportingPeriod" name="Meldezeitraum kontrollieren">
      <bpmn:incoming>SequenceFlow_ContinueReportingPeriod</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ContributionCheckStart</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Gateway 3: Contribution Times Exist -->
    <bpmn:exclusiveGateway id="Gateway_ContributionTimes" name="Umlagezeiten vorhanden?">
      <bpmn:incoming>SequenceFlow_ContributionCheckStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_VerifyContributions</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CreateContributions</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task Verify Contributions (System) -->
    <bpmn:serviceTask id="Task_VerifyContributions" name="Umlageversicherungszeiten prüfen">
      <bpmn:incoming>SequenceFlow_VerifyContributions</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeToContactCheck1</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Task Create Contributions (System) -->
    <bpmn:serviceTask id="Task_CreateContributions" name="Neue Einträge anlegen">
      <bpmn:incoming>SequenceFlow_CreateContributions</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeToContactCheck2</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Contact Data Check (System) -->
    <bpmn:serviceTask id="Task_ContactCheck" name="Kontaktdaten prüfen">
      <bpmn:incoming>SequenceFlow_MergeToContactCheck1</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_MergeToContactCheck2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FinalValidationIn</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Gateway 4: Final Validation -->
    <bpmn:exclusiveGateway id="Gateway_FinalValidation" name="Alle Daten korrekt?">
      <bpmn:incoming>SequenceFlow_FinalValidationIn</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ManualReview3</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SuccessEnd</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Manual Review Task 3 (Lane) -->
    <bpmn:userTask id="UserTask_FinalReview" name="Klärung durch Mitarbeiter">
      <bpmn:incoming>SequenceFlow_ManualReview3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ExceptionEnd3</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event Exception 3 -->
    <bpmn:endEvent id="EndEvent_Exception3" name="An Sachbearbeiter übergeben">
      <bpmn:incoming>SequenceFlow_ExceptionEnd3</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Success End Event (System) -->
    <bpmn:endEvent id="EndEvent_Success" name="Fragenbogen erfolgreich verarbeitet">
      <bpmn:incoming>SequenceFlow_SuccessEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_Start" sourceRef="StartEvent_1" targetRef="Task_PartnerSearch"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_SearchToGateway" sourceRef="Task_PartnerSearch" targetRef="Gateway_MatchFound"/>

    <bpmn:sequenceFlow id="SequenceFlow_ManualReview1" name="Nein / Problem" sourceRef="Gateway_MatchFound" targetRef="UserTask_PartnerReview"/>

    <bpmn:sequenceFlow id="SequenceFlow_ContinueDataCheck" name="Ja" sourceRef="Gateway_MatchFound" targetRef="Task_DataCheck1"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_Check2Start" sourceRef="Task_DataCheck1" targetRef="Task_DataCheck2"/>

    <bpmn:sequenceFlow id="SequenceFlow_GatewayDataValidIn" sourceRef="Task_DataCheck2" targetRef="Gateway_DataValid"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ManualReview2" name="Nein / Problem" sourceRef="Gateway_DataValid" targetRef="UserTask_DataReview"/>

    <bpmn:sequenceFlow id="SequenceFlow_ContinueReportingPeriod" name="Ja" sourceRef="Gateway_DataValid" targetRef="Task_ReportingPeriod"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ContributionCheckStart" sourceRef="Task_ReportingPeriod" targetRef="Gateway_ContributionTimes"/>

    <bpmn:sequenceFlow id="SequenceFlow_VerifyContributions" name="Ja (Vorhanden)" sourceRef="Gateway_ContributionTimes" targetRef="Task_VerifyContributions"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_CreateContributions" name="Nein (Anlegen)" sourceRef="Gateway_ContributionTimes" targetRef="Task_CreateContributions"/>

    <bpmn:sequenceFlow id="SequenceFlow_MergeToContactCheck1" sourceRef="Task_VerifyContributions" targetRef="Task_ContactCheck"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_MergeToContactCheck2" sourceRef="Task_CreateContributions" targetRef="Task_ContactCheck"/>

    <bpmn:sequenceFlow id="SequenceFlow_FinalValidationIn" sourceRef="Task_ContactCheck" targetRef="Gateway_FinalValidation"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ManualReview3" name="Nein / Problem" sourceRef="Gateway_FinalValidation" targetRef="UserTask_FinalReview"/>

    <bpmn:sequenceFlow id="SequenceFlow_SuccessEnd" name="Ja / Alle OK" sourceRef="Gateway_FinalValidation" targetRef="EndEvent_Success"/>
    
    <!-- Exception End Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_ExceptionEnd1" sourceRef="UserTask_PartnerReview" targetRef="EndEvent_Exception1"/>
    <bpmn:sequenceFlow id="SequenceFlow_ExceptionEnd2" sourceRef="UserTask_DataReview" targetRef="EndEvent_Exception2"/>
    <bpmn:sequenceFlow id="SequenceFlow_ExceptionEnd3" sourceRef="UserTask_FinalReview" targetRef="EndEvent_Exception3"/>

  </bpmn:process>
</bpmn:definitions>