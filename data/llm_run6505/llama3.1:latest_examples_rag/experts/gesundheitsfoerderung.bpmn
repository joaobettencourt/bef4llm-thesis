<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                   xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                   xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                   id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_0">
    <bpmn:participant id="Participant_0" name="Programm zur betrieblichen Gesundheitsförderung"
                      processRef="Process_1"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_0"/>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="StartEvent_1" targetRef="Task_1"/>
    <bpmn:task id="Task_1" name="Gesundheits-Check">
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Task_1" targetRef="Gateway_1"/>
    <bpmn:exclusiveGateway id="Gateway_1">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Gateway_1" targetRef="Task_2"/>
    <bpmn:task id="Task_2" name="Trainings- und Ernährungspläne erstellen">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Gateway_1" targetRef="Task_3"/>
    <bpmn:task id="Task_3" name="Zusätzliche Ernährungsberatung">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_2" targetRef="Gateway_2"/>
    <bpmn:exclusiveGateway id="Gateway_2">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_3" targetRef="Gateway_2"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Gateway_2" targetRef="Task_4"/>
    <bpmn:task id="Task_4" name="Zwischen-Check">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Gateway_2" targetRef="Task_5"/>
    <bpmn:task id="Task_5" name="Fortsetzung des Trainings">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_4" targetRef="Gateway_3"/>
    <bpmn:exclusiveGateway id="Gateway_3">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_5" targetRef="Gateway_3"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Gateway_3" targetRef="EndEvent_1"/>
    <bpmn:endEvent id="EndEvent_1">
      <bpmn:incoming>Flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Gateway_3" targetRef="Task_6"/>
    <bpmn:task id="Task_6" name="Abschluss-Check">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_6" targetRef="EndEvent_2"/>
    <bpmn:endEvent id="EndEvent_2">
      <bpmn:incoming>Flow_12</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>