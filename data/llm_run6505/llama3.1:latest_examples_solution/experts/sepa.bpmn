<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_1"
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="true">
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>SequenceFlow_0a2wq6i</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Sequence Flow 1 -->
    <bpmn:sequenceFlow id="SequenceFlow_0a2wq6i"
                       sourceRef="StartEvent_1" targetRef="Task_0jsoxba"/>

    <!-- Task 1 -->
    <bpmn:task id="Task_0jsoxba" name="Get order from client">
      <bpmn:incoming>SequenceFlow_0a2wq6i</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_14g9mz2</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow 2 -->
    <bpmn:sequenceFlow id="SequenceFlow_14g9mz2"
                       sourceRef="Task_0jsoxba" targetRef="ExclusiveGateway_1dgb4sg"/>

    <!-- Exclusive Gateway 1 -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_1dgb4sg">
      <bpmn:incoming>SequenceFlow_14g9mz2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0kz5g1t</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flow 3 -->
    <bpmn:sequenceFlow id="SequenceFlow_0kz5g1t"
                       sourceRef="ExclusiveGateway_1dgb4sg" targetRef="Task_05ftug5"/>

    <!-- Task 2 -->
    <bpmn:task id="Task_05ftug5" name="Get products from warehouse">
      <bpmn:incoming>SequenceFlow_0kz5g1t</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1pq8ub3</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow 4 -->
    <bpmn:sequenceFlow id="SequenceFlow_1pq8ub3"
                       sourceRef="Task_05ftug5" targetRef="ExclusiveGateway_1ouv9kf"/>

    <!-- Exclusive Gateway 2 -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_1ouv9kf">
      <bpmn:incoming>SequenceFlow_1pq8ub3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0ajhekx</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flow 5 -->
    <bpmn:sequenceFlow id="SequenceFlow_0ajhekx"
                       sourceRef="ExclusiveGateway_1ouv9kf" targetRef="EndEvent_1fx9yp3"/>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_1fx9yp3">
      <bpmn:incoming>SequenceFlow_0ajhekx</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>