<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_HealthProgram">
  <bpmn:collaboration id="Collab_HealthPromotion">
    <bpmn:participant id="Pool_SalesProcess" name="Gesundheitsförderungsprogramm" processRef="Process_Gesundheit"></bpmn:participant>
  </bpmn:collaboration>

  <bpmn:process id="Process_Gesundheit" isExecutable="false">
    <!-- Lane Set -->
    <bpmn:laneSet id="LaneSet_01">
      <bpmn:lane id="Lane_Coach" name="Gesundheitscoach/Sportmediziner">
        <bpmn:flowNodeRef>StartEvent_Health</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GesundheitCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TrainingsPlanErstellen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_6MonatePruefung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_DatumErmitteln1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_VergleichDatum1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ZwischenCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_GruppenAufteilung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_DatumErmitteln2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_VergleichDatum2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_12MonatePruefung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AbschlussCheck</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Participant" name="Teilnehmer">
        <bpmn:flowNodeRef>Gateway_StartParallel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EinweisungAppWearables</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TrainingPhase1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Naehrungsberatung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ErnaehrungsberatungInanspruchnehmen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GroupA_TrainingPhase2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GroupB_TrainingPhase2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Health" name="Programmstart">
      <bpmn:outgoing>bpmn:SequenceFlow_StartToParallel</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Parallel Gateway for Initial Phase (Check vs Instruction) -->
    <bpmn:exclusiveGateway id="Gateway_StartParallel" name="Startphase">
      <bpmn:incoming>bpmn:SequenceFlow_StartToParallel</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_ToHealthCheck</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 1: Health Check (Coach) -->
    <bpmn:task id="Task_GesundheitCheck" name="Gesundheitscheck durchführen">
      <bpmn:incoming>bpmn:SequenceFlow_ToHealthCheck</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_CheckToPlan</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: Instruction (Participant) -->
    <bpmn:task id="Task_EinweisungAppWearables" name="Einweisung in App und Wearables">
      <bpmn:incoming>bpmn:SequenceFlow_StartToParallel</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_InstructionMerge</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3: Create Plan (Coach) -->
    <bpmn:task id="Task_TrainingsPlanErstellen" name="Trainings- und Ernährungsplan erstellen">
      <bpmn:incoming>bpmn:SequenceFlow_CheckToPlan</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_PlanToTrainingStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Merge Point for Start Phase -->
    <bpmn:exclusiveGateway id="Gateway_StartMerge" name="Startphase abgeschlossen">
      <bpmn:incoming>bpmn:SequenceFlow_InstructionMerge</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_PlanToTrainingStart</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 4: Training Phase 1 (Participant) -->
    <bpmn:task id="Task_TrainingPhase1" name="Individuelles Trainingsprogramm durchlaufen">
      <bpmn:incoming>bpmn:SequenceFlow_PlanToTrainingStart</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_TrainToCheckDate</bpmn:outgoing>
    </bpmn:task>

    <!-- Optional Nutrition Counseling Path -->
    <bpmn:exclusiveGateway id="Gateway_Naehrungsberatung" name="Ernährungsberatung nötig?">
      <bpmn:incoming>bpmn:SequenceFlow_TrainToCheckDate</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_ToCounseling</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 5: Nutrition Counseling (Participant) -->
    <bpmn:task id="Task_ErnaehrungsberatungInanspruchnehmen" name="Ernährungsberatung in Anspruch nehmen">
      <bpmn:incoming>bpmn:SequenceFlow_ToCounseling</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_CounselingMerge</bpmn:outgoing>
    </bpmn:task>

    <!-- Merge Counseling back to Flow -->
    <bpmn:exclusiveGateway id="Gateway_TrainLoop" name="Training Phase 1">
      <bpmn:incoming>bpmn:SequenceFlow_CounselingMerge</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_CheckDate6Months</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Date Check Logic for 6 Months (Coach Lane) -->
    <bpmn:serviceTask id="ServiceTask_DatumErmitteln1" name="Startdatum ermitteln">
      <bpmn:incoming>bpmn:SequenceFlow_TrainToCheckDate</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_DateCompare6M</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_6MonatePruefung" name="Trainingsintervall von 6 Monaten durchlaufen?">
      <bpmn:incoming>bpmn:SequenceFlow_DateCompare6M</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_TrainLoopBack</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Date Comparison Service Task -->
    <bpmn:serviceTask id="ServiceTask_VergleichDatum1" name="Vergleiche Startdatum mit ermitteltem Datum">
      <bpmn:incoming>bpmn:SequenceFlow_DateCompare6M</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_IfNotPassed</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Intermediate Check (Coach) -->
    <bpmn:task id="Task_ZwischenCheck" name="Zwischen-Check durchführen">
      <bpmn:incoming>bpmn:SequenceFlow_IfNotPassed</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_CheckToSplit</bpmn:outgoing>
    </bpmn:task>

    <!-- Group Split Gateway -->
    <bpmn:exclusiveGateway id="Gateway_GruppenAufteilung" name="Gruppeneinteilung">
      <bpmn:incoming>bpmn:SequenceFlow_CheckToSplit</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_GroupAPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Group A Training (Participant) -->
    <bpmn:task id="GroupA_TrainingPhase2" name="Eigenständiges Training ohne Wearables">
      <bpmn:incoming>bpmn:SequenceFlow_GroupAPath</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_AToFinalCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Group B Training (Participant) -->
    <bpmn:exclusiveGateway id="Gateway_GroupB" name="Gruppeneinteilung">
      <bpmn:incoming>bpmn:SequenceFlow_CheckToSplit</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_GroupBPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task for Group B -->
    <bpmn:task id="GroupB_TrainingPhase2" name="Training mit App/Wearable Unterstützung">
      <bpmn:incoming>bpmn:SequenceFlow_GroupBPath</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_BToFinalCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Time Check for End of Program (Coach) -->
    <bpmn:serviceTask id="ServiceTask_DatumErmitteln2" name="Programmstartdatum ermitteln">
      <bpmn:incoming>bpmn:SequenceFlow_AToFinalCheck</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_DateCompare12M</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Date Comparison for 12 Months -->
    <bpmn:exclusiveGateway id="Gateway_12MonatePruefung" name="Trainingsintervall von 12 Monaten durchlaufen?">
      <bpmn:incoming>bpmn:SequenceFlow_DateCompare12M</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_ProgramEnds</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Final Check Task -->
    <bpmn:task id="Task_AbschlussCheck" name="Abschließender Gesundheits-Check">
      <bpmn:incoming>bpmn:SequenceFlow_ProgramEnds</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_ToEndEvent</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Health" name="Programmende">
      <bpmn:incoming>bpmn:SequenceFlow_ToEndEvent</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows Connections (Corrected for Logic) -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToParallel" sourceRef="StartEvent_Health" targetRef="Gateway_StartParallel"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_ToHealthCheck" name="Gesundheitscheck starten" sourceRef="Gateway_StartParallel" targetRef="Task_GesundheitCheck"></bpmn:sequenceFlow>

    <!-- Instruction Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_InstructionMerge" sourceRef="Task_EinweisungAppWearables" targetRef="Gateway_StartMerge"></bpmn:sequenceFlow>

    <!-- Plan Creation Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckToPlan" name="Datenbasis vorhanden" sourceRef="Task_GesundheitCheck" targetRef="Task_TrainingsPlanErstellen"></bpmn:sequenceFlow>

    <!-- Training Start Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_PlanToTrainingStart" sourceRef="Gateway_StartMerge" targetRef="Task_TrainingPhase1"></bpmn:sequenceFlow>

    <!-- Counseling Path Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_ToCounseling" name="Beratung gewünscht?" sourceRef="Gateway_Naehrungsberatung" targetRef="Task_ErnaehrungsberatungInanspruchnehmen"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_CounselingMerge" sourceRef="Task_ErnaehrungsberatungInanspruchnehmen" targetRef="Gateway_TrainLoop"></bpmn:sequenceFlow>

    <!-- Time Check Flows (Logic Representation) -->
    <bpmn:sequenceFlow id="SequenceFlow_DateCompare6M" name="Ja; 6 Monate erreicht" sourceRef="ServiceTask_VergleichDatum1" targetRef="Gateway_6MonatePruefung"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_TrainLoopBack" name="Nein; Differenz &lt;6 Monate" sourceRef="Gateway_6MonatePruefung" targetRef="Task_TrainingPhase1"></bpmn:sequenceFlow>

    <!-- Intermediate Check Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckToSplit" name="Check abgeschlossen" sourceRef="Task_ZwischenCheck" targetRef="Gateway_GruppenAufteilung"></bpmn:sequenceFlow>

    <!-- Group Split Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_GroupAPath" name="Gruppe A (ohne Wearables)" sourceRef="Gateway_GruppenAufteilung" targetRef="GroupA_TrainingPhase2"></bpmn:sequenceFlow>
    
    <bpmn:sequenceFlow id="SequenceFlow_GroupBPath" name="Gruppe B (mit Support)" sourceRef="Gateway_GroupB" targetRef="GroupB_TrainingPhase2"></bpmn:sequenceFlow>

    <!-- End Check Flows -->
    <bpmn:serviceTask id="ServiceTask_VergleichDatum2" name="Vergleiche Startdatum mit ermitteltem Datum">
      <bpmn:incoming>bpmn:SequenceFlow_AToFinalCheck</bpmn:incoming> 
      <bpmn:outgoing>bpmn:SequenceFlow_DateCompare12M</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Simplified Merge for End Check Logic -->
    <bpmn:sequenceFlow id="SequenceFlow_AToFinalCheck" sourceRef="GroupA_TrainingPhase2" targetRef="ServiceTask_DatumErmitteln2"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_BToFinalCheck" name="Training Phase 2 Ende" sourceRef="GroupB_TrainingPhase2" targetRef="Gateway_12MonatePruefung"></bpmn:sequenceFlow>

    <!-- Final Check Logic -->
    <bpmn:sequenceFlow id="SequenceFlow_DateCompare12M" name="Ja; 12 Monate erreicht" sourceRef="ServiceTask_VergleichDatum2" targetRef="Gateway_12MonatePruefung"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_ProgramEnds" name="Programmende" sourceRef="Gateway_12MonatePruefung" targetRef="Task_AbschlussCheck"></bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>