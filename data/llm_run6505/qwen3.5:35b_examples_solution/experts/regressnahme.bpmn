<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Regress_001" targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:collaboration id="Collab_RegressProcess">
    <bpmn:participant id="Pool_SachbearbeiterRegress" name="Sachbearbeiter Regressnahme" processRef="Process_RegressHandling"></bpmn:participant>
  </bpmn:collaboration>

  <bpmn:process id="Process_RegressHandling" isExecutable="false">

    <!-- Lane Set -->
    <bpmn:laneSet id="LaneSet_01">
      <bpmn:lane id="Lane_Sachbearbeiter" name="Sachbearbeiter">
        <bpmn:flowNodeRef>StartEvent_Regress</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FallPruefen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RegressMoeglich</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EventBasedGateway_Wartezeiten</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Regress" name="Regressverdacht gemeldet">
      <bpmn:messageEventDefinition />
      <bpmn:outgoing>bpmn:SequenceFlow_StartToPruefen</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1 -->
    <bpmn:task id="Task_FallPruefen" name="Fall prüfen">
      <bpmn:incoming>bpmn:SequenceFlow_StartToPruefen</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_PruefenZuGateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway -->
    <bpmn:exclusiveGateway id="Gateway_RegressMoeglich" name="Regress möglich?">
      <bpmn:incoming>bpmn:SequenceFlow_PruefenZuGateway</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_JaWiedervorlage</bpmn:outgoing>
      <bpmn:outgoing>bpmn:SequenceFlow_NeinSchliessen1</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 2 -->
    <bpmn:task id="Task_Zahlungsaufforderung" name="Zahlungsaufforderung an VN schicken">
      <bpmn:incoming>bpmn:SequenceFlow_JaWiedervorlage</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_AufforderungZuWiedervorlage</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3 -->
    <bpmn:task id="Task_VorgangSchliessen1" name="Vorgang schließen">
      <bpmn:incoming>bpmn:SequenceFlow_NeinSchliessen1</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_SchliessenZuEnde1</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 1 -->
    <bpmn:endEvent id="EndEvent_VorgangGeschlossen" name="Vorgang geschlossen">
      <bpmn:incoming>bpmn:SequenceFlow_SchliessenZuEnde1</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task 4 -->
    <bpmn:task id="Task_WiedervorlageSetzen" name="Vorgang auf Wiedervorlage setzen">
      <bpmn:incoming>bpmn:SequenceFlow_AufforderungZuWiedervorlage</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_WiedervorlageZuGateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Event-Based Gateway -->
    <bpmn:eventBasedGateway id="EventBasedGateway_Wartezeiten">
      <bpmn:incoming>bpmn:SequenceFlow_WiedervorlageZuGateway</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_ZaehleGeldEingang</bpmn:outgoing>
      <bpmn:outgoing>bpmn:SequenceFlow_ZaehleWiderspruch</bpmn:outgoing>
      <bpmn:outgoing>bpmn:SequenceFlow_ZaehleFristAblauf</bpmn:outgoing>
    </bpmn:eventBasedGateway>

    <!-- Intermediate Catch Event 1 -->
    <bpmn:intermediateCatchEvent id="Intermediate_GeldEingang" name="Geld eingegangen">
      <bpmn:messageEventDefinition />
      <bpmn:incoming>bpmn:SequenceFlow_ZaehleGeldEingang</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_EingangsZuVerbuchen</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task 5 -->
    <bpmn:task id="Task_GeldeingangVerbuchung" name="Geldeingang verbuchen">
      <bpmn:incoming>bpmn:SequenceFlow_EingangsZuVerbuchen</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_VerbuchungZuSchliessen2</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 6 -->
    <bpmn:task id="Task_Schliessen2" name="Vorgang schließen">
      <bpmn:incoming>bpmn:SequenceFlow_VerbuchungZuSchliessen2</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_ZumEnde3</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 2 -->
    <bpmn:endEvent id="EndEvent_VorgangGeschlossen2" name="Vorgang geschlossen">
      <bpmn:incoming>bpmn:SequenceFlow_ZumEnde3</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Intermediate Catch Event 2 -->
    <bpmn:intermediateCatchEvent id="Intermediate_Widerspruch" name="Widerspruch erhalten">
      <bpmn:messageEventDefinition />
      <bpmn:incoming>bpmn:SequenceFlow_ZaehleWiderspruch</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_WiderspruchZuPruefen</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task 7 -->
    <bpmn:task id="Task_WiderspruchPruefen" name="Widerspruch prüfen">
      <bpmn:incoming>bpmn:SequenceFlow_WiderspruchZuPruefen</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_PruefungZuGateway2</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway 2 -->
    <bpmn:exclusiveGateway id="Gateway_Gerechtfertigt" name="Gerechtfertigt?">
      <bpmn:incoming>bpmn:SequenceFlow_PruefungZuGateway2</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_JaSchliessen3</bpmn:outgoing>
      <bpmn:outgoing>bpmn:SequenceFlow_NeinInkasso1</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 8 -->
    <bpmn:task id="Task_Schliessen3" name="Vorgang schließen">
      <bpmn:incoming>bpmn:SequenceFlow_JaSchliessen3</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_ZumEnde4</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 3 -->
    <bpmn:endEvent id="EndEvent_VorgangGeschlossen3" name="Vorgang geschlossen">
      <bpmn:incoming>bpmn:SequenceFlow_ZumEnde4</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Intermediate Catch Event 3 -->
    <bpmn:intermediateCatchEvent id="Intermediate_FristAblauf" name="Wiedervorlage fällig">
      <bpmn:timerEventDefinition />
      <bpmn:incoming>bpmn:SequenceFlow_ZaehleFristAblauf</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_FristZuInkasso2</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task 9 -->
    <bpmn:task id="Task_Inkasso" name="Vorgang an Inkasso-Dienstleister geben">
      <bpmn:incoming>bpmn:SequenceFlow_FristZuInkasso2</bpmn:incoming>
      <bpmn:incoming>bpmn:SequenceFlow_NeinInkasso1</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_InkassoZumEnde5</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 4 -->
    <bpmn:endEvent id="EndEvent_VorgangOffen" name="Vorgang offen">
      <bpmn:incoming>bpmn:SequenceFlow_InkassoZumEnde5</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToPruefen" sourceRef="StartEvent_Regress" targetRef="Task_FallPruefen"></bpmn:sequenceFlow>
    
    <bpmn:sequenceFlow id="SequenceFlow_PruefenZuGateway" name="Regress möglich?" sourceRef="Task_FallPruefen" targetRef="Gateway_RegressMoeglich"></bpmn:sequenceFlow>

    <!-- Gateway Regress Moeglich -->
    <bpmn:sequenceFlow id="SequenceFlow_JaWiedervorlage" name="Ja" sourceRef="Gateway_RegressMoeglich" targetRef="Task_Zahlungsaufforderung"></bpmn:sequenceFlow>
    
    <bpmn:sequenceFlow id="SequenceFlow_NeinSchliessen1" name="Nein" sourceRef="Gateway_RegressMoeglich" targetRef="Task_VorgangSchliessen1"></bpmn:sequenceFlow>

    <!-- Task flows -->
    <bpmn:sequenceFlow id="SequenceFlow_AufforderungZuWiedervorlage" sourceRef="Task_Zahlungsaufforderung" targetRef="Task_WiedervorlageSetzen"></bpmn:sequenceFlow>
    
    <bpmn:sequenceFlow id="SequenceFlow_SchliessenZuEnde1" name="" sourceRef="Task_VorgangSchliessen1" targetRef="EndEvent_VorgangGeschlossen"></bpmn:sequenceFlow>

    <!-- Event Based Gateway flows -->
    <bpmn:sequenceFlow id="SequenceFlow_WiedervorlageZuGateway" sourceRef="Task_WiedervorlageSetzen" targetRef="EventBasedGateway_Wartezeiten"></bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ZaehleGeldEingang" name="" sourceRef="EventBasedGateway_Wartezeiten" targetRef="Intermediate_GeldEingang"></bpmn:sequenceFlow>
    
    <bpmn:sequenceFlow id="SequenceFlow_EingangsZuVerbuchen" sourceRef="Intermediate_GeldEingang" targetRef="Task_GeldeingangVerbuchung"></bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_VerbuchungZuSchliessen2" name="" sourceRef="Task_GeldeingangVerbuchung" targetRef="Task_Schliessen2"></bpmn:sequenceFlow>
    
    <bpmn:sequenceFlow id="SequenceFlow_ZumEnde3" name="" sourceRef="Task_Schliessen2" targetRef="EndEvent_VorgangGeschlossen2"></bpmn:sequenceFlow>

    <!-- Objection path -->
    <bpmn:sequenceFlow id="SequenceFlow_ZaehleWiderspruch" name="" sourceRef="EventBasedGateway_Wartezeiten" targetRef="Intermediate_Widerspruch"></bpmn:sequenceFlow>
    
    <bpmn:sequenceFlow id="SequenceFlow_WiderspruchZuPruefen" sourceRef="Intermediate_Widerspruch" targetRef="Task_WiderspruchPruefen"></bpmn:sequenceFlow>

    <!-- Gateway Gerechtfertigt -->
    <bpmn:sequenceFlow id="SequenceFlow_PruefungZuGateway2" name="" sourceRef="Task_WiderspruchPruefen" targetRef="Gateway_Gerechtfertigt"></bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_JaSchliessen3" name="Ja" sourceRef="Gateway_Gerechtfertigt" targetRef="Task_Schliessen3"></bpmn:sequenceFlow>
    
    <bpmn:sequenceFlow id="SequenceFlow_NeinInkasso1" name="Nein" sourceRef="Gateway_Gerechtfertigt" targetRef="Task_Inkasso"></bpmn:sequenceFlow>

    <!-- Deadline path -->
    <bpmn:sequenceFlow id="SequenceFlow_ZaehleFristAblauf" name="" sourceRef="EventBasedGateway_Wartezeiten" targetRef="Intermediate_FristAblauf"></bpmn:sequenceFlow>
    
    <bpmn:sequenceFlow id="SequenceFlow_FristZuInkasso2" sourceRef="Intermediate_FristAblauf" targetRef="Task_Inkasso"></bpmn:sequenceFlow>

    <!-- Final flow -->
    <bpmn:sequenceFlow id="SequenceFlow_ZumEnde4" name="" sourceRef="Task_Schliessen3" targetRef="EndEvent_VorgangGeschlossen3"></bpmn:sequenceFlow>
    
    <bpmn:sequenceFlow id="SequenceFlow_InkassoZumEnde5" name="" sourceRef="Task_Inkasso" targetRef="EndEvent_VorgangOffen"></bpmn:sequenceFlow>

  </bpmn:process>

</bpmn:definitions>