<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Regressforderung" targetNamespace="http://example.com/bpmn">

   <process id="regressforderung" isExecutable="true">
     <startEvent id="startEvent1">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="task1"/>

     <userTask id="task1" name="Prüfung des Falls">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
       <outgoing>sequenceFlow3</outgoing>
     </userTask>

     <exclusiveGateway id="exclusiveGateway1">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow4</outgoing>
       <outgoing>sequenceFlow5</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow2" sourceRef="task1" targetRef="exclusiveGateway1"/>
     <sequenceFlow id="sequenceFlow3" name="nein" sourceRef="task1" targetRef="endEvent1"/>

     <userTask id="task2" name="Zahlungsaufforderung">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow6</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow4" name="ja" sourceRef="exclusiveGateway1" targetRef="task2"/>

     <serviceTask id="task3" name="Wiedervorlage">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow7</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlow5" name="nein" sourceRef="exclusiveGateway1" targetRef="endEvent1"/>

     <sequenceFlow id="sequenceFlow6" sourceRef="task2" targetRef="task3"/>

     <intermediateCatchEvent id="catchEvent1">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow8</outgoing>
     </intermediateCatchEvent>

     <sequenceFlow id="sequenceFlow7" sourceRef="task3" targetRef="catchEvent1"/>

     <userTask id="task4" name="Eingang verbuchen">
       <incoming>sequenceFlow8</incoming>
       <outgoing>sequenceFlow9</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow8" sourceRef="catchEvent1" targetRef="task4"/>

     <endEvent id="endEvent2">
       <incoming>sequenceFlow9</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow9" sourceRef="task4" targetRef="exclusiveGateway2"/>

     <userTask id="task5" name="Widerspruch prüfen">
       <incoming>sequenceFlow10</incoming>
       <outgoing>sequenceFlow11</outgoing>
     </userTask>

     <exclusiveGateway id="exclusiveGateway2">
       <incoming>sequenceFlow9</incoming>
       <outgoing>sequenceFlow10</outgoing>
       <outgoing>sequenceFlow12</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow10" name="Widerspruch" sourceRef="exclusiveGateway2" targetRef="task5"/>

     <userTask id="task6" name="Inkasso">
       <incoming>sequenceFlow11</incoming>
       <outgoing>sequenceFlow13</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow11" name="nein" sourceRef="task5" targetRef="task6"/>

     <endEvent id="endEvent1">
       <incoming>sequenceFlow3</incoming>
       <incoming>sequenceFlow13</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow12" name="ja" sourceRef="exclusiveGateway2" targetRef="endEvent1"/>
     <sequenceFlow id="sequenceFlow13" sourceRef="task6" targetRef="endEvent1"/>

   </process>
</definitions>