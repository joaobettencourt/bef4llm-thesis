<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">

  <process id="fragebogenBearbeitung" isExecutable="true">
    <startEvent id="startEvent">
      <outgoing>sequenceFlow1</outgoing>
    </startEvent>

    <sequenceFlow id="sequenceFlow1" sourceRef="startEvent" targetRef="task1"/>

    <task id="task1" name="Fragebogen erfassen und verarbeiten">
      <incoming>sequenceFlow1</incoming>
      <outgoing>sequenceFlow2</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow2" sourceRef="task1" targetRef="exclusiveGateway1"/>

    <exclusiveGateway id="exclusiveGateway1">
      <incoming>sequenceFlow2</incoming>
      <outgoing>sequenceFlow3</outgoing>
      <outgoing>sequenceFlow4</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequenceFlow3" sourceRef="exclusiveGateway1" targetRef="task2">
      <conditionExpression xsi:type="tFormalExpression">partnerGefunden = true</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="sequenceFlow4" sourceRef="exclusiveGateway1" targetRef="userTask1">
      <conditionExpression xsi:type="tFormalExpression">partnerGefunden = false</conditionExpression>
    </sequenceFlow>

    <userTask id="userTask1" name="Partner manuell prüfen">
      <incoming>sequenceFlow4</incoming>
      <outgoing>sequenceFlow5</outgoing>
    </userTask>

    <sequenceFlow id="sequenceFlow5" sourceRef="userTask1" targetRef="task2"/>

    <task id="task2" name="Unternehmensdaten prüfen">
      <incoming>sequenceFlow3</incoming>
      <incoming>sequenceFlow5</incoming>
      <outgoing>sequenceFlow6</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow6" sourceRef="task2" targetRef="exclusiveGateway2"/>

    <exclusiveGateway id="exclusiveGateway2">
      <incoming>sequenceFlow6</incoming>
      <outgoing>sequenceFlow7</outgoing>
      <outgoing>sequenceFlow8</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequenceFlow7" sourceRef="exclusiveGateway2" targetRef="task3">
      <conditionExpression xsi:type="tFormalExpression">datenKorrekt = true</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="sequenceFlow8" sourceRef="exclusiveGateway2" targetRef="userTask2">
      <conditionExpression xsi:type="tFormalExpression">datenKorrekt = false</conditionExpression>
    </sequenceFlow>

    <userTask id="userTask2" name="Daten manuell prüfen">
      <incoming>sequenceFlow8</incoming>
      <outgoing>sequenceFlow9</outgoing>
    </userTask>

    <sequenceFlow id="sequenceFlow9" sourceRef="userTask2" targetRef="task3"/>

    <task id="task3" name="Meldezeitraum prüfen">
      <incoming>sequenceFlow7</incoming>
      <incoming>sequenceFlow9</incoming>
      <outgoing>sequenceFlow10</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow10" sourceRef="task3" targetRef="exclusiveGateway3"/>

    <exclusiveGateway id="exclusiveGateway3">
      <incoming>sequenceFlow10</incoming>
      <outgoing>sequenceFlow11</outgoing>
      <outgoing>sequenceFlow12</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequenceFlow11" sourceRef="exclusiveGateway3" targetRef="task4">
      <conditionExpression xsi:type="tFormalExpression">meldezeitraumVorhanden = true</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="sequenceFlow12" sourceRef="exclusiveGateway3" targetRef="userTask3">
      <conditionExpression xsi:type="tFormalExpression">meldezeitraumVorhanden = false</conditionExpression>
    </sequenceFlow>

    <userTask id="userTask3" name="Meldezeitraum anlegen">
      <incoming>sequenceFlow12</incoming>
      <outgoing>sequenceFlow13</outgoing>
    </userTask>

    <sequenceFlow id="sequenceFlow13" sourceRef="userTask3" targetRef="task4"/>

    <task id="task4" name="Kontaktdaten prüfen">
      <incoming>sequenceFlow11</incoming>
      <incoming>sequenceFlow13</incoming>
      <outgoing>sequenceFlow14</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow14" sourceRef="task4" targetRef="endEvent"/>

    <endEvent id="endEvent">
      <incoming>sequenceFlow14</incoming>
    </endEvent>
  </process>
</definitions>