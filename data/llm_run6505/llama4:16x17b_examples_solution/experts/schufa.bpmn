<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">

   <process id="schufaScoringProcess" isExecutable="true">
     <startEvent id="startEvent">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent" targetRef="task1"/>

     <serviceTask id="task1" name="Scoringanfrage senden">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlow2" sourceRef="task1" targetRef="eventBasedGateway1"/>

     <eventBasedGateway id="eventBasedGateway1">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
       <outgoing>sequenceFlow4</outgoing>
     </eventBasedGateway>

     <intermediateCatchEvent id="intermediateCatchEvent1" name="Schufascore verzögert">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow5</outgoing>
       <messageEventDefinition/>
     </intermediateCatchEvent>

     <sequenceFlow id="sequenceFlow3" sourceRef="eventBasedGateway1" targetRef="intermediateCatchEvent1"/>

     <task id="task2" name="Verzögerung melden">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow6</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow5" sourceRef="intermediateCatchEvent1" targetRef="task2"/>

     <sequenceFlow id="sequenceFlow6" sourceRef="task2" targetRef="exclusiveGateway1"/>

     <exclusiveGateway id="exclusiveGateway1">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow7</outgoing>
       <outgoing>sequenceFlow8</outgoing>
     </exclusiveGateway>

     <task id="task3" name="Scoring durchführen (level 2)">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow9</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow7" sourceRef="exclusiveGateway1" targetRef="task3"/>

     <task id="task4" name="Schufascore senden">
       <incoming>sequenceFlow9</incoming>
       <outgoing>sequenceFlow10</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow9" sourceRef="task3" targetRef="task4"/>

     <intermediateCatchEvent id="intermediateCatchEvent2" name="Schufascore sofort ermittelt">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow11</outgoing>
       <messageEventDefinition/>
     </intermediateCatchEvent>

     <sequenceFlow id="sequenceFlow4" sourceRef="eventBasedGateway1" targetRef="intermediateCatchEvent2"/>

     <sequenceFlow id="sequenceFlow10" sourceRef="task4" targetRef="endEvent1"/>
     <sequenceFlow id="sequenceFlow11" sourceRef="intermediateCatchEvent2" targetRef="endEvent1"/>

     <endEvent id="endEvent1">
       <!--<incoming>sequenceFlow10</incoming>
       <incoming>sequenceFlow11</incoming>-->
     </endEvent>

   </process>
</definitions>