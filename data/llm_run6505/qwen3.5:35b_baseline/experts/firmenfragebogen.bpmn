<?xml version="1.0" encoding="UTF-8"?>  
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_abc">  
  <bpmn:collaboration id="Collab_1">  
    <bpmn:participant id="Participant_A" name="Firmenfragebogen Bearbeitung" processRef="Process_X" />  
  </bpmn:collaboration>  

  <bpmn:process id="Process_X" isExecutable="false">  
    <bpmn:laneSet>  
      <bpmn:lane id="Lane_System" name="Systemautomatisierung">  
        <bpmn:flowNodeRef>Task_1</bpmn:flowNodeRef>  
        <bpmn:flowNodeRef>Gateway_PartnerSuche</bpmn:flowNodeRef>  
      </bpmn:lane>  
      <bpmn:lane id="Lane_Bearbeiter" name="Sachbearbeitung">  
        <bpmn:flowNodeRef>Task_2</bpmn:flowNodeRef>  
        <bpmn:flowNodeRef>Gateway_DatenPruefung</bpmn:flowNodeRef>  
        <bpmn:flowNodeRef>Task_3</bpmn:flowNodeRef>  
        <bpmn:flowNodeRef>Task_4</bpmn:flowNodeRef>  
        <bpmn:flowNodeRef>Gateway_ZeitraumPruefung</bpmn:flowNodeRef>  
        <bpmn:flowNodeRef>Task_5</bpmn:flowNodeRef>  
        <bpmn:flowNodeRef>Task_6</bpmn:flowNodeRef>  
      </bpmn:lane>  
    </bpmn:laneSet>  

    <!-- Start Event -->  
    <bpmn:startEvent id="Start_1" name="Firmenfragebogen Eingang">  
      <bpmn:outgoing>SequenceFlow_001</bpmn:outgoing>  
    </bpmn:startEvent>  

    <!-- Task 1: Erfassen und verarbeiten -->  
    <bpmn:task id="Task_1" name="Firmenfragebogen erfassen">  
      <bpmn:incoming>SequenceFlow_001</bpmn:incoming>  
      <bpmn:outgoing>SequenceFlow_002</bpmn:outgoing>  
    </bpmn:task>  

    <!-- Gateway 1: Partner Suche -->  
    <bpmn:exclusiveGateway id="Gateway_PartnerSuche" name="Partner gefunden?">  
      <bpmn:incoming>SequenceFlow_002</bpmn:incoming>  
      <bpmn:outgoing>SequenceFlow_003</bpmn:outgoing>  
      <bpmn:outgoing>SequenceFlow_004</bpmn:outgoing>  
    </bpmn:exclusiveGateway>  

    <!-- Sequence Flow 1 -->  
    <bpmn:sequenceFlow id="SequenceFlow_001" sourceRef="Start_1" targetRef="Task_1" />  

    <!-- Sequence Flow 2 -->  
    <bpmn:sequenceFlow id="SequenceFlow_002" name="automatische Suche" sourceRef="Task_1" targetRef="Gateway_PartnerSuche" />  

    <!-- Task Manuelle Prüfung (wenn kein Partner gefunden) -->  
    <bpmn:task id="Task_ManuellePruefung" name="Manuelle Prüfung">  
      <bpmn:incoming>SequenceFlow_003</bpmn:incoming>  
      <bpmn:outgoing>SequenceFlow_005</bpmn:outgoing>  
    </bpmn:task>  

    <!-- Sequence Flow 3 (kein Partner gefunden) -->  
    <bpmn:sequenceFlow id="SequenceFlow_003" name="nein - manuelle Prüfung" sourceRef="Gateway_PartnerSuche" targetRef="Task_ManuellePruefung" />  

    <!-- Gateway Datenprüfung -->  
    <bpmn:exclusiveGateway id="Gateway_DatenPruefung" name="Daten prüfen">  
      <bpmn:incoming>SequenceFlow_004</bpmn:incoming>  
      <bpmn:outgoing>SequenceFlow_006</bpmn:outgoing>  
    </bpmn:exclusiveGateway>  

    <!-- Sequence Flow 4 (ja - Zuordnung möglich) -->  
    <bpmn:sequenceFlow id="SequenceFlow_004" name="ja - Zuordnung möglich" sourceRef="Gateway_PartnerSuche" targetRef="Gateway_DatenPruefung" />  

    <!-- Task 2: Betriebsnummer prüfen -->  
    <bpmn:task id="Task_2" name="Betriebsnummer und Betriebsstättennummer kontrollieren">  
      <bpmn:incoming>SequenceFlow_006</bpmn:incoming>  
      <bpmn:outgoing>SequenceFlow_007</bpmn:outgoing>  
    </bpmn:task>  

    <!-- Sequence Flow 5 (von manueller Prüfung) -->  
    <bpmn:sequenceFlow id="SequenceFlow_005" sourceRef="Task_ManuellePruefung" targetRef="Gateway_DatenPruefung" />  

    <!-- Task 3: U1-Verfahren und Insolvenzrücklage prüfen -->  
    <bpmn:task id="Task_3" name="U1-Verfahren und Insolvenzrücklage prüfen">  
      <bpmn:incoming>SequenceFlow_007</bpmn:incoming>  
      <bpmn:outgoing>SequenceFlow_008</bpmn:outgoing>  
    </bpmn:task>  

    <!-- Sequence Flow 6 -->  
    <bpmn:sequenceFlow id="SequenceFlow_006" sourceRef="Gateway_DatenPruefung" targetRef="Task_2" />  

    <!-- Task 4: Arbeitgeber identifizieren und Meldezeitraum prüfen -->  
    <bpmn:task id="Task_4" name="Arbeitgeber eindeutig identifizieren">  
      <bpmn:incoming>SequenceFlow_008</bpmn:incoming>  
      <bpmn:outgoing>SequenceFlow_009</bpmn:outgoing>  
    </bpmn:task>  

    <!-- Sequence Flow 7 -->  
    <bpmn:sequenceFlow id="SequenceFlow_007" sourceRef="Task_2" targetRef="Task_3" />  

    <!-- Task 5: Meldezeitraum kontrollieren und Umlageversicherungszeiten prüfen/erstellen -->  
    <bpmn:task id="Task_5" name="Meldezeitraum kontrollieren">  
      <bpmn:incoming>SequenceFlow_009</bpmn:incoming>  
      <bpmn:outgoing>SequenceFlow_010</bpmn:outgoing>  
    </bpmn:task>  

    <!-- Sequence Flow 8 -->  
    <bpmn:sequenceFlow id="SequenceFlow_008" sourceRef="Task_3" targetRef="Task_4" />  

    <!-- Gateway Zeitraumprüfung -->  
    <bpmn:exclusiveGateway id="Gateway_ZeitraumPruefung" name="Umlageversicherungszeiten vorhanden?">  
      <bpmn:incoming>SequenceFlow_010</bpmn:incoming>  
      <bpmn:outgoing>SequenceFlow_011</bpmn:outgoing>  
      <bpmn:outgoing>SequenceFlow_012</bpmn:outgoing>  
    </bpmn:exclusiveGateway>  

    <!-- Sequence Flow 9 -->  
    <bpmn:sequenceFlow id="SequenceFlow_009" sourceRef="Task_4" targetRef="Task_5" />  

    <!-- Task 6a: Umlageversicherungszeiten überprüfen (wenn vorhanden) -->  
    <bpmn:task id="Task_6a" name="Umlageversicherungszeiten überprüfen">  
      <bpmn:incoming>SequenceFlow_011</bpmn:incoming>  
      <bpmn:outgoing>SequenceFlow_013</bpmn:outgoing>  
    </bpmn:task>  

    <!-- Sequence Flow 10 (ja) -->  
    <bpmn:sequenceFlow id="SequenceFlow_010" sourceRef="Task_5" targetRef="Gateway_ZeitraumPruefung" />  

    <!-- Task 6b: Umlageversicherungszeiten neu anlegen (wenn nicht vorhanden) -->  
    <bpmn:task id="Task_7" name="Umlageversicherungszeiten neu anlegen">  
      <bpmn:incoming>SequenceFlow_012</bpmn:incoming>  
      <bpmn:outgoing>SequenceFlow_014</bpmn:outgoing>  
    </bpmn:task>  

    <!-- Sequence Flow 11 (ja - vorhanden) -->  
    <bpmn:sequenceFlow id="SequenceFlow_011" name="ja - vorhanden" sourceRef="Gateway_ZeitraumPruefung" targetRef="Task_6a" />  

    <!-- Task 8: Kontaktdaten überprüfen -->  
    <bpmn:task id="Task_6" name="Kontaktdaten (Telefon, Fax, Adresse) prüfen">  
      <bpmn:incoming>SequenceFlow_013</bpmn:incoming>  
      <bpmn:outgoing>SequenceFlow_015</bpmn:outgoing>  
    </bpmn:task>  

    <!-- Sequence Flow 12 (nein - nicht vorhanden) -->  
    <bpmn:sequenceFlow id="SequenceFlow_012" name="nein - nicht vorhanden" sourceRef="Gateway_ZeitraumPruefung" targetRef="Task_7" />  

    <!-- Gateway Problemprüfung -->  
    <bpmn:exclusiveGateway id="Gateway_ProblemPruefung" name="Problem aufgetreten?">  
      <bpmn:incoming>SequenceFlow_015</bpmn:incoming>  
      <bpmn:outgoing>SequenceFlow_016</bpmn:outgoing>  
      <bpmn:outgoing>SequenceFlow_017</bpmn:outgoing>  
    </bpmn:exclusiveGateway>  

    <!-- Sequence Flow 13 (nach Task_6a) -->  
    <bpmn:sequenceFlow id="SequenceFlow_013" sourceRef="Task_6a" targetRef="Task_6" />  

    <!-- Sequence Flow 14 (nach Task_7) -->  
    <bpmn:sequenceFlow id="SequenceFlow_014" sourceRef="Task_7" targetRef="Task_6" />  

    <!-- Sequence Flow 15 -->  
    <bpmn:sequenceFlow id="SequenceFlow_015" sourceRef="Task_6" targetRef="Gateway_ProblemPruefung" />  

    <!-- Task Mitarbeiterweiterleitung (bei Problemen) -->  
    <bpmn:task id="Task_MitarbeiterWeiterleitung" name="An zuständigen Mitarbeiter übergeben">  
      <bpmn:incoming>SequenceFlow_017</bpmn:incoming>  
      <bpmn:outgoing>SequenceFlow_018</bpmn:outgoing>  
    </bpmn:task>  

    <!-- Sequence Flow 16 (Problem aufgetreten) -->  
    <bpmn:sequenceFlow id="SequenceFlow_017" name="ja - Problem vorhanden" sourceRef="Gateway_ProblemPruefung" targetRef="Task_MitarbeiterWeiterleitung" />  

    <!-- End Event bei erfolgreicher Bearbeitung -->  
    <bpmn:endEvent id="End_Successful" name="Bearbeitung abgeschlossen">  
      <bpmn:incoming>SequenceFlow_016</bpmn:incoming>  
    </bpmn:endEvent>  

    <!-- Sequence Flow 17 (kein Problem) -->  
    <bpmn:sequenceFlow id="SequenceFlow_016" name="nein - kein Problem" sourceRef="Gateway_ProblemPruefung" targetRef="End_Successful" />  

    <!-- End Event bei Mitarbeiterweiterleitung -->  
    <bpmn:endEvent id="End_EmployeeHandled" name="An Mitarbeiter übergeben">  
      <bpmn:incoming>SequenceFlow_018</bpmn:incoming>  
    </bpmn:endEvent>  

  </bpmn:process>  
</bpmn:definitions>