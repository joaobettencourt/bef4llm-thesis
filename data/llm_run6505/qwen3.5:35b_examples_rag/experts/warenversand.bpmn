<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1a8xq7f">
    <bpmn:participant id="Participant_1p4r6w2" name="Order Processing Process" processRef="Process_1" />
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_0s6x3q5">
      <bpmn:lane id="Lane_Secretary" name="Secretary">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_AdminMerge_0g3x8p2</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Logistics" name="Logistics Manager">
        <bpmn:flowNodeRef>Task_ConcludeInsurance_4x7s3r1</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Warehouse" name="Warehouse Worker">
        <bpmn:flowNodeRef>InclusiveGateway_AdminMerge_0g3x8p2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PackGoods_5k9r4x1</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneset>

    <!-- Flow Elements -->
    <bpmn:startEvent id="StartEvent_1" name="Ship goods">
      <bpmn:outgoing>SequenceFlow_SplitAdminPacking</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:parallelGateway id="ParallelGateway_AdminSplit_0p7m3k4" name="Start Admin &amp; Packing">
      <bpmn:incoming>SequenceFlow_SplitAdminPacking</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AdminBranch</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PackingBranch</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Admin Branch -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_LargeQty_1r6s8t5" name="Large Quantity?">
      <bpmn:incoming>SequenceFlow_AdminBranch</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SpecialShipping</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NormalShipping</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Large Quantity Path -->
    <bpmn:task id="Task_GetOffers_2p8s4x5" name="Get offers from 3 forwarders">
      <bpmn:incoming>SequenceFlow_SpecialShipping</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OrderCarrier</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_SelectOrder_0m4h9k7" name="Select carrier and place order">
      <bpmn:incoming>SequenceFlow_OrderCarrier</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AdminPathLargeEnd</bpmn:outgoing>
    </bpmn:task>

    <!-- Small Quantity Path -->
    <bpmn:task id="Task_FillLabel_0jsoxba" name="Fill standardized shipping label">
      <bpmn:incoming>SequenceFlow_NormalShipping</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckInsurance</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="ExclusiveGateway_InsurNeeded_1dgb4sg" name="Insurance required?">
      <bpmn:incoming>SequenceFlow_CheckInsurance</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConcludeInsur</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SkipInsur</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Insurance Task (Logistics Manager) -->
    <bpmn:task id="Task_ConcludeInsurance_4x7s3r1" name="Conclude insurance">
      <bpmn:incoming>SequenceFlow_ConcludeInsur</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AdminPathSmallEnd</bpmn:outgoing>
    </bpmn:task>

    <!-- Merge Admin Paths -->
    <bpmn:inclusiveGateway id="InclusiveGateway_AdminMerge_0g3x8p2" name="Admin Prep Complete">
      <bpmn:incoming>SequenceFlow_AdminPathLargeEnd</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_SkipInsur</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_AdminPathSmallEnd</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToFinalJoin</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Packing Branch -->
    <bpmn:task id="Task_PackGoods_5k9r4x1" name="Pack goods">
      <bpmn:incoming>SequenceFlow_PackingBranch</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToFinalJoin</bpmn:outgoing>
    </bpmn:task>

    <!-- Final Join & Task -->
    <bpmn:parallelGateway id="ParallelGateway_Final_0z5sib0" name="All Prep Done">
      <bpmn:incoming>SequenceFlow_ToFinalJoin</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PreparePickup</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:task id="Task_PreparePickup_0sl26uo" name="Prepare goods for pickup">
      <bpmn:incoming>SequenceFlow_PreparePickup</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndProcess</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_1fx9yp3" name="Shipment prepared">
      <bpmn:incoming>SequenceFlow_EndProcess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_SplitAdminPacking" sourceRef="StartEvent_1" targetRef="ParallelGateway_AdminSplit_0p7m3k4" />
    
    <bpmn:sequenceFlow id="SequenceFlow_AdminBranch" name="Admin Process" sourceRef="ParallelGateway_AdminSplit_0p7m3k4" targetRef="ExclusiveGateway_LargeQty_1r6s8t5" />
    <bpmn:sequenceFlow id="SequenceFlow_PackingBranch" name="Packing Process" sourceRef="ParallelGateway_AdminSplit_0p7m3k4" targetRef="Task_PackGoods_5k9r4x1" />

    <!-- Admin Branch Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_SpecialShipping" name="Large Quantity (Yes)" sourceRef="ExclusiveGateway_LargeQty_1r6s8t5" targetRef="Task_GetOffers_2p8s4x5" />
    <bpmn:sequenceFlow id="SequenceFlow_OrderCarrier" sourceRef="Task_GetOffers_2p8s4x5" targetRef="Task_SelectOrder_0m4h9k7" />
    <bpmn:sequenceFlow id="SequenceFlow_AdminPathLargeEnd" name="Admin Done (Special)" sourceRef="Task_SelectOrder_0m4h9k7" targetRef="InclusiveGateway_AdminMerge_0g3x8p2" />

    <bpmn:sequenceFlow id="SequenceFlow_NormalShipping" name="Small Quantity (No)" sourceRef="ExclusiveGateway_LargeQty_1r6s8t5" targetRef="Task_FillLabel_0jsoxba" />
    <bpmn:sequenceFlow id="SequenceFlow_CheckInsurance" sourceRef="Task_FillLabel_0jsoxba" targetRef="ExclusiveGateway_InsurNeeded_1dgb4sg" />

    <!-- Insurance Decision Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_ConcludeInsur" name="Yes (Need Ins)" sourceRef="ExclusiveGateway_InsurNeeded_1dgb4sg" targetRef="Task_ConcludeInsurance_4x7s3r1" />
    <bpmn:sequenceFlow id="SequenceFlow_SkipInsur" name="No (Skip Ins)" sourceRef="ExclusiveGateway_InsurNeeded_1dgb4sg" targetRef="InclusiveGateway_AdminMerge_0g3x8p2" />

    <!-- Small Path End Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_AdminPathSmallEnd" name="Admin Done (Normal)" sourceRef="Task_ConcludeInsurance_4x7s3r1" targetRef="InclusiveGateway_AdminMerge_0g3x8p2" />

    <!-- Final Join Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_ToFinalJoin" name="Admin &amp; Packing Done" sourceRef="Task_PackGoods_5k9r4x1" targetRef="ParallelGateway_Final_0z5sib0" />

    <!-- Final Task Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_PreparePickup" name="All Prep Complete" sourceRef="ParallelGateway_Final_0z5sib0" targetRef="Task_PreparePickup_0sl26uo" />
    
    <bpmn:sequenceFlow id="SequenceFlow_EndProcess" sourceRef="Task_PreparePickup_0sl26uo" targetRef="EndEvent_1fx9yp3" />

  </bpmn:process>
</bpmn:definitions>