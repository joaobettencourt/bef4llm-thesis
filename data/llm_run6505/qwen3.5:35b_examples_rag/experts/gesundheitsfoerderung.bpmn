<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_HealthPromotion" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_Gesundheitsprogramm">
    <bpmn:participant id="Participant_Gesundheitsprogramm" name="Programm zur betrieblichen Gesundheitsförderung" processRef="Process_1" />
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:laneSet id="LaneSet_Gesundheitsprogramm">
      <bpmn:lane id="Lane_Teilnehmer" name="Teilnehmer">
        <bpmn:flowNodeRef>StartEvent_Programmstart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_Vorbereitung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_AppEinweisung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_Training1Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_ZwischenCheckSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_TrainOhneWearables</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_TrainMitApp</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Coaches" name="Gesundheitscoaches">
        <bpmn:flowNodeRef>InclusiveGateway_Vorbereitung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_GesundheitsCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_PlaeneErstellen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_Training1Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_ZwischenCheckSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_Ernaehrungsberatung</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Programmstart" name="Programmstart">
      <bpmn:outgoing>SequenceFlow_StartToVorbereitung</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Initial Phase Gateway (Parallel) -->
    <bpmn:inclusiveGateway id="InclusiveGateway_Vorbereitung" name="Vorbereitung">
      <bpmn:incoming>SequenceFlow_StartToVorbereitung</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckTask</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Health Check Task (Coaches) -->
    <bpmn:userTask id="UserTask_GesundheitsCheck" name="Gesundheits-Check durchführen">
      <bpmn:incoming>SequenceFlow_CheckTask</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckToJoin1</bpmn:outgoing>
    </bpmn:userTask>

    <!-- App Instruction Task (Participants) -->
    <bpmn:userTask id="UserTask_AppEinweisung" name="Einweisung in App &amp; Wearables">
      <bpmn:incoming>SequenceFlow_StartToVorbereitung</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_InstToJoin1</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Join after Initial Phase -->
    <bpmn:parallelGateway id="ParallelGateway_VorbereitungEnde" name="Vorbereitung abgeschlossen">
      <bpmn:incoming>SequenceFlow_CheckToJoin1</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_InstToJoin1</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Planning Task (Coaches) -->
    <bpmn:userTask id="UserTask_PlaeneErstellen" name="Trainings- und Ernährungspläne erstellen">
      <bpmn:incoming>SequenceFlow_VorbereitungEndeToPlanning</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_Training1Start</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Training Phase 1 Split (Parallel) -->
    <bpmn:parallelGateway id="InclusiveGateway_Training1Start" name="Training starten">
      <bpmn:incoming>SequenceFlow_Training1Start</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_MainTrain1</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Training Task 1 -->
    <bpmn:userTask id="UserTask_TrainPhase1" name="Training Phase 1 (6 Monate)">
      <bpmn:incoming>SequenceFlow_MainTrain1</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_MidCheckIn</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Optional Counseling Task -->
    <bpmn:userTask id="UserTask_Ernaehrungsberatung" name="Ernährungsberatung (optional)">
      <bpmn:incoming>SequenceFlow_CounselingStart</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_MidCheckIn2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Mid Check -->
    <bpmn:parallelGateway id="ParallelGateway_ZwischenCheckSplit" name="Zwischen-Check">
      <bpmn:incoming>SequenceFlow_MidCheckIn</bpmn:outgoing>
      <bpmn:incoming>SequenceFlow_MidCheckIn2</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Split Decision -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_Gruppenzuweisung" name="Gruppenzuweisung">
      <bpmn:incoming>SequenceFlow_DecisionOut</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_GroupAPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Training Phase 2 Group A -->
    <bpmn:userTask id="UserTask_TrainOhneWearables" name="Training ohne Wearables">
      <bpmn:incoming>SequenceFlow_GroupAPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_FinalCheckIn</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Training Phase 2 Group B -->
    <bpmn:userTask id="UserTask_TrainMitApp" name="Training mit App/Wearables">
      <bpmn:incoming>SequenceFlow_GroupBPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_FinalCheckIn2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Final Check -->
    <bpmn:userTask id="UserTask_AbschlussCheck" name="Abschluss-Check &amp; Auswertung">
      <bpmn:incoming>SequenceFlow_FinalCheckIn</bpmn:outgoing>
      <bpmn:incoming>SequenceFlow_FinalCheckIn2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Programmende" name="Programmende">
      <bpmn:incoming>SequenceFlow_EndProgram</bpmn:outgoing>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>