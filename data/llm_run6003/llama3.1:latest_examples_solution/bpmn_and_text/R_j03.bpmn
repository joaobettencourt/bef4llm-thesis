<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
                  targetNamespace="http://bpmn.io/schema/bpmn" id="Definitions_1">
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Fridge makes strange noises">
      <bpmn:outgoing>SequenceFlow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="ParallelGateway_1" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow_0</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="UserTask_1" name="Describe the symptoms">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask_1" name="Schedule an appointment for fridge repair">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_1">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    <bpmn:manualTask id="ManualTask_1" name="Repair the fridge">
      <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway_1" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask_2" name="Send a report to the fridge service center">
      <bpmn:incoming>SequenceFlow_7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask_2" name="Select local service facility">
      <bpmn:incoming>SequenceFlow_8</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway_2" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow_9</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_11</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask_3" name="Collect additional parts in warehouse">
      <bpmn:incoming>SequenceFlow_11</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask_3" name="Service orders additional parts">
      <bpmn:incoming>SequenceFlow_12</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_2">
      <bpmn:incoming>SequenceFlow_14</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_15</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="UserTask_4" name="Rate Service Facility">
      <bpmn:incoming>SequenceFlow_15</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_1" name="Rapair is process over">
      <bpmn:incoming>SequenceFlow_16</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:sequenceFlow id="SequenceFlow_0" sourceRef="StartEvent_1" targetRef="ParallelGateway_1"/>
  <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="ParallelGateway_1" targetRef="UserTask_1"/>
  <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="ParallelGateway_1" targetRef="ServiceTask_1"/>
  <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="UserTask_1" targetRef="ExclusiveGateway_1"/>
  <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="ServiceTask_1" targetRef="IntermediateCatchEvent_1"/>
  <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="IntermediateCatchEvent_1" targetRef="ManualTask_1"/>
  <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="ManualTask_1" targetRef="ExclusiveGateway_1"/>
  <bpmn:sequenceFlow id="SequenceFlow_7" sourceRef="ExclusiveGateway_1" targetRef="UserTask_2"/>
  <bpmn:sequenceFlow id="SequenceFlow_8" sourceRef="ExclusiveGateway_1" targetRef="ServiceTask_2"/>
  <bpmn:sequenceFlow id="SequenceFlow_9" sourceRef="UserTask_2" targetRef="ExclusiveGateway_2"/>
  <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="ServiceTask_2" targetRef="IntermediateCatchEvent_2"/>
  <bpmn:sequenceFlow id="SequenceFlow_11" sourceRef="IntermediateCatchEvent_2" targetRef="UserTask_3"/>
  <bpmn:sequenceFlow id="SequenceFlow_12" sourceRef="IntermediateCatchEvent_2" targetRef="ServiceTask_3"/>
  <bpmn:sequenceFlow id="SequenceFlow_13" sourceRef="UserTask_3" targetRef="EndEvent_1"/>
  <bpmn:sequenceFlow id="SequenceFlow_14" sourceRef="ServiceTask_3" targetRef="IntermediateCatchEvent_2"/>
  <bpmn:sequenceFlow id="SequenceFlow_15" sourceRef="IntermediateCatchEvent_2" targetRef="UserTask_4"/>
  <bpmn:sequenceFlow id="SequenceFlow_16" sourceRef="UserTask_4" targetRef="EndEvent_1"/>
</bpmn:definitions>