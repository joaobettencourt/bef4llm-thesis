<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://bpmn.io/schema/bpmn"
             id="Definitions_1" name="Car Service">
  <process id="Process_1" isExecutable="false" name="Car Service">
    <startEvent id="Start_Event" name="Start Event">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <serviceTask id="Check_Car_Registered" name="Check if car is registered">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </serviceTask>
    <exclusiveGateway id="Exclusive_Gateway_1" name="Exclusive Gateway 1">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
      <outgoing>SequenceFlow_4</outgoing>
    </exclusiveGateway>
    <serviceTask id="Notify_Car_Owner" name="Notify car owner">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_5</outgoing>
    </serviceTask>
    <exclusiveGateway id="Exclusive_Gateway_2" name="Exclusive Gateway 2">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_6</outgoing>
      <outgoing>SequenceFlow_7</outgoing>
    </exclusiveGateway>
    <serviceTask id="Send_Fine_to_Car_Owner" name="Send fine to car owner">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </serviceTask>
    <endEvent id="End_Event" name="End Event">
      <incoming>SequenceFlow_6</incoming>
      <incoming>SequenceFlow_7</incoming>
      <incoming>SequenceFlow_8</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="Start_Event" targetRef="Check_Car_Registered"/>
    <sequenceFlow id="SequenceFlow_2" sourceRef="Check_Car_Registered" targetRef="Exclusive_Gateway_1"/>
    <sequenceFlow id="SequenceFlow_3" sourceRef="Exclusive_Gateway_1" targetRef="Notify_Car_Owner"/>
    <sequenceFlow id="SequenceFlow_4" sourceRef="Exclusive_Gateway_1" targetRef="Exclusive_Gateway_2"/>
    <sequenceFlow id="SequenceFlow_5" sourceRef="Notify_Car_Owner" targetRef="Exclusive_Gateway_2"/>
    <sequenceFlow id="SequenceFlow_6" sourceRef="Exclusive_Gateway_2" targetRef="End_Event"/>
    <sequenceFlow id="SequenceFlow_7" sourceRef="Exclusive_Gateway_2" targetRef="End_Event"/>
    <sequenceFlow id="SequenceFlow_8" sourceRef="Send_Fine_to_Car_Owner" targetRef="End_Event"/>
  </process>
</definitions>