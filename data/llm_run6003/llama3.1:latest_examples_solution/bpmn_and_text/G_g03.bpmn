<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="BlizzardOnlineCharacterGenerator"
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <process id="Process_1" isExecutable="false">
    <startEvent id="StartEvent_1" name="New WoW character wanted">
      <outgoing>SequenceFlow_0</outgoing>
    </startEvent>

    <serviceTask id="ServiceTask_2" name="Check existence of battle.net account"
                 implementation="##WebService">
      <incoming>SequenceFlow_0</incoming>
      <outgoing>SequenceFlow_1</outgoing>
    </serviceTask>

    <exclusiveGateway id="ExclusiveGateway_3" gatewayDirection="Diverging" name="battle.net account exists?">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
      <outgoing>SequenceFlow_4</outgoing>
    </exclusiveGateway>

    <serviceTask id="ServiceTask_5" name="Check availablity of character name"
                 implementation="##WebService">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </serviceTask>

    <manualTask id="ManualTask_7" name="Enter character name">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </manualTask>

    <exclusiveGateway id="ExclusiveGateway_9" gatewayDirection="Converging" name="Character name available?">
      <incoming>SequenceFlow_8</incoming>
      <outgoing>SequenceFlow_10</outgoing>
      <outgoing>SequenceFlow_12</outgoing>
    </exclusiveGateway>

    <serviceTask id="ServiceTask_13" name="Receive confirmation and character selfies"
                 implementation="##WebService">
      <incoming>SequenceFlow_11</incoming>
      <outgoing>SequenceFlow_14</outgoing>
    </serviceTask>

    <endEvent id="EndEvent_15" name="Character created">
      <incoming>SequenceFlow_14</incoming>
    </endEvent>

    <sequenceFlow id="SequenceFlow_0" sourceRef="StartEvent_1" targetRef="ServiceTask_2"/>
    <sequenceFlow id="SequenceFlow_1" sourceRef="ServiceTask_2" targetRef="ExclusiveGateway_3"/>
    <sequenceFlow id="SequenceFlow_2" sourceRef="ExclusiveGateway_3" targetRef="ManualTask_5"/>
    <sequenceFlow id="SequenceFlow_3" sourceRef="ManualTask_5" targetRef="ServiceTask_7"/>
    <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_3" targetRef="ManualTask_8"/>
    <sequenceFlow id="SequenceFlow_6" sourceRef="ServiceTask_7" targetRef="ManualTask_10"/>
    <sequenceFlow id="SequenceFlow_8" sourceRef="ManualTask_10" targetRef="ExclusiveGateway_9"/>
    <sequenceFlow id="SequenceFlow_10" sourceRef="ExclusiveGateway_9" targetRef="ServiceTask_12"/>
    <sequenceFlow id="SequenceFlow_11" sourceRef="ServiceTask_12" targetRef="ServiceTask_13"/>
    <sequenceFlow id="SequenceFlow_12" sourceRef="ExclusiveGateway_9" targetRef="EndEvent_15"/>
    <sequenceFlow id="SequenceFlow_14" sourceRef="ServiceTask_13" targetRef="EndEvent_15"/>

  </process>
</bpmn:definitions>