<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_0" name="Company Manufacturing Customized Bicycles" processRef="Process_1"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_0" name="Sales Department">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1" name="Engineering Department">
        <bpmn:flowNodeRef>Task_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Storehouse">
        <bpmn:flowNodeRef>ParallelGateway_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_8</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Receive order">
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="ExclusiveGateway_1" name="Accept order?">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_2" name="Inform storehouse and engineering department">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="ExclusiveGateway_2" name="Any part left unchecked?">
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_3" name="Ship bicycle to customer">
      <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_1" name="Process finished">
      <bpmn:incoming>SequenceFlow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:parallelGateway id="ParallelGateway_1" name="Prepare for assembling">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_8</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_4" name="Prepare for assembling">
      <bpmn:incoming>SequenceFlow_8</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="ParallelGateway_2" name="Check part quantity">
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_11</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="ExclusiveGateway_3" name="Available in-house?">
      <bpmn:incoming>SequenceFlow_10</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_12</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_5" name="Back-order part">
      <bpmn:incoming>SequenceFlow_12</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="ExclusiveGateway_4" name="Any part left unchecked?">
      <bpmn:incoming>SequenceFlow_13</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_15</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_6" name="Reserve part">
      <bpmn:incoming>SequenceFlow_15</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_7" name="Reserve part">
      <bpmn:incoming>SequenceFlow_16</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="ExclusiveGateway_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="ExclusiveGateway_1" targetRef="Task_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_1" targetRef="ExclusiveGateway_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="Task_2" targetRef="ParallelGateway_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="ExclusiveGateway_2" targetRef="Task_3"/>
    <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="ExclusiveGateway_2" targetRef="ParallelGateway_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_7" sourceRef="Task_3" targetRef="EndEvent_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_8" sourceRef="ParallelGateway_1" targetRef="Task_4"/>
    <bpmn:sequenceFlow id="SequenceFlow_9" sourceRef="Task_4" targetRef="ParallelGateway_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="ParallelGateway_2" targetRef="ExclusiveGateway_3"/>
    <bpmn:sequenceFlow id="SequenceFlow_11" sourceRef="ParallelGateway_2" targetRef="Task_5"/>
    <bpmn:sequenceFlow id="SequenceFlow_12" sourceRef="ExclusiveGateway_3" targetRef="Task_6"/>
    <bpmn:sequenceFlow id="SequenceFlow_13" sourceRef="ExclusiveGateway_3" targetRef="ParallelGateway_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_14" sourceRef="Task_5" targetRef="ParallelGateway_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_15" sourceRef="Task_6" targetRef="ExclusiveGateway_4"/>
    <bpmn:sequenceFlow id="SequenceFlow_16" sourceRef="Task_7" targetRef="EndEvent_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_17" sourceRef="Task_6" targetRef="Task_8"/>
  </bpmn:process>
</bpmn:definitions>