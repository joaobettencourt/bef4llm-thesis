<?xml version="1.0" encoding="UTF-8"?>  
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_NewApplication">
    <bpmn:participant name="USI Course Registration Process" processRef="Process_CourseRegistration"/>
  </bpmn:collaboration>

  <bpmn:process isExecutable="false" id="Process_CourseRegistration">
    <!-- Lane configuration -->
    <bpmn:laneSet>
      <bpmn:lane name="User/Student">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_HasAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectCourse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_EligibleUniversity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegisterAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RequestActivation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WaitResponse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AccountMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TweetFriends</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CompleteRegistration</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane name="System">
        <bpmn:flowNodeRef>Task_SystemShowCourses</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Register for USI Course">
      <bpmn:outgoing>SequenceFlow_SelectCourse</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: System shows courses (System Lane) -->
    <bpmn:task id="Task_SystemShowCourses" name="System Shows Available Courses &amp; Dates">
      <bpmn:incoming>SequenceFlow_SelectCourse</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ShowToUser</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: User selects course -->
    <bpmn:task id="Task_SelectCourse" name="Select Course">
      <bpmn:incoming>SequenceFlow_ShowToUser</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckAccount</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Check if user has account -->
    <bpmn:exclusiveGateway id="Gateway_HasAccount" name="Has Account?">
      <bpmn:incoming>SequenceFlow_CheckAccount</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_LoginPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoAccountPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Log into existing account -->
    <bpmn:task id="Task_LoginExisting" name="Log Into Existing Account">
      <bpmn:incoming>SequenceFlow_LoginPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AccountReady</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Check university eligibility -->
    <bpmn:exclusiveGateway id="Gateway_EligibleUniversity" name="Registered at Eligible University?">
      <bpmn:incoming>SequenceFlow_NoAccountPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_YesEligible</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NotEligibleNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Register account if eligible -->
    <bpmn:task id="Task_RegisterAccount" name="Register Your Account">
      <bpmn:incoming>SequenceFlow_YesEligible</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AccountReady</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Request activation if not eligible -->
    <bpmn:task id="Task_RequestActivation" name="Request Activation">
      <bpmn:incoming>SequenceFlow_NotEligibleNo</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitResponse</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Wait for response -->
    <bpmn:task id="Task_WaitResponse" name="Wait For Activation Response">
      <bpmn:incoming>SequenceFlow_WaitResponse</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AccountReady</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Merge account paths -->
    <bpmn:inclusiveGateway id="Gateway_AccountMerge" name="Account Ready">
      <bpmn:incoming>SequenceFlow_LoginPath</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_RegisterReady</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_WaitResponseDone</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TwitterTweet</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Task: Tweet to friends -->
    <bpmn:task id="Task_TweetFriends" name="Tweet To Friends">
      <bpmn:incoming>SequenceFlow_TwitterTweet</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CompleteRegistration</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Complete registration with payment -->
    <bpmn:task id="Task_CompleteRegistration" name="Complete Registration &amp; Payment">
      <bpmn:incoming>SequenceFlow_CompleteRegistration</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReceiveTicket</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_1" name="Course Ticket Received">
      <bpmn:incoming>SequenceFlow_ReceiveTicket</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_SelectCourse" sourceRef="StartEvent_1" targetRef="Task_SystemShowCourses"/>    
    <bpmn:sequenceFlow id="SequenceFlow_ShowToUser" name="Display Courses" sourceRef="Task_SystemShowCourses" targetRef="Task_SelectCourse"/>
    <bpmn:sequenceFlow id="SequenceFlow_CheckAccount" sourceRef="Task_SelectCourse" targetRef="Gateway_HasAccount"/>    
    <bpmn:sequenceFlow id="SequenceFlow_LoginPath" name="Has Account - Yes" sourceRef="Gateway_HasAccount" targetRef="Task_LoginExisting">
      <bpmn:name>Yes</bpmn:name>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_NoAccountPath" name="No Account" sourceRef="Gateway_HasAccount" targetRef="Gateway_EligibleUniversity"/>    
    <bpmn:sequenceFlow id="SequenceFlow_YesEligible" name="Is Eligible - Yes" sourceRef="Gateway_EligibleUniversity" targetRef="Task_RegisterAccount">
      <bpmn:name>Yes</bpmn:name>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_NotEligibleNo" name="Is Eligible - No" sourceRef="Gateway_EligibleUniversity" targetRef="Task_RequestActivation"/>    
    <bpmn:sequenceFlow id="SequenceFlow_AccountReady" sourceRef="Task_LoginExisting" targetRef="Gateway_AccountMerge"/>
    <bpmn:sequenceFlow id="SequenceFlow_RegisterReady" name="Account Registered" sourceRef="Task_RegisterAccount" targetRef="Gateway_AccountMerge"/>    
    <bpmn:sequenceFlow id="SequenceFlow_WaitResponseDone" name="Activation Received" sourceRef="Task_WaitResponse" targetRef="Gateway_AccountMerge"/>
    <bpmn:sequenceFlow id="SequenceFlow_TwitterTweet" sourceRef="Gateway_AccountMerge" targetRef="Task_TweetFriends"/>    
    <bpmn:sequenceFlow id="SequenceFlow_CompleteRegistration" name="Complete Registration" sourceRef="Task_TweetFriends" targetRef="Task_CompleteRegistration"/>
    <bpmn:sequenceFlow id="SequenceFlow_ReceiveTicket" sourceRef="Task_CompleteRegistration" targetRef="EndEvent_1"/>

  </bpmn:process>
</bpmn:definitions>