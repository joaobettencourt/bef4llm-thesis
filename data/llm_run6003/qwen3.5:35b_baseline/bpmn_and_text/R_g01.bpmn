<?xml version="1.0" encoding="UTF-8"?>  
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_DIYRepair_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_DiyProcess">
    <bpmn:participant id="Participant_SmartphoneRepair" name="DIY Smartphone Repair Process" processRef="Process_DIYRepair_001"/>
  </bpmn:collaboration>

  <bpmn:process isExecutable="false" id="Process_DIYRepair_001">
    <!-- Lane configuration -->
    <bpmn:laneSet>
      <bpmn:lane id="Lane_User" name="User">
        <bpmn:flowNodeRef>StartEvent_EnterModel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_SourcingDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_User_BorrowFromFriends</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_User_BuyParts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_SourcingMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveInstructions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RepairPhone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_OutcomeCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendReviewVideo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendToExpert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Failure</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ToolSystem" name="Online Tool System">
        <bpmn:flowNodeRef>Task_System_GetPartsList</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_EnterModel" name="Enter Model &amp; Broken Part">
      <bpmn:outgoing>SequenceFlow_StartToList</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- System Task -->
    <bpmn:task id="Task_System_GetPartsList" name="Generate Materials/Tools List">
       <bpmn:incoming>SequenceFlow_StartToList</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_ListToDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Sourcing Decision Gateway -->
    <bpmn:inclusiveGateway id="InclusiveGateway_SourcingDecision" name="Need to Source Parts?">
       <bpmn:incoming>SequenceFlow_ListToDecision</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_BorrowPath</bpmn:outgoing>
       <bpmn:outgoing>SequenceFlow_BuyPath</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Borrow Task -->
    <bpmn:task id="Task_User_BorrowFromFriends" name="Contact Friends / Borrow Items">
       <bpmn:incoming>SequenceFlow_BorrowPath</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_MergeSourcing1</bpmn:outgoing>
    </bpmn:task>

    <!-- Buy Task -->
    <bpmn:task id="Task_User_BuyParts" name="Buy Missing Parts Online">
       <bpmn:incoming>SequenceFlow_BuyPath</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_MergeSourcing2</bpmn:outgoing>
    </bpmn:task>

    <!-- Sourcing Merge Gateway -->
    <bpmn:inclusiveGateway id="InclusiveGateway_SourcingMerge" name="Parts Acquired">
       <bpmn:incoming>SequenceFlow_MergeSourcing1</bpmn:incoming>
       <bpmn:incoming>SequenceFlow_MergeSourcing2</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_ToInstructions</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Instructions Task -->
    <bpmn:task id="Task_ReceiveInstructions" name="Receive Repair Instructions">
       <bpmn:incoming>SequenceFlow_ToInstructions</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_StartRepair</bpmn:outgoing>
    </bpmn:task>

    <!-- Repair Task -->
    <bpmn:task id="Task_RepairPhone" name="DIY Smartphone Screen Repair">
       <bpmn:incoming>SequenceFlow_StartRepair</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_CheckOutcome</bpmn:outgoing>
    </bpmn:task>

    <!-- Outcome Check Gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_OutcomeCheck" name="Did it work?">
       <bpmn:incoming>SequenceFlow_CheckOutcome</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_SuccessPath</bpmn:outgoing>
       <bpmn:outgoing>SequenceFlow_FailurePath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Success Task -->
    <bpmn:task id="Task_SendReviewVideo" name="Send Review / Video">
       <bpmn:incoming>SequenceFlow_SuccessPath</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_ToEndSuccess</bpmn:outgoing>
    </bpmn:task>

    <!-- Success End Event -->
    <bpmn:endEvent id="EndEvent_Success" name="Repair Complete">
       <bpmn:incoming>SequenceFlow_ToEndSuccess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Failure Task -->
    <bpmn:task id="Task_SendToExpert" name="Send to Expert for Repair">
       <bpmn:incoming>SequenceFlow_FailurePath</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_ToEndFailure</bpmn:outgoing>
    </bpmn:task>

    <!-- Failure End Event -->
    <bpmn:endEvent id="EndEvent_Failure" name="Sent to Expert">
       <bpmn:incoming>SequenceFlow_ToEndFailure</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToList" sourceRef="StartEvent_EnterModel" targetRef="Task_System_GetPartsList"/>    
    <bpmn:sequenceFlow id="SequenceFlow_ListToDecision" name="Get List Complete" sourceRef="Task_System_GetPartsList" targetRef="InclusiveGateway_SourcingDecision"/>
    <bpmn:sequenceFlow id="SequenceFlow_BorrowPath" name="Borrow from Friends" sourceRef="InclusiveGateway_SourcingDecision" targetRef="Task_User_BorrowFromFriends"/>
    <bpmn:sequenceFlow id="SequenceFlow_BuyPath" name="Buy Parts Online" sourceRef="InclusiveGateway_SourcingDecision" targetRef="Task_User_BuyParts"/>
    <bpmn:sequenceFlow id="SequenceFlow_MergeSourcing1" sourceRef="Task_User_BorrowFromFriends" targetRef="InclusiveGateway_SourcingMerge"/>
    <bpmn:sequenceFlow id="SequenceFlow_MergeSourcing2" sourceRef="Task_User_BuyParts" targetRef="InclusiveGateway_SourcingMerge"/>
    <bpmn:sequenceFlow id="SequenceFlow_ToInstructions" name="All Parts Ready" sourceRef="InclusiveGateway_SourcingMerge" targetRef="Task_ReceiveInstructions"/>
    <bpmn:sequenceFlow id="SequenceFlow_StartRepair" sourceRef="Task_ReceiveInstructions" targetRef="Task_RepairPhone"/>
    <bpmn:sequenceFlow id="SequenceFlow_CheckOutcome" name="Check Outcome" sourceRef="Task_RepairPhone" targetRef="ExclusiveGateway_OutcomeCheck"/>
    <bpmn:sequenceFlow id="SequenceFlow_SuccessPath" name="Yes, Worked" sourceRef="ExclusiveGateway_OutcomeCheck" targetRef="Task_SendReviewVideo"/>
    <bpmn:sequenceFlow id="SequenceFlow_FailurePath" name="No, Failed" sourceRef="ExclusiveGateway_OutcomeCheck" targetRef="Task_SendToExpert"/>
    <bpmn:sequenceFlow id="SequenceFlow_ToEndSuccess" sourceRef="Task_SendReviewVideo" targetRef="EndEvent_Success"/>
    <bpmn:sequenceFlow id="SequenceFlow_ToEndFailure" sourceRef="Task_SendToExpert" targetRef="EndEvent_Failure"/>

  </bpmn:process>
</bpmn:definitions>