<?xml version="1.0" encoding="UTF-8"?>  
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_InspectionMachine">
  <bpmn:collaboration id="Collaboration_MachineInspection">
    <bpmn:participant name="Energy Drink Bottling Machine Inspection Process" processRef="Process_InspectionLogic"/>
  </bpmn:collaboration>

  <bpmn:process isExecutable="false" id="Process_InspectionLogic">
    
    <!-- Lane Configuration -->
    <bpmn:laneSet>
      <bpmn:lane name="Maintenance Technician">
        <bpmn:flowNodeRef>StartEvent_Initiate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_EnterDetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_QuestionsInput</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane name="System Interface">
        <bpmn:flowNodeRef>ServiceTask_CollectData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_CheckResults</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_AdditionalQuestions</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Data Objects -->
    <bpmn:dataObject id="Data_MachineDetails" name="Machine Details"/>
    <bpmn:dataObject id="Data_InspectionResults" name="Inspection Results"/>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Initiate">
      <bpmn:outgoing>SequenceFlow_StartToEnter</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Enter Details -->
    <bpmn:userTask id="UserTask_EnterDetails" name="Enter Machine Type & Serial Number">
      <bpmn:incoming>SequenceFlow_StartToEnter</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DetailsToInspection</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task 2: Ask Questions / Input Values -->
    <bpmn:userTask id="UserTask_QuestionsInput" name="Ask Questions & Input Values">
      <bpmn:incoming>SequenceFlow_InspectionLoop</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InputToCollectData</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task 3: Press Buttons / Collect Data -->
    <bpmn:serviceTask id="ServiceTask_CollectData" name="Press Buttons & Auto-Collect Values">
      <bpmn:incoming>SequenceFlow_InputToCollectData</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DataToGateway</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_CheckResults" name="Additional Questions Needed?">
      <bpmn:incoming>SequenceFlow_DataToGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_YesMoreQuestions</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoCompleteInspection</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 4: Additional Questions -->
    <bpmn:userTask id="UserTask_AdditionalQuestions" name="Ask Additional Questions">
      <bpmn:incoming>SequenceFlow_YesMoreQuestions</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MoreToGateway</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Complete" name="Inspection Complete">
      <bpmn:incoming>SequenceFlow_NoCompleteInspection</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToEnter" sourceRef="StartEvent_Initiate" targetRef="UserTask_EnterDetails"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_DetailsToInspection" name="Begin Inspection">
      <bpmn:sourceRef>UserTask_EnterDetails</bpmn:sourceRef>
      <bpmn:targetRef>UserTask_QuestionsInput</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_InputToCollectData" sourceRef="UserTask_QuestionsInput" targetRef="ServiceTask_CollectData"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_DataToGateway" name="Results Available">
      <bpmn:sourceRef>ServiceTask_CollectData</bpmn:sourceRef>
      <bpmn:targetRef>ExclusiveGateway_CheckResults</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Decision Logic -->
    <bpmn:sequenceFlow id="SequenceFlow_YesMoreQuestions" name="Additional Questions Needed">
      <bpmn:sourceRef>ExclusiveGateway_CheckResults</bpmn:sourceRef>
      <bpmn:targetRef>UserTask_AdditionalQuestions</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Loop Back -->
    <bpmn:sequenceFlow id="SequenceFlow_MoreToGateway" name="Continue Inspection">
      <bpmn:sourceRef>UserTask_AdditionalQuestions</bpmn:sourceRef>
      <bpmn:targetRef>ExclusiveGateway_CheckResults</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Completion -->
    <bpmn:sequenceFlow id="SequenceFlow_NoCompleteInspection" name="No Additional Questions">
      <bpmn:sourceRef>ExclusiveGateway_CheckResults</bpmn:sourceRef>
      <bpmn:targetRef>EndEvent_Complete</bpmn:targetRef>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>