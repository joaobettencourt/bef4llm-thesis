<?xml version="1.0" encoding="UTF-8"?>  
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_WorkAccident" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_AccidentReporting">
    <bpmn:participant name="Work Accident Reporting Process" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process isExecutable="false" id="Process_1">
    
    <!-- Lane Configuration -->
    <bpmn:laneSet>
      <bpmn:lane name="Insured Person / Student" id="Lane_Personnel">
        <bpmn:flowNodeRef>StartEvent_Accident</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_ReportType</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane name="Employer / Educational Facility" id="Lane_Employer">
        <bpmn:flowNodeRef>Task_ImmediateReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_SeverityCheck</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane name="Authorities (Inspectorate & Provider)" id="Lane_Authorities">
        <bpmn:flowNodeRef>Task_ReportLabourInspectorate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReportInsuranceProvider</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Accident" name="Accident or Near Miss Occurs">
      <bpmn:outgoing>SequenceFlow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Inform Employer/Directorate -->
    <bpmn:task id="Task_ImmediateReport" name="Inform Employer / Directorate Immediately">
      <bpmn:incoming>SequenceFlow_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_02</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Determine Accident Type & Coverage -->
    <bpmn:inclusiveGateway id="InclusiveGateway_ReportType" name="Determine Reporting Obligation">
      <bpmn:incoming>SequenceFlow_02</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SeriousFatality</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_WorkInjuryLoss</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Gateway 2: Severity Check -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_SeverityCheck" name="Fatality / Serious Injury?">
      <bpmn:incoming>SequenceFlow_03</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReportInspectorate</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 1: Report to Labour Inspectorate -->
    <bpmn:task id="Task_ReportLabourInspectorate" name="Report Fatality/Serious Injury (Immediate)">
      <bpmn:incoming>SequenceFlow_ReportInspectorate</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_04</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: Report to Insurance Provider -->
    <bpmn:task id="Task_ReportInsuranceProvider" name="Report Accident (Within 5 Days)">
      <bpmn:incoming>SequenceFlow_WorkInjuryLoss</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_04</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_01" sourceRef="StartEvent_Accident" targetRef="Task_ImmediateReport"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_02" name="Inform Employer/Directorate" sourceRef="Task_ImmediateReport" targetRef="InclusiveGateway_ReportType"/>

    <!-- Branches from Report Type Gateway -->
    <bpmn:sequenceFlow id="SequenceFlow_SeriousFatality" name="Yes - Fatality/Serious Injury" sourceRef="InclusiveGateway_ReportType" targetRef="ExclusiveGateway_SeverityCheck">
      <bpmn:conditionExpression xsi:type="tFormalExpression"><![CDATA[Accident leads to fatality or serious injury]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Branches from Severity Check -->
    <bpmn:sequenceFlow id="SequenceFlow_ReportInspectorate" name="Report Labour Inspectorate (if not emergency)" sourceRef="ExclusiveGateway_SeverityCheck" targetRef="Task_ReportLabourInspectorate"/>

    <bpmn:sequenceFlow id="SequenceFlow_WorkInjuryLoss" name="Work Loss &gt; 3 Days / Killed / Private Fatality" sourceRef="InclusiveGateway_ReportType" targetRef="Task_ReportInsuranceProvider">
      <bpmn:conditionExpression xsi:type="tFormalExpression"><![CDATA[Unable to work for 3 days or killed]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Convergence -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_Converge" name="Reporting Complete?">
      <bpmn:incoming>SequenceFlow_04</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndProcess</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Complete" name="Reporting Obligations Met">
      <bpmn:incoming>SequenceFlow_EndProcess</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow_04" sourceRef="Task_ReportLabourInspectorate" targetRef="ExclusiveGateway_Converge"/>
    <bpmn:sequenceFlow id="SequenceFlow_EndProcess" name="All Reports Filed" sourceRef="ExclusiveGateway_Converge" targetRef="EndEvent_Complete"/>

  </bpmn:process>
</bpmn:definitions>