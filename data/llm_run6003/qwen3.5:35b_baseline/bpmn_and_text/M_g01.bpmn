<?xml version="1.0" encoding="UTF-8"?>  
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_3DPrintProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_ArtistOrdering">
    <bpmn:participant name="Custom Model Creation Process" processRef="Process_CustomModelCreation"/>
  </bpmn:collaboration>

  <bpmn:process isExecutable="false" id="Process_CustomModelCreation">
    
    <!-- Lane Configuration -->
    <bpmn:laneSet>
      <bpmn:lane name="User / Requester">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_SatisfiedCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendSketches</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InstructChanges</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WaitForRevision_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectPlasticColor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_HaveStockCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_QuantityCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AddToShoppingList</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_PrintPreparation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_ReadyCheck</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Data Objects -->
    <bpmn:dataObject id="Data_Sketches" name="Sketches"/>
    <bpmn:dataObject id="Data_STL_Model" name="STL Model File"/>
    <bpmn:dataObject id="Data_ShoppingList" name="Shopping List"/>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Craving Custom 3D Model">
      <bpmn:outgoing>SequenceFlow_SendSketches</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Send Sketches -->
    <bpmn:task id="Task_SendSketches" name="Send Artist Several Sketches">
      <bpmn:incoming>SequenceFlow_SendSketches</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckSatisfactionLoop</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Check Satisfaction -->
    <bpmn:inclusiveGateway id="InclusiveGateway_SatisfiedCheck" name="Artist Satisfied?">
      <bpmn:incoming>SequenceFlow_CheckSatisfactionLoop</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProceedToColorSelection</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Task: Instruct Changes -->
    <bpmn:task id="Task_InstructChanges" name="Tell Artist What to Change">
      <bpmn:incoming>SequenceFlow_InstructionLoopBack</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitRevision</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Wait for Revision -->
    <bpmn:task id="WaitForRevision_1" name="Receive Revised Draft">
      <bpmn:incoming>SequenceFlow_WaitRevision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckSatisfactionLoop</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Select Plastic Color -->
    <bpmn:task id="Task_SelectPlasticColor" name="Choose Plastic Color">
      <bpmn:incoming>SequenceFlow_ProceedToColorSelection</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckStockAvailability</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Have Stock? -->
    <bpmn:exclusiveGateway id="InclusiveGateway_HaveStockCheck" name="Have Color At Home?">
      <bpmn:incoming>SequenceFlow_CheckStockAvailability</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OrderPlasticIfNoStock</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Order Plastic -->
    <bpmn:task id="Task_OrderPlastic" name="Order New Plastic">
      <bpmn:incoming>SequenceFlow_OrderPlasticIfNoStock</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MaterialReadyJoin</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Quantity Check -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_QuantityCheck" name="Less Than 100g?">
      <bpmn:incoming>SequenceFlow_CheckStockAvailability</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AddToShoppingListIfLow</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Add to Shopping List -->
    <bpmn:task id="Task_AddToShoppingList" name="Add Plastic To Shopping List">
      <bpmn:incoming>SequenceFlow_AddToShoppingListIfLow</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MaterialReadyJoin</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway Split -->
    <bpmn:parallelGateway id="ParallelGateway_PrintPreparation" name="Printer Prep &amp; GCode">
      <bpmn:incoming>SequenceFlow_MaterialReadyJoin</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PreparePrinterTask</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Prepare Printer -->
    <bpmn:task id="Task_PreparePrinter" name="Turn On &amp; Heat Up">
      <bpmn:incoming>SequenceFlow_PreparePrinterTask</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PrinterReadyJoin</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Generate GCode -->
    <bpmn:task id="Task_GenerateGcode" name="Generate G-Code from STL">
      <bpmn:incoming>SequenceFlow_MaterialReadyJoin</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PrinterReadyJoin</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway Join -->
    <bpmn:parallelGateway id="ExclusiveGateway_ReadyCheck" name="All Ready?">
       <bpmn:incoming>SequenceFlow_PrinterReadyJoin</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StartPrinting</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Print Model -->
    <bpmn:task id="Task_PrintModel" name="Print 3D Model">
       <bpmn:incoming>SequenceFlow_StartPrinting</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndProcess</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_1" name="Model Printed">
       <bpmn:incoming>SequenceFlow_EndProcess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_SendSketches" sourceRef="StartEvent_1" targetRef="Task_SendSketches"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_CheckSatisfactionLoop" name="Review Draft" sourceRef="WaitForRevision_1" targetRef="InclusiveGateway_SatisfiedCheck"/>
    
    <!-- Loop Logic -->
    <bpmn:sequenceFlow id="SequenceFlow_InstructionLoopBack" name="Not Satisfied - Instruct Changes" sourceRef="InclusiveGateway_SatisfiedCheck" targetRef="Task_InstructChanges"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_WaitRevision" name="Wait for Revision" sourceRef="Task_InstructChanges" targetRef="WaitForRevision_1"/>

    <!-- Proceed Logic -->
    <bpmn:sequenceFlow id="SequenceFlow_ProceedToColorSelection" name="Satisfied - Choose Color" sourceRef="InclusiveGateway_SatisfiedCheck" targetRef="Task_SelectPlasticColor"/>

    <!-- Stock Check Logic -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckStockAvailability" sourceRef="Task_SelectPlasticColor" targetRef="InclusiveGateway_HaveStockCheck"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_OrderPlasticIfNoStock" name="Not At Home - Order" sourceRef="InclusiveGateway_HaveStockCheck" targetRef="Task_OrderPlastic"/>

    <!-- Quantity Check Logic -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckQuantityLogic" name="At Home - Check Amount" sourceRef="InclusiveGateway_HaveStockCheck" targetRef="ExclusiveGateway_QuantityCheck"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_AddToShoppingListIfLow" name="&lt; 100g - Add to List" sourceRef="ExclusiveGateway_QuantityCheck" targetRef="Task_AddToShoppingList"/>

    <!-- Convergence for Material -->
    <bpmn:sequenceFlow id="SequenceFlow_MaterialReadyJoin" sourceRef="Task_OrderPlastic" targetRef="ParallelGateway_PrintPreparation"/>
    
    <!-- Parallel Prep Logic -->
    <bpmn:sequenceFlow id="SequenceFlow_PreparePrinterTask" sourceRef="ParallelGateway_PrintPreparation" targetRef="Task_PreparePrinter"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_GCodeGenLogic" name="Generate G-Code" sourceRef="ParallelGateway_PrintPreparation" targetRef="Task_GenerateGcode"/>

    <!-- Join Logic -->
    <bpmn:sequenceFlow id="SequenceFlow_PrinterReadyJoin" sourceRef="Task_PreparePrinter" targetRef="ExclusiveGateway_ReadyCheck"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_GCodeToJoin" name="G-Code Ready" sourceRef="Task_GenerateGcode" targetRef="ExclusiveGateway_ReadyCheck"/>

    <!-- Final Print -->
    <bpmn:sequenceFlow id="SequenceFlow_StartPrinting" name="Start Printing" sourceRef="ExclusiveGateway_ReadyCheck" targetRef="Task_PrintModel"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_EndProcess" sourceRef="Task_PrintModel" targetRef="EndEvent_1"/>

    <!-- Associations -->
    <bpmn:association id="Association_SendSketchesToTask">
      <bpmn:sourceRef>Data_Sketches</bpmn:sourceRef>
      <bpmn:targetRef>Task_SendSketches</bpmn:targetRef>
    </bpmn:association>

    <bpmn:association id="Association_ShoppingList">
      <bpmn:sourceRef>Data_ShoppingList</bpmn:sourceRef>
      <bpmn:targetRef>Task_AddToShoppingList</bpmn:targetRef>
    </bpmn:association>

     <bpmn:association id="Association_STLToTask">
      <bpmn:sourceRef>Data_STL_Model</bpmn:sourceRef>
      <bpmn:targetRef>Task_GenerateGcode</bpmn:targetRef>
    </bpmn:association>

  </bpmn:process>
</bpmn:definitions>