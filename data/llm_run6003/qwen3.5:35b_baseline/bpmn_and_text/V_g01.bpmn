<?xml version="1.0" encoding="UTF-8"?>  
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_RobotBurgerSeller">
    <bpmn:participant name="Robotic Burger Seller Process" processRef="Process_BurgerPreparation"/>
  </bpmn:collaboration>

  <bpmn:process isExecutable="false" id="Process_BurgerPreparation">
    
    <!-- Lane configuration -->
    <bpmn:laneSet>
      <bpmn:lane name="Robot Operations">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_OrderType</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_MenuSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareDrink</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_SideChoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareFries</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareWedges</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_MenuMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_BurgerStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareBurger</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Order Received">
      <bpmn:outgoing>SequenceFlow_OrderReceived</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Decision Point 1: Menu or Just Burger? -->
    <bpmn:exclusiveGateway id="InclusiveGateway_OrderType" name="Menu Selection">
      <bpmn:incoming>SequenceFlow_OrderReceived</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MenuPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_JustBurgerPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Menu Path - Parallel Drink and Side Selection -->
    <bpmn:parallelGateway id="ParallelGateway_MenuSplit" name="Start Prep">
      <bpmn:incoming>SequenceFlow_MenuPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DrinkPrep</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SideChoice</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task - Prepare Drink -->
    <bpmn:task id="Task_PrepareDrink" name="Prepare Drink">
      <bpmn:incoming>SequenceFlow_DrinkPrep</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DrinkReady</bpmn:outgoing>
    </bpmn:task>

    <!-- Decision Point 2: Fries or Wedges? -->
    <bpmn:exclusiveGateway id="InclusiveGateway_SideChoice" name="Fries or Wedges">
      <bpmn:incoming>SequenceFlow_SideChoice</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FriesPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_WedgesPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task - Prepare Fries -->
    <bpmn:task id="Task_PrepareFries" name="Prepare Fries">
      <bpmn:incoming>SequenceFlow_FriesPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SideReady</bpmn:outgoing>
    </bpmn:task>

    <!-- Task - Prepare Wedges -->
    <bpmn:task id="Task_PrepareWedges" name="Prepare Wedges">
      <bpmn:incoming>SequenceFlow_WedgesPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SideReady</bpmn:outgoing>
    </bpmn:task>

    <!-- Merge Point for Menu Path (Drink + Side) -->
    <bpmn:parallelGateway id="InclusiveGateway_MenuMerge" name="Items Ready">
      <bpmn:incoming>SequenceFlow_DrinkReady</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_SideReady</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToBurgerStart</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Just Burger Path (Skip Drink/Sides) -->
    <bpmn:sequenceFlow id="SequenceFlow_JustBurgerPath" sourceRef="InclusiveGateway_OrderType" targetRef="InclusiveGateway_BurgerStart"/>

    <!-- Merge Point for All Paths before Burger Prep -->
    <bpmn:inclusiveGateway id="InclusiveGateway_BurgerStart" name="Ready to Cook">
      <bpmn:incoming>SequenceFlow_ToBurgerStart</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_JustBurgerPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StartBurgerPrep</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Task - Prepare Burger -->
    <bpmn:task id="Task_PrepareBurger" name="Prepare Burger">
      <bpmn:incoming>SequenceFlow_StartBurgerPrep</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BurgerReady</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_1" name="Order Delivered">
      <bpmn:incoming>SequenceFlow_OrderDelivered</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_OrderReceived" sourceRef="StartEvent_1" targetRef="InclusiveGateway_OrderType"/>    
    <bpmn:sequenceFlow name="Menu Selected" id="SequenceFlow_MenuPath">
      <bpmn:sourceRef>InclusiveGateway_OrderType</bpmn:sourceRef>  
      <bpmn:targetRef>ParallelGateway_MenuSplit</bpmn:targetRef> 
    </bpmn:sequenceFlow>

    <!-- Menu Path Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_DrinkPrep" sourceRef="ParallelGateway_MenuSplit" targetRef="Task_PrepareDrink"/>    
    <bpmn:sequenceFlow name="Ask Side Dish" id="SequenceFlow_SideChoice">
      <bpmn:sourceRef>ParallelGateway_MenuSplit</bpmn:sourceRef>  
      <bpmn:targetRef>InclusiveGateway_SideChoice</bpmn:targetRef> 
    </bpmn:sequenceFlow>

    <!-- Side Dish Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_FriesPath" sourceRef="InclusiveGateway_SideChoice" targetRef="Task_PrepareFries"/>    
    <bpmn:sequenceFlow name="Wedges Selected" id="SequenceFlow_WedgesPath">
      <bpmn:sourceRef>InclusiveGateway_SideChoice</bpmn:sourceRef>  
      <bpmn:targetRef>Task_PrepareWedges</bpmn:targetRef> 
    </bpmn:sequenceFlow>

    <!-- Merge Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_DrinkReady" sourceRef="Task_PrepareDrink" targetRef="InclusiveGateway_MenuMerge"/>    
    <bpmn:sequenceFlow name="Side Ready" id="SequenceFlow_SideReady">
      <bpmn:sourceRef>Task_PrepareFries</bpmn:sourceRef>  
      <bpmn:targetRef>InclusiveGateway_MenuMerge</bpmn:targetRef> 
    </bpmn:sequenceFlow>

    <!-- Final Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_ToBurgerStart" sourceRef="InclusiveGateway_MenuMerge" targetRef="InclusiveGateway_BurgerStart"/>    
    <bpmn:sequenceFlow name="Cook Burger" id="SequenceFlow_StartBurgerPrep">
      <bpmn:sourceRef>InclusiveGateway_BurgerStart</bpmn:sourceRef>  
      <bpmn:targetRef>Task_PrepareBurger</bpmn:targetRef> 
    </bpmn:sequenceFlow>

    <!-- Status Update Loop (Simulated via Timer Event) -->
    <bpmn:intermediateCatchEvent id="IntermediateTimer_Status" name="Status Update">
      <bpmn:incoming>SequenceFlow_BurgerReady</bpmn:incoming>
      <bpmn:outgoing>SequenceLoop_Update</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Timer Event Definition (Simplified for XML Validity) -->
    <bpmn:timer id="Timer_30s">
       <bpmn:timeDuration>P30S</bpmn:timeDuration> 
    </bpmn:timer>

    <bpmn:endEvent name="Order Delivered" id="EndEvent_Deliver"/> <!-- Placeholder for flow completion -->
    
  </bpmn:process>
</bpmn:definitions>