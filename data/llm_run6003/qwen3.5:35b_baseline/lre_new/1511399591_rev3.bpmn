<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="_Collab_WebDevProcess">
    <bpmn:participant name="Web Development Team" processRef="Process_WebDevelopment"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_WebDevelopment" isExecutable="false">
    <bpmn:laneSet id="_LaneSets_WD">
      <bpmn:lane name="Business Analyst" id="_Lane_BA">
        <bpmn:flowNodeRef>StartEvent_Process</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Task_Analysis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Gateway_DesignCheck</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane name="Web Designer" id="_Lane_Designer">
        <bpmn:flowNodeRef>_Task_IntegrationDesign</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane name="PHP/HTML/CSS Specialist" id="_Lane_Specialist">
        <bpmn:flowNodeRef>_Task_Implementation</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane name="Tester" id="_Lane_Tester">
        <bpmn:flowNodeRef>_Task_Testing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Gateway_TestResult</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent name="Process Starts" id="StartEvent_Process">
      <bpmn:outgoing>_Flow_Analysis</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Business Analysis (BA) -->
    <bpmn:task name="Collect Data &amp; Conduct Analysis" id="_Task_Analysis">
      <bpmn:incoming>_Flow_Analysis</bpmn:incoming>
      <bpmn:outgoing>_Flow_DesignStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: Web Design Integration (Designer) -->
    <bpmn:task name="Integrate Design &amp; Place Module" id="_Task_IntegrationDesign">
      <bpmn:incoming>_Flow_DesignStart</bpmn:incoming>
      <bpmn:incoming>_Loop_Back_DesignAdjustment</bpmn:incoming>
      <bpmn:outgoing>_Flow_CheckDesign</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Check Design (BA) -->
    <bpmn:exclusiveGateway name="Design OK?" id="_Gateway_DesignCheck">
      <bpmn:incoming>_Flow_CheckDesign</bpmn:incoming>
      <bpmn:outgoing>_Loop_Back_DesignAdjustment</bpmn:outgoing> <!-- Needs Adjustment -->
      <bpmn:outgoing>_Flow_ProceedToImpl</bpmn:outgoing> <!-- OK -->
    </bpmn:exclusiveGateway>

    <!-- Task 3: Implementation (Specialist) -->
    <bpmn:task name="Integrate with Overall Implementation" id="_Task_Implementation">
      <bpmn:incoming>_Flow_ProceedToImpl</bpmn:incoming>
      <bpmn:incoming>_Loop_Back_TestAdjustment</bpmn:incoming>
      <bpmn:outgoing>_Flow_StartTesting</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 4: Testing (Tester) -->
    <bpmn:task name="Test Final Website" id="_Task_Testing">
      <bpmn:incoming>_Flow_StartTesting</bpmn:incoming>
      <bpmn:outgoing>_Flow_CheckResult</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2: Test Result (Tester) -->
    <bpmn:exclusiveGateway name="Test OK?" id="_Gateway_TestResult">
      <bpmn:incoming>_Flow_CheckResult</bpmn:incoming>
      <bpmn:outgoing>_Loop_Back_TestAdjustment</bpmn:outgoing> <!-- Not OK -->
      <bpmn:outgoing>_Flow_EndProcess</bpmn:outgoing> <!-- OK -->
    </bpmn:exclusiveGateway>

    <!-- End Event -->
    <bpmn:endEvent name="Website Ready" id="_End_Event">
      <bpmn:incoming>_Flow_EndProcess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    
    <!-- Start to Analysis -->
    <bpmn:sequenceFlow sourceRef="StartEvent_Process" targetRef="_Task_Analysis" id="_Flow_Analysis"/>

    <!-- Analysis to Design Integration (Designer) -->
    <bpmn:sequenceFlow name="Proceed to Designer" sourceRef="_Task_Analysis" targetRef="_Task_IntegrationDesign" id="_Flow_DesignStart">
      <bpmn:name>Analysis Complete</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Design Integration to Check Gateway -->
    <bpmn:sequenceFlow sourceRef="_Task_IntegrationDesign" targetRef="_Gateway_DesignCheck" id="_Flow_CheckDesign"/>

    <!-- Loop Back from Design Check (Needs Adjustment) -->
    <bpmn:sequenceFlow name="Adjustment Needed" sourceRef="_Gateway_DesignCheck" targetRef="_Task_IntegrationDesign" id="_Loop_Back_DesignAdjustment">
      <bpmn:name>No</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Proceed to Implementation (OK) -->
    <bpmn:sequenceFlow name="Design OK" sourceRef="_Gateway_DesignCheck" targetRef="_Task_Implementation" id="_Flow_ProceedToImpl">
      <bpmn:name>Yes</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Implementation to Testing -->
    <bpmn:sequenceFlow name="Ready for Test" sourceRef="_Task_Implementation" targetRef="_Task_Testing" id="_Flow_StartTesting"/>

    <!-- Testing to Result Gateway -->
    <bpmn:sequenceFlow sourceRef="_Task_Testing" targetRef="_Gateway_TestResult" id="_Flow_CheckResult"/>

    <!-- Loop Back from Test (Not OK) -->
    <bpmn:sequenceFlow name="Adjustments Required" sourceRef="_Gateway_TestResult" targetRef="_Task_Implementation" id="_Loop_Back_TestAdjustment">
      <bpmn:name>No</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Proceed to End (OK) -->
    <bpmn:sequenceFlow name="Test Passed" sourceRef="_Gateway_TestResult" targetRef="_End_Event" id="_Flow_EndProcess">
      <bpmn:name>Yes</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>