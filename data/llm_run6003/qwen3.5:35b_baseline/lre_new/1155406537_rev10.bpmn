<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="_Collab_AccountCreation_01">
    <bpmn:participant name="PayPal Registration Process" processRef="Process_AccountCreation"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_AccountCreation" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane name="Client" id="_Lane_Client_01">
        <bpmn:flowNodeRef>_StartEvent_CreateAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Task_SelectType</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Task_EnterDetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Task_DeclarePEP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Task_CorrectDetails</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane name="PayPal System" id="_Lane_System_01">
        <bpmn:flowNodeRef>_ServiceTask_ValidateInput</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Gateway_CheckValidation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Task_SendWelcomeEmail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_EndEvent_AccountCreated</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="_StartEvent_CreateAccount" name="Create Account Request">
      <bpmn:outgoing>_Flow_SelectType</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Select Type (Client) -->
    <bpmn:task id="_Task_SelectType" name="Select Account Type">
      <bpmn:incoming>_Flow_SelectType</bpmn:incoming>
      <bpmn:outgoing>_Flow_EnterDetails</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: Enter Details (Client) -->
    <bpmn:task id="_Task_EnterDetails" name="Enter Login &amp; Personal Details">
      <bpmn:incoming>_Flow_EnterDetails</bpmn:incoming>
      <bpmn:outgoing>_Flow_DeclarePEP</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3: Declare PEP (Client) -->
    <bpmn:task id="_Task_DeclarePEP" name="Declare Politically Exposed Person Status">
      <bpmn:incoming>_Flow_DeclarePEP</bpmn:incoming>
      <bpmn:outgoing>_Flow_SubmitAccount</bpmn:outgoing>
    </bpmn:task>

    <!-- Service Task 4: Validate Input (System) -->
    <bpmn:serviceTask id="_ServiceTask_ValidateInput" name="Validate Input Fields">
      <bpmn:incoming>_Flow_SubmitAccount</bpmn:incoming>
      <bpmn:outgoing>_Flow_CheckValidationResult</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Gateway 5: Check Validation (System) -->
    <bpmn:exclusiveGateway id="_Gateway_CheckValidation" name="Valid Input?">
      <bpmn:incoming>_Flow_CheckValidationResult</bpmn:incoming>
      <bpmn:outgoing>_Flow_SendWelcomeEmailPath</bpmn:outgoing>
      <bpmn:outgoing>_Flow_CorrectDetailsPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 6: Send Welcome Email (System) -->
    <bpmn:task id="_Task_SendWelcomeEmail" name="Send Welcome Email">
      <bpmn:incoming>_Flow_SendWelcomeEmailPath</bpmn:incoming>
      <bpmn:outgoing>_Flow_AccountCreatedLink</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="_EndEvent_AccountCreated" name="Account Created">
      <bpmn:incoming>_Flow_AccountCreatedLink</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task 7: Correct Details (Client) - Loop Back -->
    <bpmn:task id="_Task_CorrectDetails" name="Correct Details">
      <bpmn:incoming>_Flow_CorrectDetailsPath</bpmn:incoming>
      <bpmn:outgoing>_Flow_EnterDetailsLoopBack</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow sourceRef="_StartEvent_CreateAccount" targetRef="_Task_SelectType" id="_Flow_SelectType"/>
    
    <bpmn:sequenceFlow sourceRef="_Task_SelectType" targetRef="_Task_EnterDetails" id="_Flow_EnterDetails" name="After Selection"/>

    <bpmn:sequenceFlow sourceRef="_Task_EnterDetails" targetRef="_Task_DeclarePEP" id="_Flow_DeclarePEP"/>

    <!-- Transition from Client to System (Submission) -->
    <bpmn:sequenceFlow sourceRef="_Task_DeclarePEP" targetRef="_ServiceTask_ValidateInput" id="_Flow_SubmitAccount" name="Submit Account Request"/>

    <!-- Validation Result -->
    <bpmn:sequenceFlow sourceRef="_Gateway_CheckValidation" targetRef="_Task_SendWelcomeEmail" id="_Flow_SendWelcomeEmailPath" name="Valid Input"/>

    <!-- Correction Path (Invalid) -->
    <bpmn:sequenceFlow sourceRef="_Gateway_CheckValidation" targetRef="_Task_CorrectDetails" id="_Flow_CorrectDetailsPath" name="Invalid Input"/>

    <!-- Loop Back to Entry -->
    <bpmn:sequenceFlow sourceRef="_Task_CorrectDetails" targetRef="_Task_EnterDetails" id="_Flow_EnterDetailsLoopBack"/>

  </bpmn:process>
</bpmn:definitions>