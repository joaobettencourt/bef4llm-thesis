<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="_Collab_CreditProcess">
    <bpmn:participant name="Credit Company" processRef="Process_CreditApplication"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_CreditApplication" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent name="Receive Credit Information" id="_Start_01">
      <bpmn:outgoing>_Flow_StartToAmountCheck</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Gateway 1: Check Amount Threshold -->
    <bpmn:exclusiveGateway name="Requested amount &gt; $1M?" id="_Gateway_AmountThreshold">
      <bpmn:incoming>_Flow_StartToAmountCheck</bpmn:incoming>
      <bpmn:outgoing>_Flow_RequestApprovalHighValue</bpmn:outgoing>
      <bpmn:outgoing>_Flow_AssessRiskLowValue</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 1: Request Approval (for high value) -->
    <bpmn:task name="Request Credit Approval" id="_Task_RequestApproval">
      <bpmn:incoming>_Flow_RequestApprovalHighValue</bpmn:incoming>
      <bpmn:outgoing>_Flow_ApprovalDecisionGateInbound1</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2: Risk Assessment -->
    <bpmn:exclusiveGateway name="Risk Level?" id="_Gateway_RiskAssessment">
      <bpmn:incoming>_Flow_AssessRiskLowValue</bpmn:incoming>
      <bpmn:outgoing>_Flow_AcceptCreditLowRisk</bpmn:outgoing>
      <bpmn:outgoing>_Flow_RequestApprovalHighRisk</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 2a: Accept Credit Directly (low risk) -->
    <bpmn:task name="Accept Credit" id="_Task_AcceptCredit">
      <bpmn:incoming>_Flow_AcceptCreditLowRisk</bpmn:incoming>
      <bpmn:outgoing>_Flow_SendEmailAcceptedPath1</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 3: Approval Decision -->
    <bpmn:exclusiveGateway name="Credit Approved?" id="_Gateway_ApprovalDecision">
      <bpmn:incoming>_Flow_RequestApprovalHighValue</bpmn:incoming>
      <bpmn:incoming>_Flow_RequestApprovalHighRisk</bpmn:incoming>
      <bpmn:outgoing>_Flow_SendEmailApprovedPath2</bpmn:outgoing>
      <bpmn:outgoing>_Flow_SendEmailRejectedPath3</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event 1: Send Email - Credit Accepted -->
    <bpmn:endEvent name="Send Email - Credit Accepted" id="_End_EmailAccepted">
      <bpmn:incoming>_Flow_SendEmailApprovedPath2</bpmn:incoming>
    </bpmn:endEvent>

    <!-- End Event 2: Send Email - Credit Rejected -->
    <bpmn:endEvent name="Send Email - Credit Rejected" id="_End_EmailRejected">
      <bpmn:incoming>_Flow_SendEmailRejectedPath3</bpmn:incoming>
    </bpmn:endEvent>

    <!-- End Event 3: Direct Acceptance -->
    <bpmn:endEvent name="Credit Accepted (Direct)" id="_End_DirectAccept">
      <bpmn:incoming>_Flow_SendEmailAcceptedPath1</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows Definition -->
    
    <!-- Start to Amount Check Gateway -->
    <bpmn:sequenceFlow sourceRef="_Start_01" targetRef="_Gateway_AmountThreshold" id="_Flow_StartToAmountCheck"/>

    <!-- High Value Path (Request Approval) -->
    <bpmn:sequenceFlow name="Yes (&gt; $1M)" sourceRef="_Gateway_AmountThreshold" targetRef="_Task_RequestApproval" id="_Flow_RequestApprovalHighValue">
      <bpmn:name>Yes</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Low Value Path (Risk Assessment) -->
    <bpmn:sequenceFlow name="No (&lt;= $1M)" sourceRef="_Gateway_AmountThreshold" targetRef="_Gateway_RiskAssessment" id="_Flow_AssessRiskLowValue">
      <bpmn:name>No</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Low Risk Path (Direct Acceptance) -->
    <bpmn:sequenceFlow name="Risk Low" sourceRef="_Gateway_RiskAssessment" targetRef="_Task_AcceptCredit" id="_Flow_AcceptCreditLowRisk">
      <bpmn:name>Risk Low</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- High Risk Path (Request Approval) -->
    <bpmn:sequenceFlow name="Risk High" sourceRef="_Gateway_RiskAssessment" targetRef="_Task_RequestApproval" id="_Flow_RequestApprovalHighRisk">
      <bpmn:name>Risk High</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Approval Decision Gateway -->
    <bpmn:exclusiveGateway name="Credit Approved?" id="_Gateway_ApprovalDecision2">
      <bpmn:incoming>_Flow_RequestApprovalHighValue</bpmn:incoming>
      <bpmn:outgoing>_Flow_SendEmailApprovedPath2</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Approved Path -->
    <bpmn:sequenceFlow name="Yes" sourceRef="_Task_RequestApproval" targetRef="_End_EmailAccepted" id="_Flow_SendEmailApprovedPath2">
      <bpmn:name>Credit Accepted</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Rejected Path -->
    <bpmn:sequenceFlow name="No" sourceRef="_Task_RequestApproval" targetRef="_End_EmailRejected" id="_Flow_SendEmailRejectedPath3">
      <bpmn:name>Credit Rejected</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>