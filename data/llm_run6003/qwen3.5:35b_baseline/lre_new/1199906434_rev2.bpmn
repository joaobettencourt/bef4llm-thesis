<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="_Collab_DataValidation">
    <bpmn:participant name="Technical Support Process" processRef="Process_ValidateDataError"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_ValidateDataError" isExecutable="false">
    <bpmn:laneSet id="_LaneSets_DataValidation">
      <bpmn:lane name="Technician / Drop-off Tech" id="_Lane_Technician">
        <bpmn:flowNodeRef>StartEvent_ErrorNotification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Task_CheckTypos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Gateway_IsTypoFound</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Task_CheckCustomerCorrection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Gateway_CanCorrect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Task_ScourPublicSources</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent name="Data Validation Error Notification" id="StartEvent_ErrorNotification">
      <bpmn:messageReference>_Message_DataValidationError</bpmn:messageReference>
      <bpmn:outgoing>_Flow_StartToCheckTypos</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1 -->
    <bpmn:task name="Check for Typos" id="_Task_CheckTypos">
      <bpmn:incoming>_Flow_StartToCheckTypos</bpmn:incoming>
      <bpmn:outgoing>_Flow_TyposToGateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1 -->
    <bpmn:exclusiveGateway name="Is Typo Found?" id="_Gateway_IsTypoFound">
      <bpmn:incoming>_Flow_TyposToGateway</bpmn:incoming>
      <bpmn:outgoing>_Flow_ResolvedIfTypo</bpmn:outgoing>
      <bpmn:outgoing>_Flow_NoTypoCheckCustomer</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 2 -->
    <bpmn:task name="Check Customer Correction Capability" id="_Task_CheckCustomerCorrection">
      <bpmn:incoming>_Flow_NoTypoCheckCustomer</bpmn:incoming>
      <bpmn:outgoing>_Flow_CustomerToGateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2 -->
    <bpmn:exclusiveGateway name="Can Customer Correct?" id="_Gateway_CanCorrect">
      <bpmn:incoming>_Flow_CustomerToGateway</bpmn:incoming>
      <bpmn:outgoing>_Flow_ResolvedIfCustomerFixable</bpmn:outgoing>
      <bpmn:outgoing>_Flow_ScourSourcesPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 3 -->
    <bpmn:task name="Scour Public Sources for Solutions" id="_Task_ScourPublicSources">
      <bpmn:incoming>_Flow_ScourSourcesPath</bpmn:incoming>
      <bpmn:outgoing>_Flow_ResolvedIfSearchSuccess</bpmn:outgoing>
    </bpmn:task>

    <!-- End Events -->
    <bpmn:endEvent name="Issue Resolved (Typo)" id="_End_TypoResolution">
      <bpmn:incoming>_Flow_ResolvedIfTypo</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent name="Issue Resolved (Customer Fix)" id="_End_CustomerFixResolution">
      <bpmn:incoming>_Flow_ResolvedIfCustomerFixable</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent name="Issue Resolved (Public Source)" id="_End_SearchResolution">
      <bpmn:incoming>_Flow_ResolvedIfSearchSuccess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow sourceRef="StartEvent_ErrorNotification" targetRef="_Task_CheckTypos" id="_Flow_StartToCheckTypos"/>
    
    <bpmn:sequenceFlow name="Yes (Typo Found)" sourceRef="_Gateway_IsTypoFound" targetRef="_End_TypoResolution" id="_Flow_ResolvedIfTypo">
      <bpmn:name>Is Typo?</bpmn:name>
    </bpmn:sequenceFlow>

     <bpmn:sequenceFlow name="No (Not Typo)" sourceRef="_Gateway_IsTypoFound" targetRef="_Task_CheckCustomerCorrection" id="_Flow_NoTypoCheckCustomer"/>

    <bpmn:sequenceFlow sourceRef="_Task_CheckTypos" targetRef="_Gateway_IsTypoFound" id="_Flow_TyposToGateway"/>
    
     <bpmn:sequenceFlow name="Yes (Can Correct)" sourceRef="_Gateway_CanCorrect" targetRef="_End_CustomerFixResolution" id="_Flow_ResolvedIfCustomerFixable">
      <bpmn:name>Is Fixable?</bpmn:name>
    </bpmn:sequenceFlow>

     <bpmn:sequenceFlow name="No (Cannot Correct)" sourceRef="_Gateway_CanCorrect" targetRef="_Task_ScourPublicSources" id="_Flow_ScourSourcesPath"/>

    <bpmn:sequenceFlow sourceRef="_Task_CheckCustomerCorrection" targetRef="_Gateway_CanCorrect" id="_Flow_CustomerToGateway"/>
    
     <bpmn:sequenceFlow name="Resolved (Search)" sourceRef="_Task_ScourPublicSources" targetRef="_End_SearchResolution" id="_Flow_ResolvedIfSearchSuccess">
      <bpmn:name>Solution Found</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>

  <!-- Global Message Definition -->
  <bpmn:message name="Data Validation Error Notification" id="_Message_DataValidationError"/>
</bpmn:definitions>