<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="_Collab_RewardProcess">
    <bpmn:participant name="Employee Reward &amp; Training Process" processRef="Process_EmployeeReward"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_EmployeeReward" isExecutable="false">
    <bpmn:laneSet id="_LaneSets_Reward">
      <bpmn:lane name="Management" id="_Lane_Management">
        <bpmn:flowNodeRef>StartEvent_PerformanceReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Task_CheckPerformance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Gateway_ThresholdCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Task_SuggestDismissal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Task_SuggestTraining</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Gateway_RewardType</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Task_ChooseBenefit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Task_SuggestReward</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Task_AnnounceEmployeeOfMonth</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane name="Human Resources" id="_Lane_HR">
        <bpmn:flowNodeRef>_Task_DismissEmployee</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Task_ProvideTraining</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane name="Finance Department" id="_Lane_Finance">
        <bpmn:flowNodeRef>_Task_CalculatePayFinancialReward</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent name="Performance Review" id="StartEvent_PerformanceReview">
      <bpmn:outgoing>_Flow_CheckPerformance</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Check Performance (Management) -->
    <bpmn:task name="Check Employee Performance" id="_Task_CheckPerformance">
      <bpmn:incoming>_Flow_CheckPerformance</bpmn:incoming>
      <bpmn:outgoing>_Flow_ThresholdDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Performance Thresholds (Management) -->
    <bpmn:exclusiveGateway name="Check Percentage" id="_Gateway_ThresholdCheck">
      <bpmn:incoming>_Flow_ThresholdDecision</bpmn:incoming>
      <bpmn:outgoing>_Flow_DismissalPath</bpmn:outgoing>
      <bpmn:outgoing>_Flow_TrainingPath</bpmn:outgoing>
      <bpmn:outgoing>_Flow_RewardPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Path 1: Dismissal (&lt;20%) -->
    <bpmn:task name="Suggest Employee's Dismissal" id="_Task_SuggestDismissal">
      <bpmn:incoming>_Flow_DismissalPath</bpmn:incoming>
      <bpmn:outgoing>_Flow_HRDismissAction</bpmn:outgoing>
    </bpmn:task>

    <!-- Flow to HR Lane -->
    <bpmn:sequenceFlow sourceRef="_Task_SuggestDismissal" targetRef="_Task_DismissEmployee" id="_Flow_HRDismissAction">
      <bpmn:name>Suggest Dismissal</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Task 2a: HR Action (HR) -->
    <bpmn:task name="Dismiss Employee" id="_Task_DismissEmployee">
      <bpmn:incoming>_Flow_HRDismissAction</bpmn:incoming>
      <bpmn:outgoing>_Flow_EndDismissed</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 1 -->
    <bpmn:endEvent name="Employee Terminated" id="_End_Dismissed">
      <bpmn:incoming>_Flow_EndDismissed</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Path 2: Training (20% - 50%) -->
    <bpmn:task name="Suggest Training" id="_Task_SuggestTraining">
      <bpmn:incoming>_Flow_TrainingPath</bpmn:incoming>
      <bpmn:outgoing>_Flow_HRTrainAction</bpmn:outgoing>
    </bpmn:task>

    <!-- Flow to HR Task -->
    <bpmn:sequenceFlow sourceRef="_Task_SuggestTraining" targetRef="_Task_ProvideTraining" id="_Flow_HRTrainAction">
      <bpmn:name>Suggest Training</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- HR Task -->
    <bpmn:task name="Provide Training" id="_Task_ProvideTraining">
      <bpmn:incoming>_Flow_HRTrainAction</bpmn:incoming>
      <bpmn:outgoing>_Flow_EndTrained</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 2 -->
    <bpmn:endEvent name="Training Completed" id="_End_Trained">
      <bpmn:incoming>_Flow_EndTrained</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Path 3: Reward (&gt;75%) -->
    <bpmn:task name="Suggest Employee for Reward" id="_Task_SuggestReward">
      <bpmn:incoming>_Flow_RewardPath</bpmn:incoming>
      <bpmn:outgoing>_Flow_GatewayRewardTypeInbound</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2: Reward Type (Management) -->
    <bpmn:exclusiveGateway name="Reward Type" id="_Gateway_RewardType">
      <bpmn:incoming>_Flow_GatewayRewardTypeInbound</bpmn:incoming>
      <bpmn:outgoing>_Flow_FinancialPath</bpmn:outgoing>
      <bpmn:outgoing>_Flow_BenefitPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Path 3a: Financial Reward (Finance) -->
    <bpmn:task name="Calculate and Pay Financial Reward" id="_Task_CalculatePayFinancialReward">
      <bpmn:incoming>_Flow_FinancialPath</bpmn:incoming>
      <bpmn:outgoing>_Flow_AnnounceCommon</bpmn:outgoing>
    </bpmn:task>

    <!-- Path 3b: Other Benefit (Management) -->
    <bpmn:task name="Choose Appropriate Benefit" id="_Task_ChooseBenefit">
      <bpmn:incoming>_Flow_BenefitPath</bpmn:incoming>
      <bpmn:outgoing>_Flow_AnnounceCommon</bpmn:outgoing>
    </bpmn:task>

    <!-- Common Step for Reward Path -->
    <bpmn:task name="Announce Employee of Month" id="_Task_AnnounceEmployeeOfMonth">
      <bpmn:incoming>_Flow_AnnounceCommon</bpmn:incoming>
      <bpmn:outgoing>_Flow_EndRewarded</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 3 -->
    <bpmn:endEvent name="Employee Rewarded" id="_End_Rewarded">
      <bpmn:incoming>_Flow_EndRewarded</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows Definition -->
    
    <!-- Start to Check Performance -->
    <bpmn:sequenceFlow sourceRef="StartEvent_PerformanceReview" targetRef="_Task_CheckPerformance" id="_Flow_CheckPerformance"/>
    
    <!-- Check Performance to Gateway 1 -->
    <bpmn:sequenceFlow sourceRef="_Task_CheckPerformance" targetRef="_Gateway_ThresholdCheck" id="_Flow_ThresholdDecision">
      <bpmn:name>Review Complete</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Dismissal Path -->
    <bpmn:sequenceFlow sourceRef="_Gateway_ThresholdCheck" targetRef="_Task_SuggestDismissal" id="_Flow_DismissalPath">
      <bpmn:name>Performance &lt; 20%</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Training Path -->
    <bpmn:sequenceFlow sourceRef="_Gateway_ThresholdCheck" targetRef="_Task_SuggestTraining" id="_Flow_TrainingPath">
      <bpmn:name>20% &lt; Performance &lt; 50%</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Reward Path -->
    <bpmn:sequenceFlow sourceRef="_Gateway_ThresholdCheck" targetRef="_Task_SuggestReward" id="_Flow_RewardPath">
      <bpmn:name>Performance &gt; 75%</bpmn:name>
    </bpmn:sequenceFlow>

     <!-- Flow from Reward Task to Gateway -->
    <bpmn:sequenceFlow sourceRef="_Task_SuggestReward" targetRef="_Gateway_RewardType" id="_Flow_GatewayRewardTypeInbound"/>

    <!-- Financial Path -->
    <bpmn:sequenceFlow sourceRef="_Gateway_RewardType" targetRef="_Task_CalculatePayFinancialReward" id="_Flow_FinancialPath">
      <bpmn:name>Financial Reward</bpmn:name>
    </bpmn:sequenceFlow>

     <!-- Benefit Path -->
    <bpmn:sequenceFlow sourceRef="_Gateway_RewardType" targetRef="_Task_ChooseBenefit" id="_Flow_BenefitPath">
      <bpmn:name>Other Benefit</bpmn:name>
    </bpmn:sequenceFlow>

     <!-- Flow from Financial Task to Announce -->
    <bpmn:sequenceFlow sourceRef="_Task_CalculatePayFinancialReward" targetRef="_Task_AnnounceEmployeeOfMonth" id="_Flow_FinancialToAnnounce"/>

    <!-- Flow from Benefit Task to Announce -->
    <bpmn:sequenceFlow sourceRef="_Task_ChooseBenefit" targetRef="_Task_AnnounceEmployeeOfMonth" id="_Flow_BenefitToAnnounce"/>


  </bpmn:process>
</bpmn:definitions>