<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="_Collab_OrderProcess">
    <bpmn:participant name="Order Fulfillment Process" processRef="Process_Orders"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Orders" isExecutable="false">
    <bpmn:laneSet id="_LaneSets_Order">
      <bpmn:lane name="Staff" id="_Lane_Staff">
        <bpmn:flowNodeRef>_StartEvent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Task_ReviewOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Gateway_ItemsAvailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Task_InformCustomerDelay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Task_OrderMissingProducts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Gateway_DiscontinuedItem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Task_InformDiscontinuedItems</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Event_WaitingDelivery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Gateway_RecheckAvailability</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Task_RecollectProducts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Task_PreparePackage</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane name="Courier Company" id="_Lane_Courier">
        <bpmn:flowNodeRef>_Event_InformCustomerDelay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Task_PickupPackage</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent name="Order Received" id="_StartEvent">
      <bpmn:outgoing>_Flow_ReviewOrder</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Review Order (Staff) -->
    <bpmn:task name="Review Order Details" id="_Task_ReviewOrder">
      <bpmn:incoming>_Flow_ReviewOrder</bpmn:incoming>
      <bpmn:outgoing>_Flow_CheckItemsAvailable</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Check Item Availability (Staff) -->
    <bpmn:exclusiveGateway name="All Items Available?" id="_Gateway_ItemsAvailable">
      <bpmn:incoming>_Flow_CheckItemsAvailable</bpmn:incoming>
      <bpmn:outgoing>_Flow_ContinueProcessing</bpmn:outgoing>
      <bpmn:outgoing>_Flow_MissingItemDetected</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 2a: Inform Customer About Delay (Staff) -->
    <bpmn:task name="Inform Customer of Potential Delay" id="_Task_InformCustomerDelay">
      <bpmn:incoming>_Flow_MissingItemDetected</bpmn:incoming>
      <bpmn:outgoing>_Flow_OrderMissingProducts</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2b: Order Missing Products (Staff) -->
    <bpmn:task name="Order Missing Products" id="_Task_OrderMissingProducts">
      <bpmn:incoming>_Flow_OrderMissingProducts</bpmn:incoming>
      <bpmn:outgoing>_Flow_WaitingDeliveryStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2a: Check for Discontinued Item (Staff) -->
    <bpmn:exclusiveGateway name="Discontinued Item?" id="_Gateway_DiscontinuedItem">
      <bpmn:incoming>_Flow_OrderMissingProducts</bpmn:incoming>
      <bpmn:outgoing>_Flow_ContinueAfterOrdering</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 2c: Inform About Discontinued Items (Staff) -->
    <bpmn:task name="Inform Customer of Unavailable Items" id="_Task_InformDiscontinuedItems">
      <bpmn:incoming>_Flow_DiscontinuedDetected</bpmn:incoming>
      <bpmn:outgoing>_Flow_ContinueAfterOrdering</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Event: Wait for Delivery (Staff) -->
    <bpmn:intermediateCatchEvent name="Wait x Days" id="_Event_WaitingDelivery">
      <bpmn:incoming>_Flow_WaitingDeliveryStart</bpmn:incoming>
      <bpmn:outgoing>_Flow_RecheckAvailability</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Gateway 3: Re-check Availability (Staff) -->
    <bpmn:exclusiveGateway name="All Products Available?" id="_Gateway_RecheckAvailability">
      <bpmn:incoming>_Flow_WaitingDeliveryStart</bpmn:incoming>
      <bpmn:outgoing>_Flow_ContinueProcessing</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 3a: Recollect Products (Staff) -->
    <bpmn:task name="Recollect All Products" id="_Task_RecollectProducts">
      <bpmn:incoming>_Flow_ContinueProcessing</bpmn:incoming>
      <bpmn:outgoing>_Flow_PreparePackageStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3b: Prepare Package (Staff) -->
    <bpmn:task name="Prepare Package" id="_Task_PreparePackage">
      <bpmn:incoming>_Flow_PreparePackageStart</bpmn:incoming>
      <bpmn:outgoing>_Flow_InformCourierCompany</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 4a: Courier Informs Client (Staff) -->
    <bpmn:task name="Inform Customer of Potential Delay" id="_Event_InformCustomerDelay">
      <bpmn:incoming>_Flow_CourierInformed</bpmn:incoming>
      <bpmn:outgoing>_Flow_WaitResourcesAvailable</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 4b: Courier Picks Up Package (Courier Company) -->
    <bpmn:task name="Pickup Package" id="_Task_PickupPackage">
      <bpmn:incoming>_Flow_WaitResourcesAvailable</bpmn:incoming>
      <bpmn:outgoing>_Flow_DriverDeliversStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 5a: Centralized Service Route Decision (Staff) -->
    <bpmn:task name="Determine Best Delivery Route" id="_Task_RouteDecision">
      <bpmn:incoming>_Flow_DriverDeliversStart</bpmn:incoming>
      <bpmn:outgoing>_Flow_DeliveryComplete</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 5b: Driver Delivers Package (Courier Company) -->
    <bpmn:task name="Deliver Package" id="_Task_DriverDelivery">
      <bpmn:incoming>_Flow_WaitResourcesAvailable</bpmn:incoming>
      <bpmn:outgoing>_Flow_UpdateSystemStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 6: Update System and Notify Stakeholders (Staff) -->
    <bpmn:task name="Update System &amp; Notify All" id="_Task_SystemNotification">
      <bpmn:incoming>_Flow_UpdateSystemStart</bpmn:incoming>
      <bpmn:outgoing>_Flow_ProcessCompleteEndEventLink</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent name="Order Process Complete" id="_End_Event">
      <bpmn:incoming>_Flow_ProcessCompleteEndEventLink</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows Definition -->
    
    <!-- Initial Flow -->
    <bpmn:sequenceFlow sourceRef="_StartEvent" targetRef="_Task_ReviewOrder" id="_Flow_ReviewOrder"/>
    <bpmn:sequenceFlow name="Check Availability" sourceRef="_Task_ReviewOrder" targetRef="_Gateway_ItemsAvailable" id="_Flow_CheckItemsAvailable"/>

    <!-- Missing Item Path -->
    <bpmn:sequenceFlow name="No - Items Missing" sourceRef="_Gateway_ItemsAvailable" targetRef="_Task_InformCustomerDelay" id="_Flow_MissingItemDetected"/>
    
    <!-- Discontinued Check Flow (Staff) -->
    <bpmn:exclusiveDataAssociation conditionExpression="${Discontinued = true}" name="Yes"> 
      <sequenceFlow sourceRef="_Gateway_DiscontinuedItem" targetRef="_Task_InformDiscontinuedItems" id="_Flow_DiscontinuedDetected"/>
    </bpmn:exclusiveDataAssociation>

    <!-- Continue After Ordering -->
    <bpmn:sequenceFlow name="Wait for Delivery" sourceRef="_Task_OrderMissingProducts" targetRef="_Event_WaitingDelivery" id="_Flow_WaitingDeliveryStart">
      <bpmn:name>Wait for Delivery</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Recheck Availability -->
    <bpmn:sequenceFlow name="All Available - Yes" sourceRef="_Gateway_RecheckAvailability" targetRef="_Task_RecollectProducts" id="_Flow_ContinueProcessing">
      <bpmn:name>All Available - Yes</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Package Preparation -->
    <bpmn:sequenceFlow name="All Available - Yes" sourceRef="_Task_RecollectProducts" targetRef="_Task_PreparePackage" id="_Flow_PreparePackageStart">
      <bpmn:name>All Available - Yes</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Courier Company Flow -->
    <bpmn:sequenceFlow name="Courier Informed" sourceRef="_Task_PreparePackage" targetRef="_Event_InformCustomerDelay" id="_Flow_CourierInformed">
      <bpmn:name>Courier Informed</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Wait for Resources -->
    <bpmn:sequenceFlow name="Wait Until Resources Available" sourceRef="_Task_PickupPackage" targetRef="_Task_DriverDelivery" id="_Flow_WaitResourcesAvailable">
      <bpmn:name>Wait Until Resources Available</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Route Decision -->
    <bpmn:sequenceFlow sourceRef="_Task_RouteDecision" targetRef="_End_Event" id="_Flow_DeliveryComplete"/>

    <!-- System Update Flow -->
    <bpmn:sequenceFlow name="Update After Delivery" sourceRef="_Task_DriverDelivery" targetRef="_Task_SystemNotification" id="_Flow_UpdateSystemStart">
      <bpmn:name>Update After Delivery</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Final End Flow -->
    <bpmn:sequenceFlow sourceRef="_Task_SystemNotification" targetRef="_End_Event" id="_Flow_ProcessCompleteEndEventLink"/>

  </bpmn:process>
</bpmn:definitions>