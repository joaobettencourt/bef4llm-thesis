<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_RestaurantProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_RestaurantService">
    <bpmn:participant id="Participant_ServiceSystem" name="Gastbedienungsprozess Restaurant" processRef="Process_RestaurantOrdering"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_RestaurantOrdering" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Gast" name="Gast">
        <bpmn:flowNodeRef>StartEvent_01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WahlGericht</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WartenBisReihe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_PieperErhalt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_01</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Angestellter" name="Angestellter">
        <bpmn:flowNodeRef>InclusiveGateway_BestellungAufgeben</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EingabeKassensystem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_KassenVorgang</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PieberEinrichten</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_FoodReadyCheck</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Koch" name="Koch">
        <bpmn:flowNodeRef>InclusiveGateway_BestellungAnKueche</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MahlzeitZubereiten</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DurchreicheStellen</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_01" name="Gast betritt Restaurant">
      <bpmn:outgoing>SequenceFlow_GastBetritt</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Guest Tasks -->
    <bpmn:task id="Task_WahlGericht" name="Wähle Gericht aus Angebot">
      <bpmn:incoming>SequenceFlow_GastBetritt</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BereitschaftBestellung</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_WartenBisReihe" name="Warte bis an der Reihe">
      <bpmn:incoming>SequenceFlow_BereitschaftBestellung</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OrderGebenAnAngestellter</bpmn:outgoing>
    </bpmn:task>

    <!-- Staff Tasks -->
    <bpmn:inclusiveGateway id="InclusiveGateway_BestellungAufgeben" name="Bestellung aufnehmen">
      <bpmn:incoming>SequenceFlow_OrderGebenAnAngestellter</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EingabeKassensystemStart</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <bpmn:task id="Task_EingabeKassensystem" name="Bestellung in Kassensystem eingeben">
      <bpmn:incoming>SequenceFlow_EingabeKassensystemStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_KassenVorgangStart</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_KassenVorgang" name="Geld vom Gast kassieren">
      <bpmn:incoming>SequenceFlow_KassenVorgangStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PieperEinrichtenStart</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_PieberEinrichten" name="Pieber einrichten &amp; übergeben">
      <bpmn:incoming>SequenceFlow_PieperEinrichtenStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_KochInformierenStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Kitchen Tasks -->
    <bpmn:inclusiveGateway id="InclusiveGateway_BestellungAnKueche" name="Bestellung an Koch">
      <bpmn:incoming>SequenceFlow_KochInformierenStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MahlzeitZubereitenStart</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <bpmn:task id="Task_MahlzeitZubereiten" name="Mahlzeit zubereiten">
      <bpmn:incoming>SequenceFlow_MahlzeitZubereitenStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DurchreicheStellenStart</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_DurchreicheStellen" name="Mahlzeit in Durchreiche stellen">
      <bpmn:incoming>SequenceFlow_DurchreicheStellenStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_KochInformiertAngestellter</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_01" name="Mahlzeit verzehrt">
      <bpmn:incoming>SequenceFlow_MahlzeitVerzehrt</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Intermediate Events for Signal -->
    <bpmn:intermediateCatchEvent id="Event_PieperErhalt" name="Pieber meldet sich">
      <bpmn:incoming>SequenceFlow_SignalPiperRingt</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GastHoltEssenAb</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Sequence Flows -->
    
    <!-- Guest Lane Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_GastBetritt" name="Hunger verspürt" sourceRef="StartEvent_01" targetRef="Task_WahlGericht"/>
    <bpmn:sequenceFlow id="SequenceFlow_BereitschaftBestellung" name="Bereit zur Bestellung" sourceRef="Task_WahlGericht" targetRef="Task_WartenBisReihe"/>
    
    <!-- Interaction Guest to Staff -->
    <bpmn:sequenceFlow id="SequenceFlow_OrderGebenAnAngestellter" name="Ordnung aufgeben" sourceRef="Task_WartenBisReihe" targetRef="InclusiveGateway_BestellungAufgeben">
      <bpmn:name>an der Reihe</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Staff Lane Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_EingabeKassensystemStart" name="Bestellung eingeben" sourceRef="InclusiveGateway_BestellungAufgeben" targetRef="Task_EingabeKassensystem"/>
    <bpmn:sequenceFlow id="SequenceFlow_KassenVorgangStart" name="Geld kassieren" sourceRef="Task_EingabeKassensystem" targetRef="Task_KassenVorgang"/>
    
    <!-- Payment Confirmation to Pager Setup -->
    <bpmn:sequenceFlow id="SequenceFlow_PieperEinrichtenStart" name="Wenn Gast bezahlt hat" sourceRef="Task_KassenVorgang" targetRef="Task_PieberEinrichten">
      <bpmn:name>bezahlt</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Inform Kitchen -->
    <bpmn:sequenceFlow id="SequenceFlow_KochInformierenStart" name="Koch informieren über Mahlzeit" sourceRef="Task_PieberEinrichten" targetRef="InclusiveGateway_BestellungAnKueche"/>

    <!-- Parallel Split for Cooking and Waiting (Implicit via Gateway logic) -->
    <bpmn:sequenceFlow id="SequenceFlow_MahlzeitZubereitenStart" name="Mahlzeit zubereiten" sourceRef="InclusiveGateway_BestellungAnKueche" targetRef="Task_MahlzeitZubereiten"/>

    <!-- Kitchen to Pass Through -->
    <bpmn:sequenceFlow id="SequenceFlow_DurchreicheStellenStart" name="in Durchreich stellen" sourceRef="Task_MahlzeitZubereiten" targetRef="Task_DurchreicheStellen"/>

    <!-- Inform Staff Food Ready (Loop back logic) -->
    <bpmn:sequenceFlow id="SequenceFlow_KochInformiertAngestellter" name="Koch informiert Angestellten" sourceRef="Task_DurchreicheStellen" targetRef="InclusiveGateway_FoodReadyCheck">
      <bpmn:name>Essen fertig</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Staff Triggers Pager -->
    <bpmn:inclusiveGateway id="InclusiveGateway_FoodReadyCheck" name="Pieber auslösen?">
      <bpmn:incoming>SequenceFlow_KochInformiertAngestellter</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SignalPiperRingt</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Signal to Guest -->
    <bpmn:sequenceFlow id="SequenceFlow_SignalPiperRingt" name="Pieber meldet sich" sourceRef="InclusiveGateway_FoodReadyCheck" targetRef="Event_PieperErhalt"/>

    <!-- Guest Picks Up Food after Signal or Call Out (Merged logic) -->
    <bpmn:sequenceFlow id="SequenceFlow_GastHoltEssenAb" name="Essen abholen" sourceRef="Event_PieperErhalt" targetRef="EndEvent_01"/>

  </bpmn:process>
</bpmn:definitions>