<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_RoomService_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_RoomService">
    <bpmn:participant id="Participant_Evanstonian" name="The Evanstonian Room Service" processRef="Process_1" />
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Manager" name="Room-Service Manager">
        <bpmn:flowNodeRef>StartEvent_GuestCall</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TakeOrder</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Preparation" name="Kitchen &amp; Sommelier">
        <bpmn:flowNodeRef>ParallelGateway_SplitPrep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_KitchenPrepareFood</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SommelierFetchWine</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Waiter" name="Waiter">
        <bpmn:flowNodeRef>ParallelGateway_MergeDelivery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReadyCartDrinks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DeliverRoomService</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReturnStation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_BillingWait</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_GuestCall" name="Guest Calls Room Service">
      <bpmn:outgoing>SequenceFlow_TakeOrder</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Manager Task -->
    <bpmn:task id="Task_TakeOrder" name="Take Down Order &amp; Submit Tickets">
      <bpmn:incoming>SequenceFlow_TakeOrder</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SplitPrep</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Split Gateway -->
    <bpmn:parallelGateway id="ParallelGateway_SplitPrep">
      <bpmn:name>Start Preparation Phase</bpmn:name>
      <bpmn:incoming>SequenceFlow_SplitPrep</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_KitchenTask</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_WineTask</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_WaiterPrep</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Kitchen Task -->
    <bpmn:task id="Task_KitchenPrepareFood" name="Prepare Food">
      <bpmn:incoming>SequenceFlow_KitchenTask</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FoodReady</bpmn:outgoing>
    </bpmn:task>

    <!-- Sommelier Task -->
    <bpmn:task id="Task_SommelierFetchWine" name="Fetch Wine &amp; Alcoholic Beverages">
      <bpmn:incoming>SequenceFlow_WineTask</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WineReady</bpmn:outgoing>
    </bpmn:task>

    <!-- Waiter Cart Task -->
    <bpmn:task id="Task_ReadyCartDrinks" name="Ready Cart &amp; Non-Alcoholic Drinks">
      <bpmn:incoming>SequenceFlow_WaiterPrep</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CartReady</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flows from Split -->
    <bpmn:sequenceFlow id="SequenceFlow_TakeOrder" sourceRef="StartEvent_GuestCall" targetRef="Task_TakeOrder">
      <bpmn:name />
    </bpmn:sequenceFlow>
    
    <bpmn:sequenceFlow id="SequenceFlow_SplitPrep" name="" sourceRef="Task_TakeOrder" targetRef="ParallelGateway_SplitPrep" />
    <bpmn:sequenceFlow id="SequenceFlow_KitchenTask" name="Submit Order Ticket" sourceRef="ParallelGateway_SplitPrep" targetRef="Task_KitchenPrepareFood" />
    <bpmn:sequenceFlow id="SequenceFlow_WineTask" name="Give Order to Sommelier (80%)" sourceRef="ParallelGateway_SplitPrep" targetRef="Task_SommelierFetchWine" />

    <!-- Waiter Prep Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_WaiterPrep" name="" sourceRef="ParallelGateway_SplitPrep" targetRef="Task_ReadyCartDrinks" />

    <!-- Merge Gateway for Delivery -->
    <bpmn:parallelGateway id="ParallelGateway_MergeDelivery">
      <bpmn:name>Wait for All Items</bpmn:name>
      <bpmn:incoming>SequenceFlow_FoodReady</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_WineReady</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_CartReady</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DeliveryStart</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Delivery Task -->
    <bpmn:task id="Task_DeliverRoomService" name="Deliver to Guest Room">
      <bpmn:incoming>SequenceFlow_DeliveryStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReturnInit</bpmn:outgoing>
    </bpmn:task>

    <!-- Return Task -->
    <bpmn:task id="Task_ReturnStation" name="Return to Room-Service Station">
      <bpmn:incoming>SequenceFlow_ReturnInit</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BillingDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Billing Decision Gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_BillingWait" name="Another Order?">
      <bpmn:name />
      <bpmn:incoming>SequenceFlow_ReturnInit</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DebitAccountNow</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Billing Task -->
    <bpmn:task id="Task_DebitGuest" name="Debit Guest Account">
      <bpmn:name />
      <bpmn:incoming>SequenceFlow_BillingDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndOrder</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_OrderComplete" name="Order Completed">
      <bpmn:incoming>SequenceFlow_EndOrder</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>