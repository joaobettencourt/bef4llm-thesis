<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_RecruitmentProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_Recruitment">
    <bpmn:participant id="Participant_HRDepartment" name="HR Department Process" processRef="Process_VacancyManagement" />
  </bpmn:collaboration>

  <bpmn:process id="Process_VacancyManagement" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Requester">
        <bpmn:flowNodeRef>StartEvent_DetectRequirements</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReportVacancy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ReviewJobDescription</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_HRDepartment">
        <bpmn:flowNodeRef>Task_ProvideJobDescription</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_QuestionsAboutTasks</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Recruiter">
        <bpmn:flowNodeRef>Task_ApproveJobDescription</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AdvertiseVacancy</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_DetectRequirements" name="Detect Personnel Requirements">
      <bpmn:outgoing>SequenceFlow_ReportVacancy</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Report Vacancy -->
    <bpmn:task id="Task_ReportVacancy" name="Report Vacancy to Personnel Department">
      <bpmn:incoming>SequenceFlow_ReportVacancy</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitJobDescription</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: HR Provides Job Description -->
    <bpmn:task id="Task_ProvideJobDescription" name="Provide Job Description">
      <bpmn:incoming>SequenceFlow_WaitJobDescription</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReviewJobDescription</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Questions About Tasks -->
    <bpmn:exclusiveGateway id="Gateway_QuestionsAboutTasks" name="HR Has Questions?">
      <bpmn:incoming>SequenceFlow_ReviewJobDescription</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProvideClarificationsPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Gateway 2: Corrections Needed -->
    <bpmn:exclusiveGateway id="Gateway_CorrectionsNeeded" name="Corrections Required?">
      <bpmn:incoming>SequenceFlow_ReviewJobDescription</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProvideClarificationsPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Gateway 3: Approval Decision -->
    <bpmn:exclusiveGateway id="Gateway_ApprovalDecision" name="Approve Job Description?">
      <bpmn:incoming>SequenceFlow_ReviewJobDescription</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AdvertiseVacancyPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 3: Provide Clarifications -->
    <bpmn:task id="Task_ProvideClarifications" name="Provide Clarifications on Tasks and Requirements">
      <bpmn:incoming>SequenceFlow_ProvideClarificationsPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReturnToReview</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 4: Approve Job Description -->
    <bpmn:task id="Task_ApproveJobDescription" name="Approve Job Description">
      <bpmn:incoming>SequenceFlow_AdvertiseVacancyPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AdvertiseVacancyDirectly</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 5: Advertise Vacancy -->
    <bpmn:task id="Task_AdvertiseVacancy" name="Advertise Job">
      <bpmn:incoming>SequenceFlow_AdvertiseVacancyDirectly</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndProcess</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_ProcessComplete" name="Job Advertised">
      <bpmn:incoming>SequenceFlow_EndProcess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_ReportVacancy" sourceRef="StartEvent_DetectRequirements" targetRef="Task_ReportVacancy" />
    <bpmn:sequenceFlow id="SequenceFlow_WaitJobDescription" name="Wait for Job Description" sourceRef="Task_ReportVacancy" targetRef="Task_ProvideJobDescription" />
    <bpmn:sequenceFlow id="SequenceFlow_ReviewJobDescription" name="For Review" sourceRef="Task_ProvideJobDescription" targetRef="Gateway_QuestionsAboutTasks" />

    <!-- Decision Flow 1: HR Questions -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_HRQuestions">
      <bpmn:name>HR Has Questions?</bpmn:name>
      <bpmn:incoming>SequenceFlow_ReviewJobDescription</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProvideClarificationsPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Decision Flow 2: Corrections Needed -->
    <bpmn:sequenceFlow id="SequenceFlow_AskCorrections" name="Yes - Corrections Required" sourceRef="ExclusiveGateway_HRQuestions" targetRef="Task_ProvideClarificationsLoop">
      <bpmn:name>Ask for corrections</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Decision Flow 3: Approval Path -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_ApprovalPath" name="Approve Description?">
      <bpmn:incoming>SequenceFlow_ReviewJobDescription</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AdvertiseVacancyDirectly</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task Loop Back -->
    <bpmn:task id="Task_ProvideClarificationsLoop" name="Provide Clarifications">
      <bpmn:name />
      <bpmn:incoming>SequenceFlow_AskCorrections</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReturnToReview</bpmn:outgoing>
    </bpmn:task>

    <!-- Loop Back Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_ReturnToReview" sourceRef="Task_ProvideClarificationsLoop" targetRef="ExclusiveGateway_HRQuestions">
      <bpmn:name />
    </bpmn:sequenceFlow>

    <!-- Final Sequence Flows -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_ApproveJobDescription" name="Approve Job Description?">
      <bpmn:incoming>SequenceFlow_ReviewJobDescription</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AdvertiseVacancyPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Final Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_ApproveAndAdvertise" name="Yes - Approve and Advertise" sourceRef="ExclusiveGateway_ApprovalPath" targetRef="Task_AdvertiseVacancy">
      <bpmn:name />
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_EndProcess" name="Job Advertised Successfully" sourceRef="Task_AdvertiseVacancy" targetRef="EndEvent_ProcessComplete">
      <bpmn:name />
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>