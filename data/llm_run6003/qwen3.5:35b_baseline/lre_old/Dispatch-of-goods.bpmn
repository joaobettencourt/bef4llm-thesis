<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_DispatchGoods" name="Dispatch of Goods Computer Hardware Shop" processRef="Process_Shipment"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Shipment" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Secretary" name="Secretary">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ClariyfyShippingMethod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_SpecialHandling</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InviteLogisticCompanies</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectCompany</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Logistics" name="Logistics Department Head">
        <bpmn:flowNodeRef>InclusiveGateway_InsuranceNecessary</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TakeParcelInsurance</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Warehouse" name="Warehousemen">
        <bpmn:flowNodeRef>InclusiveGateway_PackageGoods</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PackageGoods</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Ship goods">
      <bpmn:outgoing>SequenceFlow_StartToClarify</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Secretary Task - Clarify Shipping Method -->
    <bpmn:task id="Task_ClariyfyShippingMethod" name="Clarify shipment method">
      <bpmn:incoming>SequenceFlow_StartToClarify</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ClarifyToSpecialHandling</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway - Special Handling Decision -->
    <bpmn:exclusiveGateway id="InclusiveGateway_SpecialHandling" name="Large amounts?">
      <bpmn:incoming>SequenceFlow_ClarifyToSpecialHandling</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_YesLogisticCompanies</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoNormalPost</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Yes Path - Invite 3 logistic companies -->
    <bpmn:task id="Task_InviteLogisticCompanies" name="Get 3 offers from logistic companies">
      <bpmn:incoming>SequenceFlow_YesLogisticCompanies</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SelectCompanyAfterInvitation</bpmn:outgoing>
    </bpmn:task>

    <!-- Yes Path - Select one company -->
    <bpmn:task id="Task_SelectCompany" name="Select logistic company and place order">
      <bpmn:incoming>SequenceFlow_SelectCompanyAfterInvitation</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CompanySelectedToMerge1</bpmn:outgoing>
    </bpmn:task>

    <!-- No Path - Write package label -->
    <bpmn:task id="Task_WritePackageLabel" name="Write package label">
      <bpmn:incoming>SequenceFlow_NoNormalPost</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_LabelWrittenToInsuranceCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway - Insurance Necessary -->
    <bpmn:exclusiveGateway id="InclusiveGateway_InsuranceNecessary" name="Insurance necessary?">
      <bpmn:incoming>SequenceFlow_LabelWrittenToInsuranceCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TakeInsuranceYes</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoInsuranceSkip</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Insurance Task -->
    <bpmn:task id="Task_TakeParcelInsurance" name="Insure parcel">
      <bpmn:incoming>SequenceFlow_TakeInsuranceYes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InsuranceDoneToMerge1</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway for Warehouse Packaging -->
    <bpmn:parallelGateway id="ParallelGateway_PackageGoods" name="">
      <bpmn:incoming>SequenceFlow_NoNormalPost</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WarehousePackageStart</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Warehouse Task - Package Goods -->
    <bpmn:task id="Task_PackageGoods" name="Package goods">
      <bpmn:incoming>SequenceFlow_WarehousePackageStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GoodsPackagedToMerge2</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway - Merge Point 1 (After Insurance or Skip) -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_Merge1" name="">
      <bpmn:incoming>SequenceFlow_CompanySelectedToMerge1</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_NoInsuranceSkip</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Merge1ToPreparePickup</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Gateway - Merge Point 2 (After Insurance and Warehouse) -->
    <bpmn:parallelGateway id="ParallelGateway_Merge2" name="">
      <bpmn:incoming>SequenceFlow_InsuranceDoneToMerge1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InsuranceDoneToMerge2</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Final Merge Gateway -->
    <bpmn:parallelGateway id="ParallelGateway_PreparePickup" name="">
      <bpmn:incoming>SequenceFlow_Merge1ToPreparePickup</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PaymentReadyToPreparePickup</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Final Task - Prepare for Pickup -->
    <bpmn:task id="Task_PrepareForPickUp" name="Prepare for picking up goods">
      <bpmn:incoming>SequenceFlow_PaymentReadyToPreparePickup</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PickupPreparedToEnd</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_1" name="Shipment prepared">
      <bpmn:incoming>SequenceFlow_PickupPreparedToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows - Yes Path (Large Amounts) -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToClarify" sourceRef="StartEvent_1" targetRef="Task_ClariyfyShippingMethod"/>
    <bpmn:sequenceFlow id="SequenceFlow_ClarifyToSpecialHandling" name="" sourceRef="Task_ClariyfyShippingMethod" targetRef="InclusiveGateway_SpecialHandling"/>

    <!-- Yes Path - Special Handling -->
    <bpmn:sequenceFlow id="SequenceFlow_YesLogisticCompanies" name="Large amounts (yes)" sourceRef="InclusiveGateway_SpecialHandling" targetRef="Task_InviteLogisticCompanies"/>
    <bpmn:sequenceFlow id="SequenceFlow_SelectCompanyAfterInvitation" sourceRef="Task_InviteLogisticCompanies" targetRef="Task_SelectCompany"/>
    <bpmn:sequenceFlow id="SequenceFlow_CompanySelectedToMerge1" name="" sourceRef="Task_SelectCompany" targetRef="ExclusiveGateway_Merge1"/>

    <!-- No Path - Normal Post -->
    <bpmn:sequenceFlow id="SequenceFlow_NoNormalPost" name="Small amounts (no)" sourceRef="InclusiveGateway_SpecialHandling" targetRef="ParallelGateway_PackageGoods"/>
    <bpmn:sequenceFlow id="SequenceFlow_LabelWrittenToInsuranceCheck" sourceRef="Task_WritePackageLabel" targetRef="InclusiveGateway_InsuranceNecessary"/>

    <!-- Insurance Decision -->
    <bpmn:sequenceFlow id="SequenceFlow_TakeInsuranceYes" name="yes" sourceRef="InclusiveGateway_InsuranceNecessary" targetRef="Task_TakeParcelInsurance"/>
    <bpmn:sequenceFlow id="SequenceFlow_NoInsuranceSkip" name="no" sourceRef="InclusiveGateway_InsuranceNecessary" targetRef="ExclusiveGateway_Merge1"/>

    <!-- Warehouse Parallel Path -->
    <bpmn:sequenceFlow id="SequenceFlow_WarehousePackageStart" sourceRef="ParallelGateway_PackageGoods" targetRef="Task_PackageGoods"/>
    
    <!-- Merge Insurance and Warehouse Paths -->
    <bpmn:parallelGateway id="InclusiveGateway_InsuranceAndWarehouseMerge">
      <bpmn:incoming>SequenceFlow_TakeParcelInsurance</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InsuranceDoneToMerge1</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Merge Insurance and Warehouse Paths -->
    <bpmn:sequenceFlow id="SequenceFlow_GoodsPackagedToMerge2" sourceRef="Task_PackageGoods" targetRef="InclusiveGateway_InsuranceAndWarehouseMerge"/>
    
    <!-- Final Merge Gateway -->
    <bpmn:parallelGateway id="ParallelGateway_PreparePickup">
      <bpmn:incoming>SequenceFlow_Merge1ToPreparePickup</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PaymentReadyToPreparePickup</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Final Merge and End -->
    <bpmn:sequenceFlow id="SequenceFlow_Merge1ToPreparePickup" sourceRef="ExclusiveGateway_Merge1" targetRef="ParallelGateway_PreparePickup"/>
    <bpmn:sequenceFlow id="SequenceFlow_PaymentReadyToPreparePickup" name="" sourceRef="ParallelGateway_PreparePickup" targetRef="Task_PrepareForPickUp"/>
    <bpmn:sequenceFlow id="SequenceFlow_InsuranceDoneToMerge1" name="" sourceRef="InclusiveGateway_InsuranceAndWarehouseMerge" targetRef="ExclusiveGateway_Merge1"/>

  </bpmn:process>
</bpmn:definitions>