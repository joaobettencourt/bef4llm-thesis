<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_MPON" name="MPON" processRef="Process_MPON"/>
    <bpmn:participant id="Participant_MPOO" name="MPOO" processRef="Process_MPOO"/>
    <bpmn:participant id="Participant_GO" name="GO" processRef="Process_GO"/>
  </bpmn:collaboration>

  <!-- MPON Process -->
  <bpmn:process id="Process_MPON" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1_MPON" name="Equipment Change Intention Received">
      <bpmn:outgoing>SequenceFlow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_1_MPON" name="Notify MPOO about Equipment Change Intentions">
      <bpmn:incoming>SequenceFlow_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_02</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_1_MPON" name="Self Dismounting?">
      <bpmn:incoming>SequenceFlow_03</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_04</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_2_MPON" name="Perform Final Reading">
      <bpmn:incoming>SequenceFlow_05</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_06</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_2_MPON" name="Dismount Old Equipment?">
      <bpmn:incoming>SequenceFlow_07</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_08</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_3_MPON" name="Dismount Old Equipment">
      <bpmn:incoming>SequenceFlow_09</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_4_MPON" name="Mount New Device">
      <bpmn:incoming>SequenceFlow_11</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_12</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_5_MPON" name="Read Meter Count from Installed Meter">
      <bpmn:incoming>SequenceFlow_13</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_14</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_1_MPON" name="Process Completed">
      <bpmn:incoming>SequenceFlow_20</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_01" sourceRef="StartEvent_1_MPON" targetRef="Task_1_MPON"/>
    <bpmn:sequenceFlow id="SequenceFlow_02" name="Notify MPOO Intentions" sourceRef="Task_1_MPON" targetRef="Gateway_MPOO_Response">
      <bpmn:messageEventDefinition/>
    </bpmn:sequenceFlow>

    <!-- Message Flow from MPON to MPOO -->
  </bpmn:process>

  <!-- MPOO Process -->
  <bpmn:process id="Process_MPOO" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1_MPOO" name="Receive Equipment Change Notification">
      <bpmn:outgoing>SequenceFlow_21</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:exclusiveGateway id="Gateway_1_MPOO" name="Self Dismounting?">
      <bpmn:incoming>SequenceFlow_22</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_23</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_1_MPOO" name="Announce Self Dismounting to MPON">
      <bpmn:incoming>SequenceFlow_24</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_25</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_2_MPOO" name="No Self-Dismounting?">
      <bpmn:incoming>SequenceFlow_26</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_27</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_2_MPOO" name="Notify MPON about No Self-Dismounting">
      <bpmn:incoming>SequenceFlow_28</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_29</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_21" sourceRef="StartEvent_1_MPOO" targetRef="Gateway_1_MPOO"/>
  </bpmn:process>

  <!-- GO Process -->
  <bpmn:process id="Process_GO" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1_GO" name="Receive Device Change Information from MPON">
      <bpmn:outgoing>SequenceFlow_30</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_1_GO" name="Notify MSP about Device Changes, Master Data and Meter Counts">
      <bpmn:incoming>SequenceFlow_31</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_32</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_1_GO" name="Process Completed">
      <bpmn:incoming>SequenceFlow_33</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_30" sourceRef="StartEvent_1_GO" targetRef="Task_1_GO"/>
  </bpmn:process>

  <!-- Message Flows between Participants -->
  <bpmn:messageFlow id="MessageFlow_MPON_MPOO">
    <bpmn:sourceRef>SequenceFlow_02</bpmn:sourceRef>
    <bpmn:targetRef>StartEvent_1_MPOO</bpmn:targetRef>
  </bpmn:messageFlow>

  <!-- Data Objects -->
  <bpmn:dataObject id="Data_FinalReading" name="Final Reading Values"/>
  <bpmn:dataObject id="Data_DeviceChanges" name="Device Changes Information"/>
  <bpmn:dataObject id="Data_MasterData" name="Master Data"/>

</bpmn:definitions>