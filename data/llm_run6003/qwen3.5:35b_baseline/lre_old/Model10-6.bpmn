<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Dismissal Process" processRef="Process_1"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_MSPN" name="MSPN">
        <bpmn:flowNodeRef>StartEvent_Dismissal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendDismissal</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_MSPO" name="MSPO">
        <bpmn:flowNodeRef>Gateway_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewDismissal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Confirm</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Dismissal" name="Dismissal Initiated">
      <bpmn:outgoing>SequenceFlow_Send</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task MSPN -->
    <bpmn:task id="Task_SendDismissal" name="Send dismissal to MSPO">
      <bpmn:incoming>SequenceFlow_Send</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReviewHandover</bpmn:outgoing>
    </bpmn:task>

    <!-- Task MSPO -->
    <bpmn:task id="Task_ReviewDismissal" name="Reviews the dismissal">
      <bpmn:incoming>SequenceFlow_ReviewHandover</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DecisionPoint</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway -->
    <bpmn:exclusiveGateway id="Gateway_Decision" name="Decision">
      <bpmn:incoming>SequenceFlow_DecisionPoint</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RejectPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ConfirmPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_Reject" name="Dismissal Rejected">
      <bpmn:incoming>SequenceFlow_RejectPath</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_Confirm" name="Dismissal Confirmed">
      <bpmn:incoming>SequenceFlow_ConfirmPath</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_Send" sourceRef="StartEvent_Dismissal" targetRef="Task_SendDismissal"/>
    <bpmn:sequenceFlow id="SequenceFlow_ReviewHandover" name="To MSPO" sourceRef="Task_SendDismissal" targetRef="Task_ReviewDismissal"/>
    <bpmn:sequenceFlow id="SequenceFlow_DecisionPoint" sourceRef="Task_ReviewDismissal" targetRef="Gateway_Decision"/>
    <bpmn:sequenceFlow id="SequenceFlow_RejectPath" name="Reject" sourceRef="Gateway_Decision" targetRef="EndEvent_Reject"/>
    <bpmn:sequenceFlow id="SequenceFlow_ConfirmPath" name="Confirm" sourceRef="Gateway_Decision" targetRef="EndEvent_Confirm"/>

  </bpmn:process>
</bpmn:definitions>