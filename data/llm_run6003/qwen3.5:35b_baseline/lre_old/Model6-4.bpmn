<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Sales Process" processRef="Process_1" />
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_MarketingLeadGen" name="Marketing &amp; Lead Generation">
        <bpmn:flowNodeRef>StartEvent_Search</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Methods</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Merge_Gateway_Methods</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_BuyDetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_Exhibition</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_NetworkReferral</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_CallCenter" name="Call Center">
        <bpmn:flowNodeRef>UserTask_ContactCustomer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_IsInterested</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_DevelopmentHead" name="Development Head">
        <bpmn:flowNodeRef>UserTask_DevAcquisition</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_SalesTeam" name="Sales Team &amp; Pre-Sales">
        <bpmn:flowNodeRef>Gateway_PresenterType</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_StandardPresentation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_TechnicalPresentation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Merge_Gateway_Presentation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_WaitResponse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BoundaryEvent_2Weeks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_FollowUpCall</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Merge_Gateway_Waiting</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Search" name="Search for Potential Customers">
      <bpmn:outgoing>SequenceFlow_Methods</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Gateway to select contact method (Exclusive) -->
    <bpmn:exclusiveGateway id="Gateway_Methods" name="Contact Method?">
      <bpmn:incoming>SequenceFlow_Methods</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BuyDetails</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_Exhibition</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NetworkReferral</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Contact Detail Tasks -->
    <bpmn:userTask id="UserTask_BuyDetails" name="Buy Details for Cold Calls">
      <bpmn:incoming>SequenceFlow_BuyDetails</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeMethods1</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="UserTask_Exhibition" name="Participate in Exhibitions">
      <bpmn:incoming>SequenceFlow_Exhibition</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeMethods2</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="UserTask_NetworkReferral" name="Personal Network Referrals">
      <bpmn:incoming>SequenceFlow_NetworkReferral</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeMethods3</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Merge Gateway for Contact Methods -->
    <bpmn:inclusiveGateway id="Merge_Gateway_Methods" name="Contact Details Found">
      <bpmn:incoming>SequenceFlow_MergeMethods1</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_MergeMethods2</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_MergeMethods3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CallCenterStart</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Call Center Task -->
    <bpmn:userTask id="UserTask_ContactCustomer" name="Call Customer &amp; Determine Interest/Budget">
      <bpmn:incoming>SequenceFlow_CallCenterStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckInterest</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Decision Gateway 1: Interested? -->
    <bpmn:exclusiveGateway id="Gateway_IsInterested" name="Customer Generally Interested?">
      <bpmn:incoming>SequenceFlow_CheckInterest</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_YesProceed</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoCheckBudget</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Decision Gateway 2: Budget Huge? -->
    <bpmn:exclusiveGateway id="Gateway_BudgetHuge" name="Project Budget Huge?">
      <bpmn:incoming>SequenceFlow_NoCheckBudget</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DevHeadAcquire</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_LostLead</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Dev Head Task -->
    <bpmn:userTask id="UserTask_DevAcquisition" name="Head of Development Acquires Customer">
      <bpmn:incoming>SequenceFlow_DevHeadAcquire</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeToPresentation</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event for Lost Lead -->
    <bpmn:endEvent id="EndEvent_LostLead" name="Leave Alone">
      <bpmn:incoming>SequenceFlow_LostLead</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Decision Gateway 3: Presenter Type? -->
    <bpmn:exclusiveGateway id="Gateway_PresenterType" name="Presentation Type?">
      <bpmn:incoming>SequenceFlow_MergeToPresentation</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StandardPres</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_TechPres</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Presentation Tasks -->
    <bpmn:userTask id="UserTask_StandardPresentation" name="Detailed Online Presentation (Sales Rep)">
      <bpmn:incoming>SequenceFlow_StandardPres</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergePresentations1</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="UserTask_TechnicalPresentation" name="Detailed Online Presentation (Pre-Sales)">
      <bpmn:incoming>SequenceFlow_TechPres</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergePresentations2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Merge Gateway for Presentation -->
    <bpmn:inclusiveGateway id="Merge_Gateway_Presentation" name="Presentation Done">
      <bpmn:incoming>SequenceFlow_MergePresentations1</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_MergePresentations2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitStart</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Wait Task -->
    <bpmn:userTask id="UserTask_WaitResponse" name="Wait for Customer Contact">
      <bpmn:incoming>SequenceFlow_WaitStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeWaitingNormal</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Boundary Timer Event (Interrupting) -->
    <bpmn:boundaryEvent id="BoundaryEvent_2Weeks" name="Timeout 2 Weeks">
      <bpmn:attachedToRef>UserTask_WaitResponse</bpmn:attachedToRef>
      <bpmn:cancelActivity>true</bpmn:cancelActivity>
      <bpmn:timerEventDefinition id="TimerDef_1" />
    </bpmn:boundaryEvent>

    <!-- Follow-up Call Task -->
    <bpmn:userTask id="UserTask_FollowUpCall" name="Sales Rep Calls Customer">
      <bpmn:incoming>SequenceFlow_TimerTrigger</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeWaitingFollowup</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Merge Gateway for Waiting Phase -->
    <bpmn:inclusiveGateway id="Merge_Gateway_Waiting" name="Contact or Follow-up">
      <bpmn:incoming>SequenceFlow_MergeWaitingNormal</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_MergeWaitingFollowup</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_QuotationStart</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Quotation Task -->
    <bpmn:userTask id="UserTask_CreateQuotation" name="Create Quotation">
      <bpmn:incoming>SequenceFlow_QuotationStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FinalEnd</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Done" name="Process Completed">
      <bpmn:incoming>SequenceFlow_FinalEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_Methods" sourceRef="StartEvent_Search" targetRef="Gateway_Methods" />
    <bpmn:sequenceFlow id="SequenceFlow_BuyDetails" name="Buy Details" sourceRef="Gateway_Methods" targetRef="UserTask_BuyDetails" />
    <bpmn:sequenceFlow id="SequenceFlow_Exhibition" name="Exhibitions" sourceRef="Gateway_Methods" targetRef="UserTask_Exhibition" />
    <bpmn:sequenceFlow id="SequenceFlow_NetworkReferral" name="Network Referrals" sourceRef="Gateway_Methods" targetRef="UserTask_NetworkReferral" />

    <bpmn:sequenceFlow id="SequenceFlow_MergeMethods1" sourceRef="UserTask_BuyDetails" targetRef="Merge_Gateway_Methods" />
    <bpmn:sequenceFlow id="SequenceFlow_MergeMethods2" sourceRef="UserTask_Exhibition" targetRef="Merge_Gateway_Methods" />
    <bpmn:sequenceFlow id="SequenceFlow_MergeMethods3" sourceRef="UserTask_NetworkReferral" targetRef="Merge_Gateway_Methods" />

    <bpmn:sequenceFlow id="SequenceFlow_CallCenterStart" name="Contact Details Found" sourceRef="Merge_Gateway_Methods" targetRef="UserTask_ContactCustomer" />
    <bpmn:sequenceFlow id="SequenceFlow_CheckInterest" sourceRef="UserTask_ContactCustomer" targetRef="Gateway_IsInterested" />

    <bpmn:sequenceFlow id="SequenceFlow_YesProceed" name="Yes - Interested" sourceRef="Gateway_IsInterested" targetRef="Merge_Gateway_Presentation" />
    <bpmn:sequenceFlow id="SequenceFlow_NoCheckBudget" name="No - Check Budget" sourceRef="Gateway_IsInterested" targetRef="Gateway_BudgetHuge" />

    <bpmn:sequenceFlow id="SequenceFlow_DevHeadAcquire" name="Yes - Huge Budget" sourceRef="Gateway_BudgetHuge" targetRef="UserTask_DevAcquisition" />
    <bpmn:sequenceFlow id="SequenceFlow_MergeToPresentation" sourceRef="UserTask_DevAcquisition" targetRef="Merge_Gateway_Presentation" />

    <bpmn:sequenceFlow id="SequenceFlow_LostLead" name="No - Small Budget" sourceRef="Gateway_BudgetHuge" targetRef="EndEvent_LostLead" />

    <bpmn:sequenceFlow id="SequenceFlow_StandardPres" name="General Presentation" sourceRef="Gateway_PresenterType" targetRef="UserTask_StandardPresentation" />
    <bpmn:sequenceFlow id="SequenceFlow_TechPres" name="Technical Presentation" sourceRef="Gateway_PresenterType" targetRef="UserTask_TechnicalPresentation" />

    <bpmn:sequenceFlow id="SequenceFlow_MergePresentations1" sourceRef="UserTask_StandardPresentation" targetRef="Merge_Gateway_Presentation" />
    <bpmn:sequenceFlow id="SequenceFlow_MergePresentations2" name="" sourceRef="UserTask_TechnicalPresentation" targetRef="Merge_Gateway_Presentation" />

    <bpmn:sequenceFlow id="SequenceFlow_WaitStart" sourceRef="Merge_Gateway_Presentation" targetRef="UserTask_WaitResponse" />
    
    <!-- Timer Boundary Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_TimerTrigger" name="2 Weeks Timeout" sourceRef="BoundaryEvent_2Weeks" targetRef="UserTask_FollowUpCall" />

    <bpmn:sequenceFlow id="SequenceFlow_MergeWaitingNormal" sourceRef="UserTask_WaitResponse" targetRef="Merge_Gateway_Waiting" />
    
    <!-- Follow-up Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_MergeWaitingFollowup" name="" sourceRef="UserTask_FollowUpCall" targetRef="Merge_Gateway_Waiting" />

    <bpmn:sequenceFlow id="SequenceFlow_QuotationStart" sourceRef="Merge_Gateway_Waiting" targetRef="UserTask_CreateQuotation" />
    
    <bpmn:sequenceFlow id="SequenceFlow_FinalEnd" name="" sourceRef="UserTask_CreateQuotation" targetRef="EndEvent_Done" />

  </bpmn:process>
</bpmn:definitions>