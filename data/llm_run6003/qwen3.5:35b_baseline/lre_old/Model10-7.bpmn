<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_GO_Process">
    <bpmn:participant id="Participant_GO" name="Government Office (GO)" processRef="Process_GOProcess" />
  </bpmn:collaboration>
  <bpmn:process id="Process_GOProcess" isExecutable="false">

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_MSPNRegistration" name="MSPN registers measurement at GO">
      <bpmn:outgoing>SequenceFlow_ExamineApplication</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1 -->
    <bpmn:task id="Task_ExamineApplication" name="Examine application of the MSPN">
      <bpmn:incoming>SequenceFlow_ExamineApplication</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DecisionPoint</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway -->
    <bpmn:exclusiveGateway id="Gateway_RejectConfirm" name="Reject or Confirm?">
      <bpmn:incoming>SequenceFlow_DecisionPoint</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RejectPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ConfirmPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event 1 (Rejected) -->
    <bpmn:endEvent id="EndEvent_Rejected" name="Application Rejected">
      <bpmn:incoming>SequenceFlow_RejectPath</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task Assign MSPN -->
    <bpmn:task id="Task_AssignMSPN" name="Assign the MSPN">
      <bpmn:incoming>SequenceFlow_ConfirmPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InformMSPO</bpmn:outgoing>
    </bpmn:task>

    <!-- Task Inform MSPO -->
    <bpmn:task id="Task_InformMSPO" name="Inform the MSPO about assignment">
      <bpmn:incoming>SequenceFlow_InformMSPO</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InformMPO</bpmn:outgoing>
    </bpmn:task>

    <!-- Task Inform MPO -->
    <bpmn:task id="Task_InformMPO" name="Inform the MPO about assignment">
      <bpmn:incoming>SequenceFlow_InformMPO</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InformSP</bpmn:outgoing>
    </bpmn:task>

    <!-- Task Inform SP -->
    <bpmn:task id="Task_InformSP" name="Inform the SP about assignment">
      <bpmn:incoming>SequenceFlow_InformSP</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Completed</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 2 (Completed) -->
    <bpmn:endEvent id="EndEvent_Completed" name="Assignment Completed">
      <bpmn:incoming>SequenceFlow_Completed</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_ExamineApplication" sourceRef="StartEvent_MSPNRegistration" targetRef="Task_ExamineApplication">
      <bpmn:name />
    </bpmn:sequenceFlow>
    
    <bpmn:sequenceFlow id="SequenceFlow_DecisionPoint" name="Examination Complete" sourceRef="Task_ExamineApplication" targetRef="Gateway_RejectConfirm" />

    <!-- Gateway Outgoing Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_RejectPath" name="Reject Application" sourceRef="Gateway_RejectConfirm" targetRef="EndEvent_Rejected">
      <bpmn:name>Reject</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ConfirmPath" name="Confirm Application" sourceRef="Gateway_RejectConfirm" targetRef="Task_AssignMSPN">
      <bpmn:name>Confirm</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Notification Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_InformMSPO" sourceRef="Task_AssignMSPN" targetRef="Task_InformMSPO">
      <bpmn:name />
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_InformMPO" sourceRef="Task_InformMSPO" targetRef="Task_InformMPO">
       <bpmn:name />
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_InformSP" sourceRef="Task_InformMPO" targetRef="Task_InformSP">
      <bpmn:name />
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_Completed" sourceRef="Task_InformSP" targetRef="EndEvent_Completed">
       <bpmn:name />
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>