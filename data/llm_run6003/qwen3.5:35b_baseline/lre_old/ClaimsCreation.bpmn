<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_ClaimsProcess" name="Claims Processing Process" processRef="Process_1" />
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_ClaimsHandler">
        <bpmn:flowNodeRef>Task_SearchPoliceReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CalculateEstimate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateActionPlan</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_ClaimsManager">
        <bpmn:flowNodeRef>Task_NegotiateSettlement</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Administration">
        <bpmn:flowNodeRef>StartEvent_ClaimReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformClaimant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ProcessEnded</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_ClaimReceived" name="Claim Received">
      <bpmn:outgoing>SequenceFlow_SearchReport</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Search Police Report and Create File -->
    <bpmn:task id="Task_SearchPoliceReport" name="Search Police Report &amp; Prepare File">
      <bpmn:incoming>SequenceFlow_SearchReport</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CalculateEstimate</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: Calculate Initial Claim Estimate -->
    <bpmn:task id="Task_CalculateEstimate" name="Calculate Initial Claim Estimate">
      <bpmn:incoming>SequenceFlow_CalculateEstimate</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CreateActionPlan</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3: Create Action Plan -->
    <bpmn:task id="Task_CreateActionPlan" name="Create Action Plan">
      <bpmn:incoming>SequenceFlow_CreateActionPlan</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NegotiateSettlement</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 4: Negotiate Settlement -->
    <bpmn:task id="Task_NegotiateSettlement" name="Negotiate Settlement">
      <bpmn:incoming>SequenceFlow_NegotiateSettlement</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InformClaimant</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 5: Inform Claimant -->
    <bpmn:task id="Task_InformClaimant" name="Inform Claimant of Outcome">
      <bpmn:incoming>SequenceFlow_InformClaimant</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndProcess</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_ProcessEnded" name="Process Ended">
      <bpmn:incoming>SequenceFlow_EndProcess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_SearchReport" sourceRef="StartEvent_ClaimReceived" targetRef="Task_SearchPoliceReport" />
    <bpmn:sequenceFlow id="SequenceFlow_CalculateEstimate" name="Initial Estimate Calculation" sourceRef="Task_SearchPoliceReport" targetRef="Task_CalculateEstimate" />
    <bpmn:sequenceFlow id="SequenceFlow_CreateActionPlan" name="Create Action Plan from Checklist" sourceRef="Task_CalculateEstimate" targetRef="Task_CreateActionPlan" />
    <bpmn:sequenceFlow id="SequenceFlow_NegotiateSettlement" name="Negotiation Based on Action Plan" sourceRef="Task_CreateActionPlan" targetRef="Task_NegotiateSettlement" />
    <bpmn:sequenceFlow id="SequenceFlow_InformClaimant" name="Inform Claimant of Outcome" sourceRef="Task_NegotiateSettlement" targetRef="Task_InformClaimant" />
    <bpmn:sequenceFlow id="SequenceFlow_EndProcess" sourceRef="Task_InformClaimant" targetRef="EndEvent_ProcessEnded" />

  </bpmn:process>
</bpmn:definitions>