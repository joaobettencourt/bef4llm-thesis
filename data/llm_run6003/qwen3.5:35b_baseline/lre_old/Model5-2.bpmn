<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_VacationsRequest">
    <bpmn:participant id="Participant_Organization" name="Organization Process" processRef="Process_Vacations" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Vacations" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Employee" name="Employee (Applicant)">
        <bpmn:flowNodeRef>StartEvent_SubmitRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegisterVacation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DecisionApproval</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Supervisor" name="Immediate Supervisor">
        <bpmn:flowNodeRef>Task_ReviewRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DecisionApproval</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_HR" name="Human Resources Representative">
        <bpmn:flowNodeRef>Task_CompleteProcedures</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_SubmitRequest" name="Vacation Request Submitted">
      <bpmn:outgoing>SequenceFlow_Register</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Register Requirement (Employee) -->
    <bpmn:task id="Task_RegisterVacation" name="Register Vacation Request">
      <bpmn:incoming>SequenceFlow_Register</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SupervisorReview</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: Supervisor Review (Supervisor) -->
    <bpmn:task id="Task_ReviewRequest" name="Review Vacation Request">
      <bpmn:incoming>SequenceFlow_SupervisorReview</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToDecisionGateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Approval Decision -->
    <bpmn:exclusiveGateway id="Gateway_DecisionApproval" name="Approved?">
      <bpmn:incoming>SequenceFlow_ToDecisionGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RejectedPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ApprovedPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_Register" sourceRef="StartEvent_SubmitRequest" targetRef="Task_RegisterVacation" />
    <bpmn:sequenceFlow id="SequenceFlow_SupervisorReview" name="Submit to Supervisor" sourceRef="Task_RegisterVacation" targetRef="Task_ReviewRequest" />
    <bpmn:sequenceFlow id="SequenceFlow_ToDecisionGateway" sourceRef="Task_ReviewRequest" targetRef="Gateway_DecisionApproval" />

    <!-- Path Rejected -->
    <bpmn:endEvent id="EndEvent_Rejected" name="Request Rejected">
      <bpmn:incoming>SequenceFlow_EndRejected</bpmn:incoming>
    </bpmn:endEvent>
    
    <bpmn:task id="Task_ReviewRejectionReasons" name="Review Rejection Reasons">
       <bpmn:incoming>SequenceFlow_RejectedPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndRejected</bpmn:outgoing>
    </bpmn:task>

    <!-- Path Approved -->
    <bpmn:endEvent id="EndEvent_Completed" name="Vacation Processed">
       <bpmn:incoming>SequenceFlow_EndApproved</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:task id="Task_CompleteProcedures" name="Complete Management Procedures">
      <bpmn:incoming>SequenceFlow_ApprovedPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndApproved</bpmn:outgoing>
    </bpmn:task>

    <!-- Rejection Path Flows -->
     <bpmn:sequenceFlow id="SequenceFlow_RejectedPath" name="Rejected" sourceRef="Gateway_DecisionApproval" targetRef="Task_ReviewRejectionReasons">
       <bpmn:name>Rejected</bpmn:name>
    </bpmn:sequenceFlow>

     <!-- Approved Path Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_ApprovedPath" sourceRef="Gateway_DecisionApproval" targetRef="Task_CompleteProcedures">
      <bpmn:name>Approved</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>