<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_IPOProcess">
    <bpmn:participant id="Participant_IPOProcess" name="IPO Process" processRef="Process_IPOProcess" />
  </bpmn:collaboration>
  <bpmn:process id="Process_IPOProcess" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_CompanyUnderwriters" name="Company &amp; Underwriters">
        <bpmn:flowNodeRef>StartEvent_DecisionIPO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectUnderwriters</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_FactsFairlyPresented</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelSplit_SecVsRoadshow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareRegistrationStatement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckBlueSkyLaws</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateEvent_WaitSECClearance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ArrangeRoadShow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelJoin_BeforePriceFix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FixIssuePrice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ReasonNotToProceed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_IPOCancelled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FirmCommitmentBuyStock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OfferToPublic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_IPOCompleted</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_DecisionIPO" name="Decision to Go Public">
      <bpmn:outgoing>SequenceFlow_SelectUnderwriters</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Select Underwriters -->
    <bpmn:task id="Task_SelectUnderwriters" name="Select the underwriters">
      <bpmn:incoming>SequenceFlow_SelectUnderwriters</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FactsCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Facts Fairly Presented? -->
    <bpmn:exclusiveGateway id="Gateway_FactsFairlyPresented" name="Facts presented fairly?">
      <bpmn:incoming>SequenceFlow_FactsCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProceedIPO</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Parallel Split -->
    <bpmn:parallelGateway id="ParallelSplit_SecVsRoadshow">
      <bpmn:incoming>SequenceFlow_ProceedIPO</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PrepareRegStmt</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ArrangeRoadShow</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Path A: SEC Registration -->
    <bpmn:task id="Task_PrepareRegistrationStatement" name="Prepare registration statement">
      <bpmn:incoming>SequenceFlow_PrepareRegStmt</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckBlueSkyLaws</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Check Blue Sky Laws -->
    <bpmn:task id="Task_CheckBlueSkyLaws" name="Check compliance with blue-sky laws">
      <bpmn:incoming>SequenceFlow_CheckBlueSkyLaws</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SubmitSEC</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Event: Wait for SEC Clearance -->
    <bpmn:startEvent id="StartEvent_SECResponse" name="Receive clearance from the SEC">
      <bpmn:incoming />
      <bpmn:outgoing>SequenceFlow_FixIssuePrice</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Submit to SEC -->
    <bpmn:task id="Task_SubmitSEC" name="Register issue with the SEC">
      <bpmn:incoming>SequenceFlow_SubmitSEC</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitClearanceTrigger</bpmn:outgoing>
    </bpmn:task>

    <!-- Path B: Road Show -->
    <bpmn:task id="Task_ArrangeRoadShow" name="Arrange road show to talk to investors">
      <bpmn:incoming>SequenceFlow_ArrangeRoadShow</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FirmUpPricePrelim</bpmn:outgoing>
    </bpmn:task>

    <!-- Join Gateway -->
    <bpmn:parallelGateway id="ParallelJoin_BeforePriceFix">
      <bpmn:incoming>SequenceFlow_WaitClearanceTrigger</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_FirmUpPricePrelim</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FixIssuePrice</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Fix Issue Price -->
    <bpmn:task id="Task_FixIssuePrice" name="Fix the issue price">
      <bpmn:incoming>SequenceFlow_FixIssuePrice</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReasonNotToProceed</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Reason Not to Proceed -->
    <bpmn:exclusiveGateway id="Gateway_ReasonNotToProceed" name="Any reason not to proceed?">
      <bpmn:incoming>SequenceFlow_ReasonNotToProceed</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CancelIPO</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ProceedWithOffer</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event: IPO Cancelled -->
    <bpmn:endEvent id="EndEvent_IPOCancelled" name="IPO Cancelled">
      <bpmn:incoming>SequenceFlow_CancelIPO</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task: Firm Commitment Buy Stock -->
    <bpmn:task id="Task_FirmCommitmentBuyStock" name="Enter firm commitment to buy stock">
      <bpmn:incoming>SequenceFlow_ProceedWithOffer</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OfferToPublic</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Offer to Public -->
    <bpmn:task id="Task_OfferToPublic" name="Offer stock to the public">
      <bpmn:incoming>SequenceFlow_OfferToPublic</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_IPOCompleted</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event: IPO Completed -->
    <bpmn:endEvent id="EndEvent_IPOCompleted" name="IPO Completed">
      <bpmn:incoming>SequenceFlow_IPOCompleted</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_SelectUnderwriters" sourceRef="StartEvent_DecisionIPO" targetRef="Task_SelectUnderwriters" />
    <bpmn:sequenceFlow id="SequenceFlow_FactsCheck" name="Yes - Fair Facts" sourceRef="Gateway_FactsFairlyPresented" targetRef="ParallelSplit_SecVsRoadshow" />
    <bpmn:sequenceFlow id="SequenceFlow_ProceedIPO" sourceRef="StartEvent_DecisionIPO" targetRef="Task_SelectUnderwriters" />
    <bpmn:sequenceFlow id="SequenceFlow_PrepareRegStmt" name="Prepare Registration Statement" sourceRef="ParallelSplit_SecVsRoadshow" targetRef="Task_PrepareRegistrationStatement" />
    <bpmn:sequenceFlow id="SequenceFlow_CheckBlueSkyLaws" sourceRef="Task_PrepareRegistrationStatement" targetRef="Task_CheckBlueSkyLaws" />
    <bpmn:sequenceFlow id="SequenceFlow_SubmitSEC" name="Submit to SEC Registration" sourceRef="Task_CheckBlueSkyLaws" targetRef="Task_SubmitSEC" />
    <bpmn:sequenceFlow id="SequenceFlow_WaitClearanceTrigger" sourceRef="Task_SubmitSEC" targetRef="StartEvent_SECResponse" />
    <bpmn:sequenceFlow id="SequenceFlow_ArrangeRoadShow" name="Arrange Road Show" sourceRef="ParallelSplit_SecVsRoadshow" targetRef="Task_ArrangeRoadShow" />
    <bpmn:sequenceFlow id="SequenceFlow_FirmUpPricePrelim" sourceRef="Task_ArrangeRoadShow" targetRef="ParallelJoin_BeforePriceFix" />
    <bpmn:sequenceFlow id="SequenceFlow_WaitClearanceTrigger2" name="SEC Clearance Received" sourceRef="StartEvent_SECResponse" targetRef="ParallelJoin_BeforePriceFix" />
    <bpmn:sequenceFlow id="SequenceFlow_FixIssuePrice" sourceRef="ParallelJoin_BeforePriceFix" targetRef="Task_FixIssuePrice" />
    <bpmn:sequenceFlow id="SequenceFlow_ReasonNotToProceed" name="Any reason not to proceed?" sourceRef="Task_FixIssuePrice" targetRef="Gateway_ReasonNotToProceed" />
    <bpmn:sequenceFlow id="SequenceFlow_CancelIPO" name="Yes - Cancel IPO" sourceRef="Gateway_ReasonNotToProceed" targetRef="EndEvent_IPOCancelled" />
    <bpmn:sequenceFlow id="SequenceFlow_ProceedWithOffer" name="No - Proceed with Offer" sourceRef="Gateway_ReasonNotToProceed" targetRef="Task_FirmCommitmentBuyStock" />
    <bpmn:sequenceFlow id="SequenceFlow_OfferToPublic" sourceRef="Task_FirmCommitmentBuyStock" targetRef="Task_OfferToPublic" />
    <bpmn:sequenceFlow id="SequenceFlow_IPOCompleted" name="IPO Completed" sourceRef="Task_OfferToPublic" targetRef="EndEvent_IPOCompleted" />

  </bpmn:process>
</bpmn:definitions>