<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_DesignProcess">
    <bpmn:participant id="Participant_DesignSystem" name="Design Process System" processRef="Process_DesignMain" />
    <bpmn:participant id="Participant_Manufacturing" name="Manufacturing Process" processRef="Process_Manufacturing" />
  </bpmn:collaboration>

  <bpmn:process id="Process_DesignMain" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Coordination" name="Design Coordination">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LocateDistribute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ParallelSplit</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Electrical" name="Electrical Design Department">
        <bpmn:flowNodeRef>InclusiveGateway_ReviewElec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewExistingElec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateUpdatePlanElec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreatedRevisedDesignElec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_TestResultElec</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Physical" name="Physical Design Department">
        <bpmn:flowNodeRef>InclusiveGateway_ReviewPhys</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewExistingPhys</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateUpdatePlanPhys</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreatedRevisedDesignPhys</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_TestResultPhys</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Final" name="Final Integration">
        <bpmn:flowNodeRef>InclusiveGateway_CombineDesigns</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CombinedTest</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_External" name="Manufacturing Interface">
        <bpmn:flowNodeRef>EndEvent_Complete</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Process Started">
      <bpmn:outgoing>SequenceFlow_LocateDistribute</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Locate and Distribute Designs Task -->
    <bpmn:task id="Task_LocateDistribute" name="Locate &amp; Distribute Existing Designs">
      <bpmn:incoming>SequenceFlow_LocateDistribute</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ParallelSplit</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway for Design Paths -->
    <bpmn:parallelGateway id="Gateway_ParallelSplit" name="Start Electrical &amp; Physical">
      <bpmn:incoming>SequenceFlow_ParallelSplit</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ElectricalPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PhysicalPath</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Electrical Design Path -->
    <bpmn:task id="Task_ReviewExistingElec" name="Review Existing Electrical Designs">
      <bpmn:incoming>SequenceFlow_ElectricalPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CreateUpdatePlanElec</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway for Review Decision -->
    <bpmn:exclusiveGateway id="InclusiveGateway_ReviewElec" name="Electrical Update Plan">
      <bpmn:incoming>SequenceFlow_CreateUpdatePlanElec</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CreatedRevisedDesignElec</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task Create Update Plan -->
    <bpmn:task id="Task_CreateUpdatePlanElec" name="Create Electrical Update Plan">
      <bpmn:incoming>SequenceFlow_ReviewExistingElec</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CreatedRevisedDesignElec</bpmn:outgoing>
    </bpmn:task>

    <!-- Task Create Revised Design -->
    <bpmn:task id="Task_CreatedRevisedDesignElec" name="Create Revised Electrical Design">
      <bpmn:incoming>SequenceFlow_CreateUpdatePlanElec</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TestResultElec</bpmn:outgoing>
    </bpmn:task>

    <!-- Test Result Gateway -->
    <bpmn:exclusiveGateway id="InclusiveGateway_TestResultElec" name="Electrical Design Passes?">
      <bpmn:incoming>SequenceFlow_CreatedRevisedDesignElec</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ElectricalComplete</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Physical Design Path -->
    <bpmn:task id="Task_ReviewExistingPhys" name="Review Existing Physical Designs">
      <bpmn:incoming>SequenceFlow_PhysicalPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CreateUpdatePlanPhys</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway for Review Decision -->
    <bpmn:exclusiveGateway id="InclusiveGateway_ReviewPhys" name="Physical Update Plan">
      <bpmn:incoming>SequenceFlow_CreateUpdatePlanPhys</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CreatedRevisedDesignPhys</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task Create Update Plan -->
    <bpmn:task id="Task_CreateUpdatePlanPhys" name="Create Physical Update Plan">
      <bpmn:incoming>SequenceFlow_ReviewExistingPhys</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CreatedRevisedDesignPhys</bpmn:outgoing>
    </bpmn:task>

    <!-- Task Create Revised Design -->
    <bpmn:task id="Task_CreatedRevisedDesignPhys" name="Create Revised Physical Design">
      <bpmn:incoming>SequenceFlow_CreateUpdatePlanPhys</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TestResultPhys</bpmn:outgoing>
    </bpmn:task>

    <!-- Test Result Gateway -->
    <bpmn:exclusiveGateway id="InclusiveGateway_TestResultPhys" name="Physical Design Passes?">
      <bpmn:incoming>SequenceFlow_CreatedRevisedDesignPhys</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PhysicalComplete</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Combined Design Task -->
    <bpmn:task id="Task_CombinedTest" name="Combine &amp; Test Designs">
      <bpmn:incoming>SequenceFlow_ElectricalComplete</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TestResultCombinedPass</bpmn:outgoing>
    </bpmn:task>

    <!-- Combined Test Gateway -->
    <bpmn:exclusiveGateway id="InclusiveGateway_CombineDesigns" name="Combined Design Passes?">
      <bpmn:incoming>SequenceFlow_TestResultElec</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendToManufacturing</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Complete" name="Designs Complete">
      <bpmn:incoming>SequenceFlow_SendToManufacturing</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows - Electrical Path Loop Back (Fail) -->
    <bpmn:sequenceFlow id="SequenceFlow_ElectricalPath" sourceRef="Gateway_ParallelSplit" targetRef="Task_ReviewExistingElec">
      <bpmn:name />
    </bpmn:sequenceFlow>

    <!-- Sequence Flows - Physical Path Loop Back (Fail) -->
    <bpmn:sequenceFlow id="SequenceFlow_PhysicalPath" sourceRef="Gateway_ParallelSplit" targetRef="Task_ReviewExistingPhys">
      <bpmn:name />
    </bpmn:sequenceFlow>

    <!-- Sequence Flows - Review to Plan (Electrical) -->
    <bpmn:sequenceFlow id="SequenceFlow_CreateUpdatePlanElec" sourceRef="InclusiveGateway_ReviewElec" targetRef="Task_CreatedRevisedDesignElec">
      <bpmn:name />
    </bpmn:sequenceFlow>

    <!-- Sequence Flows - Review to Plan (Physical) -->
    <bpmn:sequenceFlow id="SequenceFlow_CreateUpdatePlanPhys" sourceRef="InclusiveGateway_ReviewPhys" targetRef="Task_CreatedRevisedDesignPhys">
      <bpmn:name />
    </bpmn:sequenceFlow>

    <!-- Sequence Flows - Test Result (Electrical) -->
    <bpmn:sequenceFlow id="SequenceFlow_TestResultElec" sourceRef="InclusiveGateway_ReviewElec" targetRef="Task_CreatedRevisedDesignElec">
      <bpmn:name />
    </bpmn:sequenceFlow>

    <!-- Sequence Flows - Test Result (Physical) -->
    <bpmn:sequenceFlow id="SequenceFlow_TestResultPhys" sourceRef="InclusiveGateway_ReviewPhys" targetRef="Task_CreatedRevisedDesignPhys">
      <bpmn:name />
    </bpmn:sequenceFlow>

    <!-- Sequence Flows - Combined Test -->
    <bpmn:sequenceFlow id="SequenceFlow_TestResultCombinedPass" sourceRef="InclusiveGateway_CombineDesigns" targetRef="EndEvent_Complete">
      <bpmn:name />
    </bpmn:sequenceFlow>

    <!-- Sequence Flows - Send to Manufacturing -->
    <bpmn:sequenceFlow id="SequenceFlow_SendToManufacturing" sourceRef="InclusiveGateway_CombineDesigns" targetRef="EndEvent_Complete">
      <bpmn:messageRef>Message_DesignComplete</bpmn:messageRef>
    </bpmn:sequenceFlow>

  </bpmn:process>

  <!-- Message for Manufacturing Process -->
  <bpmn:message id="Message_DesignComplete" name="Design Complete Notification">
    <bpmn:name />
  </bpmn:message>

</bpmn:definitions>