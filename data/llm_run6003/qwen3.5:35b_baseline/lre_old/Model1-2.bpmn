<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                 xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" 
                 xmlns:di="http://www.omg.org/spec/DD/20100524/DI" 
                 xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" 
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
                 id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Computer Repair Service" processRef="Process_1" />
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    
    <!-- Lane Set -->
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_ServiceCenter" name="Service Center (CRS)">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckDefect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AcceptCosts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_SplitRepair</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RepairHardware</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_TestHW</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConfigureSoftware</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_TestSW</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_JoinRepair</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Finished</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Customer" name="Customer">
        <bpmn:flowNodeRef>Gateway_AcceptCosts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ReturnHome</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Receive Defective Computer">
      <bpmn:outgoing>SequenceFlow_CheckDefect</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Check Defect & Calculate Cost -->
    <bpmn:task id="Task_CheckDefect" name="Check Defect">
      <bpmn:incoming>SequenceFlow_CheckDefect</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DecisionCosts</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Customer Decision -->
    <bpmn:exclusiveGateway id="Gateway_AcceptCosts" name="Accept Costs?">
      <bpmn:incoming>SequenceFlow_DecisionCosts</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReturnHomeNo</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RepairYes</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event: Return Home -->
    <bpmn:endEvent id="EndEvent_ReturnHome" name="Return Unrepaired">
      <bpmn:incoming>SequenceFlow_ReturnHomeNo</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Parallel Split for Repair Activities -->
    <bpmn:parallelGateway id="ParallelGateway_SplitRepair">
      <bpmn:incoming>SequenceFlow_RepairYes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_HWPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SWPath</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- HW Path -->
    <bpmn:task id="Task_RepairHardware" name="Check and Repair Hardware">
      <bpmn:incoming>SequenceFlow_HWPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TestHW</bpmn:outgoing>
    </bpmn:task>

    <!-- HW Test Gateway -->
    <bpmn:exclusiveGateway id="Gateway_TestHW" name="Test Functionality (HW)?">
      <bpmn:incoming>SequenceFlow_TestHW</bpmn:incoming>
      <bpmn:outgoing>SequenceLoop_HW_Error</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_HW_OK</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- HW Loop Back -->
    <bpmn:sequenceFlow id="SequenceLoop_HW_Error" name="Error Detected">
      <bpmn:sourceRef>Gateway_TestHW</bpmn:sourceRef>
      <bpmn:targetRef>Task_RepairHardware</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- HW Continue -->
    <bpmn:sequenceFlow id="SequenceFlow_HW_OK" name="OK">
      <bpmn:sourceRef>Gateway_TestHW</bpmn:sourceRef>
      <bpmn:targetRef>ParallelGateway_JoinRepair</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- SW Path -->
    <bpmn:task id="Task_ConfigureSoftware" name="Check and Configure Software">
      <bpmn:incoming>SequenceFlow_SWPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TestSW</bpmn:outgoing>
    </bpmn:task>

    <!-- SW Test Gateway -->
    <bpmn:exclusiveGateway id="Gateway_TestSW" name="Test Functionality (SW)?">
      <bpmn:incoming>SequenceFlow_TestSW</bpmn:incoming>
      <bpmn:outgoing>SequenceLoop_SW_Error</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SW_OK</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- SW Loop Back -->
    <bpmn:sequenceFlow id="SequenceLoop_SW_Error" name="Error Detected">
      <bpmn:sourceRef>Gateway_TestSW</bpmn:sourceRef>
      <bpmn:targetRef>Task_ConfigureSoftware</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- SW Continue -->
    <bpmn:sequenceFlow id="SequenceFlow_SW_OK" name="OK">
      <bpmn:sourceRef>Gateway_TestSW</bpmn:sourceRef>
      <bpmn:targetRef>ParallelGateway_JoinRepair</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Parallel Join -->
    <bpmn:parallelGateway id="ParallelGateway_JoinRepair">
      <bpmn:incoming>SequenceFlow_HW_OK</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_SW_OK</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FinishProcess</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Finished" name="Repair Finished">
      <bpmn:incoming>SequenceFlow_FinishProcess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows for Decision and Split -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckDefect" sourceRef="StartEvent_1" targetRef="Task_CheckDefect">
      <bpmn:name />
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_DecisionCosts" name="Present Cost Calculation" sourceRef="Task_CheckDefect" targetRef="Gateway_AcceptCosts">
      <bpmn:name />
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ReturnHomeNo" name="Not Acceptable" sourceRef="Gateway_AcceptCosts" targetRef="EndEvent_ReturnHome">
      <bpmn:name />
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_RepairYes" name="Acceptable" sourceRef="Gateway_AcceptCosts" targetRef="ParallelGateway_SplitRepair">
      <bpmn:name />
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>