<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_FaultRepair">
    <bpmn:participant id="Participant_ServiceProvider" name="Service Provider/User" processRef="Process_FaultRepair" />
  </bpmn:collaboration>

  <bpmn:process id="Process_FaultRepair" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Technician" name="User/Technician">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExamineFailure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ConfirmFault</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyCustomerInitial</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyManagerInitial</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FixFault</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ShareResultsDetector</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyResolutionCustomer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyResolutionManager</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Completed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Fault Detected / Suspicion">
      <bpmn:outgoing>SequenceFlow_Examine</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Examine Failure -->
    <bpmn:task id="Task_ExamineFailure" name="Examine the failure">
      <bpmn:incoming>SequenceFlow_Examine</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConfirmDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Confirm Fault -->
    <bpmn:exclusiveGateway id="Gateway_ConfirmFault" name="Confirm Failure?">
      <bpmn:incoming>SequenceFlow_ConfirmDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RejectPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ConfirmPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event 1: Rejection -->
    <bpmn:endEvent id="EndEvent_Rejected" name="Investigation Ended">
      <bpmn:incoming>SequenceFlow_RejectPath</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task 2 & 3: Initial Notifications (Sequential for flow clarity) -->
    <bpmn:task id="Task_NotifyCustomerInitial" name="Inform Customer of Failure">
      <bpmn:incoming>SequenceFlow_ConfirmPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToManagerInitial</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_NotifyManagerInitial" name="Inform Manager of Failure">
      <bpmn:incoming>SequenceFlow_ToManagerInitial</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FixFaultStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 4: Fix Fault -->
    <bpmn:task id="Task_FixFault" name="Fix fault at measuring device">
      <bpmn:incoming>SequenceFlow_FixFaultStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ShareResults</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 5: Share Results with Detector -->
    <bpmn:task id="Task_ShareResultsDetector" name="Share results of repairs">
      <bpmn:incoming>SequenceFlow_ShareResults</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ResolutionStartCustomer</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 6 & 7: Resolution Notifications -->
    <bpmn:task id="Task_NotifyResolutionCustomer" name="Inform Customer of Resolution">
      <bpmn:incoming>SequenceFlow_ResolutionStartCustomer</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToManagerFinal</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 7 -->
    <bpmn:task id="Task_NotifyResolutionManager" name="Inform Manager of Resolution">
      <bpmn:incoming>SequenceFlow_ToManagerFinal</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FinalEnd</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 2: Completed -->
    <bpmn:endEvent id="EndEvent_Completed" name="Process Completed">
      <bpmn:incoming>SequenceFlow_FinalEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_Examine" sourceRef="StartEvent_1" targetRef="Task_ExamineFailure" />
    
    <bpmn:exclusiveGateway name="Reject?" id="ExclusiveGateway_Reject">
      <bpmn:incoming>SequenceFlow_ConfirmDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RejectPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Correcting Gateway Logic to match IDs above -->
    <bpmn:sequenceFlow id="SequenceFlow_ConfirmDecision" sourceRef="Task_ExamineFailure" targetRef="Gateway_ConfirmFault" />
    
    <bpmn:sequenceFlow id="SequenceFlow_RejectPath" name="Reject" sourceRef="Gateway_ConfirmFault" targetRef="EndEvent_Rejected" />
    
    <bpmn:sequenceFlow id="SequenceFlow_ConfirmPath" name="Confirm" sourceRef="Gateway_ConfirmFault" targetRef="Task_NotifyCustomerInitial" />
    
    <bpmn:sequenceFlow id="SequenceFlow_ToManagerInitial" sourceRef="Task_NotifyCustomerInitial" targetRef="Task_NotifyManagerInitial" />
    
    <bpmn:sequenceFlow id="SequenceFlow_FixFaultStart" sourceRef="Task_NotifyManagerInitial" targetRef="Task_FixFault" />
    
    <bpmn:sequenceFlow id="SequenceFlow_ShareResults" sourceRef="Task_FixFault" targetRef="Task_ShareResultsDetector" />
    
    <bpmn:sequenceFlow id="SequenceFlow_ResolutionStartCustomer" sourceRef="Task_ShareResultsDetector" targetRef="Task_NotifyResolutionCustomer" />
    
    <bpmn:sequenceFlow id="SequenceFlow_ToManagerFinal" sourceRef="Task_NotifyResolutionCustomer" targetRef="Task_NotifyResolutionManager" />
    
    <bpmn:sequenceFlow id="SequenceFlow_FinalEnd" sourceRef="Task_NotifyResolutionManager" targetRef="EndEvent_Completed" />

  </bpmn:process>
</bpmn:definitions>