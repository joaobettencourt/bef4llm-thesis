<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" 
             targetNamespace="http://example.com/bpmn">
  <process id="ClaimHandlingProcess" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>
    <task id="Task_1" name="Send Questionnaire to Claimant">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="IntermediateCatchEvent_1"/>
    <intermediateCatchEvent id="IntermediateCatchEvent_1">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
      <timerEventDefinition>
        <timeDuration>P5D</timeDuration>
      </timerEventDefinition>
    </intermediateCatchEvent>
    <sequenceFlow id="SequenceFlow_3" sourceRef="IntermediateCatchEvent_1" targetRef="Task_2"/>
    <task id="Task_2" name="Send Reminder to Claimant">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_4</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_4" sourceRef="Task_2" targetRef="IntermediateCatchEvent_2"/>
    <intermediateCatchEvent id="IntermediateCatchEvent_2">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_5</outgoing>
      <timerEventDefinition>
        <timeDuration>P5D</timeDuration>
      </timerEventDefinition>
    </intermediateCatchEvent>
    <sequenceFlow id="SequenceFlow_5" sourceRef="IntermediateCatchEvent_2" targetRef="Task_2"/>
    <sequenceFlow id="SequenceFlow_6" sourceRef="Task_1" targetRef="EndEvent_1">
      <!--<conditionExpression xsi:type="tFormalExpression">questionnaireReceived  = true</conditionExpression>-->
    </sequenceFlow>
    <endEvent id="EndEvent_1">
      <incoming>SequenceFlow_6</incoming>
    </endEvent>
  </process>
</definitions>