<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Repair Process" targetNamespace="http://example.com/repair-process">
   <process id="repairProcess" isExecutable="true">
     <startEvent id="start-event">
       <outgoing>sf1</outgoing>
     </startEvent>
     <sequenceFlow id="sf1" sourceRef="start-event" targetRef="task1"/>
     <task id="task1" name="Check Defect and Calculate Repair Costs">
       <incoming>sf1</incoming>
       <outgoing>sf2</outgoing>
     </task>
     <sequenceFlow id="sf2" sourceRef="task1" targetRef="exclusive-gateway1"/>
     <exclusiveGateway id="exclusive-gateway1">
       <incoming>sf2</incoming>
       <outgoing>sf3</outgoing>
       <outgoing>sf4</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="sf3" sourceRef="exclusive-gateway1" targetRef="parallel-gateway1">
       <conditionExpression xsi:type="tFormalExpression">costsAcceptable = true</conditionExpression>
     </sequenceFlow>
     <sequenceFlow id="sf4" sourceRef="exclusive-gateway1" targetRef="end-event1">
       <conditionExpression xsi:type="tFormalExpression">costsAcceptable = false</conditionExpression>
     </sequenceFlow>
     <endEvent id="end-event1">
       <incoming>sf4</incoming>
     </endEvent>
     <parallelGateway id="parallel-gateway1">
       <incoming>sf3</incoming>
       <outgoing>sf5</outgoing>
       <outgoing>sf6</outgoing>
     </parallelGateway>
     <sequenceFlow id="sf5" sourceRef="parallel-gateway1" targetRef="task2"/>
     <task id="task2" name="Check and Repair Hardware">
       <incoming>sf5</incoming>
       <outgoing>sf7</outgoing>
     </task>
     <sequenceFlow id="sf7" sourceRef="task2" targetRef="exclusive-gateway2"/>
     <exclusiveGateway id="exclusive-gateway2">
       <incoming>sf7</incoming>
       <outgoing>sf8</outgoing>
       <outgoing>sf9</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="sf8" sourceRef="exclusive-gateway2" targetRef="task4">
       <conditionExpression xsi:type="tFormalExpression">hardwareFunctional = false</conditionExpression>
     </sequenceFlow>
     <task id="task4" name="Repair Hardware">
       <incoming>sf8</incoming>
       <!-- Assume this task has outgoing sequence flow to ExclusiveGateway2 -->
       <outgoing>sf10</outgoing>
     </task>
     <sequenceFlow id="sf9" sourceRef="exclusive-gateway2" targetRef="parallel-gateway2">
       <conditionExpression xsi:type="tFormalExpression">hardwareFunctional = true</conditionExpression>
     </sequenceFlow>
     <sequenceFlow id="sf6" sourceRef="parallel-gateway1" targetRef="task3"/>
     <task id="task3" name="Check and Configure Software">
       <incoming>sf6</incoming>
       <outgoing>sf11</outgoing>
     </task>
     <sequenceFlow id="sf11" sourceRef="task3" targetRef="exclusive-gateway3"/>
     <exclusiveGateway id="exclusive-gateway3">
       <incoming>sf11</incoming>
       <outgoing>sf12</outgoing>
       <outgoing>sf13</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="sf12" sourceRef="exclusive-gateway3" targetRef="task5">
       <conditionExpression xsi:type="tFormalExpression">softwareFunctional = false</conditionExpression>
     </sequenceFlow>
     <task id="task5" name="Repair Software">
       <incoming>sf12</incoming>
       <!-- Assume this task has outgoing sequence flow to ExclusiveGateway3 -->
       <outgoing>sf14</outgoing>
     </task>
     <sequenceFlow id="sf13" sourceRef="exclusive-gateway3" targetRef="parallel-gateway2">
       <conditionExpression xsi:type="tFormalExpression">softwareFunctional = true</conditionExpression>
     </sequenceFlow>
     <sequenceFlow id="sf10" sourceRef="task4" targetRef="exclusive-gateway2"/>
     <sequenceFlow id="sf14" sourceRef="task5" targetRef="exclusive-gateway3"/>
     <parallelGateway id="parallel-gateway2">
       <incoming>sf9</incoming>
       <incoming>sf13</incoming>
       <outgoing>sf15</outgoing>
     </parallelGateway>
     <sequenceFlow id="sf15" sourceRef="parallel-gateway2" targetRef="end-event2"/>
     <endEvent id="end-event2">
       <incoming>sf15</incoming>
     </endEvent>
   </process>
 </definitions>