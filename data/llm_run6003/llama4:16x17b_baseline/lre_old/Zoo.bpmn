<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="ZooClub Membership Process" targetNamespace="http://example.com/ZooClubMembershipProcess">
   <process id="ZooClubMembershipProcess" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>
     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="ExclusiveGateway_1"/>
     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
       <outgoing>SequenceFlow_3</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_2" sourceRef="ExclusiveGateway_1" targetRef="Task_1">
       <conditionExpression xsi:type="tFormalExpression">membershipType  =  'individual'</conditionExpression>
     </sequenceFlow>
     <task id="Task_1" name="Prepare Personal Information">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_4</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_4" sourceRef="Task_1" targetRef="Task_SubmitInfo"/>
     <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_1" targetRef="Task_2">
       <conditionExpression xsi:type="tFormalExpression">membershipType  =  'family'</conditionExpression>
     </sequenceFlow>
     <task id="Task_2" name="Prepare Family Information">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_2" targetRef="Task_SubmitInfo"/>
     <task id="Task_SubmitInfo" name="Submit Information to ZooClub Department">
       <incoming>SequenceFlow_4</incoming>
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_SubmitInfo" targetRef="ZooClubDepartment_Task"/>
     <serviceTask id="ZooClubDepartment_Task" name="Introduce Personal Data and Request Payment">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_7</outgoing>
       <outgoing>SequenceFlow_8</outgoing>
     </serviceTask>
     <sequenceFlow id="SequenceFlow_7" sourceRef="ZooClubDepartment_Task" targetRef="BillingDepartment_Task"/>
     <serviceTask id="BillingDepartment_Task" name="Send Payment Request to Bank">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </serviceTask>
     <sequenceFlow id="SequenceFlow_9" sourceRef="BillingDepartment_Task" targetRef="Bank_Task"/>
     <serviceTask id="Bank_Task" name="Process Payment">
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_10</outgoing>
     </serviceTask>
     <sequenceFlow id="SequenceFlow_10" sourceRef="Bank_Task" targetRef="ZooClubDepartment_PaymentConfirmation_Task"/>
     <task id="ZooClubDepartment_PaymentConfirmation_Task" name="Print and Deliver Card">
       <incoming>SequenceFlow_10</incoming>
       <outgoing>SequenceFlow_11</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_11" sourceRef="ZooClubDepartment_PaymentConfirmation_Task" targetRef="EndEvent_1"/>
     <sequenceFlow id="SequenceFlow_8" sourceRef="ZooClubDepartment_Task" targetRef="MarketingDepartment_Task"/>
     <serviceTask id="MarketingDepartment_Task" name="Request Magazine Mailing">
       <incoming>SequenceFlow_8</incoming>
     </serviceTask>
     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_11</incoming>
     </endEvent>
   </process>
 </definitions>