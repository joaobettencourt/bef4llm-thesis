<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Office Supply Request Process" targetNamespace="http://example.com/bpmn">
   <process id="officeSupplyRequestProcess" isExecutable="true">
     <startEvent id="start-event-1">
       <outgoing>sequence-flow-1</outgoing>
     </startEvent>
     <sequenceFlow id="sequence-flow-1" sourceRef="start-event-1" targetRef="task-1"/>
     <task id="task-1" name="Submit Office Supply Request">
       <incoming>sequence-flow-1</incoming>
       <outgoing>sequence-flow-2</outgoing>
     </task>
     <sequenceFlow id="sequence-flow-2" sourceRef="task-1" targetRef="exclusive-gateway-1"/>
     <exclusiveGateway id="exclusive-gateway-1">
       <incoming>sequence-flow-2</incoming>
       <outgoing>sequence-flow-3</outgoing>
       <outgoing>sequence-flow-4</outgoing>
       <outgoing>sequence-flow-5</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="sequence-flow-3" sourceRef="exclusive-gateway-1" targetRef="task-2">
       <conditionExpression xsi:type="tFormalExpression">approvalStatus  =  'approved'</conditionExpression>
     </sequenceFlow>
     <task id="task-2" name="Approve Request">
       <incoming>sequence-flow-3</incoming>
       <outgoing>sequence-flow-6</outgoing>
     </task>
     <sequenceFlow id="sequence-flow-6" sourceRef="task-2" targetRef="sub-process-1"/>
     <subProcess id="sub-process-1" name="Make Quotation and Select Vendor">
       <incoming>sequence-flow-6</incoming>
       <outgoing>sequence-flow-7</outgoing>
       <startEvent id="start-event-sub-process-1">
         <outgoing>sequence-flow-sub-process-1-1</outgoing>
       </startEvent>
       <sequenceFlow id="sequence-flow-sub-process-1-1" sourceRef="start-event-sub-process-1" targetRef="task-sub-process-1-1"/>
       <task id="task-sub-process-1-1" name="Make Quotation">
         <incoming>sequence-flow-sub-process-1-1</incoming>
         <outgoing>sequence-flow-sub-process-1-2</outgoing>
       </task>
       <sequenceFlow id="sequence-flow-sub-process-1-2" sourceRef="task-sub-process-1-1" targetRef="exclusive-gateway-sub-process-1"/>
       <exclusiveGateway id="exclusive-gateway-sub-process-1">
         <incoming>sequence-flow-sub-process-1-2</incoming>
         <outgoing>sequence-flow-sub-process-1-3</outgoing>
         <outgoing>sequence-flow-sub-process-1-4</outgoing>
       </exclusiveGateway>
       <sequenceFlow id="sequence-flow-sub-process-1-3" sourceRef="exclusive-gateway-sub-process-1" targetRef="task-sub-process-1-2">
         <conditionExpression xsi:type="tFormalExpression">vendorStatus  =  'valid'</conditionExpression>
       </sequenceFlow>
       <task id="task-sub-process-1-2" name="Select Vendor">
         <incoming>sequence-flow-sub-process-1-3</incoming>
         <outgoing>sequence-flow-sub-process-1-5</outgoing>
       </task>
       <sequenceFlow id="sequence-flow-sub-process-1-5" sourceRef="task-sub-process-1-2" targetRef="end-event-sub-process-1"/>
       <endEvent id="end-event-sub-process-1">
         <incoming>sequence-flow-sub-process-1-5</incoming>
       </endEvent>
       <sequenceFlow id="sequence-flow-sub-process-1-4" sourceRef="exclusive-gateway-sub-process-1" targetRef="task-sub-process-1-3">
         <conditionExpression xsi:type="tFormalExpression">vendorStatus  =  'invalid'</conditionExpression>
       </sequenceFlow>
       <task id="task-sub-process-1-3" name="Choose Different Vendor">
         <incoming>sequence-flow-sub-process-1-4</incoming>
         <outgoing>sequence-flow-sub-process-1-6</outgoing>
       </task>
       <sequenceFlow id="sequence-flow-sub-process-1-6" sourceRef="task-sub-process-1-3" targetRef="task-sub-process-1-2"/>
     </subProcess>
     <sequenceFlow id="sequence-flow-7" sourceRef="sub-process-1" targetRef="task-3"/>
     <task id="task-3" name="Generate and Send Purchase Order">
       <incoming>sequence-flow-7</incoming>
       <outgoing>sequence-flow-8</outgoing>
     </task>
     <sequenceFlow id="sequence-flow-8" sourceRef="task-3" targetRef="end-event-1"/>
     <endEvent id="end-event-1">
       <incoming>sequence-flow-8</incoming>
     </endEvent>
     <sequenceFlow id="sequence-flow-4" sourceRef="exclusive-gateway-1" targetRef="task-4">
       <conditionExpression xsi:type="tFormalExpression">approvalStatus  =  'rejected'</conditionExpression>
     </sequenceFlow>
     <task id="task-4" name="Reject Request">
       <incoming>sequence-flow-4</incoming>
       <outgoing>sequence-flow-9</outgoing>
     </task>
     <sequenceFlow id="sequence-flow-9" sourceRef="task-4" targetRef="end-event-2"/>
     <endEvent id="end-event-2">
       <incoming>sequence-flow-9</incoming>
     </endEvent>
     <sequenceFlow id="sequence-flow-5" sourceRef="exclusive-gateway-1" targetRef="task-5">
       <conditionExpression xsi:type="tFormalExpression">approvalStatus  =  'changeRequired'</conditionExpression>
     </sequenceFlow>
     <task id="task-5" name="Request Changes">
       <incoming>sequence-flow-5</incoming>
       <outgoing>sequence-flow-10</outgoing>
     </task>
     <sequenceFlow id="sequence-flow-10" sourceRef="task-5" targetRef="task-1"/>
   </process>
 </definitions>