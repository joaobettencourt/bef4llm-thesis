<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Going Public Process" targetNamespace="http://example.com/bpmn">
   <process id="GoingPublicProcess" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>
     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>
     <task id="Task_1" name="Select Underwriters">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="Task_2"/>
     <task id="Task_2" name="Prepare Registration Statement">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_3" sourceRef="Task_2" targetRef="ParallelGateway_1"/>
     <parallelGateway id="ParallelGateway_1">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_4</outgoing>
       <outgoing>SequenceFlow_5</outgoing>
     </parallelGateway>
     <sequenceFlow id="SequenceFlow_4" sourceRef="ParallelGateway_1" targetRef="Task_3"/>
     <task id="Task_3" name="SEC Registration and Compliance">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_5" sourceRef="ParallelGateway_1" targetRef="Task_4"/>
     <task id="Task_4" name="Firm Up Issue Price and Road Show">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_7</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_3" targetRef="ExclusiveGateway_1"/>
     <sequenceFlow id="SequenceFlow_7" sourceRef="Task_4" targetRef="ExclusiveGateway_1"/>
     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_6</incoming>
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_8</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_8" sourceRef="ExclusiveGateway_1" targetRef="Task_5"/>
     <task id="Task_5" name="Fix Issue Price and Enter into Firm Commitment">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_5" targetRef="EndEvent_1"/>
     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_9</incoming>
     </endEvent>
   </process>
 </definitions>