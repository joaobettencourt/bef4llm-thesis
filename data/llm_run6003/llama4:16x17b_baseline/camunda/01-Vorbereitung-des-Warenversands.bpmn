<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" name="Send Goods Process">

  <process id="sendGoodsProcess" isExecutable="true">
    <startEvent id="startEvent1">
      <outgoing>sequenceFlow1</outgoing>
    </startEvent>

    <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="exclusiveGateway1"/>

    <exclusiveGateway id="exclusiveGateway1">
      <incoming>sequenceFlow1</incoming>
      <outgoing>sequenceFlow2</outgoing>
      <outgoing>sequenceFlow3</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequenceFlow2" name="large quantity" sourceRef="exclusiveGateway1" targetRef="taskGetOffers">
      <!--<conditionExpression xsi:type="tFormalExpression">${quantity  > 100}</conditionExpression>-->
    </sequenceFlow>

    <sequenceFlow id="sequenceFlow3" name="small quantity" sourceRef="exclusiveGateway1" targetRef="parallelGateway1">
      <!--<conditionExpression xsi:type="tFormalExpression">${quantity  <= 100}</conditionExpression>-->
    </sequenceFlow>

    <task id="taskGetOffers" name="Get offers from logistic companies">
      <incoming>sequenceFlow2</incoming>
      <outgoing>sequenceFlow4</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow4" sourceRef="taskGetOffers" targetRef="exclusiveGatewaySelectOffer"/>

    <exclusiveGateway id="exclusiveGatewaySelectOffer">
      <incoming>sequenceFlow4</incoming>
      <outgoing>sequenceFlow5</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequenceFlow5" sourceRef="exclusiveGatewaySelectOffer" targetRef="parallelGateway1"/>

    <parallelGateway id="parallelGateway1">
      <incoming>sequenceFlow3</incoming>
      <incoming>sequenceFlow5</incoming>
      <outgoing>sequenceFlow6</outgoing>
      <outgoing>sequenceFlow7</outgoing>
    </parallelGateway>

    <task id="taskPackGoods" name="Pack goods">
      <incoming>sequenceFlow7</incoming>
      <outgoing>sequenceFlow8</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow7" sourceRef="parallelGateway1" targetRef="taskPackGoods"/>

    <sequenceFlow id="sequenceFlow6" sourceRef="parallelGateway1" targetRef="inclusiveGatewayInsurance"/>

    <inclusiveGateway id="inclusiveGatewayInsurance">
      <incoming>sequenceFlow6</incoming>
      <outgoing>sequenceFlow9</outgoing>
    </inclusiveGateway>

    <task id="taskWriteLabel" name="Write package label">
      <incoming>sequenceFlow9</incoming>
      <outgoing>sequenceFlow10</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow9" sourceRef="inclusiveGatewayInsurance" targetRef="taskWriteLabel"/>

    <task id="taskInsureGoods" name="Insure goods">
      <incoming>sequenceFlow10</incoming>
      <!--<outgoing>sequenceFlow11</outgoing>-->
    </task>

    <endEvent id="endEvent1">
      <incoming>sequenceFlow8</incoming>
    </endEvent>
  </process>
</definitions>