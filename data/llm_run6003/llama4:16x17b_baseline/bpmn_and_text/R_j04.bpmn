<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definition" name="Car Service Process" targetNamespace="http://example.com/bpmn">
   <process id="CarServiceProcess" isExecutable="true">
     <startEvent id="StartEvent1">
       <outgoing>SequenceFlow1</outgoing>
     </startEvent>
     <sequenceFlow id="SequenceFlow1" sourceRef="StartEvent1" targetRef="Task1"/>
     <task id="Task1" name="Check Car Registration">
       <incoming>SequenceFlow1</incoming>
       <outgoing>SequenceFlow2</outgoing>
       <outgoing>SequenceFlow3</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow2" sourceRef="Task1" targetRef="Task2"/>
     <sequenceFlow id="SequenceFlow3" sourceRef="Task1" targetRef="EndEvent1"/>
     <task id="Task2" name="Notify Customer of Service Due">
       <incoming>SequenceFlow2</incoming>
       <outgoing>SequenceFlow4</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow4" sourceRef="Task2" targetRef="TimerEvent1"/>
     <intermediateEvent id="TimerEvent1" name="Wait for 30 Days">
       <incoming>SequenceFlow4</incoming>
       <outgoing>SequenceFlow5</outgoing>
     </intermediateEvent>
     <sequenceFlow id="SequenceFlow5" sourceRef="TimerEvent1" targetRef="Task3"/>
     <task id="Task3" name="Fine Customer">
       <incoming>SequenceFlow5</incoming>
       <outgoing>SequenceFlow6</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow6" sourceRef="Task3" targetRef="EndEvent1"/>
     <parallelGateway id="ParallelGateway1">
       <incoming>SequenceFlow2</incoming>
       <outgoing>SequenceFlow7</outgoing>
       <outgoing>SequenceFlow8</outgoing>
     </parallelGateway>
     <sequenceFlow id="SequenceFlow7" sourceRef="ParallelGateway1" targetRef="Task4"/>
     <task id="Task4" name="Mechanic Enters Car Problems">
       <incoming>SequenceFlow7</incoming>
       <outgoing>SequenceFlow9</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow9" sourceRef="Task4" targetRef="IntermediateCatchEvent1"/>
     <intermediateCatchEvent id="IntermediateCatchEvent1">
       <incoming>SequenceFlow9</incoming>
     </intermediateCatchEvent>
     <sequenceFlow id="SequenceFlow8" sourceRef="ParallelGateway1" targetRef="Task6"/>
     <task id="Task6" name="Pay through App">
       <incoming>SequenceFlow8</incoming>
       <outgoing>SequenceFlow12</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow12" sourceRef="Task6" targetRef="Task7"/>
     <task id="Task7" name="Mechanic Enters Repair Success and Next Service Date">
       <incoming>SequenceFlow12</incoming>
       <outgoing>SequenceFlow13</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow13" sourceRef="Task7" targetRef="EndEvent2"/>
     <endEvent id="EndEvent1">
       <incoming>SequenceFlow3</incoming>
       <incoming>SequenceFlow6</incoming>
     </endEvent>
     <endEvent id="EndEvent2">
       <incoming>SequenceFlow13</incoming>
     </endEvent>
   </process>
 </definitions>