<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definitions" 
             targetNamespace="http://example.com/bpmn">

   <process id="internshipProcess" isExecutable="true">
     <startEvent id="startEvent1">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="taskEnterDetails"/>

     <task id="taskEnterDetails" name="Enter Details (Topic, Money, Experience, Hobbies)">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow2" sourceRef="taskEnterDetails" targetRef="intermediateCatchEventOffers"/>

     <intermediateCatchEvent id="intermediateCatchEventOffers1">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
     </intermediateCatchEvent>

     <sequenceFlow id="sequenceFlow3" sourceRef="intermediateCatchEventOffers1" targetRef="exclusiveGatewayOffer"/>

     <exclusiveGateway id="exclusiveGatewayOffer1">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow4</outgoing>
       <outgoing>sequenceFlow5</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow4" sourceRef="exclusiveGatewayOffer1" targetRef="taskAcceptOffer">
       <conditionExpression xsi:type="tFormalExpression">${offerAccepted == true}</conditionExpression>
     </sequenceFlow>

     <task id="taskAcceptOffer1" name="Accept Offer">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow6</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow6" sourceRef="taskAcceptOffer1" targetRef="parallelGatewayStatusUpdates"/>

     <parallelGateway id="parallelGatewayStatusUpdates1">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow7</outgoing>
       <outgoing>sequenceFlow8</outgoing>
     </parallelGateway>

     <sequenceFlow id="sequenceFlow7" sourceRef="parallelGatewayStatusUpdates1" targetRef="taskInternshipStatusUpdates"/>

     <task id="taskInternshipStatusUpdates1" name="Write Internship Status Updates (at least 3)">
       <incoming>sequenceFlow7</incoming>
     </task>

     <sequenceFlow id="sequenceFlow8" sourceRef="parallelGatewayStatusUpdates1" targetRef="taskCompanyStatusUpdates"/>

     <task id="taskCompanyStatusUpdates1" name="Company writes Status Updates about you (at least 3)">
       <incoming>sequenceFlow8</incoming>
     </task>

     <sequenceFlow id="sequenceFlow5" sourceRef="exclusiveGatewayOffer1" targetRef="endEventOfferDenied">
       <conditionExpression xsi:type="tFormalExpression">${offerAccepted == false}</conditionExpression>
     </sequenceFlow>

     <endEvent id="endEventOfferDenied1">
       <incoming>sequenceFlow5</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow9" sourceRef="taskInternshipStatusUpdates1" targetRef="endEventInternshipFinished"/>

     <sequenceFlow id="sequenceFlow10" sourceRef="taskCompanyStatusUpdates1" targetRef="endEventInternshipFinished1"/>

     <endEvent id="endEventInternshipFinished1">
       <incoming>sequenceFlow9</incoming>
       <incoming>sequenceFlow10</incoming>
       <outgoing>sequenceFlow11</outgoing>
     </endEvent>

     <sequenceFlow id="sequenceFlow11" sourceRef="endEventInternshipFinished1" targetRef="taskRecommendCompany"/>

     <task id="taskRecommendCompany1" name="Recommend Company to Friends via Twitter">
       <incoming>sequenceFlow11</incoming>
     </task>

   </process>

</definitions>