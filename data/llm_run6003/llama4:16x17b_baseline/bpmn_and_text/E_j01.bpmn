<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definition" name="Find a Job Process">
  <process id="FindJobProcess" isExecutable="true">
    <startEvent id="StartEvent1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent1" targetRef="Task_ReportApplications"/>
    <task id="Task_ReportApplications" name="Report Job Applications">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_ReportApplications" targetRef="ExclusiveGateway_1"/>
    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
      <outgoing>SequenceFlow_4</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_1" targetRef="Task_ReceiveJobOffers">
      <!--<conditionExpression xsi:type="tFormalExpression">${hasNewApplications}</conditionExpression>-->
    </sequenceFlow>
    <task id="Task_ReceiveJobOffers" name="Receive New Job Offers">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_5</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_5" sourceRef="Task_ReceiveJobOffers" targetRef="ExclusiveGateway_2"/>
    <exclusiveGateway id="ExclusiveGateway_2">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_6</outgoing>
      <outgoing>SequenceFlow_7</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_6" sourceRef="ExclusiveGateway_2" targetRef="Task_ApplicationConfirmed">
      <!--<conditionExpression xsi:type="tFormalExpression">${applicationConfirmed}</conditionExpression>-->
    </sequenceFlow>
    <task id="Task_ApplicationConfirmed" name="Confirm Application Received by Company">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_8" sourceRef="Task_ApplicationConfirmed" targetRef="Task_NegotiateInterview"/>
    <task id="Task_NegotiateInterview" name="Negotiate Job Interview">
      <incoming>SequenceFlow_8</incoming>
      <outgoing>SequenceFlow_9</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_9" sourceRef="Task_NegotiateInterview" targetRef="ExclusiveGateway_3"/>
    <exclusiveGateway id="ExclusiveGateway_3">
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_10</outgoing>
      <outgoing>SequenceFlow_11</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_10" sourceRef="ExclusiveGateway_3" targetRef="Task_ProbationPhase">
      <!--<conditionExpression xsi:type="tFormalExpression">${jobOfferAccepted}</conditionExpression>-->
    </sequenceFlow>
    <task id="Task_ProbationPhase" name="Enter Probation Phase">
      <incoming>SequenceFlow_10</incoming>
      <outgoing>SequenceFlow_12</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_12" sourceRef="Task_ProbationPhase" targetRef="Task_RateCompany"/>
    <task id="Task_RateCompany" name="Rate Company and Get Rated">
      <incoming>SequenceFlow_12</incoming>
      <outgoing>SequenceFlow_13</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_13" sourceRef="Task_RateCompany" targetRef="ExclusiveGateway_4"/>
    <exclusiveGateway id="ExclusiveGateway_4">
      <incoming>SequenceFlow_13</incoming>
      <outgoing>SequenceFlow_14</outgoing>
      <outgoing>SequenceFlow_15</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_14" sourceRef="ExclusiveGateway_4" targetRef="EndEvent_1">
      <!--<conditionExpression xsi:type="tFormalExpression">${rating  >  'C'}</conditionExpression>-->
    </sequenceFlow>
    <endEvent id="EndEvent_1">
      <incoming>SequenceFlow_14</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_15" sourceRef="ExclusiveGateway_4" targetRef="Task_ContinueReceivingOffers">
      <!--<conditionExpression xsi:type="tFormalExpression">${rating  <=  'C'}</conditionExpression>-->
    </sequenceFlow>
    <task id="Task_ContinueReceivingOffers" name="Continue Receiving Job Offers without Reporting">
      <incoming>SequenceFlow_15</incoming>
      <!--<outgoing>SequenceFlow_16</outgoing>-->
    </task>
    <!--<sequenceFlow id="SequenceFlow_16" sourceRef="Task_ContinueReceivingOffers" targetRef="EndEvent_2"/>-->
    <endEvent id="EndEvent_2">
      <!--<incoming>SequenceFlow_16</incoming>-->
    </endEvent>
    <sequenceFlow id="SequenceFlow_7" sourceRef="ExclusiveGateway_2" targetRef="Task_RejectedApplication">
      <!--<conditionExpression xsi:type="tFormalExpression">${applicationRejected}</conditionExpression>-->
    </sequenceFlow>
    <task id="Task_RejectedApplication" name="Notify of Rejected Application">
      <incoming>SequenceFlow_7</incoming>
      <!--<outgoing>SequenceFlow_17</outgoing>-->
    </task>
    <!--<sequenceFlow id="SequenceFlow_17" sourceRef="Task_RejectedApplication" targetRef="EndEvent_3"/>-->
    <endEvent id="EndEvent_3">
      <!--<incoming>SequenceFlow_17</incoming>-->
    </endEvent>
    <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_1" targetRef="Task_ViewReviews">
      <!--<conditionExpression xsi:type="tFormalExpression">${oneYearPassed}</conditionExpression>-->
    </sequenceFlow>
    <task id="Task_ViewReviews" name="View Company Reviews  (if 1 year passed)">
      <incoming>SequenceFlow_4</incoming>
      <!--<outgoing>SequenceFlow_18</outgoing>-->
    </task>
    <!--<sequenceFlow id="SequenceFlow_18" sourceRef="Task_ViewReviews" targetRef="EndEvent_4"/>-->
    <endEvent id="EndEvent_4">
      <!--<incoming>SequenceFlow_18</incoming>-->
    </endEvent>
  </process>
</definitions>