<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">

  <process id="InvoiceProcess" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>

    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>

    <task id="Task_1" name="Try to locate Vendor in SAP system">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
      <outgoing>SequenceFlow_3</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="Task_4">
      <conditionExpression xsi:type="tFormalExpression">Vendor found in SAP system</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="SequenceFlow_3" sourceRef="Task_1" targetRef="SubProcess_1">
      <conditionExpression xsi:type="tFormalExpression">Vendor not found in SAP system</conditionExpression>
    </sequenceFlow>

    <subProcess id="SubProcess_1" name="Record new Vendor">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_4</outgoing>
      <startEvent id="StartEvent_2">
        <outgoing>SequenceFlow_5</outgoing>
      </startEvent>

      <sequenceFlow id="SequenceFlow_5" sourceRef="StartEvent_2" targetRef="Task_2"/>

      <task id="Task_2" name="Fill new Vendor Master Record form">
        <incoming>SequenceFlow_5</incoming>
        <outgoing>SequenceFlow_6</outgoing>
      </task>

      <sequenceFlow id="SequenceFlow_6" sourceRef="Task_2" targetRef="Task_3"/>

      <task id="Task_3" name="Attach request to invoice and put in internal outbox for new vendors">
        <incoming>SequenceFlow_6</incoming>
        <outgoing>SequenceFlow_7</outgoing>
      </task>

      <sequenceFlow id="SequenceFlow_7" sourceRef="Task_3" targetRef="ExclusiveGateway_1"/>

      <exclusiveGateway id="ExclusiveGateway_1">
        <incoming>SequenceFlow_7</incoming>
        <outgoing>SequenceFlow_8</outgoing>
        <outgoing>SequenceFlow_9</outgoing>
      </exclusiveGateway>

      <sequenceFlow id="SequenceFlow_8" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_2">
        <conditionExpression xsi:type="tFormalExpression">invoice is urgent</conditionExpression>
      </sequenceFlow>

      <sequenceFlow id="SequenceFlow_9" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_3">
        <conditionExpression xsi:type="tFormalExpression">invoice is non-urgent</conditionExpression>
      </sequenceFlow>

      <endEvent id="EndEvent_2">
        <incoming>SequenceFlow_8</incoming>
      </endEvent>

      <endEvent id="EndEvent_3">
        <incoming>SequenceFlow_9</incoming>
      </endEvent>

    </subProcess>

    <sequenceFlow id="SequenceFlow_4" sourceRef="SubProcess_1" targetRef="Task_4"/>

    <task id="Task_4" name="Add SAP number to invoice">
      <incoming>SequenceFlow_2</incoming>
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_10</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_10" sourceRef="Task_4" targetRef="ExclusiveGateway_2"/>

    <exclusiveGateway id="ExclusiveGateway_2">
      <incoming>SequenceFlow_10</incoming>
      <outgoing>SequenceFlow_11</outgoing>
      <outgoing>SequenceFlow_12</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow_11" sourceRef="ExclusiveGateway_2" targetRef="Task_5">
      <conditionExpression xsi:type="tFormalExpression">sort by amount</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="SequenceFlow_12" sourceRef="ExclusiveGateway_2" targetRef="Task_6">
      <conditionExpression xsi:type="tFormalExpression">sort by vendor</conditionExpression>
    </sequenceFlow>

    <task id="Task_5" name="Sort invoices by amount">
      <incoming>SequenceFlow_11</incoming>
      <outgoing>SequenceFlow_13</outgoing>
    </task>

    <task id="Task_6" name="Sort invoices by vendor">
      <incoming>SequenceFlow_12</incoming>
      <outgoing>SequenceFlow_13</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_13" sourceRef="Task_5" targetRef="Task_7"/>
    <sequenceFlow id="SequenceFlow_14" sourceRef="Task_6" targetRef="Task_7"/>

    <task id="Task_7" name="Enter invoices in SAP system">
      <incoming>SequenceFlow_13</incoming>
      <incoming>SequenceFlow_14</incoming>
      <outgoing>SequenceFlow_15</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_15" sourceRef="Task_7" targetRef="EndEvent_1"/>

    <endEvent id="EndEvent_1">
      <incoming>SequenceFlow_15</incoming>
    </endEvent>

  </process>

</definitions>