<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">

  <process id="HardwareBuyingProcess" isExecutable="true">
    <startEvent id="RequestReceived">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>

    <sequenceFlow id="SequenceFlow_1" sourceRef="RequestReceived" targetRef="AnalyseRequest"/>

    <userTask id="AnalyseRequest" name="Analyse Request">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
      <outgoing>SequenceFlow_3</outgoing>
    </userTask>

    <sequenceFlow id="SequenceFlow_2" sourceRef="AnalyseRequest" targetRef="ApproveRequest">
      <conditionExpression xsi:type="tFormalExpression">approved == true</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="SequenceFlow_3" sourceRef="AnalyseRequest" targetRef="DenyRequest">
      <conditionExpression xsi:type="tFormalExpression">approved == false</conditionExpression>
    </sequenceFlow>

    <userTask id="ApproveRequest" name="Edit and Complete Request">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_4</outgoing>
    </userTask>

    <sequenceFlow id="SequenceFlow_4" sourceRef="ApproveRequest" targetRef="SendEmailToSupplier"/>

    <serviceTask id="SendEmailToSupplier" name="Send Email to Supplier">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_5</outgoing>
    </serviceTask>

    <sequenceFlow id="SequenceFlow_5" sourceRef="SendEmailToSupplier" targetRef="ReceiveOfferFromSupplier"/>

    <userTask id="ReceiveOfferFromSupplier" name="Receive Offer from Supplier">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </userTask>

    <sequenceFlow id="SequenceFlow_6" sourceRef="ReceiveOfferFromSupplier" targetRef="FillInFormAndSendToManagement"/>

    <userTask id="FillInFormAndSendToManagement" name="Fill in Form and Send to Management">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </userTask>

    <sequenceFlow id="SequenceFlow_7" sourceRef="FillInFormAndSendToManagement" targetRef="ManagementDecision"/>

    <exclusiveGateway id="ManagementDecision">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_8</outgoing>
      <outgoing>SequenceFlow_9</outgoing>
      <outgoing>SequenceFlow_10</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow_8" sourceRef="ManagementDecision" targetRef="ForwardToFinancialDepartment">
      <conditionExpression xsi:type="tFormalExpression">approved == true</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="SequenceFlow_9" sourceRef="ManagementDecision" targetRef="ReworkRequest">
      <conditionExpression xsi:type="tFormalExpression">rework == true</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="SequenceFlow_10" sourceRef="ManagementDecision" targetRef="DenyRequestFinal">
      <conditionExpression xsi:type="tFormalExpression">approved == false</conditionExpression>
    </sequenceFlow>

    <userTask id="ForwardToFinancialDepartment" name="Forward to Financial Department">
      <incoming>SequenceFlow_8</incoming>
      <outgoing>SequenceFlow_11</outgoing>
    </userTask>

    <sequenceFlow id="SequenceFlow_11" sourceRef="ForwardToFinancialDepartment" targetRef="PrepareOrderAndSendToSupplier"/>

    <userTask id="PrepareOrderAndSendToSupplier" name="Prepare Order and Send to Supplier">
      <incoming>SequenceFlow_11</incoming>
      <outgoing>SequenceFlow_12</outgoing>
    </userTask>

    <sequenceFlow id="SequenceFlow_12" sourceRef="PrepareOrderAndSendToSupplier" targetRef="ReceiveHardware"/>

    <userTask id="ReworkRequest" name="Rework Request">
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_13</outgoing>
    </userTask>

    <sequenceFlow id="SequenceFlow_13" sourceRef="ReworkRequest" targetRef="ApproveRequest"/>

    <endEvent id="DenyRequest">
      <incoming>SequenceFlow_3</incoming>
    </endEvent>

    <endEvent id="DenyRequestFinal">
      <incoming>SequenceFlow_10</incoming>
    </endEvent>

    <userTask id="ReceiveHardware" name="Receive Hardware">
      <incoming>SequenceFlow_12</incoming>
      <outgoing>SequenceFlow_14</outgoing>
    </userTask>

    <sequenceFlow id="SequenceFlow_14" sourceRef="ReceiveHardware" targetRef="EndEvent"/>

    <endEvent id="EndEvent">
      <incoming>SequenceFlow_14</incoming>
    </endEvent>

  </process>

</definitions>