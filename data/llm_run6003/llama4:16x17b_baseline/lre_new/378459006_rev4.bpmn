<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">

  <process id="PaymentProcess" isExecutable="true">
    <startEvent id="WeeklyPaymentReport">
      <outgoing>GeneratePaymentReport</outgoing>
    </startEvent>

    <sequenceFlow id="GeneratePaymentReport" sourceRef="WeeklyPaymentReport" targetRef="Task_GeneratePaymentReport"/>

    <task id="Task_GeneratePaymentReport" name="Generate payment report">
      <incoming>GeneratePaymentReport</incoming>
      <outgoing>SendPaymentReportToClients</outgoing>
      <outgoing>SendPaymentReportToRegistryOffice</outgoing>
      <outgoing>SendPaymentReportToAccountsReceivable</outgoing>
    </task>

    <sequenceFlow id="SendPaymentReportToClients" sourceRef="Task_GeneratePaymentReport" targetRef="Task_SendPaymentReportToClients"/>

    <task id="Task_SendPaymentReportToClients" name="Send payment report to clients (auto)">
      <incoming>SendPaymentReportToClients</incoming>
      <outgoing>SequenceFlow_5</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_5" sourceRef="Task_SendPaymentReportToClients" targetRef="EndEvent_PaymentReportSent"/>

    <sequenceFlow id="SendPaymentReportToRegistryOffice" sourceRef="Task_GeneratePaymentReport" targetRef="Task_SendPaymentReportToRegistryOffice"/>

    <task id="Task_SendPaymentReportToRegistryOffice" name="Send payment report to Registry office">
      <incoming>SendPaymentReportToRegistryOffice</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_6" sourceRef="Task_SendPaymentReportToRegistryOffice" targetRef="Task_SelectInvoicesForArchiving"/>

    <task id="Task_SelectInvoicesForArchiving" name="Select paid invoices for archiving">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_7" sourceRef="Task_SelectInvoicesForArchiving" targetRef="EndEvent_InvoicesArchived"/>

    <sequenceFlow id="SendPaymentReportToAccountsReceivable" sourceRef="Task_GeneratePaymentReport" targetRef="Task_SendPaymentReportToAccountsReceivable"/>

    <task id="Task_SendPaymentReportToAccountsReceivable" name="Send payment report to Accounts Receivable Department">
      <incoming>SendPaymentReportToAccountsReceivable</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_8" sourceRef="Task_SendPaymentReportToAccountsReceivable" targetRef="Task_GenerateMonthlyInvoice"/>

    <task id="Task_GenerateMonthlyInvoice" name="Generate monthly invoice for clients">
      <incoming>SequenceFlow_8</incoming>
      <outgoing>SequenceFlow_9</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_9" sourceRef="Task_GenerateMonthlyInvoice" targetRef="Task_ChargeClient"/>

    <task id="Task_ChargeClient" name="Charge client $35 per invoice">
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_10</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_10" sourceRef="Task_ChargeClient" targetRef="EndEvent_ClientCharged"/>

    <endEvent id="EndEvent_PaymentReportSent">
      <incoming>SequenceFlow_5</incoming>
    </endEvent>

    <endEvent id="EndEvent_InvoicesArchived">
      <incoming>SequenceFlow_7</incoming>
    </endEvent>

    <endEvent id="EndEvent_ClientCharged">
      <incoming>SequenceFlow_10</incoming>
    </endEvent>

  </process>

</definitions>