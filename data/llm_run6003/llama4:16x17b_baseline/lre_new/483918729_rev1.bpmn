<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">

  <process id="Process_1" isExecutable="true">
    <startEvent id="StartEvent_1">
      <incoming>None</incoming>
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>

    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>

    <task id="Task_1" name="Identify necessary parts">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
      <outgoing>SequenceFlow_3</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="Task_3">
      <conditionExpression xsi:type="tFormalExpression">no questions</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="SequenceFlow_3" sourceRef="Task_1" targetRef="Task_2">
      <conditionExpression xsi:type="tFormalExpression">questions exist</conditionExpression>
    </sequenceFlow>

    <task id="Task_2" name="Request more information from customer">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_4</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_4" sourceRef="Task_2" targetRef="Task_1"/>

    <task id="Task_3" name="Check parts availability">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_5</outgoing>
      <outgoing>SequenceFlow_6</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_5" sourceRef="Task_3" targetRef="Task_4">
      <conditionExpression xsi:type="tFormalExpression">all parts available</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="SequenceFlow_6" sourceRef="Task_3" targetRef="Task_5">
      <conditionExpression xsi:type="tFormalExpression">not all parts available</conditionExpression>
    </sequenceFlow>

    <task id="Task_4" name="Supply parts to customer">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_7" sourceRef="Task_4" targetRef="EndEvent_1"/>

    <task id="Task_5" name="Record petition and order parts from Daisuki">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_8" sourceRef="Task_5" targetRef="Task_6"/>

    <task id="Task_6" name="Notify customer when all parts collected">
      <incoming>SequenceFlow_8</incoming>
      <outgoing>SequenceFlow_9</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_9" sourceRef="Task_6" targetRef="Task_7"/>

    <task id="Task_7" name="Receive final payment from customer">
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_10</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_10" sourceRef="Task_7" targetRef="EndEvent_1"/>

    <endEvent id="EndEvent_1">
      <incoming>SequenceFlow_7</incoming>
      <incoming>SequenceFlow_10</incoming>
    </endEvent>

  </process>

</definitions>