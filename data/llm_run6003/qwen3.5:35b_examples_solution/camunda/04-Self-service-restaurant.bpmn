<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Guest" name="Guest food consumption" processRef="Process_Guest"/>
    <bpmn:participant id="Participant_Employee" name="Employee order processing" processRef="Process_Employee"/>
    <bpmn:participant id="Participant_Chef" name="Chef meal preparation" processRef="Process_Chef"/>

    <!-- Message Flows -->
    <bpmn:messageFlow id="MessageFlow_OrderReceived" sourceRef="Task_GuestPlaceOrder" targetRef="StartEvent_EmployeeOrderReceived"/>
    <bpmn:messageFlow id="MessageFlow_ChefNotified" sourceRef="Task_EmployeeInformChef" targetRef="StartEvent_ChefMealNeeded"/>
    <bpmn:messageFlow id="MessageFlow_MealReady" sourceRef="Task_ChefInformEmployee" targetRef="IntermediateCatchEvent_EmployeeWaitForMeal"/>
    <bpmn:messageFlow id="MessageFlow_BuzzerRings" sourceRef="Task_EmployeeRingBuzzer" targetRef="IntermediateCatchEvent_GuestMealReady"/>
  </bpmn:collaboration>

  <!-- Guest Process -->
  <bpmn:process id="Process_Guest">
    <bpmn:startEvent id="StartEvent_Hungry" name="Hunger noticed">
      <bpmn:outgoing SequenceFlow_01Guest"/>
    </bpmn:startEvent>

    <bpmn:task id="Task_GuestEnterRestaurant" name="Enter restaurant">
      <bpmn:incoming SequenceFlow_01Guest</bpmn:incoming>
      <bpmn:outgoing SequenceFlow_02Guest"/>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_01Guest" sourceRef="StartEvent_Hungry" targetRef="Task_GuestEnterRestaurant"/>

    <bpmn:task id="Task_GuestChooseDish" name="Choose dish">
      <bpmn:incoming SequenceFlow_02Guest</bpmn:incoming>
      <bpmn:outgoing SequenceFlow_03Guest"/>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_02Guest" sourceRef="Task_GuestEnterRestaurant" targetRef="Task_GuestChooseDish"/>

    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_WaitTurn" name="Wait for turn">
      <bpmn:incoming SequenceFlow_03Guest</bpmn:incoming>
      <bpmn:outgoing SequenceFlow_04Guest"/>
      <bpmn:conditionalEventDefinition/>
    </bpmn:intermediateCatchEvent>

    <bpmn:sequenceFlow id="SequenceFlow_03Guest" sourceRef="Task_GuestChooseDish" targetRef="IntermediateCatchEvent_WaitTurn"/>

    <bpmn:task id="Task_GuestPlaceOrder" name="Place order">
      <bpmn:incoming SequenceFlow_04Guest</bpmn:incoming>
      <bpmn:outgoing SequenceFlow_05Guest"/>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_04Guest" sourceRef="IntermediateCatchEvent_WaitTurn" targetRef="Task_GuestPlaceOrder"/>

    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_PaymentComplete">
      <bpmn:incoming SequenceFlow_05Guest</bpmn:incoming>
      <bpmn:outgoing SequenceFlow_06Guest"/>
      <bpmn:messageEventDefinition/>
    </bpmn:intermediateCatchEvent>

    <bpmn:sequenceFlow id="SequenceFlow_05Guest" sourceRef="Task_GuestPlaceOrder" targetRef="IntermediateCatchEvent_PaymentComplete"/>

    <bpmn:task id="Task_GuestReceiveBuzzer" name="Receive buzzer">
      <bpmn:incoming SequenceFlow_06Guest</bpmn:incoming>
      <bpmn:outgoing SequenceFlow_12Guest"/>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_06Guest" sourceRef="IntermediateCatchEvent_PaymentComplete" targetRef="Task_GuestReceiveBuzzer"/>

    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_MealReady" name="Meal ready (Buzzer)">
      <bpmn:incoming SequenceFlow_12Guest</bpmn:incoming>
      <bpmn:outgoing SequenceFlow_13Guest"/>
      <bpmn:messageEventDefinition/>
    </bpmn:intermediateCatchEvent>

    <bpmn:sequenceFlow id="SequenceFlow_12Guest" sourceRef="Task_GuestReceiveBuzzer" targetRef="IntermediateCatchEvent_MealReady"/>

    <bpmn:task id="Task_GuestPickUpMeal" name="Pick up meal">
      <bpmn:incoming SequenceFlow_13Guest</bpmn:incoming>
      <bpmn:outgoing SequenceFlow_14Guest"/>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_13Guest" sourceRef="IntermediateCatchEvent_MealReady" targetRef="Task_GuestPickUpMeal"/>

    <bpmn:task id="Task_GuestEatMeal" name="Eat meal">
      <bpmn:incoming SequenceFlow_14Guest</bpmn:incoming>
      <bpmn:outgoing SequenceFlow_15Guest"/>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_14Guest" sourceRef="Task_GuestPickUpMeal" targetRef="Task_GuestEatMeal"/>

    <bpmn:endEvent id="EndEvent_NotHungryAnymore" name="Not hungry anymore">
      <bpmn:incoming SequenceFlow_15Guest</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow_15Guest" sourceRef="Task_GuestEatMeal" targetRef="EndEvent_NotHungryAnymore"/>
  </bpmn:process>

  <!-- Employee Process -->
  <bpmn:process id="Process_Employee">
    <bpmn:startEvent id="StartEvent_EmployeeOrderReceived" name="Order received">
      <bpmn:outgoing SequenceFlow_01Employee"/>
      <bpmn:messageEventDefinition/>
    </bpmn:startEvent>

    <bpmn:task id="Task_EmployeeEnterOrderPOS" name="Enter order in POS system">
      <bpmn:incoming SequenceFlow_01Employee</bpmn:incoming>
      <bpmn:outgoing SequenceFlow_02Employee"/>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_01Employee" sourceRef="StartEvent_EmployeeOrderReceived" targetRef="Task_EmployeeEnterOrderPOS"/>

    <bpmn:task id="Task_EmployeeCollectMoney" name="Collect money from guest">
      <bpmn:incoming SequenceFlow_02Employee</bpmn:incoming>
      <bpmn:outgoing SequenceFlow_03Employee"/>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_02Employee" sourceRef="Task_EmployeeEnterOrderPOS" targetRef="Task_EmployeeCollectMoney"/>

    <bpmn:task id="Task_EmployeeSetBuzzer" name="Set up buzzer">
      <bpmn:incoming SequenceFlow_03Employee</bpmn:incoming>
      <bpmn:outgoing SequenceFlow_04Employee"/>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_03Employee" sourceRef="Task_EmployeeCollectMoney" targetRef="Task_EmployeeSetBuzzer"/>

    <bpmn:task id="Task_EmployeeHandOverBuzzer" name="Pass buzzer to guest">
      <bpmn:incoming SequenceFlow_04Employee</bpmn:incoming>
      <bpmn:outgoing SequenceFlow_05Employee"/>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_04Employee" sourceRef="Task_EmployeeSetBuzzer" targetRef="Task_EmployeeHandOverBuzzer"/>

    <bpmn:task id="Task_EmployeeInformChef" name="Inform chef of order">
      <bpmn:incoming SequenceFlow_05Employee</bpmn:incoming>
      <bpmn:outgoing SequenceFlow_06Employee"/>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_05Employee" sourceRef="Task_EmployeeHandOverBuzzer" targetRef="Task_EmployeeInformChef"/>

    <!-- Wait for meal ready notification -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_EmployeeWaitForMeal" name="Meal in hatch">
      <bpmn:incoming SequenceFlow_07Employee</bpmn:incoming>
      <bpmn:outgoing SequenceFlow_14Employee"/>
      <bpmn:messageEventDefinition/>
    </bpmn:intermediateCatchEvent>

    <!-- Event-based gateway for timeout or guest appears -->
    <bpmn:eventBasedGateway id="EventBasedGateway_Timeout">
      <bpmn:incoming SequenceFlow_06Employee</bpmn:incoming>
      <bpmn:incoming SequenceFlow_15Employee"/>
      <bpmn:outgoing SequenceFlow_09Employee"/>
    </bpmn:eventBasedGateway>

    <!-- Wait for meal ready -->
    <bpmn:sequenceFlow id="SequenceFlow_06Employee" sourceRef="Task_EmployeeInformChef" targetRef="EventBasedGateway_Timeout"/>

    <bpmn:task id="Task_EmployeeRingBuzzer" name="Set off buzzer">
      <bpmn:incoming SequenceFlow_14Employee</bpmn:incoming>
      <bpmn:outgoing SequenceFlow_09Employee"/>
    </bpmn:task>

    <!-- Wait for guest to appear -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_GuestAppears" name="Guest appears">
      <bpmn:incoming SequenceFlow_10Employee</bpmn:incoming>
      <bpmn:outgoing SequenceFlow_11Employee"/>
      <bpmn:messageEventDefinition/>
    </bpmn:intermediateCatchEvent>

    <!-- Timeout for buzzer response -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_Timeout5Min" name="Wait 5 minutes">
      <bpmn:incoming SequenceFlow_09Employee</bpmn:incoming>
      <bpmn:outgoing SequenceFlow_12Employee"/>
      <bpmn:timerEventDefinition/>
    </bpmn:intermediateCatchEvent>

    <!-- Call guest if no response -->
    <bpmn:task id="Task_EmployeeCallGuest" name="Call for guest">
      <bpmn:incoming SequenceFlow_12Employee</bpmn:incoming>
      <bpmn:outgoing SequenceFlow_15Employee"/>
    </bpmn:task>

    <!-- Hand over meal -->
    <bpmn:task id="Task_EmployeeHandOverMeal" name="Hand over meal to guest">
      <bpmn:incoming SequenceFlow_11Employee</bpmn:incoming>
      <bpmn:outgoing SequenceFlow_13Employee"/>
    </bpmn:task>

    <!-- Wait for meal ready notification from chef -->
    <bpmn:sequenceFlow id="SequenceFlow_07Employee" sourceRef="Task_EmployeeWaitForMealReadyNotification" targetRef="IntermediateCatchEvent_EmployeeWaitForMeal"/>

    <bpmn:endEvent id="EndEvent_OrderProcessed" name="Order processed">
      <bpmn:incoming SequenceFlow_13Employee</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Wait for meal ready or timeout -->
    <bpmn:eventBasedGateway id="EventBasedGateway_WaitForMealOrTimeout">
      <bpmn:incoming SequenceFlow_06Employee</bpmn:incoming>
      <bpmn:outgoing SequenceFlow_14Employee"/>
    </bpmn:eventBasedGateway>

    <!-- Wait for meal ready notification from chef -->
    <bpmn:task id="Task_EmployeeWaitForMealReadyNotification" name="Wait for Chef">
      <bpmn:incoming SequenceFlow_06Employee</bpmn:incoming>
      <bpmn:outgoing SequenceFlow_07Employee"/>
    </bpmn:task>

    <!-- Loop back to wait for guest -->
    <bpmn:sequenceFlow id="SequenceFlow_13Employee" sourceRef="Task_EmployeeHandOverMeal" targetRef="EndEvent_OrderProcessed"/>

    <bpmn:sequenceFlow id="SequenceFlow_08Employee" sourceRef="IntermediateCatchEvent_EmployeeWaitForMeal" targetRef="Task_EmployeeRingBuzzer"/>
    <bpmn:sequenceFlow id="SequenceFlow_14Employee" sourceRef="EventBasedGateway_WaitForMealOrTimeout" targetRef="Task_EmployeeRingBuzzer"/>

    <!-- Wait for guest to appear -->
    <bpmn:sequenceFlow id="SequenceFlow_09Employee" sourceRef="Task_EmployeeRingBuzzer" targetRef="IntermediateCatchEvent_Timeout5Min"/>
    <bpmn:sequenceFlow id="SequenceFlow_12Employee" sourceRef="IntermediateCatchEvent_Timeout5Min" targetRef="Task_EmployeeCallGuest"/>

    <!-- Loop back to wait for guest -->
    <bpmn:sequenceFlow id="SequenceFlow_10Employee" sourceRef="EventBasedGateway_Timeout" targetRef="IntermediateCatchEvent_GuestAppears"/>
    <bpmn:sequenceFlow id="SequenceFlow_15Employee" sourceRef="Task_EmployeeCallGuest" targetRef="EventBasedGateway_WaitForMealOrTimeout"/>

    <!-- Hand over meal -->
    <bpmn:sequenceFlow id="SequenceFlow_11Employee" sourceRef="IntermediateCatchEvent_GuestAppears" targetRef="Task_EmployeeHandOverMeal"/>
  </bpmn:process>

  <!-- Chef Process -->
  <bpmn:process id="Process_Chef">
    <bpmn:startEvent id="StartEvent_ChefMealNeeded" name="Meal needed">
      <bpmn:outgoing SequenceFlow_01Chef"/>
      <bpmn:messageEventDefinition/>
    </bpmn:startEvent>

    <bpmn:task id="Task_ChefPrepareMeal" name="Prepare meal">
      <bpmn:incoming SequenceFlow_01Chef</bpmn:incoming>
      <bpmn:outgoing SequenceFlow_02Chef"/>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_01Chef" sourceRef="StartEvent_ChefMealNeeded" targetRef="Task_ChefPrepareMeal"/>

    <bpmn:task id="Task_ChefPlaceInHatch" name="Place meal in service hatch">
      <bpmn:incoming SequenceFlow_02Chef</bpmn:incoming>
      <bpmn:outgoing SequenceFlow_03Chef"/>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_02Chef" sourceRef="Task_ChefPrepareMeal" targetRef="Task_ChefPlaceInHatch"/>

    <bpmn:task id="Task_ChefInformEmployee" name="Inform employee meal ready">
      <bpmn:incoming SequenceFlow_03Chef</bpmn:incoming>
      <bpmn:outgoing SequenceFlow_04Chef"/>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_03Chef" sourceRef="Task_ChefPlaceInHatch" targetRef="Task_ChefInformEmployee"/>

    <bpmn:endEvent id="EndEvent_MealPrepared" name="Meal prepared">
      <bpmn:incoming SequenceFlow_04Chef</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow_04Chef" sourceRef="Task_ChefInformEmployee" targetRef="EndEvent_MealPrepared"/>
  </bpmn:process>
</bpmn:definitions>