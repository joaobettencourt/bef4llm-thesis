<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_0" name="Underwriter Process" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Company decides to go public">
      <bpmn:outgoing>SequenceFlow_0</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="UserTask_1" name="Select underwriters">
      <bpmn:incoming>SequenceFlow_0</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="ExclusiveGateway_1" name="Facts presented fairly?">
      <bpmn:name>Facts presented fairly?</bpmn:name>
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="EndEvent_1" name="Process terminated">
      <bpmn:name>Process terminated</bpmn:name>
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_2" name="Underwriters refuse">
      <bpmn:name>Underwriters refuse</bpmn:name>
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:userTask id="UserTask_2" name="Provide procedural and financial advice">
      <bpmn:name>Provide procedural and financial advice</bpmn:name>
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="UserTask_3" name="Prepare registration statement for SEC approval">
      <bpmn:name>Prepare registration statement for SEC approval</bpmn:name>
      <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:intermediateCatchEvent id="IntermediateMessageEvent_1" name="SEC approval received">
      <bpmn:name>SEC approval received</bpmn:name>
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:userTask id="UserTask_4" name="Check compliance with blue-sky laws">
      <bpmn:name>Check compliance with blue-sky laws</bpmn:name>
      <bpmn:incoming>SequenceFlow_8</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_9</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:parallelGateway id="ParallelGateway_1">
      <bpmn:name>Synchronize after advice and law check</bpmn:name>
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:userTask id="UserTask_5" name="Firm up issue price (road show)">
      <bpmn:name>Firm up issue price (road show)</bpmn:name>
      <bpmn:incoming>SequenceFlow_7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:parallelGateway id="ParallelGateway_2">
      <bpmn:name>Synchronize after road show and law check</bpmn:name>
      <bpmn:incoming>SequenceFlow_9</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:userTask id="UserTask_6" name="Fix issue price">
      <bpmn:name>Fix issue price</bpmn:name>
      <bpmn:incoming>SequenceFlow_10</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_11</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="ExclusiveGateway_2" name="Any reason not to proceed?">
      <bpmn:name>Any reason not to proceed?</bpmn:name>
      <bpmn:incoming>SequenceFlow_11</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="UserTask_7" name="Enter firm commitment to buy stock">
      <bpmn:name>Enter firm commitment to buy stock</bpmn:name>
      <bpmn:incoming>SequenceFlow_12</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_13</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="UserTask_8" name="Offer stock to public">
      <bpmn:name>Offer stock to public</bpmn:name>
      <bpmn:incoming>SequenceFlow_13</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_14</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndEvent_3" name="Stock successfully offered">
      <bpmn:name>Stock successfully offered</bpmn:name>
      <bpmn:incoming>SequenceFlow_14</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_0" sourceRef="StartEvent_1" targetRef="UserTask_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="UserTask_1" targetRef="ExclusiveGateway_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_2" name="Yes - Facts fair" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_3" name="No - Underwriters refuse" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="ParallelGateway_1" targetRef="UserTask_5"/>
    <bpmn:sequenceFlow id="SequenceFlow_5" name="Provide advice and prepare registration" sourceRef="UserTask_3" targetRef="IntermediateMessageEvent_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="IntermediateMessageEvent_1" targetRef="ParallelGateway_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_7" name="Check blue-sky laws while awaiting SEC approval" sourceRef="UserTask_4" targetRef="ParallelGateway_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_8" sourceRef="ParallelGateway_1" targetRef="UserTask_4"/>
    <bpmn:sequenceFlow id="SequenceFlow_9" name="After SEC approval, firm up price via road show" sourceRef="IntermediateMessageEvent_1" targetRef="UserTask_5"/>
    <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="ParallelGateway_2" targetRef="UserTask_6"/>
    <bpmn:sequenceFlow id="SequenceFlow_11" name="Fix issue price after road show and law check complete" sourceRef="UserTask_5" targetRef="ExclusiveGateway_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_12" name="No reason not to proceed - Continue with sale" sourceRef="ExclusiveGateway_2" targetRef="UserTask_7"/>
    <bpmn:sequenceFlow id="SequenceFlow_13" sourceRef="UserTask_6" targetRef="UserTask_8"/>
    <bpmn:sequenceFlow id="SequenceFlow_14" name="Offer to public after firm commitment entered" sourceRef="UserTask_7" targetRef="EndEvent_3"/>
  </bpmn:process>

</bpmn:definitions>