<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1kp8vzq7xw3f2r5y4h6t9u1l">
    <bpmn:participant id="Participant_0pymj5d" name="Customer Acquisition Process" processRef="Process_1cqwerym"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1cqwerym" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Marketing" name="Marketing">
        <bpmn:flowNodeRef>StartEvent_0k9geryc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_1qwe8rtyuio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BuyData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VisitExhibition</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_KnowSomeone</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_CallCenter" name="Call Center Employee">
        <bpmn:flowNodeRef>ExclusiveGateway_2asdfghjkl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DetermineContactPerson</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DetermineBudget</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_HeadDevelopment" name="Head of Development">
        <bpmn:flowNodeRef>Task_PersonalAcquisition</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_SalesRep" name="Sales Representative">
        <bpmn:flowNodeRef>ExclusiveGateway_3zxcvbnm123</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GivePresentation</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_PreSales" name="Pre-Sales Employee">
        <bpmn:flowNodeRef>Task_GiveTechnicalPresentation</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_0k9geryc" name="Determine contact details">
      <bpmn:outgoing>SequenceFlow_StartToGateway</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Initial Gateway for data sources -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_1qwe8rtyuio" name="Data Source">
      <bpmn:incoming>SequenceFlow_StartToGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BuyDataPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ExhibitionPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_KnowSomeonePath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Data Gathering Tasks -->
    <bpmn:userTask id="Task_BuyData" name="Buy data for cold calls">
      <bpmn:incoming>SequenceFlow_BuyDataPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeToCallCenter</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_VisitExhibition" name="Participate in exhibitions">
      <bpmn:incoming>SequenceFlow_ExhibitionPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeToCallCenter</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_KnowSomeone" name="Use personal contacts">
      <bpmn:incoming>SequenceFlow_KnowSomeonePath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeToCallCenter</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Call Center Tasks -->
    <bpmn:userTask id="Task_DetermineContactPerson" name="Determine contact person">
      <bpmn:incoming>SequenceFlow_MergeToCallCenter</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToBudgetCheck</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_DetermineBudget" name="Determine project budget">
      <bpmn:incoming>SequenceFlow_ToBudgetCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InterestQuestion</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Interest Check Gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_2asdfghjkl" name="Customer interested?">
      <bpmn:incoming>SequenceFlow_InterestQuestion</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InterestedPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NotInterestedPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Not Interested with Huge Budget Check -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_HugeBudgetCheck" name="Huge budget?">
      <bpmn:incoming>SequenceFlow_NotInterestedPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PersonalAcquisitionPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Personal Acquisition Task -->
    <bpmn:userTask id="Task_PersonalAcquisition" name="Head of Development acquires customer">
      <bpmn:incoming>SequenceFlow_PersonalAcquisitionPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToPresentationGateway</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Presentation Gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_3zxcvbnm123" name="Type of presentation">
      <bpmn:incoming>SequenceFlow_InterestedPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SalesPresentationPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_TechnicalPresentationPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Presentation Tasks -->
    <bpmn:userTask id="Task_GivePresentation" name="Give sales presentation">
      <bpmn:incoming>SequenceFlow_SalesPresentationPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitForCustomer</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_GiveTechnicalPresentation" name="Give technical presentation">
      <bpmn:incoming>SequenceFlow_TechnicalPresentationPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitForCustomer</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Wait for Customer -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_2WeeksTimer" name="Wait 2 weeks">
      <bpmn:incoming>SequenceFlow_WaitForCustomer</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CustomerContactedPath</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Follow-up Call -->
    <bpmn:userTask id="Task_CallCustomer" name="Sales rep calls customer">
      <bpmn:incoming>SequenceFlow_FollowUpCallPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToQuotation</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_CreateQuotation" name="Create quotation">
      <bpmn:incoming>SequenceFlow_InterestPathToPresentation</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ToQuotation</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToGateway" sourceRef="StartEvent_0k9geryc" targetRef="ExclusiveGateway_1qwe8rtyuio"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_BuyDataPath" name="Buy data" sourceRef="ExclusiveGateway_1qwe8rtyuio" targetRef="Task_BuyData"/>
    <bpmn:sequenceFlow id="SequenceFlow_ExhibitionPath" name="Exhibitions" sourceRef="ExclusiveGateway_1qwe8rtyuio" targetRef="Task_VisitExhibition"/>
    <bpmn:sequenceFlow id="SequenceFlow_KnowSomeonePath" name="Personal contacts" sourceRef="ExclusiveGateway_1qwe8rtyuio" targetRef="Task_KnowSomeone"/>

    <bpmn:sequenceFlow id="SequenceFlow_MergeToCallCenter" sourceRef="Task_BuyData" targetRef="Task_DetermineContactPerson"/>
    <bpmn:sequenceFlow id="SequenceFlow_ExhibitionMergePath" name="" sourceRef="Task_VisitExhibition" targetRef="Task_DetermineContactPerson"/>
    <bpmn:sequenceFlow id="SequenceFlow_KnowSomeoneMergePath" name="" sourceRef="Task_KnowSomeone" targetRef="Task_DetermineContactPerson"/>

    <bpmn:sequenceFlow id="SequenceFlow_ToBudgetCheck" sourceRef="Task_DetermineContactPerson" targetRef="Task_DetermineBudget"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_InterestQuestion" name="" sourceRef="Task_DetermineBudget" targetRef="ExclusiveGateway_2asdfghjkl"/>

    <!-- Interest Decision -->
    <bpmn:sequenceFlow id="SequenceFlow_InterestedPath" name="Yes - Interested" sourceRef="ExclusiveGateway_2asdfghjkl" targetRef="ExclusiveGateway_3zxcvbnm123"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_NotInterestedPath" name="No - Not interested" sourceRef="ExclusiveGateway_2asdfghjkl" targetRef="ExclusiveGateway_HugeBudgetCheck"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_PersonalAcquisitionPath" name="Yes - Huge budget" sourceRef="ExclusiveGateway_HugeBudgetCheck" targetRef="Task_PersonalAcquisition"/>

    <!-- Presentation Type Decision -->
    <bpmn:sequenceFlow id="SequenceFlow_SalesPresentationPath" name="Sales presentation" sourceRef="ExclusiveGateway_3zxcvbnm123" targetRef="Task_GivePresentation"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_TechnicalPresentationPath" name="Technical presentation" sourceRef="ExclusiveGateway_3zxcvbnm123" targetRef="Task_GiveTechnicalPresentation"/>

    <!-- Wait for Customer -->
    <bpmn:sequenceFlow id="SequenceFlow_WaitForCustomer" sourceRef="Task_GivePresentation" targetRef="IntermediateCatchEvent_2WeeksTimer"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_TechnicalWaitPath" name="" sourceRef="Task_GiveTechnicalPresentation" targetRef="IntermediateCatchEvent_2WeeksTimer"/>

    <!-- Follow-up Call -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_FollowUpCheck" name="Customer contacted?">
      <bpmn:incoming>SequenceFlow_WaitForCustomer</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CustomerContactedPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_FollowUpCallPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Wait 2 Weeks Timer -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_4WeeksTimer" name="After 2 weeks">
      <bpmn:incoming>SequenceFlow_WaitForCustomer</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_FollowUpCallPath</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Follow-up Call -->
    <bpmn:userTask id="Task_CallCustomer" name="Sales rep calls customer">
      <bpmn:incoming>SequenceFlow_FollowUpCallPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToQuotation</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Quotation -->
    <bpmn:endEvent id="EndEvent_CreateQuotation" name="Create quotation">
      <bpmn:incoming>SequenceFlow_InterestPathToPresentation</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ToQuotation</bpmn:outgoing>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>