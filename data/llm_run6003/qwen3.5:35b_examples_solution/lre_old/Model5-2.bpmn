<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Organization" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_HR" name="Human Resources Representative">
        <bpmn:flowNodeRef>Task_ProcessHR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_01</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Supervisor" name="Supervisor">
        <bpmn:flowNodeRef>Task_ApproveReject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_02</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Employee" name="Employee">
        <bpmn:flowNodeRef>StartEvent_SubmitRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegisterRequest</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_SubmitRequest" name="Submit Vacation Request">
      <bpmn:outgoing>SequenceFlow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Register vacation request (Employee lane) -->
    <bpmn:userTask id="Task_RegisterRequest" name="Register Vacation Request">
      <bpmn:incoming>SequenceFlow_06</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_02</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Supervisor approves/rejects (Supervisor lane) -->
    <bpmn:userTask id="Task_ApproveReject" name="Approve or Reject Request">
      <bpmn:incoming>SequenceFlow_02</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_03</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway: Decision point for approval/rejection (Supervisor lane) -->
    <bpmn:exclusiveGateway id="Gateway_02" name="Approved?">
      <bpmn:incoming>SequenceFlow_03</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_04</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_05</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: HR processes management procedures (HR lane) -->
    <bpmn:userTask id="Task_ProcessHR" name="Complete Management Procedures">
      <bpmn:incoming>SequenceFlow_04</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_06</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Completed" name="Vacation Request Processed">
      <bpmn:incoming>SequenceFlow_07</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_01" sourceRef="StartEvent_SubmitRequest" targetRef="Task_RegisterRequest"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_02" name="Register Request" sourceRef="Task_RegisterRequest" targetRef="Task_ApproveReject"/>

    <!-- Gateway to Supervisor -->
    <bpmn:exclusiveGateway id="Gateway_01" name="Request Received">
      <bpmn:incoming>SequenceFlow_03</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_02</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flow to Supervisor Task -->
    <bpmn:sequenceFlow id="SequenceFlow_03" name="Request Received for Approval" sourceRef="Task_ApproveReject" targetRef="Gateway_02"/>

    <!-- Sequence Flow for Approved (to HR) -->
    <bpmn:sequenceFlow id="SequenceFlow_04" name="Approved - Notify HR" sourceRef="Gateway_02" targetRef="Task_ProcessHR"/>

    <!-- Sequence Flow for Rejected (back to Employee) -->
    <bpmn:sequenceFlow id="SequenceFlow_05" name="Rejected - Return to Employee" sourceRef="Gateway_02" targetRef="Task_RegisterRequest"/>

    <!-- Sequence Flow from HR Task back through Gateway 1 and then to End Event -->
    <bpmn:sequenceFlow id="SequenceFlow_06" name="Complete Procedures" sourceRef="Task_ProcessHR" targetRef="Gateway_01"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_07" name="Process Complete" sourceRef="Gateway_01" targetRef="EndEvent_Completed"/>

  </bpmn:process>
</bpmn:definitions>