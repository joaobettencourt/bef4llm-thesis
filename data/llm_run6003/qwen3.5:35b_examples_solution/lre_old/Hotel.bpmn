<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_RoomService">
    <bpmn:participant id="Participant_HotelProcess" name="Hotel Room Service Process" processRef="Process_RoomService"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_RoomService" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Manager" name="Room-Service Manager">
        <bpmn:flowNodeRef>StartEvent_Call</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TakeOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Pg_Split1</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Kitchen" name="Kitchen">
        <bpmn:flowNodeRef>Task_SubmitOrderTicket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareMeal</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Sommelier" name="Sommelier">
        <bpmn:flowNodeRef>Gw_AlcoholicCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GiveOrderToSommelier</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Waiter" name="Waiter">
        <bpmn:flowNodeRef>Pg_Split2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_NonAlcoholicCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReadyCart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareNonAlcDrinks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Pg_Converge1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_AllReadyCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DeliverToGuest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReturnStation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DebitAccount</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Call" name="Guest Calls Room Service">
      <bpmn:outgoing>SequenceFlow_StartToManager</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Manager Tasks -->
    <bpmn:userTask id="Task_TakeOrder" name="Take Down Order">
      <bpmn:incoming>SequenceFlow_StartToManager</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ManagerToSplit1</bpmn:outgoing>
    </bpmn:userTask>

    <!-- First Parallel Gateway - Split to Kitchen, Sommelier, Waiter -->
    <bpmn:parallelGateway id="Pg_Split1" name="Start Concurrent Tasks">
      <bpmn:incoming>SequenceFlow_ManagerToSplit1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToKitchen</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ToSommelierCheck</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ToWaiterAssign</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Kitchen Path -->
    <bpmn:userTask id="Task_SubmitOrderTicket" name="Submit Order Ticket to Kitchen">
      <bpmn:incoming>SequenceFlow_ToKitchen</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_KitchenToPrepare</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:task id="Task_PrepareMeal" name="Prepare Meal">
      <bpmn:incoming>SequenceFlow_KitchenToPrepare</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MealReadyToConvergeAll</bpmn:outgoing>
    </bpmn:task>

    <!-- Sommelier Path with Alcoholic Decision -->
    <bpmn:userTask id="Task_GiveOrderToSommelier" name="Give Order to Sommelier">
      <bpmn:incoming>SequenceFlow_ToSommelierCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SommelierDoneToConvergeAll</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Decision for Alcoholic Beverages (80% of orders) -->
    <bpmn:exclusiveGateway id="Gw_AlcoholicCheck" name="Alcoholic Beverage Ordered?">
      <bpmn:incoming>SequenceFlow_ToSommelierCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_YesToSommelierTask</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Waiter Path -->
    <bpmn:userTask id="Task_ReadyCart" name="Ready Cart">
      <bpmn:incoming>SequenceFlow_ToWaiterAssign</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CartToNonAlcCheck</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Waiter Non-Alcoholic Decision -->
    <bpmn:exclusiveGateway id="Gw_NonAlcoholicCheck" name="Non-Alcoholic Drinks Ordered?">
      <bpmn:incoming>SequenceFlow_CartToNonAlcCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_YesPrepareDrinks</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Waiter Task for Non-Alcoholic Drinks -->
    <bpmn:userTask id="Task_PrepareNonAlcDrinks" name="Prepare Non-Alcoholic Drinks">
      <bpmn:incoming>SequenceFlow_YesPrepareDrinks</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DrinksReadyToConverge1</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Convergence Gateway 1 - Waiter Side -->
    <bpmn:parallelGateway id="Pg_Converge1" name="Waiter Tasks Complete">
      <bpmn:incoming>SequenceFlow_CartToConverge</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_DrinksReadyToConverge1</bpmn:incoming>
    </bpmn:parallelGateway>

    <!-- Convergence Gateway 2 - All Tasks Complete -->
    <bpmn:parallelGateway id="Pg_ConvergeAll" name="Food, Wine &amp; Cart Ready">
      <bpmn:incoming>SequenceFlow_MealReadyToConvergeAll</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_SommelierDoneToConvergeAll</bpmn:incoming>
    </bpmn:parallelGateway>

    <!-- Delivery Tasks -->
    <bpmn:userTask id="Task_DeliverToGuest" name="Deliver to Guest's Room">
      <bpmn:incoming>SequenceFlow_AllReadyToDelivery</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DeliveryReturn</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_ReturnStation" name="Return to Room-Service Station">
      <bpmn:incoming>SequenceFlow_DeliveryReturn</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReadyToDebit</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Billing Task -->
    <bpmn:userTask id="Task_DebitAccount" name="Debit Guest's Account">
      <bpmn:incoming>SequenceFlow_ReadyToDebit</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DebitToEnd</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Complete" name="Order Completed">
      <bpmn:incoming>SequenceFlow_DebitToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows - Manager Side -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToManager" sourceRef="StartEvent_Call" targetRef="Task_TakeOrder"/>
    <bpmn:sequenceFlow id="SequenceFlow_ManagerToSplit1" sourceRef="Task_TakeOrder" targetRef="Pg_Split1"/>

    <!-- Sequence Flows - Kitchen Side -->
    <bpmn:sequenceFlow id="SequenceFlow_ToKitchen" name="Submit Order Ticket to Kitchen" sourceRef="Pg_Split1" targetRef="Task_SubmitOrderTicket"/>
    <bpmn:sequenceFlow id="SequenceFlow_KitchenToPrepare" sourceRef="Task_SubmitOrderTicket" targetRef="Task_PrepareMeal"/>

    <!-- Sequence Flows - Sommelier Side -->
    <bpmn:sequenceFlow id="SequenceFlow_ToSommelierCheck" name="Give Order to Sommelier" sourceRef="Pg_Split1" targetRef="Gw_AlcoholicCheck"/>
    <bpmn:sequenceFlow id="SequenceFlow_YesToSommelierTask" name="Yes - Alcoholic Ordered" sourceRef="Gw_AlcoholicCheck" targetRef="Task_GiveOrderToSommelier"/>

    <!-- Sequence Flows - Waiter Side -->
    <bpmn:sequenceFlow id="SequenceFlow_ToWaiterAssign" name="Assign Order to Waiter" sourceRef="Pg_Split1" targetRef="Task_ReadyCart"/>
    <bpmn:sequenceFlow id="SequenceFlow_CartToNonAlcCheck" sourceRef="Task_ReadyCart" targetRef="Gw_NonAlcoholicCheck"/>

    <!-- Sequence Flows - Waiter Non-Alcoholic -->
    <bpmn:sequenceFlow id="SequenceFlow_YesPrepareDrinks" name="Yes - Drinks Ordered" sourceRef="Gw_NonAlcoholicCheck" targetRef="Task_PrepareNonAlcDrinks"/>

    <!-- Convergence Flow 1 (Waiter) -->
    <bpmn:sequenceFlow id="SequenceFlow_CartToConverge" sourceRef="Task_ReadyCart" targetRef="Pg_Converge1"/>
    <bpmn:sequenceFlow id="SequenceFlow_DrinksReadyToConverge1" name="Drinks Ready" sourceRef="Task_PrepareNonAlcDrinks" targetRef="Pg_Converge1"/>

    <!-- Convergence Flow 2 (All Tasks) -->
    <bpmn:sequenceFlow id="SequenceFlow_MealReadyToConvergeAll" name="Meal Prepared" sourceRef="Task_PrepareMeal" targetRef="Pg_ConvergeAll"/>
    <bpmn:sequenceFlow id="SequenceFlow_SommelierDoneToConvergeAll" name="Sommelier Tasks Complete" sourceRef="Task_GiveOrderToSommelier" targetRef="Pg_ConvergeAll"/>

    <!-- Delivery Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_AllReadyToDelivery" name="Food, Wine &amp; Cart Ready" sourceRef="Pg_ConvergeAll" targetRef="Task_DeliverToGuest"/>
    <bpmn:sequenceFlow id="SequenceFlow_DeliveryReturn" sourceRef="Task_DeliverToGuest" targetRef="Task_ReturnStation"/>

    <!-- Billing Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_ReadyToDebit" name="Billing Ready" sourceRef="Task_ReturnStation" targetRef="Task_DebitAccount"/>
    <bpmn:sequenceFlow id="SequenceFlow_DebitToEnd" sourceRef="Task_DebitAccount" targetRef="EndEvent_Complete"/>

  </bpmn:process>
</bpmn:definitions>