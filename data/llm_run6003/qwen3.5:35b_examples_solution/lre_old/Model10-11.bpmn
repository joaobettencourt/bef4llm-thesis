<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_GO" name="GO" processRef="Process_GO"/>
    <bpmn:participant id="Participant_MSP" name="MSP" processRef="Process_MSP"/>

    <!-- Message flows between pools -->
    <bpmn:messageFlow id="MessageFlow_1" sourceRef="Task_RequestMeasurement" targetRef="IntermediateCatchEvent_GO_CatchRequest">
      <bpmn:name>Send measurement request</bpmn:name>
    </bpmn:messageFlow>
    <bpmn:messageFlow id="MessageFlow_2" sourceRef="Task_InformFailure" targetRef="ExclusiveGateway_Decision_MSP"/>
    <bpmn:messageFlow id="MessageFlow_3" sourceRef="Task_TransmitMeasuredValues" targetRef="IntermediateCatchEvent_GO_CatchMeasurements">
      <bpmn:name>Transmit measured values</bpmn:name>
    </bpmn:messageFlow>
  </bpmn:collaboration>

  <!-- GO Process -->
  <bpmn:process id="Process_GO" isExecutable="false">
    <bpmn:startEvent id="StartEvent_GO_1" name="Request measurements">
      <bpmn:outgoing>SequenceFlow_GO_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_RequestMeasurement" name="Send measurement request to MSP">
      <bpmn:incoming>MessageFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GO_2</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_GO_CatchRequest" name="Wait for MSP response">
      <bpmn:incoming>MessageFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GO_3</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:userTask id="Task_ProcessMeasuredValues" name="Process measured values">
      <bpmn:incoming>MessageFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GO_4</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndEvent_GO_Success" name="Measurements transmitted to SP">
      <bpmn:incoming>MessageFlow_1</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="SequenceFlow_GO_1" sourceRef="StartEvent_GO_1" targetRef="Task_RequestMeasurement"/>
  </bpmn:process>

  <!-- MSP Process -->
  <bpmn:process id="Process_MSP" isExecutable="false">
    <bpmn:startEvent id="StartEvent_MSP_1" name="Receive measurement request">
      <bpmn:outgoing>SequenceFlow_MSP_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_CheckRequest" name="Check received request">
      <bpmn:incoming>MessageFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MSP_1</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="ExclusiveGateway_Decision" name="Deny or Perform?">
      <bpmn:incoming>MessageFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MSP_Deny</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_MSP_Perform</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Deny path -->
    <bpmn:userTask id="Task_InformFailure" name="Inform GO about failure of reading">
      <bpmn:incoming>MessageFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MSP_Deny_End</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Perform path -->
    <bpmn:userTask id="Task_PerformMeasurement" name="Perform measurement">
      <bpmn:incoming>MessageFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MSP_Transmit</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="SequenceFlow_MSP_1" sourceRef="StartEvent_MSP_1" targetRef="Task_CheckRequest"/>
  </bpmn:process>

  <!-- Message definitions -->
  <bpmn:message id="Message_RequestMeasurements"/>
</bpmn:definitions>