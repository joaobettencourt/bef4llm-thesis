<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_CustomerService" name="Customer Service (TELECO)" processRef="Process_CustomerService"/>
    <bpmn:participant id="Participant_ServiceManagement" name="Service Management" processRef="Process_ServiceManagement"/>
    <bpmn:participant id="Participant_ResourceProvisioning" name="Resource Provisioning" processRef="Process_ResourceProvisioning"/>
    <bpmn:participant id="Participant_BillingCollections" name="Billing &amp; Collections" processRef="Process_BillingCollections"/>
    <bpmn:participant id="Participant_Customer" name="Customer" processRef="Process_Customer"/>

    <!-- Message Flows -->
    <bpmn:messageFlow id="MessageFlow_CS_SM_DetailedReport" sourceRef="IntermediateThrow_CS_SendDetailedReport" targetRef="StartEvent_SM_DetailedReportReceived"/>
    <bpmn:messageFlow id="MessageFlow_CS_RestorationRequest" sourceRef="UserTask_CS_19" targetRef="StartEvent_RP_RequestReceived"/>
  </bpmn:collaboration>

  <!-- Global Messages -->
  <bpmn:message id="Message_ProblemParameters" name="Problem Parameters List"/>
  <bpmn:message id="Message_DetailedReport" name="Detailed Problem Report"/>
  <bpmn:message id="Message_ServicePerformance" name="Service Performance Data"/>
  <bpmn:message id="Message_ResolutionReport" name="Problem Resolution Report"/>
  <bpmn:message id="Message_RestorationRequest" name="Restoration Request"/>

  <!-- Customer Service Process -->
  <bpmn:process id="Process_CustomerService" isExecutable="false">
    <bpmn:startEvent id="StartEvent_CS_1" name="Perceive service degradation">
      <bpmn:outgoing>SequenceFlow_CS_01</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="UserTask_CS_02" name="Enter problem report into system T">
      <bpmn:incoming>SequenceFlow_CS_03</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CS_04</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="ExclusiveGateway_CS_Premium" name="Premium customer?">
      <bpmn:incoming>SequenceFlow_CS_05</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CS_06</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="EndEvent_CS_Premium" name="Link to extra problem fix process">
      <bpmn:incoming>SequenceFlow_CS_07</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:userTask id="UserTask_CS_08" name="Determine significance of customer">
      <bpmn:incoming>SequenceFlow_CS_09</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CS_10</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="ExclusiveGateway_CS_Significance" name="Significance affects counter measures?">
      <bpmn:incoming>SequenceFlow_CS_11</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CS_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="UserTask_CS_13" name="Re-prioritize counter measures">
      <bpmn:incoming>SequenceFlow_CS_14</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CS_09</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="UserTask_CS_15" name="Create detailed problem report">
      <bpmn:incoming>SequenceFlow_CS_16</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CS_17</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Intermediate Events -->
    <bpmn:intermediateThrowEvent id="IntermediateThrow_CS_SendDetailedReport" name="Send detailed problem report">
      <bpmn:incoming>SequenceFlow_CS_17</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CS_32</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <!-- Final status processing -->
    <bpmn:startEvent id="StartEvent_CS_FinalStatus" name="Receive final status from Service Management">
      <bpmn:outgoing>SequenceFlow_CS_20</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="UserTask_CS_18" name="Determine counter measures based on final report">
      <bpmn:incoming>SequenceFlow_CS_20</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CS_21</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="ExclusiveGateway_CS_Path" name="">
      <bpmn:incoming>SequenceFlow_CS_21</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CS_22</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CS_23</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CS_24</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Path 1: No problem -->
    <bpmn:userTask id="UserTask_CS_25" name="Send actual service performance to Customer Service">
      <bpmn:incoming>SequenceFlow_CS_22</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CS_26</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Path 2: Minor corrective actions -->
    <bpmn:userTask id="UserTask_CS_27" name="Undertake corrective actions (minor)">
      <bpmn:incoming>SequenceFlow_CS_23</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CS_28</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Path 3: Automatic restoration -->
    <bpmn:userTask id="UserTask_CS_19" name="Create request for automatic resource restoration">
      <bpmn:incoming>SequenceFlow_CS_24</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CS_30</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Receive trouble-shooting report -->
    <bpmn:startEvent id="StartEvent_CS_TroubleReport" name="Receive trouble-shooting report">
      <bpmn:outgoing>SequenceFlow_CS_31</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Parallel activities at end -->
    <bpmn:userTask id="UserTask_CS_29" name="Create customer report (performance &amp; resolution)">
      <bpmn:incoming>SequenceFlow_CS_31</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CS_40</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:parallelGateway id="ParallelGateway_CS_Start" name="">
      <bpmn:incoming>SequenceFlow_CS_31</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CS_40</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CS_41</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:userTask id="UserTask_CS_32" name="Report SLA violation rebate to Billing &amp; Collections">
      <bpmn:incoming>SequenceFlow_CS_39</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CS_41</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End events -->
    <bpmn:endEvent id="EndEvent_CS_SendReport" name="Send report to customer">
      <bpmn:incoming>SequenceFlow_CS_38</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:parallelGateway id="ParallelGateway_CS_End" name="">
      <bpmn:incoming>SequenceFlow_CS_40</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_CS_38</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CS_42</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_CS_01" sourceRef="StartEvent_CS_1" targetRef="UserTask_CS_02"/>
    <bpmn:sequenceFlow id="SequenceFlow_CS_03" name="" sourceRef="IntermediateThrow_CS_SendDetailedReport" targetRef="UserTask_CS_02"/>
    <bpmn:sequenceFlow id="SequenceFlow_CS_04" sourceRef="UserTask_CS_02" targetRef="ExclusiveGateway_CS_Premium"/>
    <bpmn:sequenceFlow id="SequenceFlow_CS_05" name="" sourceRef="UserTask_CS_15" targetRef="ExclusiveGateway_CS_Significance"/>
    <bpmn:sequenceFlow id="SequenceFlow_CS_06" name="Yes - Premium customer" sourceRef="ExclusiveGateway_CS_Premium" targetRef="EndEvent_CS_Premium"/>
    <bpmn:sequenceFlow id="SequenceFlow_CS_07" name="" sourceRef="UserTask_CS_15" targetRef="IntermediateThrow_CS_SendDetailedReport"/>
    <bpmn:sequenceFlow id="SequenceFlow_CS_09" name="" sourceRef="ExclusiveGateway_CS_Significance" targetRef="UserTask_CS_08"/>
    <bpmn:sequenceFlow id="SequenceFlow_CS_10" name="" sourceRef="UserTask_CS_08" targetRef="ExclusiveGateway_CS_Significance"/>
    <bpmn:sequenceFlow id="SequenceFlow_CS_11" name="" sourceRef="UserTask_CS_15" targetRef="ExclusiveGateway_CS_Significance"/>
    <bpmn:sequenceFlow id="SequenceFlow_CS_12" name="Yes - Re-prioritize" sourceRef="ExclusiveGateway_CS_Significance" targetRef="UserTask_CS_13"/>
    <bpmn:sequenceFlow id="SequenceFlow_CS_14" name="" sourceRef="UserTask_CS_13" targetRef="UserTask_CS_08"/>
    <bpmn:sequenceFlow id="SequenceFlow_CS_16" name="" sourceRef="ExclusiveGateway_CS_Significance" targetRef="UserTask_CS_15"/>
    <bpmn:sequenceFlow id="SequenceFlow_CS_20" sourceRef="StartEvent_CS_FinalStatus" targetRef="UserTask_CS_18"/>
    <bpmn:sequenceFlow id="SequenceFlow_CS_21" name="" sourceRef="UserTask_CS_18" targetRef="ExclusiveGateway_CS_Path"/>
    <bpmn:sequenceFlow id="SequenceFlow_CS_22" name="No problem detected" sourceRef="ExclusiveGateway_CS_Path" targetRef="UserTask_CS_25"/>
    <bpmn:sequenceFlow id="SequenceFlow_CS_23" name="Minor corrective actions required" sourceRef="ExclusiveGateway_CS_Path" targetRef="UserTask_CS_27"/>
    <bpmn:sequenceFlow id="SequenceFlow_CS_24" name="Automatic restoration required" sourceRef="ExclusiveGateway_CS_Path" targetRef="UserTask_CS_19"/>
    <bpmn:sequenceFlow id="SequenceFlow_CS_30" name="" sourceRef="UserTask_CS_19" targetRef="IntermediateThrow_CS_SendDetailedReport"/>

  </bpmn:process>

  <!-- Service Management Process -->
  <bpmn:process id="Process_ServiceManagement" isExecutable="false">
    <bpmn:startEvent id="StartEvent_SM_DetailedReportReceived" name="Receive detailed problem report from Customer Service">
      <bpmn:outgoing>SequenceFlow_SM_01</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="UserTask_SM_AnalyzeLevel" name="Investigate if analyzable at this level or Resource Provisioning">
      <bpmn:incoming>SequenceFlow_SM_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SM_02</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="ExclusiveGateway_SM_Analyzable" name="Analyzable here?">
      <bpmn:incoming>SequenceFlow_SM_03</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SM_04</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Not analyzable - send to Resource Provisioning -->
    <bpmn:endEvent id="EndEvent_SM_SendToRP" name="Send detailed problem report">
      <bpmn:incoming>SequenceFlow_SM_05</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Can analyze - perform analysis -->
    <bpmn:userTask id="UserTask_SM_PerformAnalysis" name="Perform problem analysis">
      <bpmn:incoming>SequenceFlow_SM_06</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SM_07</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Receive status from Resource Provisioning -->
    <bpmn:startEvent id="StartEvent_SM_StatusReceived" name="Receive status report from Resource Provisioning">
      <bpmn:outgoing>SequenceFlow_SM_08</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="UserTask_SM_PrepareFinalStatus" name="Prepare final status report">
      <bpmn:incoming>SequenceFlow_SM_10</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SM_11</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Determine counter measures -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_SM_CounterMeasures" name="">
      <bpmn:incoming>SequenceFlow_SM_12</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SM_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Path 1: No problem detected -->
    <bpmn:userTask id="UserTask_SM_SendPerformance" name="Send actual service performance to Customer Service">
      <bpmn:incoming>SequenceFlow_SM_14</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SM_15</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Path 2: Minor corrective actions -->
    <bpmn:userTask id="UserTask_SM_MinorActions" name="Undertake corrective actions">
      <bpmn:incoming>SequenceFlow_SM_16</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SM_17</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Path 3: Automatic restoration required -->
    <bpmn:startEvent id="StartEvent_SM_TroubleReportReceived" name="Receive trouble-shooting report">
      <bpmn:outgoing>SequenceFlow_SM_18</bpmn:outgoing>
    </bpmn:startEvent>

  </bpmn:process>

  <!-- Resource Provisioning Process -->
  <bpmn:process id="Process_ResourceProvisioning" isExecutable="false">
    <bpmn:startEvent id="StartEvent_RP_DetailedReportReceived" name="Receive detailed problem report from Service Management">
      <bpmn:outgoing>SequenceFlow_RP_01</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Check for possible problems -->
    <bpmn:userTask id="UserTask_RP_CheckProblems" name="Check if any possible problems exist">
      <bpmn:incoming>SequenceFlow_RP_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RP_02</bpmn:outgoing>
    </bpmn:userTask>

    <!-- No problem detected -->
    <bpmn:endEvent id="EndEvent_RP_NormalExecution" name="Create notification of normal service execution">
      <bpmn:incoming>SequenceFlow_RP_03</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Problem detected - analyze -->
    <bpmn:userTask id="UserTask_RP_AnalyzeProblem" name="Analyze problem causes in detail">
      <bpmn:incoming>SequenceFlow_RP_04</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RP_05</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Create trouble report -->
    <bpmn:endEvent id="EndEvent_RP_TroubleReport" name="Create trouble report">
      <bpmn:incoming>SequenceFlow_RP_06</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Receive restoration request (with 2-day timer) -->
    <bpmn:startEvent id="StartEvent_RP_OnHold" name="On-hold waiting for restoration request">
      <bpmn:outgoing>SequenceFlow_RP_07</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Timer event - 2 days -->
    <bpmn:intermediateCatchEvent id="IntermediateTimer_RP_TimeOut" name="">
      <bpmn:name>Wait for restoration request (max 2 days)</bpmn:name>
      <bpmn:incoming>SequenceFlow_RP_07</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RP_13</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Timer expired - terminate -->
    <bpmn:endEvent id="EndEvent_RP_TimeOut" name="Process terminated (2 days exceeded)">
      <bpmn:incoming>SequenceFlow_RP_13</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Receive restoration request -->
    <bpmn:startEvent id="StartEvent_RP_RequestReceived" name="Receive automatic resource restoration request">
      <bpmn:outgoing>SequenceFlow_RP_14</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Track errors -->
    <bpmn:userTask id="UserTask_RP_TrackErrors" name="Track all possible errors">
      <bpmn:incoming>SequenceFlow_RP_08</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RP_15</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Undertake corrective actions -->
    <bpmn:endEvent id="EndEvent_RP_CorrectiveActions" name="Undertake necessary corrective actions">
      <bpmn:incoming>SequenceFlow_RP_16</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Create trouble-shooting report -->
    <bpmn:userTask id="UserTask_RP_CreateTroubleShootingReport" name="Create trouble-shooting report">
      <bpmn:incoming>SequenceFlow_RP_17</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RP_20</bpmn:outgoing>
    </bpmn:userTask>

  </bpmn:process>

  <!-- Billing & Collections Process -->
  <bpmn:process id="Process_BillingCollections" isExecutable="false">
    <bpmn:startEvent id="StartEvent_BC_RebateReceived" name="Receive SLA violation rebate report from Customer Service">
      <bpmn:outgoing>SequenceFlow_BC_01</bpmn:outgoing>
    </bpmn:startEvent>

  </bpmn:process>

  <!-- Customer Process -->
  <bpmn:process id="Process_Customer" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Cust_ReportReceived" name="Receive report from Customer Service (performance &amp; resolution)">
      <bpmn:outgoing>SequenceFlow_Cust_01</bpmn:outgoing>
    </bpmn:startEvent>

  </bpmn:process>

</bpmn:definitions>