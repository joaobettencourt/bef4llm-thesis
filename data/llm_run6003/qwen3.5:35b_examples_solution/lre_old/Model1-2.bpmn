<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_CustomerCRS">
    <bpmn:participant id="Participant_Customer" name="Customer" processRef="Process_Customer"/>
    <bpmn:participant id="Participant_CRS" name="Computer Repair Service (CRS)" processRef="Process_CRS"/>
    
    <!-- Message flows between participants -->
    <bpmn:messageFlow id="MessageFlow_1bring_computer" sourceRef="Task_Customer_BringDefectiveComputer" targetRef="StartEvent_CRSCheckDefect"/>
    <bpmn:messageFlow id="MessageFlow_2cost_calculation" sourceRef="Task_CRS_ProvideCostCalculation" targetRef="Gateway_Customer_DecideOnRepair"/>
  </bpmn:collaboration>

  <!-- Customer Process -->
  <bpmn:process id="Process_Customer" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Customer_BringComputer">
      <bpmn:name>Customer arrives with defective computer</bpmn:name>
      <bpmn:outgoing>SequenceFlow_1BringDefectiveComputer</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_Customer_BringDefectiveComputer">
      <bpmn:name>Bring defective computer to CRS</bpmn:name>
      <bpmn:incoming>SequenceFlow_1BringDefectiveComputer</bpmn:incoming>
      <bpmn:outgoing>MessageFlow_1bring_computer</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_Customer_DecideOnRepair">
      <bpmn:name>Accept repair costs?</bpmn:name>
      <bpmn:incoming>MessageFlow_2cost_calculation</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AcceptCostsContinueProcess</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RejectCostsTakeHome</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_Customer_TakeComputerHome">
      <bpmn:name>Take computer home unrepaired</bpmn:name>
      <bpmn:incoming>SequenceFlow_RejectCostsTakeHome</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndCustomerProcess</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndEvent_Customer_TakeComputer">
      <bpmn:name>Computer taken home unrepaired</bpmn:name>
      <bpmn:incoming>SequenceFlow_EndCustomerProcess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="SequenceFlow_1BringDefectiveComputer" sourceRef="StartEvent_Customer_BringComputer" targetRef="Task_Customer_BringDefectiveComputer"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_AcceptCostsContinueProcess" name="Yes - Accept costs" sourceRef="Gateway_Customer_DecideOnRepair" targetRef="EndEvent_CRS_RepairFinished">
      <bpmn:name>Accept</bpmn:name>
    </bpmn:sequenceFlow>
    
    <bpmn:sequenceFlow id="SequenceFlow_RejectCostsTakeHome" name="No - Reject costs" sourceRef="Gateway_Customer_DecideOnRepair" targetRef="Task_Customer_TakeComputerHome">
      <bpmn:name>Reject</bpmn:name>
    </bpmn:sequenceFlow>
    
    <bpmn:sequenceFlow id="SequenceFlow_EndCustomerProcess" sourceRef="Task_Customer_TakeComputerHome" targetRef="EndEvent_Customer_TakeComputer"/>

  </bpmn:process>

  <!-- CRS Process -->
  <bpmn:process id="Process_CRS" isExecutable="false">
    <bpmn:startEvent id="StartEvent_CRSCheckDefect">
      <bpmn:name>Receive defective computer</bpmn:name>
      <bpmn:outgoing>SequenceFlow_1CheckDefectAndCalculateCosts</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Initial defect check and cost calculation -->
    <bpmn:userTask id="Task_CRS_CheckDefect">
      <bpmn:name>Check the defect on computer</bpmn:name>
      <bpmn:incoming>SequenceFlow_1CheckDefectAndCalculateCosts</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProvideCostCalculation</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_CRS_ProvideCostCalculation">
      <bpmn:name>Provide repair cost calculation to customer</bpmn:name>
      <bpmn:incoming>SequenceFlow_ProvideCostCalculation</bpmn:incoming>
      <bpmn:outgoing>MessageFlow_2cost_calculation</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Repair activities - parallel execution -->
    <bpmn:parallelGateway id="ParallelGateway_StartRepair">
      <bpmn:name>Start repair in arbitrary order</bpmn:name>
      <bpmn:incoming>SequenceFlow_2WaitForCustomerDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckAndRepairHardware</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CheckAndConfigureSoftware</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Hardware repair path -->
    <bpmn:userTask id="Task_CRS_HardwareRepair">
      <bpmn:name>Check and repair hardware</bpmn:name>
      <bpmn:incoming>SequenceFlow_CheckAndRepairHardware</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TestSystemFunctionality1</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Software repair path -->
    <bpmn:userTask id="Task_CRS_SoftwareRepair">
      <bpmn:name>Check and configure software</bpmn:name>
      <bpmn:incoming>SequenceFlow_CheckAndConfigureSoftware</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TestSystemFunctionality2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Testing after each activity -->
    <bpmn:userTask id="Task_CRS_TestAfterHardware">
      <bpmn:name>Test system functionality (after hardware)</bpmn:name>
      <bpmn:incoming>SequenceFlow_TestSystemFunctionality1</bpmn:incoming>
      <bpmn:outgoing>Gateway_Customer_DecideOnRepair2</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_CRS_TestAfterSoftware">
      <bpmn:name>Test system functionality (after software)</bpmn:name>
      <bpmn:incoming>SequenceFlow_TestSystemFunctionality2</bpmn:incoming>
      <bpmn:outgoing>Gateway_Customer_DecideOnRepair3</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Decision gateways for error detection -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_ErrorAfterHardware">
      <bpmn:name>Error detected?</bpmn:name>
      <bpmn:incoming>SequenceFlow_TestSystemFunctionality1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RetryRepairHardware</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoErrorContinueToSoftwareTest</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:exclusiveGateway id="ExclusiveGateway_ErrorAfterSoftware">
      <bpmn:name>Error detected?</bpmn:name>
      <bpmn:incoming>SequenceFlow_TestSystemFunctionality2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RetryRepairSoftware</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoErrorContinueToFinalTest</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Retry repair activities -->
    <bpmn:userTask id="Task_CRS_RetryHardware">
      <bpmn:name>Retry hardware repair (arbitrary)</bpmn:name>
      <bpmn:incoming>SequenceFlow_RetryRepairHardware</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TestSystemFunctionality1Again</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_CRS_RetrySoftware">
      <bpmn:name>Retry software repair (arbitrary)</bpmn:name>
      <bpmn:incoming>SequenceFlow_RetryRepairSoftware</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TestSystemFunctionality2Again</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Final test and completion -->
    <bpmn:parallelGateway id="ParallelGateway_MergeTests">
      <bpmn:name>Merge after testing</bpmn:name>
      <bpmn:incoming>SequenceFlow_NoErrorContinueToSoftwareTest</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_TestSystemFunctionality2Again</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FinalMergeGateway</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:userTask id="Task_CRS_FinalTest">
      <bpmn:name>Final system functionality test</bpmn:name>
      <bpmn:incoming>SequenceFlow_FinalMergeGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RepairFinished</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End events -->
    <bpmn:endEvent id="EndEvent_CRS_RepairFinished">
      <bpmn:name>Repair completed successfully</bpmn:name>
      <bpmn:incoming>SequenceFlow_RepairFinished</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="SequenceFlow_1CheckDefectAndCalculateCosts" sourceRef="StartEvent_CRSCheckDefect" targetRef="Task_CRS_CheckDefect"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ProvideCostCalculation" sourceRef="Task_CRS_CheckDefect" targetRef="Task_CRS_ProvideCostCalculation"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_2WaitForCustomerDecision" name="Accept costs - continue repair" sourceRef="Gateway_Customer_DecideOnRepair" targetRef="ParallelGateway_StartRepair">
      <bpmn:name>Yes</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Repair paths -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckAndRepairHardware" sourceRef="ParallelGateway_StartRepair" targetRef="Task_CRS_HardwareRepair"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_CheckAndConfigureSoftware" sourceRef="ParallelGateway_StartRepair" targetRef="Task_CRS_SoftwareRepair"/>

    <!-- Testing paths -->
    <bpmn:sequenceFlow id="SequenceFlow_TestSystemFunctionality1" name="Test after hardware repair" sourceRef="Task_CRS_HardwareRepair" targetRef="ExclusiveGateway_ErrorAfterHardware"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_TestSystemFunctionality2" name="Test after software repair" sourceRef="Task_CRS_SoftwareRepair" targetRef="ExclusiveGateway_ErrorAfterSoftware"/>

    <!-- Error handling paths -->
    <bpmn:sequenceFlow id="SequenceFlow_RetryRepairHardware" name="Error detected - retry hardware" sourceRef="ExclusiveGateway_ErrorAfterHardware" targetRef="Task_CRS_RetryHardware">
      <bpmn:name>Error</bpmn:name>
    </bpmn:sequenceFlow>
    
    <bpmn:sequenceFlow id="SequenceFlow_NoErrorContinueToSoftwareTest" name="No error - continue to software test" sourceRef="ExclusiveGateway_ErrorAfterHardware" targetRef="Task_CRS_TestAfterSoftware">
      <bpmn:name>No Error</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_RetryRepairSoftware" name="Error detected - retry software" sourceRef="ExclusiveGateway_ErrorAfterSoftware" targetRef="Task_CRS_RetrySoftware">
      <bpmn:name>Error</bpmn:name>
    </bpmn:sequenceFlow>
    
    <bpmn:sequenceFlow id="SequenceFlow_NoErrorContinueToFinalTest" name="No error - continue to final test" sourceRef="ExclusiveGateway_ErrorAfterSoftware" targetRef="ParallelGateway_MergeTests">
      <bpmn:name>No Error</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Retry paths -->
    <bpmn:sequenceFlow id="SequenceFlow_TestSystemFunctionality1Again" sourceRef="Task_CRS_RetryHardware" targetRef="ExclusiveGateway_ErrorAfterHardware"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_TestSystemFunctionality2Again" name="Test after retry software repair" sourceRef="Task_CRS_RetrySoftware" targetRef="ParallelGateway_MergeTests"/>

    <!-- Final merge and completion -->
    <bpmn:sequenceFlow id="SequenceFlow_FinalMergeGateway" sourceRef="ParallelGateway_MergeTests" targetRef="Task_CRS_FinalTest"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_RepairFinished" name="Repair completed successfully" sourceRef="Task_CRS_FinalTest" targetRef="EndEvent_CRS_RepairFinished">
      <bpmn:name>Success</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>