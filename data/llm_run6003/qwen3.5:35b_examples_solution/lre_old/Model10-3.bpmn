<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_MPOO_GO">
    <bpmn:participant id="Participant_MPOO" name="MPOO" processRef="Process_MPOO"/>
    <bpmn:participant id="Participant_GO" name="GO" processRef="Process_GO"/>
    <bpmn:messageFlow id="MessageFlow_DeregisterRequest">
      <bpmn:name>Deregistration Request</bpmn:name>
      <bpmn:sourceRef="Task_MPOO_Deregister" targetRef="StartEvent_Verify"/>
    </bpmn:messageFlow>
    <bpmn:messageFlow id="MessageFlow_Confirmation">
      <bpmn:name>Obligation Confirmation</bpmn:name>
      <bpmn:sourceRef="Task_GO_Obliged" targetRef="UserTask_MPOOConfirmContinuation"/>
    </bpmn:messageFlow>
  </bpmn:collaboration>

  <!-- GO Process -->
  <bpmn:process id="Process_GO" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Verify">
      <bpmn:name>Deregistration Received</bpmn:name>
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_Verify" name="Verify deregistration">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Decision</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_DeregistrationDecision">
      <bpmn:name>Deregistration Decision</bpmn:name>
      <bpmn:incoming>SequenceFlow_Decision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Reject</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_Confirm</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_Reject" name="Reject deregistration">
      <bpmn:incoming>SequenceFlow_Reject</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndRejected</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndEvent_Rejected">
      <bpmn:name>Deregistration Rejected</bpmn:name>
      <bpmn:incoming>SequenceFlow_EndRejected</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:userTask id="Task_Confirm" name="Preliminarily confirm deregistration">
      <bpmn:incoming>SequenceFlow_Confirm</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PrepareReadmission</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_Prepare" name="Prepare readmission of measuring point">
      <bpmn:incoming>SequenceFlow_PrepareReadmission</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ObligationDecision</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_Obliged">
      <bpmn:name>Oblige MPOO to continue?</bpmn:name>
      <bpmn:incoming>SequenceFlow_ObligationDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NoObliation</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_YesObligation</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_Obliged" name="Oblige MPOO to continue operations">
      <bpmn:incoming>SequenceFlow_YesObligation</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendConfirmationRequest</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndEvent_Obliged">
      <bpmn:name>Obligation Sent to MPOO</bpmn:name>
      <bpmn:incoming>SequenceFlow_SendConfirmationRequest</bpmn:outgoing>
    </bpmn:endEvent>

    <bpmn:userTask id="Task_EquipmentAcquisition" name="Equipment acquisition">
      <bpmn:incoming>SequenceFlow_NoObligation</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Merge1</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_EquipmentChanges" name="Equipment changes">
      <bpmn:incoming>SequenceFlow_NoObligation</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Merge2</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:parallelGateway id="Gateway_EquipmentMerge">
      <bpmn:name>Merge Equipment Tasks</bpmn:name>
      <bpmn:incoming>SequenceFlow_Merge1</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_Merge2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AssignMPO</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:userTask id="Task_EquipmentChangesOnly" name="Equipment changes only">
      <bpmn:incoming>SequenceFlow_NoObligation</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Merge2</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_AssignMPO" name="Assign GO as MPO">
      <bpmn:incoming>SequenceFlow_AssignMPO</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InformMPOO</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_InformMPOO" name="Inform MPOO about assignment">
      <bpmn:name>End of MPOO, beginning GO assignment</bpmn:name>
      <bpmn:incoming>SequenceFlow_InformMPOO</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeInform1</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_InformMSPO" name="Inform MSPO about assignment">
      <bpmn:name>Informs MSPO of GO assignment</bpmn:name>
      <bpmn:incoming>SequenceFlow_MergeInform1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeInform2</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_InformSP" name="Inform SP about assignment">
      <bpmn:name>Informs SP of GO assignment</bpmn:name>
      <bpmn:incoming>SequenceFlow_MergeInform2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndProcess</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndEvent_Completed">
      <bpmn:name>Deregistration Process Completed</bpmn:name>
      <bpmn:incoming>SequenceFlow_EndProcess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_Verify" targetRef="Task_Verify"/>
    <bpmn:sequenceFlow id="SequenceFlow_Decision" sourceRef="Task_Verify" targetRef="Gateway_DeregistrationDecision"/>

    <!-- Decision Paths -->
    <bpmn:sequenceFlow id="SequenceFlow_Reject" name="Reject" sourceRef="Gateway_DeregistrationDecision" targetRef="Task_Reject">
      <bpmn:name>reject</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_Confirm" name="Confirm" sourceRef="Gateway_DeregistrationDecision" targetRef="Task_Confirm">
      <bpmn:name>preliminarily confirm</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Post-confirmation flow -->
    <bpmn:sequenceFlow id="SequenceFlow_PrepareReadmission" sourceRef="Task_Confirm" targetRef="Task_Prepare"/>
    <bpmn:sequenceFlow id="SequenceFlow_ObligationDecision" sourceRef="Task_Prepare" targetRef="Gateway_Obliged"/>

    <!-- Obligation decision -->
    <bpmn:sequenceFlow id="SequenceFlow_NoObligation" name="No obligation" sourceRef="Gateway_Obliged" targetRef="Gateway_EquipmentMerge">
      <bpmn:name>no</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_YesObligation" name="With obligation" sourceRef="Gateway_Obliged" targetRef="Task_Obliged">
      <bpmn:name>yes</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Equipment tasks -->
    <bpmn:sequenceFlow id="SequenceFlow_NoObligationToEquipment" sourceRef="Gateway_EquipmentMerge" targetRef="Task_AssignMPO"/>
    
    <!-- Inform tasks -->
    <bpmn:sequenceFlow id="SequenceFlow_MergeInform1" sourceRef="Task_InformMSPO" targetRef="Task_InformSP"/>
    <bpmn:sequenceFlow id="SequenceFlow_EndProcess" sourceRef="Task_InformSP" targetRef="EndEvent_Completed"/>

  </bpmn:process>

  <!-- MPOO Process -->
  <bpmn:process id="Process_MPOO" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Deregister">
      <bpmn:name>Deregistration Request</bpmn:name>
      <bpmn:outgoing>SequenceFlow_StartDeregister</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="UserTask_Deregister" name="Request deregistration">
      <bpmn:incoming>SequenceFlow_StartDeregister</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendToGO</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Confirmation task for obligation -->
    <bpmn:userTask id="UserTask_MPOOConfirmContinuation" name="Confirm continuation">
      <bpmn:name>MPOO confirms the continuation to GO</bpmn:name>
      <bpmn:incoming>SequenceFlow_ReceiveConfirmationRequest</bpmn:incoming>
    </bpmn:userTask>

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartDeregister" sourceRef="StartEvent_Deregister" targetRef="UserTask_Deregister"/>
    <bpmn:sequenceFlow id="SequenceFlow_SendToGO" name="Send to GO" sourceRef="UserTask_Deregister">
      <bpmn:name>send</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>

</bpmn:definitions>