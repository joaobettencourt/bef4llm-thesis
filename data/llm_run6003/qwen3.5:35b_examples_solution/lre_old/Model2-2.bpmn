<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_CustomerService" name="Customer Service" processRef="Process_CustomerService"/>
    <bpmn:participant id="Participant_Customer" name="Customer" processRef="Process_Customer"/>
    <bpmn:participant id="Participant_GridOperator" name="Grid Operator" processRef="Process_GridOperator"/>
  </bpmn:collaboration>

  <!-- Customer Service Process -->
  <bpmn:process id="Process_CustomerService" isExecutable="false">
    <bpmn:startEvent id="StartMessage_1" name="Switch-over request received">
      <bpmn:messageRef>Message_SwitchOverRequest</bpmn:messageRef>
      <bpmn:outgoing>SequenceFlow_CS001</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_EnterCustomerData" name="Enter customer data into CRM">
      <bpmn:incoming>SequenceFlow_CS001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CS002</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_CheckDataCompleteness" name="Check data completeness and plausibility">
      <bpmn:incoming>SequenceFlow_CS002</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CS003</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_DataComplete" name="Data complete and plausible?">
      <bpmn:incoming>SequenceFlow_CS003</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CS004</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CS005</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_ErrorHandling" name="Correct errors based on error list">
      <bpmn:incoming>SequenceFlow_CS005</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CS002</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_CustomerExists" name="Customer in database?">
      <bpmn:incoming>SequenceFlow_CS004</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CS006</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CS007</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_CreateCustomer" name="Create new customer object">
      <bpmn:incoming>SequenceFlow_CS006</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CS008</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_ContractCheck" name="">
      <bpmn:incoming>SequenceFlow_CS007</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_CS008</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CS009</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_PrepareContracts" name="Prepare contract documents">
      <bpmn:incoming>SequenceFlow_CS009</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CS010</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="Service_CheckContracts" name="Automated check of contract documents (CIS)">
      <bpmn:incoming>SequenceFlow_CS010</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CS011</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_ContractValid" name="Contracts valid?">
      <bpmn:incoming>SequenceFlow_CS011</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CS012</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CS013</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_AnalyzeIssues" name="Analyze and resolve issues">
      <bpmn:incoming>SequenceFlow_CS012</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CS014</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:sequenceFlow id="SequenceFlow_CS014" sourceRef="Task_AnalyzeIssues" targetRef="Service_CheckContracts">
      <bpmn:name>Regenerate contracts</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:userTask id="Task_SendConfirmation" name="Send confirmation document to customer">
      <bpmn:incoming>SequenceFlow_CS013</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CS015</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:messageEvent id="Message_RequestGridOperator" name="Request supplier concurrence">
      <bpmn:incoming>SequenceFlow_CS015</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CS016</bpmn:outgoing>
    </bpmn:messageEvent>

    <bpmn:userTask id="Task_CheckGridResponse" name="Check grid operator response">
      <bpmn:incoming>SequenceFlow_CS016</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CS017</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_SupplierConcurrence" name="Supplier concurrence?">
      <bpmn:incoming>SequenceFlow_CS017</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CS018</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CS019</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_CreateCISContract" name="Create CIS contract">
      <bpmn:incoming>SequenceFlow_CS018</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CS020</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:messageEvent id="Message_SendSwitchOffer" name="Send switch offer to customer">
      <bpmn:incoming>SequenceFlow_CS019</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CS021</bpmn:outgoing>
    </bpmn:messageEvent>

    <bpmn:userTask id="Task_SendSwitchOffer" name="Send switch offer to customer">
      <bpmn:incoming>SequenceFlow_CS020</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CS019</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:eventBasedGateway id="Event_GatewayCustomerDecision" name="">
      <bpmn:incoming>SequenceFlow_CS021</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CS022</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CS023</bpmn:outgoing>
    </bpmn:eventBasedGateway>

    <bpmn:intermediateCatchEvent id="Timer_CustomerWithdrawal" name="Wait for withdrawal (7 days)">
      <bpmn:incoming>SequenceFlow_CS022</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CS024</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:messageEvent id="Message_CustomerWithdrawal" name="Customer withdrawal">
      <bpmn:incoming>SequenceFlow_CS023</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CS025</bpmn:outgoing>
    </bpmn:messageEvent>

    <bpmn:endEvent id="End_CustomerWithdrawal" name="Process ends (withdrawal)">
      <bpmn:incoming>SequenceFlow_CS025</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:exclusiveGateway id="Gateway_AutoAcceptance">
      <bpmn:incoming>SequenceFlow_CS024</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CS018</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Meter data handling -->
    <bpmn:messageEvent id="Message_MeterData" name="Receive meter data">
      <bpmn:incoming>SequenceFlow_CS026</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CS027</bpmn:outgoing>
    </bpmn:messageEvent>

    <bpmn:userTask id="Task_ImportMeterData" name="Import meter data to systems">
      <bpmn:incoming>SequenceFlow_CS026</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CS028</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="End_CustomerService" name="Process ends (meter data received)">
      <bpmn:incoming>SequenceFlow_CS027</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_CS001" sourceRef="StartMessage_1" targetRef="Task_EnterCustomerData"/>
    <bpmn:sequenceFlow id="SequenceFlow_CS002" sourceRef="Task_EnterCustomerData" targetRef="Task_CheckDataCompleteness"/>
    <bpmn:sequenceFlow id="SequenceFlow_CS003" sourceRef="Task_CheckDataCompleteness" targetRef="Gateway_DataComplete"/>
    <bpmn:sequenceFlow id="SequenceFlow_CS004" name="Yes - Complete and plausible" sourceRef="Gateway_DataComplete" targetRef="Gateway_CustomerExists"/>
    <bpmn:sequenceFlow id="SequenceFlow_CS005" name="No - Errors found" sourceRef="Gateway_DataComplete" targetRef="Task_ErrorHandling"/>
    <bpmn:sequenceFlow id="SequenceFlow_CS006" name="Yes - Customer exists" sourceRef="Gateway_CustomerExists" targetRef="Gateway_ContractCheck"/>
    <bpmn:sequenceFlow id="SequenceFlow_CS007" name="No - New customer" sourceRef="Gateway_CustomerExists" targetRef="Task_CreateCustomer"/>
    <bpmn:sequenceFlow id="SequenceFlow_CS008" sourceRef="Task_CreateCustomer" targetRef="Gateway_ContractCheck"/>
    <bpmn:sequenceFlow id="SequenceFlow_CS009" sourceRef="Gateway_ContractCheck" targetRef="Task_PrepareContracts"/>
    <bpmn:sequenceFlow id="SequenceFlow_CS010" sourceRef="Task_PrepareContracts" targetRef="Service_CheckContracts"/>
    <bpmn:sequenceFlow id="SequenceFlow_CS011" sourceRef="Service_CheckContracts" targetRef="Gateway_ContractValid"/>
    <bpmn:sequenceFlow id="SequenceFlow_CS012" name="No - Invalid contracts" sourceRef="Gateway_ContractValid" targetRef="Task_AnalyzeIssues"/>
    <bpmn:sequenceFlow id="SequenceFlow_CS013" name="Yes - Valid contracts" sourceRef="Gateway_ContractValid" targetRef="Task_SendConfirmation"/>
    <bpmn:sequenceFlow id="SequenceFlow_CS015" sourceRef="Task_SendConfirmation" targetRef="Message_RequestGridOperator">
      <bpmn:messageRef>Message_GridRequest</bpmn:messageRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_CS016" name="Receive grid response" sourceRef="Message_RequestGridOperator" targetRef="Task_CheckGridResponse">
      <bpmn:messageRef>Message_GridResponse</bpmn:messageRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_CS017" sourceRef="Task_CheckGridResponse" targetRef="Gateway_SupplierConcurrence"/>
    <bpmn:sequenceFlow id="SequenceFlow_CS018" name="No objections - Continue" sourceRef="Gateway_SupplierConcurrence" targetRef="Task_CreateCISContract"/>
    <bpmn:sequenceFlow id="SequenceFlow_CS019" name="Supplier concurrence found" sourceRef="Gateway_SupplierConcurrence" targetRef="Message_SendSwitchOffer">
      <bpmn:messageRef>Message_Confirmation</bpmn:messageRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_CS021" sourceRef="Task_SendSwitchOffer" targetRef="Event_GatewayCustomerDecision"/>
    <bpmn:sequenceFlow id="SequenceFlow_CS022" name="Wait for withdrawal (7 days)" sourceRef="Event_GatewayCustomerDecision" targetRef="Timer_CustomerWithdrawal">
      <bpmn:messageRef>Message_Withdrawal</bpmn:messageRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_CS023" name="Wait for confirmation/7 days timeout" sourceRef="Event_GatewayCustomerDecision" targetRef="Timer_CustomerWithdrawal"/>
    <bpmn:sequenceFlow id="SequenceFlow_CS024" name="After 7 days - Auto accept" sourceRef="Timer_CustomerWithdrawal" targetRef="Gateway_AutoAcceptance"/>
    <bpmn:sequenceFlow id="SequenceFlow_CS025" name="Customer withdraws within 7 days" sourceRef="Message_CustomerWithdrawal" targetRef="End_CustomerWithdrawal">
      <bpmn:messageRef>Message_Withdrawal</bpmn:messageRef>
    </bpmn:sequenceFlow>

    <!-- Meter data flow -->
    <bpmn:intermediateCatchEvent id="Timer_MeterDataTimeout" name="Wait for meter data (10 days)">
      <bpmn:incoming>SequenceFlow_CS028</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CS030</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:messageEvent id="Message_MeterDataReceived" name="Meter data received">
      <bpmn:incoming>SequenceFlow_CS029</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CS031</bpmn:outgoing>
    </bpmn:messageEvent>

    <bpmn:endEvent id="End_CustomerService_Meter" name="Process ends">
      <bpmn:incoming>SequenceFlow_CS029</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>

  <!-- Customer Process -->
  <bpmn:process id="Process_Customer" isExecutable="false">
    <bpmn:startMessageEvent id="StartCustomerRequest" name="Initiate switch-over request">
      <bpmn:messageRef>Message_SwitchOverRequest</bpmn:messageRef>
      <bpmn:outgoing>SequenceFlow_C01</bpmn:outgoing>
    </bpmn:startMessageEvent>

    <bpmn:userTask id="Customer_CheckContract" name="Check contract details">
      <bpmn:incoming>SequenceFlow_C02</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_C03</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndCustomerWithdraw" name="Process ends (withdrawal)">
      <bpmn:incoming>SequenceFlow_C04</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndCustomerConfirm" name="Process ends (confirmation)">
      <bpmn:incoming>SequenceFlow_C05</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_C01" sourceRef="StartCustomerRequest" targetRef="Task_CustomerDataTransmit">
      <bpmn:messageRef>Message_SwitchOverRequest</bpmn:messageRef>
    </bpmn:sequenceFlow>

    <bpmn:userTask id="Task_CustomerDataTransmit" name="Transmit customer data to Customer Service">
      <bpmn:incoming>SequenceFlow_C01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_C02</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:messageEvent id="Message_ContractOffer" name="Receive contract offer">
      <bpmn:incoming>SequenceFlow_C03</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_C04</bpmn:outgoing>
    </bpmn:messageEvent>

    <bpmn:userTask id="Customer_Decide" name="Decide on contract">
      <bpmn:incoming>Message_ContractOffer</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_C05</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_C06</bpmn:outgoing>
    </bpmn:userTask>

  </bpmn:process>

  <!-- Grid Operator Process -->
  <bpmn:process id="Process_GridOperator" isExecutable="false">
    <bpmn:startMessageEvent id="StartGridRequest" name="Receive supplier concurrence request">
      <bpmn:messageRef>Message_GridRequest</bpmn:messageRef>
      <bpmn:outgoing>SequenceFlow_G01</bpmn:outgoing>
    </bpmn:startMessageEvent>

    <bpmn:userTask id="Grid_CheckConcurrence" name="Check supplier concurrence">
      <bpmn:incoming>SequenceFlow_G01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_G02</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndGridConcurrence" name="Process ends (concurrence found)">
      <bpmn:incoming>SequenceFlow_G03</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndGridNoObjection" name="Process ends (no objection)">
      <bpmn:incoming>SequenceFlow_G04</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Meter data handling -->
    <bpmn:userTask id="Grid_ComputeBilling" name="Compute final billing">
      <bpmn:incoming>SequenceFlow_G05</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_G06</bpmn:outgoing>
    </bpmn:userTask>

  </bpmn:process>

  <!-- Message Definitions -->
  <bpmn:message id="Message_SwitchOverRequest" name="Switch-over request"/>
  <bpmn:message id="Message_GridRequest" name="Supplier concurrence request"/>
  <bpmn:message id="Message_GridResponse" name="Grid operator response comment"/>
  <bpmn:message id="Message_Confirmation" name="Confirmation document"/>
  <bpmn:message id="Message_Withdrawal" name="Customer withdrawal notification"/>
  <bpmn:message id="Message_MeterData" name="Meter data with consumption report"/>

</bpmn:definitions>