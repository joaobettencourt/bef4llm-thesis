<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_MSPN" name="MSPN" processRef="Process_MSPN"/>
    <bpmn:participant id="Participant_MSPO" name="MSPO" processRef="Process_MSPO"/>
    <bpmn:messageFlow id="MessageFlow_DismissalSent" sourceRef="Task_SendDismissal" targetRef="StartEvent_ReviewReceived">
      <bpmn:name>Send Dismissal</bpmn:name>
    </bpmn:messageFlow>
  </bpmn:collaboration>

  <bpmn:process id="Process_MSPN" isExecutable="false">
    <bpmn:startEvent id="StartEvent_DismissalInitiated" name="Dismissal Initiated">
      <bpmn:outgoing>SequenceFlow_SendDismissal</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_SendDismissal" name="Send Dismissal">
      <bpmn:incoming>SequenceFlow_SendDismissal</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Dispatched</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndEvent_MSPNComplete" name="Dismissal Sent">
      <bpmn:incoming>SequenceFlow_Dispatched</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow_SendDismissal" sourceRef="StartEvent_DismissalInitiated" targetRef="Task_SendDismissal"/>
    <bpmn:sequenceFlow id="SequenceFlow_Dispatched" sourceRef="Task_SendDismissal" targetRef="EndEvent_MSPNComplete"/>

  </bpmn:process>

  <bpmn:process id="Process_MSPO" isExecutable="false">
    <bpmn:startEvent id="StartEvent_ReviewReceived" name="Dismissal Received">
      <bpmn:messageRef>Message_Dismissal</bpmn:messageRef>
      <bpmn:outgoing>SequenceFlow_StartToReview</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_ReviewDismissal" name="Review Dismissal">
      <bpmn:incoming>SequenceFlow_StartToReview</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToGateway</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_Decision" name="Decision">
      <bpmn:incoming>SequenceFlow_ToGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RejectPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ConfirmPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_RejectDismissal" name="Reject Dismissal">
      <bpmn:name>Reject Dismissal of MSPN</bpmn:name>
      <bpmn:incoming>SequenceFlow_RejectPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RejectEnd</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_ConfirmDismissal" name="Confirm Dismissal">
      <bpmn:name>Confirm Dismissal of MSPN</bpmn:name>
      <bpmn:incoming>SequenceFlow_ConfirmPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConfirmEnd</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndEvent_Reject" name="Dismissal Rejected">
      <bpmn:incoming>SequenceFlow_RejectEnd</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_Confirm" name="Dismissal Confirmed">
      <bpmn:incoming>SequenceFlow_ConfirmEnd</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow_StartToReview" sourceRef="StartEvent_ReviewReceived" targetRef="Task_ReviewDismissal">
      <bpmn:name>Receive</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ToGateway" sourceRef="Task_ReviewDismissal" targetRef="Gateway_Decision"/>

    <bpmn:sequenceFlow id="SequenceFlow_RejectPath" name="Reject">
      <bpmn:name>Reject</bpmn:name>
      <bpmn:sourceRef>Gateway_Decision</bpmn:sourceRef>
      <bpmn:targetRef>Task_RejectDismissal</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ConfirmPath" name="Confirm">
      <bpmn:name>Confirm</bpmn:name>
      <bpmn:sourceRef>Gateway_Decision</bpmn:sourceRef>
      <bpmn:targetRef>Task_ConfirmDismissal</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_RejectEnd" sourceRef="Task_RejectDismissal" targetRef="EndEvent_Reject"/>

    <bpmn:sequenceFlow id="SequenceFlow_ConfirmEnd" sourceRef="Task_ConfirmDismissal" targetRef="EndEvent_Confirm"/>
  </bpmn:process>

  <bpmn:message id="Message_Dismissal">
    <bpmn:name>Dismissal Message</bpmn:name>
  </bpmn:message>
</bpmn:definitions>