<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_MPON" name="MPON" processRef="Process_MPON"/>
    <bpmn:participant id="Participant_MPOO" name="MPOO" processRef="Process_MPOO"/>
    <bpmn:participant id="Participant_GO" name="GO" processRef="Process_GO"/>
    
    <!-- Message Flows -->
    <bpmn:messageFlow id="MessageFlow_1">
      <bpmn:name>Equipment change notification</bpmn:name>
      <bpmn:sourceRef="Task_MPON_NotifyIntentions"/>
      <bpmn:targetRef="StartEvent_MPOO_EquipmentChange"/>
    </bpmn:messageFlow>
    
    <bpmn:messageFlow id="MessageFlow_2">
      <bpmn:name>Self-dismounting announcement</bpmn:name>
      <bpmn:sourceRef="Task_MPOO_AnnounceSelfDismount"/>
      <bpmn:targetRef="IntermediateCatchEvent_MPON_SelfDismountYes"/>
    </bpmn:messageFlow>
    
    <bpmn:messageFlow id="MessageFlow_3">
      <bpmn:name>No self-dismounting notification</bpmn:name>
      <bpmn:sourceRef="Task_MPOO_AnnounceNoDismount"/>
      <bpmn:targetRef="IntermediateCatchEvent_MPON_SelfDismountYes"/>
    </bpmn:messageFlow>
    
    <bpmn:messageFlow id="MessageFlow_4">
      <bpmn:name>Device change notification</bpmn:name>
      <bpmn:sourceRef="Task_GO_NotifyMSP"/>
      <bpmn:targetRef="StartEvent_MSP_DeviceChange"/>
    </bpmn:messageFlow>
  </bpmn:collaboration>

  <!-- MPON Process -->
  <bpmn:process id="Process_MPON" isExecutable="false">
    <bpmn:startEvent id="StartEvent_MPON_1" name="Equipment change initiated">
      <bpmn:outgoing>SequenceFlow_MPON_01</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_MPON_NotifyIntentions" name="Notify MPOO about equipment change intentions">
      <bpmn:incoming>SequenceFlow_MPON_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MPON_02</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_MPON_SelfDismountYes" name="Self-dismounting announcement">
      <bpmn:incoming>SequenceFlow_MPON_03</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MPON_04</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:userTask id="Task_MPON_FinalReading" name="Perform final reading">
      <bpmn:incoming>SequenceFlow_MPON_05</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MPON_06</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_MPON_DismountOld" name="Dismount old equipment">
      <bpmn:incoming>SequenceFlow_MPON_07</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MPON_08</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_MPON_MountNew" name="Mount new device">
      <bpmn:incoming>SequenceFlow_MPON_09</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MPON_10</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_MPON_ReadMeter" name="Read meter count from installed meter">
      <bpmn:incoming>SequenceFlow_MPON_10</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MPON_11</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_MPON_SendFinalReading" name="Send values of final reading to GO">
      <bpmn:incoming>SequenceFlow_MPON_12</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MPON_13</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_MPON_NotifyGO" name="Tell GO about device changes, master data and meter count at installation">
      <bpmn:incoming>SequenceFlow_MPON_13</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MPON_Final</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndEvent_MPON" name="Process completed">
      <bpmn:incoming>SequenceFlow_MPON_Final</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_MPON_01" sourceRef="StartEvent_MPON_1" targetRef="Task_MPON_NotifyIntentions"/>
    <bpmn:sequenceFlow id="SequenceFlow_MPON_02" sourceRef="Task_MPON_NotifyIntentions" targetRef="ExclusiveGateway_MPON_DecisionReading"/>

  </bpmn:process>

  <!-- MPOO Process -->
  <bpmn:process id="Process_MPOO" isExecutable="false">
    <bpmn:startEvent id="StartEvent_MPOO_EquipmentChange" name="Equipment change notification received">
      <bpmn:outgoing>SequenceFlow_MPOO_01</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_MPOO_DecideDismounting" name="Decide on self-dismounting">
      <bpmn:incoming>SequenceFlow_MPOO_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MPOO_02</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="ExclusiveGatewayMPOO_Dismount" name="Self-dismounting?">
      <bpmn:incoming>SequenceFlow_MPOO_03</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MPOO_04</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_MPOO_AnnounceSelfDismount" name="Announce self-dismounting to MPON">
      <bpmn:incoming>SequenceFlow_MPOO_04</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MPOO_Final1</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_MPOO_AnnounceNoDismount" name="Notify MPON about no self-dismounting">
      <bpmn:incoming>SequenceFlow_MPOO_05</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MPOO_Final2</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndEvent_MPOO" name="Process completed">
      <bpmn:incoming>SequenceFlow_MPOO_Final1</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_MPOO_Final2</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_MPOO_01" sourceRef="StartEvent_MPOO_EquipmentChange" targetRef="Task_MPOO_DecideDismounting"/>
    <bpmn:sequenceFlow id="SequenceFlow_MPOO_02" sourceRef="Task_MPOO_DecideDismounting" targetRef="ExclusiveGatewayMPOO_Dismount"/>

  </bpmn:process>

  <!-- GO Process -->
  <bpmn:process id="Process_GO" isExecutable="false">
    <bpmn:startEvent id="StartEvent_GO_DeviceChangeNotification" name="Device change notification received from MPON">
      <bpmn:outgoing>SequenceFlow_GO_01</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_GONotifyMSP" name="Notify MSP about device changes, master data and meter counts at dismounting/installation">
      <bpmn:incoming>SequenceFlow_GO_02</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GO_Final</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndEvent_GO" name="Process completed">
      <bpmn:incoming>SequenceFlow_GO_Final</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_GO_01" sourceRef="StartEvent_GO_DeviceChangeNotification" targetRef="Task_GONotifyMSP"/>

  </bpmn:process>

</bpmn:definitions>