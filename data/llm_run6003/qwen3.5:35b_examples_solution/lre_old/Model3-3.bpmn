<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                 xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" 
                 xmlns:di="http://www.omg.org/spec/DD/20100524/DI" 
                 xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" 
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
                 id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Claims Handling Process" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_ClaimsOfficer" name="Claims Officer">
        <bpmn:flowNodeRef>Task_RegisterClaim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExamineClaim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WriteRecommendation</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SeniorOfficer" name="Senior Claims Officer">
        <bpmn:flowNodeRef>Gateway_CheckClaim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckRecommendation</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="Start_NoneClaimRegistered" name="Claim Registered">
      <bpmn:outgoing>SequenceFlow_RegisterToExamine</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Register Claim (Claims Officer) -->
    <bpmn:userTask id="Task_RegisterClaim" name="Register Claim">
      <bpmn:incoming>SequenceFlow_InitialStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RegisterToExamine</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task 2: Examine Claim (Claims Officer) -->
    <bpmn:userTask id="Task_ExamineClaim" name="Examine Claim">
      <bpmn:incoming>SequenceFlow_RegisterToExamine</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ExamineToWriteRec</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task 3: Write Settlement Recommendation (Claims Officer) -->
    <bpmn:userTask id="Task_WriteRecommendation" name="Write Settlement Recommendation">
      <bpmn:incoming>SequenceFlow_ExamineToWriteRec</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RecToCheck</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task 4: Check Recommendation (Senior Claims Officer) -->
    <bpmn:userTask id="Task_CheckRecommendation" name="Check Recommendation">
      <bpmn:incoming>SequenceFlow_RecToCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckDecision</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway 1: Check if recommendation is OK -->
    <bpmn:exclusiveGateway id="Gateway_CheckClaim" name="Recommendation OK?">
      <bpmn:incoming>SequenceFlow_CheckDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OKToProceed</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NotOKLoopBack</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event -->
    <bpmn:endEvent id="End_ProcessProceeds" name="Process Proceeds">
      <bpmn:incoming>SequenceFlow_OKToProceed</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_InitialStart" sourceRef="Start_NoneClaimRegistered" targetRef="Task_RegisterClaim"/>
    <bpmn:sequenceFlow id="SequenceFlow_RegisterToExamine" name="After registration" sourceRef="Task_RegisterClaim" targetRef="Task_ExamineClaim"/>
    <bpmn:sequenceFlow id="SequenceFlow_ExamineToWriteRec" name="After examination" sourceRef="Task_ExamineClaim" targetRef="Task_WriteRecommendation"/>
    <bpmn:sequenceFlow id="SequenceFlow_RecToCheck" name="For review" sourceRef="Task_WriteRecommendation" targetRef="Task_CheckRecommendation"/>
    <bpmn:sequenceFlow id="SequenceFlow_CheckDecision" sourceRef="Task_CheckRecommendation" targetRef="Gateway_CheckClaim"/>

    <!-- OK path -->
    <bpmn:sequenceFlow id="SequenceFlow_OKToProceed" name="OK - Proceed with process" sourceRef="Gateway_CheckClaim" targetRef="End_ProcessProceeds">
      <bpmn:name>OK</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Not OK path (loop back) -->
    <bpmn:sequenceFlow id="SequenceFlow_NotOKLoopBack" name="Not OK - Repeat recommendation" sourceRef="Gateway_CheckClaim" targetRef="Task_ExamineClaim">
      <bpmn:name>Not OK</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>