<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Guest" name="Guest Process" processRef="Process_Guest"/>
    <bpmn:participant id="Participant_Employee" name="Employee Process" processRef="Process_Employee"/>
    <bpmn:participant id="Participant_Chef" name="Chef Process" processRef="Process_Chef"/>

    <!-- Message Flows -->
    <bpmn:messageFlow id="Message_Flow_Order" sourceRef="Task_Guest_PlaceOrder" targetRef="StartEvent_Employee_Received"/>
    <bpmn:messageFlow id="Message_Flow_ChefNotify" sourceRef="Task_Chef_InformEmployee" targetRef="IntermediateCatchEvent_Employee_MealReady"/>
  </bpmn:collaboration>

  <!-- Guest Process -->
  <bpmn:process id="Process_Guest" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Guest_Hunger" name="Hunger noticed">
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_Guest_EnterRestaurant" name="Enter restaurant">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_Guest_ChooseDish" name="Choose dish">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_Guest_WaitTurn" name="Wait for turn">
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:userTask id="Task_Guest_PlaceOrder" name="Place order">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_Guest_HearBuzzer" name="Hear buzzer">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:userTask id="Task_Guest_PickupMeal" name="Pick up meal">
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_Guest_EatMeal" name="Eat meal">
      <bpmn:incoming>SequenceFlow_7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_8</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndEvent_Guest_Done" name="Not hungry anymore">
      <bpmn:incoming>SequenceFlow_8</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_Guest_Hunger" targetRef="Task_Guest_EnterRestaurant"/>
    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="Task_Guest_EnterRestaurant" targetRef="Task_Guest_ChooseDish"/>
    <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="Task_Guest_ChooseDish" targetRef="IntermediateCatchEvent_Guest_WaitTurn"/>
    <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="IntermediateCatchEvent_Guest_WaitTurn" targetRef="Task_Guest_PlaceOrder"/>
    <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="Task_Guest_PlaceOrder" targetRef="IntermediateCatchEvent_Guest_HearBuzzer"/>
    <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="IntermediateCatchEvent_Guest_HearBuzzer" targetRef="Task_Guest_PickupMeal"/>
    <bpmn:sequenceFlow id="SequenceFlow_7" sourceRef="Task_Guest_PickupMeal" targetRef="Task_Guest_EatMeal"/>
    <bpmn:sequenceFlow id="SequenceFlow_8" sourceRef="Task_Guest_EatMeal" targetRef="EndEvent_Guest_Done"/>

  </bpmn:process>

  <!-- Employee Process -->
  <bpmn:process id="Process_Employee" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Employee_Received" name="Order received">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_9</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_Employee_EnterPOS" name="Enter order into POS system">
      <bpmn:incoming>SequenceFlow_9</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_Employee_CollectMoney" name="Collect money">
      <bpmn:incoming>SequenceFlow_10</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_11</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_Employee_SetBuzzer" name="Set up buzzer">
      <bpmn:incoming>SequenceFlow_11</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_12</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_Employee_PassBuzzer" name="Pass buzzer to guest">
      <bpmn:incoming>SequenceFlow_12</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_13</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_Employee_InformChef" name="Inform chef">
      <bpmn:incoming>SequenceFlow_13</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_26</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Wait for Meal Ready Notification -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_Employee_MealReady" name="Meal ready">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SequenceFlow_26</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_15</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:userTask id="Task_Employee_RingBuzzer" name="Set off buzzer">
      <bpmn:incoming>SequenceFlow_15</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_16</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Retry Logic -->
    <bpmn:eventBasedGateway id="EventBasedGateway_Employee_Retry">
      <bpmn:incoming>SequenceFlow_16</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_17</bpmn:outgoing> <!-- Wait Guest -->
      <bpmn:outgoing>SequenceFlow_20</bpmn:outgoing> <!-- Timer 5 mins -->
    </bpmn:eventBasedGateway>

    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_Employee_GuestAppears" name="Guest appears">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SequenceFlow_17</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_23</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:userTask id="Task_Employee_HandOverMeal" name="Hand over meal">
      <bpmn:incoming>SequenceFlow_23</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_24</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndEvent_Employee_Done" name="Order processed">
      <bpmn:incoming>SequenceFlow_24</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Timer Logic -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_Employee_Timer5Min" name="Wait 5 minutes">
      <bpmn:timerEventDefinition/>
      <bpmn:incoming>SequenceFlow_20</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_18</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:userTask id="Task_Employee_CallGuest" name="Call guest">
      <bpmn:incoming>SequenceFlow_18</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_25</bpmn:outgoing> <!-- Loop back -->
    </bpmn:userTask>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_9" sourceRef="StartEvent_Employee_Received" targetRef="Task_Employee_EnterPOS"/>
    <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="Task_Employee_EnterPOS" targetRef="Task_Employee_CollectMoney"/>
    <bpmn:sequenceFlow id="SequenceFlow_11" sourceRef="Task_Employee_CollectMoney" targetRef="Task_Employee_SetBuzzer"/>
    <bpmn:sequenceFlow id="SequenceFlow_12" sourceRef="Task_Employee_SetBuzzer" targetRef="Task_Employee_PassBuzzer"/>
    <bpmn:sequenceFlow id="SequenceFlow_13" sourceRef="Task_Employee_PassBuzzer" targetRef="Task_Employee_InformChef"/>
    
    <!-- Wait for Meal Ready (Message from Chef) -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_Employee_WaitMealReady" name="Wait meal ready">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SequenceFlow_26</bpmn:incoming> <!-- From Chef Notify -->
      <bpmn:outgoing>SequenceFlow_15</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:sequenceFlow id="SequenceFlow_14" sourceRef="Task_Employee_InformChef" targetRef="IntermediateCatchEvent_Employee_WaitMealReady"/> <!-- Simplified -->
    
    <bpmn:sequenceFlow id="SequenceFlow_15" sourceRef="IntermediateCatchEvent_Employee_MealReady" targetRef="Task_Employee_RingBuzzer"/> 
    <bpmn:sequenceFlow id="SequenceFlow_16" sourceRef="Task_Employee_RingBuzzer" targetRef="EventBasedGateway_Employee_Retry"/>
    
    <!-- Retry Loop -->
    <bpmn:sequenceFlow id="SequenceFlow_20" sourceRef="EventBasedGateway_Employee_Retry" targetRef="IntermediateCatchEvent_Employee_Timer5Min"/>
    <bpmn:sequenceFlow id="SequenceFlow_18" sourceRef="IntermediateCatchEvent_Employee_Timer5Min" targetRef="Task_Employee_CallGuest"/>
    <bpmn:sequenceFlow id="SequenceFlow_25" sourceRef="Task_Employee_CallGuest" targetRef="EventBasedGateway_Employee_Retry"/> <!-- Loop back -->

    <!-- Guest Appears Path -->
    <bpmn:sequenceFlow id="SequenceFlow_17" sourceRef="EventBasedGateway_Employee_Retry" targetRef="IntermediateCatchEvent_Employee_GuestAppears"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_23" sourceRef="IntermediateCatchEvent_Employee_GuestAppears" targetRef="Task_Employee_HandOverMeal"/>
    <bpmn:sequenceFlow id="SequenceFlow_24" sourceRef="Task_Employee_HandOverMeal" targetRef="EndEvent_Employee_Done"/>

  </bpmn:process>

  <!-- Chef Process -->
  <bpmn:process id="Process_Chef" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Chef_Needed" name="Meal needed">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_27</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_Chef_PrepareMeal" name="Prepare meal">
      <bpmn:incoming>SequenceFlow_27</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_28</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_Chef_PlaceHatch" name="Place in service hatch">
      <bpmn:incoming>SequenceFlow_28</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_29</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_Chef_InformEmployee" name="Inform employee">
      <bpmn:incoming>SequenceFlow_29</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_30</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndEvent_Chef_Done" name="Meal prepared">
      <bpmn:incoming>SequenceFlow_30</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_27" sourceRef="StartEvent_Chef_Needed" targetRef="Task_Chef_PrepareMeal"/>
    <bpmn:sequenceFlow id="SequenceFlow_28" sourceRef="Task_Chef_PrepareMeal" targetRef="Task_Chef_PlaceHatch"/>
    <bpmn:sequenceFlow id="SequenceFlow_29" sourceRef="Task_Chef_PlaceHatch" targetRef="Task_Chef_InformEmployee"/>
    <bpmn:sequenceFlow id="SequenceFlow_30" sourceRef="Task_Chef_InformEmployee" targetRef="EndEvent_Chef_Done"/>

  </bpmn:process>

</bpmn:definitions>