<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                 xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" 
                 xmlns:di="http://www.omg.org/spec/DD/20100524/DI" 
                 xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                 id="Definitions_ExaminationProcess_1" targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:collaboration id="Collaboration_Hospital_Process">
    <bpmn:participant id="Participant_Hospital" name="Hospital Examination Process" processRef="Process_Examination"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Examination" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="Start_PatientExamination" name="Patient Examination Requested">
      <bpmn:outgoing>Flow_StartToPhysician</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Outpatient Physician Tasks -->
    <bpmn:userTask id="Task_ExaminePatient" name="Examine Patient (Outpatient)">
      <bpmn:incoming>Flow_StartToPhysician</bpmn:incoming>
      <bpmn:outgoing>Flow_HealthDecision</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Decision Gateway 1 -->
    <bpmn:exclusiveGateway id="Gate_PatientHealthy" name="Patient Healthy?">
      <bpmn:incoming>Flow_HealthDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_HealthyPath</bpmn:outgoing>
      <bpmn:outgoing>Flow_AdditionalExamRequired</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Healthy Path -->
    <bpmn:userTask id="Task_FillExaminationForm" name="Fill Examination Form">
      <bpmn:incoming>Flow_HealthyPath</bpmn:incoming>
      <bpmn:outgoing>Flow_PatientRelease</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event 1 -->
    <bpmn:endEvent id="End_ReleasePatient" name="Patient Released">
      <bpmn:incoming>Flow_PatientRelease</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Additional Examination Path -->
    <bpmn:userTask id="Task_OrderExamTreatment" name="Order Exam &amp; Follow-up Treatment">
      <bpmn:incoming>Flow_AdditionalExamRequired</bpmn:incoming>
      <bpmn:outgoing>Flow_RequestFormFill</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Request Form -->
    <bpmn:userTask id="Task_FillRequestForm" name="Fill Request Form">
      <bpmn:incoming>Flow_RequestFormFill</bpmn:incoming>
      <bpmn:outgoing>Flow_InformRisks</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Inform Patient About Risks -->
    <bpmn:userTask id="Task_InformPatientRisks" name="Inform about Potential Risks">
      <bpmn:incoming>Flow_InformRisks</bpmn:incoming>
      <bpmn:outgoing>Flow_ConsentDecision</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Consent Decision Gateway -->
    <bpmn:exclusiveGateway id="Gate_PatientConsent" name="Patient Agrees?">
      <bpmn:incoming>Flow_ConsentDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_AppointmentArranged</bpmn:outgoing>
      <bpmn:outgoing>Flow_ProcessCancelledPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Appointment Arrangement -->
    <bpmn:userTask id="Task_ArrangeWardAppointment" name="Arrange Ward Appointment">
      <bpmn:incoming>Flow_AppointmentArranged</bpmn:incoming>
      <bpmn:outgoing>Flow_WardPreparationStart</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event 2 (if patient doesn't agree) -->
    <bpmn:endEvent id="End_ProcessCancelled" name="Process Cancelled">
      <bpmn:incoming>Flow_ProcessCancelledPath</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Ward Preparation Task -->
    <bpmn:userTask id="Task_WardPreparationExamSampling" name="Prepare Examination &amp; Sampling">
      <bpmn:incoming>Flow_WardPreparationStart</bpmn:incoming>
      <bpmn:outgoing>Flow_SampleAndTreatmentParallel</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel Gateway for Sample & Treatment -->
    <bpmn:parallelGateway id="Gate_WardSampleTreat" name="Ward Tasks">
      <bpmn:incoming>Flow_SampleAndTreatmentParallel</bpmn:incoming>
      <bpmn:outgoing>Flow_TakeSampleTask</bpmn:outgoing>
      <bpmn:outgoing>Flow_FollowUpTreatTask</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Ward Physician Tasks -->
    <bpmn:userTask id="Task_WardTakeSample" name="Ward Physician Takes Sample">
      <bpmn:incoming>Flow_TakeSampleTask</bpmn:incoming>
      <bpmn:outgoing>Flow_TakeSampleToLab</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_WardFollowUpTreatment" name="Ward Physician Follow-up Treatment">
      <bpmn:incoming>Flow_FollowUpTreatTask</bpmn:incoming>
      <bpmn:outgoing>Flow_FollowUpTreatToLab</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel Gateway Merge for Lab -->
    <bpmn:parallelGateway id="Gate_WardSampleMerge" name="Ward Tasks Complete">
      <bpmn:incoming>Flow_TakeSampleToLab</bpmn:incoming>
      <bpmn:incoming>Flow_FollowUpTreatToLab</bpmn:incoming>
      <bpmn:outgoing>Flow_SendToLabStart</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Lab Process -->
    <bpmn:userTask id="Task_LabValidateSample" name="Lab Physician Validates Sample">
      <bpmn:incoming>Flow_SampleValidationTask</bpmn:incoming>
      <bpmn:outgoing>Flow_SampleDecisionGate</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Lab Decision Gateway -->
    <bpmn:exclusiveGateway id="Gate_LabSampleOK" name="Sample OK?">
      <bpmn:incoming>Flow_SampleDecisionGate</bpmn:incoming>
      <bpmn:outgoing>Flow_AnalysisReadyForLab</bpmn:outgoing>
      <bpmn:outgoing>Flow_ContaminatedPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Contamination Loop -->
    <bpmn:userTask id="Task_LabNewSampleRequired" name="Request New Sample">
      <bpmn:incoming>Flow_ContaminatedPath</bpmn:incoming>
      <bpmn:outgoing>LoopBackToWardForSample</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Analysis Task -->
    <bpmn:userTask id="Task_LabAnalysis" name="Medical Technical Assistant Analyses Sample">
      <bpmn:incoming>Flow_AnalysisReadyForLab</bpmn:incoming>
      <bpmn:outgoing>Flow_ResultsValidationGate</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Results Validation -->
    <bpmn:userTask id="Task_LabValidateResults" name="Lab Physician Validates Results">
      <bpmn:incoming>Flow_ResultsValidationGate</bpmn:incoming>
      <bpmn:outgoing>Flow_DiagnosisPreparationFinal</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Final Diagnosis -->
    <bpmn:userTask id="Task_FinalDiagnosis" name="Outpatient Physician Makes Diagnosis &amp; Prescribes Therapy">
      <bpmn:incoming>Flow_DiagnosisPreparationFinal</bpmn:incoming>
      <bpmn:outgoing>Flow_ProcessComplete</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Final End Event -->
    <bpmn:endEvent id="End_Final" name="Diagnosis &amp; Therapy Prescribed">
      <bpmn:incoming>Flow_ProcessComplete</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows - Healthy Path -->
    <bpmn:sequenceFlow id="Flow_StartToPhysician" sourceRef="Start_PatientExamination" targetRef="Task_ExaminePatient"/>
    
    <!-- Decision 1 Flow -->
    <bpmn:sequenceFlow id="Flow_HealthDecision" name="" sourceRef="Task_ExaminePatient" targetRef="Gate_PatientHealthy"/>

    <!-- Healthy Path Flows -->
    <bpmn:sequenceFlow id="Flow_HealthyPath" name="Yes - Patient Healthy" sourceRef="Gate_PatientHealthy" targetRef="Task_FillExaminationForm"/>
    <bpmn:sequenceFlow id="Flow_PatientRelease" name="" sourceRef="Task_FillExaminationForm" targetRef="End_ReleasePatient"/>

    <!-- Additional Exam Path Flows -->
    <bpmn:sequenceFlow id="Flow_AdditionalExamRequired" name="No - Needs Examination" sourceRef="Gate_PatientHealthy" targetRef="Task_OrderExamTreatment"/>
    
    <!-- Request Form & Risks Flow -->
    <bpmn:sequenceFlow id="Flow_RequestFormFill" name="" sourceRef="Task_OrderExamTreatment" targetRef="Task_FillRequestForm"/>
    <bpmn:sequenceFlow id="Flow_InformRisks" name="" sourceRef="Task_FillRequestForm" targetRef="Task_InformPatientRisks"/>

    <!-- Consent Decision Flow -->
    <bpmn:sequenceFlow id="Flow_ConsentDecision" name="" sourceRef="Task_InformPatientRisks" targetRef="Gate_PatientConsent"/>
    
    <!-- Appointment Path Flows -->
    <bpmn:sequenceFlow id="Flow_AppointmentArranged" name="Yes - Agrees to Continue" sourceRef="Gate_PatientConsent" targetRef="Task_ArrangeWardAppointment"/>
    <bpmn:sequenceFlow id="Flow_ProcessCancelledPath" name="No - Patient Declines" sourceRef="Gate_PatientConsent" targetRef="End_ProcessCancelled"/>

    <!-- Ward Process Flows -->
    <bpmn:sequenceFlow id="Flow_WardPreparationStart" name="" sourceRef="Task_ArrangeWardAppointment" targetRef="Task_WardPreparationExamSampling"/>
    
    <!-- Sample Taking & Treatment (Parallel) Flow -->
    <bpmn:parallelGateway id="Gate_LabProcess">
      <bpmn:incoming>Flow_SendToLabStart</bpmn:incoming>
      <bpmn:outgoing>Flow_SampleValidationTask</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Lab Process Flows -->
    <bpmn:sequenceFlow id="Flow_TakeSampleToLab" name="" sourceRef="Task_WardTakeSample" targetRef="Gate_LabProcess"/>
    <bpmn:sequenceFlow id="Flow_FollowUpTreatToLab" name="" sourceRef="Task_WardFollowUpTreatment" targetRef="Gate_LabProcess"/>

    <!-- Lab Validation Flow -->
    <bpmn:parallelGateway id="Gate_SampleAndTreatmentMerge">
      <bpmn:incoming>Flow_TakeSampleToLab</bpmn:incoming>
      <bpmn:incoming>Flow_FollowUpTreatToLab</bpmn:incoming>
      <bpmn:outgoing>Flow_SendToLabStart</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Lab Decision Flow -->
    <bpmn:sequenceFlow id="Flow_SampleValidationTask" name="" sourceRef="Gate_LabProcess" targetRef="Task_LabValidateSample"/>
    
    <!-- Contamination Loop Flow -->
    <bpmn:sequenceFlow id="LoopBackToWardForSample" name="New Sample Required" sourceRef="Task_LabNewSampleRequired" targetRef="Task_WardTakeSample"/>

    <!-- Analysis Flow -->
    <bpmn:sequenceFlow id="Flow_AnalysisReadyForLab" name="" sourceRef="Gate_LabSampleOK" targetRef="Task_LabAnalysis"/>
    
    <!-- Results Validation Flow -->
    <bpmn:sequenceFlow id="Flow_ResultsValidationGate" name="" sourceRef="Task_LabAnalysis" targetRef="Task_LabValidateResults"/>

    <!-- Final Diagnosis Flow -->
    <bpmn:sequenceFlow id="Flow_DiagnosisPreparationFinal" name="" sourceRef="Task_LabValidateResults" targetRef="Task_FinalDiagnosis"/>

    <!-- Final End Flow -->
    <bpmn:sequenceFlow id="Flow_ProcessComplete" name="" sourceRef="Task_FinalDiagnosis" targetRef="End_Final"/>

  </bpmn:process>
</bpmn:definitions>