<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1irv4eg">
    <bpmn:participant id="Participant_1ff9e5d" name="Underwriter Process" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1x8oi4b" name="Company decides to go public">
      <bpmn:outgoing>SequenceFlow_StartToParallel</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Parallel Gateway after start -->
    <bpmn:parallelGateway id="ParallelGateway_0y1iqi8" name="Select Underwriters">
      <bpmn:incoming>SequenceFlow_StartToParallel</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckFacts</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PrepareRegistration</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 1: Check Facts Presented -->
    <bpmn:userTask id="Task_08320qz" name="Check if facts presented fairly">
      <bpmn:incoming>SequenceFlow_CheckFacts</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FactsToGateway</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Exclusive Gateway for Facts Check -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_1lqez4w" name="Facts Fair?">
      <bpmn:incoming>SequenceFlow_FactsToGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NoApproval</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_YesProceed</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event for Rejection -->
    <bpmn:endEvent id="EndEvent_Reject" name="Process Terminated">
      <bpmn:incoming>SequenceFlow_NoApproval</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Parallel Gateway 2 - Registration and Compliance (parallel tasks) -->
    <bpmn:parallelGateway id="ParallelGateway_RegCheck" name="Registration &amp; Laws">
      <bpmn:incoming>SequenceFlow_PrepareRegistration</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StatementTask</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_LawsCheck</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 2: Prepare Registration Statement -->
    <bpmn:userTask id="Task_Statement" name="Prepare registration statement for SEC approval">
      <bpmn:incoming>SequenceFlow_StatementTask</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StatementToConverge</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task 3: Check Compliance with Blue-Sky Laws -->
    <bpmn:userTask id="Task_Laws" name="Check compliance with blue-sky laws">
      <bpmn:incoming>SequenceFlow_LawsCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_LawsToConverge</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel Gateway - Convergence of Registration and Laws -->
    <bpmn:parallelGateway id="ParallelGateway_Converge" name="Registration Complete">
      <bpmn:incoming>SequenceFlow_StatementToConverge</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_LawsToConverge</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RoadShowStart</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 4: Road Show - Talk to Investors -->
    <bpmn:userTask id="Task_Roadshow" name="Arrange road show for potential investors">
      <bpmn:incoming>SequenceFlow_RoadShowStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitSEC</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Intermediate Catch Event - Wait for SEC Answer -->
    <bpmn:intermediateCatchEvent id="IntermediateCatch_SEC" name="Wait for SEC Approval">
      <bpmn:incoming>SequenceFlow_WaitSEC</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SECToGateway</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Exclusive Gateway - SEC Approval Decision -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_SEC" name="SEC Approved?">
      <bpmn:incoming>SequenceFlow_SECToGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NoApproval2</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_YesProceed2</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event for SEC Rejection -->
    <bpmn:endEvent id="EndEvent_SECReject" name="SEC Not Approved">
      <bpmn:incoming>SequenceFlow_NoApproval2</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task 5: Fix Issue Price (after SEC approval) -->
    <bpmn:userTask id="Task_Price" name="Fix issue price">
      <bpmn:incoming>SequenceFlow_YesProceed2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BuyStock</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task 6: Buy Stock (Firm Commitment) -->
    <bpmn:userTask id="Task_Buy" name="Enter firm commitment to buy stock">
      <bpmn:incoming>SequenceFlow_BuyStock</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OfferPublic</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task 7: Offer to Public -->
    <bpmn:userTask id="Task_Public" name="Offer stock to public">
      <bpmn:incoming>SequenceFlow_OfferPublic</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FinalEnd</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event - Process Complete -->
    <bpmn:endEvent id="EndEvent_Complete" name="Stock Successfully Offered">
      <bpmn:incoming>SequenceFlow_FinalEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToParallel" sourceRef="StartEvent_1x8oi4b" targetRef="ParallelGateway_0y1iqi8"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_CheckFacts" name="Check Facts Path" sourceRef="ParallelGateway_0y1iqi8" targetRef="Task_08320qz"/>
    <bpmn:sequenceFlow id="SequenceFlow_FactsToGateway" sourceRef="Task_08320qz" targetRef="ExclusiveGateway_1lqez4w"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_NoApproval" name="No - Facts Not Fair" sourceRef="ExclusiveGateway_1lqez4w" targetRef="EndEvent_Reject"/>
    <bpmn:sequenceFlow id="SequenceFlow_YesProceed" name="Yes - Proceed" sourceRef="ExclusiveGateway_1lqez4w" targetRef="ParallelGateway_RegCheck"/>

    <bpmn:sequenceFlow id="SequenceFlow_PrepareRegistration" name="Prepare &amp; Check Path" sourceRef="ParallelGateway_0y1iqi8" targetRef="ParallelGateway_RegCheck"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_StatementTask" sourceRef="ParallelGateway_RegCheck" targetRef="Task_Statement"/>
    <bpmn:sequenceFlow id="SequenceFlow_LawsCheck" sourceRef="ParallelGateway_RegCheck" targetRef="Task_Laws"/>

    <bpmn:sequenceFlow id="SequenceFlow_StatementToConverge" name="Registration Complete" sourceRef="Task_Statement" targetRef="ParallelGateway_Converge"/>
    <bpmn:sequenceFlow id="SequenceFlow_LawsToConverge" name="Laws Check Complete" sourceRef="Task_Laws" targetRef="ParallelGateway_Converge"/>

    <bpmn:sequenceFlow id="SequenceFlow_RoadShowStart" sourceRef="ParallelGateway_Converge" targetRef="Task_Roadshow"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_WaitSEC" name="Await SEC Approval" sourceRef="Task_Roadshow" targetRef="IntermediateCatch_SEC"/>

    <bpmn:sequenceFlow id="SequenceFlow_SECToGateway" sourceRef="IntermediateCatch_SEC" targetRef="ExclusiveGateway_SEC"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_NoApproval2" name="No - Not Approved" sourceRef="ExclusiveGateway_SEC" targetRef="EndEvent_SECReject"/>
    <bpmn:sequenceFlow id="SequenceFlow_YesProceed2" name="Yes - Approved" sourceRef="ExclusiveGateway_SEC" targetRef="Task_Price"/>

    <bpmn:sequenceFlow id="SequenceFlow_BuyStock" sourceRef="Task_Price" targetRef="Task_Buy"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_OfferPublic" name="Offer to Public" sourceRef="Task_Buy" targetRef="Task_Public"/>

    <bpmn:sequenceFlow id="SequenceFlow_FinalEnd" sourceRef="Task_Public" targetRef="EndEvent_Complete"/>
  </bpmn:process>
</bpmn:definitions>