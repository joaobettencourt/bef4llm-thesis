<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1kp8vzq7xw3f2r5y4h6t9u1l">
    <bpmn:participant id="Participant_0pymj5d" name="R&E Court Process" processRef="Process_1cqwerym"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1cqwerym" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_MailProcessingUnit" name="Mail Processing Unit">
        <bpmn:flowNodeRef>StartEvent_DailyCollection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CollectMail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SortUnopenedMail</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Registry" name="Registry">
        <bpmn:flowNodeRef>Task_OpenAndSortMail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegisterInIncomingRegister</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_QualityCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ComplianceDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CaptureMatterDetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareResponseEnvelope</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Cashier" name="Cashier">
        <bpmn:flowNodeRef>Gateway_ParallelSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProcessFeesAndCaptureDetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrintPhysicalCourtFile</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_RejectionPath" name="Rejection Handling">
        <bpmn:flowNodeRef>Task_CompileRequisitionList</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event with Timer for Daily Collection -->
    <bpmn:startEvent id="StartEvent_DailyCollection">
      <bpmn:name>Daily Mail Collection</bpmn:name>
      <bpmn:outgoing>SequenceFlow_CollectMail</bpmn:outgoing>
      <bpmn:timerEventDefinition />
    </bpmn:startEvent>

    <!-- Task: Collect mail -->
    <bpmn:userTask id="Task_CollectMail">
      <bpmn:name>Collect Mail from Party</bpmn:name>
      <bpmn:incoming>SequenceFlow_CollectMail</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SortUnopened</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Sort unopened mail -->
    <bpmn:userTask id="Task_SortUnopenedMail">
      <bpmn:name>Sort Unopened Mail into Business Areas</bpmn:name>
      <bpmn:incoming>SequenceFlow_SortUnopened</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DistributeToRegistry</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Open and sort mail in Registry -->
    <bpmn:userTask id="Task_OpenAndSortMail">
      <bpmn:name>Open Mail and Sort into Groups for Distribution</bpmn:name>
      <bpmn:incoming>SequenceFlow_DistributeToRegistry</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RegisterIncoming</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Register in manual incoming Mail Register -->
    <bpmn:userTask id="Task_RegisterInIncomingRegister">
      <bpmn:name>Register in Manual Incoming Mail Register</bpmn:name>
      <bpmn:incoming>SequenceFlow_RegisterIncoming</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_QualityCheck</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Quality Check by Assistant Registry Manager -->
    <bpmn:userTask id="Task_QualityCheck">
      <bpmn:name>Perform Quality Check on Mail</bpmn:name>
      <bpmn:incoming>SequenceFlow_QualityCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ComplianceDecision</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Exclusive Gateway for Compliance Decision -->
    <bpmn:exclusiveGateway id="Gateway_ComplianceDecision">
      <bpmn:name>Mail Compliant?</bpmn:name>
      <bpmn:incoming>SequenceFlow_ComplianceDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RejectionPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ApprovalPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Compile Requisition List (Rejection Path) -->
    <bpmn:userTask id="Task_CompileRequisitionList">
      <bpmn:name>Compile List of Requisitions Explaining Reason for Rejection</bpmn:name>
      <bpmn:incoming>SequenceFlow_RejectionPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendBackToParty</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Capture Matter Details (Approval Path) -->
    <bpmn:userTask id="Task_CaptureMatterDetails">
      <bpmn:name>Capture Matter Details and Types of Action</bpmn:name>
      <bpmn:incoming>SequenceFlow_ApprovalPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProvideToCashier</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel Gateway for Concurrent Activities -->
    <bpmn:parallelGateway id="Gateway_ParallelSplit">
      <bpmn:name>Concurrent Processing Split</bpmn:name>
      <bpmn:incoming>SequenceFlow_ProvideToCashier</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProcessFeesAndDetails</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PrepareResponseEnvelope</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Process Fees and Capture Party Details -->
    <bpmn:userTask id="Task_ProcessFeesAndCaptureDetails">
      <bpmn:name>Capture Party Details and Take Applicable Fees Attached to Mail</bpmn:name>
      <bpmn:incoming>SequenceFlow_ProcessFeesAndDetails</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PrintPhysicalFile</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Print Physical Court File -->
    <bpmn:userTask id="Task_PrintPhysicalCourtFile">
      <bpmn:name>Print Physical Court File</bpmn:name>
      <bpmn:incoming>SequenceFlow_PrintPhysicalFile</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeProcessEnds</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Prepare Response Envelope -->
    <bpmn:userTask id="Task_PrepareResponseEnvelope">
      <bpmn:name>Put Receipt and Copied Documents into Envelope and Post to Party</bpmn:name>
      <bpmn:incoming>SequenceFlow_PrepareResponseEnvelope</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeProcessEnds</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel Gateway for Merging Concurrent Paths -->
    <bpmn:parallelGateway id="Gateway_ParallelMerge">
      <bpmn:name>Concurrent Processing Merge</bpmn:name>
      <bpmn:incoming>SequenceFlow_PrintPhysicalFile</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProcessComplete</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- End Event for Rejection Path -->
    <bpmn:endEvent id="EndEvent_Rejected">
      <bpmn:name>Mail Rejected - Sent Back to Party</bpmn:name>
      <bpmn:incoming>SequenceFlow_SendBackToParty</bpmn:incoming>
    </bpmn:endEvent>

    <!-- End Event for Successful Completion -->
    <bpmn:endEvent id="EndEvent_Completed">
      <bpmn:name>Process Completed Successfully</bpmn:name>
      <bpmn:incoming>SequenceFlow_ProcessComplete</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_CollectMail" sourceRef="StartEvent_DailyCollection" targetRef="Task_CollectMail">
      <bpmn:name>Daily Collection</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_SortUnopened" sourceRef="Task_CollectMail" targetRef="Task_SortUnopenedMail">
      <bpmn:name>Sort Mail</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_DistributeToRegistry" sourceRef="Task_SortUnopenedMail" targetRef="Task_OpenAndSortMail">
      <bpmn:name>Distribute to Registry</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_RegisterIncoming" sourceRef="Task_OpenAndSortMail" targetRef="Task_RegisterInIncomingRegister">
      <bpmn:name>Open and Sort Mail</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_QualityCheck" sourceRef="Task_RegisterInIncomingRegister" targetRef="Task_QualityCheck">
      <bpmn:name>Quality Check Required</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ComplianceDecision" sourceRef="Task_QualityCheck" targetRef="Gateway_ComplianceDecision">
      <bpmn:name>Perform Quality Check</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_RejectionPath" name="No - Not Compliant" sourceRef="Gateway_ComplianceDecision" targetRef="Task_CompileRequisitionList">
      <bpmn:name>No</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ApprovalPath" name="Yes - Compliant" sourceRef="Gateway_ComplianceDecision" targetRef="Task_CaptureMatterDetails">
      <bpmn:name>Yes</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_SendBackToParty" name="Send Rejection to Party" sourceRef="Task_CompileRequisitionList" targetRef="EndEvent_Rejected">
      <bpmn:name>Compile and Send Back</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ProvideToCashier" sourceRef="Task_CaptureMatterDetails" targetRef="Gateway_ParallelSplit">
      <bpmn:name>Cashier Processing Required</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ProcessFeesAndDetails" sourceRef="Gateway_ParallelSplit" targetRef="Task_ProcessFeesAndCaptureDetails">
      <bpmn:name>Cashier Path</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_PrepareResponseEnvelope" sourceRef="Gateway_ParallelSplit" targetRef="Task_PrepareResponseEnvelope">
      <bpmn:name>Registry Response Path</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_PrintPhysicalFile" sourceRef="Task_ProcessFeesAndCaptureDetails" targetRef="Gateway_ParallelMerge">
      <bpmn:name>Court File Printed</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_MergeProcessEnds" sourceRef="Task_PrepareResponseEnvelope" targetRef="Gateway_ParallelMerge">
      <bpmn:name>Enveloped and Posted</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ProcessComplete" sourceRef="Gateway_ParallelMerge" targetRef="EndEvent_Completed">
      <bpmn:name>All Processing Complete</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>