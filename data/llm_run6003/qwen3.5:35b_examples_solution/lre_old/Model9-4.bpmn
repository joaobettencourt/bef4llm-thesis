<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1a2b3c4d5e6f7g8h9i0j">
    <bpmn:participant id="Participant_1" name="Committee Meeting Process" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_CoordinationUnit" name="Coordination Unit">
        <bpmn:flowNodeRef>Task_QACheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateCatchEvent_QATimer</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SupportOfficer" name="Support Officer">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateCalendars</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateMeetingFolders</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UploadDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateThrowEvent_AdviseMembers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProduceMinutes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_QAResults</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Dates finalized">
      <bpmn:outgoing>SequenceFlow_StartToCalendars</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Support Officer Tasks -->
    <bpmn:userTask id="Task_UpdateCalendars" name="Update group calendars">
      <bpmn:incoming>SequenceFlow_StartToCalendars</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CalendarsToFolders</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_CreateMeetingFolders" name="Create meeting folders">
      <bpmn:incoming>SequenceFlow_CalendarsToFolders</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FoldersToDocuments</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_UploadDocuments" name="Ensure documents uploaded to system">
      <bpmn:incoming>SequenceFlow_FoldersToDocuments</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DocumentsToAdvise</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Intermediate Throw Event - Advise members 1 week before meeting -->
    <bpmn:intermediateThrowEvent id="IntermediateThrowEvent_AdviseMembers" name="Advises Committee Members (1 week before)">
      <bpmn:incoming>SequenceFlow_DocumentsToAdvise</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AdviseToMeeting</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <!-- Committee Members Meeting Task -->
    <bpmn:userTask id="Task_CommitteeMembersMeet" name="Committee Members hold meeting">
      <bpmn:incoming>SequenceFlow_AdviseToMeeting</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MeetingToMinutes</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Support Officer - Produce Minutes -->
    <bpmn:userTask id="Task_ProduceMinutes" name="Produce minutes with Action Points">
      <bpmn:incoming>SequenceFlow_MeetingToMinutes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MinutesToQA</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Coordination Unit - QA Check Timer -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_QATimer" name="5 working days">
      <bpmn:incoming>SequenceFlow_MinutesToQA</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_QAtoGateway</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- QA Check Task -->
    <bpmn:userTask id="Task_QACheck" name="Conduct QA check on minutes">
      <bpmn:incoming>SequenceFlow_QAtoGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_QAToGateway</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway for QA Results -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_QAResults" name="QA Passed?">
      <bpmn:incoming>SequenceFlow_QAToGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PassToSendMinutes</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Send Minutes to Members -->
    <bpmn:userTask id="Task_SendMinutes" name="Send minutes to Committee Members">
      <bpmn:incoming>SequenceFlow_PassToSendMinutes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendToUpdateRecords</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Update Departmental Records -->
    <bpmn:userTask id="Task_UpdateDepartmentalRecords" name="Update departmental records">
      <bpmn:incoming>SequenceFlow_SendToUpdateRecords</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RecordsToEnd</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_1" name="Process Complete">
      <bpmn:incoming>SequenceFlow_RecordsToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToCalendars" sourceRef="StartEvent_1" targetRef="Task_UpdateCalendars"/>
    <bpmn:sequenceFlow id="SequenceFlow_CalendarsToFolders" sourceRef="Task_UpdateCalendars" targetRef="Task_CreateMeetingFolders"/>
    <bpmn:sequenceFlow id="SequenceFlow_FoldersToDocuments" sourceRef="Task_CreateMeetingFolders" targetRef="Task_UploadDocuments"/>
    <bpmn:sequenceFlow id="SequenceFlow_DocumentsToAdvise" sourceRef="Task_UploadDocuments" targetRef="IntermediateThrowEvent_AdviseMembers"/>
    <bpmn:sequenceFlow id="SequenceFlow_AdviseToMeeting" name="1 week before meeting" sourceRef="IntermediateThrowEvent_AdviseMembers" targetRef="Task_CommitteeMembersMeet"/>
    <bpmn:sequenceFlow id="SequenceFlow_MeetingToMinutes" sourceRef="Task_CommitteeMembersMeet" targetRef="Task_ProduceMinutes"/>
    <bpmn:sequenceFlow id="SequenceFlow_MinutesToQA" name="Within 5 working days" sourceRef="Task_ProduceMinutes" targetRef="IntermediateCatchEvent_QATimer"/>
    <bpmn:sequenceFlow id="SequenceFlow_QAtoGateway" sourceRef="IntermediateCatchEvent_QATimer" targetRef="Task_QACheck"/>
    <bpmn:sequenceFlow id="SequenceFlow_QAToGateway" name="QA check completed" sourceRef="Task_QACheck" targetRef="ExclusiveGateway_QAResults"/>
    <bpmn:sequenceFlow id="SequenceFlow_PassToSendMinutes" name="Yes - QA Passed" sourceRef="ExclusiveGateway_QAResults" targetRef="Task_SendMinutes"/>
    <bpmn:sequenceFlow id="SequenceFlow_SendToUpdateRecords" sourceRef="Task_SendMinutes" targetRef="Task_UpdateDepartmentalRecords"/>
    <bpmn:sequenceFlow id="SequenceFlow_RecordsToEnd" name="Process Complete" sourceRef="Task_UpdateDepartmentalRecords" targetRef="EndEvent_1"/>

  </bpmn:process>
</bpmn:definitions>