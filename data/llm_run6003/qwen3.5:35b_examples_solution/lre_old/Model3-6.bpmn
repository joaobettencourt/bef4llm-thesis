<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1cqwerym" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_ClaimsProcess">
    <bpmn:participant id="Participant_ClaimsProcess" name="Claims Notification Process" processRef="Process_ClaimHandling"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_ClaimHandling" isExecutable="true">
    
    <!-- Start Event -->
    <bpmn:startEvent id="StartClaimReceived" name="Claim Received">
      <bpmn:outgoing>SequenceFlow_CheckInsurance</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Check Insurance Status -->
    <bpmn:userTask id="Task_CheckInsurance" name="Check if claimant is insured">
      <bpmn:incoming>SequenceFlow_CheckInsurance</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InsuredDecision</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway: Insured Decision -->
    <bpmn:exclusiveGateway id="Gateway_IsInsured" name="Is claimant insured?">
      <bpmn:incoming>SequenceFlow_InsuredDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RejectClaim</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_EvaluateSeverity</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Reject Claim -->
    <bpmn:userTask id="Task_RejectClaim" name="Inform claimant that claim must be rejected">
      <bpmn:incoming>SequenceFlow_RejectClaim</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndRejected</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event for Rejected Claims -->
    <bpmn:endEvent id="End_Rejected" name="Claim Rejected">
      <bpmn:incoming>SequenceFlow_EndRejected</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task: Evaluate Severity -->
    <bpmn:userTask id="Task_EvaluateSeverity" name="Evaluate severity of claim">
      <bpmn:incoming>SequenceFlow_EvaluateSeverity</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SeverityDecision</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway: Severity Decision -->
    <bpmn:exclusiveGateway id="Gateway_Severity" name="Simple or Complex claim?">
      <bpmn:incoming>SequenceFlow_SeverityDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendForms</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Send Forms -->
    <bpmn:userTask id="Task_SendForms" name="Send relevant forms to claimant">
      <bpmn:incoming>SequenceFlow_SendForms</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckCompleteness</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Check Completeness -->
    <bpmn:userTask id="Task_CheckCompleteness" name="Check forms for completeness">
      <bpmn:incoming>SequenceFlow_CheckCompleteness</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CompletenessDecision</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway: Completeness Decision -->
    <bpmn:exclusiveGateway id="Gateway_IsComplete" name="Forms complete?">
      <bpmn:incoming>SequenceFlow_CompletenessDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RegisterClaim</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_InformUpdate</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Register Claim -->
    <bpmn:userTask id="Task_RegisterClaim" name="Register claim in Claims Management system">
      <bpmn:incoming>SequenceFlow_RegisterClaim</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndCompleted</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event for Completed Claims -->
    <bpmn:endEvent id="End_Completed" name="Claims Notification Process Ended">
      <bpmn:incoming>SequenceFlow_EndCompleted</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task: Inform to Update Forms -->
    <bpmn:userTask id="Task_InformUpdate" name="Inform claimant to update forms">
      <bpmn:incoming>SequenceFlow_InformUpdate</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckCompletenessAgain</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckInsurance" name="Claim received" sourceRef="StartClaimReceived" targetRef="Task_CheckInsurance"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_InsuredDecision" name="Not insured" sourceRef="Gateway_IsInsured" targetRef="Task_RejectClaim">
      <bpmn:name>Not insured</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_EvaluateSeverity" name="Is insured" sourceRef="Gateway_IsInsured" targetRef="Task_EvaluateSeverity"/>

    <bpmn:sequenceFlow id="SequenceFlow_EndRejected" name="" sourceRef="Task_RejectClaim" targetRef="End_Rejected"/>

    <bpmn:sequenceFlow id="SequenceFlow_SeverityDecision" name="Severity evaluated" sourceRef="Task_EvaluateSeverity" targetRef="Gateway_Severity"/>

    <bpmn:sequenceFlow id="SequenceFlow_SendForms" name="Sends relevant forms" sourceRef="Gateway_Severity" targetRef="Task_SendForms"/>

    <bpmn:sequenceFlow id="SequenceFlow_CheckCompleteness" name="Form returned" sourceRef="Task_SendForms" targetRef="Task_CheckCompleteness"/>

    <bpmn:sequenceFlow id="SequenceFlow_CompletenessDecision" name="Forms checked" sourceRef="Task_CheckCompleteness" targetRef="Gateway_IsComplete"/>

    <bpmn:sequenceFlow id="SequenceFlow_RegisterClaim" name="All details provided" sourceRef="Gateway_IsComplete" targetRef="Task_RegisterClaim"/>

    <bpmn:sequenceFlow id="SequenceFlow_EndCompleted" name="" sourceRef="Task_RegisterClaim" targetRef="End_Completed"/>

    <bpmn:sequenceFlow id="SequenceFlow_InformUpdate" name="Forms incomplete" sourceRef="Gateway_IsComplete" targetRef="Task_InformUpdate"/>

    <bpmn:sequenceFlow id="SequenceFlow_CheckCompletenessAgain" name="Updated forms received" sourceRef="Task_InformUpdate" targetRef="Task_CheckCompleteness"/>

  </bpmn:process>
</bpmn:definitions>