```xml
<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Claims Process" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Clerk" name="Clerk">
        <bpmn:flowNodeRef>StartEvent_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SearchPoliceReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ComposeFile</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ClaimsHandler" name="Claims Handler">
        <bpmn:flowNodeRef>Task_CalculateEstimate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateActionPlan</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ClaimsManager" name="Claims Manager">
        <bpmn:flowNodeRef>Task_NegotiateSettlement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyClaimant</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_0" name="Process initiated">
      <bpmn:outgoing>SequenceFlow_SearchPoliceReport</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_SearchPoliceReport" name="Search police report database">
      <bpmn:incoming>SequenceFlow_SearchPoliceReport</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ComposeFile</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_ComposeFile" name="Compose file with Claim Documentation">
      <bpmn:incoming>SequenceFlow_ComposeFile</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CalculateEstimate</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_CalculateEstimate" name="Calculate initial claim estimate">
      <bpmn:incoming>SequenceFlow_CalculateEstimate</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CreateActionPlan</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_CreateActionPlan" name="Create Action Plan based on checklist">
      <bpmn:incoming>SequenceFlow_CreateActionPlan</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NegotiateSettlement</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_NegotiateSettlement" name="Negotiate settlement on claim estimate">
      <bpmn:incoming>SequenceFlow_NegotiateSettlement</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NotifyClaimant</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_NotifyClaimant" name="Inform claimant of outcome">
      <bpmn:incoming>SequenceFlow_NotifyClaimant</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndProcess</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndEvent_0" name="Process completed">
      <bpmn:incoming>SequenceFlow_EndProcess</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:dataObjectReference id="Data_PoliceReportDatabase" name="Police Report Database"/>
    <bpmn:dataObjectReference id="Data_ClaimDocumentation" name="Claim Documentation"/>
    <bpmn:dataObjectReference id="Data_ActionPlanChecklist" name="Action Plan Checklist"/>

    <bpmn:association id="Assoc_PoliceReportDatabase">
      <bpmn:sourceRef>Data_PoliceReportDatabase</bpmn:sourceRef>
      <bpmn:targetRef>Task_SearchPoliceReport</bpmn:targetRef>
    </bpmn:association>

    <bpmn:association id="Assoc_ClaimDocumentation">
      <bpmn:sourceRef>Data_ClaimDocumentation</bpmn:sourceRef>
      <bpmn:targetRef>Task_ComposeFile</bpmn:targetRef>
    </bpmn:association>

    <bpmn:association id="Assoc_ActionPlanChecklist">
      <bpmn:sourceRef>Data_ActionPlanChecklist</bpmn:sourceRef>
      <bpmn:targetRef>Task_CreateActionPlan</bpmn:targetRef>
    </bpmn:association>

    <bpmn:dataObjectReference id="Data_ComposedFile" name="Composed File"/>
    <bpmn:association id="Assoc_ComposedFile">
      <bpmn:sourceRef>Data_ComposedFile</bpmn:sourceRef>
      <bpmn:targetRef>Task_CalculateEstimate</bpmn:targetRef>
    </bpmn:association>

    <bpmn:dataObjectReference id="Data_ActionPlan" name="Action Plan"/>
    <bpmn:association id="Assoc_ActionPlan">
      <bpmn:sourceRef>Data_ActionPlan</bpmn:sourceRef>
      <bpmn:targetRef>Task_NegotiateSettlement</bpmn:targetRef>
    </bpmn:association>

    <bpmn:dataObjectReference id="Data_ClaimEstimate" name="Claim Estimate"/>
    <bpmn:association id="Assoc_ClaimEstimate">
      <bpmn:sourceRef>Data_ClaimEstimate</bpmn:sourceRef>
      <bpmn:targetRef>Task_CalculateEstimate</bpmn:targetRef>
    </bpmn:association>

    <bpmn:dataObjectReference id="Data_Outcome" name="Outcome"/>
    <bpmn:association id="Assoc_Outcome">
      <bpmn:sourceRef>Data_Outcome</bpmn:sourceRef>
      <bpmn:targetRef>Task_NotifyClaimant</bpmn:targetRef>
    </bpmn:association>

    <bpmn:dataObjectReference id="Data_Claim" name="Claim"/>
    <bpmn:association id="Assoc_Claim">
      <bpmn:sourceRef>Data_Claim</bpmn:sourceRef>
      <bpmn:targetRef>Task_NegotiateSettlement</bpmn:targetRef>
    </bpmn:association>

    <bpmn:dataObjectReference id="Data_DocumentManagementSystem" name="Document Management System"/>
    <bpmn:association id="Assoc_DMS">
      <bpmn:sourceRef>Data_DocumentManagementSystem</bpmn:sourceRef>
      <bpmn:targetRef>Task_Create