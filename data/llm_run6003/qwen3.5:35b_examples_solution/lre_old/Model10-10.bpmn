<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                 xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" 
                 xmlns:di="http://www.omg.org/spec/DD/20100524/DI" 
                 xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:collaboration id="Collaboration_FaultDetection">
    <bpmn:participant id="Participant_UserProcess" name="User Process" processRef="Process_1"/>
    <bpmn:participant id="Participant_FaultDetector" name="Fault Detector" processRef="Process_2"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_UserTasks" name="User Tasks">
        <bpmn:flowNodeRef>StartEvent_FailureReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_ExamineFailure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_DecisionPoint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_RejectFailure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_ConfirmFailure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_InformCustomerManager_Failure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_FixFault</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_ShareResultsWithDetector</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_InformCustomer_Resolution</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_InformManager_Resolution</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_FailureReport" name="Failure Report / Suspicion">
      <bpmn:outgoing>SequenceFlow_ExamineFailure</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="UserTask_ExamineFailure" name="Examine Failure">
      <bpmn:incoming>SequenceFlow_ExamineFailure</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DecisionPoint</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="ExclusiveGateway_DecisionPoint" name="Confirm Failure?">
      <bpmn:incoming>SequenceFlow_ExamineFailure</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RejectPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ConfirmPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="UserTask_RejectFailure" name="Reject Failure Report">
      <bpmn:incoming>SequenceFlow_ExamineFailure</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndRejected</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndRejected" name="Failure Rejected">
      <bpmn:incoming>SequenceFlow_RejectPath</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:userTask id="UserTask_ConfirmFailure" name="Confirm Failure Report">
      <bpmn:incoming>SequenceFlow_ExamineFailure</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InformCustomerManager_Failure</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="UserTask_InformCustomerManager_Failure" name="Inform Customer &amp; Manager of Failure">
      <bpmn:incoming>SequenceFlow_ConfirmPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FixFault</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="UserTask_FixFault" name="Fix Fault at Measuring Device">
      <bpmn:incoming>SequenceFlow_InformCustomerManager_Failure</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ShareResultsWithDetector</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="UserTask_ShareResultsWithDetector" name="Share Repair Results with Fault Detector">
      <bpmn:incoming>SequenceFlow_FixFault</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InformCustomer_Resolution</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="UserTask_InformCustomer_Resolution" name="Inform Customer of Resolution">
      <bpmn:incoming>SequenceFlow_ShareResultsWithDetector</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InformManager_Resolution</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="UserTask_InformManager_Resolution" name="Inform Manager of Resolution">
      <bpmn:incoming>SequenceFlow_InformCustomer_Resolution</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndCompleted</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndCompleted" name="Resolution Completed">
      <bpmn:incoming>SequenceFlow_InformManager_Resolution</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow_ExamineFailure" sourceRef="StartEvent_FailureReport" targetRef="UserTask_ExamineFailure"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_DecisionPoint" name="Examination Complete" sourceRef="UserTask_ExamineFailure" targetRef="ExclusiveGateway_DecisionPoint"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_RejectPath" name="Reject Failure" sourceRef="ExclusiveGateway_DecisionPoint" targetRef="EndRejected">
      <bpmn:name>Reject</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ConfirmPath" name="Confirm Failure" sourceRef="ExclusiveGateway_DecisionPoint" targetRef="UserTask_ConfirmFailure">
      <bpmn:name>Confirm</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_InformCustomerManager_Failure" name="Inform about Failure" sourceRef="ExclusiveGateway_DecisionPoint" targetRef="UserTask_ConfirmFailure"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_FixFault" name="Fix Fault" sourceRef="UserTask_ConfirmFailure" targetRef="UserTask_InformCustomerManager_Failure">
      <bpmn:name>Confirm</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ShareResultsWithDetector" name="Share Results with Detector" sourceRef="UserTask_FixFault" targetRef="UserTask_ShareResultsWithDetector"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_InformCustomer_Resolution" name="Inform Customer of Resolution" sourceRef="UserTask_ShareResultsWithDetector" targetRef="UserTask_InformCustomer_Resolution">
      <bpmn:name>Share Results</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_EndRejected" name="End Rejected Path" sourceRef="UserTask_RejectFailure" targetRef="EndRejected"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_InformManager_Resolution" name="Inform Manager of Resolution" sourceRef="UserTask_InformCustomer_Resolution" targetRef="UserTask_InformManager_Resolution">
      <bpmn:name>Share Results</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>

  <!-- Fault Detector Process -->
  <bpmn:process id="Process_2" isExecutable="false">
    <bpmn:startEvent id="Start_FaultDetector" name="Fault Detected">
      <bpmn:outgoing>SequenceFlow_ReportFailure</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Intermediate event for receiving failure report -->
    <bpmn:intermediateCatchEvent id="IntermediateMessage_Catching_FailureReport" name="Receive Failure Report">
      <bpmn:messageRef>MessageFailureReport</bpmn:messageRef>
      <bpmn:incoming>SequenceFlow_ReportFailure</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ProcessFaultDetection</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Receive repair results -->
    <bpmn:intermediateCatchEvent id="IntermediateMessage_Catching_Results" name="Receive Repair Results">
      <bpmn:messageRef>MessageRepairResults</bpmn:messageRef>
      <bpmn:incoming>SequenceFlow_ShareResultsWithDetector</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_EndFaultDetection</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- End event -->
    <bpmn:endEvent id="End_FaultDetection" name="Process Complete">
      <bpmn:incoming>SequenceFlow_ProcessFaultDetection</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_EndFaultDetection</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="SequenceFlow_ReportFailure" sourceRef="Start_FaultDetector" targetRef="IntermediateMessage_Catching_FailureReport"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ProcessFaultDetection" name="Process Fault Detection" sourceRef="IntermediateMessage_Catching_FailureReport" targetRef="End_FaultDetection">
      <bpmn:name>Complete</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>

  <!-- Message flows between participants -->
  <bpmn:message id="MessageFailureReport" name="Failure Report"/>
  
  <bpmn:message id="MessageRepairResults" name="Repair Results"/>

</bpmn:definitions>