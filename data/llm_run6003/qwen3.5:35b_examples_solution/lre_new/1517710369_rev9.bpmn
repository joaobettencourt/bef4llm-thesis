<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_CreditCardAddition">
    <bpmn:participant id="Participant_UserProcess" name="User Process&#10;" processRef="Process_AddCreditCard" />
    <bpmn:participant id="Participant_Authority" name="Credit Card Authority&#10;">
      <bpmn:processRef="Process_ExternalVerification" />
    </bpmn:participant>
    <bpmn:messageFlow id="MessageFlow_VerifyCard" sourceRef="IntermediateThrowEvent_VerifyRequest" targetRef="Participant_Authority" />
    <bpmn:messageFlow id="MessageFlow_ResultReceived" sourceRef="Participant_Authority" targetRef="IntermediateCatchEvent_VerificationResult" />
  </bpmn:collaboration>

  <bpmn:process id="Process_AddCreditCard" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Choose Credit Card Payment&#10;">
      <bpmn:outgoing>SequenceFlow_StartToEnterDetails</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:endEvent id="EndEvent_SuccessfulAddition" name="Credit card added successfully">
      <bpmn:incoming>SequenceFlow_AddCardSuccess</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_Cancellation" name="Addition cancelled&#10;">
      <bpmn:incoming>SequenceFlow_CancelledInvalid</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:task id="Task_EnterCardDetails" name="Enter credit card details">
      <bpmn:incoming>SequenceFlow_StartToEnterDetails</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_DetailsToCheckAddress</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_CheckBillingAddress" name="Check billing address is correct">
      <bpmn:incoming>SequenceFlow_DetailsToCheckAddress</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AddressChecked</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_BillingCorrect" name="Billing address correct?">
      <bpmn:incoming>SequenceFlow_AddressChecked</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ModifyAddress</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ContinueToClick</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_ModifyBillingAddress" name="Modify billing address">
      <bpmn:incoming>SequenceFlow_ModifyAddress</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RecheckAddress</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_RecheckBilling" name="">
      <bpmn:incoming>SequenceFlow_RecheckAddress</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AddressCheckedLoopBack</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_ClickContinue" name="Click Continue button">
      <bpmn:incoming>SequenceFlow_ContinueToClick</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToVerifyRequest</bpmn:outgoing>
    </bpmn:task>

    <bpmn:intermediateThrowEvent id="IntermediateThrowEvent_VerifyRequest" name="Send verification request">
      <bpmn:incoming>SequenceFlow_ToVerifyRequest</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>

    <bpmn:exclusiveGateway id="Gateway_VerificationResult" name="Card validated?">
      <bpmn:incoming>SequenceFlow_CheckVerification</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AddCardSuccess</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CancelledInvalid</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_CheckVerificationResult" name="Check Credit Card Authority Response">
      <bpmn:incoming>SequenceFlow_ReceiveResult</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckVerification</bpmn:outgoing>
    </bpmn:task>

    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_VerificationResult" name="Receive verification result">
      <bpmn:messageEventDefinition />
      <bpmn:incoming>SequenceFlow_ResultReceived</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReceiveResult</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToEnterDetails" sourceRef="StartEvent_1" targetRef="Task_EnterCardDetails" />
    <bpmn:sequenceFlow id="SequenceFlow_DetailsToCheckAddress" sourceRef="Task_EnterCardDetails" targetRef="Task_CheckBillingAddress" />
    <bpmn:sequenceFlow id="SequenceFlow_AddressChecked" sourceRef="Task_CheckBillingAddress" targetRef="Gateway_BillingCorrect" />
    <bpmn:sequenceFlow id="SequenceFlow_ModifyAddress" name="No - Incorrect address&#10;" sourceRef="Gateway_BillingCorrect" targetRef="Task_ModifyBillingAddress" />
    <bpmn:sequenceFlow id="SequenceFlow_ContinueToClick" name="Yes - Correct address&#10;" sourceRef="Gateway_BillingCorrect" targetRef="Task_ClickContinue" />
    <bpmn:sequenceFlow id="SequenceFlow_RecheckAddress" sourceRef="Task_ModifyBillingAddress" targetRef="Gateway_RecheckBilling" />
    <bpmn:sequenceFlow id="SequenceFlow_AddressCheckedLoopBack" name="" sourceRef="Gateway_RecheckBilling" targetRef="Task_CheckBillingAddress" />
    <bpmn:sequenceFlow id="SequenceFlow_ToVerifyRequest" sourceRef="Task_ClickContinue" targetRef="IntermediateThrowEvent_VerifyRequest" />

    <!-- Verification Result Processing -->
    <bpmn:sequenceFlow id="SequenceFlow_ReceiveResult" sourceRef="IntermediateCatchEvent_VerificationResult" targetRef="Task_CheckVerificationResult" />
    <bpmn:sequenceFlow id="SequenceFlow_CheckVerification" name="" sourceRef="Task_CheckVerificationResult" targetRef="Gateway_VerificationResult" />

  </bpmn:process>

  <!-- External Verification Process -->
  <bpmn:process id="Process_ExternalVerification" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Authority" name="Receive verification request&#10;">
      <bpmn:messageEventDefinition />
      <bpmn:outgoing>SequenceFlow_VerifyCard</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:endEvent id="EndEvent_Authority" name="Verification complete">
      <bpmn:incoming>SequenceFlow_SendResult</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:task id="Task_VerifyCardAuthority" name="Verify credit card&#10;">
      <bpmn:incoming>SequenceFlow_VerifyCard</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendResult</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_VerifyCard" sourceRef="StartEvent_Authority" targetRef="Task_VerifyCardAuthority" />
    <bpmn:sequenceFlow id="SequenceFlow_SendResult" name="" sourceRef="Task_VerifyCardAuthority" targetRef="EndEvent_Authority" />

  </bpmn:process>
</bpmn:definitions>