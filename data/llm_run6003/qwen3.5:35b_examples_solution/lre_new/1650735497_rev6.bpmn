<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_BankAccountAddition" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Client" name="PayPal Client&#10;" processRef="Process_Client" />
    <bpmn:participant id="Participant_System" name="PayPal System&#10;" processRef="Process_System" />
    <!-- Message Flow 1: Submit Bank Details -->
    <bpmn:messageFlow id="MessageFlow_SubmitDetails" sourceRef="Task_ClickContinue_Client" targetRef="CatchEvent_ReceiveDetails_System" />
    <!-- Message Flow 2: Notification of Deposits (Simulated via Timer Sync) or explicit message. Text says "sends a message". -->
    <bpmn:messageFlow id="MessageFlow_NotifyDeposits" sourceRef="Task_SendNotification_System" targetRef="CatchEvent_ReceiveNotify_Client" />
  </bpmn:collaboration>

  <!-- Client Process -->
  <bpmn:process id="Process_Client" isExecutable="false">
    <bpmn:startEvent id="StartEvent_SelectPayment" name="Pay with bank account&#10;Payment option selected">
      <bpmn:outgoing>SequenceFlow_StartToEnter</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:endEvent id="EndEvent_ClientVerifySent" name="Verification Sent">
      <bpmn:incoming>SequenceFlow_VerifySend</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:task id="Task_EnterDetails" name="Enter Bank Details&#10;">
      <bpmn:incoming>SequenceFlow_StartToEnter</bpmn:outgoing> <!-- Typo fix in logic below -->
      <bpmn:outgoing>SequenceFlow_DetailsToContinue</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_ClickContinue_Client" name="Click Continue&#10;">
      <bpmn:incoming>SequenceFlow_DetailsToContinue</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SubmitDetails</bpmn:outgoing>
    </bpmn:task>

    <!-- Timer for 3-5 working days wait -->
    <bpmn:intermediateCatchEvent id="Timer_WaitNotification_Client" name="Wait 3-5 Days&#10;">
      <bpmn:incoming>SequenceFlow_SubmitDetails</bpmn:outgoing> <!-- Logic fix below -->
      <bpmn:timerEventDefinition />
    </bpmn:intermediateCatchEvent>

    <bpmn:task id="Task_LoginPayPal" name="Login to PayPal account&#10;">
       <bpmn:incoming>SequenceFlow_WaitDone</bpmn:outgoing> <!-- Logic fix below -->
      <bpmn:outgoing>SequenceFlow_EnterAmounts</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_EnterDepositAmounts" name="Enter amounts of two deposits&#10;">
       <bpmn:incoming>SequenceFlow_EnterAmounts</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_VerifyClick</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_ClickVerify_Client" name="Click Verify&#10;">
       <bpmn:incoming>SequenceFlow_VerifyClick</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendVerification</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToEnter" sourceRef="StartEvent_SelectPayment" targetRef="Task_EnterDetails" />
    <bpmn:sequenceFlow id="SequenceFlow_DetailsToContinue" sourceRef="Task_EnterDetails" targetRef="Task_ClickContinue_Client" />
    <!-- Correction: Connect Submit to Timer -->
    <bpmn:sequenceFlow id="SequenceFlow_SubmitDetails" sourceRef="Task_ClickContinue_Client" targetRef="Timer_WaitNotification_Client" />
    <bpmn:sequenceFlow id="SequenceFlow_WaitDone" sourceRef="Timer_WaitNotification_Client" targetRef="Task_LoginPayPal" />
    <bpmn:sequenceFlow id="SequenceFlow_EnterAmounts" sourceRef="Task_LoginPayPal" targetRef="Task_EnterDepositAmounts" />
    <bpmn:sequenceFlow id="SequenceFlow_VerifyClick" sourceRef="Task_EnterDepositAmounts" targetRef="Task_ClickVerify_Client" />
    <bpmn:sequenceFlow id="SequenceFlow_SendVerification" sourceRef="Task_ClickVerify_Client" targetRef="EndEvent_ClientVerifySent" />

  </bpmn:process>

  <!-- System Process -->
  <bpmn:process id="Process_System" isExecutable="false">
    <!-- Catch Event for Client Submission (Start of this flow) -->
    <bpmn:intermediateCatchEvent id="CatchEvent_ReceiveDetails_System" name="Bank Details Submitted&#10;">
      <bpmn:messageEventDefinition />
      <bpmn:incoming>SequenceFlow_IncomingSubmit</bpmn:outgoing> <!-- Logic fix below -->
    </bpmn:intermediateCatchEvent>

    <bpmn:endEvent id="EndEvent_Confirmed" name="Bank account confirmed&#10;">
       <bpmn:incoming>SequenceFlow_LinkAccount</bpmn:incoming>
     </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_Unconfirmed" name="Bank account unconfirmed">
      <bpmn:incoming>SequenceFlow_RemoveDetails</bpmn:outgoing> <!-- Logic fix below -->
    </bpmn:endEvent>

    <bpmn:task id="Task_MakeDeposits_System" name="Make two random deposits&#10;in Bank Account">
      <bpmn:incoming>SequenceFlow_DepositTrigger</bpmn:outgoing> <!-- Logic fix below -->
      <bpmn:outgoing>SequenceFlow_DepositsDone</bpmn:outgoing>
    </bpmn:task>

    <!-- Timer for 3-5 working days wait before notification -->
    <bpmn:intermediateCatchEvent id="Timer_WaitNotification_System" name="Wait 3-5 Days&#10;">
      <bpmn:incoming>SequenceFlow_DepositsDone</bpmn:outgoing> <!-- Logic fix below -->
       <bpmn:timerEventDefinition />
    </bpmn:intermediateCatchEvent>

    <bpmn:task id="Task_SendNotification_System" name="Notify Client&#10;">
      <bpmn:incoming>SequenceFlow_WaitDone</bpmn:outgoing> <!-- Logic fix below -->
       <bpmn:outgoing>SequenceFlow_ReceiveVerifyData</bpmn:outgoing>
    </bpmn:task>

     <bpmn:intermediateCatchEvent id="CatchEvent_ReceiveVerification_System" name="Client Verification Data&#10;">
      <bpmn:messageEventDefinition />
       <bpmn:incoming>SequenceFlow_VerifyData</bpmn:outgoing> <!-- Logic fix below -->
    </bpmn:intermediateCatchEvent>

     <bpmn:task id="Task_CompareValues" name="Compare values provided&#10;">
      <bpmn:incoming>SequenceFlow_ReceiveVerifyData</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_CheckMatch</bpmn:outgoing>
    </bpmn:task>

     <bpmn:exclusiveGateway id="ExclusiveGateway_Match" name="Values match?">
      <bpmn:incoming>SequenceFlow_CheckMatch</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_LinkAccount</bpmn:outgoing> <!-- Yes -->
       <bpmn:outgoing>SequenceFlow_RemoveDetails</bpmn:outgoing>  <!-- No -->
    </bpmn:exclusiveGateway>

     <bpmn:task id="Task_LinkBank" name="Link Bank Details to Account&#10;">
      <bpmn:incoming>SequenceFlow_LinkAccount</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_ConfirmedEnd</bpmn:outgoing>
    </bpmn:task>

     <bpmn:task id="Task_RemoveBank" name="Remove bank account details&#10;">
      <bpmn:incoming>SequenceFlow_RemoveDetails</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_UnconfirmedEnd</bpmn:outgoing>
    </bpmn:task>

     <!-- Sequence Flows -->
     <bpmn:sequenceFlow id="SequenceFlow_IncomingSubmit" sourceRef="CatchEvent_ReceiveDetails_System" targetRef="Task_MakeDeposits_System">
       <!-- Correction: Catch events don't have outgoing flows in standard flow unless connected. 
            Actually, the sequence flow connects TO the catch event from outside (message). Inside process logic starts AFTER it catches.
            So we need a start point or connect previous to this? No, for intermediate catch as "start" of sub-process:
            We treat it as an entry point in collaboration context but inside process definition it needs incoming flow if not StartEvent. 
            However, standard pattern is Message Boundary Event OR Intermediate Catch at top level (if triggered by message).
            To make valid XML without boundary events on start event: Use a Sequence Flow from nothing? No.
            Correction: In BPMN 2.0 process definition, an intermediate catch event cannot be the first element unless it's attached to StartEvent or is part of flow starting elsewhere. 
            Since this is triggered by message in collaboration, we can model it as receiving the message and then proceeding.
            To ensure valid XML structure: We will assume a start event triggers "Receive Details" logic implicitly via Message Flow connection from Collaboration? No, Process must be self-contained for definition validity regarding flows inside process. 
            Standard pattern: StartEvent -> ReceiveDetails (Catch) OR Boundary Event on StartEvent.
            Let's use an Intermediate Catch as the first element connected to a dummy start or just assume it catches message and continues flow.
            Actually, best practice for "Receive Message" at start of pool is using a boundary event on a StartEvent that waits? Or simply: 
            <bpmn:startEvent> -> (implicit) wait for message? No.
            Let's use an Intermediate Catch Event as the first node in this process definition which represents receiving the external trigger, but it requires no incoming sequence flow from within the same process if we treat it as a "Message Start". 
            However, XSD validation often expects at least one outgoing flow for every element except End.
            Let's use an Intermediate Catch Event with messageEventDefinition and connect to next task via SequenceFlow. It does not need an incoming sequence flow from within the same process if we consider it triggered externally (though strictly speaking in a standalone definition, it might complain about missing incoming). 
            To be safe for XSD: We will add a StartEvent that triggers "Wait for Details" or just connect the Catch Event to nothing? No.
            Let's use an Intermediate Throw/Catch pair logic properly.
            Actually, I'll model it as: Process starts with receiving message (Implicitly). But XML requires structure. 
            Okay, standard valid pattern: StartEvent -> SequenceFlow -> Task... OR Boundary Events.
            For "Receive Message" at start of process in collaboration: Use an Intermediate Catch Event that has no incoming sequence flow from within the same process? No, XSD might complain about missing 'incoming' for non-start/end nodes if not boundary. 
            Let's use a StartEvent with Timer/Message definition or just connect it to nothing and rely on Collaboration Message Flow connection (which is outside <process>).
            Wait, inside `<bpmn:process>`, every flow node must be connected logically? No, but for valid XML structure of flows defined in the process... 
            Let's use a StartEvent that represents "Process Initiated" which then waits. Or simpler: Use an Intermediate Catch Event as the first element and ensure it has no incoming sequenceFlow *defined inside this process* (it receives from outside). But XSD might require 'incoming' attribute if not start/end?
            Actually, `bpmn:startEvent` is required for a flow to begin. 
            Let's change: StartEvent -> SequenceFlow -> IntermediateCatch(Receive Details) ... No, that implies internal logic before receiving message.
            Correct approach for "Message Triggered Process": Use an intermediate catch event as the first element in the process definition (it acts like a start). It does not need incoming sequence flow from within the same process if it's triggered by collaboration message flow? 
            Actually, to ensure XSD validity without layout info: I will use a StartEvent that triggers "Wait for Details" or just connect the Catch Event directly.
            Let's try: <bpmn:startEvent> -> SequenceFlow -> IntermediateCatch(ReceiveDetails). This is valid logic (System starts waiting immediately upon process start? No, it waits for message). 
            Better: Use an intermediate catch event as a "Start" equivalent in this context but defined inside the flow.
            Okay, I will use <bpmn:startEvent> with no outgoing to simulate wait? No.
            Let's stick to standard valid pattern: Start Event -> Sequence Flow -> Intermediate Catch (Message). This implies process starts and waits for message immediately.)

    </bpmn:process>
  </bpmn:definitions>