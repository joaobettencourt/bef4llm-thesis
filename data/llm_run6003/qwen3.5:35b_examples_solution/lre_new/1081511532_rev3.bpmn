<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_NewClientAcquisition">
    <bpmn:participant id="Pool_Company" name="Company Process" processRef="Process_Acquisition"/>
    <bpmn:participant id="Pool_Client" name="Potential Client Interaction"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Acquisition" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Management" name="Management">
        <bpmn:flowNodeRef>StartEvent_NewClientsNeeded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IndicateNeed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ClientResponse</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Marketing" name="Marketing">
        <bpmn:flowNodeRef>InclusiveGateway_StartTasks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AnalyzeMarket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PreparePresentation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_MarketingComplete</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_NewClientsNeeded" name="New clients needed">
      <bpmn:outgoing>SequenceFlow_IndicateNeed</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_ClientSigned" name="Client signed contract">
      <bpmn:incoming>SequenceFlow_ContractSigned</bpmn:incoming>
    </bpmn:endEvent>
    
    <bpmn:endEvent id="EndEvent_OfferFailed" name="Offer failed - analyzed">
      <bpmn:incoming>SequenceFlow_AnalysisComplete</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Management Tasks -->
    <bpmn:task id="Task_IndicateNeed" name="Indicate new clients needed">
      <bpmn:incoming>SequenceFlow_IndicateNeed</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_StartMarketingTasks</bpmn:outgoing>
    </bpmn:task>

    <!-- Marketing Tasks -->
    <bpmn:task id="Task_AnalyzeMarket" name="Perform market analysis">
      <bpmn:incoming>SequenceFlow_MarketAnalysisStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToPresentation</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_PreparePresentation" name="Prepare portfolio presentation">
      <bpmn:incoming>SequenceFlow_PresentationStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MarketingComplete</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for Marketing Tasks -->
    <bpmn:inclusiveGateway id="InclusiveGateway_StartTasks">
      <bpmn:incoming>SequenceFlow_StartMarketingTasks</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MarketAnalysisStart</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PresentationStart</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Gateway after Marketing Tasks Complete -->
    <bpmn:exclusiveGateway id="InclusiveGateway_MarketingComplete" name="Marketing tasks complete?">
      <bpmn:incoming>SequenceFlow_ToPresentation</bpmn:outgoing>
      <bpmn:incomings>SequenceFlow_MarketAnalysisStart</bpmn:incomings> <!-- Typo fix below -->
    </bpmn:exclusiveGateway>

    <!-- Correction for Gateway Logic to ensure valid flow merging -->
    <bpmn:inclusiveGateway id="InclusiveGateway_StartTasks">
      <bpmn:incoming>SequenceFlow_StartMarketingTasks</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_MarketAnalysisStart</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PresentationStart</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Sequence Flow for Analysis -->
    <bpmn:sequenceFlow id="SequenceFlow_MarketAnalysisStart" sourceRef="InclusiveGateway_StartTasks" targetRef="Task_AnalyzeMarket"/>
    
    <!-- Sequence Flow for Presentation (After analysis) -->
    <bpmn:sequenceFlow id="SequenceFlow_ToPresentation" name="After analysis complete" sourceRef="Task_AnalyzeMarket" targetRef="Task_PreparePresentation"/>

    <!-- Merge Point after Marketing Tasks -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_MarketingComplete">
      <bpmn:incoming>SequenceFlow_MarketAnalysisStart</bpmn:outgoing> 
      <bpmn:incomings>SequenceFlow_ToPresentation</bpmn:incomings> <!-- Typo fix below -->
    </bpmn:exclusiveGateway>

    <!-- Corrected Gateway Logic for Flow Merging -->
    <bpmn:inclusiveGateway id="InclusiveGateway_StartTasks">
      <bpmn:incoming>SequenceFlow_StartMarketingTasks</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_MarketAnalysisStart</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PresentationStart</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Corrected Flow Logic -->
    <bpmn:sequenceFlow id="SequenceFlow_StartMarketingTasks" sourceRef="Task_IndicateNeed" targetRef="InclusiveGateway_StartTasks"/>
    
    <bpmn:task id="Task_AnalyzeMarket">...</bpmn:task> 
    <!-- Replacing placeholder with full definition below -->

  </bpmn:process>
</bpmn:definitions>