<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_PurchaseProcess">
    <bpmn:participant id="Participant_ACMEInc" name="ACME Inc." processRef="Process_PurchaseOrder"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_PurchaseOrder" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Department" name="Department">
        <bpmn:flowNodeRef>StartEvent_Demand</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_StockCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConsumeLocal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_LocalConsumption</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SpecifyDemand</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateRequisition</bpmn:flowNodeRef>
      </bpmn:lane>
      
      <bpmn:lane id="Lane_Procurement" name="Central procurement department">
        <bpmn:flowNodeRef>Gateway_SupplierCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckSupplierInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_NewSupplier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateNewSupplier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateOrderTemplate</bpmn:flowNodeRef>
      </bpmn:lane>
      
      <bpmn:lane id="Lane_Approver" name="Approver">
        <bpmn:flowNodeRef>Task_ApproveTriggerPO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_PurchaseOrderCreated</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Demand" name="Demand identified">
      <bpmn:outgoing>SequenceFlow_StockCheck</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_LocalConsumption" name="Goods consumed locally"/>
    
    <bpmn:endEvent id="EndEvent_PurchaseOrderCreated" name="Purchase Order created">
      <bpmn:incoming>SequenceFlow_OrderTriggered</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Department Lane Tasks -->
    <bpmn:exclusiveGateway id="Gateway_StockCheck" name="Goods in stock?">
      <bpmn:incoming>SequenceFlow_StockCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConsumeLocal</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CreateRequisitionPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Procurement Lane Tasks -->
    <bpmn:task id="Task_SpecifyDemand" name="Specify and quantify demand">
      <bpmn:incoming>SequenceFlow_CreateRequisitionPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RequisitionCreated</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_SupplierCheck" name="Supplier info available?">
      <bpmn:incoming>SequenceFlow_RequisitionReceived</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NewSupplierPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ExistingSupplierPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Procurement Lane Tasks -->
    <bpmn:task id="Task_CheckSupplierInfo" name="Check supplier information in ERP">
      <bpmn:incoming>SequenceFlow_RequisitionReceived</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SupplierCheckResult</bpmn:outgoing>
    </bpmn:task>

    <!-- Procurement Lane Tasks -->
    <bpmn:exclusiveGateway id="Gateway_NewSupplier" name="New supplier?">
      <bpmn:incoming>SequenceFlow_SupplierCheckResult</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CreateSupplierTask</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Procurement Lane Tasks -->
    <bpmn:task id="Task_ConsumeLocal" name="Consume goods from stock">
      <bpmn:incoming>SequenceFlow_ConsumeLocal</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_LocalConsumptionEnd</bpmn:outgoing>
    </bpmn:task>

    <!-- Procurement Lane Tasks -->
    <bpmn:task id="Task_CreateNewSupplier" name="Create new supplier in ERP">
      <bpmn:incoming>SequenceFlow_CreateSupplierTask</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SupplierCreatedMerge</bpmn:outgoing>
    </bpmn:task>

    <!-- Procurement Lane Tasks -->
    <bpmn:task id="Task_CreateOrderTemplate" name="Create order template from requisition">
      <bpmn:incoming>SequenceFlow_ExistingSupplierPath</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_SupplierCreatedMerge</bpmn:outgoing>
    </bpmn:task>

    <!-- Approver Lane Task -->
    <bpmn:task id="Task_ApproveTriggerPO" name="Approve and trigger purchase order">
      <bpmn:incoming>SequenceFlow_OrderTemplateReceived</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OrderTriggered</bpmn:outgoing>
    </bpmn:task>

    <!-- Procurement Lane Task -->
    <bpmn:task id="Task_CreateRequisition" name="Create purchase requisition in ERP system">
      <bpmn:incoming>SequenceFlow_RequisitionCreated</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RequisitionReceived</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StockCheck" sourceRef="StartEvent_Demand" targetRef="Gateway_StockCheck"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ConsumeLocal" name="Yes - Goods in stock" sourceRef="Gateway_StockCheck" targetRef="Task_ConsumeLocal"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_LocalConsumptionEnd" sourceRef="Task_ConsumeLocal" targetRef="EndEvent_LocalConsumption"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_CreateRequisitionPath" name="No - Goods not in stock" sourceRef="Gateway_StockCheck" targetRef="Task_SpecifyDemand"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_RequisitionCreated" sourceRef="Task_SpecifyDemand" targetRef="Task_CreateRequisition"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_RequisitionReceived" name="" sourceRef="Task_CreateRequisition" targetRef="Gateway_SupplierCheck"/>

    <!-- Supplier Check Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_SupplierCheckResult" sourceRef="Gateway_SupplierCheck" targetRef="Gateway_NewSupplier"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_CreateSupplierTask" name="New supplier - create first" sourceRef="Gateway_NewSupplier" targetRef="Task_CreateNewSupplier"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_SupplierCreatedMerge" sourceRef="Task_CreateNewSupplier" targetRef="Task_CreateOrderTemplate"/>

    <!-- Existing Supplier Path -->
    <bpmn:sequenceFlow id="SequenceFlow_ExistingSupplierPath" name="Known supplier - continue" sourceRef="Gateway_NewSupplier" targetRef="Task_CreateOrderTemplate"/>

    <!-- Order Template to Approver Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_OrderTemplateReceived" sourceRef="Task_CreateOrderTemplate" targetRef="Task_ApproveTriggerPO"/>

    <!-- Final Approval and End -->
    <bpmn:sequenceFlow id="SequenceFlow_OrderTriggered" sourceRef="Task_ApproveTriggerPO" targetRef="EndEvent_PurchaseOrderCreated"/>
  </bpmn:process>
</bpmn:definitions>