<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_CreditProcess">
    <bpmn:participant id="Participant_CreditCompany" name="Credit Company" processRef="Process_CreditApproval" />
    <bpmn:participant id="Participant_Customer" name="Customer" />
  </bpmn:collaboration>

  <bpmn:process id="Process_CreditApproval" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_RequestReceived" name="Credit Request Received">
      <bpmn:messageEventDefinition />
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task Elements -->
    <bpmn:task id="Task_CollectInformation" name="Collect Credit Information">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckAmount</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Check Amount -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_AmountCheck" name="Amount &gt; 1M$?">
      <bpmn:incoming>SequenceFlow_CheckAmount</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RequestApprovalHigh</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_AssessRiskLow</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task for Risk Assessment -->
    <bpmn:task id="Task_AssessRisk" name="Assess Credit Risk">
      <bpmn:incoming>SequenceFlow_AssessRiskLow</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckRiskLevel</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2: Check Risk Level -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_RiskCheck" name="Risk High?">
      <bpmn:incoming>SequenceFlow_CheckRiskLevel</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RequestApprovalHighRisk</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_AcceptCreditLowRisk</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task for Approval Request -->
    <bpmn:task id="Task_RequestApproval" name="Request Credit Approval">
      <bpmn:incoming>SequenceFlow_RequestApprovalHigh</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_RequestApprovalHighRisk</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckApprovalResult</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 3: Check Approval Result -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_ApprovalCheck" name="Approved?">
      <bpmn:incoming>SequenceFlow_CheckApprovalResult</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RejectCredit</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_AcceptFromApproval</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task for Accepting Credit -->
    <bpmn:task id="Task_DirectAccept" name="Directly Accept Credit">
      <bpmn:incoming>SequenceFlow_AcceptCreditLowRisk</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_AcceptFromApproval</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendEmailAccepted</bpmn:outgoing>
    </bpmn:task>

    <!-- Task for Rejecting Credit -->
    <bpmn:task id="Task_RejectCredit" name="Reject Credit">
      <bpmn:incoming>SequenceFlow_RejectCredit</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendEmailRejected</bpmn:outgoing>
    </bpmn:task>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_CreditAccepted" name="Credit Accepted">
      <bpmn:messageEventDefinition />
      <bpmn:incoming>SequenceFlow_SendEmailAccepted</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_CreditRejected" name="Credit Rejected">
      <bpmn:messageEventDefinition />
      <bpmn:incoming>SequenceFlow_SendEmailRejected</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_RequestReceived" targetRef="Task_CollectInformation">
      <bpmn:name>Credit Request</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_CheckAmount" name="Check Amount" sourceRef="Task_CollectInformation" targetRef="ExclusiveGateway_AmountCheck" />

    <bpmn:sequenceFlow id="SequenceFlow_RequestApprovalHigh" name="Yes, &gt; 1M$" sourceRef="ExclusiveGateway_AmountCheck" targetRef="Task_RequestApproval">
      <bpmn:name>Amount &gt; 1M$</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_AssessRiskLow" name="No, &lt;= 1M$" sourceRef="ExclusiveGateway_AmountCheck" targetRef="Task_AssessRisk">
      <bpmn:name>Amount &lt;= 1M$</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_CheckRiskLevel" name="Assessment Complete" sourceRef="Task_AssessRisk" targetRef="ExclusiveGateway_RiskCheck">
      <bpmn:name>Risk Assessment</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_RequestApprovalHighRisk" name="Yes, High Risk" sourceRef="ExclusiveGateway_RiskCheck" targetRef="Task_RequestApproval">
      <bpmn:name>Risk = High</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_AcceptCreditLowRisk" name="No, Low Risk" sourceRef="ExclusiveGateway_RiskCheck" targetRef="Task_DirectAccept">
      <bpmn:name>Risk = Low</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_CheckApprovalResult" name="Await Approval Result" sourceRef="Task_RequestApproval" targetRef="ExclusiveGateway_ApprovalCheck">
      <bpmn:name>Approval Decision</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_RejectCredit" name="No, Rejected" sourceRef="ExclusiveGateway_ApprovalCheck" targetRef="Task_RejectCredit">
      <bpmn:name>Credit = Rejected</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_AcceptFromApproval" name="Yes, Approved" sourceRef="ExclusiveGateway_ApprovalCheck" targetRef="Task_DirectAccept">
      <bpmn:name>Credit = Accepted</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_SendEmailAccepted" name="Send Email Notification" sourceRef="Task_DirectAccept" targetRef="EndEvent_CreditAccepted">
      <bpmn:name>Email Sent</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_SendEmailRejected" name="Send Email Notification" sourceRef="Task_RejectCredit" targetRef="EndEvent_CreditRejected">
      <bpmn:name>Email Sent</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>