<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_CustomerFeedbackModule">
    <bpmn:participant id="Participant_Process" name="Customer Feedback Module Implementation Process" processRef="Process_CFM" />
  </bpmn:collaboration>

  <bpmn:process id="Process_CFM" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_BusinessAnalyst" name="Business Analyst">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Analysis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateCatchEvent_DesignComplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DesignReview</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_WebDesigner" name="Web Designer">
        <bpmn:flowNodeRef>Task_IntegrateDesign1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ChangeDesign</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PHPHTMLCSS" name="PHP/HTML/CSS Specialist">
        <bpmn:flowNodeRef>Task_IntegrateImplementation1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AdjustAndReintegrate</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Tester" name="Tester">
        <bpmn:flowNodeRef>Task_TestWebsite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_TestReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Success</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Collect data and conduct business analysis">
      <bpmn:outgoing>SequenceFlow_StartToAnalysis</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Business Analyst Tasks -->
    <bpmn:task id="Task_Analysis" name="Conduct business analysis regarding customer feedback">
      <bpmn:incoming>SequenceFlow_StartToAnalysis</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AnalysisToDesign1</bpmn:outgoing>
    </bpmn:task>

    <!-- Web Designer Tasks -->
    <bpmn:task id="Task_IntegrateDesign1" name="Integrate design and decide where customer feedback module should be placed">
      <bpmn:incoming>SequenceFlow_AnalysisToDesign1</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ChangeDesignBack</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DesignCompleteNotification</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Catch Event for Design Complete -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_DesignComplete" name="Design complete">
      <bpmn:incoming>SequenceFlow_DesignCompleteNotification</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AnalysisReview</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Design Review Gateway -->
    <bpmn:exclusiveGateway id="Gateway_DesignReview" name="Design OK?">
      <bpmn:incoming>SequenceFlow_AnalysisReview</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DesignOKToImplementation</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NeedAdjustment</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Change Design Task -->
    <bpmn:task id="Task_ChangeDesign" name="Change design">
      <bpmn:incoming>SequenceFlow_NeedAdjustment</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ChangeDesignBack</bpmn:outgoing>
    </bpmn:task>

    <!-- PHP/HTML/CSS Specialist Tasks -->
    <bpmn:task id="Task_IntegrateImplementation1" name="Integrate with the overall implementation">
      <bpmn:incoming>SequenceFlow_DesignOKToImplementation</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ReintegrateAfterAdjustment</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToTesting</bpmn:outgoing>
    </bpmn:task>

    <!-- Tester Tasks -->
    <bpmn:task id="Task_TestWebsite" name="Test the final website to make sure everything is going well">
      <bpmn:incoming>SequenceFlow_ToTesting</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReviewTestResults</bpmn:outgoing>
    </bpmn:task>

    <!-- Test Review Gateway -->
    <bpmn:exclusiveGateway id="Gateway_TestReview" name="Test OK?">
      <bpmn:incoming>SequenceFlow_ReviewTestResults</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SuccessEnd</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_TestNotOKToAdjustment</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Adjustment Task -->
    <bpmn:task id="Task_AdjustAndReintegrate" name="Provide test results, adjust according to test results and integrate overall implementation">
      <bpmn:incoming>SequenceFlow_TestNotOKToAdjustment</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReintegrateAfterAdjustment</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Success" name="Process ends">
      <bpmn:incoming>SequenceFlow_SuccessEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToAnalysis" sourceRef="StartEvent_1" targetRef="Task_Analysis" />
    <bpmn:sequenceFlow id="SequenceFlow_AnalysisToDesign1" name="Proceed to design integration" sourceRef="Task_Analysis" targetRef="Task_IntegrateDesign1" />
    <bpmn:sequenceFlow id="SequenceFlow_DesignCompleteNotification" name="Notify business analyst" sourceRef="Task_IntegrateDesign1" targetRef="IntermediateCatchEvent_DesignComplete" />
    <bpmn:sequenceFlow id="SequenceFlow_AnalysisReview" name="Check design and provide feedback" sourceRef="IntermediateCatchEvent_DesignComplete" targetRef="Gateway_DesignReview" />
    <bpmn:sequenceFlow id="SequenceFlow_NeedAdjustment" name="Design needs adjustment" sourceRef="Gateway_DesignReview" targetRef="Task_ChangeDesign" />
    <bpmn:sequenceFlow id="SequenceFlow_ChangeDesignBack" name="Re-integrate design" sourceRef="Task_ChangeDesign" targetRef="Task_IntegrateDesign1" />
    <bpmn:sequenceFlow id="SequenceFlow_DesignOKToImplementation" name="Design OK - proceed to implementation" sourceRef="Gateway_DesignReview" targetRef="Task_IntegrateImplementation1" />
    <bpmn:sequenceFlow id="SequenceFlow_ToTesting" name="Ready for testing" sourceRef="Task_IntegrateImplementation1" targetRef="Task_TestWebsite" />
    <bpmn:sequenceFlow id="SequenceFlow_ReviewTestResults" name="Submit test results" sourceRef="Task_TestWebsite" targetRef="Gateway_TestReview" />
    <bpmn:sequenceFlow id="SequenceFlow_SuccessEnd" name="Tests OK - process complete" sourceRef="Gateway_TestReview" targetRef="EndEvent_Success" />
    <bpmn:sequenceFlow id="SequenceFlow_TestNotOKToAdjustment" name="Test not OK - needs adjustment" sourceRef="Gateway_TestReview" targetRef="Task_AdjustAndReintegrate" />
    <bpmn:sequenceFlow id="SequenceFlow_ReintegrateAfterAdjustment" name="Re-integrate after adjustments" sourceRef="Task_AdjustAndReintegrate" targetRef="Task_IntegrateImplementation1" />

  </bpmn:process>
</bpmn:definitions>