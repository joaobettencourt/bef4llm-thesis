<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_PartsProvision">
    <bpmn:participant id="Participant_ProvisionTeam" name="Provision Team" processRef="Process_PartRequest" />
    <bpmn:participant id="Participant_Customer" name="Customer" />
    <bpmn:participant id="Participant_Daisuki" name="Daisuki" />

    <!-- Message Flows -->
    <bpmn:messageFlow id="MessageFlow_RequestReceived" sourceRef="StartEvent_1" targetRef="Participant_Customer" />
    <bpmn:messageFlow id="MessageFlow_QuestionToCustomer" sourceRef="Task_AskForInfo" targetRef="Participant_Customer" />
    <bpmn:messageFlow id="MessageFlow_InfoFromCustomer" sourceRef="Participant_Customer" targetRef="Task_CheckAvailability" />
    <bpmn:messageFlow id="MessageFlow_OrderToDaisuki" sourceRef="SubProcess_OrderByDaisuki" targetRef="Participant_Daisuki" />
    <bpmn:messageFlow id="MessageFlow_PartsFromDaisuki" sourceRef="Participant_Daisuki" targetRef="Task_ContractCustomer" />
  </bpmn:collaboration>

  <bpmn:process id="Process_PartRequest" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Receive Request">
      <bpmn:messageEventDefinition />
      <bpmn:outgoing>SequenceFlow_IdentifyParts</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task Elements -->
    <bpmn:task id="Task_IdentifyParts" name="Identify necessary parts">
      <bpmn:incoming>SequenceFlow_IdentifyParts</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckQuestions</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for Questions -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_Questions" name="Any questions?">
      <bpmn:incoming>SequenceFlow_CheckQuestions</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AskInfo</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoQuestions</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task for asking information -->
    <bpmn:task id="Task_AskForInfo" name="Ask customer for more info">
      <bpmn:incoming>SequenceFlow_AskInfo</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InfoReceived</bpmn:outgoing>
    </bpmn:task>

    <!-- Task for checking availability -->
    <bpmn:task id="Task_CheckAvailability" name="Check parts availability">
      <bpmn:incoming>SequenceFlow_NoQuestions</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_InfoReceived</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AvailabilityDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for Availability -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_Available" name="Parts available?">
      <bpmn:incoming>SequenceFlow_AvailabilityDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SupplyAvailable</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_OrderNeeded</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task for supplying available parts -->
    <bpmn:task id="Task_SupplyParts" name="Supply to customer">
      <bpmn:incoming>SequenceFlow_SupplyAvailable</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ContractCustomer1</bpmn:outgoing>
    </bpmn:task>

    <!-- Task for recording petition -->
    <bpmn:task id="Task_RecordPetition" name="Record customer detail">
      <bpmn:incoming>SequenceFlow_OrderNeeded</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SubProcessOrder</bpmn:outgoing>
    </bpmn:task>

    <!-- Sub-process for ordering from Daisuki -->
    <bpmn:subProcess id="SubProcess_OrderByDaisuki" name="Order and receive parts">
      <bpmn:incoming>SequenceFlow_SubProcessOrder</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ContractCustomer2</bpmn:outgoing>
    </bpmn:subProcess>

    <!-- Task for contacting customer -->
    <bpmn:task id="Task_ContractCustomer" name="Contact customer">
      <bpmn:incoming>SequenceFlow_ContractCustomer1</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ContractCustomer2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CollectItems</bpmn:outgoing>
    </bpmn:task>

    <!-- Task for items collected -->
    <bpmn:task id="Task_ItemsCollected" name="Parts Collected">
      <bpmn:incoming>SequenceFlow_CollectItems</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PaymentReceived</bpmn:outgoing>
    </bpmn:task>

    <!-- Task for payment -->
    <bpmn:task id="Task_FinalPayment" name="Receive final payment">
      <bpmn:incoming>SequenceFlow_PaymentReceived</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndProcess</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_1" name="Payment Received">
      <bpmn:incoming>SequenceFlow_EndProcess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_IdentifyParts" sourceRef="StartEvent_1" targetRef="Task_IdentifyParts" />
    <bpmn:sequenceFlow id="SequenceFlow_CheckQuestions" sourceRef="Task_IdentifyParts" targetRef="ExclusiveGateway_Questions" />
    <bpmn:sequenceFlow id="SequenceFlow_AskInfo" name="Yes - questions exist" sourceRef="ExclusiveGateway_Questions" targetRef="Task_AskForInfo" />
    <bpmn:sequenceFlow id="SequenceFlow_InfoReceived" sourceRef="Task_AskForInfo" targetRef="Task_CheckAvailability" />
    <bpmn:sequenceFlow id="SequenceFlow_NoQuestions" name="No questions" sourceRef="ExclusiveGateway_Questions" targetRef="Task_CheckAvailability" />
    <bpmn:sequenceFlow id="SequenceFlow_AvailabilityDecision" sourceRef="Task_CheckAvailability" targetRef="ExclusiveGateway_Available" />
    <bpmn:sequenceFlow id="SequenceFlow_SupplyAvailable" name="Yes - available" sourceRef="ExclusiveGateway_Available" targetRef="Task_SupplyParts" />
    <bpmn:sequenceFlow id="SequenceFlow_OrderNeeded" name="No - order needed" sourceRef="ExclusiveGateway_Available" targetRef="Task_RecordPetition" />
    <bpmn:sequenceFlow id="SequenceFlow_SubProcessOrder" sourceRef="Task_RecordPetition" targetRef="SubProcess_OrderByDaisuki" />
    <bpmn:sequenceFlow id="SequenceFlow_ContractCustomer1" name="After supply available" sourceRef="Task_SupplyParts" targetRef="Task_ContractCustomer" />
    <bpmn:sequenceFlow id="SequenceFlow_ContractCustomer2" name="After parts collected from Daisuki" sourceRef="SubProcess_OrderByDaisuki" targetRef="Task_ContractCustomer" />
    <bpmn:sequenceFlow id="SequenceFlow_CollectItems" sourceRef="Task_ContractCustomer" targetRef="Task_ItemsCollected" />
    <bpmn:sequenceFlow id="SequenceFlow_PaymentReceived" sourceRef="Task_ItemsCollected" targetRef="Task_FinalPayment" />
    <bpmn:sequenceFlow id="SequenceFlow_EndProcess" sourceRef="Task_FinalPayment" targetRef="EndEvent_1" />

  </bpmn:process>
</bpmn:definitions>