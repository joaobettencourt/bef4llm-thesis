<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_WorkAccident" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_WorkAccidentProcess">
    <bpmn:participant id="Participant_WorkAccident" name="Work Accident Reporting Process" processRef="Process_WorkAccident"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_WorkAccident" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="Start_IncidentHappens" name="Incident Happens">
      <bpmn:outgoing>Sequence_AssessIncident</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Access Assessment Tool -->
    <bpmn:task id="Task_AccessAssessmentTool" name="Access Assessment Tool">
      <bpmn:incoming>Sequence_AssessIncident</bpmn:incoming>
      <bpmn:outgoing>Sequence_ClassifyType</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Classify Incident Type -->
    <bpmn:exclusiveGateway id="Gateway_ClassifyType" name="Classify Incident Type">
      <bpmn:incoming>Sequence_ClassifyType</bpmn:incoming>
      <bpmn:outgoing>Sequence_WorkAccidentPath</bpmn:outgoing>
      <bpmn:outgoing>Sequence_AlmostAccidentPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Report Work Accident -->
    <bpmn:task id="Task_ReportWorkAccident" name="Report Work Accident">
      <bpmn:incoming>Sequence_WorkAccidentPath</bpmn:incoming>
      <bpmn:outgoing>Sequence_CheckSeverity</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Check Severity -->
    <bpmn:exclusiveGateway id="Gateway_CheckSeverity" name="Fatality or Serious Injury?">
      <bpmn:incoming>Sequence_CheckSeverity</bpmn:incoming>
      <bpmn:outgoing>Sequence_ReportInspectorateYes</bpmn:outgoing>
      <bpmn:outgoing>Sequence_ReportInsuranceNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Contact Labour Inspectorate -->
    <bpmn:task id="Task_ContactLabourInspectorate" name="Report to Labour Inspectorate">
      <bpmn:incoming>Sequence_ReportInspectorateYes</bpmn:incoming>
      <bpmn:outgoing>Sequence_CheckAlreadyReported</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Already Reported -->
    <bpmn:exclusiveGateway id="Gateway_AlreadyReported" name="Already Reported to Safety Authorities?">
      <bpmn:incoming>Sequence_CheckAlreadyReported</bpmn:incoming>
      <bpmn:outgoing>Sequence_ReportInsuranceYes</bpmn:outgoing>
      <bpmn:outgoing>Sequence_ContactInspectorateNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Report Accident Insurance -->
    <bpmn:task id="Task_ReportAccidentInsurance" name="Report to Accident Insurance Provider">
      <bpmn:incoming>Sequence_ReportInsuranceYes</bpmn:incoming>
      <bpmn:outgoing>Sequence_CheckPrivateInsurance</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Private Insurance -->
    <bpmn:exclusiveGateway id="Gateway_PrivateInsurance" name="Has Private Insurance?">
      <bpmn:incoming>Sequence_CheckPrivateInsurance</bpmn:incoming>
      <bpmn:outgoing>Sequence_ReportPrivateYes</bpmn:outgoing>
      <bpmn:outgoing>Sequence_ContactSuperiorsNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event -->
    <bpmn:endEvent id="End_ProcessComplete" name="Process Complete">
      <bpmn:incoming>Sequence_FinalConvergence</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Gateway: Is Student/University Victim -->
    <bpmn:exclusiveGateway id="Gateway_IsStudent" name="Victim is Student?">
      <bpmn:incoming>Sequence_CheckSeverity</bpmn:incoming>
      <bpmn:outgoing>Sequence_ReportDirectorateYes</bpmn:outgoing>
      <bpmn:outgoing>Sequence_ContactSuperiorsNo2</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Report to Directorate -->
    <bpmn:task id="Task_ReportToDirectorate" name="Report to Competent Directorate">
      <bpmn:incoming>Sequence_ReportDirectorateYes</bpmn:incoming>
      <bpmn:outgoing>Sequence_ConvergeAfterStudentPath</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Report Almost Accident -->
    <bpmn:task id="Task_ReportAlmostAccident" name="Report Almost Accident">
      <bpmn:incoming>Sequence_AlmostAccidentPath</bpmn:incoming>
      <bpmn:outgoing>Sequence_ConvergeAfterStudentPath2</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Report Safety/Health Risk -->
    <bpmn:task id="Task_ReportSafetyRisk" name="Report Safety/Health Risk">
      <bpmn:incoming>Sequence_SafetyRiskPath</bpmn:incoming>
      <bpmn:outgoing>Sequence_ConvergeAfterStudentPath3</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Report Equipment Defects -->
    <bpmn:task id="Task_ReportEquipmentDefects" name="Report Equipment Defects">
      <bpmn:incoming>Sequence_DefectPath</bpmn:incoming>
      <bpmn:outgoing>Sequence_ConvergeAfterStudentPath4</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Report Private Insurance -->
    <bpmn:exclusiveGateway id="Gateway_ReportPrivate" name="Report to Private Insurer?">
      <bpmn:incoming>Sequence_CheckPrivateInsurance</bpmn:incoming>
      <bpmn:outgoing>Sequence_ConvergeAfterStudentPath5</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Parallel Gateway for Convergence -->
    <bpmn:parallelGateway id="Parallel_GatewayConverge1" name="">
      <bpmn:incoming>Sequence_ReportInsuranceNo</bpmn:incoming>
      <bpmn:outgoing>Sequence_FinalConvergence</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Sequence_AssessIncident" sourceRef="Start_IncidentHappens" targetRef="Task_AccessAssessmentTool"/>
    <bpmn:sequenceFlow id="Sequence_ClassifyType" sourceRef="Task_AccessAssessmentTool" targetRef="Gateway_ClassifyType"/>

    <!-- Work Accident Path -->
    <bpmn:sequenceFlow id="Sequence_WorkAccidentPath" name="Work Accident" sourceRef="Gateway_ClassifyType" targetRef="Task_ReportWorkAccident"/>
    <bpmn:sequenceFlow id="Sequence_CheckSeverity" sourceRef="Task_ReportWorkAccident" targetRef="Gateway_CheckSeverity"/>

    <!-- Severity Decision -->
    <bpmn:sequenceFlow id="Sequence_ReportInspectorateYes" name="Fatality/Serious Injury - Yes" sourceRef="Gateway_CheckSeverity" targetRef="Task_ContactLabourInspectorate"/>
    <bpmn:sequenceFlow id="Sequence_ReportInsuranceNo" name="Other Cases - No" sourceRef="Gateway_CheckSeverity" targetRef="Parallel_GatewayConverge1"/>

    <!-- Inspectorate Reporting -->
    <bpmn:sequenceFlow id="Sequence_CheckAlreadyReported" sourceRef="Task_ContactLabourInspectorate" targetRef="Gateway_AlreadyReported"/>

    <bpmn:sequenceFlow id="Sequence_ReportInsuranceYes" name="Not Reported - Yes" sourceRef="Gateway_AlreadyReported" targetRef="Task_ReportAccidentInsurance"/>
    <bpmn:sequenceFlow id="Sequence_ContactInspectorateNo" name="Already Reported - No" sourceRef="Gateway_AlreadyReported" targetRef="Parallel_GatewayConverge1"/>

    <!-- Student Path -->
    <bpmn:sequenceFlow id="Sequence_ReportDirectorateYes" name="Student/University - Yes" sourceRef="Gateway_IsStudent" targetRef="Task_ReportToDirectorate"/>
    <bpmn:sequenceFlow id="Sequence_ContactSuperiorsNo2" name="Not Student - No" sourceRef="Gateway_IsStudent" targetRef="Parallel_GatewayConverge1"/>

    <!-- Almost Accident Path -->
    <bpmn:sequenceFlow id="Sequence_AlmostAccidentPath" name="Almost Accident/Other Issues" sourceRef="Gateway_ClassifyType" targetRef="Task_ReportAlmostAccident"/>

    <!-- Convergence for Student and Other Paths -->
    <bpmn:sequenceFlow id="Sequence_ConvergeAfterStudentPath" sourceRef="Task_ReportToDirectorate" targetRef="Parallel_GatewayConverge1"/>
    <bpmn:sequenceFlow id="Sequence_FinalConvergence" name="" sourceRef="Parallel_GatewayConverge1" targetRef="End_ProcessComplete"/>

  </bpmn:process>
</bpmn:definitions>