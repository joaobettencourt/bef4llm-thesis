<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
                 id="Definitions_ViennaNightRunApp" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_NightRunProcess">
    <bpmn:participant id="Participant_RunnerApp" name="Vienna Night Run App Process" processRef="Process_ViennaNightRun"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_ViennaNightRun" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="Start_Event_Participate" name="Participate Night Run">
      <bpmn:outgoing>Sequence_SelectStartingBlock</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Select Starting Block (App Input) -->
    <bpmn:task id="Task_SelectStartingBlock" name="Select starting block">
      <bpmn:incoming>Sequence_SelectStartingBlock</bpmn:incoming>
      <bpmn:outgoing>Sequence_StartTestLoop</bpmn:outgoing>
    </bpmn:task>

    <!-- Data Object for App Input -->
    <bpmn:dataObjectReference id="Data_AppInput" name="Starting Block Selection">
      <bpmn:name>Starting Block Selection</bpmn:name>
    </bpmn:dataObjectReference>
    
    <!-- Association: Task to Data Object -->
    <bpmn:association id="Assoc_SelectBlock_Data" sourceRef="Task_SelectStartingBlock" targetRef="Data_AppInput"/>

    <!-- Parallel Gateway for Test Phase (Run & Measure) -->
    <bpmn:parallelGateway id="Gateway_StartTestLoop">
      <bpmn:incoming>Sequence_StartTestLoop</bpmn:incoming>
      <bpmn:outgoing>Sequence_Run5km</bpmn:outgoing>
      <bpmn:outgoing>Sequence_MeasureTimeStart</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Run 5 km -->
    <bpmn:task id="Task_RunFiveKm" name="Run for 5km">
      <bpmn:incoming>Sequence_Run5km</bpmn:incoming>
      <bpmn:outgoing>Sequence_ConvergeTestPhase1</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Measure Time (Fitness Gadget) -->
    <bpmn:task id="Task_MeasureTime" name="Measure time">
      <bpmn:incoming>Sequence_MeasureTimeStart</bpmn:incoming>
      <bpmn:outgoing>Sequence_ConvergeTestPhase2</bpmn:outgoing>
    </bpmn:task>

    <!-- Data Object for Fitness Gadget -->
    <bpmn:dataObjectReference id="Data_FitnessGadget" name="Running Time Measurement">
      <bpmn:name>Running Time Measurement</bpmn:name>
    </bpmn:dataObjectReference>

    <!-- Association: Measure Task to Data Object -->
    <bpmn:association id="Assoc_Measure_Data" sourceRef="Task_MeasureTime" targetRef="Data_FitnessGadget"/>

    <!-- Converging Parallel Gateway for Test Phase -->
    <bpmn:parallelGateway id="Gateway_ConvergeTestPhase">
      <bpmn:incoming>Sequence_ConvergeTestPhase1</bpmn:incoming>
      <bpmn:incoming>Sequence_ConvergeTestPhase2</bpmn:incoming>
      <bpmn:outgoing>Sequence_CheckTimeResult</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Exclusive Gateway for Check (< 25 mins) -->
    <bpmn:exclusiveGateway id="Gateway_CheckTime">
      <bpmn:incoming>Sequence_CheckTimeResult</bpmn:incoming>
      <bpmn:outgoing>Sequence_TrainLoop</bpmn:outgoing> <!-- No path (Train) -->
      <bpmn:outgoing>Sequence_PassTest</bpmn:outgoing>  <!-- Yes path -->
    </bpmn:exclusiveGateway>

    <!-- Task: Training (Loop Back) -->
    <bpmn:task id="Task_TrainingSession" name="Train and Check">
      <bpmn:incoming>Sequence_TrainLoop</bpmn:incoming>
      <bpmn:outgoing>Sequence_ReturnToTest</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Get Starting Number -->
    <bpmn:task id="Task_GetStartingNumber" name="Get starting number">
      <bpmn:incoming>Sequence_PassTest</bpmn:incoming>
      <bpmn:outgoing>Sequence_WorkDecisionCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Data Object for Starting Number -->
    <bpmn:dataObjectReference id="Data_StartingNumber" name="Starting Number">
      <bpmn:name>Starting Number</bpmn:name>
    </bpmn:dataObjectReference>
    
    <bpmn:association id="Assoc_Number_Data" sourceRef="Task_GetStartingNumber" targetRef="Data_StartingNumber"/>

    <!-- Exclusive Gateway: Work Schedule Check (>1 hour left?) -->
    <bpmn:exclusiveGateway id="Gateway_WorkScheduleCheck">
      <bpmn:incoming>Sequence_WorkDecisionCheck</bpmn:incoming>
      <bpmn:outgoing>Sequence_GoFromHome</bpmn:outgoing> <!-- Yes path (More than 1 hour) -->
      <bpmn:outgoing>Sequence_LeaveDirectlyWork</bpmn:outgoing> <!-- No path (< 1 hour) -->
    </bpmn:exclusiveGateway>

    <!-- Task: Go from Home -->
    <bpmn:task id="Task_GoFromHome" name="Go to run from home">
      <bpmn:incoming>Sequence_GoFromHome</bpmn:incoming>
      <bpmn:outgoing>Sequence_ConvergeTravelPaths1</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Leave Directly from Work -->
    <bpmn:task id="Task_LeaveDirectlyWork" name="Go directly after work to the run">
      <bpmn:incoming>Sequence_LeaveDirectlyWork</bpmn:incoming>
      <bpmn:outgoing>Sequence_ConvergeTravelPaths2</bpmn:outgoing>
    </bpmn:task>

    <!-- Converging Gateway for Travel Paths (Exclusive) -->
    <bpmn:exclusiveGateway id="Gateway_ConvergeTravelPaths">
      <bpmn:incoming>Sequence_ConvergeTravelPaths1</bpmn:incoming>
      <bpmn:incoming>Sequence_ConvergeTravelPaths2</bpmn:incoming>
      <bpmn:outgoing>Sequence_StartNightRunPhase</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Parallel Gateway for Night Run Phase (Run & Drink) -->
    <bpmn:parallelGateway id="Gateway_NightRunPhase">
      <bpmn:incoming>Sequence_StartNightRunPhase</bpmn:incoming>
      <bpmn:outgoing>Sequence_ActualRun</bpmn:outgoing>
      <bpmn:outgoing>Sequence_DrinkIsoSport</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Run the Night Run -->
    <bpmn:task id="Task_ActualRun" name="Run the night run">
      <bpmn:incoming>Sequence_ActualRun</bpmn:incoming>
      <bpmn:outgoing>Sequence_ConvergeNightRunPhase1</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Drink Iso Sport (Simultaneous) -->
    <bpmn:task id="Task_DrinkIsoSport" name="Drink iso sport">
      <bpmn:incoming>Sequence_DrinkIsoSport</bpmn:incoming>
      <bpmn:outgoing>Sequence_ConvergeNightRunPhase2</bpmn:outgoing>
    </bpmn:task>

    <!-- Converging Gateway for Night Run Phase -->
    <bpmn:parallelGateway id="Gateway_ConvergeNightRunPhase">
      <bpmn:incoming>Sequence_ConvergeNightRunPhase1</bpmn:incoming>
      <bpmn:incoming>Sequence_ConvergeNightRunPhase2</bpmn:incoming>
      <bpmn:outgoing>Sequence_ReceiveFinalTime</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Receive Final Running Time -->
    <bpmn:task id="Task_ReceiveFinalTime" name="Receive final running time">
      <bpmn:incoming>Sequence_ReceiveFinalTime</bpmn:incoming>
      <bpmn:outgoing>Sequence_EndRunFinished</bpmn:outgoing>
    </bpmn:task>

    <!-- Data Object for Final Time -->
    <bpmn:dataObjectReference id="Data_FinalRunningTime" name="Final Running Time">
      <bpmn:name>Final Running Time</bpmn:name>
    </bpmn:dataObjectReference>

    <bpmn:association id="Assoc_FinalTime_Data" sourceRef="Task_ReceiveFinalTime" targetRef="Data_FinalRunningTime"/>

    <!-- End Event -->
    <bpmn:endEvent id="End_Event_RunFinished" name="Run finished">
      <bpmn:incoming>Sequence_EndRunFinished</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Sequence_SelectStartingBlock" sourceRef="Start_Event_Participate" targetRef="Task_SelectStartingBlock"/>
    
    <bpmn:sequenceFlow id="Sequence_StartTestLoop" name="" sourceRef="Task_SelectStartingBlock" targetRef="Gateway_StartTestLoop"/>
    
    <bpmn:sequenceFlow id="Sequence_Run5km" name="" sourceRef="Gateway_StartTestLoop" targetRef="Task_RunFiveKm"/>
    
    <bpmn:sequenceFlow id="Sequence_MeasureTimeStart" name="" sourceRef="Gateway_StartTestLoop" targetRef="Task_MeasureTime"/>

    <bpmn:sequenceFlow id="Sequence_ConvergeTestPhase1" name="" sourceRef="Task_RunFiveKm" targetRef="Gateway_ConvergeTestPhase"/>
    
    <bpmn:sequenceFlow id="Sequence_ConvergeTestPhase2" name="" sourceRef="Task_MeasureTime" targetRef="Gateway_ConvergeTestPhase"/>

    <bpmn:sequenceFlow id="Sequence_CheckTimeResult" name="" sourceRef="Gateway_ConvergeTestPhase" targetRef="Gateway_CheckTime"/>
    
    <bpmn:sequenceFlow id="Sequence_TrainLoop" name="" sourceRef="Gateway_CheckTime" targetRef="Task_TrainingSession"/>
    
    <bpmn:sequenceFlow id="Sequence_ReturnToTest" name="" sourceRef="Task_TrainingSession" targetRef="Gateway_StartTestLoop"/>

    <bpmn:sequenceFlow id="Sequence_PassTest" name="" sourceRef="Gateway_CheckTime" targetRef="Task_GetStartingNumber"/>
    
    <bpmn:sequenceFlow id="Sequence_WorkDecisionCheck" name="" sourceRef="Task_GetStartingNumber" targetRef="Gateway_WorkScheduleCheck"/>

    <bpmn:sequenceFlow id="Sequence_GoFromHome" name="" sourceRef="Gateway_WorkScheduleCheck" targetRef="Task_GoFromHome"/>
    
    <bpmn:sequenceFlow id="Sequence_LeaveDirectlyWork" name="" sourceRef="Gateway_WorkScheduleCheck" targetRef="Task_LeaveDirectlyWork"/>

    <bpmn:sequenceFlow id="Sequence_ConvergeTravelPaths1" name="" sourceRef="Task_GoFromHome" targetRef="Gateway_ConvergeTravelPaths"/>
    
    <bpmn:sequenceFlow id="Sequence_ConvergeTravelPaths2" name="" sourceRef="Task_LeaveDirectlyWork" targetRef="Gateway_ConvergeTravelPaths"/>

    <bpmn:sequenceFlow id="Sequence_StartNightRunPhase" name="" sourceRef="Gateway_ConvergeTravelPaths" targetRef="Gateway_NightRunPhase"/>
    
    <bpmn:sequenceFlow id="Sequence_ActualRun" name="" sourceRef="Gateway_NightRunPhase" targetRef="Task_ActualRun"/>
    
    <bpmn:sequenceFlow id="Sequence_DrinkIsoSport" name="" sourceRef="Gateway_NightRunPhase" targetRef="Task_DrinkIsoSport"/>

    <bpmn:sequenceFlow id="Sequence_ConvergeNightRunPhase1" name="" sourceRef="Task_ActualRun" targetRef="Gateway_ConvergeNightRunPhase"/>
    
    <bpmn:sequenceFlow id="Sequence_ConvergeNightRunPhase2" name="" sourceRef="Task_DrinkIsoSport" targetRef="Gateway_ConvergeNightRunPhase"/>

    <bpmn:sequenceFlow id="Sequence_ReceiveFinalTime" name="" sourceRef="Gateway_ConvergeNightRunPhase" targetRef="Task_ReceiveFinalTime"/>
    
    <bpmn:sequenceFlow id="Sequence_EndRunFinished" name="" sourceRef="Task_ReceiveFinalTime" targetRef="End_Event_RunFinished"/>

  </bpmn:process>
</bpmn:definitions>