<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_FridgeRepairService" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_CustomerFridgeOwner" name="Customer Fridge Owner" processRef="Process_FridgeRepair"/>
    <bpmn:participant id="Participant_CentralServiceCenter" name="Central Service Center" processRef="Process_ServiceManagement"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_FridgeRepair" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_StrangeNoises" name="Fridge produces strange noises">
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Customer Tasks -->
    <bpmn:userTask id="Task_CustomerDescribeSymptoms" name="Describe symptoms and fridge type">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Central Service Center Tasks -->
    <bpmn:serviceTask id="Task_CentralSelectFacility" name="Select local service facility">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Service Facility Tasks -->
    <bpmn:userTask id="Task_ServiceScheduleAppointment" name="Make appointment for repair">
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Intermediate Event - Wait for arrival -->
    <bpmn:intermediateCatchEvent id="IntermediateWaitServiceArrives" name="Wait until service facility arrives">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Repair Task -->
    <bpmn:userTask id="Task_RepairFridge" name="Repair the fridge">
      <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway for additional parts -->
    <bpmn:exclusiveGateway id="Gateway_AdditionalPartsNeeded" name="Additional parts needed?">
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Parts Check Gateway -->
    <bpmn:exclusiveGateway id="Gateway_PartsInStock" name="Parts in stock?">
      <bpmn:incoming>SequenceFlow_9</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Collect parts task -->
    <bpmn:userTask id="Task_CollectParts" name="Collect additional parts in warehouse">
      <bpmn:incoming>SequenceFlow_10</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_12</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Order parts task -->
    <bpmn:serviceTask id="Task_OrderAdditionalParts" name="Service orders additional parts">
      <bpmn:incoming>SequenceFlow_11</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_13</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Intermediate Event - Wait for parts -->
    <bpmn:intermediateCatchEvent id="IntermediateWaitPartsArrive" name="Additional parts arrive">
      <bpmn:incoming>SequenceFlow_13</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Customer Confirmation Task -->
    <bpmn:userTask id="Task_CustomerConfirmRepaired" name="Confirm that fridge is OK again">
      <bpmn:incoming>SequenceFlow_7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_14</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Rating Gateway -->
    <bpmn:exclusiveGateway id="Gateway_SubmitRating" name="Submit a rating?">
      <bpmn:incoming>SequenceFlow_14</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_15</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Rating Task -->
    <bpmn:userTask id="Task_CustomerRateService" name="Rate Service Facility">
      <bpmn:incoming>SequenceFlow_16</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_17</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_RepairProcessOver" name="Repair process over">
      <bpmn:incoming>SequenceFlow_15</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Data Objects -->
    <bpmn:dataObjectReference id="Data_SymptomsReport" name="Symptoms Report"/>
    <bpmn:dataObjectReference id="Data_AppointmentDetails" name="Appointment Details"/>
    <bpmn:dataObjectReference id="Data_PartsAvailability" name="Parts Availability Check"/>

    <!-- Associations -->
    <bpmn:association id="Associ_SentReportToServiceCenter" sourceRef="Task_CustomerDescribeSymptoms" targetRef="Data_SymptomsReport"/>
    <bpmn:association id="Associ_CheckParts" sourceRef="Gateway_AdditionalPartsNeeded" targetRef="Data_PartsAvailability"/>

  </bpmn:process>

  <!-- Sequence Flows -->
  <bpmn:sequenceFlow id="SequenceFlow_1" name="" sourceRef="StartEvent_StrangeNoises" targetRef="Task_CustomerDescribeSymptoms"/>
  
  <bpmn:sequenceFlow id="SequenceFlow_2" name="Send report to service center" sourceRef="Task_CustomerDescribeSymptoms" targetRef="Task_CentralSelectFacility">
    <bpmn:documentation>Symptoms and fridge type sent to central service center</bpmn:documentation>
  </bpmn:sequenceFlow>

  <bpmn:sequenceFlow id="SequenceFlow_3" name="" sourceRef="Task_CentralSelectFacility" targetRef="Task_ServiceScheduleAppointment"/>
  
  <bpmn:sequenceFlow id="SequenceFlow_4" name="" sourceRef="Task_ServiceScheduleAppointment" targetRef="IntermediateWaitServiceArrives"/>

  <bpmn:sequenceFlow id="SequenceFlow_5" name="" sourceRef="IntermediateWaitServiceArrives" targetRef="Task_RepairFridge"/>

  <bpmn:sequenceFlow id="SequenceFlow_6" name="" sourceRef="Gateway_AdditionalPartsNeeded" targetRef="Task_CustomerConfirmRepaired">
    <bpmn:documentation>Fridge repaired successfully</bpmn:documentation>
  </bpmn:sequenceFlow>

  <bpmn:sequenceFlow id="SequenceFlow_7" name="" sourceRef="Gateway_AdditionalPartsNeeded" targetRef="Task_CheckingForParts"/>

  <!-- Parts Collection Flow -->
  <bpmn:userTask id="Task_CheckingForParts" name="Check if parts available in warehouse">
    <bpmn:incoming>SequenceFlow_7</bpmn:incoming>
    <bpmn:outgoing>SequenceFlow_9</bpmn:outgoing>
  </bpmn:userTask>

  <bpmn:dataObjectReference id="Data_WarehouseInventory" name="Warehouse Inventory Check"/>

  <bpmn:association id="Associ_CheckWarehouse" sourceRef="Gateway_PartsInStock" targetRef="Data_WarehouseInventory"/>

  <bpmn:sequenceFlow id="SequenceFlow_8" name="" sourceRef="Task_RepairFridge" targetRef="Gateway_AdditionalPartsNeeded"/>
  
  <bpmn:association id="Associ_CheckWarehouse2" sourceRef="Task_CheckingForParts" targetRef="Data_WarehouseInventory"/>

  <bpmn:sequenceFlow id="SequenceFlow_9" name="" sourceRef="Task_CheckingForParts" targetRef="Gateway_PartsInStock"/>
  
  <bpmn:dataObjectReference id="Data_OrderConfirmation" name="Parts Order Confirmation"/>

  <bpmn:association id="Associ_OrderedParts" sourceRef="Task_OrderAdditionalParts" targetRef="Data_OrderConfirmation"/>

  <bpmn:sequenceFlow id="SequenceFlow_10" name="Parts in stock - Yes" sourceRef="Gateway_PartsInStock" targetRef="Task_CollectParts">
    <bpmn:documentation>Collect parts from warehouse</bpmn:documentation>
  </bpmn:sequenceFlow>

  <bpmn:sequenceFlow id="SequenceFlow_11" name="Parts not in stock - No" sourceRef="Gateway_PartsInStock" targetRef="Task_OrderAdditionalParts">
    <bpmn:documentation>Order additional parts from supplier</bpmn:documentation>
  </bpmn:sequenceFlow>

  <!-- Parts Collection Return Flow -->
  <bpmn:sequenceFlow id="SequenceFlow_12" name="" sourceRef="Task_CollectParts" targetRef="Gateway_AdditionalPartsNeeded">
    <bpmn:documentation>Return to repair after collecting parts</bpmn:documentation>
  </bpmn:sequenceFlow>

  <!-- Parts Order Return Flow -->
  <bpmn:sequenceFlow id="SequenceFlow_13" name="" sourceRef="Task_OrderAdditionalParts" targetRef="IntermediateWaitPartsArrive"/>

  <!-- Customer Confirmation Flow -->
  <bpmn:dataObjectReference id="Data_RepairConfirmation" name="Repair Confirmation"/>

  <bpmn:association id="Associ_Confirmation" sourceRef="Task_CustomerConfirmRepaired" targetRef="Data_RepairConfirmation"/>

  <bpmn:sequenceFlow id="SequenceFlow_14" name="" sourceRef="Task_CustomerConfirmRepaired" targetRef="Gateway_SubmitRating"/>
  
  <!-- Rating Decision Flow -->
  <bpmn:dataObjectReference id="Data_CustomerRating" name="Customer Rating"/>

  <bpmn:association id="Associ_RatingSubmitted" sourceRef="Task_CustomerRateService" targetRef="Data_CustomerRating"/>

  <bpmn:sequenceFlow id="SequenceFlow_15" name="Do not submit rating" sourceRef="Gateway_SubmitRating" targetRef="EndEvent_RepairProcessOver">
    <bpmn:documentation>Customer chooses not to rate</bpmn:documentation>
  </bpmn:sequenceFlow>

  <!-- Rating Submission Flow -->
  <bpmn:serviceTask id="Task_SystemEvaluateRating" name="System evaluates rating">
    <bpmn:incoming>SequenceFlow_17</bpmn:incoming>
    <bpmn:outgoing>SequenceFlow_15</bpmn:outgoing>
  </bpmn:serviceTask>

  <bpmn:sequenceFlow id="SequenceFlow_16" name="Submit rating - Yes" sourceRef="Gateway_SubmitRating" targetRef="Task_CustomerRateService">
    <bpmn:documentation>Customer chooses to rate service</bpmn:documentation>
  </bpmn:sequenceFlow>

  <!-- Rating Submission Flow -->
  <bpmn:sequenceFlow id="SequenceFlow_17" name="" sourceRef="Task_CustomerRateService" targetRef="Task_SystemEvaluateRating"/>

  </bpmn:process>
</bpmn:definitions>