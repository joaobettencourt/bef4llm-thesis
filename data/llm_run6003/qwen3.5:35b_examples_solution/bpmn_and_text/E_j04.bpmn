<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_InternshipProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_Internship_001">
    <bpmn:participant id="Participant_Applicant_001" name="Applicant Process" processRef="Process_Internship_001"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Internship_001" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="Start_ApplyInternship_001" name="Apply for Internship">
      <bpmn:outgoing>Flow_InitialApplication_001</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Application Input Tasks -->
    <bpmn:userTask id="Task_EnterTopicMoney_001" name="Enter Topic and Money Wanted">
      <bpmn:incoming>Flow_InitialApplication_001</bpmn:incoming>
      <bpmn:outgoing>Flow_ApplyInternship_001</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_EnterExperienceHobbies_001" name="Enter Experience and Hobbies">
      <bpmn:incoming>Flow_ApplyInternship_001</bpmn:incoming>
      <bpmn:outgoing>Flow_SubmitApplication_001</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Submit Application -->
    <bpmn:serviceTask id="Task_SubmitApplication_001" name="Submit Internship Application">
      <bpmn:incoming>Flow_SubmitApplication_001</bpmn:incoming>
      <bpmn:outgoing>Flow_WaitForOffers_001</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Offer Decision Gateway -->
    <bpmn:exclusiveGateway id="Gateway_DecideOffer_001" name="Accept or Deny?">
      <bpmn:incoming>Flow_WaitForOffers_001</bpmn:incoming>
      <bpmn:outgoing>Flow_AcceptOffer_001</bpmn:outgoing>
      <bpmn:outgoing>Flow_DenyOffer_001</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Accept Offer Path -->
    <bpmn:userTask id="Task_AcceptOffer_001" name="Accept Internship Offer">
      <bpmn:incoming>Flow_AcceptOffer_001</bpmn:incoming>
      <bpmn:outgoing>Flow_StartInternship_001</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Deny Offer Path -->
    <bpmn:endEvent id="End_DenyAllOffers_001" name="No Offers Accepted">
      <bpmn:incoming>Flow_NoMoreOffers_001</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Internship Status Updates (Applicant) - Loop for 3 updates -->
    <bpmn:userTask id="Task_ApplicantStatusUpdate_001" name="Write Status Update">
      <bpmn:incoming>Flow_StatusLoop_001</bpmn:incoming>
      <bpmn:outgoing>Gateway_CheckUpdatesCount_001</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Company Status Updates - Loop for 3 updates -->
    <bpmn:serviceTask id="Task_CompanyStatusUpdate_001" name="Company Writes Update">
      <bpmn:incoming>Flow_CompanyUpdates_001</bpmn:incoming>
      <bpmn:outgoing>Gateway_CheckCompanyUpdatesCount_001</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Status Updates Count Gateway -->
    <bpmn:exclusiveGateway id="Gateway_UpdateCheck_001" name="3 updates completed?">
      <bpmn:incoming>Flow_StatusLoop_001</bpmn:incoming>
      <bpmn:outgoing>Flow_ContinueUpdates_001</bpmn:outgoing>
      <bpmn:outgoing>Flow_InternshipFinished_001</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Internship Finished -->
    <bpmn:endEvent id="End_InternshipComplete_001" name="Internship Completed">
      <bpmn:incoming>Flow_InternshipFinished_001</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Twitter Recommendation (Parallel) -->
    <bpmn:userTask id="Task_EnterFriendsTwitter_001" name="Enter Friends' Twitter Accounts">
      <bpmn:incoming>Flow_RecommendCompany_001</bpmn:incoming>
      <bpmn:outgoing>Gateway_SendTweets_001</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel Tweet Sending -->
    <bpmn:parallelGateway id="Gateway_TweetSend_001" name="Parallel Tweets">
      <bpmn:incoming>Flow_SplitTweets_001</bpmn:incoming>
      <bpmn:outgoing>Flow_SendTweet1_001</bpmn:outgoing>
      <bpmn:outgoing>Flow_SendTweet2_001</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Send Tweets -->
    <bpmn:sendTask id="Task_SendTwitterPost_001" name="Send Twitter Recommendation">
      <bpmn:incoming>Flow_TweetTasks_001</bpmn:incoming>
      <bpmn:outgoing>Flow_MergeTweets_001</bpmn:outgoing>
    </bpmn:sendTask>

    <!-- End Event -->
    <bpmn:endEvent id="End_ProcessComplete_001" name="Process Complete">
      <bpmn:incoming>Flow_TweetMerge_001</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Flow_InitialApplication_001" sourceRef="Start_ApplyInternship_001" targetRef="Task_EnterTopicMoney_001"/>
    
    <bpmn:sequenceFlow id="Flow_ApplyInternship_001" name="" sourceRef="Task_EnterTopicMoney_001" targetRef="Task_EnterExperienceHobbies_001"/>
    
    <bpmn:sequenceFlow id="Flow_SubmitApplication_001" name="" sourceRef="Task_EnterExperienceHobbies_001" targetRef="Task_SubmitApplication_001"/>
    
    <!-- Offer Flow -->
    <bpmn:sequenceFlow id="Flow_WaitForOffers_001" name="" sourceRef="Task_SubmitApplication_001" targetRef="Gateway_DecideOffer_001">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${offersArrive}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Offer Decision -->
    <bpmn:sequenceFlow id="Flow_AcceptOffer_001" name="Accept" sourceRef="Gateway_DecideOffer_001" targetRef="Task_AcceptOffer_001"/>

    <!-- Deny Offer -->
    <bpmn:sequenceFlow id="Flow_DenyOffer_001" name="Deny" sourceRef="Gateway_DecideOffer_001" targetRef="End_DenyAllOffers_001"/>

    <!-- Internship Start -->
    <bpmn:sequenceFlow id="Flow_StartInternship_001" name="" sourceRef="Task_AcceptOffer_001" targetRef="Gateway_UpdateCheck_001"/>

    <!-- Status Update Loop -->
    <bpmn:sequenceFlow id="Flow_StatusLoop_001" name="Continue Updates" sourceRef="Gateway_UpdateCheck_001" targetRef="Task_ApplicantStatusUpdate_001"/>

    <!-- Company Status Update Loop -->
    <bpmn:sequenceFlow id="Flow_CompanyUpdates_001" name="Company Updates" sourceRef="Gateway_UpdateCheck_001" targetRef="Task_CompanyStatusUpdate_001"/>

    <!-- Internship Finished -->
    <bpmn:sequenceFlow id="Flow_InternshipFinished_001" name="All Updates Complete" sourceRef="Gateway_UpdateCheck_001" targetRef="End_InternshipComplete_001"/>

    <!-- Recommendation Flow -->
    <bpmn:sequenceFlow id="Flow_RecommendCompany_001" name="Recommend Company" sourceRef="Task_AcceptOffer_001" targetRef="Gateway_TweetSend_001"/>

    <!-- Tweet Sending -->
    <bpmn:sequenceFlow id="Flow_SplitTweets_001" name="" sourceRef="Task_EnterFriendsTwitter_001" targetRef="Gateway_TweetSend_001"/>
    
    <bpmn:sequenceFlow id="Flow_SendTweet1_001" name="Tweet 1" sourceRef="Gateway_TweetSend_001" targetRef="Task_SendTwitterPost_001"/>

    <bpmn:sequenceFlow id="Flow_SendTweet2_001" name="Tweet 2" sourceRef="Gateway_TweetSend_001" targetRef="Task_SendTwitterPost_001"/>

    <!-- Tweet Merge -->
    <bpmn:parallelGateway id="Gateway_TweetMerge_001" name="Tweet Convergence">
      <bpmn:incoming>Flow_MergeTweets_001</bpmn:incoming>
      <bpmn:outgoing>Flow_TweetMerge_001</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:sequenceFlow id="Flow_MergeTweets_001" name="" sourceRef="Task_SendTwitterPost_001" targetRef="Gateway_TweetMerge_001"/>
    
    <bpmn:sequenceFlow id="Flow_TweetMerge_001" name="All Tweets Sent" sourceRef="Gateway_TweetMerge_001" targetRef="End_ProcessComplete_001"/>

  </bpmn:process>
</bpmn:definitions>