<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_StorageManagement" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_storage_management">
    <bpmn:participant id="Participant_orderProcess" name="Order Processing Process" processRef="Process_OrderProcessing"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_OrderProcessing" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Storage management">
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Read order from system -->
    <bpmn:serviceTask id="ServiceTask_1" name="Read order from automatic order management system">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Check if product is in stock -->
    <bpmn:task id="Task_1" name="Check if first product from order is in stock">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>Gateway_1</bpmn:outgoing>
    </bpmn:task>

    <!-- Decision point: Is product in stock? -->
    <bpmn:exclusiveGateway id="Gateway_1" name="Is product in stock?">
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Withdraw from warehouse -->
    <bpmn:task id="Task_2" name="Withdraw product from warehouse">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
    </bpmn:task>

    <!-- Reorder from wholesaler -->
    <bpmn:serviceTask id="ServiceTask_2" name="Reorder product from wholesaler">
      <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Wait for arrival -->
    <bpmn:task id="ServiceTask_3" name="Waiting until product arrives (handling system)">
      <bpmn:incoming>SequenceFlow_7</bpmn:incoming>
      <bpmn:outgoing>Gateway_2</bpmn:outgoing>
    </bpmn:task>

    <!-- Decision point: Delivery delay check -->
    <bpmn:exclusiveGateway id="Gateway_2" name="Arrived after more than 10 days?">
      <bpmn:incoming>SequenceFlow_8</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_9</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Demand penalty -->
    <bpmn:serviceTask id="ServiceTask_4" name="Demand delivery delay penalty from wholesaler">
      <bpmn:incoming>SequenceFlow_9</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_11</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Register in stock management system -->
    <bpmn:task id="Task_3" name="Register product in stock management system">
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_10</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_11</bpmn:incoming>
      <bpmn:outgoing>Gateway_3</bpmn:outgoing>
    </bpmn:task>

    <!-- Check if order ready for shipment -->
    <bpmn:task id="Task_4" name="Check if whole order is ready for shipment">
      <bpmn:incoming>SequenceFlow_12</bpmn:incoming>
      <bpmn:outgoing>Gateway_4</bpmn:outgoing>
    </bpmn:task>

    <!-- Decision point: Order ready for shipment? -->
    <bpmn:exclusiveGateway id="Gateway_3" name="">
      <bpmn:incoming>SequenceFlow_12</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Decision point: Order ready for shipment? -->
    <bpmn:exclusiveGateway id="Gateway_4" name="Order is ready for shipment?">
      <bpmn:incoming>SequenceFlow_13</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_14</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_20</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Parallel gateway for courier and packing -->
    <bpmn:parallelGateway id="ParallelGateway_1" name="">
      <bpmn:incoming>SequenceFlow_14</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_15</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_16</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Request courier -->
    <bpmn:task id="Task_5" name="Request courier">
      <bpmn:incoming>SequenceFlow_15</bpmn:incoming>
      <bpmn:outgoing>ParallelGateway_2</bpmn:outgoing>
    </bpmn:task>

    <!-- Pack products -->
    <bpmn:task id="Task_6" name="Pack the products">
      <bpmn:incoming>SequenceFlow_16</bpmn:incoming>
      <bpmn:outgoing>ParallelGateway_2</bpmn:outgoing>
    </bpmn:task>

    <!-- Converging gateway before shipping -->
    <bpmn:parallelGateway id="ParallelGateway_2" name="">
      <bpmn:incoming>SequenceFlow_17</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_18</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Ship order -->
    <bpmn:task id="Task_7" name="Ship the products">
      <bpmn:incoming>SequenceFlow_18</bpmn:incoming>
      <bpmn:outgoing>EndEvent_1</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_1" name="Order was shipped">
      <bpmn:incoming>SequenceFlow_19</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Loop back to select next product -->
    <bpmn:exclusiveGateway id="Gateway_5" name="">
      <bpmn:incoming>SequenceFlow_20</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_21</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flows -->
    
    <!-- Initial flow from start to read order -->
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="ServiceTask_1"/>

    <!-- From read order to check stock task -->
    <bpmn:sequenceFlow id="SequenceFlow_2" name="" sourceRef="ServiceTask_1" targetRef="Task_1"/>

    <!-- Check result flow from checking task to gateway -->
    <bpmn:sequenceFlow id="SequenceFlow_3" name="" sourceRef="Task_1" targetRef="Gateway_1"/>

    <!-- Withdraw product if in stock (Yes path) -->
    <bpmn:sequenceFlow id="SequenceFlow_4" name="Yes - In Stock" sourceRef="Gateway_1" targetRef="Task_2"/>

    <!-- Reorder product if not in stock (No path) -->
    <bpmn:sequenceFlow id="SequenceFlow_5" name="No - Not in Stock" sourceRef="Gateway_1" targetRef="ServiceTask_2"/>

    <!-- Wait for arrival after reorder -->
    <bpmn:sequenceFlow id="SequenceFlow_7" name="" sourceRef="ServiceTask_2" targetRef="ServiceTask_3"/>

    <!-- Arrival result to delivery delay check gateway -->
    <bpmn:sequenceFlow id="SequenceFlow_8" name="" sourceRef="ServiceTask_3" targetRef="Gateway_2"/>

    <!-- Demand penalty if delayed more than 10 days (Yes path) -->
    <bpmn:sequenceFlow id="SequenceFlow_9" name="Yes - More than 10 days" sourceRef="Gateway_2" targetRef="ServiceTask_4"/>

    <!-- No penalty if within time limit (No path) -->
    <bpmn:sequenceFlow id="SequenceFlow_10" name="No - Within 10 days" sourceRef="Gateway_2" targetRef="Task_3"/>

    <!-- From withdraw task to converge gateway -->
    <bpmn:exclusiveGateway id="Gateway_6" name="">
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- From penalty task to converge gateway -->
    <bpmn:sequenceFlow id="SequenceFlow_11" name="" sourceRef="ServiceTask_4" targetRef="Task_3"/>

    <!-- Converge after withdraw or register to check order ready task -->
    <bpmn:sequenceFlow id="SequenceFlow_6" name="" sourceRef="Task_2" targetRef="Gateway_6"/>

    <!-- From converge gateway to check order ready task -->
    <bpmn:sequenceFlow id="SequenceFlow_12" name="" sourceRef="Gateway_6" targetRef="Task_4"/>

    <!-- Check result flow from checking task to decision gateway -->
    <bpmn:sequenceFlow id="SequenceFlow_13" name="" sourceRef="Task_4" targetRef="Gateway_4"/>

    <!-- Proceed to shipping if order ready (Yes path) -->
    <bpmn:sequenceFlow id="SequenceFlow_14" name="Yes - Ready for Shipment" sourceRef="Gateway_4" targetRef="ParallelGateway_1"/>

    <!-- Select next product and loop back if not ready (No path) -->
    <bpmn:sequenceFlow id="SequenceFlow_20" name="No - Not Ready for Shipment" sourceRef="Gateway_4" targetRef="Gateway_5"/>

    <!-- From parallel gateway to request courier task -->
    <bpmn:sequenceFlow id="SequenceFlow_15" name="" sourceRef="ParallelGateway_1" targetRef="Task_5"/>

    <!-- From parallel gateway to pack products task (simultaneous) -->
    <bpmn:sequenceFlow id="SequenceFlow_16" name="" sourceRef="ParallelGateway_1" targetRef="Task_6"/>

    <!-- Converge before shipping after courier and packing complete -->
    <bpmn:parallelGateway id="ParallelGateway_3" name="">
      <bpmn:incoming>SequenceFlow_17</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_18</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- From request courier to converge gateway -->
    <bpmn:sequenceFlow id="SequenceFlow_17" name="" sourceRef="Task_5" targetRef="ParallelGateway_3"/>

    <!-- From pack products to converge gateway (simultaneous) -->
    <bpmn:sequenceFlow id="SequenceFlow_24" name="" sourceRef="Task_6" targetRef="ParallelGateway_3"/>

    <!-- Ship order after courier and packing complete -->
    <bpmn:sequenceFlow id="SequenceFlow_18" name="" sourceRef="ParallelGateway_3" targetRef="Task_7"/>

    <!-- Final flow to end event -->
    <bpmn:sequenceFlow id="SequenceFlow_19" name="" sourceRef="Task_7" targetRef="EndEvent_1"/>

    <!-- Loop back from select next product to start checking stock -->
    <bpmn:exclusiveGateway id="Gateway_7" name="">
      <bpmn:incoming>SequenceFlow_20</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_21</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Loop back from select next product to start checking stock -->
    <bpmn:sequenceFlow id="SequenceFlow_21" name="" sourceRef="Gateway_5" targetRef="Task_1"/>

  </bpmn:process>
</bpmn:definitions>