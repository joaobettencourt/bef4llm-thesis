<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_characterCreation">
    <bpmn:participant id="Participant_WoWCharacterProcess" name="WoW Character Creation Process" processRef="Process_CharacterCreation"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_CharacterCreation" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_characterRequest" name="Character Creation Requested">
      <bpmn:outgoing>SequenceFlow_checkBattleNet</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Check Battle.net Account Existence -->
    <bpmn:serviceTask id="ServiceCheckAccountExist" name="Check battle.net account existence">
      <bpmn:incoming>SequenceFlow_checkBattleNet</bpmn:incoming>
      <bpmn:outgoing>Gateway_accountExists</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Account Exists Decision -->
    <bpmn:exclusiveGateway id="Gateway_accountExists" name="battle.net account exists?">
      <bpmn:incoming>SequenceFlow_checkAccountResult</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_existingUserPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_newUserPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Create New Account Path -->
    <bpmn:task id="Task_createAccount" name="Create new battle.net account">
      <bpmn:incoming>SequenceFlow_newUserPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_accountCreated</bpmn:outgoing>
    </bpmn:task>

    <!-- Receive Email Confirmation -->
    <bpmn:serviceTask id="ServiceReceiveEmail" name="Receive email with confirmation link">
      <bpmn:incoming>SequenceFlow_accountCreated</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_confirmAccount</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Confirm Account Link -->
    <bpmn:task id="Task_clickLink" name="Click confirmation link">
      <bpmn:incoming>SequenceFlow_confirmAccount</bpmn:incoming>
      <bpmn:outgoing>Gateway_subscriptionCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Check Subscription -->
    <bpmn:serviceTask id="ServiceCheckSubscription" name="Check WoW subscription">
      <bpmn:incoming>SequenceFlow_existingUserPath</bpmn:incoming>
      <bpmn:outgoing>Gateway_subscriptionPresent</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Subscription Decision -->
    <bpmn:exclusiveGateway id="Gateway_subscriptionPresent" name="Subscription present?">
      <bpmn:incoming>SequenceFlow_checkSubResult</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_subscribedPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_paymentRequired</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Payment Method Selection -->
    <bpmn:task id="Task_selectPayment" name="Select payment method">
      <bpmn:incoming>SequenceFlow_paymentRequired</bpmn:incoming>
      <bpmn:outgoing>Gateway_paymentMethod</bpmn:outgoing>
    </bpmn:task>

    <!-- Payment Method Decision -->
    <bpmn:exclusiveGateway id="Gateway_paymentMethod" name="Payment method?">
      <bpmn:incoming>SequenceFlow_selectPaymentResult</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_creditCardPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_bankAccountPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Credit Card Entry -->
    <bpmn:task id="Task_enterCreditCard" name="Enter credit card information">
      <bpmn:incoming>SequenceFlow_creditCardPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_paymentComplete1</bpmn:outgoing>
    </bpmn:task>

    <!-- Bank Account Entry -->
    <bpmn:task id="Task_enterBankInfo" name="Enter IBAN and BIC numbers">
      <bpmn:incoming>SequenceFlow_bankAccountPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_paymentComplete2</bpmn:outgoing>
    </bpmn:task>

    <!-- Payment Complete Gateway -->
    <bpmn:exclusiveGateway id="Gateway_paymentMerge" name="">
      <bpmn:incoming>SequenceFlow_subscribedPath</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_paymentComplete1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_loginGame</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Login to Game -->
    <bpmn:task id="Task_loginGame" name="Log into the game">
      <bpmn:incoming>SequenceFlow_paymentComplete2</bpmn:incoming>
      <bpmn:outgoing>Gateway_characterSetup</bpmn:outgoing>
    </bpmn:task>

    <!-- Character Setup Parallel Gateway -->
    <bpmn:parallelGateway id="Gateway_characterSetup" name="">
      <bpmn:incoming>SequenceFlow_loginGameResult</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_selectRealm</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_selectRace</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_selectClass</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Select Realm -->
    <bpmn:task id="Task_selectRealm" name="Select realm">
      <bpmn:incoming>SequenceFlow_selectRealm</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_realmComplete</bpmn:outgoing>
    </bpmn:task>

    <!-- Select Race -->
    <bpmn:task id="Task_selectRace" name="Select race">
      <bpmn:incoming>SequenceFlow_selectRace</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_raceComplete</bpmn:outgoing>
    </bpmn:task>

    <!-- Select Class -->
    <bpmn:task id="Task_selectClass" name="Select class">
      <bpmn:incoming>SequenceFlow_selectClass</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_classComplete</bpmn:outgoing>
    </bpmn:task>

    <!-- Character Setup Merge -->
    <bpmn:parallelGateway id="Gateway_characterSetupMerge" name="">
      <bpmn:incoming>SequenceFlow_realmComplete</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_raceComplete</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_nameCharacter</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Enter Character Name -->
    <bpmn:task id="Task_enterName" name="Enter character name">
      <bpmn:incoming>SequenceFlow_characterSetupMergeResult</bpmn:incoming>
      <bpmn:outgoing>Gateway_nameAvailable</bpmn:outgoing>
    </bpmn:task>

    <!-- Name Availability Check -->
    <bpmn:serviceTask id="ServiceCheckName" name="Check character name availability">
      <bpmn:incoming>SequenceFlow_checkNameResult</bpmn:incoming>
      <bpmn:outgoing>Gateway_nameDecision</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Name Decision -->
    <bpmn:exclusiveGateway id="Gateway_nameAvailable" name="Character name available?">
      <bpmn:incoming>SequenceFlow_enterNameResult</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_nameTakenPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_nameAvailablePath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Enter Another Name (Loop) -->
    <bpmn:task id="Task_enterAnotherName" name="Enter another character name">
      <bpmn:incoming>SequenceFlow_nameTakenPath</bpmn:incoming>
      <bpmn:outgoing>Gateway_checkNameAgain</bpmn:outgoing>
    </bpmn:task>

    <!-- Check Name Again -->
    <bpmn:serviceTask id="ServiceCheckNameAgain" name="Check character name availability">
      <bpmn:incoming>SequenceFlow_enterAnotherResult</bpmn:incoming>
      <bpmn:outgoing>Gateway_checkNameDecision</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Name Decision Again -->
    <bpmn:exclusiveGateway id="Gateway_nameAvailableAgain" name="">
      <bpmn:incoming>SequenceFlow_checkNameResult2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_finalConfirmationPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Confirmation and Selfies -->
    <bpmn:endEvent id="EndEvent_characterCreated" name="Character created">
      <bpmn:incoming>SequenceFlow_getSelfieResult</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows - Account Check Path -->
    <bpmn:sequenceFlow id="SequenceFlow_checkBattleNet" sourceRef="StartEvent_characterRequest" targetRef="ServiceCheckAccountExist"/>
    
    <!-- Account Check Result -->
    <bpmn:sequenceFlow id="SequenceFlow_checkAccountResult" name="" sourceRef="ServiceCheckAccountExist" targetRef="Gateway_accountExists">
      <bpmn:name>check result</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- New User Path (No account) -->
    <bpmn:sequenceFlow id="SequenceFlow_newUserPath" name="" sourceRef="Gateway_accountExists" targetRef="Task_createAccount">
      <bpmn:name>no</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Existing User Path (Has account) -->
    <bpmn:sequenceFlow id="SequenceFlow_existingUserPath" name="" sourceRef="Gateway_accountExists" targetRef="ServiceCheckSubscription">
      <bpmn:name>yes</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Account Created -->
    <bpmn:sequenceFlow id="SequenceFlow_accountCreated" name="" sourceRef="Task_createAccount" targetRef="ServiceReceiveEmail"/>

    <!-- Confirm Link Received -->
    <bpmn:sequenceFlow id="SequenceFlow_confirmAccount" name="" sourceRef="ServiceReceiveEmail" targetRef="Task_clickLink">
      <bpmn:name>confirmation link received</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Subscription Check Result -->
    <bpmn:sequenceFlow id="SequenceFlow_checkSubResult" name="" sourceRef="ServiceCheckSubscription" targetRef="Gateway_subscriptionPresent"/>

    <!-- Subscribed Path (Has subscription) -->
    <bpmn:sequenceFlow id="SequenceFlow_subscribedPath" name="" sourceRef="Gateway_subscriptionPresent" targetRef="Gateway_paymentMerge">
      <bpmn:name>yes</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Payment Required Path (No subscription) -->
    <bpmn:sequenceFlow id="SequenceFlow_paymentRequired" name="" sourceRef="Gateway_subscriptionPresent" targetRef="Task_selectPayment">
      <bpmn:name>no</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Payment Method Selection Result -->
    <bpmn:sequenceFlow id="SequenceFlow_selectPaymentResult" name="" sourceRef="Task_selectPayment" targetRef="Gateway_paymentMethod"/>

    <!-- Credit Card Path -->
    <bpmn:sequenceFlow id="SequenceFlow_creditCardPath" name="" sourceRef="Gateway_paymentMethod" targetRef="Task_enterCreditCard">
      <bpmn:name>Credit card</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Bank Account Path -->
    <bpmn:sequenceFlow id="SequenceFlow_bankAccountPath" name="" sourceRef="Gateway_paymentMethod" targetRef="Task_enterBankInfo">
      <bpmn:name>Bank account</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Payment Complete Paths -->
    <bpmn:sequenceFlow id="SequenceFlow_paymentComplete1" name="" sourceRef="Task_enterCreditCard" targetRef="Gateway_paymentMerge"/>
    
    <!-- Bank Payment Complete -->
    <bpmn:sequenceFlow id="SequenceFlow_paymentComplete2" name="" sourceRef="Task_enterBankInfo" targetRef="Gateway_paymentMerge"/>

    <!-- Login Game -->
    <bpmn:sequenceFlow id="SequenceFlow_loginGame" name="" sourceRef="Gateway_paymentMerge" targetRef="Task_loginGame"/>

    <!-- Character Setup Start -->
    <bpmn:sequenceFlow id="SequenceFlow_loginGameResult" name="" sourceRef="Task_loginGame" targetRef="Gateway_characterSetup"/>

    <!-- Parallel Tasks for Realm, Race, Class -->
    <bpmn:sequenceFlow id="SequenceFlow_selectRealm" name="" sourceRef="Gateway_characterSetup" targetRef="Task_selectRealm">
      <bpmn:name>realm</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_selectRace" name="" sourceRef="Gateway_characterSetup" targetRef="Task_selectRace">
      <bpmn:name>race</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_selectClass" name="" sourceRef="Gateway_characterSetup" targetRef="Task_selectClass">
      <bpmn:name>class</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Character Setup Completion -->
    <bpmn:sequenceFlow id="SequenceFlow_realmComplete" name="" sourceRef="Task_selectRealm" targetRef="Gateway_characterSetupMerge"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_raceComplete" name="" sourceRef="Task_selectRace" targetRef="Gateway_characterSetupMerge"/>

    <!-- Character Name Entry -->
    <bpmn:sequenceFlow id="SequenceFlow_nameCharacter" name="" sourceRef="Gateway_characterSetupMerge" targetRef="Task_enterName">
      <bpmn:name>character setup complete</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Name Entry Result -->
    <bpmn:sequenceFlow id="SequenceFlow_enterNameResult" name="" sourceRef="Task_enterName" targetRef="Gateway_nameAvailable"/>

    <!-- Service Task for Name Check -->
    <bpmn:sequenceFlow id="SequenceFlow_checkNameResult" name="" sourceRef="ServiceCheckName" targetRef="Gateway_nameDecision">
      <bpmn:name>name checked</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Name Taken Path (Loop) -->
    <bpmn:sequenceFlow id="SequenceFlow_nameTakenPath" name="" sourceRef="Gateway_nameAvailable" targetRef="Task_enterAnotherName">
      <bpmn:name>not available</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Name Available Path -->
    <bpmn:sequenceFlow id="SequenceFlow_nameAvailablePath" name="" sourceRef="Gateway_nameAvailable" targetRef="EndEvent_characterCreated">
      <bpmn:name>available</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Another Name Entry -->
    <bpmn:sequenceFlow id="SequenceFlow_enterAnotherResult" name="" sourceRef="Task_enterAnotherName" targetRef="ServiceCheckNameAgain"/>

    <!-- Second Check Result -->
    <bpmn:sequenceFlow id="SequenceFlow_checkNameResult2" name="" sourceRef="ServiceCheckNameAgain" targetRef="Gateway_nameAvailableAgain">
      <bpmn:name>name checked</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Final Confirmation Path -->
    <bpmn:sequenceFlow id="SequenceFlow_finalConfirmationPath" name="" sourceRef="Gateway_nameAvailableAgain" targetRef="EndEvent_characterCreated">
      <bpmn:name>available</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>