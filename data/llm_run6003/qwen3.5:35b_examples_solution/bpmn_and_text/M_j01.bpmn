<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_ChainsawProduction">
    <bpmn:participant id="Participant_Manufacturer" name="Chainsaw Manufacturer" processRef="Process_ChainsawOrder"/>
    <bpmn:participant id="Participant_Customer" name="Customer"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_ChainsawOrder" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_OrderRequest" name="Chainsaw Order Request">
      <bpmn:outgoing>SequenceFlow_RequestProperties</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Send Task to Customer for Properties -->
    <bpmn:sendTask id="SendTask_RequestProperties" name="Request Chainsaw Properties">
      <bpmn:incoming>SequenceFlow_RequestProperties</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendToCustomer</bpmn:outgoing>
    </bpmn:sendTask>

    <!-- Receive Task for Customer Response -->
    <bpmn:receiveTask id="ReceiveTask_Properties" name="Receive Properties">
      <bpmn:incoming>SequenceFlow_SendToCustomer</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SetProperties</bpmn:outgoing>
    </bpmn:receiveTask>

    <!-- Manual Task for Setting Properties -->
    <bpmn:manualTask id="ManualTask_SetProperties" name="Set Chainsaw Properties">
      <bpmn:incoming>SequenceFlow_SetProperties</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OrderPartsStart</bpmn:outgoing>
    </bpmn:manualTask>

    <!-- Parallel Gateway for Ordering Parts -->
    <bpmn:parallelGateway id="ParallelGateway_StartOrdering">
      <bpmn:incoming>SequenceFlow_OrderPartsStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OrderGuideBar</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_OrderChain</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_OrderMotor</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Service Tasks for Ordering Parts in Parallel -->
    <bpmn:serviceTask id="ServiceTask_GuideBar" name="Order Guide Bar">
      <bpmn:incoming>SequenceFlow_OrderGuideBar</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GuideBarOrdered</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="ServiceTask_Chain" name="Order Chain">
      <bpmn:incoming>SequenceFlow_OrderChain</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ChainOrdered</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="ServiceTask_Motor" name="Order Motor">
      <bpmn:incoming>SequenceFlow_OrderMotor</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MotorOrdered</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Parallel Gateway for Convergence -->
    <bpmn:parallelGateway id="ParallelGateway_PartsArrived">
      <bpmn:incoming>SequenceFlow_GuideBarOrdered</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ChainOrdered</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_MotorOrdered</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InspectPartsStart</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Manual Task for Inspection -->
    <bpmn:manualTask id="ManualTask_Inspect" name="Inspect Parts">
      <bpmn:incoming>SequenceFlow_InspectPartsStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AssembleStart</bpmn:outgoing>
    </bpmn:manualTask>

    <!-- Manual Task for Assembly -->
    <bpmn:manualTask id="ManualTask_Assemble" name="Assemble Parts">
      <bpmn:incoming>SequenceFlow_AssembleStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendToCustomerFirstSaw</bpmn:outgoing>
    </bpmn:manualTask>

    <!-- Intermediate Catch Event for Regular Updates -->
    <bpmn:intermediateCatchEvent id="IntermediateUpdate" name="Regular Update">
      <bpmn:incoming>SequenceFlow_SendToCustomerFirstSaw</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ContinueProduction</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Send First Saw to Customer -->
    <bpmn:sendTask id="SendTask_SendFirstSaw" name="Send Chainsaw to Customer">
      <bpmn:incoming>SequenceFlow_ContinueProduction</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CustomerFeedbackReceived</bpmn:outgoing>
    </bpmn:sendTask>

    <!-- Receive Feedback from Customer -->
    <bpmn:receiveTask id="ReceiveTask_Feedback" name="Receive Feedback">
      <bpmn:incoming>SequenceFlow_CustomerFeedbackReceived</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckCustomerApproval</bpmn:outgoing>
    </bpmn:receiveTask>

    <!-- Exclusive Gateway for Customer Approval -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_CustomerLikes">
      <bpmn:incoming>SequenceFlow_CheckCustomerApproval</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProceedWithOrder</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RetryProduction</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Send Task for Requesting Number of Chainsaws -->
    <bpmn:sendTask id="SendTask_RequestQuantity" name="Request Quantity Needed">
      <bpmn:incoming>SequenceFlow_ProceedWithOrder</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReceiveQuantity</bpmn:outgoing>
    </bpmn:sendTask>

    <!-- Receive Task for Customer Quantity -->
    <bpmn:receiveTask id="ReceiveTask_Quantity" name="Receive Quantity Needed">
      <bpmn:incoming>SequenceFlow_ReceiveQuantity</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckIfMoreNeeded</bpmn:outgoing>
    </bpmn:receiveTask>

    <!-- Exclusive Gateway for Production Decision -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_MoreChainsaws">
      <bpmn:incoming>SequenceFlow_CheckIfMoreNeeded</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProduceRest</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_OrderComplete</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Manual Task for Producing Rest -->
    <bpmn:manualTask id="ManualTask_ProduceRest" name="Produce Remaining Chainsaws">
      <bpmn:incoming>SequenceFlow_ProduceRest</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendToCustomerMore</bpmn:outgoing>
    </bpmn:manualTask>

    <!-- Send Task for Remaining Chainsaws -->
    <bpmn:sendTask id="SendTask_SendRest" name="Send Rest of Order">
      <bpmn:incoming>SequenceFlow_SendToCustomerMore</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OrderCompleteFinal</bpmn:outgoing>
    </bpmn:sendTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Completed" name="Order Completed">
      <bpmn:incoming>SequenceFlow_OrderCompleteFinal</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows for Retry Path (Customer Dislikes) -->
    <bpmn:sequenceFlow id="SequenceFlow_RetryProduction" name="No - Retry Production" sourceRef="ExclusiveGateway_CustomerLikes" targetRef="ManualTask_SetProperties"/>

    <!-- Sequence Flows for Order Complete Path -->
    <bpmn:sequenceFlow id="SequenceFlow_OrderComplete" name="No - No More Needed" sourceRef="ExclusiveGateway_MoreChainsaws" targetRef="EndEvent_Completed"/>

    <!-- Main Flow Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_RequestProperties" sourceRef="StartEvent_OrderRequest" targetRef="SendTask_RequestProperties"/>
    <bpmn:sequenceFlow id="SequenceFlow_SendToCustomer" name="" sourceRef="SendTask_RequestProperties" targetRef="ReceiveTask_Properties"/>
    <bpmn:sequenceFlow id="SequenceFlow_SetProperties" sourceRef="ReceiveTask_Properties" targetRef="ManualTask_SetProperties"/>
    <bpmn:sequenceFlow id="SequenceFlow_OrderPartsStart" sourceRef="ManualTask_SetProperties" targetRef="ParallelGateway_StartOrdering"/>

    <!-- Parallel Ordering Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_OrderGuideBar" name="" sourceRef="ParallelGateway_StartOrdering" targetRef="ServiceTask_GuideBar"/>
    <bpmn:sequenceFlow id="SequenceFlow_OrderChain" name="" sourceRef="ParallelGateway_StartOrdering" targetRef="ServiceTask_Chain"/>
    <bpmn:sequenceFlow id="SequenceFlow_OrderMotor" name="" sourceRef="ParallelGateway_StartOrdering" targetRef="ServiceTask_Motor"/>

    <!-- Convergence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_GuideBarOrdered" name="" sourceRef="ServiceTask_GuideBar" targetRef="ParallelGateway_PartsArrived"/>
    <bpmn:sequenceFlow id="SequenceFlow_ChainOrdered" name="" sourceRef="ServiceTask_Chain" targetRef="ParallelGateway_PartsArrived"/>
    <bpmn:sequenceFlow id="SequenceFlow_MotorOrdered" name="" sourceRef="ServiceTask_Motor" targetRef="ParallelGateway_PartsArrived"/>

    <!-- Production Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_InspectPartsStart" sourceRef="ParallelGateway_PartsArrived" targetRef="ManualTask_Inspect"/>
    <bpmn:sequenceFlow id="SequenceFlow_AssembleStart" sourceRef="ManualTask_Inspect" targetRef="ManualTask_Assemble"/>

    <!-- Customer Feedback Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_SendToCustomerFirstSaw" sourceRef="ManualTask_Assemble" targetRef="IntermediateUpdate"/>
    <bpmn:sequenceFlow id="SequenceFlow_ContinueProduction" sourceRef="IntermediateUpdate" targetRef="SendTask_SendFirstSaw"/>
    <bpmn:sequenceFlow id="SequenceFlow_CustomerFeedbackReceived" sourceRef="SendTask_SendFirstSaw" targetRef="ReceiveTask_Feedback"/>

    <!-- Decision Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckCustomerApproval" name="" sourceRef="ReceiveTask_Feedback" targetRef="ExclusiveGateway_CustomerLikes"/>
    <bpmn:sequenceFlow id="SequenceFlow_ProceedWithOrder" name="Yes - Customer Likes" sourceRef="ExclusiveGateway_CustomerLikes" targetRef="SendTask_RequestQuantity"/>

    <!-- Quantity Decision Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_ReceiveQuantity" sourceRef="SendTask_RequestQuantity" targetRef="ReceiveTask_Quantity"/>
    <bpmn:sequenceFlow id="SequenceFlow_CheckIfMoreNeeded" name="" sourceRef="ReceiveTask_Quantity" targetRef="ExclusiveGateway_MoreChainsaws"/>

    <!-- Production Rest Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_ProduceRest" name="Yes - Produce More" sourceRef="ExclusiveGateway_MoreChainsaws" targetRef="ManualTask_ProduceRest"/>

    <!-- Final Send Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_SendToCustomerMore" sourceRef="ManualTask_ProduceRest" targetRef="SendTask_SendRest"/>

    <!-- Final Completion Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_OrderCompleteFinal" name="" sourceRef="SendTask_SendRest" targetRef="EndEvent_Completed"/>

  </bpmn:process>
</bpmn:definitions>