<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_BuildingTreeHouse" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_TreeHouseProcess">
    <bpmn:participant id="Participant_Customer" name="Customer" processRef="Process_TreeHouseConstruction"/>
    <bpmn:participant id="Participant_Architect" name="Tree House Architect"/>
  </bpmn:collaboration>

  <bpmn:message id="Message_RequirementsSent" name="Project Requirements"/>
  <bpmn:message id="Message_DraftReceived" name="Draft Plan"/>
  <bpmn:message id="Message_BuildRequest" name="Build Request"/>

  <bpmn:process id="Process_TreeHouseConstruction" isExecutable="false">

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_WishToBuild" name="Wish to build tree house">
      <bpmn:outgoing>SequenceFlow_CollectRequirements</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Collect Requirements Task -->
    <bpmn:userTask id="Task_CollectRequirements" name="Collect requirements">
      <bpmn:incoming>SequenceFlow_CollectRequirements</bpmn:incoming>
      <bpmn:outgoing>Gateway_InitialRefinementCheck</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Send Requirements to Architect (Message Flow) -->
    <bpmn:userTask id="Task_SendRequirements" name="Send requirements">
      <bpmn:incoming>SequenceFlow_CollectRequirements</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitForDraft</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Intermediate Catch Event - Wait for Draft -->
    <bpmn:intermediateCatchEvent id="IntermediateEvent_DraftReceived" name="Draft received">
      <bpmn:messageEventDefinition messageRef="Message_DraftReceived"/>
      <bpmn:incoming>SequenceFlow_WaitForDraft</bpmn:incoming>
      <bpmn:outgoing>Gateway_ReviewDraftSufficient</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Review Draft Gateway -->
    <bpmn:exclusiveGateway id="Gateway_ReviewDraftSufficient" name="Draft sufficient?">
      <bpmn:incoming>SequenceFlow_DraftReceived</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RefineRequirements</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CreateMaterialsList</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Refine Requirements Task -->
    <bpmn:userTask id="Task_RefineRequirements" name="Refine requirements">
      <bpmn:incoming>SequenceFlow_RefineRequirements</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendToArchitectLoopback</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Create Materials List Task -->
    <bpmn:userTask id="Task_CreateMaterialsList" name="Create list of needed materials">
      <bpmn:incoming>SequenceFlow_CreateMaterialsList</bpmn:incoming>
      <bpmn:outgoing>Gateway_ParallelOrdering</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel Gateway for Ordering and Building -->
    <bpmn:parallelGateway id="Gateway_ParallelOrdering" name="">
      <bpmn:incoming>SequenceFlow_CreateMaterialsList</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OrderMaterials</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SendBuildRequest</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Order Materials Task -->
    <bpmn:userTask id="Task_OrderMaterials" name="Order materials from online stores">
      <bpmn:incoming>SequenceFlow_OrderMaterials</bpmn:incoming>
      <bpmn:outgoing>IntermediateEvent_MaterialsOrdered</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Intermediate Event - Materials Ordered -->
    <bpmn:intermediateCatchEvent id="IntermediateEvent_MaterialsOrdered" name="Materials ordered">
      <bpmn:messageEventDefinition messageRef="Message_DraftReceived"/>
      <bpmn:incoming>SequenceFlow_OrderedComplete</bpmn:incoming>
      <bpmn:outgoing>Gateway_WaitForBuildingCompletion</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Send Build Request to Friends (Message Flow) -->
    <bpmn:userTask id="Task_SendBuildRequest" name="Send messages to friends">
      <bpmn:incoming>SequenceFlow_SendBuildRequest</bpmn:incoming>
      <bpmn:messageEventDefinition messageRef="Message_BuildRequest"/>
      <bpmn:outgoing>Gateway_WaitForBuildingCompletion</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel Gateway for Building Completion -->
    <bpmn:parallelGateway id="Gateway_WaitForBuildingCompletion" name="">
      <bpmn:incoming>SequenceFlow_MaterialsOrderedComplete</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_BuildingCompleted</bpmn:incoming>
      <bpmn:outgoing>Task_SendPartyInvitations</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Send Party Invitations Task -->
    <bpmn:userTask id="Task_SendPartyInvitations" name="Send invitations for tree house party">
      <bpmn:incoming>SequenceFlow_WaitForBuildingCompletion</bpmn:incoming>
      <bpmn:outgoing>Gateway_CreateGuestList</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Create Guest List Task -->
    <bpmn:userTask id="Task_CreateGuestList" name="Create list of people attending party">
      <bpmn:incoming>SequenceFlow_CreateGuestList</bpmn:incoming>
      <bpmn:outgoing>EndEvent_PartyPrepared</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_PartyPrepared" name="Party prepared">
      <bpmn:incoming>SequenceFlow_CreateGuestList</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_CollectRequirements" sourceRef="StartEvent_WishToBuild" targetRef="Task_CollectRequirements"/>
    <bpmn:sequenceFlow id="SequenceFlow_SendToArchitect" name="" sourceRef="Task_CollectRequirements" targetRef="Task_SendRequirements">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${requirementsCollected}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_WaitForDraft" sourceRef="Task_SendRequirements" targetRef="IntermediateEvent_DraftReceived"/>
    <bpmn:sequenceFlow id="SequenceFlow_DraftReceived" name="" sourceRef="IntermediateEvent_DraftReceived" targetRef="Gateway_ReviewDraftSufficient">
      <bpmn:messageEventDefinition messageRef="Message_DraftReceived"/>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_RefineRequirements" name="No - Refine" sourceRef="Gateway_ReviewDraftSufficient" targetRef="Task_RefineRequirements">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${draftNotSufficient}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_SendToArchitectLoopback" name="" sourceRef="Task_RefineRequirements" targetRef="Gateway_ReviewDraftSufficient">
      <bpmn:messageEventDefinition messageRef="Message_DraftReceived"/>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_CreateMaterialsList" name="Yes - Sufficient" sourceRef="Gateway_ReviewDraftSufficient" targetRef="Task_CreateMaterialsList">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${draftSufficient}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_OrderMaterials" sourceRef="Gateway_ParallelOrdering" targetRef="Task_OrderMaterials"/>
    <bpmn:sequenceFlow id="SequenceFlow_SendBuildRequest" name="" sourceRef="Gateway_ParallelOrdering" targetRef="Task_SendBuildRequest">
      <bpmn:messageEventDefinition messageRef="Message_BuildRequest"/>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_OrderedComplete" sourceRef="Task_OrderMaterials" targetRef="IntermediateEvent_MaterialsOrdered"/>
    <bpmn:sequenceFlow id="SequenceFlow_MaterialsOrderedComplete" name="" sourceRef="IntermediateEvent_MaterialsOrdered" targetRef="Gateway_WaitForBuildingCompletion">
      <bpmn:messageEventDefinition messageRef="Message_DraftReceived"/>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_BuildingCompleted" name="" sourceRef="Task_SendBuildRequest" targetRef="Gateway_WaitForBuildingCompletion">
      <bpmn:messageEventDefinition messageRef="Message_BuildRequest"/>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_WaitForBuildingCompletion" name="" sourceRef="Gateway_WaitForBuildingCompletion" targetRef="Task_SendPartyInvitations">
      <bpmn:messageEventDefinition messageRef="Message_BuildRequest"/>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_CreateGuestList" sourceRef="Task_SendPartyInvitations" targetRef="Task_CreateGuestList"/>

  </bpmn:process>

</bpmn:definitions>