<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_InspectionMachine" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_MachineInspection">
    <bpmn:participant id="Participant_ServiceProcess" name="Energy Drink Bottling Machine Inspection Process" processRef="Process_Inspection"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Inspection" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_MachineConnected" name="Machine Connected">
      <bpmn:outgoing>SequenceFlow_EnterInfo</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- User Task - Enter Machine Information -->
    <bpmn:userTask id="UserTask_EnterMachineInfo" name="Enter machine type and serial number">
      <bpmn:incoming>SequenceFlow_EnterInfo</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StartInspection</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Start Inspection -->
    <bpmn:startEvent id="StartEvent_InspectionBegin" name="Inspection Begin">
      <bpmn:incoming>SequenceFlow_StartInspection</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AskQuestions</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- User Task - Ask Questions -->
    <bpmn:userTask id="UserTask_AskQuestions" name="Ask questions and input values">
      <bpmn:incoming>SequenceFlow_AskQuestions</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckResults</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Exclusive Gateway - Check Results -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_CheckResults" name="Additional questions needed?">
      <bpmn:incoming>SequenceFlow_CheckResults</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_YesMoreQuestions</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoProceedToTest</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Service Task - Automatic Data Collection -->
    <bpmn:serviceTask id="ServiceTask_AutoCollectData" name="Press buttons and collect values from machine">
      <bpmn:incoming>SequenceFlow_NoProceedToTest</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ResultsValid</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Exclusive Gateway - Results Valid -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_ResultsValid" name="Inspection results valid?">
      <bpmn:incoming>SequenceFlow_ResultsValid</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ValidProceedToReport</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_InvalidRetryInspection</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- User Task - Write Final Report -->
    <bpmn:userTask id="UserTask_WriteReport" name="Write final inspection report">
      <bpmn:incoming>SequenceFlow_ValidProceedToReport</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndInspection</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event - Inspection Completed -->
    <bpmn:endEvent id="EndEvent_InspectionCompleted" name="Inspection completed">
      <bpmn:incoming>SequenceFlow_EndInspection</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_EnterInfo" sourceRef="StartEvent_MachineConnected" targetRef="UserTask_EnterMachineInfo"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_StartInspection" name="" sourceRef="UserTask_EnterMachineInfo" targetRef="StartEvent_InspectionBegin"/>

    <bpmn:sequenceFlow id="SequenceFlow_AskQuestions" sourceRef="StartEvent_InspectionBegin" targetRef="UserTask_AskQuestions"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_CheckResults" name="" sourceRef="UserTask_AskQuestions" targetRef="ExclusiveGateway_CheckResults"/>

    <bpmn:sequenceFlow id="SequenceFlow_YesMoreQuestions" name="Yes - More questions needed" sourceRef="ExclusiveGateway_CheckResults" targetRef="UserTask_AskQuestions"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_NoProceedToTest" name="No - Proceed to test" sourceRef="ExclusiveGateway_CheckResults" targetRef="ServiceTask_AutoCollectData"/>

    <bpmn:sequenceFlow id="SequenceFlow_ResultsValid" name="" sourceRef="ServiceTask_AutoCollectData" targetRef="ExclusiveGateway_ResultsValid"/>

    <bpmn:sequenceFlow id="SequenceFlow_ValidProceedToReport" name="Yes - Valid results" sourceRef="ExclusiveGateway_ResultsValid" targetRef="UserTask_WriteReport"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_InvalidRetryInspection" name="No - Retry inspection" sourceRef="ExclusiveGateway_ResultsValid" targetRef="StartEvent_AskQuestionsAgain"/>

    <!-- Start Event for Retry Path -->
    <bpmn:startEvent id="StartEvent_AskQuestionsAgain" name="">
      <bpmn:outgoing>SequenceFlow_RetryAskQuestions</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:sequenceFlow id="SequenceFlow_RetryAskQuestions" sourceRef="StartEvent_AskQuestionsAgain" targetRef="UserTask_AskQuestions"/>

    <!-- End Sequence Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_EndInspection" name="" sourceRef="UserTask_WriteReport" targetRef="EndEvent_InspectionCompleted"/>

  </bpmn:process>
</bpmn:definitions>