<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_LegoMachineBuilding">
    <bpmn:participant id="Participant_MachineBuilderProcess" name="Custom Machine Building Process" processRef="Process_LegoMachine"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_LegoMachine" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_MachineBuilding" name="Custom machine building">
      <bpmn:outgoing>SequenceFlow_DesignDevelopment</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Design Phase -->
    <bpmn:userTask id="Task_DevelopDesign" name="Develop basic design">
      <bpmn:incoming>SequenceFlow_DesignDevelopment</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OrderSets</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Ordering Phase -->
    <bpmn:userTask id="Task_OrderLegoSets" name="Order Lego brick sets">
      <bpmn:incoming>SequenceFlow_OrderSets</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SortParts</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Sorting Phase -->
    <bpmn:userTask id="Task_SortParts" name="Sort parts into containers">
      <bpmn:incoming>SequenceFlow_SortParts</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckSubcomponentsLoop</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Subcomponent Building Loop Gateway -->
    <bpmn:exclusiveGateway id="Gateway_MoreSubcomponents" name="More subcomponents needed?">
      <bpmn:incoming>SequenceFlow_CheckNextComponent</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BuildNextComponent</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_AssembleAllComponents</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Build Subcomponent Task -->
    <bpmn:userTask id="Task_BuildSubcomponent" name="Build subcomponent">
      <bpmn:incoming>SequenceFlow_BuildNextComponent</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TestSubcomponent</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Test Subcomponent Task -->
    <bpmn:userTask id="Task_TestSubcomponent" name="Test subcomponent">
      <bpmn:incoming>SequenceFlow_BuildNextComponent</bpmn:incoming>
      <bpmn:outgoing>Gateway_TestResult</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Test Result Gateway -->
    <bpmn:exclusiveGateway id="Gateway_TestResult" name="Test successful?">
      <bpmn:incoming>SequenceFlow_TestSubcomponent</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AssembleComponent</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RedesignFailed</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Redesign Task -->
    <bpmn:userTask id="Task_RedesignSubcomponent" name="Redesign subcomponent">
      <bpmn:incoming>SequenceFlow_RedesignFailed</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RebuildComponent</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Reorder Parts Task -->
    <bpmn:userTask id="Task_ReorderParts" name="Reorder individual parts">
      <bpmn:incoming>SequenceFlow_NeedMoreParts</bpmn:incoming>
      <bpmn:outgoing>Gateway_MoreSubcomponents</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parts Availability Check Gateway -->
    <bpmn:exclusiveGateway id="Gateway_PartsAvailable" name="Parts available?">
      <bpmn:incoming>SequenceFlow_CheckPartAvailability</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BuildWithExistingParts</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NeedMoreParts</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Assembly Task -->
    <bpmn:userTask id="Task_AssembleMachine" name="Assemble machine">
      <bpmn:incoming>SequenceFlow_AssembleAllComponents</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FinalCheck</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_MachineComplete" name="Machine built">
      <bpmn:incoming>SequenceFlow_FinishedBuilding</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows - Design Phase -->
    <bpmn:sequenceFlow id="SequenceFlow_DesignDevelopment" sourceRef="StartEvent_MachineBuilding" targetRef="Task_DevelopDesign"/>
    
    <!-- Ordering and Sorting Phase -->
    <bpmn:sequenceFlow id="SequenceFlow_OrderSets" name="" sourceRef="Task_DevelopDesign" targetRef="Task_OrderLegoSets"/>
    <bpmn:sequenceFlow id="SequenceFlow_SortParts" name="" sourceRef="Task_OrderLegoSets" targetRef="Task_SortParts"/>

    <!-- Subcomponent Loop Entry -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckSubcomponentsLoop" name="Start subcomponent loop" sourceRef="Task_SortParts" targetRef="Gateway_MoreSubcomponents">
      <bpmn:name>Check if more components needed</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Build Next Component Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_BuildNextComponent" name="" sourceRef="Gateway_MoreSubcomponents" targetRef="Task_BuildSubcomponent"/>

    <!-- Part Availability Check Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckPartAvailability" name="" sourceRef="Task_BuildSubcomponent" targetRef="Gateway_PartsAvailable">
      <bpmn:name>Check parts availability</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Build with existing parts -->
    <bpmn:sequenceFlow id="SequenceFlow_BuildWithExistingParts" name="" sourceRef="Gateway_PartsAvailable" targetRef="Task_TestSubcomponent"/>

    <!-- Part Reordering Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_NeedMoreParts" name="" sourceRef="Gateway_PartsAvailable" targetRef="Task_ReorderParts">
      <bpmn:name>Need more parts</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Test Result Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_TestSubcomponent" name="" sourceRef="Gateway_PartsAvailable" targetRef="Task_TestSubcomponent"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_AssembleComponent" name="Test successful" sourceRef="Gateway_TestResult" targetRef="Gateway_MoreSubcomponents">
      <bpmn:name>Pass test</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Redesign Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_RedesignFailed" name="" sourceRef="Gateway_TestResult" targetRef="Task_RedesignSubcomponent">
      <bpmn:name>Redesign failed component</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Rebuild Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_RebuildComponent" name="" sourceRef="Task_RedesignSubcomponent" targetRef="Gateway_MoreSubcomponents">
      <bpmn:name>Rebuild component</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Assembly Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_AssembleAllComponents" name="" sourceRef="Gateway_MoreSubcomponents" targetRef="Task_AssembleMachine">
      <bpmn:name>All subcomponents complete</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Final Check Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_FinalCheck" name="" sourceRef="Task_AssembleMachine" targetRef="EndEvent_MachineComplete">
      <bpmn:name>Final assembly complete</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>