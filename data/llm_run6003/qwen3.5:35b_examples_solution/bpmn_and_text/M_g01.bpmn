<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                 xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                 xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                 xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
                 id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="3D Model Creation and Printing Process" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Instruct artist to create project">
      <bpmn:outgoing>SequenceFlow_001</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Send sketches task -->
    <bpmn:userTask id="UserTask_sendSketches" name="Send several sketches to artist">
      <bpmn:incoming>SequenceFlow_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_002</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Receive model from artist -->
    <bpmn:userTask id="UserTask_receiveModel" name="Receive 3D model (STL) from artist">
      <bpmn:incoming>SequenceFlow_002</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_003</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Satisfaction check gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_satisfied" name="Satisfied with result?">
      <bpmn:incoming>SequenceFlow_003</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_loopBack</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_proceedToColorSelection</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Revision task -->
    <bpmn:userTask id="UserTask_revision" name="Tell artist what to change">
      <bpmn:incoming>SequenceFlow_loopBack</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_002</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Choose plastic color -->
    <bpmn:manualTask id="ManualTask_chooseColor" name="Choose a plastic color for 3D printing">
      <bpmn:incoming>SequenceFlow_proceedToColorSelection</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_checkStockAtHome</bpmn:outgoing>
    </bpmn:manualTask>

    <!-- Check if color at home -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_colorAtHome" name="Have color at home?">
      <bpmn:incoming>SequenceFlow_checkStockAtHome</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_orderColorPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_checkQuantityPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Check quantity -->
    <bpmn:userTask id="UserTask_checkQuantity" name="Check how much color you have left">
      <bpmn:incoming>SequenceFlow_checkQuantityPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_quantityDecision</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Quantity decision gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_under100g" name="Under 100 grams?">
      <bpmn:incoming>SequenceFlow_quantityDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_addToShoppingListPath</bpmn:outgoing/>
      <bpmn:outgoing>SequenceFlow_haveEnoughPlasticPath</bpmn:outgoing/>
    </bpmn:exclusiveGateway>

    <!-- Add to shopping list -->
    <bpmn:userTask id="UserTask_shoppingList" name="Put color on shopping list">
      <bpmn:incoming>SequenceFlow_addToShoppingListPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_convergeAfterStockCheck</bpmn:outgoing/>
    </bpmn:userTask>

    <!-- Order color -->
    <bpmn:userTask id="UserTask_orderColor" name="Order plastic color">
      <bpmn:incoming>SequenceFlow_orderColorPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_convergeAfterStockCheck</bpmn:outgoing/>
    </bpmn:userTask>

    <!-- Converging gateway after stock check -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_stockConvergence" name="">
      <bpmn:incoming>SequenceFlow_addToShoppingListPath</bpmn:incoming/>
      <bpmn:incoming>SequenceFlow_haveEnoughPlasticPath</bpmn:incoming/>
      <bpmn:outgoing>SequenceFlow_convergeAfterStockCheck</bpmn:outgoing/>
    </bpmn:exclusiveGateway>

    <!-- Parallel gateway for printer setup and gcode generation -->
    <bpmn:parallelGateway id="ParallelGateway_printerSetup" name="">
      <bpmn:incoming>SequenceFlow_convergeAfterStockCheck</bpmn:incoming/>
      <bpmn:outgoing>SequenceFlow_turnOnPrinterPath</bpmn:outgoing/>
      <bpmn:outgoing>SequenceFlow_generateGcodePath</bpmn:outgoing/>
    </bpmn:parallelGateway>

    <!-- Turn on printer -->
    <bpmn:userTask id="UserTask_turnOnPrinter" name="Turn on the 3D printer">
      <bpmn:incoming>SequenceFlow_turnOnPrinterPath</bpmn:incoming/>
      <bpmn:outgoing>SequenceFlow_heatBedAndExtruderPath</bpmn:outgoing/>
    </bpmn:userTask>

    <!-- Heat up bed and extruder -->
    <bpmn:userTask id="UserTask_heatUp" name="Heat up the bed and extruder">
      <bpmn:incoming>SequenceFlow_heatBedAndExtruderPath</bpmn:incoming/>
      <bpmn:outgoing>SequenceFlow_statusFeedbackPath</bpmn:outgoing/>
    </bpmn:userTask>

    <!-- Status feedback (continuous) -->
    <bpmn:serviceTask id="ServiceTask_status" name="Extruder sends back status">
      <bpmn:incoming>SequenceFlow_statusFeedbackPath</bpmn:incoming/>
      <bpmn:outgoing>SequenceFlow_convergePrinterSetupPath</bpmn:outgoing/>
    </bpmn:serviceTask>

    <!-- Generate gcode -->
    <bpmn:serviceTask id="ServiceTask_generateGcode" name="Generate gcode file from STL">
      <bpmn:incoming>SequenceFlow_generateGcodePath</bpmn:incoming/>
      <bpmn:outgoing>SequenceFlow_convergePrinterSetupPath</bpmn:outgoing/>
    </bpmn:serviceTask>

    <!-- Converging gateway for printer setup completion -->
    <bpmn:parallelGateway id="ParallelGateway_printerReady" name="">
      <bpmn:incoming>SequenceFlow_statusFeedbackPath</bpmn:incoming/>
      <bpmn:incoming>SequenceFlow_convergePrinterSetupPath</bpmn:incoming/>
      <bpmn:outgoing>SequenceFlow_startPrintingPath</bpmn:outgoing/>
    </bpmn:parallelGateway>

    <!-- Print model -->
    <bpmn:userTask id="UserTask_printModel" name="Print the 3D model">
      <bpmn:incoming>SequenceFlow_startPrintingPath</bpmn:incoming/>
      <bpmn:outgoing>SequenceFlow_endProcessPath</bpmn:outgoing/>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_1" name="3D model printed">
      <bpmn:incoming>SequenceFlow_endProcessPath</bpmn:incoming/>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_001" sourceRef="StartEvent_1" targetRef="UserTask_sendSketches"/>
    <bpmn:sequenceFlow id="SequenceFlow_002" name="" sourceRef="UserTask_revision" targetRef="UserTask_receiveModel"/>
    <bpmn:sequenceFlow id="SequenceFlow_003" name="" sourceRef="UserTask_receiveModel" targetRef="ExclusiveGateway_satisfied"/>
    
    <!-- Satisfaction decision flows -->
    <bpmn:sequenceFlow id="SequenceFlow_loopBack" name="No - Not satisfied" sourceRef="ExclusiveGateway_satisfied" targetRef="UserTask_revision"/>
    <bpmn:sequenceFlow id="SequenceFlow_proceedToColorSelection" name="Yes - Satisfied" sourceRef="ExclusiveGateway_satisfied" targetRef="ManualTask_chooseColor"/>

    <!-- Stock check flows -->
    <bpmn:sequenceFlow id="SequenceFlow_checkStockAtHome" name="" sourceRef="ManualTask_chooseColor" targetRef="ExclusiveGateway_colorAtHome"/>
    <bpmn:sequenceFlow id="SequenceFlow_orderColorPath" name="No - Not at home" sourceRef="ExclusiveGateway_colorAtHome" targetRef="UserTask_orderColor"/>
    
    <!-- Quantity check flows -->
    <bpmn:sequenceFlow id="SequenceFlow_checkQuantityPath" name="Yes - At home, checking quantity" sourceRef="ExclusiveGateway_colorAtHome" targetRef="UserTask_checkQuantity"/>
    <bpmn:sequenceFlow id="SequenceFlow_quantityDecision" name="" sourceRef="UserTask_checkQuantity" targetRef="ExclusiveGateway_under100g"/>

    <!-- Shopping list and order flows -->
    <bpmn:sequenceFlow id="SequenceFlow_addToShoppingListPath" name="Yes - Under 100 grams, add to shopping list" sourceRef="ExclusiveGateway_under100g" targetRef="UserTask_shoppingList"/>
    <bpmn:sequenceFlow id="SequenceFlow_haveEnoughPlasticPath" name="No - Enough plastic available" sourceRef="ExclusiveGateway_under100g" targetRef="ParallelGateway_printerSetup"/>

    <!-- Convergence after stock check -->
    <bpmn:sequenceFlow id="SequenceFlow_convergeAfterStockCheck" name="" sourceRef="UserTask_shoppingList" targetRef="ParallelGateway_printerSetup"/>
    
    <!-- Printer setup flows -->
    <bpmn:sequenceFlow id="SequenceFlow_turnOnPrinterPath" name="" sourceRef="ParallelGateway_printerSetup" targetRef="UserTask_turnOnPrinter"/>
    <bpmn:sequenceFlow id="SequenceFlow_heatBedAndExtruderPath" name="" sourceRef="UserTask_turnOnPrinter" targetRef="UserTask_heatUp"/>

    <!-- Status feedback and gcode generation -->
    <bpmn:sequenceFlow id="SequenceFlow_statusFeedbackPath" name="Continuous status feedback" sourceRef="UserTask_heatUp" targetRef="ServiceTask_status"/>
    <bpmn:sequenceFlow id="SequenceFlow_generateGcodePath" name="" sourceRef="ParallelGateway_printerSetup" targetRef="ServiceTask_generateGcode"/>

    <!-- Convergence before printing -->
    <bpmn:sequenceFlow id="SequenceFlow_convergePrinterSetupPath" name="" sourceRef="UserTask_shoppingList" targetRef="ExclusiveGateway_stockConvergence"/>
    <bpmn:sequenceFlow id="SequenceFlow_orderColorConverge" name="" sourceRef="UserTask_orderColor" targetRef="ParallelGateway_printerSetup"/>

    <!-- End flow -->
    <bpmn:sequenceFlow id="SequenceFlow_endProcessPath" name="" sourceRef="UserTask_printModel" targetRef="EndEvent_1"/>

  </bpmn:process>
</bpmn:definitions>