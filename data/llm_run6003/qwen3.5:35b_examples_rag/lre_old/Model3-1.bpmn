<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_WarrantProcess_1">
  <bpmn:collaboration id="Collaboration_WarrantRequest">
    <bpmn:participant id="Participant_SmallClaimsRegistry" name="Small Claims Registry Operations"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_WarrantPossession" isExecutable="true">
    <bpmn:laneSet id="LaneSet_BackOffice">
      <bpmn:lane id="Lane_ClientServiceBackOffice" name="Client Service Back Office"/>
      <bpmn:lane id="Lane_QueenslandPolice" name="Queensland Police"/>
      <bpmn:lane id="Lane_MCInternalStaff" name="MC Internal Staff (Out of Scope)"/>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_WarrantRequest" name="Warrant Possession Request Received">
      <bpmn:outgoing>SequenceFlow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Receive Warrant Request -->
    <bpmn:task id="Task_ReceiveWarrantRequest" name="Receive Warrant Possession Request">
      <bpmn:incoming>SequenceFlow_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_02</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: Retrieve SCTT File -->
    <bpmn:task id="Task_RetrieveSCTTFile" name="Retrieve SCTT File">
      <bpmn:incoming>SequenceFlow_02</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_03</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Forward to Police -->
    <bpmn:exclusiveGateway id="Gateway_ForwardToPolice" name="Forward SCT Warrant Possession">
      <bpmn:incoming>SequenceFlow_03</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_04</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 3: Store Physical File -->
    <bpmn:task id="Task_StorePhysicalFile" name="Store SCTT Physical File">
      <bpmn:incoming>SequenceFlow_04</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_05</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 4: Receive Report from Police -->
    <bpmn:task id="Task_ReceiveReportFromPolice" name="Receive Police Report">
      <bpmn:incoming>SequenceFlow_05</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_06</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 5: Retrieve SCT File -->
    <bpmn:task id="Task_RetrieveSCTFile" name="Retrieve Respective SCT File">
      <bpmn:incoming>SequenceFlow_06</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_07</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 6: Attach New Document -->
    <bpmn:task id="Task_AttachNewDocument" name="Attach New SCT Document">
      <bpmn:incoming>SequenceFlow_07</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_08</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 7: Store Expanded File -->
    <bpmn:task id="Task_StoreExpandedPhysicalFile" name="Store Expanded SCT Physical File">
      <bpmn:incoming>SequenceFlow_08</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_09</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_FileReceived" name="File Received by MC Internal Staff">
      <bpmn:incoming>SequenceFlow_09</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_01" sourceRef="StartEvent_WarrantRequest" targetRef="Task_ReceiveWarrantRequest"/>
    <bpmn:sequenceFlow id="SequenceFlow_02" sourceRef="Task_ReceiveWarrantRequest" targetRef="Task_RetrieveSCTTFile"/>
    <bpmn:sequenceFlow id="SequenceFlow_03" sourceRef="Task_RetrieveSCTTFile" targetRef="Gateway_ForwardToPolice"/>
    <bpmn:sequenceFlow id="SequenceFlow_04" sourceRef="Gateway_ForwardToPolice" targetRef="Task_StorePhysicalFile"/>
    <bpmn:sequenceFlow id="SequenceFlow_05" sourceRef="Task_StorePhysicalFile" targetRef="Task_ReceiveReportFromPolice"/>
    <bpmn:sequenceFlow id="SequenceFlow_06" sourceRef="Task_ReceiveReportFromPolice" targetRef="Task_RetrieveSCTFile"/>
    <bpmn:sequenceFlow id="SequenceFlow_07" sourceRef="Task_RetrieveSCTFile" targetRef="Task_AttachNewDocument"/>
    <bpmn:sequenceFlow id="SequenceFlow_08" sourceRef="Task_AttachNewDocument" targetRef="Task_StoreExpandedPhysicalFile"/>
    <bpmn:sequenceFlow id="SequenceFlow_09" sourceRef="Task_StoreExpandedPhysicalFile" targetRef="EndEvent_FileReceived"/>

  </bpmn:process>
</bpmn:definitions>