<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_VacationRequest_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_VacationProcess">
    <bpmn:participant id="Participant_Organization" name="Organization" processRef="Process_VacationRequest"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_VacationRequest" isExecutable="true">
    
    <bpmn:laneSet id="LaneSet_01">
      <bpmn:lane id="Lane_Employee" name="Employee">
        <bpmn:flowNodeRef>StartEvent_VacationRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegisterVacationRequest</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Supervisor" name="Immediate Supervisor">
        <bpmn:flowNodeRef>Task_ReviewDecisionRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DecisionApproved</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_HR" name="Human Resources">
        <bpmn:flowNodeRef>Task_GenerateNotification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CompleteManagementProcedures</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_VacationRequest" name="Vacations Request">
      <bpmn:outgoing>SequenceFlow_Register</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Employee Registers Requirement -->
    <bpmn:task id="Task_RegisterVacationRequest" name="Register Vacation Requirement">
      <bpmn:incoming>SequenceFlow_Register</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToSupervisor</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: Supervisor Reviews and Decides -->
    <bpmn:task id="Task_ReviewDecisionRequest" name="Approve or Reject Request">
      <bpmn:incoming>SequenceFlow_ToSupervisor</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DecisionPoint</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Decision Point -->
    <bpmn:exclusiveGateway id="Gateway_DecisionApproved" name="Request Approved?">
      <bpmn:incoming>SequenceFlow_DecisionPoint</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Rejected</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_Approved</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Path 1: Rejection -->
    <bpmn:endEvent id="EndEvent_Rejected" name="Request Denied">
      <bpmn:incoming>SequenceFlow_ReviewRejection</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:task id="Task_ReviewRejectionReasons" name="Review Rejection Reasons">
      <bpmn:incoming>SequenceFlow_Rejected</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReviewRejection</bpmn:outgoing>
    </bpmn:task>

    <!-- Path 2: Approval -->
    <bpmn:endEvent id="EndEvent_Processed" name="Vacation Processed">
      <bpmn:incoming>SequenceFlow_CompleteProcedures</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:task id="Task_GenerateNotification" name="Notify Human Resources Representative">
      <bpmn:incoming>SequenceFlow_Approved</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToProcedures</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_CompleteManagementProcedures" name="Complete Management Procedures">
      <bpmn:incoming>SequenceFlow_ToProcedures</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CompleteProcedures</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flows -->
    
    <bpmn:sequenceFlow id="SequenceFlow_Register" sourceRef="StartEvent_VacationRequest" targetRef="Task_RegisterVacationRequest">
      <bpmn:name>Vacation Request Submitted</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ToSupervisor" sourceRef="Task_RegisterVacationRequest" targetRef="Task_ReviewDecisionRequest"/>

    <bpmn:sequenceFlow id="SequenceFlow_DecisionPoint" sourceRef="Task_ReviewDecisionRequest" targetRef="Gateway_DecisionApproved"/>

    <!-- Rejection Path -->
    <bpmn:sequenceFlow id="SequenceFlow_Rejected" name="Rejected" sourceRef="Gateway_DecisionApproved" targetRef="Task_ReviewRejectionReasons">
      <bpmn:description>Supervisor rejects request</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Rejection Review Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_ReviewRejection" sourceRef="Task_ReviewRejectionReasons" targetRef="EndEvent_Rejected"/>

    <!-- Approval Path -->
    <bpmn:sequenceFlow id="SequenceFlow_Approved" name="Approved" sourceRef="Gateway_DecisionApproved" targetRef="Task_GenerateNotification">
      <bpmn:description>Supervisor approves request</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- HR Notification Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_ToProcedures" sourceRef="Task_GenerateNotification" targetRef="Task_CompleteManagementProcedures"/>

    <!-- Completion Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_CompleteProcedures" sourceRef="Task_CompleteManagementProcedures" targetRef="EndEvent_Processed"/>

  </bpmn:process>
</bpmn:definitions>