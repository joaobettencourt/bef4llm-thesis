<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_Dismissal_Review" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_DismissalProcess">
    <bpmn:participant id="Participant_MPON" name="MPON" processRef="Pool_MPON"/>
    <bpmn:participant id="Participant_MPOO" name="MPOO" processRef="Pool_MPOO"/>
    <bpmn:messageFlow id="MessageFlow_DismissalSend" sourceRef="Task_SendDismissal" targetRef="StartEvent_ReviewReceived"/>
  </bpmn:collaboration>

  <!-- MPON Process -->
  <bpmn:process id="Pool_MPON">
    <bpmn:startEvent id="StartEvent_DismissalInitiated" name="Dismissal Initiated">
      <bpmn:outgoing>SequenceFlow_SendDismissal</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_SendDismissal" name="Send Dismissal to MPOO">
      <bpmn:incoming>SequenceFlow_SendDismissal</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Dispatched</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_MPONComplete" name="Process Complete">
      <bpmn:incoming>SequenceFlow_Dispatched</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_SendDismissal" sourceRef="StartEvent_DismissalInitiated" targetRef="Task_SendDismissal"/>
    <bpmn:sequenceFlow id="SequenceFlow_Dispatched" sourceRef="Task_SendDismissal" targetRef="EndEvent_MPONComplete"/>
  </bpmn:process>

  <!-- MPOO Process -->
  <bpmn:process id="Pool_MPOO">
    <bpmn:startEvent id="StartEvent_ReviewReceived" name="Dismissal Received">
      <bpmn:outgoing>SequenceFlow_StartReview</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_ReviewDismissal" name="Review Dismissal">
      <bpmn:incoming>SequenceFlow_StartReview</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GatewayDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway for Decision -->
    <bpmn:exclusiveGateway id="Gateway_Decision" name="Review Result">
      <bpmn:incoming>SequenceFlow_GatewayDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OpposeDismissal</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ConfirmDismissal</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_Oppose" name="Opposed">
      <bpmn:incoming>SequenceFlow_OpposeDismissal</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_Confirm" name="Confirmed">
      <bpmn:incoming>SequenceFlow_ConfirmDismissal</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartReview" sourceRef="StartEvent_ReviewReceived" targetRef="Task_ReviewDismissal"/>
    <bpmn:sequenceFlow id="SequenceFlow_GatewayDecision" sourceRef="Task_ReviewDismissal" targetRef="Gateway_Decision"/>
    <bpmn:sequenceFlow id="SequenceFlow_OpposeDismissal" name="Opposes Dismissal" sourceRef="Gateway_Decision" targetRef="EndEvent_Oppose">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${opposes}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_ConfirmDismissal" name="Confirms Dismissal" sourceRef="Gateway_Decision" targetRef="EndEvent_Confirm">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${confirms}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

  </bpmn:process>

</bpmn:definitions>