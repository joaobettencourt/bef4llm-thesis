<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_RestaurantOrder_001">
  <bpmn:collaboration id="Collab_RestaurantProcess_001">
    <bpmn:participant id="Participant_RestaurantOperations_001" name="Restaurant Operations"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_OrderFulfillment_001" isExecutable="true">
    
    <!-- Lane Definitions -->
    <bpmn:laneSet id="LaneSet_Restaurant_001">
      <bpmn:lane id="Lane_Guest_001">
        <bpmn:name>Guest</bpmn:name>
        <bpmn:flowNodeRef>StartEvent_Arrival_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ChooseDishWaitTurn_001</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Employee_001">
        <bpmn:name>Employee (Server)</bpmn:name>
        <bpmn:flowNodeRef>Task_EnterOrderCollectMoney_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GiveBuzzerSilent_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ParallelSplit_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ParallelJoin_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ActivateBuzzer_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WaitForPickup_001</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Chef_001">
        <bpmn:name>Chef (Kitchen)</bpmn:name>
        <bpmn:flowNodeRef>Task_ReceiveOrderInfo_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareMealPlaceHatch_001</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Arrival_001" name="Guest Arrives">
      <bpmn:outgoing>bpmn:SequenceFlow_001</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Guest Lane Tasks -->
    <bpmn:task id="Task_ChooseDishWaitTurn_001" name="Choose Dish &amp; Wait Turn">
      <bpmn:incoming>bpmn:SequenceFlow_001</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_002</bpmn:outgoing>
    </bpmn:task>

    <!-- Employee Lane Tasks -->
    <bpmn:task id="Task_EnterOrderCollectMoney_001" name="Enter Order &amp; Collect Money">
      <bpmn:incoming>bpmn:SequenceFlow_002</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_003</bpmn:outgoing>
    </bpmn:task>

    <!-- Employee Lane Task -->
    <bpmn:task id="Task_GiveBuzzerSilent_001" name="Give Buzzer (Silent)">
      <bpmn:incoming>bpmn:SequenceFlow_003</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_004</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway Split -->
    <bpmn:parallelGateway id="Gateway_ParallelSplit_001" name="Start Prep">
      <bpmn:incoming>bpmn:SequenceFlow_004</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_005</bpmn:outgoing>
      <bpmn:outgoing>bpmn:SequenceFlow_012</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Chef Lane Tasks -->
    <bpmn:task id="Task_ReceiveOrderInfo_001" name="Inform Chef of Order">
      <bpmn:incoming>bpmn:SequenceFlow_005</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_006</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_PrepareMealPlaceHatch_001" name="Prepare Meal &amp; Place in Hatch">
      <bpmn:incoming>bpmn:SequenceFlow_006</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_007</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway Join -->
    <bpmn:parallelGateway id="Gateway_ParallelJoin_001" name="Meal Ready">
      <bpmn:incoming>bpmn:SequenceFlow_007</bpmn:incoming>
      <bpmn:incoming>bpmn:SequenceFlow_013</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_008</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Employee Lane Task -->
    <bpmn:task id="Task_ActivateBuzzer_001" name="Activate Buzzer">
      <bpmn:incoming>bpmn:SequenceFlow_008</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_009</bpmn:outgoing>
    </bpmn:task>

    <!-- Wait Task -->
    <bpmn:task id="Task_WaitForPickup_001" name="Wait for Guest Reaction">
      <bpmn:incoming>bpmn:SequenceFlow_009</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_010</bpmn:outgoing>
    </bpmn:task>

    <!-- Boundary Event attached to Wait Task -->
    <bpmn:startEvent id="StartTimer_CallGuest_001" name="5 Minutes">
      <bpmn:timerDuration>P0Y0M0DT0H0M5S</bpmn:timerDuration>
    </bpmn:startEvent>

    <!-- Boundary Event attached to Wait Task -->
    <bpmn:boundaryEvent id="BoundaryTimer_CallGuest_001" name="No Reaction">
      <bpmn:attachedToRef>bpmn:Task_WaitForPickup_001</bpmn:attachedToRef>
      <bpmn:cancelActivity>false</bpmn:cancelActivity>
    </bpmn:boundaryEvent>

    <!-- Call Task -->
    <bpmn:task id="Task_CallGuest_001" name="Call Guest">
        <bpmn:incoming>bpmn:BoundaryTimer_CallGuest_001</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_014</bpmn:outgoing>
    </bpmn:task>

    <!-- Handover Task -->
    <bpmn:task id="Task_HandOverMeal_001" name="Hand Over Meal at Hatch">
      <bpmn:incoming>bpmn:SequenceFlow_010</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_015</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="End_MealEaten_001" name="Meal Eaten">
        <bpmn:incoming>bpmn:SequenceFlow_015</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    
      <bpmn:sequenceFlow id="SequenceFlow_001" sourceRef="StartEvent_Arrival_001" targetRef="Task_ChooseDishWaitTurn_001">
        <bpmn:description>Guest enters and waits for turn</bpmn:description>
      </bpmn:sequenceFlow>

      <bpmn:sequenceFlow id="SequenceFlow_002" sourceRef="Task_ChooseDishWaitTurn_001" targetRef="Task_EnterOrderCollectMoney_001">
        <bpmn:description>Guest places order with employee</bpmn:description>
      </bpmn:sequenceFlow>

      <bpmn:sequenceFlow id="SequenceFlow_003" sourceRef="Task_EnterOrderCollectMoney_001" targetRef="Task_GiveBuzzerSilent_001">
        <bpmn:description>Employee gives buzzer with instructions</bpmn:description>
      </bpmn:sequenceFlow>

      <bpmn:sequenceFlow id="SequenceFlow_004" sourceRef="Task_GiveBuzzerSilent_001" targetRef="Gateway_ParallelSplit_001">
        <bpmn:description>Buzzer given, start meal prep</bpmn:description>
      </bpmn:sequenceFlow>

      <bpmn:sequenceFlow id="SequenceFlow_005" sourceRef="Gateway_ParallelSplit_001" targetRef="Task_ReceiveOrderInfo_001">
        <bpmn:description>Chef receives order info</bpmn:description>
      </bpmn:sequenceFlow>

      <bpmn:sequenceFlow id="SequenceFlow_006" sourceRef="Task_ReceiveOrderInfo_001" targetRef="Task_PrepareMealPlaceHatch_001">
        <bpmn:description>Chef prepares meal</bpmn:description>
      </bpmn:sequenceFlow>

      <bpmn:sequenceFlow id="SequenceFlow_007" sourceRef="Task_PrepareMealPlaceHatch_001" targetRef="Gateway_ParallelJoin_001">
        <bpmn:description>Chef signals meal ready</bpmn:description>
      </bpmn:sequenceFlow>

      <bpmn:sequenceFlow id="SequenceFlow_008" sourceRef="Gateway_ParallelJoin_001" targetRef="Task_ActivateBuzzer_001">
        <bpmn:description>All conditions met, activate buzzer</bpmn:description>
      </bpmn:sequenceFlow>

      <bpmn:sequenceFlow id="SequenceFlow_009" sourceRef="Task_ActivateBuzzer_001" targetRef="Task_WaitForPickup_001">
        <bpmn:description>Buzzer active, wait for guest</bpmn:description>
      </bpmn:sequenceFlow>

      <bpmn:sequenceFlow id="SequenceFlow_010" sourceRef="Task_WaitForPickup_001" targetRef="Task_HandOverMeal_001">
        <bpmn:description>Guest reacts and picks up meal</bpmn:description>
      </bpmn:sequenceFlow>

      <bpmn:sequenceFlow id="SequenceFlow_012" sourceRef="Gateway_ParallelSplit_001" targetRef="Task_WaitForPickup_001">
        <bpmn:description>Wait for Chef Signal</bpmn:description>
      </bpmn:sequenceFlow>

      <bpmn:sequenceFlow id="SequenceFlow_013" sourceRef="Gateway_ParallelSplit_001" targetRef="Task_WaitForPickup_001">
        <bpmn:description>Wait for Chef Signal</bpmn:description>
      </bpmn:sequenceFlow>

      <bpmn:sequenceFlow id="SequenceFlow_014" sourceRef="Task_CallGuest_001" targetRef="Gateway_ParallelJoin_001">
        <bpmn:description>Call Guest and wait again</bpmn:description>
      </bpmn:sequenceFlow>

      <bpmn:sequenceFlow id="SequenceFlow_015" sourceRef="Task_HandOverMeal_001" targetRef="End_MealEaten_001">
        <bpmn:description>Guest eats meal</bpmn:description>
      </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>