<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_RoomService_001">
  <bpmn:collaboration id="Collaboration_RoomService">
    <bpmn:participant id="Participant_RoomServiceOps" name="Room Service Operations"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_RoomService_01" isExecutable="true">
    
    <!-- Lane Definitions -->
    <bpmn:laneSet id="LaneSet_01">
      <bpmn:lane id="Lane_Manager">
        <bpmn:name>Room-Service Manager</bpmn:name>
        <bpmn:flowNodeRef>Task_TakeOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AlcoholDecision</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Kitchen">
        <bpmn:name>Kitchen Staff</bpmn:name>
        <bpmn:flowNodeRef>Task_PrepareFood</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Sommelier">
        <bpmn:name>Sommelier (Wine Waiter)</bpmn:name>
        <bpmn:flowNodeRef>Task_FetchWine</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Waiter">
        <bpmn:name>Waiter</bpmn:name>
        <bpmn:flowNodeRef>Task_ReadiesCartDrinks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DeliverToRoom</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DebitAccount</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="Start_OrderReceived" name="Guest Calls Room Service">
      <bpmn:outgoing>SequenceFlow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Manager Takes Order -->
    <bpmn:task id="Task_TakeOrder" name="Take Down Order Ticket">
      <bpmn:incoming>SequenceFlow_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_02</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Split -->
    <bpmn:parallelGateway id="ParallelSplit_OrderInit" name="Start Prep">
      <bpmn:incoming>SequenceFlow_02</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_03</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_04</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_05</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Path 1: Kitchen Prep Food -->
    <bpmn:task id="Task_PrepareFood" name="Prepare Food">
      <bpmn:incoming>SequenceFlow_03</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_06</bpmn:outgoing>
    </bpmn:task>

    <!-- Path 2: Waiter Readies Cart & Non-Alcoholic Drinks -->
    <bpmn:task id="Task_ReadiesCartDrinks" name="Ready Cart (Tablecloth, Silverware)">
      <bpmn:incoming>SequenceFlow_04</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_07</bpmn:outgoing>
    </bpmn:task>

    <!-- Path 3: Decision on Alcohol (80% include wine) -->
    <bpmn:exclusiveGateway id="Gateway_AlcoholDecision" name="Order includes alcohol?">
      <bpmn:incoming>SequenceFlow_05</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_08</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_09</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Path 3a: Sommelier Fetches Wine (If Alcohol) -->
    <bpmn:task id="Task_FetchWine" name="Fetch Wine & Alcoholic Beverages">
      <bpmn:incoming>SequenceFlow_08</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
    </bpmn:task>

    <!-- Convergence Gateway (AND-Join) -->
    <bpmn:parallelGateway id="Gateway_ConvergenceDelivery" name="All Ready">
      <bpmn:incoming>SequenceFlow_06</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_07</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_10</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_11</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Delivery Task -->
    <bpmn:task id="Task_DeliverToRoom" name="Deliver to Guest Room">
      <bpmn:incoming>SequenceFlow_11</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_12</bpmn:outgoing>
    </bpmn:task>

    <!-- Return & Billing -->
    <bpmn:exclusiveGateway id="Gateway_BillingDecision" name="Bill Now?">
      <bpmn:incoming>SequenceFlow_Return</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Billing Task -->
    <bpmn:task id="Task_DebitAccount" name="Debit Guest Account">
      <bpmn:incoming>SequenceFlow_13</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Final</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="End_OrderComplete" name="Order Completed">
      <bpmn:incoming>SequenceFlow_Final</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows for Parallel Split Outputs -->
    <bpmn:sequenceFlow id="SequenceFlow_03" sourceRef="ParallelSplit_OrderInit" targetRef="Task_PrepareFood"/>
    <bpmn:sequenceFlow id="SequenceFlow_04" sourceRef="ParallelSplit_OrderInit" targetRef="Task_ReadiesCartDrinks"/>
    <bpmn:sequenceFlow id="SequenceFlow_05" sourceRef="ParallelSplit_OrderInit" targetRef="Gateway_AlcoholDecision"/>

    <!-- Sequence Flows for Convergence -->
    <bpmn:sequenceFlow id="SequenceFlow_06" sourceRef="Task_PrepareFood" targetRef="Gateway_ConvergenceDelivery"/>
    <bpmn:sequenceFlow id="SequenceFlow_07" sourceRef="Task_ReadiesCartDrinks" targetRef="Gateway_ConvergenceDelivery"/>

    <!-- Sequence Flows for Alcohol Decision -->
    <bpmn:sequenceFlow id="SequenceFlow_08" name="Yes (Alcohol)" sourceRef="Gateway_AlcoholDecision" targetRef="Task_FetchWine"/>
    <bpmn:sequenceFlow id="SequenceFlow_09" name="No alcohol needed" sourceRef="Gateway_AlcoholDecision" targetRef="Gateway_ConvergenceDelivery"/>

    <!-- Sequence Flow from Sommelier -->
    <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="Task_FetchWine" targetRef="Gateway_ConvergenceDelivery"/>

    <!-- Delivery Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_11" sourceRef="Gateway_ConvergenceDelivery" targetRef="Task_DeliverToRoom"/>

    <!-- Return & Billing Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_Return" name="Return to Station" sourceRef="Task_DeliverToRoom" targetRef="Gateway_BillingDecision"/>
    <bpmn:sequenceFlow id="SequenceFlow_13" sourceRef="Gateway_BillingDecision" targetRef="Task_DebitAccount"/>

    <!-- Final Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_Final" sourceRef="Task_DebitAccount" targetRef="End_OrderComplete"/>

  </bpmn:process>
</bpmn:definitions>