<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_Claim_Process_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_ClaimHandling">
    <bpmn:participant id="Participant_Organization" name="Claims Department" processRef="Process_ClaimHandling"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_ClaimHandling" isExecutable="true">
    
    <bpmn:laneSet id="LaneSet_01">
      <bpmn:lane id="Lane_Administration">
        <bpmn:name>Clerical Staff</bpmn:name>
        <bpmn:flowNodeRef>StartEvent_ClaimReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SearchPoliceReport</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_ClaimsHandler">
        <bpmn:name>Claims Handler</bpmn:name>
        <bpmn:flowNodeRef>Task_CalculateEstimate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateActionPlan</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_ClaimsManager">
        <bpmn:name>Claims Manager</bpmn:name>
        <bpmn:flowNodeRef>Task_NegotiateSettlement</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Communications">
        <bpmn:name>Communications Team</bpmn:name>
        <bpmn:flowNodeRef>Task_InformClaimant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ProcessComplete</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_ClaimReceived" name="Claim Received">
      <bpmn:outgoing>SequenceFlow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Search Police Report -->
    <bpmn:task id="Task_SearchPoliceReport" name="Search Police Report Database">
      <bpmn:incoming>SequenceFlow_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_02</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: Calculate Claim Estimate -->
    <bpmn:task id="Task_CalculateEstimate" name="Calculate Initial Claim Estimate">
      <bpmn:incoming>SequenceFlow_03</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_04</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3: Create Action Plan -->
    <bpmn:task id="Task_CreateActionPlan" name="Create Action Plan">
      <bpmn:incoming>SequenceFlow_05</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_06</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 4: Negotiate Settlement -->
    <bpmn:task id="Task_NegotiateSettlement" name="Negotiate Claim Settlement">
      <bpmn:incoming>SequenceFlow_06</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_07</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 5: Inform Claimant -->
    <bpmn:task id="Task_InformClaimant" name="Inform Claimant of Outcome">
      <bpmn:incoming>SequenceFlow_07</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_08</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_ProcessComplete" name="Process Complete">
      <bpmn:incoming>SequenceFlow_08</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Data Objects (as artifacts) -->
    <bpmn:dataObjectReference id="DataRef_PoliceFile" name="Police Report File"/>
    <bpmn:dataObjectReference id="DataRef_ActionPlanChecklist" name="Action Plan Checklist"/>

    <!-- Associations for data objects -->
    <bpmn:association id="Assoc_01">
      <bpmn:sourceRef>Task_SearchPoliceReport</bpmn:sourceRef>
      <bpmn:targetRef>DataRef_PoliceFile</bpmn:targetRef>
    </bpmn:association>

    <bpmn:association id="Assoc_02">
      <bpmn:sourceRef>Task_CalculateEstimate</bpmn:sourceRef>
      <bpmn:targetRef>DataRef_PoliceFile</bpmn:targetRef>
    </bpmn:association>

    <bpmn:association id="Assoc_03">
      <bpmn:sourceRef>Task_CreateActionPlan</bpmn:sourceRef>
      <bpmn:targetRef>DataRef_ActionPlanChecklist</bpmn:targetRef>
    </bpmn:association>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_01" sourceRef="StartEvent_ClaimReceived" targetRef="Task_SearchPoliceReport"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_02" sourceRef="Task_SearchPoliceReport" targetRef="DataRef_PoliceFile">
      <bpmn:name>Search Report</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_03" sourceRef="DataRef_PoliceFile" targetRef="Task_CalculateEstimate"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_04" sourceRef="Task_CalculateEstimate" targetRef="Task_CreateActionPlan">
      <bpmn:name>Calculate Estimate</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_05" sourceRef="DataRef_ActionPlanChecklist" targetRef="Task_CreateActionPlan"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_06" sourceRef="Task_CreateActionPlan" targetRef="Task_NegotiateSettlement">
      <bpmn:name>Create Plan</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_07" sourceRef="Task_NegotiateSettlement" targetRef="Task_InformClaimant"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_08" sourceRef="Task_InformClaimant" targetRef="EndEvent_ProcessComplete">
      <bpmn:name>Inform Claimant</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>