<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_RecruitmentProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_HiringProcess">
    <bpmn:participant id="Participant_HRDepartment" name="HR Department"/>
    <bpmn:participant id="Participant_FunctionalDept" name="Functional Department"/>
    <bpmn:participant id="Participant_Candidates" name="Job Applicants"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Hiring_01">
    
    <!-- Start Event - Request from Functional Dept -->
    <bpmn:startEvent id="Start_RequestReceived" name="Post Filling Request Received">
      <bpmn:messageRefMessage_StartRequest />
      <bpmn:outgoing>SequenceFlow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1 - Advertise Position -->
    <bpmn:task id="Task_AdvertisePosition" name="Advertise Vacancy">
      <bpmn:incoming>SequenceFlow_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_02</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2 - Receive Applications -->
    <bpmn:userTask id="UserTask_ApplicationsReceived" name="Receive Job Applications">
      <bpmn:incoming>SequenceFlow_03</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_04</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway 1 - Check if applications received -->
    <bpmn:exclusiveGateway id="Gateway_ApplicationsReceived" name="Applications Received?">
      <bpmn:incoming>SequenceFlow_04</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_05</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 3 - Check Applications -->
    <bpmn:userTask id="UserTask_CheckApplications" name="Review and Evaluate">
      <bpmn:incoming>SequenceFlow_06</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_07</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway 2 - Decision on Candidate Selection -->
    <bpmn:exclusiveGateway id="Gateway_CandidateSelected" name="Candidate Selected?">
      <bpmn:incoming>SequenceFlow_07</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_08</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 4 - Conclude Contract -->
    <bpmn:userTask id="UserTask_ContractConclusion" name="Conclude Employment Contract">
      <bpmn:incoming>SequenceFlow_09</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event - Process Complete -->
    <bpmn:endEvent id="End_ContractConcluded" name="Post Filled">
      <bpmn:messageRefMessage_EndContract />
      <bpmn:incoming>SequenceFlow_10</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_01" sourceRef="Start_RequestReceived" targetRef="Task_AdvertisePosition">
      <bpmn:name>Request Received</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_02" sourceRef="Task_AdvertisePosition" targetRef="Gateway_ApplicationsReceived"/>

    <!-- Message Flow from Candidates -->
    <bpmn:startEvent id="Start_ApplicationsReceived">
      <bpmn:messageRefMessage_CandidateApplications />
      <bpmn:outgoing>SequenceFlow_03</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Message Flow from Candidates -->
    <bpmn:sequenceFlow id="SequenceFlow_03" sourceRef="Start_ApplicationsReceived" targetRef="Gateway_ApplicationsReceived"/>

    <!-- Gateway Decision -->
    <bpmn:exclusiveGateway id="Gateway_ReviewNeeded" name="Applications Need Review?">
      <bpmn:incoming>SequenceFlow_04</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_05</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Message Flow to Candidates -->
    <bpmn:sequenceFlow id="SequenceFlow_04" sourceRef="Gateway_ApplicationsReceived" targetRef="UserTask_CheckApplications"/>

    <!-- Message Flow to Candidates -->
    <bpmn:sequenceFlow id="SequenceFlow_05" sourceRef="UserTask_CheckApplications" targetRef="Gateway_CandidateSelected"/>

    <!-- Message Flow to Candidates -->
    <bpmn:exclusiveGateway id="Gateway_CandidateAccepted">
      <bpmn:incoming>SequenceFlow_06</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_07</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Message Flow to Candidates -->
    <bpmn:sequenceFlow id="SequenceFlow_06" sourceRef="Gateway_CandidateSelected" targetRef="UserTask_ContractConclusion"/>

    <!-- Message Flow to Functional Dept -->
    <bpmn:exclusiveGateway id="Gateway_ContractSigned">
      <bpmn:incoming>SequenceFlow_07</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Message Flow to Functional Dept -->
    <bpmn:sequenceFlow id="SequenceFlow_07" sourceRef="UserTask_ContractConclusion" targetRef="End_ContractConcluded"/>

  </bpmn:process>

  <!-- Global Messages -->
  <bpmn:message id="Message_StartRequest" name="Post Filling Request"/>
  <bpmn:message id="Message_CandidateApplications" name="Job Applications"/>
  <bpmn:message id="Message_Rejection" name="Application Rejected"/>
  <bpmn:message id="Message_SelectionNotification" name="Selection Notification"/>
  <bpmn:message id="Message_ContractOffer" name="Contract Offer"/>
  <bpmn:message id="Message_ContractSigned" name="Contract Signed"/>
  <bpmn:message id="Message_PositionFilled" name="Position Filled"/>
  <bpmn:message id="Message_EndContract" name="Post Filled Notification"/>

</bpmn:definitions>