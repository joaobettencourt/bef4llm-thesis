<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_MeasuringPointChange_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_ChangeProcess">
    <bpmn:participant id="Participant_MPO_Operations" name="MPO Operations"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_MeasuringPointChange" isExecutable="true">
    
    <!-- Lane Set for Organization -->
    <bpmn:laneSet id="LaneSet_01">
      <bpmn:lane id="Lane_ChangeManagement">
        <bpmn:name>Change Management</bpmn:name>
        <bpmn:flowNodeRef>StartEvent_RequestReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DecisionPoint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PerformChange</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Communication">
        <bpmn:name>Communication Team</bpmn:name>
        <bpmn:flowNodeRef>Gateway_ReportDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReportSuccess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyFailure</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_EndEvents">
        <bpmn:name>Process Completion</bpmn:name>
        <bpmn:flowNodeRef>EndEvent_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Successful</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_RequestReceived" name="Change Request Received">
      <bpmn:outgoing>SequenceFlow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Review Change Request -->
    <bpmn:task id="Task_ReviewRequest" name="MPO Reviews Change Request">
      <bpmn:incoming>SequenceFlow_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_02</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Decision Point - Reject or Confirm -->
    <bpmn:exclusiveGateway id="Gateway_DecisionPoint" name="Confirm Change Request?">
      <bpmn:incoming>SequenceFlow_02</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_03</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_04</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 2: Perform Measuring Point Change -->
    <bpmn:task id="Task_PerformChange" name="Perform Measuring Point Change">
      <bpmn:incoming>SequenceFlow_04</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_05</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2: Report Decision Point -->
    <bpmn:exclusiveGateway id="Gateway_ReportDecision" name="Report Outcome?">
      <bpmn:incoming>SequenceFlow_05</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_06</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_07</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 3: Report Success -->
    <bpmn:task id="Task_ReportSuccess" name="Report Implementation to SP/PU/GO">
      <bpmn:incoming>SequenceFlow_06</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_08</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 4: Notify Failure -->
    <bpmn:task id="Task_NotifyFailure" name="Notify SP/PU/GO About Change Failure">
      <bpmn:incoming>SequenceFlow_07</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_09</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 1: Change Request Rejected -->
    <bpmn:endEvent id="EndEvent_Rejected" name="Change Request Rejected">
      <bpmn:incoming>SequenceFlow_03</bpmn:incoming>
    </bpmn:endEvent>

    <!-- End Event 2: Process Successful -->
    <bpmn:endEvent id="EndEvent_Successful" name="Process Completed">
      <bpmn:incoming>SequenceFlow_08</bpmn:incoming>
    </bpmn:endEvent>

    <!-- End Event 3: Process Failed -->
    <bpmn:endEvent id="EndEvent_Failed" name="Process Failed">
      <bpmn:incoming>SequenceFlow_09</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    
    <!-- Flow 1: Start to Review Request -->
    <bpmn:sequenceFlow id="SequenceFlow_01" name="Change Request Received">
      <bpmn:sourceRef>StartEvent_RequestReceived</bpmn:sourceRef>
      <bpmn:targetRef>Task_ReviewRequest</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Flow 2: Review Request to Decision Point -->
    <bpmn:sequenceFlow id="SequenceFlow_02" name="Ready for Decision">
      <bpmn:sourceRef>Task_ReviewRequest</bpmn:sourceRef>
      <bpmn:targetRef>Gateway_DecisionPoint</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Flow 3: Decision - Reject -->
    <bpmn:sequenceFlow id="SequenceFlow_03" name="Reject Change">
      <bpmn:sourceRef>Gateway_DecisionPoint</bpmn:sourceRef>
      <bpmn:targetRef>EndEvent_Rejected</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Flow 4: Decision - Confirm -->
    <bpmn:sequenceFlow id="SequenceFlow_04" name="Confirm Change">
      <bpmn:sourceRef>Gateway_DecisionPoint</bpmn:sourceRef>
      <bpmn:targetRef>Task_PerformChange</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Flow 5: Perform Change to Report Decision -->
    <bpmn:sequenceFlow id="SequenceFlow_05" name="Change Performed">
      <bpmn:sourceRef>Task_PerformChange</bpmn:sourceRef>
      <bpmn:targetRef>Gateway_ReportDecision</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Flow 6: Report Success -->
    <bpmn:sequenceFlow id="SequenceFlow_06" name="Report Implementation">
      <bpmn:sourceRef>Gateway_ReportDecision</bpmn:sourceRef>
      <bpmn:targetRef>Task_ReportSuccess</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Flow 7: Notify Failure -->
    <bpmn:sequenceFlow id="SequenceFlow_07" name="Notify Failure">
      <bpmn:sourceRef>Gateway_ReportDecision</bpmn:sourceRef>
      <bpmn:targetRef>Task_NotifyFailure</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Flow 8: Success to End -->
    <bpmn:sequenceFlow id="SequenceFlow_08" name="Implementation Reported">
      <bpmn:sourceRef>Task_ReportSuccess</bpmn:sourceRef>
      <bpmn:targetRef>EndEvent_Successful</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Flow 9: Failure to End -->
    <bpmn:sequenceFlow id="SequenceFlow_09" name="Failure Notified">
      <bpmn:sourceRef>Task_NotifyFailure</bpmn:sourceRef>
      <bpmn:targetRef>EndEvent_Failed</bpmn:targetRef>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>