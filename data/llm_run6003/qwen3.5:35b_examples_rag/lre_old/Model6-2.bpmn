<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_PurchaseOrder_001">
  <bpmn:collaboration id="Collaboration_AssemblerSupplier">
    <bpmn:participant id="Participant_AssemblerAG" name="Assembler AG"/>
    <bpmn:participant id="Participant_SupplierCompany" name="Supplier Company"/>
    
    <!-- Message Flow from Assembler to Supplier -->
    <bpmn:messageFlow id="MessageFlow_OrderSent" sourceRef="Task_SendOrder" targetRef="StartEvent_ReceiveOrder">
      <bpmn:name>Send Order</bpmn:name>
    </bpmn:messageFlow>

    <!-- Message Flow from Supplier to Assembler -->
    <bpmn:messageFlow id="MessageFlow_InvoiceSent" sourceRef="Task_SendInvoice" targetRef="StartEvent_ReceiveOrder">
      <bpmn:name>Send Invoice</bpmn:name>
    </bpmn:messageFlow>

  </bpmn:collaboration>

  <!-- Process for Assembler AG -->
  <bpmn:process id="Process_AssemblerAG" isExecutable="true">
    
    <bpmn:startEvent id="Start_TimerMonthly" name="First of Month Timer">
      <bpmn:outgoing>SequenceFlow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_SendOrder" name="Send Order to Supplier">
      <bpmn:incoming>SequenceFlow_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_02</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="End_OrderComplete" name="Order Process Complete">
      <bpmn:incoming>SequenceFlow_03</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Note: Sequence flows within the process -->
    <bpmn:sequenceFlow id="SequenceFlow_01" sourceRef="Start_TimerMonthly" targetRef="Task_SendOrder"/>
    
  </bpmn:process>

  <!-- Process for Supplier Company -->
  <bpmn:process id="Process_SupplierCompany" isExecutable="true">
    <!-- Start Event triggered by message flow (conceptually) or standard start -->
    <bpmn:startEvent id="Start_ReceiveOrder" name="Order Received from Assembler AG"/>

    <bpmn:endEvent id="End_ProcessComplete" name="Invoice Sent to Assembler AG">
      <bpmn:incoming>SequenceFlow_Supplier_02</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task 1 -->
    <bpmn:task id="Task_ProcessOrder" name="Process Order Requested by Supplier">
      <bpmn:outgoing>SequenceFlow_Supplier_01</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2 -->
    <bpmn:task id="Task_SendInvoice" name="Send Invoice to Assembler AG">
      <bpmn:incoming>SequenceFlow_Supplier_03</bpmn:incoming>
      <bpmn:outgoing/>
    </bpmn:task>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_Supplier_01" sourceRef="Start_ReceiveOrder" targetRef="Task_ProcessOrder"/>
    
  </bpmn:process>

</bpmn:definitions>