<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_PersonnelProcess_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_HR_Ops">
    <bpmn:participant id="Participant_HR_Department" name="HR Department Operations"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Vacancy_Management_1" isExecutable="true">
    
    <bpmn:laneSet id="LaneSet_Personnel_Ops">
      <bpmn:lane id="Lane_Requester" name="Requesting Manager">
        <bpmn:name>Requesting Manager</bpmn:name>
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Report_Vacancy</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_HR_Manager" name="HR Manager">
        <bpmn:name>HR Manager</bpmn:name>
        <bpmn:flowNodeRef>Task_Create_Description</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Decision_Corrections</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_HR_Specialist" name="HR Specialist">
        <bpmn:name>HR Specialist</bpmn:name>
        <bpmn:flowNodeRef>Task_Provide_Clarifications</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Personnel Requirements Detected">
      <bpmn:outgoing>SequenceFlow_Report_Vacancy</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Report Vacancy -->
    <bpmn:task id="Task_Report_Vacancy" name="Report Vacancy to Personnel Department">
      <bpmn:incoming>SequenceFlow_Report_Vacancy</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Wait_Description</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Catch Event: Wait for Job Description Review -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_Review" name="Wait for Job Description">
      <bpmn:incoming>SequenceFlow_Wait_Description</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Decision_Point</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Gateway 1: Decision Point - Corrections Needed? -->
    <bpmn:exclusiveGateway id="Gateway_Decision_Corrections" name="Corrections Required">
      <bpmn:incoming>SequenceFlow_Decision_Point</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Provide_Clariations</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_Approve_Description</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 2: Create Job Description -->
    <bpmn:task id="Task_Create_Description" name="Create/Revise Job Description">
      <bpmn:incoming>SequenceFlow_Provide_Clariations</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Wait_Review_Again</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3: Provide Clarifications -->
    <bpmn:task id="Task_Provide_Clarifications" name="Provide Clarifications on Tasks/Requirements">
      <bpmn:incoming>SequenceFlow_HR_Questions</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Return_To_Description</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2: Decision Point - Approval Granted? -->
    <bpmn:exclusiveGateway id="Gateway_Approval_Granted" name="Approval Granted">
      <bpmn:incoming>SequenceFlow_Return_To_Description</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_Advertise_Position</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 4: Advertise Position -->
    <bpmn:task id="Task_Advertise_Position" name="Advertise Job Position">
      <bpmn:incoming>SequenceFlow_Approve_Description</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_Complete_Process</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Complete" name="Position Advertised">
      <bpmn:incoming>SequenceFlow_Advertise_Position</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    
    <bpmn:sequenceFlow id="SequenceFlow_Report_Vacancy" sourceRef="StartEvent_1" targetRef="Task_Report_Vacancy">
      <bpmn:name>Detect Requirements</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_Wait_Description" sourceRef="Task_Report_Vacancy" targetRef="IntermediateCatchEvent_Review">
      <bpmn:name>Submit for Review</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_Decision_Point" sourceRef="IntermediateCatchEvent_Review" targetRef="Gateway_Decision_Corrections">
      <bpmn:name>Description Received</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_Provide_Clariations" name="Yes - Corrections Needed" sourceRef="Gateway_Decision_Corrections" targetRef="Task_Create_Description">
      <bpmn:description>If corrections required, revise description</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_Approve_Description" name="No - Approved" sourceRef="Gateway_Decision_Corrections" targetRef="Task_Advertise_Position">
      <bpmn:description>If approved, proceed to advertise</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_Wait_Review_Again" name="Submit for Review Again" sourceRef="Task_Create_Description" targetRef="IntermediateCatchEvent_Review">
      <bpmn:name>Resubmit Description</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- HR Questions Loop -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_Questions" name="HR Has Questions">
        <bpmn:incoming>SequenceFlow_Wait_Review_Again</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow_HR_Questions</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Fixing the loop logic for HR Questions to be valid -->
    <!-- Adjusted Logic: If questions arise during review, go to clarification task then back to decision or description creation. 
         To ensure validity and flow continuity based on previous errors:
         Let's simplify the connection points to avoid ID mismatches found previously.
    -->

    <bpmn:sequenceFlow id="SequenceFlow_HR_Questions" name="HR Has Questions" sourceRef="Gateway_Decision_Corrections" targetRef="Task_Provide_Clarifications">
      <bpmn:description>If HR has questions, provide clarifications</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_Return_To_Description" name="Return to Description" sourceRef="Task_Provide_Clarifications" targetRef="Gateway_Decision_Corrections">
      <bpmn:name>Await Further Review</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>