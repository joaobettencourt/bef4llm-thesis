<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_ProspectAcquisition_1">
  <bpmn:collaboration id="Collaboration_ProcurementProcess">
    <bpmn:participant id="Participant_SalesDepartment" name="Sales Department Process"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_ProspectAcquisition" isExecutable="true">
    
    <!-- Lane Set for Organizing Activities -->
    <bpmn:laneSet id="LaneSet_SalesDepartment">
      <bpmn:lane id="Lane_Marketing">
        <bpmn:name>Marketing Team</bpmn:name>
        <bpmn:flowNodeRef>Task_GetContactDetails1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GetContactDetails2</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_CallCenter">
        <bpmn:name>Call Center Staff</bpmn:name>
        <bpmn:flowNodeRef>Task_CallCustomer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_InterestCheck</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Sales">
        <bpmn:name>Sales &amp; Pre-Sales Team</bpmn:name>
        <bpmn:flowNodeRef>Gateway_PresentationType</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GivePresentation1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GivePresentation2</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Management">
        <bpmn:name>Management Team</bpmn:name>
        <bpmn:flowNodeRef>Gateway_BudgetCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HeadOfDevelopmentAcquire</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_SalesFollowUp">
        <bpmn:name>Sales Representative Follow-up</bpmn:name>
        <bpmn:flowNodeRef>IntermediateTimerEvent_2WeeksWait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FollowupCall</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_SalesFinal">
        <bpmn:name>Sales Department Final Phase</bpmn:name>
        <bpmn:flowNodeRef>Task_CreateQuotation</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="Start_GetContactDetails" name="Determine Contact Details">
      <bpmn:outgoing>SequenceFlow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Parallel Paths for Getting Customer Info -->
    <bpmn:parallelGateway id="ParallelGateway_GetInfo" name="Get Info Methods">
      <bpmn:incoming>SequenceFlow_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_02</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_03</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 1: Buy Details -->
    <bpmn:task id="Task_GetContactDetails1" name="Buy details for cold calls">
      <bpmn:incoming>SequenceFlow_02</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_04</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: Exhibition -->
    <bpmn:task id="Task_GetContactDetails2" name="Participate in exhibitions">
      <bpmn:incoming>SequenceFlow_03</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_05</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3: Know Someone -->
    <bpmn:task id="Task_GetContactDetails3" name="Know somebody interested">
      <bpmn:incoming>SequenceFlow_06</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_07</bpmn:outgoing>
    </bpmn:task>

    <!-- Merge Paths -->
    <bpmn:parallelGateway id="ParallelGateway_MergeInfo" name="Merge Info Sources">
      <bpmn:incoming>SequenceFlow_04</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_05</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_07</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_08</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Call Center Task -->
    <bpmn:task id="Task_CallCustomer" name="Call customer">
      <bpmn:incoming>SequenceFlow_08</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_09</bpmn:outgoing>
    </bpmn:task>

    <!-- Determine Contact Person and Budget -->
    <bpmn:task id="Task_DetermineContactAndBudget" name="Determine contact person &amp; budget">
      <bpmn:incoming>SequenceFlow_09</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
    </bpmn:task>

    <!-- Ask if Interested -->
    <bpmn:task id="Task_AskInterest" name="Ask customer about interest">
      <bpmn:incoming>SequenceFlow_10</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_11</bpmn:outgoing>
    </bpmn:task>

    <!-- Decision Gateway 1: Is Customer Interested? -->
    <bpmn:exclusiveGateway id="Gateway_InterestCheck" name="Customer interested?">
      <bpmn:incoming>SequenceFlow_11</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_12</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Decision Gateway 2: Is Budget Huge? -->
    <bpmn:exclusiveGateway id="Gateway_BudgetCheck" name="Budget huge?">
      <bpmn:incoming>SequenceFlow_13</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_14</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Head of Development Intervention -->
    <bpmn:task id="Task_HeadOfDevelopmentAcquire" name="Head of development acquires customer">
      <bpmn:incoming>SequenceFlow_14</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_16</bpmn:outgoing>
    </bpmn:task>

    <!-- Merge Paths After Interest Check -->
    <bpmn:parallelGateway id="ParallelGateway_MergeInterest" name="Merge Interest Outcomes">
      <bpmn:incoming>SequenceFlow_12</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_16</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_17</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Decision Gateway 3: Presentation Type -->
    <bpmn:exclusiveGateway id="Gateway_PresentationType" name="Technical presentation?">
      <bpmn:incoming>SequenceFlow_17</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_18</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Presentation by Sales Rep -->
    <bpmn:task id="Task_GivePresentation1" name="Give online presentation (Sales rep)">
      <bpmn:incoming>SequenceFlow_18</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_20</bpmn:outgoing>
    </bpmn:task>

    <!-- Presentation by Pre-Sales -->
    <bpmn:task id="Task_GivePresentation2" name="Give technical presentation (Pre-sales)">
      <bpmn:incoming>SequenceFlow_19</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_20B</bpmn:outgoing>
    </bpmn:task>

    <!-- Wait for Customer Response -->
    <bpmn:intermediateCatchEvent id="IntermediateTimerEvent_CustomerResponse" name="Wait for customer response">
      <bpmn:incoming>SequenceFlow_20</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_20B</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_21</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Timer Event for 2 Weeks -->
    <bpmn:timerDefinition id="TimerDef_2Weeks">
      <bpmn:timeDuration>P2W</bpmn:timeDuration>
    </bpmn:timerDefinition>

    <bpmn:intermediateCatchEvent id="IntermediateTimerEvent_2WeeksWait" name="No contact after 2 weeks">
      <bpmn:incoming>SequenceFlow_21</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_22</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Follow-up Call -->
    <bpmn:task id="Task_FollowupCall" name="Sales rep calls customer">
      <bpmn:incoming>SequenceFlow_22</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_23</bpmn:outgoing>
    </bpmn:task>

    <!-- Merge Follow-up with Customer Response -->
    <bpmn:parallelGateway id="ParallelGateway_MergeResponse" name="Merge Responses">
      <bpmn:incoming>SequenceFlow_21</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_23</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_24</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Create Quotation -->
    <bpmn:task id="Task_CreateQuotation" name="Create quotation">
      <bpmn:incoming>SequenceFlow_24</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_25</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="End_ProcessComplete" name="Quotation Created">
      <bpmn:incoming>SequenceFlow_25</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    
    <bpmn:sequenceFlow id="SequenceFlow_01" sourceRef="Start_GetContactDetails" targetRef="ParallelGateway_GetInfo">
      <bpmn:description>Determine contact details of potential customers</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_02" sourceRef="ParallelGateway_GetInfo" targetRef="Task_GetContactDetails1"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_03" sourceRef="ParallelGateway_GetInfo" targetRef="Task_GetContactDetails2"/>

    <!-- Need to add the third path for "Know somebody interested" -->
    <bpmn:startEvent id="Start_KnowSomeone">
      <bpmn:outgoing>SequenceFlow_06</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:sequenceFlow id="SequenceFlow_04" sourceRef="Task_GetContactDetails1" targetRef="ParallelGateway_MergeInfo"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_05" sourceRef="Task_GetContactDetails2" targetRef="ParallelGateway_MergeInfo"/>

    <!-- Add the third path for "Know somebody interested" -->
    <bpmn:startEvent id="Start_KnowSomeone">
      <bpmn:outgoing>SequenceFlow_06</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:sequenceFlow id="SequenceFlow_07" sourceRef="Task_GetContactDetails3" targetRef="ParallelGateway_MergeInfo"/>

    <!-- Call Center Tasks -->
    <bpmn:sequenceFlow id="SequenceFlow_08" sourceRef="ParallelGateway_MergeInfo" targetRef="Task_CallCustomer">
      <bpmn:description>Start calling the customer</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_09" sourceRef="Task_CallCustomer" targetRef="Task_DetermineContactAndBudget"/>

    <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="Task_DetermineContactAndBudget" targetRef="Task_AskInterest">
      <bpmn:description>Determine contact person and budget</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Interest Check -->
    <bpmn:sequenceFlow id="SequenceFlow_11" sourceRef="Task_AskInterest" targetRef="Gateway_InterestCheck">
      <bpmn:description>Ask customer about interest</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Customer Interested Path -->
    <bpmn:sequenceFlow id="SequenceFlow_12" sourceRef="Gateway_InterestCheck" targetRef="ParallelGateway_MergeInterest">
      <bpmn:description>Customer is interested</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Customer Not Interested Path -->
    <bpmn:sequenceFlow id="SequenceFlow_13" sourceRef="Gateway_InterestCheck" targetRef="Gateway_BudgetCheck">
      <bpmn:description>Customer not interested</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Budget Check -->
    <bpmn:sequenceFlow id="SequenceFlow_14" sourceRef="Gateway_BudgetCheck" targetRef="Task_HeadOfDevelopmentAcquire">
      <bpmn:description>Budget is huge - Head of Development intervenes</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Budget Not Huge Path -->
    <bpmn:endEvent id="End_CustomerLost" name="Customer Lost">
      <bpmn:incoming>SequenceFlow_15</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow_15" sourceRef="Gateway_BudgetCheck" targetRef="End_CustomerLost">
      <bpmn:description>Budget not huge - leave customer alone</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Merge After Interest Check -->
    <bpmn:sequenceFlow id="SequenceFlow_16" sourceRef="Task_HeadOfDevelopmentAcquire" targetRef="ParallelGateway_MergeInterest"/>

    <!-- Presentation Type Decision -->
    <bpmn:sequenceFlow id="SequenceFlow_17" sourceRef="ParallelGateway_MergeInterest" targetRef="Gateway_PresentationType">
      <bpmn:description>Customer interested - proceed to presentation</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Presentation Paths -->
    <bpmn:sequenceFlow id="SequenceFlow_18" sourceRef="Gateway_PresentationType" targetRef="Task_GivePresentation1">
      <bpmn:description>Standard presentation</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_19" sourceRef="Gateway_PresentationType" targetRef="Task_GivePresentation2">
      <bpmn:description>Technical presentation required</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Wait for Response -->
    <bpmn:sequenceFlow id="SequenceFlow_20" sourceRef="Task_GivePresentation1" targetRef="IntermediateTimerEvent_CustomerResponse"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_20B" sourceRef="Task_GivePresentation2" targetRef="IntermediateTimerEvent_CustomerResponse">
      <bpmn:description>Wait for customer to come back</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- 2 Weeks Timer -->
    <bpmn:timerDefinition id="TimerDef_2Weeks">
      <bpmn:timeDuration>P2W</bpmn:timeDuration>
    </bpmn:timerDefinition>

    <bpmn:intermediateCatchEvent id="IntermediateTimerEvent_CustomerResponse" name="Wait for customer response">
      <bpmn:incoming>SequenceFlow_20</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_21</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Timer Event -->
    <bpmn:sequenceFlow id="SequenceFlow_21" sourceRef="IntermediateTimerEvent_CustomerResponse" targetRef="IntermediateTimerEvent_2WeeksWait">
      <bpmn:description>No contact within 2 weeks</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Follow-up Call -->
    <bpmn:sequenceFlow id="SequenceFlow_22" sourceRef="IntermediateTimerEvent_2WeeksWait" targetRef="Task_FollowupCall">
      <bpmn:description>Sales rep calls customer</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Merge Responses -->
    <bpmn:sequenceFlow id="SequenceFlow_23" sourceRef="Task_FollowupCall" targetRef="ParallelGateway_MergeResponse"/>

    <bpmn:sequenceFlow id="SequenceFlow_24" sourceRef="ParallelGateway_MergeResponse" targetRef="Task_CreateQuotation">
      <bpmn:description>Proceed to quotation creation</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Final Task -->
    <bpmn:sequenceFlow id="SequenceFlow_25" sourceRef="Task_CreateQuotation" targetRef="End_ProcessComplete">
      <bpmn:description>Create quotation - process complete</bpmn:description>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>