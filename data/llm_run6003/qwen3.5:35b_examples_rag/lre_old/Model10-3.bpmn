<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_MPOO_Deregistration_1">
  <bpmn:collaboration id="Collaboration_MPOO_GO">
    <bpmn:participant id="Participant_MPOO" name="MPOO (Meter Point Operator Owner)" processRef="Process_MPOO"/>
    <bpmn:participant id="Participant_GO" name="GO (Grid Operator)" processRef="Process_GO"/>
  </bpmn:collaboration>

  <!-- MPOO Process -->
  <bpmn:process id="Process_MPOO" isExecutable="false">
    <bpmn:startEvent id="StartMPOO_1" name="Deregistration Request Initiated">
      <bpmn:outgoing>SequenceFlow_MPOO_01</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="TaskMPOO_Deregister" name="Register Deregistration at GO">
      <bpmn:incoming>SequenceFlow_MPOO_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MPOO_02</bpmn:outgoing>
    </bpmn:task>

    <!-- Optional continuation confirmation -->
    <bpmn:startEvent id="StartMPOO_Confirm" name="Confirmation Request Received">
      <bpmn:incoming/>
      <bpmn:outgoing>SequenceFlow_MPOO_05</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="TaskMPOO_ConfirmContinuation" name="Confirm Continuation of Operations">
      <bpmn:incoming>SequenceFlow_MPOO_05</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MPOO_06</bpmn:outgoing>
    </bpmn:task>

    <!-- End Events -->
    <bpmn:endEvent id="EndMPOO_Rejected" name="Deregistration Rejected">
      <bpmn:incoming>SequenceFlow_MPOO_03</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndMPOO_Complete" name="Process Complete">
      <bpmn:incoming>SequenceFlow_MPOO_06</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_MPOO_01" sourceRef="StartMPOO_1" targetRef="TaskMPOO_Deregister"/>
    
  </bpmn:process>

  <!-- GO Process -->
  <bpmn:process id="Process_GO" isExecutable="false">
    <bpmn:startEvent id="StartGO_Verification" name="Deregistration Request Received">
      <bpmn:incoming/>
      <bpmn:outgoing>SequenceFlow_GO_01</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Verification Task -->
    <bpmn:task id="TaskGO_Verify" name="Verify Deregistration of MPOO">
      <bpmn:incoming>SequenceFlow_GO_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GO_02</bpmn:outgoing>
    </bpmn:task>

    <!-- Decision Gateway -->
    <bpmn:exclusiveGateway id="GatewayGO_Decision" name="Reject or Confirm?">
      <bpmn:incoming>SequenceFlow_GO_02</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GO_03</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_GO_04</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Reject Path -->
    <bpmn:endEvent id="EndGO_Rejected" name="Deregistration Rejected">
      <bpmn:incoming>SequenceFlow_GO_03</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Confirm Path - Prepare Readmission -->
    <bpmn:task id="TaskGO_PrepareReadmission" name="Prepare Readmission of Measuring Point">
      <bpmn:incoming>SequenceFlow_GO_04</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GO_05</bpmn:outgoing>
    </bpmn:task>

    <!-- Optional Obligation Decision -->
    <bpmn:exclusiveGateway id="GatewayGO_Obligate" name="Obliged to Continue?">
      <bpmn:incoming>SequenceFlow_GO_05</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GO_06</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_GO_07</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Obligation Path - Request Confirmation -->
    <bpmn:startEvent id="StartGO_ConfirmationReceived" name="Confirmation Received">
      <bpmn:incoming/>
      <bpmn:outgoing>SequenceFlow_GO_09</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- No Obligation Path - Continue -->
    <bpmn:task id="TaskGO_Equipment" name="Perform Equipment Acquisition/Changes">
      <bpmn:incoming>SequenceFlow_GO_07</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GO_10</bpmn:outgoing>
    </bpmn:task>

    <!-- Task after MPOO confirmation -->
    <bpmn:startEvent id="StartGO_ConfirmationReceived2" name="Confirmation Received">
      <bpmn:incoming/>
      <bpmn:outgoing>SequenceFlow_GO_11</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Equipment Task after confirmation -->
    <bpmn:task id="TaskGO_EquipmentAfterConfirm" name="Perform Equipment Acquisition/Changes">
      <bpmn:incoming>SequenceFlow_GO_11</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GO_12</bpmn:outgoing>
    </bpmn:task>

    <!-- Assign GO as MPO -->
    <bpmn:task id="TaskGO_AssignMPO" name="Assign GO as MPO">
      <bpmn:incoming>SequenceFlow_GO_10</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GO_13</bpmn:outgoing>
    </bpmn:task>

    <!-- Inform about assignment end/beginning -->
    <bpmn:task id="TaskGO_InformMPOO" name="Inform MPOO of Assignment Change">
      <bpmn:incoming>SequenceFlow_GO_13</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GO_14</bpmn:outgoing>
    </bpmn:task>

    <!-- Inform MSPO -->
    <bpmn:intermediateThrowEvent id="IntermediateThrowEvent_GO_MSPO" name="Inform MSPO">
      <bpmn:incoming>SequenceFlow_GO_14</bpmn:incoming>
      <bpmn:outgoing/>
    </bpmn:intermediateThrowEvent>

    <!-- Inform SP -->
    <bpmn:task id="TaskGO_InformSP" name="Inform SP of Assignment">
      <bpmn:incoming>SequenceFlow_GO_15</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GO_16</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndGO_Complete" name="Process Complete">
      <bpmn:incoming>SequenceFlow_GO_17</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows for GO Process -->
    <bpmn:sequenceFlow id="SequenceFlow_GO_01" sourceRef="StartGO_Verification" targetRef="TaskGO_Verify"/>
    
    <!-- Gateway Decisions -->
    <bpmn:sequenceFlow id="SequenceFlow_GO_02" sourceRef="TaskGO_Verify" targetRef="GatewayGO_Decision"/>
    <bpmn:sequenceFlow id="SequenceFlow_GO_03" name="Reject Deregistration" sourceRef="GatewayGO_Decision" targetRef="EndGO_Rejected">
      <bpmn:name>Reject</bpmn:name>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_GO_04" name="Confirm Deregistration" sourceRef="GatewayGO_Decision" targetRef="TaskGO_PrepareReadmission">
      <bpmn:name>Preliminary Confirm</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Obligation Decision -->
    <bpmn:sequenceFlow id="SequenceFlow_GO_05" sourceRef="TaskGO_PrepareReadmission" targetRef="GatewayGO_Obligate"/>
    <bpmn:sequenceFlow id="SequenceFlow_GO_06" name="Obliged to Continue" sourceRef="GatewayGO_Obligate" targetRef="StartGO_ConfirmationReceived">
      <bpmn:name>Oblige</bpmn:name>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_GO_07" name="Not Obliged" sourceRef="GatewayGO_Obligate" targetRef="TaskGO_Equipment">
      <bpmn:name>No Obligation</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Equipment Tasks -->
    <bpmn:sequenceFlow id="SequenceFlow_GO_08" sourceRef="StartGO_ConfirmationReceived2" targetRef="TaskGO_EquipmentAfterConfirm"/>
    
    <!-- Assignment Tasks -->
    <bpmn:parallelGateway id="ParallelMerge_MPOO" name="Merge Paths">
      <bpmn:incoming>SequenceFlow_GO_10</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_GO_12</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GO_13</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Notification Tasks -->
    <bpmn:sequenceFlow id="SequenceFlow_GO_09" sourceRef="TaskGO_EquipmentAfterConfirm" targetRef="ParallelMerge_MPOO"/>
    <bpmn:sequenceFlow id="SequenceFlow_GO_10" sourceRef="TaskGO_AssignMPO" targetRef="ParallelMerge_MPOO">
      <bpmn:name>Assign GO as MPO</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Final Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_GO_13" sourceRef="ParallelMerge_MPOO" targetRef="TaskGO_InformMPOO"/>
    <bpmn:sequenceFlow id="SequenceFlow_GO_14" sourceRef="TaskGO_InformMPOO" targetRef="IntermediateThrowEvent_GO_MSPO"/>
    <bpmn:sequenceFlow id="SequenceFlow_GO_15" name="Inform MSPO and SP" sourceRef="IntermediateThrowEvent_GO_MSPO" targetRef="TaskGO_InformSP">
      <bpmn:name>Notify Parties</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>

</bpmn:definitions>