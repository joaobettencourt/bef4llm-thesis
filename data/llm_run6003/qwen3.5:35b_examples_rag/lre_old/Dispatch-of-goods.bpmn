<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_ShippingProcess">
  <bpmn:collaboration id="Collab_Shipping">
    <bpmn:participant id="Participant_ShippingSystem" name="Goods Shipping Process"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_GoodsShipping" isExecutable="false">
    
    <!-- Lane Set -->
    <bpmn:laneSet id="LaneSet_Shipping">
      <bpmn:lane id="Lane_Secretary" name="Secretary">
        <bpmn:name>Secretary</bpmn:name>
        <bpmn:flowNodeRef>StartEvent_GoodsToShip</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ClariyShippingMethod</bpmn:flowNodeRef>