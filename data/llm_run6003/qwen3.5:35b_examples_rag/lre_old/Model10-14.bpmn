<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_BillProcessing_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_BillFlow">
    <bpmn:participant id="Participant_Senders" name="Senders (MPOO, MSPO)" processRef="Process_SendBills"/>
    <bpmn:participant id="Participant_Receivers" name="Receivers (GO, MPON)" processRef="Process_ProcessBills"/>

    <!-- Message Flows -->
    <bpmn:messageFlow id="MessageFlow_Continuation_MPOO_GO" sourceRef="StartEvent_BillContMPOO" targetRef="IntermediateCatchEvent_ReceiveBillCont"/>
    <bpmn:messageFlow id="MessageFlow_Continuation_MSPO_GO" sourceRef="StartEvent_BillContMSPO" targetRef="IntermediateCatchEvent_ReceiveBillCont"/>
    <bpmn:messageFlow id="MessageFlow_Readings_MSPO_GO" sourceRef="StartEvent_BillReadingsMSPO" targetRef="IntermediateCatchEvent_ReceiveBillReadings"/>
    <bpmn:messageFlow id="MessageFlow_Equipment_MPOO_MPON" sourceRef="StartEvent_BillEquipMPOOMPON" targetRef="IntermediateCatchEvent_ReceiveBillEquipMPON"/>
    <bpmn:messageFlow id="MessageFlow_Equipment_MPOO_GO" sourceRef="StartEvent_BillEquipMPOOGO" targetRef="IntermediateCatchEvent_ReceiveBillEquipGO"/>

    <!-- Return Flows -->
    <bpmn:messageFlow id="MessageFlow_Confirm_Sender" sourceRef="Task_SendConfirmPaymentAdvice" targetRef="EndEvent_AcknowledgeSender"/>
    <bpmn:messageFlow id="MessageFlow_Reject_Sender" sourceRef="IntermediateCatchEvent_ThrowRejectMsg" targetRef="StartEvent_ReceiveRejection"/>

  </bpmn:collaboration>

  <!-- Process for Senders -->
  <bpmn:process id="Process_SendBills">
    <bpmn:startEvent id="StartEvent_BillContMPOO" name="Bill Temp Continuation (MPOO)">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_Send_01</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:startEvent id="StartEvent_BillContMSPO" name="Bill Temp Continuation (MSPO)">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_Send_02</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:startEvent id="StartEvent_BillReadingsMSPO" name="Bill Additional Readings (MSPO)">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_Send_03</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:startEvent id="StartEvent_BillEquipMPOOMPON" name="Bill Equip Acq (to MPON)">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_Send_04</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:startEvent id="StartEvent_BillEquipMPOOGO" name="Bill Equip Acq (to GO)">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_Send_05</bpmn:outgoing>
    </bpmn:startEvent>

  </bpmn:process>

  <!-- Process for Receivers -->
  <bpmn:process id="Process_ProcessBills">
    
    <bpmn:laneSet id="LaneSet_Receivers">
      <bpmn:lane id="Lane_GO" name="GO (Grid Operator)">
        <bpmn:name>General Office / Grid Operator</bpmn:name>
        <bpmn:flowNodeRef>IntermediateCatchEvent_ReceiveBillCont</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateCatchEvent_ReceiveBillReadings</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateCatchEvent_ReceiveBillEquipGO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExamineBill_GO</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_MPON" name="MPON (Network Operator)">
        <bpmn:name>Metering Point Network Operator</bpmn:name>
        <bpmn:flowNodeRef>IntermediateCatchEvent_ReceiveBillEquipMPON</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Intermediate Catch Events for Incoming Bills -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_ReceiveBillCont" name="Receive Bill (Continuation)">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_ProcessBills_01</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_ReceiveBillReadings" name="Receive Bill (Additional Readings)">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_ProcessBills_02</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_ReceiveBillEquipGO" name="Receive Bill (Equipment - GO)">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_ProcessBills_03</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

     <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_ReceiveBillEquipMPON" name="Receive Bill (Equipment - MPON)">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_ProcessBills_04</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task to Examine Bills -->
    <bpmn:task id="Task_ExamineBill_GO" name="Examine Bill">
      <bpmn:incoming>SequenceFlow_ProcessBills_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Decision_BillReview</bpmn:outgoing>
    </bpmn:task>

     <!-- Gateway for Decision -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_DecideBill" name="Confirm or Reject?">
      <bpmn:incoming>SequenceFlow_Decision_BillReview</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConfirmPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RejectPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

     <!-- Tasks for Confirmation/Rejection -->
    <bpmn:task id="Task_SendConfirmPaymentAdvice" name="Send Payment Advice">
      <bpmn:incoming>SequenceFlow_ConfirmPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OutConfirmMsg</bpmn:outgoing>
    </bpmn:task>

     <!-- Intermediate Event for Reject Message -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_ThrowRejectMsg" name="Send Reject Message">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SequenceFlow_OutRejectMsg</bpmn:incoming>
    </bpmn:intermediateCatchEvent>

     <!-- Start Event for Rejection on Sender Side -->
    <bpmn:startEvent id="StartEvent_ReceiveRejection" name="Received Rejection">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_ProcessReject</bpmn:outgoing>
    </bpmn:startEvent>

     <!-- End Event for Confirmation -->
    <bpmn:endEvent id="EndEvent_AcknowledgeSender" name="Acknowledge Sender">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SequenceFlow_OutConfirmMsg</bpmn:incoming>
    </bpmn:endEvent>

     <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_ProcessBills_01" sourceRef="IntermediateCatchEvent_ReceiveBillCont" targetRef="Task_ExamineBill_GO"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ProcessBills_02" sourceRef="IntermediateCatchEvent_ReceiveBillReadings" targetRef="Task_ExamineBill_GO"/>

    <bpmn:sequenceFlow id="SequenceFlow_ProcessBills_03" sourceRef="IntermediateCatchEvent_ReceiveBillEquipGO" targetRef="Task_ExamineBill_GO"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ProcessBills_04" sourceRef="IntermediateCatchEvent_ReceiveBillEquipMPON" targetRef="Task_ExamineBill_GO"/>

    <bpmn:sequenceFlow id="SequenceFlow_Decision_BillReview" sourceRef="Task_ExamineBill_GO" targetRef="ExclusiveGateway_DecideBill"/>
    
     <!-- Corrected Sequence Flow for Reject Path -->
    <bpmn:sequenceFlow id="SequenceFlow_RejectPath" sourceRef="ExclusiveGateway_DecideBill" targetRef="IntermediateCatchEvent_ThrowRejectMsg"/>

    <bpmn:sequenceFlow id="SequenceFlow_ConfirmPath" sourceRef="ExclusiveGateway_DecideBill" targetRef="Task_SendConfirmPaymentAdvice"/>
    
     <!-- Corrected Sequence Flow for Confirm Path -->
    <bpmn:sequenceFlow id="SequenceFlow_OutConfirmMsg" sourceRef="Task_SendConfirmPaymentAdvice" targetRef="EndEvent_AcknowledgeSender"/>

  </bpmn:process>
</bpmn:definitions>