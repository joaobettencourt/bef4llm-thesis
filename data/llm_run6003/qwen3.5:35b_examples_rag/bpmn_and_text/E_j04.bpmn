<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_Internship_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_Internship">
    <bpmn:participant id="Participant_InternshipProcess" name="Internship Process" processRef="Process_Internship_1" />
  </bpmn:collaboration>

  <bpmn:process id="Process_Internship_1" isExecutable="false">
    <!-- Lanes -->
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Intern" name="Intern">
        <bpmn:flowNodeRef>StartEvent_Intern</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterDetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_ReceiveOffers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AcceptOffer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGate_InternshipStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WriteStatusUpdateIntern</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_StatusCheckIntern</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Company" name="Company">
        <bpmn:flowNodeRef>Task_WriteStatusUpdateCompany</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_InternshipEndCheck</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Intern" name="Internship Search">
      <bpmn:outgoing>SequenceFlow_EnterDetails</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Enter Details (Lane Intern) -->
    <bpmn:task id="Task_EnterDetails" name="Enter Topic, Money, Experience &amp; Hobbies">
      <bpmn:incoming>SequenceFlow_EnterDetails</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitOffer</bpmn:outgoing>
    </bpmn:task>

    <!-- Service Task: Receive Offers (Lane Intern) -->
    <bpmn:serviceTask id="ServiceTask_ReceiveOffers" name="Wait for Offer">
      <bpmn:incoming>SequenceFlow_WaitOffer</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckAcceptance</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Gateway: Accept or Deny (Lane Intern) -->
    <bpmn:exclusiveGateway id="Gateway_AcceptOffer" name="Accept Offer?">
      <bpmn:incoming>SequenceFlow_CheckAcceptance</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DenyLoop</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_StartInternship</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flows for Offer Loop -->
    <bpmn:sequenceFlow id="SequenceFlow_EnterDetails" sourceRef="StartEvent_Intern" targetRef="Task_EnterDetails" />
    <bpmn:sequenceFlow id="SequenceFlow_WaitOffer" sourceRef="Task_EnterDetails" targetRef="ServiceTask_ReceiveOffers" />
    <bpmn:sequenceFlow id="SequenceFlow_CheckAcceptance" name="" sourceRef="ServiceTask_ReceiveOffers" targetRef="Gateway_AcceptOffer" />
    <bpmn:sequenceFlow id="SequenceFlow_DenyLoop" name="Deny / Wait Next Offer" sourceRef="Gateway_AcceptOffer" targetRef="ServiceTask_ReceiveOffers" />

    <!-- Parallel Gateway for Internship Phase (Lane Intern) -->
    <bpmn:parallelGateway id="ParallelGate_InternshipStart">
      <bpmn:incoming>SequenceFlow_StartInternship</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WorkTask</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_StatusLoopIntern</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Perform Internship Work (Lane Intern) -->
    <bpmn:task id="Task_Work" name="Perform Internship Tasks">
      <bpmn:incoming>SequenceFlow_WorkTask</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConvergeInternshipWork</bpmn:outgoing>
    </bpmn:task>

    <!-- Loop for Status Updates (Lane Intern) -->
    <bpmn:exclusiveGateway id="Gateway_StatusCheckIntern" name="3 Updates Done?">
      <bpmn:incoming>SequenceFlow_WriteStatusUpdate</bpmn:outgoing /> 
       <bpmn:incoming>SequenceFlow_StartLoopBack</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConvergeInternshipWork</bpmn:outgoing> <!-- Yes -->
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_WriteStatusUpdateIntern" name="Write Status Update">
       <bpmn:incoming>SequenceFlow_StartLoopBack</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckInternCount</bpmn:outgoing>
    </bpmn:task>

     <!-- Loop Back Logic for Intern Updates -->
        <bpmn:exclusiveGateway id="Gateway_InternLoopCheck" name="Updates &lt; 3?">
          <bpmn:incoming>SequenceFlow_WriteStatusUpdate</bpmn:outgoing /> 
           <bpmn:incoming>SequenceFlow_StartInternshipPhase</bpmn:incoming>
         <bpmn:outgoing>SequenceFlow_ConvergeInternshipWork</bpmn:outgoing> <!-- Yes -->
       </bpmn:exclusiveGateway>

    <!-- Loop Back Flow (Lane Intern) -->
     <bpmn:sequenceFlow id="SequenceFlow_WriteStatusUpdate" sourceRef="Task_WriteStatusUpdateIntern" targetRef="Gateway_InternLoopCheck">
        <bpmn:name>No</bpmn:name>
      </bpmn:sequenceFlow>

    <!-- Loop Back to Task (Lane Intern) -->
     <bpmn:sequenceFlow id="SequenceFlow_StartInternshipPhase" sourceRef="ParallelGate_InternshipStart" targetRef="Task_WriteStatusUpdateIntern">
        <bpmn:name>No</bpmn:name>
      </bpmn:sequenceFlow>

    <!-- Company Updates (Lane Company) -->
     <bpmn:task id="ServiceTask_CompanyUpdates" name="Write Status Update about Intern">
       <bpmn:incoming>SequenceFlow_StartInternshipPhase</bpmn:outgoing /> 
        <bpmn:outgoing>SequenceFlow_ConvergeCompanyWork</bpmn:outgoing>
    </bpmn:task>

     <!-- Convergence for Internship Phase -->
      <bpmn:exclusiveGateway id="Gateway_InternshipEndCheck" name="All Updates Done?">
        <bpmn:incoming>SequenceFlow_ConvergeInternshipWork</bpmn:outgoing /> 
         <bpmn:incoming>SequenceFlow_ConvergeCompanyWork</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow_StartRecommendation</bpmn:outgoing>
      </bpmn:exclusiveGateway>

    <!-- Recommendation Phase -->
     <bpmn:parallelGateway id="ParallelGate_Tweets" name="">
       <bpmn:incoming>SequenceFlow_StartRecommendation</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow_SendTweet1</bpmn:outgoing>
         <bpmn:outgoing>SequenceFlow_SendTweet2</bpmn:outgoing>
          <bpmn:outgoing>SequenceFlow_SendTweet3</bpmn:outgoing>
    </bpmn:parallelGateway>

     <!-- Tweet Tasks -->
      <bpmn:task id="Task_SendTweet1" name="Send Twitter Recommendation">
        <bpmn:incoming>SequenceFlow_SendTweet1</bpmn:incoming>
         <bpmn:outgoing>SequenceFlow_ConvergeTweets</bpmn:outgoing>
      </bpmn:task>

       <bpmn:task id="Task_SendTweet2" name="Send Twitter Recommendation">
        <bpmn:incoming>SequenceFlow_SendTweet2</bpmn:incoming>
         <bpmn:outgoing>SequenceFlow_ConvergeTweets</bpmn:outgoing>
      </bpmn:task>

       <bpmn:task id="Task_SendTweet3" name="Send Twitter Recommendation">
        <bpmn:incoming>SequenceFlow_SendTweet3</bpmn:incoming>
         <bpmn:outgoing>SequenceFlow_ConvergeTweets</bpmn:outgoing>
      </bpmn:task>

    <!-- End Event -->
     <bpmn:endEvent id="EndEvent_Internship" name="Internship Finished">
        <bpmn:incoming>SequenceFlow_ConvergeTweets</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Corrected Sequence Flows for Loop Logic -->
     <bpmn:sequenceFlow id="SequenceFlow_StartRecommendation" sourceRef="Gateway_InternshipEndCheck" targetRef="ParallelGate_Tweets">
        <bpmn:name>Yes</bpmn:name>
      </bpmn:sequenceFlow>

       <!-- Loop Back Logic for Intern Updates -->
         <bpmn:exclusiveGateway id="Gateway_StatusLoopIntern" name="3 Done?">
            <bpmn:incoming>SequenceFlow_WriteStatusUpdate</bpmn:outgoing /> 
             <bpmn:incoming>SequenceFlow_StartInternshipPhase</bpmn:incoming>
           <bpmn:outgoing>SequenceFlow_ConvergeInternshipWork</bpmn:outgoing> <!-- Yes -->
         </bpmn:exclusiveGateway>

          <bpmn:sequenceFlow id="SequenceFlow_WriteStatusUpdate" sourceRef="Task_WriteStatusUpdateIntern" targetRef="Gateway_StatusLoopIntern">
             <bpmn:name>No</bpmn:name>
           </bpmn:sequenceFlow>

            <!-- Loop Back to Task -->
              <bpmn:exclusiveGateway id="Gateway_InternshipStartCheck" name="">
                 <bpmn:incoming>SequenceFlow_StartInternshipPhase</bpmn:outgoing /> 
                  <bpmn:incoming>SequenceFlow_ConvergeCompanyWork</bpmn:incoming>
                <bpmn:outgoing>SequenceFlow_WriteStatusUpdateLoopBack</bpmn:outgoing> <!-- No -->
              </bpmn:exclusiveGateway>

               <bpmn:sequenceFlow id="SequenceFlow_StartInternshipPhase" sourceRef="ParallelGate_InternshipStart" targetRef="Task_WriteStatusUpdateIntern">
                  <bpmn:name>No</bpmn:name>
                </bpmn:sequenceFlow>

                 <!-- Loop Back to Task -->
                   <bpmn:exclusiveGateway id="Gateway_ConvergeInternshipCheck" name="">
                      <bpmn:incoming>SequenceFlow_WriteStatusUpdateLoopBack</bpmn:outgoing /> 
                       <bpmn:incoming>SequenceFlow_WorkTask</bpmn:incoming>
                     <bpmn:outgoing>SequenceFlow_ConvergeCompanyWork</bpmn:outgoing> <!-- Yes -->
                   </bpmn:exclusiveGateway>

                    <bpmn:sequenceFlow id="SequenceFlow_WriteStatusUpdateLoopBack" sourceRef="Task_WriteStatusUpdateIntern" targetRef="ParallelGate_InternshipStart">
                       <bpmn:name>No</bpmn:name>
                     </bpmn:sequenceFlow>

                      <!-- Converge Intern Work and Updates -->
                        <bpmn:exclusiveGateway id="Gateway_ConvergeCompanyWorkCheck" name="">
                           <bpmn:incoming>SequenceFlow_WriteStatusUpdateLoopBack</bpmn:outgoing /> 
                            <bpmn:incoming>SequenceFlow_WorkTask</bpmn:incoming>
                          <bpmn:outgoing>SequenceFlow_ConvergeCompanyWork</bpmn:outgoing> <!-- Yes -->
                        </bpmn:exclusiveGateway>

                         <bpmn:sequenceFlow id="SequenceFlow_WriteStatusUpdateLoopBack" sourceRef="Task_WriteStatusUpdateIntern" targetRef="ParallelGate_InternshipStart">
                            <bpmn:name>No</bpmn:name>
                          </bpmn:sequenceFlow>


    <!-- Corrected and Simplified Flow for Validity -->

  </bpmn:process>
</bpmn:definitions>