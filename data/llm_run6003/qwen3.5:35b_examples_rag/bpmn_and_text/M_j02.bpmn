<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_AirplaneManufacturing">
    <bpmn:participant id="Participant_LuxuryAirplanes" name="Luxury Airplane Manufacturing Process" processRef="Process_1" />
  </bpmn:collaboration>
  
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_SalesDepartment">
        <bpmn:flowNodeRef>StartEvent_OrderReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_CustomerPreferences</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendRequirementsToTeams</bpmn:flowNodeRef>
      </bpmn:lane>
      
      <bpmn:lane id="Lane_ManufacturingRussianTeam">
        <bpmn:flowNodeRef>InclusiveGateway_RussianManufacturing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ManufactureVodkaBar</bpmn:flowNodeRef>
      </bpmn:lane>
      
      <bpmn:lane id="Lane_ManufacturingIrishTeam">
        <bpmn:flowNodeRef>InclusiveGateway_IrishManufacturing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ManufactureWhiskeyBar</bpmn:flowNodeRef>
      </bpmn:lane>
      
      <bpmn:lane id="Lane_AssemblyDepartment">
        <bpmn:flowNodeRef>InclusiveGateway_InteriorAssembly</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssembleInterior</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_TestFlightPreparation</bpmn:flowNodeRef>
      </bpmn:lane>
      
      <bpmn:lane id="Lane_QualityAssurance">
        <bpmn:flowNodeRef>InclusiveGateway_TestFlight</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConductTestFlight</bpmn:flowNodeRef>
      </bpmn:lane>
      
      <bpmn:lane id="Lane_DeliveryDepartment">
        <bpmn:flowNodeRef>InclusiveGateway_ProtocolDistribution</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendTestProtocolToCompanyAndCustomer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DeliverPlaneToCustomer</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_OrderReceived" name="Order Received with Specifications">
      <bpmn:outgoing>SequenceFlow_CustomerPreferences</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Customer Preferences Gateway (Inclusive for multiple customization options) -->
    <bpmn:inclusiveGateway id="InclusiveGateway_CustomerPreferences" name="Customer Customization Options">
      <bpmn:incoming>SequenceFlow_CustomerPreferences</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendRequirementsToTeams</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Send Requirements to Teams -->
    <bpmn:task id="Task_SendRequirementsToTeams" name="Send Requirements to Manufacturing Teams">
      <bpmn:incoming>SequenceFlow_SendRequirementsToTeams</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ManufacturingSplit</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway for Multiple Team Manufacturing -->
    <bpmn:parallelGateway id="ParallelGateway_ManufacturingTeams" name="Manufacturing Teams Split">
      <bpmn:incoming>SequenceFlow_ManufacturingSplit</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RussianTeamTask</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_IrishTeamTask</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Russian Team Manufacturing -->
    <bpmn:inclusiveGateway id="InclusiveGateway_RussianManufacturing" name="Russian Team">
      <bpmn:incoming>SequenceFlow_RussianTeamTask</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_VodkaBarComplete</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Irish Team Manufacturing -->
    <bpmn:inclusiveGateway id="InclusiveGateway_IrishManufacturing" name="Irish Team">
      <bpmn:incoming>SequenceFlow_IrishTeamTask</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WhiskeyBarComplete</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Manufacturing Tasks -->
    <bpmn:task id="Task_ManufactureVodkaBar" name="Manufacture Vodka Bar">
      <bpmn:incoming>SequenceFlow_RussianTeamTask</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_VodkaBarComplete</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_ManufactureWhiskeyBar" name="Manufacture Whiskey Bar">
      <bpmn:incoming>SequenceFlow_IrishTeamTask</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WhiskeyBarComplete</bpmn:outgoing>
    </bpmn:task>

    <!-- Join Manufacturing Paths -->
    <bpmn:inclusiveGateway id="InclusiveGateway_InteriorAssembly" name="All Parts Ready">
      <bpmn:incoming>SequenceFlow_VodkaBarComplete</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_WhiskeyBarComplete</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AssembleInterior</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Interior Assembly -->
    <bpmn:task id="Task_AssembleInterior" name="Assemble Plane Interior">
      <bpmn:incoming>SequenceFlow_AssembleInterior</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TestFlightPreparation</bpmn:outgoing>
    </bpmn:task>

    <!-- Test Flight Preparation -->
    <bpmn:parallelGateway id="ParallelGateway_TestFlightPreparation" name="Test Flight Prep">
      <bpmn:incoming>SequenceFlow_TestFlightPreparation</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConductTestFlight</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Test Flight -->
    <bpmn:inclusiveGateway id="InclusiveGateway_TestFlight" name="Test Flight">
      <bpmn:incoming>SequenceFlow_ConductTestFlight</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProtocolCreated</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Conduct Test Flight -->
    <bpmn:task id="Task_ConductTestFlight" name="Conduct Test Flight">
      <bpmn:incoming>SequenceFlow_ConductTestFlight</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TestFlightComplete</bpmn:outgoing>
    </bpmn:task>

    <!-- Protocol Creation -->
    <bpmn:inclusiveGateway id="InclusiveGateway_ProtocolDistribution" name="Test Protocol Created">
      <bpmn:incoming>SequenceFlow_TestFlightComplete</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendProtocols</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Send Test Protocols -->
    <bpmn:task id="Task_SendTestProtocolToCompanyAndCustomer" name="Send Test Protocol to Company and Customer">
      <bpmn:incoming>SequenceFlow_SendProtocols</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DeliverPlane</bpmn:outgoing>
    </bpmn:task>

    <!-- Deliver Plane -->
    <bpmn:task id="Task_DeliverPlaneToCustomer" name="Deliver Plane to Customer">
      <bpmn:incoming>SequenceFlow_DeliverPlane</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CustomerConfirmationRequired</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_PlaneDelivered" name="Customer Confirmation Received">
      <bpmn:incoming>SequenceFlow_CustomerConfirmationReceived</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_CustomerPreferences" sourceRef="StartEvent_OrderReceived" targetRef="InclusiveGateway_CustomerPreferences" />
    
    <bpmn:sequenceFlow id="SequenceFlow_SendRequirementsToTeams" sourceRef="InclusiveGateway_CustomerPreferences" targetRef="Task_SendRequirementsToTeams" />
    
    <bpmn:sequenceFlow id="SequenceFlow_ManufacturingSplit" sourceRef="Task_SendRequirementsToTeams" targetRef="ParallelGateway_ManufacturingTeams" />
    
    <bpmn:sequenceFlow id="SequenceFlow_RussianTeamTask" sourceRef="ParallelGateway_ManufacturingTeams" targetRef="InclusiveGateway_RussianManufacturing" />
    
    <bpmn:sequenceFlow id="SequenceFlow_IrishTeamTask" sourceRef="ParallelGateway_ManufacturingTeams" targetRef="InclusiveGateway_IrishManufacturing" />
    
    <bpmn:sequenceFlow id="SequenceFlow_VodkaBarComplete" sourceRef="InclusiveGateway_RussianManufacturing" targetRef="InclusiveGateway_InteriorAssembly" />
    
    <bpmn:sequenceFlow id="SequenceFlow_WhiskeyBarComplete" sourceRef="InclusiveGateway_IrishManufacturing" targetRef="InclusiveGateway_InteriorAssembly" />
    
    <bpmn:sequenceFlow id="SequenceFlow_AssembleInterior" sourceRef="InclusiveGateway_InteriorAssembly" targetRef="Task_AssembleInterior" />
    
    <bpmn:sequenceFlow id="SequenceFlow_TestFlightPreparation" sourceRef="Task_AssembleInterior" targetRef="ParallelGateway_TestFlightPreparation" />
    
    <bpmn:sequenceFlow id="SequenceFlow_ConductTestFlight" sourceRef="ParallelGateway_TestFlightPreparation" targetRef="InclusiveGateway_TestFlight" />
    
    <bpmn:sequenceFlow id="SequenceFlow_ProtocolCreated" sourceRef="InclusiveGateway_TestFlight" targetRef="Task_SendTestProtocolToCompanyAndCustomer" />
    
    <bpmn:sequenceFlow id="SequenceFlow_SendProtocols" sourceRef="InclusiveGateway_ProtocolDistribution" targetRef="Task_SendTestProtocolToCompanyAndCustomer" />
    
    <bpmn:sequenceFlow id="SequenceFlow_TestFlightComplete" sourceRef="Task_ConductTestFlight" targetRef="InclusiveGateway_ProtocolDistribution" />
    
    <bpmn:sequenceFlow id="SequenceFlow_DeliverPlane" sourceRef="Task_SendTestProtocolToCompanyAndCustomer" targetRef="Task_DeliverPlaneToCustomer" />
    
    <bpmn:sequenceFlow id="SequenceFlow_CustomerConfirmationRequired" sourceRef="Task_DeliverPlaneToCustomer" targetRef="EndEvent_PlaneDelivered" />

  </bpmn:process>
</bpmn:definitions>