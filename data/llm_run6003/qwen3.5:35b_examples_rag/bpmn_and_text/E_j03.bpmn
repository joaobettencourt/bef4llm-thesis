<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_WorkAccidentReporting" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_WorkAccidentProcess" name="Work Accident Reporting Process" processRef="Process_1" />
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    
    <!-- Lane Set for Responsibilities -->
    <bpmn:laneSet>
      <bpmn:lane id="Lane_EmployeeStudentSelfEmployed" name="Employee / Student / Self-Employed">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VerifyEligibility</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_IsCoveredAccident</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReportToEmployerImmediate</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_EmployerEducationProvider" name="Employer / Education Provider">
        <bpmn:flowNodeRef>Gateway_SeverityCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReportToLabourInspectorate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReportToInsuranceProvider</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Authorities" name="Authorities / Insurer">
        <bpmn:flowNodeRef>EndEvent_LabourInspectorateReported</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_InsuranceProviderNotified</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Accident / Incident Occurs">
      <bpmn:outgoing>SequenceFlow_VerifyEligibility</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Verify Eligibility based on text criteria -->
    <bpmn:task id="Task_VerifyEligibility" name="Verify Work Accident Criteria">
      <bpmn:description>Determine if accident qualifies (Employment type, Location, Activity e.g. Training/Route/Volunteer/Agricultural)</bpmn:description>
      <bpmn:incoming>SequenceFlow_VerifyEligibility</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckCoveredStatus</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Is it a covered accident? -->
    <bpmn:exclusiveGateway id="Gateway_IsCoveredAccident" name="Is Covered Accident?">
      <bpmn:incoming>SequenceFlow_CheckCoveredStatus</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NotCovered</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ProceedToReport</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event for Non-Covered -->
    <bpmn:endEvent id="EndEvent_NotCovered" name="Not a Work Accident">
      <bpmn:incoming>SequenceFlow_NotCovered</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task: Employee Reports to Employer (Immediate) -->
    <bpmn:userTask id="Task_ReportToEmployerImmediate" name="Report Incident/Risk/Defect">
      <bpmn:description>Inform employer immediately of accident, near-miss, risk or defect.</bpmn:description>
      <bpmn:incoming>SequenceFlow_ProceedToReport</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EmployeeReportsDone</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway: Severity Check for Reporting Obligations -->
    <bpmn:exclusiveGateway id="Gateway_SeverityCheck" name="Severity / Type?">
      <bpmn:incoming>SequenceFlow_EmployeeReportsDone</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FatalitySeriousInjury</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SeriousAccidentInsured</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Path 1: Fatality / Serious Injury -->
    <bpmn:task id="Task_ReportToLabourInspectorate" name="Report to Labour Inspectorate">
      <bpmn:description>Employer reports fatality or serious injury immediately (if not emergency services).</bpmn:description>
      <bpmn:incoming>SequenceFlow_FatalitySeriousInjury</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InspectorateReported</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event for Inspectorate -->
    <bpmn:endEvent id="EndEvent_LabourInspectorateReported" name="Inspection Report Filed">
      <bpmn:incoming>SequenceFlow_InspectorateReported</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Path 2: Serious Accident / Fatality (5 Days Rule) -->
    <bpmn:userTask id="Task_ReportToInsuranceProvider" name="Report to Insurance Provider">
      <bpmn:description>Report within 5 days if fatality, injury preventing work &gt;3 days. Applies to Employer/Schools/Self-Employed.</bpmn:description>
      <bpmn:incoming>SequenceFlow_SeriousAccidentInsured</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InsuranceNotified</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event for Insurance -->
    <bpmn:endEvent id="EndEvent_InsuranceProviderNotified" name="Insurer Notified">
      <bpmn:incoming>SequenceFlow_InsuranceNotified</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_VerifyEligibility" sourceRef="StartEvent_1" targetRef="Task_VerifyEligibility">
      <bpmn:name></bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_CheckCoveredStatus" sourceRef="Task_VerifyEligibility" targetRef="Gateway_IsCoveredAccident">
      <bpmn:name></bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_NotCovered" name="No" sourceRef="Gateway_IsCoveredAccident" targetRef="EndEvent_NotCovered">
      <bpmn:name>Not Covered</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ProceedToReport" name="Yes" sourceRef="Gateway_IsCoveredAccident" targetRef="Task_ReportToEmployerImmediate">
      <bpmn:name>Covered</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_EmployeeReportsDone" name="" sourceRef="Task_ReportToEmployerImmediate" targetRef="Gateway_SeverityCheck">
      <!-- Implicit flow to next decision point -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_FatalitySeriousInjury" name="Fatality/Serious Injury" sourceRef="Gateway_SeverityCheck" targetRef="Task_ReportToLabourInspectorate">
      <bpmn:name>Fatality / Serious</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_InspectorateReported" sourceRef="Task_ReportToLabourInspectorate" targetRef="EndEvent_LabourInspectorateReported">
      <!-- Flow to end -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_SeriousAccidentInsured" name="Injury &gt;3 Days / Fatality (5 Day Rule)" sourceRef="Gateway_SeverityCheck" targetRef="Task_ReportToInsuranceProvider">
      <bpmn:name>&gt;3 Days Injury</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_InsuranceNotified" sourceRef="Task_ReportToInsuranceProvider" targetRef="EndEvent_InsuranceProviderNotified">
      <!-- Flow to end -->
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>