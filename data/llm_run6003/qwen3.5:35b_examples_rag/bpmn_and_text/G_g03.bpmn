<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                 xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                 xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                 xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" 
                 id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:collaboration id="Collab_CharacterCreation">
    <bpmn:participant id="Participant_AccountSetup" name="Account Setup Process" processRef="Process_Account"/>
    <bpmn:messageFlow id="Msg_ConfirmMailLink" sourceRef="End_MailConfirmation" targetRef="Start_SubscriptionCheck"/>
  </bpmn:collaboration>

  <!-- Account Setup Process -->
  <bpmn:process id="Process_Account">
    <bpmn:startEvent id="Start_CreateCharacter" name="Create Character">
      <bpmn:outgoing>Seq_StartToParallel</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:endEvent id="End_SubscriptionCheck" name="Subscription Checked">
      <bpmn:incoming>Seq_CheckSubComplete</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Parallel Gateway for Account Setup and Name Brainstorming -->
    <bpmn:parallelGateway id="Parallel_StartBranches" gatewayDirection="Diverging">
      <bpmn:incoming>Seq_StartToParallel</bpmn:incoming>
      <bpmn:outgoing>Seq_CheckBattleNet</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Account Setup Flow -->
    <bpmn:userTask id="Task_CheckBattleNet" name="Check Battle.net Account">
      <bpmn:incoming>Seq_CheckBattleNet</bpmn:incoming>
      <bpmn:outgoing>Seq_HasAccountDecision</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Decision Gateway -->
    <bpmn:exclusiveGateway id="GW_AccountExists" gatewayDirection="Diverging">
      <bpmn:incoming>Seq_HasAccountDecision</bpmn:incoming>
      <bpmn:outgoing>Seq_NewAccountFlow</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- New Account Flow -->
    <bpmn:userTask id="Task_EnterNewInfo" name="Enter Account Information">
      <bpmn:incoming>Seq_NewAccountFlow</bpmn:incoming>
      <bpmn:outgoing>Seq_ConfirmLinkClick</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event for Mail Confirmation -->
    <bpmn:endEvent id="End_MailConfirmation" name="Confirm via Link">
      <bpmn:incoming>Seq_ConfirmLinkClick</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Subscription Check Task (after receiving confirmation) -->
    <bpmn:startEvent id="Start_SubscriptionCheck" name="Subscription Status Checked">
      <bpmn:outgoing>Seq_CheckSubComplete</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_SelectPaymentMethod" name="Select Payment Method">
      <bpmn:incoming>Seq_PaymentSelectionFlow</bpmn:incoming>
      <bpmn:outgoing>Seq_CreditCardChoice</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Credit Card Path -->
    <bpmn:userTask id="Task_EnterCreditCard" name="Enter Credit Card Information">
      <bpmn:incoming>Seq_CreditCardFlow</bpmn:incoming>
      <bpmn:outgoing>Seq_PaymentCompleteCC</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Bank Account Path -->
    <bpmn:userTask id="Task_EnterBankDetails" name="Enter IBAN and BIC">
      <bpmn:incoming>Seq_BankAccountFlow</bpmn:incoming>
      <bpmn:outgoing>Seq_PaymentCompleteBA</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Payment Complete Gateway -->
    <bpmn:exclusiveGateway id="GW_SubscriptionActive" gatewayDirection="Diverging">
      <bpmn:incoming>Seq_CheckSubComplete</bpmn:incoming>
      <bpmn:outgoing>Seq_PaymentSelectionFlow</bpmn:outgoing>
    </bpmn:exclusiveGateway>

  </bpmn:process>

  <!-- Character Creation Process -->
  <bpmn:process id="Process_Character">
    <bpmn:startEvent id="Start_NameBrainstorming" name="Character Name Brainstorming">
      <bpmn:outgoing>Seq_StartToParallel</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Parallel Gateway for Account Setup and Character Creation -->
    <bpmn:parallelGateway id="Parallel_AccountSetup" gatewayDirection="Diverging">
      <bpmn:incoming>Seq_StartToParallel</bpmn:incoming>
      <bpmn:outgoing>Seq_CheckBattleNet</bpmn:outgoing>
    </bpmn:parallelGateway>

  </bpmn:process>

  <!-- Message Flows -->
  <bpmn:messageFlow id="Msg_ConfirmMailLink" sourceRef="End_MailConfirmation" targetRef="Start_SubscriptionCheck"/>

</bpmn:definitions>