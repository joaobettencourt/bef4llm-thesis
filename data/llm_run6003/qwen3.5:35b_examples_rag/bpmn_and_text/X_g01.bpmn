<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_USICourseRegistration">
    <bpmn:participant id="Participant_UserProcess" name="USI Course Registration Process" processRef="Process_CourseRegistration"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_CourseRegistration" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Register for USI Course">
      <bpmn:outgoing>bpmn:SequenceFlow_SelectCourse</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Select course task -->
    <bpmn:userTask id="Task_SelectCourse" name="Select a course (check slots)">
      <bpmn:incoming>bpmn:SequenceFlow_SelectCourse</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_CheckSlots</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway for slot availability -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_Slots" name="Slots available?">
      <bpmn:incoming>bpmn:SequenceFlow_CheckSlots</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_HaveAccount</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Check account task -->
    <bpmn:userTask id="Task_CheckAccount" name="Check if have sports institute account">
      <bpmn:incoming>bpmn:SequenceFlow_HaveAccount</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_AccountDecision</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Account decision gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_Account" name="Have account?">
      <bpmn:incoming>bpmn:SequenceFlow_AccountDecision</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_LoginAccount</bpmn:outgoing>
      <bpmn:outgoing>bpmn:SequenceFlow_CheckUniversity</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Login task -->
    <bpmn:userTask id="Task_Login" name="Log into account">
      <bpmn:incoming>bpmn:SequenceFlow_LoginAccount</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_TwitterTweet</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Check university registration -->
    <bpmn:userTask id="Task_CheckUniversity" name="Check eligible university registration">
      <bpmn:incoming>bpmn:SequenceFlow_CheckUniversity</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_UniversityDecision</bpmn:outgoing>
    </bpmn:userTask>

    <!-- University decision gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_University" name="Registered at eligible university?">
      <bpmn:incoming>bpmn:SequenceFlow_UniversityDecision</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_RegisterAccount</bpmn:outgoing>
      <bpmn:outgoing>bpmn:SequenceFlow_RequestActivation</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Register account task -->
    <bpmn:userTask id="Task_RegisterAccount" name="Register your account">
      <bpmn:incoming>bpmn:SequenceFlow_RegisterAccount</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_LoginAfterRegistration</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Request activation task -->
    <bpmn:userTask id="Task_RequestActivation" name="Request account activation">
      <bpmn:incoming>bpmn:SequenceFlow_RequestActivation</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_WaitResponse</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Intermediate catch event for waiting -->
    <bpmn:startEvent id="StartEvent_2" name="Activation response received">
      <bpmn:incoming/>
      <bpmn:outgoing>bpmn:SequenceFlow_LoginAfterActivation</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Twitter tweet task -->
    <bpmn:userTask id="Task_TwitterTweet" name="Tweet to friends (Twitter)">
      <bpmn:incoming>bpmn:SequenceFlow_TwitterTweet</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_CompleteRegistration</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Complete registration task -->
    <bpmn:userTask id="Task_CompleteRegistration" name="Complete course registration &amp; payment">
      <bpmn:incoming>bpmn:SequenceFlow_CompleteRegistration</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_ReceiveTicket</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_1" name="Course ticket received">
      <bpmn:incoming>bpmn:SequenceFlow_ReceiveTicket</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_SelectCourse" sourceRef="StartEvent_1" targetRef="Task_SelectCourse"/>
    <bpmn:sequenceFlow id="SequenceFlow_CheckSlots" name="Yes - slots available" sourceRef="ExclusiveGateway_Slots" targetRef="Task_CheckAccount"/>
    <bpmn:sequenceFlow id="SequenceFlow_HaveAccount" sourceRef="Task_CheckAccount" targetRef="ExclusiveGateway_Account"/>
    
    <!-- Account decision flows -->
    <bpmn:sequenceFlow id="SequenceFlow_LoginAccount" name="Yes - have account" sourceRef="ExclusiveGateway_Account" targetRef="Task_Login"/>
    <bpmn:sequenceFlow id="SequenceFlow_CheckUniversity" name="No - need to check university" sourceRef="ExclusiveGateway_Account" targetRef="Task_CheckUniversity"/>

    <!-- University decision flows -->
    <bpmn:sequenceFlow id="SequenceFlow_UniversityDecision" sourceRef="Task_CheckUniversity" targetRef="ExclusiveGateway_University"/>
    <bpmn:sequenceFlow id="SequenceFlow_RegisterAccount" name="Yes - eligible university" sourceRef="ExclusiveGateway_University" targetRef="Task_RegisterAccount"/>
    <bpmn:sequenceFlow id="SequenceFlow_RequestActivation" name="No - request activation" sourceRef="ExclusiveGateway_University" targetRef="Task_RequestActivation"/>

    <!-- Login flows -->
    <bpmn:sequenceFlow id="SequenceFlow_LoginAfterRegistration" sourceRef="Task_RegisterAccount" targetRef="Task_TwitterTweet"/>
    <bpmn:sequenceFlow id="SequenceFlow_LoginAfterActivation" name="Response received" sourceRef="StartEvent_2" targetRef="Task_TwitterTweet"/>

    <!-- Twitter and completion flows -->
    <bpmn:sequenceFlow id="SequenceFlow_TwitterTweet" sourceRef="Task_Login" targetRef="Task_TwitterTweet"/>
    <bpmn:sequenceFlow id="SequenceFlow_CompleteRegistration" name="Complete registration &amp; payment" sourceRef="Task_TwitterTweet" targetRef="Task_CompleteRegistration"/>

    <!-- Final flow -->
    <bpmn:sequenceFlow id="SequenceFlow_ReceiveTicket" sourceRef="Task_CompleteRegistration" targetRef="EndEvent_1"/>

  </bpmn:process>
</bpmn:definitions>