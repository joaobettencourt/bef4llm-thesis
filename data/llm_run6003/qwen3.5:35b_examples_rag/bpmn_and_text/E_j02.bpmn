<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                 xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" 
                 xmlns:di="http://www.omg.org/spec/DD/20100524/DI" 
                 xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                 id="Definitions_BecomingParent_1" targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:collaboration id="Collaboration_MaternityLeave">
    <bpmn:participant id="Participant_ParentProcess" name="Maternity Leave Process" processRef="Process_BecomingParent"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_BecomingParent" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Maternity Leave Planning Initiated">
      <bpmn:outgoing>SequenceFlow_FetchInfo</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Fetch Information -->
    <bpmn:userTask id="Task_1" name="Fetch Info on Leave Models">
      <bpmn:incoming>SequenceFlow_FetchInfo</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SelectModel</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task 2: Parent Selects Model -->
    <bpmn:userTask id="Task_2" name="Select Leave Model">
      <bpmn:incoming>SequenceFlow_SelectModel</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CollectInfo</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task 3: Collect Information -->
    <bpmn:userTask id="Task_3" name="Collect Relevant Info">
      <bpmn:incoming>SequenceFlow_CollectInfo</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NotifyParties</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel Gateway for Notifications -->
    <bpmn:parallelGateway id="ParallelGateway_1" name="Notify Parties">
      <bpmn:incoming>SequenceFlow_NotifyParties</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NotifSS</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NotifCompany</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 4a: Notify Social Security -->
    <bpmn:userTask id="Task_4" name="Notify Social Security">
      <bpmn:incoming>SequenceFlow_NotifSS</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GatherInfo1</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task 4b: Notify Company -->
    <bpmn:userTask id="Task_5" name="Notify Company">
      <bpmn:incoming>SequenceFlow_NotifCompany</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GatherInfo2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel Gateway to Gather Info -->
    <bpmn:parallelGateway id="ParallelGateway_2" name="Gather Company Info">
      <bpmn:incoming>SequenceFlow_GatherInfo1</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_GatherInfo2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndPeriodCheck</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 5: Gather Information from Companies -->
    <bpmn:userTask id="Task_6" name="Gather Company Info">
      <bpmn:incoming>SequenceFlow_EndPeriodCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DecideExtension</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Decision Gateway for Extension -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_1" name="Extend Leave?">
      <bpmn:incoming>SequenceFlow_DecideExtension</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_YesExtension</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoExtension</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 7a: Extend Leave (Loop back) -->
    <bpmn:userTask id="Task_7" name="Process Extension">
      <bpmn:incoming>SequenceFlow_YesExtension</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CollectMoreInfo</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task 7b: Collect More Info for Extension -->
    <bpmn:userTask id="Task_8" name="Collect Additional Info">
      <bpmn:incoming>SequenceFlow_CollectMoreInfo</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NotifyExtension</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task 7c: Notify for Extension -->
    <bpmn:userTask id="Task_9" name="Notify Parties of Extension">
      <bpmn:incoming>SequenceFlow_NotifyExtension</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndPeriodCheck2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_1" name="Maternity Leave Process Completed">
      <bpmn:incoming>SequenceFlow_NoExtension</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows (inside process) -->
    <bpmn:sequenceFlow id="SequenceFlow_FetchInfo" sourceRef="StartEvent_1" targetRef="Task_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_SelectModel" sourceRef="Task_1" targetRef="Task_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_CollectInfo" sourceRef="Task_2" targetRef="Task_3"/>
    <bpmn:sequenceFlow id="SequenceFlow_NotifyParties" sourceRef="Task_3" targetRef="ParallelGateway_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_NotifSS" sourceRef="ParallelGateway_1" targetRef="Task_4"/>
    <bpmn:sequenceFlow id="SequenceFlow_NotifCompany" sourceRef="ParallelGateway_1" targetRef="Task_5"/>
    <bpmn:sequenceFlow id="SequenceFlow_GatherInfo1" sourceRef="Task_4" targetRef="ParallelGateway_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_GatherInfo2" sourceRef="Task_5" targetRef="ParallelGateway_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_EndPeriodCheck" sourceRef="ParallelGateway_2" targetRef="Task_6"/>
    <bpmn:sequenceFlow id="SequenceFlow_DecideExtension" sourceRef="Task_6" targetRef="ExclusiveGateway_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_YesExtension" name="Yes - Extend" sourceRef="ExclusiveGateway_1" targetRef="Task_7"/>
    <bpmn:sequenceFlow id="SequenceFlow_NoExtension" name="No - Complete" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_1"/>

  </bpmn:process>
</bpmn:definitions>