<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_FarmingBot">
    <bpmn:participant id="Participant_PlayerProcess" name="Farming Bot Creation Process" processRef="Process_FarmingBot_1" />
  </bpmn:collaboration>

  <bpmn:process id="Process_FarmingBot_1" isExecutable="false">
    <!-- Lane Set for Organization -->
    <bpmn:laneSet>
      <bpmn:lane id="Lane_PlayerConfiguration">
        <bpmn:flowNodeRef>StartEvent_CreateBot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_ResourcesSelection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_DependencyCheck</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_BotFarming">
        <bpmn:flowNodeRef>InclusiveGateway_FarmStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GatherResources</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_DisasterCheck</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Notifications">
        <bpmn:flowNodeRef>InclusiveGateway_MilestoneNotification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendUpdateToPlayer</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_PostFarming">
        <bpmn:flowNodeRef>InclusiveGateway_FarmEndMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BragToFriends</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendMaterialsToFriends</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_CreateBot" name="Create Custom Bot">
      <bpmn:outgoing>SequenceFlow_StartToResources</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Resource Selection (Up to 10 in parallel) -->
    <bpmn:inclusiveGateway id="InclusiveGateway_ResourcesSelection" name="Select Resources">
      <bpmn:incoming>SequenceFlow_StartToResources</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ResourceTask1</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ResourceTask2</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ResourceTask3</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Resource Tasks (Example of 10 parallel resources) -->
    <bpmn:task id="Task_SelectResource_1" name="Select Wood">
      <bpmn:incoming>SequenceFlow_ResourceTask1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToDependencyCheck_1</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_SelectResource_2" name="Select Stone">
      <bpmn:incoming>SequenceFlow_ResourceTask2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToDependencyCheck_2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_SelectResource_3" name="Select Iron">
      <bpmn:incoming>SequenceFlow_ResourceTask3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToDependencyCheck_3</bpmn:outgoing>
    </bpmn:task>

    <!-- Dependency Check Gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_DependencyCheck" name="Dependencies Met?">
      <bpmn:incoming>SequenceFlow_ToDependencyCheck_1</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ToDependencyCheck_2</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ToDependencyCheck_3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StartFarming</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Farming Start -->
    <bpmn:inclusiveGateway id="InclusiveGateway_FarmStart" name="Begin Farming">
      <bpmn:incoming>SequenceFlow_StartFarming</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GatherResources</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Resource Gathering Task -->
    <bpmn:task id="Task_GatherResources" name="Gather Resources">
      <bpmn:incoming>SequenceFlow_GatherResources</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DisasterCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Disaster Check -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_DisasterCheck" name="Disaster Occurred?">
      <bpmn:incoming>SequenceFlow_DisasterCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ContinueFarming</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SetBackProcess</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Continue Farming -->
    <bpmn:task id="Task_ContinueFarming" name="Resume Gathering">
      <bpmn:incoming>SequenceFlow_ContinueFarming</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckMilestone</bpmn:outgoing>
    </bpmn:task>

    <!-- Set Back Process -->
    <bpmn:subProcess id="SubProcess_SetBack" name="Handle Disaster Recovery">
      <bpmn:incoming>SequenceFlow_SetBackProcess</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ResumeAfterDisaster</bpmn:outgoing>
    </bpmn:subProcess>

    <!-- Milestone Check -->
    <bpmn:inclusiveGateway id="InclusiveGateway_MilestoneNotification" name="Milestone Reached?">
      <bpmn:incoming>SequenceFlow_CheckMilestone</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendUpdateToPlayer</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Send Update -->
    <bpmn:task id="Task_SendUpdateToPlayer" name="Send Milestone Notification">
      <bpmn:incoming>SequenceFlow_SendUpdateToPlayer</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckFarmingComplete</bpmn:outgoing>
    </bpmn:task>

    <!-- Check if Farming Complete -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_FarmComplete" name="All Resources Gathered?">
      <bpmn:incoming>SequenceFlow_CheckFarmingComplete</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ContinueGathering</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_FarmFinished</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Farm Finished -->
    <bpmn:inclusiveGateway id="InclusiveGateway_FarmEndMerge" name="Farming Complete - Merge">
      <bpmn:incoming>SequenceFlow_FarmFinished</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BragToFriends</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Brag to Friends -->
    <bpmn:task id="Task_BragToFriends" name="Brag to Selected Friends">
      <bpmn:incoming>SequenceFlow_BragToFriends</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendMaterialsOption</bpmn:outgoing>
    </bpmn:task>

    <!-- Send Materials Option -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_SendMaterials" name="Send Materials?">
      <bpmn:incoming>SequenceFlow_SendMaterialsOption</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendToFriends</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Send Materials -->
    <bpmn:task id="Task_SendMaterialsToFriends" name="Send Materials to Friends">
      <bpmn:incoming>SequenceFlow_SendToFriends</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProcessEnd</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_FarmComplete" name="Bot Finished">
      <bpmn:incoming>SequenceFlow_ProcessEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToResources" sourceRef="StartEvent_CreateBot" targetRef="InclusiveGateway_ResourcesSelection">
      <bpmn:name>Create Bot Preferences</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ResourceTask1" name="Select Wood Resource" sourceRef="InclusiveGateway_ResourcesSelection" targetRef="Task_SelectResource_1">
      <bpmn:outgoing>SequenceFlow_ToDependencyCheck_1</bpmn:outgoing>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ResourceTask2" name="Select Stone Resource" sourceRef="InclusiveGateway_ResourcesSelection" targetRef="Task_SelectResource_2">
      <bpmn:outgoing>SequenceFlow_ToDependencyCheck_2</bpmn:outgoing>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ResourceTask3" name="Select Iron Resource" sourceRef="InclusiveGateway_ResourcesSelection" targetRef="Task_SelectResource_3">
      <bpmn:outgoing>SequenceFlow_ToDependencyCheck_3</bpmn:outgoing>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ToDependencyCheck_1" name="All Resources Selected" sourceRef="Task_SelectResource_1" targetRef="ExclusiveGateway_DependencyCheck">
      <bpmn:name>All Resources Selected</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ToDependencyCheck_2" name="All Resources Selected" sourceRef="Task_SelectResource_2" targetRef="ExclusiveGateway_DependencyCheck">
      <bpmn:name>All Resources Selected</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ToDependencyCheck_3" name="All Resources Selected" sourceRef="Task_SelectResource_3" targetRef="ExclusiveGateway_DependencyCheck">
      <bpmn:name>All Resources Selected</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_StartFarming" name="Dependencies Met - Start Farming" sourceRef="ExclusiveGateway_DependencyCheck" targetRef="InclusiveGateway_FarmStart">
      <bpmn:outgoing>SequenceFlow_GatherResources</bpmn:outgoing>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_GatherResources" name="Gathering Resources" sourceRef="InclusiveGateway_FarmStart" targetRef="Task_GatherResources">
      <bpmn:name>Gathering Resources</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_DisasterCheck" name="Disaster Check" sourceRef="Task_GatherResources" targetRef="ExclusiveGateway_DisasterCheck">
      <bpmn:outgoing>SequenceFlow_ContinueFarming</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SetBackProcess</bpmn:outgoing>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ContinueFarming" name="No Disaster - Continue" sourceRef="ExclusiveGateway_DisasterCheck" targetRef="Task_ContinueFarming">
      <bpmn:name>No Disaster</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_SetBackProcess" name="Disaster Occurred - Set Back" sourceRef="ExclusiveGateway_DisasterCheck" targetRef="SubProcess_SetBack">
      <bpmn:name>Yes</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ResumeAfterDisaster" name="Recovery Complete - Resume Farming" sourceRef="SubProcess_SetBack" targetRef="Task_GatherResources">
      <bpmn:outgoing>SequenceFlow_CheckMilestone</bpmn:outgoing>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_CheckMilestone" name="Check Milestone Progress" sourceRef="Task_ContinueFarming" targetRef="InclusiveGateway_MilestoneNotification">
      <bpmn:name>Milestone Reached</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_SendUpdateToPlayer" name="Send Notification to Player" sourceRef="InclusiveGateway_MilestoneNotification" targetRef="Task_SendUpdateToPlayer">
      <bpmn:name>Milestone Reached</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_CheckFarmingComplete" name="Check Completion Status" sourceRef="Task_SendUpdateToPlayer" targetRef="ExclusiveGateway_FarmComplete">
      <bpmn:name>All Resources Gathered?</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ContinueGathering" name="Not Complete - Update List and Continue" sourceRef="ExclusiveGateway_FarmComplete" targetRef="Task_GatherResources">
      <bpmn:name>No</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_FarmFinished" name="All Resources Gathered - Farm Complete" sourceRef="ExclusiveGateway_FarmComplete" targetRef="InclusiveGateway_FarmEndMerge">
      <bpmn:name>Yes</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_BragToFriends" name="Brag to Friends Option" sourceRef="InclusiveGateway_FarmEndMerge" targetRef="Task_BragToFriends">
      <bpmn:name>Bragging</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_SendMaterialsOption" name="Send Materials Option" sourceRef="Task_BragToFriends" targetRef="ExclusiveGateway_SendMaterials">
      <bpmn:name>Send Materials?</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_SendToFriends" name="Yes - Send Materials" sourceRef="ExclusiveGateway_SendMaterials" targetRef="Task_SendMaterialsToFriends">
      <bpmn:name>Send</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ProcessEnd" name="Process Complete - End Event" sourceRef="Task_SendMaterialsToFriends" targetRef="EndEvent_FarmComplete">
      <bpmn:name>Farming Bot Finished</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>