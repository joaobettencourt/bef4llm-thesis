<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_AccountCreation_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_AccountCreation">
    <bpmn:participant id="Participant_Customer" name="Customer" processRef="Process_CustomerSide"/>
    <bpmn:participant id="Participant_Bank" name="Bank Process" processRef="Process_BankSide"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_CustomerSide" isExecutable="false">
    <bpmn:startEvent id="StartCustomerVisit_1" name="Visit Bank Website">
      <bpmn:outgoing>Flow_StartToFillData</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_FillPersonalData_1" name="Fill Personal Data and Generate PDF">
      <bpmn:incoming>Flow_StartToFillData</bpmn:incoming>
      <bpmn:outgoing>Flow_GeneratePDF_Print</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_PrintDocument_1" name="Print PDF Document">
      <bpmn:incoming>Flow_GeneratePDF_Print</bpmn:incoming>
      <bpmn:outgoing>Flow_VisitPostOffice_Send</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_SendDocuments_1" name="Send Documents to Post Office">
      <bpmn:incoming>Flow_VisitPostOffice_Send</bpmn:incoming>
      <bpmn:outgoing>Flow_CustomerWait_EndCustomerDone</bpmn:outgoing>
    </bmmn:userTask>

    <bpmn:endEvent id="EndCustomerDone_1" name="Documents Sent">
      <bpmn:incoming>Flow_CustomerWait_EndCustomerDone</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_StartToFillData" sourceRef="StartCustomerVisit_1" targetRef="Task_FillPersonalData_1"/>
    <bpmn:sequenceFlow id="Flow_GeneratePDF_Print" sourceRef="Task_FillPersonalData_1" targetRef="Task_PrintDocument_1"/>
    <bpmn:sequenceFlow id="Flow_VisitPostOffice_Send" sourceRef="Task_PrintDocument_1" targetRef="Task_SendDocuments_1"/>

  </bpmn:process>

  <bpmn:process id="Process_BankSide" isExecutable="false">
    <bpmn:startEvent id="StartRequestReceived_1" name="Account Request Received">
      <bpmn:outgoing>Flow_StartToCheckIdentity</bpmn:outgoing>
    </bmmn:startEvent>

    <bpmn:userTask id="Task_CheckCustomerIdentity_1" name="Check Customer Identity">
      <bpmn:incoming>Flow_StartToCheckIdentity</bpmn:incoming>
      <bpmn:outgoing>Flow_SendRequestBank_BankOfficerReview</bpmn:outgoing>
    </bmmn:userTask>

    <bpmn:userTask id="Task_BankOfficerReview_1" name="Review Account Request">
      <bpmn:incoming>Flow_SendRequestBank_BankOfficerReview</bpmn:incoming>
      <bpmn:outgoing>Flow_DecisionPoint_Gateway_AccountDecision</bpmn:outgoing>
    </bmmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_AccountDecision_1" name="Accept Request?">
      <bpmn:incoming>Flow_DecisionPoint_Gateway_AccountDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_AcceptRequest_SendAccountDocuments</bpmn:outgoing>
      <bmmn:outgoing>Flow_RejectRequest_SendRefusalLetter</bmmn:outgoing>
    </bmmn:exclusiveGateway>

    <bpmn:userTask id="Task_SendAccountDocuments_1" name="Mail Account Documents">
      <bpmn:incoming>Flow_AcceptRequest_SendAccountDocuments</bpmn:incoming>
      <bpmn:outgoing>Flow_AccountSent_EndAccountCreated</bpmn:outgoing>
    </bmmn:userTask>

    <bpmn:userTask id="Task_SendRefusalLetter_1" name="Mail Refusal Letter">
      <bpmn:incoming>Flow_RejectRequest_SendRefusalLetter</bpmn:incoming>
      <bpmn:outgoing>Flow_RefusalSent_EndRequestRejected</bpmn:outgoing>
    </bmmn:userTask>

    <bpmn:endEvent id="EndAccountCreated_1" name="Account Created">
      <bpmn:incoming>Flow_AccountSent_EndAccountCreated</bpmn:incoming>
    </bmmn:endEvent>

    <bpmn:endEvent id="EndRequestRejected_1" name="Request Rejected">
      <bpmn:incoming>Flow_RefusalSent_EndRequestRejected</bpmn:incoming>
    </bmmn:endEvent>

    <bpmn:messageFlow id="MessageFlow_DocumentsToBank" sourceRef="Task_SendDocuments_1" targetRef="StartRequestReceived_1"/>

    <bpmn:sequenceFlow id="Flow_StartToCheckIdentity" sourceRef="StartRequestReceived_1" targetRef="Task_CheckCustomerIdentity_1"/>
    <bpmn:sequenceFlow id="Flow_SendRequestBank_BankOfficerReview" sourceRef="Task_CheckCustomerIdentity_1" targetRef="Task_BankOfficerReview_1"/>
    <bpmn:sequenceFlow id="Flow_DecisionPoint_Gateway_AccountDecision" sourceRef="Task_BankOfficerReview_1" targetRef="Gateway_AccountDecision_1"/>

    <bpmn:sequenceFlow id="Flow_AcceptRequest_SendAccountDocuments" name="Accept" sourceRef="Gateway_AccountDecision_1" targetRef="Task_SendAccountDocuments_1"/>
    <bmmn:sequenceFlow id="Flow_RejectRequest_SendRefusalLetter" name="Reject" sourceRef="Gateway_AccountDecision_1" targetRef="Task_SendRefusalLetter_1"/>

  </bpmn:process>

</bpmn:definitions>