<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_WebDesignProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_WebDesign">
    <bpmn:participant id="Participant_WebDesignTeam" name="Web Design Team Process" processRef="Process_WebDesign" />
  </bpmn:collaboration>

  <bpmn:process id="Process_WebDesign" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_DesignTeam" name="Web Design Team">
        <bpmn:flowNodeRef>StartEvent_Meeting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_InitialMeetingSuccess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateStoryboard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DesignDevelopmentStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WebsiteDesignDev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelJoin_ContentAndDev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_BuildReviewDecision</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_MarketingTeam" name="Marketing Team">
        <bpmn:flowNodeRef>Task_InitialContentDraft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ContentReviewNeeded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MarketingReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FinalContentVersion</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_WebTeam" name="Website Team">
        <bpmn:flowNodeRef>Task_BuildAndReviewSite</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Meeting" name="Informational Meeting">
      <bpmn:outgoing>SequenceFlow_01_StartToMeetingCheck</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Initial Success Check -->
    <bpmn:exclusiveGateway id="Gateway_InitialMeetingSuccess" name="Meeting Successful?">
      <bpmn:incoming>SequenceFlow_01_StartToMeetingCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_02_MeetingFailed</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_03_ProceedStoryboard</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event for Failed Meeting -->
    <bpmn:endEvent id="EndEvent_MeetingFailed" name="Process Ended">
      <bpmn:incoming>SequenceFlow_02_MeetingFailed</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Storyboard Creation Task -->
    <bpmn:userTask id="Task_CreateStoryboard" name="Create Storyboard">
      <bpmn:incoming>SequenceFlow_03_ProceedStoryboard</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_04_SplitToParallelTasks</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel Split for Design and Content -->
    <bpmn:parallelGateway id="Gateway_DesignDevelopmentStart" name="Design &amp; Content">
      <bpmn:incoming>SequenceFlow_04_SplitToParallelTasks</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_05_StartWebsiteDev</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_06_StartContentDraft</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Website Design and Development Task -->
    <bpmn:userTask id="Task_WebsiteDesignDev" name="Develop Website">
      <bpmn:incoming>SequenceFlow_05_StartWebsiteDev</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_12_DevCompleteToJoin</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Initial Content Draft Task -->
    <bpmn:userTask id="Task_InitialContentDraft" name="Prepare Initial Content Draft">
      <bpmn:incoming>SequenceFlow_06_StartContentDraft</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_07_CheckReviewNeeded</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Content Review Decision -->
    <bpmn:exclusiveGateway id="Gateway_ContentReviewNeeded" name="Content Review Needed?">
      <bpmn:incoming>SequenceFlow_07_CheckReviewNeeded</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_08_NoReviewProceed</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_09_NeedMarketingReview</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Marketing Review Task -->
    <bpmn:userTask id="Task_MarketingReview" name="Conduct Content Review">
      <bpmn:incoming>SequenceFlow_09_NeedMarketingReview</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_13_MarketingDoneToFinalContent</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Final Content Version Task -->
    <bpmn:userTask id="Task_FinalContentVersion" name="Create Final Content">
      <bpmn:incoming>SequenceFlow_08_NoReviewProceed</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_13_MarketingDoneToFinalContent</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_14_ContentCompleteToJoin</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel Join for Development and Content -->
    <bpmn:parallelGateway id="ParallelJoin_ContentAndDev" name="Both Complete">
      <bpmn:incoming>SequenceFlow_12_DevCompleteToJoin</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_14_ContentCompleteToJoin</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_15_BuildAndReviewSite</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Build and Review Site Task -->
    <bpmn:userTask id="Task_BuildAndReviewSite" name="Build &amp; Review Website">
      <bpmn:incoming>SequenceFlow_15_BuildAndReviewSite</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_16_SiteApprovalCheck</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Final Approval Decision -->
    <bpmn:exclusiveGateway id="Gateway_BuildReviewDecision" name="Site Approved?">
      <bpmn:incoming>SequenceFlow_16_SiteApprovalCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_17_ApprovedEndProcess</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_18_NotApprovedLoopBack</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event for Successful Process -->
    <bpmn:endEvent id="EndEvent_Successful" name="Process Completed">
      <bpmn:incoming>SequenceFlow_17_ApprovedEndProcess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows with correct attributes -->
    <bpmn:sequenceFlow id="SequenceFlow_02_MeetingFailed" name="No" sourceRef="Gateway_InitialMeetingSuccess" targetRef="EndEvent_MeetingFailed" />
    <bpmn:sequenceFlow id="SequenceFlow_03_ProceedStoryboard" name="Yes" sourceRef="Gateway_InitialMeetingSuccess" targetRef="Task_CreateStoryboard" />
    <bpmn:sequenceFlow id="SequenceFlow_04_SplitToParallelTasks" name="" sourceRef="Task_CreateStoryboard" targetRef="Gateway_DesignDevelopmentStart" />
    <bpmn:sequenceFlow id="SequenceFlow_05_StartWebsiteDev" name="" sourceRef="Gateway_DesignDevelopmentStart" targetRef="Task_WebsiteDesignDev" />
    <bpmn:sequenceFlow id="SequenceFlow_06_StartContentDraft" name="" sourceRef="Gateway_DesignDevelopmentStart" targetRef="Task_InitialContentDraft" />
    <bpmn:sequenceFlow id="SequenceFlow_07_CheckReviewNeeded" name="" sourceRef="Task_InitialContentDraft" targetRef="Gateway_ContentReviewNeeded" />
    <bpmn:sequenceFlow id="SequenceFlow_08_NoReviewProceed" name="No" sourceRef="Gateway_ContentReviewNeeded" targetRef="Task_FinalContentVersion" />
    <bpmn:sequenceFlow id="SequenceFlow_09_NeedMarketingReview" name="Yes" sourceRef="Gateway_ContentReviewNeeded" targetRef="Task_MarketingReview" />
    <bpmn:sequenceFlow id="SequenceFlow_12_DevCompleteToJoin" name="" sourceRef="Task_WebsiteDesignDev" targetRef="ParallelJoin_ContentAndDev" />
    <bpmn:sequenceFlow id="SequenceFlow_13_MarketingDoneToFinalContent" name="" sourceRef="Task_MarketingReview" targetRef="Task_FinalContentVersion" />
    <bpmn:sequenceFlow id="SequenceFlow_14_ContentCompleteToJoin" name="" sourceRef="Task_FinalContentVersion" targetRef="ParallelJoin_ContentAndDev" />
    <bpmn:sequenceFlow id="SequenceFlow_15_BuildAndReviewSite" name="" sourceRef="ParallelJoin_ContentAndDev" targetRef="Task_BuildAndReviewSite" />
    <bpmn:sequenceFlow id="SequenceFlow_16_SiteApprovalCheck" name="" sourceRef="Task_BuildAndReviewSite" targetRef="Gateway_BuildReviewDecision" />
    <bpmn:sequenceFlow id="SequenceFlow_17_ApprovedEndProcess" name="Yes" sourceRef="Gateway_BuildReviewDecision" targetRef="EndEvent_Successful" />
    <bpmn:sequenceFlow id="SequenceFlow_18_NotApprovedLoopBack" name="No" sourceRef="Gateway_BuildReviewDecision" targetRef="Task_BuildAndReviewSite" />

  </bpmn:process>
</bpmn:definitions>