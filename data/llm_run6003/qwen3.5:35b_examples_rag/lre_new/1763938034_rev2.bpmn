<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                 xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" 
                 xmlns:di="http://www.omg.org/spec/DD/20100524/DI" 
                 xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" 
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 id="Definitions_RewardTraining_1" targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:collaboration id="Collaboration_RewardTraining">
    <bpmn:participant id="Participant_Process" name="Reward and Training Process" processRef="Process_RewardTraining"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_RewardTraining" isExecutable="false">
    
    <!-- Lane Set for different departments -->
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Management" name="Management">
        <bpmn:flowNodeRef>Task_CheckPerformance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PerformanceCheck1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SuggestDismissal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SuggestTraining</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RewardType</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_HR" name="Human Resources">
        <bpmn:flowNodeRef>Task_DismissEmployee</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProvideTraining</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Finance" name="Finance">
        <bpmn:flowNodeRef>Task_CalculateFinancialReward</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PayFinancialReward</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Management2" name="Management (Announcement)">
        <bpmn:flowNodeRef>Task_AnnounceEmployeeOfMonth</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="Start_CheckPerformance" name="Check Employee Performance">
      <bpmn:outgoing>Flow_StartToTask</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Check Performance -->
    <bpmn:userTask id="Task_CheckPerformance" name="Review Employee Performance">
      <bpmn:incoming>Flow_StartToTask</bpmn:incoming>
      <bpmn:outgoing>Flow_TaskToGateway1</bpmn:outgoing>
    </bpmn:userTask>

    <!-- First Gateway - Check performance thresholds -->
    <bpmn:exclusiveGateway id="Gateway_PerformanceCheck1" name="Performance Level?">
      <bpmn:incoming>Flow_TaskToGateway1</bpmn:incoming>
      <bpmn:outgoing>Flow_DismissalPath</bpmn:outgoing>
      <bpmn:outgoing>Flow_TrainingPath</bpmn:outgoing>
      <bpmn:outgoing>Flow_RewardPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Dismissal Path -->
    <bpmn:userTask id="Task_SuggestDismissal" name="Suggest Employee Dismissal">
      <bpmn:incoming>Flow_DismissalPath</bpmn:incoming>
      <bpmn:outgoing>Flow_ToHRDismiss</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_DismissEmployee" name="Dismiss Employee">
      <bpmn:incoming>Flow_ToHRDismiss</bpmn:incoming>
      <bpmn:outgoing>Flow_EndDismissal</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Training Path -->
    <bpmn:userTask id="Task_SuggestTraining" name="Suggest Employee for Training">
      <bpmn:incoming>Flow_TrainingPath</bpmn:incoming>
      <bpmn:outgoing>Flow_ToHRProvide</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_ProvideTraining" name="Provide Training">
      <bpmn:incoming>Flow_ToHRProvide</bpmn:incoming>
      <bpmn:outgoing>Flow_EndTraining</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Reward Path -->
    <bpmn:userTask id="Task_SuggestReward" name="Suggest Employee for Reward">
      <bpmn:incoming>Flow_RewardPath</bpmn:incoming>
      <bpmn:outgoing>Flow_ToGateway2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Second Gateway - Choose reward type -->
    <bpmn:exclusiveGateway id="Gateway_RewardType" name="Reward Type?">
      <bpmn:incoming>Flow_ToGateway2</bpmn:incoming>
      <bpmn:outgoing>Flow_FinancialPath</bpmn:outgoing>
      <bpmn:outgoing>Flow_BenefitPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Financial Reward Path -->
    <bpmn:userTask id="Task_CalculateFinancialReward" name="Calculate Financial Reward">
      <bpmn:incoming>Flow_FinancialPath</bpmn:incoming>
      <bpmn:outgoing>Flow_ToPayFinance</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_PayFinancialReward" name="Pay Financial Reward">
      <bpmn:incoming>Flow_ToPayFinance</bpmn:incoming>
      <bpmn:outgoing>Flow_FinanceToAnnounce</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Benefit Path -->
    <bpmn:userTask id="Task_ChooseBenefit" name="Choose Appropriate Benefit">
      <bpmn:incoming>Flow_BenefitPath</bpmn:incoming>
      <bpmn:outgoing>Flow_EndBenefit</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Employee of Month Announcement -->
    <bpmn:userTask id="Task_AnnounceEmployeeOfMonth" name="Announce as Employee of the Month">
      <bpmn:incoming>Flow_FinanceToAnnounce</bpmn:incoming>
      <bpmn:outgoing>Flow_EndProcess</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Events -->
    <bpmn:endEvent id="End_Dismissal" name="Employee Dismissed">
      <bpmn:incoming>Flow_EndDismissal</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="End_Training" name="Training Completed">
      <bpmn:incoming>Flow_EndTraining</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="End_Benefit" name="Benefit Provided">
      <bpmn:incoming>Flow_EndBenefit</bpmn:incoming>
    </bpmn:endEvent>

    <!-- End Event for Process -->
    <bpmn:endEvent id="End_Process" name="Process Completed">
      <bpmn:incoming>Flow_EndProcess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Flow_StartToTask" sourceRef="Start_CheckPerformance" targetRef="Task_CheckPerformance"/>
    
    <bpmn:sequenceFlow id="Flow_TaskToGateway1" name="" sourceRef="Task_CheckPerformance" targetRef="Gateway_PerformanceCheck1"/>

    <!-- Dismissal Flow -->
    <bpmn:sequenceFlow id="Flow_DismissalPath" name="&lt; 20%" sourceRef="Gateway_PerformanceCheck1" targetRef="Task_SuggestDismissal"/>
    <bpmn:sequenceFlow id="Flow_ToHRDismiss" name="" sourceRef="Task_SuggestDismissal" targetRef="Task_DismissEmployee"/>
    <bpmn:sequenceFlow id="Flow_EndDismissal" name="" sourceRef="Task_DismissEmployee" targetRef="End_Dismissal"/>

    <!-- Training Flow -->
    <bpmn:sequenceFlow id="Flow_TrainingPath" name="20% - 50%" sourceRef="Gateway_PerformanceCheck1" targetRef="Task_SuggestTraining"/>
    <bpmn:sequenceFlow id="Flow_ToHRProvide" name="" sourceRef="Task_SuggestTraining" targetRef="Task_ProvideTraining"/>
    <bpmn:sequenceFlow id="Flow_EndTraining" name="" sourceRef="Task_ProvideTraining" targetRef="End_Training"/>

    <!-- Reward Flow -->
    <bpmn:sequenceFlow id="Flow_RewardPath" name="&gt; 75%" sourceRef="Gateway_PerformanceCheck1" targetRef="Task_SuggestReward"/>
    <bpmn:sequenceFlow id="Flow_ToGateway2" name="" sourceRef="Task_SuggestReward" targetRef="Gateway_RewardType"/>

    <!-- Financial Reward Flow -->
    <bpmn:sequenceFlow id="Flow_FinancialPath" name="Financial" sourceRef="Gateway_RewardType" targetRef="Task_CalculateFinancialReward"/>
    <bpmn:sequenceFlow id="Flow_ToPayFinance" name="" sourceRef="Task_CalculateFinancialReward" targetRef="Task_PayFinancialReward"/>

    <!-- Benefit Flow -->
    <bpmn:sequenceFlow id="Flow_BenefitPath" name="Other Benefit" sourceRef="Gateway_RewardType" targetRef="Task_ChooseBenefit"/>
    <bpmn:sequenceFlow id="Flow_EndBenefit" name="" sourceRef="Task_ChooseBenefit" targetRef="End_Benefit"/>

    <!-- Announcement Flow -->
    <bpmn:sequenceFlow id="Flow_FinanceToAnnounce" name="" sourceRef="Task_PayFinancialReward" targetRef="Task_AnnounceEmployeeOfMonth"/>
    <bpmn:sequenceFlow id="Flow_EndProcess" name="" sourceRef="Task_AnnounceEmployeeOfMonth" targetRef="End_Process"/>

  </bpmn:process>
</bpmn:definitions>