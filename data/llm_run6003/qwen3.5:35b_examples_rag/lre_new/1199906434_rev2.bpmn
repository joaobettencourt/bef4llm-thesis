<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_ErrorHandling">
    <bpmn:participant id="Participant_SupportTeam" name="Support Team Process" processRef="Process_ErrorResolution" />
  </bpmn:collaboration>

  <bpmn:process id="Process_ErrorResolution" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="StartErrorNotification" name="IS Notified about Data Validation Error">
      <bpmn:outgoing>SequenceFlow_StartToCheck</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Tech Checks Typos -->
    <bpmn:userTask id="Task_CheckTypos" name="Drop-off tech checks for typos">
      <bpmn:incoming>SequenceFlow_StartToCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TyposDecision</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway 1: Decision Point -->
    <bpmn:exclusiveGateway id="Gateway_ResolutionPath" name="Check Resolution Path">
      <bpmn:incoming>SequenceFlow_TyposDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CustomerCorrection</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PublicSources</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 2: Check Customer Correction -->
    <bpmn:userTask id="Task_CheckCustomerCorrection" name="Check if customer can correct mistake">
      <bpmn:incoming>SequenceFlow_CustomerCorrection</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CorrectionResolved</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task 3: Scour Public Sources -->
    <bpmn:userTask id="Task_ScourSources" name="Scour public sources for solutions">
      <bpmn:incoming>SequenceFlow_PublicSources</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SourceResolved</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndIssueResolved" name="Issue Resolved">
      <bpmn:incoming>SequenceFlow_CorrectionResolved</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_SourceResolved</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToCheck" sourceRef="StartErrorNotification" targetRef="Task_CheckTypos" />
    
    <bpmn:sequenceFlow id="SequenceFlow_TyposDecision" name="" sourceRef="Task_CheckTypos" targetRef="Gateway_ResolutionPath" />

    <!-- Path 1 -->
    <bpmn:sequenceFlow id="SequenceFlow_CustomerCorrection" name="If customer correction possible" sourceRef="Gateway_ResolutionPath" targetRef="Task_CheckCustomerCorrection" />
    
    <!-- Path 2 -->
    <bpmn:sequenceFlow id="SequenceFlow_PublicSources" name="Otherwise (Scour sources)" sourceRef="Gateway_ResolutionPath" targetRef="Task_ScourSources" />

    <!-- Merging to End Event -->
    <bpmn:sequenceFlow id="SequenceFlow_CorrectionResolved" sourceRef="Task_CheckCustomerCorrection" targetRef="EndIssueResolved" name="" />
    
    <bpmn:sequenceFlow id="SequenceFlow_SourceResolved" sourceRef="Task_ScourSources" targetRef="EndIssueResolved" name="" />

  </bpmn:process>
</bpmn:definitions>