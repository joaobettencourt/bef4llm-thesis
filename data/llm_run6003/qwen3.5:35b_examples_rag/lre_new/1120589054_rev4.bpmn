<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_OrderToCash">
    <bpmn:participant id="Participant_OrderToCash" name="Order to Cash Process" processRef="Process_OrderToCash"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_OrderToCash" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_CustomerService" name="Customer Service">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProcessOrder</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Warehouse" name="Warehouse">
        <bpmn:flowNodeRef>Gateway_CheckPartsAvailability</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DetermineRequiredParts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OrderMissingParts</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Production" name="Production">
        <bpmn:flowNodeRef>Gateway_StartProduction</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_StartProduction</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_QualityControl" name="Quality Control">
        <bpmn:flowNodeRef>Gateway_CheckQualityResults</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PerformQualityChecks</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Sales" name="Sales">
        <bpmn:flowNodeRef>Gateway_PackagingDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PackageAndLabelProducts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformSalesAboutCompletion</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_EndEvents" name="End Events">
        <bpmn:flowNodeRef>EndEvent_OrderCompleted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ProductSold</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Order Received">
      <bpmn:outgoing>SequenceFlow_StartToProcess</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Process Order Task -->
    <bpmn:userTask id="Task_ProcessOrder" name="Process Customer Order">
      <bpmn:incoming>SequenceFlow_StartToProcess</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OrderToWarehouse</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Determine Required Parts -->
    <bpmn:userTask id="Task_DetermineRequiredParts" name="Determine Parts Required">
      <bpmn:incoming>SequenceFlow_OrderToWarehouse</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToCheckAvailability</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Check Parts Availability Gateway -->
    <bpmn:exclusiveGateway id="Gateway_CheckPartsAvailability" name="All Parts Available?">
      <bpmn:incoming>SequenceFlow_ToCheckAvailability</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PartsAvailableYes</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PartsNotAvailableNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Order Missing Parts -->
    <bpmn:userTask id="Task_OrderMissingParts" name="Order Missing Parts">
      <bpmn:incoming>SequenceFlow_PartsNotAvailableNo</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BackToCheckAvailability</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Start Production Gateway -->
    <bpmn:exclusiveGateway id="Gateway_StartProduction" name="">
      <bpmn:incoming>SequenceFlow_PartsAvailableYes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToQualityChecks</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Start Production Task -->
    <bpmn:userTask id="Task_StartProduction" name="Start Production">
      <bpmn:incoming>SequenceFlow_PartsAvailableYes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToQualityChecks2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Quality Checks -->
    <bpmn:userTask id="Task_PerformQualityChecks" name="Perform Quality Checks">
      <bpmn:incoming>SequenceFlow_ToQualityChecks2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_QualityResults</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Check Quality Results -->
    <bpmn:exclusiveGateway id="Gateway_CheckQualityResults" name="Quality Passed?">
      <bpmn:incoming>SequenceFlow_QualityResults</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_QualityPassedYes</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_QualityFailedNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Package and Label -->
    <bpmn:userTask id="Task_PackageAndLabelProducts" name="Package and Label Products">
      <bpmn:incoming>SequenceFlow_QualityPassedYes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToSalesInformed</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Inform Sales -->
    <bpmn:userTask id="Task_InformSalesAboutCompletion" name="Inform Sales About Completion">
      <bpmn:incoming>SequenceFlow_ToSalesInformed</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProductReadyForSale</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_OrderCompleted" name="Order Completed">
      <bpmn:incoming>SequenceFlow_QualityFailedNo</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_ProductSold" name="Product Sold to Customer">
      <bpmn:incoming>SequenceFlow_ProductReadyForSale</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToProcess" sourceRef="StartEvent_1" targetRef="Task_ProcessOrder"/>
    <bpmn:sequenceFlow id="SequenceFlow_OrderToWarehouse" name="" sourceRef="Task_ProcessOrder" targetRef="Gateway_CheckPartsAvailability"/>

    <!-- Parts Availability Decision -->
    <bpmn:sequenceFlow id="SequenceFlow_ToCheckAvailability" sourceRef="Gateway_CheckPartsAvailability" targetRef="Task_DetermineRequiredParts"/>
    <bpmn:sequenceFlow id="SequenceFlow_PartsAvailableYes" name="Yes - All Available" sourceRef="Gateway_CheckPartsAvailability" targetRef="Gateway_StartProduction"/>
    <bpmn:sequenceFlow id="SequenceFlow_PartsNotAvailableNo" name="No - Order Parts" sourceRef="Gateway_CheckPartsAvailability" targetRef="Task_OrderMissingParts"/>

    <!-- Loop Back -->
    <bpmn:sequenceFlow id="SequenceFlow_BackToCheckAvailability" sourceRef="Task_OrderMissingParts" targetRef="Gateway_CheckPartsAvailability"/>

    <!-- Quality Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_ToQualityChecks2" name="" sourceRef="Gateway_StartProduction" targetRef="Task_PerformQualityChecks"/>
    <bpmn:sequenceFlow id="SequenceFlow_QualityResults" name="" sourceRef="Task_PerformQualityChecks" targetRef="Gateway_CheckQualityResults"/>

    <!-- Quality Decision -->
    <bpmn:sequenceFlow id="SequenceFlow_QualityPassedYes" name="Yes - Passed" sourceRef="Gateway_CheckQualityResults" targetRef="Task_PackageAndLabelProducts"/>
    <bpmn:sequenceFlow id="SequenceFlow_QualityFailedNo" name="No - Failed" sourceRef="Gateway_CheckQualityResults" targetRef="EndEvent_OrderCompleted"/>

    <!-- Sales Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_ToSalesInformed" sourceRef="Task_PackageAndLabelProducts" targetRef="Task_InformSalesAboutCompletion"/>
    <bpmn:sequenceFlow id="SequenceFlow_ProductReadyForSale" name="" sourceRef="Task_InformSalesAboutCompletion" targetRef="EndEvent_ProductSold"/>

  </bpmn:process>
</bpmn:definitions>