<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_NewClientsProcess">
    <bpmn:participant id="Participant_NewClientsProcess" name="New Client Acquisition Process" processRef="Process_NewClientAcquisition" />
  </bpmn:collaboration>

  <bpmn:process id="Process_NewClientAcquisition" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Management" name="Management">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformResponses</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ClientAcceptsOffer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareContract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SignContract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AnalyzeFailureReason</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Marketing" name="Marketing Team">
        <bpmn:flowNodeRef>Task_PerformMarketAnalysis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PreparePortfolioPresentation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendOffersToClients</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="New Clients Needed">
      <bpmn:outgoing>SequenceFlow_StartToMarketAnalysis</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Marketing Tasks -->
    <bpmn:userTask id="Task_PerformMarketAnalysis" name="Perform Market Analysis">
      <bpmn:incoming>SequenceFlow_StartToMarketAnalysis</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AnalysisToPresentation</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_PreparePortfolioPresentation" name="Prepare Portfolio Presentation">
      <bpmn:incoming>SequenceFlow_AnalysisToPresentation</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PresentationToOffers</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_SendOffersToClients" name="Send Offers to Potential Clients">
      <bpmn:incoming>SequenceFlow_PresentationToOffers</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OffersSentToInformManagement</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Management Tasks -->
    <bpmn:userTask id="Task_InformResponses" name="Inform Management About Responses">
      <bpmn:incoming>SequenceFlow_OffersSentToInformManagement</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ResponsesToGateway</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Decision Gateway -->
    <bpmn:exclusiveGateway id="Gateway_ClientAcceptsOffer" name="Client Accepts Offer?">
      <bpmn:incoming>SequenceFlow_ResponsesToGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OfferAccepted</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_OfferRejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Contract Preparation Path -->
    <bpmn:userTask id="Task_PrepareContract" name="Prepare Contract">
      <bpmn:incoming>SequenceFlow_OfferAccepted</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ContractPreparedToSign</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event for Successful Contract -->
    <bpmn:endEvent id="EndEvent_Successful" name="Contract Signed">
      <bpmn:incoming>SequenceFlow_SigningComplete</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Failure Analysis Path -->
    <bpmn:userTask id="Task_AnalyzeFailureReason" name="Analyze Reason for Offer Failure">
      <bpmn:incoming>SequenceFlow_OfferRejected</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AnalysisCompleteToEnd</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event for Failed Offer -->
    <bpmn:endEvent id="EndEvent_Failed" name="Process Complete">
      <bpmn:incoming>SequenceFlow_AnalysisCompleteToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToMarketAnalysis" sourceRef="StartEvent_1" targetRef="Task_PerformMarketAnalysis" />
    
    <bpmn:sequenceFlow id="SequenceFlow_AnalysisToPresentation" name="" sourceRef="Task_PerformMarketAnalysis" targetRef="Task_PreparePortfolioPresentation" />
    
    <bpmn:sequenceFlow id="SequenceFlow_PresentationToOffers" name="" sourceRef="Task_PreparePortfolioPresentation" targetRef="Task_SendOffersToClients" />
    
    <bpmn:sequenceFlow id="SequenceFlow_OffersSentToInformManagement" name="" sourceRef="Task_SendOffersToClients" targetRef="Task_InformResponses" />
    
    <bpmn:sequenceFlow id="SequenceFlow_ResponsesToGateway" name="" sourceRef="Task_InformResponses" targetRef="Gateway_ClientAcceptsOffer" />
    
    <bpmn:sequenceFlow id="SequenceFlow_OfferAccepted" name="Yes" sourceRef="Gateway_ClientAcceptsOffer" targetRef="Task_PrepareContract" />
    
    <bpmn:userTask id="Task_SignContract" name="Sign Contract">
      <bpmn:incoming>SequenceFlow_ContractPreparedToSign</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SigningComplete</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:sequenceFlow id="SequenceFlow_ContractPreparedToSign" name="" sourceRef="Task_PrepareContract" targetRef="Task_SignContract" />
    
    <bpmn:sequenceFlow id="SequenceFlow_SigningComplete" name="" sourceRef="Task_SignContract" targetRef="EndEvent_Successful" />
    
    <bpmn:sequenceFlow id="SequenceFlow_OfferRejected" name="No" sourceRef="Gateway_ClientAcceptsOffer" targetRef="Task_AnalyzeFailureReason" />
    
    <bpmn:sequenceFlow id="SequenceFlow_AnalysisCompleteToEnd" name="" sourceRef="Task_AnalyzeFailureReason" targetRef="EndEvent_Failed" />

  </bpmn:process>
</bpmn:definitions>