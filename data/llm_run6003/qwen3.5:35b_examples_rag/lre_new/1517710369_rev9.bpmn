<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_CreditCardAddition" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Process" name="Credit Card Addition Process" processRef="Process_AddCC"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_AddCC" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="Start_1" name="Choose Credit Card Payment">
      <bpmn:outgoing>Flow_StartToDetails</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- User Task - Enter credit card details -->
    <bpmn:userTask id="Task_EnterCCDetails" name="Enter Credit Card Details">
      <bpmn:incoming>Flow_StartToDetails</bpmn:incoming>
      <bpmn:outgoing>Flow_DetailsToAddressCheck</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Exclusive Gateway - Billing Address Check -->
    <bpmn:exclusiveGateway id="Gateway_AddressValid" name="Billing address correct?">
      <bpmn:incoming>Flow_DetailsToAddressCheck</bpmn:incoming>
      <bpmn:outgoing>Flow_ContinueIfCorrect</bpmn:outgoing>
      <bpmn:outgoing>Flow_ModifyIfIncorrect</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- User Task - Modify address (loop back) -->
    <bpmn:userTask id="Task_ModifyAddress" name="Modify Billing Address">
      <bpmn:incoming>Flow_ModifyIfIncorrect</bpmn:incoming>
      <bpmn:outgoing>Flow_RepeatCheck</bpmn:outgoing>
    </bpmn:userTask>

    <!-- User Action/Event - Click Continue button -->
    <bpmn:userTask id="UserAction_Continue" name="Click Continue Button">
      <bpmn:incoming>Flow_ContinueIfCorrect</bpmn:incoming>
      <bpmn:outgoing>Flow_ToVerification</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Service Task - Credit Card Verification -->
    <bpmn:serviceTask id="Service_CCVerify" name="Verify with Credit Card Authority">
      <bpmn:incoming>Flow_ToVerification</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckResult</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Exclusive Gateway - Check Verification Result -->
    <bpmn:exclusiveGateway id="Gateway_VerificationResult" name="Verification result?">
      <bpmn:incoming>Flow_CheckResult</bpmn:incoming>
      <bpmn:outgoing>Flow_AddCCValidated</bpmn:outgoing>
      <bpmn:outgoing>Flow_CancelAddition</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event - Credit Card Added -->
    <bpmn:endEvent id="End_Added" name="Credit card added">
      <bpmn:incoming>Flow_AddCCValidated</bpmn:incoming>
    </bpmn:endEvent>

    <!-- End Event - Addition Cancelled -->
    <bpmn:endEvent id="End_Cancelled" name="Addition cancelled">
      <bpmn:incoming>Flow_CancelAddition</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Flow_StartToDetails" sourceRef="Start_1" targetRef="Task_EnterCCDetails"/>
    
    <bpmn:sequenceFlow id="Flow_DetailsToAddressCheck" name="" sourceRef="Task_EnterCCDetails" targetRef="Gateway_AddressValid"/>

    <!-- Sequence Flow - Continue if correct -->
    <bpmn:sequenceFlow id="Flow_ContinueIfCorrect" name="Yes" sourceRef="Gateway_AddressValid" targetRef="UserAction_Continue">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[address == 'correct']]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Sequence Flow - Modify if incorrect -->
    <bpmn:sequenceFlow id="Flow_ModifyIfIncorrect" name="No" sourceRef="Gateway_AddressValid" targetRef="Task_ModifyAddress">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[address == 'incorrect']]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Sequence Flow - Loop back to check -->
    <bpmn:sequenceFlow id="Flow_RepeatCheck" sourceRef="Task_ModifyAddress" targetRef="Gateway_AddressValid"/>

    <!-- Sequence Flow to verification service -->
    <bpmn:sequenceFlow id="Flow_ToVerification" sourceRef="UserAction_Continue" targetRef="Service_CCVerify"/>

    <!-- Sequence Flow from verification result check -->
    <bpmn:sequenceFlow id="Flow_CheckResult" name="" sourceRef="Service_CCVerify" targetRef="Gateway_VerificationResult"/>

    <!-- Sequence Flow - Add if validated -->
    <bpmn:sequenceFlow id="Flow_AddCCValidated" name="Yes/Validated" sourceRef="Gateway_VerificationResult" targetRef="End_Added">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[result == 'validated']]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Sequence Flow - Cancel if not validated -->
    <bpmn:sequenceFlow id="Flow_CancelAddition" name="No/Not Validated" sourceRef="Gateway_VerificationResult" targetRef="End_Cancelled">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[result == 'not validated']]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>