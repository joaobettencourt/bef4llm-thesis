<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" 
                xmlns:di="http://www.omg.org/spec/DD/20100524/DI" 
                xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" 
                xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:collaboration id="Collaboration_InvoiceProcessing">
    <bpmn:participant id="Participant_SSP" name="SSP Organization" processRef="Process_InvoiceProcessing"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_InvoiceProcessing" isExecutable="false">
    
    <!-- Lane Set for all departments -->
    <bpmn:laneSet>
      <bpmn:lane id="Lane_MailCentre" name="Mail Centre Office">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CategorizeInvoice</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Administration" name="Administration Department">
        <bpmn:flowNodeRef>Task_ProcessInvoiceComplex</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PutInCollectionBox</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_DataEntry" name="Data Entry Office">
        <bpmn:flowNodeRef>IntermediateTimerDaily10am</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterSAPSystemComplex</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Validation" name="Validation Office">
        <bpmn:flowNodeRef>IntermediateTimerHourlyReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ForwardForValidation</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Payment" name="Payment Office">
        <bpmn:flowNodeRef>IntermediateTimerWeeklyBeginning</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExecutePaymentBigProcess</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Registry" name="Registry Office">
        <bpmn:flowNodeRef>Task_ArchiveInvoices</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Completed</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event - Invoice received from client -->
    <bpmn:startEvent id="StartEvent_1" name="Invoice Received">
      <bpmn:outgoing>SequenceFlow_StartToCategorize</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Categorize invoice by staff member -->
    <bpmn:userTask id="Task_CategorizeInvoice" name="Categorize Invoice">
      <bpmn:incoming>SequenceFlow_StartToCategorize</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CategorizeForwardAdmin</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Process Invoice (complex) -->
    <bpmn:task id="Task_ProcessInvoiceComplex" name="Process Invoice">
      <bpmn:incoming>SequenceFlow_CategorizeForwardAdmin</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProcesstoCollectionBox</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Put invoices in collection box -->
    <bpmn:userTask id="Task_PutInCollectionBox" name="Put Invoices in Collection Box">
      <bpmn:incoming>SequenceFlow_ProcesstoCollectionBox</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CollectionToDataEntry</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Intermediate Timer Event - 10am every workday -->
    <bpmn:intermediateCatchEvent id="IntermediateTimerDaily10am" name="At 10 am Every Workday">
      <bpmn:timerEventDefinition/>
      <bpmn:incoming>SequenceFlow_CollectionToDataEntry</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_10amEnterSAP</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task: Enter data in SAP system (complex) -->
    <bpmn:task id="Task_EnterSAPSystemComplex" name="Enter Data In SAP System">
      <bpmn:incoming>SequenceFlow_10amEnterSAP</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SAPToreviewMailCentre</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Timer Event - Every hour review -->
    <bpmn:intermediateCatchEvent id="IntermediateTimerHourlyReview" name="Every Hour Review">
      <bpmn:timerEventDefinition/>
      <bpmn:incoming>SequenceFlow_SAPToreviewMailCentre</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_HourlyForwardValidation</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task: Forward new invoices for validation -->
    <bpmn:userTask id="Task_ForwardForValidation" name="Forward New Invoices For Validation">
      <bpmn:incoming>SequenceFlow_HourlyForwardValidation</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ValidationToValidateInvoice</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Validate Invoice (big process) -->
    <bpmn:task id="Task_ValidateInvoiceBigProcess" name="Validate Invoices">
      <bpmn:incoming>SequenceFlow_ValidationToValidateInvoice</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ValidatedToPaymentOffice</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Timer Event - Beginning of every week -->
    <bpmn:intermediateCatchEvent id="IntermediateTimerWeeklyBeginning" name="At Start Of Every Week">
      <bpmn:timerEventDefinition/>
      <bpmn:incoming>SequenceFlow_ValidatedToPaymentOffice</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WeekExecutePayment</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task: Execute Payment (big process) -->
    <bpmn:task id="Task_ExecutePaymentBigProcess" name="Execute Payment">
      <bpmn:incoming>SequenceFlow_WeekExecutePayment</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PaymentToArchive</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Archive Invoices -->
    <bpmn:userTask id="Task_ArchiveInvoices" name="Archive All Invoices">
      <bpmn:incoming>SequenceFlow_PaymentToArchive</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ArchivetoEndEvent</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Completed" name="Process Completed">
      <bpmn:incoming>SequenceFlow_ArchivetoEndEvent</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToCategorize" sourceRef="StartEvent_1" targetRef="Task_CategorizeInvoice"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_CategorizeForwardAdmin" name="" sourceRef="Task_CategorizeInvoice" targetRef="Task_ProcessInvoiceComplex"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ProcesstoCollectionBox" name="" sourceRef="Task_ProcessInvoiceComplex" targetRef="Task_PutInCollectionBox"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_CollectionToDataEntry" name="" sourceRef="Task_PutInCollectionBox" targetRef="IntermediateTimerDaily10am"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_10amEnterSAP" name="" sourceRef="IntermediateTimerDaily10am" targetRef="Task_EnterSAPSystemComplex"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_SAPToreviewMailCentre" name="" sourceRef="Task_EnterSAPSystemComplex" targetRef="IntermediateTimerHourlyReview"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_HourlyForwardValidation" name="" sourceRef="IntermediateTimerHourlyReview" targetRef="Task_ForwardForValidation"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ValidationToValidateInvoice" name="" sourceRef="Task_ForwardForValidation" targetRef="Task_ValidateInvoiceBigProcess"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ValidatedToPaymentOffice" name="" sourceRef="Task_ValidateInvoiceBigProcess" targetRef="IntermediateTimerWeeklyBeginning"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_WeekExecutePayment" name="" sourceRef="IntermediateTimerWeeklyBeginning" targetRef="Task_ExecutePaymentBigProcess"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_PaymentToArchive" name="" sourceRef="Task_ExecutePaymentBigProcess" targetRef="Task_ArchiveInvoices"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ArchivetoEndEvent" name="" sourceRef="Task_ArchiveInvoices" targetRef="EndEvent_Completed"/>

  </bpmn:process>
</bpmn:definitions>