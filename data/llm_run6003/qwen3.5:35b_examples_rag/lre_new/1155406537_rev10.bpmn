<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_AccountCreation">
    <bpmn:participant id="Participant_PayPalClient" name="PayPal Client&#10;" processRef="Process_AccountCreation"/>
    <bpmn:participant id="Participant_PayPalSystem" name="PayPal System&#10;"/>
  </bpmn:collaboration>

  <bpmn:message id="Message_AccountCreationRequest" name="Account Creation Request"/>

  <bpmn:process id="Process_AccountCreation" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Client" name="Client">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DetermineAccountType</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_AccountSelection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterLoginDetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterPersonalDetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DeclarePEPStatus</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ClickCreateAccount</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_System" name="PayPal System">
        <bpmn:flowNodeRef>IntermediateCatchEvent_RequestReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ValidateInputFields</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_ValidOrInvalid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateThrowEvent_ClientNotification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GenerateWelcomeEmail</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Create PayPal Account">
      <bpmn:outgoing>SequenceFlow_StartToAccountType</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Determine Account Type Task -->
    <bpmn:userTask id="Task_DetermineAccountType" name="Determine Desired Account Type">
      <bpmn:incoming>SequenceFlow_StartToAccountType</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AccountTypeToGateway</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Inclusive Gateway for Account Selection -->
    <bpmn:inclusiveGateway id="InclusiveGateway_AccountSelection" name="Account Type">
      <bpmn:incoming>SequenceFlow_AccountTypeToGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PersonalPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PremiumPath</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Personal Account Path -->
    <bpmn:userTask id="Task_EnterLoginDetails" name="Enter Login Details&#10;(Email, Password)">
      <bpmn:incoming>SequenceFlow_PersonalPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_LoginToSubmit</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Premium Account Path -->
    <bpmn:userTask id="Task_EnterPersonalDetails" name="Enter Personal Details&#10;(Name, DOB)">
      <bpmn:incoming>SequenceFlow_PremiumPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DetailsToSubmit</bpmn:outgoing>
    </bpmn:userTask>

    <!-- PEP Declaration Task -->
    <bpmn:userTask id="Task_DeclarePEPStatus" name="Declare Political&#10;Exposure Status">
      <bpmn:incoming>SequenceFlow_PersonalPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PEPTosubmit</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Submit Account Creation -->
    <bpmn:userTask id="Task_ClickCreateAccount" name="Click Create&#10;Account Button">
      <bpmn:incoming>SequenceFlow_LoginToSubmit</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SubmitToSystem</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Intermediate Throw Event - Submit Details -->
    <bpmn:intermediateThrowEvent id="IntermediateThrowEvent_ClientNotification" name="Submit Account&#10;Details">
      <bpmn:incoming>SequenceFlow_SubmitToSystem</bpmn:incoming>
      <bpmn:messageEventDefinition ref="Message_AccountCreationRequest"/>
    </bpmn:intermediateThrowEvent>

    <!-- Intermediate Catch Event - Receive Request -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_RequestReceived" name="Receive Account&#10;Creation Request">
      <bpmn:messageEventDefinition ref="Message_AccountCreationRequest"/>
      <bpmn:outgoing>SequenceFlow_ValidateInput</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Validate Input Fields -->
    <bpmn:userTask id="Task_ValidateInputFields" name="Validate Input&#10;Fields">
      <bpmn:incoming>SequenceFlow_ValidateInput</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ValidOrInvalidGateway</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Validation Gateway -->
    <bpmn:exclusiveGateway id="InclusiveGateway_ValidOrInvalid" name="Valid Fields?">
      <bpmn:incoming>SequenceFlow_ValidOrInvalidGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ValidationLoopBack</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ValidPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Client Notification Task -->
    <bpmn:userTask id="Task_ClientNotification" name="Notify Client&#10;of Invalid Fields">
      <bpmn:incoming>SequenceFlow_ValidationLoopBack</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NotifyToCorrect</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Welcome Email Task -->
    <bpmn:userTask id="Task_GenerateWelcomeEmail" name="Generate and&#10;Send Welcome Email">
      <bpmn:incoming>SequenceFlow_ValidPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EmailToComplete</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_AccountCreated" name="Account Created">
      <bpmn:incoming>SequenceFlow_EmailToComplete</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_CorrectionNeeded" name="Correction&#10;Required">
      <bpmn:incoming>SequenceFlow_NotifyToCorrect</bpmn:outgoing>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToAccountType" sourceRef="StartEvent_1" targetRef="Task_DetermineAccountType"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_AccountTypeToGateway" name="" sourceRef="Task_DetermineAccountType" targetRef="InclusiveGateway_AccountSelection"/>

    <!-- Account Type Paths -->
    <bpmn:sequenceFlow id="SequenceFlow_PersonalPath" name="Personal&#10;Account" sourceRef="InclusiveGateway_AccountSelection" targetRef="Task_EnterLoginDetails"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_PremiumPath" name="Premium&#10;Account" sourceRef="InclusiveGateway_AccountSelection" targetRef="Task_DeclarePEPStatus"/>

    <!-- Details Entry Paths -->
    <bpmn:sequenceFlow id="SequenceFlow_LoginToSubmit" sourceRef="Task_EnterLoginDetails" targetRef="IntermediateThrowEvent_ClientNotification"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_DetailsToPhone" name="" sourceRef="Task_DeclarePEPStatus" targetRef="InclusiveGateway_AccountSelection"/>

    <!-- Submit Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_SubmitToSystem" sourceRef="IntermediateThrowEvent_ClientNotification" targetRef="IntermediateCatchEvent_RequestReceived">
      <bpmn:messageEventDefinition ref="Message_AccountCreationRequest"/>
    </bpmn:sequenceFlow>

    <!-- Validation Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_ValidateInput" sourceRef="IntermediateCatchEvent_RequestReceived" targetRef="Task_ValidateInputFields"/>

    <bpmn:sequenceFlow id="SequenceFlow_ValidOrInvalidGateway" name="" sourceRef="Task_ValidateInputFields" targetRef="InclusiveGateway_ValidOrInvalid"/>

    <!-- Loop Back Flow for Invalid Fields -->
    <bpmn:sequenceFlow id="SequenceFlow_ValidationLoopBack" name="Invalid&#10;Fields" sourceRef="InclusiveGateway_ValidOrInvalid" targetRef="Task_ClientNotification"/>

    <!-- Valid Fields Flow to Email Generation -->
    <bpmn:sequenceFlow id="SequenceFlow_ValidPath" name="Valid&#10;Fields" sourceRef="InclusiveGateway_ValidOrInvalid" targetRef="Task_GenerateWelcomeEmail"/>

    <!-- Complete Path -->
    <bpmn:sequenceFlow id="SequenceFlow_EmailToComplete" sourceRef="Task_GenerateWelcomeEmail" targetRef="EndEvent_AccountCreated"/>

  </bpmn:process>
</bpmn:definitions>