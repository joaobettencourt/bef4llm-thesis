<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_ProcessDesign">
    <bpmn:participant id="Participant_DesignProcess" name="Web Design &amp; Implementation Process" processRef="Process_DesignImplementation" />
  </bpmn:collaboration>

  <bpmn:process id="Process_DesignImplementation" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_BusinessAnalyst" name="Business Analyst">
        <bpmn:flowNodeRef>Task_CollectData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CheckDesignOK</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_WebDesigner" name="Web Designer">
        <bpmn:flowNodeRef>Task_IntegrateDesign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ChangeIntegrateDesign</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_PHPHTMLCSS" name="PHP/HTML/CSS Specialist">
        <bpmn:flowNodeRef>Task_IntegrateImplementation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AdjustIntegrateAgain</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Tester" name="Tester">
        <bpmn:flowNodeRef>Gateway_TestOK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TestWebsite</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_Process">
      <bpmn:outgoing>SequenceFlow_SplitProcess</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:parallelGateway id="ParallelGateway_StartSplit" name="Concurrent Start">
      <bpmn:incoming>SequenceFlow_SplitProcess</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AnalystPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_DesignerPath</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:userTask id="Task_CollectData" name="Collect Data &amp; Conduct Analysis">
      <bpmn:incoming>SequenceFlow_AnalystPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AnalystToJoin</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_IntegrateDesign" name="Integrate Design &amp; Decide Placement">
      <bpmn:incoming>SequenceFlow_DesignerPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DesignToJoin</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:parallelGateway id="ParallelGateway_JoinDesign" name="Wait for Design">
      <bpmn:incoming>SequenceFlow_AnalystToJoin</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_DesignToJoin</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckDesignStart</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:userTask id="Task_AnalystCheck" name="Check Design &amp; Provide Feedback">
      <bpmn:incoming>SequenceFlow_CheckDesignStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DesignDecision</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_CheckDesignOK" name="Adjustment Needed?">
      <bpmn:incoming>SequenceFlow_DesignDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_YesAdjust</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoOKProceed</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_ChangeIntegrateDesign" name="Change Design &amp; Integrate Again">
      <bpmn:incoming>SequenceFlow_YesAdjust</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DesignLoopBack</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:sequenceFlow id="SequenceFlow_SplitProcess" sourceRef="StartEvent_Process" targetRef="ParallelGateway_StartSplit" />
    <bpmn:sequenceFlow id="SequenceFlow_AnalystPath" name="" sourceRef="ParallelGateway_StartSplit" targetRef="Task_CollectData" />
    <bpmn:sequenceFlow id="SequenceFlow_DesignerPath" name="" sourceRef="ParallelGateway_StartSplit" targetRef="Task_IntegrateDesign" />

    <bpmn:sequenceFlow id="SequenceFlow_AnalystToJoin" sourceRef="Task_CollectData" targetRef="ParallelGateway_JoinDesign" />
    <bpmn:sequenceFlow id="SequenceFlow_DesignToJoin" name="" sourceRef="Task_IntegrateDesign" targetRef="ParallelGateway_JoinDesign" />

    <bpmn:sequenceFlow id="SequenceFlow_CheckDesignStart" sourceRef="ParallelGateway_JoinDesign" targetRef="Task_AnalystCheck" />
    <bpmn:sequenceFlow id="SequenceFlow_DesignDecision" name="" sourceRef="Task_AnalystCheck" targetRef="Gateway_CheckDesignOK" />

    <bpmn:sequenceFlow id="SequenceFlow_YesAdjust" name="yes" sourceRef="Gateway_CheckDesignOK" targetRef="Task_ChangeIntegrateDesign" />
    <bpmn:sequenceFlow id="SequenceFlow_DesignLoopBack" sourceRef="Task_ChangeIntegrateDesign" targetRef="ParallelGateway_JoinDesign" />

    <bpmn:exclusiveGateway id="Gateway_ProceedToImplementation">
      <bpmn:incoming>SequenceFlow_NoOKProceed</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SpecialistStart</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_IntegrateImplementation" name="Integrate with Overall Implementation">
      <bpmn:incoming>SequenceFlow_SpecialistStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToTest</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_TestWebsite" name="Test Final Website">
      <bpmn:incoming>SequenceFlow_ToTest</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TestDecision</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="End_Successful" name="Process Ends">
      <bpmn:incoming>SequenceFlow_ProcessComplete</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:userTask id="Task_AdjustIntegrateAgain" name="Adjust &amp; Integrate Again">
      <bpmn:incoming>SequenceFlow_FailTestLoop</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReTestStart</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_TestOK" name="Test OK?">
      <bpmn:incoming>SequenceFlow_TestDecision</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ReTestStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProcessComplete</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_FailTestLoop</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="SequenceFlow_NoOKProceed" name="no adjustment needed" sourceRef="Gateway_CheckDesignOK" targetRef="Gateway_ProceedToImplementation" />
    <bpmn:sequenceFlow id="SequenceFlow_SpecialistStart" sourceRef="Gateway_ProceedToImplementation" targetRef="Task_IntegrateImplementation" />

    <bpmn:sequenceFlow id="SequenceFlow_ToTest" name="" sourceRef="Task_IntegrateImplementation" targetRef="Task_TestWebsite" />
    <bpmn:sequenceFlow id="SequenceFlow_TestDecision" sourceRef="Task_TestWebsite" targetRef="Gateway_TestOK" />

    <bpmn:sequenceFlow id="SequenceFlow_ProcessComplete" name="yes" sourceRef="Gateway_TestOK" targetRef="End_Successful" />
    <bpmn:sequenceFlow id="SequenceFlow_FailTestLoop" name="no" sourceRef="Gateway_TestOK" targetRef="Task_AdjustIntegrateAgain" />

  </bpmn:process>
</bpmn:definitions>