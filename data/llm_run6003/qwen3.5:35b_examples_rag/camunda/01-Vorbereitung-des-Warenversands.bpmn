<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ShipGoods" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_ShipmentProcess">
    <bpmn:participant id="Participant_ComputerHardwareShop" name="Dispatch of goods - Computer Hardware Shop" processRef="Process_ShipGoods" />
  </bpmn:collaboration>

  <bpmn:process id="Process_ShipGoods" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Shipment">
      <bpmn:lane id="Lane_Secretary" name="Secretary">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckShippingMethod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_QualityCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_SpecialShipmentMerge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Logistics" name="Logistics Manager">
        <bpmn:flowNodeRef>Task_CheckInsurance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_InsuranceCheck</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Warehouse" name="Warehouse Worker">
        <bpmn:flowNodeRef>ParallelGateway_StartPacking</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PackGoods</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Ship goods">
      <bpmn:outgoing>SequenceFlow_CheckShipping</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Secretary Tasks -->
    <bpmn:task id="Task_CheckShippingMethod" name="Clarify shipment method">
      <bpmn:incoming>SequenceFlow_CheckShipping</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_QualityCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for quantity check -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_QualityCheck" name="Large quantities?">
      <bpmn:incoming>SequenceFlow_QualityCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SpecialShipmentPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NormalDeliveryPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Special Shipment Path (Large Quantities) -->
    <bpmn:task id="Task_GetOffers" name="Get 3 offers from logistic companies">
      <bpmn:incoming>SequenceFlow_SpecialShipmentPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SelectOffer</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_SelectOffer" name="Select logistic company and place order">
      <bpmn:incoming>SequenceFlow_SelectOffer</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SpecialShipmentComplete</bpmn:outgoing>
    </bpmn:task>

    <!-- Normal Delivery Path (Small Quantities) -->
    <bpmn:task id="Task_FillPackageForm" name="Write package label">
      <bpmn:incoming>SequenceFlow_NormalDeliveryPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PackageLabelComplete</bpmn:outgoing>
    </bpmn:task>

    <!-- Insurance Check (Logistics Manager) -->
    <bpmn:exclusiveGateway id="InclusiveGateway_InsuranceCheck" name="Insurance necessary?">
      <bpmn:incoming>SequenceFlow_PackageLabelComplete</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ArrangeInsurance</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SkipInsurance</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_CheckInsurance" name="Insure parcel">
      <bpmn:incoming>SequenceFlow_ArrangeInsurance</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InsuranceComplete</bpmn:outgoing>
    </bpmn:task>

    <!-- Warehouse Worker Tasks -->
    <bpmn:parallelGateway id="ParallelGateway_StartPacking">
      <bpmn:incoming>SequenceFlow_CheckShipping</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PackGoodsPath</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:task id="Task_PackGoods" name="Package goods">
      <bpmn:incoming>SequenceFlow_PackGoodsPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GoodsPacked</bpmn:outgoing>
    </bpmn:task>

    <!-- Merge Points -->
    <bpmn:inclusiveGateway id="InclusiveGateway_SpecialShipmentMerge">
      <bpmn:incoming>SequenceFlow_SelectOfferComplete</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PreparationFinalCheck</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_1" name="Shipment prepared">
      <bpmn:incoming>SequenceFlow_Finalized</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows for Special Shipment Path -->
    <bpmn:sequenceFlow id="SequenceFlow_SpecialShipmentPath" name="yes" sourceRef="ExclusiveGateway_QualityCheck" targetRef="Task_GetOffers" />
    <bpmn:sequenceFlow id="SequenceFlow_SelectOfferComplete" sourceRef="Task_SelectOffer" targetRef="InclusiveGateway_SpecialShipmentMerge" />

    <!-- Sequence Flows for Normal Delivery Path -->
    <bpmn:sequenceFlow id="SequenceFlow_NormalDeliveryPath" name="no" sourceRef="ExclusiveGateway_QualityCheck" targetRef="Task_FillPackageForm" />
    <bpmn:sequenceFlow id="SequenceFlow_PackageLabelComplete" sourceRef="Task_FillPackageForm" targetRef="InclusiveGateway_InsuranceCheck" />

    <!-- Insurance Path -->
    <bpmn:sequenceFlow id="SequenceFlow_ArrangeInsurance" name="yes" sourceRef="InclusiveGateway_InsuranceCheck" targetRef="Task_CheckInsurance" />
    <bpmn:sequenceFlow id="SequenceFlow_SkipInsurance" name="no" sourceRef="InclusiveGateway_InsuranceCheck" targetRef="ParallelGateway_StartPacking" />

    <!-- Warehouse Path -->
    <bpmn:parallelGateway id="ParallelGateway_Merge">
      <bpmn:incoming>SequenceFlow_GoodsPacked</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PreparationFinalCheck</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Final Sequence Flow to End -->
    <bpmn:sequenceFlow id="SequenceFlow_Finalized" sourceRef="ParallelGateway_Merge" targetRef="EndEvent_1" />

  </bpmn:process>
</bpmn:definitions>