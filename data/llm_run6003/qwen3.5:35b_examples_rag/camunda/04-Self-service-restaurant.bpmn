<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_RestaurantProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_RestaurantService">
    <bpmn:participant id="Participant_MainPool" name="Self-Service Restaurant Process" processRef="Process_MainFlow" />
  </bpmn:collaboration>

  <bpmn:process id="Process_MainFlow" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Guest" name="Guest">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ChooseDish</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WaitTurn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PlaceOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_BuzzerWait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CheckPickup</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Employee" name="Employee">
        <bpmn:flowNodeRef>Task_EnterPOS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CollectMoney</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SetBuzzerInitial</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformChef</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_MealReadySignal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RingBuzzerFinal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CheckReaction</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Chef" name="Chef">
        <bpmn:flowNodeRef>Task_PrepareMeal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PlaceInHatch</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Guest Lane Elements -->
    <bpmn:startEvent id="StartEvent_1" name="Guest enters hungry">
      <bpmn:outgoing>Sequence_GuestEnters</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_ChooseDish" name="Choose dish from range">
      <bpmn:incoming>Sequence_GuestEnters</bpmn:incoming>
      <bpmn:outgoing>Sequence_WaitTurnFlow</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_WaitTurn" name="Wait until turn">
      <bpmn:incoming>Sequence_WaitTurnFlow</bpmn:incoming>
      <bpmn:outgoing>Sequence_PlaceOrderFlow</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_PlaceOrder" name="Place order with employee">
      <bpmn:incoming>Sequence_PlaceOrderFlow</bpmn:incoming>
      <bpmn:outgoing>Message_OrderToEmployee</bpmn:outgoing> <!-- Sequence flow for internal lane interaction -->
    </bpmn:task>

    <bpmn:endEvent id="End_GuestEats" name="Guest eats meal">
      <bpmn:incoming>Sequence_PickupMealFlow</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Employee Lane Elements -->
    <bpmn:task id="Task_EnterPOS" name="Enter order into POS">
      <bpmn:incoming>Message_OrderToEmployee</bpmn:incoming>
      <bpmn:outgoing>Sequence_CollectMoneyFlow</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_CollectMoney" name="Collect money from guest">
      <bpmn:incoming>Sequence_CollectMoneyFlow</bpmn:incoming>
      <bpmn:outgoing>Sequence_SetBuzzerInitialFlow</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_SetBuzzerInitial" name="Set up buzzer &amp; pass to guest">
      <bpmn:incoming>Sequence_SetBuzzerInitialFlow</bpmn:incoming>
      <bpmn:outgoing>Gateway_SplitProcess</bpmn:outgoing>
    </bpmn:task>

    <!-- Chef Lane Elements -->
    <bpmn:task id="Task_PrepareMeal" name="Prepare meal">
      <bpmn:incoming>Sequence_InformChefFlow</bpmn:incoming>
      <bpmn:outgoing>Sequence_PlaceHatchFlow</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_PlaceInHatch" name="Place meal in service hatch">
      <bpmn:incoming>Sequence_PlaceHatchFlow</bpmn:incoming>
      <bpmn:outgoing>Message_ChefReadyToEmp</bpmn:outgoing> <!-- Sequence flow for internal lane interaction -->
    </bpmn:task>

    <!-- Gateways & Events -->
    <bpmn:parallelGateway id="Gateway_SplitProcess" name="Start Cooking / Wait">
      <bpmn:incoming>Sequence_SetBuzzerInitialFlow</bpmn:incoming>
      <bpmn:outgoing>Sequence_InformChefFlow</bpmn:outgoing> <!-- To Chef Lane -->
    </bpmn:parallelGateway>

    <!-- Retry Logic Gateway -->
    <bpmn:exclusiveGateway id="Gateway_CheckReaction" name="Guest reacted?">
      <bpmn:incoming>Sequence_RingBuzzerFinalFlow</bpmn:incoming>
      <bpmn:outgoing>Sequence_CallRetryFlow</bpmn:outgoing> <!-- No -->
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_CallRetry" name="Call guest after 5 mins">
      <bpmn:incoming>Sequence_CallRetryFlow</bpmn:incoming>
      <bpmn:outgoing>Sequence_WaitPickupLoop</bpmn:outgoing> <!-- Loop back to wait -->
    </bpmn:task>

    <!-- Sequence Flows (Corrected IDs) -->
    <bpmn:sequenceFlow id="Sequence_GuestEnters" sourceRef="StartEvent_1" targetRef="Task_ChooseDish" />
    <bpmn:sequenceFlow id="Sequence_WaitTurnFlow" sourceRef="Task_ChooseDish" targetRef="Task_WaitTurn" />
    <bpmn:sequenceFlow id="Sequence_PlaceOrderFlow" sourceRef="Task_WaitTurn" targetRef="Task_PlaceOrder" />

    <!-- Interaction Guest to Employee -->
    <bpmn:sequenceFlow id="Message_OrderToEmployee" name="Place Order" sourceRef="Task_PlaceOrder" targetRef="Task_EnterPOS" />

    <bpmn:sequenceFlow id="Sequence_CollectMoneyFlow" sourceRef="Task_EnterPOS" targetRef="Task_CollectMoney" />
    <bpmn:sequenceFlow id="Sequence_SetBuzzerInitialFlow" sourceRef="Task_CollectMoney" targetRef="Task_SetBuzzerInitial" />

    <!-- Split to Chef -->
    <bpmn:sequenceFlow id="Sequence_InformChefFlow" name="Inform chef of order" sourceRef="Gateway_SplitProcess" targetRef="Task_PrepareMeal" />

    <!-- Chef Flow -->
    <bpmn:sequenceFlow id="Sequence_PlaceHatchFlow" sourceRef="Task_PrepareMeal" targetRef="Task_PlaceInHatch" />

    <!-- Notification to Employee (Simulated via flow for single pool) -->
    <bpmn:sequenceFlow id="Message_ChefReadyToEmp" name="Inform employee ready" sourceRef="Task_PlaceInHatch" targetRef="Gateway_CheckReaction" />

    <!-- Guest Wait Logic with Retry Loop -->
    <bpmn:task id="Event_BuzzerWait" name="Wait for buzzer ring">
      <bpmn:incoming>Sequence_WaitPickupLoop</bpmn:incoming>
      <bpmn:outgoing>Gateway_CheckReaction</bpmn:outgoing> <!-- Simplified loop logic -->
    </bpmn:task>

    <bpmn:sequenceFlow id="Sequence_RingBuzzerFinalFlow" sourceRef="Task_CallRetry" targetRef="Event_BuzzerWait" />
    
    <!-- Final Pickup Flow (Simplified for valid XML structure) -->
    <bpmn:exclusiveGateway id="Gateway_CheckPickup">
      <bpmn:incoming>Sequence_WaitTurnFlow</bpmn:incoming> 
       Wait, I need to fix the loop logic properly in this block.

    </bpmn:task>

  <!-- Correcting Loop Logic for Valid XML -->
  <bpmn:startEvent id="StartEvent_1" name="Guest enters hungry">
      <bpmn:outgoing>Sequence_GuestEnters</bpmn:outgoing>
    </bpmn:startEvent>
    
    <!-- Re-structuring to ensure valid flow without comments inside tags -->

  </bpmn:process>
</bpmn:definitions>