<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_ShippingProcess">
    <bpmn:participant id="Participant_ComputerHardwareShop" name="Dispatch of goods&#10;Computer Hardware Shop" processRef="Process_ShippingGoods" />
  </bpmn:collaboration>

  <bpmn:process id="Process_ShippingGoods" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Secretary" name="Secretary">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckShippingMethod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_LargeAmounts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_InsuranceCheck</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Logistics" name="Logistics Department Head">
        <bpmn:flowNodeRef>Task_Invite3Offers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectCompany</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Warehouse" name="Warehouse">
        <bpmn:flowNodeRef>Task_PackageGoods</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Ship goods">
      <bpmn:outgoing>SequenceFlow_CheckShipping</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Check shipping method (Secretary) -->
    <bpmn:userTask id="Task_CheckShippingMethod" name="Clarify who will do the shipping">
      <bpmn:incoming>SequenceFlow_CheckShipping</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ShippingTypeDecision</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway 1: Large vs Small amounts -->
    <bpmn:exclusiveGateway id="Gateway_LargeAmounts" name="Large amount?">
      <bpmn:incoming>SequenceFlow_ShippingTypeDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_LargeAmounts</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SmallAmounts</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Large Amount Path -->
    <bpmn:userTask id="Task_Invite3Offers" name="Invite 3 logistic companies for offers">
      <bpmn:incoming>SequenceFlow_LargeAmounts</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SelectCompany</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_SelectCompany" name="Select logistic company and place order">
      <bpmn:incoming>SequenceFlow_SelectCompany</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SpecialShippingDone</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Small Amount Path -->
    <bpmn:userTask id="Task_WritePackageLabel" name="Write package label">
      <bpmn:incoming>SequenceFlow_SmallAmounts</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_LabelWritten</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Insurance Decision (after label written) -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_InsuranceCheck" name="Insurance necessary?">
      <bpmn:incoming>SequenceFlow_SmallAmounts</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TakeInsurance</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoInsurance</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Insurance Task -->
    <bpmn:userTask id="Task_PackageGoods" name="Take parcel insurance">
      <bpmn:incoming>SequenceFlow_TakeInsurance</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InsuranceDone</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Warehouse Parallel Task -->
    <bpmn:userTask id="Task_WarehousePackaging" name="Package goods">
      <bpmn:incoming>SequenceFlow_ShippingTypeDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GoodsPackaged</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway 2: Merge paths -->
    <bpmn:inclusiveGateway id="InclusiveGateway_PrepReady" name="All ready?">
      <bpmn:incoming>SequenceFlow_SpecialShippingDone</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_LabelWritten</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_InsuranceDone</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_GoodsPackaged</bpmn:incoming>
    </bpmn:inclusiveGateway>

    <!-- Final Task before end -->
    <bpmn:userTask id="Task_FinalPreparation" name="Prepare for picking up goods">
      <bpmn:incoming>SequenceFlow_PrepReadyFromGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PreparePickup</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_ShipmentPrepared" name="Shipment prepared">
      <bpmn:incoming>SequenceFlow_PreparePickup</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckShipping" sourceRef="StartEvent_1" targetRef="Task_CheckShippingMethod" />
    <bpmn:sequenceFlow id="SequenceFlow_ShippingTypeDecision" sourceRef="Task_CheckShippingMethod" targetRef="Gateway_LargeAmounts" />

    <!-- Large Amounts Path -->
    <bpmn:sequenceFlow id="SequenceFlow_LargeAmounts" name="yes - large amounts" sourceRef="Gateway_LargeAmounts" targetRef="Task_Invite3Offers" />
    <bpmn:sequenceFlow id="SequenceFlow_SelectCompany" sourceRef="Task_Invite3Offers" targetRef="Task_SelectCompany" />
    <bpmn:sequenceFlow id="SequenceFlow_SpecialShippingDone" name="special shipping done" sourceRef="Task_SelectCompany" targetRef="InclusiveGateway_PrepReady" />

    <!-- Small Amounts Path -->
    <bpmn:sequenceFlow id="SequenceFlow_SmallAmounts" name="no - small amounts" sourceRef="Gateway_LargeAmounts" targetRef="ExclusiveGateway_InsuranceCheck" />
    
    <!-- Insurance Decision (after label written) -->
    <bpmn:sequenceFlow id="SequenceFlow_LabelWritten" sourceRef="Task_WritePackageLabel" targetRef="ExclusiveGateway_InsuranceCheck" />

    <!-- Parallel Warehouse Task Start -->
    <bpmn:sequenceFlow id="SequenceFlow_WarehouseStart" name="in the meantime" sourceRef="Gateway_LargeAmounts" targetRef="Task_WarehousePackaging" />
    
    <!-- Insurance Path -->
    <bpmn:sequenceFlow id="SequenceFlow_TakeInsurance" name="insurance necessary" sourceRef="ExclusiveGateway_InsuranceCheck" targetRef="Task_PackageGoods" />

    <!-- Merge Paths to Final Gateway -->
    <bpmn:sequenceFlow id="SequenceFlow_GoodsPackaged" sourceRef="Task_WarehousePackaging" targetRef="InclusiveGateway_PrepReady" />
    
    <!-- Insurance Done Path (if insurance taken) -->
    <bpmn:sequenceFlow id="SequenceFlow_InsuranceDone" name="insurance done" sourceRef="Task_PackageGoods" targetRef="InclusiveGateway_PrepReady" />

    <!-- Final Preparation and End -->
    <bpmn:sequenceFlow id="SequenceFlow_PreparePickup" sourceRef="InclusiveGateway_PrepReady" targetRef="EndEvent_ShipmentPrepared" />

  </bpmn:process>
</bpmn:definitions>