<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Review order">
      <bpmn:outgoing>SequenceFlow_0i5kq6o</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="ServiceTask_1" name="Check if all requested items are available">
      <bpmn:incoming>SequenceFlow_0i5kq6o</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1g4h7j3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway_1" name="Is everything OK?">
      <bpmn:incoming>SequenceFlow_1g4h7j3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2e5p6o9</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_3f8i7a0</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask_2" name="Inform customer about potential delay and order missing products">
      <bpmn:incoming>SequenceFlow_2e5p6o9</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4a7l8b1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask_3" name="Wait for delivery (average of x days)">
      <bpmn:incoming>SequenceFlow_4a7l8b1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5c9m0d2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway_2" name="Is everything OK after waiting?">
      <bpmn:incoming>SequenceFlow_5c9m0d2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6f1n4e3</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_7g2o5f4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask_4" name="Check if all products are on store">
      <bpmn:incoming>SequenceFlow_6f1n4e3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_8d3p6g5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:manualTask id="ManualTask_1" name="Recollect all products and prepare package">
      <bpmn:incoming>SequenceFlow_8d3p6g5</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_9e4q7h6</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:serviceTask id="ServiceTask_5" name="Inform courier about pre-processed package">
      <bpmn:incoming>SequenceFlow_9e4q7h6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Af5s8i7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_1" name="Package delivered">
      <bpmn:incoming>SequenceFlow_Af5s8i7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow_0i5kq6o" sourceRef="StartEvent_1" targetRef="ServiceTask_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_1g4h7j3" sourceRef="ServiceTask_1" targetRef="ExclusiveGateway_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_2e5p6o9" name="No" sourceRef="ExclusiveGateway_1" targetRef="ServiceTask_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_3f8i7a0" name="Yes" sourceRef="ExclusiveGateway_1" targetRef="ServiceTask_3"/>
    <bpmn:sequenceFlow id="SequenceFlow_4a7l8b1" sourceRef="ServiceTask_2" targetRef="ServiceTask_3"/>
    <bpmn:sequenceFlow id="SequenceFlow_5c9m0d2" sourceRef="ServiceTask_3" targetRef="ExclusiveGateway_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_6f1n4e3" name="No" sourceRef="ExclusiveGateway_2" targetRef="ServiceTask_4"/>
    <bpmn:sequenceFlow id="SequenceFlow_7g2o5f4" name="Yes" sourceRef="ExclusiveGateway_2" targetRef="ManualTask_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_8d3p6g5" sourceRef="ServiceTask_4" targetRef="ManualTask_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_9e4q7h6" sourceRef="ManualTask_1" targetRef="ServiceTask_5"/>
    <bpmn:sequenceFlow id="SequenceFlow_Af5s8i7" sourceRef="ServiceTask_5" targetRef="EndEvent_1"/>
  </bpmn:process>
</bpmn:definitions>