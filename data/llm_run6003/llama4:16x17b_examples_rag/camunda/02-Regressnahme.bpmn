<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Regressforderung" targetNamespace="http://example.com">

   <process id="regressProcess" isExecutable="true">
     <startEvent id="startEvent1">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="taskPrüfen"/>

     <userTask id="taskPrüfen" name="Fall prüfen">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
       <outgoing>sequenceFlow3</outgoing>
     </userTask>

     <exclusiveGateway id="exclusiveGateway1">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow4</outgoing>
       <outgoing>sequenceFlow5</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow2" sourceRef="taskPrüfen" targetRef="exclusiveGateway1"/>

     <sequenceFlow id="sequenceFlow3" name="nein" sourceRef="taskPrüfen" targetRef="endEventSchließen"/>

     <userTask id="taskZahlungsaufforderung" name="VN Zahlungsaufforderung senden">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow6</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow4" name="ja" sourceRef="exclusiveGateway1" targetRef="taskZahlungsaufforderung"/>

     <serviceTask id="taskWiedervorlage" name="Vorgang auf Wiedervorlage setzen">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow7</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlow6" sourceRef="taskZahlungsaufforderung" targetRef="taskWiedervorlage"/>

     <intermediateCatchEvent id="intermediateCatchEvent1">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow8</outgoing>
     </intermediateCatchEvent>

     <sequenceFlow id="sequenceFlow7" sourceRef="taskWiedervorlage" targetRef="intermediateCatchEvent1"/>

     <userTask id="taskGeldeingangVerbuchung" name="Geldeingang verbuche">
       <incoming>sequenceFlow8</incoming>
       <outgoing>sequenceFlow9</outgoing>
     </userTask>

     <endEvent id="endEventSchließen">
       <incoming>sequenceFlow3</incoming>
       <incoming>sequenceFlow9</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow8" sourceRef="intermediateCatchEvent1" targetRef="taskGeldeingangVerbuchung"/>

     <sequenceFlow id="sequenceFlow9" sourceRef="taskGeldeingangVerbuchung" targetRef="endEventSchließen"/>
   </process>
</definitions>