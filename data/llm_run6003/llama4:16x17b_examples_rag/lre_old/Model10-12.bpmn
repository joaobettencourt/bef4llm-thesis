<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">
   <collaboration id="Collaboration_1">
     <participant id="Participant_EC" name="EC" processRef="Process_EC"/>
     <participant id="Participant_INQ" name="INQ" processRef="Process_INQ"/>
     <participant id="Participant_IP" name="IP" processRef="Process_IP"/>
   </collaboration>
   <process id="Process_EC" isExecutable="false">
     <startEvent id="StartEvent_EC_1">
       <outgoing>SequenceFlow_EC_1</outgoing>
     </startEvent>
     <sequenceFlow id="SequenceFlow_EC_1" sourceRef="StartEvent_EC_1" targetRef="Task_EC"/>
     <task id="Task_EC" name="Notify INQ about master data change">
       <incoming>SequenceFlow_EC_1</incoming>
       <outgoing>SequenceFlow_EC_2</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_EC_2" sourceRef="Task_EC" targetRef="EndEvent_EC"/>
     <endEvent id="EndEvent_EC">
       <incoming>SequenceFlow_EC_2</incoming>
     </endEvent>
   </process>
   <process id="Process_INQ" isExecutable="false">
     <startEvent id="StartEvent_INQ_1">
       <outgoing>SequenceFlow_INQ_1</outgoing>
     </startEvent>
     <sequenceFlow id="SequenceFlow_INQ_1" sourceRef="StartEvent_INQ_1" targetRef="Task_INQ"/>
     <task id="Task_INQ" name="Notify IP about master data change">
       <incoming>SequenceFlow_INQ_1</incoming>
       <outgoing>SequenceFlow_INQ_2</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_INQ_2" sourceRef="Task_INQ" targetRef="EndEvent_INQ"/>
     <endEvent id="EndEvent_INQ">
       <incoming>SequenceFlow_INQ_2</incoming>
     </endEvent>
   </process>
   <process id="Process_IP" isExecutable="false">
     <startEvent id="StartEvent_IP_1">
       <outgoing>SequenceFlow_IP_1</outgoing>
     </startEvent>
     <sequenceFlow id="SequenceFlow_IP_1" sourceRef="StartEvent_IP_1" targetRef="Task_IP_Check"/>
     <task id="Task_IP_Check" name="Check master data change">
       <incoming>SequenceFlow_IP_1</incoming>
       <outgoing>SequenceFlow_IP_2</outgoing>
       <outgoing>SequenceFlow_IP_3</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_IP_2" sourceRef="Task_IP_Check" targetRef="Task_IP_Confirm">
       <!--<conditionExpression xsi:type="tFormalExpression">${canChange}</conditionExpression>-->
     </sequenceFlow>
     <task id="Task_IP_Confirm" name="Confirm master data change">
       <incoming>SequenceFlow_IP_2</incoming>
       <outgoing>SequenceFlow_IP_4</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_IP_3" sourceRef="Task_IP_Check" targetRef="Task_IP_Reject">
      <!--<conditionExpression xsi:type="tFormalExpression">${not canChange}</conditionExpression>-->
     </sequenceFlow>
     <task id="Task_IP_Reject" name="Reject master data change">
       <incoming>SequenceFlow_IP_3</incoming>
       <outgoing>SequenceFlow_IP_5</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_IP_4" sourceRef="Task_IP_Confirm" targetRef="EndEvent_IP_Confirmed"/>
     <endEvent id="EndEvent_IP_Confirmed">
       <incoming>SequenceFlow_IP_4</incoming>
     </endEvent>
     <sequenceFlow id="SequenceFlow_IP_5" sourceRef="Task_IP_Reject" targetRef="EndEvent_IP_Rejected"/>
     <endEvent id="EndEvent_IP_Rejected">
       <incoming>SequenceFlow_IP_5</incoming>
     </endEvent>
   </process>
  <messageFlow id="MF1" name="Notify INQ about master data change flow"
               sourceRef="Participant_EC" targetRef="Process_INQ"/>
  <messageFlow id="MF2" name=" Notify IP of the changes to his master data "
               sourceRef="Process_INQ" targetRef="Process_IP"/> 
</definitions>