<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">
  <collaboration id="Collaboration_1">
    <participant id="Participant_0" name="INQ" processRef="Pool_0"/>
    <participant id="Participant_1" name="IP" processRef="Pool_1"/>
    <messageFlow id="MessageFlow_0" sourceRef="StartEvent_1" targetRef="Task_2"/>
    <messageFlow id="MessageFlow_1" sourceRef="Task_3" targetRef="IntermediateCatchEvent_1"/>
    <messageFlow id="MessageFlow_2" sourceRef="Task_4" targetRef="IntermediateCatchEvent_1"/>
  </collaboration>
  <process id="Pool_0" isExecutable="false">
    <laneSet>
      <lane id="Lane_0" name="">
        <flowNodeRef>StartEvent_1</flowNodeRef>
        <flowNodeRef>Task_1</flowNodeRef>
      </lane>
    </laneSet>
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <task id="Task_1" name="Transmit transaction data request">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="IntermediateThrowEvent_1"/>
    <intermediateThrowEvent id="IntermediateThrowEvent_1">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>MessageFlow_0</outgoing>
    </intermediateThrowEvent>
  </process>
  <process id="Pool_1" isExecutable="false">
    <laneSet>
      <lane id="Lane_1" name="">
        <flowNodeRef>StartEvent_2</flowNodeRef>
        <flowNodeRef>Task_2</flowNodeRef>
        <flowNodeRef>ExclusiveGateway_1</flowNodeRef>
        <flowNodeRef>Task_3</flowNodeRef>
        <flowNodeRef>Task_4</flowNodeRef>
      </lane>
    </laneSet>
    <sequenceFlow id="SequenceFlow_3" sourceRef="StartEvent_2" targetRef="Task_2"/>
    <startEvent id="StartEvent_2">
      <incoming>MessageFlow_0</incoming>
      <outgoing>SequenceFlow_3</outgoing>
    </startEvent>
    <task id="Task_2" name="Check request">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_4</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_4" sourceRef="Task_2" targetRef="ExclusiveGateway_1"/>
    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_5</outgoing>
      <outgoing>SequenceFlow_6</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_5" sourceRef="ExclusiveGateway_1" targetRef="Task_3">
      <conditionExpression xsi:type="tFormalExpression">${requestValid == true}</conditionExpression>
    </sequenceFlow>
    <task id="Task_3" name="Transmit data">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>MessageFlow_1</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_6" sourceRef="ExclusiveGateway_1" targetRef="Task_4"/>
    <task id="Task_4" name="Reject request">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>MessageFlow_2</outgoing>
    </task>
  </process>
</definitions>