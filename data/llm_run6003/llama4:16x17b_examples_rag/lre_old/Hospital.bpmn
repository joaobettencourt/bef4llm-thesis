<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">
  <process id="ExaminationProcess" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_OutpatientPhysicianExaminesPatient"/>
    <task id="Task_OutpatientPhysicianExaminesPatient" name="Outpatient Physician Examines Patient">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
      <outgoing>SequenceFlow_3</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_OutpatientPhysicianExaminesPatient" targetRef="EndEvent_Healthy">
      <conditionExpression xsi:type="tFormalExpression">${patientIsHealthy}</conditionExpression>
    </sequenceFlow>
    <endEvent id="EndEvent_Healthy">
      <incoming>SequenceFlow_2</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_3" sourceRef="Task_OutpatientPhysicianExaminesPatient" targetRef="Task_PhysicianDecidesOnAdditionalExamination"/>
    <task id="Task_PhysicianDecidesOnAdditionalExamination" name="Physician Decides on Additional Examination">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_4</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_4" sourceRef="Task_PhysicianDecidesOnAdditionalExamination" targetRef="Task_RequestFormFilledOut"/>
    <task id="Task_RequestFormFilledOut" name="Request Form Filled Out">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_5</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_5" sourceRef="Task_RequestFormFilledOut" targetRef="Task_PatientInformedAboutPotentialRisks"/>
    <task id="Task_PatientInformedAboutPotentialRisks" name="Patient Informed About Potential Risks">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_6" sourceRef="Task_PatientInformedAboutPotentialRisks" targetRef="Task_PatientSignsInformedConsent"/>
    <task id="Task_PatientSignsInformedConsent" name="Patient Signs Informed Consent">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_7" sourceRef="Task_PatientSignsInformedConsent" targetRef="Task_AppointmentArrangedWithWard"/>
    <task id="Task_AppointmentArrangedWithWard" name="Appointment Arranged With Ward">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_8" sourceRef="Task_AppointmentArrangedWithWard" targetRef="Task_SampleTakenByWardPhysician"/>
    <task id="Task_SampleTakenByWardPhysician" name="Sample Taken By Ward Physician">
      <incoming>SequenceFlow_8</incoming>
      <outgoing>SequenceFlow_9</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_9" sourceRef="Task_SampleTakenByWardPhysician" targetRef="Task_LabAnalyzesSample"/>
    <task id="Task_LabAnalyzesSample" name="Lab Analyzes Sample">
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_10</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_10" sourceRef="Task_LabAnalyzesSample" targetRef="Task_LabPhysicianValidatesResults"/>
    <task id="Task_LabPhysicianValidatesResults" name="Lab Physician Validates Results">
      <incoming>SequenceFlow_10</incoming>
      <outgoing>SequenceFlow_11</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_11" sourceRef="Task_LabPhysicianValidatesResults" targetRef="EndEvent_DiagnosisMade">
      <conditionExpression xsi:type="tFormalExpression">${resultsValid}</conditionExpression>
    </sequenceFlow>
    <endEvent id="EndEvent_DiagnosisMade">
      <incoming>SequenceFlow_11</incoming>
    </endEvent>
  </process>
</definitions>