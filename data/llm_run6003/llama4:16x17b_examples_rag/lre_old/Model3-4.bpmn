<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">
  <process id="Process_1" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>
    <task id="Task_1" name="Send Questionnaire">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="IntermediateCatchEvent_1"/>
    <intermediateCatchEvent id="IntermediateCatchEvent_1">
      <incoming>SequenceFlow_2</incoming>
      <timerEventDefinition>
        <timeDuration>P5D</timeDuration>
      </timerEventDefinition>
      <outgoing>SequenceFlow_3</outgoing>
    </intermediateCatchEvent>
    <sequenceFlow id="SequenceFlow_3" sourceRef="IntermediateCatchEvent_1" targetRef="Task_2"/>
    <task id="Task_2" name="Send Reminder">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_4</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_4" sourceRef="Task_2" targetRef="IntermediateCatchEvent_1"/>
    <intermediateMessageEvent id="IntermediateMessageEvent_1">
      <messageEventDefinition messageRef="Message_1"/>
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </intermediateMessageEvent>
    <sequenceFlow id="SequenceFlow_5" sourceRef="Task_3" targetRef="IntermediateMessageEvent_1"/>
    <task id="Task_3" name="Receive Questionnaire">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_6" sourceRef="IntermediateMessageEvent_1" targetRef="Task_3"/>
    <sequenceFlow id="SequenceFlow_7" sourceRef="Task_3" targetRef="EndEvent_1"/>
    <endEvent id="EndEvent_1">
      <incoming>SequenceFlow_7</incoming>
    </endEvent>
  </process>
  <message id="Message_1" name="Questionnaire Received"/>
</definitions>