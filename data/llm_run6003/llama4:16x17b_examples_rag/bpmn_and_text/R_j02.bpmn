```xml
<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/BPMN20.xsd"
             id="definitions" name="Inspection of an Energy Drink Bottling Machine"
             targetNamespace="http://example.com/bpmn">

   <process id="inspectionProcess" isExecutable="true">
     <startEvent id="startEvent1">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="task1"/>

     <userTask id="task1" name="Enter machine type and serial number">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow2" sourceRef="task1" targetRef="exclusiveGateway1"/>

     <exclusiveGateway id="exclusiveGateway1">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
       <outgoing>sequenceFlow4</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow3" name="has questions" sourceRef="exclusiveGateway1" targetRef="task2">
       <conditionExpression xsi:type="tFormalExpression">${inspectionResults.needQuestions}</conditionExpression>
     </sequenceFlow>

     <userTask id="task2" name="Input values for inspection">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow5</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow5" sourceRef="task2" targetRef="exclusiveGateway2"/>

     <exclusiveGateway id="exclusiveGateway2">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow7</outgoing>
       <outgoing>sequenceFlow8</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow7" name="additional questions needed" sourceRef="exclusiveGateway2" targetRef="task3">
       <conditionExpression xsi:type="tFormalExpression">${inspectionResults.needMoreQuestions}</conditionExpression>
     </sequenceFlow>

     <userTask id="task3" name="Input additional values for inspection">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow9</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow9" sourceRef="task3" targetRef="endEvent1"/>

     <serviceTask id="serviceTask1" name="Collect data from machine">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow6</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlow4" name="no questions" sourceRef="exclusiveGateway1" targetRef="serviceTask1"/>

     <sequenceFlow id="sequenceFlow6" sourceRef="serviceTask1" targetRef="exclusiveGateway3"/>

     <exclusiveGateway id="exclusiveGateway3">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow10</outgoing>
       <outgoing>sequenceFlow11</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow10" name="results are ok" sourceRef="exclusiveGateway3" targetRef="endEvent1">
       <conditionExpression xsi:type="tFormalExpression">${inspectionResults.areOk}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="sequenceFlow11" name="results need review" sourceRef="exclusiveGateway3" targetRef="task4"/>

     <userTask id="task4" name="Review inspection results">
       <incoming>sequenceFlowFlowFlowFlowFlowFlowFlowFlowFlowFlowFlowFlowFlowFlowFlowFlowFlowFlowFlowFlowFlowFlowFlowFlowFlowFlowFlowFlowFlowFlowFlow