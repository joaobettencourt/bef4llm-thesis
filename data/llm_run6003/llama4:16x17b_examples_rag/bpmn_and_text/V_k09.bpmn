<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/06-02-01.xsd"
             id="definitions" name="Storage Management Process">

   <process id="storageManagementProcess" isExecutable="true">
     <startEvent id="readOrder">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="readOrder" targetRef="checkProductAvailability"/>

     <task id="checkProductAvailability" name="Check if product is in stock">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
       <outgoing>sequenceFlow3</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow2" sourceRef="checkProductAvailability" targetRef="withdrawFromWarehouse">
       <conditionExpression xsi:type="tFormalExpression">${productInStock == true}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="sequenceFlow3" sourceRef="checkProductAvailability" targetRef="reorderFromWholesaler">
       <conditionExpression xsi:type="tFormalExpression">${productInStock == false}</conditionExpression>
     </sequenceFlow>

     <task id="withdrawFromWarehouse" name="Withdraw product from warehouse">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow4</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow4" sourceRef="withdrawFromWarehouse" targetRef="registerInStockManagementSystem"/>

     <task id="reorderFromWholesaler" name="Reorder product from wholesaler">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow5</outgoing>
     </task>

     <exclusiveGateway id="gateway1">
       <incoming>reorderFromWholesaler</incoming>
       <outgoing>sequenceFlow6</outgoing>
       <outgoing>sequenceFlow7</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow5" sourceRef="reorderFromWholesaler" targetRef="gateway1"/>

     <sequenceFlow id="sequenceFlow6" sourceRef="gateway1" targetRef="registerInStockManagementSystem">
       <conditionExpression xsi:type="tFormalExpression">${daysToDelivery > 10}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="sequenceFlow7" sourceRef="gateway1" targetRef="registerInStockManagementSystem"/>

     <task id="registerInStockManagementSystem" name="Register product in stock management system">
       <incoming>sequenceFlow4</incoming>
       <incoming>sequenceFlow6</incoming>
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow8</outgoing>
     </task>

     <exclusiveGateway id="gateway2">
       <incoming>registerInStockManagementSystem</incoming>
       <outgoing>sequenceFlow9</outgoing>
       <outgoing>sequenceFlow10</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow8" sourceRef="registerInStockManagementSystem" targetRef="gateway2"/>

     <sequenceFlow id="sequenceFlow9" sourceRef="gateway2" targetRef="requestCourierAndPackProducts">
       <conditionExpression xsi:type="tFormalExpression">${allProductsAvailable == true}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="sequenceFlow10" sourceRef="gateway2" targetRef="checkProductAvailability">
       <conditionExpression xsi:type="tFormalExpression">${allProductsAvailable == false}</conditionExpression>
     </sequenceFlow>

     <task id="requestCourierAndPackProducts" name="Request courier and pack products">
       <incoming>sequenceFlow9</incoming>
       <outgoing>sequenceFlow11</outgoing>
     </task>

     <endEvent id="endEvent">
       <incoming>sequenceFlow11</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow11" sourceRef="requestCourierAndPackProducts" targetRef="endEvent"/>
   </process>
</definitions>