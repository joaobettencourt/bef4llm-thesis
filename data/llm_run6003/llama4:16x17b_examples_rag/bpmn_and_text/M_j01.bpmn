<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/20.xsd"
             id="definition" name="BPMN Process Model" targetNamespace="http://example.com">
   <process id="chainsaw_process" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_GetCustomerRequirements</outgoing>
     </startEvent>
     <sequenceFlow id="SequenceFlow_GetCustomerRequirements" sourceRef="StartEvent_1" targetRef="Task_GetCustomerRequirements"/>
     <task id="Task_GetCustomerRequirements" name="Get customer requirements">
       <incoming>SequenceFlow_GetCustomerRequirements</incoming>
       <outgoing>SequenceFlow_ParallelGateway_1</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_ParallelGateway_1" sourceRef="Task_GetCustomerRequirements" targetRef="ParallelGateway_1"/>
     <parallelGateway id="ParallelGateway_1">
       <incoming>SequenceFlow_ParallelGateway_1</incoming>
       <outgoing>SequenceFlow_OrderParts</outgoing>
       <outgoing>SequenceFlow_SendUpdatesToCustomer</outgoing>
     </parallelGateway>
     <sequenceFlow id="SequenceFlow_OrderParts" sourceRef="ParallelGateway_1" targetRef="Task_OrderParts"/>
     <task id="Task_OrderParts" name="Order parts">
       <incoming>SequenceFlow_OrderParts</incoming>
       <outgoing>SequenceFlow_IntermediateCatchEvent_PartsArrived</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_SendUpdatesToCustomer" sourceRef="ParallelGateway_1" targetRef="Task_SendUpdatesToCustomer"/>
     <task id="Task_SendUpdatesToCustomer" name="Send updates to customer">
       <incoming>SequenceFlow_SendUpdatesToCustomer</incoming>
       <outgoing>SequenceFlow_ExclusiveGateway_1</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_IntermediateCatchEvent_PartsArrived" sourceRef="Task_OrderParts" targetRef="IntermediateCatchEvent_PartsArrived"/>
     <intermediateCatchEvent id="IntermediateCatchEvent_PartsArrived">
       <incoming>SequenceFlow_IntermediateCatchEvent_PartsArrived</incoming>
       <outgoing>SequenceFlow_Task_ManualInspection</outgoing>
     </intermediateCatchEvent>
     <sequenceFlow id="SequenceFlow_ExclusiveGateway_1" sourceRef="Task_SendUpdatesToCustomer" targetRef="ExclusiveGateway_1"/>
     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_ExclusiveGateway_1</incoming>
       <outgoing>SequenceFlow_EndEvent_CustomerLikesIt</outgoing>
       <outgoing>SequenceFlow_Task_AssembleParts</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_Task_ManualInspection" sourceRef="IntermediateCatchEvent_PartsArrived" targetRef="Task_ManualInspection"/>
     <task id="Task_ManualInspection" name="Manual inspection">
       <incoming>SequenceFlow_Task_ManualInspection</incoming>
       <outgoing>SequenceFlow_Task_AssembleParts</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_Task_AssembleParts" sourceRef="Task_ManualInspection" targetRef="Task_AssembleParts"/>
     <task id="Task_AssembleParts" name="Assemble parts">
       <incoming>SequenceFlow_Task_AssembleParts</incoming>
       <outgoing>SequenceFlow_EndEvent_CustomerLikesIt_1</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_EndEvent_CustomerLikesIt" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_CustomerLikesIt"/>
     <endEvent id="EndEvent_CustomerLikesIt">
       <incoming>SequenceFlow_EndEvent_CustomerLikesIt</incoming>
     </endEvent>
     <sequenceFlow id="SequenceFlow_EndEvent_CustomerLikesIt_1" sourceRef="Task_AssembleParts" targetRef="EndEvent_ProductionFinished"/>
     <endEvent id="EndEvent_ProductionFinished">
       <incoming>SequenceFlow_EndEvent_CustomerLikesIt_1</incoming>
     </endEvent>
   </process>
 </definitions>