<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/BPMN20.xsd"
             id="definition" name="BPMN Process Model">
  <process id="Process_1" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_CollectRequirements"/>
    <task id="Task_CollectRequirements" name="Collect Requirements">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_CollectRequirements" targetRef="ExclusiveGateway_1"/>
    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
      <outgoing>SequenceFlow_4</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_3" name="yes" sourceRef="ExclusiveGateway_1" targetRef="Task_SendToArchitect">
      <conditionExpression xsi:type="tFormalExpression">${requirementsComplete}</conditionExpression>
    </sequenceFlow>
    <task id="Task_SendToArchitect" name="Send to Architect">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_5</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_5" sourceRef="Task_SendToArchitect" targetRef="Task_CreateListOfMaterials"/>
    <task id="Task_CreateListOfMaterials" name="Create List of Materials">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_6" sourceRef="Task_CreateListOfMaterials" targetRef="ParallelGateway_1"/>
    <parallelGateway id="ParallelGateway_1">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_7</outgoing>
      <outgoing>SequenceFlow_8</outgoing>
    </parallelGateway>
    <sequenceFlow id="SequenceFlow_7" sourceRef="ParallelGateway_1" targetRef="Task_OrderMaterials"/>
    <task id="Task_OrderMaterials" name="Order Materials">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_9</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_9" sourceRef="Task_OrderMaterials" targetRef="ExclusiveGateway_2"/>
    <exclusiveGateway id="ExclusiveGateway_2">
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_10</outgoing>
      <outgoing>SequenceFlow_11</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_10" name="yes" sourceRef="ExclusiveGateway_2" targetRef="Task_SendMessagesToFriends">
      <conditionExpression xsi:type="tFormalExpression">${materialsArrived}</conditionExpression>
    </sequenceFlow>
    <task id="Task_SendMessagesToFriends" name="Send Messages to Friends">
      <incoming>SequenceFlow_10</incoming>
      <outgoing>SequenceFlow_12</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_12" sourceRef="Task_SendMessagesToFriends" targetRef="EndEvent_HouseBuilt"/>
    <endEvent id="EndEvent_HouseBuilt">
      <incoming>SequenceFlow_12</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_8" sourceRef="ParallelGateway_1" targetRef="Task_SendInvitations"/>
    <task id="Task_SendInvitations" name="Send Invitations">
      <incoming>SequenceFlow_8</incoming>
      <outgoing>SequenceFlow_13</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_13" sourceRef="Task_SendInvitations" targetRef="Task_CreateAttendeeList"/>
    <task id="Task_CreateAttendeeList" name="Create Attendee List">
      <incoming>SequenceFlow_13</incoming>
      <outgoing>SequenceFlow_14</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_14" sourceRef="Task_CreateAttendeeList" targetRef="EndEvent_PartyPrepared"/>
    <endEvent id="EndEvent_PartyPrepared">
      <incoming>SequenceFlow_14</incoming>
    </endEvent>
  </process>
</definitions>