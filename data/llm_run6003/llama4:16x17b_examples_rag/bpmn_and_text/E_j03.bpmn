<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/06-02-01.xsd"
             id="definition" name="Work Accident Process" targetNamespace="http://example.com/bpmn">

   <process id="workAccidentProcess" isExecutable="true">
     <startEvent id="startEvent1">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="taskInformEmployer"/>

     <userTask id="taskInformEmployer" name="Inform Employer about Work Accident">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow2" sourceRef="taskInformEmployer" targetRef="exclusiveGateway1"/>

     <exclusiveGateway id="exclusiveGateway1">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
       <outgoing>sequenceFlow4</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow3" name="yes" sourceRef="exclusiveGateway1" targetRef="taskReportAccident">
       <conditionExpression xsi:type="tFormalExpression">${isWorkAccident}</Ytdm:expression>
     </sequenceFlow>

     <sequenceFlow id="sequenceFlow4" name="no" sourceRef="exclusiveGateway1" targetRef="endEvent1"/>

     <userTask id="taskReportAccident" name="Report Work Accident">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow5</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow5" sourceRef="taskReportAccident" targetRef="exclusiveGateway2"/>

     <exclusiveGateway id="exclusiveGateway2">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow6</outgoing>
       <outgoing>sequenceFlow7</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow6" name="fatality or serious injury" sourceRef="exclusiveGateway2" targetRef="taskNotifyLabourInspectorate">
     </sequenceFlow>

     <sequenceFlow id="sequenceFlow7" name="other cases" sourceRef="exclusiveGateway2" targetRef="taskReportToAccidentInsuranceProvider"/>

     <userTask id="taskNotifyLabourInspectorate" name="Notify Labour Inspectorate">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow8</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow8" sourceRef="taskNotifyLabourInspectorate" targetRef="endEvent1"/>

     <userTask id="taskReportToAccidentInsuranceProvider" name="Report to Accident Insurance Provider">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow9</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow9" sourceRef="taskReportToAccidentInsuranceProvider" targetRef="endEvent1"/>

     <endEvent id="endEvent1">
       <incoming>sequenceFlow4</incoming>
       <incoming>sequenceFlow8</incoming>
       <incoming>sequenceFlow9</incoming>
     </endEvent>

   </process>

 </definitions>