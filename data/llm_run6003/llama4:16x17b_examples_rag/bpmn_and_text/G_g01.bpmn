<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/06-02-01.xsd" id="definition" name="LAN Party Process">
   <process id="lanPartyProcess" isExecutable="true">
     <startEvent id="startEvent1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>
     <sequenceFlow id="SequenceFlow_1" sourceRef="startEvent1" targetRef="taskSendInvitations"/>
     <task id="taskSendInvitations" name="Send Invitations to 10 Friends">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_2" sourceRef="taskSendInvitations" targetRef="taskGetGamesList"/>
     <task id="taskGetGamesList" name="Get List of Games from Friends">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_3" sourceRef="taskGetGamesList" targetRef="exclusiveGatewayAppointDate"/>
     <exclusiveGateway id="exclusiveGatewayAppointDate">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_4</outgoing>
       <outgoing>SequenceFlow_5</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_4" name="yes" sourceRef="exclusiveGatewayAppointDate" targetRef="taskFindGames">
       <conditionExpression xsi:type="tFormalExpression">${countFriendsAgree >= 8}</conditionExpression>
     </sequenceFlow>
     <sequenceFlow id="SequenceFlow_5" name="no" sourceRef="exclusiveGatewayAppointDate" targetRef="exclusiveGatewayAppointDate"/>
     <task id="taskFindGames" name="Find Out If All Games Are Available">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_6" sourceRef="taskFindGames" targetRef="exclusiveGatewayDownloadGames"/>
     <exclusiveGateway id="exclusiveGatewayDownloadGames">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_7</outgoing>
       <outgoing>SequenceFlow_8</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_7" name="yes" sourceRef="exclusiveGatewayDownloadGames" targetRef="taskGetBeerRequirements">
       <conditionExpression xsi:type="tFormalExpression">${allGamesAvailable == true}</conditionExpression>
     </sequenceFlow>
     <sequenceFlow id="SequenceFlow_8" name="no" sourceRef="exclusiveGatewayDownloadGames" targetRef="taskDownloadGame">
       <conditionExpression xsi:type="tFormalExpression">${allGamesAvailable == false}</conditionExpression>
     </sequenceFlow>
     <task id="taskDownloadGame" name="Download Missing Game">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_9" sourceRef="taskDownloadGame" targetRef="taskGetBeerRequirements"/>
     <task id="taskGetBeerRequirements" name="Find Out Beer Requirements">
       <incoming>SequenceFlow_7</incoming>
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_10</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_10" sourceRef="taskGetBeerRequirements" targetRef="exclusiveGatewayBuyBeer"/>
     <exclusiveGateway id="exclusiveGatewayBuyBeer">
       <incoming>SequenceFlow_10</incoming>
       <outgoing>SequenceFlow_11</outgoing>
       <outgoing>SequenceFlow_12</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_11" name="yes" sourceRef="exclusiveGatewayBuyBeer" targetRef="endEvent1">
       <conditionExpression xsi:type="tFormalExpression">${beerRequirementsFulfilled == true}</conditionExpression>
     </sequenceFlow>
     <sequenceFlow id="SequenceFlow_12" name="no" sourceRef="exclusiveGatewayBuyBeer" targetRef="taskPurchaseBeer">
       <conditionExpression xsi:type="tFormalExpression">${beerRequirementsFulfilled == false}</conditionExpression>
     </sequenceFlow>
     <task id="taskPurchaseBeer" name="Buy Missing Beer">
       <incoming>SequenceFlow_12</incoming>
       <outgoing>SequenceFlow_13</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_13" sourceRef="taskPurchaseBeer" targetRef="endEvent1"/>
     <endEvent id="endEvent1" name="LAN Party Started">
       <incoming>SequenceFlow_11</incoming>
       <incoming>SequenceFlow_13</incoming>
     </endEvent>
   </process>
</definitions>