<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/BPMN20.xsd"
             id="definition" name="BPMN Process Model" targetNamespace="http://example.com/bpmn">
  <process id="Service_For_Your_Fridge" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>
    <task id="Task_1" name="Describe Symptoms and Send Fridge Type to Service Center">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="ServiceTask_1"/>
    <serviceTask id="ServiceTask_1" name="Select Local Service Facility">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
    </serviceTask>
    <sequenceFlow id="SequenceFlow_3" sourceRef="ServiceTask_1" targetRef="ExclusiveGateway_1"/>
    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_4</outgoing>
      <outgoing>SequenceFlow_5</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_4" name="Arrives on time" sourceRef="ExclusiveGateway_1" targetRef="Task_2">
      <conditionExpression xsi:type="tFormalExpression">${serviceFacilityArrivesOnTime} = true</conditionExpression>
    </sequenceFlow>
    <task id="Task_2" name="Service Facility Arrives and Repairs Fridge (or Leaves Without Repairing)">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_5" name="Leaves without repair" sourceRef="ExclusiveGateway_1" targetRef="Task_3">
      <conditionExpression xsi:type="tFormalExpression">${serviceFacilityArrivesOnTime} = false</conditionExpression>
    </sequenceFlow>
    <task id="Task_3" name="Service Facility Leaves Without Repairing Fridge and Make Appointment">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_6" sourceRef="Task_2" targetRef="ConfirmRepair_1"/>
    <sequenceFlow id="SequenceFlow_7" sourceRef="Task_3" targetRef="ServiceTask_2"/>
    <serviceTask id="ServiceTask_2" name="Make Appointment with Service Facility">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </serviceTask>
    <sequenceFlow id="SequenceFlow_8" sourceRef="ServiceTask_2" targetRef="ConfirmRepair_1"/>
    <userTask id="ConfirmRepair_1" name="Confirm Repair and Rate Service Facility">
      <incoming>SequenceFlow_6</incoming>
      <incoming>SequenceFlow_8</incoming>
      <outgoing>SequenceFlow_9</outgoing>
    </userTask>
    <sequenceFlow id="SequenceFlow_9" sourceRef="ConfirmRepair_1" targetRef="EndEvent_1"/>
    <endEvent id="EndEvent_1">
      <incoming>SequenceFlow_9</incoming>
    </endEvent>
  </process>
</definitions>