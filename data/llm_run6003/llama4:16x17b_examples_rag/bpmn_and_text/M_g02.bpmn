<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/06-02-01.xsd"
             id="definition" name="BPMN Process Model" targetNamespace="http://bpmn.io/schema/bpmn">
   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>
     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_DevelopBasicDesign"/>
     <task id="Task_DevelopBasicDesign" name="Develop Basic Design">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_DevelopBasicDesign" targetRef="Task_OrderLegoSets"/>
     <task id="Task_OrderLegoSets" name="Order Lego Sets">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_3" sourceRef="Task_OrderLegoSets" targetRef="Task_SortParts"/>
     <task id="Task_SortParts" name="Sort Parts">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_4</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_4" sourceRef="Task_SortParts" targetRef="ParallelGateway_1"/>
     <parallelGateway id="ParallelGateway_1">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_5</outgoing>
       <outgoing>SequenceFlow_6</outgoing>
     </parallelGateway>
     <sequenceFlow id="SequenceFlow_5" sourceRef="ParallelGateway_1" targetRef="Task_BuildSubcomponent"/>
     <task id="Task_BuildSubcomponent" name="Build Subcomponent">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_7</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_6" sourceRef="ParallelGateway_1" targetRef="Task_TestSubcomponent"/>
     <task id="Task_TestSubcomponent" name="Test Subcomponent">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_8</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_7" sourceRef="Task_BuildSubcomponent" targetRef="ExclusiveGateway_1"/>
     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_9</outgoing>
       <outgoing>SequenceFlow_10</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_8" sourceRef="Task_TestSubcomponent" targetRef="ExclusiveGateway_1"/>
     <sequenceFlow id="SequenceFlow_9" name="yes" sourceRef="ExclusiveGateway_1" targetRef="Task_AssembleSubcomponents">
       <conditionExpression xsi:type="tFormalExpression">${testResult  == true}</conditionExpression>
     </sequenceFlow>
     <sequenceFlow id="SequenceFlow_10" name="no" sourceRef="ExclusiveGateway_1" targetRef="Task_RedesignAndRebuild"/>
     <task id="Task_AssembleSubcomponents" name="Assemble Subcomponents">
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_11</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_11" sourceRef="Task_AssembleSubcomponents" targetRef="EndEvent_1"/>
     <task id="Task_RedesignAndRebuild" name="Redesign and Rebuild">
       <incoming>SequenceFlow_10</incoming>
       <outgoing>SequenceFlow_12</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_12" sourceRef="Task_RedesignAndRebuild" targetRef="Task_BuildSubcomponent"/>
     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_11</incoming>
     </endEvent>
   </process>
 </definitions>