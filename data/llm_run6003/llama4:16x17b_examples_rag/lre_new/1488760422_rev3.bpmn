<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd" 
             id="definition" name="Invoice Processing" targetNamespace="http://bpmn.io/schema/bpmn">
   <process id="invoiceProcessing" isExecutable="true">
     <startEvent id="startEvent1" name="Invoice Received">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <task id="taskSortByClient1" name="Sort Invoice by Client">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="taskSortByClient1"/>

     <task id="taskSortByVendor1" name="Sort Invoice by Vendor">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow2" sourceRef="taskSortByClient1" targetRef="taskSortByVendor1"/>

     <task id="taskAttachInvoiceEntryForm1" name="Attach Invoice Entry Form">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow4</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow3" sourceRef="taskSortByVendor1" targetRef="taskAttachInvoiceEntryForm1"/>

     <task id="taskEnterRequiredInfo1" name="Enter Required Info">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow5</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow4" sourceRef="taskAttachInvoiceEntryForm1" targetRef="taskEnterRequiredInfo1"/>

     <task id="taskCheckCompleteness1" name="Check Completeness">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow6</outgoing>
       <outgoing>sequenceFlow14</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow5" sourceRef="taskEnterRequiredInfo1" targetRef="taskCheckCompleteness1"/>

     <exclusiveGateway id="exclusiveGateway11">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow7</outgoing>
       <outgoing>sequenceFlow8</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow6" sourceRef="taskCheckCompleteness1" targetRef="exclusiveGateway11"/>

     <endEvent id="endEventNotCompleted1" name="Invoice Not Completed">
       <incoming>sequenceFlow7</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow7" sourceRef="exclusiveGateway11" targetRef="endEventNotCompleted1"/>

     <task id="taskSendMessage1" name="Send Message">
       <incoming>sequenceFlow8</incoming>
       <outgoing>sequenceFlow9</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow8" sourceRef="exclusiveGateway11" targetRef="taskSendMessage1"/>

     <endEvent id="endEventNotCompleted2" name="End">
       <incoming>sequenceFlow9</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow9" sourceRef="taskSendMessage1" targetRef="endEventNotCompleted2"/>

     <exclusiveGateway id="exclusiveGateway21">
       <incoming>sequenceFlow14</incoming>
       <outgoing>sequenceFlow15</outgoing>
       <outgoing>sequenceFlow16</outgoing>
       <outgoing>sequenceFlow17</outgoing>
       <outgoing>sequenceFlow18</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow14" sourceRef="taskCheckCompleteness1" targetRef="exclusiveGateway21"/>

     <task id="taskApplyRedStamp1" name="Apply Red Stamp">
       <incoming>sequenceFlow15</incoming>
       <outgoing>sequenceFlow19</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow15" sourceRef="exclusiveGateway21" targetRef="taskApplyRedStamp1"/>

     <task id="taskCheckCompliance1" name="Check Compliance">
       <incoming>sequenceFlow19</incoming>
       <outgoing>sequenceFlow20</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow19" sourceRef="taskApplyRedStamp1" targetRef="taskCheckCompliance1"/>

     <endEvent id="endEventCompleted1" name="Invoice Processed">
       <incoming>sequenceFlow20</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow20" sourceRef="taskCheckCompliance1" targetRef="endEventCompleted1"/>

     <task id="taskSendToExperienceStaff1" name="Send to Experience Staff">
       <incoming>sequenceFlow16</incoming>
       <outgoing>sequenceFlow21</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow16" sourceRef="exclusiveGateway21" targetRef="taskSendToExperienceStaff1"/>

     <task id="taskCallClient1" name="Call Client">
       <incoming>sequenceFlow17</incoming>
       <outgoing>sequenceFlow22</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow17" sourceRef="exclusiveGateway21" targetRef="taskCallClient1"/>

     <intermediateCatchEvent id="intermediateCatchEvent10hours1">
       <incoming>sequenceFlow22</incoming>
       <outgoing>sequenceFlow23</outgoing>
       <timerEventDefinition/>
     </intermediateCatchEvent>

     <sequenceFlow id="sequenceFlow22" sourceRef="taskCallClient1" targetRef="intermediateCatchEvent10hours1"/>

     <task id="taskSendPostalMail1" name="Send Postal Mail">
       <incoming>sequenceFlow18</incoming>
       <outgoing>sequenceFlow24</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow18" sourceRef="exclusiveGateway21" targetRef="taskSendPostalMail1"/>

     <serviceTask id="allocateToDEO1" name="Allocate to DEO">
       <incoming>sequenceFlow21</incoming>
       <incoming>sequenceFlow23</incoming>
       <incoming>sequenceFlow24</incoming>
       <outgoing>sequenceFlow25</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlow21" sourceRef="taskSendToExperienceStaff1" targetRef="allocateToDEO1"/>
     <sequenceFlow id="sequenceFlow23" sourceRef="intermediateCatchEvent10hours1" targetRef="allocateToDEO1"/>
     <sequenceFlow id="sequenceFlow24" sourceRef="taskSendPostalMail1" targetRef="allocateToDEO1"/>

     <endEvent id="EndAllocate1">
       <incoming>sequenceFlow25</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow25" sourceRef="allocateToDEO1" targetRef="EndAllocate1"/>
   </process>
</definitions>