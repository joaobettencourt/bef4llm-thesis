<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://example.com/bpmn">

  <process id="accountCreationProcess" isExecutable="true">
    <laneSet>
      <lane id="customerLane" name="Bank Customer">
        <flowNodeRef>StartEvent_1</flowNodeRef>
        <flowNodeRef>Task_1</flowNodeRef>
        <flowNodeRef>Task_2</flowNodeRef>
        <flowNodeRef>Task_3</flowNodeRef>
      </lane>
      <lane id="postOfficeLane" name="Post Office">
        <flowNodeRef>Task_4</flowNodeRef>
      </lane>
      <lane id="bankOfficerLane" name="Bank Officer">
        <flowNodeRef>Gateway_1</flowNodeRef>
        <flowNodeRef>Task_5</flowNodeRef>
        <flowNodeRef>EndEvent_Success</flowNodeRef>
        <flowNodeRef>EndEvent_Failure</flowNodeRef>
      </lane>
    </laneSet>

    <startEvent id="StartEvent_1" name="Customer starts account creation">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>

    <task id="Task_1" name="Fill in personal data and generate PDF">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>

    <task id="Task_2" name="Print and send PDF to post office">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="Task_2"/>

    <task id="Task_3" name="Customer sends PDF to post office">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_4</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_3" sourceRef="Task_2" targetRef="Task_3"/>

    <task id="Task_4" name="Post office checks identity and mails request to bank">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_5</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_4" sourceRef="Task_3" targetRef="Task_4"/>

    <sequenceFlow id="SequenceFlow_5" sourceRef="Task_4" targetRef="Gateway_1"/>

    <exclusiveGateway id="Gateway_1">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_6</outgoing>
      <outgoing>SequenceFlow_7</outgoing>
    </exclusiveGateway>

    <task id="Task_5" name="Evaluate account request and accept">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_6" sourceRef="Gateway_1" targetRef="Task_5"/>

    <endEvent id="EndEvent_Success" name="Account documents mailed to customer">
      <incoming>SequenceFlow_8</incoming>
    </endEvent>

    <sequenceFlow id="SequenceFlow_8" sourceRef="Task_5" targetRef="EndEvent_Success"/>

    <task id="Task_6" name="Evaluate account request and reject">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_9</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_7" sourceRef="Gateway_1" targetRef="Task_6"/>

    <endEvent id="EndEvent_Failure" name="Letter of refusal mailed to customer">
      <incoming>SequenceFlow_9</incoming>
    </endEvent>

    <sequenceFlow id="SequenceFlow_9" sourceRef="Task_6" targetRef="EndEvent_Failure"/>
  </process>
</definitions>