<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/pecg/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/pecg/20100524/MODEL BPMN20.xsd"
             targetNamespace="http://example.com/hardwareRequestProcess"
             id="hardwareRequestProcessDefinition" name="Hardware Request Process">

   <process id="hardwareRequestProcess" isExecutable="true">
     <startEvent id="requestReceived" name="Request for New Hardware Received">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <task id="analyseRequestTask" name="Analyse Request">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
       <outgoing>sequenceFlow3</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow1" sourceRef="requestReceived" targetRef="analyseRequestTask"/>

     <exclusiveGateway id="approvalGateway" name="Request Approved?">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow4</outgoing>
       <outgoing>sequenceFlow5</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow2" sourceRef="analyseRequestTask" targetRef="approvalGateway"/>

     <task id="informEmployeeTask" name="Inform Employee via Email">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow6</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow5" sourceRef="approvalGateway" targetRef="informEmployeeTask"/>

     <endEvent id="processEndedDenied" name="Process Ended (Denied)">
       <incoming>sequenceFlow6</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow6" sourceRef="informEmployeeTask" targetRef="processEndedDenied"/>

     <task id="editRequestTask" name="Edit and Complete Request">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow7</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow4" sourceRef="approvalGateway" targetRef="editRequestTask"/>

     <task id="sendEmailToSupplierTask" name="Send Email to Supplier for Prices">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow8</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow7" sourceRef="editRequestTask" targetRef="sendEmailToSupplierTask"/>

     <intermediateCatchEvent id="receiveOfferEvent" name="Receive Offer from Supplier">
       <incoming>sequenceFlow8</incoming>
       <outgoing>sequenceFlow9</outgoing>
     </intermediateCatchEvent>

     <sequenceFlow id="sequenceFlow8" sourceRef="sendEmailToSupplierTask" targetRef="receiveOfferEvent"/>

     <task id="fillFormAndSendToManagementTask" name="Fill Form and Send to Management">
       <incoming>sequenceFlow9</incoming>
       <outgoing>sequenceFlow10</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow9" sourceRef="receiveOfferEvent" targetRef="fillFormAndSendToManagementTask"/>

     <exclusiveGateway id="managementApprovalGateway" name="Management Approved?">
       <incoming>sequenceFlow10</incoming>
       <outgoing>sequenceFlow11</outgoing>
       <outgoing>sequenceFlow12</outgoing>
       <outgoing>sequenceFlow13</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow10" sourceRef="fillFormAndSendToManagementTask" targetRef="managementApprovalGateway"/>

     <task id="forwardToFinancialDeptTask" name="Forward to Financial Department">
       <incoming>sequenceFlow11</incoming>
       <outgoing>sequenceFlow14</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow11" sourceRef="managementApprovalGateway" targetRef="forwardToFinancialDeptTask"/>

     <intermediateCatchEvent id="receiveHardwareEvent" name="Receive Hardware">
       <incoming>sequenceFlow16</incoming>
       <outgoing>sequenceFlow17</outgoing>
     </intermediateCatchEvent>

     <task id="prepareOrderAndSendToSupplierTask" name="Prepare Order and Send to Supplier">
       <incoming>sequenceFlow14</incoming>
       <outgoing>sequenceFlow15</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow14" sourceRef="forwardToFinancialDeptTask" targetRef="prepareOrderAndSendToSupplierTask"/>

     <sequenceFlow id="sequenceFlow15" sourceRef="prepareOrderAndSendToSupplierTask" targetRef="receiveHardwareEvent"/>

     <task id="financialDepartmentHandleInvoiceTask" name="Financial Department Handle Invoice">
       <incoming>sequenceFlow17</incoming>
       <outgoing>sequenceFlow18</outgoing>
     </task>

     <endEvent id="processEndedSuccess" name="Process Ended (Successful)">
       <incoming>sequenceFlow18</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow17" sourceRef="receiveHardwareEvent" targetRef="financialDepartmentHandleInvoiceTask"/>

     <sequenceFlow id="sequenceFlow18" sourceRef="financialDepartmentHandleInvoiceTask" targetRef="processEndedSuccess"/>

     <sequenceFlow id="sequenceFlow12" sourceRef="managementApprovalGateway" targetRef="sendRequestBackToITask"/>

     <task id="sendRequestBackToITask" name="Send Request Back to IT for Rework">
       <incoming>sequenceFlow12</incoming>
       <outgoing>sequenceFlow19</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow19" sourceRef="sendRequestBackToITask" targetRef="editRequestTask"/>

     <endEvent id="processEndedDeniedManagement" name="Process Ended (Denied by Management)">
       <incoming>sequenceFlow13</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow13" sourceRef="managementApprovalGateway" targetRef="processEndedDeniedManagement"/>
   </process>
</definitions>