<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/BPMN20.xsd"
             id="definition" name="Order Fulfillment Process" targetNamespace="http://example.com">

    <process id="orderFulfillmentProcess" isExecutable="true">
      <startEvent id="reviewOrder" name="Review Order">
        <outgoing>sequenceFlow1</outgoing>
      </startEvent>

      <sequenceFlow id="sequenceFlow1" sourceRef="reviewOrder" targetRef="checkItemAvailability"/>

      <task id="checkItemAvailability" name="Check Item Availability">
        <incoming>sequenceFlow1</incoming>
        <outgoing>sequenceFlow2</outgoing>
      </task>

      <sequenceFlow id="sequenceFlow2" sourceRef="checkItemAvailability" targetRef="itemAvailabilityGateway"/>

      <exclusiveGateway id="itemAvailabilityGateway" name="Check Item Availability">
        <incoming>sequenceFlow2</incoming>
        <outgoing>sequenceFlow3</outgoing>
        <outgoing>sequenceFlow4</outgoing>
      </exclusiveGateway>

      <sequenceFlow id="sequenceFlow3" sourceRef="itemAvailabilityGateway" targetRef="collectProducts">
      </sequenceFlow>

      <sequenceFlow id="sequenceFlow4" sourceRef="itemAvailabilityGateway" targetRef="informCustomerOfDelay">
      </sequenceFlow>

      <task id="informCustomerOfDelay" name="Inform Customer of Delay and Order Missing Products">
        <incoming>sequenceFlow4</incoming>
        <outgoing>sequenceFlow5</outgoing>
      </task>

      <serviceTask id="waitForDelivery" name="Wait for Delivery (x days)">
        <incoming>sequenceFlow5</incoming>
        <outgoing>sequenceFlow6</outgoing>
      </serviceTask>

      <sequenceFlow id="sequenceFlow5" sourceRef="informCustomerOfDelay" targetRef="waitForDelivery"/>

      <sequenceFlow id="sequenceFlow6" sourceRef="waitForDelivery" targetRef="checkItemAvailabilityAgain"/>

      <task id="collectProducts" name="Collect Products and Prepare Package">
        <incoming>sequenceFlow3</incoming>
        <outgoing>sequenceFlow7</outgoing>
      </task>

      <task id="informCourier" name="Inform Courier about Pre-processed Package">
        <incoming>sequenceFlow7</incoming>
        <outgoing>sequenceFlow8</outgoing>
      </task>

      <sequenceFlow id="sequenceFlow7" sourceRef="collectProducts" targetRef="informCourier"/>

      <sequenceFlow id="sequenceFlow8" sourceRef="informCourier" targetRef="pickupByDriver"/>

      <task id="pickupByDriver" name="Package Picked up by Driver">
        <incoming>sequenceFlow8</incoming>
        <outgoing>sequenceFlow9</outgoing>
      </task>

      <serviceTask id="routeOptimization" name="Centralized Service Optimizes Route for All Drivers' Packages">
        <incoming>sequenceFlow9</incoming>
        <outgoing>sequenceFlow10</outgoing>
      </serviceTask>

      <sequenceFlow id="sequenceFlow9" sourceRef="pickupByDriver" targetRef="routeOptimization"/>

      <sequenceFlow id="sequenceFlow10" sourceRef="routeOptimization" targetRef="updateSystem"/>

      <task id="checkItemAvailabilityAgain" name="Check Item Availability Again">
        <incoming>sequenceFlow6</incoming>
        <outgoing>sequenceFlow11</outgoing>
      </task>

      <sequenceFlow id="sequenceFlow11" sourceRef="checkItemAvailabilityAgain" targetRef="itemAvailabilityGateway"/>

      <task id="updateSystem" name="Update System to Notify All Stakeholders">
        <incoming>sequenceFlow10</incoming>
        <outgoing>sequenceFlow12</outgoing>
      </task>

      <endEvent id="endEvent" name="Order Delivered">
        <incoming>sequenceFlow12</incoming>
      </endEvent>

      <sequenceFlow id="sequenceFlow12" sourceRef="updateSystem" targetRef="endEvent"/>
    </process>
</definitions>