<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">

   <process id="officeSupplyRequestProcess" isExecutable="true">
     <laneSet>
       <lane id="employeeLane" name="Employee">
         <flowNodeRef>startEvent</flowNodeRef>
         <flowNodeRef>registerOfficeSupplyRequestTask</flowNodeRef>
         <flowNodeRef>receiveProductsTask</flowNodeRef>
       </lane>
       <lane id="supervisorLane" name="Supervisor">
         <flowNodeRef>approveOfficeSupplyRequestTask</flowNodeRef>
         <flowNodeRef>exclusiveGateway1</flowNodeRef>
         <flowNodeRef>notifyAboutRequiredChangeTask</flowNodeRef>
         <flowNodeRef>notifyAboutRejectionTask</flowNodeRef>
       </lane>
       <lane id="purchaseDepartmentLane" name="Purchase Department">
         <flowNodeRef>makeQuotationsAndSelectVendorSubProcess</flowNodeRef>
         <flowNodeRef>generatePurchaseOrderTask</flowNodeRef>
         <flowNodeRef>processInvoiceTask</flowNodeRef>
       </lane>
     </laneSet>

     <startEvent id="startEvent">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent" targetRef="registerOfficeSupplyRequestTask"/>

     <task id="registerOfficeSupplyRequestTask" name="Register office supply request">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow2" sourceRef="registerOfficeSupplyRequestTask" targetRef="approveOfficeSupplyRequestTask"/>

     <task id="approveOfficeSupplyRequestTask" name="Approve office supply request">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
     </task>

     <exclusiveGateway id="exclusiveGateway1">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow4</outgoing>
       <outgoing>sequenceFlow5</outgoing>
       <outgoing>sequenceFlow6</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow3" sourceRef="approveOfficeSupplyRequestTask" targetRef="exclusiveGateway1"/>

     <sequenceFlow id="sequenceFlow4" name="Approve" sourceRef="exclusiveGateway1" targetRef="makeQuotationsAndSelectVendorSubProcess">
       <conditionExpression xsi:type="tFormalExpression">${approved = true}</conditionExpression>
     </sequenceFlow>

     <subProcess id="makeQuotationsAndSelectVendorSubProcess">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow7</outgoing>
     </subProcess>

     <sequenceFlow id="sequenceFlow7" sourceRef="makeQuotationsAndSelectVendorSubProcess" targetRef="generatePurchaseOrderTask"/>

     <task id="generatePurchaseOrderTask" name="Generate purchase order">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow8</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow8" sourceRef="generatePurchaseOrderTask" targetRef="processInvoiceTask"/>

     <task id="processInvoiceTask" name="Process invoice">
       <incoming>sequenceFlow8</incoming>
       <outgoing>sequenceFlow9</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow9" sourceRef="processInvoiceTask" targetRef="receiveProductsTask"/>

     <task id="receiveProductsTask" name="Receive products">
       <incoming>sequenceFlow9</incoming>
     </task>

     <sequenceFlow id="sequenceFlow5" name="Reject" sourceRef="exclusiveGateway1" targetRef="notifyAboutRejectionTask">
       <conditionExpression xsi:type="tFormalExpression">${rejected = true}</conditionExpression>
     </sequenceFlow>

     <task id="notifyAboutRejectionTask" name="Notify about rejection">
       <incoming>sequenceFlow5</incoming>
     </task>

     <sequenceFlow id="sequenceFlow6" name="Request Change" sourceRef="exclusiveGateway1" targetRef="notifyAboutRequiredChangeTask">
       <conditionExpression xsi:type="tFormalExpression">${changeRequested = true}</conditionExpression>
     </sequenceFlow>

     <task id="notifyAboutRequiredChangeTask" name="Notify about required change">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow10</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow10" sourceRef="notifyAboutRequiredChangeTask" targetRef="registerOfficeSupplyRequestTask"/>

     <endEvent id="endEvent1">
       <incoming>sequenceFlow9</incoming>
     </endEvent>
   </process>
</definitions>