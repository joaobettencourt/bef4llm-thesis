<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
                 id="definitions" targetNamespace="http://www.example.com">

  <bpmn:process id="claimHandlingProcess" isExecutable="true">
    <bpmn:startEvent id="startEvent">
      <bpmn:outgoing>sequenceFlow1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:sequenceFlow id="sequenceFlow1" sourceRef="startEvent" targetRef="task1"/>

    <bpmn:task id="task1" name="Send questionnaire">
      <bpmn:incoming>sequenceFlow1</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="sequenceFlow2" sourceRef="task1" targetRef="eventBasedGateway1"/>

    <bpmn:eventBasedGateway id="eventBasedGateway1">
      <bpmn:incoming>sequenceFlow2</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow3</bpmn:outgoing>
      <bpmn:outgoing>sequenceFlow4</bpmn:outgoing>
    </bpmn:eventBasedGateway>

    <bpmn:intermediateCatchEvent id="intermediateMessageEvent1" name="Filled questionnaire received">
      <bpmn:incoming>sequenceFlow3</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow5</bpmn:outgoing>
      <bpmn:messageEventDefinition/>
    </bpmn:intermediateCatchEvent>

    <bpmn:sequenceFlow id="sequenceFlow3" sourceRef="eventBasedGateway1" targetRef="intermediateMessageEvent1"/>

    <bpmn:intermediateCatchEvent id="intermediateTimerEvent1" name="After 5 Days">
      <bpmn:incoming>sequenceFlow4</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow6</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>PT5D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>

    <bpmn:sequenceFlow id="sequenceFlow4" sourceRef="eventBasedGateway1" targetRef="intermediateTimerEvent1"/>

    <bpmn:task id="task2" name="Send reminder">
      <bpmn:incoming>sequenceFlow6</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow7</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="sequenceFlow6" sourceRef="intermediateTimerEvent1" targetRef="task2"/>

    <bpmn:sequenceFlow id="sequenceFlow7" sourceRef="task2" targetRef="eventBasedGateway1"/>

    <bpmn:endEvent id="endEvent1">
      <bpmn:incoming>sequenceFlow5</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>