<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
                 id="definitions" targetNamespace="http://www.example.com">

  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="MPON" name="MPON" processRef="MPON_process"/>
    <bpmn:participant id="MPOO" name="MPOO" processRef="MPOO_process"/>
    <bpmn:messageFlow id="dismissal_message_flow" sourceRef="MPON_process" targetRef="MPOO_process"/>
  </bpmn:collaboration>

  <bpmn:process id="MPON_process" isExecutable="true">
    <bpmn:startEvent id="start_event">
      <bpmn:outgoing>sequence_flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="send_dismissal_task" name="Send dismissal">
      <bpmn:incoming>sequence_flow_1</bpmn:incoming>
      <bpmn:outgoing>sequence_flow_2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="sequence_flow_1" sourceRef="start_event" targetRef="send_dismissal_task"/>
    <bpmn:sequenceFlow id="sequence_flow_2" sourceRef="send_dismissal_task" targetRef="end_event_MPON"/>

    <bpmn:endEvent id="end_event_MPON">
      <bpmn:incoming>sequence_flow_2</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>

  <bpmn:process id="MPOO_process" isExecutable="true">
    <bpmn:startEvent id="start_event_MPOO">
      <bpmn:outgoing>sequence_flow_3</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="review_dismissal_task" name="Review dismissal">
      <bpmn:incoming>sequence_flow_3</bpmn:incoming>
      <bpmn:outgoing>sequence_flow_4</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="exclusive_gateway">
      <bpmn:incoming>sequence_flow_4</bpmn:incoming>
      <bpmn:outgoing>sequence_flow_5</bpmn:outgoing>
      <bpmn:outgoing>sequence_flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="oppose_dismissal_task" name="Oppose dismissal">
      <bpmn:incoming>sequence_flow_5</bpmn:incoming>
      <bpmn:outgoing>sequence_flow_7</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="confirm_dismissal_task" name="Confirm dismissal">
      <bpmn:incoming>sequence_flow_6</bpmn:incoming>
      <bpmn:outgoing>sequence_flow_8</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="end_event_oppose">
      <bpmn:incoming>sequence_flow_7</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="end_event_confirm">
      <bpmn:incoming>sequence_flow_8</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="sequence_flow_3" sourceRef="start_event_MPOO" targetRef="review_dismissal_task"/>
    <bpmn:sequenceFlow id="sequence_flow_4" sourceRef="review_dismissal_task" targetRef="exclusive_gateway"/>
    <bpmn:sequenceFlow id="sequence_flow_5" sourceRef="exclusive_gateway" targetRef="oppose_dismissal_task"/>
    <bpmn:sequenceFlow id="sequence_flow_6" sourceRef="exclusive_gateway" targetRef="confirm_dismissal_task"/>
    <bpmn:sequenceFlow id="sequence_flow_7" sourceRef="oppose_dismissal_task" targetRef="end_event_oppose"/>
    <bpmn:sequenceFlow id="sequence_flow_8" sourceRef="confirm_dismissal_task" targetRef="end_event_confirm"/>
  </bpmn:process>
</bpmn:definitions>