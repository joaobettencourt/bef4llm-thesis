<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">

   <process id="orderProcess" isExecutable="true">
     <startEvent id="startEvent">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent" targetRef="exclusiveGateway1"/>

     <exclusiveGateway id="exclusiveGateway1">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
       <outgoing>sequenceFlow3</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow2" sourceRef="exclusiveGateway1" targetRef="endEvent1">
       <conditionExpression xsi:type="tFormalExpression">${orderRejected}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="sequenceFlow3" sourceRef="exclusiveGateway1" targetRef="task1"/>

     <task id="task1" name="Inform storehouse and engineering department">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow4</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow4" sourceRef="task1" targetRef="parallelGateway1"/>

     <parallelGateway id="parallelGateway1">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow5</outgoing>
       <outgoing>sequenceFlow6</outgoing>
     </parallelGateway>

     <sequenceFlow id="sequenceFlow5" sourceRef="parallelGateway1" targetRef="subProcess1"/>

     <subProcess id="subProcess1">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow7</outgoing>
       <startEvent id="startEvent2">
         <outgoing>sequenceFlow8</outgoing>
       </startEvent>

       <sequenceFlow id="sequenceFlow8" sourceRef="startEvent2" targetRef="task2"/>

       <task id="task2" name="Process part list">
         <incoming>sequenceFlow8</incoming>
         <outgoing>sequenceFlow9</outgoing>
       </task>

       <sequenceFlow id="sequenceFlow9" sourceRef="task2" targetRef="exclusiveGateway2"/>

       <exclusiveGateway id="exclusiveGateway2">
         <incoming>sequenceFlow9</incoming>
         <outgoing>sequenceFlow10</outgoing>
         <outgoing>sequenceFlow11</outgoing>
       </exclusiveGateway>

       <sequenceFlow id="sequenceFlow10" sourceRef="exclusiveGateway2" targetRef="task3">
         <conditionExpression xsi:type="tFormalExpression">${partAvailable}</conditionExpression>
       </sequenceFlow>

       <sequenceFlow id="sequenceFlow11" sourceRef="exclusiveGateway2" targetRef="task4"/>

       <task id="task3" name="Reserve part">
         <incoming>sequenceFlow10</incoming>
         <outgoing>sequenceFlow12</outgoing>
       </task>

       <sequenceFlow id="sequenceFlow12" sourceRef="task3" targetRef="endEvent2"/>

       <task id="task4" name="Back-order part">
         <incoming>sequenceFlow11</incoming>
         <outgoing>sequenceFlow13</outgoing>
       </task>

       <sequenceFlow id="sequenceFlow13" sourceRef="task4" targetRef="endEvent2"/>

       <endEvent id="endEvent2">
         <incoming>sequenceFlow12</incoming>
         <incoming>sequenceFlow13</incoming>
       </endEvent>
     </subProcess>

     <sequenceFlow id="sequenceFlow7" sourceRef="subProcess1" targetRef="exclusiveGateway3"/>

     <exclusiveGateway id="exclusiveGateway3">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow14</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow14" sourceRef="exclusiveGateway3" targetRef="parallelGateway2"/>

     <sequenceFlow id="sequenceFlow6" sourceRef="parallelGateway1" targetRef="task5"/>

     <task id="task5" name="Prepare for assembling">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow15</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow15" sourceRef="task5" targetRef="endEvent3"/>

     <parallelGateway id="parallelGateway2">
       <incoming>sequenceFlow14</incoming>
       <outgoing>sequenceFlow16</outgoing>
     </parallelGateway>

     <sequenceFlow id="sequenceFlow16" sourceRef="parallelGateway2" targetRef="task6">

     </task6>

     <endEvent id="endEvent1">
       <incoming>sequenceFlow2</incoming>
     </endEvent>

     <endEvent id="endEvent3">
       <incoming>sequenceFlow15</incoming>
     </endEvent>
   </process>
</definitions>