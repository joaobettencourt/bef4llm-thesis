<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">

  <process id="roomServiceProcess" isExecutable="true">
    <laneSet>
      <lane id="roomServiceManagerLane" name="Room-Service Manager">
        <flowNodeRef>startEvent</flowNodeRef>
        <flowNodeRef>taskTakeDownOrder</flowNodeRef>
        <flowNodeRef>parallelGateway1</flowNodeRef>
        <flowNodeRef>taskAssignOrderToWaiter</flowNodeRef>
        <flowNodeRef>exclusiveGateway1</flowNodeRef>
      </lane>
    </laneSet>

    <sequenceFlow id="sfTakeDownOrder" sourceRef="startEvent" targetRef="taskTakeDownOrder"/>
    
    <startEvent id="startEvent">
      <outgoing>sfTakeDownOrder</outgoing>
    </startEvent>

    <task id="taskTakeDownOrder" name="Take down order">
      <incoming>sfTakeDownOrder</incoming>
      <outgoing>sfSubmitOrderTicket</outgoing>
    </task>

    <sequenceFlow id="sfSubmitOrderTicket" sourceRef="taskTakeDownOrder" targetRef="taskSubmitOrderTicketToKitchen"/>

    <task id="taskSubmitOrderTicketToKitchen" name="Submit order ticket to kitchen">
      <incoming>sfSubmitOrderTicket</incoming>
      <outgoing>sfPrepareMeal</outgoing>
    </task>

    <sequenceFlow id="sfPrepareMeal" sourceRef="taskSubmitOrderTicketToKitchen" targetRef="exclusiveGateway1"/>

    <exclusiveGateway id="exclusiveGateway1">
      <incoming>sfPrepareMeal</incoming>
      <outgoing>sfGiveOrderToSommelier</outgoing>
      <outgoing>sfNoAlcoholicBeverages</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sfGiveOrderToSommelier" sourceRef="exclusiveGateway1" targetRef="taskGiveOrderToSommelier">
      <conditionExpression xsi:type="tFormalExpression">${orderIncludesAlcohol}</conditionExpression>
    </sequenceFlow>

    <task id="taskGiveOrderToSommelier" name="Give order to sommelier">
      <incoming>sfGiveOrderToSommelier</incoming>
      <outgoing>sfPrepareAlcoholicBeverages</outgoing>
    </task>

    <sequenceFlow id="sfPrepareAlcoholicBeverages" sourceRef="taskGiveOrderToSommelier" targetRef="parallelGateway1"/>

    <task id="taskPrepareAlcoholicBeverages" name="Prepare alcoholic beverages">
      <incoming>sfPrepareAlcoholicBeverages</incoming>
    </task>

    <sequenceFlow id="sfNoAlcoholicBeverages" sourceRef="exclusiveGateway1" targetRef="parallelGateway1"/>

    <parallelGateway id="parallelGateway1">
      <incoming>sfGiveOrderToSommelier</incoming>
      <incoming>sfNoAlcoholicBeverages</incoming>
      <outgoing>sfReadyCart</outgoing>
      <outgoing>sfPrepareNonAlcoholicDrinks</outgoing>
    </parallelGateway>

    <task id="taskAssignOrderToWaiter" name="Assign order to waiter">
      <incoming>sfParallelGateway2</incoming>
    </task>

    <sequenceFlow id="sfParallelGateway2" sourceRef="taskTakeDownOrder" targetRef="taskAssignOrderToWaiter"/>

    <task id="taskReadyCart" name="Ready cart">
      <incoming>sfReadyCart</incoming>
    </task>

    <sequenceFlow id="sfReadyCart" sourceRef="parallelGateway1" targetRef="taskReadyCart"/>

    <exclusiveGateway id="exclusiveGateway2">
      <outgoing>sfPrepareNonAlcoholicDrinks</outgoing>
      <outgoing>sfNoNonAlcoholicDrinks</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sfPrepareNonAlcoholicDrinks" sourceRef="parallelGateway1" targetRef="exclusiveGateway2"/>

    <task id="taskPrepareNonAlcoholicDrinks" name="Prepare non-alcoholic drinks">
      <incoming>sfPrepareNonAlcoholicDrinks</incoming>
    </task>

    <sequenceFlow id="sfNoNonAlcoholicDrinks" sourceRef="exclusiveGateway2" targetRef="taskDeliverToGuestsRoom"/>

    <task id="taskDeliverToGuestsRoom" name="Deliver to guest's room">
      <outgoing>sfDebitGuestsAccount</outgoing>
    </task>

    <sequenceFlow id="sfDebitGuestsAccount" sourceRef="taskDeliverToGuestsRoom" targetRef="endEvent"/>
    
    <task id="taskDebitGuestsAccount" name="Debit guest's account">
      <incoming>sfDebitGuestsAccount</incoming>
    </task>

    <endEvent id="endEvent">
      <incoming>sfDebitGuestsAccount</incoming>
    </endEvent>
  </process>
</definitions>