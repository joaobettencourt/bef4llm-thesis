<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">

   <process id="shipmentProcess" isExecutable="true">
     <startEvent id="startEvent1">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="task_ClarifyShipmentMethod"/>

     <task id="task_ClarifyShipmentMethod" name="Clarify shipment method">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </task>

     <exclusiveGateway id="exclusiveGateway_SpecialHandling">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
       <outgoing>sequenceFlow4</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow2" sourceRef="task_ClarifyShipmentMethod" targetRef="exclusiveGateway_SpecialHandling"/>

     <sequenceFlow id="sequenceFlow3" sourceRef="exclusiveGateway_SpecialHandling" targetRef="task_GetOffers">
       <conditionExpression xsi:type="tFormalExpression">${shipmentType  ==  'special'}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="sequenceFlow4" sourceRef="exclusiveGateway_SpecialHandling" targetRef="task_WritePackageLabel">
       <conditionExpression xsi:type="tFormalExpression">${shipmentType  ==  'normal'}</conditionExpression>
     </sequenceFlow>

     <task id="task_GetOffers" name="Get 3 offers from logistic companies">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow5</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow5" sourceRef="task_GetOffers" targetRef="task_SelectLogisticCompany"/>

     <task id="task_SelectLogisticCompany" name="Select logistic company and place order">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow6</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow6" sourceRef="task_SelectLogisticCompany" targetRef="parallelGateway_PackageGoods"/>

     <task id="task_WritePackageLabel" name="Write package label">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow7</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow7" sourceRef="task_WritePackageLabel" targetRef="inclusiveGateway_Insurance"/>

     <inclusiveGateway id="inclusiveGateway_Insurance">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow8</outgoing>
     </inclusiveGateway>

     <task id="task_InsureParcel" name="Insure parcel">
       <incoming>sequenceFlow8</incoming>
       <!-- outgoing sequence flow to end event -->
     </task>

     <parallelGateway id="parallelGateway_PackageGoods">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow9</outgoing>
       <outgoing>sequenceFlow10</outgoing>
     </parallelGateway>

     <task id="task_PackageGoods" name="Package goods">
       <incoming>sequenceFlow9</incoming>
       <outgoing>sequenceFlow11</outgoing>
     </task>

     <exclusiveGateway id="exclusiveGateway_PrepareForPickup">
       <incoming>sequenceFlow11</incoming>
       <outgoing>sequenceFlow12</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow10" sourceRef="parallelGateway_PackageGoods" targetRef="task_InsureParcel"/>
     <sequenceFlow id="sequenceFlow11" sourceRef="task_PackageGoods" targetRef="exclusiveGateway_PrepareForPickup"/>

     <task id="task_PrepareForPickup" name="Prepare for picking up goods">
       <incoming>sequenceFlow12</incoming>
       <!-- outgoing sequence flow to end event -->
     </task>

     <endEvent id="endEvent_ShipmentPrepared">
       <!-- incoming sequence flows  -->
     </endEvent>

     <sequenceFlow id="sequenceFlow12" sourceRef="exclusiveGateway_PrepareForPickup" targetRef="task_PrepareForPickup"/>

   </process>
</definitions>