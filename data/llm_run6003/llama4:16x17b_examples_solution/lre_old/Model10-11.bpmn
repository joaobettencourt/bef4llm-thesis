<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">

   <collaboration id="collaboration">
     <participant id="MSP" name="MSP" processRef="MSPProcess"/>
     <participant id="GO" name="GO" processRef="GOProcess"/>
     <messageFlow id="MF1" sourceRef="Task_GO_RequestMeasurements" targetRef="StartEvent_MSP_CheckRequest"/>
     <messageFlow id="MF2" sourceRef="Task_MSP_TransmitMeasuredValues" targetRef="IntermediateCatchEvent_GO_ReceiveMeasuredValues"/>
     <messageFlow id="MF3" sourceRef="Task_GO_SendChangedValues" targetRef="Task_MSP_UpdateValues"/>

   </collaboration>

   <process id="MSPProcess" isExecutable="true">
     <startEvent id="StartEvent_MSP_CheckRequest">
       <incoming>MF1</incoming>
       <outgoing>SequenceFlow_MSP_CheckRequest</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_MSP_CheckRequest" sourceRef="StartEvent_MSP_CheckRequest" targetRef="ExclusiveGateway_MSP_Decision"/>

     <exclusiveGateway id="ExclusiveGateway_MSP_Decision">
       <incoming>SequenceFlow_MSP_CheckRequest</incoming>
       <outgoing>SequenceFlow_MSP_RejectRequest</outgoing>
       <outgoing>SequenceFlow_MSP_PerformMeasurement</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_MSP_RejectRequest" sourceRef="ExclusiveGateway_MSP_Decision" targetRef="Task_MSP_InformeFailure">
       <!--<conditionExpression xsi:type="tFormalExpression">${requestValid  == false}</conditionExpression>-->
     </sequenceFlow>

     <task id="Task_MSP_InformeFailure" name="Inform about the failure of the reading">
       <incoming>SequenceFlow_MSP_RejectRequest</incoming>
       <!--<outgoing>MF2</outgoing>-->
     </task>

     <sequenceFlow id="SequenceFlow_MSP_PerformMeasurement" sourceRef="ExclusiveGateway_MSP_Decision" targetRef="Task_MSP_PerformMeasurement">
       <!--<conditionExpression xsi:type="tFormalExpression">${requestValid  == true}</conditionExpression>-->
     </sequenceFlow>

     <task id="Task_MSP_PerformMeasurement" name="Perform measurement">
       <incoming>SequenceFlow_MSP_PerformMeasurement</incoming>
       <outgoing>SequenceFlow_MSP_TransmitMeasuredValues</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_MSP_TransmitMeasuredValues" sourceRef="Task_MSP_PerformMeasurement" targetRef="Task_MSP_TransmitMeasuredValues"/>

     <task id="Task_MSP_TransmitMeasuredValues" name="Transmit measured values">
       <incoming>SequenceFlow_MSP_TransmitMeasuredValues</incoming>
       <outgoing>MF2</outgoing>
     </task>

     <task id="Task_MSP_UpdateValues" name="Update Values">
       <!--<incoming>MF3</incoming>-->
     </task>

   </process>

   <process id="GOProcess" isExecutable="true">
     <startEvent id="StartEvent_GO_RequestMeasurements">
       <outgoing>SequenceFlow_GO_RequestMeasurements</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_GO_RequestMeasurements" sourceRef="StartEvent_GO_RequestMeasurements" targetRef="Task_GO_RequestMeasurements"/>

     <task id="Task_GO_RequestMeasurements" name="Request measurements">
       <incoming>SequenceFlow_GO_RequestMeasurements</incoming>
       <outgoing>MF1</outgoing>
     </task>

     <intermediateCatchEvent id="IntermediateCatchEvent_GO_ReceiveMeasuredValues">
       <incoming>MF2</incoming>
       <outgoing>SequenceFlow_GO_ProcessMeasuredValues</outgoing>
     </intermediateCatchEvent>

     <sequenceFlow id="SequenceFlow_GO_ProcessMeasuredValues" sourceRef="IntermediateCatchEvent_GO_ReceiveMeasuredValues" targetRef="Task_GO_ProcessMeasuredValues"/>

     <task id="Task_GO_ProcessMeasuredValues" name="Process measured values">
       <incoming>SequenceFlow_GO_ProcessMeasuredValues</incoming>
       <outgoing>SequenceFlow_GO_SendChangedValues</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_GO_SendChangedValues" sourceRef="Task_GO_ProcessMeasuredValues" targetRef="Task_GO_SendChangedValues"/>

     <task id="Task_GO_SendChangedValues" name="Send changed values">
       <incoming>SequenceFlow_GO_SendChangedValues</incoming>
       <outgoing>MF3</outgoing>
     </task>

     <intermediateCatchEvent id="IntermediateCatchEvent_GO_UpdateValues">
       <incoming>MF3</incoming>
       <!--<outgoing>SequenceFlow_GO_TransmitReadings</outgoing>-->
     </intermediateCatchEvent>

     <!--<sequenceFlow id="SequenceFlow_GO_TransmitReadings" sourceRef="IntermediateCatchEvent_GO_UpdateValues" targetRef="Task_GO_TransmitReadings"/>-->

     <task id="Task_GO_TransmitReadings" name="Transmit readings to SP">
       <!--<incoming>SequenceFlow_GO_TransmitReadings</incoming>-->
     </task>

   </process>

</definitions>