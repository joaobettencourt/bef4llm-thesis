<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">

   <collaboration id="collaboration">
     <participant id="assemblerAG" name="Assembler AG" processRef="assemblerProcess"/>
     <participant id="supplier" name="Supplier" processRef="supplierProcess"/>
     <messageFlow id="orderMessageFlow" sourceRef="sendOrderTask" targetRef="processOrderTask"/>
     <messageFlow id="invoiceMessageFlow" sourceRef="sendInvoiceTask" targetRef="receiveInvoiceTask"/>
   </collaboration>

   <process id="assemblerProcess" isExecutable="true">
     <startEvent id="startEvent">
       <outgoing>createOrderSequenceFlow</outgoing>
       <timerEventDefinition/>
     </startEvent>

     <sequenceFlow id="createOrderSequenceFlow" sourceRef="startEvent" targetRef="sendOrderTask"/>

     <task id="sendOrderTask" name="Send Order">
       <incoming>createOrderSequenceFlow</incoming>
       <outgoing>receiveInvoiceSequenceFlow</outgoing>
     </task>

     <sequenceFlow id="receiveInvoiceSequenceFlow" sourceRef="sendOrderTask" targetRef="receiveInvoiceTask"/>

     <task id="receiveInvoiceTask" name="Receive Invoice">
       <incoming>receiveInvoiceSequenceFlow</incoming>
       <outgoing>endSequenceFlow</outgoing>
     </task>

     <sequenceFlow id="endSequenceFlow" sourceRef="receiveInvoiceTask" targetRef="endEvent"/>

     <endEvent id="endEvent">
       <incoming>endSequenceFlow</incoming>
     </endEvent>
   </process>

   <process id="supplierProcess" isExecutable="true">
     <startEvent id="startSupplierEvent">
       <outgoing>processOrderSequenceFlow</outgoing>
       <messageEventDefinition messageRef="orderMessage"/>
     </startEvent>

     <sequenceFlow id="processOrderSequenceFlow" sourceRef="startSupplierEvent" targetRef="processOrderTask"/>

     <task id="processOrderTask" name="Process Order">
       <incoming>processOrderSequenceFlow</incoming>
       <outgoing>sendInvoiceSequenceFlow</outgoing>
     </task>

     <sequenceFlow id="sendInvoiceSequenceFlow" sourceRef="processOrderTask" targetRef="sendInvoiceTask"/>

     <task id="sendInvoiceTask" name="Send Invoice">
       <incoming>sendInvoiceSequenceFlow</incoming>
     </task>

     <endEvent id="supplierEndEvent">
     </endEvent>
   </process>

   <message id="orderMessage" name="Order Message"/>
   <message id="invoiceMessage" name="Invoice Message"/>

</definitions>