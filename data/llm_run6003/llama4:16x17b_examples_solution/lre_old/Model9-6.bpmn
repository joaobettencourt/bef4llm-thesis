<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">

  <process id="designProcess" isExecutable="true">
    <startEvent id="startEvent">
      <outgoing>sequenceFlow1</outgoing>
    </startEvent>

    <sequenceFlow id="sequenceFlow1" sourceRef="startEvent" targetRef="task1"/>

    <task id="task1" name="Locate and re-use designs">
      <incoming>sequenceFlow1</incoming>
      <outgoing>sequenceFlow2</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow2" sourceRef="task1" targetRef="parallelGateway1"/>

    <parallelGateway id="parallelGateway1">
      <incoming>sequenceFlow2</incoming>
      <outgoing>sequenceFlow3</outgoing>
      <outgoing>sequenceFlow4</outgoing>
    </parallelGateway>

    <sequenceFlow id="sequenceFlow3" sourceRef="parallelGateway1" targetRef="task2"/>
    <sequenceFlow id="sequenceFlow4" sourceRef="parallelGateway1" targetRef="task3"/>

    <task id="task2" name="Update electrical design">
      <incoming>sequenceFlow3</incoming>
      <outgoing>sequenceFlow5</outgoing>
    </task>

    <task id="task3" name="Update physical design">
      <incoming>sequenceFlow4</incoming>
      <outgoing>sequenceFlow6</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow5" sourceRef="task2" targetRef="exclusiveGateway1"/>
    <sequenceFlow id="sequenceFlow6" sourceRef="task3" targetRef="exclusiveGateway2"/>

    <exclusiveGateway id="exclusiveGateway1">
      <incoming>sequenceFlow5</incoming>
      <outgoing>sequenceFlow7</outgoing>
      <outgoing>sequenceFlow8</outgoing>
    </exclusiveGateway>

    <exclusiveGateway id="exclusiveGateway2">
      <incoming>sequenceFlow6</incoming>
      <outgoing>sequenceFlow9</outgoing>
      <outgoing>sequenceFlow10</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequenceFlow7" sourceRef="exclusiveGateway1" targetRef="task4">
      <conditionExpression xsi:type="tFormalExpression">${designOk}</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="sequenceFlow8" sourceRef="exclusiveGateway1" targetRef="task2">
      <conditionExpression xsi:type="tFormalExpression">${not designOk}</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="sequenceFlow9" sourceRef="exclusiveGateway2" targetRef="task5">
      <conditionExpression xsi:type="tFormalExpression">${designOk}</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="sequenceFlow10" sourceRef="exclusiveGateway2" targetRef="task3">
      <conditionExpression xsi:type="tFormalExpression">${not designOk}</conditionExpression>
    </sequenceFlow>

    <task id="task4" name="Test electrical design">
      <incoming>sequenceFlow7</incoming>
      <outgoing>sequenceFlow11</outgoing>
    </task>

    <task id="task5" name="Test physical design">
      <incoming>sequenceFlow9</incoming>
      <outgoing>sequenceFlow12</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow11" sourceRef="task4" targetRef="intermediateThrowEvent1"/>
    <sequenceFlow id="sequenceFlow12" sourceRef="task5" targetRef="parallelGateway2"/>

    <intermediateThrowEvent id="intermediateThrowEvent1">
      <incoming>sequenceFlow11</incoming>
      <outgoing>sequenceFlow13</outgoing>
      <signalEventDefinition/>
    </intermediateThrowEvent>

    <parallelGateway id="parallelGateway2">
      <incoming>sequenceFlow12</incoming>
      <incoming>sequenceFlow13</incoming>
      <outgoing>sequenceFlow14</outgoing>
    </parallelGateway>

    <sequenceFlow id="sequenceFlow13" sourceRef="intermediateThrowEvent1" targetRef="parallelGateway2"/>
    <sequenceFlow id="sequenceFlow14" sourceRef="parallelGateway2" targetRef="task6"/>

    <task id="task6" name="Combine and test designs">
      <incoming>sequenceFlow14</incoming>
      <outgoing>sequenceFlow15</outgoing>
    </task>

    <exclusiveGateway id="exclusiveGateway3">
      <incoming>sequenceFlow15</incoming>
      <outgoing>sequenceFlow16</outgoing>
      <outgoing>sequenceFlow17</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequenceFlow15" sourceRef="task6" targetRef="exclusiveGateway3"/>
    <sequenceFlow id="sequenceFlow16" sourceRef="exclusiveGateway3" targetRef="endEvent1">
      <conditionExpression xsi:type="tFormalExpression">${designOk}</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="sequenceFlow17" sourceRef="exclusiveGateway3" targetRef="task1">
      <conditionExpression xsi:type="tFormalExpression">${not designOk}</conditionExpression>
    </sequenceFlow>

    <endEvent id="endEvent1">
      <incoming>sequenceFlow16</incoming>
    </endEvent>
  </process>
</definitions>