<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">

   <process id="customerAcquisitionProcess" isExecutable="true">
     <startEvent id="startEvent1">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <exclusiveGateway id="determineContactDetailsGateway1">
       <incoming>sequenceFlow1</incoming>
       <outgoing>buyDataSequenceFlow</outgoing>
       <outgoing>visitExhibitionSequenceFlow</outgoing>
       <outgoing>useOtherSourcesSequenceFlow</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="determineContactDetailsGateway1"/>

     <task id="buyDataTask1" name="Buy data">
       <incoming>buyDataSequenceFlow</incoming>
       <outgoing>importExcelSheetSequenceFlow</outgoing>
     </task>

     <sequenceFlow id="buyDataSequenceFlow" sourceRef="determineContactDetailsGateway1" targetRef="buyDataTask1"/>

     <task id="visitExhibitionTask1" name="Visit exhibition">
       <incoming>visitExhibitionSequenceFlow</incoming>
       <outgoing>importExcelSheetSequenceFlow2</outgoing>
     </task>

     <sequenceFlow id="visitExhibitionSequenceFlow" sourceRef="determineContactDetailsGateway1" targetRef="visitExhibitionTask1"/>

     <task id="useOtherSourcesTask1" name="Use other sources">
       <incoming>useOtherSourcesSequenceFlow</incoming>
       <outgoing>importExcelSheetSequenceFlow3</outgoing>
     </task>

     <sequenceFlow id="useOtherSourcesSequenceFlow" sourceRef="determineContactDetailsGateway1" targetRef="useOtherSourcesTask1"/>

     <exclusiveGateway id="callCustomerGateway">
       <incoming>importExcelSheetSequenceFlow</incoming>
       <outgoing>callCenterStaffSequenceFlow</outgoing>
     </exclusiveGateway>

     <task id="importExcelSheetTask1" name="Import excel-sheet with customer data">
       <incoming>importExcelSheetSequenceFlow</incoming>
       <outgoing>callCustomerSequenceFlow</outgoing>
     </task>

     <sequenceFlow id="importExcelSheetSequenceFlow" sourceRef="buyDataTask1" targetRef="importExcelSheetTask1"/>
     <sequenceFlow id="importExcelSheetSequenceFlow2" sourceRef="visitExhibitionTask1" targetRef="callCustomerGateway"/>
     <sequenceFlow id="importExcelSheetSequenceFlow3" sourceRef="useOtherSourcesTask1" targetRef="callCustomerGateway"/>

     <task id="callCenterStaffTask1" name="Determine contact person and budget">
       <incoming>callCenterStaffSequenceFlow</incoming>
       <outgoing>determineContactPersonAndBudgetSequenceFlow</outgoing>
     </task>

     <sequenceFlow id="callCustomerSequenceFlow" sourceRef="callCustomerGateway" targetRef="callCenterStaffTask1"/>

     <exclusiveGateway id="customerInterestGateway1">
       <incoming>determineContactPersonAndBudgetSequenceFlow</incoming>
       <outgoing>interestedSequenceFlow</outgoing>
       <outgoing>notInterestedSequenceFlow</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="determineContactPersonAndBudgetSequenceFlow" sourceRef="callCenterStaffTask1" targetRef="customerInterestGateway1"/>

     <task id="onlinePresentationTask1" name="Give online presentation">
       <incoming>interestedSequenceFlow</incoming>
       <outgoing>quotationSequenceFlow</outgoing>
     </task>

     <sequenceFlow id="interestedSequenceFlow" sourceRef="customerInterestGateway1" targetRef="onlinePresentationTask1"/>

     <exclusiveGateway id="presentationTypeGateway1">
       <incoming>interestedSequenceFlow</incoming>
       <outgoing>salesRepresentativeSequenceFlow</outgoing>
       <outgoing>preSalesEmployeeSequenceFlow</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="quotationSequenceFlow" sourceRef="onlinePresentationTask1" targetRef="presentationTypeGateway1"/>

     <task id="Task_1n5augf1" name="Give sales presentation">
       <incoming>salesRepresentativeSequenceFlow</incoming>
       <outgoing>followUpSequenceFlow</outgoing>
     </task>

     <sequenceFlow id="salesRepresentativeSequenceFlow" sourceRef="presentationTypeGateway1" targetRef="Task_1n5augf1"/>

     <task id="Task_1oshr8b1" name="Give technical presentation">
       <incoming>preSalesEmployeeSequenceFlow</incoming>
       <outgoing>followUpSequenceFlow2</outgoing>
     </task>

     <sequenceFlow id="preSalesEmployeeSequenceFlow" sourceRef="presentationTypeGateway1" targetRef="Task_1oshr8b1"/>

     <intermediateCatchEvent id="followUpIntermediateCatchEvent1">
       <incoming>followUpSequenceFlow</incoming>
       <outgoing>quotationCreatedSequenceFlow</outgoing>
       <timerEventDefinition/>
     </intermediateCatchEvent>

     <sequenceFlow id="followUpSequenceFlow" sourceRef="Task_1n5augf1" targetRef="followUpIntermediateCatchEvent1"/>

     <task id="createQuotationTask1" name="Create quotation">
       <incoming>quotationCreatedSequenceFlow</incoming>
     </task>

     <sequenceFlow id="quotationCreatedSequenceFlow" sourceRef="followUpIntermediateCatchEvent1" targetRef="createQuotationTask1"/>

     <endEvent id="endEvent1" name="End of process">
       <incoming>notInterestedSequenceFlow</incoming>
     </endEvent>

     <sequenceFlow id="notInterestedSequenceFlow" sourceRef="customerInterestGateway1" targetRef="endEvent1"/>
   </process>
</definitions>