<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">

  <process id="faultHandlingProcess" isExecutable="true">
    <laneSet>
      <lane id="userLane" name="User">
        <flowNodeRef>startEvent</flowNodeRef>
        <flowNodeRef>task1</flowNodeRef>
        <flowNodeRef>exclusiveGateway1</flowNodeRef>
        <flowNodeRef>task2</flowNodeRef>
        <flowNodeRef>task3</flowNodeRef>
        <flowNodeRef>task4</flowNodeRef>
        <flowNodeRef>task5</flowNodeRef>
        <flowNodeRef>task6</flowNodeRef>
        <flowNodeRef>endEvent</flowNodeRef>
      </lane>
    </laneSet>

    <sequenceFlow id="sf1" sourceRef="startEvent" targetRef="task1"/>
    <startEvent id="startEvent">
      <outgoing>sf1</outgoing>
    </startEvent>

    <userTask id="task1" name="Examine Failure Report">
      <incoming>sf1</incoming>
      <outgoing>sf2</outgoing>
    </userTask>
    <sequenceFlow id="sf2" sourceRef="task1" targetRef="exclusiveGateway1"/>

    <exclusiveGateway id="exclusiveGateway1">
      <incoming>sf2</incoming>
      <outgoing>sf3</outgoing>
      <outgoing>sf4</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sf3" sourceRef="exclusiveGateway1" targetRef="task2">
      <conditionExpression xsi:type="tFormalExpression">${confirmFailure}</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="sf4" sourceRef="exclusiveGateway1" targetRef="endEvent"/>

    <userTask id="task2" name="Inform Customer and Manager about Failure">
      <incoming>sf3</incoming>
      <outgoing>sf5</outgoing>
    </userTask>

    <sequenceFlow id="sf5" sourceRef="task2" targetRef="task3"/>
    <userTask id="task3" name="Fix Fault at Measuring Device">
      <incoming>sf5</incoming>
      <outgoing>sf6</outgoing>
    </userTask>

    <sequenceFlow id="sf6" sourceRef="task3" targetRef="task4"/>
    <userTask id="task4" name="Share Repair Results with Fault Detector">
      <incoming>sf6</incoming>
      <outgoing>sf7</outgoing>
    </userTask>

    <sequenceFlow id="sf7" sourceRef="task4" targetRef="task5"/>
    <userTask id="task5" name="Inform Customer about Resolution of Interference">
      <incoming>sf7</incoming>
      <outgoing>sf8</outgoing>
    </userTask>

    <sequenceFlow id="sf8" sourceRef="task5" targetRef="task6"/>
    <userTask id="task6" name="Inform Manager about Resolution of Interference">
      <incoming>sf8</incoming>
      <outgoing>sf9</outgoing>
    </userTask>

    <sequenceFlow id="sf9" sourceRef="task6" targetRef="endEvent"/>

    <endEvent id="endEvent">
      <incoming>sf4</incoming>
      <incoming>sf9</incoming>
    </endEvent>
  </process>
</definitions>