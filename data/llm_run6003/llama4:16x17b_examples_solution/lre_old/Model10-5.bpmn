<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">

   <collaboration id="collaboration">
     <participant id="mpon" name="MPON" processRef="mponProcess"/>
     <participant id="mpoo" name="MPOO" processRef="mpooProcess"/>
     <messageFlow id="requestBidMessageFlow" sourceRef="mponRequestBidTask" targetRef="mpooTenderTask"/>
     <messageFlow id="orderMessageFlow" sourceRef="mponOrderTask" targetRef="mpooConfirmOrderTask"/>
   </collaboration>

   <process id="mponProcess" isExecutable="true">
     <startEvent id="mponStartEvent">
       <outgoing>requestBidSequenceFlow</outgoing>
     </startEvent>

     <sequenceFlow id="requestBidSequenceFlow" sourceRef="mponStartEvent" targetRef="mponRequestBidTask"/>

     <task id="mponRequestBidTask" name="Request a device takeover bid">
       <incoming>requestBidSequenceFlow</incoming>
       <outgoing>orderSequenceFlow</outgoing>
     </task>

     <sequenceFlow id="orderSequenceFlow" sourceRef="mponRequestBidTask" targetRef="mponOrderTask"/>

     <task id="mponOrderTask" name="Place Order">
       <incoming>orderSequenceFlow</incoming>
       <outgoing>endSequenceFlow</outgoing>
     </task>

     <sequenceFlow id="endSequenceFlow" sourceRef="mponOrderTask" targetRef="mponEndEvent"/>

     <endEvent id="mponEndEvent">
       <incoming>endSequenceFlow</incoming>
     </endEvent>
   </process>

   <process id="mpooProcess" isExecutable="true">
     <startEvent id="mpooStartEvent">
       <incoming>requestBidMessageFlow</incoming>
       <outgoing>tenderSequenceFlow</outgoing>
     </startEvent>

     <sequenceFlow id="tenderSequenceFlow" sourceRef="mpooStartEvent" targetRef="mpooTenderTask"/>

     <task id="mpooTenderTask" name="Send Tender for Equipment Takeover">
       <incoming>tenderSequenceFlow</incoming>
       <outgoing>confirmOrderSequenceFlow</outgoing>
     </task>

     <sequenceFlow id="confirmOrderSequenceFlow" sourceRef="mpooTenderTask" targetRef="mpooConfirmOrderTask"/>

     <task id="mpooConfirmOrderTask" name="Confirm Order and Transmission of Master Data">
       <incoming>confirmOrderSequenceFlow</incoming>
       <outgoing>orderMessageFlow</outgoing>
     </task>

     <endEvent id="mpooEndEvent">
       <!-- No incoming sequence flow  -->
     </endEvent>
   </process>
</definitions>