<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">

  <process id="personnelProcess" isExecutable="true">
    <startEvent id="startEvent">
      <outgoing>sequenceFlow1</outgoing>
    </startEvent>

    <sequenceFlow id="sequenceFlow1" sourceRef="startEvent" targetRef="task1"/>

    <task id="task1" name="Report vacancy to Personnel Department">
      <incoming>sequenceFlow1</incoming>
      <outgoing>sequenceFlow2</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow2" sourceRef="task1" targetRef="intermediateCatchEvent1"/>

    <intermediateCatchEvent id="intermediateCatchEvent1">
      <incoming>sequenceFlow2</incoming>
      <outgoing>sequenceFlow3</outgoing>
    </intermediateCatchEvent>

    <sequenceFlow id="sequenceFlow3" sourceRef="intermediateCatchEvent1" targetRef="exclusiveGateway1"/>

    <exclusiveGateway id="exclusiveGateway1">
      <incoming>sequenceFlow3</incoming>
      <outgoing>sequenceFlow4</outgoing>
      <outgoing>sequenceFlow5</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequenceFlow4" sourceRef="exclusiveGateway1" targetRef="task2">
      <conditionExpression xsi:type="tFormalExpression">${requiresCorrection}</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="sequenceFlow5" sourceRef="exclusiveGateway1" targetRef="task3"/>

    <task id="task2" name="Ask for corrections">
      <incoming>sequenceFlow4</incoming>
      <outgoing>sequenceFlow6</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow6" sourceRef="task2" targetRef="intermediateCatchEvent1"/>

    <task id="task3" name="Review and approve job description">
      <incoming>sequenceFlow5</incoming>
      <outgoing>sequenceFlow7</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow7" sourceRef="task3" targetRef="endEvent1"/>

    <endEvent id="endEvent1">
      <incoming>sequenceFlow7</incoming>
    </endEvent>

  </process>
</definitions>