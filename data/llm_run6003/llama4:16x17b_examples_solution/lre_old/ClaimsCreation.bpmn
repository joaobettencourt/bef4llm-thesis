<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">

  <process id="claimsProcess" isExecutable="true">
    <laneSet>
      <lane id="claimsHandlerLane" name="Claims Handler">
        <flowNodeRef>calculateClaimEstimateTask</flowNodeRef>
        <flowNodeRef>createActionPlanTask</flowNodeRef>
      </lane>
      <lane id="clerkLane" name="Clerk">
        <flowNodeRef>startEvent</flowNodeRef>
        <flowNodeRef>searchPoliceReportDatabaseTask</flowNodeRef>
        <flowNodeRef>composeFileTask</flowNodeRef>
        <flowNodeRef>negotiateEstimateSettlementTask</flowNodeRef>
        <flowNodeRef>notifyClaimantTask</flowNodeRef>
        <flowNodeRef>endEvent</flowNodeRef>
      </lane>
    </laneSet>

    <startEvent id="startEvent">
      <outgoing>searchPoliceReportDatabaseSequenceFlow</outgoing>
    </startEvent>

    <task id="searchPoliceReportDatabaseTask" name="Search police report database">
      <incoming>searchPoliceReportDatabaseSequenceFlow</incoming>
      <outgoing>composeFileSequenceFlow</outgoing>
    </task>

    <sequenceFlow id="searchPoliceReportDatabaseSequenceFlow" sourceRef="startEvent" targetRef="searchPoliceReportDatabaseTask"/>

    <task id="composeFileTask" name="Compose file">
      <incoming>composeFileSequenceFlow</incoming>
      <outgoing>calculateClaimEstimateSequenceFlow</outgoing>
    </task>

    <sequenceFlow id="composeFileSequenceFlow" sourceRef="searchPoliceReportDatabaseTask" targetRef="composeFileTask"/>

    <task id="calculateClaimEstimateTask" name="Calculate claim estimate">
      <incoming>calculateClaimEstimateSequenceFlow</incoming>
      <outgoing>createActionPlanSequenceFlow</outgoing>
    </task>

    <sequenceFlow id="calculateClaimEstimateSequenceFlow" sourceRef="composeFileTask" targetRef="calculateClaimEstimateTask"/>

    <task id="createActionPlanTask" name="Create action plan">
      <incoming>createActionPlanSequenceFlow</incoming>
      <outgoing>negotiateEstimateSettlementSequenceFlow</outgoing>
    </task>

    <sequenceFlow id="createActionPlanSequenceFlow" sourceRef="calculateClaimEstimateTask" targetRef="createActionPlanTask"/>

    <task id="negotiateEstimateSettlementTask" name="Negotiate estimate settlement">
      <incoming>negotiateEstimateSettlementSequenceFlow</incoming>
      <outgoing>notifyClaimantSequenceFlow</outgoing>
    </task>

    <sequenceFlow id="negotiateEstimateSettlementSequenceFlow" sourceRef="createActionPlanTask" targetRef="negotiateEstimateSettlementTask"/>

    <task id="notifyClaimantTask" name="Notify claimant">
      <incoming>notifyClaimantSequenceFlow</incoming>
      <outgoing>endEventSequenceFlow</outgoing>
    </task>

    <sequenceFlow id="notifyClaimantSequenceFlow" sourceRef="negotiateEstimateSettlementTask" targetRef="notifyClaimantTask"/>

    <endEvent id="endEvent">
      <incoming>endEventSequenceFlow</incoming>
    </endEvent>

    <sequenceFlow id="endEventSequenceFlow" sourceRef="notifyClaimantTask" targetRef="endEvent"/>
  </process>
</definitions>