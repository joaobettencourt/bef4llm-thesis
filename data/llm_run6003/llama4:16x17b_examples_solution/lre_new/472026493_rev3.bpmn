<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" 
             targetNamespace="http://bpmn.io/schema/bpmn">
   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
       <messageEventDefinition/>
     </startEvent>
     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>
     <task id="Task_1" name="Analyse Request">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="ExclusiveGateway_1"/>
     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_4</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_3" name="approved" sourceRef="ExclusiveGateway_1" targetRef="Task_2"/>
     <task id="Task_2" name="Edit and Complete Request">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_4" name="denied" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_1"/>
     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_2" targetRef="IntermediateThrowEvent_1"/>
     <intermediateThrowEvent id="IntermediateThrowEvent_1" name="Ask Supplier About Prices">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_6</outgoing>
       <messageEventDefinition/>
     </intermediateThrowEvent>
     <sequenceFlow id="SequenceFlow_6" sourceRef="IntermediateThrowEvent_1" targetRef="IntermediateCatchEvent_1"/>
     <intermediateCatchEvent id="IntermediateCatchEvent_1" name="Receive Offer">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_7</outgoing>
       <messageEventDefinition/>
     </intermediateCatchEvent>
     <sequenceFlow id="SequenceFlow_7" sourceRef="IntermediateCatchEvent_1" targetRef="Task_3"/>
     <task id="Task_3" name="Fill in Form and Send to Management">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_8</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_8" sourceRef="Task_3" targetRef="Task_4"/>
     <task id="Task_4" name="Analyze Request">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_4" targetRef="ExclusiveGateway_2"/>
     <exclusiveGateway id="ExclusiveGateway_2">
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_10</outgoing>
       <outgoing>SequenceFlow_11</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_10" name="approved" sourceRef="ExclusiveGateway_2" targetRef="ParallelGateway_1"/>
     <parallelGateway id="ParallelGateway_1">
       <incoming>SequenceFlow_10</incoming>
       <outgoing>SequenceFlow_12</outgoing>
       <outgoing>SequenceFlow_13</outgoing>
     </parallelGateway>
     <sequenceFlow id="SequenceFlow_12" sourceRef="ParallelGateway_1" targetRef="Task_5"/>
     <task id="Task_5" name="Prepare Order">
       <incoming>SequenceFlow_12</incoming>
       <outgoing>SequenceFlow_14</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_13" sourceRef="ParallelGateway_1" targetRef="Task_6"/>
     <task id="Task_6" name="Find Finance Resources">
       <incoming>SequenceFlow_13</incoming>
       <outgoing>SequenceFlow_15</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_14" sourceRef="Task_5" targetRef="IntermediateThrowEvent_2"/>
     <intermediateThrowEvent id="IntermediateThrowEvent_2" name="Send Order">
       <incoming>SequenceFlow_14</incoming>
       <outgoing>SequenceFlow_16</outgoing>
       <messageEventDefinition/>
     </intermediateThrowEvent>
     <sequenceFlow id="SequenceFlow_15" sourceRef="Task_6" targetRef="ExclusiveGateway_3"/>
     <exclusiveGateway id="ExclusiveGateway_3">
       <incoming>SequenceFlow_15</incoming>
       <outgoing>SequenceFlow_17</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_16" sourceRef="IntermediateThrowEvent_2" targetRef="IntermediateCatchEvent_2"/>
     <intermediateCatchEvent id="IntermediateCatchEvent_2" name="Order Accepted">
       <incoming>SequenceFlow_16</incoming>
       <outgoing>SequenceFlow_18</outgoing>
       <messageEventDefinition/>
     </intermediateCatchEvent>
     <sequenceFlow id="SequenceFlow_17" sourceRef="ExclusiveGateway_3" targetRef="IntermediateCatchEvent_2"/>
     <sequenceFlow id="SequenceFlow_18" sourceRef="IntermediateCatchEvent_2" targetRef="Task_7"/>
     <task id="Task_7" name="Receive HW and Invoice">
       <incoming>SequenceFlow_18</incoming>
       <outgoing>SequenceFlow_19</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_19" sourceRef="Task_7" targetRef="Task_8"/>
     <task id="Task_8" name="Pay Invoice">
       <incoming>SequenceFlow_19</incoming>
       <outgoing>SequenceFlow_20</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_20" sourceRef="Task_8" targetRef="EndEvent_2"/>
     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_4</incoming>
     </endEvent>
     <sequenceFlow id="SequenceFlow_11" name="not approved" sourceRef="ExclusiveGateway_2" targetRef="ExclusiveGateway_4"/>
     <exclusiveGateway id="ExclusiveGateway_4">
       <incoming>SequenceFlow_11</incoming>
       <outgoing>SequenceFlow_21</outgoing>
       <outgoing>SequenceFlow_22</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_21" name="rework" sourceRef="ExclusiveGateway_4" targetRef="Task_2"/>
     <sequenceFlow id="SequenceFlow_22" name="denied" sourceRef="ExclusiveGateway_4" targetRef="EndEvent_3"/>
     <endEvent id="EndEvent_2">
       <incoming>SequenceFlow_20</incoming>
     </endEvent>
     <endEvent id="EndEvent_3">
       <incoming>SequenceFlow_22</incoming>
     </endEvent>
   </process>
 </definitions>