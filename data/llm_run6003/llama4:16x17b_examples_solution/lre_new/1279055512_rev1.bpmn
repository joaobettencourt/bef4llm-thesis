<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" targetNamespace="http://bpmn.io/schema/bpmn">
   <process id="Process_1" isExecutable="true">
     <laneSet>
       <lane id="Lane_MailCentre" name="Mail Centre office of SSP">
         <flowNodeRef>StartEvent_1</flowNodeRef>
         <flowNodeRef>Task_CategorizeInvoice</flowNodeRef>
         <flowNodeRef>Task_ForwardInvoiceToAdmin</flowNodeRef>
         <flowNodeRef>CatchEvent_EveryHour</flowNodeRef>
       </lane>
       <lane id="Lane_Administration" name="Administration Department">
         <flowNodeRef>SubProcess_ProcessInvoice</flowNodeRef>
         <flowNodeRef>Task_PutInCollectionBox</flowNodeRef>
       </lane>
       <lane id="Lane_DataEntry" name="Data Entry office">
         <flowNodeRef>CatchEvent_DailyAt10am</flowNodeRef>
         <flowNodeRef>SubProcess_EnterDataInSAP</flowNodeRef>
       </lane>
       <lane id="Lane_Validation" name="Validation Office">
         <flowNodeRef>Task_ValidateInvoice</flowNodeRef>
       </lane>
       <lane id="Lane_Payment" name="Payment office">
         <flowNodeRef>CatchEvent_Weekly</flowNodeRef>
         <flowNodeRef>SubProcess_ProcessPayment</flowNodeRef>
       </lane>
       <lane id="Lane_Registry" name="Registry office">
         <flowNodeRef>Task_ArchiveInvoice</flowNodeRef>
         <flowNodeRef>EndEvent_1</flowNodeRef>
       </lane>
     </laneSet>

     <startEvent id="StartEvent_1" name="Receive Invoice from Client">
       <outgoing>SequenceFlow_1</outgoing>
       <messageEventDefinition/>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_CategorizeInvoice"/>

     <task id="Task_CategorizeInvoice" name="Categorize Invoice by Staff Member">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_CategorizeInvoice" targetRef="Task_ForwardInvoiceToAdmin"/>

     <task id="Task_ForwardInvoiceToAdmin" name="Forward Invoice to Administration Department">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_3" sourceRef="Task_ForwardInvoiceToAdmin" targetRef="SubProcess_ProcessInvoice"/>

     <subProcess id="SubProcess_ProcessInvoice" name="Process Invoice">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_4</outgoing>
     </subProcess>

     <sequenceFlow id="SequenceFlow_4" sourceRef="SubProcess_ProcessInvoice" targetRef="Task_PutInCollectionBox"/>

     <task id="Task_PutInCollectionBox" name="Put Invoices in Collection Box">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_PutInCollectionBox" targetRef="CatchEvent_DailyAt10am"/>

     <intermediateCatchEvent id="CatchEvent_DailyAt10am" name="Every Workday at 10 am">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_6</outgoing>
       <timerEventDefinition/>
     </intermediateCatchEvent>

     <sequenceFlow id="SequenceFlow_6" sourceRef="CatchEvent_DailyAt10am" targetRef="SubProcess_EnterDataInSAP"/>

     <subProcess id="SubProcess_EnterDataInSAP" name="Enter Data in SAP System">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_7</outgoing>
     </subProcess>

     <sequenceFlow id="SequenceFlow_7" sourceRef="SubProcess_EnterDataInSAP" targetRef="CatchEvent_EveryHour"/>

     <intermediateCatchEvent id="CatchEvent_EveryHour" name="Every Hour">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_8</outgoing>
       <timerEventDefinition/>
     </intermediateCatchEvent>

     <sequenceFlow id="SequenceFlow_8" sourceRef="CatchEvent_EveryHour" targetRef="Task_ForwardInvoiceForValidation"/>

     <task id="Task_ForwardInvoiceForValidation" name="Forward Invoice for Validation">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_ForwardInvoiceForValidation" targetRef="Task_ValidateInvoice"/>

     <subProcess id="Task_ValidateInvoice" name="Validate Invoice">
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_10</outgoing>
     </subProcess>

     <sequenceFlow id="SequenceFlow_10" sourceRef="Task_ValidateInvoice" targetRef="CatchEvent_Weekly"/>

     <intermediateCatchEvent id="CatchEvent_Weekly" name="Beginning of Every Week">
       <incoming>SequenceFlow_10</incoming>
       <outgoing>SequenceFlow_11</outgoing>
       <timerEventDefinition/>
     </intermediateCatchEvent>

     <sequenceFlow id="SequenceFlow_11" sourceRef="CatchEvent_Weekly" targetRef="SubProcess_ProcessPayment"/>

     <subProcess id="SubProcess_ProcessPayment" name="Process Payment">
       <incoming>SequenceFlow_11</incoming>
       <outgoing>SequenceFlow_12</outgoing>
     </subProcess>

     <sequenceFlow id="SequenceFlow_12" sourceRef="SubProcess_ProcessPayment" targetRef="Task_ArchiveInvoice"/>

     <task id="Task_ArchiveInvoice" name="Archive Invoice">
       <incoming>SequenceFlow_12</incoming>
       <outgoing>SequenceFlow_13</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_13" sourceRef="Task_ArchiveInvoice" targetRef="EndEvent_1"/>

     <endEvent id="EndEvent_1" name="Invoice Process Completed">
       <incoming>SequenceFlow_13</incoming>
     </endEvent>
   </process>
</definitions>