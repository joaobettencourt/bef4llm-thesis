<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" 
             targetNamespace="http://bpmn.io/schema/bpmn">
   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>
     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>
     <task id="Task_1" name="Enter credit card details">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="Task_2"/>
     <task id="Task_2" name="Check billing address is correct">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_4</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_3" sourceRef="Task_2" targetRef="Gateway_1">
       <conditionExpression xsi:type="tFormalExpression">incorrect address</conditionExpression>
     </sequenceFlow>
     <sequenceFlow id="SequenceFlow_4" sourceRef="Task_2" targetRef="Gateway_1">
       <conditionExpression xsi:type="tFormalExpression">correct address</conditionExpression>
     </sequenceFlow>
     <task id="Task_3" name="Modify billing address">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_5b</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_5" sourceRef="Gateway_1" targetRef="Task_3"/>
     <exclusiveGateway id="Gateway_1">
       <incoming>SequenceFlow_3</incoming>
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_5</outgoing>
       <outgoing>SequenceFlow_6</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_5b" sourceRef="Task_3" targetRef="Gateway_1"/>
     <sequenceFlow id="SequenceFlow_6" sourceRef="Gateway_1" targetRef="Task_4"/>
     <task id="Task_4" name="Click Continue">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_7</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_7" sourceRef="Task_4" targetRef="IntermediateThrowEvent_1"/>
     <intermediateThrowEvent id="IntermediateThrowEvent_1" name="Verify Credit Card with Authority">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_8</outgoing>
       <!-- add message definition here -->
     </intermediateThrowEvent>
     <sequenceFlow id="SequenceFlow_8" sourceRef="IntermediateThrowEvent_1" targetRef="Task_5"/>
     <task id="Task_5" name="Check verification result">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_5" targetRef="Gateway_2"/>
     <exclusiveGateway id="Gateway_2">
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_10</outgoing>
       <outgoing>SequenceFlow_11</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_10" sourceRef="Gateway_2" targetRef="Task_6">
       <!-- add conditionExpression here -->
     </sequenceFlow>
     <task id="Task_6" name="Add Credit Card to account">
       <incoming>SequenceFlow_10</incoming>
       <outgoing>SequenceFlow_12</outgoing>
     </task>
     <endEvent id="EndEvent_1" name="Credit card added to account">
       <incoming>SequenceFlow_12</incoming>
     </endEvent>
     <sequenceFlow id="SequenceFlow_12" sourceRef="Task_6" targetRef="EndEvent_1"/>
     <sequenceFlow id="SequenceFlow_11" sourceRef="Gateway_2" targetRef="EndEvent_2">
       <!-- add conditionExpression here -->
     </sequenceFlow>
     <endEvent id="EndEvent_2" name="Addition of Credit Card cancelled">
       <incoming>SequenceFlow_11</incoming>
     </endEvent>
   </process>
</definitions>