<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/20/BPMN20.xsd"
             id="definition" name="Building a House" targetNamespace="http://example.com">

  <process id="Process_1" isExecutable="true">

    <!-- Start Event -->
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>

    <!-- Task: Collect Requirements -->
    <userTask id="Task_CollectRequirements" name="Collect requirements">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </userTask>

    <!-- Sequence Flow 1 -->
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_CollectRequirements"/>

    <!-- Task: Send Requirements to Architect -->
    <userTask id="Task_SendReqToArchitect" name="Send requirements">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
    </userTask>

    <!-- Sequence Flow 2 -->
    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_CollectRequirements" targetRef="Task_SendReqToArchitect"/>

    <!-- Intermediate Catch Event: Draft Received -->
    <intermediateCatchEvent id="IntermediateCatchEvent_DraftReceived">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_4</outgoing>
      <messageEventDefinition/>
    </intermediateCatchEvent>

    <!-- Sequence Flow 3 -->
    <sequenceFlow id="SequenceFlow_3" sourceRef="Task_SendReqToArchitect" targetRef="IntermediateCatchEvent_DraftReceived"/>

    <!-- Task: Refine Requirements -->
    <userTask id="Task_RefineRequirements" name="Refine requirements">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_5</outgoing>
    </userTask>

    <!-- Sequence Flow 4 -->
    <sequenceFlow id="SequenceFlow_4" sourceRef="IntermediateCatchEvent_DraftReceived" targetRef="Task_RefineRequirements"/>

    <!-- Task: Create Order List -->
    <userTask id="Task_CreateOrderList" name="Create order list">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </userTask>

    <!-- Sequence Flow 5 -->
    <sequenceFlow id="SequenceFlow_5" sourceRef="Task_RefineRequirements" targetRef="Task_CreateOrderList"/>

    <!-- Task: Order Materials -->
    <userTask id="Task_OrderMaterials" name="Order materials">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </userTask>

    <!-- Sequence Flow 6 -->
    <sequenceFlow id="SequenceFlow_6" sourceRef="Task_CreateOrderList" targetRef="Task_OrderMaterials"/>

    <!-- Parallel Gateway: Build House and Send Invitations -->
    <parallelGateway id="ParallelGateway_1">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_8</outgoing>
      <outgoing>SequenceFlow_9</outgoing>
    </parallelGateway>

    <!-- Sequence Flow 7 -->
    <sequenceFlow id="SequenceFlow_7" sourceRef="Task_OrderMaterials" targetRef="ParallelGateway_1"/>

    <!-- Task: Build House -->
    <userTask id="Task_BuildHouse" name="Build house">
      <incoming>SequenceFlow_8</incoming>
      <outgoing>SequenceFlow_10</outgoing>
    </userTask>

    <!-- Sequence Flow 8 -->
    <sequenceFlow id="SequenceFlow_8" sourceRef="ParallelGateway_1" targetRef="Task_BuildHouse"/>

    <!-- Task: Send Invitations and Create Attendee List -->
    <userTask id="Task_SendInviCreateList" name="Send invitations">
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_11</outgoing>
    </userTask>

    <!-- Sequence Flow 9 -->
    <sequenceFlow id="SequenceFlow_9" sourceRef="ParallelGateway_1" targetRef="Task_SendInviCreateList"/>

    <!-- End Event -->
    <endEvent id="EndEvent_1">
      <incoming>SequenceFlow_10</incoming>
    </endEvent>

    <!-- Sequence Flow 10 -->
    <sequenceFlow id="SequenceFlow_10" sourceRef="Task_BuildHouse" targetRef="EndEvent_1"/>

    <!-- Sequence Flow 11 -->
    <sequenceFlow id="SequenceFlow_11" sourceRef="Task_SendInviCreateList" targetRef="EndEvent_1"/>
  </process>
</definitions>