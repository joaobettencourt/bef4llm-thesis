<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/ BPMN20.xsd"
             id="definition" name="Blizzard Online Character Generator">

  <process id="Process_1" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>

    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_CheckBattleNetAccount"/>

    <task id="Task_CheckBattleNetAccount" name="Check battle.net account">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
      <outgoing>SequenceFlow_3</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_CheckBattleNetAccount" targetRef="Task_CreateBattleNetAccount">
      <conditionExpression xsi:type="tFormalExpression">${hasBattleNetAccount  == false}</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="SequenceFlow_3" sourceRef="Task_CheckBattleNetAccount" targetRef="Task_CheckWoWSubscription"/>

    <task id="Task_CreateBattleNetAccount" name="Create new battle.net account">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_4</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_4" sourceRef="Task_CreateBattleNetAccount" targetRef="Task_CheckWoWSubscription"/>

    <task id="Task_CheckWoWSubscription" name="Check WoW subscription">
      <incoming>SequenceFlow_3</incoming>
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_5</outgoing>
      <outgoing>SequenceFlow_6</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_5" sourceRef="Task_CheckWoWSubscription" targetRef="Task_SelectPaymentMethod">
      <conditionExpression xsi:type="tFormalExpression">${hasActiveWoWSubscription  == false}</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="SequenceFlow_6" sourceRef="Task_CheckWoWSubscription" targetRef="ParallelGateway_1"/>

    <task id="Task_SelectPaymentMethod" name="Select payment method">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_7</outgoing>
      <outgoing>SequenceFlow_8</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_7" sourceRef="Task_SelectPaymentMethod" targetRef="Task_EnterCreditCardInfo">
      <conditionExpression xsi:type="tFormalExpression">${paymentMethod  ==  'credit card'}</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="SequenceFlow_8" sourceRef="Task_SelectPaymentMethod" targetRef="Task_EnterBankAccountInfo">
      <conditionExpression xsi:type="tFormalExpression">${paymentMethod  ==  'bank account'}</conditionExpression>
    </sequenceFlow>

    <task id="Task_EnterCreditCardInfo" name="Enter credit card information">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_9</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_9" sourceRef="Task_EnterCreditCardInfo" targetRef="ParallelGateway_1"/>

    <task id="Task_EnterBankAccountInfo" name="Enter bank account information">
      <incoming>SequenceFlow_8</incoming>
      <outgoing>SequenceFlow_10</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_10" sourceRef="Task_EnterBankAccountInfo" targetRef="ParallelGateway_1"/>

    <parallelGateway id="ParallelGateway_1">
      <incoming>SequenceFlow_6</incoming>
      <incoming>SequenceFlow_9</incoming>
      <incoming>SequenceFlow_10</incoming>
      <outgoing>SequenceFlow_11</outgoing>
    </parallelGateway>

    <sequenceFlow id="SequenceFlow_11" sourceRef="ParallelGateway_1" targetRef="Task_LogIntoGame"/>

    <task id="Task_LogIntoGame" name="Log into game">
      <incoming>SequenceFlow_11</incoming>
      <outgoing>SequenceFlow_12</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_12" sourceRef="Task_LogIntoGame" targetRef="ParallelGateway_2"/>

    <parallelGateway id="ParallelGateway_2">
      <incoming>SequenceFlow_12</incoming>
      <outgoing>SequenceFlow_13</outgoing>
      <outgoing>SequenceFlow_14</outgoing>
    </parallelGateway>

    <sequenceFlow id="SequenceFlow_13" sourceRef="ParallelGateway_2" targetRef="Task_SelectRealmAndClass"/>

    <sequenceFlow id="SequenceFlow_14" sourceRef="ParallelGateway_2" targetRef="Task_EnterCharacterName"/>

    <task id="Task_SelectRealmAndClass" name="Select realm, race and class">
      <incoming>SequenceFlow_13</incoming>
    </task>

    <task id="Task_EnterCharacterName" name="Enter character name">
      <incoming>SequenceFlow_14</incoming>
      <outgoing>SequenceFlow_15</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_15" sourceRef="Task_EnterCharacterName" targetRef="ExclusiveGateway_1"/>

    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>SequenceFlow_15</incoming>
      <outgoing>SequenceFlow_16</outgoing>
      <outgoing>SequenceFlow_17</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow_16" sourceRef="ExclusiveGateway_1" targetRef="Task_EnterCharacterName">
      <conditionExpression xsi:type="tFormalExpression">${isNameAvailable  == false}</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="SequenceFlow_17" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_1">
      <conditionExpression xsi:type="tFormalExpression">${isNameAvailable  == true}</conditionExpression>
    </sequenceFlow>

    <endEvent id="EndEvent_1">
      <incoming>SequenceFlow_17</incoming>
    </endEvent>

  </process>

</definitions>