<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/BPMN20.xsd" 
             id="definition" name="Farming Bot" targetNamespace="http://example.com">

   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>

     <task id="Task_1" name="Create Farming List">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="ParallelGateway_1"/>

     <parallelGateway id="ParallelGateway_1">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_4</outgoing>
     </parallelGateway>

     <sequenceFlow id="SequenceFlow_3" sourceRef="ParallelGateway_1" targetRef="Task_2"/>

     <task id="Task_2" name="Collect Materials">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_4" sourceRef="ParallelGateway_1" targetRef="Task_3"/>

     <task id="Task_3" name="Create available tools">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_2" targetRef="ExclusiveGateway_1"/>

     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_7</outgoing>
       <outgoing>SequenceFlow_8</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_3" targetRef="ExclusiveGateway_1"/>

     <sequenceFlow id="SequenceFlow_7" name="materials available" sourceRef="ExclusiveGateway_1" targetRef="ServiceTask_1">
       <conditionExpression xsi:type="tFormalExpression">${materialsAvailable  == true}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="SequenceFlow_8" name="not enough materials" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_2"/>

     <serviceTask id="ServiceTask_1" name="Notify player">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </serviceTask>

     <sequenceFlow id="SequenceFlow_9" sourceRef="ServiceTask_1" targetRef="ParallelGateway_2"/>

     <parallelGateway id="ParallelGateway_2">
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_10</outgoing>
       <outgoing>SequenceFlow_11</outgoing>
     </parallelGateway>

     <sequenceFlow id="SequenceFlow_10" sourceRef="ParallelGateway_2" targetRef="Task_4"/>

     <task id="Task_4" name="Farming">
       <incoming>SequenceFlow_10</incoming>
       <outgoing>SequenceFlow_12</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_11" sourceRef="ParallelGateway_2" targetRef="IntermediateCatchEvent_1"/>

     <intermediateCatchEvent id="IntermediateCatchEvent_1">
       <incoming>SequenceFlow_11</incoming>
       <outgoing>SequenceFlow_13</outgoing>
       <signalEventDefinition signalRef="Natural_Disaster"/>
     </intermediateCatchEvent>

     <sequenceFlow id="SequenceFlow_12" sourceRef="Task_4" targetRef="ExclusiveGateway_2"/>

     <exclusiveGateway id="ExclusiveGateway_2">
       <incoming>SequenceFlow_12</incoming>
       <outgoing>SequenceFlow_14</outgoing>
       <outgoing>SequenceFlow_15</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_13" sourceRef="IntermediateCatchEvent_1" targetRef="Task_4"/>

     <sequenceFlow id="SequenceFlow_14" name="milestone reached" sourceRef="ExclusiveGateway_2" targetRef="ServiceTask_2">
       <conditionExpression xsi:type="tFormalExpression">${milestoneReached  == true}</conditionExpression>
     </sequenceFlow>

     <serviceTask id="ServiceTask_2" name="Notify player">
       <incoming>SequenceFlow_14</incoming>
       <outgoing>SequenceFlow_16</outgoing>
     </serviceTask>

     <sequenceFlow id="SequenceFlow_15" sourceRef="ExclusiveGateway_2" targetRef="EndEvent_1"/>

     <sequenceFlow id="SequenceFlow_16" sourceRef="ServiceTask_2" targetRef="UserTask_1"/>

     <userTask id="UserTask_1" name="Brag about materials">
       <incoming>SequenceFlow_16</incoming>
       <outgoing>SequenceFlow_17</outgoing>
     </userTask>

     <sequenceFlow id="SequenceFlow_17" sourceRef="UserTask_1" targetRef="EndEvent_1"/>

     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_15</incoming>
       <incoming>SequenceFlow_17</incoming>
     </endEvent>

     <endEvent id="EndEvent_2">
       <incoming>SequenceFlow_8</incoming>
     </endEvent>

   </process>

   <signal id="Natural_Disaster" name="Natural Disaster"/>

</definitions>