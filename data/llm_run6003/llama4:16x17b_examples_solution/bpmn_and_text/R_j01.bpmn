<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definition" name="OEE Process">

    <process id="Process_1" isExecutable="true">
        <startEvent id="StartEvent_1">
            <outgoing>SequenceFlow_1</outgoing>
        </startEvent>

        <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_Connection_Check"/>

        <serviceTask id="Task_Connection_Check" name="Check connection">
            <incoming>SequenceFlow_1</incoming>
            <outgoing>SequenceFlow_2</outgoing>
        </serviceTask>

        <sequenceFlow id="SequenceFlow_2" sourceRef="Task_Connection_Check" targetRef="ExclusiveGateway_IsConnected"/>

        <exclusiveGateway id="ExclusiveGateway_IsConnected">
            <incoming>SequenceFlow_2</incoming>
            <outgoing>SequenceFlow_3</outgoing>
            <outgoing>SequenceFlow_4</outgoing>
        </exclusiveGateway>

        <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_IsConnected" targetRef="Task_CollectInformation">
            <conditionExpression xsi:type="tFormalExpression">${connection == true}</conditionExpression>
        </sequenceFlow>

        <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_IsConnected" targetRef="EndEvent_1">
            <conditionExpression xsi:type="tFormalExpression">${connection == false}</conditionExpression>
        </sequenceFlow>

        <serviceTask id="Task_CollectInformation" name="Collect information from machine">
            <incoming>SequenceFlow_3</incoming>
            <outgoing>SequenceFlow_5</outgoing>
        </serviceTask>

        <sequenceFlow id="SequenceFlow_5" sourceRef="Task_CollectInformation" targetRef="Task_Calculate_OEE"/>

        <serviceTask id="Task_Calculate_OEE" name="Calculate OEE">
            <incoming>SequenceFlow_5</incoming>
            <outgoing>SequenceFlow_6</outgoing>
        </serviceTask>

        <sequenceFlow id="SequenceFlow_6" sourceRef="Task_Calculate_OEE" targetRef="ExclusiveGateway_IsOEEBelowThreshold"/>

        <exclusiveGateway id="ExclusiveGateway_IsOEEBelowThreshold">
            <incoming>SequenceFlow_6</incoming>
            <outgoing>SequenceFlow_7</outgoing>
            <outgoing>SequenceFlow_8</outgoing>
        </exclusiveGateway>

        <sequenceFlow id="SequenceFlow_7" sourceRef="ExclusiveGateway_IsOEEBelowThreshold" targetRef="Task_CollectInformation">
            <conditionExpression xsi:type="tFormalExpression">${oee > threshold}</conditionExpression>
        </sequenceFlow>

        <sequenceFlow id="SequenceFlow_8" sourceRef="ExclusiveGateway_IsOEEBelowThreshold" targetRef="Task_StopMachine">
            <conditionExpression xsi:type="tFormalExpression">${oee <= threshold}</conditionExpression>
        </sequenceFlow>

        <userTask id="Task_StopMachine" name="Stop the machine">
            <incoming>SequenceFlow_8</incoming>
            <outgoing>SequenceFlow_9</outgoing>
        </userTask>

        <sequenceFlow id="SequenceFlow_9" sourceRef="Task_StopMachine" targetRef="ServiceTask_SendEmail"/>

        <serviceTask id="ServiceTask_SendEmail" name="Send engineer an email">
            <incoming>SequenceFlow_9</incoming>
            <outgoing>SequenceFlow_10</outgoing>
        </serviceTask>

        <sequenceFlow id="SequenceFlow_10" sourceRef="ServiceTask_SendEmail" targetRef="ExclusiveGateway_HasEngineerResponded"/>

        <exclusiveGateway id="ExclusiveGateway_HasEngineerResponded">
            <incoming>SequenceFlow_10</incoming>
            <outgoing>SequenceFlow_11</outgoing>
            <outgoing>SequenceFlow_12</outgoing>
        </exclusiveGateway>

        <sequenceFlow id="SequenceFlow_11" sourceRef="ExclusiveGateway_HasEngineerResponded" targetRef="Task_RestartMachine">
            <conditionExpression xsi:type="tFormalExpression">${engineerHasResponded == true}</conditionExpression>
        </sequenceFlow>

        <sequenceFlow id="SequenceFlow_12" sourceRef="ExclusiveGateway_HasEngineerResponded" targetRef="EndEvent_1">
            <conditionExpression xsi:type="tFormalExpression">${engineerHasResponded == false}</conditionExpression>
        </sequenceFlow>

        <userTask id="Task_RestartMachine" name="Restart the machine">
            <incoming>SequenceFlow_11</incoming>
            <outgoing>SequenceFlow_13</outgoing>
        </userTask>

        <sequenceFlow id="SequenceFlow_13" sourceRef="Task_RestartMachine" targetRef="EndEvent_1"/>

        <endEvent id="EndEvent_1">
            <incoming>SequenceFlow_4</incoming>
            <incoming>SequenceFlow_13</incoming>
        </endEvent>

    </process>

</definitions>