<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definition" name="Internship Process"
             targetNamespace="http://example.com/internship">

   <process id="InternshipProcess" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="UserTask_EnterDetails"/>

     <userTask id="UserTask_EnterDetails" name="Enter desired topic, amount of money, experience and hobbies">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </userTask>

     <sequenceFlow id="SequenceFlow_2" sourceRef="UserTask_EnterDetails" targetRef="ServiceTask_OffersArrival"/>

     <serviceTask id="ServiceTask_OffersArrival" name="Offers arrival">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
     </serviceTask>

     <sequenceFlow id="SequenceFlow_3" sourceRef="ServiceTask_OffersArrival" targetRef="ExclusiveGateway_IsAccepted"/>

     <exclusiveGateway id="ExclusiveGateway_IsAccepted">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_4</outgoing>
       <outgoing>SequenceFlow_5</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_4" name="yes" sourceRef="ExclusiveGateway_IsAccepted" targetRef="ServiceTask_InvalidateOffers"/>

     <serviceTask id="ServiceTask_InvalidOtherOffers" name="Invalidate other offers">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </serviceTask>

     <sequenceFlow id="SequenceFlow_5" name="no" sourceRef="ExclusiveGateway_IsAccepted" targetRef="ParallelGateway_CompanyStatusUpdates"/>

     <parallelGateway id="ParallelGateway_CompanyStatusUpdates">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_7</outgoing>
       <outgoing>SequenceFlow_8</outgoing>
     </parallelGateway>

     <userTask id="UserTask_ApplicantUpdate" name="Write at least 3 status updates about your internship">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </userTask>

     <sequenceFlow id="SequenceFlow_7" sourceRef="ParallelGateway_CompanyStatusUpdates" targetRef="UserTask_ApplicantUpdate"/>

     <userTask id="UserTask_CompanyUpdate" name="The company has to write 3 status updates about you">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_10</outgoing>
     </userTask>

     <sequenceFlow id="SequenceFlow_8" sourceRef="ParallelGateway_CompanyStatusUpdates" targetRef="UserTask_CompanyUpdate"/>

     <exclusiveGateway id="ExclusiveGateway_UpdateCondition">
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_11</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_9" sourceRef="UserTask_ApplicantUpdate" targetRef="ExclusiveGateway_UpdateCondition"/>

     <parallelGateway id="ParallelGateway_Tweeting">
       <incoming>SequenceFlow_11</incoming>
       <outgoing>SequenceFlow_12</outgoing>
     </parallelGateway>

     <sequenceFlow id="SequenceFlow_11" sourceRef="ExclusiveGateway_UpdateCondition" targetRef="ParallelGateway_Tweeting"/>

     <userTask id="UserTask_SendTweets" name="Send separate tweets to friends in parallel">
       <incoming>SequenceFlow_12</incoming>
       <outgoing>SequenceFlow_13</outgoing>
     </userTask>

     <sequenceFlow id="SequenceFlow_12" sourceRef="ParallelGateway_Tweeting" targetRef="UserTask_SendTweets"/>

     <endEvent id="EndEvent_1" name="Internship finished and recommended">
       <incoming>SequenceFlow_13</incoming>
     </endEvent>

     <sequenceFlow id="SequenceFlow_13" sourceRef="UserTask_SendTweets" targetRef="EndEvent_1"/>
   </process>

</definitions>