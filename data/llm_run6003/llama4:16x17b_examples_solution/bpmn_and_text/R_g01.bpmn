<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd" 
             id="definition" name="DIY Repair of a Broken Smartphone Screen">

    <process id="Process_1" isExecutable="true">
      <startEvent id="StartEvent_1">
        <outgoing>SequenceFlow_1</outgoing>
      </startEvent>

      <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="ExclusiveGateway_Account"/>

      <exclusiveGateway id="ExclusiveGateway_Account">
        <incoming>SequenceFlow_1</incoming>
        <outgoing>SequenceFlow_2</outgoing>
        <outgoing>SequenceFlow_3</outgoing>
      </exclusiveGateway>

      <sequenceFlow id="SequenceFlow_2" sourceRef="ExclusiveGateway_Account" targetRef="Task_CreateAccount">
      </sequenceFlow>

      <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_Account" targetRef="Task_Login">
      </sequenceFlow>

      <userTask id="Task_CreateAccount" name="Create Account">
        <incoming>SequenceFlow_2</incoming>
        <outgoing>SequenceFlow_4</outgoing>
      </userTask>

      <sequenceFlow id="SequenceFlow_4" sourceRef="Task_CreateAccount" targetRef="Task_Login"/>

      <userTask id="Task_Login" name="Login">
        <incoming>SequenceFlow_3</incoming>
        <incoming>SequenceFlow_4</incoming>
        <outgoing>SequenceFlow_5</outgoing>
      </userTask>

      <sequenceFlow id="SequenceFlow_5" sourceRef="Task_Login" targetRef="Task_SelectDeviceModel"/>

      <userTask id="Task_SelectDeviceModel" name="Select Device Model">
        <incoming>SequenceFlow_5</incoming>
        <outgoing>SequenceFlow_6</outgoing>
      </userTask>

      <sequenceFlow id="SequenceFlow_6" sourceRef="Task_SelectDeviceModel" targetRef="ParallelGateway_MaterialsTools"/>

      <parallelGateway id="ParallelGateway_MaterialsTools">
        <incoming>SequenceFlow_6</incoming>
        <outgoing>SequenceFlow_7</outgoing>
        <outgoing>SequenceFlow_8</outgoing>
        <outgoing>SequenceFlow_9</outgoing>
      </parallelGateway>

      <sequenceFlow id="SequenceFlow_7" sourceRef="ParallelGateway_MaterialsTools" targetRef="Task_ListMaterials"/>

      <serviceTask id="Task_ListMaterials" name="List Materials">
        <incoming>SequenceFlow_7</incoming>
        <outgoing>SequenceFlow_10</outgoing>
      </serviceTask>

      <sequenceFlow id="SequenceFlow_10" sourceRef="Task_ListMaterials" targetRef="ParallelGateway_Converge"/>

      <sequenceFlow id="SequenceFlow_8" sourceRef="ParallelGateway_MaterialsTools" targetRef="Task_ListTools"/>

      <serviceTask id="Task_ListTools" name="List Tools">
        <incoming>SequenceFlow_8</incoming>
        <outgoing>SequenceFlow_11</outgoing>
      </serviceTask>

      <sequenceFlow id="SequenceFlow_11" sourceRef="Task_ListTools" targetRef="ParallelGateway_Converge"/>

      <sequenceFlow id="SequenceFlow_9" sourceRef="ParallelGateway_MaterialsTools" targetRef="Task_OfferOrderingChoices"/>

      <serviceTask id="Task_OfferOrderingChoices" name="Offer Ordering Choices">
        <incoming>SequenceFlow_9</incoming>
        <outgoing>SequenceFlow_12</outgoing>
      </serviceTask>

      <sequenceFlow id="SequenceFlow_12" sourceRef="Task_OfferOrderingChoices" targetRef="ParallelGateway_Converge"/>

      <parallelGateway id="ParallelGateway_Converge">
        <incoming>SequenceFlow_10</incoming>
        <incoming>SequenceFlow_11</incoming>
        <incoming>SequenceFlow_12</incoming>
        <outgoing>SequenceFlow_13</outgoing>
      </parallelGateway>

      <sequenceFlow id="SequenceFlow_13" sourceRef="ParallelGateway_Converge" targetRef="ExclusiveGateway_HaveItems"/>

      <exclusiveGateway id="ExclusiveGateway_HaveItems">
        <incoming>SequenceFlow_13</incoming>
        <outgoing>SequenceFlow_14</outgoing>
        <outgoing>SequenceFlow_15</outgoing>
      </exclusiveGateway>

      <sequenceFlow id="SequenceFlow_14" sourceRef="ExclusiveGateway_HaveItems" targetRef="Task_RepairDevice">
      </sequenceFlow>

      <sequenceFlow id="SequenceFlow_15" sourceRef="ExclusiveGateway_HaveItems" targetRef="Task_GetSecondHandItems"/>
      <userTask id="Task_GetSecondHandItems" name="Get Second-hand Items">
        <incoming>SequenceFlow_15</incoming>
        <outgoing>SequenceFlow_16</outgoing>
      </userTask>

      <sequenceFlow id="SequenceFlow_16" sourceRef="Task_GetSecondHandItems" targetRef="ExclusiveGateway_PurchaseItems"/>

      <exclusiveGateway id="ExclusiveGateway_PurchaseItems">
        <incoming>SequenceFlow_16</incoming>
        <outgoing>SequenceFlow_17</outgoing>
        <outgoing>SequenceFlow_18</outgoing>
      </exclusiveGateway>

      <sequenceFlow id="SequenceFlow_17" sourceRef="ExclusiveGateway_PurchaseItems" targetRef="Task_PurchaseItems">
      </sequenceFlow>

      <sequenceFlow id="SequenceFlow_18" sourceRef="ExclusiveGateway_PurchaseItems" targetRef="Task_RepairDevice"/>
      <userTask id="Task_PurchaseItems" name="Purchase Items">
        <incoming>SequenceFlow_17</incoming>
        <outgoing>SequenceFlow_19</outgoing>
      </userTask>

      <sequenceFlow id="SequenceFlow_19" sourceRef="Task_PurchaseItems" targetRef="Task_RepairDevice"/>

      <manualTask id="Task_RepairDevice" name="Repair Device">
        <incoming>SequenceFlow_14</incoming>
        <incoming>SequenceFlow_18</incoming>
        <incoming>SequenceFlow_19</incoming>
        <outgoing>SequenceFlow_20</outgoing>
      </manualTask>

      <sequenceFlow id="SequenceFlow_20" sourceRef="Task_RepairDevice" targetRef="ExclusiveGateway_IsFixed"/>

      <exclusiveGateway id="ExclusiveGateway_IsFixed">
        <incoming>SequenceFlow_20</incoming>
        <outgoing>SequenceFlow_21</outgoing>
        <outgoing>SequenceFlow_22</outgoing>
      </exclusiveGateway>

      <sequenceFlow id="SequenceFlow_21" sourceRef="ExclusiveGateway_IsFixed" targetRef="Task_WriteReview">
      </sequenceFlow>

      <sequenceFlow id="SequenceFlow_22" sourceRef="ExclusiveGateway_IsFixed" targetRef="Task_SendToExpert"/>

      <userTask id="Task_WriteReview" name="Write Review/Upload Video">
        <incoming>SequenceFlow_21</incoming>
        <outgoing>SequenceFlow_23</outgoing>
      </userTask>

      <sequenceFlow id="SequenceFlow_23" sourceRef="Task_WriteReview" targetRef="EndEvent_1"/>

      <manualTask id="Task_SendToExpert" name="Send to Expert">
        <incoming>SequenceFlow_22</incoming>
        <outgoing>SequenceFlow_24</outgoing>
      </manualTask>

      <sequenceFlow id="SequenceFlow_24" sourceRef="Task_SendToExpert" targetRef="EndEvent_1"/>

      <endEvent id="EndEvent_1">
        <incoming>SequenceFlow_23</incoming>
        <incoming>SequenceFlow_24</incoming>
      </endEvent>

    </process>

</definitions>