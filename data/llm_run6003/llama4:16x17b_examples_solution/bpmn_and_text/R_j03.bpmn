<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd" 
             id="definition" name="Service for Your Fridge">

   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="UserTask_1"/>

     <userTask id="UserTask_1" name="Describe the symptoms">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </userTask>

     <sequenceFlow id="SequenceFlow_2" sourceRef="UserTask_1" targetRef="ServiceTask_1"/>

     <serviceTask id="ServiceTask_1" name="Send a report to the fridge service center">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
     </serviceTask>

     <sequenceFlow id="SequenceFlow_3" sourceRef="ServiceTask_1" targetRef="ExclusiveGateway_1"/>

     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_4</outgoing>
       <outgoing>SequenceFlow_5</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_1" targetRef="ServiceTask_2">
       <conditionExpression xsi:type="tFormalExpression">${partsAvailable  == true}</conditionExpression>
     </sequenceFlow>

     <serviceTask id="ServiceTask_2" name="Schedule an appointment for fridge repair">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </serviceTask>

     <sequenceFlow id="SequenceFlow_6" sourceRef="ServiceTask_2" targetRef="IntermediateCatchEvent_1"/>

     <intermediateCatchEvent id="IntermediateCatchEvent_1">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_7</outgoing>
       <timerEventDefinition/>
     </intermediateCatchEvent>

     <sequenceFlow id="SequenceFlow_7" sourceRef="IntermediateCatchEvent_1" targetRef="ManualTask_1"/>

     <manualTask id="ManualTask_1" name="Repair the fridge">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_8</outgoing>
     </manualTask>

     <sequenceFlow id="SequenceFlow_8" sourceRef="ManualTask_1" targetRef="UserTask_2"/>

     <userTask id="UserTask_2" name="Confirm that fridge is okay">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </userTask>

     <sequenceFlow id="SequenceFlow_9" sourceRef="UserTask_2" targetRef="ExclusiveGateway_2"/>

     <exclusiveGateway id="ExclusiveGateway_2">
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_10</outgoing>
       <outgoing>SequenceFlow_11</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_10" sourceRef="ExclusiveGateway_2" targetRef="EndEvent_1"/>

     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_10</incoming>
     </endEvent>

     <sequenceFlow id="SequenceFlow_11" sourceRef="ExclusiveGateway_2" targetRef="UserTask_3"/>

     <userTask id="UserTask_3" name="Rate Service Facility">
       <incoming>SequenceFlow_11</incoming>
       <outgoing>SequenceFlow_12</outgoing>
     </userTask>

     <sequenceFlow id="SequenceFlow_12" sourceRef="UserTask_3" targetRef="EndEvent_2"/>

     <endEvent id="EndEvent_2">
       <incoming>SequenceFlow_12</incoming>
     </endEvent>

     <sequenceFlow id="SequenceFlow_5" sourceRef="ExclusiveGateway_1" targetRef="ServiceTask_3"/>
     <serviceTask id="ServiceTask_3" name="Order additional parts">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_13</outgoing>
     </serviceTask>

     <intermediateCatchEvent id="IntermediateCatchEvent_2">
       <incoming>SequenceFlow_13</incoming>
       <outgoing>SequenceFlow_14</outgoing>
       <!-- Use conditional event definition here -->
     </intermediateCatchEvent>

     <sequenceFlow id="SequenceFlow_13" sourceRef="ServiceTask_3" targetRef="IntermediateCatchEvent_2"/>
     <sequenceFlow id="SequenceFlow_14" sourceRef="IntermediateCatchEvent_2" targetRef="ManualTask_1"/>

   </process>
</definitions>