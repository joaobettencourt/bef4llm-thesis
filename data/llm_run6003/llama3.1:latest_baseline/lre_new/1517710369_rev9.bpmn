<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_0geryc1">
    <bpmn:participant id="Participant_0ygkg4f" name="Internet Purchase" processRef="Process_1"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_1viot5w" name="User Interaction"/>
      <bpmn:lane id="Lane_1ocseyo" name="System Processing"/>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Choose to pay with credit card">
      <bpmn:outgoing>SequenceFlow_14a0oky</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask_1" name="Put credit card details">
      <bpmn:incoming>SequenceFlow_14a0oky</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_023hzxi</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask_1" name="Check billing address">
      <bpmn:incoming>SequenceFlow_023hzxi</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1j94oja</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway_0p2e5vq" name="Billing address correct?">
      <bpmn:incoming>SequenceFlow_023hzxi</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1j94oja</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_0kz5g1t</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask_2" name="Modify billing address">
      <bpmn:incoming>SequenceFlow_0kz5g1t</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_023hzxi</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="SequenceFlow_14a0oky" sourceRef="StartEvent_1" targetRef="UserTask_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_023hzxi" sourceRef="UserTask_1" targetRef="ServiceTask_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_1j94oja" sourceRef="ExclusiveGateway_0p2e5vq" targetRef="ContinueButton_1"/>
    <bpmn:userTask id="ContinueButton_1" name="Click continue">
      <bpmn:incoming>SequenceFlow_1j94oja</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0iu9po7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask_2" name="Verify credit card">
      <bpmn:incoming>SequenceFlow_0iu9po7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1dlbln9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway_1dgb4sg" name="Credit card validated?">
      <bpmn:incoming>SequenceFlow_0iu9po7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0mp5byl</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_1pq8ub3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_1" name="Credit card added">
      <bpmn:incoming>SequenceFlow_0mp5byl</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_2" name="Addition cancelled">
      <bpmn:incoming>SequenceFlow_1pq8ub3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow_0iu9po7" sourceRef="ContinueButton_1" targetRef="ServiceTask_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_1dlbln9" sourceRef="ServiceTask_2" targetRef="ExclusiveGateway_1dgb4sg"/>
    <bpmn:sequenceFlow id="SequenceFlow_0mp5byl" sourceRef="ExclusiveGateway_1dgb4sg" targetRef="EndEvent_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_1pq8ub3" sourceRef="ExclusiveGateway_1dgb4sg" targetRef="EndEvent_2"/>
  </bpmn:process>
</bpmn:definitions>