<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_0geryc1">
    <bpmn:participant id="Participant_0ygkg4f" name="Payment Office of SSP" processRef="Process_1"/>
    <bpmn:participant id="Participant_1j9kq5a" name="Registry office" processRef="Process_1"/>
    <bpmn:participant id="Participant_1o8h6yv" name="Accounts Receivable Department" processRef="Process_1"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_0e4qy6a" name="Payment Office of SSP">
        <bpmn:flowNodeRef>Task_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SequenceFlow_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_0j9w6xu" name="Registry office">
        <bpmn:flowNodeRef>Task_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SequenceFlow_3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_0s6x8qz" name="Accounts Receivable Department">
        <bpmn:flowNodeRef>Task_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SequenceFlow_5</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="End of week">
      <bpmn:outgoing>SequenceFlow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_1" name="Generate payment report">
      <bpmn:incoming>SequenceFlow_0</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_0" sourceRef="StartEvent_1" targetRef="Task_1"/>
    <bpmn:serviceTask id="ServiceTask_1" name="Pay vendor">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="Task_1" targetRef="ServiceTask_1"/>
    <bpmn:endEvent id="EndEvent_1" name="Payment completed">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="ServiceTask_1" targetRef="EndEvent_1"/>
    <bpmn:task id="Task_2" name="Send payment report to clients">
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="ServiceTask_1" targetRef="Task_2"/>
    <bpmn:serviceTask id="ServiceTask_2" name="Send payment report to Registry office">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="Task_2" targetRef="ServiceTask_2"/>
    <bpmn:endEvent id="EndEvent_2" name="Report sent">
      <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="ServiceTask_2" targetRef="EndEvent_2"/>
    <bpmn:startEvent id="StartEvent_2" name="Generate monthly invoice">
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_3" name="Charge client $35 per invoice">
      <bpmn:incoming>SequenceFlow_7</bpmn:incoming>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="StartEvent_2" targetRef="Task_3"/>
    <bpmn:endEvent id="EndEvent_3" name="Invoice sent">
      <bpmn:incoming>SequenceFlow_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow_7" sourceRef="Task_3" targetRef="EndEvent_3"/>
    <bpmn:startEvent id="StartEvent_3" name="Archive invoices">
      <bpmn:outgoing>SequenceFlow_9</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="EndEvent_4" name="Archiving completed">
      <bpmn:incoming>SequenceFlow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow_9" sourceRef="StartEvent_3" targetRef="EndEvent_4"/>
    <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="EndEvent_4" targetRef="EndEvent_2"/>
  </bpmn:process>
