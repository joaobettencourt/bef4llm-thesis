    <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="EndEvent_1" targetRef="ServiceTask_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="StartEvent_2" targetRef="ServiceTask_3"/>
    <bpmn:sequenceFlow id="SequenceFlow_7" sourceRef="EndEvent_2" targetRef="ServiceTask_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_8" sourceRef="StartEvent_2" targetRef="ServiceTask_3"/>
    <bpmn:sequenceFlow id="SequenceFlow_9" sourceRef="ServiceTask_3" targetRef="EndEvent_3"/>
  </bpmn:process>
