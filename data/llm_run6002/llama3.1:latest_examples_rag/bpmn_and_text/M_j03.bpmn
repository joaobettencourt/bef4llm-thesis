        <bpmn:sequenceFlow id="SequenceFlow_23kqzr5" name="If parts available"
                           sourceRef="ParallelGateway_02fgrfq" targetRef="ExclusiveGateway_0p2e5vq"/>
        <bpmn:endEvent id="EndEvent_1fx9yp3" name="Order completed">
