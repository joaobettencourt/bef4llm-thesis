      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:endEvent id="EndEvent_1" name="INQ notified">
      <bpmn:incoming>SequenceFlow_0v64x8b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="IntermediateCatchingEvent_0" name="INQ receives notification">
