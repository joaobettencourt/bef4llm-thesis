      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="EC tells INQ about change">
      <bpmn:outgoing>SequenceFlow_14a0oky</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_12j0pib" name="Notify INQ of change">
