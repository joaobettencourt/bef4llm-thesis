  <bpmn:sequenceFlow id="SequenceFlow_7" sourceRef="Task_3" targetRef="EndEvent_1"/>
  <bpmn:sequenceFlow id="SequenceFlow_8" sourceRef="StartEvent_3" targetRef="Task_4"/>
  <bpmn:sequenceFlow id="SequenceFlow_9" sourceRef="Task_4" targetRef="ExclusiveGateway_3"/>
  <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="ExclusiveGateway_3" targetRef="Task_5"/>
  <bpmn:sequenceFlow id="SequenceFlow_11" sourceRef="ExclusiveGateway_3" targetRef="EndEvent_2"/>
  <bpmn:sequenceFlow id="SequenceFlow_12" sourceRef="Task_5" targetRef="EndEvent_2"/>
