<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_RestaurantOrderProcess_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_Restaurant_OrderProcessing">
    <bpmn:participant id="Participant_Guest_FoodConsumption" name="Guest - Food Consumption Process" processRef="Process_Guest_1"/>
    <bpmn:participant id="Participant_Employee_OrderProcessing" name="Employee - Order Processing" processRef="Process_Employee_2"/>
    <bpmn:participant id="Participant_Chef_MealPreparation" name="Chef - Meal Preparation Process" processRef="Process_Chef_3"/>

    <!-- Message Flows between participants -->
    <bpmn:messageFlow id="MessageFlow_GuestToEmployee_OrderReceived" sourceRef="Task_Guest_PlaceOrder" targetRef="StartEvent_Employee_OrderReceived"/>
    <bpmn:messageFlow id="MessageFlow_EmployeeToGuest_BuzzerReady" sourceRef="Task_Employee_SetOffBuzzer" targetRef="IntermediateCatchEvent_Guest_MealReady"/>
    <bpmn:messageFlow id="MessageFlow_EmployeeToChef_NewOrderNotification" sourceRef="Task_Employee_InformChef" targetRef="StartEvent_Chef_MealNeeded"/>
    <bpmn:messageFlow id="MessageFlow_ChefToEmployee_MealInHatchReady" sourceRef="Task_Chef_InformEmployee" targetRef="IntermediateCatchEvent_Employee_MealReady"/>

  </bpmn:collaboration>

  <!-- Guest Process -->
  <bpmn:process id="Process_Guest_1">
    <bpmn:startEvent id="StartEvent_Guest_HungerNoticed" name="Hunger noticed">
      <bpmn:outgoing>SequenceFlow_Guest_StartToEnter</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_Guest_EnterRestaurant" name="Enter restaurant">
      <bpmn:incoming>SequenceFlow_Guest_StartToEnter</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Guest_ToChooseDish</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_Guest_ChooseDish" name="Choose dish">
      <bpmn:incoming>SequenceFlow_Guest_ToChooseDish</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Guest_WaitForTurn</bpmn:outgoing>
    </bpmn:task>

    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_Guest_Waiting" name="Wait for turn">
      <bpmn:incoming>SequenceFlow_Guest_WaitForTurn</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Guest_ToPlaceOrder</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:task id="Task_Guest_PlaceOrder" name="Place order with employee">
      <bpmn:incoming>SequenceFlow_Guest_ToPlaceOrder</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Guest_ToReceiveBuzzer</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_Guest_ReceiveBuzzer" name="Take buzzer">
      <bpmn:incoming>SequenceFlow_Guest_ToReceiveBuzzer</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Guest_WaitForMealReady</bpmn:outgoing>
    </bpmn:task>

    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_Guest_MealReady" name="Meal ready (Buzzer rings)">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SequenceFlow_Guest_WaitForMealReady</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Guest_ToGetMeal</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:task id="Task_Guest_GetMeal" name="Pick up meal">
      <bpmn:incoming>SequenceFlow_Guest_ToGetMeal</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Guest_EatMeal</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_Guest_EatMeal" name="Eat meal">
      <bpmn:incoming>SequenceFlow_Guest_EatMeal</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Guest_EndHungry</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_Guest_HungryNoMore" name="Not hungry anymore">
      <bpmn:incoming>SequenceFlow_Guest_EndHungry</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_Guest_StartToEnter" sourceRef="StartEvent_Guest_HungerNoticed" targetRef="Task_Guest_EnterRestaurant"/>
    <bpmn:sequenceFlow id="SequenceFlow_Guest_ToChooseDish" sourceRef="Task_Guest_EnterRestaurant" targetRef="Task_Guest_ChooseDish"/>
    <bpmn:sequenceFlow id="SequenceFlow_Guest_WaitForTurn" sourceRef="Task_Guest_ChooseDish" targetRef="IntermediateCatchEvent_Guest_Waiting"/>
    <bpmn:sequenceFlow id="SequenceFlow_Guest_ToPlaceOrder" name="Wait for turn completed" sourceRef="IntermediateCatchEvent_Guest_Waiting" targetRef="Task_Guest_PlaceOrder"/>
    <bpmn:sequenceFlow id="SequenceFlow_Guest_ToReceiveBuzzer" sourceRef="Task_Guest_PlaceOrder" targetRef="Task_Guest_ReceiveBuzzer"/>
    <bpmn:sequenceFlow id="SequenceFlow_Guest_WaitForMealReady" name="Wait for buzzer signal" sourceRef="Task_Guest_ReceiveBuzzer" targetRef="IntermediateCatchEvent_Guest_MealReady"/>
    <bpmn:sequenceFlow id="SequenceFlow_Guest_ToGetMeal" sourceRef="IntermediateCatchEvent_Guest_MealReady" targetRef="Task_Guest_GetMeal"/>
    <bpmn:sequenceFlow id="SequenceFlow_Guest_EatMeal" name="Pick up meal and eat" sourceRef="Task_Guest_GetMeal" targetRef="Task_Guest_EatMeal"/>
    <bpmn:sequenceFlow id="SequenceFlow_Guest_EndHungry" sourceRef="Task_Guest_EatMeal" targetRef="EndEvent_Guest_HungryNoMore"/>

  </bpmn:process>

  <!-- Employee Process -->
  <bpmn:process id="Process_Employee_2">
    <bpmn:startEvent id="StartEvent_Employee_OrderReceived" name="Order received (from guest)">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_Employee_StartToEnterPOS</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_Employee_EnterOrder" name="Enter order into POS system">
      <bpmn:incoming>SequenceFlow_Employee_StartToEnterPOS</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Employee_ToCollectMoney</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_Employee_CollectMoney" name="Collect money from guest">
      <bpmn:incoming>SequenceFlow_Employee_ToCollectMoney</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Employee_SetBuzzer</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_Employee_SetBuzzer" name="Set up buzzer">
      <bpmn:incoming>SequenceFlow_Employee_SetBuzzer</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Employee_HandOverBuzzer</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_Employee_HandOverBuzzer" name="Hand over buzzer to guest">
      <bpmn:incoming>SequenceFlow_Employee_HandOverBuzzer</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Employee_InformChef</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_Employee_InformChef" name="Inform chef of new order">
      <bpmn:incoming>SequenceFlow_Employee_HandOverBuzzer</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Employee_WaitForMealReady</bpmn:outgoing>
    </bpmn:task>

    <bpmn:eventBasedGateway id="EventBasedGateway_Employee_MealOrTimeout" name="Wait for meal or timeout">
      <bpmn:incoming>SequenceFlow_Employee_WaitForMealReady</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Employee_ToRingBuzzer</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_Employee_Timeout5Min</bpmn:outgoing>
    </bpmn:eventBasedGateway>

    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_Employee_MealReady" name="Meal ready (from chef)">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SequenceFlow_Employee_WaitForMealReady</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Employee_ToRingBuzzer</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:task id="Task_Employee_RingBuzzer" name="Set off guest's buzzer">
      <bpmn:incoming>SequenceFlow_Employee_ToRingBuzzer</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Employee_WaitForGuestAppears</bpmn:outgoing>
    </bpmn:task>

    <bpmn:eventBasedGateway id="EventBasedGateway_Employee_GuestOrTimeout" name="Wait for guest or timeout">
      <bpmn:incoming>SequenceFlow_Employee_WaitForGuestAppears</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Employee_ToHandOverMeal</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_Employee_Timeout5MinAgain</bpmn:outgoing>
    </bpmn:eventBasedGateway>

    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_Employee_GuestAppears" name="Guest appears at hatch">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SequenceFlow_Employee_WaitForGuestAppears</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Employee_ToHandOverMeal</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:task id="Task_Employee_HandOverMeal" name="Hand over meal to guest">
      <bpmn:incoming>SequenceFlow_Employee_ToHandOverMeal</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Employee_EndOrderProcessed</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_Employee_OrderProcessed" name="Order processed">
      <bpmn:incoming>SequenceFlow_Employee_EndOrderProcessed</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Timeout handling for guest not reacting -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_Employee_Timeout5Min" name="Wait 5 minutes">
      <bpmn:timerEventDefinition/>
      <bpmn:incoming>SequenceFlow_Employee_Timeout5Min</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Employee_CallGuest</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:task id="Task_Employee_CallGuest" name="Call guest">
      <bpmn:incoming>SequenceFlow_Employee_CallGuest</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Employee_WaitForGuestAppearsAgain</bpmn:outgoing>
    </bpmn:task>

    <!-- Loop back to wait for guest -->
    <bpmn:sequenceFlow id="SequenceFlow_Employee_CallGuestLoop" sourceRef="Task_Employee_CallGuest" targetRef="EventBasedGateway_Employee_GuestOrTimeout"/>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_Employee_StartToEnterPOS" name="Order received from guest" sourceRef="StartEvent_Employee_OrderReceived" targetRef="Task_Employee_EnterOrder"/>
    <bpmn:sequenceFlow id="SequenceFlow_Employee_ToCollectMoney" name="Enter order into POS system" sourceRef="Task_Employee_EnterOrder" targetRef="Task_Employee_CollectMoney"/>
    <bpmn:sequenceFlow id="SequenceFlow_Employee_SetBuzzer" name="After payment, set up buzzer" sourceRef="Task_Employee_CollectMoney" targetRef="Task_Employee_SetBuzzer"/>
    <bpmn:sequenceFlow id="SequenceFlow_Employee_HandOverBuzzer" name="Hand over buzzer to guest with info" sourceRef="Task_Employee_SetBuzzer" targetRef="Task_Employee_HandOverBuzzer"/>
    <bpmn:sequenceFlow id="SequenceFlow_Employee_InformChef" name="Inform chef of new order (message)" sourceRef="Task_Employee_HandOverBuzzer" targetRef="Task_Employee_InformChef"/>
    <bpmn:sequenceFlow id="SequenceFlow_Employee_WaitForMealReady" name="Wait for chef notification (message)" sourceRef="Task_Employee_InformChef" targetRef="IntermediateCatchEvent_Employee_MealReady"/>

  </bpmn:process>

  <!-- Chef Process -->
  <bpmn:process id="Process_Chef_3">
    <bpmn:startEvent id="StartEvent_Chef_MealNeeded" name="Meal needed (from employee)">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_Chef_StartToPrepare</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_Chuf_PrepareMeal" name="Prepare meal">
      <bpmn:incoming>SequenceFlow_Chef_StartToPrepare</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Chuf_ToPlaceInHatch</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_Chuf_PlaceMealInHatch" name="Place meal in service hatch">
      <bpmn:incoming>SequenceFlow_Chuf_ToPlaceInHatch</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Chef_InformEmployee</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_Chef_InformEmployee" name="Inform employee meal is ready">
      <bpmn:incoming>SequenceFlow_Chef_InformEmployee</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Chuf_EndMealPrepared</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_Chef_MealPrepared" name="Meal prepared">
      <bpmn:incoming>SequenceFlow_Chuf_EndMealPrepared</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_Chef_StartToPrepare" name="Receive order notification (message)" sourceRef="StartEvent_Chef_MealNeeded" targetRef="Task_Chuf_PrepareMeal"/>
    <bpmn:sequenceFlow id="SequenceFlow_Chuf_ToPlaceInHatch" name="Prepare meal and place in hatch (message)" sourceRef="Task_Chuf_PrepareMeal" targetRef="Task_Chuf_PlaceMealInHatch"/>
    <bpmn:sequenceFlow id="SequenceFlow_Chef_InformEmployee" name="Notify employee meal ready (message)" sourceRef="Task_Chuf_PlaceMealInHatch" targetRef="Task_Chef_InformEmployee"/>
    <bpmn:sequenceFlow id="SequenceFlow_Chuf_EndMealPrepared" name="Complete meal preparation (message)" sourceRef="Task_Chef_InformEmployee" targetRef="EndEvent_Chef_MealPrepared"/>

  </bpmn:process>

</bpmn:definitions>