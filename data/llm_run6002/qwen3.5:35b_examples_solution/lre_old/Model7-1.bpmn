<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_LeadProcess_Corrected" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_LeadProcessing">
    <bpmn:participant id="Participant_LeadSys" name="Lead Processing System" processRef="Process_001"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_001" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Manager" name="Manager">
        <bpmn:flowNodeRef>StartEvent_CheckLeads</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectTopFive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_Interested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ProcessedLead</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SalesAssistant" name="Sales Assistant">
        <bpmn:flowNodeRef>Task_CallContactPerson</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_CheckLeads" name="Check open leads">
      <bpmn:outgoing>SequenceFlow_StartToSelect</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Select top five -->
    <bpmn:task id="Task_SelectTopFive" name="Select top five leads">
      <bpmn:incoming>SequenceFlow_StartToSelect</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToCallContactPerson</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: Call contact person -->
    <bpmn:task id="Task_CallContactPerson" name="Call contact person">
      <bpmn:incoming>SequenceFlow_ToCallContactPerson</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_LoopNextCustomer</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CallToGateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for decision -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_Interested" name="Customer interested?">
      <bpmn:name>Cust. Interested?</bpmn:name>
      <bpmn:incoming>SequenceFlow_CallToGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InterestedPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NotInterestedLoop</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_ProcessedLead" name="Lead processed">
      <bpmn:incoming>SequenceFlow_InterestedPath</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToSelect" sourceRef="StartEvent_CheckLeads" targetRef="Task_SelectTopFive"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ToCallContactPerson" name="" sourceRef="Task_SelectTopFive" targetRef="Task_CallContactPerson">
      <bpmn:name>Tell Sales Assistant</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_CallToGateway" sourceRef="Task_CallContactPerson" targetRef="ExclusiveGateway_Interested"/>

    <!-- Decision paths -->
    <bpmn:sequenceFlow id="SequenceFlow_InterestedPath" name="Yes - interested" sourceRef="ExclusiveGateway_Interested" targetRef="EndEvent_ProcessedLead">
      <bpmn:name>Send note to Manager</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Loop back for next customer -->
    <bpmn:sequenceFlow id="SequenceFlow_NotInterestedLoop" name="No - not interested" sourceRef="ExclusiveGateway_Interested" targetRef="Task_CallContactPerson">
      <bpmn:name>Call next customer</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>