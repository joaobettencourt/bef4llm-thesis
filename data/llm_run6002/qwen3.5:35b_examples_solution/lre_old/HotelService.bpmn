<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_001">
    <bpmn:participant id="Participant_HotelRoomService" name="Hotel Room Service" processRef="Process_RoomService"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_RoomService" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Manager" name="Room-Service Manager">
        <bpmn:flowNodeRef>StartEvent_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TakeOrder</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Kitchen" name="Kitchen">
        <bpmn:flowNodeRef>Task_PrepareFood</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sommelier" name="Sommelier">
        <bpmn:flowNodeRef>Gateway_AlcoholicInclusive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FetchWine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareAlcohol</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Waiter" name="Waiter">
        <bpmn:flowNodeRef>Gateway_SyncCart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReadyCart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_NonAlcoholicDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareNonAlcohol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SyncAll</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DeliverToRoom</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_001</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_001" name="Guest calls room service">
      <bpmn:outgoing>SequenceFlow_TakeOrder</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Manager Tasks and Gateway -->
    <bpmn:task id="Task_TakeOrder" name="Take down order ticket">
      <bpmn:incoming>SequenceFlow_TakeOrder</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SubmitKitchen</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway for Manager to Kitchen and Sommelier -->
    <bpmn:parallelGateway id="ParallelManagerSplit">
      <bpmn:name/>
      <bpmn:incoming>SequenceFlow_SubmitKitchen</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToKitchen</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_AlcoholicDecision</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Kitchen Task -->
    <bpmn:task id="Task_PrepareFood" name="Prepare food">
      <bpmn:name/>
      <bpmn:incoming>SequenceFlow_ToKitchen</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FoodReadyToSyncCart</bpmn:outgoing>
    </bpmn:task>

    <!-- Alcoholic Beverages Decision (80% probability) -->
    <bpmn:exclusiveGateway id="Gateway_AlcoholicDecision" name="Alcoholic beverages ordered?">
      <bpmn:name/>
      <bpmn:incoming>SequenceFlow_AlcoholicDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GiveToSommelierYes</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sommelier Tasks -->
    <bpmn:task id="Task_FetchWine" name="Fetch wine from cellar">
      <bpmn:name/>
      <bpmn:incoming>SequenceFlow_GiveToSommelierYes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WineReady</bpmn:outgoing>
    </bpmn:task>

    <bpmn:inclusiveGateway id="Gateway_AlcoholicInclusive" name="">
      <bpmn:name/>
      <bpmn:incoming>SequenceFlow_GiveToSommelierYes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToAlcoholPrep</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <bpmn:task id="Task_PrepareAlcohol" name="Prepare alcoholic beverages">
      <bpmn:name/>
      <bpmn:incoming>SequenceFlow_ToAlcoholPrep</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AlcoholReadyToSyncAll</bpmn:outgoing>
    </bpmn:task>

    <!-- Waiter Tasks -->
    <bpmn:parallelGateway id="ParallelWaiterStart">
      <bpmn:name/>
      <bpmn:incoming>SequenceFlow_AssignToWaiter</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReadyCart</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:task id="Task_ReadyCart" name="Ready cart (tablecloth, silverware)">
      <bpmn:name/>
      <bpmn:incoming>SequenceFlow_ReadyCart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CartToNonAlcoholicDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Non-Alcoholic Drinks Decision -->
    <bpmn:exclusiveGateway id="Gateway_NonAlcoholicDecision" name="Non-alcoholic drinks needed?">
      <bpmn:name/>
      <bpmn:incoming>SequenceFlow_CartToNonAlcoholicDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PrepareNonAlcoholYes</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_PrepareNonAlcohol" name="Prepare non-alcoholic drinks">
      <bpmn:name/>
      <bpmn:incoming>SequenceFlow_PrepareNonAlcoholYes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NonAlcoholReadyToSyncAll</bpmn:outgoing>
    </bpmn:task>

    <!-- Synchronization Gateway for Cart, Food -->
    <bpmn:parallelGateway id="Gateway_SyncCart">
      <bpmn:name/>
      <bpmn:incoming>SequenceFlow_FoodReadyToSyncCart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToNonAlcoholicDecision</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Final Synchronization before Delivery -->
    <bpmn:parallelGateway id="Gateway_SyncAll">
      <bpmn:name/>
      <bpmn:incoming>SequenceFlow_AlcoholReadyToSyncCart</bpmn:outgoing>
      <bpmn:incoming>SequenceFlow_NonAlcoholReadyToSyncAll</bpmn:incoming>
    </bpmn:parallelGateway>

    <!-- Delivery and Billing -->
    <bpmn:endEvent id="EndEvent_001" name="Order delivered">
      <bpmn:name/>
      <bpmn:incoming>SequenceFlow_DoneAfterBilling</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_TakeOrder" sourceRef="StartEvent_001" targetRef="Task_TakeOrder"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_SubmitKitchen" name="" sourceRef="Task_TakeOrder" targetRef="ParallelManagerSplit"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ToKitchen" name="" sourceRef="ParallelManagerSplit" targetRef="Task_PrepareFood"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_AlcoholicDecision" name="" sourceRef="ParallelManagerSplit" targetRef="Gateway_AlcoholicDecision"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_GiveToSommelierYes" name="yes (80%)" sourceRef="Gateway_AlcoholicDecision" targetRef="Task_FetchWine"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ToAlcoholPrep" name="" sourceRef="Gateway_AlcoholicInclusive" targetRef="Task_PrepareAlcohol"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_WineReady" name="" sourceRef="Task_FetchWine" targetRef="Gateway_SyncCart"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_AlcoholReadyToSyncAll" name="" sourceRef="Task_PrepareAlcohol" targetRef="Gateway_SyncAll"/>

    <!-- Waiter Assignment -->
    <bpmn:task id="Task_AssignWaiter" name="Assign order to waiter">
      <bpmn:name/>
      <bpmn:incoming>SequenceFlow_GiveToSommelierYes</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_AssignToWaiter</bpmn:outgoing>
    </bpmn:task>

    <!-- Waiter Cart and Non-Alcoholic Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_ReadyCart" name="" sourceRef="ParallelWaiterStart" targetRef="Task_ReadyCart"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_CartToNonAlcoholicDecision" name="" sourceRef="Task_ReadyCart" targetRef="Gateway_NonAlcoholicDecision"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_PrepareNonAlcoholYes" name="yes" sourceRef="Gateway_NonAlcoholicDecision" targetRef="Task_PrepareNonAlcohol"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_NonAlcoholReadyToSyncAll" name="" sourceRef="Task_PrepareNonAlcohol" targetRef="Gateway_SyncAll"/>

    <!-- Synchronization and Delivery -->
    <bpmn:parallelGateway id="ParallelWaiterStart2">
      <bpmn:name/>
      <bpmn:incoming>SequenceFlow_AssignToWaiter</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ReadyCart</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Final Synchronization -->
    <bpmn:sequenceFlow id="SequenceFlow_SyncAllToDelivery" name="" sourceRef="Gateway_SyncAll" targetRef="EndEvent_001"/>
    
  </bpmn:process>
</bpmn:definitions>