<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_BillExamination">
    <bpmn:participant id="Participant_MPOO" name="MPOO" processRef="Process_MPOO"/>
    <bpmn:participant id="Participant_GO" name="GO" processRef="Process_GO"/>
    <bpmn:participant id="Participant_MSPO" name="MSPO" processRef="Process_MSPO"/>
    <bpmn:participant id="Participant_MPON" name="MPON" processRef="Process_MPON"/>

    <!-- Message Flows -->
    <bpmn:messageFlow id="Message_MeteringBill_GO" sourceRef="Task_SendMeteringBill" targetRef="IntermediateCatchEvent_GOMetering"/>
    <bpmn:messageFlow id="Message_EquipBill_TO_GO" sourceRef="Gateway_RouteEquipToGO" targetRef="IntermediateCatchEvent_GOEquipment"/>
    <bpmn:messageFlow id="Message_EquipBill_TO_MPON" sourceRef="Gateway_RouteEquipToMPON" targetRef="IntermediateCatchEvent_MPONEquipment"/>
    <bpmn:messageFlow id="Message_MeasurementBill_GO" sourceRef="Task_SendMeasurementBill" targetRef="IntermediateCatchEvent_GOMeasurement"/>
    <bpmn:messageFlow id="Message_AdditionalReadingsBill_GO" sourceRef="Task_SendAdditionalReadingsBill" targetRef="IntermediateCatchEvent_GOAddReading"/>

    <!-- Response Flows -->
    <bpmn:messageFlow id="Msg_Confirm_Metering" sourceRef="Task_ConfirmMetering" targetRef="IntermediateCatchResponse_GOMetering"/>
    <bpmn:messageFlow id="Msg_Reject_Metering" sourceRef="Task_RejectMetering" targetRef="IntermediateCatchResponse_GOMetering"/>

    <bpmn:messageFlow id="Msg_Confirm_Equip_GO" sourceRef="Task_ConfirmEquipmentGO" targetRef="IntermediateCatchResponse_EQUIP_GO"/>
    <bpmn:messageFlow id="Msg_Reject_Equip_GO" sourceRef="Task_RejectEquipmentGO" targetRef="IntermediateCatchResponse_EQUIP_GO"/>

    <bpmn:messageFlow id="Msg_Confirm_Measurement" sourceRef="Task_ConfirmMeasurement" targetRef="IntermediateCatchResponse_GOMeasurement"/>
    <bpmn:messageFlow id="Msg_Reject_Measurement" sourceRef="Task_RejectMeasurement" targetRef="IntermediateCatchResponse_GOMeasurement"/>

    <bpmn:messageFlow id="Msg_Confirm_AdditionalReadings" sourceRef="Task_ConfirmAdditionalReadings" targetRef="IntermediateCatchResponse_GOAddReading"/>
    <bpmn:messageFlow id="Msg_Reject_AdditionalReadings" sourceRef="Task_RejectAdditionalReadings" targetRef="IntermediateCatchResponse_GOAddReading"/>

    <bpmn:messageFlow id="Msg_Confirm_Equip_MPON" sourceRef="Task_ConfirmEquipmentMPON" targetRef="IntermediateCatchResponse_EQUIP_MPON"/>
    <bpmn:messageFlow id="Msg_Reject_Equip_MPON" sourceRef="Task_RejectEquipmentMPON" targetRef="IntermediateCatchResponse_EQUIP_MPON"/>

  </bpmn:collaboration>

  <!-- MPOO Process -->
  <bpmn:process id="Process_MPOO" isExecutable="false">
    <bpmn:startEvent id="StartMPOO1" name="Initiate Metering Bill Send">
      <bpmn:outgoing>SequenceFlow_StartToMetering</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task to Send Metering Bill -->
    <bpmn:task id="Task_SendMeteringBill" name="Send Bill (Metering Operations)">
      <bpmn:incoming>SequenceFlow_StartToMetering</bpmn:outgoing/> 
      <bpmn:outgoing>SequenceFlow_MeteringSent</bpmn:outgoing/>
    </bpmn:task>

    <!-- Start Event for Equipment Bill -->
    <bpmn:startEvent id="StartMPOO2" name="Initiate Equipment Bill Send">
      <bpmn:outgoing>SequenceFlow_StartToEquip</bpmn:outgoing/>
    </bpmn:startEvent>

    <!-- Task to Send Equipment Bill -->
    <bpmn:task id="Task_SendEquipmentBill" name="Send Bill (Equipment Acquisition)">
      <bpmn:incoming>SequenceFlow_StartToEquip</bpmn:outgoing/> 
      <bpmn:outgoing>Gateway_RouteEquipToGO</bpmn:outgoing/>
    </bpmn:task>

    <!-- Gateway for Equipment Bill Routing -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_EquipRoute">
        <bpmn:name>Select Recipient?</bpmn:name>
      <bpmn:incoming>SequenceFlow_StartToEquip</bpmn:outgoing/> 
      <bpmn:outgoing>SequenceFlow_RouteToGO</bpmn:outgoing/>
      <bpmn:outgoing>SequenceFlow_RouteToMPON</bpmn:outgoing/>
    </bpmn:exclusiveGateway>

    <!-- Intermediate Catching Events for Responses -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchResponse_GOMetering" name="Wait Response (Metering)">
      <bpmn:incoming>SequenceFlow_MeteringSent</bpmn:outgoing/> 
      <bpmn:outgoing>SequenceFlow_ResponseReceivedMPOO1</bpmn:outgoing/>
    </bpmn:intermediateCatchEvent>

    <bpmn:intermediateCatchEvent id="IntermediateCatchResponse_EQUIP_GO" name="Wait Response (Equip GO)">
      <bpmn:incoming>SequenceFlow_EquipSentGO</bpmn:outgoing/> 
      <bpmn:outgoing>SequenceFlow_ResponseReceivedMPOO2</bpmn:outgoing/>
    </bpmn:intermediateCatchEvent>

    <bpmn:intermediateCatchEvent id="IntermediateCatchResponse_EQUIP_MPON" name="Wait Response (Equip MPON)">
      <bpmn:incoming>SequenceFlow_EquipSentMPON</bpmn:outgoing/> 
      <bpmn:outgoing>SequenceFlow_ResponseReceivedMPOO3</bpmn:outgoing/>
    </bpmn:intermediateCatchEvent>

    <!-- End Event -->
    <bpmn:endEvent id="EndMPOO" name="Process Completed">
      <bpmn:incoming>SequenceFlow_ResponseReceivedMPOO1</bpmn:outgoing/> 
      <bpmn:incoming>SequenceFlow_ResponseReceivedMPOO2</bpmn:outgoing/> 
      <bpmn:incoming>SequenceFlow_ResponseReceivedMPOO3</bpmn:outgoing/>
    </bpmn:endEvent>

    <!-- Sequence Flows MPOO Internal -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToMetering" sourceRef="StartMPOO1" targetRef="Task_SendMeteringBill"/>
    <bpmn:sequenceFlow id="SequenceFlow_MeteringSent" name="" sourceRef="Task_SendMeteringBill" targetRef="IntermediateCatchResponse_GOMetering"/>

    <!-- Equipment Flow -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_StartEquip">
        <bpmn:name>Send Equip Bill?</bpmn:name>
      <bpmn:incoming>SequenceFlow_StartToMetering</bpmn:outgoing/> 
      <bpmn:outgoing>SequenceFlow_StartToMetering2</bpmn:outgoing/>
    </bpmn:exclusiveGateway>

    <!-- Merging Logic for Response Handling -->
    <bpmn:sequenceFlow id="SequenceFlow_ResponseReceivedMPOO1" sourceRef="IntermediateCatchResponse_GOMetering" targetRef="EndMPOO"/>
    <bpmn:sequenceFlow id="SequenceFlow_EquipSentGO" name="" sourceRef="Gateway_RouteEquipToGO" targetRef="IntermediateCatchResponse_EQUIP_GO"/>
    <bpmn:sequenceFlow id="SequenceFlow_EquipSentMPON" name="" sourceRef="Gateway_RouteEquipToMPON" targetRef="IntermediateCatchResponse_EQUIP_MPON"/>

  </bpmn:process>

  <!-- GO Process -->
  <bpmn:process id="Process_GO" isExecutable="false">
    <bpmn:startEvent id="StartGO1" name="Bill Received (Metering)">
      <bpmn:outgoing>SequenceFlow_StartToExamine</bpmn:outgoing/>
    </bpmn:startEvent>

    <!-- Catching Event for Metering Bill -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_GOMetering" name="Bill (Metering)">
      <bpmn:incoming>SequenceFlow_StartToExamine</bpmn:outgoing/> 
       <bpmn:outgoing>SequenceFlow_ExamineMetering</bpmn:outgoing/>
    </bpmn:intermediateCatchEvent>

    <!-- Catching Event for Measurement Bill -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_GOMeasurement" name="Bill (Measurement)">
       <bpmn:incoming>SequenceFlow_StartToExamine2</bpmn:outgoing/> 
        <bpmn:outgoing>SequenceFlow_ExamineMeasurement</bpmn:outgoing/>
    </bpmn:intermediateCatchEvent>

    <!-- Catching Event for Additional Readings Bill -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_GOAddReading" name="Bill (Additional Readings)">
        <bpmn:incoming>SequenceFlow_StartToExamine3</bpmn:outgoing/> 
         <bpmn:outgoing>SequenceFlow_ExamineReadings</bpmn:outgoing/>
    </bpmn:intermediateCatchEvent>

    <!-- Catching Event for Equipment Bill -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_GOEquipment" name="Bill (Equip Acquisition - GO)">
         <bpmn:incoming>SequenceFlow_StartToExamine4</bpmn:outgoing/> 
          <bpmn:outgoing>SequenceFlow_ExamineEquipmentGO</bpmn:outgoing/>
    </bpmn:intermediateCatchEvent>

    <!-- Unified Examination Task -->
    <bpmn:task id="Task_ExamineBill" name="Examine Bill">
      <bpmn:incoming>IntermediateCatchEvent_GOMetering</bpmn:outgoing/> 
      <bpmn:outgoing>SequenceFlow_DecideConfirmReject</bpmn:outgoing/>
    </bpmn:task>

    <!-- Gateway for Decision -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_ConfirmReject">
        <bpmn:name>Approve?</bpmn:name>
      <bpmn:incoming>SequenceFlow_DecideConfirmReject</bpmn:outgoing/> 
      <bpmn:outgoing>SequenceFlow_PathConfirm</bpmn:outgoing/>
      <bpmn:outgoing>SequenceFlow_PathReject</bpmn:outgoing/>
    </bpmn:exclusiveGateway>

    <!-- Confirmation Tasks -->
    <bpmn:task id="Task_ConfirmMetering" name="Confirm (Metering)">
        <bpmn:incoming>SequenceFlow_PathConfirm</bpmn:outgoing/> 
      <bpmn:outgoing>SequenceFlow_SendResponseMPOO1</bpmn:outgoing/>
    </bpmn:task>

     <!-- Rejection Tasks -->
    <bpmn:task id="Task_RejectMetering" name="Reject (Metering)">
        <bpmn:incoming>SequenceFlow_PathReject</bpmn:outgoing/> 
      <bpmn:outgoing>SequenceFlow_SendResponseMPOO2</bpmn:outgoing/>
    </bpmn:task>

     <!-- End Event -->
    <bpmn:endEvent id="EndGO" name="Bill Processed">
        <bpmn:incoming>SequenceFlow_SendResponseMPOO1</bpmn:outgoing/> 
        <bpmn:incoming>SequenceFlow_SendResponseMPOO2</bpmn:outgoing/>
    </bpmn:endEvent>

  </bpmn:process>

   <!-- MSPO Process -->
  <bpmn:process id="Process_MSPO" isExecutable="false">
     <bpmn:startEvent id="StartMSPO1" name="Initiate Measurement Bill Send">
      <bpmn:outgoing>SequenceFlow_StartToMeasurement</bpmn:outgoing/> 
    </bpmn:startEvent>

    <!-- Task to Send Measurement Bill -->
    <bpmn:task id="Task_SendMeasurementBill" name="Send Bill (Measurement)">
        <bpmn:incoming>SequenceFlow_StartToMeasurement</bpmn:outgoing/> 
      <bpmn:outgoing>SequenceFlow_MeasurementSent</bpmn:outgoing/>
    </bpmn:task>

     <!-- Task to Send Additional Readings Bill -->
    <bpmn:startEvent id="StartMSPO2" name="Initiate Additional Readings Bill">
      <bpmn:outgoing>SequenceFlow_StartToReadings</bpmn:outgoing/> 
    </bpmn:startEvent>

     <!-- Task to Send Additional Readings Bill -->
    <bpmn:task id="Task_SendAdditionalReadingsBill" name="Send Bill (Add. Readings)">
        <bpmn:incoming>SequenceFlow_StartToReadings</bpmn:outgoing/> 
      <bpmn:outgoing>SequenceFlow_AddReadingSent</bpmn:outgoing/>
    </bpmn:task>

     <!-- Intermediate Catching Events for Responses -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchResponse_GOMeasurement" name="Wait Response (Measurement)">
      <bpmn:incoming>SequenceFlow_MeasurementSent</bpmn:outgoing/> 
       <bpmn:outgoing>SequenceFlow_ResponseReceivedMSPO1</bpmn:outgoing/>
    </bpmn:intermediateCatchEvent>

     <!-- End Event -->
    <bpmn:endEvent id="EndMSPO" name="Process Completed">
      <bpmn:incoming>SequenceFlow_ResponseReceivedMSPO1</bpmn:outgoing/> 
    </bpmn:endEvent>

  </bpmn:process>

   <!-- MPON Process -->
  <bpmn:process id="Process_MPON" isExecutable="false">
     <bpmn:startEvent id="StartMPON1" name="Bill Received (Equip)">
      <bpmn:outgoing>SequenceFlow_StartToExamine</bpmn:outgoing/> 
    </bpmn:startEvent>

    <!-- Catching Event for Equipment Bill -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_MPONEquipment" name="Bill (Equip Acquisition - MPON)">
      <bpmn:incoming>SequenceFlow_StartToExamine</bpmn:outgoing/> 
       <bpmn:outgoing>SequenceFlow_ExamineEquipmentMPON</bpmn:outgoing/>
    </bpmn:intermediateCatchEvent>

     <!-- Examination Task -->
    <bpmn:task id="Task_ExamineEquip" name="Examine Equipment Bill">
        <bpmn:incoming>IntermediateCatchEvent_MPONEquipment</bpmn:outgoing/> 
      <bpmn:outgoing>SequenceFlow_DecideConfirmRejectMPON</bpmn:outgoing/>
    </bpmn:task>

     <!-- Gateway for Decision -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_ConfirmReject_MPON">
        <bpmn:name>Approve?</bpmn:name>
      <bpmn:incoming>SequenceFlow_DecideConfirmRejectMPON</bpmn:outgoing/> 
      <bpmn:outgoing>SequenceFlow_PathConfirmMPON</bpmn:outgoing/>
      <bpmn:outgoing>SequenceFlow_PathRejectMPON</bpmn:outgoing/>
    </bpmn:exclusiveGateway>

     <!-- Confirmation Tasks -->
    <bpmn:task id="Task_ConfirmEquipmentMPON" name="Confirm (Equip MPON)">
        <bpmn:incoming>SequenceFlow_PathConfirmMPON</bpmn:outgoing/> 
      <bpmn:outgoing>SequenceFlow_SendResponseMPON1</bpmn:outgoing/>
    </bpmn:task>

     <!-- Rejection Tasks -->
    <bpmn:task id="Task_RejectEquipmentMPON" name="Reject (Equip MPON)">
        <bpmn:incoming>SequenceFlow_PathRejectMPON</bpmn:outgoing/> 
      <bpmn:outgoing>SequenceFlow_SendResponseMPON2</bpmn:outgoing/>
    </bpmn:task>

     <!-- End Event -->
    <bpmn:endEvent id="EndMPON" name="Bill Processed">
        <bpmn:incoming>SequenceFlow_SendResponseMPON1</bpmn:outgoing/> 
        <bpmn:incoming>SequenceFlow_SendResponseMPON2</bpmn:outgoing/>
    </bpmn:endEvent>

  </bpmn:process>

</bpmn:definitions>