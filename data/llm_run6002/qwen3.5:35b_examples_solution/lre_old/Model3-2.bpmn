<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_CourtProcess">
    <bpmn:participant id="Participant_CourtOrg" name="Court Organization" processRef="Process_CourtFiles"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_CourtFiles" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_AdminStaff" name="Administrative Staff">
        <bpmn:flowNodeRef>StartEvent_MorningCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckFilesOrder</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_MorningCheck" name="Morning Files Check">
      <bpmn:outgoing>SequenceFlow_CheckFiles</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Check files in order -->
    <bpmn:task id="Task_CheckFilesOrder" name="Check if files are in order">
      <bpmn:incoming>SequenceFlow_CheckFiles</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FilesMissingDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway 1: Files missing? -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_FilesMissing" name="Files Missing?">
      <bpmn:incoming>SequenceFlow_FilesMissingDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InitiateSearch</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_TrackFiles</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 2: Initiate search (if files missing) -->
    <bpmn:task id="Task_InitiateSearch" name="Initiate Search">
      <bpmn:incoming>SequenceFlow_InitiateSearch</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SearchComplete</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3: Track physical files (if not missing) -->
    <bpmn:task id="Task_TrackFiles" name="Track Physical Files">
      <bpmn:incoming>SequenceFlow_TrackFiles</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FilesReady</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway 2: Convergence point -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_Converge">
      <bpmn:incoming>SequenceFlow_SearchComplete</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_FilesReady</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ParallelSplit</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Parallel Gateway 1: Split for concurrent tasks -->
    <bpmn:parallelGateway id="ParallelGateway_Concurrent">
      <bpmn:incoming>SequenceFlow_ParallelSplit</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_HandFiles</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_DistributeLawlist</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 4: Hand files to Associate -->
    <bpmn:task id="Task_HandFiles" name="Hand Files to Associate">
      <bpmn:incoming>SequenceFlow_HandFiles</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FilesHanded</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 5: Distribute Judges Lawlist -->
    <bpmn:task id="Task_DistributeLawlist" name="Distribute Judge's Lawlist">
      <bpmn:incoming>SequenceFlow_DistributeLawlist</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_LawlistDistributed</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway 2: Convergence point -->
    <bpmn:parallelGateway id="ParallelGateway_Converge">
      <bpmn:incoming>SequenceFlow_FilesHanded</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_LawlistDistributed</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConductHearings</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 6: Conduct directions hearings -->
    <bpmn:task id="Task_ConductHearings" name="Conduct Directions Hearings">
      <bpmn:incoming>SequenceFlow_ConductHearings</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_HearingComplete</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_ProcessComplete">
      <bpmn:incoming>SequenceFlow_HearingComplete</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckFiles" sourceRef="StartEvent_MorningCheck" targetRef="Task_CheckFilesOrder"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_FilesMissingDecision" name="" sourceRef="Task_CheckFilesOrder" targetRef="ExclusiveGateway_FilesMissing"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_InitiateSearch" name="Yes - Files Missing" sourceRef="ExclusiveGateway_FilesMissing" targetRef="Task_InitiateSearch"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_TrackFiles" name="No - Track Location" sourceRef="ExclusiveGateway_FilesMissing" targetRef="Task_TrackFiles"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_SearchComplete" sourceRef="Task_InitiateSearch" targetRef="ExclusiveGateway_Converge"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_FilesReady" name="" sourceRef="Task_TrackFiles" targetRef="ExclusiveGateway_Converge"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ParallelSplit" sourceRef="ExclusiveGateway_Converge" targetRef="ParallelGateway_Concurrent"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_HandFiles" name="" sourceRef="ParallelGateway_Concurrent" targetRef="Task_HandFiles"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_DistributeLawlist" name="" sourceRef="ParallelGateway_Concurrent" targetRef="Task_DistributeLawlist"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_FilesHanded" sourceRef="Task_HandFiles" targetRef="ParallelGateway_Converge"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_LawlistDistributed" name="" sourceRef="Task_DistributeLawlist" targetRef="ParallelGateway_Converge"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ConductHearings" sourceRef="ParallelGateway_Converge" targetRef="Task_ConductHearings"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_HearingComplete" name="" sourceRef="Task_ConductHearings" targetRef="EndEvent_ProcessComplete"/>

  </bpmn:process>
</bpmn:definitions>