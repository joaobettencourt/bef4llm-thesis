<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1v5l1xs">
    <bpmn:participant id="Participant_1kcgy3u" name="Organization" processRef="Process_1" />
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_MasterIndividualProduction" name="Master Individual Production">
        <bpmn:flowNodeRef>StartEvent_NewOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DeterminePartsAndDeliveryDate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterDataToPPS</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Employee" name="Employee">
        <bpmn:flowNodeRef>IntermediateThrowEvent_ProductionNotice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProduceOrder</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_QualityInspector" name="Quality Inspector">
        <bpmn:flowNodeRef>ExclusiveGateway_CheckPartsMissing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProcureParts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewQuality</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ProcessFinished</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_NewOrder" name="New Order from Sales">
      <bpmn:outgoing>SequenceFlow_StartToDetermine</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Determine parts and delivery date -->
    <bpmn:task id="Task_DeterminePartsAndDeliveryDate" name="Determine necessary parts, quantities, and delivery date">
      <bpmn:incoming>SequenceFlow_StartToDetermine</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToPPS</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: Enter data to PPS -->
    <bpmn:task id="Task_EnterDataToPPS" name="Enter data into Production Planning System (PPS)">
      <bpmn:incoming>SequenceFlow_ToPPS</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PPSDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Check if parts are missing -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_CheckPartsMissing">
      <bpmn:incoming>SequenceFlow_PPSDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProcureIfNeeded</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SkipProcurement</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 3: Procure parts (if needed) -->
    <bpmn:task id="Task_ProcureParts" name="Procure missing parts">
      <bpmn:incoming>SequenceFlow_ProcureIfNeeded</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToProductionNotice</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Event: Production notice from system -->
    <bpmn:intermediateThrowEvent id="IntermediateThrowEvent_ProductionNotice" name="Ready to start production">
      <bpmn:incoming>SequenceFlow_SkipProcurement</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ToProductionNotice</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StartProduceOrder</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <!-- Task 4: Produce order -->
    <bpmn:task id="Task_ProduceOrder" name="Implement production">
      <bpmn:incoming>SequenceFlow_StartProduceOrder</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToQualityCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 5: Quality check -->
    <bpmn:task id="Task_ReviewQuality" name="Review quality">
      <bpmn:incoming>SequenceFlow_ToQualityCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndProcess</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_ProcessFinished" name="Production process finished">
      <bpmn:incoming>SequenceFlow_EndProcess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToDetermine" sourceRef="StartEvent_NewOrder" targetRef="Task_DeterminePartsAndDeliveryDate" />
    
    <bpmn:sequenceFlow id="SequenceFlow_ToPPS" name="" sourceRef="Task_DeterminePartsAndDeliveryDate" targetRef="Task_EnterDataToPPS" />
    
    <bpmn:sequenceFlow id="SequenceFlow_PPSDecision" name="" sourceRef="Task_EnterDataToPPS" targetRef="ExclusiveGateway_CheckPartsMissing" />
    
    <bpmn:sequenceFlow id="SequenceFlow_ProcureIfNeeded" name="Yes, parts missing" sourceRef="ExclusiveGateway_CheckPartsMissing" targetRef="Task_ProcureParts" />
    
    <bpmn:sequenceFlow id="SequenceFlow_SkipProcurement" name="No, all parts available" sourceRef="ExclusiveGateway_CheckPartsMissing" targetRef="IntermediateThrowEvent_ProductionNotice" />
    
    <bpmn:sequenceFlow id="SequenceFlow_ToProductionNotice" name="" sourceRef="Task_ProcureParts" targetRef="IntermediateThrowEvent_ProductionNotice" />
    
    <bpmn:sequenceFlow id="SequenceFlow_StartProduceOrder" name="" sourceRef="IntermediateThrowEvent_ProductionNotice" targetRef="Task_ProduceOrder" />
    
    <bpmn:sequenceFlow id="SequenceFlow_ToQualityCheck" name="" sourceRef="Task_ProduceOrder" targetRef="Task_ReviewQuality" />
    
    <bpmn:sequenceFlow id="SequenceFlow_EndProcess" name="" sourceRef="Task_ReviewQuality" targetRef="EndEvent_ProcessFinished" />

  </bpmn:process>
</bpmn:definitions>