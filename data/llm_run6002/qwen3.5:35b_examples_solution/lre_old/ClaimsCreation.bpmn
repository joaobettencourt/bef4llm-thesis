<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_001">
    <bpmn:participant id="Participant_ClaimsProcess" name="Claims Processing Organization" processRef="Process_001"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_001" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Clerk" name="Clerk">
        <bpmn:flowNodeRef>StartEvent_ClaimReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SearchPoliceReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ComposeFile</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ClaimsHandler" name="Claims Handler">
        <bpmn:flowNodeRef>Task_CalculateEstimate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateActionPlan</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ClaimsManager" name="Claims Manager">
        <bpmn:flowNodeRef>Task_NegotiateSettlement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ProcessComplete</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_ClaimReceived" name="Claim Received">
      <bpmn:outgoing>SequenceFlow_StartToSearch</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Search Police Report Database -->
    <bpmn:task id="Task_SearchPoliceReport" name="Search police report database">
      <bpmn:incoming>SequenceFlow_StartToSearch</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SearchToFile</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: Compose File -->
    <bpmn:task id="Task_ComposeFile" name="Compose file with Claim Documentation">
      <bpmn:incoming>SequenceFlow_SearchToFile</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FileToHandler</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3: Calculate Initial Estimate -->
    <bpmn:task id="Task_CalculateEstimate" name="Calculate initial claim estimate">
      <bpmn:incoming>SequenceFlow_FileToHandler</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EstimateToPlan</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 4: Create Action Plan -->
    <bpmn:task id="Task_CreateActionPlan" name="Create action plan from checklist">
      <bpmn:incoming>SequenceFlow_EstimateToPlan</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PlanToNegotiate</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 5: Negotiate Settlement -->
    <bpmn:task id="Task_NegotiateSettlement" name="Negotiate settlement on claim estimate">
      <bpmn:incoming>SequenceFlow_PlanToNegotiate</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToNotifyClaimant</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_ProcessComplete" name="Process Complete">
      <bpmn:incoming>SequenceFlow_ToNotifyClaimant</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToSearch" sourceRef="StartEvent_ClaimReceived" targetRef="Task_SearchPoliceReport"/>
    <bpmn:sequenceFlow id="SequenceFlow_SearchToFile" sourceRef="Task_SearchPoliceReport" targetRef="Task_ComposeFile"/>
    <bpmn:sequenceFlow id="SequenceFlow_FileToHandler" name="" sourceRef="Task_ComposeFile" targetRef="Task_CalculateEstimate"/>
    <bpmn:sequenceFlow id="SequenceFlow_EstimateToPlan" sourceRef="Task_CalculateEstimate" targetRef="Task_CreateActionPlan"/>
    <bpmn:sequenceFlow id="SequenceFlow_PlanToNegotiate" name="" sourceRef="Task_CreateActionPlan" targetRef="Task_NegotiateSettlement"/>
    <bpmn:sequenceFlow id="SequenceFlow_ToNotifyClaimant" name="Inform claimant of outcome" sourceRef="Task_NegotiateSettlement" targetRef="EndEvent_ProcessComplete"/>

  </bpmn:process>
</bpmn:definitions>