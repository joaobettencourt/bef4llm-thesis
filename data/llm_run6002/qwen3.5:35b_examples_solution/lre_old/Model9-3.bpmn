<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_001">
    <bpmn:participant id="Participant_TownPlanningAuthority" name="Town Planning Authority" processRef="Process_TPA"/>
    <bpmn:participant id="Participant_CommitteeMembers" name="Committee Members" processRef="Process_CM"/>
    <bpmn:messageFlow id="MessageFlow_01" sourceRef="IntermediateThrow_ScheduleSent" targetRef="StartMessage_MembersReceived">
      <bpmn:name>Send schedule to members</bpmn:name>
    </bpmn:messageFlow>
    <bpmn:messageFlow id="MessageFlow_02" sourceRef="IntermediateThrow_ConflictsReported" targetRef="IntermediateCatch_TPAReceived">
      <bpmn:name>Advise conflicts from members</bpmn:name>
    </bpmn:messageFlow>
  </bpmn:collaboration>

  <!-- Town Planning Authority Process -->
  <bpmn:process id="Process_TPA" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_CoordinationUnit" name="Coordination Unit">
        <bpmn:flowNodeRef>StartTimer_November</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DraftSchedule</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AddDraftDates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateThrow_ScheduleSent</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SupportOfficer" name="Support Officer">
        <bpmn:flowNodeRef>Task_CheckDatesSuggestModifications</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event - November each year -->
    <bpmn:startEvent id="StartTimer_November" name="November">
      <bpmn:outgoing>SequenceFlow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Draft schedule of meetings -->
    <bpmn:task id="Task_DraftSchedule" name="Draft meeting schedule">
      <bpmn:incoming>SequenceFlow_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_02</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: Add draft dates to calendars -->
    <bpmn:task id="Task_AddDraftDates" name="Add draft dates to all calendars">
      <bpmn:incoming>SequenceFlow_02</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_03</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3: Support Officer checks dates -->
    <bpmn:task id="Task_CheckDatesSuggestModifications" name="Check dates and suggest modifications">
      <bpmn:incoming>SequenceFlow_04</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_05</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 4: Coordination Unit rechecks conflicts -->
    <bpmn:task id="Task_RecheckConflicts" name="Recheck dates and look for potential conflicts">
      <bpmn:incoming>SequenceFlow_05</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_06</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Throw Event - Send schedule to members -->
    <bpmn:intermediateThrowEvent id="IntermediateThrow_ScheduleSent" name="Send final schedule by email">
      <bpmn:incoming>SequenceFlow_06</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_07</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <!-- Intermediate Catch Event - Receive conflict reports -->
    <bpmn:intermediateCatchEvent id="IntermediateCatch_TPAReceived" name="Receive conflicts from members">
      <bpmn:incoming>SequenceFlow_08</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_09</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- End Event -->
    <bpmn:endEvent id="End_TPA" name="Schedule finalized">
      <bpmn:incoming>SequenceFlow_07</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_01" sourceRef="StartTimer_November" targetRef="Task_DraftSchedule"/>
    <bpmn:sequenceFlow id="SequenceFlow_02" sourceRef="Task_DraftSchedule" targetRef="Task_AddDraftDates"/>
    <bpmn:sequenceFlow id="SequenceFlow_03" name="" sourceRef="StartTimer_November" targetRef="Task_CheckDatesSuggestModifications"/>
    <bpmn:sequenceFlow id="SequenceFlow_04" sourceRef="Task_CheckDatesSuggestModifications" targetRef="Task_RecheckConflicts"/>
    <bpmn:sequenceFlow id="SequenceFlow_05" name="" sourceRef="Task_AddDraftDates" targetRef="IntermediateThrow_ScheduleSent"/>
    <bpmn:sequenceFlow id="SequenceFlow_06" sourceRef="Task_RecheckConflicts" targetRef="IntermediateCatch_TPAReceived"/>
    <bpmn:sequenceFlow id="SequenceFlow_07" name="" sourceRef="End_TPA" targetRef="StartTimer_November"/>

  </bpmn:process>

  <!-- Committee Members Process -->
  <bpmn:process id="Process_CM" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Members" name="">
        <bpmn:flowNodeRef>StartMessage_MembersReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckDiaries</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateThrow_ConflictsReported</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Message Event - Receive schedule -->
    <bpmn:startEvent id="StartMessage_MembersReceived" name="Receive meeting schedule">
      <bpmn:outgoing>SequenceFlow_CM01</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 5: Check diaries for conflicts -->
    <bpmn:task id="Task_CheckDiaries" name="Check diary and advise of conflicts">
      <bpmn:incoming>SequenceFlow_CM01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CM02</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Throw Event - Report conflicts -->
    <bpmn:intermediateThrowEvent id="IntermediateThrow_ConflictsReported" name="Advise schedule conflicts">
      <bpmn:incoming>SequenceFlow_CM02</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CM03</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <!-- End Event -->
    <bpmn:endEvent id="End_CM" name="">
      <bpmn:incoming>SequenceFlow_CM04</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_CM01" sourceRef="StartMessage_MembersReceived" targetRef="Task_CheckDiaries"/>
    <bpmn:sequenceFlow id="SequenceFlow_CM02" sourceRef="Task_CheckDiaries" targetRef="IntermediateThrow_ConflictsReported"/>

  </bpmn:process>
</bpmn:definitions>