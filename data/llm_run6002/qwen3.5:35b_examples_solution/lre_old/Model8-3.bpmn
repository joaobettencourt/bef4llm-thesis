<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_001">
    <bpmn:participant id="Participant_FunctionalDept" name="Functional Department" processRef="Process_001" />
  </bpmn:collaboration>

  <bpmn:process id="Process_001" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_FunctionalDeptHead" name="Head of Functional Department">
        <bpmn:flowNodeRef>StartEvent_PersonnelRequirements</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReportVacancy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateCatchJobDescriptionReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ReviewDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AskCorrections</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateCatchClarificationRequired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CommunicateTasksRequirements</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_HRQuestionsDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ApproveJobDescription</bpmn:flowNodeRef>
      </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_PersonnelRequirements" name="Personnel requirements detected">
      <bpmn:outgoing>SequenceFlow_StartToReport</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Report vacancy -->
    <bpmn:task id="Task_ReportVacancy" name="Report vacancy to Personnel Department">
      <bpmn:incoming>SequenceFlow_StartToReport</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReviewWaitStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Catch Event 1: Wait for job description -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchJobDescriptionReceived" name="Receive job description">
      <bpmn:incoming>SequenceFlow_ReviewWaitStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToReviewTask</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task 2: Review job description -->
    <bpmn:task id="Task_ReviewJobDescription" name="Review job description">
      <bpmn:incoming>SequenceFlow_ToReviewTask</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToDecisionGateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Decision on job description -->
    <bpmn:exclusiveGateway id="Gateway_ReviewDecision" name="Job description OK?">
      <bpmn:incoming>SequenceFlow_ToDecisionGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AskCorrectionsPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 3: Ask for corrections -->
    <bpmn:task id="Task_AskCorrections" name="Ask for corrections">
      <bpmn:incoming>SequenceFlow_AskCorrectionsPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToReviewAgain</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Catch Event 2: Wait for clarification -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchClarificationRequired" name="HR has questions">
      <bpmn:incoming>SequenceFlow_ToReviewAgain</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ClarifyAvailable</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task 4: Communicate tasks and requirements -->
    <bpmn:task id="Task_CommunicateTasksRequirements" name="Communicate tasks and requirements">
      <bpmn:incoming>SequenceFlow_ClarifyAvailable</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToHRDecisionGateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2: HR questions decision -->
    <bpmn:exclusiveGateway id="Gateway_HRQuestionsDecision" name="All clarifications done?">
      <bpmn:incoming>SequenceFlow_ToHRDecisionGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ApprovePath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 5: Approve job description -->
    <bpmn:task id="Task_ApproveJobDescription" name="Approve job description">
      <bpmn:incoming>SequenceFlow_ApprovePath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToEndEvent</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_JobDescriptionApproved" name="Job description approved">
      <bpmn:incoming>SequenceFlow_ToEndEvent</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToReport" sourceRef="StartEvent_PersonnelRequirements" targetRef="Task_ReportVacancy" />
    
    <bpmn:sequenceFlow id="SequenceFlow_ReviewWaitStart" name="" sourceRef="Task_ReportVacancy" targetRef="IntermediateCatchJobDescriptionReceived" />
    
    <bpmn:sequenceFlow id="SequenceFlow_ToReviewTask" name="" sourceRef="IntermediateCatchJobDescriptionReceived" targetRef="Task_ReviewJobDescription" />
    
    <bpmn:sequenceFlow id="SequenceFlow_ToDecisionGateway" name="" sourceRef="Task_ReviewJobDescription" targetRef="Gateway_ReviewDecision" />
    
    <bpmn:sequenceFlow id="SequenceFlow_AskCorrectionsPath" name="No, corrections needed" sourceRef="Gateway_ReviewDecision" targetRef="Task_AskCorrections" />
    
    <bpmn:sequenceFlow id="SequenceFlow_ToReviewAgain" name="" sourceRef="Task_AskCorrections" targetRef="IntermediateCatchClarificationRequired" />
    
    <bpmn:sequenceFlow id="SequenceFlow_ClarifyAvailable" name="" sourceRef="IntermediateCatchClarificationRequired" targetRef="Task_CommunicateTasksRequirements" />
    
    <bpmn:sequenceFlow id="SequenceFlow_ToHRDecisionGateway" name="" sourceRef="Task_CommunicateTasksRequirements" targetRef="Gateway_HRQuestionsDecision" />
    
    <bpmn:sequenceFlow id="SequenceFlow_ApprovePath" name="Yes, all clarifications done" sourceRef="Gateway_HRQuestionsDecision" targetRef="Task_ApproveJobDescription" />
    
    <bpmn:sequenceFlow id="SequenceFlow_ToEndEvent" name="" sourceRef="Task_ApproveJobDescription" targetRef="EndEvent_JobDescriptionApproved" />

  </bpmn:process>
</bpmn:definitions>