<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_001">
    <bpmn:participant id="Participant_MPO" name="MPO" processRef="Process_001"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_001" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_MPO" name="MPO">
        <bpmn:flowNodeRef>StartEvent_Request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DecisionRejectConfirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RejectChange</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConfirmRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PerformChange</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ImplementationResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReportSuccess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyFailure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Failure</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Request" name="Request change">
      <bpmn:description>The SP/PU/GO requests changes of the MPO or the MPO himself causes a change</bpmn:description>
      <bpmn:outgoing>SequenceFlow_StartToReview</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1 -->
    <bpmn:task id="Task_ReviewRequest" name="Review the change request">
      <bpmn:description>The MPO reviews the change request</bpmn:description>
      <bpmn:incoming>SequenceFlow_StartToReview</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToDecisionRejectConfirm</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1 -->
    <bpmn:exclusiveGateway id="Gateway_DecisionRejectConfirm" name="MPO decision">
      <bpmn:description>The MPO rejects the change of the measuring point by the SP/PU/GO or confirms the request</bpmn:description>
      <bpmn:incoming>SequenceFlow_ToDecisionRejectConfirm</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RejectPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ConfirmPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 2 -->
    <bpmn:task id="Task_RejectChange" name="Reject the change">
      <bpmn:description>The MPO rejects the change of the measuring point by the SP/PU/GO</bpmn:description>
      <bpmn:incoming>SequenceFlow_RejectPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToEndRejected</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 1 -->
    <bpmn:endEvent id="EndEvent_Rejected" name="Change rejected">
      <bpmn:description>The MPO rejects the change of the measuring point by the SP/PU/GO</bpmn:description>
      <bpmn:incoming>SequenceFlow_ToEndRejected</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task 3 -->
    <bpmn:task id="Task_ConfirmRequest" name="Confirm the request">
      <bpmn:description>The MPO confirms the request of the SP/PU/GO</bpmn:description>
      <bpmn:incoming>SequenceFlow_ConfirmPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToPerformChange</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 4 -->
    <bpmn:task id="Task_PerformChange" name="Perform the measuring point change">
      <bpmn:description>The MPO performs the measuring point change</bpmn:description>
      <bpmn:incoming>SequenceFlow_ToPerformChange</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ResultDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2 -->
    <bpmn:exclusiveGateway id="Gateway_ImplementationResult" name="Implementation result">
      <bpmn:description>The MPO reports the implementation to the SP/PU/GO or notifies about failure</bpmn:description>
      <bpmn:incoming>SequenceFlow_ResultDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SuccessPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_FailurePath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 5 -->
    <bpmn:task id="Task_ReportSuccess" name="Report implementation">
      <bpmn:description>The MPO reports the implementation to the SP/PU/GO</bpmn:description>
      <bpmn:incoming>SequenceFlow_SuccessPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToEndSuccess</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 2 -->
    <bpmn:endEvent id="EndEvent_Success" name="Implementation reported">
      <bpmn:description>The MPO reports the implementation to the SP/PU/GO</bpmn:description>
      <bpmn:incoming>SequenceFlow_ToEndSuccess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task 6 -->
    <bpmn:task id="Task_NotifyFailure" name="Notify about failure">
      <bpmn:description>The MPO notifies the SP/PU/GO about the failure of the changes</bpmn:description>
      <bpmn:incoming>SequenceFlow_FailurePath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToEndFailure</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 3 -->
    <bpmn:endEvent id="EndEvent_Failure" name="Change failed">
      <bpmn:description>The MPO notifies the SP/PU/GO about the failure of the changes</bpmn:description>
      <bpmn:incoming>SequenceFlow_ToEndFailure</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToReview" sourceRef="StartEvent_Request" targetRef="Task_ReviewRequest"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ToDecisionRejectConfirm" name="" sourceRef="Task_ReviewRequest" targetRef="Gateway_DecisionRejectConfirm"/>

    <bpmn:sequenceFlow id="SequenceFlow_RejectPath" name="reject" sourceRef="Gateway_DecisionRejectConfirm" targetRef="Task_RejectChange">
      <bpmn:name>reject</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ToEndRejected" sourceRef="Task_RejectChange" targetRef="EndEvent_Rejected"/>

    <bpmn:sequenceFlow id="SequenceFlow_ConfirmPath" name="confirm" sourceRef="Gateway_DecisionRejectConfirm" targetRef="Task_ConfirmRequest">
      <bpmn:name>confirm</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ToPerformChange" sourceRef="Task_ConfirmRequest" targetRef="Task_PerformChange"/>

    <bpmn:sequenceFlow id="SequenceFlow_ResultDecision" name="" sourceRef="Task_PerformChange" targetRef="Gateway_ImplementationResult"/>

    <bpmn:sequenceFlow id="SequenceFlow_SuccessPath" name="success" sourceRef="Gateway_ImplementationResult" targetRef="Task_ReportSuccess">
      <bpmn:name>success</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ToEndSuccess" sourceRef="Task_ReportSuccess" targetRef="EndEvent_Success"/>

    <bpmn:sequenceFlow id="SequenceFlow_FailurePath" name="failure" sourceRef="Gateway_ImplementationResult" targetRef="Task_NotifyFailure">
      <bpmn:name>failure</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ToEndFailure" sourceRef="Task_NotifyFailure" targetRef="EndEvent_Failure"/>
  </bpmn:process>
</bpmn:definitions>