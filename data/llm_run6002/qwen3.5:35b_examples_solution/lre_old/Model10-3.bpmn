<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_MPOO" name="MPOO" processRef="Process_MPOO"/>
    <bpmn:participant id="Participant_GO" name="GO" processRef="Process_GO"/>
    <bpmn:messageFlow id="MessageFlow_01" sourceRef="Task_Deregister" targetRef="IntermediateCatchEvent_VerifyDeregistration"/>
  </bpmn:collaboration>

  <!-- MPOO Process -->
  <bpmn:process id="Process_MPOO">
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:name>Deregister Request</bpmn:name>
      <bpmn:outgoing>SequenceFlow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_Deregister" name="Deregister at GO">
      <bpmn:incoming>SequenceFlow_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_02</bpmn:outgoing>
    </bpmn:task>

    <!-- Wait for decision from GO -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_Decision">
      <bpmn:name>Wait for Decision</bpmn:name>
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SequenceFlow_02</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Decided</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Decision Gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_Decision">
      <bpmn:name>Deregistration Valid?</bpmn:name>
      <bpmn:incoming>SequenceFlow_Decided</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RejectPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Reject Path -->
    <bpmn:endEvent id="EndEvent_Rejected">
      <bpmn:name>Deregistration Rejected</bpmn:name>
      <bpmn:incoming>SequenceFlow_RejectPath</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Confirm Path -->
    <bpmn:task id="Task_ConfirmContinuation" name="Confirm Continuation">
      <bpmn:name>MPOO confirms continuation to MPOO</bpmn:name>
      <bpmn:incoming>SequenceFlow_03</bpmn:incoming>
    </bpmn:task>

    <!-- End Event for Confirmation -->
    <bpmn:endEvent id="EndEvent_Confirmed">
      <bpmn:name>Deregistration Confirmed</bpmn:name>
      <bpmn:incoming>SequenceFlow_FinalConfirmation</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_01" sourceRef="StartEvent_1" targetRef="Task_Deregister"/>
    <bpmn:sequenceFlow id="SequenceFlow_02" name="" sourceRef="Task_Deregister" targetRef="IntermediateCatchEvent_Decision">
      <bpmn:messageEventDefinition/>
    </bpmn:sequenceFlow>

  </bpmn:process>

  <!-- GO Process -->
  <bpmn:process id="Process_GO">
    <bpmn:startEvent id="StartEvent_VerifyDeregistration">
      <bpmn:name>Deregistration Received</bpmn:name>
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task to receive verification -->
    <bpmn:task id="Task_VerifyDeregistration" name="Verify Deregistration">
      <bpmn:name>GO verifies the deregistration</bpmn:name>
      <bpmn:incoming>SequenceFlow_10</bpmn:incoming>
    </bpmn:task>

    <!-- Decision Gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_Decision_GO">
      <bpmn:name>Deregistration Valid?</bpmn:name>
      <bpmn:incoming>SequenceFlow_10</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RejectPath_GO</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Reject Path -->
    <bpmn:endEvent id="EndEvent_DeregistrationRejected">
      <bpmn:name>Deregistration Rejected</bpmn:name>
      <bpmn:incoming>SequenceFlow_RejectPath_GO</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Confirmation Path -->
    <bpmn:task id="Task_ConfirmDeregistration" name="Preliminarily Confirm Deregistration">
      <bpmn:name>Preliminary confirmation of deregistration</bpmn:name>
      <bpmn:incoming>SequenceFlow_12</bpmn:incoming>
    </bpmn:task>

    <!-- Prepare Readmission -->
    <bpmn:task id="Task_PrepareReadmission" name="Prepare Readmission of Measuring Point">
      <bpmn:name>GO prepares the readmission of measuring point</bpmn:name>
      <bpmn:incoming>SequenceFlow_13</bpmn:incoming>
    </bpmn:task>

    <!-- Optional Obligation Decision -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_Obligate">
      <bpmn:name>Obliged to Continue?</bpmn:name>
      <bpmn:incoming>SequenceFlow_14</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NoObligation_GO</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Obligate Path -->
    <bpmn:task id="Task_ObligedContinue" name="Oblige MPOO to Continue Operations">
      <bpmn:name>OBLIGE the MPOO to continue operations</bpmn:name>
      <bpmn:incoming>SequenceFlow_15</bpmn:incoming>
    </bpmn:task>

    <!-- No Obligation Path -->
    <bpmn:endEvent id="EndEvent_NoObligation">
      <bpmn:name>No Obligation to Continue</bpmn:name>
      <bpmn:incoming>SequenceFlow_16_GO</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Equipment Tasks -->
    <bpmn:task id="Task_EquipmentAcquisition" name="Equipment Acquisition">
      <bpmn:name>Perform equipment acquisition and/or changes</bpmn:name>
      <bpmn:incoming>SequenceFlow_17_GO</bpmn:incoming>
    </bpmn:task>

    <!-- Assign GO as MPO -->
    <bpmn:task id="Task_AssignGOMPO" name="Assign GO as MPO">
      <bpmn:name>GO assigns the GO as MPO</bpmn:name>
      <bpmn:incoming>SequenceFlow_18_GO</bpmn:incoming>
    </bpmn:task>

    <!-- Inform Parties -->
    <bpmn:task id="Task_InformMPOO" name="Inform MPOO about Assignment">
      <bpmn:name>Informs the MPOO about end of assignment and beginning</bpmn:name>
      <bpmn:incoming>SequenceFlow_19_GO</bpmn:incoming>
    </bpmn:task>

    <!-- Message to MSPO -->
    <bpmn:intermediateThrowEvent id="IntermediateThrowEvent_MSPO" name="Inform MSPO">
      <bpmn:name>Informs the MSPO about assignment of GO</bpmn:name>
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SequenceFlow_20_GO</bpmn:incoming>
    </bpmn:intermediateThrowEvent>

    <!-- Message to SP -->
    <bpmn:task id="Task_InformSP" name="Inform SP about Assignment">
      <bpmn:name>Informs the SP about assignment of GO</bpmn:name>
      <bpmn:incoming>SequenceFlow_21_GO</bpmn:incoming>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Complete">
      <bpmn:name>All Assignments Complete</bpmn:name>
      <bpmn:incoming>SequenceFlow_FinalComplete_GO</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="StartEvent_VerifyDeregistration" targetRef="Task_VerifyDeregistration"/>
    
    <!-- Decision Paths -->
    <bpmn:sequenceFlow id="SequenceFlow_RejectPath_GO" name="Reject Deregistration" sourceRef="ExclusiveGateway_Decision_GO" targetRef="EndEvent_DeregistrationRejected"/>
    <bpmn:sequenceFlow id="SequenceFlow_12" name="Confirm" sourceRef="ExclusiveGateway_Decision_GO" targetRef="Task_ConfirmDeregistration">
      <bpmn:messageEventDefinition/>
    </bpmn:sequenceFlow>

    <!-- Confirmation Path -->
    <bpmn:sequenceFlow id="SequenceFlow_13" name="" sourceRef="Task_ConfirmDeregistration" targetRef="Task_PrepareReadmission"/>
    <bpmn:sequenceFlow id="SequenceFlow_14" name="" sourceRef="Task_PrepareReadmission" targetRef="ExclusiveGateway_Obligate">
      <bpmn:messageEventDefinition/>
    </bpmn:sequenceFlow>

    <!-- Obligation Decision -->
    <bpmn:sequenceFlow id="SequenceFlow_NoObligation_GO" name="" sourceRef="ExclusiveGateway_Obligate" targetRef="EndEvent_NoObligation"/>
    <bpmn:sequenceFlow id="SequenceFlow_15" name="Yes - Obliged" sourceRef="ExclusiveGateway_Obligate" targetRef="Task_ObligedContinue">
      <bpmn:messageEventDefinition/>
    </bpmn:sequenceFlow>

    <!-- Equipment Path -->
    <bpmn:sequenceFlow id="SequenceFlow_16_GO" name="" sourceRef="EndEvent_NoObligation" targetRef="Task_EquipmentAcquisition"/>
    <bpmn:sequenceFlow id="SequenceFlow_17_GO" name="" sourceRef="Task_ObligedContinue" targetRef="Task_EquipmentAcquisition">
      <bpmn:messageEventDefinition/>
    </bpmn:sequenceFlow>

    <!-- Assignment Path -->
    <bpmn:sequenceFlow id="SequenceFlow_18_GO" name="" sourceRef="Task_EquipmentAcquisition" targetRef="Task_AssignGOMPO"/>
    <bpmn:sequenceFlow id="SequenceFlow_19_GO" name="" sourceRef="Task_AssignGOMPO" targetRef="Task_InformMPOO">
      <bpmn:messageEventDefinition/>
    </bpmn:sequenceFlow>

    <!-- Inform MSPO -->
    <bpmn:sequenceFlow id="SequenceFlow_20_GO" name="" sourceRef="Task_AssignGOMPO" targetRef="IntermediateThrowEvent_MSPO">
      <bpmn:messageEventDefinition/>
    </bpmn:sequenceFlow>

    <!-- Inform SP and Complete -->
    <bpmn:sequenceFlow id="SequenceFlow_21_GO" name="" sourceRef="Task_InformMPOO" targetRef="Task_InformSP">
      <bpmn:messageEventDefinition/>
    </bpmn:sequenceFlow>

    <!-- Final Completion -->
    <bpmn:sequenceFlow id="SequenceFlow_FinalComplete_GO" name="" sourceRef="Task_InformSP" targetRef="EndEvent_Complete"/>
  </bpmn:process>
</bpmn:definitions>