<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_001">
    <bpmn:participant id="Participant_SmallClaimsRegistry" name="Small Claims Registry Operations" processRef="Process_WarrantPossession"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_WarrantPossession" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_ClientServiceBackOffice" name="Client Service Back Office">
        <bpmn:flowNodeRef>StartEvent_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RetrieveSCTTFile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ForwardWarrantPossession</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateCatchEvent_PoliceReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RetrieveSCTFile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AttachNewDocument</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_001" name="Warrant Possession Request Received">
      <bpmn:outgoing>SequenceFlow_StartToRetrieveSCTT</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1 -->
    <bpmn:task id="Task_RetrieveSCTTFile" name="Retrieve SCTT File">
      <bpmn:incoming>SequenceFlow_StartToRetrieveSCTT</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToForwardWarrant</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2 -->
    <bpmn:task id="Task_ForwardWarrantPossession" name="Forward SCT Warrant Possession to Queensland Police">
      <bpmn:incoming>SequenceFlow_ToForwardWarrant</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StoreSCTTFile</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3 -->
    <bpmn:task id="Task_StoreSCTTPhysical" name="Store SCTT Physical File">
      <bpmn:incoming>SequenceFlow_StoreSCTTFile</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitForPoliceReport</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Catch Event for Police Report -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_PoliceReport" name="Awaiting Police Report">
      <bpmn:incoming>SequenceFlow_WaitForPoliceReport</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RetrieveSCTFileAfterReport</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task 4 -->
    <bpmn:task id="Task_RetrieveSCTFile" name="Retrieve SCT File">
      <bpmn:incoming>SequenceFlow_RetrieveSCTFileAfterReport</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AttachNewDocument</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 5 -->
    <bpmn:task id="Task_AttachNewDocument" name="Attach New SCT Document">
      <bpmn:incoming>SequenceFlow_AttachNewDocument</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StoreExpandedFile</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 6 -->
    <bpmn:task id="Task_StoreExpandedSCT" name="Store Expanded SCT Physical File">
      <bpmn:incoming>SequenceFlow_StoreExpandedFile</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_HandoffToOtherStaff</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_001" name="Handed Over to MC Internal Staff">
      <bpmn:incoming>SequenceFlow_HandoffToOtherStaff</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToRetrieveSCTT" sourceRef="StartEvent_001" targetRef="Task_RetrieveSCTTFile"/>
    <bpmn:sequenceFlow id="SequenceFlow_ToForwardWarrant" sourceRef="Task_RetrieveSCTTFile" targetRef="Task_ForwardWarrantPossession"/>
    <bpmn:sequenceFlow id="SequenceFlow_StoreSCTTFile" sourceRef="Task_ForwardWarrantPossession" targetRef="Task_StoreSCTTPhysical"/>
    <bpmn:sequenceFlow id="SequenceFlow_WaitForPoliceReport" sourceRef="Task_StoreSCTTPhysical" targetRef="IntermediateCatchEvent_PoliceReport"/>
    <bpmn:sequenceFlow id="SequenceFlow_RetrieveSCTFileAfterReport" sourceRef="IntermediateCatchEvent_PoliceReport" targetRef="Task_RetrieveSCTFile"/>
    <bpmn:sequenceFlow id="SequenceFlow_AttachNewDocument" sourceRef="Task_RetrieveSCTFile" targetRef="Task_AttachNewDocument"/>
    <bpmn:sequenceFlow id="SequenceFlow_StoreExpandedFile" sourceRef="Task_AttachNewDocument" targetRef="Task_StoreExpandedSCT"/>
    <bpmn:sequenceFlow id="SequenceFlow_HandoffToOtherStaff" sourceRef="Task_StoreExpandedSCT" targetRef="EndEvent_001"/>

  </bpmn:process>
</bpmn:definitions>