<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Claims_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_Claims_001">
    <bpmn:participant id="Participant_ClaimsSys" name="Claims Notification Process" processRef="Process_Claims_001" />
  </bpmn:collaboration>

  <bpmn:process id="Process_Claims_001" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Administration" name="Claims Administration">
        <bpmn:flowNodeRef>StartEvent_ClaimReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckInsuredStatus</bpmn:flowNodeRef>
      </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_ClaimReceived" name="Claim Received">
      <bpmn:outgoing>SequenceFlow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Check if claimant is insured -->
    <bpmn:task id="Task_CheckInsuredStatus" name="Check Claimant Insured Status">
      <bpmn:incoming>SequenceFlow_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_02</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Is claimant insured? -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_IsInsured" name="Is Claimant Insured?">
      <bpmn:incoming>SequenceFlow_02</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RejectClaim</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_EvaluateSeverity</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 2: Reject claim -->
    <bpmn:task id="Task_RejectClaim" name="Inform Claimant of Rejection">
      <bpmn:incoming>SequenceFlow_RejectClaim</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndRejected</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 1 -->
    <bpmn:endEvent id="EndEvent_ClaimRejected" name="Claim Rejected">
      <bpmn:incoming>SequenceFlow_EndRejected</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task 3: Evaluate severity -->
    <bpmn:task id="Task_EvaluateSeverity" name="Evaluate Claim Severity">
      <bpmn:incoming>SequenceFlow_EvaluateSeverity</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendForms</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2: Simple or Complex claim -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_ClaimType" name="Claim Type?">
      <bpmn:incoming>SequenceFlow_SendForms</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SimpleForm</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 4: Send forms -->
    <bpmn:task id="Task_SendForms" name="Send Relevant Forms to Claimant">
      <bpmn:incoming>SequenceFlow_SimpleForm</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FormsReturned</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 5: Check completeness -->
    <bpmn:task id="Task_CheckCompleteness" name="Check Forms for Completeness">
      <bpmn:incoming>SequenceFlow_FormsReturned</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CompletenessDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 3: Is complete? -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_IsComplete" name="All Details Provided?">
      <bpmn:incoming>SequenceFlow_CompletenessDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RegisterClaim</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_UpdateForms</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 6: Register claim -->
    <bpmn:task id="Task_RegisterClaim" name="Register Claim in Claims Management System">
      <bpmn:incoming>SequenceFlow_RegisterClaim</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndRegistered</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 2 -->
    <bpmn:endEvent id="EndEvent_ClaimRegistered" name="Claim Registered">
      <bpmn:incoming>SequenceFlow_EndRegistered</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task 7: Inform to update forms -->
    <bpmn:task id="Task_UpdateFormsNotification" name="Inform Claimant to Update Forms">
      <bpmn:incoming>SequenceFlow_UpdateForms</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_UpdatedFormsReceived</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 8: Check updated forms -->
    <bpmn:task id="Task_CheckUpdatedForms" name="Check Updated Forms Again">
      <bpmn:incoming>SequenceFlow_UpdatedFormsReceived</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CompletenessDecisionLoopback</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_01" sourceRef="StartEvent_ClaimReceived" targetRef="Task_CheckInsuredStatus">
      <bpmn:name></bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_02" name="Check Insured Status" sourceRef="Task_CheckInsuredStatus" targetRef="ExclusiveGateway_IsInsured">
      <bpmn:name></bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_RejectClaim" name="Not Insured" sourceRef="ExclusiveGateway_IsInsured" targetRef="Task_RejectClaim">
      <bpmn:name>No - Not Insured</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_EndRejected" name="" sourceRef="Task_RejectClaim" targetRef="EndEvent_ClaimRejected">
      <bpmn:name></bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_EvaluateSeverity" name="Is Insured" sourceRef="ExclusiveGateway_IsInsured" targetRef="Task_EvaluateSeverity">
      <bpmn:name>Yes - Insured</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_SendForms" name="" sourceRef="Task_EvaluateSeverity" targetRef="ExclusiveGateway_ClaimType">
      <bpmn:name></bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_SimpleForm" name="Send Forms" sourceRef="ExclusiveGateway_ClaimType" targetRef="Task_SendForms">
      <bpmn:name>Simple or Complex Claim</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_FormsReturned" name="" sourceRef="Task_SendForms" targetRef="Task_CheckCompleteness">
      <bpmn:name></bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_CompletenessDecision" name="" sourceRef="Task_CheckCompleteness" targetRef="ExclusiveGateway_IsComplete">
      <bpmn:name></bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_RegisterClaim" name="All Details Provided" sourceRef="ExclusiveGateway_IsComplete" targetRef="Task_RegisterClaim">
      <bpmn:name>Yes - Complete Details</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_EndRegistered" name="" sourceRef="Task_RegisterClaim" targetRef="EndEvent_ClaimRegistered">
      <bpmn:name></bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_UpdateForms" name="Missing Details" sourceRef="ExclusiveGateway_IsComplete" targetRef="Task_UpdateFormsNotification">
      <bpmn:name>No - Missing Details</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_UpdatedFormsReceived" name="" sourceRef="Task_UpdateFormsNotification" targetRef="Task_CheckUpdatedForms">
      <bpmn:name></bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_CompletenessDecisionLoopback" name="Check Again" sourceRef="Task_CheckUpdatedForms" targetRef="ExclusiveGateway_IsComplete">
      <bpmn:name></bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>