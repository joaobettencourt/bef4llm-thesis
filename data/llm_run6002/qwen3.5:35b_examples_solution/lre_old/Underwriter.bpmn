<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_0irv4eg">
    <bpmn:participant id="Participant_Underwriter" name="Underwriter Process" processRef="Process_IPO_1" />
  </bpmn:collaboration>

  <bpmn:process id="Process_IPO_1" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_DecisionToGoPublic" name="Decision to Go Public">
      <bpmn:outgoing>SequenceFlow_SelectUnderwriters</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Select Underwriters Task -->
    <bpmn:task id="Task_SelectUnderwriters" name="Select Underwriters">
      <bpmn:incoming>SequenceFlow_SelectUnderwriters</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SplitProcess</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway for concurrent activities -->
    <bpmn:parallelGateway id="ParallelGateway_Main" name="Split Process">
      <bpmn:incoming>SequenceFlow_SplitProcess</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckFactsPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PrepareRegistrationPath</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Check Facts Presented Task -->
    <bpmn:task id="Task_CheckFactsPresented" name="Check Facts Presented">
      <bpmn:incoming>SequenceFlow_CheckFactsPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FactsDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Decision Gateway for Facts Check -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_FactsCheck" name="Facts Fairly Presented?">
      <bpmn:incoming>SequenceFlow_FactsDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProceedIfYes</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Prepare Registration Statement Task -->
    <bpmn:task id="Task_PrepareRegistrationStatement" name="Prepare Registration Statement for SEC Approval">
      <bpmn:incoming>SequenceFlow_PrepareRegistrationPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckLawsPath</bpmn:outgoing>
    </bpmn:task>

    <!-- Check Compliance with Blue-Sky Laws Task -->
    <bpmn:task id="Task_CheckCompliance" name="Check Compliance with State Laws">
      <bpmn:incoming>SequenceFlow_CheckLawsPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RoadShowPath</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway for Road Show and SEC Wait -->
    <bpmn:parallelGateway id="ParallelGateway_Sync" name="Sync Activities">
      <bpmn:incoming>SequenceFlow_RoadShowPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FixIssuePrice</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Road Show Task -->
    <bpmn:task id="Task_ArrangeRoadShow" name="Arrange Road Show to Investors">
      <bpmn:incoming>SequenceFlow_RoadShowPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitForSEC</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Catch Event for SEC Response -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_SECResponse" name="Awaiting SEC Approval">
      <bpmn:incoming>SequenceFlow_WaitForSEC</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SECClearanceReceived</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Decision Gateway for SEC Approval -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_SECApproval" name="SEC Approved?">
      <bpmn:incoming>SequenceFlow_SECClearanceReceived</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FixPriceIfApproved</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Fix Issue Price Task -->
    <bpmn:task id="Task_FixIssuePrice" name="Fix Issue Price">
      <bpmn:incoming>SequenceFlow_FixPriceIfApproved</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BuyStockPath</bpmn:outgoing>
    </bpmn:task>

    <!-- Buy Stock Task -->
    <bpmn:task id="Task_EnterFirmCommitment" name="Enter Firm Commitment to Buy Stock">
      <bpmn:incoming>SequenceFlow_BuyStockPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OfferPublicPath</bpmn:outgoing>
    </bpmn:task>

    <!-- Offer to Public Task -->
    <bpmn:task id="Task_OffertoPublic" name="Offer Stock to Public">
      <bpmn:incoming>SequenceFlow_OfferPublicPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProcessComplete</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Complete" name="IPO Process Complete">
      <bpmn:incoming>SequenceFlow_ProcessComplete</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_SelectUnderwriters" sourceRef="StartEvent_DecisionToGoPublic" targetRef="Task_SelectUnderwriters" />
    
    <bpmn:sequenceFlow id="SequenceFlow_SplitProcess" name="" sourceRef="Task_SelectUnderwriters" targetRef="ParallelGateway_Main" />

    <!-- Facts Check Path -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckFactsPath" name="" sourceRef="ParallelGateway_Main" targetRef="Task_CheckFactsPresented" />
    
    <bpmn:sequenceFlow id="SequenceFlow_FactsDecision" name="" sourceRef="Task_CheckFactsPresented" targetRef="ExclusiveGateway_FactsCheck" />

    <!-- Registration Path -->
    <bpmn:sequenceFlow id="SequenceFlow_PrepareRegistrationPath" name="" sourceRef="ParallelGateway_Main" targetRef="Task_PrepareRegistrationStatement" />
    
    <bpmn:sequenceFlow id="SequenceFlow_CheckLawsPath" name="" sourceRef="Task_PrepareRegistrationStatement" targetRef="Task_CheckCompliance" />

    <!-- Road Show Path -->
    <bpmn:sequenceFlow id="SequenceFlow_RoadShowPath" name="" sourceRef="ParallelGateway_Main" targetRef="Task_ArrangeRoadShow" />
    
    <bpmn:sequenceFlow id="SequenceFlow_WaitForSEC" name="" sourceRef="Task_CheckCompliance" targetRef="IntermediateCatchEvent_SECResponse" />

    <!-- SEC Approval Decision -->
    <bpmn:sequenceFlow id="SequenceFlow_SECClearanceReceived" name="" sourceRef="IntermediateCatchEvent_SECResponse" targetRef="ExclusiveGateway_SECApproval" />
    
    <bpmn:sequenceFlow id="SequenceFlow_FixPriceIfApproved" name="Yes - Approved" sourceRef="ExclusiveGateway_SECApproval" targetRef="Task_FixIssuePrice" />

    <!-- Final Process Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_BuyStockPath" name="" sourceRef="Task_FixIssuePrice" targetRef="Task_EnterFirmCommitment" />
    
    <bpmn:sequenceFlow id="SequenceFlow_OfferPublicPath" name="" sourceRef="Task_EnterFirmCommitment" targetRef="Task_OffertoPublic" />

    <!-- Process Completion -->
    <bpmn:sequenceFlow id="SequenceFlow_ProcessComplete" name="" sourceRef="Task_OffertoPublic" targetRef="EndEvent_Complete" />

  </bpmn:process>
</bpmn:definitions>