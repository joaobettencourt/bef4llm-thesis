<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_001">
    <bpmn:participant id="Participant_Manufacturing" name="Company Manufacturing Customized Bicycles" processRef="Process_001"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_001" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_SalesDepartment" name="Sales Department">
        <bpmn:flowNodeRef>StartEvent_OrderReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AcceptRejectOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ShipBicycle</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Storehouse" name="Storehouse">
        <bpmn:flowNodeRef>InclusiveGateway_03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckPartQuantity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReservePart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BackOrderPart</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Engineering" name="Engineering Department">
        <bpmn:flowNodeRef>InclusiveGateway_05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareAssembling</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_OrderReceived" name="Receive Order">
      <bpmn:outgoing>SequenceFlow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1 - Accept/Reject Decision -->
    <bpmn:task id="Task_AcceptRejectOrder" name="Accept or Reject Order">
      <bpmn:incoming>SequenceFlow_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_02</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1 - Accept or Reject -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_01" name="Accept Order?">
      <bpmn:incoming>SequenceFlow_02</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_03</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_04</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Parallel Gateway - Split to Storehouse and Engineering -->
    <bpmn:parallelGateway id="ParallelGateway_02" name="">
      <bpmn:incoming>SequenceFlow_03</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_05</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_14</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Storehouse Inclusive Gateway (Loop for parts) -->
    <bpmn:inclusiveGateway id="InclusiveGateway_03" name="">
      <bpmn:incoming>SequenceFlow_05</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_06</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Task - Check Part Quantity -->
    <bpmn:task id="Task_CheckPartQuantity" name="Check Required Quantity">
      <bpmn:incoming>SequenceFlow_06</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_07</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway - Available in-house? -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_04" name="">
      <bpmn:incoming>SequenceFlow_07</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_08</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_09</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task - Reserve Part -->
    <bpmn:task id="Task_ReservePart" name="Reserve Part">
      <bpmn:incoming>SequenceFlow_08</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_12</bpmn:outgoing>
    </bpmn:task>

    <!-- Task - Back-order Part -->
    <bpmn:task id="Task_BackOrderPart" name="Back-Order Part">
      <bpmn:incoming>SequenceFlow_09</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_12</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway - Any part left unchecked? -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_05" name="">
      <bpmn:incoming>SequenceFlow_12</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_13</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Engineering Task - Prepare for Assembling -->
    <bpmn:task id="Task_PrepareAssembling" name="Prepare for Assembling">
      <bpmn:incoming>SequenceFlow_14</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_15</bpmn:outgoing>
    </bpmn:task>

    <!-- Convergence Gateway - All parts processed AND preparation finished -->
    <bpmn:parallelGateway id="ParallelGateway_06" name="">
      <bpmn:incoming>SequenceFlow_13</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_15</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_17</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task - Assemble Bicycle -->
    <bpmn:task id="Task_AssembleBicycle" name="Assemble Bicycle">
      <bpmn:incoming>SequenceFlow_17</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_18</bpmn:outgoing>
    </bpmn:task>

    <!-- Task - Ship Bicycle -->
    <bpmn:task id="Task_ShipBicycle" name="Ship to Customer">
      <bpmn:incoming>SequenceFlow_18</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_19</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_ProcessFinished" name="">
      <bpmn:incoming>SequenceFlow_19</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_01" sourceRef="StartEvent_OrderReceived" targetRef="Task_AcceptRejectOrder"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_02" sourceRef="Task_AcceptRejectOrder" targetRef="ExclusiveGateway_01"/>
    
    <!-- Reject Path -->
    <bpmn:sequenceFlow id="SequenceFlow_03" name="No - Reject Order" sourceRef="ExclusiveGateway_01" targetRef="EndEvent_ProcessFinished">
      <bpmn:name>No</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Accept Path -->
    <bpmn:sequenceFlow id="SequenceFlow_04" name="Yes - Inform Departments" sourceRef="ExclusiveGateway_01" targetRef="ParallelGateway_02">
      <bpmn:name>Yes</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Storehouse Path -->
    <bpmn:sequenceFlow id="SequenceFlow_05" sourceRef="ParallelGateway_02" targetRef="InclusiveGateway_03"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_06" sourceRef="InclusiveGateway_03" targetRef="Task_CheckPartQuantity"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_07" sourceRef="Task_CheckPartQuantity" targetRef="ExclusiveGateway_04"/>

    <!-- Available Path -->
    <bpmn:sequenceFlow id="SequenceFlow_08" name="Yes - In-house" sourceRef="ExclusiveGateway_04" targetRef="Task_ReservePart">
      <bpmn:name>Available</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Not Available Path -->
    <bpmn:sequenceFlow id="SequenceFlow_09" name="No - Back-order" sourceRef="ExclusiveGateway_04" targetRef="Task_BackOrderPart">
      <bpmn:name>Not Available</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Loop back to check next part -->
    <bpmn:sequenceFlow id="SequenceFlow_12" sourceRef="Task_ReservePart" targetRef="ExclusiveGateway_05"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_13" name="" sourceRef="Task_BackOrderPart" targetRef="ExclusiveGateway_05"/>

    <!-- More Parts? -->
    <bpmn:sequenceFlow id="SequenceFlow_16" name="Yes - More Parts?" sourceRef="ExclusiveGateway_05" targetRef="InclusiveGateway_03">
      <bpmn:name>More?</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Engineering Path -->
    <bpmn:sequenceFlow id="SequenceFlow_14" sourceRef="ParallelGateway_02" targetRef="Task_PrepareAssembling"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_15" name="" sourceRef="Task_PrepareAssembling" targetRef="ParallelGateway_06"/>

    <!-- Convergence and Assembly Path -->
    <bpmn:sequenceFlow id="SequenceFlow_17" sourceRef="ParallelGateway_06" targetRef="Task_AssembleBicycle"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_18" name="" sourceRef="Task_AssembleBicycle" targetRef="Task_ShipBicycle"/>

    <!-- Final Flow to End -->
    <bpmn:sequenceFlow id="SequenceFlow_19" name="" sourceRef="Task_ShipBicycle" targetRef="EndEvent_ProcessFinished"/>

  </bpmn:process>
</bpmn:definitions>