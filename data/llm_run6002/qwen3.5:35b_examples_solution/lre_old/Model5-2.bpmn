<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_VacationRequest_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_VacationRequest_001">
    <bpmn:participant id="Participant_Organization_001" name="Organization Vacation Request Process" processRef="Process_VacationRequest_001"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_VacationRequest_001" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Employee_001" name="Employee">
        <bpmn:flowNodeRef>StartEvent_SubmitRequest_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegisterVacationRequest_001</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Supervisor_001" name="Supervisor">
        <bpmn:flowNodeRef>ExclusiveGateway_ApprovalDecision_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VacationRequestApproval_001</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_HRRep_001" name="HR Representative">
        <bpmn:flowNodeRef>Task_CompleteManagementProcedures_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ProcessComplete_001</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_SubmitRequest_001" name="Submit Vacation Request">
      <bpmn:outgoing>SequenceFlow_StartToRegister_001</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1 -->
    <bpmn:task id="Task_RegisterVacationRequest_001" name="Register Vacation Request">
      <bpmn:incoming>SequenceFlow_StartToRegister_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RegisterToApproval_001</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2 -->
    <bpmn:task id="Task_VacationRequestApproval_001" name="Approve Vacation Request">
      <bpmn:incoming>SequenceFlow_RegisterToApproval_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ApprovalToGateway_001</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_ApprovalDecision_001" name="Approved?">
      <bpmn:incoming>SequenceFlow_ApprovalToGateway_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RejectedPath_001</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ApprovedPath_001</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 3 (Rejected Path) -->
    <bpmn:task id="Task_InformEmployee_001" name="Inform Employee of Rejection">
      <bpmn:incoming>SequenceFlow_RejectedPath_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RejectToEnd_001</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 4 (Approved Path) -->
    <bpmn:task id="Task_CompleteManagementProcedures_001" name="Complete Management Procedures">
      <bpmn:incoming>SequenceFlow_ApprovedPath_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ManagementToEnd_001</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_ProcessComplete_001" name="Process Complete">
      <bpmn:incoming>SequenceFlow_RejectToEnd_001</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ManagementToEnd_001</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToRegister_001" name="" sourceRef="StartEvent_SubmitRequest_001" targetRef="Task_RegisterVacationRequest_001"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_RegisterToApproval_001" name="" sourceRef="Task_RegisterVacationRequest_001" targetRef="Task_VacationRequestApproval_001"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ApprovalToGateway_001" name="" sourceRef="Task_VacationRequestApproval_001" targetRef="ExclusiveGateway_ApprovalDecision_001"/>
    
    <!-- Rejected path -->
    <bpmn:sequenceFlow id="SequenceFlow_RejectedPath_001" name="Rejected" sourceRef="ExclusiveGateway_ApprovalDecision_001" targetRef="Task_InformEmployee_001"/>

    <!-- Approved path -->
    <bpmn:sequenceFlow id="SequenceFlow_ApprovedPath_001" name="Approved" sourceRef="ExclusiveGateway_ApprovalDecision_001" targetRef="Task_CompleteManagementProcedures_001"/>

    <!-- Final flows to end event -->
    <bpmn:sequenceFlow id="SequenceFlow_RejectToEnd_001" name="" sourceRef="Task_InformEmployee_001" targetRef="EndEvent_ProcessComplete_001"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ManagementToEnd_001" name="" sourceRef="Task_CompleteManagementProcedures_001" targetRef="EndEvent_ProcessComplete_001"/>

  </bpmn:process>
</bpmn:definitions>