<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_FarmingBot_v2" targetNamespace="http://bpmnio.com">
  <bpmn:collaboration id="Collab_FarmingBotProcess_v2">
    <bpmn:participant id="Participant_GameSystem_v2" name="Farming Bot System" processRef="Proc_FarmingBot_v2"/>
  </bpmn:collaboration>

  <bpmn:process id="Proc_FarmingBot_v2" isExecutable="false">
    
    <!-- Data Objects -->
    <bpmn:dataObject id="Data_ResourcesList_v2" name="Selected Resources List"/>
    <bpmn:dataObject id="Data_ToolRequirements_v2" name="Tool Requirements Map"/>

    <!-- Start Event -->
    <bpmn:startEvent id="Start_GameSession_v2" name="Game Session Started">
      <bpmn:outgoing>Sequence_StartToConfigure_v2</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Configuration Phase - Select Resources -->
    <bpmn:userTask id="Task_SelectResources_v2" name="Select Farming Resources">
      <bpmn:incoming>Sequence_StartToConfigure_v2</bpmn:incoming>
      <bpmn:outgoing>Sequence_ValidatePreferences_v2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Validate Preferences -->
    <bpmn:exclusiveGateway id="Gateway_PreferencesValid_v2" name="All Resources Selected?">
      <bpmn:incoming>Sequence_ValidatePreferences_v2</bpmn:incoming>
      <bpmn:outgoing>Sequence_StartFarmingLoop_v2</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Parallel Resource Collection -->
    <bpmn:parallelGateway id="Parallel_GatherResources_v2" name="Gather Resources">
      <bpmn:incoming>Sequence_StartFarmingLoop_v2</bpmn:incoming>
      <bpmn:outgoing>Sequence_ResourceTask_v2</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Resource Collection Task -->
    <bpmn:userTask id="Task_GatherResource_v2" name="Gather Selected Resources">
      <bpmn:incoming>Sequence_ResourceTask_v2</bpmn:incoming>
      <bpmn:outgoing>Sequence_CheckToolsNeeded_v2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Tool Dependency Check -->
    <bpmn:exclusiveGateway id="Gateway_ToolsAvailable_v2" name="Required Tools Available?">
      <bpmn:incoming>Sequence_CheckToolsNeeded_v2</bpmn:incoming>
      <bpmn:outgoing>Sequence_CreateToolTask_v2</bpmn:outgoing>
      <bpmn:outgoing>Sequence_ProceedGathering_v2</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Create Tools if needed -->
    <bpmn:userTask id="Task_CreateTools_v2" name="Create Required Tools">
      <bpmn:incoming>Sequence_CreateToolTask_v2</bpmn:incoming>
      <bpmn:outgoing>Sequence_ProceedGathering_v2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Converge after tool creation -->
    <bpmn:parallelGateway id="Parallel_GatherComplete_v2" name="All Resources Gathered">
      <bpmn:incoming>Sequence_ResourceTask_v2</bpmn:incoming>
      <bpmn:outgoing>Sequence_StartFarmingLoop_v2</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Main Farming Loop -->
    <bpmn:userTask id="Task_FarmResources_v2" name="Execute Bot Farming">
      <bpmn:incoming>Sequence_StartFarmingLoop_v2</bpmn:incoming>
      <bpmn:outgoing>Sequence_CheckMilestone_v2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Milestone Check -->
    <bpmn:exclusiveGateway id="Gateway_MilestoneReached_v2" name="Milestone Reached?">
      <bpmn:incoming>Sequence_CheckMilestone_v2</bpmn:incoming>
      <bpmn:outgoing>Sequence_NotifyPlayerTask_v2</bpmn:outgoing>
      <bpmn:outgoing>Sequence_ContinueFarmingLoop_v2</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Notification Task -->
    <bpmn:userTask id="Task_NotifyMilestone_v2" name="Notify Player of Milestone">
      <bpmn:incoming>Sequence_NotifyPlayerTask_v2</bpmn:incoming>
      <bpmn:outgoing>Sequence_ContinueFarmingLoop_v2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Natural Disaster Exception Handling -->
    <bpmn:intermediateCatchEvent id="Event_Disaster_v2" name="Natural Disaster">
      <bpmn:incoming>Sequence_FarmToDisaster_v2</bpmn:incoming>
      <bpmn:outgoing>Sequence_RecoverFromDisasterTask_v2</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Recovery from disaster -->
    <bpmn:userTask id="Task_DisasterRecovery_v2" name="Bot Recovers">
      <bpmn:incoming>Sequence_RecoverFromDisasterTask_v2</bpmn:incoming>
      <bpmn:outgoing>Sequence_ContinueFarmingLoop_v2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Update Materials Loop -->
    <bpmn:exclusiveGateway id="Gateway_UpdateMaterials_v2" name="Update Materials List?">
      <bpmn:incoming>Sequence_FarmToDisaster_v2</bpmn:incoming>
      <bpmn:outgoing>Sequence_ProcessUpdateRequestTask_v2</bpmn:outgoing>
      <bpmn:outgoing>Sequence_ContinueFarmingLoop_v2</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Process Update Request -->
    <bpmn:userTask id="Task_UpdateMaterials_v2" name="Update Materials List">
      <bpmn:incoming>Sequence_ProcessUpdateRequestTask_v2</bpmn:incoming>
      <bpmn:outgoing>Sequence_ContinueFarmingLoop_v2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Check if Farming Complete -->
    <bpmn:exclusiveGateway id="Gateway_FarmComplete_v2" name="All Resources Collected?">
      <bpmn:incoming>Sequence_CheckMilestone_v2</bpmn:incoming>
      <bpmn:outgoing>Sequence_EndActivitiesTask_v2</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Activities -->
    <bpmn:userTask id="Task_BragToFriends_v2" name="Brag to Friends">
      <bpmn:incoming>Sequence_EndActivitiesTask_v2</bpmn:incoming>
      <bpmn:outgoing>Sequence_FinalEnd1_v2</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_SendMaterials_v2" name="Send Materials to Friends">
      <bpmn:incoming>Sequence_EndActivitiesTask_v2</bpmn:incoming>
      <bpmn:outgoing>Sequence_FinalEnd2_v2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Events -->
    <bpmn:endEvent id="End_BotFinished_v2" name="Farming Bot Finished">
      <bpmn:incoming>Sequence_EndActivitiesTask_v2</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="End_GameSessionEnded_v2" name="Game Session Ended">
      <bpmn:terminateEventDefinition/>
      <bpmn:incoming>Sequence_FinalEnd1_v2</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Sequence_StartToConfigure_v2" sourceRef="Start_GameSession_v2" targetRef="Task_SelectResources_v2"/>
    <bpmn:sequenceFlow id="Sequence_ValidatePreferences_v2" sourceRef="Task_SelectResources_v2" targetRef="Gateway_PreferencesValid_v2"/>
    <bpmn:sequenceFlow id="Sequence_StartFarmingLoop_v2" name="Yes - Start Farming" sourceRef="Gateway_PreferencesValid_v2" targetRef="Parallel_GatherResources_v2"/>

    <!-- Resource Collection Flows -->
    <bpmn:sequenceFlow id="Sequence_ResourceTask_v2" sourceRef="Parallel_GatherResources_v2" targetRef="Task_GatherResource_v2"/>
    <bpmn:sequenceFlow id="Sequence_CheckToolsNeeded_v2" sourceRef="Task_GatherResource_v2" targetRef="Gateway_ToolsAvailable_v2"/>

    <!-- Tool Flows -->
    <bpmn:sequenceFlow id="Sequence_CreateToolTask_v2" name="No - Create Tools First" sourceRef="Gateway_ToolsAvailable_v2" targetRef="Task_CreateTools_v2"/>
    <bpmn:sequenceFlow id="Sequence_ProceedGathering_v2" name="Yes or After Creation" sourceRef="Task_CreateTools_v2" targetRef="Parallel_GatherComplete_v2"/>

    <!-- Farming Loop Flows -->
    <bpmn:sequenceFlow id="Sequence_FarmLoopToDisaster_v2" sourceRef="Task_FarmResources_v2" targetRef="Event_Disaster_v2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${disasterOccurred}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Sequence_RecoverFromDisasterTask_v2" sourceRef="Event_Disaster_v2" targetRef="Task_DisasterRecovery_v2"/>

    <!-- Milestone Flows -->
    <bpmn:sequenceFlow id="Sequence_CheckMilestone_v2" sourceRef="Task_FarmResources_v2" targetRef="Gateway_MilestoneReached_v2"/>
    <bpmn:sequenceFlow id="Sequence_NotifyPlayerTask_v2" name="Yes - Notify Player" sourceRef="Gateway_MilestoneReached_v2" targetRef="Task_NotifyMilestone_v2"/>

    <!-- Update Materials Flows -->
    <bpmn:sequenceFlow id="Sequence_ProcessUpdateRequestTask_v2" name="Yes - Update List" sourceRef="Gateway_UpdateMaterials_v2" targetRef="Task_UpdateMaterials_v2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${updateRequested}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Continue Farming Loop -->
    <bpmn:sequenceFlow id="Sequence_ContinueFarmingLoop_v2" name="No or After Notification/Update" sourceRef="Task_NotifyMilestone_v2" targetRef="Parallel_GatherComplete_v2"/>
    <bpmn:sequenceFlow id="Sequence_FarmToDisaster_v2" name="Check Disaster/Update" sourceRef="Gateway_MilestoneReached_v2" targetRef="Event_Disaster_v2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!disasterOccurred}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- End Activities Flows -->
    <bpmn:sequenceFlow id="Sequence_EndActivitiesTask_v2" name="All Resources Collected" sourceRef="Gateway_FarmComplete_v2" targetRef="End_BotFinished_v2"/>
    <bpmn:sequenceFlow id="Sequence_FinalEnd1_v2" sourceRef="Task_BragToFriends_v2" targetRef="End_GameSessionEnded_v2"/>

  </bpmn:process>
</bpmn:definitions>