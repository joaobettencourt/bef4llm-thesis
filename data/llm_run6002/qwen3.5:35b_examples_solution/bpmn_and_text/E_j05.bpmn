<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_WorkLiveAustria" targetNamespace="http://bpmnio.com">
  <bpmn:collaboration id="Collab_AustriaProcess">
    <bpmn:participant id="Participant_Applicant" name="Applicant Process" processRef="Proc_VisaApplication"/>
  </bpmn:collaboration>

  <bpmn:process id="Proc_VisaApplication" isExecutable="false">
    
    <!-- Lane Organization -->
    <bpmn:laneSet id="Lane_Set_01">
      <bpmn:lane id="Lane_Preparation" name="Preparation Phase">
        <bpmn:flowNodeRef>StartEvent_CheckRequirements</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VerifyPassportValidity</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Accommodation" name="Accommodation &amp; Services">
        <bpmn:flowNodeRef>Gateway_DecideStayDuration</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OrganizeAccommodation</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Visa" name="Visa Application">
        <bpmn:flowNodeRef>Gateway_DecideStayDuration</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OpenBankAccount</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_CheckRequirements" name="Check Requirements">
      <bpmn:outgoing>SequenceFlow_01_StartToPassport</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task - Passport Verification -->
    <bpmn:userTask id="Task_VerifyPassportValidity" name="Verify Passport Validity">
      <bpmn:description>A travel document valid in Austria, with validity period exceeding visa duration by at least 3 months and two empty pages</bpmn:description>
      <bpmn:incoming>SequenceFlow_01_StartToPassport</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckStayDuration</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway - Stay Duration Decision -->
    <bpmn:xorGateway id="Gateway_DecideStayDuration" name="How long are you going to stay?">
      <bpmn:incoming>SequenceFlow_CheckStayDuration</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_02_AccommodationPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_03_BankPath</bpmn:outgoing>
    </bpmn:xorGateway>

    <!-- Parallel Tasks - Accommodation and Bank Account -->
    <bpmn:userTask id="Task_OrganizeAccommodation" name="Organize Accommodation">
      <bpmn:description>Negotiate accommodation arrangements</bpmn:description>
      <bpmn:incoming>SequenceFlow_02_AccommodationPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConfirmAccommodation</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_OpenBankAccount" name="Open Austrian Bank Account">
      <bpmn:description>Negotiate bank account opening requirements</bpmn:description>
      <bpmn:incoming>SequenceFlow_03_BankPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConfirmBankAccount</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel Gateway - Convergence -->
    <bpmn:parallelGateway id="Parallel_Gateway_Accommodation" name="">
      <bpmn:incoming>SequenceFlow_ConfirmAccommodation</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ConfirmBankAccount</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_VisaPreparationStart</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Visa Application Tasks -->
    <bpmn:userTask id="Task_PrepareVisaDocuments" name="Prepare Visa Documents">
      <bpmn:description>Gather required documents (insurance, proof of subsistence, etc.)</bpmn:description>
      <bpmn:incoming>SequenceFlow_VisaPreparationStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SubmitVisaApplication</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Decision - Visa Type -->
    <bpmn:xorGateway id="Gateway_VisaType" name="Which visa type?">
      <bpmn:incoming>SequenceFlow_SubmitVisaApplication</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SchengenPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RotWeissRotPath</bpmn:outgoing>
    </bpmn:xorGateway>

    <!-- Schengen Visa Path -->
    <bpmn:userTask id="Task_SchengenVisa" name="Apply for Schengen Visa">
      <bpmn:description>Schengen visa issued by representation office of main destination</bpmn:description>
      <bpmn:incoming>SequenceFlow_SchengenPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_VisaDecisionIn</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Rot-Weiss-Rot Card Path -->
    <bpmn:userTask id="Task_RotWeissRotCard" name="Apply for Rot-Weiß-Rot Card">
      <bpmn:description>Type D visa - must be applied at competent Austrian representation</bpmn:description>
      <bpmn:incoming>SequenceFlow_RotWeissRotPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_VisaDecisionIn2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Visa Decision Gateway -->
    <bpmn:xorGateway id="Gateway_VisaDecision" name="Visa Approved?">
      <bpmn:incoming>SequenceFlow_VisaDecisionIn</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_VisaDecisionIn2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_LiveWorkPath</bpmn:outgoing>
    </bpmn:xorGateway>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_Success" name="Live and Work in Austria">
      <bpmn:incoming>SequenceFlow_LiveWorkPath</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>

  <!-- Sequence Flows -->
  <bpmn:sequenceFlow id="SequenceFlow_01_StartToPassport" sourceRef="StartEvent_CheckRequirements" targetRef="Task_VerifyPassportValidity"/>
  
  <bpmn:sequenceFlow id="SequenceFlow_CheckStayDuration" name="" sourceRef="Task_VerifyPassportValidity" targetRef="Gateway_DecideStayDuration"/>

  <bpmn:sequenceFlow id="SequenceFlow_02_AccommodationPath" name="Accommodation Required" sourceRef="Gateway_DecideStayDuration" targetRef="Task_OrganizeAccommodation"/>
  
  <bpmn:sequenceFlow id="SequenceFlow_03_BankPath" name="Bank Account Required" sourceRef="Gateway_DecideStayDuration" targetRef="Task_OpenBankAccount"/>

  <bpmn:sequenceFlow id="SequenceFlow_ConfirmAccommodation" name="" sourceRef="Task_OrganizeAccommodation" targetRef="Parallel_Gateway_Accommodation"/>
  
  <bpmn:sequenceFlow id="SequenceFlow_ConfirmBankAccount" name="" sourceRef="Task_OpenBankAccount" targetRef="Parallel_Gateway_Accommodation"/>

  <bpmn:sequenceFlow id="SequenceFlow_VisaPreparationStart" name="" sourceRef="Parallel_Gateway_Accommodation" targetRef="Task_PrepareVisaDocuments"/>
  
  <bpmn:sequenceFlow id="SequenceFlow_SubmitVisaApplication" name="" sourceRef="Task_PrepareVisaDocuments" targetRef="Gateway_VisaType"/>

  <bpmn:sequenceFlow id="SequenceFlow_SchengenPath" name="Schengen Visa (&lt;90 days)" sourceRef="Gateway_VisaType" targetRef="Task_SchengenVisa"/>
  
  <bpmn:sequenceFlow id="SequenceFlow_RotWeissRotPath" name="Work/Residence (Type D)" sourceRef="Gateway_VisaType" targetRef="Task_RotWeissRotCard"/>

  <bpmn:sequenceFlow id="SequenceFlow_VisaDecisionIn" name="" sourceRef="Task_SchengenVisa" targetRef="Gateway_VisaDecision"/>
  
  <bpmn:sequenceFlow id="SequenceFlow_VisaDecisionIn2" name="" sourceRef="Task_RotWeissRotCard" targetRef="Gateway_VisaDecision"/>

  <bpmn:sequenceFlow id="SequenceFlow_LiveWorkPath" name="Approved" sourceRef="Gateway_VisaDecision" targetRef="EndEvent_Success"/>

</bpmn:definitions>