<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_DIYRepair" targetNamespace="http://bpmnio.com">
  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="Participant_DiyTool" name="DIY Repair Tool Process" processRef="Process_DIYRepair"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_DIYRepair" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Hardware Issue Detected">
      <bpmn:outgoing>SequenceFlow_LoginCheck</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Account Check Gateway -->
    <bpmn:xorGateway id="Gateway_AccountExists" name="Have an account?">
      <bpmn:incoming>SequenceFlow_LoginCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CreateAccountPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_LogInAttempt</bpmn:outgoing>
    </bpmn:xorGateway>

    <!-- Create Account Task -->
    <bpmn:userTask id="Task_CreateAccount" name="Create account">
      <bpmn:incoming>SequenceFlow_CreateAccountPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConvergeLogin</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Login Task -->
    <bpmn:userTask id="Task_LogIn" name="Log into account">
      <bpmn:incoming>SequenceFlow_LogInAttempt</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_LoginSuccessCheck</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Login Success Gateway -->
    <bpmn:xorGateway id="Gateway_LoginSuccess" name="Login Successful?">
      <bpmn:incoming>SequenceFlow_LoginSuccessCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EnterDeviceInfoPath1</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RetryLogIn</bpmn:outgoing>
    </bpmn:xorGateway>

    <!-- Retry Loop -->
    <bpmn:sequenceFlow id="SequenceFlow_RetryLogIn" name="No">
      <bpmn:sourceRef>Gateway_LoginSuccess</bpmn:sourceRef>
      <bpmn:targetRef>Task_LogIn</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Converge Login Paths -->
    <bpmn:xorGateway id="Gateway_ConvergeLogin" name="">
      <bpmn:incoming>SequenceFlow_CreateAccountPath2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EnterDeviceInfoPath1</bpmn:outgoing>
    </bpmn:xorGateway>

    <!-- Device Info Tasks -->
    <bpmn:userTask id="Task_SelectModel" name="Select device model">
      <bpmn:incoming>SequenceFlow_EnterDeviceInfoPath2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SelectIssue</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_SelectIssue" name="Select type of hardware Issue">
      <bpmn:incoming>SequenceFlow_SelectModel</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SystemProcessStart</bpmn:outgoing>
    </bpmn:userTask>

    <!-- System Processing (Parallel) -->
    <bpmn:parallelGateway id="Gateway_SplitSystem" name="">
      <bpmn:incoming>SequenceFlow_SystemProcessStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ListMaterialsPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ListToolsPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_OfferChoicesPath</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Service Tasks -->
    <bpmn:serviceTask id="Service_Task_Materials" name="List required materials">
      <bpmn:incoming>SequenceFlow_ListMaterialsPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConvergeSystem1</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Service_Task_Tools" name="List required tools">
      <bpmn:incoming>SequenceFlow_ListToolsPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConvergeSystem1</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Service_Task_Offer" name="Offer ordering choices">
      <bpmn:incoming>SequenceFlow_OfferChoicesPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConvergeSystem1</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Converge System Tasks -->
    <bpmn:parallelGateway id="Gateway_CombineSystem" name="">
      <bpmn:incoming>SequenceFlow_ConvergeSystem1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckItemsNeeded</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Sourcing Decision -->
    <bpmn:xorGateway id="Gateway_HaveAllItems" name="Have all required items?">
      <bpmn:incoming>SequenceFlow_CheckItemsNeeded</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProceedToInstructionsPath1</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NeedSourcing</bpmn:outgoing>
    </bpmn:xorGateway>

    <!-- Sourcing Logic -->
    <bpmn:userTask id="Task_GetSecondHand" name="Get second-hand tools/materials from friends">
      <bpmn:incoming>SequenceFlow_NeedSourcing</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ConvergeSourcing1