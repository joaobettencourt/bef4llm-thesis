<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ViennaNightRun" targetNamespace="http://bpmnio.com">
  <bpmn:collaboration id="Collab_NightRunProcess">
    <bpmn:participant id="Participant_Runner" name="Vienna Night Run App Process" processRef="Proc_NightRun"/>
  </bpmn:collaboration>

  <bpmn:process id="Proc_NightRun" isExecutable="false">
    
    <!-- Lane Organization -->
    <bpmn:laneSet id="Lane_Set_01">
      <bpmn:lane id="Lane_Runner" name="Runner">
        <bpmn:flowNodeRef>StartEvent_Participate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectStartingBlock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_TimingCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TrainAndRecheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GetStartingNumber</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_WorkdayCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GoFromHome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LeaveDirectlyWork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RunDrinkParallel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ActualRun</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DrinkDuringRun</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ConvergeAfterRun</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_RunFinished</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Participate" name="Participate Night Run">
      <bpmn:outgoing>SequenceFlow_01_StartToSelectBlock</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Select Starting Block -->
    <bpmn:task id="Task_SelectStartingBlock" name="Select starting block">
      <bpmn:incoming>SequenceFlow_01_StartToSelectBlock</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_02_ToRunAndMeasure</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway for Run and Measure -->
    <bpmn:parallelGateway id="Parallel_RunMeasure" name="">
      <bpmn:incoming>SequenceFlow_02_ToRunAndMeasure</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_03_StartRunning</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_04_StartMeasuring</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Run 5km -->
    <bpmn:task id="Task_ActualRun" name="Run for 5 km">
      <bpmn:incoming>SequenceFlow_03_StartRunning</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_12_RunComplete</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Start Measuring Time -->
    <bpmn:task id="Task_StartMeasuring" name="Start to measure time">
      <bpmn:incoming>SequenceFlow_04_StartMeasuring</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_13_MeasureComplete</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway Converge -->
    <bpmn:parallelGateway id="Parallel_ConvergeRunMeasure" name="">
      <bpmn:incoming>SequenceFlow_12_RunComplete</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_13_MeasureComplete</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_05_GetTotalTime</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Get Total Running Time -->
    <bpmn:task id="Task_GetTotalRunningTime" name="Get total running time">
      <bpmn:incoming>SequenceFlow_05_GetTotalTime</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_06_ToTimingCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway for Timing Check -->
    <bpmn:exclusiveGateway id="Gateway_TimingCheck" name="Took less than 25 minutes?">
      <bpmn:incoming>SequenceFlow_06_ToTimingCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_07_TimeGood</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_08_TrainLoop</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Train and Recheck (if time not good) -->
    <bpmn:task id="Task_TrainAndRecheck" name="Train and check">
      <bpmn:incoming>SequenceFlow_08_TrainLoop</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_02_ToRunAndMeasure</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Satisfied with Result -->
    <bpmn:task id="Task_SatisfiedResult" name="Satisfied with result">
      <bpmn:incoming>SequenceFlow_07_TimeGood</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_14_GetStartingNumber</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Get Starting Number -->
    <bpmn:task id="Task_GetStartingNumber" name="Get starting number">
      <bpmn:incoming>SequenceFlow_14_GetStartingNumber</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_09_WorkdayCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway for Workday Check -->
    <bpmn:exclusiveGateway id="Gateway_WorkdayCheck" name="More than 1 hour before starting time?">
      <bpmn:incoming>SequenceFlow_09_WorkdayCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_15_GoFromHome</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_16_DirectlyWork</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Go from Home -->
    <bpmn:task id="Task_GoFromHome" name="Go to the run from home">
      <bpmn:incoming>SequenceFlow_15_GoFromHome</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_20_ConvergeBeforeRun</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Leave Directly from Work -->
    <bpmn:task id="Task_LeaveDirectlyWork" name="Go directly after work to the run">
      <bpmn:incoming>SequenceFlow_16_DirectlyWork</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_20_ConvergeBeforeRun</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway Converge -->
    <bpmn:exclusiveGateway id="Parallel_ConvergeBeforeRun" name="">
      <bpmn:incoming>SequenceFlow_17_StartNightRunProcess</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_20_ConvergeBeforeRun</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Parallel Gateway for Run and Drink -->
    <bpmn:parallelGateway id="Parallel_RunDrink" name="">
      <bpmn:incoming>SequenceFlow_17_StartNightRunProcess</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_21_ActualRunning</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_22_DrinkDuringRun</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Drink During Run -->
    <bpmn:task id="Task_DrinkDuringRun" name="Drink iso sport">
      <bpmn:incoming>SequenceFlow_22_DrinkDuringRun</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_19_DrinkComplete</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway Converge After Run -->
    <bpmn:parallelGateway id="Parallel_ConvergeRunDrink" name="">
      <bpmn:incoming>SequenceFlow_18_RunComplete2</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_19_DrinkComplete</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_23_GetFinalTime</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Receive Final Running Time -->
    <bpmn:task id="Task_FinalRunningTime" name="Receive final running time">
      <bpmn:incoming>SequenceFlow_23_GetFinalTime</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_End_RunFinished</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_RunFinished" name="Run finished">
      <bpmn:incoming>SequenceFlow_End_RunFinished</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_01_StartToSelectBlock" sourceRef="StartEvent_Participate" targetRef="Task_SelectStartingBlock"/>
    <bpmn:sequenceFlow id="SequenceFlow_02_ToRunAndMeasure" sourceRef="Task_SelectStartingBlock" targetRef="Parallel_RunMeasure"/>
    <bpmn:sequenceFlow id="SequenceFlow_03_StartRunning" name="" sourceRef="Parallel_RunMeasure" targetRef="Task_ActualRun"/>
    <bpmn:sequenceFlow id="SequenceFlow_04_StartMeasuring" name="" sourceRef="Parallel_RunMeasure" targetRef="Task_StartMeasuring"/>
    <bpmn:sequenceFlow id="SequenceFlow_12_RunComplete" name="" sourceRef="Task_ActualRun" targetRef="Parallel_ConvergeRunDrink"/>
    <bpmn:sequenceFlow id="SequenceFlow_05_GetTotalTime" sourceRef="Parallel_ConvergeRunMeasure" targetRef="Task_StartMeasuring"/>
    <bpmn:sequenceFlow id="SequenceFlow_13_MeasureComplete" name="" sourceRef="Task_StartMeasuring" targetRef="Parallel_ConvergeRunMeasure"/>
    <bpmn:sequenceFlow id="SequenceFlow_06_ToTimingCheck" sourceRef="Task_GetTotalRunningTime" targetRef="Gateway_TimingCheck"/>
    <bpmn:sequenceFlow id="SequenceFlow_14_GetStartingNumber" name="" sourceRef="Task_SatisfiedResult" targetRef="Task_GetStartingNumber"/>
    <bpmn:sequenceFlow id="SequenceFlow_07_TimeGood" name="yes" sourceRef="Gateway_TimingCheck" targetRef="Task_SatisfiedResult"/>
    <bpmn:sequenceFlow id="SequenceFlow_08_TrainLoop" name="no" sourceRef="Gateway_TimingCheck" targetRef="Task_TrainAndRecheck"/>
    <bpmn:sequenceFlow id="SequenceFlow_15_GoFromHome" name="yes (more than 1 hour)" sourceRef="Gateway_WorkdayCheck" targetRef="Task_GoFromHome"/>
    <bpmn:sequenceFlow id="SequenceFlow_16_DirectlyWork" name="no (less time left)" sourceRef="Gateway_WorkdayCheck" targetRef="Task_LeaveDirectlyWork"/>
    <bpmn:sequenceFlow id="SequenceFlow_09_WorkdayCheck" sourceRef="Task_GetStartingNumber" targetRef="Gateway_WorkdayCheck"/>
    <bpmn:sequenceFlow id="SequenceFlow_20_ConvergeBeforeRun" name="" sourceRef="Parallel_RunDrink" targetRef="Parallel_ConvergeBeforeRun"/>
    <bpmn:sequenceFlow id="SequenceFlow_17_StartNightRunProcess" sourceRef="Task_GoFromHome" targetRef="Parallel_RunDrink"/>
    <bpmn:sequenceFlow id="SequenceFlow_21_ActualRunning" name="" sourceRef="Parallel_RunDrink" targetRef="Task_ActualRun"/>
    <bpmn:sequenceFlow id="SequenceFlow_22_DrinkDuringRun" name="" sourceRef="Parallel_RunDrink" targetRef="Task_DrinkDuringRun"/>
    <bpmn:sequenceFlow id="SequenceFlow_18_ConvergeAfterDrinking" name="" sourceRef="Task_ActualRun" targetRef="Parallel_ConvergeRunDrink"/>
    <bpmn:sequenceFlow id="SequenceFlow_19_DrinkComplete" name="" sourceRef="Task_DrinkDuringRun" targetRef="Parallel_ConvergeRunDrink"/>
    <bpmn:sequenceFlow id="SequenceFlow_23_GetFinalTime" sourceRef="Parallel_ConvergeRunDrink" targetRef="Task_FinalRunningTime"/>
    <bpmn:sequenceFlow id="SequenceFlow_End_RunFinished" name="" sourceRef="Task_FinalRunningTime" targetRef="EndEvent_RunFinished"/>

  </bpmn:process>
</bpmn:definitions>