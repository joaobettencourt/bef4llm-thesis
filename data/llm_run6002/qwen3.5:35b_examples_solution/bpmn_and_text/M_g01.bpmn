<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_3DPrintingProcess" targetNamespace="http://bpmnio.com">
  <bpmn:collaboration id="Collab_CustomModeling">
    <bpmn:participant id="Participant_User" name="User / Process Owner" processRef="Proc_ModelAndPrint"/>
  </bpmn:collaboration>

  <bpmn:process id="Proc_ModelAndPrint" isExecutable="false">
    
    <!-- Lane Set for logical grouping -->
    <bpmn:laneSet id="Lane_Set_01">
      <bpmn:lane id="Lane_DesignPhase" name="Design Phase">
        <bpmn:flowNodeRef>StartEvent_Request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendSketches</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Satisfied</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_PrintingPhase" name="Printing Phase">
        <bpmn:flowNodeRef>Task_ReceiveSTL</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_HaveColor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelSplit_PrinterPrep</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Request" name="Request Custom Model">
      <bpmn:outgoing>SequenceFlow_SendSketches</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Send Sketches to Artist (Design Phase) -->
    <bpmn:userTask id="Task_SendSketches" name="Send sketches to artist">
      <bpmn:incoming>SequenceFlow_SendSketches</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitForArtist</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Receive STL from Artist -->
    <bpmn:userTask id="Task_ReceiveSTL" name="Receive STL from artist">
      <bpmn:incoming>SequenceFlow_WaitForArtist</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckSatisfaction</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway: Satisfied with Result? -->
    <bpmn:exclusiveGateway id="Gateway_Satisfied" name="Satisfied&#10;with result?">
      <bpmn:incoming>SequenceFlow_CheckSatisfaction</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RequestRevision</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ProceedToColor</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Tell Artist Changes -->
    <bpmn:userTask id="Task_TellChanges" name="Tell artist what to change">
      <bpmn:incoming>SequenceFlow_RequestRevision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendSketches</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Choose Plastic Color -->
    <bpmn:userTask id="Task_ChooseColor" name="Choose plastic color">
      <bpmn:incoming>SequenceFlow_ProceedToColor</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckStockAvailability</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway: Have Color at Home? -->
    <bpmn:exclusiveGateway id="Gateway_HaveColor" name="Have color&#10;at home?">
      <bpmn:incoming>SequenceFlow_CheckStockAvailability</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OrderPlastic</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CheckAmountLeft</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Order Plastic (if not at home) -->
    <bpmn:userTask id="Task_OrderPlastic" name="Order plastic">
      <bpmn:incoming>SequenceFlow_OrderPlastic</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConvergeStock</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Check Amount Left (if at home) -->
    <bpmn:userTask id="Task_CheckAmount" name="Check amount left">
      <bpmn:incoming>SequenceFlow_CheckAmountLeft</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Gateway_IsLowStock</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway: Is amount under 100g? -->
    <bpmn:exclusiveGateway id="Gateway_IsLowStock" name="Under&#10;100 grams?">
      <bpmn:incoming>SequenceFlow_Gateway_IsLowStock</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AddToShoppingList</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_EnoughStock</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Add to Shopping List -->
    <bpmn:userTask id="Task_AddToShoppingList" name="Add to shopping list">
      <bpmn:incoming>SequenceFlow_AddToShoppingList</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConvergeStock2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway Convergence for Stock/Ordering Phase -->
    <bpmn:exclusiveGateway id="Gateway_ReadyToPrint" name="">
      <bpmn:incoming>SequenceFlow_ConvergeStock</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ConvergeStock2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SplitPrinterPrep</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Parallel Split for Printer Prep and GCode Generation -->
    <bpmn:parallelGateway id="ParallelSplit_PrinterPrep" name="">
      <bpmn:incoming>SequenceFlow_SplitPrinterPrep</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_HeatExtruder</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_GenerateGCodeTask</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Heat Printer (Bed & Extruder) -->
    <bpmn:userTask id="Task_HeatPrinter" name="Turn on printer&#10;and heat up">
      <bpmn:incoming>SequenceFlow_HeatExtruder</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConvergePrintReady2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Generate GCode from STL -->
    <bpmn:serviceTask id="Task_GenerateGCode" name="Generate gcode file">
      <bpmn:incoming>SequenceFlow_GenerateGCodeTask</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConvergePrintReady3</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Parallel Join for Printing Phase -->
    <bpmn:parallelGateway id="ParallelJoin_PrintReady" name="">
      <bpmn:incoming>SequenceFlow_ConvergePrintReady2</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ConvergePrintReady3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StartPrinting</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Print Model -->
    <bpmn:userTask id="Task_PrintModel" name="Print the model">
      <bpmn:incoming>SequenceFlow_StartPrinting</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndProcess</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Done" name="Model Printed">
      <bpmn:incoming>SequenceFlow_EndProcess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows (Corrected IDs) -->
    
    <!-- Design Phase Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_SendSketches" sourceRef="StartEvent_Request" targetRef="Task_SendSketches"/>
    <bpmn:sequenceFlow id="SequenceFlow_WaitForArtist" name="" sourceRef="Task_SendSketches" targetRef="Task_ReceiveSTL"/> 
    
    <!-- Satisfaction Loop Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckSatisfaction" sourceRef="Task_ReceiveSTL" targetRef="Gateway_Satisfied"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_RequestRevision" name="No" sourceRef="Gateway_Satisfied" targetRef="Task_TellChanges"/> 
    
    <!-- Proceed Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_ProceedToColor" name="Yes" sourceRef="Gateway_Satisfied" targetRef="Task_ChooseColor"/>

    <!-- Color & Stock Logic Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckStockAvailability" sourceRef="Task_ChooseColor" targetRef="Gateway_HaveColor"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_OrderPlastic" name="No (Order)" sourceRef="Gateway_HaveColor" targetRef="Task_OrderPlastic"/>
    <bpmn:sequenceFlow id="SequenceFlow_CheckAmountLeft" name="Yes (Check Stock)" sourceRef="Gateway_HaveColor" targetRef="Task_CheckAmount"/>

    <!-- Low Stock Logic Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_Gateway_IsLowStock" sourceRef="Task_CheckAmount" targetRef="Gateway_IsLowStock"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_AddToShoppingList" name="Yes (&lt;100g)" sourceRef="Gateway_IsLowStock" targetRef="Task_AddToShoppingList"/> 
    
    <!-- Convergence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_ConvergeStock" sourceRef="Task_OrderPlastic" targetRef="Gateway_ReadyToPrint"/> 
    <bpmn:sequenceFlow id="SequenceFlow_ConvergeStock2" name="" sourceRef="Task_AddToShoppingList" targetRef="Gateway_ReadyToPrint"/> 
    
    <!-- Enough Stock Path -->
    <bpmn:sequenceFlow id="SequenceFlow_EnoughStock" name="" sourceRef="Gateway_IsLowStock" targetRef="ParallelSplit_PrinterPrep"/>

    <!-- Parallel Split Logic Correction (Converging from Stock Check) -->
    
    <bpmn:sequenceFlow id="SequenceFlow_SplitPrinterPrep2" sourceRef="Gateway_ReadyToPrint" targetRef="ParallelSplit_PrinterPrep"/>

    <!-- Parallel Tasks Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_HeatExtruder" name="" sourceRef="ParallelSplit_PrinterPrep" targetRef="Task_HeatPrinter"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_GenerateGCodeTask" name="" sourceRef="ParallelSplit_PrinterPrep" targetRef="Task_GenerateGCode"/>

    <!-- Convergence for Printing -->
    <bpmn:sequenceFlow id="SequenceFlow_ConvergePrintReady2" sourceRef="Task_HeatPrinter" targetRef="ParallelJoin_PrintReady"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ConvergePrintReady3" name="" sourceRef="Task_GenerateGCode" targetRef="ParallelJoin_PrintReady"/>

    <!-- Final Print Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_StartPrinting" sourceRef="ParallelJoin_PrintReady" targetRef="Task_PrintModel"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_EndProcess" name="" sourceRef="Task_PrintModel" targetRef="EndEvent_Done"/>

  </bpmn:process>
</bpmn:definitions>