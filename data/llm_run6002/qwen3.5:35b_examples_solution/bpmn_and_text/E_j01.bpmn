<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_FindAJob_Corrected" targetNamespace="http://bpmnio.com">
  <bpmn:collaboration id="Collab_FindAJob">
    <bpmn:participant id="Participant_JobSeeker" name="Job Seeker Process" processRef="Proc_FindAJob"/>
  </bpmn:collaboration>

  <bpmn:process id="Proc_FindAJob" isExecutable="false">
    
    <!-- Lane Organization -->
    <bpmn:laneSet id="Lane_Set_01">
      <bpmn:lane id="Lane_JobSeeker" name="Job Seeker">
        <bpmn:flowNodeRef>StartEvent_Unemployed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WriteApplication</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendApplication</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AppSuccessful</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NegotiateInterview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_InterviewSuccess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_StartProbation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_ProbationFinished</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RateCompany</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_JobPermanent</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Company" name="Employing Company">
        <bpmn:flowNodeRef>Service_ConfirmApp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_FeedbackReceived</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Unemployed" name="Unemployed">
      <bpmn:outgoing>SequenceFlow_StartToReport</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Write Job Application -->
    <bpmn:task id="Task_WriteApplication" name="Write job application">
      <bpmn:incoming>SequenceFlow_ReportLoopBack</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendApp</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Send Job Application -->
    <bpmn:task id="Task_SendApplication" name="Send job application">
      <bpmn:incoming>SequenceFlow_SendApp</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReportToSystem</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Report Job Application -->
    <bpmn:task id="Task_ReportApplication" name="Report job application">
      <bpmn:incoming>SequenceFlow_ReportToSystem</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ParallelStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway (Diverging) -->
    <bpmn:parallelGateway id="Parallel_StartProcess" name="">
      <bpmn:incoming>SequenceFlow_ParallelStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReceiveOffer</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ConfirmAppRequest</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Service Task: Receive Potential Job Offer -->
    <bpmn:serviceTask id="Service_ReceiveOffer" name="Receive potential job offer">
      <bpmn:incoming>SequenceFlow_ReceiveOffer</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AppDecisionPoint</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Service Task: Confirm Application Entry -->
    <bpmn:serviceTask id="Service_ConfirmApp" name="Confirm application entry">
      <bpmn:incoming>SequenceFlow_ConfirmAppRequest</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FeedbackSent</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Intermediate Throw Event -->
    <bpmn:intermediateThrowEvent id="Event_FeedbackReceived" name="Feedback on application received">
      <bpmn:incoming>SequenceFlow_FeedbackSent</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AppDecisionPoint</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <!-- Exclusive Gateway (Diverging) -->
    <bpmn:xorGateway id="Gateway_AppSuccessful" name="Job application successful?">
      <bpmn:incoming>SequenceFlow_AppDecisionPoint</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InterviewYes</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoInterview</bpmn:outgoing>
    </bpmn:xorGateway>

    <!-- Task: Negotiate Job Interview -->
    <bpmn:task id="Task_NegotiateInterview" name="Negotiate job interview">
      <bpmn:incoming>SequenceFlow_InterviewYes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InterviewRequestSent</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway (Diverging) -->
    <bpmn:xorGateway id="Gateway_InterviewSuccess" name="Job interview successful?">
      <bpmn:incoming>SequenceFlow_InterviewRequestSent</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProbationYes</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoProbation</bpmn:outgoing>
    </bpmn:xorGateway>

    <!-- Task: Start Job (Probation Phase) -->
    <bpmn:task id="Task_StartProbation" name="Start job (probation phase)">
      <bpmn:incoming>SequenceFlow_ProbationYes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProbationStarted</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Catch Event (Timer) -->
    <bpmn:intermediateCatchEvent id="Event_ProbationFinished" name="Probation phase finished">
      <bpmn:incoming>SequenceFlow_ProbationStarted</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RatingPhase</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task: Rate Company -->
    <bpmn:task id="Task_RateCompany" name="Rate company">
      <bpmn:incoming>SequenceFlow_RatingPhase</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_JobPermanentCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway (Diverging) -->
    <bpmn:xorGateway id="Gateway_JobPermanent" name="Job permanent?">
      <bpmn:incoming>SequenceFlow_JobPermanentCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PerfectRating</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RatingBelowC</bpmn:outgoing>
    </bpmn:xorGateway>

    <!-- Service Task: Receive Feedback on Interview -->
    <bpmn:serviceTask id="Service_FeedbackInterview" name="Receive feedback on interview">
      <bpmn:incoming>SequenceFlow_PerfectRating</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReportFeedback</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Task: Report Feedback -->
    <bpmn:task id="Task_ReportFeedback" name="Report feedback">
      <bpmn:incoming>SequenceFlow_ReportFeedback</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConvergeEnd1</bpmn:outgoing>
    </bpmn:task>

    <!-- Service Task: Receive Potential Job Offers (Loop) -->
    <bpmn:serviceTask id="Service_ReceiveOffers" name="Receive potential job offers">
      <bpmn:incoming>SequenceFlow_RatingBelowC</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConvergeEnd2</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Exclusive Gateway (Converging) -->
    <bpmn:xorGateway id="Gateway_RatingAboveC" name="Company rating above C?">
      <bpmn:incoming>SequenceFlow_ConvergeEnd1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndProcessYes</bpmn:outgoing>
    </bpmn:xorGateway>

    <!-- Exclusive Gateway (Converging) -->
    <bpmn:xorGateway id="Gateway_ConvergeEnd" name="">
      <bpmn:incoming>SequenceFlow_NoInterview</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_NoProbation</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReportLoopBack</bpmn:outgoing>
    </bpmn:xorGateway>

    <!-- Exclusive Gateway (Converging) -->
    <bpmn:xorGateway id="Gateway_ConvergeEnd2" name="">
      <bpmn:incoming>SequenceFlow_EndProcessYes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AppFinished</bpmn:outgoing>
    </bpmn:xorGateway>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_ApplicationFinished" name="Application process finished">
      <bpmn:incoming>SequenceFlow_AppFinished</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToReport" sourceRef="StartEvent_Unemployed" targetRef="Gateway_ConvergeEnd"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ReportLoopBack" name="" sourceRef="Gateway_ConvergeEnd" targetRef="Task_WriteApplication"/>

    <bpmn:sequenceFlow id="SequenceFlow_SendApp" sourceRef="Task_WriteApplication" targetRef="Task_SendApplication"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ReportToSystem" name="" sourceRef="Task_SendApplication" targetRef="Task_ReportApplication"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ParallelStart" name="" sourceRef="Task_ReportApplication" targetRef="Parallel_StartProcess"/>

    <bpmn:sequenceFlow id="SequenceFlow_ReceiveOffer" name="" sourceRef="Parallel_StartProcess" targetRef="Service_ReceiveOffer"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ConfirmAppRequest" name="" sourceRef="Parallel_StartProcess" targetRef="Service_ConfirmApp"/>

    <bpmn:sequenceFlow id="SequenceFlow_FeedbackSent" name="" sourceRef="Service_ConfirmApp" targetRef="Event_FeedbackReceived"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_AppDecisionPoint" name="" sourceRef="Event_FeedbackReceived" targetRef="Gateway_AppSuccessful"/>

    <bpmn:sequenceFlow id="SequenceFlow_InterviewYes" name="yes" sourceRef="Gateway_AppSuccessful" targetRef="Task_NegotiateInterview"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_NoInterview" name="no" sourceRef="Gateway_AppSuccessful" targetRef="Gateway_ConvergeEnd"/>

    <bpmn:sequenceFlow id="SequenceFlow_InterviewRequestSent" name="" sourceRef="Task_NegotiateInterview" targetRef="Gateway_InterviewSuccess"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ProbationYes" name="yes" sourceRef="Gateway_InterviewSuccess" targetRef="Task_StartProbation"/>

    <bpmn:sequenceFlow id="SequenceFlow_NoProbation" name="no" sourceRef="Gateway_InterviewSuccess" targetRef="Gateway_ConvergeEnd"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ProbationStarted" name="" sourceRef="Task_StartProbation" targetRef="Event_ProbationFinished"/>

    <bpmn:sequenceFlow id="SequenceFlow_RatingPhase" name="" sourceRef="Event_ProbationFinished" targetRef="Task_RateCompany"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_JobPermanentCheck" name="" sourceRef="Task_RateCompany" targetRef="Gateway_JobPermanent"/>

    <bpmn:sequenceFlow id="SequenceFlow_PerfectRating" name="yes, rating above C" sourceRef="Gateway_JobPermanent" targetRef="Service_FeedbackInterview"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_RatingBelowC" name="no, rating C or less" sourceRef="Gateway_JobPermanent" targetRef="Service_ReceiveOffers"/>

    <bpmn:sequenceFlow id="SequenceFlow_ReportFeedback" name="" sourceRef="Service_FeedbackInterview" targetRef="Task_ReportFeedback"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ConvergeEnd1" name="" sourceRef="Task_ReportFeedback" targetRef="Gateway_RatingAboveC"/>

    <bpmn:sequenceFlow id="SequenceFlow_EndProcessYes" name="" sourceRef="Gateway_RatingAboveC" targetRef="Gateway_ConvergeEnd2"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_AppFinished" name="" sourceRef="Gateway_ConvergeEnd2" targetRef="EndEvent_ApplicationFinished"/>

  </bpmn:process>
</bpmn:definitions>