<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_LegoMachineProcess" targetNamespace="http://bpmnio.com">
  <bpmn:process id="Proc_BuildCustomMachine" isExecutable="false">

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_01" name="Project Initiated">
      <bpmn:outgoing>SequenceFlow_02</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Develop Basic Design -->
    <bpmn:task id="Task_DesignBasic" name="Develop basic design">
      <bpmn:incoming>SequenceFlow_02</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_03</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_02" sourceRef="StartEvent_01" targetRef="Task_DesignBasic"/>

    <!-- Task: Order Lego Brick Sets -->
    <bpmn:task id="Task_OrderSets" name="Order lego brick sets">
      <bpmn:incoming>SequenceFlow_03</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_04</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_03" sourceRef="Task_DesignBasic" targetRef="Task_OrderSets"/>

    <!-- Task: Sort Parts into Containers (Children) -->
    <bpmn:task id="Task_SortParts" name="Sort parts into containers">
      <bpmn:incoming>SequenceFlow_04</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_05</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_04" sourceRef="Task_OrderSets" targetRef="Task_SortParts"/>

    <!-- Gateway: Stock Sufficient? (Exclusive) -->
    <bpmn:xorGateway id="Gateway_StockCheck" name="Is stock sufficient?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow_05</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NoStock</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_HasStock</bpmn:outgoing>
    </bpmn:xorGateway>

    <!-- Sequence Flow (No Stock) -->
    <bpmn:sequenceFlow id="SequenceFlow_NoStock" name="No" sourceRef="Gateway_StockCheck" targetRef="Task_ReorderParts"/>

    <!-- Task: Reorder Individual Parts -->
    <bpmn:task id="Task_ReorderParts" name="Reorder individual parts">
      <bpmn:incoming>SequenceFlow_NoStock</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_06</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow (Back to Check) -->
    <bpmn:sequenceFlow id="SequenceFlow_06" sourceRef="Task_ReorderParts" targetRef="Gateway_StockCheck"/>

    <!-- Task: Build Subcomponent -->
    <bpmn:task id="Task_BuildSubcomponent" name="Build subcomponent">
      <bpmn:incoming>SequenceFlow_HasStock</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_07</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow (Has Stock) -->
    <bpmn:sequenceFlow id="SequenceFlow_HasStock" name="Yes" sourceRef="Gateway_StockCheck" targetRef="Task_BuildSubcomponent"/>

    <!-- Task: Test Subcomponent -->
    <bpmn:task id="Task_TestSubcomponent" name="Test subcomponent">
      <bpmn:incoming>SequenceFlow_07</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_08</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_07" sourceRef="Task_BuildSubcomponent" targetRef="Task_TestSubcomponent"/>

    <!-- Gateway: Does it pass the test? (Exclusive) -->
    <bpmn:xorGateway id="Gateway_TestResult" name="Does it passed the test?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow_08</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FailedTest</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PassedTest</bpmn:outgoing>
    </bpmn:xorGateway>

    <!-- Sequence Flow (Failed Test) -->
    <bpmn:sequenceFlow id="SequenceFlow_FailedTest" name="No" sourceRef="Gateway_TestResult" targetRef="Task_RedesignSubcomponent"/>

    <!-- Task: Redesign Subcomponent -->
    <bpmn:task id="Task_RedesignSubcomponent" name="Redesign subcomponent">
      <bpmn:incoming>SequenceFlow_FailedTest</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_09</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow (Back to Build) -->
    <bpmn:sequenceFlow id="SequenceFlow_09" sourceRef="Task_RedesignSubcomponent" targetRef="Gateway_ConvergeBuild"/>

    <!-- Gateway: Converge Redesign Loop -->
    <bpmn:xorGateway id="Gateway_ConvergeBuild" name="" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow_09</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_HasStock</bpmn:outgoing>
    </bpmn:xorGateway>

    <!-- Sequence Flow (Passed Test) -->
    <bpmn:sequenceFlow id="SequenceFlow_PassedTest" name="Yes" sourceRef="Gateway_TestResult" targetRef="Task_AssembleMachine"/>

    <!-- Task: Assemble Machine -->
    <bpmn:task id="Task_AssembleMachine" name="Assemble machine">
      <bpmn:incoming>SequenceFlow_10</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndProcess</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="Gateway_ConvergeBuild" targetRef="Task_AssembleMachine"/>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_01" name="Project Completed">
      <bpmn:incoming>SequenceFlow_EndProcess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flow to End -->
    <bpmn:sequenceFlow id="SequenceFlow_EndProcess" sourceRef="Task_AssembleMachine" targetRef="EndEvent_01"/>

  </bpmn:process>
</bpmn:definitions>