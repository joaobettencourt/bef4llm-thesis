<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_RewardTraining_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_RewardTraining">
    <bpmn:participant id="Pool_Process" name="Reward and Training Process" processRef="Process_RewardTraining" />
  </bpmn:collaboration>

  <bpmn:process id="Process_RewardTraining" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Management" name="Management">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckPerformance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PerformanceCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SuggestDismissal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SuggestTraining</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SuggestReward</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RewardType</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ChooseBenefit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ConvergeReward</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AnnounceEmployeeMonth</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_HR" name="HR">
        <bpmn:flowNodeRef>Task_DismissEmployee</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProvideTraining</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Finance" name="Finance">
        <bpmn:flowNodeRef>Task_CalculateReward</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PayReward</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Check employee performance">
      <bpmn:outgoing>Flow_Start_Check</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Check Performance (Management) -->
    <bpmn:task id="Task_CheckPerformance" name="Check employee performance">
      <bpmn:incoming>Flow_Start_Check</bpmn:incoming>
      <bpmn:outgoing>Flow_Performance_Gateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Performance Check -->
    <bpmn:exclusiveGateway id="Gateway_PerformanceCheck" name="Performance Level">
      <bpmn:incoming>Flow_Performance_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_DismissalPath</bpmn:outgoing>
      <bpmn:outgoing>Flow_TrainingPath</bpmn:outgoing>
      <bpmn:outgoing>Flow_RewardPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Dismissal Path -->
    <bpmn:task id="Task_SuggestDismissal" name="Suggest employee dismissal">
      <bpmn:incoming>Flow_DismissalPath</bpmn:incoming>
      <bpmn:outgoing>Flow_HR_Dismiss</bpmn:outgoing>
    </bpmn:task>

    <!-- HR Dismiss Task -->
    <bpmn:task id="Task_DismissEmployee" name="Dismiss employee">
      <bpmn:incoming>Flow_HR_Dismiss</bpmn:incoming>
      <bpmn:outgoing>Flow_End_Dismissed</bpmn:outgoing>
    </bpmn:task>

    <!-- Training Path -->
    <bpmn:task id="Task_SuggestTraining" name="Suggest training">
      <bpmn:incoming>Flow_TrainingPath</bpmn:incoming>
      <bpmn:outgoing>Flow_HR_Train</bpmn:outgoing>
    </bpmn:task>

    <!-- HR Training Task -->
    <bpmn:task id="Task_ProvideTraining" name="Provide training">
      <bpmn:incoming>Flow_HR_Train</bpmn:incoming>
      <bpmn:outgoing>Flow_End_Trained</bpmn:outgoing>
    </bpmn:task>

    <!-- Reward Path -->
    <bpmn:task id="Task_SuggestReward" name="Suggest for reward">
      <bpmn:incoming>Flow_RewardPath</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_RewardType</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2: Reward Type -->
    <bpmn:exclusiveGateway id="Gateway_RewardType" name="Reward Type">
      <bpmn:incoming>Flow_Gateway_RewardType</bpmn:incoming>
      <bpmn:outgoing>Flow_FinancialPath</bpmn:outgoing>
      <bpmn:outgoing>Flow_BenefitPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Financial Reward Path -->
    <bpmn:task id="Task_CalculateReward" name="Calculate reward">
      <bpmn:incoming>Flow_FinancialPath</bpmn:incoming>
      <bpmn:outgoing>Flow_PayReward</bpmn:outgoing>
    </bpmn:task>

    <!-- Finance Pay Reward Task -->
    <bpmn:task id="Task_PayReward" name="Pay reward">
      <bpmn:incoming>Flow_PayReward</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_Converge_Reward</bpmn:outgoing>
    </bpmn:task>

    <!-- Other Benefit Path -->
    <bpmn:task id="Task_ChooseBenefit" name="Choose appropriate benefit">
      <bpmn:incoming>Flow_BenefitPath</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_Converge_Reward</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 3: Convergence before Announcement -->
    <bpmn:exclusiveGateway id="Gateway_ConvergeReward" name="Converge Reward Paths">
      <bpmn:incoming>Flow_Gateway_Converge_Reward</bpmn:incoming>
      <bpmn:outgoing>Flow_Final_Announce</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Announcement Task -->
    <bpmn:task id="Task_AnnounceEmployeeMonth" name="Announce employee of the month">
      <bpmn:incoming>Flow_Final_Announce</bpmn:incoming>
      <bpmn:outgoing>Flow_End_Successful</bpmn:outgoing>
    </bpmn:task>

    <!-- End Events -->
    <bpmn:endEvent id="End_Dismissed" name="Employee dismissed">
      <bpmn:incoming>Flow_End_Dismissed</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="End_Trained" name="Training completed">
      <bpmn:incoming>Flow_End_Trained</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="End_Successful" name="Employee of the month announced">
      <bpmn:incoming>Flow_End_Successful</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Flow_Start_Check" sourceRef="StartEvent_1" targetRef="Task_CheckPerformance">
      <bpmn:name>Check performance</bpmn:name>
    </bpmn:sequenceFlow>
    
    <bpmn:sequenceFlow id="Flow_Performance_Gateway" sourceRef="Task_CheckPerformance" targetRef="Gateway_PerformanceCheck">
      <bpmn:name>To gateway</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Gateway 1 Outgoing -->
    <bpmn:sequenceFlow id="Flow_DismissalPath" sourceRef="Gateway_PerformanceCheck" targetRef="Task_SuggestDismissal">
      <bpmn:name>performance &lt;= 20%</bpmn:name>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${performance &lt;= 20}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_TrainingPath" sourceRef="Gateway_PerformanceCheck" targetRef="Task_SuggestTraining">
      <bpmn:name>20% ≤ performance &lt; 50%</bpmn:name>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${performance >= 20 and performance &lt; 50}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_RewardPath" sourceRef="Gateway_PerformanceCheck" targetRef="Task_SuggestReward">
      <bpmn:name>performance &gt;= 75%</bpmn:name>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${performance &gt;= 75}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Dismissal Flow -->
    <bpmn:sequenceFlow id="Flow_HR_Dismiss" sourceRef="Task_SuggestDismissal" targetRef="Task_DismissEmployee">
      <bpmn:name>Suggestion to HR</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Training Flow -->
    <bpmn:sequenceFlow id="Flow_HR_Train" sourceRef="Task_SuggestTraining" targetRef="Task_ProvideTraining">
      <bpmn:name>Suggestion to HR</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Reward Gateway Flow -->
    <bpmn:sequenceFlow id="Flow_Gateway_RewardType" sourceRef="Task_SuggestReward" targetRef="Gateway_RewardType">
      <bpmn:name>Suggestion accepted</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Reward Type Outgoing -->
    <bpmn:sequenceFlow id="Flow_FinancialPath" sourceRef="Gateway_RewardType" targetRef="Task_CalculateReward">
      <bpmn:name>Financial reward</bpmn:name>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${rewardType == 'financial'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_BenefitPath" sourceRef="Gateway_RewardType" targetRef="Task_ChooseBenefit">
      <bpmn:name>Other benefit</bpmn:name>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${rewardType == 'benefit'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Financial Reward Flow -->
    <bpmn:sequenceFlow id="Flow_PayReward" sourceRef="Task_CalculateReward" targetRef="Task_PayReward">
      <bpmn:name>Reward calculated</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Convergence Gateway Flow -->
    <bpmn:sequenceFlow id="Flow_Gateway_Converge_Reward" sourceRef="Gateway_ConvergeReward" targetRef="Task_AnnounceEmployeeMonth">
      <bpmn:name>All reward paths converge</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Final Announcement Flow -->
    <bpmn:sequenceFlow id="Flow_Final_Announce" sourceRef="Gateway_ConvergeReward" targetRef="Task_AnnounceEmployeeMonth">
      <bpmn:name>To announcement</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- End Flows -->
    <bpmn:sequenceFlow id="Flow_End_Dismissed" sourceRef="Task_DismissEmployee" targetRef="End_Dismissed">
      <bpmn:name>Dismissal complete</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_End_Trained" sourceRef="Task_ProvideTraining" targetRef="End_Trained">
      <bpmn:name>Training complete</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_End_Successful" sourceRef="Task_AnnounceEmployeeMonth" targetRef="End_Successful">
      <bpmn:name>Announcement complete</bpmn:name>
    </bpmn:sequenceFlow>
  </bpmn:process>
</bpmn:definitions>