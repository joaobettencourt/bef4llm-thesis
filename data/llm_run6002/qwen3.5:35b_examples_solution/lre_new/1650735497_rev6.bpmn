<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_BankAccountAddition" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="Pool_PayPalSystem" name="PayPal System" processRef="Proc_PayPalProcess" />
    <bpmn:participant id="Pool_ClientAccount" name="Client Bank Account" />
  </bpmn:collaboration>

  <bpmn:process id="Proc_PayPalProcess" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="Pay with bank account - Payment option selected">
      <bpmn:outgoing>Flow_Start_EnterDetails</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:laneSet>
      <bpmn:lane id="Lane_Client" name="PayPal Client">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterDetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ClickContinue</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_PayPal" name="PayPal System">
        <bpmn:flowNodeRef>IntermediateThrowEvent_SubmitReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MakeDeposits</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TimerCatch_3to5Days</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckDepositsReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LoginPayPal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterDepositAmounts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ClickVerify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CompareValues</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ValuesMatch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Confirmed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RemoveAccountDetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Unconfirmed</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Bank" name="Client Bank Account">
        <bpmn:flowNodeRef>IntermediateCatch_DepositReceived</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Client submits bank details -->
    <bpmn:task id="Task_EnterDetails" name="Enter Bank Details">
      <bpmn:incoming>Flow_Start_EnterDetails</bpmn:incoming>
      <bpmn:outgoing>Flow_Details_ClickContinue</bpmn:outgoing>
    </bpmn:task>

    <!-- Client clicks continue to submit -->
    <bpmn:task id="Task_ClickContinue" name="Click Continue">
      <bpmn:incoming>Flow_Details_ClickContinue</bpmn:incoming>
      <bpmn:outgoing>Flow_SubmitToSystem</bpmn:outgoing>
    </bpmn:task>

    <!-- Message flow to PayPal system -->
    <bpmn:message id="Msg_BankDetails" name="Bank Details Submitted">
      <bpmn:name>Submit Bank Details</bpmn:name>
    </bpmn:message>

    <!-- PayPal receives submission -->
    <bpmn:intermediateCatchEvent id="IntermediateThrowEvent_SubmitReceived" name="Bank Details Submitted">
      <bpmn:messageEventDefinition ref="Msg_BankDetails"/>
      <bpmn:incoming>Flow_SystemReceived</bpmn:incoming>
      <bpmn:outgoing>Flow_StartDeposits</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- PayPal makes deposits -->
    <bpmn:task id="Task_MakeDeposits" name="Make two random deposits in Bank Account">
      <bpmn:incoming>Flow_StartDeposits</bpmn:incoming>
      <bpmn:outgoing>Flow_DepositComplete</bpmn:outgoing>
    </bpmn:task>

    <!-- Message to bank account -->
    <bpmn:message id="Msg_DepositInfo" name="Deposit Information Sent">
      <bpmn:name>Two deposits made</bpmn:name>
    </bpmn:message>

    <!-- Timer for 3-5 working days -->
    <bpmn:intermediateCatchEvent id="TimerCatch_3to5Days" name="After 3-5 working days">
      <bpmn:timerEventDefinition />
      <bpmn:incoming>Flow_TimerWait</bpmn:incoming>
      <bpmn:outgoing>Flow_ClientNotified</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Client checks deposits -->
    <bpmn:task id="Task_CheckDepositsReceived" name="Check Deposits Received">
      <bpmn:incoming>Flow_ClientNotified</bpmn:incoming>
      <bpmn:outgoing>Flow_LoginPayPal</bpmn:outgoing>
    </bpmn:task>

    <!-- Client logs in -->
    <bpmn:task id="Task_LoginPayPal" name="Login to PayPal Account">
      <bpmn:incoming>Flow_ClientNotified</bpmn:incoming>
      <bpmn:outgoing>Flow_EnterAmounts</bpmn:outgoing>
    </bpmn:task>

    <!-- Client enters deposit amounts -->
    <bpmn:task id="Task_EnterDepositAmounts" name="Enter Amounts of Two Deposits">
      <bpmn:incoming>Flow_LoginPayPal</bpmn:incoming>
      <bpmn:outgoing>Flow_ClickVerify</bpmn:outgoing>
    </bpmn:task>

    <!-- Client clicks verify -->
    <bpmn:task id="Task_ClickVerify" name="Click Verify">
      <bpmn:incoming>Flow_EnterAmounts</bpmn:incoming>
      <bpmn:outgoing>Flow_CompareValues</bpmn:outgoing>
    </bpmn:task>

    <!-- PayPal compares values -->
    <bpmn:task id="Task_CompareValues" name="Compare Values Provided">
      <bpmn:incoming>Flow_ClickVerify</bpmn:incoming>
      <bpmn:outgoing>Flow_GatewayCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for match/no-match -->
    <bpmn:exclusiveGateway id="Gateway_ValuesMatch">
      <bpmn:incoming>Flow_GatewayCheck</bpmn:incoming>
      <bpmn:outgoing>Flow_LinkAccount</bpmn:outgoing>
      <bpmn:outgoing>Flow_RemoveDetails</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Success path -->
    <bpmn:endEvent id="EndEvent_Confirmed" name="Bank Account Confirmed">
      <bpmn:incoming>Flow_EndConfirmed</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Failure path -->
    <bpmn:task id="Task_RemoveAccountDetails" name="Remove Bank Account Details from System">
      <bpmn:incoming>Flow_RemoveDetails</bpmn:incoming>
      <bpmn:outgoing>Flow_EndUnconfirmed</bpmn:outgoing>
    </bpmn:task>

    <!-- End event - unconfirmed -->
    <bpmn:endEvent id="EndEvent_Unconfirmed" name="Bank Account Unconfirmed">
      <bpmn:incoming>Flow_EndUnconfirmed</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence flows for main process flow -->
    <bpmn:sequenceFlow id="Flow_Start_EnterDetails" sourceRef="Start_1" targetRef="Task_EnterDetails" />
    
    <bpmn:sequenceFlow id="Flow_Details_ClickContinue" sourceRef="Task_EnterDetails" targetRef="Task_ClickContinue" />
    
    <bpmn:sequenceFlow id="Flow_SubmitToSystem" name="Submit Bank Details">
      <bpmn:name>Submit to System</bpmn:name>
      <bpmn:sourceRef>Task_ClickContinue</bpmn:sourceRef>
      <bpmn:targetRef>IntermediateThrowEvent_SubmitReceived</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Message flow from client to PayPal -->
    <bpmn:messageFlow id="Message_1" name="Bank Details Submitted">
      <bpmn:name>Submit Bank Details</bpmn:name>
      <bpmn:sourceRef>Task_ClickContinue</bpmn:sourceRef>
      <bpmn:targetRef>Pool_PayPalSystem</bpmn:targetRef>
    </bpmn:messageFlow>

    <!-- PayPal receives submission -->
    <bpmn:sequenceFlow id="Flow_SystemReceived" sourceRef="IntermediateThrowEvent_SubmitReceived" targetRef="Task_MakeDeposits" />
    
    <bpmn:sequenceFlow id="Flow_StartDeposits" name="Make Deposits">
      <bpmn:name>Start deposits</bpmn:name>
      <bpmn:sourceRef>IntermediateThrowEvent_SubmitReceived</bpmn:sourceRef>
      <bpmn:targetRef>Task_MakeDeposits</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Message to bank account -->
    <bpmn:messageFlow id="Message_2" name="Deposit Information">
      <bpmn:name>Send deposit info</bpmn:name>
      <bpmn:sourceRef>Task_MakeDeposits</bpmn:sourceRef>
      <bpmn:targetRef>Pool_ClientAccount</bpmn:targetRef>
    </bpmn:messageFlow>

    <!-- Timer for 3-5 working days -->
    <bpmn:sequenceFlow id="Flow_DepositComplete" sourceRef="Task_MakeDeposits" targetRef="TimerCatch_3to5Days" />
    
    <bpmn:sequenceFlow id="Flow_TimerWait">
      <bpmn:name>After 3-5 working days</bpmn:name>
      <bpmn:sourceRef>Task_MakeDeposits</bpmn:sourceRef>
      <bpmn:targetRef>TimerCatch_3to5Days</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Client notified -->
    <bpmn:sequenceFlow id="Flow_ClientNotified" sourceRef="TimerCatch_3to5Days" targetRef="Task_CheckDepositsReceived" />
    
    <bpmn:intermediateThrowEvent id="IntermediateThrowEvent_DepositMessage" name="Deposit Information Sent">
      <bpmn:messageEventDefinition ref="Msg_DepositInfo"/>
      <bpmn:incoming>Flow_DepositComplete</bpmn:incoming>
      <bpmn:outgoing>Flow_TimerWait</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <!-- Gateway flows -->
    <bpmn:sequenceFlow id="Flow_GatewayCheck" sourceRef="Task_CompareValues" targetRef="Gateway_ValuesMatch" />
    
    <bpmn:sequenceFlow id="Flow_LinkAccount" name="Values Match">
      <bpmn:name>Values match</bpmn:name>
      <bpmn:sourceRef>Gateway_ValuesMatch</bpmn:sourceRef>
      <bpmn:targetRef>EndEvent_Confirmed</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_EndConfirmed" sourceRef="Task_CompareValues" targetRef="Gateway_ValuesMatch">
      <bpmn:name>Link Account Path</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_RemoveDetails" name="Values do not match">
      <bpmn:name>Values do not match</bpmn:name>
      <bpmn:sourceRef>Gateway_ValuesMatch</bpmn:sourceRef>
      <bpmn:targetRef>Task_RemoveAccountDetails</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_EndUnconfirmed" sourceRef="Task_RemoveAccountDetails" targetRef="EndEvent_Unconfirmed" />

  </bpmn:process>
</bpmn:definitions>