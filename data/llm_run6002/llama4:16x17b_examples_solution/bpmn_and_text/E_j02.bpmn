<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/06-02-01.xsd"
             id="definition" name="BPMN Process Model" targetNamespace="http://bpmn.io/schema/bpmn">
   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>
     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_FetchInfo"/>
     <userTask id="Task_FetchInfo" name="Fetch information about potential models  (months duration, split between parents)">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </userTask>
     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_FetchInfo" targetRef="ExclusiveGateway_SelectModel"/>
     <exclusiveGateway id="ExclusiveGateway_SelectModel">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_4</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_SelectModel" targetRef="Task_CollectInfo"/>
     <userTask id="Task_CollectInfo" name="Collect relevant information">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </userTask>
     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_CollectInfo" targetRef="Gateway_GatherInformation"/>
     <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_SelectModel" targetRef="Task_NotifySocialSecurity"/>
     <userTask id="Task_NotifySocialSecurity" name="Notify Social Security, Company in time">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </userTask>
     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_NotifySocialSecurity" targetRef="Gateway_GatherInformation"/>
     <parallelGateway id="Gateway_GatherInformation">
       <incoming>SequenceFlow_5</incoming>
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_7</outgoing>
     </parallelGateway>
     <sequenceFlow id="SequenceFlow_7" sourceRef="Gateway_GatherInformation" targetRef="ExclusiveGateway_DecideExtension"/>
     <exclusiveGateway id="ExclusiveGateway_DecideExtension">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_8</outgoing>
       <outgoing>SequenceFlow_9</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_8" sourceRef="ExclusiveGateway_DecideExtension" targetRef="EndEvent_1"/>
     <userTask id="Task_DecideExtension" name="At the end of the period let parent decide about extension">
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_10</outgoing>
     </userTask>
     <sequenceFlow id="SequenceFlow_9" sourceRef="ExclusiveGateway_DecideExtension" targetRef="Task_DecideExtension"/>
     <sequenceFlow id="SequenceFlow_10" sourceRef="Task_DecideExtension" targetRef="EndEvent_1"/>
     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_8</incoming>
       <incoming>SequenceFlow_10</incoming>
     </endEvent>
   </process>
 </definitions>