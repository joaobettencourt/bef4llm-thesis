<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/BPMN20.xsd"
             id="definition" name="BPMN Process Model" targetNamespace="http://example.com">
   <collaboration id="Collaboration_1">
     <participant id="Participant_1" processRef="Process_1"/>
     <participant id="Architect" name="Tree House Architect" processRef="Architect_Process"/>
     <participant id="OnlineStore" name="Online Store" processRef="OnlineStore_Process"/>
   </collaboration>
  
   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>
    
     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_CollectRequirements"/>
    
     <userTask id="Task_CollectRequirements" name="Collect Requirements">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </userTask>
    
     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_CollectRequirements" targetRef="Task_SendRequirementsToArchitect"/>
    
     <userTask id="Task_SendRequirementsToArchitect" name="Send Requirements to Architect">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>MessageFlow_1</outgoing>
     </userTask>
    
     <sequenceFlow id="SequenceFlow_3" sourceRef="Task_RefineRequirements" targetRef="Task_CreateMaterialList"/>
     
     <userTask id="Task_RefineRequirements" name="Refine Requirements">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_3</outgoing>
     </userTask>
    
     <sequenceFlow id="MessageFlow_1"> 
        <sourceRef>Task_SendRequirementsToArchitect</sourceRef>
        <targetRef>Architect_StartEvent</targetRef>
    </sequenceFlow>

     <intermediateCatchEvent id="IntermediateCatchEvent_DraftReceived">
       <incoming>MessageFlow_2</incoming>
       <outgoing>SequenceFlow_4</outgoing>
     </intermediateCatchEvent>
     
     
    
     <sequenceFlow id="SequenceFlow_4" sourceRef="IntermediateCatchEvent_DraftReceived" targetRef="Task_RefineRequirements"/>
    
    <sequenceFlow id="MessageFlow_2">
        <sourceRef>Architect_StartEvent</sourceRef>
        <targetRef>IntermediateCatchEvent_DraftReceived</targetRef>
    </sequenceFlow>

     <userTask id="Task_CreateMaterialList" name="Create Material List">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </userTask>
    
     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_CreateMaterialList" targetRef="Task_OrderMaterials"/>
    
     <userTask id="Task_OrderMaterials" name="Order Materials">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>MessageFlow_3</outgoing>
     </userTask>

     
    
    <sequenceFlow id="MessageFlow_3"> 
        <sourceRef>Task_OrderMaterials</sourceRef>
        <targetRef>OnlineStore_StartEvent</targetRef>
    </sequenceFlow>
    
     <intermediateCatchEvent id="IntermediateCatchEvent_MaterialsReceived">
       <incoming>MessageFlow_4</incoming>
       <outgoing>SequenceFlow_7</outgoing>
     </intermediateCatchEvent>

     
    
    <sequenceFlow id="MessageFlow_4">
        <sourceRef>OnlineStore_StartEvent</sourceRef>
        <targetRef>IntermediateCatchEvent_MaterialsReceived</targetRef>
    </sequenceFlow>
    
     <sequenceFlow id="SequenceFlow_7" sourceRef="IntermediateCatchEvent_MaterialsReceived" targetRef="Task_SendMessagesToFriends"/>
    
     <userTask id="Task_SendMessagesToFriends" name="Send Messages to Friends">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_8</outgoing>
     </userTask>

     
    
     <sequenceFlow id="SequenceFlow_8" sourceRef="Task_SendMessagesToFriends" targetRef="EndEvent_1"/>
    
     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_8</incoming>
     </endEvent>
   </process>
  
   <process id="Architect_Process" isExecutable="false">
     <startEvent id="Architect_StartEvent">
       <incoming>MessageFlow_1</incoming>
       <outgoing>MessageFlow_2</outgoing>
     </startEvent>

   </process>
  
   <process id="OnlineStore_Process" isExecutable="false">
     <startEvent id="OnlineStore_StartEvent">
       <incoming>MessageFlow_3</incoming>
       <outgoing>MessageFlow_4</outgoing>
     </startEvent>

   </process>
  
</definitions>