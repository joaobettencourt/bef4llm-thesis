<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/BPMN20.xsd"
             id="definition" name="BPMN Process Model">
  <process id="Process_1" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>
    <userTask id="Task_1" name="send sketches  to artist">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </userTask>
    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="ExclusiveGateway_1"/>
    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
      <outgoing>SequenceFlow_4</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_1" targetRef="Task_2">
      <conditionExpression xsi:type="tFormalExpression">${true}</conditionExpression>
    </sequenceFlow>
    <userTask id="Task_2" name="artist creates model">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_5</outgoing>
    </userTask>
    <sequenceFlow id="SequenceFlow_5" sourceRef="Task_2" targetRef="UserTask_ReceiveModel"/>
    <userTask id="UserTask_ReceiveModel" name="recieve 3D model from artist">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </userTask>
    <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_1" targetRef="UserTask_ReceiveModel"/>
    <sequenceFlow id="SequenceFlow_6" sourceRef="UserTask_ReceiveModel" targetRef="ManualTask_ChooseColor"/>
    <manualTask id="ManualTask_ChooseColor" name="choose a plastic color for model">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </manualTask>
    <sequenceFlow id="SequenceFlow_7" sourceRef="ManualTask_ChooseColor" targetRef="ExclusiveGateway_HasColor"/>
    <exclusiveGateway id="ExclusiveGateway_HasColor">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_8</outgoing>
      <outgoing>SequenceFlow_9</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_8" sourceRef="ExclusiveGateway_HasColor" targetRef="Task_CheckAmount">
    </sequenceFlow>
    <userTask id="Task_CheckAmount" name="check amount of color">
      <incoming>SequenceFlow_8</incoming>
      <outgoing>SequenceFlow_10</outgoing>
    </userTask>
    <sequenceFlow id="SequenceFlow_10" sourceRef="Task_CheckAmount" targetRef="ExclusiveGateway_IsEnough"/>
    <exclusiveGateway id="ExclusiveGateway_IsEnough">
      <incoming>SequenceFlow_10</incoming>
      <outgoing>SequenceFlow_12</outgoing>
      <outgoing>SequenceFlow_13</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_9" sourceRef="ExclusiveGateway_HasColor" targetRef="UserTask_OrderColor"/>
    <userTask id="UserTask_OrderColor" name="order it">
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_11</outgoing>
    </userTask>
    <sequenceFlow id="SequenceFlow_11" sourceRef="UserTask_OrderColor" targetRef="ExclusiveGateway_IsEnough"/>
    <sequenceFlow id="SequenceFlow_12" sourceRef="ExclusiveGateway_IsEnough" targetRef="ParallelGateway_PreparePrinter">
    </sequenceFlow>
    <sequenceFlow id="SequenceFlow_13" sourceRef="ExclusiveGateway_IsEnough" targetRef="ManualTask_PutOnShoppingList"/>
    <manualTask id="ManualTask_PutOnShoppingList" name="put it on your shopping list">
      <incoming>SequenceFlow_13</incoming>
      <outgoing>SequenceFlow_14</outgoing>
    </manualTask>
    <sequenceFlow id="SequenceFlow_14" sourceRef="ManualTask_PutOnShoppingList" targetRef="ExclusiveGateway_PreparePrinter"/>
    <parallelGateway id="ParallelGateway_PreparePrinter">
      <incoming>SequenceFlow_12</incoming>
      <outgoing>SequenceFlow_15</outgoing>
      <outgoing>SequenceFlow_16</outgoing>
    </parallelGateway>
    <sequenceFlow id="SequenceFlow_15" sourceRef="ParallelGateway_PreparePrinter" targetRef="ServiceTask_GenerateGcode"/>
    <serviceTask id="ServiceTask_GenerateGcode" name="program generates  gcode file from STL">
      <incoming>SequenceFlow_15</incoming>
      <outgoing>SequenceFlow_17</outgoing>
    </serviceTask>
    <sequenceFlow id="SequenceFlow_16" sourceRef="ParallelGateway_PreparePrinter" targetRef="ManualTask_TurnOnPrinter"/>
    <manualTask id="ManualTask_TurnOnPrinter" name="turn on the printer">
      <incoming>SequenceFlow_16</incoming>
      <outgoing>SequenceFlow_18</outgoing>
    </manualTask>
    <sequenceFlow id="SequenceFlow_17" sourceRef="ServiceTask_GenerateGcode" targetRef="ParallelGateway_StartPrinting"/>
    <parallelGateway id="ParallelGateway_StartPrinting">
      <incoming>SequenceFlow_18</incoming>
      <incoming>SequenceFlow_17</incoming>
      <outgoing>SequenceFlow_19</outgoing>
    </parallelGateway>
    <sequenceFlow id="SequenceFlow_18" sourceRef="ManualTask_TurnOnPrinter" targetRef="ParallelGateway_StartPrinting"/>
    <serviceTask id="ServiceTask_PrintModel" name="program executed printing">
      <incoming>SequenceFlow_19</incoming>
    </serviceTask>
    <endEvent id="EndEvent_1">
      <incoming>SequenceFlow_20</incoming>
    </endEvent>
  </process>
</definitions>