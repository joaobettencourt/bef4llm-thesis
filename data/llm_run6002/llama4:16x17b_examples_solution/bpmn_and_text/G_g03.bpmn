<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/06-02-01.xsd"
             id="definition" name="Blizzard Online Character Generator" targetNamespace="http://example.com/bpmn">
   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>
     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="ExclusiveGateway_1"/>
     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
       <outgoing>SequenceFlow_3</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_2" sourceRef="ExclusiveGateway_1" targetRef="Task_Account_Info">
       <conditionExpression xsi:type="tFormalExpression">${hasBattleNetAccount  == false}</conditionExpression>
     </sequenceFlow>
     <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_1" targetRef="WoW_Subscription_Check">
       <conditionExpression xsi:type="tFormalExpression">${hasBattleNetAccount  == true}</conditionExpression>
     </sequenceFlow>
     <task id="Task_Account_Info" name="Enter account information">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_4</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_4" sourceRef="Task_Account_Info" targetRef="Confirm_Account"/>
     <task id="Confirm_Account" name="Click link in confirmation mail">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_5" sourceRef="Confirm_Account" targetRef="WoW_Subscription_Check"/>
     <serviceTask id="WoW_Subscription_Check">
       <incoming>SequenceFlow_3</incoming>
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_6</outgoing>
       <outgoing>SequenceFlow_7</outgoing>
     </serviceTask>
     <exclusiveGateway id="Subscription_Gateway">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_8</outgoing>
       <outgoing>SequenceFlow_9</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_6" sourceRef="WoW_Subscription_Check" targetRef="Subscription_Gateway">
       <conditionExpression xsi:type="tFormalExpression">${hasWoWSubscription  == true}</conditionExpression>
     </sequenceFlow>
     <sequenceFlow id="SequenceFlow_7" sourceRef="WoW_Subscription_Check" targetRef="Subscription_Gateway">
       <conditionExpression xsi:type="tFormalExpression">${hasWoWSubscription  == false}</conditionExpression>
     </sequenceFlow>
     <task id="Payment_Method" name="Select payment method">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_10</outgoing>
       <outgoing>SequenceFlow_11</outgoing>
     </task>
     <exclusiveGateway id="Payment_Gateway">
       <incoming>SequenceFlow_10</incoming>
       <incoming>SequenceFlow_11</incoming>
       <outgoing>SequenceFlow_12</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_8" sourceRef="Subscription_Gateway" targetRef="Login_Task">
       <!-- No condition expression -->
     </sequenceFlow>
     <sequenceFlow id="SequenceFlow_9" sourceRef="Subscription_Gateway" targetRef="Payment_Method"/>
     <task id="Login_Task" name="Log into game">
       <incoming>SequenceFlow_12</incoming>
       <outgoing>SequenceFlow_13</outgoing>
     </task>
     <parallelGateway id="Parallel_Gateway">
       <incoming>SequenceFlow_13</incoming>
       <outgoing>SequenceFlow_14</outgoing>
       <outgoing>SequenceFlow_15</outgoing>
     </parallelGateway>
     <sequenceFlow id="SequenceFlow_12" sourceRef="Payment_Gateway" targetRef="Login_Task"/>
     <sequenceFlow id="SequenceFlow_13" sourceRef="Login_Task" targetRef="Parallel_Gateway"/>
     <sequenceFlow id="SequenceFlow_14" sourceRef="Parallel_Gateway" targetRef="Select_Realm_Class_Task"/>
     <sequenceFlow id="SequenceFlow_15" sourceRef="Parallel_Gateway" targetRef="Enter_Character_Name_Task"/>
     <task id="Select_Realm_Class_Task" name="Select realm, race and class of character">
       <incoming>SequenceFlow_14</incoming>
       <!-- outgoing not needed -->
     </task>
     <task id="Enter_Character_Name_Task" name="Enter character name">
       <incoming>SequenceFlow_15</incoming>
       <!-- outgoing not needed -->
     </task>
     <endEvent id="End_Event">
       <!-- No incoming, this might need correction based on actual flow -->
     </endEvent>
   </process>
 </definitions>