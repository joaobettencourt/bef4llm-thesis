<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/BPMN20.xsd"
             id="definition" name="BPMN Process Model" targetNamespace="http://bpmn.io/schema/bpmn">
  <process id="Service_For_Your_Fridge" isExecutable="true">
    <startEvent id="Start_Event_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="Start_Event_1" targetRef="Task_Describe_Symptoms"/>
    <userTask completionQuantity="1" id="Task_Describe_Symptoms" implementation="##WebService" isForCompensation="false" name="Describe the symptoms" startQuantity="1">
      <outgoing>SequenceFlow_2</outgoing>
    </userTask>
    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_Describe_Symptoms" targetRef="ParallelGateway_1"/>
    <parallelGateway id="ParallelGateway_1">
      <outgoing>SequenceFlow_3</outgoing>
      <outgoing>SequenceFlow_22</outgoing>
    </parallelGateway>
    <sequenceFlow id="SequenceFlow_3" sourceRef="ParallelGateway_1" targetRef="Task_Send_Report"/>
    <serviceTask completionQuantity="1" id="Task_Send_Report" implementation="##WebService" isForCompensation="false" name="Send a report to the fridge service center" startQuantity="1">
      <outgoing>SequenceFlow_4</outgoing>
    </serviceTask>
    <sequenceFlow id="SequenceFlow_4" sourceRef="Task_Send_Report" targetRef="ExclusiveGateway_1"/>
    <exclusiveGateway id="ExclusiveGateway_1">
      <outgoing>SequenceFlow_5</outgoing>
      <outgoing>SequenceFlow_6</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_5" sourceRef="ExclusiveGateway_1" targetRef="Task_Select_Service_Facility"/>
    <serviceTask completionQuantity="1" id="Task_Select_Service_Facility" implementation="##WebService" isForCompensation="false" name="Select local service facility" startQuantity="1">
      <outgoing>SequenceFlow_7</outgoing>
    </serviceTask>
    <sequenceFlow id="SequenceFlow_6" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_Service_Canceled"/>
    <endEvent id="EndEvent_Service_Canceled">
      <incoming>SequenceFlow_6</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_7" sourceRef="Task_Select_Service_Facility" targetRef="IntermediateCatchEvent_Wait_For_Service"/>
    <intermediateCatchEvent id="IntermediateCatchEvent_Wait_For_Service">
      <outgoing>SequenceFlow_8</outgoing>
      <timerEventDefinition/>
    </intermediateCatchEvent>
    <sequenceFlow id="SequenceFlow_8" sourceRef="IntermediateCatchEvent_Wait_For_Service" targetRef="Task_Repair_Fridge"/>
    <manualTask completionQuantity="1" id="Task_Repair_Fridge" isForCompensation="false" name="Repair the fridge" startQuantity="1">
      <outgoing>SequenceFlow_9</outgoing>
    </manualTask>
    <sequenceFlow id="SequenceFlow_9" sourceRef="Task_Repair_Fridge" targetRef="ExclusiveGateway_Needs_Parts"/>
    <exclusiveGateway id="ExclusiveGateway_Needs_Parts">
      <outgoing>SequenceFlow_10</outgoing>
      <outgoing>SequenceFlow_11</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_10" sourceRef="ExclusiveGateway_Needs_Parts" targetRef="EndEvent_Repair_Succeeded">
      <conditionExpression xsi:type="tFormalExpression">${parts.arrived == true}</conditionExpression>
    </sequenceFlow>
    <endEvent id="EndEvent_Repair_Succeeded">
      <incoming>SequenceFlow_10</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_11" sourceRef="ExclusiveGateway_Needs_Parts" targetRef="ServiceTask_Order_Parts"/>
    <serviceTask completionQuantity="1" id="ServiceTask_Order_Parts" implementation="##WebService" isForCompensation="false" name="Order additional parts" startQuantity="1">
      <outgoing>SequenceFlow_12</outgoing>
    </serviceTask>
    <sequenceFlow id="SequenceFlow_12" sourceRef="ServiceTask_Order_Parts" targetRef="IntermediateCatchEvent_Wait_For_Parts"/>
    <intermediateCatchEvent id="IntermediateCatchEvent_Wait_For_Parts">
      <outgoing>SequenceFlow_13</outgoing>
      <conditionalEventDefinition>
        <condition xsi:type="tFormalExpression">${parts.arrived == true}</condition>
      </conditionalEventDefinition>
    </intermediateCatchEvent>
    <sequenceFlow id="SequenceFlow_13" sourceRef="IntermediateCatchEvent_Wait_For_Parts" targetRef="Task_Confirm_Repair"/>
    <manualTask completionQuantity="1" id="Task_Confirm_Repair" isForCompensation="false" name="Confirm that fridge is okay" startQuantity="1">
      <outgoing>SequenceFlow_14</outgoing>
    </manualTask>
    <sequenceFlow id="SequenceFlow_14" sourceRef="Task_Confirm_Repair" targetRef="ExclusiveGateway_Submit_Rating"/>
    <exclusiveGateway id="ExclusiveGateway_Submit_Rating">
      <outgoing>SequenceFlow_15</outgoing>
      <outgoing>SequenceFlow_16</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_15" sourceRef="ExclusiveGateway_Submit_Rating" targetRef="EndEvent_Repair_Complete">
      <conditionExpression xsi:type="tFormalExpression">${rating.submitted == true}</conditionExpression>
    </sequenceFlow>
    <endEvent id="EndEvent_Repair_Complete">
      <incoming>SequenceFlow_15</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_16" sourceRef="ExclusiveGateway_Submit_Rating" targetRef="Task_Submit_Rating"/>
    <userTask completionQuantity="1" id="Task_Submit_Rating" implementation="##WebService" isForCompensation="false" name="Rate Service Facility" startQuantity="1">
      <outgoing>SequenceFlow_17</outgoing>
    </userTask>
    <sequenceFlow id="SequenceFlow_17" sourceRef="Task_Submit_Rating" targetRef="EndEvent_Repair_Complete"/>
    <sequenceFlow id="SequenceFlow_22" sourceRef="ParallelGateway_1" targetRef="DataObjectReference_Symptoms"/>
    <dataObject id="DataObject_Symptoms">
      <extensionElements/>
    </dataObject>
    <dataObjectReference dataObjectRef="DataObject_Symptoms" id="DataObjectReference_Symptoms">
      <extensionElements/>
    </dataObjectReference>
  </process>
</definitions>