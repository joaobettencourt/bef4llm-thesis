<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/BPMN20.xsd"
             id="definition" name="Internship Process" targetNamespace="http://example.com/internship">

   <process id="internshipProcess" isExecutable="true">
     <startEvent id="startEvent1">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="userTask1"/>

     <userTask id="userTask1" name="Enter desired topic and amount of money.">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow2" sourceRef="userTask1" targetRef="serviceTask1"/>

     <serviceTask id="serviceTask1" name="Offers arrival">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlow3" sourceRef="serviceTask1" targetRef="exclusiveGateway1"/>

     <exclusiveGateway id="exclusiveGateway1">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow4</outgoing>
       <outgoing>sequenceFlow5</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow4" sourceRef="exclusiveGateway1" targetRef="userTask2">
       <conditionExpression xsi:type="tFormalExpression">${offer.accepted}</conditionExpression>
     </sequenceFlow>

     <userTask id="userTask2" name="Accept offer.">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow6</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow5" sourceRef="exclusiveGateway1" targetRef="serviceTask2"/>

     <serviceTask id="serviceTask2" name="Invalid other offers.">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow7</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlow6" sourceRef="userTask2" targetRef="parallelGateway1"/>

     <sequenceFlow id="sequenceFlow7" sourceRef="serviceTask2" targetRef="parallelGateway1"/>

     <parallelGateway id="parallelGateway1">
       <incoming>sequenceFlow6</incoming>
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow8</outgoing>
     </parallelGateway>

     <sequenceFlow id="sequenceFlow8" sourceRef="parallelGateway1" targetRef="userTask3"/>

     <userTask id="userTask3" name="Write at least 3 status updates about your internship (every week).">
       <incoming>sequenceFlow8</incoming>
       <outgoing>sequenceFlow9</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow9" sourceRef="userTask3" targetRef="exclusiveGateway2"/>

     <exclusiveGateway id="exclusiveGateway2">
       <incoming>sequenceFlow9</incoming>
       <outgoing>sequenceFlow10</outgoing>
       <outgoing>sequenceFlow11</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow10" sourceRef="exclusiveGateway2" targetRef="parallelGateway2"/>

     <userTask id="userTask4" name="Company writes 3 status updates about you.">
       <incoming>sequenceFlow10</incoming>
       <outgoing>sequenceFlow12</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow11" sourceRef="exclusiveGateway2" targetRef="endEvent1"/>

     <parallelGateway id="parallelGateway2">
       <incoming>sequenceFlow10</incoming>
       <outgoing>sequenceFlow13</outgoing>
     </parallelGateway>

     <userTask id="userTask5" name="Enter all friends twitter accounts.">
       <incoming>sequenceFlow13</incoming>
       <outgoing>sequenceFlow14</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow12" sourceRef="userTask4" targetRef="parallelGateway2"/>

     <sequenceFlow id="sequenceFlow13" sourceRef="parallelGateway2" targetRef="userTask5"/>

     <sequenceFlow id="sequenceFlow14" sourceRef="userTask5" targetRef="sendTask1"/>

     <sendTask id="sendTask1" name="Tweets will be sent in parallel.">
       <incoming>sequenceFlow14</incoming>
       <outgoing>sequenceFlow15</outgoing>
     </sendTask>

     <sequenceFlow id="sequenceFlow15" sourceRef="sendTask1" targetRef="endEvent1"/>

     <endEvent id="endEvent1">
       <incoming>sequenceFlow11</incoming>
       <incoming>sequenceFlow15</incoming>
     </endEvent>
   </process>
 </definitions>