<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd http://www.omg.org/spec/BPMN/2.0/20100524/06-02-01.xsd"
             id="definitions" name="BPMN Process Model" targetNamespace="http://bpmn.io/schema/bpmn">
  <process id="Process_1" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_Login"/>
    <task id="Task_Login" name="Customer logs into E-Shop">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_Login" targetRef="ServiceTask_CheckCredentials"/>
    <serviceTask id="ServiceTask_CheckCredentials" name="Customer credentials being checked by system">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
    </serviceTask>
    <sequenceFlow id="SequenceFlow_3" sourceRef="ServiceTask_CheckCredentials" targetRef="ExclusiveGateway_Login"/>
    <exclusiveGateway id="ExclusiveGateway_Login">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_4</outgoing>
      <outgoing>SequenceFlow_5</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_Login" targetRef="Task_SelectProduct">
      <conditionExpression xsi:type="tFormalExpression">${loginSuccessfull}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="SequenceFlow_5" sourceRef="ExclusiveGateway_Login" targetRef="EndEvent_1"/>
    <task id="Task_SelectProduct" name="Customer selects a product">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_6" sourceRef="Task_SelectProduct" targetRef="Task_AddToCart"/>
    <task id="Task_AddToCart" name="Customer adds product to shopping cart">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_7" sourceRef="Task_AddToCart" targetRef="Task_SaveProduct"/>
    <task id="Task_SaveProduct" name="Customer saves product">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_8" sourceRef="Task_SaveProduct" targetRef="Task_CheckProducts"/>
    <task id="Task_CheckProducts" name="Customer checks if product was already selected">
      <incoming>SequenceFlow_8</incoming>
      <outgoing>SequenceFlow_9</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_9" sourceRef="Task_CheckProducts" targetRef="ExclusiveGateway_AllSelected"/>
    <exclusiveGateway id="ExclusiveGateway_AllSelected">
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_10</outgoing>
      <outgoing>SequenceFlow_11</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_10" sourceRef="ExclusiveGateway_AllSelected" targetRef="ParallelGateway_PrepareOrder">
      <conditionExpression xsi:type="tFormalExpression">${allProductsSelected}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="SequenceFlow_11" sourceRef="ExclusiveGateway_AllSelected" targetRef="Task_SelectProduct"/>
    <parallelGateway id="ParallelGateway_PrepareOrder">
      <incoming>SequenceFlow_10</incoming>
      <outgoing>SequenceFlow_12</outgoing>
      <outgoing>SequenceFlow_13</outgoing>
    </parallelGateway>
    <sequenceFlow id="SequenceFlow_12" sourceRef="ParallelGateway_PrepareOrder" targetRef="ServiceTask_Payment"/>
    <serviceTask id="ServiceTask_Payment" name="Customer enters payment data">
      <incoming>SequenceFlow_12</incoming>
      <outgoing>SequenceFlow_14</outgoing>
    </serviceTask>
    <sequenceFlow id="SequenceFlow_13" sourceRef="ParallelGateway_PrepareOrder" targetRef="Task_ShippingAddress"/>
    <task id="Task_ShippingAddress" name="Customer enters shipping address">
      <incoming>SequenceFlow_13</incoming>
      <outgoing>SequenceFlow_15</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_14" sourceRef="ServiceTask_Payment" targetRef="Task_WaitForPaymentConfirmation"/>
    <task id="Task_WaitForPaymentConfirmation" name="Wait for payment confirmation">
      <incoming>SequenceFlow_14</incoming>
      <outgoing>SequenceFlow_16</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_15" sourceRef="Task_ShippingAddress" targetRef="ParallelGateway_PrepareOrderAndPayment"/>
    <parallelGateway id="ParallelGateway_PrepareOrderAndPayment">
      <incoming>SequenceFlow_15</incoming>
      <incoming>SequenceFlow_16</incoming>
      <outgoing>SequenceFlow_17</outgoing>
    </parallelGateway>
    <sequenceFlow id="SequenceFlow_16" sourceRef="Task_WaitForPaymentConfirmation" targetRef="ParallelGateway_PrepareOrderAndPayment"/>
    <serviceTask id="ServiceTask_FinishOrder" name="System finishes order">
      <incoming>SequenceFlow_17</incoming>
      <outgoing>SequenceFlow_18</outgoing>
    </serviceTask>
    <sequenceFlow id="SequenceFlow_17" sourceRef="ParallelGateway_PrepareOrderAndPayment" targetRef="ServiceTask_FinishOrder"/>
    <endEvent id="EndEvent_1">
      <incoming>SequenceFlow_5</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_18" sourceRef="ServiceTask_FinishOrder" targetRef="EndEvent_2"/>
    <endEvent id="EndEvent_2">
      <incoming>SequenceFlow_18</incoming>
    </endEvent>
  </process>
</definitions>