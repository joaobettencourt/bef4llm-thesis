<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/06-02-01.xsd" 
             id="definition" name="BPMN Process Model">
   <process id="LANPartyProcess" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>
     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_SendInvitations"/>
     <task id="Task_SendInvitations" name="Send Invitations to 10 Friends">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_SendInvitations" targetRef="IntermediateCatchEvent_GetGamesList"/>
     <intermediateCatchEvent id="IntermediateCatchEvent_GetGamesList">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
     </intermediateCatchEvent>
     <sequenceFlow id="SequenceFlow_3" sourceRef="IntermediateCatchEvent_GetGamesList" targetRef="ExclusiveGateway_8OrMoreFriends"/>
     <exclusiveGateway id="ExclusiveGateway_8OrMoreFriends">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_4</outgoing>
       <outgoing>SequenceFlow_5</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_8OrMoreFriends" targetRef="ParallelGateway_PrepareGamesAndBeer">
       <conditionExpression xsi:type="tFormalExpression">${nrOfFriends >= 8}</conditionExpression>
     </sequenceFlow>
     <sequenceFlow id="SequenceFlow_5" sourceRef="ExclusiveGateway_8OrMoreFriends" targetRef="ServiceTask_AppointAnotherDate"/>
     <serviceTask id="ServiceTask_AppointAnotherDate">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_11</outgoing>
     </serviceTask>
     <sequenceFlow id="SequenceFlow_11" sourceRef="ServiceTask_AppointAnotherDate" targetRef="IntermediateThrowEvent_SuggestAppointment"/>
     <intermediateThrowEvent id="IntermediateThrowEvent_SuggestAppointment">
       <incoming>SequenceFlow_11</incoming>
       <outgoing>SequenceFlow_12</outgoing>
     </intermediateThrowEvent>
     <sequenceFlow id="SequenceFlow_12" sourceRef="IntermediateThrowEvent_SuggestAppointment" targetRef="ExclusiveGateway_8OrMoreFriends"/>
     <parallelGateway id="ParallelGateway_PrepareGamesAndBeer">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_6</outgoing>
       <outgoing>SequenceFlow_7</outgoing>
     </parallelGateway>
     <sequenceFlow id="SequenceFlow_6" sourceRef="ParallelGateway_PrepareGamesAndBeer" targetRef="Task_PrepareGames"/>
     <task id="Task_PrepareGames">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_8</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_7" sourceRef="ParallelGateway_PrepareGamesAndBeer" targetRef="ExclusiveGateway_HasAllGames"/>
     <exclusiveGateway id="ExclusiveGateway_HasAllGames">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_9</outgoing>
       <outgoing>SequenceFlow_10</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_8" sourceRef="Task_PrepareGames" targetRef="ExclusiveGateway_HasAllGames"/>
     <serviceTask id="ServiceTask_DownloadMissingGames">
       <incoming>SequenceFlow_10</incoming>
       <outgoing>SequenceFlow_13</outgoing>
     </serviceTask>
     <sequenceFlow id="SequenceFlow_9" sourceRef="ExclusiveGateway_HasAllGames" targetRef="ExclusiveGateway_HasEnoughBeer"/>
     <sequenceFlow id="SequenceFlow_10" sourceRef="ExclusiveGateway_HasAllGames" targetRef="ServiceTask_DownloadMissingGames"/>
     <sequenceFlow id="SequenceFlow_13" sourceRef="ServiceTask_DownloadMissingGames" targetRef="ExclusiveGateway_HasAllGames"/>
     <exclusiveGateway id="ExclusiveGateway_HasEnoughBeer">
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_14</outgoing>
       <outgoing>SequenceFlow_15</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_14" sourceRef="ExclusiveGateway_HasEnoughBeer" targetRef="Task_StartParty">
       <conditionExpression xsi:type="tFormalExpression">${hasEnoughBeer}</conditionExpression>
     </sequenceFlow>
     <manualTask id="Task_BuyMissingBeer">
       <incoming>SequenceFlow_15</incoming>
       <outgoing>SequenceFlow_16</outgoing>
     </manualTask>
     <sequenceFlow id="SequenceFlow_15" sourceRef="ExclusiveGateway_HasEnoughBeer" targetRef="Task_BuyMissingBeer"/>
     <sequenceFlow id="SequenceFlow_16" sourceRef="Task_BuyMissingBeer" targetRef="Task_StartParty"/>
     <manualTask id="Task_StartParty">
       <incoming>SequenceFlow_14</incoming>
       <incoming>SequenceFlow_16</incoming>
       <outgoing>SequenceFlow_17</outgoing>
     </manualTask>
     <sequenceFlow id="SequenceFlow_17" sourceRef="Task_StartParty" targetRef="EndEvent_1"/>
     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_17</incoming>
     </endEvent>
   </process>
 </definitions>