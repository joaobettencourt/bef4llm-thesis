<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/pecoff/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/pecoff/20100524/MODEL http://www.omg.org/pecoff/2.0/20100501/BPMN20.xsd"
             id="definition" name="BPMN Process Model">
   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>
     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_ReadOrder"/>
     <serviceTask id="Task_ReadOrder" name="Read order">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </serviceTask>
     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_ReadOrder" targetRef="ExclusiveGateway_IsInStock"/>
     <exclusiveGateway id="ExclusiveGateway_IsInStock">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_4</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_3" name="yes" sourceRef="ExclusiveGateway_IsInStock" targetRef="Task_WithDrawProduct">
       <conditionExpression xsi:type="tFormalExpression">${product.inStock == true}</conditionExpression>
     </sequenceFlow>
     <manualTask id="Task_WithDrawProduct" name="Withdraw product from warehouse">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </manualTask>
     <sequenceFlow id="SequenceFlow_4" name="no" sourceRef="ExclusiveGateway_IsInStock" targetRef="ServiceTask_Reorder">
       <conditionExpression xsi:type="tFormalExpression">${product.inStock == false}</conditionExpression>
     </sequenceFlow>
     <serviceTask id="ServiceTask_Reorder" name="Reorder from wholesaler">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </serviceTask>
     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_WithDrawProduct" targetRef="ExclusiveGateway_IsOrderReady"/>
     <sequenceFlow id="SequenceFlow_6" sourceRef="ServiceTask_Reorder" targetRef="ServiceTask_WaitForArrival">
       <conditionExpression xsi:type="tFormalExpression">${waitingDays > 10}</conditionExpression>
     </sequenceFlow>
     <serviceTask id="ServiceTask_WaitForArrival" name="Waiting for arrival (handling system)">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_7</outgoing>
     </serviceTask>
     <sequenceFlow id="SequenceFlow_7" sourceRef="ServiceTask_WaitForArrival" targetRef="ExclusiveGateway_DeliveryPenalty"/>
     <exclusiveGateway id="ExclusiveGateway_DeliveryPenalty">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_8</outgoing>
       <outgoing>SequenceFlow_9</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_8" name="yes" sourceRef="ExclusiveGateway_DeliveryPenalty" targetRef="ServiceTask_DemandPenalty">
       <conditionExpression xsi:type="tFormalExpression">${waitingDays > 10}</conditionExpression>
     </sequenceFlow>
     <serviceTask id="ServiceTask_DemandPenalty" name="Demand delivery delay penalty from wholesaler">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_10</outgoing>
     </serviceTask>
     <sequenceFlow id="SequenceFlow_9" name="no" sourceRef="ExclusiveGateway_DeliveryPenalty" targetRef="Task_RegisterInStock">
       <conditionExpression xsi:type="tFormalExpression">${waitingDays <= 10}</conditionExpression>
     </sequenceFlow>
     <manualTask id="Task_RegisterInStock" name="Register in stock management system">
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_11</outgoing>
     </manualTask>
     <sequenceFlow id="SequenceFlow_10" sourceRef="ServiceTask_DemandPenalty" targetRef="Task_RegisterInStock"/>
     <sequenceFlow id="SequenceFlow_11" sourceRef="Task_RegisterInStock" targetRef="ExclusiveGateway_IsOrderReady"/>
     <exclusiveGateway id="ExclusiveGateway_IsOrderReady">
       <incoming>SequenceFlow_5</incoming>
       <incoming>SequenceFlow_11</incoming>
       <outgoing>SequenceFlow_12</outgoing>
       <outgoing>SequenceFlow_13</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_12" name="yes" sourceRef="ExclusiveGateway_IsOrderReady" targetRef="ParallelGateway_PrepareShipment">
       <conditionExpression xsi:type="tFormalExpression">${order.ready == true}</conditionExpression>
     </sequenceFlow>
     <parallelGateway id="ParallelGateway_PrepareShipment">
       <incoming>SequenceFlow_12</incoming>
       <outgoing>SequenceFlow_14</outgoing>
       <outgoing>SequenceFlow_15</outgoing>
     </parallelGateway>
     <sequenceFlow id="SequenceFlow_13" name="no" sourceRef="ExclusiveGateway_IsOrderReady" targetRef="Task_ReadOrder">
       <conditionExpression xsi:type="tFormalExpression">${order.ready == false}</conditionExpression>
     </sequenceFlow>
     <sequenceFlow id="SequenceFlow_14" sourceRef="ParallelGateway_PrepareShipment" targetRef="Task_Packing"/>
     <manualTask id="Task_Packing" name="Packing the products">
       <incoming>SequenceFlow_14</incoming>
       <outgoing>SequenceFlow_16</outgoing>
     </manualTask>
     <sequenceFlow id="SequenceFlow_15" sourceRef="ParallelGateway_PrepareShipment" targetRef="Task_RequestCourier"/>
     <manualTask id="Task_RequestCourier" name="Request courier">
       <incoming>SequenceFlow_15</incoming>
       <outgoing>SequenceFlow_17</outgoing>
     </manualTask>
     <sequenceFlow id="SequenceFlow_16" sourceRef="Task_Packing" targetRef="ParallelGateway_ShipOrder"/>
     <sequenceFlow id="SequenceFlow_17" sourceRef="Task_RequestCourier" targetRef="ParallelGateway_ShipOrder"/>
     <parallelGateway id="ParallelGateway_ShipOrder">
       <incoming>SequenceFlow_16</incoming>
       <incoming>SequenceFlow_17</incoming>
       <outgoing>SequenceFlow_18</outgoing>
     </parallelGateway>
     <sequenceFlow id="SequenceFlow_18" sourceRef="ParallelGateway_ShipOrder" targetRef="EndEvent_OrderShipped"/>
     <endEvent id="EndEvent_OrderShipped">
       <incoming>SequenceFlow_18</incoming>
     </endEvent>
   </process>
</definitions>