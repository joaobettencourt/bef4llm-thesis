<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" 
             targetNamespace="http://www.example.com/bpmn">
  <collaboration id="Collaboration_1">
    <participant id="Participant_1" name="Kreditvergabe Frontend (Bank)" processRef="Process_1"/>
    <participant id="Participant_2" name="Schufascoring (Bank)" processRef="Process_2"/>
    <participant id="Participant_3" name="Scoringservice (Schufa)" processRef="Process_3"/>
    <messageFlow id="MessageFlow_1" sourceRef="Participant_1" targetRef="StartEvent_1"/>
    <messageFlow id="MessageFlow_2" sourceRef="Task_Assign" targetRef="Participant_1"/>
    <messageFlow id="MessageFlow_3" sourceRef="Task_Result" targetRef="Participant_1"/>
  </collaboration>
  <process id="Process_1">
  </process>
  <process id="Process_2">
    <startEvent id="StartEvent_1" name="Schufascoring angefragt">
      <outgoing>SequenceFlow_1</outgoing>
      <messageEventDefinition/>
    </startEvent>
    <task id="Task_Assign" name="Scoring-anfrage senden">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_Assign"/>
    <eventBasedGateway id="EventBasedGateway_1">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
      <outgoing>SequenceFlow_4</outgoing>
    </eventBasedGateway>
    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_Assign" targetRef="EventBasedGateway_1"/>
    <intermediateCatchEvent id="IntermediateCatchEvent_Delayed" name="Schufascore verzögert">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_5</outgoing>
      <messageEventDefinition/>
    </intermediateCatchEvent>
    <sequenceFlow id="SequenceFlow_3" sourceRef="EventBasedGateway_1" targetRef="IntermediateCatchEvent_Delayed"/>
    <task id="Task_Notify" name="Verzögerung melden">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_5" sourceRef="IntermediateCatchEvent_Delayed" targetRef="Task_Notify"/>
    <intermediateCatchEvent id="IntermediateCatchEvent_Result" name="Schufascore sofort ermittelt">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_7</outgoing>
      <messageEventDefinition/>
    </intermediateCatchEvent>
    <sequenceFlow id="SequenceFlow_4" sourceRef="EventBasedGateway_1" targetRef="IntermediateCatchEvent_Result"/>
    <task id="Task_Result" name="Schufascore zurückmelden">
      <incoming>SequenceFlow_7</incoming>
    </task>
    <sequenceFlow id="SequenceFlow_7" sourceRef="IntermediateCatchEvent_Result" targetRef="Task_Result"/>
    <endEvent id="EndEvent_1" name="Schufascore vorhanden">
      <incoming>SequenceFlow_8</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_8" sourceRef="Task_Result" targetRef="EndEvent_1"/>
  </process>
  <process id="Process_3">
    <startEvent id="StartEvent_Scoring_Request" name="Scoringanfrage gestellt">
      <outgoing>SequenceFlow_Scoring</outgoing>
      <messageEventDefinition/>
    </startEvent>
    <task id="Task_Scoring_Level1" name="Scoring durchführen (level 1)">
      <incoming>SequenceFlow_Scoring</incoming>
      <outgoing>SequenceFlow_Scoring_Result</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_Scoring" sourceRef="StartEvent_Scoring_Request" targetRef="Task_Scoring_Level1"/>
    <exclusiveGateway id="ExclusiveGateway_Scoring">
      <incoming>SequenceFlow_Scoring_Result</incoming>
      <outgoing>SequenceFlow_Delayed</outgoing>
      <outgoing>SequenceFlow_No_Delay</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_Scoring_Result" sourceRef="Task_Scoring_Level1" targetRef="ExclusiveGateway_Scoring"/>
    <task id="Task_Scoring_Notify_Delayed" name="Verzögerung melden">
      <incoming>SequenceFlow_Delayed</incoming>
      <outgoing>SequenceFlow_Scoring_Level2</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_Delayed" sourceRef="ExclusiveGateway_Scoring" targetRef="Task_Scoring_Notify_Delayed"/>
    <task id="Task_Scoring_Level2" name="Scoring durchführen (level 2)">
      <incoming>SequenceFlow_Scoring_Level2</incoming>
      <outgoing>SequenceFlow_Scoring_Result_Final</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_Scoring_Level2" sourceRef="Task_Scoring_Notify_Delayed" targetRef="Task_Scoring_Level2"/>
    <task id="Task_Scoring_Send" name="Schufascore senden">
      <incoming>SequenceFlow_Scoring_Result_Final</incoming>
    </task>
    <sequenceFlow id="SequenceFlow_Scoring_Result_Final" sourceRef="Task_Scoring_Level2" targetRef="Task_Scoring_Send"/>
    <endEvent id="EndEvent_Scoring_Request_Processed" name="Scoringanfrage bearbeitet">
      <incoming>SequenceFlow_Scoring_Send</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_Scoring_Send" sourceRef="Task_Scoring_Send" targetRef="EndEvent_Scoring_Request_Processed"/>
  </process>
</definitions>