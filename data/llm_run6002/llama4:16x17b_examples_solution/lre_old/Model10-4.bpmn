<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Equipment Change Process" targetNamespace="http://example.com/bpmn">
  <collaboration id="Collaboration_1">
    <participant id="Participant_0" name="MPON" processRef="Pool_0"/>
    <participant id="Participant_1" name="MPOO" processRef="Pool_1"/>
    <participant id="Participant_2" name="GO" processRef="Pool_2"/>
    <participant id="Participant_3" name="MSP" processRef="Pool_3"/>
  </collaboration>

  <process id="Pool_0" isExecutable="true">
    <startEvent id="StartEvent_1" name="Notify Equipment Change Intentions">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <task id="Task_0" name="Notify about equipment change intentions">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </task>

    <!-- Tasks and Gateways for MPON  -->
    <exclusiveGateway id="ExclusiveGateway_1" name="Self- Dismounting?">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
      <outgoing>SequenceFlow_4</outgoing>
    </exclusiveGateway>

    <task id="Task_1" name="Announce self-dismounting">
      <incoming>SequenceFlow_3</incoming>
    </task>

    <task id="Task_2" name="Notify about no self- dismounting">
      <incoming>SequenceFlow_4</incoming>
    </task>

    <!-- Common path  -->
    <parallelGateway id="ParallelGateway_1">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_6</outgoing>
      <outgoing>SequenceFlow_7</outgoing>
    </parallelGateway>

    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_0"/>
    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_0" targetRef="ExclusiveGateway_1"/>
    <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_1" targetRef="Task_1"/>
    <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_1" targetRef="Task_2"/>
  </process>

  <process id="Pool_1" isExecutable="true">
    <!-- Tasks and Gateways for MPOO  -->
    <startEvent id="StartEvent_2" name="MPOO Start">
      <outgoing>SequenceFlow_8</outgoing>
    </startEvent>

    <task id="Task_3" name="Perform final reading">
      <incoming>SequenceFlow_8</incoming>
    </task>

    <!-- More tasks for MPOO  -->
  </process>

  <process id="Pool_2" isExecutable="true">
    <!-- Tasks and Gateways for GO  -->
    <startEvent id="StartEvent_3" name="GO Start">
      <outgoing>SequenceFlow_10</outgoing>
    </startEvent>

    <task id="Task_5" name="Notify MSP about device changes">
      <incoming>SequenceFlow_10</incoming>
    </task>
  </process>

  <process id="Pool_3" isExecutable="true">
    <!-- Tasks and Gateways for MSP  -->
  </process>

</definitions>