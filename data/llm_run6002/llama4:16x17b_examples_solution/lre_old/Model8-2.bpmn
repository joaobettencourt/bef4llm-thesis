<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Job Description Process">

  <process id="jobDescriptionProcess" isExecutable="true">
    <startEvent id="vacancyReported" name="Vacancy Reported">
      <outgoing>createJobDescription</outgoing>
    </startEvent>

    <task id="createTask" name="Create Job Description">
      <incoming>createJobDescriptionFlow</incoming>
      <outgoing>clarifyDetails</outgoing>
    </task>

    <sequenceFlow id="createJobDescriptionFlow" sourceRef="vacancyReported" targetRef="createTask"/>

    <exclusiveGateway id="clarifyDetailsGateway" name="Everything All Right?">
      <incoming>clarifyDetails</incoming>
      <outgoing>askForDetails</outgoing>
      <outgoing>proceedWithSubmission</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="clarifyDetails" sourceRef="createTask" targetRef="clarifyDetailsGateway"/>

    <sequenceFlow id="askForDetails" sourceRef="clarifyDetailsGateway" targetRef="askForMoreInformation"/>
    <sequenceFlow id="proceedWithSubmission" sourceRef="clarifyDetailsGateway" targetRef="submitForApproval"/>

    <task id="askForMoreInformationTask" name="Ask for More Information">
      <incoming>askForDetails</incoming>
      <outgoing>recreateJobDescription</outgoing>
    </task>

    <sequenceFlow id="recreateJobDescription" sourceRef="askForMoreInformationTask" targetRef="createTask"/>

    <task id="submitForApprovalTask" name="Submit for Approval">
      <incoming>proceedWithSubmission</incoming>
      <outgoing>approvalResult</outgoing>
    </task>

    <sequenceFlow id="submitForApprovalFlow" sourceRef="submitForApprovalTask" targetRef="approvalResultGateway"/>

    <exclusiveGateway id="approvalResultGateway" name="Is Approved?">
      <incoming>approvalResult</incoming>
      <outgoing>postJob</outgoing>
      <outgoing>requestCorrections</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="approvalResult" sourceRef="submitForApprovalTask" targetRef="approvalResultGateway"/>

    <sequenceFlow id="postJob" sourceRef="approvalResultGateway" targetRef="jobPosted"/>
    <sequenceFlow id="requestCorrections" sourceRef="approvalResultGateway" targetRef="correctAndResubmitTask"/>

    <task id="correctAndResubmitTask" name="Correct and Resubmit">
      <incoming>requestCorrections</incoming>
      <outgoing>submitForApprovalAgain</outgoing>
    </task>

    <sequenceFlow id="submitForApprovalAgain" sourceRef="correctAndResubmitTask" targetRef="submitForApprovalTask"/>

    <endEvent id="jobPosted" name="Job Posted">
      <incoming>postJob</incoming>
    </endEvent>
  </process>
</definitions>