<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Measuring Point Change Process" targetNamespace="http://example.com/bpmn">

   <process id="measuringPointChangeProcess" isExecutable="true">
     <startEvent id="startEvent1" name="Start Measuring Point Change Process">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <exclusiveGateway id="changeRequestGateway1" name="Is Change Request from SP/PU/GO or MPO?">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
       <outgoing>sequenceFlow3</outgoing>
     </exclusiveGateway>

     <task id="reviewChangeRequest1" name="Review Change Request">
       <incoming>sequenceFlow2</incoming>
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow4</outgoing>
     </task>

     <exclusiveGateway id="changeDecisionGateway1" name="Approve or Reject Change?">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow5</outgoing>
       <outgoing>sequenceFlow6</outgoing>
     </exclusiveGateway>

     <task id="performMeasuringPointChange1" name="Perform Measuring Point Change">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow7</outgoing>
     </task>

     <exclusiveGateway id="implementationResultGateway1" name="Was Implementation Successful?">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow8</outgoing>
       <outgoing>sequenceFlow9</outgoing>
     </exclusiveGateway>

     <task id="sendImplementationReport1" name="Send Implementation Report to SP/PU/GO">
       <incoming>sequenceFlow8</incoming>
       <outgoing>sequenceFlow10</outgoing>
     </task>

     <task id="notifyFailure1" name="Notify SP/PU/GO about Failure of Changes">
       <incoming>sequenceFlow9</incoming>
       <outgoing>sequenceFlow11</outgoing>
     </task>

     <endEvent id="processEndEvent1" name="Measuring Point Change Process Ended">
       <incoming>sequenceFlow10</incoming>
       <incoming>sequenceFlow11</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="changeRequestGateway1"/>
     <sequenceFlow id="sequenceFlow2" name="From SP/PU/GO" sourceRef="changeRequestGateway1" targetRef="reviewChangeRequest1"/>
     <sequenceFlow id="sequenceFlow3" name="By MPO Himself" sourceRef="changeRequestGateway1" targetRef="reviewChangeRequest1"/>
     <sequenceFlow id="sequenceFlow4" sourceRef="reviewChangeRequest1" targetRef="changeDecisionGateway1"/>
     <sequenceFlow id="sequenceFlow5" name="Approve" sourceRef="changeDecisionGateway1" targetRef="performMeasuringPointChange1"/>
     <sequenceFlow id="sequenceFlow6" name="Reject" sourceRef="changeDecisionGateway1" targetRef="processEndEvent1"/>
     <sequenceFlow id="sequenceFlow7" sourceRef="performMeasuringPointChange1" targetRef="implementationResultGateway1"/>
     <sequenceFlow id="sequenceFlow8" name="Successful" sourceRef="implementationResultGateway1" targetRef="sendImplementationReport1"/>
     <sequenceFlow id="sequenceFlow9" name="Unsuccessful" sourceRef="implementationResultGateway1" targetRef="notifyFailure1"/>
     <sequenceFlow id="sequenceFlow10" sourceRef="sendImplementationReport1" targetRef="processEndEvent1"/>
     <sequenceFlow id="sequenceFlow11" sourceRef="notifyFailure1" targetRef="processEndEvent1"/>

   </process>
</definitions>