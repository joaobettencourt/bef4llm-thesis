<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" 
             targetNamespace="http://example.com/bpmn">

   <collaboration id="Collaboration_1">
     <participant id="Participant_0" name="Organization" processRef="Pool_0"/>
   </collaboration>

   <process id="Pool_0" isExecutable="true">
     <laneSet>
       <lane id="Lane_0" name="">
         <flowNodeRef>StartEvent_1</flowNodeRef>
         <flowNodeRef>Task_SendQuestionnaire</flowNodeRef>
         <flowNodeRef>ExclusiveGateway_CheckResponse</flowNodeRef>
         <flowNodeRef>EventBasedGateway_WaitForResponse</flowNodeRef>
         <flowNodeRef>IntermediateMessageEvent_QuestionnaireReceived</flowNodeRef>
         <flowNodeRef>IntermediateTimerEvent_SendReminder</flowNodeRef>
         <flowNodeRef>EndEvent_1</flowNodeRef>
         <flowNodeRef>Task_SendReminder</flowNodeRef>
       </lane>
     </laneSet>

     <startEvent id="StartEvent_1" name="Claim Handling Start">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <task id="Task_SendQuestionnaire" name="Send Questionnaire to Claimant">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>

     <exclusiveGateway id="ExclusiveGateway_CheckResponse" name="Has Claimant Responded?">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_4</outgoing>
     </exclusiveGateway>

     <eventBasedGateway id="EventBasedGateway_WaitForResponse" name="">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_5</outgoing>
       <outgoing>SequenceFlow_6</outgoing>
     </eventBasedGateway>

     <intermediateCatchEvent id="IntermediateMessageEvent_QuestionnaireReceived" name="Questionnaire Received">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_7</outgoing>
     </intermediateCatchEvent>

     <intermediateCatchEvent id="IntermediateTimerEvent_SendReminder" name="5 Days Passed">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_8</outgoing>
     </intermediateCatchEvent>

     <endEvent id="EndEvent_1" name="Claim Handling End">
       <incoming>SequenceFlow_7</incoming>
     </endEvent>

     <task id="Task_SendReminder" name="Send Reminder to Claimant">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_SendQuestionnaire"/>
     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_SendQuestionnaire" targetRef="ExclusiveGateway_CheckResponse"/>
     <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_CheckResponse" targetRef="EventBasedGateway_WaitForResponse"/>
     <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_CheckResponse" targetRef="Task_SendReminder"/>
     <sequenceFlow id="SequenceFlow_5" sourceRef="EventBasedGateway_WaitForResponse" targetRef="IntermediateMessageEvent_QuestionnaireReceived"/>
     <sequenceFlow id="SequenceFlow_6" sourceRef="EventBasedGateway_WaitForResponse" targetRef="IntermediateTimerEvent_SendReminder"/>
     <sequenceFlow id="SequenceFlow_7" sourceRef="IntermediateMessageEvent_QuestionnaireReceived" targetRef="EndEvent_1"/>
     <sequenceFlow id="SequenceFlow_8" sourceRef="IntermediateTimerEvent_SendReminder" targetRef="Task_SendReminder"/>
     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_SendReminder" targetRef="EventBasedGateway_WaitForResponse"/>

   </process>

</definitions>