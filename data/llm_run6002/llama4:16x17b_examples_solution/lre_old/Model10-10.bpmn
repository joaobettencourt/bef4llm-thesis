<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" 
             targetNamespace="http://bpmn.io/schema/bpmn">
    <process id="faultManagementProcess" isExecutable="true">

      <!-- Start Event  -->
      <startEvent id="startEvent" name="Fault Report or Suspicion">
        <outgoing>sequenceFlow1</outgoing>
      </startEvent>

      <!-- Task: Examine Failure  -->
      <task id="examineFailureTask" name="Examine Failure">
        <incoming>sequenceFlow1</incoming>
        <outgoing>sequenceFlow2</outgoing>
      </task>

      <!-- Exclusive Gateway: User Confirms or Rejects Failure  -->
      <exclusiveGateway id="confirmOrRejectGateway" name="Confirm or Reject Fault Detector Report">
        <incoming>sequenceFlow2</incoming>
        <outgoing>sequenceFlow3</outgoing>
        <outgoing>sequenceFlow4</outgoing>
      </exclusiveGateway>

      <!-- Task: Inform Customer and Manager  -->
      <task id="informCustomerManagerTask" name="Inform Customer and Manager">
        <incoming>sequenceFlow3</incoming>
        <outgoing>sequenceFlow5</outgoing>
      </task>

      <!-- Task: Fix Fault  -->
      <task id="fixFaultTask" name="Fix Fault at Measuring Device">
        <incoming>sequenceFlow5</incoming>
        <outgoing>sequenceFlow6</outgoing>
      </task>

      <!-- Task: Share Repair Results  -->
      <task id="shareRepairResultsTask" name="Share Repair Results with Fault Detector">
        <incoming>sequenceFlow6</incoming>
        <outgoing>sequenceFlow7</outgoing>
      </task>

      <!-- Task: Inform Customer and Manager about Resolution  -->
      <task id="informAboutResolutionTask" name="Inform about Resolution of Interference">
        <incoming>sequenceFlow7</incoming>
        <outgoing>sequenceFlow8</outgoing>
      </task>

      <!-- End Event  -->
      <endEvent id="endEvent" name="Interference Resolved">
        <incoming>sequenceFlow8</incoming>
      </endEvent>

      <!-- Sequence Flows  -->
      <sequenceFlow id="sequenceFlow1" sourceRef="startEvent" targetRef="examineFailureTask"/>
      <sequenceFlow id="sequenceFlow2" sourceRef="examineFailureTask" targetRef="confirmOrRejectGateway"/>
      <sequenceFlow id="sequenceFlow3" sourceRef="confirmOrRejectGateway" targetRef="informCustomerManagerTask"/>
      <sequenceFlow id="sequenceFlow4" sourceRef="confirmOrRejectGateway" targetRef="endEvent"/>
      <sequenceFlow id="sequenceFlow5" sourceRef="informCustomerManagerTask" targetRef="fixFaultTask"/>
      <sequenceFlow id="sequenceFlow6" sourceRef="fixFaultTask" targetRef="shareRepairResultsTask"/>
      <sequenceFlow id="sequenceFlow7" sourceRef="shareRepairResultsTask" targetRef="informAboutResolutionTask"/>
      <sequenceFlow id="sequenceFlow8" sourceRef="informAboutResolutionTask" targetRef="endEvent"/>

    </process>
</definitions>