<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" name="Service Degradation Process" targetNamespace="http://bpmn.io/schema/bpmn">
   <collaboration id="Collaboration">
     <participant id="Customer" processRef="CustomerProcess"/>
     <participant id="Customer_Service" processRef="CustomerServiceProcess"/>
     <participant id="Service_Management" processRef="ServiceManagementProcess"/>
     <participant id="Resource_Provisioning" processRef="ResourceProvisioningProcess"/>
   </collaboration>

   <process id="CustomerProcess" isExecutable="true">
     <startEvent id="Start_Customer" name="Perceive Service Degradation">
       <outgoing>SendProblemParams</outgoing>
     </startEvent>
     <sequenceFlow id="SendProblemParams_1" sourceRef="Start_Customer" targetRef="SendListOfProblemParameters"/>
     <intermediateThrowEvent id="SendListOfProblemParameters" name="Send List of Problem Parameters">
       <outgoing>ReceiveProblemReport</outgoing>
     </intermediateThrowEvent>
     <sequenceFlow id="ReceiveProblemReport_1" sourceRef="SendListOfProblemParameters" targetRef="End_Customer"/>
     <endEvent id="End_Customer" name="Process Ends for Customer">
     </endEvent>
   </process>

   <process id="CustomerServiceProcess" isExecutable="true">
     <startEvent id="Start_Customer_Service" name="Receive Problem Report">
       <outgoing>EnterProblemReport</outgoing>
     </startEvent>
     <task id="Enter_Problem_Report" name="Enter problem report into system T">
       <incoming>EnterProblemReport</incoming>
       <outgoing>CompareToSLA</outgoing>
     </task>
     <sequenceFlow id="EnterProblemReport" sourceRef="Start_Customer_Service" targetRef="Enter_Problem_Report"/>
     <sequenceFlow id="CompareToSLA" sourceRef="Enter_Problem_Report" targetRef="DetermineCounterMeasures"/>
     <task id="Determine_Counter_Measures" name="Determine counter measures incl. priorities">
       <incoming>CompareToSLA</incoming>
       <outgoing>DetermineCustomerSignificance</outgoing>
     </task>
     <sequenceFlow id="DetermineCustomerSignificance" sourceRef="Determine_Counter_Measures" targetRef="ExclusiveGatewayCustomerSignificance"/>
     <exclusiveGateway id="ExclusiveGatewayCustomerSignificance" name="Premium customer?">
       <incoming>DetermineCustomerSignificance</incoming>
       <outgoing>LinkToExtraProblemFixProcess</outgoing>
       <outgoing>RePrioritizeMeasures</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="LinkToExtraProblemFixProcess" sourceRef="ExclusiveGatewayCustomerSignificance" targetRef="End_Link_To_Extra_Problem_Fix_Process"/>
     <endEvent id="End_Link_To_Extra_Problem_Fix_Process">
     </endEvent>
     <sequenceFlow id="RePrioritizeMeasures" sourceRef="ExclusiveGatewayCustomerSignificance" targetRef="Determine_Counter_Measures"/>
   </process>

   <process id="ServiceManagementProcess" isExecutable="true">
     <startEvent id="Start_Service_Management" name="Receive Detailed Problem Report">
       <outgoing>AnalyzeProblem</outgoing>
     </startEvent>
     <!-- Tasks and Gateways for Service Management  -->
     <task id="Analyze_Problem" name="Investigate whether problem is analyzable at this level">
       <incoming>AnalyzeProblem</incoming>
       <outgoing>ExclusiveGatewayAnalyzable</outgoing>
     </task>
     <sequenceFlow id="AnalyzeProblem" sourceRef="Start_Service_Management" targetRef="Analyze_Problem"/>
     <exclusiveGateway id="ExclusiveGatewayAnalyzable" name="Analyzable here?">
       <incoming>Analyze_Problem</incoming>
       <outgoing>PerformAnalysis</outgoing>
       <outgoing>SendToResourceProvisioning</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="PerformAnalysis" sourceRef="ExclusiveGatewayAnalyzable" targetRef="CreateTroubleReport"/>
     <task id="Create_Trouble_Report" name="Create trouble report indicating the type of problem">
       <incoming>PerformAnalysis</incoming>
       <!-- outgoing not specified -->
     </task>
     <sequenceFlow id="SendToResourceProvisioning" sourceRef="ExclusiveGatewayAnalyzable" targetRef="ResourceProvisioningProcess"/>
   </process>

   <process id="ResourceProvisioningProcess" isExecutable="true">
     <startEvent id="Start_Resource_Provisioning" name="Receive Detailed Problem Report or Request">
       <outgoing>CheckForProblems</outgoing>
     </startEvent>
     <!-- Tasks and Gateways for Resource Provisioning  -->
   </process>

</definitions>