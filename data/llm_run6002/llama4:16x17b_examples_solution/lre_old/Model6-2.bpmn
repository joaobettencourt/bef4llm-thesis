<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" name="Order Process">

  <collaboration id="collaboration">
    <participant id="supplier" name="Supplier" processRef="supplierProcess"/>
    <participant id="assemblerAG" name="Assembler AG" processRef="assemblerAGProcess"/>
    <messageFlow id="orderMessageFlow" sourceRef="sendOrderTask" targetRef="processOrderTask"/>
    <messageFlow id="invoiceMessageFlow" sourceRef="sendInvoiceTask" targetRef="receiveInvoiceTask"/>
  </collaboration>

  <process id="supplierProcess" isExecutable="false">
    <startEvent id="startSupplier" name="Start Supplier Process">
      <outgoing>sequenceFlow1</outgoing>
    </startEvent>

    <task id="processOrderTask" name="Process Order">
      <incoming>orderMessageFlow</incoming>
      <outgoing>sequenceFlow2</outgoing>
    </task>

    <task id="sendInvoiceTask" name="Send Invoice to Assembler AG">
      <incoming>sequenceFlow2</incoming>
      <outgoing>invoiceMessageFlow</outgoing>
    </task>

    <endEvent id="endSupplier" name="End Supplier Process">
      <incoming>invoiceMessageFlow</incoming>
    </endEvent>

    <sequenceFlow id="sequenceFlow1" sourceRef="startSupplier" targetRef="processOrderTask"/>
    <sequenceFlow id="sequenceFlow2" sourceRef="processOrderTask" targetRef="sendInvoiceTask"/>

  </process>

  <process id="assemblerAGProcess" isExecutable="false">
    <startEvent id="startAssemblerAG" name="Start Assembler AG Process">
      <outgoing>sequenceFlow3</outgoing>
    </startEvent>

    <task id="sendOrderTask" name="Send Order to Supplier">
      <incoming>sequenceFlow3</incoming>
      <outgoing>orderMessageFlow</outgoing>
    </task>

    <task id="receiveInvoiceTask" name="Receive Invoice from Supplier">
      <incoming>invoiceMessageFlow</incoming>
      <outgoing>sequenceFlow4</outgoing>
    </task>

    <endEvent id="endAssemblerAG" name="End Assembler AG Process">
      <incoming>sequenceFlow4</incoming>
    </endEvent>

    <sequenceFlow id="sequenceFlow3" sourceRef="startAssemblerAG" targetRef="sendOrderTask"/>
    <sequenceFlow id="sequenceFlow4" sourceRef="receiveInvoiceTask" targetRef="endAssemblerAG"/>

  </process>

</definitions>