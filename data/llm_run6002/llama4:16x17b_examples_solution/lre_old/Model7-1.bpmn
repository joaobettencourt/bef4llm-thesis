<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" 
             targetNamespace="http://example.com/bpmn">

   <collaboration id="collaboration">
     <participant id="participant" name="Lead Processing" processRef="process"/>
   </collaboration>

   <process id="process" isExecutable="true">
     <laneSet>
       <lane id="salesAssistantLane" name="Sales Assistant">
         <flowNodeRef>taskCallCustomer</flowNodeRef>
         <flowNodeRef>exclusiveGatewayDecision</flowNodeRef>
       </lane>
       <lane id="managerLane" name="Manager">
         <flowNodeRef>startEventBegin</flowNodeRef>
         <flowNodeRef>taskCheckLeads</flowNodeRef>
         <flowNodeRef>taskSelectTopFive</flowNodeRef>
         <flowNodeRef>taskProcessLead</flowNodeRef>
       </lane>
     </laneSet>

     <!-- Sequence Flows  -->
     <sequenceFlow id="sequenceFlowBegin" sourceRef="startEventBegin" targetRef="taskCheckLeads"/>
     <sequenceFlow id="sequenceFlowCheckToSelect" sourceRef="taskCheckLeads" targetRef="taskSelectTopFive"/>
     <sequenceFlow id="sequenceFlowSelectToCall" sourceRef="taskSelectTopFive" targetRef="taskCallCustomer"/>

     <sequenceFlow id="sequenceFlowCallToDecision" sourceRef="taskCallCustomer" targetRef="exclusiveGatewayDecision"/>
     <sequenceFlow id="sequenceFlowDecisionToProcess" sourceRef="exclusiveGatewayDecision" targetRef="taskProcessLead">
       <conditionExpression xsi:type="tFormalExpression">interested = true</conditionExpression>
     </sequenceFlow>
     <sequenceFlow id="sequenceFlowDecisionToCallNext" sourceRef="exclusiveGatewayDecision" targetRef="taskCallCustomer">
       <conditionExpression xsi:type="tFormalExpression">interested = false</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="sequenceFlowProcessToEnd" sourceRef="taskProcessLead" targetRef="endEventComplete"/>

     <!-- Flow Elements  -->
     <startEvent id="startEventBegin" name="Begin Lead Processing">
       <outgoing>sequenceFlowBegin</outgoing>
     </startEvent>

     <task id="taskCheckLeads" name="Check Open Leads">
       <incoming>sequenceFlowBegin</incoming>
       <outgoing>sequenceFlowCheckToSelect</outgoing>
     </task>

     <task id="taskSelectTopFive" name="Select Top Five Leads">
       <incoming>sequenceFlowCheckToSelect</incoming>
       <outgoing>sequenceFlowSelectToCall</outgoing>
     </task>

     <task id="taskCallCustomer" name="Call Contact Person">
       <incoming>sequenceFlowSelectToCall</incoming>
       <incoming>sequenceFlowDecisionToCallNext</incoming>
       <outgoing>sequenceFlowCallToDecision</outgoing>
     </task>

     <exclusiveGateway id="exclusiveGatewayDecision" name="Is Customer Interested?">
       <incoming>sequenceFlowCallToDecision</incoming>
       <outgoing>sequenceFlowDecisionToProcess</outgoing>
       <outgoing>sequenceFlowDecisionToCallNext</outgoing>
     </exclusiveGateway>

     <task id="taskProcessLead" name="Process Lead">
       <incoming>sequenceFlowDecisionToProcess</incoming>
       <outgoing>sequenceFlowProcessToEnd</outgoing>
     </task>

     <endEvent id="endEventComplete" name="Lead Processing Complete">
       <incoming>sequenceFlowProcessToEnd</incoming>
     </endEvent>

   </process>
</definitions>