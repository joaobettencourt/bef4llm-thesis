<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
             id="definition" name="Customer Acquisition Process" targetNamespace="http://bpmn.io/schema/bpmn">
   <process id="customerAcquisitionProcess" isExecutable="true">
     <laneSet>
       <lane id="marketingLane" name="Marketing">
         <flowNodeRef>StartEvent_1</flowNodeRef>
       </lane>
       <lane id="callCenterLane" name="Call Center Employee">
         <flowNodeRef>Task_CallCenter</flowNodeRef>
       </lane>
       <lane id="salesRepresentativeLane" name="Sales Representative">
         <flowNodeRef>Task_SalesPresentation</flowNodeRef>
         <flowNodeRef>Task_PreSalesPresentation</flowNodeRef>
         <flowNodeRef>IntermediateCatchEvent_1</flowNodeRef>
         <flowNodeRef>Task_FollowUp</flowNodeRef>
       </lane>
       <lane id="developmentLane" name="Development">
         <flowNodeRef>Task_HeadOfDevelopment</flowNodeRef>
       </lane>
     </laneSet>

     <startEvent id="StartEvent_1" name="Determine Contact Details">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_4</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="ExclusiveGateway_1"/>
     <sequenceFlow id="SequenceFlow_2" sourceRef="ExclusiveGateway_1" targetRef="Task_MarketingAction"/>
     <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_1" targetRef="Task_CallCenter"/>
     <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_1" targetRef="Task_OtherSources"/>

     <task id="Task_MarketingAction" name="Buy Data or Visit Exhibition">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_MarketingAction" targetRef="Task_CallCenter"/>

     <task id="Task_CallCenter" name="Determine Contact Person and Budget">
       <incoming>SequenceFlow_3</incoming>
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </task>

     <exclusiveGateway id="ExclusiveGateway_2">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_7</outgoing>
       <outgoing>SequenceFlow_8</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_CallCenter" targetRef="ExclusiveGateway_2"/>
     <sequenceFlow id="SequenceFlow_7" name="Interested and Huge Budget" sourceRef="ExclusiveGateway_2" targetRef="Task_HeadOfDevelopment"/>
     <sequenceFlow id="SequenceFlow_8" name="Not Interested or Normal Budget" sourceRef="ExclusiveGateway_2" targetRef="EndEvent_NotInterested"/>

     <task id="Task_OtherSources" name="Use Other Sources">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_OtherSources" targetRef="Task_CallCenter"/>

     <task id="Task_HeadOfDevelopment" name="Contact Customer Personally">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_10</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_10" sourceRef="Task_HeadOfDevelopment" targetRef="Task_SalesPresentation"/>

     <task id="Task_SalesPresentation" name="Give Sales Presentation">
       <incoming>SequenceFlow_10</incoming>
       <outgoing>SequenceFlow_11</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_11" sourceRef="Task_SalesPresentation" targetRef="ExclusiveGateway_3"/>

     <exclusiveGateway id="ExclusiveGateway_3">
       <incoming>SequenceFlow_11</incoming>
       <outgoing>SequenceFlow_12</outgoing>
       <outgoing>SequenceFlow_13</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_12" sourceRef="ExclusiveGateway_3" targetRef="Task_PreSalesPresentation"/>
     <sequenceFlow id="SequenceFlow_13" sourceRef="ExclusiveGateway_3" targetRef="IntermediateCatchEvent_1"/>

     <task id="Task_PreSalesPresentation" name="Give Pre-Sales Presentation">
       <incoming>SequenceFlow_12</incoming>
       <outgoing>SequenceFlow_14</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_14" sourceRef="Task_PreSalesPresentation" targetRef="IntermediateCatchEvent_1"/>

     <intermediateCatchEvent id="IntermediateCatchEvent_1">
       <incoming>SequenceFlow_13</incoming>
       <incoming>SequenceFlow_14</incoming>
       <outgoing>SequenceFlow_15</outgoing>
       <timerEventDefinition/>
     </intermediateCatchEvent>

     <sequenceFlow id="SequenceFlow_15" sourceRef="IntermediateCatchEvent_1" targetRef="Task_FollowUp"/>

     <task id="Task_FollowUp" name="Follow Up">
       <incoming>SequenceFlow_15</incoming>
       <outgoing>SequenceFlow_16</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_16" sourceRef="Task_FollowUp" targetRef="EndEvent_CreateQuotation"/>

     <endEvent id="EndEvent_NotInterested">
       <incoming>SequenceFlow_8</incoming>
     </endEvent>

     <endEvent id="EndEvent_CreateQuotation" name="Create Quotation">
       <incoming>SequenceFlow_16</incoming>
     </endEvent>
   </process>
 </definitions>