<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Daily Defaulters Process" targetNamespace="http://example.com/bpmn">

   <process id="dailyDefaultersProcess" isExecutable="true">
     <startEvent id="startEvent1" name="Weekday Morning">
       <outgoing>sequenceFlow1</outgoing>
       <timerEventDefinition/>
     </startEvent>

     <task id="backupDatabaseTask" name="Backup Database">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="backupDatabaseTask"/>
     <sequenceFlow id="sequenceFlow2" sourceRef="backupDatabaseTask" targetRef="exclusiveGateway1"/>

     <exclusiveGateway id="exclusiveGateway1">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
       <outgoing>sequenceFlow4</outgoing>
     </exclusiveGateway>

     <task id="checkDefaultersTableTask" name="Check Account Defaulters Table">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow5</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow3" sourceRef="exclusiveGateway1" targetRef="checkDefaultersTableTask"/>
     <sequenceFlow id="sequenceFlow4" sourceRef="exclusiveGateway1" targetRef="checkCRMSystemTask"/>

     <exclusiveGateway id="exclusiveGateway2">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow6</outgoing>
       <outgoing>sequenceFlow7</outgoing>
     </exclusiveGateway>

     <task id="registerDefaultersTask" name="Register Defaulting Accounts and Customers">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow8</outgoing>
     </task>

     <task id="sendAlertSupervisorTask" name="Send Alert to Supervisor">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow9</outgoing>
     </task>

     <endEvent id="endEvent1" name="Process Completed">
       <incoming>sequenceFlow8</incoming>
       <incoming>sequenceFlow9</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow5" sourceRef="checkDefaultersTableTask" targetRef="exclusiveGateway2"/>
     <sequenceFlow id="sequenceFlow6" sourceRef="exclusiveGateway2" targetRef="registerDefaultersTask"/>
     <sequenceFlow id="sequenceFlow7" sourceRef="exclusiveGateway2" targetRef="sendAlertSupervisorTask"/>

     <task id="checkCRMSystemTask" name="Check CRM System for New Returns">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow10</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow10" sourceRef="checkCRMSystemTask" targetRef="intermediateCatchEvent1"/>

     <intermediateCatchEvent id="intermediateCatchEvent1">
       <incoming>sequenceFlow10</incoming>
       <outgoing>sequenceFlow11</outgoing>
       <timerEventDefinition/>
     </intermediateCatchEvent>

     <task id="reconcileDefaultersTask" name="Reconcile with Account Defaulters Table">
       <incoming>sequenceFlow11</incoming>
       <outgoing>sequenceFlow12</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow11" sourceRef="intermediateCatchEvent1" targetRef="reconcileDefaultersTask"/>
     <sequenceFlow id="sequenceFlow12" sourceRef="reconcileDefaultersTask" targetRef="endEvent1"/>

   </process>
</definitions>