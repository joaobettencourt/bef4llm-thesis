<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="ZooClub Membership Process">

   <process id="zooClubMembershipProcess" isExecutable="true">
     <startEvent id="startEvent1" name="Visitor Applies for Membership">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <exclusiveGateway id="membershipTypeGateway1" name="Select Membership Type">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
       <outgoing>sequenceFlow3</outgoing>
     </exclusiveGateway>

     <task id="prepareIndividualInfoTask" name="Prepare Individual Information">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow4</outgoing>
     </task>

     <task id="prepareFamilyInfoTask" name="Prepare Family Information">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow5</outgoing>
     </task>

     <exclusiveGateway id="informationPreparedGateway1">
       <incoming>sequenceFlow4</incoming>
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow6</outgoing>
     </exclusiveGateway>

     <task id="sendInfoToZooClubTask" name="Send Information to Zoo Club Department">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow7</outgoing>
     </task>

     <parallelGateway id="zooClubProcessingGateway1">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow8</outgoing>
       <outgoing>sequenceFlow9</outgoing>
     </parallelGateway>

     <task id="processPaymentTask" name="Process Payment Request">
       <incoming>sequenceFlow8</incoming>
       <outgoing>sequenceFlow10</outgoing>
     </task>

     <task id="forwardInfoToMarketingTask" name="Forward Information to Marketing Department">
       <incoming>sequenceFlow9</incoming]
     </task>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="membershipTypeGateway1"/>
     <sequenceFlow id="sequenceFlow2" name="Individual Membership" sourceRef="membershipTypeGateway1" targetRef="prepareIndividualInfoTask"/>
     <sequenceFlow id="sequenceFlow3" name="Family Membership" sourceRef="membershipTypeGateway1" targetRef="prepareFamilyInfoTask"/>
     <sequenceFlow id="sequenceFlow4" sourceRef="prepareIndividualInfoTask" targetRef="informationPreparedGateway1"/>
     <sequenceFlow id="sequenceFlow5" sourceRef="prepareFamilyInfoTask" targetRef="informationPreparedGateway1"/>
     <sequenceFlow id="sequenceFlow6" sourceRef="informationPreparedGateway1" targetRef="sendInfoToZooClubTask"/>
     <sequenceFlow id="sequenceFlow7" sourceRef="sendInfoToZooClubTask" targetRef="zooClubProcessingGateway1"/>
     <sequenceFlow id="sequenceFlow8" sourceRef="zooClubProcessingGateway1" targetRef="processPaymentTask"/>
     <sequenceFlow id="sequenceFlow9" sourceRef="zooClubProcessingGateway1" targetRef="forwardInfoToMarketingTask"/>
     <sequenceFlow id="sequenceFlow10" sourceRef="processPaymentTask" targetRef="paymentConfirmationEvent1"/>

     <intermediateCatchEvent id="paymentConfirmationEvent1" name="Payment Confirmed">
       <incoming>sequenceFlow10</incoming>
       <outgoing>sequenceFlow11</outgoing>
       <messageEventDefinition/>
     </intermediateCatchEvent>

     <task id="printAndDeliverCardTask" name="Print and Deliver Zoo Club Card">
       <incoming>sequenceFlow11</incoming]
       <outgoing>sequenceFlow12</outgoing>
     </task>

     <endEvent id="membershipComplete1" name="Membership Complete">
       <incoming>sequenceFlow12</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow11" sourceRef="paymentConfirmationEvent1" targetRef="printAndDeliverCardTask"/>
     <sequenceFlow id="sequenceFlow12" sourceRef="printAndDeliverCardTask" targetRef="membershipComplete1"/>

   </process>
</definitions>