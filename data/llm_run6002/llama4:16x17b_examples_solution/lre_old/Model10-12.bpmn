<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" 
             targetNamespace="http://example.com/bpmn">

   <process id="masterDataChangeProcess" isExecutable="true">
     <startEvent id="ecInformsInq">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <task id="inqNotifiesIp">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow1" sourceRef="ecInformsInq" targetRef="inqNotifiesIp"/>

     <exclusiveGateway id="ipChecksMasterDataChange">
       <incoming>sequenceFlow2</incoming>
       <outgoing>confirmSequenceFlow</outgoing>
       <outgoing>rejectSequenceFlow</outgoing>
     </exclusiveGateway>

     <task id="ipConfirmsChanges" name="IP Confirms Changes">
       <incoming>confirmSequenceFlow</incoming>
       <outgoing>endSequenceFlow</outgoing>
     </task>

     <sequenceFlow id="confirmSequenceFlow" sourceRef="ipChecksMasterDataChange" targetRef="ipConfirmsChanges"/>

     <task id="ipRejectsChanges" name="IP Rejects Changes">
       <incoming>rejectSequenceFlow</incoming>
       <outgoing>endSequenceFlow2</outgoing>
     </task>

     <sequenceFlow id="rejectSequenceFlow" sourceRef="ipChecksMasterDataChange" targetRef="ipRejectsChanges"/>

     <endEvent id="processEnd">
       <incoming>endSequenceFlow</incoming>
       <incoming>endSequenceFlow2</incoming>
     </endEvent>

     <sequenceFlow id="endSequenceFlow" sourceRef="ipConfirmsChanges" targetRef="processEnd"/>
     <sequenceFlow id="endSequenceFlow2" sourceRef="ipRejectsChanges" targetRef="processEnd"/>

     <sequenceFlow id="sequenceFlow2" sourceRef="inqNotifiesIp" targetRef="ipChecksMasterDataChange"/>
   </process>
</definitions>