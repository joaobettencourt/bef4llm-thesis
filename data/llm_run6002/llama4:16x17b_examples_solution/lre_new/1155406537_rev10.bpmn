<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.4.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" targetNamespace="http://www.example.com">

   <process id="createPaypalAccountProcess" isExecutable="true">
     <startEvent id="startEvent">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <task id="determineAccountType" name="Determine PayPal Account Type">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent" targetRef="determineAccountType"/>

     <exclusiveGateway id="accountTypeGateway">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
       <outgoing>sequenceFlow4</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow2" sourceRef="determineAccountType" targetRef="accountTypeGateway"/>
     <sequenceFlow id="sequenceFlow3" name="Personal account type required" sourceRef="accountTypeGateway" targetRef="enterLoginDetails"/>
     <sequenceFlow id="sequenceFlow4" sourceRef="accountTypeGateway" targetRef="enterLoginDetails"/>

     <subProcess id="enterLoginDetails">
       <incoming>sequenceFlow3</incoming>
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow5</outgoing>
       <startEvent id="loginStart">
         <outgoing>sequenceFlow6</outgoing>
       </startEvent>

       <sequenceFlow id="sequenceFlow6" sourceRef="loginStart" targetRef="enterLoginTask"/>
       <task id="enterLoginTask" name="Enter Login Details">
         <incoming>sequenceFlow6</incoming>
         <outgoing>sequenceFlow5</outgoing>
       </task>
       <sequenceFlow id="sequenceFlow5" sourceRef="enterLoginTask" targetRef="subProcessEnd"/>

       <endEvent id="subProcessEnd1">
         <incoming>sequenceFlow5</incoming>
       </endEvent>
     </subProcess>

     <sequenceFlow id="sequenceFlow7" sourceRef="enterLoginDetails" targetRef="enterPersonalDetails"/>

     <subProcess id="enterPersonalDetails">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow8</outgoing>
       <startEvent id="personalStart">
         <outgoing>sequenceFlow9</outgoing>
       </startEvent>

       <sequenceFlow id="sequenceFlow9" sourceRef="personalStart" targetRef="enterPersonalTask"/>
       <task id="enterPersonalTask" name="Enter Personal Details">
         <incoming>sequenceFlow9</incoming>
         <outgoing>sequenceFlow8</outgoing>
       </task>
       <sequenceFlow id="sequenceFlow8" sourceRef="enterPersonalTask" targetRef="subProcessEnd2"/>

       <endEvent id="subProcessEnd2">
         <incoming>sequenceFlow8</incoming>
       </endEvent>
     </subProcess>

     <sequenceFlow id="sequenceFlow10" sourceRef="enterPersonalDetails" targetRef="declarePoliticallyExposedPerson"/>

     <task id="declarePoliticallyExposedPerson" name="Declare if have been or affiliated with a Politically Exposed person">
       <incoming>sequenceFlow10</incoming>
       <outgoing>sequenceFlow11</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow11" sourceRef="declarePoliticallyExposedPerson" targetRef="intermediateThrowEvent"/>

     <intermediateThrowEvent id="intermediateThrowEvent1" name="Submit account details to System">
       <incoming>sequenceFlow11</incoming>
       <outgoing>sequenceFlow12</outgoing>
       <messageEventDefinition/> 
     </intermediateThrowEvent>

     <sequenceFlow id="sequenceFlow12" sourceRef="intermediateThrowEvent1" targetRef="exclusiveGatewayValidation"/>

     <exclusiveGateway id="exclusiveGatewayValidation">
       <incoming>sequenceFlow12</incoming>
       <outgoing>sequenceFlow13</outgoing>
       <outgoing>sequenceFlow14</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow13" name="Input fields valid" sourceRef="exclusiveGatewayValidation" targetRef="generateWelcomeEmail"/>
     <sequenceFlow id="sequenceFlow14" name="Input fields invalid" sourceRef="exclusiveGatewayValidation" targetRef="notifyClientAndCorrect"/>

     <task id="generateWelcomeEmail" name="Generate New User Email">
       <incoming>sequenceFlow13</incoming>
       <outgoing>sequenceFlow15</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow15" sourceRef="generateWelcomeEmail" targetRef="sendWelcomeEmail"/>

     <intermediateThrowEvent id="sendWelcomeEmail" name="Send Welcome Email">
       <incoming>sequenceFlow15</incoming>
       <outgoing>sequenceFlow16</outgoing>
       <messageEventDefinition/> 
     </intermediateThrowEvent>

     <sequenceFlow id="sequenceFlow16" sourceRef="sendWelcomeEmail" targetRef="endEvent"/>

     <task id="notifyClientAndCorrect" name="Notify Client and Correct">
       <incoming>sequenceFlow14</incoming>
       <outgoing>sequenceFlow17</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow17" sourceRef="notifyClientAndCorrect" targetRef="enterLoginDetails"/>

     <endEvent id="endEvent" name="PayPal account created">
       <incoming>sequenceFlow16</incoming>
     </endEvent>

   </process>

</definitions>