<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">

   <process id="purchaseOrderToDeliveryProcess" isExecutable="true">
     <startEvent id="startEvent1">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <task id="checkInvoiceTask" name="Check purchase invoice formally">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="checkInvoiceTask"/>

     <task id="registerInvoiceTask" name="Check for factual correctness and register in SAPERION">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow2" sourceRef="checkInvoiceTask" targetRef="registerInvoiceTask"/>

     <exclusiveGateway id="amountCheckGateway1">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow4</outgoing>
       <outgoing>sequenceFlow5</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow3" sourceRef="registerInvoiceTask" targetRef="amountCheckGateway1"/>

     <task id="approveInvoiceTask" name="Approve purchase invoice">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow6</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow4" sourceRef="amountCheckGateway1" targetRef="approveInvoiceTask">
       <conditionExpression xsi:type="tFormalExpression">${invoiceAmount > 500}</conditionExpression>
     </sequenceFlow>

     <task id="triggerPaymentTask" name="Trigger payment in ERP system">
       <incoming>sequenceFlow5</incoming>
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow7</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow5" sourceRef="amountCheckGateway1" targetRef="triggerPaymentTask">
       <conditionExpression xsi:type="tFormalExpression">${invoiceAmount <= 500}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="sequenceFlow6" sourceRef="approveInvoiceTask" targetRef="triggerPaymentTask"/>

     <endEvent id="endEvent1">
       <incoming>sequenceFlow7</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow7" sourceRef="triggerPaymentTask" targetRef="endEvent1"/>

   </process>

</definitions>