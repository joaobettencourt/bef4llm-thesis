<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" targetNamespace="http://www.example.com">

   <process id="invoiceProcess" isExecutable="true">
     <startEvent id="startEvent">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <task id="locateVendorTask" name="Locate Vendor in SAP system">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent" targetRef="locateVendorTask"/>

     <exclusiveGateway id="vendorExistsGateway">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
       <outgoing>sequenceFlow4</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow2" sourceRef="locateVendorTask" targetRef="vendorExistsGateway"/>

     <subProcess id="newVendorSubProcess">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow5</outgoing>
       <startEvent id="newVendorStartEvent">
         <outgoing>sequenceFlow6</outgoing>
       </startEvent>

       <task id="fillOutRequestTask" name="Fill out request for new Vendor Master Record form">
         <incoming>sequenceFlow6</incoming>
         <outgoing>sequenceFlow7</outgoing>
       </task>

       <sequenceFlow id="sequenceFlow6" sourceRef="newVendorStartEvent" targetRef="fillOutRequestTask"/>

       <task id="attachRequestToInvoiceTask" name="Attach request to invoice">
         <incoming>sequenceFlow7</incoming>
         <outgoing>sequenceFlow8</outgoing>
       </task>

       <sequenceFlow id="sequenceFlow7" sourceRef="fillOutRequestTask" targetRef="attachRequestToInvoiceTask"/>

       <task id="placeInInternalOutboxTask" name="Place invoice in internal outbox for new vendors">
         <incoming>sequenceFlow8</incoming>
         <outgoing>sequenceFlow9</outgoing>
       </task>

       <sequenceFlow id="sequenceFlow8" sourceRef="attachRequestToInvoiceTask" targetRef="placeInInternalOutboxTask"/>

       <intermediateCatchEvent id="urgencyClassification">
         <incoming>sequenceFlow9</incoming>
         <outgoing>sequenceFlow10</outgoing>
         <timerEventDefinition/>
       </intermediateCatchEvent>

       <sequenceFlow id="sequenceFlow9" sourceRef="placeInInternalOutboxTask" targetRef="urgencyClassification"/>

       <endEvent id="endSubProcess">
         <incoming>sequenceFlow10</incoming>
       </endEvent>

       <sequenceFlow id="sequenceFlow10" sourceRef="urgencyClassification" targetRef="endSubProcess"/>
     </subProcess>

     <sequenceFlow id="sequenceFlow3" name="Vendor does not exist" sourceRef="vendorExistsGateway" targetRef="newVendorSubProcess"/>

     <task id="addSapNumberTask" name="Add SAP Vendor number to invoice">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow11</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow4" sourceRef="vendorExistsGateway" targetRef="addSapNumberTask"/>

     <exclusiveGateway id="sortingGateway">
       <incoming>sequenceFlow11</incoming>
       <outgoing>sequenceFlow12</outgoing>
       <outgoing>sequenceFlow13</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow11" sourceRef="addSapNumberTask" targetRef="sortingGateway"/>

     <task id="sortByVendorTask" name="Invoices sorted by Vendor">
       <incoming>sequenceFlow12</incoming>
       <outgoing>sequenceFlow14</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow12" name="Prefers sorting by vendor" sourceRef="sortingGateway" targetRef="sortByVendorTask"/>

     <task id="sortByAmountTask" name="Invoices sorted by amount">
       <incoming>sequenceFlow13</incoming>
       <outgoing>sequenceFlow14</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow13" name="Prefers sorting by amount" sourceRef="sortingGateway" targetRef="sortByAmountTask"/>

     <exclusiveGateway id="endProcessGateway">
       <incoming>sequenceFlow14</incoming>
       <outgoing>sequenceFlow15</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow14" sourceRef="sortByVendorTask" targetRef="endProcessGateway"/>
     <sequenceFlow id="sequenceFlow14b" sourceRef="sortByAmountTask" targetRef="endProcessGateway"/>

     <task id="enterIntoSapTask" name="Invoices entered into SAP system">
       <incoming>sequenceFlow15</incoming>
       <outgoing>sequenceFlow16</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow15" sourceRef="endProcessGateway" targetRef="enterIntoSapTask"/>

     <endEvent id="endEvent">
       <incoming>sequenceFlow16</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow16" sourceRef="enterIntoSapTask" targetRef="endEvent"/>
   </process>
</definitions>