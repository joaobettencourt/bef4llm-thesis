<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" targetNamespace="http://www.example.com">

  <process id="customerFeedbackProcess" isExecutable="true">
    <startEvent id="startEvent">
      <outgoing>sequenceFlow1</outgoing>
    </startEvent>

    <task id="collectDataTask" name="Collect data and conduct business analysis regarding customer feedback">
      <incoming>sequenceFlow1</incoming>
      <outgoing>sequenceFlow2</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow1" sourceRef="startEvent" targetRef="collectDataTask"/>

    <task id="integrateDesignTask" name="Integrate design and decide where customer feedback module should be placed">
      <incoming>sequenceFlow2</incoming>
      <incoming>sequenceFlow10</incoming>
      <outgoing>sequenceFlow3</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow2" sourceRef="collectDataTask" targetRef="integrateDesignTask"/>

    <intermediateCatchEvent id="designCompleteEvent" name="Design complete">
      <incoming>sequenceFlow3</incoming>
      <outgoing>sequenceFlow4</outgoing>
      <messageEventDefinition/>
    </intermediateCatchEvent>

    <sequenceFlow id="sequenceFlow3" sourceRef="integrateDesignTask" targetRef="designCompleteEvent"/>

    <task id="checkDesignTask" name="Check design and provide feedback">
      <incoming>sequenceFlow4</incoming>
      <outgoing>sequenceFlow5</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow4" sourceRef="designCompleteEvent" targetRef="checkDesignTask"/>

    <exclusiveGateway id="adjustmentNeededGateway">
      <incoming>sequenceFlow5</incoming>
      <outgoing>sequenceFlow6</outgoing>
      <outgoing>sequenceFlow7</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequenceFlow5" sourceRef="checkDesignTask" targetRef="adjustmentNeededGateway"/>

    <task id="changeDesignTask" name="Change design">
      <incoming>sequenceFlow7</incoming>
      <outgoing>sequenceFlow10</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow7" sourceRef="adjustmentNeededGateway" targetRef="changeDesignTask"/>

    <sequenceFlow id="sequenceFlow6" name="Design OK" sourceRef="adjustmentNeededGateway" targetRef="integrateImplementationTask"/>

    <task id="integrateImplementationTask" name="Integrate with overall implementation">
      <incoming>sequenceFlow6</incoming>
      <incoming>sequenceFlow13</incoming>
      <outgoing>sequenceFlow8</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow8" sourceRef="integrateImplementationTask" targetRef="testWebsiteTask"/>

    <task id="testWebsiteTask" name="Test final website to make sure everything is going well">
      <incoming>sequenceFlow8</incoming>
      <outgoing>sequenceFlow9</outgoing>
    </task>

    <exclusiveGateway id="testResultGateway">
      <incoming>sequenceFlow9</incoming>
      <outgoing>sequenceFlow11</outgoing>
      <outgoing>sequenceFlow12</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequenceFlow9" sourceRef="testWebsiteTask" targetRef="testResultGateway"/>

    <endEvent id="processEnd">
      <incoming>sequenceFlow11</incoming>
    </endEvent>

    <sequenceFlow id="sequenceFlow11" name="Test OK" sourceRef="testResultGateway" targetRef="processEnd"/>

    <task id="provideTestResultsTask" name="Provide test results">
      <incoming>sequenceFlow12</incoming>
      <outgoing>sequenceFlow13</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow12" name="Not OK" sourceRef="testResultGateway" targetRef="provideTestResultsTask"/>

    <sequenceFlow id="sequenceFlow13" sourceRef="provideTestResultsTask" targetRef="integrateImplementationTask"/>
  </process>

</definitions>