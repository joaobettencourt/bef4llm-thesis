<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" targetNamespace="http://www.example.com">

  <process id="webDesignProcess" isExecutable="true">
    <startEvent id="informationalMeeting">
      <outgoing>meetingSuccessful</outgoing>
    </startEvent>

    <task id="informationalMeetingTask" name="Informational Meeting">
      <incoming>meetingSuccessful</incoming>
      <outgoing>meetingOutcome</outgoing>
    </task>

    <exclusiveGateway id="meetingOutcomeGateway">
      <incoming>meetingOutcome</incoming>
      <outgoing>yes</outgoing>
      <outgoing>no</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="meetingSuccessful" sourceRef="informationalMeeting" targetRef="informationalMeetingTask"/>
    <sequenceFlow id="meetingOutcome" sourceRef="informationalMeetingTask" targetRef="meetingOutcomeGateway"/>
    <sequenceFlow id="yes" name="yes" sourceRef="meetingOutcomeGateway" targetRef="createStoryboard"/>
    <sequenceFlow id="no" name="no" sourceRef="meetingOutcomeGateway" targetRef="endEvent1"/>

    <task id="createStoryboard" name="Create Storyboard">
      <incoming>yes</incoming>
      <outgoing>storyboardCreated</outgoing>
    </task>

    <sequenceFlow id="storyboardCreated" sourceRef="createStoryboard" targetRef="agreementGateway"/>

    <exclusiveGateway id="agreementGateway">
      <incoming>storyboardCreated</incoming>
      <outgoing>designAndDevelopment</outgoing>
      <outgoing>contentPreparation</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="designAndDevelopment" sourceRef="agreementGateway" targetRef="designTask"/>
    <sequenceFlow id="contentPreparation" sourceRef="agreementGateway" targetRef="contentDraftTask"/>

    <task id="designTask" name="Design and Development">
      <incoming>designAndDevelopment</incoming>
      <outgoing>designCompleted</outgoing>
    </task>

    <task id="contentDraftTask" name="Prepare Content Draft">
      <incoming>contentPreparation</incoming>
      <outgoing>draftCreated</outgoing>
    </task>

    <sequenceFlow id="draftCreated" sourceRef="contentDraftTask" targetRef="reviewNeededGateway"/>

    <exclusiveGateway id="reviewNeededGateway">
      <incoming>draftCreated</incoming>
      <outgoing>yesReview</outgoing>
      <outgoing>noReview</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="yesReview" name="yes" sourceRef="reviewNeededGateway" targetRef="marketingReviewTask"/>
    <sequenceFlow id="noReview" name="no" sourceRef="reviewNeededGateway" targetRef="finalContentVersionTask"/>

    <task id="marketingReviewTask" name="Marketing Review">
      <incoming>yesReview</incoming>
      <outgoing>reviewCompleted</outgoing>
    </task>

    <sequenceFlow id="reviewCompleted" sourceRef="marketingReviewTask" targetRef="finalContentVersionTask"/>

    <task id="finalContentVersionTask" name="Final Content Version">
      <incoming>noReview</incoming>
      <incoming>reviewCompleted</incoming>
      <outgoing>contentReady</outgoing>
    </task>

    <sequenceFlow id="contentReady" sourceRef="finalContentVersionTask" targetRef="buildAndReviewGateway"/>

    <parallelGateway id="buildAndReviewGateway">
      <incoming>designCompleted</incoming>
      <incoming>contentReady</incoming>
      <outgoing>siteBuilt</outgoing>
    </parallelGateway>

    <task id="buildSiteTask" name="Build and Review Site">
      <incoming>siteBuilt</incoming>
      <outgoing>approved</outgoing>
    </task>

    <sequenceFlow id="siteBuilt" sourceRef="buildAndReviewGateway" targetRef="buildSiteTask"/>

    <exclusiveGateway id="approvalGateway">
      <incoming>approved</incoming>
      <outgoing>yesApproved</outgoing>
      <outgoing>noApproved</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="approved" sourceRef="buildSiteTask" targetRef="approvalGateway"/>
    <sequenceFlow id="yesApproved" name="yes" sourceRef="approvalGateway" targetRef="endEvent2"/>
    <sequenceFlow id="noApproved" name="no" sourceRef="approvalGateway" targetRef="buildAndReviewGateway"/>

    <endEvent id="endEvent1" name="Process Is Over">
      <incoming>no</incoming>
    </endEvent>

    <endEvent id="endEvent2" name="Finished">
      <incoming>yesApproved</incoming>
    </endEvent>

  </process>

</definitions>