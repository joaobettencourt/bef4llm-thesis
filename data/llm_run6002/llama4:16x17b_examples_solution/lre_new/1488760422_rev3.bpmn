<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" targetNamespace="http://www.example.com">

    <process id="invoiceProcess" isExecutable="true">
        <startEvent id="receiveInvoice">
            <outgoing>sortByClientFlow</outgoing>
            <messageEventDefinition/>
        </startEvent>

        <task id="sortByClientTask" name="Sort by Client">
            <incoming>sortByClientFlow</incoming>
            <outgoing>sortByVendorFlow</outgoing>
        </task>

        <sequenceFlow id="sortByClientFlow" sourceRef="receiveInvoice" targetRef="sortByClientTask"/>

        <task id="sortByVendorTask" name="Sort by Vendor">
            <incoming>sortByVendorFlow</incoming>
            <outgoing>attachFormFlow</outgoing>
        </task>

        <sequenceFlow id="sortByVendorFlow" sourceRef="sortByClientTask" targetRef="sortByVendorTask"/>

        <task id="attachFormTask" name="Attach Invoice Entry Form">
            <incoming>attachFormFlow</incoming>
            <outgoing>enterInfoFlow</outgoing>
        </task>

        <sequenceFlow id="attachFormFlow" sourceRef="sortByVendorTask" targetRef="attachFormTask"/>

        <subProcess id="enterRequiredInfoSubProc" name="Enter Required Info">
            <incoming>enterInfoFlow</incoming>
            <outgoing>checkCompletenessFlow</outgoing>
        </subProcess>

        <sequenceFlow id="enterInfoFlow" sourceRef="attachFormTask" targetRef="enterRequiredInfoSubProc"/>

        <task id="checkCompletenessTask" name="Check Completeness">
            <incoming>checkCompletenessFlow</incoming>
            <outgoing>incompleteFlow</outgoing>
            <outgoing>completeFlow</outgoing>
        </task>

        <sequenceFlow id="checkCompletenessFlow" sourceRef="enterRequiredInfoSubProc" targetRef="checkCompletenessTask"/>

        <exclusiveGateway id="completenessCheckGW">
            <incoming>incompleteFlow</incoming>
            <outgoing>sendMessageFlow</outgoing>
            <outgoing>proceedFlow</outgoing>
        </exclusiveGateway>

        <sequenceFlow id="incompleteFlow" sourceRef="checkCompletenessTask" targetRef="completenessCheckGW"/>

        <task id="enterSLAInfoTask" name="Enter SLA Info">
            <incoming>completeFlow</incoming>
            <outgoing>checkPriorityFlow</outgoing>
        </task>

        <sequenceFlow id="completeFlow" sourceRef="checkCompletenessTask" targetRef="enterSLAInfoTask"/>

        <sequenceFlow id="proceedFlow" sourceRef="completenessCheckGW" targetRef="enterSLAInfoTask"/>

        <task id="checkPriorityTask" name="Check Priority">
            <incoming>checkPriorityFlow</incoming>
            <outgoing>highPriorityFlow</outgoing>
            <outgoing>lowPriorityFlow</outgoing>
        </task>

        <sequenceFlow id="checkPriorityFlow" sourceRef="enterSLAInfoTask" targetRef="checkPriorityTask"/>

        <task id="applyRedStampTask" name="Apply Red Stamp">
            <incoming>highPriorityFlow</incoming>
            <outgoing>checkComplianceFlow</outgoing>
        </task>

        <sequenceFlow id="highPriorityFlow" sourceRef="checkPriorityTask" targetRef="applyRedStampTask"/>

        <task id="checkComplianceTask2" name="Check Compliance">
            <incoming>checkComplianceFlow</incoming>
            <outgoing>compliantFlow</outgoing>
            <outgoing>nonCompliantFlow</outgoing>
        </task>

        <sequenceFlow id="checkComplianceFlow" sourceRef="applyRedStampTask" targetRef="checkComplianceTask2"/>

        <exclusiveGateway id="complianceCheckGW">
            <incoming>compliantFlow</incoming>
            <outgoing>sendToDEOFlow</outgoing>
            <outgoing>handleNonComplianceFlow</outgoing>
        </exclusiveGateway>

        <sequenceFlow id="compliantFlow" sourceRef="checkComplianceTask2" targetRef="complianceCheckGW"/>

        <task id="allocateToDEOTask" name="Allocate to DEO">
            <incoming>sendToDEOFlow</incoming>
            <outgoing>endEventFlow</outgoing>
        </task>

        <sequenceFlow id="sendToDEOFlow" sourceRef="complianceCheckGW" targetRef="allocateToDEOTask"/>

        <exclusiveGateway id="handleNonComplianceGW">
            <incoming>nonCompliantFlow</incoming>
            <outgoing>experienceStaffFlow</outgoing>
            <outgoing>callClientFlow</outgoing>
            <outgoing>sendPostalMailFlow</outgoing>
        </exclusiveGateway>

        <sequenceFlow id="nonCompliantFlow" sourceRef="checkComplianceTask2" targetRef="handleNonComplianceGW"/>

        <task id="processByExperienceStaffTask" name="Process by Experience Staff">
            <incoming>experienceStaffFlow</incoming>
            <outgoing>sendToDEOFlow</outgoing>
        </task>

        <sequenceFlow id="experienceStaffFlow" sourceRef="handleNonComplianceGW" targetRef="processByExperienceStaffTask"/>

        <endEvent id="endEvent">
            <incoming>endEventFlow</incoming>
        </endEvent>

    </process>

</definitions>