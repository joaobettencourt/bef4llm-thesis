<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/BPMN20.xsd"
             id="definitions" targetNamespace="http://bpmn.io/schema/bpmn">

  <process id="orderToCashProcess" isExecutable="true">
    <startEvent id="receiveOrder" name="Receive Order">
      <outgoing>sendToWarehouse</outgoing>
    </startEvent>

    <sequenceFlow id="sendToWarehouse" sourceRef="receiveOrder" targetRef="determineParts"/>

    <userTask id="determineParts" name="Determine parts required">
      <incoming>sendToWarehouse</incoming>
      <outgoing>orderParts</outgoing>
    </userTask>

    <exclusiveGateway id="partsAvailable" name="Are all parts available?">
      <incoming>orderParts</incoming>
      <outgoing>startProduction</outgoing>
      <outgoing>orderMissingParts</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="orderParts" sourceRef="determineParts" targetRef="partsAvailable"/>

    <userTask id="orderMissingParts" name="Order missing parts">
      <incoming>partsAvailable</incoming>
      <outgoing>waitForParts</outgoing>
    </userTask>

    <intermediateCatchEvent id="waitForParts" name="Wait for parts to arrive">
      <incoming>orderMissingParts</incoming>
      <outgoing>startProduction</outgoing>
    </intermediateCatchEvent>

    <sequenceFlow id="startProduction" sourceRef="partsAvailable" targetRef="production"/>
    <sequenceFlow id="startProduction2" sourceRef="waitForParts" targetRef="production"/>

    <userTask id="production" name="Perform production">
      <incoming>startProduction</incoming>
      <incoming>startProduction2</incoming>
      <outgoing>qualityChecks</outgoing>
    </userTask>

    <sequenceFlow id="qualityChecks" sourceRef="production" targetRef="performQualityChecks"/>

    <userTask id="performQualityChecks" name="Perform quality checks">
      <incoming>qualityChecks</incoming>
      <outgoing>packagingAndLabeling</outgoing>
    </userTask>

    <sequenceFlow id="packagingAndLabeling" sourceRef="performQualityChecks" targetRef="packageAndLabel"/>

    <userTask id="packageAndLabel" name="Package and label product">
      <incoming>packagingAndLabeling</incoming>
      <outgoing>informSales</outgoing>
    </userTask>

    <sequenceFlow id="informSales" sourceRef="packageAndLabel" targetRef="endEvent"/>

    <endEvent id="endEvent" name="Inform sales and complete process">
      <incoming>informSales</incoming>
    </endEvent>
  </process>
</definitions>