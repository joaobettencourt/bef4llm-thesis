<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com/bpmn">

  <process id="Process_1" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_0</outgoing>
    </startEvent>

    <task id="Task_0">
      <incoming>SequenceFlow_0</incoming>
      <outgoing>SequenceFlow_1</outgoing>
    </task>

    <exclusiveGateway id="ExclusiveGateway_0">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
      <outgoing>SequenceFlow_3</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow_0" sourceRef="StartEvent_1" targetRef="Task_0"/>
    <sequenceFlow id="SequenceFlow_1" sourceRef="Task_0" targetRef="ExclusiveGateway_0"/>
    <sequenceFlow id="SequenceFlow_2" name="yes" sourceRef="ExclusiveGateway_0" targetRef="Task_1"/>
    <sequenceFlow id="SequenceFlow_3" name="no" sourceRef="ExclusiveGateway_0" targetRef="Task_2"/>

    <task id="Task_1">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_4</outgoing>
    </task>

    <task id="Task_2">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_5</outgoing>
    </task>

    <inclusiveGateway id="InclusiveGateway_0">
      <incoming>SequenceFlow_4</incoming>
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </inclusiveGateway>

    <sequenceFlow id="SequenceFlow_4" sourceRef="Task_1" targetRef="InclusiveGateway_0"/>
    <sequenceFlow id="SequenceFlow_5" sourceRef="Task_2" targetRef="InclusiveGateway_0"/>
    <sequenceFlow id="SequenceFlow_6" sourceRef="InclusiveGateway_0" targetRef="EndEvent_1"/>

    <endEvent id="EndEvent_1">
      <incoming>SequenceFlow_6</incoming>
    </endEvent>

  </process>
</definitions>