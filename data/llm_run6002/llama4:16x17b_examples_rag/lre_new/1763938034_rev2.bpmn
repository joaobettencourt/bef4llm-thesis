<?xml version="1.0" encoding="UTF-8"?>
< bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
   <bpmn:process id="Process_1" isExecutable="false">
     <bpmn:startEvent id="StartEvent_1">
       <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
     </bpmn:startEvent>

     <bpmn:task id="Task_Check_Performance" name="Check employee performance">
       <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
     </bpmn:task>

     <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_Check_Performance"/>

     <bpmn:exclusiveGateway id="ExclusiveGateway_Performance">
       <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_LessThan20</bpmn:outgoing>
       <bpmn:outgoing>SequenceFlow_Between20And50</bpmn:outgoing>
       <bpmn:outgoing>SequenceFlow_GreaterThan75</bpmn:outgoing>
     </bpmn:exclusiveGateway>

     <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="Task_Check_Performance" targetRef="ExclusiveGateway_Performance"/>

     <bpmn:endEvent id="EndEvent_DismissalSuggested" name="Dismissal suggested to HR">
       <bpmn:incoming>SequenceFlow_LessThan20</bpmn:incoming>
     </bpmn:endEvent>

     <bpmn:sequenceFlow id="SequenceFlow_LessThan20" sourceRef="ExclusiveGateway_Performance" targetRef="EndEvent_DismissalSuggested"/>

     <bpmn:task id="Task_SuggestTraining" name="Suggest training to HR">
       <bpmn:incoming>SequenceFlow_Between20And50</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
     </bpmn:task>

     <bpmn:sequenceFlow id="SequenceFlow_Between20And50" sourceRef="ExclusiveGateway_Performance" targetRef="Task_SuggestTraining"/>

     <bpmn:endEvent id="EndEvent_TrainingProvided" name="Training provided">
       <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
     </bpmn:endEvent>

     <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="Task_SuggestTraining" targetRef="EndEvent_TrainingProvided"/>

     <bpmn:task id="Task_SuggestReward" name="Suggest reward to management">
       <bpmn:incoming>SequenceFlow_GreaterThan75</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
     </bpmn:task>

     <bpmn:sequenceFlow id="SequenceFlow_GreaterThan75" sourceRef="ExclusiveGateway_Performance" targetRef="Task_SuggestReward"/>

     <bpmn:endEvent id="EndEvent_EmployeeOfTheMonth">
       <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
     </bpmn:endEvent>

     <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="Task_SuggestReward" targetRef="EndEvent_EmployeeOfTheMonth"/>
   </bpmn:process>
</bpmn:definitions>