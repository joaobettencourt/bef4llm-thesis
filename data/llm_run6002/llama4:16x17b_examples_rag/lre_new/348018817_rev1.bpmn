<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com/bpmn">
  <process id="expenseReportProcess" isExecutable="true">
    <startEvent id="startEvent">
      <outgoing>sequenceFlow1</outgoing>
    </startEvent>

    <sequenceFlow id="sequenceFlow1" sourceRef="startEvent" targetRef="exclusiveGateway1"/>

    <exclusiveGateway id="exclusiveGateway1">
      <incoming>sequenceFlow1</incoming>
      <outgoing>sequenceFlow2</outgoing>
      <outgoing>sequenceFlow3</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequenceFlow2" sourceRef="exclusiveGateway1" targetRef="task1"/>
    <sequenceFlow id="sequenceFlow3" sourceRef="exclusiveGateway1" targetRef="intermediateTimerEvent1"/>

    <task id="task1" name="Check if employee has an account">
      <incoming>sequenceFlow2</incoming>
      <outgoing>sequenceFlow4</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow4" sourceRef="task1" targetRef="exclusiveGateway2"/>

    <intermediateTimerEvent id="intermediateTimerEvent1" name="28 days timer">
      <incoming>sequenceFlow3</incoming>
      <outgoing>sequenceFlow5</outgoing>
    </intermediateTimerEvent>

    <sequenceFlow id="sequenceFlow5" sourceRef="intermediateTimerEvent1" targetRef="task2"/>

    <task id="task2" name="Send resubmit email to employee">
      <incoming>sequenceFlow5</incoming>
      <outgoing>sequenceFlow6</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow6" sourceRef="task2" targetRef="endEvent1"/>

    <exclusiveGateway id="exclusiveGateway2">
      <incoming>sequenceFlow4</incoming>
      <outgoing>sequenceFlow7</outgoing>
      <outgoing>sequenceFlow8</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequenceFlow7" sourceRef="exclusiveGateway2" targetRef="task3"/>
    <sequenceFlow id="sequenceFlow8" sourceRef="exclusiveGateway2" targetRef="intermediateTimerEvent2"/>

    <task id="task3" name="Create account for employee and Review report">
      <incoming>sequenceFlow7</incoming>
      <outgoing>sequenceFlow9</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow9" sourceRef="task3" targetRef="exclusiveGateway3"/>

    <intermediateTimerEvent id="intermediateTimerEvent2" name="Supervisor approval in progress">
      <incoming>sequenceFlow8</incoming>
      <outgoing>sequenceFlow10</outgoing>
    </intermediateTimerEvent>

    <sequenceFlow id="sequenceFlow10" sourceRef="intermediateTimerEvent2" targetRef="task5"/>

    <exclusiveGateway id="exclusiveGateway3">
      <incoming>sequenceFlow9</incoming>
      <outgoing>sequenceFlow11</outgoing>
      <outgoing>sequenceFlow12</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequenceFlow11" sourceRef="exclusiveGateway3" targetRef="task4"/>
    <sequenceFlow id="sequenceFlow12" sourceRef="exclusiveGateway3" targetRef="userTask1"/>

    <task id="task4" name="Reimburse employee (amount <= 200)">
      <incoming>sequenceFlow11</incoming>
      <outgoing>sequenceFlow13</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow13" sourceRef="task4" targetRef="endEvent1"/>

    <userTask id="userTask1" name="Request supervisor approval (amount > 200)">
      <incoming>sequenceFlow12</incoming>
      <outgoing>sequenceFlow14</outgoing>
      <outgoing>sequenceFlow15</outgoing>
    </userTask>

    <sequenceFlow id="sequenceFlow14" sourceRef="userTask1" targetRef="exclusiveGateway4"/>
    <sequenceFlow id="sequenceFlow15" sourceRef="userTask1" targetRef="intermediateTimerEvent3"/>

    <exclusiveGateway id="exclusiveGateway4">
      <incoming>sequenceFlow14</incoming>
      <outgoing>sequenceFlow16</outgoing>
      <outgoing>sequenceFlow17</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequenceFlow16" sourceRef="exclusiveGateway4" targetRef="task6"/>
    <sequenceFlow id="sequenceFlow17" sourceRef="exclusiveGateway4" targetRef="task7"/>

    <intermediateTimerEvent id="intermediateTimerEvent3" name="7 days timer for supervisor approval">
      <incoming>sequenceFlow15</incoming>
      <outgoing>sequenceFlow18</outgoing>
    </intermediateTimerEvent>

    <sequenceFlow id="sequenceFlow18" sourceRef="intermediateTimerEvent3" targetRef="task5"/>

    <task id="task5" name="Send notification to employee (approval in progress)">
      <incoming>sequenceFlow10</incoming>
      <incoming>sequenceFlow18</incoming>
      <outgoing>sequenceFlow19</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow19" sourceRef="task5" targetRef="userTask1"/>

    <task id="task6" name="Reimburse employee after supervisor approval">
      <incoming>sequenceFlow16</incoming>
      <outgoing>sequenceFlow20</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow20" sourceRef="task6" targetRef="endEvent1"/>

    <task id="task7" name="Send rejection email to employee">
      <incoming>sequenceFlow17</incoming>
      <outgoing>sequenceFlow21</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow21" sourceRef="task7" targetRef="endEvent1"/>

    <exclusiveGateway id="exclusiveGateway5">
      <incoming>sequenceFlow20</incoming>
      <incoming>sequenceFlow13</incoming>
      <incoming>sequenceFlow21</incoming>
    </exclusiveGateway>

    <endEvent id="endEvent1">
      <incoming>sequenceFlow6</incoming>
      <incoming>sequenceFlow20</incoming>
      <incoming>sequenceFlow13</incoming>
      <incoming>sequenceFlow21</incoming>
    </endEvent>
  </process>
</definitions>