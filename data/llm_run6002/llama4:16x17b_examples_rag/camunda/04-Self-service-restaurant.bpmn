<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com/bpmn">
    <collaboration id="collaboration">
        <participant id="guest" name="Guest"/>
        <participant id="employee" name="Employee" processRef="process"/>
    </collaboration>
    <process id="process" isExecutable="true">
        <laneSet>
            <lane id="logistics_lane" name="Logistics">
                <flowNodeRef>task_place_order</flowNodeRef>
                <flowNodeRef>task_pay_and_buzzer</flowNodeRef>
                <flowNodeRef>exclusive_gateway_call_guest</flowNodeRef>
                <flowNodeRef>end_event_meal_handovered</flowNodeRef>
            </lane>
            <lane id="chef_lane" name="Chef">
                <flowNodeRef>task_prepare_dish</flowNodeRef>
            </lane>
        </laneSet>

        <startEvent id="start_event_guest_enters">
            <outgoing>sequence_flow_to_choose_dish</outgoing>
        </startEvent>

        <task id="task_choose_dish">
            <incoming>sequence_flow_to_choose_dish</incoming>
            <outgoing>sequence_flow_to_place_order</outgoing>
        </task>

        <sequenceFlow id="sequence_flow_to_choose_dish" sourceRef="start_event_guest_enters" targetRef="task_choose_dish"/>

        <userTask id="task_place_order">
            <incoming>sequence_flow_to_place_order</incoming>
            <outgoing>sequence_flow_to_pay_and_buzzer</outgoing>
        </userTask>

        <sequenceFlow id="sequence_flow_to_place_order" sourceRef="task_choose_dish" targetRef="task_place_order"/>

        <serviceTask id="task_pay_and_buzzer">
            <incoming>sequence_flow_to_pay_and_buzzer</incoming>
            <outgoing>sequence_flow_to_inform_chef</outgoing>
        </serviceTask>

        <sequenceFlow id="sequence_flow_to_pay_and_buzzer" sourceRef="task_place_order" targetRef="task_pay_and_buzzer"/>

        <userTask id="task_prepare_dish">
            <incoming>sequence_flow_to_inform_chef</incoming>
            <outgoing>sequence_flow_to_finish_preparation</outgoing>
        </userTask>

        <sequenceFlow id="sequence_flow_to_inform_chef" sourceRef="task_pay_and_buzzer" targetRef="task_prepare_dish"/>

        <endEvent id="message_event_finished">
            <incoming>sequence_flow_to_finish_preparation</incoming>
            <outgoing>sequence_flow_to_ring_buzzer</outgoing>
        </endEvent>

        <sequenceFlow id="sequence_flow_to_finish_preparation" sourceRef="task_prepare_dish" targetRef="message_event_finished"/>

        <userTask id="task_ring_buzzer">
            <incoming>sequence_flow_to_ring_buzzer</incoming>
            <outgoing>sequence_flow_to_call_guest_if_necessary</outgoing>
        </userTask>

        <sequenceFlow id="sequence_flow_to_ring_buzzer" sourceRef="message_event_finished" targetRef="task_ring_buzzer"/>

        <exclusiveGateway id="exclusive_gateway_call_guest">
            <incoming>sequence_flow_to_call_guest_if_necessary</incoming>
            <outgoing>sequence_flow_to_end_event</outgoing>
            <outgoing>sequence_flow_to_wait_and_call_again</outgoing>
        </exclusiveGateway>

        <sequenceFlow id="sequence_flow_to_call_guest_if_necessary" sourceRef="task_ring_buzzer" targetRef="exclusive_gateway_call_guest"/>

        <userTask id="task_wait_and_call_again">
            <incoming>sequence_flow_to_wait_and_call_again</incoming>
            <outgoing>sequence_flow_to_end_event</outgoing>
        </userTask>

        <sequenceFlow id="sequence_flow_to_wait_and_call_again" sourceRef="exclusive_gateway_call_guest" targetRef="task_wait_and_call_again"/>

        <endEvent id="end_event_meal_handovered">
            <incoming>sequence_flow_to_end_event</incoming>
        </endEvent>

        <sequenceFlow id="sequence_flow_to_end_event" sourceRef="task_wait_and_call_again" targetRef="end_event_meal_handovered"/>
        <sequenceFlow id="sequence_flow_to_end_event2" sourceRef="exclusive_gateway_call_guest" targetRef="end_event_meal_handovered"/>

    </process>
</definitions>