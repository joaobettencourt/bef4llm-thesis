<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Restaurant Process" targetNamespace="http://example.com/bpmn">

    <process id="restaurantProcess" isExecutable="true">
        <laneSet>
            <lane id="guestLane" name="Gast">
                <flowNodeRef>StartEvent_1</flowNodeRef>
                <flowNodeRef>Task_GetFood</flowNodeRef>
                <flowNodeRef>EndEvent_FoodConsumed</flowNodeRef>
            </lane>
            <lane id="staffLane" name="Angestellte( r )">
                <flowNodeRef>Task_TakeOrder_1</flowNodeRef>
                <flowNodeRef>Task_PayAndInform_1</flowNodeRef>
                <flowNodeRef>Task_InformCook_1</flowNodeRef>
                <flowNodeRef>ExclusiveGateway_CheckPieper_1</flowNodeRef>
            </lane>
            <lane id="cookLane" name="Koch">
                <flowNodeRef>Task_PrepareFood_1</flowNodeRef>
            </lane>
        </laneSet>

        <startEvent id="StartEvent_1" name="Gast betritt Restaurant">
            <outgoing>SequenceFlow_ToOrder_1</outgoing>
        </startEvent>

        <sequenceFlow id="SequenceFlow_ToOrder_1" sourceRef="StartEvent_1" targetRef="Task_TakeOrder_1"/>

        <task id="Task_TakeOrder_1" name="Bestellung aufnehmen">
            <incoming>SequenceFlow_ToOrder_1</incoming>
            <outgoing>SequenceFlow_ToPayAndInform_1</outgoing>
        </task>

        <sequenceFlow id="SequenceFlow_ToPayAndInform_1" sourceRef="Task_TakeOrder_1" targetRef="Task_PayAndInform_1"/>

        <task id="Task_PayAndInform_1" name="Bezahlung und Information">
            <incoming>SequenceFlow_ToPayAndInform_1</incoming>
            <outgoing>SequenceFlow_ToInformCook_1</outgoing>
        </task>

        <sequenceFlow id="SequenceFlow_ToInformCook_1" sourceRef="Task_PayAndInform_1" targetRef="Task_InformCook_1"/>

        <task id="Task_InformCook_1" name="Koch informieren">
            <incoming>SequenceFlow_ToInformCook_1</incoming>
            <outgoing>SequenceFlow_ToPrepareFood_1</outgoing>
        </task>

        <sequenceFlow id="SequenceFlow_ToPrepareFood_1" sourceRef="Task_InformCook_1" targetRef="Task_PrepareFood_1"/>

        <task id="Task_PrepareFood_1" name="Essen zubereiten">
            <incoming>SequenceFlow_ToPrepareFood_1</incoming>
            <outgoing>SequenceFlow_FoodPrepared_1</outgoing>
        </task>

        <sequenceFlow id="SequenceFlow_FoodPrepared_1" sourceRef="Task_PrepareFood_1" targetRef="Task_ServeFood_1"/>

        <task id="Task_ServeFood_1" name="Essen servieren">
            <incoming>SequenceFlow_FoodPrepared_1</incoming>
            <outgoing>SequenceFlow_ToGetFood_1</outgoing>
        </task>

        <sequenceFlow id="SequenceFlow_ToGetFood_1" sourceRef="Task_ServeFood_1" targetRef="Task_GetFood_1"/>

        <task id="Task_GetFood_1" name="Essen abholen">
            <incoming>SequenceFlow_ToGetFood_1</incoming>
            <outgoing>SequenceFlow_FoodConsumed_1</outgoing>
        </task>

        <endEvent id="EndEvent_FoodConsumed_1" name="Essen verzehren">
            <incoming>SequenceFlow_FoodConsumed_1</incoming>
        </endEvent>

        <sequenceFlow id="SequenceFlow_FoodConsumed_1" sourceRef="Task_GetFood_1" targetRef="EndEvent_FoodConsumed_1"/>

    </process>
</definitions>