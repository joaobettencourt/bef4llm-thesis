<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">

  <process id="prozess" isExecutable="true">
    <startEvent id="startEvent">
      <outgoing>sequenceFlow1</outgoing>
    </startEvent>

    <sequenceFlow id="sequenceFlow1" sourceRef="startEvent" targetRef="task1"/>

    <task id="task1" name="Prüfen ob Regress möglich"/>
    <sequenceFlow id="sequenceFlow2" sourceRef="task1" targetRef="exclusiveGateway1">
      <conditionExpression xsi:type="tFormalExpression">Regress möglich</conditionExpression>
    </sequenceFlow>

    <exclusiveGateway id="exclusiveGateway1">
      <incoming>sequenceFlow2</incoming>
      <outgoing>sequenceFlow3</outgoing>
      <outgoing>sequenceFlow4</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequenceFlow3" sourceRef="exclusiveGateway1" targetRef="task2">
      <conditionExpression xsi:type="tFormalExpression">ja</conditionExpression>
    </sequenceFlow>

    <task id="task2" name="Zahlungsaufforderung an VN"/>
    <sequenceFlow id="sequenceFlow5" sourceRef="task2" targetRef="serviceTask1"/>

    <serviceTask id="serviceTask1" name="Setzen auf Wiedervorlage"/>
    <sequenceFlow id="sequenceFlow6" sourceRef="serviceTask1" targetRef="exclusiveGateway2"/>

    <exclusiveGateway id="exclusiveGateway2">
      <incoming>sequenceFlow6</incoming>
      <outgoing>sequenceFlow7</outgoing>
      <outgoing>sequenceFlow8</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequenceFlow7" sourceRef="exclusiveGateway2" targetRef="endEvent1">
      <conditionExpression xsi:type="tFormalExpression">Geldeingang</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="sequenceFlow8" sourceRef="exclusiveGateway2" targetRef="task3">
      <conditionExpression xsi:type="tFormalExpression">Widerspruch VN</conditionExpression>
    </sequenceFlow>

    <task id="task3" name="Prüfen Widerspruch"/>
    <sequenceFlow id="sequenceFlow9" sourceRef="task3" targetRef="exclusiveGateway3"/>

    <exclusiveGateway id="exclusiveGateway3">
      <incoming>sequenceFlow9</incoming>
      <outgoing>sequenceFlow10</outgoing>
      <outgoing>sequenceFlow11</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequenceFlow10" sourceRef="exclusiveGateway3" targetRef="endEvent1">
      <conditionExpression xsi:type="tFormalExpression">gerechtfertigter Widerspruch</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="sequenceFlow11" sourceRef="exclusiveGateway3" targetRef="serviceTask2">
      <conditionExpression xsi:type="tFormalExpression">ungerechtfertigter Widerspruch</conditionExpression>
    </sequenceFlow>

    <serviceTask id="serviceTask2" name="Inkasso Dienstleister"/>
    <sequenceFlow id="sequenceFlow12" sourceRef="serviceTask2" targetRef="endEvent1"/>

    <sequenceFlow id="sequenceFlow4" sourceRef="exclusiveGateway1" targetRef="endEvent1">
      <conditionExpression xsi:type="tFormalExpression">nein</conditionExpression>
    </sequenceFlow>

    <endEvent id="endEvent1" name="Ende"/>
  </process>
</definitions>