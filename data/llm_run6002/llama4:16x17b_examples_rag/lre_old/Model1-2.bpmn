<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" 
             targetNamespace="http://bpmn.io/schema/bpmn">
    <process id="RepairProcess" isExecutable="true">
      <startEvent id="StartEvent_1">
        <outgoing>SequenceFlow_1</outgoing>
      </startEvent>
      <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_CheckDefect"/>
     
      <task id="Task_CheckDefect" name="Check Defect and Calculate Repair Cost">
        <incoming>SequenceFlow_1</incoming>
        <outgoing>SequenceFlow_2</outgoing>
      </task>
      <sequenceFlow id="SequenceFlow_2" sourceRef="Task_CheckDefect" targetRef="ExclusiveGateway_1"/>
     
      <exclusiveGateway id="ExclusiveGateway_1">
        <incoming>SequenceFlow_2</incoming>
        <outgoing>SequenceFlow_3</outgoing>
        <outgoing>SequenceFlow_4</outgoing>
      </exclusiveGateway>
     
      <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_1" targetRef="ParallelGateway_1">
        <conditionExpression xsi:type="tFormalExpression">${costsAcceptable == true}</conditionExpression>
      </sequenceFlow>
      <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_CustomerLeaves">
        <conditionExpression xsi:type="tFormalExpression">${costsAcceptable == false}</conditionExpression>
      </sequenceFlow>
     
      <parallelGateway id="ParallelGateway_1">
        <incoming>SequenceFlow_3</incoming>
        <outgoing>SequenceFlow_5</outgoing>
        <outgoing>SequenceFlow_6</outgoing>
      </parallelGateway>
     
      <task id="Task_HardwareRepair" name="Check and Repair Hardware">
        <incoming>SequenceFlow_5</incoming>
        <outgoing>SequenceFlow_7</outgoing>
      </task>
      <sequenceFlow id="SequenceFlow_5" sourceRef="ParallelGateway_1" targetRef="Task_HardwareRepair"/>
     
      <task id="Task_SoftwareRepair" name="Check and Configure Software">
        <incoming>SequenceFlow_6</incoming>
        <outgoing>SequenceFlow_8</outgoing>
      </task>
      <sequenceFlow id="SequenceFlow_6" sourceRef="ParallelGateway_1" targetRef="Task_SoftwareRepair"/>
     
      <exclusiveGateway id="ExclusiveGateway_2">
        <incoming>SequenceFlow_7</incoming>
        <outgoing>SequenceFlow_9</outgoing>
        <outgoing>SequenceFlow_10</outgoing>
      </exclusiveGateway>
      <sequenceFlow id="SequenceFlow_7" sourceRef="Task_HardwareRepair" targetRef="ExclusiveGateway_2"/>
     
      <exclusiveGateway id="ExclusiveGateway_3">
        <incoming>SequenceFlow_8</incoming>
        <outgoing>SequenceFlow_11</outgoing>
        <outgoing>SequenceFlow_12</outgoing>
      </exclusiveGateway>
      <sequenceFlow id="SequenceFlow_8" sourceRef="Task_SoftwareRepair" targetRef="ExclusiveGateway_3"/>
     
      <sequenceFlow id="SequenceFlow_9" sourceRef="ExclusiveGateway_2" targetRef="ParallelGateway_1">
        <conditionExpression xsi:type="tFormalExpression">${errorFound == true}</conditionExpression>
      </sequenceFlow>
      <sequenceFlow id="SequenceFlow_10" sourceRef="ExclusiveGateway_2" targetRef="EndEvent_RepairFinished">
        <conditionExpression xsi:type="tFormalExpression">${errorFound == false}</conditionExpression>
      </sequenceFlow>
     
      <sequenceFlow id="SequenceFlow_11" sourceRef="ExclusiveGateway_3" targetRef="ParallelGateway_1">
        <conditionExpression xsi:type="tFormalExpression">${errorFound == true}</conditionExpression>
      </sequenceFlow>
      <sequenceFlow id="SequenceFlow_12" sourceRef="ExclusiveGateway_3" targetRef="EndEvent_RepairFinished">
        <conditionExpression xsi:type="tFormalExpression">${errorFound == false}</conditionExpression>
      </sequenceFlow>
     
      <endEvent id="EndEvent_CustomerLeaves">
        <incoming>SequenceFlow_4</incoming>
      </endEvent>
      <endEvent id="EndEvent_RepairFinished">
        <incoming>SequenceFlow_10</incoming>
        <incoming>SequenceFlow_12</incoming>
      </endEvent>
    </process>
</definitions>