<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="BPMN Process Model" targetNamespace="http://example.com/bpmn">
   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>
     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="ExclusiveGateway_1"/>
     <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
      <outgoing>SequenceFlow_3</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_2" sourceRef="ExclusiveGateway_1" targetRef="Task_1">
       <conditionExpression xsi:type="tFormalExpression">${membershipType  ==  'individual'}</conditionExpression>
     </sequenceFlow>
     <task id="Task_1" name="Prepare Personal Information">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_4</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_4" sourceRef="Task_1" targetRef="SubmitInfoToZooClubDepartment"/>
     <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_1" targetRef="Task_2">
       <conditionExpression xsi:type="tFormalExpression">${membershipType  ==  'family'}</conditionExpression>
     </sequenceFlow>
     <task id="Task_2" name="Prepare Family Information">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_2" targetRef="SubmitInfoToZooClubDepartment"/>
     <task id="SubmitInfoToZooClubDepartment" name="Submit Information to ZooClub Department">
       <incoming>SequenceFlow_4</incoming>
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_6" sourceRef="SubmitInfoToZooClubDepartment" targetRef="ServiceTask_1"/>
     <serviceTask id="ServiceTask_1" name="Send Info to ZooClub, Billing and Marketing Departments">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_7</outgoing>
     </serviceTask>
     <sequenceFlow id="SequenceFlow_7" sourceRef="ServiceTask_1" targetRef="UserTask_1"/>
     <userTask id="UserTask_1" name="Process Payment Information">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_8</outgoing>
     </userTask>
     <sequenceFlow id="SequenceFlow_8" sourceRef="UserTask_1" targetRef="PrintAndDeliverCard"/>
     <task id="PrintAndDeliverCard" name="Print and Deliver Card to Visitor">
       <incoming>SequenceFlow_8</incoming>
     </task>
     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_9</incoming>
     </endEvent>
     <sequenceFlow id="SequenceFlow_9" sourceRef="PrintAndDeliverCard" targetRef="EndEvent_1"/>
   </process>
 </definitions>