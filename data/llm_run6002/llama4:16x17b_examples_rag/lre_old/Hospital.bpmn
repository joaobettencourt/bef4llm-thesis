<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="BPMN Process Model">
  <process id="ExaminationProcess" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_OutpatientPhysicianExaminesPatient"/>
    <task id="Task_OutpatientPhysicianExaminesPatient" name="Outpatient Physician Examines Patient">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
      <outgoing>SequenceFlow_3</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_OutpatientPhysicianExaminesPatient" targetRef="EndEvent_Healthy">
      <conditionExpression xsi:type="tFormalExpression">${patientIsHealthy == true}</conditionExpression>
    </sequenceFlow>
    <endEvent id="EndEvent_Healthy">
      <incoming>SequenceFlow_2</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_3" sourceRef="Task_OutpatientPhysicianExaminesPatient" targetRef="Task_AdditionalExaminationNeeded"/>
    <task id="Task_AdditionalExaminationNeeded" name="Additional Examination Needed">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_4</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_4" sourceRef="Task_AdditionalExaminationNeeded" targetRef="Task_RequestFormFilledOut"/>
    <task id="Task_RequestFormFilledOut" name="Request Form Filled Out">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_5</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_5" sourceRef="Task_RequestFormFilledOut" targetRef="Task_PatientSignsInformedConsent"/>
    <task id="Task_PatientSignsInformedConsent" name="Patient Signs Informed Consent">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_6" sourceRef="Task_PatientSignsInformedConsent" targetRef="Task_AppointmentArranged"/>
    <task id="Task_AppointmentArranged" name="Appointment Arranged">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_7" sourceRef="Task_AppointmentArranged" targetRef="Task_SampleTaken"/>
    <task id="Task_SampleTaken" name="Sample Taken">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_8" sourceRef="Task_SampleTaken" targetRef="Task_LabPhysicianValidatesSample"/>
    <task id="Task_LabPhysicianValidatesSample" name="Lab Physician Validates Sample">
      <incoming>SequenceFlow_8</incoming>
      <outgoing>SequenceFlow_9</outgoing>
      <outgoing>SequenceFlow_10</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_9" sourceRef="Task_LabPhysicianValidatesSample" targetRef="Task_MedicalTechnicalAssistantAnalyzesSample">
      <conditionExpression xsi:type="tFormalExpression">${sampleIsValid == true}</conditionExpression>
    </sequenceFlow>
    <task id="Task_MedicalTechnicalAssistantAnalyzesSample" name="Medical Technical Assistant Analyzes Sample">
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_11</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_10" sourceRef="Task_LabPhysicianValidatesSample" targetRef="EndEvent_NewSampleRequired">
      <conditionExpression xsi:type="tFormalExpression">${sampleIsValid == false}</conditionExpression>
    </sequenceFlow>
    <endEvent id="EndEvent_NewSampleRequired">
      <incoming>SequenceFlow_10</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_11" sourceRef="Task_MedicalTechnicalAssistantAnalyzesSample" targetRef="Task_LabPhysicianValidatesResults"/>
    <task id="Task_LabPhysicianValidatesResults" name="Lab Physician Validates Results">
      <incoming>SequenceFlow_11</incoming>
      <outgoing>SequenceFlow_12</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_12" sourceRef="Task_LabPhysicianValidatesResults" targetRef="EndEvent_DiagnosisMade"/>
    <endEvent id="EndEvent_DiagnosisMade">
      <incoming>SequenceFlow_12</incoming>
    </endEvent>
  </process>
</definitions>