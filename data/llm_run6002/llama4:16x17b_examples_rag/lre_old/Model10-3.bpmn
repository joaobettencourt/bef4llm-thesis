<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org//spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/ spec/BPMN/20100524/MODEL http://www.omg.org/ spec/BPMN/20100524/06-02-01.xsd"
             id="definition" 
             targetNamespace="http://bpmn. io/ schema/bpmn">
   <collaboration id="Collaboration_1">
     <participant id="Participant_0" name="MPOO" processRef="Pool_0"/>
     <participant id="Participant_1" name="GO" processRef="Pool_1"/>
   </collaboration>
   <process id="Pool_0" isExecutable="true">
     <laneSet>
       <lane id="Lane_0" name="">
         <flowNodeRef>StartNoneEvent_0</flowNodeRef>
         <flowNodeRef>Task_0</flowNodeRef>
         <flowNodeRef>EndNoneEvent_0</flowNodeRef>
       </lane>
     </laneSet>
     <sequenceFlow id="SequenceFlow_0" sourceRef="StartNoneEvent_0" targetRef="Task_0"/>
     <startEvent name="" id="StartNoneEvent_0">
       <outgoing>SequenceFlow_0</outgoing>
     </startEvent>
     <task name="Deregister" id="Task_0">
       <incoming>SequenceFlow_0</incoming>
       <outgoing>SequenceFlow_1</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_1" sourceRef="Task_0" targetRef="IntermediateMessageEventThrowing_0"/>
     <intermediateThrowEvent name="" id="IntermediateMessageEventThrowing_0">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </intermediateThrowEvent>
     <sequenceFlow id="SequenceFlow_2" sourceRef="IntermediateMessageEventThrowing_0" targetRef="EndNoneEvent_0"/>
     <endEvent name="" id="EndNoneEvent_0">
       <incoming>SequenceFlow_2</incoming>
     </endEvent>
   </process>
   <process id="Pool_1" isExecutable="true">
     <laneSet>
       <lane id="Lane_1" name="">
         <flowNodeRef>StartMessageEvent_0</flowNodeRef>
         <flowNodeRef>ExclusiveGateway_0</flowNodeRef>
         <flowNodeRef>Task_1</flowNodeRef>
         <flowNodeRef>Task_2</flowNodeRef>
         <flowNodeRef>Task_3</flowNodeRef>
         <flowNodeRef>Task_4</flowNodeRef>
         <flowNodeRef>Task_5</flowNodeRef>
         <flowNodeRef>EndNoneEvent_1</flowNodeRef>
       </lane>
     </laneSet>
     <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_0" targetRef="Task_1"/>
     <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_0" targetRef="Task_2"/>
     <startEvent name="" id="StartMessageEvent_0">
       <outgoing>SequenceFlow_10</outgoing>
     </startEvent>
     <sequenceFlow id="SequenceFlow_10" sourceRef="StartMessageEvent_0" targetRef="ExclusiveGateway_0"/>
     <exclusiveGateway name="" id="ExclusiveGateway_0">
       <incoming>SequenceFlow_10</incoming>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_4</outgoing>
     </exclusiveGateway>
     <task name="Reject deregistration" id="Task_1">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_1" targetRef="EndNoneEvent_1"/>
     <endEvent name="" id="EndNoneEvent_1">
       <incoming>SequenceFlow_6</incoming>
     </endEvent>
     <task name="Preliminarily confirm deregistration" id="Task_2">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_7</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_7" sourceRef="Task_2" targetRef="Task_3"/>
     <task name="Prepare readmission of measuring point" id="Task_3">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_8</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_8" sourceRef="Task_3" targetRef="ExclusiveGateway_1"/>
     <exclusiveGateway name="" id="ExclusiveGateway_1">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_9</outgoing>
       <outgoing>SequenceFlow_11</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_9" sourceRef="ExclusiveGateway_1" targetRef="Task_4"/>
     <task name="Oblige MPOO to continue operation" id="Task_4">
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_12</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_12" sourceRef="Task_4" targetRef="EndNoneEvent_2"/>
     <endEvent name="" id="EndNoneEvent_2">
       <incoming>SequenceFlow_12</incoming>
     </endEvent>
     <sequenceFlow id="SequenceFlow_11" sourceRef="ExclusiveGateway_1" targetRef="Task_5"/>
     <task name="Confirm continuation of operation by MPOO" id="Task_5">
       <incoming>SequenceFlow_11</incoming>
       <outgoing>SequenceFlow_13</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_13" sourceRef="Task_5" targetRef="EndNoneEvent_3"/>
     <endEvent name="" id="EndNoneEvent_3">
       <incoming>SequenceFlow_13</incoming>
     </endEvent>
   </process>
</definitions>