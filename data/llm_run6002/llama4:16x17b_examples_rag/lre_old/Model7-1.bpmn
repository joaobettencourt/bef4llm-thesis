<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="BPMN Process Model" targetNamespace="http://bpmn.io/schema/bpmn">
   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>
     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_Manager_Checks_Open_Leads"/>
     <task id="Task_Manager_Checks_Open_Leads" name="Check Open Leads">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_Manager_Checks_Open_Leads" targetRef="ExclusiveGateway_Select_Top_Five_Leads"/>
     <exclusiveGateway id="ExclusiveGateway_Select_Top_Five_Leads">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_Select_Top_Five_Leads" targetRef="Task_Sales_Assistant_Calls_Customers"/>
     <task id="Task_Sales_Assistant_Calls_Customers" name="Call Customers">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_4</outgoing>
       <outgoing>SequenceFlow_5</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_4" sourceRef="Task_Sales_Assistant_Calls_Customers" targetRef="ExclusiveGateway_Check_If_Customer_Is_Interested"/>
     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_Sales_Assistant_Calls_Customers" targetRef="EndEvent_Call_Next_Customer"/>
     <exclusiveGateway id="ExclusiveGateway_Check_If_Customer_Is_Interested">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_6</outgoing>
       <outgoing>SequenceFlow_7</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_6" sourceRef="ExclusiveGateway_Check_If_Customer_Is_Interested" targetRef="Task_Manager_Processes_Lead"/>
     <task id="Task_Manager_Processes_Lead" name="Process Lead">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_8</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_7" sourceRef="ExclusiveGateway_Check_If_Customer_Is_Interested" targetRef="Task_Sales_Assistant_Calls_Customers"/>
     <sequenceFlow id="SequenceFlow_8" sourceRef="Task_Manager_Processes_Lead" targetRef="EndEvent_Process_Complete"/>
     <endEvent id="EndEvent_Call_Next_Customer">
       <incoming>SequenceFlow_5</incoming>
     </endEvent>
     <endEvent id="EndEvent_Process_Complete">
       <incoming>SequenceFlow_8</incoming>
     </endEvent>
   </process>
 </definitions>