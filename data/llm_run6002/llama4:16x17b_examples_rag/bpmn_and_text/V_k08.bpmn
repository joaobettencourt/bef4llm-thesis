<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/BPMN20.xsd"
             id="definitions" name="Ordering in an Online Shop"
             targetNamespace="http://example.com/bpmn">

    <process id="onlineShopProcess" isExecutable="true">
        <startEvent id="loginStartEvent">
            <outgoing>sequenceFlow1</outgoing>
        </startEvent>

        <sequenceFlow id="sequenceFlow1" sourceRef="loginStartEvent" targetRef="loginCheck"/>

        <exclusiveGateway id="loginCheck">
            <incoming>sequenceFlow1</incoming>
            <outgoing>sequenceFlow2</outgoing>
            <outgoing>sequenceFlow3</outgoing>
        </exclusiveGateway>

        <sequenceFlow id="sequenceFlow2" sourceRef="loginCheck" targetRef="productSelection"/>

        <endEvent id="loginFailedEnd">
            <incoming>sequenceFlow3</incoming>
        </endEvent>

        <subProcess id="productSelectionSubProcess">
            <startEvent id="selectProductStartEvent">
                <outgoing>sequenceFlow4</outgoing>
            </startEvent>

            <sequenceFlow id="sequenceFlow4" sourceRef="selectProductStartEvent" targetRef="addProductToCart"/>

            <task id="addProductToCartTask">
                <incoming>sequenceFlow4</incoming>
                <outgoing>sequenceFlow5</outgoing>
                <outgoing>sequenceFlow6</outgoing>
            </task>

            <sequenceFlow id="sequenceFlow5" sourceRef="addProductToCartTask" targetRef="selectProductStartEvent"/>

            <exclusiveGateway id="checkProductsExclusiveGateway">
                <incoming>sequenceFlow6</incoming>
                <outgoing>sequenceFlow7</outgoing>
                <outgoing>sequenceFlow8</outgoing>
            </exclusiveGateway>

            <sequenceFlow id="sequenceFlow7" sourceRef="checkProductsExclusiveGateway" targetRef="finishOrderTask"/>

            <sequenceFlow id="sequenceFlow8" sourceRef="checkProductsExclusiveGateway" targetRef="selectProductStartEvent"/>
        </subProcess>

        <task id="finishOrderTask">
            <incoming>sequenceFlow7</incoming>
            <outgoing>sequenceFlow9</outgoing>
        </task>

        <parallelGateway id="preparePaymentAndShipmentParallelGateway">
            <incoming>sequenceFlow9</incoming>
            <outgoing>sequenceFlow10</outgoing>
            <outgoing>sequenceFlow11</outgoing>
        </parallelGateway>

        <sequenceFlow id="sequenceFlow10" sourceRef="preparePaymentAndShipmentParallelGateway" targetRef="paymentConfirmationTask"/>

        <task id="paymentConfirmationTask">
            <incoming>sequenceFlow10</incoming>
            <outgoing>sequenceFlow12</outgoing>
        </task>

        <sequenceFlow id="sequenceFlow12" sourceRef="paymentConfirmationTask" targetRef="enterShippingAddressTask"/>

        <task id="enterShippingAddressTask">
            <incoming>sequenceFlow12</incoming>
            <outgoing>sequenceFlow13</outgoing>
        </task>

        <sequenceFlow id="sequenceFlow13" sourceRef="enterShippingAddressTask" targetRef="orderFinishedEndEvent"/>

        <task id="prepareShipmentTask">
            <incoming>sequenceFlow11</incoming>
            <outgoing>sequenceFlow14</outgoing>
        </task>

        <sequenceFlow id="sequenceFlow14" sourceRef="prepareShipmentTask" targetRef="orderFinishedEndEvent"/>

        <endEvent id="orderFinishedEndEvent">
            <incoming>sequenceFlow13</incoming>
            <incoming>sequenceFlow14</incoming>
        </endEvent>
    </process>
</definitions>