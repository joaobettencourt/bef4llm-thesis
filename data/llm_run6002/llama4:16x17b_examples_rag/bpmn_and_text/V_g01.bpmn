<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/BPMN20.xsd"
             id="definitions" name="Robotic Burger Seller" targetNamespace="http://example.com">

   <process id="roboticBurgerSellerProcess" isExecutable="true">
     <startEvent id="receiveOrder">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <exclusiveGateway id="menuDecision">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
       <outgoing>sequenceFlow3</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow1" sourceRef="receiveOrder" targetRef="menuDecision"/>
     <sequenceFlow id="sequenceFlow2" sourceRef="menuDecision" targetRef="prepareDrink">
       <conditionExpression xsi:type="tFormalExpression"> wants menu </conditionExpression>
     </sequenceFlow>
     <sequenceFlow id="sequenceFlow3" sourceRef="menuDecision" targetRef="prepareBurger">
       <conditionExpression xsi:type="tFormalExpression"> no menu </conditionExpression>
     </sequenceFlow>

     <task id="prepareDrinkTask">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow4</outgoing>
     </task>

     <exclusiveGateway id="sideDecision">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow5</outgoing>
       <outgoing>sequenceFlow6</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow4" sourceRef="prepareDrinkTask" targetRef="sideDecision"/>
     <sequenceFlow id="sequenceFlow5" sourceRef="sideDecision" targetRef="prepareFriesTask">
       <conditionExpression xsi:type="tFormalExpression"> wants fries </conditionExpression>
     </sequenceFlow>
     <sequenceFlow id="sequenceFlow6" sourceRef="sideDecision" targetRef="prepareWedgesTask">
       <conditionExpression xsi:type="tFormalExpression"> wants wedges </conditionExpression>
     </sequenceFlow>

     <task id="prepareFriesTask"/>
     <task id="prepareWedgesTask"/>

     <task id="prepareBurgerTask">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow7</outgoing>
     </task>

     <subProcess id="statusUpdatesSubProcess">
       <incoming>sequenceFlow7</incoming>
       <!-- simulate status updates every 30 seconds -->
       <intermediateCatchEvent id="every30Seconds">
         <timerEventDefinition/>
         <outgoing>sequenceFlow8</outgoing>
       </intermediateCatchEvent>
       <task id="updateStatusTask">
         <incoming>sequenceFlow8</incoming>
       </task>
     </subProcess>

     <sequenceFlow id="sequenceFlow7" sourceRef="prepareBurgerTask" targetRef="statusUpdatesSubProcess"/>
     <sequenceFlow id="sequenceFlow8" sourceRef="every30Seconds" targetRef="updateStatusTask"/>

     <endEvent id="deliverOrderEnd">
       <incoming>sequenceFlow9</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow9" sourceRef="statusUpdatesSubProcess" targetRef="deliverOrderEnd"/>
   </process>
</definitions>