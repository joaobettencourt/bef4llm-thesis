<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/DD/20100524/DC BPMN20.xsd"
             id="definitions" 
             name="New Application for Registering for an USI course"
             targetNamespace="http://www.example.com/bpmn">

   <process id="newApplicationProcess" isExecutable="true">
     <startEvent id="startEvent1">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <userTask id="selectCourseTask" name="Select a course">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="selectCourseTask"/>

     <serviceTask id="getCoursesAndDatesTask" name="Get courses and dates">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlow2" sourceRef="selectCourseTask" targetRef="getCoursesAndDatesTask"/>

     <exclusiveGateway id="hasAccountGateway">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow4</outgoing>
       <outgoing>sequenceFlow5</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow3" sourceRef="getCoursesAndDatesTask" targetRef="hasAccountGateway"/>

     <userTask id="checkEligibleUniversityTask" name="Check if eligible university">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow6</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow5" sourceRef="hasAccountGateway" targetRef="checkEligibleUniversityTask"/>

     <exclusiveGateway id="eligibleUniversityGateway">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow7</outgoing>
       <outgoing>sequenceFlow8</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow6" sourceRef="checkEligibleUniversityTask" targetRef="eligibleUniversityGateway"/>

     <userTask id="registerAccountTask" name="Register account">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow9</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow7" sourceRef="eligibleUniversityGateway" targetRef="registerAccountTask"/>

     <userTask id="requestActivationTask" name="Request activation">
       <incoming>sequenceFlow8</incoming>
       <outgoing>sequenceFlow10</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow8" sourceRef="eligibleUniversityGateway" targetRef="requestActivationTask"/>

     <userTask id="loginTask" name="Login">
       <incoming>sequenceFlow9</incoming>
       <incoming>sequenceFlow10</incoming>
       <outgoing>sequenceFlow11</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow9" sourceRef="registerAccountTask" targetRef="loginTask"/>
     <sequenceFlow id="sequenceFlow10" sourceRef="requestActivationTask" targetRef="loginTask"/>

     <serviceTask id="connectTwitterTask" name="Connect to Twitter">
       <incoming>sequenceFlow11</incoming>
       <outgoing>sequenceFlow12</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlow11" sourceRef="loginTask" targetRef="connectTwitterTask"/>

     <userTask id="completeRegistrationTask" name="Complete registration and payment">
       <incoming>sequenceFlow12</incoming>
       <outgoing>sequenceFlow13</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow12" sourceRef="connectTwitterTask" targetRef="completeRegistrationTask"/>

     <serviceTask id="receiveCourseTicketTask" name="Receive course ticket">
       <incoming>sequenceFlow13</incoming>
     </serviceTask>

     <sequenceFlow id="sequenceFlow13" sourceRef="completeRegistrationTask" targetRef="receiveCourseTicketTask"/>

     <endEvent id="endEvent1">
       <incoming>sequenceFlow14</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow14" sourceRef="receiveCourseTicketTask" targetRef="endEvent1"/>
   </process>
 </definitions>