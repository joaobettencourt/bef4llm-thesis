<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definitions" name="Car Service">

   <process id="carServiceProcess" isExecutable="true">
     <startEvent id="start">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="start" targetRef="checkRegistration"/>

     <exclusiveGateway id="checkRegistration">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
       <outgoing>sequenceFlow3</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow2" sourceRef="checkRegistration" targetRef="notifyUser"/>
     
     <task id="notifyUser">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow4</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow3" sourceRef="checkRegistration" targetRef="fineUser"/>

     <task id="fineUser">
       <incoming>sequenceFlow3</incoming>
     </task>

     <sequenceFlow id="sequenceFlow4" sourceRef="notifyUser" targetRef="carService"/>

     <serviceTask id="carService">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow5</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlow5" sourceRef="carService" targetRef="statusUpdates"/>

     <intermediateCatchEvent id="statusUpdates">
       <incoming>sequenceFlow5</incoming>
     </intermediateCatchEvent>

     <task id="paymentAndPickerl">
       <outgoing>sequenceFlow6</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow6" sourceRef="paymentAndPickerl" targetRef="end"/>

     <endEvent id="end">
       <incoming>sequenceFlow6</incoming>
     </endEvent>
   </process>
</definitions>