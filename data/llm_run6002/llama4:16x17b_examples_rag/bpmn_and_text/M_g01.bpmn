<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/BPMN20.xsd"
             id="definitions" name="Instruct an Artist to Create a 3D Model"
             targetNamespace="http://example.com/bpmn">

    <process id="create3DModelProcess" isExecutable="true">
        <startEvent id="startEvent1">
            <outgoing>sequenceFlow1</outgoing>
        </startEvent>

        <userTask id="instructArtistTask" name="Instruct an artist to create a project">
            <incoming>sequenceFlow1</incoming>
            <outgoing>sequenceFlow2</outgoing>
        </userTask>

        <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="instructArtistTask"/>

        <exclusiveGateway id="colorChoiceGateway">
            <incoming>sequenceFlow3</incoming>
            <outgoing>sequenceFlow4</outgoing>
            <outgoing>sequenceFlow5</outgoing>
        </exclusiveGateway>

        <userTask id="changeColorTask" name="Choose a plastic color">
            <incoming>sequenceFlow2</incoming>
            <outgoing>sequenceFlow3</outgoing>
        </userTask>

        <sequenceFlow id="sequenceFlow2" sourceRef="instructArtistTask" targetRef="changeColorTask"/>
        <sequenceFlow id="sequenceFlow3" sourceRef="changeColorTask" targetRef="colorChoiceGateway"/>

        <task id="checkColorStockTask" name="Check color stock level">
            <incoming>sequenceFlow4</incoming>
            <outgoing>sequenceFlow6</outgoing>
            <outgoing>sequenceFlow7</outgoing>
        </task>

        <sequenceFlow id="sequenceFlow4" sourceRef="colorChoiceGateway" targetRef="checkColorStockTask"/>

        <exclusiveGateway id="stockLevelCheckGateway">
            <incoming>sequenceFlow6</incoming>
            <outgoing>sequenceFlow8</outgoing>
            <outgoing>sequenceFlow9</outgoing>
        </exclusiveGateway>

        <userTask id="orderColorTask" name="Order color if not in stock">
            <incoming>sequenceFlow7</incoming>
            <outgoing>sequenceFlow10</outgoing>
        </userTask>

        <task id="addToShoppingListTask" name="Add to shopping list if under 100g">
            <incoming>sequenceFlow9</incoming>
            <outgoing>sequenceFlow11</outgoing>
        </task>

        <sequenceFlow id="sequenceFlow6" sourceRef="checkColorStockTask" targetRef="stockLevelCheckGateway"/>
        <sequenceFlow id="sequenceFlow7" sourceRef="checkColorStockTask" targetRef="orderColorTask"/>
        <sequenceFlow id="sequenceFlow8" sourceRef="stockLevelCheckGateway" targetRef="prepare3DPrintingTask"> </sequenceFlow>
        <sequenceFlow id="sequenceFlow9" sourceRef="stockLevelCheckGateway" targetRef="addToShoppingListTask"> </sequenceFlow>

        <serviceTask id="prepare3DPrintingTask" name="Prepare for 3D printing">
            <incoming>sequenceFlow8</incoming>
            <outgoing>sequenceFlow12</outgoing>
        </serviceTask>

        <task id="generateGcodeFileTask" name="Generate gcode file">
            <incoming>sequenceFlow10</incoming>
            <outgoing>sequenceFlow13</outgoing>
        </task>

        <userTask id="printModelTask" name="Print the 3D model">
            <incoming>sequenceFlow12</incoming>
            <outgoing>sequenceFlow14</outgoing>
        </userTask>

        <endEvent id="modelPrintedEndEvent">
            <incoming>sequenceFlow14</incoming>
        </endEvent>

        <sequenceFlow id="sequenceFlow10" sourceRef="orderColorTask" targetRef="generateGcodeFileTask"/>
        <sequenceFlow id="sequenceFlow11" sourceRef="addToShoppingListTask" targetRef="orderColorTask"/>
        <sequenceFlow id="sequenceFlow12" sourceRef="prepare3DPrintingTask" targetRef="printModelTask"/>
        <sequenceFlow id="sequenceFlow13" sourceRef="generateGcodeFileTask" targetRef="prepare3DPrintingTask"/>
        <sequenceFlow id="sequenceFlow14" sourceRef="printModelTask" targetRef="modelPrintedEndEvent"/>

    </process>
</definitions>