<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
	xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" 
	xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
	xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	targetNamespace="http://bpmn.io/schema/bpmn" id="Definitions_1">
    <bpmn:collaboration id="Collaboration_0geryc1">
        <bpmn:participant id="Participant_0ygkg4f" name="Runner"
            processRef="Process_1"/>
        <bpmn:participant id="Participant_1d7o8xw" name="App"
            processRef="Process_1"/>
    </bpmn:collaboration>
    <bpmn:process id="Process_1" isExecutable="false">
        <bpmn:startEvent id="StartEvent_1" name="Participate Night Run">
            <bpmn:outgoing>SequenceFlow_14a0oky</bpmn:outgoing>
        </bpmn:startEvent>

        <bpmn:task id="Task_12j0pib" name="Select starting block"
            completionQuantity="1" isForCompensation="false">
            <bpmn:incoming>SequenceFlow_14a0oky</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_1j94oja</bpmn:outgoing>
        </bpmn:task>

        <bpmn:parallelGateway id="ParallelGateway_02fgrfq"
            gatewayDirection="Diverging" name="">
            <bpmn:incoming>SequenceFlow_14a0oky</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_023hzxi</bpmn:outgoing>
            <bpmn:outgoing>SequenceFlow_1ujhfx4</bpmn:outgoing>
        </bpmn:parallelGateway>

        <bpmn:task id="Task_0vaxgaa" name="Run 5 km"
            completionQuantity="1" isForCompensation="false">
            <bpmn:incoming>SequenceFlow_023hzxi</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_1rss71o</bpmn:outgoing>
        </bpmn:task>

        <bpmn:endEvent id="EndEvent_1" name="Run finished">
            <bpmn:incoming>SequenceFlow_0v64x8b</bpmn:incoming>
        </bpmn:endEvent>

        <bpmn:exclusiveGateway id="ExclusiveGateway_1mpgzhg"
            gatewayDirection="Diverging" name="Took less than 25 minutes?">
            <bpmn:incoming>SequenceFlow_1rss71o</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_0iu9po7</bpmn:outgoing>
            <bpmn:outgoing>SequenceFlow_1xv6wk4</bpmn:outgoing>
        </bpmn:exclusiveGateway>

        <bpmn:endEvent id="EndEvent_2" name="Run finished">
            <bpmn:incoming>SequenceFlow_0v64x8b</bpmn:incoming>
        </bpmn:endEvent>

        <bpmn:task id="Task_0e6hvnj" name="Satisfied with the result"
            completionQuantity="1" isForCompensation="false">
            <bpmn:incoming>SequenceFlow_0iu9po7</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_0kz5g1t</bpmn:outgoing>
        </bpmn:task>

        <bpmn:endEvent id="EndEvent_3" name="Run finished">
            <bpmn:incoming>SequenceFlow_0v64x8b</bpmn:incoming>
        </bpmn:endEvent>

        <bpmn:exclusiveGateway id="ExclusiveGateway_1ouv9kf"
            gatewayDirection="Diverging" name="Ends workday &gt;1h before starting time?">
            <bpmn:incoming>SequenceFlow_0kz5g1t</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_035vf60</bpmn:outgoing>
        </bpmn:exclusiveGateway>

        <bpmn:endEvent id="EndEvent_4" name="Run finished">
            <bpmn:incoming>SequenceFlow_0v64x8b</bpmn:incoming>
        </bpmn:endEvent>

        <bpmn:task id="Task_05ftug5" name="Get starting number"
            completionQuantity="1" isForCompensation="false">
            <bpmn:incoming>SequenceFlow_035vf60</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_0v64x8b</bpmn:outgoing>
        </bpmn:task>

        <bpmn:endEvent id="EndEvent_5" name="Run finished">
            <bpmn:incoming>SequenceFlow_0v64x8b</bpmn:incoming>
        </bpmn:endEvent>

        <bpmn:sequenceFlow id="SequenceFlow_14a0oky"
            sourceRef="StartEvent_1" targetRef="ParallelGateway_02fgrfq"
            name="yes"/>
        <bpmn:sequenceFlow id="SequenceFlow_023hzxi"
            sourceRef="ParallelGateway_02fgrfq" targetRef="Task_0vaxgaa"
            name="always"/>
        <bpmn:sequenceFlow id="SequenceFlow_1rss71o"
            sourceRef="Task_0vaxgaa" targetRef="ExclusiveGateway_1mpgzhg"
            name="yes"/>
        <bpmn:sequenceFlow id="SequenceFlow_0iu9po7"
            sourceRef="ExclusiveGateway_1mpgzhg" targetRef="Task_0e6hvnj"
            name="no"/>
        <bpmn:sequenceFlow id="SequenceFlow_1xv6wk4"
            sourceRef="ExclusiveGateway_1mpgzhg" targetRef="Task_05ftug5"
            name="yes"/>
        <bpmn:sequenceFlow id="SequenceFlow_0kz5g1t"
            sourceRef="Task_0e6hvnj" targetRef="ExclusiveGateway_1ouv9kf"
            name="yes"/>
        <bpmn:sequenceFlow id="SequenceFlow_035vf60"
            sourceRef="ExclusiveGateway_1ouv9kf" targetRef="Task_05ftug5"
            name="yes"/>
        <bpmn:sequenceFlow id="SequenceFlow_0v64x8b"
            sourceRef="Task_05ftug5" targetRef="EndEvent_1"
            name="always"/>

    </bpmn:process>
</bpmn:definitions>