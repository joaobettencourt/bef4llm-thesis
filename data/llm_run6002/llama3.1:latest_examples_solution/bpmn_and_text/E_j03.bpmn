<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
	xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" 
	xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
	xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	targetNamespace="http://bpmn.io/schema/bpmn" id="Definitions_1">
    <bpmn:collaboration id="Collaboration_0geryc1">
        <bpmn:participant id="Participant_0ygkg4f" name="Work Accident"
            processRef="Process_1" />
    </bpmn:collaboration>
    <bpmn:process id="Process_1" isExecutable="false">
        <bpmn:laneSet>
            <bpmn:lane id="Lane_1viot5w" name="Human Action">
                <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>Task_12j0pib</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>ExclusiveGateway_1mpgzhg</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>EndEvent_1fx9yp3</bpmn:flowNodeRef>
            </bpmn:lane>
        </bpmn:laneSet>

        <!-- Core Flow Elements -->
        <bpmn:startEvent id="StartEvent_1" name="incident happens">
            <bpmn:outgoing>SequenceFlow_14a0oky</bpmn:outgoing>
        </bpmn:startEvent>

        <bpmn:task id="Task_12j0pib" name="start assessment tool">
            <bpmn:incoming>SequenceFlow_14a0oky</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_1j94oja</bpmn:outgoing>
        </bpmn:task>

        <bpmn:exclusiveGateway id="ExclusiveGateway_1mpgzhg">
            <bpmn:incoming>SequenceFlow_1j94oja</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_0iu9po7</bpmn:outgoing>
            <bpmn:outgoing>SequenceFlow_1xv6wk4</bpmn:outgoing>
        </bpmn:exclusiveGateway>

        <bpmn:endEvent id="EndEvent_1fx9yp3" name="everything done">
            <bpmn:incoming>SequenceFlow_0iu9po7</bpmn:incoming>
        </bpmn:endEvent>

        <!-- Sequence Flows -->
        <bpmn:sequenceFlow id="SequenceFlow_14a0oky" sourceRef="StartEvent_1"
            targetRef="Task_12j0pib" name="yes" />
        <bpmn:sequenceFlow id="SequenceFlow_1j94oja" sourceRef="Task_12j0pib"
            targetRef="ExclusiveGateway_1mpgzhg" name="no" />
        <bpmn:sequenceFlow id="SequenceFlow_0iu9po7" sourceRef="ExclusiveGateway_1mpgzhg"
            targetRef="EndEvent_1fx9yp3" name="yes" />

    </bpmn:process>
</bpmn:definitions>