<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
	xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" 
	xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
	xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	targetNamespace="http://bpmn.io/schema/bpmn">
    <bpmn:process id="Process_1" isExecutable="false">
        <bpmn:startEvent id="StartEvent_1" name="Hardware issue detected">
            <bpmn:outgoing>SequenceFlow_14a0oky</bpmn:outgoing>
        </bpmn:startEvent>

        <bpmn:userTask id="UserTask_1" name="Create account" completionQuantity="1"
            implementation="##WebService" isForCompensation="false">
            <bpmn:incoming>SequenceFlow_14a0oky</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_1j94oja</bpmn:outgoing>
        </bpmn:userTask>

        <bpmn:sequenceFlow id="SequenceFlow_14a0oky" sourceRef="StartEvent_1"
            targetRef="UserTask_1" name="Yes" />
        <bpmn:exclusiveGateway id="ExclusiveGateway_1mpgzhg">
            <bpmn:incoming>SequenceFlow_1j94oja</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_0iu9po7</bpmn:outgoing>
            <bpmn:outgoing>SequenceFlow_1xv6wk4</bpmn:outgoing>
        </bpmn:exclusiveGateway>

        <bpmn:userTask id="UserTask_2" name="Log into account" completionQuantity="1"
            implementation="##WebService" isForCompensation="false">
            <bpmn:incoming>SequenceFlow_0iu9po7</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_0kz5g1t</bpmn:outgoing>
        </bpmn:userTask>

        <bpmn:sequenceFlow id="SequenceFlow_1j94oja" sourceRef="UserTask_1"
            targetRef="ExclusiveGateway_1mpgzhg" name="Yes" />
        <bpmn:sequenceFlow id="SequenceFlow_0iu9po7" sourceRef="ExclusiveGateway_1mpgzhg"
            targetRef="UserTask_2" name="No" />

        <bpmn:userTask id="UserTask_3" name="Enter model and what is broken" completionQuantity="1"
            implementation="##WebService" isForCompensation="false">
            <bpmn:incoming>SequenceFlow_0kz5g1t</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_023hzxi</bpmn:outgoing>
        </bpmn:userTask>

        <bpmn:sequenceFlow id="SequenceFlow_0kz5g1t" sourceRef="UserTask_2"
            targetRef="UserTask_3" name="Yes" />
        <bpmn:parallelGateway id="ParallelGateway_02fgrfq">
            <bpmn:incoming>SequenceFlow_023hzxi</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_1ujhfx4</bpmn:outgoing>
            <bpmn:outgoing>SequenceFlow_1dlbln9</bpmn:outgoing>
        </bpmn:parallelGateway>

        <bpmn:userTask id="UserTask_4" name="Select type of hardware issue" completionQuantity="1"
            implementation="##WebService" isForCompensation="false">
            <bpmn:incoming>SequenceFlow_023hzxi</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_1rss71o</bpmn:outgoing>
        </bpmn:userTask>

        <bpmn:sequenceFlow id="SequenceFlow_023hzxi" sourceRef="UserTask_3"
            targetRef="ParallelGateway_02fgrfq" name="always" />
        <bpmn:sequenceFlow id="SequenceFlow_1ujhfx4" sourceRef="ParallelGateway_02fgrfq"
            targetRef="UserTask_4" name="Yes" />

        <bpmn:userTask id="UserTask_5" name="Get second-hand tools and materials from friends" completionQuantity="1"
            implementation="##WebService" isForCompensation="false">
            <bpmn:incoming>SequenceFlow_1rss71o</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_0ajhekx</bpmn:outgoing>
        </bpmn:userTask>

        <bpmn:sequenceFlow id="SequenceFlow_1dlbln9" sourceRef="ParallelGateway_02fgrfq"
            targetRef="UserTask_5" name="Yes" />
        <bpmn:exclusiveGateway id="ExclusiveGateway_2mpgzhg">
            <bpmn:incoming>SequenceFlow_0ajhekx</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_035vf60</bpmn:outgoing>
            <bpmn:outgoing>SequenceFlow_06kfaev</bpmn:outgoing>
        </bpmn:exclusiveGateway>

        <bpmn:userTask id="UserTask_6" name="Purchase online" completionQuantity="1"
            implementation="##WebService" isForCompensation="false">
            <bpmn:incoming>SequenceFlow_0ajhekx</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_0v64x8b</bpmn:outgoing>
        </bpmn:userTask>

        <bpmn:sequenceFlow id="SequenceFlow_0ajhekx" sourceRef="UserTask_5"
            targetRef="ExclusiveGateway_2mpgzhg" name="Yes" />
        <bpmn:sequenceFlow id="SequenceFlow_035vf60" sourceRef="ExclusiveGateway_2mpgzhg"
            targetRef="UserTask_6" name="No" />

        <bpmn:endEvent id="EndEvent_1fx9yp3" name="Hardware issue fixed">
            <bpmn:incoming>SequenceFlow_0v64x8b</bpmn:incoming>
        </bpmn:endEvent>

        <bpmn:userTask id="UserTask_7" name="Repair device" completionQuantity="1"
            implementation="##WebService" isForCompensation="false">
            <bpmn:incoming>SequenceFlow_06kfaev</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_0v64x8b</bpmn:outgoing>
        </bpmn:userTask>

        <bpmn:sequenceFlow id="SequenceFlow_06kfaev" sourceRef="ExclusiveGateway_2mpgzhg"
            targetRef="UserTask_7" name="Yes" />
    </bpmn:process>
