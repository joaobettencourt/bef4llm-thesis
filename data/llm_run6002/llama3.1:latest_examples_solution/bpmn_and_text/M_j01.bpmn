<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
	xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" 
	xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
	xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	targetNamespace="http://bpmn.io/schema/bpmn">
	<bpmn:collaboration id="Collaboration_0geryc1">
		<bpmn:participant id="Participant_0ygkg4f" name="Customer"
			processRef="Process_1"/>
		<bpmn:participant id="Participant_1d7o8xw" name="Production Chainsaw GmbH"
			processRef="Process_1"/>
	</bpmn:collaboration>
	<bpmn:process id="Process_1" isExecutable="false">
		<bpmn:laneSet>
			<bpmn:lane id="Lane_1viot5w" name="Customer">
				<bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
			</bpmn:lane>
			<bpmn:lane id="Lane_1ocseyo" name="Production Chainsaw GmbH">
				<bpmn:flowNodeRef>Task_12j0pib</bpmn:flowNodeRef>
				<bpmn:flowNodeRef>ParallelGateway_02fgrfq</bpmn:flowNodeRef>
				<bpmn:flowNodeRef>InclusiveGateway_0p2e5vq</bpmn:flowNodeRef>
				<bpmn:flowNodeRef>Task_12j0pib</bpmn:flowNodeRef>
				<bpmn:flowNodeRef>ExclusiveGateway_1mpgzhg</bpmn:flowNodeRef>
				<bpmn:flowNodeRef>EndEvent_1fx9yp3</bpmn:flowNodeRef>
			</bpmn:lane>
		</bpmn:laneSet>

		<!-- Core Flow Elements -->
		<bpmn:startEvent id="StartEvent_1" name="Customer requests chainsaw">
			<bpmn:outgoing>SequenceFlow_14a0oky</bpmn:outgoing>
		</bpmn:startEvent>

		<bpmn:inclusiveGateway id="InclusiveGateway_0p2e5vq">
			<bpmn:incoming>SequenceFlow_14a0oky</bpmn:incoming>
			<bpmn:outgoing>SequenceFlow_1j94oja</bpmn:outgoing>
			<bpmn:outgoing>SequenceFlow_1dlbln9</bpmn:outgoing>
		</bpmn:inclusiveGateway>

		<bpmn:task id="Task_12j0pib" name="Order parts">
			<bpmn:incoming>SequenceFlow_1j94oja</bpmn:incoming>
			<bpmn:outgoing>SequenceFlow_0kz5g1t</bpmn:outgoing>
		</bpmn:task>

		<bpmn:sequenceFlow id="SequenceFlow_14a0oky" sourceRef="StartEvent_1"
			targetRef="InclusiveGateway_0p2e5vq" name="yes"/>
		<bpmn:sequenceFlow id="SequenceFlow_1j94oja" sourceRef="InclusiveGateway_0p2e5vq"
			targetRef="Task_12j0pib" name="If parts ordered"/>
		<bpmn:task id="Task_0jsoxba" name="Inspect parts">
			<bpmn:incoming>SequenceFlow_1dlbln9</bpmn:incoming>
			<bpmn:outgoing>SequenceFlow_0mp5byl</bpmn:outgoing>
		</bpmn:task>

		<bpmn:sequenceFlow id="SequenceFlow_1dlbln9" sourceRef="InclusiveGateway_0p2e5vq"
			targetRef="Task_0jsoxba" name="always"/>
		<bpmn:sequenceFlow id="SequenceFlow_0mp5byl" sourceRef="Task_0jsoxba"
			targetRef="InclusiveGateway_1dgb4sg"/>
		<bpmn:inclusiveGateway id="InclusiveGateway_1dgb4sg">
			<bpmn:incoming>SequenceFlow_0mp5byl</bpmn:incoming>
			<bpmn:incoming>SequenceFlow_0kz5g1t</bpmn:incoming>
			<bpmn:outgoing>SequenceFlow_0buzwss</bpmn:outgoing>
		</bpmn:inclusiveGateway>

		<bpmn:parallelGateway id="ParallelGateway_02fgrfq">
			<bpmn:incoming>SequenceFlow_14a0oky</bpmn:incoming>
			<bpmn:outgoing>SequenceFlow_023hzxi</bpmn:outgoing>
			<bpmn:outgoing>SequenceFlow_1ujhfx4</bpmn:outgoing>
		</bpmn:parallelGateway>

		<bpmn:task id="Task_0vaxgaa" name="Assemble parts">
			<bpmn:incoming>SequenceFlow_023hzxi</bpmn:incoming>
			<bpmn:outgoing>SequenceFlow_1rss71o</bpmn:outgoing>
		</bpmn:task>

		<bpmn:exclusiveGateway id="ExclusiveGateway_1mpgzhg">
			<bpmn:incoming>SequenceFlow_1rss71o</bpmn:incoming>
			<bpmn:outgoing>SequenceFlow_0iu9po7</bpmn:outgoing>
			<bpmn:outgoing>SequenceFlow_1xv6wk4</bpmn:outgoing>
		</bpmn:exclusiveGateway>

		<bpmn:sequenceFlow id="SequenceFlow_14a0oky" sourceRef="StartEvent_1"
			targetRef="ParallelGateway_02fgrfq" name="yes"/>
		<bpmn:sequenceFlow id="SequenceFlow_023hzxi" sourceRef="ParallelGateway_02fgrfq"
			targetRef="Task_0vaxgaa" name="always"/>
		<bpmn:sequenceFlow id="SequenceFlow_1rss71o" sourceRef="Task_0vaxgaa"
			targetRef="ExclusiveGateway_1mpgzhg" name="yes"/>
		<bpmn:task id="Task_0e6hvnj" name="Send update">
			<bpmn:incoming>SequenceFlow_1xv6wk4</bpmn:incoming>
			<bpmn:outgoing>SequenceFlow_1pq8ub3</bpmn:outgoing>
		</bpmn:task>

		<bpmn:sequenceFlow id="SequenceFlow_1xv6wk4" sourceRef="ExclusiveGateway_1mpgzhg"
			targetRef="Task_0e6hvnj" name="yes"/>
		<bpmn:task id="Task_0s79ile" name="Send chainsaw to customer">
			<bpmn:incoming>SequenceFlow_1pq8ub3</bpmn:incoming>
			<bpmn:outgoing>SequenceFlow_0ajhekx</bpmn:outgoing>
		</bpmn:task>

		<bpmn:endEvent id="EndEvent_1fx9yp3" name="Chainsaw order completed">
			<bpmn:incoming>SequenceFlow_0v64x8b</bpmn:incoming>
		</bpmn:endEvent>

		<bpmn:task id="Task_05ftug5" name="Inspect parts">
			<bpmn:incoming>SequenceFlow_1ujhfx4</bpmn:incoming>
			<bpmn:outgoing>SequenceFlow_0b2nw5c</bpmn:outgoing>
		</bpmn:task>

		<bpmn:endEvent id="EndEvent_1u3r8p6" name="Chainsaw order completed">
			<bpmn:incoming>SequenceFlow_0v64x8b</bpmn:incoming>
		</bpmn:endEvent>

	</bpmn:process>
</bpmn:definitions>