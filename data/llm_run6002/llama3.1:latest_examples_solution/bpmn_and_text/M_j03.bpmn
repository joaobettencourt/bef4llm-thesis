    <bpmn:process id="Process_1" isExecutable="false">
        <bpmn:startEvent id="StartEvent_1" name="Contract Project">
            <bpmn:outgoing>SequenceFlow_14a0oky</bpmn:outgoing>
        </bpmn:startEvent>

        <bpmn:exclusiveGateway id="ExclusiveGateway_1mpgzhg" gatewayDirection="Diverging" name="All required parts covered?">
            <bpmn:incoming>SequenceFlow_14a0oky</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_1j94oja</bpmn:outgoing>
            <bpmn:outgoing>SequenceFlow_1dlbln9</bpmn:outgoing>
        </bpmn:exclusiveGateway>

        <bpmn:task id="Task_12j0pib" name="Query webshops for part">
            <bpmn:incoming>SequenceFlow_1j94oja</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_0kz5g1t</bpmn:outgoing>
        </bpmn:task>

        <bpmn:endEvent id="EndEvent_1fx9yp3" name="Contract finished">
            <bpmn:incoming>SequenceFlow_0v64x8b</bpmn:incoming>
        </bpmn:endEvent>

        <bpmn:exclusiveGateway id="ExclusiveGateway_1dgb4sg">
            <bpmn:incoming>SequenceFlow_0mp5byl</bpmn:incoming>
            <bpmn:incoming>SequenceFlow_0kz5g1t</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_0buzwss</bpmn:outgoing>
        </bpmn:exclusiveGateway>

        <bpmn:endEvent id="EndEvent_1u3r8p6" name="Contract finished">
            <bpmn:incoming>SequenceFlow_0v64x8b</bpmn:incoming>
        </bpmn:endEvent>

        <bpmn:sequenceFlow id="SequenceFlow_14a0oky" sourceRef="StartEvent_1" targetRef="ExclusiveGateway_1mpgzhg" name="yes" />
        <bpmn:sequenceFlow id="SequenceFlow_1j94oja" sourceRef="ExclusiveGateway_1mpgzhg" targetRef="Task_12j0pib" name="If all required parts are covered?" />
        <bpmn:sequenceFlow id="SequenceFlow_1dlbln9" sourceRef="ExclusiveGateway_1mpgzhg" targetRef="InclusiveGateway_1dgb4sg" name="always" />
        <bpmn:sequenceFlow id="SequenceFlow_0kz5g1t" sourceRef="Task_12j0pib" targetRef="ExclusiveGateway_1dgb4sg" name="yes" />
        <bpmn:sequenceFlow id="SequenceFlow_0mp5byl" sourceRef="InclusiveGateway_1dgb4sg" targetRef="EndEvent_1fx9yp3" name="always" />
        <bpmn:sequenceFlow id="SequenceFlow_0buzwss" sourceRef="ExclusiveGateway_1dgb4sg" targetRef="EndEvent_1u3r8p6" name="yes" />

    </bpmn:process>
