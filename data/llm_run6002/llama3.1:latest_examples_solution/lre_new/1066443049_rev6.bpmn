    <bpmn:sequenceFlow id="SequenceFlow_3" name="Yes" sourceRef="ExclusiveGateway_2" targetRef="Task_4" />
    <bpmn:endEvent id="EndEvent_3" name="Process is over">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow_4" name="No" sourceRef="ExclusiveGateway_2" targetRef="EndEvent_3" />
    <bpmn:task id="Task_4" name="Storyboard">
