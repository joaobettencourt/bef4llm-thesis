                  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_0" name="Company Manufacturing Customized Bicycles" processRef="Process_1"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_0" name="Engineering Department">
        <bpmn:flowNodeRef>Task_10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_11</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1" name="Sales Department">
        <bpmn:flowNodeRef>StartEvent_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_20</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_30</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_40</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_0</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Storehouse">
