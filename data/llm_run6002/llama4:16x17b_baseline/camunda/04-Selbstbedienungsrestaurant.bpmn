<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" targetNamespace="http://www.example.com">

  <process id="RestaurantProcess" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>

    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>

    <task id="Task_1" name="Gast betritt das Restaurant und wählt ein Gericht aus">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="Task_2"/>

    <task id="Task_2" name="Gast gibt Bestellung auf">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_3" sourceRef="Task_2" targetRef="Task_3"/>

    <task id="Task_3" name="Angestellter gibt Bestellung in Kassensystem ein und kassiert Geld">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_4</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_4" sourceRef="Task_3" targetRef="Task_4"/>

    <task id="Task_4" name="Angestellter übergibt Pieper an Gast">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_5</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_5" sourceRef="Task_4" targetRef="Task_5"/>

    <task id="Task_5" name="Koch bereitet Mahlzeit zu">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_6" sourceRef="Task_5" targetRef="Task_6"/>

    <task id="Task_6" name="Koch informiert Angestellten über fertige Mahlzeit">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_7" sourceRef="Task_6" targetRef="Task_7"/>

    <task id="Task_7" name="Angestellter löst Pieper des Gastes aus">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_8" sourceRef="Task_7" targetRef="Task_8"/>

    <task id="Task_8" name="Gast holt Mahlzeit ab">
      <incoming>SequenceFlow_8</incoming>
      <outgoing>SequenceFlow_9</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_9" sourceRef="Task_8" targetRef="EndEvent_1"/>

    <endEvent id="EndEvent_1">
      <incoming>SequenceFlow_9</incoming>
    </endEvent>

    <!-- Handling for non-responsive guest -->
    <sequenceFlow id="SequenceFlow_10" sourceRef="Task_7" targetRef="Task_9">
      <conditionExpression xsi:type="tFormalExpression">guestDidNotReact</conditionExpression>
    </sequenceFlow>

    <task id="Task_9" name="Angestellter ruft Gast nach 5 Minuten aus">
      <incoming>SequenceFlow_10</incoming>
      <!-- Additional logic for handling multiple calls -->
    </task>
  </process>
</definitions>