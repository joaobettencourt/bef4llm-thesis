<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" targetNamespace="http://www.example.com">

  <process id="RecourseProcess" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>

    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>

    <task id="Task_1" name="Get information about possible subrogation">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="ExclusiveGateway_1"/>

    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
      <outgoing>SequenceFlow_4</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow_3" name="Recourse possible" sourceRef="ExclusiveGateway_1" targetRef="Task_2">
      <conditionExpression xsi:type="tFormalExpression">recoursePossible = true</conditionExpression>
    </sequenceFlow>

    <task id="Task_2" name="Send request for payment and create reminder">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_5</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_5" sourceRef="Task_2" targetRef="ExclusiveGateway_2"/>

    <exclusiveGateway id="ExclusiveGateway_2">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_6</outgoing>
      <outgoing>SequenceFlow_7</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow_6" name="Payment received" sourceRef="ExclusiveGateway_2" targetRef="Task_3">
      <conditionExpression xsi:type="tFormalExpression">paymentReceived = true</conditionExpression>
    </sequenceFlow>

    <task id="Task_3" name="Make booking and close case">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_8" sourceRef="Task_3" targetRef="EndEvent_1"/>

    <sequenceFlow id="SequenceFlow_7" name="Insurant disagrees or no payment" sourceRef="ExclusiveGateway_2" targetRef="Task_4">
      <conditionExpression xsi:type="tFormalExpression">insurantDisagrees = true OR paymentReceived = false</conditionExpression>
    </sequenceFlow>

    <task id="Task_4" name="Check reasoning of disagreement">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_9</outgoing>
      <outgoing>SequenceFlow_10</outgoing>
    </task>

    <exclusiveGateway id="ExclusiveGateway_3">
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_11</outgoing>
      <outgoing>SequenceFlow_12</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow_9" name="Insurant is right" sourceRef="Task_4" targetRef="ExclusiveGateway_3">
      <conditionExpression xsi:type="tFormalExpression">insurantRight = true</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="SequenceFlow_11" sourceRef="ExclusiveGateway_3" targetRef="EndEvent_1"/>

    <sequenceFlow id="SequenceFlow_10" name="Insurant is wrong or deadline reached" sourceRef="Task_4" targetRef="ServiceTask_1">
      <conditionExpression xsi:type="tFormalExpression">insurantWrong = true OR deadlineReached = true</conditionExpression>
    </sequenceFlow>

    <serviceTask id="ServiceTask_1" name="Forward case to collection agency">
      <incoming>SequenceFlow_10</incoming>
      <outgoing>SequenceFlow_12</outgoing>
    </serviceTask>

    <sequenceFlow id="SequenceFlow_12" sourceRef="ServiceTask_1" targetRef="EndEvent_1"/>

    <sequenceFlow id="SequenceFlow_4" name="Recourse not possible" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_1">
      <conditionExpression xsi:type="tFormalExpression">recoursePossible = false</conditionExpression>
    </sequenceFlow>

    <endEvent id="EndEvent_1">
      <incoming>SequenceFlow_8</incoming>
      <incoming>SequenceFlow_11</incoming>
      <incoming>SequenceFlow_12</incoming>
    </endEvent>
  </process>
</definitions>