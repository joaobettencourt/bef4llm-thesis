<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" targetNamespace="http://www.example.com">

  <process id="Process_1" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>

    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>

    <task id="Task_1" name="Prüfen ob Regress möglich">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
      <outgoing>SequenceFlow_3</outgoing>
    </task>

    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_4</outgoing>
      <outgoing>SequenceFlow_5</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="ExclusiveGateway_1">
      <conditionExpression xsi:type="tFormalExpression">Regress möglich</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="SequenceFlow_3" sourceRef="Task_1" targetRef="EndEvent_1">
      <conditionExpression xsi:type="tFormalExpression">kein Regress möglich</conditionExpression>
    </sequenceFlow>

    <task id="Task_2" name="Zahlungsaufforderung an VN">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_1" targetRef="Task_2"/>

    <task id="Task_3" name="Wiedervorlage">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_7</outgoing>
      <outgoing>SequenceFlow_8</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_6" sourceRef="Task_2" targetRef="Task_3"/>

    <exclusiveGateway id="ExclusiveGateway_2">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_9</outgoing>
      <outgoing>SequenceFlow_10</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow_7" sourceRef="Task_3" targetRef="ExclusiveGateway_2">
      <conditionExpression xsi:type="tFormalExpression">Frist abgelaufen oder Zahlungseingang</conditionExpression>
    </sequenceFlow>

    <task id="Task_4" name="Verbuchung von Zahlungseingang">
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_11</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_9" sourceRef="ExclusiveGateway_2" targetRef="Task_4"/>

    <endEvent id="EndEvent_1">
      <incoming>SequenceFlow_3</incoming>
      <incoming>SequenceFlow_11</incoming>
    </endEvent>

    <sequenceFlow id="SequenceFlow_11" sourceRef="Task_4" targetRef="EndEvent_1"/>

    <task id="Task_5" name="Prüfen von Widerspruch">
      <incoming>SequenceFlow_10</incoming>
      <outgoing>SequenceFlow_12</outgoing>
      <outgoing>SequenceFlow_13</outgoing>
    </task>

    <exclusiveGateway id="ExclusiveGateway_3">
      <incoming>SequenceFlow_10</incoming>
      <outgoing>SequenceFlow_12</outgoing>
      <outgoing>SequenceFlow_14</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow_10" sourceRef="Task_3" targetRef="Task_5">
      <conditionExpression xsi:type="tFormalExpression">VN widerspricht</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="SequenceFlow_12" sourceRef="ExclusiveGateway_3" targetRef="EndEvent_1">
      <conditionExpression xsi:type="tFormalExpression">Widerspruch gerechtfertigt</conditionExpression>
    </sequenceFlow>

    <task id="Task_6" name="Inkasso Dienstleister">
      <incoming>SequenceFlow_13</incoming>
      <incoming>SequenceFlow_14</incoming>
      <outgoing>SequenceFlow_15</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_13" sourceRef="Task_5" targetRef="Task_6">
      <conditionExpression xsi:type="tFormalExpression">Widerspruch nicht gerechtfertigt</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="SequenceFlow_14" sourceRef="ExclusiveGateway_3" targetRef="Task_6"/>

  </process>

</definitions>