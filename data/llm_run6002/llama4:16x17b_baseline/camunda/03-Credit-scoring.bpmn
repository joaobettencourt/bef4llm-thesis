<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" targetNamespace="http://www.example.com">

   <process id="CreditScoringProcess" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>

     <task id="Task_1" name="Receive credit-scoring request">
       <!-- No incoming and outgoing defined here, as they are already defined in sequence flow -->
     </task>

     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="ServiceTask_1"/>

     <serviceTask id="ServiceTask_1" name="Send scoring request to agency">
       <!-- No incoming and outgoing defined here, as they are already defined in sequence flow -->
     </serviceTask>

     <sequenceFlow id="SequenceFlow_3" sourceRef="ServiceTask_1" targetRef="ExclusiveGateway_1"/>

     <exclusiveGateway id="ExclusiveGateway_1">
       <!-- Incoming/Outgoing defined in Sequence Flows -->
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_4" name="Immediate result" sourceRef="ExclusiveGateway_1" targetRef="Task_2">
       <!-- Condition Expression -->
     </sequenceFlow>

     <task id="Task_2" name="Present immediate result to clerk">
       <!-- No incoming/outgoing here, defined in sequence flow -->
     </task>

     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_2" targetRef="EndEvent_1"/>

     <sequenceFlow id="SequenceFlow_5" name="Delayed result" sourceRef="ExclusiveGateway_1" targetRef="IntermediateEvent_2">
       <!-- Condition Expression -->
     </sequenceFlow>

     <intermediateEvent id="IntermediateEvent_2" name="Delay notification">
       <!-- No incoming/outgoing defined here, in sequence flow -->
     </intermediateEvent>

     <sequenceFlow id="SequenceFlow_7" sourceRef="IntermediateEvent_2" targetRef="ServiceTask_2"/>

     <serviceTask id="ServiceTask_2" name="Perform level 2 scoring">
       <!-- No incoming/outgoing defined here, in sequence flow -->
     </serviceTask>

     <sequenceFlow id="SequenceFlow_8" sourceRef="ServiceTask_2" targetRef="Task_3"/>

     <task id="Task_3" name="Present delayed result to clerk">
       <!-- No incoming/outgoing defined here, in sequence flow -->
     </task>

     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_3" targetRef="EndEvent_1"/>

     <endEvent id="EndEvent_1">
       <!-- Incoming from Sequence Flows -->
     </endEvent>
   </process>

</definitions>