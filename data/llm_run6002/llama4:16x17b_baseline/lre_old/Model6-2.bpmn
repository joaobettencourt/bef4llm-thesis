<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" 
             targetNamespace="http://example.com/bpmn">
  <process id="order_process" isExecutable="true">
    <startEvent id="start_event">
      <outgoing>send_order</outgoing>
      <timerEventDefinition>
        <timeCycle>P1M</timeCycle>
      </timerEventDefinition>
    </startEvent>
    <sequenceFlow id="send_order" sourceRef="start_event" targetRef="send_order_task"/>
    <task id="send_order_task" name="Send Order to Supplier">
      <incoming>send_order</incoming>
      <outgoing>process_order</outgoing>
    </task>
    <sequenceFlow id="process_order" sourceRef="send_order_task" targetRef="supplier_process_order_task"/>
    <task id="supplier_process_order_task" name="Supplier Process Order">
      <incoming>process_order</incoming>
      <outgoing>send_invoice</outgoing>
    </task>
    <sequenceFlow id="send_invoice" sourceRef="supplier_process_order_task" targetRef="send_invoice_task"/>
    <task id="send_invoice_task" name="Send Invoice to Assembler AG">
      <incoming>send_invoice</incoming>
      <outgoing>end_event_flow</outgoing>
    </task>
    <sequenceFlow id="end_event_flow" sourceRef="send_invoice_task" targetRef="end_event"/>
    <endEvent id="end_event">
      <incoming>end_event_flow</incoming>
    </endEvent>
  </process>
</definitions>