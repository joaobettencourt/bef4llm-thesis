<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Examination Process" targetNamespace="http://example.com/bpmn">

   <process id="examinationProcess" isExecutable="true">
     <!-- Start Event  -->
     <startEvent id="start-event-1">
       <outgoing>sequence-flow-1</outgoing>
     </startEvent>

     <!-- Outpatient Physician examines patient  -->
     <sequenceFlow id="sequence-flow-1" sourceRef="start-event-1" targetRef="examine-patient"/>

     <task id="examine-patient" name="Examine Patient">
       <incoming>sequence-flow-1</incoming>
       <outgoing>sequence-flow-2</outgoing>
       <outgoing>sequence-flow-3</outgoing>
     </task>

     <!-- Physician decides patient is healthy  -->
     <exclusiveGateway id="exclusive-gateway-1">
       <incoming>sequence-flow-2</incoming>
       <outgoing>sequence-flow-4</outgoing>
       <outgoing>sequence-flow-5</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequence-flow-2" sourceRef="examine-patient" targetRef="exclusive-gateway-1"/>

     <!-- Physician fills out examination form and patient leaves  -->
     <task id="fill-out-form" name="Fill out Examination Form">
       <incoming>sequence-flow-4</incoming>
       <outgoing>sequence-flow-6</outgoing>
     </task>

     <sequenceFlow id="sequence-flow-4" sourceRef="exclusive-gateway-1" targetRef="fill-out-form"/>

     <endEvent id="end-event-1">
       <incoming>sequence-flow-6</incoming>
     </endEvent>

     <sequenceFlow id="sequence-flow-6" sourceRef="fill-out-form" targetRef="end-event-1"/>

     <!-- Physician decides patient needs additional examination  -->
     <sequenceFlow id="sequence-flow-3" sourceRef="examine-patient" targetRef="place-order"/>
     
     <task id="place-order" name="Place Examination Order">
       <incoming>sequence-flow-3</incoming>
       <outgoing>sequence-flow-7</outgoing>
     </task>

     <sequenceFlow id="sequence-flow-7" sourceRef="place-order" targetRef="inform-patient"/>

     <task id="inform-patient" name="Inform Patient about Risks">
       <incoming>sequence-flow-7</incoming>
       <outgoing>sequence-flow-8</outgoing>
     </task>

     <exclusiveGateway id="exclusive-gateway-2">
       <incoming>sequence-flow-8</incoming>
       <outgoing>sequence-flow-9</outgoing>
       <outgoing>sequence-flow-10</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequence-flow-8" sourceRef="inform-patient" targetRef="exclusive-gateway-2"/>

     <!-- Delegate arranges appointment with ward  -->
     <task id="arrange-appointment" name="Arrange Appointment with Ward">
       <incoming>sequence-flow-9</incoming>
       <outgoing>sequence-flow-11</outgoing>
     </task>

     <sequenceFlow id="sequence-flow-9" sourceRef="exclusive-gateway-2" targetRef="arrange-appointment"/>

     <!-- Nurse prepares examination and sampling  -->
     <task id="prepare-examination" name="Prepare Examination and Sampling">
       <incoming>sequence-flow-11</incoming>
       <outgoing>sequence-flow-12</outgoing>
     </task>

     <sequenceFlow id="sequence-flow-11" sourceRef="arrange-appointment" targetRef="prepare-examination"/>

     <!-- Ward physician takes sample and sends to lab  -->
     <task id="take-sample" name="Take Sample and Send to Lab">
       <incoming>sequence-flow-12</incoming>
       <outgoing>sequence-flow-13</outgoing>
     </task>

     <sequenceFlow id="sequence-flow-12" sourceRef="prepare-examination" targetRef="take-sample"/>

     <!-- Lab physician validates sample  -->
     <task id="validate-sample" name="Validate Sample">
       <incoming>sequence-flow-13</incoming>
       <outgoing>sequence-flow-14</outgoing>
     </task>

     <sequenceFlow id="sequence-flow-13" sourceRef="take-sample" targetRef="validate-sample"/>

     <!-- Medical technical assistant performs analysis  -->
     <task id="perform-analysis" name="Perform Analysis">
       <incoming>sequence-flow-14</incoming>
       <outgoing>sequence-flow-15</outgoing>
     </task>

     <sequenceFlow id="sequence-flow-14" sourceRef="validate-sample" targetRef="perform-analysis"/>

     <!-- Lab physician validates results  -->
     <task id="validate-results" name="Validate Results">
       <incoming>sequence-flow-15</incoming>
       <outgoing>sequence-flow-16</outgoing>
     </task>

     <sequenceFlow id="sequence-flow-15" sourceRef="perform-analysis" targetRef="validate-results"/>

     <!-- Outpatient physician makes diagnosis and prescribes therapy  -->
     <endEvent id="end-event-2">
       <incoming>sequence-flow-16</incoming>
     </endEvent>

     <sequenceFlow id="sequence-flow-16" sourceRef="validate-results" targetRef="end-event-2"/>

   </process>
</definitions>