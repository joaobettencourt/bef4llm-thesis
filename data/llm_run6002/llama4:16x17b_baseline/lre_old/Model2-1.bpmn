<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="BPMN Process Model" targetNamespace="http://example.com/bpmn">

   <process id="Process_1" isExecutable="true">
     <!-- Start Event  -->
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <!-- Sequence Flow to Task 1  -->
     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>

     <!-- Task 1: Send Problem Parameters to Customer Service  -->
     <task id="Task_1" name="Send problem parameters to TELECO Customer Service">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>

     <!-- Sequence Flow to Task 2  -->
     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="Task_2"/>

     <!-- Task 2: Enter Problem Report into System T  -->
     <task id="Task_2" name="Enter problem report into system T">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
     </task>

     <!-- Sequence Flow to Exclusive Gateway 1  -->
     <sequenceFlow id="SequenceFlow_3" sourceRef="Task_2" targetRef="ExclusiveGateway_1"/>

     <!-- Exclusive Gateway 1: Determine Customer Significance  -->
     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_4</outgoing>
       <outgoing>SequenceFlow_5</outgoing>
     </exclusiveGateway>

     <!-- Sequence Flow to Task 3  -->
     <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_1" targetRef="Task_3">
       <conditionExpression xsi:type="tFormalExpression">${customerSignificance == 'premium'}</conditionExpression>
     </sequenceFlow>

     <!-- Task 3: Extra Problem Fix Process  -->
     <task id="Task_3" name="Extra problem fix process for premium customers">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </task>

     <!-- Sequence Flow to Exclusive Gateway 1 Alternative Path -->
     <sequenceFlow id="SequenceFlow_5" sourceRef="ExclusiveGateway_1" targetRef="Task_4">
       <conditionExpression xsi:type="tFormalExpression">${customerSignificance != 'premium'}</conditionExpression>
     </sequenceFlow>

     <!-- Task 4: Re-prioritize Counter Measures -->
     <task id="Task_4" name="Re- prioritize counter measures based on customer significance">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </task>

     <!-- Converge Sequence Flows -->
     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_3" targetRef="Task_5"/>
     <sequenceFlow id="SequenceFlow_7" sourceRef="Task_4" targetRef="Task_5"/>

     <!-- Task 5: Create Detailed Problem Report -->
     <task id="Task_5" name="Create detailed problem report">
       <incoming>SequenceFlow_6</incoming>
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_8</outgoing>
     </task>

     <!-- Sequence Flow to Service Management  -->
     <sequenceFlow id="SequenceFlow_8" sourceRef="Task_5" targetRef="ServiceManagement_SubProcess"/>

     <!-- Service Management Sub Process -->
     <subProcess id="ServiceManagement_SubProcess">
       <startEvent id="StartEvent_ServiceManagement">
         <outgoing>SequenceFlow_ServiceManagement_1</outgoing>
       </startEvent>

       <sequenceFlow id="SequenceFlow_ServiceManagement_1" sourceRef="StartEvent_ServiceManagement" targetRef="ExclusiveGateway_ServiceManagement_1"/>

       <!-- Exclusive Gateway  -->
       <exclusiveGateway id="ExclusiveGateway_ServiceManagement_1">
         <incoming>SequenceFlow_ServiceManagement_1</incoming>
         <outgoing>SequenceFlow_ServiceManagement_2</outgoing>
         <outgoing>SequenceFlow_ServiceManagement_3</outgoing>
       </exclusiveGateway>

       <!-- Sequence Flow to Resource Provisioning  -->
       <sequenceFlow id="SequenceFlow_ServiceManagement_2" sourceRef="ExclusiveGateway_ServiceManagement_1" targetRef="ResourceProvisioning_SubProcess">
         <conditionExpression xsi:type="tFormalExpression">${problemAnalyzable == false}</conditionExpression>
       </sequenceFlow>

       <!-- Sequence Flow to Task  -->
       <sequenceFlow id="SequenceFlow_ServiceManagement_3" sourceRef="ExclusiveGateway_ServiceManagement_1" targetRef="Task_ServiceManagement_Analyze"/>

       <!-- Analyze Problem and Create Trouble Report -->
       <task id="Task_ServiceManagement_Analyze" name="Analyze problem and create trouble report">
         <incoming>SequenceFlow_ServiceManagement_3</incoming>
         <outgoing>SequenceFlow_ServiceManagement_End_analyze</outgoing>
       </task>

       <sequenceFlow id="SequenceFlow_ServiceManagement_End_analyze" sourceRef="Task_ServiceManagement_Analyze" targetRef="EndEvent_ServiceManagement"/>

       <!-- End Event Service Management -->
       <endEvent id="EndEvent_ServiceManagement">
         <incoming>SequenceFlow_ServiceManagement_End_analyze</incoming>
       </endEvent>

     </subProcess>

     <!-- Resource Provisioning Sub Process -->
     <subProcess id="ResourceProvisioning_SubProcess">
       <startEvent id="StartEvent_ResourceProvisioning">
         <outgoing>SequenceFlow_ResourceProvisioning_1</outgoing>
       </startEvent>

       <sequenceFlow id="SequenceFlow_ResourceProvisioning_1" sourceRef="StartEvent_ResourceProvisioning" targetRef="ExclusiveGateway_ResourceProvisioning_1"/>

       <!-- Exclusive Gateway  -->
       <exclusiveGateway id="ExclusiveGateway_ResourceProvisioning_1">
         <incoming>SequenceFlow_ResourceProvisioning_1</incoming>
         <outgoing>SequenceFlow_ResourceProvisioning_NoProblem</outgoing>
         <outgoing>SequenceFlow_ResourceProvisioning_WithProblem</outgoing>
       </exclusiveGateway>

       <!-- Sequence Flow to Task -->
       <sequenceFlow id="SequenceFlow_ResourceProvisioning_NoProblem" sourceRef="ExclusiveGateway_ResourceProvisioning_1" targetRef="Task_ResourceProvisioning_Notification">
         <conditionExpression xsi:type="tFormalExpression">${noProblemsDetected}</conditionExpression>
       </sequenceFlow>

       <!-- Task: Create Notification about Normal Service Execution -->
       <task id="Task_ResourceProvisioning_Notification" name="Create notification about normal service execution">
         <incoming>SequenceFlow_ResourceProvisioning_NoProblem</incoming>
         <outgoing>SequenceFlow_ResourceProvisioning_End_Normal</outgoing>
       </task>

       <!-- Sequence Flow to End Event -->
       <sequenceFlow id="SequenceFlow_ResourceProvisioning_End_Normal" sourceRef="Task_ResourceProvisioning_Notification" targetRef="EndEvent_ResourceProvisioning"/>

       <!-- Analyze Problem and Create Trouble Report -->
       <sequenceFlow id="SequenceFlow_ResourceProvisioning_WithProblem" sourceRef="ExclusiveGateway_ResourceProvisioning_1" targetRef="Task_ResourceProvisioning_Analyze">
         <conditionExpression xsi:type="tFormalExpression">${problemsDetected}</conditionExpression>
       </sequenceFlow>

       <task id="Task_ResourceProvisioning_Analyze" name="Analyze problem and create trouble report">
         <incoming>SequenceFlow_ResourceProvisioning_WithProblem</incoming>
         <outgoing>SequenceFlow_ResourceProvisioning_End_Analyzing</outgoing>
       </task>

       <!-- End Event Resource Provisioning -->
       <sequenceFlow id="SequenceFlow_ResourceProvisioning_End_Analyzing" sourceRef="Task_ResourceProvisioning_Analyze" targetRef="EndEvent_ResourceProvisioning"/>
       <endEvent id="EndEvent_ResourceProvisioning">
         <incoming>SequenceFlow_ResourceProvisioning_End_Normal</incoming>
         <incoming>SequenceFlow_ResourceProvisioning_End_Analyzing</incoming>
       </endEvent>

     </subProcess>

   </process>
 </definitions>