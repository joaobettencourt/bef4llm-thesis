<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="BPMN Process Model" targetNamespace="http://example.com/bpmn">
  <process id="subrogation_process" isExecutable="true">
    <startEvent id="start_event">
      <outgoing>sf_1</outgoing>
    </startEvent>
    <sequenceFlow id="sf_1" sourceRef="start_event" targetRef="task_1"/>
    <task id="task_1" name="Check if Insurant can be subrogated">
      <incoming>sf_1</incoming>
      <outgoing>sf_2</outgoing>
    </task>
    <sequenceFlow id="sf_2" sourceRef="task_1" targetRef="exclusive_gateway_1"/>
    <exclusiveGateway id="exclusive_gateway_1">
      <incoming>sf_2</incoming>
      <outgoing>sf_3</outgoing>
      <outgoing>sf_4</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="sf_3" sourceRef="exclusive_gateway_1" targetRef="task_2">
      <conditionExpression xsi:type="tFormalExpression">${subrogationPossible == true}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="sf_4" sourceRef="exclusive_gateway_1" targetRef="end_event_1">
      <conditionExpression xsi:type="tFormalExpression">${subrogationPossible == false}</conditionExpression>
    </sequenceFlow>
    <endEvent id="end_event_1">
      <incoming>sf_4</incoming>
    </endEvent>
    <task id="task_2" name="Send request for payment and create reminder">
      <incoming>sf_3</incoming>
      <outgoing>sf_5</outgoing>
    </task>
    <sequenceFlow id="sf_5" sourceRef="task_2" targetRef="intermediate_catch_event_1"/>
    <intermediateCatchEvent id="intermediate_catch_event_1">
      <incoming>sf_5</incoming>
      <outgoing>sf_6</outgoing>
      <outgoing>sf_7</outgoing>
    </intermediateCatchEvent>
    <sequenceFlow id="sf_6" sourceRef="intermediate_catch_event_1" targetRef="task_3">
      <conditionExpression xsi:type="tFormalExpression">${paymentReceived == true}</conditionExpression>
    </sequenceFlow>
    <task id="task_3" name="Make booking and close case">
      <incoming>sf_6</incoming>
      <outgoing>sf_8</outgoing>
    </task>
    <sequenceFlow id="sf_8" sourceRef="task_3" targetRef="end_event_2"/>
    <endEvent id="end_event_2">
      <incoming>sf_8</incoming>
    </endEvent>
    <sequenceFlow id="sf_7" sourceRef="intermediate_catch_event_1" targetRef="exclusive_gateway_2"/>
    <exclusiveGateway id="exclusive_gateway_2">
      <incoming>sf_7</incoming>
      <outgoing>sf_9</outgoing>
      <outgoing>sf_10</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="sf_9" sourceRef="exclusive_gateway_2" targetRef="end_event_3">
      <conditionExpression xsi:type="tFormalExpression">${insurantRight == true}</conditionExpression>
    </sequenceFlow>
    <endEvent id="end_event_3">
      <incoming>sf_9</incoming>
    </endEvent>
    <sequenceFlow id="sf_10" sourceRef="exclusive_gateway_2" targetRef="task_4"/>
    <task id="task_4" name="Forward to collection agency">
      <incoming>sf_10</incoming>
      <outgoing>sf_11</outgoing>
    </task>
    <sequenceFlow id="sf_11" sourceRef="task_4" targetRef="end_event_4"/>
    <endEvent id="end_event_4">
      <incoming>sf_11</incoming>
    </endEvent>
  </process>
</definitions>