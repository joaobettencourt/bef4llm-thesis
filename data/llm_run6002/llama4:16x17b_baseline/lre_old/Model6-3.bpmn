<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="BPMN Process Model" targetNamespace="http://example.com/bpmn">
   <process id="ProductionProcess_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>
     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>
     <task id="Task_1" name="Determine necessary parts and quantities as well as delivery date">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="Task_2"/>
     <task id="Task_2" name="Enter data into PPS">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_3" sourceRef="Task_2" targetRef="ExclusiveGateway_1"/>
     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_4</outgoing>
       <outgoing>SequenceFlow_5</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_1" targetRef="Task_3">
       <conditionExpression xsi:type="tFormalExpression">${partsMissing == true}</conditionExpression>
     </sequenceFlow>
     <task id="Task_3" name="Procure missing parts">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_3" targetRef="Task_4"/>
     <sequenceFlow id="SequenceFlow_5" sourceRef="ExclusiveGateway_1" targetRef="Task_4">
       <conditionExpression xsi:type="tFormalExpression">${partsMissing == false}</conditionExpression>
     </sequenceFlow>
     <task id="Task_4" name="Schedule production">
       <incoming>SequenceFlow_5</incoming>
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_7</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_7" sourceRef="Task_4" targetRef="ServiceTask_1"/>
     <serviceTask id="ServiceTask_1" name="Implement production">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_8</outgoing>
     </serviceTask>
     <sequenceFlow id="SequenceFlow_8" sourceRef="ServiceTask_1" targetRef="Task_5"/>
     <task id="Task_5" name="Check order quality">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_5" targetRef="EndEvent_1"/>
     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_9</incoming>
     </endEvent>
   </process>
 </definitions>