<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="BPMN Process Model" targetNamespace="http://example.com/bpmn">

   <process id="SwitchOverProcess" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>

     <task id="Task_1" name="Receive Customer Data">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="Task_2"/>

     <task id="Task_2" name="Enter Customer Data into CRM">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_3" sourceRef="Task_2" targetRef="ExclusiveGateway_1"/>

     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_4</outgoing>
       <outgoing>SequenceFlow_5</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_1" targetRef="Task_3">
       <conditionExpression xsi:type="tFormalExpression">${customerExists == true}</conditionExpression>
     </sequenceFlow>

     <task id="Task_3" name="Compare and Correct Customer Data">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_5" sourceRef="ExclusiveGateway_1" targetRef="Task_4">
       <conditionExpression xsi:type="tFormalExpression">${customerExists == false}</conditionExpression>
     </sequenceFlow>

     <task id="Task_4" name="Create New Customer Object">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_7</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_3" targetRef="Task_5"/>
     <sequenceFlow id="SequenceFlow_7" sourceRef="Task_4" targetRef="Task_5"/>

     <task id="Task_5" name="Prepare Contract Documents">
       <incoming>SequenceFlow_6</incoming>
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_8</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_8" sourceRef="Task_5" targetRef="ServiceTask_1"/>

     <serviceTask id="ServiceTask_1" name="Automated Check of Contract Documents">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_9</outgoing>
       <outgoing>SequenceFlow_10</outgoing>
     </serviceTask>

     <sequenceFlow id="SequenceFlow_9" sourceRef="ServiceTask_1" targetRef="Task_6">
       <conditionExpression xsi:type="tFormalExpression">${checkResult == true}</conditionExpression>
     </sequenceFlow>

     <task id="Task_6" name="Analyze and Resolve Issues">
       <incoming>SequenceFlow_10</incoming>
       <outgoing>SequenceFlow_11</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_10" sourceRef="ServiceTask_1" targetRef="Task_6">
       <conditionExpression xsi:type="tFormalExpression">${checkResult == false}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="SequenceFlow_11" sourceRef="Task_6" targetRef="ServiceTask_2"/>

     <serviceTask id="ServiceTask_2" name="Send Confirmation Document to Customer">
       <incoming>SequenceFlow_11</incoming>
       <outgoing>SequenceFlow_12</outgoing>
     </serviceTask>

     <sequenceFlow id="SequenceFlow_12" sourceRef="ServiceTask_2" targetRef="Task_7"/>

     <task id="Task_7" name="Request Grid Operator Response">
       <incoming>SequenceFlow_12</incoming>
       <outgoing>SequenceFlow_13</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_13" sourceRef="Task_7" targetRef="ExclusiveGateway_2"/>

     <exclusiveGateway id="ExclusiveGateway_2">
       <incoming>SequenceFlow_13</incoming>
       <outgoing>SequenceFlow_14</outgoing>
       <outgoing>SequenceFlow_15</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_14" sourceRef="ExclusiveGateway_2" targetRef="Task_8">
       <conditionExpression xsi:type="tFormalExpression">${gridOperatorResponse == 'supplier concurrence'}</conditionExpression>
     </sequenceFlow>

     <task id="Task_8" name="Resolve Conflict with Old Supplier">
       <incoming>SequenceFlow_14</incoming>
       <outgoing>SequenceFlow_16</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_16" sourceRef="Task_8" targetRef="Task_9"/>

     <sequenceFlow id="SequenceFlow_15" sourceRef="ExclusiveGateway_2" targetRef="Task_9">
       <conditionExpression xsi:type="tFormalExpression">${gridOperatorResponse == 'no objections'}</conditionExpression>
     </sequenceFlow>

     <task id="Task_9" name="Create CIS Contract">
       <incoming>SequenceFlow_15</incoming>
       <incoming>SequenceFlow_16</incoming>
       <outgoing>SequenceFlow_17</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_17" sourceRef="Task_9" targetRef="Task_10"/>

     <task id="Task_10" name="Customer Check and Acceptance">
       <incoming>SequenceFlow_17</incoming>
       <outgoing>SequenceFlow_18</outgoing>
       <outgoing>SequenceFlow_19</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_18" sourceRef="Task_10" targetRef="EndEvent_1">
       <conditionExpression xsi:type="tFormalExpression">${customerAcceptance == true}</conditionExpression>
     </sequenceFlow>

     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_18</incoming>
     </endEvent>

     <sequenceFlow id="SequenceFlow_19" sourceRef="Task_10" targetRef="EndEvent_2">
       <conditionExpression xsi:type="tFormalExpression">${customerAcceptance == false and 7 days passed}</conditionExpression>
     </sequenceFlow>

     <endEvent id="EndEvent_2">
       <incoming>SequenceFlow_19</incoming>
     </endEvent>
   </process>
</definitions>