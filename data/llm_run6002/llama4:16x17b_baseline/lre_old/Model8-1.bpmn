<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="BPMN Process Model" targetNamespace="http://example.com/bpmn">
  <process id="RecruitmentProcess" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="AdvertisePostTask"/>
    <task id="AdvertisePostTask" name="Advertise Post">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_2" sourceRef="AdvertisePostTask" targetRef="CollectApplicationsTask"/>
    <task id="CollectApplicationsTask" name="Collect Applications">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_3" sourceRef="CollectApplicationsTask" targetRef="CheckApplicationsTask"/>
    <task id="CheckApplicationsTask" name="Check Applications">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_4</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_4" sourceRef="CheckApplicationsTask" targetRef="ExclusiveGateway_1"/>
    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_5</outgoing>
      <outgoing>SequenceFlow_6</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_5" sourceRef="ExclusiveGateway_1" targetRef="ConductInterviewsTask">
      <conditionExpression xsi:type="tFormalExpression">${applicationsValid == true}</conditionExpression>
    </sequenceFlow>
    <task id="ConductInterviewsTask" name="Conduct Interviews">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_7" sourceRef="ConductInterviewsTask" targetRef="SelectCandidateTask"/>
    <task id="SelectCandidateTask" name="Select Candidate">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_8" sourceRef="SelectCandidateTask" targetRef="PrepareEmploymentContractTask"/>
    <serviceTask id="PrepareEmploymentContractTask" name="Prepare Employment Contract">
      <incoming>SequenceFlow_8</incoming>
      <outgoing>SequenceFlow_9</outgoing>
    </serviceTask>
    <sequenceFlow id="SequenceFlow_9" sourceRef="PrepareEmploymentContractTask" targetRef="EndEvent_1"/>
    <endEvent id="EndEvent_1">
      <incoming>SequenceFlow_9</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_6" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_2">
      <conditionExpression xsi:type="tFormalExpression">${applicationsValid == false}</conditionExpression>
    </sequenceFlow>
    <endEvent id="EndEvent_2">
      <incoming>SequenceFlow_6</incoming>
    </endEvent>
  </process>
</definitions>