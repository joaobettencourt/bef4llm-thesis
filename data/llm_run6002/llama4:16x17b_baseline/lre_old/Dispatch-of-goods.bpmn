<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" 
             targetNamespace="http://example.com/bpmn">
  <process id="shipment_process" isExecutable="true">
    <startEvent id="start_event">
      <outgoing>sf1</outgoing>
    </startEvent>
    <sequenceFlow id="sf1" sourceRef="start_event" targetRef="task_1"/>
    <task id="task_1" name="Clarify Shipping Method">
      <incoming>sf1</incoming>
      <outgoing>sf2</outgoing>
    </task>
    <sequenceFlow id="sf2" sourceRef="task_1" targetRef="exclusive_gateway_1"/>
    <exclusiveGateway id="exclusive_gateway_1">
      <incoming>sf2</incoming>
      <outgoing>sf3</outgoing>
      <outgoing>sf4</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="sf3" sourceRef="exclusive_gateway_1" targetRef="task_2">
      <conditionExpression xsi:type="tFormalExpression">${shipmentType == 'large'}</conditionExpression>
    </sequenceFlow>
    <task id="task_2" name="Invite Logistic Companies and Select One">
      <incoming>sf3</incoming>
      <outgoing>sf5</outgoing>
    </task>
    <sequenceFlow id="sf4" sourceRef="exclusive_gateway_1" targetRef="task_3">
      <conditionExpression xsi:type="tFormalExpression">${shipmentType == 'small'}</conditionExpression>
    </sequenceFlow>
    <task id="task_3" name="Write Package Label and Insure Parcel (if necessary)">
      <incoming>sf4</incoming>
      <outgoing>sf6</outgoing>
    </task>
    <parallelGateway id="parallel_gateway_1">
      <incoming>sf5</incoming>
      <incoming>sf6</incoming>
      <outgoing>sf7</outgoing>
    </parallelGateway>
    <sequenceFlow id="sf5" sourceRef="task_2" targetRef="parallel_gateway_1"/>
    <sequenceFlow id="sf6" sourceRef="task_3" targetRef="parallel_gateway_1"/>
    <task id="task_4" name="Package Goods">
      <incoming>sf7</incoming>
      <outgoing>sf8</outgoing>
    </task>
    <sequenceFlow id="sf7" sourceRef="parallel_gateway_1" targetRef="task_4"/>
    <task id="task_5" name="Prepare Goods for Pickup">
      <incoming>sf8</incoming>
      <outgoing>sf9</outgoing>
    </task>
    <sequenceFlow id="sf8" sourceRef="task_4" targetRef="task_5"/>
    <endEvent id="end_event">
      <incoming>sf9</incoming>
    </endEvent>
    <sequenceFlow id="sf9" sourceRef="task_5" targetRef="end_event"/>
  </process>
</definitions>