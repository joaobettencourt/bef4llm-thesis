<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="BPMN Process Model" targetNamespace="http://example.com/bpmn">
   <collaboration id="Collaboration_1">
     <participant id="Participant_EC" name="EC" processRef="Process_EC"/>
     <participant id="Participant_INQ" name="INQ" processRef="Process_INQ"/>
     <participant id="Participant_IP" name="IP" processRef="Process_IP"/>
   </collaboration>
   <process id="Process_EC" isExecutable="true">
     <startEvent id="StartEvent_EC1">
       <outgoing>SequenceFlow_EC1</outgoing>
     </startEvent>
     <sequenceFlow id="SequenceFlow_EC1" sourceRef="StartEvent_EC1" targetRef="Task_EC1"/>
     <task id="Task_EC1" name="Tell INQ about master data change">
       <incoming>SequenceFlow_EC1</incoming>
       <outgoing>MessageFlow_11</outgoing>
     </task>
     <messageFlow id="MessageFlow_11" sourceRef="Participant_EC" targetRef="Participant_INQ"/>
   </process>
   <process id="Process_INQ" isExecutable="true">
     <startEvent id="StartEvent_INQ1">
       <incoming>MessageFlow_12</incoming>
       <outgoing>SequenceFlow_INQ1</outgoing>
     </startEvent>
     <messageFlow id="MessageFlow_12" sourceRef="Participant_EC" targetRef="Participant_INQ"/>
     <sequenceFlow id="SequenceFlow_INQ1" sourceRef="StartEvent_INQ1" targetRef="Task_INQ1"/>
     <task id="Task_INQ1" name="Notify IP of change">
       <incoming>SequenceFlow_INQ1</incoming>
       <outgoing>MessageFlow_21</outgoing>
     </task>
     <messageFlow id="MessageFlow_21" sourceRef="Participant_INQ" targetRef="Participant_IP"/>
   </process>
   <process id="Process_IP" isExecutable="true">
     <startEvent id="StartEvent_IP1">
       <incoming>MessageFlow_22</incoming>
       <outgoing>SequenceFlow_IP1</outgoing>
     </startEvent>
     <messageFlow id="MessageFlow_22" sourceRef="Participant_INQ" targetRef="Participant_IP"/>
     <sequenceFlow id="SequenceFlow_IP1" sourceRef="StartEvent_IP1" targetRef="ExclusiveGateway_IP1"/>
     <exclusiveGateway id="ExclusiveGateway_IP1">
       <incoming>SequenceFlow_IP1</incoming>
       <outgoing>SequenceFlow_Confirm1</outgoing>
       <outgoing>SequenceFlow_Reject1</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_Confirm1" sourceRef="ExclusiveGateway_IP1" targetRef="EndEvent_Confirm1">
     </sequenceFlow>
     <endEvent id="EndEvent_Confirm1">
       <incoming>SequenceFlow_Confirm1</incoming>
     </endEvent>
     <sequenceFlow id="SequenceFlow_Reject1" sourceRef="ExclusiveGateway_IP1" targetRef="EndEvent_Reject1">
     </sequenceFlow>
     <endEvent id="EndEvent_Reject1">
       <incoming>SequenceFlow_Reject1</incoming>
     </endEvent>
   </process>
</definitions>