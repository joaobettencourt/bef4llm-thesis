<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="BPMN Process Model" targetNamespace="http://example.com/bpmn">
  <process id="WarrantPossessionProcess" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="ReceiveRequestTask"/>
    <task id="ReceiveRequestTask" name="Receive Warrant Possession Request">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_2" sourceRef="ReceiveRequestTask" targetRef="RetrieveSCTFileTask"/>
    <task id="RetrieveSCTFileTask" name="Retrieve SCTT File">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_3" sourceRef="RetrieveSCTFileTask" targetRef="ForwardWarrantPossessionTask"/>
    <task id="ForwardWarrantPossessionTask" name="Forward SCT Warrant Possession to Queensland Police">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_4</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_4" sourceRef="ForwardWarrantPossessionTask" targetRef="StoreSCTFileTask"/>
    <task id="StoreSCTFileTask" name="Store SCTT Physical File">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_5</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_5" sourceRef="StoreSCTFileTask" targetRef="WaitForReportIntermediateCatchEvent"/>
    <intermediateCatchEvent id="WaitForReportIntermediateCatchEvent">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </intermediateCatchEvent>
    <sequenceFlow id="SequenceFlow_6" sourceRef="WaitForReportIntermediateCatchEvent" targetRef="ReceiveReportTask"/>
    <task id="ReceiveReportTask" name="Receive Report from Police">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_7" sourceRef="ReceiveReportTask" targetRef="RetrieveSCTFileAgainTask"/>
    <task id="RetrieveSCTFileAgainTask" name="Retrieve SCT File">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_8" sourceRef="RetrieveSCTFileAgainTask" targetRef="AttachNewSCTDocumentTask"/>
    <task id="AttachNewSCTDocumentTask" name="Attach New SCT Document">
      <incoming>SequenceFlow_8</incoming>
      <outgoing>SequenceFlow_9</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_9" sourceRef="AttachNewSCTDocumentTask" targetRef="StoreExpandedSCTFileTask"/>
    <task id="StoreExpandedSCTFileTask" name="Store Expanded SCT Physical File">
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_10</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_10" sourceRef="StoreExpandedSCTFileTask" targetRef="EndEvent_1"/>
    <endEvent id="EndEvent_1">
      <incoming>SequenceFlow_10</incoming>
    </endEvent>
  </process>
</definitions>