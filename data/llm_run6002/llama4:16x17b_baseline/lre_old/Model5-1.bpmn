<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="BPMN Process Model">
  <process id="LoanApprovalProcess" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="ServiceTask_1"/>
    <serviceTask id="ServiceTask_1" name="Invoke Risk Assessment Web Service">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </serviceTask>
    <sequenceFlow id="SequenceFlow_2" sourceRef="ServiceTask_1" targetRef="ExclusiveGateway_1"/>
    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
      <outgoing>SequenceFlow_4</outgoing>
      <outgoing>SequenceFlow_5</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_Approved">
      <conditionExpression xsi:type="tFormalExpression">${loanAmount &lt; 10000 and riskLevel == 'low'}</conditionExpression>
    </sequenceFlow>
    <endEvent id="EndEvent_Approved">
      <incoming>SequenceFlow_3</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_Denied">
      <conditionExpression xsi:type="tFormalExpression">${riskLevel == 'high'}</conditionExpression>
    </sequenceFlow>
    <endEvent id="EndEvent_Denied">
      <incoming>SequenceFlow_4</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_5" sourceRef="ExclusiveGateway_1" targetRef="ServiceTask_2">
      <conditionExpression xsi:type="tFormalExpression">${loanAmount >= 10000 or riskLevel == 'review'}</conditionExpression>
    </sequenceFlow>
    <serviceTask id="ServiceTask_2" name="Invoke Approver Web Service">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </serviceTask>
    <sequenceFlow id="SequenceFlow_6" sourceRef="ServiceTask_2" targetRef="EndEvent_3"/>
    <endEvent id="EndEvent_3">
      <incoming>SequenceFlow_6</incoming>
    </endEvent>
  </process>
</definitions>