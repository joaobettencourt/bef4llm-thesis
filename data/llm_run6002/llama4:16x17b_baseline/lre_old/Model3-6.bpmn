<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Claims Notification Process" targetNamespace="http://example.com/bpmn">

   <process id="claimsNotificationProcess" isExecutable="true">
     <startEvent id="start-event">
       <outgoing>sequence-flow-1</outgoing>
     </startEvent>

     <sequenceFlow id="sequence-flow-1" sourceRef="start-event" targetRef="check-insured-status"/>

     <task id="check-insured-status" name="Check Insured Status">
       <incoming>sequence-flow-1</incoming>
       <outgoing>sequence-flow-2</outgoing>
       <outgoing>sequence-flow-3</outgoing>
     </task>

     <exclusiveGateway id="insured-gateway">
       <incoming>sequence-flow-2</incoming>
       <outgoing>sequence-flow-4</outgoing>
       <outgoing>sequence-flow-5</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequence-flow-2" sourceRef="check-insured-status" targetRef="insured-gateway">
       <conditionExpression xsi:type="tFormalExpression">${isInsured == true}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="sequence-flow-3" sourceRef="check-insured-status" targetRef="end-event-reject-claim">
       <conditionExpression xsi:type="tFormalExpression">${isInsured == false}</conditionExpression>
     </sequenceFlow>

     <endEvent id="end-event-reject-claim">
       <incoming>sequence-flow-3</incoming>
     </endEvent>

     <sequenceFlow id="sequence-flow-4" sourceRef="insured-gateway" targetRef="evaluate-claim-severity"/>

     <task id="evaluate-claim-severity" name="Evaluate Claim Severity">
       <incoming>sequence-flow-4</incoming>
       <outgoing>sequence-flow-6</outgoing>
       <outgoing>sequence-flow-7</outgoing>
     </task>

     <exclusiveGateway id="severity-gateway">
       <incoming>sequence-flow-6</incoming>
       <outgoing>sequence-flow-8</outgoing>
       <outgoing>sequence-flow-9</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequence-flow-5" sourceRef="insured-gateway" targetRef="inform-claimant-to-reject"/>

     <task id="inform-claimant-to-reject" name="Inform Claimant to Reject">
       <incoming>sequence-flow-5</incoming>
       <outgoing>sequence-flow-10</outgoing>
     </task>

     <endEvent id="end-event-inform-reject">
       <incoming>sequence-flow-10</incoming>
     </endEvent>

     <sequenceFlow id="sequence-flow-6" sourceRef="evaluate-claim-severity" targetRef="severity-gateway">
       <conditionExpression xsi:type="tFormalExpression">${claimSeverity == 'simple'}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="sequence-flow-7" sourceRef="evaluate-claim-severity" targetRef="send-complex-forms">
       <conditionExpression xsi:type="tFormalExpression">${claimSeverity == 'complex'}</conditionExpression>
     </sequenceFlow>

     <task id="send-simple-forms" name="Send Simple Forms">
       <incoming>sequence-flow-8</incoming>
       <outgoing>sequence-flow-11</outgoing>
     </task>

     <task id="send-complex-forms" name="Send Complex Forms">
       <incoming>sequence-flow-9</incoming>
       <outgoing>sequence-flow-12</outgoing>
     </task>

     <sequenceFlow id="sequence-flow-8" sourceRef="severity-gateway" targetRef="send-simple-forms"/>

     <sequenceFlow id="sequence-flow-9" sourceRef="severity-gateway" targetRef="send-complex-forms"/>

     <task id="check-forms-for-completeness" name="Check Forms for Completeness">
       <incoming>sequence-flow-11</incoming>
       <incoming>sequence-flow-13</incoming>
       <outgoing>sequence-flow-14</outgoing>
       <outgoing>sequence-flow-15</outgoing>
     </task>

     <sequenceFlow id="sequence-flow-10" sourceRef="inform-claimant-to-reject" targetRef="end-event-inform-reject"/>

     <sequenceFlow id="sequence-flow-11" sourceRef="send-simple-forms" targetRef="check-forms-for-completeness"/>
     <sequenceFlow id="sequence-flow-12" sourceRef="send-complex-forms" targetRef="check-forms-for-completeness"/>

     <exclusiveGateway id="completeness-gateway">
       <incoming>sequence-flow-14</incoming>
       <outgoing>sequence-flow-16</outgoing>
       <outgoing>sequence-flow-17</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequence-flow-13" sourceRef="inform-claimant-to-update" targetRef="check-forms-for-completeness"/>

     <task id="inform-claimant-to-update" name="Inform Claimant to Update">
       <incoming>sequence-flow-15</incoming>
       <outgoing>sequence-flow-13</outgoing>
     </task>

     <sequenceFlow id="sequence-flow-14" sourceRef="check-forms-for-completeness" targetRef="completeness-gateway">
       <conditionExpression xsi:type="tFormalExpression">${formsComplete == true}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="sequence-flow-15" sourceRef="check-forms-for-completeness" targetRef="inform-claimant-to-update">
       <conditionExpression xsi:type="tFormalExpression">${formsComplete == false}</conditionExpression>
     </sequenceFlow>

     <task id="register-claim-in-system" name="Register Claim in Claims Management System">
       <incoming>sequence-flow-16</incoming>
       <outgoing>sequence-flow-18</outgoing>
     </task>

     <endEvent id="end-event-register-claim">
       <incoming>sequence-flow-18</incoming>
     </endEvent>

     <sequenceFlow id="sequence-flow-16" sourceRef="completeness-gateway" targetRef="register-claim-in-system"/>

     <sequenceFlow id="sequence-flow-17" sourceRef="completeness-gateway" targetRef="inform-claimant-to-update"/>
     <sequenceFlow id="sequence-flow-18" sourceRef="register-claim-in-system" targetRef="end-event-register-claim"/>
   </process>
</definitions>