<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="BPMN Process Model" targetNamespace="http://example.com/bpmn">
   <process id="IPOProcess" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>
     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_SelectUnderwriters"/>
     <task id="Task_SelectUnderwriters" name="Select Underwriters">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_SelectUnderwriters" targetRef="ParallelGateway_1"/>
     <parallelGateway id="ParallelGateway_1">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_4</outgoing>
     </parallelGateway>
     <sequenceFlow id="SequenceFlow_3" sourceRef="ParallelGateway_1" targetRef="Task_PrepareRegistrationStatement"/>
     <task id="Task_PrepareRegistrationStatement" name="Prepare Registration Statement and comply with Blue-Sky Laws">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_PrepareRegistrationStatement" targetRef="ExclusiveGateway_1"/>
     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_7</outgoing>
       <outgoing>SequenceFlow_8</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_7" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_SECApproval">
       <conditionExpression xsi:type="tFormalExpression">${SECApprovesRegistrationStatement}</conditionExpression>
     </sequenceFlow>
     <endEvent id="EndEvent_SECApproval">
       <incoming>SequenceFlow_7</incoming>
     </endEvent>
     <sequenceFlow id="SequenceFlow_8" sourceRef="ExclusiveGateway_1" targetRef="Task_FirmUpIssuePriceAndRoadShow"/>
     <task id="Task_FirmUpIssuePriceAndRoadShow" name="Firm up Issue Price and Road Show">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_FirmUpIssuePriceAndRoadShow" targetRef="ExclusiveGateway_1"/>
     <sequenceFlow id="SequenceFlow_4" sourceRef="ParallelGateway_1" targetRef="Task_FirmUpIssuePriceAndRoadShow"/>
     <task id="Task_FixIssuePriceAndEnterFirmCommitment" name="Fix Issue Price and Enter into Firm Commitment">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_FixIssuePriceAndEnterFirmCommitment" targetRef="EndEvent_IPOComplete"/>
     <endEvent id="EndEvent_IPOComplete">
       <incoming>SequenceFlow_9</incoming>
     </endEvent>
   </process>
 </definitions>