<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL
                                 http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Car Service Process" targetNamespace="http://example.com/bpmn">

   <process id="carServiceProcess" isExecutable="true">
     <startEvent id="serviceNeeded1" name="Service Needed">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="serviceNeeded1" targetRef="exclusiveGateway1"/>

     <exclusiveGateway id="exclusiveGateway1" name="Is Car Registered?">
       <incoming>sequenceFlow1</incoming>
       <outgoing>registered</outgoing>
       <outgoing>notRegistered</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="registered" sourceRef="exclusiveGateway1" targetRef="notifyCustomer"/>
     <sequenceFlow id="notRegistered" sourceRef="exclusiveGateway1" targetRef="endNotRegistered"/>

     <task id="notifyCustomer1" name="Notify Customer">
       <incoming>registered</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow2" sourceRef="notifyCustomer1" targetRef="exclusiveGateway2"/>

     <exclusiveGateway id="exclusiveGateway2" name="Did Customer Go to Service?">
       <incoming>sequenceFlow2</incoming>
       <outgoing>wentToService</outgoing>
       <outgoing>fineCustomer</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="wentToService" sourceRef="exclusiveGateway2" targetRef="startService"/>
     <sequenceFlow id="fineCustomer" sourceRef="exclusiveGateway2" targetRef="sendFine">

     </sequenceFlow>

     <task id="startService1" name="Start Service">
       <incoming>wentToService</incoming>
       <outgoing>sequenceFlow3</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow3" sourceRef="startService1" targetRef="parallelGateway1"/>

     <parallelGateway id="parallelGateway1">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow4</outgoing>
       <outgoing>sequenceFlow5</outgoing>
     </parallelGateway>

     <task id="enterProblems1" name="Enter Problems">
       <incoming>sequenceFlow4</incoming>
     </task>

     <sequenceFlow id="sequenceFlow4" sourceRef="parallelGateway1" targetRef="enterProblems1"/>

     <task id="sendStatusUpdates1" name="Send Status Updates">
       <incoming>sequenceFlow5</incoming>
     </task>

     <sequenceFlow id="sequenceFlow5" sourceRef="parallelGateway1" targetRef="sendStatusUpdates1"/>

     <task id="taskProgress1" name="Task in Progress">
       <incoming>enterProblems1</incoming>
       <outgoing>sequenceFlow6</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow6" sourceRef="taskProgress1" targetRef="endService1"/>

     <task id="endService1" name="End Service">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow7</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow7" sourceRef="endService1" targetRef="exclusiveGateway3"/>

     <exclusiveGateway id="exclusiveGateway3" name="Payment and Next Service">
       <incoming>sequenceFlow7</incoming>
       <outgoing>paid</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="paid" sourceRef="exclusiveGateway3" targetRef="end"/>

     <task id="sendFine1" name="Send Fine">
       <incoming>fineCustomer</incoming>
     </task>

     <endEvent id="endNotRegistered1" name="End Not Registered">
       <incoming>notRegistered</incoming>
     </endEvent>

     <endEvent id="end1" name="Car Service Finished">
       <incoming>paid</incoming>
     </endEvent>

   </process>

</definitions>