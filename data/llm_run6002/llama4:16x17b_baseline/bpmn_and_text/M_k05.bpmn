<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL
                                 http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Building a House" targetNamespace="http://example.com/bpmn">

   <process id="buildingHouseProcess" isExecutable="true">
     <startEvent id="startEvent1" name="Start Building Tree House">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <task id="collectRequirementsTask" name="Collect Requirements">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="collectRequirementsTask"/>
     <sequenceFlow id="sequenceFlow2" sourceRef="collectRequirementsTask" targetRef="sendToArchitectTask"/>

     <task id="sendToArchitectTask" name="Send Requirements to Architect">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow3" sourceRef="sendToArchitectTask" targetRef="refineDraftSubProcess"/>

     <subProcess id="refineDraftSubProcess" name="Refine Draft">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow4</outgoing>

       <startEvent id="draftReceivedEvent" name="Draft Received">
         <incoming>sequenceFlow3</incoming>
         <outgoing>sequenceFlow5</outgoing>
       </startEvent>

       <task id="refineRequirementsTask" name="Refine Requirements and Send Back">
         <incoming>sequenceFlow5</incoming>
         <outgoing>sequenceFlow6</outgoing>
       </task>

       <sequenceFlow id="sequenceFlow5" sourceRef="draftReceivedEvent" targetRef="refineRequirementsTask"/>
       <sequenceFlow id="sequenceFlow6" sourceRef="refineRequirementsTask" targetRef="createMaterialListTask"/>

       <endEvent id="draftFinalizedEvent" name="Draft Finalized">
         <incoming>sequenceFlow4</incoming>
       </endEvent>
     </subProcess>

     <task id="createMaterialListTask" name="Create List of Needed Materials">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow7</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow7" sourceRef="createMaterialListTask" targetRef="orderMaterialsSubProcess"/>

     <subProcess id="orderMaterialsSubProcess" name="Order Materials from Online Stores">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow8</outgoing>

       <startEvent id="materialsOrderedEvent" name="Materials Ordered">
         <incoming>sequenceFlow7</incoming>
         <outgoing>sequenceFlow9</outgoing>
       </startEvent>

       <task id="processOrderTask" name="Process Order in Online Stores">
         <incoming>sequenceFlow9</incoming>
         <outgoing>sequenceFlow10</outgoing>
       </task>

       <sequenceFlow id="sequenceFlow9" sourceRef="materialsOrderedEvent" targetRef="processOrderTask"/>
       <sequenceFlow id="sequenceFlow10" sourceRef="processOrderTask" targetRef="notifyFriendsTask"/>

       <endEvent id="orderProcessedEvent" name="Order Processed">
         <incoming>sequenceFlow8</incoming>
       </endEvent>
     </subProcess>

     <task id="notifyFriendsTask" name="Notify Friends to Build House">
       <incoming>sequenceFlow10</incoming>
       <outgoing>sequenceFlow11</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow11" sourceRef="notifyFriendsTask" targetRef="houseBuiltTask"/>

     <task id="houseBuiltTask" name="House Built">
       <incoming>sequenceFlow11</incoming>
       <outgoing>sequenceFlow12</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow12" sourceRef="houseBuiltTask" targetRef="sendInvitationsTask"/>

     <task id="sendInvitationsTask" name="Send Invitations for Tree House Party">
       <incoming>sequenceFlow12</incoming>
       <outgoing>sequenceFlow13</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow13" sourceRef="sendInvitationsTask" targetRef="collectAttendeesTask"/>

     <task id="collectAttendeesTask" name="Collect List of Attendees">
       <incoming>sequenceFlow13</incoming>
       <outgoing>sequenceFlow14</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow14" sourceRef="collectAttendeesTask" targetRef="buySnacksTask"/>

     <task id="buySnacksTask" name="Buy Snacks for Party">
       <incoming>sequenceFlow14</incoming>
       <outgoing>sequenceFlow15</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow15" sourceRef="buySnacksTask" targetRef="endEvent1"/>

     <endEvent id="endEvent1" name="Tree House Party Ready">
       <incoming>sequenceFlow15</incoming>
     </endEvent>

   </process>

</definitions>