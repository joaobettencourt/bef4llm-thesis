<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xmlns="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL
                                 http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             targetNamespace="http://bpmn.io/schema/bpmn"
             id="definition" name="Instruct Artist and 3D Print Model">

    <process id="instructArtistAndPrintModel" isExecutable="true">
      <!-- Start Event  -->
      <startEvent id="startEvent" name="Craving a Custom 3D Model">
        <outgoing>sequenceFlow1</outgoing>
      </startEvent>

      <!-- Task: Send Sketches to Artist  -->
      <task id="sendSketchesToArtist" name="Send Sketches and Instruct Artist">
        <incoming>sequenceFlow1</incoming>
        <outgoing>sequenceFlow2</outgoing>
      </task>
      <sequenceFlow id="sequenceFlow1" sourceRef="startEvent" targetRef="sendSketchesToArtist"/>
      <sequenceFlow id="sequenceFlow2" sourceRef="sendSketchesToArtist" targetRef="modelReady"/>

      <!-- Event: Model Ready  -->
      <intermediateCatchEvent id="modelReady" name="Model Created by Artist">
        <incoming>sequenceFlow2</incoming>
        <outgoing>sequenceFlow3</outgoing>
      </intermediateCatchEvent>
      <sequenceFlow id="sequenceFlow3" sourceRef="modelReady" targetRef="choosePlasticColor"/>

      <!-- Task: Choose Color  -->
      <task id="choosePlasticColor" name="Choose Plastic Color for 3D Printing">
        <incoming>sequenceFlow3</incoming>
        <outgoing>sequenceFlow4</outgoing>
      </task>
      <sequenceFlow id="sequenceFlow4" sourceRef="choosePlasticColor" targetRef="hasColorGateway"/>

      <!-- Gateway: Has Color  -->
      <exclusiveGateway id="hasColorGateway" name="Do You Have the Color?">
        <incoming>sequenceFlow4</incoming>
        <outgoing>sequenceFlow5</outgoing>
        <outgoing>sequenceFlow10</outgoing>
      </exclusiveGateway>

      <!-- Sequence Flow: True (Has Color)  -->
      <sequenceFlow id="sequenceFlow5" sourceRef="hasColorGateway" targetRef="checkColorQuantity">
        <conditionExpression xsi:type="tFormalExpression">${quantity > 0}</conditionExpression>
      </sequenceFlow>

      <!-- Task: Check Color Quantity  -->
      <task id="checkColorQuantity" name="Check How Much Color You Have Left">
        <incoming>sequenceFlow5</incoming>
        <outgoing>sequenceFlow6</outgoing>
      </task>
      <sequenceFlow id="sequenceFlow6" sourceRef="checkColorQuantity" targetRef="quantityGateway"/>

      <!-- Gateway: Quantity Gateway  -->
      <exclusiveGateway id="quantityGateway" name="Is There Enough Color?">
        <incoming>sequenceFlow6</incoming>
        <outgoing>sequenceFlow7</outgoing>
        <outgoing>sequenceFlow8</outgoing>
      </exclusiveGateway>

      <!-- Sequence Flow: Sufficient  -->
      <sequenceFlow id="sequenceFlow7" sourceRef="quantityGateway" targetRef="prepare3DPrinter">
        <conditionExpression xsi:type="tFormalExpression">${quantity >= 100}</conditionExpression>
      </sequenceFlow>

      <!-- Task: Add to Shopping List  -->
      <task id="addToShoppingList" name="Add Color to Your Shopping List">
        <incoming>sequenceFlow8</incoming>
        <outgoing>sequenceFlow9</outgoing>
      </task>
      <sequenceFlow id="sequenceFlow8" sourceRef="quantityGateway" targetRef="addToShoppingList"/>
      <sequenceFlow id="sequenceFlow9" sourceRef="addToShoppingList" targetRef="prepare3DPrinter"/>

      <!-- Sequence Flow: False (Order Color)  -->
      <sequenceFlow id="sequenceFlow10" sourceRef="hasColorGateway" targetRef="orderPlasticColor">
        <conditionExpression xsi:type="tFormalExpression">${quantity == 0}</conditionExpression>
      </sequenceFlow>

      <!-- Task: Order Color  -->
      <task id="orderPlasticColor" name="Order Plastic Color">
        <incoming>sequenceFlow10</incoming>
        <outgoing>sequenceFlow11</outgoing>
      </task>
      <sequenceFlow id="sequenceFlow11" sourceRef="orderPlasticColor" targetRef="prepare3DPrinter"/>

      <!-- Task: Prepare for Printing  -->
      <task id="prepare3DPrinter" name="Turn On Printer, Heat Bed and Extruder">
        <incoming>sequenceFlow7</incoming>
        <incoming>sequenceFlow9</incoming>
        <incoming>sequenceFlow11</incoming>
        <outgoing>sequenceFlow12</outgoing>
      </task>

      <!-- Task: Generate G-Code  -->
      <task id="generateGCodeFile" name="Generate G-Code File for Your Printer">
        <incoming>sequenceFlow12</incoming>
        <outgoing>sequenceFlow13</outgoing>
      </task>
      <sequenceFlow id="sequenceFlow12" sourceRef="prepare3DPrinter" targetRef="generateGCodeFile"/>

      <!-- Task: Print Model  -->
      <task id="print3DModel" name="Print Your 3D Model">
        <incoming>sequenceFlow13</incoming>
        <outgoing>sequenceFlow14</outgoing>
      </task>
      <sequenceFlow id="sequenceFlow13" sourceRef="generateGCodeFile" targetRef="print3DModel"/>

      <!-- End Event  -->
      <endEvent id="endEvent" name="3D Model Printed">
        <incoming>sequenceFlow14</incoming>
      </endEvent>
      <sequenceFlow id="sequenceFlow14" sourceRef="print3DModel" targetRef="endEvent"/>
    </process>

</definitions>