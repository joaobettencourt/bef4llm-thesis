<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL
                                 http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Building a custom machine out of Lego bricks"
             targetNamespace="http://example.com/bpmn">

   <process id="buildingMachineProcess" isExecutable="true">
     <startEvent id="startEvent1" name="Start Building Machine">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <task id="developBasicDesignTask" name="Develop Basic Design">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="developBasicDesignTask"/>
     <sequenceFlow id="sequenceFlow2" sourceRef="developBasicDesignTask" targetRef="orderLegoBrickSetsTask"/>

     <task id="orderLegoBrickSetsTask" name="Order Lego Brick Sets">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow3" sourceRef="orderLegoBrickSetsTask" targetRef="sortPartsTask"/>

     <task id="sortPartsTask" name="Sort Parts (by children)">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow4</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow4" sourceRef="sortPartsTask" targetRef="buildSubcomponentsSubProcess"/>

     <subProcess id="buildSubcomponentsSubProcess" name="Build Subcomponents">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow5</outgoing>

       <startEvent id="buildSubcomponentStart" name="Build Subcomponent Start">
         <incoming>defaultFlow2</incoming>
         <outgoing>buildSubcomponentTask</outgoing>
       </startEvent>

       <task id="buildSubcomponentTask" name="Build Subcomponent">
         <incoming>buildSubcomponentStart</incoming>
         <outgoing>testSubcomponentSequenceFlow</outgoing>
       </task>

       <sequenceFlow id="defaultFlow2" sourceRef="buildSubcomponentsSubProcess" targetRef="buildSubcomponentStart"/>
       <sequenceFlow id="buildSubcomponentSequenceFlow" sourceRef="buildSubcomponentTask" targetRef="exclusiveGateway1"/>

       <exclusiveGateway id="exclusiveGateway1" name="Test Subcomponent">
         <incoming>buildSubcomponentSequenceFlow</incoming>
         <outgoing>testSuccessfulSequenceFlow</outgoing>
         <outgoing>testFailedSequenceFlow</outgoing>
       </exclusiveGateway>

       <sequenceFlow id="testSuccessfulSequenceFlow" sourceRef="exclusiveGateway1" targetRef="assembleSubcomponentsTask"
                    name="Test Successful">
       </sequenceFlow>

       <sequenceFlow id="testFailedSequenceFlow" sourceRef="exclusiveGateway1" targetRef="redesignAndRebuildSubcomponentSubProcess"
                    name="Test Failed">
       </sequenceFlow>

       <subProcess id="redesignAndRebuildSubcomponentSubProcess" name="Redesign and Rebuild Subcomponent">
         <incoming>testFailedSequenceFlow</incoming>
         <outgoing>rebuildFlow</outgoing>
       </subProcess>

       <sequenceFlow id="rebuildFlow" sourceRef="redesignAndRebuildSubcomponentSubProcess" targetRef="buildSubcomponentStart"/>

       <task id="assembleSubcomponentsTask" name="Assemble Subcomponents">
         <incoming>testSuccessfulSequenceFlow</incoming>
         <outgoing>sequenceFlow5</outgoing>
       </task>

       <sequenceFlow id="sequenceFlow5" sourceRef="assembleSubcomponentsTask" targetRef="endEvent1"/>
     </subProcess>

     <endEvent id="endEvent1" name="Machine Built">
       <incoming>sequenceFlow5</incoming>
     </endEvent>

   </process>

</definitions>