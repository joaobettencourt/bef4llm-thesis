<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL
                                 http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Robotic Burger Seller" targetNamespace="http://example.com/bpmn">

   <process id="roboticBurgerSellerProcess" isExecutable="true">
     <startEvent id="orderReceived" name="Order Received">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <exclusiveGateway id="menuOrNotGateway" name="Does customer want a menu?">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
       <outgoing>sequenceFlow3</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow1" sourceRef="orderReceived" targetRef="menuOrNotGateway"/>

     <subProcess id="prepareDrinkAndSidesSubprocess">
       <incoming>sequenceFlow2</incoming>
       <startEvent id="startPreparingDrink" name="Start Preparing Drink">
         <outgoing>sequenceFlow4</outgoing>
       </startEvent>

       <task id="getFriesOrWedgesTask" name="Ask for Fries or Wedges">
         <incoming>sequenceFlow4</incoming>
         <outgoing>sequenceFlow5</outgoing>
         <outgoing>sequenceFlow6</outgoing>
       </task>

       <exclusiveGateway id="friesOrWedgesGateway">
         <incoming>sequenceFlow5</incoming>
         <outgoing>sequenceFlow7</outgoing>
         <outgoing>sequenceFlow8</outgoing>
       </exclusiveGateway>

       <subProcess id="prepareFriesSubprocess">
         <incoming>sequenceFlow7</incoming>
       </subProcess>

       <subProcess id="prepareWedgesSubprocess">
         <incoming>sequenceFlow8</incoming>
       </subProcess>

       <task id="prepareBurgerTask" name="Prepare Burger">
         <outgoing>sequenceFlow9</outgoing>
       </task>

       <sequenceFlow id="sequenceFlow2" sourceRef="menuOrNotGateway" targetRef="startPreparingDrink"/>
       <sequenceFlow id="sequenceFlow4" sourceRef="startPreparingDrink" targetRef="getFriesOrWedgesTask"/>
       <sequenceFlow id="sequenceFlow5" sourceRef="getFriesOrWedgesTask" targetRef="friesOrWedgesGateway"/>
       <sequenceFlow id="sequenceFlow7" sourceRef="friesOrWedgesGateway" targetRef="prepareFriesSubprocess"/>
       <sequenceFlow id="sequenceFlow8" sourceRef="friesOrWedgesGateway" targetRef="prepareWedgesSubprocess"/>
       <sequenceFlow id="sequenceFlow9" sourceRef="prepareBurgerTask" targetRef="endEvent1"/>

     </subProcess>

     <task id="prepareBurgerMainTask" name="Prepare Burger">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow10</outgoing>
     </task>

     <serviceTask id="giveStatusUpdatesTask" name="Give Status Updates">
       <incoming>sequenceFlow10</incoming>
       <outgoing>sequenceFlow11</outgoing>
     </serviceTask>

     <endEvent id="endEvent1" name="Order Delivered">
       <incoming>sequenceFlow11</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow3" sourceRef="menuOrNotGateway" targetRef="prepareBurgerMainTask"/>
     <sequenceFlow id="sequenceFlow10" sourceRef="prepareBurgerMainTask" targetRef="giveStatusUpdatesTask"/>
     <sequenceFlow id="sequenceFlow11" sourceRef="giveStatusUpdatesTask" targetRef="endEvent1"/>

   </process>
</definitions>