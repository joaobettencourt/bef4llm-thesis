<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL
                                 http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" 
             targetNamespace="http://example.com/becoming-a-parent">

   <process id="becomingAParentProcess" isExecutable="true">
     <startEvent id="startEvent1" name="Start Planning">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <task id="fetchInformationTask" name="Fetch Information About Potential Models">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="fetchInformationTask"/>
     <sequenceFlow id="sequenceFlow2" sourceRef="fetchInformationTask" targetRef="selectModelTask"/>

     <task id="selectModelTask" name="Select Maternity Leave Model">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow3" sourceRef="selectModelTask" targetRef="collectRelevantInformationTask"/>

     <task id="collectRelevantInformationTask" name="Collect Relevant Information">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow4</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow4" sourceRef="collectRelevantInformationTask" targetRef="notifySocialSecurityAndCompanyTask"/>

     <task id="notifySocialSecurityAndCompanyTask" name="Notify Social Security and Company">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow5</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow5" sourceRef="notifySocialSecurityAndCompanyTask" targetRef="gatherInformationFromCompaniesTask"/>

     <task id="gatherInformationFromCompaniesTask" name="Gather Information from Companies">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow6</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow6" sourceRef="gatherInformationFromCompaniesTask" targetRef="decideAboutExtensionGateway"/>

     <exclusiveGateway id="decideAboutExtensionGateway" name="Decide About Extension">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow7</outgoing>
       <outgoing>sequenceFlow8</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow7" sourceRef="decideAboutExtensionGateway" targetRef="extendMaternityLeaveTask">
       <conditionExpression xsi:type="tFormalExpression">extensionNeeded</conditionExpression>
     </sequenceFlow>

     <task id="extendMaternityLeaveTask" name="Extend Maternity Leave">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow9</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow8" sourceRef="decideAboutExtensionGateway" targetRef="endEvent1">
       <conditionExpression xsi:type="tFormalExpression">noExtensionNeeded</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="sequenceFlow9" sourceRef="extendMaternityLeaveTask" targetRef="endEvent1"/>

     <endEvent id="endEvent1" name="End of Maternity Leave Planning">
       <incoming>sequenceFlow8</incoming>
       <incoming>sequenceFlow9</incoming>
     </endEvent>

   </process>

</definitions>