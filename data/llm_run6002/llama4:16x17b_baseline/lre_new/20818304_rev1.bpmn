<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Credit Process">

  <process id="creditProcess" isExecutable="true">
    <startEvent id="startEvent1">
      <outgoing>sequenceFlow1</outgoing>
    </startEvent>

    <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="exclusiveGateway1"/>

    <exclusiveGateway id="exclusiveGateway1">
      <incoming>sequenceFlow1</incoming>
      <outgoing>sequenceFlow2</outgoing>
      <outgoing>sequenceFlow3</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequenceFlow2" name="Amount > 1M$" sourceRef="exclusiveGateway1" targetRef="serviceTask1">
      <conditionExpression xsi:type="tFormalExpression">${amount > 1000000}</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="sequenceFlow3" name="Amount <= 1M$" sourceRef="exclusiveGateway1" targetRef="serviceTask2">
      <conditionExpression xsi:type="tFormalExpression">${amount <= 1000000}</conditionExpression>
    </sequenceFlow>

    <serviceTask id="serviceTask1" name="Request Approval">
      <incoming>sequenceFlow2</incoming>
      <outgoing>sequenceFlow4</outgoing>
    </serviceTask>

    <serviceTask id="serviceTask2" name="Assess Risk">
      <incoming>sequenceFlow3</incoming>
      <outgoing>sequenceFlow5</outgoing>
      <outgoing>sequenceFlow6</outgoing>
    </serviceTask>

    <exclusiveGateway id="exclusiveGateway2">
      <incoming>sequenceFlow5</incoming>
      <outgoing>sequenceFlow7</outgoing>
      <outgoing>sequenceFlow8</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequenceFlow5" name="Risk Low" sourceRef="serviceTask2" targetRef="exclusiveGateway2">
      <conditionExpression xsi:type="tFormalExpression">${risk == 'low'}</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="sequenceFlow6" name="Risk High" sourceRef="serviceTask2" targetRef="serviceTask1"/>

    <sequenceFlow id="sequenceFlow7" name="Accept Credit" sourceRef="exclusiveGateway2" targetRef="endEvent1">
      <conditionExpression xsi:type="tFormalExpression">${approval == 'accepted'}</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="sequenceFlow8" name="Request Approval Again" sourceRef="exclusiveGateway2" targetRef="serviceTask1"/>

    <sequenceFlow id="sequenceFlow4" sourceRef="serviceTask1" targetRef="exclusiveGateway3"/>

    <exclusiveGateway id="exclusiveGateway3">
      <incoming>sequenceFlow4</incoming>
      <outgoing>sequenceFlow9</outgoing>
      <outgoing>sequenceFlow10</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequenceFlow9" name="Accept Credit" sourceRef="exclusiveGateway3" targetRef="endEvent1">
      <conditionExpression xsi:type="tFormalExpression">${approval == 'accepted'}</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="sequenceFlow10" name="Reject Credit" sourceRef="exclusiveGateway3" targetRef="endEvent2">
      <conditionExpression xsi:type="tFormalExpression">${approval == 'rejected'}</conditionExpression>
    </sequenceFlow>

    <endEvent id="endEvent1" name="Credit Accepted">
      <incoming>sequenceFlow7</incoming>
      <incoming>sequenceFlow9</incoming>
      <outgoing>sequenceFlow11</outgoing>
    </endEvent>

    <endEvent id="endEvent2" name="Credit Rejected">
      <incoming>sequenceFlow10</incoming>
      <outgoing>sequenceFlow12</outgoing>
    </endEvent>

    <sequenceFlow id="sequenceFlow11" sourceRef="endEvent1" targetRef="serviceTask3"/>

    <sequenceFlow id="sequenceFlow12" sourceRef="endEvent2" targetRef="serviceTask3"/>

    <serviceTask id="serviceTask3" name="Send Email to Customer">
      <incoming>sequenceFlow11</incoming>
      <incoming>sequenceFlow12</incoming>
    </serviceTask>

  </process>

</definitions>