<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="PayPal Bank Account Linking Process">

  <process id="bankAccountLinkingProcess" isExecutable="true">
    <startEvent id="startEvent1">
      <outgoing>sequenceFlow1</outgoing>
    </startEvent>

    <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="enterBankDetailsTask"/>

    <userTask id="enterBankDetailsTask" name="Enter Bank Details">
      <incoming>sequenceFlow1</incoming>
      <outgoing>sequenceFlow2</outgoing>
    </userTask>

    <sequenceFlow id="sequenceFlow2" sourceRef="enterBankDetailsTask" targetRef="submitBankDetailsTask"/>

    <serviceTask id="submitBankDetailsTask" name="Submit Bank Details to PayPal System">
      <incoming>sequenceFlow2</incoming>
      <outgoing>sequenceFlow3</outgoing>
    </serviceTask>

    <sequenceFlow id="sequenceFlow3" sourceRef="submitBankDetailsTask" targetRef="makeDepositsTask"/>

    <serviceTask id="makeDepositsTask" name="Make Two Random Deposits into Bank Account">
      <incoming>sequenceFlow3</incoming>
      <outgoing>sequenceFlow4</outgoing>
    </serviceTask>

    <sequenceFlow id="sequenceFlow4" sourceRef="makeDepositsTask" targetRef="notifyClientTask"/>

    <userTask id="notifyClientTask" name="Notify Client to Verify Deposits">
      <incoming>sequenceFlow4</incoming>
      <outgoing>sequenceFlow5</outgoing>
    </userTask>

    <sequenceFlow id="sequenceFlow5" sourceRef="notifyClientTask" targetRef="verifyDepositsTask"/>

    <userTask id="verifyDepositsTask" name="Verify Deposits">
      <incoming>sequenceFlow5</incoming>
      <outgoing>sequenceFlow6</outgoing>
      <outgoing>sequenceFlow7</outgoing>
    </userTask>

    <exclusiveGateway id="verificationResultGateway1">
      <incoming>sequenceFlow6</incoming>
      <incoming>sequenceFlow7</incoming>
      <outgoing>sequenceFlow8</outgoing>
      <outgoing>sequenceFlow9</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequenceFlow6" sourceRef="verifyDepositsTask" targetRef="verificationResultGateway1">
      <conditionExpression xsi:type="tFormalExpression">${valuesMatch == true}</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="sequenceFlow7" sourceRef="verifyDepositsTask" targetRef="verificationResultGateway1">
      <conditionExpression xsi:type="tFormalExpression">${valuesMatch == false}</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="sequenceFlow8" sourceRef="verificationResultGateway1" targetRef="linkBankAccountTask"/>

    <serviceTask id="linkBankAccountTask" name="Link Bank Account to PayPal Account">
      <incoming>sequenceFlow8</incoming>
      <outgoing>sequenceFlow10</outgoing>
    </serviceTask>

    <sequenceFlow id="sequenceFlow10" sourceRef="linkBankAccountTask" targetRef="endEvent1"/>

    <sequenceFlow id="sequenceFlow9" sourceRef="verificationResultGateway1" targetRef="removeBankAccountTask"/>

    <serviceTask id="removeBankAccountTask" name="Remove Bank Account from PayPal System">
      <incoming>sequenceFlow9</incoming>
      <outgoing>sequenceFlow11</outgoing>
    </serviceTask>

    <sequenceFlow id="sequenceFlow11" sourceRef="removeBankAccountTask" targetRef="endEvent2"/>

    <endEvent id="endEvent1">
      <incoming>sequenceFlow10</incoming>
    </endEvent>

    <endEvent id="endEvent2">
      <incoming>sequenceFlow11</incoming>
    </endEvent>
  </process>
</definitions>