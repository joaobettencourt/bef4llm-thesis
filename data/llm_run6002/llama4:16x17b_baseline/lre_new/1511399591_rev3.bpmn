<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
                  id="definitions" name="Business Process Model">
  <bpmn:process id="businessProcess" isExecutable="true">
    <bpmn:startEvent id="startEvent1">
      <bpmn:outgoing>sequenceFlow1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="collectDataTask" name="Collect Data and Conduct Business Analysis">
      <bpmn:incoming>sequenceFlow1</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="collectDataTask"/>
    <bpmn:sequenceFlow id="sequenceFlow2" sourceRef="collectDataTask" targetRef="integrateDesignTask"/>

    <bpmn:task id="integrateDesignTask" name="Integrate Design and Decide Placement">
      <bpmn:incoming>sequenceFlow2</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow3</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="checkDesignTask" name="Check Design and Provide Feedback">
      <bpmn:incoming>sequenceFlow3</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow4</bpmn:outgoing>
      <bpmn:outgoing>sequenceFlow5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="sequenceFlow3" sourceRef="integrateDesignTask" targetRef="checkDesignTask"/>

    <bpmn:exclusiveGateway id="exclusiveGateway1">
      <bpmn:incoming>sequenceFlow4</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow6</bpmn:outgoing>
      <bpmn:outgoing>sequenceFlow7</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="sequenceFlow4" sourceRef="checkDesignTask" targetRef="exclusiveGateway1">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${designAccepted}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="sequenceFlow5" sourceRef="checkDesignTask" targetRef="integrateDesignTask">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${designNeedsAdjustment}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="sequenceFlow6" sourceRef="exclusiveGateway1" targetRef="integrateImplementationTask">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${designAccepted}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:task id="integrateImplementationTask" name="Integrate with Overall Implementation">
      <bpmn:incoming>sequenceFlow6</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow8</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="testWebsiteTask" name="Test Website">
      <bpmn:incoming>sequenceFlow8</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow9</bpmn:outgoing>
      <bpmn:outgoing>sequenceFlow10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="sequenceFlow8" sourceRef="integrateImplementationTask" targetRef="testWebsiteTask"/>

    <bpmn:exclusiveGateway id="exclusiveGateway2">
      <bpmn:incoming>sequenceFlow9</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow11</bpmn:outgoing>
      <bpmn:outgoing>sequenceFlow12</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="sequenceFlow9" sourceRef="testWebsiteTask" targetRef="exclusiveGateway2">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${testPassed}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:endEvent id="endEvent1">
      <bpmn:incoming>sequenceFlow11</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="sequenceFlow11" sourceRef="exclusiveGateway2" targetRef="endEvent1">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${testPassed}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:task id="adjustImplementationTask" name="Adjust According to Test Results and Integrate">
      <bpmn:incoming>sequenceFlow10</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="sequenceFlow10" sourceRef="testWebsiteTask" targetRef="adjustImplementationTask"/>
    <bpmn:sequenceFlow id="sequenceFlow12" sourceRef="exclusiveGateway2" targetRef="adjustImplementationTask">
      <bpmn:conditionExpression xsi:type="tFormalExpression">${testFailed}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="sequenceFlow13" sourceRef="adjustImplementationTask" targetRef="integrateImplementationTask"/>
  </bpmn:process>
</bpmn:definitions>