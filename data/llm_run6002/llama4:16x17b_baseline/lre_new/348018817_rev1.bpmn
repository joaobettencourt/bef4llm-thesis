<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Expense Report Process">

  <process id="expenseReportProcess" isExecutable="true">
    <startEvent id="startEvent1">
      <outgoing>sequenceFlow1</outgoing>
    </startEvent>

    <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="task1"/>

    <task id="task1" name="Receive Expense Report">
      <incoming>sequenceFlow1</incoming>
      <outgoing>sequenceFlow2</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow2" sourceRef="task1" targetRef="exclusiveGateway1"/>

    <exclusiveGateway id="exclusiveGateway1">
      <incoming>sequenceFlow2</incoming>
      <outgoing>sequenceFlow3</outgoing>
      <outgoing>sequenceFlow4</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequenceFlow3" sourceRef="exclusiveGateway1" targetRef="task5">
      <conditionExpression xsi:type="tFormalExpression">${hasAccount == true}</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="sequenceFlow4" sourceRef="exclusiveGateway1" targetRef="task2">
      <conditionExpression xsi:type="tFormalExpression">${hasAccount == false}</conditionExpression>
    </sequenceFlow>

    <task id="task2" name="Create Employee Account">
      <incoming>sequenceFlow4</incoming>
      <outgoing>sequenceFlow5</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow5" sourceRef="task2" targetRef="task5"/>

    <task id="task5" name="Review Expense Report">
      <incoming>sequenceFlow3</incoming>
      <incoming>sequenceFlow5</incoming>
      <outgoing>sequenceFlow6</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow6" sourceRef="task5" targetRef="exclusiveGateway2"/>

    <exclusiveGateway id="exclusiveGateway2">
      <incoming>sequenceFlow6</incoming>
      <outgoing>sequenceFlow7</outgoing>
      <outgoing>sequenceFlow8</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequenceFlow7" sourceRef="exclusiveGateway2" targetRef="task3">
      <conditionExpression xsi:type="tFormalExpression">${amount <= 200}</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="sequenceFlow8" sourceRef="exclusiveGateway2" targetRef="task6">
      <conditionExpression xsi:type="tFormalExpression">${amount > 200}</conditionExpression>
    </sequenceFlow>

    <task id="task3" name="Reimburse Employee">
      <incoming>sequenceFlow7</incoming>
      <outgoing>sequenceFlow9</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow9" sourceRef="task3" targetRef="endEvent1"/>

    <task id="task6" name="Request Supervisor Approval">
      <incoming>sequenceFlow8</incoming>
      <outgoing>sequenceFlow10</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow10" sourceRef="task6" targetRef="exclusiveGateway3"/>

    <exclusiveGateway id="exclusiveGateway3">
      <incoming>sequenceFlow10</incoming>
      <outgoing>sequenceFlow11</outgoing>
      <outgoing>sequenceFlow12</outgoing>
      <outgoing>sequenceFlow13</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequenceFlow11" sourceRef="exclusiveGateway3" targetRef="task7">
      <conditionExpression xsi:type="tFormalExpression">${approvalStatus == 'approved'}</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="sequenceFlow12" sourceRef="exclusiveGateway3" targetRef="task8">
      <conditionExpression xsi:type="tFormalExpression">${approvalStatus == 'rejected'}</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="sequenceFlow13" sourceRef="exclusiveGateway3" targetRef="task9">
      <conditionExpression xsi:type="tFormalExpression">${approvalStatus == null and daysPassed > 7}</conditionExpression>
    </sequenceFlow>

    <task id="task7" name="Reimburse Employee (Approved)">
      <incoming>sequenceFlow11</incoming>
      <outgoing>sequenceFlow14</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow14" sourceRef="task7" targetRef="endEvent1"/>

    <task id="task8" name="Notify Employee of Rejection">
      <incoming>sequenceFlow12</incoming>
      <outgoing>sequenceFlow15</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow15" sourceRef="task8" targetRef="endEvent1"/>

    <task id="task9" name="Notify Employee of Pending Approval">
      <incoming>sequenceFlow13</incoming>
      <outgoing>sequenceFlow16</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow16" sourceRef="task9" targetRef="task6"/>

    <endEvent id="endEvent1">
      <incoming>sequenceFlow9</incoming>
      <incoming>sequenceFlow14</incoming>
      <incoming>sequenceFlow15</incoming>
    </endEvent>

  </process>
</definitions>