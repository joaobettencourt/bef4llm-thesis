<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="NotCollectedBagProcess">

  <process id="notCollectedBagProcess" isExecutable="true">
    <startEvent id="startEvent1">
      <outgoing>sequenceFlow1</outgoing>
    </startEvent>

    <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="exclusiveGateway1"/>

    <exclusiveGateway id="exclusiveGateway1">
      <incoming>sequenceFlow1</incoming>
      <outgoing>sequenceFlow2</outgoing>
      <outgoing>sequenceFlow3</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequenceFlow2" sourceRef="exclusiveGateway1" targetRef="serviceTask1">
      <conditionExpression xsi:type="tFormalExpression">${retries > threshold}</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="sequenceFlow3" sourceRef="exclusiveGateway1" targetRef="task1">
      <conditionExpression xsi:type="tFormalExpression">${retries <= threshold}</conditionExpression>
    </sequenceFlow>

    <serviceTask id="serviceTask1">
      <incoming>sequenceFlow2</incoming>
      <outgoing>sequenceFlow4</outgoing>
    </serviceTask>

    <sequenceFlow id="sequenceFlow4" sourceRef="serviceTask1" targetRef="endEvent1"/>

    <task id="task1">
      <incoming>sequenceFlow3</incoming>
      <outgoing>sequenceFlow5</outgoing>
      <outgoing>sequenceFlow6</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow5" sourceRef="task1" targetRef="exclusiveGateway2"/>

    <sequenceFlow id="sequenceFlow6" sourceRef="task1" targetRef="serviceTask2">
      <conditionExpression xsi:type="tFormalExpression">${contactResult == 'unsuccessful'}</conditionExpression>
    </sequenceFlow>

    <serviceTask id="serviceTask2">
      <incoming>sequenceFlow6</incoming>
      <outgoing>sequenceFlow7</outgoing>
    </serviceTask>

    <sequenceFlow id="sequenceFlow7" sourceRef="serviceTask2" targetRef="endEvent1"/>

    <exclusiveGateway id="exclusiveGateway2">
      <incoming>sequenceFlow5</incoming>
      <outgoing>sequenceFlow8</outgoing>
      <outgoing>sequenceFlow9</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequenceFlow8" sourceRef="exclusiveGateway2" targetRef="serviceTask3">
      <conditionExpression xsi:type="tFormalExpression">${contactResult == 'withdrawn'}</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="sequenceFlow9" sourceRef="exclusiveGateway2" targetRef="serviceTask4">
      <conditionExpression xsi:type="tFormalExpression">${contactResult == 'promised'}</conditionExpression>
    </sequenceFlow>

    <serviceTask id="serviceTask3">
      <incoming>sequenceFlow8</incoming>
      <outgoing>sequenceFlow10</outgoing>
    </serviceTask>

    <sequenceFlow id="sequenceFlow10" sourceRef="serviceTask3" targetRef="endEvent1"/>

    <serviceTask id="serviceTask4">
      <incoming>sequenceFlow9</incoming>
      <outgoing>sequenceFlow11</outgoing>
    </serviceTask>

    <sequenceFlow id="sequenceFlow11" sourceRef="serviceTask4" targetRef="endEvent1"/>

    <endEvent id="endEvent1">
      <incoming>sequenceFlow4</incoming>
      <incoming>sequenceFlow7</incoming>
      <incoming>sequenceFlow10</incoming>
      <incoming>sequenceFlow11</incoming>
    </endEvent>

  </process>

</definitions>