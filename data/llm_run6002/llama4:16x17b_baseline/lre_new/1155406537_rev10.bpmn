<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" name="Paypal Account Creation Process">

  <process id="paypalAccountCreationProcess" isExecutable="true">
    <startEvent id="startEvent1">
      <outgoing>sequenceFlow1</outgoing>
    </startEvent>

    <exclusiveGateway id="exclusiveGateway1">
      <incoming>sequenceFlow1</incoming>
      <outgoing>sequenceFlow2</outgoing>
      <outgoing>sequenceFlow3</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="exclusiveGateway1"/>

    <sequenceFlow id="sequenceFlow2" name="Personal Account" sourceRef="exclusiveGateway1" targetRef="taskEnterLoginDetails1">
      <conditionExpression xsi:type="tFormalExpression">${accountType == 'personal'}</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="sequenceFlow3" name="Premium Account" sourceRef="exclusiveGateway1" targetRef="taskEnterLoginDetails2">
      <conditionExpression xsi:type="tFormalExpression">${accountType == 'premium'}</conditionExpression>
    </sequenceFlow>

    <userTask id="taskEnterLoginDetails1" name="Enter Login Details">
      <incoming>sequenceFlow2</incoming>
      <outgoing>sequenceFlow4</outgoing>
    </userTask>

    <userTask id="taskEnterLoginDetails2" name="Enter Login Details">
      <incoming>sequenceFlow3</incoming>
      <outgoing>sequenceFlow5</outgoing>
    </userTask>

    <sequenceFlow id="sequenceFlow4" sourceRef="taskEnterLoginDetails1" targetRef="taskEnterPersonalDetails1"/>
    <sequenceFlow id="sequenceFlow5" sourceRef="taskEnterLoginDetails2" targetRef="taskEnterPersonalDetails2"/>

    <userTask id="taskEnterPersonalDetails1" name="Enter Personal Details">
      <incoming>sequenceFlow4</incoming>
      <outgoing>sequenceFlow6</outgoing>
    </userTask>

    <userTask id="taskEnterPersonalDetails2" name="Enter Personal Details">
      <incoming>sequenceFlow5</incoming>
      <outgoing>sequenceFlow7</outgoing>
    </userTask>

    <sequenceFlow id="sequenceFlow6" sourceRef="taskEnterPersonalDetails1" targetRef="taskEnterContactInformation1"/>
    <sequenceFlow id="sequenceFlow7" sourceRef="taskEnterPersonalDetails2" targetRef="taskEnterContactInformation2"/>

    <userTask id="taskEnterContactInformation1" name="Enter Contact Information">
      <incoming>sequenceFlow6</incoming>
      <outgoing>sequenceFlow8</outgoing>
    </userTask>

    <userTask id="taskEnterContactInformation2" name="Enter Contact Information">
      <incoming>sequenceFlow7</incoming>
      <outgoing>sequenceFlow9</outgoing>
    </userTask>

    <sequenceFlow id="sequenceFlow8" sourceRef="taskEnterContactInformation1" targetRef="taskDeclarePoliticallyExposedPerson1"/>
    <sequenceFlow id="sequenceFlow9" sourceRef="taskEnterContactInformation2" targetRef="taskDeclarePoliticallyExposedPerson2"/>

    <userTask id="taskDeclarePoliticallyExposedPerson1" name="Declare Politically Exposed Person">
      <incoming>sequenceFlow8</incoming>
      <outgoing>sequenceFlow10</outgoing>
    </userTask>

    <userTask id="taskDeclarePoliticallyExposedPerson2" name="Declare Politically Exposed Person">
      <incoming>sequenceFlow9</incoming>
      <outgoing>sequenceFlow11</outgoing>
    </userTask>

    <sequenceFlow id="sequenceFlow10" sourceRef="taskDeclarePoliticallyExposedPerson1" targetRef="serviceTaskCreateAccount"/>
    <sequenceFlow id="sequenceFlow11" sourceRef="taskDeclarePoliticallyExposedPerson2" targetRef="serviceTaskCreateAccount"/>

    <serviceTask id="serviceTaskCreateAccount" name="Create Account">
      <incoming>sequenceFlow10</incoming>
      <incoming>sequenceFlow11</incoming>
      <outgoing>sequenceFlow12</outgoing>
      <outgoing>sequenceFlow13</outgoing>
    </serviceTask>

    <sequenceFlow id="sequenceFlow12" sourceRef="serviceTaskCreateAccount" targetRef="endEventInvalidFields">
      <conditionExpression xsi:type="tFormalExpression">${validationResult == 'invalid'}</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="sequenceFlow13" sourceRef="serviceTaskCreateAccount" targetRef="endEventAccountCreated">
      <conditionExpression xsi:type="tFormalExpression">${validationResult == 'valid'}</conditionExpression>
    </sequenceFlow>

    <endEvent id="endEventInvalidFields" name="Notify Client of Invalid Fields">
      <incoming>sequenceFlow12</incoming>
    </endEvent>

    <endEvent id="endEventAccountCreated" name="Welcome Email Sent">
      <incoming>sequenceFlow13</incoming>
    </endEvent>

  </process>

</definitions>