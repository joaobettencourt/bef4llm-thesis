<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" name="ACME Inc Purchase Process">

  <process id="purchaseProcess" isExecutable="true">
    <startEvent id="startEvent1">
      <outgoing>sequenceFlow1</outgoing>
    </startEvent>

    <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="exclusiveGateway1"/>

    <exclusiveGateway id="exclusiveGateway1">
      <incoming>sequenceFlow1</incoming>
      <outgoing>sequenceFlow2</outgoing>
      <outgoing>sequenceFlow3</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequenceFlow2" name="enough goods in stock" sourceRef="exclusiveGateway1" targetRef="endEvent1">
      <conditionExpression xsi:type="tFormalExpression">${goodsInStock >= demand}</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="sequenceFlow3" name="not enough goods in stock" sourceRef="exclusiveGateway1" targetRef="task1">
      <conditionExpression xsi:type="tFormalExpression">${goodsInStock < demand}</conditionExpression>
    </sequenceFlow>

    <task id="task1" name="Create Purchase Requisition">
      <incoming>sequenceFlow3</incoming>
      <outgoing>sequenceFlow4</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow4" sourceRef="task1" targetRef="exclusiveGateway2"/>

    <exclusiveGateway id="exclusiveGateway2">
      <incoming>sequenceFlow4</incoming>
      <outgoing>sequenceFlow5</outgoing>
      <outgoing>sequenceFlow6</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequenceFlow5" name="supplier exists" sourceRef="exclusiveGateway2" targetRef="task3">
      <conditionExpression xsi:type="tFormalExpression">${supplierExists == true}</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="sequenceFlow6" name="new supplier" sourceRef="exclusiveGateway2" targetRef="task2">
      <conditionExpression xsi:type="tFormalExpression">${supplierExists == false}</conditionExpression>
    </sequenceFlow>

    <task id="task2" name="Create Supplier in ERP">
      <incoming>sequenceFlow6</incoming>
      <outgoing>sequenceFlow7</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow7" sourceRef="task2" targetRef="task3"/>

    <task id="task3" name="Process Purchase Requisition and Create Order Template">
      <incoming>sequenceFlow5</incoming>
      <incoming>sequenceFlow7</incoming>
      <outgoing>sequenceFlow8</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow8" sourceRef="task3" targetRef="userTask1"/>

    <userTask id="userTask1" name="Approve Order">
      <incoming>sequenceFlow8</incoming>
      <outgoing>sequenceFlow9</outgoing>
    </userTask>

    <sequenceFlow id="sequenceFlow9" sourceRef="userTask1" targetRef="endEvent1"/>

    <endEvent id="endEvent1">
      <incoming>sequenceFlow2</incoming>
      <incoming>sequenceFlow9</incoming>
    </endEvent>

  </process>

</definitions>