<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
                  id="definitions" name="SSP Invoice Process">

  <bpmn:process id="sspInvoiceProcess" isExecutable="true">
    <bpmn:startEvent id="startEvent1">
      <bpmn:outgoing>sequenceFlow1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="categorizeInvoice" name="Categorize Invoice by Staff Member">
      <bpmn:incoming>sequenceFlow1</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="categorizeInvoice"/>
    <bpmn:sequenceFlow id="sequenceFlow2" sourceRef="categorizeInvoice" targetRef="forwardToAdministration"/>

    <bpmn:task id="forwardToAdministration" name="Forward to Administration Department">
      <bpmn:incoming>sequenceFlow2</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow3</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="sequenceFlow3" sourceRef="forwardToAdministration" targetRef="processInvoice"/>

    <bpmn:subProcess id="processInvoice" name="Process Invoice">
      <bpmn:incoming>sequenceFlow3</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow4</bpmn:outgoing>
    </bpmn:subProcess>

    <bpmn:sequenceFlow id="sequenceFlow4" sourceRef="processInvoice" targetRef="putInCollectionBox"/>

    <bpmn:task id="putInCollectionBox" name="Put Invoices into Collection Box">
      <bpmn:incoming>sequenceFlow4</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow5</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="sequenceFlow5" sourceRef="putInCollectionBox" targetRef="dataEntry"/>

    <bpmn:subProcess id="dataEntry" name="Data Entry into SAP System">
      <bpmn:incoming>sequenceFlow5</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow6</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle>P1D PT10H</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:subProcess>

    <bpmn:sequenceFlow id="sequenceFlow6" sourceRef="dataEntry" targetRef="reviewSystem"/>

    <bpmn:task id="reviewSystem" name="Review System for New Invoices">
      <bpmn:incoming>sequenceFlow6</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow7</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle>P1H</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:task>

    <bpmn:sequenceFlow id="sequenceFlow7" sourceRef="reviewSystem" targetRef="validateInvoices"/>

    <bpmn:subProcess id="validateInvoices" name="Validate Invoices">
      <bpmn:incoming>sequenceFlow7</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow8</bpmn:outgoing>
    </bpmn:subProcess>

    <bpmn:sequenceFlow id="sequenceFlow8" sourceRef="validateInvoices" targetRef="executePayment"/>

    <bpmn:subProcess id="executePayment" name="Execute Payment of Validated Invoices">
      <bpmn:incoming>sequenceFlow8</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow9</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle>P7D PT0H</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:subProcess>

    <bpmn:sequenceFlow id="sequenceFlow9" sourceRef="executePayment" targetRef="archiveInvoices"/>

    <bpmn:task id="archiveInvoices" name="Archive Invoices">
      <bpmn:incoming>sequenceFlow9</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow10</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="sequenceFlow10" sourceRef="archiveInvoices" targetRef="endEvent1"/>

    <bpmn:endEvent id="endEvent1">
      <bpmn:incoming>sequenceFlow10</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>