<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="SO: Angebot/Auftrag Process">

  <process id="so_angebot_auftrag_process" isExecutable="true">
    <startEvent id="start_event_1">
      <outgoing>sequence_flow_1</outgoing>
    </startEvent>

    <sequenceFlow id="sequence_flow_1" sourceRef="start_event_1" targetRef="prepare_goods_task"/>

    <task id="prepare_goods_task" name="Prepare goods for shipment">
      <incoming>sequence_flow_1</incoming>
      <outgoing>sequence_flow_2</outgoing>
      <outgoing>sequence_flow_3</outgoing>
    </task>

    <sequenceFlow id="sequence_flow_2" sourceRef="prepare_goods_task" targetRef="ship_goods_task"/>

    <task id="ship_goods_task" name="Ship goods">
      <incoming>sequence_flow_2</incoming>
    </task>

    <sequenceFlow id="sequence_flow_3" sourceRef="prepare_goods_task" targetRef="invoicing_preparation_task"/>

    <task id="invoicing_preparation_task" name="Prepare invoicing">
      <incoming>sequence_flow_3</incoming>
      <outgoing>sequence_flow_4</outgoing>
    </task>

    <sequenceFlow id="sequence_flow_4" sourceRef="invoicing_preparation_task" targetRef="exclusive_gateway_1"/>

    <exclusiveGateway id="exclusive_gateway_1">
      <incoming>sequence_flow_4</incoming>
      <outgoing>sequence_flow_5</outgoing>
      <outgoing>sequence_flow_6</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequence_flow_5" sourceRef="exclusive_gateway_1" targetRef="so_address_management_task">
      <conditionExpression xsi:type="tFormalExpression">${customer.isSubsidiary() && !subsidiaryRelationshipModeled()}</conditionExpression>
    </sequenceFlow>

    <task id="so_address_management_task" name="Add parent company as invoicing address">
      <incoming>sequence_flow_5</incoming>
      <outgoing>sequence_flow_7</outgoing>
    </task>

    <sequenceFlow id="sequence_flow_7" sourceRef="so_address_management_task" targetRef="create_invoice_task"/>

    <sequenceFlow id="sequence_flow_6" sourceRef="exclusive_gateway_1" targetRef="create_invoice_task">
      <conditionExpression xsi:type="tFormalExpression">${!customer.isSubsidiary() || subsidiaryRelationshipModeled()}</conditionExpression>
    </sequenceFlow>

    <task id="create_invoice_task" name="Create invoice">
      <incoming>sequence_flow_6</incoming>
      <incoming>sequence_flow_7</incoming>
      <outgoing>sequence_flow_8</outgoing>
    </task>

    <sequenceFlow id="sequence_flow_8" sourceRef="create_invoice_task" targetRef="send_invoice_task"/>

    <task id="send_invoice_task" name="Send invoice">
      <incoming>sequence_flow_8</incoming>
      <outgoing>sequence_flow_9</outgoing>
    </task>

    <sequenceFlow id="sequence_flow_9" sourceRef="send_invoice_task" targetRef="end_event_1"/>

    <endEvent id="end_event_1">
      <incoming>sequence_flow_9</incoming>
    </endEvent>

  </process>

</definitions>