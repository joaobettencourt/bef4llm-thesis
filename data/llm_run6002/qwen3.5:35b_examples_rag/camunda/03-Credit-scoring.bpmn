<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_ScoreProcess">
    <bpmn:participant id="Participant_BankSystem" name="Bank System Process" processRef="Process_Banking"/>
    <bpmn:participant id="Participant_Agency" name="Credit Protection Agency (Schufa)" processRef="Process_Agency"/>
  </bpmn:collaboration>

  <!-- Banking System Process -->
  <bpmn:process id="Process_Banking" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Credit Scoring Request Initiated">
      <bpmn:outgoing>SequenceFlow_0a3k7j9</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Send scoring request to agency -->
    <bpmn:userTask id="UserTask_SendRequest" name="Send Scoring Request">
      <bpmn:incoming>SequenceFlow_0a3k7j9</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1v5l6t8</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Wait for agency response -->
    <bpmn:intermediateCatchEvent id="IntermediateEvent_WaitResponse" name="Wait for Agency Response">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SequenceFlow_1v5l6t8</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2w7y3k4</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Decision point for quick vs delayed result -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_ResultType" name="Result Available Immediately?">
      <bpmn:incoming>SequenceFlow_2w7y3k4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0t8m5p6</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_1x9r4v7</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Quick result path -->
    <bpmn:userTask id="UserTask_DisplayQuickResult" name="Display Scoring Result">
      <bpmn:incoming>SequenceFlow_0t8m5p6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3k7w2j9</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Delayed result path -->
    <bpmn:userTask id="UserTask_ShowDelayMessage" name="Show 'Check Again Later' Message">
      <bpmn:incoming>SequenceFlow_1x9r4v7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5m8p3t6</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Wait for delayed result -->
    <bpmn:intermediateCatchEvent id="IntermediateEvent_WaitDelayedResult" name="Wait for Delayed Result">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SequenceFlow_5m8p3t6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_7q4r9v2</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Display delayed result -->
    <bpmn:userTask id="UserTask_DisplayDelayedResult" name="Display Scoring Result">
      <bpmn:incoming>SequenceFlow_7q4r9v2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_8w5k3m1</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End events -->
    <bpmn:endEvent id="EndEvent_Success" name="Scoring Completed">
      <bpmn:incoming>SequenceFlow_3k7w2j9</bpmn:incoming/>
      <bpmn:incoming>SequenceFlow_8w5k3m1</bpmn:incoming/>
    </bpmn:endEvent>

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="SequenceFlow_0a3k7j9" sourceRef="StartEvent_1" targetRef="UserTask_SendRequest"/>
    <bpmn:sequenceFlow id="SequenceFlow_1v5l6t8" name="Send Request to Agency" sourceRef="UserTask_SendRequest" targetRef="IntermediateEvent_WaitResponse"/>
    <bpmn:sequenceFlow id="SequenceFlow_2w7y3k4" name="Receive Response from Agency" sourceRef="IntermediateEvent_WaitResponse" targetRef="ExclusiveGateway_ResultType"/>
    <bpmn:sequenceFlow id="SequenceFlow_0t8m5p6" name="Quick Result Available" sourceRef="ExclusiveGateway_ResultType" targetRef="UserTask_DisplayQuickResult"/>
    <bpmn:sequenceFlow id="SequenceFlow_1x9r4v7" name="Delayed Scoring Required" sourceRef="ExclusiveGateway_ResultType" targetRef="UserTask_ShowDelayMessage"/>
    <bpmn:sequenceFlow id="SequenceFlow_3k7w2j9" sourceRef="UserTask_DisplayQuickResult" targetRef="EndEvent_Success"/>
    <bpmn:sequenceFlow id="SequenceFlow_5m8p3t6" name="Wait for Delayed Result" sourceRef="UserTask_ShowDelayMessage" targetRef="IntermediateEvent_WaitDelayedResult"/>
    <bpmn:sequenceFlow id="SequenceFlow_7q4r9v2" name="Receive Delayed Scoring Result" sourceRef="IntermediateEvent_WaitDelayedResult" targetRef="UserTask_DisplayDelayedResult"/>
    <bpmn:sequenceFlow id="SequenceFlow_8w5k3m1" sourceRef="UserTask_DisplayDelayedResult" targetRef="EndEvent_Success"/>

  </bpmn:process>

  <!-- Agency Process -->
  <bpmn:process id="Process_Agency" isExecutable="false">
    <bpmn:startEvent id="StartEvent_2" name="Receive Scoring Request from Bank">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_0k8m4p7</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Level 1 scoring -->
    <bpmn:userTask id="UserTask_Level1Scoring" name="Perform Level 1 Scoring">
      <bpmn:incoming>SequenceFlow_0k8m4p7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2v9r6t3</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Decision point for quick vs delayed result -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_ScoringComplete" name="Scoring Complete?">
      <bpmn:incoming>SequenceFlow_2v9r6t3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4x7k5m8</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_6w3p9j1</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Quick result path -->
    <bpmn:userTask id="UserTask_SendQuickResult" name="Send Scoring Result to Bank">
      <bpmn:incoming>SequenceFlow_4x7k5m8</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_9r2t6v4</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Delayed result path -->
    <bpmn:userTask id="UserTask_SendDelayNotification" name="Send 'Delayed Scoring' Notification">
      <bpmn:incoming>SequenceFlow_6w3p9j1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0m5k8r7</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Level 2 scoring -->
    <bpmn:userTask id="UserTask_Level2Scoring" name="Perform Level 2 Scoring">
      <bpmn:incoming>SequenceFlow_0m5k8r7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1p6w9t3</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Send delayed result -->
    <bpmn:userTask id="UserTask_SendDelayedResult" name="Send Scoring Result to Bank">
      <bpmn:incoming>SequenceFlow_1p6w9t3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2q7r4v8</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End event -->
    <bpmn:endEvent id="EndEvent_Agency" name="Scoring Process Completed">
      <bpmn:incoming>SequenceFlow_9r2t6v4</bpmn:incoming/>
      <bpmn:incoming>SequenceFlow_2q7r4v8</bpmn:incoming/>
    </bpmn:endEvent>

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="SequenceFlow_0k8m4p7" sourceRef="StartEvent_2" targetRef="UserTask_Level1Scoring"/>
    <bpmn:sequenceFlow id="SequenceFlow_2v9r6t3" name="Level 1 Scoring Complete" sourceRef="UserTask_Level1Scoring" targetRef="ExclusiveGateway_ScoringComplete"/>
    <bpmn:sequenceFlow id="SequenceFlow_4x7k5m8" name="Quick Result Available" sourceRef="ExclusiveGateway_ScoringComplete" targetRef="UserTask_SendQuickResult"/>
    <bpmn:sequenceFlow id="SequenceFlow_6w3p9j1" name="Delayed Scoring Required" sourceRef="ExclusiveGateway_ScoringComplete" targetRef="UserTask_SendDelayNotification"/>
    <bpmn:sequenceFlow id="SequenceFlow_0m5k8r7" name="Start Level 2 Scoring" sourceRef="UserTask_SendDelayNotification" targetRef="UserTask_Level2Scoring"/>
    <bpmn:sequenceFlow id="SequenceFlow_1p6w9t3" name="Level 2 Scoring Complete" sourceRef="UserTask_Level2Scoring" targetRef="UserTask_SendDelayedResult"/>
    <bpmn:sequenceFlow id="SequenceFlow_9r2t6v4" name="Send Quick Result to Bank" sourceRef="UserTask_SendQuickResult" targetRef="EndEvent_Agency"/>
    <bpmn:sequenceFlow id="SequenceFlow_2q7r4v8" name="Send Delayed Result to Bank" sourceRef="UserTask_SendDelayedResult" targetRef="EndEvent_Agency"/>

  </bpmn:process>

  <!-- Message Flows between participants -->
  <bpmn:messageFlow id="MessageFlow_ScoringRequest" name="Scoring Request">
    <bpmn:sourceRef>UserTask_SendRequest</bpmn:sourceRef>
    <bpmn:targetRef>StartEvent_2</bpmn:targetRef>
  </bpmn:messageFlow>

  <bpmn:messageFlow id="MessageFlow_ScoringResult" name="Scoring Result">
    <bpmn:sourceRef>UserTask_SendQuickResult</bpmn:sourceRef>
    <bpmn:targetRef>IntermediateEvent_WaitResponse</bpmn:targetRef>
  </bpmn:messageFlow>

  <bpmn:messageFlow id="MessageFlow_DelayNotification" name="Delayed Scoring Notification">
    <bpmn:sourceRef>UserTask_SendDelayNotification</bpmn:sourceRef>
    <bpmn:targetRef>IntermediateEvent_WaitResponse</bpmn:targetRef>
  </bpmn:messageFlow>

  <bpmn:messageFlow id="MessageFlow_DelayedResult" name="Delayed Scoring Result">
    <bpmn:sourceRef>UserTask_SendDelayedResult</bpmn:sourceRef>
    <bpmn:targetRef>IntermediateEvent_WaitDelayedResult</bpmn:targetRef>
  </bpmn:messageFlow>

</bpmn:definitions>