<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1aeg7k3">
    <bpmn:participant id="Participant_1aeg7k4" name="Dispatch of goods&#10;Computer Hardware Shop" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Secretary" name="Secretary">
        <bpmn:flowNodeRef>Task_ClariyShipment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_LargeAmounts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InviteLogisticsCompanies</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectCompany</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WritePackageLabel</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_LogisticsHead" name="Logistics Department Head">
        <bpmn:flowNodeRef>Task_TakeInsurance</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Warehousemen" name="Warehousemen">
        <bpmn:flowNodeRef>Task_PackageGoods</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MergeReady</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_LogisticsCompany" name="Logistic Company">
        <bpmn:flowNodeRef>Task_PrepareForPickup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ShipmentPrepared</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_ShipGoods" name="Ship goods">
      <bpmn:outgoing>SequenceFlow_StartToSecretary</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Secretary Tasks and Gateway for Large Amounts Decision -->
    <bpmn:userTask id="Task_ClariyShipment" name="Clarify shipment method">
      <bpmn:incoming>SequenceFlow_StartToSecretary</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SecretaryToGatewayLargeAmounts</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_LargeAmounts" name="Special handling?">
      <bpmn:incoming>SequenceFlow_SecretaryToGatewayLargeAmounts</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GatewayToInviteCompanies</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_GatewayToWriteLabel</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Large Amounts Path - Invite and Select Logistics Companies -->
    <bpmn:userTask id="Task_InviteLogisticsCompanies" name="Get 3 offers from logistic companies">
      <bpmn:incoming>SequenceFlow_GatewayToInviteCompanies</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToSelectCompany</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_SelectCompany" name="Select logistic company and place order">
      <bpmn:incoming>SequenceFlow_ToSelectCompany</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToMergeReady</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Small Amounts Path - Write Label and Insurance -->
    <bpmn:userTask id="Task_WritePackageLabel" name="Write package label">
      <bpmn:incoming>SequenceFlow_GatewayToWriteLabel</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToInsuranceGateway</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Insurance Decision -->
    <bpmn:exclusiveGateway id="Gateway_Insurance" name="Insurance necessary?">
      <bpmn:incoming>SequenceFlow_ToInsuranceGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TakeInsurance</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SkipInsurance</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Insurance Task -->
    <bpmn:userTask id="Task_TakeInsurance" name="Take parcel insurance">
      <bpmn:incoming>SequenceFlow_TakeInsurance</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToMergeReady</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel Gateway for Warehouse Packaging -->
    <bpmn:parallelGateway id="Parallel_Gateway_Start" name="">
      <bpmn:incoming>SequenceFlow_SecretaryToGatewayLargeAmounts</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToWarehousePackaging</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Warehouse Packaging Task -->
    <bpmn:userTask id="Task_PackageGoods" name="Package goods">
      <bpmn:incoming>SequenceFlow_ToWarehousePackaging</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WarehouseToMergeReady</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Merge Gateway for All Paths -->
    <bpmn:exclusiveGateway id="Gateway_MergeReady" name="">
      <bpmn:incoming>SequenceFlow_ToSelectCompany</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_SkipInsurance</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_WarehouseToMergeReady</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToPreparePickup</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Final Task and End Event -->
    <bpmn:userTask id="Task_PrepareForPickup" name="Prepare for picking up goods">
      <bpmn:incoming>SequenceFlow_ToPreparePickup</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToEndEvent</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_ShipmentPrepared" name="Shipment prepared">
      <bpmn:incoming>SequenceFlow_ToEndEvent</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToSecretary" sourceRef="StartEvent_ShipGoods" targetRef="Task_ClariyShipment"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_SecretaryToGatewayLargeAmounts" name="" sourceRef="Task_ClariyShipment" targetRef="Parallel_Gateway_Start"/>

    <!-- Large Amounts Path -->
    <bpmn:sequenceFlow id="SequenceFlow_GatewayToInviteCompanies" name="yes (large amounts)" sourceRef="Gateway_LargeAmounts" targetRef="Task_InviteLogisticsCompanies"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ToSelectCompany" sourceRef="Task_InviteLogisticsCompanies" targetRef="Task_SelectCompany"/>

    <!-- Small Amounts Path -->
    <bpmn:sequenceFlow id="SequenceFlow_GatewayToWriteLabel" name="no (small amounts)" sourceRef="Gateway_LargeAmounts" targetRef="Task_WritePackageLabel"/>

    <!-- Insurance Decision Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_ToInsuranceGateway" sourceRef="Task_WritePackageLabel" targetRef="Gateway_Insurance"/>

    <!-- Insurance Path -->
    <bpmn:sequenceFlow id="SequenceFlow_TakeInsurance" name="yes (insurance necessary)" sourceRef="Gateway_Insurance" targetRef="Task_TakeInsurance"/>

    <!-- Skip Insurance Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_SkipInsurance" name="no (not necessary)" sourceRef="Gateway_Insurance" targetRef="Gateway_MergeReady"/>

    <!-- Parallel Warehouse Packaging Path -->
    <bpmn:sequenceFlow id="SequenceFlow_ToWarehousePackaging" sourceRef="Parallel_Gateway_Start" targetRef="Task_PackageGoods"/>

    <!-- Merge Ready Flow from Insurance Skip and Package Goods -->
    <bpmn:sequenceFlow id="SequenceFlow_WarehouseToMergeReady" name="" sourceRef="Task_PackageGoods" targetRef="Gateway_MergeReady"/>

    <!-- Final Preparation Path -->
    <bpmn:sequenceFlow id="SequenceFlow_ToPreparePickup" sourceRef="Gateway_MergeReady" targetRef="Task_PrepareForPickup"/>

    <!-- End Event Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_ToEndEvent" name="" sourceRef="Task_PrepareForPickup" targetRef="EndEvent_ShipmentPrepared"/>

  </bpmn:process>
</bpmn:definitions>