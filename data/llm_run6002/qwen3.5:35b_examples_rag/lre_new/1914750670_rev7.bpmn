<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_BankAccountCreation" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_AccountProc">
    <bpmn:participant id="Participant_AccountPool" name="Bank Account Creation Process" processRef="Process_A12345"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_A12345" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Customer" name="Customer">
        <bpmn:flowNodeRef>StartEvent_AccountRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VisitWebsite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FillPersonalData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GeneratePDF</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrintDocuments</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PostOffice" name="Post Office">
        <bpmn:flowNodeRef>IntermediateThrowEvent_SendToBank</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckIdentity</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_BankOfficer" name="Bank Officer">
        <bpmn:flowNodeRef>IntermediateCatchEvent_ReceiveRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckCustomerData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DecisionPoint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MailAccountDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendRefusalLetter</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_AccountRequest" name="Account Request Initiated">
      <bpmn:outgoing>SequenceFlow_S1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Customer Tasks -->
    <bpmn:task id="Task_VisitWebsite" name="Visit Bank Website">
      <bpmn:incoming>SequenceFlow_S1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_S2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_FillPersonalData" name="Fill in Personal Data">
      <bpmn:incoming>SequenceFlow_S2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_S3</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_GeneratePDF" name="Generate PDF Document">
      <bpmn:incoming>SequenceFlow_S3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_S4</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_PrintDocuments" name="Print Documents">
      <bpmn:incoming>SequenceFlow_S4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_S5</bpmn:outgoing>
    </bpmn:task>

    <!-- Post Office Tasks -->
    <bpmn:intermediateThrowEvent id="IntermediateThrowEvent_SendToBank" name="Send Documents to Bank">
      <bpmn:incoming>SequenceFlow_S6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_P1</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <bpmn:task id="Task_CheckIdentity" name="Check Customer Identity">
      <bpmn:incoming>SequenceFlow_S6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_P1</bpmn:outgoing>
    </bpmn:task>

    <!-- Bank Officer Tasks -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_ReceiveRequest" name="New Account Request Received">
      <bpmn:incoming>SequenceFlow_B1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_B2</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:task id="Task_CheckCustomerData" name="Check Customer Data">
      <bpmn:incoming>SequenceFlow_B2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_G1</bpmn:outgoing>
    </bpmn:task>

    <!-- Decision Gateway -->
    <bpmn:exclusiveGateway id="Gateway_DecisionPoint" name="Accept Request?">
      <bpmn:incoming>SequenceFlow_G1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AcceptPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RejectPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Accept Path -->
    <bpmn:task id="Task_MailAccountDocuments" name="Mail Account Documents">
      <bpmn:incoming>SequenceFlow_AcceptPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_E1</bpmn:outgoing>
    </bpmn:task>

    <!-- Reject Path -->
    <bpmn:task id="Task_SendRefusalLetter" name="Send Refusal Letter">
      <bpmn:incoming>SequenceFlow_RejectPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_E2</bpmn:outgoing>
    </bpmn:task>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_AccountCreated" name="Account Created">
      <bpmn:incoming>SequenceFlow_E1</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_RequestRejected" name="Request Rejected">
      <bpmn:incoming>SequenceFlow_E2</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_S1" sourceRef="StartEvent_AccountRequest" targetRef="Task_VisitWebsite"/>
    <bpmn:sequenceFlow id="SequenceFlow_S2" sourceRef="Task_VisitWebsite" targetRef="Task_FillPersonalData"/>
    <bpmn:sequenceFlow id="SequenceFlow_S3" sourceRef="Task_FillPersonalData" targetRef="Task_GeneratePDF"/>
    <bpmn:sequenceFlow id="SequenceFlow_S4" sourceRef="Task_GeneratePDF" targetRef="Task_PrintDocuments"/>
    <bpmn:sequenceFlow id="SequenceFlow_S5" name="Visit Post Office" sourceRef="Task_PrintDocuments" targetRef="IntermediateThrowEvent_SendToBank"/>
    
    <!-- Message Flow from Customer to Bank (via Post Office) -->
    <bpmn:messageFlow id="MessageFlow_AccountRequest">
      <bpmn:sourceRef>IntermediateThrowEvent_SendToBank</bpmn:sourceRef>
      <bpmn:targetRef>IntermediateCatchEvent_ReceiveRequest</bpmn:targetRef>
    </bpmn:messageFlow>

    <!-- Post Office Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_P1" sourceRef="Task_CheckIdentity" targetRef="Gateway_DecisionPoint"/>

    <!-- Bank Officer Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_B1" name="Request Received via Mail" sourceRef="IntermediateCatchEvent_ReceiveRequest" targetRef="Task_CheckCustomerData"/>
    
    <!-- Decision Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_G1" sourceRef="Task_CheckCustomerData" targetRef="Gateway_DecisionPoint"/>
    <bpmn:sequenceFlow id="SequenceFlow_AcceptPath" name="Accept Request" sourceRef="Gateway_DecisionPoint" targetRef="Task_MailAccountDocuments"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_RejectPath" name="Reject Request" sourceRef="Gateway_DecisionPoint" targetRef="Task_SendRefusalLetter"/>

    <!-- End Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_E1" sourceRef="Task_MailAccountDocuments" targetRef="EndEvent_AccountCreated"/>
    <bpmn:sequenceFlow id="SequenceFlow_E2" sourceRef="Task_SendRefusalLetter" targetRef="EndEvent_RequestRejected"/>

  </bpmn:process>
</bpmn:definitions>