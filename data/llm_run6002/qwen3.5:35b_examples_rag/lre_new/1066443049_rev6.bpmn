<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_WebDesignProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_WebDesignProc">
    <bpmn:participant id="Participant_WebDesignPool" name="Website Development Process" processRef="Process_WD01"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_WD01" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_WebDesignTeam" name="Web Design Team">
        <bpmn:flowNodeRef>StartEvent_Meeting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InfoMeeting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_MeetingSuccess</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Meeting" name="Informational Meeting">
      <bpmn:outgoing>SequenceFlow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Informational meeting among web design team -->
    <bpmn:task id="Task_InfoMeeting" name="Hold informational meeting">
      <bpmn:incoming>SequenceFlow_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_02</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway for Meeting Success Check -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_MeetingSuccess" name="Meeting Successful?">
      <bpmn:incoming>SequenceFlow_02</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndProcess</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ToStoryboard</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Create storyboard -->
    <bpmn:task id="Task_Storyboard" name="Create storyboard">
      <bpmn:incoming>SequenceFlow_ToStoryboard</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SplitParallel</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway for simultaneous work -->
    <bpmn:parallelGateway id="ParallelGateway_DevContent" name="Development &amp; Content">
      <bpmn:incoming>SequenceFlow_SplitParallel</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToDesignDev</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ToContentDraft</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Design and development of website -->
    <bpmn:task id="Task_DesignDev" name="Design and develop website">
      <bpmn:incoming>SequenceFlow_ToDesignDev</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeBeforeBuild</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Prepare initial draft of content -->
    <bpmn:task id="Task_ContentDraft" name="Prepare initial content draft">
      <bpmn:incoming>SequenceFlow_ToContentDraft</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReviewCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway for Review Check -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_ContentReview" name="Content review needed?">
      <bpmn:incoming>SequenceFlow_ReviewCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToMarketingReview</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SkipToFinalContent</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Marketing team review -->
    <bpmn:task id="Task_MarketingReview" name="Marketing team reviews content">
      <bpmn:incoming>SequenceFlow_ToMarketingReview</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FinalContent</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Web design team creates final version of content -->
    <bpmn:task id="Task_FinalContent" name="Create final version of content">
      <bpmn:incoming>SequenceFlow_SkipToFinalContent</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeBeforeBuild2</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway to merge development and content paths -->
    <bpmn:parallelGateway id="ParallelGateway_BuildWebsite" name="Merge Development &amp; Content">
      <bpmn:incoming>SequenceFlow_MergeBeforeBuild</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_MergeBeforeBuild2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToBuildReview</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Build and review website -->
    <bpmn:task id="Task_BuildWebsite" name="Build and review website">
      <bpmn:incoming>SequenceFlow_ToBuildReview</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ApprovalCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway for Approval Check -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_Approval" name="Site Approved?">
      <bpmn:incoming>SequenceFlow_ApprovalCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndSuccess</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RebuildLoop</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event for successful process -->
    <bpmn:endEvent id="EndEvent_Success" name="Process Completed">
      <bpmn:incoming>SequenceFlow_EndSuccess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- End Event for unsuccessful meeting -->
    <bpmn:endEvent id="EndEvent_FailMeeting" name="Process Ended (Unsuccessful Meeting)">
      <bpmn:incoming>SequenceFlow_EndProcess</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>