<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                 xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" 
                 xmlns:di="http://www.omg.org/spec/DD/20100524/DI" 
                 xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" 
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
                 id="Definitions_DataValidationProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_ITSupport" name="IT Support Process" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_DropOffTech" name="Drop-off Technician">
        <bpmn:flowNodeRef>StartEvent_DataError</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckTypos</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SupportTech" name="Support Technician">
        <bpmn:flowNodeRef>InclusiveGateway_ResolveCheck1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckCustomerCorrection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_ResolveCheck2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_IssueResolved1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_DataError" name="Data Validation Error Notification">
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Drop-off Tech checks typos -->
    <bpmn:task id="Task_CheckTypos" name="Check for Typos">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Is it a typo? -->
    <bpmn:exclusiveGateway id="InclusiveGateway_ResolveCheck1" name="Is Typo Found?">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing> <!-- Yes -->
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing> <!-- No (Not Typo) -->
    </bpmn:exclusiveGateway>

    <!-- End Event 1: Resolved via Typos check -->
    <bpmn:endEvent id="EndEvent_IssueResolved1" name="Issue Resolved">
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task 2: Technician checks customer correction -->
    <bpmn:task id="Task_CheckCustomerCorrection" name="Check Customer Correction">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2: Can customer correct? -->
    <bpmn:exclusiveGateway id="InclusiveGateway_ResolveCheck2" name="Can Customer Correct?">
      <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing> <!-- Yes -->
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing> <!-- No - Scour sources -->
    </bpmn:exclusiveGateway>

    <!-- End Event 2: Resolved via Customer Correction or Public Sources -->
    <bpmn:endEvent id="EndEvent_IssueResolved2" name="Issue Resolved">
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_7</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_DataError" targetRef="Task_CheckTypos"/>
    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="Task_CheckTypos" targetRef="InclusiveGateway_ResolveCheck1"/>
    <bpmn:sequenceFlow id="SequenceFlow_3" name="Yes - Typo Found" sourceRef="InclusiveGateway_ResolveCheck1" targetRef="EndEvent_IssueResolved1"/>
    <bpmn:sequenceFlow id="SequenceFlow_4" name="No - Not a typo" sourceRef="InclusiveGateway_ResolveCheck1" targetRef="Task_CheckCustomerCorrection"/>
    <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="Task_CheckCustomerCorrection" targetRef="InclusiveGateway_ResolveCheck2"/>
    <bpmn:sequenceFlow id="SequenceFlow_6" name="Yes - Can Correct" sourceRef="InclusiveGateway_ResolveCheck2" targetRef="EndEvent_IssueResolved2"/>
    <bpmn:sequenceFlow id="SequenceFlow_7" name="No - Scour Sources" sourceRef="InclusiveGateway_ResolveCheck2" targetRef="EndEvent_IssueResolved2"/>

  </bpmn:process>
</bpmn:definitions>