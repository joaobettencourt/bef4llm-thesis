<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_PurchaseProcess_ACME_Corrected" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_0PurchaseProc">
    <bpmn:participant id="Participant_ACMEEnc" name="ACME Inc." processRef="Process_PurchaseO1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_PurchaseO1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_DemandDept" name="Department">
        <bpmn:flowNodeRef>StartEvent_0Demand</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CheckStock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConsumeLocally</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CentralProcurement" name="Central Procurement">
        <bpmn:flowNodeRef>Gateway_CheckSupplierInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreatePurchaseRequisition</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NewSupplierCreation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MergeSupplierPaths</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateOrderTemplate</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Approver" name="Approver">
        <bpmn:flowNodeRef>Task_ApproveAndTriggerPO</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_0Demand" name="Purchase Demand Identified">
      <bpmn:outgoing>SequenceFlow_S1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Gateway to check stock availability -->
    <bpmn:exclusiveGateway id="Gateway_CheckStock" name="Sufficient Stock?">
      <bpmn:incoming>SequenceFlow_S1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_YesStock</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoStock</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task for local consumption -->
    <bpmn:task id="Task_ConsumeLocally" name="Consume Goods Locally">
      <bpmn:incoming>SequenceFlow_YesStock</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndLocal</bpmn:outgoing>
    </bpmn:task>

    <!-- Task for creating purchase requisition -->
    <bpmn:task id="Task_CreatePurchaseRequisition" name="Define Goods &amp; Create Requisition in ERP">
      <bpmn:incoming>SequenceFlow_NoStock</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToProcurement</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway to check supplier information -->
    <bpmn:exclusiveGateway id="Gateway_CheckSupplierInfo" name="Supplier Info Available?">
      <bpmn:incoming>SequenceFlow_ToProcurement</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SupplierKnown</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NewSupplierPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task for creating new supplier -->
    <bpmn:task id="Task_NewSupplierCreation" name="Create New Supplier in ERP">
      <bpmn:incoming>SequenceFlow_NewSupplierPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SupplierCreated</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway to merge supplier paths and create order template -->
    <bpmn:exclusiveGateway id="Gateway_MergeSupplierPaths" name="Merge Supplier Paths">
      <bpmn:incoming>SequenceFlow_SupplierKnown</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_SupplierCreated</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToOrderTemplate</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task for creating order template -->
    <bpmn:task id="Task_CreateOrderTemplate" name="Create Order Template in ERP">
      <bpmn:incoming>SequenceFlow_ToOrderTemplate</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToApproval</bpmn:outgoing>
    </bpmn:task>

    <!-- Task for approving order and triggering purchase order -->
    <bpmn:task id="Task_ApproveAndTriggerPO" name="Approve Order &amp; Trigger Purchase">
      <bpmn:incoming>SequenceFlow_ToApproval</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OrderDone</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Completed" name="Purchase Process Completed">
       <bpmn:incoming>SequenceFlow_EndLocal</bpmn:incoming>
       <bpmn:incoming>SequenceFlow_OrderDone</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>