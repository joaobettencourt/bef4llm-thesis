<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_InvoiceProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_InvProc">
    <bpmn:participant id="Participant_AdminOffice" name="Admin Office SSP" processRef="Process_Inv01"/>
    <bpmn:participant id="Participant_Client" name="Client"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Inv01" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_AdminOffice" name="Admin Office SSP">
        <bpmn:flowNodeRef>StartEvent_InvoiceReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SortClient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SortVendor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AttachForm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CompletenessCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SLAEntry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterSLAInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PriorityCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ApplyRedStamp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MergePriority</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ComplianceCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AllocateDEO1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ProcessComplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_InformationRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendToExperienceStaff</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CallClient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendPostalMail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateCatchEvent_ReminderTimer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MergeInfoObtained</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AllocateDEO2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_InvoiceReceived" name="Invoice Received">
      <bpmn:outgoing>SequenceFlow_S1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Tasks for Admin Office -->
    <bpmn:task id="Task_SortClient" name="Sort Invoice per Client">
      <bpmn:incoming>SequenceFlow_S1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_S2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_SortVendor" name="Sort Invoice per Vendor">
      <bpmn:incoming>SequenceFlow_S2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_S3</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_AttachForm" name="Attach Invoice Entry Form">
      <bpmn:incoming>SequenceFlow_S3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_S4</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_EnterInfo" name="Enter Required Info on Form">
      <bpmn:incoming>SequenceFlow_S4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_G1</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for Completeness Check -->
    <bpmn:exclusiveGateway id="Gateway_CompletenessCheck" name="Invoice Complete?">
      <bpmn:incoming>SequenceFlow_G1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NC_Yes</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NC_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event for Incomplete Invoice -->
    <bpmn:endEvent id="EndEvent_InvoiceNotComplete" name="Invoice Not Complete">
      <bpmn:incoming>SequenceFlow_NC_No</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Gateway after Completeness Check - SLA Entry -->
    <bpmn:exclusiveGateway id="Gateway_SLAEntry" name="SLA Info Required">
      <bpmn:incoming>SequenceFlow_NC_Yes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SL1</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task for SLA Entry -->
    <bpmn:task id="Task_EnterSLAInfo" name="Enter Info for SLA">
      <bpmn:incoming>SequenceFlow_SL1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_P1</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for Priority Check -->
    <bpmn:exclusiveGateway id="Gateway_PriorityCheck" name="High Priority?">
      <bpmn:incoming>SequenceFlow_P1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_HP_Yes</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_HP_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task for Red Stamp -->
    <bpmn:task id="Task_ApplyRedStamp" name="Apply Red Stamp">
      <bpmn:incoming>SequenceFlow_HP_Yes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_P2</bpmn:outgoing>
    </bpmn:task>

    <!-- Merge after Priority Handling -->
    <bpmn:exclusiveGateway id="Gateway_MergePriority" name="">
      <bpmn:incoming>SequenceFlow_HP_No</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_P2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_C1</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Gateway for Compliance Check -->
    <bpmn:exclusiveGateway id="Gateway_ComplianceCheck" name="Invoice Compliant?">
      <bpmn:incoming>SequenceFlow_C1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CC_Yes</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CC_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task for Allocate to DEO (Complete Invoice) -->
    <bpmn:task id="Task_AllocateDEO1" name="Allocate Invoice to DEO">
      <bpmn:incoming>SequenceFlow_CC_Yes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_E1</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event for Complete Process -->
    <bpmn:endEvent id="EndEvent_ProcessComplete" name="Process Completed">
      <bpmn:incoming>SequenceFlow_E1</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Gateway for Information Request Options -->
    <bpmn:exclusiveGateway id="Gateway_InformationRequest" name="How to Obtain Info?">
      <bpmn:incoming>SequenceFlow_CC_No</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_IR1</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_IR2</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_IR3</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task for Send to Experience Staff -->
    <bpmn:task id="Task_SendToExperienceStaff" name="Send to Experience Staff">
      <bpmn:incoming>SequenceFlow_IR1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_T2</bpmn:outgoing>
    </bpmn:task>

    <!-- Task for Call Client -->
    <bpmn:task id="Task_CallClient" name="Call Client and Request Info">
      <bpmn:incoming>SequenceFlow_IR2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_T1</bpmn:outgoing>
    </bpmn:task>

    <!-- Task for Send Postal Mail -->
    <bpmn:task id="Task_SendPostalMail" name="Send Postal Mail Requesting Info">
      <bpmn:incoming>SequenceFlow_IR3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_T1</bpmn:outgoing>
    </bpmn:task>

    <!-- Timer Event for 10 Hours Reminder -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_ReminderTimer" name="Reminder after 10 hours">
      <bpmn:incoming>SequenceFlow_T2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_R1</bpmn:outgoing>
      <bpmn:timerEventDefinition/>
    </bpmn:intermediateCatchEvent>

    <!-- Gateway for Merge when Info Obtained -->
    <bpmn:exclusiveGateway id="Gateway_MergeInfoObtained" name="">
      <bpmn:incoming>SequenceFlow_T1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MO_Yes</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_MO_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task for Allocate to DEO (After Info Obtained) -->
    <bpmn:task id="Task_AllocateDEO2" name="Allocate Invoice to DEO">
      <bpmn:incoming>SequenceFlow_MO_Yes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_E1</bpmn:outgoing>
    </bpmn:task>

  </bpmn:process>

  <!-- Sequence Flows -->
  <bpmn:sequenceFlow id="SequenceFlow_S1" sourceRef="StartEvent_InvoiceReceived" targetRef="Task_SortClient"/>
  <bpmn:sequenceFlow id="SequenceFlow_S2" sourceRef="Task_SortClient" targetRef="Task_SortVendor"/>
  <bpmn:sequenceFlow id="SequenceFlow_S3" sourceRef="Task_SortVendor" targetRef="Task_AttachForm"/>
  <bpmn:sequenceFlow id="SequenceFlow_S4" sourceRef="Task_AttachForm" targetRef="Task_EnterInfo"/>

  <!-- Completeness Check -->
  <bpmn:sequenceFlow id="SequenceFlow_G1" name="" sourceRef="Task_EnterInfo" targetRef="Gateway_CompletenessCheck"/>
  <bpmn:sequenceFlow id="SequenceFlow_NC_Yes" name="Complete" sourceRef="Gateway_CompletenessCheck" targetRef="Gateway_SLAEntry"/>
  <bpmn:sequenceFlow id="SequenceFlow_NC_No" name="Not Complete" sourceRef="Gateway_CompletenessCheck" targetRef="EndEvent_InvoiceNotComplete"/>

  <!-- SLA Entry -->
  <bpmn:sequenceFlow id="SequenceFlow_SL1" name="" sourceRef="Gateway_SLAEntry" targetRef="Task_EnterSLAInfo"/>

  <!-- Priority Check -->
  <bpmn:sequenceFlow id="SequenceFlow_P1" name="" sourceRef="Task_EnterSLAInfo" targetRef="Gateway_PriorityCheck"/>
  <bpmn:sequenceFlow id="SequenceFlow_HP_Yes" name="High Priority" sourceRef="Gateway_PriorityCheck" targetRef="Task_ApplyRedStamp"/>
  <bpmn:sequenceFlow id="SequenceFlow_HP_No" name="" sourceRef="Gateway_PriorityCheck" targetRef="Gateway_MergePriority"/>

  <!-- Merge after Priority -->
  <bpmn:sequenceFlow id="SequenceFlow_P2" name="" sourceRef="Task_ApplyRedStamp" targetRef="Gateway_MergePriority"/>

  <!-- Compliance Check -->
  <bpmn:sequenceFlow id="SequenceFlow_C1" name="" sourceRef="Gateway_MergePriority" targetRef="Gateway_ComplianceCheck"/>
  <bpmn:sequenceFlow id="SequenceFlow_CC_Yes" name="Compliant" sourceRef="Gateway_ComplianceCheck" targetRef="Task_AllocateDEO1"/>
  <bpmn:sequenceFlow id="SequenceFlow_CC_No" name="Not Compliant" sourceRef="Gateway_ComplianceCheck" targetRef="Gateway_InformationRequest"/>

  <!-- Information Request Options -->
  <bpmn:sequenceFlow id="SequenceFlow_IR1" name="" sourceRef="Gateway_InformationRequest" targetRef="Task_SendToExperienceStaff"/>
  <bpmn:sequenceFlow id="SequenceFlow_IR2" name="" sourceRef="Gateway_InformationRequest" targetRef="Task_CallClient"/>
  <bpmn:sequenceFlow id="SequenceFlow_IR3" name="" sourceRef="Gateway_InformationRequest" targetRef="Task_SendPostalMail"/>

  <!-- Timer and Info Obtained -->
  <bpmn:sequenceFlow id="SequenceFlow_T1" name="" sourceRef="Task_CallClient" targetRef="Gateway_MergeInfoObtained"/>
  <bpmn:sequenceFlow id="SequenceFlow_T2" name="" sourceRef="Task_SendToExperienceStaff" targetRef="IntermediateCatchEvent_ReminderTimer"/>

  <!-- Merge Info Obtained -->
  <bpmn:sequenceFlow id="SequenceFlow_MO_Yes" name="Info Obtained" sourceRef="Gateway_MergeInfoObtained" targetRef="Task_AllocateDEO2"/>
</bpmn:definitions>