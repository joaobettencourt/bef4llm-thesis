<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_InvoiceProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_InvProc">
    <bpmn:participant id="Participant_SSP" name="SSP Organization" processRef="Process_INV001"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_INV001" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_MailCentre" name="Mail Centre Office">
        <bpmn:flowNodeRef>StartEvent_ReceiveInvoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CategorizeInvoice</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AdminDept" name="Administration Department">
        <bpmn:flowNodeRef>Task_ProcessInvoiceComplexly</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PutInCollectionBox</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_DataEntry" name="Data Entry Office">
        <bpmn:flowNodeRef>Task_EnterSAPSystem</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ValidationOffice" name="Validation Office">
        <bpmn:flowNodeRef>Task_ExecuteValidationProcess</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PaymentOffice" name="Payment Office">
        <bpmn:flowNodeRef>Task_ExecutePaymentProcess</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_RegistryOffice" name="Registry Office">
        <bpmn:flowNodeRef>Task_ArchiveInvoices</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ProcessComplete</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_ReceiveInvoice" name="Invoice Received from Client">
      <bpmn:outgoing>SequenceFlow_S1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Mail Centre Tasks -->
    <bpmn:task id="Task_CategorizeInvoice" name="Categorize Invoice by Staff Member">
      <bpmn:incoming>SequenceFlow_S1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_M2A</bpmn:outgoing>
    </bpmn:task>

    <!-- Administration Department Tasks -->
    <bpmn:task id="Task_ProcessInvoiceComplexly" name="Process Invoice (Complex Process)">
      <bpmn:incoming>SequenceFlow_A1D</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_A2C</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_PutInCollectionBox" name="Put Invoices in Collection Box">
      <bpmn:incoming>SequenceFlow_A2C</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_C3D</bpmn:outgoing>
    </bpmn:task>

    <!-- Data Entry Office Task -->
    <bpmn:task id="Task_EnterSAPSystem" name="Enter All Data in SAP System (Complex Process)">
      <bpmn:incoming>SequenceFlow_D1E</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_E2V</bpmn:outgoing>
    </bpmn:task>

    <!-- Validation Office Task -->
    <bpmn:task id="Task_ExecuteValidationProcess" name="Execute Big Process of Validating Invoices">
      <bpmn:incoming>SequenceFlow_V1P</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_P2R</bpmn:outgoing>
    </bpmn:task>

    <!-- Payment Office Task -->
    <bpmn:task id="Task_ExecutePaymentProcess" name="Execute Big Process of Paying Validated Invoices">
      <bpmn:incoming>SequenceFlow_P1V</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_R2E</bpmn:outgoing>
    </bpmn:task>

    <!-- Registry Office Task -->
    <bpmn:task id="Task_ArchiveInvoices" name="Archive All Invoices">
      <bpmn:incoming>SequenceFlow_R1P</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_E2END</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_ProcessComplete" name="Process Complete">
      <bpmn:incoming>SequenceFlow_E2END</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_S1" sourceRef="StartEvent_ReceiveInvoice" targetRef="Task_CategorizeInvoice"/>
    
    <bpmn:exclusiveGateway id="Gateway_AdminReview">
      <bpmn:incoming>SequenceFlow_M2A</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_A1D</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="SequenceFlow_M2A" sourceRef="Task_CategorizeInvoice" targetRef="Gateway_AdminReview"/>
    
    <bpmn:parallelGateway id="Gateway_SplitReview">
      <bpmn:incoming>SequenceFlow_A1D</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_D1E</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:sequenceFlow id="SequenceFlow_A2C" sourceRef="Task_ProcessInvoiceComplexly" targetRef="Task_PutInCollectionBox"/>
    
    <bpmn:exclusiveGateway id="Gateway_ReviewDecision">
      <bpmn:incoming>SequenceFlow_C3D</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_D1E</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="SequenceFlow_D1E" sourceRef="Task_PutInCollectionBox" targetRef="Task_EnterSAPSystem"/>
    
    <bpmn:parallelGateway id="Gateway_HourlyReview">
      <bpmn:incoming>SequenceFlow_E2V</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_V1P</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:sequenceFlow id="SequenceFlow_P1V" sourceRef="Task_EnterSAPSystem" targetRef="Task_ExecuteValidationProcess"/>
    
    <bpmn:exclusiveGateway id="Gateway_PaymentDecision">
      <bpmn:incoming>SequenceFlow_V1P</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_R1P</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="SequenceFlow_P2R" sourceRef="Task_ExecuteValidationProcess" targetRef="Task_ExecutePaymentProcess"/>
    
    <bpmn:parallelGateway id="Gateway_ArchiveDecision">
      <bpmn:incoming>SequenceFlow_R1P</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_E2END</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:sequenceFlow id="SequenceFlow_V1P" sourceRef="Task_ExecuteValidationProcess" targetRef="Task_ExecutePaymentProcess"/>
    
  </bpmn:process>
</bpmn:definitions>