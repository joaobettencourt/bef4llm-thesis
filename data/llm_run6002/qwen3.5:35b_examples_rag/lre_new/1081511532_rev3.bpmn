<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ClientAcquisition" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="Pool_SalesProcess" name="Client Acquisition Process" processRef="Proc_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Proc_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Marketing" name="Marketing Team">
        <bpmn:flowNodeRef>T_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Analysis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Presentation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_SendOffers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ReportResponses</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Management" name="Management Team">
        <bpmn:flowNodeRef>G_Acceptance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_NegotiationOffer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ContractPrepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_SignContract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_AnalyzeFailure</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="T_Start" name="New Clients Needed Indicated">
      <bpmn:outgoing>SF_1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Marketing Tasks -->
    <bpmn:task id="T_Analysis" name="Market Analysis">
      <bpmn:incoming>SF_1</bpmn:incoming>
      <bpmn:outgoing>SF_2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="T_Presentation" name="Prepare Portfolio Presentation">
      <bpmn:incoming>SF_2</bpmn:incoming>
      <bpmn:outgoing>SF_3</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="T_SendOffers" name="Send Offers to Potential Clients">
      <bpmn:incoming>SF_3</bpmn:incoming>
      <bpmn:outgoing>SF_4</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="T_ReportResponses" name="Inform Management about Responses">
      <bpmn:incoming>SF_4</bpmn:incoming>
      <bpmn:outgoing>SF_5</bpmn:outgoing>
    </bpmn:task>

    <!-- Negotiation Phase (Management) -->
    <bpmn:task id="T_NegotiationOffer" name="Send Detailed Offer to Client">
      <bpmn:incoming>SF_5</bpmn:incoming>
      <bpmn:outgoing>SF_6</bpmn:outgoing>
    </bpmn:task>

    <!-- Decision Gateway -->
    <bpmn:exclusiveGateway id="G_Acceptance" name="Client Accepts Offer?">
      <bpmn:incoming>SF_6</bpmn:incoming>
      <bpmn:outgoing>SF_7</bpmn:outgoing> <!-- Yes -->
      <bpmn:outgoing>SF_8</bpmn:outgoing> <!-- No/Otherwise -->
    </bpmn:exclusiveGateway>

    <!-- Success Path -->
    <bpmn:task id="T_ContractPrepare" name="Prepare Contract">
      <bpmn:incoming>SF_7</bpmn:incoming>
      <bpmn:outgoing>SF_9</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="T_SignContract" name="Sign Contract">
      <bpmn:incoming>SF_9</bpmn:incoming>
      <bpmn:outgoing>SF_EndSuccess</bpmn:outgoing>
    </bpmn:task>

    <!-- Failure Path -->
    <bpmn:task id="T_AnalyzeFailure" name="Analyze Offer Failure Reasons">
      <bpmn:incoming>SF_8</bpmn:incoming>
      <bpmn:outgoing>SF_EndFail</bpmn:outgoing>
    </bpmn:task>

    <!-- End Events -->
    <bpmn:endEvent id="E_Success" name="Contract Signed">
      <bpmn:incoming>SF_EndSuccess</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="E_Fail" name="Analysis Complete / Offer Failed">
      <bpmn:incoming>SF_EndFail</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SF_1" sourceRef="T_Start" targetRef="T_Analysis"/>
    <bpmn:sequenceFlow id="SF_2" sourceRef="T_Analysis" targetRef="T_Presentation"/>
    <bpmn:sequenceFlow id="SF_3" sourceRef="T_Presentation" targetRef="T_SendOffers"/>
    <bpmn:sequenceFlow id="SF_4" sourceRef="T_SendOffers" targetRef="T_ReportResponses"/>
    <bpmn:sequenceFlow id="SF_5" name="Inform Management" sourceRef="T_ReportResponses" targetRef="T_NegotiationOffer"/>
    
    <!-- Gateway Flows -->
    <bpmn:sequenceFlow id="SF_6" sourceRef="T_NegotiationOffer" targetRef="G_Acceptance"/>
    <bpmn:sequenceFlow id="SF_7" name="Yes / Accepts" sourceRef="G_Acceptance" targetRef="T_ContractPrepare"/>
    <bpmn:sequenceFlow id="SF_8" name="No / Otherwise" sourceRef="G_Acceptance" targetRef="T_AnalyzeFailure"/>

    <!-- End Flows -->
    <bpmn:sequenceFlow id="SF_9" sourceRef="T_ContractPrepare" targetRef="T_SignContract"/>
    <bpmn:sequenceFlow id="SF_EndSuccess" sourceRef="T_SignContract" targetRef="E_Success"/>
    <bpmn:sequenceFlow id="SF_EndFail" sourceRef="T_AnalyzeFailure" targetRef="E_Fail"/>

  </bpmn:process>
</bpmn:definitions>