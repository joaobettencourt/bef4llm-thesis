<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <process id="MaternityLeaveProcess" isExecutable="false">
    <laneSet>
      <lane id="Lane_Parents" name="Parents">
        <flowNodeRef>StartEvent_MaternityDecision</flowNodeRef>
        <flowNodeRef>Task_FetchModels</flowNodeRef>
        <flowNodeRef>Gateway_SelectModel</flowNodeRef>
        <flowNodeRef>UserTask_InformationCollection</flowNodeRef>
        <flowNodeRef>Gateway_DecideExtension</flowNodeRef>
      </lane>
      <lane id="Lane_SocialSecurity" name="Social Security">
        <flowNodeRef>ServiceTask_NotifySS</flowNodeRef>
      </lane>
      <lane id="Lane_Company" name="Company">
        <flowNodeRef>UserTask_InformationGather</flowNodeRef>
        <flowNodeRef>EndEvent_ProcessComplete</flowNodeRef>
      </lane>
    </laneSet>

    <!-- Start Event -->
    <startEvent id="StartEvent_MaternityDecision" name="Decide to take maternity leave">
      <bpmn:outgoing>SequenceFlow_FetchModels</bpmn:outgoing>
    </startEvent>

    <!-- Task 1 - Fetch Models Information (Parents) -->
    <task id="Task_FetchModels" name="Fetch information about potential models">
      <incoming>SequenceFlow_FetchModels</incoming>
      <outgoing>SequenceFlow_SelectModelDecision</outgoing>
    </task>

    <!-- Gateway 1 - Select Model (Parents) -->
    <exclusiveGateway id="Gateway_SelectModel" name="Select model?">
      <bpmn:incoming>SequenceFlow_SelectModelDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CollectInformation</bpmn:outgoing>
    </exclusiveGateway>

    <!-- Task 2 - Collect Information (Parents) -->
    <task id="UserTask_InformationCollection" name="Collect relevant information">
      <incoming>SequenceFlow_CollectInformation</incoming>
      <outgoing>SequenceFlow_NotifyParties</outgoing>
    </task>

    <!-- Task 3 - Notify Social Security (Social Security Lane) -->
    <serviceTask id="ServiceTask_NotifySS" name="Notify Social Security">
      <bpmn:incoming>SequenceFlow_NotifyParties</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GatherCompanyInfo</bpmn:outgoing>
    </serviceTask>

    <!-- Task 4 - Gather Information from Companies (Company Lane) -->
    <task id="UserTask_InformationGather" name="Gather information from companies">
      <incoming>SequenceFlow_GatherCompanyInfo</incoming>
      <bpmn:outgoing>SequenceFlow_EndPeriodDecision</bpmn:outgoing>
    </task>

    <!-- Gateway 2 - Decide Extension (Parents) -->
    <exclusiveGateway id="Gateway_DecideExtension" name="Decide extension?">
      <incoming>SequenceFlow_EndPeriodDecision</incoming>
      <outgoing>SequenceFlow_ExtendLeave</outgoing>
      <outgoing>SequenceFlow_ProcessComplete</outgoing>
    </exclusiveGateway>

    <!-- End Event -->
    <endEvent id="EndEvent_ProcessComplete" name="Process complete">
      <bpmn:incoming>SequenceFlow_ProcessComplete</bpmn:incoming>
    </endEvent>

    <!-- Sequence Flows -->
    <sequenceFlow id="SequenceFlow_FetchModels" sourceRef="StartEvent_MaternityDecision" targetRef="Task_FetchModels"/>
    <sequenceFlow id="SequenceFlow_SelectModelDecision" name="Select model" sourceRef="Gateway_SelectModel" targetRef="UserTask_InformationCollection"/>
    <sequenceFlow id="SequenceFlow_CollectInformation" sourceRef="UserTask_InformationCollection" targetRef="ServiceTask_NotifySS"/>
    <sequenceFlow id="SequenceFlow_GatherCompanyInfo" name="Gather information from companies" sourceRef="ServiceTask_NotifySS" targetRef="Gateway_DecideExtension">
      <!-- Notify parties then gather info -->
    </sequenceFlow>

  </process>
</bpmn:definitions>