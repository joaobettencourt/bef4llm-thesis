<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_3dmodeling" targetNamespace="http://bpmn.io/schema/bpmn">
  <process id="Process_Custom3DModel" isExecutable="false">
    <laneSet>
      <lane id="Lane_Customer" name="Customer">
        <flowNodeRef>StartEvent_Request</flowNodeRef>
        <flowNodeRef>Task_InstructArtist</flowNodeRef>
        <flowNodeRef>Gateway_ColorInStock</flowNodeRef>
        <flowNodeRef>Task_CheckQuantity</flowNodeRef>
        <flowNodeRef>Gateway_Under100g</flowNodeRef>
        <flowNodeRef>Task_AddShoppingList</flowNodeRef>
        <flowNodeRef>Task_OrderColor</flowNodeRef>
        <flowNodeRef>Gateway_ConvergePrinterSetup</flowNodeRef>
        <flowNodeRef>Task_TurnOnPrinter</flowNodeRef>
        <flowNodeRef>Task_GenerateGcode</flowNodeRef>
        <flowNodeRef>Task_PrintModel</flowNodeRef>
      </lane>
    </laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Request" name="Request custom 3D model">
      <bpmn:outgoing>bpmn:SequenceFlow_InstructArtist</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Instruct Artist -->
    <bpmn:task id="Task_InstructArtist" name="Instruct artist to create project&#10;(send sketches, feedback until satisfied)">
      <bpmn:incoming>bpmn:SequenceFlow_InstructArtist</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_ColorDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Color in stock? -->
    <bpmn:exclusiveGateway id="Gateway_ColorInStock">
      <bpmn:name>Color at home?</bpmn:name>
      <bpmn:incoming>bpmn:SequenceFlow_ColorDecision</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_CheckQuantity</bpmn:outgoing>
      <bpmn:outgoing>bpmn:SequenceFlow_OrderColorTask</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Check quantity -->
    <bpmn:task id="Task_CheckQuantity" name="Check how much plastic left">
      <bpmn:incoming>bpmn:SequenceFlow_ColorDecision</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_Under100gDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Under 100 grams? -->
    <bpmn:exclusiveGateway id="Gateway_Under100g">
      <bpmn:name>&lt;= 100g left?</bpmn:name>
      <bpmn:incoming>bpmn:SequenceFlow_Under100gDecision</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_AddShoppingListTask</bpmn:outgoing>
      <bpmn:outgoing>bpmn:SequenceFlow_EnoughPlastic</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Add to shopping list -->
    <bpmn:task id="Task_AddShoppingList" name="Add color to shopping list">
      <bpmn:incoming>bpmn:SequenceFlow_AddShoppingListTask</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_EnoughPlastic</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Order color -->
    <bpmn:task id="Task_OrderColor" name="Order plastic color">
      <bpmn:incoming>bpmn:SequenceFlow_ColorDecision</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_PrinterReady</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway convergence for printer setup -->
    <bpmn:exclusiveGateway id="Gateway_ConvergePrinterSetup">
      <bpmn:name/>
      <bpmn:incoming>bpmn:SequenceFlow_EnoughPlastic</bpmn:incoming>
      <bpmn:incoming>bpmn:SequenceFlow_PrinterReady</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_TurnOnPrinterTask</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Turn on printer -->
    <bpmn:task id="Task_TurnOnPrinter" name="Turn on printer, heat bed &amp; extruder&#10;(receive status feedback)">
      <bpmn:incoming>bpmn:SequenceFlow_TurnOnPrinterTask</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_GenerateGcodeTask</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Generate gcode -->
    <bpmn:task id="Task_GenerateGcode" name="Generate gcode file&#10;(from artist's STL)">
      <bpmn:incoming>bpmn:SequenceFlow_TurnOnPrinterTask</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_PrintModelTask</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Print model -->
    <bpmn:task id="Task_PrintModel" name="Print 3D model">
      <bpmn:incoming>bpmn:SequenceFlow_GenerateGcodeTask</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_EndEvent</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Completed" name="Custom 3D model printed">
      <bpmn:incoming>bpmn:SequenceFlow_PrintModelTask</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_InstructArtist" sourceRef="StartEvent_Request" targetRef="Task_InstructArtist"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ColorDecision" name="" sourceRef="Task_InstructArtist" targetRef="Gateway_ColorInStock"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_CheckQuantity" name="Yes, in stock" sourceRef="Gateway_ColorInStock" targetRef="Task_CheckQuantity"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_OrderColorTask" name="No, not at home" sourceRef="Gateway_ColorInStock" targetRef="Task_OrderColor"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_Under100gDecision" name="" sourceRef="Task_CheckQuantity" targetRef="Gateway_Under100g"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_AddShoppingListTask" name="Under 100g" sourceRef="Gateway_Under100g" targetRef="Task_AddShoppingList"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_EnoughPlastic" name="" sourceRef="Gateway_Under100g" targetRef="Gateway_ConvergePrinterSetup"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_PrinterReady" name="" sourceRef="Task_OrderColor" targetRef="Gateway_ConvergePrinterSetup"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_TurnOnPrinterTask" name="" sourceRef="Gateway_ConvergePrinterSetup" targetRef="Task_TurnOnPrinter"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_GenerateGcodeTask" name="" sourceRef="Task_TurnOnPrinter" targetRef="Task_GenerateGcode"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_PrintModelTask" name="" sourceRef="Task_GenerateGcode" targetRef="Task_PrintModel"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_EndEvent" name="" sourceRef="Task_PrintModel" targetRef="EndEvent_Completed"/>

  </process>
</bpmn:definitions>