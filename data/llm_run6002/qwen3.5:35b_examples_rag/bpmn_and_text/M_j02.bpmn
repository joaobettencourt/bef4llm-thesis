<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_AirplaneManufacturing">
    <bpmn:participant id="Participant_ManufacturingCompany" name="Luxury Airplane Manufacturing Company" processRef="Process_LuxuryAirplane"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_LuxuryAirplane" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_SalesDepartment" name="Sales Department">
        <bpmn:flowNodeRef>bpmn_StartEvent_CustomerOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bpmn_Task_ReceiveSpecifications</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bpmn_Gateway_SendRequirements</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_ManufacturingTeams" name="Manufacturing Teams">
        <bpmn:flowNodeRef>bpmn_Task_ManufactureVodkaBar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bpmn_Task_ManufactureWhiskeyBar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bpmn_Task_AssembleSeats</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bpmn_Task_ApplyColorScheme</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bpmn_Task_InstallToiletSystem</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_AssemblyTeam" name="Assembly Team">
        <bpmn:flowNodeRef>bpmn_Gateway_PartsReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bpmn_Task_AssembleInterior</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_QualityControl" name="Quality Control">
        <bpmn:flowNodeRef>bpmn_Gateway_TestFlightDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bpmn_Task_ConductTestFlight</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bpmn_Task_CreateTestProtocol</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_DeliveryTeam" name="Delivery Team">
        <bpmn:flowNodeRef>bpmn_Gateway_SendProtocols</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bpmn_Task_ShipToCustomer</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Customer" name="Customer">
        <bpmn:flowNodeRef>bpmn_Gateway_ConfirmationReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bpmn_Task_CustomerConfirmation</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Company" name="Company">
        <bpmn:flowNodeRef>bpmn_EndEvent_OrderCompleted</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_CustomerOrder" name="Customer places custom order">
      <bpmn:outgoing>bpmn_SequenceFlow_ReceiveSpecifications</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Receive Specifications (Sales) -->
    <bpmn:task id="Task_ReceiveSpecifications" name="Receive customer specifications">
      <bpmn:incoming>bpmn_SequenceFlow_ReceiveSpecifications</bpmn:incoming>
      <bpmn:outgoing>bpmn_SequenceFlow_SendRequirements</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Send Requirements to Teams (Parallel Split) -->
    <bpmn:parallelGateway id="Gateway_SendRequirements">
      <bpmn:incoming>bpmn_SequenceFlow_SendRequirements</bpmn:incoming>
      <bpmn:outgoing>bpmn_SequenceFlow_VodkaBarTask</bpmn:outgoing>
      <bpmn:outgoing>bpmn_SequenceFlow_WhiskeyBarTask</bpmn:outgoing>
      <bpmn:outgoing>bpmn_SequenceFlow_SeatsTask</bpmn:outgoing>
      <bpmn:outgoing>bpmn_SequenceFlow_ColorTask</bpmn:outgoing>
      <bpmn:outgoing>bpmn_SequenceFlow_ToiletSystemTask</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Manufacturing Tasks (Parallel) -->
    <bpmn:task id="Task_ManufactureVodkaBar" name="Manufacture vodka bar">
      <bpmn:incoming>bpmn_SequenceFlow_VodkaBarTask</bpmn:incoming>
      <bpmn:outgoing>bpmn_SequenceFlow_PartsReceived1</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_ManufactureWhiskeyBar" name="Manufacture whiskey bar">
      <bpmn:incoming>bpmn_SequenceFlow_WhiskeyBarTask</bpmn:incoming>
      <bpmn:outgoing>bpmn_SequenceFlow_PartsReceived2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_AssembleSeats" name="Assemble seats">
      <bpmn:incoming>bpmn_SequenceFlow_SeatsTask</bpmn:incoming>
      <bpmn:outgoing>bpmn_SequenceFlow_PartsReceived3</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_ApplyColorScheme" name="Apply color scheme">
      <bpmn:incoming>bpmn_SequenceFlow_ColorTask</bpmn:incoming>
      <bpmn:outgoing>bpmn_SequenceFlow_PartsReceived4</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_InstallToiletSystem" name="Install toilet water system">
      <bpmn:incoming>bpmn_SequenceFlow_ToiletSystemTask</bpmn:incoming>
      <bpmn:outgoing>bpmn_SequenceFlow_PartsReceived5</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Parts Received (Parallel Join) -->
    <bpmn:parallelGateway id="Gateway_PartsReceived">
      <bpmn:incoming>bpmn_SequenceFlow_PartsReceived1</bpmn:incoming>
      <bpmn:incoming>bpmn_SequenceFlow_PartsReceived2</bpmn:incoming>
      <bpmn:incoming>bpmn_SequenceFlow_PartsReceived3</bpmn:incoming>
      <bpmn:incoming>bpmn_SequenceFlow_PartsReceived4</bpmn:incoming>
      <bpmn:incoming>bpmn_SequenceFlow_PartsReceived5</bpmn:incoming>
      <bpmn:outgoing>bpmn_SequenceFlow_AssembleInterior</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Assemble Interior -->
    <bpmn:task id="Task_AssembleInterior" name="Assemble interior">
      <bpmn:incoming>bpmn_SequenceFlow_AssembleInterior</bpmn:incoming>
      <bpmn:outgoing>bpmn_SequenceFlow_TestFlightDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Test Flight Decision (Exclusive) -->
    <bpmn:exclusiveGateway id="Gateway_TestFlightDecision">
      <bpmn:incoming>bpmn_SequenceFlow_TestFlightDecision</bpmn:incoming>
      <bpmn:outgoing>bpmn_SequenceFlow_ConductTestFlight</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Conduct Test Flight -->
    <bpmn:task id="Task_ConductTestFlight" name="Conduct test flight">
      <bpmn:incoming>bpmn_SequenceFlow_ConductTestFlight</bpmn:incoming>
      <bpmn:outgoing>bpmn_SequenceFlow_CreateProtocol</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Create Test Protocol -->
    <bpmn:task id="Task_CreateTestProtocol" name="Create test protocol">
      <bpmn:incoming>bpmn_SequenceFlow_CreateProtocol</bpmn:incoming>
      <bpmn:outgoing>bpmn_SequenceFlow_SendProtocols</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Send Protocols (Parallel Split) -->
    <bpmn:parallelGateway id="Gateway_SendProtocols">
      <bpmn:incoming>bpmn_SequenceFlow_SendProtocols</bpmn:incoming>
      <bpmn:outgoing>bpmn_SequenceFlow_ShipToCustomer</bpmn:outgoing>
      <bpmn:outgoing>bpmn_SequenceFlow_CustomerConfirmationTask</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Ship to Customer -->
    <bpmn:task id="Task_ShipToCustomer" name="Ship plane to customer">
      <bpmn:incoming>bpmn_SequenceFlow_ShipToCustomer</bpmn:incoming>
      <bpmn:outgoing>bpmn_SequenceFlow_ConfirmationReceived</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Confirmation Received (Parallel Join) -->
    <bpmn:parallelGateway id="Gateway_ConfirmationReceived">
      <bpmn:incoming>bpmn_SequenceFlow_CustomerConfirmationTask</bpmn:incoming>
      <bpmn:incoming>bpmn_SequenceFlow_ConfirmationReceived</bpmn:incoming>
      <bpmn:outgoing>bpmn_SequenceFlow_OrderCompleted</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Customer Confirmation -->
    <bpmn:task id="Task_CustomerConfirmation" name="Customer confirms delivery">
      <bpmn:incoming>bpmn_SequenceFlow_CustomerConfirmationTask</bpmn:incoming>
      <bpmn:outgoing>bpmn_SequenceFlow_ConfirmationReceived</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_OrderCompleted" name="Order completed successfully">
      <bpmn:incoming>bpmn_SequenceFlow_OrderCompleted</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_ReceiveSpecifications" sourceRef="StartEvent_CustomerOrder" targetRef="Task_ReceiveSpecifications"/>
    <bpmn:sequenceFlow id="SequenceFlow_SendRequirements" sourceRef="Task_ReceiveSpecifications" targetRef="Gateway_SendRequirements"/>

    <bpmn:sequenceFlow id="SequenceFlow_VodkaBarTask" name="Russian team - vodka bar" sourceRef="Gateway_SendRequirements" targetRef="Task_ManufactureVodkaBar"/>
    <bpmn:sequenceFlow id="SequenceFlow_WhiskeyBarTask" name="Irish team - whiskey bar" sourceRef="Gateway_SendRequirements" targetRef="Task_ManufactureWhiskeyBar"/>
    <bpmn:sequenceFlow id="SequenceFlow_SeatsTask" sourceRef="Gateway_SendRequirements" targetRef="Task_AssembleSeats"/>
    <bpmn:sequenceFlow id="SequenceFlow_ColorTask" sourceRef="Gateway_SendRequirements" targetRef="Task_ApplyColorScheme"/>
    <bpmn:sequenceFlow id="SequenceFlow_ToiletSystemTask" name="Toilet water system customization" sourceRef="Gateway_SendRequirements" targetRef="Task_InstallToiletSystem"/>

    <bpmn:sequenceFlow id="SequenceFlow_PartsReceived1" sourceRef="Task_ManufactureVodkaBar" targetRef="Gateway_PartsReceived"/>
    <bpmn:sequenceFlow id="SequenceFlow_PartsReceived2" sourceRef="Task_ManufactureWhiskeyBar" targetRef="Gateway_PartsReceived"/>
    <bpmn:sequenceFlow id="SequenceFlow_PartsReceived3" sourceRef="Task_AssembleSeats" targetRef="Gateway_PartsReceived"/>
    <bpmn:sequenceFlow id="SequenceFlow_PartsReceived4" sourceRef="Task_ApplyColorScheme" targetRef="Gateway_PartsReceived"/>
    <bpmn:sequenceFlow id="SequenceFlow_PartsReceived5" sourceRef="Task_InstallToiletSystem" targetRef="Gateway_PartsReceived"/>

    <bpmn:sequenceFlow id="SequenceFlow_AssembleInterior" sourceRef="Gateway_PartsReceived" targetRef="Task_AssembleInterior"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_TestFlightDecision" name="Ready for test flight?" sourceRef="Task_AssembleInterior" targetRef="Gateway_TestFlightDecision"/>
    <bpmn:sequenceFlow id="SequenceFlow_ConductTestFlight" sourceRef="Gateway_TestFlightDecision" targetRef="Task_ConductTestFlight"/>

    <bpmn:sequenceFlow id="SequenceFlow_CreateProtocol" name="Create test protocol" sourceRef="Task_ConductTestFlight" targetRef="Task_CreateTestProtocol"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_SendProtocols" sourceRef="Task_CreateTestProtocol" targetRef="Gateway_SendProtocols"/>
    <bpmn:sequenceFlow id="SequenceFlow_ShipToCustomer" name="Ship to customer" sourceRef="Gateway_SendProtocols" targetRef="Task_ShipToCustomer"/>

    <bpmn:sequenceFlow id="SequenceFlow_CustomerConfirmationTask" name="Send protocol to customer" sourceRef="Gateway_SendProtocols" targetRef="Task_CustomerConfirmation"/>
    <bpmn:sequenceFlow id="SequenceFlow_ConfirmationReceived" name="Customer confirms delivery" sourceRef="Task_ShipToCustomer" targetRef="Gateway_ConfirmationReceived"/>

    <bpmn:sequenceFlow id="SequenceFlow_OrderCompleted" sourceRef="Gateway_ConfirmationReceived" targetRef="EndEvent_OrderCompleted"/>
  </bpmn:process>
</bpmn:definitions>