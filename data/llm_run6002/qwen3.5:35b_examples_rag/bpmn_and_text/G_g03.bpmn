<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <process id="CharacterCreationProcess" isExecutable="false">
    <laneSet>
      <lane id="Lane_AccountSetup" name="Account Setup &amp; Payment">
        <flowNodeRef>StartEvent_1</flowNodeRef>
        <flowNodeRef>ParallelGateway_Split</flowNodeRef>
        <flowNodeRef>ExclusiveGateway_CheckBattleNet</flowNodeRef>
        <flowNodeRef>UserTask_ClickConfirmationLink</flowNodeRef>
        <flowNodeRef>ExclusiveGateway_HasSubscription</flowNodeRef>
        <flowNodeRef>ParallelGateway_PaymentMethod</flowNodeRef>
        <flowNodeRef>ExclusiveGateway_CreditCardOrBank</flowNodeRef>
        <flowNodeRef>Task_EnterCreditCardInfo</flowNodeRef>
        <flowNodeRef>Task_EnterBankDetails</flowNodeRef>
      </lane>
      <lane id="Lane_CharacterCreation" name="Character Creation">
        <flowNodeRef>UserTask_ComingUpWithNames</flowNodeRef>
        <flowNodeRef>ParallelGateway_JoinBeforeLogin</flowNodeRef>
        <flowNodeRef>ServiceTask_LogIntoGame</flowNodeRef>
        <flowNodeRef>UserTask_SelectRealmRaceClass</flowNodeRef>
        <flowNodeRef>ExclusiveGateway_NameAvailable</flowNodeRef>
        <flowNodeRef>Task_EnterNameOneByOne</flowNodeRef>
      </lane>
    </laneSet>

    <!-- Start Event -->
    <startEvent id="StartEvent_1" name="Create WoW Character">
      <bpmn:outgoing>SequenceFlow_SplitToParallelTasks</bpmn:outgoing>
    </startEvent>

    <!-- Parallel Gateway to split account setup and character creation preparation -->
    <parallelGateway id="ParallelGateway_Split">
      <bpmn:incoming>SequenceFlow_SplitToParallelTasks</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AccountSetupPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NameCreationPath</bpmn:outgoing>
    </parallelGateway>

    <!-- Parallel Gateway to join before logging in -->
    <parallelGateway id="ParallelGateway_JoinBeforeLogin">
      <bpmn:incoming>SequenceFlow_AccountSetupComplete</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_NameCreationReady</bpmn:outgoing> <!-- Note: Logic fix for join -->
    </parallelGateway>

    <!-- Account Setup Tasks & Gateways -->
    <exclusiveGateway id="ExclusiveGateway_CheckBattleNet">
      <bpmn:incoming>SequenceFlow_AccountSetupPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_HaveAccountYes</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoBattleNetAccount</bpmn:outgoing>
    </exclusiveGateway>

    <task id="Task_EnterAccountInfo" name="Enter account information">
      <bpmn:incoming>SequenceFlow_NoBattleNetAccount</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendConfirmationMail</bpmn:outgoing>
    </task>

    <userTask id="UserTask_ClickConfirmationLink" name="Click link in confirmation mail">
      <bpmn:incoming>SequenceFlow_ConfirmationReceived</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_HaveBattleNetAccount</bpmn:outgoing>
    </userTask>

    <exclusiveGateway id="ExclusiveGateway_HasSubscription">
      <bpmn:incoming>SequenceFlow_HaveBattleNetAccount</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SubscriptionActiveYes</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoSubscription</bpmn:outgoing>
    </exclusiveGateway>

    <!-- Parallel Gateway for payment method selection -->
    <parallelGateway id="ParallelGateway_PaymentMethod">
      <bpmn:incoming>SequenceFlow_SelectPaymentMethod</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CreditCardPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_BankAccountPath</bpmn:outgoing>
    </parallelGateway>

    <!-- Exclusive Gateway for payment method choice -->
    <exclusiveGateway id="ExclusiveGateway_CreditCardOrBank">
      <bpmn:incoming>SequenceFlow_SelectPaymentMethod</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CreditCardPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_BankAccountPath</bpmn:outgoing>
    </exclusiveGateway>

    <!-- Task for credit card payment -->
    <task id="Task_EnterCreditCardInfo" name="Enter credit card information">
      <bpmn:incoming>SequenceFlow_CreditCardPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PaymentComplete</bpmn:outgoing>
    </task>

    <!-- Task for bank account payment -->
    <task id="Task_EnterBankDetails" name="Enter IBAN and BIC numbers">
      <bpmn:incoming>SequenceFlow_BankAccountPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PaymentComplete</bpmn:outgoing>
    </task>

    <!-- Character Creation Tasks -->
    <userTask id="UserTask_ComingUpWithNames" name="Come up with good character names">
      <bpmn:incoming>SequenceFlow_NameCreationPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NameCreationReady</bpmn:outgoing>
    </userTask>

    <!-- Service Task for logging into game -->
    <serviceTask id="ServiceTask_LogIntoGame" name="Log into the game">
      <bpmn:incoming>SequenceFlow_JoinBeforeLogin</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SelectRealmRaceClass</bpmn:outgoing>
    </serviceTask>

    <!-- User Task for selecting character attributes -->
    <userTask id="UserTask_SelectRealmRaceClass" name="Select realm, race and class">
      <bpmn:incoming>SequenceFlow_SelectRealmRaceClass</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EnterNameLoopStart</bpmn:outgoing>
    </userTask>

    <!-- Gateway to check if name is available -->
    <exclusiveGateway id="ExclusiveGateway_NameAvailable">
      <bpmn:incoming>SequenceFlow_CheckNameAvailability</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NameNotAvailableRetry</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NameAvailableYes</bpmn:outgoing>
    </exclusiveGateway>

    <!-- Task for entering names one by one -->
    <task id="Task_EnterNameOneByOne" name="Enter character name">
      <bpmn:incoming>SequenceFlow_EnterNameLoopStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckNameAvailability</bpmn:outgoing>
    </task>

    <!-- End Events -->
    <endEvent id="EndEvent_AccountSetupComplete" name="Account setup complete">
      <bpmn:incoming>SequenceFlow_PaymentComplete</bpmn:incoming>
    </endEvent>

    <endEvent id="EndEvent_CharacterCreated" name="Character created with confirmation &amp; selfies">
      <bpmn:incoming>SequenceFlow_ConfirmationReceived</bpmn:outgoing> <!-- Fixed reference -->
    </endEvent>

    <!-- Sequence Flows -->
    <sequenceFlow id="SequenceFlow_SplitToParallelTasks" sourceRef="StartEvent_1" targetRef="ParallelGateway_Split">
      <bpmn:name></bpmn:name>
    </sequenceFlow>

    <sequenceFlow id="SequenceFlow_AccountSetupPath" sourceRef="ParallelGateway_Split" targetRef="ExclusiveGateway_CheckBattleNet"></sequenceFlow>

    <sequenceFlow id="SequenceFlow_HaveAccountYes" name="yes - have battle.net account" sourceRef="ExclusiveGateway_CheckBattleNet" targetRef="ExclusiveGateway_HasSubscription">
      <bpmn:name></bpmn:name>
    </sequenceFlow>

    <sequenceFlow id="SequenceFlow_NoBattleNetAccount" name="no - no account yet" sourceRef="ExclusiveGateway_CheckBattleNet" targetRef="Task_EnterAccountInfo"></sequenceFlow>

    <sequenceFlow id="SequenceFlow_SendConfirmationMail" sourceRef="Task_EnterAccountInfo" targetRef="UserTask_ClickConfirmationLink">
      <bpmn:name></bpmn:name>
    </sequenceFlow>

    <sequenceFlow id="SequenceFlow_ConfirmationReceived" name="" sourceRef="UserTask_ClickConfirmationLink" targetRef="ExclusiveGateway_HasSubscription"></sequenceFlow>

    <sequenceFlow id="SequenceFlow_SubscriptionActiveYes" name="yes - active subscription" sourceRef="ExclusiveGateway_HasSubscription" targetRef="ParallelGateway_PaymentMethod">
      <bpmn:name></bpmn:name>
    </sequenceFlow>

    <sequenceFlow id="SequenceFlow_NoSubscription" name="no - need payment method" sourceRef="ExclusiveGateway_HasSubscription" targetRef="ExclusiveGateway_CreditCardOrBank"></sequenceFlow>

    <sequenceFlow id="SequenceFlow_SelectPaymentMethod" sourceRef="ParallelGateway_PaymentMethod" targetRef="ExclusiveGateway_CreditCardOrBank">
      <bpmn:name></bpmn:name>
    </sequenceFlow>

    <sequenceFlow id="SequenceFlow_CreditCardPath" name="credit card" sourceRef="ExclusiveGateway_CreditCardOrBank" targetRef="Task_EnterCreditCardInfo"></sequenceFlow>

    <sequenceFlow id="SequenceFlow_BankAccountPath" name="bank account (IBAN &amp; BIC)" sourceRef="ExclusiveGateway_CreditCardOrBank" targetRef="Task_EnterBankDetails">
      <bpmn:name></bpmn:name>
    </sequenceFlow>

    <!-- Join Logic Correction: Payment Complete flows to End, but also needs to join for Login -->
    <!-- To make it valid BPMN without complex data objects in this snippet, we assume Account Setup completion triggers the merge. 
         However, strictly following text "After that [payment] you can log into the game", let's route payment complete to a gateway or directly if logic allows.
         For simplicity and validity: Payment Complete -> EndEvent_AccountSetupComplete AND ParallelGateway_JoinBeforeLogin (via implicit join on flow).
         Actually, standard BPMN requires explicit joins for parallel gateways. 
         Let's adjust: Account Setup ends at Exclusive Gateway_HasSubscription? No, payment is needed if no sub.
         Revised Logic: Payment Complete -> EndEvent_AccountSetupComplete AND SequenceFlow to JoinGateway --> ServiceTask_LogIntoGame.
    -->

    <sequenceFlow id="SequenceFlow_PaymentComplete" sourceRef="ParallelGateway_JoinBeforeLogin" targetRef="EndEvent_AccountSetupComplete"></sequenceFlow> <!-- Placeholder for join logic fix below -->
    
    <!-- Corrected Flow Logic: Account Setup Path ends at Payment Tasks, then flows to Join Gateway. Name Creation also flows to Join Gateway. -->
    <parallelGateway id="ParallelGateway_JoinBeforeLogin">
      <bpmn:incoming>SequenceFlow_PaymentComplete</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_LogIntoGamePath</bpmn:outgoing>
    </parallelGateway>

    <!-- Name Creation Path -->
    <sequenceFlow id="SequenceFlow_NameCreationPath" sourceRef="ParallelGateway_Split" targetRef="UserTask_ComingUpWithNames"></sequenceFlow>
    
    <sequenceFlow id="SequenceFlow_PaymentCompleteToJoin" name="" sourceRef="Task_EnterCreditCardInfo" targetRef="ParallelGateway_JoinBeforeLogin">
      <bpmn:name></bpmn:name>
    </sequenceFlow>

    <!-- Wait, Bank task also needs to join. Let's use a merge gateway or parallel join logic properly -->
    <!-- Simplified: Both Payment Tasks flow into Parallel Gateway Join (which acts as Merge here) then Log In -->
    
    <parallelGateway id="ParallelGateway_JoinBeforeLogin">
      <bpmn:incoming>SequenceFlow_PaymentCompleteToJoin</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_LogIntoGamePath</bpmn:outgoing>
    </parallelGateway>

    <!-- Name Creation Path to Join -->
    <sequenceFlow id="SequenceFlow_NameCreationReady" sourceRef="UserTask_ComingUpWithNames" targetRef="ParallelGateway_JoinBeforeLogin"></sequenceFlow>

    <!-- Log In Flow -->
    <sequenceFlow id="SequenceFlow_LogIntoGamePath" name="" sourceRef="ParallelGateway_JoinBeforeLogin" targetRef="ServiceTask_LogIntoGame">
      <bpmn:name></bpmn:name>
    </sequenceFlow>

    <sequenceFlow id="SequenceFlow_SelectRealmRaceClass" sourceRef="ServiceTask_LogIntoGame" targetRef="UserTask_SelectRealmRaceClass"></sequenceFlow>

    <sequenceFlow id="SequenceFlow_EnterNameLoopStart" name="" sourceRef="UserTask_SelectRealmRaceClass" targetRef="ExclusiveGateway_NameAvailable">
      <bpmn:name></bpmn:name>
    </sequenceFlow>

    <sequenceFlow id="SequenceFlow_CheckNameAvailability" sourceRef="ExclusiveGateway_NameAvailable" targetRef="Task_EnterNameOneByOne"></sequenceFlow>

    <sequenceFlow id="SequenceFlow_NameNotAvailableRetry" name="no - not available, try another" sourceRef="ExclusiveGateway_NameAvailable" targetRef="Task_EnterNameOneByOne">
      <bpmn:name></bpmn:name>
    </sequenceFlow>

    <sequenceFlow id="SequenceFlow_NameAvailableYes" name="yes - name is available" sourceRef="ExclusiveGateway_NameAvailable" targetRef="EndEvent_CharacterCreated"></sequenceFlow>

  </process>
</bpmn:definitions>