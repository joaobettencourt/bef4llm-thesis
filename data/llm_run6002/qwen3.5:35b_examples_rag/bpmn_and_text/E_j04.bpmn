<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_Internship_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_Internship">
    <bpmn:participant id="Participant_Internship" name="Internship Process" processRef="Process_Internship"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Internship" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Student" name="Intern (You)">
        <bpmn:flowNodeRef>StartEvent_Apply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InputDetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CatchMessage_OfferReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DecideOffer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Parallel_Gateway_InternshipStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WriteUpdate1_Student</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TimerEvent_Week1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WriteUpdate2_Student</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TimerEvent_Week2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WriteUpdate3_Student</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Parallel_Gateway_InternshipEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecommendCompany</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Company" name="Hosting Company">
        <bpmn:flowNodeRef>CatchMessage_OfferReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Parallel_Gateway_InternshipStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CompanyUpdate1_Student</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TimerEvent_CompWeek1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CompanyUpdate2_Student</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TimerEvent_CompWeek2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CompanyUpdate3_Student</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Apply" name="Apply for Internship">
      <bpmn:outgoing>SequenceFlow_InputDetails</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Input Details -->
    <bpmn:task id="Task_InputDetails" name="Enter Topic, Money, Experience &amp; Hobbies">
      <bpmn:incoming>SequenceFlow_InputDetails</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitOffer</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Catch Event for Offers -->
    <bpmn:intermediateCatchEvent id="CatchMessage_OfferReceived" name="Wait for Offer">
      <bpmn:incoming>SequenceFlow_WaitOffer</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DecideOffer</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Gateway: Accept or Deny -->
    <bpmn:exclusiveGateway id="Gateway_DecideOffer" name="Accept Offer?">
      <bpmn:incoming>SequenceFlow_DecideOffer</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AcceptInternship</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_DenyOfferLoop</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flows for Offer Decision -->
    <bpmn:sequenceFlow id="SequenceFlow_InputDetails" sourceRef="StartEvent_Apply" targetRef="Task_InputDetails"/>
    <bpmn:sequenceFlow id="SequenceFlow_WaitOffer" name="" sourceRef="Task_InputDetails" targetRef="CatchMessage_OfferReceived"/>
    <bpmn:sequenceFlow id="SequenceFlow_DecideOffer" name="" sourceRef="CatchMessage_OfferReceived" targetRef="Gateway_DecideOffer"/>

    <!-- Deny Loop -->
    <bpmn:sequenceFlow id="SequenceFlow_DenyOfferLoop" sourceRef="Gateway_DecideOffer" targetRef="CatchMessage_OfferReceived">
      <bpmn:name>Deny / Wait for Next</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Accept Path -->
    <bpmn:sequenceFlow id="SequenceFlow_AcceptInternship" sourceRef="Gateway_DecideOffer" targetRef="Parallel_Gateway_InternshipStart">
      <bpmn:name>Accept</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Parallel Gateway Start Internship Phase -->
    <bpmn:parallelGateway id="Parallel_Gateway_InternshipStart" name="">
      <bpmn:incoming>SequenceFlow_AcceptInternship</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StudentUpdatesLoop</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CompanyUpdatesLoop</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Student Update Loop (3 Updates) -->
    <bpmn:task id="Task_WriteUpdate1_Student" name="Write Status Update 1">
      <bpmn:incoming>SequenceFlow_StudentUpdatesLoop</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TimerWeek1</bpmn:outgoing>
    </bpmn:task>

    <!-- Timer Event (Weekly) -->
    <bpmn:intermediateCatchEvent id="TimerEvent_Week1" name="Wait 1 Week">
      <bpmn:incoming>SequenceFlow_TimerWeek1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WriteUpdate2Student</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:task id="Task_WriteUpdate2_Student" name="Write Status Update 2">
      <bpmn:incoming>SequenceFlow_TimerWeek1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TimerWeek2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:intermediateCatchEvent id="TimerEvent_Week2" name="Wait 1 Week">
      <bpmn:incoming>SequenceFlow_WriteUpdate2Student</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WriteUpdate3Student</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:task id="Task_WriteUpdate3_Student" name="Write Status Update 3">
      <bpmn:incoming>SequenceFlow_TimerWeek2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InternshipEndJoin</bpmn:outgoing>
    </bpmn:task>

    <!-- Company Update Loop (3 Updates) -->
    <bpmn:task id="Task_CompanyUpdate1_Student" name="Write Status About Student 1">
      <bpmn:incoming>SequenceFlow_CompanyUpdatesLoop</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CompTimerWeek1</bpmn:outgoing>
    </bpmn:task>

    <bpmn:intermediateCatchEvent id="TimerEvent_CompWeek1" name="Wait 1 Week">
      <bpmn:incoming>SequenceFlow_CompTimerWeek1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CompanyUpdate2Student</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:task id="Task_CompanyUpdate2_Student" name="Write Status About Student 2">
      <bpmn:incoming>SequenceFlow_CompTimerWeek1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CompTimerWeek2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:intermediateCatchEvent id="TimerEvent_CompWeek2" name="Wait 1 Week">
      <bpmn:incoming>SequenceFlow_CompanyUpdate2Student</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CompanyUpdate3Student</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:task id="Task_CompanyUpdate3_Student" name="Write Status About Student 3">
      <bpmn:incoming>SequenceFlow_CompTimerWeek2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InternshipEndJoin</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway End Internship Phase (Converging) -->
    <bpmn:parallelGateway id="Parallel_Gateway_InternshipEnd" name="">
      <bpmn:incoming>SequenceFlow_StudentUpdatesLoop</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_CompanyUpdatesLoop</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RecommendationStart</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Recommendation Task -->
    <bpmn:task id="Task_RecommendCompany" name="Recommend Company (Twitter)">
      <bpmn:incoming>SequenceFlow_InternshipEndJoin</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SplitTweets</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway for Tweets -->
    <bpmn:parallelGateway id="Parallel_Gateway_Tweets" name="">
      <bpmn:incoming>SequenceFlow_SplitTweets</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendTweet1</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SendTweet2</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Tweet Tasks -->
    <bpmn:task id="Task_SendTweet1" name="Send Tweet to Friend 1">
      <bpmn:incoming>SequenceFlow_SplitTweets</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndProcess</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_InternshipFinished" name="Internship Finished">
       <bpmn:incoming>SequenceFlow_SendTweet1</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>