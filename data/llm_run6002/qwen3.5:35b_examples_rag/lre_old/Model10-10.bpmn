<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_FaultDetectionProcess" targetNamespace="http://example.com/bpmn">
  <bpmn:collaboration id="Collaboration_0faultprocess">
    <bpmn:participant id="Participant_User" name="User Process" processRef="Process_FaultRepair"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_FaultRepair" isExecutable="false">
    <bpmn:startEvent id="StartEvent_0faultreport" name="Fault Report Received">
      <bpmn:outgoing>SequenceFlow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_ExamineFailure" name="Examine Failure">
      <bpmn:incoming>SequenceFlow_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_02</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="ExclusiveGateway_Decision" name="Confirm Failure?">
      <bpmn:incoming>SequenceFlow_02</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_03Reject</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_04Confirm</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="EndEvent_Reject" name="Failure Rejected">
      <bpmn:incoming>SequenceFlow_03Reject</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:task id="Task_InformCustomerConfirm" name="Inform Customer of Confirmation">
      <bpmn:incoming>SequenceFlow_04Confirm</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_05Manager</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_InformManagerConfirm" name="Inform Manager of Confirmation">
      <bpmn:incoming>SequenceFlow_05Manager</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_06FixFault</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_FixFault" name="Fix Fault at Measuring Device">
      <bpmn:incoming>SequenceFlow_06FixFault</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_07ShareResults</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_ShareResults" name="Share Results with Fault Detector">
      <bpmn:incoming>SequenceFlow_07ShareResults</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_08InformCustomerResolution</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_Completed" name="Repair Completed">
      <bpmn:incoming>SequenceFlow_10ManagerResolution</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow_01" sourceRef="StartEvent_0faultreport" targetRef="Task_ExamineFailure"/>

    <bpmn:exclusiveGateway id="ExclusiveGateway_DecisionPoint">
      <bpmn:incoming>SequenceFlow_02</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_03Reject</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_04Confirm</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="SequenceFlow_02" sourceRef="Task_ExamineFailure" targetRef="ExclusiveGateway_DecisionPoint"/>

    <bpmn:task id="Task_InformCustomerResolution" name="Inform Customer of Resolution">
      <bpmn:incoming>SequenceFlow_08InformCustomerResolution</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_09ManagerResolution</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_03Reject" sourceRef="ExclusiveGateway_DecisionPoint" targetRef="EndEvent_Reject"/>

    <bpmn:exclusiveGateway id="ExclusiveGateway_ConfirmPath">
      <bpmn:incoming>SequenceFlow_04Confirm</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_05Manager</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="SequenceFlow_04Confirm" sourceRef="ExclusiveGateway_DecisionPoint" targetRef="Task_InformCustomerConfirm"/>

    <bpmn:task id="Task_FaultDetectorNotification" name="Inform Fault Detector">
      <bpmn:incoming>SequenceFlow_12</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_07ShareResults</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_05Manager" sourceRef="Task_InformCustomerConfirm" targetRef="ExclusiveGateway_ConfirmPath"/>

    <bpmn:exclusiveGateway id="ExclusiveGateway_ManageNotifications">
      <bpmn:incoming>SequenceFlow_13</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_06FixFault</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="SequenceFlow_08InformCustomerResolution" sourceRef="Task_ShareResults" targetRef="Task_InformCustomerResolution"/>

    <bpmn:task id="Task_ManageNotification" name="Notify Manager of Resolution">
      <bpmn:incoming>SequenceFlow_14</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_09ManagerResolution</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_06FixFault" sourceRef="ExclusiveGateway_ManageNotifications" targetRef="Task_FixFault"/>

    <bpmn:exclusiveGateway id="ExclusiveGateway_FinalResolution">
      <bpmn:incoming>SequenceFlow_15</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_09ManagerResolution</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="SequenceFlow_07ShareResults" sourceRef="Task_FixFault" targetRef="ExclusiveGateway_FinalResolution"/>

    <bpmn:task id="Task_ManageNotification2" name="Inform Manager of Resolution">
      <bpmn:incoming>SequenceFlow_16</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_09ManagerResolution</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_09ManagerResolution" sourceRef="Task_ManageNotification2" targetRef="EndEvent_Completed"/>

  </bpmn:process>
</bpmn:definitions>