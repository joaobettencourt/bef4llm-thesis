<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_IPOProcess" targetNamespace="http://example.com/bpmn">
  <bpmn:collaboration id="Collaboration_1IPO">
    <bpmn:participant id="Participant_1IPO" name="Company Going Public Process" processRef="Process_1IPO"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1IPO" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_UnderwritingTeam" name="Underwriting Team">
        <bpmn:flowNodeRef>StartEvent_IPODecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectUnderwriters</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_FactsFair</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_PrepareIPO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegistrationPrep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CatchEvent_SECApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RoadShow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_JoinIPO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FixPrice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_CommitCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BuyOfferPublic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_IPODeclined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_IPOSuccessful</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_IPODecision" name="Company decides to go public">
      <bpmn:outgoing>SequenceFlow_SelectUnderwriters</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1 -->
    <bpmn:task id="Task_SelectUnderwriters" name="Select Underwriters">
      <bpmn:incoming>SequenceFlow_SelectUnderwriters</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FactsCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1 -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_FactsFair" name="Facts presented fairly?">
      <bpmn:incoming>SequenceFlow_FactsCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_IPODeclined</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PrepareIPOStart</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event 1 -->
    <bpmn:endEvent id="EndEvent_IPODeclined" name="Issue Declined">
      <bpmn:incoming>SequenceFlow_IPODeclined</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Parallel Gateway Split -->
    <bpmn:parallelGateway id="ParallelGateway_PrepareIPO" name="Preparation Phase">
      <bpmn:incoming>SequenceFlow_PrepareIPOStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RegistrationPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RoadShowPath</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Path 1 Task -->
    <bpmn:task id="Task_RegistrationPrep" name="Prepare Registration Statement &amp; Check Blue-Sky Laws">
      <bpmn:incoming>SequenceFlow_RegistrationPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitSEC</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Catch Event -->
    <bpmn:intermediateCatchEvent id="CatchEvent_SECApproval" name="Receive SEC Clearance">
      <bpmn:incoming>SequenceFlow_WaitSEC</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FixPriceStart1</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Path 2 Task -->
    <bpmn:task id="Task_RoadShow" name="Arrange Road Show &amp; Firm Up Price Prep">
      <bpmn:incoming>SequenceFlow_RoadShowPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FixPriceStart2</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway Join -->
    <bpmn:parallelGateway id="ParallelGateway_JoinIPO">
      <bpmn:incoming>SequenceFlow_FixPriceStart1</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_FixPriceStart2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FinalizeCommitment</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task Fix Price -->
    <bpmn:task id="Task_FixPrice" name="Fix Issue Price">
      <bpmn:incoming>SequenceFlow_FinalizeCommitment</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CommitCheckIn</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2 -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_CommitCheck" name="Reason not to proceed?">
      <bpmn:incoming>SequenceFlow_CommitCheckIn</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndIPODeclined2</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_BuyOfferPublicIn</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event 1 (Success) -->
    <bpmn:endEvent id="EndEvent_IPOSuccessful" name="IPO Completed">
      <bpmn:incoming>SequenceFlow_BuyOfferPublicOut</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task Final Action -->
    <bpmn:task id="Task_BuyOfferPublic" name="Enter Firm Commitment &amp; Offer Public">
      <bpmn:incoming>SequenceFlow_BuyOfferPublicIn</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BuyOfferPublicOut</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_SelectUnderwriters" sourceRef="StartEvent_IPODecision" targetRef="Task_SelectUnderwriters"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_FactsCheck" name="" sourceRef="Task_SelectUnderwriters" targetRef="ExclusiveGateway_FactsFair"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_IPODeclined" name="No" sourceRef="ExclusiveGateway_FactsFair" targetRef="EndEvent_IPODeclined"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_PrepareIPOStart" name="Yes" sourceRef="ExclusiveGateway_FactsFair" targetRef="ParallelGateway_PrepareIPO"/>

    <!-- Parallel Split Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_RegistrationPath" sourceRef="ParallelGateway_PrepareIPO" targetRef="Task_RegistrationPrep"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_RoadShowPath" sourceRef="ParallelGateway_PrepareIPO" targetRef="Task_RoadShow"/>

    <!-- Path 1 Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_WaitSEC" name="" sourceRef="Task_RegistrationPrep" targetRef="CatchEvent_SECApproval"/>

    <!-- Join Flows (Corrected) -->
    <bpmn:sequenceFlow id="SequenceFlow_FixPriceStart1" name="SEC Cleared" sourceRef="CatchEvent_SECApproval" targetRef="ParallelGateway_JoinIPO"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_FixPriceStart2" name="Road Show Done" sourceRef="Task_RoadShow" targetRef="ParallelGateway_JoinIPO"/>

    <!-- Post Join Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_FinalizeCommitment" sourceRef="ParallelGateway_JoinIPO" targetRef="Task_FixPrice"/>
    
    <!-- Decision Flows (Corrected) -->
    <bpmn:sequenceFlow id="SequenceFlow_CommitCheckIn" name="" sourceRef="Task_FixPrice" targetRef="ExclusiveGateway_CommitCheck"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_EndIPODeclined2" name="Yes, Reason Found" sourceRef="ExclusiveGateway_CommitCheck" targetRef="EndEvent_IPODeclined"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_BuyOfferPublicIn" name="No Reason Found" sourceRef="ExclusiveGateway_CommitCheck" targetRef="Task_BuyOfferPublic"/>

    <!-- Final Flow (Corrected) -->
    <bpmn:sequenceFlow id="SequenceFlow_BuyOfferPublicOut" sourceRef="Task_BuyOfferPublic" targetRef="EndEvent_IPOSuccessful"/>

  </bpmn:process>
</bpmn:definitions>