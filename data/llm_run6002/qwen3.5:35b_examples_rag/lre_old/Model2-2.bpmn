<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_SwitchOverProcess" targetNamespace="http://example.com/bpmn" xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/MODEL.xsd">
  <bpmn:collaboration id="Collaboration_0geryc1">
    <bpmn:participant id="Participant_CS" name="Customer Service" processRef="Process_CS"/>
    <bpmn:participant id="Participant_GridOp" name="Grid Operator" processRef="Process_GridOperator"/>
    <bpmn:participant id="Participant_OldSupplier" name="Old Supplier" processRef="Process_OldSupplier"/>
    <bpmn:participant id="Participant_Customer" name="Customer" processRef="Process_Customer"/>

    <!-- Message Flows -->
    <bpmn:messageFlow id="Message_ConfirmationRequest" sourceRef="Event_CS_SendConfirmation" targetRef="Event_Cust_ReceiveContractDetails"/>
    <bpmn:messageFlow id="Message_ConcurrenceCheck" sourceRef="Event_CS_RequestConcurrence" targetRef="Event_GridOp_ReceiveRequest"/>
    <bpmn:messageFlow id="Message_ConcurrenceResponse" sourceRef="Event_GridOp_SendOK" targetRef="Event_CSCatch_OK"/>
    <bpmn:messageFlow id="Message_MeterDataToCS" sourceRef="Event_GridOp_SendMeterData" targetRef="Event_CS_ReceiveMeterData"/>
    <bpmn:messageFlow id="Message_BillingInfoToSupplier" sourceRef="Event_GridOp_SendBillingInfo" targetRef="Event_OldSupp_ReceiveBillingInfo"/>
  </bpmn:collaboration>

  <!-- Customer Service Process -->
  <bpmn:process id="Process_CS" isExecutable="false">
    <bpmn:startEvent id="StartEvent_RequestReceived" name="Switch-over Request Received">
      <bpmn:outgoing>SequenceFlow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_CS_EnterData" name="Enter Customer Data into CRM">
      <bpmn:incoming>SequenceFlow_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_02</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_CS_CheckErrors" name="Data Errors?">
      <bpmn:incoming>SequenceFlow_02</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NoError</bpmn:outgoing> <!-- No errors -->
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_CS_CorrectErrors" name="Correct Errors">
      <bpmn:incoming>SequenceFlow_ErrorLoop</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_02</bpmn:outgoing> <!-- Loop back to check -->
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_01" sourceRef="StartEvent_RequestReceived" targetRef="Task_CS_EnterData"/>
    <bpmn:sequenceFlow id="SequenceFlow_ErrorLoop" name="Yes (Errors)" sourceRef="Gateway_CS_CheckErrors" targetRef="Task_CS_CorrectErrors">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[errorsFound]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

     <!-- Customer Existence Check -->
    <bpmn:exclusiveGateway id="Gateway_CS_CustomerExists" name="Customer Exists?">
      <bpmn:incoming>SequenceFlow_NoError</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NewCust</bpmn:outgoing> <!-- No -->
    </bpmn:exclusiveGateway>

     <bpmn:dataObject id="Data_CustomerObj" name="Customer Object"/>
    
    <bpmn:task id="Task_CS_CreateNewCust" name="Create New Customer Object">
      <bpmn:incoming>SequenceFlow_NewCust</bpmn:incoming>
       <!-- Data object reference simplified for XML validity -->
      <bpmn:dataInputRef>Data_CustomerObj</bpmn:dataInputRef> 
      <bpmn:outgoing>SequenceFlow_04</bpmn:outgoing>
    </bpmn:task>

     <bpmn:sequenceFlow id="SequenceFlow_NewCust" name="No (New Customer)" sourceRef="Gateway_CS_CustomerExists" targetRef="Task_CS_CreateNewCust"/>
    
    <!-- Contract Preparation -->
    <bpmn:exclusiveGateway id="Gateway_ContractMerge">
      <bpmn:incoming>SequenceFlow_04</bpmn:outgoing/> 
       Wait, I need to fix the flow logic for valid XML. Let's assume existing customer path merges here implicitly or via task. For simplicity in XML structure without layouting complexity on data objects merging logic:
    </bpmn:exclusiveGateway>

     <bpmn:startEvent id="StartExistingCust" name="" /> <!-- Placeholder to merge flow -->
     
     Let's restructure for valid XML without complex data object merging logic which might break simple parsing if not careful with IDs. I will assume the "Customer Exists" check leads to Prepare Contract regardless of creation, just creating a new one is an internal step.

    <bpmn:task id="Task_CS_PrepareContract" name="Prepare Contract