<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_BicycleManufacturing" targetNamespace="http://example.com/bpmn">
  <bpmn:collaboration id="Collaboration_0a8f3c9d">
    <bpmn:participant id="Participant_Company" name="Bicycle Manufacturing Company" processRef="Process_BicycleManufacturing"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_BicycleManufacturing" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_SalesDepartment" name="Sales Department">
        <bpmn:flowNodeRef>StartEvent_01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AcceptRejectOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ShipToCustomer</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Storehouse" name="Storehouse">
        <bpmn:flowNodeRef>InclusiveGateway_CheckParts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProcessPartList</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Engineering" name="Engineering Department">
        <bpmn:flowNodeRef>InclusiveGateway_CheckParts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareAssembly</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_01" name="Order Received">
      <bpmn:outgoing>SequenceFlow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Accept/Reject Decision Gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_AcceptReject" name="Accept Order?">
      <bpmn:incoming>SequenceFlow_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Reject</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_Accept</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Reject Path -->
    <bpmn:endEvent id="EndEvent_Rejected" name="Order Rejected">
      <bpmn:incoming>SequenceFlow_Reject</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Accept Path - Parallel Split to Storehouse and Engineering -->
    <bpmn:parallelGateway id="ParallelGateway_Split" name="Inform Departments">
      <bpmn:incoming>SequenceFlow_Accept</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Storehouse</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_Engineering</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Storehouse Task -->
    <bpmn:task id="Task_ProcessPartList" name="Process Part List">
      <bpmn:incoming>SequenceFlow_Storehouse</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckParts</bpmn:outgoing>
    </bpmn:task>

    <!-- Engineering Task -->
    <bpmn:task id="Task_PrepareAssembly" name="Prepare Assembly">
      <bpmn:incoming>SequenceFlow_Engineering</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AssemblyReady</bpmn:outgoing>
    </bpmn:task>

    <!-- Part Availability Check Gateway -->
    <bpmn:inclusiveGateway id="InclusiveGateway_CheckParts" name="Check Parts">
      <bpmn:incoming>SequenceFlow_CheckParts</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReservePart</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_BackOrder</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Reserve Path -->
    <bpmn:task id="Task_Reserve" name="Reserve Part">
      <bpmn:incoming>SequenceFlow_ReservePart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PartReserved</bpmn:outgoing>
    </bpmn:task>

    <!-- Back-order Path -->
    <bpmn:task id="Task_BackOrder" name="Back-Order Part">
      <bpmn:incoming>SequenceFlow_BackOrder</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PartReserved</bpmn:outgoing>
    </bpmn:task>

    <!-- Synchronization Gateway before Assembly -->
    <bpmn:parallelGateway id="ParallelGateway_Sync" name="Synchronize">
      <bpmn:incoming>SequenceFlow_PartReserved</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_AssemblyReady</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Assemble</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Assembly Task -->
    <bpmn:task id="Task_Assemble" name="Assemble Bicycle">
      <bpmn:incoming>SequenceFlow_Assemble</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ShipReady</bpmn:outgoing>
    </bpmn:task>

    <!-- Ship to Customer -->
    <bpmn:endEvent id="EndEvent_Completed" name="Order Completed">
      <bpmn:incoming>SequenceFlow_ShipToCustomer</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Accept/Reject Task (Sales Department) -->
    <bpmn:task id="Task_AcceptRejectOrder" name="Accept or Reject Order">
      <bpmn:incoming>SequenceFlow_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Reject</bpmn:outgoing>
    </bpmn:task>

    <!-- Ship to Customer Task (Sales Department) -->
    <bpmn:task id="Task_ShipToCustomer" name="Ship Bicycle">
      <bpmn:incoming>SequenceFlow_Assemble</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ShipToCustomer</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_01" sourceRef="StartEvent_01" targetRef="Task_AcceptRejectOrder"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_Reject" name="No - Reject Order" sourceRef="ExclusiveGateway_AcceptReject" targetRef="EndEvent_Rejected">
      <bpmn:name>no</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_Accept" name="Yes - Accept Order" sourceRef="ExclusiveGateway_AcceptReject" targetRef="ParallelGateway_Split">
      <bpmn:name>yes</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_Storehouse" name="Inform Storehouse" sourceRef="ParallelGateway_Split" targetRef="Task_ProcessPartList"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_Engineering" name="Inform Engineering" sourceRef="ParallelGateway_Split" targetRef="Task_PrepareAssembly"/>

    <bpmn:sequenceFlow id="SequenceFlow_CheckParts" sourceRef="Task_ProcessPartList" targetRef="InclusiveGateway_CheckParts"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ReservePart" name="Available - Reserve" sourceRef="InclusiveGateway_CheckParts" targetRef="Task_Reserve">
      <bpmn:name>available</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_BackOrder" name="Not Available - Back-order" sourceRef="InclusiveGateway_CheckParts" targetRef="Task_BackOrder">
      <bpmn:name>not available</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_PartReserved" name="Part Processed" sourceRef="Task_Reserve" targetRef="ParallelGateway_Sync"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_AssemblyReady" name="Preparation Complete" sourceRef="Task_PrepareAssembly" targetRef="ParallelGateway_Sync"/>

    <bpmn:sequenceFlow id="SequenceFlow_Assemble" name="Both Ready - Assemble" sourceRef="ParallelGateway_Sync" targetRef="Task_Assemble">
      <bpmn:name>all parts reserved</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ShipReady" name="Assembly Complete" sourceRef="Task_Assemble" targetRef="Task_ShipToCustomer"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ShipToCustomer" name="Ship to Customer" sourceRef="Task_ShipToCustomer" targetRef="EndEvent_Completed">
      <bpmn:name>ship</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>