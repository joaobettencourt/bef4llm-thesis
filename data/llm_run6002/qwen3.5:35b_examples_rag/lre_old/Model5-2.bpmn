<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_VacationRequest" targetNamespace="http://example.com/bpmn">
  <bpmn:collaboration id="Collaboration_VacationProcess">
    <bpmn:participant id="Participant_Organization" name="Vacations Request Process" processRef="Pool_0"/>
  </bpmn:collaboration>

  <bpmn:process id="Pool_0" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Employee" name="Employee">
        <bpmn:flowNodeRef>StartEvent_SubmitRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegisterRequirement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ReviewRejection</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Supervisor" name="Supervisor">
        <bpmn:flowNodeRef>Task_ApproveRejectRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DecisionApproval</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_HR" name="HR Representative">
        <bpmn:flowNodeRef>Task_CompleteManagementProcedures</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_SubmitRequest" name="Submit Vacation Request">
      <bpmn:outgoing>SequenceFlow_001</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_RegisterRequirement" name="Register Requirement">
      <bpmn:incoming>SequenceFlow_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_002</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_DecisionApproval">
      <bpmn:incoming>SequenceFlow_003</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_004</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_005</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_ApproveRejectRequest" name="Approve/Reject Request">
      <bpmn:incoming>SequenceFlow_002</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_003</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_Rejected" name="Request Rejected">
      <bpmn:incoming>SequenceFlow_006</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_Completed" name="Vacation Process Completed">
      <bpmn:incoming>SequenceFlow_007</bpmn:outgoing>
    </bpmn:endEvent>

    <bpmn:task id="Task_CompleteManagementProcedures" name="Complete Management Procedures">
      <bpmn:incoming>SequenceFlow_005</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_007</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_001" sourceRef="StartEvent_SubmitRequest" targetRef="Task_RegisterRequirement"/>
    <bpmn:sequenceFlow id="SequenceFlow_002" sourceRef="Task_RegisterRequirement" targetRef="Gateway_DecisionApproval"/>
    <bpmn:sequenceFlow id="SequenceFlow_003" sourceRef="Task_ApproveRejectRequest" targetRef="Gateway_DecisionApproval"/>
    <bpmn:sequenceFlow id="SequenceFlow_004" name="Rejected" sourceRef="Gateway_DecisionApproval" targetRef="EndEvent_Rejected"/>
    <bpmn:sequenceFlow id="SequenceFlow_005" name="Approved" sourceRef="Gateway_DecisionApproval" targetRef="Task_CompleteManagementProcedures"/>
    <bpmn:sequenceFlow id="SequenceFlow_006" sourceRef="EndEvent_Rejected" targetRef="StartEvent_SubmitRequest"/>
    <bpmn:sequenceFlow id="SequenceFlow_007" sourceRef="Task_CompleteManagementProcedures" targetRef="EndEvent_Completed"/>

  </bpmn:process>
</bpmn:definitions>