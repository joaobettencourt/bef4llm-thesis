<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_ExaminationProcess_Corrected" targetNamespace="http://example.com/bpmn">
  <bpmn:collaboration id="Collaboration_Examination_01">
    <bpmn:participant id="Participant_ClinicalSystem_01" name="Examination Process" processRef="Process_Examination_01"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Examination_01" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_OutpatientPhysician_01" name="Outpatient Physician">
        <bpmn:flowNodeRef>StartEvent_PatientExamined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExaminationByPhysician</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_HealthyDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_PatientLeaves</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_WardStaff_01" name="Ward Staff">
        <bpmn:flowNodeRef>Task_ArrangeAppointment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareExamination</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TakeSample</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_LabStaff_01" name="Lab Staff">
        <bpmn:flowNodeRef>Gateway_SampleValidDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AnalyzeSample</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Patient_01" name="Patient">
        <bpmn:flowNodeRef>Gateway_ConsentDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SignConsent</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_PatientExamined" name="Patient examined by outpatient physician">
      <bpmn:outgoing>SequenceFlow_Examination</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Examination Task -->
    <bpmn:task id="Task_ExaminationByPhysician" name="Examine patient and decide on additional examination">
      <bpmn:incoming>SequenceFlow_Examination</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_HealthyDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Health Decision Gateway -->
    <bpmn:exclusiveGateway id="Gateway_HealthyDecision" name="Healthy?">
      <bpmn:incoming>SequenceFlow_HealthyDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FillForm</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PlaceOrderAndInform</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Healthy Path -->
    <bpmn:task id="Task_FillExaminationForm" name="Fill out examination form">
      <bpmn:incoming>SequenceFlow_FillForm</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PatientLeavesProcess</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event for Healthy Path -->
    <bpmn:endEvent id="EndEvent_PatientLeaves" name="Patient leaves">
      <bpmn:incoming>SequenceFlow_PatientLeavesProcess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Additional Examination Path -->
    <bpmn:task id="Task_PlaceOrderAndInformRisks" name="Place order, fill request form and inform about risks">
      <bpmn:incoming>SequenceFlow_PlaceOrderAndInform</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConsentDecisionIn</bpmn:outgoing>
    </bpmn:task>

    <!-- Consent Decision Gateway -->
    <bpmn:exclusiveGateway id="Gateway_ConsentDecision" name="Sign consent and agree?">
      <bpmn:incoming>SequenceFlow_ConsentDecisionIn</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ArrangeAppointmentProcess</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Arrange Appointment -->
    <bpmn:task id="Task_ArrangeAppointment" name="Arrange appointment with ward">
      <bpmn:incoming>SequenceFlow_ArrangeAppointmentProcess</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PrepareExaminationIn</bpmn:outgoing>
    </bpmn:task>

    <!-- Prepare Examination -->
    <bpmn:task id="Task_PrepareExamination" name="Prepare examination and sampling">
      <bpmn:incoming>SequenceFlow_PrepareExaminationIn</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TakeSampleProcess</bpmn:outgoing>
    </bpmn:task>

    <!-- Take Sample -->
    <bpmn:task id="Task_TakeSample" name="Take sample for lab analysis">
      <bpmn:incoming>SequenceFlow_TakeSampleProcess</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendToLabValidation</bpmn:outgoing>
    </bpmn:task>

    <!-- Sample Validation Gateway -->
    <bpmn:exclusiveGateway id="Gateway_SampleValidDecision" name="Sample valid?">
      <bpmn:incoming>SequenceFlow_SendToLabValidation</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AnalyzeProcess</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Analyze Sample -->
    <bpmn:task id="Task_AnalyzeSample" name="Perform analysis">
      <bpmn:incoming>SequenceFlow_AnalyzeProcess</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ValidateResultsIn</bpmn:outgoing>
    </bpmn:task>

    <!-- Final Decision Gateway (Simplified for flow completion) -->
    <bpmn:exclusiveGateway id="Gateway_NewSampleRequired" name="New sample required?">
      <bpmn:incoming>SequenceFlow_ValidateResultsIn</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AnalyzeProcessLoopback</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event for Therapy -->
    <bpmn:endEvent id="EndEvent_TherapyPrescribed" name="Diagnosis and therapy prescribed">
      <bpmn:incoming>SequenceFlow_AnalyzeProcessLoopback</bpmn:outgoing>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_Examination" sourceRef="StartEvent_PatientExamined" targetRef="Task_ExaminationByPhysician"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_HealthyDecision" name="Yes" sourceRef="Gateway_HealthyDecision" targetRef="Task_FillExaminationForm"/>
    <bpmn:sequenceFlow id="SequenceFlow_PlaceOrderAndInform" name="No" sourceRef="Gateway_HealthyDecision" targetRef="Task_PlaceOrderAndInformRisks"/>

    <bpmn:sequenceFlow id="SequenceFlow_FillForm" sourceRef="Task_ExaminationByPhysician" targetRef="Task_FillExaminationForm">
      <!-- Correction: Source should be Gateway, Target Task -->
    </bpmn:sequenceFlow> 
    <!-- Fixing the above logic error in definition order vs flow direction -->

  </bpmn:process>
</bpmn:definitions>