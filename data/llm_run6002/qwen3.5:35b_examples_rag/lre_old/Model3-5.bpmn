<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_MailProcessingProcess" targetNamespace="http://example.com/bpmn">
  <bpmn:collaboration id="Collaboration_0a8x9k3">
    <bpmn:participant id="Participant_MainProcess" name="Mail Processing Unit & Registry Process" processRef="Process_MailProcessing"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_MailProcessing" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_01MailClerk" name="Mail Clerk">
        <bpmn:flowNodeRef>StartEvent_DailyCollection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SortUnopenedMail</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_02Registry" name="Registry">
        <bpmn:flowNodeRef>Task_OpenAndSortMail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegisterIncomingMail</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_03AssistantRegistry" name="Assistant Registry Manager">
        <bpmn:flowNodeRef>Gateway_QualityCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PerformQualityCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CompileRejectionList</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CaptureMatterDetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareEnvelopeAndPost</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_04Cashier" name="Cashier">
        <bpmn:flowNodeRef>ParallelGateway_ConcurrentSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CollectFees</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CapturePartyDetailsAndPrintFile</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_DailyCollection" name="Daily Mail Collection">
      <bpmn:outgoing>SequenceFlow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Sort Unopened Mail -->
    <bpmn:task id="Task_SortUnopenedMail" name="Sort unopened mail into business areas">
      <bpmn:incoming>SequenceFlow_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_02</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Open and Sort Mail -->
    <bpmn:task id="Task_OpenAndSortMail" name="Open mail and sort into groups">
      <bpmn:incoming>SequenceFlow_02</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_03</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Register Incoming Mail -->
    <bpmn:task id="Task_RegisterIncomingMail" name="Register in manual incoming mail register">
      <bpmn:incoming>SequenceFlow_02</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_03</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway for Quality Check Decision -->
    <bpmn:exclusiveGateway id="Gateway_QualityCheck">
      <bpmn:incoming>SequenceFlow_03</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_04</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_05</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Perform Quality Check -->
    <bpmn:task id="Task_PerformQualityCheck" name="Perform quality check">
      <bpmn:incoming>SequenceFlow_03</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_04</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow for Non-Compliant Mail -->
    <bpmn:sequenceFlow id="SequenceFlow_05" name="Not Compliant" sourceRef="Gateway_QualityCheck" targetRef="Task_CompileRejectionList"/>

    <!-- Task: Compile Rejection List -->
    <bpmn:task id="Task_CompileRejectionList" name="Compile list of requisitions explaining rejection">
      <bpmn:incoming>SequenceFlow_05</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_16</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow for Compliant Mail -->
    <bpmn:sequenceFlow id="SequenceFlow_04" name="Compliant" sourceRef="Gateway_QualityCheck" targetRef="Task_CaptureMatterDetails"/>

    <!-- Task: Capture Matter Details -->
    <bpmn:task id="Task_CaptureMatterDetails" name="Capture matter details (types of action)">
      <bpmn:incoming>SequenceFlow_04</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_07</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway for Concurrent Processing -->
    <bpmn:parallelGateway id="ParallelGateway_ConcurrentSplit">
      <bpmn:incoming>SequenceFlow_07</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_08</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_12</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Sequence Flow to Cashier Tasks -->
    <bpmn:sequenceFlow id="SequenceFlow_07" sourceRef="Task_CaptureMatterDetails" targetRef="ParallelGateway_ConcurrentSplit"/>

    <!-- Task: Collect Fees (Cashier) -->
    <bpmn:task id="Task_CollectFees" name="Take applicable fees attached to mail">
      <bpmn:incoming>SequenceFlow_08</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_13</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow from Parallel Gateway -->
    <bpmn:sequenceFlow id="SequenceFlow_08" sourceRef="ParallelGateway_ConcurrentSplit" targetRef="Task_CollectFees"/>

    <!-- Task: Capture Party Details and Print Physical Court File (Cashier) - Concurrent Path -->
    <bpmn:task id="Task_CapturePartyDetailsAndPrintFile" name="Capture party details and print physical court file">
      <bpmn:incoming>SequenceFlow_12</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_09</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow for Concurrent Path -->
    <bpmn:sequenceFlow id="SequenceFlow_12" sourceRef="ParallelGateway_ConcurrentSplit" targetRef="Task_CapturePartyDetailsAndPrintFile"/>

    <!-- Task: Prepare Envelope and Post (Assistant Registry Manager) - After Fees Collected -->
    <bpmn:task id="Task_PrepareEnvelopeAndPost" name="Put receipt and copied documents in envelope, post to party">
      <bpmn:incoming>SequenceFlow_13</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_09</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow from Fees Collection -->
    <bpmn:sequenceFlow id="SequenceFlow_13" sourceRef="Task_CollectFees" targetRef="Task_PrepareEnvelopeAndPost"/>

    <!-- Merge Gateway for Parallel Paths -->
    <bpmn:parallelGateway id="ParallelGateway_Merge">
      <bpmn:incoming>SequenceFlow_09</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_14</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Sequence Flow to Merge -->
    <bpmn:sequenceFlow id="SequenceFlow_09" sourceRef="Task_PrepareEnvelopeAndPost" targetRef="ParallelGateway_Merge"/>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Completed" name="Mail Processed and Posted">
      <bpmn:incoming>SequenceFlow_14</bpmn:outgoing>
    </bpmn:endEvent>

    <!-- Sequence Flow to Merge from Parallel Gateway -->
    <bpmn:sequenceFlow id="SequenceFlow_16" sourceRef="Task_CompileRejectionList" targetRef="EndEvent_Rejected"/>

    <!-- End Event for Rejected Mail -->
    <bpmn:endEvent id="EndEvent_Rejected" name="Mail Rejected">
      <bpmn:incoming>SequenceFlow_16</bpmn:outgoing>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>