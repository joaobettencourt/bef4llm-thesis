<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_VacancyProcess" targetNamespace="http://example.com/bpmn">
  <bpmn:collaboration id="Collaboration_VacancyApproval">
    <bpmn:participant id="Participant_RecruitmentTeam" name="Personnel Department" processRef="Process_VacancyManagement"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_VacancyManagement" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_RecruitmentTeam" name="Personnel Department">
        <bpmn:flowNodeRef>StartEvent_PersonnelRequirements</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReportVacancy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateCatchEvent_JobDescriptionReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_QuestionsRequired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProvideClarifications</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ApproveAndAdvertise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_VacancyAdvertised</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_PersonnelRequirements" name="Personnel Requirements Detected">
      <bpmn:outgoing>SequenceFlow_001</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Report Vacancy Task -->
    <bpmn:task id="Task_ReportVacancy" name="Report Vacancy to Personnel Department">
      <bpmn:incoming>SequenceFlow_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_002</bpmn:outgoing>
    </bpmn:task>

    <!-- Wait for Job Description Review Requested (Intermediate Catch Event) -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_JobDescriptionReceived" name="Job Description Received">
      <bpmn:incoming>SequenceFlow_002</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_003</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Exclusive Gateway for Questions/Corrections Decision -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_QuestionsRequired">
      <bpmn:incoming>SequenceFlow_003</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_004</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_005</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task for Providing Clarifications (if questions exist) -->
    <bpmn:task id="Task_ProvideClarifications" name="Provide Clarifications">
      <bpmn:incoming>SequenceFlow_004</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_006</bpmn:outgoing>
    </bpmn:task>

    <!-- Task for Approving Job Description and Advertising (if no questions/corrections needed) -->
    <bpmn:task id="Task_ApproveAndAdvertise" name="Approve &amp; Advertise">
      <bpmn:incoming>SequenceFlow_005</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_007</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_VacancyAdvertised" name="Vacancy Advertised">
      <bpmn:incoming>SequenceFlow_007</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_001" sourceRef="StartEvent_PersonnelRequirements" targetRef="Task_ReportVacancy"/>
    <bpmn:sequenceFlow id="SequenceFlow_002" name="Report Vacancy" sourceRef="Task_ReportVacancy" targetRef="IntermediateCatchEvent_JobDescriptionReceived"/>
    <bpmn:sequenceFlow id="SequenceFlow_003" sourceRef="IntermediateCatchEvent_JobDescriptionReceived" targetRef="ExclusiveGateway_QuestionsRequired"/>
    <bpmn:sequenceFlow id="SequenceFlow_004" name="Questions Required" sourceRef="ExclusiveGateway_QuestionsRequired" targetRef="Task_ProvideClarifications"/>
    <bpmn:sequenceFlow id="SequenceFlow_005" name="No Questions" sourceRef="ExclusiveGateway_QuestionsRequired" targetRef="Task_ApproveAndAdvertise"/>
    <bpmn:sequenceFlow id="SequenceFlow_006" sourceRef="Task_ProvideClarifications" targetRef="ExclusiveGateway_QuestionsRequired"/>
    <bpmn:sequenceFlow id="SequenceFlow_007" sourceRef="Task_ApproveAndAdvertise" targetRef="EndEvent_VacancyAdvertised"/>

  </bpmn:process>
</bpmn:definitions>