<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_ClaimProcess" targetNamespace="http://example.com/bpmn">
  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="Pool_ClaimsHandling" name="Claims Handling Process" processRef="Proc_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Proc_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_ClaimsOfficer" name="Claims Officer">
        <bpmn:flowNodeRef>StartEvent_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExamineClaim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WriteRecommendation</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SeniorOfficer" name="Senior Claims Officer">
        <bpmn:flowNodeRef>Task_CheckRecommendation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DecisionOKNotOK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ProceedHandling</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_0" name="Claim Registered">
      <bpmn:outgoing>SequenceFlow_StartToExamine</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Examine Claim (Claims Officer) -->
    <bpmn:task id="Task_ExamineClaim" name="Examine Claim">
      <bpmn:incoming>SequenceFlow_StartToExamine</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ExamineToWrite</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: Write Recommendation (Claims Officer) -->
    <bpmn:task id="Task_WriteRecommendation" name="Write Settlement Recommendation">
      <bpmn:incoming>SequenceFlow_ExamineToWrite</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_NotOKtoRepeat</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WriteToCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3: Check Recommendation (Senior Claims Officer) -->
    <bpmn:task id="Task_CheckRecommendation" name="Check Recommendation">
      <bpmn:incoming>SequenceFlow_WriteToCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckToDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Decision OK or Not OK -->
    <bpmn:exclusiveGateway id="Gateway_DecisionOKNotOK" name="Recommendation OK?">
      <bpmn:incoming>SequenceFlow_CheckToDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NotOKtoRepeat</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_OKToEnd</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_ProceedHandling" name="Proceed with Handling">
      <bpmn:incoming>SequenceFlow_OKToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToExamine" sourceRef="StartEvent_0" targetRef="Task_ExamineClaim"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ExamineToWrite" name="After examination" sourceRef="Task_ExamineClaim" targetRef="Task_WriteRecommendation"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_WriteToCheck" sourceRef="Task_WriteRecommendation" targetRef="Task_CheckRecommendation"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_CheckToDecision" name="After check" sourceRef="Task_CheckRecommendation" targetRef="Gateway_DecisionOKNotOK"/>
    
    <!-- Loop Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_NotOKtoRepeat" name="Not OK - Repeat Recommendation" sourceRef="Gateway_DecisionOKNotOK" targetRef="Task_WriteRecommendation"/>
    
    <!-- End Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_OKToEnd" name="OK" sourceRef="Gateway_DecisionOKNotOK" targetRef="EndEvent_ProceedHandling"/>

  </bpmn:process>
</bpmn:definitions>