<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_HiringProcess" targetNamespace="http://example.com/bpmn">
  <bpmn:collaboration id="Collaboration_Recruitment">
    <bpmn:participant id="Participant_CandidateManager" name="Candidate Manager Process" processRef="Process_JobPosting"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_JobPosting" isExecutable="false">
    <bpmn:startEvent id="Start_VacancyReported" name="Vacancy reported">
      <bpmn:outgoing>SequenceFlow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_CreateJobDescription" name="Create job description">
      <bpmn:incoming>SequenceFlow_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_02</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_ConfusionCheck" name="Confusion in message?">
      <bpmn:incoming>SequenceFlow_02</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_03</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:intermediateCatchEvent id="Intermediate_WaitClarification" name="Wait for clarification">
      <bpmn:incoming>SequenceFlow_03</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_04</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:task id="Task_CommunicateWithDepartment" name="Ask Department for clarification">
      <bpmn:incoming>SequenceFlow_04</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_16</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_02" sourceRef="Task_CreateJobDescription" targetRef="Gateway_ConfusionCheck"/>
    <bpmn:sequenceFlow id="SequenceFlow_03" name="Yes - confusion exists" sourceRef="Gateway_ConfusionCheck" targetRef="Intermediate_WaitClarification"/>

    <!-- Submit for approval path -->
    <bpmn:task id="Task_SubmitForApproval" name="Submit job description">
      <bpmn:incoming>SequenceFlow_15</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_06</bpmn:outgoing>
    </bpmn:task>

    <!-- Wait for approval decision -->
    <bpmn:intermediateCatchEvent id="Intermediate_WaitApprovalDecision" name="Wait for approval">
      <bpmn:incoming>SequenceFlow_06</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_17</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Decision on approval -->
    <bpmn:exclusiveGateway id="Gateway_ApprovalDecision" name="Approved?">
      <bpmn:incoming>SequenceFlow_06</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Rejection path -->
    <bpmn:task id="Task_CorrectDescription" name="Correct job description">
      <bpmn:incoming>SequenceFlow_07</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_19</bpmn:outgoing>
    </bpmn:task>

    <!-- Post approved job -->
    <bpmn:task id="Task_PostJob" name="Post the job">
      <bpmn:incoming>SequenceFlow_08</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_14</bpmn:outgoing>
    </bpmn:task>

    <!-- End event -->
    <bpmn:endEvent id="End_JobPosted" name="Job posted">
      <bpmn:incoming>SequenceFlow_14</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence flows for confusion path (Yes branch) -->
    <bpmn:sequenceFlow id="SequenceFlow_07" name="Rejected - needs correction" sourceRef="Gateway_ApprovalDecision" targetRef="Task_CorrectDescription"/>
    
    <!-- Loop back from correction to submit again -->
    <bpmn:exclusiveGateway id="Gateway_SubmitAgainCheck">
      <bpmn:incoming>SequenceFlow_19</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_06</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence flows for approval path (No branch - no confusion) -->
    <bpmn:sequenceFlow id="SequenceFlow_15" name="No confusion" sourceRef="Gateway_ConfusionCheck" targetRef="Task_SubmitForApproval"/>
    
    <!-- From clarification back to submit again -->
    <bpmn:exclusiveGateway id="Gateway_AfterClarification">
      <bpmn:incoming>SequenceFlow_16</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_02</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- From approval waiting to decision -->
    <bpmn:sequenceFlow id="SequenceFlow_17" sourceRef="Intermediate_WaitApprovalDecision" targetRef="Gateway_ApprovalDecision"/>
    
    <!-- Approved path -->
    <bpmn:sequenceFlow id="SequenceFlow_08" name="Approved" sourceRef="Gateway_ApprovalDecision" targetRef="Task_PostJob"/>

  </bpmn:process>
</bpmn:definitions>