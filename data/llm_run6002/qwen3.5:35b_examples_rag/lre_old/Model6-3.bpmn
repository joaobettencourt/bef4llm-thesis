<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_NewOrderProcess" targetNamespace="http://example.com/bpmn">
  <bpmn:collaboration id="Collab_001">
    <bpmn:participant id="Participant_Production" name="Production Process" processRef="Process_NewOrder"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_NewOrder" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_PlanningTeam" name="Planning Team">
        <bpmn:flowNodeRef>UserTask_DetermineParts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_EnterDataPPS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_PPSOptimization</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_ManualTransferToERP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DecisionProcurement</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ProductionStaff" name="Production Staff">
        <bpmn:flowNodeRef>UserTask_ProcureMissingParts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CatchEvent_ScheduledNotice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_ImplementProduction</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_CheckQuality</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_NewOrder" name="New Order from Sales">
      <bpmn:outgoing>SequenceFlow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="UserTask_DetermineParts" name="Determine parts, quantities and delivery date">
      <bpmn:incoming>SequenceFlow_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_02</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="UserTask_EnterDataPPS" name="Enter data into Production Planning System (PPS)">
      <bpmn:incoming>SequenceFlow_02</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_03</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="ServiceTask_PPSOptimization" name="PPS Optimizes processes &amp; creates parts list">
      <bpmn:incoming>SequenceFlow_03</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_04</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="UserTask_ManualTransferToERP" name="Manually transfer data from PPS to ERP">
      <bpmn:incoming>SequenceFlow_04</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_05</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="UserTask_CheckPartsAvailability" name="Check if parts are missing">
      <bpmn:incoming>SequenceFlow_05</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_06</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_DecisionProcurement" name="Parts missing?">
      <bpmn:incoming>SequenceFlow_06</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_07</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="UserTask_ProcureMissingParts" name="Procure missing parts">
      <bpmn:incoming>SequenceFlow_07</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_13</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:intermediateCatchEvent id="CatchEvent_ScheduledNotice" name="Receive system notice">
      <bpmn:incoming>SequenceFlow_08</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_14</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:userTask id="UserTask_ImplementProduction" name="Employee takes care of implementation">
      <bpmn:incoming>SequenceFlow_08</bpmn:incoming> <!-- Merged flow from Catch Event -->
      <bpmn:outgoing>SequenceFlow_15</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="UserTask_CheckQuality" name="Check order for quality">
      <bpmn:incoming>SequenceFlow_09</bpmn:incoming> <!-- Merged flow from Catch Event -->
      <bpmn:outgoing>SequenceFlow_16</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndEvent_OrderCompleted" name="Order Completed">
      <bpmn:incoming>SequenceFlow_10</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_01" sourceRef="StartEvent_NewOrder" targetRef="UserTask_DetermineParts"/>
    <bpmn:sequenceFlow id="SequenceFlow_02" sourceRef="UserTask_DetermineParts" targetRef="UserTask_EnterDataPPS"/>
    <bpmn:sequenceFlow id="SequenceFlow_03" sourceRef="UserTask_EnterDataPPS" targetRef="ServiceTask_PPSOptimization"/>
    <bpmn:sequenceFlow id="SequenceFlow_04" sourceRef="ServiceTask_PPSOptimization" targetRef="UserTask_ManualTransferToERP"/>
    <bpmn:sequenceFlow id="SequenceFlow_05" sourceRef="UserTask_ManualTransferToERP" targetRef="UserTask_CheckPartsAvailability"/>
    <bpmn:sequenceFlow id="SequenceFlow_06" name="Check parts list" sourceRef="UserTask_CheckPartsAvailability" targetRef="Gateway_DecisionProcurement"/>
    
    <!-- Decision Paths -->
    <bpmn:sequenceFlow id="SequenceFlow_07" name="Yes, must procure" sourceRef="Gateway_DecisionProcurement" targetRef="UserTask_ProcureMissingParts"/>
    <bpmn:sequenceFlow id="SequenceFlow_12" name="No parts missing" sourceRef="Gateway_DecisionProcurement" targetRef="CatchEvent_ScheduledNotice"/>

    <!-- Convergence Paths -->
    <bpmn:sequenceFlow id="SequenceFlow_08" name="After Procure or No Action" sourceRef="UserTask_ProcureMissingParts" targetRef="CatchEvent_ScheduledNotice"/>
    
    <!-- Post-Procurement/Decision Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_14" sourceRef="CatchEvent_ScheduledNotice" targetRef="UserTask_ImplementProduction"/>

    <!-- Quality Check Path (Assuming Implementation leads to Order Ready for check) -->
    <bpmn:sequenceFlow id="SequenceFlow_09" name="After Implementation" sourceRef="UserTask_ImplementProduction" targetRef="UserTask_CheckQuality"/>
    
    <!-- Final Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_16" sourceRef="UserTask_CheckQuality" targetRef="EndEvent_OrderCompleted"/>

  </bpmn:process>
</bpmn:definitions>