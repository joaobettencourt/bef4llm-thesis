<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_SupplierOrdering" targetNamespace="http://example.com/bpmn">
  <bpmn:message id="Message_OrderRequest" name="Order Request"/>
  <bpmn:message id="Message_Invoice" name="Invoice"/>

  <bpmn:collaboration id="Collaboration_SupplierOrdering">
    <bpmn:participant id="Participant_AssemblerAG" name="Assembler AG" processRef="Process_Assembler_01"/>
    <bpmn:participant id="Participant_Supplier" name="Supplier" processRef="Process_Supplier_02"/>

    <bpmn:messageFlow id="MessageFlow_OrderRequest" sourceRef="Task_PlaceOrder_ASSEMBLER" targetRef="StartEvent_ReceiveOrder_SUPPLIER">
      <bpmn:sourceElement>Participant_AssemblerAG</bpmn:sourceElement>
      <bpmn:targetElement>Participant_Supplier</bpmn:targetElement>
    </bpmn:messageFlow>

    <bpmn:messageFlow id="MessageFlow_Invoice" sourceRef="Task_SendInvoice_SUPPLIER" targetRef="EndEvent_ReceiveInvoice_ASSEMBLER">
      <bpmn:sourceElement>Participant_Supplier</bpmn:sourceElement>
      <bpmn:targetElement>Participant_AssemblerAG</bpmn:targetElement>
    </bpmn:messageFlow>
  </bpmn:collaboration>

  <!-- Process for Assembler AG -->
  <bpmn:process id="Process_Assembler_01" isExecutable="false">
    <bpmn:startEvent id="StartEvent_TimerMonthly_ASSEMBLER" name="First of Month Timer">
      <bpmn:outgoing>SequenceFlow_StartToOrder</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_PlaceOrder_ASSEMBLER" name="Place Order with Supplier">
      <bpmn:incoming>SequenceFlow_StartToOrder</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OrderSent</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_ReceiveInvoice_ASSEMBLER" name="Received Invoice">
      <bpmn:incoming>MessageFlow_Invoice</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow_StartToOrder" sourceRef="StartEvent_TimerMonthly_ASSEMBLER" targetRef="Task_PlaceOrder_ASSEMBLER"/>
    <bpmn:sequenceFlow id="SequenceFlow_OrderSent" name="Send Order Request" sourceRef="Task_PlaceOrder_ASSEMBLER" targetRef="EndEvent_ReceiveInvoice_ASSEMBLER">
      <!-- Note: In collaboration, this connects via message flow -->
    </bpmn:sequenceFlow>
  </bpmn:process>

  <!-- Process for Supplier -->
  <bpmn:process id="Process_Supplier_02" isExecutable="false">
    <bpmn:startEvent id="StartEvent_ReceiveOrder_SUPPLIER" name="Receive Order Request">
      <bpmn:incoming>MessageFlow_OrderRequest</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProcessOrder</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_ProcessOrder_SUPPLIER" name="Process Order">
      <bpmn:incoming>SequenceFlow_ProcessOrder</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendInvoice</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_SupplierDone_SUPPLIER" name="Process Complete">
      <bpmn:incoming>SequenceFlow_SendInvoice</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow_ProcessOrder" sourceRef="StartEvent_ReceiveOrder_SUPPLIER" targetRef="Task_ProcessOrder_SUPPLIER"/>
    <bpmn:task id="Task_SendInvoice_SUPPLIER" name="Send Invoice to Assembler AG">
      <bpmn:incoming>SequenceFlow_SendInvoice</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SupplierDone</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_SendInvoice" sourceRef="Task_ProcessOrder_SUPPLIER" targetRef="Task_SendInvoice_SUPPLIER"/>
    <bpmn:sequenceFlow id="SequenceFlow_SupplierDone" name="Send Invoice Message" sourceRef="Task_SendInvoice_SUPPLIER" targetRef="EndEvent_SupplierDone_SUPPLIER">
      <!-- Note: In collaboration, this connects via message flow -->
    </bpmn:sequenceFlow>
  </bpmn:process>

</bpmn:definitions>