<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_ServiceDegradationProcess" targetNamespace="http://example.com/bpmn">
  <bpmn:message id="Message_DetailedReport"/>
  
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_CS" name="Customer Service Dept." processRef="Process_CS"/>
    <bpmn:participant id="Participant_SM" name="Service Management" processRef="Process_SM"/>
    <bpmn:participant id="Participant_RP" name="Resource Provisioning" processRef="Process_RP"/>
  </bpmn:collaboration>

  <!-- Process 1: Customer Service -->
  <bpmn:process id="Process_CS" isExecutable="false">
    <bpmn:startEvent id="Start_CustomerPerception" name="Service Degradation Perceived">
      <bpmn:outgoing>SequenceFlow_001</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_CS_EnterReport" name="Enter Problem Report into System T">
      <bpmn:incoming>SequenceFlow_002</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_003</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_CS_Significance" name="Customer Significance Check">
      <bpmn:incoming>SequenceFlow_004</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_005</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_CS_Prioritize" name="Re-prioritize Measures">
      <bpmn:incoming>SequenceFlow_013</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_027</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_CS_Priorities" name="Priorities Changed?">
      <bpmn:incoming>SequenceFlow_013</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_027</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_CS_CreateReport" name="Create Detailed Problem Report">
      <bpmn:incoming>SequenceFlow_013</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_028</bpmn:outgoing>
    </bpmn:task>

    <!-- Message Flow to Service Management -->
    
  </bpmn:process>

  <!-- Process 2: Service Management -->
  <bpmn:process id="Process_SM" isExecutable="false">
    <bpmn:startEvent id="Start_SM_ReceiveReport" name="Receive Detailed Report">
      <bpmn:outgoing>SequenceFlow_SM01</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Receive Message from CS -->
    
  </bpmn:process>

  <!-- Process 3: Resource Provisioning -->
  <bpmn:process id="Process_RP" isExecutable="false">
    <bpmn:startEvent id="Start_RP_Wait" name="Wait for Report/Request">
      <bpmn:outgoing>SequenceFlow_RP01</bpmn:outgoing>
    </bpmn:startEvent>

  </bpmn:process>

  <!-- Message Flows -->
  
</bpmn:definitions>