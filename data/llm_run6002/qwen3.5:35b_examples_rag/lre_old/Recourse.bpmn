<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_SubrogationProcess" targetNamespace="http://example.com/bpmn">
  <bpmn:collaboration id="Collaboration_0geryc1">
    <bpmn:participant id="Participant_0ygkg4f" name="Insurance Subrogation Process" processRef="Process_Subrogation"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Subrogation" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Receive subrogation information">
      <bpmn:outgoing>SequenceFlow_001</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Check if recourse is possible -->
    <bpmn:task id="Task_CheckPossibility" name="Check if recourse is possible">
      <bpmn:incoming>SequenceFlow_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_002</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Recourse possible? -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_Possibility" name="Recourse possible?">
      <bpmn:incoming>SequenceFlow_002</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_003</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_014</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Send payment request -->
    <bpmn:task id="Task_SendRequest" name="Send payment request to insurant">
      <bpmn:incoming>SequenceFlow_003</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_004</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway for waiting -->
    <bpmn:parallelGateway id="ParallelGateway_Wait" name="Wait for response">
      <bpmn:incoming>SequenceFlow_004</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_005</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_012</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Make reminder -->
    <bpmn:task id="Task_MakeReminder" name="Make reminder">
      <bpmn:incoming>SequenceFlow_013</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_014</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_CloseCase" name="Close case">
      <bpmn:incoming>SequenceFlow_015</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_023</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_027</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Intermediate Catch Event for Money Received -->
    <bpmn:startEvent id="StartEvent_MoneyReceived" name="Money received">
      <bpmn:outgoing>SequenceFlow_016</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Make booking -->
    <bpmn:task id="Task_BillingBooking" name="Make booking">
      <bpmn:incoming>SequenceFlow_016</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_023</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Catch Event for Disagreement -->
    <bpmn:startEvent id="StartEvent_Disagreement" name="Insurant disagrees">
      <bpmn:outgoing>SequenceFlow_017</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Check reasoning of disagreement -->
    <bpmn:task id="Task_CheckReasoning" name="Check reasoning of disagreement">
      <bpmn:incoming>SequenceFlow_017</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_018</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Is reasoning right? -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_RightWrong" name="Is reasoning right?">
      <bpmn:incoming>SequenceFlow_018</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_023</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_024</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Intermediate Catch Event for Deadline Reached -->
    <bpmn:startEvent id="StartEvent_DeadlineReached" name="Deadline reached">
      <bpmn:outgoing>SequenceFlow_025</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Forward to collection agency -->
    <bpmn:task id="Task_ForwardCollection" name="Forward to collection agency">
      <bpmn:incoming>SequenceFlow_024</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_025</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_026</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event for Collection -->
    <bpmn:endEvent id="EndEvent_Collection" name="Case forwarded to collection">
      <bpmn:incoming>SequenceFlow_026</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_001" sourceRef="StartEvent_1" targetRef="Task_CheckPossibility"/>
    <bpmn:sequenceFlow id="SequenceFlow_002" sourceRef="Task_CheckPossibility" targetRef="ExclusiveGateway_Possibility"/>

    <!-- Recourse possible paths -->
    <bpmn:sequenceFlow id="SequenceFlow_003" name="Yes - possible" sourceRef="ExclusiveGateway_Possibility" targetRef="Task_SendRequest"/>
    <bpmn:sequenceFlow id="SequenceFlow_014" name="No - not possible" sourceRef="ExclusiveGateway_Possibility" targetRef="EndEvent_CloseCase"/>

    <!-- After sending request -->
    <bpmn:sequenceFlow id="SequenceFlow_004" sourceRef="Task_SendRequest" targetRef="ParallelGateway_Wait"/>
    <bpmn:sequenceFlow id="SequenceFlow_012" name="Make reminder path" sourceRef="ParallelGateway_Wait" targetRef="Task_MakeReminder"/>

    <!-- Money received flow -->
    <bpmn:sequenceFlow id="SequenceFlow_016" sourceRef="StartEvent_MoneyReceived" targetRef="Task_BillingBooking"/>
    <bpmn:sequenceFlow id="SequenceFlow_023" name="Close case after booking" sourceRef="Task_BillingBooking" targetRef="EndEvent_CloseCase"/>

    <!-- Disagreement flow -->
    <bpmn:sequenceFlow id="SequenceFlow_017" sourceRef="StartEvent_Disagreement" targetRef="Task_CheckReasoning"/>
    <bpmn:sequenceFlow id="SequenceFlow_018" sourceRef="Task_CheckReasoning" targetRef="ExclusiveGateway_RightWrong"/>

    <!-- Right reasoning path -->
    <bpmn:sequenceFlow id="SequenceFlow_023" name="Right - close case" sourceRef="ExclusiveGateway_RightWrong" targetRef="EndEvent_CloseCase"/>

    <!-- Wrong reasoning to collection agency -->
    <bpmn:sequenceFlow id="SequenceFlow_024" name="Wrong - forward to collection" sourceRef="ExclusiveGateway_RightWrong" targetRef="Task_ForwardCollection"/>

    <!-- Deadline reached path -->
    <bpmn:sequenceFlow id="SequenceFlow_025" name="Deadline without payment" sourceRef="StartEvent_DeadlineReached" targetRef="Task_ForwardCollection"/>

    <!-- Collection agency end event flow -->
    <bpmn:sequenceFlow id="SequenceFlow_026" sourceRef="Task_ForwardCollection" targetRef="EndEvent_Collection"/>

  </bpmn:process>
</bpmn:definitions>