<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_CustomerAcquisition" targetNamespace="http://example.com/bpmn">
  <bpmn:collaboration id="Collaboration_CustomerAcquisition">
    <bpmn:participant id="Participant_SalesProcess" name="Customer Acquisition Process" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Marketing" name="Marketing Team">
        <bpmn:flowNodeRef>Task_DetermineContactDetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CallCenter" name="Call Center Staff">
        <bpmn:flowNodeRef>Task_CallCustomer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_InterestCheck</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sales" name="Sales Representative">
        <bpmn:flowNodeRef>Task_PresentationGeneral</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_WaitResponse</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PreSales" name="Pre-Sales Employee">
        <bpmn:flowNodeRef>Task_PresentationTechnical</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_DevelopmentHead" name="Head of Development">
        <bpmn:flowNodeRef>Task_AcquireCustomerSpecial</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Determine contact details">
      <bpmn:outgoing>SequenceFlow_001</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Determine Contact Details (multiple ways) -->
    <bpmn:task id="Task_DetermineContactDetails" name="Determine contact details of potential customers">
      <bpmn:incoming>SequenceFlow_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_002</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow from Start to Task -->
    <bpmn:sequenceFlow id="SequenceFlow_001" sourceRef="StartEvent_1" targetRef="Task_DetermineContactDetails"/>

    <!-- Call Customer (Call Center) -->
    <bpmn:task id="Task_CallCustomer" name="Call customer and determine contact person & budget">
      <bpmn:incoming>SequenceFlow_002</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_003</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow to Call Task -->
    <bpmn:sequenceFlow id="SequenceFlow_002" sourceRef="Task_DetermineContactDetails" targetRef="Task_CallCustomer"/>

    <!-- Gateway for Interest Check -->
    <bpmn:exclusiveGateway id="Gateway_InterestCheck">
      <bpmn:incoming>SequenceFlow_003</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_004</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_012</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flow to Gateway -->
    <bpmn:sequenceFlow id="SequenceFlow_003" sourceRef="Task_CallCustomer" targetRef="Gateway_InterestCheck"/>

    <!-- Task: Ask if interested (Call Center) -->
    <bpmn:task id="Task_AskInterested" name="Ask customer whether generally interested">
      <bpmn:incoming>SequenceFlow_012</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_013</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow for "Not Interested" path -->
    <bpmn:sequenceFlow id="SequenceFlow_012" name="not interested" sourceRef="Gateway_InterestCheck" targetRef="Task_AskInterested"/>

    <!-- Gateway for Budget Check (if not interested) -->
    <bpmn:exclusiveGateway id="Gateway_BudgetCheck">
      <bpmn:incoming>SequenceFlow_013</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_014</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_015</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flow from Ask Interested -->
    <bpmn:sequenceFlow id="SequenceFlow_013" sourceRef="Task_AskInterested" targetRef="Gateway_BudgetCheck"/>

    <!-- Task: Head of Development Acquire (Special Case) -->
    <bpmn:task id="Task_AcquireCustomerSpecial" name="Head of development acquires customer">
      <bpmn:incoming>SequenceFlow_014</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_023</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow for "Budget Huge" path -->
    <bpmn:sequenceFlow id="SequenceFlow_014" name="budget huge" sourceRef="Gateway_BudgetCheck" targetRef="Task_AcquireCustomerSpecial"/>

    <!-- End Event (Leave Alone) -->
    <bpmn:endEvent id="EndEvent_Lost">
      <bpmn:incoming>SequenceFlow_015</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flow for "Budget Not Huge" path -->
    <bpmn:sequenceFlow id="SequenceFlow_015" name="budget not huge" sourceRef="Gateway_BudgetCheck" targetRef="EndEvent_Lost"/>

    <!-- Gateway after Special Acquisition or Direct Interest (Merge) -->
    <bpmn:exclusiveGateway id="Gateway_PresentationType">
      <bpmn:incoming>SequenceFlow_023</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_016</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_017</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flow from Special Acquisition -->
    <bpmn:sequenceFlow id="SequenceFlow_023" sourceRef="Task_AcquireCustomerSpecial" targetRef="Gateway_PresentationType"/>

    <!-- Task: General Presentation (Sales Rep) -->
    <bpmn:task id="Task_PresentationGeneral" name="Detailed online presentation">
      <bpmn:incoming>SequenceFlow_016</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_024</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow for General Presentation -->
    <bpmn:sequenceFlow id="SequenceFlow_016" name="general presentation" sourceRef="Gateway_PresentationType" targetRef="Task_PresentationGeneral"/>

    <!-- Task: Technical Presentation (Pre-Sales) -->
    <bpmn:task id="Task_PresentationTechnical" name="Detailed technical online presentation">
      <bpmn:incoming>SequenceFlow_017</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_025</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow for Technical Presentation -->
    <bpmn:sequenceFlow id="SequenceFlow_017" name="technical presentation" sourceRef="Gateway_PresentationType" targetRef="Task_PresentationTechnical"/>

    <!-- Gateway Wait Response (Merge after presentations) -->
    <bpmn:exclusiveGateway id="Gateway_WaitResponse">
      <bpmn:incoming>SequenceFlow_024</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_025</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_018</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flow from Presentations -->
    <bpmn:sequenceFlow id="SequenceFlow_024" sourceRef="Task_PresentationGeneral" targetRef="Gateway_WaitResponse"/>
    <bpmn:sequenceFlow id="SequenceFlow_025" name="" sourceRef="Task_PresentationTechnical" targetRef="Gateway_WaitResponse"/>

    <!-- Intermediate Catch Event (Wait 2 weeks) -->
    <bpmn:intermediateCatchEvent id="Intermediate_CatchContact">
      <bpmn:incoming>SequenceFlow_018</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_019</bpmn:outgoing>
      <bpmn:timerEventDefinition timeDuration="P2W"/>
    </bpmn:intermediateCatchEvent>

    <!-- Sequence Flow to Wait Event -->
    <bpmn:sequenceFlow id="SequenceFlow_018" sourceRef="Gateway_WaitResponse" targetRef="Intermediate_CatchContact"/>

    <!-- Gateway for Contact Decision (after wait) -->
    <bpmn:exclusiveGateway id="Gateway>ContactDecision">
      <bpmn:incoming>SequenceFlow_019</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_020</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_021</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flow from Wait Event -->
    <bpmn:sequenceFlow id="SequenceFlow_019" sourceRef="Intermediate_CatchContact" targetRef="Gateway>ContactDecision"/>

    <!-- Task: Call Customer (Follow-up) -->
    <bpmn:task id="Task_CallBackCustomer" name="Sales representative calls customer">
      <bpmn:incoming>SequenceFlow_021</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_026</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow for "No Contact" path -->
    <bpmn:sequenceFlow id="SequenceFlow_021" name="not contacted within 2 weeks" sourceRef="Gateway>ContactDecision" targetRef="Task_CallBackCustomer"/>

    <!-- End Event (Contacted) -->
    <bpmn:endEvent id="EndEvent_Confirmed">
      <bpmn:incoming>SequenceFlow_020</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flow for "Contacted" path -->
    <bpmn:sequenceFlow id="SequenceFlow_020" name="contacted within 2 weeks" sourceRef="Gateway>ContactDecision" targetRef="EndEvent_Confirmed"/>

    <!-- Task: Create Quotation (Final Step) -->
    <bpmn:endEvent id="EndEvent_Process">
      <bpmn:incoming>SequenceFlow_026</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flow to Final End Event -->
    <bpmn:sequenceFlow id="SequenceFlow_026" sourceRef="Task_CallBackCustomer" targetRef="EndEvent_Process"/>

  </bpmn:process>
</bpmn:definitions>