<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_RecruitmentProcess" targetNamespace="http://example.com/bpmn">
  <bpmn:collaboration id="Collaboration_HiringProcess">
    <bpmn:participant id="Participant_Organization" name="Organization Recruitment Process" processRef="Process_Hiring"/>
    <bpmn:participant id="Participant_Candidates" name="Job Applicants" />
  </bpmn:collaboration>

  <bpmn:process id="Process_Hiring" isExecutable="false">
    <bpmn:startEvent id="StartEvent_RequestPost" name="Department requests to fill post">
      <bpmn:outgoing>SequenceFlow_001</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_AdvertisePost" name="Advertise the post">
      <bpmn:incoming>SequenceFlow_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_002</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_001" sourceRef="StartEvent_RequestPost" targetRef="Task_AdvertisePost"/>

    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_Applied" name="Applicants apply">
      <bpmn:messageEventDefinition />
      <bpmn:incoming>SequenceFlow_002</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_003</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:sequenceFlow id="SequenceFlow_002" sourceRef="Task_AdvertisePost" targetRef="IntermediateCatchEvent_Applied"/>

    <bpmn:task id="Task_CheckApplications" name="Check applications">
      <bpmn:incoming>SequenceFlow_003</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_004</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_003" sourceRef="IntermediateCatchEvent_Applied" targetRef="Task_CheckApplications"/>

    <bpmn:endEvent id="EndEvent_ContractSigned" name="Contract of employment signed">
      <bpmn:incoming>SequenceFlow_004</bpmn:outgoing>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow_004" sourceRef="Task_CheckApplications" targetRef="EndEvent_ContractSigned"/>
  </bpmn:process>

  <bpmn:messageFlow id="MessageFlow_Applications">
    <bpmn:sourceRef>Participant_Candidates</bpmn:sourceRef>
    <bpmn:targetRef>IntermediateCatchEvent_Applied</bpmn:targetRef>
  </bpmn:messageFlow>

  <bpmn:startMessage id="StartMessage_Applications" name="Application received">
    <bpmn:name>Applicants apply</bpmn:name>
  </bpmn:startMessage>
</bpmn:definitions>