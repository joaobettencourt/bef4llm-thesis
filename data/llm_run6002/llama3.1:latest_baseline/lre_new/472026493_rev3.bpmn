      </bpmn:lane>
      <bpmn:lane id="Lane_2vl2igx" name="Management">
        <bpmn:flowNodeRef>InclusiveGateway_1dgb4sg</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3vl2igx" name="Financial Department">
        <bpmn:flowNodeRef>Task_05ftug5</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Core Flow Elements -->
    <bpmn:startEvent id="StartEvent_1" name="Request for new hardware">
      <bpmn:outgoing>SequenceFlow_14a0oky</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_12j0pib" name="Analyse request">
      <bpmn:incoming>SequenceFlow_14a0oky</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1j94oja</bpmn:outgoing>
    </bpmn:task>

    <!-- Data & Artifacts -->
    <bpmn:endEvent id="EndEvent_1fx9yp3" name="Process ended">
      <bpmn:incoming>SequenceFlow_0v64x8b</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Reusable Elements -->
    <bpmn:message id="Message_0" name="Email to employee">
      <bpmn:outgoing>SequenceFlow_1dlbln9</bpmn:outgoing>
    </bpmn:message>
  </bpmn:process>

  <bpmn:exclusiveGateway id="ExclusiveGateway_1mpgzhg" name="Approve or deny request">
    <bpmn:incoming>SequenceFlow_14a0oky</bpmn:incoming>
    <bpmn:outgoing>SequenceFlow_1j94oja</bpmn:outgoing>
    <bpmn:outgoing>SequenceFlow_1xv6wk4</bpmn:outgoing>
