    <bpmn:participant id="Participant_1jsoxba" name="Supplier" processRef="Process_1"/>
    <bpmn:participant id="Participant_0vaxgaa" name="Management" processRef="Process_1"/>
    <bpmn:participant id="Participant_05ftug5" name="Financial Department" processRef="Process_1"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_1viot5w" name="IT Department">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_12j0pib</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_1mpgzhg</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1ocseyo" name="Supplier">
