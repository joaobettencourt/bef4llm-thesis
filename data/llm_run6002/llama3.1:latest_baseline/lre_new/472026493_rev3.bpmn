  <bpmn:messageReceiveEvent id="MessageReceiveEvent_0" name="Email from supplier">
    <bpmn:outgoing>SequenceFlow_0kz5g1t</bpmn:outgoing>
  </bpmn:messageReceiveEvent>

  <bpmn:sequenceFlow id="SequenceFlow_0kz5g1t" sourceRef="MessageReceiveEvent_0" targetRef="Task_05ftug5"/>
  <bpmn:task id="Task_05ftug5" name="Fill in form">
    <bpmn:incoming>SequenceFlow_0kz5g1t</bpmn:incoming>
    <bpmn:outgoing>SequenceFlow_0mp5byl</bpmn:outgoing>
