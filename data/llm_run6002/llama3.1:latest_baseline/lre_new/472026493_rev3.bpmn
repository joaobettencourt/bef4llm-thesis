  <bpmn:sequenceFlow id="SequenceFlow_035vf60" sourceRef="InclusiveGateway_1dgb4sg" targetRef="ExclusiveGateway_0z5sib0"/>

  <bpmn:exclusiveGateway id="ExclusiveGateway_0z5sib0" name="Approve or deny request">
    <bpmn:incoming>SequenceFlow_035vf60</bpmn:incoming>
    <bpmn:outgoing>SequenceFlow_06kfaev</bpmn:outgoing>
  </bpmn:exclusiveGateway>

  <bpmn:sequenceFlow id="SequenceFlow_0v64x8b" sourceRef="ExclusiveGateway_0z5sib0" targetRef="EndEvent_1fx9yp3"/>
  <bpmn:sequenceFlow id="SequenceFlow_06kfaev" sourceRef="ExclusiveGateway_0z5sib0" targetRef="Task_0sl26uo"/>

  <bpmn:task id="Task_0sl26uo" name="Prepare for picking up goods">
