    <bpmn:sequenceFlow id="SequenceFlow_0kz5g1t" sourceRef="StartEvent_1" targetRef="Task_12j0pib" />
    <bpmn:task id="Task_12j0pib" name="IP checks request of INQ">
      <bpmn:incoming>SequenceFlow_0kz5g1t</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0mp5byl</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_0mp5byl" sourceRef="Task_12j0pib" targetRef="ExclusiveGateway_1dgb4sg" />
