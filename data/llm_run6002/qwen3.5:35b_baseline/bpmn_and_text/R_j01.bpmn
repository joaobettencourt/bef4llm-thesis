<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_OEE_Process_001">
  <bpmn:collaboration id="Collaboration_OEE_Monitoring">
    <bpmn:participant id="Participant_EquipmentMonitoring" name="Equipment Monitoring System" processRef="Process_OEE_Calculation"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_OEE_Calculation" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="Start_MonitoringInitiated" name="Monitoring Initiated">
      <bpmn:outgoing>SequenceFlow_StartToCollect</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Collect Data -->
    <bpmn:task id="Task_CollectMachineData" name="Collect Machine Information">
      <bpmn:incoming>SequenceFlow_StartToCollect</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CollectToCalculation</bpmn:outgoing>
    </bpmn:task>

    <!-- Boundary Event for Disconnection -->
    <bpmn:boundaryEvent id="Boundary_MachineDisconnected" name="Machine Disconnected">
      <bpmn:attachedToRef>Task_CollectMachineData</bpmn:attachedToRef>
      <bpmn:outgoing>SequenceFlow_DisconnectStop</bpmn:outgoing>
    </bpmn:boundaryEvent>

    <!-- End Event for Disconnection -->
    <bpmn:endEvent id="End_ProcessStopped" name="Process Stopped">
      <bpmn:incoming>SequenceFlow_DisconnectStop</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task 2: Calculate OEE -->
    <bpmn:task id="Task_CalculateOEE" name="Calculate OEE">
      <bpmn:incoming>SequenceFlow_CollectToCalculation</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OEEToGateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Check OEE Threshold -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_CheckOEE" name="OEE Below Threshold?">
      <bpmn:incoming>SequenceFlow_OEEToGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OKPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_LowOEELoop</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flow for OK Path (Loop back) -->
    <bpmn:sequenceFlow id="SequenceFlow_OKPath" name="No, Continue Measuring" sourceRef="ExclusiveGateway_CheckOEE" targetRef="Task_CollectMachineData"/>

    <!-- Parallel Gateway Split for Exception Handling -->
    <bpmn:parallelGateway id="ParallelSplit_LowOEE" name="Stop &amp; Notify">
      <bpmn:incoming>SequenceFlow_LowOEELoop</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StopMachineTask</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SendEmailTask</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 3: Stop Machine -->
    <bpmn:task id="Task_StopMachine" name="Stop Machine">
      <bpmn:incoming>SequenceFlow_StopMachineTask</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SplitToJoin</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 4: Send Email -->
    <bpmn:task id="Task_SendEmail" name="Send Email to Engineer">
      <bpmn:incoming>SequenceFlow_SendEmailTask</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SplitToJoin</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway Join -->
    <bpmn:parallelGateway id="ParallelJoin_RestartWait" name="Await Restart">
      <bpmn:incoming>SequenceFlow_StopMachineTask</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_SendEmailTask</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitForRestartSignal</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Intermediate Catch Event for Restart Signal -->
    <bpmn:intermediateCatchEvent id="Intermediate_CatchRestart" name="Machine Restarted">
      <bpmn:incoming>SequenceFlow_WaitForRestartSignal</bpmn:outgoing></sequence-flow-id=Sequence_14a0oky/>

    <!-- Sequence Flow from Join to Catch Event -->
    <bpmn:sequenceFlow id="SequenceFlow_WaitForRestartSignal" sourceRef="ParallelJoin_RestartWait" targetRef="Intermediate_CatchRestart"/>

    <!-- Loop back after Restart Signal -->
    <bpmn:sequenceFlow id="SequenceFlow_RestartToLoop" name="Continue Measuring" sourceRef="Intermediate_CatchRestart" targetRef="Task_CollectMachineData"/>

    <!-- Sequence Flow from Start to Collect Data -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToCollect" sourceRef="Start_MonitoringInitiated" targetRef="Task_CollectMachineData"/>

    <!-- Sequence Flow from Collect Data to Calculate OEE -->
    <bpmn:sequenceFlow id="SequenceFlow_CollectToCalculation" sourceRef="Task_CollectMachineData" targetRef="Task_CalculateOEE"/>

    <!-- Sequence Flow from Calculate OEE to Gateway -->
    <bpmn:sequenceFlow id="SequenceFlow_OEEToGateway" name="Calculate OEE Result" sourceRef="Task_CalculateOEE" targetRef="ExclusiveGateway_CheckOEE"/>

    <!-- Sequence Flow for Low OEE Path (to Parallel Split) -->
    <bpmn:sequenceFlow id="SequenceFlow_LowOEELoop" name="Yes, Stop &amp; Notify" sourceRef="ExclusiveGateway_CheckOEE" targetRef="ParallelSplit_LowOEE"/>

    <!-- Sequence Flows for Exception Tasks -->
    <bpmn:sequenceFlow id="SequenceFlow_StopMachineTask" sourceRef="ParallelSplit_LowOEE" targetRef="Task_StopMachine"/>
    <bpmn:sequenceFlow id="SequenceFlow_SendEmailTask" sourceRef="ParallelSplit_LowOEE" targetRef="Task_SendEmail"/>

    <!-- Sequence Flow for Join -->
    <bpmn:sequenceFlow id="SequenceFlow_SplitToJoin" name="" sourceRef="Task_StopMachine" targetRef="ParallelJoin_RestartWait"/>
    
  </bpmn:process>
</bpmn:definitions>