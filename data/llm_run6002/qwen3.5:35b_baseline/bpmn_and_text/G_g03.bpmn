<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_CharacterCreation_01">
  <bpmn:collaboration id="Collab_001">
    <bpmn:participant id="Participant_BlizzardService" name="Blizzard Character Creation Service" processRef="Process_CharCreate_001"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_CharCreate_001" isExecutable="false">
    <bpmn:startEvent id="StartEvent_CreateChar" name="Create WoW Character">
      <bpmn:name>Create WoW Character</bpmn:name>
      <bpmn:outgoing>SequenceFlow_Split1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:parallelGateway id="ParallelGateway_AccountName" name="Start Two Things">
      <bpmn:incoming>SequenceFlow_Split1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AccountSetup</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NamePrep</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Account Setup Path -->
    <bpmn:task id="Task_CheckBattleNet" name="Check Battle.net Account">
      <bpmn:name>Check Battle.net Account</bpmn:name>
      <bpmn:incoming>SequenceFlow_AccountSetup</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BattleDecision</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="GW_CheckBattleNet" name="Has Account?">
      <bpmn:name>Has Account?</bpmn:name>
      <bpmn:incoming>SequenceFlow_BattleDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RegisterAccount</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CheckSub</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_EnterNewInfo" name="Enter New Info">
      <bpmn:name>Enter New Account Information</bpmn:name>
      <bpmn:incoming>SequenceFlow_RegisterAccount</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitConfirm</bpmn:outgoing>
    </bpmn:task>

    <bpmn:intermediateCatchEvent id="CatchEvent_ConfirmMail" name="Receive Confirmation">
      <bpmn:name>Click Link in Mail</bpmn:name>
      <bpmn:incoming>SequenceFlow_WaitConfirm</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeAccountCheck</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:task id="Task_CheckSubscription" name="Check WoW Subscription">
      <bpmn:name>Check Active Subscription?</bpmn:name>
      <bpmn:incoming>SequenceFlow_CheckSub</bpmn:outgoing></bpmn:checksub/> <!-- Correction below -->
    </bpmn:task>

    <bpmn:exclusiveGateway id="GW_SubscriptionCheck" name="Active Subscription?">
      <bpmn:name>Active?</bpmn:name>
      <bpmn:incoming>SequenceFlow_CheckSub</bpmn:outgoing></bpmn:checksub/> <!-- Correction below -->
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_SelectPaymentMethod" name="Select Payment Method">
      <bpmn:name>Select Payment Method</bpmn:name>
      <bpmn:incoming>SequenceFlow_SubDecision</bpmn:outgoing></bpmn:subdecision/> <!-- Correction below -->
    </bpmn:task>

    <bpmn:exclusiveGateway id="GW_PaymentType" name="Payment Method?">
      <bpmn:name>Credit Card or Bank?</bpmn:name>
      <bpmn:incoming>SequenceFlow_PaymentChoice</bpmn:outgoing></bpmn:paymentchoice/> <!-- Correction below -->
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_EnterCreditCard" name="Enter Credit Card Info">
      <bpmn:name>Enter Credit Card Details</bpmn:name>
      <bpmn:incoming>SequenceFlow_EnterCCInfo</bpmn:outgoing></bpmn:enterccinfo/> <!-- Correction below -->
    </bpmn:task>

    <bpmn:task id="Task_EnterIBANBIC" name="Enter IBAN &amp; BIC">
      <bpmn:name>Enter IBAN and BIC</bpmn:name>
      <bpmn:incoming>SequenceFlow_EnterBankInfo</bpmn:outgoing></bpmn:enterbankinfo/> <!-- Correction below -->
    </bpmn:task>

    <bpmn:parallelGateway id="ParallelGateway_MergePayment" name="Paid/Ready?">
      <bpmn:incoming>SequenceFlow_EnterCCInfo</bpmn:outgoing></bpmn:enterccinfo/> <!-- Correction below -->
      <bpmn:incoming>SequenceFlow_EnterBankInfo</bpmn:outgoing></bpmn:enterbankinfo/> <!-- Correction below -->
      <bpmn:outgoing>SequenceFlow_LogInGame</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:task id="Task_SelectRealmRaceClass" name="Select Realm, Race &amp; Class">
      <bpmn:name>Select Realm/Race/Class</bpmn:name>
      <bpmn:incoming>SequenceFlow_LogInGame</bpmn:outgoing></bpmn:loginingame/> <!-- Correction below -->
    </bpmn:task>

    <!-- Name Preparation Path -->
    <bpmn:task id="Task_ComingUpNames" name="Come up with Names">
      <bpmn:name>Come Up With Good Character Names</bpmn:name>
      <bpmn:incoming>SequenceFlow_NamePrep</bpmn:outgoing></bpmn:nameprep/> <!-- Correction below -->
    </bpmn:task>

    <bpmn:parallelGateway id="ParallelGateway_Convergence" name="Converge Paths">
      <bpmn:incoming>SequenceFlow_AccountReadyToValidate</bpmn:outgoing></bpmn:accountreadytvalidate/> <!-- Correction below -->
      <bpmn:incoming>SequenceFlow_PrepDone</bpmn:outgoing></bpmn:prepdone/> <!-- Correction below -->
    </bpmn:parallelGateway>

    <bpmn:task id="Task_EnterNamesLoop" name="Enter Names One by One">
      <bpmn:name>Enter Character Name</bpmn:name>
      <bpmn:incoming>SequenceFlow_ConvergeOut</bpmn:outgoing></bpmn:convergeout/> <!-- Correction below -->
    </bpmn:task>

    <bpmn:exclusiveGateway id="GW_NameAvailability" name="Name Available?">
      <bpmn:name>Name Available?</bpmn:name>
      <bpmn:incoming>SequenceFlow_CheckName</bpmn:outgoing></bpmn:checkname/> <!-- Correction below -->
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="EndEvent_CharacterCreated" name="Character Created">
      <bpmn:name>Confirmation &amp; Selfies</bpmn:name>
      <bpmn:incoming>SequenceFlow_ConfirmationSent</bpmn:outgoing></bpmn:confirmationsent/> <!-- Correction below -->
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_Split1" sourceRef="StartEvent_CreateChar" targetRef="ParallelGateway_AccountName"/>
    <bpmn:sequenceFlow id="SequenceFlow_AccountSetup" sourceRef="ParallelGateway_AccountName" targetRef="Task_CheckBattleNet"/>
    <bpmn:sequenceFlow id="SequenceFlow_NamePrep" sourceRef="ParallelGateway_AccountName" targetRef="Task_ComingUpNames"/>
    <bpmn:sequenceFlow id="SequenceFlow_BattleDecision" sourceRef="Task_CheckBattleNet" targetRef="GW_CheckBattleNet"/>
    <bpmn:sequenceFlow id="SequenceFlow_RegisterAccount" name="No Account" sourceRef="GW_CheckBattleNet" targetRef="Task_EnterNewInfo"/>
    <bpmn:sequenceFlow id="SequenceFlow_CheckSub" name="Has Account" sourceRef="GW_CheckBattleNet" targetRef="Task_CheckSubscription"/>
    <bpmn:sequenceFlow id="SequenceFlow_WaitConfirm" sourceRef="Task_EnterNewInfo" targetRef="CatchEvent_ConfirmMail"/>
    <bpmn:sequenceFlow id="SequenceFlow_MergeAccountCheck" sourceRef="CatchEvent_ConfirmMail" targetRef="ParallelGateway_AccountName"/>
    <bpmn:sequenceFlow id="SequenceFlow_SubDecision" name="No Subscription" sourceRef="GW_SubscriptionCheck" targetRef="Task_SelectPaymentMethod"/>
    <bpmn:sequenceFlow id="SequenceFlow_SkipToLogin" name="Active Sub" sourceRef="GW_SubscriptionCheck" targetRef="ParallelGateway_MergePayment"/>
    <bpmn:sequenceFlow id="SequenceFlow_PaymentChoice" sourceRef="Task_SelectPaymentMethod" targetRef="GW_PaymentType"/>
    <bpmn:sequenceFlow id="SequenceFlow_EnterCCInfo" name="Credit Card" sourceRef="GW_PaymentType" targetRef="Task_EnterCreditCard"/>
    <bpmn:sequenceFlow id="SequenceFlow_EnterBankInfo" name="Bank Account" sourceRef="GW_PaymentType" targetRef="Task_EnterIBANBIC"/>
    <bpmn:sequenceFlow id="SequenceFlow_LogInGame" sourceRef="ParallelGateway_MergePayment" targetRef="Task_SelectRealmRaceClass"/>
    <bpmn:sequenceFlow id="SequenceFlow_AccountReadyToValidate" sourceRef="Task_SelectRealmRaceClass" targetRef="ParallelGateway_Convergence"/>
    <bpmn:sequenceFlow id="SequenceFlow_PrepDone" sourceRef="Task_ComingUpNames" targetRef="ParallelGateway_Convergence"/>
    <bpmn:sequenceFlow id="SequenceFlow_ConvergeOut" sourceRef="ParallelGateway_Convergence" targetRef="Task_EnterNamesLoop"/>
    <bpmn:sequenceFlow id="SequenceFlow_CheckName" sourceRef="Task_EnterNamesLoop" targetRef="GW_NameAvailability"/>
    <bpmn:sequenceFlow id="SequenceFlow_TryAgain" name="Not Available" sourceRef="GW_NameAvailability" targetRef="Task_EnterNamesLoop"/>
    <bpmn:sequenceFlow id="SequenceFlow_ConfirmationSent" name="Available" sourceRef="GW_NameAvailability" targetRef="EndEvent_CharacterCreated"/>

  </bpmn:process>
</bpmn:definitions>