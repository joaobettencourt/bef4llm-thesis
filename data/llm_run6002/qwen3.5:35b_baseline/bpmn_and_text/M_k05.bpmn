<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_TreeHouse_001">
  <bpmn:collaboration id="Collaboration_TreeHouse">
    <bpmn:participant id="Participant_Homeowner" name="Homeowner Process" processRef="Process_BuildTreehouse"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_BuildTreehouse" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_ProjectInitiation" name="Project Initiated">
      <bpmn:name>Project Initiated</bpmn:name>
      <bpmn:outgoing>SequenceFlow_CollectRequirements</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1 & 2: Collect and Send Requirements -->
    <bpmn:task id="Task_CollectRequirements" name="Collect Initial Requirements">
      <bpmn:name>Collect Initial Requirements</bpmn:name>
      <bpmn:incoming>SequenceFlow_CollectRequirements</bpmn:outgoing></sequence-flow-id=Sequence_035vf60"/>

    <!-- Loop for Draft Refinement -->
    <bpmn:intermediateCatchEvent id="IntermediateReceiveDraft" name="Receive Architect's Draft">
      <bpm:name>Receive Architect's Draft</bpm:name>
      <bpmn:incoming>SequenceFlow_ReceiveDraft</bpmn:outgoing></sequence-flow-id=Sequence_DecideApproval"/>

    <!-- Gateway for Refinement Loop -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_PlanApproved" name="Plan Approved?">
      <bpm:name>Plan Approved?</bpm:nname>
      <bpmn:incoming>SequenceFlow_DecideApproval</bpmn:outgoing></sequence-flow-id=Sequence_RevisitPlan"/>

    <!-- Task for Refinement -->
    <bpmn:task id="Task_RefineRequirements" name="Refine Requirements">
      <bpm:name>Refine Requirements</bpm:nname>
      <bpmn:incoming>SequenceFlow_RevisitPlan</bpmn:outgoing></sequence-flow-id=Sequence_Resubmit"/>

    <!-- Flow back to Architect -->
    <bpmn:task id="Task_ResubmitRequirements" name="Resubmit Revised Requirements">
      <bpm:name>Resubmit Revised Requirements</bpm:nname>
      <bpmn:incoming>SequenceFlow_RevisitPlan</bpmn:outgoing></sequence-flow-id=Sequence_ReceiveDraft"/>

    <!-- Sequence Flow for Loop -->
    <bpmn:sequenceFlow id="SequenceFlow_DecideApproval" sourceRef="IntermediateReceiveDraft" targetRef="ExclusiveGateway_PlanApproved"/>
    
    <bpmn:exclusiveGateway id="ExclusiveGateway_MaterialsOrder">
      <bpm:name>Materials Ordered?</bpm:nname>
      <bpmn:incoming>SequenceFlow_CreateMaterialList</bpmn:outgoing></sequence-flow-id=Sequence_OrderingStarted"/>

    <!-- Task for Materials List -->
    <bpmn:task id="Task_CreateMaterialList" name="Create Material List">
      <bpm:name>Create Material List</bpm:nname>
      <bpmn:incoming>SequenceFlow_PlanApproved</bpmn:outgoing></sequence-flow-id=Sequence_OrderingStarted"/>

