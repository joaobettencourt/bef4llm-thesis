<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_ViennaRun_001">
  <bpmn:collaboration id="Collaboration_RunnerApp">
    <bpmn:participant id="Participant_AppUser" name="Vienna Night Run App User" processRef="Process_RunEvent_001"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_RunEvent_001" isExecutable="false">
    <!-- Data Objects -->
    <bpmn:dataObjectReference id="DataInput_AppInfo" name="App Input Info"/>
    <bpmn:dataObjectReference id="DataOutput_FitnessMetrics" name="Fitness Gadget Metrics"/>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Participate">
      <bpmn:name>Participate at Vienna Night Run</bpmn:name>
      <bpmn:outgoing>SequenceFlow_SelectBlock</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Select Starting Block -->
    <bpmn:task id="Task_SelectStartingBlock">
      <bpmn:name>Select Starting Block</bpmn:name>
      <bpmn:incoming>SequenceFlow_SelectBlock</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RunMeasureTime</bpmn:outgoing>
    </bpmn:task>

    <!-- Association for App Input -->
    <bpmn:dataInputAssociation id="Assoc_AppInfo">
      <bpmn:targetRef>DataInput_AppInfo</bpmn:targetRef>
      <bpmn:sourceRef>Task_SelectStartingBlock</bpmn:sourceRef>
    </bpmn:dataInputAssociation>

    <!-- Task: Run 5km and Measure Time -->
    <bpmn:task id="Task_RunMeasureTime">
      <bpmn:name>Run for 5km &amp; Measure Time</bpmn:name>
      <bpmn:incoming>SequenceFlow_RunMeasureTime</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TimeCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Association for Gadget Output -->
    <bpmn:dataOutputAssociation id="Assoc_FitnessMetrics">
      <bpmn:sourceRef>DataOutput_FitnessMetrics</bpmn:sourceRef>
      <bpmn:targetRef>Task_RunMeasureTime</bpmn:targetRef>
    </bpmn:dataOutputAssociation>

    <!-- Gateway: Is Time &lt; 25 mins? -->
    <bpmn:exclusiveGateway id="Gateway_TimeCheck">
      <bpmn:name>Is Running Time &amp;lt; 25 min?</bpmn:name>
      <bpmn:incoming>SequenceFlow_TimeCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TrainLoop</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_GetNumber</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flow: No (Train Loop) -->
    <bpmn:sequenceFlow id="SequenceFlow_TrainLoop" name="No (&amp;ge; 25 min)">
      <bpmn:name>No</bpmn:name>
      <bpmn:sourceRef>Gateway_TimeCheck</bpmn:targetRef>Task_TrainAndCheck</bpmn:sequenceFlow>

    <!-- Task: Train and Check -->
    <bpmn:task id="Task_TrainAndCheck">
      <bpmn:name>Train &amp; Check Performance</bpmn:name>
      <bpmn:incoming>SequenceFlow_TrainLoop</bpmn:outgoing></bpmn:runtimemeasuretime>

    <!-- Loop Back to Run -->
    <bpmn:sequenceFlow id="SequenceFlow_BackToRun" name="Check Again">
      <bpmn:name>Check Again</bpmn:name>
      <bpmn:sourceRef>Task_TrainAndCheck</bpmn:targetRef>Gateway_TimeCheck</bpmn:outgoing></bpmn:runtimemeasuretime>

    <!-- Sequence Flow: Yes (< 25 mins) -->
    <bpmn:sequenceFlow id="SequenceFlow_GetNumber" name="Yes">
      <bpmn:name>Yes</bpmn:name>
      <bpmn:sourceRef>Gateway_TimeCheck</bpmn:targetRef>Task_GetStartingNumber</bpmn:outgoing></bpmn:runtimemeasuretime>

    <!-- Task: Get Starting Number -->
    <bpmn:task id="Task_GetStartingNumber">
      <bpmn:name>Get Starting Number</bpmn:name>
      <bpmn:incoming>SequenceFlow_GetNumber</bpmn:outgoing></bpmn:runtimemeasuretime>

    <!-- Task: Check Departure Option (Work Schedule) -->
    <bpmn:task id="Task_CheckDeparture">
      <bpmn:name>Check Work Day End vs Start Time</bpmn:name>
      <bpmn:incoming>SequenceFlow_GetStartingNumber</bpmn:outgoing></bpmn:runtimemeasuretime>

    <!-- Gateway: Can go from Home? (> 1 hour buffer) -->
    <bpmn:exclusiveGateway id="Gateway_DepartureOption">
      <bpmn:name>Buffer &amp;gt; 1 Hour?</bpmn:name>
      <bpmn:incoming>SequenceFlow_CheckDeparture</bpmn:outgoing></bpmn:runtimemeasuretime>

    <!-- Path: Go From Home -->
    <bpmn:sequenceFlow id="SequenceFlow_GoHome" name="Yes (&amp;gt; 1 hr)">
      <bpmn:name>Yes</bpmn:name>
      <bpmn:sourceRef>Gateway_DepartureOption</bpmn:targetRef>Task_LeaveHome</bpmn:runtimemeasuretime>

    <!-- Task: Leave From Home -->
    <bpmn:task id="Task_LeaveHome">
      <bpmn:name>Go There from Home</bpmn:name>
      <bpmn:incoming>SequenceFlow_GoHome</bpmn:runtimemeasuretime>

    <!-- Path: Leave From Work -->
    <bpmn:sequenceFlow id="SequenceFlow_LeaveWork" name="No (&amp;le; 1 hr)">
      <bpmn:name>No</bpmn:name>
      <bpmn:sourceRef>Gateway_DepartureOption</bpmn:runtimemeasuretime>

    <!-- Task: Leave Directly From Work -->
    <bpmn:task id="Task_LeaveWorkDirect">
      <bpmn:name>Leave Directly from Work</bpmn:name>
      <bpmn:incoming>SequenceFlow_LeaveWork</bpmn:runtimemeasuretime>

    <!-- Merge Gateway for Departure Paths -->
    <bpmn:exclusiveGateway id="Gateway_MergeDeparture">
      <bpmn:name>Merge Pathways</bpmn:name>
      <bpmn:incoming>SequenceFlow_GoHome</bpmn:runtimemeasuretime>

    <!-- Sequence Flow to Race -->
    <bpmn:sequenceFlow id="SequenceFlow_ToRace" name="To Night Run Start">
      <bpmn:name>To Night Run Start</bpmn:name>
      <bpmn:sourceRef>Task_LeaveHome</bpmn:runtimemeasuretime>

    <!-- Sequence Flow to Race -->
    <bpmn:sequenceFlow id="SequenceFlow_ToRace2" name="To Night Run Start">
      <bpmn:name>To Night Run Start</bpmn:name>
      <bpmn:sourceRef>Task_LeaveWorkDirect</bpmn:runtimemeasuretime>

    <!-- Task: Participate in Race (Run &amp; Drink) -->
    <bpmn:task id="Task_RaceEvent">
      <bpmn:name>Participate Night Run (&amp;amp; Drink)</bpmn:name>
      <bpmn:runtimemeasuretime>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_FinalTime">
      <bpmn:name>Receive Final Running Time</bpmn:name>
      <bpmn:incoming>SequenceFlow_ToRace2</bpmn:runtimemeasuretime>

  </bpmn:process>
</bpmn:definitions>