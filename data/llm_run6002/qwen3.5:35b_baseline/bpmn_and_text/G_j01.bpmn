<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_FarmBot_001">
  <bpmn:collaboration id="Collaboration_FarmBot_001">
    <bpmn:participant id="Participant_FarmBot_System" name="Farming Bot System" processRef="Process_FarmBot_001"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_FarmBot_001">
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_CreateBotConfig">
      <bpmn:name>Create Custom Bot</bpmn:name>
      <bpmn:outgoing>SequenceFlow_ConfigureResources</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Configure Resources -->
    <bpmn:task id="Task_ConfigureBot">
      <bpmn:name>Select &amp; Prioritize Resources</bpmn:name>
      <bpmn:description>Create custom logic of dependencies in game</bpmn:description>
      <bpmn:incoming>SequenceFlow_ConfigureResources</bpmn:outgoing></bpmn:Task_ConfigureBot>

    <!-- Sequence Flow from Configure to Farming -->
    <bpmn:sequenceFlow id="SequenceFlow_StartFarming" sourceRef="Task_ConfigureBot" targetRef="Task_MainFarmLoop"/>

    <!-- Main Farming Task (Encapsulates Parallel Resource Collection) -->
    <bpmn:task id="Task_MainFarmLoop">
      <bpmn:name>Farm Resources (Parallel)</bpmn:name>
      <bpmn:description>Gather up to 10 resources in parallel</bpmn:description>
      <bpmn:incoming>SequenceFlow_StartFarming</bpmn:outgoing></bpmn:Task_MainFarmLoop>

    <!-- Boundary Event: Natural Disaster (Interrupting) -->
    <bpmn:boundaryEvent id="BoundaryEvent_Disaster" attachedToRef="Task_MainFarmLoop">
      <bpmn:name>Natural Disaster</bpmn:name>
      <bpmn:outgoing>SequenceFlow_BoundaryDisaster</bpmn:outgoing>
    </bpmn:boundaryEvent>

    <!-- Sequence Flow for Boundary Event -->
    <bpmn:sequenceFlow id="SequenceFlow_BoundaryDisaster" sourceRef="BoundaryEvent_Disaster" targetRef="Task_ResetBot"/>

    <!-- Task: Reset Bot after Disaster -->
    <bpmn:task id="Task_ResetBot">
      <bpmn:name>Reset &amp; Recover</bpmn:name>
      <bpmn:description>Set bot back to previous state</bpmn:description>
      <bpmn:incoming>SequenceFlow_BoundaryDisaster</bpmn:outgoing></bpmn:Task_ResetBot>

    <!-- Loop Flow from Reset back to Farming -->
    <bpmn:sequenceFlow id="SequenceFlow_ResumeFarming" sourceRef="Task_ResetBot" targetRef="Task_MainFarmLoop"/>

    <!-- Boundary Event: Milestone Reached (Non-Interrupting) -->
    <bpmn:boundaryEvent id="BoundaryEvent_Milestone" attachedToRef="Task_MainFarmLoop">
      <bpmn:name>Milestone Reached</bpmn:name>
      <bpmn:outgoing>SequenceFlow_NotifyMilestone</bpmn:incoming></bpmn:BoundaryEvent_Milestone>

    <!-- Sequence Flow for Milestone Notification -->
    <bpmn:sequenceFlow id="SequenceFlow_NotifyMilestone" sourceRef="BoundaryEvent_Milestone" targetRef="Task_NotifyUser"/>

    <!-- Task: Notify User of Milestones -->
    <bpmn:task id="Task_NotifyUser">
      <bpmn:name>Notify Player</bpmn:name>
      <bpmn:description>Milestones reached notification</bpmn:description>
      <bpmn:incoming>SequenceFlow_NotifyMilestone</bpmn:outgoing></bpmn:Task_NotifyUser>

    <!-- Boundary Event: Update Request (Non-Interrupting) -->
    <bpmn:boundaryEvent id="BoundaryEvent_UpdateRequest" attachedToRef="Task_MainFarmLoop">
      <bpmn:name>Update Materials List</bpmn:name>
      <bpmn:outgoing>SequenceFlow_ProcessUpdate</bpmn:incoming></bpmn:BoundaryEvent_UpdateRequest>

    <!-- Sequence Flow for Update Processing -->
    <bpmn:sequenceFlow id="SequenceFlow_ProcessUpdate" sourceRef="BoundaryEvent_UpdateRequest" targetRef="Task_UpdateResources"/>

    <!-- Task: Process Resource List Updates -->
    <bpmn:task id="Task_UpdateResources">
      <bpmn:name>Update Material List</bpmn:name>
      <bpmn:description>Possible to update at all times during farming</bpmn:description>
      <bpmn:incoming>SequenceFlow_ProcessUpdate</bpmn:outgoing></bpmn:Task_UpdateResources>

    <!-- End Event after Farming -->
    <bpmn:endEvent id="EndEvent_FarmFinished">
      <bpmn:name>Farming Finished</bpmn:name>
      <bpmn:incoming>SequenceFlow_StartFarming</bpmn:outgoing></bpmn:Task_MainFarmLoop>

    <!-- Parallel Gateway for End Actions (Brag AND/OR Send) -->
    <bpmn:parallelGateway id="ParallelGateway_EndActions">
      <bpmn:name>Brag &amp; Share Materials</bpmn:name>
      <bpmn:incoming>SequenceFlow_StartFarming</bpmn:outgoing></bpmn:Task_MainFarmLoop>

    <!-- Sequence Flow to Brag Task -->
    <bpmn:sequenceFlow id="SequenceFlow_Brag" sourceRef="ParallelGateway_EndActions" targetRef="Task_BragToFriends"/>

    <!-- Task: Brag To Friends -->
    <bpmn:task id="Task_BragToFriends">
      <bpmn:name>Brag to Selected Friends</bpmn:name>
      <bpmn:incoming>SequenceFlow_Brag</bpmn:outgoing></bpmn:Task_BragToFriends>

    <!-- Sequence Flow to Send Materials Task -->
    <bpmn:sequenceFlow id="SequenceFlow_SendMaterials" sourceRef="ParallelGateway_EndActions" targetRef="Task_SendMaterials"/>

    <!-- Task: Send Materials -->
    <bpmn:task id="Task_SendMaterials">
      <bpmn:name>Send Selected Materials</bpmn:name>
      <bpmn:incoming>SequenceFlow_SendMaterials</bpmn:outgoing></bpmn:Task_SendMaterials>

    <!-- Join Gateway for End -->
    <bpmn:parallelGateway id="ParallelGateway_JoinEnd">
      <bpmn:incoming>SequenceFlow_Brag</bpmn:outgoing></bpmn:Task_BragToFriends>
      <bpmn:incoming>SequenceFlow_SendMaterials</bpmn:outgoing></bpmn:Task_SendMaterials>

    <!-- Final End Event -->
    <bpmn:endEvent id="EndEvent_ProcessComplete">
      <bpmn:name>Process Complete</bpmn:name>
      <bpmn:incoming>SequenceFlow_JoinFinal</bpmn:outgoing></bpmn:ParallelGateway_JoinEnd>

  </bpmn:process>
</bpmn:definitions>