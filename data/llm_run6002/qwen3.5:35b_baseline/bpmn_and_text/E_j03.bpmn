<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_WorkAccident_001">
  <bpmn:collaboration id="Collaboration_WorkAccident">
    <bpmn:participant id="Participant_ProcessPool" name="Work Accident Reporting Process" processRef="Process_WorkAccident_001"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_WorkAccident_001" isExecutable="false">
    <bpmn:startEvent id="StartEvent_AccidentOccurs" name="Accident or Incident Occurs">
      <bpmn:description>Covers work accidents, near-misses, risks, and defects</bpmn:description>
      <bpmn:outgoing>SequenceFlow_RecordIncident</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_RecordIncident" name="Record Incident Details">
      <bpmn:name>Record Accident, Near-Miss or Risk</bpmn:name>
      <bpmn:description>Gather information on accident location, time, cause and circumstances</bpmn:description>
      <bpmn:incoming>SequenceFlow_RecordIncident</bpmn:outgoing></bpmn:task>

    <!-- Classification Gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_ClassifyAccident" name="Classify Accident Type">
      <bpmn:name>Determine Insurance Category &amp; Status</bpmn:description>
      <bpmn:incoming>SequenceFlow_RecordIncident</bpmn:outgoing></bpmn:classifyAccident>

    <!-- Lane 1: Insured Person / Student -->
    <bpmn:laneSet id="LaneSet_Insured">
      <bpmn:lane id="Lane_EmployeeStudent" name="Insured Person &amp; Educational Facility">
        <bpmn:flowNodeRef>Task_ReportToEmployer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SchoolReport</bpmn:flowNodeRef>
      </bpmn:lane>

    <!-- Lane 2: Employer / Educational Facility -->
    <bpmn:lane id="Lane_Employer" name="Employer &amp; Educational Institution">
        <bpmn:flowNodeRef>Task_ReportToInspectorate</bpmn:flowNodeRef>
      </bpmn:lane>

    <!-- Lane 3: Authorities -->
    <bpmn:lane id="Lane_Authorities" name="Authorities &amp; Providers">
        <bpmn:flowNodeRef>Task_ReportToInsurance</bpmn:flowNodeRef>
      </bpmn:lane>

    <!-- Flow 1: Employee Reports to Employer -->
    <bpmn:task id="Task_ReportToEmployer" name="Report Accident/Incident">
        <bpmn:name>Inform Employer Immediately</bpmn:description>Covering accidents, near-misses, risks and defects in protection systems</bpmn:description>
      </bpmn:task>

    <!-- Flow 2: School Reports -->
    <bpmn:task id="Task_SchoolReport" name="School Report Accident">
        <bpmn:name>School/University Report to Directorate</bpmn:description>Obliged for students/schoolchildren within max. 5 days if injured/killed</bpmn:description>
      </bpmn:task>

    <!-- Flow 3: Employer Reports -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_SeverityCheck" name="Severity Check">
        <bpmn:name>Fatality or Serious Injury?</bpmn:description>Determine if immediate reporting to Labour Inspectorate is required</bpmn:description>
      </bpmn:task>

    <!-- Flow 4: Reporting Paths -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_ReportingPath" name="Determine Reporting Obligation">
        <bpmn:name>Determine Reporting Path &amp; Deadline</bpmn:description>Routes based on Insurance Type (Employment, Private, Volunteer)</bpmn:description>
      </bpmn:task>

    <!-- Flow 5: Inspectorate Notification -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_Inspectorate" name="Notify Labour Inspectorate">
        <bpmn:name>Report to Labour Inspectorate</bpmn:description>If fatality/serious injury not reported to emergency services, report immediately.</bpmn:description>
      </bpmn:task>

    <!-- Flow 6: Insurance Provider Notification -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_InsuranceProvider" name="Notify Accident Insurance">
        <bpmn:name>Report to Accident Insurance</bpmn:description>Within 5 days for death/injury &gt;3 days or any insured injured/killed by schools.</bpmn:description>
      </bpmn:task>

    <!-- Flow 7: Private Insurer -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_PrivateInsurer" name="Notify Private Insurer">
        <bpmn:name>Report to Private Insurer</bpmn:description>In writing immediately. Within 3 days if fatality.</bpmn:description>
      </bpmn:task>

    <!-- End Events -->
    <bpmn:endEvent id="End_Event_Inspectorate" name="Reported to Inspectorate">
        <bpmn:name>Labour Inspectorate Notified</bpmn:name>
      </bpmn:endEvent>

    <bpmn:endEvent id="End_Event_Provider" name="Insurance Provider Notified">
        <bpmn:name>Accident Insurance Notified</bpmn:name>
      </bpmn:endEvent>

    <bpmn:endEvent id="End_Event_Private" name="Private Insurer Notified">
        <bpmn:name>Private Insurer Notified</bpmn:name>
      </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_RecordIncident" sourceRef="StartEvent_AccidentOccurs" targetRef="Task_ReportToEmployer"/>
    
    <bpmn:exclusiveGateway id="ExclusiveGateway_ClassifyAccident">
      <bpmn:name>Determine Insurance Category</bpmn:description>Check criteria (Work, Home, Commute, Training, Volunteer, Private)</bpmn:description>
      <bpmn:incoming>SequenceFlow_RecordIncident</bpmn:outgoing></bpmn:classifyAccident>

    <!-- Path 1: Standard Employment -->
    <bpmn:sequenceFlow id="SequenceFlow_Employment" sourceRef="ExclusiveGateway_ClassifyAccident" targetRef="Task_ReportToEmployer">
      <bpmn:name>Standard Employee</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Path 2: Education -->
    <bpmn:sequenceFlow id="SequenceFlow_Education" sourceRef="ExclusiveGateway_ClassifyAccident" targetRef="Task_SchoolReport">
      <bpmn:name>Student/Schoolchild</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Path 3: Private/Volunteer -->
    <bpmn:sequenceFlow id="SequenceFlow_PrivateVolunteer" sourceRef="ExclusiveGateway_ClassifyAccident" targetRef="Task_ReportToEmployer">
      <bpmn:name>Private/Other</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- From Employer to Severity Check -->
    <bpmn:sequenceFlow id="SequenceFlow_EmployerCheck" sourceRef="Task_ReportToEmployer" targetRef="ExclusiveGateway_SeverityCheck"/>

    <!-- From School Report -->
    <bpmn:sequenceFlow id="SequenceFlow_SchoolReportOut" sourceRef="Task_SchoolReport" targetRef="ExclusiveGateway_InsuranceProvider">
      <bpmn:name>Within 5 Days</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Severity Check -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_SeverityCheck">
        <bpmn:description>Fatality or Serious Injury?</bpmn:description>
      </bpmn:task>

    <!-- Fatality/Serious -> Inspectorate -->
    <bpmn:sequenceFlow id="SequenceFlow_Inspectorate" sourceRef="ExclusiveGateway_SeverityCheck" targetRef="Task_ReportToInspectorate">
        <bpmn:name>Fatality or Serious Injury</bpmn:name>
      </bpmn:task>

    <!-- Other -> Insurance Provider -->
    <bpmn:sequenceFlow id="SequenceFlow_InsuranceProviderIn" sourceRef="ExclusiveGateway_SeverityCheck" targetRef="Task_ReportToInspectorate">
        <bpmn:name>Injury &gt;3 Days or Death</bpmn:name>
      </bpmn:task>

    <!-- Reporting to Inspectorate -->
    <bpmn:sequenceFlow id="SequenceFlow_InsReport" sourceRef="Task_ReportToInspectorate" targetRef="End_Event_Inspectorate"/>

    <!-- Private/Volunteer Path Logic (Simplified for flow) -->
    <bpmn:task id="Task_PrivateReporting" name="Private Reporting">
        <bpmn:name>Notify Insurer Immediately</bpmn:name>
      </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_PrivateReportIn" sourceRef="ExclusiveGateway_ClassifyAccident" targetRef="Task_PrivateReporting"/>
    
    <!-- Private Reporting Flow -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_FatalityCheck">
        <bpmn:name>Fatality?</bpmn:name>
      </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_PrivateFatality" sourceRef="Task_PrivateReporting" targetRef="End_Event_Private"/>
    
  </bpmn:process>
</bpmn:definitions>