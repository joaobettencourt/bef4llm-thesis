<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_MasterDataChange_v3" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_MasterDataProcess_01">
    <bpmn:participant id="Participant_BusinessUnit" name="Master Data Management Unit" processRef="Proc_MasterDataChange_01" />
  </bpmn:collaboration>

  <bpmn:process id="Proc_MasterDataChange_01" isExecutable="true">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_EC" name="EC (Employee)">
        <bpmn:flowNodeRef>StartEvent_Request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EC_Inform_INQ</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_INQ" name="INQ (Inquiry Officer)">
        <bpmn:flowNodeRef>Task_INQ_Notify_IP</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IP" name="IP (Information Processor)">
        <bpmn:flowNodeRef>Task_IP_CheckTime</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IP_Confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IP_Reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Failure</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Request" name="Request Master Data Change">
      <bpmn:outgoing>SequenceFlow_EC_Inform</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: EC tells INQ -->
    <bpmn:task id="Task_EC_Inform_INQ" name="Tell INQ about change">
      <bpmn:incoming>SequenceFlow_EC_Inform</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Notify_IP</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: INQ notifies IP -->
    <bpmn:task id="Task_INQ_Notify_IP" name="Notify IP of change">
      <bpmn:incoming>SequenceFlow_Notify_IP</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Check_Time</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3: IP checks availability -->
    <bpmn:task id="Task_IP_CheckTime" name="Check change at desired time">
      <bpmn:incoming>SequenceFlow_Check_Time</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_To_Gateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway Decision -->
    <bpmn:exclusiveGateway id="Gateway_Decision">
      <bpmn:incoming>SequenceFlow_To_Gateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Confirm_Path</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_Reject_Path</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Path 1: Confirm -->
    <bpmn:task id="Task_IP_Confirm" name="Confirm changes">
      <bpmn:incoming>SequenceFlow_Confirm_Path</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Success_End</bpmn:outgoing>
    </bpmn:task>

    <!-- Path 2: Reject -->
    <bpmn:task id="Task_IP_Reject" name="Reject changes">
      <bpmn:incoming>SequenceFlow_Reject_Path</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Failure_End</bpmn:outgoing>
    </bpmn:task>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_Success" name="Change Confirmed">
      <bpmn:incoming>SequenceFlow_Success_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_Failure" name="Changes Rejected">
      <bpmn:incoming>SequenceFlow_Failure_End</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_EC_Inform" sourceRef="StartEvent_Request" targetRef="Task_EC_Inform_INQ" />
    
    <bpmn:sequenceFlow id="SequenceFlow_Notify_IP" sourceRef="Task_EC_Inform_INQ" targetRef="Task_INQ_Notify_IP" />

    <bpmn:sequenceFlow id="SequenceFlow_Check_Time" name="Check Result" sourceRef="Task_INQ_Notify_IP" targetRef="Task_IP_CheckTime" />
    
    <bpmn:sequenceFlow id="SequenceFlow_To_Gateway" sourceRef="Task_IP_CheckTime" targetRef="Gateway_Decision">
      <!-- Condition on outgoing flows from Gateway -->
    </bpmn:sequenceFlow>

    <bpmn:exclusiveGateway id="Gateway_Decision"/> 
    <!-- Note: The definition above is the correct one. Ensure no duplicates exist in final output block below. -->

  </bpmn:process>
</bpmn:definitions>