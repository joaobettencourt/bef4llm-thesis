<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_CourtProcess_01" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_CourtDaily_01">
    <bpmn:participant id="Participant_CourtAdmin" name="Court Administration" processRef="Proc_DailyHearingPrep_01" />
  </bpmn:collaboration>

  <bpmn:process id="Proc_DailyHearingPrep_01" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Clerk" name="Clerk">
        <bpmn:flowNodeRef>StartEvent_MorningRoutine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckFiles</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_FilesMissing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InitiateSearch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TrackFilesPhysically</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Associate" name="Judge Support">
        <bpmn:flowNodeRef>InclusiveGateway_FilesReadyJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_SplitHanding</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HandFilesToAssociate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DistributeLawlist</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_JoinHearingStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConductDirectionsHearings</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_HearingConcluded</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_MorningRoutine" name="Morning Routine">
      <bpmn:outgoing>SequenceFlow_InitCheck</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Check Files -->
    <bpmn:task id="Task_CheckFiles" name="Check files for court hearing">
      <bpmn:incoming>SequenceFlow_InitCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToMissingGateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Decision on Files -->
    <bpmn:inclusiveGateway id="InclusiveGateway_FilesMissing">
      <bpmn:incoming>SequenceFlow_ToMissingGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SearchPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_TrackPath</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Task 2A: Search (If Missing) -->
    <bpmn:task id="Task_InitiateSearch" name="Initiate search for missing files">
      <bpmn:incoming>SequenceFlow_SearchPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToReadyJoin</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2B: Track (If Not Missing) -->
    <bpmn:task id="Task_TrackFilesPhysically" name="Track files to intended location">
      <bpmn:incoming>SequenceFlow_TrackPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToReadyJoin2</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2: Convergence (Files Ready) -->
    <bpmn:inclusiveGateway id="InclusiveGateway_FilesReadyJoin">
      <bpmn:incoming>SequenceFlow_ToReadyJoin</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ToReadyJoin2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FromReadyJoin</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Parallel Split for Handing & Distribution -->
    <bpmn:parallelGateway id="ParallelGateway_SplitHanding">
      <bpmn:incoming>SequenceFlow_FromReadyJoin</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_HandFilesPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_DistributeLawlistPath</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 3A: Hand Files -->
    <bpmn:task id="Task_HandFilesToAssociate" name="Hand files to Associate">
      <bpmn:incoming>SequenceFlow_HandFilesPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToHearingJoin1</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3B: Distribute Lawlist -->
    <bpmn:task id="Task_DistributeLawlist" name="Distribute Judges Lawlist">
      <bpmn:incoming>SequenceFlow_DistributeLawlistPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToHearingJoin2</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 3: Synchronization before Hearing -->
    <bpmn:parallelGateway id="ParallelGateway_JoinHearingStart">
      <bpmn:incoming>SequenceFlow_ToHearingJoin1</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ToHearingJoin2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FromJoin</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 4: Conduct Hearings -->
    <bpmn:task id="Task_ConductDirectionsHearings" name="Conduct directions hearings">
      <bpmn:incoming>SequenceFlow_FromJoin</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToEndEvent</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_HearingConcluded" name="Hearing Concluded">
      <bpmn:incoming>SequenceFlow_ToEndEvent</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_InitCheck" sourceRef="StartEvent_MorningRoutine" targetRef="Task_CheckFiles" />
    
    <bpmn:sequenceFlow id="SequenceFlow_ToMissingGateway" sourceRef="Task_CheckFiles" targetRef="InclusiveGateway_FilesMissing" />

    <bpmn:sequenceFlow id="SequenceFlow_SearchPath" name="If missing" sourceRef="InclusiveGateway_FilesMissing" targetRef="Task_InitiateSearch" />
    
    <bpmn:sequenceFlow id="SequenceFlow_TrackPath" name="Otherwise" sourceRef="InclusiveGateway_FilesMissing" targetRef="Task_TrackFilesPhysically" />

    <!-- Convergence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_ToReadyJoin" sourceRef="Task_InitiateSearch" targetRef="InclusiveGateway_FilesReadyJoin" />
    
    <bpmn:sequenceFlow id="SequenceFlow_ToReadyJoin2" name="" sourceRef="Task_TrackFilesPhysically" targetRef="InclusiveGateway_FilesReadyJoin" />

    <!-- Split Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_FromReadyJoin" sourceRef="InclusiveGateway_FilesReadyJoin" targetRef="ParallelGateway_SplitHanding" />

    <bpmn:sequenceFlow id="SequenceFlow_HandFilesPath" name="" sourceRef="ParallelGateway_SplitHanding" targetRef="Task_HandFilesToAssociate" />
    
    <bpmn:sequenceFlow id="SequenceFlow_DistributeLawlistPath" name="Meantime" sourceRef="ParallelGateway_SplitHanding" targetRef="Task_DistributeLawlist" />

    <!-- Join Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_ToHearingJoin1" sourceRef="Task_HandFilesToAssociate" targetRef="ParallelGateway_JoinHearingStart" />
    
    <bpmn:sequenceFlow id="SequenceFlow_ToHearingJoin2" name="" sourceRef="Task_DistributeLawlist" targetRef="ParallelGateway_JoinHearingStart" />

    <!-- Final Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_FromJoin" sourceRef="ParallelGateway_JoinHearingStart" targetRef="Task_ConductDirectionsHearings" />
    
    <bpmn:sequenceFlow id="SequenceFlow_ToEndEvent" name="" sourceRef="Task_ConductDirectionsHearings" targetRef="EndEvent_HearingConcluded" />

  </bpmn:process>
</bpmn:definitions>