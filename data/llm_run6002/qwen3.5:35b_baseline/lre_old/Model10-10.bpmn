<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_FaultManagement_01" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_FaultProcess_01">
    <bpmn:participant id="Participant_UserOps" name="Fault Management Process" processRef="Proc_FaultManagement_01" />
  </bpmn:collaboration>

  <bpmn:process id="Proc_FaultManagement_01" isExecutable="true">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Operator" name="Operator/User">
        <bpmn:flowNodeRef>StartEvent_ReportFailure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExamineFailure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DecisionFault</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InitialNotification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FixFault</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ShareResultsDetector</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ResolutionCustomer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ResolutionManager</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Complete</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_ReportFailure" name="Failure Report / Suspicion">
      <bpmn:outgoing>Flow_StartToExamine</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1 -->
    <bpmn:task id="Task_ExamineFailure" name="Examine failure">
      <bpmn:incoming>Flow_StartToExamine</bpmn:incoming>
      <bpmn:outgoing>Flow_ExamineToDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway -->
    <bpmn:exclusiveGateway id="Gateway_DecisionFault" name="Confirm Fault?">
      <bpmn:incoming>Flow_ExamineToDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_DecisionReject</bpmn:outgoing>
      <bpmn:outgoing>Flow_DecisionConfirm</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Reject Path -->
    <bpmn:endEvent id="EndEvent_Rejected" name="Rejected">
      <bpmn:incoming>Flow_DecisionReject</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Confirm Path Tasks -->
    <bpmn:task id="Task_InitialNotification" name="Inform Customer &amp; Manager about failure">
      <bpmn:incoming>Flow_DecisionConfirm</bpmn:incoming>
      <bpmn:outgoing>Flow_NotificationToFix</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_FixFault" name="Fix fault at measuring device">
      <bpmn:incoming>Flow_NotificationToFix</bpmn:incoming>
      <bpmn:outgoing>Flow_FixToShare</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_ShareResultsDetector" name="Share results with fault detector">
      <bpmn:incoming>Flow_FixToShare</bpmn:incoming>
      <bpmn:outgoing>Flow_ShareToResolCust</bpmn:outgoing>
    </bpmn:task>

    <!-- Resolution Notifications -->
    <bpmn:task id="Task_ResolutionCustomer" name="Inform Customer about resolution">
      <bpmn:incoming>Flow_ShareToResolCust</bpmn:incoming>
      <bpmn:outgoing>Flow_ResolCustToMgr</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_ResolutionManager" name="Inform Manager about resolution">
      <bpmn:incoming>Flow_ResolCustToMgr</bpmn:incoming>
      <bpmn:outgoing>Flow_MgrToEnd</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Complete" name="Resolution Reported">
      <bpmn:incoming>Flow_MgrToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Flow_StartToExamine" sourceRef="StartEvent_ReportFailure" targetRef="Task_ExamineFailure" />
    
    <bpmn:sequenceFlow id="Flow_ExamineToDecision" sourceRef="Task_ExamineFailure" targetRef="Gateway_DecisionFault" />

    <bpmn:sequenceFlow id="Flow_DecisionReject" name="No/Rejected" sourceRef="Gateway_DecisionFault" targetRef="EndEvent_Rejected">
      <!-- Condition omitted for brevity, implied by flow -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_DecisionConfirm" name="Yes/Confirmed" sourceRef="Gateway_DecisionFault" targetRef="Task_InitialNotification" />

    <bpmn:sequenceFlow id="Flow_NotificationToFix" sourceRef="Task_InitialNotification" targetRef="Task_FixFault" />
    
    <bpmn:sequenceFlow id="Flow_FixToShare" sourceRef="Task_FixFault" targetRef="Task_ShareResultsDetector" />

    <bpmn:sequenceFlow id="Flow_ShareToResolCust" sourceRef="Task_ShareResultsDetector" targetRef="Task_ResolutionCustomer" />
    
    <bpmn:sequenceFlow id="Flow_ResolCustToMgr" sourceRef="Task_ResolutionCustomer" targetRef="Task_ResolutionManager" />

    <bpmn:sequenceFlow id="Flow_MgrToEnd" sourceRef="Task_ResolutionManager" targetRef="EndEvent_Complete" />
  </bpmn:process>
</bpmn:definitions>