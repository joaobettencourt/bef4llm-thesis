<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_ClaimHandling_01" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_ClaimProcess_01">
    <bpmn:participant id="Participant_ClaimsDept" name="Claims Department" processRef="Proc_ClaimHandling_01" />
  </bpmn:collaboration>

  <bpmn:process id="Proc_ClaimHandling_01" isExecutable="true">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_ClaimsOfficer" name="Claims Officer">
        <bpmn:flowNodeRef>StartEvent_ClaimRegistered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExamineClaim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WriteRecommendation</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SeniorOfficer" name="Senior Claims Officer">
        <bpmn:flowNodeRef>Task_CheckRecommendation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_DecisionCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ProcessProceeds</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_ClaimRegistered" name="Claim Registered">
      <bpmn:outgoing>SequenceFlow_InitExamination</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Examine Claim (Claims Officer) -->
    <bpmn:task id="Task_ExamineClaim" name="Examine claim">
      <bpmn:incoming>SequenceFlow_InitExamination</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PrepareRecommendation</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: Write Recommendation (Claims Officer) -->
    <bpmn:task id="Task_WriteRecommendation" name="Write settlement recommendation">
      <bpmn:incoming>SequenceFlow_PrepareRecommendation</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_RepeatRecommendation</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SubmitForCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3: Check Recommendation (Senior Claims Officer) -->
    <bpmn:task id="Task_CheckRecommendation" name="Check recommendation">
      <bpmn:incoming>SequenceFlow_SubmitForCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToDecisionGateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Decision (Senior Claims Officer) -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_DecisionCheck" name="Claim OK?">
      <bpmn:incoming>SequenceFlow_ToDecisionGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ApprovedPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RejectedPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_ProcessProceeds" name="Process proceeds">
      <bpmn:incoming>SequenceFlow_ApprovedPath</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_InitExamination" sourceRef="StartEvent_ClaimRegistered" targetRef="Task_ExamineClaim" />
    
    <bpmn:sequenceFlow id="SequenceFlow_PrepareRecommendation" name="OK to write rec" sourceRef="Task_ExamineClaim" targetRef="Task_WriteRecommendation" />

    <bpmn:sequenceFlow id="SequenceFlow_SubmitForCheck" sourceRef="Task_WriteRecommendation" targetRef="Task_CheckRecommendation" />
    
    <bpmn:sequenceFlow id="SequenceFlow_ToDecisionGateway" name="Ready for check" sourceRef="Task_CheckRecommendation" targetRef="ExclusiveGateway_DecisionCheck" />

    <!-- Decision Paths -->
    <bpmn:sequenceFlow id="SequenceFlow_ApprovedPath" name="OK" sourceRef="ExclusiveGateway_DecisionCheck" targetRef="EndEvent_ProcessProceeds" />
    
    <bpmn:sequenceFlow id="SequenceFlow_RejectedPath" name="Not OK" sourceRef="ExclusiveGateway_DecisionCheck" targetRef="Task_WriteRecommendation" />

  </bpmn:process>
</bpmn:definitions>