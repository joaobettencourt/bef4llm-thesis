<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:message name="BidRequestMessage"/>
  <bpmn:message name="TenderMessage"/>
  <bpmn:message name="OrderMessage"/>
  <bpmn:message name="ConfirmationMessage"/>

  <bpmn:collaboration id="Collab_DeviceTakeover_1">
    <bpmn:participant id="Participant_MPON" name="MPON" processRef="Process_MPON_01"/>
    <bpmn:participant id="Participant_MPOO" name="MPOO" processRef="Process_MPOO_02"/>

    <!-- Message Flows -->
    <bpmn:messageFlow id="MessageFlow_BidRequest" sourceRef="Task_MPON_RequestBid" targetRef="StartEvent_MPOO_RequestReceived">
      <bpmn:name>Device Takeover Bid Request</bpmn:name>
    </bpmn:messageFlow>

    <bpmn:messageFlow id="MessageFlow_TenderResponse" sourceRef="Task_MPOO_SendTender" targetRef="StartEvent_MPON_TenderReceived">
      <bpmn:name>Tender for Equipment Takeover</bpmn:name>
    </bpmn:messageFlow>

    <bpmn:messageFlow id="MessageFlow_OrderPlacement" sourceRef="Task_MPON_PlaceOrder" targetRef="StartEvent_MPOO_OrderReceived">
      <bpmn:name>Purchase Order</bpmn:name>
    </bpmn:messageFlow>

    <bpmn:messageFlow id="MessageFlow_ConfirmationData" sourceRef="Task_MPOO_Confirm" targetRef="EndEvent_MPON_Complete">
      <bpmn:name>Order Confirmation and Master Data</bpmn:name>
    </bpmn:messageFlow>

  </bpmn:collaboration>

  <!-- MPON Process -->
  <bpmn:process id="Process_MPON_01" isExecutable="true">
    <bpmn:startEvent id="StartEvent_MPON_InitiateRequest" name="Initiate Takeover Request">
      <bpmn:outgoing>SequenceFlow_RequestBid</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_MPON_RequestBid" name="Request device takeover bid">
      <bpmn:incoming>SequenceFlow_RequestBid</bpmn:incoming>
      <bpmn:outgoing>MessageFlow_BidRequest</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Catch Event for Tender Response -->
    <bpmn:startEvent id="StartEvent_MPON_TenderReceived" name="Receive Tender">
      <bpmn:incoming>SequenceFlow_ProcessTender</bpmn:incoming>
      <bpmn:outgoing>MessageFlow_OrderPlacement</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Intermediate Catch Event for Order Confirmation -->
    <bpmn:endEvent id="EndEvent_MPON_Complete" name="Order Complete">
      <bpmn:incoming>SequenceFlow_FinalizeMPON</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow_RequestBid" sourceRef="StartEvent_MPON_InitiateRequest" targetRef="Task_MPON_RequestBid"/>
    
  </bpmn:process>

  <!-- MPOO Process -->
  <bpmn:process id="Process_MPOO_02" isExecutable="true">
    <!-- Start Event triggered by MPON Request (via Message Flow) -->
    <bpmn:startEvent id="StartEvent_MPOO_RequestReceived" name="Receive Bid Request">
      <bpmn:incoming>SequenceFlow_ProcessRequest</bpmn:incoming>
      <bpmn:outgoing>MessageFlow_TenderResponse</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Intermediate Catch Event for Order -->
    <bpmn:startEvent id="StartEvent_MPOO_OrderReceived" name="Receive Order">
      <bpmn:incoming>SequenceFlow_ProcessOrder</bpmn:incoming>
      <bpmn:outgoing>MessageFlow_ConfirmationData</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- End Event for MPOO -->
    <bpmn:endEvent id="EndEvent_MPOO_Complete" name="Process Complete">
      <bpmn:incoming>SequenceFlow_FinalizeMPOO</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Tasks within the process flow (simplified for message-based interaction) -->
    <bpmn:task id="Task_MPOO_SendTender" name="Send tender for equipment takeover">
      <bpmn:outgoing>MessageFlow_TenderResponse</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_MPOO_Confirm" name="Confirm order and send master data">
      <bpmn:incoming>SequenceFlow_ProcessOrder</bpmn:incoming>
      <bpmn:outgoing>MessageFlow_ConfirmationData</bpmn:outgoing>
    </bpmn:task>

  </bpmn:process>

  <!-- Sequence Flows within MPON Process -->
  <bpmn:sequenceFlow id="SequenceFlow_ProcessTender" sourceRef="StartEvent_MPON_TenderReceived" targetRef="Task_MPON_PlaceOrder"/>
  
  <!-- Sequence Flow for Order Confirmation to End Event -->
  <bpmn:sequenceFlow id="SequenceFlow_FinalizeMPON" sourceRef="EndEvent_MPON_Complete" targetRef="EndEvent_MPON_Complete">
    <bpmn:name>Confirmation Received</bpmn:name>
  </bpmn:sequenceFlow>

  <!-- Sequence Flows within MPOO Process -->
  <bpmn:sequenceFlow id="SequenceFlow_ProcessRequest" sourceRef="StartEvent_MPOO_RequestReceived" targetRef="Task_MPOO_SendTender"/>
  
  <bpmn:sequenceFlow id="SequenceFlow_ProcessOrder" sourceRef="StartEvent_MPOO_OrderReceived" targetRef="Task_MPOO_Confirm"/>

</bpmn:definitions>