<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_MeterPointProcess_01" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_GO_Process_01">
    <bpmn:participant id="Participant_GridOperator" name="Grid Operator (GO)" processRef="Proc_MeterPointDeregistration_01" />
  </bpmn:collaboration>

  <bpmn:process id="Proc_MeterPointDeregistration_01" isExecutable="true">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_GridOperator" name="Grid Operator">
        <bpmn:flowNodeRef>StartEvent_DeregistrationRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_DecisionVerification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VerifyDeregistration</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_CheckObligation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareReadmission</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ProcessComplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_MergeObligation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConfirmContinuation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EquipmentAcquisitionChanges</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssignGOasMPO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyMP00AssignmentChange</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyMSPOAssignment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifySPAssignment</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_DeregistrationRequest" name="Deregistration Request by MPOO">
      <bpmn:outgoing>SequenceFlow_InitProcess</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1 -->
    <bpmn:task id="Task_VerifyDeregistration" name="Verify Deregistration of MPOO">
      <bpmn:incoming>SequenceFlow_InitProcess</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DecisionVerification</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1 -->
    <bpmn:inclusiveGateway id="InclusiveGateway_DecisionVerification">
      <bpmn:incoming>SequenceFlow_DecisionVerification</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RejectPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ConfirmReadmissionPath</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- End Event 1 (Reject) -->
    <bpmn:endEvent id="EndEvent_Rejected" name="Deregistration Rejected">
      <bpmn:incoming>SequenceFlow_RejectPath</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task 2 -->
    <bpmn:task id="Task_PrepareReadmission" name="Prepare Readmission of Measuring Point">
      <bpmn:incoming>SequenceFlow_ConfirmReadmissionPath</bpmn:outgoing>
       <bpmn:outgoing>SequenceFlow_CheckObligationPrep</bpmn:outgoing>
    </bpmn:task>

     <!-- Gateway 2 (Optional Obligation) -->
    <bpmn:inclusiveGateway id="InclusiveGateway_CheckObligation">
      <bpmn:incoming>SequenceFlow_CheckObligationPrep</bpmn:outgoing>
       <bpmn:outgoing>SequenceFlow_ObligedPath</bvmn:outgoing>
       <bpmn:outgoing>SequenceFlow_NoObligationPath</bpmn:outgoing>
    </bpmn:inclusiveGateway>

     <!-- Task 3 (Confirmation) -->
    <bpmn:task id="Task_ConfirmContinuation" name="Receive Confirmation of Continuation from MPOO">
      <bpmn:incoming>SequenceFlow_ObligedPath</bvmn:outgoing>
       <bpmn:outgoing>SequenceFlow_MergeAfterConfirmation</bpmn:outgoing>
    </bpmn:task>

     <!-- Merge Point for Obligation Path -->
    <bpmn:inclusiveGateway id="InclusiveGateway_MergeObligation">
      <bpmn:incoming>SequenceFlow_NoObligationPath</bvmn:outgoing>
       <bpmn:incoming>SequenceFlow_MergeAfterConfirmation</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow_EquipmentAcquisitionStart</bpmn:outgoing>
    </bpmn:inclusiveGateway>

     <!-- Task 4 -->
    <bpmn:task id="Task_EquipmentAcquisitionChanges" name="Perform Equipment Acquisition and/or Changes">
      <bpmn:incoming>SequenceFlow_EquipmentAcquisitionStart</bvmn:outgoing>
       <bpmn:outgoing>SequenceFlow_AssignMPOStart</bpmn:outgoing>
    </bpmn:task>

     <!-- Task 5 -->
    <bpmn:task id="Task_AssignGOasMPO" name="Assign GO as MPO">
      <bpmn:incoming>SequenceFlow_AssignMPOStart</bvmn:outgoing>
       <bpmn:outgoing>SequenceFlow_NotifyMP00Start</bpmn:outgoing>
    </bpmn:task>

     <!-- Task 6 -->
    <bpmn:task id="Task_NotifyMP00AssignmentChange" name="Inform MPOO about Assignment Change">
      <bpmn:incoming>SequenceFlow_NotifyMP00Start</bvmn:outgoing>
       <bpmn:outgoing>SequenceFlow_NotifyMSPOStart</bpmn:outgoing>
    </bpmn:task>

     <!-- Task 7 -->
    <bpmn:task id="Task_NotifyMSPOAssignment" name="Inform MSPO about Assignment of GO">
      <bpmn:incoming>SequenceFlow_NotifyMSPOStart</bvmn:outgoing>
       <bpmn:outgoing>SequenceFlow_NotifySPStart</bpmn:outgoing>
    </bpmn:task>

     <!-- Task 8 -->
    <bpmn:task id="Task_NotifySPAssignment" name="Inform SP about Assignment of GO">
      <bpmn:incoming>SequenceFlow_NotifySPStart</bvmn:outgoing>
       <bpmn:outgoing>SequenceFlow_FinalizeProcess</bpmn:outgoing>
    </bpmn:task>

     <!-- End Event 2 -->
    <bpmn:endEvent id="EndEvent_ProcessComplete" name="Assignment Complete">
      <bpmn:incoming>SequenceFlow_FinalizeProcess</bpmn:outgoing>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_InitProcess" sourceRef="StartEvent_DeregistrationRequest" targetRef="Task_VerifyDeregistration" />
    
    <bpmn:exclusiveGateway id="InclusiveGateway_DecisionVerification">
      <bpmn:incoming>SequenceFlow_DecisionVerification</bvmn:outgoing>
       <!-- Correcting ID reference in thought block to match definition -->
    </bpmn:inclusiveGateway>

     <bpmn:sequenceFlow id="SequenceFlow_InitProcess" sourceRef="StartEvent_DeregistrationRequest" targetRef="Task_VerifyDeregistration">
      <!-- Duplicate check logic applied below for unique IDs -->
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>