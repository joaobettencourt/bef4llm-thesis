<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_IPO_Process_01" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_IPO_01">
    <bpmn:participant id="Participant_IPOProcess" name="IPO Process (Company &amp; Underwriters)" processRef="Proc_IPO_01" />
  </bpmn:collaboration>

  <bpmn:process id="Proc_IPO_01" isExecutable="true">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_CompanyManagement" name="Company Management">
        <bpmn:flowNodeRef>StartEvent_DecisionToGoPublic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectUnderwriters</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Underwriters" name="Investment Bankers / Underwriters">
        <bpmn:flowNodeRef>InclusiveGateway_FactsFairlyPresented</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareRegistrationStatement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_SplitWaitAndRoadshow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateCatchEvent_SECApprovalReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_MergeBeforeFixPrice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckBlueSkyLaws</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ArrangeRoadShow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FirmUpPriceEstimate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_RiskCheckBeforeOffer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_IPOCancelled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterFirmCommitmentAndOfferPublic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_IPOSuccessful</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_DecisionToGoPublic" name="Decision to Go Public">
      <bpmn:outgoing>SequenceFlow_SelectUnderwriters</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Select Underwriters -->
    <bpmn:task id="Task_SelectUnderwriters" name="Select the underwriters">
      <bpmn:incoming>SequenceFlow_SelectUnderwriters</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckFactsFairly</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Facts Fair? -->
    <bpmn:inclusiveGateway id="InclusiveGateway_FactsFairlyPresented" name="Facts Presented Fairly">
      <bpmn:incoming>SequenceFlow_CheckFactsFairly</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PrepareRegistrationStatement</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Task: Prepare Registration Statement -->
    <bpmn:task id="Task_PrepareRegistrationStatement" name="Prepare registration statement for SEC">
      <bpmn:incoming>SequenceFlow_PrepareRegistrationStatement</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SplitWaitAndRoadshow</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway Split -->
    <bpmn:parallelGateway id="ParallelGateway_SplitWaitAndRoadshow">
      <bpmn:incoming>SequenceFlow_SplitWaitAndRoadshow</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitSECApproval</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CheckBlueSkyLaws</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Path 1: Wait for SEC -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_SECApprovalReceived" name="SEC Clearance Received">
      <bpmn:incoming>SequenceFlow_WaitSECApproval</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeBeforeFixPrice</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Path 2: Roadshow & Compliance -->
    <bpmn:task id="Task_CheckBlueSkyLaws" name="Check Blue-Sky Laws compliance">
      <bpmn:incoming>SequenceFlow_CheckBlueSkyLaws</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ArrangeRoadShow</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Arrange Road Show -->
    <bpmn:task id="Task_ArrangeRoadShow" name="Arrange road show">
      <bpmn:incoming>SequenceFlow_ArrangeRoadShow</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FirmUpPriceEstimate</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Firm Up Price Estimate -->
    <bpmn:task id="Task_FirmUpPriceEstimate" name="Firm up issue price (estimate)">
      <bpmn:incoming>SequenceFlow_FirmUpPriceEstimate</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeBeforeFixPrice</bpmn:outgoing>
    </bpmn:task>

    <!-- Merge Gateway -->
    <bpmn:parallelGateway id="InclusiveGateway_MergeBeforeFixPrice">
      <bpmn:incoming>SequenceFlow_WaitSECApproval</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_FirmUpPriceEstimate</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FinalizeIssuePrice</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Fix Issue Price -->
    <bpmn:task id="Task_FixFinalIssuePrice" name="Fix the issue price">
      <bpmn:incoming>SequenceFlow_FinalizeIssuePrice</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RiskCheckBeforeOffer</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Risk Check -->
    <bpmn:exclusiveGateway id="InclusiveGateway_RiskCheckBeforeOffer" name="Reason Not To Proceed?">
      <bpmn:incoming>SequenceFlow_RiskCheckBeforeOffer</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CancelIPO</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_EnterCommitmentAndOfferPublic</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event: Cancelled -->
    <bpmn:endEvent id="EndEvent_IPOCancelled" name="IPO Cancelled">
      <bpmn:incoming>SequenceFlow_CancelIPO</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task: Offer Public -->
    <bpmn:task id="Task_EnterFirmCommitmentAndOfferPublic" name="Enter firm commitment &amp; offer to public">
      <bpmn:incoming>SequenceFlow_EnterCommitmentAndOfferPublic</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_IPOSuccessfulEnd</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event: Successful -->
    <bpmn:endEvent id="EndEvent_IPOSuccessful" name="IPO Complete">
      <bpmn:incoming>SequenceFlow_IPOSuccessfulEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_SelectUnderwriters" sourceRef="StartEvent_DecisionToGoPublic" targetRef="Task_SelectUnderwriters">
      <bpmn:name>Select Underwriters</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_CheckFactsFairly" sourceRef="Task_SelectUnderwriters" targetRef="InclusiveGateway_FactsFairlyPresented">
      <bpmn:name>Fair Facts?</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_PrepareRegistrationStatement" sourceRef="InclusiveGateway_FactsFairlyPresented" targetRef="Task_PrepareRegistrationStatement">
      <bpmn:name>Fair Facts (Yes)</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_SplitWaitAndRoadshow" sourceRef="Task_PrepareRegistrationStatement" targetRef="ParallelGateway_SplitWaitAndRoadshow">
      <bpmn:name>Submit to SEC</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_WaitSECApproval" sourceRef="ParallelGateway_SplitWaitAndRoadshow" targetRef="IntermediateCatchEvent_SECApprovalReceived">
      <bpmn:name>Awaiting SEC Approval</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_CheckBlueSkyLaws" sourceRef="ParallelGateway_SplitWaitAndRoadshow" targetRef="Task_CheckBlueSkyLaws">
      <bpmn:name>Check Blue-Sky Laws</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ArrangeRoadShow" sourceRef="Task_CheckBlueSkyLaws" targetRef="Task_ArrangeRoadShow">
      <bpmn:name>Road Show</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_FirmUpPriceEstimate" sourceRef="Task_ArrangeRoadShow" targetRef="Task_FirmUpPriceEstimate">
      <bpmn:name>Firm Up Price</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_MergeBeforeFixPrice" sourceRef="IntermediateCatchEvent_SECApprovalReceived" targetRef="InclusiveGateway_MergeBeforeFixPrice">
      <bpmn:name>SEC Clearance</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_FinalizeIssuePrice" sourceRef="InclusiveGateway_MergeBeforeFixPrice" targetRef="Task_FixFinalIssuePrice">
      <bpmn:name>Proceed to Fix Price</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_RiskCheckBeforeOffer" sourceRef="Task_FixFinalIssuePrice" targetRef="InclusiveGateway_RiskCheckBeforeOffer">
      <bpmn:name>Risk Check</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_CancelIPO" sourceRef="InclusiveGateway_RiskCheckBeforeOffer" targetRef="EndEvent_IPOCancelled">
      <bpmn:name>Reason Not To Proceed</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_EnterCommitmentAndOfferPublic" sourceRef="InclusiveGateway_RiskCheckBeforeOffer" targetRef="Task_EnterFirmCommitmentAndOfferPublic">
      <bpmn:name>No Reason Not To Proceed</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_IPOSuccessfulEnd" sourceRef="Task_EnterFirmCommitmentAndOfferPublic" targetRef="EndEvent_IPOSuccessful">
      <bpmn:name>IPO Complete</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>