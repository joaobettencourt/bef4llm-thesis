<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1">
  <bpmn:message id="Message_OrderRequest"/>
  <bpmn:collaboration id="Collab_PurchaseOrder">
    <bpmn:participant id="Pool_AssemblerAG" name="Assembler AG" processRef="Proc_Assembler_01"/>
    <bpmn:participant id="Pool_Supplier" name="Supplier Company" processRef="Proc_Supplier_01"/>
  </bpmn:collaboration>

  <!-- Assembler Process -->
  <bpmn:process id="Proc_Assembler_01">
    <bpmn:startEvent id="Start_TimerMonthly_Ag">
      <bpmn:name>New Order Request</bpmn:name>
      <bpmn:timerDefinition xsi:type="bpmn:TimeCycle" timeCycle="R/MT-01"/>
      <bpmn:outgoing>Seq_PlaceOrder_Ag</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_PlaceOrder_Ag">
      <bpmn:name>Place Order with Supplier</bpmn:name>
      <bpmn:incoming>Seq_PlaceOrder_Ag</bpmn:incoming>
      <bpmn:outgoing>Seq_WaitInvoice_Ag</bpmn:outgoing>
    </bpmn:task>

    <bpmn:intermediateCatchEvent id="Event_CatchInvoice_Ag">
      <bpmn:name>Wait for Invoice</bpmn:name>
      <bpmn:messageRef>Message_InvoiceNotification</bpmn:messageRef>
      <bpmn:incoming>Seq_WaitInvoice_Ag</bpmn:incoming>
      <bpmn:outgoing>Seq_CompleteOrder_Ag</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:endEvent id="End_OrderComplete_Ag">
      <bpmn:name>Purchase Complete</bpmn:name>
      <bpmn:incoming>Seq_CompleteOrder_Ag</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Seq_PlaceOrder_Ag" sourceRef="Start_TimerMonthly_Ag" targetRef="Task_PlaceOrder_Ag"/>
    <bpmn:sequenceFlow id="Seq_WaitInvoice_Ag" sourceRef="Task_PlaceOrder_Ag" targetRef="Event_CatchInvoice_Ag"/>
    <bpmn:sequenceFlow id="Seq_CompleteOrder_Ag" sourceRef="Event_CatchInvoice_Ag" targetRef="End_OrderComplete_Ag"/>

  </bpmn:process>

  <!-- Supplier Process -->
  <bpmn:process id="Proc_Supplier_01">
    <bpmn:startEvent id="Start_MessageOrderSupp">
      <bpmn:name>Order Received</bpmn:name>
      <bpmn:messageRef>Message_OrderRequest</bpmn:messageRef>
      <bpmn:outgoing>Seq_ProcessOrder_Supp</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_ProcessOrder_Supp">
      <bpmn:name>Process Order</bpmn:name>
      <bpmn:incoming>Seq_ProcessOrder_Supp</bpmn:incoming>
      <bpmn:outgoing>Seq_SendInvoiceSupp</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="End_InvoiceSent_Supp">
      <bpmn:name>Invoice Sent</bpmn:name>
      <bpmn:incoming>Seq_SendInvoiceSupp</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Seq_ProcessOrder_Supp" sourceRef="Start_MessageOrderSupp" targetRef="Task_ProcessOrder_Supp"/>
    <bpmn:sequenceFlow id="Seq_SendInvoiceSupp" sourceRef="Task_ProcessOrder_Supp" targetRef="End_InvoiceSent_Supp"/>

  </bpmn:process>

</bpmn:definitions>