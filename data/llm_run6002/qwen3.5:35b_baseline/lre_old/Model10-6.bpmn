<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_DismissalProcess_01" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_Dismissal_01">
    <bpmn:participant id="Participant_DismissalProcess" name="Dismissal Process Management" processRef="Proc_Dismissal_01" />
  </bpmn:collaboration>

  <bpmn:process id="Proc_Dismissal_01" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_MSPN" name="MSPN">
        <bpmn:flowNodeRef>StartEvent_InitiateDismissal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendDismissalToMSPO</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_MSPO" name="MSPO">
        <bpmn:flowNodeRef>InclusiveGateway_DecisionOutcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewDismissalOfMSPN</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_DismissalRejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_DismissalConfirmed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_InitiateDismissal" name="Initiate Dismissal">
      <bpmn:outgoing>SequenceFlow_SendToMSPO</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: MSPN sends dismissal -->
    <bpmn:task id="Task_SendDismissalToMSPO" name="Send dismissal to MSPO">
      <bpmn:incoming>SequenceFlow_SendToMSPO</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReviewByMSPO</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: MSPO reviews dismissal -->
    <bpmn:task id="Task_ReviewDismissalOfMSPN" name="Review dismissal of the MSPN">
      <bpmn:incoming>SequenceFlow_ReviewByMSPO</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DecideOutcome</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for Decision -->
    <bpmn:exclusiveGateway id="InclusiveGateway_DecisionOutcome" name="Dismissal Outcome">
      <bpmn:incoming>SequenceFlow_DecideOutcome</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RejectPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ConfirmPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event 1: Rejection -->
    <bpmn:endEvent id="EndEvent_DismissalRejected" name="Dismissal Rejected">
      <bpmn:incoming>SequenceFlow_RejectPath</bpmn:incoming>
    </bpmn:endEvent>

    <!-- End Event 2: Confirmation -->
    <bpmn:endEvent id="EndEvent_DismissalConfirmed" name="Dismissal Confirmed">
      <bpmn:incoming>SequenceFlow_ConfirmPath</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_SendToMSPO" sourceRef="StartEvent_InitiateDismissal" targetRef="Task_SendDismissalToMSPO">
      <bpmn:name>Sends dismissal</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ReviewByMSPO" sourceRef="Task_SendDismissalToMSPO" targetRef="Task_ReviewDismissalOfMSPN">
      <bpmn:name>To MSPO</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_DecideOutcome" sourceRef="Task_ReviewDismissalOfMSPN" targetRef="InclusiveGateway_DecisionOutcome">
      <bpmn:name>After review</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_RejectPath" sourceRef="InclusiveGateway_DecisionOutcome" targetRef="EndEvent_DismissalRejected">
      <bpmn:name>Rejects dismissal</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ConfirmPath" sourceRef="InclusiveGateway_DecisionOutcome" targetRef="EndEvent_DismissalConfirmed">
      <bpmn:name>Confirms dismissal</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>