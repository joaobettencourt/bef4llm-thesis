<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_RoomService_01" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_RoomService_01">
    <bpmn:participant id="Participant_RoomServiceDept" name="Room Service Department" processRef="Process_RoomService_01" />
  </bpmn:collaboration>

  <bpmn:process id="Process_RoomService_01" isExecutable="true">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Manager" name="Room Service Manager">
        <bpmn:flowNodeRef>StartEvent_GuestCall</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TakeOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CheckAlcohol</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Kitchen" name="Kitchen Staff">
        <bpmn:flowNodeRef>Task_PrepareFood</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sommelier" name="Sommelier">
        <bpmn:flowNodeRef>Task_FetchWineAlcohol</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Waiter" name="Waiter">
        <bpmn:flowNodeRef>Task_AssignOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReadyCartNonAlc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SynchronizePrep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DeliverToGuest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReturnStation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CheckBilling</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DebitAccount</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_GuestCall" name="Guest Calls Room Service">
      <bpmn:outgoing>SequenceFlow_TakeOrder</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Manager Tasks & Decision -->
    <bpmn:task id="Task_TakeOrder" name="Take Down Order Details">
      <bpmn:incoming>SequenceFlow_TakeOrder</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckAlcohol</bpmn:outgoing>
    </bpmn:task>

    <!-- Decision Point for Alcohol -->
    <bpmn:exclusiveGateway id="Gateway_CheckAlcohol" name="Order Includes Alcohol?">
      <bpmn:incoming>SequenceFlow_CheckAlcohol</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AlcoholYes</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_AlcoholNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Kitchen Task (Common Path) -->
    <bpmn:task id="Task_PrepareFood" name="Prepare Food">
      <bpmn:incoming>SequenceFlow_KitchenYes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FoodReady</bpmn:outgoing>
    </bpmn:task>

    <!-- Sommelier Task (Conditional) -->
    <bpmn:task id="Task_FetchWineAlcohol" name="Fetch Wine & Alcoholic Beverages">
      <bpmn:incoming>SequenceFlow_SommelierYes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WineReady</bpmn:outgoing>
    </bpmn:task>

    <!-- Waiter Tasks -->
    <bpmn:task id="Task_AssignOrder" name="Assign Order to Waiter">
      <bpmn:incoming>SequenceFlow_AlcoholYes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaiterStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Cart Readiness Task -->
    <bpmn:task id="Task_ReadyCartNonAlc" name="Readies Cart & Non-Alcoholic Drinks">
      <bpmn:incoming>SequenceFlow_WaiterStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CartReady</bpmn:outgoing>
    </bpmn:task>

    <!-- Synchronization Gateway -->
    <bpmn:inclusiveGateway id="Gateway_SynchronizePrep" name="All Items Ready?">
      <bpmn:incoming>SequenceFlow_FoodReady</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_WineReady</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_CartReady</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DeliveryStart</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Delivery Flow -->
    <bpmn:task id="Task_DeliverToGuest" name="Deliver to Guest Room">
      <bpmn:incoming>SequenceFlow_DeliveryStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReturnTrigger</bpmn:outgoing>
    </bpmn:task>

    <!-- Return Flow -->
    <bpmn:task id="Task_ReturnStation" name="Return to Room Service Station">
      <bpmn:incoming>SequenceFlow_ReturnTrigger</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BillingStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Billing Decision -->
    <bpmn:exclusiveGateway id="Gateway_CheckBilling" name="Another Order?">
      <bpmn:incoming>SequenceFlow_BillingStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DebitAccountYes</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_DebitAccountNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Billing Task -->
    <bpmn:task id="Task_DebitAccount" name="Debit Guest Account">
      <bpmn:incoming>SequenceFlow_DebitAccountYes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndProcess</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_OrderComplete" name="Order Complete">
      <bpmn:incoming>SequenceFlow_DebitAccountNo</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_EndProcess</bpmn:outgoing>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    
    <!-- Manager Flow Start to Decision -->
    <bpmn:sequenceFlow id="SequenceFlow_TakeOrder" sourceRef="StartEvent_GuestCall" targetRef="Task_TakeOrder" />
    <bpmn:sequenceFlow id="SequenceFlow_CheckAlcohol" name="Check Content" sourceRef="Task_TakeOrder" targetRef="Gateway_CheckAlcohol" />

    <!-- Decision Branches -->
    
    <!-- Path 1: Alcohol Required (Yes) -> Kitchen + Sommelier Parallel, Waiter Assignment triggers Prep -->
    <bpmn:sequenceFlow id="SequenceFlow_AlcoholYes" name="Yes - With Wine" sourceRef="Gateway_CheckAlcohol" targetRef="Task_AssignOrder">
      <bpmn:dataAssociation />
    </bpmn:sequenceFlow>

    <!-- Path 2: No Alcohol (No) -> Kitchen Only, Waiter Assignment triggers Prep -->
    <bpmn:sequenceFlow id="SequenceFlow_AlcoholNo" name="No - Without Wine" sourceRef="Gateway_CheckAlcohol" targetRef="Task_AssignOrder">
      <bpmn:dataAssociation />
    </bpmn:sequenceFlow>

    <!-- Waiter Prep Start (Triggered by Assignment) -->
    <bpmn:sequenceFlow id="SequenceFlow_WaiterStart" sourceRef="Task_AssignOrder" targetRef="Task_ReadyCartNonAlc">
      <bpmn:dataAssociation />
    </bpmn:sequenceFlow>

    <!-- Kitchen Flow (Triggered by Yes or No path) -->
    <bpmn:sequenceFlow id="SequenceFlow_KitchenYes" name="Start Food Preparation" sourceRef="Gateway_CheckAlcohol" targetRef="Task_PrepareFood">
      <bpmn:dataAssociation />
    </bpmn:sequenceFlow>

    <!-- Sommelier Flow (Only if Alcohol) -->
    <bpmn:sequenceFlow id="SequenceFlow_SommelierYes" name="Start Wine Fetching" sourceRef="Gateway_CheckAlcohol" targetRef="Task_FetchWineAlcohol">
      <bpmn:dataAssociation />
    </bpmn:sequenceFlow>

    <!-- Cart Readiness Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_CartReady" name="Cart Ready" sourceRef="Task_ReadyCartNonAlc" targetRef="Gateway_SynchronizePrep">
      <bpmn:dataAssociation />
    </bpmn:sequenceFlow>

    <!-- Food Readiness Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_FoodReady" name="Food Ready" sourceRef="Task_PrepareFood" targetRef="Gateway_SynchronizePrep">
      <bpmn:dataAssociation />
    </bpmn:sequenceFlow>

    <!-- Wine Readiness Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_WineReady" name="Wine Ready" sourceRef="Task_FetchWineAlcohol" targetRef="Gateway_SynchronizePrep">
      <bpmn:dataAssociation />
    </bpmn:sequenceFlow>

    <!-- Delivery Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_DeliveryStart" name="All Ready - Deliver" sourceRef="Gateway_SynchronizePrep" targetRef="Task_DeliverToGuest">
      <bpmn:dataAssociation />
    </bpmn:sequenceFlow>

    <!-- Return Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_ReturnTrigger" name="Return to Station" sourceRef="Task_DeliverToGuest" targetRef="Task_ReturnStation">
      <bpmn:dataAssociation />
    </bpmn:sequenceFlow>

    <!-- Billing Start Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_BillingStart" name="Ready to Bill" sourceRef="Task_ReturnStation" targetRef="Gateway_CheckBilling">
      <bpmn:dataAssociation />
    </bpmn:sequenceFlow>

    <!-- Debit Account Yes Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_DebitAccountYes" name="Debit Now" sourceRef="Gateway_CheckBilling" targetRef="Task_DebitAccount">
      <bpmn:dataAssociation />
    </bpmn:sequenceFlow>

    <!-- Debit Account No Flow (Skip billing if another order) -->
    <bpmn:sequenceFlow id="SequenceFlow_DebitAccountNo" name="Wait for Another Order" sourceRef="Gateway_CheckBilling" targetRef="EndEvent_OrderComplete">
      <bpmn:dataAssociation />
    </bpmn:sequenceFlow>

    <!-- End Process Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_EndProcess" name="Order Complete" sourceRef="Task_DebitAccount" targetRef="EndEvent_OrderComplete">
      <bpmn:dataAssociation />
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>