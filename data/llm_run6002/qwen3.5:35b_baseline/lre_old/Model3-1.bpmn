<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_SCT_Warrant_Process_01" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_SCT_Ops_01">
    <bpmn:participant id="Participant_BackOffice" name="Client Service Back Office (Small Claims Registry Operations)" processRef="Process_SCT_Warrant_01" />
  </bpmn:collaboration>

  <bpmn:message id="Message_RequestReceived" name="Warrant Possession Request" />
  <bpmn:message id="Message_ReportSent" name="Police Report" />

  <bpmn:dataObjectReference id="DataSCTTFile" name="SCTT Physical File" />
  <bpmn:dataObjectReference id="DataExpandedFile" name="Expanded SCT Physical File" />

  <bpmn:process id="Process_SCT_Warrant_01" isExecutable="true">
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_RequestReceived" name="Warrant Possession Request Received">
      <bpmn:outgoing>SequenceFlow_RetrieveSCTT</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1 -->
    <bpmn:task id="Task_RetrieveSCTT" name="Retrieve SCTT File">
      <bpmn:incoming>SequenceFlow_RetrieveSCTT</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ForwardWarrant</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2 -->
    <bpmn:task id="Task_ForwardWarrant" name="Forward Warrant to Queensland Police">
      <bpmn:incoming>SequenceFlow_ForwardWarrant</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitReport</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Catch Event -->
    <bpmn:intermediateCatchEvent id="IntermediateWaitReport" name="Await Police Report">
      <bpmn:incoming>SequenceFlow_WaitReport</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RetrieveSCTAgain</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task 3 -->
    <bpmn:task id="Task_RetrieveSCT_Again" name="Retrieve SCT File">
      <bpmn:incoming>SequenceFlow_RetrieveSCTAgain</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AttachDoc</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 4 -->
    <bpmn:task id="Task_AttachDoc" name="Attach New SCT Document">
      <bpmn:incoming>SequenceFlow_AttachDoc</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StoreExpandedFile</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 5 -->
    <bpmn:task id="Task_StoreExpanded" name="Store Expanded SCT Physical File">
      <bpmn:incoming>SequenceFlow_StoreExpandedFile</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_HandoverInternal</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_InternalHandover" name="Handover to Internal Staff">
      <bpmn:incoming>SequenceFlow_HandoverInternal</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_RetrieveSCTT" sourceRef="StartEvent_RequestReceived" targetRef="Task_RetrieveSCTT">
      <bpmn:name>Receive Request</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ForwardWarrant" sourceRef="Task_RetrieveSCTT" targetRef="Task_ForwardWarrant" />

    <bpmn:sequenceFlow id="SequenceFlow_WaitReport" sourceRef="Task_ForwardWarrant" targetRef="IntermediateWaitReport">
      <bpmn:name>Awaiting Report</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_RetrieveSCTAgain" sourceRef="IntermediateWaitReport" targetRef="Task_RetrieveSCT_Again">
      <bpmn:name>When Report Received</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_AttachDoc" sourceRef="Task_RetrieveSCT_Again" targetRef="Task_AttachDoc" />

    <bpmn:sequenceFlow id="SequenceFlow_StoreExpandedFile" sourceRef="Task_AttachDoc" targetRef="Task_StoreExpanded" />

    <bpmn:sequenceFlow id="SequenceFlow_HandoverInternal" sourceRef="Task_StoreExpanded" targetRef="EndEvent_InternalHandover">
      <bpmn:name>Out of Scope</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Data Associations -->
    <bpmn:dataAssociation id="Assoc_SCTTFile_1">
      <bpmn:sourceRef>DataSCTTFile</bpmn:sourceRef>
      <bpmn:targetRef>Task_RetrieveSCTT</bpmn:targetRef>
    </bpmn:dataAssociation>

    <bpmn:dataAssociation id="Assoc_SCTTFile_2">
      <bpmn:sourceRef>DataExpandedFile</bpmn:sourceRef>
      <bpmn:targetRef>Task_StoreExpanded</bpmn:targetRef>
    </bpmn:dataAssociation>

  </bpmn:process>
</bpmn:definitions>