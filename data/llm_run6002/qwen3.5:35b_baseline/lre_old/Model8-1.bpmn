<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_RecruitmentProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_Recruitment_01">
    <bpmn:participant id="Participant_Recruitment" name="Employee Recruitment Process" processRef="Proc_Recruitment_01" />
  </bpmn:collaboration>

  <bpmn:process id="Proc_Recruitment_01" isExecutable="true">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_FunctionalDept" name="Functional Department">
        <bpmn:flowNodeRef>StartEvent_Demand</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_HRDepartment" name="Human Resources">
        <bpmn:flowNodeRef>InclusiveGateway_CheckCandidates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AdvertisePost</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveApplications</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckApplications</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConcludeContract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Filled</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Demand" name="Demand for Post Filling">
      <bpmn:outgoing>SequenceFlow_InitiateProcess</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Advertise -->
    <bpmn:task id="Task_AdvertisePost" name="Advertise Post">
      <bpmn:incoming>SequenceFlow_InitiateProcess</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StartApplications</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: Receive Applications -->
    <bpmn:task id="Task_ReceiveApplications" name="Collect Applicants">
      <bpmn:incoming>SequenceFlow_StartApplications</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckAppsStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3: Check Applications -->
    <bpmn:task id="Task_CheckApplications" name="Check Applications">
      <bpmn:incoming>SequenceFlow_CheckAppsStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SelectCandidate</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for Selection Logic -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_Suitability" name="Suitable Candidate Found?">
      <bpmn:incoming>SequenceFlow_SelectCandidate</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ContractPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 4: Conclude Contract -->
    <bpmn:task id="Task_ConcludeContract" name="Conclude Employment Contract">
      <bpmn:incoming>SequenceFlow_ContractPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FinalizeProcess</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Filled" name="Post Filled">
      <bpmn:incoming>SequenceFlow_FinalizeProcess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_InitiateProcess" sourceRef="StartEvent_Demand" targetRef="Task_AdvertisePost">
      <bpmn:name>Demand Received</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_StartApplications" sourceRef="Task_AdvertisePost" targetRef="Task_ReceiveApplications">
      <bpmn:name>Advertised</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_CheckAppsStart" sourceRef="Task_ReceiveApplications" targetRef="Task_CheckApplications">
      <bpmn:name>Applicants Applied</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_SelectCandidate" name="Check Completed" sourceRef="Task_CheckApplications" targetRef="ExclusiveGateway_Suitability" />

    <bpmn:sequenceFlow id="SequenceFlow_ContractPath" name="Suitable Candidate Found" sourceRef="ExclusiveGateway_Suitability" targetRef="Task_ConcludeContract">
      <bpmn:name>Suitable Candidate</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_FinalizeProcess" name="Contract Signed" sourceRef="Task_ConcludeContract" targetRef="EndEvent_Filled">
      <bpmn:name>Contract Signed</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>