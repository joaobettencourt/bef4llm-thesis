<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_RecruitmentProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_HR_Process">
    <bpmn:participant id="Participant_HR_Department" name="HR Recruitment Process" processRef="Proc_Recruitment_01" />
  </bpmn:collaboration>

  <bpmn:process id="Proc_Recruitment_01" isExecutable="true">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Recruiter" name="Recruiter">
        <bpmn:flowNodeRef>StartEvent_VacancyReported</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateJobDescription</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_CheckClarity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AskDepartmentClarification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitDescription</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_ApprovalResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CorrectDescription</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PostJob</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_VacancyReported" name="Vacancy Reported">
      <bpmn:outgoing>SequenceFlow_InitProcess</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Create Job Description -->
    <bpmn:task id="Task_CreateJobDescription" name="Create job description">
      <bpmn:incoming>SequenceFlow_InitProcess</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckClarity</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Check Clarity -->
    <bpmn:inclusiveGateway id="InclusiveGateway_CheckClarity">
      <bpmn:incoming>SequenceFlow_CheckClarity</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AskClarification</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SubmitDescription</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Task 2: Ask Department for Clarification -->
    <bpmn:task id="Task_AskDepartmentClarification" name="Ask department again">
      <bpmn:incoming>SequenceFlow_AskClarification</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_LoopBackCreate</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3: Submit Description -->
    <bpmn:task id="Task_SubmitDescription" name="Submit for consideration">
      <bpmn:incoming>SequenceFlow_SubmitDescription</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitApproval</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2: Approval Result -->
    <bpmn:inclusiveGateway id="InclusiveGateway_ApprovalResult">
      <bpmn:incoming>SequenceFlow_WaitApproval</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CorrectDescription</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PostJob</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Task 4: Correct Description -->
    <bpmn:task id="Task_CorrectDescription" name="Correct description">
      <bpmn:incoming>SequenceFlow_CorrectDescription</bpmn:incoming>
      <bpmn:outgoing>SequenceLoop_SubmitAgain</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 5: Post Job -->
    <bpmn:task id="Task_PostJob" name="Post the job">
      <bpmn:incoming>SequenceFlow_PostJob</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FinalizeProcess</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_JobPosted" name="Job Posted">
      <bpmn:incoming>SequenceFlow_FinalizeProcess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    
    <!-- Init Process -->
    <bpmn:sequenceFlow id="SequenceFlow_InitProcess" sourceRef="StartEvent_VacancyReported" targetRef="Task_CreateJobDescription">
      <bpmn:name>Vacancy Reported</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Check Clarity -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckClarity" sourceRef="Task_CreateJobDescription" targetRef="InclusiveGateway_CheckClarity">
      <bpmn:name>Create JD</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Ask Clarification (No) -->
    <bpmn:sequenceFlow id="SequenceFlow_AskClarification" sourceRef="InclusiveGateway_CheckClarity" targetRef="Task_AskDepartmentClarification">
      <bpmn:name>Confusion exists</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Loop Back to Create -->
    <bpmn:sequenceFlow id="SequenceFlow_LoopBackCreate" sourceRef="Task_AskDepartmentClarification" targetRef="Task_CreateJobDescription">
      <bpmn:name>Ask Dept</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Submit Description (Yes) -->
    <bpmn:sequenceFlow id="SequenceFlow_SubmitDescription" sourceRef="InclusiveGateway_CheckClarity" targetRef="Task_SubmitDescription">
      <bpmn:name>Description Clear</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Wait for Approval (Implicit) -->
    <bpmn:sequenceFlow id="SequenceFlow_WaitApproval" sourceRef="Task_SubmitDescription" targetRef="InclusiveGateway_ApprovalResult">
      <bpmn:name>Wait for approval</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Correct Description (Rejected) -->
    <bpmn:sequenceFlow id="SequenceFlow_CorrectDescription" sourceRef="InclusiveGateway_ApprovalResult" targetRef="Task_CorrectDescription">
      <bpmn:name>Reject / Request Correction</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Loop Back to Submit -->
    <bpmn:sequenceFlow id="SequenceLoop_SubmitAgain" sourceRef="Task_CorrectDescription" targetRef="InclusiveGateway_ApprovalResult">
      <bpmn:name>Submit Again</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Post Job (Approved) -->
    <bpmn:sequenceFlow id="SequenceFlow_PostJob" sourceRef="InclusiveGateway_ApprovalResult" targetRef="Task_PostJob">
      <bpmn:name>Approved</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Finalize Process -->
    <bpmn:sequenceFlow id="SequenceFlow_FinalizeProcess" sourceRef="Task_PostJob" targetRef="EndEvent_JobPosted">
      <bpmn:name>Post Job</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>