<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_SwitchOverProcess_01" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="CollabSwitchOver_01">
    <bpmn:participant id="Participant_CustomerService" name="Customer Service Department" processRef="Proc_SwitchOverMain_01" />
    <bpmn:participant id="Participant_GridOperator" name="Grid Operator" />
    <bpmn:participant id="Participant_OldSupplier" name="Old Supplier" />
  </bpmn:collaboration>

  <bpmn:process id="Proc_SwitchOverMain_01" isExecutable="true">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_CustomerService" name="Customer Service Staff">
        <bpmn:flowNodeRef>StartEvent_OrderRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_DataValidation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterCRM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_CheckCustomerExists</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateNewCustomer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareContractDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_ContractCheckResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AnalyzeResolveIssues</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendConfirmationToCustomer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_SupplierConcurrenceCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_ConflictExists</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TerminateOldAgreement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_7DayRule</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_CustomerDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateCISContract</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_CISSystem" name="CIS System">
        <bpmn:flowNodeRef>InclusiveGateway_ContractGenerationCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AutomatedContractCheck</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_OrderRequest" name="Switch-over Request">
      <bpmn:outgoing>SequenceFlow_InitOrder</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Receive Customer Data -->
    <bpmn:task id="Task_ReceiveData" name="Transmit customer data to service center">
      <bpmn:incoming>SequenceFlow_InitOrder</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EnterCRM</bpmn:outgoing>
    </bpmn:task>

    <!-- CRM Entry -->
    <bpmn:task id="Task_EnterCRM" name="Enter customer data into CRM system">
      <bpmn:incoming>SequenceFlow_EnterCRM</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CompareData</bpmn:outgoing>
    </bpmn:task>

    <!-- Data Validation -->
    <bpmn:exclusiveGateway id="InclusiveGateway_DataValidation" name="Check data completeness &amp; plausibility">
      <bpmn:incoming>SequenceFlow_CompareData</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ValidDataPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ErrorHandlingPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Error Handling -->
    <bpmn:task id="Task_CorrectErrors" name="Correct errors based on error list">
      <bpmn:incoming>SequenceFlow_ErrorHandlingPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReturnToValidation</bpmn:outgoing>
    </bpmn:task>

    <!-- Check if Customer Exists -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_CheckCustomerExists" name="Check customer in database">
      <bpmn:incoming>SequenceFlow_ValidDataPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NewCustomerPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ExistingCustomerPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Create New Customer -->
    <bpmn:task id="Task_CreateNewCustomer" name="Create new customer object">
      <bpmn:incoming>SequenceFlow_NewCustomerPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PrepareContractDocsInit</bpmn:outgoing>
    </bpmn:task>

    <!-- Prepare Contract Documents -->
    <bpmn:task id="Task_PrepareContractDocs" name="Prepare contract documents for power supplier switch">
      <bpmn:incoming>SequenceFlow_ExistingCustomerPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AutomatedCheckInitiate</bpmn:outgoing>
    </bpmn:task>

    <!-- Automated Contract Check -->
    <bpmn:exclusiveGateway id="InclusiveGateway_ContractGenerationResult" name="Contract generation successful?">
      <bpmn:incoming>SequenceFlow_AutomatedCheckInitiate</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PositiveResponsePath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NegativeResponsePath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Analyze and Resolve Issues -->
    <bpmn:task id="Task_AnalyzeResolveIssues" name="Analyze contract generation issues">
      <bpmn:incoming>SequenceFlow_NegativeResponsePath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RegenerateContracts</bpmn:outgoing>
    </bpmn:task>

    <!-- Send Confirmation to Customer -->
    <bpmn:task id="Task_SendConfirmationToCustomer" name="Send confirmation document">
      <bpmn:incoming>SequenceFlow_PositiveResponsePath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RequestGridOperatorCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Request Grid Operator Check -->
    <bpmn:exclusiveGateway id="InclusiveGateway_SupplierConcurrenceCheck" name="Supplier concurrence check">
      <bpmn:incoming>SequenceFlow_RequestGridOperatorCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConflictExistsPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoConflictPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Check Supplier Concurrence -->
    <bpmn:task id="Task_CheckSupplierConcurrence" name="Check supplier concurrence">
      <bpmn:incoming>MessageFlow_GridOperatorRequest</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConflictExistsPathInternal</bpmn:outgoing>
    </bpmn:task>

    <!-- Conflict Resolution -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_ConflictExists" name="Conflict exists?">
      <bpmn:incoming>SequenceFlow_ConflictExistsPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ResolveConflictPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Terminate Old Agreement -->
    <bpmn:task id="Task_TerminateOldAgreement" name="Terminate sales agreement with old supplier">
      <bpmn:incoming>SequenceFlow_ResolveConflictPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CreateCISContractInit</bpmn:outgoing>
    </bpmn:task>

    <!-- Create CIS Contract -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_CustomerDecision" name="Customer decision">
      <bpmn:incoming>SequenceFlow_NoConflictPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WithdrawContractPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ConfirmContractPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Customer Withdrawal -->
    <bpmn:endEvent id="EndEvent_ProcessComplete" name="Process Complete">
      <bpmn:incoming>SequenceFlow_WithdrawContractPath</bpmn:incoming>
    </bpmn:endEvent>

    <!-- 7-Day Rule Check -->
    <bpmn:exclusiveGateway id="InclusiveGateway_7DayRule" name="Within 7 days?">
      <bpmn:incoming>SequenceFlow_ConfirmContractPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AcceptedAfter7Days</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Meter Data Processing -->
    <bpmn:task id="Task_ImportMeterData" name="Import meter data to systems">
      <bpmn:incoming>SequenceFlow_AcceptedAfter7Days</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProcessCompleteFinal</bpmn:outgoing>
    </bpmn:task>

    <!-- Final Billing -->
    <bpmn:endEvent id="EndEvent_GridOperatorComplete" name="Grid Operator Process Complete">
       <bpmn:incoming>MessageFlow_MeterDataReceived</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_InitOrder" sourceRef="StartEvent_OrderRequest" targetRef="Task_ReceiveData" />
    
    <bpmn:exclusiveGateway id="InclusiveGateway_ContractGenerationCheck">
      <bpmn:incoming>SequenceFlow_AutomatedContractCheck</bpmn:incoming>
       <!-- Renamed to avoid duplicate logic error in thought block, using proper exclusive for simplicity here or keeping inclusive -->
    </bpmn:exclusiveGateway>

  </bpmn:process>
  
  <bpmn:message id="Message_GridOperatorRequest" name="Concurrence Request"/>
  <bpmn:message id="Message_MeterDataReceived" name="Meter Data Report"/>
</bpmn:definitions>