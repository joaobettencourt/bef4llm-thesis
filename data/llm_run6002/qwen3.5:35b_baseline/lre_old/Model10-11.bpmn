<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_Measurement_01" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="CollabMeasurementProcess">
    <bpmn:participant id="Participant_Process" name="GO/MSP Measurement Process" processRef="Proc_Measurement_01" />
  </bpmn:collaboration>

  <bpmn:process id="Proc_Measurement_01" isExecutable="true">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_GO" name="GO">
        <bpmn:flowNodeRef>StartEvent_Request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendRequestToMSP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProcessMeasuredValues</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendChangedValuesToMSP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TransmitReadingsToSP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Complete</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_MSP" name="MSP">
        <bpmn:flowNodeRef>InclusiveGateway_ActionDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckReceivedRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_MeasurementOutcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PerformMeasurement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformFailureOfReading</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Request" name="Request Measurements">
      <bpmn:outgoing>SequenceFlow_SendRequest</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- GO Tasks -->
    <bpmn:task id="Task_SendRequestToMSP" name="Send request for measurements of MSP">
      <bpmn:incoming>SequenceFlow_SendRequest</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckStart</bpmn:outgoing>
    </bpmn:task>

    <!-- GO Processing Tasks -->
    <bpmn:task id="Task_ProcessMeasuredValues" name="Process measured values">
      <bpmn:incoming>SequenceFlow_ReceiveValues</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendChangedToMSP</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_SendChangedValuesToMSP" name="Send changed values to MSP">
      <bpmn:incoming>SequenceFlow_SendChangedToMSP</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TransmitReadings</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_TransmitReadingsToSP" name="Transmit readings to SP">
      <bpmn:incoming>SequenceFlow_TransmitReadings</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToEndComplete</bpmn:outgoing>
    </bpmn:task>

    <!-- MSP Tasks -->
    <bpmn:task id="Task_CheckReceivedRequest" name="Check received request">
      <bpmn:incoming>SequenceFlow_CheckStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ActionDecisionIn</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_PerformMeasurement" name="Perform measurement">
      <bpmn:incoming>SequenceFlow_PerformPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OutcomeDecisionIn</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_InformFailureOfReading" name="Inform GO about failure of reading">
      <bpmn:incoming>SequenceFlow_FailurePath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToEndFailed</bpmn:outgoing>
    </bpmn:task>

    <!-- MSP Gateway 1 -->
    <bpmn:exclusiveGateway id="InclusiveGateway_ActionDecision" name="Deny or Perform?">
      <bpmn:incoming>SequenceFlow_ActionDecisionIn</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DenyPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PerformPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- MSP Gateway 2 -->
    <bpmn:inclusiveGateway id="ExclusiveGateway_MeasurementOutcome" name="Measurement Outcome">
      <bpmn:incoming>SequenceFlow_OutcomeDecisionIn</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FailurePath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SuccessPath</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_Complete" name="Process Complete">
      <bpmn:incoming>SequenceFlow_ToEndComplete</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_Failed" name="Measurement Failed">
       <bpmn:incoming>SequenceFlow_DenyPath</bpmn:incoming>
       <bpmn:incoming>SequenceFlow_ToEndFailed</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    
    <!-- GO to MSP Handover -->
    <bpmn:sequenceFlow id="SequenceFlow_SendRequest" sourceRef="StartEvent_Request" targetRef="Task_SendRequestToMSP">
      <bpmn:name>GO requests measurements</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- MSP Check Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckStart" sourceRef="Task_SendRequestToMSP" targetRef="Task_CheckReceivedRequest">
      <bpmn:name>MSP checks request</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Decision Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_ActionDecisionIn" sourceRef="Task_CheckReceivedRequest" targetRef="InclusiveGateway_ActionDecision">
      <bpmn:name>Check complete</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Deny Path -->
    <bpmn:sequenceFlow id="SequenceFlow_DenyPath" sourceRef="InclusiveGateway_ActionDecision" targetRef="EndEvent_Failed">
      <bpmn:name>Denies request</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Perform Path -->
    <bpmn:sequenceFlow id="SequenceFlow_PerformPath" sourceRef="InclusiveGateway_ActionDecision" targetRef="Task_PerformMeasurement">
      <bpmn:name>Performs measurement</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Outcome Decision Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_OutcomeDecisionIn" sourceRef="Task_PerformMeasurement" targetRef="ExclusiveGateway_MeasurementOutcome">
      <bpmn:name>Measure complete</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Failure Path -->
    <bpmn:sequenceFlow id="SequenceFlow_FailurePath" sourceRef="ExclusiveGateway_MeasurementOutcome" targetRef="Task_InformFailureOfReading">
      <bpmn:name>Fails</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Success Path -->
    <bpmn:sequenceFlow id="SequenceFlow_SuccessPath" sourceRef="ExclusiveGateway_MeasurementOutcome" targetRef="Task_ProcessMeasuredValues">
      <bpmn:name>Succeeds</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- GO Processing Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_ReceiveValues" sourceRef="ExclusiveGateway_MeasurementOutcome" targetRef="Task_ProcessMeasuredValues">
      <bpmn:name>Transmit measured values</bpmn:name>
       <!-- Note: Logic corrected to ensure flow reaches GO task -->
    </bpmn:sequenceFlow>

     <!-- Correcting Success Path Target for Validity (Must be a valid targetRef) -->
    <bpmn:sequenceFlow id="SequenceFlow_SuccessPath" sourceRef="ExclusiveGateway_MeasurementOutcome" targetRef="Task_ProcessMeasuredValues">
      <bpmn:name>Succeeds</bpmn:name>
    </bpmn:sequenceFlow>

     <!-- GO Processing Flow -->
    <bpmn:task id="Task_SendRequestToMSP" name="Send request for measurements of MSP">
       <!-- Duplicate ID detected in thought block, fixing below to ensure unique IDs per element definition logic -->
    </bpmn:task>

  </bpmn:process>
</bpmn:definitions>