<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_ZooClubMembership_01" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_ZooClubProcess_1">
    <bpmn:participant id="Participant_BarcZooMain" name="Barcelona Zoo Membership Process" processRef="Proc_ZooClubMembership_01" />
  </bpmn:collaboration>

  <bpmn:process id="Proc_ZooClubMembership_01" isExecutable="true">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Customer" name="Customer / Visitor">
        <bpmn:flowNodeRef>StartEvent_MembershipRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_DecisionMembershipType</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepPersonalInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepFamilyInfo</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ZooClubDept" name="ZooClub Department">
        <bpmn:flowNodeRef>InclusiveGateway_ConvergeDataPrep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IntroduceDataAndRequestPayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_SplitBillingMarketing</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_BillingDept" name="Billing Department">
        <bpmn:flowNodeRef>Task_SendPaymentRequestToBank</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CatchEvent_PaymentConfirmed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_MarketingDept" name="Marketing Department">
        <bpmn:flowNodeRef>Task_RequestMagazineMailing</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_MembershipRequest" name="Membership Request">
      <bpmn:outgoing>SequenceFlow_InitDecision</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Decision Gateway (Individual vs Family) -->
    <bpmn:exclusiveGateway id="InclusiveGateway_DecisionMembershipType" name="Membership Type?">
      <bpmn:incoming>SequenceFlow_InitDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PrepPersonalInfoPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PrepFamilyInfoPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Individual Path -->
    <bpmn:task id="Task_PrepPersonalInfo" name="Prepare personal information">
      <bpmn:incoming>SequenceFlow_PrepPersonalInfoPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConvergeDataPrep1</bpmn:outgoing>
    </bpmn:task>

    <!-- Family Path -->
    <bpmn:task id="Task_PrepFamilyInfo" name="Prepare family information (Spouse &amp; Children)">
      <bpmn:incoming>SequenceFlow_PrepFamilyInfoPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConvergeDataPrep2</bpmn:outgoing>
    </bpmn:task>

    <!-- Convergence Gateway (Join Prep Paths) -->
    <bpmn:inclusiveGateway id="InclusiveGateway_ConvergeDataPrep">
      <bpmn:incoming>SequenceFlow_ConvergeDataPrep1</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ConvergeDataPrep2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_HandoverToZooClubDept</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- ZooClub Dept Task -->
    <bpmn:task id="Task_IntroduceDataAndRequestPayment" name="Introduce data &amp; Request Payment">
      <bpmn:incoming>SequenceFlow_HandoverToZooClubDept</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SplitBillingMarketing</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Split for Billing and Marketing -->
    <bpmn:parallelGateway id="ParallelGateway_SplitBillingMarketing">
      <bpmn:incoming>SequenceFlow_SplitBillingMarketing</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendToBankPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RequestMagazinePath</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Billing Path -->
    <bpmn:task id="Task_SendPaymentRequestToBank" name="Send payment request to Bank">
      <bpmn:incoming>SequenceFlow_SendToBankPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitForConfirmation</bpmn:outgoing>
    </bpmn:task>

    <!-- Catch Event for Payment Confirmation -->
    <bpmn:startEvent id="CatchEvent_PaymentConfirmed" name="Payment Confirmed">
       <bpmn:incoming>SequenceFlow_WaitForConfirmation</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_ConvergeEnd1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Marketing Path -->
    <bpmn:task id="Task_RequestMagazineMailing" name="Request magazine mailing">
      <bpmn:incoming>SequenceFlow_RequestMagazinePath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConvergeEnd2</bpmn:outgoing>
    </bpmn:task>

    <!-- Convergence Gateway (Wait for Payment &amp; Marketing) -->
    <bpmn:parallelGateway id="ParallelGateway_JoinBillingMarketing">
      <bpmn:incoming>SequenceFlow_ConvergeEnd1</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ConvergeEnd2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PrintCardPath</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Final Task -->
    <bpmn:task id="Task_PrintCardDeliver" name="Print card &amp; Deliver to Visitor">
      <bpmn:incoming>SequenceFlow_PrintCardPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndProcess</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_MembershipComplete" name="Membership Complete">
      <bpmn:incoming>SequenceFlow_EndProcess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_InitDecision" sourceRef="StartEvent_MembershipRequest" targetRef="InclusiveGateway_DecisionMembershipType">
      <bpmn:name>New Request</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_PrepPersonalInfoPath" sourceRef="InclusiveGateway_DecisionMembershipType" targetRef="Task_PrepPersonalInfo">
       <bpmn:name>Individual Membership</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_PrepFamilyInfoPath" sourceRef="InclusiveGateway_DecisionMembershipType" targetRef="Task_PrepFamilyInfo">
       <bpmn:name>Family Membership</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ConvergeDataPrep1" sourceRef="Task_PrepPersonalInfo" targetRef="InclusiveGateway_ConvergeDataPrep">
      <!-- No name needed for internal flow -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ConvergeDataPrep2" sourceRef="Task_PrepFamilyInfo" targetRef="InclusiveGateway_ConvergeDataPrep">
       <!-- No name needed for internal flow -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_HandoverToZooClubDept" sourceRef="InclusiveGateway_ConvergeDataPrep" targetRef="Task_IntroduceDataAndRequestPayment">
      <!-- No name needed for internal flow -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_SplitBillingMarketing" sourceRef="Task_IntroduceDataAndRequestPayment" targetRef="ParallelGateway_SplitBillingMarketing">
       <!-- No name needed for internal flow -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_SendToBankPath" sourceRef="ParallelGateway_SplitBillingMarketing" targetRef="Task_SendPaymentRequestToBank">
      <!-- No name needed for internal flow -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_WaitForConfirmation" sourceRef="Task_SendPaymentRequestToBank" targetRef="CatchEvent_PaymentConfirmed">
       <!-- Represents interaction with Bank system logic -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_RequestMagazinePath" sourceRef="ParallelGateway_SplitBillingMarketing" targetRef="Task_RequestMagazineMailing">
      <!-- No name needed for internal flow -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ConvergeEnd1" sourceRef="CatchEvent_PaymentConfirmed" targetRef="ParallelGateway_JoinBillingMarketing">
       <!-- Payment Confirmation Path -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ConvergeEnd2" sourceRef="Task_RequestMagazineMailing" targetRef="ParallelGateway_JoinBillingMarketing">
      <!-- Marketing Completion Path -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_PrintCardPath" sourceRef="ParallelGateway_JoinBillingMarketing" targetRef="Task_PrintCardDeliver">
       <!-- No name needed for internal flow -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_EndProcess" sourceRef="Task_PrintCardDeliver" targetRef="EndEvent_MembershipComplete">
      <!-- No name needed for internal flow -->
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>