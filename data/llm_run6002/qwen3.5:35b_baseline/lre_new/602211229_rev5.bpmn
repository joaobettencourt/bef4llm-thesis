<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_Reimb_0a2b3c4d" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Col_ReimbProc_0x9y8z7w6v5u">
    <bpmn:participant id="Part_MainERICS_0p1o2i3u" name="Reimbursement Process ERICS Company" processRef="Procs_Reimburse_4t5r6e7w"/>
  </bpmn:collaboration>

  <bpmn:process id="Procs_Reimburse_4t5r6e7w" isExecutable="true">
    <bpmn:laneSet id="LaneSet_ReimbTeam_8q9w0e1r2t3y">
      <bpmn:lane id="Lane_ReimbDept_4u5i6o7p8a9s">
        <bpmn:name>Reimbursement Department</bpmn:name>
        <bpmn:flowNodeRef>SE_StartRequest_0d1f2g3h4j5k</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_TaskCreateContact_6l7z8x9c0v1b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_TaskChooseBeneficiary_2n3m4q5w6e7r</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_TaskDetermineDuration_8t9y0u1i2o3p</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_GWVerbandStatus_4a5s6d7f8g9h</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_TaskSelectGroupAssoc_0j1k2l3z4x5c</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_TaskManuallySelectCustomer_6v7b8n9m0q1w</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_GWJoinThresholdPath_2e3r4t5y6u7i</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_TaskSetThreshold_0d1f2g3h4j5k</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IE_EventTimerWaitPeriodEnd_8o9p0a1s2d3f</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_GWSplitParallelPostTimer_4g5h6j7k8l9z</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_TaskPrintAndSendCreditNote_0x1c2v3b4n5m</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_TaskCalculateReimbursement_6q7w8e9r0t1y</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_TaskPayCustomer_2u3i4o5p6a7s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_GWJoinFinalMerge_8d9f0g1h2j3k</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="SE_StartRequest_0d1f2g3h4j5k" name="Receive Reimbursement Request">
      <bpmn:outgoing>SF_FlowStartToTask_6l7z8x9c</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1 -->
    <bpmn:task id="T_TaskCreateContact_6l7z8x9c0v1b" name="Create Reimbursement Contact">
      <bpmn:incoming>SF_FlowStartToTask_6l7z8x9c</bpmn:incoming>
      <bpmn:outgoing>SF_TaskCreateToChoose_2n3m4q5w</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2 -->
    <bpmn:task id="T_TaskChooseBeneficiary_2n3m4q5w6e7r" name="Choose Beneficiary">
      <bpmn:incoming>SF_TaskCreateToChoose_2n3m4q5w</bpmn:incoming>
      <bpmn:outgoing>SF_ChosenToDuration_8t9y0u1i</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3 -->
    <bpmn:task id="T_TaskDetermineDuration_8t9y0u1i2o3p" name="Determine Refund Period Duration">
      <bpmn:incoming>SF_ChosenToDuration_8t9y0u1i</bpmn:incoming>
      <bpmn:outgoing>SF_GWVerbandGroupSelect_4a5s6d7f</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1 -->
    <bpmn:exclusiveGateway id="GW_GWVerbandStatus_4a5s6d7f8g9h" name="Customer in Verband?">
      <bpmn:incoming>SF_ChosenToDuration_8t9y0u1i</bpmn:incoming>
      <bpmn:outgoing>SF_GWVerbandGroupSelect_4a5s6d7f8g9h_yes</bpmn:outgoing>
      <bpmn:outgoing>SF_GWVerbandManualSelect_0j1k2l3z4x5c_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flow Yes -->
    <bpmn:sequenceFlow id="SF_GWVerbandGroupSelect_4a5s6d7f8g9h_yes" name="Yes (Verband)" sourceRef="GW_GWVerbandStatus_4a5s6d7f8g9h" targetRef="T_TaskSelectGroupAssoc_0j1k2l3z4x5c">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${customerInVerband}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Sequence Flow No -->
    <bpmn:sequenceFlow id="SF_GWVerbandManualSelect_0j1k2l3z4x5c_no" name="No (Normal)" sourceRef="GW_GWVerbandStatus_4a5s6d7f8g9h" targetRef="T_TaskManuallySelectCustomer_6v7b8n9m0q1w">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!customerInVerband}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Task 4a -->
    <bpmn:task id="T_TaskSelectGroupAssoc_0j1k2l3z4x5c" name="Select Group Association">
      <bpmn:incoming>SF_GWVerbandGroupSelect_4a5s6d7f8g9h_yes</bpmn:incoming>
      <bpmn:outgoing>SF_GroupToMergeThreshold_2e3r4t5y6u7i_flow1</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 4b -->
    <bpmn:task id="T_TaskManuallySelectCustomer_6v7b8n9m0q1w" name="Select Customer Manually">
      <bpmn:incoming>SF_GWVerbandManualSelect_0j1k2l3z4x5c_no</bpmn:incoming>
      <bpmn:outgoing>SF_ManualToMergeThreshold_8o9p0a1s2d3f_flow2</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2 (Join) -->
    <bpmn:exclusiveGateway id="GW_GWJoinThresholdPath_2e3r4t5y6u7i" name="Merge Paths">
      <bpmn:incoming>SF_GroupToMergeThreshold_2e3r4t5y6u7i_flow1</bpmn:incoming>
      <bpmn:incoming>SF_ManualToMergeThreshold_8o9p0a1s2d3f_flow2</bpmn:incoming>
      <bpmn:outgoing>SF_JoinToSetThreshold_4g5h6j7k8l9z_join</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flow to Threshold Task -->
    <bpmn:sequenceFlow id="SF_GroupToMergeThreshold_2e3r4t5y6u7i_flow1" sourceRef="T_TaskSelectGroupAssoc_0j1k2l3z4x5c" targetRef="GW_GWJoinThresholdPath_2e3r4t5y6u7i">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Sequence Flow to Threshold Task -->
    <bpmn:sequenceFlow id="SF_ManualToMergeThreshold_8o9p0a1s2d3f_flow2" sourceRef="T_TaskManuallySelectCustomer_6v7b8n9m0q1w" targetRef="GW_GWJoinThresholdPath_2e3r4t5y6u7i">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Sequence Flow Join to Threshold Task -->
    <bpmn:sequenceFlow id="SF_JoinToSetThreshold_4g5h6j7k8l9z_join" sourceRef="GW_GWJoinThresholdPath_2e3r4t5y6u7i" targetRef="T_TaskSetThreshold_0d1f2g3h4j5k">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Task 5 -->
    <bpmn:task id="T_TaskSetThreshold_0d1f2g3h4j5k" name="Set Threshold">
      <bpmn:incoming>SF_JoinToSetThreshold_4g5h6j7k8l9z_join</bpmn:incoming>
      <bpmn:outgoing>SF_ToTimerWaitPeriodEnd_2e3r4t5y6u7i_timerFlow</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Timer Event -->
    <bpmn:intermediateCatchEvent id="IE_EventTimerWaitPeriodEnd_8o9p0a1s2d3f" name="Refund Period Ended">
      <bpmn:incoming>SF_ToTimerWaitPeriodEnd_2e3r4t5y6u7i_timerFlow</bpmn:incoming>
      <bpmn:outgoing>SF_SplitParallelPostTimer_4g5h6j7k8l9z_splitOut1</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Gateway 3 (Split) -->
    <bpmn:parallelGateway id="GW_GWSplitParallelPostTimer_4g5h6j7k8l9z" name="Start Parallel Tasks">
      <bpmn:incoming>SF_SplitParallelPostTimer_4g5h6j7k8l9z_splitOut1</bpmn:incoming>
      <bpmn:outgoing>SF_ToCreditNoteTask_0x1c2v3b4n5m_flowA</bpmn:outgoing>
      <bpmn:outgoing>SF_ToReimbursementTask_6q7w8e9r0t1y_flowB</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Sequence Flow to Credit Note -->
    <bpmn:sequenceFlow id="SF_SplitParallelPostTimer_4g5h6j7k8l9z_splitOut1" sourceRef="IE_EventTimerWaitPeriodEnd_8o9p0a1s2d3f" targetRef="GW_GWSplitParallelPostTimer_4g5h6j7k8l9z">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Sequence Flow to Credit Note Task -->
    <bpmn:sequenceFlow id="SF_ToCreditNoteTask_0x1c2v3b4n5m_flowA" sourceRef="GW_GWSplitParallelPostTimer_4g5h6j7k8l9z" targetRef="T_TaskPrintAndSendCreditNote_0x1c2v3b4n5m">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Task 6a -->
    <bpmn:task id="T_TaskPrintAndSendCreditNote_0x1c2v3b4n5m" name="Print and Send Credit Note">
      <bpmn:incoming>SF_ToCreditNoteTask_0x1c2v3b4n5m_flowA</bpmn:incoming>
      <bpmn:outgoing>SF_CreditToMergeEnd_6q7w8e9r0t1y_mergeIn1</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow to Reimbursement Task -->
    <bpmn:sequenceFlow id="SF_ToReimbursementTask_6q7w8e9r0t1y_flowB" sourceRef="GW_GWSplitParallelPostTimer_4g5h6j7k8l9z" targetRef="T_TaskCalculateReimbursement_6q7w8e9r0t1y">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Task 6b -->
    <bpmn:task id="T_TaskCalculateReimbursement_6q7w8e9r0t1y" name="Calculate Reimbursement">
      <bpmn:incoming>SF_ToReimbursementTask_6q7w8e9r0t1y_flowB</bpmn:incoming>
      <bpmn:outgoing>SF_CalcToPayCustomer_2u3i4o5p6a7s_payFlow</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow to Pay Customer -->
    <bpmn:sequenceFlow id="SF_CalcToPayCustomer_2u3i4o5p6a7s_payFlow" sourceRef="T_TaskCalculateReimbursement_6q7w8e9r0t1y" targetRef="T_TaskPayCustomer_2u3i4o5p6a7s">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Task 6c -->
    <bpmn:task id="T_TaskPayCustomer_2u3i4o5p6a7s" name="Pay Customer">
      <bpmn:incoming>SF_CalcToPayCustomer_2u3i4o5p6a7s_payFlow</bpmn:incoming>
      <bpmn:outgoing>SF_PayToMergeEnd_8d9f0g1h2j3k_mergeIn2</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 4 (Join) -->
    <bpmn:parallelGateway id="GW_GWJoinFinalMerge_8d9f0g1h2j3k" name="Wait for Completion">
      <bpmn:incoming>SF_CreditToMergeEnd_6q7w8e9r0t1y_mergeIn1</bpmn:incoming>
      <bpmn:incoming>SF_PayToMergeEnd_8d9f0g1h2j3k_mergeIn2</bpmn:incoming>
      <bpmn:outgoing>SF_ToEndEvent_4t5r6e7w_endFlow</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Sequence Flow to End -->
    <bpmn:sequenceFlow id="SF_CreditToMergeEnd_0x1c2v3b4n5m_mergeIn1" sourceRef="T_TaskPrintAndSendCreditNote_0x1c2v3b4n5m" targetRef="GW_GWJoinFinalMerge_8d9f0g1h2j3k">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Sequence Flow to End -->
    <bpmn:sequenceFlow id="SF_PayToMergeEnd_8d9f0g1h2j3k_mergeIn2" sourceRef="T_TaskPayCustomer_2u3i4o5p6a7s" targetRef="GW_GWJoinFinalMerge_8d9f0g1h2j3k">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- End Event -->
    <bpmn:endEvent id="EE_EndProcessComplete_2e3r4t5y" name="Reimbursement Process Finished">
      <bpmn:incoming>SF_ToEndEvent_6q7w8e9r0t1y_endFlow</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flow to End Event -->
    <bpmn:sequenceFlow id="SF_ToEndEvent_4g5h6j7k8l9z" sourceRef="GW_GWJoinFinalMerge_8d9f0g1h2j3k" targetRef="EE_EndProcessComplete_2e3r4t5y">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>