<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_RewardTrainingProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_RewardAndTraining">
    <bpmn:participant id="Participant_MainPool" name="Reward and Training Process" processRef="Proc_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Proc_1" isExecutable="true">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Management" name="Management Department">
        <bpmn:flowNodeRef>S_StartEvent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_CheckPerformance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_PerformanceCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_SuggestDismissal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_SuggestTraining</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_SuggestReward</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_RewardType</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ChooseBenefit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_AnnounceEmployeeOfMonth</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_HR" name="Human Resources Department">
        <bpmn:flowNodeRef>T_DismissEmployee</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ProvideTraining</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Finance" name="Finance Department">
        <bpmn:flowNodeRef>T_CalculatePayReward</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="S_StartEvent" name="Performance Review Trigger">
      <bpmn:outgoing>F_Flow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Check Performance (Management) -->
    <bpmn:task id="T_CheckPerformance" name="Check Employee Performance">
      <bpmn:incoming>F_Flow_01</bpmn:incoming>
      <bpmn:outgoing>F_Flow_02</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Determine Action Based on Performance -->
    <bpmn:exclusiveGateway id="G_PerformanceCheck" name="Performance Threshold">
      <bpmn:incoming>F_Flow_02</bpmn:incoming>
      <bpmn:outgoing>F_Flow_DismissalPath</bpmn:outgoing>
      <bpmn:outgoing>F_Flow_TrainingPath</bpmn:outgoing>
      <bpmn:outgoing>F_Flow_RewardPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Path 1: Dismissal (<20%) -->
    <bpmn:sequenceFlow id="F_Flow_DismissalPath" name="Performance &lt; 20%" sourceRef="G_PerformanceCheck" targetRef="T_SuggestDismissal">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${performance &lt; 20}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Task: Suggest Dismissal (Management) -->
    <bpmn:task id="T_SuggestDismissal" name="Suggest Employee's Dismissal">
      <bpmn:incoming>F_Flow_DismissalPath</bpmn:incoming>
      <bpmn:outgoing>F_Flow_HR_Dismisssion</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Dismiss Employee (HR) -->
    <bpmn:task id="T_DismissEmployee" name="Dismiss the Employee">
      <bpmn:incoming>F_Flow_HR_Dismisssion</bpmn:incoming>
      <bpmn:outgoing>F_Flow_End_Dismissal</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 1 -->
    <bpmn:endEvent id="E_Dismisssed" name="Employee Dismissed">
      <bpmn:incoming>F_Flow_End_Dismissal</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Path 2: Training (>=20% and <=50%) -->
    <bpmn:sequenceFlow id="F_Flow_TrainingPath" name="Performance &gt;= 20% AND &lt; 50%" sourceRef="G_PerformanceCheck" targetRef="T_SuggestTraining">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${performance >= 20 and performance <= 50}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Task: Suggest Training (Management) -->
    <bpmn:task id="T_SuggestTraining" name="Suggest Employee for Training">
      <bpmn:incoming>F_Flow_TrainingPath</bpmn:incoming>
      <bpmn:outgoing>F_Flow_HR_Training</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Provide Training (HR) -->
    <bpmn:task id="T_ProvideTraining" name="Provide Training">
      <bpmn:incoming>F_Flow_HR_Training</bpmn:incoming>
      <bpmn:outgoing>F_Flow_End_Training</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 2 -->
    <bpmn:endEvent id="E_TrainingDone" name="Training Completed">
      <bpmn:incoming>F_Flow_End_Training</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Path 3: Reward (>75%) -->
    <bpmn:sequenceFlow id="F_Flow_RewardPath" name="Performance &gt; 75%" sourceRef="G_PerformanceCheck" targetRef="T_SuggestReward">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${performance > 75}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Task: Suggest Reward (Management) -->
    <bpmn:task id="T_SuggestReward" name="Suggest Employee for Reward">
      <bpmn:incoming>F_Flow_RewardPath</bpmn:incoming>
      <bpmn:outgoing>F_Flow_Gateway_RewardType</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2: Reward Type Decision -->
    <bpmn:exclusiveGateway id="G_RewardType" name="Reward Type">
      <bpmn:incoming>F_Flow_Gateway_RewardType</bpmn:incoming>
      <bpmn:outgoing>F_Flow_FinancialPath</bpmn:outgoing>
      <bpmn:outgoing>F_Flow_BenefitPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Path 3a: Financial Reward -->
    <bpmn:sequenceFlow id="F_Flow_FinancialPath" name="Financial Reward" sourceRef="G_RewardType" targetRef="T_CalculatePayReward">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${rewardType == 'financial'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Task: Calculate and Pay Reward (Finance) -->
    <bpmn:task id="T_CalculatePayReward" name="Calculate and Pay Financial Reward">
      <bpmn:incoming>F_Flow_FinancialPath</bpmn:incoming>
      <bpmn:outgoing>F_Flow_Merge_Reward</bpmn:outgoing>
    </bpmn:task>

    <!-- Path 3b: Other Benefit -->
    <bpmn:sequenceFlow id="F_Flow_BenefitPath" name="Other Benefit" sourceRef="G_RewardType" targetRef="T_ChooseBenefit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${rewardType == 'benefit'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Task: Choose Benefit (Management) -->
    <bpmn:task id="T_ChooseBenefit" name="Choose Appropriate Benefit">
      <bpmn:incoming>F_Flow_BenefitPath</bpmn:incoming>
      <bpmn:outgoing>F_Flow_Merge_Reward</bpmn:outgoing>
    </bpmn:task>

    <!-- Merge Point for Reward Paths -->
    <bpmn:exclusiveGateway id="G_MergeReward" name="Merge Reward Actions">
      <bpmn:incoming>F_Flow_Merge_Reward_1</bpmn:incoming>
      <bpmn:incoming>F_Flow_Merge_Reward_2</bpmn:incoming>
      <bpmn:outgoing>F_Flow_AnnouncePath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Announce Employee of Month (Management) -->
    <bpmn:task id="T_AnnounceEmployeeOfMonth" name="Announce Rewarded Employee">
      <bpmn:incoming>F_Flow_AnnouncePath</bpmn:incoming>
      <bpmn:outgoing>F_Flow_End_Reward</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 3 -->
    <bpmn:endEvent id="E_Rewarded" name="Employee of Month Announced">
      <bpmn:incoming>F_Flow_End_Reward</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows Connections -->
    <bpmn:sequenceFlow id="F_Flow_01" sourceRef="S_StartEvent" targetRef="T_CheckPerformance"/>
    <bpmn:sequenceFlow id="F_Flow_02" sourceRef="T_CheckPerformance" targetRef="G_PerformanceCheck"/>

    <!-- HR Dismissal Flow -->
    <bpmn:sequenceFlow id="F_Flow_HR_Dismisssion" name="" sourceRef="T_SuggestDismissal" targetRef="T_DismissEmployee">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- HR Training Flow -->
    <bpmn:sequenceFlow id="F_Flow_HR_Training" name="" sourceRef="T_SuggestTraining" targetRef="T_ProvideTraining">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- End Flows -->
    <bpmn:sequenceFlow id="F_Flow_End_Dismissal" sourceRef="T_DismissEmployee" targetRef="E_Dismisssed"/>
    <bpmn:sequenceFlow id="F_Flow_End_Training" sourceRef="T_ProvideTraining" targetRef="E_TrainingDone"/>

    <!-- Reward Merge Flows -->
    <bpmn:sequenceFlow id="F_Flow_Merge_Reward_1" name="" sourceRef="T_CalculatePayReward" targetRef="G_MergeReward">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Reward Merge Flows -->
    <bpmn:sequenceFlow id="F_Flow_Merge_Reward_2" name="" sourceRef="T_ChooseBenefit" targetRef="G_MergeReward">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Announce Flow -->
    <bpmn:sequenceFlow id="F_Flow_AnnouncePath" sourceRef="G_MergeReward" targetRef="T_AnnounceEmployeeOfMonth">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Final End Flow -->
    <bpmn:sequenceFlow id="F_Flow_End_Reward" sourceRef="T_AnnounceEmployeeOfMonth" targetRef="E_Rewarded"/>
  </bpmn:process>
</bpmn:definitions>