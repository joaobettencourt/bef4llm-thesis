<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_WebDesignProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_WebDesignProject">
    <bpmn:participant id="Participant_WebDesignTeam" name="Web Design Project Team" processRef="Process_WebDesign1" />
  </bpmn:collaboration>

  <bpmn:process id="Process_WebDesign1" isExecutable="true">
    <!-- Start Event -->
    <bpmn:startEvent id="StartMeetingInfo" name="Informational Meeting">
      <bpmn:outgoing>Flow_MeetingDecision</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Decision: Is meeting successful? -->
    <bpmn:exclusiveGateway id="Gate_MeetingSuccess" name="Meeting Successful?">
      <bpmn:incoming>Flow_MeetingDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_EndProcess_No</bpmn:outgoing>
      <bpmn:outgoing>Flow_StoryboardStart</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event if meeting not successful -->
    <bpmn:endEvent id="EndMeetingFailed" name="Process Ended">
      <bpmn:incoming>Flow_EndProcess_No</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task: Create storyboard -->
    <bpmn:task id="Task_StoryboardCreate" name="Create Storyboard">
      <bpmn:incoming>Flow_StoryboardStart</bpmn:incoming>
      <bpmn:outgoing>Flow_AgreementDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Decision: Agreement on storyboard -->
    <bpmn:exclusiveGateway id="Gate_StoryboardAgreement" name="Storyboards Agreed?">
      <bpmn:incoming>Flow_AgreementDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_DevContentParallel</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Parallel Split for Development and Content -->
    <bpmn:parallelGateway id="Gate_ParallelStart" name="Development &amp; Content">
      <bpmn:incoming>Flow_DevContentParallel</bpmn:incoming>
      <bpmn:outgoing>Flow_DevelopmentTask</bpmn:outgoing>
      <bpmn:outgoing>Flow_ContentDraftStart</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Design and Development -->
    <bpmn:task id="Task_DevDevelopment" name="Design &amp; Develop Website">
      <bpmn:incoming>Flow_DevelopmentTask</bpmn:incoming>
      <bpmn:outgoing>Flow_MergeDevContent</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Prepare initial content draft -->
    <bpmn:task id="Task_ContentDraft" name="Prepare Initial Content Draft">
      <bpmn:incoming>Flow_ContentDraftStart</bpmn:incoming>
      <bpmn:outgoing>Flow_ReviewDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Decision: Is review needed? -->
    <bpmn:exclusiveGateway id="Gate_ReviewNeeded" name="Content Review Needed?">
      <bpmn:incoming>Flow_ReviewDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_MarketingReview</bpmn:outgoing>
      <bpmn:outgoing>Flow_ContentFinalStart</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Marketing team reviews content -->
    <bpmn:task id="Task_MarketingReview" name="Marketing Team Reviews Content">
      <bpmn:incoming>Flow_MarketingReview</bpmn:incoming>
      <bpmn:outgoing>Flow_ContentFinalStart2</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Web design team creates final content -->
    <bpmn:task id="Task_ContentFinal" name="Create Final Content Version">
      <bpmn:incoming>Flow_ContentFinalStart</bpmn:incoming>
      <bpmn:outgoing>Flow_MergeDevContent2</bpmn:outgoing>
    </bpmn:task>

    <!-- Merge point for content paths -->
    <bpmn:parallelGateway id="Gate_ReviewMerge" name="">
      <bpmn:incoming>Flow_ContentFinalStart2</bpmn:incoming>
      <bpmn:outgoing>Flow_MergeDevContent3</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Merge point for Development and Content completion -->
    <bpmn:parallelGateway id="Gate_DevContentMerge" name="">
      <bpmn:incoming>Flow_MergeDevContent</bpmn:incoming>
      <bpmn:outgoing>Flow_BuildWebsiteStart</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Build and review website -->
    <bpmn:task id="Task_BuildReview" name="Build &amp; Review Website">
      <bpmn:incoming>Flow_BuildWebsiteStart</bpmn:incoming>
      <bpmn:outgoing>Flow_ApprovalDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Decision: Site approved? -->
    <bpmn:exclusiveGateway id="Gate_SiteApproved" name="Site Approved?">
      <bpmn:incoming>Flow_ApprovalDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_EndSuccess</bpmn:outgoing>
      <bpmn:outgoing>Flow_BuildLoopBack</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event if site approved -->
    <bpmn:endEvent id="EndProcessSuccess" name="Website Completed">
      <bpmn:incoming>Flow_EndSuccess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Flow_MeetingDecision" sourceRef="StartMeetingInfo" targetRef="Gate_MeetingSuccess" />
    
    <bpmn:sequenceFlow id="Flow_EndProcess_No" name="No - Not Successful" sourceRef="Gate_MeetingSuccess" targetRef="EndMeetingFailed">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${meetingSuccessful = false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_StoryboardStart" name="Yes - Successful" sourceRef="Gate_MeetingSuccess" targetRef="Task_StoryboardCreate">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${meetingSuccessful = true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_AgreementDecision" sourceRef="Task_StoryboardCreate" targetRef="Gate_StoryboardAgreement" />

    <bpmn:sequenceFlow id="Flow_DevContentParallel" name="Storyboards Agreed" sourceRef="Gate_StoryboardAgreement" targetRef="Gate_ParallelStart">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${storyboardAgreed = true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_DevelopmentTask" sourceRef="Gate_ParallelStart" targetRef="Task_DevDevelopment" />

    <bpmn:sequenceFlow id="Flow_ContentDraftStart" sourceRef="Gate_ParallelStart" targetRef="Task_ContentDraft" />

    <bpmn:sequenceFlow id="Flow_ReviewDecision" sourceRef="Task_ContentDraft" targetRef="Gate_ReviewNeeded" />

    <bpmn:sequenceFlow id="Flow_MarketingReview" name="Yes - Review Needed" sourceRef="Gate_ReviewNeeded" targetRef="Task_MarketingReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${reviewNeeded = true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_ContentFinalStart" name="No - No Review Needed" sourceRef="Gate_ReviewNeeded" targetRef="Task_ContentFinal">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${reviewNeeded = false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_MergeDevContent" sourceRef="Task_DevDevelopment" targetRef="Gate_ReviewMerge" />

    <bpmn:sequenceFlow id="Flow_ContentFinalStart2" name="" sourceRef="Task_MarketingReview" targetRef="Gate_ReviewMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${reviewCompleted = true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_MergeDevContent2" sourceRef="Task_ContentFinal" targetRef="Gate_ReviewMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${contentCompleted = true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_MergeDevContent3" sourceRef="Gate_ReviewMerge" targetRef="Gate_DevContentMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${contentFinalized = true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_BuildWebsiteStart" sourceRef="Gate_DevContentMerge" targetRef="Task_BuildReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${devAndContentComplete = true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_ApprovalDecision" sourceRef="Task_BuildReview" targetRef="Gate_SiteApproved">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${siteReady = true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_EndSuccess" name="Yes - Approved" sourceRef="Gate_SiteApproved" targetRef="EndProcessSuccess">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${siteApproved = true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_BuildLoopBack" name="No - Not Approved" sourceRef="Gate_SiteApproved" targetRef="Task_BuildReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${siteApproved = false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>