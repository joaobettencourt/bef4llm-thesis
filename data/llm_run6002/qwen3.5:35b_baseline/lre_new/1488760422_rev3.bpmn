<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_InvoiceProcess_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_InvoiceProcessing">
    <bpmn:participant id="Participant_AdminOffice" name="Admin Office (SSP)" processRef="Proc_InvoiceProcess_01" />
  </bpmn:collaboration>

  <bpmn:process id="Proc_InvoiceProcess_01" isExecutable="true">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_AdminOffice" name="Admin Office">
        <bpmn:flowNodeRef>StartEvent_InvoiceReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SortInvoices</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AttachEntryForm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterRequiredInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CompletenessCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_InvoiceIncomplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterSLAInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_HighPriorityCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ApplyRedStamp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MergeGateway_Priorities</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ComplianceCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_NonCompliantOptions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MergeGateway_OptionsConverge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AllocateToDEO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ProcessComplete</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_InvoiceReceived" name="Receive Invoice">
      <bpmn:outgoing>Flow_SortInvoices</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Sort Invoices -->
    <bpmn:task id="Task_SortInvoices" name="Sort Invoice (Client &amp; Vendor)">
      <bpmn:incoming>Flow_SortInvoices</bpmn:incoming>
      <bpmn:outgoing>Flow_AttachEntryForm</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Attach Entry Form -->
    <bpmn:task id="Task_AttachEntryForm" name="Attach Invoice Entry Form">
      <bpmn:incoming>Flow_AttachEntryForm</bpmn:incoming>
      <bpmn:outgoing>Flow_EnterRequiredInfo</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Enter Required Info -->
    <bpmn:task id="Task_EnterRequiredInfo" name="Enter Required Info">
      <bpmn:incoming>Flow_EnterRequiredInfo</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckCompleteness</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Check Completeness -->
    <bpmn:exclusiveGateway id="Gateway_CompletenessCheck" name="Invoice Complete?">
      <bpmn:incoming>Flow_CheckCompleteness</bpmn:incoming>
      <bpmn:outgoing>Flow_SendMessageIncomplete</bpmn:outgoing>
      <bpmn:outgoing>Flow_EnterSLAInfo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event 1 -->
    <bpmn:endEvent id="EndEvent_InvoiceIncomplete" name="Invoice Not Complete">
      <bpmn:incoming>Flow_SendMessageIncomplete</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task: Enter SLA Info & Check Priority -->
    <bpmn:task id="Task_EnterSLAInfo" name="Enter SLA Info &amp; Check Priority">
      <bpmn:incoming>Flow_EnterSLAInfo</bpmn:incoming>
      <bpmn:outgoing>Flow_HighPriorityCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2: High Priority Check -->
    <bpmn:exclusiveGateway id="Gateway_HighPriorityCheck" name="High Priority?">
      <bpmn:incoming>Flow_HighPriorityCheck</bpmn:incoming>
      <bpmn:outgoing>Flow_ApplyRedStampPath</bpmn:outgoing>
      <bpmn:outgoing>Flow_SkipStampToCompliance</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Apply Red Stamp -->
    <bpmn:task id="Task_ApplyRedStamp" name="Apply Red Stamp">
      <bpmn:incoming>Flow_ApplyRedStampPath</bpmn:incoming>
      <bpmn:outgoing>Flow_RedStampToMerge</bpmn:outgoing>
    </bpmn:task>

    <!-- Merge Gateway for Priority Paths -->
    <bpmn:exclusiveGateway id="MergeGateway_Priorities" name="">
      <bpmn:incoming>Flow_SkipStampToCompliance</bpmn:incoming>
      <bpmn:incoming>Flow_RedStampToMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckInvoiceCompliance</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Check Compliance -->
    <bpmn:task id="Task_CheckCompliance" name="Check Invoice Compliance">
      <bpmn:incoming>Flow_CheckInvoiceCompliance</bpmn:incoming>
      <bpmn:outgoing>Flow_CompliantPath</bpmn:outgoing>
      <bpmn:outgoing>Flow_NonCompliantOptions</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 3: Compliance Check -->
    <bpmn:exclusiveGateway id="Gateway_ComplianceCheck" name="Invoice Compliant?">
      <bpmn:incoming>Flow_CheckInvoiceCompliance</bpmn:incoming>
      <bpmn:outgoing>Flow_AllocateToDEOPath</bpmn:outgoing>
      <bpmn:outgoing>Flow_NonCompliantOptions</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Path to Final Allocation -->
    <bpmn:sequenceFlow id="Flow_AllocateToDEOPath" name="Yes (Complete)" sourceRef="Gateway_ComplianceCheck" targetRef="Task_AllocateToDEO">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${compliant}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Inclusive Gateway for Non-Complaint Options -->
    <bpmn:inclusiveGateway id="InclusiveGateway_NonCompliantOptions" name="Non-Compliance Handling">
      <bpmn:incoming>Flow_NonCompliantOptions</bpmn:incoming>
      <bpmn:outgoing>Flow_ExperienceStaffProcessPath</bpmn:outgoing>
      <bpmn:outgoing>Flow_CallClientRequestInfoPath</bpmn:outgoing>
      <bpmn:outgoing>Flow_PostalMailRequestInfoPath</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Option 1 -->
    <bpmn:task id="Task_ExperienceStaffProcess" name="Send to Experience Staff">
      <bpmn:incoming>Flow_ExperienceStaffProcessPath</bpmn:incoming>
      <bpmn:outgoing>Flow_ConvergeToAllocate</bpmn:outgoing>
    </bpmn:task>

    <!-- Option 2 -->
    <bpmn:task id="Task_CallClientRequest" name="Call Client &amp; Request Info">
      <bpmn:incoming>Flow_CallClientRequestInfoPath</bpmn:incoming>
      <bpmn:outgoing>Flow_ConvergeToAllocate</bpmn:outgoing>
    </bpmn:task>

    <!-- Option 3 -->
    <bpmn:task id="Task_PostalMailRequest" name="Send Postal Mail Request (Reminder after 10h)">
      <bpmn:incoming>Flow_PostalMailRequestInfoPath</bpmn:incoming>
      <bpmn:outgoing>Flow_ConvergeToAllocate</bpmn:outgoing>
    </bpmn:task>

    <!-- Merge Gateway for Options -->
    <bpmn:exclusiveGateway id="MergeGateway_OptionsConverge" name="">
      <bpmn:incoming>Flow_ConvergeToAllocate</bpmn:incoming>
      <bpmn:outgoing>Task_AllocateToDEO</bpmn:outgoing> <!-- Correction needed below -->
    </bpmn:exclusiveGateway>

    <!-- Final Allocation Task -->
    <bpmn:task id="Task_AllocateToDEO" name="Allocate Invoice to DEO">
      <bpmn:incoming>Flow_ConvergeToAllocate</bpmn:incoming>
      <bpmn:outgoing>Flow_ProcessComplete</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_ProcessComplete" name="Process Complete">
      <bpmn:incoming>Flow_ProcessComplete</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows Definitions (Corrected) -->
    <bpmn:sequenceFlow id="Flow_SortInvoices" sourceRef="StartEvent_InvoiceReceived" targetRef="Task_SortInvoices" />
    <bpmn:sequenceFlow id="Flow_AttachEntryForm" sourceRef="Task_SortInvoices" targetRef="Task_AttachEntryForm" />
    <bpmn:sequenceFlow id="Flow_EnterRequiredInfo" sourceRef="Task_AttachEntryForm" targetRef="Task_EnterRequiredInfo" />
    <bpmn:sequenceFlow id="Flow_CheckCompleteness" sourceRef="Task_EnterRequiredInfo" targetRef="Gateway_CompletenessCheck" />

    <!-- Completeness Check Flows -->
    <bpmn:sequenceFlow id="Flow_SendMessageIncomplete" name="No (Not Complete)" sourceRef="Gateway_CompletenessCheck" targetRef="EndEvent_InvoiceIncomplete">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!complete}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Completeness Yes Flow -->
    <bpmn:sequenceFlow id="Flow_EnterSLAInfo" name="Yes (Complete)" sourceRef="Gateway_CompletenessCheck" targetRef="Task_EnterSLAInfo">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${complete}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Priority Check Flows -->
    <bpmn:sequenceFlow id="Flow_HighPriorityCheck" sourceRef="Task_EnterSLAInfo" targetRef="Gateway_HighPriorityCheck" />
    <bpmn:sequenceFlow id="Flow_ApplyRedStampPath" name="Yes (High)" sourceRef="Gateway_HighPriorityCheck" targetRef="Task_ApplyRedStamp">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${highPriority}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Priority Skip Flow -->
    <bpmn:sequenceFlow id="Flow_SkipStampToCompliance" name="No (Normal)" sourceRef="Gateway_HighPriorityCheck" targetRef="MergeGateway_Priorities">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!highPriority}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Red Stamp to Merge -->
    <bpmn:sequenceFlow id="Flow_RedStampToMerge" sourceRef="Task_ApplyRedStamp" targetRef="MergeGateway_Priorities" />

    <!-- Compliance Check Flow -->
    <bpmn:sequenceFlow id="Flow_CheckInvoiceCompliance" sourceRef="MergeGateway_Priorities" targetRef="Task_CheckCompliance" />

    <!-- Compliance Decision Flows -->
    <bpmn:sequenceFlow id="Flow_CompliantPath" name="Yes (Complete)" sourceRef="Gateway_ComplianceCheck" targetRef="Task_AllocateToDEO">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${compliant}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Non-Complaint Options Flow -->
    <bpmn:sequenceFlow id="Flow_NonCompliantOptions" name="No (Incomplete)" sourceRef="Gateway_ComplianceCheck" targetRef="InclusiveGateway_NonCompliantOptions">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!compliant}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Option Flows -->
    <bpmn:sequenceFlow id="Flow_ExperienceStaffProcessPath" sourceRef="InclusiveGateway_NonCompliantOptions" targetRef="Task_ExperienceStaffProcess">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${option=staff}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_CallClientRequestInfoPath" sourceRef="InclusiveGateway_NonCompliantOptions" targetRef="Task_CallClientRequest">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${option=call}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_PostalMailRequestInfoPath" sourceRef="InclusiveGateway_NonCompliantOptions" targetRef="Task_PostalMailRequest">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${option=mail}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Convergence Flow -->
    <bpmn:sequenceFlow id="Flow_ConvergeToAllocate" sourceRef="Task_ExperienceStaffProcess" targetRef="MergeGateway_OptionsConverge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${infoObtained}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Note: The previous XML had a logic error where MergeGateway targetRef was Task_AllocateToDEO directly in the definition but flow ID mismatch. Correcting below -->
    
    <bpmn:exclusiveGateway id="MergeGateway_OptionsConverge" name="">
      <bpmn:incoming>Flow_ConvergeToAllocate</bpmn:incoming> <!-- Simplified for single path convergence logic representation -->
       <bpmn:outgoing>SequenceFlow_MergeFinal</bpmn:outgoing>
    </bpmn:exclusiveGateway>

     <bpmn:sequenceFlow id="SequenceFlow_MergeFinal" sourceRef="MergeGateway_OptionsConverge" targetRef="Task_AllocateToDEO">
      <!-- Merging logic for all three options -->
       <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${infoObtained}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

     <bpmn:task id="Task_AllocateToDEO" name="Allocate Invoice to DEO">
      <bpmn:incoming>SequenceFlow_MergeFinal</bpmn:incoming>
       <bpmn:outgoing>Flow_ProcessComplete</bpmn:outgoing>
    </bpmn:task>

     <!-- End Event -->
    <bpmn:endEvent id="EndEvent_ProcessComplete" name="Process Complete">
      <bpmn:incoming>Flow_ProcessComplete</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_ProcessComplete" sourceRef="Task_AllocateToDEO" targetRef="EndEvent_ProcessComplete" />

  </bpmn:process>
</bpmn:definitions>