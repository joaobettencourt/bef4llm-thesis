<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_PayPalOnboarding_v2" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_OnboardingProcess_v2">
    <bpmn:participant id="Participant_MainPaypalSystem_v2" name="PayPal Onboarding Process" processRef="Process_1_v2" />
  </bpmn:collaboration>

  <bpmn:process id="Process_1_v2" isExecutable="true">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Client_v2" name="PayPal Client">
        <bpmn:flowNodeRef>Seller_StartEvent_v2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_EnterDetails_v2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_VerifyDeposits_v2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System_v2" name="PayPal System">
        <bpmn:flowNodeRef>Seller_Service_InitiateDeposits_v2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateThrowEvent_WaitNotify_v2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_SystemValidate_v2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Seller_Gateway_MatchCheck_v2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Confirmed_v2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_RemoveAccount_v2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="Seller_StartEvent_v2" name="Start Bank Account Addition">
      <bpmn:outgoing>Seller_Flow_01_v2</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Client Task: Enter Details -->
    <bpmn:userTask id="UserTask_EnterDetails_v2" name="Enter Bank Details">
      <bpmn:incoming>Seller_Flow_01_v2</bpmn:incoming>
      <bpmn:outgoing>Seller_Flow_02_v2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- System Task: Initiate Deposits -->
    <bpmn:serviceTask id="Seller_Service_InitiateDeposits_v2" name="Initiate Micro-deposits">
      <bpmn:incoming>Seller_Flow_02_v2</bpmn:incoming>
      <bpmn:outgoing>Seller_Flow_03_Wait_v2</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Intermediate Event: Wait/Notify (Timer) -->
    <bpmn:intermediateThrowEvent id="IntermediateThrowEvent_WaitNotify_v2" name="Wait 3-5 Days &amp; Notify">
      <bpmn:incoming>Seller_Flow_03_Wait_v2</bpmn:incoming>
      <bpmn:outgoing>Seller_Flow_04_VerifyReq_v2</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <!-- Client Task: Verify Amounts -->
    <bpmn:userTask id="UserTask_VerifyDeposits_v2" name="Verify Deposit Amounts">
      <bpmn:incoming>Seller_Flow_04_VerifyReq_v2</bpmn:incoming>
      <bpmn:outgoing>Seller_Flow_05_SystemCheck_v2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- System Task: Validate -->
    <bpmn:serviceTask id="UserTask_SystemValidate_v2" name="System Validation Check">
      <bpmn:incoming>Seller_Flow_05_SystemCheck_v2</bpmn:incoming>
      <bpmn:outgoing>Seller_Flow_GatewayIn_v2</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Gateway -->
    <bpmn:exclusiveGateway id="Seller_Gateway_MatchCheck_v2" name="Values Match?">
      <bpmn:incoming>Seller_Flow_GatewayIn_v2</bpmn:incoming>
      <bpmn:outgoing>Seller_Flow_SuccessPath_v2</bpmn:outgoing>
      <bpmn:outgoing>Seller_Flow_FailPath_v2</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Success Path -->
    <bpmn:endEvent id="EndEvent_Confirmed_v2" name="Bank Account Confirmed">
      <bpmn:incoming>Seller_Flow_SuccessPath_v2</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Fail Path Task -->
    <bpmn:userTask id="UserTask_RemoveAccount_v2" name="Remove Bank Details from System">
      <bpmn:incoming>Seller_Flow_FailPath_v2</bpmn:incoming>
      <bpmn:outgoing>Seller_Flow_06_EndFail_v2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Fail Path End -->
    <bpmn:endEvent id="EndEvent_Removed_v2" name="Verification Failed">
      <bpmn:incoming>Seller_Flow_06_EndFail_v2</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Seller_Flow_01_v2" name="Client Action" sourceRef="Seller_StartEvent_v2" targetRef="UserTask_EnterDetails_v2">
      <bpmn:name>Client Action</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Seller_Flow_02_v2" name="Submit Details" sourceRef="UserTask_EnterDetails_v2" targetRef="Seller_Service_InitiateDeposits_v2">
      <bpmn:name>Submit Details</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Seller_Flow_03_Wait_v2" name="Initiated" sourceRef="Seller_Service_InitiateDeposits_v2" targetRef="IntermediateThrowEvent_WaitNotify_v2">
      <bpmn:name>Initiated</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Seller_Flow_04_VerifyReq_v2" name="Notification Sent" sourceRef="IntermediateThrowEvent_WaitNotify_v2" targetRef="UserTask_VerifyDeposits_v2">
      <bpmn:name>Notification Sent</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Seller_Flow_05_SystemCheck_v2" name="User Input Submitted" sourceRef="UserTask_VerifyDeposits_v2" targetRef="UserTask_SystemValidate_v2">
      <bpmn:name>User Input Submitted</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Seller_Flow_GatewayIn_v2" name="Validation Complete" sourceRef="UserTask_SystemValidate_v2" targetRef="Seller_Gateway_MatchCheck_v2">
      <bpmn:name>Validation Complete</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Seller_Flow_SuccessPath_v2" name="Match = Yes" sourceRef="Seller_Gateway_MatchCheck_v2" targetRef="EndEvent_Confirmed_v2">
      <bpmn:name>Confirmed</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Seller_Flow_FailPath_v2" name="Match = No" sourceRef="Seller_Gateway_MatchCheck_v2" targetRef="UserTask_RemoveAccount_v2">
      <bpmn:name>Mismatch</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Seller_Flow_06_EndFail_v2" name="Removed" sourceRef="UserTask_RemoveAccount_v2" targetRef="EndEvent_Removed_v2">
      <bpmn:name>Action Complete</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>