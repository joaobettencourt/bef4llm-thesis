<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_RegistrationProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_VisitorRegistration">
    <bpmn:participant id="Participant_RegistartionProcess" name="Visitor Registration Process" processRef="Process_Registration1" />
  </bpmn:collaboration>

  <bpmn:process id="Process_Registration1" isExecutable="true">
    
    <!-- Start Event -->
    <bpmn:startEvent id="Start_VisitorRegistration" name="Visitor fills registration form">
      <bpmn:outgoing>Flow_StartToChecks</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Parallel Gateway for initial checks -->
    <bpmn:parallelGateway id="Parallel_ChecksStart" name="Check Availability &amp; Credit">
      <bpmn:incoming>Flow_StartToChecks</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckAvailability</bpmn:outgoing>
      <bpmn:outgoing>Flow_CheckCreditRating</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Check Product Availability -->
    <bpmn:task id="Task_CheckProductAvailability" name="Check product availability">
      <bpmn:incoming>Flow_CheckAvailability</bpmn:incoming>
      <bpmn:outgoing>Flow_AvailabilityToMerge</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Check Credit Rating (Schufa) -->
    <bpmn:task id="Task_CheckCreditRating" name="Check credit rating">
      <bpmn:incoming>Flow_CheckCreditRating</bpmn:incoming>
      <bpmn:outgoing>Flow_CreditToGateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway for Credit Rating Decision -->
    <bpmn:exclusiveGateway id="Gateway_CreditDecision" name="Credit rating &gt; 9000?">
      <bpmn:incoming>Flow_CreditToGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_UnsuccessfulPath</bpmn:outgoing>
      <bpmn:outgoing>Flow_SuccessfulPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event for Unsuccessful Registration -->
    <bpmn:endEvent id="End_RegistrationUnsuccessful" name="Registration unsuccessful">
      <bpmn:incoming>Flow_UnsuccessfulPath</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task: Create Interim Customer Dataset Record -->
    <bpmn:task id="Task_CreateInterimRecord" name="Create interim customer dataset record">
      <bpmn:incoming>Flow_SuccessfulPath</bpmn:incoming>
      <bpmn:outgoing>Flow_ToParallelSubprocesses</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway for Sub-processes -->
    <bpmn:parallelGateway id="Parallel_SubprocessStart" name="Device Provision &amp; ISP Registration">
      <bpmn:incoming>Flow_ToParallelSubprocesses</bpmn:incoming>
      <bpmn:outgoing>Flow_DeviceProvisionPath</bpmn:outgoing>
      <bpmn:outgoing>Flow_ISPRegistrationPath</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Device Provision -->
    <bpmn:task id="Task_DeviceProvision" name="Device provision">
      <bpmn:incoming>Flow_DeviceProvisionPath</bpmn:incoming>
      <bpmn:outgoing>Flow_ProvisionToMerge</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Register Customer Account at ISP Nodes -->
    <bpmn:task id="Task_ISPRegistration" name="Register customer account at ISP nodes">
      <bpmn:incoming>Flow_ISPRegistrationPath</bpmn:incoming>
      <bpmn:outgoing>Flow_ISToMerge</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway to Merge Sub-processes -->
    <bpmn:parallelGateway id="Parallel_SubprocessEnd" name="Wait for completion">
      <bpmn:incoming>Flow_ProvisionToMerge</bpmn:incoming>
      <bpmn:incoming>Flow_ISToMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_ToWelcomePackage</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Create and Send Welcome Package -->
    <bpmn:task id="Task_WelcomePackage" name="Create welcome package">
      <bpmn:incoming>Flow_ToWelcomePackage</bpmn:incoming>
      <bpmn:outgoing>Flow_SendToCustomer</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Send Welcome Package -->
    <bpmn:task id="Task_SendWelcomePackage" name="Send welcome package to customer">
      <bpmn:incoming>Flow_SendToCustomer</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEndEvent</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event for Successful Registration -->
    <bpmn:endEvent id="End_RegistrationSuccessful" name="Registration completed successfully">
      <bpmn:incoming>Flow_ToEndEvent</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Flow_StartToChecks" sourceRef="Start_VisitorRegistration" targetRef="Parallel_ChecksStart" />
    
    <bpmn:sequenceFlow id="Flow_CheckAvailability" sourceRef="Parallel_ChecksStart" targetRef="Task_CheckProductAvailability" />
    
    <bpmn:sequenceFlow id="Flow_CheckCreditRating" sourceRef="Parallel_ChecksStart" targetRef="Task_CheckCreditRating" />
    
    <bpmn:sequenceFlow id="Flow_AvailabilityToMerge" sourceRef="Task_CheckProductAvailability" targetRef="Gateway_CreditDecision" />
    
    <bpmn:sequenceFlow id="Flow_CreditToGateway" sourceRef="Task_CheckCreditRating" targetRef="Gateway_CreditDecision" />
    
    <bpmn:sequenceFlow id="Flow_UnsuccessfulPath" name="Yes (&gt;9000)" sourceRef="Gateway_CreditDecision" targetRef="End_RegistrationUnsuccessful">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${creditRating &gt; 9000}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    
    <bpmn:sequenceFlow id="Flow_SuccessfulPath" name="No (≤9000)" sourceRef="Gateway_CreditDecision" targetRef="Task_CreateInterimRecord">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${creditRating &lt;= 9000}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    
    <bpmn:sequenceFlow id="Flow_ToParallelSubprocesses" sourceRef="Task_CreateInterimRecord" targetRef="Parallel_SubprocessStart" />
    
    <bpmn:sequenceFlow id="Flow_DeviceProvisionPath" sourceRef="Parallel_SubprocessStart" targetRef="Task_DeviceProvision" />
    
    <bpmn:sequenceFlow id="Flow_ISPRegistrationPath" sourceRef="Parallel_SubprocessStart" targetRef="Task_ISPRegistration" />
    
    <bpmn:sequenceFlow id="Flow_ProvisionToMerge" sourceRef="Task_DeviceProvision" targetRef="Parallel_SubprocessEnd" />
    
    <bpmn:sequenceFlow id="Flow_ISToMerge" sourceRef="Task_ISPRegistration" targetRef="Parallel_SubprocessEnd" />
    
    <bpmn:sequenceFlow id="Flow_ToWelcomePackage" sourceRef="Parallel_SubprocessEnd" targetRef="Task_WelcomePackage" />
    
    <bpmn:sequenceFlow id="Flow_SendToCustomer" sourceRef="Task_WelcomePackage" targetRef="Task_SendWelcomePackage" />
    
    <bpmn:sequenceFlow id="Flow_ToEndEvent" sourceRef="Task_SendWelcomePackage" targetRef="End_RegistrationSuccessful" />

  </bpmn:process>
</bpmn:definitions>