<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_RecourseProcess">
  <bpmn:collaboration id="Collab_Recourse">
    <bpmn:participant id="Participant_Clerk" name="Insurance Clerk" processRef="Process_RecourseMain" />
  </bpmn:collaboration>

  <bpmn:process id="Process_RecourseMain" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Clerk" name="Clerk">
        <bpmn:flowNodeRef>StartEvent_InfoReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckRecoursePossibility</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RecoursePossible</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendPaymentRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Boundary_DeadlineReached</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_MoneyReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckObjectionReasoning</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ObjectionValid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ClosedNoRecourse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BookMoney</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ClosedPaid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ObjectionAccepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ForwardCollectionAgency</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_HandedToCollection</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_InfoReceived" name="Recourse Information Received">
      <bpmn:outgoing>Flow_Start_CheckCase</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Check Case -->
    <bpmn:task id="Task_CheckRecoursePossibility" name="Check Recourse Possibility">
      <bpmn:incoming>Flow_Start_CheckCase</bpmn:incoming>
      <bpmn:outgoing>Flow_Case_GatewayPossible</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Is Recourse Possible? -->
    <bpmn:exclusiveGateway id="Gateway_RecoursePossible" name="Is recourse possible?">
      <bpmn:incoming>Flow_Case_GatewayPossible</bpmn:incoming>
      <bpmn:outgoing>Flow_No_Possible_End</bpmn:outgoing>
      <bpmn:outgoing>Flow_Yes_SendRequest</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event 1: No Recourse -->
    <bpmn:endEvent id="EndEvent_ClosedNoRecourse" name="Case Closed (Not Possible)">
      <bpmn:incoming>Flow_No_Possible_End</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task 2: Send Request & Reminder -->
    <bpmn:task id="Task_SendPaymentRequest" name="Send Payment Request & Set Reminder">
      <bpmn:incoming>Flow_Yes_SendRequest</bpmn:outgoing>
      <bpmn:outgoing>Flow_Task_Done</bpmn:outgoing>
    </bpmn:task>

    <!-- Boundary Event 1: Deadline Reached (Timer) -->
    <bpmn:endEvent id="Event_Boundary_DeadlineReached" name="Deadline Reached">
      <bpmn:incoming>Flow_Timer_AgencyForward</bpmn:outgoing>
    </bpmn:endEvent>

    <!-- Boundary Event 2: Receive Money (Message) -->
    <bpmn:startEvent id="EndEvent_MoneyReceived" name="Receive Money">
      <bpmn:incoming>Flow_Message_PaymentBooked</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Boundary Event 3: Disagreement (Message) -->
    <bpmn:endEvent id="EndEvent_Disagreement" name="Insurant Disagrees">
      <bpmn:incoming>Flow_Message_ObjectionCheck</bpmn:outgoing>
    </bpmn:endEvent>

    <!-- Task 3: Check Objection Reasoning -->
    <bpmn:task id="Task_CheckObjectionReasoning" name="Check Objection Reasoning">
      <bpmn:incoming>Flow_Message_ObjectionCheck</bpmn:outgoing>
      <bpmn:outgoing>Flow_Reason_GatewayValid</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2: Is Reasoning Valid? -->
    <bpmn:exclusiveGateway id="Gateway_ObjectionValid" name="Is reasoning valid?">
      <bpmn:incoming>Flow_Reason_GatewayValid</bpmn:outgoing>
      <bpmn:outgoing>Flow_Valid_ClosedCase</bpmn:outgoing>
      <bpmn:outgoing>Flow_Invalid_AgencyForward</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event 2: Objection Accepted -->
    <bpmn:endEvent id="EndEvent_ObjectionAccepted" name="Case Closed (Objection Valid)">
      <bpmn:incoming>Flow_Valid_ClosedCase</bpmn:outgoing>
    </bpmn:endEvent>

    <!-- Task 4: Forward to Collection Agency -->
    <bpmn:task id="Task_ForwardCollectionAgency" name="Forward Case to Collection Agency">
      <bpmn:incoming>Flow_Timer_AgencyForward</bpmn:outgoing>
      <bpmn:incoming>Flow_Invalid_AgencyForward</bpmn:outgoing>
      <bpmn:outgoing>Flow_Final_Handover</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 3: Handed to Collection -->
    <bpmn:endEvent id="EndEvent_HandedToCollection" name="Case Closed (Agency)">
      <bpmn:incoming>Flow_Final_Handover</bpmn:outgoing>
    </bpmn:endEvent>

    <!-- Task 5: Book Money -->
    <bpmn:task id="Task_BookMoney" name="Make Booking">
      <bpmn:incoming>Flow_Message_PaymentBooked</bpmn:outgoing>
      <bpmn:outgoing>Flow_Final_ClosePaid</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 4: Paid -->
    <bpmn:endEvent id="EndEvent_ClosedPaid" name="Case Closed (Money Received)">
      <bpmn:incoming>Flow_Final_ClosePaid</bpmn:outgoing>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Flow_Start_CheckCase" sourceRef="StartEvent_InfoReceived" targetRef="Task_CheckRecoursePossibility">
      <bpmn:name name="Information Received"/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_Case_GatewayPossible" sourceRef="Task_CheckRecoursePossibility" targetRef="Gateway_RecoursePossible" />

    <bpmn:sequenceFlow id="Flow_No_Possible_End" name="No Possibility" sourceRef="Gateway_RecoursePossible" targetRef="EndEvent_ClosedNoRecourse">
      <bpmn:name name="Not Possible"/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_Yes_SendRequest" name="Possibility Exists" sourceRef="Gateway_RecoursePossible" targetRef="Task_SendPaymentRequest">
       <bpmn:name name="Is Recourse Possible?"/>
    </bpmn:sequenceFlow>

     <!-- Flows from Boundary Events -->
    <bpmn:sequenceFlow id="Flow_Timer_AgencyForward" sourceRef="Event_Boundary_DeadlineReached" targetRef="Task_ForwardCollectionAgency">
      <bpmn:name name="Deadline Reached"/>
    </bpmn:sequenceFlow>

     <bpmn:sequenceFlow id="Flow_Message_PaymentBooked" sourceRef="EndEvent_MoneyReceived" targetRef="Task_BookMoney">
       <bpmn:name name="Receive Money"/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_Message_ObjectionCheck" sourceRef="EndEvent_Disagreement" targetRef="Task_CheckObjectionReasoning">
      <bpmn:name name="Disagree with Recourse"/>
    </bpmn:sequenceFlow>

     <!-- Flows from Reasoning Check -->
    <bpmn:sequenceFlow id="Flow_Reason_GatewayValid" sourceRef="Task_CheckObjectionReasoning" targetRef="Gateway_ObjectionValid">
      <bpmn:name name="Check Validity"/>
    </bpmn:sequenceFlow>

     <bpmn:sequenceFlow id="Flow_Valid_ClosedCase" name="Right Reasoning" sourceRef="Gateway_ObjectionValid" targetRef="EndEvent_ObjectionAccepted">
       <bpmn:name name="Reason Valid?"/>
    </bpmn:sequenceFlow>

     <bpmn:sequenceFlow id="Flow_Invalid_AgencyForward" name="Wrong Reasoning" sourceRef="Gateway_ObjectionValid" targetRef="Task_ForwardCollectionAgency">
       <bpmn:name name="Reason Invalid?"/>
    </bpmn:sequenceFlow>

     <!-- Final Flows -->
    <bpmn:sequenceFlow id="Flow_Final_Handover" sourceRef="Task_ForwardCollectionAgency" targetRef="EndEvent_HandedToCollection">
      <bpmn:name name="Forwarded"/>
    </bpmn:sequenceFlow>

     <bpmn:sequenceFlow id="Flow_Final_ClosePaid" sourceRef="Task_BookMoney" targetRef="EndEvent_ClosedPaid">
       <bpmn:name name="Booking Complete"/>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>