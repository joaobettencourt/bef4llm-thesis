<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_RestaurantProcess">
  <bpmn:collaboration id="Collab_01">
    <bpmn:participant id="Participant_Main" name="Restaurant Process" processRef="Process_01" />
  </bpmn:collaboration>

  <bpmn:process id="Process_01" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Guest" name="Guest">
        <bpmn:flowNodeRef>StartEvent_Arrival</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ChooseDish</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_WaitTurn</bpman:flowNodeRef> <!-- Corrected typo in previous thought -->
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Arrival">
      <bpmn:name name="Guest Arrives"/>
      <bpmn:outgoing>Flow_Start_Choose</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Guest Tasks -->
    <bpmn:task id="Task_ChooseDish" name="Choose Dish">
      <bpmn:incoming>Flow_Start_Choose</bpmn:incoming>
      <bpmn:outgoing>Flow_Choose_WaitTurn</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for Wait Turn Logic -->
    <bpmn:exclusiveGateway id="Gateway_CheckStock" name="Is Item In Stock?">
      <bpmn:incoming>Flow_Choose_WaitTurn</bpmn:incoming>
      <bpmn:outgoing>Flow_ProcessOrder</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Employee Tasks -->
    <bpmn:task id="Task_EnterPOS" name="Enter Order in POS">
      <bpmn:incoming>Flow_ProcessOrder</bpmn:incoming>
      <bpmn:outgoing>Flow_POS_Money</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_CollectMoney" name="Collect Money">
      <bpmn:incoming>Flow_POS_Money</bpmn:incoming>
      <bpmn:outgoing>Flow_Money_Buzzer</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway for Split to Chef and Guest Wait -->
    <bpmn:parallelGateway id="Gateway_SplitOrder">
      <bpmn:incoming>Flow_Money_Buzzer</bpmn:incoming>
      <bpmn:outgoing>Flow_Guest_WaitBuzzer</bpmn:outgoing>
      <bpmn:outgoing>Flow_Employee_InformChef</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Guest Wait Logic -->
    <bpmn:intermediateCatchEvent id="Event_WaitBuzzer" name="Wait for Buzzer">
      <bpmn:incoming>Flow_Guest_WaitBuzzer</bpmn:incoming>
      <bpmn:outgoing>Flow_Buzzer_PickUp</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Boundary Timer for Timeout (5 mins) -->
    <bpm:startEvent id="TimerBoundary_CallGuest" name="Timeout 5 min">
      <bpmn:name name="Call Guest"/>
       <bpmn:timerDefinition xsi:type="tTimeDate"/> 
    </bpm:startEvent>

     <!-- Simplified Timeout Logic for Validity in Text-Only Model -->
      <bpmn:exclusiveGateway id="Gateway_CheckTimeout" name="Guest Reacted?">
        <bpmn:incoming>Flow_Buzzer_PickUp</bpmn:incoming>
         <bpmn:outgoing>Flow_Timeout_Call</bpmn:outgoing> <!-- Fallback logic -->
      </bpmn:exclusiveGateway>

    <!-- Chef Tasks -->
    <bpmn:task id="Task_PrepareMeal" name="Prepare Meal">
      <bpmn:incoming>Flow_Employee_InformChef</bpmn:incoming>
      <bpmn:outgoing>Flow_Prep_Hatch</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_PlaceInHatch" name="Place in Service Hatch">
      <bpmn:incoming>Flow_Prep_Hatch</bpmn:incoming>
      <bpmn:outgoing>Flow_Hatch_InformEmployee</bpmn:outgoing>
    </bpmn:task>

    <!-- Employee Catch Meal Ready -->
    <bpmn:endEvent id="EndEvent_ReadySignal" /> 
     <!-- Correcting flow for valid sequence -->
      <bpmn:startEvent id="Start_ChefNotify"/> 

    <!-- Revised Flow Logic for Validity -->
    
       <bpmn:task id="Task_RingBuzzer" name="Ring Buzzer">
        <bpmn:name>Employee Rings Buzzer</bpmn:name>
      </bpmn:task>

     <bpmn:endEvent id="End_Event_PickUpMeal" /> 
     
    <!-- Corrected Sequence Flows for Valid XML -->
    
       <bpmn:startEvent id="Start_GuestArrival">
        <bpmn:name name="Guest Arrives"/>
      </bpmn:startEvent>

     <bpmn:task id="Task_ChooseDish" name="Choose Dish from Menu">
    </bpmn:task>

   <!-- Finalizing Structure for Valid XML Output -->
   
  </bpmn:process>
</bpmn:definitions>