<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_ShippingProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_01">
    <bpmn:participant id="Participant_Main" name="Hardware Company Shipping Process" processRef="Proc_01" />
  </bpmn:collaboration>

  <bpmn:process id="Proc_01" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Secretary" name="Secretary">
        <bpmn:flowNodeRef>StartEvent_01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ClarifyMethod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SizeCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InviteCompanies</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectCompany</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WriteLabel</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Logistics" name="Logistics Dept Head">
        <bpmn:flowNodeRef>Gateway_InsuranceCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TakeInsurance</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Warehouse" name="Warehousemen">
        <bpmn:flowNodeRef>Gateway_ParallelFork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PackageGoods</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_01" name="Ship Goods">
      <bpmn:outgoing>Flow_Start_Clarify</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Clarify Method (Secretary) -->
    <bpmn:task id="Task_ClarifyMethod" name="Clarify Shipping Method">
      <bpmn:incoming>Flow_Start_Clarify</bpmn:incoming>
      <bpmn:outgoing>Flow_Clarity_Fork</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway (Warehouse starts here) -->
    <bpmn:parallelGateway id="Gateway_ParallelFork" name="Parallel Start">
      <bpmn:incoming>Flow_Clarity_Fork</bpmn:incoming>
      <bpmn:outgoing>Flow_Warehouse_Start</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Exclusive Gateway (Secretary) -->
    <bpmn:exclusiveGateway id="Gateway_SizeCheck" name="Is large amount?">
      <bpmn:incoming>Flow_Clarity_Fork</bpmn:incoming>
      <bpmn:outgoing>Flow_Large_Path</bpmn:outgoing>
      <bpmn:outgoing>Flow_Small_Path</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Path Large Amount -->
    <bpmn:task id="Task_InviteCompanies" name="Invite 3 Logistic Companies">
       <bpmn:incoming>Flow_Large_Path</bpmn:incoming>
      <bpmn:outgoing>Flow_Select_Company</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_SelectCompany" name="Select Logistic Company">
       <bpmn:incoming>Flow_Select_Company</bpmn:incoming>
      <bpmn:outgoing>Flow_Large_Join</bpmn:outgoing>
    </bpmn:task>

    <!-- Path Small Amount -->
    <bpmn:task id="Task_WriteLabel" name="Write Package Label">
       <bpmn:incoming>Flow_Small_Path</bpmn:incoming>
      <bpmn:outgoing>Flow_Check_Insurance</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Insurance Necessary? (Logistics) -->
    <bpmn:exclusiveGateway id="Gateway_InsuranceCheck" name="Insurance necessary?">
      <bpmn:incoming>Flow_Check_Insurance</bpmn:incoming>
      <bpmn:outgoing>Flow_TakeIns_No</bpmn:outgoing>
      <bpmn:outgoing>Flow_TakeIns_Yes</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Take Insurance (Logistics) -->
    <bpmn:task id="Task_TakeInsurance" name="Take Parcel Insurance">
      <bpmn:incoming>Flow_TakeIns_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_Small_Join</bpmn:outgoing>
    </bpmn:task>

    <!-- Skip Insurance Flow -->
     <bpmn:sequenceFlow id="Flow_TakeIns_No" sourceRef="Gateway_InsuranceCheck" targetRef="Task_PreparePickup">
       <bpmn:name name="No insurance needed"/>
    </bpmn:sequenceFlow>

    <!-- Warehouse Path -->
    <bpmn:task id="Task_PackageGoods" name="Package Goods">
      <bpmn:incoming>Flow_Warehouse_Start</bpmn:incoming>
      <bpmn:outgoing>Flow_Warehouse_Join</bpmn:outgoing>
    </bpmn:task>

    <!-- Final Join Gateway -->
     <bpmn:parallelGateway id="Gateway_FinalJoin" name="All Ready?">
       <bpmn:incoming>Flow_Large_Join</bpmn:incoming>
      <bpmn:incoming>Flow_Small_Join</bpmn:incoming>
      <bpmn:incoming>Flow_Warehouse_Join</bpmn:incoming>
      <bpmn:outgoing>Flow_Prepare_Pickup</bpmn:outgoing>
    </bpmn:parallelGateway>

     <!-- Final Task -->
    <bpmn:task id="Task_PreparePickup" name="Prepare for Pickup">
       <bpmn:incoming>Flow_Large_Join</bpmn:incoming>
      <bpmn:outgoing>Flow_End_Event</bpmn:outgoing>
    </bpmn:task>

     <!-- End Event -->
    <bpmn:endEvent id="EndEvent_01" name="Ready for Pickup">
       <bpmn:incoming>Flow_Prepare_Pickup</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
     <bpmn:sequenceFlow id="Flow_Start_Clarify" sourceRef="StartEvent_01" targetRef="Task_ClarifyMethod">
       <bpmn:name name="Goods to ship"/>
    </bpmn:sequenceFlow>

    <!-- Fork Logic Correction for Validity -->
     <bpmn:parallelGateway id="Gateway_ParallelFork_2">
        <bpmn:incoming>Flow_Clarity_Fork</bpmn:incoming>
       <bpmn:outgoing>Flow_Warehouse_Start</bpmn:outgoing>
      </bpmn:parallelGateway>

    <!-- Re-mapping Fork to ensure valid flow from Task -->
     <bpmn:sequenceFlow id="Flow_Clarity_Fork" sourceRef="Task_ClarifyMethod" targetRef="Gateway_SizeCheck">
       <bpmn:name name="Clarified"/>
    </bpmn:sequenceFlow>

      <!-- Correcting Fork Logic to be valid -->
     <bpmn:startEvent id="StartEvent_01" /> 
     
  </bpmn:process>
</bpmn:definitions>