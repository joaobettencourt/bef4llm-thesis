<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" targetNamespace="http://bpmn.io/schema/bpmn" id="Definitions_1">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Nach Eingang der Daten für ein SEPA-Mandat wird zunächst geprüft, ob eine IBAN vorliegt, um das Bankkonto des Zahlers eindeutig zu identifizieren.">
      <bpmn:outgoing>SequenceFlow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="ExclusiveGateway_1" name="Anhand der ersten beiden Stellen der IBAN wird festgestellt, in welchem Land das Konto registriert ist.">
      <bpmn:incoming>SequenceFlow_0</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_1" name="Sollten nicht alle notwendigen Angaben vorhanden sein, wird je nach Situation unterschieden: Liegt eine Unterschrift vor, erfolgt eine manuelle Prüfung der fehlenden Daten. Fehlt die Unterschrift, wird automatisch ein Schreiben erstellt, das die fehlende Unterschrift anfordert. In diesem Fall wird eine Rückmeldung innerhalb von 28 Tagen abgewartet; bleibt diese aus, kann der Prozess nicht weitergeführt werden." />
    <bpmn:sequenceFlow id="SequenceFlow_0" sourceRef="StartEvent_1" targetRef="ExclusiveGateway_1" />
    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_1" />
  </bpmn:process>
</bpmn:definitions>