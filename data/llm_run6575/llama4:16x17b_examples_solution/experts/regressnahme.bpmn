<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">

   <process id="regressProcess" isExecutable="true">
     <startEvent id="startEvent">
       <outgoing>sequenceFlow1</outgoing>
       <messageEventDefinition/>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent" targetRef="task1"/>

     <task id="task1" name="Fall prüfen">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow2" sourceRef="task1" targetRef="exclusiveGateway1"/>

     <exclusiveGateway id="exclusiveGateway1">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
       <outgoing>sequenceFlow4</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow3" sourceRef="exclusiveGateway1" targetRef="task2">
       <conditionExpression xsi:type="tFormalExpression">regressPossible = true</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="sequenceFlow4" sourceRef="exclusiveGateway1" targetRef="endEvent1">
       <conditionExpression xsi:type="tFormalExpression">regressPossible = false</conditionExpression>
     </sequenceFlow>

     <task id="task2" name="Zahlungsaufforderung an VN schicken">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow5</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow5" sourceRef="task2" targetRef="task3"/>

     <task id="task3" name="Vorgang auf Wiedervorlage setzen">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow6</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow6" sourceRef="task3" targetRef="eventBasedGateway1"/>

     <eventBasedGateway id="eventBasedGateway1">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow7</outgoing>
       <outgoing>sequenceFlow8</outgoing>
       <outgoing>sequenceFlow9</outgoing>
     </eventBasedGateway>

     <intermediateCatchEvent id="intermediateCatchEvent1" name="Widerspruch erhalten">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow10</outgoing>
       <messageEventDefinition/>
     </intermediateCatchEvent>

     <sequenceFlow id="sequenceFlow7" sourceRef="eventBasedGateway1" targetRef="intermediateCatchEvent1"/>

     <task id="task4" name="Widerspruch prüfen">
       <incoming>sequenceFlow10</incoming>
       <outgoing>sequenceFlow11</outgoing>
     </task>

     <exclusiveGateway id="exclusiveGateway2">
       <incoming>sequenceFlow11</incoming>
       <outgoing>sequenceFlow12</outgoing>
       <outgoing>sequenceFlow13</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow12" sourceRef="exclusiveGateway2" targetRef="task5">
       <conditionExpression xsi:type="tFormalExpression">objectionJustified = true</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="sequenceFlow13" sourceRef="exclusiveGateway2" targetRef="task6">
       <conditionExpression xsi:type="tFormalExpression">objectionJustified = false</conditionExpression>
     </sequenceFlow>

     <task id="task5" name="Vorgang schließen">
       <incoming>sequenceFlow12</incoming>
       <outgoing>sequenceFlow14</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow14" sourceRef="task5" targetRef="endEvent2"/>

     <task id="task6" name="Vorgang an Inkasso-Dienstleister geben">
       <incoming>sequenceFlow13</incoming>
       <incoming>sequenceFlow15</incoming>
       <outgoing>sequenceFlow16</outgoing>
     </task>

     <intermediateCatchEvent id="intermediateCatchEvent2" name="Wiedervorlage fällig">
       <incoming>sequenceFlow8</incoming>
       <outgoing>sequenceFlow15</outgoing>
       <timerEventDefinition/>
     </intermediateCatchEvent>

     <sequenceFlow id="sequenceFlow15" sourceRef="intermediateCatchEvent2" targetRef="task6"/>

     <intermediateCatchEvent id="intermediateCatchEvent3" name="Geld eingegangen">
       <incoming>sequenceFlow9</incoming>
       <outgoing>sequenceFlow17</outgoing>
       <messageEventDefinition/>
     </intermediateCatchEvent>

     <sequenceFlow id="sequenceFlow17" sourceRef="intermediateCatchEvent3" targetRef="task7"/>

     <task id="task7" name="Geldeingang verbuchen">
       <incoming>sequenceFlow17</incoming>
       <outgoing>sequenceFlow18</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow18" sourceRef="task7" targetRef="endEvent2"/>

     <endEvent id="endEvent1">
       <incoming>sequenceFlow4</incoming>
     </endEvent>

     <endEvent id="endEvent2">
       <incoming>sequenceFlow14</incoming>
       <incoming>sequenceFlow18</incoming>
     </endEvent>
   </process>
</definitions>