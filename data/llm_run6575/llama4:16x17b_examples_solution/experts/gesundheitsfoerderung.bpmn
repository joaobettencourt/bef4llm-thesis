<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd http://www.w3.org/2001/XMLSchema-instance"
             id="definitions" targetNamespace="http://www.example.com">

   <process id="healthPromotionProgram" isExecutable="true">
     <startEvent id="startEvent">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent" targetRef="healthCheck"/>

     <manualTask id="healthCheck" name="Gesundheits-Check">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </manualTask>

     <sequenceFlow id="sequenceFlow2" sourceRef="healthCheck" targetRef="createTrainingPlan"/>

     <manualTask id="createTrainingPlan" name="Erstellung Trainings- und Ernährungsplan">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
     </manualTask>

     <sequenceFlow id="sequenceFlow3" sourceRef="createTrainingPlan" targetRef="intermediateCatchEvent1"/>

     <intermediateCatchEvent id="intermediateCatchEvent1">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow4</outgoing>
       <timerEventDefinition/>
     </intermediateCatchEvent>

     <sequenceFlow id="sequenceFlow4" sourceRef="intermediateCatchEvent1" targetRef="trainingPhase"/>

     <manualTask id="trainingPhase" name="Trainingsphase">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow5</outgoing>
     </manualTask>

     <sequenceFlow id="sequenceFlow5" sourceRef="trainingPhase" targetRef="intermediateCatchEvent2"/>

     <intermediateCatchEvent id="intermediateCatchEvent2">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow6</outgoing>
       <conditionalEventDefinition>
         <condition xsi:type="tFormalExpression">true</condition>
       </conditionalEventDefinition>
     </intermediateCatchEvent>

     <sequenceFlow id="sequenceFlow6" sourceRef="intermediateCatchEvent2" targetRef="splitIntoGroups"/>

     <exclusiveGateway id="splitIntoGroups">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow7</outgoing>
       <outgoing>sequenceFlow8</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow7" sourceRef="splitIntoGroups" targetRef="trainingWithoutWearables">
       <conditionExpression xsi:type="tFormalExpression">groupAssignment = "withoutWearables"</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="sequenceFlow8" sourceRef="splitIntoGroups" targetRef="trainingWithWearables">
       <conditionExpression xsi:type="tFormalExpression">groupAssignment = "withWearables"</conditionExpression>
     </sequenceFlow>

     <manualTask id="trainingWithoutWearables" name="Trainingsphase ohne Wearables">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow9</outgoing>
     </manualTask>

     <sequenceFlow id="sequenceFlow9" sourceRef="trainingWithoutWearables" targetRef="finalHealthCheck"/>

     <manualTask id="trainingWithWearables" name="Trainingsphase mit Wearables">
       <incoming>sequenceFlow8</incoming>
       <outgoing>sequenceFlow10</outgoing>
     </manualTask>

     <sequenceFlow id="sequenceFlow10" sourceRef="trainingWithWearables" targetRef="finalHealthCheck"/>

     <manualTask id="finalHealthCheck" name="Abschließender Gesundheits-Check">
       <incoming>sequenceFlow9</incoming>
       <incoming>sequenceFlow10</incoming>
     </manualTask>

     <endEvent id="endEvent">
       <incoming>sequenceFlow9</incoming>
       <incoming>sequenceFlow10</incoming>
     </endEvent>

   </process>
 </definitions>