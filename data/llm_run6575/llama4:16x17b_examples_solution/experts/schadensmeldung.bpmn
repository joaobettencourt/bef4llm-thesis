<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">

   <process id="damageClaimProcess" isExecutable="true">
     <startEvent id="startEvent1">
       <outgoing>sequenceFlow1</outgoing>
       <messageEventDefinition messageRef="damagesmeldung"/>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="task1"/>

     <manualTask id="task1" name="Aufnahme des Anliegens">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </manualTask>

     <sequenceFlow id="sequenceFlow2" sourceRef="task1" targetRef="exclusiveGateway1"/>

     <exclusiveGateway id="exclusiveGateway1">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
       <outgoing>sequenceFlow4</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow3" name="Ja" sourceRef="exclusiveGateway1" targetRef="endEvent1">
       <conditionExpression xsi:type="tFormalExpression">gultig  = false</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="sequenceFlow4" name="Nein" sourceRef="exclusiveGateway1" targetRef="task2">
       <conditionExpression xsi:type="tFormalExpression">gultig  = true</conditionExpression>
     </sequenceFlow>

     <endEvent id="endEvent1">
       <incoming>sequenceFlow3</incoming>
     </endEvent>

     <manualTask id="task2" name="Prüfung der Schadensmeldung auf Vollständigkeit">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow5</outgoing>
     </manualTask>

     <sequenceFlow id="sequenceFlow5" sourceRef="task2" targetRef="exclusiveGateway2"/>

     <exclusiveGateway id="exclusiveGateway2">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow6</outgoing>
       <outgoing>sequenceFlow7</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow6" name="Ja" sourceRef="exclusiveGateway2" targetRef="task3">
       <conditionExpression xsi:type="tFormalExpression">vollständig  = true</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="sequenceFlow7" name="Nein" sourceRef="exclusiveGateway2" targetRef="task4">
       <conditionExpression xsi:type="tFormalExpression">vollständig  = false</conditionExpression>
     </sequenceFlow>

     <manualTask id="task3" name="Weiterleitung an zuständige Fachabteilung">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow8</outgoing>
     </manualTask>

     <sequenceFlow id="sequenceFlow8" sourceRef="task3" targetRef="intermediateCatchEvent1"/>

     <intermediateCatchEvent id="intermediateCatchEvent1">
       <incoming>sequenceFlow8</incoming>
       <outgoing>sequenceFlow9</outgoing>
       <messageEventDefinition messageRef="bearbeitung"/>
     </intermediateCatchEvent>

     <sequenceFlow id="sequenceFlow9" sourceRef="intermediateCatchEvent1" targetRef="task5"/>

     <manualTask id="task4" name="Rückfragen an Kunden">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow16</outgoing>
     </manualTask>

     <sequenceFlow id="sequenceFlow16" sourceRef="task4" targetRef="exclusiveGateway2"/>

     <manualTask id="task5" name="Vertiefte Validierung und Beurteilung">
       <incoming>sequenceFlow9</incoming>
       <outgoing>sequenceFlow10</outgoing>
     </manualTask>

     <sequenceFlow id="sequenceFlow10" sourceRef="task5" targetRef="exclusiveGateway3"/>

     <exclusiveGateway id="exclusiveGateway3">
       <incoming>sequenceFlow10</incoming>
       <outgoing>sequenceFlow11</outgoing>
       <outgoing>sequenceFlow12</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow11" name="Ja" sourceRef="exclusiveGateway3" targetRef="task6">
       <conditionExpression xsi:type="tFormalExpression">rechtlBeurteilung  = erforderlich</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="sequenceFlow12" name="Nein" sourceRef="exclusiveGateway3" targetRef="intermediateThrowEvent1"/>

      <manualTask id="task6" name="Rechtliche Beurteilung durch Versicherer">
        <incoming>sequenceFlow11</incoming>
        <outgoing>sequenceFlow13</outgoing>
      </manualTask>

     <sequenceFlow id="sequenceFlow13" sourceRef="task6" targetRef="intermediateThrowEvent1"/>

     <intermediateThrowEvent id="intermediateThrowEvent1">
       <incoming>sequenceFlow12</incoming>
       <incoming>sequenceFlow13</incoming>
       <outgoing>sequenceFlow14</outgoing>
       <messageEventDefinition messageRef="entscheidung"/>
     </intermediateThrowEvent>

     <sequenceFlow id="sequenceFlow14" sourceRef="intermediateThrowEvent1" targetRef="task7"/>

     <sendTask id="task7" name="Kommunikation der Entscheidung an Kunden">
       <incoming>sequenceFlow14</incoming>
       <outgoing>sequenceFlow15</outgoing>
     </sendTask>

     <sequenceFlow id="sequenceFlow15" sourceRef="task7" targetRef="endEvent2"/>

     <endEvent id="endEvent2">
       <incoming>sequenceFlow15</incoming>
     </endEvent>
   </process>
</definitions>