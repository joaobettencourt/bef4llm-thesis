<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Restaurant Process">

  <process id="restaurantProcess" isExecutable="true">
    <startEvent id="guestArrives">
      <outgoing>sequenceFlow1</outgoing>
    </startEvent>

    <sequenceFlow id="sequenceFlow1" sourceRef="guestArrives" targetRef="selectDish"/>

    <task id="selectDish" name="Gast wählt Gericht aus">
      <incoming>sequenceFlow1</incoming>
      <outgoing>sequenceFlow2</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow2" sourceRef="selectDish" targetRef="orderFood"/>

    <task id="orderFood" name="Gast gibt Bestellung auf">
      <incoming>sequenceFlow2</incoming>
      <outgoing>sequenceFlow3</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow3" sourceRef="orderFood" targetRef="payAndGetPieper"/>

    <task id="payAndGetPieper" name="Angestellter kassiert und übergibt Pieper">
      <incoming>sequenceFlow3</incoming>
      <outgoing>sequenceFlow4</outgoing>
      <outgoing>sequenceFlow9</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow4" sourceRef="payAndGetPieper" targetRef="informCook"/>

    <task id="informCook" name="Angestellter informiert Koch">
      <incoming>sequenceFlow4</incoming>
      <outgoing>sequenceFlow5</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow5" sourceRef="informCook" targetRef="prepareFood"/>

    <task id="prepareFood" name="Koch bereitet Mahlzeit zu">
      <incoming>sequenceFlow5</incoming>
      <outgoing>sequenceFlow6</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow6" sourceRef="prepareFood" targetRef="informWaiter"/>

    <task id="informWaiter" name="Koch informiert Angestellten">
      <incoming>sequenceFlow6</incoming>
      <outgoing>sequenceFlow7</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow7" sourceRef="informWaiter" targetRef="notifyGuest"/>

    <task id="notifyGuest" name="Angestellter löst Pieper aus">
      <incoming>sequenceFlow7</incoming>
      <outgoing>sequenceFlow8</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow8" sourceRef="notifyGuest" targetRef="deliverFood"/>

    <task id="deliverFood" name="Angestellter übergibt Mahlzeit">
      <incoming>sequenceFlow8</incoming>
    </task>

    <exclusiveGateway id="waitForGuestReaction">
      <incoming>sequenceFlow9</incoming>
      <outgoing>sequenceFlow10</outgoing>
      <outgoing>sequenceFlow11</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequenceFlow9" sourceRef="payAndGetPieper" targetRef="waitForGuestReaction"/>

    <sequenceFlow id="sequenceFlow10" sourceRef="waitForGuestReaction" targetRef="deliverFood"/>

    <task id="callGuest" name="Angestellter ruft Gast auf">
      <incoming>sequenceFlow11</incoming>
    </task>

    <sequenceFlow id="sequenceFlow11" sourceRef="waitForGuestReaction" targetRef="callGuest">
      <conditionExpression xsi:type="tFormalExpression">nach 5 Minuten</conditionExpression>
    </sequenceFlow>

    <endEvent id="foodConsumed">
      <incoming>sequenceFlow8</incoming>
    </endEvent>
  </process>
</definitions>