<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="SEPA Mandat Process" targetNamespace="http://bpmn.io/schema/bpmn">

   <process id="sepaMandatProcess" isExecutable="true">
     <startEvent id="startEvent1">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="taskIBANCheck"/>

     <userTask id="taskIBANCheck" name="Prüfen, ob eine IBAN vorliegt">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </userTask>

     <exclusiveGateway id="exclusiveGateway1">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
       <outgoing>sequenceFlow4</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow2" sourceRef="taskIBANCheck" targetRef="exclusiveGateway1"/>
     <sequenceFlow id="sequenceFlow3" name="ja" sourceRef="exclusiveGateway1" targetRef="taskPersonSearch"/>
     <sequenceFlow id="sequenceFlow4" name="nein" sourceRef="exclusiveGateway1" targetRef="taskManualCheck"/>

     <userTask id="taskPersonSearch" name="Suchen nach der zugehörigen Person im System">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow5</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow5" sourceRef="taskPersonSearch" targetRef="exclusiveGateway2"/>

     <exclusiveGateway id="exclusiveGateway2">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow6</outgoing>
       <outgoing>sequenceFlow7</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow6" name="ja" sourceRef="exclusiveGateway2" targetRef="taskCheckInformation"/>
     <sequenceFlow id="sequenceFlow7" name="nein" sourceRef="exclusiveGateway2" targetRef="taskCreateRequest"/>

     <userTask id="taskCheckInformation" name="Überprüfen, ob alle erforderlichen Informationen vorhanden sind">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow8</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow8" sourceRef="taskCheckInformation" targetRef="exclusiveGateway3"/>

     <exclusiveGateway id="exclusiveGateway3">
       <incoming>sequenceFlow8</incoming>
       <outgoing>sequenceFlow9</outgoing>
       <outgoing>sequenceFlow10</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow9" name="ja" sourceRef="exclusiveGateway3" targetRef="taskCheckValidFromDate"/>
     <sequenceFlow id="sequenceFlow10" name="nein" sourceRef="exclusiveGateway3" targetRef="taskManualCheck"/>

     <userTask id="taskCreateRequest1" name="Erstellung eines Schreibens zur Anforderung fehlender Informationen">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow11</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow11" sourceRef="taskCreateRequest1" targetRef="exclusiveGateway4"/>

     <exclusiveGateway id="exclusiveGateway4">
       <incoming>sequenceFlow11</incoming>
       <outgoing>sequenceFlow12</outgoing>
       <outgoing>sequenceFlow13</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow12" name="ja" sourceRef="exclusiveGateway4" targetRef="endEvent1"/>
     <sequenceFlow id="sequenceFlow13" name="nein" sourceRef="exclusiveGateway4" targetRef="taskManualCheck"/>

     <userTask id="taskManualCheck1" name="Manuelle Überprüfung der fehlenden Daten">
       <incoming>sequenceFlow4</incoming>
       <incoming>sequenceFlow10</incoming>
       <incoming>sequenceFlow13</incoming>
       <outgoing>sequenceFlow14</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow14" sourceRef="taskManualCheck1" targetRef="exclusiveGateway2"/>

     <userTask id="taskCheckValidFromDate1" name="Überprüfen des Gültig- von-Datums">
       <incoming>sequenceFlow9</incoming>
       <outgoing>sequenceFlow15</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow15" sourceRef="taskCheckValidFromDate1" targetRef="exclusiveGateway5"/>

     <exclusiveGateway id="exclusiveGateway5">
       <incoming>sequenceFlow15</incoming>
       <outgoing>sequenceFlow16</outgoing>
       <outgoing>sequenceFlow17</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow16" name="ja" sourceRef="exclusiveGateway5" targetRef="taskCheckBankConnection"/>
     <sequenceFlow id="sequenceFlow17" name="nein" sourceRef="exclusiveGateway5" targetRef="taskCreateBankConnection"/>

     <userTask id="taskCheckBankConnection1" name="Überprüfen der Bankverbindung">
       <incoming>sequenceFlow16</incoming>
       <outgoing>sequenceFlow18</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow18" sourceRef="taskCheckBankConnection1" targetRef="exclusiveGateway6"/>

     <exclusiveGateway id="exclusiveGateway6">
       <incoming>sequenceFlow18</incoming>
       <outgoing>sequenceFlow19</outgoing>
       <outgoing>sequenceFlow20</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow19" name="ja" sourceRef="exclusiveGateway6" targetRef="taskCheckActiveMandate"/>
     <sequenceFlow id="sequenceFlow20" name="nein" sourceRef="exclusiveGateway6" targetRef="endEvent1"/>

     <userTask id="taskCreateBankConnection1" name="Erstellung einer neuen Bankverbindung">
       <incoming>sequenceFlow17</incoming>
       <outgoing>sequenceFlow21</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow21" sourceRef="taskCreateBankConnection1" targetRef="exclusiveGateway6"/>

     <userTask id="taskCheckActiveMandate1" name="Überprüfen, ob ein aktives SEPA-Mandat existiert">
       <incoming>sequenceFlow19</incoming>
       <outgoing>sequenceFlow22</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow22" sourceRef="taskCheckActiveMandate1" targetRef="exclusiveGateway7"/>

     <exclusiveGateway id="exclusiveGateway7">
       <incoming>sequenceFlow22</incoming>
       <outgoing>sequenceFlow23</outgoing>
       <outgoing>sequenceFlow24</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow23" name="ja" sourceRef="exclusiveGateway7" targetRef="endEvent1"/>
     <sequenceFlow id="sequenceFlow24" name="nein" sourceRef="exclusiveGateway7" targetRef="taskCreateMandate"/>

     <userTask id="taskCreateMandate1" name="Erstellung eines neuen SEPA-Mandats">
       <incoming>sequenceFlow24</incoming>
       <outgoing>sequenceFlow25</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow25" sourceRef="taskCreateMandate1" targetRef="endEvent1"/>

     <endEvent id="endEvent1">
     </endEvent>
   </process>
</definitions>