     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_0jsoxba" targetRef="ExclusiveGateway_1"/>
     <inclusiveGateway id="InclusiveGateway_0">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_8</outgoing>
       <outgoing>SequenceFlow_10</outgoing>
     </inclusiveGateway>
     <sequenceFlow id="SequenceFlow_2" sourceRef="ParallelGateway_0" targetRef="InclusiveGateway_0"/>
     <sequenceFlow id="SequenceFlow_8" sourceRef="InclusiveGateway_0" targetRef="Task_0jsoxba"/>
     <sequenceFlow id="SequenceFlow_10" name="no" sourceRef="InclusiveGateway_0" targetRef="Task_05ftug5"/>
     <inclusiveGateway id="InclusiveGateway_1">
       <incoming>SequenceFlow_12</incoming>
     </inclusiveGateway>
   </process>
