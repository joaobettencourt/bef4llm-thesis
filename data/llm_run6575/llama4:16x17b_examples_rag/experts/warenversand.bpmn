             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             id="Definitions_1" 
             targetNamespace="http://bpmn.io/schema/bpmn">
   <collaboration id="Collaboration_0">
     <participant id="Participant_0" name="Dispatch of goods&#10;Computer Hardware Shop" processRef="Process_1"/>
   </collaboration>
   <process id="Process_1" isExecutable="true">
     <laneSet id="LaneSet_1">
       <lane id="Lane_0" name="Secretary">
         <flowNodeRef>StartEvent_1</flowNodeRef>
         <flowNodeRef>InclusiveGateway_0</flowNodeRef>
         <flowNodeRef>Task_0s79ile</flowNodeRef>
         <flowNodeRef>ExclusiveGateway_1</flowNodeRef>
         <flowNodeRef>Task_0e6hvnj</flowNodeRef>
         <flowNodeRef>Task_12j0pib</flowNodeRef>
       </lane>
       <lane id="Lane_1" name="Logistics">
         <flowNodeRef>InclusiveGateway_1</flowNodeRef>
         <flowNodeRef>Task_0jsoxba</flowNodeRef>
       </lane>
       <lane id="Lane_2" name="Warehouse">
         <flowNodeRef>ParallelGateway_0</flowNodeRef>
         <flowNodeRef>Task_05ftug5</flowNodeRef>
         <flowNodeRef>ExclusiveGateway_0</flowNodeRef>
         <flowNodeRef>EndEvent_1</flowNodeRef>
       </lane>
     </laneSet>
     <startEvent id="StartEvent_1" name="Ship goods">
       <outgoing>SequenceFlow_0</outgoing>
     </startEvent>
     <parallelGateway id="ParallelGateway_0">
       <incoming>SequenceFlow_0</incoming>
       <outgoing>SequenceFlow_1</outgoing>
       <outgoing>SequenceFlow_2</outgoing>
     </parallelGateway>
     <sequenceFlow id="SequenceFlow_0" sourceRef="StartEvent_1" targetRef="ParallelGateway_0"/>
     <task id="Task_05ftug5" name="Package goods">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_3</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_1" sourceRef="ParallelGateway_0" targetRef="Task_05ftug5"/>
     <exclusiveGateway id="ExclusiveGateway_0">
       <incoming>SequenceFlow_6</incoming>
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_7</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_3" sourceRef="Task_05ftug5" targetRef="ExclusiveGateway_0"/>
     <endEvent id="EndEvent_1" name="Shipment&#10;prepared">
       <incoming>SequenceFlow_7</incoming>
     </endEvent>
     <sequenceFlow id="SequenceFlow_7" sourceRef="ExclusiveGateway_0" targetRef="EndEvent_1"/>
     <task id="Task_0s79ile" name="Select logistic&#10;company and&#10;place order">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_0s79ile" targetRef="ExclusiveGateway_0"/>
     <task id="Task_0e6hvnj" name="Get 3 offers&#10;from logistic&#10;companies">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_0e6hvnj" targetRef="Task_0s79ile"/>
     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_10</outgoing>
       <outgoing>SequenceFlow_4</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_1" targetRef="Task_0e6hvnj"/>
     <task id="Task_12j0pib" name="Insure parcel">
       <incoming>SequenceFlow_11</incoming>
       <outgoing>SequenceFlow_12</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_12" sourceRef="Task_12j0pib" targetRef="InclusiveGateway_1"/>
     <sequenceFlow id="SequenceFlow_11" sourceRef="Task_0jsoxba" targetRef="Task_12j0pib"/>
     <task id="Task_0jsoxba" name="Write package&#10;label">
