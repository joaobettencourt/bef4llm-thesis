<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definition" 
             name="Restaurant Process"
             targetNamespace="http://example.com/bpmn">

   <process id="restaurantProcess" isExecutable="true">
     <laneSet>
       <lane id="waiterLane" name="Angestellter">
         <flowNodeRef>startEvent</flowNodeRef>
         <flowNodeRef>taskOrderInput</flowNodeRef>
         <flowNodeRef>taskPay</flowNodeRef>
         <flowNodeRef>taskPager</flowNodeRef>
         <flowNodeRef>inclusiveGateway1</flowNodeRef>
         <flowNodeRef>exclusiveGatewayCheckOrder</flowNodeRef>
         <flowNodeRef>taskInformCook</flowNodeRef>
         <flowNodeRef>endEvent</flowNodeRef>
       </lane>
       <lane id="cookLane" name="Koch">
         <flowNodeRef>taskPrepareFood</flowNodeRef>
       </lane>
     </laneSet>

     <startEvent id="startEvent" name="Gast betritt Restaurant">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent" targetRef="taskOrderInput"/>

     <userTask id="taskOrderInput" name="Bestellung aufnehmen">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow2" sourceRef="taskOrderInput" targetRef="taskPay"/>

     <userTask id="taskPay" name="Bezahlung">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow3" sourceRef="taskPay" targetRef="taskPager"/>

     <userTask id="taskPager" name="Pieper aushändigen">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow4</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow4" sourceRef="taskPager" targetRef="taskInformCook"/>

     <userTask id="taskInformCook" name="Koch informieren">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow5</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow5" sourceRef="taskInformCook" targetRef="taskPrepareFood"/>

     <userTask id="taskPrepareFood" name="Essen zubereiten">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow6</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow6" sourceRef="taskPrepareFood" targetRef="exclusiveGatewayCheckOrder"/>

     <exclusiveGateway id="exclusiveGatewayCheckOrder">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow7</outgoing>
       <outgoing>sequenceFlow8</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow7" sourceRef="exclusiveGatewayCheckOrder" targetRef="taskNotifyCustomerViaPager">
       <conditionExpression xsi:type="tFormalExpression">Gast reagiert auf Pieper</conditionExpression>
     </sequenceFlow>

     <userTask id="taskNotifyCustomerViaPager" name="Gast benachrichtigen  (Pieper)">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow9</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow9" sourceRef="taskNotifyCustomerViaPager" targetRef="endEvent"/>

     <sequenceFlow id="sequenceFlow8" sourceRef="exclusiveGatewayCheckOrder" targetRef="taskCallCustomer">
       <conditionExpression xsi:type="tFormalExpression">Gast reagiert nicht auf Pieper</conditionExpression>
     </sequenceFlow>

     <userTask id="taskCallCustomer" name="Gast anrufen">
       <incoming>sequenceFlow8</incoming>
       <outgoing>sequenceFlow10</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow10" sourceRef="taskCallCustomer" targetRef="inclusiveGateway1"/>

     <exclusiveGateway id="exclusiveGatewayCheckOrderAgain">
       <incoming>sequenceFlow10</incoming>
       <outgoing>sequenceFlow11</outgoing>
       <outgoing>sequenceFlow12</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow11" sourceRef="exclusiveGatewayCheckOrderAgain" targetRef="taskNotifyCustomerViaPager">
       <conditionExpression xsi:type="tFormalExpression">Gast kommt</conditionExpression>
     </sequenceFlow>

     <userTask id="taskCallCustomerAgain" name="Gast nochmal anrufen">
       <incoming>sequenceFlow12</incoming>
       <outgoing>sequenceFlow13</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow12" sourceRef="exclusiveGatewayCheckOrderAgain" targetRef="taskCallCustomerAgain"/>

     <sequenceFlow id="sequenceFlow13" sourceRef="taskCallCustomerAgain" targetRef="exclusiveGatewayCheckOrderAgain"/>

     <inclusiveGateway id="inclusiveGateway1">
       <incoming>sequenceFlow10</incoming>
       <outgoing>sequenceFlow14</outgoing>
     </inclusiveGateway>

     <sequenceFlow id="sequenceFlow14" sourceRef="inclusiveGateway1" targetRef="endEvent"/>
     
     <endEvent id="endEvent" name="Essen übergeben">
       <incoming>sequenceFlow9</incoming>
       <incoming>sequenceFlow14</incoming>
     </endEvent>
   </process>
</definitions>