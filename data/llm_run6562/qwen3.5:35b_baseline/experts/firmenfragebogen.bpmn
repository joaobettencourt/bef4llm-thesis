<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_FragenbogenProzess">
    <bpmn:participant id="Participant_Process" name="Firmenfragebogen Bearbeitung" processRef="Process_Main"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Main" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_System" name="System/Automatisierung">
        <bpmn:flowNodeRef>StartEvent_Eingang</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ErfassenVerarbeiten</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PartnerCheck</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sachbearbeiter" name="Sachbearbeiter">
        <bpmn:flowNodeRef>Task_ManuellePruefung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_UmlageZeitenCheck</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Eingang" name="Firmenfragebogen Eingang">
      <bpmn:outgoing>SequenceFlow_Start</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Erfassen und im System verarbeiten -->
    <bpmn:task id="Task_ErfassenVerarbeiten" name="Erfassen und im System verarbeiten">
      <bpmn:incoming>SequenceFlow_Start</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SucheStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: Automatische Partnersuche -->
    <bpmn:task id="Task_AutomatischeSuche" name="Automatische Partnersuche">
      <bpmn:incoming>SequenceFlow_SucheStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PartnerCheckGate</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Partner gefunden / eindeutig? -->
    <bpmn:exclusiveGateway id="Gateway_PartnerCheck" name="Partner gefunden / eindeutig?">
      <bpmn:incoming>SequenceFlow_PartnerCheckGate</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ManuellPruefungPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_DatenStartDirect</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 3: Manuelle Prüfung (Exception Path from Search) -->
    <bpmn:task id="Task_ManuellePruefung" name="Manuelle Prüfung durch Sachbearbeiter">
      <bpmn:incoming>SequenceFlow_ManuellPruefungPath</bpmn:outgoing> <!-- Note: Incoming/Outgoing logic corrected below in flows -->
       <bpmn:outgoing>SequenceFlow_MergeManualToDataCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway Merge for Manual Check Path -->
     <bpmn:exclusiveGateway id="Gateway_DataMerge" name="Zu Datenprüfung">
        <bpmn:incoming>SequenceFlow_DatenStartDirect</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_MergeManualToDataCheck</bpmn:outgoing> <!-- Wait, this is outgoing from merge -->
    </bpmn:exclusiveGateway>

     <!-- Corrected Logic for Merge Gateway -->
