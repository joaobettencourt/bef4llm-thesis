<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_RegressProzess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Versicherung" name="Versicherungsunternehmen - Regressabteilung" processRef="Process_RegressProzess" />
  </bpmn:collaboration>

  <bpmn:process id="Process_RegressProzess" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Sachbearbeiter" name="Sachbearbeiter">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FallPruefen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_Moeglichkeit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_VorgangSchliessen1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ZahlungsauflageSenden</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_Warten</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateTimer_FristAbgelaufen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InkassoUebergeben1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_VorgangSchliessen2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateMessage_GeldEingang</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EingangVerbuchen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_VorgangSchliessen3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateSignal_Widerspruch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WiderspruchPruefen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_Gerechtfertigt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_VorgangSchliessen4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InkassoUebergeben2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_VorgangSchliessen5</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Benachrichtigung über möglichen Regress">
      <bpmn:outgoing>SequenceFlow_FallPruefen</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task -->
    <bpmn:task id="Task_FallPruefen" name="Fall prüfen und Möglichkeit bewerten">
      <bpmn:incoming>SequenceFlow_FallPruefen</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MoeglichkeitCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway -->
    <bpmn:exclusiveGateway id="InclusiveGateway_Moeglichkeit" name="Möglichkeit besteht?">
      <bpmn:incoming>SequenceFlow_MoeglichkeitCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_VorgangSchliessen1</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ZahlungsauflageSenden</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_VorgangSchliessen1" name="Vorgang schließen (Kein Regress)">
      <bpmn:incoming>SequenceFlow_VorgangSchliessen1</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task -->
    <bpmn:task id="Task_ZahlungsauflageSenden" name="Zahlungsauflage senden &amp; Wiedervorlage setzen">
      <bpmn:incoming>SequenceFlow_ZahlungsauflageSenden</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WartenStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway for Waiting Period -->
    <bpmn:parallelGateway id="InclusiveGateway_Warten" name="Wartezeit (Frist)">
      <bpmn:incoming>SequenceFlow_WartenStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TimerPfad</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PaymentPfad</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ObjectionPfad</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Intermediate Timer Event -->
    <bpmn:intermediateCatchEvent id="IntermediateTimer_FristAbgelaufen" name="Frist abgelaufen">
      <bpmn:incoming>SequenceFlow_TimerPfad</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Inkasso1</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task -->
    <bpmn:task id="Task_InkassoUebergeben1" name="An Inkassodienstleister übergeben">
      <bpmn:incoming>SequenceFlow_Inkasso1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_End2</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_VorgangSchliessen2" name="Vorgang schließen (Inkasso)">
      <bpmn:incoming>SequenceFlow_End2</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Intermediate Message Event -->
    <bpmn:intermediateCatchEvent id="IntermediateMessage_GeldEingang" name="Geld eingegangen">
      <bpmn:incoming>SequenceFlow_PaymentPfad</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Verbuchen</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task -->
    <bpmn:task id="Task_EingangVerbuchen" name="Eingang verbuchen">
      <bpmn:incoming>SequenceFlow_Verbuchen</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_End3</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_VorgangSchliessen3" name="Vorgang schließen (Bezahlt)">
      <bpmn:incoming>SequenceFlow_End3</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Intermediate Signal Event -->
    <bpmn:intermediateCatchEvent id="IntermediateSignal_Widerspruch" name="Widerspruch VN">
      <bpmn:incoming>SequenceFlow_ObjectionPfad</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PruefenWiderruf</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task -->
    <bpmn:task id="Task_WiderspruchPruefen" name="Widerspruch prüfen">
      <bpmn:incoming>SequenceFlow_PruefenWiderruf</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GerechtfertigtCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway -->
    <bpmn:exclusiveGateway id="InclusiveGateway_Gerechtfertigt" name="Zahlungsverweigerung gerechtfertigt?">
      <bpmn:incoming>SequenceFlow_GerechtfertigtCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_End4</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_Inkasso2</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_VorgangSchliessen4" name="Vorgang schließen (Gerechtfertigt)">
      <bpmn:incoming>SequenceFlow_End4</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task -->
    <bpmn:task id="Task_InkassoUebergeben2" name="An Inkassodienstleister übergeben">
      <bpmn:incoming>SequenceFlow_Inkasso2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_End5</bpmn:outgoing>
    </bpmn:task>

     <!-- End Event -->
    <bpmn:endEvent id="EndEvent_VorgangSchliessen5" name="Vorgang schließen (Inkasso)">
      <bpmn:incoming>SequenceFlow_End5</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_FallPruefen" sourceRef="StartEvent_1" targetRef="Task_FallPruefen">
      <bpmn:name>Fall prüfen</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_MoeglichkeitCheck" name="Möglichkeit besteht?" sourceRef="InclusiveGateway_Moeglichkeit" targetRef="EndEvent_VorgangSchliessen1">
      <bpmn:name>Möglichkeit nicht vorhanden</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ZahlungsauflageSenden" name="Ja - Möglichkeit besteht" sourceRef="InclusiveGateway_Moeglichkeit" targetRef="Task_ZahlungsauflageSenden">
      <bpmn:name>Möglichkeit vorhanden</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_WartenStart" sourceRef="Task_ZahlungsauflageSenden" targetRef="InclusiveGateway_Warten">
      <bpmn:name>Zur Wartezeit</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_TimerPfad" sourceRef="InclusiveGateway_Warten" targetRef="IntermediateTimer_FristAbgelaufen">
      <bpmn:name>Frist abgelaufen</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_PaymentPfad" sourceRef="InclusiveGateway_Warten" targetRef="IntermediateMessage_GeldEingang">
      <bpmn:name>Geldeingang erwartet</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ObjectionPfad" sourceRef="InclusiveGateway_Warten" targetRef="IntermediateSignal_Widerspruch">
      <bpmn:name>Widerspruch erwartet</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_Inkasso1" sourceRef="IntermediateTimer_FristAbgelaufen" targetRef="Task_InkassoUebergeben1">
      <bpmn:name>Frist abgelaufen</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_End2" sourceRef="Task_InkassoUebergeben1" targetRef="EndEvent_VorgangSchliessen2">
      <bpmn:name>In Inkasso übergeben</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_Verbuchen" sourceRef="IntermediateMessage_GeldEingang" targetRef="Task_EingangVerbuchen">
      <bpmn:name>Geldeingang erhalten</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_End3" sourceRef="Task_EingangVerbuchen" targetRef="EndEvent_VorgangSchliessen3">
      <bpmn:name>Eingang verbucht</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_PruefenWiderruf" sourceRef="IntermediateSignal_Widerspruch" targetRef="Task_WiderspruchPruefen">
      <bpmn:name>Widerspruch erhalten</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_GerechtfertigtCheck" sourceRef="Task_WiderspruchPruefen" targetRef="InclusiveGateway_Gerechtfertigt">
      <bpmn:name>Zur Prüfung</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_End4" sourceRef="InclusiveGateway_Gerechtfertigt" targetRef="EndEvent_VorgangSchliessen4">
      <bpmn:name>Gerechtfertigt</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_Inkasso2" sourceRef="InclusiveGateway_Gerechtfertigt" targetRef="Task_InkassoUebergeben2">
      <bpmn:name>Nicht gerechtfertigt</bpmn:name>
    </bpmn:sequenceFlow>

     <bpmn:sequenceFlow id="SequenceFlow_End5" sourceRef="Task_InkassoUebergeben2" targetRef="EndEvent_VorgangSchliessen5">
      <bpmn:name>In Inkasso übergeben</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>