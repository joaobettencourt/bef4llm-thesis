<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_Unbedenklichkeit">
    <bpmn:participant id="Participant_Process" name="Unbedenklichkeitsbescheinigung Prozess" processRef="Process_1" />
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Bearbeitung" name="Bearbeitung">
        <bpmn:flowNodeRef>StartEvent_Anfrage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InitProcess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_KnownPerson</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_EmployerRole</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_InfoRequested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VerifyPeriods</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ValidateProofs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DoubtsExist</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckEstimates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_MergeProofs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckClaims</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_EvaluationGoodStanding</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IssueCertFull</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IssueCertPartial</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_MergeHistory</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateHistory</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_CertIssued</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EscalateCase</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Anfrage" name="Anfrage Eingang">
      <bpmn:outgoing>SequenceFlow_InitProcess</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Initialize Process & Set Counters -->
    <bpmn:task id="Task_InitProcess" name="Prozess initialisieren &amp; Zähler setzen">
      <bpmn:incoming>SequenceFlow_InitProcess</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckIdentity</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Known Person? -->
    <bpmn:exclusiveGateway id="Gateway_KnownPerson" name="Person im System?">
      <bpmn:incoming>SequenceFlow_CheckIdentity</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_YesKnown</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoKnown</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event: Rejected -->
    <bpmn:endEvent id="EndEvent_Rejected" name="Anfrage abgelehnt">
      <bpmn:incoming>SequenceFlow_NoKnown</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Gateway: Employer Role? -->
    <bpmn:exclusiveGateway id="Gateway_EmployerRole" name="Arbeitgeber Rolle?">
      <bpmn:incoming>SequenceFlow_YesKnown</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NoEmployer</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_EmployerPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Create Letter -->
    <bpmn:task id="Task_CreateLetter" name="Anschreiben erstellen">
      <bpmn:incoming>SequenceFlow_NoEmployer</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InfoSent</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event: Info Requested -->
    <bpmn:endEvent id="EndEvent_InfoRequested" name="Info angefordert">
      <bpmn:incoming>SequenceFlow_InfoSent</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task: Verify Periods & Proofs (Sequential) -->
    <bpmn:task id="Task_VerifyPeriods" name="Versicherungszeiten prüfen">
      <bpmn:incoming>SequenceFlow_EmployerPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProofCountCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Validate Proof Count -->
    <bpmn:task id="Task_ValidateProofs" name="Anzahl Nachweise validieren">
      <bpmn:incoming>SequenceFlow_ProofCountCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DoubtsExist</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Doubts Exist? -->
    <bpmn:exclusiveGateway id="Gateway_DoubtsExist" name="Unsicherheiten bestehen?">
      <bpmn:incoming>SequenceFlow_DoubtsExist</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckEstimatesYes</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SkipCheckPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Check Estimates -->
    <bpmn:task id="Task_CheckEstimates" name="Beitragsschätzungen prüfen">
      <bpmn:incoming>SequenceFlow_CheckEstimatesYes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeProofsCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Merge Proof Checks -->
    <bpmn:inclusiveGateway id="InclusiveGateway_MergeProofs" name="Prüfung abgeschlossen">
      <bpmn:incoming>SequenceFlow_SkipCheckPath</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_MergeProofsCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ClaimsCheck</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Task: Check Claims -->
    <bpmn:task id="Task_CheckClaims" name="Offene Forderungen prüfen">
      <bpmn:incoming>SequenceFlow_ClaimsCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EvaluationStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Evaluation Good Standing -->
    <bpmn:exclusiveGateway id="Gateway_EvaluationGoodStanding" name="Bewertung Unbedenklichkeit">
      <bpmn:incoming>SequenceFlow_EvaluationStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FullCertPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PartialCertPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_EscalationPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Issue Full Certificate -->
    <bpmn:task id="Task_IssueCertFull" name="Bescheinigung ausstellen (Vollständig)">
      <bpmn:incoming>SequenceFlow_FullCertPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeHistoryStart1</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Issue Partial Certificate -->
    <bpmn:task id="Task_IssueCertPartial" name="Bescheinigung ausstellen (Hinweis)">
      <bpmn:incoming>SequenceFlow_PartialCertPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeHistoryStart2</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Merge History Paths -->
    <bpmn:inclusiveGateway id="InclusiveGateway_MergeHistory" name="Historie eintragen">
      <bpmn:incoming>SequenceFlow_MergeHistoryStart1</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_MergeHistoryStart2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_UpdateHistTask</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Task: Update Contact History -->
    <bpmn:task id="Task_UpdateHistory" name="Eintrag in Kontakthistorie">
      <bpmn:incoming>SequenceFlow_UpdateHistTask</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CertIssuedEnd</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event: Certificate Issued -->
    <bpmn:endEvent id="EndEvent_CertIssued" name="Bescheinigung ausgestellt">
      <bpmn:incoming>SequenceFlow_CertIssuedEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task: Escalate Case -->
    <bpmn:task id="Task_EscalateCase" name="Fall an Sachbearbeiter übergeben">
      <bpmn:incoming>SequenceFlow_EscalationPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CaseEscalatedEnd</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event: Case Escalated -->
    <bpmn:endEvent id="EndEvent_Escalation" name="Fall eskaliert">
      <bpmn:incoming>SequenceFlow_CaseEscalatedEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_InitProcess" sourceRef="StartEvent_Anfrage" targetRef="Task_InitProcess">
      <bpmn:bpmndi:name>Anfrage Eingang</bpmn:bpmndi:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_CheckIdentity" sourceRef="Task_InitProcess" targetRef="Gateway_KnownPerson">
      <bpmn:bpmndi:name>Prüfe Identität</bpmn:bpmndi:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_YesKnown" sourceRef="Gateway_KnownPerson" targetRef="Gateway_EmployerRole">
      <bpmn:bpmndi:name>Jain</bpmn:bpmndi:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_NoKnown" sourceRef="Gateway_KnownPerson" targetRef="EndEvent_Rejected">
      <bpmn:bpmndi:name>Nein</bpmn:bpmndi:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_NoEmployer" sourceRef="Gateway_EmployerRole" targetRef="Task_CreateLetter">
      <bpmn:bpmndi:name>Nicht Arbeitgeber</bpmn:bpmndi:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_InfoSent" sourceRef="Task_CreateLetter" targetRef="EndEvent_InfoRequested">
      <bpmn:bpmndi:name>Anschreiben versendet</bpmn:bpmndi:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_EmployerPath" sourceRef="Gateway_EmployerRole" targetRef="Task_VerifyPeriods">
      <bpmn:bpmndi:name>Jain</bpmn:bpmndi:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ProofCountCheck" sourceRef="Task_VerifyPeriods" targetRef="Task_ValidateProofs">
      <bpmn:bpmndi:name>Versicherungszeiten geprüft</bpmn:bpmndi:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_DoubtsExist" sourceRef="Task_ValidateProofs" targetRef="Gateway_DoubtsExist">
      <bpmn:bpmndi:name>Nachweise validiert</bpmn:bpmndi:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_CheckEstimatesYes" sourceRef="Gateway_DoubtsExist" targetRef="Task_CheckEstimates">
      <bpmn:bpmndi:name>Jain</bpmn:bpmndi:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_SkipCheckPath" sourceRef="Gateway_DoubtsExist" targetRef="InclusiveGateway_MergeProofs">
      <bpmn:bpmndi:name>Nein</bpmn:bpmndi:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_MergeProofsCheck" sourceRef="Task_CheckEstimates" targetRef="InclusiveGateway_MergeProofs">
      <bpmn:bpmndi:name>Schätzungen geprüft</bpmn:bpmndi:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ClaimsCheck" sourceRef="InclusiveGateway_MergeProofs" targetRef="Task_CheckClaims">
      <bpmn:bpmndi:name>Forderungen prüfen</bpmn:bpmndi:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_EvaluationStart" sourceRef="Task_CheckClaims" targetRef="Gateway_EvaluationGoodStanding">
      <bpmn:bpmndi:name>Forderungen geprüft</bpmn:bpmndi:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_FullCertPath" sourceRef="Gateway_EvaluationGoodStanding" targetRef="Task_IssueCertFull">
      <bpmn:bpmndi:name>Vollständig</bpmn:bpmndi:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_PartialCertPath" sourceRef="Gateway_EvaluationGoodStanding" targetRef="Task_IssueCertPartial">
      <bpmn:bpmndi:name>Hinweis erforderlich</bpmn:bpmndi:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_MergeHistoryStart1" sourceRef="Task_IssueCertFull" targetRef="InclusiveGateway_MergeHistory">
      <bpmn:bpmndi:name>Vollständig ausgestellt</bpmn:bpmndi:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_MergeHistoryStart2" sourceRef="Task_IssueCertPartial" targetRef="InclusiveGateway_MergeHistory">
      <bpmn:bpmndi:name>Hinweis ausgestellt</bpmn:bpmndi:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_UpdateHistTask" sourceRef="InclusiveGateway_MergeHistory" targetRef="Task_UpdateHistory">
      <bpmn:bpmndi:name>Historie eintragen</bpmn:bpmndi:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_CertIssuedEnd" sourceRef="Task_UpdateHistory" targetRef="EndEvent_CertIssued">
      <bpmn:bpmndi:name>Bearbeitung abgeschlossen</bpmn:bpmndi:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_EscalationPath" sourceRef="Gateway_EvaluationGoodStanding" targetRef="Task_EscalateCase">
      <bpmn:bpmndi:name>Nicht erfüllt</bpmn:bpmndi:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_CaseEscalatedEnd" sourceRef="Task_EscalateCase" targetRef="EndEvent_Escalation">
      <bpmn:bpmndi:name>Fall eskaliert</bpmn:bpmndi:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>