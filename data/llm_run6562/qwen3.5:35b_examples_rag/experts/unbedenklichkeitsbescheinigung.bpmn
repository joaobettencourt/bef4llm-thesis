<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_Unbedenklichkeit_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:message id="StartEvent_msg" name="Anfrage Unbedenklichkeitsbescheinigung" />

  <bpmn:collaboration id="Collaboration_Unbedenklichkeit">
    <bpmn:participant id="Participant_System" name="Unbedenklichkeitsprüfung System" processRef="Process_Unbedenklichkeit_01" />
  </bpmn:collaboration>

  <bpmn:process id="Process_Unbedenklichkeit_01" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_AnfrageEingegangen" name="Anfrage für Unbedenklichkeitsbescheinigung eingegangen">
      <bpmn:messageEventDefinition messageRef="StartEvent_msg" />
      <bpmn:outgoing>Flow_SystemInitialisierung</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Tasks -->
    <bpmn:userTask id="UserTask_VorgangIdentifizieren" name="Vorgang im System identifizieren">
      <bpmn:incoming>Flow_SystemInitialisierung</bpmn:incoming>
      <bpmn:outgoing>Flow_ZaehlerSetzen</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="ServiceTask_AnfragePruefen" name="Anzahl Bescheinigungen auf null setzen">
      <bpmn:incoming>Flow_ZaehlerSetzen</bpmn:incoming>
      <bpmn:outgoing>Flow_AbsenderPruefen</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="UserTask_SystemInitialisierung" name="Vorgang im System korrekt nachvollziehbar machen">
      <bpmn:incoming>Flow_VorgangIdentifizieren</bpmn:incoming>
      <bpmn:outgoing>Flow_ZaehlerSetzen</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway 1 -->
    <bpmn:exclusiveGateway id="Gate_AbsenderExistiert" name="Person im System vorhanden?">
      <bpmn:incoming>Flow_AbsenderPruefen</bpmn:incoming>
      <bpmn:outgoing>Flow_Weiterbearbeiten</bpmn:outgoing>
      <bpmn:outgoing>Flow_AnfrageErstellen</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Tasks for person not found -->
    <bpmn:userTask id="UserTask_Anschreiben" name="Anschreiben zur Informationsermittlung erstellen">
      <bpmn:incoming>Flow_AnfrageErstellen</bpmn:incoming>
      <bpmn:outgoing>Flow_WartenRuecklauf</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway 2 -->
    <bpmn:exclusiveGateway id="Gate_RolleVorhanden" name="Arbeitgeberrolle vorhanden?">
      <bpmn:incoming>Flow_AbsenderPruefen</bpmn:incoming>
      <bpmn:outgoing>Flow_VersicherungszeitenPruefen</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Tasks for employer role -->
    <bpmn:userTask id="UserTask_AbsenderPruefen" name="Absenderrolle prüfen (Arbeitgeber?)">
      <bpmn:incoming>Flow_Weiterbearbeiten</bpmn:incoming>
      <bpmn:outgoing>Gate_RolleVorhanden_Flow1</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Tasks for verification -->
    <bpmn:userTask id="UserTask_Meldezeitraum" name="Ende des Meldezeitraums überprüfen">
      <bpmn:incoming>Flow_VersicherungszeitenPruefen</bpmn:incoming>
      <bpmn:outgoing>Flow_BeitragshoehePruefen</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway 3 -->
    <bpmn:exclusiveGateway id="Gate_AnzahlBeitragsnachweiseOK" name="Anzahl Beitragsnachweise korrekt?">
      <bpmn:incoming>Flow_VersicherungszeitraumErmitteln</bpmn:incoming>
      <bpmn:outgoing>Flow_BeitragsschaetzungPruefen</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Tasks for contribution verification -->
    <bpmn:userTask id="UserTask_AnzahlBeitragsnachweise" name="Anzahl eingereichter Beitragsnachweise prüfen">
      <bpmn:incoming>Flow_BeitragshoehePruefen</bpmn:incoming>
      <bpmn:outgoing>Gate_AnzahlBeitragsnachwegeOK_Flow1</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway 4 -->
    <bpmn:exclusiveGateway id="Gate_Nachweis0EuroVorhanden" name="Nachweise mit 0,00 € vorhanden?">
      <bpmn:incoming>Flow_BeitragshoehePruefen</bpmn:incoming>
      <bpmn:outgoing>Flow_ForderungenPruefen</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Tasks for contribution amount -->
    <bpmn:userTask id="UserTask_BeitragshoehePruefen" name="Beitragsschätzungen überprüfen">
      <bpmn:incoming>Flow_AnzahlBeitragsnachwegeOK_Flow1</bpmn:incoming>
      <bpmn:outgoing>Gate_Nachweis0EuroVorhanden_Flow1</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway 5 -->
    <bpmn:exclusiveGateway id="Gate_UnbedenklichkeitBewerten" name="Alle Anforderungen erfüllt?">
      <bpmn:incoming>Flow_ForderungenPruefen</bpmn:incoming>
      <bpmn:outgoing>Flow_BescheinigungVollstaendig</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Tasks for final assessment -->
    <bpmn:userTask id="UserTask_ForderungenPruefen" name="Offene Forderungen (unbezahlte Beiträge) prüfen">
      <bpmn:incoming>Flow_Nachweis0EuroVorhanden_Flow1</bpmn:incoming>
      <bpmn:outgoing>Gate_UnbedenklichkeitBewerten_Flow1</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Tasks for certificate issuance -->
    <bpmn:userTask id="UserTask_BescheinigungAusstellen" name="Unbedenklichkeitsbescheinigung ausstellen">
      <bpmn:incoming>Flow_UnbedenklichkeitBewertet</bpmn:outgoing>
      <bpmn:outgoing>Flow_KontaktHistorieEintrag</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Tasks for contact history -->
    <bpmn:userTask id="UserTask_KontaktHistorieEintrag" name="Eintrag in Kontakthistorie vornehmen">
      <bpmn:incoming>Flow_BescheinigungVollstaendig</bpmn:outgoing>
      <bpmn:outgoing>EndEvent_Vollstaendig_Flow1</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_AnfrageNichtFertig" name="Vorgang nicht weiter bearbeitbar">
      <bpmn:incoming>Flow_WartenRuecklauf</bpmn:outgoing>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_Vollstaendig_Flow1" name="Unbedenklichkeitsbescheinigung ausgestellt (vollständig)">
      <bpmn:incoming>Flow_KontaktHistorieEintrag</bpmn:outgoing>
    </bpmn:endEvent>

    <!-- Flows -->
    <bpmn:sequenceFlow id="Flow_SystemInitialisierung" sourceRef="StartEvent_AnfrageEingegangen" targetRef="UserTask_VorgangIdentifizieren">
      <bpmn:name>Vorgang identifizieren</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_ZaehlerSetzen" sourceRef="UserTask_SystemInitialisierung" targetRef="ServiceTask_AnfragePruefen">
      <bpmn:name>Zähler auf null setzen</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_AbsenderPruefen" sourceRef="UserTask_VorgangIdentifizieren" targetRef="Gate_RolleVorhanden">
      <bpmn:name>Absender prüfen</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_Weiterbearbeiten" sourceRef="ServiceTask_AnfragePruefen" targetRef="UserTask_AbsenderPruefen">
      <bpmn:name>Já - Person vorhanden</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Gate_RolleVorhanden_Flow1" sourceRef="UserTask_AbsenderPruefen" targetRef="Gate_RolleVorhanden">
      <bpmn:name>Rolle prüfen</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_VersicherungszeitenPruefen" sourceRef="Gate_RolleVorhanden" targetRef="UserTask_Meldezeitraum">
      <bpmn:name>Já - Arbeitgeberrolle vorhanden</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_BeitragshoehePruefen" sourceRef="Gate_RolleVorhanden_Flow1" targetRef="UserTask_Meldezeitraum">
      <bpmn:name>Já - Arbeitgeberrolle vorhanden</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_VersicherungszeitraumErmitteln" sourceRef="Gate_RolleVorhanden_Flow1" targetRef="UserTask_Meldezeitraum">
      <bpmn:name>Já - Arbeitgeberrolle vorhanden</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_BeitragshoehePruefen_Flow1" sourceRef="UserTask_Meldezeitraum" targetRef="Gate_AnzahlBeitragsnachweiseOK">
      <bpmn:name>Meldezeitraum prüfen</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_BeitragshoehePruefen_Flow2" sourceRef="UserTask_Meldezeitraum" targetRef="Gate_AnzahlBeitragsnachweiseOK">
      <bpmn:name>Meldezeitraum prüfen</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_BeitragshoehePruefen_Flow3" sourceRef="UserTask_Meldezeitraum" targetRef="Gate_AnzahlBeitragsnachweiseOK">
      <bpmn:name>Meldezeitraum prüfen</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_BeitragshoehePruefen_Flow4" sourceRef="UserTask_Meldezeitraum" targetRef="Gate_AnzahlBeitragsnachweiseOK">
      <bpmn:name>Meldezeitraum prüfen</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_BeitragshoehePruefen_Flow5" sourceRef="UserTask_Meldezeitraum" targetRef="Gate_AnzahlBeitragsnachweiseOK">
      <bpmn:name>Meldezeitraum prüfen</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_BeitragshoehePruefen_Flow6" sourceRef="UserTask_Meldezeitraum" targetRef="Gate_AnzahlBeitragsnachweiseOK">
      <bpmn:name>Meldezeit