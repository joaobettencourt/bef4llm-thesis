<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                 xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" 
                 xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" 
                 xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                 id="Definitions_HealthPromotion" targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:collaboration id="Collaboration_HealthProgram">
    <bpmn:participant id="Participant_Gesundheitsfoerderung" name="Betriebliche Gesundheitsförderung" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="true">
    
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_ProgrammBeginn" name="Programmstart Gesundheitsförderung">
      <bpmn:outgoing>SequenceFlow_StartToHealthCheck</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Health Check Phase -->
    <bpmn:userTask id="Task_GesundheitsCheck" name="Gesundheits-Check durchführen">
      <bpmn:incoming>SequenceFlow_StartToHealthCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_HealthCheckToParallel</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel Gateway for measurements and training -->
    <bpmn:parallelGateway id="Gateway_MeasurementsTraining" name="Messungen und Einweisung parallel">
      <bpmn:incoming>SequenceFlow_HealthCheckToParallel</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ParallelToMeasurements</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ParallelToTrainingApp</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Measurement Tasks -->
    <bpmn:userTask id="Task_Messungen" name="Gesundheitsparameter messen (Blutdruck, Taillenumfang, Körperzusammensetzung)">
      <bpmn:incoming>SequenceFlow_ParallelToMeasurements</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MeasurementsToWorkAbility</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_WorkAbility" name="Work Ability Index erheben">
      <bpmn:incoming>SequenceFlow_MeasurementsToWorkAbility</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WAItoBloodSample</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_BloodSample" name="Blutprobe nehmen">
      <bpmn:incoming>SequenceFlow_WAItoBloodSample</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SampleToAppTraining</bpmn:outgoing>
    </bpmn:userTask>

    <!-- App and Wearable Training -->
    <bpmn:userTask id="Task_AppWearableTraining" name="Einweisung in App und Wearables">
      <bpmn:incoming>SequenceFlow_ParallelToTrainingApp</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TrainingDataCollection</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Data Collection -->
    <bpmn:userTask id="Task_DataCollection" name="Trainingsdaten erfassen und Fortschritt überwachen">
      <bpmn:incoming>SequenceFlow_TrainingDataCollection</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CollectionToPlanCreation</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Plan Creation -->
    <bpmn:userTask id="Task_PlanCreation" name="Individuelle Trainings- und Ernährungspläne erstellen">
      <bpmn:incoming>SequenceFlow_CollectionToPlanCreation</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PlansToTrainingPhase</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Training Phase -->
    <bpmn:userTask id="Task_Training" name="Individuelles Trainingsprogramm (6 Monate)">
      <bpmn:incoming>SequenceFlow_PlansToTrainingPhase</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TrainingToMidCheck</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Optional Nutritional Counseling -->
    <bpmn:userTask id="Task_NutritionCounseling" name="Zusätzliche Ernährungsberatung">
      <bpmn:incoming>SequenceFlow_CollectionToPlanCreation</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CounselingBackTraining</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Mid-term Check -->
    <bpmn:userTask id="Task_MidCheck" name="Zwischen-Check nach 6 Monaten">
      <bpmn:incoming>SequenceFlow_TrainingToMidCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MidCheckToGroupSplit</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Group Split -->
    <bpmn:exclusiveGateway id="Gateway_GroupSplit" name="Gruppeneinteilung">
      <bpmn:incoming>SequenceFlow_MidCheckToGroupSplit</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SplitNoWearables</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SplitWithWearables</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Group 1: Without Wearables -->
    <bpmn:userTask id="Task_TrainingNoWearables" name="Eigenständiges Training ohne Wearables">
      <bpmn:incoming>SequenceFlow_SplitNoWearables</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NoWearablesToFinalCheck</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Group 2: With Wearables -->
    <bpmn:userTask id="Task_TrainingWithWearables" name="Training mit App und Wearable-Unterstützung">
      <bpmn:incoming>SequenceFlow_SplitWithWearables</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WithWearablesToFinalCheck</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Final Check -->
    <bpmn:userTask id="Task_FinalCheck" name="Abschließender Gesundheits-Check">
      <bpmn:incoming>SequenceFlow_NoWearablesToFinalCheck</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_WithWearablesToFinalCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FinalToEnd</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_ProgrammEnde" name="Programmende">
      <bpmn:incoming>SequenceFlow_FinalToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToHealthCheck" sourceRef="StartEvent_ProgrammBeginn" targetRef="Task_GesundheitsCheck"/>
    <bpmn:sequenceFlow id="SequenceFlow_HealthCheckToParallel" sourceRef="Task_GesundheitsCheck" targetRef="Gateway_MeasurementsTraining"/>
    <bpmn:sequenceFlow id="SequenceFlow_ParallelToMeasurements" sourceRef="Gateway_MeasurementsTraining" targetRef="Task_Messungen"/>
    <bpmn:sequenceFlow id="SequenceFlow_ParallelToTrainingApp" sourceRef="Gateway_MeasurementsTraining" targetRef="Task_AppWearableTraining"/>
    <bpmn:sequenceFlow id="SequenceFlow_MeasurementsToWorkAbility" sourceRef="Task_Messungen" targetRef="Task_WorkAbility"/>
    <bpmn:sequenceFlow id="SequenceFlow_WAItoBloodSample" sourceRef="Task_WorkAbility" targetRef="Task_BloodSample"/>
    <bpmn:sequenceFlow id="SequenceFlow_SampleToAppTraining" sourceRef="Task_BloodSample" targetRef="Gateway_MeasurementsTraining"/>
    <bpmn:sequenceFlow id="SequenceFlow_TrainingDataCollection" sourceRef="Task_AppWearableTraining" targetRef="Task_DataCollection"/>
    <bpmn:sequenceFlow id="SequenceFlow_CollectionToPlanCreation" sourceRef="Task_DataCollection" targetRef="Gateway_PlanDecision"/>
    <bpmn:sequenceFlow id="SequenceFlow_PlansToTrainingPhase" sourceRef="Task_PlanCreation" targetRef="Task_Training"/>
    <bpmn:sequenceFlow id="SequenceFlow_CounselingBackTraining" sourceRef="Task_NutritionCounseling" targetRef="Gateway_TrainDecision"/>
    <bpmn:sequenceFlow id="SequenceFlow_TrainingToMidCheck" sourceRef="Task_Training" targetRef="Task_MidCheck"/>
    <bpmn:sequenceFlow id="SequenceFlow_MidCheckToGroupSplit" sourceRef="Task_MidCheck" targetRef="Gateway_GroupSplit"/>
    <bpmn:sequenceFlow id="SequenceFlow_SplitNoWearables" name="Ohne Wearables" sourceRef="Gateway_GroupSplit" targetRef="Task_TrainingNoWearables"/>
    <bpmn:sequenceFlow id="SequenceFlow_SplitWithWearables" name="Mit App und Wearables" sourceRef="Gateway_GroupSplit" targetRef="Task_TrainingWithWearables"/>
    <bpmn:sequenceFlow id="SequenceFlow_NoWearablesToFinalCheck" sourceRef="Task_TrainingNoWearables" targetRef="Gateway_FinalMerge"/>
    <bpmn:sequenceFlow id="SequenceFlow_WithWearablesToFinalCheck" sourceRef="Task_TrainingWithWearables" targetRef="Gateway_FinalMerge"/>
    <bpmn:sequenceFlow id="SequenceFlow_FinalToEnd" sourceRef="Gateway_FinalMerge" targetRef="EndEvent_ProgrammEnde"/>

  </bpmn:process>
</bpmn:definitions>