<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_ComputerHardwareShop_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_OrderProcess">
    <bpmn:participant id="Participant_HardwareShop" name="Computer Hardware Shop" processRef="Process_Shipping_01" />
  </bpmn:collaboration>

  <bpmn:process id="Process_Shipping_01" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Secretary" name="Sekretariat">
        <bpmn:flowNodeRef>StartEvent_WareVersenden</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_Versandart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AngeboteEinholen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AngebotAuswahlen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PaketscheinAuffullen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_Versicherung</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Warehouse" name="Lagerarbeiter">
        <bpmn:flowNodeRef>Task_WareVerpacken</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_AbholtBereitstellen</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Logistics" name="Logistikleiter">
        <bpmn:flowNodeRef>Task_VersicherungAbschliessen</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_WareVersenden" name="Ware versendet werden soll">
      <bpmn:outgoing>SequenceFlow_Split</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Parallel Gateway Split (Warehouse Packing vs Secretary Arrangements) -->
    <bpmn:parallelGateway id="ParallelGateway_Start" name="">
      <bpmn:incoming>SequenceFlow_Split</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WarehousePack</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SecretaryDecide</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Warehouse Lane Task -->
    <bpmn:userTask id="Task_WareVerpacken" name="Ware verpacken">
      <bpmn:incoming>SequenceFlow_WarehousePack</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PackToJoin</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Secretary Lane Decision (Large vs Small Quantities) -->
    <bpmn:exclusiveGateway id="InclusiveGateway_Versandart" name="Sonderversand notwendig?">
      <bpmn:incoming>SequenceFlow_SecretaryDecide</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_LargeQty</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SmallQty</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Large Quantity Path -->
    <bpmn:userTask id="Task_AngeboteEinholen" name="Angebote von Spediteuren einholen">
      <bpmn:incoming>SequenceFlow_LargeQty</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SelectOffer</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_AngebotAuswahlen" name="Angebot auswählen &amp; beauftragen">
      <bpmn:incoming>SequenceFlow_SelectOffer</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_LargeToJoin</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Small Quantity Path -->
    <bpmn:userTask id="Task_PaketscheinAuffullen" name="Paketschein ausfüllen">
      <bpmn:incoming>SequenceFlow_SmallQty</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckInsurance</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Insurance Decision -->
    <bpmn:exclusiveGateway id="InclusiveGateway_Versicherung" name="Versicherung erforderlich?">
      <bpmn:incoming>SequenceFlow_CheckInsurance</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_YesInsure</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoInsure</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Insurance Task (Logistics Manager) -->
    <bpmn:userTask id="Task_VersicherungAbschliessen" name="Versicherung abschließen">
      <bpmn:incoming>SequenceFlow_YesInsure</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InsuranceToJoin</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Final Parallel Gateway Join -->
    <bpmn:parallelGateway id="ParallelGateway_Join" name="">
      <bpmn:incoming>SequenceFlow_PackToJoin</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_LargeToJoin</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_InsuranceToJoin</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FinalTask</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- End Task -->
    <bpmn:userTask id="EndEvent_AbholtBereitstellen" name="Ware zur Abholung bereitstellen">
      <bpmn:incoming>SequenceFlow_FinalTask</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToEnd</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Process" name="Versand vorbereitet">
      <bpmn:incoming>SequenceFlow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows (without internal name/description elements) -->
    <bpmn:sequenceFlow id="SequenceFlow_Split" sourceRef="StartEvent_WareVersenden" targetRef="ParallelGateway_Start">
      <bpmn:name>Versand starten</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_WarehousePack" sourceRef="ParallelGateway_Start" targetRef="Task_WareVerpacken">
      <bpmn:name>Packing parallel</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_SecretaryDecide" sourceRef="ParallelGateway_Start" targetRef="InclusiveGateway_Versandart">
      <bpmn:name>Sekretariat entscheidet</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_LargeQty" name="Ja (Große Menge)" sourceRef="InclusiveGateway_Versandart" targetRef="Task_AngeboteEinholen">
      <bpmn:description>Sonderversand notwendig</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_SelectOffer" sourceRef="Task_AngeboteEinholen" targetRef="Task_AngebotAuswahlen">
      <bpmn:name>Angebot auswählen</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_LargeToJoin" sourceRef="Task_AngebotAuswahlen" targetRef="ParallelGateway_Join">
      <bpmn:name>Bereit für Abholung</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_SmallQty" name="Nein (Kleine Menge)" sourceRef="InclusiveGateway_Versandart" targetRef="Task_PaketscheinAuffullen">
      <bpmn:description>Normaler Versand</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_CheckInsurance" sourceRef="Task_PaketscheinAuffullen" targetRef="InclusiveGateway_Versicherung">
      <bpmn:name>Versicherungsprüfung</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_YesInsure" name="Ja (Versicherung)" sourceRef="InclusiveGateway_Versicherung" targetRef="Task_VersicherungAbschliessen">
      <bpmn:description>Versicherung erforderlich</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_InsuranceToJoin" sourceRef="Task_VersicherungAbschliessen" targetRef="ParallelGateway_Join">
      <bpmn:name>Versicherung abgeschlossen</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_NoInsure" name="Nein (Keine Versicherung)" sourceRef="InclusiveGateway_Versicherung" targetRef="ParallelGateway_Join">
      <bpmn:description>Versicherung nicht erforderlich</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_PackToJoin" sourceRef="Task_WareVerpacken" targetRef="ParallelGateway_Join">
      <bpmn:name>Packing complete</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_FinalTask" sourceRef="ParallelGateway_Join" targetRef="EndEvent_AbholtBereitstellen">
      <bpmn:name>Vorbereitung abgeschlossen</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ToEnd" sourceRef="EndEvent_AbholtBereitstellen" targetRef="EndEvent_Process">
      <bpmn:name>Fertigstellung</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>