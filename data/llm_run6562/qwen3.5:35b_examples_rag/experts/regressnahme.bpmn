<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_Regress_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_RegressProcess">
    <bpmn:participant id="Participant_Sachbearbeiter" name="Sachbearbeiter Versicherung" processRef="Process_Regress_01" />
  </bpmn:collaboration>

  <bpmn:process id="Process_Regress_01" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Sachbearbeiter" name="Sachbearbeiter Versicherung">
        <bpmn:flowNodeRef>StartEvent_RegressNotification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckCasePossibility</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RegressionPossible</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendPaymentDemand</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_CloseCaseNoPossibility</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MoneyReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BookReceipt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_CloseCaseMoneyReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DeadlineExpiredOrObjection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckObjection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_CloseCaseJustified</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ObjectionJustified</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HandOverToCollectionAgency</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_CloseCaseHandedOver</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_RegressNotification" name="Regressmeldung erhalten">
      <bpmn:outgoing>Flow_CheckCasePossibility</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Check case possibility -->
    <bpmn:userTask id="Task_CheckCasePossibility" name="Fall prüfen auf Regressmöglichkeit">
      <bpmn:incoming>Flow_CheckCasePossibility</bpmn:incoming>
      <bpmn:outgoing>Flow_RegressionPossibleCheck</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway: Is regression possible? -->
    <bpmn:exclusiveGateway id="Gateway_RegressionPossible" name="Regress möglich?">
      <bpmn:incoming>Flow_RegressionPossibleCheck</bpmn:incoming>
      <bpmn:outgoing>Flow_SendDemandYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_CloseNoPossibility</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Send payment demand -->
    <bpmn:userTask id="Task_SendPaymentDemand" name="Zahlungsauflage senden &amp; Wiedervorlage">
      <bpmn:incoming>Flow_SendDemandYes</bpmn:incoming>
      <bpmn:outgoing>Flow_WaitForMoneyOrDeadline</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event: Close case - no possibility -->
    <bpmn:endEvent id="EndEvent_CloseCaseNoPossibility" name="Vorgang geschlossen (kein Regress)">
      <bpmn:incoming>Flow_CloseNoPossibility</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Gateway: Money received or deadline expired -->
    <bpmn:exclusiveGateway id="Gateway_MoneyReceived" name="Geld eingegangen?">
      <bpmn:incoming>Flow_WaitForMoneyOrDeadline</bpmn:incoming>
      <bpmn:outgoing>Flow_BookReceiptYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_DeadlineExpiredNoObjection</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Book receipt -->
    <bpmn:userTask id="Task_BookReceipt" name="Eingang verbuchen">
      <bpmn:incoming>Flow_BookReceiptYes</bpmn:incoming>
      <bpmn:outgoing>Flow_CloseCaseMoneyReceived</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event: Close case - money received -->
    <bpmn:endEvent id="EndEvent_CloseCaseMoneyReceived" name="Vorgang geschlossen (Zahlung erhalten)">
      <bpmn:incoming>Flow_CloseCaseMoneyReceived</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Gateway: Deadline expired or objection -->
    <bpmn:exclusiveGateway id="Gateway_DeadlineExpiredOrObjection" name="Frist abgelaufen oder Widerspruch?">
      <bpmn:incoming>Flow_WaitForMoneyOrDeadline</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckObjectionYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_HandOverToCollectionNoObjection</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Check objection -->
    <bpmn:userTask id="Task_CheckObjection" name="Widerspruch prüfen">
      <bpmn:incoming>Flow_CheckObjectionYes</bpmn:incoming>
      <bpmn:outgoing>Flow_JustifiedCheck</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway: Is objection justified? -->
    <bpmn:exclusiveGateway id="Gateway_ObjectionJustified" name="Widerspruch gerechtfertigt?">
      <bpmn:incoming>Flow_JustifiedCheck</bpmn:incoming>
      <bpmn:outgoing>Flow_CloseCaseJustifiedYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_HandOverToCollectionNoJustification</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event: Close case - justified objection -->
    <bpmn:endEvent id="EndEvent_CloseCaseJustified" name="Vorgang geschlossen (Widerspruch gerechtfertigt)">
      <bpmn:incoming>Flow_CloseCaseJustifiedYes</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task: Hand over to collection agency -->
    <bpmn:userTask id="Task_HandOverToCollectionAgency" name="An Inkasso-Dienstleister abgeben">
      <bpmn:incoming>Flow_HandOverToCollectionNoObjection</bpmn:incoming>
      <bpmn:incoming>Flow_HandOverToCollectionNoJustification</bpmn:incoming>
      <bpmn:outgoing>Flow_CloseCaseHandedOver</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event: Close case - handed to collection -->
    <bpmn:endEvent id="EndEvent_CloseCaseHandedOver" name="Vorgang geschlossen (Inkasso)">
      <bpmn:incoming>Flow_CloseCaseHandedOver</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Flow_CheckCasePossibility" sourceRef="StartEvent_RegressNotification" targetRef="Task_CheckCasePossibility">
      <bpmn:name>Vermuteter Regress</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_RegressionPossibleCheck" sourceRef="Task_CheckCasePossibility" targetRef="Gateway_RegressionPossible">
      <bpmn:name>Fall geprüft</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_SendDemandYes" name="ja - Regress möglich" sourceRef="Gateway_RegressionPossible" targetRef="Task_SendPaymentDemand">
      <bpmn:name>Regress möglich</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_CloseNoPossibility" name="nein - kein Regress" sourceRef="Gateway_RegressionPossible" targetRef="EndEvent_CloseCaseNoPossibility">
      <bpmn:name>Keine Regressmöglichkeit</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_WaitForMoneyOrDeadline" sourceRef="Task_SendPaymentDemand" targetRef="Gateway_MoneyReceived">
      <bpmn:name>Zahlung abwarten / Frist prüfen</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_BookReceiptYes" name="ja - Geld eingegangen" sourceRef="Gateway_MoneyReceived" targetRef="Task_BookReceipt">
      <bpmn:name>Zahlung erhalten</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_DeadlineExpiredNoObjection" name="nein - Frist abgelaufen / kein Widerspruch" sourceRef="Gateway_MoneyReceived" targetRef="Gateway_DeadlineExpiredOrObjection">
      <bpmn:name>Frist ohne Zahlung</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_CloseCaseMoneyReceived" sourceRef="Task_BookReceipt" targetRef="EndEvent_CloseCaseMoneyReceived">
      <bpmn:name>Vorgang abschließen</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_CheckObjectionYes" name="ja - Widerspruch eingegangen" sourceRef="Gateway_DeadlineExpiredOrObjection" targetRef="Task_CheckObjection">
      <bpmn:name>VN widerspricht</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_HandOverToCollectionNoObjection" name="nein - kein Widerspruch / Frist abgelaufen" sourceRef="Gateway_DeadlineExpiredOrObjection" targetRef="Task_HandOverToCollectionAgency">
      <bpmn:name>Keine Zahlung, keine Rechtfertigung</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_JustifiedCheck" sourceRef="Task_CheckObjection" targetRef="Gateway_ObjectionJustified">
      <bpmn:name>Widerspruch geprüft</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_CloseCaseJustifiedYes" name="ja - gerechtfertigt" sourceRef="Gateway_ObjectionJustified" targetRef="EndEvent_CloseCaseJustified">
      <bpmn:name>Gerechtfertigter Widerspruch</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_HandOverToCollectionNoJustification" name="nein - nicht gerechtfertigt" sourceRef="Gateway_ObjectionJustified" targetRef="Task_HandOverToCollectionAgency">
      <bpmn:name>Nicht gerechtfertigter Widerspruch</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_CloseCaseHandedOver" sourceRef="Task_HandOverToCollectionAgency" targetRef="EndEvent_CloseCaseHandedOver">
      <bpmn:name>Vorgang abschließen</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>