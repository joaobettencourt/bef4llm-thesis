<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_HealthProgram" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_HealthProg">
    <bpmn:participant id="Participant_HealthProg" name="Betriebliche Gesundheitsförderung" processRef="Process_HealthProg"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_HealthProg" isExecutable="false">
    <bpmn:laneSet id="LaneSet_HealthProg">
      <bpmn:lane id="Lane_Participants" name="Teilnehmer">
        <bpmn:flowNodeRef>StartEvent_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GesundheitsCheckDetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AppTraining</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_TrainingStart_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Trainieren_Phase1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SixMonthCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_MidtermCheck_002</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Trainieren_Phase1a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_GroupSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_FinalCheck_004</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Coaches" name="Gesundheitscoaches">
        <bpmn:flowNodeRef>Task_AppTraining</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WearableTraining</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TrainingsPlanErstellen</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Medical" name="Sportmediziner">
        <bpmn:flowNodeRef>Task_GesundheitsCheckDetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ZwischenCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AbschlussCheck</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_001" name="Programmstart">
      <bpmn:outgoing>SequenceFlow_StartToCheck</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Health Check Tasks (Medical) -->
    <bpmn:task id="Task_GesundheitsCheckDetails" name="Gesundheits-Check durchführen">
      <bpmn:incoming>SequenceFlow_StartToCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckToCoaches</bpmn:outgoing>
    </bpmn:task>

    <!-- App and Wearable Training (Parallel) -->
    <bpmn:parallelGateway id="Gateway_AppTraining" name="App &amp; Wearables Einweisung">
      <bpmn:incoming>SequenceFlow_CheckToCoaches</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TrainingPlan1</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Training Plan Creation -->
    <bpmn:task id="Task_TrainingsPlanErstellen" name="Individuelle Trainings- und Ernährungspläne erstellen">
      <bpmn:incoming>SequenceFlow_AppTrainingDone</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PlanToParticipants</bpmn:outgoing>
    </bpmn:task>

    <!-- Phase 1 Training -->
    <bpmn:intermediateCatchEvent id="Event_TrainingStart_1" name="Training startet">
      <bpmn:incoming>SequenceFlow_PlanToParticipants</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Phase1TrainLoop</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Training Loop 1 -->
    <bpmn:task id="Task_Trainieren_Phase1" name="Individuelles Trainingsprogramm (6 Monate)">
      <bpmn:incoming>SequenceFlow_Phase1TrainLoop</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SixMonthCheckTrigger</bpmn:outgoing>
    </bpmn:task>

    <!-- Six Month Check Gateway -->
    <bpmn:exclusiveGateway id="Gateway_SixMonthCheck" name="6 Monate Training absolviert?">
      <bpmn:incoming>SequenceFlow_Phase1TrainLoop</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MidtermCheckTrigger</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Mid-term Check -->
    <bpmn:task id="Task_ZwischenCheck" name="Zwischen-Check durchführen">
      <bpmn:incoming>SequenceFlow_MidtermCheckTrigger</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GroupSplitDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Group Split Decision -->
    <bpmn:exclusiveGateway id="Gateway_GroupSplit" name="Gruppeneinteilung">
      <bpmn:incoming>SequenceFlow_GroupSplitDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NoWearablesPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_WithWearablesPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Group A - No Wearables -->
    <bpmn:task id="Task_Trainieren_Phase1a" name="Eigenständiges Training ohne Wearables">
      <bpmn:incoming>SequenceFlow_NoWearablesPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GroupAContinue</bpmn:outgoing>
    </bpmn:task>

    <!-- Group B - With Wearables -->
    <bpmn:exclusiveGateway id="Gateway_WithWearables" name="Mit App &amp; Wearables">
      <bpmn:incoming>SequenceFlow_GroupSplitDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WithWearablesPath2</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Group B Training -->
    <bpmn:task id="Task_Trainieren_Phase2a" name="Training mit App &amp; Wearable Unterstützung">
      <bpmn:incoming>SequenceFlow_WithWearablesPath2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GroupBContinue</bpmn:outgoing>
    </bpmn:task>

    <!-- Training Loop 1 -->
    <bpmn:parallelGateway id="Gateway_TrainingLoop1" name="Training Phase 2">
      <bpmn:incoming>SequenceFlow_GroupAContinue</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_GroupBContinue</bpmn:incoming>
    </bpmn:parallelGateway>

    <!-- Twelve Month Check -->
    <bpmn:exclusiveGateway id="Gateway_TwelveMonthEnd" name="12 Monate Training absolviert?">
      <bpmn:incoming>SequenceFlow_TrainingLoop2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FinalCheckTrigger</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Final Check -->
    <bpmn:task id="Task_AbschlussCheck" name="Abschließender Gesundheits-Check">
      <bpmn:incoming>SequenceFlow_FinalCheckTrigger</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProgramEnd</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_001" name="Programm abgeschlossen">
      <bpmn:incoming>SequenceFlow_ProgramEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToCheck" sourceRef="StartEvent_001" targetRef="Task_GesundheitsCheckDetails"/>
    <bpmn:sequenceFlow id="SequenceFlow_CheckToCoaches" name="Gesundheitsdaten erhoben" sourceRef="Task_GesundheitsCheckDetails" targetRef="Gateway_AppTraining"/>

    <!-- Parallel Training Activities -->
    <bpmn:task id="Task_AppTraining" name="Einweisung in App">
      <bpmn:incoming>SequenceFlow_TrainingPlan1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AppDone</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_WearableTraining" name="Einweisung in Wearables">
      <bpmn:incoming>SequenceFlow_TrainingPlan1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WearDone</bpmn:outgoing>
    </bpmn:task>

    <!-- Merge Parallel Training -->
    <bpmn:parallelGateway id="Gateway_AppTrainingMerge" name="App &amp; Wearables Einweisung abgeschlossen">
      <bpmn:incoming>SequenceFlow_AppDone</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_WearDone</bpmn:incoming>
    </bpmn:parallelGateway>

    <!-- Training Plan to Participants -->
    <bpmn:sequenceFlow id="SequenceFlow_TrainingPlan1" sourceRef="Gateway_AppTraining" targetRef="Task_TrainingsPlanErstellen"/>
    <bpmn:sequenceFlow id="SequenceFlow_PlanToParticipants" name="Trainingsplan erstellt" sourceRef="Task_TrainingsPlanErstellen" targetRef="Event_TrainingStart_1"/>

    <!-- Phase 1 Training Loop -->
    <bpmn:parallelGateway id="Gateway_TrainingLoop2">
      <bpmn:incoming>SequenceFlow_Phase1TrainLoop</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SixMonthCheckTrigger</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Six Month Check Trigger -->
    <bpmn:sequenceFlow id="SequenceFlow_Phase1TrainLoop" sourceRef="Event_TrainingStart_1" targetRef="Task_Trainieren_Phase1"/>
    <bpmn:sequenceFlow id="SequenceFlow_SixMonthCheckTrigger" name="6 Monate erreicht" sourceRef="Gateway_AppTrainingMerge" targetRef="Gateway_SixMonthCheck"/>

    <!-- Mid-term Check Trigger -->
    <bpmn:intermediateCatchEvent id="Event_MidtermCheck_002" name="Zwischen-Check durchgeführt">
      <bpmn:incoming>SequenceFlow_ZwischenCheckDone</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GroupSplitDecision</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Group Split -->
    <bpmn:sequenceFlow id="SequenceFlow_ZwischenCheckDone" sourceRef="Task_ZwischenCheck" targetRef="Gateway_SixMonthCheck"/>
    <bpmn:exclusiveGateway id="Gateway_GroupSplit2">
      <bpmn:incoming>SequenceFlow_GroupSplitDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NoWearablesPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_WithWearablesPath2</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Group Paths -->
    <bpmn:sequenceFlow id="SequenceFlow_NoWearablesPath" name="Ohne Wearables">
      <bpmn:conditionExpression>${!mitWearables}</bpmn:conditionExpression>
      sourceRef="Gateway_GroupSplit2"/>
      targetRef="Task_Trainieren_Phase1a"/>

    <bpmn:sequenceFlow id="SequenceFlow_WithWearablesPath" name="Mit Wearables">
      <bpmn:conditionExpression>${mitWearables}</bpmn:conditionExpression>
      sourceRef="Gateway_GroupSplit2"/>
      targetRef="Task_Trainieren_Phase2a"/>

    <!-- Continue Training -->
    <bpmn:sequenceFlow id="SequenceFlow_GroupAContinue" name="Training fortsetzen (6 Monate)" sourceRef="Task_Trainieren_Phase1a" targetRef="Gateway_TrainingLoop1"/>
    <bpmn:sequenceFlow id="SequenceFlow_GroupBContinue" name="Training fortsetzen (6 Monate)" sourceRef="Task_Trainieren_Phase2a" targetRef="Gateway_TrainingLoop1"/>

    <!-- Training Loop 2 -->
    <bpmn:parallelGateway id="Gateway_TrainingMerge">
      <bpmn:incoming>SequenceFlow_GroupAContinue</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_GroupBContinue</bpmn:incoming>
    </bpmn:parallelGateway>

    <!-- Twelve Month Check -->
    <bpmn:sequenceFlow id="SequenceFlow_TrainingLoop2" sourceRef="Gateway_TrainingMerge" targetRef="Gateway_TwelveMonthEnd"/>
    <bpmn:exclusiveGateway id="Gateway_12Months">
      <bpmn:incoming>SequenceFlow_TrainingLoop2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FinalCheckTrigger</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Final Check Trigger -->
    <bpmn:intermediateCatchEvent id="Event_MidtermCheck_003" name="Abschluss-Check durchgeführt">
      <bpmn:incoming>SequenceFlow_FinalCheckTrigger</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProgramEnd</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Final Check Trigger -->
    <bpmn:sequenceFlow id="SequenceFlow_FinalCheckTrigger" name="12 Monate erreicht" sourceRef="Gateway_12Months" targetRef="Task_AbschlussCheck"/>

    <!-- Program End -->
    <bpmn:sequenceFlow id="SequenceFlow_ProgramEnd" sourceRef="Task_AbschlussCheck" targetRef="EndEvent_001"/>

  </bpmn:process>
</bpmn:definitions>