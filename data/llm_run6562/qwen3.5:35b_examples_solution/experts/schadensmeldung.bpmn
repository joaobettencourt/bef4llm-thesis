<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Schadenprozess" name="Schadensabwicklung Versicherung" processRef="Process_1"/>
    <bpmn:participant id="Participant_Kunde" name="Kunde"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="true">
    
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Schadensmeldung" name="Schadensmeldung eingereicht">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_Validierung</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_Ablehnung" name="Schaden abgelehnt">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SequenceFlow_KundeInformiert</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_Abschluss" name="Bearbeitung abgeschlossen">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SequenceFlow_EntscheidungMitteilen</bpmn:outgoing>
    </bpmn:endEvent>

    <!-- User Tasks -->
    <bpmn:userTask id="UserTask_GültigkeitPrüfen" name="Gültigkeit der Schadensmeldung prüfen">
      <bpmn:incoming>SequenceFlow_Validierung</bpmn:outgoing>
      <bpmn:outgoing>Gateway_SchadenValid</bpmn:incomings>
    </bpmn:userTask>

    <bpmn:userTask id="UserTask_DokumentePrüfen" name="Eingereichte Unterlagen auf Vollständigkeit prüfen">
      <bpmn:incoming>SequenceFlow_Weiterbearbeitung</bpmn:outgoing>
      <bpmn:outgoing>Gateway_FachabteilungTransfer</bpmn:incomings>
    </bpmn:userTask>

    <bpmn:userTask id="UserTask_SchadensursacheUntersuchen" name="Schadensursache untersuchen">
      <bpmn:incoming>SequenceFlow_FachabteilungTransfer</bpmn:outgoing>
      <bpmn:outgoing>Gateway_RechtlicheEinschaetzung</bpmn:incomings>
    </bpmn:userTask>

    <bpmn:userTask id="UserTask_VersichererEinholen" name="Rechtliche Einschätzung vom Versicherer einholen">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SequenceFlow_RechtlichErforderlich</bpmn:outgoing>
      <bpmn:outgoing>Gateway_PruefungAbgeschlossen</bpmn:incomings>
    </bpmn:userTask>

    <bpmn:userTask id="UserTask_ZusatzinformationenEinholen" name="Zusätzliche Informationen vom Kunden/Dritten einholen">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>Gateway_InformationenErforderlich</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ZusaetzlicheInfoErhalten</bpmn:incomings>
    </bpmn:userTask>

    <bpmn:userTask id="UserTask_SchadensstatistikErfassen" name="Fall in Schadensstatistik erfassen">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SequenceFlow_StatistikStart</bpmn:outgoing>
      <bpmn:outgoing>Gateway_PruefungAbgeschlossenParallel</bpmn:incomings>
    </bpmn:userTask>

    <bpmn:userTask id="UserTask_SchadensstatistikAktualisieren" name="Schadensstatistik aktualisieren">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>Gateway_PruefungAbgeschlossenParallel</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_StatistikAbschluss</bpmn:incomings>
    </bpmn:userTask>

    <bpmn:userTask id="UserTask_EntscheidungMitteilen" name="Aktuellen Bearbeitungsstand dem Kunden mitteilen">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>Gateway_PruefungAbgeschlossen</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_KundeInformiertAbschließend</bpmn:incomings>
    </bpmn:userTask>

    <!-- Gateways -->
    <bpmn:exclusiveGateway id="Gateway_SchadenValid" name="Schaden gültig?">
      <bpmn:incoming>SequenceFlow_ValidierungPrüfung</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_Ablehnung</bpmn:incomings>
      <bpmn:outgoing>SequenceFlow_Weiterbearbeitung</bpmn:incomings>
    </bpmn:exclusiveGateway>

    <bpmn:exclusiveGateway id="Gateway_FachabteilungTransfer" name="Zuständige Fachabteilung">
      <bpmn:incoming>SequenceFlow_DokumentePrüfen</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SchadensursacheUntersuchen</bpmn:incomings>
    </bpmn:exclusiveGateway>

    <bpmn:exclusiveGateway id="Gateway_RechtlicheEinschaetzung" name="Rechtliche Einschätzung erforderlich?">
      <bpmn:incoming>SequenceFlow_SchadensursacheUntersucht</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RechtlichErforderlich</bpmn:incomings>
      <bpmn:outgoing>SequenceFlow_KeineRechtlichePruefung</bpmn:incomings>
    </bpmn:exclusiveGateway>

    <bpmn:parallelGateway id="Gateway_PruefungAbgeschlossen" name="Alle Prüfungen abgeschlossen">
      <bpmn:incoming>SequenceFlow_VersichererEinholen</bpmn:outgoing>
      <bpmn:incoming>SequenceFlow_KeineRechtlichePruefung</bpmn:incomings>
      <bpmn:outgoing>SequenceFlow_EntscheidungMitteilen</bpmn:incomings>
    </bpmn:parallelGateway>

    <bpmn:exclusiveGateway id="Gateway_Zusatzinformationen" name="Zusätzliche Informationen erforderlich?">
      <bpmn:incoming>SequenceFlow_SchadensursacheUntersucht</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_InformationenErforderlich</bpmn:incomings>
      <bpmn:outgoing>SequenceFlow_GatewayZusatzInfoWeiter</bpmn:incomings>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_Validierung" sourceRef="StartEvent_Schadensmeldung" targetRef="UserTask_GültigkeitPrüfen"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ValidierungPrüfung" name="Schaden gültig?" sourceRef="Gateway_SchadenValid" targetRef="UserTask_DokumentePrüfen">
      <bpmn:conditionExpression>${schadensmeldungGültig}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_Ablehnung" name="Schaden nicht gültig" sourceRef="Gateway_SchadenValid" targetRef="EndEvent_Ablehnung">
      <bpmn:conditionExpression>${!schadensmeldungGültig}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_Weiterbearbeitung" name="Schaden gültig - Weiterbearbeitung" sourceRef="Gateway_SchadenValid" targetRef="UserTask_DokumentePrüfen">
      <bpmn:conditionExpression>${schadensmeldungGültig}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_FachabteilungTransfer" sourceRef="UserTask_DokumentePrüfen" targetRef="Gateway_FachabteilungTransfer"/>

    <bpmn:sequenceFlow id="SequenceFlow_SchadensursacheUntersuchen" name="Schadensursache untersuchen" sourceRef="Gateway_FachabteilungTransfer" targetRef="UserTask_SchadensursacheUntersuchen">
      <bpmn:conditionExpression>${schadensmeldungGültig}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_RechtlicheEinschaetzung" sourceRef="UserTask_SchadensursacheUntersuchen" targetRef="Gateway_RechtlicheEinschaetzung"/>

    <bpmn:sequenceFlow id="SequenceFlow_RechtlichErforderlich" name="Ja - Rechtliche Einschätzung erforderlich" sourceRef="Gateway_RechtlicheEinschaetzung" targetRef="UserTask_VersichererEinholen">
      <bpmn:conditionExpression>${rechtlicheEinschaetzungErforderlich}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_KeineRechtlichePruefung" name="Nein - Keine rechtliche Einschätzung erforderlich" sourceRef="Gateway_RechtlicheEinschaetzung" targetRef="Gateway_PruefungAbgeschlossen">
      <bpmn:conditionExpression>${!rechtlicheEinschaetzungErforderlich}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_InformationenErforderlich" sourceRef="Gateway_Zusatzinformationen" targetRef="UserTask_ZusatzinformationenEinholen">
      <bpmn:conditionExpression>${zusätzlicheInformationenErforderlich}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_GatewayZusatzInfoWeiter" sourceRef="Gateway_Zusatzinformationen" targetRef="Gateway_PruefungAbgeschlossen">
      <bpmn:conditionExpression>${!zusätzlicheInformationenErforderlich}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ZusaetzlicheInfoErhalten" sourceRef="UserTask_ZusatzinformationenEinholen" targetRef="Gateway_PruefungAbgeschlossen"/>

    <!-- Statistics Process -->
    <bpmn:startEvent id="StartEvent_Statistik" name="Bearbeitung beginnt">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_SchadensstatistikErfassen</bpmn:incomings>
    </bpmn:startEvent>

    <bpmn:sequenceFlow id="SequenceFlow_StatistikStart" sourceRef="StartEvent_Statistik" targetRef="UserTask_SchadensstatistikErfassen"/>

    <bpmn:parallelGateway id="Gateway_PruefungAbgeschlossenParallel" name="Prüfungen abgeschlossen">
      <bpmn:incoming>SequenceFlow_VersichererEinholen</bpmn:outgoing>
      <bpmn:incoming>SequenceFlow_ZusaetzlicheInfoErhalten</bpmn:incomings>
      <bpmn:outgoing>SequenceFlow_StatistikAktualisieren</bpmn:incomings>
    </bpmn:parallelGateway>

    <bpmn:sequenceFlow id="SequenceFlow_SchadensstatistikErfassen" sourceRef="UserTask_SchadensstatistikErfassen" targetRef="Gateway_PruefungAbgeschlossenParallel"/>

    <bpmn:sequenceFlow id="SequenceFlow_StatistikAktualisieren" name="Schadensstatistik aktualisieren" sourceRef="Gateway_PruefungAbgeschlossenParallel" targetRef="UserTask_SchadensstatistikAktualisieren">
      <bpmn:conditionExpression>${!rechtlicheEinschaetzungErforderlich}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_StatistikAbschluss" sourceRef="UserTask_SchadensstatistikAktualisieren" targetRef="EndEvent_Abschluss"/>

  </bpmn:process>
</bpmn:definitions>