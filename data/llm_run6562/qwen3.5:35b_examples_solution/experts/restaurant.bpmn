<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Gast" name="Gast" processRef="Process_Gast"/>
    <bpmn:participant id="Participant_Angestellter" name="Angestellter" processRef="Process_Angestellter"/>
    <bpmn:participant id="Participant_Koch" name="Koch" processRef="Process_Koch"/>

    <!-- Message Flows between participants -->
    <bpmn:messageFlow id="MessageFlow_1" sourceRef="Task_Gast_OrderPlaced" targetRef="StartEvent_Angestellter"/>
    <bpmn:messageFlow id="MessageFlow_2" sourceRef="Task_Angestellter_PagerSet" targetRef="IntermediateCatchEvent_Gast_PagerSound"/>
    <bpmn:messageFlow id="MessageFlow_3" sourceRef="StartEvent_Koch_OrderReceived" targetRef="Task_Angestellter_InfoCook"/>
    <bpmn:messageFlow id="MessageFlow_4" sourceRef="Task_Koch_FoodReady" targetRef="IntermediateCatchEvent_Angestellter_FoodReady"/>
  </bpmn:collaboration>

  <!-- Guest Process -->
  <bpmn:process id="Process_Gast">
    <bpmn:startEvent id="StartEvent_Hunger" name="Hunger festgestellt">
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_Gast_EnterRestaurant" name="Restaurant betreten">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_Gast_SelectDish" name="Gericht auswählen">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
    </bpmn:task>

    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_Gast_Wait" name="an der Reihe">
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:task id="Task_Gast_OrderPlaced" name="Bestellung aufgeben">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
    </bpmn:task>

    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_Gast_PagerSound" name="Pieper meldet sich">
      <bpmn:incoming>MessageFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:task id="Task_Gast_PickupFood" name="Essen abholen">
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_Gast" name="Hunger gestillt">
      <bpmn:incoming>SequenceFlow_8</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_Hunger" targetRef="Task_Gast_EnterRestaurant"/>
    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="Task_Gast_EnterRestaurant" targetRef="Task_Gast_SelectDish"/>
    <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="Task_Gast_SelectDish" targetRef="IntermediateCatchEvent_Gast_Wait"/>
    <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="IntermediateCatchEvent_Gast_Wait" targetRef="Task_Gast_OrderPlaced"/>
    <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="Task_Gast_OrderPlaced" targetRef="IntermediateCatchEvent_Gast_PagerSound"/>
    <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="IntermediateCatchEvent_Gast_PagerSound" targetRef="Task_Gast_PickupFood"/>
  </bpmn:process>

  <!-- Staff Process -->
  <bpmn:process id="Process_Angestellter">
    <bpmn:startEvent id="StartEvent_Angestellter" name="Bestellung erhalten">
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_Angestellter_EnterOrder" name="Bestellung eingeben">
      <bpmn:incoming>SequenceFlow_10</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_11</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_Angestellter_CollectPayment" name="Geld kassieren">
      <bpmn:incoming>SequenceFlow_11</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_12</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_Angestellter_PagerSet" name="Pieper einstellen">
      <bpmn:incoming>SequenceFlow_12</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_13</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_Angestellter_PagerHandover" name="Pieper übergeben">
      <bpmn:incoming>SequenceFlow_13</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_14</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_Angestellter_InfoCook" name="Koch informieren">
      <bpmn:incoming>SequenceFlow_14</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_15</bpmn:outgoing>
    </bpmn:task>

    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_Angestellter_FoodReady" name="Essen fertig">
      <bpmn:incoming>MessageFlow_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_16</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:task id="Task_Angestellter_PagerTrigger" name="Pieper auslösen">
      <bpmn:incoming>SequenceFlow_16</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_17</bpmn:outgoing>
    </bpmn:task>

    <bpmn:eventBasedGateway id="EventBasedGateway_Angestellter">
      <bpmn:incoming>SequenceFlow_17</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_18</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_20</bpmn:outgoing>
    </bpmn:eventBasedGateway>

    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_Angestellter_CustomerAppears" name="Kunde erscheint">
      <bpmn:incoming>SequenceFlow_18</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_23</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:task id="Task_Angestellter_HandoverFood" name="Essen übergeben">
      <bpmn:incoming>SequenceFlow_23</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_24</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_Angestellter" name="Bestellung bearbeitet">
      <bpmn:incoming>SequenceFlow_24</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_Angestellter_Timeout" name="5 Minuten">
      <bpmn:incoming>SequenceFlow_20</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_19</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:task id="Task_Angestellter_CallCustomer" name="Kunden ausrufen">
      <bpmn:incoming>SequenceFlow_19</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_20</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="StartEvent_Angestellter" targetRef="Task_Angestellter_EnterOrder"/>
    <bpmn:sequenceFlow id="SequenceFlow_11" sourceRef="Task_Angestellter_EnterOrder" targetRef="Task_Angestellter_CollectPayment"/>
    <bpmn:sequenceFlow id="SequenceFlow_12" sourceRef="Task_Angestellter_CollectPayment" targetRef="Task_Angestellter_PagerSet"/>
    <bpmn:sequenceFlow id="SequenceFlow_13" sourceRef="Task_Angestellter_PagerSet" targetRef="Task_Angestellter_PagerHandover"/>
    <bpmn:sequenceFlow id="SequenceFlow_14" sourceRef="Task_Angestellter_PagerHandover" targetRef="Task_Angestellter_InfoCook"/>
    <bpmn:sequenceFlow id="SequenceFlow_15" sourceRef="Task_Angestellter_InfoCook" targetRef="IntermediateCatchEvent_Angestellter_FoodReady"/>
    <bpmn:sequenceFlow id="SequenceFlow_16" sourceRef="IntermediateCatchEvent_Angestellter_FoodReady" targetRef="Task_Angestellter_PagerTrigger"/>
    <bpmn:sequenceFlow id="SequenceFlow_17" sourceRef="Task_Angestellter_PagerTrigger" targetRef="EventBasedGateway_Angestellter"/>
    <bpmn:sequenceFlow id="SequenceFlow_18" sourceRef="EventBasedGateway_Angestellter" targetRef="IntermediateCatchEvent_Angestellter_CustomerAppears"/>
    <bpmn:sequenceFlow id="SequenceFlow_23" sourceRef="IntermediateCatchEvent_Angestellter_CustomerAppears" targetRef="Task_Angestellter_HandoverFood"/>
    <bpmn:sequenceFlow id="SequenceFlow_24" sourceRef="Task_Angestellter_HandoverFood" targetRef="EndEvent_Angestellter"/>
    <bpmn:sequenceFlow id="SequenceFlow_19" sourceRef="IntermediateCatchEvent_Angestellter_Timeout" targetRef="Task_Angestellter_CallCustomer"/>
    <bpmn:sequenceFlow id="SequenceFlow_20" name="5 Minuten vergangen" sourceRef="Task_Angestellter_CallCustomer" targetRef="EventBasedGateway_Angestellter"/>
  </bpmn:process>

  <!-- Kitchen Process -->
  <bpmn:process id="Process_Koch">
    <bpmn:startEvent id="StartEvent_Koch_OrderReceived" name="Mahlzeit zuzubereiten">
      <bpmn:outgoing>SequenceFlow_30</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_Koch_PrepareFood" name="Mahlzeit zubereiten">
      <bpmn:incoming>SequenceFlow_30</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_31</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_Koch_PlaceInPass" name="Essen in Durchreiche stellen">
      <bpmn:incoming>SequenceFlow_31</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_32</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_Koch_InfoStaff" name="Angestellten informieren">
      <bpmn:incoming>SequenceFlow_32</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_33</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_Koch" name="Mahlzeit zubereitet">
      <bpmn:incoming>SequenceFlow_33</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow_30" sourceRef="StartEvent_Koch_OrderReceived" targetRef="Task_Koch_PrepareFood"/>
    <bpmn:sequenceFlow id="SequenceFlow_31" sourceRef="Task_Koch_PrepareFood" targetRef="Task_Koch_PlaceInPass"/>
    <bpmn:sequenceFlow id="SequenceFlow_32" sourceRef="Task_Koch_PlaceInPass" targetRef="Task_Koch_InfoStaff"/>
    <bpmn:sequenceFlow id="SequenceFlow_33" sourceRef="Task_Koch_InfoStaff" targetRef="EndEvent_Koch"/>
  </bpmn:process>

</bpmn:definitions>