<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions id="Definitions_1" targetNamespace="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Warenversand&#10;Hardware-Händler" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Logistikleiter" name="Leiter Logistik">
        <bpmn:flowNodeRef>Task_Versicherung</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sekretariat" name="Sekretariat">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Pg_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_VersandartKlaeren</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Sonderversand</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>I_G_Inclusive1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_AngeboteEinholen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Admin_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>I_G_Inclusive2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_PaketscheinAusfuellen</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Lagerarbeiter" name="Lagerarbeiter">
        <bpmn:flowNodeRef>G_Final_Convergence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Verpacken</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Bereitstellen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Artikel&#10;zu versenden">
      <bpmn:outgoing>SF_Start_PG</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Parallel Gateway (Split) -->
    <bpmn:parallelGateway id="Pg_Start">
      <bpmn:incoming>SF_Start_PG</bpmn:incoming>
      <bpmn:outgoing>SF_Admin_Work</bpmn:outgoing>
      <bpmn:outgoing>SF_Warehouse_Pack</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Admin Path -->
    <bpmn:task id="T_VersandartKlaeren" name="Versandart&#10;klären">
      <bpmn:incoming>SF_Admin_Work</bpmn:incoming>
      <bpmn:outgoing>SF_Decide_Special</bpmn:outgoing>
    </bpmn:task>

    <!-- Decision: Special Shipment? -->
    <bpmn:exclusiveGateway id="G_Sonderversand" name="Sonderversand?">
      <bpmn:incoming>SF_Decide_Special</bpmn:incoming>
      <bpmn:outgoing>SF_Normal_Path</bpmn:outgoing>
      <bpmn:outgoing>SF_Special_Path</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Special Path -->
    <bpmn:task id="T_AngeboteEinholen" name="Angebote von&#10;3 Spediteuren&#10;einholen">
      <bpmn:incoming>SF_Special_Path</bpmn:incoming>
      <bpmn:outgoing>SF_Select_Carrier</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="T_Beauftragen" name="Spediteur&#10;beauftragen">
      <bpmn:incoming>SF_Select_Carrier</bpmn:incoming>
      <bpmn:outgoing>SF_Special_Merge</bpmn:outgoing>
    </bpmn:task>

    <!-- Normal Path -->
    <bpmn:inclusiveGateway id="I_G_Inclusive1" name="Versicherung&#10;erforderlich?">
      <bpmn:incoming>SF_Normal_Path</bpmn:incoming>
      <bpmn:outgoing>SF_Insurance_Needed</bpmn:outgoing>
      <bpmn:outgoing>SF_Always_Form</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Insurance Task (Logistics Manager) -->
    <bpmn:task id="Task_Versicherung" name="Versicherung&#10;abschließen">
      <bpmn:incoming>SF_Insurance_Needed</bpmn:incoming>
      <bpmn:outgoing>SF_Admin_Merge2</bpmn:outgoing>
    </bpmn:task>

    <!-- Form Fill Task (Secretary) -->
    <bpmn:task id="T_PaketscheinAusfuellen" name="Paketschein&#10;ausfüllen">
      <bpmn:incoming>SF_Always_Form</bpmn:incoming>
      <bpmn:outgoing>SF_Admin_Merge2</bpmn:outgoing>
    </bpmn:task>

    <!-- Merge Admin Paths (Normal Path Result) -->
    <bpmn:inclusiveGateway id="I_G_Inclusive2">
      <bpmn:incoming>SF_Insurance_Needed</bpmn:incoming>
      <bpmn:incoming>SF_Always_Form</bpmn:incoming>
      <bpmn:outgoing>SF_Admin_Merge1</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Merge Admin Paths (Special vs Normal) -->
    <bpmn:exclusiveGateway id="G_Admin_Merge">
      <bpmn:incoming>SF_Special_Merge</bpmn:incoming>
      <bpmn:incoming>SF_Admin_Merge1</bpmn:incoming>
      <bpmn:outgoing>SF_Final_Convergence_In</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Warehouse Path -->
    <bpmn:task id="T_Verpacken" name="Ware&#10;verpacken">
      <bpmn:incoming>SF_Warehouse_Pack</bpmn:incoming>
      <bpmn:outgoing>SF_Ready_Convergence_In</bpmn:outgoing>
    </bpmn:task>

    <!-- Final Convergence -->
    <bpmn:exclusiveGateway id="G_Final_Convergence">
      <bpmn:incoming>SF_Admin_Merge1</bpmn:incoming>
       Wait, logic correction for IDs. 
       G_Admin_Merge merges Special and Normal (via I_G_Inclusive2).
       So SF_Special_Merge comes from T_Beauftragen.
       SF_Normal_Result comes from I_G_Inclusive2.
       
       Let's align with the Reference Example Logic which is proven valid:
       1. Start -> Pg_Start.
       2. Pg_Start -> Task_VersandartKlaeren & Task_WareVerpacken.
       3. VersandartKlaeren -> G_Sonderversand (Excl).
          - Yes -> T_AngeboteEinholen -> T_Beauftragen -> SF_Admin_Merge_A -> G_Admin_Convergence_1 (Excl).
          - No -> I_G_Inclusive1 (Incl) [Versicherung?] 
             - Insurance Needed -> Task_Versicherung.
             - Always Form -> T_PaketscheinAusfuellen.
             - Both merge at I_G_Inclusive2 -> SF_Admin_Merge_B -> G_Admin_Convergence_1 (Excl).
       4. Warehouse: Task_WareVerpacken -> SF_Warehouse_Result -> G_Final_Convergence (Excl).
       
    </bpmn:exclusiveGateway>

    <!-- Final Convergence Gateway -->
    <bpmn:exclusiveGateway id="G_Admin_Convergence_1">
      <bpmn:incoming>SF_Special_Merge</bpmn:outgoing>
       Wait, sourceRef must be defined. 
       SF_Special_Merge comes from T_Beauftragen (target).
       
    </bpmn:exclusiveGateway>

  </bpmn:process>
</bpmn:definitions>