<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                   xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                   xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1"
                   targetNamespace="http://bpmn.io/schema/bpmn">
    <bpmn:collaboration id="Collaboration_0geryc1">
        <bpmn:participant id="Participant_0ygkg4f" name="Measurement Service Provider Network (MSPN)"
                         processRef="Process_1"/>
        <bpmn:participant id="Participant_0ygkg5a" name="Grid Operator (GO)" processRef="Process_1"/>
        <bpmn:participant id="Participant_0ygkg6b" name="Measurement Service Provider Organisation (MSPO)"
                         processRef="Process_1"/>
        <bpmn:participant id="Participant_0ygkg7c" name="Metering Point Operator (MPO)" processRef="Process_1"/>
        <bpmn:participant id="Participant_0ygkg8d" name="Supplier (SP)" processRef="Process_1"/>
    </bpmn:collaboration>
    <bpmn:process id="Process_1" isExecutable="false">
        <bpmn:startEvent id="StartEvent_1" name="Register measurement at GO">
            <bpmn:outgoing>SequenceFlow_14a0oky</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:sequenceFlow id="SequenceFlow_14a0oky" sourceRef="StartEvent_1"
                           targetRef="Task_12j0pib"/>
        <bpmn:task id="Task_12j0pib" name="Examine application of MSPN">
            <bpmn:incoming>SequenceFlow_14a0oky</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_1j94oja</bpmn:outgoing>
        </bpmn:task>
        <bpmn:exclusiveGateway id="ExclusiveGateway_1mpgzhg" name="Reject or confirm application">
            <bpmn:incoming>SequenceFlow_1j94oja</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_0iu9po7</bpmn:outgoing>
            <bpmn:outgoing>SequenceFlow_1xv6wk4</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:sequenceFlow id="SequenceFlow_1j94oja" sourceRef="Task_12j0pib"
                           targetRef="ExclusiveGateway_1mpgzhg"/>
        <bpmn:sequenceFlow id="SequenceFlow_0iu9po7" name="Reject application" sourceRef="ExclusiveGateway_1mpgzhg"
                           targetRef="EndEvent_1fx9yp3"/>
        <bpmn:endEvent id="EndEvent_1fx9yp3" name="Application rejected">
            <bpmn:incoming>SequenceFlow_0iu9po7</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="SequenceFlow_1xv6wk4" sourceRef="ExclusiveGateway_1mpgzhg"
                           targetRef="Task_05ftug5"/>
        <bpmn:task id="Task_05ftug5" name="Assign MSPN">
            <bpmn:incoming>SequenceFlow_1xv6wk4</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_0kz5g1t</bpmn:outgoing>
        </bpmn:task>
        <bpmn:sequenceFlow id="SequenceFlow_0kz5g1t" sourceRef="Task_05ftug5"
                           targetRef="Message_0mp5byl"/>
        <bpmn:message id="Message_0mp5byl" name="Inform MSPO about assignment">
            <bpmn:outgoing>SequenceFlow_0buzwss</bpmn:outgoing>
        </bpmn:message>
        <bpmn:sequenceFlow id="SequenceFlow_0buzwss" sourceRef="Message_0mp5byl"
                           targetRef="Task_0sl26uo"/>
        <bpmn:task id="Task_0sl26uo" name="Inform MPO about assignment">
            <bpmn:incoming>SequenceFlow_0buzwss</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_06kfaev</bpmn:outgoing>
        </bpmn:task>
        <bpmn:sequenceFlow id="SequenceFlow_06kfaev" sourceRef="Task_0sl26uo"
                           targetRef="Message_1v64x8b"/>
        <bpmn:message id="Message_1v64x8b" name="Inform SP about assignment">
            <bpmn:outgoing>SequenceFlow_0v64x8b</bpmn:outgoing>
        </bpmn:message>
        <bpmn:sequenceFlow id="SequenceFlow_0v64x8b" sourceRef="Message_1v64x8b"
                           targetRef="EndEvent_1fx9yp3"/>
    </bpmn:process>
</bpmn:definitions>