    <bpmn:collaboration id="Collaboration_0geryc1">
        <bpmn:participant id="Participant_0ygkg4f" name="MPOO" processRef="Process_1"/>
        <bpmn:participant id="Participant_1jsoxba" name="GO" processRef="Process_1"/>
        <bpmn:participant id="Participant_0vaxgaa" name="MPON" processRef="Process_1"/>
        <bpmn:participant id="Participant_0e6hvnj" name="MSPO" processRef="Process_1"/>
    </bpmn:collaboration>
    <bpmn:process id="Process_1" isExecutable="false">
        <bpmn:startEvent id="StartEvent_1" name="MPOO sends bill for temporary continuation of metering point operations to GO">
            <bpmn:outgoing>SequenceFlow_14a0oky</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:exclusiveGateway id="ExclusiveGateway_1mpgzhg" name="Examine bill">
            <bpmn:incoming>SequenceFlow_14a0oky</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_0iu9po7</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:sequenceFlow id="SequenceFlow_14a0oky" sourceRef="StartEvent_1"
                           targetRef="ExclusiveGateway_1mpgzhg"/>
        <bpmn:endEvent id="EndEvent_1fx9yp3" name="GO confirms invoice with payment advice to MPOO">
            <bpmn:incoming>SequenceFlow_0iu9po7</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="SequenceFlow_0iu9po7" sourceRef="ExclusiveGateway_1mpgzhg"
                           targetRef="EndEvent_1fx9yp3"/>
        
        <bpmn:startEvent id="StartEvent_2" name="MSPO sends bill for temporary continuation of measurement to GO">
            <bpmn:outgoing>SequenceFlow_023hzxi</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:exclusiveGateway id="ExclusiveGateway_1dgb4sg" name="Examine bill">
            <bpmn:incoming>SequenceFlow_023hzxi</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_0kz5g1t</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:endEvent id="EndEvent_2" name="GO confirms invoice with payment advice to MSPO">
            <bpmn:incoming>SequenceFlow_0kz5g1t</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="SequenceFlow_023hzxi" sourceRef="StartEvent_2"
                           targetRef="ExclusiveGateway_1dgb4sg"/>
        <bpmn:sequenceFlow id="SequenceFlow_0kz5g1t" sourceRef="ExclusiveGateway_1dgb4sg"
                           targetRef="EndEvent_2"/>
        
        <bpmn:startEvent id="StartEvent_3" name="MSPO sends bill for additional readings to GO">
            <bpmn:outgoing>SequenceFlow_035vf60</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:endEvent id="EndEvent_3" name="GO confirms invoice with payment advice to MSPO">
            <bpmn:incoming>SequenceFlow_035vf60</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="SequenceFlow_035vf60" sourceRef="StartEvent_3"
                           targetRef="EndEvent_3"/>
        
        <bpmn:startEvent id="StartEvent_4" name="MPOO sends bill for equipment acquisition to MPON or GO">
            <bpmn:outgoing>SequenceFlow_0v64x8b</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:endEvent id="EndEvent_4" name="MPON or GO confirms invoice with payment advice to MPOO">
            <bpmn:incoming>SequenceFlow_0v64x8b</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="SequenceFlow_0v64x8b" sourceRef="StartEvent_4"
                           targetRef="EndEvent_4"/>
        
        <bpmn:startEvent id="StartEvent_5" name="MPOO or MSPO sends bill for equipment acquisition to GO or MPON">
            <bpmn:outgoing>SequenceFlow_06kfaev</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:endEvent id="EndEvent_5" name="GO or MPON rejects invoice of MPOO or MSPO">
            <bpmn:incoming>SequenceFlow_06kfaev</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="SequenceFlow_06kfaev" sourceRef="StartEvent_5"
