        <bpmn:participant id="Participant_0ygkg5a" name="Support Officer"
                         processRef="Process_1"/>
        <bpmn:participant id="Participant_0ygkg6b" name="Independent Committee Members"
                         processRef="Process_1"/>
    </bpmn:collaboration>
    <bpmn:process id="Process_1" isExecutable="false">
        <bpmn:laneSet>
