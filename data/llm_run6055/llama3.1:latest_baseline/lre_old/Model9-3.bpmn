        </bpmn:laneSet>
        <bpmn:startEvent id="StartEvent_1" name="November of each year">
            <bpmn:outgoing>SequenceFlow_0iu9po7</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:task id="Task_12j0pib" name="Draft schedule of meetings for the next calendar year and add draft dates to all calendars">
            <bpmn:incoming>SequenceFlow_0iu9po7</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_1j94oja</bpmn:outgoing>
