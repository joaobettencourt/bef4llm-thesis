        <bpmn:task id="Task_0jsoxba" name="Check dates and suggest modifications">
            <bpmn:incoming>SequenceFlow_0kz5g1t</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_0mp5byl</bpmn:outgoing>
        </bpmn:task>
        <bpmn:sequenceFlow id="SequenceFlow_0kz5g1t" sourceRef="ExclusiveGateway_0p2e5vq"
                           targetRef="Task_0jsoxba"/>
        <bpmn:sequenceFlow id="SequenceFlow_0mp5byl" sourceRef="Task_0jsoxba"
                           targetRef="ExclusiveGateway_0p2e5vq"/>
        <bpmn:endEvent id="EndEvent_1fx9yp3" name="Final schedule of meeting dates sent to all independent Committee Members">
            <bpmn:incoming>SequenceFlow_0v64x8b</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="SequenceFlow_0v64x8b" sourceRef="ExclusiveGateway_0p2e5vq"
                           targetRef="EndEvent_1fx9yp3"/>
        <bpmn:startEvent id="StartEvent_2" name="Check diaries and advise the Coordination Unit of any conflicts">
            <bpmn:outgoing>SequenceFlow_1ujhfx4</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:task id="Task_05ftug5" name="Check diaries and advise the Coordination Unit of any conflicts">
            <bpmn:incoming>SequenceFlow_1ujhfx4</bpmn:incoming>
