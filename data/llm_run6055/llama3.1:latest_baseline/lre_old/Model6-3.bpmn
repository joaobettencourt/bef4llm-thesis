<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                   xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                   xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1"
                   targetNamespace="http://bpmn.io/schema/bpmn">
    <bpmn:collaboration id="Collaboration_0geryc1">
        <bpmn:participant id="Participant_0ygkg4f" name="Sales Department" processRef="Process_1"/>
        <bpmn:participant id="Participant_0ygkg5a" name="Production Planning System (PPS)" processRef="Process_1"/>
        <bpmn:participant id="Participant_0ygkg6b" name="Enterprise Resource Planning system (ERP)" processRef="Process_1"/>
    </bpmn:collaboration>
    <bpmn:process id="Process_1" isExecutable="false">
        <bpmn:startEvent id="StartEvent_1" name="New Order from Sales Department">
            <bpmn:outgoing>SequenceFlow_14a0oky</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:sequenceFlow id="SequenceFlow_14a0oky" sourceRef="StartEvent_1"
                           targetRef="Task_12j0pib"/>
        <bpmn:task id="Task_12j0pib" name="Determine necessary parts and quantities as well as delivery date">
            <bpmn:incoming>SequenceFlow_14a0oky</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_1j94oja</bpmn:outgoing>
        </bpmn:task>
        <bpmn:sequenceFlow id="SequenceFlow_1j94oja" sourceRef="Task_12j0pib"
                           targetRef="ServiceTask_0jsoxba"/>
        <bpmn:serviceTask id="ServiceTask_0jsoxba" name="Enter data into Production Planning System (PPS)">
            <bpmn:incoming>SequenceFlow_1j94oja</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_0mp5byl</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:sequenceFlow id="SequenceFlow_0mp5byl" sourceRef="ServiceTask_0jsoxba"
                           targetRef="ExclusiveGateway_1dgb4sg"/>
        <bpmn:exclusiveGateway id="ExclusiveGateway_1dgb4sg">
            <bpmn:incoming>SequenceFlow_0mp5byl</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_0kz5g1t</bpmn:outgoing>
            <bpmn:outgoing>SequenceFlow_1xv6wk4</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:sequenceFlow id="SequenceFlow_0kz5g1t" sourceRef="ExclusiveGateway_1dgb4sg"
                           targetRef="ServiceTask_05ftug5"/>
        <bpmn:serviceTask id="ServiceTask_05ftug5" name="Check if parts are missing and must be procured">
            <bpmn:incoming>SequenceFlow_0kz5g1t</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_035vf60</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:sequenceFlow id="SequenceFlow_035vf60" sourceRef="ServiceTask_05ftug5"
                           targetRef="ExclusiveGateway_0z5sib0"/>
        <bpmn:exclusiveGateway id="ExclusiveGateway_0z5sib0">
            <bpmn:incoming>SequenceFlow_035vf60</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_06kfaev</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:sequenceFlow id="SequenceFlow_1xv6wk4" sourceRef="ExclusiveGateway_1dgb4sg"
                           targetRef="ServiceTask_0sl26uo"/>
        <bpmn:serviceTask id="ServiceTask_0sl26uo" name="Transfer data manually to Enterprise Resource Planning system (ERP)">
            <bpmn:incoming>SequenceFlow_1xv6wk4</bpmn:incoming>
            <bpmn:outgoing>SequenceFlow_0v64x8b</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:sequenceFlow id="SequenceFlow_06kfaev" sourceRef="ExclusiveGateway_0z5sib0"
                           targetRef="ServiceTask_0sl26uo"/>
        <bpmn:endEvent id="EndEvent_1fx9yp3" name="Order checked for quality">
            <bpmn:incoming>SequenceFlow_0v64x8b</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="SequenceFlow_0v64x8b" sourceRef="ServiceTask_0sl26uo"
                           targetRef="EndEvent_1fx9yp3"/>
    </bpmn:process>
</bpmn:definitions>