                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1"
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_0geryc1">
    <bpmn:participant id="Participant_0ygkg4f" name="Car Service Facility" processRef="Process_1" />
    <bpmn:participant id="Participant_0ygkg5a" name="Customer" processRef="Process_1" />
  </bpmn:collaboration>
  
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_1viot5w" name="Car Service Facility">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_12j0pib</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_1mpgzhg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_0e6hvnj</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1fx9yp3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    
    <!-- Core Flow Elements -->
    <bpmn:startEvent id="StartEvent_1" name="Service Complete">
      <bpmn:outgoing>SequenceFlow_14a0oky</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_12j0pib" name="Check Registration">
      <bpmn:incoming>SequenceFlow_14a0oky</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1j94oja</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Exclusive Gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_1mpgzhg" name="Is Car Registered?">
      <bpmn:incoming>SequenceFlow_1j94oja</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0iu9po7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_14a0oky" sourceRef="StartEvent_1" targetRef="Task_12j0pib" />
    <bpmn:sequenceFlow id="SequenceFlow_1j94oja" name="yes" sourceRef="Task_12j0pib" targetRef="ExclusiveGateway_1mpgzhg" />
    
    <!-- Task -->
    <bpmn:task id="Task_0e6hvnj" name="Notify Customer">
      <bpmn:incoming>SequenceFlow_0iu9po7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_035vf60</bpmn:outgoing>
    </bpmn:task>
    
    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_1fx9yp3" name="Service Complete">
      <bpmn:incoming>SequenceFlow_0v64x8b</bpmn:incoming>
