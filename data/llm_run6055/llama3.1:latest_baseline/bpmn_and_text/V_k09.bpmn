                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1"
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_0geryc1">
    <bpmn:participant id="Participant_0ygkg4f" name="Warehouse Management" processRef="Process_1" />
  </bpmn:collaboration>
  
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_1viot5w" name="Order Management">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_12j0pib</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_1mpgzhg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_0e6hvnj</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_02fgrfq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_1ouv9kf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_0s79ile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1fx9yp3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    
    <!-- Core Flow Elements -->
    <bpmn:startEvent id="StartEvent_1" name="Read Order">
      <bpmn:outgoing>SequenceFlow_14a0oky</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_12j0pib" name="Check Product in Stock">
      <bpmn:incoming>SequenceFlow_14a0oky</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1j94oja</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Exclusive Gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_1mpgzhg" name="Product in Stock?">
      <bpmn:incoming>SequenceFlow_1j94oja</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0iu9po7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_14a0oky" sourceRef="StartEvent_1" targetRef="Task_12j0pib" />
    <bpmn:sequenceFlow id="SequenceFlow_1j94oja" name="yes" sourceRef="Task_12j0pib" targetRef="ExclusiveGateway_1mpgzhg" />
    
    <!-- Exclusive Gateway -->
    <bpmn:task id="Task_0e6hvnj" name="Withdraw Product from Warehouse">
      <bpmn:incoming>SequenceFlow_0iu9po7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_035vf60</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Exclusive Gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_1ouv9kf" name="Product Arrived?">
      <bpmn:incoming>SequenceFlow_0v64x8b</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_06kfaev</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <!-- Parallel Gateway -->
    <bpmn:parallelGateway id="ParallelGateway_02fgrfq">
      <bpmn:incoming>SequenceFlow_0v64x8b</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_023hzxi</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_1ujhfx4</bpmn:outgoing>
    </bpmn:parallelGateway>
    
    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_0iu9po7" sourceRef="ExclusiveGateway_1mpgzhg" targetRef="Task_0e6hvnj" />
    <bpmn:sequenceFlow id="SequenceFlow_035vf60" name="yes" sourceRef="Task_0e6hvnj" targetRef="ExclusiveGateway_1ouv9kf" />
    
    <!-- Exclusive Gateway -->
    <bpmn:task id="Task_0s79ile" name="Pack and Ship Products">
      <bpmn:incoming>SequenceFlow_06kfaev</bpmn:incoming>
