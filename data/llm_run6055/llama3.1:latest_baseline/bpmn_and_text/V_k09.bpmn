    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_1fx9yp3" name="Order Shipped">
      <bpmn:incoming>SequenceFlow_0v64x8b</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  
</bpmn:definitions>