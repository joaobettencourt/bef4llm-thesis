<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1"
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_0geryc1">
    <bpmn:participant id="Participant_0ygkg4f" name="Blizzard Online Character Generator" processRef="Process_1" />
  </bpmn:collaboration>
  
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_1viot5w" name="Blizzard Online Character Generator">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_0p2e5vq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_12j0pib</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_02fgrfq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_1dgb4sg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_0jsoxba</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1fx9yp3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    
    <!-- Core Flow Elements -->
    <bpmn:startEvent id="StartEvent_1" name="Create Account">
      <bpmn:outgoing>SequenceFlow_14a0oky</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="ExclusiveGateway_0p2e5vq" name="Check Battle.net Account">
      <bpmn:incoming>SequenceFlow_14a0oky</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1j94oja</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <!-- Task for checking battle.net account -->
    <bpmn:task id="Task_12j0pib" name="Check Battle.net Account">
      <bpmn:incoming>SequenceFlow_1j94oja</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0kz5g1t</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Parallel Gateway for subscription and payment method selection -->
    <bpmn:parallelGateway id="ParallelGateway_02fgrfq">
      <bpmn:incoming>SequenceFlow_0kz5g1t</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_023hzxi</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_1ujhfx4</bpmn:outgoing>
    </bpmn:parallelGateway>
    
    <!-- Exclusive Gateway for subscription and payment method selection -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_1dgb4sg" name="Select Payment Method">
      <bpmn:incoming>SequenceFlow_023hzxi</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0mp5byl</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <!-- Task for entering credit card information -->
    <bpmn:task id="Task_0jsoxba" name="Enter Credit Card Information">
      <bpmn:incoming>SequenceFlow_0mp5byl</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_035vf60</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_14a0oky" sourceRef="StartEvent_1" targetRef="ExclusiveGateway_0p2e5vq" />
    <bpmn:sequenceFlow id="SequenceFlow_1j94oja" name="yes" sourceRef="ExclusiveGateway_0p2e5vq" targetRef="Task_12j0pib" />
    
    <!-- Sequence Flows for subscription and payment method selection -->
    <bpmn:sequenceFlow id="SequenceFlow_0kz5g1t" sourceRef="Task_12j0pib" targetRef="ParallelGateway_02fgrfq" />
    <bpmn:sequenceFlow id="SequenceFlow_023hzxi" name="Credit Card" sourceRef="ParallelGateway_02fgrfq" targetRef="ExclusiveGateway_1dgb4sg" />
    
    <!-- Sequence Flows for entering credit card information -->
    <bpmn:sequenceFlow id="SequenceFlow_0mp5byl" sourceRef="ExclusiveGateway_1dgb4sg" targetRef="Task_0jsoxba" />
    <bpmn:sequenceFlow id="SequenceFlow_035vf60" name="yes" sourceRef="Task_0jsoxba" targetRef="EndEvent_1fx9yp3" />
    
    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_1fx9yp3" name="Character Created">
      <bpmn:incoming>SequenceFlow_035vf60</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  
</bpmn:definitions>