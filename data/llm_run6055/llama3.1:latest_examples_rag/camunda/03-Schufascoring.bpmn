<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/2.0" xmlns:bpmndi="http://www.omg.org/spec/BPMN/2.0/DI" xmlns:di="http://www.omg.org/spec/DD/2.0" xmlns:dc="http://www.omg.org/spec/DD/2.0" targetNamespace="http://bpmn.io/schema/bpmn" id="Definitions_1">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="true">
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Schufa Scoring anfordern">
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Sequence Flow 1 -->
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="ServiceTask_1" />

    <!-- Service Task 1 -->
    <bpmn:serviceTask id="ServiceTask_1" name="Schufa Scoring anfordern">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Sequence Flow 2 -->
    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="ServiceTask_1" targetRef="ExclusiveGateway_1" />

    <!-- Exclusive Gateway 1 -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_1" name="Scoring-Ergebnis vorliegt?">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flow 3 -->
    <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_1" />

    <!-- End Event 1 -->
    <bpmn:endEvent id="EndEvent_1" name="Scoring-Ergebnis vorliegt">
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flow 4 -->
    <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_1" targetRef="ServiceTask_2" />

    <!-- Service Task 2 -->
    <bpmn:serviceTask id="ServiceTask_2" name="Scoring-Ergebnis bearbeiten">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Sequence Flow 5 -->
    <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="ServiceTask_2" targetRef="EndEvent_2" />

    <!-- End Event 2 -->
    <bpmn:endEvent id="EndEvent_2" name="Scoring-Ergebnis bearbeitet">
      <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>