<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  id="Definitions_1">
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Chainsaw Production">
      <bpmn:outgoing>SequenceFlow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="ParallelGateway_1" gatewayDirection="Diverging"
                          name="Get Customer Requirements">
      <bpmn:incoming>SequenceFlow_0</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="ServiceTask_0" name="Get Customer Requirements"
                      implementation="##WebService">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway_0" gatewayDirection="Diverging"
                           name="Order Parts">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask_1" name="Order Parts"
                      implementation="##WebService">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_1" name="Chainsaw Production Finished">
      <bpmn:incoming>SequenceFlow_7</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:sequenceFlow id="SequenceFlow_0"
                      sourceRef="StartEvent_1"
                      targetRef="ParallelGateway_1"/>
  <bpmn:sequenceFlow id="SequenceFlow_1"
                      sourceRef="ParallelGateway_1"
                      targetRef="ServiceTask_0"/>
  <bpmn:sequenceFlow id="SequenceFlow_2"
                      sourceRef="ParallelGateway_1"
                      targetRef="ExclusiveGateway_0"/>
  <bpmn:sequenceFlow id="SequenceFlow_3"
                      sourceRef="ServiceTask_0"
                      targetRef="EndEvent_1"/>
  <bpmn:sequenceFlow id="SequenceFlow_4"
                      sourceRef="ExclusiveGateway_0"
                      targetRef="ServiceTask_1"/>
  <bpmn:sequenceFlow id="SequenceFlow_5"
                      sourceRef="ExclusiveGateway_0"
                      targetRef="EndEvent_1"/>
  <bpmn:sequenceFlow id="SequenceFlow_6"
                      sourceRef="ServiceTask_1"
                      targetRef="EndEvent_1"/>
</bpmn:definitions>