<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  id="Car Service Process">
  <bpmn:process id="Process_1" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="Start_Event">
      <bpmn:outgoing>Sequence Flow 1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Sequence Flow 1 -->
    <bpmn:sequenceFlow id="Sequence_Flow_1" sourceRef="Start_Event" targetRef="Check_if_Car_is_Registered">
      <bpmn:text>Check if car is registered</bpmn:text>
    </bpmn:sequenceFlow>

    <!-- Service Task 1 -->
    <bpmn:serviceTask id="Check_if_Car_is_Registered" name="Check if car is registered">
      <bpmn:incoming>Sequence_Flow_1</bpmn:incoming>
      <bpmn:outgoing>Sequence_Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Sequence Flow 2 -->
    <bpmn:sequenceFlow id="Sequence_Flow_2" sourceRef="Check_if_Car_is_Registered" targetRef="Notify_Customer">
      <bpmn:text>Notify customer</bpmn:text>
    </bpmn:sequenceFlow>

    <!-- User Task 1 -->
    <bpmn:userTask id="Notify_Customer" name="Notify customer">
      <bpmn:incoming>Sequence_Flow_2</bpmn:incoming>
      <bpmn:outgoing>Sequence_Flow_3</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Sequence Flow 3 -->
    <bpmn:sequenceFlow id="Sequence_Flow_3" sourceRef="Notify_Customer" targetRef="Car_Service_Facility">
      <bpmn:text>Go to car service facility</bpmn:text>
    </bpmn:sequenceFlow>

    <!-- Exclusive Gateway 1 -->
    <bpmn:exclusiveGateway id="Exclusive_Gateway_1" name="Special handling?">
      <bpmn:incoming>Sequence_Flow_3</bpmn:incoming>
      <bpmn:outgoing>Sequence_Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Sequence_Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flow 4 -->
    <bpmn:sequenceFlow id="Sequence_Flow_4" sourceRef="Exclusive_Gateway_1" targetRef="Clarify_Shipment_Method">
      <bpmn:text>Yes, special handling required</bpmn:text>
    </bpmn:sequenceFlow>

    <!-- User Task 2 -->
    <bpmn:userTask id="Clarify_Shipment_Method" name="Clarify shipment method">
      <bpmn:incoming>Sequence_Flow_4</bpmn:incoming>
      <bpmn:outgoing>Sequence_Flow_6</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Sequence Flow 5 -->
    <bpmn:sequenceFlow id="Sequence_Flow_5" sourceRef="Exclusive_Gateway_1" targetRef="Package_Goods">
      <bpmn:text>No, special handling not required</bpmn:text>
    </bpmn:sequenceFlow>

    <!-- User Task 3 -->
    <bpmn:userTask id="Package_Goods" name="Package goods">
      <bpmn:incoming>Sequence_Flow_5</bpmn:incoming>
      <bpmn:outgoing>Sequence_Flow_7</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Sequence Flow 6 -->
    <bpmn:sequenceFlow id="Sequence_Flow_6" sourceRef="Clarify_Shipment_Method" targetRef="Prepare_for_Picking_Up_Goods">
      <bpmn:text>Shipment method clarified</bpmn:text>
    </bpmn:sequenceFlow>

    <!-- User Task 4 -->
    <bpmn:userTask id="Prepare_for_Picking_Up_Goods" name="Prepare for picking up goods">
      <bpmn:incoming>Sequence_Flow_6</bpmn:incoming>
      <bpmn:outgoing>Sequence_Flow_8</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Sequence Flow 7 -->
    <bpmn:sequenceFlow id="Sequence_Flow_7" sourceRef="Package_Goods" targetRef="End_Event">
      <bpmn:text>Packaging completed</bpmn:text>
    </bpmn:sequenceFlow>

    <!-- End Event -->
    <bpmn:endEvent id="End_Event">
      <bpmn:incoming>Sequence_Flow_7</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flow 8 -->
    <bpmn:sequenceFlow id="Sequence_Flow_8" sourceRef="Prepare_for_Picking_Up_Goods" targetRef="End_Event">
      <bpmn:text>Pick-up preparation completed</bpmn:text>
    </bpmn:sequenceFlow>

    <!-- Car Service Facility -->
    <bpmn:userTask id="Car_Service_Facility" name="Car service facility">
      <bpmn:incoming>Sequence_Flow_3</bpmn:incoming>
    </bpmn:userTask>
  </bpmn:process>
</bpmn:definitions>