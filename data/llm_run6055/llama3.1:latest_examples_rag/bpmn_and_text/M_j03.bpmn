<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <bpmn:process id="Process_1" name="Contract">
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Find Web Shops">
      <outgoing ref="SequenceFlow_1"/>
    </bpmn:startEvent>

    <!-- Sequence Flow 1 -->
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>

    <!-- Task 1 -->
    <bpmn:task id="Task_1" name="Query Web Shops">
      <outgoing ref="SequenceFlow_2"/>
    </bpmn:task>

    <!-- Sequence Flow 2 -->
    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="ExclusiveGateway_1"/>

    <!-- Exclusive Gateway 1 -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_1" name="Choose Web Shop">
      <outgoing ref="SequenceFlow_3"/>
      <outgoing ref="SequenceFlow_4"/>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flow 3 -->
    <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_1" targetRef="Task_2"/>

    <!-- Task 2 -->
    <bpmn:task id="Task_2" name="Order Parts">
      <outgoing ref="SequenceFlow_5"/>
    </bpmn:task>

    <!-- Sequence Flow 5 -->
    <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="Task_2" targetRef="ParallelGateway_1"/>

    <!-- Parallel Gateway 1 -->
    <bpmn:parallelGateway id="ParallelGateway_1" name="Parts Arrived">
      <outgoing ref="SequenceFlow_6"/>
      <outgoing ref="SequenceFlow_7"/>
    </bpmn:parallelGateway>

    <!-- Sequence Flow 6 -->
    <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="ParallelGateway_1" targetRef="Task_3"/>

    <!-- Task 3 -->
    <bpmn:task id="Task_3" name="Inspect Parts">
      <outgoing ref="SequenceFlow_8"/>
    </bpmn:task>

    <!-- Sequence Flow 8 -->
    <bpmn:sequenceFlow id="SequenceFlow_8" sourceRef="Task_3" targetRef="ExclusiveGateway_2"/>

    <!-- Exclusive Gateway 2 -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_2" name="Parts Assembled">
      <outgoing ref="SequenceFlow_9"/>
      <outgoing ref="SequenceFlow_10"/>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flow 9 -->
    <bpmn:sequenceFlow id="SequenceFlow_9" sourceRef="ExclusiveGateway_2" targetRef="Task_4"/>

    <!-- Task 4 -->
    <bpmn:task id="Task_4" name="Assemble Parts">
      <outgoing ref="SequenceFlow_11"/>
    </bpmn:task>

    <!-- Sequence Flow 11 -->
    <bpmn:sequenceFlow id="SequenceFlow_11" sourceRef="Task_4" targetRef="EndEvent_1"/>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_1" name="Contract Completed">
      <incoming ref="SequenceFlow_11"/>
    </bpmn:endEvent>

    <!-- Sequence Flow 7 -->
    <bpmn:sequenceFlow id="SequenceFlow_7" sourceRef="ParallelGateway_1" targetRef="Task_5"/>

    <!-- Task 5 -->
    <bpmn:task id="Task_5" name="Prepare for Picking Up">
      <outgoing ref="SequenceFlow_12"/>
    </bpmn:task>

    <!-- Sequence Flow 12 -->
    <bpmn:sequenceFlow id="SequenceFlow_12" sourceRef="Task_5" targetRef="ExclusiveGateway_3"/>

    <!-- Exclusive Gateway 3 -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_3" name="Stock Level">
      <outgoing ref="SequenceFlow_13"/>
      <outgoing ref="SequenceFlow_14"/>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flow 13 -->
    <bpmn:sequenceFlow id="SequenceFlow_13" sourceRef="ExclusiveGateway_3" targetRef="Task_6"/>

    <!-- Task 6 -->
    <bpmn:task id="Task_6" name="Reorder Parts">
      <outgoing ref="SequenceFlow_15"/>
    </bpmn:task>

    <!-- Sequence Flow 15 -->
    <bpmn:sequenceFlow id="SequenceFlow_15" sourceRef="Task_6" targetRef="EndEvent_1"/>

    <!-- Sequence Flow 10 -->
    <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="ExclusiveGateway_2" targetRef="Task_7"/>

    <!-- Task 7 -->
    <bpmn:task id="Task_7" name="Write Mail to Friends">
      <outgoing ref="SequenceFlow_16"/>
    </bpmn:task>

    <!-- Sequence Flow 16 -->
    <bpmn:sequenceFlow id="SequenceFlow_16" sourceRef="Task_7" targetRef="EndEvent_1"/>
  </bpmn:process>
</bpmn:definitions>