<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   targetNamespace="http://bpmn.io/schema/bpmn" id="Definitions_1">
  <bpmn:process id="Service_for_Your_Fridge" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="Start_Event_1">
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Sequence Flow 1 -->
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="Start_Event_1" targetRef="Service_Task_1">
      <bpmn:text>Send symptoms and type of fridge to central service center</bpmn:text>
    </bpmn:sequenceFlow>

    <!-- Service Task 1 -->
    <bpmn:serviceTask id="Service_Task_1" name="Select local service facility">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Sequence Flow 2 -->
    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="Service_Task_1" targetRef="Exclusive_Gateway_1">
      <bpmn:text>Make an appointment</bpmn:text>
    </bpmn:sequenceFlow>

    <!-- Exclusive Gateway 1 -->
    <bpmn:exclusiveGateway id="Exclusive_Gateway_1" name="Special handling?">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flow 3 -->
    <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="Exclusive_Gateway_1" targetRef="Service_Task_2">
      <bpmn:text>Yes, special handling required</bpmn:text>
    </bpmn:sequenceFlow>

    <!-- Service Task 2 -->
    <bpmn:serviceTask id="Service_Task_2" name="Clarify shipment method">
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Sequence Flow 4 -->
    <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="Exclusive_Gateway_1" targetRef="Service_Task_3">
      <bpmn:text>No, special handling not required</bpmn:text>
    </bpmn:sequenceFlow>

    <!-- Service Task 3 -->
    <bpmn:serviceTask id="Service_Task_3" name="Package goods">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Sequence Flow 5 -->
    <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="Service_Task_2" targetRef="Exclusive_Gateway_2">
      <bpmn:text>Get 3 offers from logistic companies</bpmn:text>
    </bpmn:sequenceFlow>

    <!-- Exclusive Gateway 2 -->
    <bpmn:exclusiveGateway id="Exclusive_Gateway_2" name="Select logistic company and place order">
      <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flow 6 -->
    <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="Service_Task_3" targetRef="Exclusive_Gateway_2">
      <bpmn:text>Prepare for picking up goods</bpmn:text>
    </bpmn:sequenceFlow>

    <!-- Sequence Flow 7 -->
    <bpmn:sequenceFlow id="SequenceFlow_7" sourceRef="Exclusive_Gateway_2" targetRef="End_Event">
      <bpmn:text>Confirm receipt of payment and grant &quot;Pickerl&quot;</bpmn:text>
    </bpmn:sequenceFlow>

    <!-- End Event -->
    <bpmn:endEvent id="End_Event_1">
      <bpmn:incoming>SequenceFlow_7</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>