<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
                  targetNamespace="http://bpmn.io/schema/bpmn" id="Definitions_1">
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Custom machine building">
      <bpmn:outgoing>SequenceFlow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="DevelopBasicDesign" name="Develop basic design">
      <bpmn:incoming>SequenceFlow_0</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="SequenceFlow_0" sourceRef="StartEvent_1" targetRef="DevelopBasicDesign"/>
    <bpmn:userTask id="OrderLegoBrickSets" name="Order lego brick sets">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="DevelopBasicDesign" targetRef="OrderLegoBrickSets"/>
    <bpmn:userTask id="SortPartsIntoContainers" name="Sort parts into containers">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="OrderLegoBrickSets" targetRef="SortPartsIntoContainers"/>
    <bpmn:exclusiveGateway id="IsMorePartsNeeded" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="SortPartsIntoContainers" targetRef="IsMorePartsNeeded"/>
    <bpmn:userTask id="ReorderIndividualParts" name="Reorder individual parts">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="IsMorePartsNeeded" targetRef="ReorderIndividualParts"/>
    <bpmn:userTask id="BuildSubcomponent" name="Build subcomponent">
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="IsMorePartsNeeded" targetRef="BuildSubcomponent"/>
    <bpmn:exclusiveGateway id="DoesItPassedTheTest" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow_7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_8</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="TestSubcomponent" name="Test subcomponent">
      <bpmn:incoming>SequenceFlow_8</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="ReorderIndividualParts" targetRef="BuildSubcomponent"/>
    <bpmn:sequenceFlow id="SequenceFlow_7" sourceRef="BuildSubcomponent" targetRef="DoesItPassedTheTest"/>
    <bpmn:userTask id="RedesignSubcomponent" name="Redesign subcomponent">
      <bpmn:incoming>SequenceFlow_9</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="SequenceFlow_8" sourceRef="DoesItPassedTheTest" targetRef="TestSubcomponent"/>
    <bpmn:sequenceFlow id="SequenceFlow_9" sourceRef="DoesItPassedTheTest" targetRef="RedesignSubcomponent"/>
    <bpmn:userTask id="AssembleMachine" name="Assemble machine">
      <bpmn:incoming>SequenceFlow_11</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="TestSubcomponent" targetRef="DoesItPassedTheTest"/>
    <bpmn:parallelGateway id="IsMoreSubcomponentsNeeded" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow_12</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_13</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_14</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="DeliverCustomerTheMachinePackage" name="Deliver customer the machine package">
      <bpmn:incoming>SequenceFlow_13</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="SequenceFlow_11" sourceRef="RedesignSubcomponent" targetRef="AssembleMachine"/>
    <bpmn:sequenceFlow id="SequenceFlow_12" sourceRef="AssembleMachine" targetRef="IsMoreSubcomponentsNeeded"/>
    <bpmn:userTask id="SendCustomerTheBill" name="Send customer the bill">
      <bpmn:incoming>SequenceFlow_14</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="SequenceFlow_13" sourceRef="IsMoreSubcomponentsNeeded" targetRef="DeliverCustomerTheMachinePackage"/>
    <bpmn:sequenceFlow id="SequenceFlow_14" sourceRef="IsMoreSubcomponentsNeeded" targetRef="SendCustomerTheBill"/>
    <bpmn:endEvent id="EndEvent_1" name="End">
      <bpmn:incoming>SequenceFlow_15</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow_15" sourceRef="DeliverCustomerTheMachinePackage" targetRef="EndEvent_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_16" sourceRef="SendCustomerTheBill" targetRef="EndEvent_1"/>
  </bpmn:process>
</bpmn:definitions>