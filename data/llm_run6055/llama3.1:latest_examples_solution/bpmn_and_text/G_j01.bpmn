<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  id="Definitions_1">
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Start Game">
      <bpmn:outgoing>SequenceFlow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="ExclusiveGateway_1" name="Select resources">
      <bpmn:incoming>SequenceFlow_0</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="SequenceFlow_0" sourceRef="StartEvent_1" targetRef="ExclusiveGateway_1"/>
    <bpmn:task id="Task_1" name="Create Farming List">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="ExclusiveGateway_1" targetRef="Task_2"/>
    <bpmn:task id="Task_2" name="Check available resources">
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="ExclusiveGateway_1" targetRef="Task_1"/>
    <bpmn:exclusiveGateway id="ExclusiveGateway_2" name="Adjust the List?">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_1" targetRef="Task_2"/>
    <bpmn:task id="Task_3" name="Collect Materials">
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="Task_1" targetRef="ExclusiveGateway_2"/>
    <bpmn:exclusiveGateway id="ExclusiveGateway_3" name="Create tools">
      <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_9</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="Task_2" targetRef="ExclusiveGateway_3"/>
    <bpmn:task id="Task_4" name="Update Farming List">
      <bpmn:incoming>SequenceFlow_7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="ExclusiveGateway_2" targetRef="Task_3"/>
    <bpmn:exclusiveGateway id="ExclusiveGateway_4" name="Farming Bot finished">
      <bpmn:incoming>SequenceFlow_8</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_12</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="SequenceFlow_7" sourceRef="ExclusiveGateway_2" targetRef="Task_4"/>
    <bpmn:task id="Task_5" name="Check Inventory">
      <bpmn:incoming>SequenceFlow_9</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_8" sourceRef="Task_3" targetRef="ExclusiveGateway_4"/>
    <bpmn:exclusiveGateway id="ExclusiveGateway_5" name="Farming Bot finished">
      <bpmn:incoming>SequenceFlow_11</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_15</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="SequenceFlow_9" sourceRef="ExclusiveGateway_3" targetRef="Task_5"/>
    <bpmn:endEvent id="EndEvent_1" name="Farming Bot finished">
      <bpmn:incoming>SequenceFlow_12</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_15</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_16</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>