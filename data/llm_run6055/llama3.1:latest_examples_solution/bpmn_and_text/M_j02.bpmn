<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_0geryc1">
    <bpmn:participant id="Participant_0ygkg4f" name="Customer" processRef="Process_1"/>
    <bpmn:participant id="Participant_1j9kq6e" name="Manufacturer" processRef="Process_1"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Order received">
      <bpmn:outgoing>SequenceFlow_0iu9po7</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask_1" name="Define requirements">
      <bpmn:incoming>SequenceFlow_0iu9po7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1j94oja</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway_1" name="Base model?">
      <bpmn:incoming>SequenceFlow_1j94oja</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0kz5g1t</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_1dlbln9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask_2" name="Order parts">
      <bpmn:incoming>SequenceFlow_0kz5g1t</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0mp5byl</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask_1" name="Assemble plane">
      <bpmn:incoming>SequenceFlow_0mp5byl</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0buzwss</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UserTask_3" name="Make test flight">
      <bpmn:incoming>SequenceFlow_0buzwss</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0v64x8b</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask_2" name="Create test protocol">
      <bpmn:incoming>SequenceFlow_0v64x8b</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_035vf60</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UserTask_4" name="Notify customer">
      <bpmn:incoming>SequenceFlow_035vf60</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0ajhekx</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_1" name="Order completed">
      <bpmn:incoming>SequenceFlow_0ajhekx</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow_0iu9po7" sourceRef="StartEvent_1" targetRef="UserTask_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_1j94oja" sourceRef="UserTask_1" targetRef="ExclusiveGateway_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_0kz5g1t" name="Yes" sourceRef="ExclusiveGateway_1" targetRef="UserTask_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_1dlbln9" name="No" sourceRef="ExclusiveGateway_1" targetRef="ServiceTask_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_0mp5byl" sourceRef="UserTask_2" targetRef="ServiceTask_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_0buzwss" sourceRef="ServiceTask_1" targetRef="UserTask_3"/>
    <bpmn:sequenceFlow id="SequenceFlow_0v64x8b" sourceRef="UserTask_3" targetRef="ServiceTask_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_035vf60" sourceRef="ServiceTask_2" targetRef="UserTask_4"/>
    <bpmn:sequenceFlow id="SequenceFlow_0ajhekx" sourceRef="UserTask_4" targetRef="EndEvent_1"/>
  </bpmn:process>
