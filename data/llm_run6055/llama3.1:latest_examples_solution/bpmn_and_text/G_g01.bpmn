<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
                  targetNamespace="http://bpmn.io/schema/bpmn" id="LAN_Party"
                  xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/BPMN20.xsd">
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:startEvent id="Send_invitation" name="Send invitation">
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Select_games" name="Select Games">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:intermediateCatchEvent id="Receive_list_of_games" name="Receive list of games">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:exclusiveGateway id="All_games_available" name="All games available?">
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Download_games" name="Download games">
      <bpmn:incoming>SequenceFlow_9</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="Prepare_games" name="Prepare Games">
      <bpmn:incoming>SequenceFlow_11</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_12</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Enough_beer" name="enough beer?">
      <bpmn:incoming>SequenceFlow_13</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_14</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:manualTask id="Choose_amount" name="Choose amount">
      <bpmn:incoming>SequenceFlow_16</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_17</bpmn:outgoing>
    </bpmn:manualTask>

    <bpmn:endEvent id="End_party" name="End party">
      <bpmn:incoming>SequenceFlow_18</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="Send_invitation" targetRef="Select_games"/>
    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="Select_games" targetRef="Receive_list_of_games"/>
    <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="Receive_list_of_games" targetRef="All_games_available"/>
    <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="All_games_available" targetRef="Download_games"/>
    <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="Download_games" targetRef="Prepare_games"/>
    <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="Prepare_games" targetRef="Enough_beer"/>
    <bpmn:sequenceFlow id="SequenceFlow_7" sourceRef="Enough_beer" targetRef="Choose_amount"/>
    <bpmn:sequenceFlow id="SequenceFlow_8" sourceRef="Enough_beer" targetRef="End_party"/>
    <bpmn:sequenceFlow id="SequenceFlow_9" sourceRef="All_games_available" targetRef="Download_games"/>
    <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="Download_games" targetRef="Prepare_games"/>
    <bpmn:sequenceFlow id="SequenceFlow_11" sourceRef="Prepare_games" targetRef="Enough_beer"/>
    <bpmn:sequenceFlow id="SequenceFlow_12" sourceRef="Enough_beer" targetRef="Choose_amount"/>
    <bpmn:sequenceFlow id="SequenceFlow_13" sourceRef="Choose_amount" targetRef="End_party"/>
    <bpmn:sequenceFlow id="SequenceFlow_14" sourceRef="Choose_amount" targetRef="End_party"/>
    <bpmn:sequenceFlow id="SequenceFlow_15" sourceRef="Choose_amount" targetRef="End_party"/>
  </bpmn:process>
</bpmn:definitions>