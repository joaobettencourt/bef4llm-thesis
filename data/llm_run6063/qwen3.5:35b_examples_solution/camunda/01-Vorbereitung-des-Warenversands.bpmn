<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_0geryc1">
    <bpmn:participant id="Participant_0ygkg4f" name="Warenversand&#10;Hardware-Händler" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Logistikleiter" name="Leiter Logistik">
        <bpmn:flowNodeRef>Task_Versicherung</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sekretariat" name="Sekretariat">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VersandartKlaeren</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Sonderversand</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_NormalerVersand</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PaketscheinAusfuellen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_VersicherungErforderlich</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Lagerarbeiter" name="Lagerarbeiter">
        <bpmn:flowNodeRef>Task_WareVerpacken</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_VorbereitungenAbgeschlossen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WareBereitstellen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1fx9yp3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Artikel zu versenden">
      <bpmn:outgoing>SequenceFlow_StartParallelGateway</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Parallel Gateway for concurrent paths -->
    <bpmn:parallelGateway id="ParallelGateway_Vorbereitungen" name="Vorbereitung starten">
      <bpmn:incoming>SequenceFlow_StartParallelGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SekretariatStart</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_LagerarbeiterStart</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Secretary Lane Tasks -->
    <bpmn:task id="Task_VersandartKlaeren" name="Versandart klären">
      <bpmn:incoming>SequenceFlow_SekretariatStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GatewaySonderversand</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for Special Shipment Decision -->
    <bpmn:exclusiveGateway id="Gateway_Sonderversand" name="Sonderversand?">
      <bpmn:incoming>SequenceFlow_GatewaySonderversand</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NormalerVersand</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SonderangebotEinholen</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Special Shipment Path -->
    <bpmn:task id="Task_AngeboteEinholen" name="Angebote von 3 Spediteuren einholen">
      <bpmn:incoming>SequenceFlow_SonderangebotEinholen</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AuswahlTreffen</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_Beauftragen" name="Spediteur beauftragen">
      <bpmn:incoming>SequenceFlow_AuswahlTreffen</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SonderwegZiel</bpmn:outgoing>
    </bpmn:task>

    <!-- Normal Shipment Path -->
    <bpmn:inclusiveGateway id="InclusiveGateway_NormalerVersand" name="Normalversand">
      <bpmn:incoming>SequenceFlow_NormalerVersand</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Paketschein</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_VersicherungPruefen</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <bpmn:task id="PaketscheinAusfuellen" name="Paketschein ausfüllen">
      <bpmn:incoming>SequenceFlow_Paketschein</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_VersicherungPruefen</bpmn:outgoing>
    </bpmn:task>

    <!-- Insurance Decision Gateway -->
    <bpmn:exclusiveGateway id="Gateway_VersicherungErforderlich" name="Versicherung erforderlich?">
      <bpmn:incoming>SequenceFlow_VersicherungPruefen</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_VersicherungAbschliessen</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Insurance Task -->
    <bpmn:task id="Task_Versicherung" name="Versicherung abschließen">
      <bpmn:incoming>SequenceFlow_VersicherungAbschliessen</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NormalerZiel</bpmn:outgoing>
    </bpmn:task>

    <!-- Warehouse Worker Lane Tasks -->
    <bpmn:task id="Task_WareVerpacken" name="Ware verpacken">
      <bpmn:incoming>SequenceFlow_LagerarbeiterStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_VerpacktZiel</bpmn:outgoing>
    </bpmn:task>

    <!-- Final Merge Gateway -->
    <bpmn:exclusiveGateway id="Gateway_VorbereitungenAbgeschlossen" name="Alle Vorbereitungen abgeschlossen?">
      <bpmn:incoming>SequenceFlow_SonderwegZiel</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_NormalerZiel</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_VerpacktZiel</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Bereitstellen</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Final Task -->
    <bpmn:task id="WareBereitstellen" name="Ware zur Abholung bereitstellen">
      <bpmn:incoming>SequenceFlow_Bereitstellen</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndEvent</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_1fx9yp3" name="Warenversand vorbereitet">
      <bpmn:incoming>SequenceFlow_EndEvent</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartParallelGateway" sourceRef="StartEvent_1" targetRef="ParallelGateway_Vorbereitungen"/>
    <bpmn:sequenceFlow id="SequenceFlow_SekretariatStart" name="Sekretariat" sourceRef="ParallelGateway_Vorbereitungen" targetRef="Task_VersandartKlaeren"/>
    <bpmn:sequenceFlow id="SequenceFlow_LagerarbeiterStart" name="Lagerarbeiter" sourceRef="ParallelGateway_Vorbereitungen" targetRef="Task_WareVerpacken"/>

    <!-- Secretary Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_GatewaySonderversand" sourceRef="Task_VersandartKlaeren" targetRef="Gateway_Sonderversand"/>
    <bpmn:sequenceFlow id="SequenceFlow_NormalerVersand" name="nein (kleine Menge)" sourceRef="Gateway_Sonderversand" targetRef="InclusiveGateway_NormalerVersand"/>
    <bpmn:sequenceFlow id="SequenceFlow_SonderangebotEinholen" name="ja (große Menge)" sourceRef="Gateway_Sonderversand" targetRef="Task_AngeboteEinholen"/>

    <!-- Special Shipment Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_AuswahlTreffen" sourceRef="Task_AngeboteEinholen" targetRef="Task_Beauftragen"/>
    <bpmn:sequenceFlow id="SequenceFlow_SonderwegZiel" name="Sonderversand abgeschlossen" sourceRef="Task_Beauftragen" targetRef="Gateway_VorbereitungenAbgeschlossen"/>

    <!-- Normal Shipment Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_Paketschein" name="immer" sourceRef="InclusiveGateway_NormalerVersand" targetRef="PaketscheinAusfuellen"/>
    <bpmn:sequenceFlow id="SequenceFlow_VersicherungPruefen" sourceRef="PaketscheinAusfuellen" targetRef="Gateway_VersicherungErforderlich"/>

    <!-- Insurance Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_VersicherungAbschliessen" name="ja (Versicherung erforderlich)" sourceRef="Gateway_VersicherungErforderlich" targetRef="Task_Versicherung"/>
    <bpmn:sequenceFlow id="SequenceFlow_NormalerZiel" name="Normalversand abgeschlossen" sourceRef="Task_Versicherung" targetRef="Gateway_VorbereitungenAbgeschlossen"/>

    <!-- Warehouse Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_VerpacktZiel" name="Ware verpackt" sourceRef="Task_WareVerpacken" targetRef="Gateway_VorbereitungenAbgeschlossen"/>

    <!-- Final Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_Bereitstellen" sourceRef="Gateway_VorbereitungenAbgeschlossen" targetRef="WareBereitstellen"/>
    <bpmn:sequenceFlow id="SequenceFlow_EndEvent" sourceRef="WareBereitstellen" targetRef="EndEvent_1fx9yp3"/>

  </bpmn:process>
</bpmn:definitions>