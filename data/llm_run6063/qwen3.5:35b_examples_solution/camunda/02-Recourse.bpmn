<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1recourse" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1recourse">
    <bpmn:participant id="Participant_1clerk" name="Recourse Clerk" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_recourseDetected" name="Probable recourse detected">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_checkCase</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Check case -->
    <bpmn:task id="Task_checkCase" name="Check case">
      <bpmn:incoming>SequenceFlow_checkCase</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_recoursePossibleDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Is recourse possible? -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_recoursePossible" name="Recourse possible?">
      <bpmn:incoming>SequenceFlow_recoursePossibleDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_sendPaymentRequest</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_closeCaseNoRecourse</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Send payment request -->
    <bpmn:task id="Task_sendPaymentRequest" name="Send request for payment">
      <bpmn:incoming>SequenceFlow_sendPaymentRequest</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_makeReminder</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Make reminder -->
    <bpmn:task id="Task_makeReminder" name="Make reminder">
      <bpmn:incoming>SequenceFlow_makeReminder</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_eventBasedGatewayWait</bpmn:outgoing>
    </bpmn:task>

    <!-- Event-Based Gateway for waiting on multiple events -->
    <bpmn:eventBasedGateway id="EventBasedGateway_wait" name="Waiting">
      <bpmn:incoming>SequenceFlow_eventBasedGatewayWait</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_moneyReceivedPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_disagreementLetterPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_reminderDuePath</bpmn:outgoing>
    </bpmn:eventBasedGateway>

    <!-- Intermediate Catch Event: Money received -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchMoneyReceived" name="Money received">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SequenceFlow_moneyReceivedPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_makeBooking</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task: Make booking -->
    <bpmn:task id="Task_makeBooking" name="Make booking">
      <bpmn:incoming>SequenceFlow_makeBooking</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_closeCaseMoneyReceived</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event: Case closed (money received) -->
    <bpmn:endEvent id="EndEvent_caseClosed_money" name="Case closed">
      <bpmn:incoming>SequenceFlow_closeCaseMoneyReceived</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Intermediate Catch Event: Disagreement letter received -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchDisagreement" name="Disagreement letter">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SequenceFlow_disagreementLetterPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_checkReasoning</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task: Check reasoning -->
    <bpmn:task id="Task_checkReasoning" name="Check reasoning">
      <bpmn:incoming>SequenceFlow_checkReasoning</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_disagreementValidDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2: Is disagreement valid? -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_disagreementValid" name="Disagreement OK?">
      <bpmn:incoming>SequenceFlow_disagreementValidDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_closeCaseReasoningOK</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_collectionAgencyWrong</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Close case (reasoning OK) -->
    <bpmn:task id="Task_closeCaseReasoningOK" name="Close case">
      <bpmn:incoming>SequenceFlow_closeCaseReasoningOK</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_endClosed_reasoningOK</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event: Case closed (reasoning OK) -->
    <bpmn:endEvent id="EndEvent_caseClosed_reasoning" name="Case closed">
      <bpmn:incoming>SequenceFlow_endClosed_reasoningOK</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task: Hand over to collection agency (wrong reasoning) -->
    <bpmn:task id="Task_collectionAgencyWrong" name="Hand over to collection agency">
      <bpmn:incoming>SequenceFlow_collectionAgencyWrong</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_endOpen_agency</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event: Case open (collection agency) -->
    <bpmn:endEvent id="EndEvent_caseOpen_agency" name="Case forwarded to collection">
      <bpmn:incoming>SequenceFlow_endOpen_agency</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Intermediate Catch Event: Reminder due -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchReminderDue" name="Deadline reached (no money)">
      <bpmn:timerEventDefinition/>
      <bpmn:incoming>SequenceFlow_reminderDuePath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_collectionAgencyTimeOut</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task: Hand over to collection agency (time out) -->
    <bpmn:task id="Task_collectionAgencyTimeout" name="Hand over to collection agency">
      <bpmn:incoming>SequenceFlow_collectionAgencyTimeOut</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_endOpen_agency2</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event: Case open (collection agency - timeout) -->
    <bpmn:endEvent id="EndEvent_caseOpen_timeout" name="Case forwarded to collection">
      <bpmn:incoming>SequenceFlow_endOpen_agency2</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task: Close case (no recourse possible) -->
    <bpmn:task id="Task_closeCaseNoRecourse" name="Close case">
      <bpmn:incoming>SequenceFlow_closeCaseNoRecourse</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_endClosed_noRecourse</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event: Case closed (no recourse) -->
    <bpmn:endEvent id="EndEvent_caseClosed_norecourse" name="Case closed">
      <bpmn:incoming>SequenceFlow_endClosed_noRecourse</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_checkCase" sourceRef="StartEvent_recourseDetected" targetRef="Task_checkCase"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_recoursePossibleDecision" sourceRef="Task_checkCase" targetRef="ExclusiveGateway_recoursePossible"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_sendPaymentRequest" name="Yes - possible" sourceRef="ExclusiveGateway_recoursePossible" targetRef="Task_sendPaymentRequest"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_closeCaseNoRecourse" name="No - not possible" sourceRef="ExclusiveGateway_recoursePossible" targetRef="Task_closeCaseNoRecourse"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_makeReminder" sourceRef="Task_sendPaymentRequest" targetRef="Task_makeReminder"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_eventBasedGatewayWait" sourceRef="Task_makeReminder" targetRef="EventBasedGateway_wait"/>
    
    <!-- Money received path -->
    <bpmn:sequenceFlow id="SequenceFlow_moneyReceivedPath" name="Money received" sourceRef="EventBasedGateway_wait" targetRef="IntermediateCatchMoneyReceived"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_makeBooking" sourceRef="IntermediateCatchMoneyReceived" targetRef="Task_makeBooking"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_closeCaseMoneyReceived" sourceRef="Task_makeBooking" targetRef="EndEvent_caseClosed_money"/>
    
    <!-- Disagreement letter path -->
    <bpmn:sequenceFlow id="SequenceFlow_disagreementLetterPath" name="Disagreement received" sourceRef="EventBasedGateway_wait" targetRef="IntermediateCatchDisagreement"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_checkReasoning" sourceRef="IntermediateCatchDisagreement" targetRef="Task_checkReasoning"/>
    
    <!-- Disagreement valid decision -->
    <bpmn:sequenceFlow id="SequenceFlow_disagreementValidDecision" name="Check reasoning result" sourceRef="Task_checkReasoning" targetRef="ExclusiveGateway_disagreementValid"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_closeCaseReasoningOK" name="Yes - valid" sourceRef="ExclusiveGateway_disagreementValid" targetRef="Task_closeCaseReasoningOK"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_endClosed_reasoningOK" sourceRef="Task_closeCaseReasoningOK" targetRef="EndEvent_caseClosed_reasoning"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_collectionAgencyWrong" name="No - invalid" sourceRef="ExclusiveGateway_disagreementValid" targetRef="Task_collectionAgencyWrong"/>
    
    <!-- Collection agency (wrong reasoning) -->
    <bpmn:sequenceFlow id="SequenceFlow_endOpen_agency" sourceRef="Task_collectionAgencyWrong" targetRef="EndEvent_caseOpen_agency"/>
    
    <!-- Reminder due path -->
    <bpmn:sequenceFlow id="SequenceFlow_reminderDuePath" name="Deadline reached (no money)" sourceRef="EventBasedGateway_wait" targetRef="IntermediateCatchReminderDue"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_collectionAgencyTimeOut" sourceRef="IntermediateCatchReminderDue" targetRef="Task_collectionAgencyTimeout"/>
    
    <!-- Collection agency (timeout) -->
    <bpmn:sequenceFlow id="SequenceFlow_endOpen_agency2" sourceRef="Task_collectionAgencyTimeout" targetRef="EndEvent_caseOpen_timeout"/>
    
    <!-- Close case path (no recourse possible) -->
    <bpmn:sequenceFlow id="SequenceFlow_endClosed_noRecourse" sourceRef="Task_closeCaseNoRecourse" targetRef="EndEvent_caseClosed_norecourse"/>

  </bpmn:process>
</bpmn:definitions>