<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1a2b3c4d5e6f">
    <bpmn:participant id="Participant_HardwareShop" name="Dispatch of goods - Computer Hardware Shop" processRef="Process_ShippingGoods"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_ShippingGoods" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_LogisticsDeptHead" name="Logistics Department Head">
        <bpmn:flowNodeRef>Task_InsureParcel</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Secretary" name="Secretary">
        <bpmn:flowNodeRef>StartEvent_ShipeGoods</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ClarifyShipmentMethod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_SpecialHandlingDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Get3OffersFromLogisticsCompanies</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectLogisticCompanyAndPlaceOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_MergeAfterSpecialHandling</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WritePackageLabel</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Warehouse" name="Warehousemen">
        <bpmn:flowNodeRef>Task_PackageGoods</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_MergeBeforePickupPreparation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareForPickingUpGoods</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_EndEvent" name="">
        <bpmn:flowNodeRef>EndEvent_ShipmentPrepared</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_ShipeGoods" name="Ship goods">
      <bpmn:outgoing SequenceFlow_01_StartToParallelGateway />
    </bpmn:startEvent>

    <!-- Parallel Gateway for concurrent paths -->
    <bpmn:parallelGateway id="ParallelGateway_ConcurrentPaths" name="">
      <bpmn:incoming SequenceFlow_01_StartToParallelGateway />
      <bpmn:outgoing SequenceFlow_02_ToSecretaryPath />
      <bpmn:outgoing SequenceFlow_03_ToWarehousePath />
    </bpmn:parallelGateway>

    <!-- Secretary Path - Clarify Shipment Method -->
    <bpmn:task id="Task_ClarifyShipmentMethod" name="Clarify shipment method">
      <bpmn:incoming SequenceFlow_02_ToSecretaryPath />
      <bpmn:outgoing SequenceFlow_04_ToSpecialHandlingDecision />
    </bpmn:task>

    <!-- Decision Gateway - Special Handling? -->
    <bpmn:exclusiveGateway id="Gw_SpecialHandlingDecision" name="Special handling needed?">
      <bpmn:incoming SequenceFlow_04_ToSpecialHandlingDecision />
      <bpmn:outgoing SequenceFlow_05_LargeAmountsPath />
      <bpmn:outgoing SequenceFlow_06_NormalPostShipmentPath />
    </bpmn:exclusiveGateway>

    <!-- Large Amounts Path - Get 3 Offers -->
    <bpmn:task id="Task_Get3OffersFromLogisticsCompanies" name="Get 3 offers from logistic companies">
      <bpmn:incoming SequenceFlow_05_LargeAmountsPath />
      <bpmn:outgoing SequenceFlow_07_SelectCompanyAndPlaceOrder />
    </bpmn:task>

    <!-- Large Amounts Path - Select Company -->
    <bpmn:task id="Task_SelectLogisticCompanyAndPlaceOrder" name="Select logistic company and place order">
      <bpmn:incoming SequenceFlow_07_SelectCompanyAndPlaceOrder />
      <bpmn:outgoing SequenceFlow_08_ToMergeAfterSpecialHandling />
    </bpmn:task>

    <!-- Merge After Special Handling -->
    <bpmn:inclusiveGateway id="Gw_MergeAfterSpecialHandling" name="">
      <bpmn:incoming SequenceFlow_06_NormalPostShipmentPath />
      <bpmn:outgoing SequenceFlow_12_ToNormalPostDecision />
    </bpmn:inclusiveGateway>

    <!-- Normal Post Shipment Decision -->
    <bpmn:exclusiveGateway id="Gw_NormalPostShipmentDecision" name="">
      <bpmn:incoming SequenceFlow_08_ToMergeAfterSpecialHandling />
      <bpmn:outgoing SequenceFlow_13_WritePackageLabelPath />
    </bpmn:inclusiveGateway>

    <!-- Write Package Label -->
    <bpmn:task id="Task_WritePackageLabel" name="Write package label">
      <bpmn:incoming SequenceFlow_09_ToMergeAfterSpecialHandling />
      <bpmn:outgoing SequenceFlow_14_ToInclusiveGatewayForInsuranceDecision />
    </bpmn:task>

    <!-- Inclusive Gateway for Insurance Decision -->
    <bpmn:inclusiveGateway id="Gw_InclusiveGatewayForInsuranceDecision" name="">
      <bpmn:incoming SequenceFlow_09_ToMergeAfterSpecialHandling />
      <bpmn:outgoing SequenceFlow_15_WritePackageLabelPath />
    </bpmn:inclusiveGateway>

    <!-- Merge After Special Handling -->
    <bpmn:exclusiveGateway id="Gw_MergeBeforePickupPreparation" name="">
      <bpmn:incoming SequenceFlow_08_ToMergeAfterSpecialHandling />
      <bpmn:outgoing SequenceFlow_16_PrepareForPickingUpGoodsPath />
    </bpmn:inclusiveGateway>

    <!-- Warehouse Path - Package Goods -->
    <bpmn:task id="Task_PackageGoods" name="Package goods">
      <bpmn:incoming SequenceFlow_03_ToWarehousePath />
      <bpmn:outgoing SequenceFlow_17_ToMergeBeforePickupPreparation />
    </bpmn:task>

    <!-- Merge Before Pickup Preparation -->
    <bpmn:exclusiveGateway id="Gw_MergeBeforePickupPreparation" name="">
      <bpmn:incoming SequenceFlow_08_ToMergeAfterSpecialHandling />
      <bpmn:outgoing SequenceFlow_16_PrepareForPickingUpGoodsPath />
    </bpmn:inclusiveGateway>

    <!-- Prepare for Picking Up Goods -->
    <bpmn:task id="Task_PrepareForPickingUpGoods" name="Prepare for picking up goods">
      <bpmn:incoming SequenceFlow_16_PrepareForPickingUpGoodsPath />
      <bpmn:outgoing SequenceFlow_20_ToEndEvent_ShipmentPrepared />
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_ShipmentPrepared" name="Shipment prepared">
      <bpmn:incoming SequenceFlow_20_ToEndEvent_ShipmentPrepared />
    </bpmn:endEvent>

    <!-- Insurance Task (Logistics Department Head) -->
    <bpmn:task id="Task_InsureParcel" name="Insure parcel">
      <bpmn:incoming SequenceFlow_18_ToInsuranceDecisionGateway />
      <bpmn:outgoing SequenceFlow_19_ToMergeAfterSpecialHandling />
    </bpmn:task>

    <!-- Insurance Decision Gateway -->
    <bpmn:exclusiveGateway id="Gw_InsureParcel" name="">
      <bpmn:incoming SequenceFlow_06_NormalPostShipmentPath />
      <bpmn:outgoing SequenceFlow_18_ToInsuranceDecisionGateway />
    </bpmn:inclusiveGateway>

  </bpmn:process>
</bpmn:definitions>