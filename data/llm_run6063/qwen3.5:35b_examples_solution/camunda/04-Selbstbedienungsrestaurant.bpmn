<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Gast" name="Gast - Nahrungsaufnahme" processRef="Process_Gast"/>
    <bpmn:participant id="Participant_Angestellter" name="Angestellter - Bestellungsbearbeitung" processRef="Process_Angestellter"/>
    <bpmn:participant id="Participant_Koch" name="Koch - Mahlzeitzubereitung" processRef="Process_Koch"/>
    
    <!-- Message Flows between participants -->
    <bpmn:messageFlow id="Message_Gast_OrderToStaff" sourceRef="Task_Gast_BestellungAufgeben" targetRef="Start_Angestellter_Empfangen"/>
    <bpmn:messageFlow id="Message_Staff_PagerSetup" sourceRef="Task_Angestellter_PieperUbergeben" targetRef="Event_Gast_WartenPieper"/>
    <bpmn:messageFlow id="Message_Staff_KochInformieren" sourceRef="Task_Angestellter_KochInformieren" targetRef="Start_Koch_BestellungErhalten"/>
    <bpmn:messageFlow id="Message_Cook_FertigMelden" sourceRef="Task_Koch_MeldeFertig" targetRef="Event_Staff_WartenAufEssen"/>
  </bpmn:collaboration>

  <!-- Guest Process -->
  <bpmn:process id="Process_Gast">
    <bpmn:startEvent id="Start_HungerGefuehl" name="Hunger verspürt">
      <bpmn:outgoing SequenceFlow_1"/>
    </bpmn:startEvent>
    
    <bpmn:task id="Task_RestaurantBetreten" name="Restaurant betreten">
      <bpmn:incoming SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing SequenceFlow_2"/>
    </bpmn:task>
    
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="Start_HungerGefuehl" targetRef="Task_RestaurantBetreten"/>
    
    <bpmn:task id="Task_GerichtAuswahlen" name="Gericht auswählen">
      <bpmn:incoming SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing SequenceFlow_3"/>
    </bpmn:task>
    
    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="Task_RestaurantBetreten" targetRef="Task_GerichtAuswahlen"/>
    
    <bpmn:intermediateCatchEvent id="Event_WartenAnReihe" name="Warte bis an der Reihe">
      <bpmn:incoming SequenceFlow_3</bpmn:incoming>
      <bpmn:outgoing SequenceFlow_4"/>
      <bpmn:messageEventDefinition/>
    </bpmn:intermediateCatchEvent>
    
    <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="Task_GerichtAuswahlen" targetRef="Event_WartenAnReihe"/>
    
    <bpmn:task id="Task_BestellungAufgeben" name="Bestellung aufgeben">
      <bpmn:incoming SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing SequenceFlow_5"/>
    </bpmn:task>
    
    <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="Event_WartenAnReihe" targetRef="Task_BestellungAufgeben"/>
    
    <bpmn:intermediateCatchEvent id="Event_PieperErhalten" name="Pieper erhalten">
      <bpmn:incoming SequenceFlow_5</bpmn:incoming>
      <bpmn:outgoing SequenceFlow_6"/>
      <bpmn:messageEventDefinition/>
    </bpmn:intermediateCatchEvent>
    
    <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="Task_BestellungAufgeben" targetRef="Event_PieperErhalten"/>
    
    <bpmn:eventBasedGateway id="Gateway_WartenEssen">
      <bpmn:incoming SequenceFlow_6</bpmn:incoming>
      <bpmn:outgoing SequenceFlow_7"/>
      <bpmn:outgoing SequenceFlow_8"/>
    </bpmn:eventBasedGateway>
    
    <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="Event_PieperErhalten" targetRef="Gateway_WartenEssen"/>
    
    <bpmn:intermediateCatchEvent id="Event_EssenFertigSignal" name="Pieper meldet sich">
      <bpmn:incoming SequenceFlow_7</bpmn:incoming>
      <bpmn:outgoing SequenceFlow_9"/>
      <bpmn:messageEventDefinition/>
    </bpmn:intermediateCatchEvent>
    
    <bpmn:sequenceFlow id="SequenceFlow_7" sourceRef="Gateway_WartenEssen" targetRef="Event_EssenFertigSignal">
      <bpmn:name>Pieper meldet sich</bpmn:name>
    </bpmn:sequenceFlow>
    
    <bpmn:intermediateCatchEvent id="Event_5MinutenAusrufen" name="Nach 5 Minuten ausrufen lassen">
      <bpmn:incoming SequenceFlow_8</bpmn:incoming>
      <bpmn:outgoing SequenceFlow_10"/>
    </bpmn:intermediateCatchEvent>
    
    <bpmn:sequenceFlow id="SequenceFlow_8" sourceRef="Gateway_WartenEssen" targetRef="Event_5MinutenAusrufen">
      <bpmn:name>Nach 5 Minuten</bpmn:name>
    </bpmn:sequenceFlow>
    
    <bpmn:task id="Task_EssenAbholen" name="Essen abholen">
      <bpmn:incoming SequenceFlow_9</bpmn:incoming>
      <bpmn:outgoing SequenceFlow_10"/>
    </bpmn:task>
    
    <bpmn:sequenceFlow id="SequenceFlow_9" sourceRef="Event_EssenFertigSignal" targetRef="Task_EssenAbholen"/>
    
    <bpmn:task id="Task_MahlzeitVerzehren" name="Mahlzeit verzehren">
      <bpmn:incoming SequenceFlow_10</bpmn:incoming>
      <bpmn:outgoing SequenceFlow_11"/>
    </bpmn:task>
    
    <bpmn:endEvent id="End_HungerGestillt" name="Hunger gestillt">
      <bpmn:incoming SequenceFlow_11</bpmn:incoming>
    </bpmn:endEvent>
    
    <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="Task_EssenAbholen" targetRef="Task_MahlzeitVerzehren"/>
    <bpmn:sequenceFlow id="SequenceFlow_11" sourceRef="Task_MahlzeitVerzehren" targetRef="End_HungerGestillt"/>
  </bpmn:process>

  <!-- Staff Process -->
  <bpmn:process id="Process_Angestellter">
    <bpmn:startEvent id="Start_Empfangen" name="Bestellung erhalten">
      <bpmn:outgoing SequenceFlow_12"/>
      <bpmn:messageEventDefinition/>
    </bpmn:startEvent>
    
    <bpmn:task id="Task_BestellungEingeben" name="Bestellung eingeben">
      <bpmn:incoming SequenceFlow_12</bpmn:incoming>
      <bpmn:outgoing SequenceFlow_13"/>
    </bpmn:task>
    
    <bpmn:sequenceFlow id="SequenceFlow_12" sourceRef="Start_Empfangen" targetRef="Task_BestellungEingeben"/>
    
    <bpmn:task id="Task_GeldKassieren" name="Geld kassieren">
      <bpmn:incoming SequenceFlow_13</bpmn:incoming>
      <bpmn:outgoing SequenceFlow_14"/>
    </bpmn:task>
    
    <bpmn:sequenceFlow id="SequenceFlow_13" sourceRef="Task_BestellungEingeben" targetRef="Task_GeldKassieren"/>
    
    <bpmn:task id="Task_PieperEinrichten" name="Pieper einstellen">
      <bpmn:incoming SequenceFlow_14</bpmn:incoming>
      <bpmn:outgoing SequenceFlow_15"/>
    </bpmn:task>
    
    <bpmn:sequenceFlow id="SequenceFlow_14" sourceRef="Task_GeldKassieren" targetRef="Task_PieperEinrichten"/>
    
    <bpmn:task id="Task_PieperUbergeben" name="Pieper übergeben">
      <bpmn:incoming SequenceFlow_15</bpmn:incoming>
      <bpmn:outgoing SequenceFlow_16"/>
    </bpmn:task>
    
    <bpmn:sequenceFlow id="SequenceFlow_15" sourceRef="Task_PieperEinrichten" targetRef="Task_PieperUbergeben">
      <bpmn:name>"wenn sich der Pieper meldet, ist ihr Essen fertig"</bpmn:name>
    </bpmn:sequenceFlow>
    
    <bpmn:task id="Task_KochInformieren" name="Koch informieren">
      <bpmn:incoming SequenceFlow_16</bpmn:incoming>
      <bpmn:outgoing SequenceFlow_17"/>
    </bpmn:task>
    
    <bpmn:sequenceFlow id="SequenceFlow_16" sourceRef="Task_PieperUbergeben" targetRef="Task_KochInformieren"/>
    
    <bpmn:eventBasedGateway id="Gateway_WartenEssenFertig">
      <bpmn:incoming SequenceFlow_17</bpmn:incoming>
      <bpmn:outgoing SequenceFlow_18"/>
      <bpmn:outgoing SequenceFlow_20"/>
    </bpmn:eventBasedGateway>
    
    <bpmn:sequenceFlow id="SequenceFlow_17" sourceRef="Task_KochInformieren" targetRef="Gateway_WartenEssenFertig"/>
    
    <bpmn:intermediateCatchEvent id="Event_EssenFertigSignalStaff" name="Koch meldet Essen fertig">
      <bpmn:incoming SequenceFlow_18</bpmn:incoming>
      <bpmn:outgoing SequenceFlow_20"/>
    </bpmn:intermediateCatchEvent>
    
    <bpmn:sequenceFlow id="SequenceFlow_18" sourceRef="Gateway_WartenEssenFertig" targetRef="Event_EssenFertigSignalStaff">
      <bpmn:name>Koch meldet Essen fertig</bpmn:name>
    </bpmn:sequenceFlow>
    
    <bpmn:task id="Task_PieperAusloesen" name="Pieper auslösen">
      <bpmn:incoming SequenceFlow_19</bpmn:incoming>
      <bpmn:outgoing SequenceFlow_20"/>
    </bpmn:task>
    
    <bpmn:sequenceFlow id="SequenceFlow_19" sourceRef="Event_EssenFertigSignalStaff" targetRef="Task_PieperAusloesen"/>
    
    <bpmn:eventBasedGateway id="Gateway_WartenGastErscheint">
      <bpmn:incoming SequenceFlow_20</bpmn:incoming>
      <bpmn:outgoing SequenceFlow_21"/>
      <bpmn:outgoing SequenceFlow_23"/>
    </bpmn:eventBasedGateway>
    
    <bpmn:sequenceFlow id="SequenceFlow_20" sourceRef="Task_PieperAusloesen" targetRef="Gateway_WartenGastErscheint"/>
    
    <bpmn:intermediateCatchEvent id="Event_GastErscheint" name="Gast erscheint an Ausgabe">
      <bpmn:incoming SequenceFlow_21</bpmn:incoming>
      <bpmn:outgoing SequenceFlow_23"/>
    </bpmn:intermediateCatchEvent>
    
    <bpmn:sequenceFlow id="SequenceFlow_21" sourceRef="Gateway_WartenGastErscheint" targetRef="Event_GastErscheint">
      <bpmn:name>Gast erscheint</bpmn:name>
    </bpmn:sequenceFlow>
    
    <bpmn:intermediateCatchEvent id="Event_5MinutenTimerStaff" name="Nach 5 Minuten ausrufen">
      <bpmn:incoming SequenceFlow_23</bpmn:incoming>
      <bpmn:outgoing SequenceFlow_24"/>
    </bpmn:intermediateCatchEvent>
    
    <bpmn:sequenceFlow id="SequenceFlow_23" sourceRef="Gateway_WartenGastErscheint" targetRef="Event_5MinutenTimerStaff">
      <bpmn:name>Nach 5 Minuten</bpmn:name>
    </bpmn:sequenceFlow>
    
    <bpmn:task id="Task_Gastausrufen" name="Gast ausrufen">
      <bpmn:incoming SequenceFlow_24</bpmn:incoming>
      <bpmn:outgoing SequenceFlow_25"/>
    </bpmn:task>
    
    <bpmn:sequenceFlow id="SequenceFlow_24" sourceRef="Event_5MinutenTimerStaff" targetRef="Task_Gastausrufen">
      <bpmn:name>nicht auf Pieper reagiert</bpmn:name>
    </bpmn:sequenceFlow>
    
    <bpmn:task id="Task_EssenUbergeben" name="Essen übergeben">
      <bpmn:incoming SequenceFlow_25</bpmn:incoming>
      <bpmn:outgoing SequenceFlow_26"/>
    </bpmn:task>
    
    <bpmn:endEvent id="End_BestellungErledigt" name="Bestellung bearbeitet">
      <bpmn:incoming SequenceFlow_27</bpmn:incoming>
    </bpmn:endEvent>
    
    <bpmn:sequenceFlow id="SequenceFlow_25" sourceRef="Task_Gastausrufen" targetRef="Gateway_WartenGastErscheint">
      <bpmn:name>nicht auf Pieper reagiert</bpmn:name>
    </bpmn:sequenceFlow>
    
    <bpmn:endEvent id="End_EssenUbergeben" name="Essen übergeben">
      <bpmn:incoming SequenceFlow_26</bpmn:incoming>
    </bpmn:endEvent>
    
    <bpmn:sequenceFlow id="SequenceFlow_26" sourceRef="Task_EssenUbergeben" targetRef="End_EssenUbergeben"/>
  </bpmn:process>

  <!-- Cook Process -->
  <bpmn:process id="Process_Koch">
    <bpmn:startEvent id="Start_BestellungErhaltenKoch" name="Bestellung erhalten">
      <bpmn:outgoing SequenceFlow_27"/>
      <bpmn:messageEventDefinition/>
    </bpmn:startEvent>
    
    <bpmn:task id="Task_MahlzeitZubereiten" name="Mahlzeit zubereiten">
      <bpmn:incoming SequenceFlow_27</bpmn:incoming>
      <bpmn:outgoing SequenceFlow_28"/>
    </bpmn:task>
    
    <bpmn:sequenceFlow id="SequenceFlow_27" sourceRef="Start_BestellungErhaltenKoch" targetRef="Task_MahlzeitZubereiten"/>
    
    <bpmn:task id="Task_EssenInDurchreicheStellen" name="Essen in Durchreiche stellen">
      <bpmn:incoming SequenceFlow_28</bpmn:incoming>
      <bpmn:outgoing SequenceFlow_29"/>
    </bpmn:task>
    
    <bpmn:sequenceFlow id="SequenceFlow_28" sourceRef="Task_MahlzeitZubereiten" targetRef="Task_EssenInDurchreicheStellen"/>
    
    <bpmn:task id="Task_KochMeldetFertig" name="Angestellten informieren">
      <bpmn:incoming SequenceFlow_29</bpmn:incoming>
      <bpmn:outgoing SequenceFlow_30"/>
    </bpmn:task>
    
    <bpmn:endEvent id="End_MahlzeitZubereitet" name="Mahlzeit zubereitet">
      <bpmn:incoming SequenceFlow_31</bpmn:incoming>
    </bpmn:endEvent>
    
    <bpmn:sequenceFlow id="SequenceFlow_29" sourceRef="Task_EssenInDurchreicheStellen" targetRef="Task_KochMeldetFertig"/>
    <bpmn:sequenceFlow id="SequenceFlow_30" sourceRef="Task_KochMeldetFertig" targetRef="End_MahlzeitZubereitet">
      <bpmn:name>Koch meldet Essen fertig</bpmn:name>
    </bpmn:sequenceFlow>
  </bpmn:process>

  <!-- Message Definitions -->
  <bpmn:message id="Message_Bestellung" name="Bestellungsübermittlung"/>
  <bpmn:message id="Message_PieperSetup" name="Pieper-Einrichtungssignal"/>
  <bpmn:message id="Message_KochInformieren" name="Koch-Information"/>
  <bpmn:message id="Message_EssenFertig" name="Essen-fertig-Signal"/>
</bpmn:definitions>