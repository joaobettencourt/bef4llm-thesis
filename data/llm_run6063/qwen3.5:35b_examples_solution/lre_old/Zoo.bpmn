<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1zooclub">
    <bpmn:participant id="Participant_visitor" name="Visitor" processRef="Process_visitor"/>
    <bpmn:participant id="Participant_zooclub" name="ZooClub department" processRef="Process_zooclub"/>
    <bpmn:participant id="Participant_billing" name="Billing department" processRef="Process_billing"/>
    <bpmn:participant id="Participant_marketing" name="Marketing department" processRef="Process_marketing"/>
    <bpmn:participant id="Participant_bank" name="Bank" processRef="Process_bank"/>

    <!-- Message flows between participants -->
    <bpmn:messageFlow id="MessageFlow_visitor_to_zooclub" sourceRef="Task_visitor_send_info" targetRef="StartEvent_zooclub_receive"/>
    <bpmn:messageFlow id="MessageFlow_zooclub_to_billing" sourceRef="Task_zoo_prepare_payment_request" targetRef="StartEvent_billing_receive"/>
    <bpmn:messageFlow id="MessageFlow_zooclub_to_marketing" sourceRef="Task_zoo_forward_info" targetRef="StartEvent_marketing_receive"/>
    <bpmn:messageFlow id="MessageFlow_billing_to_bank" sourceRef="Task_billing_send_request" targetRef="StartEvent_bank_process"/>
    <bpmn:messageFlow id="MessageFlow_bank_to_zooclub" sourceRef="EndEvent_payment_confirmed" targetRef="IntermediateCatchPaymentConfirmed_ZooClub"/>

  </bpmn:collaboration>

  <!-- Visitor Process -->
  <bpmn:process id="Process_visitor">
    <bpmn:startEvent id="StartEvent_visitor_join">
      <bpmn:name>Join ZooClub</bpmn:name>
      <bpmn:outgoing>SequenceFlow_1_decision_membership</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_visitor_decide">
      <bpmn:name>Decide membership type (Individual/Family)</bpmn:name>
      <bpmn:incoming>SequenceFlow_1_decision_membership</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2_gateway_type</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="ExclusiveGateway_membership">
      <bpmn:name>Individual membership?</bpmn:name>
      <bpmn:incoming>SequenceFlow_2_gateway_type</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3_individual_info</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_4_family_info</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_visitor_prepare_personal">
      <bpmn:name>Prepare personal information (Individual)</bpmn:name>
      <bpmn:incoming>SequenceFlow_3_individual_info</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5_converge</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_visitor_prepare_family">
      <bpmn:name>Prepare family information (spouse and spawn)</bpmn:name>
      <bpmn:incoming>SequenceFlow_4_family_info</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6_converge</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="ExclusiveGateway_prepare_complete">
      <bpmn:name>All information prepared?</bpmn:name>
      <bpmn:incoming>SequenceFlow_5_converge</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_6_converge</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_7_send_to_zoo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_visitor_send_info">
      <bpmn:name>Send information to ZooClub department</bpmn:name>
      <bpmn:incoming>SequenceFlow_7_send_to_zoo</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_8_wait_card</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:intermediateCatchEvent id="IntermediateCatchCardReceived">
      <bpmn:name>Wait for card</bpmn:name>
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SequenceFlow_8_wait_card</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_9_wait_card_event</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:userTask id="Task_visitor_receive">
      <bpmn:name>Receive ZooClub card and magazine</bpmn:name>
      <bpmn:incoming>SequenceFlow_9_wait_card_event</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_10_go_home</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndEvent_visitor_done">
      <bpmn:name>Go home (Membership complete)</bpmn:name>
      <bpmn:incoming>SequenceFlow_10_go_home</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="SequenceFlow_1_decision_membership" sourceRef="StartEvent_visitor_join" targetRef="Task_visitor_decide"/>
    <bpmn:sequenceFlow id="SequenceFlow_2_gateway_type" sourceRef="Task_visitor_decide" targetRef="ExclusiveGateway_membership"/>
    <bpmn:sequenceFlow id="SequenceFlow_3_individual_info" name="Yes - Individual" sourceRef="ExclusiveGateway_membership" targetRef="Task_visitor_prepare_personal"/>
    <bpmn:sequenceFlow id="SequenceFlow_4_family_info" name="No - Family" sourceRef="ExclusiveGateway_membership" targetRef="Task_visitor_prepare_family"/>
    <bpmn:sequenceFlow id="SequenceFlow_5_converge" sourceRef="Task_visitor_prepare_personal" targetRef="ExclusiveGateway_prepare_complete"/>
    <bpmn:sequenceFlow id="SequenceFlow_6_converge" sourceRef="Task_visitor_prepare_family" targetRef="ExclusiveGateway_prepare_complete"/>
    <bpmn:sequenceFlow id="SequenceFlow_7_send_to_zoo" name="Information complete" sourceRef="ExclusiveGateway_prepare_complete" targetRef="Task_visitor_send_info"/>
    <bpmn:sequenceFlow id="SequenceFlow_8_wait_card" sourceRef="Task_visitor_send_info" targetRef="IntermediateCatchCardReceived"/>
    <bpmn:sequenceFlow id="SequenceFlow_9_wait_card_event" sourceRef="IntermediateCatchCardReceived" targetRef="Task_visitor_receive"/>
    <bpmn:sequenceFlow id="SequenceFlow_10_go_home" name="Receive card and magazine" sourceRef="Task_visitor_receive" targetRef="EndEvent_visitor_done"/>

  </bpmn:process>

  <!-- ZooClub Department Process -->
  <bpmn:process id="Process_zooclub">
    <bpmn:startEvent id="StartEvent_zooclub_receive">
      <bpmn:name>Receive visitor information</bpmn:name>
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_10_enter_system</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_zoo_enter_data">
      <bpmn:name>Enter visitor data into system</bpmn:name>
      <bpmn:incoming>SequenceFlow_10_enter_system</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_11_parallel_split</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:parallelGateway id="ParallelGateway_zoo_branch">
      <bpmn:name>Process in parallel</bpmn:name>
      <bpmn:incoming>SequenceFlow_11_parallel_split</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_12_payment_request</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_13_marketing_info</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:userTask id="Task_zoo_prepare_payment">
      <bpmn:name>Prepare payment request for Billing department</bpmn:name>
      <bpmn:incoming>SequenceFlow_12_payment_request</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_14_wait_confirmation</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_zoo_forward_info">
      <bpmn:name>Forward visitor information to Marketing department</bpmn:name>
      <bpmn:incoming>SequenceFlow_13_marketing_info</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_15_wait_confirmation</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:parallelGateway id="ParallelGateway_zoo_converge">
      <bpmn:name>Wait for all processes complete</bpmn:name>
      <bpmn:incoming>SequenceFlow_14_wait_confirmation</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_15_wait_confirmation</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_16_print_card</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:userTask id="Task_zoo_print_deliver">
      <bpmn:name>Print ZooClub card and deliver to visitor</bpmn:name>
      <bpmn:incoming>SequenceFlow_16_print_card</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_17_end_zoo</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndEvent_zoo_done">
      <bpmn:name>ZooClub process complete</bpmn:name>
      <bpmn:incoming>SequenceFlow_17_end_zoo</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Intermediate catch event for payment confirmation -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchPaymentConfirmed_ZooClub">
      <bpmn:name>Wait for payment confirmed from Bank</bpmn:name>
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SequenceFlow_18_payment_confirm_incoming</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_16_print_card</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="SequenceFlow_10_enter_system" sourceRef="StartEvent_zooclub_receive" targetRef="Task_zoo_enter_data"/>
    <bpmn:sequenceFlow id="SequenceFlow_11_parallel_split" sourceRef="Task_zoo_enter_data" targetRef="ParallelGateway_zoo_branch"/>
    <bpmn:sequenceFlow id="SequenceFlow_12_payment_request" name="Send to Billing dept." sourceRef="ParallelGateway_zoo_branch" targetRef="Task_zoo_prepare_payment"/>
    <bpmn:sequenceFlow id="SequenceFlow_13_marketing_info" name="Forward info to Marketing" sourceRef="ParallelGateway_zoo_branch" targetRef="Task_zoo_forward_info"/>
    <bpmn:sequenceFlow id="SequenceFlow_14_wait_confirmation" sourceRef="Task_zoo_prepare_payment" targetRef="IntermediateCatchPaymentConfirmed_ZooClub"/>
    <bpmn:sequenceFlow id="SequenceFlow_15_wait_confirmation" name="Wait for payment confirmation" sourceRef="Task_zoo_forward_info" targetRef="ParallelGateway_zoo_converge"/>
    <bpmn:sequenceFlow id="SequenceFlow_16_print_card" sourceRef="IntermediateCatchPaymentConfirmed_ZooClub" targetRef="Task_zoo_print_deliver"/>
    <bpmn:sequenceFlow id="SequenceFlow_17_end_zoo" name="Card delivered to visitor" sourceRef="Task_zoo_print_deliver" targetRef="EndEvent_zoo_done"/>

  </bpmn:process>

  <!-- Billing Department Process -->
  <bpmn:process id="Process_billing">
    <bpmn:startEvent id="StartEvent_billing_receive">
      <bpmn:name>Receive payment request</bpmn:name>
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_20_send_to_bank</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_billing_process">
      <bpmn:name>Process payment request and send to Bank</bpmn:name>
      <bpmn:incoming>SequenceFlow_20_send_to_bank</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_21_end_billing</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndEvent_billing_done">
      <bpmn:name>Billing process complete</bpmn:name>
      <bpmn:incoming>SequenceFlow_21_end_billing</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="SequenceFlow_20_send_to_bank" sourceRef="StartEvent_billing_receive" targetRef="Task_billing_process"/>
    <bpmn:sequenceFlow id="SequenceFlow_21_end_billing" name="Payment request sent to Bank" sourceRef="Task_billing_process" targetRef="EndEvent_billing_done"/>

  </bpmn:process>

  <!-- Marketing Department Process -->
  <bpmn:process id="Process_marketing">
    <bpmn:startEvent id="StartEvent_marketing_receive">
      <bpmn:name>Receive visitor information</bpmn:name>
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_25_mail_magazine</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_marketing_request">
      <bpmn:name>Request magazine mailing to visitor's home</bpmn:name>
      <bpmn:incoming>SequenceFlow_25_mail_magazine</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_26_end_marketing</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndEvent_marketing_done">
      <bpmn:name>Marketing process complete</bpmn:name>
      <bpmn:incoming>SequenceFlow_26_end_marketing</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="SequenceFlow_25_mail_magazine" sourceRef="StartEvent_marketing_receive" targetRef="Task_marketing_request"/>
    <bpmn:sequenceFlow id="SequenceFlow_26_end_marketing" name="Magazine mailed to visitor home" sourceRef="Task_marketing_request" targetRef="EndEvent_marketing_done"/>

  </bpmn:process>

  <!-- Bank Process -->
  <bpmn:process id="Process_bank">
    <bpmn:startEvent id="StartEvent_bank_process">
      <bpmn:name>Receive payment request</bpmn:name>
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_30_validate_payment</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_bank_process">
      <bpmn:name>Process payment information and validate account details</bpmn:name>
      <bpmn:incoming>SequenceFlow_30_validate_payment</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_31_charge_account</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="ExclusiveGateway_bank_validation">
      <bpmn:name>All payment details correct?</bpmn:name>
      <bpmn:incoming>SequenceFlow_31_charge_account</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_32_confirm_payment</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_bank_charge">
      <bpmn:name>Charge payment to user's account</bpmn:name>
      <bpmn:incoming>SequenceFlow_32_confirm_payment</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_33_send_confirmation</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndEvent_bank_done">
      <bpmn:name>Billing transaction complete</bpmn:name>
      <bpmn:incoming>SequenceFlow_34_end_bank</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="SequenceFlow_30_validate_payment" sourceRef="StartEvent_bank_process" targetRef="Task_bank_process"/>
    <bpmn:sequenceFlow id="SequenceFlow_31_charge_account" name="Validate payment details" sourceRef="Task_bank_process" targetRef="ExclusiveGateway_bank_validation"/>
    <bpmn:sequenceFlow id="SequenceFlow_32_confirm_payment" name="Yes - All correct" sourceRef="ExclusiveGateway_bank_validation" targetRef="Task_bank_charge"/>
    <bpmn:intermediateCatchEvent id="IntermediateCatchPaymentConfirmed_Bank">
      <bpmn:name>Send payment confirmation to ZooClub</bpmn:name>
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>SequenceFlow_35_confirm_to_zoo</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

  </bpmn:process>

</bpmn:definitions>