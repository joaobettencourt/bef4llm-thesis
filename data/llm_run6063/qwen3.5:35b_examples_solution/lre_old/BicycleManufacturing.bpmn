<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Company Manufacturing Customized Bicycles" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_SalesDepartment" name="Sales Department">
        <bpmn:flowNodeRef>StartEvent_ReceiveOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_AcceptRejectOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_DecideAcceptance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_ShipBicycleToCustomer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ProcessFinished</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Storehouse" name="Storehouse">
        <bpmn:flowNodeRef>UserTask_InformDepartments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_StartProcessing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_CheckPartAvailability</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_ProcessPartList</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_ReservePart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_BackOrderPart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_CheckAllPartsProcessed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Engineering" name="Engineering Department">
        <bpmn:flowNodeRef>UserTask_PrepareAssembling</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_AssembleBicycle</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_ReceiveOrder" name="Receive order">
      <bpmn:outgoing>SequenceFlow_StartToAcceptReject</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- User Task: Accept/Reject Order -->
    <bpmn:userTask id="UserTask_AcceptRejectOrder" name="Accept or reject order">
      <bpmn:incoming>SequenceFlow_StartToAcceptReject</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToDecisionGateway</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Exclusive Gateway for Accept/Reject Decision -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_DecideAcceptance" name="Accept order?">
      <bpmn:incoming>SequenceFlow_ToDecisionGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RejectOrder</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_AcceptOrder</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event for Rejected Order -->
    <bpmn:endEvent id="EndEvent_Reject" name="Process finished">
      <bpmn:incoming>SequenceFlow_RejectOrder</bpmn:incoming>
    </bpmn:endEvent>

    <!-- User Task: Inform Departments (after acceptance) -->
    <bpmn:userTask id="UserTask_InformDepartments" name="Inform storehouse and engineering department">
      <bpmn:incoming>SequenceFlow_AcceptOrder</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToParallelSplit</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel Gateway to split into Storehouse and Engineering -->
    <bpmn:parallelGateway id="ParallelGateway_StartProcessing" name="">
      <bpmn:incoming>SequenceFlow_ToParallelSplit</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StorehouseProcess</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_EngineeringPrepare</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Storehouse Lane - Process Part List -->
    <bpmn:userTask id="UserTask_ProcessPartList" name="Process part list">
      <bpmn:incoming>SequenceFlow_StorehouseProcess</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckAvailability</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Exclusive Gateway for Part Availability Check -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_CheckPartAvailability" name="Available in-house?">
      <bpmn:incoming>SequenceFlow_CheckAvailability</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReservePath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_BackOrderPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- User Task: Reserve Part -->
    <bpmn:userTask id="UserTask_ReservePart" name="Reserve part">
      <bpmn:incoming>SequenceFlow_ReservePath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToCheckAllPartsProcessed</bpmn:outgoing>
    </bpmn:userTask>

    <!-- User Task: Back-order Part -->
    <bpmn:userTask id="UserTask_BackOrderPart" name="Back-order part">
      <bpmn:incoming>SequenceFlow_BackOrderPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToCheckAllPartsProcessed</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Exclusive Gateway to check if all parts processed -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_CheckAllPartsProcessed" name="Any part left unchecked?">
      <bpmn:incoming>SequenceFlow_ToCheckAllPartsProcessed</bpmn:incoming>
      <bpmn:outgoing>SequenceLoopBackToProcessPartList</bpmn:outgoing>
      <bpmn:outgoing>SequenceStorehouseComplete</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Engineering Lane - Prepare Assembling -->
    <bpmn:userTask id="UserTask_PrepareAssembling" name="Prepare for assembling">
      <bpmn:incoming>SequenceFlow_EngineeringPrepare</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToAssemblyJoin</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel Gateway to join Storehouse and Engineering -->
    <bpmn:parallelGateway id="ParallelGateway_AssemblyReady" name="">
      <bpmn:incoming>SequenceStorehouseComplete</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ToAssemblyJoin</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StartAssembling</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- User Task: Assemble Bicycle -->
    <bpmn:userTask id="UserTask_AssembleBicycle" name="Assemble bicycle">
      <bpmn:incoming>SequenceFlow_StartAssembling</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToShipOrder</bpmn:outgoing>
    </bpmn:userTask>

    <!-- User Task: Ship Bicycle to Customer -->
    <bpmn:userTask id="UserTask_ShipBicycleToCustomer" name="Ship bicycle to customer">
      <bpmn:incoming>SequenceFlow_ToShipOrder</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FinalEndEvent</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_ProcessFinished" name="Process finished">
      <bpmn:incoming>SequenceFlow_FinalEndEvent</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToAcceptReject" sourceRef="StartEvent_ReceiveOrder" targetRef="UserTask_AcceptRejectOrder"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ToDecisionGateway" sourceRef="UserTask_AcceptRejectOrder" targetRef="ExclusiveGateway_DecideAcceptance"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_RejectOrder" name="No - Reject order" sourceRef="ExclusiveGateway_DecideAcceptance" targetRef="EndEvent_Reject"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_AcceptOrder" name="Yes - Accept order" sourceRef="ExclusiveGateway_DecideAcceptance" targetRef="UserTask_InformDepartments"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ToParallelSplit" sourceRef="UserTask_InformDepartments" targetRef="ParallelGateway_StartProcessing"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_StorehouseProcess" name="" sourceRef="ParallelGateway_StartProcessing" targetRef="UserTask_ProcessPartList"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_EngineeringPrepare" name="" sourceRef="ParallelGateway_StartProcessing" targetRef="UserTask_PrepareAssembling"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_CheckAvailability" sourceRef="UserTask_ProcessPartList" targetRef="ExclusiveGateway_CheckPartAvailability"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ReservePath" name="Yes - Available in-house" sourceRef="ExclusiveGateway_CheckPartAvailability" targetRef="UserTask_ReservePart"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_BackOrderPath" name="No - Not available" sourceRef="ExclusiveGateway_CheckPartAvailability" targetRef="UserTask_BackOrderPart"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ToCheckAllPartsProcessed" sourceRef="UserTask_ReservePart" targetRef="ExclusiveGateway_CheckAllPartsProcessed"/>
    
    <bpmn:sequenceFlow id="SequenceLoopBackToProcessPartList" name="" sourceRef="ExclusiveGateway_CheckAllPartsProcessed" targetRef="UserTask_ProcessPartList"/>
    
    <bpmn:sequenceFlow id="SequenceStorehouseComplete" name="No - All parts processed" sourceRef="ExclusiveGateway_CheckAllPartsProcessed" targetRef="ParallelGateway_AssemblyReady"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ToAssemblyJoin" sourceRef="UserTask_PrepareAssembling" targetRef="ParallelGateway_AssemblyReady"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_StartAssembling" name="" sourceRef="ParallelGateway_AssemblyReady" targetRef="UserTask_AssembleBicycle"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ToShipOrder" sourceRef="UserTask_AssembleBicycle" targetRef="UserTask_ShipBicycleToCustomer"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_FinalEndEvent" name="" sourceRef="UserTask_ShipBicycleToCustomer" targetRef="EndEvent_ProcessFinished"/>

  </bpmn:process>
</bpmn:definitions>