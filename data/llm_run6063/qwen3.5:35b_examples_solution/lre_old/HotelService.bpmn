<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" 
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
                  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Room Service Process" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    
    <!-- Lane Set -->
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Manager" name="Room-Service Manager">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_TakeOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_Split</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Kitchen" name="Kitchen">
        <bpmn:flowNodeRef>UserTask_PrepareFood</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Sommelier" name="Sommelier">
        <bpmn:flowNodeRef>InclusiveGateway_AlcoholCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_FetchWine</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Waiter" name="Waiter">
        <bpmn:flowNodeRef>InclusiveGateway_NonAlcoholicCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_ReadyCart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_PrepareNonAlcoholicDrinks</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Guest calls room service">
      <bpmn:outgoing>SequenceFlow_TakeOrder</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Take down order task (Manager) -->
    <bpmn:userTask id="UserTask_TakeOrder" name="Take down guest's order">
      <bpmn:incoming>SequenceFlow_TakeOrder</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SplitParallel</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel Gateway - Split -->
    <bpmn:parallelGateway id="ParallelGateway_Split" name="Split to Kitchen, Sommelier and Waiter">
      <bpmn:incoming>SequenceFlow_SplitParallel</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToKitchen</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ToSommelier</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ToWaiter</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Kitchen Task -->
    <bpmn:userTask id="UserTask_PrepareFood" name="Prepare food">
      <bpmn:incoming>SequenceFlow_ToKitchen</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FoodReady</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Sommelier - Check if alcohol ordered -->
    <bpmn:exclusiveGateway id="InclusiveGateway_AlcoholCheck" name="Alcoholic beverages ordered">
      <bpmn:incoming>SequenceFlow_ToSommelier</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FetchWine</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sommelier Task - Fetch wine -->
    <bpmn:userTask id="UserTask_FetchWine" name="Fetch wine from cellar">
      <bpmn:incoming>SequenceFlow_FetchWine</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WineReady</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Waiter - Ready cart -->
    <bpmn:userTask id="UserTask_ReadyCart" name="Ready cart">
      <bpmn:incoming>SequenceFlow_ToWaiter</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CartReady</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Waiter - Check non-alcoholic drinks -->
    <bpmn:exclusiveGateway id="InclusiveGateway_NonAlcoholicCheck" name="Non-alcoholic drinks ordered">
      <bpmn:incoming>SequenceFlow_ToWaiter</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PrepareDrinks</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Waiter - Prepare non-alcoholic drinks -->
    <bpmn:userTask id="UserTask_PrepareNonAlcoholicDrinks" name="Prepare non-alcoholic drinks">
      <bpmn:incoming>SequenceFlow_PrepareDrinks</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DrinksReady</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel Gateway - Join -->
    <bpmn:parallelGateway id="ParallelGateway_Join" name="Wait for all items">
      <bpmn:incoming>SequenceFlow_FoodReady</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_WineReady</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_CartReady</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_DrinksReady</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToDelivery</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Delivery Task -->
    <bpmn:userTask id="UserTask_Deliver" name="Deliver to guest room">
      <bpmn:incoming>SequenceFlow_ToDelivery</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReturnToStation</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Return Task -->
    <bpmn:userTask id="UserTask_Return" name="Return to room-service station">
      <bpmn:incoming>SequenceFlow_ReturnToStation</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToBilling</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Billing Decision -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_Billing" name="Another order pending">
      <bpmn:incoming>SequenceFlow_ToBilling</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DebitAccount</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Billing Task -->
    <bpmn:userTask id="UserTask_Billing" name="Debit guest account">
      <bpmn:incoming>SequenceFlow_DebitAccount</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToEndEvent</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_1" name="Order completed">
      <bpmn:incoming>SequenceFlow_ToEndEvent</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_TakeOrder" sourceRef="StartEvent_1" targetRef="UserTask_TakeOrder"/>
    <bpmn:sequenceFlow id="SequenceFlow_SplitParallel" sourceRef="UserTask_TakeOrder" targetRef="ParallelGateway_Split"/>
    <bpmn:sequenceFlow id="SequenceFlow_ToKitchen" name="Submit order ticket to kitchen" sourceRef="ParallelGateway_Split" targetRef="UserTask_PrepareFood"/>
    <bpmn:sequenceFlow id="SequenceFlow_ToSommelier" name="Give order to sommelier" sourceRef="ParallelGateway_Split" targetRef="InclusiveGateway_AlcoholCheck"/>
    <bpmn:sequenceFlow id="SequenceFlow_ToWaiter" name="Assign order to waiter" sourceRef="ParallelGateway_Split" targetRef="UserTask_ReadyCart"/>
    <bpmn:sequenceFlow id="SequenceFlow_FoodReady" sourceRef="UserTask_PrepareFood" targetRef="ParallelGateway_Join"/>
    <bpmn:sequenceFlow id="SequenceFlow_WineReady" name="Alcohol ordered 80 percent" sourceRef="InclusiveGateway_AlcoholCheck" targetRef="UserTask_FetchWine"/>
    <bpmn:sequenceFlow id="SequenceFlow_CartReady" sourceRef="UserTask_ReadyCart" targetRef="ParallelGateway_Join"/>
    <bpmn:sequenceFlow id="SequenceFlow_PrepareDrinks" name="Non-alcoholic drinks ordered" sourceRef="InclusiveGateway_NonAlcoholicCheck" targetRef="UserTask_PrepareNonAlcoholicDrinks"/>
    <bpmn:sequenceFlow id="SequenceFlow_DrinksReady" sourceRef="UserTask_PrepareNonAlcoholicDrinks" targetRef="ParallelGateway_Join"/>
    <bpmn:sequenceFlow id="SequenceFlow_ToDelivery" name="All items ready" sourceRef="ParallelGateway_Join" targetRef="UserTask_Deliver"/>
    <bpmn:sequenceFlow id="SequenceFlow_ReturnToStation" sourceRef="UserTask_Deliver" targetRef="UserTask_Return"/>
    <bpmn:sequenceFlow id="SequenceFlow_ToBilling" name="Return to station" sourceRef="UserTask_Return" targetRef="ExclusiveGateway_Billing"/>
    <bpmn:sequenceFlow id="SequenceFlow_DebitAccount" name="Debit account now or wait" sourceRef="ExclusiveGateway_Billing" targetRef="UserTask_Billing"/>
    <bpmn:sequenceFlow id="SequenceFlow_ToEndEvent" sourceRef="UserTask_Billing" targetRef="EndEvent_1"/>

  </bpmn:process>
</bpmn:definitions>