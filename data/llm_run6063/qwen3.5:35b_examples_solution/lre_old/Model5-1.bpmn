<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_0" name="Loan Approval Process" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:startEvent id="StartMessageEvent_0" name="Customer loan request received">
      <bpmn:outgoing>SequenceFlow_0</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_0" name="Invoke risk assessment Web service">
      <bpmn:incoming>SequenceFlow_0</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="ExclusiveGateway_0" name="Risk assessment result">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="EndMessageEvent_0" name="Loan approved">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:userTask id="Task_1" name="Invoke approver Web service">
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndMessageEvent_1" name="Feedback from approver">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndMessageEvent_2" name="Loan denied (high risk)">
      <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow_0" sourceRef="StartMessageEvent_0" targetRef="Task_0">
      <bpmn:name>Receive request</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="Task_0" targetRef="ExclusiveGateway_0"/>

    <bpmn:sequenceFlow id="SequenceFlow_2" name="Approve" sourceRef="ExclusiveGateway_0" targetRef="EndMessageEvent_0">
      <bpmn:name>Small loan AND low risk</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_3" name="Further review required" sourceRef="ExclusiveGateway_0" targetRef="Task_1">
      <bpmn:name>Needs review OR $10,000+</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="Task_1" targetRef="EndMessageEvent_1"/>

    <bpmn:sequenceFlow id="SequenceFlow_5" name="Deny" sourceRef="ExclusiveGateway_0" targetRef="EndMessageEvent_2">
      <bpmn:name>High risk</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>