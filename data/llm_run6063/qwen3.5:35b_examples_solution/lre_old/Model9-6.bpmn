<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1kp8vzq7xw3f2r5y4h6t9u1l">
    <bpmn:participant id="Participant_0pymj5d" name="Design Process" processRef="Process_1cqwerym"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1cqwerym" isExecutable="true">
    <!-- Global Signals -->
    <bpmn:signal id="Signal_ElecDone" name="Electrical Design Complete" />
    <bpmn:signal id="Signal_PhysDone" name="Physical Design Complete" />

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:name>Design Cycle Initiated</bpmn:name>
      <bpmn:outgoing>SequenceFlow_LocateDesigns</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Initial Task -->
    <bpmn:userTask id="Task_LocateDesigns" name="Locate and distribute existing designs">
      <bpmn:name>Locate and distribute existing designs</bpmn:name>
      <bpmn:incoming>SequenceFlow_RestartCycle</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_LocateDesigns</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel Split -->
    <bpmn:parallelGateway id="ParallelGateway_Split">
      <bpmn:name>Synchronize Design Branches</bpmn:name>
      <bpmn:incoming>SequenceFlow_LocateDesigns</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ElecBranch</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PhysBranch</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Electrical Branch -->
    <bpmn:userTask id="Task_ReviewElec" name="Electrical Design Review">
      <bpmn:name>Electrical Design Review (Create Update Plan)</bpmn:name>
      <bpmn:incoming>SequenceFlow_ElecRestart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReviseElec</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_ReviseElec" name="Electrical Design Revision">
      <bpmn:name>Revised Electrical Design Creation</bpmn:name>
      <bpmn:incoming>SequenceFlow_ReviseElec</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TestElec</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Boundary Event for Electrical Interruption -->
    <bpmn:boundaryEvent id="Boundary_ElecInterrupt" attachedToRef="Task_ReviseElec">
      <bpmn:name>Elec Interrupted by Phys</bpmn:name>
      <bpmn:outgoing>SequenceFlow_BoundaryE</bpmn:outgoing>
      <bpmn:signalEventDefinition ref="Signal_PhysDone" />
    </bpmn:boundaryEvent>

    <!-- Electrical Test -->
    <bpmn:userTask id="Task_TestElec" name="Test Electrical Design">
      <bpmn:name>Electrical Design Testing</bpmn:name>
      <bpmn:incoming>SequenceFlow_TestElec</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GatewayPassElec</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Electrical Decision Gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_PassElec" name="Electrical Design OK?">
      <bpmn:name>Electrical Design OK?</bpmn:name>
      <bpmn:incoming>SequenceFlow_GatewayPassElec</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SignalE</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ElecRestartLoop</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Physical Branch (Mirror) -->
    <bpmn:userTask id="Task_ReviewPhys" name="Physical Design Review">
      <bpmn:name>Physical Design Review (Create Update Plan)</bpmn:name>
      <bpmn:incoming>SequenceFlow_PhysRestart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RevisePhys</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_RevisePhys" name="Physical Design Revision">
      <bpmn:name>Revised Physical Design Creation</bpmn:name>
      <bpmn:incoming>SequenceFlow_RevisePhys</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TestPhys</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Boundary Event for Physical Interruption -->
    <bpmn:boundaryEvent id="Boundary_PhysInterrupt" attachedToRef="Task_RevisePhys">
      <bpmn:name>Phys Interrupted by Elec</bpmn:name>
      <bpmn:outgoing>SequenceFlow_BoundaryP</bpmn:outgoing>
      <bpmn:signalEventDefinition ref="Signal_ElecDone" />
    </bpmn:boundaryEvent>

    <!-- Physical Test -->
    <bpmn:userTask id="Task_TestPhys" name="Test Physical Design">
      <bpmn:name>Physical Design Testing</bpmn:name>
      <bpmn:incoming>SequenceFlow_TestPhys</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GatewayPassPhys</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Physical Decision Gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_PassPhys" name="Physical Design OK?">
      <bpmn:name>Physical Design OK?</bpmn:name>
      <bpmn:incoming>SequenceFlow_GatewayPassPhys</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SignalP</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PhysRestartLoop</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Signal Throw Events (Triggered on Success) -->
    <bpmn:intermediateThrowEvent id="Intermediate_ElecDone" name="Signal Elec Done">
      <bpmn:name>Elec Design Complete</bpmn:name>
      <bpmn:incoming>SequenceFlow_SignalE</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SignalEOut</bpmn:outgoing>
      <bpmn:signalEventDefinition ref="Signal_ElecDone" />
    </bpmn:intermediateThrowEvent>

    <bpmn:intermediateThrowEvent id="Intermediate_PhysDone" name="Signal Phys Done">
      <bpmn:name>Phys Design Complete</bpmn:name>
      <bpmn:incoming>SequenceFlow_SignalP</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SignalPOut</bpmn:outgoing>
      <bpmn:signalEventDefinition ref="Signal_PhysDone" />
    </bpmn:intermediateThrowEvent>

    <!-- Parallel Gateway for Synchronization -->
    <bpmn:parallelGateway id="ParallelGateway_Join">
      <bpmn:name>Wait for Both Designs</bpmn:name>
      <bpmn:incoming>SequenceFlow_SignalEOut</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_SignalPOut</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CombinedDesignTask</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Combined Design Task -->
    <bpmn:userTask id="Task_Combined" name="Combine and Test Designs">
      <bpmn:name>Combined Design Testing</bpmn:name>
      <bpmn:incoming>SequenceFlow_CombinedDesignTask</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GatewayComplete</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Final Decision -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_Complete" name="Combined Design OK?">
      <bpmn:name>Combined Design OK?</bpmn:name>
      <bpmn:incoming>SequenceFlow_GatewayComplete</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndProcess</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RestartCycle</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Complete" name="Design Complete">
      <bpmn:name>Design Complete</bpmn:name>
      <bpmn:incoming>SequenceFlow_EndProcess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows (Electrical) -->
    <bpmn:sequenceFlow id="SequenceFlow_LocateDesigns" sourceRef="StartEvent_1" targetRef="Task_LocateDesigns">
      <bpmn:name>Initiate Cycle</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Split -->
    <bpmn:sequenceFlow id="SequenceFlow_ElecBranch" sourceRef="ParallelGateway_Split" targetRef="Task_ReviewElec">
      <bpmn:name>To Electrical Dept</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_PhysBranch" sourceRef="ParallelGateway_Split" targetRef="Task_ReviewPhys">
      <bpmn:name>To Physical Dept</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Electrical Loop -->
    <bpmn:sequenceFlow id="SequenceFlow_ElecRestartLoop" sourceRef="ExclusiveGateway_PassElec" targetRef="Task_ReviewElec">
      <bpmn:name>No - Review Again</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Electrical Restart from Boundary -->
    <bpmn:sequenceFlow id="SequenceFlow_BoundaryE" sourceRef="Boundary_ElecInterrupt" targetRef="Task_ReviewElec">
      <bpmn:name>Elec Interrupted</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Electrical Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_ReviseElec" sourceRef="Task_ReviewElec" targetRef="Task_ReviseElec">
      <bpmn:name>Create Plan</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Electrical Test Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_TestElec" sourceRef="Task_ReviseElec" targetRef="Task_TestElec">
      <bpmn:name>Design Ready for Testing</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Electrical Signal & Join Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_SignalE" sourceRef="ExclusiveGateway_PassElec" targetRef="Intermediate_ElecDone">
      <bpmn:name>Yes - Design OK</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Intermediate Throw to Signal -->
    <bpmn:sequenceFlow id="SequenceFlow_SignalEOut" sourceRef="Intermediate_ElecDone" targetRef="ParallelGateway_Join">
      <bpmn:name>Elec Done</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Physical Loop -->
    <bpmn:sequenceFlow id="SequenceFlow_PhysRestartLoop" sourceRef="ExclusiveGateway_PassPhys" targetRef="Task_ReviewPhys">
      <bpmn:name>No - Review Again</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Physical Restart from Boundary -->
    <bpmn:sequenceFlow id="SequenceFlow_BoundaryP" sourceRef="Boundary_PhysInterrupt" targetRef="Task_ReviewPhys">
      <bpmn:name>Phys Interrupted</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Physical Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_RevisePhys" sourceRef="Task_ReviewPhys" targetRef="Task_RevisePhys">
      <bpmn:name>Create Plan</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Physical Test Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_TestPhys" sourceRef="Task_RevisePhys" targetRef="Task_TestPhys">
      <bpmn:name>Design Ready for Testing</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Physical Signal & Join Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_SignalP" sourceRef="ExclusiveGateway_PassPhys" targetRef="Intermediate_PhysDone">
      <bpmn:name>Yes - Design OK</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Intermediate Throw to Signal -->
    <bpmn:sequenceFlow id="SequenceFlow_SignalPOut" sourceRef="Intermediate_PhysDone" targetRef="ParallelGateway_Join">
      <bpmn:name>Phys Done</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Combined Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_CombinedDesignTask" sourceRef="ParallelGateway_Join" targetRef="Task_Combined">
      <bpmn:name>Both Designs Revised</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Final Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_GatewayComplete" sourceRef="Task_Combined" targetRef="ExclusiveGateway_Complete">
      <bpmn:name>Combined Test Result</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- End Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_EndProcess" sourceRef="ExclusiveGateway_Complete" targetRef="EndEvent_Complete">
      <bpmn:name>Pass - Complete</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Restart Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_RestartCycle" sourceRef="ExclusiveGateway_Complete" targetRef="Task_LocateDesigns">
      <bpmn:name>Fail - Cycle</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>