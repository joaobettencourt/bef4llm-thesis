<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_MSPN_GO">
    <bpmn:participant id="Participant_MSPN" name="MSPN" processRef="Process_MSPN"/>
    <bpmn:participant id="Participant_GO" name="GO" processRef="Process_GO"/>
    <bpmn:messageFlow id="MessageFlow_Registration">
      <bpmn:name>MSPN Registration</bpmn:name>
      <bpmn:sourceRef>IntermediateThrowEvent_Register_MSPN</bpmn:sourceRef>
      <bpmn:targetRef>StartCatching_Event_GO</bpmn:targetRef>
    </bpmn:messageFlow>
  </bpmn:collaboration>

  <bpmn:process id="Process_MSPN" isExecutable="false">
    <bpmn:startEvent id="Start_None_MSPN">
      <bpmn:name>MSPN Registration</bpmn:name>
      <bpmn:outgoing>SequenceFlow_Start_Task1_MSPN</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="UserTask_Register_MSPN" name="Register measurement">
      <bpmn:incoming>SequenceFlow_Start_Task1_MSPN</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Task_ThrowMessage_MSPN</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="End_None_MSPN">
      <bpmn:name>MSPN Registration Complete</bpmn:name>
      <bpmn:incoming>SequenceFlow_Catch_End_MSPN</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:intermediateThrowEvent id="IntermediateThrowEvent_Register_MSPN">
      <bpmn:messageRef>Message_Registration</bpmn:messageRef>
      <bpmn:incoming>SequenceFlow_Task_ThrowMessage_MSPN</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Throw_Catch_MSPN_GO</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <bpmn:message id="Message_Registration" name="MSPN Registration"/>

    <bpmn:sequenceFlow id="SequenceFlow_Start_Task1_MSPN">
      <bpmn:name>MSPN Start</bpmn:name>
      <bpmn:sourceRef>Start_None_MSPN</bpmn:sourceRef>
      <bpmn:targetRef>UserTask_Register_MSPN</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_Task_ThrowMessage_MSPN">
      <bpmn:name>Send Registration</bpmn:name>
      <bpmn:sourceRef>UserTask_Register_MSPN</bpmn:sourceRef>
      <bpmn:targetRef>IntermediateThrowEvent_Register_MSPN</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_Catch_End_MSPN">
      <bpmn:name>Catch End</bpmn:name>
      <bpmn:sourceRef>StartCatching_Event_GO</bpmn:sourceRef>
      <bpmn:targetRef>End_None_MSPN</bpmn:targetRef>
    </bpmn:sequenceFlow>

  </bpmn:process>

  <bpmn:process id="Process_GO" isExecutable="false">
    <bpmn:startEvent id="StartCatching_Event_GO">
      <bpmn:messageRef>Message_Registration</bpmn:messageRef>
      <bpmn:name>Receive registration</bpmn:name>
      <bpmn:outgoing>SequenceFlow_Start_Task2_GO</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="UserTask_Examine_GO" name="Examine application">
      <bpmn:incoming>SequenceFlow_Start_Task2_GO</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Exam_Gateway_GO</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="End_Rejected">
      <bpmn:name>Application Rejected</bpmn:name>
      <bpmn:incoming>SequenceFlow_Reject_End_GO</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="End_Complete">
      <bpmn:name>MSPN Assignment Complete</bpmn:name>
      <bpmn:incoming>SequenceFlow_SP_End_GO</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:userTask id="UserTask_Reject" name="Reject application">
      <bpmn:incoming>SequenceFlow_Reject_Path_GO</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Reject_End_GO</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="ExclusiveGateway_Decision">
      <bpmn:name>Confirm application?</bpmn:name>
      <bpmn:incoming>SequenceFlow_Exam_Gateway_GO</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Reject_Path_GO</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_Confirm_Path_GO</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="UserTask_Confirm" name="Confirm application">
      <bpmn:incoming>SequenceFlow_Confirm_Path_GO</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Confirm_Assign_GO</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="UserTask_Assign" name="Assign MSPN">
      <bpmn:incoming>SequenceFlow_Confirm_Assign_GO</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Assign_MSPO_GO</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="UserTask_Inform_MSPO" name="Inform MSPO about assignment">
      <bpmn:incoming>SequenceFlow_Assign_MSPO_GO</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MSPO_MPO_GO</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="UserTask_Inform_MPO" name="Inform MPO about assignment">
      <bpmn:incoming>SequenceFlow_MSPO_MPO_GO</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MPO_SP_GO</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="UserTask_Inform_SP" name="Inform SP about assignment">
      <bpmn:incoming>SequenceFlow_MPO_SP_GO</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SP_End_GO</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:message id="Message_Registration" name="MSPN Registration"/>

    <bpmn:sequenceFlow id="SequenceFlow_Start_Task2_GO">
      <bpmn:name>Receive registration</bpmn:name>
      <bpmn:sourceRef>StartCatching_Event_GO</bpmn:sourceRef>
      <bpmn:targetRef>UserTask_Examine_GO</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_Exam_Gateway_GO">
      <bpmn:name>Examination Complete</bpmn:name>
      <bpmn:sourceRef>UserTask_Examine_GO</bpmn:sourceRef>
      <bpmn:targetRef>ExclusiveGateway_Decision</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_Reject_Path_GO">
      <bpmn:name>No - Reject</bpmn:name>
      <bpmn:sourceRef>ExclusiveGateway_Decision</bpmn:sourceRef>
      <bpmn:targetRef>UserTask_Reject</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_Reject_End_GO">
      <bpmn:name>Reject End</bpmn:name>
      <bpmn:sourceRef>UserTask_Reject</bpmn:sourceRef>
      <bpmn:targetRef>End_Rejected</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_Confirm_Path_GO">
      <bpmn:name>Yes - Confirm</bpmn:name>
      <bpmn:sourceRef>ExclusiveGateway_Decision</bpmn:sourceRef>
      <bpmn:targetRef>UserTask_Confirm</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_Confirm_Assign_GO">
      <bpmn:name>Confirm to Assign</bpmn:name>
      <bpmn:sourceRef>UserTask_Confirm</bpmn:sourceRef>
      <bpmn:targetRef>UserTask_Assign</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_Assign_MSPO_GO">
      <bpmn:name>Assign to Inform MSPO</bpmn:name>
      <bpmn:sourceRef>UserTask_Assign</bpmn:sourceRef>
      <bpmn:targetRef>UserTask_Inform_MSPO</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_MSPO_MPO_GO">
      <bpmn:name>Informs MSPO to MPO</bpmn:name>
      <bpmn:sourceRef>UserTask_Inform_MSPO</bpmn:sourceRef>
      <bpmn:targetRef>UserTask_Inform_MPO</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_MPO_SP_GO">
      <bpmn:name>Informs MPO to SP</bpmn:name>
      <bpmn:sourceRef>UserTask_Inform_MPO</bpmn:sourceRef>
      <bpmn:targetRef>UserTask_Inform_SP</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_SP_End_GO">
      <bpmn:name>Informs SP to End</bpmn:name>
      <bpmn:sourceRef>UserTask_Inform_SP</bpmn:sourceRef>
      <bpmn:targetRef>End_Complete</bpmn:targetRef>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>