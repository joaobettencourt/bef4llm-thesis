<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_0" name="Organization" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_0" name="Head of the Functional Department">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateCatchMessageEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateCatchMessageEvent_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Personnel requirements detected">
      <bpmn:outgoing>SequenceFlow_0</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Report vacancy to Personnel Department -->
    <bpmn:task id="Task_1" name="Report vacancy to Personnel Department">
      <bpmn:incoming>SequenceFlow_0</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Catching Event: Wait for job description -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchMessageEvent_1" name="Wait for job description">
      <bpmn:messageRef>JobDescription</bpmn:messageRef>
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task 2: Review job description -->
    <bpmn:task id="Task_2" name="Review job description">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway 1: Decision on corrections needed -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_1" name="Corrections required?">
      <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 3: Ask for corrections -->
    <bpmn:task id="Task_3" name="Ask for corrections">
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_8</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Catching Event 2: Wait for clarifications -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchMessageEvent_2" name="Wait for HR questions">
      <bpmn:messageRef>ClarificationRequest</bpmn:messageRef>
      <bpmn:incoming>SequenceFlow_9</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task 4: Available for clarifications -->
    <bpmn:userTask id="UserTask_1" name="Available for clarifications">
      <bpmn:incoming>SequenceFlow_10</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_11</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Exclusive Gateway 2: Decision on approval -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_2" name="OK?">
      <bpmn:incoming>SequenceFlow_7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_12</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_1" name="Job description approved">
      <bpmn:incoming>SequenceFlow_14</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_0" sourceRef="StartEvent_1" targetRef="Task_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_2" name="Wait for job description" sourceRef="ExclusiveGateway_2" targetRef="IntermediateCatchMessageEvent_1">
      <bpmn:name>Yes</bpmn:name>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_3" name="Receive job description" sourceRef="IntermediateCatchMessageEvent_1" targetRef="Task_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_4" name="Review job description" sourceRef="Task_2" targetRef="ExclusiveGateway_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_5" name="Corrections required?" sourceRef="ExclusiveGateway_1" targetRef="Task_3">
      <bpmn:name>Yes</bpmn:name>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_6" name="Ask for corrections" sourceRef="Task_3" targetRef="ExclusiveGateway_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_7" name="OK?" sourceRef="ExclusiveGateway_1" targetRef="UserTask_1">
      <bpmn:name>No</bpmn:name>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_8" name="Wait for HR questions" sourceRef="UserTask_1" targetRef="ExclusiveGateway_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_9" name="Available for clarifications" sourceRef="IntermediateCatchMessageEvent_2" targetRef="ExclusiveGateway_1">
      <bpmn:name>Yes</bpmn:name>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_10" name="OK?" sourceRef="UserTask_1" targetRef="ExclusiveGateway_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_11" name="Approve job description" sourceRef="ExclusiveGateway_2" targetRef="EndEvent_1">
      <bpmn:name>Yes</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>