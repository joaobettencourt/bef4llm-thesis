<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_MSPO" name="MSPO" processRef="Process_MSPO"/>
    <bpmn:participant id="Participant_GO" name="GO" processRef="Process_GO"/>
    <bpmn:messageFlow id="MessageFlow_DeregistrationRequest" sourceRef="Task_MSPO_Deregister" targetRef="Event_GO_VerifyDeregistration"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_MSPO" isExecutable="false">
    <bpmn:startEvent id="Start_MSPO_1">
      <bpmn:name>Deregister at GO</bpmn:name>
      <bpmn:outgoing>SequenceFlow_MSPO_01</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_MSPO_Deregister" name="Deregister">
      <bpmn:name>Deregister at GO</bpmn:name>
      <bpmn:incoming>SequenceFlow_MSPO_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MSPO_02</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="End_MSPO_Confirmed" name="Deregistration Confirmed">
      <bpmn:name>Deregistration Confirmed</bpmn:name>
      <bpmn:incoming>SequenceFlow_MSPO_05</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="End_MSPO_Rejected" name="Deregistration Rejected">
      <bpmn:name>Deregistration Rejected</bpmn:name>
      <bpmn:incoming>SequenceFlow_MSPO_04</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:message id="Msg_DeregistrationRequest" name="Deregistration Request"/>

    <bpmn:sequenceFlow id="SequenceFlow_MSPO_01" sourceRef="Start_MSPO_1" targetRef="Task_MSPO_Deregister"/>
    <bpmn:sequenceFlow id="SequenceFlow_MSPO_02" sourceRef="Task_MSPO_Deregister" targetRef="End_MSPO_Confirmed">
      <bpmn:name>Confirmed</bpmn:name>
    </bpmn:sequenceFlow>
  </bpmn:process>

  <bpmn:process id="Process_GO" isExecutable="false">
    <bpmn:startEvent id="StartMessage_GO_VerifyDeregistration" name="Receive Deregistration Request">
      <bpmn:name>Deregister at GO</bpmn:name>
      <bpmn:messageRef>Msg_DeregistrationRequest</bpmn:messageRef>
      <bpmn:outgoing>SequenceFlow_GO_01</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_GO_VerifyDeregistration" name="Verify Deregistration">
      <bpmn:name>Verify deregistration of MSPO</bpmn:name>
      <bpmn:incoming>SequenceFlow_GO_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GO_02</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="ExclusiveGateway_GO_Decision" name="Decision">
      <bpmn:name>Deregistration Valid?</bpmn:name>
      <bpmn:incoming>SequenceFlow_GO_02</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GO_03</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_GO_04</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_GO_Reject" name="Reject Deregistration">
      <bpmn:name>Reject deregistration of MSPO</bpmn:name>
      <bpmn:incoming>SequenceFlow_GO_04</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GO_05</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="End_GO_Rejected" name="Deregistration Rejected">
      <bpmn:name>Deregistration Rejected</bpmn:name>
      <bpmn:incoming>SequenceFlow_GO_05</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:userTask id="Task_GO_Confirm" name="Confirm Deregistration">
      <bpmn:name>Preliminarily confirm deregistration of MSPO</bpmn:name>
      <bpmn:incoming>SequenceFlow_GO_03</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GO_06</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_GO_AssignMSP" name="Assign GO as MSP">
      <bpmn:name>GO assigns himself as MSP</bpmn:name>
      <bpmn:incoming>SequenceFlow_GO_06</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GO_07</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:parallelGateway id="ParallelGateway_GO_Notify" name="Notify Parties">
      <bpmn:name>Inform All Parties</bpmn:name>
      <bpmn:incoming>SequenceFlow_GO_07</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GO_08</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_GO_09</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_GO_10</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:userTask id="Task_GO_InformMSPO" name="Inform MSPO">
      <bpmn:name>Informs the MSPO about end of assignment and beginning of GO's assignment</bpmn:name>
      <bpmn:incoming>SequenceFlow_GO_08</bpmn:incoming>
    </bpmn:userTask>

    <bpmn:userTask id="Task_GO_InformMPO" name="Inform MPO">
      <bpmn:name>Informs the MPO about assignment of GO</bpmn:name>
      <bpmn:incoming>SequenceFlow_GO_09</bpmn:incoming>
    </bpmn:userTask>

    <bpmn:userTask id="Task_GO_InformSP" name="Inform SP">
      <bpmn:name>Informs the SP about assignment of GO</bpmn:name>
      <bpmn:incoming>SequenceFlow_GO_10</bpmn:incoming>
    </bpmn:userTask>

    <bpmn:endEvent id="End_GO_Completed" name="Process Completed">
      <bpmn:name>All notifications sent successfully</bpmn:name>
      <bpmn:incoming>SequenceFlow_GO_11</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:message id="Msg_DeregistrationRequest" name="Deregistration Request"/>

    <bpmn:sequenceFlow id="SequenceFlow_GO_01" sourceRef="StartMessage_GO_VerifyDeregistration" targetRef="Task_GO_VerifyDeregistration"/>
    <bpmn:sequenceFlow id="SequenceFlow_GO_02" sourceRef="Task_GO_VerifyDeregistration" targetRef="ExclusiveGateway_GO_Decision"/>
    <bpmn:sequenceFlow id="SequenceFlow_GO_03" name="Confirmed">
      <bpmn:name>Yes - Confirm</bpmn:name>
      <bpmn:sourceRef>ExclusiveGateway_GO_Decision</bpmn:sourceRef>
      <bpmn:targetRef>Task_GO_Confirm</bpmn:targetRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_GO_04" name="Rejected">
      <bpmn:name>No - Reject</bpmn:name>
      <bpmn:sourceRef>ExclusiveGateway_GO_Decision</bpmn:sourceRef>
      <bpmn:targetRef>Task_GO_Reject</bpmn:targetRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_GO_05" sourceRef="Task_GO_Reject" targetRef="End_GO_Rejected"/>
    <bpmn:sequenceFlow id="SequenceFlow_GO_06" sourceRef="Task_GO_Confirm" targetRef="Task_GO_AssignMSP"/>
    <bpmn:sequenceFlow id="SequenceFlow_GO_07" sourceRef="Task_GO_AssignMSP" targetRef="ParallelGateway_GO_Notify"/>
    <bpmn:sequenceFlow id="SequenceFlow_GO_08" name="Inform MSPO">
      <bpmn:name>MSPO</bpmn:name>
      <bpmn:sourceRef>ParallelGateway_GO_Notify</bpmn:sourceRef>
      <bpmn:targetRef>Task_GO_InformMSPO</bpmn:targetRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_GO_09" name="Inform MPO">
      <bpmn:name>MPO</bpmn:name>
      <bpmn:sourceRef>ParallelGateway_GO_Notify</bpmn:sourceRef>
      <bpmn:targetRef>Task_GO_InformMPO</bpmn:targetRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_GO_10" name="Inform SP">
      <bpmn:name>SP</bpmn:name>
      <bpmn:sourceRef>ParallelGateway_GO_Notify</bpmn:sourceRef>
      <bpmn:targetRef>Task_GO_InformSP</bpmn:targetRef>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>