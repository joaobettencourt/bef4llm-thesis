<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                 xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" 
                 xmlns:di="http://www.omg.org/spec/DD/20100524/DI" 
                 xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" 
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
                 id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_ChangeRequest">
    <bpmn:participant id="Participant_MPO" name="MPO" processRef="Process_ChangeRequest"/>
    <bpmn:participant id="Participant_SP_PU_GO" name="SP/PU/GO" processRef="Process_SPPUGO"/>
  </bpmn:collaboration>

  <bpmn:messageFlow id="MessageFlow_1">
    <bpmn:name>Implementation Report</bpmn:name>
    <bpmn:sourceRef>Task_ReportSuccess</bpmn:sourceRef>
    <bpmn:targetElement>Participant_SP_PU_GO</bpmn:targetElement>
  </bpmn:messageFlow>

  <bpmn:messageFlow id="MessageFlow_2">
    <bpmn:name>Failure Notification</bpmn:name>
    <bpmn:sourceRef>Task_ReportFailure</bpmn:sourceRef>
    <bpmn:targetElement>Participant_SP_PU_GO</bpmn:targetElement>
  </bpmn:messageFlow>

  <bpmn:process id="Process_ChangeRequest" isExecutable="false">
    <bpmn:startEvent id="StartEvent_RequestChange" name="Change Request Initiated">
      <bpmn:outgoing>SequenceFlow_StartToReview</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_ReviewRequest" name="MPO Reviews Change Request">
      <bpmn:incoming>SequenceFlow_StartToReview</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReviewToDecision</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_Decision" name="Reject or Confirm?">
      <bpmn:incoming>SequenceFlow_ReviewToDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RejectPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ConfirmPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_RejectChange" name="MPO Rejects Change">
      <bpmn:incoming>SequenceFlow_RejectPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReviewToDecision</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_ConfirmChange" name="MPO Confirms Request">
      <bpmn:incoming>SequenceFlow_ConfirmPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConfirmToPerform</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_PerformChange" name="MPO Performs Measuring Point Change">
      <bpmn:incoming>SequenceFlow_ConfirmToPerform</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ChangeResultDecision</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_Result" name="Change Successful?">
      <bpmn:incoming>SequenceFlow_ChangeResultDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SuccessPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_FailurePath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_ReportSuccess" name="MPO Reports Implementation to SP/PU/GO">
      <bpmn:incoming>SequenceFlow_SuccessPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SuccesstoEnd</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_ReportFailure" name="MPO Notifies SP/PU/GO About Failure">
      <bpmn:incoming>SequenceFlow_FailurePath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FailtoEnd</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="End_Success" name="Change Completed">
      <bpmn:incoming>SequenceFlow_SuccesstoEnd</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="End_Failure" name="Change Failed">
      <bpmn:incoming>SequenceFlow_FailtoEnd</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow_StartToReview" sourceRef="StartEvent_RequestChange" targetRef="Task_ReviewRequest"/>

    <bpmn:sequenceFlow id="SequenceFlow_ReviewToDecision" name="Complete Review" sourceRef="Task_ReviewRequest" targetRef="Gateway_Decision"/>

    <bpmn:sequenceFlow id="SequenceFlow_RejectPath" name="Reject Change" sourceRef="Gateway_Decision" targetRef="Task_RejectChange"/>

    <bpmn:sequenceFlow id="SequenceFlow_ConfirmPath" name="Confirm Request" sourceRef="Gateway_Decision" targetRef="Task_ConfirmChange"/>

    <bpmn:sequenceFlow id="SequenceFlow_ReviewToDecision2" name="Proceed to Failure Notification" sourceRef="Task_RejectChange" targetRef="Gateway_Result"/>

    <bpmn:sequenceFlow id="SequenceFlow_ConfirmToPerform" name="Confirm and Proceed" sourceRef="Task_ConfirmChange" targetRef="Task_PerformChange"/>

    <bpmn:sequenceFlow id="SequenceFlow_ChangeResultDecision" name="Check Result" sourceRef="Task_PerformChange" targetRef="Gateway_Result"/>

    <bpmn:sequenceFlow id="SequenceFlow_SuccessPath" name="Change Successful" sourceRef="Gateway_Result" targetRef="Task_ReportSuccess"/>

    <bpmn:sequenceFlow id="SequenceFlow_FailurePath" name="Change Failed" sourceRef="Gateway_Result" targetRef="Task_ReportFailure"/>

    <bpmn:sequenceFlow id="SequenceFlow_SuccesstoEnd" name="Report Success and End" sourceRef="Task_ReportSuccess" targetRef="End_Success"/>

    <bpmn:sequenceFlow id="SequenceFlow_FailtoEnd" name="Report Failure and End" sourceRef="Task_ReportFailure" targetRef="End_Failure"/>
  </bpmn:process>

  <bpmn:message id="Message_ChangeRequest" name="Change Request Message"/>
</bpmn:definitions>