<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_0" name="Small Claims Registry Operations" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_ClientServiceBackOffice" name="Client Service Back Office">
        <bpmn:flowNodeRef>StartEvent_RequestReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RetrieveSCTTFile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ForwardWarrantPossession</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateCatchEvent_WaitingForReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RetrieveSCTFile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AttachNewDocument</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_StoreExpandedFile</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_RequestReceived" name="Warrant Possession Request Received">
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Retrieve SCTT File -->
    <bpmn:userTask id="Task_RetrieveSCTTFile" name="Retrieve SCTT File">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task 2: Forward Warrant Possession to Police -->
    <bpmn:userTask id="Task_ForwardWarrantPossession" name="Forward SCT Warrant Possession to Queensland Police">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Intermediate Catch Event: Wait for Police Report -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_WaitingForReport" name="Awaiting Police Report">
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task 3: Retrieve SCT File -->
    <bpmn:userTask id="Task_RetrieveSCTFile" name="Retrieve Respective SCT File">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task 4: Attach New Document -->
    <bpmn:userTask id="Task_AttachNewDocument" name="Attach New SCT Document">
      <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task 5: Store Expanded File -->
    <bpmn:userTask id="Task_StoreExpandedFile" name="Store Expanded SCT Physical File">
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_FileTransferred" name="File Transferred to MC Internal Staff">
      <bpmn:incoming>SequenceFlow_7</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_RequestReceived" targetRef="Task_RetrieveSCTTFile"/>
    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="Task_RetrieveSCTTFile" targetRef="Task_ForwardWarrantPossession"/>
    <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="Task_ForwardWarrantPossession" targetRef="IntermediateCatchEvent_WaitingForReport"/>
    <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="IntermediateCatchEvent_WaitingForReport" targetRef="Task_RetrieveSCTFile"/>
    <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="Task_RetrieveSCTFile" targetRef="Task_AttachNewDocument"/>
    <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="Task_AttachNewDocument" targetRef="Task_StoreExpandedFile"/>
    <bpmn:sequenceFlow id="SequenceFlow_7" sourceRef="Task_StoreExpandedFile" targetRef="EndEvent_FileTransferred"/>

  </bpmn:process>
</bpmn:definitions>