<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_FarmingBot_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_FarmingBot">
    <bpmn:participant id="Participant_FarmingBotProcess" name="Farming Bot Process" processRef="Process_FarmingBot"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_FarmingBot" isExecutable="false">
    
    <!-- Data Objects -->
    <bpmn:dataObjectReference id="DataResourceList_1" name="Farming Resource List"/>
    <bpmn:dataObjectReference id="ToolList_1" name="Available Tools List"/>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_CreateBot" name="Create Custom Farming Bot">
      <bpmn:outgoing>SequenceFlow_StartToResourceSelection</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Resource Selection Phase -->
    <bpmn:userTask id="Task_SelectResources_1" name="Select Resources to Collect">
      <bpmn:incoming>SequenceFlow_StartToResourceSelection</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConfirmBotSetup</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel Gateway for up to 10 resources -->
    <bpmn:parallelGateway id="ParallelGateway_StartFarming" name="">
      <bpmn:incoming>SequenceFlow_ConfirmBotSetup</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CollectResources_1</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Resource Collection Tasks (Example of parallel collection) -->
    <bpmn:userTask id="Task_CollectResources" name="Collect Resources in Parallel">
      <bpmn:incoming>SequenceFlow_StartFarming</bpmn:incoming>
      <bpmn:outgoing>Gateway_ResourcesCollected</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Exclusive Gateway for resource priority -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_PriorityCheck" name="">
      <bpmn:incoming>SequenceFlow_StartFarming</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_HighPriorityResources</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NormalPriorityResources</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- High Priority Resource Collection -->
    <bpmn:userTask id="Task_CollectHighPriority" name="Collect Urgent Resources">
      <bpmn:incoming>SequenceFlow_HighPriorityResources</bpmn:incoming>
      <bpmn:outgoing>Gateway_ContinueFarming</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Normal Priority Resource Collection -->
    <bpmn:userTask id="Task_CollectNormal" name="Collect Standard Resources">
      <bpmn:incoming>SequenceFlow_NormalPriorityResources</bpmn:incoming>
      <bpmn:outgoing>Gateway_ContinueFarming</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Event-Based Gateway for Natural Disaster -->
    <bpmn:eventBasedGateway id="EventGateway_DisasterOrMilestone" name="">
      <bpmn:incoming>SequenceFlow_FarmLoopStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NaturalDisasterPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_MilestoneReachedPath</bpmn:outgoing>
    </bpmn:eventBasedGateway>

    <!-- Natural Disaster Handling -->
    <bpmn:intermediateCatchEvent id="IntermediateDisaster" name="Natural Disaster">
      <bpmn:incoming>SequenceFlow_NaturalDisasterPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DisasterRecovery</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Milestone Notification -->
    <bpmn:userTask id="Task_NotifyMilestone" name="Notify Player of Milestone">
      <bpmn:incoming>SequenceFlow_MilestoneReachedPath</bpmn:incoming>
      <bpmn:outgoing>Gateway_ContinueFarmingLoop</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Update Farming List Loop -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_UpdateList" name="">
      <bpmn:incoming>SequenceFlow_FarmLoopStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ContinueFarming</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_EndBotProcess</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Update List Task -->
    <bpmn:userTask id="Task_UpdateList" name="Update Farming Materials">
      <bpmn:incoming>SequenceFlow_ContinueFarmingLoop</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FarmLoopStart</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Phase -->
    <bpmn:inclusiveGateway id="InclusiveGateway_EndActivities" name="">
      <bpmn:incoming>SequenceFlow_BotFinished</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BragToFriends</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SendMaterials</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Brag to Friends -->
    <bpmn:userTask id="Task_BragToFriends" name="Brag to Selected Friends">
      <bpmn:incoming>SequenceFlow_BragToFriends</bpmn:incoming>
      <bpmn:outgoing>InclusiveGateway_EndActivities_Converge_ToEndEvent</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Send Materials -->
    <bpmn:userTask id="Task_SendMaterials" name="Send Materials to Friends">
      <bpmn:incoming>SequenceFlow_SendMaterials</bpmn:incoming>
      <bpmn:outgoing>InclusiveGateway_EndActivities_Converge_ToEndEvent</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_BotFinished" name="Farming Bot Finished">
      <bpmn:incoming>InclusiveGateway_EndActivities_Converge_ToEndEvent</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows - Resource Selection -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToResourceSelection" sourceRef="StartEvent_CreateBot" targetRef="Task_SelectResources_1"/>
    
    <!-- Parallel Gateway for resource collection setup -->
    <bpmn:parallelGateway id="ParallelGateway_ConfirmSetup">
      <bpmn:incoming>SequenceFlow_ConfirmBotSetup</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StartFarming</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Sequence Flows - Farming Loop -->
    <bpmn:sequenceFlow id="SequenceFlow_ConfirmBotSetup" sourceRef="Task_SelectResources_1" targetRef="ParallelGateway_ConfirmSetup"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_StartFarming" name="" sourceRef="ParallelGateway_ConfirmSetup" targetRef="EventGateway_DisasterOrMilestone"/>

    <!-- Event-Based Gateway Paths -->
    <bpmn:sequenceFlow id="SequenceFlow_NaturalDisasterPath" sourceRef="EventGateway_DisasterOrMilestone" targetRef="IntermediateDisaster">
      <bpmn:name>Natural Disaster</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_MilestoneReachedPath" name="" sourceRef="EventGateway_DisasterOrMilestone" targetRef="Task_NotifyMilestone">
      <bpmn:name>Milestone Reached</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Disaster Recovery -->
    <bpmn:userTask id="Task_RecoverFromDisaster" name="Recover from Natural Disaster">
      <bpmn:incoming>SequenceFlow_DisasterRecovery</bpmn:incoming>
      <bpmn:outgoing>InclusiveGateway_EndActivities_Converge_ToEndEvent</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Sequence Flow for disaster recovery -->
    <bpmn:sequenceFlow id="SequenceFlow_DisasterRecovery" sourceRef="IntermediateDisaster" targetRef="Task_RecoverFromDisaster"/>

    <!-- Update List Loop Path -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_ContinueFarmingLoop">
      <bpmn:incoming>SequenceFlow_FarmLoopStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_UpdateListPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_EndBotProcess</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flow for update list -->
    <bpmn:sequenceFlow id="SequenceFlow_UpdateListPath" name="" sourceRef="ExclusiveGateway_ContinueFarmingLoop" targetRef="Task_UpdateList"/>

    <!-- End Phase Paths -->
    <bpmn:inclusiveGateway id="InclusiveGateway_EndActivities_Converge">
      <bpmn:incoming>SequenceFlow_BragToFriends</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_SendMaterials</bpmn:incoming>
      <bpmn:outgoing>InclusiveGateway_EndActivities_Converge_ToEndEvent</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Final sequence flow to end event -->
    <bpmn:sequenceFlow id="InclusiveGateway_EndActivities_Converge_ToEndEvent" sourceRef="InclusiveGateway_EndActivities_Converge" targetRef="EndEvent_BotFinished"/>

  </bpmn:process>
</bpmn:definitions>