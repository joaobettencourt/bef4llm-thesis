<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_BecomingAParent">
    <bpmn:participant id="Participant_ParentProcess" name="Parent Process - Maternity Leave Management" processRef="Process_MaternityLeave"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_MaternityLeave" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Parent decides to take maternity leave">
      <bpmn:outgoing>SequenceFlow_FetchInfo</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Fetch information about potential models -->
    <bpmn:userTask id="Task_2" name="Fetch information about potential models (months duration, split between parents)">
      <bpmn:incoming>SequenceFlow_FetchInfo</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SelectModel</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task 2: Let parent select -->
    <bpmn:userTask id="Task_3" name="Let parent select model">
      <bpmn:incoming>SequenceFlow_SelectModel</bpmn:incoming>
      <bpmn:outgoing>Gateway_CollectInfo</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway for collecting relevant information -->
    <bpmn:exclusiveGateway id="Gateway_4" name="">
      <bpmn:incoming>SequenceFlow_SelectModel</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NotifySS</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NotifyCompany</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 3: Notify Social Security -->
    <bpmn:userTask id="Task_5" name="Notify Social Security in time">
      <bpmn:incoming>SequenceFlow_NotifySS</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Converge1</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task 4: Notify Company -->
    <bpmn:userTask id="Task_6" name="Notify Company in time">
      <bpmn:incoming>SequenceFlow_NotifyCompany</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Converge1</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Converging Gateway -->
    <bpmn:exclusiveGateway id="Gateway_7" name="">
      <bpmn:incoming>SequenceFlow_Converge1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GatherInfo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 5: Gather information from companies -->
    <bpmn:userTask id="Task_8" name="Gather information from companies">
      <bpmn:incoming>SequenceFlow_GatherInfo</bpmn:incoming>
      <bpmn:outgoing>Gateway_EndOfPeriodDecision</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway for extension decision at end of period -->
    <bpmn:exclusiveGateway id="Gateway_9" name="">
      <bpmn:incoming>SequenceFlow_GatherInfo</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DecideExtensionYes</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_DecideExtensionNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 6: Decide about extension - Yes path -->
    <bpmn:userTask id="Task_10" name="Decide to extend maternity leave">
      <bpmn:incoming>SequenceFlow_DecideExtensionYes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Converge2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task 7: Decide about extension - No path -->
    <bpmn:userTask id="Task_11" name="Decide not to extend maternity leave">
      <bpmn:incoming>SequenceFlow_DecideExtensionNo</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Converge2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Converging Gateway -->
    <bpmn:exclusiveGateway id="Gateway_12" name="">
      <bpmn:incoming>SequenceFlow_Converge2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndProcess</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_1" name="Maternity leave process completed">
      <bpmn:incoming>SequenceFlow_EndProcess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_FetchInfo" sourceRef="StartEvent_1" targetRef="Task_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_SelectModel" name="" sourceRef="Task_3" targetRef="Gateway_4"/>
    <bpmn:sequenceFlow id="SequenceFlow_NotifySS" name="Notify Social Security" sourceRef="Gateway_4" targetRef="Task_5"/>
    <bpmn:sequenceFlow id="SequenceFlow_NotifyCompany" name="Notify Company" sourceRef="Gateway_4" targetRef="Task_6"/>
    <bpmn:sequenceFlow id="SequenceFlow_Converge1" name="" sourceRef="Task_5" targetRef="Gateway_7"/>
    <bpmn:sequenceFlow id="SequenceFlow_GatherInfo" name="" sourceRef="Gateway_7" targetRef="Task_8"/>
    <bpmn:sequenceFlow id="SequenceFlow_DecideExtensionYes" name="Extend - Yes" sourceRef="Gateway_9" targetRef="Task_10"/>
    <bpmn:sequenceFlow id="SequenceFlow_DecideExtensionNo" name="Extend - No" sourceRef="Gateway_9" targetRef="Task_11"/>

  </bpmn:process>
</bpmn:definitions>