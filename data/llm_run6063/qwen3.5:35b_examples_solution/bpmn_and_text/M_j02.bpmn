<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_LuxuryAirplane" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_AirplaneManufacturing">
    <bpmn:participant id="Participant_ManufacturingProcess" name="Luxury Airplane Manufacturing Process" processRef="Process_LuxuryAirplane"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_LuxuryAirplane" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_OrderReceived" name="Receive Customer Order">
      <bpmn:outgoing>SequenceFlow_DefineRequirements</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Define Requirements Task -->
    <bpmn:userTask id="Task_DefineRequirements" name="Define Custom Specifications">
      <bpmn:incoming>SequenceFlow_DefineRequirements</bpmn:incoming>
      <bpmn:outgoing>Gateway_BaseModelDecision</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Base Model Decision Gateway -->
    <bpmn:exclusiveGateway id="Gateway_BaseModelDecision" name="Base model required?">
      <bpmn:incoming>SequenceFlow_DefineRequirements</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ManufactureCustomParts</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_UseStandardModel</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Parallel Gateway for Manufacturing Teams -->
    <bpmn:parallelGateway id="ParallelGateway_Manufacturing" name="Manufacture Parts">
      <bpmn:incoming>SequenceFlow_ManufactureCustomParts</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RussianTeamVodkaBar</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_IrishTeamWhiskeyBar</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SeatsManufacturing</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Russian Team Task -->
    <bpmn:userTask id="Task_RussianTeam" name="Russian Team - Vodka Bar">
      <bpmn:incoming>SequenceFlow_RussianTeamVodkaBar</bpmn:incoming>
      <bpmn:outgoing>Gateway_ManufacturingComplete</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Irish Team Task -->
    <bpmn:userTask id="Task_IrishTeam" name="Irish Team - Whiskey Bar">
      <bpmn:incoming>SequenceFlow_IrishTeamWhiskeyBar</bpmn:incoming>
      <bpmn:outgoing>Gateway_ManufacturingComplete</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Seats Manufacturing Task -->
    <bpmn:userTask id="Task_SeatsManufacturing" name="Seats &amp; Interior Components">
      <bpmn:incoming>SequenceFlow_SeatsManufacturing</bpmn:incoming>
      <bpmn:outgoing>Gateway_ManufacturingComplete</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Manufacturing Complete Gateway -->
    <bpmn:parallelGateway id="Gateway_ManufacturingComplete" name="Parts Ready">
      <bpmn:incoming>SequenceFlow_RussianTeamVodkaBar</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_IrishTeamWhiskeyBar</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_SeatsManufacturing</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AssembleInterior</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Assemble Interior Task -->
    <bpmn:userTask id="Task_AssembleInterior" name="Assemble Plane Interior">
      <bpmn:incoming>SequenceFlow_AssembleInterior</bpmn:incoming>
      <bpmn:outgoing>ParallelGateway_TestFlightPreparation</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel Gateway for Test Flight Preparation -->
    <bpmn:parallelGateway id="ParallelGateway_TestFlightPreparation">
      <bpmn:incoming>SequenceFlow_AssembleInterior</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConductTestFlight</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CreateProtocol</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Test Flight Task -->
    <bpmn:userTask id="Task_TestFlight" name="Conduct Test Flight">
      <bpmn:incoming>SequenceFlow_ConductTestFlight</bpmn:incoming>
      <bpmn:outgoing>ParallelGateway_FlightComplete</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Create Protocol Task -->
    <bpmn:serviceTask id="Task_CreateProtocol" name="Create Test Protocol">
      <bpmn:incoming>SequenceFlow_CreateProtocol</bpmn:incoming>
      <bpmn:outgoing>ParallelGateway_FlightComplete</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Flight Complete Gateway -->
    <bpmn:parallelGateway id="ParallelGateway_FlightComplete">
      <bpmn:incoming>SequenceFlow_ConductTestFlight</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_CreateProtocol</bpmn:incoming>
      <bpmn:outgoing>ExclusiveGateway_TestSuccessful</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Test Successful Gateway -->
    <bpmn:exclusiveGateway id="Gateway_TestSuccessful" name="Test Successful?">
      <bpmn:incoming>SequenceFlow_FlightComplete</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DeliverToCustomer</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RepeatTesting</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Deliver to Customer Task -->
    <bpmn:userTask id="Task_DeliverToCustomer" name="Deliver Plane to Customer">
      <bpmn:incoming>SequenceFlow_DeliverToCustomer</bpmn:incoming>
      <bpmn:outgoing>ExclusiveGateway_CustomerConfirmation</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Customer Confirmation Gateway -->
    <bpmn:exclusiveGateway id="Gateway_CustomerConfirmation" name="Confirmed?">
      <bpmn:incoming>SequenceFlow_DeliverToCustomer</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProcessComplete</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ResolveIssues</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Resolve Issues Task -->
    <bpmn:userTask id="Task_ResolveIssues" name="Address Customer Concerns">
      <bpmn:incoming>SequenceFlow_ResolveIssues</bpmn:incoming>
      <bpmn:outgoing>ParallelGateway_TestFlightPreparation</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_ProcessComplete" name="Process Complete">
      <bpmn:incoming>SequenceFlow_ProcessComplete</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows for Standard Model Path -->
    <bpmn:sequenceFlow id="SequenceFlow_UseStandardModel" sourceRef="Gateway_BaseModelDecision" targetRef="ParallelGateway_Manufacturing"/>

    <!-- Sequence Flow to Manufacturing Teams (Custom Parts) -->
    <bpmn:sequenceFlow id="SequenceFlow_ManufactureCustomParts" name="Yes - Custom Required" sourceRef="Gateway_BaseModelDecision" targetRef="ParallelGateway_Manufacturing"/>

    <!-- Russian Team Vodka Bar Path -->
    <bpmn:sequenceFlow id="SequenceFlow_RussianTeamVodkaBar" sourceRef="ParallelGateway_Manufacturing" targetRef="Task_RussianTeam"/>

    <!-- Irish Team Whiskey Bar Path -->
    <bpmn:sequenceFlow id="SequenceFlow_IrishTeamWhiskeyBar" name="Irish Team - Whiskey Bar" sourceRef="ParallelGateway_Manufacturing" targetRef="Task_IrishTeam"/>

    <!-- Seats Manufacturing Path -->
    <bpmn:sequenceFlow id="SequenceFlow_SeatsManufacturing" sourceRef="ParallelGateway_Manufacturing" targetRef="Task_SeatsManufacturing"/>

    <!-- Assemble Interior Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_AssembleInterior" name="Assemble Plane Interior" sourceRef="Gateway_ManufacturingComplete" targetRef="Task_AssembleInterior"/>

    <!-- Test Flight Preparation Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_ConductTestFlight" sourceRef="ParallelGateway_TestFlightPreparation" targetRef="Task_TestFlight"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_CreateProtocol" name="Create Protocol During Flight" sourceRef="ParallelGateway_TestFlightPreparation" targetRef="Task_CreateProtocol"/>

    <!-- Test Complete Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_FlightComplete" sourceRef="ParallelGateway_FlightComplete" targetRef="Gateway_TestSuccessful"/>

    <!-- Delivery Path (Test Successful) -->
    <bpmn:sequenceFlow id="SequenceFlow_DeliverToCustomer" name="Yes - Test Passed" sourceRef="Gateway_TestSuccessful" targetRef="Task_DeliverToCustomer"/>

    <!-- Repeat Testing Path (Test Failed) -->
    <bpmn:sequenceFlow id="SequenceFlow_RepeatTesting" name="No - Fix Issues" sourceRef="Gateway_TestSuccessful" targetRef="ParallelGateway_Manufacturing"/>

    <!-- Customer Confirmation Paths -->
    <bpmn:sequenceFlow id="SequenceFlow_ProcessComplete" name="Yes - Confirmed" sourceRef="Gateway_CustomerConfirmation" targetRef="EndEvent_ProcessComplete"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ResolveIssues" name="No - Address Concerns" sourceRef="Gateway_CustomerConfirmation" targetRef="Task_ResolveIssues"/>

  </bpmn:process>
</bpmn:definitions>