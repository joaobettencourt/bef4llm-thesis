<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_WorkLiveAustria" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_WorkAndLiveInAustria">
    <bpmn:participant id="Participant_ApplicantProcess" name="Applicant Process - Work and Live in Austria" processRef="Process_WorkAndLive"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_WorkAndLive" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Begin Application Process for Austria">
      <bpmn:outgoing>SequenceFlow_CheckPassport</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Passport Check Task -->
    <bpmn:userTask id="Task_CheckPassportValidity" name="Check passport validity">
      <bpmn:incoming>SequenceFlow_CheckPassport</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_VisaDurationDecision</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Visa Duration Decision Gateway -->
    <bpmn:exclusiveGateway id="Gateway_VisaDuration" name="How long are you going to stay?">
      <bpmn:incoming>SequenceFlow_VisaDurationDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ShortStayVisa</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_MediumStayVisa</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_LongStayRotWeissRot</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Short Stay Visa Path -->
    <bpmn:userTask id="Task_RequestShortVisa" name="Request Schengen visa (&lt; 90 days)">
      <bpmn:incoming>SequenceFlow_ShortStayVisa</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_VisaApplicationComplete1</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Medium Stay Visa Path -->
    <bpmn:userTask id="Task_RequestAufenthaltstitel" name="Request Aufenthaltstitel (&gt; 6 months, &lt; 24 months)">
      <bpmn:incoming>SequenceFlow_MediumStayVisa</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_VisaApplicationComplete2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Long Stay Rot-Weiss-Rot Card Path -->
    <bpmn:userTask id="Task_RequestRotWeissRotCard" name="Request Rot-Weiß-Rot card (24 months + working in Austria)">
      <bpmn:incoming>SequenceFlow_LongStayRotWeissRot</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_VisaApplicationComplete3</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Visa Application Convergence -->
    <bpmn:exclusiveGateway id="Gateway_VisaApplications" name="">
      <bpmn:incoming>SequenceFlow_VisaApplicationComplete1</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_VisaApplicationComplete2</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_VisaApplicationComplete3</bpmn:incoming>
    </bpmn:exclusiveGateway>

    <!-- Parallel Tasks for Accommodation and Bank Account -->
    <bpmn:parallelGateway id="Parallel_AccommodationBank" name="">
      <bpmn:incoming>SequenceFlow_VisaApplicationsComplete</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OrganizeAccommodation</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_OpenBankAccount</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Accommodation Task -->
    <bpmn:userTask id="Task_OrganizeAccommodation" name="Organise accommodation">
      <bpmn:incoming>SequenceFlow_OrganizeAccommodation</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AccommodationComplete</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Bank Account Task -->
    <bpmn:userTask id="Task_OpenBankAccount" name="Open an Austrian bank account">
      <bpmn:incoming>SequenceFlow_OpenBankAccount</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BankComplete</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Accommodation and Bank Convergence -->
    <bpmn:parallelGateway id="Parallel_AccomBankConverge" name="">
      <bpmn:incoming>SequenceFlow_AccommodationComplete</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_BankComplete</bpmn:incoming>
    </bpmn:parallelGateway>

    <!-- Notify Country of Origin -->
    <bpmn:userTask id="Task_NotifyCountryOrigin" name="Inform country of origin about the relocation">
      <bpmn:incoming>SequenceFlow_AccomBankComplete</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RegisterResidence</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Register Residence -->
    <bpmn:userTask id="Task_RegisterResidence" name="Register the new residence with local authorities">
      <bpmn:incoming>SequenceFlow_RegisterResidence</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_UtilitiesDecisionPoint</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Utilities Decision Gateway -->
    <bpmn:exclusiveGateway id="Gateway_RadioTV" name="Are you going to have a radio or TV?">
      <bpmn:incoming>SequenceFlow_UtilitiesDecisionPoint</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RegisterGISYes</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SkipRegisterGISNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- GIS Registration (if radio/TV) -->
    <bpmn:userTask id="Task_RegisterGIS" name="Register at GIS">
      <bpmn:incoming>SequenceFlow_RegisterGISYes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GISComplete</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Energy and Utilities Tasks -->
    <bpmn:parallelGateway id="Parallel_Utilities" name="">
      <bpmn:incoming>SequenceFlow_SkipRegisterGISNo</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_GISComplete</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EnergyVendor</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_InternetMobile</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Energy Vendor Task -->
    <bpmn:userTask id="Task_ObtainEnergy" name="Obtain gas and energy vendor">
      <bpmn:incoming>SequenceFlow_EnergyVendor</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EnergyComplete</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Internet/Mobile Task -->
    <bpmn:userTask id="Task_InternetMobile" name="Take care of internet and mobile communication">
      <bpmn:incoming>SequenceFlow_InternetMobile</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_UtilitiesComplete</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Utilities Convergence -->
    <bpmn:parallelGateway id="Parallel_UtilitiesConverge" name="">
      <bpmn:incoming>SequenceFlow_EnergyComplete</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_GISComplete</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_UtilitiesComplete</bpmn:incoming>
    </bpmn:parallelGateway>

    <!-- Live and Work in Austria -->
    <bpmn:userTask id="Task_LiveWorkAustria" name="Live and work in Austria">
      <bpmn:incoming>SequenceFlow_UtilitiesCompleteToLiveWork</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PermitCheckLoop</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Permit Validity Check -->
    <bpmn:exclusiveGateway id="Gateway_PermitValid" name="Is the permit of residence still valid?">
      <bpmn:incoming>SequenceFlow_PermitCheckLoop</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RenewPermitNo</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ContinueLivingYes</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Renew Permit Task -->
    <bpmn:userTask id="Task_RenewPermit" name="Renew your permit of residence">
      <bpmn:incoming>SequenceFlow_RenewPermitNo</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PermitRenewedComplete</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Permit Renewal Convergence -->
    <bpmn:exclusiveGateway id="Gateway_RenewConverge" name="">
      <bpmn:incoming>SequenceFlow_PermitRenewedComplete</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ContinueLivingYes</bpmn:incoming>
    </bpmn:exclusiveGateway>

    <!-- Stay or Leave Decision -->
    <bpmn:exclusiveGateway id="Gateway_DecisionStayLeave" name="Do you wish to stay or go back?">
      <bpmn:incoming>SequenceFlow_RenewConverge</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ContinueLivingLoop</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ReturnHomeNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Return Home Task -->
    <bpmn:userTask id="Task_ReturnCountryOrigin" name="Return to country of origin">
      <bpmn:incoming>SequenceFlow_ReturnHomeNo</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProcessEnd</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_LiveWorkAustria" name="">
      <bpmn:incoming>SequenceFlow_ContinueLivingLoop</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_ProcessComplete" name="Process Complete">
      <bpmn:incoming>SequenceFlow_ProcessEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckPassport" sourceRef="StartEvent_1" targetRef="Task_CheckPassportValidity"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_VisaDurationDecision" name="" sourceRef="Task_CheckPassportValidity" targetRef="Gateway_VisaDuration"/>

    <!-- Visa Duration Paths -->
    <bpmn:sequenceFlow id="SequenceFlow_ShortStayVisa" name="&lt; 90 days" sourceRef="Gateway_VisaDuration" targetRef="Task_RequestShortVisa"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_MediumStayVisa" name="&gt; 6 months but &lt; 24 months" sourceRef="Gateway_VisaDuration" targetRef="Task_RequestAufenthaltstitel"/>

    <bpmn:sequenceFlow id="SequenceFlow_LongStayRotWeissRot" name="24 months + working in Austria" sourceRef="Gateway_VisaDuration" targetRef="Task_RequestRotWeissRotCard"/>

    <!-- Visa Application Convergence -->
    <bpmn:sequenceFlow id="SequenceFlow_VisaApplicationComplete1" name="" sourceRef="Task_RequestShortVisa" targetRef="Gateway_VisaApplications"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_VisaApplicationComplete2" name="" sourceRef="Task_RequestAufenthaltstitel" targetRef="Gateway_VisaApplications"/>

    <bpmn:sequenceFlow id="SequenceFlow_VisaApplicationComplete3" name="" sourceRef="Task_RequestRotWeissRotCard" targetRef="Gateway_VisaApplications"/>
    
    <!-- Visa Applications Complete to Accommodation/Bank -->
    <bpmn:sequenceFlow id="SequenceFlow_VisaApplicationsComplete" name="" sourceRef="Gateway_VisaApplications" targetRef="Parallel_AccommodationBank"/>

    <!-- Parallel Tasks for Accommodation and Bank Account -->
    <bpmn:sequenceFlow id="SequenceFlow_OrganizeAccommodation" name="" sourceRef="Parallel_AccommodationBank" targetRef="Task_OrganizeAccommodation"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_OpenBankAccount" name="" sourceRef="Parallel_AccommodationBank" targetRef="Task_OpenBankAccount"/>

    <!-- Accommodation and Bank Convergence -->
    <bpmn:sequenceFlow id="SequenceFlow_AccommodationComplete" name="" sourceRef="Task_OrganizeAccommodation" targetRef="Parallel_AccomBankConverge"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_BankComplete" name="" sourceRef="Task_OpenBankAccount" targetRef="Parallel_AccomBankConverge"/>

    <!-- Notify Country of Origin -->
    <bpmn:sequenceFlow id="SequenceFlow_AccomBankComplete" name="" sourceRef="Parallel_AccomBankConverge" targetRef="Task_NotifyCountryOrigin"/>

    <!-- Register Residence -->
    <bpmn:sequenceFlow id="SequenceFlow_RegisterResidence" name="" sourceRef="Task_NotifyCountryOrigin" targetRef="Task_RegisterResidence"/>

    <!-- Utilities Decision Point -->
    <bpmn:sequenceFlow id="SequenceFlow_UtilitiesDecisionPoint" name="" sourceRef="Task_RegisterResidence" targetRef="Gateway_RadioTV"/>

    <!-- GIS Registration Paths -->
    <bpmn:sequenceFlow id="SequenceFlow_RegisterGISYes" name="yes" sourceRef="Gateway_RadioTV" targetRef="Task_RegisterGIS"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_SkipRegisterGISNo" name="no" sourceRef="Gateway_RadioTV" targetRef="Parallel_Utilities"/>

    <!-- Utilities Tasks -->
    <bpmn:sequenceFlow id="SequenceFlow_EnergyVendor" name="" sourceRef="Parallel_Utilities" targetRef="Task_ObtainEnergy"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_InternetMobile" name="" sourceRef="Parallel_Utilities" targetRef="Task_InternetMobile"/>

    <!-- Utilities Convergence -->
    <bpmn:sequenceFlow id="SequenceFlow_EnergyComplete" name="" sourceRef="Task_ObtainEnergy" targetRef="Parallel_UtilitiesConverge"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_GISComplete" name="" sourceRef="Task_RegisterGIS" targetRef="Parallel_UtilitiesConverge"/>

    <bpmn:sequenceFlow id="SequenceFlow_UtilitiesComplete" name="" sourceRef="Task_InternetMobile" targetRef="Parallel_UtilitiesConverge"/>

    <!-- Live and Work in Austria -->
    <bpmn:sequenceFlow id="SequenceFlow_UtilitiesCompleteToLiveWork" name="" sourceRef="Parallel_UtilitiesConverge" targetRef="Task_LiveWorkAustria"/>

    <!-- Permit Check Loop -->
    <bpmn:sequenceFlow id="SequenceFlow_PermitCheckLoop" name="" sourceRef="Task_LiveWorkAustria" targetRef="Gateway_PermitValid"/>

    <!-- Permit Validity Paths -->
    <bpmn:sequenceFlow id="SequenceFlow_RenewPermitNo" name="no" sourceRef="Gateway_PermitValid" targetRef="Task_RenewPermit"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ContinueLivingYes" name="yes" sourceRef="Gateway_PermitValid" targetRef="Gateway_RenewConverge"/>

    <!-- Permit Renewal Convergence -->
    <bpmn:sequenceFlow id="SequenceFlow_PermitRenewedComplete" name="" sourceRef="Task_RenewPermit" targetRef="Gateway_RenewConverge"/>

    <!-- Stay or Leave Decision Paths -->
    <bpmn:sequenceFlow id="SequenceFlow_ContinueLivingLoop" name="stay in Austria" sourceRef="Gateway_DecisionStayLeave" targetRef="EndEvent_LiveWorkAustria"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ReturnHomeNo" name="leave Austria" sourceRef="Gateway_DecisionStayLeave" targetRef="Task_ReturnCountryOrigin"/>

    <!-- Process End -->
    <bpmn:sequenceFlow id="SequenceFlow_ProcessEnd" name="" sourceRef="Task_ReturnCountryOrigin" targetRef="EndEvent_ProcessComplete"/>

  </bpmn:process>
</bpmn:definitions>