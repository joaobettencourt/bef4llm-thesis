<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_OnlineShopOrdering" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_OrderProcess">
    <bpmn:participant id="Participant_CustomerShopping" name="Customer Shopping Process" processRef="Process_Shopping"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Shopping" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_LoginAttempt" name="Customer Logs into E-Shop">
      <bpmn:outgoing>SequenceFlow_CheckCredentials</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Service Task - System checks credentials -->
    <bpmn:serviceTask id="ServiceTask_CredentialsCheck" name="System Checks Credentials">
      <bpmn:incoming>SequenceFlow_CheckCredentials</bpmn:incoming>
      <bpmn:outgoing>Gateway_LoginSuccess</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Exclusive Gateway - Login Success Decision -->
    <bpmn:exclusiveGateway id="Gateway_LoginSuccess" name="Login Successful?">
      <bpmn:incoming>SequenceFlow_CredentialsChecked</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProductSelectionPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_LoginFailedEnd</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Manual Task - Customer selects product -->
    <bpmn:userTask id="UserTask_SelectProduct" name="Customer Selects Product">
      <bpmn:incoming>SequenceFlow_ProductSelectionPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AddToCart</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Manual Task - Add to cart -->
    <bpmn:userTask id="UserTask_AddToCart" name="Add Product to Shopping Cart">
      <bpmn:incoming>SequenceFlow_AddToCart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SaveProduct</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Manual Task - Save product -->
    <bpmn:userTask id="UserTask_SaveProduct" name="Save Product">
      <bpmn:incoming>SequenceFlow_SaveProduct</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckAllSelected</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Manual Task - Check if all products selected -->
    <bpmn:userTask id="UserTask_CheckProducts" name="Check If All Products Selected">
      <bpmn:incoming>SequenceFlow_CheckAllSelected</bpmn:incoming>
      <bpmn:outgoing>Gateway_AllProductsSelected</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Exclusive Gateway - Product Selection Loop -->
    <bpmn:exclusiveGateway id="Gateway_AllProductsSelected" name="All Products Selected?">
      <bpmn:incoming>SequenceFlow_ProductsChecked</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OrderProcessingPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SelectMoreProducts</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Parallel Gateway - Diverge for Payment and Shipment Preparation -->
    <bpmn:parallelGateway id="Parallel_Gateway_OrderPreparation" name="">
      <bpmn:incoming>SequenceFlow_StartOrderProcessing</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PaymentPrepPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ShipmentPrepPath</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Service Task - Payment Preparation -->
    <bpmn:serviceTask id="ServiceTask_PaymentPrepare" name="Payment Prepared by System">
      <bpmn:incoming>SequenceFlow_PaymentPrepPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CustomerEntersPaymentData</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Service Task - Shipment Preparation -->
    <bpmn:serviceTask id="ServiceTask_ShipmentPrepare" name="Shipment Prepared by System">
      <bpmn:incoming>SequenceFlow_ShipmentPrepPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CustomerEntersShippingAddress</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Manual Task - Customer enters payment data -->
    <bpmn:userTask id="UserTask_EnterPaymentData" name="Customer Enters Payment Data">
      <bpmn:incoming>SequenceFlow_CustomerEntersPaymentData</bpmn:incoming>
      <bpmn:outgoing>Gateway_WaitForBankConfirmation</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Manual Task - Customer enters shipping address -->
    <bpmn:userTask id="UserTask_EnterShippingAddress" name="Customer Enters Shipping Address">
      <bpmn:incoming>SequenceFlow_CustomerEntersShippingAddress</bpmn:incoming>
      <bpmn:outgoing>Gateway_BillingVsShippingCheck</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Exclusive Gateway - Billing Address Decision -->
    <bpmn:exclusiveGateway id="Gateway_BillingVsShippingCheck" name="Billing = Shipping?">
      <bpmn:incoming>SequenceFlow_AddressEntered</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SameAddressPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_DifferentAddressPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Manual Task - Enter independent billing address -->
    <bpmn:userTask id="UserTask_EnterBillingAddress" name="Customer Enters Independent Billing Address">
      <bpmn:incoming>SequenceFlow_DifferentAddressPath</bpmn:incoming>
      <bpmn:outgoing>Gateway_ConvergeAddresses</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel Gateway - Converge Payment and Address Processing -->
    <bpmn:parallelGateway id="Parallel_Gateway_AddressPaymentConvergence" name="">
      <bpmn:incoming>SequenceFlow_BankConfirmed</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_AddressesComplete</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OrderFinishedBySystem</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Service Task - Order Finished by System -->
    <bpmn:serviceTask id="ServiceTask_OrderFinish" name="Order Finished by System">
      <bpmn:incoming>SequenceFlow_OrderFinishedBySystem</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProcessCompleteEnd</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_OrderCompleted" name="Order Completed">
      <bpmn:incoming>SequenceFlow_ProcessCompleteEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Exclusive Gateway - Login Failed Path Convergence -->
    <bpmn:exclusiveGateway id="Gateway_LoginFailedConverge" name="">
      <bpmn:incoming>SequenceFlow_LoginFailedPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProcessCompleteEnd</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flows -->
    
    <!-- Login Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckCredentials" sourceRef="StartEvent_LoginAttempt" targetRef="ServiceTask_CredentialsCheck"/>
    <bpmn:sequenceFlow id="SequenceFlow_CredentialsChecked" name="" sourceRef="ServiceTask_CredentialsCheck" targetRef="Gateway_LoginSuccess">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${loginSuccessful}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Login Success Path -->
    <bpmn:sequenceFlow id="SequenceFlow_ProductSelectionPath" name="Yes - Continue Shopping" sourceRef="Gateway_LoginSuccess" targetRef="UserTask_SelectProduct">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${loginSuccessful}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Login Failed Path -->
    <bpmn:sequenceFlow id="SequenceFlow_LoginFailedEnd" name="No - Stop Shopping" sourceRef="Gateway_LoginSuccess" targetRef="Gateway_LoginFailedConverge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!loginSuccessful}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Product Selection Loop -->
    <bpmn:sequenceFlow id="SequenceFlow_AddToCart" sourceRef="UserTask_SelectProduct" targetRef="UserTask_AddToCart"/>
    <bpmn:sequenceFlow id="SequenceFlow_SaveProduct" sourceRef="UserTask_AddToCart" targetRef="UserTask_SaveProduct"/>
    <bpmn:sequenceFlow id="SequenceFlow_CheckAllSelected" sourceRef="UserTask_SaveProduct" targetRef="UserTask_CheckProducts"/>

    <!-- Product Selection Decision -->
    <bpmn:sequenceFlow id="SequenceFlow_ProductsChecked" name="" sourceRef="UserTask_CheckProducts" targetRef="Gateway_AllProductsSelected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${productsChecked}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    
    <bpmn:sequenceFlow id="SequenceFlow_SelectMoreProducts" name="No - Select More Products" sourceRef="Gateway_AllProductsSelected" targetRef="UserTask_SelectProduct">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!allProductsSelected}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Order Processing Path -->
    <bpmn:sequenceFlow id="SequenceFlow_StartOrderProcessing" name="Yes - All Products Selected" sourceRef="Gateway_AllProductsSelected" targetRef="Parallel_Gateway_OrderPreparation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${allProductsSelected}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Payment and Shipment Preparation -->
    <bpmn:sequenceFlow id="SequenceFlow_PaymentPrepPath" sourceRef="Parallel_Gateway_OrderPreparation" targetRef="ServiceTask_PaymentPrepare"/>
    <bpmn:sequenceFlow id="SequenceFlow_ShipmentPrepPath" sourceRef="Parallel_Gateway_OrderPreparation" targetRef="ServiceTask_ShipmentPrepare"/>

    <!-- Customer Payment and Address Entry -->
    <bpmn:sequenceFlow id="SequenceFlow_CustomerEntersPaymentData" name="" sourceRef="ServiceTask_PaymentPrepare" targetRef="UserTask_EnterPaymentData"/>
    <bpmn:sequenceFlow id="SequenceFlow_CustomerEntersShippingAddress" name="" sourceRef="ServiceTask_ShipmentPrepare" targetRef="UserTask_EnterShippingAddress"/>

    <!-- Wait for Bank Confirmation -->
    <bpmn:userTask id="UserTask_WaitBankConfirmation" name="Wait Until Bank Confirms Payment">
      <bpmn:incoming>SequenceFlow_CustomerEntersPaymentData</bpmn:incoming>
      <bpmn:outgoing>Gateway_AddressAndPaymentConverge</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Address Decision Paths -->
    <bpmn:sequenceFlow id="SequenceFlow_SameAddressPath" name="Yes - Same Address" sourceRef="Gateway_BillingVsShippingCheck" targetRef="Gateway_ConvergeAddresses">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${billingEqualsShipping}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_DifferentAddressPath" name="No - Different Address" sourceRef="Gateway_BillingVsShippingCheck" targetRef="UserTask_EnterBillingAddress">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!billingEqualsShipping}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Address Convergence -->
    <bpmn:exclusiveGateway id="Gateway_ConvergeAddresses" name="">
      <bpmn:incoming>SequenceFlow_SameAddressPath</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_BillingEnteredComplete</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AddressesComplete</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Address Complete Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_AddressEntered" sourceRef="UserTask_EnterShippingAddress" targetRef="Gateway_BillingVsShippingCheck"/>
    <bpmn:sequenceFlow id="SequenceFlow_AddressesComplete" name="" sourceRef="Gateway_ConvergeAddresses" targetRef="Parallel_Gateway_AddressPaymentConvergence">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${addressesEntered}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Payment Confirmation Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_BankConfirmed" name="" sourceRef="UserTask_WaitBankConfirmation" targetRef="Parallel_Gateway_AddressPaymentConvergence">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${paymentConfirmed}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Final Convergence and Order Completion -->
    <bpmn:parallelGateway id="Parallel_Gateway_AddressPaymentConverge" name="">
      <bpmn:incoming>SequenceFlow_BankConfirmed</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OrderFinishedBySystem</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Order Finished -->
    <bpmn:sequenceFlow id="SequenceFlow_OrderFinishedBySystem" sourceRef="Parallel_Gateway_AddressPaymentConverge" targetRef="ServiceTask_OrderFinish"/>
    
    <!-- Process Complete End Path -->
    <bpmn:sequenceFlow id="SequenceFlow_ProcessCompleteEnd" name="" sourceRef="Gateway_LoginFailedConverge" targetRef="EndEvent_OrderCompleted">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${processTerminated}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>