<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_FindJob_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_find_job_process">
    <bpmn:participant id="Participant_JobSeekerProcess" name="Find a Job Process" processRef="Process_FindJob"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_FindJob" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Unemployed" name="Unemployed">
      <bpmn:outgoing>SequenceFlow_StartToApplication</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Application Tasks -->
    <bpmn:task id="Task_WriteJobApplication" name="Write Job Application">
      <bpmn:incoming>SequenceFlow_ApplicationLoopBack</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendApplication</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_SendJobApplication" name="Send Job Application">
      <bpmn:incoming>SequenceFlow_SendApplication</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReportApplication</bpmn:outgoing>
    </bpmn:task>

    <!-- Reporting Task -->
    <bpmn:task id="Task_ReportJobApplication" name="Report Job Application">
      <bpmn:incoming>SequenceFlow_ReportApplication</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SplitToOffersAndConfirmation</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Split for Offers and Confirmation -->
    <bpmn:parallelGateway id="ParallelGateway_OffersConfirmations" name="">
      <bpmn:incoming>SequenceFlow_SplitToOffersAndConfirmation</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReceivePotentialJobOffer</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ConfirmApplicationEntry</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Receive Potential Job Offers -->
    <bpmn:task id="Task_ReceivePotentialJobOffer" name="Receive Potential Job Offer">
      <bpmn:incoming>SequenceFlow_ReceivePotentialJobOffer</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConvergeOffersAndFeedback</bpmn:outgoing>
    </bpmn:task>

    <!-- Receive Confirmation of Application Entry -->
    <bpmn:serviceTask id="ServiceTask_ReceiveConfirmation" name="Receive confirmation of application entry">
      <bpmn:incoming>SequenceFlow_ConfirmApplicationEntry</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ApplicationSuccessfulDecision</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Intermediate Throw Event for Feedback -->
    <bpmn:intermediateThrowEvent id="IntermediateEvent_FeedbackReceived" name="Feedback on application received">
      <bpmn:incoming>SequenceFlow_ConfirmationToFeedback</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ApplicationSuccessfulDecision</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <!-- Application Successful Decision Gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_ApplicationSuccess" name="Job application successful?">
      <bpmn:incoming>SequenceFlow_ConvergeOffersAndFeedback</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_InterviewNegotiationYes</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ApplicationLoopBackNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Interview Negotiation -->
    <bpmn:task id="Task_NegotiateJobInterview" name="Negotiate job interview">
      <bpmn:incoming>SequenceFlow_InterviewNegotiationYes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InterviewDecisionPoint</bpmn:outgoing>
    </bpmn:task>

    <!-- Interview Decision Gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_InterviewSuccess" name="Job interview successful?">
      <bpmn:incoming>SequenceFlow_InterviewDecisionPoint</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProbationPhaseYes</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ApplicationLoopBackNoInterview</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Probation Phase -->
    <bpmn:task id="Task_StartProbationPhase" name="Start job (probation phase)">
      <bpmn:incoming>SequenceFlow_ProbationPhaseYes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProbationTimerEvent</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Catch Event for Probation Finished -->
    <bpmn:intermediateCatchEvent id="IntermediateEvent_ProbationFinished" name="Probation phase finished">
      <bpmn:incoming>SequenceFlow_ProbationTimerEvent</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RateCompanyAndFeedback</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Rate Company Task -->
    <bpmn:task id="Task_RateCompany" name="Rate company">
      <bpmn:incoming>SequenceFlow_RateCompanyAndFeedback</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CompanyRatingDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Receive Feedback on Interview -->
    <bpmn:serviceTask id="ServiceTask_ReceiveInterviewFeedback" name="Receive feedback on interview">
      <bpmn:incoming>SequenceFlow_CompanyRatingDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReportFeedback</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Report Feedback Task -->
    <bpmn:task id="Task_ReportFeedback" name="Report feedback">
      <bpmn:incoming>SequenceFlow_ReportFeedback</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConvergeOffersAndFeedback</bpmn:outgoing>
    </bpmn:task>

    <!-- Job Permanent Decision Gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_JobPermanent" name="Job permanent?">
      <bpmn:incoming>SequenceFlow_ConvergeOffersAndFeedback</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CompanyRatingAboveCYes</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ProcessEndNoPermanent</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Company Rating Above C Decision Gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_CompanyRatingAboveC" name="Company rating above C?">
      <bpmn:incoming>SequenceFlow_CompanyRatingAboveCYes</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ProcessEndPermanentGoodRating</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ContinueReceivingOffersNoReport</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Receive Potential Job Offers (Loop Back) -->
    <bpmn:task id="Task_ReceivePotentialJobOffer_Loop" name="Receive potential job offers">
      <bpmn:incoming>SequenceFlow_ContinueReceivingOffersNoReport</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ConvergeToPermanentDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_ProcessFinished" name="Application process finished">
      <bpmn:incoming>SequenceFlow_EndFromGoodRating</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_UnemployedAgain" name="Unemployed">
      <bpmn:incoming>SequenceFlow_EndNoPermanentJob</bpmn:outgoing>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    
    <!-- Start to Application Loop -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToApplication" sourceRef="StartEvent_Unemployed" targetRef="Task_WriteJobApplication"/>

    <!-- Converge back to application loop from failed applications/interviews -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_ApplicationDecision" name="">
      <bpmn:incoming>SequenceFlow_StartToApplication</bpmn:outgoing>
      <bpmn:incoming>SequenceFlow_ApplicationLoopBackNo</bpmn:outgoing>
      <bpmn:incoming>SequenceFlow_ApplicationLoopBackNoInterview</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Application Loop Back from failed application -->
    <bpmn:sequenceFlow id="SequenceFlow_ApplicationLoopBackNo" name="no" sourceRef="ExclusiveGateway_ApplicationSuccess" targetRef="Task_WriteJobApplication"/>

    <!-- Interview Decision Point Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_InterviewDecisionPoint" sourceRef="Task_NegotiateJobInterview" targetRef="ExclusiveGateway_InterviewSuccess"/>

    <!-- Probation Phase Yes Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_ProbationPhaseYes" name="yes" sourceRef="ExclusiveGateway_InterviewSuccess" targetRef="Task_StartProbationPhase"/>

    <!-- Application Loop Back from failed interview -->
    <bpmn:sequenceFlow id="SequenceFlow_ApplicationLoopBackNoInterview" name="no" sourceRef="ExclusiveGateway_InterviewSuccess" targetRef="Task_WriteJobApplication"/>

    <!-- Probation Timer Event Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_ProbationTimerEvent" sourceRef="Task_StartProbationPhase" targetRef="IntermediateEvent_ProbationFinished"/>

    <!-- Rate Company and Feedback Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_RateCompanyAndFeedback" name="" sourceRef="IntermediateEvent_ProbationFinished" targetRef="Task_RateCompany"/>

    <!-- Converge Offers and Feedback Gateway -->
    <bpmn:parallelGateway id="ParallelGateway_ConvergeOffersAndFeedback" name="">
      <bpmn:incoming>SequenceFlow_ReceivePotentialJobOffer</bpmn:outgoing>
      <bpmn:incoming>SequenceFlow_ReportFeedback</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Converge to Permanent Decision -->
    <bpmn:sequenceFlow id="SequenceFlow_ConvergeToPermanentDecision" sourceRef="Task_ReceivePotentialJobOffer_Loop" targetRef="ExclusiveGateway_JobPermanent"/>

    <!-- Company Rating Above C Yes Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_CompanyRatingAboveCYes" name="yes" sourceRef="ExclusiveGateway_JobPermanent" targetRef="ExclusiveGateway_CompanyRatingAboveC"/>

    <!-- Process End No Permanent Job -->
    <bpmn:sequenceFlow id="SequenceFlow_ProcessEndNoPermanent" name="" sourceRef="ExclusiveGateway_JobPermanent" targetRef="EndEvent_UnemployedAgain"/>

    <!-- Company Rating Above C Yes to Process End Good Rating -->
    <bpmn:sequenceFlow id="SequenceFlow_CompanyRatingAboveCYesToProcessEndGoodRating" name="yes" sourceRef="ExclusiveGateway_CompanyRatingAboveC" targetRef="ParallelGateway_ConvergeOffersAndFeedback"/>

    <!-- Continue Receiving Offers No Report Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_ContinueReceivingOffersNoReport" name="" sourceRef="ExclusiveGateway_CompanyRatingAboveC" targetRef="Task_ReceivePotentialJobOffer_Loop"/>

    <!-- End From Good Rating -->
    <bpmn:endEvent id="EndEvent_ProcessFinishedGoodRating" name="Application process finished">
      <bpmn:incoming>SequenceFlow_EndFromGoodRating</bpmn:outgoing>
    </bpmn:endEvent>

    <!-- Sequence Flow for End From Good Rating -->
    <bpmn:sequenceFlow id="SequenceFlow_EndFromGoodRating" sourceRef="ExclusiveGateway_CompanyRatingAboveC" targetRef="EndEvent_ProcessFinished"/>

  </bpmn:process>
</bpmn:definitions>