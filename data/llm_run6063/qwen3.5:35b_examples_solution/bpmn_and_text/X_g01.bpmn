<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_courseRegistration">
    <bpmn:participant id="Participant_CourseRegistrationProcess" name="Course Registration Process" processRef="Process_CourseRegistration"/>
  </bpmn:collaboration>

  <!-- Global Elements -->
  <bpmn:message id="Message_activationResponse" name="Activation Response"/>

  <bpmn:process id="Process_CourseRegistration" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_wishToEnroll" name="Wish to enroll in course">
      <bpmn:outgoing>SequenceFlow_selectCourse</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Select Course Task -->
    <bpmn:userTask id="Task_selectCourse" name="Select a course">
      <bpmn:incoming>SequenceFlow_selectCourse</bpmn:incoming>
      <bpmn:outgoing>Gateway_checkFreeSpots</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Check Free Spots Gateway -->
    <bpmn:exclusiveGateway id="Gateway_checkFreeSpots" name="Slots free?">
      <bpmn:incoming>SequenceFlow_selectCourseResult</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_showCoursesYes</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_noSpotsAvailable</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- System Shows Courses Task -->
    <bpmn:serviceTask id="Task_showCourses" name="System shows courses and dates">
      <bpmn:incoming>SequenceFlow_showCoursesYes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_selectSpecificCourse</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Select Specific Course Task -->
    <bpmn:userTask id="Task_selectSpecificCourse" name="Select specific course">
      <bpmn:incoming>SequenceFlow_showCoursesYes</bpmn:incoming>
      <bpmn:outgoing>Gateway_checkAccountStatus</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Check Account Status Gateway -->
    <bpmn:exclusiveGateway id="Gateway_checkAccountStatus" name="Already registered?">
      <bpmn:incoming>SequenceFlow_selectSpecificCourseResult</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_loginToProcess</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_checkUniversityEligible</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Log Into Account Task -->
    <bpmn:userTask id="Task_logIntoAccount" name="Log into account">
      <bpmn:incoming>SequenceFlow_loginToProcess</bpmn:incoming>
      <bpmn:outgoing>ParallelGateway_accountReady</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Check University Eligibility Task -->
    <bpmn:userTask id="Task_checkUniversityEligible" name="Check if registered at eligible university">
      <bpmn:incoming>SequenceFlow_checkUniversityEligible</bpmn:incoming>
      <bpmn:outgoing>Gateway_universityEligibility</bpmn:outgoing>
    </bpmn:userTask>

    <!-- University Eligibility Gateway -->
    <bpmn:exclusiveGateway id="Gateway_universityEligibility" name="University eligible?">
      <bpmn:incoming>SequenceFlow_eligibilityCheckResult</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_registerAccountYes</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_requestActivationNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Register Account Task -->
    <bpmn:userTask id="Task_registerAccount" name="Register account">
      <bpmn:incoming>SequenceFlow_registerAccountYes</bpmn:incoming>
      <bpmn:outgoing>ParallelGateway_accountReady</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Request Activation Task -->
    <bpmn:userTask id="Task_requestActivation" name="Request activation">
      <bpmn:incoming>SequenceFlow_requestActivationNo</bpmn:incoming>
      <bpmn:outgoing>Event_waitForActivation</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Wait for Response Event -->
    <bpmn:intermediateCatchEvent id="Event_waitForActivation" name="Wait for response">
      <bpmn:messageRef>Message_activationResponse</bpmn:messageRef>
      <bpmn:incoming>SequenceFlow_requestActivationNo</bpmn:incoming>
      <bpmn:outgoing>ParallelGateway_accountReady</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Parallel Gateway - Account Ready -->
    <bpmn:parallelGateway id="ParallelGateway_accountReady" name="">
      <bpmn:incoming>SequenceFlow_loginToProcessResult</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_registerAccountYesResult</bpmn:incoming>
      <bpmn:outgoing>ParallelGateway_socialAndPaymentSplit</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Parallel Split for Twitter and Payment -->
    <bpmn:parallelGateway id="ParallelGateway_socialAndPaymentSplit" name="">
      <bpmn:incoming>SequenceFlow_accountReadyToProceed</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_connectTwitter</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_paymentInfo</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Connect to Twitter Task -->
    <bpmn:userTask id="Task_connectTwitter" name="Connect to twitter account">
      <bpmn:incoming>SequenceFlow_connectTwitter</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_inviteFriends</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Invite Friends Task -->
    <bpmn:userTask id="Task_inviteFriends" name="Tweet to friends">
      <bpmn:incoming>SequenceFlow_inviteFriends</bpmn:incoming>
      <bpmn:outgoing>ParallelGateway_convergeSocialPayment</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Provide Payment Info Task -->
    <bpmn:userTask id="Task_providePaymentInfo" name="Provide payment information">
      <bpmn:incoming>SequenceFlow_paymentInfo</bpmn:incoming>
      <bpmn:outgoing>ParallelGateway_convergeSocialPayment</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel Convergence Gateway -->
    <bpmn:parallelGateway id="ParallelGateway_convergeSocialPayment" name="">
      <bpmn:incoming>SequenceFlow_friendsInvitedResult</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_paymentInfoComplete</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_completeRegistration</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Complete Registration Task -->
    <bpmn:userTask id="Task_completeRegistration" name="Complete registration for course">
      <bpmn:incoming>SequenceFlow_completeRegistration</bpmn:incoming>
      <bpmn:outgoing>ServiceIssueTicket</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Issue Course Ticket Service Task -->
    <bpmn:serviceTask id="Service_issueCourseTickets" name="System issues course tickets">
      <bpmn:incoming>SequenceFlow_completeRegistrationResult</bpmn:incoming>
      <bpmn:outgoing>EndEvent_receiveTicket</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_receiveTicket" name="Receive course ticket">
      <bpmn:incoming>SequenceFlow_ticketReceived</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows - Course Selection Path -->
    <bpmn:sequenceFlow id="SequenceFlow_selectCourse" sourceRef="StartEvent_wishToEnroll" targetRef="Task_selectCourse"/>
    
    <bpmn:dataObjectReference id="Data_CourseSelection">
      <bpmn:name>Selected course details</bpmn:name>
    </bpmn:dataObjectReference>

    <!-- Association for data object -->
    <bpmn:association id="Association_courseDetails" sourceRef="Task_selectCourse" targetRef="Data_CourseSelection"/>

    <bpmn:sequenceFlow id="SequenceFlow_selectCourseResult" name="" sourceRef="Task_selectCourse" targetRef="Gateway_checkFreeSpots">
      <bpmn:name>Select course result</bpmn:name>
    </bpmn:sequenceFlow>
    
    <!-- Free Spots Decision -->
    <bpmn:sequenceFlow id="SequenceFlow_showCoursesYes" name="" sourceRef="Gateway_checkFreeSpots" targetRef="Task_showCourses">
      <bpmn:name>Slots free</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- No Spots Available Path -->
    <bpmn:userTask id="Task_checkAnotherCourse" name="Check if another course is interesting">
      <bpmn:incoming>SequenceFlow_noSpotsAvailable</bpmn:incoming>
      <bpmn:outgoing>Gateway_moreSelections</bpmn:outgoing>
    </bpmn:userTask>

    <!-- More Selection Gateway -->
    <bpmn:exclusiveGateway id="Gateway_moreSelections" name="">
      <bpmn:incoming>SequenceFlow_checkAnotherCourseResult</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_showCoursesYesAgain</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_proceedWithRegistrationNoMoreSelections</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Loop back to show courses -->
    <bpmn:sequenceFlow id="SequenceFlow_showCoursesYesAgain" name="" sourceRef="Gateway_moreSelections" targetRef="Task_showCourses"/>
    
    <!-- Continue with registration if no more selections -->
    <bpmn:exclusiveGateway id="Gateway_noMoreSelections" name="">
      <bpmn:incoming>SequenceFlow_checkAnotherCourseResult</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_showCoursesYesAgain</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Account Status Decision -->
    <bpmn:sequenceFlow id="SequenceFlow_selectSpecificCourseResult" name="" sourceRef="Task_selectSpecificCourse" targetRef="Gateway_checkAccountStatus">
      <bpmn:name>Select specific course result</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Not Registered Path -->
    <bpmn:sequenceFlow id="SequenceFlow_checkUniversityEligible" name="" sourceRef="Gateway_checkAccountStatus" targetRef="Task_checkUniversityEligible">
      <bpmn:name>No Account</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Eligibility Check Result -->
    <bpmn:dataObjectReference id="Data_UniversityRegistrationCheck">
      <bpmn:name>University registration status</bpmn:name>
    </bpmn:dataObjectReference>

    <bpmn:association id="Association_universityStatus" sourceRef="Task_checkUniversityEligible" targetRef="Data_UniversityRegistrationCheck"/>

    <!-- Eligibility Check Result -->
    <bpmn:sequenceFlow id="SequenceFlow_eligibilityCheckResult" name="" sourceRef="Task_checkUniversityEligible" targetRef="Gateway_universityEligibility">
      <bpmn:name>Eligibility check result</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Eligible - Register Account -->
    <bpmn:sequenceFlow id="SequenceFlow_registerAccountYes" name="" sourceRef="Gateway_universityEligibility" targetRef="Task_registerAccount">
      <bpmn:name>University Eligible</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Not Eligible - Request Activation -->
    <bpmn:sequenceFlow id="SequenceFlow_requestActivationNo" name="" sourceRef="Gateway_universityEligibility" targetRef="Task_requestActivation">
      <bpmn:name>Not University</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Account Ready to Proceed -->
    <bpmn:sequenceFlow id="SequenceFlow_loginToProcessResult" name="" sourceRef="Task_logIntoAccount" targetRef="ParallelGateway_accountReady">
      <bpmn:name>Login successful</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Register Account Result -->
    <bpmn:sequenceFlow id="SequenceFlow_registerAccountYesResult" name="" sourceRef="Task_registerAccount" targetRef="ParallelGateway_accountReady">
      <bpmn:name>Registration complete</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Account Ready to Proceed -->
    <bpmn:sequenceFlow id="SequenceFlow_accountReadyToProceed" name="" sourceRef="ParallelGateway_accountReady" targetRef="ParallelGateway_socialAndPaymentSplit">
      <bpmn:name>All accounts ready</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Twitter Connection -->
    <bpmn:dataObjectReference id="Data_TwitterConnection">
      <bpmn:name>Social media connection data</bpmn:name>
    </bpmn:dataObjectReference>

    <bpmn:association id="Association_twitter" sourceRef="Task_connectTwitter" targetRef="Data_TwitterConnection"/>

    <!-- Connect to Twitter -->
    <bpmn:sequenceFlow id="SequenceFlow_connectTwitter" name="" sourceRef="ParallelGateway_socialAndPaymentSplit" targetRef="Task_connectTwitter">
      <bpmn:name>Connect twitter</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Invite Friends -->
    <bpmn:sequenceFlow id="SequenceFlow_inviteFriends" name="" sourceRef="Task_connectTwitter" targetRef="Task_inviteFriends"/>

    <!-- Payment Info -->
    <bpmn:dataObjectReference id="Data_PaymentInfo">
      <bpmn:name>Payment information</bpmn:name>
    </bpmn:dataObjectReference>

    <bpmn:association id="Association_payment" sourceRef="Task_providePaymentInfo" targetRef="Data_PaymentInfo"/>

    <!-- Payment Info -->
    <bpmn:sequenceFlow id="SequenceFlow_paymentInfo" name="" sourceRef="ParallelGateway_socialAndPaymentSplit" targetRef="Task_providePaymentInfo">
      <bpmn:name>Provide payment</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Friends Invited Result -->
    <bpmn:sequenceFlow id="SequenceFlow_friendsInvitedResult" name="" sourceRef="Task_inviteFriends" targetRef="ParallelGateway_convergeSocialPayment">
      <bpmn:name>Friends invited</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Payment Info Complete -->
    <bpmn:sequenceFlow id="SequenceFlow_paymentInfoComplete" name="" sourceRef="Task_providePaymentInfo" targetRef="ParallelGateway_convergeSocialPayment">
      <bpmn:name>Payment complete</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Complete Registration -->
    <bpmn:dataObjectReference id="Data_CompleteRegistrationDetails">
      <bpmn:name>Complete registration details</bpmn:name>
    </bpmn:dataObjectReference>

    <bpmn:association id="Association_completeReg" sourceRef="Task_completeRegistration" targetRef="Data_CompleteRegistrationDetails"/>

    <!-- Complete Registration -->
    <bpmn:sequenceFlow id="SequenceFlow_completeRegistration" name="" sourceRef="ParallelGateway_convergeSocialPayment" targetRef="Task_completeRegistration">
      <bpmn:name>Complete registration</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Complete Registration Result -->
    <bpmn:sequenceFlow id="SequenceFlow_completeRegistrationResult" name="" sourceRef="Task_completeRegistration" targetRef="Service_issueCourseTickets">
      <bpmn:name>Registration complete</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Ticket Received -->
    <bpmn:dataObjectReference id="Data_CourseTicket">
      <bpmn:name>COURSE TICKET</bpmn:name>
    </bpmn:dataObjectReference>

    <bpmn:association id="Association_ticket" sourceRef="Service_issueCourseTickets" targetRef="Data_CourseTicket"/>

    <!-- Ticket Received -->
    <bpmn:sequenceFlow id="SequenceFlow_ticketReceived" name="" sourceRef="Service_issueCourseTickets" targetRef="EndEvent_receiveTicket">
      <bpmn:name>Receive ticket</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>