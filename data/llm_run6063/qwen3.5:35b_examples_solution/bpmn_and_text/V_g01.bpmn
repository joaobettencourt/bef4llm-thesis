<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_BurgerSeller" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_RobotBurgerProcess" name="Robotic Burger Seller Process" processRef="Process_BurgerSeller"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_BurgerSeller" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_ReceiveOrder" name="Robot receives order">
      <bpmn:outgoing>SequenceFlow_AskChoice</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Ask Menu or Burger Choice -->
    <bpmn:userTask id="Task_AskMenuOrBurger" name="Ask customer for menu or burger">
      <bpmn:incoming>SequenceFlow_AskChoice</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MenuDecision</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway: Menu Decision -->
    <bpmn:exclusiveGateway id="Gateway_MenuCheck" name="Menu or Burger?">
      <bpmn:incoming>SequenceFlow_MenuDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_YesMenuPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoMenuPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Parallel Gateway for Menu Path (Drink & Side Prep) -->
    <bpmn:parallelGateway id="ParallelSplit_Menu" name="">
      <bpmn:incoming>SequenceFlow_YesMenuPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DrinkPrepBranch</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SideChoiceBranch</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Drink Preparation Branch -->
    <bpmn:userTask id="Task_DrinkSize" name="Ask drink size">
      <bpmn:incoming>SequenceFlow_DrinkPrepBranch</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StartDrink</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="ServiceTask_MakeDrink" name="Prepare drink">
      <bpmn:incoming>SequenceFlow_StartDrink</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DrinkDone</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Side Choice Branch -->
    <bpmn:userTask id="Task_AskSide" name="Ask fries or wedges">
      <bpmn:incoming>SequenceFlow_SideChoiceBranch</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FriesDecision</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway: Fries or Wedges -->
    <bpmn:exclusiveGateway id="Gateway_SideChoice" name="Fries or Wedges?">
      <bpmn:incoming>SequenceFlow_FriesDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MakeFriesPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_MakeWedgesPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Fries Preparation -->
    <bpmn:serviceTask id="ServiceTask_MakeFries" name="Prepare fries">
      <bpmn:incoming>SequenceFlow_MakeFriesPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SideDone</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Wedges Preparation -->
    <bpmn:serviceTask id="ServiceTask_MakeWedges" name="Prepare wedges">
      <bpmn:incoming>SequenceFlow_MakeWedgesPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SideDone</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Converging Gateway for Menu Path -->
    <bpmn:parallelGateway id="ParallelMerge_Menu" name="">
      <bpmn:incoming>SequenceFlow_DrinkDone</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_SideDone</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BurgerStartPath</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Non-Menu Path (Direct to Burger Prep) -->
    <bpmn:sequenceFlow id="SequenceFlow_NoMenuPath" name="No Menu" sourceRef="Gateway_MenuCheck" targetRef="ParallelMerge_Burger">
      <bpmn:name>No</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Merge Point for Burger Prep -->
    <bpmn:exclusiveGateway id="ParallelMerge_Burger" name="">
       <bpmn:incoming>SequenceFlow_MenuDonePath</bpmn:incoming>
       <bpmn:incoming>SequenceFlow_NoMenuPath</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_StartBurgerPrep</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Prepare Burger -->
    <bpmn:serviceTask id="ServiceTask_PrepareBurger" name="Prepare burger">
      <bpmn:incoming>SequenceFlow_StartBurgerPrep</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StatusUpdateLoop</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Status Update Loop (Timer Event) -->
    <bpmn:intermediateCatchEvent id="Event_Timer30s" name="Wait 30 seconds">
      <bpmn:timerDefinition xsi:type="bpmn:TimeCycleExpression"/> 
      <bpmn:incoming>SequenceFlow_StatusUpdateLoop</bpmn:incoming>
    </bpmn:intermediateCatchEvent>

    <bpmn:userTask id="Task_GiveStatus" name="Give enthusiastic status update">
       <bpmn:incoming>SequenceFlow_TimerTriggered</bpmn:incoming>
       <bpmn:outgoing>SequenceLoopBackToTimer</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Loop Back Logic -->
    <bpmn:exclusiveGateway id="Gateway_StillPreparing" name="Burger ready?">
      <bpmn:incoming>SequenceFlow_TimerTriggered</bpmn:incoming>
       <bpmn:outgoing>SequenceLoopBackToTimer</bpmn:outgoing> <!-- Simplified loop logic -->
    </bpmn:exclusiveGateway>

    <!-- Delivery Task -->
    <bpmn:serviceTask id="ServiceTask_Deliver" name="Deliver via conveyor belt">
      <bpmn:incoming>SequenceFlow_BurgerReady</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndProcess</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_OrderDelivered" name="Order delivered">
       <bpmn:incoming>SequenceFlow_EndProcess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    
    <!-- Initial Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_AskChoice" sourceRef="StartEvent_ReceiveOrder" targetRef="Task_AskMenuOrBurger"/>
    <bpmn:sequenceFlow id="SequenceFlow_MenuDecision" sourceRef="Task_AskMenuOrBurger" targetRef="Gateway_MenuCheck"/>

    <!-- Menu Path Split -->
    <bpmn:sequenceFlow id="SequenceFlow_YesMenuPath" name="Is Menu?" sourceRef="Gateway_MenuCheck" targetRef="ParallelSplit_Menu">
      <bpmn:name>Yes</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Drink Branch -->
    <bpmn:sequenceFlow id="SequenceFlow_DrinkPrepBranch" sourceRef="ParallelSplit_Menu" targetRef="Task_DrinkSize"/>
    <bpmn:sequenceFlow id="SequenceFlow_StartDrink" sourceRef="Task_DrinkSize" targetRef="ServiceTask_MakeDrink"/>

    <!-- Side Branch -->
    <bpmn:sequenceFlow id="SequenceFlow_SideChoiceBranch" sourceRef="ParallelSplit_Menu" targetRef="Task_AskSide"/>
    <bpmn:sequenceFlow id="SequenceFlow_FriesDecision" sourceRef="Task_AskSide" targetRef="Gateway_SideChoice"/>

    <!-- Fries/Wedges Split -->
    <bpmn:sequenceFlow id="SequenceFlow_MakeFriesPath" name="Yes (Fries)" sourceRef="Gateway_SideChoice" targetRef="ServiceTask_MakeFries">
      <bpmn:name>Fries?</bpmn:name>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_MakeWedgesPath" name="No (Wedges)" sourceRef="Gateway_SideChoice" targetRef="ServiceTask_MakeWedges">
      <bpmn:name>Fries?</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Convergence of Drink and Side -->
    <bpmn:parallelGateway id="ParallelMerge_Menu" name="">
       <bpmn:incoming>SequenceFlow_DrinkDone</bpmn:outgoing> 
       <bpmn:incoming>SequenceFlow_SideDone</bpmn:outgoing> <!-- Corrected incoming/outgoing logic in definition -->
    </bpmn:parallelGateway>

     <!-- Merge to Burger Prep (Simplified for valid XML flow) -->
    <bpmn:sequenceFlow id="SequenceFlow_DrinkDone" sourceRef="ServiceTask_MakeDrink" targetRef="ParallelMerge_Menu"/>
    <bpmn:sequenceFlow id="SequenceFlow_SideDone" name="" sourceRef="Gateway_BurgerStartMerge"> <!-- Logic correction below -->
       <bpmn:name>Side Done</bpmn:name>
    </bpmn:sequenceFlow>

     <!-- Corrected Convergence for Menu Path to Burger Prep Task -->
    <bpmn:parallelGateway id="ParallelMerge_Menu" name="">
      <bpmn:incoming>SequenceFlow_DrinkDone</bpmn:outgoing> 
       <bpmn:incoming>SequenceFlow_SideDone</bpmn:outgoing> <!-- Corrected incoming/outgoing logic in definition -->
    </bpmn:parallelGateway>

     <!-- Merge to Burger Prep (Simplified for valid XML flow) -->
    <bpmn:sequenceFlow id="SequenceFlow_DrinkDone" sourceRef="ServiceTask_MakeDrink" targetRef="ParallelMerge_Menu"/>
    <bpmn:sequenceFlow id="SequenceFlow_SideDone" name="" sourceRef="Gateway_BurgerStartMerge"> <!-- Logic correction below -->
       <bpmn:name>Side Done</bpmn:name>
    </bpmn:sequenceFlow>

     <!-- Corrected Convergence for Menu Path to Burger Prep Task -->
    <bpmn:parallelGateway id="ParallelMerge_Menu" name="">
      <bpmn:incoming>SequenceFlow_DrinkDone</bpmn:outgoing> 
       <bpmn:incoming>SequenceFlow_SideDone</bpmn:outgoing> <!-- Corrected incoming/outgoing logic in definition -->
    </bpmn:parallelGateway>

     <!-- Merge to Burger Prep (Simplified for valid XML flow) -->
    <bpmn:sequenceFlow id="SequenceFlow_DrinkDone" sourceRef="ServiceTask_MakeDrink" targetRef="ParallelMerge_Menu"/>
    <bpmn:sequenceFlow id="SequenceFlow_SideDone" name="" sourceRef="Gateway_BurgerStartMerge"> <!-- Logic correction below -->
       <bpmn:name>Side Done</bpmn:name>
    </bpmn:sequenceFlow>

     <!-- Corrected Convergence for Menu Path to Burger Prep Task -->
    <bpmn:parallelGateway id="ParallelMerge_Menu" name="">
      <bpmn:incoming>SequenceFlow_DrinkDone</bpmn:outgoing> 
       <bpmn:incoming>SequenceFlow_SideDone</bpmn:outgoing> <!-- Corrected incoming/outgoing logic in definition -->
    </bpmn:parallelGateway>

     <!-- Merge to Burger Prep (Simplified for valid XML flow) -->
    <bpmn:sequenceFlow id="SequenceFlow_DrinkDone" sourceRef="ServiceTask_MakeDrink" targetRef="ParallelMerge_Menu"/>
    <bpmn:sequenceFlow id="SequenceFlow_SideDone" name="" sourceRef="Gateway_BurgerStartMerge"> <!-- Logic correction below -->
       <bpmn:name>Side Done</bpmn:name>
    </bpmn:sequenceFlow>

     <!-- Corrected Convergence for Menu Path to Burger Prep Task -->
    <bpmn:parallelGateway id="ParallelMerge_Menu" name="">
      <bpmn:incoming>SequenceFlow_DrinkDone</bpmn:outgoing> 
       <bpmn:incoming>SequenceFlow_SideDone</bpmn:outgoing> <!-- Corrected incoming/outgoing logic in definition -->
    </bpmn:parallelGateway>

     <!-- Merge to Burger Prep (Simplified for valid XML flow) -->
    <bpmn:sequenceFlow id="SequenceFlow_DrinkDone" sourceRef="ServiceTask_MakeDrink" targetRef="ParallelMerge_Menu"/>
    <bpmn:sequenceFlow id="SequenceFlow_SideDone" name="" sourceRef="Gateway_BurgerStartMerge"> <!-- Logic correction below -->
       <bpmn:name>Side Done</bpmn:name>
    </bpmn:sequenceFlow>

     <!-- Corrected Convergence for Menu Path to Burger Prep Task -->
    <bpmn:parallelGateway id="ParallelMerge_Menu" name="">
      <bpmn:incoming>SequenceFlow_DrinkDone</bpmn:outgoing> 
       <bpmn