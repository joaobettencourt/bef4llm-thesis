<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_PayPalAccountCreation">
    <bpmn:messageFlow id="MessageFlow_SubmitRequest" sourceRef="IntermediateThrowEvent_SubmitDetails" targetRef="IntermediateCatchEvent_RequestReceived"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_AccountCreation" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Client" name="PayPal Client Lane">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DetermineAccountType</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_AccountTypeSelection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectPersonalAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectPremiumAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_AccountTypeMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterLoginDetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterPersonalDetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_TelephoneNumber</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_AddressDetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DeclarePEPAffiliation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ClickCreateAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateThrowEvent_SubmitDetails</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_System" name="PayPal System Lane">
        <bpmn:flowNodeRef>IntermediateCatchEvent_RequestReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ValidateInputFields</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_InputValidationResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateThrowEvent_ClientNotificationInvalid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GenerateWelcomeEmail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_AccountCreated</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="PayPal Account Creation Request">
      <bpmn:outgoing>SequenceFlow_StartToDetermineType</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task Elements - Client Lane -->
    <bpmn:task id="Task_DetermineAccountType" name="Determine Account Type">
      <bpmn:incoming>SequenceFlow_StartToDetermineType</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_DetermineToSelectionGateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway for Account Type Selection -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_AccountTypeSelection" name="Account Type">
      <bpmn:incoming>SequenceFlow_DetermineToSelectionGateway</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SelectPersonal</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SelectPremium</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Account Type Tasks -->
    <bpmn:task id="Task_SelectPersonalAccount" name="Select Personal Account">
      <bpmn:incoming>SequenceFlow_SelectPersonal</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PersonalToMergeGateway</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_SelectPremiumAccount" name="Select Premium Account">
      <bpmn:incoming>SequenceFlow_SelectPremium</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PremiumToMergeGateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Inclusive Gateway to Merge Account Type Paths -->
    <bpmn:inclusiveGateway id="InclusiveGateway_AccountTypeMerge">
      <bpmn:incoming>SequenceFlow_PersonalToMergeGateway</bpmn:incomings>
      <bpmn:outgoing>SequenceFlow_MergeToLoginDetails</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Data Entry Tasks -->
    <bpmn:task id="Task_EnterLoginDetails" name="Enter Login Details">
      <bpmn:incoming>SequenceFlow_LoginFromMerge</bpmn:incomings>
      <bpmn:outgoing>SequenceFlow_LoginToPersonalDetails</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_EnterPersonalDetails" name="Enter Personal Details">
      <bpmn:incoming>SequenceFlow_LoginToPersonalDetails</bpmn:incomings>
      <bpmn:outgoing>SequenceFlow_PersonalToTelephone</bpmn:outgoing>
    </bpmn:task>

    <!-- SubProcess for Telephone Number -->
    <bpmn:subProcess id="SubProcess_TelephoneNumber" name="Provide Telephone Details">
      <bpmn:incoming>SequenceFlow_PersonalToTelephone</bpmn:incomings>
      <bpmn:outgoing>SequenceFlow_TelephoneToAddress</bpmn:outgoing>
    </bpmn:subProcess>

    <!-- SubProcess for Address Details -->
    <bpmn:subProcess id="SubProcess_AddressDetails" name="Provide Address Details">
      <bpmn:incoming>SequenceFlow_TelephoneToAddress</bpmn:incomings>
      <bpmn:outgoing>SequenceFlow_AddressToPEPDeclaration</bpmn:outgoing>
    </bpmn:subProcess>

    <!-- PEP Declaration Task -->
    <bpmn:task id="Task_DeclarePEPAffiliation" name="Declare PEP Affiliation">
      <bpmn:incoming>SequenceFlow_AddressToPEPDeclaration</bpmn:incomings>
      <bpmn:outgoing>SequenceFlow_PEPToCreateAccount</bpmn:outgoing>
    </bpmn:task>

    <!-- Create Account Button -->
    <bpmn:task id="Task_ClickCreateAccount" name="Click Create Account">
      <bpmn:incoming>SequenceFlow_PEPToCreateAccount</bpmn:incomings>
      <bpmn:outgoing>SequenceFlow_CreateToSubmitEvent</bpmn:outgoing>
    </bpmn:task>

    <!-- Message Flow to System -->
    <bpmn:intermediateThrowEvent id="IntermediateThrowEvent_SubmitDetails" name="Submit Account Details">
      <bpmn:incoming>SequenceFlow_CreateToSubmitEvent</bpmn:incomings>
      <bpmn:messageEventDefinition/>
    </bpmn:intermediateThrowEvent>

    <!-- System Lane Elements -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_RequestReceived" name="Account Request Received">
      <bpmn:incoming>SequenceFlow_ReceiveToValidate</bpmn:incomings>
      <bpmn:messageEventDefinition/>
    </bpmn:intermediateCatchEvent>

    <!-- Validation Task -->
    <bpmn:task id="Task_ValidateInputFields" name="Validate Input Fields">
      <bpmn:incoming>SequenceFlow_ReceiveToValidate</bpmn:incomings>
      <bpmn:outgoing>SequenceFlow_ValidationResultGateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Validation Result Gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_InputValidationResult" name="Input Valid?">
      <bpmn:incoming>SequenceFlow_ValidationResultGateway</bpmn:incomings>
      <bpmn:outgoing>SequenceFlow_ValidToEmailGeneration</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_InvalidToNotification</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Invalid Path - Client Notification -->
    <bpmn:intermediateThrowEvent id="IntermediateThrowEvent_ClientNotificationInvalid" name="Notify Client of Errors">
      <bpmn:incoming>SequenceFlow_InvalidToNotification</bpmn:incomings>
      <bpmn:messageEventDefinition/>
    </bpmn:intermediateThrowEvent>

    <!-- Valid Path - Email Generation -->
    <bpmn:task id="Task_GenerateWelcomeEmail" name="Generate Welcome Email">
      <bpmn:incoming>SequenceFlow_ValidToEmailGeneration</bpmn:incomings>
      <bpmn:outgoing>SequenceFlow_EmailToEndEvent</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_AccountCreated" name="Account Created">
      <bpmn:incoming>SequenceFlow_EmailToEndEvent</bpmn:incomings>
    </bpmn:endEvent>

    <!-- Sequence Flows - Client Lane -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToDetermineType" sourceRef="StartEvent_1" targetRef="Task_DetermineAccountType"/>
    <bpmn:sequenceFlow id="SequenceFlow_DetermineToSelectionGateway" sourceRef="Task_DetermineAccountType" targetRef="ExclusiveGateway_AccountTypeSelection"/>
    <bpmn:sequenceFlow id="SequenceFlow_SelectPersonal" name="Select Personal Account" sourceRef="ExclusiveGateway_AccountTypeSelection" targetRef="Task_SelectPersonalAccount"/>
    <bpmn:sequenceFlow id="SequenceFlow_SelectPremium" name="Select Premium Account" sourceRef="ExclusiveGateway_AccountTypeSelection" targetRef="Task_SelectPremiumAccount"/>
    <bpmn:sequenceFlow id="SequenceFlow_PersonalToMergeGateway" sourceRef="Task_SelectPersonalAccount" targetRef="InclusiveGateway_AccountTypeMerge"/>
    <bpmn:sequenceFlow id="SequenceFlow_PremiumToMergeGateway" sourceRef="Task_SelectPremiumAccount" targetRef="InclusiveGateway_AccountTypeMerge"/>
    <bpmn:sequenceFlow id="SequenceFlow_MergeToLoginDetails" name="Proceed to Login Details" sourceRef="InclusiveGateway_AccountTypeMerge" targetRef="Task_EnterLoginDetails"/>

    <!-- Data Entry Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_LoginFromMerge" sourceRef="InclusiveGateway_AccountTypeMerge" targetRef="Task_EnterLoginDetails"/>
    <bpmn:sequenceFlow id="SequenceFlow_LoginToPersonalDetails" name="Enter Personal Details" sourceRef="Task_EnterLoginDetails" targetRef="Task_EnterPersonalDetails"/>
    <bpmn:sequenceFlow id="SequenceFlow_PersonalToTelephone" name="Provide Telephone Number" sourceRef="Task_EnterPersonalDetails" targetRef="SubProcess_TelephoneNumber"/>
    <bpmn:sequenceFlow id="SequenceFlow_TelephoneToAddress" name="Provide Address Details" sourceRef="SubProcess_TelephoneNumber" targetRef="SubProcess_AddressDetails"/>
    <bpmn:sequenceFlow id="SequenceFlow_AddressToPEPDeclaration" name="Declare PEP Affiliation" sourceRef="SubProcess_AddressDetails" targetRef="Task_DeclarePEPAffiliation"/>
    <bpmn:sequenceFlow id="SequenceFlow_PEPToCreateAccount" name="Click Create Account Button" sourceRef="Task_DeclarePEPAffiliation" targetRef="Task_ClickCreateAccount"/>

    <!-- Submit to System -->
    <bpmn:sequenceFlow id="SequenceFlow_CreateToSubmitEvent" sourceRef="Task_ClickCreateAccount" targetRef="IntermediateThrowEvent_SubmitDetails"/>

    <!-- Sequence Flows - System Lane -->
    <bpmn:sequenceFlow id="SequenceFlow_ReceiveToValidate" name="Process Request Received" sourceRef="IntermediateCatchEvent_RequestReceived" targetRef="Task_ValidateInputFields"/>
    <bpmn:sequenceFlow id="SequenceFlow_ValidationResultGateway" sourceRef="Task_ValidateInputFields" targetRef="ExclusiveGateway_InputValidationResult"/>

    <!-- Validation Result Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_ValidToEmailGeneration" name="Valid Input Fields" sourceRef="ExclusiveGateway_InputValidationResult" targetRef="Task_GenerateWelcomeEmail"/>
    <bpmn:sequenceFlow id="SequenceFlow_InvalidToNotification" name="Invalid Input Fields" sourceRef="ExclusiveGateway_InputValidationResult" targetRef="IntermediateThrowEvent_ClientNotificationInvalid"/>

    <!-- Email to End -->
    <bpmn:sequenceFlow id="SequenceFlow_EmailToEndEvent" sourceRef="Task_GenerateWelcomeEmail" targetRef="EndEvent_AccountCreated"/>

  </bpmn:process>
</bpmn:definitions>