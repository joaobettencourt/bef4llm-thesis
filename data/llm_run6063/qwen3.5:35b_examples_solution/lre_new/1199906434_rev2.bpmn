<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_1">
  <bpmn:collaboration id="Collab_DataValidation">
    <bpmn:participant id="Pool_Technician" name="Drop-off tech&#10;" processRef="Process_Order"/>
    <bpmn:participant id="Pool_Customer" name="Customer"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Order">
    
    <!-- Start Event -->
    <bpmn:startEvent id="Start_ErrorNotification" name="IS notified about data validation error&#10;">
      <bpmn:outgoing>Flow_Start_CheckTypos</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1 -->
    <bpmn:task id="Task_CheckTypo" name="Drop-off tech checks for typos">
      <bpmn:incoming>Flow_Start_CheckTypos</bpmn:incoming>
      <bpmn:outgoing>Flow_TypoDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1 -->
    <bpmn:exclusiveGateway id="Gw_TypoFound" name="Typo&#10;found?">
      <bpmn:incoming>Flow_TypoDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_ResolvedByTech</bpmn:outgoing> <!-- Yes -->
    </bpmn:exclusiveGateway>

    <!-- Task 2 -->
    <bpmn:task id="Task_CustomerCheck" name="Technician checks if&#10;customer can correct">
      <bpmn:incoming>Flow_TypoDecision</bpmn:outgoing>
      <bpmn:outgoing>Flow_CorrectionDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2 -->
    <bpmn:exclusiveGateway id="Gw_CustomerCanCorrect" name="Customer&#10;can correct?">
      <bpmn:incoming>Flow_CorrectionDecision</bpmn:outgoing>
      <bpmn:outgoing>Flow_ResolvedByCustomer</bpmn:outgoing> <!-- Yes -->
    </bpmn:exclusiveGateway>

    <!-- Task 3 -->
    <bpmn:task id="Task_PublicSources" name="Scour public&#10;sources for solutions">
      <bpmn:incoming>Flow_NoCustomerCorrection</bpmn:outgoing>
      <bpmn:outgoing>Flow_SolutionDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 3 -->
    <bpmn:exclusiveGateway id="Gw_SolutionFound" name="Solution&#10;found?">
      <bpmn:incoming>Flow_SolutionDecision</bpmn:outgoing>
      <bpmn:outgoing>Flow_ResolvedByPublic</bpmn:outgoing> <!-- Yes -->
    </bpmn:exclusiveGateway>

    <!-- End Events -->
    <bpmn:endEvent id="End_Resolved" name="Issue was&#10;resolved">
      <bpmn:incoming>Flow_ResolvedByTech</bpmn:outgoing>
      <bpmn:incoming>Flow_ResolvedByCustomer</bpmn:outgoing>
      <bpmn:incoming>Flow_ResolvedByPublic</bpmn:outgoing>
    </bpmn:endEvent>

    <!-- End Event Unresolved -->
    <bpmn:endEvent id="End_Unresolvable" name="Issue was&#10;un-resolvable">
      <bpmn:incoming>Flow_NoSolutionFound</bpmn:outgoing>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Flow_Start_CheckTypos" sourceRef="Start_ErrorNotification" targetRef="Task_CheckTypo"/>
    
    <bpmn:exclusiveGateway id="Gw_TypoFound">
      <bpmn:incoming>Flow_TypoDecision</bpmn:outgoing>
      <bpmn:outgoing>Flow_ResolvedByTech</bpmn:outgoing> <!-- Yes -->
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="Flow_TypoDecision" name="No typo&#10;found" sourceRef="Task_CheckTypo" targetRef="Gw_TypoFound"/>
    
    <bpmn:task id="Task_CustomerCheck">
      <bpmn:incoming>Flow_NoTypoCustomer</bpmn:outgoing>
      <bpmn:outgoing>Flow_CorrectionDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Correcting flow logic for Gateway 1 -->
    <bpmn:sequenceFlow id="Flow_NoTypoCustomer" name="No typo&#10;found" sourceRef="Gw_TypoFound" targetRef="Task_CustomerCheck"/>
    
    <bpmn:exclusiveGateway id="Gw_CorrectionDecision">
      <bpmn:incoming>Flow_CorrectionDecision</bpmn:outgoing>
      <bpmn:outgoing>Flow_ResolvedByCustomer</bpmn:outgoing> <!-- Yes -->
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="Flow_CorrectionDecision" sourceRef="Task_CustomerCheck" targetRef="Gw_CorrectionDecision"/>
    
    <bpmn:task id="Task_PublicSources">
      <bpmn:incoming>Flow_NoCustomerCorrection</bpmn:outgoing>
      <bpmn:outgoing>Flow_SolutionDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Correcting flow logic for Gateway 2 -->
    <bpmn:sequenceFlow id="Flow_NoCustomerCorrection" name="No" sourceRef="Gw_CorrectionDecision" targetRef="Task_PublicSources"/>
    
    <bpmn:exclusiveGateway id="Gw_SolutionFound">
      <bpmn:incoming>Flow_SolutionDecision</bpmn:outgoing>
      <bpmn:outgoing>Flow_ResolvedByPublic</bpmn:outgoing> <!-- Yes -->
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="Flow_SolutionDecision" sourceRef="Task_PublicSources" targetRef="Gw_SolutionFound"/>
    
    <bpmn:endEvent id="End_Resolved">
      <bpmn:incoming>Flow_ResolvedByTech</bpmn:outgoing>
      <bpmn:incoming>Flow_ResolvedByCustomer</bpmn:outgoing>
      <bpmn:incoming>Flow_ResolvedByPublic</bpmn:outgoing>
    </bpmn:endEvent>

    <!-- Correcting flow logic for Gateway 3 -->
    <bpmn:sequenceFlow id="Flow_NoSolutionFound" name="No solution&#10;found" sourceRef="Gw_SolutionFound" targetRef="End_Unresolvable"/>
    
    <bpmn:endEvent id="End_Unresolvable">
      <bpmn:incoming>Flow_NoSolutionFound</bpmn:outgoing>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>