<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_OrderDelivery">
    <bpmn:participant id="Participant_EshopStaff" name="E-shop Staff&#10;" processRef="Process_EshopOrderProcessing" />
    <bpmn:participant id="Participant_CourierCompany" name="Courier Company&#10;System&#10;" processRef="Process_DeliveryManagement" />
  </bpmn:collaboration>

  <!-- E-shop Staff Process -->
  <bpmn:process id="Process_EshopOrderProcessing" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_StaffReview" name="E-shop&#10;Staff">
        <bpmn:flowNodeRef>StartEvent_OrderReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CheckAvailability</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BoundaryEvent_DiscontinuedItem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformCustomerDelay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OrderMissingProducts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateTimerEvent_WaitingPeriod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CheckAfterWait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecollectProducts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PreparePackage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_OrderReadyForCourier</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Eshop_1" name="Order Received">
      <bpmn:outgoing>SequenceFlow_ReviewOrder</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task Elements - E-shop Staff Lane -->
    <bpmn:userTask id="Task_Eshop_ReviewOrder" name="Review Order&#10;and Check Items">
      <bpmn:incoming>SequenceFlow_ReviewOrder</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CheckAvailability</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Decision Point 1 - Availability Check -->
    <bpmn:exclusiveGateway id="Gateway_Eshop_Availability" name="All Items&#10;Available?">
      <bpmn:incoming>SequenceFlow_CheckAvailability</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ItemsOK</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SomethingMissing</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Boundary Event for Discontinued Item Exception -->
    <bpmn:boundaryEvent id="BoundaryEvent_Eshop_Discontinued" attachedToRef="Task_OrderMissingProducts">
      <bpmn:outgoing>SequenceFlow_InformUnavailable</bpmn:outgoing>
      <bpmn:errorEventDefinition />
    </bpmn:boundaryEvent>

    <!-- Task - Inform Customer About Delay -->
    <bpmn:userTask id="Task_Eshop_InformDelay" name="Inform Customer&#10;About Potential Delay">
      <bpmn:incoming>SequenceFlow_SomethingMissing</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_OrderProducts</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task - Order Missing Products -->
    <bpmn:userTask id="Task_Eshop_Order" name="Order Missing&#10;Products from Supplier">
      <bpmn:incoming>SequenceFlow_OrderProducts</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_WaitingPeriodStart</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Intermediate Timer Event - Waiting Period -->
    <bpmn:intermediateThrowEvent id="IntermediateTimer_Eshop" name="Wait x Days&#10;for Delivery">
      <bpmn:incoming>SequenceFlow_WaitingPeriodStart</bpmn:outgoing>
      <bpmn:timerEventDefinition />
    </bpmn:intermediateThrowEvent>

    <!-- Decision Point 2 - Check After Wait -->
    <bpmn:exclusiveGateway id="Gateway_Eshop_CheckAfter" name="All Products&#10;On Store?">
      <bpmn:incoming>SequenceFlow_WaitingPeriodEnd</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_AllOK</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task - Recollect Products -->
    <bpmn:userTask id="Task_Eshop_Recollect" name="Recollect All&#10;Products">
      <bpmn:incoming>SequenceFlow_AllOK</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PreparePackageStart</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task - Prepare Package -->
    <bpmn:userTask id="Task_Eshop_Package" name="Prepare&#10;Package">
      <bpmn:incoming>SequenceFlow_PreparePackageStart</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_InformCourier</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event - Order Ready -->
    <bpmn:endEvent id="EndEvent_Eshop_Ready" name="Order&#10;Ready">
      <bpmn:incoming>SequenceFlow_InformCourier</bpmn:outgoing>
    </bpmn:endEvent>

    <!-- Sequence Flows - E-shop Staff Lane -->
    <bpmn:sequenceFlow id="Seq_Eshop_Review" sourceRef="StartEvent_Eshop_1" targetRef="Task_Eshop_ReviewOrder" />
    <bpmn:sequenceFlow id="Seq_Eshop_CheckAvail" sourceRef="Task_Eshop_ReviewOrder" targetRef="Gateway_Eshop_Availability" />

    <!-- Decision Flows from Gateway_CheckAvailability -->
    <bpmn:sequenceFlow id="Seq_Eshop_ItemsOK" name="Yes - All Available" sourceRef="Gateway_Eshop_Availability" targetRef="EndEvent_Eshop_Ready" />
    <bpmn:sequenceFlow id="Seq_Eshop_Missing" name="No - Something Missing" sourceRef="Gateway_Eshop_Availability" targetRef="Task_Eshop_InformDelay" />

    <!-- Flows for Order Process -->
    <bpmn:sequenceFlow id="Seq_Eshop_OrderProd" sourceRef="Task_Eshop_InformDelay" targetRef="Task_Eshop_Order" />
    <bpmn:sequenceFlow id="Seq_Eshop_WaitStart" sourceRef="Task_Eshop_Order" targetRef="IntermediateTimer_Eshop" />

    <!-- Flows After Waiting Period -->
    <bpmn:sequenceFlow id="Seq_Eshop_WaitEnd" name="After x Days" sourceRef="IntermediateTimer_Eshop" targetRef="Gateway_Eshop_CheckAfter" />

    <!-- Decision Flow from Gateway_CheckAfterWait -->
    <bpmn:sequenceFlow id="Seq_Eshop_AllOK" name="Yes - All OK" sourceRef="Gateway_Eshop_CheckAfter" targetRef="Task_Eshop_Recollect" />

    <!-- Flows for Package Preparation -->
    <bpmn:sequenceFlow id="Seq_Eshop_PkgStart" sourceRef="Task_Eshop_Recollect" targetRef="Task_Eshop_Package" />
    <bpmn:sequenceFlow id="Seq_Eshop_InformCourier" name="Inform Courier&#10;About Prepared Package" sourceRef="Task_Eshop_Package" targetRef="EndEvent_Eshop_Ready" />

  </bpmn:process>

  <!-- Courier Company Process -->
  <bpmn:process id="Process_DeliveryManagement" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_CourierStaff" name="Courier&#10;Company Staff">
        <bpmn:flowNodeRef>StartEvent_CourierNotification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CheckResources</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformClientDelay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateCatchEvent_WaitDriverAvailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_EnoughResources</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PickupPackage</bpmn:flowNodeRef>
        <bpmn:serviceTask id="ServiceTask_RoutePlanning" name="Decide Best&#10;Route For All Packages">
          <bpmn:incoming>SequenceFlow_RoutePlanningStart</bpmn:outgoing>
          <bpmn:outgoing>SequenceFlow_DeliveryStart</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:userTask id="Task_Courier_Pickup" name="Pick Up&#10;Designated Driver">
          <bpmn:incoming>SequenceFlow_PickupOK</bpmn:outgoing>
          <bpmn:outgoing>Seq_Courier_RouteStart</bpmn:outgoing>
        </bpmn:userTask>
        <bpmn:userTask id="Task_Courier_Deliver" name="Deliver&#10;Package">
          <bpmn:incoming>SequenceFlow_DeliveryStart</bpmn:outgoing>
          <bpmn:outgoing>Seq_Courier_UpdateStart</bpmn:outgoing>
        </bpmn:userTask>
        <bpmn:userTask id="Task_Courier_Update" name="Update System&#10;Notify Stakeholders">
          <bpmn:incoming>SequenceFlow_UpdateSystemStart</bpmn:outgoing>
          <bpmn:outgoing>Seq_Courier_Complete</bpmn:outgoing>
        </bpmn:userTask>
        <bpmn:endEvent id="EndEvent_Courier_Complete" name="Delivery&#10;Complete">
          <bpmn:incoming>SequenceFlow_ProcessComplete</bpmn:outgoing>
        </bpmn:endEvent>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event - Courier Notification -->
    <bpmn:startEvent id="StartEvent_Courier_1" name="Courier&#10;Notified">
      <bpmn:outgoing>SequenceFlow_CheckResources</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Decision Point - Check Resources -->
    <bpmn:exclusiveGateway id="Gateway_Courier_Resources" name="Enough&#10;Human Resources?">
      <bpmn:incoming>SequenceFlow_CheckResources</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_YesResources</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoResources</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task - Inform Client About Delay -->
    <bpmn:userTask id="Task_Courier_InformDelay" name="Inform Client&#10;About Potential Delay">
      <bpmn:incoming>SequenceFlow_NoResources</bpmn:outgoing>
      <bpmn:outgoing>Seq_Courier_WaitStart</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Intermediate Catch Event - Wait for Driver -->
    <bpmn:intermediateCatchEvent id="IntermediateCatch_DriverWait" name="Wait For&#10;Free Driver">
      <bpmn:incoming>SequenceFlow_WaitDriverAvailableStart</bpmn:outgoing>
      <bpmn:timerEventDefinition />
    </bpmn:intermediateCatchEvent>

    <!-- Decision Point - Enough Resources -->
    <bpmn:exclusiveGateway id="Gateway_Courier_Ready" name="Ready&#10;For Pickup?">
      <bpmn:incoming>SequenceFlow_WaitDriverAvailableEnd</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PickupOK</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task - Pickup Package -->
    <bpmn:userTask id="Task_Courier_Pickup" name="Pick Up&#10;Designated Driver">
      <bpmn:incoming>SequenceFlow_PickupOK</bpmn:outgoing>
      <bpmn:outgoing>Seq_Courier_RouteStart</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Service Task - Route Planning -->
    <bpmn:serviceTask id="ServiceTask_Courier" name="Decide Best&#10;Route For All Packages">
      <bpmn:incoming>SequenceFlow_RoutePlanningStart</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_DeliveryStart</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Task - Deliver Package -->
    <bpmn:userTask id="Task_Courier_Deliver" name="Deliver&#10;Package">
      <bpmn:incoming>SequenceFlow_DeliveryStart</bpmn:outgoing>
      <bpmn:outgoing>Seq_Courier_UpdateStart</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task - Update System -->
    <bpmn:userTask id="Task_Courier_Update" name="Update System&#10;Notify Stakeholders">
      <bpmn:incoming>SequenceFlow_UpdateSystemStart</bpmn:outgoing>
      <bpmn:outgoing>Seq_Courier_Complete</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Courier_Complete" name="Delivery&#10;Complete">
      <bpmn:incoming>SequenceFlow_ProcessComplete</bpmn:outgoing>
    </bpmn:endEvent>

    <!-- Sequence Flows - Courier Company Lane -->
    <bpmn:sequenceFlow id="Seq_Courier_Resources" sourceRef="StartEvent_Courier_1" targetRef="Gateway_Courier_Resources" />

    <!-- Decision Flows from Gateway_CheckResources -->
    <bpmn:sequenceFlow id="Seq_Courier_YesRes" name="Yes - Enough Resources" sourceRef="Gateway_Courier_Resources" targetRef="Task_Courier_Pickup" />
    <bpmn:sequenceFlow id="Seq_Courier_NoRes" name="No - Not Enough Resources" sourceRef="Gateway_Courier_Resources" targetRef="Task_Courier_InformDelay" />

    <!-- Flows for Resource Check -->
    <bpmn:sequenceFlow id="Seq_Courier_WaitStart" sourceRef="Task_Courier_InformDelay" targetRef="IntermediateCatch_DriverWait" />
    <bpmn:sequenceFlow id="Seq_Courier_WaitEnd" name="After Wait" sourceRef="IntermediateCatch_DriverWait" targetRef="Gateway_Courier_Ready" />

    <!-- Decision Flow from Gateway_EnoughResources -->
    <bpmn:sequenceFlow id="Seq_Courier_PickupOK" name="Yes - Ready For Pickup" sourceRef="Gateway_Courier_Ready" targetRef="Task_Courier_Pickup" />

    <!-- Flows for Delivery Process -->
    <bpmn:sequenceFlow id="Seq_Courier_RouteStart" sourceRef="Task_Courier_Pickup" targetRef="ServiceTask_Courier" />
    <bpmn:sequenceFlow id="Seq_Courier_Delivery" name="Best Route&#10;Decided" sourceRef="ServiceTask_Courier" targetRef="Task_Courier_Deliver" />
    <bpmn:sequenceFlow id="Seq_Courier_UpdateStart" sourceRef="Task_Courier_Deliver" targetRef="Task_Courier_Update" />
    <bpmn:sequenceFlow id="Seq_Courier_Complete" name="Stakeholders&#10;Notified" sourceRef="Task_Courier_Update" targetRef="EndEvent_Courier_Complete" />

  </bpmn:process>

</bpmn:definitions>