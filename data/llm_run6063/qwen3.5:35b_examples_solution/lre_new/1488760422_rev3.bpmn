<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_InvoiceProcess">
    <bpmn:participant id="Participant_SSP" name="SSP Admin Office" processRef="Process_InvoiceProcessing" />
    <bpmn:participant id="Participant_Client" name="Client" />
  </bpmn:collaboration>

  <bpmn:process id="Process_InvoiceProcessing" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_AdminOffice" name="Admin Office">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveInvoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SortPerClient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SortPerVendor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AttachForm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_EnterInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateCatchEvent_ClientComplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckCompleteness</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_CompletenessCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_IncompleteInvoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterSLAInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckPriority</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_PriorityCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ApplyRedStamp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_MergePriority</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckCompliance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_ComplianceCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AllocateToDEO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ProcessComplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_ResolveOptions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendToExperienceStaff</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CallClientRequestInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateThrowEvent_Timer10Hours</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendReminder</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Receive Invoice">
      <bpmn:messageEventDefinition />
      <bpmn:outgoing>SequenceFlow_Start</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_IncompleteInvoice" name="Process Finished">
      <bpmn:messageEventDefinition />
      <bpmn:incoming>SequenceFlow_NotComplete</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_ProcessComplete" name="Allocate to DEO">
      <bpmn:incoming>SequenceFlow_ToDEO</bpmn:outgoing>
    </bpmn:endEvent>

    <!-- Tasks -->
    <bpmn:task id="Task_ReceiveInvoice" name="Admin office receives invoice">
      <bpmn:incoming>SequenceFlow_Start</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SortClient</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_SortPerClient" name="Sort invoice per client">
      <bpmn:incoming>SequenceFlow_SortClient</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SortVendor</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_SortPerVendor" name="Sort invoice per vendor">
      <bpmn:incoming>SequenceFlow_SortVendor</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AttachForm</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_AttachForm" name="Attach invoice entry form to invoice">
      <bpmn:incoming>SequenceFlow_AttachForm</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EnterInfoStart</bpmn:outgoing>
    </bpmn:task>

    <!-- SubProcess for entering required info -->
    <bpmn:subProcess id="SubProcess_EnterInfo" name="Enter required info on invoice entry form">
      <bpmn:incoming>SequenceFlow_EnterInfoStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckCompletenessTrigger</bpmn:outgoing>
    </bpmn:subProcess>

    <!-- Intermediate Catch Event for client completion -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_ClientComplete" name="Client completes invoice">
      <bpmn:messageEventDefinition />
      <bpmn:incoming>SequenceFlow_CheckCompletenessTrigger</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StartCheckCompleteness</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Check Completeness -->
    <bpmn:task id="Task_CheckCompleteness" name="Check completeness of invoice">
      <bpmn:incoming>SequenceFlow_StartCheckCompleteness</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CompletenessDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Decision Point 1: Completeness -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_CompletenessCheck" name="Invoice complete?">
      <bpmn:incoming>SequenceFlow_CompletenessDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NotComplete2</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_IsComplete</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Decision Point 2: Priority -->
    <bpmn:task id="Task_EnterSLAInfo" name="Enter info for SLA">
      <bpmn:incoming>SequenceFlow_IsComplete</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckPriorityStart</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_CheckPriority" name="Check priority">
      <bpmn:incoming>SequenceFlow_CheckPriorityStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PriorityDecision</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="ExclusiveGateway_PriorityCheck" name="High priority?">
      <bpmn:incoming>SequenceFlow_PriorityDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_HighPriority</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_LowOrNormal</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task for high priority -->
    <bpmn:task id="Task_ApplyRedStamp" name="Apply red stamp on entry invoice">
      <bpmn:incoming>SequenceFlow_HighPriority</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeToComplianceCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Merge point after priority decision -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_MergePriority">
      <bpmn:incoming>SequenceFlow_LowOrNormal</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_MergeToComplianceCheck</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CheckComplianceStart</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Decision Point 3: Compliance -->
    <bpmn:task id="Task_CheckCompliance" name="Check invoice compliance">
      <bpmn:incoming>SequenceFlow_CheckComplianceStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ComplianceDecision</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="ExclusiveGateway_ComplianceCheck" name="Invoice compliant?">
      <bpmn:incoming>SequenceFlow_ComplianceDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_IsCompliant</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NotCompliant2</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Final allocation -->
    <bpmn:task id="Task_AllocateToDEO" name="Allocate invoice to DEO">
      <bpmn:incoming>SequenceFlow_ToAllocationPoint</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToEndEvent</bpmn:outgoing>
    </bpmn:task>

    <!-- Decision Point 4: Resolve Options -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_ResolveOptions" name="Resolution method?">
      <bpmn:incoming>SequenceFlow_NotCompliant2</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SendToExperienceStaff</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CallClientRequestInfo</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SendPostalMail</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Resolution Tasks -->
    <bpmn:task id="Task_SendToExperienceStaff" name="Send to experience staff">
      <bpmn:incoming>SequenceFlow_SendToExperienceStaff</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeResolution1</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_CallClientRequestInfo" name="Call client and request for information">
      <bpmn:incoming>SequenceFlow_CallClientRequestInfo</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeResolution2</bpmn:outgoing>
    </bpmn:task>

    <!-- Timer-based reminder path -->
    <bpmn:intermediateThrowEvent id="IntermediateThrowEvent_Timer10Hours" name="After 10 hours">
      <bpmn:timerEventDefinition />
      <bpmn:incoming>SequenceFlow_SendPostalMail</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_TriggerReminder</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <bpmn:task id="Task_SendReminder" name="Send reminder">
      <bpmn:incoming>SequenceFlow_TriggerReminder</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeResolution3</bpmn:outgoing>
    </bpmn:task>

    <!-- Merge all resolution paths -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_MergeResolutions">
      <bpmn:incoming>SequenceFlow_IsCompliant2</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_MergeResolution1</bpmn:outgoing>
      <bpmn:incoming>SequenceFlow_MergeResolution2</bpmn:outgoing>
      <bpmn:incoming>SequenceFlow_MergeResolution3</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ToAllocationPoint</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_Start" sourceRef="StartEvent_1" targetRef="Task_ReceiveInvoice" />
    <bpmn:sequenceFlow id="SequenceFlow_SortClient" name="" sourceRef="Task_ReceiveInvoice" targetRef="Task_SortPerClient" />
    <bpmn:sequenceFlow id="SequenceFlow_SortVendor" name="" sourceRef="Task_SortPerClient" targetRef="Task_SortPerVendor" />
    <bpmn:sequenceFlow id="SequenceFlow_AttachForm" name="" sourceRef="Task_SortPerVendor" targetRef="Task_AttachForm" />
    <bpmn:sequenceFlow id="SequenceFlow_EnterInfoStart" name="" sourceRef="Task_AttachForm" targetRef="SubProcess_EnterInfo" />
    <bpmn:sequenceFlow id="SequenceFlow_CheckCompletenessTrigger" name="" sourceRef="SubProcess_EnterInfo" targetRef="IntermediateCatchEvent_ClientComplete" />
    <bpmn:sequenceFlow id="SequenceFlow_StartCheckCompleteness" name="" sourceRef="IntermediateCatchEvent_ClientComplete" targetRef="Task_CheckCompleteness" />
    <bpmn:sequenceFlow id="SequenceFlow_CompletenessDecision" name="" sourceRef="Task_CheckCompleteness" targetRef="ExclusiveGateway_CompletenessCheck" />
    <bpmn:sequenceFlow id="SequenceFlow_NotComplete2" name="No - Not complete" sourceRef="ExclusiveGateway_CompletenessCheck" targetRef="EndEvent_IncompleteInvoice" />
    <bpmn:sequenceFlow id="SequenceFlow_IsComplete" name="Yes - Complete" sourceRef="ExclusiveGateway_CompletenessCheck" targetRef="Task_EnterSLAInfo" />
    <bpmn:sequenceFlow id="SequenceFlow_CheckPriorityStart" name="" sourceRef="Task_EnterSLAInfo" targetRef="Task_CheckPriority" />
    <bpmn:sequenceFlow id="SequenceFlow_PriorityDecision" name="" sourceRef="Task_CheckPriority" targetRef="ExclusiveGateway_PriorityCheck" />
    <bpmn:sequenceFlow id="SequenceFlow_HighPriority" name="High priority" sourceRef="ExclusiveGateway_PriorityCheck" targetRef="Task_ApplyRedStamp" />
    <bpmn:sequenceFlow id="SequenceFlow_LowOrNormal" name="Low/Normal" sourceRef="ExclusiveGateway_PriorityCheck" targetRef="ExclusiveGateway_MergePriority" />
    <bpmn:sequenceFlow id="SequenceFlow_MergeToComplianceCheck" name="" sourceRef="Task_ApplyRedStamp" targetRef="ExclusiveGateway_MergePriority" />
    <bpmn:sequenceFlow id="SequenceFlow_CheckComplianceStart" name="" sourceRef="ExclusiveGateway_MergePriority" targetRef="Task_CheckCompliance" />
    <bpmn:sequenceFlow id="SequenceFlow_ComplianceDecision" name="" sourceRef="Task_CheckCompliance" targetRef="ExclusiveGateway_ComplianceCheck" />
    <bpmn:sequenceFlow id="SequenceFlow_IsCompliant2" name="Yes - Compliant" sourceRef="ExclusiveGateway_ComplianceCheck" targetRef="ExclusiveGateway_MergeResolutions" />
    <bpmn:sequenceFlow id="SequenceFlow_NotCompliant2" name="No - Not compliant" sourceRef="ExclusiveGateway_ComplianceCheck" targetRef="ExclusiveGateway_ResolveOptions" />
    <bpmn:sequenceFlow id="SequenceFlow_SendToExperienceStaff" name="" sourceRef="ExclusiveGateway_ResolveOptions" targetRef="Task_SendToExperienceStaff" />
    <bpmn:sequenceFlow id="SequenceFlow_CallClientRequestInfo" name="" sourceRef="ExclusiveGateway_ResolveOptions" targetRef="Task_CallClientRequestInfo" />
    <bpmn:sequenceFlow id="SequenceFlow_SendPostalMail" name="" sourceRef="ExclusiveGateway_ResolveOptions" targetRef="IntermediateThrowEvent_Timer10Hours" />
    <bpmn:sequenceFlow id="SequenceFlow_TriggerReminder" name="" sourceRef="IntermediateThrowEvent_Timer10Hours" targetRef="Task_SendReminder" />
    <bpmn:sequenceFlow id="SequenceFlow_MergeResolution1" name="" sourceRef="Task_SendToExperienceStaff" targetRef="ExclusiveGateway_MergeResolutions" />
    <bpmn:sequenceFlow id="SequenceFlow_MergeResolution2" name="" sourceRef="Task_CallClientRequestInfo" targetRef="ExclusiveGateway_MergeResolutions" />
    <bpmn:sequenceFlow id="SequenceFlow_MergeResolution3" name="" sourceRef="Task_SendReminder" targetRef="ExclusiveGateway_MergeResolutions" />
    <bpmn:sequenceFlow id="SequenceFlow_ToAllocationPoint" name="" sourceRef="ExclusiveGateway_MergeResolutions" targetRef="Task_AllocateToDEO" />
    <bpmn:sequenceFlow id="SequenceFlow_ToEndEvent" name="" sourceRef="Task_AllocateToDEO" targetRef="EndEvent_ProcessComplete" />

  </bpmn:process>
</bpmn:definitions>