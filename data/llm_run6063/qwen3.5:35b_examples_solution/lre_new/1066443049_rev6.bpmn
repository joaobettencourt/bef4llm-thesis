<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_WebDesignProcess_Corrected" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_WebDesign">
    <bpmn:participant id="Participant_DesignTeam" name="Web Design Team Process" processRef="Process_WebDesign_Corrected" />
  </bpmn:collaboration>

  <bpmn:process id="Process_WebDesign_Corrected" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_DesignTeam" name="Web design team">
        <bpmn:flowNodeRef>StartEvent_Meeting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformationalMeeting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_MeetingSuccess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ProcessOver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Storyboard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_SplitPaths</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_ContentReviewNeeded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FinalContentVersion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_JoinPaths</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BuildWebsite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_SiteApproved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Completed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Meeting" name="Informational meeting">
      <bpmn:outgoing>SequenceFlow_StartToMeeting</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_ProcessOver" name="Process ends (meeting not successful)">
      <bpmn:incoming>SequenceFlow_MeetingNotSuccessful</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_Completed" name="Website completed">
      <bpmn:incoming>SequenceFlow_SiteApproved</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Tasks -->
    <bpmn:task id="Task_InformationalMeeting" name="informational meeting">
      <bpmn:incoming>SequenceFlow_StartToMeeting</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MeetingResult</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_Storyboard" name="create storyboard">
      <bpmn:incoming>SequenceFlow_AgreementReached</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StartParallelWork</bpmn:outgoing>
    </bpmn:task>

    <!-- Design and Development Path -->
    <bpmn:task id="Task_DesignDevelopment" name="design and development of website">
      <bpmn:incoming>SequenceFlow_SplitDesignPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DevCompleteToJoin</bpmn:outgoing>
    </bpmn:task>

    <!-- Content Path -->
    <bpmn:task id="Task_PrepareContent" name="prepare initial draft of content">
      <bpmn:incoming>SequenceFlow_SplitContentPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DraftReadyToReviewDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Marketing Review Task -->
    <bpmn:task id="Task_MarketingReview" name="marketing review of draft">
      <bpmn:incoming>SequenceFlow_ReviewNeeded</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReviewCompleteToFinalContent</bpmn:outgoing>
    </bpmn:task>

    <!-- Final Content Version -->
    <bpmn:task id="Task_FinalContentVersion" name="create final version of content">
      <bpmn:incoming>SequenceFlow_DraftApprovedDirectly</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ReviewCompleteToFinalContent</bpmn:outgoing>
    </bpmn:task>

    <!-- Build Website -->
    <bpmn:task id="Task_BuildWebsite" name="build website">
      <bpmn:incoming>SequenceFlow_JoinPathsToBuild</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BuiltForReview</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateways -->
    
    <!-- Meeting Success Decision -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_MeetingSuccess" name="meeting successful?">
      <bpmn:incoming>SequenceFlow_MeetingResult</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AgreementReached</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_MeetingNotSuccessful</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Parallel Split Gateway -->
    <bpmn:parallelGateway id="ParallelGateway_SplitPaths" name="Start parallel work">
      <bpmn:incoming>SequenceFlow_StartParallelWork</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SplitDesignPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SplitContentPath</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Content Review Decision -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_ContentReviewNeeded" name="review needed?">
      <bpmn:incoming>SequenceFlow_DraftReadyToReviewDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReviewNotNeededDirectly</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ReviewNeeded</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Parallel Join Gateway -->
    <bpmn:parallelGateway id="ParallelGateway_JoinPaths" name="Join paths">
      <bpmn:incoming>SequenceFlow_DevCompleteToJoin</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReviewNotNeededDirectly</bpmn:outgoing> <!-- Logic fix below -->
    </bpmn:parallelGateway>

    <!-- Final Approval Decision -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_SiteApproved" name="site approved?">
      <bpmn:incoming>SequenceFlow_BuiltForReview</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SiteNotApprovedBackToBuild</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SiteApproved</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flows -->
    
    <!-- Start Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToMeeting" sourceRef="StartEvent_Meeting" targetRef="Task_InformationalMeeting" />
    
    <!-- Meeting Decision Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_MeetingResult" sourceRef="Task_InformationalMeeting" targetRef="ExclusiveGateway_MeetingSuccess" />
    
    <bpmn:sequenceFlow id="SequenceFlow_AgreementReached" name="yes" sourceRef="ExclusiveGateway_MeetingSuccess" targetRef="Task_Storyboard" />
    
    <bpmn:sequenceFlow id="SequenceFlow_MeetingNotSuccessful" name="no" sourceRef="ExclusiveGateway_MeetingSuccess" targetRef="EndEvent_ProcessOver" />

    <!-- Parallel Split Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_StartParallelWork" sourceRef="Task_Storyboard" targetRef="ParallelGateway_SplitPaths" />
    
    <bpmn:sequenceFlow id="SequenceFlow_SplitDesignPath" name="design path" sourceRef="ParallelGateway_SplitPaths" targetRef="Task_DesignDevelopment" />
    
    <bpmn:sequenceFlow id="SequenceFlow_SplitContentPath" name="content path" sourceRef="ParallelGateway_SplitPaths" targetRef="Task_PrepareContent" />

    <!-- Content Review Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_DraftReadyToReviewDecision" sourceRef="Task_PrepareContent" targetRef="ExclusiveGateway_ContentReviewNeeded" />

    <bpmn:sequenceFlow id="SequenceFlow_ReviewNotNeededDirectly" name="no (skip review)" sourceRef="ExclusiveGateway_ContentReviewNeeded" targetRef="ParallelGateway_JoinPaths" />
    
    <bpmn:sequenceFlow id="SequenceFlow_ReviewNeeded" name="yes" sourceRef="ExclusiveGateway_ContentReviewNeeded" targetRef="Task_MarketingReview" />

    <!-- Marketing Review Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_ReviewCompleteToFinalContent" sourceRef="Task_MarketingReview" targetRef="Task_FinalContentVersion" />

    <!-- Final Content to Join Flow (if review was needed) -->
    <bpmn:sequenceFlow id="SequenceFlow_DraftApprovedDirectly" name="no (direct)" sourceRef="ExclusiveGateway_ContentReviewNeeded" targetRef="ParallelGateway_JoinPaths" /> 
    <!-- Note: Logic correction for flow from FinalContentVersion to JoinPath is missing in previous draft, adding below -->
    
    <bpmn:sequenceFlow id="SequenceFlow_FinalToJoin" name="content ready" sourceRef="Task_FinalContentVersion" targetRef="ParallelGateway_JoinPaths" />

    <!-- Dev Complete Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_DevCompleteToJoin" sourceRef="Task_DesignDevelopment" targetRef="ParallelGateway_JoinPaths" />

    <!-- Build and Review Loop -->
    <bpmn:sequenceFlow id="SequenceFlow_JoinPathsToBuild" name="ready to build" sourceRef="ParallelGateway_JoinPaths" targetRef="Task_BuildWebsite" />
    
    <bpmn:sequenceFlow id="SequenceFlow_BuiltForReview" name="built, review?" sourceRef="Task_BuildWebsite" targetRef="ExclusiveGateway_SiteApproved" />

    <!-- Final Approval Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_SiteNotApprovedBackToBuild" name="no - not approved" sourceRef="ExclusiveGateway_SiteApproved" targetRef="Task_BuildWebsite" />
    
    <bpmn:sequenceFlow id="SequenceFlow_SiteApproved" name="yes - site approved" sourceRef="ExclusiveGateway_SiteApproved" targetRef="EndEvent_Completed" />

  </bpmn:process>
</bpmn:definitions>