<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_AccountCreation">
    <bpmn:participant id="Participant_Customer" name="Bank Customer" processRef="Process_Customer"/>
    <bpmn:participant id="Participant_PostOfficer" name="Post Officer" processRef="Process_PostOfficer"/>
    <bpmn:participant id="Participant_BankOfficer" name="Bank Officer" processRef="Process_BankOfficer"/>
    
    <bpmn:messageFlow id="MessageFlow_1" sourceRef="Task_Customer_PrintPDF" targetRef="StartEvent_PostOffice_Start"/>
    <bpmn:messageFlow id="MessageFlow_2" sourceRef="EndEvent_OfficerComplete" targetRef="StartEvent_BankOfficer_Start"/>
  </bpmn:collaboration>

  <!-- Customer Process -->
  <bpmn:process id="Process_Customer">
    <bpmn:startEvent id="StartEvent_Customer_Start" name="Account Request Start">
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:endEvent id="EndEvent_AccountSent" name="Request Sent to Post Office">
      <bpmn:incoming>SequenceFlow_PrintPDF_Done</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:task id="Task_Customer_VisitWebsite" name="Visit Bank Website">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FillData</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_Customer_FillPersonal" name="Fill in Personal Data">
      <bpmn:incoming>SequenceFlow_FillData</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GeneratePDF</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_Customer_PrintPDF" name="Generate and Print PDF">
      <bpmn:incoming>SequenceFlow_GeneratePDF</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PrintPDF_Done</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_Customer_Start" targetRef="Task_Customer_VisitWebsite"/>
    <bpmn:sequenceFlow id="SequenceFlow_FillData" name="" sourceRef="Task_Customer_VisitWebsite" targetRef="Task_Customer_FillPersonal"/>
    <bpmn:sequenceFlow id="SequenceFlow_GeneratePDF" name="" sourceRef="Task_Customer_FillPersonal" targetRef="Task_Customer_PrintPDF"/>
    <bpmn:sequenceFlow id="SequenceFlow_PrintPDF_Done" name="" sourceRef="Task_Customer_PrintPDF" targetRef="EndEvent_AccountSent"/>

  </bpmn:process>

  <!-- Post Officer Process -->
  <bpmn:process id="Process_PostOfficer">
    <bpmn:startEvent id="StartEvent_PostOffice_Start" name="Receive Account Request">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_Authenticate</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:endEvent id="EndEvent_OfficerComplete" name="Request Mailed to Bank">
      <bpmn:incoming>SequenceFlow_MailToBank</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:task id="Task_Post_AuthenticateCustomer" name="Check Customer Identity">
      <bpmn:incoming>SequenceFlow_Authenticate</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MailToBank</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_Authenticate" name="" sourceRef="StartEvent_PostOffice_Start" targetRef="Task_Post_AuthenticateCustomer"/>
    <bpmn:sequenceFlow id="SequenceFlow_MailToBank" name="" sourceRef="Task_Post_AuthenticateCustomer" targetRef="EndEvent_OfficerComplete"/>

  </bpmn:process>

  <!-- Bank Officer Process -->
  <bpmn:process id="Process_BankOfficer">
    <bpmn:startEvent id="StartEvent_BankOfficer_Start" name="Receive Account Request from Post Office">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_CheckData</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:endEvent id="EndEvent_CustomerNotified" name="Customer Notified of Decision">
      <bpmn:incoming>SequenceFlow_FinalizeDecision</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:task id="Task_Bank_CheckData" name="Check Customer Data">
      <bpmn:incoming>SequenceFlow_CheckData</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DecisionPoint</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_AccountDecision" name="Accept Request?">
      <bpmn:incoming>SequenceFlow_DecisionPoint</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AcceptPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RejectPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Accept Path -->
    <bpmn:task id="Task_Bank_MailAccountDocs" name="Mail Account Documents">
      <bpmn:incoming>SequenceFlow_AcceptPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FinalizeDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Reject Path -->
    <bpmn:task id="Task_Bank_MailRefusal" name="Mail Letter of Refusal">
      <bpmn:incoming>SequenceFlow_RejectPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FinalizeDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckData" name="" sourceRef="StartEvent_BankOfficer_Start" targetRef="Task_Bank_CheckData"/>
    <bpmn:sequenceFlow id="SequenceFlow_DecisionPoint" name="" sourceRef="Task_Bank_CheckData" targetRef="Gateway_AccountDecision"/>

    <!-- Decision Paths -->
    <bpmn:sequenceFlow id="SequenceFlow_AcceptPath" name="Accept" sourceRef="Gateway_AccountDecision" targetRef="Task_Bank_MailAccountDocs">
      <bpmn:bpmndi:name>Yes</bpmn:bpmndi:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_RejectPath" name="Reject" sourceRef="Gateway_AccountDecision" targetRef="Task_Bank_MailRefusal">
      <bpmn:bpmndi:name>No</bpmn:bpmndi:name>
    </bpmn:sequenceFlow>

    <!-- Finalize -->
    <bpmn:sequenceFlow id="SequenceFlow_FinalizeDecision" name="" sourceRef="Task_Bank_MailAccountDocs" targetRef="EndEvent_CustomerNotified"/>
    <bpmn:sequenceFlow id="SequenceFlow_RejectFinalize" name="" sourceRef="Task_Bank_MailRefusal" targetRef="EndEvent_CustomerNotified"/>

  </bpmn:process>

</bpmn:definitions>