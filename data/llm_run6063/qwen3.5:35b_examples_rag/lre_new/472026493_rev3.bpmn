<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_HardwarePurchase">
    <bpmn:participant id="Participant_HardwareProcess" name="Hardware Purchase Process" processRef="Process_HardwarePurchase" />
  </bpmn:collaboration>

  <bpmn:process id="Process_HardwarePurchase" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_ITDepartment_1" name="IT Department">
        <bpmn:flowNodeRef>StartEvent_RequestReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AnalyzeRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ApprovalDecision_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EditCompleteRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareOrder_IT</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Management_1" name="Management">
        <bpmn:flowNodeRef>Task_AnalyzeForm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DecisionPoint_1</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_FinancialDept_1" name="Financial Department">
        <bpmn:flowNodeRef>Task_FindResources</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HandleInvoice</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Supplier_1" name="Supplier">
        <bpmn:flowNodeRef>IntermediateEvent_PriceOfferReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendOrderToSupplier</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Employee_1" name="Employee">
        <bpmn:flowNodeRef>IntermediateEvent_DenialEmailSent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendReworkRequest</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_RequestReceived" name="Request Received">
      <bpmn:outgoing>Flow_1_StartToAnalyze</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- IT Department Tasks -->
    <bpmn:userTask id="Task_AnalyzeRequest" name="Analyze Request">
      <bpmn:incoming>Flow_1_StartToAnalyze</bpmn:incoming>
      <bpmn:outgoing>Flow_2_ToApprovalGateway</bpmn:outgoing>
    </bpmn:userTask>

    <!-- First Decision Gateway -->
    <bpmn:exclusiveGateway id="Gateway_ApprovalDecision_1" name="Request Approved?">
      <bpmn:incoming>Flow_2_ToApprovalGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_DeniedPath</bpmn:outgoing>
      <bpmn:outgoing>Flow_ApprovedPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Denied Path -->
    <bpmn:userTask id="IntermediateEvent_DenialEmailSent" name="Send Denial Email">
      <bpmn:incoming>Flow_DeniedPath</bpmn:incoming>
      <bpmn:outgoing>Flow_3_ToDenyEnd</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Approved Path -->
    <bpmn:userTask id="Task_EditCompleteRequest" name="Edit and Complete Request">
      <bpmn:incoming>Flow_ApprovedPath</bpmn:incoming>
      <bpmn:outgoing>Flow_4_ToPriceInquiry</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Price Inquiry -->
    <bpmn:intermediateCatchEvent id="IntermediateEvent_PriceOfferReceived" name="Receive Supplier Offer">
      <bpmn:incoming>Flow_SupplierReply</bpmn:incoming>
      <bpmn:outgoing>Flow_6_ToFormFill</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Form to Management -->
    <bpmn:userTask id="Task_AnalyzeForm" name="Analyze Request &amp; Fill Form">
      <bpmn:incoming>Flow_6_ToFormFill</bpmn:incoming>
      <bpmn:outgoing>Flow_7_ToManagementDecision</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Management Decision Gateway -->
    <bpmn:exclusiveGateway id="Gateway_DecisionPoint_1" name="Management Approval?">
      <bpmn:incoming>Flow_7_ToManagementDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_ManagementApproved</bpmn:outgoing>
      <bpmn:outgoing>Flow_ReworkPath</bpmn:outgoing>
      <bpmn:outgoing>Flow_DeniedByManagement</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Management Approved Path -->
    <bpmn:userTask id="Task_SendOrderToSupplier" name="Send Order to Supplier">
      <bpmn:incoming>Flow_ManagementApproved</bpmn:incoming>
      <bpmn:outgoing>Flow_8_ToAcceptanceWait</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel Gateway for Finance and IT -->
    <bpmn:parallelGateway id="ParallelFinanceIT" name="Split to Finance &amp; IT">
      <bpmn:incoming>Flow_ManagementApproved</bpmn:incoming>
      <bpmn:outgoing>Flow_FinancePath</bpmn:outgoing>
      <bpmn:outgoing>Flow_ITOrderPath</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Financial Department Path -->
    <bpmn:userTask id="Task_FindResources" name="Find Resources">
      <bpmn:incoming>Flow_FinancePath</bpmn:incoming>
      <bpmn:outgoing>Flow_9_ToConvergence</bpmn:outgoing>
    </bpmn:userTask>

    <!-- IT Department Order Path -->
    <bpmn:userTask id="Task_PrepareOrder_IT" name="Prepare Order">
      <bpmn:incoming>Flow_ITOrderPath</bpmn:incoming>
      <bpmn:outgoing>Flow_10_ToConvergence</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Convergence Gateway -->
    <bpmn:parallelGateway id="ParallelFinanceIT_Converge" name="Wait for Acceptance &amp; Resources">
      <bpmn:incoming>Flow_9_ToConvergence</bpmn:incoming>
      <bpmn:incoming>Flow_10_ToConvergence</bpmn:incoming>
      <bpmn:outgoing>Flow_ConvergeToReceiveHardware</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Receive Hardware -->
    <bpmn:userTask id="Task_HandleInvoice" name="Handle Invoice">
      <bpmn:incoming>Flow_ConvergeToReceiveHardware</bpmn:incoming>
      <bpmn:outgoing>Flow_FinalToEnd</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_ProcessComplete" name="Process Complete">
      <bpmn:incoming>Flow_FinalToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_RequestDenied_1" name="Request Denied">
      <bpmn:incoming>Flow_3_ToDenyEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Rework Path -->
    <bpmn:userTask id="Task_SendReworkRequest" name="Send Request for Rework">
      <bpmn:incoming>Flow_ReworkPath</bpmn:incoming>
      <bpmn:outgoing>Flow_11_BackToEditComplete</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Denied by Management Path -->
    <bpmn:endEvent id="EndEvent_ManagementDenied" name="Request Denied">
      <bpmn:incoming>Flow_DeniedByManagement</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Flow_1_StartToAnalyze" sourceRef="StartEvent_RequestReceived" targetRef="Task_AnalyzeRequest" />
    <bpmn:sequenceFlow id="Flow_2_ToApprovalGateway" name="" sourceRef="Task_AnalyzeRequest" targetRef="Gateway_ApprovalDecision_1" />

    <!-- Denied Path -->
    <bpmn:sequenceFlow id="Flow_DeniedPath" name="Denied" sourceRef="Gateway_ApprovalDecision_1" targetRef="IntermediateEvent_DenialEmailSent" />
    <bpmn:sequenceFlow id="Flow_3_ToDenyEnd" sourceRef="IntermediateEvent_DenialEmailSent" targetRef="EndEvent_RequestDenied_1" />

    <!-- Approved Path -->
    <bpmn:sequenceFlow id="Flow_ApprovedPath" name="Approved" sourceRef="Gateway_ApprovalDecision_1" targetRef="Task_EditCompleteRequest" />
    <bpmn:sequenceFlow id="Flow_4_ToPriceInquiry" sourceRef="Task_EditCompleteRequest" targetRef="IntermediateEvent_PriceOfferReceived" />

    <!-- Form to Management -->
    <bpmn:sequenceFlow id="Flow_SupplierReply" name="" sourceRef="Gateway_ApprovalDecision_1" targetRef="IntermediateEvent_PriceOfferReceived" />
    <bpmn:sequenceFlow id="Flow_6_ToFormFill" name="" sourceRef="IntermediateEvent_PriceOfferReceived" targetRef="Task_AnalyzeForm" />
    <bpmn:sequenceFlow id="Flow_7_ToManagementDecision" sourceRef="Task_AnalyzeForm" targetRef="Gateway_DecisionPoint_1" />

    <!-- Management Decisions -->
    <bpmn:sequenceFlow id="Flow_ManagementApproved" name="Approved" sourceRef="Gateway_DecisionPoint_1" targetRef="ParallelFinanceIT" />
    <bpmn:sequenceFlow id="Flow_ReworkPath" name="Rework Required" sourceRef="Gateway_DecisionPoint_1" targetRef="Task_SendReworkRequest" />
    <bpmn:sequenceFlow id="Flow_DeniedByManagement" name="Denied" sourceRef="Gateway_DecisionPoint_1" targetRef="EndEvent_ManagementDenied" />

    <!-- Rework Loop -->
    <bpmn:sequenceFlow id="Flow_11_BackToEditComplete" sourceRef="Task_SendReworkRequest" targetRef="Task_EditCompleteRequest" />

    <!-- Parallel Split for Finance and IT -->
    <bpmn:parallelGateway id="ParallelFinanceIT_Converge">
      <bpmn:incoming>SequenceFlow_9_ToConvergence</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_10_ToConvergence</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConvergeToReceiveHardware</bpmn:outgoing>
    </bpmn:parallelGateway>

  </bpmn:process>
</bpmn:definitions>