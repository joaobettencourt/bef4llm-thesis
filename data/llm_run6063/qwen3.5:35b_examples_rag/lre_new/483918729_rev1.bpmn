<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_ProvisionProcess">
    <bpmn:participant id="Participant_ProvisionTeam" name="Provision Team Process" processRef="Process_OrderProcessing" />
  </bpmn:collaboration>

  <bpmn:process id="Process_OrderProcessing" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_ProvisionTeam" name="Provision Team">
        <bpmn:flowNodeRef>Task_IdentifyParts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_QuestionsExist</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AskMoreInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PartsAvailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecordPetition</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OrderDaisuki</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ContactCustomer</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Customer" name="Customer">
        <bpmn:flowNodeRef>StartEvent_RequestReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProvideMoreInfo</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_RequestReceived" name="Request Received">
      <bpmn:outgoing>Flow_StartToIdentify</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Identify Necessary Parts -->
    <bpmn:userTask id="Task_IdentifyParts" name="Identify Necessary Parts">
      <bpmn:incoming>Flow_StartToIdentify</bpmn:incoming>
      <bpmn:outgoing>Flow_ToQuestionsGateway</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway: Questions Exist? -->
    <bpmn:exclusiveGateway id="Gateway_QuestionsExist" name="Questions About Request?">
      <bpmn:incoming>Flow_ToQuestionsGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_AskMoreInfo</bpmn:outgoing>
      <bpmn:outgoing>Flow_CheckPartsAvailable</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Ask More Info (Provision Team) -->
    <bpmn:userTask id="Task_AskMoreInfo" name="Ask Customer for More Information">
      <bpmn:incoming>Flow_AskMoreInfo</bpmn:incoming>
      <bpmn:outgoing>Flow_SendToCustomer</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Provide More Info (Customer) -->
    <bpmn:userTask id="Task_ProvideMoreInfo" name="Provide Additional Information">
      <bpmn:incoming>Flow_SendToCustomer</bpmn:incoming>
      <bpmn:outgoing>Flow_ReturnToTeam</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway: All Parts Available? -->
    <bpmn:exclusiveGateway id="Gateway_PartsAvailable" name="All Parts Available?">
      <bpmn:incoming>Flow_CheckPartsAvailable</bpmn:incoming>
      <bpmn:incoming>Flow_ReturnToTeam</bpmn:incoming>
      <bpmn:outgoing>Flow_SupplyDirectly</bpmn:outgoing>
      <bpmn:outgoing>Flow_OrderFromDaisuki</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Record Petition -->
    <bpmn:userTask id="Task_RecordPetition" name="Record Petition">
      <bpmn:incoming>Flow_OrderFromDaisuki</bpmn:incoming>
      <bpmn:outgoing>Flow_ReadyToOrder</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Order from Daisuki -->
    <bpmn:userTask id="Task_OrderDaisuki" name="Order Parts to Daisuki">
      <bpmn:incoming>Flow_ReadyToOrder</bpmn:incoming>
      <bpmn:outgoing>Flow_WaitForCollection</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Contact Customer -->
    <bpmn:userTask id="Task_ContactCustomer" name="Contact Customer When Collected">
      <bpmn:incoming>Flow_WaitForCollection</bpmn:incoming>
      <bpmn:outgoing>Flow_CustomerCollects</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Supply Items to Customer -->
    <bpmn:userTask id="Task_SupplyItems" name="Supply Items to Customer">
      <bpmn:incoming>Flow_SupplyDirectly</bpmn:incoming>
      <bpmn:outgoing>Flow_CustomerCollectsDirectly</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Intermediate Event: Wait for Collection -->
    <bpmn:intermediateCatchEvent id="Intermediate_Collection" name="Items Collected">
      <bpmn:incoming>Flow_CustomerCollects</bpmn:incoming>
      <bpmn:incoming>Flow_CustomerCollectsDirectly</bpmn:incoming>
      <bpmn:outgoing>Flow_FinalPayment</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- End Event -->
    <bpmn:endEvent id="End_Event_PaymentReceived" name="Final Payment Received">
      <bpmn:incoming>Flow_FinalPayment</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Flow_StartToIdentify" sourceRef="StartEvent_RequestReceived" targetRef="Task_IdentifyParts" />
    <bpmn:sequenceFlow id="Flow_ToQuestionsGateway" name="" sourceRef="Task_IdentifyParts" targetRef="Gateway_QuestionsExist" />

    <!-- Questions Path -->
    <bpmn:sequenceFlow id="Flow_AskMoreInfo" name="Yes - Ask for Info" sourceRef="Gateway_QuestionsExist" targetRef="Task_AskMoreInfo" />
    <bpmn:sequenceFlow id="Flow_SendToCustomer" name="" sourceRef="Task_AskMoreInfo" targetRef="Task_ProvideMoreInfo" />
    <bpmn:sequenceFlow id="Flow_ReturnToTeam" name="" sourceRef="Task_ProvideMoreInfo" targetRef="Gateway_PartsAvailable" />

    <!-- Parts Available Path -->
    <bpmn:sequenceFlow id="Flow_CheckPartsAvailable" name="No Questions" sourceRef="Gateway_QuestionsExist" targetRef="Gateway_PartsAvailable" />
    <bpmn:sequenceFlow id="Flow_SupplyDirectly" name="Yes - All Available" sourceRef="Gateway_PartsAvailable" targetRef="Task_SupplyItems" />

    <!-- Parts Not Available Path -->
    <bpmn:sequenceFlow id="Flow_OrderFromDaisuki" name="No - Order Required" sourceRef="Gateway_PartsAvailable" targetRef="Task_RecordPetition" />
    <bpmn:sequenceFlow id="Flow_ReadyToOrder" name="" sourceRef="Task_RecordPetition" targetRef="Task_OrderDaisuki" />

    <!-- Collection and Payment -->
    <bpmn:sequenceFlow id="Flow_WaitForCollection" name="" sourceRef="Task_OrderDaisuki" targetRef="Intermediate_Collection" />
    <bpmn:sequenceFlow id="Flow_CustomerCollectsDirectly" name="" sourceRef="Task_SupplyItems" targetRef="Intermediate_Collection" />

    <!-- Final Payment -->
    <bpmn:sequenceFlow id="Flow_FinalPayment" name="" sourceRef="Intermediate_Collection" targetRef="End_Event_PaymentReceived" />

  </bpmn:process>
</bpmn:definitions>