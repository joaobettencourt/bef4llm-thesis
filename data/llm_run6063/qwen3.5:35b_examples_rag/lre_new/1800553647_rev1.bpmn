<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_purchaseprocess">
    <bpmn:participant id="Participant_ACMEInc" name="ACME Inc." processRef="Process_PurchaseOrdering" />
  </bpmn:collaboration>

  <bpmn:process id="Process_PurchaseOrdering" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Department" name="Department">
        <bpmn:flowNodeRef>StartEvent_Demand</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckStock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_EnoughGoods</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_CentralProcurement" name="Central Procurement">
        <bpmn:flowNodeRef>Task_CreateRequisition</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SupplierAvailable</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Approver" name="Approver">
        <bpmn:flowNodeRef>Task_CreateOrderTemplate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_NewSupplierMerge</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_ERPSystem" name="ERP System">
        <bpmn:flowNodeRef>Task_CreateNewSupplier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_OrderTriggered</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_LocalConsumption" name="Local Consumption">
        <bpmn:flowNodeRef>Task_ConsumeGoods</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ProcessComplete</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Demand" name="Demand Identified">
      <bpmn:outgoing>SequenceFlow_1_StartToCheck</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Stock Check Task in Department Lane -->
    <bpmn:userTask id="Task_CheckStock" name="Check Goods Availability">
      <bpmn:incoming>SequenceFlow_1_StartToCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2_CheckResult</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway for Stock Decision -->
    <bpmn:exclusiveGateway id="Gateway_EnoughGoods" name="Enough Goods?">
      <bpmn:incoming>SequenceFlow_2_CheckResult</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3_ConsumeLocally</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_4_CreateRequisition</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Consume Goods Task -->
    <bpmn:userTask id="Task_ConsumeGoods" name="Consume Locally">
      <bpmn:incoming>SequenceFlow_3_ConsumeLocally</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5_EndProcess</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event for Local Consumption -->
    <bpmn:endEvent id="EndEvent_ProcessComplete" name="Purchase Complete">
      <bpmn:incoming>SequenceFlow_5_EndProcess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Create Requisition Task in Central Procurement Lane -->
    <bpmn:userTask id="Task_CreateRequisition" name="Create Purchase Requisition">
      <bpmn:incoming>SequenceFlow_4_CreateRequisition</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6_CheckSupplierInfo</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway for Supplier Availability -->
    <bpmn:exclusiveGateway id="Gateway_SupplierAvailable" name="Supplier Info Available?">
      <bpmn:incoming>SequenceFlow_6_CheckSupplierInfo</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_7_CreateTemplate</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_8_NewSupplierProcess</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Create New Supplier Task in ERP System Lane -->
    <bpmn:userTask id="Task_CreateNewSupplier" name="Create New Supplier">
      <bpmn:incoming>SequenceFlow_8_NewSupplierProcess</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_9_MergeToTemplate</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Create Order Template Task in Approver Lane -->
    <bpmn:userTask id="Task_CreateOrderTemplate" name="Create Order Template">
      <bpmn:incoming>SequenceFlow_7_CreateTemplate</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_10_ApproveOrder</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway for New Supplier Merge -->
    <bpmn:exclusiveGateway id="Gateway_NewSupplierMerge" name="Merge After Creation">
      <bpmn:incoming>SequenceFlow_9_MergeToTemplate</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_10_ApproveOrder</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Approve Order Task in ERP System Lane -->
    <bpmn:userTask id="Task_ApproveOrder" name="Approve and Trigger Purchase">
      <bpmn:incoming>SequenceFlow_10_ApproveOrder</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_11_EndPurchase</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event for Purchase Order -->
    <bpmn:endEvent id="EndEvent_OrderTriggered" name="Order Triggered">
      <bpmn:incoming>SequenceFlow_11_EndPurchase</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_1_StartToCheck" sourceRef="StartEvent_Demand" targetRef="Task_CheckStock">
      <bpmn:name>Demand Identified</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Stock Decision Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_2_CheckResult" sourceRef="Task_CheckStock" targetRef="Gateway_EnoughGoods">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_3_ConsumeLocally" name="Yes - Enough Goods" sourceRef="Gateway_EnoughGoods" targetRef="Task_ConsumeGoods"/>

    <!-- Requisition Creation Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_4_CreateRequisition" name="No - Not Enough Goods" sourceRef="Gateway_EnoughGoods" targetRef="Task_CreateRequisition"/>

    <!-- Supplier Check Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_6_CheckSupplierInfo" sourceRef="Task_CreateRequisition" targetRef="Gateway_SupplierAvailable">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <!-- Supplier Decision Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_7_CreateTemplate" name="Yes - Known Supplier" sourceRef="Gateway_SupplierAvailable" targetRef="Task_CreateOrderTemplate"/>

    <!-- New Supplier Process Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_8_NewSupplierProcess" name="No - New Supplier" sourceRef="Gateway_SupplierAvailable" targetRef="Task_CreateNewSupplier"/>

    <!-- Merge Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_9_MergeToTemplate" sourceRef="Task_CreateNewSupplier" targetRef="Gateway_NewSupplierMerge">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <!-- Approval Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_10_ApproveOrder" name="" sourceRef="Gateway_NewSupplierMerge" targetRef="Task_CreateOrderTemplate"/>

    <!-- Final Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_11_EndPurchase" sourceRef="Task_ApproveOrder" targetRef="EndEvent_OrderTriggered">
      <bpmn:name/>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>