<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                 xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                 xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                 xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
                 id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:collaboration id="Collaboration_PurchaseOrderProcess">
    <bpmn:participant id="Participant_ACMEInc" name="ACME Inc." processRef="Process_PurchaseOrderToDelivery"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_PurchaseOrderToDelivery" isExecutable="false">
    
    <bpmn:laneSet>
      <bpmn:lane id="Lane_FinancialDept" name="Financial Department">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckInvoice</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Department" name="Department">
        <bpmn:flowNodeRef>Task_ReviewFactualCorrectness</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AmountCheck</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_DepartmentHead" name="Department Head">
        <bpmn:flowNodeRef>Task_ApproveInvoice</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Purchase Invoice Received">
      <bpmn:outgoing>SequenceFlow_StartToCheck</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Financial Department Task -->
    <bpmn:userTask id="Task_CheckInvoice" name="Check Purchase Invoice">
      <bpmn:incoming>SequenceFlow_StartToCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendToDept</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Department Tasks -->
    <bpmn:userTask id="Task_ReviewFactualCorrectness" name="Check Invoice for Factual Correctness">
      <bpmn:incoming>SequenceFlow_SendToDept</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RegisterSaperion</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Register in SAPERION -->
    <bpmn:serviceTask id="Task_RegisterInSAPERION" name="Register in SAPERION Workflow System">
      <bpmn:incoming>SequenceFlow_RegisterSaperion</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToGateway</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Gateway for Amount Check -->
    <bpmn:exclusiveGateway id="Gateway_AmountCheck" name="$500 Threshold">
      <bpmn:incoming>SequenceFlow_ToGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Over500</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_Under500</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Department Head Task (for over $500) -->
    <bpmn:userTask id="Task_ApproveInvoice" name="Approve Invoice in SAPERION">
      <bpmn:incoming>SequenceFlow_Over500</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToERPTrigger</bpmn:outgoing>
    </bpmn:userTask>

    <!-- ERP Payment Trigger -->
    <bpmn:serviceTask id="Task_TriggerERPPayment" name="Trigger ERP System for Payment">
      <bpmn:incoming>SequenceFlow_Under500</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ToERPTrigger</bpmn:incoming>
    </bpmn:serviceTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_1" name="Payment Processed">
      <bpmn:incoming>SequenceFlow_EndProcess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToCheck" sourceRef="StartEvent_1" targetRef="Task_CheckInvoice"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_SendToDept" name="" sourceRef="Task_CheckInvoice" targetRef="Task_ReviewFactualCorrectness"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_RegisterSaperion" name="" sourceRef="Task_ReviewFactualCorrectness" targetRef="Task_RegisterInSAPERION"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ToGateway" name="" sourceRef="Task_RegisterInSAPERION" targetRef="Gateway_AmountCheck"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_Over500" name="Amount &gt; $500" sourceRef="Gateway_AmountCheck" targetRef="Task_ApproveInvoice"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_Under500" name="Amount ≤ $500" sourceRef="Gateway_AmountCheck" targetRef="Task_TriggerERPPayment"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ToERPTrigger" name="" sourceRef="Task_ApproveInvoice" targetRef="Task_TriggerERPPayment"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_EndProcess" name="" sourceRef="Task_TriggerERPPayment" targetRef="EndEvent_1"/>

  </bpmn:process>
</bpmn:definitions>