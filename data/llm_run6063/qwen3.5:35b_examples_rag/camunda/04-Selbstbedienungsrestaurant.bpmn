<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_RestaurantProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_RestaurantOrdering">
    <bpmn:participant id="Participant_Restaurant" name="Restaurant Bestellprozess" processRef="Process_OrderService" />
  </bpmn:collaboration>

  <bpmn:process id="Process_OrderService" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Gast" name="Gast">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WahlGericht</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_EssenVerzehr</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Mitarbeiter" name="Mitarbeiter">
        <bpmn:flowNodeRef>Task_BestellungAufnehmen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EingabeKassensystem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GeldEinnahmen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PieperEinstellen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_KochInformieren</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_ZeitAblauf5Minuten</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GastRufen</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Koch" name="Küche/Koch">
        <bpmn:flowNodeRef>StartEvent_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MahlzeitZubereiten</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DurchreicheStellen</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Guest Lane -->
    <bpmn:startEvent id="StartEvent_1" name="Gast betritt Restaurant">
      <bpmn:outgoing>SequenceFlow_WahlGericht</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_WahlGericht" name="Gericht auswählen und warten">
      <bpmn:incoming>SequenceFlow_WahlGericht</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BestellungAufgeben</bpmn:outgoing>
    </bpmn:task>

    <!-- Staff Lane -->
    <bpmn:startEvent id="StartEvent_2" name="Bestellung erhalten">
      <bpmn:outgoing>SequenceFlow_EingabeKassensystem</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_BestellungAufnehmen" name="Bestellung aufnehmen">
      <bpmn:incoming>SequenceFlow_BestellungAufgeben</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EingabeKassensystem</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_EingabeKassensystem" name="Bestellung ins Kassensystem eingeben">
      <bpmn:incoming>SequenceFlow_BestellungAufnehmen</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GeldEinnahmen</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_GeldEinnahmen" name="Geld vom Gast kassieren">
      <bpmn:incoming>SequenceFlow_EingabeKassensystem</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PieperEinstellen</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_PieperEinstellen" name="Pieper einstellen und übergeben">
      <bpmn:incoming>SequenceFlow_GeldEinnahmen</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_KochInformieren</bpmn:outgoing>
    </bpmn:task>

    <!-- Kitchen Lane -->
    <bpmn:startEvent id="StartEvent_3" name="Koch informiert">
      <bpmn:incoming>SequenceFlow_KochInformiertVonMitarbeiter</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MahlzeitZubereiten</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_MahlzeitZubereiten" name="Mahlzeit zubereiten">
      <bpmn:incoming>SequenceFlow_KochInformiertVonMitarbeiter</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DurchreicheStellen</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_DurchreicheStellen" name="Essen in Durchreiche stellen">
      <bpmn:incoming>SequenceFlow_MahlzeitZubereiten</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_KochInformiertMitarbeiter</bpmn:outgoing>
    </bpmn:task>

    <!-- Staff Lane continued -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_ZeitAblauf5Minuten" name="Pieper reagiert?">
      <bpmn:incoming>SequenceFlow_KochInformiertMitarbeiter</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PieperAusloesen</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Guest Lane continued -->
    <bpmn:endEvent id="EndEvent_1" name="Essen abholen">
      <bpmn:incoming>SequenceFlow_EssenAbholen</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_EssenVerzehr" name="Mahlzeit verzehren">
      <bpmn:incoming>SequenceFlow_MahlzeitVerzehren</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Staff Lane continued -->
    <bpmn:task id="Task_PieperAusloesen" name="Pieper auslösen">
      <bpmn:incoming>SequenceFlow_KochInformiertMitarbeiter</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GastRufenWennNicht</bpmn:outgoing>
    </bpmn:task>

    <!-- Staff Lane continued -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_PieperReaktion" name="Pieper reagiert?">
      <bpmn:incoming>SequenceFlow_KochInformiertMitarbeiter</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GastRufenWennNicht</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Staff Lane continued -->
    <bpmn:task id="Task_KochInformieren" name="Koch über Mahlzeit informieren">
      <bpmn:incoming>SequenceFlow_PieperEinstellen</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_KochInformiertVonMitarbeiter</bpmn:outgoing>
    </bpmn:task>

    <!-- Staff Lane continued -->
    <bpmn:task id="Task_GastRufen" name="Gast nach 5 Minuten rufen">
      <bpmn:incoming>SequenceFlow_PieperReaktionNein</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EssenAbholen</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_WahlGericht" sourceRef="StartEvent_1" targetRef="Task_WahlGericht" />
    <bpmn:sequenceFlow id="SequenceFlow_BestellungAufgeben" name="Bestellung aufgeben" sourceRef="Task_WahlGericht" targetRef="Task_BestellungAufnehmen">
      <bpmn:conditionExpression xsi:type="tFormalExpression"><![CDATA[true]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Kitchen Lane -->
    <bpmn:startEvent id="StartEvent_3" name="Koch informiert">
      <bpmn:incoming>SequenceFlow_KochInformiertVonMitarbeiter</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MahlzeitZubereiten</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Staff Lane -->
    <bpmn:task id="Task_KochInformieren" name="Koch über Mahlzeit informieren">
      <bpmn:incoming>SequenceFlow_PieperEinstellen</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_KochInformiertVonMitarbeiter</bpmn:outgoing>
    </bpmn:task>

  </bpmn:process>
</bpmn:definitions>