<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_RegressProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1RegressHandling">
    <bpmn:participant id="Participant_HRDepartment" name="Versicherung Regressbearbeitung" processRef="Process_RegressApproval" />
  </bpmn:collaboration>

  <bpmn:process id="Process_RegressApproval" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="Start_1RegressNotification" name="Regressmeldung erhalten">
      <bpmn:outgoing>SequenceFlow_CheckPossibility</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Check case -->
    <bpmn:task id="Task_2CheckCase" name="Fall prüfen auf Regressmöglichkeit">
      <bpmn:incoming>SequenceFlow_CheckPossibility</bpmn:incoming>
      <bpmn:outgoing>Gateway_PossibilityExists</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Possibility exists? -->
    <bpmn:exclusiveGateway id="Gateway_3Possibility" name="Möglichkeit besteht?">
      <bpmn:incoming>SequenceFlow_CheckCase</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendRequest</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CloseNoPossibility</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 2a: Send payment request -->
    <bpmn:task id="Task_4SendRequest" name="Zahlungsaufforderung senden">
      <bpmn:incoming>SequenceFlow_SendRequest</bpmn:incoming>
      <bpmn:outgoing>Gateway_WaitForMoneyOrDeadline</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2a continued: Set follow-up -->
    <bpmn:task id="Task_5SetFollowUp" name="Vorgang auf Wiedervorlage setzen">
      <bpmn:incoming>SequenceFlow_SendRequest</bpmn:incoming>
      <bpmn:outgoing>Gateway_WaitForMoneyOrDeadline</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2: Wait for money, deadline or objection -->
    <bpmn:exclusiveGateway id="Gateway_6WaitCondition" name="Geld eingegangen?">
      <bpmn:incoming>SequenceFlow_WaitForMoney</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BookPayment</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CheckObjection</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 3a: Book payment -->
    <bpmn:task id="Task_7BookPayment" name="Eingang verbuchen">
      <bpmn:incoming>SequenceFlow_BookPayment</bpmn:incoming>
      <bpmn:outgoing>EndEvent_ClosePaid</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 3: Check objection -->
    <bpmn:exclusiveGateway id="Gateway_8Objection" name="Widerspruch eingegangen?">
      <bpmn:incoming>SequenceFlow_CheckObjection</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_JustifiedCheck</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SendToCollection</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 4a: Check if objection justified -->
    <bpmn:task id="Task_9CheckObjection" name="Widerspruch prüfen">
      <bpmn:incoming>SequenceFlow_JustifiedCheck</bpmn:incoming>
      <bpmn:outgoing>Gateway_IsJustified</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 4: Is objection justified? -->
    <bpmn:exclusiveGateway id="Gateway_10IsJustified" name="Widerspruch gerechtfertigt?">
      <bpmn:incoming>SequenceFlow_CheckObjection</bpmn:incoming>
      <bpmn:outgoing>EndEvent_CloseJustified</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SendToCollection2</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 5a: Send to collection agency -->
    <bpmn:task id="Task_11SendInkasso" name="An Inkassodienstleister abgeben">
      <bpmn:incoming>SequenceFlow_SendToCollection</bpmn:incoming>
      <bpmn:outgoing>EndEvent_CloseSentToCollection</bpmn:outgoing>
    </bpmn:task>

    <!-- End Events -->
    <bpmn:endEvent id="End_12CloseNoPossibility" name="Vorgang geschlossen (keine Möglichkeit)">
      <bpmn:incoming>SequenceFlow_CloseNoPossibility</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="End_13ClosePaid" name="Vorgang geschlossen (Zahlung eingegangen)">
      <bpmn:incoming>SequenceFlow_ClosePaid</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="End_14CloseJustified" name="Vorgang geschlossen (Widerspruch gerechtfertigt)">
      <bpmn:incoming>SequenceFlow_CloseJustified</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="End_15CloseSentToCollection" name="Vorgang geschlossen (an Inkasso übergeben)">
      <bpmn:incoming>SequenceFlow_CloseSentToCollection</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckPossibility" sourceRef="Start_1RegressNotification" targetRef="Task_2CheckCase" />
    
    <bpmn:sequenceFlow id="SequenceFlow_CheckCase" name="" sourceRef="Task_2CheckCase" targetRef="Gateway_3Possibility" />

    <bpmn:sequenceFlow id="SequenceFlow_SendRequest" name="ja - Möglichkeit besteht" sourceRef="Gateway_3Possibility" targetRef="Task_4SendRequest" />
    
    <bpmn:sequenceFlow id="SequenceFlow_CloseNoPossibility" name="nein - keine Möglichkeit" sourceRef="Gateway_3Possibility" targetRef="End_12CloseNoPossibility" />

    <bpmn:sequenceFlow id="SequenceFlow_WaitForMoney" name="" sourceRef="Task_4SendRequest" targetRef="Gateway_6WaitCondition" />
    
    <bpmn:sequenceFlow id="SequenceFlow_SendToCollection" name="nein - Frist abgelaufen oder Widerspruch nicht gerechtfertigt" sourceRef="Gateway_8Objection" targetRef="Task_11SendInkasso" />

    <bpmn:sequenceFlow id="SequenceFlow_CheckObjection" name="" sourceRef="Gateway_6WaitCondition" targetRef="Gateway_8Objection" />
    
    <bpmn:sequenceFlow id="SequenceFlow_JustifiedCheck" name="ja - Widerspruch eingegangen" sourceRef="Gateway_8Objection" targetRef="Task_9CheckObjection" />

    <bpmn:sequenceFlow id="SequenceFlow_CloseJustified" name="nein - gerechtfertigt" sourceRef="Gateway_10IsJustified" targetRef="End_14CloseJustified" />
    
    <bpmn:sequenceFlow id="SequenceFlow_SendToCollection2" name="ja - nicht gerechtfertigt" sourceRef="Gateway_10IsJustified" targetRef="Task_11SendInkasso" />

    <bpmn:sequenceFlow id="SequenceFlow_ClosePaid" name="" sourceRef="Task_7BookPayment" targetRef="End_13ClosePaid" />
    
    <bpmn:sequenceFlow id="SequenceFlow_CloseSentToCollection" name="" sourceRef="Task_11SendInkasso" targetRef="End_15CloseSentToCollection" />

  </bpmn:process>
</bpmn:definitions>