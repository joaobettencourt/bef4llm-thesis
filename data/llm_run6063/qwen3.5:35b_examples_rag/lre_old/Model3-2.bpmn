<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_CourtFiles_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_CourtOps">
    <bpmn:participant id="Participant_CourtOperations" name="Court Operations"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_CourtFiles_1" isExecutable="true">
    
    <bpmn:laneSet id="LaneSet_01">
      <bpmn:lane id="Lane_Clerk">
        <bpmn:name>Court Clerk</bpmn:name>
        <bpmn:flowNodeRef>StartEvent_MorningCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckFilesOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_IfMissing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InitiateSearch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PhysicallyTrack</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ConcurrentStart</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Associate">
        <bpmn:name>Court Associate</bpmn:name>
        <bpmn:flowNodeRef>Task_HandFilesToAssociate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MergeParallel</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Judge">
        <bpmn:name>Judges Office</bpmn:name>
        <bpmn:flowNodeRef>Task_ConductHearings</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_HearingComplete</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_MorningCheck" name="Morning Check">
      <bpmn:outgoing>SequenceFlow_01</bpmn:outgoing>
      <bpmn:timerEventDefinition />
    </bpmn:startEvent>

    <!-- Task 1 -->
    <bpmn:task id="Task_CheckFilesOrder" name="Check Files Order">
      <bpmn:incoming>SequenceFlow_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_02</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1 -->
    <bpmn:exclusiveGateway id="Gateway_IfMissing" name="Files Missing?">
      <bpmn:incoming>SequenceFlow_02</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_03</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_04</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 2 (Search) -->
    <bpmn:task id="Task_InitiateSearch" name="Initiate Search">
      <bpmn:incoming>SequenceFlow_03</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_05</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3 (Track) -->
    <bpmn:task id="Task_PhysicallyTrack" name="Physically Track Files">
      <bpmn:incoming>SequenceFlow_04</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_06</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2 (Merge) -->
    <bpmn:exclusiveGateway id="Gateway_MergeReadiness" name="Files Ready?">
      <bpmn:incoming>SequenceFlow_05</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_06</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_07</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Gateway 3 (Parallel Split) -->
    <bpmn:parallelGateway id="Gateway_ConcurrentStart" name="Concurrent Start">
      <bpmn:incoming>SequenceFlow_07</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_08</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_12</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 4 (Handover) -->
    <bpmn:task id="Task_HandFilesToAssociate" name="Hand Files to Associate">
      <bpmn:incoming>SequenceFlow_08</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_13</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 5 (Lawlist) -->
    <bpmn:task id="Task_DistributeLawlist" name="Distribute Judges Lawlist">
      <bpmn:incoming>SequenceFlow_12</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_09</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 4 (Merge) -->
    <bpmn:parallelGateway id="Gateway_MergeParallel" name="Concurrent Merge">
      <bpmn:incoming>SequenceFlow_13</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_09</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_14</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 6 (Hearings) -->
    <bpmn:task id="Task_ConductHearings" name="Conduct Directions Hearings">
      <bpmn:incoming>SequenceFlow_14</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_15</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_HearingComplete" name="Hearings Complete">
      <bpmn:incoming>SequenceFlow_15</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    
    <bpmn:sequenceFlow id="SequenceFlow_01" sourceRef="StartEvent_MorningCheck" targetRef="Task_CheckFilesOrder"/>

    <bpmn:sequenceFlow id="SequenceFlow_02" sourceRef="Task_CheckFilesOrder" targetRef="Gateway_IfMissing"/>

    <bpmn:sequenceFlow id="SequenceFlow_03" name="Yes - Missing" sourceRef="Gateway_IfMissing" targetRef="Task_InitiateSearch"/>

    <bpmn:sequenceFlow id="SequenceFlow_04" name="No - OK" sourceRef="Gateway_IfMissing" targetRef="Task_PhysicallyTrack"/>

    <bpmn:sequenceFlow id="SequenceFlow_05" sourceRef="Task_InitiateSearch" targetRef="Gateway_MergeReadiness"/>

    <bpmn:sequenceFlow id="SequenceFlow_06" sourceRef="Task_PhysicallyTrack" targetRef="Gateway_MergeReadiness"/>

    <bpmn:sequenceFlow id="SequenceFlow_07" name="All Ready" sourceRef="Gateway_MergeReadiness" targetRef="Gateway_ConcurrentStart"/>

    <bpmn:sequenceFlow id="SequenceFlow_08" name="Handover Path" sourceRef="Gateway_ConcurrentStart" targetRef="Task_HandFilesToAssociate"/>

    <bpmn:sequenceFlow id="SequenceFlow_12" name="Lawlist Path" sourceRef="Gateway_ConcurrentStart" targetRef="Task_DistributeLawlist"/>

    <bpmn:sequenceFlow id="SequenceFlow_13" name="Handover Complete" sourceRef="Task_HandFilesToAssociate" targetRef="Gateway_MergeParallel"/>

    <bpmn:sequenceFlow id="SequenceFlow_09" name="Lawlist Distributed" sourceRef="Task_DistributeLawlist" targetRef="Gateway_MergeParallel"/>

    <bpmn:sequenceFlow id="SequenceFlow_14" sourceRef="Gateway_MergeParallel" targetRef="Task_ConductHearings"/>

    <bpmn:sequenceFlow id="SequenceFlow_15" name="Proceed to Hearings" sourceRef="Task_ConductHearings" targetRef="EndEvent_HearingComplete"/>

  </bpmn:process>
</bpmn:definitions>