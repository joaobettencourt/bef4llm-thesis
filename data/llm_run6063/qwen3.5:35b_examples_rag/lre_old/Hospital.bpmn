<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_Examination_Process_01" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_MedicalExamination">
    <bpmn:participant id="Participant_OutpatientProcess" name="Medical Examination Process"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Examination_01" isExecutable="true">
    
    <!-- Lane Definitions -->
    <bpmn:laneSet id="LaneSet_MedicalExamination">
      <bpmn:lane id="Lane_OutpatientDept" name="Outpatient Department">
        <bpmn:name>Outpatient Department</bpmn:name>
        <bpmn:flowNodeRef>StartEvent_ExaminePatient_01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OutpatientExamination_02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_IsHealthy_03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FillForm_04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Discharge_05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PlaceOrderRequest_06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformRisks_07</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ConsentObtained_08</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Cancelled_09</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ArrangeAppointment_10</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_WardStaff" name="Ward Staff">
        <bpmn:name>Ward Staff</bpmn:name>
        <bpmn:flowNodeRef>Task_PrepareSampling_11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TakeSample_12</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Laboratory" name="Laboratory">
        <bpmn:name>Laboratory</bpmn:name>
        <bpmn:flowNodeRef>Gateway_ValidSample_13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AnalysisPerformed_14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ValidateResults_15</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Data Objects -->
    <bpmn:dataObject id="DataObj_ExamForm" name="Examination Form"/>
    <bpmn:dataObject id="DataObj_RequestForm" name="Request Form &amp; Consent"/>
    <bpmn:dataObject id="DataObj_Sample" name="Patient Sample"/>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_ExaminePatient_01" name="Examination Request">
      <bpmn:outgoing>SequenceFlow_StartToExam</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Outpatient Lane Tasks -->
    <bpmn:task id="Task_OutpatientExamination_02" name="Physician Examines Patient">
      <bpmn:incoming>SequenceFlow_StartToExam</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ExamToHealthyCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Health Status -->
    <bpmn:exclusiveGateway id="Gateway_IsHealthy_03" name="Patient Healthy?">
      <bpmn:incoming>SequenceFlow_ExamToHealthyCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_YesHealth</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoHealth</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Path 1: Healthy -->
    <bpmn:task id="Task_FillForm_04" name="Fill Examination Form">
      <bpmn:incoming>SequenceFlow_YesHealth</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FormToDischarge</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 1 -->
    <bpmn:endEvent id="EndEvent_Discharge_05" name="Patient Discharged">
      <bpmn:incoming>SequenceFlow_FormToDischarge</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Path 2: Needs Additional Exam -->
    <bpmn:task id="Task_PlaceOrderRequest_06" name="Place Order &amp; Request Form">
      <bpmn:incoming>SequenceFlow_NoHealth</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OrderToInform</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_InformRisks_07" name="Inform Patient of Risks">
      <bpmn:incoming>SequenceFlow_OrderToInform</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RiskToConsentCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2: Consent -->
    <bpmn:exclusiveGateway id="Gateway_ConsentObtained_08" name="Patient Agrees?">
      <bpmn:incoming>SequenceFlow_RiskToConsentCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AgreeYes</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_AgreeNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event 2 -->
    <bpmn:endEvent id="EndEvent_Cancelled_09" name="Procedure Cancelled">
      <bpmn:incoming>SequenceFlow_AgreeNo</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Appointment Arrangement (Outpatient Delegate) -->
    <bpmn:task id="Task_ArrangeAppointment_10" name="Arrange Ward Appointment">
      <bpmn:incoming>SequenceFlow_AgreeYes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AppointToWardPrep</bpmn:outgoing>
    </bpmn:task>

    <!-- Ward Lane Tasks -->
    <bpmn:task id="Task_PrepareSampling_11" name="Prepare Examination &amp; Sampling">
      <bpmn:incoming>SequenceFlow_AppointToWardPrep</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PrepToTakeSample</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_TakeSample_12" name="Ward Physician Takes Sample">
      <bpmn:incoming>SequenceFlow_PrepToTakeSample</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SampleToLabValidation</bpmn:outgoing>
    </bpmn:task>

    <!-- Lab Lane Gateway -->
    <bpmn:exclusiveGateway id="Gateway_ValidSample_13" name="Sample Valid?">
      <bpmn:incoming>SequenceFlow_SampleToLabValidation</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ValidYes</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ValidNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Lab Lane Tasks -->
    <bpmn:task id="Task_AnalysisPerformed_14" name="Perform Analysis">
      <bpmn:incoming>SequenceFlow_ValidYes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AnalysisToValidateRes</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_ValidateResults_15" name="Lab Physician Validates Results">
      <bpmn:incoming>SequenceFlow_AnalysisToValidateRes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ResToDiagnosis</bpmn:outgoing>
    </bpmn:task>

    <!-- Loop Back for Contaminated Sample -->
    <bpmn:sequenceFlow id="SequenceFlow_ValidNo" name="Contaminated" sourceRef="Gateway_ValidSample_13" targetRef="Task_TakeSample_12"/>

    <!-- Return to Outpatient for Diagnosis -->
    <bpmn:task id="Task_DiagnoseTherapy_24" name="Diagnosis &amp; Therapy Prescription">
      <bpmn:incoming>SequenceFlow_ResToDiagnosis</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DxToEndProcess</bpmn:outgoing>
    </bpmn:task>

    <!-- Final End Event -->
    <bpmn:endEvent id="EndEvent_TreatmentPlan_26" name="Treatment Plan Complete">
      <bpmn:incoming>SequenceFlow_DxToEndProcess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    
    1. Start -> Exam Task
    <bpmn:sequenceFlow id="SequenceFlow_StartToExam" sourceRef="StartEvent_ExaminePatient_01" targetRef="Task_OutpatientExamination_02"/>

    2. Exam -> Health Check Gateway
    <bpmn:sequenceFlow id="SequenceFlow_ExamToHealthyCheck" sourceRef="Task_OutpatientExamination_02" targetRef="Gateway_IsHealthy_03"/>

    3a. Healthy Path (Yes)
    <bpmn:sequenceFlow id="SequenceFlow_YesHealth" name="Yes, Healthy" sourceRef="Gateway_IsHealthy_03" targetRef="Task_FillForm_04"/>

    3b. Needs Exam Path (No)
    <bpmn:sequenceFlow id="SequenceFlow_NoHealth" name="Needs Additional Exam" sourceRef="Gateway_IsHealthy_03" targetRef="Task_PlaceOrderRequest_06"/>

    4. Fill Form -> Discharge
    <bpmn:sequenceFlow id="SequenceFlow_FormToDischarge" sourceRef="Task_FillForm_04" targetRef="EndEvent_Discharge_05"/>

    5. Order Request -> Inform Risks
    <bpmn:sequenceFlow id="SequenceFlow_OrderToInform" name="Place order and request form" sourceRef="Task_PlaceOrderRequest_06" targetRef="Task_InformRisks_07"/>

    6. Inform Risks -> Consent Check Gateway
    <bpmn:sequenceFlow id="SequenceFlow_RiskToConsentCheck" sourceRef="Task_InformRisks_07" targetRef="Gateway_ConsentObtained_08"/>

    7a. Consent Yes -> Arrange Appointment
    <bpmn:sequenceFlow id="SequenceFlow_AgreeYes" name="Agrees to Continue" sourceRef="Gateway_ConsentObtained_08" targetRef="Task_ArrangeAppointment_10"/>

    7b. Consent No -> Cancelled End Event
    <bpmn:sequenceFlow id="SequenceFlow_AgreeNo" name="Declines Procedure" sourceRef="Gateway_ConsentObtained_08" targetRef="EndEvent_Cancelled_09"/>

    8. Arrange Appointment -> Ward Prep Task (Cross Lane)
    <bpmn:sequenceFlow id="SequenceFlow_AppointToWardPrep" name="Handover to Ward" sourceRef="Task_ArrangeAppointment_10" targetRef="Task_PrepareSampling_11"/>

    9. Prep -> Take Sample (Ward Lane)
    <bpmn:sequenceFlow id="SequenceFlow_PrepToTakeSample" sourceRef="Task_PrepareSampling_11" targetRef="Task_TakeSample_12"/>

    10. Take Sample -> Lab Validation Gateway (Cross Lane)
    <bpmn:sequenceFlow id="SequenceFlow_SampleToLabValidation" name="Send to Lab" sourceRef="Task_TakeSample_12" targetRef="Gateway_ValidSample_13"/>

    11a. Sample Valid -> Analysis Task (Cross Lane)
    <bpmn:sequenceFlow id="SequenceFlow_ValidYes" name="Valid for Analysis" sourceRef="Gateway_ValidSample_13" targetRef="Task_AnalysisPerformed_14"/>

    12. Analysis -> Validate Results (Cross Lane)
    <bpmn:sequenceFlow id="SequenceFlow_AnalysisToValidateRes" sourceRef="Task_AnalysisPerformed_14" targetRef="Task_ValidateResults_15"/>

    13. Validate Results -> Diagnosis Task (Cross Lane)
    <bpmn:sequenceFlow id="SequenceFlow_ResToDiagnosis" name="Results Available" sourceRef="Task_ValidateResults_15" targetRef="Task_DiagnoseTherapy_24"/>

    <!-- Final Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_DxToEndProcess" sourceRef="Task_DiagnoseTherapy_24" targetRef="EndEvent_TreatmentPlan_26"/>

  </bpmn:process>
</bpmn:definitions>