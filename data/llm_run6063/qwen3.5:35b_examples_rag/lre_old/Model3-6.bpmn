<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_ClaimsProcess_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_ClaimProcessing">
    <bpmn:participant id="Participant_Organization" name="Claims Processing Organization"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_ClaimsNotification" isExecutable="true">
    
    <bpmn:laneSet id="LaneSet_01">
      <bpmn:lane id="Lane_Administration">
        <bpmn:name>Clinical Administration</bpmn:name>
        <bpmn:flowNodeRef>StartEvent_ClaimReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckInsuranceStatus</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_InsuredCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SeverityEvaluation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendFormsSimple</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendFormsComplex</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_FormsReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckCompleteness</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Claimant">
        <bpmn:name>Claimant Communication</bpmn:name>
        <bpmn:flowNodeRef>Task_InformRejection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Rejected</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_System">
        <bpmn:name>Clinical Management System</bpmn:name>
        <bpmn:flowNodeRef>Task_RegisterClaim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ProcessComplete</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_ClaimReceived" name="Claim Received">
      <bpmn:outgoing>SequenceFlow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Check Insurance Status -->
    <bpmn:task id="Task_CheckInsuranceStatus" name="Check Claimant Insured">
      <bpmn:incoming>SequenceFlow_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_02</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Is Claimant Insured? -->
    <bpmn:exclusiveGateway id="Gateway_InsuredCheck" name="Claimant Insured">
      <bpmn:incoming>SequenceFlow_02</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_03</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_04</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 2: Inform Rejection -->
    <bpmn:task id="Task_InformRejection" name="Inform Claimant of Rejection">
      <bpmn:incoming>SequenceFlow_03</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_05</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 1: Claim Rejected -->
    <bpmn:endEvent id="EndEvent_Rejected" name="Claim Rejected">
      <bpmn:incoming>SequenceFlow_04</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Gateway 2: Severity Evaluation (Simple vs Complex) -->
    <bpmn:exclusiveGateway id="Gateway_SeverityEvaluation" name="Claim Severity">
      <bpmn:incoming>SequenceFlow_05</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_06</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_07</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 3a: Send Simple Forms -->
    <bpmn:task id="Task_SendFormsSimple" name="Send Simple Claim Forms">
      <bpmn:incoming>SequenceFlow_06</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_08</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3b: Send Complex Forms -->
    <bpmn:task id="Task_SendFormsComplex" name="Send Complex Claim Forms">
      <bpmn:incoming>SequenceFlow_07</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_08</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 3: Merge Paths after forms sent -->
    <bpmn:parallelGateway id="Gateway_FormsReceived" name="Merge Form Types">
      <bpmn:incoming>SequenceFlow_08</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_09</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 4: Check Completeness -->
    <bpmn:task id="Task_CheckCompleteness" name="Check Forms for Completeness">
      <bpmn:incoming>SequenceFlow_09</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 4: Is Complete? -->
    <bpmn:exclusiveGateway id="Gateway_CompletenessCheck" name="Forms Complete">
      <bpmn:incoming>SequenceFlow_10</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_11</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 5a: Register Claim -->
    <bpmn:task id="Task_RegisterClaim" name="Register in Claims Management System">
      <bpmn:incoming>SequenceFlow_11</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_13</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 2: Process Complete -->
    <bpmn:endEvent id="EndEvent_ProcessComplete" name="Claims Notification Ended">
      <bpmn:incoming>SequenceFlow_13</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task 5b: Inform to Update Forms -->
    <bpmn:task id="Task_InformToUpdate" name="Inform Claimant to Update Forms">
      <bpmn:incoming>SequenceFlow_12</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_09</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flows -->
    
    <bpmn:sequenceFlow id="SequenceFlow_01" sourceRef="StartEvent_ClaimReceived" targetRef="Task_CheckInsuranceStatus"/>

    <bpmn:sequenceFlow id="SequenceFlow_02" name="Insured Check Complete" sourceRef="Task_CheckInsuranceStatus" targetRef="Gateway_InsuredCheck">
      <bpmndi:bpmnEdge>
        <di:waypoint x="150" y="30"/>
        <di:waypoint x="250" y="30"/>
      </bpmndi:bpmnEdge>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_03" name="No - Not Insured" sourceRef="Gateway_InsuredCheck" targetRef="Task_InformRejection"/>

    <bpmn:sequenceFlow id="SequenceFlow_04" name="Yes - Insured" sourceRef="Gateway_InsuredCheck" targetRef="Gateway_SeverityEvaluation">
      <bpmndi:bpmnEdge>
        <di:waypoint x="350" y="120"/>
        <di:waypoint x="450" y="120"/>
      </bpmndi:bpmnEdge>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_05" name="Continue Processing" sourceRef="Task_InformRejection" targetRef="Gateway_SeverityEvaluation">
      <bpmndi:bpmnEdge>
        <di:waypoint x="280" y="120"/>
        <di:waypoint x="350" y="120"/>
      </bpmndi:bpmnEdge>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_06" name="Simple Claim" sourceRef="Gateway_SeverityEvaluation" targetRef="Task_SendFormsSimple">
      <bpmndi:bpmnEdge>
        <di:waypoint x="520" y="30"/>
        <di:waypoint x="620" y="30"/>
      </bpmndi:bpmnEdge>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_07" name="Complex Claim" sourceRef="Gateway_SeverityEvaluation" targetRef="Task_SendFormsComplex">
      <bpmndi:bpmnEdge>
        <di:waypoint x="520" y="180"/>
        <di:waypoint x="620" y="180"/>
      </bpmndi:bpmnEdge>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_08" name="Forms Sent" sourceRef="Task_SendFormsSimple" targetRef="Gateway_FormsReceived">
      <bpmndi:bpmnEdge>
        <di:waypoint x="720" y="30"/>
        <di:waypoint x="820" y="105"/>
      </bpmndi:bpmnEdge>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_09" name="Forms Received" sourceRef="Gateway_FormsReceived" targetRef="Task_CheckCompleteness">
      <bpmndi:bpmnEdge>
        <di:waypoint x="820" y="150"/>
        <di:waypoint x="920" y="150"/>
      </bpmndi:bpmnEdge>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_10" name="Check Complete" sourceRef="Task_CheckCompleteness" targetRef="Gateway_CompletenessCheck">
      <bpmndi:bpmnEdge>
        <di:waypoint x="920" y="150"/>
        <di:waypoint x="1020" y="150"/>
      </bpmndi:bpmnEdge>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_11" name="Forms Complete - Yes" sourceRef="Gateway_CompletenessCheck" targetRef="Task_RegisterClaim">
      <bpmndi:bpmnEdge>
        <di:waypoint x="1090" y="30"/>
        <di:waypoint x="1190" y="30"/>
      </bpmndi:bpmnEdge>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_12" name="Forms Complete - No" sourceRef="Gateway_CompletenessCheck" targetRef="Task_InformToUpdate">
      <bpmndi:bpmnEdge>
        <di:waypoint x="1090" y="270"/>
        <di:waypoint x="1190" y="270"/>
      </bpmndi:bpmnEdge>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_13" name="Register Claim" sourceRef="Task_RegisterClaim" targetRef="EndEvent_ProcessComplete">
      <bpmndi:bpmnEdge>
        <di:waypoint x="1290" y="30"/>
        <di:waypoint x="1390" y="30"/>
      </bpmndi:bpmnEdge>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>