<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_DesignProcess_1">
  <bpmn:collaboration id="Collaboration_DesignCycle">
    <bpmn:participant id="Participant_RetailerDesigns" name="Product Design &amp; Development"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_DesignDevelopment" isExecutable="true">
    
    <!-- Data Objects -->
    <bpmn:dataObjectReference id="Data_ExistingElectricalDesigns" name="Existing Electrical Designs" />
    <bpmn:dataObjectReference id="Data_ExistingPhysicalDesigns" name="Existing Physical Designs" />
    <bpmn:dataObjectReference id="Data_UpdatePlanElectrical" name="Update Plan (Elec)" />
    <bpmn:dataObjectReference id="Data_UpdatePlanPhysical" name="Update Plan (Phys)" />
    <bpmn:dataObjectReference id="Data_DraftDesigns" name="Draft Designs" />

    <!-- Lane Set -->
    <bpmn:laneSet>
      <bpmn:lane id="Lane_ElectricalDept">
        <bpmn:name>Electrical Design Dept</bpmn:name>
        <bpmn:flowNodeRef>Task_LocateDistributeDesigns</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SplitParallel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewCreatePlanElec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DevelopRevisedDesignElec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_TestPassFailElec</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_PhysicalDept">
        <bpmn:name>Physical Design Dept</bpmn:name>
        <bpmn:flowNodeRef>Task_ReviewCreatePlanPhys</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DevelopRevisedDesignPhys</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_TestPassFailPhys</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Combined">
        <bpmn:name>Distribution Center / Manufacturing Handoff</bpmn:name>
        <bpmn:flowNodeRef>Gateway_JoinCombinedTest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TestCombinedDesigns</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="Start_DesignCycle" name="Initiate Design Cycle">
      <bpmn:outgoing>SequenceFlow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Locate and Distribute Designs -->
    <bpmn:task id="Task_LocateDistributeDesigns" name="Locate &amp; Distribute Existing Designs">
      <bpmn:incoming>SequenceFlow_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_02</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Split Gateway -->
    <bpmn:parallelGateway id="Gateway_SplitParallel" name="Start Design Development">
      <bpmn:incoming>SequenceFlow_02</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_03</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_07</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Electrical Lane Tasks -->
    <bpmn:task id="Task_ReviewCreatePlanElec" name="Review &amp; Create Update Plan (Electrical)">
      <bpmn:incoming>SequenceFlow_03</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_04</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_DevelopRevisedDesignElec" name="Develop Revised Design (Electrical)">
      <bpmn:incoming>SequenceFlow_04</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_05</bpmn:outgoing>
    </bpmn:task>

    <!-- Electrical Test Gateway -->
    <bpmn:exclusiveGateway id="Gateway_TestPassFailElec" name="Test Pass?">
      <bpmn:incoming>SequenceFlow_05</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Physical Lane Tasks (Parallel) -->
    <bpmn:task id="Task_ReviewCreatePlanPhys" name="Review &amp; Create Update Plan (Physical)">
      <bpmn:incoming>SequenceFlow_07</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_08</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_DevelopRevisedDesignPhys" name="Develop Revised Design (Physical)">
      <bpmn:incoming>SequenceFlow_08</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_09</bpmn:outgoing>
    </bpmn:task>

    <!-- Physical Test Gateway -->
    <bpmn:exclusiveGateway id="Gateway_TestPassFailPhys" name="Test Pass?">
      <bpmn:incoming>SequenceFlow_09</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Join for Combined Test (Both must pass) -->
    <bpmn:parallelGateway id="Gateway_JoinCombinedTest" name="Wait for Both Designs">
      <bpmn:incoming>SequenceFlow_11</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_12</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_13</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Combined Test Task -->
    <bpmn:task id="Task_TestCombinedDesigns" name="Test Combined Designs">
      <bpmn:incoming>SequenceFlow_13</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_14</bpmn:outgoing>
    </bpmn:task>

    <!-- Final Gateway for Combined Result -->
    <bpmn:exclusiveGateway id="Gateway_CombinedResult" name="Combined Test Pass?">
      <bpmn:incoming>SequenceFlow_14</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event (Success) -->
    <bpmn:endEvent id="End_SentToManufacturing" name="Sent to Manufacturing">
      <bpmn:incoming>SequenceFlow_16</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    
    0. Start -> Locate Designs
    <bpmn:sequenceFlow id="SequenceFlow_01" sourceRef="Start_DesignCycle" targetRef="Task_LocateDistributeDesigns">
      <bpmndescription>Distribution of existing designs.</bpmndescription>
    </bpmn:sequenceFlow>

    2. Locate -> Parallel Split
    <bpmn:sequenceFlow id="SequenceFlow_02" sourceRef="Task_LocateDistributeDesigns" targetRef="Gateway_SplitParallel">
      <bpmndescription>Distribution complete.</bpmndescription>
    </bpmn:sequenceFlow>

    3. Split -> Elec Review (Lane E)
    <bpmn:sequenceFlow id="SequenceFlow_03" sourceRef="Gateway_SplitParallel" targetRef="Task_ReviewCreatePlanElec">
      <bpmndescription>Start Electrical Design.</bpmndescription>
    </bpmn:sequenceFlow>

    4. Elec Review -> Develop (Lane E)
    <bpmn:sequenceFlow id="SequenceFlow_04" sourceRef="Task_ReviewCreatePlanElec" targetRef="Task_DevelopRevisedDesignElec">
      <bpmndescription>Create Revised Design.</bpmndescription>
    </bpmn:sequenceFlow>

    5. Elec Develop -> Test Gateway (Lane E)
    <bpmn:sequenceFlow id="SequenceFlow_05" sourceRef="Task_DevelopRevisedDesignElec" targetRef="Gateway_TestPassFailElec">
      <bpmndescription>Ready for testing.</bpmndescription>
    </bpmn:sequenceFlow>

    6. Elec Test Fail -> Loop Back to Review (Lane E) - Not modeled as separate flow, handled by gateway logic
    
    7. Split -> Phys Review (Lane P)
    <bpmn:sequenceFlow id="SequenceFlow_07" sourceRef="Gateway_SplitParallel" targetRef="Task_ReviewCreatePlanPhys">
      <bpmndescription>Start Physical Design.</bpmndescription>
    </bpmn:sequenceFlow>

    8. Phys Review -> Develop (Lane P)
    <bpmn:sequenceFlow id="SequenceFlow_08" sourceRef="Task_ReviewCreatePlanPhys" targetRef="Task_DevelopRevisedDesignPhys">
      <bpmndescription>Create Revised Design.</bpmndescription>
    </bpmn:sequenceFlow>

    9. Phys Develop -> Test Gateway (Lane P)
    <bpmn:sequenceFlow id="SequenceFlow_09" sourceRef="Task_DevelopRevisedDesignPhys" targetRef="Gateway_TestPassFailPhys">
      <bpmndescription>Ready for testing.</bpmndescription>
    </bpmn:sequenceFlow>

    10. Phys Test Fail -> Loop Back to Review (Lane P) - Not modeled as separate flow, handled by gateway logic
    
    11. Elec Test Pass -> Join Gateway (Lane E)
    <bpmn:sequenceFlow id="SequenceFlow_11" sourceRef="Gateway_TestPassFailElec" targetRef="Gateway_JoinCombinedTest">
      <bpmndescription>Electrical test passed.</bpmndescription>
    </bpmn:sequenceFlow>

    12. Phys Test Pass -> Join Gateway (Lane P)
    <bpmn:sequenceFlow id="SequenceFlow_12" sourceRef="Gateway_TestPassFailPhys" targetRef="Gateway_JoinCombinedTest">
      <bpmndescription>Physical test passed.</bpmndescription>
    </bpmn:sequenceFlow>

    13. Join -> Combined Test Task (Lane C)
    <bpmn:sequenceFlow id="SequenceFlow_13" sourceRef="Gateway_JoinCombinedTest" targetRef="Task_TestCombinedDesigns">
      <bpmndescription>Both designs ready for combined test.</bpmndescription>
    </bpmn:sequenceFlow>

    14. Combined Test -> Final Gateway (Lane C)
    <bpmn:sequenceFlow id="SequenceFlow_14" sourceRef="Task_TestCombinedDesigns" targetRef="Gateway_CombinedResult">
      <bpmndescription>Testing complete.</bpmndescription>
    </bpmn:sequenceFlow>

    15. Combined Test Fail -> Loop to Start (Lane C) - Not modeled as separate flow, handled by gateway logic
    
    16. Combined Test Pass -> End Event (Lane C)
    <bpmn:sequenceFlow id="SequenceFlow_16" sourceRef="Gateway_CombinedResult" targetRef="End_SentToManufacturing">
      <bpmndescription>Sent to Manufacturing Process.</bpmndescription>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>