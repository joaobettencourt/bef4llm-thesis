<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_Subrogation_1">
  <bpmn:collaboration id="Collaboration_SubrogationProcess">
    <bpmn:participant id="Participant_RetailerOperations" name="Insurance Operations"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_SubrogationHandling" isExecutable="true">
    
    <bpmn:laneSet id="LaneSet_01">
      <bpmn:lane id="Lane_CaseHandler">
        <bpmn:name>Case Handler</bpmn:name>
        <bpmn:flowNodeRef>StartEvent_SubrogationCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckSubrogationPossibility</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RecoursePossible</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Manager">
        <bpmn:name>Dispute Manager</bpmn:name>
        <bpmn:flowNodeRef>Task_CheckInsurantReasoning</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DisagreementReceived</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Finance">
        <bpmn:name>Fund Management</bpmn:name>
        <bpmn:flowNodeRef>Task_ReceiveMoneyBooking</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Archive">
        <bpmn:name>Collections Department</bpmn:name>
        <bpmn:flowNodeRef>Gateway_DeadlineReached</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ForwardToCollectionAgency</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_SubrogationCheck" name="Subrogation Case Received">
      <bpmn:outgoing>SequenceFlow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Check Subrogation Possibility -->
    <bpmn:task id="Task_CheckSubrogationPossibility" name="Check Recourse Possibility">
      <bpmn:incoming>SequenceFlow_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_02</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Is Recourse Possible? -->
    <bpmn:exclusiveGateway id="Gateway_RecoursePossible" name="Recourse&#10;Possible?">
      <bpmn:incoming>SequenceFlow_02</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_03</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_04</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 2: Send Payment Request -->
    <bpmn:task id="Task_SendPaymentRequest" name="Send Payment&#10;Request">
      <bpmn:incoming>SequenceFlow_03</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_05</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3: Make Reminder -->
    <bpmn:task id="Task_MakeReminder" name="Make&#10;Reminder">
      <bpmn:incoming>SequenceFlow_04</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_05</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2: Disagreement Received? -->
    <bpmn:exclusiveGateway id="Gateway_DisagreementReceived" name="Disagreement&#10;Received?">
      <bpmn:incoming>SequenceFlow_05</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_06</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_07</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 4: Check Insurant Reasoning -->
    <bpmn:task id="Task_CheckInsurantReasoning" name="Check&#10;Disagreement">
      <bpmn:incoming>SequenceFlow_06</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_08</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 3: Is Insurant Right? -->
    <bpmn:exclusiveGateway id="Gateway_IsInsurantRight" name="Reasoning&#10;Valid?">
      <bpmn:incoming>SequenceFlow_08</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_09</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 5: Receive Money Booking -->
    <bpmn:task id="Task_ReceiveMoneyBooking" name="Make&#10;Payment&#10;Booking">
      <bpmn:incoming>SequenceFlow_07</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_11</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 6: Close Case -->
    <bpmn:task id="Task_CloseCaseSuccess" name="Close&#10;Subrogation">
      <bpmn:incoming>SequenceFlow_09</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_10</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_11</bpmn:incoming>
    </bpmn:task>

    <!-- Task 7: Forward to Collection Agency -->
    <bpmn:task id="Task_ForwardToCollectionAgency" name="Forward&#10;to&#10;Collections">
      <bpmn:incoming>SequenceFlow_12</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_13</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 4: Deadline Reached? -->
    <bpmn:exclusiveGateway id="Gateway_DeadlineReached" name="Deadline&#10;Exceeded?">
      <bpmn:incoming>SequenceFlow_05</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event 1: Case Closed Successfully -->
    <bpmn:endEvent id="EndCaseClosed" name="Subrogation&#10;Resolved">
      <bpmn:incoming>SequenceFlow_14</bpmn:incoming>
    </bpmn:endEvent>

    <!-- End Event 2: Forwarded to Collections -->
    <bpmn:endEvent id="EndCollections" name="Forwarded&#10;to&#10;Collection">
      <bpmn:incoming>SequenceFlow_13</bpmn:incoming>
    </bpmn:endEvent>

    <!-- End Event 3: Recourse Not Possible -->
    <bpmn:endEvent id="EndNoRecourse" name="Case&#10;Closed">
      <bpmn:incoming>SequenceFlow_04</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    
    <!-- Start -> Check Possibility -->
    <bpmn:sequenceFlow id="SequenceFlow_01" sourceRef="StartEvent_SubrogationCheck" targetRef="Task_CheckSubrogationPossibility">
      <bpmn:name>Case Received</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Check Possibility -> Gateway -->
    <bpmn:sequenceFlow id="SequenceFlow_02" sourceRef="Task_CheckSubrogationPossibility" targetRef="Gateway_RecoursePossible">
      <bpmn:description>Possibility confirmed</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Gateway -> Send Request (Yes) -->
    <bpmn:sequenceFlow id="SequenceFlow_03" sourceRef="Gateway_RecoursePossible" targetRef="Task_SendPaymentRequest">
      <bpmn:name>Possibility&#10;Confirmed</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Gateway -> Close Case (No) -->
    <bpmn:sequenceFlow id="SequenceFlow_04" sourceRef="Gateway_RecoursePossible" targetRef="EndNoRecourse">
      <bpmn:name>No Recourse&#10;Possible</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Send Request -> Disagreement Gateway -->
    <bpmn:sequenceFlow id="SequenceFlow_05" sourceRef="Task_SendPaymentRequest" targetRef="Gateway_DisagreementReceived">
      <bpmn:description>Pending response</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Disagreement Gateway -> Check Reasoning (Yes) -->
    <bpmn:sequenceFlow id="SequenceFlow_06" sourceRef="Gateway_DisagreementReceived" targetRef="Task_CheckInsurantReasoning">
      <bpmn:name>Disagreement&#10;Received</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Disagreement Gateway -> Receive Money (No) -->
    <bpmn:sequenceFlow id="SequenceFlow_07" sourceRef="Gateway_DisagreementReceived" targetRef="Task_ReceiveMoneyBooking">
      <bpmn:name>No&#10;Disagreement</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Check Reasoning -> Is Right Gateway -->
    <bpmn:sequenceFlow id="SequenceFlow_08" sourceRef="Task_CheckInsurantReasoning" targetRef="Gateway_IsInsurantRight">
      <bpmn:description>Analysis complete</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Is Right -> Close Case (Yes) -->
    <bpmn:sequenceFlow id="SequenceFlow_09" sourceRef="Gateway_IsInsurantRight" targetRef="Task_CloseCaseSuccess">
      <bpmn:name>Reasoning&#10;Valid</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Is Right -> Forward to Collections (No) -->
    <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="Gateway_IsInsurantRight" targetRef="Task_ForwardToCollectionAgency">
      <bpmn:name>Reasoning&#10;Invalid</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Receive Money -> Close Case -->
    <bpmn:sequenceFlow id="SequenceFlow_11" sourceRef="Task_ReceiveMoneyBooking" targetRef="Task_CloseCaseSuccess">
      <bpmn:description>Paid</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Deadline Reached -> Forward to Collections -->
    <bpmn:sequenceFlow id="SequenceFlow_12" sourceRef="Gateway_DeadlineReached" targetRef="Task_ForwardToCollectionAgency">
      <bpmn:name>No&#10;Payment</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Forward to Collections -> End -->
    <bpmn:sequenceFlow id="SequenceFlow_13" sourceRef="Task_ForwardToCollectionAgency" targetRef="EndCollections">
      <bpmn:description>Collections initiated</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Close Case -> End -->
    <bpmn:sequenceFlow id="SequenceFlow_14" sourceRef="Task_CloseCaseSuccess" targetRef="EndCaseClosed">
      <bpmn:name>Resolved</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>