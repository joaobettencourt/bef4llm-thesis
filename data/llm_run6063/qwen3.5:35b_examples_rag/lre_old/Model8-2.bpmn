<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_JobPosting_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_VacancyProcess">
    <bpmn:participant id="Participant_HRDepartment" name="HR Department Operations"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_JobPosting_1" isExecutable="true">
    
    <bpmn:laneSet id="LaneSet_Vacancy">
      <bpmn:lane id="Lane_HRStaff" name="HR Staff Member">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateDescription</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ConfusionCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CatchEvent_DepartmentClarification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AskDepartmentAgain</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_MergePaths</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CatchEvent_ApprovalResponse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitForApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ApprovalDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CorrectDescription</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ResubmitLoop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PostJob</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Vacancy Reported">
      <bpmn:outgoing>SequenceFlow_StartToCreate</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Create Job Description -->
    <bpmn:task id="Task_CreateDescription" name="Create Job Description">
      <bpmn:incoming>SequenceFlow_StartToCreate</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CreateToGateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Is there confusion? -->
    <bpmn:exclusiveGateway id="Gateway_ConfusionCheck" name="Confusion in message">
      <bpmn:incoming>SequenceFlow_CreateToGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NoClarificationNeeded</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NeedClarification</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Intermediate Catching Event 1: Wait for Department clarification -->
    <bpmn:intermediateCatchEvent id="CatchEvent_DepartmentClarification" name="Wait for department response">
      <bpmn:incoming>SequenceFlow_NeedClarification</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ClarificationReceived</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task 2: Ask Department Again -->
    <bpmn:task id="Task_AskDepartmentAgain" name="Ask department again">
      <bpmn:incoming>SequenceFlow_ClarificationReceived</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToMergeGateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Inclusive Gateway 1: Merge paths (with or without clarification) -->
    <bpmn:inclusiveGateway id="InclusiveGateway_MergePaths" name="Clarification Path">
      <bpmn:incoming>SequenceFlow_NoClarificationNeeded</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ToMergeGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SubmitForApproval</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Task 3: Submit for Approval -->
    <bpmn:task id="Task_SubmitForApproval" name="Submit job description">
      <bpmn:incoming>SequenceFlow_SubmitForApproval</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToDecisionGateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Catching Event 2: Wait for approval response -->
    <bpmn:intermediateCatchEvent id="CatchEvent_ApprovalResponse" name="Wait for approval decision">
      <bpmn:incoming>SequenceFlow_ToDecisionGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DecisionReceived</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Gateway 2: Approval Decision -->
    <bpmn:exclusiveGateway id="Gateway_ApprovalDecision" name="Approved?">
      <bpmn:incoming>SequenceFlow_DecisionReceived</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RejectedPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ApprovedPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 4: Correct Description (if rejected) -->
    <bpmn:task id="Task_CorrectDescription" name="Correct description">
      <bpmn:incoming>SequenceFlow_RejectedPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ResubmitToGateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 3: Loop back to approval -->
    <bpmn:exclusiveGateway id="Gateway_ResubmitLoop" name="Submit again">
      <bpmn:incoming>SequenceFlow_ResubmitToGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToApprovalWait</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 5: Post Job (if approved) -->
    <bpmn:task id="Task_PostJob" name="Post the job">
      <bpmn:incoming>SequenceFlow_ApprovedPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToEndEvent</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_1" name="Job Posted">
      <bpmn:incoming>SequenceFlow_ToEndEvent</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    
    <bpmn:sequenceFlow id="SequenceFlow_StartToCreate" sourceRef="StartEvent_1" targetRef="Task_CreateDescription"/>

    <bpmn:sequenceFlow id="SequenceFlow_CreateToGateway" sourceRef="Task_CreateDescription" targetRef="Gateway_ConfusionCheck"/>

    <bpmn:sequenceFlow id="SequenceFlow_NoClarificationNeeded" name="No clarification needed" sourceRef="Gateway_ConfusionCheck" targetRef="InclusiveGateway_MergePaths"/>

    <bpmn:sequenceFlow id="SequenceFlow_NeedClarification" name="Need clarification" sourceRef="Gateway_ConfusionCheck" targetRef="CatchEvent_DepartmentClarification"/>

    <bpmn:sequenceFlow id="SequenceFlow_ClarificationReceived" name="Department response received" sourceRef="CatchEvent_DepartmentClarification" targetRef="Task_AskDepartmentAgain"/>

    <bpmn:sequenceFlow id="SequenceFlow_ToMergeGateway" name="Ask department again" sourceRef="Task_AskDepartmentAgain" targetRef="InclusiveGateway_MergePaths"/>

    <bpmn:sequenceFlow id="SequenceFlow_SubmitForApproval" name="Submit for approval" sourceRef="InclusiveGateway_MergePaths" targetRef="Task_SubmitForApproval"/>

    <bpmn:sequenceFlow id="SequenceFlow_ToDecisionGateway" name="Submit for consideration" sourceRef="Task_SubmitForApproval" targetRef="CatchEvent_ApprovalResponse"/>

    <bpmn:sequenceFlow id="SequenceFlow_DecisionReceived" name="Decision received" sourceRef="CatchEvent_ApprovalResponse" targetRef="Gateway_ApprovalDecision"/>

    <bpmn:sequenceFlow id="SequenceFlow_RejectedPath" name="Not approved" sourceRef="Gateway_ApprovalDecision" targetRef="Task_CorrectDescription"/>

    <bpmn:sequenceFlow id="SequenceFlow_ResubmitToGateway" name="Correct and resubmit" sourceRef="Task_CorrectDescription" targetRef="Gateway_ResubmitLoop"/>

    <bpmn:sequenceFlow id="SequenceFlow_ToApprovalWait" name="Resubmit" sourceRef="Gateway_ResubmitLoop" targetRef="CatchEvent_ApprovalResponse"/>

    <bpmn:sequenceFlow id="SequenceFlow_ApprovedPath" name="Approved" sourceRef="Gateway_ApprovalDecision" targetRef="Task_PostJob"/>

    <bpmn:sequenceFlow id="SequenceFlow_ToEndEvent" name="Post the job" sourceRef="Task_PostJob" targetRef="EndEvent_1"/>

  </bpmn:process>
</bpmn:definitions>