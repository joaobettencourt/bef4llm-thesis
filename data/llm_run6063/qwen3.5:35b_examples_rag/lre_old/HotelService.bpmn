<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_RoomService_1">
  <bpmn:collaboration id="Collaboration_RoomService">
    <bpmn:participant id="Participant_HotelOperations" name="The Evanstonian Room Service" processRef="Process_RoomService"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_RoomService" isExecutable="true">
    
    <bpmn:laneSet id="LaneSet_01">
      <bpmn:lane id="Lane_Manager">
        <bpmn:name>Room Service Manager</bpmn:name>
        <bpmn:flowNodeRef>StartEvent_RoomServiceCall</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TakeOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_WineRequired</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Kitchen">
        <bpmn:name>Kitchen Staff</bpmn:name>
        <bpmn:flowNodeRef>Task_PrepareFood</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Sommelier">
        <bpmn:name>Sommelier (Wine Waiter)</bpmn:name>
        <bpmn:flowNodeRef>Task_PrepareBeverages</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Waiter">
        <bpmn:name>Waiter</bpmn:name>
        <bpmn:flowNodeRef>Task_ReadiesCart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MergeAllReady</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DeliverToRoom</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DebitAccount</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_RoomServiceCall" name="Guest Calls Room Service">
      <bpmn:outgoing>SequenceFlow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Take Order -->
    <bpmn:task id="Task_TakeOrder" name="Take Down Guest Order">
      <bpmn:incoming>SequenceFlow_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_02</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Wine Required Decision (80% include wine) -->
    <bpmn:exclusiveGateway id="Gateway_WineRequired" name="Wine/Alcohol&#10;Included?">
      <bpmn:incoming>SequenceFlow_02</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_03</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_04</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 2: Prepare Food (Kitchen) -->
    <bpmn:task id="Task_PrepareFood" name="Prepare Food">
      <bpmn:incoming>SequenceFlow_05</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3: Prepare Beverages (Sommelier) -->
    <bpmn:task id="Task_PrepareBeverages" name="Fetch Wine &amp; Alcoholic&#10;Beverages">
      <bpmn:incoming>SequenceFlow_06</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_11</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 4: Readies Cart (Waiter) -->
    <bpmn:task id="Task_ReadiesCart" name="Readies Delivery&#10;Cart">
      <bpmn:incoming>SequenceFlow_07</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_12</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2: Merge All Paths -->
    <bpmn:parallelGateway id="Gateway_MergeAllReady" name="Merge&#10;Paths">
      <bpmn:incoming>SequenceFlow_10</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_11</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_12</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 5: Deliver to Room -->
    <bpmn:task id="Task_DeliverToRoom" name="Deliver Order&#10;to Guest">
      <bpmn:incoming>SequenceFlow_12</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_13</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 6: Debit Account -->
    <bpmn:task id="Task_DebitAccount" name="Debit Guest&#10;Account">
      <bpmn:incoming>SequenceFlow_14</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_15</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_OrderComplete" name="Order&#10;Completed">
      <bpmn:incoming>SequenceFlow_16</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    
    <bpmn:sequenceFlow id="SequenceFlow_01" sourceRef="StartEvent_RoomServiceCall" targetRef="Task_TakeOrder"/>
    <bpmn:sequenceFlow id="SequenceFlow_02" name="Submit Order Ticket" sourceRef="Task_TakeOrder" targetRef="Gateway_WineRequired"/>
    
    <!-- Wine Decision Paths -->
    <bpmn:sequenceFlow id="SequenceFlow_03" name="Yes - 80%" sourceRef="Gateway_WineRequired" targetRef="Task_PrepareBeverages">
      <bpmn:description>Wine/alcohol required</bpmn:description>
    </bpmn:sequenceFlow>
    
    <!-- Kitchen Path (Parallel to Wine Decision) -->
    <bpmn:sequenceFlow id="SequenceFlow_05" sourceRef="Task_TakeOrder" targetRef="Task_PrepareFood">
      <bpmn:description>Kitchen begins food preparation</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Waiter Cart Path (from Wine Decision No) -->
    <bpmn:sequenceFlow id="SequenceFlow_07" sourceRef="Gateway_WineRequired" targetRef="Task_ReadiesCart">
      <bpmn:description>No wine/alcohol required</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Merge Paths -->
    <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="Task_PrepareFood" targetRef="Gateway_MergeAllReady">
      <bpmn:description>Food preparation complete</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Sommelier Path -->
    <bpmn:sequenceFlow id="SequenceFlow_11" sourceRef="Task_PrepareBeverages" targetRef="Gateway_MergeAllReady">
      <bpmn:description>Beverage preparation complete</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Waiter Cart Path to Merge -->
    <bpmn:sequenceFlow id="SequenceFlow_12" sourceRef="Task_ReadiesCart" targetRef="Gateway_MergeAllReady">
      <bpmn:description>Cart ready</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Delivery Path -->
    <bpmn:sequenceFlow id="SequenceFlow_13" sourceRef="Gateway_MergeAllReady" targetRef="Task_DeliverToRoom">
      <bpmn:description>All items ready for delivery</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Debit Account Path -->
    <bpmn:sequenceFlow id="SequenceFlow_14" sourceRef="Task_DeliverToRoom" targetRef="Task_DebitAccount">
      <bpmn:description>Order delivered, waiter returns</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- End Path -->
    <bpmn:sequenceFlow id="SequenceFlow_15" sourceRef="Task_DebitAccount" targetRef="EndEvent_OrderComplete">
      <bpmn:description>Guest account debited</bpmn:description>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>