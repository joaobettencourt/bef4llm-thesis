<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_ZooClubMembership_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_ZooClubProcess">
    <bpmn:participant id="Participant_Visitor" name="Visitor"/>
    <bpmn:participant id="Participant_ZooClubDept" name="ZooClub Department" processRef="Process_ZooClubMain"/>
    <bpmn:participant id="Participant_BillingDept" name="Billing Department" processRef="Process_Billing"/>
    <bpmn:participant id="Participant_MarketingDept" name="Marketing Department" processRef="Process_Marketing"/>
    <bpmn:participant id="Participant_Bank" name="Bank" processRef="Process_Banking"/>

    <!-- Message Flows between participants -->
    <bpmn:messageFlow id="MessageFlow_01" sourceRef="Task_VisitorDecideMembershipType" targetRef="StartEvent_ZooClubRequest"/>
    <bpmn:messageFlow id="MessageFlow_02" sourceRef="Gateway_MemberInfoPrepared" targetRef="StartEvent_BillingPaymentReq"/>
    <bpmn:messageFlow id="MessageFlow_03" sourceRef="Task_VisitorDecideMembershipType" targetRef="StartEvent_MarketingRequest"/>
  </bpmn:collaboration>

  <!-- Visitor Process -->
  <bpmn:process id="Process_VisitorMembership">
    <bpmn:startEvent id="StartEvent_VisitorRequest" name="Visit ZooClub Website">
      <bpmn:outgoing>SequenceFlow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_VisitorDecideMembershipType" name="Choose Membership Type (Individual/Family)">
      <bpmn:incoming>SequenceFlow_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_02</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for membership type decision -->
    <bpmn:exclusiveGateway id="Gateway_MemberTypeDecision" name="Membership Type?">
      <bpmn:incoming>SequenceFlow_02</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_03</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_04</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Individual membership path -->
    <bpmn:task id="Task_PrepareIndividualInfo" name="Prepare Personal Information">
      <bpmn:incoming>SequenceFlow_03</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_05</bpmn:outgoing>
    </bpmn:task>

    <!-- Family membership path -->
    <bpmn:task id="Task_PrepareFamilyInfo" name="Prepare Spouse Information">
      <bpmn:incoming>SequenceFlow_04</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_06</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for family member info -->
    <bpmn:exclusiveGateway id="Gateway_FamilyMemberInfo" name="Children?">
      <bpmn:incoming>SequenceFlow_06</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_07</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Children information path -->
    <bpmn:task id="Task_PrepareChildrenInfo" name="Prepare Children Information">
      <bpmn:incoming>SequenceFlow_07</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_08</bpmn:outgoing>
    </bpmn:task>

    <!-- Merge paths -->
    <bpmn:parallelGateway id="Gateway_MemberInfoPrepared" name="Merge Info">
      <bpmn:incoming>SequenceFlow_05</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_08</bpmn:incoming>
    </bpmn:parallelGateway>

    <!-- End of visitor process -->
    <bpmn:endEvent id="End_VisitorRequestSent" name="Information Submitted">
      <bpmn:incoming>SequenceFlow_12</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows for Visitor Process -->
    <bpmn:sequenceFlow id="SequenceFlow_01" sourceRef="StartEvent_VisitorRequest" targetRef="Task_VisitorDecideMembershipType"/>
    <bpmn:sequenceFlow id="SequenceFlow_02" sourceRef="Task_VisitorDecideMembershipType" targetRef="Gateway_MemberTypeDecision"/>
    <bpmn:sequenceFlow id="SequenceFlow_03" name="Individual Membership" sourceRef="Gateway_MemberTypeDecision" targetRef="Task_PrepareIndividualInfo"/>
    <bpmn:sequenceFlow id="SequenceFlow_04" name="Family Membership" sourceRef="Gateway_MemberTypeDecision" targetRef="Task_PrepareFamilyInfo"/>
    <bpmn:sequenceFlow id="SequenceFlow_05" sourceRef="Task_PrepareIndividualInfo" targetRef="Gateway_MemberInfoPrepared"/>
    <bpmn:sequenceFlow id="SequenceFlow_06" sourceRef="Task_PrepareFamilyInfo" targetRef="Gateway_FamilyMemberInfo"/>
    <bpmn:sequenceFlow id="SequenceFlow_07" name="Yes - Children exist" sourceRef="Gateway_FamilyMemberInfo" targetRef="Task_PrepareChildrenInfo"/>
    <bpmn:sequenceFlow id="SequenceFlow_08" sourceRef="Task_PrepareChildrenInfo" targetRef="Gateway_MemberInfoPrepared"/>

  </bpmn:process>

  <!-- ZooClub Department Process -->
  <bpmn:process id="Process_ZooClubMain">
    <bpmn:startEvent id="StartEvent_ZooClubRequest" name="Membership Request Received">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Lane for ZooClub Department -->
    <bpmn:laneSet id="LaneSet_ZooClub">
      <bpmn:lane id="Lane_DataEntry" name="Data Entry Team">
        <bpmn:name>Data Entry</bpmn:name>
        <bpmn:flowNodeRef>Task_EntryPersonalInfo</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_CardProcessing" name="Card Processing Team">
        <bpmn:name>Card Processing</bpmn:name>
        <bpmn:flowNodeRef>Task_PrintAndDeliverCard</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Marketing" name="Marketing Team">
        <bpmn:name>Marketing</bpmn:name>
        <bpmn:flowNodeRef>Task_ForwardToMarketingDept</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Billing" name="Billing Team">
        <bpmn:name>Billing</bpmn:name>
        <bpmn:flowNodeRef>Task_SendPaymentRequestToBank</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Data Entry Task -->
    <bpmn:task id="Task_EntryPersonalInfo" name="Enter Personal Information into System">
      <bpmn:incoming>SequenceFlow_10</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_11</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for parallel processing -->
    <bpmn:parallelGateway id="Gateway_ParallelProcessing" name="Parallel Processing">
      <bpmn:incoming>SequenceFlow_11</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_12</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_13</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Marketing forwarding -->
    <bpmn:task id="Task_ForwardToMarketingDept" name="Forward Information to Marketing Department">
      <bpmn:incoming>SequenceFlow_12</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_14</bpmn:outgoing>
    </bpmn:task>

    <!-- Billing forwarding -->
    <bpmn:task id="Task_SendPaymentRequestToBank" name="Send Payment Request to Bank">
      <bpmn:incoming>SequenceFlow_13</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_15</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for payment confirmation -->
    <bpmn:exclusiveGateway id="Gateway_PaymentConfirmed" name="Payment Confirmed?">
      <bpmn:incoming>SequenceFlow_16</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Card printing and delivery -->
    <bpmn:task id="Task_PrintAndDeliverCard" name="Print Membership Card">
      <bpmn:incoming>SequenceFlow_18</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_20</bpmn:outgoing>
    </bpmn:task>

    <!-- End event -->
    <bpmn:endEvent id="End_ZooClubProcessComplete" name="Membership Process Complete">
      <bpmn:incoming>SequenceFlow_19</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows for ZooClub Department -->
    <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="StartEvent_ZooClubRequest" targetRef="Task_EntryPersonalInfo"/>
    <bpmn:sequenceFlow id="SequenceFlow_11" sourceRef="Task_EntryPersonalInfo" targetRef="Gateway_ParallelProcessing"/>
    <bpmn:sequenceFlow id="SequenceFlow_12" name="Marketing Path" sourceRef="Gateway_ParallelProcessing" targetRef="Task_ForwardToMarketingDept"/>
    <bpmn:sequenceFlow id="SequenceFlow_13" name="Billing Path" sourceRef="Gateway_ParallelProcessing" targetRef="Task_SendPaymentRequestToBank"/>

  </bpmn:process>

  <!-- Billing Department Process -->
  <bpmn:process id="Process_Billing">
    <bpmn:startEvent id="StartEvent_BillingPaymentReq" name="Receive Payment Request">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_21</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Lane for Billing Department -->
    <bpmn:laneSet id="LaneSet_Billing">
      <bpmn:lane id="Lane_PaymentProcessing" name="Payment Processing Team">
        <bpmn:name>Payment Processing</bpmn:name>
        <bpmn:flowNodeRef>Task_SendToBankForCharging</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Send payment to bank -->
    <bpmn:task id="Task_SendToBankForCharging" name="Send Payment Request for Charging">
      <bpmn:incoming>SequenceFlow_21</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_22</bpmn:outgoing>
    </bpmn:task>

    <!-- End event -->
    <bpmn:endEvent id="End_BillingProcessComplete" name="Payment Request Sent">
      <bpmn:incoming>SequenceFlow_23</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows for Billing Department -->
    <bpmn:sequenceFlow id="SequenceFlow_21" sourceRef="StartEvent_BillingPaymentReq" targetRef="Task_SendToBankForCharging"/>
    <bpmn:sequenceFlow id="SequenceFlow_22" name="Send to Bank" sourceRef="Task_SendToBankForCharging" targetRef="End_BillingProcessComplete"/>

  </bpmn:process>

  <!-- Marketing Department Process -->
  <bpmn:process id="Process_Marketing">
    <bpmn:startEvent id="StartEvent_MarketingRequest" name="Receive Visitor Information">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_24</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Lane for Marketing Department -->
    <bpmn:laneSet id="LaneSet_Marketing">
      <bpmn:lane id="Lane_Publications" name="Publications Team">
        <bpmn:name>Publications</bpmn:name>
        <bpmn:flowNodeRef>Task_RequestMagazineDelivery</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Magazine delivery request -->
    <bpmn:task id="Task_RequestMagazineDelivery" name="Request Zoo Club Magazine Delivery">
      <bpmn:incoming>SequenceFlow_24</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_25</bpmn:outgoing>
    </bpmn:task>

    <!-- End event -->
    <bpmn:endEvent id="End_MarketingProcessComplete" name="Magazine Request Sent">
      <bpmn:incoming>SequenceFlow_26</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows for Marketing Department -->
    <bpmn:sequenceFlow id="SequenceFlow_24" sourceRef="StartEvent_MarketingRequest" targetRef="Task_RequestMagazineDelivery"/>
    <bpmn:sequenceFlow id="SequenceFlow_25" name="Send Request" sourceRef="Task_RequestMagazineDelivery" targetRef="End_MarketingProcessComplete"/>

  </bpmn:process>

  <!-- Bank Process -->
  <bpmn:process id="Process_Banking">
    <bpmn:startEvent id="StartEvent_PaymentRequestReceived" name="Receive Payment Request from ZooClub">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>SequenceFlow_27</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Lane for Bank -->
    <bpmn:laneSet id="LaneSet_Bank">
      <bpmn:lane id="Lane_PaymentProcessing" name="Payment Processing Team">
        <bpmn:name>Payment Processing</bpmn:name>
        <bpmn:flowNodeRef>Task_ProcessAndChargeAccount</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Process payment -->
    <bpmn:task id="Task_ProcessAndChargeAccount" name="Process Payment and Charge Account">
      <bpmn:incoming>SequenceFlow_27</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_28</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for payment confirmation -->
    <bpmn:exclusiveGateway id="Gateway_PaymentValid" name="Payment Valid?">
      <bpmn:incoming>SequenceFlow_29</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_30</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Send confirmation back to ZooClub -->
    <bpmn:endEvent id="End_BankProcessComplete" name="Payment Processed">
      <bpmn:incoming>SequenceFlow_29</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows for Bank -->
    <bpmn:sequenceFlow id="SequenceFlow_27" sourceRef="StartEvent_PaymentRequestReceived" targetRef="Task_ProcessAndChargeAccount"/>
    <bpmn:sequenceFlow id="SequenceFlow_28" name="Process Payment" sourceRef="Task_ProcessAndChargeAccount" targetRef="Gateway_PaymentValid"/>

  </bpmn:process>

</bpmn:definitions>