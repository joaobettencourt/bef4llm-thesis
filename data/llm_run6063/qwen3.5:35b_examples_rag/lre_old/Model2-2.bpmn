<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_CustomerSwitch_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_SwitchProcess">
    <bpmn:participant id="Participant_CustService" name="Customer Service Department"/>
    <bpmn:participant id="Participant_GridOperator" name="Grid Operator"/>
    <bpmn:participant id="Participant_OldSupplier" name="Old Supplier"/>
  </bpmn:collaboration>

  <!-- Customer Service Process -->
  <bpmn:process id="Process_CustService">
    
    <bpmn:startEvent id="Start_SwitchRequest" name="Switch-over Request Received">
      <bpmn:outgoing>SequenceFlow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Data Entry and Validation -->
    <bpmn:task id="Task_EnterDataCRM" name="Enter Customer Data into CRM System">
      <bpmn:incoming>SequenceFlow_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_02</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_DataValidation" name="Data Complete &amp; Plausible?">
      <bpmn:incoming>SequenceFlow_02</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_03</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_04</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_CorrectErrors" name="Correct Errors Based on Error List">
      <bpmn:incoming>SequenceFlow_03</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_02</bpmn:outgoing>
    </bpmn:task>

    <!-- Customer Existence Check -->
    <bpmn:exclusiveGateway id="Gateway_CustomerExists" name="Customer in Database?">
      <bpmn:incoming>SequenceFlow_04</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_05</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_06</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- New Customer Creation -->
    <bpmn:task id="Task_CreateCustomerObject" name="Create New Customer Object">
      <bpmn:incoming>SequenceFlow_05</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_06</bpmn:outgoing>
    </bpmn:task>

    <!-- Contract Preparation -->
    <bpmn:task id="Task_PrepareContracts" name="Prepare Contract Documents">
      <bpmn:incoming>SequenceFlow_04</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_07</bpmn:outgoing>
    </bpmn:task>

    <!-- CIS Automated Check -->
    <bpmn:intermediateThrowEvent id="IntermediateMessage_CISCheck" name="Request Contract Verification">
      <bpmn:incoming>SequenceFlow_07</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_08</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <!-- CIS Result Gateway -->
    <bpmn:exclusiveGateway id="Gateway_CISResult" name="Contract Verification Successful?">
      <bpmn:incoming>SequenceFlow_12</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_09</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Contract Error Handling -->
    <bpmn:task id="Task_AnalyzeContractIssues" name="Analyze &amp; Resolve Issues">
      <bpmn:incoming>SequenceFlow_09</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_14</bpmn:outgoing>
    </bpmn:task>

    <!-- Confirmation to Customer -->
    <bpmn:intermediateThrowEvent id="IntermediateMessage_Confirmation" name="Send Switch-over Confirmation">
      <bpmn:incoming>SequenceFlow_08</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_15</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <!-- Customer Decision -->
    <bpmn:exclusiveGateway id="Gateway_CustomerDecision" name="Customer Confirms?">
      <bpmn:incoming>SequenceFlow_20</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_16</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Withdrawal End -->
    <bpmn:endEvent id="End_CustomerWithdraws" name="Process Ends (Customer Withdraws)">
      <bpmn:incoming>SequenceFlow_16</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Timer for 7-day acceptance window -->
    <bpmn:intermediateCatchEvent id="IntermediateTimer_Acceptance" name="Wait up to 7 Days">
      <bpmn:incoming>SequenceFlow_15</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_20</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Continue to Grid Operator Request -->
    <bpmn:task id="Task_RequestGridOperator" name="Request Supplier Concurrence Check">
      <bpmn:incoming>SequenceFlow_17</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_20</bpmn:outgoing>
    </bpmn:task>

    <!-- Meter Data Import -->
    <bpmn:endEvent id="End_ProcessComplete" name="Process Complete">
      <bpmn:incoming>SequenceFlow_19</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>

  <!-- Grid Operator Process -->
  <bpmn:process id="Process_GridOperator" name="Grid Operator">
    
    <bpmn:startEvent id="Start_ConcurrenceRequest" name="Receive Concurrence Request">
      <bpmn:outgoing>SequenceFlow_21</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Supplier Concurrence Check -->
    <bpmn:task id="Task_CheckConcurrence" name="Check for Supplier Concurrence">
      <bpmn:incoming>SequenceFlow_21</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_22</bpmn:outgoing>
    </bpmn:task>

    <!-- Decision Point -->
    <bpmn:exclusiveGateway id="Gateway_ConcurrenceResult" name="Supplier Concurrence?">
      <bpmn:incoming>SequenceFlow_22</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_23</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_24</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Concurrence Path -->
    <bpmn:task id="Task_InformSuppliers" name="Inform All Involved Suppliers">
      <bpmn:incoming>SequenceFlow_23</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_25</bpmn:outgoing>
    </bpmn:task>

    <!-- Termination Path -->
    <bpmn:intermediateThrowEvent id="IntermediateMessage_Terminate" name="Terminate Sales Agreement">
      <bpmn:incoming>SequenceFlow_24</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_18</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

  </bpmn:process>

  <!-- Old Supplier Process -->
  <bpmn:process id="Process_OldSupplier" name="Old Supplier">
    
    <bpmn:startEvent id="Start_TerminationRequest" name="Receive Termination Request">
      <bpmn:outgoing>SequenceFlow_27</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Final Billing -->
    <bpmn:endEvent id="End_OldSupplierComplete" name="Process Ends">
      <bpmn:incoming>SequenceFlow_19</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>

  <!-- Message Flows -->
  <bpmn:message id="Message_Confirmation" name="Switch-over Confirmation"/>
  <bpmn:message id="Message_CISCheckRequest" name="Contract Verification Request"/>
  <bpmn:message id="Message_CISResult" name="Verification Result"/>
  <bpmn:message id="Message_ConcurrenceRequest" name="Concurrence Check Request"/>
  <bpmn:message id="Message_ConcurrenceResponse" name="Supplier Concurrence Response"/>

  <!-- Message Flow Connections -->
  <bpmn:messageFlow id="MF_ConfirmationSend">
    <bpmn:sourceRef>IntermediateMessage_Confirmation</bpmn:sourceRef>
    <bpmn:targetRef>Participant_NewSupplier</bpmn:targetRef>
  </bpmn:messageFlow>

  <bpmn:messageFlow id="MF_CISCheck">
    <bpmn:sourceRef>Task_PrepareContracts</bpmn:sourceRef>
    <bpmn:targetRef>IntermediateMessage_Confirmation</bpmn:targetRef>
  </bpmn:messageFlow>

  <bpmn:messageFlow id="MF_CISResult">
    <bpmn:sourceRef>Participant_NewSupplier</bpmn:sourceRef>
    <bpmn:targetRef>Gateway_CISResult</bpmn:targetRef>
  </bpmn:messageFlow>

  <bpmn:messageFlow id="MF_ConcurrenceRequest">
    <bpmn:sourceRef>Task_RequestGridOperator</bpmn:sourceRef>
    <bpmn:targetRef>Start_ConcurrenceRequest</bpmn:targetRef>
  </bpmn:messageFlow>

  <!-- Sequence Flows -->
  
  <!-- Customer Service Process Flow -->
  <bpmn:sequenceFlow id="SequenceFlow_01" sourceRef="Start_SwitchRequest" targetRef="Task_EnterDataCRM"/>
  <bpmn:sequenceFlow id="SequenceFlow_02" sourceRef="Task_CorrectErrors" targetRef="Gateway_DataValidation">
    <bpmn:description>Not Complete/Plausible</bpmn:description>
  </bpmn:sequenceFlow>
  <bpmn:sequenceFlow id="SequenceFlow_03" sourceRef="Gateway_DataValidation" targetRef="Task_CorrectErrors"/>
  <bpmn:sequenceFlow id="SequenceFlow_04" sourceRef="Gateway_CustomerExists" targetRef="Task_PrepareContracts">
    <bpmn:description>Complete &amp; Plausible</bpmn:description>
  </bpmn:sequenceFlow>
  <bpmn:sequenceFlow id="SequenceFlow_05" sourceRef="Gateway_DataValidation" targetRef="Gateway_CustomerExists"/>
  <bpmn:sequenceFlow id="SequenceFlow_06" sourceRef="Task_CreateCustomerObject" targetRef="Gateway_CustomerExists">
    <bpmn:description>Not in Database</bpmn:description>
  </bpmn:sequenceFlow>

  <!-- Contract Verification Loop -->
  <bpmn:sequenceFlow id="SequenceFlow_07" sourceRef="Task_PrepareContracts" targetRef="IntermediateMessage_CISCheck"/>
  <bpmn:sequenceFlow id="SequenceFlow_08" sourceRef="Gateway_CISResult" targetRef="Task_AnalyzeContractIssues">
    <bpmn:description>Negative Response</bpmn:description>
  </bpmn:sequenceFlow>

  <!-- Contract Success Path -->
  <bpmn:sequenceFlow id="SequenceFlow_09" sourceRef="Gateway_CISResult" targetRef="IntermediateMessage_Confirmation">
    <bpmn:description>Positive Response</bpmn:description>
  </bpmn:sequenceFlow>

  <!-- Contract Error Handling Loop -->
  <bpmn:sequenceFlow id="SequenceFlow_13" sourceRef="Task_AnalyzeContractIssues" targetRef="Gateway_CISResult"/>

  <!-- Customer Decision Path -->
  <bpmn:sequenceFlow id="SequenceFlow_14" sourceRef="IntermediateMessage_Confirmation" targetRef="Gateway_CustomerDecision">
    <bpmn:description>Customer Confirms</bpmn:description>
  </bpmn:sequenceFlow>

  <!-- Withdrawal Path -->
  <bpmn:sequenceFlow id="SequenceFlow_16" sourceRef="Gateway_CustomerDecision" targetRef="End_CustomerWithdraws">
    <bpmn:description>Customer Withdraws</bpmn:description>
  </bpmn:sequenceFlow>

  <!-- Continue Path -->
  <bpmn:sequenceFlow id="SequenceFlow_17" sourceRef="Gateway_CustomerDecision" targetRef="Task_RequestGridOperator">
    <bpmn:description>Customer Confirms</bpmn:description>
  </bpmn:sequenceFlow>

  <!-- Timer Path -->
  <bpmn:sequenceFlow id="SequenceFlow_20" sourceRef="IntermediateTimer_Acceptance" targetRef="Task_RequestGridOperator"/>

  <!-- Grid Operator Process Flows -->
  <bpmn:sequenceFlow id="SequenceFlow_18" sourceRef="Gateway_ConcurrenceResult" targetRef="IntermediateMessage_Terminate">
    <bpmn:description>Concurrence Response</bpmn:description>
  </bpmn:sequenceFlow>

  <!-- Grid Operator Process Flows -->
  <bpmn:sequenceFlow id="SequenceFlow_21" sourceRef="Start_ConcurrenceRequest" targetRef="Task_CheckConcurrence"/>
  <bpmn:sequenceFlow id="SequenceFlow_22" sourceRef="Task_CheckConcurrence" targetRef="Gateway_ConcurrenceResult"/>

  <!-- Concurrence Path -->
  <bpmn:sequenceFlow id="SequenceFlow_23" sourceRef="Gateway_ConcurrenceResult" targetRef="Task_InformSuppliers">
    <bpmn:description>Supplier Concurrence</bpmn:description>
  </bpmn:sequenceFlow>

  <!-- Termination Path -->
  <bpmn:sequenceFlow id="SequenceFlow_24" sourceRef="Gateway_ConcurrenceResult" targetRef="IntermediateMessage_Terminate">
    <bpmn:description>No Concurrence</bpmn:description>
  </bpmn:sequenceFlow>

  <!-- Response Path -->
  <bpmn:sequenceFlow id="SequenceFlow_25" sourceRef="Task_InformSuppliers" targetRef="IntermediateMessage_Terminate"/>

  <!-- Old Supplier Process Flows -->
  <bpmn:sequenceFlow id="SequenceFlow_19" sourceRef="Start_TerminationRequest" targetRef="End_OldSupplierComplete">
    <bpmn:description>Process Complete</bpmn:description>
  </bpmn:sequenceFlow>

</bpmn:definitions>