<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_ServiceResolution_1">
  <bpmn:collaboration id="Collaboration_TELECO_Ops">
    <bpmn:participant id="Participant_TELECO" name="TELECO Operations" processRef="Process_Main"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Main" isExecutable="true">
    
    <!-- Lane Set -->
    <bpmn:laneSet id="LaneSet_01">
      <bpmn:lane id="Lane_CustomerService" name="Customer Service"/>
      <bpmn:lane id="Lane_ServiceManagement" name="Service Management"/>
      <bpmn:lane id="Lane_ResourceProvisioning" name="Resource Provisioning"/>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_DegradationDetected">
      <bpmn:name>Service Degradation Detected</bpmn:name>
      <bpmn:outgoing>SequenceFlow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Customer Service Lane Tasks -->
    <bpmn:task id="Task_EnterProblemReport">
      <bpmn:name>Enter Problem Report into System T</bpmn:name>
      <bpmn:incoming>SequenceFlow_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_02</bpmn:outgoing>
    </bpmn:task>

    <!-- Decision Logic for Significance -->
    <bpmn:exclusiveGateway id="Gateway_SignificanceCheck">
      <bpmn:name>Customer Premium?</bpmn:name>
      <bpmn:incoming>SequenceFlow_02</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_03</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_04</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Premium Customer Extra Process Link -->
    <bpmn:endEvent id="EndEvent_PremiumProcess">
      <bpmn:name>Premium Service Fix (External)</bpmn:name>
      <bpmn:incoming>SequenceFlow_03</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Determine Measures Task -->
    <bpmn:task id="Task_DetermineMeasures">
      <bpmn:name>Determine Counter Measures &amp; Priorities</bpmn:name>
      <bpmn:incoming>SequenceFlow_04</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_05</bpmn:outgoing>
    </bpmn:task>

    <!-- Reprioritize Check Gateway -->
    <bpmn:exclusiveGateway id="Gateway_MeasureReprioritize">
      <bpmn:name>Affects Measures?</bpmn:name>
      <bpmn:incoming>SequenceFlow_05</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_06</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_07</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Loop back to Determine Measures -->
    <bpmn:sequenceFlow id="SequenceFlow_06" sourceRef="Gateway_MeasureReprioritize" targetRef="Task_DetermineMeasures">
      <bpmn:name>Yes - Reprioritize</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Continue to Detailed Report -->
    <bpmn:task id="Task_CreateDetailedReport">
      <bpmn:name>Create Detailed Problem Report</bpmn:name>
      <bpmn:incoming>SequenceFlow_07</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_08</bpmn:outgoing>
    </bpmn:task>

    <!-- Service Management Lane Tasks -->
    <bpmn:exclusiveGateway id="Gateway_AnalyzableCheck">
      <bpmn:name>Analyzable at SM Level?</bpmn:name>
      <bpmn:incoming>SequenceFlow_08</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_09</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Send to Resource Provisioning -->
    <bpmn:task id="Task_SendToRP">
      <bpmn:name>Send Report to RP</bpmn:name>
      <bpmn:incoming>SequenceFlow_10</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_11</bpmn:outgoing>
    </bpmn:task>

    <!-- SM Analysis Path -->
    <bpmn:task id="Task_PerformAnalysis">
      <bpmn:name>Analyze Problem at SM Level</bpmn:name>
      <bpmn:incoming>SequenceFlow_09</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_12</bpmn:outgoing>
    </bpmn:task>

    <!-- Resource Provisioning Lane Tasks -->
    <bpmn:exclusiveGateway id="Gateway_ProblemDetectedCheck">
      <bpmn:name>Problem Detected?</bpmn:name>
      <bpmn:incoming>SequenceFlow_13</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_14</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Normal Execution Notification -->
    <bpmn:endEvent id="EndEvent_NormalExecution">
      <bpmn:name>Normal Service Executed</bpmn:name>
      <bpmn:incoming>SequenceFlow_15</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Analyze RP Problem -->
    <bpmn:task id="Task_AnalyzeRPProblem">
      <bpmn:name>Analyze Possible Problems at RP</bpmn:name>
      <bpmn:incoming>SequenceFlow_13</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_16</bpmn:outgoing>
    </bpmn:task>

    <!-- Create Trouble Report RP -->
    <bpmn:task id="Task_CreateTroubleReportRP">
      <bpmn:name>Create Trouble Report (RP)</bpmn:name>
      <bpmn:incoming>SequenceFlow_16</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_17</bpmn:outgoing>
    </bpmn:task>

    <!-- Restoration Request Timer -->
    <bpmn:intermediateCatchEvent id="Timer_RestorationRequest">
      <bpmn:name>2 Days Timeout</bpmn:name>
      <bpmn:incoming>SequenceFlow_18</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_19</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Restoration Request Received -->
    <bpmn:endEvent id="EndEvent_RestorationTimeout">
      <bpmn:name>Restoration Timeout Ended</bpmn:name>
      <bpmn:incoming>SequenceFlow_19</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Prepare Final Report Gateway -->
    <bpmn:exclusiveGateway id="Gateway_PrepareFinalReport">
      <bpmn:name>Merge Paths for Final Report</bpmn:name>
      <bpmn:incoming>SequenceFlow_12</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_17</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_20</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Counter Measure Type Gateway -->
    <bpmn:exclusiveGateway id="Gateway_CounterMeasureType">
      <bpmn:name>Determine Action Required?</bpmn:name>
      <bpmn:incoming>SequenceFlow_20</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_21</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_22</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_23</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- No Problem Path -->
    <bpmn:endEvent id="EndEvent_NoProblem">
      <bpmn:name>No Problem Detected</bpmn:name>
      <bpmn:incoming>SequenceFlow_21</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Minor Corrective Actions -->
    <bpmn:task id="Task_MinorCorrectiveActions">
      <bpmn:name>Undertake Minor Corrective Actions (SM)</bpmn:name>
      <bpmn:incoming>SequenceFlow_22</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_24</bpmn:outgoing>
    </bpmn:task>

    <!-- Automatic Restoration Request -->
    <bpmn:task id="Task_CreateRestorationRequest">
      <bpmn:name>Create Resource Restoration Request</bpmn:name>
      <bpmn:incoming>SequenceFlow_23</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_18</bpmn:outgoing>
    </bpmn:task>

    <!-- Create Resolution Report -->
    <bpmn:endEvent id="EndEvent_MinorActions">
      <bpmn:name>Minor Actions Complete</bpmn:name>
      <bpmn:incoming>SequenceFlow_24</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Trouble Shooting Report -->
    <bpmn:task id="Task_CreateTroubleShootingReport">
      <bpmn:name>Create Trouble-Shooting Report (RP)</bpmn:name>
      <bpmn:incoming>SequenceFlow_25</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_26</bpmn:outgoing>
    </bpmn:task>

    <!-- Final Status Report Preparation -->
    <bpmn:endEvent id="EndEvent_FinalReport">
      <bpmn:name>Final Report Complete</bpmn:name>
      <bpmn:incoming>SequenceFlow_26</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    
    <bpmn:sequenceFlow id="SequenceFlow_01" sourceRef="StartEvent_DegradationDetected" targetRef="Task_EnterProblemReport"/>
    <bpmn:sequenceFlow id="SequenceFlow_02" sourceRef="Task_EnterProblemReport" targetRef="Gateway_SignificanceCheck"/>
    <bpmn:sequenceFlow id="SequenceFlow_03" sourceRef="Gateway_SignificanceCheck" targetRef="EndEvent_PremiumProcess">
      <bpmn:name>Premium Customer</bpmn:name>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_04" sourceRef="Gateway_SignificanceCheck" targetRef="Task_DetermineMeasures"/>
    <bpmn:sequenceFlow id="SequenceFlow_05" sourceRef="Task_DetermineMeasures" targetRef="Gateway_MeasureReprioritize"/>
    <bpmn:sequenceFlow id="SequenceFlow_07" sourceRef="Gateway_MeasureReprioritize" targetRef="Task_CreateDetailedReport">
      <bpmn:name>No - Continue</bpmn:name>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_08" sourceRef="Task_CreateDetailedReport" targetRef="Gateway_AnalyzableCheck"/>
    <bpmn:sequenceFlow id="SequenceFlow_09" sourceRef="Gateway_AnalyzableCheck" targetRef="Task_PerformAnalysis">
      <bpmn:name>Yes - Analyze at SM</bpmn:name>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="Gateway_AnalyzableCheck" targetRef="Task_SendToRP">
      <bpmn:name>No - Send to RP</bpmn:name>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_13" sourceRef="Task_SendToRP" targetRef="Gateway_ProblemDetectedCheck"/>
    <bpmn:sequenceFlow id="SequenceFlow_14" sourceRef="Gateway_ProblemDetectedCheck" targetRef="Task_AnalyzeRPProblem">
      <bpmn:name>Yes - Problem Detected</bpmn:name>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_15" sourceRef="Gateway_ProblemDetectedCheck" targetRef="EndEvent_NormalExecution">
      <bpmn:name>No - Normal Execution</bpmn:name>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_16" sourceRef="Task_AnalyzeRPProblem" targetRef="Gateway_ProblemDetectedCheck"/>
    <bpmn:sequenceFlow id="SequenceFlow_17" sourceRef="Task_CreateTroubleReportRP" targetRef="Gateway_PrepareFinalReport">
      <bpmn:name>Return to SM</bpmn:name>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_20" sourceRef="Gateway_PrepareFinalReport" targetRef="Gateway_CounterMeasureType"/>
    <bpmn:sequenceFlow id="SequenceFlow_21" sourceRef="Gateway_CounterMeasureType" targetRef="EndEvent_NoProblem">
      <bpmn:name>No Problem</bpmn:name>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_22" sourceRef="Gateway_CounterMeasureType" targetRef="Task_MinorCorrectiveActions">
      <bpmn:name>Minor Actions Required</bpmn:name>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_23" sourceRef="Gateway_CounterMeasureType" targetRef="Task_CreateRestorationRequest">
      <bpmn:name>Automatic Restoration Required</bpmn:name>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_18" sourceRef="Task_CreateRestorationRequest" targetRef="Timer_RestorationRequest"/>
    <bpmn:sequenceFlow id="SequenceFlow_25" sourceRef="Gateway_ProblemDetectedCheck" targetRef="Task_AnalyzeRPProblem">
      <bpmn:name>After Restoration Request</bpmn:name>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_19" sourceRef="Timer_RestorationRequest" targetRef="EndEvent_RestorationTimeout"/>
    <bpmn:sequenceFlow id="SequenceFlow_24" sourceRef="Task_MinorCorrectiveActions" targetRef="EndEvent_MinorActions">
      <bpmn:name>Resolution Report Created</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>