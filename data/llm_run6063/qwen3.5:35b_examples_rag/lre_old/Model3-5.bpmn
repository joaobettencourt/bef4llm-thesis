<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_MailProcessing_1">
  <bpmn:collaboration id="Collaboration_MailProcess">
    <bpmn:participant id="Participant_RetailerOperations" name="Registry Mail Processing Unit"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_MailProcessing_1" isExecutable="true">
    
    <bpmn:laneSet id="LaneSet_MailProcessing">
      <bpmn:lane id="Lane_MailClerk">
        <bpmn:name>Mail Clerk</bpmn:name>
        <bpmn:flowNodeRef>Task_SortUnopenedMail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Registry">
        <bpmn:name>Registry Clerk</bpmn:name>
        <bpmn:flowNodeRef>Task_OpenAndSortMail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegisterIncomingMail</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_AssistantManager">
        <bpmn:name>Assistant Registry Manager</bpmn:name>
        <bpmn:flowNodeRef>Task_QualityCheckMail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ComplianceDecision</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Cashier">
        <bpmn:name>Cashier</bpmn:name>
        <bpmn:flowNodeRef>Task_ProcessFees</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TaskCapturePartyDetails</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Receive Mail">
      <bpmn:outgoing>SequenceFlow_CollectMail</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 2: Sort Unopened Mail (Mail Clerk) -->
    <bpmn:task id="Task_SortUnopenedMail" name="Sort Unopened Mail">
      <bpmn:incoming>SequenceFlow_CollectMail</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DistributeToRegistry</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3: Open and Sort (Registry Clerk) -->
    <bpmn:task id="Task_OpenAndSortMail" name="Open and Sort Mail">
      <bpmn:incoming>SequenceFlow_DistributeToRegistry</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RegisterIncoming</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 4: Register Incoming (Registry Clerk) -->
    <bpmn:task id="Task_RegisterIncomingMail" name="Register in Mail Register">
      <bpmn:incoming>SequenceFlow_RegisterIncoming</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_QualityCheckStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 5: Quality Check (Assistant Manager) -->
    <bpmn:task id="Task_QualityCheckMail" name="Quality Check Mail">
      <bpmn:incoming>SequenceFlow_QualityCheckStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ComplianceDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Compliance Decision -->
    <bpmn:exclusiveGateway id="Gateway_ComplianceDecision" name="Mail Compliant?">
      <bpmn:incoming>SequenceFlow_ComplianceDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RejectionPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ApprovalPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 6: Rejection Path - Compile List -->
    <bpmn:task id="Task_CompileRequisitionList" name="Compile Requisition List">
      <bpmn:incoming>SequenceFlow_RejectionPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendBackToParty</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 7: Send Back to Party -->
    <bpmn:task id="Task_SendRequisitionBack" name="Send Rejection List">
      <bpmn:incoming>SequenceFlow_SendBackToParty</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndRejected</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 8: Capture Matter Details (Assistant Manager) -->
    <bpmn:task id="Task_CaptureMatterDetails" name="Capture Matter Details">
      <bpmn:incoming>SequenceFlow_ApprovalPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProvideToCashier</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 9: Process Fees (Cashier) -->
    <bpmn:task id="Task_ProcessFees" name="Process Applicable Fees">
      <bpmn:incoming>SequenceFlow_ProvideToCashier</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CashierDetailsPath</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 10: Capture Party Details (Cashier) -->
    <bpmn:task id="TaskCapturePartyDetails" name="Capture Party Details">
      <bpmn:incoming>SequenceFlow_CashierDetailsPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PrintFile</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 11: Print Physical Court File (Cashier) -->
    <bpmn:task id="TaskPrintPhysicalCourtFile" name="Print Physical Court File">
      <bpmn:incoming>SequenceFlow_PrintFile</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergePaths</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 12: Post Documents (Assistant Manager) -->
    <bpmn:task id="Task_PostDocuments" name="Post Receipt and Copies">
      <bpmn:incoming>SequenceFlow_AssistantManagerPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergePaths</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway: Merge Paths -->
    <bpmn:parallelGateway id="Gateway_MergePaths" name="Merge Processing">
      <bpmn:incoming>SequenceFlow_PrintFile</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_AssistantManagerPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndProcess</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- End Events -->
    <bpmn:endEvent id="End_Rejected" name="Mail Rejected">
      <bpmn:incoming>SequenceFlow_EndRejected</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="End_ProcessComplete" name="Processing Complete">
      <bpmn:incoming>SequenceFlow_EndProcess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    
    <bpmn:sequenceFlow id="SequenceFlow_CollectMail" sourceRef="StartEvent_1" targetRef="Task_SortUnopenedMail">
      <bpmn:description>Daily collection completed</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_DistributeToRegistry" sourceRef="Task_SortUnopenedMail" targetRef="Task_OpenAndSortMail">
      <bpmn:description>Mailed sorted to business areas</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_RegisterIncoming" sourceRef="Task_OpenAndSortMail" targetRef="Task_RegisterIncomingMail">
      <bpmn:description>Mailed opened and sorted into groups</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_QualityCheckStart" sourceRef="Task_RegisterIncomingMail" targetRef="Task_QualityCheckMail">
      <bpmn:description>Mailed registered in Mail Register</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ComplianceDecision" sourceRef="Task_QualityCheckMail" targetRef="Gateway_ComplianceDecision">
      <bpmn:description>Mailed ready for quality check</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Rejection Path -->
    <bpmn:sequenceFlow id="SequenceFlow_RejectionPath" sourceRef="Gateway_ComplianceDecision" targetRef="Task_CompileRequisitionList">
      <bpmn:description>Mailed not compliant</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_SendBackToParty" sourceRef="Task_CompileRequisitionList" targetRef="Task_SendRequisitionBack">
      <bpmn:description>List compiled with rejection reasons</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Approval Path -->
    <bpmn:sequenceFlow id="SequenceFlow_ApprovalPath" sourceRef="Gateway_ComplianceDecision" targetRef="Task_CaptureMatterDetails">
      <bpmn:description>Mailed compliant - proceed</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Cashier Path -->
    <bpmn:sequenceFlow id="SequenceFlow_ProvideToCashier" sourceRef="Task_CaptureMatterDetails" targetRef="Task_ProcessFees">
      <bpmn:description>Mailed details provided to cashier</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Parallel Processing -->
    <bpmn:parallelGateway id="Gateway_SplitPaths" name="Split Paths">
      <bpmn:incoming>SequenceFlow_ProvideToCashier</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CashierDetailsPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_AssistantManagerPath</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:sequenceFlow id="SequenceFlow_CashierDetailsPath" sourceRef="Gateway_SplitPaths" targetRef="TaskCapturePartyDetails">
      <bpmn:description>Capture party details and print file</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_AssistantManagerPath" sourceRef="Gateway_SplitPaths" targetRef="Task_PostDocuments">
      <bpmn:description>Post receipt and copies to party</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- End Events -->
    <bpmn:sequenceFlow id="SequenceFlow_EndRejected" sourceRef="Task_SendRequisitionBack" targetRef="End_Rejected">
      <bpmn:description>Mailed rejected process complete</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_PrintFile" sourceRef="TaskCapturePartyDetails" targetRef="TaskPrintPhysicalCourtFile">
      <bpmn:description>Capture party details completed</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_MergePaths" sourceRef="TaskPrintPhysicalCourtFile" targetRef="Gateway_MergePaths">
      <bpmn:description>Mailed file printed, merge with posting</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_EndProcess" sourceRef="Gateway_MergePaths" targetRef="End_ProcessComplete">
      <bpmn:description>All processing complete</bpmn:description>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>