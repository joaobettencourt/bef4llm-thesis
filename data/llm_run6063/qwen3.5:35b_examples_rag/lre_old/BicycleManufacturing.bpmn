<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_BicycleManufacturing_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_BicycleProcess">
    <bpmn:participant id="Participant_Company" name="Bicycle Manufacturing Company"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_CustomizedBikeOrder" isExecutable="true">
    
    <bpmn:laneSet id="LaneSet_BicycleManufacturing">
      <bpmn:lane id="Lane_SalesDepartment">
        <bpmn:name>Sales Department</bpmn:name>
        <bpmn:flowNodeRef>StartEvent_OrderReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_AcceptRejectOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_ReviewRequired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_OrderRejected</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Storehouse">
        <bpmn:name>Storehouse</bpmn:name>
        <bpmn:flowNodeRef>UserTask_CheckPartAvailability</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_PartAvailable</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Engineering">
        <bpmn:name>Engineering Department</bpmn:name>
        <bpmn:flowNodeRef>UserTask_PrepareAssembly</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_MergePaths</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Manufacturing">
        <bpmn:name>Manufacturing Department</bpmn:name>
        <bpmn:flowNodeRef>UserTask_AssembleBicycle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ProcessComplete</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_OrderReceived" name="Order Received">
      <bpmn:outgoing>SequenceFlow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Accept/Reject Order Decision -->
    <bpmn:userTask id="UserTask_AcceptRejectOrder" name="Accept or Reject Order">
      <bpmn:incoming>SequenceFlow_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_02</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway 1: Accept/Reject Decision -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_ReviewRequired" name="Accept Order?">
      <bpmn:incoming>SequenceFlow_02</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_03</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_04</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event 1: Order Rejected -->
    <bpmn:endEvent id="EndEvent_OrderRejected" name="Order Cancelled">
      <bpmn:incoming>SequenceFlow_03</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Gateway 2: Parallel Split for Storehouse & Engineering -->
    <bpmn:parallelGateway id="ParallelGateway_SplitPaths" name="Inform Departments">
      <bpmn:incoming>SequenceFlow_04</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_05</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_06</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Storehouse Task -->
    <bpmn:userTask id="UserTask_CheckPartAvailability" name="Check Part Availability">
      <bpmn:incoming>SequenceFlow_05</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_07</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway 3: Check if Part Available -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_PartAvailable" name="Part In Stock?">
      <bpmn:incoming>SequenceFlow_07</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_08</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_09</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 4a: Reserve Part -->
    <bpmn:userTask id="UserTask_ReservePart" name="Reserve Part">
      <bpmn:incoming>SequenceFlow_08</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task 4b: Back-order Part -->
    <bpmn:userTask id="UserTask_BackOrderPart" name="Back-order Part">
      <bpmn:incoming>SequenceFlow_09</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway 4: Merge Storehouse Paths -->
    <bpmn:parallelGateway id="ParallelGateway_StorehouseComplete" name="All Parts Processed">
      <bpmn:incoming>SequenceFlow_10</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_11</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Engineering Task -->
    <bpmn:userTask id="UserTask_PrepareAssembly" name="Prepare Assembly">
      <bpmn:incoming>SequenceFlow_06</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_12</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway 5: Merge Storehouse & Engineering -->
    <bpmn:parallelGateway id="ParallelGateway_MergePaths" name="Merge Paths">
      <bpmn:incoming>SequenceFlow_11</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_12</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_13</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 5: Assemble Bicycle -->
    <bpmn:userTask id="UserTask_AssembleBicycle" name="Assemble Bicycle">
      <bpmn:incoming>SequenceFlow_13</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_14</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event 2: Process Complete -->
    <bpmn:endEvent id="EndEvent_ProcessComplete" name="Process Finished">
      <bpmn:incoming>SequenceFlow_15</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    
    <bpmn:sequenceFlow id="SequenceFlow_01" sourceRef="StartEvent_OrderReceived" targetRef="UserTask_AcceptRejectOrder">
      <bpmn:name>Receive Order</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_02" sourceRef="UserTask_AcceptRejectOrder" targetRef="ExclusiveGateway_ReviewRequired"/>

    <bpmn:sequenceFlow id="SequenceFlow_03" name="No - Reject Order" sourceRef="ExclusiveGateway_ReviewRequired" targetRef="EndEvent_OrderRejected">
      <bpmn:name>Reject</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_04" name="Yes - Accept Order" sourceRef="ExclusiveGateway_ReviewRequired" targetRef="ParallelGateway_SplitPaths">
      <bpmn:name>Accept</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_05" name="Inform Storehouse" sourceRef="ParallelGateway_SplitPaths" targetRef="UserTask_CheckPartAvailability"/>

    <bpmn:sequenceFlow id="SequenceFlow_06" name="Inform Engineering" sourceRef="ParallelGateway_SplitPaths" targetRef="UserTask_PrepareAssembly"/>

    <bpmn:sequenceFlow id="SequenceFlow_07" sourceRef="UserTask_CheckPartAvailability" targetRef="ExclusiveGateway_PartAvailable">
      <bpmn:name>Check Availability</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_08" name="Yes - Available" sourceRef="ExclusiveGateway_PartAvailable" targetRef="UserTask_ReservePart"/>

    <bpmn:sequenceFlow id="SequenceFlow_09" name="No - Not Available" sourceRef="ExclusiveGateway_PartAvailable" targetRef="UserTask_BackOrderPart"/>

    <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="UserTask_ReservePart" targetRef="ParallelGateway_StorehouseComplete">
      <bpmn:name>Reserve Complete</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_11" name="All Parts Processed" sourceRef="UserTask_BackOrderPart" targetRef="ParallelGateway_StorehouseComplete"/>

    <bpmn:sequenceFlow id="SequenceFlow_12" sourceRef="UserTask_PrepareAssembly" targetRef="ParallelGateway_MergePaths">
      <bpmn:name>Preparation Complete</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_13" name="Ready to Assemble" sourceRef="ParallelGateway_MergePaths" targetRef="UserTask_AssembleBicycle"/>

    <bpmn:sequenceFlow id="SequenceFlow_14" sourceRef="UserTask_AssembleBicycle" targetRef="EndEvent_ProcessComplete">
      <bpmn:name>Assembled</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>