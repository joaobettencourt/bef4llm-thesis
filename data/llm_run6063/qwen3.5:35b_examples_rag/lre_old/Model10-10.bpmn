<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_FaultRepair_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_FaultProcess">
    <bpmn:participant id="Participant_Technician" name="Fault Repair Process"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_FaultRepair_1" isExecutable="true">
    
    <!-- Lane for the User/Technician -->
    <bpmn:laneSet id="LaneSet_Technician">
      <bpmn:lane id="Lane_User" name="User / Technician">
        <bpmn:name>User</bpmn:name>
        <bpmn:flowNodeRef>StartEvent_FaultDetected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExamineFailure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ConfirmFault</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_InformStakeholders</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformCustomerInitial</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformManagerInitial</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MergeInform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FixFault</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ShareResultsDetector</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ResolveNotify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyResolutionCustomer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyResolutionManager</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MergeResolve</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_FaultDetected" name="Failure Reported">
      <bpmn:outgoing>SequenceFlow_Examine</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1 -->
    <bpmn:task id="Task_ExamineFailure" name="Examine Failure">
      <bpmn:incoming>SequenceFlow_Examine</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Decision</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1 -->
    <bpmn:exclusiveGateway id="Gateway_ConfirmFault" name="Confirm Fault?">
      <bpmn:incoming>SequenceFlow_Decision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Reject</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_Confirm</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event 1 (Reject) -->
    <bpmn:endEvent id="EndEvent_Rejected" name="Fault Rejected">
      <bpmn:incoming>SequenceFlow_Reject</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Gateway 2 (Parallel Split for Initial Notification) -->
    <bpmn:parallelGateway id="Gateway_InformStakeholders" name="Notify Stakeholders">
      <bpmn:incoming>SequenceFlow_Confirm</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NotifyCustInit</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NotifyMgrInit</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 2 -->
    <bpmn:task id="Task_InformCustomerInitial" name="Inform Customer">
      <bpmn:incoming>SequenceFlow_NotifyCustInit</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeNotify1</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3 -->
    <bpmn:task id="Task_InformManagerInitial" name="Inform Manager">
      <bpmn:incoming>SequenceFlow_NotifyMgrInit</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeNotify2</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 3 (Merge) -->
    <bpmn:parallelGateway id="Gateway_MergeInform" name="Merge Notify">
      <bpmn:incoming>SequenceFlow_MergeNotify1</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_MergeNotify2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FixFaultStart</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 4 -->
    <bpmn:task id="Task_FixFault" name="Fix Fault at Measuring Device">
      <bpmn:incoming>SequenceFlow_FixFaultStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ShareResults</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 5 -->
    <bpmn:task id="Task_ShareResultsDetector" name="Share Results with Detector">
      <bpmn:incoming>SequenceFlow_ShareResults</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ResolveSplit</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 4 (Parallel Split for Resolution Notification) -->
    <bpmn:parallelGateway id="Gateway_ResolveNotify" name="Notify Resolution">
      <bpmn:incoming>SequenceFlow_ResolveSplit</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NotifyResCust</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NotifyResMgr</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 6 -->
    <bpmn:task id="Task_NotifyResolutionCustomer" name="Inform Customer Resolution">
      <bpmn:incoming>SequenceFlow_NotifyResCust</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeResolve1</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 7 -->
    <bpmn:task id="Task_NotifyResolutionManager" name="Inform Manager Resolution">
      <bpmn:incoming>SequenceFlow_NotifyResMgr</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeResolve2</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 5 (Merge) -->
    <bpmn:parallelGateway id="Gateway_MergeResolve" name="End Process">
      <bpmn:incoming>SequenceFlow_MergeResolve1</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_MergeResolve2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Complete</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- End Event 2 (Success) -->
    <bpmn:endEvent id="EndEvent_Completed" name="Interference Resolved">
      <bpmn:incoming>SequenceFlow_Complete</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    
    <bpmn:sequenceFlow id="SequenceFlow_Examine" sourceRef="StartEvent_FaultDetected" targetRef="Task_ExamineFailure"/>

    <bpmn:sequenceFlow id="SequenceFlow_Decision" name="" sourceRef="Task_ExamineFailure" targetRef="Gateway_ConfirmFault"/>

    <bpmn:sequenceFlow id="SequenceFlow_Reject" name="Reject" sourceRef="Gateway_ConfirmFault" targetRef="EndEvent_Rejected"/>

    <bpmn:sequenceFlow id="SequenceFlow_Confirm" name="Confirm" sourceRef="Gateway_ConfirmFault" targetRef="Gateway_InformStakeholders"/>

    <bpmn:sequenceFlow id="SequenceFlow_NotifyCustInit" sourceRef="Gateway_InformStakeholders" targetRef="Task_InformCustomerInitial"/>

    <bpmn:sequenceFlow id="SequenceFlow_NotifyMgrInit" sourceRef="Gateway_InformStakeholders" targetRef="Task_InformManagerInitial"/>

    <bpmn:sequenceFlow id="SequenceFlow_MergeNotify1" name="" sourceRef="Task_InformCustomerInitial" targetRef="Gateway_MergeInform"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_MergeNotify2" name="" sourceRef="Task_InformManagerInitial" targetRef="Gateway_MergeInform"/>

    <bpmn:sequenceFlow id="SequenceFlow_FixFaultStart" sourceRef="Gateway_MergeInform" targetRef="Task_FixFault"/>

    <bpmn:sequenceFlow id="SequenceFlow_ShareResults" name="" sourceRef="Task_FixFault" targetRef="Task_ShareResultsDetector"/>

    <bpmn:sequenceFlow id="SequenceFlow_ResolveSplit" sourceRef="Task_ShareResultsDetector" targetRef="Gateway_ResolveNotify"/>

    <bpmn:sequenceFlow id="SequenceFlow_NotifyResCust" name="" sourceRef="Gateway_ResolveNotify" targetRef="Task_NotifyResolutionCustomer"/>

    <bpmn:sequenceFlow id="SequenceFlow_NotifyResMgr" name="" sourceRef="Gateway_ResolveNotify" targetRef="Task_NotifyResolutionManager"/>

    <bpmn:sequenceFlow id="SequenceFlow_MergeResolve1" name="" sourceRef="Task_NotifyResolutionCustomer" targetRef="Gateway_MergeResolve"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_MergeResolve2" name="" sourceRef="Task_NotifyResolutionManager" targetRef="Gateway_MergeResolve"/>

    <bpmn:sequenceFlow id="SequenceFlow_Complete" name="" sourceRef="Gateway_MergeResolve" targetRef="EndEvent_Completed"/>

  </bpmn:process>
</bpmn:definitions>