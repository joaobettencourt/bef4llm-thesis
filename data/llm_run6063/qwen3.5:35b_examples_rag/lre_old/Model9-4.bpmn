<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_CommitteeProcess_1">
  <bpmn:collaboration id="Collaboration_CommitteeMeeting">
    <bpmn:participant id="Participant_CoordinationUnit" name="Coordination Unit"/>
    <bpmn:participant id="Participant_SupportOffice" name="Support Office/Officer"/>
  </bpmn:collaboration>

  <!-- Coordination Unit Process -->
  <bpmn:process id="Process_CoordinationUnit">
    <bpmn:startEvent id="Start_DatesFinalized" name="Dates Finalized">
      <bpmn:outgoing>SequenceFlow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task for Support Officer -->
    <bpmn:task id="Task_UpdateCalendarsFolders" name="Update Calendars &amp; Create Meeting Folders">
      <bpmn:incoming>SequenceFlow_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_02</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Message Event for notifying members -->
    <bpmn:intermediateThrowEvent id="IntermediateNotifyMembers" name="Advise Meeting Documents">
      <bpmn:incoming>SequenceFlow_02</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_03</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <!-- Task for QA Check -->
    <bpmn:task id="Task_QACheck" name="QA Minutes (5 working days)">
      <bpmn:incoming>SequenceFlow_07</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_08</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="End_ProcessComplete" name="Process Complete">
      <bpmn:incoming>SequenceFlow_09</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows for Coordination Unit Process -->
    <bpmn:sequenceFlow id="SequenceFlow_01" sourceRef="Start_DatesFinalized" targetRef="Task_UpdateCalendarsFolders"/>
    <bpmn:sequenceFlow id="SequenceFlow_02" sourceRef="Task_UpdateCalendarsFolders" targetRef="IntermediateNotifyMembers"/>
    <bpmn:sequenceFlow id="SequenceFlow_07" sourceRef="Start_MeetingHeld" targetRef="Task_QACheck"/>
    <bpmn:sequenceFlow id="SequenceFlow_08" sourceRef="Task_QACheck" targetRef="IntermediateSendMinutes"/>
    <bpmn:sequenceFlow id="SequenceFlow_09" sourceRef="IntermediateSendMinutes" targetRef="End_ProcessComplete"/>

  </bpmn:process>

  <!-- Support Office Process -->
  <bpmn:process id="Process_SupportOffice">
    <bpmn:startEvent id="Start_MeetingHeld" name="Meeting Held">
      <bpmn:outgoing>SequenceFlow_04</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task for Producing Minutes -->
    <bpmn:task id="Task_ProduceMinutes" name="Produce Meeting Minutes with Action Points">
      <bpmn:incoming>SequenceFlow_04</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_05</bpmn:outgoing>
    </bpmn:task>

    <!-- Task for Updating Records -->
    <bpmn:task id="Task_UpdateRecords" name="Update Departmental Records">
      <bpmn:incoming>SequenceFlow_10</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_11</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="End_SupportComplete" name="Records Updated">
      <bpmn:incoming>SequenceFlow_12</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows for Support Office Process -->
    <bpmn:sequenceFlow id="SequenceFlow_04" sourceRef="Start_MeetingHeld" targetRef="Task_ProduceMinutes"/>
    <bpmn:sequenceFlow id="SequenceFlow_05" sourceRef="Task_ProduceMinutes" targetRef="IntermediateSendMinutes"/>
    <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="IntermediateSendMinutes" targetRef="Task_UpdateRecords"/>
    <bpmn:sequenceFlow id="SequenceFlow_11" sourceRef="Task_UpdateRecords" targetRef="End_SupportComplete"/>

  </bpmn:process>

  <!-- Message Flows between participants -->
  <bpmn:messageFlow id="MessageFlow_AdviseMembers">
    <bpmn:name>Meeting Documents</bpmn:name>
    <bpmn:sourceRef>IntermediateNotifyMembers</bpmn:sourceRef>
    <bpmn:targetRef>Start_MeetingHeld</bpmn:targetRef>
  </bpmn:messageFlow>

  <bpmn:messageFlow id="MessageFlow_SendMinutes">
    <bpmn:name>Meeting Minutes</bpmn:name>
    <bpmn:sourceRef>IntermediateSendMinutes</bpmn:sourceRef>
    <bpmn:targetRef>Task_UpdateRecords</bpmn:targetRef>
  </bpmn:messageFlow>

  <!-- Intermediate Message Event for sending minutes -->
  <bpmn:intermediateThrowEvent id="IntermediateSendMinutes" name="Send Minutes to Members">
    <bpmn:incoming>SequenceFlow_08</bpmn:incoming>
    <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
  </bpmn:intermediateThrowEvent>

</bpmn:definitions>