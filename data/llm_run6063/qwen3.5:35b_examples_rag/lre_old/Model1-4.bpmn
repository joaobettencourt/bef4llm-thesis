<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_IPO_Process_01">
  <bpmn:collaboration id="Collab_IPO_Main">
    <bpmn:participant id="Participant_IPO_Operation" name="IPO Public Offering Process"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_IPO_01" isExecutable="true">
    
    <!-- Lane Set -->
    <bpmn:laneSet id="LaneSet_IPO_Main">
      <bpmn:lane id="Lane_Company_Decision">
        <bpmn:name>Company Decision</bpmn:name>
        <bpmn:flowNodeRef>StartEvent_01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectUnderwriters_02</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Underwriter_Ops">
        <bpmn:name>Underwriter Operations</bpmn:name>
        <bpmn:flowNodeRef>Task_ProvideAdvice_03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_FairnessCheck_04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SplitPrep_05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareRegStatement_06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CatchEvent_SECApproval_07</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RoadShowPriceFirming_08</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_JoinFixPrice_09</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FixIssuePrice_10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_FinalDecision_11</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_01" name="Company Decision to Go Public">
      <bpmn:outgoing>SequenceFlow_SelectUnderwriters</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 2: Select Underwriters -->
    <bpmn:task id="Task_SelectUnderwriters_02" name="Select Underwriters">
      <bpmn:incoming>SequenceFlow_SelectUnderwriters</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProvideAdvice</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3: Provide Advice & Check Facts -->
    <bpmn:task id="Task_ProvideAdvice_03" name="Provide Advice &amp; Check Fairness">
      <bpmn:incoming>SequenceFlow_ProvideAdvice</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FairnessCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 4: Is Facts Fair? -->
    <bpmn:exclusiveGateway id="Gateway_FairnessCheck_04" name="Facts Presented&#10;Fairly?">
      <bpmn:incoming>SequenceFlow_FairnessCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CancelledUnfair</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SplitPrep</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event 5: Cancelled (Reputation Risk) -->
    <bpmn:endEvent id="End_CancelledUnfair_05" name="Offer&#10;Cancelled">
      <bpmn:incoming>SequenceFlow_CancelledUnfair</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Gateway 6: Split for Registration & Roadshow -->
    <bpmn:parallelGateway id="Gateway_SplitPrep_05" name="Split&#10;Tasks">
      <bpmn:incoming>SequenceFlow_SplitPrep</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PrepareRegStatement</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RoadShowStart</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 7: Prepare Registration Statement -->
    <bpmn:task id="Task_PrepareRegStatement_06" name="Prepare Reg.&#10;Statement">
      <bpmn:incoming>SequenceFlow_PrepareRegStatement</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SubmitForApproval</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Catch Event 8: SEC Approval -->
    <bpmn:intermediateCatchEvent id="CatchEvent_SECApproval_07" name="SEC Clearance&#10;Received">
      <bpmn:messageEventDefinition />
      <bpmn:incoming>SequenceFlow_SubmitForApproval</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SECApprovalReceived</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task 9: Road Show / Firm Price -->
    <bpmn:task id="Task_RoadShow_08" name="Road Show&#10;Firm Up Price">
      <bpmn:incoming>SequenceFlow_RoadShowStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RoadShowComplete</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 10: Join before Fixing Price -->
    <bpmn:parallelGateway id="Gateway_JoinFixPrice_09" name="Join&#10;Tasks">
      <bpmn:incoming>SequenceFlow_SECApprovalReceived</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_RoadShowComplete</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_JoinTasks</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 11: Fix Issue Price -->
    <bpmn:task id="Task_FixIssuePrice_10" name="Fix Issue&#10;Price">
      <bpmn:incoming>SequenceFlow_JoinTasks</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FinalDecisionCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 12: Final Decision -->
    <bpmn:exclusiveGateway id="Gateway_FinalDecision_11" name="Reason Not&#10;to Proceed?">
      <bpmn:incoming>SequenceFlow_FinalDecisionCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CancelledFinal</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_FirmCommitment</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event 13: Cancelled Final -->
    <bpmn:endEvent id="End_CancelledFinal_12" name="Offer&#10;Cancelled">
      <bpmn:incoming>SequenceFlow_CancelledFinal</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task 14: Firm Commitment & Offer -->
    <bpmn:task id="Task_FirmCommitment_13" name="Firm Commitment&#10;Offer to Public">
      <bpmn:incoming>SequenceFlow_FirmCommitment</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CompletedIPO</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 15: Completed -->
    <bpmn:endEvent id="End_Completed_14" name="Public&#10;Offering Made">
      <bpmn:incoming>SequenceFlow_CompletedIPO</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    
    <bpmn:sequenceFlow id="SequenceFlow_SelectUnderwriters" sourceRef="StartEvent_01" targetRef="Task_SelectUnderwriters_02"/>

    <bpmn:sequenceFlow id="SequenceFlow_ProvideAdvice" sourceRef="Task_SelectUnderwriters_02" targetRef="Task_ProvideAdvice_03"/>

    <bpmn:sequenceFlow id="SequenceFlow_FairnessCheck" sourceRef="Task_ProvideAdvice_03" targetRef="Gateway_FairnessCheck_04"/>

    <bpmn:sequenceFlow id="SequenceFlow_CancelledUnfair" name="No&#10;(Fair)" sourceRef="Gateway_FairnessCheck_04" targetRef="End_CancelledUnfair_05"/>

    <bpmn:sequenceFlow id="SequenceFlow_SplitPrep" name="Yes" sourceRef="Gateway_FairnessCheck_04" targetRef="Gateway_SplitPrep_05"/>

    <!-- Correcting the Join Logic -->
    
    <bpmn:parallelGateway id="Gateway_JoinFixPrice_09" name="Join&#10;Tasks">
        <bpmn:incoming>SequenceFlow_SECApprovalReceived</bpmn:incoming>
        <bpmn:incoming>SequenceFlow_RoadShowComplete</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow_JoinTasks</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Correcting the Catch Event outgoing flow to Join Gateway -->
    
    <bpmn:sequenceFlow id="SequenceFlow_SECApprovalReceived" sourceRef="CatchEvent_SECApproval_07" targetRef="Gateway_JoinFixPrice_09"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_RoadShowComplete" sourceRef="Task_RoadShow_08" targetRef="Gateway_JoinFixPrice_09"/>

    <!-- Fixing the Split Gateway Outgoing Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_PrepareRegStatement" name="Prepare Reg.&#10;Stmt." sourceRef="Gateway_SplitPrep_05" targetRef="Task_PrepareRegStatement_06"/>

    <!-- Wait Event incoming from Task 7 -->
    <bpmn:sequenceFlow id="SequenceFlow_SubmitForApproval" sourceRef="Task_PrepareRegStatement_06" targetRef="CatchEvent_SECApproval_07"/>

    <!-- Road Show Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_RoadShowStart" sourceRef="Gateway_SplitPrep_05" targetRef="Task_RoadShow_08"/>

    <!-- Join to Fix Price Task -->
    <bpmn:sequenceFlow id="SequenceFlow_JoinTasks" sourceRef="Gateway_JoinFixPrice_09" targetRef="Task_FixIssuePrice_10"/>

    <!-- Fix Price to Final Decision -->
    <bpmn:sequenceFlow id="SequenceFlow_FinalDecisionCheck" sourceRef="Task_FixIssuePrice_10" targetRef="Gateway_FinalDecision_11"/>

    <!-- Final Decision Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_CancelledFinal" name="Yes&#10;(Reason Found)" sourceRef="Gateway_FinalDecision_11" targetRef="End_CancelledFinal_12"/>

    <bpmn:sequenceFlow id="SequenceFlow_FirmCommitment" name="No&#10;(Proceed)" sourceRef="Gateway_FinalDecision_11" targetRef="Task_FirmCommitment_13"/>

    <!-- Completed Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_CompletedIPO" sourceRef="Task_FirmCommitment_13" targetRef="End_Completed_14"/>

  </bpmn:process>
</bpmn:definitions>