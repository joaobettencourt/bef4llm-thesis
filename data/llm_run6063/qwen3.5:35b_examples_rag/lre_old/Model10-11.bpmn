<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_MeasurementProcess_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_Measurements">
    <bpmn:participant id="Participant_GO" name="GO (Government Authority)" processRef="Process_GO"/>
    <bpmn:participant id="Participant_MSP" name="MSP (Measurement Service Provider)" processRef="Process_MSP"/>
    <bpmn:messageFlow id="MessageFlow_01" sourceRef="Task_GO_RequestMeasurements" targetRef="StartEvent_MSP_CheckRequest"/>
    <bpmn:messageFlow id="MessageFlow_02" sourceRef="IntermediateThrow_Event_DENY" targetRef="CatchEvent_GO_FailureNotification"/>
    <bpmn:messageFlow id="MessageFlow_03" sourceRef="Task_MSP_TransmitValues" targetRef="StartEvent_GO_ProcessMeasurements"/>
    <bpmn:messageFlow id="MessageFlow_04" sourceRef="Task_GO_SendChangedValues" targetRef="CatchEvent_MSP_ChangedValuesReceived"/>
  </bpmn:collaboration>

  <!-- GO Process -->
  <bpmn:process id="Process_GO" isExecutable="false">
    <bpmn:startEvent id="StartEvent_GO_RequestMeasurements" name="Request Measurements">
      <bpmn:outgoing>SequenceFlow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_GO_RequestMeasurements" name="GO requests measurements of MSP">
      <bpmn:incoming>SequenceFlow_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_02</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Catch Event for Failure Notification -->
    <bpmn:intermediateCatchEvent id="CatchEvent_GO_FailureNotification" name="Receive Denial">
      <bpmn:incoming>SequenceFlow_03</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_04</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Start Event for Processing Measurements -->
    <bpmn:startEvent id="StartEvent_GO_ProcessMeasurements" name="Receive Measured Values">
      <bpmn:incoming>SequenceFlow_05</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_06</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task to Process Measurements -->
    <bpmn:task id="Task_GO_ProcessMeasurements" name="Process measured values">
      <bpmn:incoming>SequenceFlow_05</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_07</bpmn:outgoing>
    </bpmn:task>

    <!-- Task to Send Changed Values -->
    <bpmn:task id="Task_GO_SendChangedValues" name="Send changed values to MSP">
      <bpmn:incoming>SequenceFlow_06</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_08</bpmn:outgoing>
    </bpmn:task>

    <!-- Task to Transmit Readings -->
    <bpmn:task id="Task_GO_TransmitReadings" name="Transmit readings to SP">
      <bpmn:incoming>SequenceFlow_07</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_09</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_GO_Complete" name="Measurements Complete">
      <bpmn:incoming>SequenceFlow_08</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_12</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows for GO Process -->
    <bpmn:sequenceFlow id="SequenceFlow_GO_01" sourceRef="StartEvent_GO_RequestMeasurements" targetRef="Task_GO_RequestMeasurements"/>
    <bpmn:sequenceFlow id="SequenceFlow_GO_02" name="Denial Path" sourceRef="CatchEvent_GO_FailureNotification" targetRef="EndEvent_GO_Complete">
      <bpmn:name>Denial</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Process Measurements Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_GO_03" sourceRef="StartEvent_GO_ProcessMeasurements" targetRef="Task_GO_ProcessMeasurements"/>
    <bpmn:sequenceFlow id="SequenceFlow_GO_04" name="After Processing" sourceRef="CatchEvent_MSP_ChangedValuesReceived" targetRef="Task_GO_SendChangedValues">
      <bpmn:name>Processing Complete</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>

  <!-- MSP Process -->
  <bpmn:process id="Process_MSP" isExecutable="false">
    <bpmn:startEvent id="StartEvent_MSP_CheckRequest" name="Check Request Received">
      <bpmn:incoming>SequenceFlow_MS_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MS_02</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task to Check Request -->
    <bpmn:task id="Task_MSP_CheckRequest" name="MSP checks received request">
      <bpmn:incoming>SequenceFlow_MS_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MS_02</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway for Decision -->
    <bpmn:exclusiveGateway id="Gateway_MSP_DenialDecision" name="Deny or Perform?">
      <bpmn:incoming>SequenceFlow_MS_02</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MS_03</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_MS_04</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task to Deny Request -->
    <bpmn:task id="Task_MSP_DenyRequest" name="Deny request">
      <bpmn:incoming>SequenceFlow_MS_03</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MS_05</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Throw Event for Denial Notification -->
    <bpmn:intermediateThrowEvent id="IntermediateThrow_Event_DENY" name="Send Failure">
      <bpmn:incoming>SequenceFlow_MS_05</bpmn:incoming>
      <bpmn:outgoing>MessageFlow_02</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <!-- Task to Perform Measurement -->
    <bpmn:task id="Task_MSP_PerformMeasurement" name="Perform measurement">
      <bpmn:incoming>SequenceFlow_MS_04</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MS_06</bpmn:outgoing>
    </bpmn:task>

    <!-- Task to Transmit Values -->
    <bpmn:task id="Task_MSP_TransmitValues" name="Transmit measured values">
      <bpmn:incoming>SequenceFlow_MS_06</bpmn:incoming>
      <bpmn:outgoing>MessageFlow_03</bpmn:outgoing>
    </bpmn:task>

    <!-- Catch Event for Changed Values -->
    <bpmn:intermediateCatchEvent id="CatchEvent_MSP_ChangedValuesReceived" name="Receive Changed Values">
      <bpmn:incoming>MessageFlow_04</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GO_04</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_MSP_Complete" name="Process Complete">
      <bpmn:incoming>MessageFlow_02</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_MS_07</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows for MSP Process -->
    <bpmn:sequenceFlow id="SequenceFlow_MS_01" sourceRef="StartEvent_MSP_CheckRequest" targetRef="Task_MSP_CheckRequest"/>
    <bpmn:sequenceFlow id="SequenceFlow_MS_02" name="Check Request Complete" sourceRef="Task_MSP_CheckRequest" targetRef="Gateway_MSP_DenialDecision">
      <bpmn:name>Complete</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Deny Path -->
    <bpmn:sequenceFlow id="SequenceFlow_MS_03" name="Deny Request" sourceRef="Gateway_MSP_DenialDecision" targetRef="Task_MSP_DenyRequest">
      <bpmn:name>yes</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Perform Path -->
    <bpmn:sequenceFlow id="SequenceFlow_MS_04" name="Perform Measurement" sourceRef="Gateway_MSP_DenialDecision" targetRef="Task_MSP_PerformMeasurement">
      <bpmn:name>no</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>

</bpmn:definitions>