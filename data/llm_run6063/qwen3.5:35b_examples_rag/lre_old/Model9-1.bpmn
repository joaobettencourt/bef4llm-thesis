<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_AccountDefaulters_1">
  <bpmn:collaboration id="Collaboration_AccountDefProcess">
    <bpmn:participant id="Participant_SystemOperations" name="System Operations Process"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_AccountDefaulters_1" isExecutable="true">
    
    <!-- Lane Set for Organization -->
    <bpmn:laneSet id="LaneSet_Operations">
      <bpmn:lane id="Lane_SystemAdmin">
        <bpmn:name>System Administrator</bpmn:name>
        <bpmn:flowNodeRef>StartTimerEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BackupDatabase</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CheckDefaultersTable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CRMCheckReturns1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_NewReturnsExist_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegisterDefaultingAccounts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ClientCodesAdvised</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProduceAccountTable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendToManagement</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event - Timer based on weekday morning -->
    <bpmn:startEvent id="StartTimerEvent_1" name="Weekday Morning">
      <bpmn:outgoing>SequenceFlow_BackupDB</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Database Backup -->
    <bpmn:task id="Task_BackupDatabase" name="Backup Database">
      <bpmn:incoming>SequenceFlow_BackupDB</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckDefaultersTable</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Check Defaulters Table for new records -->
    <bpmn:exclusiveGateway id="Gateway_CheckDefaultersTable" name="New Records in Defaulter Table?">
      <bpmn:incoming>SequenceFlow_CheckDefaultersTable</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NewRecordsFound</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoNewRecords</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 2: Check CRM for returns (if no new records in defaulter table) -->
    <bpmn:task id="Task_CRMCheckReturns1" name="Check CRM System - New Returns Filed?">
      <bpmn:incoming>SequenceFlow_NoNewRecords</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NewReturnsExist_1</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2: New Returns Exist? -->
    <bpmn:exclusiveGateway id="Gateway_NewReturnsExist_1" name="New Returns Filed in CRM?">
      <bpmn:incoming>SequenceFlow_NewReturnsExist_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RegisterAccountsYes</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 3: Register Defaulting Accounts -->
    <bpmn:task id="Task_RegisterDefaultingAccounts" name="Register All Defaulting Accounts &amp; Customers">
      <bpmn:incoming>SequenceFlow_RegisterAccountsYes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ClientCodesCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 3: Client Codes Previously Advised? -->
    <bpmn:exclusiveGateway id="Gateway_ClientCodesAdvised" name="Client Codes Previously Advised?">
      <bpmn:incoming>SequenceFlow_ClientCodesCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NotPreviouslyAdvised</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 4: Produce Account Table -->
    <bpmn:task id="Task_ProduceAccountTable" name="Produce Defaulting Accounts Table">
      <bpmn:incoming>SequenceFlow_NotPreviouslyAdvised</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendToManagement</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 5: Send to Account Management -->
    <bpmn:task id="Task_SendToManagement" name="Send Table to Account Management">
      <bpmn:incoming>SequenceFlow_SendToManagement</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CRMCheckReturns2</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 6: Check CRM for returns again -->
    <bpmn:task id="Task_CRMCheckReturns2" name="Check CRM System - New Returns Filed?">
      <bpmn:incoming>SequenceFlow_CRMCheckReturns2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NewReturnsExist_2</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 4: New Returns Exist? (Second Check) -->
    <bpmn:exclusiveGateway id="Gateway_NewReturnsExist_2" name="New Returns Filed in CRM?">
      <bpmn:incoming>SequenceFlow_NewReturnsExist_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReconcileYes</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 7: Reconcile with Defaulters Table -->
    <bpmn:task id="Task_ReconcileDefaulters" name="Reconcile with Existing Defaulter Table">
      <bpmn:incoming>SequenceFlow_ReconcileYes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProcessComplete</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndProcess_1" name="Processing Complete">
      <bpmn:incoming>SequenceFlow_ProcessComplete</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    
    <bpmn:sequenceFlow id="SequenceFlow_BackupDB" sourceRef="StartTimerEvent_1" targetRef="Task_BackupDatabase">
      <bpmn:description>Daily backup process</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_CheckDefaultersTable" sourceRef="Task_BackupDatabase" targetRef="Gateway_CheckDefaultersTable"/>

    <bpmn:sequenceFlow id="SequenceFlow_NewRecordsFound" name="Yes - New Records Found" sourceRef="Gateway_CheckDefaultersTable" targetRef="Task_RegisterDefaultingAccounts">
      <bpmn:description>Proceed to register accounts</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_NoNewRecords" name="No - Check CRM Returns" sourceRef="Gateway_CheckDefaultersTable" targetRef="Task_CRMCheckReturns1">
      <bpmn:description>No new records in defaulter table</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_NewReturnsExist_1" sourceRef="Task_CRMCheckReturns1" targetRef="Gateway_NewReturnsExist_1"/>

    <bpmn:sequenceFlow id="SequenceFlow_RegisterAccountsYes" name="New Returns Exist - Register Accounts" sourceRef="Gateway_NewReturnsExist_1" targetRef="Task_RegisterDefaultingAccounts">
      <bpmn:description>Register all defaulting accounts and customers</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ClientCodesCheck" sourceRef="Task_RegisterDefaultingAccounts" targetRef="Gateway_ClientCodesAdvised"/>

    <bpmn:sequenceFlow id="SequenceFlow_NotPreviouslyAdvised" name="Not Previously Advised - Produce Table" sourceRef="Gateway_ClientCodesAdvised" targetRef="Task_ProduceAccountTable">
      <bpmn:description>Client codes not previously advised</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_SendToManagement" name="Send to Account Management" sourceRef="Task_ProduceAccountTable" targetRef="Task_SendToManagement">
      <bpmn:description>Deliver table of defaulting accounts</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_CRMCheckReturns2" sourceRef="Task_SendToManagement" targetRef="Task_CRMCheckReturns2"/>

    <bpmn:sequenceFlow id="SequenceFlow_NewReturnsExist_2" name="New Returns Exist - Reconcile" sourceRef="Gateway_NewReturnsExist_2" targetRef="Task_ReconcileDefaulters">
      <bpmn:description>Reconcile with existing defaulter table</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ProcessComplete" sourceRef="Task_ReconcileDefaulters" targetRef="EndProcess_1"/>

  </bpmn:process>
</bpmn:definitions>