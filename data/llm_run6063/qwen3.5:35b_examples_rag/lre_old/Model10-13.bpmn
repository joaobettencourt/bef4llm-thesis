<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_INQ_IP">
    <bpmn:participant id="Participant_INQ" name="INQ" processRef="Process_INQ"/>
    <bpmn:participant id="Participant_IP" name="IP" processRef="Process_IP"/>
    <bpmn:messageFlow id="MessageFlow_Request" sourceRef="IntermediateThrowEvent_SendRequest" targetRef="StartCatchEvent_ReceiveRequest"/>
    <bpmn:messageFlow id="MessageFlow_Response" sourceRef="Task_TransmitDataResponse" targetRef="EndINQ_Processed"/>
  </bpmn:collaboration>

  <!-- INQ Process -->
  <bpmn:process id="Process_INQ" isExecutable="false">
    <bpmn:startEvent id="StartINQ_None" name="Transaction Data Request Initiated">
      <bpmn:outgoing>SequenceFlow_StartToThrow</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:intermediateThrowEvent id="IntermediateThrowEvent_SendRequest" name="Transmit Transaction Data Request">
      <bpmn:incoming>SequenceFlow_StartToThrow</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ThrowToCatchResponse</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <bpmn:endEvent id="EndINQ_Processed" name="Request Processed">
      <bpmn:incoming>SequenceFlow_CatchToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows for INQ -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToThrow" sourceRef="StartINQ_None" targetRef="IntermediateThrowEvent_SendRequest"/>
  </bpmn:process>

  <!-- IP Process -->
  <bpmn:process id="Process_IP" isExecutable="false">
    <bpmn:startEvent id="StartCatchEvent_ReceiveRequest" name="Transaction Data Request Received">
      <bpmn:outgoing>SequenceFlow_StartToCheck</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task to check the request -->
    <bpmn:task id="Task_CheckRequest" name="Examine Transaction Data Request">
      <bpmn:incoming>SequenceFlow_StartToCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckToGateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Decision Gateway based on examination outcome -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_Examination" name="Examination Outcome">
      <bpmn:incoming>SequenceFlow_CheckToGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TransmitDataPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RejectRequestPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task for transmission of data -->
    <bpmn:task id="Task_TransmitData" name="Transmit Data">
      <bpmn:incoming>SequenceFlow_TransmitDataPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DataToResponse</bpmn:outgoing>
    </bpmn:task>

    <!-- Task for rejection -->
    <bpmn:task id="Task_RejectRequest" name="Reject Request">
      <bpmn:incoming>SequenceFlow_RejectRequestPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RejectToResponse</bpmn:outgoing>
    </bpmn:task>

    <!-- End Events -->
    <bpmn:endEvent id="EndIP_Transmission" name="Data Transmission Completed">
      <bpmn:incoming>SequenceFlow_DataToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndIP_Rejected" name="Request Rejected">
      <bpmn:incoming>SequenceFlow_RejectToInqResponse</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows for IP -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToCheck" sourceRef="StartCatchEvent_ReceiveRequest" targetRef="Task_CheckRequest"/>
    <bpmn:sequenceFlow id="SequenceFlow_CheckToGateway" name="Examination Complete">
      <bpmn:sourceRef>Task_CheckRequest</bpmn:sourceRef>
      <bpmn:targetRef>ExclusiveGateway_Examination</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Gateway Outgoing Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_TransmitDataPath" name="Examination Successful">
      <bpmn:sourceRef>ExclusiveGateway_Examination</bpmn:sourceRef>
      <bpmn:targetRef>Task_TransmitData</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_RejectRequestPath" name="Examination Failed">
      <bpmn:sourceRef>ExclusiveGateway_Examination</bpmn:sourceRef>
      <bpmn:targetRef>Task_RejectRequest</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Flow from Transmit Data Task -->
    <bpmn:sequenceFlow id="SequenceFlow_DataToResponse" sourceRef="Task_TransmitData" targetRef="EndIP_Transmission"/>
    
    <!-- Flow for Response Message (Logic correction to match collaboration) -->
    <bpmn:intermediateThrowEvent id="IntermediateThrowEvent_SendResponse" name="Send Answer">
      <bpmn:incoming>SequenceFlow_DataToResponse</bpmn:incoming>
      <bpmn:outgoing>MessageFlow_Response</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

  </bpmn:process>

</bpmn:definitions>