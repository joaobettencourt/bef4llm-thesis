<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_SchedulePlan_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_TownPlanningAuthority">
    <bpmn:participant id="Participant_Authority" name="Town Planning Authority" processRef="Process_PlanSchedule"/>
    <bpmn:participant id="Participant_Members" name="Committee Members" processRef="Process_CommitteeCheck"/>
    
    <!-- Message Flow 1: Send Final Schedule -->
    <bpmn:messageFlow id="MessageFlow_SendSchedule" sourceRef="IntermediateThrowEvent_SendFinalSchedule" targetRef="StartEvent_ReceiveSchedule" />

    <!-- Message Flow 2: Advise Conflicts (Optional feedback loop) -->
    <bpmn:messageFlow id="MessageFlow_AdviseConflicts" sourceRef="Task_AdviseConflicts" targetRef="IntermediateCatchEvent_ConflictAdvice"/>
  </bpmn:collaboration>

  <!-- Process for Town Planning Authority -->
  <bpmn:process id="Process_PlanSchedule" isExecutable="true">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_CoordinationUnit" name="Coordination Unit">
        <bpmn:flowNodeRef>Task_DraftSchedule</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ConflictCheck</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_SupportOfficer" name="Support Officer">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckDates</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="November Schedule Draft">
      <bpmn:outgoing>SequenceFlow_StartToDraft</bpmn:outgoing>
      <bpmn:timerEventDefinition />
    </bpmn:startEvent>

    <!-- Task 1 -->
    <bpmn:task id="Task_DraftSchedule" name="Draft Schedule &amp; Add Dates">
      <bpmn:incoming>SequenceFlow_StartToDraft</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DraftToCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2 -->
    <bpmn:task id="Task_CheckDates" name="Check Dates &amp; Suggest Modifications">
      <bpmn:incoming>SequenceFlow_DraftToCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckToRecheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway -->
    <bpmn:exclusiveGateway id="Gateway_ConflictCheck" name="Conflicts Found?">
      <bpmn:incoming>SequenceFlow_CheckToRecheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NoConflictSend</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Intermediate Throw Event (Message) -->
    <bpmn:intermediateThrowEvent id="IntermediateThrowEvent_SendFinalSchedule" name="Send Final Schedule">
      <bpmn:incoming>SequenceFlow_NoConflictSend</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToDraft" sourceRef="StartEvent_1" targetRef="Task_DraftSchedule"/>

    <bpmn:sequenceFlow id="SequenceFlow_DraftToCheck" sourceRef="Task_DraftSchedule" targetRef="Task_CheckDates"/>

    <bpmn:sequenceFlow id="SequenceFlow_CheckToRecheck" name="Suggest Modifications" sourceRef="Task_CheckDates" targetRef="Gateway_ConflictCheck"/>

    <bpmn:sequenceFlow id="SequenceFlow_NoConflictSend" name="No Conflicts Found" sourceRef="Gateway_ConflictCheck" targetRef="IntermediateThrowEvent_SendFinalSchedule"/>

  </bpmn:process>

  <!-- Process for Committee Members -->
  <bpmn:process id="Process_CommitteeCheck" isExecutable="true">
    <!-- Start Event (Message) -->
    <bpmn:startEvent id="StartEvent_ReceiveSchedule" name="Receive Schedule">
      <bpmn:outgoing>SequenceFlow_MemberTask</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>

    <!-- Task -->
    <bpmn:task id="Task_AdviseConflicts" name="Check Diaries &amp; Advise Conflicts">
      <bpmn:incoming>SequenceFlow_MemberTask</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendAdvice</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_MemberTask" sourceRef="StartEvent_ReceiveSchedule" targetRef="Task_AdviseConflicts"/>
    
  </bpmn:process>

</bpmn:definitions>