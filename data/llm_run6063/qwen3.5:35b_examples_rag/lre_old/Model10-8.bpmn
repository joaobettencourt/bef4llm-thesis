<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_MSP_Deregistration" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:message id="MessageDeregisterRequest"/>
  <bpmn:message id="MessageAssignmentInfo_MSPO"/>
  <bpmn:message id="MessageAssignmentInfo_MPO"/>
  <bpmn:message id="MessageAssignmentInfo_SP"/>

  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_MSPO" name="MSPO" processRef="Process_MSPO"/>
    <bpmn:participant id="Participant_GO" name="GO" processRef="Process_GO"/>

    <!-- Message Flows -->
    <bpmn:messageFlow id="MessageFlow_01" sourceRef="Task_MSPO_DeregisterAtGO_1" targetRef="Start_ReceiveDeregistration_1">
      <bpmn:sourceRef>Task_MSPO_DeregisterAtGO_1</bpmn:sourceRef>
      <bpmn:targetRef>Start_ReceiveDeregistration_1</bpmn:targetRef>
    </bpmn:messageFlow>

    <bpmn:messageFlow id="MessageFlow_02" sourceRef="Task_InformMSPO_1" targetRef="Participant_MSPO">
      <bpmn:sourceRef>Task_InformMSPO_1</bpmn:sourceRef>
      <bpmn:targetRef>Participant_MSPO</bpmn:targetRef>
    </bpmn:messageFlow>

    <bpmn:messageFlow id="MessageFlow_03" sourceRef="Task_InformMPO_1" targetRef="Participant_GO">
      <bpmn:sourceRef>Task_InformMPO_1</bpmn:sourceRef>
      <bpmn:targetRef>Participant_GO</bpmn:targetRef>
    </bpmn:messageFlow>

    <bpmn:messageFlow id="MessageFlow_04" sourceRef="Task_InformSP_1" targetRef="Participant_GO">
      <bpmn:sourceRef>Task_InformSP_1</bpmn:sourceRef>
      <bpmn:targetRef>Participant_GO</bpmn:targetRef>
    </bpmn:messageFlow>

  </bpmn:collaboration>

  <!-- MSPO Process -->
  <bpmn:process id="Process_MSPO">
    <bpmn:startEvent id="Start_DeregisterRequest_1" name="Deregistration Request Initiated">
      <bpmn:outgoing>SequenceFlow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_MSPO_DeregisterAtGO_1" name="Register Deregistration at GO">
      <bpmn:incoming>SequenceFlow_01</bpmn:incoming>
      <bpmn:messageRef>MessageDeregisterRequest</bpmn:messageRef>
    </bpmn:task>

  </bpmn:process>

  <!-- GO Process -->
  <bpmn:process id="Process_GO">
    
    <!-- Start Event triggered by MSPO message (simulated as start for this process definition) -->
    <bpmn:startEvent id="Start_ReceiveDeregistration_1" name="Receive Deregistration Request">
      <bpmn:messageRef>MessageDeregisterRequest</bpmn:messageRef>
      <bpmn:outgoing>SequenceFlow_GO_01</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 2 -->
    <bpmn:task id="Task_VerifyDeregistration_1" name="Verify Deregistration">
      <bpmn:incoming>SequenceFlow_GO_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GO_02</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 3 -->
    <bpmn:exclusiveGateway id="Gateway_Decision_1" name="Reject or Confirm?">
      <bpmn:incoming>SequenceFlow_GO_02</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Reject</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_Confirm</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Reject Path -->
    <bpmn:endEvent id="End_DeregistrationRejected_1" name="Deregistration Rejected">
      <bpmn:incoming>SequenceFlow_Reject</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Confirm Path -->
    <bpmn:task id="Task_AssignSelfAsMSP_1" name="Assign Self as MSP">
      <bpmn:incoming>SequenceFlow_Confirm</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GO_03</bpmn:outgoing>
    </bpmn:task>

    <!-- Inform MSPO -->
    <bpmn:task id="Task_InformMSPO_1" name="Inform MSPO about Assignment">
      <bpmn:incoming>SequenceFlow_GO_03</bpmn:incoming>
      <bpmn:messageRef>MessageAssignmentInfo_MSPO</bpmn:messageRef>
    </bpmn:task>

    <!-- Inform MPO -->
    <bpmn:task id="Task_InformMPO_1" name="Inform MPO about Assignment">
      <bpmn:incoming>SequenceFlow_GO_04</bpmn:incoming>
      <bpmn:messageRef>MessageAssignmentInfo_MPO</bpmn:messageRef>
    </bpmn:task>

    <!-- Inform SP -->
    <bpmn:task id="Task_InformSP_1" name="Inform SP about Assignment">
      <bpmn:incoming>SequenceFlow_GO_05</bpmn:incoming>
      <bpmn:messageRef>MessageAssignmentInfo_SP</bpmn:messageRef>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="End_ProcessComplete_1" name="Assignment Complete">
      <bpmn:incoming>SequenceFlow_GO_06</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows GO Internal -->
    <bpmn:sequenceFlow id="SequenceFlow_GO_01" sourceRef="Start_ReceiveDeregistration_1" targetRef="Task_VerifyDeregistration_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_GO_02" name="Verification Result" sourceRef="Task_VerifyDeregistration_1" targetRef="Gateway_Decision_1">
      <bpmn:description>GO verifies the deregistration.</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Decision Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_Reject" name="Reject Deregistration" sourceRef="Gateway_Decision_1" targetRef="End_DeregistrationRejected_1">
      <bpmn:description>GO rejects the deregistration.</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_Confirm" name="Preliminarily Confirm" sourceRef="Gateway_Decision_1" targetRef="Task_AssignSelfAsMSP_1">
      <bpmn:description>GO preliminarily confirms the deregistration.</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Post-Assignment Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_GO_03" sourceRef="Task_AssignSelfAsMSP_1" targetRef="Task_InformMSPO_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_GO_04" sourceRef="Task_InformMSPO_1" targetRef="Task_InformMPO_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_GO_05" sourceRef="Task_InformMPO_1" targetRef="Task_InformSP_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_GO_06" sourceRef="Task_InformSP_1" targetRef="End_ProcessComplete_1"/>

  </bpmn:process>

</bpmn:definitions>