<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_DIYRepair">
    <bpmn:participant id="Participant_Diysmartphone" name="DIY Smartphone Screen Repair Process" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_RepairRequest" name="Repair Request Started">
      <bpmn:outgoing>SequenceFlow_EnterModel</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- User enters model and what is broken -->
    <bpmn:userTask id="UserTask_EnterInfo" name="Enter Smartphone Model &amp; What's Broken">
      <bpmn:incoming>SequenceFlow_EnterModel</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToolAnalysis</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Tool provides materials, tools, ordering choices -->
    <bpmn:serviceTask id="ServiceTool_Analysis" name="Tool Analyzes &amp; Provides Materials/Tools List">
      <bpmn:incoming>SequenceFlow_ToolAnalysis</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckInventory</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Decision: Do you already have the item? -->
    <bpmn:exclusiveGateway id="Exclusive_Gateway_HaveItem" name="Already Have Item?">
      <bpmn:incoming>SequenceFlow_CheckInventory</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AlreadyHave</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NeedToBuyBorrow</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Already have - skip purchase -->
    <bpmn:userTask id="UserTask_AlreadyHave" name="Item Already Owned (Skip Purchase)">
      <bpmn:incoming>SequenceFlow_AlreadyHave</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeProcurement1</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Need to buy/borrow - contact friends first -->
    <bpmn:userTask id="UserTask_ContactFriends" name="Contact Friends for Borrow/Buy">
      <bpmn:incoming>SequenceFlow_NeedToBuyBorrow</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BoughtFromFriend</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Buy remaining items -->
    <bpmn:userTask id="UserTask_BuyItems" name="Buy Remaining Items">
      <bpmn:incoming>SequenceFlow_NeedToBuyBorrow2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeProcurement2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Merge procurement paths -->
    <bpmn:exclusiveGateway id="Exclusive_Gateway_ProcurementMerge" name="All Items Procured?">
      <bpmn:incoming>SequenceFlow_MergeProcurement1</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_BoughtFromFriend</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_MergeProcurement2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReceiveInstructions</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Receive instructions -->
    <bpmn:userTask id="UserTask_ReceiveInstructions" name="Receive Repair Instructions">
      <bpmn:incoming>SequenceFlow_ReceiveInstructions</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PerformRepair</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Perform repair -->
    <bpmn:userTask id="UserTask_PerformRepair" name="Perform Smartphone Repair">
      <bpmn:incoming>SequenceFlow_PerformRepair</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckSuccess</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Decision: Did it work? -->
    <bpmn:exclusiveGateway id="Exclusive_Gateway_Success" name="Repair Successful?">
      <bpmn:incoming>SequenceFlow_CheckSuccess</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SuccessPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_FailurePath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Success path - send review/video -->
    <bpmn:userTask id="UserTask_SendReview" name="Send Review/Video of Repair">
      <bpmn:incoming>SequenceFlow_SuccessPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndSuccess</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Failure path - send to expert -->
    <bpmn:userTask id="UserTask_SendToExpert" name="Send Phone to Expert">
      <bpmn:incoming>SequenceFlow_FailurePath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndFailure</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_Success" name="Repair Complete">
      <bpmn:incoming>SequenceFlow_EndSuccess</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_Failure" name="Expert Repair Needed">
      <bpmn:incoming>SequenceFlow_EndFailure</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_EnterModel" sourceRef="StartEvent_RepairRequest" targetRef="UserTask_EnterInfo"/>
    <bpmn:sequenceFlow id="SequenceFlow_ToolAnalysis" sourceRef="UserTask_EnterInfo" targetRef="ServiceTool_Analysis"/>
    <bpmn:sequenceFlow id="SequenceFlow_CheckInventory" sourceRef="ServiceTool_Analysis" targetRef="Exclusive_Gateway_HaveItem"/>

    <!-- Have item paths -->
    <bpmn:sequenceFlow id="SequenceFlow_AlreadyHave" name="Yes - Already Owned" sourceRef="Exclusive_Gateway_HaveItem" targetRef="UserTask_AlreadyHave"/>
    
    <!-- Need to buy/borrow path -->
    <bpmn:sequenceFlow id="SequenceFlow_NeedToBuyBorrow" name="No - Borrow Option" sourceRef="Exclusive_Gateway_HaveItem" targetRef="UserTask_ContactFriends"/>

    <!-- Buy items alternative path -->
    <bpmn:sequenceFlow id="SequenceFlow_NeedToBuyBorrow2" name="No - Purchase Only" sourceRef="Exclusive_Gateway_HaveItem" targetRef="UserTask_BuyItems"/>

    <!-- Procurement merge paths -->
    <bpmn:sequenceFlow id="SequenceFlow_MergeProcurement1" sourceRef="UserTask_AlreadyHave" targetRef="Exclusive_Gateway_ProcurementMerge"/>
    
    <!-- Contact friends path -->
    <bpmn:sequenceFlow id="SequenceFlow_BoughtFromFriend" name="Borrowed/Bought from Friend" sourceRef="UserTask_ContactFriends" targetRef="Exclusive_Gateway_ProcurementMerge"/>

    <!-- Merge from buying items -->
    <bpmn:sequenceFlow id="SequenceFlow_MergeProcurement2" sourceRef="UserTask_BuyItems" targetRef="Exclusive_Gateway_ProcurementMerge"/>

    <!-- Instructions and repair flow -->
    <bpmn:sequenceFlow id="SequenceFlow_ReceiveInstructions" name="All Items Procured - Yes" sourceRef="Exclusive_Gateway_ProcurementMerge" targetRef="UserTask_ReceiveInstructions"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_PerformRepair" sourceRef="UserTask_ReceiveInstructions" targetRef="UserTask_PerformRepair"/>

    <!-- Success/failure decision -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckSuccess" name="Check Repair Result" sourceRef="UserTask_PerformRepair" targetRef="Exclusive_Gateway_Success"/>

    <!-- Success path -->
    <bpmn:sequenceFlow id="SequenceFlow_SuccessPath" name="Yes - Worked!" sourceRef="Exclusive_Gateway_Success" targetRef="UserTask_SendReview"/>

    <!-- Failure path -->
    <bpmn:sequenceFlow id="SequenceFlow_FailurePath" name="No - Didn't Work" sourceRef="Exclusive_Gateway_Success" targetRef="UserTask_SendToExpert"/>

    <!-- End paths -->
    <bpmn:sequenceFlow id="SequenceFlow_EndSuccess" sourceRef="UserTask_SendReview" targetRef="EndEvent_Success"/>
    
  </bpmn:process>
</bpmn:definitions>