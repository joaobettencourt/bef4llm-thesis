<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_VisaProcess">
    <bpmn:participant id="Participant_AustriaVisa" name="Work and Live in Austria Process" processRef="Process_1" />
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Applicant">
        <bpmn:flowNodeRef>StartEvent_VisaApplication</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_AccommodationBank</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_ImmigrationOffice">
        <bpmn:flowNodeRef>Task_VisaApplicationForm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_DocumentCheck</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Representative">
        <bpmn:flowNodeRef>Task_CheckRequirements</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_VisaDecision</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_VisaApplication" name="Begin Visa Application">
      <bpmn:outgoing>SequenceFlow_StartToAccommodation</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Accommodation and Bank Account Tasks -->
    <bpmn:task id="Task_OrganizeAccommodation" name="Organize Accommodation">
      <bpmn:incoming>SequenceFlow_StartToAccommodation</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AccommodationDone</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_OpenBankAccount" name="Open Bank Account (Negotiation)">
      <bpmn:incoming>SequenceFlow_StartToAccommodation</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BankDone</bpmn:outgoing>
    </bpmn:task>

    <!-- Visa Application Form -->
    <bpmn:task id="Task_VisaApplicationForm" name="Complete Visa Application Form">
      <bpmn:incoming>SequenceFlow_AccommodationBankMerge</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FormToDocuments</bpmn:outgoing>
    </bpmn:task>

    <!-- Document Collection Tasks -->
    <bpmn:task id="Task_TravelDocument" name="Prepare Travel Document">
      <bpmn:incoming>SequenceFlow_DocumentsSplit</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TravelDocDone</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_PassportPhoto" name="Prepare Passport Photo (35x45mm)">
      <bpmn:incoming>SequenceFlow_DocumentsSplit</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PhotoDone</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_HealthInsurance" name="Obtain Travel Health Insurance (30,000 Euro)">
      <bpmn:incoming>SequenceFlow_DocumentsSplit</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InsuranceDone</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_MeansOfSubsistence" name="Prepare Proof of Means of Subsistence">
      <bpmn:incoming>SequenceFlow_DocumentsSplit</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SubstanceDone</bpmn:outgoing>
    </bpmn:task>

    <!-- Additional Documents Task -->
    <bpmn:task id="Task_AdditionalDocuments" name="Prepare Additional Required Documents">
      <bpmn:incoming>SequenceFlow_DocumentsSplit</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AdditionalDone</bpmn:outgoing>
    </bpmn:task>

    <!-- Requirements Check -->
    <bpmn:exclusiveGateway id="InclusiveGateway_AccommodationBank" name="Accommodation &amp; Bank Account?">
      <bpmn:incoming>SequenceFlow_StartToAccommodation</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToForm</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Document Check Gateway -->
    <bpmn:inclusiveGateway id="InclusiveGateway_DocumentCheck" name="All Documents Ready?">
      <bpmn:incoming>SequenceFlow_TravelDocDone</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_PhotoDone</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_InsuranceDone</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_SubstanceDone</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_AdditionalDone</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToRequirementsCheck</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Visa Decision Gateway -->
    <bpmn:exclusiveGateway id="InclusiveGateway_VisaDecision" name="Visa Requirements Met?">
      <bpmn:incoming>SequenceFlow_ToRequirementsCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Approved</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_Rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_VisaApproved" name="Visa Approved">
      <bpmn:incoming>SequenceFlow_Approved</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_Rejected" name="Application Rejected">
      <bpmn:incoming>SequenceFlow_Rejected</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToAccommodation" sourceRef="StartEvent_VisaApplication" targetRef="InclusiveGateway_AccommodationBank" />
    
    <bpmn:sequenceFlow id="SequenceFlow_ToForm" name="Proceed to Application Form" sourceRef="InclusiveGateway_AccommodationBank" targetRef="Task_VisaApplicationForm" />

    <bpmn:parallelGateway id="ParallelGateway_DocumentsSplit">
      <bpmn:incoming>SequenceFlow_FormToDocuments</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TravelDocReq</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PhotoReq</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_InsuranceReq</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SubstanceReq</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_AdditionalReq</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Document Collection Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_TravelDocReq" sourceRef="ParallelGateway_DocumentsSplit" targetRef="Task_TravelDocument" />
    
    <bpmn:sequenceFlow id="SequenceFlow_PhotoReq" sourceRef="ParallelGateway_DocumentsSplit" targetRef="Task_PassportPhoto" />

    <bpmn:sequenceFlow id="SequenceFlow_InsuranceReq" sourceRef="ParallelGateway_DocumentsSplit" targetRef="Task_HealthInsurance" />
    
    <bpmn:sequenceFlow id="SequenceFlow_SubstanceReq" sourceRef="ParallelGateway_DocumentsSplit" targetRef="Task_MeansOfSubsistence" />

    <bpmn:sequenceFlow id="SequenceFlow_AdditionalReq" name="Additional Documents Required?" sourceRef="ParallelGateway_DocumentsSplit" targetRef="Task_AdditionalDocuments" />
    
    <!-- Document Completion Flows -->
    <bpmn:parallelGateway id="ParallelGateway_DocumentMerge">
      <bpmn:incoming>SequenceFlow_TravelDocDone</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_PhotoDone</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_InsuranceDone</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_SubstanceDone</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_AdditionalDone</bpmn:incoming>
    </bpmn:parallelGateway>

    <!-- Requirements Check Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_ToRequirementsCheck" sourceRef="ParallelGateway_DocumentMerge" targetRef="Task_CheckRequirements" />

    <bpmn:task id="Task_CheckRequirements" name="Verify All Visa Requirements">
      <bpmn:incoming>SequenceFlow_ToRequirementsCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_VisaDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Decision Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_Approved" name="Requirements Met - Yes" sourceRef="InclusiveGateway_VisaDecision" targetRef="EndEvent_VisaApproved" />
    
    <bpmn:sequenceFlow id="SequenceFlow_Rejected" name="Missing Requirements - No" sourceRef="InclusiveGateway_VisaDecision" targetRef="EndEvent_Rejected" />

  </bpmn:process>
</bpmn:definitions>