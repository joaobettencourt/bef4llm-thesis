<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_FridgeService">
    <bpmn:participant id="Participant_ServiceCenter" name="Fridge Service Process" processRef="Process_FridgeRepair" />
  </bpmn:collaboration>

  <bpmn:process id="Process_FridgeRepair" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Customer">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConfirmOK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RateService</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ServiceCenter">
        <bpmn:flowNodeRef>InclusiveGateway_1PartsCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectFacility</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VisitFacility</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OrderParts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RepairFridge</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_1" name="Report Fridge Issue">
      <bpmn:outgoing>SequenceFlow_ReportIssue</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_ReceiptInfo" name="Describe Symptoms &amp; Fridge Type">
      <bpmn:incoming>SequenceFlow_ReportIssue</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendToCenter</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_SelectFacility" name="Select Local Service Facility">
      <bpmn:incoming>SequenceFlow_SendToCenter</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MakeAppointment</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_VisitFacility" name="Make Appointment &amp; Arrive">
      <bpmn:incoming>SequenceFlow_MakeAppointment</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckParts</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="InclusiveGateway_1PartsCheck" name="Parts Available?">
      <bpmn:incoming>SequenceFlow_CheckParts</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RepairPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoPartsPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_OrderParts" name="Order Additional Parts">
      <bpmn:incoming>SequenceFlow_NoPartsPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReturnVisit</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_RepairFridge" name="Repair Fridge">
      <bpmn:incoming>SequenceFlow_RepairPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConfirmOK</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_ConfirmOK" name="Confirm Fridge is OK">
      <bpmn:incoming>SequenceFlow_ConfirmOK</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RateService</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_RateService" name="Rate Service Facility">
      <bpmn:incoming>SequenceFlow_RateService</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndProcess</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_1" name="Service Completed">
      <bpmn:incoming>SequenceFlow_EndProcess</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow_ReportIssue" sourceRef="StartEvent_1" targetRef="Task_ReceiptInfo" />
    <bpmn:sequenceFlow id="SequenceFlow_SendToCenter" sourceRef="Task_ReceiptInfo" targetRef="Task_SelectFacility" />
    <bpmn:sequenceFlow id="SequenceFlow_MakeAppointment" sourceRef="Task_SelectFacility" targetRef="Task_VisitFacility" />
    <bpmn:sequenceFlow id="SequenceFlow_CheckParts" sourceRef="Task_VisitFacility" targetRef="InclusiveGateway_1PartsCheck" />

    <bpmn:sequenceFlow id="SequenceFlow_RepairPath" name="Yes - Parts Available" sourceRef="InclusiveGateway_1PartsCheck" targetRef="Task_RepairFridge" />
    
    <bpmn:sequenceFlow id="SequenceFlow_NoPartsPath" name="No - Need Parts" sourceRef="InclusiveGateway_1PartsCheck" targetRef="Task_OrderParts" />

    <bpmn:sequenceFlow id="SequenceFlow_ReturnVisit" sourceRef="Task_OrderParts" targetRef="Task_VisitFacility">
      <!-- Loop back to Visit for parts ordering -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ConfirmOK" sourceRef="Task_RepairFridge" targetRef="Task_ConfirmOK" />
    
    <bpmn:sequenceFlow id="SequenceFlow_RateService" sourceRef="Task_ConfirmOK" targetRef="Task_RateService" />

    <bpmn:sequenceFlow id="SequenceFlow_EndProcess" sourceRef="Task_RateService" targetRef="EndEvent_1" />
  </bpmn:process>
</bpmn:definitions>