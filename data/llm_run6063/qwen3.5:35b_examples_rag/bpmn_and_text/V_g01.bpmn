<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_BurgerSeller">
    <bpmn:participant id="Participant_RobotSystem" name="Robotic Burger Seller Process" processRef="Process_BurgerOrdering" />
  </bpmn:collaboration>

  <bpmn:process id="Process_BurgerOrdering" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_RobotSystem" name="Robot System">
        <bpmn:flowNodeRef>StartEvent_OrderReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_MenuChoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_DrinkSideSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_FriesWedges</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_FoodReady</bpmn:flowNodeRef>
      </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_OrderReceived" name="Order Received">
      <bpmn:outgoing>SequenceFlow_MenuChoice</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Decision Gateway 1: Menu or Just Burger? -->
    <bpmn:inclusiveGateway id="InclusiveGateway_MenuChoice" name="Menu Order?" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow_MenuChoice</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DrinkSidePrep</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_JustBurgerPath</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Parallel Split for Drink and Side Prep (Menu Case) -->
    <bpmn:parallelGateway id="ParallelGateway_DrinkSideSplit" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow_DrinkSidePrep</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PrepareDrink</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SideSelectionStart</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 1: Prepare Drink -->
    <bpmn:task id="Task_PrepareDrink" name="Prepare Drink (Variable Time)">
      <bpmn:incoming>SequenceFlow_PrepareDrink</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DrinkDone</bpmn:outgoing>
    </bpmn:task>

    <!-- Decision Gateway 2: Fries or Wedges? -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_FriesWedges" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow_SideSelectionStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PrepareFries</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PrepareWedges</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 2a: Prepare Fries -->
    <bpmn:task id="Task_PrepareFries" name="Prepare Fries (Variable Time)">
      <bpmn:incoming>SequenceFlow_PrepareFries</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SideDone</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2b: Prepare Wedges -->
    <bpmn:task id="Task_PrepareWedges" name="Prepare Wedges (Variable Time)">
      <bpmn:incoming>SequenceFlow_PrepareWedges</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SideDone2</bpmn:outgoing>
    </bpmn:task>

    <!-- Join Point for Drink and Side Prep -->
    <bpmn:parallelGateway id="ParallelGateway_FoodReady" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow_DrinkDone</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_SideDone</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToBurgerPrep</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 3: Prepare Burger -->
    <bpmn:task id="Task_PrepareBurger" name="Prepare Burger (Updates every 30s)">
      <bpmn:incoming>SequenceFlow_ToBurgerPrep</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_JustBurgerPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BurgerDone</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 4: Delivery via Conveyor Belt -->
    <bpmn:task id="Task_DeliverOrder" name="Deliver Order (Conveyor)">
      <bpmn:incoming>SequenceFlow_BurgerDone</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OrderShipped</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_OrderDelivered" name="Order Delivered">
      <bpmn:incoming>SequenceFlow_OrderShipped</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_MenuChoice" sourceRef="StartEvent_OrderReceived" targetRef="InclusiveGateway_MenuChoice">
      <bpmn:name />
    </bpmn:sequenceFlow>
    
    <bpmn:sequenceFlow id="SequenceFlow_DrinkSidePrep" name="Yes (Menu)" sourceRef="InclusiveGateway_MenuChoice" targetRef="ParallelGateway_DrinkSideSplit" />
    <bpmn:sequenceFlow id="SequenceFlow_JustBurgerPath" name="No (Just Burger)" sourceRef="InclusiveGateway_MenuChoice" targetRef="Task_PrepareBurger" />

    <bpmn:sequenceFlow id="SequenceFlow_PrepareDrink" sourceRef="ParallelGateway_DrinkSideSplit" targetRef="Task_PrepareDrink" />
    
    <bpmn:sequenceFlow id="SequenceFlow_SideSelectionStart" name="Ask Fries/Wedges" sourceRef="ParallelGateway_DrinkSideSplit" targetRef="ExclusiveGateway_FriesWedges" />

    <bpmn:sequenceFlow id="SequenceFlow_PrepareFries" name="Yes (Fries)" sourceRef="ExclusiveGateway_FriesWedges" targetRef="Task_PrepareFries" />
    <bpmn:sequenceFlow id="SequenceFlow_PrepareWedges" name="No (Wedges)" sourceRef="ExclusiveGateway_FriesWedges" targetRef="Task_PrepareWedges" />

    <bpmn:sequenceFlow id="SequenceFlow_DrinkDone" sourceRef="Task_PrepareDrink" targetRef="ParallelGateway_FoodReady" />
    
    <!-- Fries and Wedges converge to Side Done -->
     <bpmn:sequenceFlow id="SequenceFlow_SideDone" name="" sourceRef="Task_PrepareFries" targetRef="ParallelGateway_FoodReady">
      <bpmn:name>Fries</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Wedges flow to parallel gateway -->
     <bpmn:sequenceFlow id="SequenceFlow_SideDone2" name="" sourceRef="Task_PrepareWedges" targetRef="ParallelGateway_FoodReady">
      <bpmn:name>Wedges</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Merge to Burger Prep -->
    <bpmn:sequenceFlow id="SequenceFlow_ToBurgerPrep" sourceRef="ParallelGateway_FoodReady" targetRef="Task_PrepareBurger" />

    <bpmn:sequenceFlow id="SequenceFlow_BurgerDone" name="" sourceRef="Task_PrepareBurger" targetRef="Task_DeliverOrder" />
    
    <bpmn:sequenceFlow id="SequenceFlow_OrderShipped" sourceRef="Task_DeliverOrder" targetRef="EndEvent_OrderDelivered" />

  </bpmn:process>
</bpmn:definitions>