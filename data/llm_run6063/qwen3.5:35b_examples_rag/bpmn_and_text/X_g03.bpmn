<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                 xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" 
                 xmlns:di="http://www.omg.org/spec/DD/20100524/DI" 
                 xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                 id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:collaboration id="Collaboration_ViennaNightRun">
    <bpmn:participant id="Participant_NightRunProcess" name="Vienna Night Run Participation Process" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_SelectBlock" name="Select Starting Block">
      <bpmn:outgoing>SequenceFlow_Run5km</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Run 5km and measure time (can be done via fitness gadget) -->
    <bpmn:userTask id="Task_RunAndMeasure" name="Run 5km &amp; Measure Time">
      <bpmn:incoming>SequenceFlow_Run5km</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckTime</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Decision Gateway - Is time less than 25 minutes? -->
    <bpmn:exclusiveGateway id="Gateway_TimeCheck" name="Less than 25 min?">
      <bpmn:incoming>SequenceFlow_CheckTime</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GoalAchieved</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_TrainMore</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Training Loop - If not achieved, train and check again -->
    <bpmn:userTask id="Task_Train" name="Train">
      <bpmn:incoming>SequenceFlow_TrainMore</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckAgain</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Goal Achieved - Get Starting Number -->
    <bpmn:userTask id="Task_GetStartingNumber" name="Get Starting Number">
      <bpmn:incoming>SequenceFlow_GoalAchieved</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckCommute</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Decision Gateway - Commute from home or work? -->
    <bpmn:exclusiveGateway id="Gateway_Commute" name="More than 1 hour to start time?">
      <bpmn:incoming>SequenceFlow_CheckCommute</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FromHome</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_FromWork</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Commute from Home -->
    <bpmn:userTask id="Task_CommuteFromHome" name="Go to Race from Home">
      <bpmn:incoming>SequenceFlow_FromHome</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StartRace</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Commute from Work -->
    <bpmn:userTask id="Task_CommuteFromWork" name="Leave Directly from Work">
      <bpmn:incoming>SequenceFlow_FromWork</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StartRace</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel Gateway - Run and Drink simultaneously -->
    <bpmn:parallelGateway id="Gateway_RaceStart" name="Race Start">
      <bpmn:incoming>SequenceFlow_StartRace</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RunDuringRace</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_DrinkDuringRace</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Run during race -->
    <bpmn:userTask id="Task_RaceRun" name="Run During Race">
      <bpmn:incoming>SequenceFlow_RunDuringRace</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeRaceEnd</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Drink during race (parallel activity) -->
    <bpmn:userTask id="Task_RaceDrink" name="Drink During Race">
      <bpmn:incoming>SequenceFlow_DrinkDuringRace</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeRaceEnd</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Merge after race activities -->
    <bpmn:parallelGateway id="Gateway_RaceMerge" name="Race End">
      <bpmn:incoming>SequenceFlow_RunDuringRace</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_DrinkDuringRace</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FinalTime</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Final Running Time -->
    <bpmn:endEvent id="EndEvent_Finish" name="Receive Final Running Time">
      <bpmn:incoming>SequenceFlow_FinalTime</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows for Training Loop -->
    <bpmn:sequenceFlow id="SequenceFlow_TrainMore" sourceRef="Gateway_TimeCheck" targetRef="Task_Train"/>

    <!-- Sequence Flows for Goal Achieved -->
    <bpmn:sequenceFlow id="SequenceFlow_GoalAchieved" sourceRef="Gateway_TimeCheck" targetRef="Task_GetStartingNumber"/>

    <!-- Sequence Flows for Commute Decision -->
    <bpmn:sequenceFlow id="SequenceFlow_FromHome" sourceRef="Gateway_Commute" targetRef="Task_CommuteFromHome"/>

    <!-- Sequence Flows for Commute Decision -->
    <bpmn:sequenceFlow id="SequenceFlow_FromWork" sourceRef="Gateway_Commute" targetRef="Task_CommuteFromWork"/>

    <!-- Initial Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_Run5km" sourceRef="StartEvent_SelectBlock" targetRef="Task_RunAndMeasure"/>
    
    <!-- Check Time flow -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckTime" sourceRef="Task_RunAndMeasure" targetRef="Gateway_TimeCheck"/>

    <!-- Loop back to check time again from training task -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckAgain" sourceRef="Task_Train" targetRef="StartEvent_SelectBlock"/>

    <!-- Check Commute flow -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckCommute" sourceRef="Task_GetStartingNumber" targetRef="Gateway_Commute"/>

    <!-- Start Race Flow (from both commute options) -->
    <bpmn:sequenceFlow id="SequenceFlow_StartRace" name="" sourceRef="Task_CommuteFromHome" targetRef="Gateway_RaceStart">
      <bpmn:name>Go to race</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>