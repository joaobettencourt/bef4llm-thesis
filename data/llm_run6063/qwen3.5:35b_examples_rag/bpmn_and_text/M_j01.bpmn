<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_ChainsawProcess">
    <bpmn:participant id="Participant_Manufacturing" name="Chainsaw Manufacturing Process" processRef="Process_Chainsaw_1" />
  </bpmn:collaboration>

  <bpmn:process id="Process_Chainsaw_1" isExecutable="false">
    <!-- Lane Set for Organization -->
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Ordering" name="Order Management">
        <bpmn:flowNodeRef>StartEvent_OrderReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DefineSpecifications</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Production" name="Production Team">
        <bpmn:flowNodeRef>ParallelGateway_OrderSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OrderParts_Source1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OrderParts_Source2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_PartsJoined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ManualInspection</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_OrderReceived" name="Order Received">
      <bpmn:outgoing>SequenceFlow_DefineSpecs</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Define Specifications based on 5 properties -->
    <bpmn:task id="Task_DefineSpecifications" name="Define Chainsaw Properties">
      <bpmn:incoming>SequenceFlow_DefineSpecs</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SplitOrdering</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway for Ordering Parts in Parallel -->
    <bpmn:parallelGateway id="ParallelGateway_OrderSplit" name="Start Order">
      <bpmn:incoming>SequenceFlow_SplitOrdering</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OrderSource1</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_OrderSource2</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Tasks for Ordering Parts (Parallel) -->
    <bpmn:task id="Task_OrderParts_Source1" name="Order Parts from Source 1">
      <bpmn:incoming>SequenceFlow_OrderSource1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_JoinArrival1</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_OrderParts_Source2" name="Order Parts from Source 2">
      <bpmn:incoming>SequenceFlow_OrderSource2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_JoinArrival2</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway Join for Parts Arrival -->
    <bpmn:parallelGateway id="ParallelGateway_PartsJoined" name="Parts Arrived">
      <bpmn:incoming>SequenceFlow_JoinArrival1</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_JoinArrival2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StartInspection</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Manual Inspection -->
    <bpmn:task id="Task_ManualInspection" name="Manual Inspection of Parts">
      <bpmn:incoming>SequenceFlow_StartInspection</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SplitProduction</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway for Production & Updates -->
    <bpmn:parallelGateway id="ParallelGateway_ProductionStart" name="Produce First Saw">
      <bpmn:incoming>SequenceFlow_SplitProduction</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AssembleFirstSaw</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SendUpdates</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Assemble First Saw -->
    <bpmn:task id="Task_AssembleFirstSaw" name="Assemble First Chainsaw">
      <bpmn:incoming>SequenceFlow_AssembleFirstSaw</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_JoinReadyToShip1</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Send Updates (Parallel) -->
    <bpmn:task id="Task_SendUpdates" name="Send Production Update">
      <bpmn:incoming>SequenceFlow_SendUpdates</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_JoinReadyToShip2</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway Join for Ready to Ship -->
    <bpmn:parallelGateway id="ParallelGateway_ReadyToShip" name="First Saw Complete">
      <bpmn:incoming>SequenceFlow_JoinReadyToShip1</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_JoinReadyToShip2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ShipSaw</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Ship First Saw -->
    <bpmn:task id="Task_ShipFirstSaw" name="Ship to Customer">
      <bpmn:incoming>SequenceFlow_ShipSaw</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckApproval</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway for Approval -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_CustomerApproval" name="Customer Likes It?">
      <bpmn:incoming>SequenceFlow_CheckApproval</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProduceRest</bpmn:outgoing> <!-- Yes -->
      <bpmn:outgoing>SequenceFlow_CancelOrder</bpmn:outgoing>  <!-- No -->
    </bpmn:exclusiveGateway>

    <!-- Task: Produce Rest of Order (Yes Path) -->
    <bpmn:task id="Task_ProduceRest" name="Produce Remaining Units">
      <bpmn:incoming>SequenceFlow_ProduceRest</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FinishOrder</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 1 -->
    <bpmn:endEvent id="EndEvent_OrderCompleted" name="Order Completed">
      <bpmn:incoming>SequenceFlow_FinishOrder</bpmn:incoming>
    </bpmn:endEvent>

    <!-- End Event 2 (No Path) -->
    <bpmn:endEvent id="EndEvent_Cancelled" name="Order Cancelled">
      <bpmn:incoming>SequenceFlow_CancelOrder</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_DefineSpecs" sourceRef="StartEvent_OrderReceived" targetRef="Task_DefineSpecifications" />
    
    <bpmn:sequenceFlow id="SequenceFlow_SplitOrdering" sourceRef="Task_DefineSpecifications" targetRef="ParallelGateway_OrderSplit" />

    <bpmn:sequenceFlow id="SequenceFlow_OrderSource1" name="Part 1 Order" sourceRef="ParallelGateway_OrderSplit" targetRef="Task_OrderParts_Source1" />
    
    <bpmn:sequenceFlow id="SequenceFlow_OrderSource2" name="Part 2 Order" sourceRef="ParallelGateway_OrderSplit" targetRef="Task_OrderParts_Source2" />

    <bpmn:sequenceFlow id="SequenceFlow_JoinArrival1" sourceRef="Task_OrderParts_Source1" targetRef="ParallelGateway_PartsJoined" />
    
    <bpmn:sequenceFlow id="SequenceFlow_JoinArrival2" sourceRef="Task_OrderParts_Source2" targetRef="ParallelGateway_PartsJoined" />

    <bpmn:sequenceFlow id="SequenceFlow_StartInspection" sourceRef="ParallelGateway_PartsJoined" targetRef="Task_ManualInspection" />
    
    <bpmn:sequenceFlow id="SequenceFlow_SplitProduction" sourceRef="Task_ManualInspection" targetRef="ParallelGateway_ProductionStart" />

    <bpmn:sequenceFlow id="SequenceFlow_AssembleFirstSaw" name="Assemble Unit 1" sourceRef="ParallelGateway_ProductionStart" targetRef="Task_AssembleFirstSaw" />
    
    <bpmn:sequenceFlow id="SequenceFlow_SendUpdates" name="Send Update" sourceRef="ParallelGateway_ProductionStart" targetRef="Task_SendUpdates" />

    <bpmn:sequenceFlow id="SequenceFlow_JoinReadyToShip1" sourceRef="Task_AssembleFirstSaw" targetRef="ParallelGateway_ReadyToShip" />
    
    <bpmn:sequenceFlow id="SequenceFlow_JoinReadyToShip2" sourceRef="Task_SendUpdates" targetRef="ParallelGateway_ReadyToShip" />

    <bpmn:sequenceFlow id="SequenceFlow_ShipSaw" name="First Saw Ready" sourceRef="ParallelGateway_ReadyToShip" targetRef="Task_ShipFirstSaw" />

    <bpmn:sequenceFlow id="SequenceFlow_CheckApproval" sourceRef="Task_ShipFirstSaw" targetRef="ExclusiveGateway_CustomerApproval" />
    
    <bpmn:sequenceFlow id="SequenceFlow_ProduceRest" name="Yes - Likes It" sourceRef="ExclusiveGateway_CustomerApproval" targetRef="Task_ProduceRest" />
    
    <bpmn:sequenceFlow id="SequenceFlow_CancelOrder" name="No - Cancelled" sourceRef="ExclusiveGateway_CustomerApproval" targetRef="EndEvent_Cancelled" />

    <bpmn:sequenceFlow id="SequenceFlow_FinishOrder" sourceRef="Task_ProduceRest" targetRef="EndEvent_OrderCompleted" />
  </bpmn:process>
</bpmn:definitions>