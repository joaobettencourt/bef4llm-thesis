<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_LegoMachine" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="Participant_MachineBuilding" name="Custom Machine Building Process" processRef="Process_Building"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Building" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="Start_DevelopDesign" name="Develop Basic Design">
      <bpmn:outgoing>Flow_OrderSets</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Order Lego Brick Sets Task -->
    <bpmn:task id="Task_OrderBrickSets" name="Order Lego Brick Sets">
      <bpmn:incoming>Flow_OrderSets</bpmn:incoming>
      <bpmn:outgoing>Flow_SortParts</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway for Sorting and Building -->
    <bpmn:parallelGateway id="GW_ParallelStart" name="">
      <bpmn:incoming>Flow_SortParts</bpmn:incoming>
      <bpmn:outgoing>Flow_ChildrenSort</bpmn:outgoing>
      <bpmn:outgoing>Flow_BuildSubcomponents</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Children Sorting Parts Task -->
    <bpmn:task id="Task_SortParts" name="Children Sort Parts into Containers">
      <bpmn:incoming>Flow_ChildrenSort</bpmn:incoming>
      <bpmn:outgoing>Flow_PartReady</bpmn:outgoing>
    </bpmn:task>

    <!-- Build Subcomponent Task -->
    <bpmn:task id="Task_BuildSubcomponent" name="Build Individual Subcomponent">
      <bpmn:incoming>Flow_BuildSubcomponents</bpmn:incoming>
      <bpmn:outgoing>Flow_TestSubcomponent</bpmn:outgoing>
    </bpmn:task>

    <!-- Test Subcomponent Task -->
    <bpmn:task id="Task_TestSubcomponent" name="Test Individual Subcomponent">
      <bpmn:incoming>Flow_TestSubcomponent</bpmn:incoming>
      <bpmn:outgoing>GW_DecisionTest</bpmn:outgoing>
    </bpmn:task>

    <!-- Decision Gateway for Test Result -->
    <bpmn:exclusiveGateway id="GW_DecisionTest" name="Test Successful?">
      <bpmn:incoming>Flow_TestSubcomponent</bpmn:incoming>
      <bpmn:outgoing>Flow_AssembleNext</bpmn:outgoing>
      <bpmn:outgoing>Flow_RedesignRebuild</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Redesign and Rebuild Task -->
    <bpmn:task id="Task_RedesignRebuild" name="Redesign and Rebuild Subcomponent">
      <bpmn:incoming>Flow_RedesignRebuild</bpmn:incoming>
      <bpmn:outgoing>Flow_BuildSubcomponentLoop</bpmn:outgoing>
    </bpmn:task>

    <!-- Check Parts Available Gateway -->
    <bpmn:exclusiveGateway id="GW_PartsAvailable" name="Parts in Container?">
      <bpmn:incoming>Flow_PartReady</bpmn:incoming>
      <bpmn:outgoing>Flow_BuildSubcomponentLoop</bpmn:outgoing>
      <bpmn:outgoing>Flow_ReorderParts</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Reorder Individual Parts Task -->
    <bpmn:task id="Task_ReorderParts" name="Reorder Individual Parts">
      <bpmn:incoming>Flow_ReorderParts</bpmn:incoming>
      <bpmn:outgoing>Flow_PartReadyLoop</bpmn:outgoing>
    </bpmn:task>

    <!-- Assemble Final Machine Task -->
    <bpmn:task id="Task_AssembleMachine" name="Assemble Subcomponents">
      <bpmn:incoming>Flow_AssembleNext</bpmn:incoming>
      <bpmn:outgoing>Flow_EndProcess</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="End_Completed" name="Machine Completed">
      <bpmn:incoming>Flow_EndProcess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Flow_OrderSets" sourceRef="Start_DevelopDesign" targetRef="Task_OrderBrickSets"/>
    
    <bpmn:sequenceFlow id="Flow_SortParts" sourceRef="Task_OrderBrickSets" targetRef="GW_ParallelStart"/>
    
    <bpmn:sequenceFlow id="Flow_ChildrenSort" sourceRef="GW_ParallelStart" targetRef="Task_SortParts"/>
    
    <bpmn:sequenceFlow id="Flow_BuildSubcomponents" sourceRef="GW_ParallelStart" targetRef="Task_BuildSubcomponent"/>
    
    <bpmn:sequenceFlow id="Flow_TestSubcomponent" sourceRef="Task_BuildSubcomponent" targetRef="Task_TestSubcomponent"/>
    
    <bpmn:sequenceFlow id="Flow_AssembleNext" name="Yes - Test Passed" sourceRef="GW_DecisionTest" targetRef="Task_AssembleMachine"/>
    
    <bpmn:sequenceFlow id="Flow_RedesignRebuild" name="No - Redesign Needed" sourceRef="GW_DecisionTest" targetRef="Task_RedesignRebuild"/>
    
    <bpmn:sequenceFlow id="Flow_BuildSubcomponentLoop" sourceRef="Task_SortParts" targetRef="Task_BuildSubcomponent"/>
    
    <bpmn:sequenceFlow id="Flow_PartReady" name="Yes - Parts Available" sourceRef="GW_PartsAvailable" targetRef="Task_BuildSubcomponent"/>
    
    <bpmn:sequenceFlow id="Flow_ReorderParts" name="No - Reorder Needed" sourceRef="GW_PartsAvailable" targetRef="Task_ReorderParts"/>
    
    <bpmn:sequenceFlow id="Flow_PartReadyLoop" sourceRef="Task_ReorderParts" targetRef="Task_BuildSubcomponent"/>
    
    <bpmn:sequenceFlow id="Flow_EndProcess" name="All Tests Passed" sourceRef="GW_DecisionTest" targetRef="End_Completed">
      <!-- Note: This flow represents successful completion after all subcomponents tested -->
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>