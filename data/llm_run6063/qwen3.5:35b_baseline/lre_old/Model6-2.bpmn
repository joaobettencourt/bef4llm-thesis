<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Assembler" name="Assembler AG" processRef="Process_Assembler" />
    <bpmn:participant id="Participant_Supplier" name="Supplier" processRef="Process_Supplier" />
    
    <!-- Message Flow 1: Order Request -->
    <bpmn:messageFlow id="MessageFlow_Order_01">
      <bpmn:sourceRef>Task_PlaceOrder_01</bpmn:sourceRef>
      <bpmn:targetRef>StartEvent_OrderMsg_02</bpmn:targetRef>
    </bpmn:messageFlow>

    <!-- Message Flow 2: Invoice -->
    <bpmn:messageFlow id="MessageFlow_Invoice_01">
      <bpmn:sourceRef>Task_ProcessInvoice_02</bpmn:sourceRef>
      <bpmn:targetRef>IntermediateCatch_Invoice_01</bpmn:targetRef>
    </bpmn:messageFlow>

  </bpmn:collaboration>

  <!-- Process for Assembler AG -->
  <bpmn:process id="Process_Assembler" isExecutable="false">
    
    <!-- Start Event: Timer (First of Month) -->
    <bpmn:startEvent id="StartEvent_Timer_01" name="Periodic Order Request">
      <bpmn:timerEventDefinition />
      <bpmn:outgoing>SequenceFlow_Assembler_Start</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Place Order -->
    <bpmn:task id="Task_PlaceOrder_01" name="Place Order Request">
      <bpmn:incoming>SequenceFlow_Assembler_Start</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Assembler_WaitInvoice</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Catch Event: Wait for Invoice -->
    <bpmn:startEvent id="IntermediateCatch_Invoice_01" name="Receive Invoice">
      <bpmn:messageEventDefinition />
      <bpmn:incoming>SequenceFlow_Assembler_WaitInvoice</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Assembler_Done</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Done_01" name="Order Processed">
      <bpmn:incoming>SequenceFlow_Assembler_Done</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows within Assembler -->
    <bpmn:sequenceFlow id="SequenceFlow_Assembler_Start" sourceRef="StartEvent_Timer_01" targetRef="Task_PlaceOrder_01" />
    <bpmn:sequenceFlow id="SequenceFlow_Assembler_WaitInvoice" sourceRef="Task_PlaceOrder_01" targetRef="IntermediateCatch_Invoice_01" />
    <bpmn:sequenceFlow id="SequenceFlow_Assembler_Done" sourceRef="IntermediateCatch_Invoice_01" targetRef="EndEvent_Done_01" />

  </bpmn:process>

  <!-- Process for Supplier -->
  <bpmn:process id="Process_Supplier" isExecutable="false">
    
    <!-- Start Event: Receive Order Message -->
    <bpmn:startEvent id="StartEvent_OrderMsg_02" name="Receive Order Request">
      <bpmn:messageEventDefinition />
      <bpmn:outgoing>SequenceFlow_Supplier_Process</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Process & Create Invoice -->
    <bpmn:task id="Task_ProcessInvoice_02" name="Process Order">
      <bpmn:incoming>SequenceFlow_Supplier_Process</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Supplier_End</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Completed_02" name="Order Processed">
      <bpmn:incoming>SequenceFlow_Supplier_End</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows within Supplier -->
    <bpmn:sequenceFlow id="SequenceFlow_Supplier_Process" sourceRef="StartEvent_OrderMsg_02" targetRef="Task_ProcessInvoice_02" />
    <bpmn:sequenceFlow id="SequenceFlow_Supplier_End" sourceRef="Task_ProcessInvoice_02" targetRef="EndEvent_Completed_02" />

  </bpmn:process>

</bpmn:definitions>