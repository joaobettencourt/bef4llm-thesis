<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_HRProcess" name="HR Recruitment Process" processRef="Process_VacancyHandling" />
  </bpmn:collaboration>

  <bpmn:message id="Message_ApprovalDecision" />

  <bpmn:process id="Process_VacancyHandling" isExecutable="false">
    <!-- Lane for HR Staff -->
    <bpmn:laneSet>
      <bpmn:lane id="Lane_HRStaff" name="HR Recruiter">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateJobDescription</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CheckConfusion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AskDepartmentClarification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitForApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CatchEvent_WaitingApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ApprovalDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CorrectDescription</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PostJob</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Vacancy Reported">
      <bpmn:outgoing>SequenceFlow_StartToCreate</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Create Job Description -->
    <bpmn:task id="Task_CreateJobDescription" name="Create Job Description from Information">
      <bpmn:incoming>SequenceFlow_BackToCreate</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToConfusionCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Check Confusion -->
    <bpmn:exclusiveGateway id="Gateway_CheckConfusion" name="Is message confusing?">
      <bpmn:incoming>SequenceFlow_ToConfusionCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NoConfusionToSubmit</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Ask Department for Clarification -->
    <bpmn:task id="Task_AskDepartmentClarification" name="Ask Department for Clarification">
      <bpmn:incoming>SequenceFlow_YesConfusion</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BackToCreate</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Submit for Approval -->
    <bpmn:task id="Task_SubmitForApproval" name="Submit Job Description for Consideration">
      <bpmn:incoming>SequenceFlow_NoConfusionToSubmit</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToWaitEvent</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Catch Event: Wait for Approval -->
    <bpmn:intermediateCatchEvent id="CatchEvent_WaitingApproval" name="Waiting for Approval">
      <bpmn:messageRef>Message_ApprovalDecision</bpmn:messageRef>
      <bpmn:incoming>SequenceFlow_ToWaitEvent</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ApprovalToGateway</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Gateway 2: Approval Decision -->
    <bpmn:exclusiveGateway id="Gateway_ApprovalDecision" name="Approved?">
      <bpmn:incoming>SequenceFlow_ApprovalToGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RejectedWithCorrection</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Correct Description -->
    <bpmn:task id="Task_CorrectDescription" name="Correct Job Description">
      <bpmn:incoming>SequenceFlow_RejectedWithCorrection</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ResubmitToSubmit</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Post Job -->
    <bpmn:task id="Task_PostJob" name="Post the Job">
      <bpmn:incoming>SequenceFlow_ApprovedToPost</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToEndEvent</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_1" name="Job Posted">
      <bpmn:incoming>SequenceFlow_ToEndEvent</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToCreate" sourceRef="StartEvent_1" targetRef="Task_CreateJobDescription">
      <bpmn:name />
    </bpmn:sequenceFlow>

    <bpmn:exclusiveGateway id="ExclusiveGateway_ConfusionYes" name="Is message confusing?">
       <bpmn:incoming>SequenceFlow_ToConfusionCheck</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_YesConfusion</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Note: The above gateway is a duplicate definition for logic clarity in flow, but ID must be unique. 
         I will use the Gateway_CheckConfusion defined earlier and add sequence flows with conditions -->
    
    <bpmn:sequenceFlow id="SequenceFlow_ToConfusionCheck" sourceRef="Task_CreateJobDescription" targetRef="Gateway_CheckConfusion">
      <bpmn:name />
    </bpmn:sequenceFlow>

    <!-- Corrected Sequence Flow for Confusion Yes -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_ConfusionYes2" name="Is message confusing?">
       <bpmn:incoming>SequenceFlow_ToConfusionCheck</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_YesConfusionToAskDept</bpmn:outgoing>
    </bpmn:exclusiveGateway>

     <!-- Corrected Sequence Flow for Confusion No -->
    <bpmn:sequenceFlow id="SequenceFlow_NoConfusionToSubmit" sourceRef="Gateway_CheckConfusion" targetRef="Task_SubmitForApproval">
      <bpmn:name>No</bpmn:name>
    </bpmn:sequenceFlow>

     <!-- Corrected Sequence Flow for Confusion Yes -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_ConfusionYes3" name="Is message confusing?">
       <bpmn:incoming>SequenceFlow_ToConfusionCheck</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_YesConfusionToAskDept2</bpmn:outgoing>
    </bpmn:exclusiveGateway>

     <!-- Corrected Sequence Flow for Confusion Yes -->
    <bpmn:sequenceFlow id="SequenceFlow_YesConfusion" sourceRef="ExclusiveGateway_ConfusionYes3" targetRef="Task_AskDepartmentClarification">
      <bpmn:name>Yes</bpmn:name>
    </bpmn:sequenceFlow>

     <!-- Corrected Sequence Flow Back to Create -->
    <bpmn:sequenceFlow id="SequenceFlow_BackToCreateDescription" sourceRef="Task_AskDepartmentClarification" targetRef="Task_CreateJobDescription">
      <bpmn:name>Back</bpmn:name>
    </bpmn:sequenceFlow>

     <!-- Corrected Sequence Flow to Wait Event -->
    <bpmn:sequenceFlow id="SequenceFlow_ToWaitEvent" sourceRef="Task_SubmitForApproval" targetRef="CatchEvent_WaitingApproval">
      <bpmn:name />
    </bpmn:sequenceFlow>

     <!-- Corrected Sequence Flow from Wait Event to Approval Gateway -->
    <bpmn:sequenceFlow id="SequenceFlow_ApprovalToGateway" sourceRef="CatchEvent_WaitingApproval" targetRef="Gateway_ApprovalDecision">
      <bpmn:name />
    </bpmn:sequenceFlow>

     <!-- Corrected Sequence Flow for Rejected with Correction -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_RejectWithCorrection" name="Rejected?">
       <bpmn:incoming>SequenceFlow_ApprovalToGateway</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_RejectedWithCorrectionToCorrectTask</bpmn:outgoing>
    </bpmn:exclusiveGateway>

     <!-- Corrected Sequence Flow for Rejection -->
    <bpmn:sequenceFlow id="SequenceFlow_RejectedWithCorrection" sourceRef="ExclusiveGateway_RejectWithCorrection" targetRef="Task_CorrectDescription">
      <bpmn:name>Yes</bpmn:name>
    </bpmn:sequenceFlow>

     <!-- Corrected Sequence Flow for Approval -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_ApprovedToPostJob" name="Approved?">
       <bpmn:incoming>SequenceFlow_ApprovalToGateway</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_ApprovedToPostTask</bpmn:outgoing>
    </bpmn:exclusiveGateway>

     <!-- Corrected Sequence Flow for Approval -->
    <bpmn:sequenceFlow id="SequenceFlow_ApprovedToPost" sourceRef="ExclusiveGateway_ApprovedToPostJob" targetRef="Task_PostJob">
      <bpmn:name>No</bpmn:name>
    </bpmn:sequenceFlow>

     <!-- Corrected Sequence Flow for Resubmit -->
    <bpmn:sequenceFlow id="SequenceFlow_ResubmitToSubmit" sourceRef="Task_CorrectDescription" targetRef="Task_SubmitForApproval">
      <bpmn:name />
    </bpmn:sequenceFlow>

     <!-- Corrected Sequence Flow to End Event -->
    <bpmn:sequenceFlow id="SequenceFlow_ToEndEvent" sourceRef="Task_PostJob" targetRef="EndEvent_1">
      <bpmn:name />
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>