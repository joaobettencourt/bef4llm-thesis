<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_RoomService">
    <bpmn:participant id="Participant_HotelRoomService" name="The Evanstonian Room Service" processRef="Process_1" />
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Manager" name="Room Service Manager">
        <bpmn:flowNodeRef>StartEvent_GuestCall</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TakeOrder</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Kitchen" name="Kitchen Staff">
        <bpmn:flowNodeRef>Task_PrepareFood</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Sommelier" name="Sommelier (Wine Waiter)">
        <bpmn:flowNodeRef>Task_FetchAlcoholicBeverages</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Waiter" name="Waiter">
        <bpmn:flowNodeRef>Task_ReadiesCart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DeliverToGuestRoom</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReturnToStation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DebitAccount</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_GuestCall" name="Guest Calls Room Service">
      <bpmn:outgoing>SequenceFlow_TakeOrder</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Manager Tasks -->
    <bpmn:task id="Task_TakeOrder" name="Take Down Order">
      <bpmn:incoming>SequenceFlow_TakeOrder</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SubmitOrders</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway for Kitchen and Sommelier -->
    <bpmn:parallelGateway id="ParallelGateway_1" name="Submit Orders">
      <bpmn:incoming>SequenceFlow_SubmitOrders</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_KitchenOrder</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SommelierOrder</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Kitchen Task -->
    <bpmn:task id="Task_PrepareFood" name="Prepare Food">
      <bpmn:incoming>SequenceFlow_KitchenOrder</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FoodReady</bpmn:outgoing>
    </bpmn:task>

    <!-- Sommelier Task -->
    <bpmn:task id="Task_FetchAlcoholicBeverages" name="Fetch Wine &amp; Alcoholic Beverages">
      <bpmn:incoming>SequenceFlow_SommelierOrder</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BeverageReady</bpmn:outgoing>
    </bpmn:task>

    <!-- Waiter Tasks -->
    <bpmn:task id="Task_ReadiesCart" name="Readies Cart (Tablecloth &amp; Silverware)">
      <bpmn:incoming>SequenceFlow_WaiterStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CartReady</bpmn:outgoing>
    </bpmn:task>

    <!-- Convergence Gateway for Delivery -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_Delivery" name="All Ready?">
      <bpmn:incoming>SequenceFlow_FoodReady</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_BeverageReady</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_CartReady</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DeliverToGuestRoom</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Delivery Task -->
    <bpmn:task id="Task_DeliverToGuestRoom" name="Deliver to Guest Room">
      <bpmn:incoming>SequenceFlow_DeliverToGuestRoom</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReturnStation</bpmn:outgoing>
    </bpmn:task>

    <!-- Return Task -->
    <bpmn:task id="Task_ReturnToStation" name="Return to Room Service Station">
      <bpmn:incoming>SequenceFlow_ReturnStation</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DebitAccountCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Billing Decision Gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_Billing" name="Another Order?">
      <bpmn:incoming>SequenceFlow_DebitAccountCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DebitNow</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Billing Task -->
    <bpmn:task id="Task_DebitAccount" name="Debit Guest Account">
      <bpmn:incoming>SequenceFlow_DebitNow</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OrderCompleted</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_OrderCompleted" name="Order Completed">
      <bpmn:incoming>SequenceFlow_OrderCompleted</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows - Manager to Parallel Gateway -->
    <bpmn:sequenceFlow id="SequenceFlow_TakeOrder" sourceRef="StartEvent_GuestCall" targetRef="Task_TakeOrder" />
    <bpmn:sequenceFlow id="SequenceFlow_SubmitOrders" name="Submit Order Ticket &amp; Sommelier Request" sourceRef="Task_TakeOrder" targetRef="ParallelGateway_1" />

    <!-- Parallel Paths -->
    <bpmn:sequenceFlow id="SequenceFlow_KitchenOrder" name="Kitchen Task" sourceRef="ParallelGateway_1" targetRef="Task_PrepareFood" />
    <bpmn:sequenceFlow id="SequenceFlow_SommelierOrder" name="Sommelier Task (80% of orders)" sourceRef="ParallelGateway_1" targetRef="Task_FetchAlcoholicBeverages" />

    <!-- Waiter Parallel Path -->
    <bpmn:parallelGateway id="ParallelGateway_WaiterStart">
      <bpmn:incoming>SequenceFlow_SubmitOrders</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaiterStart</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Waiter Cart Preparation -->
    <bpmn:sequenceFlow id="SequenceFlow_WaiterStart" sourceRef="ParallelGateway_1" targetRef="Task_ReadiesCart" />
    <bpmn:sequenceFlow id="SequenceFlow_CartReady" name="Cart Ready" sourceRef="Task_ReadiesCart" targetRef="ExclusiveGateway_Delivery" />

    <!-- Convergence for Delivery -->
    <bpmn:sequenceFlow id="SequenceFlow_FoodReady" name="Food Ready" sourceRef="Task_PrepareFood" targetRef="ExclusiveGateway_Delivery" />
    <bpmn:sequenceFlow id="SequenceFlow_BeverageReady" name="Beverages Ready" sourceRef="Task_FetchAlcoholicBeverages" targetRef="ExclusiveGateway_Delivery" />

    <!-- Delivery and Return -->
    <bpmn:sequenceFlow id="SequenceFlow_DeliverToGuestRoom" name="Deliver to Guest Room" sourceRef="ExclusiveGateway_Delivery" targetRef="Task_DeliverToGuestRoom" />
    <bpmn:sequenceFlow id="SequenceFlow_ReturnStation" name="Return to Station" sourceRef="Task_DeliverToGuestRoom" targetRef="Task_ReturnToStation" />

    <!-- Billing Decision -->
    <bpmn:sequenceFlow id="SequenceFlow_DebitAccountCheck" name="Debit Account?" sourceRef="Task_ReturnToStation" targetRef="ExclusiveGateway_Billing" />
    <bpmn:sequenceFlow id="SequenceFlow_DebitNow" name="Yes - Debit Now" sourceRef="ExclusiveGateway_Billing" targetRef="Task_DebitAccount" />

    <!-- Completion -->
    <bpmn:sequenceFlow id="SequenceFlow_OrderCompleted" name="Order Completed" sourceRef="Task_DebitAccount" targetRef="EndEvent_OrderCompleted" />

  </bpmn:process>
</bpmn:definitions>