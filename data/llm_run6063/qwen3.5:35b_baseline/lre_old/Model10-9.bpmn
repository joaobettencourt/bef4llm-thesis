<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_MPO_Change">
    <bpmn:participant id="Participant_MPO_System" name="MPO Change Management System" processRef="Process_MPO_1" />
  </bpmn:collaboration>

  <bpmn:process id="Process_MPO_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_MPO_Operations" name="MPO Operations">
        <bpmn:flowNodeRef>StartEvent_ChangeTrigger</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DecisionConfirmReject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyRejection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PerformChange</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DecisionExecutionResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReportImplementation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyFailure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Failure</bpmn:flowNodeRef>
      </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_ChangeTrigger" name="Change Triggered">
      <bpmn:description>SP/PU/GO request or MPO initiated change</bpmn:description>
      <bpmn:outgoing>SequenceFlow_ReviewRequest</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Review Request -->
    <bpmn:task id="Task_ReviewRequest" name="MPO Reviews Change Request">
      <bpmn:description>MPO reviews the change request of measuring point</bpmn:description>
      <bpmn:incoming>SequenceFlow_ReviewRequest</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DecisionConfirmReject</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Confirm vs Reject -->
    <bpmn:exclusiveGateway id="Gateway_DecisionConfirmReject" name="Review Result">
      <bpmn:description>MPO rejects or confirms the request</bpmn:description>
      <bpmn:incoming>SequenceFlow_DecisionConfirmReject</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RejectPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ConfirmPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flow: Reject -->
    <bpmn:sequenceFlow id="SequenceFlow_RejectPath" name="Rejects Change">
      <bpmn:sourceRef>Gateway_DecisionConfirmReject</bpmn:sourceRef>
      <bpmn:targetRef>Task_NotifyRejection</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Task: Notify Rejection -->
    <bpmn:task id="Task_NotifyRejection" name="Notify SP/PU/GO of Rejection">
      <bpmn:description>MPO rejects the change and notifies requester</bpmn:description>
      <bpmn:incoming>SequenceFlow_RejectPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndRejected</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event: Rejected -->
    <bpmn:endEvent id="EndEvent_Rejected" name="Request Rejected">
      <bpmn:description>Process ends after rejection notification</bpmn:description>
      <bpmn:incoming>SequenceFlow_EndRejected</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flow: Confirm -->
    <bpmn:sequenceFlow id="SequenceFlow_ConfirmPath" name="Confirms Request">
      <bpmn:sourceRef>Gateway_DecisionConfirmReject</bpmn:sourceRef>
      <bpmn:targetRef>Task_PerformChange</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Task: Perform Change -->
    <bpmn:task id="Task_PerformChange" name="Perform Measuring Point Change">
      <bpmn:description>MPO performs the physical change of measuring point</bpmn:description>
      <bpmn:incoming>SequenceFlow_ConfirmPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DecisionExecutionResult</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Execution Result -->
    <bpmn:exclusiveGateway id="Gateway_DecisionExecutionResult" name="Change Implementation Status">
      <bpmn:description>Determine if change was successful or failed</bpmn:description>
      <bpmn:incoming>SequenceFlow_DecisionExecutionResult</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SuccessPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_FailurePath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flow: Success -->
    <bpmn:sequenceFlow id="SequenceFlow_SuccessPath" name="Implementation Successful">
      <bpmn:sourceRef>Gateway_DecisionExecutionResult</bpmn:sourceRef>
      <bpmn:targetRef>Task_ReportImplementation</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Task: Report Implementation -->
    <bpmn:task id="Task_ReportImplementation" name="Report Implementation to SP/PU/GO">
      <bpmn:description>MPO reports successful implementation of change</bpmn:description>
      <bpmn:incoming>SequenceFlow_SuccessPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndSuccess</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event: Success -->
    <bpmn:endEvent id="EndEvent_Success" name="Change Completed">
      <bpmn:description>Process ends after successful implementation report</bpmn:description>
      <bpmn:incoming>SequenceFlow_EndSuccess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flow: Failure -->
    <bpmn:sequenceFlow id="SequenceFlow_FailurePath" name="Implementation Failed">
      <bpmn:sourceRef>Gateway_DecisionExecutionResult</bpmn:sourceRef>
      <bpmn:targetRef>Task_NotifyFailure</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Task: Notify Failure -->
    <bpmn:task id="Task_NotifyFailure" name="Notify SP/PU/GO of Failure">
      <bpmn:description>MPO notifies about failure of changes</bpmn:description>
      <bpmn:incoming>SequenceFlow_FailurePath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndFailure</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event: Failure -->
    <bpmn:endEvent id="EndEvent_Failure" name="Change Failed">
      <bpmn:description>Process ends after failure notification</bpmn:description>
      <bpmn:incoming>SequenceFlow_EndFailure</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>