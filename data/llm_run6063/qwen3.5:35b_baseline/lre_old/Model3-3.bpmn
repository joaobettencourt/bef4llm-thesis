<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_ClaimsHandling" name="Claims Handling Process" processRef="Process_1" />
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_ClaimsOfficer" name="Claims Officer">
        <bpmn:flowNodeRef>StartEvent_ClaimRegistered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExamineClaim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WriteRecommendation</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SeniorOfficer" name="Senior Claims Officer">
        <bpmn:flowNodeRef>Task_CheckRecommendation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DecisionOKNotOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ProcessProceeds</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_ClaimRegistered" name="Claim Registered">
      <bpmn:outgoing>SequenceFlow_Examine</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Examine Claim (Claims Officer) -->
    <bpmn:task id="Task_ExamineClaim" name="Examine Claim">
      <bpmn:incoming>SequenceFlow_Examine</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WriteRec</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: Write Recommendation (Claims Officer) -->
    <bpmn:task id="Task_WriteRecommendation" name="Write Settlement Recommendation">
      <bpmn:incoming>SequenceFlow_WriteRec</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_RepeatRec</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendForCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3: Check Recommendation (Senior Claims Officer) -->
    <bpmn:task id="Task_CheckRecommendation" name="Check Settlement Recommendation">
      <bpmn:incoming>SequenceFlow_SendForCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Decision OK or Not OK -->
    <bpmn:exclusiveGateway id="Gateway_DecisionOKNotOk" name="Claim Marked?">
      <bpmn:incoming>SequenceFlow_ToDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NotOK</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_OK</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_ProcessProceeds" name="Process Proceeds">
      <bpmn:incoming>SequenceFlow_OK</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_Examine" sourceRef="StartEvent_ClaimRegistered" targetRef="Task_ExamineClaim" />
    
    <bpmn:sequenceFlow id="SequenceFlow_WriteRec" name="Write Rec" sourceRef="Task_ExamineClaim" targetRef="Task_WriteRecommendation" />

    <!-- Cross-lane flow to Senior Officer -->
    <bpmn:sequenceFlow id="SequenceFlow_SendForCheck" name="Send for Check" sourceRef="Task_WriteRecommendation" targetRef="Task_CheckRecommendation" />

    <!-- Flow from Task to Gateway -->
    <bpmn:sequenceFlow id="SequenceFlow_ToDecision" sourceRef="Task_CheckRecommendation" targetRef="Gateway_DecisionOKNotOk" />

    <!-- Loop Back for Not OK -->
    <bpmn:sequenceFlow id="SequenceFlow_NotOK" name="Marked as Not OK" sourceRef="Gateway_DecisionOKNotOk" targetRef="Task_WriteRecommendation" />

    <!-- Proceed to End for OK -->
    <bpmn:sequenceFlow id="SequenceFlow_OK" name="Marked as OK" sourceRef="Gateway_DecisionOKNotOk" targetRef="EndEvent_ProcessProceeds" />

  </bpmn:process>
</bpmn:definitions>