<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_RecruitmentProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_Recruit">
    <bpmn:participant id="Participant_HRSystem" name="Employee Recruitment Process" processRef="Proc_1" />
  </bpmn:collaboration>

  <bpmn:process id="Proc_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_FunctionalDept" name="Functional Department">
        <bpmn:flowNodeRef>StartEvent_Demand</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_HRDepartment" name="Human Resources">
        <bpmn:flowNodeRef>Task_AdvertisePost</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Intermediate_CatchApplications</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckApplications</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_Selection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConcludeContract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_PostFilled</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Demand" name="Demand to fill post">
      <bpmn:outgoing>SequenceFlow_InitiateRecruitment</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Advertise -->
    <bpmn:task id="Task_AdvertisePost" name="Advertise Post">
      <bpmn:incoming>SequenceFlow_InitiateRecruitment</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitApplications</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Catch Event for Applications -->
    <bpmn:intermediateCatchEvent id="Intermediate_CatchApplications" name="Receive Application(s)">
      <bpmn:incoming>SequenceFlow_WaitApplications</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StartCheck</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task 2: Check Applications -->
    <bpmn:task id="Task_CheckApplications" name="Check &amp; Select Candidates">
      <bpmn:incoming>SequenceFlow_StartCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DecideCandidate</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_Selection" name="Suitable Candidate Found?">
      <bpmn:incoming>SequenceFlow_DecideCandidate</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ContractPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 3: Conclude Contract -->
    <bpmn:task id="Task_ConcludeContract" name="Conclude Employment Contract">
      <bpmn:incoming>SequenceFlow_ContractPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FinishProcess</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_PostFilled" name="Post Filled">
      <bpmn:incoming>SequenceFlow_FinishProcess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_InitiateRecruitment" sourceRef="StartEvent_Demand" targetRef="Task_AdvertisePost" />
    <bpmn:sequenceFlow id="SequenceFlow_WaitApplications" name="Wait for Applications" sourceRef="Task_AdvertisePost" targetRef="Intermediate_CatchApplications" />
    <bpmn:sequenceFlow id="SequenceFlow_StartCheck" sourceRef="Intermediate_CatchApplications" targetRef="Task_CheckApplications" />
    <bpmn:sequenceFlow id="SequenceFlow_DecideCandidate" name="Evaluate Candidates" sourceRef="Task_CheckApplications" targetRef="ExclusiveGateway_Selection" />
    <bpmn:sequenceFlow id="SequenceFlow_ContractPath" name="Yes - Candidate Found" sourceRef="ExclusiveGateway_Selection" targetRef="Task_ConcludeContract" />
    <bpmn:sequenceFlow id="SequenceFlow_FinishProcess" sourceRef="Task_ConcludeContract" targetRef="EndEvent_PostFilled" />

  </bpmn:process>
</bpmn:definitions>