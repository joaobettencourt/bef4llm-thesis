<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_WarrantProcess">
    <bpmn:participant id="Participant_SmallClaimsRegistry" name="Small Claims Registry Operations" processRef="Process_WarrantProcessing" />
  </bpmn:collaboration>

  <bpmn:process id="Process_WarrantProcessing" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_BackOffice" name="Client Service Back Office">
        <bpmn:flowNodeRef>StartEvent_Request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RetrieveSCTTFile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ForwardToPolice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CatchEvent_PoliceReportReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RetrieveSCTFileAfterReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AttachNewDocument</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_StoreExpandedFile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Completed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Request" name="Warrant Possession Request">
      <bpmn:outgoing>SequenceFlow_RetrieveSCTT</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Retrieve SCTT File -->
    <bpmn:task id="Task_RetrieveSCTTFile" name="Retrieve SCTT File">
      <bpmn:incoming>SequenceFlow_RetrieveSCTT</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ForwardPolice</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: Forward to Queensland Police -->
    <bpmn:task id="Task_ForwardToPolice" name="Forward Warrant Possession Request">
      <bpmn:incoming>SequenceFlow_ForwardPolice</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StoreFileAwaitingReport</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Catch Event: Wait for Police Report -->
    <bpmn:intermediateCatchEvent id="CatchEvent_PoliceReportReceived" name="Receive Report from Police">
      <bpmn:incoming>SequenceFlow_StoreFileAwaitingReport</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RetrieveSCTFileAfterReport</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task 3: Retrieve SCT File (after report) -->
    <bpmn:task id="Task_RetrieveSCTFileAfterReport" name="Retrieve SCT File">
      <bpmn:incoming>SequenceFlow_RetrieveSCTFileAfterReport</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AttachDocument</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 4: Attach New SCT Document -->
    <bpmn:task id="Task_AttachNewDocument" name="Attach New SCT Document">
      <bpmn:incoming>SequenceFlow_AttachDocument</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StoreExpandedFile</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 5: Store Expanded Physical File -->
    <bpmn:task id="Task_StoreExpandedFile" name="Store Expanded SCT Physical File">
      <bpmn:incoming>SequenceFlow_StoreExpandedFile</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_HandoverToStaff</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Completed" name="Process Complete">
      <bpmn:incoming>SequenceFlow_HandoverToStaff</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_RetrieveSCTT" sourceRef="StartEvent_Request" targetRef="Task_RetrieveSCTTFile" />
    <bpmn:sequenceFlow id="SequenceFlow_ForwardPolice" name="Forward to Queensland Police" sourceRef="Task_RetrieveSCTTFile" targetRef="Task_ForwardToPolice" />
    <bpmn:sequenceFlow id="SequenceFlow_StoreFileAwaitingReport" sourceRef="Task_ForwardToPolice" targetRef="CatchEvent_PoliceReportReceived" />
    <bpmn:sequenceFlow id="SequenceFlow_RetrieveSCTFileAfterReport" name="Retrieve SCT File After Report Received" sourceRef="CatchEvent_PoliceReportReceived" targetRef="Task_RetrieveSCTFileAfterReport" />
    <bpmn:sequenceFlow id="SequenceFlow_AttachDocument" sourceRef="Task_RetrieveSCTFileAfterReport" targetRef="Task_AttachNewDocument" />
    <bpmn:sequenceFlow id="SequenceFlow_StoreExpandedFile" name="Store Expanded File" sourceRef="Task_AttachNewDocument" targetRef="Task_StoreExpandedFile" />
    <bpmn:sequenceFlow id="SequenceFlow_HandoverToStaff" name="Hand Over to MC Internal Staff (Out of Scope)" sourceRef="Task_StoreExpandedFile" targetRef="EndEvent_Completed" />

  </bpmn:process>

</bpmn:definitions>