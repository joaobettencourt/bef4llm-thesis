<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_MeetingProcess">
    <bpmn:participant id="Participant_Process" name="Meeting Management Process" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_CoordUnit" name="Coordination Unit">
        <bpmn:flowNodeRef>Task_QACheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SupportOfficer" name="Support Officer">
        <bpmn:flowNodeRef>Task_PrepareLogistics</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AdviseMembers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProduceMinutes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendMinutes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateRecords</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CommitteeMembers" name="Committee Members">
        <bpmn:flowNodeRef>Task_HoldMeeting</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Dates Finalized">
      <bpmn:outgoing>SequenceFlow_PrepareLogistics</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Support Officer - Prepare Logistics -->
    <bpmn:task id="Task_PrepareLogistics" name="Update Calendars, Create Folders &amp; Upload Docs">
      <bpmn:incoming>SequenceFlow_PrepareLogistics</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AdviseMembers</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: Support Officer - Advise Members -->
    <bpmn:task id="Task_AdviseMembers" name="Advise Committee Members to Read Docs">
      <bpmn:incoming>SequenceFlow_AdviseMembers</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_HoldMeetingTrigger</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3: Committee Members - Hold Meeting -->
    <bpmn:task id="Task_HoldMeeting" name="Hold Committee Meeting">
      <bpmn:incoming>SequenceFlow_HoldMeetingTrigger</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProduceMinutesReq</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 4: Support Officer - Produce Minutes -->
    <bpmn:task id="Task_ProduceMinutes" name="Produce Minutes &amp; Action Points">
      <bpmn:incoming>SequenceFlow_ProduceMinutesReq</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_QARequest</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 5: Coordination Unit - QA Check -->
    <bpmn:task id="Task_QACheck" name="Conduct QA Check on Minutes">
      <bpmn:incoming>SequenceFlow_QARequest</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendMinutesReq</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 6: Support Officer - Send Minutes -->
    <bpmn:task id="Task_SendMinutes" name="Send Approved Minutes to Members">
      <bpmn:incoming>SequenceFlow_SendMinutesReq</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_UpdateRecordsReq</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 7: Support Officer - Update Records -->
    <bpmn:task id="Task_UpdateRecords" name="Update Departmental Records">
      <bpmn:incoming>SequenceFlow_UpdateRecordsReq</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndProcess</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_1" name="Meeting Process Completed">
      <bpmn:incoming>SequenceFlow_EndProcess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_PrepareLogistics" sourceRef="StartEvent_1" targetRef="Task_PrepareLogistics" />
    <bpmn:sequenceFlow id="SequenceFlow_AdviseMembers" name="Week Before Meeting" sourceRef="Task_PrepareLogistics" targetRef="Task_AdviseMembers" />
    <bpmn:sequenceFlow id="SequenceFlow_HoldMeetingTrigger" sourceRef="Task_AdviseMembers" targetRef="Task_HoldMeeting" />
    <bpmn:sequenceFlow id="SequenceFlow_ProduceMinutesReq" name="After Meeting" sourceRef="Task_HoldMeeting" targetRef="Task_ProduceMinutes" />
    <bpmn:sequenceFlow id="SequenceFlow_QARequest" name="Within 5 Working Days" sourceRef="Task_ProduceMinutes" targetRef="Task_QACheck" />
    <bpmn:sequenceFlow id="SequenceFlow_SendMinutesReq" sourceRef="Task_QACheck" targetRef="Task_SendMinutes" />
    <bpmn:sequenceFlow id="SequenceFlow_UpdateRecordsReq" name="Post Distribution" sourceRef="Task_SendMinutes" targetRef="Task_UpdateRecords" />
    <bpmn:sequenceFlow id="SequenceFlow_EndProcess" sourceRef="Task_UpdateRecords" targetRef="EndEvent_1" />

  </bpmn:process>
</bpmn:definitions>