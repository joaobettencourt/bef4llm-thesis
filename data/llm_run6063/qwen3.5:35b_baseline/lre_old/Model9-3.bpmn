<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Authority" name="Town Planning Authority" processRef="Process_1" />
    <bpmn:participant id="Participant_Members" name="Committee Members" processRef="Process_2" />
  </bpmn:collaboration>

  <!-- Process for Town Planning Authority -->
  <bpmn:process id="Process_1">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_CoordUnit" name="Coordination Unit">
        <bpmn:flowNodeRef>StartEvent_Annual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DraftSchedule</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ResolveConflicts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecheckDates</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SupportOfficer" name="Support Officer">
        <bpmn:flowNodeRef>Task_CheckDatesSuggest</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Annual" name="Annual Schedule Draft">
      <bpmn:outgoing>SequenceFlow_Draft</bpmn:outgoing>
      <bpmn:timerEventDefinition />
    </bpmn:startEvent>

    <!-- Task 1 -->
    <bpmn:task id="Task_DraftSchedule" name="Draft Schedule & Add Dates">
      <bpmn:incoming>SequenceFlow_Draft</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckSuggest</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2 -->
    <bpmn:task id="Task_CheckDatesSuggest" name="Check Dates & Suggest Modifications">
      <bpmn:incoming>SequenceFlow_CheckSuggest</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Recheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3 -->
    <bpmn:task id="Task_RecheckDates" name="Recheck Dates & Look for Conflicts">
      <bpmn:incoming>SequenceFlow_Recheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendEmail</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway -->
    <bpmn:exclusiveGateway id="Gateway_ResolveConflicts" name="Final Schedule Ready?">
      <bpmn:incoming>SequenceFlow_Recheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendEmail</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_Draft" sourceRef="StartEvent_Annual" targetRef="Task_DraftSchedule" />
    <bpmn:sequenceFlow id="SequenceFlow_CheckSuggest" name="Support Officer Review" sourceRef="Task_DraftSchedule" targetRef="Task_CheckDatesSuggest" />
    <bpmn:sequenceFlow id="SequenceFlow_Recheck" sourceRef="Task_CheckDatesSuggest" targetRef="Gateway_ResolveConflicts" />
    <bpmn:sequenceFlow id="SequenceFlow_SendEmail" name="Send Final Schedule (Email)" sourceRef="Gateway_ResolveConflicts" targetRef="EndEvent_ScheduleFinalized" />

  </bpmn:process>

  <!-- Process for Committee Members -->
  <bpmn:process id="Process_2">
    <bpmn:startEvent id="StartEvent_Members" name="Receive Schedule Email">
      <bpmn:outgoing>SequenceFlow_CheckDiaries</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task -->
    <bpmn:task id="Task_CheckDiariesAdvise" name="Check Diaries & Advise Conflicts">
      <bpmn:incoming>SequenceFlow_CheckDiaries</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AdviseBack</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Members" name="Advice Sent">
      <bpmn:incoming>SequenceFlow_AdviseBack</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckDiaries" sourceRef="StartEvent_Members" targetRef="Task_CheckDiariesAdvise" />
    <bpmn:sequenceFlow id="SequenceFlow_AdviseBack" name="Send Advice to Authority" sourceRef="Task_CheckDiariesAdvise" targetRef="EndEvent_Members" />

  </bpmn:process>

  <!-- Message Flows -->
  <bpmn:messageFlow id="MessageFlow_SendSchedule" sourceRef="Gateway_ResolveConflicts" targetRef="StartEvent_Members">
    <bpmn:name>Email Schedule</bpmn:name>
  </bpmn:messageFlow>

  <bpmn:endEvent id="EndEvent_ScheduleFinalized" name="Schedule Finalized">
    <bpmn:incoming>SequenceFlow_SendEmail</bpmn:incoming>
  </bpmn:endEvent>

</bpmn:definitions>