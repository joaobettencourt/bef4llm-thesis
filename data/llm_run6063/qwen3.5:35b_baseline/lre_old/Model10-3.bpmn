<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Meter Point Management System" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_MPOO" name="MPOO">
        <bpmn:flowNodeRef>StartEvent_Deregistration</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConfirmContinuation</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GO" name="GO">
        <bpmn:flowNodeRef>StartEvent_Deregistration</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VerifyDeregistration</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_InitialDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareReadmission</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ObligationDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EquipmentAcquisition</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssignMPO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformMPOO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformMSPO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformSP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Completed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Deregistration" name="MPOO Deregisters at GO">
      <bpmn:outgoing>SequenceFlow_VerifyDereg</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Verify -->
    <bpmn:task id="Task_VerifyDeregistration" name="Verify Deregistration">
      <bpmn:incoming>SequenceFlow_VerifyDereg</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InitialDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Reject vs Confirm -->
    <bpmn:exclusiveGateway id="Gateway_InitialDecision" name="Reject or Preliminary Confirmation?">
      <bpmn:incoming>SequenceFlow_InitialDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RejectPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ConfirmPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event 1 -->
    <bpmn:endEvent id="EndEvent_Rejected" name="Deregistration Rejected">
      <bpmn:incoming>SequenceFlow_RejectPath</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task: Prepare Readmission -->
    <bpmn:task id="Task_PrepareReadmission" name="Prepare Readmission of Measuring Point">
      <bpmn:incoming>SequenceFlow_ConfirmPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ObligationDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2: Oblige Continuation -->
    <bpmn:exclusiveGateway id="Gateway_ObligationDecision" name="Obliged to Continue Operations?">
      <bpmn:incoming>SequenceFlow_ObligationDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SkipConfirmPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ConfirmRequiredPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Confirm Continuation (MPOO) -->
    <bpmn:task id="Task_ConfirmContinuation" name="Confirm Continuation">
      <bpmn:incoming>SequenceFlow_ConfirmRequiredPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeToEquipment</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Equipment Acquisition -->
    <bpmn:task id="Task_EquipmentAcquisition" name="Perform Equipment Acquisition/Changes">
      <bpmn:incoming>SequenceFlow_SkipConfirmPath</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_MergeToEquipment</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AssignMPO</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Assign MPO -->
    <bpmn:task id="Task_AssignMPO" name="Assign GO as MPO">
      <bpmn:incoming>SequenceFlow_AssignMPO</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InformMPOO</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Inform MPOO -->
    <bpmn:task id="Task_InformMPOO" name="Inform MPOO about Assignment End/Start">
      <bpmn:incoming>SequenceFlow_InformMPOO</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InformMSPO</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Inform MSPO -->
    <bpmn:task id="Task_InformMSPO" name="Inform MSPO about Assignment">
      <bpmn:incoming>SequenceFlow_InformMSPO</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InformSP</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Inform SP -->
    <bpmn:task id="Task_InformSP" name="Inform SP about Assignment">
      <bpmn:incoming>SequenceFlow_InformSP</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FinalEnd</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 2 -->
    <bpmn:endEvent id="EndEvent_Completed" name="Assignment Established">
      <bpmn:incoming>SequenceFlow_FinalEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_VerifyDereg" sourceRef="StartEvent_Deregistration" targetRef="Task_VerifyDeregistration">
      <bpmn:name>Verify Dereg</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Gateway 1 Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_InitialDecision" sourceRef="Task_VerifyDeregistration" targetRef="Gateway_InitialDecision">
      <bpmn:name>Verify Result</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Gateway 1 Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_RejectPath" sourceRef="Gateway_InitialDecision" targetRef="EndEvent_Rejected">
      <bpmn:name>Reject Deregistration</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Gateway 1 Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_ConfirmPath" sourceRef="Gateway_InitialDecision" targetRef="Task_PrepareReadmission">
      <bpmn:name>Preliminary Confirmation</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Gateway 2 Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_ObligationDecision" sourceRef="Task_PrepareReadmission" targetRef="Gateway_ObligationDecision">
      <bpmn:name>Obliged?</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Obligation Decision Paths -->
    <bpmn:sequenceFlow id="SequenceFlow_ConfirmRequiredPath" sourceRef="Gateway_ObligationDecision" targetRef="Task_ConfirmContinuation">
      <bpmn:name>Obliged</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Skip Confirmation Path -->
    <bpmn:sequenceFlow id="SequenceFlow_SkipConfirmPath" sourceRef="Gateway_ObligationDecision" targetRef="Task_EquipmentAcquisition">
      <bpmn:name>No Obligation</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Merge Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_MergeToEquipment" sourceRef="Task_ConfirmContinuation" targetRef="Task_EquipmentAcquisition">
      <bpmn:name>MPOO Confirmed</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Post-Equipment Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_AssignMPO" sourceRef="Task_EquipmentAcquisition" targetRef="Task_AssignMPO">
      <bpmn:name>Equipment Done</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Notification Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_InformMSPO" sourceRef="Task_InformMPOO" targetRef="Task_InformMSPO">
      <bpmn:name>MPOO Informed</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Notification Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_InformSP" sourceRef="Task_InformMSPO" targetRef="Task_InformSP">
      <bpmn:name>MSPO Informed</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Final Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_FinalEnd" sourceRef="Task_InformSP" targetRef="EndEvent_Completed">
      <bpmn:name>All Notified</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>