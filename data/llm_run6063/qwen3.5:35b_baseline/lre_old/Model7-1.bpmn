<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Lead Management Process" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Manager">
        <bpmn:name>Manager</bpmn:name>
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckLeads</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectFive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ProcessLead_Task</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Assistant">
        <bpmn:name>Sales Assistant</bpmn:name>
        <bpmn:flowNodeRef>Task_CallCustomer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Interested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendNote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MoreLeads</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Lead Processing">
      <bpmn:outgoing>SequenceFlow_CheckLeads</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Manager Tasks -->
    <bpmn:task id="Task_CheckLeads" name="Check Open Leads">
      <bpmn:incoming>SequenceFlow_CheckLeads</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SelectFive</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_SelectFive" name="Select Top Five">
      <bpmn:incoming>SequenceFlow_SelectFive</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CallCustomerStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Assistant Tasks -->
    <bpmn:task id="Task_CallCustomer" name="Call Contact Person">
      <bpmn:incoming>SequenceFlow_CallCustomerStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckInterest</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for Interest -->
    <bpmn:exclusiveGateway id="Gateway_Interested" name="Interested?">
      <bpmn:incoming>SequenceFlow_CheckInterest</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendNoteYes</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_MoreLeadsCheck</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task Send Note -->
    <bpmn:task id="Task_SendNote" name="Send Note to Manager">
      <bpmn:incoming>SequenceFlow_SendNoteYes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProcessLeadStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for More Leads -->
    <bpmn:exclusiveGateway id="Gateway_MoreLeads" name="More Leads?">
      <bpmn:incoming>SequenceFlow_MoreLeadsCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CallNextLoop</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Manager Task Process Lead -->
    <bpmn:task id="ProcessLead_Task" name="Process Lead">
      <bpmn:incoming>SequenceFlow_ProcessLeadStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndSuccess</bpmn:outgoing>
    </bpmn:task>

    <!-- End Events -->
    <bpmn:endEvent id="End_Success" name="Lead Processed">
      <bpmn:incoming>SequenceFlow_EndSuccess</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="End_Failed" name="All Leads Checked">
      <bpmn:incoming>SequenceFlow_NoMoreLeads</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckLeads" sourceRef="StartEvent_1" targetRef="Task_CheckLeads" />
    <bpmn:sequenceFlow id="SequenceFlow_SelectFive" name="Select Top Five" sourceRef="Task_CheckLeads" targetRef="Task_SelectFive" />

    <!-- Cross Lane Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_CallCustomerStart" sourceRef="Task_SelectFive" targetRef="Task_CallCustomer" />

    <bpmn:sequenceFlow id="SequenceFlow_CheckInterest" name="Call Complete" sourceRef="Task_CallCustomer" targetRef="Gateway_Interested" />

    <!-- Interest Yes Path -->
    <bpmn:sequenceFlow id="SequenceFlow_SendNoteYes" name="Interested" sourceRef="Gateway_Interested" targetRef="Task_SendNote" />

    <!-- Loop Back Logic (No) -->
    <bpmn:sequenceFlow id="SequenceFlow_MoreLeadsCheck" name="Not Interested" sourceRef="Gateway_Interested" targetRef="Gateway_MoreLeads" />

    <!-- More Leads Yes Path (Loop) -->
    <bpmn:sequenceFlow id="SequenceFlow_CallNextLoop" name="Yes, Call Next" sourceRef="Gateway_MoreLeads" targetRef="Task_CallCustomer" />

    <!-- Process Lead Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_ProcessLeadStart" sourceRef="Task_SendNote" targetRef="ProcessLead_Task" />

    <!-- End Success Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_EndSuccess" name="Processed" sourceRef="ProcessLead_Task" targetRef="End_Success" />

  </bpmn:process>
</bpmn:definitions>