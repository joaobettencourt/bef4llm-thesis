<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_CourtProcess">
    <bpmn:participant id="Participant_CourtAdmin" name="Court Administration Process" processRef="Process_CourtFiles" />
  </bpmn:collaboration>

  <bpmn:process id="Process_CourtFiles" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_AdminStaff" name="Admin Staff">
        <bpmn:flowNodeRef>StartEvent_Morning</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckFilesOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_FilesMissing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_AllReady</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_LegalSupport" name="Legal Support">
        <bpmn:flowNodeRef>ParallelGateway_DistributeLawlist</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HandFilesAssociate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DistributeLawlist</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Morning" name="Morning Check">
      <bpmn:outgoing>SequenceFlow_CheckFiles</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Check Files Order -->
    <bpmn:task id="Task_CheckFilesOrder" name="Check Files for Court Hearing">
      <bpmn:incoming>SequenceFlow_CheckFiles</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FilesMissingDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Are files missing? -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_FilesMissing" name="Files Missing?">
      <bpmn:incoming>SequenceFlow_FilesMissingDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InitiateSearchYes</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Initiate Search -->
    <bpmn:task id="Task_InitiateSearch" name="Initiate File Search">
      <bpmn:incoming>SequenceFlow_InitiateSearchYes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SearchComplete</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Track Files Physically -->
    <bpmn:task id="Task_TrackFilesPhysically" name="Track Files to Location">
      <bpmn:incoming>SequenceFlow_NoMissing</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TrackingComplete</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: All Files Ready -->
    <bpmn:inclusiveGateway id="InclusiveGateway_AllReady" name="Files Ready">
      <bpmn:incoming>SequenceFlow_SearchComplete</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_TrackingComplete</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SplitTasks</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Parallel Gateway for Concurrent Tasks -->
    <bpmn:parallelGateway id="ParallelGateway_DistributeLawlist" name="Concurrent Actions">
      <bpmn:incoming>SequenceFlow_SplitTasks</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_HandFiles</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_DistributeLawlistAction</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Hand Files to Associate -->
    <bpmn:task id="Task_HandFilesAssociate" name="Hand Files to Associate">
      <bpmn:incoming>SequenceFlow_HandFiles</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FilesHanded</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Distribute Lawlist -->
    <bpmn:task id="Task_DistributeLawlist" name="Distribute Judges Lawlist">
      <bpmn:incoming>SequenceFlow_DistributeLawlistAction</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_LawlistDistComplete</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway for Hearings -->
    <bpmn:parallelGateway id="ParallelGateway_Hearings" name="Ready for Hearing">
      <bpmn:incoming>SequenceFlow_FilesHanded</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_LawlistDistComplete</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConductHearings</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Conduct Hearings -->
    <bpmn:task id="Task_CourtHearings" name="Conduct Directions Hearings">
      <bpmn:incoming>SequenceFlow_ConductHearings</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndProcess</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Done" name="Court Hearings Completed">
      <bpmn:incoming>SequenceFlow_EndProcess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckFiles" sourceRef="StartEvent_Morning" targetRef="Task_CheckFilesOrder" />
    <bpmn:sequenceFlow id="SequenceFlow_FilesMissingDecision" name="Yes - Files Missing" sourceRef="ExclusiveGateway_FilesMissing" targetRef="Task_InitiateSearch">
      <bpmn:name>Yes</bpmn:name>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_NoMissing" name="No - Files OK" sourceRef="ExclusiveGateway_FilesMissing" targetRef="Task_TrackFilesPhysically">
      <bpmn:name>No</bpmn:name>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_InitiateSearchYes" name="" sourceRef="Task_CheckFilesOrder" targetRef="ExclusiveGateway_FilesMissing" />
    <bpmn:sequenceFlow id="SequenceFlow_SearchComplete" sourceRef="Task_InitiateSearch" targetRef="InclusiveGateway_AllReady" />
    <bpmn:sequenceFlow id="SequenceFlow_TrackingComplete" sourceRef="Task_TrackFilesPhysically" targetRef="InclusiveGateway_AllReady" />
    <bpmn:sequenceFlow id="SequenceFlow_SplitTasks" sourceRef="InclusiveGateway_AllReady" targetRef="ParallelGateway_DistributeLawlist" />
    <bpmn:sequenceFlow id="SequenceFlow_HandFiles" sourceRef="ParallelGateway_DistributeLawlist" targetRef="Task_HandFilesAssociate" />
    <bpmn:sequenceFlow id="SequenceFlow_DistributeLawlistAction" sourceRef="ParallelGateway_DistributeLawlist" targetRef="Task_DistributeLawlist" />
    <bpmn:sequenceFlow id="SequenceFlow_FilesHanded" sourceRef="Task_HandFilesAssociate" targetRef="ParallelGateway_Hearings" />
    <bpmn:sequenceFlow id="SequenceFlow_LawlistDistComplete" sourceRef="Task_DistributeLawlist" targetRef="ParallelGateway_Hearings" />
    <bpmn:sequenceFlow id="SequenceFlow_ConductHearings" sourceRef="ParallelGateway_Hearings" targetRef="Task_CourtHearings" />
    <bpmn:sequenceFlow id="SequenceFlow_EndProcess" sourceRef="Task_CourtHearings" targetRef="EndEvent_Done" />

  </bpmn:process>
</bpmn:definitions>