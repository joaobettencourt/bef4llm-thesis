<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_GO" name="GO (Government Office)" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:message id="Msg_DeregistrationRequest" name="Deregistration Request"/>

  <bpmn:process id="Process_1" isExecutable="false">
    <!-- Start Event triggered by MSPO deregistering -->
    <bpmn:startEvent id="StartEvent_MSPO_Deregisters" name="MSPO Deregisters at GO">
      <bpmn:messageEventDefinition messageRef="Msg_DeregistrationRequest"/>
      <bpmn:outgoing>SequenceFlow_VerifyDereg</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Verify -->
    <bpmn:task id="Task_GO_Verify" name="Verify Deregistration">
      <bpmn:incoming>SequenceFlow_VerifyDereg</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DecisionPoint</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Reject or Confirm -->
    <bpmn:exclusiveGateway id="Gateway_RejectConfirm" name="Reject or Preliminarily Confirm?">
      <bpmn:incoming>SequenceFlow_DecisionPoint</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RejectPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ConfirmPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_VerifyDereg" sourceRef="StartEvent_MSPO_Deregisters" targetRef="Task_GO_Verify"/>

    <!-- Reject Path End Event -->
    <bpmn:endEvent id="EndEvent_Rejected" name="Deregistration Rejected">
      <bpmn:incoming>SequenceFlow_RejectPath</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow_RejectPath" sourceRef="Gateway_RejectConfirm" targetRef="EndEvent_Rejected"/>

    <!-- Confirm Path Task -->
    <bpmn:task id="Task_GO_AssignSelfMSP" name="Assign Self as MSP">
      <bpmn:incoming>SequenceFlow_ConfirmPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SplitNotifications</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway for Notifications -->
    <bpmn:parallelGateway id="ParallelGateway_Notifications" name="Inform Parties">
      <bpmn:incoming>SequenceFlow_SplitNotifications</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InformMSPO</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_InformMPO</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_InformSP</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Notification Tasks -->
    <bpmn:task id="Task_GO_InformMSPO" name="Inform MSPO (End/Beg Assignment)">
      <bpmn:incoming>SequenceFlow_InformMSPO</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_JoinNotifications_MSPO</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_GO_InformMPO" name="Inform MPO (Assignment)">
      <bpmn:incoming>SequenceFlow_InformMPO</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_JoinNotifications_MPO</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_GO_InformSP" name="Inform SP (Assignment)">
      <bpmn:incoming>SequenceFlow_InformSP</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_JoinNotifications_SP</bpmn:outgoing>
    </bpmn:task>

    <!-- Join Gateway -->
    <bpmn:parallelGateway id="ParallelGateway_End" name="Join Notifications">
      <bpmn:incoming>SequenceFlow_JoinNotifications_MSPO</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_JoinNotifications_MPO</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_JoinNotifications_SP</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Completed</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Completed" name="Assignment Process Completed">
      <bpmn:incoming>SequenceFlow_Completed</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows for Confirm Path and Notifications -->
    <bpmn:sequenceFlow id="SequenceFlow_ConfirmPath" sourceRef="Gateway_RejectConfirm" targetRef="Task_GO_AssignSelfMSP"/>

    <bpmn:sequenceFlow id="SequenceFlow_SplitNotifications" sourceRef="Task_GO_AssignSelfMSP" targetRef="ParallelGateway_Notifications"/>

    <bpmn:sequenceFlow id="SequenceFlow_InformMSPO" name="Inform MSPO" sourceRef="ParallelGateway_Notifications" targetRef="Task_GO_InformMSPO"/>
    <bpmn:sequenceFlow id="SequenceFlow_InformMPO" name="Inform MPO" sourceRef="ParallelGateway_Notifications" targetRef="Task_GO_InformMPO"/>
    <bpmn:sequenceFlow id="SequenceFlow_InformSP" name="Inform SP" sourceRef="ParallelGateway_Notifications" targetRef="Task_GO_InformSP"/>

    <bpmn:sequenceFlow id="SequenceFlow_JoinNotifications_MSPO" sourceRef="Task_GO_InformMSPO" targetRef="ParallelGateway_End"/>
    <bpmn:sequenceFlow id="SequenceFlow_JoinNotifications_MPO" sourceRef="Task_GO_InformMPO" targetRef="ParallelGateway_End"/>
    <bpmn:sequenceFlow id="SequenceFlow_JoinNotifications_SP" sourceRef="Task_GO_InformSP" targetRef="ParallelGateway_End"/>

    <bpmn:sequenceFlow id="SequenceFlow_Completed" sourceRef="ParallelGateway_End" targetRef="EndEvent_Completed"/>
  </bpmn:process>
</bpmn:definitions>