<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                 xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" 
                 xmlns:di="http://www.omg.org/spec/DD/20100524/DI" 
                 xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" 
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 id="Definitions_ZooClubMembership_1" targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:collaboration id="Collaboration_ZooClubMembership">
    <!-- Visitor Pool -->
    <bpmn:participant id="Participant_Visitor" name="Visitor/Member" processRef="Process_1"/>
    
    <!-- ZooClub Department Pool -->
    <bpmn:participant id="Participant_ZooClubDept" name="ZooClub Department" processRef="Process_2">
      <bpmn:laneSet>
        <bpmn:lane id="Lane_Administration" name="Administration"/>
      </bpmn:laneSet>
    </bpmn:participant>

    <!-- Billing Pool -->
    <bpmn:participant id="Participant_BillingDept" name="Billing Department" processRef="Process_3">
      <bpmn:laneSet>
        <bpmn:lane id="Lane_PaymentProcessing" name="Payment Processing"/>
      </bpmn:laneSet>
    </bpmn:participant>

    <!-- Bank Pool -->
    <bpmn:participant id="Participant_Bank" name="Bank" processRef="Process_4">
      <bpmn:laneSet>
        <bpmn:lane id="Lane_PaymentProcessing" name="Payment Processing"/>
      </bpmn:laneSet>
    </bpmn:participant>

    <!-- Marketing Pool -->
    <bpmn:participant id="Participant_MarketingDept" name="Marketing Department" processRef="Process_5">
      <bpmn:laneSet>
        <bpmn:lane id="Lane_Campaigns" name="Campaign Management"/>
      </bpmn:laneSet>
    </bpmn:participant>

  </bpmn:collaboration>

  <!-- Visitor Process -->
  <bpmn:process id="Process_1" name="Visitor Membership Registration">
    <bpmn:startEvent id="Start_Visitor_WantsMembership" name="Wants ZooClub Membership">
      <bpmn:outgoing>bpmn:SequenceFlow_DecideType</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_Visitor_DecideType" name="Decide Membership Type (Individual/Family)">
      <bpmn:incoming>bpmn:SequenceFlow_DecideType</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_InformationPreparation</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_MembershipDecision" name="Membership Type?">
      <bpmn:incoming>bpmn:SequenceFlow_DecideType</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_IndividualPath</bpmn:outgoing>
      <bpmn:outgoing>bpmn:SequenceFlow_FamilyPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Individual Path -->
    <bpmn:task id="Task_Visitor_PrepareIndividualInfo" name="Prepare Personal Information">
      <bpmn:incoming>bpmn:SequenceFlow_IndividualPath</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_SubmitToZooClub</bpmn:outgoing>
    </bpmn:task>

    <!-- Family Path -->
    <bpmn:task id="Task_Visitor_PrepareFamilyInfo" name="Prepare Spouse &amp; Spawn Information">
      <bpmn:incoming>bpmn:SequenceFlow_FamilyPath</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_SubmitToZooClub</bpmn:outgoing>
    </bpmn:task>

    <!-- Convergence -->
    <bpmn:endEvent id="End_Visitor_Home" name="Go Home">
      <bpmn:incoming>bpmn:SequenceFlow_GoHome</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows for Visitor Process -->
    <bpmn:sequenceFlow id="SequenceFlow_DecideType" sourceRef="Start_Visitor_WantsMembership" targetRef="Task_Visitor_DecideType"/>
    <bpmn:sequenceFlow id="SequenceFlow_InformationPreparation" name="Decided Type" sourceRef="Task_Visitor_DecideType" targetRef="Gateway_MembershipDecision"/>
    <bpmn:sequenceFlow id="SequenceFlow_IndividualPath" name="Individual Membership" sourceRef="Gateway_MembershipDecision" targetRef="Task_Visitor_PrepareIndividualInfo"/>
    <bpmn:sequenceFlow id="SequenceFlow_FamilyPath" name="Family Membership" sourceRef="Gateway_MembershipDecision" targetRef="Task_Visitor_PrepareFamilyInfo"/>

  </bpmn:process>

  <!-- ZooClub Department Process -->
  <bpmn:process id="Process_2" name="ZooClub Registration Processing">
    <bpmn:startEvent id="Start_ZooClub_ReceivesRequest" name="Receives Membership Request">
      <bpmn:outgoing>bpmn:SequenceFlow_EnterData</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task to Enter Data -->
    <bpmn:task id="Task_ZooClub_EnterSystemData" name="Enter Personal Data into System">
      <bpmn:incoming>bpmn:SequenceFlow_EnterData</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_SendToBilling</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Split for Billing and Marketing -->
    <bpmn:parallelGateway id="Gateway_ZooClubParallel" name="Split Processing">
      <bpmn:incoming>bpmn:SequenceFlow_EnterData</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_SendToBilling</bpmn:outgoing>
      <bpmn:outgoing>bpmn:SequenceFlow_ForwardToMarketing</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Send to Billing -->
    <bpmn:task id="Task_ZooClub_SendToBilling" name="Send Payment Request to Billing">
      <bpmn:incoming>bpmn:SequenceFlow_SendToBilling</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_WaitForConfirmation</bpmn:outgoing>
    </bpmn:task>

    <!-- Forward to Marketing -->
    <bpmn:task id="Task_ZooClub_ForwardToMarketing" name="Forward Information to Marketing">
      <bpmn:incoming>bpmn:SequenceFlow_ForwardToMarketing</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_WaitForConfirmation</bpmn:outgoing>
    </bpmn:task>

    <!-- Wait for Payment Confirmation -->
    <bpmn:endEvent id="End_ZooClub_Completed" name="Registration Completed">
      <bpmn:incoming>bpmn:SequenceFlow_VisitorReceivesCard</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>

  <!-- Billing Department Process -->
  <bpmn:process id="Process_3" name="Billing Processing">
    <bpmn:startEvent id="Start_Billing_ReceivesRequest" name="Receives Payment Request">
      <bpmn:outgoing>bpmn:SequenceFlow_SendToBank</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Send to Bank -->
    <bpmn:task id="Task_Billing_SendToBank" name="Send Payment Request to Bank">
      <bpmn:incoming>bpmn:SequenceFlow_SendToBank</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_WaitForConfirmation</bpmn:outgoing>
    </bpmn:task>

  </bpmn:process>

  <!-- Bank Process -->
  <bpmn:process id="Process_4" name="Bank Payment Processing">
    <bpmn:startEvent id="Start_Bank_ReceivesRequest" name="Receives Payment Request from Billing">
      <bpmn:outgoing>bpmn:SequenceFlow_ProcessPayment</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Process Payment -->
    <bpmn:task id="Task_Bank_ProcessPayment" name="Process Payment Information &amp; Charge Account">
      <bpmn:incoming>bpmn:SequenceFlow_ProcessPayment</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_SendConfirmationToZooClub</bpmn:outgoing>
    </bpmn:task>

  </bpmn:process>

  <!-- Marketing Department Process -->
  <bpmn:process id="Process_5" name="Marketing Processing">
    <bpmn:startEvent id="Start_Marketing_ReceivesInfo" name="Receives Visitor Information from ZooClub">
      <bpmn:outgoing>bpmn:SequenceFlow_RequestMailing</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Request Magazine Mailing -->
    <bpmn:endEvent id="End_Marketing_Completed" name="Magazine Sent">
      <bpmn:incoming>bpmn:SequenceFlow_RequestMailing</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>

  <!-- Sequence Flows for ZooClub Process -->
  <bpmn:sequenceFlow id="SequenceFlow_EnterData" sourceRef="Start_ZooClub_ReceivesRequest" targetRef="Task_ZooClub_EnterSystemData"/>
  <bpmn:sequenceFlow id="SequenceFlow_SendToBilling" name="Send Payment Request" sourceRef="Gateway_ZooClubParallel" targetRef="Task_ZooClub_SendToBilling"/>
  <bpmn:sequenceFlow id="SequenceFlow_ForwardToMarketing" name="Forward Information to Marketing" sourceRef="Gateway_ZooClubParallel" targetRef="Task_ZooClub_ForwardToMarketing"/>

</bpmn:definitions>