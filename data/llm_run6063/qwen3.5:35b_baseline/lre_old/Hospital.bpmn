<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_ExaminationProcess">
    <bpmn:participant id="Participant_OutpatientDepartment" name="Outpatient Department" processRef="Process_Examination"/>
    <bpmn:participant id="Participant_Lab" name="Laboratory" processRef="Process_LabAnalysis"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Examination" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Patient">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_RiskConsent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PatientSignsInformedConsent</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_OutpatientPhysician">
        <bpmn:flowNodeRef>Task_PhysicianInitialExamination</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_HealthyOrAdditionalExam</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_OutpatientPhysicianAdditional">
        <bpmn:flowNodeRef>Task_PlaceExaminationOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FillRequestForm</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_WardDelegate">
        <bpmn:flowNodeRef>Task_ArrangeAppointmentWithWard</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_WardNurse">
        <bpmn:flowNodeRef>Task_PrepareExaminationAndSampling</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_WardPhysician">
        <bpmn:flowNodeRef>Task_TakeSampleRequested</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_LabPhysician">
        <bpmn:flowNodeRef>InclusiveGateway_ValidateSampleState</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_ValidatesResults</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_MedicalTechnicalAssistant">
        <bpmn:flowNodeRef>Task_PerformAnalysis</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Patient Examined by Outpatient Physician">
      <bpmn:outgoing>SequenceFlow_PhysicianInitialExamination</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Initial Examination Task -->
    <bpmn:task id="Task_PhysicianInitialExamination" name="Physician Examines Patient">
      <bpmn:incoming>SequenceFlow_PhysicianInitialExamination</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_HealthyOrAdditionalExamDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Decision Gateway - Healthy or Additional Exam -->
    <bpmn:exclusiveGateway id="InclusiveGateway_HealthyOrAdditionalExam" name="Patient Healthy?">
      <bpmn:incoming>SequenceFlow_HealthyOrAdditionalExamDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PatientLeavesIfHealthyPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flow - Healthy Path -->
    <bpmn:endEvent id="EndEvent_HealthyPatient" name="Patient Leaves">
      <bpmn:incoming>SequenceFlow_PatientLeavesIfHealthyPath</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task - Patient Signs Informed Consent -->
    <bpmn:task id="Task_PatientSignsInformedConsent" name="Patient Signs Informed Consent">
      <bpmn:incoming>SequenceFlow_RiskConsentDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ArrangeAppointmentWithWardPath</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow - Additional Exam Path -->
    <bpmn:sequenceFlow id="SequenceFlow_AdditionalExamRequired" sourceRef="InclusiveGateway_HealthyOrAdditionalExam" targetRef="Task_PlaceExaminationOrder"/>

    <!-- Task - Place Examination Order -->
    <bpmn:task id="Task_PlaceExaminationOrder" name="Place Examination and Follow-up Treatment Order">
      <bpmn:incoming>SequenceFlow_AdditionalExamRequired</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FillRequestFormPath</bpmn:outgoing>
    </bpmn:task>

    <!-- Task - Fill Request Form -->
    <bpmn:task id="Task_FillRequestForm" name="Fill Out Request Form">
      <bpmn:incoming>SequenceFlow_FillRequestFormPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InformPatientAboutRisksPath</bpmn:outgoing>
    </bpmn:task>

    <!-- Task - Inform Patient About Risks -->
    <bpmn:task id="Task_InformPatientAboutRisks" name="Inform Patient of Potential Risks">
      <bpmn:incoming>SequenceFlow_InformPatientAboutRisksPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RiskConsentDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Decision Gateway - Risk Consent -->
    <bpmn:exclusiveGateway id="InclusiveGateway_RiskConsent" name="Patient Signs Informed Consent?">
      <bpmn:incoming>SequenceFlow_RiskConsentDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ArrangeAppointmentWithWardPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task - Arrange Appointment with Ward -->
    <bpmn:task id="Task_ArrangeAppointmentWithWard" name="Delegate Arranges Appointment">
      <bpmn:incoming>SequenceFlow_ArrangeAppointmentWithWardPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PrepareExaminationAndSamplingPath</bpmn:outgoing>
    </bpmn:task>

    <!-- Task - Prepare Examination and Sampling -->
    <bpmn:task id="Task_PrepareExaminationAndSampling" name="Nurse Prepares Examination and Sampling">
      <bpmn:incoming>SequenceFlow_PrepareExaminationAndSamplingPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TakeSampleRequestedPath</bpmn:outgoing>
    </bpmn:task>

    <!-- Task - Take Sample Requested -->
    <bpmn:task id="Task_TakeSampleRequested" name="Ward Physician Takes Sample">
      <bpmn:incoming>SequenceFlow_TakeSampleRequestedPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendsToLabAndTreatmentPath</bpmn:outgoing>
    </bpmn:task>

    <!-- Task - Send to Lab and Treatment -->
    <bpmn:task id="Task_SendsToLabAndTreatment" name="Send Sample to Lab &amp; Conduct Follow-up Treatment">
      <bpmn:incoming>SequenceFlow_SendsToLabAndTreatmentPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_LabReceivesSamplePath</bpmn:outgoing>
    </bpmn:task>

    <!-- Decision Gateway - Validate Sample State (Lab) -->
    <bpmn:exclusiveGateway id="InclusiveGateway_ValidateSampleState" name="Sample Valid?">
      <bpmn:incoming>SequenceFlow_LabReceivesSamplePath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PerformAnalysisIfValidPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Decision Gateway - Validated Results (Parallel) -->
    <bpmn:exclusiveGateway id="InclusiveGateway_ValidatesResults" name="Analysis Complete?">
      <bpmn:incoming>SequenceFlow_PerformAnalysisIfValidPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MakeDiagnosisAndPrescribeTherapyPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task - Perform Analysis -->
    <bpmn:task id="Task_PerformAnalysis" name="Medical Technical Assistant Performs Analysis">
      <bpmn:incoming>SequenceFlow_PerformAnalysisIfValidPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_LabPhysicianValidatesResultsPath</bpmn:outgoing>
    </bpmn:task>

    <!-- Task - Make Diagnosis and Prescribe Therapy -->
    <bpmn:endEvent id="EndEvent_DiagnosisComplete" name="Diagnosis Complete">
      <bpmn:incoming>SequenceFlow_MakeDiagnosisAndPrescribeTherapyPath</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task - Make Diagnosis and Prescribe Therapy -->
    <bpmn:task id="Task_MakeDiagnosisAndPrescribeTherapy" name="Physician Makes Diagnosis &amp; Prescribes Therapy">
      <bpmn:incoming>SequenceFlow_MakeDiagnosisAndPrescribeTherapyPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DiagnosisCompleteEnd</bpmn:outgoing>
    </bpmn:task>

    <!-- Task - Lab Physician Validates Results -->
    <bpmn:task id="Task_LabPhysicianValidatesResults" name="Lab Physician Validates Analysis Results">
      <bpmn:incoming>SequenceFlow_LabPhysicianValidatesResultsPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MakeDiagnosisAndPrescribeTherapyPath</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_PhysicianInitialExamination" sourceRef="StartEvent_1" targetRef="Task_PhysicianInitialExamination"/>
    <bpmn:sequenceFlow id="SequenceFlow_HealthyOrAdditionalExamDecision" name="Yes - Healthy" sourceRef="Task_PhysicianInitialExamination" targetRef="InclusiveGateway_HealthyOrAdditionalExam"/>
    <bpmn:sequenceFlow id="SequenceFlow_PatientLeavesIfHealthyPath" name="No - Additional Exam Required" sourceRef="InclusiveGateway_HealthyOrAdditionalExam" targetRef="EndEvent_HealthyPatient"/>
    <bpmn:sequenceFlow id="SequenceFlow_FillRequestFormPath" sourceRef="Task_PlaceExaminationOrder" targetRef="Task_FillRequestForm"/>
    <bpmn:sequenceFlow id="SequenceFlow_InformPatientAboutRisksPath" sourceRef="Task_FillRequestForm" targetRef="Task_InformPatientAboutRisks"/>
    <bpmn:sequenceFlow id="SequenceFlow_RiskConsentDecision" name="Yes - Patient Agrees" sourceRef="Task_InformPatientAboutRisks" targetRef="InclusiveGateway_RiskConsent"/>
    <bpmn:sequenceFlow id="SequenceFlow_ArrangeAppointmentWithWardPath" sourceRef="InclusiveGateway_RiskConsent" targetRef="Task_PatientSignsInformedConsent"/>
    <bpmn:sequenceFlow id="SequenceFlow_PrepareExaminationAndSamplingPath" sourceRef="Task_PatientSignsInformedConsent" targetRef="Task_ArrangeAppointmentWithWard"/>
    <bpmn:sequenceFlow id="SequenceFlow_TakeSampleRequestedPath" sourceRef="Task_ArrangeAppointmentWithWard" targetRef="Task_PrepareExaminationAndSampling"/>
    <bpmn:sequenceFlow id="SequenceFlow_SendsToLabAndTreatmentPath" sourceRef="Task_PrepareExaminationAndSampling" targetRef="Task_TakeSampleRequested"/>
    <bpmn:sequenceFlow id="SequenceFlow_LabReceivesSamplePath" sourceRef="Task_TakeSampleRequested" targetRef="InclusiveGateway_ValidateSampleState"/>
    <bpmn:sequenceFlow id="SequenceFlow_PerformAnalysisIfValidPath" name="Yes - Valid Sample" sourceRef="InclusiveGateway_ValidateSampleState" targetRef="Task_PerformAnalysis"/>
    <bpmn:sequenceFlow id="SequenceFlow_LabPhysicianValidatesResultsPath" sourceRef="Task_PerformAnalysis" targetRef="Task_LabPhysicianValidatesResults"/>
    <bpmn:sequenceFlow id="SequenceFlow_MakeDiagnosisAndPrescribeTherapyPath" name="Yes - Analysis Complete" sourceRef="InclusiveGateway_ValidatesResults" targetRef="Task_MakeDiagnosisAndPrescribeTherapy"/>

  </bpmn:process>
</bpmn:definitions>