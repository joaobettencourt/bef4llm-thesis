<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_MPON" name="MPON" processRef="Process_MPON" />
    <bpmn:participant id="Participant_MPOO" name="MPOO" processRef="Process_MPOO" />
    <bpmn:messageFlow id="MessageFlow_DismissalSend" sourceRef="Task_SendDismissal" targetRef="Event_ReceiveDismissal" />
    <bpmn:messageFlow id="MessageFlow_ResultReturn" sourceRef="Task_ConfirmDismissal" targetRef="Event_ReceiveResult_MPON" />
  </bpmn:collaboration>

  <bpmn:process id="Process_MPON">
    <bpmn:startEvent id="StartEvent_MPON" name="Initiate Dismissal Process">
      <bpmn:outgoing>SequenceFlow_SendDismissal</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_SendDismissal" name="Send Dismissal to MPOO">
      <bpmn:incoming>SequenceFlow_SendDismissal</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitResult_MPON</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_MPON" name="Process Completed">
      <bpmn:incoming>SequenceFlow_ReceiveResult_MPON</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:intermediateCatchEvent id="Event_ReceiveResult_MPON" name="Wait for Result">
      <bpmn:outgoing>SequenceFlow_ReceiveResult_MPON</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:sequenceFlow id="SequenceFlow_SendDismissal" sourceRef="StartEvent_MPON" targetRef="Task_SendDismissal" />
    <bpmn:sequenceFlow id="SequenceFlow_WaitResult_MPON" name="Wait for Response" sourceRef="Task_SendDismissal" targetRef="Event_ReceiveResult_MPON" />
  </bpmn:process>

  <bpmn:process id="Process_MPOO">
    <bpmn:startEvent id="StartEvent_MPOO" name="Review Dismissal Request">
      <bpmn:outgoing>SequenceFlow_ReceiveDismissal</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:intermediateCatchEvent id="Event_ReceiveDismissal" name="Receive Dismissal Message">
      <bpmn:incoming>MessageFlow_DismissalSend</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StartReview_MPOO</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:task id="Task_ReviewDismissal" name="Review Dismissal">
      <bpmn:incoming>SequenceFlow_StartReview_MPOO</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DecideOutcome</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_Decision" name="Decision on Dismissal">
      <bpmn:incoming>SequenceFlow_DecideOutcome</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OpposePath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ConfirmPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_OpposeDismissal" name="Oppose Dismissal">
      <bpmn:incoming>SequenceFlow_OpposePath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_End_MPOO_1</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_MPOO_Confirm" name="Dismissal Confirmed">
      <bpmn:incoming>SequenceFlow_End_MPOO_2</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_MPOO_Oppose" name="Dismissal Opposed">
      <bpmn:incoming>SequenceFlow_End_MPOO_1</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:task id="Task_ConfirmDismissal" name="Confirm Dismissal">
      <bpmn:incoming>SequenceFlow_ConfirmPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_End_MPOO_2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_StartReview_MPOO" sourceRef="Event_ReceiveDismissal" targetRef="Task_ReviewDismissal" />
    <bpmn:sequenceFlow id="SequenceFlow_DecideOutcome" name="Decision Point" sourceRef="Task_ReviewDismissal" targetRef="Gateway_Decision" />
    <bpmn:sequenceFlow id="SequenceFlow_OpposePath" name="Opposes Dismissal" sourceRef="Gateway_Decision" targetRef="Task_OpposeDismissal" />
    <bpmn:sequenceFlow id="SequenceFlow_ConfirmPath" name="Confirms Dismissal" sourceRef="Gateway_Decision" targetRef="Task_ConfirmDismissal" />
  </bpmn:process>

</bpmn:definitions>