<?xml version="1.0" encoding="UTF-8"?>  
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_LuxuryAirplane_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_AirplaneManufacturing">
    <bpmn:participant name="Luxury Airplane Manufacturing Company" processRef="Process_LuxuryAirplane_001"/>
  </bpmn:collaboration>

  <bpmn:process isExecutable="false" id="Process_LuxuryAirplane_001">
    <!-- Lane configuration for different teams -->
    <bpmn:laneSet>
      <bpmn:lane name="Customer Service Team">
        <bpmn:flowNodeRef>StartEvent_ReceiveOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_SpecificationsReady</bpmn:flowNodeRef>
      </bpmn:lane>
      
      <bpmn:lane name="Russian Manufacturing Team">
        <bpmn:task id="Task_ManufactureVodkaBar" name="Manufacture Vodka Bar">
          <bpmn:incoming>SequenceFlow_SendToRussia</bpmn:incoming>
          <bpmn:outgoing>SequenceFlow_VodkaReady</bpmn:outgoing>
        </bpmn:task>
      </bpmn:lane>

      <bpmn:lane name="Irish Manufacturing Team">
        <bpmn:task id="Task_ManufactureWhiskeyBar" name="Manufacture Whiskey Bar">
          <bpmn:incoming>SequenceFlow_SendToIreland</bpmn:incoming>
          <bpmn:outgoing>SequenceFlow_WhiskeyReady</bpmn:outgoing>
        </bpmn:task>
      </bpmn:lane>

      <bpmn:lane name="Interior Assembly Team">
        <bpmn:flowNodeRef>ParallelGateway_AssemblyStart</bpmn:flowNodeRef>
        <bpmn:task id="Task_AssembleInterior" name="Assemble Interior Components">
          <bpmn:incoming>SequenceFlow_AssemblyStart</bpmn:incoming>
          <bpmn:outgoing>SequenceFlow_TestFlightReady</bpmn:outgoing>
        </bpmn:task>
      </bpmn:lane>

      <bpmn:lane name="Quality Control Team">
        <bpmn:flowNodeRef>InclusiveGateway_TestFlightStart</bpmn:flowNodeRef>
        <bpmn:task id="Task_ConductTestFlight" name="Conduct Test Flight">
          <bpmn:incoming>SequenceFlow_ConductTestFlight</bpmn:incoming>
          <bpmn:outgoing>SequenceFlow_TestProtocolCreated</bpmn:outgoing>
        </bpmn:task>
      </bpmn:lane>

      <bpmn:lane name="Delivery Team">
        <bpmn:flowNodeRef>InclusiveGateway_DeliveryStart</bpmn:flowNodeRef>
        <bpmn:task id="Task_DeliverToCustomer" name="Deliver Plane to Customer">
          <bpmn:incoming>SequenceFlow_SendToCustomer</bpmn:incoming>
          <bpmn:outgoing>SequenceFlow_CustomerConfirmationRequired</bpmn:outgoing>
        </bpmn:task>
      </bpmn:lane>

      <bpmn:lane name="Customer">
        <bpmn:endEvent id="EndEvent_ConfirmationReceived" name="Order Completed"/>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_ReceiveOrder" name="Receive Customer Specifications">
      <bpmn:outgoing>SequenceFlow_SendRequirements</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Gateway after receiving specifications - split to multiple teams -->
    <bpmn:parallelGateway id="ParallelGateway_SpecificationsReady" name="Send Requirements">
      <bpmn:incoming>SequenceFlow_SendRequirements</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendToRussia</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SendToIreland</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Manufacturing Tasks -->
    <bpmn:task id="Task_ManufactureVodkaBar" name="Manufacture Vodka Bar">
      <bpmn:incoming>SequenceFlow_SendToRussia</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_VodkaReady</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_ManufactureWhiskeyBar" name="Manufacture Whiskey Bar">
      <bpmn:incoming>SequenceFlow_SendToIreland</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WhiskeyReady</bpmn:outgoing>
    </bpmn:task>

    <!-- Assembly Gateway - wait for all parts -->
    <bpmn:parallelGateway id="ParallelGateway_AssemblyStart" name="All Parts Ready">
      <bpmn:incoming>SequenceFlow_VodkaReady</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_WhiskeyReady</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AssemblyStart</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Assembly Task -->
    <bpmn:task id="Task_AssembleInterior" name="Assemble Interior Components">
      <bpmn:incoming>SequenceFlow_AssemblyStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TestFlightReady</bpmn:outgoing>
    </bpmn:task>

    <!-- Test Flight Gateway -->
    <bpmn:inclusiveGateway id="InclusiveGateway_TestFlightStart" name="Test Flight">
      <bpmn:incoming>SequenceFlow_TestFlightReady</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConductTestFlight</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Test Flight Task -->
    <bpmn:task id="Task_ConductTestFlight" name="Conduct Test Flight">
      <bpmn:incoming>SequenceFlow_ConductTestFlight</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TestProtocolCreated</bpmn:outgoing>
    </bpmn:task>

    <!-- Delivery Gateway -->
    <bpmn:inclusiveGateway id="InclusiveGateway_DeliveryStart" name="Delivery">
      <bpmn:incoming>SequenceFlow_TestProtocolCreated</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendToCustomer</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Delivery Task -->
    <bpmn:task id="Task_DeliverToCustomer" name="Deliver Plane to Customer">
      <bpmn:incoming>SequenceFlow_SendToCustomer</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CustomerConfirmationRequired</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_ConfirmationReceived" name="Order Completed">
      <bpmn:incoming>SequenceFlow_OrderConfirmed</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_SendRequirements" sourceRef="StartEvent_ReceiveOrder" targetRef="ParallelGateway_SpecificationsReady"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_SendToRussia" name="Send to Russian Team" sourceRef="ParallelGateway_SpecificationsReady" targetRef="Task_ManufactureVodkaBar"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_SendToIreland" name="Send to Irish Team" sourceRef="ParallelGateway_SpecificationsReady" targetRef="Task_ManufactureWhiskeyBar"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_VodkaReady" sourceRef="Task_ManufactureVodkaBar" targetRef="ParallelGateway_AssemblyStart"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_WhiskeyReady" sourceRef="Task_ManufactureWhiskeyBar" targetRef="ParallelGateway_AssemblyStart"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_AssemblyStart" name="All Parts Received" sourceRef="ParallelGateway_AssemblyStart" targetRef="Task_AssembleInterior"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_TestFlightReady" sourceRef="Task_AssembleInterior" targetRef="InclusiveGateway_TestFlightStart"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ConductTestFlight" name="Begin Test Flight" sourceRef="InclusiveGateway_TestFlightStart" targetRef="Task_ConductTestFlight"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_TestProtocolCreated" name="Create Protocol &amp; Send to Customer" sourceRef="Task_ConductTestFlight" targetRef="InclusiveGateway_DeliveryStart"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_SendToCustomer" sourceRef="InclusiveGateway_DeliveryStart" targetRef="Task_DeliverToCustomer"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_CustomerConfirmationRequired" name="Await Confirmation" sourceRef="Task_DeliverToCustomer" targetRef="EndEvent_ConfirmationReceived"/>

    <!-- Data Objects -->
    <bpmn:dataObjectReference id="Data_Specifications">
      <bpmn:name>Customer Specifications</bpmn:name>
    </bpmn:dataObjectReference>
    
    <bpmn:association sourceRef="StartEvent_ReceiveOrder" targetRef="Data_Specifications"/>

  </bpmn:process>
</bpmn:definitions>