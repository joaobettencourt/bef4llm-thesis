<?xml version="1.0" encoding="UTF-8"?>  
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_WorkLiveAustria_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_ApplicantProcess">
    <bpmn:participant name="Work and Live in Austria Application Process" processRef="Process_ApplicationFlow"/>
  </bpmn:collaboration>

  <bpmn:process isExecutable="false" id="Process_ApplicationFlow">
    
    <!-- LaneSet for logical organization -->
    <bpmn:laneSet>
      <bpmn:lane name="Applicant Preparation">
        <bpmn:flowNodeRef>StartEvent_CheckRequirements</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_SplitPrep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OrganizeAccommodationBank</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ValidateDocs</bpmn:flowNodeRef>
      </bpmn:lane>
      
      <bpmn:lane name="Authority Interaction">
        <bpmn:flowNodeRef>ParallelGateway_MergePrep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DetermineCompetence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitApplication</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DecisionOutcome</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_CheckRequirements" name="Check Requirements">
      <bpmn:outgoing>SequenceFlow_InitiateProcess</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Parallel Split for Accommodation and Visa Prep -->
    <bpmn:parallelGateway id="ParallelGateway_SplitPrep" name="Start Preparation">
      <bpmn:incoming>SequenceFlow_InitiateProcess</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OrganizeAccommodation</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PrepareVisaDocs</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Accommodation and Bank Account -->
    <bpmn:task id="Task_OrganizeAccommodationBank" name="Organize Accommodation &amp; Bank Account (Negotiation)">
      <bpmn:incoming>SequenceFlow_OrganizeAccommodation</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AccomplishedPrep</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Prepare Documents -->
    <bpmn:task id="Task_PrepareDocuments" name="Prepare Required Documentation">
      <bpmn:incoming>SequenceFlow_PrepareVisaDocs</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DocsReadyForCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Document Validation -->
    <bpmn:exclusiveGateway id="Gateway_ValidateDocs" name="Documents Valid?">
      <bpmn:incoming>SequenceFlow_DocsReadyForCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ValidDocsProceed</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_InvalidDocsRevise</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Revise Documents -->
    <bpmn:task id="Task_ReviseDocuments" name="Revise Documentation">
      <bpmn:incoming>SequenceFlow_InvalidDocsRevise</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DocsReadyForCheckLoopback</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Merge -->
    <bpmn:parallelGateway id="ParallelGateway_MergePrep" name="Merge Preparation">
      <bpmn:incoming>SequenceFlow_AccomplishedPrep</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ValidDocsProceed</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StartSubmissionProcess</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Determine Competence -->
    <bpmn:task id="Task_DetermineCompetence" name="Determine Submission Location">
      <bpmn:incoming>SequenceFlow_StartSubmissionProcess</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SubmitToAuthority</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Submit Application -->
    <bpmn:task id="Task_SubmitApplication" name="Submit to Representation Office / Police HQ">
      <bpmn:incoming>SequenceFlow_SubmitToAuthority</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ApplicationReceived</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Decision Outcome -->
    <bpmn:exclusiveGateway id="Gateway_DecisionOutcome" name="Visa Issued?">
      <bpmn:incoming>SequenceFlow_ApplicationReceived</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_VisaApproved</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RejectedOrIncomplete</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event: Approved -->
    <bpmn:endEvent id="EndEvent_VisaIssued" name="Visa Issued">
      <bpmn:incoming>SequenceFlow_VisaApproved</bpmn:incoming>
    </bpmn:endEvent>

    <!-- End Event: Rejected -->
    <bpmn:endEvent id="EndEvent_Rejected" name="Application Failed">
      <bpmn:incoming>SequenceFlow_RejectedOrIncomplete</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows (Attributes sourceRef and targetRef) -->
    
    <!-- Initiation -->
    <bpmn:sequenceFlow id="SequenceFlow_InitiateProcess" name="" sourceRef="StartEvent_CheckRequirements" targetRef="ParallelGateway_SplitPrep"/>

    <!-- Preparation Split -->
    <bpmn:sequenceFlow id="SequenceFlow_OrganizeAccommodation" name="Organize Accommodation/Bank" sourceRef="ParallelGateway_SplitPrep" targetRef="Task_OrganizeAccommodationBank"/>
    <bpmn:sequenceFlow id="SequenceFlow_PrepareVisaDocs" name="Prepare Visa Docs (Passport, Photo, Insurance)" sourceRef="ParallelGateway_SplitPrep" targetRef="Task_PrepareDocuments"/>

    <!-- Document Validation Loop -->
    <bpmn:sequenceFlow id="SequenceFlow_DocsReadyForCheck" name="" sourceRef="Task_PrepareDocuments" targetRef="Gateway_ValidateDocs"/>
    <bpmn:sequenceFlow id="SequenceFlow_ValidDocsProceed" name="Yes - Valid (Passport &gt; 3mo, Insurance OK)" sourceRef="Gateway_ValidateDocs" targetRef="ParallelGateway_MergePrep"/>
    <bpmn:sequenceFlow id="SequenceFlow_InvalidDocsRevise" name="No - Invalid Docs" sourceRef="Gateway_ValidateDocs" targetRef="Task_ReviseDocuments"/>
    <bpmn:sequenceFlow id="SequenceFlow_DocsReadyForCheckLoopback" name="" sourceRef="Task_ReviseDocuments" targetRef="Gateway_ValidateDocs"/>

    <!-- Merge to Submission -->
    <bpmn:sequenceFlow id="SequenceFlow_AccomplishedPrep" name="Accommodation Ready" sourceRef="Task_OrganizeAccommodationBank" targetRef="ParallelGateway_MergePrep"/>
    
    <!-- Competence & Submission Logic -->
    <bpmn:sequenceFlow id="SequenceFlow_StartSubmissionProcess" name="" sourceRef="ParallelGateway_MergePrep" targetRef="Task_DetermineCompetence"/>

    <bpmn:sequenceFlow id="SequenceFlow_SubmitToAuthority" name="" sourceRef="Task_DetermineCompetence" targetRef="Task_SubmitApplication"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ApplicationReceived" name="Submit to BMEIA / Police HQ" sourceRef="Task_SubmitApplication" targetRef="Gateway_DecisionOutcome"/>

    <!-- Final Decision -->
    <bpmn:sequenceFlow id="SequenceFlow_VisaApproved" name="Yes - Approved (Red-White-Rot Card)" sourceRef="Gateway_DecisionOutcome" targetRef="EndEvent_VisaIssued"/>
    <bpmn:sequenceFlow id="SequenceFlow_RejectedOrIncomplete" name="No - Refusal/Insufficient Funds/Evidence" sourceRef="Gateway_DecisionOutcome" targetRef="EndEvent_Rejected"/>

  </bpmn:process>
</bpmn:definitions>