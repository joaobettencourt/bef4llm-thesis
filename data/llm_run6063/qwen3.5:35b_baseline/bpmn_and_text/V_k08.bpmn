<?xml version="1.0" encoding="UTF-8"?>  
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_OnlineShopOrdering" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_OrderProcess">
    <bpmn:participant name="Online Shop System" processRef="Process_CustomerOrdering"/>
  </bpmn:collaboration>

  <bpmn:process isExecutable="false" id="Process_CustomerOrdering">
    
    <!-- Lane for logical grouping -->
    <bpmn:laneSet>
      <bpmn:lane name="Customer &amp; System Interaction">
        <bpmn:flowNodeRef>StartEvent_Login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckCredentials</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_LoginResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ShoppingStopped</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectProduct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AddToCartSave</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_AllProductsSelected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_PaymentAddressSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterPaymentData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateCatchEvent_BankConfirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterShippingAddress</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_CheckBillingDifferent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterBillingAddress</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_MergePaymentShipping</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_OrderFinished</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Login" name="Login to E-Shop">
      <bpmn:outgoing>SequenceFlow_CheckCredentials</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: System Check Credentials -->
    <bpmn:task id="Task_CheckCredentials" name="Check Login Credentials">
      <bpmn:incoming>SequenceFlow_CheckCredentials</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_LoginResult</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Login Successful? -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_LoginResult" name="Login Successful">
      <bpmn:incoming>SequenceFlow_LoginResult</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ShoppingStopped</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_StartProductSelection</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event: Shopping Experience Stops -->
    <bpmn:endEvent id="EndEvent_ShoppingStopped" name="Shopping Experience Stops">
      <bpmn:incoming>SequenceFlow_ShoppingStopped</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task: Select Product (Loop Start) -->
    <bpmn:task id="Task_SelectProduct" name="Select Products">
      <bpmn:incoming>SequenceFlow_LoopBackToSelection</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AddToCartSave</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Add to Cart & Save -->
    <bpmn:task id="Task_AddToCartSave" name="Add Product and Save">
      <bpmn:incoming>SequenceFlow_StartProductSelection</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckAllSelected</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: All Products Selected? -->
    <bpmn:inclusiveGateway id="InclusiveGateway_AllProductsSelected" name="All Products Selected">
      <bpmn:incoming>SequenceFlow_CheckAllSelected</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_LoopBackToSelection</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SplitPaymentAddress</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Parallel Gateway Split -->
    <bpmn:parallelGateway id="ParallelGateway_PaymentAddressSplit" name="Prepare Payment &amp; Shipment">
      <bpmn:incoming>SequenceFlow_SplitPaymentAddress</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EnterPaymentData</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_EnterShippingAddress</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Payment Path -->
    <bpmn:task id="Task_EnterPaymentData" name="Enter Payment Data">
      <bpmn:incoming>SequenceFlow_EnterPaymentData</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitBankConfirm</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Event: Wait for Bank Confirmation -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_BankConfirm" name="Wait Payment Confirmation">
      <bpmn:incoming>SequenceFlow_WaitBankConfirm</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConfirmationComplete</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Address Path -->
    <bpmn:task id="Task_EnterShippingAddress" name="Enter Shipping Address">
      <bpmn:incoming>SequenceFlow_EnterShippingAddress</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckBillingDifferent</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Billing Different? -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_CheckBillingDifferent" name="Shipping != Billing">
      <bpmn:incoming>SequenceFlow_CheckBillingDifferent</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EnterBillingAddressYes</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SkipBillingNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Enter Billing Address -->
    <bpmn:task id="Task_EnterBillingAddress" name="Enter Independent Billing Address">
      <bpmn:incoming>SequenceFlow_EnterBillingAddressYes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BillingComplete</bpmn:outgoing>
    </bpmn:task>

    <!-- Inclusive Gateway Merge -->
    <bpmn:inclusiveGateway id="InclusiveGateway_MergePaymentShipping" name="Merge Payment &amp; Address">
      <bpmn:incoming>SequenceFlow_ConfirmationComplete</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_SkipBillingNo</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_BillingComplete</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FinishOrder</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_OrderFinished" name="Order Finished">
      <bpmn:incoming>SequenceFlow_FinishOrder</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckCredentials" sourceRef="StartEvent_Login" targetRef="Task_CheckCredentials"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_LoginResult" name="Login Result" sourceRef="Task_CheckCredentials" targetRef="ExclusiveGateway_LoginResult"/>

    <bpmn:sequenceFlow id="SequenceFlow_ShoppingStopped" name="No - Stop Experience" sourceRef="ExclusiveGateway_LoginResult" targetRef="EndEvent_ShoppingStopped"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_StartProductSelection" name="Yes - Continue" sourceRef="ExclusiveGateway_LoginResult" targetRef="Task_SelectProduct"/>

    <bpmn:sequenceFlow id="SequenceFlow_AddToCartSave" sourceRef="Task_SelectProduct" targetRef="Task_AddToCartSave"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_CheckAllSelected" name="Check Selections" sourceRef="Task_AddToCartSave" targetRef="InclusiveGateway_AllProductsSelected"/>

    <bpmn:sequenceFlow id="SequenceFlow_LoopBackToSelection" name="No - Select More" sourceRef="InclusiveGateway_AllProductsSelected" targetRef="Task_SelectProduct"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_SplitPaymentAddress" name="Yes - All Selected" sourceRef="InclusiveGateway_AllProductsSelected" targetRef="ParallelGateway_PaymentAddressSplit"/>

    <!-- Payment Path Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_EnterPaymentData" sourceRef="ParallelGateway_PaymentAddressSplit" targetRef="Task_EnterPaymentData"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_WaitBankConfirm" name="Wait Confirmation" sourceRef="Task_EnterPaymentData" targetRef="IntermediateCatchEvent_BankConfirm"/>

    <!-- Address Path Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckBillingDifferent" name="Check Billing Status" sourceRef="Task_EnterShippingAddress" targetRef="ExclusiveGateway_CheckBillingDifferent"/>

    <!-- Billing Decision Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_EnterBillingAddressYes" name="Yes - Enter Billing" sourceRef="ExclusiveGateway_CheckBillingDifferent" targetRef="Task_EnterBillingAddress"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_SkipBillingNo" name="No - Skip Billing" sourceRef="ExclusiveGateway_CheckBillingDifferent" targetRef="InclusiveGateway_MergePaymentShipping"/>

    <!-- Completion Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_BillingComplete" sourceRef="Task_EnterBillingAddress" targetRef="InclusiveGateway_MergePaymentShipping"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ConfirmationComplete" name="Bank Confirmed" sourceRef="IntermediateCatchEvent_BankConfirm" targetRef="InclusiveGateway_MergePaymentShipping"/>

    <!-- Final Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_FinishOrder" sourceRef="InclusiveGateway_MergePaymentShipping" targetRef="EndEvent_OrderFinished"/>

  </bpmn:process>
</bpmn:definitions>