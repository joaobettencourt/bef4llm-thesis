<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="_Collab_WebDesignProcess">
    <bpmn:participant name="Project Team" processRef="_Proc_WebDesign"/>
  </bpmn:collaboration>

  <bpmn:process id="_Proc_WebDesign" isExecutable="false">
    <bpmn:laneSet id="_LaneSets_WD">
      <bpmn:lane name="Web Design Team" id="_Lane_DesignTeam">
        <bpmn:flowNodeRef>_Start_Meeting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Task_HoldMeeting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Gateway_Successful</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_End_Failed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Task_Storyboard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Gateway_Agreed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Split_DevContent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Task_DesignDev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Gateway_ReviewNeeded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Merge_ContentReady</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Task_FinalContent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Join_MainParallel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Task_BuildSite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Gateway_Approved</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane name="Marketing Team" id="_Lane_Marketing">
        <bpmn:flowNodeRef>_Task_ReviewDraft</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent name="Informational Meeting" id="_Start_Meeting">
      <bpmn:outgoing>_Flow_StartToMeeting</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Hold Informational Meeting (Web Design) -->
    <bpmn:task name="Hold Informational Meeting" id="_Task_HoldMeeting">
      <bpmn:incoming>_Flow_StartToMeeting</bpmn:incoming>
      <bpmn:outgoing>_Flow_SuccessCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Meeting Success (Web Design) -->
    <bpmn:exclusiveGateway name="Meeting Successful?" id="_Gateway_Successful">
      <bpmn:incoming>_Flow_SuccessCheck</bpmn:incoming>
      <bpmn:outgoing>_Flow_FailedEnd</bpmn:outgoing>
      <bpmn:outgoing>_Flow_StoryboardStart</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event 1: Process Failed -->
    <bpmn:endEvent name="Process Ended (Meeting Unsuccessful)" id="_End_Failed">
      <bpmn:incoming>_Flow_FailedEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task 2: Create Storyboard (Web Design) -->
    <bpmn:task name="Create Storyboard" id="_Task_Storyboard">
      <bpmn:incoming>_Flow_StoryboardStart</bpmn:incoming>
      <bpmn:outgoing>_Flow_AgreementCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2: Agreement on Storyboard (Web Design) -->
    <bpmn:exclusiveGateway name="Storyboard Agreed?" id="_Gateway_Agreed">
      <bpmn:incoming>_Flow_AgreementCheck</bpmn:incoming>
      <bpmn:outgoing>_Loop_StoryboardBack</bpmn:outgoing>
      <bpmn:outgoing>_Split_DevContentStart</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Parallel Split (Web Design) -->
    <bpmn:parallelGateway name="Parallel Start" id="_Split_DevContent">
      <bpmn:incoming>_Split_DevContentStart</bpmn:incoming>
      <bpmn:outgoing>_Flow_PathDev</bpmn:outgoing>
      <bpmn:outgoing>_Flow_PathDraft</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 3a: Design & Development (Web Design) -->
    <bpmn:task name="Design and Develop Website" id="_Task_DesignDev">
      <bpmn:incoming>_Flow_PathDev</bpmn:incoming>
      <bpmn:outgoing>_Flow_DevCompleteToJoin</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3b: Prepare Initial Content Draft (Web Design) -->
    <bpmn:task name="Prepare Initial Content Draft" id="_Task_ContentDraft">
      <bpmn:incoming>_Flow_PathDraft</bpmn:incoming>
      <bpmn:outgoing>_Flow_ReviewDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 3: Review Needed? (Web Design) -->
    <bpmn:exclusiveGateway name="Content Review Needed?" id="_Gateway_ReviewNeeded">
      <bpmn:incoming>_Flow_ReviewDecision</bpmn:incoming>
      <bpmn:outgoing>_Flow_MarketingReviewPath</bpmn:outgoing>
      <bpmn:outgoing>_Flow_SkipToFinalTask</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 4a: Conduct Review (Marketing) -->
    <bpmn:task name="Conduct Content Review" id="_Task_ReviewDraft">
      <bpmn:incoming>_Flow_MarketingReviewPath</bpmn:incoming>
      <bpmn:outgoing>_Flow_ToMergeContent</bpmn:outgoing>
    </bpmn:task>

    <!-- Merge Point for Review/Skip (Web Design) -->
    <bpmn:exclusiveGateway name="Review Path Merged" id="_Merge_ContentReady">
      <bpmn:incoming>_Flow_ToMergeContent</bpmn:incoming>
      <bpmn:incoming>_Flow_SkipToFinalTask</bpmn:incoming>
      <bpmn:outgoing>_Flow_FinalizeContentStart</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 4b: Create Final Version (Web Design) -->
    <bpmn:task name="Create Final Content" id="_Task_FinalContent">
      <bpmn:incoming>_Flow_FinalizeContentStart</bpmn:incoming>
      <bpmn:outgoing>_Flow_ContentCompleteToJoin</bpmn:outgoing>
    </bpmn:task>

    <!-- Main Parallel Join (Web Design) -->
    <bpmn:parallelGateway name="Wait for Dev & Content" id="_Join_MainParallel">
      <bpmn:incoming>_Flow_DevCompleteToJoin</bpmn:incoming>
      <bpmn:incoming>_Flow_ContentCompleteToJoin</bpmn:incoming>
      <bpmn:outgoing>_Flow_BuildSiteStart</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 5: Build Website & Review (Web Design) -->
    <bpmn:task name="Build and Review Site" id="_Task_BuildSite">
      <bpmn:incoming>_Flow_BuildSiteStart</bpmn:incoming>
      <bpmn:outgoing>_Flow_ApprovalCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 4: Approved? (Web Design) -->
    <bpmn:exclusiveGateway name="Site Approved?" id="_Gateway_Approved">
      <bpmn:incoming>_Flow_ApprovalCheck</bpmn:incoming>
      <bpmn:outgoing>_Loop_BuildBack</bpmn:outgoing>
      <bpmn:outgoing>_Flow_SuccessEnd</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event 2: Process Completed -->
    <bpmn:endEvent name="Process Completed" id="_End_Success">
      <bpmn:incoming>_Flow_SuccessEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows Definition -->
    <bpmn:sequenceFlow sourceRef="_Start_Meeting" targetRef="_Task_HoldMeeting" id="_Flow_StartToMeeting"/>
    
    <bpmn:sequenceFlow name="Proceed" sourceRef="_Task_HoldMeeting" targetRef="_Gateway_Successful" id="_Flow_SuccessCheck"/>

    <bpmn:sequenceFlow name="No (Unsuccessful)" sourceRef="_Gateway_Successful" targetRef="_End_Failed" id="_Flow_FailedEnd"/>

    <bpmn:sequenceFlow sourceRef="_Gateway_Successful" targetRef="_Task_Storyboard" id="_Flow_StoryboardStart"/>

    <bpmn:sequenceFlow name="Agreement Check" sourceRef="_Task_Storyboard" targetRef="_Gateway_Agreed" id="_Flow_AgreementCheck"/>

    <bpmn:sequenceFlow sourceRef="_Gateway_Agreed" targetRef="_Task_Storyboard" id="_Loop_StoryboardBack">
      <bpmn:name>No</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow name="Yes (Agreed)" sourceRef="_Gateway_Agreed" targetRef="_Split_DevContent" id="_Split_DevContentStart"/>

    <bpmn:sequenceFlow name="To Dev" sourceRef="_Split_DevContent" targetRef="_Task_DesignDev" id="_Flow_PathDev"/>

    <bpmn:sequenceFlow sourceRef="_Split_DevContent" targetRef="_Task_ContentDraft" id="_Flow_PathDraft"/>

    <bpmn:sequenceFlow name="Development Complete" sourceRef="_Task_DesignDev" targetRef="_Join_MainParallel" id="_Flow_DevCompleteToJoin"/>

    <bpmn:sequenceFlow sourceRef="_Task_ContentDraft" targetRef="_Gateway_ReviewNeeded" id="_Flow_ReviewDecision">
      <bpmn:name>Content Ready</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow name="Yes (Need Review)" sourceRef="_Gateway_ReviewNeeded" targetRef="_Task_ReviewDraft" id="_Flow_MarketingReviewPath"/>

    <bpmn:sequenceFlow name="After Review" sourceRef="_Task_ReviewDraft" targetRef="_Merge_ContentReady" id="_Flow_ToMergeContent"/>

    <bpmn:sequenceFlow sourceRef="_Gateway_ReviewNeeded" targetRef="_Merge_ContentReady" id="_Flow_SkipToFinalTask">
      <bpmn:name>No</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow name="Finalize Content" sourceRef="_Merge_ContentReady" targetRef="_Task_FinalContent" id="_Flow_FinalizeContentStart"/>

    <bpmn:sequenceFlow name="Content Complete" sourceRef="_Task_FinalContent" targetRef="_Join_MainParallel" id="_Flow_ContentCompleteToJoin"/>

    <bpmn:sequenceFlow sourceRef="_Join_MainParallel" targetRef="_Task_BuildSite" id="_Flow_BuildSiteStart">
      <bpmn:name>Both Ready</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow name="Review Complete" sourceRef="_Task_BuildSite" targetRef="_Gateway_Approved" id="_Flow_ApprovalCheck"/>

    <bpmn:sequenceFlow name="No (Needs Revision)" sourceRef="_Gateway_Approved" targetRef="_Task_BuildSite" id="_Loop_BuildBack">
      <bpmn:name>No</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow name="Yes (Approved)" sourceRef="_Gateway_Approved" targetRef="_End_Success" id="_Flow_SuccessEnd"/>

  </bpmn:process>
</bpmn:definitions>