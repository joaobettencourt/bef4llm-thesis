<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="_Collab_AccountCreation">
    <bpmn:participant name="Account Creation Process" processRef="Process_AccountCreation"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_AccountCreation" isExecutable="false">
    <bpmn:laneSet id="_LaneSets_01">
      <bpmn:lane name="Customer" id="_Lane_Customer">
        <bpmn:flowNodeRef>_StartEvent_VisitWebsite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Task_FillPersonalData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Task_GeneratePDFDocument</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Task_PrintPDF</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane name="Post Office" id="_Lane_PostOffice">
        <bpmn:flowNodeRef>_Task_SendDocumentsToBank</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Task_CheckIdentity</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane name="Bank" id="_Lane_Bank">
        <bpmn:flowNodeRef>_Gateway_DecisionAcceptReject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Task_CheckCustomerData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Task_MailAccountDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Task_MailLetterOfRefusal</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent name="Visit Bank Website" id="_StartEvent_VisitWebsite">
      <bpmn:outgoing>_Flow_FillPersonalData</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Fill Personal Data (Customer) -->
    <bpmn:task name="Fill in Personal Data" id="_Task_FillPersonalData">
      <bpmn:incoming>_Flow_FillPersonalData</bpmn:incoming>
      <bpmn:outgoing>_Flow_GeneratePDFDocument</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: Generate PDF Document (Customer) -->
    <bpmn:task name="Generate PDF with Account Request Information" id="_Task_GeneratePDFDocument">
      <bpmn:incoming>_Flow_GeneratePDFDocument</bpmn:incoming>
      <bpmn:outgoing>_Flow_PrintPDF</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3: Print PDF (Customer) -->
    <bpmn:task name="Print PDF Document" id="_Task_PrintPDF">
      <bpmn:incoming>_Flow_PrintPDF</bpmn:incoming>
      <bpmn:outgoing>_Flow_SendDocumentsToBank</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 4: Send Documents to Bank (Post Office) -->
    <bpmn:task name="Send Documents to Bank" id="_Task_SendDocumentsToBank">
      <bpmn:incoming>_Flow_SendDocumentsToBank</bpmn:incoming>
      <bpmn:outgoing>_Flow_CheckIdentity</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 5: Check Identity (Post Office) -->
    <bpmn:task name="Check Customer Identity" id="_Task_CheckIdentity">
      <bpmn:incoming>_Flow_CheckIdentity</bpmn:incoming>
      <bpmn:outgoing>_Flow_MailAccountToBank</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 6: Mail Account to Bank (Post Office) -->
    <bpmn:task name="Mail Account Documents to Bank" id="_Task_MailAccountToBank">
      <bpmn:incoming>_Flow_MailAccountToBank</bpmn:incoming>
      <bpmn:outgoing>_Flow_CheckCustomerData</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 7: Check Customer Data (Bank Officer) -->
    <bpmn:task name="Check Customer Data" id="_Task_CheckCustomerData">
      <bpmn:incoming>_Flow_CheckCustomerData</bpmn:incoming>
      <bpmn:outgoing>_Flow_DecisionAcceptReject</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Decision Point (Bank Officer) -->
    <bpmn:exclusiveGateway name="Decision on Account Request" id="_Gateway_DecisionAcceptReject">
      <bpmn:incoming>_Flow_DecisionAcceptReject</bpmn:incoming>
      <bpmn:outgoing>_Flow_AcceptPath</bpmn:outgoing>
      <bpmn:outgoing>_Flow_RejectPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 8a: Mail Account Documents (Bank Officer) -->
    <bpmn:task name="Mail Account Documents to Customer" id="_Task_MailAccountDocuments">
      <bpmn:incoming>_Flow_AcceptPath</bpmn:incoming>
      <bpmn:outgoing>_Flow_EndAccepted</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 8b: Mail Letter of Refusal (Bank Officer) -->
    <bpmn:task name="Mail Letter of Refusal to Customer" id="_Task_MailLetterOfRefusal">
      <bpmn:incoming>_Flow_RejectPath</bpmn:incoming>
      <bpmn:outgoing>_Flow_EndRejected</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 1: Account Created (Accepted) -->
    <bpmn:endEvent name="Account Creation Completed" id="_End_Accepted">
      <bpmn:incoming>_Flow_EndAccepted</bpmn:incoming>
    </bpmn:endEvent>

    <!-- End Event 2: Request Rejected -->
    <bpmn:endEvent name="Request Rejected" id="_End_Rejected">
      <bpmn:incoming>_Flow_EndRejected</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows Definition -->
    <bpmn:sequenceFlow sourceRef="_StartEvent_VisitWebsite" targetRef="_Task_FillPersonalData" id="_Flow_FillPersonalData"/>
    
    <bpmn:sequenceFlow sourceRef="_Task_FillPersonalData" targetRef="_Task_GeneratePDFDocument" id="_Flow_GeneratePDFDocument">
      <bpmn:name>Fill Data</bpmn:name>
    </bpmn:sequenceFlow>
    
    <bpmn:sequenceFlow sourceRef="_Task_GeneratePDFDocument" targetRef="_Task_PrintPDF" id="_Flow_PrintPDF"/>

    <!-- Cross-lane flow from Customer to Post Office -->
    <bpmn:sequenceFlow sourceRef="_Task_PrintPDF" targetRef="_Task_SendDocumentsToBank" id="_Flow_SendDocumentsToBank">
      <bpmn:name>Send Documents</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Cross-lane flow from Post Office to Bank -->
    <bpmn:sequenceFlow sourceRef="_Task_CheckIdentity" targetRef="_Task_MailAccountToBank" id="_Flow_CheckIdentity"/>
    
    <bpmn:sequenceFlow sourceRef="_Task_MailAccountToBank" targetRef="_Task_CheckCustomerData" id="_Flow_MailAccountToBank">
      <bpmn:name>Mail to Bank</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Decision Gateway Flows -->
    <bpmn:sequenceFlow sourceRef="_Task_CheckCustomerData" targetRef="_Gateway_DecisionAcceptReject" id="_Flow_DecisionAcceptReject">
      <bpmn:name>Check Data</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Accept Path -->
    <bpmn:sequenceFlow sourceRef="_Gateway_DecisionAcceptReject" targetRef="_Task_MailAccountDocuments" id="_Flow_AcceptPath">
      <bpmn:name>Accepted</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Reject Path -->
    <bpmn:sequenceFlow sourceRef="_Gateway_DecisionAcceptReject" targetRef="_Task_MailLetterOfRefusal" id="_Flow_RejectPath">
      <bpmn:name>Rejected</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- End Event Connections -->
    <bpmn:sequenceFlow sourceRef="_Task_MailAccountDocuments" targetRef="_End_Accepted" id="_Flow_EndAccepted"/>
    
    <bpmn:sequenceFlow sourceRef="_Task_MailLetterOfRefusal" targetRef="_End_Rejected" id="_Flow_EndRejected">
      <bpmn:name>Rejection</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>