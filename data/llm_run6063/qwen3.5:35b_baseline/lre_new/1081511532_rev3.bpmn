<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="_Collab_NewClients">
    <bpmn:participant name="Company Process" processRef="Process_NewClientAcquisition"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_NewClientAcquisition" isExecutable="false">
    <bpmn:laneSet id="_LaneSets_01">
      <bpmn:lane name="Management Team" id="_Lane_Management">
        <bpmn:flowNodeRef>StartEvent_ManagementIndication</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Task_SendDetailedOffer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Gateway_ClientAcceptance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Task_PrepareContract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Task_SignContract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_EndEvent_ContractSigned</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane name="Marketing Team" id="_Lane_Marketing">
        <bpmn:flowNodeRef>_Task_MarketAnalysis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Task_PreparePresentation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Task_SendOffers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_Task_ReportResponses</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent name="Management Indicates Need" id="StartEvent_ManagementIndication">
      <bpmn:outgoing>_Flow_StartToAnalysis</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Marketing Lane Tasks -->
    <bpmn:task name="Perform Market Analysis" id="_Task_MarketAnalysis">
      <bpmn:incoming>_Flow_StartToAnalysis</bpmn:incoming>
      <bpmn:outgoing>_Flow_AnalysisToPresentation</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task name="Prepare Portfolio Presentation" id="_Task_PreparePresentation">
      <bpmn:incoming>_Flow_AnalysisToPresentation</bpmn:incoming>
      <bpmn:outgoing>_Flow_PresentationToOffers</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task name="Send Offers to Potential Clients" id="_Task_SendOffers">
      <bpmn:incoming>_Flow_PresentationToOffers</bpmn:incoming>
      <bpmn:outgoing>_Flow_OffersToReportResponses</bpmn:outgoing>
    </bpmn:task>

    <!-- Handover Task -->
    <bpmn:task name="Inform Management About Responses" id="_Task_ReportResponses">
      <bpmn:incoming>_Flow_OffersToReportResponses</bpmn:incoming>
      <bpmn:outgoing>_Flow_ReportsToNegotiationStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Management Lane Tasks -->
    <bpmn:task name="Send Detailed Offer (Negotiations)" id="_Task_SendDetailedOffer">
      <bpmn:incoming>_Flow_ReportsToNegotiationStart</bpmn:incoming>
      <bpmn:outgoing>_Flow_OfferToDecisionGateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway -->
    <bpmn:exclusiveGateway name="Client Accepts Offer?" id="_Gateway_ClientAcceptance">
      <bpmn:incoming>_Flow_OfferToDecisionGateway</bpmn:incoming>
      <bpmn:outgoing>_Flow_AcceptedPath</bpmn:outgoing>
      <bpmn:outgoing>_Flow_RejectedPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Accepted Path -->
    <bpmn:task name="Prepare Contract" id="_Task_PrepareContract">
      <bpmn:incoming>_Flow_AcceptedPath</bpmn:incoming>
      <bpmn:outgoing>_Flow_ContractToSign</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task name="Sign Contract" id="_Task_SignContract">
      <bpmn:incoming>_Flow_ContractToSign</bpmn:incoming>
      <bpmn:outgoing>_Flow_SignedToEndEvent</bpmn:outgoing>
    </bpmn:task>

    <!-- Rejected Path -->
    <bpmn:task name="Analyze Failure Reason" id="_Task_AnalyzeFailure">
      <bpmn:incoming>_Flow_RejectedPath</bpmn:incoming>
      <bpmn:outgoing>_Flow_AnalysisToEndEvent</bpmn:outgoing>
    </bpmn:task>

    <!-- End Events -->
    <bpmn:endEvent name="Contract Signed" id="_EndEvent_ContractSigned">
      <bpmn:incoming>_Flow_SignedToEndEvent</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent name="Analysis Complete (Improve Future)" id="_EndEvent_AnalysisComplete">
      <bpmn:incoming>_Flow_AnalysisToEndEvent</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow sourceRef="StartEvent_ManagementIndication" targetRef="_Task_MarketAnalysis" id="_Flow_StartToAnalysis"/>

    <bpmn:sequenceFlow sourceRef="_Task_MarketAnalysis" targetRef="_Task_PreparePresentation" id="_Flow_AnalysisToPresentation"/>

    <bpmn:sequenceFlow sourceRef="_Task_PreparePresentation" targetRef="_Task_SendOffers" id="_Flow_PresentationToOffers"/>

    <bpmn:sequenceFlow sourceRef="_Task_SendOffers" targetRef="_Task_ReportResponses" id="_Flow_OffersToReportResponses">
      <bpmn:name>After sending offers</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Cross-Lane Flow -->
    <bpmn:sequenceFlow sourceRef="_Task_ReportResponses" targetRef="_Task_SendDetailedOffer" id="_Flow_ReportsToNegotiationStart"/>

    <bpmn:sequenceFlow sourceRef="_Task_SendDetailedOffer" targetRef="_Gateway_ClientAcceptance" id="_Flow_OfferToDecisionGateway">
      <bpmn:name>After negotiation</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Decision Paths -->
    <bpmn:sequenceFlow sourceRef="_Gateway_ClientAcceptance" targetRef="_Task_PrepareContract" id="_Flow_AcceptedPath">
      <bpmn:name>Yes</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow sourceRef="_Gateway_ClientAcceptance" targetRef="_Task_AnalyzeFailure" id="_Flow_RejectedPath">
      <bpmn:name>No / Failed</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- End Paths -->
    <bpmn:sequenceFlow sourceRef="_Task_PrepareContract" targetRef="_Task_SignContract" id="_Flow_ContractToSign"/>

    <bpmn:sequenceFlow sourceRef="_Task_SignContract" targetRef="_EndEvent_ContractSigned" id="_Flow_SignedToEndEvent">
      <bpmn:name>After signing</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow sourceRef="_Task_AnalyzeFailure" targetRef="_EndEvent_AnalysisComplete" id="_Flow_AnalysisToEndEvent"/>

  </bpmn:process>
</bpmn:definitions>