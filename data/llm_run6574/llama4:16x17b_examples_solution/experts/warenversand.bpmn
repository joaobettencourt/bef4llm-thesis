<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" targetNamespace="http://www.example.com">
  <process id="Process_1" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_0vaxgaa"/>
    <task id="Task_0vaxgaa" name="Versandart klären">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_0vaxgaa" targetRef="ExclusiveGateway_1"/>
    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
      <outgoing>SequenceFlow_4</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_1" targetRef="Task_0e6hvnj">
      <conditionExpression xsi:type="tFormalExpression">${shipmentType == 'Sonderversand'}</conditionExpression>
    </sequenceFlow>
    <task id="Task_0e6hvnj" name="Angebote von 3 Spediteuren einholen">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_5</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_5" sourceRef="Task_0e6hvnj" targetRef="Task_0s79ile"/>
    <task id="Task_0s79ile" name="Spediteur beauftragen">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_6" sourceRef="Task_0s79ile" targetRef="ExclusiveGateway_2"/>
    <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_1" targetRef="Task_0jsoxba">
      <conditionExpression xsi:type="tFormalExpression">${shipmentType == 'normal'}</conditionExpression>
    </sequenceFlow>
    <task id="Task_0jsoxba" name="Paketschein ausfüllen">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_7" sourceRef="Task_0jsoxba" targetRef="InclusiveGateway_1"/>
    <inclusiveGateway id="InclusiveGateway_1">
      <incoming>SequenceFlow_7</incoming>
      <incoming>SequenceFlow_8</incoming>
      <outgoing>SequenceFlow_9</outgoing>
    </inclusiveGateway>
    <sequenceFlow id="SequenceFlow_8" sourceRef="Task_12j0pib" targetRef="InclusiveGateway_1"/>
    <task id="Task_12j0pib" name="Versicherung abschließen">
      <incoming>SequenceFlow_10</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_10" sourceRef="ExclusiveGateway_2" targetRef="Task_12j0pib"/>
    <exclusiveGateway id="ExclusiveGateway_2">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_11</outgoing>
      <outgoing>SequenceFlow_10</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_11" sourceRef="ExclusiveGateway_2" targetRef="InclusiveGateway_1"/>
    <sequenceFlow id="SequenceFlow_9" sourceRef="InclusiveGateway_1" targetRef="ParallelGateway_1"/>
    <parallelGateway id="ParallelGateway_1">
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_12</outgoing>
      <outgoing>SequenceFlow_13</outgoing>
    </parallelGateway>
    <sequenceFlow id="SequenceFlow_12" sourceRef="ParallelGateway_1" targetRef="Task_05ftug5"/>
    <task id="Task_05ftug5" name="Ware verpacken">
      <incoming>SequenceFlow_12</incoming>
      <outgoing>SequenceFlow_14</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_13" sourceRef="ParallelGateway_1" targetRef="Task_0sl26uo"/>
    <task id="Task_0sl26uo" name="Ware bereitstellen">
      <incoming>SequenceFlow_13</incoming>
      <outgoing>SequenceFlow_15</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_14" sourceRef="Task_05ftug5" targetRef="ExclusiveGateway_3"/>
    <exclusiveGateway id="ExclusiveGateway_3">
      <incoming>SequenceFlow_14</incoming>
      <outgoing>SequenceFlow_16</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_15" sourceRef="Task_0sl26uo" targetRef="EndEvent_1"/>
    <endEvent id="EndEvent_1">
      <incoming>SequenceFlow_15</incoming>
    </endEvent>
  </process>
</definitions>