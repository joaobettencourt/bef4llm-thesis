<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" targetNamespace="http://www.example.com">
  <process id="Gesundheitsfoerderungsprogramm" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>
    <task id="Task_1" name="Gesundheits-Check">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
      <outgoing>SequenceFlow_3</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="Task_2"/>
    <task id="Task_2" name="Einweisung in App und Wearables">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_4</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_3" sourceRef="Task_1" targetRef="Task_3"/>
    <task id="Task_3" name="Erstellung Trainings- und Ernährungspläne">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_5</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_4" sourceRef="Task_2" targetRef="ParallelGateway_1"/>
    <sequenceFlow id="SequenceFlow_5" sourceRef="Task_3" targetRef="ParallelGateway_1"/>
    <parallelGateway id="ParallelGateway_1">
      <incoming>SequenceFlow_4</incoming>
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </parallelGateway>
    <sequenceFlow id="SequenceFlow_6" sourceRef="ParallelGateway_1" targetRef="Task_4"/>
    <task id="Task_4" name="Trainingsphase">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_7" sourceRef="Task_4" targetRef="Task_5"/>
    <task id="Task_5" name="Zwischen-Check">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_8" sourceRef="Task_5" targetRef="ExclusiveGateway_1"/>
    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>SequenceFlow_8</incoming>
      <outgoing>SequenceFlow_9</outgoing>
      <outgoing>SequenceFlow_10</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_9" sourceRef="ExclusiveGateway_1" targetRef="Task_6">
      <conditionExpression xsi:type="tFormalExpression">Weiterbildung mit Wearables</conditionExpression>
    </sequenceFlow>
    <task id="Task_6" name="Trainingsphase mit Wearables">
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_11</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_10" sourceRef="ExclusiveGateway_1" targetRef="Task_7">
      <conditionExpression xsi:type="tFormalExpression">Weiterbildung ohne Wearables</conditionExpression>
    </sequenceFlow>
    <task id="Task_7" name="Trainingsphase ohne Wearables">
      <incoming>SequenceFlow_10</incoming>
      <outgoing>SequenceFlow_12</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_11" sourceRef="Task_6" targetRef="Task_8"/>
    <sequenceFlow id="SequenceFlow_12" sourceRef="Task_7" targetRef="Task_8"/>
    <task id="Task_8" name="Abschließender Gesundheits-Check">
      <incoming>SequenceFlow_11</incoming>
      <incoming>SequenceFlow_12</incoming>
      <outgoing>SequenceFlow_13</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_13" sourceRef="Task_8" targetRef="EndEvent_1"/>
    <endEvent id="EndEvent_1">
      <incoming>SequenceFlow_13</incoming>
    </endEvent>
  </process>
</definitions>