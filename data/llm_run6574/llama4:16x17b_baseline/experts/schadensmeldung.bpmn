<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" targetNamespace="http://www.example.com">

  <process id="DamageClaimProcess" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>

    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>

    <task id="Task_1" name="Check Claim Validity">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
      <outgoing>SequenceFlow_3</outgoing>
    </task>

    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_4</outgoing>
      <outgoing>SequenceFlow_5</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="ExclusiveGateway_1">
      <conditionExpression xsi:type="tFormalExpression">claimValid = true</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="SequenceFlow_3" sourceRef="Task_1" targetRef="EndEvent_1">
      <conditionExpression xsi:type="tFormalExpression">claimValid = false</conditionExpression>
    </sequenceFlow>

    <endEvent id="EndEvent_1">
      <incoming>SequenceFlow_3</incoming>
    </endEvent>

    <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_1" targetRef="Task_2"/>

    <task id="Task_2" name="Check Documents for Completeness">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_5" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_2"/>

    <endEvent id="EndEvent_2">
      <incoming>SequenceFlow_5</incoming>
    </endEvent>

    <sequenceFlow id="SequenceFlow_6" sourceRef="Task_2" targetRef="ServiceTask_1"/>

    <serviceTask id="ServiceTask_1" name="Validate Claim Details">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </serviceTask>

    <sequenceFlow id="SequenceFlow_7" sourceRef="ServiceTask_1" targetRef="UserTask_1"/>

    <userTask id="UserTask_1" name="Notify Customer">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </userTask>

    <sequenceFlow id="SequenceFlow_8" sourceRef="UserTask_1" targetRef="EndEvent_3"/>

    <endEvent id="EndEvent_3">
      <incoming>SequenceFlow_8</incoming>
    </endEvent>

  </process>

</definitions>