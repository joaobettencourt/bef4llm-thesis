<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" targetNamespace="http://www.example.com">
  <process id="RestaurantProcess" isExecutable="true">
    <!-- Start Event -->
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>

    <!-- Guest enters the restaurant -->
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>
    <task id="Task_1" name="Guest selects a dish">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </task>

    <!-- Guest orders food -->
    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="Task_2"/>
    <task id="Task_2" name="Guest places order">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
    </task>

    <!-- Staff enters the order into the system and collects payment -->
    <sequenceFlow id="SequenceFlow_3" sourceRef="Task_2" targetRef="Task_3"/>
    <task id="Task_3" name="Staff processes order and payment">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_4</outgoing>
      <outgoing>SequenceFlow_10</outgoing>
    </task>

    <!-- Staff gives guest a pager -->
    <sequenceFlow id="SequenceFlow_4" sourceRef="Task_3" targetRef="Task_4"/>
    <task id="Task_4" name="Staff gives guest a pager">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_5</outgoing>
    </task>

    <!-- Staff informs the cook -->
    <sequenceFlow id="SequenceFlow_5" sourceRef="Task_4" targetRef="Task_5"/>
    <task id="Task_5" name="Staff informs the cook">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </task>

    <!-- Cook prepares food -->
    <sequenceFlow id="SequenceFlow_6" sourceRef="Task_5" targetRef="Task_6"/>
    <task id="Task_6" name="Cook prepares food">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_7</outgoing>
      <outgoing>SequenceFlow_11</outgoing>
    </task>

    <!-- Cook informs staff that food is ready -->
    <sequenceFlow id="SequenceFlow_7" sourceRef="Task_6" targetRef="Task_7"/>
    <task id="Task_7" name="Cook informs staff">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </task>

    <!-- Staff activates pager -->
    <sequenceFlow id="SequenceFlow_8" sourceRef="Task_7" targetRef="Task_8"/>
    <task id="Task_8" name="Staff activates pager">
      <incoming>SequenceFlow_8</incoming>
      <outgoing>SequenceFlow_9</outgoing>
    </task>

    <!-- Guest collects food -->
    <sequenceFlow id="SequenceFlow_9" sourceRef="Task_8" targetRef="EndEvent_1"/>
    <endEvent id="EndEvent_1">
      <incoming>SequenceFlow_9</incoming>
    </endEvent>

    <!-- If guest doesn't react to pager, staff calls them -->
    <sequenceFlow id="SequenceFlow_10" sourceRef="Task_3" targetRef="ExclusiveGateway_1"/>
    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>SequenceFlow_10</incoming>
      <outgoing>SequenceFlow_12</outgoing>
      <outgoing>SequenceFlow_13</outgoing>
    </exclusiveGateway>

    <!-- Staff waits 5 minutes -->
    <sequenceFlow id="SequenceFlow_12" sourceRef="ExclusiveGateway_1" targetRef="Task_9">
      <conditionExpression xsi:type="tFormalExpression">wait 5 minutes</conditionExpression>
    </sequenceFlow>
    <task id="Task_9" name="Staff waits 5 minutes">
      <incoming>SequenceFlow_12</incoming>
      <outgoing>SequenceFlow_14</outgoing>
    </task>

    <!-- Staff calls guest -->
    <sequenceFlow id="SequenceFlow_13" sourceRef="ExclusiveGateway_1" targetRef="Task_10"/>
    <task id="Task_10" name="Staff calls guest">
      <incoming>SequenceFlow_13</incoming>
      <outgoing>SequenceFlow_14</outgoing>
    </task>

    <!-- Repeat process -->
    <sequenceFlow id="SequenceFlow_14" sourceRef="Task_9" targetRef="ExclusiveGateway_1"/>
    <sequenceFlow id="SequenceFlow_11" sourceRef="Task_6" targetRef="Task_7"/>
  </process>
</definitions>