<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Gesundheitsförderung" processRef="Process_1"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_1" name="Gesundheitscoaches">
        <bpmn:flowNodeRef>Task_HealthCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateTrainingPlans</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Teilnehmer">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AppAndWearables</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Programmbeginn">
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_HealthCheck"/>
    <bpmn:task id="Task_HealthCheck" name="Gesundheits-Check">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="Task_HealthCheck" targetRef="Task_AppAndWearables"/>
    <bpmn:task id="Task_AppAndWearables" name="Einweisung in App und Wearables">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="Task_AppAndWearables" targetRef="Task_CreateTrainingPlans"/>
    <bpmn:task id="Task_CreateTrainingPlans" name="Erstellung Trainings- und Ernährungspläne">
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="Task_CreateTrainingPlans" targetRef="Gateway_1"/>
    <bpmn:inclusiveGateway id="Gateway_1">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_6</bpmn.outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:sequenceFlow id="SequenceFlow_5" name="mit Wearables" sourceRef="Gateway_1" targetRef="Task_TrainingWithWearables"/>
    <bpmn:task id="Task_TrainingWithWearables" name="Training mit Wearables">
      <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_7" sourceRef="Task_TrainingWithWearables" targetRef="Gateway_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_6" name="ohne Wearables" sourceRef="Gateway_1" targetRef="Task_TrainingWithoutWearables"/>
    <bpmn:task id="Task_TrainingWithoutWearables" name="Training ohne Wearables">
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_8" sourceRef="Task_TrainingWithoutWearables" targetRef="Gateway_2"/>
    <bpmn:inclusiveGateway id="Gateway_2">
      <bpmn:incoming>SequenceFlow_7</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_8</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_9</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:sequenceFlow id="SequenceFlow_9" sourceRef="Gateway_2" targetRef="EndEvent_1"/>
    <bpmn:endEvent id="EndEvent_1" name="Programmende">
      <bpmn:incoming>SequenceFlow_9</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>