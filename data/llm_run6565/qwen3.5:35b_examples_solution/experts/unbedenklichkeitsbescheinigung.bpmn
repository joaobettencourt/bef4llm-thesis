<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_Unbedenklichkeit">
    <bpmn:participant id="Pool_Sachbearbeitung" name="Bearbeitung Unbedenklichkeitsbescheinigung" processRef="Process_Unbedenklichkeit"></bpmn:participant>
  </bpmn:collaboration>

  <bpmn:process id="Process_Unbedenklichkeit" isExecutable="true">
    
    <!-- Lane Set -->
    <bpmn:laneSet id="LaneSet_01">
      <bpmn:lane id="Lane_Maschinell" name="Maschinelle Bearbeitung">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VorgangErfassen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AbsenderPruefen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PersonImSystemPruefen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MeldezeitraumPruefen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ArbeitgeberRolle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VersicherungszeitenPruefen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BeitragsnachweisePruefen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_KontrollenAbschluss</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Unbedenklich</bpmn:flowNodeRef>
      </bpmn:lane>
      
      <bpmn:lane id="Lane_Manuell" name="Manuelle Bearbeitung">
        <bpmn:flowNodeRef>Task_AnscreibenErstellen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_BescheinigungAusstellung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_UnbedenklichNichtVollstaendig</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Sachbearbeitung" name="Sachbearbeiter">
        <bpmn:flowNodeRef>Task_FallUeberweisen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ZurWeiterBearbeitung</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Anfrage Unbedenklichkeitsbescheinigung">
      <bpmn:messageEventDefinition />
      <bpmn:outgoing>bpmn:SequenceFlow_StartToErfassen</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1 -->
    <bpmn:serviceTask id="Task_VorgangErfassen" name="Vorgang im System erfassen und identifizieren">
      <bpmn:incoming>bpmn:SequenceFlow_StartToErfassen</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_ErfassenZuPruefen</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Task 2 -->
    <bpmn:userTask id="Task_PersonImSystemPruefen" name="Person im System prüfen">
      <bpmn:incoming>bpmn:SequenceFlow_VonGatewayAbsender</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_ZuMeldezeitraum</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task 3 -->
    <bpmn:serviceTask id="Task_MeldezeitraumPruefen" name="Ende des Meldezeitraums prüfen">
      <bpmn:incoming>bpmn:SequenceFlow_ZuMeldezeitraum</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_PruefeRolle</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Task 4 -->
    <bpmn:userTask id="Task_AnscreibenErstellen" name="Anschreiben zur Informationsermittlung erstellen">
      <bpmn:incoming>bpmn:SequenceFlow_NichtArbeitgeber</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_ZuEndeNichtErfuellbar</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task 5 -->
    <bpmn:serviceTask id="Task_VersicherungszeitenPruefen" name="Versicherungszeiten im Beitragsmonat prüfen">
      <bpmn:incoming>bpmn:SequenceFlow_ArbeitgeberRolleVorhanden</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_ZuBeitragsnachweisePruefen</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Task 6 -->
    <bpmn:userTask id="Task_BeitragsnachweisePruefen" name="Anzahl der Beitragsnachweise prüfen">
      <bpmn:incoming>bpmn:SequenceFlow_ZuBeitragsnachweisePruefen</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_BeitraegeUeberpruefung</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task 7 -->
    <bpmn:userTask id="Task_FallUeberweisen" name="Fall zur weiteren Bearbeitung übergeben">
      <bpmn:incoming>bpmn:SequenceFlow_ZuSachbearbeitung</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_UebersichtZuEnde</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task 8 -->
    <bpmn:serviceTask id="Task_BescheinigungAusstellen" name="Unbedenklichkeitsbescheinigung ausstellen">
      <bpmn:incoming>bpmn:SequenceFlow_ZuBescheinigung</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_KontaktHistorieEintrag</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Task 9 -->
    <bpmn:userTask id="Task_BescheinigungMitHinweisAusstellen" name="Bescheinigung mit Hinweis ausstellen">
      <bpmn:incoming>bpmn:SequenceFlow_ZuBescheinigungMitHinweis</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_KontaktHistorieEintrag2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task 10 -->
    <bpmn:serviceTask id="Task_Kontakthistorie" name="Kontakthistorie-Eintrag vornehmen">
      <bpmn:incoming>bpmn:SequenceFlow_KontaktHistorieEintrag</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_ZuEndeUnbedenklich</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Task 11 -->
    <bpmn:userTask id="Task_Kontakthistorie2" name="Kontakthistorie-Eintrag vornehmen">
      <bpmn:incoming>bpmn:SequenceFlow_KontaktHistorieEintrag2</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_ZuEndeNichtVollstaendig</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway 1 -->
    <bpmn:exclusiveGateway id="Gateway_AbsenderPruefen" name="Absender im System?">
      <bpmn:incoming>bpmn:SequenceFlow_ErfassenZuPruefen</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_VonGatewayAbsender</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Gateway 2 -->
    <bpmn:exclusiveGateway id="Gateway_ArbeitgeberRolle" name="Arbeitgeberrolle vorhanden?">
      <bpmn:incoming>bpmn:SequenceFlow_PruefeRolle</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_NichtArbeitgeber</bpmn:outgoing>
      <bpmn:outgoing>bpmn:SequenceFlow_ArbeitgeberRolleVorhanden</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Gateway 3 -->
    <bpmn:inclusiveGateway id="Gateway_KontrollenAbschluss" name="Kontrolle abgeschlossen">
      <bpmn:incoming>bpmn:SequenceFlow_BeitraegeUeberpruefung</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_ZuBewertung</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Gateway 4 -->
    <bpmn:exclusiveGateway id="Gateway_BescheinigungAusstellung" name="Unbedenklichkeit vollständig?">
      <bpmn:incoming>bpmn:SequenceFlow_ZuBewertung</bpmn:incoming>
      <bpmn:outgoing>bpmn:SequenceFlow_ZuBescheinigung</bpmn:outgoing>
      <bpmn:outgoing>bpmn:SequenceFlow_ZuBescheinigungMitHinweis</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event 1 -->
    <bpmn:endEvent id="EndEvent_Unbedenklich" name="Unbedenklichkeit bestätigt">
      <bpmn:incoming>bpmn:SequenceFlow_ZuEndeUnbedenklich</bpmn:incoming>
    </bpmn:endEvent>

    <!-- End Event 2 -->
    <bpmn:endEvent id="EndEvent_UnbedenklichNichtVollstaendig" name="Bescheinigung mit Hinweis">
      <bpmn:incoming>bpmn:SequenceFlow_ZuEndeNichtVollstaendig</bpmn:incoming>
    </bpmn:endEvent>

    <!-- End Event 3 -->
    <bpmn:endEvent id="EndEvent_ZurWeiterBearbeitung" name="Zur weiteren Bearbeitung">
      <bpmn:incoming>bpmn:SequenceFlow_UebersichtZuEnde</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToErfassen" sourceRef="StartEvent_1" targetRef="Task_VorgangErfassen"></bpmn:sequenceFlow>
    
    <bpmn:sequenceFlow id="SequenceFlow_ErfassenZuPruefen" name="Vorgang identifiziert" sourceRef="Task_VorgangErfassen" targetRef="Gateway_AbsenderPruefen"></bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ZuMeldezeitraum" sourceRef="Task_PersonImSystemPruefen" targetRef="Task_MeldezeitraumPruefen"></bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_PruefeRolle" name="Absenderrolle prüfen" sourceRef="Task_MeldezeitraumPruefen" targetRef="Gateway_ArbeitgeberRolle"></bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_NichtArbeitgeber" name="nein - keine Arbeitgeberrolle" sourceRef="Gateway_ArbeitgeberRolle" targetRef="Task_AnscreibenErstellen"></bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ArbeitgeberRolleVorhanden" name="ja - Arbeitgeberrolle vorhanden" sourceRef="Gateway_ArbeitgeberRolle" targetRef="Task_VersicherungszeitenPruefen"></bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ZuBeitragsnachweisePruefen" sourceRef="Task_VersicherungszeitenPruefen" targetRef="Task_BeitragsnachweisePruefen"></bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_BeitraegeUeberpruefung" name="Beitragshöhe prüfen und offene Forderungen ermitteln" sourceRef="Task_BeitragsnachweisePruefen" targetRef="Gateway_KontrollenAbschluss"></bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ZuBewertung" name="Zentrale Bewertung der Unbedenklichkeit" sourceRef="Gateway_KontrollenAbschluss" targetRef="Gateway_BescheinigungAusstellung"></bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_VonGatewayAbsender" name="ja - Person vorhanden" sourceRef="Gateway_AbsenderPruefen" targetRef="Task_PersonImSystemPruefen"></bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ZuBescheinigung" name="ja - vollständig unbedenklich" sourceRef="Gateway_BescheinigungAusstellung" targetRef="Task_BescheinigungAusstellen"></bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ZuBescheinigungMitHinweis" name="nein - offene Beträge vorhanden" sourceRef="Gateway_BescheinigungAusstellung" targetRef="Task_BescheinigungMitHinweisAusstellen"></bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_KontaktHistorieEintrag" sourceRef="Task_BescheinigungAusstellen" targetRef="Task_Kontakthistorie"></bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_KontaktHistorieEintrag2" sourceRef="Task_BescheinigungMitHinweisAusstellen" targetRef="Task_Kontakthistorie2"></bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ZuEndeUnbedenklich" name="Bescheinigung ausgestellt" sourceRef="Task_Kontakthistorie" targetRef="EndEvent_Unbedenklich"></bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ZuEndeNichtVollstaendig" name="Hinweis-Bescheinigung erstellt" sourceRef="Task_Kontakthistorie2" targetRef="EndEvent_UnbedenklichNichtVollstaendig"></bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ZuSachbearbeitung" name="nein - Voraussetzungen nicht erfüllt" sourceRef="Gateway_BescheinigungAusstellung" targetRef="Task_FallUeberweisen"></bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_UebersichtZuEnde" sourceRef="Task_FallUeberweisen" targetRef="EndEvent_ZurWeiterBearbeitung"></bpmn:sequenceFlow>
    
  </bpmn:process>

</bpmn:definitions>