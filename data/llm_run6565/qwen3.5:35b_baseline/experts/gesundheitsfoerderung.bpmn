<?xml version="1.0" encoding="UTF-8"?>  
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_HealthProgram" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="Participant_Organization" name="Betriebliche Gesundheitsförderung" processRef="Process_HealthProg"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_HealthProg" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Participants" name="Teilnehmer">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GesundheitsCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AppEinweisung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WearableEinweisung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_Plans</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TrainingPhase1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_Nutrition</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ZwischenCheckEvent_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_GroupSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TrainingPhase1a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TrainingPhase2</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Coaches" name="Gesundheitscoaches">
        <bpmn:flowNodeRef>PlanErstellung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ZwischenCheckEvent_2</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Nutrition" name="Ernährungsberatung">
        <bpmn:flowNodeRef>Task_Ernaehrungsberatung</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Programmstart">
      <bpmn:outgoing>SequenceFlow_GesundheitsCheck</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Initial Health Check (Participant) -->
    <bpmn:task id="Task_GesundheitsCheck" name="Gesundheits-Check durchführen">
      <bpmn:incoming>SequenceFlow_GesundheitsCheck</bpmn:outgoing>
      <bpmn:outgoing>ParallelGateway_1</bpmn:flowNodeRef>
    </bpmn:task>

    <!-- Parallel Gateway for App and Wearable Training -->
    <bpmn:parallelGateway id="ParallelGateway_1">
      <bpmn:incoming>SequenceFlow_GesundheitsCheck</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_AppTraining</bpmn:flowNodeRef>
      <bpmn:outgoing>SequenceFlow_WearableTraining</bpmn:flowNodeRef>
    </bpmn:parallelGateway>

    <!-- App Training -->
    <bpmn:task id="Task_AppEinweisung" name="App-Einweisung">
      <bpmn:incoming>ParallelGateway_1</bpmn:outgoing>
      <bpmn:outgoing>InclusiveGateway_Plans</bpmn:flowNodeRef>
    </bpmn:task>

    <!-- Wearable Training -->
    <bpmn:task id="Task_WearableEinweisung" name="Wearables-Einweisung">
      <bpmn:incoming>ParallelGateway_1</bpmn:outgoing>
      <bpmn:outgoing>InclusiveGateway_Plans</bpmn:flowNodeRef>
    </bpmn:task>

    <!-- Inclusive Gateway for Plan Creation -->
    <bpmn:inclusiveGateway id="InclusiveGateway_Plans">
      <bpmn:incoming>SequenceFlow_AppTraining</bpmn:outgoing>
      <bpmn:incoming>SequenceFlow_WearableTraining</bpmn:flowNodeRef>
      <bpmn:outgoing>PlanErstellungSeq</bpmn:flowNodeRef>
    </bpmn:inclusiveGateway>

    <!-- Plan Creation -->
    <bpmn:task id="Task_PlanErstellung" name="Trainings- und Ernährungspläne erstellen">
      <bpmn:incoming>InclusiveGateway_Plans</bpmn:flowNodeRef>
      <bpmn:outgoing>SequenceFlow_TrainingPhase1</bpmn:flowNodeRef>
    </bpmn:task>

    <!-- Training Phase 1 -->
    <bpmn:task id="Task_TrainingPhase1" name="Trainingsphase (6 Monate)">
      <bpmn:incoming>SequenceFlow_TrainingPhase1</bpmn:flowNodeRef>
      <bpmn:outgoing>ZwischenCheckSeq2</bpmn:flowNodeRef>
    </bpmn:task>

    <!-- Optional Nutrition Counseling -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_Nutrition">
      <bpmn:incoming>SequenceFlow_TrainingPhase1</bpmn:outgoing>
      <bpmn:outgoing>Task_ErnaehrungsberatungSeq</bpmn:flowNodeRef>
      <bpmn:outgoing>ZwischenCheckSeq2</bpmn:flowNodeRef>
    </bpmn:exclusiveGateway>

    <!-- Nutrition Counseling Task -->
    <bpmn:task id="Task_Ernaehrungsberatung" name="Ernährungsberatung in Anspruch nehmen">
      <bpmn:incoming>ExclusiveGateway_Nutrition</bpmn:flowNodeRef>
      <bpmn:outgoing>ZwischenCheckSeq2</bpmn:flowNodeRef>
    </bpmn:task>

    <!-- Intermediate Check -->
    <bpmn:startEvent id="ZwischenCheckEvent_1" name="Zwischen-Check">
      <bpmn:outgoing>ZwischenCheckSeq2</bpmn:flowNodeRef>
    </bpmn:startEvent>

    <!-- Gateway for Group Split -->
    <bpmn:exclusiveGateway id="Gateway_GroupSplit">
      <bpmn:incoming>ZwischenCheckSeq2</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_TrainingPhase1a</bpmn:flowNodeRef>
      <bpmn:outgoing>SequenceFlow_TrainingPhase2</bpmn:flowNodeRef>
    </bpmn:exclusiveGateway>

    <!-- Training Phase 1a (without wearables) -->
    <bpmn:task id="Task_TrainingPhase1a" name="Eigenständiges Training ohne Wearables">
      <bpmn:incoming>SequenceFlow_TrainingPhase1a</bpmn:flowNodeRef>
      <bpmn:outgoing>EndCheckSeq</bpmn:flowNodeRef>
    </bpmn:task>

    <!-- Training Phase 2 (with wearables) -->
    <bpmn:task id="Task_TrainingPhase2" name="Training mit App und Wearables">
      <bpmn:incoming>SequenceFlow_TrainingPhase2</bpmn:flowNodeRef>
      <bpmn:outgoing>EndCheckSeq</bpmn:flowNodeRef>
    </bpmn:task>

    <!-- Final Health Check -->
    <bpmn:endEvent id="EndEvent_3" name="Abschluss-Check">
      <bpmn:incoming>SequenceFlow_EndCheck</bpmn:outgoing>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_GesundheitsCheck" sourceRef="StartEvent_1" targetRef="Task_GesundheitsCheck"/>
    <bpmn:sequenceFlow id="ParallelGateway_1SeqApp" name="always" sourceRef="ParallelGateway_1" targetRef="Task_AppEinweisung"/>
    <bpmn:sequenceFlow id="SequenceFlow_WearableTraining" name="always" sourceRef="ParallelGateway_1" targetRef="Task_WearableEinweisung"/>
    <bpmn:sequenceFlow id="PlanErstellungSeq" name="always" sourceRef="InclusiveGateway_Plans" targetRef="Task_PlanErstellung"/>
    <bpmn:sequenceFlow id="SequenceFlow_TrainingPhase1" name="immer" sourceRef="Task_PlanErstellung" targetRef="ExclusiveGateway_Nutrition"/>
    <bpmn:sequenceFlow id="ZwischenCheckSeq2" name="always" sourceRef="ExclusiveGateway_Nutrition" targetRef="Gateway_GroupSplit"/>

  </bpmn:process>
</bpmn:definitions>