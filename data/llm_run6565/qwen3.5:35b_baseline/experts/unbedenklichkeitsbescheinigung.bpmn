<?xml version="1.0" encoding="UTF-8"?>  
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_abc">  
  <bpmn:collaboration id="Collab_1">  
    <bpmn:participant id="Participant_A" name="Unbedenklichkeitsbescheinigung Prozess" />  
  </bpmn:collaboration>  

  <bpmn:process id="Process_X">
    
    <!-- Start Event -->
    <bpmn:startEvent id="Start_1" name="Anfrage für Unbedenklichkeitsbescheinigung eingegangen">
      <bpmn:outgoing>SequenceFlow_001</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Ensure traceability -->
    <bpmn:task id="Task_002" name="Vorgang im System nachvollziehbar machen">
      <bpmn:incoming>SequenceFlow_001</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_003</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: Set certificate count to zero -->
    <bpmn:task id="Task_004" name="Anzahl der Bescheinigungen auf null setzen">
      <bpmn:incoming>SequenceFlow_003</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_005</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3: Check sender identity -->
    <bpmn:task id="Task_006" name="Prüfen, von wem die Anfrage stammt">
      <bpmn:incoming>SequenceFlow_005</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_007</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Person exists in system? -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_008" name="Person im System vorhanden">
      <bpmn:incoming>SequenceFlow_007</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_009</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_013</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 4: Check relevant info (end of reporting period) -->
    <bpmn:task id="Task_010" name="Relevante Informationen überprüfen">
      <bpmn:incoming>SequenceFlow_009</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_011</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2: Employer role? -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_012" name="Absender Arbeitgeber-Rolle">
      <bpmn:incoming>SequenceFlow_011</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_014</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_023</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 5: Create letter for more info -->
    <bpmn:task id="Task_016" name="Anschreiben zur Informationsermittlung erstellen">
      <bpmn:incoming>SequenceFlow_023</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_045</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 6: Check insurance periods -->
    <bpmn:task id="Task_017" name="Versicherungszeiten im Beitragsmonat prüfen">
      <bpmn:incoming>SequenceFlow_014</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_018</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 7: Verify contribution proofs -->
    <bpmn:task id="Task_019" name="Anzahl der Beitragsnachweise prüfen">
      <bpmn:incoming>SequenceFlow_018</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_020</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 3: Uncertainties about contribution amount? -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_021" name="Unsicherheiten Beitragshöhe">
      <bpmn:incoming>SequenceFlow_020</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_024</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_031</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 8: Review contribution estimates -->
    <bpmn:task id="Task_024" name="Beitragsschätzungen überprüfen">
      <bpmn:incoming>SequenceFlow_021</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_035</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 9: Check open claims -->
    <bpmn:task id="Task_026" name="Offene Forderungen prüfen">
      <bpmn:incoming>SequenceFlow_031</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_047</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 4: Central assessment -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_028" name="Zentrale Bewertung Unbedenklichkeit">
      <bpmn:incoming>SequenceFlow_035</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_041</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_042</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 10: Issue certificate (full good standing) -->
    <bpmn:task id="Task_037" name="Unbedenklichkeitsbescheinigung ausstellen">
      <bpmn:incoming>SequenceFlow_041</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_052</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 11: Issue certificate (with note) -->
    <bpmn:task id="Task_038" name="Bescheinigung mit Hinweis ausstellen">
      <bpmn:incoming>SequenceFlow_042</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_053</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 12: Contact history entry -->
    <bpmn:task id="Task_048" name="Eintrag in Kontakthistorie vornehmen">
      <bpmn:incoming>SequenceFlow_052</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_061</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 13: Transfer to employee -->
    <bpmn:task id="Task_049" name="Fall an Sachbearbeiter übergeben">
      <bpmn:incoming>SequenceFlow_062</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_071</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 1 -->
    <bpmn:endEvent id="End_059" name="Bescheinigung ausgestellt">
      <bpmn:incoming>SequenceFlow_061</bpmn:incoming>
    </bpmn:endEvent>

    <!-- End Event 2 -->
    <bpmn:endEvent id="End_073" name="Fall zur weiteren Bearbeitung">
      <bpmn:incoming>SequenceFlow_071</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_001" sourceRef="Start_1" targetRef="Task_002" />  
    <bpmn:sequenceFlow id="SequenceFlow_003" sourceRef="Task_002" targetRef="Task_004" />
    <bpmn:sequenceFlow id="SequenceFlow_005" sourceRef="Task_004" targetRef="Task_006" />  
    <bpmn:sequenceFlow id="SequenceFlow_007" sourceRef="Task_006" targetRef="ExclusiveGateway_008" />
    
    <!-- Person exists path -->
    <bpmn:sequenceFlow id="SequenceFlow_009" name="Ja, im System vorhanden" sourceRef="ExclusiveGateway_008" targetRef="Task_010" />  
    <bpmn:sequenceFlow id="SequenceFlow_023" name="Nein, nicht im System" sourceRef="ExclusiveGateway_008" targetRef="Task_049" />

    <!-- Employer role check -->
    <bpmn:sequenceFlow id="SequenceFlow_011" sourceRef="Task_010" targetRef="ExclusiveGateway_012" />  
    <bpmn:sequenceFlow id="SequenceFlow_014" name="Ja, Arbeitgeber-Rolle vorhanden" sourceRef="ExclusiveGateway_012" targetRef="Task_017" />
    
    <!-- Insurance period check -->
    <bpmn:sequenceFlow id="SequenceFlow_018" sourceRef="Task_017" targetRef="Task_019" />  
    <bpmn:sequenceFlow id="SequenceFlow_020" sourceRef="Task_019" targetRef="ExclusiveGateway_021" />
    
    <!-- Contribution uncertainty check -->
    <bpmn:sequenceFlow id="SequenceFlow_024" name="Ja, Unsicherheiten vorhanden" sourceRef="ExclusiveGateway_021" targetRef="Task_026" />  
    <bpmn:sequenceFlow id="SequenceFlow_031" name="Nein, keine Unsicherheiten" sourceRef="ExclusiveGateway_021" targetRef="ExclusiveGateway_028" />
    
    <!-- Merge paths -->
    <bpmn:sequenceFlow id="SequenceFlow_047" sourceRef="Task_026" targetRef="ExclusiveGateway_028" />  
    <bpmn:sequenceFlow id="SequenceFlow_035" name="Ja, vollständige Unbedenklichkeit" sourceRef="ExclusiveGateway_021" targetRef="ExclusiveGateway_028" />
    
    <!-- Certificate issuance -->
    <bpmn:sequenceFlow id="SequenceFlow_041" sourceRef="ExclusiveGateway_028" name="Ja, vollständige Unbedenklichkeit" targetRef="Task_037" />  
    <bpmn:sequenceFlow id="SequenceFlow_042" sourceRef="ExclusiveGateway_028" name="Nein, offene Beträge vorhanden" targetRef="Task_038" />  
    
    <!-- Contact history -->
    <bpmn:sequenceFlow id="SequenceFlow_052" sourceRef="Task_037" targetRef="Task_048" />  
    <bpmn:sequenceFlow id="SequenceFlow_061" name="Bescheinigung ausgestellt" sourceRef="Task_048" targetRef="End_059" />
    
    <!-- End events -->
    <bpmn:sequenceFlow id="SequenceFlow_071" name="Fall zur Bearbeitung" sourceRef="Task_049" targetRef="End_073" />  
  </bpmn:process>  

</bpmn:definitions>