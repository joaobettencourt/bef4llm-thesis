<?xml version="1.0" encoding="UTF-8"?>  
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Restaurant">  
  <bpmn:collaboration id="Collab_Restaurant_1">  
    <bpmn:participant id="Participant_MainProcess" name="Restaurant Process" processRef="Process_BusinessMain" />  
  </bpmn:collaboration>  

  <bpmn:process id="Process_BusinessMain">  
    <bpmn:laneSet>  
      <bpmn:lane id="Lane_Guest_1" name="Gast (Guest)">  
        <bpmn:flowNodeRef>StartEvent_Enter</bpmn:flowNodeRef>  
        <bpmn:flowNodeRef>UserTask_SelectDish</bpmn:flowNodeRef>  
        <bpmn:flowNodeRef>UserTask_WaitForOrder</bpmn:flowNodeRef>  
        <bpmn:flowNodeRef>Event_PagerReady_1</bpmn:flowNodeRef>  
      </bpmn:lane>  

      <bpmn:lane id="Lane_Staff_1" name="Angestellter (Staff)">  
        <bpmn:flowNodeRef>UserTask_PlaceOrder</bpmn:flowNodeRef>  
        <bpmn:flowNodeRef>UserTask_EnterCashRegister</bpmn:flowNodeRef>  
        <bpmn:flowNodeRef>UserTask_SetPager</bpmn:flowNodeRef>  
        <bpmn:flowNodeRef>UserTask_GivePagerToGuest</bpmn:flowNodeRef>  
        <bpmn:flowNodeRef>UserTask_InformCook</bpmn:flowNodeRef>  
        <bpmn:flowNodeRef>Gateway_PagerReady_1</bpmn:flowNodeRef>  
        <bpmn:flowNodeRef>UserTask_TriggerPager</bpmn:flowNodeRef>  
      </bpmn:lane>  

      <bpmn:lane id="Lane_Cook_1" name="Koch (Cook)">  
        <bpmn:flowNodeRef>StartEvent_CookOrderReceived</bpmn:flowNodeRef>  
        <bpmn:flowNodeRef>UserTask_PrepareMeal</bpmn:flowNodeRef>  
        <bpmn:flowNodeRef>UserTask_PlaceInPassThrough</bpmn:flowNodeRef>  
      </bpmn:lane>  

      <bpmn:lane id="Lane_End_1" name="End Events">  
        <bpmn:flowNodeRef>UserTask_ConsumeMeal</bpmn:flowNodeRef>  
        <bpmn:flowNodeRef>Event_MealConsumed</bpmn:flowNodeRef>  
      </bpmn:lane>  
    </bpmn:laneSet>  

    <!-- Guest Lane Elements -->  
    <bpmn:startEvent id="StartEvent_Enter" name="Gast betritt Restaurant">  
      <bpmn:outgoing>SequenceFlow_SelectDish</bpmn:outgoing>  
    </bpmn:startEvent>  

    <bpmn:userTask id="UserTask_SelectDish" name="Gericht auswählen aus Angebot">  
      <bpmn:incoming>SequenceFlow_SelectDish</bpmn:incoming>  
      <bpmn:outgoing>SequenceFlow_WaitForOrder_1</bpmn:outgoing>  
    </bpmn:userTask>  

    <bpmn:userTask id="UserTask_WaitForOrder" name="Auf Bestellung warten">  
      <bpmn:incoming>SequenceFlow_WaitForOrder_1</bpmn:incoming>  
      <bpmn:outgoing>SequenceFlow_PlaceOrder_1</bpmn:outgoing>  
    </bpmn:userTask>  

    <!-- Staff Lane Elements -->  
    <bpmn:userTask id="UserTask_PlaceOrder" name="Bestellung beim Angestellten aufgeben">  
      <bpmn:incoming>SequenceFlow_PlaceOrder_1</bpmn:incoming>  
      <bpmn:outgoing>SequenceFlow_EnterCashRegister_1</bpmn:outgoing>  
    </bpmn:userTask>  

    <bpmn:task id="UserTask_EnterCashRegister" name="Bestellung in Kassensystem eingeben und Geld kassieren">  
      <bpmn:incoming>SequenceFlow_EnterCashRegister_1</bpmn:incoming>  
      <bpmn:outgoing>SequenceFlow_SetPager_1</bpmn:outgoing>  
    </bpmn:task>  

    <bpmn:userTask id="UserTask_SetPager" name="Pieper einstellen">  
      <bpmn:incoming>SequenceFlow_SetPager_1</bpmn:incoming>  
      <bpmn:outgoing>SequenceFlow_GivePagerToGuest_1</bpmn:outgoing>  
    </bpmn:userTask>  

    <bpmn:userTask id="UserTask_GivePagerToGuest" name="Pieper mit Hinweis übergeben">  
      <bpmn:incoming>SequenceFlow_GivePagerToGuest_1</bpmn:incoming>  
      <bpmn:outgoing>SequenceFlow_InformCook_1</bpmn:outgoing>  
    </bpmn:userTask>  

    <bpmn:userTask id="UserTask_InformCook" name="Koch über Mahlzeit informieren">  
      <bpmn:incoming>SequenceFlow_InformCook_1</bpmn:incoming>  
      <bpmn:outgoing>SequenceFlow_CookReceiveOrder_1</bpmn:outgoing>  
    </bpmn:userTask>  

    <!-- Cook Lane Elements -->  
    <bpmn:startEvent id="StartEvent_CookOrderReceived" name="Bestellung erhalten">  
      <bpmn:incoming>SequenceFlow_CookReceiveOrder_1</bpmn:incoming>  
      <bpmn:outgoing>SequenceFlow_PrepareMeal_1</bpmn:outgoing>  
    </bpmn:startEvent>  

    <bpmn:userTask id="UserTask_PrepareMeal" name="Mahlzeit zubereiten">  
      <bpmn:incoming>SequenceFlow_PrepareMeal_1</bpmn:incoming>  
      <bpmn:outgoing>SequenceFlow_PlaceInPassThrough_1</bpmn:outgoing>  
    </bpmn:userTask>  

    <bpmn:task id="UserTask_PlaceInPassThrough" name="Mahlzeit in Durchreiche stellen">  
      <bpmn:incoming>SequenceFlow_PlaceInPassThrough_1</bpmn:incoming>  
      <bpmn:outgoing>SequenceFlow_MealReadyNotify_1</bpmn:outgoing>  
    </bpmn:task>  

    <!-- Gateway Elements -->  
    <bpmn:exclusiveGateway id="Gateway_PagerReady_1" name="Essen fertig?">  
      <bpmn:incoming>SequenceFlow_MealReadyNotify_1</bpmn:incoming>  
      <bpmn:outgoing>SequenceFlow_TriggerPagerTask_1</bpmn:outgoing>  
    </bpmn:exclusiveGateway>  

    <!-- End Events -->  
    <bpmn:userTask id="UserTask_ConsumeMeal" name="Mahlzeit verzehren">  
      <bpmn:incoming>SequenceFlow_GuestResponds_1</bpmn:incoming>  
      <bpmn:outgoing>SequenceFlow_MealConsumed_1</bpmn:outgoing>  
    </bpmn:userTask>  

    <bpmn:endEvent id="EndEvent_Consume" name="Mahlzeit verzehrt">  
      <bpmn:incoming>SequenceFlow_MealConsumed_1</bpmn:incoming>  
    </bpmn:endEvent>  

    <!-- Sequence Flows -->  
    <bpmn:sequenceFlow id="SequenceFlow_SelectDish" sourceRef="StartEvent_Enter" targetRef="UserTask_SelectDish" />  
    <bpmn:sequenceFlow id="SequenceFlow_WaitForOrder_1" sourceRef="UserTask_SelectDish" targetRef="UserTask_WaitForOrder" />  
    <bpmn:sequenceFlow id="SequenceFlow_PlaceOrder_1" name="Bestellung aufgeben" sourceRef="UserTask_WaitForOrder" targetRef="UserTask_PlaceOrder" />  
    <bpmn:sequenceFlow id="SequenceFlow_EnterCashRegister_1" sourceRef="UserTask_PlaceOrder" targetRef="UserTask_EnterCashRegister" />  
    <bpmn:sequenceFlow id="SequenceFlow_SetPager_1" name="Pieper einstellen" sourceRef="UserTask_EnterCashRegister" targetRef="UserTask_SetPager" />  
    <bpmn:sequenceFlow id="SequenceFlow_GivePagerToGuest_1" name="Pieper übergeben mit Hinweis" sourceRef="UserTask_SetPager" targetRef="UserTask_GivePagerToGuest" />  
    <bpmn:sequenceFlow id="SequenceFlow_InformCook_1" sourceRef="UserTask_GivePagerToGuest" targetRef="UserTask_InformCook" />  
    <bpmn:sequenceFlow id="SequenceFlow_CookReceiveOrder_1" name="Bestellung erhalten" sourceRef="UserTask_InformCook" targetRef="StartEvent_CookOrderReceived" />  
    <bpmn:sequenceFlow id="SequenceFlow_PrepareMeal_1" sourceRef="StartEvent_CookOrderReceived" targetRef="UserTask_PrepareMeal" />  
    <bpmn:sequenceFlow id="SequenceFlow_PlaceInPassThrough_1" name="Mahlzeit in Durchreiche stellen" sourceRef="UserTask_PrepareMeal" targetRef="UserTask_PlaceInPassThrough" />  
    <bpmn:sequenceFlow id="SequenceFlow_MealReadyNotify_1" name="Koch informiert Angestellten" sourceRef="UserTask_PlaceInPassThrough" targetRef="Gateway_PagerReady_1" />  

    <!-- Pager Trigger Flow -->  
    <bpmn:userTask id="UserTask_TriggerPager" name="Pieper des Gastes auslösen">  
      <bpmn:incoming>SequenceFlow_MealReadyNotify_1</bpmn:incoming>  
      <bpmn:outgoing>SequenceFlow_PagerTriggered_1</bpmn:outgoing>  
    </bpmn:userTask>  

    <!-- Guest Response Flow -->  
    <bpmn:startEvent id="StartEvent_GuestNotified" name="Pieper meldet sich">  
      <bpmn:incoming>SequenceFlow_PagerTriggered_1</bpmn:incoming>  
      <bpmn:outgoing>SequenceFlow_NoResponseCheck_1</bpmn:outgoing>  
    </bpmn:startEvent>  

    <!-- No Response Check -->  
    <bpmn:userTask id="UserTask_CallGuestAfter5Min" name="Gast nach 5 Minuten rufen">  
      <bpmn:incoming>SequenceFlow_NoResponseCheck_1</bpmn:incoming>  
      <bpmn:outgoing>SequenceFlow_PagerTriggered_2</bpmn:outgoing>  
    </bpmn:userTask>  

    <!-- Additional Sequence Flows -->  
    <bpmn:sequenceFlow id="SequenceFlow_GuestResponds_1" name="Ja, Gast reagiert" sourceRef="StartEvent_GuestNotified" targetRef="UserTask_ConsumeMeal">  
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[true]]></bpmn:conditionExpression>  
    </bpmn:sequenceFlow>  

    <!-- No Response Flow -->  
    <bpmn:exclusiveGateway id="Gateway_NoResponse_1" name="Reagiert Gast auf Pieper?">  
      <bpmn:incoming>SequenceFlow_PagerTriggered_2</bpmn:incoming>  
      <bpmn:outgoing>SequenceFlow_GuestResponds_2</bpmn:outgoing>  
    </bpmn:exclusiveGateway>  

    <!-- Trigger Pager Task Connection -->  
    <bpmn:sequenceFlow id="SequenceFlow_TriggerPagerTask_1" sourceRef="Gateway_PagerReady_1" targetRef="UserTask_TriggerPager" />  

    <!-- Additional Sequence Flows for Guest Response -->  
    <bpmn:sequenceFlow id="SequenceFlow_MealConsumed_1" sourceRef="UserTask_ConsumeMeal" targetRef="EndEvent_Consume" />  
    <bpmn:sequenceFlow id="SequenceFlow_PagerTriggered_1" name="Pieper aktiviert" sourceRef="Gateway_NoResponse_1" targetRef="StartEvent_GuestNotified">  
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[true]]></bpmn:conditionExpression>  
    </bpmn:sequenceFlow>  

    <!-- No Response Check Flow -->  
    <bpmn:exclusiveGateway id="Gateway_NoResponseCheck_1" name="Reagiert Gast nach 5 Min?">  
      <bpmn:incoming>SequenceFlow_PagerTriggered_2</bpmn:incoming>  
      <bpmn:outgoing>SequenceFlow_GuestResponds_3</bpmn:outgoing>  
    </bpmn:exclusiveGateway>  

    <!-- Additional Sequence Flows -->  
    <bpmn:sequenceFlow id="SequenceFlow_NoResponseCheck_1" name="Nein, keine Reaktion nach 5 Min." sourceRef="StartEvent_GuestNotified" targetRef="UserTask_CallGuestAfter5Min">  
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[true]]></bpmn:conditionExpression>  
    </bpmn:sequenceFlow>  

  </bpmn:process>  
</bpmn:definitions>