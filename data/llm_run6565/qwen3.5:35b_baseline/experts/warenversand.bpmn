<?xml version="1.0" encoding="UTF-8"?>  
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_abc">  
  <bpmn:collaboration id="Collab_1">  
    <bpmn:participant id="Participant_A" name="Computer Hardware Shop Shipping Process">  
      <bpmn:process id="Process_X" />  
    </bpmn:participant>  
  </bpmn:collaboration>  

  <bpmn:process id="Process_X">  
    <bpmn:laneSet>  
      <bpmn:lane id="Lane_Secretary" name="Secretary (Sekretariat)">  
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>  
        <bpmn:flowNodeRef>XGateway_LargeSmall</bpmn:flowNodeRef>  
        <bpmn:flowNodeRef>Task_GetOffers</bpmn:flowNodeRef>  
        <bpmn:flowNodeRef>Task_SelectOffer</bpmn:flowNodeRef>  
        <bpmn:flowNodeRef>Task_FillPackageForm</bpmn:flowNodeRef>  
      </bpmn:lane>  

      <bpmn:lane id="Lane_Logistics" name="Logistics Manager (Logistikleiter)">  
        <bpmn:flowNodeRef>XGateway_InsuranceCheck</bpmn:flowNodeRef>  
        <bpmn:flowNodeRef>Task_ArrangeInsurance</bpmn:flowNodeRef>  
      </bpmn:lane>  

      <bpmn:lane id="Lane_Warehouse" name="Warehouse Worker (Lagerarbeiter)">  
        <bpmn:flowNodeRef>XGateway_PackStart</bpmn:flowNodeRef>  
        <bpmn:flowNodeRef>Task_PackGoods</bpmn:flowNodeRef>  
        <bpmn:flowNodeRef>XGateway_MakeAvailable</bpmn:flowNodeRef>  
      </bpmn:lane>  

      <bpmn:lane id="Lane_FreightForwarder" name="Freight Forwarders (Spediteure)">  
        <bpmn:flowNodeRef>Task_OrderCarrier</bpmn:flowNodeRef>  
      </bpmn:lane>  
    </bpmn:laneSet>  

    <!-- Start Event -->  
    <bpmn:startEvent id="StartEvent_1" name="Ware soll versendet werden">  
      <bpmn:outgoing>SequenceFlow_StartToGateway</bpmn:outgoing>  
    </bpmn:startEvent>  

    <!-- Decision Gateway for Large vs Small Quantity -->  
    <bpmn:exclusiveGateway id="XGateway_LargeSmall" name="Große oder kleine Menge?">  
      <bpmn:incoming>SequenceFlow_StartToGateway</bpmn:incoming>  
      <bpmn:outgoing>SequenceFlow_ToLargeQuantity</bpmn:outgoing>  
      <bpmn:outgoing>SequenceFlow_ToSmallQuantity</bpmn:outgoing>  
    </bpmn:exclusiveGateway>  

    <!-- Large Quantity Path -->  
    <bpmn:task id="Task_GetOffers" name="Angebote von 3 Spediteuren einholen">  
      <bpmn:incoming>SequenceFlow_ToLargeQuantity</bpmn:incoming>  
      <bpmn:outgoing>SequenceFlow_SelectOffer</bpmn:outgoing>  
    </bpmn:task>  

    <bpmn:task id="Task_SelectOffer" name="Angebot auswählen">  
      <bpmn:incoming>SequenceFlow_SelectOffer</bpmn:incoming>  
      <bpmn:outgoing>SequenceFlow_OrderCarrier</bpmn:outgoing>  
    </bpmn:task>  

    <!-- Small Quantity Path -->  
    <bpmn:exclusiveGateway id="XGateway_InsuranceCheck" name="Versicherung erforderlich?">  
      <bpmn:incoming>SequenceFlow_ToSmallQuantity</bpmn:incoming>  
      <bpmn:outgoing>SequenceFlow_ArrangeInsurance</bpmn:outgoing>  
      <bpmn:outgoing>SequenceFlow_SkipInsurance</bpmn:outgoing>  
    </bpmn:exclusiveGateway>  

    <!-- Parallel Gateway for Packing and Insurance -->  
    <bpmn:parallelGateway id="XGateway_PackStart" name="Parallel Vorbereitungen">  
      <bpmn:incoming>SequenceFlow_SkipInsurance</bpmn:incoming>  
      <bpmn:outgoing>SequenceFlow_ToPackStart</bpmn:outgoing>  
    </bpmn:parallelGateway>  

    <!-- Insurance Task -->  
    <bpmn:task id="Task_ArrangeInsurance" name="Versicherung abschließen">  
      <bpmn:incoming>SequenceFlow_ArrangeInsurance</bpmn:incoming>  
      <bpmn:outgoing>SequenceFlow_ToPackStart</bpmn:outgoing>  
    </bpmn:task>  

    <!-- Package Form Task -->  
    <bpmn:task id="Task_FillPackageForm" name="Paketschein ausfüllen">  
      <bpmn:incoming>SequenceFlow_PackToInsurance</bpmn:incoming>  
      <bpmn:outgoing>SequenceFlow_ToSmallQuantity</bpmn:outgoing>  
    </bpmn:task>  

    <!-- Pack Goods Task -->  
    <bpmn:task id="Task_PackGoods" name="Ware verpacken">  
      <bpmn:incoming>SequenceFlow_ToPackStart</bpmn:incoming>  
      <bpmn:outgoing>SequenceFlow_MakeAvailable</bpmn:outgoing>  
    </bpmn:task>  

    <!-- Order Carrier Task -->  
    <bpmn:task id="Task_OrderCarrier" name="Spediteur beauftragen">  
      <bpmn:incoming>SequenceFlow_OrderCarrier</bpmn:incoming>  
      <bpmn:outgoing>SequenceFlow_ToEndGateway</bpmn:outgoing>  
    </bpmn:task>  

    <!-- End Gateway -->  
    <bpmn:exclusiveGateway id="XGateway_MakeAvailable" name="Alle Vorbereitungen abgeschlossen?">  
      <bpmn:incoming>SequenceFlow_OrderToEnd</bpmn:incoming>  
      <bpmn:incoming>SequenceFlow_PackToFinish</bpmn:incoming>  
      <bpmn:outgoing>SequenceFlow_ToMakeReady</bpmn:outgoing>  
    </bpmn:exclusiveGateway>  

    <!-- End Event -->  
    <bpmn:endEvent id="EndEvent_1" name="Ware zur Abholung bereit">  
      <bpmn:incoming>SequenceFlow_MakeAvailableToFinish</bpmn:incoming>  
    </bpmn:endEvent>  

    <!-- Sequence Flows - Large Quantity Path -->  
    <bpmn:sequenceFlow id="SequenceFlow_StartToGateway" sourceRef="StartEvent_1" targetRef="XGateway_LargeSmall">  
      <bpmn:name>Versand anstoßen</bpmn:name>  
    </bpmn:sequenceFlow>  

    <!-- Large Quantity Path -->  
    <bpmn:sequenceFlow id="SequenceFlow_ToLargeQuantity" name="Große Menge (Sonderversand)" sourceRef="XGateway_LargeSmall" targetRef="Task_GetOffers">  
      <bpmn:conditionExpression xsi:type="tFormalExpression">${quantity == "large"}</bpmn:conditionExpression>  
    </bpmn:sequenceFlow>  

    <!-- Large Quantity Tasks -->  
    <bpmn:sequenceFlow id="SequenceFlow_SelectOffer" sourceRef="Task_GetOffers" targetRef="Task_SelectOffer">  
      <bpmn:name>Angebote erhalten</bpmn:name>  
    </bpmn:sequenceFlow>  

    <bpmn:sequenceFlow id="SequenceFlow_OrderCarrier" name="Spediteur beauftragen" sourceRef="Task_SelectOffer" targetRef="XGateway_MakeAvailable">  
      <bpmn:conditionExpression xsi:type="tFormalExpression">${quantity == "large"}</bpmn:conditionExpression>  
    </bpmn:sequenceFlow>  

    <!-- Small Quantity Path -->  
    <bpmn:sequenceFlow id="SequenceFlow_ToSmallQuantity" name="Kleine Menge (Normalversand)" sourceRef="XGateway_LargeSmall" targetRef="Task_FillPackageForm">  
      <bpmn:conditionExpression xsi:type="tFormalExpression">${quantity == "small"}</bpmn:conditionExpression>  
    </bpmn:sequenceFlow>  

    <!-- Small Quantity Tasks -->  
    <bpmn:sequenceFlow id="SequenceFlow_PackToInsurance" sourceRef="Task_FillPackageForm" targetRef="XGateway_InsuranceCheck">  
      <bpmn:name>Paketschein ausgefüllt</bpmn:name>  
    </bpmn:sequenceFlow>  

    <!-- Insurance Decision -->  
    <bpmn:sequenceFlow id="SequenceFlow_ArrangeInsurance" name="Versicherung erforderlich?" sourceRef="XGateway_InsuranceCheck" targetRef="Task_ArrangeInsurance">  
      <bpmn:conditionExpression xsi:type="tFormalExpression">${insuranceRequired == true}</bpmn:conditionExpression>  
    </bpmn:sequenceFlow>  

    <!-- Skip Insurance -->  
    <bpmn:sequenceFlow id="SequenceFlow_SkipInsurance" name="Keine Versicherung nötig" sourceRef="XGateway_InsuranceCheck" targetRef="XGateway_PackStart">  
      <bpmn:conditionExpression xsi:type="tFormalExpression">${insuranceRequired == false}</bpmn:conditionExpression>  
    </bpmn:sequenceFlow>  

    <!-- Parallel Gateway for Packing -->  
    <bpmn:sequenceFlow id="SequenceFlow_ToPackStart" sourceRef="XGateway_PackStart" targetRef="Task_PackGoods">  
      <bpmn:name>Vorbereitungen parallel starten</bpmn:name>  
    </bpmn:sequenceFlow>  

    <!-- Pack Goods -->  
    <bpmn:sequenceFlow id="SequenceFlow_MakeAvailable" sourceRef="Task_PackGoods" targetRef="XGateway_MakeAvailable">  
      <bpmn:name>Versandfertig verpackt</bpmn:name>  
    </bpmn:sequenceFlow>  

    <!-- End Gateway -->  
    <bpmn:sequenceFlow id="SequenceFlow_OrderToEnd" sourceRef="Task_OrderCarrier" targetRef="XGateway_MakeAvailable">  
      <bpmn:name>Versand beauftragt</bpmn:name>  
    </bpmn:sequenceFlow>  

    <!-- Final Sequence Flow -->  
    <bpmn:sequenceFlow id="SequenceFlow_ToMakeReady" sourceRef="XGateway_MakeAvailable" targetRef="EndEvent_1">  
      <bpmn:name>Vorbereitungen abgeschlossen</bpmn:name>  
    </bpmn:sequenceFlow>  

  </bpmn:process>  
</bpmn:definitions>