<?xml version="1.0" encoding="UTF-8"?>  
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_RecourseProcess">  
  <bpmn:collaboration id="Collab_1">  
    <bpmn:participant id="Participant_Versicherung" name="Versicherungsprozess Regressbearbeitung" processRef="Process_Regress">  
      <bpmn:laneSet>  
        <bpmn:lanes>  
          <bpmn:lane id="Lane_Sachbearbeiter" name="Sachbearbeiter">  
            <bpmn:flowNodeRef>Task_PrüfungMöglichkeit</bpmn:flowNodeRef>  
            <bpmn:flowNodeRef>Gateway_RegressMöglichkeit</bpmn:flowNodeRef>  
            <bpmn:flowNodeRef>Task_ZahlungsaufforderungSenden</bpmn:flowNodeRef>  
            <bpmn:flowNodeRef>Task_VorgangWiedervorlageSetzen</bpmn:flowNodeRef>  
            <bpmn:flowNodeRef>Gateway_EreignisPrüfung</bpmn:flowNodeRef>  
            <bpmn:flowNodeRef>Task_GeldEingangVerbuchen</bpmn:flowNodeRef>  
            <bpmn:flowNodeRef>Task_PrüfungWiderspruch</bpmn:flowNodeRef>  
            <bpmn:flowNodeRef>Gateway_WiderspruchPrüfung</bpmn:flowNodeRef>  
            <bpmn:flowNodeRef>Task_InkassoAbgabe</bpmn:flowNodeRef>  
          </bpmn:lane>  
        </bpmn:lanes>  
      </bpmn:laneSet>  
    </bpmn:participant>  
  </bpmn:collaboration>  

  <bpmn:process id="Process_Regress" isExecutable="false">  
    <!-- Start Event -->  
    <bpmn:startEvent id="Start_NotificationRegress" name="Meldung Regress möglich">  
      <bpmn:outgoing>Seq_StartPrüfung</bpmn:outgoing>  
    </bpmn:startEvent>  

    <!-- Task: Case Check -->  
    <bpmn:task id="Task_PrüfungMöglichkeit" name="Fall prüfen - Regress möglich?">  
      <bpmn:incoming>Seq_StartPrüfung</bpmn:incoming>  
      <bpmn:outgoing>Seq_GatewayRegresSicht</bpmn:outgoing>  
    </bpmn:task>  

    <!-- Gateway: Possibility Exists? -->  
    <bpmn:exclusiveGateway id="Gateway_RegressMöglichkeit" name="Regress möglich?">  
      <bpmn:incoming>Seq_GatewayRegresSicht</bpmn:incoming>  
      <bpmn:outgoing>Seq_ZahlungsaufforderungJa</bpmn:outgoing>  
      <bpmn:outgoing>Seq_VorgangSchließenNein</bpmn:outgoing>  
    </bpmn:exclusiveGateway>  

    <!-- Task: Send Payment Demand -->  
    <bpmn:task id="Task_ZahlungsaufforderungSenden" name="Zahlungsauﬂorderung an VN senden">  
      <bpmn:incoming>Seq_ZahlungsaufforderungJa</bpmn:incoming>  
      <bpmn:outgoing>Seq_WiedervorlageSetzen</bpmn:outgoing>  
    </bpmn:task>  

    <!-- Task: Set for Follow-up -->  
    <bpmn:task id="Task_VorgangWiedervorlageSetzen" name="Vorgang auf Wiedervorlage setzen">  
      <bpmn:incoming>Seq_WiedervorlageSetzen</bpmn:incoming>  
      <bpmn:outgoing>Seq_GatewayEreignisPrüfung</bpmn:outgoing>  
    </bpmn:task>  

    <!-- Gateway: Money Received or Objection? -->  
    <bpmn:exclusiveGateway id="Gateway_EreignisPrüfung" name="Geld oder Widerspruch?">  
      <bpmn:incoming>Seq_GatewayEreignisPrüfung</bpmn:incoming>  
      <bpmn:outgoing>Seq_ZahlungseingangJa</bpmn:outgoing>  
      <bpmn:outgoing>Seq_WiderspruchNein</bpmn:outgoing>  
    </bpmn:exclusiveGateway>  

    <!-- Task: Book Receipt -->  
    <bpmn:task id="Task_GeldEingangVerbuchen" name="Geldeingang verbuchen">  
      <bpmn:incoming>Seq_ZahlungseingangJa</bpmn:incoming>  
      <bpmn:outgoing>Seq_VorgangSchließenBuchung</bpmn:outgoing>  
    </bpmn:task>  

    <!-- Task: Check Objection -->  
    <bpmn:task id="Task_PrüfungWiderspruch" name="Widerspruch prüfen">  
      <bpmn:incoming>Seq_WiderspruchNein</bpmn:incoming>  
      <bpmn:outgoing>Seq_GatewayWidersuchPrüfung</bpmn:outgoing>  
    </bpmn:task>  

    <!-- Gateway: Objection Justified? -->  
    <bpmn:exclusiveGateway id="Gateway_WiderspruchPrüfung" name="Widerspruch gerechtfertigt?">  
      <bpmn:incoming>Seq_GatewayWidersuchPrüfung</bpmn:incoming>  
      <bpmn:outgoing>Seq_VorgangSchließenBerechtigt</bpmn:outgoing>  
      <bpmn:outgoing>Seq_InkassoAbgabeUngerechtfertigt</bpmn:outgoing>  
    </bpmn:exclusiveGateway>  

    <!-- End Events -->  
    <bpmn:endEvent id="End_VorgangSchließenNein" name="Vorgang geschlossen (kein Regress)">  
      <bpmn:incoming>Seq_VorgangSchließenNein</bpmn:incoming>  
    </bpmn:endEvent>  

    <bpmn:endEvent id="End_VorgangSchließenBuchung" name="Vorgang geschlossen (Geld verbucht)">  
      <bpmn:incoming>Seq_VorgangSchließenBuchung</bpmn:incoming>  
    </bpmn:endEvent>  

    <bpmn:endEvent id="End_VorgangSchließenBerechtigt" name="Vorgang geschlossen (Widerspruch berechtigt)">  
      <bpmn:incoming>Seq_VorgangSchließenBerechtigt</bpmn:incoming>  
    </bpmn:endEvent>  

    <!-- Task: Handover to Collection Agency -->  
    <bpmn:task id="Task_InkassoAbgabe" name="An Inkassodienstleister abgeben">  
      <bpmn:incoming>Seq_InkassoAbgabeUngerechtfertigt</bpmn:incoming>  
      <bpmn:outgoing>Seq_VorgangSchließenInkasso</bpmn:outgoing>  
    </bpmn:task>  

    <!-- End Event for Collection -->  
    <bpmn:endEvent id="End_VorgangSchließenInkasso" name="Vorgang geschlossen (an Inkassodienstleister)">  
      <bpmn:incoming>Seq_VorgangSchließenInkasso</bpmn:incoming>  
    </bpmn:endEvent>  

    <!-- Sequence Flows -->  
    <bpmn:sequenceFlow id="Seq_StartPrüfung" sourceRef="Start_NotificationRegress" targetRef="Task_PrüfungMöglichkeit">  
      <bpmn:name>Meldung erhalten</bpmn:name>  
    </bpmn:sequenceFlow>  

    <!-- From Task to Gateway -->  
    <bpmn:sequenceFlow id="Seq_GatewayRegresSicht" sourceRef="Task_PrüfungMöglichkeit" targetRef="Gateway_RegressMöglichkeit">  
      <bpmn:name>Fall geprüft</bpmn:name>  
    </bpmn:sequenceFlow>  

    <!-- From Gateway - Yes Path -->  
    <bpmn:sequenceFlow id="Seq_ZahlungsaufforderungJa" sourceRef="Gateway_RegressMöglichkeit" targetRef="Task_ZahlungsaufforderungSenden">  
      <bpmn:name>ja</bpmn:name>  
    </bpmn:sequenceFlow>  

    <!-- From Gateway - No Path -->  
    <bpmn:sequenceFlow id="Seq_VorgangSchließenNein" sourceRef="Gateway_RegressMöglichkeit" targetRef="End_VorgangSchließenNein">  
      <bpmn:name>nein</bpmn:name>  
    </bpmn:sequenceFlow>  

    <!-- After Payment Demand -->  
    <bpmn:sequenceFlow id="Seq_WiedervorlageSetzen" sourceRef="Task_ZahlungsaufforderungSenden" targetRef="Task_VorgangWiedervorlageSetzen">  
      <bpmn:name>immer</bpmn:name>  
    </bpmn:sequenceFlow>  

    <!-- After Follow-up Set -->  
    <bpmn:sequenceFlow id="Seq_GatewayEreignisPrüfung" sourceRef="Task_VorgangWiedervorlageSetzen" targetRef="Gateway_EreignisPrüfung">  
      <bpmn:name>immer</bpmn:name>  
    </bpmn:sequenceFlow>  

    <!-- Money Received Path -->  
    <bpmn:sequenceFlow id="Seq_ZahlungseingangJa" sourceRef="Gateway_EreignisPrüfung" targetRef="Task_GeldEingangVerbuchen">  
      <bpmn:name>Geld eingegangen</bpmn:name>  
    </bpmn:sequenceFlow>  

    <!-- Objection Path -->  
    <bpmn:sequenceFlow id="Seq_WiderspruchNein" sourceRef="Gateway_EreignisPrüfung" targetRef="Task_PrüfungWiderspruch">  
      <bpmn:name>Widerspruch oder Frist abgelaufen</bpmn:name>  
    </bpmn:sequenceFlow>  

    <!-- After Objection Check -->  
    <bpmn:sequenceFlow id="Seq_GatewayWidersuchPrüfung" sourceRef="Task_PrüfungWiderspruch" targetRef="Gateway_WiderspruchPrüfung">  
      <bpmn:name>immer</bpmn:name>  
    </bpmn:sequenceFlow>  

    <!-- After Booking -->  
    <bpmn:sequenceFlow id="Seq_VorgangSchließenBuchung" sourceRef="Task_GeldEingangVerbuchen" targetRef="End_VorgangSchließenBuchung">  
      <bpmn:name>immer</bpmn:name>  
    </bpmn:sequenceFlow>  

    <!-- After Objection Check - Justified -->  
    <bpmn:sequenceFlow id="Seq_VorgangSchließenBerechtigt" sourceRef="Gateway_WiderspruchPrüfung" targetRef="End_VorgangSchließenBerechtigt">  
      <bpmn:name>gerechtfertigt</bpmn:name>  
    </bpmn:sequenceFlow>  

    <!-- After Objection Check - Not Justified -->  
    <bpmn:sequenceFlow id="Seq_InkassoAbgabeUngerechtfertigt" sourceRef="Gateway_WiderspruchPrüfung" targetRef="Task_InkassoAbgabe">  
      <bpmn:name>nicht gerechtfertigt</bpmn:name>  
    </bpmn:sequenceFlow>  

    <!-- After Collection Handover -->  
    <bpmn:sequenceFlow id="Seq_VorgangSchließenInkasso" sourceRef="Task_InkassoAbgabe" targetRef="End_VorgangSchließenInkasso">  
      <bpmn:name>immer</bpmn:name>  
    </bpmn:sequenceFlow>  

  </bpmn:process>  
</bpmn:definitions>