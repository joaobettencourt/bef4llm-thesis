<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1a8xq7f">
    <bpmn:participant id="Participant_0p4r6w2" name="Regressabwicklung" processRef="Process_1" />
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_0s6x3q5" name="Sachbearbeiter">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_0m4h9k7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_0g3x8p2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_1r5t9k4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_2h6q7m3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_0p8s4x1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_5k9r4x2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_3h7t6q8</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Regressmeldung erhalten">
      <bpmn:outgoing>SequenceFlow_0p7m3k4</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Check case -->
    <bpmn:task id="Task_0m4h9k7" name="Fall prüfen">
      <bpmn:incoming>SequenceFlow_0p7m3k4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1r6s8t5</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Possibility exists? -->
    <bpmn:exclusiveGateway id="InclusiveGateway_0g3x8p2" name="Möglichkeit besteht?">
      <bpmn:incoming>SequenceFlow_1r6s8t5</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2h4q7k9</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_3x5p8m6</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Send payment demand -->
    <bpmn:task id="Task_2h6q7m3" name="Zahlungsauflage senden">
      <bpmn:incoming>SequenceFlow_2h4q7k9</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5x8t2p1</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Catching Event: Money received -->
    <bpmn:startEvent id="StartEvent_4" name="Geld eingegangen">
      <bpmn:timerDefinition xsi:type="bpmn:TimeCycle">R/2019-08-27T14:56:00</bpmn:timerDefinition>
      <bpmn:outgoing>SequenceFlow_1p3x8k5</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Book receipt -->
    <bpmn:task id="Task_4m6s9r2" name="Eingang verbuchen">
      <bpmn:incoming>SequenceFlow_1p3x8k5</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0v7t4q3</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_1" name="Vorgang geschlossen">
      <bpmn:incoming>SequenceFlow_5x8t2p1</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_0v7t4q3</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_0p7m3k4" sourceRef="StartEvent_1" targetRef="Task_0m4h9k7">
      <bpmn:name>VN möglicherweise in Regress genommen</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Yes path from possibility check -->
    <bpmn:sequenceFlow id="SequenceFlow_2h4q7k9" name="ja" sourceRef="InclusiveGateway_0g3x8p2" targetRef="Task_2h6q7m3">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${possibilityExists}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- No path from possibility check -->
    <bpmn:sequenceFlow id="SequenceFlow_3x5p8m6" name="nein" sourceRef="InclusiveGateway_0g3x8p2" targetRef="EndEvent_1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!possibilityExists}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Set for follow-up -->
    <bpmn:sequenceFlow id="SequenceFlow_5x8t2p1" sourceRef="Task_2h6q7m3" targetRef="EndEvent_1">
      <bpmn:name>Vorgang auf Wiedervorlage setzen</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Money received -->
    <bpmn:sequenceFlow id="SequenceFlow_1p3x8k5" sourceRef="StartEvent_4" targetRef="Task_4m6s9r2">
      <bpmn:name>Geld eingegangen</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Book receipt -->
    <bpmn:sequenceFlow id="SequenceFlow_0v7t4q3" sourceRef="Task_4m6s9r2" targetRef="EndEvent_1">
      <bpmn:name>Vorgang schließen</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>