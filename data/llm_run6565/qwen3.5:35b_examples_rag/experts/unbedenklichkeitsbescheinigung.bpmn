<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1a8xq7f">
    <bpmn:participant id="Participant_0p4r6w2" name="Unbedenklichkeitsbescheinigung Prozess" processRef="Process_1" />
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_0j3bzn7">
      <bpmn:lane id="Lane_SystemProcessing" name="System Processing">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProcessTraceability</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Verification" name="Verification">
        <bpmn:flowNodeRef>InclusiveGateway_PersonExists</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_CreateLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_EmployerRole</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Review" name="Case Review">
        <bpmn:flowNodeRef>UserTask_AssessStanding</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_IssueCertificate</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneset>

    <!-- Flow Elements -->
    <bpmn:startEvent id="StartEvent_1" name="Anfrage Unbedenklichkeitsbescheinigung">
      <bpmn:outgoing>SequenceFlow_StartToTraceability</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_ProcessTraceability" name="Vorgang im System nachvollziehbar machen und Prozess identifizieren">
      <bpmn:incoming>SequenceFlow_StartToTraceability</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TraceabilityToPersonCheck</bpmn:outgoing>
    </bpmn:task>

    <bpmn:inclusiveGateway id="InclusiveGateway_PersonExists" name="Ist Person im System?">
      <bpmn:incoming>SequenceFlow_TraceabilityToPersonCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PersonYes</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <bpmn:userTask id="UserTask_CreateLetter" name="Anschreiben erstellen">
      <bpmn:incoming>SequenceFlow_PersonNo</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_LetterToEmployerCheck</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:inclusiveGateway id="InclusiveGateway_EmployerRole" name="Arbeitgeberrolle?">
      <bpmn:incoming>SequenceFlow_PersonYes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EmployerYes</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <bpmn:userTask id="UserTask_AssessStanding" name="Unbedenklichkeit prüfen und Bescheinigung ausstellen">
      <bpmn:incoming>SequenceFlow_EmployerYes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CertificateDecision</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndEvent_1" name="Unbedenklichkeitsbescheinigung ausgestellt">
      <bpmn:incoming>SequenceFlow_CertificateYes</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToTraceability" sourceRef="StartEvent_1" targetRef="Task_ProcessTraceability">
      <bpmn:name>Anfrage eingegangen</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_TraceabilityToPersonCheck" name="Vorgang nachvollziehbar?" sourceRef="Task_ProcessTraceability" targetRef="InclusiveGateway_PersonExists">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${processIdentified}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_PersonYes" name="Ja - Person vorhanden" sourceRef="InclusiveGateway_PersonExists" targetRef="InclusiveGateway_EmployerRole">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${personExists == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_PersonNo" name="Nein - Anschreiben erstellen" sourceRef="InclusiveGateway_PersonExists" targetRef="UserTask_CreateLetter">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${personExists == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_LetterToEmployerCheck" name="Anschreiben gesendet" sourceRef="UserTask_CreateLetter" targetRef="InclusiveGateway_EmployerRole">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${letterSent}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_EmployerYes" name="Ja - Arbeitgeberrolle bestätigt" sourceRef="InclusiveGateway_EmployerRole" targetRef="UserTask_AssessStanding">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${employerRole == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_CertificateDecision" name="Prüfung abgeschlossen" sourceRef="UserTask_AssessStanding" targetRef="InclusiveGateway_IssueCertificate">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${verificationComplete}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

  </bpmn:process>


</bpmn:definitions>