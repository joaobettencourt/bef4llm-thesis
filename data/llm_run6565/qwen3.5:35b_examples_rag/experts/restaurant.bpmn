<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1a8xq7f">
    <bpmn:participant id="Participant_Restaurant" name="Restaurant Process" processRef="Process_1" />
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Gast" name="Gast (Customer)">
        <bpmn:flowNodeRef>StartEvent_0g4x8p2</bpmn:flowNodeRef />
        <bpmn:flowNodeRef>InclusiveGateway_PieperReagiert</bpmn:flowNodeRef />
        <bpmn:flowNodeRef>Task_GastWarten</bpmn:flowNodeRef />
        <bpmn:flowNodeRef>EndEvent_EssenAbgeholt</bpmn:endevent />
      </bpmn:lane>

      <bpmn:lane id="Lane_Angestellter" name="Angestellter (Staff)">
        <bpmn:flowNodeRef>InclusiveGateway_BestellungValid</bpmn:flowNodeRef />
        <bpmn:flowNodeRef>Task_BestellungAufnehmen</bpmn:taskRef />
        <bpmn:flowNodeRef>Task_KassenAbrechnen</bpmn:taskRef />
        <bpmn:flowNodeRef>Task_PieperEinrichten</bpmn:taskRef />
        <bpmn:flowNodeRef>Task_KochInformieren</bpmn:taskRef />
        <bpmn:flowNodeRef>Task_AusgabeEssen</bpmn:taskRef />
      </bpmn:lane>

      <bpmn:lane id="Lane_Koch" name="Koch (Cook)">
        <bpmn:flowNodeRef>InclusiveGateway_EssenFertig</bpmn:flowNodeRef />
        <bpmn:flowNodeRef>Task_MahlzeitZubereiten</bpmn:taskRef />
        <bpmn:flowNodeRef>Task_EssenInDurchreicheStellen</bpmn:taskRef />
      </bpmn:lane>

    </bpmn:laneset>

    <!-- Flow Elements -->
    <bpmn:startEvent id="StartEvent_0g4x8p2" name="Gast betritt Restaurant">
      <bpmn:outgoing>SequenceFlow_G1</bpmn:sequenceflow />
    </bpmn:startevent>

    <bpmn:endEvent id="EndEvent_EssenAbgeholt" name="Essen verzehrt">
      <bpmn:incoming>SequenceFlow_5x6t2p4</bpmn:incoing />
    </bpmn:endevent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_G1" sourceRef="StartEvent_0g4x8p2" targetRef="Task_BestellungAufnehmen">
      <bpmn:name>Gast wählt Gericht aus</bpmn:name>
    </bpmn:sequenceflow />

    <bpmn:task id="Task_BestellungAufnehmen" name="Bestellung aufnehmen">
      <bpmn:incoming>SequenceFlow_G1</bpmn:incoing/>
      <bpmn:outgoing>SequenceFlow_2h4q7k9</bpmn:sequenceflow />
    </bpmn:startevent>

    <bpmn:task id="Task_KassenAbrechnen" name="Kassenabrechnung">
      <bpmn:incoming>SequenceFlow_2h4q7k9</bpmn:incoing/>
      <bpmn:outgoing>SequenceFlow_PieperEinrichten</bpmn:sequenceflow />
    </bpmn:startevent>

    <bpmn:task id="Task_PieperEinrichten" name="Pieper einrichten">
      <bpmn:incoming>SequenceFlow_PieperEinrichten</bpmn:incoing/>
      <bpmn:outgoing>SequenceFlow_KochInformieren</bpmn:sequenceflow />
    </bpmn:startevent>

    <bpmn:task id="Task_KochInformieren" name="Koch informieren">
      <bpmn:incoming>SequenceFlow_KochInformieren</bpmn:incoing/>
      <bpmn:outgoing>SequenceFlow_5x6t2p4</bpmn:sequenceflow />
    </bpmn:startevent>

    <!-- Inclusive Gateway for Guest waiting -->
    <bpmn:inclusiveGateway id="InclusiveGateway_PieperReagiert" name="Pieper reagiert?">
      <bmpmn:incoming sequence-flowref="SequenceFlow_PieperErhalten"/>
      <bpmn:outgoing>SequenceFlow_GastRuftAn</bpmn:sequenceflow />
    </bpmn:startevent>

  </bpmn:process>


</bpmn:definitions>