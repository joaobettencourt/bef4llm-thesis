<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1a8xq7f">
    <bpmn:participant id="Participant_Schadensbearbeitung" name="Schadensbearbeitung Versicherung" processRef="Process_1" />
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Kundenzentrum" name="Kundenzentrum">
        <bpmn:flowNodeRef>StartEvent_Schadensmeldung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_GültigkeitPrüfung</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Versicherungsmanagement" name="Versicherungsmanagement">
        <bpmn:flowNodeRef>Task_DokumenteVollständigkeitKontrollieren</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_SchadensursachePrüfung</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Fachabteilung" name="Fachabteilung">
        <bpmn:flowNodeRef>Task_VerlaufValidierung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_RechtlicheEinschätzung</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Statistik" name="Schadensstatistik">
        <bpmn:flowNodeRef>Task_SchadenFallErfassen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SchadensstatistikAktualisieren</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneset>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Schadensmeldung" name="Schadensmeldung einreichen">
      <bpmn:outgoing>SequenceFlow_0p7m3k4</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Gateway for validity check -->
    <bpmn:exclusiveGateway id="InclusiveGateway_GültigkeitPrüfung" name="Schaden gültig?">
      <bpmn:incoming>SequenceFlow_0p7m3k4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AblehnungWeg</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_BearbeitungWeg</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event for rejected claim -->
    <bpmn:endEvent id="EndEvent_SchadenAbgelehnt" name="Schadensmeldung abgelehnt">
      <bpmn:incoming>SequenceFlow_AblehnungWeg</bpmn:incoming>
    </bpmn:endEvent>

    <!-- End Event for completed process -->
    <bpmn:endEvent id="EndEvent_ProzessAbgeschlossen" name="Prozess abgeschlossen">
      <bpmn:incoming>SequenceFlow_KundeInformiert</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task: Check document completeness -->
    <bpmn:task id="Task_DokumenteVollständigkeitKontrollieren" name="Dokumente auf Vollständigkeit prüfen">
      <bpmn:incoming>SequenceFlow_BearbeitungWeg</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_VerlaufValidierungStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway for parallel processing -->
    <bpmn:parallelGateway id="ParallelGateway_Bearbeitung" name="Bearbeitungsstart">
      <bpmn:incoming>SequenceFlow_VerlaufValidierungStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SchadenErfassen</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_Validierungsprozess</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Register case in statistics -->
    <bpmn:task id="Task_SchadenFallErfassen" name="Schadensfall erfassen">
      <bpmn:incoming>SequenceFlow_SchadenErfassen</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StatistikWarten</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Deep validation -->
    <bpmn:task id="Task_VerlaufValidierung" name="Vertieften Validierungsprozess">
      <bpmn:incoming>SequenceFlow_Validierungsprozess</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RechtlichePrüfungStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for legal assessment -->
    <bpmn:exclusiveGateway id="InclusiveGateway_RechtlicheEinschätzung" name="Rechtliche Einschätzung erforderlich?">
      <bpmn:incoming>SequenceFlow_RechtlichePrüfungStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_VersichererEinholen</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_KeineRechtsprüfung</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Get legal assessment from insurer -->
    <bpmn:task id="Task_VersichererEinholen" name="Rechtliche Einschätzung einholen">
      <bpmn:incoming>SequenceFlow_VersichererEinholen</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InformationenÜbermitteln</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Send information to insurer -->
    <bpmn:task id="Task_InformationenÜbermitteln" name="Relevante Informationen übermitteln">
      <bpmn:incoming>SequenceFlow_InformationenÜbermitteln</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PrüfungAbgeschlossen</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Update statistics -->
    <bpmn:task id="Task_SchadensstatistikAktualisieren" name="Schadensstatistik aktualisieren">
      <bpmn:incoming>SequenceFlow_PrüfungAbgeschlossen</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_KundeInformierenStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Inform customer -->
    <bpmn:task id="Task_KundeInformieren" name="Kunden über Bearbeitungsstand informieren">
      <bpmn:incoming>SequenceFlow_KundeInformierenStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProzessAbgeschlossen</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_0p7m3k4" sourceRef="StartEvent_Schadensmeldung" targetRef="InclusiveGateway_GültigkeitPrüfung" />
    
    <bpmn:sequenceFlow id="SequenceFlow_AblehnungWeg" name="nein" sourceRef="InclusiveGateway_GültigkeitPrüfung" targetRef="EndEvent_SchadenAbgelehnt">
      <bpmn:name>nein</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_BearbeitungWeg" name="ja" sourceRef="InclusiveGateway_GültigkeitPrüfung" targetRef="Task_DokumenteVollständigkeitKontrollieren">
      <bpmn:name>ja</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_VerlaufValidierungStart" sourceRef="Task_DokumenteVollständigkeitKontrollieren" targetRef="ParallelGateway_Bearbeitung" />

    <bpmn:sequenceFlow id="SequenceFlow_SchadenErfassen" sourceRef="ParallelGateway_Bearbeitung" targetRef="Task_SchadenFallErfassen" />
    
    <bpmn:sequenceFlow id="SequenceFlow_Validierungsprozess" sourceRef="ParallelGateway_Bearbeitung" targetRef="Task_VerlaufValidierung" />

    <bpmn:sequenceFlow id="SequenceFlow_RechtlichePrüfungStart" sourceRef="Task_VerlaufValidierung" targetRef="InclusiveGateway_RechtlicheEinschätzung" />
    
    <bpmn:sequenceFlow id="SequenceFlow_VersichererEinholen" name="ja" sourceRef="InclusiveGateway_RechtlicheEinschätzung" targetRef="Task_VersichererEinholen">
      <bpmn:name>ja</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_KeineRechtsprüfung" name="nein" sourceRef="InclusiveGateway_RechtlicheEinschätzung" targetRef="Task_SchadensstatistikAktualisieren">
      <bpmn:name>nein</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_InformationenÜbermitteln" sourceRef="Task_VersichererEinholen" targetRef="InclusiveGateway_RechtlicheEinschätzung">
      <bpmn:name>nein</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:parallelGateway id="ParallelGateway_PrüfungAbschluss" name="Prüfungsabschluss">
      <bpmn:incoming>SequenceFlow_StatistikWarten</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_PrüfungAbgeschlossen</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_KundeInformierenStart</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:sequenceFlow id="SequenceFlow_StatistikWarten" sourceRef="Task_SchadenFallErfassen" targetRef="ParallelGateway_PrüfungAbschluss" />
    
    <bpmn:sequenceFlow id="SequenceFlow_PrüfungAbgeschlossen" name="Prüfung abgeschlossen" sourceRef="InclusiveGateway_RechtlicheEinschätzung" targetRef="Task_SchadensstatistikAktualisieren">
      <bpmn:name>nein</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_KundeInformierenStart" sourceRef="ParallelGateway_PrüfungAbschluss" targetRef="Task_SchadenFallErfassen">
      <bpmn:name>nein</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_KundeInformiert" sourceRef="Task_SchadensstatistikAktualisieren" targetRef="ParallelGateway_PrüfungAbschluss">
      <bpmn:name>nein</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ProzessAbgeschlossen" sourceRef="Task_KundeInformieren" targetRef="EndEvent_ProzessAbgeschlossen">
      <bpmn:name>nein</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>