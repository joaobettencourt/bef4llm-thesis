<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1a8xq7f">
    <bpmn:participant id="Participant_1p4r6w2" name="Firmenfragebogen Bearbeitung" processRef="Process_1ccot4k" />
  </bpmn:collaboration>

  <bpmn:process id="Process_1ccot4k" isExecutable="true">
    <bpmn:laneSet id="LaneSet_01m91on">
      <bpmn:lane id="Lane_Systemautomatisierung" name="Systemautomatisierung">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Erfassen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_SuchePartner</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PartnerGefunden</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Sachbearbeiter" name="Sachbearbeiter">
        <bpmn:flowNodeRef>UserTask_ManuellePruefung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_DatenPruefen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Meldezeitraum</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_ZeitenAnlegen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_KontaktdatenPruefen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ProblemAufgetreten</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_Weiterbearbeitung</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Flow Elements -->
    <bpmn:startEvent id="StartEvent_1" name="Firmenfragebogen erhalten">
      <bpmn:outgoing>SequenceFlow_StartErfassen</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_Erfassen" name="Erfassen und im System verarbeiten">
      <bpmn:incoming>SequenceFlow_StartErfassen</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SuchePartner</bpmn:outgoing>
    </bpmn:task>

    <bpmn:serviceTask id="ServiceTask_SuchePartner" name="Automatische Suche nach Partnerunternehmen">
      <bpmn:incoming>SequenceFlow_SuchePartner</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PartnerPruefung</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_PartnerGefunden" name="Partner gefunden / Zuordnung möglich?">
      <bpmn:incoming>SequenceFlow_PartnerPruefung</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ManuellePruefung</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_DatenPruefenStart</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="UserTask_ManuellePruefung" name="Manuelle Prüfung">
      <bpmn:incoming>SequenceFlow_ManuellePruefung</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DatenPruefenStart</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="ServiceTask_DatenPruefen" name="Unternehmensdaten prüfen (Betriebsnummer, U1-Verfahren etc.)">
      <bpmn:incoming>SequenceFlow_DatenPruefenStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MeldezeitraumCheck</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_Meldezeitraum" name="Meldezeitraum prüfen?">
      <bpmn:incoming>SequenceFlow_MeldezeitraumCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ZeitenPruefen</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ZeitenAnlegenStart</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="UserTask_ZeitenAnlegen" name="Umlageversicherungszeiten neu anlegen">
      <bpmn:incoming>SequenceFlow_ZeitenAnlegenStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_KontaktdatenCheck</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="ServiceTask_KontaktdatenPruefen" name="Kontaktdaten prüfen (Telefon, Fax, Adresse)">
      <bpmn:incoming>SequenceFlow_ZeitenAnlegenStart</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ZeitenPruefen</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProblemCheck</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_ProblemAufgetreten" name="Problem aufgetreten / Klärungsbedarf?">
      <bpmn:incoming>SequenceFlow_ProblemCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WeiterbearbeitungStart</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_EndEvent</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="UserTask_Weiterbearbeitung" name="Weiterbearbeitung durch Mitarbeiter">
      <bpmn:incoming>SequenceFlow_WeiterbearbeitungStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndEvent</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndEvent_1" name="Bearbeitung abgeschlossen">
      <bpmn:incoming>SequenceFlow_EndEvent</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartErfassen" sourceRef="StartEvent_1" targetRef="Task_Erfassen" />
    <bpmn:sequenceFlow id="SequenceFlow_SuchePartner" name="Suche Partnerunternehmen" sourceRef="Task_Erfassen" targetRef="ServiceTask_SuchePartner" />
    <bpmn:sequenceFlow id="SequenceFlow_PartnerPruefung" name="Ergebnis Suche" sourceRef="ServiceTask_SuchePartner" targetRef="Gateway_PartnerGefunden" />
    
    <!-- Branch for Manual Check -->
    <bpmn:sequenceFlow id="SequenceFlow_ManuellePruefung" name="Nein / Unklar" sourceRef="Gateway_PartnerGefunden" targetRef="UserTask_ManuellePruefung" />
    
    <!-- Merge Point (Implicit via flow to Data Verification) -->
    <bpmn:sequenceFlow id="SequenceFlow_DatenPruefenStart" name="Weiterverarbeitung" sourceRef="UserTask_ManuellePruefung" targetRef="ServiceTask_DatenPruefen" />
    <bpmn:sequenceFlow id="SequenceFlow_DataVerificationMerge" name="Partner gefunden / Gepruift" sourceRef="Gateway_PartnerGefunden" targetRef="ServiceTask_DatenPruefen" />

    <!-- Reporting Period Check -->
    <bpmn:sequenceFlow id="SequenceFlow_MeldezeitraumCheck" name="Daten gepruft?" sourceRef="ServiceTask_DatenPruefen" targetRef="Gateway_Meldezeitraum" />
    
    <!-- Branch for Missing Times -->
    <bpmn:sequenceFlow id="SequenceFlow_ZeitenAnlegenStart" name="Nein - keine Einträge" sourceRef="Gateway_Meldezeitraum" targetRef="UserTask_ZeitenAnlegen" />
    
    <!-- Branch for Existing Times (Verify) -->
    <bpmn:sequenceFlow id="SequenceFlow_ZeitenPruefen" name="Ja - Zeiten vorhanden" sourceRef="Gateway_Meldezeitraum" targetRef="ServiceTask_KontaktdatenPruefen" />

    <!-- Contact Data Check -->
    <bpmn:sequenceFlow id="SequenceFlow_KontaktdatenCheck" name="Daten gepruft?" sourceRef="UserTask_ZeitenAnlegen" targetRef="ServiceTask_KontaktdatenPruefen" />
    
    <!-- Final Decision -->
    <bpmn:sequenceFlow id="SequenceFlow_ProblemCheck" name="Problem vorhanden?" sourceRef="ServiceTask_KontaktdatenPruefen" targetRef="Gateway_ProblemAufgetreten" />

    <!-- Branch for Handover -->
    <bpmn:sequenceFlow id="SequenceFlow_WeiterbearbeitungStart" name="Ja - Klärungsbedarf" sourceRef="Gateway_ProblemAufgetreten" targetRef="UserTask_Weiterbearbeitung" />
    
    <!-- End Path -->
    <bpmn:sequenceFlow id="SequenceFlow_EndEvent" name="Nein - Alles OK" sourceRef="Gateway_ProblemAufgetreten" targetRef="EndEvent_1" />

  </bpmn:process>
</bpmn:definitions>