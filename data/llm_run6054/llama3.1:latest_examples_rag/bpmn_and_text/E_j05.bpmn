<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_1">
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Check requirements for working and living in Austria">
      <outgoing>SequenceFlow_0</outgoing>
    </bpmn:startEvent>

    <bpmn:sequenceFlow id="SequenceFlow_0" sourceRef="StartEvent_1" targetRef="Task_1"/>

    <bpmn:task id="Task_1" name="Organize accommodation and bank account (negotiation)">
      <outgoing>SequenceFlow_1</outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="Task_1" targetRef="Gateway_1"/>

    <bpmn:exclusiveGateway id="Gateway_1" name="Is visa required?">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
      <outgoing>SequenceFlow_3</outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="Gateway_1" targetRef="Task_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="Gateway_1" targetRef="Task_4"/>

    <bpmn:task id="Task_2" name="Apply for visa (Rot-Weiss-Rot Card)">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_5</outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="Task_3" targetRef="Gateway_2"/>
    <bpmn:exclusiveGateway id="Gateway_2" name="Is visa application successful?">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_6</outgoing>
      <outgoing>SequenceFlow_7</outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="Task_2" targetRef="Gateway_2"/>
    <bpmn:task id="Task_3" name="Check visa requirements (every x amount of months)">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="Gateway_2" targetRef="Task_5"/>
    <bpmn:sequenceFlow id="SequenceFlow_7" sourceRef="Gateway_2" targetRef="EndEvent_1"/>

    <bpmn:task id="Task_4" name="Check visa requirements (every x amount of months)">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_9</outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_8" sourceRef="Task_3" targetRef="Gateway_3"/>
    <bpmn:exclusiveGateway id="Gateway_3" name="Is visa renewal required?">
      <incoming>SequenceFlow_8</incoming>
      <outgoing>SequenceFlow_10</outgoing>
      <outgoing>SequenceFlow_11</outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="SequenceFlow_9" sourceRef="Task_4" targetRef="Gateway_3"/>
    <bpmn:task id="Task_5" name="Receive visa (Rot-Weiss-Rot Card)">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_12</outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="Gateway_3" targetRef="Task_7"/>
    <bpmn:sequenceFlow id="SequenceFlow_11" sourceRef="Gateway_3" targetRef="EndEvent_1"/>

    <bpmn:task id="Task_6" name="Apply for visa (Rot-Weiss-Rot Card)">
      <incoming>SequenceFlow_10</incoming>
      <outgoing>SequenceFlow_13</outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_12" sourceRef="Task_5" targetRef="EndEvent_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_13" sourceRef="Task_6" targetRef="EndEvent_1"/>

    <bpmn:endEvent id="EndEvent_1" name="Process finished">
      <incoming>SequenceFlow_7</incoming>
      <incoming>SequenceFlow_11</incoming>
      <incoming>SequenceFlow_12</incoming>
      <incoming>SequenceFlow_13</incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>