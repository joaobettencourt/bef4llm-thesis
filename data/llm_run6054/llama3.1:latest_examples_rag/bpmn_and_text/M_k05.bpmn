<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             targetNamespace="http://bpmn.io/schema/bpmn"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <collaboration id="Collaboration_1" name="Building a House">
    <participant id="Participant_1" processRef="Process_1" name="You"/>
    <participant id="Participant_2" processRef="Process_1" name="Tree House Architect"/>
  </collaboration>
  <process id="Process_1" isExecutable="false" name="Building a House">
    <startEvent id="StartEvent_1" name="Collect Requirements">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>
    <serviceTask id="Task_1" name="Send Requirements to Architect">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </serviceTask>
    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="Task_2"/>
    <serviceTask id="Task_2" name="Receive Draft from Architect">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
    </serviceTask>
    <sequenceFlow id="SequenceFlow_3" sourceRef="Task_2" targetRef="Task_3"/>
    <serviceTask id="Task_3" name="Refine Draft with Additional Requirements">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_4</outgoing>
    </serviceTask>
    <sequenceFlow id="SequenceFlow_4" sourceRef="Task_3" targetRef="Task_4"/>
    <serviceTask id="Task_4" name="Create List of Needed Materials">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_5</outgoing>
    </serviceTask>
    <sequenceFlow id="SequenceFlow_5" sourceRef="Task_4" targetRef="Task_5"/>
    <serviceTask id="Task_5" name="Order Materials from Online Stores">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </serviceTask>
    <sequenceFlow id="SequenceFlow_6" sourceRef="Task_5" targetRef="Task_6"/>
    <serviceTask id="Task_6" name="Send Messages to Friends to Build House">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </serviceTask>
    <sequenceFlow id="SequenceFlow_7" sourceRef="Task_6" targetRef="EndEvent_1"/>
    <endEvent id="EndEvent_1" name="House Built">
      <incoming>SequenceFlow_7</incoming>
    </endEvent>
  </process>
</definitions>