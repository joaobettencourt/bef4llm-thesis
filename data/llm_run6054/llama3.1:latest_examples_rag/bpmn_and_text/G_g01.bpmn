<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
                  targetNamespace="http://bpmn.io/schema/bpmn" id="Definitions_1"
                  xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/BPMN20.xsd">
  <bpmn:process id="LAN_Party" isExecutable="false">
    <bpmn:startEvent id="Start_LAN_Party_1">
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Send_invitations_2" name="Send invitations to 10 friends">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="Start_LAN_Party_1" targetRef="Send_invitations_2"/>
    <bpmn:serviceTask id="Find_games_3" name="Find out which games friends want to play">
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway_4" name="8 or more people agree on date?">
      <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="Send_invitations_2" targetRef="Find_games_3"/>
    <bpmn:serviceTask id="Download_missing_games_6" name="Download missing games">
      <bpmn:incoming>SequenceFlow_7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="Find_games_3" targetRef="ExclusiveGateway_4"/>
    <bpmn:serviceTask id="Find_out_beer_requirements_8" name="Find out how much beer friends will require">
      <bpmn:incoming>SequenceFlow_9</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="SequenceFlow_7" sourceRef="ExclusiveGateway_4" targetRef="Download_missing_games_6"/>
    <bpmn:endEvent id="End_LAN_Party_10">
      <bpmn:incoming>SequenceFlow_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow_9" sourceRef="ExclusiveGateway_4" targetRef="Find_out_beer_requirements_8"/>
    <bpmn:sequenceFlow id="SequenceFlow_11" sourceRef="Download_missing_games_6" targetRef="End_LAN_Party_10"/>
    <bpmn:sequenceFlow id="SequenceFlow_13" sourceRef="Find_out_beer_requirements_8" targetRef="End_LAN_Party_10"/>
  </bpmn:process>
</bpmn:definitions>