                  targetNamespace="http://bpmn.io/schema/bpmn" id="Definitions_1" name="Service for Your Fridge">
  <bpmn:collaboration id="Collaboration_0geryc1">
    <bpmn:participant id="Participant_0ygkg4f" processRef="Process_1"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Your fridge produces strange noises">
      <bpmn:outgoing>SequenceFlow_0iu9po7</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="SequenceFlow_0iu9po7" sourceRef="StartEvent_1" targetRef="ServiceTask_12j0pib"/>
    <bpmn:serviceTask id="ServiceTask_12j0pib" name="Describe symptoms and send to central fridge service center">
      <bpmn:incoming>SequenceFlow_0iu9po7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1j94oja</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway_0p2e5vq" name="Select local service facility">
      <bpmn:incoming>SequenceFlow_1j94oja</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0kz5g1t</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="SequenceFlow_1j94oja" sourceRef="ServiceTask_12j0pib" targetRef="ExclusiveGateway_0p2e5vq"/>
    <bpmn:serviceTask id="ServiceTask_0jsoxba" name="Make appointment">
      <bpmn:incoming>SequenceFlow_0kz5g1t</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0mp5byl</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="SequenceFlow_0kz5g1t" sourceRef="ExclusiveGateway_0p2e5vq" targetRef="ServiceTask_0jsoxba"/>
    <bpmn:exclusiveGateway id="ExclusiveGateway_1dgb4sg" name="Fridge repair">
      <bpmn:incoming>SequenceFlow_0mp5byl</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0buzwss</bpmn:outgoing>
