    <bpmn:sequenceFlow id="SequenceFlow_0mp5byl" sourceRef="ServiceTask_0jsoxba" targetRef="ExclusiveGateway_1dgb4sg"/>
    <bpmn:endEvent id="EndEvent_1fx9yp3" name="Fridge repair completed">
      <bpmn:incoming>SequenceFlow_0buzwss</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
