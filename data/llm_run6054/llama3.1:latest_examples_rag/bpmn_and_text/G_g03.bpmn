<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
                  targetNamespace="http://bpmn.io/schema/bpmn" id="Blizzard_Online_Character_Generator">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" processRef="Process_1"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:startEvent id="Start_Event">
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Select_Course_Task" name="select course">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Free_Spots_Gateway" name="free spots?">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="System_Shows_Parallel_Courses_Task" name="system shows parallel courses and dates">
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Select_Specific_Course_Task" name="select specific course">
      <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Already_Registered_Gateway" name="already registered?">
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Check_If_Registered_At_Eligible_University_Task" name="check if registered at eligible university">
      <bpmn:incoming>SequenceFlow_7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Log_In_To_Account_Task" name="log into account">
      <bpmn:incoming>SequenceFlow_8</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Eligible_University_Gateway" name="eligible university?">
      <bpmn:incoming>SequenceFlow_9</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_11</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Register_Account_Task" name="register account">
      <bpmn:incoming>SequenceFlow_11</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Request_Activation_Task" name="request activation">
      <bpmn:incoming>SequenceFlow_12</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="System_Checks_Eligibility_Task" name="system checks eligibility">
      <bpmn:incoming>SequenceFlow_14</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Person_Eligible_Gateway" name="person eligible?">
      <bpmn:incoming>SequenceFlow_15</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_16</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Connect_To_Twitter_Account_Task" name="connect to twitter account">
      <bpmn:incoming>SequenceFlow_16</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Invite_Friends_To_Course_Task" name="invite friends to course">
      <bpmn:incoming>SequenceFlow_17</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Provide_Payment_Info_Task" name="provide payment info">
      <bpmn:incoming>SequenceFlow_18</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="System_Issues_Course_Tickets_Task" name="system issues course tickets ">
      <bpmn:incoming>SequenceFlow_19</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Event">
      <bpmn:incoming>SequenceFlow_20</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_21</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="Start_Event" targetRef="Select_Course_Task"/>
  <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="Select_Course_Task" targetRef="Free_Spots_Gateway"/>
  <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="Free_Spots_Gateway" targetRef="System_Shows_Parallel_Courses_Task"/>
  <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="Free_Spots_Gateway" targetRef="Select_Specific_Course_Task"/>
  <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="System_Shows_Parallel_Courses_Task" targetRef="Select_Specific_Course_Task"/>
  <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="Select_Specific_Course_Task" targetRef="Already_Registered_Gateway"/>
  <bpmn:sequenceFlow id="SequenceFlow_7" sourceRef="Already_Registered_Gateway" targetRef="Check_If_Registered_At_Eligible_University_Task"/>
  <bpmn:sequenceFlow id="SequenceFlow_8" sourceRef="Already_Registered_Gateway" targetRef="Log_In_To_Account_Task"/>
  <bpmn:sequenceFlow id="SequenceFlow_9" sourceRef="Check_If_Registered_At_Eligible_University_Task" targetRef="Eligible_University_Gateway"/>
  <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="Log_In_To_Account_Task" targetRef="Eligible_University_Gateway"/>
  <bpmn:sequenceFlow id="SequenceFlow_11" sourceRef="Eligible_University_Gateway" targetRef="Register_Account_Task"/>
  <bpmn:sequenceFlow id="SequenceFlow_12" sourceRef="Eligible_University_Gateway" targetRef="Request_Activation_Task"/>
  <bpmn:sequenceFlow id="SequenceFlow_13" sourceRef="Register_Account_Task" targetRef="Person_Eligible_Gateway"/>
  <bpmn:sequenceFlow id="SequenceFlow_14" sourceRef="Request_Activation_Task" targetRef="System_Checks_Eligibility_Task"/>
  <bpmn:sequenceFlow id="SequenceFlow_15" sourceRef="System_Checks_Eligibility_Task" targetRef="Person_Eligible_Gateway"/>
  <bpmn:sequenceFlow id="SequenceFlow_16" sourceRef="Person_Eligible_Gateway" targetRef="Connect_To_Twitter_Account_Task"/>
  <bpmn:sequenceFlow id="SequenceFlow_17" sourceRef="Person_Eligible_Gateway" targetRef="Invite_Friends_To_Course_Task"/>
  <bpmn:sequenceFlow id="SequenceFlow_18" sourceRef="Connect_To_Twitter_Account_Task" targetRef="Provide_Payment_Info_Task"/>
  <bpmn:sequenceFlow id="SequenceFlow_19" sourceRef="Invite_Friends_To_Course_Task" targetRef="System_Issues_Course_Tickets_Task"/>
  <bpmn:sequenceFlow id="SequenceFlow_20" sourceRef="Provide_Payment_Info_Task" targetRef="End_Event"/>
  <bpmn:sequenceFlow id="SequenceFlow_21" sourceRef="System_Issues_Course_Tickets_Task" targetRef="End_Event"/>
</bpmn:definitions>