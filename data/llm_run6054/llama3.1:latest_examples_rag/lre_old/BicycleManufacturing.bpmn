    <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="ExclusiveGateway_2" targetRef="EndEvent_3"/>
    <bpmn:sequenceFlow id="SequenceFlow_11" sourceRef="ExclusiveGateway_2" targetRef="Task_5"/>
    <bpmn:task id="Task_5" name="Assemble bicycle">
