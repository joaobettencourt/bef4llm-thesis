    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_3" name="Prepare assembling">
      <bpmn:outgoing>SequenceFlow_8</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_4" name="Prepare assembling">
      <bpmn:incoming>SequenceFlow_8</bpmn:incoming>
