<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_0" name="INQ" processRef="Process_1"/>
    <bpmn:participant id="Participant_1" name="IP" processRef="Process_2"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_0" name="">
        <bpmn:flowNodeRef>StartNoneEvent_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndMessageEvent_0</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent name="" id="StartNoneEvent_0">
      <bpmn:outgoing>SequenceFlow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task name="Transmit transaction data request" id="Task_0">
      <bpmn:incoming>SequenceFlow_0</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent name="" id="EndMessageEvent_0">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:process id="Process_2" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_1" name="">
        <bpmn:flowNodeRef>StartMessageEvent_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndNoneEvent_0</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent name="" id="StartMessageEvent_0">
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task name="Check request" id="Task_1">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway name="" id="ExclusiveGateway_0">
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task name="Transmit data" id="Task_2">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent name="" id="EndNoneEvent_0">
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="StartMessageEvent_0" targetRef="Task_1"/>
  <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="Task_1" targetRef="ExclusiveGateway_0"/>
  <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_0" targetRef="Task_2"/>
  <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="ExclusiveGateway_0" targetRef="EndNoneEvent_1"/>
  <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="Task_2" targetRef="EndNoneEvent_0"/>
