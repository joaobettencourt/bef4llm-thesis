<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                   xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
                   xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
                   id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Contract Project">
      <bpmn:outgoing>SequenceFlow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="SequenceFlow_0" sourceRef="StartEvent_1" targetRef="Task_1"/>
    <bpmn:manualTask id="Task_1" name="Query webshops for part">
      <bpmn:incoming>SequenceFlow_0</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="Task_1" targetRef="Task_2"/>
    <bpmn:manualTask id="Task_2" name="Find out delivery details">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="Task_2" targetRef="ServiceTask_1"/>
    <bpmn:serviceTask id="ServiceTask_1" name="Compare prices">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway_1" name="All required parts covered?">
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="ServiceTask_1" targetRef="ExclusiveGateway_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_4" name="yes" sourceRef="ExclusiveGateway_1" targetRef="Task_3"/>
    <bpmn:manualTask id="Task_3" name="Select required part">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:sequenceFlow id="SequenceFlow_5" name="no" sourceRef="ExclusiveGateway_1" targetRef="ServiceTask_2"/>
    <bpmn:serviceTask id="ServiceTask_2" name="Generate list of parts with cheapest price">
      <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="Task_3" targetRef="ServiceTask_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_7" sourceRef="ServiceTask_2" targetRef="ExclusiveGateway_2"/>
    <bpmn:exclusiveGateway id="ExclusiveGateway_2" name="">
      <bpmn:incoming>SequenceFlow_7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_8</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="SequenceFlow_8" sourceRef="ExclusiveGateway_2" targetRef="Task_4"/>
    <bpmn:manualTask id="Task_4" name="Order parts">
      <bpmn:incoming>SequenceFlow_8</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:sequenceFlow id="SequenceFlow_9" sourceRef="ExclusiveGateway_2" targetRef="ParallelGateway_1"/>
    <bpmn:parallelGateway id="ParallelGateway_1" name="">
      <bpmn:incoming>SequenceFlow_9</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_11</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_12</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="Task_4" targetRef="ParallelGateway_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_11" sourceRef="ParallelGateway_1" targetRef="ExclusiveGateway_3"/>
    <bpmn:exclusiveGateway id="ExclusiveGateway_3" name="part already ordered?">
      <bpmn:incoming>SequenceFlow_11</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_13</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="SequenceFlow_12" sourceRef="ParallelGateway_1" targetRef="ExclusiveGateway_3"/>
    <bpmn:sequenceFlow id="SequenceFlow_13" name="yes" sourceRef="ExclusiveGateway_3" targetRef="Task_5"/>
    <bpmn:manualTask id="Task_5" name="Update stock">
      <bpmn:incoming>SequenceFlow_13</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_15</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:sequenceFlow id="SequenceFlow_14" name="no" sourceRef="ExclusiveGateway_3" targetRef="ServiceTask_3"/>
    <bpmn:serviceTask id="ServiceTask_3" name="Order fastest part">
      <bpmn:incoming>SequenceFlow_14</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="SequenceFlow_15" sourceRef="Task_5" targetRef="ServiceTask_3"/>
    <bpmn:sequenceFlow id="SequenceFlow_16" sourceRef="ServiceTask_3" targetRef="ExclusiveGateway_4"/>
    <bpmn:exclusiveGateway id="ExclusiveGateway_4" name="">
      <bpmn:incoming>SequenceFlow_16</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_17</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="SequenceFlow_17" sourceRef="ExclusiveGateway_4" targetRef="Task_6"/>
    <bpmn:manualTask id="Task_6" name="Update accounting">
      <bpmn:incoming>SequenceFlow_17</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_19</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:sequenceFlow id="SequenceFlow_18" sourceRef="ExclusiveGateway_4" targetRef="EndEvent_1"/>
    <bpmn:endEvent id="EndEvent_1" name="contract finished">
      <bpmn:incoming>SequenceFlow_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow_19" sourceRef="Task_6" targetRef="EndEvent_1"/>
  </bpmn:process>
</bpmn:definitions>