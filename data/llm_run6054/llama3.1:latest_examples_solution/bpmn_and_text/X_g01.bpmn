<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/2.0"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_1"
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="wish to enroll in course">
      <bpmn:outgoing>SequenceFlow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask_1" name="select course">
      <bpmn:incoming>SequenceFlow_0</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway_1" name="free spots?">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask_1" name="system shows parallel courses and dates">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UserTask_2" name="select specific course">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway_2" name="already registered?">
      <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask_3" name="check if registered at eligible university">
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask_4" name="log into account">
      <bpmn:incoming>SequenceFlow_7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway_3" name="eligible university?">
      <bpmn:incoming>SequenceFlow_8</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask_5" name="register account">
      <bpmn:incoming>SequenceFlow_10</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask_6" name="request activation">
      <bpmn:incoming>SequenceFlow_11</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask_2" name="system checks eligibility">
      <bpmn:incoming>SequenceFlow_13</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway_4" name="person eligible?">
      <bpmn:incoming>SequenceFlow_14</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_15</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask_7" name="connect to twitter account">
      <bpmn:incoming>SequenceFlow_15</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask_8" name="invite friends to course">
      <bpmn:incoming>SequenceFlow_16</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask_9" name="provide payment info">
      <bpmn:incoming>SequenceFlow_17</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask_3" name="system issues course tickets ">
      <bpmn:incoming>SequenceFlow_18</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_20</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_1" name="end process">
      <bpmn:incoming>SequenceFlow_20</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:sequenceFlow id="SequenceFlow_0" sourceRef="StartEvent_1" targetRef="UserTask_1"/>
  <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="UserTask_1" targetRef="ExclusiveGateway_1"/>
  <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="ExclusiveGateway_1" targetRef="ServiceTask_1"/>
  <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_1" targetRef="UserTask_2"/>
  <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="ServiceTask_1" targetRef="UserTask_2"/>
  <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="UserTask_2" targetRef="ExclusiveGateway_2"/>
  <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="ExclusiveGateway_2" targetRef="UserTask_3"/>
  <bpmn:sequenceFlow id="SequenceFlow_7" sourceRef="ExclusiveGateway_2" targetRef="UserTask_4"/>
  <bpmn:sequenceFlow id="SequenceFlow_8" sourceRef="UserTask_3" targetRef="ExclusiveGateway_3"/>
  <bpmn:sequenceFlow id="SequenceFlow_9" sourceRef="UserTask_4" targetRef="ExclusiveGateway_3"/>
  <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="ExclusiveGateway_3" targetRef="UserTask_5"/>
  <bpmn:sequenceFlow id="SequenceFlow_11" sourceRef="ExclusiveGateway_3" targetRef="UserTask_6"/>
  <bpmn:sequenceFlow id="SequenceFlow_12" sourceRef="UserTask_5" targetRef="ServiceTask_2"/>
  <bpmn:sequenceFlow id="SequenceFlow_13" sourceRef="UserTask_6" targetRef="ServiceTask_2"/>
  <bpmn:sequenceFlow id="SequenceFlow_14" sourceRef="ServiceTask_2" targetRef="ExclusiveGateway_4"/>
  <bpmn:sequenceFlow id="SequenceFlow_15" sourceRef="ExclusiveGateway_4" targetRef="UserTask_7"/>
  <bpmn:sequenceFlow id="SequenceFlow_16" sourceRef="ExclusiveGateway_4" targetRef="UserTask_8"/>
  <bpmn:sequenceFlow id="SequenceFlow_17" sourceRef="UserTask_7" targetRef="UserTask_9"/>
  <bpmn:sequenceFlow id="SequenceFlow_18" sourceRef="UserTask_8" targetRef="ServiceTask_3"/>
  <bpmn:sequenceFlow id="SequenceFlow_19" sourceRef="UserTask_9" targetRef="ServiceTask_3"/>
  <bpmn:sequenceFlow id="SequenceFlow_20" sourceRef="ServiceTask_3" targetRef="EndEvent_1"/>
</bpmn:definitions>