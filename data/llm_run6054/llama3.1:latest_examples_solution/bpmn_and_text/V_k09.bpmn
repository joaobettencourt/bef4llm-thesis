<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="Storage management"
             targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Storage management">
      <bpmn:outgoing>SequenceFlow_ID_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="ServiceTask_1" name="Read order">
      <bpmn:incoming>SequenceFlow_ID_0</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ID_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway_1" name="Is in stock?">
      <bpmn:incoming>SequenceFlow_ID_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ID_2</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ID_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask_2" name="Withdraw the Product from warehouse">
      <bpmn:incoming>SequenceFlow_ID_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ID_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway_2" name="Arrived after more than ten days?">
      <bpmn:incoming>SequenceFlow_ID_3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ID_5</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ID_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask_3" name="Demand delivery delay penalty from the wholesaler">
      <bpmn:incoming>SequenceFlow_ID_5</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ID_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_1" name="Order was shipped">
      <bpmn:incoming>SequenceFlow_ID_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow_ID_0" sourceRef="StartEvent_1" targetRef="ServiceTask_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_ID_1" sourceRef="ServiceTask_1" targetRef="ExclusiveGateway_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_ID_2" name="Yes" sourceRef="ExclusiveGateway_1" targetRef="ServiceTask_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_ID_3" name="No" sourceRef="ExclusiveGateway_1" targetRef="ExclusiveGateway_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_ID_4" sourceRef="ServiceTask_2" targetRef="ExclusiveGateway_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_ID_5" name="Yes" sourceRef="ExclusiveGateway_2" targetRef="ServiceTask_3"/>
    <bpmn:sequenceFlow id="SequenceFlow_ID_6" name="No" sourceRef="ExclusiveGateway_2" targetRef="ExclusiveGateway_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_ID_7" sourceRef="ServiceTask_3" targetRef="EndEvent_1"/>
    <bpmn:serviceTask id="ServiceTask_4" name="Register in stock management system">
      <bpmn:incoming>SequenceFlow_ID_9</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ID_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_2" name="Order was shipped">
      <bpmn:incoming>SequenceFlow_ID_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow_ID_8" sourceRef="ServiceTask_4" targetRef="EndEvent_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_ID_9" sourceRef="ExclusiveGateway_1" targetRef="ServiceTask_4"/>
    <bpmn:sequenceFlow id="SequenceFlow_ID_10" sourceRef="ServiceTask_4" targetRef="ExclusiveGateway_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_ID_11" sourceRef="ServiceTask_5" targetRef="EndEvent_2"/>
  </bpmn:process>
</bpmn:definitions>