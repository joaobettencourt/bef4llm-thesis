<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                   xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
                   xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
                   targetNamespace="http://bpmn.io/schema/bpmn" id="Definitions_1">
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Start">
      <outgoing>SequenceFlow_ID_0</outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask_1" name="Instruct an artist to create a 3D model">
      <incoming>SequenceFlow_ID_0</incoming>
      <outgoing>SequenceFlow_ID_1</outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway_1" gatewayDirection="Diverging" name="Have you the color at home?">
      <incoming>SequenceFlow_ID_1</incoming>
      <outgoing>SequenceFlow_ID_2</outgoing>
      <outgoing>SequenceFlow_ID_3</outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask_2" name="Tell artist what to change">
      <incoming>SequenceFlow_ID_2</incoming>
      <outgoing>SequenceFlow_ID_4</outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway_2" gatewayDirection="Diverging" name="Satisfied with the result?">
      <incoming>SequenceFlow_ID_4</incoming>
      <outgoing>SequenceFlow_ID_5</outgoing>
      <outgoing>SequenceFlow_ID_6</outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask_3" name="Choose a plastic color for model">
      <incoming>SequenceFlow_ID_3</incoming>
      <outgoing>SequenceFlow_ID_7</outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway_3" gatewayDirection="Diverging" name="Is it under 100 grams?">
      <incoming>SequenceFlow_ID_7</incoming>
      <outgoing>SequenceFlow_ID_8</outgoing>
      <outgoing>SequenceFlow_ID_9</outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask_4" name="Put it on your shopping list">
      <incoming>SequenceFlow_ID_8</incoming>
      <outgoing>SequenceFlow_ID_10</outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway_4" gatewayDirection="Converging" name="">
      <incoming>SequenceFlow_ID_10</incoming>
      <incoming>SequenceFlow_ID_11</incoming>
      <outgoing>SequenceFlow_ID_12</outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask_5" name="Order it">
      <incoming>SequenceFlow_ID_9</incoming>
      <outgoing>SequenceFlow_ID_13</outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask_1" name="Program generates gcode file from STL">
      <incoming>SequenceFlow_ID_11</incoming>
      <outgoing>SequenceFlow_ID_14</outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UserTask_6" name="Turn on the printer">
      <incoming>SequenceFlow_ID_12</incoming>
      <outgoing>SequenceFlow_ID_15</outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_1" name="End">
      <incoming>SequenceFlow_ID_14</incoming>
      <incoming>SequenceFlow_ID_16</incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="StartEvent_1_shape" bpmnElement="StartEvent_1">
        <!-- BPMN model layout is not included in the XML output -->
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SequenceFlow_ID_0" sourceRef="StartEvent_1_shape" targetRef="UserTask_1_shape"/>
      <bpmndi:BPMNEdge id="SequenceFlow_ID_1" sourceRef="UserTask_1_shape" targetRef="ExclusiveGateway_1_shape"/>
      <bpmndi:BPMNEdge id="SequenceFlow_ID_2" sourceRef="ExclusiveGateway_1_shape" targetRef="UserTask_2_shape"/>
      <bpmndi:BPMNEdge id="SequenceFlow_ID_3" sourceRef="ExclusiveGateway_1_shape" targetRef="UserTask_3_shape"/>
      <bpmndi:BPMNEdge id="SequenceFlow_ID_4" sourceRef="UserTask_2_shape" targetRef="ExclusiveGateway_2_shape"/>
      <bpmndi:BPMNEdge id="SequenceFlow_ID_5" sourceRef="ExclusiveGateway_2_shape" targetRef="EndEvent_1_shape"/>
      <bpmndi:BPMNEdge id="SequenceFlow_ID_6" sourceRef="ExclusiveGateway_2_shape" targetRef="ServiceTask_1_shape"/>
      <bpmndi:BPMNEdge id="SequenceFlow_ID_7" sourceRef="UserTask_3_shape" targetRef="ExclusiveGateway_3_shape"/>
      <bpmndi:BPMNEdge id="SequenceFlow_ID_8" sourceRef="ExclusiveGateway_3_shape" targetRef="UserTask_4_shape"/>
      <bpmndi:BPMNEdge id="SequenceFlow_ID_9" sourceRef="ExclusiveGateway_3_shape" targetRef="ServiceTask_1_shape"/>
      <bpmndi:BPMNEdge id="SequenceFlow_ID_10" sourceRef="UserTask_4_shape" targetRef="ExclusiveGateway_4_shape"/>
      <bpmndi:BPMNEdge id="SequenceFlow_ID_11" sourceRef="ServiceTask_1_shape" targetRef="ExclusiveGateway_4_shape"/>
      <bpmndi:BPMNEdge id="SequenceFlow_ID_12" sourceRef="ExclusiveGateway_4_shape" targetRef="UserTask_6_shape"/>
      <bpmndi:BPMNEdge id="SequenceFlow_ID_13" sourceRef="ServiceTask_1_shape" targetRef="EndEvent_1_shape"/>
      <bpmndi:BPMNEdge id="SequenceFlow_ID_14" sourceRef="ExclusiveGateway_4_shape" targetRef="UserTask_6_shape"/>
      <bpmndi:BPMNEdge id="SequenceFlow_ID_15" sourceRef="UserTask_6_shape" targetRef="EndEvent_1_shape"/>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>