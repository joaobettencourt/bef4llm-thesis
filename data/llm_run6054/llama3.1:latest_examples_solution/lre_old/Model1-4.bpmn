        <bpmn:flowNodeRef>Task_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateCatchEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Start">
      <bpmn:outgoing>SequenceFlow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="ParallelGateway_0">
      <bpmn:incoming>SequenceFlow_0</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_0" name="Check facts presented">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="ExclusiveGateway_0" name="allright?">
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_1">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:parallelGateway id="ParallelGateway_1">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_1" name="Prepare registration statement for approval of SEC">
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_2" name="Check compliance with laws">
      <bpmn:incoming>SequenceFlow_7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_0" name="">
      <bpmn:incoming>SequenceFlow_8</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    <bpmn:parallelGateway id="ParallelGateway_2">
      <bpmn:incoming>SequenceFlow_9</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_10</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_11</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_3" name="Talk to potential investors">
      <bpmn:incoming>SequenceFlow_11</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_1" name="Answer from SEC">
      <bpmn:incoming>SequenceFlow_12</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_13</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="ExclusiveGateway_1" name="Approved?">
      <bpmn:incoming>SequenceFlow_13</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_14</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_4" name="Fix issue price">
      <bpmn:incoming>SequenceFlow_14</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_5" name="Buy stock">
      <bpmn:incoming>SequenceFlow_15</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_6" name="Offer to public">
      <bpmn:incoming>SequenceFlow_16</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_2">
      <bpmn:incoming>SequenceFlow_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow_0" sourceRef="StartEvent_1"
                       targetRef="ParallelGateway_0"/>
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="ParallelGateway_0"
                       targetRef="Task_0"/>
    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="ParallelGateway_0"
                       targetRef="ParallelGateway_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="Task_0"
                       targetRef="ExclusiveGateway_0"/>
    <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_0"
                       targetRef="EndEvent_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="ExclusiveGateway_0"
                       targetRef="ParallelGateway_1"/>
