                       targetRef="Task_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_7" sourceRef="ParallelGateway_1"
                       targetRef="Task_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_8" sourceRef="Task_1"
                       targetRef="IntermediateCatchEvent_0"/>
    <bpmn:sequenceFlow id="SequenceFlow_9" sourceRef="Task_2"
                       targetRef="ParallelGateway_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="IntermediateCatchEvent_0"
                       targetRef="ParallelGateway_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_11" sourceRef="ParallelGateway_2"
                       targetRef="Task_3"/>
    <bpmn:sequenceFlow id="SequenceFlow_12" sourceRef="Task_3"
                       targetRef="IntermediateCatchEvent_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_13" sourceRef="IntermediateCatchEvent_1"
                       targetRef="ExclusiveGateway_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_14" sourceRef="ExclusiveGateway_1"
                       targetRef="Task_4"/>
    <bpmn:sequenceFlow id="SequenceFlow_15" sourceRef="ExclusiveGateway_1"
                       targetRef="Task_5"/>
    <bpmn:sequenceFlow id="SequenceFlow_16" sourceRef="Task_4"
                       targetRef="Task_6"/>
    <bpmn:sequenceFlow id="SequenceFlow_17" sourceRef="Task_5"
                       targetRef="EndEvent_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_18" sourceRef="Task_6"
                       targetRef="EndEvent_2"/>
  </bpmn:process>
