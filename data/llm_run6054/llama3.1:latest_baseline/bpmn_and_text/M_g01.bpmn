  <bpmn:collaboration id="Collaboration_0geryc1">
    <bpmn:participant id="Participant_0ygkg4f" name="Artist" processRef="Process_1" />
    <bpmn:participant id="Participant_1jsoxba" name="Customer" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_1viot5w" name="Artist">
        <bpmn:flowNodeRef>Task_12j0pib</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_0vaxgaa</bpmn:flowNodeRef>
      </bpmn:lane>
