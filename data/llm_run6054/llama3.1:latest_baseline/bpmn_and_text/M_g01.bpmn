    <!-- Core Flow Elements -->
    <bpmn:sequenceFlow id="SequenceFlow_035vf60" sourceRef="ExclusiveGateway_1ouv9kf" targetRef="Task_05ftug5" />
    <bpmn:sequenceFlow id="SequenceFlow_06kfaev" sourceRef="Task_05ftug5" targetRef="EndEvent_1fx9yp3" />
  </bpmn:process>
