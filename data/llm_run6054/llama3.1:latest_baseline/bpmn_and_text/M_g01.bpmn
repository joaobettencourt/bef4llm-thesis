    <bpmn:sequenceFlow id="SequenceFlow_0iu9po7" name="Color in stock" sourceRef="ExclusiveGateway_1mpgzhg" targetRef="Task_05ftug5" />
    <bpmn:sequenceFlow id="SequenceFlow_1xv6wk4" name="Order color" sourceRef="ExclusiveGateway_1mpgzhg" targetRef="Task_0e6hvnj" />
    <bpmn:endEvent id="EndEvent_1fx9yp3" name="Print 3D model">
