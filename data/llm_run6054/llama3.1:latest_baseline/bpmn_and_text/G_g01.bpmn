    <!-- Core Flow Elements -->
    <bpmn:startEvent id="StartEvent_1" name="Plan LAN party">
      <bpmn:outgoing>SequenceFlow_14a0oky</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_12j0pib" name="Send invitations to 10 friends">
