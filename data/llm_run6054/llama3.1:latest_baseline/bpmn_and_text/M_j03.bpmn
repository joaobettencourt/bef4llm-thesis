    <bpmn:sequenceFlow id="SequenceFlow_06kfaev" sourceRef="Task_05ftug5" targetRef="ExclusiveGateway_0z5sib0" />
    <bpmn:sequenceFlow id="SequenceFlow_035vf60" sourceRef="ExclusiveGateway_0z5sib0" targetRef="EndEvent_1fx9yp3" />
  </bpmn:process>
