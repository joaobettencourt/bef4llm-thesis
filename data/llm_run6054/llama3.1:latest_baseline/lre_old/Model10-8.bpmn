                   id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_0geryc1">
    <bpmn:participant id="Participant_0ygkg4f" name="MSPO" processRef="Process_1"/>
    <bpmn:participant id="Participant_0ygkg5a" name="GO" processRef="Process_1"/>
  </bpmn:collaboration>
  
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_1viot5w" name="MSPO">
        <bpmn:flowNodeRef>Task_12j0pib</bpmn:flowNodeRef>
      </bpmn:lane>
      
      <bpmn:lane id="Lane_1ocseyo" name="GO">
        <bpmn:flowNodeRef>Task_0jsoxba</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_0e6hvnj</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_0s79ile</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    
    <!-- Core Flow Elements -->
    <bpmn:startEvent id="StartEvent_1" name="MSPO deregisters at GO">
      <bpmn:outgoing>SequenceFlow_14a0oky</bpmn:outgoing>
    </bpmn:startEvent>
    
    <bpmn:task id="Task_12j0pib" name="Deregister at GO">
      <bpmn:incoming>SequenceFlow_14a0oky</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1j94oja</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_14a0oky" sourceRef="StartEvent_1" targetRef="Task_12j0pib"/>
    <bpmn:sequenceFlow id="SequenceFlow_1j94oja" sourceRef="Task_12j0pib" targetRef="ExclusiveGateway_1mpgzhg"/>
    
    <!-- Exclusive Gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_1mpgzhg" name="GO verifies deregistration">
      <bpmn:incoming>SequenceFlow_1j94oja</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0iu9po7</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_1xv6wk4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_0iu9po7" sourceRef="ExclusiveGateway_1mpgzhg" targetRef="Task_0jsoxba"/>
    <bpmn:sequenceFlow id="SequenceFlow_1xv6wk4" sourceRef="ExclusiveGateway_1mpgzhg" targetRef="Task_0e6hvnj"/>
    
    <!-- Tasks -->
    <bpmn:task id="Task_0jsoxba" name="Verify deregistration">
      <bpmn:incoming>SequenceFlow_0iu9po7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0mp5byl</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Exclusive Gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_1ouv9kf" name="GO rejects or preliminarily confirms deregistration">
      <bpmn:incoming>SequenceFlow_0mp5byl</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_035vf60</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_0mp5byl" sourceRef="Task_0jsoxba" targetRef="ExclusiveGateway_1ouv9kf"/>
    <bpmn:sequenceFlow id="SequenceFlow_035vf60" sourceRef="ExclusiveGateway_1ouv9kf" targetRef="Task_0s79ile"/>
    
    <!-- Tasks -->
    <bpmn:task id="Task_0e6hvnj" name="Assign GO as MSP">
      <bpmn:incoming>SequenceFlow_1xv6wk4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1pq8ub3</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Exclusive Gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_1dgb4sg" name="GO informs MSPO and MPO">
      <bpmn:incoming>SequenceFlow_1pq8ub3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0ajhekx</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_1pq8ub3" sourceRef="Task_0e6hvnj" targetRef="ExclusiveGateway_1dgb4sg"/>
    <bpmn:sequenceFlow id="SequenceFlow_0ajhekx" sourceRef="ExclusiveGateway_1dgb4sg" targetRef="EndEvent_1fx9yp3"/>
    
    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_1fx9yp3" name="Assignment completed">
      <bpmn:incoming>SequenceFlow_0ajhekx</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>