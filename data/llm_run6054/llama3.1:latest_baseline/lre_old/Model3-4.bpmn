<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                   xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                   xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Send questionnaire">
      <bpmn:outgoing>SequenceFlow_0</bpmn:outgoing>
    </bpmn:startEvent>
    
    <!-- Sequence Flow 1 -->
    <bpmn:sequenceFlow id="SequenceFlow_0" sourceRef="StartEvent_1" targetRef="Task_1"/>
    
    <!-- Task 1 -->
    <bpmn:task id="Task_1" name="Send questionnaire to claimant">
      <bpmn:incoming>SequenceFlow_0</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Sequence Flow 2 -->
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="Task_1" targetRef="IntermediateCatchEvent_1"/>
    
    <!-- Intermediate Catch Event 1 -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_1" name="No response received">
      <bpmn:eventDefinitions>
        <bpmn:eventDefinition id="EventDefinition_0" eventRef="Event_1"/>
      </bpmn:eventDefinitions>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    
    <!-- Sequence Flow 3 -->
    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="IntermediateCatchEvent_1" targetRef="Task_2"/>
    
    <!-- Task 2 -->
    <bpmn:task id="Task_2" name="Send reminder to claimant">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Sequence Flow 4 -->
    <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="Task_2" targetRef="IntermediateCatchEvent_2"/>
    
    <!-- Intermediate Catch Event 2 -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_2" name="No response received">
      <bpmn:eventDefinitions>
        <bpmn:eventDefinition id="EventDefinition_1" eventRef="Event_2"/>
      </bpmn:eventDefinitions>
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    
    <!-- Sequence Flow 5 -->
    <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="IntermediateCatchEvent_2" targetRef="Task_3"/>
    
    <!-- Task 3 -->
    <bpmn:task id="Task_3" name="Send another reminder to claimant">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Sequence Flow 6 -->
    <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="Task_3" targetRef="IntermediateCatchEvent_3"/>
    
    <!-- Intermediate Catch Event 3 -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_3" name="No response received">
      <bpmn:eventDefinitions>
        <bpmn:eventDefinition id="EventDefinition_2" eventRef="Event_3"/>
      </bpmn:eventDefinitions>
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    
    <!-- Sequence Flow 7 -->
    <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="IntermediateCatchEvent_3" targetRef="Task_4"/>
    
    <!-- Task 4 -->
    <bpmn:task id="Task_4" name="Receive completed questionnaire">
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Sequence Flow 8 -->
    <bpmn:sequenceFlow id="SequenceFlow_7" sourceRef="Task_4" targetRef="EndEvent_1"/>
    
    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_1" name="Process completed">
      <bpmn:incoming>SequenceFlow_7</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  
  <!-- Timer Events -->
  <bpmn:timerEventDefinition id="TimerEventDefinition_0">
    <bpmn:timeCycle>PT5D</bpmn:timeCycle>
  </bpmn:timerEventDefinition>
  
  <bpmn:timerEventDefinition id="TimerEventDefinition_1">
    <bpmn:timeCycle>PT5D</bpmn:timeCycle>
  </bpmn:timerEventDefinition>
  
  <bpmn:timerEventDefinition id="TimerEventDefinition_2">
    <bpmn:timeCycle>PT5D</bpmn:timeCycle>
  </bpmn:timerEventDefinition>
  
  <!-- Events -->
  <bpmn:event id="Event_1" name="No response received"/>
  <bpmn:event id="Event_2" name="No response received"/>
  <bpmn:event id="Event_3" name="No response received"/>
</bpmn:definitions>