<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                   xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                   xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Claim registered">
      <bpmn:outgoing>SequenceFlow_0iu9po7</bpmn:outgoing>
    </bpmn:startEvent>
    
    <!-- Sequence Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_0iu9po7" sourceRef="StartEvent_1" targetRef="Task_12j0pib"/>
    
    <!-- Task 1: Claims Officer Examines Claim -->
    <bpmn:task id="Task_12j0pib" name="Claims officer examines claim">
      <bpmn:incoming>SequenceFlow_0iu9po7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1j94oja</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Sequence Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_1j94oja" sourceRef="Task_12j0pib" targetRef="Task_0jsoxba"/>
    
    <!-- Task 2: Claims Officer Writes Settlement Recommendation -->
    <bpmn:task id="Task_0jsoxba" name="Claims officer writes settlement recommendation">
      <bpmn:incoming>SequenceFlow_1j94oja</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0mp5byl</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Sequence Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_0mp5byl" sourceRef="Task_0jsoxba" targetRef="ExclusiveGateway_1dgb4sg"/>
    
    <!-- Exclusive Gateway 1: Senior Claims Officer Reviews Recommendation -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_1dgb4sg">
      <bpmn:incoming>SequenceFlow_0mp5byl</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0kz5g1t</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_1pq8ub3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <!-- Sequence Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_0kz5g1t" sourceRef="ExclusiveGateway_1dgb4sg" targetRef="Task_05ftug5"/>
    
    <!-- Task 3: Claim is OK (Senior Claims Officer Marks as OK) -->
    <bpmn:task id="Task_05ftug5" name="Claim is OK">
      <bpmn:incoming>SequenceFlow_0kz5g1t</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0v64x8b</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Sequence Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_0v64x8b" sourceRef="Task_05ftug5" targetRef="EndEvent_1fx9yp3"/>
    
    <!-- Exclusive Gateway 2: Claim is Not OK (Senior Claims Officer Marks as Not OK) -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_1ouv9kf">
      <bpmn:incoming>SequenceFlow_0kz5g1t</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_035vf60</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <!-- Sequence Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_035vf60" sourceRef="ExclusiveGateway_1ouv9kf" targetRef="Task_0sl26uo"/>
    
    <!-- Task 4: Claim is Not OK (Claims Officer Repeats Recommendation) -->
    <bpmn:task id="Task_0sl26uo" name="Claim is Not OK">
      <bpmn:incoming>SequenceFlow_035vf60</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1rss71o</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Sequence Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_1rss71o" sourceRef="Task_0sl26uo" targetRef="ExclusiveGateway_1mpgzhg"/>
    
    <!-- Exclusive Gateway 3: Repeat Recommendation or Proceed with Claim Handling -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_1mpgzhg">
      <bpmn:incoming>SequenceFlow_1rss71o</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0iu9po7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <!-- Sequence Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_1pq8ub3" sourceRef="ExclusiveGateway_1dgb4sg" targetRef="Task_05ftug5"/>
    
    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_1fx9yp3" name="Claim handling process complete">
      <bpmn:incoming>SequenceFlow_0v64x8b</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>