<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                   xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                   xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_0geryc1">
    <bpmn:participant id="Participant_0ygkg4f" name="GO" processRef="Process_1"/>
    <bpmn:participant id="Participant_1jsoxba" name="MSP" processRef="Process_2"/>
  </bpmn:collaboration>
  
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_1viot5w" name="GO">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_12j0pib</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1fx9yp3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    
    <!-- Core Flow Elements -->
    <bpmn:startEvent id="StartEvent_1" name="Request measurements">
      <bpmn:outgoing>SequenceFlow_0kz5g1t</bpmn:outgoing>
    </bpmn:startEvent>
    
    <bpmn:task id="Task_12j0pib" name="Process measured values">
      <bpmn:incoming>SequenceFlow_0mp5byl</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0v64x8b</bpmn:outgoing>
    </bpmn:task>
    
    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_1fx9yp3" name="Process completed">
      <bpmn:incoming>SequenceFlow_0v64x8b</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  
  <bpmn:process id="Process_2" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_1ocseyo" name="MSP">
        <bpmn:flowNodeRef>StartEvent_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_1mpgzhg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    
    <!-- Core Flow Elements -->
    <bpmn:startEvent id="StartEvent_2" name="Receive request">
      <bpmn:outgoing>SequenceFlow_1dlbln9</bpmn:outgoing>
    </bpmn:startEvent>
    
    <bpmn:exclusiveGateway id="ExclusiveGateway_1mpgzhg" name="Deny or measure?">
      <bpmn:incoming>SequenceFlow_1dlbln9</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0iu9po7</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_1xv6wk4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_2" name="Process completed">
      <bpmn:incoming>SequenceFlow_0v64x8b</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  
  <!-- Sequence Flows -->
  <bpmn:sequenceFlow id="SequenceFlow_0kz5g1t" sourceRef="StartEvent_1" targetRef="Task_12j0pib"/>
  <bpmn:sequenceFlow id="SequenceFlow_0mp5byl" sourceRef="Task_12j0pib" targetRef="ExclusiveGateway_1mpgzhg"/>
  <bpmn:sequenceFlow id="SequenceFlow_0v64x8b" sourceRef="Task_12j0pib" targetRef="EndEvent_1fx9yp3"/>
  
  <!-- Message Flows -->
