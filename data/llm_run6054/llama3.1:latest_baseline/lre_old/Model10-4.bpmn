                   id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_0geryc1">
    <bpmn:participant id="Participant_0ygkg4f" name="MPON" processRef="Process_1"/>
    <bpmn:participant id="Participant_0ygkg5a" name="MPOO" processRef="Process_1"/>
  </bpmn:collaboration>
  
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_1viot5w" name="MPON">
        <bpmn:flowNodeRef>Task_12j0pib</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_0jsoxba</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_0vaxgaa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_0e6hvnj</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_0s79ile</bpmn:flowNodeRef>
      </bpmn:lane>
      
      <bpmn:lane id="Lane_1ocseyo" name="MPOO">
        <bpmn:flowNodeRef>Task_05ftug5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_0sl26uo</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    
    <!-- Core Flow Elements -->
    <bpmn:startEvent id="StartEvent_1" name="Notify MPON about equipment change intentions">
      <bpmn:outgoing>SequenceFlow_14a0oky</bpmn:outgoing>
    </bpmn:startEvent>
    
    <bpmn:task id="Task_12j0pib" name="MPON announces to MPOO">
      <bpmn:incoming>SequenceFlow_14a0oky</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1j94oja</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:exclusiveGateway id="ExclusiveGateway_1mpgzhg" name="MPOO announces self dismounting or no self-dismounting">
      <bpmn:incoming>SequenceFlow_1j94oja</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0iu9po7</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_1xv6wk4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_14a0oky" sourceRef="StartEvent_1" targetRef="Task_12j0pib"/>
    <bpmn:sequenceFlow id="SequenceFlow_1j94oja" sourceRef="Task_12j0pib" targetRef="ExclusiveGateway_1mpgzhg"/>
    
    <!-- Tasks -->
    <bpmn:task id="Task_05ftug5" name="MPOO dismounts old equipment">
      <bpmn:incoming>SequenceFlow_0iu9po7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0kz5g1t</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Tasks -->
    <bpmn:task id="Task_0jsoxba" name="MPON mounts new device">
      <bpmn:incoming>SequenceFlow_1xv6wk4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0mp5byl</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Tasks -->
    <bpmn:task id="Task_0vaxgaa" name="MPON reads meter count from installed meter">
      <bpmn:incoming>SequenceFlow_0mp5byl</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0buzwss</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Tasks -->
    <bpmn:task id="Task_0e6hvnj" name="MPON sends values of final reading to GO">
      <bpmn:incoming>SequenceFlow_0buzwss</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_035vf60</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Tasks -->
    <bpmn:task id="Task_0s79ile" name="MPON tells GO about device changes, master data and meter count at installation">
      <bpmn:incoming>SequenceFlow_035vf60</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_06kfaev</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Tasks -->
    <bpmn:task id="Task_0sl26uo" name="MPOO prepares for picking up goods">
      <bpmn:incoming>SequenceFlow_0kz5g1t</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0v64x8b</bpmn:outgoing>
    </bpmn:task>
    
    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_1fx9yp3" name="Final reading">
      <bpmn:incoming>SequenceFlow_0v64x8b</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>