<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                   xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                   xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_0geryc1">
    <bpmn:participant id="Participant_0ygkg4f" name="Outpatient Physician"
                      processRef="Process_1"/>
    
    <bpmn:participant id="Participant_0jsoxba" name="Nurse of the Ward"
                      processRef="Process_1"/>
    
    <bpmn:participant id="Participant_0vaxgaa" name="Ward Physician"
                      processRef="Process_1"/>
    
    <bpmn:participant id="Participant_0e6hvnj" name="Lab Physician"
                      processRef="Process_1"/>
    
    <bpmn:participant id="Participant_0s79ile" name="Medical Technical Assistant of the Lab"
                      processRef="Process_1"/>
    
    <bpmn:participant id="Participant_05ftug5" name="Physician from Outpatient Department"
                      processRef="Process_1"/>
  </bpmn:collaboration>
  
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_1viot5w" name="Outpatient Physician">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_0p2e5vq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_12j0pib</bpmn:flowNodeRef>
      </bpmn:lane>
      
      <bpmn:lane id="Lane_1ocseyo" name="Nurse of the Ward">
        <bpmn:flowNodeRef>Task_0vaxgaa</bpmn:flowNodeRef>
      </bpmn:lane>
      
      <bpmn:lane id="Lane_1vl2igx" name="Ward Physician">
        <bpmn:flowNodeRef>Task_0sl26uo</bpmn:flowNodeRef>
      </bpmn:lane>
      
      <bpmn:lane id="Lane_1ocseyo2" name="Lab Physician">
        <bpmn:flowNodeRef>Task_0e6hvnj</bpmn:flowNodeRef>
      </bpmn:lane>
      
      <bpmn:lane id="Lane_1ocseyo3" name="Medical Technical Assistant of the Lab">
        <bpmn:flowNodeRef>Task_0s79ile</bpmn:flowNodeRef>
      </bpmn:lane>
      
      <bpmn:lane id="Lane_1ocseyo4" name="Physician from Outpatient Department">
        <bpmn:flowNodeRef>Task_05ftug5</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    
    <!-- Core Flow Elements -->
    <bpmn:startEvent id="StartEvent_1" name="Examination">
      <bpmn:outgoing>SequenceFlow_14a0oky</bpmn:outgoing>
    </bpmn:startEvent>
    
    <bpmn:exclusiveGateway id="ExclusiveGateway_0p2e5vq" name="Healthy or Additional Examination?">
      <bpmn:incoming>SequenceFlow_14a0oky</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1j94oja</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_023hzxi</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <!-- Tasks -->
    <bpmn:task id="Task_12j0pib" name="Fill out Examination Form">
      <bpmn:incoming>SequenceFlow_1j94oja</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0kz5g1t</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_14a0oky" sourceRef="StartEvent_1" targetRef="ExclusiveGateway_0p2e5vq"/>
    <bpmn:sequenceFlow id="SequenceFlow_1j94oja" name="Healthy" sourceRef="ExclusiveGateway_0p2e5vq" targetRef="Task_12j0pib"/>
    
    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_1fx9yp3" name="Examination Finished">
      <bpmn:incoming>SequenceFlow_0kz5g1t</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  
  <!-- Tasks -->
  <bpmn:task id="Task_0vaxgaa" name="Prepare Examination and Sampling">
    <bpmn:incoming>SequenceFlow_023hzxi</bpmn:incoming>
    <bpmn:outgoing>SequenceFlow_035vf60</bpmn:outgoing>
  </bpmn:task>
  
  <bpmn:task id="Task_0sl26uo" name="Take Sample">
    <bpmn:incoming>SequenceFlow_035vf60</bpmn:incoming>
    <bpmn:outgoing>SequenceFlow_06kfaev</bpmn:outgoing>
  </bpmn:task>
  
  <bpmn:task id="Task_0e6hvnj" name="Validate Sample">
    <bpmn:incoming>SequenceFlow_06kfaev</bpmn:incoming>
    <bpmn:outgoing>SequenceFlow_1pq8ub3</bpmn:outgoing>
  </bpmn:task>
  
  <bpmn:task id="Task_0s79ile" name="Perform Analysis">
    <bpmn:incoming>SequenceFlow_1pq8ub3</bpmn:incoming>
    <bpmn:outgoing>SequenceFlow_0ajhekx</bpmn:outgoing>
  </bpmn:task>
  
  <bpmn:task id="Task_05ftug5" name="Make Diagnosis and Prescribe Therapy">
    <bpmn:incoming>SequenceFlow_0ajhekx</bpmn:incoming>
  </bpmn:task>
  
  <!-- Sequence Flows -->
  <bpmn:sequenceFlow id="SequenceFlow_023hzxi" sourceRef="ExclusiveGateway_0p2e5vq" targetRef="Task_0vaxgaa"/>
  <bpmn:sequenceFlow id="SequenceFlow_035vf60" sourceRef="Task_0vaxgaa" targetRef="Task_0sl26uo"/>
  <bpmn:sequenceFlow id="SequenceFlow_06kfaev" sourceRef="Task_0sl26uo" targetRef="Task_0e6hvnj"/>
  <bpmn:sequenceFlow id="SequenceFlow_1pq8ub3" sourceRef="Task_0e6hvnj" targetRef="Task_0s79ile"/>
  <bpmn:sequenceFlow id="SequenceFlow_0ajhekx" sourceRef="Task_0s79ile" targetRef="Task_05ftug5"/>
</bpmn:definitions>