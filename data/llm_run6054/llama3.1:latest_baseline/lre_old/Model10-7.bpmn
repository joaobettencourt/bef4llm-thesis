<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                   xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                   xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_0geryc1">
    <bpmn:participant id="Participant_0ygkg4f" name="Measurement Service Point Node (MSPN)"
                      processRef="Process_1"/>
    
    <bpmn:participant id="Participant_0ygkg5a" name="Goods Owner (GO)"
                      processRef="Process_1"/>
    
    <bpmn:participant id="Participant_0ygkg6b" name="Measurement Service Point Organisation (MSPO)"
                      processRef="Process_1"/>
    
    <bpmn:participant id="Participant_0ygkg7c" name="Measurement Point Operator (MPO)"
                      processRef="Process_1"/>
    
    <bpmn:participant id="Participant_0ygkg8d" name="Service Provider (SP)"
                      processRef="Process_1"/>
  </bpmn:collaboration>
  
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_1viot5w" name="MSPN">
        <bpmn:flowNodeRef>Task_12j0pib</bpmn:flowNodeRef>
      </bpmn:lane>
      
      <bpmn:lane id="Lane_1ocseyo" name="GO">
        <bpmn:flowNodeRef>Task_0jsoxba</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_0vaxgaa</bpmn:flowNodeRef>
      </bpmn:lane>
      
      <bpmn:lane id="Lane_1vl2igx" name="MSPO">
        <bpmn:flowNodeRef>Task_05ftug5</bpmn:flowNodeRef>
      </bpmn:lane>
      
      <bpmn:lane id="Lane_1ocseyy" name="MPO">
        <bpmn:flowNodeRef>Task_0sl26uo</bpmn:flowNodeRef>
      </bpmn:lane>
      
      <bpmn:lane id="Lane_1vllgza" name="SP">
        <bpmn:flowNodeRef>Task_0e6hvnj</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    
    <!-- Core Flow Elements -->
    <bpmn:startEvent id="StartEvent_1" name="Register measurement at GO">
      <bpmn:outgoing>SequenceFlow_14a0oky</bpmn:outgoing>
    </bpmn:startEvent>
    
    <bpmn:task id="Task_12j0pib" name="MSPN registers measurement at GO">
      <bpmn:incoming>SequenceFlow_14a0oky</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1dlbln9</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:exclusiveGateway id="ExclusiveGateway_1mpgzhg" name="GO examines application of MSPN">
      <bpmn:incoming>SequenceFlow_1dlbln9</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0iu9po7</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_1xv6wk4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_14a0oky" sourceRef="StartEvent_1" targetRef="Task_12j0pib"/>
    <bpmn:sequenceFlow id="SequenceFlow_1dlbln9" sourceRef="Task_12j0pib" targetRef="ExclusiveGateway_1mpgzhg"/>
    
    <!-- Tasks -->
    <bpmn:task id="Task_0jsoxba" name="GO rejects application of MSPN">
      <bpmn:incoming>SequenceFlow_0iu9po7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0mp5byl</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_0vaxgaa" name="GO confirms application of MSPN">
      <bpmn:incoming>SequenceFlow_1xv6wk4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0kz5g1t</bpmn:outgoing>
    </bpmn:task>
    
    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_1fx9yp3" name="Assignment of MSPN confirmed">
      <bpmn:incoming>SequenceFlow_0kz5g1t</bpmn:incoming>
    </bpmn:endEvent>
    
    <!-- Informing MSPO, MPO and SP about assignment of MSPN -->
    <bpmn:sequenceFlow id="SequenceFlow_0mp5byl" sourceRef="Task_0jsoxba" targetRef="Task_05ftug5"/>
    <bpmn:task id="Task_05ftug5" name="GO informs MSPO about assignment of MSPN">
      <bpmn:incoming>SequenceFlow_0mp5byl</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0v64x8b</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:sequenceFlow id="SequenceFlow_0kz5g1t" sourceRef="Task_0vaxgaa" targetRef="Task_0sl26uo"/>
    <bpmn:task id="Task_0sl26uo" name="GO informs MPO about assignment of MSPN">
      <bpmn:incoming>SequenceFlow_0kz5g1t</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0ajhekx</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:sequenceFlow id="SequenceFlow_0v64x8b" sourceRef="Task_05ftug5" targetRef="Task_0e6hvnj"/>
    <bpmn:task id="Task_0e6hvnj" name="GO informs SP about assignment of MSPN">
      <bpmn:incoming>SequenceFlow_0v64x8b</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_035vf60</bpmn:outgoing>
    </bpmn:task>
    
    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_1fx9yp4" name="Assignment of MSPN confirmed">
      <bpmn:incoming>SequenceFlow_035vf60</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>