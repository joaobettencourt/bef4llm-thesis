<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                   xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                   xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="INQ transmits transaction data request to IP">
      <bpmn:outgoing>SequenceFlow_0iu9po7</bpmn:outgoing>
    </bpmn:startEvent>
    
    <!-- Sequence Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_0iu9po7" sourceRef="StartEvent_1" targetRef="Task_12j0pib"/>
    
    <!-- Task 1: IP checks the request of the INQ -->
    <bpmn:task id="Task_12j0pib" name="IP checks the request of the INQ">
      <bpmn:incoming>SequenceFlow_0iu9po7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1j94oja</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Sequence Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_1j94oja" sourceRef="Task_12j0pib" targetRef="ExclusiveGateway_0p2e5vq"/>
    
    <!-- Exclusive Gateway 1: IP answers the question of the INQ depending on the outcome of the examination -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_0p2e5vq">
      <bpmn:incoming>SequenceFlow_1j94oja</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0kz5g1t</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_0mp5byl</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <!-- Sequence Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_0kz5g1t" sourceRef="ExclusiveGateway_0p2e5vq" targetRef="Task_13j0pib"/>
    
    <!-- Task 2: Transmission of data or rejected -->
    <bpmn:task id="Task_13j0pib" name="Transmission of data or rejected">
      <bpmn:incoming>SequenceFlow_0kz5g1t</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_14a0oky</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Sequence Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_14a0oky" sourceRef="Task_13j0pib" targetRef="EndEvent_1fx9yp3"/>
    
    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_1fx9yp3" name="Process completed">
      <bpmn:incoming>SequenceFlow_14a0oky</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>