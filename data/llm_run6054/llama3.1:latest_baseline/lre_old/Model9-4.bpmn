                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_0geryc1">
    <bpmn:participant id="Participant_0ygkg4f" name="Coordination Unit"
                      processRef="Process_1"/>
    
    <bpmn:participant id="Participant_0ygkg5a" name="Support Officer"
                      processRef="Process_1"/>
    
    <bpmn:participant id="Participant_0ygkg6b" name="Committee Members"
                      processRef="Process_1"/>
  </bpmn:collaboration>
  
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_1viot5w" name="Coordination Unit">
        <bpmn:flowNodeRef>Task_12j0pib</bpmn:flowNodeRef>
      </bpmn:lane>
      
      <bpmn:lane id="Lane_1ocseyo" name="Support Officer">
        <bpmn:flowNodeRef>Task_0vaxgaa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_0e6hvnj</bpmn:flowNodeRef>
      </bpmn:lane>
      
      <bpmn:lane id="Lane_1vl2igx" name="Committee Members">
        <bpmn:flowNodeRef>Task_05ftug5</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    
    <!-- Core Flow Elements -->
    <bpmn:startEvent id="StartEvent_1" name="Finalize dates">
      <bpmn:outgoing>SequenceFlow_14a0oky</bpmn:outgoing>
    </bpmn:startEvent>
    
    <bpmn:task id="Task_12j0pib" name="Update group calendars and create meeting folders">
      <bpmn:incoming>SequenceFlow_14a0oky</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1j94oja</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:sequenceFlow id="SequenceFlow_14a0oky" sourceRef="StartEvent_1" targetRef="Task_12j0pib"/>
    
    <!-- Task for Support Officer -->
    <bpmn:task id="Task_0vaxgaa" name="Advise Committee Members to read related documents">
      <bpmn:incoming>SequenceFlow_1j94oja</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0mp5byl</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Task for Support Officer -->
    <bpmn:task id="Task_0e6hvnj" name="Produce minutes and Action Points">
      <bpmn:incoming>SequenceFlow_0mp5byl</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1pq8ub3</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Task for Committee Members -->
    <bpmn:task id="Task_05ftug5" name="Hold meeting">
      <bpmn:incoming>SequenceFlow_0kz5g1t</bpmn:incoming>
    </bpmn:task>
    
    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_1j94oja" sourceRef="Task_12j0pib" targetRef="Task_0vaxgaa"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_0mp5byl" sourceRef="Task_0vaxgaa" targetRef="Task_0e6hvnj"/>
    
    <!-- QA Check -->
    <bpmn:task id="Task_0sl26uo" name="Conduct QA check on minutes">
      <bpmn:incoming>SequenceFlow_1pq8ub3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0ajhekx</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Update departmental records -->
    <bpmn:endEvent id="EndEvent_1fx9yp3" name="Update all departmental records">
      <bpmn:incoming>SequenceFlow_0v64x8b</bpmn:incoming>
    </bpmn:endEvent>
    
    <!-- Task for Support Officer -->
    <bpmn:task id="Task_0s79ile" name="Send minutes to Committee Members">
      <bpmn:incoming>SequenceFlow_0ajhekx</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1ujhfx4</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_1pq8ub3" sourceRef="Task_0e6hvnj" targetRef="Task_0sl26uo"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_0kz5g1t" sourceRef="Task_0vaxgaa" targetRef="Task_05ftug5"/>
    
    <!-- QA Check -->
    <bpmn:sequenceFlow id="SequenceFlow_1ujhfx4" sourceRef="Task_0s79ile" targetRef="EndEvent_1fx9yp3"/>
    
    <!-- Update departmental records -->
    <bpmn:sequenceFlow id="SequenceFlow_0v64x8b" sourceRef="Task_0s79ile" targetRef="EndEvent_1fx9yp3"/>
  </bpmn:process>
