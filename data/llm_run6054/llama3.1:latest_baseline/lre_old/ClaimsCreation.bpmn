    <bpmn:sequenceFlow id="SequenceFlow_19j0pib" sourceRef="ExclusiveGateway_1ouv9kf" targetRef="EndEvent_20j0pib"/>
    
    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_20j0pib" name="Claimant Informed">
      <bpmn:incoming>SequenceFlow_19j0pib</bpmn:incoming>
