  <bpmn:collaboration id="Collaboration_0geryc1">
    <bpmn:participant id="Participant_0ygkg4f" name="Claims Handler"
                      processRef="Process_1"/>
    <bpmn:participant id="Participant_0ygkg5a" name="Claims Manager"
                      processRef="Process_1"/>
  </bpmn:collaboration>
  
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_1viot5w" name="Claims Handler">
        <bpmn:flowNodeRef>Task_12j0pib</bpmn:flowNodeRef>
      </bpmn:lane>
      
      <bpmn:lane id="Lane_1ocseyo" name="Claims Manager">
        <bpmn:flowNodeRef>Task_0vaxgaa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_0e6hvnj</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    
    <!-- Core Flow Elements -->
    <bpmn:startEvent id="StartEvent_1" name="Search Police Report">
      <bpmn:outgoing>SequenceFlow_14a0oky</bpmn:outgoing>
    </bpmn:startEvent>
    
    <bpmn:task id="Task_12j0pib" name="Search Police Report in Database">
      <bpmn:incoming>SequenceFlow_14a0oky</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1j94oja</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_14a0oky" sourceRef="StartEvent_1" targetRef="Task_12j0pib"/>
    <bpmn:sequenceFlow id="SequenceFlow_1j94oja" sourceRef="Task_12j0pib" targetRef="Task_13j0pib"/>
    
    <!-- Tasks -->
    <bpmn:task id="Task_13j0pib" name="Create File with Police Report and Claim Documentation">
      <bpmn:incoming>SequenceFlow_1j94oja</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_15j0pib</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Exclusive Gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_1mpgzhg" name="Negotiate Settlement">
      <bpmn:incoming>SequenceFlow_15j0pib</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_16j0pib</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_15j0pib" sourceRef="Task_13j0pib" targetRef="ExclusiveGateway_1mpgzhg"/>
    <bpmn:sequenceFlow id="SequenceFlow_16j0pib" sourceRef="ExclusiveGateway_1mpgzhg" targetRef="Task_17j0pib"/>
    
    <!-- Tasks -->
    <bpmn:task id="Task_17j0pib" name="Create Action Plan">
      <bpmn:incoming>SequenceFlow_16j0pib</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_18j0pib</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Exclusive Gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_1ouv9kf" name="Negotiate Settlement">
      <bpmn:incoming>SequenceFlow_18j0pib</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_19j0pib</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <!-- Sequence Flows -->
