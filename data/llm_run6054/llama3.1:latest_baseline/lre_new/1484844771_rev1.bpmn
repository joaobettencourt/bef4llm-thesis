    <bpmn:sequenceFlow id="SequenceFlow_1xv6wk4" name="Vendor found or new Vendor Record finished" sourceRef="ExclusiveGateway_1mpgzhg" targetRef="ExclusiveGateway_1dgb4sg" />
    <bpmn:task id="Task_0s79ile" name="Add SAP number to Invoice">
      <bpmn:incoming>SequenceFlow_0mp5byl</bpmn:incoming>
