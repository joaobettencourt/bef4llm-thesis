    <bpmn:sequenceFlow id="SequenceFlow_14a0oky" sourceRef="StartEvent_1" targetRef="Task_0jsoxba" />
    <bpmn:sequenceFlow id="SequenceFlow_1j94oja" name="Vendor not found" sourceRef="Task_0jsoxba" targetRef="ExclusiveGateway_1mpgzhg" />
    <bpmn:task id="Task_12j0pib" name="Record new Vendor">
      <bpmn:incoming>SequenceFlow_0iu9po7</bpmn:incoming>
