<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_0geryc1">
    <bpmn:participant id="Participant_0ygkg4f" name="Storage Management&#10;System" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_1viot5w" name="Order Management">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_0p2e5vq</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1ocseyo" name="Stock Management">
        <bpmn:flowNodeRef>Task_12j0pib</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_1dgb4sg</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1vl2igx" name="Shipping">
        <bpmn:flowNodeRef>Task_0jsoxba</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_1mpgzhg</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Core Flow Elements -->
    <bpmn:startEvent id="StartEvent_1" name="Read order from&#10;order management system">
      <bpmn:outgoing>SequenceFlow_14a0oky</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:exclusiveGateway id="ExclusiveGateway_0p2e5vq" name="Is first product in stock?">
      <bpmn:incoming>SequenceFlow_14a0oky</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1j94oja</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_1dlbln9</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_12j0pib" name="Withdraw product from warehouse">
      <bpmn:incoming>SequenceFlow_1j94oja</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0kz5g1t</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_14a0oky" sourceRef="StartEvent_1" targetRef="ExclusiveGateway_0p2e5vq" />
    <bpmn:sequenceFlow id="SequenceFlow_1j94oja" name="yes" sourceRef="ExclusiveGateway_0p2e5vq" targetRef="Task_12j0pib" />
    <bpmn:sequenceFlow id="SequenceFlow_1dlbln9" name="no" sourceRef="ExclusiveGateway_0p2e5vq" targetRef="ExclusiveGateway_1dgb4sg" />

    <bpmn:exclusiveGateway id="ExclusiveGateway_1dgb4sg" name="Is product reordered?">
      <bpmn:incoming>SequenceFlow_1dlbln9</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0mp5byl</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_0kz5g1t</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_0jsoxba" name="Reorder product from wholesaler">
      <bpmn:incoming>SequenceFlow_0mp5byl</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1pq8ub3</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_0mp5byl" name="yes" sourceRef="ExclusiveGateway_1dgb4sg" targetRef="Task_0jsoxba" />
    <bpmn:sequenceFlow id="SequenceFlow_0kz5g1t" sourceRef="Task_12j0pib" targetRef="ExclusiveGateway_1dgb4sg" />

    <bpmn:endEvent id="EndEvent_1fx9yp3" name="Delivery delay penalty">
      <bpmn:incoming>SequenceFlow_1pq8ub3</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow_1pq8ub3" sourceRef="Task_0jsoxba" targetRef="EndEvent_1fx9yp3" />

    <bpmn:startEvent id="StartEvent_2" name="Product arrived">
      <bpmn:outgoing>SequenceFlow_023hzxi</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_05ftug5" name="Register product in stock management system">
      <bpmn:incoming>SequenceFlow_023hzxi</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0v64x8b</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_023hzxi" sourceRef="StartEvent_2" targetRef="Task_05ftug5" />
    <bpmn:sequenceFlow id="SequenceFlow_0v64x8b" sourceRef="Task_05ftug5" targetRef="ExclusiveGateway_1mpgzhg" />

    <bpmn:exclusiveGateway id="ExclusiveGateway_1mpgzhg" name="Is order ready for shipment?">
      <bpmn:incoming>SequenceFlow_0v64x8b</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_035vf60</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_06kfaev</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_0vaxgaa" name="Pack products and ship">
      <bpmn:incoming>SequenceFlow_035vf60</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1ujhfx4</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_035vf60" name="yes" sourceRef="ExclusiveGateway_1mpgzhg" targetRef="Task_0vaxgaa" />
    <bpmn:sequenceFlow id="SequenceFlow_06kfaev" name="no" sourceRef="ExclusiveGateway_1mpgzhg" targetRef="StartEvent_2" />

    <bpmn:endEvent id="EndEvent_1fx9yp3_1" name="Order shipped">
      <bpmn:incoming>SequenceFlow_1ujhfx4</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow_1ujhfx4" sourceRef="Task_0vaxgaa" targetRef="EndEvent_1fx9yp3_1" />
  </bpmn:process>
</bpmn:definitions>