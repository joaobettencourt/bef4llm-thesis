<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                   xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                   xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_0geryc1">
    <bpmn:participant id="Participant_0ygkg4f" name="Assembler AG"
                      processRef="Process_1"/>
    
    <bpmn:participant id="Participant_1j9k5uq" name="Supplier"
                      processRef="Process_1"/>
  </bpmn:collaboration>
  
  <bpmn:process id="Process_1" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Order Request">
      <bpmn:outgoing>SequenceFlow_0kz5g1t</bpmn:outgoing>
    </bpmn:startEvent>
    
    <!-- Sequence Flow 1 -->
    <bpmn:sequenceFlow id="SequenceFlow_0kz5g1t" sourceRef="StartEvent_1"
                       targetRef="Task_12j0pib"/>
    
    <!-- Task 1 -->
    <bpmn:task id="Task_12j0pib" name="Send Order to Supplier">
      <bpmn:incoming>SequenceFlow_0kz5g1t</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1dlbln9</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Sequence Flow 2 -->
    <bpmn:sequenceFlow id="SequenceFlow_1dlbln9" sourceRef="Task_12j0pib"
                       targetRef="Task_0jsoxba"/>
    
    <!-- Task 2 -->
    <bpmn:task id="Task_0jsoxba" name="Process Order">
      <bpmn:incoming>SequenceFlow_1dlbln9</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0mp5byl</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Sequence Flow 3 -->
    <bpmn:sequenceFlow id="SequenceFlow_0mp5byl" sourceRef="Task_0jsoxba"
                       targetRef="Task_1e6hvnj"/>
    
    <!-- Task 3 -->
    <bpmn:task id="Task_1e6hvnj" name="Send Invoice to Assembler AG">
      <bpmn:incoming>SequenceFlow_0mp5byl</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0v64x8b</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Sequence Flow 4 -->
    <bpmn:sequenceFlow id="SequenceFlow_0v64x8b" sourceRef="Task_1e6hvnj"
                       targetRef="EndEvent_1fx9yp3"/>
    
    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_1fx9yp3" name="Invoice Received">
      <bpmn:incoming>SequenceFlow_0v64x8b</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>