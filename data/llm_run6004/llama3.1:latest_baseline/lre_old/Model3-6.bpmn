<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                   xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                   xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_0geryc1">
    <bpmn:participant id="Participant_0ygkg4f" name="Claims Notification"
                      processRef="Process_1"/>
  </bpmn:collaboration>
  
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_1viot5w" name="Claims Notification">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_0p2e5vq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_12j0pib</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SequenceFlow_1dlbln9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_1dgb4sg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_0jsoxba</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SequenceFlow_0mp5byl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_1ouv9kf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_05ftug5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SequenceFlow_0v64x8b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_1mpgzhg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1fx9yp3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    
    <!-- Core Flow Elements -->
    <bpmn:startEvent id="StartEvent_1" name="Claim received">
      <bpmn:outgoing>SequenceFlow_14a0oky</bpmn:outgoing>
    </bpmn:startEvent>
    
    <bpmn:exclusiveGateway id="ExclusiveGateway_0p2e5vq"
                           name="Is claimant insured?">
      <bpmn:incoming>SequenceFlow_14a0oky</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1j94oja</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_2dlbln9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_14a0oky" sourceRef="StartEvent_1"
                       targetRef="ExclusiveGateway_0p2e5vq"/>
    <bpmn:sequenceFlow id="SequenceFlow_1j94oja" name="No, reject claim"
                       sourceRef="ExclusiveGateway_0p2e5vq" targetRef="EndEvent_1fx9yp3"/>
    
    <!-- Tasks -->
    <bpmn:task id="Task_12j0pib" name="Evaluate severity">
      <bpmn:incoming>SequenceFlow_2dlbln9</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3kz5g1t</bpmn:outgoing>
    </bpmn:task>
    
    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_1fx9yp3" name="Claim rejected"/>
  </bpmn:process>
  
  <bpmn:exclusiveGateway id="ExclusiveGateway_1dgb4sg"
                         name="Is claim simple or complex?">
    <bpmn:incoming>SequenceFlow_2dlbln9</bpmn:incoming>
    <bpmn:outgoing>SequenceFlow_4mp5byl</bpmn:outgoing>
    <bpmn:outgoing>SequenceFlow_5kz5g1t</bpmn:outgoing>
  </bpmn:exclusiveGateway>
  
  <!-- Sequence Flows -->
  <bpmn:sequenceFlow id="SequenceFlow_2dlbln9" sourceRef="ExclusiveGateway_0p2e5vq"
                     targetRef="ExclusiveGateway_1dgb4sg"/>
  <bpmn:sequenceFlow id="SequenceFlow_3kz5g1t" name="Simple claim, send forms"
                     sourceRef="Task_12j0pib" targetRef="Task_0jsoxba"/>
  
  <!-- Tasks -->
  <bpmn:task id="Task_0jsoxba" name="Send relevant forms">
    <bpmn:incoming>SequenceFlow_4mp5byl</bpmn:incoming>
    <bpmn:outgoing>SequenceFlow_6v64x8b</bpmn:outgoing>
  </bpmn:task>
  
  <!-- Sequence Flows -->
  <bpmn:sequenceFlow id="SequenceFlow_4mp5byl" sourceRef="ExclusiveGateway_1dgb4sg"
                     targetRef="Task_0jsoxba"/>
  
  <!-- Exclusive Gateway -->
  <bpmn:exclusiveGateway id="ExclusiveGateway_1ouv9kf"
                         name="Are forms complete?">
    <bpmn:incoming>SequenceFlow_6v64x8b</bpmn:incoming>
    <bpmn:outgoing>SequenceFlow_7kz5g1t</bpmn:outgoing>
    <bpmn:outgoing>SequenceFlow_8kz5g1t</bpmn:outgoing>
  </bpmn:exclusiveGateway>
  
  <!-- Sequence Flows -->
  <bpmn:sequenceFlow id="SequenceFlow_6v64x8b" sourceRef="Task_0jsoxba"
                     targetRef="ExclusiveGateway_1ouv9kf"/>
  
  <!-- Tasks -->
  <bpmn:task id="Task_05ftug5" name="Register claim">
    <bpmn:incoming>SequenceFlow_7kz5g1t</bpmn:incoming>
    <bpmn:outgoing>SequenceFlow_9v64x8b</bpmn:outgoing>
  </bpmn:task>
  
  <!-- Sequence Flows -->
  <bpmn:sequenceFlow id="SequenceFlow_7kz5g1t" name="Yes, register claim"
                     sourceRef="ExclusiveGateway_1ouv9kf" targetRef="Task_05ftug5"/>
  
  <!-- Exclusive Gateway -->
  <bpmn:exclusiveGateway id="ExclusiveGateway_1mpgzhg"
                         name="Is claim registered?">
    <bpmn:incoming>SequenceFlow_9v64x8b</bpmn:incoming>
    <bpmn:outgoing>SequenceFlow_10kz5g1t</bpmn:outgoing>
  </bpmn:exclusiveGateway>
  
  <!-- Sequence Flows -->
  <bpmn:sequenceFlow id="SequenceFlow_9v64x8b" sourceRef="Task_05ftug5"
                     targetRef="ExclusiveGateway_1mpgzhg"/>
  
  <!-- End Event -->
  <bpmn:endEvent id="EndEvent_1fx9yp3" name="Claim registered"/>
</bpmn:definitions>