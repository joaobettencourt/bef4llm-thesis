      <bpmn:incoming>SequenceFlow_0kz5g1t</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0mp5byl</bpmn:outgoing>
    </bpmn:task>
    
    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_2fx9yp3" name="Process ends in Service Management">
      <bpmn:incoming>SequenceFlow_0v64x8b</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  
  <!-- Process 3: Resource Provisioning -->
