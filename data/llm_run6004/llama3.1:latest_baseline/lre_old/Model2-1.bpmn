    <bpmn:participant id="Participant_0jsoxba" name="Service Management"
                      processRef="Process_2"/>
    
    <bpmn:participant id="Participant_0vaxgaa" name="Resource Provisioning"
                      processRef="Process_3"/>
  </bpmn:collaboration>
  
  <!-- Process 1: Customer Service TELECO -->
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_1viot5w" name="Customer Service">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_12j0pib</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_0p2e5vq</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    
    <!-- Core Flow Elements -->
    <bpmn:startEvent id="StartEvent_1" name="Customer perceives service degradation">
      <bpmn:outgoing>SequenceFlow_14a0oky</bpmn:outgoing>
    </bpmn:startEvent>
    
    <bpmn:task id="Task_12j0pib" name="Send problem report to Service Management">
      <bpmn:incoming>SequenceFlow_14a0oky</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1dlbln9</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Exclusive Gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_0p2e5vq" name="Determine customer significance">
      <bpmn:incoming>SequenceFlow_1dlbln9</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0kz5g1t</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_1xv6wk4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_14a0oky" sourceRef="StartEvent_1" targetRef="Task_12j0pib"/>
    <bpmn:sequenceFlow id="SequenceFlow_1dlbln9" sourceRef="Task_12j0pib" targetRef="ExclusiveGateway_0p2e5vq"/>
    
    <!-- Tasks -->
    <bpmn:task id="Task_0jsoxba" name="Create detailed problem report">
      <bpmn:incoming>SequenceFlow_1xv6wk4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0mp5byl</bpmn:outgoing>
    </bpmn:task>
    
    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_1fx9yp3" name="Process ends in Customer Service">
      <bpmn:incoming>SequenceFlow_0v64x8b</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  
  <!-- Process 2: Service Management -->
  <bpmn:process id="Process_2" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_1viot5w" name="Service Management">
