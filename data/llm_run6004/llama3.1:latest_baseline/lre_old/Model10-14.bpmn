<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                   xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                   xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_0geryc1">
    <bpmn:participant id="Participant_0ygkg4f" name="MPOO"
                      processRef="Process_1"/>
    
    <bpmn:participant id="Participant_1ocseyo" name="GO"
                      processRef="Process_1"/>
    
    <bpmn:participant id="Participant_1vl2igx" name="MPON"
                      processRef="Process_1"/>
    
    <bpmn:participant id="Participant_1viot5w" name="MSPO"
                      processRef="Process_1"/>
  </bpmn:collaboration>
  
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_MPOO" name="MPOO">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SequenceFlow_0iu9po7</bpmn:flowNodeRef>
      </bpmn:lane>
      
      <bpmn:lane id="Lane_GO" name="GO">
        <bpmn:flowNodeRef>ExclusiveGateway_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SequenceFlow_2</bpmn:flowNodeRef>
      </bpmn:lane>
      
      <bpmn:lane id="Lane_MPN" name="MPON">
        <bpmn:flowNodeRef>ExclusiveGateway_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SequenceFlow_4</bpmn:flowNodeRef>
      </bpmn:lane>
      
      <bpmn:lane id="Lane_MSP" name="MSPO">
        <bpmn:flowNodeRef>ExclusiveGateway_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SequenceFlow_6</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    
    <!-- Core Flow Elements -->
    <bpmn:startEvent id="StartEvent_1" name="MPOO sends bill for temporary continuation of metering point operations">
      <bpmn:outgoing>SequenceFlow_0</bpmn:outgoing>
    </bpmn:startEvent>
    
    <bpmn:exclusiveGateway id="ExclusiveGateway_1" name="Examine bill">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <bpmn:exclusiveGateway id="ExclusiveGateway_3" name="Examine bill">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <bpmn:exclusiveGateway id="ExclusiveGateway_5" name="Examine bill">
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_0" sourceRef="StartEvent_1" targetRef="ExclusiveGateway_1"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="ExclusiveGateway_1" targetRef="Task_1"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="Task_1" targetRef="EndEvent_1"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_3" targetRef="Task_2"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="Task_2" targetRef="EndEvent_2"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="ExclusiveGateway_5" targetRef="Task_3"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_7" sourceRef="Task_3" targetRef="EndEvent_3"/>
    
    <!-- Tasks -->
    <bpmn:task id="Task_1" name="Confirm invoice with payment advice">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_2" name="Confirm invoice with payment advice">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_3" name="Confirm invoice with payment advice">
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
    </bpmn:task>
    
    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_1" name="Invoice confirmed">
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
    </bpmn:endEvent>
    
    <bpmn:endEvent id="EndEvent_2" name="Invoice rejected">
      <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
    </bpmn:endEvent>
    
    <bpmn:endEvent id="EndEvent_3" name="Invoice confirmed">
      <bpmn:incoming>SequenceFlow_7</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>