<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                   xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                   xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Customer Request">
      <bpmn:outgoing>SequenceFlow_0j9w6x7</bpmn:outgoing>
    </bpmn:startEvent>
    
    <!-- Sequence Flow to Risk Assessment Web Service -->
    <bpmn:sequenceFlow id="SequenceFlow_0j9w6x7" sourceRef="StartEvent_1" targetRef="ServiceTask_0"/>
    
    <!-- Risk Assessment Web Service Task -->
    <bpmn:serviceTask id="ServiceTask_0" name="Risk Assessment">
      <bpmn:incoming>SequenceFlow_0j9w6x7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1k5s4o8</bpmn:outgoing>
    </bpmn:serviceTask>
    
    <!-- Exclusive Gateway for Loan Approval Decision -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_0" name="Loan Approval">
      <bpmn:incoming>SequenceFlow_1k5s4o8</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2m9p7d3</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_3e6g1a0</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <!-- Sequence Flow to Loan Approval -->
    <bpmn:sequenceFlow id="SequenceFlow_2m9p7d3" sourceRef="ExclusiveGateway_0" targetRef="ServiceTask_1"/>
    
    <!-- Service Task for Loan Approval -->
    <bpmn:serviceTask id="ServiceTask_1" name="Loan Approval">
      <bpmn:incoming>SequenceFlow_2m9p7d3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4f8c5b6</bpmn:outgoing>
    </bpmn:serviceTask>
    
    <!-- Sequence Flow to Customer Feedback -->
    <bpmn:sequenceFlow id="SequenceFlow_4f8c5b6" sourceRef="ServiceTask_1" targetRef="EndEvent_0"/>
    
    <!-- End Event for Loan Approval -->
    <bpmn:endEvent id="EndEvent_0" name="Loan Approved">
      <bpmn:incoming>SequenceFlow_4f8c5b6</bpmn:incoming>
    </bpmn:endEvent>
    
    <!-- Sequence Flow to Approver Web Service -->
    <bpmn:sequenceFlow id="SequenceFlow_3e6g1a0" sourceRef="ExclusiveGateway_0" targetRef="ServiceTask_2"/>
    
    <!-- Service Task for Approver Web Service -->
    <bpmn:serviceTask id="ServiceTask_2" name="Approver">
      <bpmn:incoming>SequenceFlow_3e6g1a0</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5h7d9f1</bpmn:outgoing>
    </bpmn:serviceTask>
    
    <!-- Sequence Flow to Customer Feedback -->
    <bpmn:sequenceFlow id="SequenceFlow_5h7d9f1" sourceRef="ServiceTask_2" targetRef="EndEvent_0"/>
  </bpmn:process>
</bpmn:definitions>