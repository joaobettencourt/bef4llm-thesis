<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                   xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                   xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Detect personnel requirements">
      <bpmn:outgoing>SequenceFlow_0</bpmn:outgoing>
    </bpmn:startEvent>
    
    <!-- Sequence Flow 1 -->
    <bpmn:sequenceFlow id="SequenceFlow_0" sourceRef="StartEvent_1" targetRef="Task_1"/>
    
    <!-- Task 1: Report vacancy to Personnel Department -->
    <bpmn:task id="Task_1" name="Report vacancy">
      <bpmn:incoming>SequenceFlow_0</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Sequence Flow 2 -->
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="Task_1" targetRef="IntermediateCatchEvent_1"/>
    
    <!-- Intermediate Catch Event -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_1" name="Wait for job description">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    
    <!-- Sequence Flow 3 -->
    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="IntermediateCatchEvent_1" targetRef="Task_2"/>
    
    <!-- Task 2: Review job description -->
    <bpmn:task id="Task_2" name="Review job description">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Sequence Flow 4 -->
    <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="Task_2" targetRef="ExclusiveGateway_1"/>
    
    <!-- Exclusive Gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_1" name="Ask for corrections">
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <!-- Sequence Flow 5 -->
    <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_1" targetRef="Task_3"/>
    
    <!-- Task 3: Approve job description -->
    <bpmn:task id="Task_3" name="Approve job description">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Sequence Flow 6 -->
    <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="ExclusiveGateway_1" targetRef="Task_4"/>
    
    <!-- Task 4: Clarify tasks and requirements -->
    <bpmn:task id="Task_4" name="Clarify tasks and requirements">
      <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Sequence Flow 7 -->
    <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="Task_3" targetRef="EndEvent_1"/>
    
    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_1" name="Process completed">
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>