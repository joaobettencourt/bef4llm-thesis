<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Receive credit information">
      <bpmn:outgoing>SequenceFlow_0kz5g1t</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="ExclusiveGateway_1mpgzhg" name="Amount greater than 1M$?">
      <bpmn:incoming>SequenceFlow_0kz5g1t</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1j94oja</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_1dlbln9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="SequenceFlow_0kz5g1t" sourceRef="StartEvent_1" targetRef="ExclusiveGateway_1mpgzhg"/>
    <bpmn:task id="Task_12j0pib" name="Assess risk">
      <bpmn:incoming>SequenceFlow_1dlbln9</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0mp5byl</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_1j94oja" sourceRef="ExclusiveGateway_1mpgzhg" targetRef="Task_12j0pib"/>
    <bpmn:exclusiveGateway id="ExclusiveGateway_1dgb4sg" name="Risk high?">
      <bpmn:incoming>SequenceFlow_0mp5byl</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0buzwss</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_1xv6wk4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="SequenceFlow_0mp5byl" sourceRef="Task_12j0pib" targetRef="ExclusiveGateway_1dgb4sg"/>
    <bpmn:task id="Task_0jsoxba" name="Request approval">
      <bpmn:incoming>SequenceFlow_1xv6wk4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0ajhekx</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_1xv6wk4" sourceRef="ExclusiveGateway_1dgb4sg" targetRef="Task_0jsoxba"/>
    <bpmn:endEvent id="EndEvent_1fx9yp3" name="Credit accepted/rejected">
      <bpmn:incoming>SequenceFlow_0ajhekx</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_14a0oky</bpmn:outgoing>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow_0ajhekx" sourceRef="Task_0jsoxba" targetRef="EndEvent_1fx9yp3"/>
    <bpmn:sequenceFlow id="SequenceFlow_14a0oky" sourceRef="EndEvent_1fx9yp3" targetRef="StartEvent_1"/>
  </bpmn:process>
</bpmn:definitions>