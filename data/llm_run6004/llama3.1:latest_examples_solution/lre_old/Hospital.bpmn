<?xml version="1.0" encoding="UTF-8"?>
<bpmn2:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                    xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL"
                    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                    id="_XnkzIJtIEeWMdP0wHEPnRw"
                    targetNamespace="http://activiti.org/bpmn"
                    exporter="Camunda Modeler"
                    exporterVersion="1.0.0"
                    xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd">
  <bpmn2:collaboration id="Collaboration_0if8286">
    <bpmn2:participant id="Participant_120l3yn" name="Hospital"
                       processRef="Process_1"/>
  </bpmn2:collaboration>
  <bpmn2:process id="Process_1" isExecutable="false">
    <!-- Lane Set -->
    <bpmn2:laneSet>
      <bpmn2:lane id="Lane_0geryc1" name="Patient">
        <bpmn2:flowNodeRef>Task_12j0pib</bpmn2:flowNodeRef>
      </bpmn2:lane>
      <bpmn2:lane id="Lane_1ocseyo" name="Physician">
        <bpmn2:flowNodeRef>Task_1</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Task_2</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Task_3</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Task_4</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>InclusiveGateway_1</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>InclusiveGateway_2</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>StartEvent_1</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>ParallelGateway_1</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>ExclusiveGateway_1</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>ExclusiveGateway_2</bpmn2:flowNodeRef>
      </bpmn2:lane>
      <bpmn2:lane id="Lane_1vl2igx" name="Lab">
        <bpmn2:flowNodeRef>Task_5</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Task_6</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>ExclusiveGateway_3</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>EndEvent_1</bpmn2:flowNodeRef>
      </bpmn2:lane>
    </bpmn2:laneSet>

    <!-- Sequence Flows -->
    <bpmn2:sequenceFlow id="SequenceFlow_1" sourceRef="Task_1"
                        targetRef="InclusiveGateway_1"/>
    <bpmn2:inclusiveGateway id="InclusiveGateway_1">
      <bpmn2:incoming>SequenceFlow_1</bpmn2:incoming>
      <bpmn2:outgoing>SequenceFlow_2</bpmn2:outgoing>
      <bpmn2:outgoing>SequenceFlow_3</bpmn2:outgoing>
    </bpmn2:inclusiveGateway>

    <!-- Tasks -->
    <bpmn2:task id="Task_1" name="Examine patient">
      <bpmn2:incoming>SequenceFlow_4</bpmn2:incoming>
      <bpmn2:outgoing>SequenceFlow_1</bpmn2:outgoing>
    </bpmn2:task>

    <!-- Parallel Gateway -->
    <bpmn2:parallelGateway id="ParallelGateway_1">
      <bpmn2:incoming>SequenceFlow_5</bpmn2:incoming>
      <bpmn2:outgoing>SequenceFlow_6</bpmn2:outgoing>
      <bpmn2:outgoing>SequenceFlow_7</bpmn2:outgoing>
    </bpmn2:parallelGateway>

    <!-- Exclusive Gateway -->
    <bpmn2:exclusiveGateway id="ExclusiveGateway_1" name="Special&#10;sandling?">
      <bpmn2:incoming>SequenceFlow_8</bpmn2:incoming>
      <bpmn2:outgoing>SequenceFlow_9</bpmn2:outgoing>
      <bpmn2:outgoing>SequenceFlow_10</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>

    <!-- End Event -->
    <bpmn2:endEvent id="EndEvent_1" name="Shipment&#10;prepared">
      <bpmn2:incoming>SequenceFlow_11</bpmn2:incoming>
    </bpmn2:endEvent>

  </bpmn2:process>
</bpmn2:definitions>