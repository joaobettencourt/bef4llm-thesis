<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_1"
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_0" name="Supplier" processRef="Pool_0"/>
    <bpmn:participant id="Participant_1" name="Assembler AG" processRef="Pool_1"/>
  </bpmn:collaboration>
  <bpmn:process id="Pool_0" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_0" name="Accounts Department">
        <bpmn:flowNodeRef>StartTimerEvent_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndNoneEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent name="" id="StartTimerEvent_0">
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="StartTimerEvent_0"
                       targetRef="Task_2"/>
    <bpmn:task name="Process order" id="Task_2">
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_7" sourceRef="Task_2"
                       targetRef="EndNoneEvent_1"/>
    <bpmn:endEvent name="" id="EndNoneEvent_1">
      <bpmn:incoming>SequenceFlow_7</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:process id="Pool_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_1" name="Production">
        <bpmn:flowNodeRef>Task_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndNoneEvent_2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent name="" id="StartNoneEvent_0">
      <bpmn:outgoing>SequenceFlow_8</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="SequenceFlow_8" sourceRef="StartNoneEvent_0"
                       targetRef="Task_0"/>
    <bpmn:task name="Create order" id="Task_0">
      <bpmn:incoming>SequenceFlow_8</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:messageFlow id="MessageFlow_2" sourceRef="Task_0"
                      targetRef="Task_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_9" sourceRef="Task_0"
                       targetRef="EndNoneEvent_2"/>
    <bpmn:endEvent name="" id="EndNoneEvent_2">
      <bpmn:incoming>SequenceFlow_9</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>