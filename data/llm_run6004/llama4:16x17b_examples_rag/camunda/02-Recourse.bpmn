<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                 xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                 xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                 id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_0" name="Recourse Process" processRef="Pool_0"/>
  </bpmn:collaboration>
  <bpmn:process id="Pool_0" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_0" name="Clerk">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GetInformation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_CheckPossibility</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendRequestForPayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateReminder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CloseCase</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckReasoning</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_DisagreementHandling</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ForwardToCollectionAgency</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_CaseClosed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_GetInformation"/>
    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="Task_GetInformation" targetRef="ExclusiveGateway_CheckPossibility"/>
    <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_CheckPossibility" targetRef="Task_SendRequestForPayment"/>
    <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="Task_SendRequestForPayment" targetRef="Task_CreateReminder"/>
    <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="Task_CreateReminder" targetRef="ExclusiveGateway_DisagreementHandling"/>
    <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="ExclusiveGateway_CheckPossibility" targetRef="Task_CloseCase"/>
    <bpmn:sequenceFlow id="SequenceFlow_7" sourceRef="Task_ForwardToCollectionAgency" targetRef="EndEvent_CaseClosed"/>
    <bpmn:sequenceFlow id="SequenceFlow_8" sourceRef="ExclusiveGateway_DisagreementHandling" targetRef="Task_CheckReasoning"/>
    <bpmn:sequenceFlow id="SequenceFlow_9" sourceRef="Task_CheckReasoning" targetRef="ExclusiveGateway_DisagreementHandling"/>
    <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="ExclusiveGateway_DisagreementHandling" targetRef="Task_ForwardToCollectionAgency"/>

    <!-- Flow Elements -->
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_GetInformation" name="Get information about possible subrogation">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="ExclusiveGateway_CheckPossibility" name="Is recourse possible?">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_SendRequestForPayment" name="Send request for payment to insurant">
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_CreateReminder" name="Create reminder">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="ExclusiveGateway_DisagreementHandling" name="Has insurant disagreed?">
      <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_8</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_CheckReasoning" name="Check reasoning of disagreement">
      <bpmn:incoming>SequenceFlow_8</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_9</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_11" sourceRef="Task_ReceiveMoney" targetRef="EndEvent_CaseClosed"/>
    <bpmn:task id="Task_ReceiveMoney" name="Receive money and make booking">
      <bpmn:outgoing>SequenceFlow_11</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_12" sourceRef="ExclusiveGateway_CheckPossibility" targetRef="Task_ReceiveMoney"/>
    <bpmn:sequenceFlow id="SequenceFlow_13" sourceRef="Task_CheckReasoning" targetRef="Task_CloseCase"/>

    <bpmn:endEvent id="EndEvent_CaseClosed">
      <bpmn:incoming>SequenceFlow_7</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_11</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:task id="Task_CloseCase" name="Close case">
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_13</bpmn:incoming>
    </bpmn:task>

    <bpmn:task id="Task_ForwardToCollectionAgency" name="Forward to collection agency">
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
    </bpmn:task>
  </bpmn:process>
</bpmn:definitions>