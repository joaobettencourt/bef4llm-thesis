<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://example.com/bpmn">

  <process id="prozess" isExecutable="true">
    <startEvent id="startEvent">
      <outgoing>sequenceFlow1</outgoing>
    </startEvent>

    <sequenceFlow id="sequenceFlow1" sourceRef="startEvent" targetRef="task1"/>

    <task id="task1" name="Prüfen ob Versicherungsnehmer in Regress genommen werden kann">
      <incoming>sequenceFlow1</incoming>
      <outgoing>sequenceFlow2</outgoing>
      <outgoing>sequenceFlow3</outgoing>
    </task>

    <exclusiveGateway id="exclusiveGateway1">
      <incoming>sequenceFlow2</incoming>
      <outgoing>sequenceFlow4</outgoing>
      <outgoing>sequenceFlow5</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequenceFlow2" sourceRef="task1" targetRef="exclusiveGateway1"/>
    <sequenceFlow id="sequenceFlow3" name="nein" sourceRef="task1" targetRef="endEvent1"/>

    <task id="task2" name="Zahlungsaufforderung an Versicherungsnehmer senden">
      <incoming>sequenceFlow4</incoming>
      <outgoing>sequenceFlow6</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow4" name="ja" sourceRef="exclusiveGateway1" targetRef="task2"/>

    <task id="task3" name="Eingang von Geld verzeichnen">
      <incoming>sequenceFlow7</incoming>
      <outgoing>sequenceFlow8</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow5" sourceRef="exclusiveGateway1" targetRef="task3"/>

    <endEvent id="endEvent1">
      <incoming>sequenceFlow3</incoming>
    </endEvent>

    <sequenceFlow id="sequenceFlow6" sourceRef="task2" targetRef="task4"/>
    <sequenceFlow id="sequenceFlow7" sourceRef="task3" targetRef="exclusiveGateway2"/>

    <exclusiveGateway id="exclusiveGateway2">
      <incoming>sequenceFlow8</incoming>
      <outgoing>sequenceFlow9</outgoing>
      <outgoing>sequenceFlow10</outgoing>
    </exclusiveGateway>

    <task id="task4" name="Widerspruch des Versicherungsnehmers prüfen">
      <incoming>sequenceFlow6</incoming>
      <outgoing>sequenceFlow11</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow8" sourceRef="task3" targetRef="exclusiveGateway2"/>

    <sequenceFlow id="sequenceFlow9" name="ja" sourceRef="exclusiveGateway2" targetRef="endEvent1"/>
    <sequenceFlow id="sequenceFlow10" name="nein" sourceRef="exclusiveGateway2" targetRef="task5"/>

    <task id="task5" name="An Inkasso-Dienstleister abgeben">
      <incoming>sequenceFlow10</incoming>
      <outgoing>sequenceFlow12</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow11" sourceRef="task4" targetRef="exclusiveGateway3"/>

    <exclusiveGateway id="exclusiveGateway3">
      <incoming>sequenceFlow11</incoming>
      <outgoing>sequenceFlow13</outgoing>
      <outgoing>sequenceFlow14</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequenceFlow12" sourceRef="task5" targetRef="endEvent1"/>

    <sequenceFlow id="sequenceFlow13" name="ja" sourceRef="exclusiveGateway3" targetRef="endEvent1"/>
    <sequenceFlow id="sequenceFlow14" name="nein" sourceRef="exclusiveGateway3" targetRef="task2"/>

  </process>
</definitions>