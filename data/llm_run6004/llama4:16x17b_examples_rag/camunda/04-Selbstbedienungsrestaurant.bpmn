<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Restaurant Process" targetNamespace="http://example.com/bpmn">

   <process id="restaurantProcess" isExecutable="true">
     <laneSet>
       <lane id="guestLane" name="Gast">
         <flowNodeRef>StartEvent_1</flowNodeRef>
         <flowNodeRef>Task_GetFood_0jsoxba</flowNodeRef>
         <flowNodeRef>EndEvent_Finished_1fx9yp3</flowNodeRef>
       </lane>
       <lane id="staffLane" name="Angestellte( r )">
         <flowNodeRef>Task_TakeOrder_12j0pib</flowNodeRef>
         <flowNodeRef>Task_PayAndGetPieper_05ftug5</flowNodeRef>
         <flowNodeRef>Task_InformCook_0e6hvnj</flowNodeRef>
         <flowNodeRef>Task_CallGuest_1mpgzhg</flowNodeRef>
       </lane>
       <lane id="cookLane" name="Koch">
         <flowNodeRef>Task_PrepareFood_0sl26uo</flowNodeRef>
       </lane>
     </laneSet>

     <startEvent id="StartEvent_1" name="Gast betritt Restaurant">
       <outgoing>SequenceFlow_ToOrder_14a0oky</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_ToOrder_14a0oky" sourceRef="StartEvent_1" targetRef="Task_TakeOrder_12j0pib"/>

     <task id="Task_TakeOrder_12j0pib" name="Bestellung aufnehmen">
       <incoming>SequenceFlow_ToOrder_14a0oky</incoming>
       <outgoing>SequenceFlow_ToPay_023hzxi</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_ToPay_023hzxi" sourceRef="Task_TakeOrder_12j0pib" targetRef="Task_PayAndGetPieper_05ftug5"/>

     <task id="Task_PayAndGetPieper_05ftug5" name="Bezahlung und Pieper aushändigen">
       <incoming>SequenceFlow_ToPay_023hzxi</incoming>
       <outgoing>SequenceFlow_InformCook_1ujhfx4</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_InformCook_1ujhfx4" sourceRef="Task_PayAndGetPieper_05ftug5" targetRef="Task_InformCook_0e6hvnj"/>

     <task id="Task_InformCook_0e6hvnj" name="Koch informieren">
       <incoming>SequenceFlow_InformCook_1ujhfx4</incoming>
       <outgoing>SequenceFlow_PrepareFood_035vf60</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_PrepareFood_035vf60" sourceRef="Task_InformCook_0e6hvnj" targetRef="Task_PrepareFood_0sl26uo"/>

     <task id="Task_PrepareFood_0sl26uo" name="Essen zubereiten">
       <incoming>SequenceFlow_PrepareFood_035vf60</incoming>
       <outgoing>SequenceFlow_FoodReady_06kfaev</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_FoodReady_06kfaev" sourceRef="Task_PrepareFood_0sl26uo" targetRef="ExclusiveGateway_CheckPieper_1ouv9kf"/>

     <exclusiveGateway id="ExclusiveGateway_CheckPieper_1ouv9kf">
       <incoming>SequenceFlow_FoodReady_06kfaev</incoming>
       <outgoing>SequenceFlow_CallGuest_0buzwss</outgoing>
       <outgoing>SequenceFlow_DeliverFood_0v64x8b</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_CallGuest_0buzwss" sourceRef="ExclusiveGateway_CheckPieper_1ouv9kf" targetRef="Task_CallGuest_1mpgzhg">
       <conditionExpression xsi:type="tFormalExpression">guestDidNotReactOnPieper</conditionExpression>
     </sequenceFlow>

     <task id="Task_CallGuest_1mpgzhg" name="Gast nach 5 Minuten rufen">
       <incoming>SequenceFlow_CallGuest_0buzwss</incoming>
       <outgoing>SequenceFlow_CheckAgain_0ajhekx</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_CheckAgain_0ajhekx" sourceRef="Task_CallGuest_1mpgzhg" targetRef="ExclusiveGateway_CheckPieper_1ouv9kf"/>

     <sequenceFlow id="SequenceFlow_DeliverFood_0v64x8b" sourceRef="ExclusiveGateway_CheckPieper_1ouv9kf" targetRef="Task_GetFood_0jsoxba">
       <conditionExpression xsi:type="tFormalExpression">guestReactedOnPieper</conditionExpression>
     </sequenceFlow>

     <task id="Task_GetFood_0jsoxba" name="Essen abholen">
       <incoming>SequenceFlow_DeliverFood_0v64x8b</incoming>
     </task>

     <endEvent id="EndEvent_Finished_1fx9yp3" name="Gast hat Essen verzehrt">
       <incoming>SequenceFlow_ToGetFood_023hzxi</incoming>
     </endEvent>

     <sequenceFlow id="SequenceFlow_ToGetFood_023hzxi" sourceRef="Task_GetFood_0jsoxba" targetRef="EndEvent_Finished_1fx9yp3"/>
   </process>
</definitions>