<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definitions" targetNamespace="http://bpmn.io/schema/bpmn">
  <collaboration id="Collaboration_1">
    <participant id="Participant_GO" name="GO" processRef="Pool_GO"/>
    <participant id="Participant_MSPN" name="MSPN" processRef="Pool_MSPN"/>
  </collaboration>
  <process id="Pool_GO" isExecutable="false">
    <laneSet>
      <lane id="Lane_GO">
        <flowNodeRef>StartEvent_1</flowNodeRef>
        <flowNodeRef>Task_RegisterMeasurement</flowNodeRef>
        <flowNodeRef>ExclusiveGateway_ConfirmReject</flowNodeRef>
        <flowNodeRef>Task_AssignMSPN</flowNodeRef>
        <flowNodeRef>Task_InformsMSPO</flowNodeRef>
        <flowNodeRef>Task_InformsMPO</flowNodeRef>
        <flowNodeRef>Task_InformsSP</flowNodeRef>
        <flowNodeRef>EndEvent_GO</flowNodeRef>
      </lane>
    </laneSet>
    <sequenceFlow id="SequenceFlow_RegisterMeasurement" sourceRef="StartEvent_1" targetRef="Task_RegisterMeasurement"/>
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_RegisterMeasurement</outgoing>
    </startEvent>
    <task id="Task_RegisterMeasurement" name="Registers the measurement">
      <incoming>SequenceFlow_RegisterMeasurement</incoming>
      <outgoing>SequenceFlow_ExamineApplication</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_ExamineApplication" sourceRef="Task_RegisterMeasurement" targetRef="ExclusiveGateway_ConfirmReject"/>
    <exclusiveGateway id="ExclusiveGateway_ConfirmReject">
      <incoming>SequenceFlow_ExamineApplication</incoming>
      <outgoing>SequenceFlow_RejectsApplication</outgoing>
      <outgoing>SequenceFlow_ConfirmsApplication</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_RejectsApplication" sourceRef="ExclusiveGateway_ConfirmReject" targetRef="EndEvent_GO"/>
    <endEvent id="EndEvent_GO">
      <incoming>SequenceFlow_RejectsApplication</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_ConfirmsApplication" sourceRef="ExclusiveGateway_ConfirmReject" targetRef="Task_AssignMSPN"/>
    <task id="Task_AssignMSPN" name="Assigns MSPN">
      <incoming>SequenceFlow_ConfirmsApplication</incoming>
      <outgoing>SequenceFlow_InformsMSPO</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_InformsMSPO" sourceRef="Task_AssignMSPN" targetRef="Task_InformsMSPO"/>
    <task id="Task_InformsMSPO" name="Informs MSPO">
      <incoming>SequenceFlow_InformsMSPO</incoming>
      <outgoing>SequenceFlow_InformsMPO</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_InformsMPO" sourceRef="Task_InformsMSPO" targetRef="Task_InformsMPO"/>
    <task id="Task_InformsMPO" name="Informs MPO">
      <incoming>SequenceFlow_InformsMPO</incoming>
      <outgoing>SequenceFlow_InformsSP</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_InformsSP" sourceRef="Task_InformsMPO" targetRef="Task_InformsSP"/>
    <task id="Task_InformsSP" name="Informs SP">
      <incoming>SequenceFlow_InformsSP</incoming>
    </task>
  </process>
  <process id="Pool_MSPN" isExecutable="false">
    <!-- empty process -->
  </process>
</definitions>