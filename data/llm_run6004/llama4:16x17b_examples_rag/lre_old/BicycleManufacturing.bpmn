<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                 xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                 xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                 xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_0">
    <bpmn:participant id="Participant_0" name="Sales Department" processRef="Process_1"/>
    <bpmn:participant id="Participant_1" name="Storehouse" processRef="Process_2"/>
    <bpmn:participant id="Participant_2" name="Engineering Department" processRef="Process_3"/>
  </bpmn:collaboration>
  
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_0" name="Sales Staff">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    
    <bpmn:startEvent id="StartEvent_1" name="New Order">
      <bpmn:outgoing>SequenceFlow_0</bpmn:outgoing>
    </bpmn:startEvent>
    
    <bpmn:exclusiveGateway id="ExclusiveGateway_0">
      <bpmn:incoming>SequenceFlow_0</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <bpmn:sequenceFlow id="SequenceFlow_0" sourceRef="StartEvent_1" targetRef="ExclusiveGateway_0"/>
    <bpmn:sequenceFlow id="SequenceFlow_1" name="Reject Order" sourceRef="ExclusiveGateway_0" targetRef="EndEvent_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_2" name="Accept Order" sourceRef="ExclusiveGateway_0" targetRef="Task_0"/>
    
    <bpmn:task id="Task_0" name="Inform Storehouse and Engineering">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="Task_0" targetRef="EndEvent_1"/>
    
    <bpmn:endEvent id="EndEvent_1" name="Order Finished">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>

  <bpmn:process id="Process_2" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_1" name="Storehouse Staff">
        <bpmn:flowNodeRef>Task_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    
    <bpmn:startEvent id="StartEvent_2" name="Prepare Parts">
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
    </bpmn:startEvent>
    
    <bpmn:task id="Task_1" name="Process Part List">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="StartEvent_2" targetRef="Task_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="Task_1" targetRef="EndEvent_2"/>
    
    <bpmn:endEvent id="EndEvent_2" name="Parts Ready">
      <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>

  <bpmn:process id="Process_3" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_2" name="Engineers">
        <bpmn:flowNodeRef>Task_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    
    <bpmn:startEvent id="StartEvent_3" name="Assemble Bicycle">
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
    </bpmn:startEvent>
    
    <bpmn:task id="Task_2" name="Assemble and Ship Bicycle">
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="StartEvent_3" targetRef="Task_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_7" sourceRef="Task_2" targetRef="EndEvent_3"/>
    
    <bpmn:endEvent id="EndEvent_3" name="Bicycle Shipped">
      <bpmn:incoming>SequenceFlow_7</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>

</bpmn:definitions>