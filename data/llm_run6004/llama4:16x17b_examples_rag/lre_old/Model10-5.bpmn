<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                 xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                 xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                 xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_MPNO" name="MPON" processRef="Process_MPNO"/>
    <bpmn:participant id="Participant_MPOO" name="MPOO" processRef="Process_MPOO"/>
    <bpmn:messageFlow id="MessageFlow_RequestBid" sourceRef="Task_1" targetRef="StartEvent_MPoo_SendTender"/>
    <bpmn:messageFlow id="MessageFlow_SendOrder" sourceRef="Task_2" targetRef="IntermediateCatchEvent_Mpoo_ConfirmOrder"/>
  </bpmn:collaboration>
  
  <bpmn:process id="Process_MPNO" isExecutable="false">
    <bpmn:startEvent id="StartEvent_MPNO_RequestBid" name="Request Device Takeover Bid">
      <bpmn:outgoing>SequenceFlow_RequestBid</bpmn:outgoing>
    </bpmn:startEvent>
    
    <bpmn:task id="Task_1" name="Requests a device takeover bid of the MPOO">
      <bpmn:incoming>SequenceFlow_RequestBid</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToOrder</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:sequenceFlow id="SequenceFlow_RequestBid" sourceRef="StartEvent_MPNO_RequestBid" targetRef="Task_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_ToOrder" sourceRef="Task_1" targetRef="Task_2"/>
    
    <bpmn:task id="Task_2" name="Places an order at the MPOO">
      <bpmn:incoming>SequenceFlow_ToOrder</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OrderPlaced</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:sequenceFlow id="SequenceFlow_OrderPlaced" sourceRef="Task_2" targetRef="IntermediateCatchEvent_MPNO_ReceiveMasterData"/>
    
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_MPNO_ReceiveMasterData" name="Receives master data from MPOO">
      <bpmn:incoming>SequenceFlow_OrderPlaced</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MasterDataReceived</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    
    <bpmn:sequenceFlow id="SequenceFlow_MasterDataReceived" sourceRef="IntermediateCatchEvent_MPNO_ReceiveMasterData" targetRef="EndEvent_MPNO_OrderProcessed"/>
    
    <bpmn:endEvent id="EndEvent_MPNO_OrderProcessed" name="Order processed">
      <bpmn:incoming>SequenceFlow_MasterDataReceived</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  
  <bpmn:process id="Process_MPOO" isExecutable="false">
    <bpmn:startEvent id="StartEvent_MPoo_SendTender" name="Sends tender for equipment takeover to MPON">
      <bpmn:outgoing>SequenceFlow_TenderSent</bpmn:outgoing>
    </bpmn:startEvent>
    
    <bpmn:sequenceFlow id="SequenceFlow_TenderSent" sourceRef="StartEvent_MPoo_SendTender" targetRef="IntermediateCatchEvent_Mpoo_ReceiveOrder"/>
    
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_Mpoo_ReceiveOrder" name="Receives order from MPON">
      <bpmn:incoming>SequenceFlow_TenderSent</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OrderReceived</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    
    <bpmn:sequenceFlow id="SequenceFlow_OrderReceived" sourceRef="IntermediateCatchEvent_Mpoo_ReceiveOrder" targetRef="Task_3"/>
    
    <bpmn:task id="Task_3" name="Confirms the order of MPON and sends master data">
      <bpmn:incoming>SequenceFlow_OrderReceived</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OrderConfirmed</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:sequenceFlow id="SequenceFlow_OrderConfirmed" sourceRef="Task_3" targetRef="EndEvent_MPoo_OrderConfirmed"/>
    
    <bpmn:endEvent id="EndEvent_MPoo_OrderConfirmed" name="Order confirmed">
      <bpmn:incoming>SequenceFlow_OrderConfirmed</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>