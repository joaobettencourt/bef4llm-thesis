<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
    <collaboration id="Collaboration_0">
        <participant id="Participant_0" name="Outpatient Department" processRef="Process_1"/>
        <participant id="Participant_1" name="Ward" processRef="Process_2"/>
        <participant id="Participant_2" name="Lab" processRef="Process_3"/>
    </collaboration>
    <process id="Process_1" isExecutable="false">
        <laneSet>
            <lane id="Lane_0" name="Outpatient Physician">
                <flowNodeRef>StartEvent_1</flowNodeRef>
                <flowNodeRef>Task_01</flowNodeRef>
                <flowNodeRef>ExclusiveGateway_01</flowNodeRef>
                <flowNodeRef>Task_02</flowNodeRef>
                <flowNodeRef>Task_03</flowNodeRef>
            </lane>
        </laneSet>

        <startEvent id="StartEvent_1" name="Patient Examination">
            <outgoing>SequenceFlow_01</outgoing>
        </startEvent>

        <sequenceFlow id="SequenceFlow_01" sourceRef="StartEvent_1" targetRef="Task_01"/>

        <task id="Task_01" name="Examine Patient">
            <incoming>SequenceFlow_01</incoming>
            <outgoing>SequenceFlow_02</outgoing>
        </task>

        <exclusiveGateway id="ExclusiveGateway_01" name="Is Additional Examination Needed?">
            <incoming>SequenceFlow_02</incoming>
            <outgoing>SequenceFlow_03</outgoing>
            <outgoing>SequenceFlow_04</outgoing>
        </exclusiveGateway>

        <sequenceFlow id="SequenceFlow_02" sourceRef="Task_01" targetRef="ExclusiveGateway_01"/>

        <task id="Task_02" name="Fill Out Examination Form">
            <incoming>SequenceFlow_03</incoming>
            <outgoing>SequenceFlow_05</outgoing>
        </task>

        <sequenceFlow id="SequenceFlow_03" sourceRef="ExclusiveGateway_01" targetRef="Task_02"/>

        <endEvent id="EndEvent_01" name="Examination Finished">
            <incoming>SequenceFlow_05</incoming>
        </endEvent>

        <sequenceFlow id="SequenceFlow_04" sourceRef="ExclusiveGateway_01" targetRef="Task_03"/>

        <task id="Task_03" name="Place Order for Examination and Treatment">
            <incoming>SequenceFlow_04</incoming>
            <outgoing>SequenceFlow_06</outgoing>
        </task>

        <sequenceFlow id="SequenceFlow_05" sourceRef="Task_02" targetRef="EndEvent_01"/>

        <sequenceFlow id="SequenceFlow_06" sourceRef="Task_03" targetRef="ExclusiveGateway_1"/>
    </process>

    <process id="Process_2" isExecutable="false">
        <laneSet>
            <lane id="Lane_1" name="Ward Physician">
                <flowNodeRef>StartEvent_2</flowNodeRef>
                <flowNodeRef>Task_04</flowNodeRef>
            </lane>
        </laneSet>

        <startEvent id="StartEvent_2" name="Sample Collection">
            <outgoing>SequenceFlow_07</outgoing>
        </startEvent>

        <sequenceFlow id="SequenceFlow_07" sourceRef="StartEvent_2" targetRef="Task_04"/>

        <task id="Task_04" name="Collect Sample">
            <incoming>SequenceFlow_07</incoming>
            <outgoing>SequenceFlow_08</outgoing>
        </task>

        <endEvent id="EndEvent_2" name="Sample Sent to Lab">
            <incoming>SequenceFlow_08</incoming>
        </endEvent>

        <sequenceFlow id="SequenceFlow_08" sourceRef="Task_04" targetRef="EndEvent_2"/>
    </process>

    <process id="Process_3" isExecutable="false">
        <laneSet>
            <lane id="Lane_2" name="Lab Physician">
                <flowNodeRef>StartEvent_3</flowNodeRef>
                <flowNodeRef>Task_05</flowNodeRef>
                <flowNodeRef>ExclusiveGateway_2</flowNodeRef>
            </lane>
        </laneSet>

        <startEvent id="StartEvent_3" name="Sample Receipt">
            <outgoing>SequenceFlow_09</outgoing>
        </startEvent>

        <sequenceFlow id="SequenceFlow_09" sourceRef="StartEvent_3" targetRef="Task_05"/>

        <task id="Task_05" name="Validate Sample">
            <incoming>SequenceFlow_09</incoming>
            <outgoing>SequenceFlow_10</outgoing>
        </task>

        <exclusiveGateway id="ExclusiveGateway_2" name="Is Sample Contaminated?">
            <incoming>SequenceFlow_10</incoming>
            <outgoing>SequenceFlow_11</outgoing>
            <outgoing>SequenceFlow_12</outgoing>
        </exclusiveGateway>

        <sequenceFlow id="SequenceFlow_10" sourceRef="Task_05" targetRef="ExclusiveGateway_2"/>

        <endEvent id="EndEvent_3" name="Analysis Performed">
            <incoming>SequenceFlow_11</incoming>
        </endEvent>

        <sequenceFlow id="SequenceFlow_11" sourceRef="ExclusiveGateway_2" targetRef="EndEvent_3"/>
    </process>
    
    <!-- Define Message Flows  -->
    <messageFlow id="MessageFlow_1" name="Order for Examination and Treatment"
                 sourceRef="Process_1:Task_03" targetRef="Process_2:StartEvent_2"/>
    <messageFlow id="MessageFlow_2" name="Sample Sent to Lab"
                 sourceRef="Process_2:EndEvent_2" targetRef="Process_3:StartEvent_3"/>    
</definitions>