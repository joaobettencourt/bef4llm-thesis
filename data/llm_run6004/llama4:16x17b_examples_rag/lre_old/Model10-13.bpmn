<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://example.com/bpmn">
  <process id="Process_INQ" isExecutable="true">
    <startEvent id="StartEvent_INQ_SendRequest">
      <outgoing>SequenceFlow_INQ_SendRequest</outgoing>
    </startEvent>
    
    <sequenceFlow id="SequenceFlow_INQ_SendRequest" sourceRef="StartEvent_INQ_SendRequest" targetRef="Task_INQ_TransmitRequest"/>
    
    <task id="Task_INQ_TransmitRequest" name="Transmit transaction data request">
      <incoming>SequenceFlow_INQ_SendRequest</incoming>
      <outgoing>SequenceFlow_INQ_WaitResponse</outgoing>
    </task>
    
    <sequenceFlow id="SequenceFlow_INQ_WaitResponse" sourceRef="Task_INQ_TransmitRequest" targetRef="IntermediateCatchEvent_INQ_ReceiveResponse"/>
    
    <intermediateCatchEvent id="IntermediateCatchEvent_INQ_ReceiveResponse">
      <incoming>SequenceFlow_INQ_WaitResponse</incoming>
      <outgoing>SequenceFlow_INQ_ProcessResponse</outgoing>
    </intermediateCatchEvent>
    
    <sequenceFlow id="SequenceFlow_INQ_ProcessResponse" sourceRef="IntermediateCatchEvent_INQ_ReceiveResponse" targetRef="EndEvent_INQ_Complete"/>
    
    <endEvent id="EndEvent_INQ_Complete">
      <incoming>SequenceFlow_INQ_ProcessResponse</incoming>
    </endEvent>
  </process>
  
  <process id="Process_IP" isExecutable="true">
    <startEvent id="StartEvent_IP_ReceiveRequest">
      <incoming messageRef="MessageFlow_Request"/>
      <outgoing>SequenceFlow_IP_CheckRequest</outgoing>
    </startEvent>
    
    <sequenceFlow id="SequenceFlow_IP_CheckRequest" sourceRef="StartEvent_IP_ReceiveRequest" targetRef="Task_IP_CheckRequest"/>
    
    <task id="Task_IP_CheckRequest" name="Check request">
      <incoming>SequenceFlow_IP_CheckRequest</incoming>
      <outgoing>SequenceFlow_IP_Decision</outgoing>
    </task>
    
    <exclusiveGateway id="ExclusiveGateway_IP_Decision">
      <incoming>SequenceFlow_IP_Decision</incoming>
      <outgoing>SequenceFlow_IP_Approve</outgoing>
      <outgoing>SequenceFlow_IP_Reject</outgoing>
    </exclusiveGateway>
    
    <sequenceFlow id="SequenceFlow_IP_Decision" sourceRef="Task_IP_CheckRequest" targetRef="ExclusiveGateway_IP_Decision"/>
    <sequenceFlow id="SequenceFlow_IP_Approve" name="approved" sourceRef="ExclusiveGateway_IP_Decision" targetRef="EndEvent_IP_DataTransmitted">
      <messageFlowRef>MessageFlow_Response</messageFlowRef>
    </sequenceFlow>
    
    <endEvent id="EndEvent_IP_DataTransmitted">
      <incoming>SequenceFlow_IP_Approve</incoming>
    </endEvent>
    
    <sequenceFlow id="SequenceFlow_IP_Reject" name="rejected" sourceRef="ExclusiveGateway_IP_Decision" targetRef="EndEvent_IP_RequestRejected">
      <!--<messageFlowRef>MessageFlow_Response</messageFlowRef>-->
    </sequenceFlow>
    
    <endEvent id="EndEvent_IP_RequestRejected">
      <incoming>SequenceFlow_IP_Reject</incoming>
    </endEvent>
  </process>
  
  <collaboration id="Collaboration_Main">
    <participant id="Participant_INQ" processRef="Process_INQ"/>
    <participant id="Participant_IP" processRef="Process_IP"/>
    <messageFlow id="MessageFlow_Request" sourceRef="Task_INQ_TransmitRequest" targetRef="StartEvent_IP_ReceiveRequest"/>
    <messageFlow id="MessageFlow_Response" sourceRef="EndEvent_IP_DataTransmitted" targetRef="IntermediateCatchEvent_INQ_ReceiveResponse"/>
  </collaboration>
</definitions>