<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                 xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                 xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                 id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_0" name="Account Management" processRef="Pool_0"/>
  </bpmn:collaboration>
  <bpmn:process id="Pool_0" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_0" name="Daily Operations">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateCatchEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="ExclusiveGateway_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_1" targetRef="Task_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="Task_2" targetRef="ExclusiveGateway_2"/>
    <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="ExclusiveGateway_2" targetRef="Task_3"/>
    <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="Task_3" targetRef="Task_4"/>
    <bpmn:sequenceFlow id="SequenceFlow_7" sourceRef="Task_4" targetRef="IntermediateCatchEvent_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_8" sourceRef="IntermediateCatchEvent_1" targetRef="EndEvent_1"/>

    <!-- Flow Elements -->
    <bpmn:startEvent id="StartEvent_1" name="Daily Check">
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_1" name="Backup Database and check Account Defaulters table">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="ExclusiveGateway_1" name="New records in Account Defaulters table?">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="SequenceFlow_9" sourceRef="ExclusiveGateway_1" targetRef="Task_5"/>

    <bpmn:task id="Task_2" name="Check CRM for new returns">
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="ExclusiveGateway_2" name="Defaulting client codes previously advised?">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="ExclusiveGateway_2" targetRef="Task_6"/>

    <bpmn:task id="Task_3" name="Register defaulting accounts and customers">
      <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_4" name="Produce table of defaulting accounts and send to account management">
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
    </bpmn:task>

    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_1" name="2:30 pm">
      <bpmn:incoming>SequenceFlow_7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_8</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:endEvent id="EndEvent_1" name="Process Completed">
      <bpmn:incoming>SequenceFlow_8</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Additional Tasks -->
    <bpmn:task id="Task_5" name="Register all defaulting accounts and customers">
      <bpmn:incoming>SequenceFlow_9</bpmn:incoming>
    </bpmn:task>

    <bpmn:task id="Task_6" name="Send alert to supervisor">
      <bpmn:incoming>SequenceFlow_10</bpmn:incoming>
    </bpmn:task>
  </bpmn:process>
</bpmn:definitions>