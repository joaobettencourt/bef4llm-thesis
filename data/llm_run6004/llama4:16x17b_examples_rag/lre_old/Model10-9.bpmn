<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com/bpmn">

  <process id="Process_1" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>

    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_0m9k6e"/>

    <task id="Task_0m9k6e" name="Review change request">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
      <outgoing>SequenceFlow_3</outgoing>
    </task>

    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_4</outgoing>
      <outgoing>SequenceFlow_5</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_0m9k6e" targetRef="ExclusiveGateway_1"/>
    <sequenceFlow id="SequenceFlow_3" sourceRef="Task_0m9k6e" targetRef="EndEvent_1"/>

    <task id="Task_1" name="Perform measuring point change">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_1" targetRef="Task_1"/>
    <sequenceFlow id="SequenceFlow_5" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_1"/>

    <task id="Task_2" name="Report implementation to SP/PU/GO">
      <incoming>SequenceFlow_6</incoming>
    </task>

    <sequenceFlow id="SequenceFlow_6" sourceRef="Task_1" targetRef="Task_2"/>

    <endEvent id="EndEvent_1">
      <!--<incoming>--></incoming>
    </endEvent>
  </process>
</definitions>