    <bpmn:endEvent id="EndEvent_1fx9yp3" name="Process completed">
      <bpmn:incoming>SequenceFlow_06kfaev</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:process id="Process_2" isExecutable="false">
    <bpmn:startEvent id="StartEvent_0" name="Advised of meeting">
      <bpmn:outgoing>SequenceFlow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_0" name="Read documents">
      <bpmn:incoming>SequenceFlow_0</bpmn:incoming>
