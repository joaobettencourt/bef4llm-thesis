<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com/bpmn">
  <process id="shipping_process" isExecutable="true">
    <laneSet>
      <lane id="secretary_lane">
        <flowNodeRef>StartEvent_1</flowNodeRef>
        <flowNodeRef>Task_0vaxgaa</flowNodeRef>
        <flowNodeRef>InclusiveGateway_1</flowNodeRef>
        <flowNodeRef>Task_0jsoxba</flowNodeRef>
        <flowNodeRef>ExclusiveGateway_1</flowNodeRef>
        <flowNodeRef>Task_0e6hvnj</flowNodeRef>
        <flowNodeRef>Task_0s79ile</flowNodeRef>
      </lane>
      <lane id="logistics_department_head_lane">
        <flowNodeRef>Task_12j0pib</flowNodeRef>
      </lane>
      <lane id="warehousemen_lane">
        <flowNodeRef>Task_05ftug5</flowNodeRef>
        <flowNodeRef>EndEvent_1</flowNodeRef>
      </lane>
    </laneSet>

    <sequenceFlow id="sf1" sourceRef="StartEvent_1" targetRef="Task_0vaxgaa"/>

    <startEvent id="StartEvent_1">
      <outgoing>sf1</outgoing>
    </startEvent>

    <userTask id="Task_0vaxgaa" name="Clarify shipment method">
      <outgoing>sf2</outgoing>
    </userTask>

    <sequenceFlow id="sf2" sourceRef="Task_0vaxgaa" targetRef="ExclusiveGateway_1"/>

    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>sf2</incoming>
      <outgoing>sf3</outgoing>
      <outgoing>sf4</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sf3" name="Special handling?" sourceRef="ExclusiveGateway_1" targetRef="Task_0e6hvnj"/>

    <userTask id="Task_0e6hvnj" name="Get 3 offers from logistic companies">
      <outgoing>sf5</outgoing>
    </userTask>

    <sequenceFlow id="sf5" sourceRef="Task_0e6hvnj" targetRef="Task_0s79ile"/>

    <userTask id="Task_0s79ile" name="Select logistic company and place order">
      <outgoing>sf6</outgoing>
    </userTask>

    <sequenceFlow id="sf6" sourceRef="Task_0s79ile" targetRef="InclusiveGateway_1"/>

    <inclusiveGateway id="InclusiveGateway_1">
      <incoming>sf6</incoming>
      <incoming>sf7</incoming>
      <outgoing>sf8</outgoing>
    </inclusiveGateway>

    <sequenceFlow id="sf4" sourceRef="ExclusiveGateway_1" targetRef="Task_0jsoxba"/>

    <userTask id="Task_0jsoxba" name="Write package label">
      <outgoing>sf7</outgoing>
    </userTask>

    <sequenceFlow id="sf7" sourceRef="Task_0jsoxba" targetRef="InclusiveGateway_1"/>

    <task id="Task_12j0pib" name="Insure parcel if necessary">
      <incoming>sf8</incoming>
    </task>

    <sequenceFlow id="sf8" sourceRef="InclusiveGateway_1" targetRef="Task_12j0pib"/>

    <parallelGateway id="ParallelGateway_1">
      <incoming>sf9</incoming>
      <outgoing>sf10</outgoing>
      <outgoing>sf11</outgoing>
    </parallelGateway>

    <sequenceFlow id="sf9" sourceRef="Task_12j0pib" targetRef="ParallelGateway_1"/>

    <task id="Task_05ftug5" name="Package goods">
      <incoming>sf10</incoming>
      <outgoing>sf12</outgoing>
    </task>

    <sequenceFlow id="sf10" sourceRef="ParallelGateway_1" targetRef="Task_05ftug5"/>

    <exclusiveGateway id="ExclusiveGateway_2">
      <incoming>sf12</incoming>
      <outgoing>sf13</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sf12" sourceRef="Task_05ftug5" targetRef="ExclusiveGateway_2"/>

    <task id="EndEvent_1" name="Shipment prepared">
      <incoming>sf13</incoming>
    </task>

    <sequenceFlow id="sf13" sourceRef="ExclusiveGateway_2" targetRef="EndEvent_1"/>
  </process>
</definitions>