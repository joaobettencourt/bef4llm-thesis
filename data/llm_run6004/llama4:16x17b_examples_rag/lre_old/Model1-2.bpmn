<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="Definitions_1"
             targetNamespace="http://bpmn.io/schema/bpmn">
  <process id="Process_1" isExecutable="false">
    <laneSet>
      <lane id="Lane_0" name="CRS">
        <flowNodeRef>StartEvent_1</flowNodeRef>
        <flowNodeRef>Task_0</flowNodeRef>
        <flowNodeRef>ExclusiveGateway_0</flowNodeRef>
        <flowNodeRef>ParallelGateway_0</flowNodeRef>
        <flowNodeRef>Task_1</flowNodeRef>
        <flowNodeRef>Task_2</flowNodeRef>
        <flowNodeRef>InclusiveGateway_0</flowNodeRef>
        <flowNodeRef>EndEvent_1</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="StartEvent_1" name="Customer brings in defective computer">
      <outgoing>SequenceFlow_0</outgoing>
    </startEvent>
    <task id="Task_0" name="CRS checks defect and hands out repair cost calculation">
      <incoming>SequenceFlow_0</incoming>
      <outgoing>SequenceFlow_1</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_0" sourceRef="StartEvent_1" targetRef="Task_0"/>
    <sequenceFlow id="SequenceFlow_1" sourceRef="Task_0" targetRef="ExclusiveGateway_0"/>
    <exclusiveGateway id="ExclusiveGateway_0" name="Is customer okay with costs?">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
      <outgoing>SequenceFlow_3</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_2" name="yes" sourceRef="ExclusiveGateway_0" targetRef="ParallelGateway_0"/>
    <sequenceFlow id="SequenceFlow_3" name="no" sourceRef="ExclusiveGateway_0" targetRef="EndEvent_1"/>
    <parallelGateway id="ParallelGateway_0">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_4</outgoing>
      <outgoing>SequenceFlow_5</outgoing>
    </parallelGateway>
    <sequenceFlow id="SequenceFlow_4" sourceRef="ParallelGateway_0" targetRef="Task_1"/>
    <task id="Task_1" name="Check and repair hardware">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_5" sourceRef="ParallelGateway_0" targetRef="Task_2"/>
    <task id="Task_2" name="Check and configure software">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_6" sourceRef="Task_1" targetRef="InclusiveGateway_0"/>
    <sequenceFlow id="SequenceFlow_7" sourceRef="Task_2" targetRef="InclusiveGateway_0"/>
    <inclusiveGateway id="InclusiveGateway_0">
      <incoming>SequenceFlow_6</incoming>
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </inclusiveGateway>
    <sequenceFlow id="SequenceFlow_8" sourceRef="InclusiveGateway_0" targetRef="EndEvent_1"/>
    <endEvent id="EndEvent_1" name="Repair finished">
      <incoming>SequenceFlow_3</incoming>
      <incoming>SequenceFlow_8</incoming>
    </endEvent>
  </process>
</definitions>