<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com/bpmn">
  <process id="roomServiceProcess" isExecutable="true">
    <startEvent id="guestCallsRoomService" name="Guest Calls Room Service">
      <outgoing>sequenceFlow1</outgoing>
    </startEvent>
    <sequenceFlow id="sequenceFlow1" sourceRef="guestCallsRoomService" targetRef="roomServiceManagerTakesOrder"/>
    <task id="roomServiceManagerTakesOrder" name="Room-Service Manager Takes Order">
      <incoming>sequenceFlow1</incoming>
      <outgoing>sequenceFlow2</outgoing>
      <outgoing>sequenceFlow3</outgoing>
    </task>
    <sequenceFlow id="sequenceFlow2" sourceRef="roomServiceManagerTakesOrder" targetRef="kitchenPreparesFood"/>
    <sequenceFlow id="sequenceFlow3" sourceRef="roomServiceManagerTakesOrder" targetRef="sommelierFetchesWine"/>
    <task id="kitchenPreparesFood" name="Kitchen Prepares Food">
      <incoming>sequenceFlow2</incoming>
      <outgoing>sequenceFlow4</outgoing>
    </task>
    <task id="sommelierFetchesWine" name="Sommelier Fetches Wine">
      <incoming>sequenceFlow3</incoming>
      <outgoing>sequenceFlow5</outgoing>
    </task>
    <sequenceFlow id="sequenceFlow4" sourceRef="kitchenPreparesFood" targetRef="waiterReadiesCart"/>
    <sequenceFlow id="sequenceFlow5" sourceRef="sommelierFetchesWine" targetRef="waiterReadiesCart"/>
    <task id="waiterReadiesCart" name="Waiter Readies Cart">
      <incoming>sequenceFlow4</incoming>
      <incoming>sequenceFlow5</incoming>
      <outgoing>sequenceFlow6</outgoing>
    </task>
    <sequenceFlow id="sequenceFlow6" sourceRef="waiterReadiesCart" targetRef="waiterAssignsOrder"/>
    <task id="waiterAssignsOrder" name="Waiter Assigns Order">
      <incoming>sequenceFlow6</incoming>
      <outgoing>sequenceFlow7</outgoing>
    </task>
    <sequenceFlow id="sequenceFlow7" sourceRef="waiterAssignsOrder" targetRef="waiterDeliversOrder"/>
    <task id="waiterDeliversOrder" name="Waiter Delivers Order">
      <incoming>sequenceFlow7</incoming>
      <outgoing>sequenceFlow8</outgoing>
    </task>
    <sequenceFlow id="sequenceFlow8" sourceRef="waiterDeliversOrder" targetRef="endEvent"/>
    <task id="waiterDebitsGuestsAccount" name="Waiter Debits Guest's Account">
      <incoming>sequenceFlow8</incoming>
    </task>
    <endEvent id="endEvent" name="End of Process">
      <incoming>sequenceFlow8</incoming>
    </endEvent>
  </process>
</definitions>