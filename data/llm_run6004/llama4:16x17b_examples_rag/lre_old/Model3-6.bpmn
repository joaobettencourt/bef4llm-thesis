<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definitions" targetNamespace="http://www.example.com/bpmn">

  <process id="claimsProcess" isExecutable="true">
    <startEvent id="startEvent">
      <outgoing>checkInsured</outgoing>
    </startEvent>

    <sequenceFlow id="checkInsuredFlow" sourceRef="startEvent" targetRef="checkInsured"/>

    <task id="checkInsured" name="Check if claimant is insured">
      <incoming>checkInsuredFlow</incoming>
      <outgoing>insuredGatewayFlow</outgoing>
    </task>

    <exclusiveGateway id="insuredGateway">
      <incoming>insuredGatewayFlow</incoming>
      <outgoing>yesFlow</outgoing>
      <outgoing>noFlow</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="insuredGatewayFlow" sourceRef="checkInsured" targetRef="insuredGateway"/>

    <sequenceFlow id="yesFlow" name="yes" sourceRef="insuredGateway" targetRef="evaluateSeverity"/>

    <task id="evaluateSeverity" name="Evaluate claim severity">
      <incoming>yesFlow</incoming>
      <outgoing>severityGatewayFlow</outgoing>
    </task>

    <exclusiveGateway id="severityGateway">
      <incoming>severityGatewayFlow</incoming>
      <outgoing>simpleFlow</outgoing>
      <outgoing>complexFlow</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="severityGatewayFlow" sourceRef="evaluateSeverity" targetRef="severityGateway"/>

    <task id="sendSimpleForms" name="Send simple forms to claimant">
      <incoming>simpleFlow</incoming>
      <outgoing>checkSimpleFormsFlow</outgoing>
    </task>

    <sequenceFlow id="simpleFlow" sourceRef="severityGateway" targetRef="sendSimpleForms"/>

    <task id="sendComplexForms" name="Send complex forms to claimant">
      <incoming>complexFlow</incoming>
      <outgoing>checkComplexFormsFlow</outgoing>
    </task>

    <sequenceFlow id="complexFlow" sourceRef="severityGateway" targetRef="sendComplexForms"/>

    <task id="checkSimpleForms" name="Check simple forms for completeness">
      <incoming>checkSimpleFormsFlow</incoming>
      <outgoing>registerClaimSimpleFlow</outgoing>
    </task>

    <sequenceFlow id="checkSimpleFormsFlow" sourceRef="sendSimpleForms" targetRef="checkSimpleForms"/>

    <task id="checkComplexForms" name="Check complex forms for completeness">
      <incoming>checkComplexFormsFlow</incoming>
      <outgoing>registerClaimComplexFlow</outgoing>
    </task>

    <sequenceFlow id="checkComplexFormsFlow" sourceRef="sendComplexForms" targetRef="checkComplexForms"/>

    <task id="registerClaimSimple" name="Register claim in system">
      <incoming>registerClaimSimpleFlow</incoming>
      <outgoing>endEventFlow</outgoing>
    </task>

    <sequenceFlow id="registerClaimSimpleFlow" sourceRef="checkSimpleForms" targetRef="registerClaimSimple"/>

    <task id="registerClaimComplex" name="Register claim in system">
      <incoming>registerClaimComplexFlow</incoming>
      <outgoing>endEventFlow</outgoing>
    </task>

    <sequenceFlow id="registerClaimComplexFlow" sourceRef="checkComplexForms" targetRef="registerClaimComplex"/>

    <endEvent id="endEvent">
      <incoming>endEventFlow</incoming>
    </endEvent>

    <sequenceFlow id="endEventFlow" sourceRef="registerClaimSimple" targetRef="endEvent"/>
    <sequenceFlow id="noFlow" name="no" sourceRef="insuredGateway" targetRef="informClaimant"/>

    <task id="informClaimant" name="Inform claimant">
      <incoming>noFlow</incoming>
      <outgoing>endEventInformFlow</outgoing>
    </task>

    <sequenceFlow id="endEventInformFlow" sourceRef="informClaimant" targetRef="endEvent"/>
  </process>
</definitions>