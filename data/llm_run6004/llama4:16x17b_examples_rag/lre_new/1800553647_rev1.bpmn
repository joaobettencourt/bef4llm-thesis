<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definitions" targetNamespace="http://www.example.com">

   <process id="PurchaseProcess" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>

     <task id="Task_1" name="Identify demand and check stock">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
       <outgoing>SequenceFlow_3</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="EndEvent_1">
       <conditionExpression xsi:type="tFormalExpression">${enoughStock == true}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="SequenceFlow_3" sourceRef="Task_1" targetRef="Task_2">
       <conditionExpression xsi:type="tFormalExpression">${enoughStock == false}</conditionExpression>
     </sequenceFlow>

     <task id="Task_2" name="Create purchase requisition">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_4</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_4" sourceRef="Task_2" targetRef="Task_3"/>

     <task id="Task_3" name="Check supplier information in ERP">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_5</outgoing>
       <outgoing>SequenceFlow_6</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_3" targetRef="Task_4">
       <conditionExpression xsi:type="tFormalExpression">${supplierKnown == true}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_3" targetRef="Task_7">
       <conditionExpression xsi:type="tFormalExpression">${supplierKnown == false}</conditionExpression>
     </sequenceFlow>

     <task id="Task_4" name="Create order template in ERP">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_8</outgoing>
     </task>

     <task id="Task_7" name="Create new supplier in ERP">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_7" targetRef="Task_4"/>

     <sequenceFlow id="SequenceFlow_8" sourceRef="Task_4" targetRef="UserTask_1"/>

     <userTask id="UserTask_1" name="Approve order">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_10</outgoing>
     </userTask>

     <sequenceFlow id="SequenceFlow_10" sourceRef="UserTask_1" targetRef="EndEvent_1"/>

     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_2</incoming>
       <incoming>SequenceFlow_10</incoming>
     </endEvent>

   </process>

</definitions>