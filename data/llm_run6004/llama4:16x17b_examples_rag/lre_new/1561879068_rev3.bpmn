<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definitions" targetNamespace="http://www.example.com">

   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_Register"/>

     <task id="Task_Register" name="Fill out registration form">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_Register" targetRef="ExclusiveGateway_Check"/>

     <exclusiveGateway id="ExclusiveGateway_Check">
       <incoming>SequenceFlow_2</incoming>

       <outgoing>SequenceFlow_CreditRatingOK</outgoing>
       <outgoing>SequenceFlow_CreditRatingNotOK</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_CreditRatingNotOK" name="credit rating > 9000" sourceRef="ExclusiveGateway_Check" targetRef="EndEvent_UnsuccessfulRegistration">
       <conditionExpression xsi:type="tFormalExpression">${creditRating > 9000}</conditionExpression>
     </sequenceFlow>

     <endEvent id="EndEvent_UnsuccessfulRegistration" name="Unsuccessful registration">
       <incoming>SequenceFlow_CreditRatingNotOK</incoming>
     </endEvent>

     <sequenceFlow id="SequenceFlow_CreditRatingOK" sourceRef="ExclusiveGateway_Check" targetRef="Task_CreateInterimCustomerDataset">
     </sequenceFlow>

     <task id="Task_CreateInterimCustomerDataset" name="Create interim customer dataset record">
       <incoming>SequenceFlow_CreditRatingOK</incoming>
       <outgoing>SequenceFlow_3</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_3" sourceRef="Task_CreateInterimCustomerDataset" targetRef="ParallelGateway_StartSubprocesses"/>

     <parallelGateway id="ParallelGateway_StartSubprocesses">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_DeviceProvision</outgoing>
       <outgoing>SequenceFlow_RegisterCustomerAccountISP</outgoing>
     </parallelGateway>

     <sequenceFlow id="SequenceFlow_DeviceProvision" sourceRef="ParallelGateway_StartSubprocesses" targetRef="Subprocess_DeviceProvision"/>

     <subProcess id="Subprocess_DeviceProvision">
       <incoming>SequenceFlow_DeviceProvision</incoming>
       <outgoing>SequenceFlow_DeviceProvisionCompleted</outgoing>
     </subProcess>

     <sequenceFlow id="SequenceFlow_DeviceProvisionCompleted" sourceRef="Subprocess_DeviceProvision" targetRef="ParallelGateway_Join"/>

     <sequenceFlow id="SequenceFlow_RegisterCustomerAccountISP" sourceRef="ParallelGateway_StartSubprocesses" targetRef="Subprocess_RegisterCustomerAccountISP"/>

     <subProcess id="Subprocess_RegisterCustomerAccountISP">
       <incoming>SequenceFlow_RegisterCustomerAccountISP</incoming>
       <outgoing>SequenceFlow_RegisterCustomerAccountCompleted</outgoing>
     </subProcess>

     <sequenceFlow id="SequenceFlow_RegisterCustomerAccountCompleted" sourceRef="Subprocess_RegisterCustomerAccountISP" targetRef="ParallelGateway_Join"/>

     <parallelGateway id="ParallelGateway_Join">
       <incoming>SequenceFlow_DeviceProvisionCompleted</incoming>
       <incoming>SequenceFlow_RegisterCustomerAccountCompleted</incoming>
       <outgoing>SequenceFlow_SendWelcomePackage</outgoing>
     </parallelGateway>

     <sequenceFlow id="SequenceFlow_SendWelcomePackage" sourceRef="ParallelGateway_Join" targetRef="Task_SendWelcomePackage"/>

     <task id="Task_SendWelcomePackage" name="Create and send welcome package">
       <incoming>SequenceFlow_SendWelcomePackage</incoming>
     </task>

   </process>

</definitions>