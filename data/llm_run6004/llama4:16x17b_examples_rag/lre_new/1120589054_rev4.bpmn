<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpndi="http://www.omg.org/spec/BPMN/20100524/DI"
             id="definition" targetNamespace="http://www.example.com">

   <process id="orderToCashProcess" isExecutable="true">
     <startEvent id="receiveOrder" name="Receive Order">
       <outgoing>sendToWarehouse</outgoing>
     </startEvent>

     <sequenceFlow id="sendToWarehouseSeq" sourceRef="receiveOrder" targetRef="sendToWarehouse"/>

     <task id="sendToWarehouse" name="Send to Warehouse">
       <incoming>sendToWarehouseSeq</incoming>
       <outgoing>determineParts</outgoing>
     </task>

     <sequenceFlow id="determinePartsSeq" sourceRef="sendToWarehouse" targetRef="determineParts"/>

     <task id="determineParts" name="Determine Parts Required">
       <incoming>determinePartsSeq</incoming>
       <outgoing>orderPartsSeq</outgoing>
       <outgoing>startProductionSeq</outgoing>
     </task>

     <sequenceFlow id="orderPartsSeq" sourceRef="determineParts" targetRef="orderParts"/>

     <task id="orderParts" name="Order Parts">
       <incoming>orderPartsSeq</incoming>
       <outgoing>waitForPartsSeq</outgoing>
     </task>

     <sequenceFlow id="waitForPartsSeq" sourceRef="orderParts" targetRef="waitForParts"/>

     <task id="waitForParts" name="Wait for Parts">
       <incoming>waitForPartsSeq</incoming>
       <outgoing>startProductionSeq2</outgoing>
     </task>

     <sequenceFlow id="startProductionSeq2" sourceRef="waitForParts" targetRef="startProduction"/>

     <sequenceFlow id="startProductionSeq" sourceRef="determineParts" targetRef="startProduction">
       <conditionExpression xsi:type="tFormalExpression">${allPartsAvailable()}</conditionExpression>
     </sequenceFlow>

     <task id="startProduction" name="Start Production">
       <incoming>startProductionSeq</incoming>
       <incoming>startProductionSeq2</incoming>
       <outgoing>performQualityChecksSeq</outgoing>
     </task>

     <sequenceFlow id="performQualityChecksSeq" sourceRef="startProduction" targetRef="performQualityChecks"/>

     <task id="performQualityChecks" name="Perform Quality Checks">
       <incoming>performQualityChecksSeq</incoming>
       <outgoing>packageAndLabelSeq</outgoing>
     </task>

     <sequenceFlow id="packageAndLabelSeq" sourceRef="performQualityChecks" targetRef="packageAndLabel"/>

     <task id="packageAndLabel" name="Package and Label">
       <incoming>packageAndLabelSeq</incoming>
       <outgoing>returnToWarehouseSeq</outgoing>
     </task>

     <sequenceFlow id="returnToWarehouseSeq" sourceRef="packageAndLabel" targetRef="returnToWarehouse"/>

     <task id="returnToWarehouse" name="Return to Warehouse">
       <incoming>returnToWarehouseSeq</incoming>
       <outgoing>informSalesSeq</outgoing>
     </task>

     <sequenceFlow id="informSalesSeq" sourceRef="returnToWarehouse" targetRef="informSales"/>

     <task id="informSales" name="Inform Sales">
       <incoming>informSalesSeq</incoming>
     </task>

     <endEvent id="orderToCashEnd" name="Order to Cash Complete">
       <incoming>informSalesSeq</incoming>
     </endEvent>

   </process>

</definitions>