<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definitions" targetNamespace="http://www.example.com">

   <process id="RewardAndTrainingProcess" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_CheckPerformance"/>

     <task id="Task_CheckPerformance" name="Check employee performance">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>

     <exclusiveGateway id="ExclusiveGateway_PerformanceEvaluation">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_LowPerformance</outgoing>
       <outgoing>SequenceFlow_MediumPerformance</outgoing>
       <outgoing>SequenceFlow_HighPerformance</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_CheckPerformance" targetRef="ExclusiveGateway_PerformanceEvaluation"/>

     <sequenceFlow id="SequenceFlow_LowPerformance" name="${performance  < 20}" sourceRef="ExclusiveGateway_PerformanceEvaluation" targetRef="Task_SuggestDismissal">
       <conditionExpression xsi:type="tFormalExpression">${performance  <= 20}</conditionExpression>
     </sequenceFlow>

     <task id="Task_SuggestDismissal" name="Suggest dismissal to HR">
       <incoming>SequenceFlow_LowPerformance</incoming>
       <outgoing>SequenceFlow_DismissalHandled</outgoing>
     </task>

     <endEvent id="EndEvent_Dismissal">
       <incoming>SequenceFlow_DismissalHandled</incoming>
     </endEvent>

     <sequenceFlow id="SequenceFlow_DismissalHandled" sourceRef="Task_SuggestDismissal" targetRef="EndEvent_Dismissal"/>

     <sequenceFlow id="SequenceFlow_MediumPerformance" name="${20  <= performance and performance  < 50}" sourceRef="ExclusiveGateway_PerformanceEvaluation" targetRef="Task_SuggestTraining">
       <conditionExpression xsi:type="tFormalExpression">${performance  >= 20 and performance  < 50}</conditionExpression>
     </sequenceFlow>

     <task id="Task_SuggestTraining" name="Suggest training to HR">
       <incoming>SequenceFlow_MediumPerformance</incoming>
       <outgoing>SequenceFlow_TrainingHandled</outgoing>
     </task>

     <endEvent id="EndEvent_Training">
       <incoming>SequenceFlow_TrainingHandled</incoming>
     </endEvent>

     <sequenceFlow id="SequenceFlow_TrainingHandled" sourceRef="Task_SuggestTraining" targetRef="EndEvent_Training"/>

     <sequenceFlow id="SequenceFlow_HighPerformance" name="${performance  >= 75}" sourceRef="ExclusiveGateway_PerformanceEvaluation" targetRef="Task_SuggestReward">
       <conditionExpression xsi:type="tFormalExpression">${performance  >= 75}</conditionExpression>
     </sequenceFlow>

     <task id="Task_SuggestReward" name="Suggest reward to management">
       <incoming>SequenceFlow_HighPerformance</incoming>
       <outgoing>SequenceFlow_RewardHandled</outgoing>
     </task>

     <exclusiveGateway id="ExclusiveGateway_RewardType">
       <incoming>SequenceFlow_RewardHandled</incoming>
       <outgoing>SequenceFlow_FinancialReward</outgoing>
       <outgoing>SequenceFlow_OtherBenefit</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_RewardHandled" sourceRef="Task_SuggestReward" targetRef="ExclusiveGateway_RewardType"/>

     <sequenceFlow id="SequenceFlow_FinancialReward" sourceRef="ExclusiveGateway_RewardType" targetRef="EndEvent_AnnounceEmployeeOfTheMonth">
       <!-- Add financial reward logic here -->
     </sequenceFlow>

     <sequenceFlow id="SequenceFlow_OtherBenefit" sourceRef="ExclusiveGateway_RewardType" targetRef="EndEvent_AnnounceEmployeeOfTheMonth">
       <!-- Add other benefit logic here -->
     </sequenceFlow>

     <endEvent id="EndEvent_AnnounceEmployeeOfTheMonth">
       <!-- Incoming flows from financial reward and other benefit tasks -->
     </endEvent>
   </process>
</definitions>