<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definitions" targetNamespace="http://www.example.com">

   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_Management_NewClients"/>

     <task id="Task_Management_NewClients" name="Management indicates need for new clients">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_Management_NewClients" targetRef="Task_Marketing_MarketAnalysis"/>

     <laneSet id="LaneSet_1">
       <lane id="Lane_Marketing" name="Marketing">
         <flowNodeRef>Task_Marketing_MarketAnalysis</flowNodeRef>
         <flowNodeRef>Task_Marketing_PreparePortfolio</flowNodeRef>
         <flowNodeRef>Task_Marketing_SendOffers</flowNodeRef>
       </lane>

       <lane id="Lane_Management" name="Management">
         <flowNodeRef>Task_Management_InformResponses</flowNodeRef>
         <flowNodeRef>ExclusiveGateway_1</flowNodeRef>
         <flowNodeRef>Task_Management_PrepareContract</flowNodeRef>
         <flowNodeRef>Task_Management_AnalyzeFailure</flowNodeRef>
       </lane>
     </laneSet>

     <task id="Task_Marketing_MarketAnalysis" name="Perform market analysis">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_3" sourceRef="Task_Marketing_MarketAnalysis" targetRef="Task_Marketing_PreparePortfolio"/>

     <task id="Task_Marketing_PreparePortfolio" name="Prepare portfolio presentation">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_4</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_4" sourceRef="Task_Marketing_PreparePortfolio" targetRef="Task_Marketing_SendOffers"/>

     <task id="Task_Marketing_SendOffers" name="Send out offers to potential clients">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_Marketing_SendOffers" targetRef="Task_Management_InformResponses"/>

     <task id="Task_Management_InformResponses" name="Informs management about responses">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_Management_InformResponses" targetRef="ExclusiveGateway_1"/>

     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_7</outgoing>
       <outgoing>SequenceFlow_8</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_7" name="Client accepts offer" sourceRef="ExclusiveGateway_1" targetRef="Task_Management_PrepareContract">
     </sequenceFlow>

     <task id="Task_Management_PrepareContract" name="Prepare contract">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_Management_PrepareContract" targetRef="EndEvent_Signed"/>

     <endEvent id="EndEvent_Signed">
       <incoming>SequenceFlow_9</incoming>
     </endEvent>

     <sequenceFlow id="SequenceFlow_8" name="Client rejects offer" sourceRef="ExclusiveGateway_1" targetRef="Task_Management_AnalyzeFailure">
     </sequenceFlow>

     <task id="Task_Management_AnalyzeFailure" name="Analyze reason for failure">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_10</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_10" sourceRef="Task_Management_AnalyzeFailure" targetRef="EndEvent_FailureAnalyzed"/>

     <endEvent id="EndEvent_FailureAnalyzed">
       <incoming>SequenceFlow_10</incoming>
     </endEvent>
   </process>

</definitions>