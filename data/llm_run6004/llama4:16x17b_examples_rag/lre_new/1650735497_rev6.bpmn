<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd" 
             id="definitions" targetNamespace="http://www.example.com">

    <process id="Process_1" isExecutable="true">
      <laneSet>
        <lane id="Lane_PayPal_Client" name="PayPal Client">
          <flowNodeRef>Task_EnterBankDetails</flowNodeRef>
          <flowNodeRef>StartEvent_1</flowNodeRef>
          <flowNodeRef>Task_VerifyDeposits</flowNodeRef>
          <flowNodeRef>ExclusiveGateway_ConfirmAccount</flowNodeRef>
        </lane>
        <lane id="Lane_PayPal_System" name="PayPal System">
          <flowNodeRef>IntermediateThrowEvent_MakeDeposits</flowNodeRef>
          <flowNodeRef>Task_NotifyClientOfDeposits</flowNodeRef>
          <flowNodeRef>ExclusiveGateway_AccountVerified</flowNodeRef>
        </lane>
      </laneSet>

      <startEvent id="StartEvent_1">
        <outgoing>SequenceFlow_1</outgoing>
      </startEvent>

      <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_EnterBankDetails"/>

      <task id="Task_EnterBankDetails" name="Enter bank details and click continue">
        <incoming>SequenceFlow_1</incoming>
        <outgoing>SequenceFlow_2</outgoing>
      </task>

      <sequenceFlow id="SequenceFlow_2" sourceRef="Task_EnterBankDetails" targetRef="IntermediateThrowEvent_MakeDeposits"/>

      <intermediateThrowEvent id="IntermediateThrowEvent_MakeDeposits">
        <incoming>SequenceFlow_2</incoming>
        <outgoing>SequenceFlow_3</outgoing>
      </intermediateThrowEvent>

      <sequenceFlow id="SequenceFlow_3" sourceRef="IntermediateThrowEvent_MakeDeposits" targetRef="Task_NotifyClientOfDeposits"/>

      <task id="Task_NotifyClientOfDeposits" name="Notify client to verify bank account">
        <incoming>SequenceFlow_3</incoming>
        <outgoing>SequenceFlow_4</outgoing>
      </task>

      <sequenceFlow id="SequenceFlow_4" sourceRef="Task_NotifyClientOfDeposits" targetRef="Task_VerifyDeposits"/>

      <task id="Task_VerifyDeposits" name="Enter deposit amounts and click verify">
        <incoming>SequenceFlow_4</incoming>
        <outgoing>SequenceFlow_5</outgoing>
      </task>

      <sequenceFlow id="SequenceFlow_5" sourceRef="Task_VerifyDeposits" targetRef="ExclusiveGateway_ConfirmAccount"/>

      <exclusiveGateway id="ExclusiveGateway_ConfirmAccount">
        <incoming>SequenceFlow_5</incoming>
        <outgoing>SequenceFlow_6</outgoing>
        <outgoing>SequenceFlow_7</outgoing>
      </exclusiveGateway>

      <sequenceFlow id="SequenceFlow_6" name="Values match" sourceRef="ExclusiveGateway_ConfirmAccount" targetRef="EndEvent_AccountVerified">
        <conditionExpression xsi:type="tFormalExpression">${depositAmountsMatch}</conditionExpression>
      </sequenceFlow>

      <sequenceFlow id="SequenceFlow_7" name="Values do not match" sourceRef="ExclusiveGateway_ConfirmAccount" targetRef="Task_RemoveBankDetails"/>

      <task id="Task_RemoveBankDetails" name="Remove bank details from PayPal system">
        <incoming>SequenceFlow_7</incoming>
        <outgoing>SequenceFlow_8</outgoing>
      </task>

      <sequenceFlow id="SequenceFlow_8" sourceRef="Task_RemoveBankDetails" targetRef="EndEvent_BankAccountRemoved"/>

      <endEvent id="EndEvent_AccountVerified">
        <incoming>SequenceFlow_6</incoming>
      </endEvent>

      <endEvent id="EndEvent_BankAccountRemoved">
        <incoming>SequenceFlow_8</incoming>
      </endEvent>

    </process>

  </definitions>