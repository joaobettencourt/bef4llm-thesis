<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/BPMN20.xsd"
             id="definition" targetNamespace="http://www.example.com">

   <process id="NewApplicationForUSICourse" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>

     <task id="Task_1" name="Select a course and check for free slots">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="ExclusiveGateway_1"/>

     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_4</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_3" name="Slots available" sourceRef="ExclusiveGateway_1" targetRef="Task_2">
       <conditionExpression xsi:type="tFormalExpression">${slotsAvailable == true}</conditionExpression>
     </sequenceFlow>

     <task id="Task_2" name="Select course and dates">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_4" name="No slots available" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_1">
       <conditionExpression xsi:type="tFormalExpression">${slotsAvailable == false}</conditionExpression>
     </sequenceFlow>

     <exclusiveGateway id="ExclusiveGateway_2">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_6</outgoing>
       <outgoing>SequenceFlow_7</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_2" targetRef="ExclusiveGateway_2"/>

     <sequenceFlow id="SequenceFlow_6" name="Account exists" sourceRef="ExclusiveGateway_2" targetRef="Task_3">
       <conditionExpression xsi:type="tFormalExpression">${accountExists == true}</conditionExpression>
     </sequenceFlow>

     <task id="Task_3" name="Log into account and connect to Twitter">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_8</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_7" name="Account does not exist" sourceRef="ExclusiveGateway_2" targetRef="Task_4">
       <conditionExpression xsi:type="tFormalExpression">${accountExists == false}</conditionExpression>
     </sequenceFlow>

     <exclusiveGateway id="ExclusiveGateway_3">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_9</outgoing>
       <outgoing>SequenceFlow_10</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_8" sourceRef="Task_3" targetRef="Task_5"/>

     <task id="Task_4" name="Check if registered at eligible university">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_9" name="Registered at eligible university" sourceRef="Task_4" targetRef="Task_5">
       <conditionExpression xsi:type="tFormalExpression">${registeredAtEligibleUniversity == true}</conditionExpression>
     </sequenceFlow>

     <task id="Task_5" name="Register account or request activation">
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_11</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_10" name="Not registered at eligible university" sourceRef="ExclusiveGateway_3" targetRef="EndEvent_1">
       <conditionExpression xsi:type="tFormalExpression">${registeredAtEligibleUniversity == false}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="SequenceFlow_11" sourceRef="Task_5" targetRef="Task_3"/>

     <task id="Task_6" name="Complete registration and provide payment information">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_12</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_12" sourceRef="Task_6" targetRef="EndEvent_1"/>

     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_4</incoming>
       <incoming>SequenceFlow_10</incoming>
       <incoming>SequenceFlow_12</incoming>
     </endEvent>

   </process>
</definitions>