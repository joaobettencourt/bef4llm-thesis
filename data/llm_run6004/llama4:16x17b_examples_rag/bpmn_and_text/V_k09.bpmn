<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/DD/20100524/DC/ http://www.omg.org/spec/DD/20100524/DI/"
             id="definition" targetNamespace="http://www.example.com">

   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_ReadOrder"/>

     <task id="Task_ReadOrder" name="Read order from automatic order management system">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_ReadOrder" targetRef="ExclusiveGateway_CheckProduct"/>

     <exclusiveGateway id="ExclusiveGateway_CheckProduct">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_13</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_3" name="${productInStock == true}" sourceRef="ExclusiveGateway_CheckProduct" targetRef="Task_WithdrawProduct"/>

     <task id="Task_WithdrawProduct" name="Withdraw product from warehouse">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_4</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_4" sourceRef="Task_WithdrawProduct" targetRef="ExclusiveGateway_CheckOrderReady"/>

     <sequenceFlow id="SequenceFlow_13" name="${productInStock == false}" sourceRef="ExclusiveGateway_CheckProduct" targetRef="Task_ReorderProduct"/>

     <task id="Task_ReorderProduct" name="Reorder product from wholesaler">
       <incoming>SequenceFlow_13</incoming>
       <outgoing>SequenceFlow_14</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_14" sourceRef="Task_ReorderProduct" targetRef="IntermediateEvent_WaitForProduct"/>

     <intermediateCatchEvent id="IntermediateEvent_WaitForProduct">
       <incoming>SequenceFlow_14</incoming>
       <outgoing>SequenceFlow_15</outgoing>
     </intermediateCatchEvent>

     <sequenceFlow id="SequenceFlow_15" sourceRef="IntermediateEvent_WaitForProduct" targetRef="Task_RegisterProductInStockManagementSystem"/>

     <task id="Task_RegisterProductInStockManagementSystem" name="Register product in stock management system">
       <incoming>SequenceFlow_15</incoming>
       <outgoing>SequenceFlow_16</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_16" sourceRef="Task_RegisterProductInStockManagementSystem" targetRef="ExclusiveGateway_CheckOrderReady"/>

     <exclusiveGateway id="ExclusiveGateway_CheckOrderReady">
       <incoming>SequenceFlow_4</incoming>
       <incoming>SequenceFlow_16</incoming>
       <outgoing>SequenceFlow_17</outgoing>
       <outgoing>SequenceFlow_18</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_17" name="${orderReadyForShipment == true}" sourceRef="ExclusiveGateway_CheckOrderReady" targetRef="Task_RequestCourierAndPack"/>

     <task id="Task_RequestCourierAndPack" name="Request courier and pack products">
       <incoming>SequenceFlow_17</incoming>
       <outgoing>SequenceFlow_19</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_19" sourceRef="Task_RequestCourierAndPack" targetRef="EndEvent_ShipOrder"/>

     <sequenceFlow id="SequenceFlow_18" name="${orderReadyForShipment == false}" sourceRef="ExclusiveGateway_CheckOrderReady" targetRef="Task_SelectNextProduct"/>

     <task id="Task_ReorderWithPenalty" name="Reorder with penalty from wholesaler">
       <incoming>SequenceFlow_21</incoming>
     </task>

     <sequenceFlow id="SequenceFlow_21" sourceRef="IntermediateEvent_WaitForProduct" targetRef="Task_ReorderWithPenalty"/>

     <task id="Task_SelectNextProduct" name="Select next product from order">
       <incoming>SequenceFlow_18</incoming>
       <outgoing>SequenceFlow_20</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_20" sourceRef="Task_SelectNextProduct" targetRef="ExclusiveGateway_CheckProduct"/>

     <endEvent id="EndEvent_ShipOrder">
       <incoming>SequenceFlow_19</incoming>
     </endEvent>

   </process>
</definitions>