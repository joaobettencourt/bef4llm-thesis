<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/06-02-01.xsd" 
             id="definition" targetNamespace="http://www.example.com">

    <process id="AppForParticipatingAtTheViennaNightRun" isExecutable="true">
      <startEvent id="StartEvent_1">
        <outgoing>SequenceFlow_1</outgoing>
      </startEvent>

      <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_SelectStartingBlock"/>

      <task id="Task_SelectStartingBlock" name="Select starting block">
        <incoming>SequenceFlow_1</incoming>
        <outgoing>SequenceFlow_2</outgoing>
      </task>

      <sequenceFlow id="SequenceFlow_2" sourceRef="Task_SelectStartingBlock" targetRef="Task_Run5km"/>

      <task id="Task_Run5km" name="Run 5km and measure time">
        <incoming>SequenceFlow_2</incoming>
        <outgoing>SequenceFlow_3</outgoing>
      </task>

      <sequenceFlow id="SequenceFlow_3" sourceRef="Task_Run5km" targetRef="ExclusiveGateway_1"/>

      <exclusiveGateway id="ExclusiveGateway_1">
        <incoming>SequenceFlow_3</incoming>
        <outgoing>SequenceFlow_4</outgoing>
        <outgoing>SequenceFlow_5</outgoing>
      </exclusiveGateway>

      <sequenceFlow id="SequenceFlow_4" name="${time <= 25}" sourceRef="ExclusiveGateway_1" targetRef="Task_GetStartingNumber"/>

      <task id="Task_GetStartingNumber" name="Get starting number">
        <incoming>SequenceFlow_4</incoming>
        <outgoing>SequenceFlow_6</outgoing>
      </task>

      <sequenceFlow id="SequenceFlow_6" sourceRef="Task_GetStartingNumber" targetRef="ExclusiveGateway_2"/>

      <exclusiveGateway id="ExclusiveGateway_2">
        <incoming>SequenceFlow_6</incoming>
        <outgoing>SequenceFlow_7</outgoing>
        <outgoing>SequenceFlow_8</outgoing>
      </exclusiveGateway>

      <sequenceFlow id="SequenceFlow_7" name="${workdayEnd - startTime > 60}" sourceRef="ExclusiveGateway_2" targetRef="Task_GoHome">
        <conditionExpression xsi:type="tFormalExpression">${workdayEnd - startTime > 60}</conditionExpression>
      </sequenceFlow>

      <task id="Task_GoHome" name="Go there from home">
        <incoming>SequenceFlow_7</incoming>
        <outgoing>SequenceFlow_9</outgoing>
      </task>

      <sequenceFlow id="SequenceFlow_8" name="${workdayEnd - startTime <= 60}" sourceRef="ExclusiveGateway_2" targetRef="Task_LeaveDirectlyFromWork">
        <conditionExpression xsi:type="tFormalExpression">${workdayEnd - startTime <= 60}</conditionExpression>
      </sequenceFlow>

      <task id="Task_LeaveDirectlyFromWork" name="Leave directly from work">
        <incoming>SequenceFlow_8</incoming>
        <outgoing>SequenceFlow_9</outgoing>
      </task>

      <sequenceFlow id="SequenceFlow_9" sourceRef="Task_GoHome" targetRef="EndEvent_1"/>
      <sequenceFlow id="SequenceFlow_10" sourceRef="Task_LeaveDirectlyFromWork" targetRef="EndEvent_1"/>

      <endEvent id="EndEvent_1">
        <incoming>SequenceFlow_9</incoming>
        <incoming>SequenceFlow_10</incoming>
      </endEvent>

      <sequenceFlow id="SequenceFlow_5" name="${time > 25}" sourceRef="ExclusiveGateway_1" targetRef="Task_TrainAndCheck">
        <conditionExpression xsi:type="tFormalExpression">${time > 25}</conditionExpression>
      </sequenceFlow>

      <task id="Task_TrainAndCheck" name="Train and check until achieved goal">
        <incoming>SequenceFlow_5</incoming>
        <outgoing>SequenceFlow_11</outgoing>
      </task>

      <sequenceFlow id="SequenceFlow_11" sourceRef="Task_TrainAndCheck" targetRef="ExclusiveGateway_1"/>

    </process>
</definitions>