<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" targetNamespace="http://www.example.com">

   <process id="FarmingBotProcess" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>

     <task id="Task_1" name="Define Resources to Farm">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="ParallelGateway_1"/>

     <parallelGateway id="ParallelGateway_1">
       <incoming>SequenceFlow_2</incoming>
       <!-- Add up to 10 outgoing sequence flows for parallel resource collection -->
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_11</outgoing>
     </parallelGateway>

     <!-- Example of one resource collection task, add more as needed -->
    <task id="Task_2" name="Collect Resource A">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_4</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_3" sourceRef="ParallelGateway_1" targetRef="Task_2"/>

    <!-- Add more tasks and sequence flows for other resources -->
    <task id="Task_10" name="Collect Resource B">
      <incoming>SequenceFlow_11</incoming>
      <outgoing>SequenceFlow_12</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_4" sourceRef="Task_2" targetRef="IntermediateCatchEvent_1"/>
    <sequenceFlow id="SequenceFlow_11" sourceRef="ParallelGateway_1" targetRef="Task_10"/>
    <sequenceFlow id="SequenceFlow_12" sourceRef="Task_10" targetRef="IntermediateCatchEvent_1"/>

    <!-- Natural Disaster Event -->
    <intermediateThrowEvent id="IntermediateThrowEvent_1">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_5</outgoing>
    </intermediateThrowEvent>

    <sequenceFlow id="SequenceFlow_5" sourceRef="IntermediateThrowEvent_1" targetRef="ServiceTask_1"/>

    <!-- Notification after milestone reached -->
    <serviceTask id="ServiceTask_1">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </serviceTask>

    <sequenceFlow id="SequenceFlow_6" sourceRef="ServiceTask_1" targetRef="UserTask_1"/>

    <!-- Update list of resources to farm -->
    <userTask id="UserTask_1">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </userTask>

    <sequenceFlow id="SequenceFlow_7" sourceRef="UserTask_1" targetRef="ExclusiveGateway_1"/>

    <!-- Brag to friends and/ send materials -->
    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_8</outgoing>
      <outgoing>SequenceFlow_9</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow_8" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_1"/>
    <sequenceFlow id="SequenceFlow_9" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_2"/>

    <!-- End of process -->
    <endEvent id="EndEvent_1">
      <incoming>SequenceFlow_8</incoming>
    </endEvent>

    <endEvent id="EndEvent_2">
      <incoming>SequenceFlow_9</incoming>
    </endEvent>

   </process>
</definitions>