<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/06-02-01.xsd"
             id="definition" targetNamespace="http://www.example.com">

   <process id="InstructArtist3DModelPrint" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_InstructArtist"/>

     <userTask id="Task_InstructArtist" name="Instruct artist to create a 3D model">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </userTask>

     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_InstructArtist" targetRef="ExclusiveGateway_1"/>

     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_4</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_3" name="Model ready" sourceRef="ExclusiveGateway_1" targetRef="Task_SelectColor">
       <conditionExpression xsi:type="tFormalExpression">${modelReady == true}</conditionExpression>
     </sequenceFlow>

     <task id="Task_SelectColor" name="Select plastic color">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_4" name="Model not ready" sourceRef="ExclusiveGateway_1" targetRef="Task_InstructArtist">
       <conditionExpression xsi:type="tFormalExpression">${modelReady == false}</conditionExpression>
     </sequenceFlow>

     <exclusiveGateway id="ExclusiveGateway_2">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_6</outgoing>
       <outgoing>SequenceFlow_7</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_SelectColor" targetRef="ExclusiveGateway_2"/>

     <sequenceFlow id="SequenceFlow_6" name="Color in stock" sourceRef="ExclusiveGateway_2" targetRef="Task_Prepare3DPrinting">
       <conditionExpression xsi:type="tFormalExpression">${colorInStock == true}</conditionExpression>
     </sequenceFlow>

     <task id="Task_Prepare3DPrinting" name="Prepare for 3D printing">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_8</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_7" name="Color not in stock" sourceRef="ExclusiveGateway_2" targetRef="Task_OrderColor">
       <conditionExpression xsi:type="tFormalExpression">${colorInStock == false}</conditionExpression>
     </sequenceFlow>

     <task id="Task_OrderColor" name="Order plastic color">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_8" sourceRef="Task_Prepare3DPrinting" targetRef="ServiceTask_GenerateGcode"/>

     <serviceTask id="ServiceTask_GenerateGcode" name="Generate gcode file">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_10</outgoing>
     </serviceTask>

     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_OrderColor" targetRef="Task_Prepare3DPrinting"/>

     <sequenceFlow id="SequenceFlow_10" sourceRef="ServiceTask_GenerateGcode" targetRef="ServiceTask_PrintModel"/>

     <serviceTask id="ServiceTask_PrintModel" name="Print 3D model">
       <incoming>SequenceFlow_10</incoming>
       <outgoing>SequenceFlow_11</outgoing>
     </serviceTask>

     <sequenceFlow id="SequenceFlow_11" sourceRef="ServiceTask_PrintModel" targetRef="EndEvent_1"/>

     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_11</incoming>
     </endEvent>

   </process>
</definitions>