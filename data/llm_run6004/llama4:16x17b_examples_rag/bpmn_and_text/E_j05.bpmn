<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/BPMN20.xsd" 
             id="definition" targetNamespace="http://www.example.com">
  <process id="Work_Process" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>

    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_Organize_accommodation_and_bank_account"/>

    <task id="Task_Organize_accommodation_and_bank_account">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_Organize_accommodation_and_bank_account" targetRef="ExclusiveGateway_Visa"/>

    <exclusiveGateway id="ExclusiveGateway_Visa">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
      <outgoing>SequenceFlow_4</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_Visa" targetRef="Task_Visa_Form">
      <conditionExpression xsi:type="tFormalExpression">${visa_required == true}</conditionExpression>
    </sequenceFlow>

    <task id="Task_Visa_Form">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_5</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_5" sourceRef="Task_Visa_Form" targetRef="EndEvent_1"/>

    <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_Visa" targetRef="Task_RotWeissRot_Card">
      <conditionExpression xsi:type="tFormalExpression">${months_passed == 3}</conditionExpression>
    </sequenceFlow>

    <task id="Task_RotWeissRot_Card">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_6" sourceRef="Task_RotWeissRot_Card" targetRef="EndEvent_1"/>

    <endEvent id="EndEvent_1">
      <incoming>SequenceFlow_5</incoming>
      <incoming>SequenceFlow_6</incoming>
    </endEvent>

  </process>
</definitions>