<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/DD/20100524/DC/ http://www.omg.org/spec/DD/20100524/DI/"
             id="definition" targetNamespace="http://www.example.com">

   <process id="CarServiceProcess" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_RegisterCar"/>

     <userTask id="Task_RegisterCar" name="Police reminds you of your car service">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </userTask>

     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_RegisterCar" targetRef="ExclusiveGateway_CheckRegistration"/>

     <exclusiveGateway id="ExclusiveGateway_CheckRegistration">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_4</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_3" name="Car is registered" sourceRef="ExclusiveGateway_CheckRegistration" targetRef="Task_NotifyServiceNeeded">
       <conditionExpression xsi:type="tFormalExpression">${carRegistered == true}</conditionExpression>
     </sequenceFlow>

     <task id="Task_NotifyServiceNeeded" name="System checks if car is registered and notifies you">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_NotifyServiceNeeded" targetRef="EndEvent_Fine"/>

     <endEvent id="EndEvent_Fine" name="You are fined after 30 days">
       <incoming>SequenceFlow_5</incoming>
     </endEvent>

     <sequenceFlow id="SequenceFlow_4" name="Car is not registered or no notification needed" sourceRef="ExclusiveGateway_CheckRegistration" targetRef="Task_ServiceAtFacility">
       <conditionExpression xsi:type="tFormalExpression">${carRegistered == false}</conditionExpression>
     </sequenceFlow>

     <userTask id="Task_ServiceAtFacility" name="Car service facility  - Mechanic enters problems">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </userTask>

     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_ServiceAtFacility" targetRef="Task_WaitingStatusUpdates"/>

     <task id="Task_WaitingStatusUpdates" name="You get status updates via email">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_7</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_7" sourceRef="Task_WaitingStatusUpdates" targetRef="Task_PayApp"/>

     <userTask id="Task_PayApp" name="You can pay through the app">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_8</outgoing>
     </userTask>

     <sequenceFlow id="SequenceFlow_8" sourceRef="Task_PayApp" targetRef="Task_MechanicSuccessfulRepair"/>

     <task id="Task_MechanicSuccessfulRepair" name="Mechanic enters successful repair and next service date">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_MechanicSuccessfulRepair" targetRef="EndEvent_ServiceCompleted"/>

     <endEvent id="EndEvent_ServiceCompleted" name="Service completed">
       <incoming>SequenceFlow_9</incoming>
     </endEvent>

   </process>

</definitions>