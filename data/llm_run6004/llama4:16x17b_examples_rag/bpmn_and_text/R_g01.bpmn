<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/BPMN20.xsd" 
             id="definition" targetNamespace="http://www.example.com">

   <process id="DIY_Repair_Process" isExecutable="true">
     <startEvent id="Start_Event">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="Start_Event" targetRef="Task_1"/>

     <task id="Task_1" name="Enter smartphone model and what is broken">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="ExclusiveGateway"/>

     <exclusiveGateway id="ExclusiveGateway">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_4</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_3" name="Repair successful" sourceRef="ExclusiveGateway" targetRef="Task_5">
       <conditionExpression xsi:type="tFormalExpression">${repairSuccessful == true}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="SequenceFlow_4" name="Repair not successful" sourceRef="ExclusiveGateway" targetRef="Service_Task"/>

     <serviceTask id="Service_Task" name="Send to expert">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </serviceTask>

     <sequenceFlow id="SequenceFlow_5" sourceRef="Service_Task" targetRef="End_Event_2"/>

     <task id="Task_5" name="Send review and/or video">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_5" targetRef="End_Event_1"/>

     <endEvent id="End_Event_1">
       <incoming>SequenceFlow_6</incoming>
     </endEvent>

     <endEvent id="End_Event_2">
       <incoming>SequenceFlow_5</incoming>
     </endEvent>

   </process>
 </definitions>