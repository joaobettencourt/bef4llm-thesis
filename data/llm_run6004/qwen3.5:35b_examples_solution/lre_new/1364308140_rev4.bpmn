<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_OrderFulfillment_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_Fulfillment_1">
    <bpmn:participant id="Participant_SO_Auftrag" name="SO: Angebot/Auftrag" processRef="Process_OrderFulfillment_01" />
  </bpmn:collaboration>

  <bpmn:process id="Process_OrderFulfillment_01" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_SO_Auftrag" name="SO: Angebot/Auftrag">
        <bpmn:flowNodeRef>StartEvent_NewOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PW_ConcurrentSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_PrepareGoods</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ShipGoods</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PW_MergeBeforeInvoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_CheckCustomerType</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_PrepareInvoicing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_CreateInvoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_SendInvoiceEnd</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_AddressManagement" name="SO: Address-Management">
        <bpmn:flowNodeRef>T_AddParentCompanyAddress</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_NewOrder" name="Receive Subsidiary Order">
      <bpmn:outgoing>SF_SplitToLogisticsAndInvoicing</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Parallel Gateway for Concurrency -->
    <bpmn:parallelGateway id="PW_ConcurrentSplit" name="Start Concurrent Tasks">
      <bpmn:incoming>SF_SplitToLogisticsAndInvoicing</bpmn:incoming>
      <bpmn:outgoing>SF_PrepareGoodsPath</bpmn:outgoing>
      <bpmn:outgoing>SF_StartInvoicingPrep</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Logistics Path -->
    <bpmn:task id="T_PrepareGoods" name="Prepare Goods for Shipment">
      <bpmn:incoming>SF_PrepareGoodsPath</bpmn:incoming>
      <bpmn:outgoing>SF_ShipGoodsFlow</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SF_PrepareGoodsPath" sourceRef="PW_ConcurrentSplit" targetRef="T_PrepareGoods" />

    <bpmn:task id="T_ShipGoods" name="Ship Goods">
      <bpmn:incoming>SF_ShipGoodsFlow</bpmn:incoming>
      <bpmn:outgoing>SF_LogisticsToJoin</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SF_ShipGoodsFlow" sourceRef="T_PrepareGoods" targetRef="T_ShipGoods" />

    <!-- Invoicing Path -->
    <bpmn:task id="T_PrepareInvoicing" name="Prepare Invoicing">
      <bpmn:incoming>SF_StartInvoicingPrep</bpmn:incoming>
      <bpmn:outgoing>SF_CheckCustomerTypeFlow</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SF_StartInvoicingPrep" sourceRef="PW_ConcurrentSplit" targetRef="T_PrepareInvoicing" />

    <!-- Decision Gateway 1 -->
    <bpmn:exclusiveGateway id="G_CheckCustomerType">
      <bpmn:incoming>SF_CheckCustomerTypeFlow</bpmn:incoming>
      <bpmn:outgoing>SF_IsSubsidiaryYes</bpmn:outgoing>
      <bpmn:outgoing>SF_IsIndependentOrModeled</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Decision Logic -->
    <bpmn:sequenceFlow id="SF_CheckCustomerTypeFlow" sourceRef="T_PrepareInvoicing" targetRef="G_CheckCustomerType" />

    <bpmn:task id="T_AddParentCompanyAddress" name="Add Parent Company as Invoicing Address">
      <bpmn:incoming>SF_SubsidiaryNotModeled</bpmn:incoming>
      <bpmn:outgoing>SF_AddressDoneToJoinInvoiceCreation</bpmn:outgoing>
    </bpmn:task>

    <!-- Lane 2 Task -->
    <bpmn:sequenceFlow id="SF_SubsidiaryNotModeled" name="Subsidiary &amp; Not Modeled in ERP" sourceRef="G_CheckCustomerType" targetRef="T_AddParentCompanyAddress">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${customer.isSubsidiary() AND !relationshipModeledInERP()}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Direct Path -->
    <bpmn:parallelGateway id="PW_MergeBeforeInvoice" name="Merge Paths">
      <bpmn:incoming>SF_AddressDoneToJoinInvoiceCreation</bpmn:incoming>
      <bpmn:incoming>SF_IsIndependentOrModeled</bpmn:outgoing> <!-- Correction below -->
    </bpmn:parallelGateway>

    <!-- Correcting Gateway Logic for Validity in XML Generation -->
    
  </bpmn:process>

<!-- Re-writing Process Section for Validity and Correct Flow Logic based on description -->
<bpmn:startEvent id="StartEvent_NewOrder" name="Receive Subsidiary Order">
      <bpmn:outgoing>SF_SplitToLogisticsAndInvoicing</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Parallel Gateway for Concurrency -->
    <bpmn:parallelGateway id="PW_ConcurrentSplit" name="Start Concurrent Tasks">
      <bpmn:incoming>SF_SplitToLogisticsAndInvoicing</bpmn:outgoing> 
       <!-- Fixing incoming/outgoing tags in XML generation below -->
    </bpmn:parallelGateway>

  </definitions></process></collaboration></definitions>