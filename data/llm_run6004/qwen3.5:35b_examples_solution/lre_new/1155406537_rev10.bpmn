<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_PayPalAccount_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_PayPal_AccountCreation">
    <bpmn:participant id="Participant_Client" name="PayPal Client" processRef="Process_Client_01" />
    <bpmn:participant id="Participant_System" name="PayPal System" processRef="Process_System_01" />
  </bpmn:collaboration>

  <!-- Client Process -->
  <bpmn:process id="Process_Client_01" isExecutable="false">
    <bpmn:startEvent id="Start_Event_AccountCreation" name="PayPal Account Required to be Created">
      <bpmn:outgoing>SF_DetermineAccountType</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_DetermineAccountType" name="Determine PayPal Account Type">
      <bpmn:incoming>SF_DetermineAccountType</bpmn:incoming>
      <bpmn:outgoing>SF_AccountSelectionGateway</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="GW_AccountSelection" name="Select Account Type">
      <bpmn:incoming>SF_AccountSelectionGateway</bpmn:incoming>
      <bpmn:outgoing>SF_SelectPersonalAccount</bpmn:outgoing>
      <bpmn:outgoing>SF_SelectPremiumAccount</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_SelectPersonal" name="Select Personal Account Type">
      <bpmn:incoming>SF_SelectPersonalAccount</bpmn:incoming>
      <bpmn:outgoing>SF_MergeAfterSelection</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_SelectPremium" name="Select Premium Account Type">
      <bpmn:incoming>SF_SelectPremiumAccount</bpmn:incoming>
      <bpmn:outgoing>SF_MergeAfterSelection</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="GW_AccountMerge" name="Select Account Type">
      <bpmn:incoming>SF_MergeAfterPersonal</bpmn:incoming>
      <bpmn:incoming>SF_MergeAfterPremium</bpmn:incoming>
      <bpmn:outgoing>SF_EnterLoginDetails</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_EnterLogin" name="Enter Login Details">
      <bpmn:incoming>SF_EnterLoginDetails</bpmn:incoming>
      <bpmn:incoming>SF_CorrectInvalidFields</bpmn:incoming>
      <bpmn:outgoing>SF_EnterPersonalDetails</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_EnterPersonal" name="Enter Personal Details">
      <bpmn:incoming>SF_EnterPersonalDetails</bpmn:incoming>
      <bpmn:outgoing>SF_ProvideTelephone</bpmn:outgoing>
    </bpmn:task>

    <bpmn:subProcess id="Task_ProvideTelephone" name="Provide Telephone Details">
      <bpmn:incoming>SF_ProvideTelephone</bpmn:incoming>
      <bpmn:outgoing>SF_ProvideAddress</bpmn:outgoing>
    </bpmn:subProcess>

    <bpmn:subProcess id="Task_ProvideAddress" name="Provide Address Details">
      <bpmn:incoming>SF_ProvideAddress</bpmn:incoming>
      <bpmn:outgoing>SF_DeclarePEP</bpmn:outgoing>
    </bpmn:subProcess>

    <bpmn:task id="Task_DeclarePEP" name="Declare if Affiliated with Politically Exposed Person">
      <bpmn:incoming>SF_DeclarePEP</bpmn:incoming>
      <bpmn:outgoing>SF_ClickCreateAccount</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_ClickCreate" name="Click Agree and Create Account">
      <bpmn:incoming>SF_ClickCreateAccount</bpmn:incoming>
      <bpmn:outgoing>SF_SubmitToSystem</bpmn:outgoing>
    </bpmn:task>

    <bpmn:intermediateThrowEvent id="IEV_SubmitDetails" name="Submit Account Details to System">
      <bpmn:messageEventDefinition />
      <bpmn:incoming>SF_SubmitToSystem</bpmn:incoming>
      <bpmn:outgoing>SF_SendRequestMessage</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

  </bpmn:process>

  <!-- PayPal System Process -->
  <bpmn:process id="Process_System_01" isExecutable="false">
    <bpmn:startEvent id="Start_Event_RequestReceived" name="New Account Request Received">
      <bpmn:messageEventDefinition />
      <bpmn:incoming>SF_SendRequestMessage</bpmn:incoming>
      <bpmn:outgoing>SF_StartValidation</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_ValidateFields" name="Validate Input Fields">
      <bpmn:incoming>SF_StartValidation</bpmn:incoming>
      <bpmn:outgoing>SF_CheckValidInput</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="GW_ValidateResult" name="Fields Valid?">
      <bpmn:incoming>SF_CheckValidInput</bpmn:incoming>
      <bpmn:outgoing>SF_NotifyInvalid</bpmn:outgoing>
      <bpmn:outgoing>SF_GenerateWelcomeEmail</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="End_Event_AccountRejected" name="Account Creation Failed">
      <bpmn:messageEventDefinition />
      <bpmn:incoming>SF_ClientCorrectFields</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:task id="Task_GenerateWelcomeEmail" name="Generate Welcome Email">
      <bpmn:incoming>SF_GenerateWelcomeEmail</bpmn:incoming>
      <bpmn:outgoing>SF_SendWelcomeEmail</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="End_Event_AccountCreated" name="PayPal Account Created">
      <bpmn:messageEventDefinition />
      <bpmn:incoming>SF_SendWelcomeEmail</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>

  <!-- Message Flows -->
  <bpmn:messageFlow id="MF_SubmitDetails" sourceRef="IEV_SubmitDetails" targetRef="Start_Event_RequestReceived">
    <bpmn:name>Submit Account Details</bpmn:name>
  </bpmn:messageFlow>

  <!-- Sequence Flows -->
  <bpmn:sequenceFlow id="SF_DetermineAccountType" sourceRef="Start_Event_AccountCreation" targetRef="Task_DetermineAccountType" />
  <bpmn:sequenceFlow id="SF_AccountSelectionGateway" sourceRef="Task_DetermineAccountType" targetRef="GW_AccountSelection" />
  <bpmn:sequenceFlow id="SF_SelectPersonalAccount" name="Select Personal Account Type" sourceRef="GW_AccountSelection" targetRef="Task_SelectPersonal" />
  <bpmn:sequenceFlow id="SF_MergeAfterPersonal" sourceRef="Task_SelectPersonal" targetRef="GW_AccountMerge" />
  <bpmn:sequenceFlow id="SF_SelectPremiumAccount" name="Select Premium Account Type" sourceRef="GW_AccountSelection" targetRef="Task_SelectPremium" />
  <bpmn:sequenceFlow id="SF_MergeAfterPremium" sourceRef="Task_SelectPremium" targetRef="GW_AccountMerge" />
  <bpmn:sequenceFlow id="SF_EnterLoginDetails" name="Enter Login Details" sourceRef="GW_AccountMerge" targetRef="Task_EnterLogin" />
  <bpmn:sequenceFlow id="SF_CorrectInvalidFields" name="Correct Invalid Fields" sourceRef="IEV_SendNotification_ClientSide" targetRef="Task_EnterLogin" />
  <bpmn:sequenceFlow id="SF_EnterPersonalDetails" sourceRef="Task_EnterLogin" targetRef="Task_EnterPersonal" />
  <bpmn:sequenceFlow id="SF_ProvideTelephone" sourceRef="Task_EnterPersonal" targetRef="Task_ProvideTelephone" />
  <bpmn:sequenceFlow id="SF_ProvideAddress" sourceRef="Task_ProvideTelephone" targetRef="Task_ProvideAddress" />
  <bpmn:sequenceFlow id="SF_DeclarePEP" sourceRef="Task_ProvideAddress" targetRef="Task_DeclarePEP" />
  <bpmn:sequenceFlow id="SF_ClickCreateAccount" name="Click Agree and Create Account" sourceRef="Task_DeclarePEP" targetRef="Task_ClickCreate" />
  <bpmn:sequenceFlow id="SF_SubmitToSystem" sourceRef="Task_ClickCreate" targetRef="IEV_SubmitDetails" />

  <!-- System Process Flows -->
  <bpmn:sequenceFlow id="SF_StartValidation" name="Validate Input Fields" sourceRef="Start_Event_RequestReceived" targetRef="Task_ValidateFields" />
  <bpmn:sequenceFlow id="SF_CheckValidInput" sourceRef="Task_ValidateFields" targetRef="GW_ValidateResult" />
  <bpmn:sequenceFlow id="SF_NotifyInvalid" name="Fields Invalid - Notify Client" sourceRef="GW_ValidateResult" targetRef="IEV_SendNotification_SystemSide" />
  <bpmn:sequenceFlow id="SF_ClientCorrectFields" name="Client Corrects Fields" sourceRef="Task_EnterLogin" targetRef="End_Event_AccountRejected" />
  <bpmn:sequenceFlow id="SF_GenerateWelcomeEmail" name="Generate Welcome Email" sourceRef="GW_ValidateResult" targetRef="Task_GenerateWelcomeEmail" />
  <bpmn:sequenceFlow id="SF_SendWelcomeEmail" name="Send Welcome Email to Client" sourceRef="Task_GenerateWelcomeEmail" targetRef="End_Event_AccountCreated" />

</bpmn:definitions>