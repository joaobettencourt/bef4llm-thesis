<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_BankAccountAddition_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_BankAccountVerification">
    <bpmn:participant id="Participant_PayPalSystem" name="PayPal System" processRef="Process_BankAddition_01" />
    <bpmn:participant id="Participant_ClientBank" name="Client Bank Account" />
  </bpmn:collaboration>

  <bpmn:process id="Process_BankAddition_01" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_PayPalSystem" name="PayPal System">
        <bpmn:flowNodeRef>IntermediateThrowEvent_SubmitDetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MakeDeposits</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MessageThrowEvent_DepositInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CatchEvent_3to5Days</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CompareValues</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_CheckMatch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Confirmed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RemoveAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Unconfirmed</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_PayPalClient" name="PayPal Client">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterBankDetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ClickContinue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CatchEvent_NotifyClient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckDeposits</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LoginPayPal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterDepositAmounts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ClickVerify</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_ClientBank" name="Client Bank Account">
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event - Client selects payment option -->
    <bpmn:startEvent id="StartEvent_1" name="Pay with bank account Payment option selected">
      <bpmn:outgoing>SF_EnterBankDetails</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task - Enter Bank Details -->
    <bpmn:task id="Task_EnterBankDetails" name="Enter Bank Details (First Name, Bank Name, Account Type, BSB, Account Number)">
      <bpmn:incoming>SF_EnterBankDetails</bpmn:incoming>
      <bpmn:outgoing>SF_ClickContinue</bpmn:outgoing>
    </bpmn:task>

    <!-- Task - Click Continue -->
    <bpmn:task id="Task_ClickContinue" name="Click 'continue'">
      <bpmn:incoming>SF_ClickContinue</bpmn:incoming>
      <bpmn:outgoing>SF_SubmitDetailsToSystem</bpmn:outgoing>
    </bpmn:task>

    <!-- Message Throw Event - Submit to PayPal System -->
    <bpmn:messageIntermediateThrowEvent id="IntermediateThrowEvent_SubmitDetails" name="Submit Bank Details">
      <bpmn:incoming>SF_SubmitDetailsToSystem</bpmn:incoming>
      <bpmn:outgoing>SF_SystemReceivesSubmission</bpmn:outgoing>
    </bpmn:messageIntermediateThrowEvent>

    <!-- Message Catch Event - System receives submission -->
    <bpmn:messageIntermediateCatchEvent id="IntermediateCatchEvent_SubmissionReceived" name="Bank Details Submitted">
      <bpmn:incoming>SF_SystemReceivesSubmission</bpmn:incoming>
      <bpmn:outgoing>SF_MakeDeposits</bpmn:outgoing>
    </bpmn:messageIntermediateCatchEvent>

    <!-- Task - Make Deposits -->
    <bpmn:task id="Task_MakeDeposits" name="Make two random deposits in Bank Account">
      <bpmn:incoming>SF_MakeDeposits</bpmn:incoming>
      <bpmn:outgoing>SF_DepositInfoMessage</bpmn:outgoing>
    </bpmn:task>

    <!-- Message Throw Event - Deposit Information -->
    <bpmn:messageIntermediateThrowEvent id="MessageThrowEvent_DepositInfo" name="Deposit Amounts">
      <bpmn:incoming>SF_DepositInfoMessage</bpmn:incoming>
      <bpmn:outgoing>SF_ClientReceivesNotification</bpmn:outgoing>
    </bpmn:messageIntermediateThrowEvent>

    <!-- Timer Catch Event - Wait 3-5 working days -->
    <bpmn:timerIntermediateCatchEvent id="CatchEvent_3to5Days" name="After 3-5 working days">
      <bpmn:incoming>SF_ClientReceivesNotification</bpmn:incoming>
      <bpmn:outgoing>SF_CheckDepositsReceived</bpmn:outgoing>
    </bpmn:timerIntermediateCatchEvent>

    <!-- Task - Check Deposits -->
    <bpmn:task id="Task_CheckDeposits" name="Check deposits received in Bank Account">
      <bpmn:incoming>SF_ClientReceivesNotification</bpmn:incoming>
      <bpmn:outgoing>SF_LoginPayPalAccount</bpmn:outgoing>
    </bpmn:task>

    <!-- Task - Login to PayPal -->
    <bpmn:task id="Task_LoginPaypal" name="Login to PayPal account">
      <bpmn:incoming>SF_ClientReceivesNotification</bpmn:incoming>
      <bpmn:outgoing>SF_EnterDepositAmountsFlow</bpmn:outgoing>
    </bpmn:task>

    <!-- Task - Enter Deposit Amounts -->
    <bpmn:task id="Task_EnterDepositAmounts" name="Enter amounts from two deposits">
      <bpmn:incoming>SF_ClientReceivesNotification</bpmn:incoming>
      <bpmn:outgoing>SF_ClickVerifyFlow</bpmn:outgoing>
    </bpmn:task>

    <!-- Task - Click Verify -->
    <bpmn:task id="Task_ClickVerify" name="Click 'verify'">
      <bpmn:incoming>SF_ClientReceivesNotification</bpmn:incoming>
      <bpmn:outgoing>SF_CompareValuesFlow</bpmn:outgoing>
    </bpmn:task>

    <!-- Task - Compare Values -->
    <bpmn:task id="Task_CompareValues" name="Compare values provided">
      <bpmn:incoming>SF_ClientReceivesNotification</bpmn:incoming>
      <bpmn:outgoing>SF_CheckMatchGatewayFlow</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway - Check if values match -->
    <bpmn:exclusiveGateway id="GW_CheckMatch" name="Values Match?">
      <bpmn:incoming>SF_ClientReceivesNotification</bpmn:incoming>
      <bpmn:outgoing>SF_LinkAccountFlow</bpmn:outgoing>
      <bpmn:outgoing>SF_RemoveAccountFlow</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task - Link Account -->
    <bpmn:task id="Task_LinkAccount" name="Link Bank Details to PayPal Account">
      <bpmn:incoming>SF_ClientReceivesNotification</bpmn:incoming>
      <bpmn:outgoing>SF_ConfirmedEndFlow</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event - Confirmed -->
    <bpmn:endEvent id="EndEvent_Confirmed" name="Bank account confirmed">
      <bpmn:incoming>SF_ClientReceivesNotification</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task - Remove Account -->
    <bpmn:task id="Task_RemoveAccount" name="Remove bank account details from PayPal System">
      <bpmn:incoming>SF_ClientReceivesNotification</bpmn:incoming>
      <bpmn:outgoing>SF_UnconfirmedEndFlow</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event - Unconfirmed -->
    <bpmn:endEvent id="EndEvent_Unconfirmed" name="Bank account unconfirmed">
      <bpmn:incoming>SF_ClientReceivesNotification</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SF_EnterBankDetails" sourceRef="StartEvent_1" targetRef="Task_EnterBankDetails" />
    <bpmn:sequenceFlow id="SF_ClickContinue" sourceRef="Task_EnterBankDetails" targetRef="Task_ClickContinue" />
    <bpmn:sequenceFlow id="SF_SubmitDetailsToSystem" name="Submit Bank Details to PayPal System" sourceRef="Task_ClickContinue" targetRef="IntermediateThrowEvent_SubmitDetails" />
    <bpmn:sequenceFlow id="SF_SystemReceivesSubmission" sourceRef="IntermediateThrowEvent_SubmitDetails" targetRef="IntermediateCatchEvent_SubmissionReceived" />
    <bpmn:sequenceFlow id="SF_MakeDeposits" name="Make two random deposits in Bank Account" sourceRef="IntermediateCatchEvent_SubmissionReceived" targetRef="Task_MakeDeposits" />
    <bpmn:sequenceFlow id="SF_DepositInfoMessage" name="Send Deposit Information to Client" sourceRef="Task_MakeDeposits" targetRef="MessageThrowEvent_DepositInfo" />
    <bpmn:sequenceFlow id="SF_ClientReceivesNotification" name="Notify Client after 3-5 working days" sourceRef="MessageThrowEvent_DepositInfo" targetRef="CatchEvent_3to5Days" />
    <bpmn:sequenceFlow id="SF_CheckDepositsReceived" sourceRef="CatchEvent_3to5Days" targetRef="Task_CheckDeposits" name="Check deposits received in Bank Account" />
    <bpmn:sequenceFlow id="SF_LoginPayPalAccount" sourceRef="Task_CheckDeposits" targetRef="Task_LoginPaypal" name="Login to PayPal account" />
    <bpmn:sequenceFlow id="SF_EnterDepositAmountsFlow" sourceRef="Task_LoginPaypal" targetRef="Task_EnterDepositAmounts" name="Enter amounts from two deposits" />
    <bpmn:sequenceFlow id="SF_ClickVerifyFlow" sourceRef="Task_EnterDepositAmounts" targetRef="Task_ClickVerify" name="Click verify" />
    <bpmn:sequenceFlow id="SF_CompareValuesFlow" sourceRef="Task_ClickVerify" targetRef="Task_CompareValues" name="Compare values provided to PayPal System" />
    <bpmn:sequenceFlow id="SF_CheckMatchGatewayFlow" sourceRef="Task_CompareValues" targetRef="GW_CheckMatch" name="Check if values match" />
    <bpmn:sequenceFlow id="SF_LinkAccountFlow" name="Values Match - Yes" sourceRef="GW_CheckMatch" targetRef="Task_LinkAccount" />
    <bpmn:sequenceFlow id="SF_ConfirmedEndFlow" sourceRef="Task_LinkAccount" targetRef="EndEvent_Confirmed" name="Bank account confirmed" />
    <bpmn:sequenceFlow id="SF_RemoveAccountFlow" name="Values Match - No" sourceRef="GW_CheckMatch" targetRef="Task_RemoveAccount" />
    <bpmn:sequenceFlow id="SF_UnconfirmedEndFlow" sourceRef="Task_RemoveAccount" targetRef="EndEvent_Unconfirmed" name="Bank account unconfirmed" />

  </bpmn:process>
</bpmn:definitions>