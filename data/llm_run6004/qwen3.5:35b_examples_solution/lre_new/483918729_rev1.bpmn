<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_PartProvision_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_PartProvision_1">
    <bpmn:participant id="Participant_ProvisionTeam" name="Provision Team" processRef="Process_PartProvision_01" />
    <bpmn:participant id="Participant_Customer" name="Customer" />
    <bpmn:participant id="Participant_Daisuki" name="Daisuki" />

    <!-- Message Flows -->
    <bpmn:messageFlow id="MessageFlow_RequestReceived" sourceRef="Participant_Customer" targetRef="StartEvent_ProvisionRequest" />
    <bpmn:messageFlow id="MessageFlow_QuestionToCustomer" sourceRef="Task_AskForInfo" targetRef="Participant_Customer" />
    <bpmn:messageFlow id="MessageFlow_InfoFromCustomer" sourceRef="Participant_Customer" targetRef="Task_CheckAvailability" />
    <bpmn:messageFlow id="MessageFlow_SupplyParts" sourceRef="Task_SupplyToCustomer" targetRef="Participant_Customer" />
    <bpmn:messageFlow id="MessageFlow_OrderDaisuki" sourceRef="SubProcess_OrderFromDaisuki" targetRef="Participant_Daisuki" />
    <bpmn:messageFlow id="MessageFlow_ContractCustomer" sourceRef="Task_ContactCustomer" targetRef="Participant_Customer" />
    <bpmn:messageFlow id="MessageFlow_PaymentReceived" sourceRef="Participant_Customer" targetRef="Task_FinalPayment" />
  </bpmn:collaboration>

  <bpmn:process id="Process_PartProvision_01" isExecutable="false">

    <!-- Lane Set -->
    <bpmn:laneSet>
      <bpmn:lane id="Lane_ProvisionTeam" name="Provision Team">
        <bpmn:flowNodeRef>StartEvent_ProvisionRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IdentifyParts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_QuestionsExist</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AskForInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckAvailability</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_PartsAvailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SupplyToCustomer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecordPetition</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_OrderFromDaisuki</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ContactCustomer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_ItemsCollected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FinalPayment</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_ProvisionRequest" name="Provision Request Received">
      <bpmn:messageEventDefinition />
      <bpmn:outgoing>SF_IdentifyParts</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Identify Parts -->
    <bpmn:task id="Task_IdentifyParts" name="Identify Necessary Parts">
      <bpmn:incoming>SF_IdentifyParts</bpmn:incoming>
      <bpmn:outgoing>SF_QuestionsCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Questions Exist? -->
    <bpmn:exclusiveGateway id="GW_QuestionsExist" name="Questions About Request?">
      <bpmn:incoming>SF_QuestionsCheck</bpmn:incoming>
      <bpmn:outgoing>SF_AskForInfo</bpmn:outgoing>
      <bpmn:outgoing>SF_CheckAvailabilityFlow</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Ask for Information -->
    <bpmn:task id="Task_AskForInfo" name="Request More Information">
      <bpmn:incoming>SF_AskForInfo</bpmn:incoming>
      <bpmn:outgoing>SF_InfoReceivedBack</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Check Availability -->
    <bpmn:task id="Task_CheckAvailability" name="Check Parts Availability">
      <bpmn:incoming>SF_QuestionsNoFlow</bpmn:incoming>
      <bpmn:incoming>SF_InfoReceivedBack</bpmn:incoming>
      <bpmn:outgoing>SF_AvailabilityDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Parts Available? -->
    <bpmn:exclusiveGateway id="GW_PartsAvailable" name="All Parts Available?">
      <bpmn:incoming>SF_AvailabilityDecision</bpmn:incoming>
      <bpmn:outgoing>SF_SupplyPartsFlow</bpmn:outgoing>
      <bpmn:outgoing>SF_RecordPetitionFlow</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Supply to Customer -->
    <bpmn:task id="Task_SupplyToCustomer" name="Supply Parts to Customer">
      <bpmn:incoming>SF_SupplyPartsFlow</bpmn:incoming>
      <bpmn:outgoing>SF_GoToCollectionCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Record Petition -->
    <bpmn:task id="Task_RecordPetition" name="Record Customer Petition">
      <bpmn:incoming>SF_RecordPetitionFlow</bpmn:incoming>
      <bpmn:outgoing>SF_OrderFromDaisuki</bpmn:outgoing>
    </bpmn:task>

    <!-- SubProcess: Order from Daisuki -->
    <bpmn:subProcess id="SubProcess_OrderFromDaisuki" name="Order and Receive Parts">
      <bpmn:incoming>SF_OrderFromDaisuki</bpmn:incoming>
      <bpmn:outgoing>SF_ContractCustomerFlow</bpmn:outgoing>
    </bpmn:subProcess>

    <!-- Task: Contact Customer -->
    <bpmn:task id="Task_ContactCustomer" name="Notify When Parts Collected">
      <bpmn:incoming>SF_ContractCustomerFlow</bpmn:incoming>
      <bpmn:outgoing>SF_GoToCollectionCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Items Recollected? -->
    <bpmn:exclusiveGateway id="GW_ItemsCollected" name="Items Collected by Customer">
      <bpmn:incoming>SF_GoToCollectionCheck</bpmn:incoming>
      <bpmn:outgoing>SF_FinalPaymentFlow</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Final Payment -->
    <bpmn:task id="Task_FinalPayment" name="Receive Final Payment">
      <bpmn:incoming>SF_FinalPaymentFlow</bpmn:incoming>
      <bpmn:outgoing>SF_ProcessComplete</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_ProvisionComplete" name="Provision Complete">
      <bpmn:incoming>SF_ProcessComplete</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SF_IdentifyParts" sourceRef="StartEvent_ProvisionRequest" targetRef="Task_IdentifyParts">
      <bpmn:name>Identify Parts</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SF_QuestionsCheck" name="Yes - Questions Exist" sourceRef="Task_IdentifyParts" targetRef="GW_QuestionsExist">
      <bpmn:description>${questionsExist}</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SF_AskForInfo" name="Yes - Ask Info" sourceRef="GW_QuestionsExist" targetRef="Task_AskForInfo">
      <bpmn:description>${questionsExist}</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SF_InfoReceivedBack" name="Information Received" sourceRef="Task_AskForInfo" targetRef="Task_CheckAvailability">
      <bpmn:description>${infoReceived}</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SF_QuestionsNoFlow" name="No - No Questions" sourceRef="GW_QuestionsExist" targetRef="Task_CheckAvailability">
      <bpmn:description>${!questionsExist}</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SF_AvailabilityDecision" name="Parts Checked" sourceRef="Task_CheckAvailability" targetRef="GW_PartsAvailable">
      <bpmn:description>${partsChecked}</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SF_SupplyPartsFlow" name="Yes - Available" sourceRef="GW_PartsAvailable" targetRef="Task_SupplyToCustomer">
      <bpmn:description>${partsAvailable}</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SF_RecordPetitionFlow" name="No - Not Available" sourceRef="GW_PartsAvailable" targetRef="Task_RecordPetition">
      <bpmn:description>${!partsAvailable}</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SF_OrderFromDaisuki" name="Order Parts" sourceRef="Task_RecordPetition" targetRef="SubProcess_OrderFromDaisuki">
      <bpmn:description>${orderPlaced}</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SF_ContractCustomerFlow" name="Notify Customer" sourceRef="SubProcess_OrderFromDaisuki" targetRef="Task_ContactCustomer">
      <bpmn:description>${partsCollected}</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SF_GoToCollectionCheck" name="Items Supplied" sourceRef="Task_SupplyToCustomer" targetRef="GW_ItemsCollected">
      <bpmn:description>${itemsSupplied}</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SF_FinalPaymentFlow" name="Items Recollected" sourceRef="GW_ItemsCollected" targetRef="Task_FinalPayment">
      <bpmn:description>${itemsRecollected}</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SF_ProcessComplete" name="Process Complete" sourceRef="Task_FinalPayment" targetRef="EndEvent_ProvisionComplete">
      <bpmn:description>${paymentReceived}</bpmn:description>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>