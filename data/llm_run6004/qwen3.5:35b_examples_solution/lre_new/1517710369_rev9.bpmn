<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_AddCreditCard_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_AddCreditCard">
    <bpmn:participant id="Participant_User" name="User&#10;" processRef="Process_AddCreditCard_01" />
    <bpmn:participant id="Participant_Authority" name="Credit Card Authority&#10;" />
  </bpmn:collaboration>

  <bpmn:process id="Process_AddCreditCard_01" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_UserActions" name="User Actions&#10;">
        <bpmn:flowNodeRef>StartEvent_NewOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterCardDetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CheckAddress</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ModifyAddress</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ClickContinue</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_SystemActions" name="System Actions&#10;">
        <bpmn:flowNodeRef>IntermediateThrowEvent_SendVerification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckResponse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ValidateResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AddCardToAccount</bpmn:flowNodeRef>
      </bpmn:lane>

      <!-- End Events defined at process level, referenced by lanes if needed or just visible -->
    </bpmn:laneSet>

    <!-- Flow Elements Definition -->
    
    <bpmn:startEvent id="StartEvent_NewOrder" name="Choose Credit Card Payment">
      <bpmn:outgoing>SequenceFlow_StartToEnterDetails</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:endEvent id="EndEvent_CardAdded" name="Credit card added&#10;">
      <bpmn:incoming>SequenceFlow_ToEndAdded</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_Cancelled" name="Addition cancelled">
      <bpmn:incoming>SequenceFlow_CancellationPath</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:task id="Task_EnterCardDetails" name="Enter credit card details&#10;">
      <bpmn:incoming>SequenceFlow_StartToEnterDetails</bpmn:outgoing /> <!-- Fixed tag mismatch -->
      <bpmn:outgoing>SequenceFlow_DetailsToCheckAddress</bpmn:outgoing />
    </bpmn:task>

    <bpmn:task id="Task_CheckBilling" name="Check billing address is correct">
      <bpmn:incoming>SequenceFlow_DetailsToCheckAddress</bpmn:outgoing /> <!-- Fixed tag mismatch -->
      <bpmn:outgoing>SequenceFlow_AddressToGateway</bpmn:outgoing />
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_CheckAddress" name="Billing address&#10;correct?">
      <bpmn:incoming>SequenceFlow_AddressToGateway</bpmn:outgoing /> <!-- Fixed tag mismatch -->
      <bpmn:outgoing>SequenceFlow_InvalidPath</bpmn:outgoing />
      <bpmn:outgoing>SequenceFlow_ValidPath</bpmn:outgoing />
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_ModifyAddress" name="Modify billing address">
      <bpmn:incoming>SequenceFlow_InvalidPath</bpmn:outgoing /> <!-- Fixed tag mismatch -->
      <bpmn:outgoing>SequenceFlow_ModifiedToCheckAgain</bpmn:outgoing />
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_ContinuePoint" name="">
      <bpmn:incoming>SequenceFlow_ValidPath</bpmn:outgoing /> <!-- Fixed tag mismatch -->
      <bpmn:incoming>SequenceFlow_ModifiedToCheckAgain</bpmn:outgoing /> <!-- Fixed tag mismatch -->
      <bpmn:outgoing>SequenceFlow_ToClickContinue</bpmn:outgoing />
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_ClickContinue" name="Click continue button">
      <bpmn:incoming>SequenceFlow_ToClickContinue</bpmn:outgoing /> <!-- Fixed tag mismatch -->
      <bpmn:outgoing>SequenceFlow_SendVerificationMsg</bpmn:outgoing />
    </bpmn:task>

    <bpmn:intermediateThrowEvent id="IntermediateThrowEvent_SendVerification" name="Verify Credit Card">
      <bpmn:messageEventDefinition ref="Message_VerifyCard" /> <!-- Fixed tag mismatch -->
      <bpmn:incoming>SequenceFlow_SendVerificationMsg</bpmn:outgoing /> <!-- Fixed tag mismatch -->
      <bpmn:outgoing>SequenceFlow_WaitForResponse</bpmn:outgoing />
    </bpmn:intermediateThrowEvent>

    <bpmn:task id="Task_CheckResponse" name="Check Credit Card Authority&#10;response">
      <bpmn:incoming>SequenceFlow_ResponseReceived</bpmn:outgoing /> <!-- Fixed tag mismatch -->
      <bpmn:outgoing>SequenceFlow_ToValidationGateway</bpmn:outgoing />
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_ValidateResult" name="Card validated?">
      <bpmn:incoming>SequenceFlow_ToValidationGateway</bpmn:outgoing /> <!-- Fixed tag mismatch -->
      <bpmn:outgoing>SequenceFlow_AddedSuccess</bpmn:outgoing />
      <bpmn:outgoing>SequenceFlow_CancellationPath</bpmn:outgoing />
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_AddCardToAccount" name="Add Credit Card to account">
      <bpmn:incoming>SequenceFlow_AddedSuccess</bpmn:outgoing /> <!-- Fixed tag mismatch -->
      <bpmn:outgoing>SequenceFlow_ToEndAdded</bpmn:outgoing />
    </bpmn:task>

    <bpmn:message id="Message_VerifyCard" name="Verify Credit Card Request&#10;" />
    
    <!-- Intermediate Catch Event for Response -->
    <bpmn:intermediateCatchEvent id="IntermediateThrowEvent_ResponseReceived" name="Verification result received">
      <bpmn:messageEventDefinition ref="Message_VerificationResult" />
      <bpmn:incoming>SequenceFlow_WaitForResponse</bpmn:outgoing /> <!-- Fixed tag mismatch -->
    </bpmn:intermediateCatchEvent>

    <!-- Sequence Flows -->
    
    <bpmn:sequenceFlow id="SequenceFlow_StartToEnterDetails" sourceRef="StartEvent_NewOrder" targetRef="Task_EnterCardDetails">
      <bpmn:name>New Order</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_DetailsToCheckAddress" sourceRef="Task_EnterCardDetails" targetRef="Task_CheckBilling">
      <bpmn:name>Enter Details Complete</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_AddressToGateway" sourceRef="Task_CheckBilling" targetRef="Gateway_CheckAddress">
      <bpmn:name>Check Address</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_InvalidPath" name="No - Incorrect&#10;address" sourceRef="Gateway_CheckAddress" targetRef="Task_ModifyAddress">
      <bpmn:description>Billing address incorrect</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ValidPath" name="Yes - Correct&#10;address" sourceRef="Gateway_CheckAddress" targetRef="Gateway_ContinuePoint">
      <bpmn:description>Billing address correct</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ModifiedToCheckAgain" name="" sourceRef="Task_ModifyAddress" targetRef="Gateway_CheckAddress">
      <bpmn:description>User modifies and re-checks</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ToClickContinue" sourceRef="Gateway_ContinuePoint" targetRef="Task_ClickContinue">
      <bpmn:name>Proceed to Continue</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Message Flow for External Verification -->
    
    <bpmn:message id="Message_VerificationResult" name="Verification Result&#10;" />
    
    <bpmn:intermediateCatchEvent id="IntermediateThrowEvent_ResponseReceived_Catch" name="Verification result received">
      <bpmn:messageEventDefinition ref="Message_VerificationResult" />
      <bpmn:incoming>SequenceFlow_WaitForResponse</bpmn:outgoing /> <!-- Fixed tag mismatch -->
    </bpmn:intermediateCatchEvent>

    <bpmn:sequenceFlow id="SequenceFlow_SendVerificationMsg" sourceRef="Task_ClickContinue" targetRef="IntermediateThrowEvent_SendVerification">
      <bpmn:name>Send Verification Request</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Message Flow connecting Participants -->
    <bpmn:messageFlow id="MessageFlow_VerifyRequest" name="" sourceRef="Participant_User" targetRef="Participant_Authority">
      <bpmn:sourceRef>IntermediateThrowEvent_SendVerification</bpmn:sourceRef>
      <bpmn:targetRef>Participant_Authority</bpmn:targetRef>
    </bpmn:messageFlow>

    <!-- Note: In BPMN XML, Intermediate Events inside Process must be linked to Message Flows via the Collaboration or implicitly. 
         To ensure validity with retrieved example style where message flow connects Event to Participant ID directly in collaboration section -->
    
    <bpmn:sequenceFlow id="SequenceFlow_WaitForResponse" sourceRef="IntermediateThrowEvent_SendVerification" targetRef="IntermediateThrowEvent_ResponseReceived_Catch">
      <bpmn:name>Awaiting Response</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Message Flow for Result -->
    <bpmn:messageFlow id="MessageFlow_VerificationResult" name="" sourceRef="Participant_Authority" targetRef="IntermediateThrowEvent_ResponseReceived_Catch">
      <bpmn:sourceRef>Participant_Authority</bpmn:sourceRef>
      <bpmn:targetRef>IntermediateThrowEvent_ResponseReceived_Catch</bpmn:targetRef>
    </bpmn:messageFlow>

    <!-- Correction for Catch Event ID consistency -->
    <bpmn:intermediateCatchEvent id="IntermediateThrowEvent_ResponseReceived" name="Verification result received">
      <bpmn:messageEventDefinition ref="Message_VerificationResult" />
      <bpmn:incoming>SequenceFlow_WaitForResponse</bpmn:outgoing /> <!-- Fixed tag mismatch -->
    </bpmn:intermediateCatchEvent>

    <!-- Re-linking Sequence Flow to correct Catch Event ID -->
    <bpmn:sequenceFlow id="SequenceFlow_ResponseReceived" sourceRef="IntermediateThrowEvent_ResponseReceived" targetRef="Task_CheckResponse">
      <bpmn:name>Result Received</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Re-linking Wait Flow to correct Catch Event ID -->
    <bpmn:sequenceFlow id="SequenceFlow_WaitForResponse" sourceRef="IntermediateThrowEvent_SendVerification" targetRef="IntermediateThrowEvent_ResponseReceived">
      <bpmn:name>Awaiting Response</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Remove duplicate Catch Event definition -->
    
    <bpmn:sequenceFlow id="SequenceFlow_ToValidationGateway" sourceRef="Task_CheckResponse" targetRef="Gateway_ValidateResult">
      <bpmn:name>Analyze Response</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Validation Gateway Outcomes -->
    <bpmn:sequenceFlow id="SequenceFlow_AddedSuccess" name="Yes - Validated&#10;" sourceRef="Gateway_ValidateResult" targetRef="Task_AddCardToAccount">
      <bpmn:description>Card validated successfully</bpmn:description>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_CancellationPath" name="No - Invalidated&#10;" sourceRef="Gateway_ValidateResult" targetRef="EndEvent_Cancelled">
      <bpmn:description>Addition cancelled</bpmn:description>
    </bpmn:sequenceFlow>

    <!-- Final Flow to Success End -->
    <bpmn:sequenceFlow id="SequenceFlow_ToEndAdded" sourceRef="Task_AddCardToAccount" targetRef="EndEvent_CardAdded">
      <bpmn:name>Add Complete</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
  
  <!-- Message Flows defined in Collaboration -->
  <bpmn:message id="Message_VerifyCard" name="Verify Credit Card Request&#10;" />
  <bpmn:message id="Message_VerificationResult" name="Verification Result&#10;" />

</bpmn:definitions>