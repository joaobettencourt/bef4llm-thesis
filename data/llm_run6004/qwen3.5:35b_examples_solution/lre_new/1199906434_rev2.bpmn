<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_DataValidation_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_DataValidation_1">
    <bpmn:participant id="Participant_TechSupport" name="Technical Support Process" processRef="Process_DataValidation_01" />
  </bpmn:collaboration>

  <bpmn:process id="Process_DataValidation_01" isExecutable="false">
    <!-- Flow Elements -->
    
    <!-- Start Event -->
    <bpmn:startEvent id="Start_Event_Notified" name="IS notified about data validation error">
      <bpmn:outgoing>SF_CheckTypos</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Check for typos -->
    <bpmn:task id="Task_CheckTypos" name="Check for own typing errors">
      <bpmn:incoming>SF_CheckTypos</bpmn:incoming>
      <bpmn:outgoing>SF_Gateway_TypoDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Typo decision -->
    <bpmn:exclusiveGateway id="GW_TypoCheck" name="Typo found?">
      <bpmn:incoming>SF_Gateway_TypoDecision</bpmn:incoming>
      <bpmn:outgoing>SF_CustomerCorrectionPath</bpmn:outgoing> <!-- Yes - typo -->
      <bpmn:outgoing>SF_PublicSourcesCheck</bpmn:outgoing>  <!-- No - not a typo -->
    </bpmn:exclusiveGateway>

    <!-- Task 2: Check if customer can correct mistake -->
    <bpmn:task id="Task_CustomerCorrection" name="Check if customer is able to provide fixed data">
      <bpmn:incoming>SF_CustomerCorrectionPath</bpmn:incoming>
      <bpmn:outgoing>SF_Gateway_CorrectionDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2: Customer correction decision -->
    <bpmn:exclusiveGateway id="GW_CustomerCorrection" name="Customer can fix?">
      <bpmn:incoming>SF_Gateway_CorrectionDecision</bpmn:incoming>
      <bpmn:outgoing>SF_ResolvedPath1</bpmn:outgoing> <!-- Yes -->
      <bpmn:outgoing>SF_PublicSourcesTask</bpmn:outgoing>  <!-- No - check public sources -->
    </bpmn:exclusiveGateway>

    <!-- Task 3: Check public sources for solutions -->
    <bpmn:task id="Task_PublicSources" name="Check data fixes from public sources">
      <bpmn:incoming>SF_PublicSourcesPath</bpmn:incoming>
      <bpmn:outgoing>SF_Gateway_SolutionFound</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 3: Solution found decision -->
    <bpmn:exclusiveGateway id="GW_SolutionFound" name="Solution found?">
      <bpmn:incoming>SF_Gateway_SolutionFound</bpmn:incoming>
      <bpmn:outgoing>SF_ResolvedPath2</bpmn:outgoing> <!-- Yes -->
      <bpmn:outgoing>SF_UnresolvedEnd</bpmn:outgoing>  <!-- No - issue unresolvable -->
    </bpmn:exclusiveGateway>

    <!-- End Event 1: Issue resolved (from typo check) -->
    <bpmn:endEvent id="End_Event_Resolved" name="Issue was resolved">
      <bpmn:incoming>SF_TypoFound</bpmn:incoming>
      <bpmn:incoming>SF_CustomerFixedIt</bpmn:incoming>
      <bpmn:incoming>SF_PublicSourceSolution</bpmn:incoming>
    </bpmn:endEvent>

    <!-- End Event 2: Issue unresolvable -->
    <bpmn:endEvent id="End_Event_Unresolved" name="Issue was un-resolvable">
      <bpmn:incoming>SF_NoSolutionFound</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    
    <!-- From Start to Task 1 -->
    <bpmn:sequenceFlow id="SF_CheckTypos" sourceRef="Start_Event_Notified" targetRef="Task_CheckTypos" />

    <!-- From Task 1 to Gateway 1 -->
    <bpmn:sequenceFlow id="SF_Gateway_TypoDecision" sourceRef="Task_CheckTypos" targetRef="GW_TypoCheck" />

    <!-- Typo found path (resolved) -->
    <bpmn:sequenceFlow id="SF_TypoFound" name="Yes - typo found" sourceRef="GW_TypoCheck" targetRef="End_Event_Resolved" />

    <!-- Not a typo, check customer correction -->
    <bpmn:sequenceFlow id="SF_CustomerCorrectionPath" name="No - not a typo" sourceRef="GW_TypoCheck" targetRef="Task_CustomerCorrection" />

    <!-- From Task 2 to Gateway 2 -->
    <bpmn:sequenceFlow id="SF_Gateway_CorrectionDecision" sourceRef="Task_CustomerCorrection" targetRef="GW_CustomerCorrection" />

    <!-- Customer can fix (resolved) -->
    <bpmn:sequenceFlow id="SF_CustomerFixedIt" name="Yes - customer fixed it" sourceRef="GW_CustomerCorrection" targetRef="End_Event_Resolved" />

    <!-- Check public sources path -->
    <bpmn:sequenceFlow id="SF_PublicSourcesPath" name="No - check public sources" sourceRef="GW_CustomerCorrection" targetRef="Task_PublicSources" />

    <!-- From Task 3 to Gateway 3 -->
    <bpmn:sequenceFlow id="SF_Gateway_SolutionFound" sourceRef="Task_PublicSources" targetRef="GW_SolutionFound" />

    <!-- Solution found (resolved) -->
    <bpmn:sequenceFlow id="SF_PublicSourceSolution" name="Yes - solution found" sourceRef="GW_SolutionFound" targetRef="End_Event_Resolved" />

    <!-- No solution found (unresolvable) -->
    <bpmn:sequenceFlow id="SF_NoSolutionFound" name="No - no solution" sourceRef="GW_SolutionFound" targetRef="End_Event_Unresolved" />

  </bpmn:process>
</bpmn:definitions>