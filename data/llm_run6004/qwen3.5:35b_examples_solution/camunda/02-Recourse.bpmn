<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
                 id="Definitions_RecourseProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_RecourseClerk">
    <bpmn:participant id="Participant_Clerk" name="Recourse Clerk" processRef="Proc_RecourseProcess"/>
  </bpmn:collaboration>

  <bpmn:process id="Proc_RecourseProcess" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="Start_ProbableRecourse" name="Probable Recourse Detected">
      <bpmn:messageEventDefinition/>
      <bpmn:outgoing>Seq_StartToCheckCase</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Check Case -->
    <bpmn:task id="Task_CheckCase" name="Check Case">
      <bpmn:incoming>Seq_StartToCheckCase</bpmn:incoming>
      <bpmn:outgoing>Seq_CaseDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Recourse Possible? -->
    <bpmn:exclusiveGateway id="Gw_RecoursePossible" name="Recourse possible?">
      <bpmn:incoming>Seq_CaseDecision</bpmn:incoming>
      <bpmn:outgoing>Seq_SendPaymentRequest</bpmn:outgoing>
      <bpmn:outgoing>Seq_CloseCaseNoRecourse</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Send Payment Request -->
    <bpmn:task id="Task_SendPaymentRequest" name="Send Request for Payment">
      <bpmn:incoming>Seq_SendPaymentRequest</bpmn:incoming>
      <bpmn:outgoing>Seq_SendReminder</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Send Reminder -->
    <bpmn:task id="Task_SendReminder" name="Make Reminder">
      <bpmn:incoming>Seq_SendReminder</bpmn:incoming>
      <bpmn:outgoing>Seq_EventBasedGatewayStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Event-Based Gateway -->
    <bpmn:eventBasedGateway id="Gw_WaitingEvents" name="Wait for Events">
      <bpmn:incoming>Seq_EventBasedGatewayStart</bpmn:incoming>
      <bpmn:outgoing>Seq_MoneyReceivedPath</bpmn:outgoing>
      <bpmn:outgoing>Seq_DisagreementLetterPath</bpmn:outgoing>
      <bpmn:outgoing>Seq_ReminderDuePath</bpmn:outgoing>
    </bpmn:eventBasedGateway>

    <!-- Task: Close Case (No Recourse) -->
    <bpmn:task id="Task_CloseCaseNoRecourse" name="Close Case">
      <bpmn:incoming>Seq_CloseCaseNoRecourse</bpmn:incoming>
      <bpmn:outgoing>Seq_EndClosed1</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 1 -->
    <bpmn:endEvent id="End_CaseClosed_NoRecourse" name="Case Closed">
      <bpmn:incoming>Seq_EndClosed1</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Intermediate Catch Event: Money Received -->
    <bpmn:intermediateCatchEvent id="EC_MoneyReceived" name="Money Received">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>Seq_MoneyReceivedPath</bpmn:incoming>
      <bpmn:outgoing>Seq_BookingTask</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task: Make Booking -->
    <bpmn:task id="Task_MakeBooking" name="Make Booking">
      <bpmn:incoming>Seq_BookingTask</bpmn:incoming>
      <bpmn:outgoing>Seq_CloseCaseAfterPayment</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Close Case (After Payment) -->
    <bpmn:task id="Task_CloseCasePaid" name="Close Case">
      <bpmn:incoming>Seq_CloseCaseAfterPayment</bpmn:incoming>
      <bpmn:outgoing>Seq_EndClosed2</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 2 -->
    <bpmn:endEvent id="End_CaseClosed_Paid" name="Case Closed">
      <bpmn:incoming>Seq_EndClosed2</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Intermediate Catch Event: Disagreement Letter Received -->
    <bpmn:intermediateCatchEvent id="EC_DisagreementLetter" name="Disagreement Letter">
      <bpmn:messageEventDefinition/>
      <bpmn:incoming>Seq_DisagreementLetterPath</bpmn:incoming>
      <bpmn:outgoing>Seq_CheckReasoningTask</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task: Check Reasoning -->
    <bpmn:task id="Task_CheckReasoning" name="Check Reasoning">
      <bpmn:incoming>Seq_CheckReasoningTask</bpmn:incoming>
      <bpmn:outgoing>Seq_ReasoningDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Is Reasoning OK? -->
    <bpmn:exclusiveGateway id="Gw_IsReasoningOK" name="Is reasoning valid?">
      <bpmn:incoming>Seq_ReasoningDecision</bpmn:incoming>
      <bpmn:outgoing>Seq_CloseCaseValidDisagreement</bpmn:outgoing>
      <bpmn:outgoing>Seq_HandoverToCollectionAgency</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Close Case (Valid Disagreement) -->
    <bpmn:task id="Task_CloseCaseValidDisagree" name="Close Case">
      <bpmn:incoming>Seq_CloseCaseValidDisagreement</bpmn:incoming>
      <bpmn:outgoing>Seq_EndClosed3</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 3 -->
    <bpmn:endEvent id="End_CaseClosed_ValidDisagree" name="Case Closed">
      <bpmn:incoming>Seq_EndClosed3</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Intermediate Catch Event: Deadline Reached / Reminder Due -->
    <bpmn:intermediateCatchEvent id="EC_ReminderDue" name="Deadline Reached">
      <bpmn:timerEventDefinition/>
      <bpmn:incoming>Seq_ReminderDuePath</bpmn:incoming>
      <bpmn:outgoing>Seq_HandoverToCollectionAgency2</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task: Hand Over to Collection Agency -->
    <bpmn:task id="Task_CollectionAgency" name="Hand over to Collection Agency">
      <bpmn:incoming>Seq_HandoverToCollectionAgency</bpmn:incoming>
      <bpmn:incoming>Seq_HandoverToCollectionAgency2</bpmn:incoming>
      <bpmn:outgoing>Seq_EndOpenCase</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 4 -->
    <bpmn:endEvent id="End_CaseHandedOver" name="Case Handed Over">
      <bpmn:incoming>Seq_EndOpenCase</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows for Decision Points -->
    
    <bpmn:sequenceFlow id="Seq_StartToCheckCase" sourceRef="Start_ProbableRecourse" targetRef="Task_CheckCase"/>
    <bpmn:sequenceFlow id="Seq_CaseDecision" name="recourse possible?" sourceRef="Task_CheckCase" targetRef="Gw_RecoursePossible"/>
    
    <!-- From Recourse Possible Gateway -->
    <bpmn:sequenceFlow id="Seq_SendPaymentRequest" name="yes" sourceRef="Gw_RecoursePossible" targetRef="Task_SendPaymentRequest"/>
    <bpmn:sequenceFlow id="Seq_CloseCaseNoRecourse" name="no" sourceRef="Gw_RecoursePossible" targetRef="Task_CloseCaseNoRecourse"/>

    <!-- From Send Payment Request -->
    <bpmn:sequenceFlow id="Seq_SendReminder" sourceRef="Task_SendPaymentRequest" targetRef="Task_SendReminder"/>
    
    <!-- To Event-Based Gateway -->
    <bpmn:sequenceFlow id="Seq_EventBasedGatewayStart" sourceRef="Task_SendReminder" targetRef="Gw_WaitingEvents"/>

    <!-- From Event-Based Gateway to Catch Events -->
    <bpmn:sequenceFlow id="Seq_MoneyReceivedPath" name="money received" sourceRef="Gw_WaitingEvents" targetRef="EC_MoneyReceived"/>
    <bpmn:sequenceFlow id="Seq_DisagreementLetterPath" name="disagreement letter" sourceRef="Gw_WaitingEvents" targetRef="EC_DisagreementLetter"/>
    <bpmn:sequenceFlow id="Seq_ReminderDuePath" name="deadline reached" sourceRef="Gw_WaitingEvents" targetRef="EC_ReminderDue"/>

    <!-- From Money Received -->
    <bpmn:sequenceFlow id="Seq_BookingTask" sourceRef="EC_MoneyReceived" targetRef="Task_MakeBooking"/>
    
    <!-- After Booking to Close Case -->
    <bpmn:sequenceFlow id="Seq_CloseCaseAfterPayment" name="payment received" sourceRef="Task_MakeBooking" targetRef="Task_CloseCasePaid"/>

    <!-- From Disagreement Letter -->
    <bpmn:sequenceFlow id="Seq_CheckReasoningTask" sourceRef="EC_DisagreementLetter" targetRef="Task_CheckReasoning"/>
    
    <!-- To Reasoning Decision Gateway -->
    <bpmn:sequenceFlow id="Seq_ReasoningDecision" name="reasoning valid?" sourceRef="Task_CheckReasoning" targetRef="Gw_IsReasoningOK"/>

    <!-- From Is Reasoning OK Gateway -->
    <bpmn:sequenceFlow id="Seq_CloseCaseValidDisagreement" name="yes (insurant right)" sourceRef="Gw_IsReasoningOK" targetRef="Task_CloseCaseValidDisagree"/>
    
    <!-- To Collection Agency from Invalid Disagreement -->
    <bpmn:sequenceFlow id="Seq_HandoverToCollectionAgency" name="no (insurant wrong)" sourceRef="Gw_IsReasoningOK" targetRef="Task_CollectionAgency"/>

    <!-- From Reminder Due to Collection Agency -->
    <bpmn:sequenceFlow id="Seq_HandoverToCollectionAgency2" sourceRef="EC_ReminderDue" targetRef="Task_CollectionAgency"/>

    <!-- To End Events -->
    <bpmn:sequenceFlow id="Seq_EndClosed1" name="" sourceRef="Task_CloseCaseNoRecourse" targetRef="End_CaseClosed_NoRecourse"/>
    <bpmn:sequenceFlow id="Seq_EndClosed2" name="" sourceRef="Task_CloseCasePaid" targetRef="End_CaseClosed_Paid"/>
    <bpmn:sequenceFlow id="Seq_EndClosed3" name="" sourceRef="Task_CloseCaseValidDisagree" targetRef="End_CaseClosed_ValidDisagree"/>
    
    <!-- To Final End Event -->
    <bpmn:sequenceFlow id="Seq_EndOpenCase" name="" sourceRef="Task_CollectionAgency" targetRef="End_CaseHandedOver"/>

  </bpmn:process>
</bpmn:definitions>