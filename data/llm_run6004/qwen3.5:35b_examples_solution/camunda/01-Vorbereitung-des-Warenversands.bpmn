<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
                 id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_OrderProcess">
    <bpmn:participant id="Pool_HardwareDealer" name="Warenversand&#10;Hardware-Händler" processRef="Proc_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Proc_1" isExecutable="false">
    <bpmn:laneSet id="Lanes_Set">
      <bpmn:lane id="Lane_LogisticsManager" name="Leiter Logistik">
        <bpmn:flowNodeRef>Task_Versicherung</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Secretary" name="Sekretariat">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_VersandartKlaeren</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_SonderversandDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_NormalShipping</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_PaketscheinAusfuellen</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Warehouse" name="Lagerarbeiter">
        <bpmn:flowNodeRef>T_VerpackenWare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_FinalMerge</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Spedition" name="Spediteure">
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Artikel zu versenden">
      <bpmn:outgoing>SequenceFlow_StartToParallel</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Parallel Gateway - splits warehouse packing from shipping decisions -->
    <bpmn:parallelGateway id="G_ParallelStart" name="">
      <bpmn:incoming>SequenceFlow_StartToParallel</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToSecretaryProcess</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ToWarehousePacking</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Secretary Lane Tasks -->
    <bpmn:task id="T_VersandartKlaeren" name="Versandart klären">
      <bpmn:description>Klärt, wer den Versand übernimmt</bpmn:description>
      <bpmn:incoming>SequenceFlow_ToSecretaryProcess</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SonderversandDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway - Special shipment decision -->
    <bpmn:exclusiveGateway id="G_SonderversandDecision" name="Sonderversand?">
      <bpmn:description>Große Mengen = Sonderversand notwendig</bpmn:description>
      <bpmn:incoming>SequenceFlow_SonderversandDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NormalShippingNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Normal Shipping Path (Small Quantities) -->
    <bpmn:inclusiveGateway id="InclusiveGateway_NormalShipping" name="">
      <bpmn:description>Versicherung optional für kleine Mengen</bpmn:description>
      <bpmn:incoming>SequenceFlow_NormalShippingNo</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InsuranceRequiredYes</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Insurance Task (Logistics Manager) -->
    <bpmn:task id="Task_Versicherung" name="Versicherung abschließen">
      <bpmn:description>Vom Logistikleiter bei erforderlicher Versicherung</bpmn:description>
      <bpmn:incoming>SequenceFlow_InsuranceRequiredYes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_VersicherungDoneToMerge1</bpmn:outgoing>
    </bpmn:task>

    <!-- Package Form Task (Secretary) -->
    <bpmn:task id="T_PaketscheinAusfuellen" name="Paketschein ausfüllen">
      <bpmn:description>Ausfüllung des standardisierten Paketscheins</bpmn:description>
      <bpmn:incoming>SequenceFlow_VersicherungDoneToMerge1</bpmn:incoming>
    </bpmn:task>

    <!-- Warehouse Lane Tasks -->
    <bpmn:task id="T_VerpackenWare" name="Ware verpacken">
      <bpmn:description>Lagerarbeiter packt Ware parallel zu Vorbereitungen</bpmn:description>
      <bpmn:incoming>SequenceFlow_ToWarehousePacking</bpmn:incoming>
    </bpmn:task>

    <!-- Final Merge Gateway - All preparations done -->
    <bpmn:exclusiveGateway id="G_FinalMerge" name="">
      <bpmn:description>Vor der Abholung bereitstellen, wenn alle Vorbereitungen abgeschlossen</bpmn:description>
      <bpmn:incoming>SequenceFlow_VersicherungDoneToMerge1</bpmn:incoming>
    </bpmn:exclusiveGateway>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Prepared" name="Warenversand vorbereitet">
      <bpmn:description>Von Lagerarbeiter zur Abholung bereitgestellt</bpmn:description>
      <bpmn:incoming>SequenceFlow_FinalToPrepared</bpmn:outgoing>
    </bpmn:endEvent>

    <!-- Sequence Flows - Secretary Lane -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToParallel" sourceRef="StartEvent_1" targetRef="G_ParallelStart"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ToSecretaryProcess" name="" sourceRef="G_ParallelStart" targetRef="T_VersandartKlaeren">
      <bpmn:name/>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_SonderversandDecision" name="" sourceRef="T_VersandartKlaeren" targetRef="G_SonderversandDecision"/>

    <!-- Normal Shipping Path -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_NormalShippingMerge" name="">
      <bpmn:description>Optional insurance check for small quantities</bpmn:description>
      <bpmn:incoming>SequenceFlow_VersicherungDoneToMerge1</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Insurance Required Decision -->
    <bpmn:sequenceFlow id="SequenceFlow_NormalShippingNo" name="" sourceRef="G_SonderversandDecision" targetRef="InclusiveGateway_NormalShipping"/>

    <bpmn:sequenceFlow id="SequenceFlow_InsuranceRequiredYes" name="Versicherung erforderlich?" sourceRef="InclusiveGateway_NormalShipping" targetRef="Task_Versicherung">
      <bpmn:name>Versicherung&#10;erforderlich</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Insurance Path Merge -->
    <bpmn:inclusiveGateway id="InclusiveGateway_NormalShippingMerge" name="">
      <bpmn:description>Merge after insurance decision</bpmn:description>
      <bpmn:incoming>SequenceFlow_VersicherungDoneToMerge1</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PaketscheinAlways</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Package Form Path -->
    <bpmn:sequenceFlow id="SequenceFlow_VersicherungDoneToMerge1" name="" sourceRef="Task_Versicherung" targetRef="InclusiveGateway_NormalShippingMerge"/>

    <bpmn:exclusiveGateway id="ExclusiveGateway_PaketscheinStart" name="">
      <bpmn:description>Always execute package form</bpmn:description>
      <bpmn:incoming>SequenceFlow_PaketscheinAlways</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_VersicherungDoneToMerge1</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Warehouse Path -->
    <bpmn:sequenceFlow id="SequenceFlow_ToWarehousePacking" name="" sourceRef="G_ParallelStart" targetRef="T_VerpackenWare"/>

    <!-- Final Merge and End -->
    <bpmn:sequenceFlow id="SequenceFlow_FinalToPrepared" name="" sourceRef="InclusiveGateway_NormalShippingMerge" targetRef="EndEvent_Prepared">
      <bpmn:name/>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>