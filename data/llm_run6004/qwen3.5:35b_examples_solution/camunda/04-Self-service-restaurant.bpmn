<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
                 id="Definitions_RestaurantProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  
  <bpmn:collaboration id="Collab_RestaurantOrdering">
    <bpmn:participant id="Pool_Guest" name="Guest" processRef="Proc_Guest"/>
    <bpmn:participant id="Pool_Employee" name="Employee" processRef="Proc_Employee"/>
    <bpmn:participant id="Pool_Chef" name="Chef" processRef="Proc_Chef"/>
    
    <!-- Message Flows between participants -->
    <bpmn:messageFlow id="Msg_OrderPlaced" sourceRef="Task_GuestPlaceOrder" targetRef="StartEvent_EmployeeReceived"/>
    <bpmn:messageFlow id="Msg_ReadySignal" sourceRef="Task_ChefInformEmployee" targetRef="IntermediateCatch_EmployeeMealReady"/>
    <bpmn:messageFlow id="Msg_BuzzerActivated" sourceRef="Task_EmployeeActivateBuzzer" targetRef="IntermediateCatch_GuestBuzzerRing"/>
  </bpmn:collaboration>

  <!-- Guest Process -->
  <bpmn:process id="Proc_Guest">
    <bpmn:startEvent id="Start_Hungry" name="Guest hungry">
      <bpmn:outgoing>Seq_1</bpmn:outgoing>
    </bpmn:startEvent>
    
    <bpmn:task id="Task_GuestEnterRestaurant" name="Enter restaurant">
      <bpmn:incoming>Seq_1</bpmn:incoming>
      <bpmn:outgoing>Seq_2</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:sequenceFlow id="Seq_1" sourceRef="Start_Hungry" targetRef="Task_GuestEnterRestaurant"/>
    
    <bpmn:task id="Task_ChooseDish" name="Choose dish">
      <bpmn:incoming>Seq_2</bpmn:incoming>
      <bpmn:outgoing>Seq_3</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:sequenceFlow id="Seq_2" sourceRef="Task_GuestEnterRestaurant" targetRef="Task_ChooseDish"/>
    
    <bpmn:intermediateCatchEvent id="IntermediateWaitTurn" name="Wait for turn">
      <bpmn:incoming>Seq_3</bpmn:incoming>
      <bpmn:outgoing>Seq_4</bpmn:outgoing>
      <bpmn:messageEventDefinition/>
    </bpmn:intermediateCatchEvent>
    
    <bpmn:sequenceFlow id="Seq_3" sourceRef="Task_ChooseDish" targetRef="IntermediateWaitTurn"/>
    
    <bpmn:task id="Task_GuestPlaceOrder" name="Place order with employee">
      <bpmn:incoming>Seq_4</bpmn:incoming>
      <bpmn:outgoing>Msg_OrderPlaced</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:sequenceFlow id="Seq_4" sourceRef="IntermediateWaitTurn" targetRef="Task_GuestPlaceOrder"/>
    
    <bpmn:intermediateCatchEvent id="IntermediateBuzzerRing" name="Buzzer rings">
      <bpmn:incoming>Msg_BuzzerActivated</bpmn:incoming>
      <bpmn:outgoing>Seq_6</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    
    <bpmn:sequenceFlow id="Seq_5" sourceRef="Task_GuestPlaceOrder" targetRef="IntermediateBuzzerRing"/>
    
    <bpmn:task id="Task_PickUpMeal" name="Pick up meal">
      <bpmn:incoming>Msg_BuzzerActivated</bpmn:incoming>
      <bpmn:outgoing>Seq_7</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:sequenceFlow id="Seq_6" sourceRef="IntermediateBuzzerRing" targetRef="Task_PickUpMeal"/>
    
    <bpmn:endEvent id="End_EatMeal" name="Eat meal">
      <bpmn:incoming>Msg_BuzzerActivated</bpmn:incoming>
    </bpmn:endEvent>
    
    <bpmn:sequenceFlow id="Seq_7" sourceRef="Task_PickUpMeal" targetRef="End_EatMeal"/>
  </bpmn:process>

  <!-- Employee Process -->
  <bpmn:process id="Proc_Employee">
    <bpmn:startEvent id="StartOrderReceived" name="Order received">
      <bpmn:incoming>Msg_OrderPlaced</bpmn:incoming>
      <bpmn:outgoing>Seq_10</bpmn:outgoing>
    </bpmn:startEvent>
    
    <bpmn:task id="Task_EnterOrderPOS" name="Enter order in POS">
      <bpmn:incoming>Msg_OrderPlaced</bpmn:incoming>
      <bpmn:outgoing>Seq_10</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:sequenceFlow id="Seq_10" sourceRef="StartOrderReceived" targetRef="Task_EnterOrderPOS"/>
    
    <bpmn:task id="Task_CollectMoney" name="Collect money">
      <bpmn:incoming>Seq_10</bpmn:incoming>
      <bpmn:outgoing>Seq_11</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:sequenceFlow id="Seq_11" sourceRef="Task_EnterOrderPOS" targetRef="Task_CollectMoney"/>
    
    <bpmn:task id="Task_SetupBuzzer" name="Set up buzzer">
      <bpmn:incoming>Seq_11</bpmn:incoming>
      <bpmn:outgoing>Seq_12</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:sequenceFlow id="Seq_12" sourceRef="Task_CollectMoney" targetRef="Task_SetupBuzzer"/>
    
    <bpmn:task id="Task_HandOverBuzzer" name="Hand over buzzer">
      <bpmn:incoming>Msg_OrderPlaced</bpmn:incoming>
      <bpmn:outgoing>Seq_13</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:sequenceFlow id="Seq_13" sourceRef="Task_SetupBuzzer" targetRef="Task_HandOverBuzzer"/>
    
    <bpmn:task id="Task_InformChef" name="Inform chef of order">
      <bpmn:incoming>Msg_OrderPlaced</bpmn:incoming>
      <bpmn:outgoing>Seq_14</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:sequenceFlow id="Seq_14" sourceRef="Task_HandOverBuzzer" targetRef="Task_InformChef"/>
    
    <!-- Wait for meal ready signal from chef -->
    <bpmn:intermediateCatchEvent id="IntermediateMealReadySignal" name="Meal ready">
      <bpmn:incoming>Msg_ReadySignal</bpmn:incoming>
      <bpmn:outgoing>Seq_15</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    
    <bpmn:sequenceFlow id="Seq_15" sourceRef="IntermediateMealReadySignal" targetRef="Task_EmployeeActivateBuzzer"/>
    
    <!-- Activate buzzer for guest -->
    <bpmn:task id="Task_EmployeeActivateBuzzer" name="Set off buzzer">
      <bpmn:incoming>Seq_15</bpmn:incoming>
      <bpmn:outgoing>Msg_BuzzerActivated</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Wait for guest to appear -->
    <bpmn:eventBasedGateway id="Event_GuestAppearsOrTimeout">
      <bpmn:incoming>Seq_16</bpmn:incoming>
      <bpmn:outgoing>Seq_Appears</bpmn:outgoing>
      <bpmn:outgoing>Seq_Timeout</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    
    <!-- Guest appears path -->
    <bpmn:intermediateCatchEvent id="IntermediateGuestAppears" name="Guest at hatch">
      <bpmn:incoming>Msg_GuestAtHatch</bpmn:incoming>
      <bpmn:outgoing>Seq_Appears</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    
    <!-- Timeout path (5 minutes) -->
    <bpmn:intermediateCatchEvent id="IntermediateTimeout" name="Wait 5 min">
      <bpmn:incoming>Seq_Timeout</bpmn:incoming>
      <bpmn:outgoing>Seq_CallGuest</bpmn:outgoing>
      <bpmn:timerEventDefinition/>
    </bpmn:intermediateCatchEvent>
    
    <!-- Call guest task -->
    <bpmn:task id="Task_CallGuest" name="Call guest">
      <bpmn:incoming>Seq_CallGuest</bpmn:incoming>
      <bpmn:outgoing>Msg_GuestAtHatch</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Hand over meal -->
    <bpmn:task id="Task_HandOverMeal" name="Hand over meal">
      <bpmn:incoming>Seq_Appears</bpmn:incoming>
      <bpmn:outgoing>Msg_GuestAtHatch</bpmn:outgoing>
    </bpmn:task>
    
    <!-- End event -->
    <bpmn:endEvent id="End_OrderProcessed" name="Order processed">
      <bpmn:incoming>Seq_Appears</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>

  <!-- Chef Process -->
  <bpmn:process id="Proc_Chef">
    <bpmn:startEvent id="StartMealNeeded" name="Order received from employee">
      <bpmn:incoming>Msg_OrderPlaced</bpmn:incoming>
      <bpmn:outgoing>Seq_20</bpmn:outgoing>
    </bpmn:startEvent>
    
    <bpmn:task id="Task_PrepareMeal" name="Prepare meal">
      <bpmn:incoming>Msg_OrderPlaced</bpmn:incoming>
      <bpmn:outgoing>Seq_20</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:sequenceFlow id="Seq_20" sourceRef="StartMealNeeded" targetRef="Task_PrepareMeal"/>
    
    <bpmn:task id="Task_PlaceInHatch" name="Place meal in hatch">
      <bpmn:incoming>Msg_OrderPlaced</bpmn:incoming>
      <bpmn:outgoing>Seq_21</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:sequenceFlow id="Seq_21" sourceRef="Task_PrepareMeal" targetRef="Task_PlaceInHatch"/>
    
    <bpmn:task id="Task_ChefInformEmployee" name="Inform employee meal ready">
      <bpmn:incoming>Msg_OrderPlaced</bpmn:incoming>
      <bpmn:outgoing>Seq_22</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:sequenceFlow id="Seq_22" sourceRef="Task_PlaceInHatch" targetRef="Task_ChefInformEmployee"/>
    
    <!-- End event -->
    <bpmn:endEvent id="End_MealPrepared" name="Meal prepared">
      <bpmn:incoming>Msg_OrderPlaced</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>

</bpmn:definitions>