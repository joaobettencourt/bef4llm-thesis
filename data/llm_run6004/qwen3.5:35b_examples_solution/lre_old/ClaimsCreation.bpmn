<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_claimProcess_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_claimSettlement">
    <bpmn:participant id="Participant_ClaimProcessing" name="Claim Settlement Process" processRef="Process_ClaimHandling"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_ClaimHandling" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Clerk" name="Clerk">
        <bpmn:flowNodeRef>StartEvent_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SearchPoliceReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ComposeFile</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ClaimsHandler" name="Claims Handler">
        <bpmn:flowNodeRef>Task_CalculateEstimate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateActionPlan</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ClaimsManager" name="Claims Manager">
        <bpmn:flowNodeRef>Task_NegotiateSettlement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformClaimant</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Data Objects -->
    <bpmn:dataObject id="Data_PoliceReportDB" name="Police Report Database"/>
    <bpmn:dataObject id="Data_ClaimDocumentation" name="Claim Documentation"/>
    <bpmn:dataObject id="Data_ActionPlanChecklist" name="Action Plan Checklist (DMS)"/>
    <bpmn:dataObject id="Data_ComposedFile" name="Composed File with Reports"/>
    <bpmn:dataObject id="Data_ClaimEstimate" name="Initial Claim Estimate"/>
    <bpmn:dataObject id="Data_ActionPlan" name="Action Plan"/>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_0">
      <bpmn:outgoing>SequenceFlow_SearchReport</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Search Police Report Database -->
    <bpmn:task id="Task_SearchPoliceReport" name="Search police report database">
      <bpmn:incoming>SequenceFlow_SearchReport</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ComposeFile</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: Compose File -->
    <bpmn:task id="Task_ComposeFile" name="Compose file with Claim Documentation">
      <bpmn:incoming>SequenceFlow_ComposeFile</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_HandoverToHandler</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3: Calculate Initial Claim Estimate -->
    <bpmn:task id="Task_CalculateEstimate" name="Calculate initial claim estimate">
      <bpmn:incoming>SequenceFlow_HandoverToHandler</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CreateActionPlan</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 4: Create Action Plan -->
    <bpmn:task id="Task_CreateActionPlan" name="Create action plan from checklist">
      <bpmn:incoming>SequenceFlow_CreateActionPlan</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NegotiateSettlement</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 5: Negotiate Settlement -->
    <bpmn:task id="Task_NegotiateSettlement" name="Negotiate settlement on claim estimate">
      <bpmn:incoming>SequenceFlow_NegotiateSettlement</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InformClaimant</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 6: Inform Claimant -->
    <bpmn:task id="Task_InformClaimant" name="Inform claimant of outcome">
      <bpmn:incoming>SequenceFlow_InformClaimant</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndProcess</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_0">
      <bpmn:name>Claim Process Completed</bpmn:name>
      <bpmn:incoming>SequenceFlow_EndProcess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_SearchReport" sourceRef="StartEvent_0" targetRef="Task_SearchPoliceReport"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ComposeFile" name="Compose File" sourceRef="Task_SearchPoliceReport" targetRef="Task_ComposeFile"/>

    <bpmn:sequenceFlow id="SequenceFlow_HandoverToHandler" name="Hand over to Claims Handler" sourceRef="Task_ComposeFile" targetRef="Task_CalculateEstimate"/>

    <bpmn:sequenceFlow id="SequenceFlow_CreateActionPlan" name="Create Action Plan" sourceRef="Task_CalculateEstimate" targetRef="Task_CreateActionPlan"/>

    <bpmn:sequenceFlow id="SequenceFlow_NegotiateSettlement" name="Negotiate Settlement" sourceRef="Task_CreateActionPlan" targetRef="Task_NegotiateSettlement"/>

    <bpmn:sequenceFlow id="SequenceFlow_InformClaimant" name="Inform Claimant" sourceRef="Task_NegotiateSettlement" targetRef="Task_InformClaimant"/>

    <bpmn:sequenceFlow id="SequenceFlow_EndProcess" name="End Process" sourceRef="Task_InformClaimant" targetRef="EndEvent_0"/>
  </bpmn:process>
</bpmn:definitions>