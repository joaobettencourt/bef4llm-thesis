<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_vacationRequest_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_VacationProcess">
    <bpmn:participant id="Participant_Organization" name="Organization Vacation Request Process" processRef="Process_VacationRequest"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_VacationRequest" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Employee_Submit" name="Employee (Submitter)">
        <bpmn:flowNodeRef>StartEvent_SubmitRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegisterVacationRequest</bpmn:flowNodeRef>
      </bpmn:laneSet>

      <bpmn:lane id="Lane_Supervisor" name="Supervisor">
        <bpmn:flowNodeRef>ExclusiveGateway_ApprovalDecision</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_HR" name="Human Resources Representative">
        <bpmn:flowNodeRef>Task_CompleteManagementProcedures</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_RequestApproved</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Employee_Review" name="Employee (Reviewer)">
        <bpmn:flowNodeRef>Task_ReviewRejectionReasons</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_RequestRejected</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_SubmitRequest" name="Vacation Request Submitted">
      <bpmn:outgoing>SequenceFlow_RegisterRequest</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Register Vacation Request (Employee) -->
    <bpmn:task id="Task_RegisterVacationRequest" name="Register Vacation Request">
      <bpmn:incoming>SequenceFlow_RegisterRequest</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendToSupervisor</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Supervisor Approval/Rejection -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_ApprovalDecision" name="Request Approved?">
      <bpmn:incoming>SequenceFlow_SendToSupervisor</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_IfApproved</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_IfRejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Complete Management Procedures (HR) -->
    <bpmn:task id="Task_CompleteManagementProcedures" name="Complete HR Management Procedures">
      <bpmn:incoming>SequenceFlow_IfApproved</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FinalizeRequest</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Review Rejection Reasons (Employee) -->
    <bpmn:endEvent id="EndEvent_RequestRejected" name="Vacation Request Rejected">
      <bpmn:name>Vacation Request Rejected</bpmn:name>
      <bpmn:incoming>SequenceFlow_IfRejected</bpmn:incoming>
    </bpmn:endEvent>

    <!-- End Event for Approved -->
    <bpmn:endEvent id="EndEvent_RequestApproved" name="Vacation Request Approved">
      <bpmn:name>Vacation Request Approved</bpmn:name>
      <bpmn:incoming>SequenceFlow_FinalizeRequest</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_RegisterRequest" sourceRef="StartEvent_SubmitRequest" targetRef="Task_RegisterVacationRequest">
      <bpmn:name>Vacation Request Submitted</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_SendToSupervisor" sourceRef="Task_RegisterVacationRequest" targetRef="ExclusiveGateway_ApprovalDecision">
      <bpmn:name>Send to Supervisor</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_IfApproved" name="Yes - Approved" sourceRef="ExclusiveGateway_ApprovalDecision" targetRef="Task_CompleteManagementProcedures">
      <bpmn:name>Request Approved</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_IfRejected" name="No - Rejected" sourceRef="ExclusiveGateway_ApprovalDecision" targetRef="EndEvent_RequestRejected">
      <bpmn:name>Request Rejected</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_FinalizeRequest" name="Process Complete" sourceRef="Task_CompleteManagementProcedures" targetRef="EndEvent_RequestApproved">
      <bpmn:name>HR Procedures Completed</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>