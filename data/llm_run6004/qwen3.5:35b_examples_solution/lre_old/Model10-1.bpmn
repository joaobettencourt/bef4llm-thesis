<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_dismissalProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_DismissalReview">
    <bpmn:participant id="Participant_MPON" name="MPON" processRef="Process_MPON"/>
    <bpmn:participant id="Participant_MPOO" name="MPOO" processRef="Process_MPOO"/>
    
    <!-- Message Flow from MPON to MPOO -->
    <bpmn:messageFlow id="MessageFlow_DismissalSent">
      <bpmn:name>Send Dismissal Notification</bpmn:name>
      <bpmn:sourceRef>IntermediateThrowEvent_SendDismissal_MPON</bpmn:sourceRef>
      <bpmn:targetRef>StartMessageEvent_ReceiveDismissal_MPOO</bpmn:targetRef>
    </bpmn:messageFlow>
  </bpmn:collaboration>

  <!-- MPON Process -->
  <bpmn:process id="Process_MPON" isExecutable="false">
    <bpmn:startEvent id="StartEvent_MPON_Initiate">
      <bpmn:name>Initiate Dismissal</bpmn:name>
      <bpmn:outgoing>SequenceFlow_PrepareDismissal_MPON</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_MPON_Conduct">
      <bpmn:name>Conduct Dismissal Process</bpmn:name>
      <bpmn:incoming>SequenceFlow_PrepareDismissal_MPON</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendToMPOO_MPON</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_MPON_Complete">
      <bpmn:name>Dismissal Process Complete</bpmn:name>
      <bpmn:incoming>SequenceFlow_SendToMPOO_MPON</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Intermediate Throw Event for Message -->
    <bpmn:intermediateThrowEvent id="IntermediateThrowEvent_SendDismissal_MPON">
      <bpmn:name>Send Dismissal to MPOO</bpmn:name>
      <bpmn:messageRef>Message_DismissalNotification</bpmn:messageRef>
      <bpmn:incoming>SequenceFlow_PrepareMessage_MPON</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CompleteProcess_MPON</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_PrepareDismissal_MPON" sourceRef="StartEvent_MPON_Initiate" targetRef="Task_MPON_Conduct"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_SendToMPOO_MPON" name="Send Dismissal to MPOO">
      <sourceRef>Task_MPON_Conduct</sourceRef>
      <targetRef>IntermediateThrowEvent_SendDismissal_MPON</targetRef>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_CompleteProcess_MPON" sourceRef="IntermediateThrowEvent_SendDismissal_MPON" targetRef="EndEvent_MPON_Complete"/>
  </bpmn:process>

  <!-- MPOO Process -->
  <bpmn:process id="Process_MPOO" isExecutable="false">
    <bpmn:startEvent id="StartMessageEvent_ReceiveDismissal_MPOO">
      <bpmn:name>Receive Dismissal Notification</bpmn:name>
      <bpmn:messageRef>Message_DismissalNotification</bpmn:messageRef>
      <bpmn:outgoing>SequenceFlow_StartReviewProcess_MPOO</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task for Review -->
    <bpmn:task id="Task_MPOO_Review">
      <bpmn:name>Review Dismissal of MPON</bpmn:name>
      <bpmn:incoming>SequenceFlow_StartReviewProcess_MPOO</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GatewayDecision_MPOO</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway for Decision -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_Decision">
      <bpmn:name>MPOO Decision on Dismissal?</bpmn:name>
      <bpmn:incoming>SequenceFlow_GatewayDecision_MPOO</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OpposeDismissal_MPOO</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ConfirmDismissal_MPOO</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task for Opposing Dismissal -->
    <bpmn:task id="Task_MPOO_Oppose">
      <bpmn:name>Oppose the Dismissal of MPON</bpmn:name>
      <bpmn:incoming>SequenceFlow_OpposeDismissal_MPOO</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndOpposedProcess_MPOO</bpmn:outgoing>
    </bpmn:task>

    <!-- Task for Confirming Dismissal -->
    <bpmn:task id="Task_MPOO_Confirm">
      <bpmn:name>Confirm the Dismissal of MPON</bpmn:name>
      <bpmn:incoming>SequenceFlow_ConfirmDismissal_MPOO</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndConfirmedProcess_MPOO</bpmn:outgoing>
    </bpmn:task>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_MPOO_Opposed">
      <bpmn:name>Dismissal Opposed - Process Complete</bpmn:name>
      <bpmn:incoming>SequenceFlow_EndOpposedProcess_MPOO</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_MPOO_Confirmed">
      <bpmn:name>Dismissal Confirmed - Process Complete</bpmn:name>
      <bpmn:incoming>SequenceFlow_EndConfirmedProcess_MPOO</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartReviewProcess_MPOO" sourceRef="StartMessageEvent_ReceiveDismissal_MPOO" targetRef="Task_MPOO_Review"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_GatewayDecision_MPOO" name="Proceed to Decision">
      <sourceRef>Task_MPOO_Review</sourceRef>
      <targetRef>ExclusiveGateway_Decision</targetRef>
    </bpmn:sequenceFlow>

    <!-- Gateway Outgoing Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_OpposeDismissal_MPOO" name="Oppose Dismissal">
      <sourceRef>ExclusiveGateway_Decision</sourceRef>
      <targetRef>Task_MPOO_Oppose</targetRef>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ConfirmDismissal_MPOO" name="Confirm Dismissal">
      <sourceRef>ExclusiveGateway_Decision</sourceRef>
      <targetRef>Task_MPOO_Confirm</targetRef>
    </bpmn:sequenceFlow>

    <!-- End Flow Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_EndOpposedProcess_MPOO" sourceRef="Task_MPOO_Oppose" targetRef="EndEvent_MPOO_Opposed"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_EndConfirmedProcess_MPOO" sourceRef="Task_MPOO_Confirm" targetRef="EndEvent_MPOO_Confirmed"/>

  </bpmn:process>

  <!-- Message Definition -->
  <bpmn:message id="Message_DismissalNotification">
    <bpmn:name>Dismissal Notification</bpmn:name>
  </bpmn:message>

</bpmn:definitions>