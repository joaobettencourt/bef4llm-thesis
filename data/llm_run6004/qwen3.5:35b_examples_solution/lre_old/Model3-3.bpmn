<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_claimProcess_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_claimHandling">
    <bpmn:participant id="Participant_mainClaimProc" name="Claims Handling Process" processRef="Process_claimProcessing"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_claimProcessing" isExecutable="false">
    <!-- Lane for Claims Officer -->
    <bpmn:laneSet>
      <bpmn:lane id="Lane_claimsOfficer" name="Claims Officer">
        <bpmn:flowNodeRef>Task_examineClaim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_writeRecommendation</bpmn:flowNodeRef>
      </bpmn:lane>

      <!-- Lane for Senior Claims Officer -->
      <bpmn:lane id="Lane_seniorOfficer" name="Senior Claims Officer">
        <bpmn:flowNodeRef>Gateway_decisionPoint</bpmn:flowNodeRef>
      </bpmn:lane>

      <!-- Lane for Process End (shared) -->
      <bpmn:lane id="Lane_processEnd" name="Process Completion">
        <bpmn:flowNodeRef>StartEvent_claimRegistered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_claimApproved</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_claimRegistered" name="Claim Registered">
      <bpmn:outgoing>SequenceFlow_examineClaim</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Examine Claim by Claims Officer -->
    <bpmn:task id="Task_examineClaim" name="Examine Claim">
      <bpmn:incoming>SequenceFlow_examineClaim</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_writeRecommendation</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: Write Settlement Recommendation by Claims Officer -->
    <bpmn:task id="Task_writeRecommendation" name="Write Settlement Recommendation">
      <bpmn:incoming>SequenceFlow_writeRecommendation</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_checkRecommendation</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway for Senior Officer Decision -->
    <bpmn:exclusiveGateway id="Gateway_decisionPoint" name="Claim OK?">
      <bpmn:incoming>SequenceFlow_checkRecommendation</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_claimApproved</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_notOKLoopBack</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event for Approved Claim -->
    <bpmn:endEvent id="EndEvent_claimApproved" name="Claim Handling Complete">
      <bpmn:incoming>SequenceFlow_claimApproved</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_examineClaim" sourceRef="StartEvent_claimRegistered" targetRef="Task_examineClaim">
      <bpmn:name>Examine Claim</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_writeRecommendation" sourceRef="Task_examineClaim" targetRef="Task_writeRecommendation">
      <bpmn:name>Write Recommendation</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_checkRecommendation" name="Check by Senior Officer" sourceRef="Task_writeRecommendation" targetRef="Gateway_decisionPoint">
      <bpmn:name>Submit for Review</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- OK Path - Process Continues -->
    <bpmn:sequenceFlow id="SequenceFlow_claimApproved" name="OK" sourceRef="Gateway_decisionPoint" targetRef="EndEvent_claimApproved">
      <bpmn:name>Suitable for Approval</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Not OK Path - Loop Back -->
    <bpmn:sequenceFlow id="SequenceFlow_notOKLoopBack" name="Not OK" sourceRef="Gateway_decisionPoint" targetRef="Task_writeRecommendation">
      <bpmn:name>Needs Revision</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>