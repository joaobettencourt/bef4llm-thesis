<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_RecruitmentProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_recruitmentProc">
    <bpmn:participant id="Participant_mainRecruit" name="Employee Recruitment Process" processRef="Process_employeeRecruitment"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_employeeRecruitment" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_functionalDept" name="Functional Department">
        <bpmn:flowNodeRef>StartEvent_vacancyCreated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_reportVacancy</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_hrDept" name="HR Department">
        <bpmn:flowNodeRef>Task_advertisePost</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_checkApplication</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_concludeContract</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_applicant" name="Applicant">
        <bpmn:flowNodeRef>Task_applyForPost</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_vacancyCreated" name="Vacancy Created">
      <bpmn:outgoing>SequenceFlow_reportVacancy</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Report vacancy -->
    <bpmn:task id="Task_reportVacancy" name="Report Vacancy">
      <bpmn:incoming>SequenceFlow_reportVacancy</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_advertisePost</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: Advertise post -->
    <bpmn:task id="Task_advertisePost" name="Advertise Post">
      <bpmn:incoming>SequenceFlow_advertisePost</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_applicantApply</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3: Applicant applies -->
    <bpmn:task id="Task_applyForPost" name="Apply for Post">
      <bpmn:incoming>SequenceFlow_applicantApply</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_checkApplication</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 4: Check application -->
    <bpmn:task id="Task_checkApplication" name="Check Application">
      <bpmn:incoming>SequenceFlow_checkApplication</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_concludeContract</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 5: Conclude contract -->
    <bpmn:task id="Task_concludeContract" name="Conclude Employment Contract">
      <bpmn:incoming>SequenceFlow_concludeContract</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_postFilled</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_postFilled" name="Post is Filled">
      <bpmn:incoming>SequenceFlow_postFilled</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_reportVacancy" sourceRef="StartEvent_vacancyCreated" targetRef="Task_reportVacancy"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_advertisePost" name="Advertise Post" sourceRef="Task_reportVacancy" targetRef="Task_advertisePost"/>

    <bpmn:sequenceFlow id="SequenceFlow_applicantApply" name="Applicants Apply" sourceRef="Task_advertisePost" targetRef="Task_applyForPost"/>

    <bpmn:sequenceFlow id="SequenceFlow_checkApplication" name="Check Application" sourceRef="Task_applyForPost" targetRef="Task_checkApplication"/>

    <bpmn:sequenceFlow id="SequenceFlow_concludeContract" name="Conclude Contract" sourceRef="Task_checkApplication" targetRef="Task_concludeContract"/>

    <bpmn:sequenceFlow id="SequenceFlow_postFilled" name="Post Filled" sourceRef="Task_concludeContract" targetRef="EndEvent_postFilled"/>
  </bpmn:process>
</bpmn:definitions>