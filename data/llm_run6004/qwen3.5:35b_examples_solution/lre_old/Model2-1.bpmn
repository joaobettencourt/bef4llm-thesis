<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ServiceDegradationProcess">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_CS" name="Customer Service (TELECO)" processRef="Pool_CS"/>
    <bpmn:participant id="Participant_SM" name="Service Management" processRef="Pool_SM"/>
    <bpmn:participant id="Participant_RP" name="Resource Provisioning" processRef="Pool_RP"/>
    <bpmn:participant id="Participant_Billing" name="Billing &amp; Collections" processRef="Pool_Billing"/>
  </bpmn:collaboration>

  <!-- Pool: Customer Service -->
  <bpmn:process id="Pool_CS" isExecutable="false">
    <bpmn:startEvent id="StartCS_DegradedService" name="Customer perceives degraded service">
      <bpmn:outgoing>Flow_CS_EnterReport</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_CS_EnterReport" name="Enter problem report into system T">
      <bpmn:incoming>Flow_CS_EnterReport</bpmn:incoming>
      <bpmn:outgoing>Flow_CS_CompareSLA</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_CS_SLAAnalysis" name="Compare problem report with customer SLA">
      <bpmn:incoming>Flow_CS_CompareSLA</bpmn:incoming>
      <bpmn:outgoing>Flow_CS_DetermineMeasures</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_CS_Measures" name="Determine counter measures and priorities">
      <bpmn:incoming>Flow_CS_DetermineMeasures</bpmn:incoming>
      <bpmn:outgoing>Flow_CS_SignificanceCheck</bpmn:outgoing>
    </bpmn:task>

    <bpmn:serviceTask id="ServiceCS_CustomerSignificance" name="Determine significance of customer">
      <bpmn:incoming>Flow_CS_SignificanceCheck</bpmn:incoming>
      <bpmn:outgoing>Gateway_CS_PremiumCustomer</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_CS_Premium" name="Is customer premium?">
      <bpmn:incoming>Flow_CS_SignificanceCheck</bpmn:incoming>
      <bpmn:outgoing>Flow_CS_LinkExtraProcess</bpmn:outgoing>
      <bpmn:outgoing>Flow_CS_AffectMeasuresLoop</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="EndCS_PremiumLink" name="Link to extra problem fix process">
      <bpmn:incoming>Flow_CS_LinkExtraProcess</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:exclusiveGateway id="Gateway_CS_AffectMeasures" name="Significance affect measures?">
      <bpmn:incoming>Flow_CS_SignificanceCheck</bpmn:incoming> <!-- Simplified logic for flow continuity -->
      <bpmn:outgoing>Flow_CS_RePrioritize</bpmn:outgoing>
      <bpmn:outgoing>Flow_CS_ContinueReport</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Loop back to Determine Measures -->
    <bpmn:sequenceFlow id="Flow_CS_RePrioritize" name="Yes - Re-prioritize" sourceRef="Gateway_CS_AffectMeasures" targetRef="Task_CS_Measures"/>

    <bpmn:task id="Task_CS_CreateReport" name="Create detailed problem report">
      <bpmn:incoming>Flow_CS_ContinueReport</bpmn:incoming>
      <bpmn:outgoing>MessageCS_SendToSM_Report</bpmn:outgoing> <!-- Message Flow -->
    </bpmn:task>

    <bpmn:endEvent id="EndCS_Processed" name="Process Ended">
       <!-- Logic handled via parallel split at end of process flow in text description -->
    </bpmn:endEvent>

    <!-- Final Parallel Split for CS End Activities -->
    <bpmn:parallelGateway id="Parallel_CS_EndActivities" name="End Activities Start">
      <bpmn:incoming>FlowCS_ReceiveInput</bpmn:incoming>
      <bpmn:outgoing>FlowCS_CreateReportTask</bpmn:outgoing>
      <bpmn:outgoing>FlowCS_SendReportTask</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:task id="Task_CS_CreateFinalReport" name="Create report for customer">
       <bpmn:incoming>FlowCS_CreateReportTask</bpmn:incoming>
       <bpmn:outgoing>FlowCS_SendToCustomer</bpmn:outgoing>
    </bpmn:task>

     <!-- Note: To satisfy "After all three activities are completed", we model 3 parallel tasks merging -->
    <bpmn:parallelGateway id="Parallel_CS_Merge" name="End Activities Merge">
      <bpmn:incoming>FlowCS_SendToCustomer</bpmn:incoming>
      <bpmn:incoming>FlowCS_RebateTask</bpmn:incoming> <!-- Rebate Task -->
    </bpmn:parallelGateway>

     <bpmn:endEvent id="EndCS_Final" name="Process Ended within Customer Service">
       <bpmn:incoming>Parallel_CS_Merge</bpmn:outgoing> 
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>