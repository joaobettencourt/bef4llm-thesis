<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                 xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" 
                 xmlns:di="http://www.omg.org/spec/DD/20100524/DI" 
                 xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" 
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
                 id="Definitions_dismissalProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_0dismissalProc">
    <bpmn:participant id="Participant_MSPN" name="MSPN" processRef="Pool_MSPN"/>
    <bpmn:participant id="Participant_MSPO" name="MSPO" processRef="Pool_MSPO"/>
  </bpmn:collaboration>

  <bpmn:message id="Message_dismissalSent">
    <bpmn:name>Dismissal Notification</bpmn:name>
  </bpmn:message>

  <bpmn:process id="Pool_MSPN" isExecutable="false">
    <bpmn:startEvent id="StartNoneEvent_dismissalInitiate">
      <bpmn:outgoing>SequenceFlow_initiateDismissal</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_conductDismissal" name="Conduct dismissal">
      <bpmn:incoming>SequenceFlow_initiateDismissal</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_sendToMSPO</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndNoneEvent_MSPNComplete">
      <bpmn:incoming>SequenceFlow_completeProcess</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:intermediateThrowEvent id="IntermediateThrowEvent_sendDismissal" name="">
      <bpmn:messageRef>Message_dismissalSent</bpmn:messageRef>
      <bpmn:outgoing>SequenceFlow_completeProcess</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <bpmn:sequenceFlow id="SequenceFlow_initiateDismissal" sourceRef="StartNoneEvent_dismissalInitiate" targetRef="Task_conductDismissal"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_sendToMSPO" name="" sourceRef="Task_conductDismissal" targetRef="IntermediateThrowEvent_sendDismissal">
      <bpmn:name>Send to MSPO</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_completeProcess" name="" sourceRef="IntermediateThrowEvent_sendDismissal" targetRef="EndNoneEvent_MSPNComplete"/>
  </bpmn:process>

  <bpmn:messageFlow id="MessageFlow_dismissalSent" sourceRef="IntermediateThrowEvent_sendDismissal" targetRef="StartMessageEvent_receiveDismissal">
    <bpmn:name>Send Dismissal</bpmn:name>
  </bpmn:messageFlow>

  <bpmn:process id="Pool_MSPO" isExecutable="false">
    <bpmn:startEvent id="StartMessageEvent_receiveDismissal">
      <bpmn:messageRef>Message_dismissalSent</bpmn:messageRef>
      <bpmn:outgoing>SequenceFlow_reviewDismissal</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_ReviewDismissal" name="Review dismissal">
      <bpmn:incoming>SequenceFlow_reviewDismissal</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_decisionGateway</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndNoneEvent_MSPOReject">
      <bpmn:incoming>SequenceFlow_rejectDismissalComplete</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndNoneEvent_MSPOConfirm">
      <bpmn:incoming>SequenceFlow_confirmDismissalComplete</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:exclusiveGateway id="ExclusiveGateway_dismissalDecision" name="">
      <bpmn:name>MSPO Decision</bpmn:name>
      <bpmn:incoming>SequenceFlow_decisionGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_rejectDismissalPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_confirmDismissalPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_RejectDismissal" name="">
      <bpmn:name>MSPO Rejects Dismissal</bpmn:name>
      <bpmn:incoming>SequenceFlow_rejectDismissalPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_rejectDismissalComplete</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_ConfirmDismissal" name="">
      <bpmn:name>MSPO Confirms Dismissal</bpmn:name>
      <bpmn:incoming>SequenceFlow_confirmDismissalPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_confirmDismissalComplete</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_reviewDismissal" sourceRef="StartMessageEvent_receiveDismissal" targetRef="Task_ReviewDismissal"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_decisionGateway" name="" sourceRef="Task_ReviewDismissal" targetRef="ExclusiveGateway_dismissalDecision">
      <bpmn:name>Proceed to Decision</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_rejectDismissalPath" name="" sourceRef="ExclusiveGateway_dismissalDecision" targetRef="Task_RejectDismissal">
      <bpmn:name>MSPO Rejects</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_confirmDismissalPath" name="" sourceRef="ExclusiveGateway_dismissalDecision" targetRef="Task_ConfirmDismissal">
      <bpmn:name>MSPO Confirms</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_rejectDismissalComplete" name="" sourceRef="Task_RejectDismissal" targetRef="EndNoneEvent_MSPOReject"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_confirmDismissalComplete" name="" sourceRef="Task_ConfirmDismissal" targetRef="EndNoneEvent_MSPOConfirm"/>
  </bpmn:process>

</bpmn:definitions>