<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_abc123xyz" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_customerAcquisition">
    <bpmn:participant id="Participant_mainProcess" name="Customer Acquisition Process" processRef="Process_acquisition"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_acquisition" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_marketing" name="Marketing">
        <bpmn:flowNodeRef>Task_buyData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_visitExhibition</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_contactDetails</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_callCenter" name="Call Center Employee">
        <bpmn:flowNodeRef>Task_determineContactPerson</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_interestCheck</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_salesRep" name="Sales Representative">
        <bpmn:flowNodeRef>Task_givePresentation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_waitForResponse</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_preSales" name="Pre-Sales Employee">
        <bpmn:flowNodeRef>Task_giveTechnicalPresentation</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_headDev" name="Head of Development">
        <bpmn:flowNodeRef>Task_acquireCustomerPersonal</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_contactDetails" name="Determine Contact Details of Potential Customer">
      <bpmn:outgoing>SequenceFlow_startToGateway</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Gateway for different contact detail methods -->
    <bpmn:exclusiveGateway id="Gateway_contactMethods" name="Contact Method Selection">
      <bpmn:incoming>SequenceFlow_startToGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_buyDataPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_exhibitionPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Marketing Tasks -->
    <bpmn:task id="Task_buyData" name="Buy Data for Cold Calls">
      <bpmn:incoming>SequenceFlow_buyDataPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_dataToCallCenter</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_visitExhibition" name="Participate in Exhibitions">
      <bpmn:incoming>SequenceFlow_exhibitionPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_exhibitionToCallCenter</bpmn:outgoing>
    </bpmn:task>

    <!-- Call Center Tasks -->
    <bpmn:task id="Task_determineContactPerson" name="Determine Contact Person">
      <bpmn:name>Determine Contact Person &amp; Budget</bpmn:name>
      <bpmn:incoming>SequenceFlow_dataToCallCenter</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_exhibitionToCallCenter</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_checkInterestPath</bpmn:outgoing>
    </bpmn:task>

    <!-- Interest Check Gateway -->
    <bpmn:exclusiveGateway id="Gateway_interestCheck" name="Customer Interested?">
      <bpmn:incoming>SequenceFlow_checkInterestPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_notInterestedHugeBudget</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_stillNotInterested</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Head of Development Task -->
    <bpmn:task id="Task_acquireCustomerPersonal" name="Head Acquires Customer">
      <bpmn:name>Acquire Customer Personally (Huge Budget)</bpmn:name>
      <bpmn:incoming>SequenceFlow_notInterestedHugeBudget</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_acquiredToPresentation</bpmn:outgoing>
    </bpmn:task>

    <!-- Presentation Gateway -->
    <bpmn:exclusiveGateway id="Gateway_presentationType" name="Presentation Type?">
      <bpmn:incoming>SequenceFlow_acquiredToPresentation</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_salesRepPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_preSalesPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sales Presentation Tasks -->
    <bpmn:task id="Task_givePresentation" name="Give Online Presentation">
      <bpmn:name>Sales Representative Presentation</bpmn:name>
      <bpmn:incoming>SequenceFlow_salesRepPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_toWaitEvent</bpmn:outgoing>
    </bpmn:task>

    <!-- Technical Presentation Task -->
    <bpmn:task id="Task_giveTechnicalPresentation" name="Give Technical Online Presentation">
      <bpmn:name>Pre-Sales Employee Technical Presentation</bpmn:name>
      <bpmn:incoming>SequenceFlow_preSalesPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_toWaitEventTech</bpmn:outgoing>
    </bpmn:task>

    <!-- Wait for Response Gateway -->
    <bpmn:eventBasedGateway id="Gateway_waitForResponse" name="Waiting Period (2 Weeks)">
      <bpmn:incoming>SequenceFlow_toWaitEvent</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_customerContactedPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_timeoutPath</bpmn:outgoing>
    </bpmn:eventBasedGateway>

    <!-- Intermediate Catch Events -->
    <bpmn:intermediateCatchEvent id="CatchEvent_customerContacted" name="Customer Contacts Us Back">
      <bpmn:incoming>SequenceFlow_customerContactedPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_toQuotation</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Follow-up Call Task -->
    <bpmn:task id="Task_followUpCall" name="Sales Representative Calls Customer">
      <bpmn:name>Follow-Up Call After 2 Weeks</bpmn:name>
      <bpmn:incoming>SequenceFlow_timeoutPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_toQuotationAfterCall</bpmn:outgoing>
    </bpmn:task>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_quotationCreated" name="Create Quotation - Process Complete">
      <bpmn:incoming>SequenceFlow_toQuotation</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_toQuotationAfterCall</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_startToGateway" sourceRef="StartEvent_contactDetails" targetRef="Gateway_contactMethods"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_buyDataPath" name="Buy Data" sourceRef="Gateway_contactMethods" targetRef="Task_buyData"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_exhibitionPath" name="Exhibitions" sourceRef="Gateway_contactMethods" targetRef="Task_visitExhibition"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_dataToCallCenter" sourceRef="Task_buyData" targetRef="Task_determineContactPerson"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_exhibitionToCallCenter" name="From Exhibition Contacts" sourceRef="Task_visitExhibition" targetRef="Task_determineContactPerson"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_checkInterestPath" sourceRef="Task_determineContactPerson" targetRef="Gateway_interestCheck"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_notInterestedHugeBudget" name="Not Interested BUT Huge Budget" sourceRef="Gateway_interestCheck" targetRef="Task_acquireCustomerPersonal"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_stillNotInterested" name="Leave Customer Alone" sourceRef="Gateway_interestCheck" targetRef="EndEvent_quotationCreated">
      <bpmn:name>Not Interested (Small/Medium Budget)</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_acquiredToPresentation" name="Customer Acquired by Head of Dev" sourceRef="Task_acquireCustomerPersonal" targetRef="Gateway_presentationType"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_salesRepPath" name="Standard Presentation" sourceRef="Gateway_presentationType" targetRef="Task_givePresentation"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_preSalesPath" name="Technical Presentation Required" sourceRef="Gateway_presentationType" targetRef="Task_giveTechnicalPresentation"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_toWaitEvent" sourceRef="Task_givePresentation" targetRef="Gateway_waitForResponse"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_toWaitEventTech" name="After Technical Presentation" sourceRef="Task_giveTechnicalPresentation" targetRef="Gateway_waitForResponse"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_customerContactedPath" sourceRef="Gateway_waitForResponse" targetRef="CatchEvent_customerContacted"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_timeoutPath" name="No Contact After 2 Weeks" sourceRef="Gateway_waitForResponse" targetRef="Task_followUpCall"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_toQuotationAfterCall" sourceRef="Task_followUpCall" targetRef="EndEvent_quotationCreated"/>

  </bpmn:process>
</bpmn:definitions>