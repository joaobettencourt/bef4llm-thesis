<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_masterDataChange" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_0masterdatachange">
    <bpmn:messageFlow id="MessageFlow_EC_INQ" sourceRef="Task_EC_notifyINQ" targetRef="IntermediateCatchEvent_INQ_receive"/>
    <bpmn:messageFlow id="MessageFlow_INQ_IP" sourceRef="Task_INQ_notifyIP" targetRef="StartMessageEvent_IP_received"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_EC_masterDataChange">
    <bpmn:startEvent id="StartEC_1" name="Master Data Change Request Initiated">
      <bpmn:outgoing>SequenceFlow_EC_to_INQ</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_EC_notifyINQ" name="Tell INQ about master data change">
      <bpmn:incoming>SequenceFlow_EC_to_INQ</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EC_end</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEC_1" name="INQ Notified">
      <bpmn:incoming>SequenceFlow_EC_end</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow_EC_to_INQ" sourceRef="StartEC_1" targetRef="Task_EC_notifyINQ"/>
    <bpmn:sequenceFlow id="SequenceFlow_EC_end" sourceRef="Task_EC_notifyINQ" targetRef="EndEC_1"/>
  </bpmn:process>

  <bpmn:process id="Process_INQ_masterDataChange">
    <bpmn:startEvent id="StartMessageEvent_INQ_receive" name="Receive Change Notification from EC">
      <bpmn:outgoing>SequenceFlow_INQ_to_IP</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_INQ_notifyIP" name="Notify IP of the change">
      <bpmn:incoming>SequenceFlow_INQ_to_IP</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_INQ_end</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndINQ_1" name="IP Notified">
      <bpmn:incoming>SequenceFlow_INQ_end</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow_INQ_to_IP" sourceRef="StartMessageEvent_INQ_receive" targetRef="Task_INQ_notifyIP"/>
    <bpmn:sequenceFlow id="SequenceFlow_INQ_end" sourceRef="Task_INQ_notifyIP" targetRef="EndINQ_1"/>
  </bpmn:process>

  <bpmn:process id="Process_IP_masterDataChange">
    <bpmn:startEvent id="StartMessageEvent_IP_received" name="Receive Notification from INQ">
      <bpmn:outgoing>SequenceFlow_IP_check</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_IP_checkChange" name="Check if master data can be changed at desired time">
      <bpmn:incoming>SequenceFlow_IP_check</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_IP_decision</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="ExclusiveGateway_IP_decision" name="Can Change Be Made?">
      <bpmn:incoming>SequenceFlow_IP_check</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_IP_confirm</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_IP_reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_IP_confirm" name="Confirm changes of INQ">
      <bpmn:incoming>SequenceFlow_IP_confirm</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_IP_endConfirmed</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndIP_1" name="Changes Confirmed">
      <bpmn:incoming>SequenceFlow_IP_endConfirmed</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:task id="Task_IP_reject" name="Reject changes of INQ">
      <bpmn:incoming>SequenceFlow_IP_reject</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_IP_endRejected</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndIP_2" name="Changes Rejected">
      <bpmn:incoming>SequenceFlow_IP_endRejected</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow_IP_check" sourceRef="StartMessageEvent_IP_received" targetRef="Task_IP_checkChange"/>
    <bpmn:sequenceFlow id="SequenceFlow_IP_decision" name="Check Result" sourceRef="Task_IP_checkChange" targetRef="ExclusiveGateway_IP_decision">
      <bpmn:name>Can change be made at desired time?</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_IP_confirm" name="Yes - Change Possible" sourceRef="ExclusiveGateway_IP_decision" targetRef="Task_IP_confirm">
      <bpmn:name>Can change be made at desired time?</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_IP_reject" name="No - Change Not Possible" sourceRef="ExclusiveGateway_IP_decision" targetRef="Task_IP_reject">
      <bpmn:name>Can change be made at desired time?</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_IP_endConfirmed" sourceRef="Task_IP_confirm" targetRef="EndIP_1"/>
    <bpmn:sequenceFlow id="SequenceFlow_IP_endRejected" sourceRef="Task_IP_reject" targetRef="EndIP_2"/>
  </bpmn:process>

  <!-- Participants -->
  <bpmn:participant id="Participant_EC" name="EC (Employee/Client)" processRef="Process_EC_masterDataChange"/>
  <bpmn:participant id="Participant_INQ" name="INQ (Inquiry System)" processRef="Process_INQ_masterDataChange"/>
  <bpmn:participant id="Participant_IP" name="IP (Information Processor)" processRef="Process_IP_masterDataChange"/>

</bpmn:definitions>