<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_DesignCycle_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_DesignProcess">
    <bpmn:participant id="Participant_MainDesignProc" name="Product Design Process" processRef="Process_DesignCycle"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_DesignCycle" isExecutable="false">
    
    <!-- Lane Set for Departments -->
    <bpmn:laneSet id="LaneSet_Departments">
      <bpmn:lane id="Lane_ElectricalDesign" name="Electrical Design Department">
        <bpmn:flowNodeRef>Task_ElecReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DecisionElec</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PhysicalDesign" name="Physical Design Department">
        <bpmn:flowNodeRef>Task_PhyReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DecisionPhys</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_LocateDesigns" name="Locate and distribute designs">
      <bpmn:outgoing>SequenceFlow_Initiate</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Locate Designs -->
    <bpmn:task id="Task_LocateDesigns" name="Locate and distribute relevant designs">
      <bpmn:incoming>SequenceFlow_Initiate</bpmn:outgoing>
      <bpmn:incoming>SequenceFlow_RestartCycle</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SplitParallel</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway Split -->
    <bpmn:parallelGateway id="Gateway_ParallelSplit">
      <bpmn:incoming>SequenceFlow_SplitParallel</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ElectricalPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PhysicalPath</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Electrical Path -->
    
    <!-- Task 2a: Review Designs (Electrical) -->
    <bpmn:task id="Task_ElecReview" name="Review existing electrical designs">
      <bpmn:incoming>SequenceFlow_RestartElec</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_UpdatePlanElec</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3a: Update Design (Electrical) -->
    <bpmn:task id="Task_ElecUpdate" name="Create revised electrical design">
      <bpmn:incoming>SequenceFlow_UpdatePlanElec</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_TestDesignElec</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 4a: Test Design (Electrical) -->
    <bpmn:task id="Task_ElecTest" name="Test electrical design">
      <bpmn:incoming>SequenceFlow_TestDesignElec</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_DecisionElecPass</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 5a: Decision Electrical -->
    <bpmn:exclusiveGateway id="Gateway_DecisionElec" name="Design OK?">
      <bpmn:incoming>SequenceFlow_DecisionElecPass</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_FailElectricalLoop</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PassElectricalSignal</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Signal Throw Event (Success) -->
    <bpmn:intermediateThrowEvent id="IntermediateElecReady" name="New electrical design">
      <bpmn:incoming>SequenceFlow_PassElectricalSignal</bpmn:outgoing>
      <bpmn:signalEventDefinition />
    </bpmn:intermediateThrowEvent>

    <!-- Boundary Event (Interruption) Electrical -->
    <bpmn:boundaryEvent id="BoundaryElecInterrupt" attachedToRef="Task_ElecUpdate">
      <bpmn:outgoing>SequenceFlow_InterruptElectrical</bpmn:outgoing>
      <bpmn:signalEventDefinition />
    </bpmn:boundaryEvent>

    <!-- Physical Path -->

    <!-- Task 2b: Review Designs (Physical) -->
    <bpmn:task id="Task_PhyReview" name="Review existing physical designs">
      <bpmn:incoming>SequenceFlow_RestartPhys</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_UpdatePlanPhys</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3b: Update Design (Physical) -->
    <bpmn:task id="Task_PhyUpdate" name="Create revised physical design">
      <bpmn:incoming>SequenceFlow_UpdatePlanPhys</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_TestDesignPhys</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 4b: Test Design (Physical) -->
    <bpmn:task id="Task_PhyTest" name="Test physical design">
      <bpmn:incoming>SequenceFlow_TestDesignPhys</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_DecisionPhysPass</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 5b: Decision Physical -->
    <bpmn:exclusiveGateway id="Gateway_DecisionPhys" name="Design OK?">
      <bpmn:incoming>SequenceFlow_DecisionPhysPass</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_FailPhysicalLoop</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_PassPhysicalSignal</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Signal Throw Event (Success) -->
    <bpmn:intermediateThrowEvent id="IntermediatePhysReady" name="New physical design">
      <bpmn:incoming>SequenceFlow_PassPhysicalSignal</bpmn:outgoing>
      <bpmn:signalEventDefinition />
    </bpmn:intermediateThrowEvent>

    <!-- Boundary Event (Interruption) Physical -->
    <bpmn:boundaryEvent id="BoundaryPhysInterrupt" attachedToRef="Task_PhyUpdate">
      <bpmn:outgoing>SequenceFlow_InterruptPhysical</bpmn:outgoing>
      <bpmn:signalEventDefinition />
    </bpmn:boundaryEvent>

    <!-- Synchronization Gateway -->
    <bpmn:parallelGateway id="Gateway_Sync">
      <bpmn:incoming>SequenceFlow_ElectricalSync</bpmn:outgoing>
      <bpmn:incoming>SequenceFlow_PhysicalSync</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CombineDesigns</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Combined Task -->
    <bpmn:task id="Task_CombineAndTest" name="Combine and test designs">
      <bpmn:incoming>SequenceFlow_CombineDesigns</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_DecisionCombinedOK</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 6: Decision Combined -->
    <bpmn:exclusiveGateway id="Gateway_CombinedDecision" name="Design OK?">
      <bpmn:incoming>SequenceFlow_DecisionCombinedOK</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_FailRestartCycle</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SuccessSendManufacturing</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Complete" name="Design Complete">
      <bpmn:incoming>SequenceFlow_SuccessSendManufacturing</bpmn:outgoing>
    </bpmn:endEvent>

    <!-- Sequence Flows - Initiation -->
    <bpmn:sequenceFlow id="SequenceFlow_Initiate" sourceRef="StartEvent_LocateDesigns" targetRef="Task_LocateDesigns"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_SplitParallel" name="Split to Departments" sourceRef="Task_LocateDesigns" targetRef="Gateway_ParallelSplit">
      <bpmn:name>Start Design Cycle</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Sequence Flows - Electrical Path -->
    <bpmn:sequenceFlow id="SequenceFlow_ElectricalPath" sourceRef="Gateway_ParallelSplit" targetRef="Task_ElecReview"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_UpdatePlanElec" name="Create Update Plan" sourceRef="Task_ElecReview" targetRef="Task_ElecUpdate">
      <bpmn:name>Design Review Complete</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_TestDesignElec" sourceRef="Task_ElecUpdate" targetRef="Task_ElecTest"/>
    
    <!-- Electrical Decision -->
    <bpmn:exclusiveGateway id="Gateway_DecisionElec" name="Design OK?">
       <bpmn:incoming>SequenceFlow_DecisionElecPass</bpmn:outgoing>
       <bpmn:outgoing>SequenceFlow_FailElectricalLoop</bpmn:outgoing>
       <bpmn:outgoing>SequenceFlow_PassElectricalSignal</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Correcting Sequence Flows for Electrical -->
    <bpmn:sequenceFlow id="SequenceFlow_DecisionElecPass" sourceRef="Task_ElecTest" targetRef="Gateway_DecisionElec"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_FailElectricalLoop" name="No - Review Again" sourceRef="Gateway_DecisionElec" targetRef="Task_ElecReview">
      <bpmn:name>Design Failed</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Electrical Success Signal -->
    <bpmn:intermediateThrowEvent id="IntermediateElecReady" name="New electrical design">
       <bpmn:incoming>SequenceFlow_PassElectricalSignal</bpmn:outgoing>
       <bpmn:signalEventDefinition />
    </bpmn:intermediateThrowEvent>

    <!-- Electrical Sync Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_ElectricalSync" sourceRef="IntermediateElecReady" targetRef="Gateway_Sync"/>

    <!-- Sequence Flows - Physical Path -->
    <bpmn:sequenceFlow id="SequenceFlow_PhysicalPath" sourceRef="Gateway_ParallelSplit" targetRef="Task_PhyReview"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_UpdatePlanPhys" name="Create Update Plan" sourceRef="Task_PhyReview" targetRef="Task_PhyUpdate">
      <bpmn:name>Design Review Complete</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_TestDesignPhys" sourceRef="Task_PhyUpdate" targetRef="Task_PhyTest"/>

    <!-- Physical Decision -->
    <bpmn:exclusiveGateway id="Gateway_DecisionPhys" name="Design OK?">
       <bpmn:incoming>SequenceFlow_DecisionPhysPass</bpmn:outgoing>
       <bpmn:outgoing>SequenceFlow_FailPhysicalLoop</bpmn:outgoing>
       <bpmn:outgoing>SequenceFlow_PassPhysicalSignal</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Correcting Sequence Flows for Physical -->
    <bpmn:sequenceFlow id="SequenceFlow_DecisionPhysPass" sourceRef="Task_PhyTest" targetRef="Gateway_DecisionPhys"/>

    <bpmn:sequenceFlow id="SequenceFlow_FailPhysicalLoop" name="No - Review Again" sourceRef="Gateway_DecisionPhys" targetRef="Task_PhyReview">
      <bpmn:name>Design Failed</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Physical Success Signal -->
    <bpmn:intermediateThrowEvent id="IntermediatePhysReady" name="New physical design">
       <bpmn:incoming>SequenceFlow_PassPhysicalSignal</bpmn:outgoing>
       <bpmn:signalEventDefinition />
    </bpmn:intermediateThrowEvent>

    <!-- Physical Sync Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_PhysicalSync" sourceRef="IntermediatePhysReady" targetRef="Gateway_Sync"/>

    <!-- Combined Design Logic -->
    <bpmn:sequenceFlow id="SequenceFlow_CombineDesigns" name="Both Designs Ready" sourceRef="Gateway_Sync" targetRef="Task_CombineAndTest">
      <bpmn:name>Sync Complete</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Combined Decision -->
    <bpmn:exclusiveGateway id="Gateway_CombinedDecision" name="Combined OK?">
       <bpmn:incoming>SequenceFlow_DecisionCombinedOK</bpmn:outgoing>
       <bpmn:outgoing>SequenceFlow_FailRestartCycle</bpmn:outgoing>
       <bpmn:outgoing>SequenceFlow_SuccessSendManufacturing</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Combined Decision Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_DecisionCombinedOK" sourceRef="Task_CombineAndTest" targetRef="Gateway_CombinedDecision"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_FailRestartCycle" name="No - Restart Cycle" sourceRef="Gateway_CombinedDecision" targetRef="StartEvent_LocateDesigns">
      <bpmn:name>Combined Design Failed</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Success Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_SuccessSendManufacturing" name="Yes - Send to Manufacturing" sourceRef="Gateway_CombinedDecision" targetRef="EndEvent_Complete">
      <bpmn:name>Design Complete</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Boundary Event Flows -->
    
    <!-- Electrical Interrupts (Catches Physical Signal) -->
    <bpmn:boundaryEvent id="BoundaryElecInterrupt" attachedToRef="Task_ElecUpdate">
      <bpmn:outgoing>SequenceFlow_InterruptElectrical</bpmn:outgoing>
      <bpmn:signalEventDefinition />
    </bpmn:boundaryEvent>

    <!-- Physical Interrupts (Catches Electrical Signal) -->
    <bpmn:boundaryEvent id="BoundaryPhysInterrupt" attachedToRef="Task_PhyUpdate">
      <bpmn:outgoing>SequenceFlow_InterruptPhysical</bpmn:outgoing>
      <bpmn:signalEventDefinition />
    </bpmn:boundaryEvent>

    <!-- Boundary Event Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_InterruptElectrical" sourceRef="BoundaryElecInterrupt" targetRef="Task_ElecReview"/>
    <bpmn:sequenceFlow id="SequenceFlow_InterruptPhysical" sourceRef="BoundaryPhysInterrupt" targetRef="Task_PhyReview"/>

  </bpmn:process>
</bpmn:definitions>