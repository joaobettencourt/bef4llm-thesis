<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_abc123xyz" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_orderProcess">
    <bpmn:participant id="Participant_mainOrderProc" name="Dispatch of goods Computer Hardware Shop" processRef="Process_dispatchGoods"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_dispatchGoods" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_secretary" name="Secretary">
        <bpmn:flowNodeRef>StartEvent_ship</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_clarifyShipment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_specialHandling</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_getOffers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_selectLogisticCompany</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_mergeSecretaryTasks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_writePackageLabel</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_logistics" name="Logistics">
        <bpmn:flowNodeRef>Gw_insuranceCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_insureParcel</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_warehouse" name="Warehouse">
        <bpmn:flowNodeRef>Gw_parallelStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_packageGoods</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_allReadyCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_preparePickup</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_ship" name="Ship goods">
      <bpmn:name>Ship goods</bpmn:name>
      <bpmn:outgoing>SequenceFlow_startToParallel</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Parallel Gateway to split processes -->
    <bpmn:parallelGateway id="Gw_parallelStart">
      <bpmn:name>Split Processes</bpmn:name>
      <bpmn:incoming>SequenceFlow_startToParallel</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_toSecretaryProcess</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_toWarehousePackage</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Secretary Process - Clarify Shipment Method -->
    <bpmn:task id="Task_clarifyShipment" name="Clarify shipment method">
      <bpmn:name>Clarify shipment method</bpmn:name>
      <bpmn:incoming>SequenceFlow_toSecretaryProcess</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_clarifyToSpecialHandlingCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway - Special Handling Decision -->
    <bpmn:exclusiveGateway id="Gw_specialHandling" name="Large amounts?">
      <bpmn:name>Large amounts?</bpmn:name>
      <bpmn:incoming>SequenceFlow_clarifyToSpecialHandlingCheck</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_largeAmountsPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_smallAmountsPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Large Amounts Path - Get Offers -->
    <bpmn:task id="Task_getOffers" name="Get 3 offers from logistic companies">
      <bpmn:name>Get 3 offers from logistic companies</bpmn:name>
      <bpmn:incoming>SequenceFlow_largeAmountsPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_getOffersToSelectCompany</bpmn:outgoing>
    </bpmn:task>

    <!-- Large Amounts Path - Select Company -->
    <bpmn:task id="Task_selectLogisticCompany" name="Select logistic company and place order">
      <bpmn:name>Select logistic company and place order</bpmn:name>
      <bpmn:incoming>SequenceFlow_getOffersToSelectCompany</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_selectToMergeSecretaryTasks</bpmn:outgoing>
    </bpmn:task>

    <!-- Small Amounts Path - Write Package Label -->
    <bpmn:task id="Task_writePackageLabel" name="Write package label">
      <bpmn:name>Write package label</bpmn:name>
      <bpmn:incoming>SequenceFlow_smallAmountsPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_labelToInsuranceCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Insurance Check Gateway -->
    <bpmn:exclusiveGateway id="Gw_insuranceCheck" name="Parcel insurance necessary?">
      <bpmn:name>Parcel insurance necessary?</bpmn:name>
      <bpmn:incoming>SequenceFlow_labelToInsuranceCheck</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_insuranceYesPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_insuranceNoPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Insurance Task -->
    <bpmn:task id="Task_insureParcel" name="Insure parcel">
      <bpmn:name>Insure parcel</bpmn:name>
      <bpmn:incoming>SequenceFlow_insuranceYesPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_insuredToMergeSecretaryTasks</bpmn:outgoing>
    </bpmn:task>

    <!-- Merge Secretary Tasks -->
    <bpmn:inclusiveGateway id="Gw_mergeSecretaryTasks">
      <bpmn:name>Merge Secretary Paths</bpmn:name>
      <bpmn:incoming>SequenceFlow_selectToMergeSecretaryTasks</bpmn:outgoing>
      <bpmn:incoming>SequenceFlow_insuredToMergeSecretaryTasks</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_mergeToAllReadyCheck</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Warehouse - Package Goods -->
    <bpmn:task id="Task_packageGoods" name="Package goods">
      <bpmn:name>Package goods</bpmn:name>
      <bpmn:incoming>SequenceFlow_toWarehousePackage</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_packedToAllReadyCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- All Ready Check Gateway -->
    <bpmn:exclusiveGateway id="Gw_allReadyCheck" name="Everything ready?">
      <bpmn:name>Everything ready?</bpmn:name>
      <bpmn:incoming>SequenceFlow_mergeToAllReadyCheck</bpmn:outgoing>
      <bpmn:incoming>SequenceFlow_packedToAllReadyCheck</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_allReadyToPreparePickup</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Prepare for Pickup -->
    <bpmn:task id="Task_preparePickup" name="Prepare for picking up goods">
      <bpmn:name>Prepare for picking up goods</bpmn:name>
      <bpmn:incoming>SequenceFlow_allReadyToPreparePickup</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_preparePickupToEndEvent</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_shipmentPrepared" name="Shipment prepared">
      <bpmn:name>Shipment prepared</bpmn:name>
      <bpmn:incoming>SequenceFlow_preparePickupToEndEvent</bpmn:outgoing>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_startToParallel" sourceRef="StartEvent_ship" targetRef="Gw_parallelStart">
      <bpmn:name>Ship goods</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_toSecretaryProcess" sourceRef="Gw_parallelStart" targetRef="Task_clarifyShipment">
      <bpmn:name>To Secretary Process</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_toWarehousePackage" sourceRef="Gw_parallelStart" targetRef="Task_packageGoods">
      <bpmn:name>To Warehouse Package</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_clarifyToSpecialHandlingCheck" sourceRef="Task_clarifyShipment" targetRef="Gw_specialHandling">
      <bpmn:name>To Special Handling Check</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_largeAmountsPath" name="Yes - Large amounts" sourceRef="Gw_specialHandling" targetRef="Task_getOffers">
      <bpmn:name>Large amounts</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_smallAmountsPath" name="No - Small amounts" sourceRef="Gw_specialHandling" targetRef="Task_writePackageLabel">
      <bpmn:name>Small amounts</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_getOffersToSelectCompany" sourceRef="Task_getOffers" targetRef="Task_selectLogisticCompany">
      <bpmn:name>To Select Company</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_labelToInsuranceCheck" sourceRef="Task_writePackageLabel" targetRef="Gw_insuranceCheck">
      <bpmn:name>To Insurance Check</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_selectToMergeSecretaryTasks" name="Large Amounts Path Complete" sourceRef="Task_selectLogisticCompany" targetRef="Gw_mergeSecretaryTasks">
      <bpmn:name>Select Company Done</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_insuranceYesPath" name="Insurance necessary - Yes" sourceRef="Gw_insuranceCheck" targetRef="Task_insureParcel">
      <bpmn:name>Necessary</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_insuredToMergeSecretaryTasks" name="Insurance Done or Not Needed - Merge to Secretary Tasks Complete" sourceRef="Task_insureParcel" targetRef="Gw_mergeSecretaryTasks">
      <bpmn:name>To Merge</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Sequence_flow_packedToAllReadyCheck" name="Package Goods Done - To All Ready Check" sourceRef="Task_packageGoods" targetRef="Gw_allReadyCheck">
      <bpmn:name>Packaging Complete</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Sequence_flow_mergeToAllReadyCheck" name="Secretary Tasks Done - To All Ready Check" sourceRef="Gw_mergeSecretaryTasks" targetRef="Gw_allReadyCheck">
      <bpmn:name>To Merge</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Sequence_flow_allReadyToPreparePickup" name="Everything Ready - To Prepare Pickup" sourceRef="Gw_allReadyCheck" targetRef="Task_preparePickup">
      <bpmn:name>All Tasks Complete</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Sequence_flow_preparePickupToEndEvent" name="Prepare Pickup - To End Event" sourceRef="Task_preparePickup" targetRef="EndEvent_shipmentPrepared">
      <bpmn:name>To Shipment Prepared</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>