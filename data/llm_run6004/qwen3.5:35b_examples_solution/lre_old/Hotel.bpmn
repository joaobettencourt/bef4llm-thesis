<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_roomService">
    <bpmn:participant id="Participant_hotelProcess" name="Hotel Room Service Process" processRef="Process_roomService"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_roomService" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_kitchen" name="Kitchen">
        <bpmn:flowNodeRef>Task_prepareMeal</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_sommelier" name="Sommelier">
        <bpmn:flowNodeRef>InclusiveGateway_alcoholicCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_beverageMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_fetchWine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_prepareAlcoholicBeverages</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_manager" name="Room-Service Manager">
        <bpmn:flowNodeRef>StartEvent_orderReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_takeDownOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_initialSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_alcoholicBeveragesOrdered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_submitOrderTicketToKitchen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_assignOrderToWaiter</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_waiter" name="Waiter">
        <bpmn:flowNodeRef>ParallelGateway_cartAndDrinksSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_nonAlcoholicBeveragesOrdered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_readyCart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_prepareNonAlcoholicDrinks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_allReadyMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_billingDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_deliverToGuestsRoom</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_returnToStation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_debitGuestAccount</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_orderReceived" name="Order Received">
      <bpmn:outgoing>SequenceFlow_takeDownOrder</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Manager Tasks and Gateways -->
    <bpmn:task id="Task_takeDownOrder" name="Take Down Order">
      <bpmn:incoming>SequenceFlow_takeDownOrder</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_initialSplit</bpmn:outgoing>
    </bpmn:task>

    <bpmn:parallelGateway id="ParallelGateway_initialSplit">
      <bpmn:incoming>SequenceFlow_initialSplit</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_submitOrderTicketToKitchen</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_alcoholicBeveragesCheck</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:task id="Task_submitOrderTicketToKitchen" name="Submit Order Ticket to Kitchen">
      <bpmn:incoming>SequenceFlow_submitOrderTicketToKitchen</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_kitchenPrepareMeal</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="ExclusiveGateway_alcoholicBeveragesOrdered" name="Alcoholic Beverages Ordered?">
      <bpmn:incoming>SequenceFlow_alcoholicBeveragesCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_giveOrderToSommelier</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_skipAlcoholicProcess</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_assignOrderToWaiter" name="Assign Order to Waiter">
      <bpmn:incoming>SequenceFlow_initialSplit</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_waiterCartAndDrinksSplit</bpmn:outgoing>
    </bpmn:task>

    <!-- Sommelier Tasks and Gateways -->
    <bpmn:inclusiveGateway id="InclusiveGateway_alcoholicCheck">
      <bpmn:incoming>SequenceFlow_giveOrderToSommelier</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_fetchWineTask</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_prepareAlcoholicBeveragesTask</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <bpmn:task id="Task_giveOrderToSommelier" name="Give Order to Sommelier">
      <bpmn:incoming>SequenceFlow_alcoholicBeveragesCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_sommelierTasksSplit</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_fetchWine" name="Fetch Wine from Cellar">
      <bpmn:incoming>SequenceFlow_fetchWineTask</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_sommelierMerge1</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_prepareAlcoholicBeverages" name="Prepare Alcoholic Beverages">
      <bpmn:incoming>SequenceFlow_prepareAlcoholicBeveragesTask</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_sommelierMerge2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:inclusiveGateway id="InclusiveGateway_beverageMerge">
      <bpmn:incoming>SequenceFlow_skipAlcoholicProcess</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_sommelierMerge1</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_sommelierMerge2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_alcoholicProcessComplete</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Waiter Tasks and Gateways -->
    <bpmn:parallelGateway id="ParallelGateway_cartAndDrinksSplit">
      <bpmn:incoming>SequenceFlow_waiterCartAndDrinksSplit</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_readyCartTask</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_nonAlcoholicBeveragesCheck</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:task id="Task_readyCart" name="Ready Cart">
      <bpmn:incoming>SequenceFlow_readyCartTask</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_cartComplete</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="ExclusiveGateway_nonAlcoholicBeveragesOrdered" name="Non-Alcoholic Drinks Ordered?">
      <bpmn:incoming>SequenceFlow_nonAlcoholicBeveragesCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_prepareNonAlcoholicDrinksTask</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_skipNonAlcoholicProcess</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_prepareNonAlcoholicDrinks" name="Prepare Non-Alcoholic Drinks">
      <bpmn:incoming>SequenceFlow_prepareNonAlcoholicDrinksTask</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_nonAlcoholicComplete</bpmn:outgoing>
    </bpmn:task>

    <!-- Merge Point for Delivery -->
    <bpmn:parallelGateway id="ParallelGateway_allReadyMerge">
      <bpmn:incoming>SequenceFlow_cartComplete</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_nonAlcoholicComplete</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_alcoholicProcessComplete</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_mealPreparedForDelivery</bpmn:incoming>
    </bpmn:parallelGateway>

    <!-- Delivery and Billing -->
    <bpmn:task id="Task_deliverToGuestsRoom" name="Deliver to Guest's Room">
      <bpmn:incoming>SequenceFlow_allReadyMerge</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_returnToStation</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_returnToStation" name="Return to Room-Service Station">
      <bpmn:incoming>SequenceFlow_returnToStation</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_billingDecisionPoint</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="ExclusiveGateway_billingDecision" name="Another Order?">
      <bpmn:incoming>SequenceFlow_billingDecisionPoint</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_debitGuestAccountTask</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="EndEvent_orderComplete" name="Order Complete">
      <bpmn:incoming>SequenceFlow_billingDecisionPoint</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_takeDownOrder" sourceRef="StartEvent_orderReceived" targetRef="Task_takeDownOrder"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_initialSplit" name="Initial Split" sourceRef="ParallelGateway_initialSplit" targetRef="Task_submitOrderTicketToKitchen"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_alcoholicBeveragesCheck" name="Alcoholic Check" sourceRef="ParallelGateway_initialSplit" targetRef="ExclusiveGateway_alcoholicBeveragesOrdered"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_giveOrderToSommelier" name="Yes - Alcoholic Ordered" sourceRef="ExclusiveGateway_alcoholicBeveragesOrdered" targetRef="Task_giveOrderToSommelier"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_skipAlcoholicProcess" name="No - Skip Sommelier" sourceRef="ExclusiveGateway_alcoholicBeveragesOrdered" targetRef="InclusiveGateway_beverageMerge">
      <bpmn:name>80% Include Alcoholic</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_sommelierTasksSplit" name="Sommelier Tasks Split" sourceRef="Task_giveOrderToSommelier" targetRef="InclusiveGateway_alcoholicCheck"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_fetchWineTask" name="Fetch Wine Task" sourceRef="InclusiveGateway_alcoholicCheck" targetRef="Task_fetchWine"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_prepareAlcoholicBeveragesTask" name="Prepare Alcoholic Beverages Task" sourceRef="InclusiveGateway_alcoholicCheck" targetRef="Task_prepareAlcoholicBeverages"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_sommelierMerge1" name="Wine Fetched" sourceRef="Task_fetchWine" targetRef="InclusiveGateway_beverageMerge"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_sommelierMerge2" name="Beverages Prepared" sourceRef="Task_prepareAlcoholicBeverages" targetRef="InclusiveGateway_beverageMerge"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_alcoholicProcessComplete" name="Sommelier Complete" sourceRef="InclusiveGateway_beverageMerge" targetRef="ParallelGateway_allReadyMerge"/>

    <!-- Kitchen Flow -->
    <bpmn:task id="Task_prepareMeal" name="Prepare Meal">
      <bpmn:incoming>SequenceFlow_kitchenPrepareMeal</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_mealPreparedForDelivery</bpmn:outgoing>
    </bpmn:task>

    <!-- Waiter Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_waiterCartAndDrinksSplit" name="Waiter Split" sourceRef="Task_assignOrderToWaiter" targetRef="ParallelGateway_cartAndDrinksSplit"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_readyCartTask" name="Ready Cart Task" sourceRef="ParallelGateway_cartAndDrinksSplit" targetRef="Task_readyCart"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_nonAlcoholicBeveragesCheck" name="Non-Alcoholic Check" sourceRef="ParallelGateway_cartAndDrinksSplit" targetRef="ExclusiveGateway_nonAlcoholicBeveragesOrdered"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_prepareNonAlcoholicDrinksTask" name="Prepare Non-Alcoholic Drinks Task" sourceRef="ExclusiveGateway_nonAlcoholicBeveragesOrdered" targetRef="Task_prepareNonAlcoholicDrinks"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_skipNonAlcoholicProcess" name="Skip Non-Alcoholic Process" sourceRef="ExclusiveGateway_nonAlcoholicBeveragesOrdered" targetRef="ParallelGateway_allReadyMerge">
      <bpmn:name>Waiter Handles All Drinks</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Cart and Drink Completion -->
    <bpmn:sequenceFlow id="SequenceFlow_cartComplete" name="Cart Ready" sourceRef="Task_readyCart" targetRef="ParallelGateway_allReadyMerge"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_nonAlcoholicComplete" name="Non-Alcoholic Drinks Complete" sourceRef="Task_prepareNonAlcoholicDrinks" targetRef="ParallelGateway_allReadyMerge"/>

    <!-- Delivery Flow -->
    <bpmn:task id="Task_debitGuestAccount" name="Debit Guest's Account">
      <bpmn:incoming>SequenceFlow_billingDecisionPoint</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_orderCompleteFinal</bpmn:outgoing>
    </bpmn:task>

    <!-- Merge All Ready -->
    <bpmn:sequenceFlow id="SequenceFlow_allReadyMerge" name="All Items Ready - Deliver to Guest's Room" sourceRef="ParallelGateway_allReadyMerge" targetRef="Task_deliverToGuestsRoom"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_returnToStation" name="Return to Station" sourceRef="Task_deliverToGuestsRoom" targetRef="Task_returnToStation"/>

    <!-- Billing Decision -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_billingDecision" name="Another Order?">
      <bpmn:incoming>SequenceFlow_billingDecisionPoint</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_debitGuestAccountTask</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Billing Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_returnToStation" name="Return to Room-Service Station" sourceRef="Task_deliverToGuestsRoom" targetRef="Task_returnToStation"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_billingDecisionPoint" name="Billing Decision Point" sourceRef="Task_returnToStation" targetRef="ExclusiveGateway_billingDecision">
      <bpmn:name>Waiter may wait if another order</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>