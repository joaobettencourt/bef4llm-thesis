<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_warrantProcess_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_WarrantPossession">
    <bpmn:participant id="Participant_SmallClaimsRegistry" name="Small Claims Registry Operations" processRef="Process_WarrantProcessing"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_WarrantProcessing" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_ClientServiceBackOffice" name="Client Service Back Office">
        <bpmn:flowNodeRef>StartEvent_RequestReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RetrieveSCTTFile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ForwardToPolice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateEvent_WaitingForReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RetrieveSCTFile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AttachNewDocument</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_FileReadyForHandover</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_MCInternalStaff" name="Other MC Internal Staff">
        <bpmn:flowNodeRef>Task_ReceivePhysicalFile</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_RequestReceived" name="Warrant Possession Request Received">
      <bpmn:outgoing>SequenceFlow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Retrieve SCTT File -->
    <bpmn:task id="Task_RetrieveSCTTFile" name="Retrieve SCTT File">
      <bpmn:incoming>SequenceFlow_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_02</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: Forward to Queensland Police -->
    <bpmn:task id="Task_ForwardToPolice" name="Forward SCT Warrant Possession to Queensland Police">
      <bpmn:incoming>SequenceFlow_02</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_03</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3: Store SCTT Physical File -->
    <bpmn:task id="Task_StoreSCTTPhysicalFile" name="Store SCTT Physical File (Awaiting Police Report)">
      <bpmn:incoming>SequenceFlow_03</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_04</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Event: Wait for Police Report -->
    <bpmn:startEvent id="StartEvent_PoliceReportReceived" name="Police Report Received">
      <bpmn:outgoing>SequenceFlow_05</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 4: Retrieve SCT File -->
    <bpmn:task id="Task_RetrieveSCTFile" name="Retrieve Respective SCT File">
      <bpmn:incoming>SequenceFlow_05</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_06</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 5: Attach New SCT Document -->
    <bpmn:task id="Task_AttachNewDocument" name="Attach New SCT Document">
      <bpmn:incoming>SequenceFlow_06</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_07</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 6: Store Expanded SCT Physical File -->
    <bpmn:task id="Task_StoreExpandedSCTFile" name="Store Expanded SCT Physical File">
      <bpmn:incoming>SequenceFlow_07</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_08</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 7: Receive by MC Internal Staff (Out of Scope) -->
    <bpmn:task id="Task_ReceivePhysicalFile" name="MC Internal Staff Receives Physical SCT File">
      <bpmn:incoming>SequenceFlow_08</bpmn:incoming>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_FileReadyForHandover" name="File Ready for Handover to MC Internal Staff">
      <bpmn:incoming>SequenceFlow_08</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_01" name="Request Received" sourceRef="StartEvent_RequestReceived" targetRef="Task_RetrieveSCTTFile"/>

    <bpmn:sequenceFlow id="SequenceFlow_02" sourceRef="Task_RetrieveSCTTFile" targetRef="Task_ForwardToPolice"/>

    <bpmn:sequenceFlow id="SequenceFlow_03" name="Forward to Police" sourceRef="Task_ForwardToPolice" targetRef="Task_StoreSCTTPhysicalFile"/>

    <!-- Connection between Store File and Wait for Report (implicit wait) -->
    <bpmn:sequenceFlow id="SequenceFlow_04" name="Awaiting Police Report" sourceRef="Task_StoreSCTTPhysicalFile" targetRef="StartEvent_PoliceReportReceived"/>

    <!-- Connection from Police Report to Retrieve SCT File -->
    <bpmn:sequenceFlow id="SequenceFlow_05" name="Police Report Received" sourceRef="StartEvent_PoliceReportReceived" targetRef="Task_RetrieveSCTFile"/>

    <!-- Connection from Retrieve to Attach -->
    <bpmn:sequenceFlow id="SequenceFlow_06" sourceRef="Task_RetrieveSCTFile" targetRef="Task_AttachNewDocument"/>

    <!-- Connection from Attach to Store Expanded File -->
    <bpmn:sequenceFlow id="SequenceFlow_07" name="Attach New SCT Document" sourceRef="Task_AttachNewDocument" targetRef="Task_StoreExpandedSCTFile"/>

    <!-- Connection from Store Expanded File to End Event -->
    <bpmn:sequenceFlow id="SequenceFlow_08" name="Store Expanded SCT Physical File" sourceRef="Task_StoreExpandedSCTFile" targetRef="EndEvent_FileReadyForHandover"/>

  </bpmn:process>
</bpmn:definitions>