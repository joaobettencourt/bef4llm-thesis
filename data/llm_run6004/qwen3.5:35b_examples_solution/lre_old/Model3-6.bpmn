<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_claimProcess_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_ClaimProcessing">
    <bpmn:participant id="Participant_MainPool" name="Claims Notification Process" processRef="Process_ClaimsNotification"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_ClaimsNotification" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_ReceiveClaim" name="Receive Claim">
      <bpmn:outgoing>SequenceFlow_CheckInsurance</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Check if claimant is insured -->
    <bpmn:task id="Task_CheckInsurance" name="Check Insurance Status">
      <bpmn:incoming>SequenceFlow_CheckInsurance</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InsuranceDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Insurance Decision -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_InsuranceCheck" name="Insured?">
      <bpmn:incoming>SequenceFlow_InsuranceDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RejectClaim</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_EvaluateSeverity</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Reject claim -->
    <bpmn:task id="Task_RejectClaim" name="Inform Claimant - Rejected">
      <bpmn:incoming>SequenceFlow_RejectClaim</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndRejected</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 1 -->
    <bpmn:endEvent id="EndEvent_ClaimRejected" name="Claim Rejected">
      <bpmn:incoming>SequenceFlow_EndRejected</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task: Evaluate severity -->
    <bpmn:task id="Task_EvaluateSeverity" name="Evaluate Claim Severity">
      <bpmn:incoming>SequenceFlow_EvaluateSeverity</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SeverityDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Simple vs Complex -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_ClaimType" name="Claim Type?">
      <bpmn:incoming>SequenceFlow_SeverityDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendSimpleForms</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SendComplexForms</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Send forms (simple) -->
    <bpmn:task id="Task_SendSimpleForms" name="Send Simple Forms">
      <bpmn:incoming>SequenceFlow_SendSimpleForms</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitForReturn1</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Send forms (complex) -->
    <bpmn:task id="Task_SendComplexForms" name="Send Complex Forms">
      <bpmn:incoming>SequenceFlow_SendComplexForms</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitForReturn2</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Check completeness -->
    <bpmn:task id="Task_CheckCompleteness" name="Check Forms Completeness">
      <bpmn:incoming>SequenceFlow_CompletenessIn1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CompletenessDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Completeness Decision -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_CompletenessCheck" name="Complete?">
      <bpmn:incoming>SequenceFlow_CompletenessDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RegisterClaim</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_InformUpdate</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Register claim -->
    <bpmn:task id="Task_RegisterClaim" name="Register in Claims Management System">
      <bpmn:incoming>SequenceFlow_RegisterClaim</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndCompleted</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 2 -->
    <bpmn:endEvent id="EndEvent_ProcessComplete" name="Claims Notification Process Complete">
      <bpmn:incoming>SequenceFlow_EndCompleted</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task: Inform to update forms -->
    <bpmn:task id="Task_InformUpdateForms" name="Inform Claimant - Update Forms">
      <bpmn:incoming>SequenceFlow_InformUpdate</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitForUpdatedReturn</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckInsurance" sourceRef="StartEvent_ReceiveClaim" targetRef="Task_CheckInsurance"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_InsuranceDecision" name="Check Insurance Status" sourceRef="Task_CheckInsurance" targetRef="ExclusiveGateway_InsuranceCheck">
      <bpmn:name>Insured?</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_RejectClaim" name="No - Not Insured" sourceRef="ExclusiveGateway_InsuranceCheck" targetRef="Task_RejectClaim"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_EndRejected" sourceRef="Task_RejectClaim" targetRef="EndEvent_ClaimRejected">
      <bpmn:name>Inform Claimant</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_EvaluateSeverity" name="Yes - Insured" sourceRef="ExclusiveGateway_InsuranceCheck" targetRef="Task_EvaluateSeverity"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_SeverityDecision" name="Evaluate Severity" sourceRef="Task_EvaluateSeverity" targetRef="ExclusiveGateway_ClaimType">
      <bpmn:name>Simple or Complex?</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_SendSimpleForms" name="Simple Claim" sourceRef="ExclusiveGateway_ClaimType" targetRef="Task_SendSimpleForms"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_SendComplexForms" name="Complex Claim" sourceRef="ExclusiveGateway_ClaimType" targetRef="Task_SendComplexForms"/>

    <!-- Merge after sending forms -->
    <bpmn:parallelGateway id="ParallelGateway_MergeAfterSend">
      <bpmn:incoming>SequenceFlow_WaitForReturn1</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_WaitForReturn2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CompletenessIn1</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:sequenceFlow id="SequenceFlow_WaitForReturn1" sourceRef="Task_SendSimpleForms" targetRef="ParallelGateway_MergeAfterSend"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_WaitForReturn2" name="Wait for Forms Return" sourceRef="Task_SendComplexForms" targetRef="ParallelGateway_MergeAfterSend">
      <bpmn:name>Wait for Forms Return</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_CompletenessIn1" name="Check Completeness" sourceRef="ParallelGateway_MergeAfterSend" targetRef="Task_CheckCompleteness"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_CompletenessDecision" name="Forms Returned - Check Completeness" sourceRef="Task_CheckCompleteness" targetRef="ExclusiveGateway_CompletenessCheck">
      <bpmn:name>Complete?</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_RegisterClaim" name="Yes - Complete" sourceRef="ExclusiveGateway_CompletenessCheck" targetRef="Task_RegisterClaim"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_EndCompleted" sourceRef="Task_RegisterClaim" targetRef="EndEvent_ProcessComplete">
      <bpmn:name>Register and End</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_InformUpdate" name="No - Incomplete" sourceRef="ExclusiveGateway_CompletenessCheck" targetRef="Task_InformUpdateForms"/>
    
    <!-- Loop back for updated forms -->
    <bpmn:parallelGateway id="ParallelGateway_MergeAfterUpdate">
      <bpmn:incoming>SequenceFlow_WaitForUpdatedReturn</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CompletenessIn2</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:sequenceFlow id="SequenceFlow_WaitForUpdatedReturn" name="Wait for Updated Forms Return" sourceRef="Task_InformUpdateForms" targetRef="ParallelGateway_MergeAfterUpdate"/>
    
    <!-- Loop back to completeness check -->
    <bpmn:sequenceFlow id="SequenceFlow_CompletenessIn2" name="Check Completeness Again" sourceRef="ParallelGateway_MergeAfterUpdate" targetRef="Task_CheckCompleteness">
      <bpmn:name>Re-check Forms</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>