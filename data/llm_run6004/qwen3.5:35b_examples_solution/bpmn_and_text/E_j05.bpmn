<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_WorkLiveAustria" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_0ygkg4f">
    <bpmn:participant id="Participant_SchengenVisa" name="Work and Live in Austria Process" processRef="Process_VisaApplication"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_VisaApplication" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Begin Visa Application Process">
      <bpmn:outgoing>SequenceFlow_StartToCheck</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Check Passport Validity -->
    <bpmn:userTask id="Task_CheckPassport" name="Check passport validity (10 years, 2 empty pages)">
      <bpmn:incoming>SequenceFlow_StartToCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PassportToGateway</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Exclusive Gateway for Stay Duration -->
    <bpmn:exclusiveGateway id="Gateway_StayDuration" name="How long will you stay?">
      <bpmn:incoming>SequenceFlow_PassportToGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ShortStay</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_MediumStay</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_LongStay</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Short Stay Path (&lt; 6 months) -->
    <bpmn:userTask id="Task_ShortVisa" name="Apply for Schengen Visa (Category C)">
      <bpmn:incoming>SequenceFlow_ShortStay</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_VisaToDocuments</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Medium Stay Path (6-24 months) -->
    <bpmn:userTask id="Task_MediumVisa" name="Apply for Residence Permit">
      <bpmn:incoming>SequenceFlow_MediumStay</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_VisaToDocuments</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Long Stay Path (&gt; 24 months) -->
    <bpmn:userTask id="Task_LongVisa" name="Apply for Rot-Weiss-Rot Card">
      <bpmn:incoming>SequenceFlow_LongStay</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_VisaToDocuments</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel Gateway for Accommodation and Bank Account -->
    <bpmn:parallelGateway id="Parallel_AccomBank" name="">
      <bpmn:incoming>SequenceFlow_ShortVisaToDocs</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_MediumVisaToDocs</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_LongVisaToDocs</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToAccommodation</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ToBankAccount</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Accommodation Task -->
    <bpmn:userTask id="Task_Accommodation" name="Organize accommodation">
      <bpmn:incoming>SequenceFlow_ToAccommodation</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AccToConverge</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Bank Account Task -->
    <bpmn:userTask id="Task_BankAccount" name="Open Austrian bank account">
      <bpmn:incoming>SequenceFlow_ToBankAccount</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BankToConverge</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Converging Gateway -->
    <bpmn:exclusiveGateway id="Gateway_Converge" name="">
      <bpmn:incoming>SequenceFlow_AccToConverge</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_BankToConverge</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConvergeToEnd</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_1" name="Visa Application Complete">
      <bpmn:incoming>SequenceFlow_ConvergeToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToCheck" sourceRef="StartEvent_1" targetRef="Task_CheckPassport"/>
    <bpmn:sequenceFlow id="SequenceFlow_PassportToGateway" name="" sourceRef="Task_CheckPassport" targetRef="Gateway_StayDuration"/>

    <!-- Gateway Outgoing Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_ShortStay" name="&lt; 6 months" sourceRef="Gateway_StayDuration" targetRef="Task_ShortVisa"/>
    <bpmn:sequenceFlow id="SequenceFlow_MediumStay" name="6-24 months" sourceRef="Gateway_StayDuration" targetRef="Task_MediumVisa"/>
    <bpmn:sequenceFlow id="SequenceFlow_LongStay" name="&gt; 24 months / Work in Austria" sourceRef="Gateway_StayDuration" targetRef="Task_LongVisa"/>

    <!-- Visa to Parallel Gateway -->
    <bpmn:sequenceFlow id="SequenceFlow_ShortVisaToDocs" name="" sourceRef="Task_ShortVisa" targetRef="Parallel_AccomBank"/>
    <bpmn:sequenceFlow id="SequenceFlow_MediumVisaToDocs" name="" sourceRef="Task_MediumVisa" targetRef="Parallel_AccomBank"/>
    <bpmn:sequenceFlow id="SequenceFlow_LongVisaToDocs" name="" sourceRef="Task_LongVisa" targetRef="Parallel_AccomBank"/>

    <!-- Parallel Gateway to Tasks -->
    <bpmn:sequenceFlow id="SequenceFlow_ToAccommodation" name="" sourceRef="Parallel_AccomBank" targetRef="Task_Accommodation"/>
    <bpmn:sequenceFlow id="SequenceFlow_ToBankAccount" name="" sourceRef="Parallel_AccomBank" targetRef="Task_BankAccount"/>

    <!-- Tasks to Converging Gateway -->
    <bpmn:sequenceFlow id="SequenceFlow_AccToConverge" name="" sourceRef="Task_Accommodation" targetRef="Gateway_Converge"/>
    <bpmn:sequenceFlow id="SequenceFlow_BankToConverge" name="" sourceRef="Task_BankAccount" targetRef="Gateway_Converge"/>

    <!-- Converging to End -->
    <bpmn:sequenceFlow id="SequenceFlow_ConvergeToEnd" name="" sourceRef="Gateway_Converge" targetRef="EndEvent_1"/>
  </bpmn:process>
</bpmn:definitions>