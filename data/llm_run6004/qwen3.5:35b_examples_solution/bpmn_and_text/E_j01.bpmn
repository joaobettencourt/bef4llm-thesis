<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_FindJob_01" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_FindJob" isExecutable="false">

    <!-- Start Event -->
    <bpmn:startEvent id="Start_Unemployed" name="Unemployed / New Cycle">
      <bpmn:outgoing>Flow_ApplyReport</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Application Phase Tasks -->
    <bpmn:task id="Task_WriteApplication" name="Write Job Application">
      <bpmn:incoming>Flow_ApplyReport</bpmn:incoming>
      <bpmn:outgoing>Flow_SendApp</bpmn:outgoing>
    </bpmn:task>

    <!-- Company Confirmation Task -->
    <bpmn:serviceTask id="Service_CompanyRating" name="Company Rates Application">
       <bpmn:incoming>Flow_SendApp</bpmn:incoming>
      <bpmn:outgoing>Gateway_InterviewCheck</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Reporting Task -->
    <bpmn:task id="Task_ReportApplication" name="Report Application to Authority">
       <bpmn:incoming>Flow_SendApp</bpmn:incoming>
      <bpmn:outgoing>Gateway_InterviewCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Interview Decision Gateway -->
    <bpmn:exclusiveGateway id="Gateway_Interview" name="Interview Successful?">
       <bpmn:incoming>Service_CompanyRating_Out</bpmn:incoming>
      <bpmn:outgoing>Flow_ProceedProbationYes</bpmn:outgoing> <!-- Yes -->
      <bpmn:outgoing>Loop_NewOffersNoInterview</bpmn:outgoing>  <!-- No -->
    </bpmn:exclusiveGateway>

    <!-- Probation Phase Start Event -->
    <bpmn:startEvent id="Start_ProbPhase" name="Probation Started">
       <bpmn:incoming>Flow_ProceedProbationYes</bpmn:outgoing>
      <bpmn:outgoing>Task_StartWork</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Timer Event for Probation -->
    <bpmn:intermediateCatchEvent id="Timer_ProbEnd" name="Probation Finished">
       <bpmn:incoming>Flow_ProceedProbationYes</bpmn:outgoing>
      <bpmn:outgoing>Task_RateCompanyFinal</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Rating Task -->
    <bpmn:task id="Task_RateCompany" name="Rate Company">
       <bpmn:incoming>Flow_ProceedProbationYes</bpmn:outgoing>
      <bpmn:outgoing>Gateway_PermanentCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Final Decision Gateway -->
    <bpmn:exclusiveGateway id="Gateway_Final" name="Permanent &amp; Rating Good?">
       <bpmn:incoming>Flow_ProceedProbationYes</bpmn:outgoing>
      <bpmn:outgoing>End_SuccessJob</bpmn:outgoing> <!-- Yes -->
      <bpmn:outgoing>Loop_NoReportReq</bpmn:outgoing> <!-- No (C or less) -->
    </bpmn:exclusiveGateway>

    <!-- End Events -->
    <bpmn:endEvent id="End_SuccessJob" name="Permanent Employment">
       <bpmn:incoming>Flow_ProceedProbationYes</bpmn:outgoing>
    </bpmn:endEvent>

    <bpmn:endEvent id="End_ContinueOffersNoReportReq" name="Receive Offers (No Report)">
       <bpmn:incoming>Loop_NoReportReq</bpmn:outgoing>
    </bpmn:endEvent>

     <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Seq_StartCycle" sourceRef="Start_Unemployed" targetRef="Task_WriteApplication"/>
    <bpmn:sequenceFlow id="Seq_SendApp" name="" sourceRef="Task_WriteApplication" targetRef="Service_CompanyRating"/>

     <!-- Interview Check -->
    <bpmn:exclusiveGateway id="GW_InterviewCheck2" name="Interview Successful?">
       <bpmn:incoming>Seq_SendApp</bpmn:outgoing>
      <bpmn:outgoing>Flow_ProceedProbationYes2</bpmn:outgoing> <!-- Yes -->