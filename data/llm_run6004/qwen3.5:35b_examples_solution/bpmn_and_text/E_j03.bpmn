<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_WorkAccident_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_WorkAccident">
    <bpmn:participant id="Participant_WorkAccidentProcess" name="Work Accident Reporting Process" processRef="Process_WorkAccident_001"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_WorkAccident_001" isExecutable="false">
    <bpmn:laneSet id="LaneSet_WorkAccident">
      <bpmn:lane id="Lane_Employee" name="Employee/Student">
        <bpmn:flowNodeRef>StartEvent_Incident</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ClassifyIncident</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ReportType</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Employer" name="Employer">
        <bpmn:flowNodeRef>Task_InformEmployee</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SeverityCheck</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Insurance" name="Accident Insurance Provider">
        <bpmn:flowNodeRef>Task_ReportToProvider</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_LabourInspectorate" name="Labour Inspectorate">
        <bpmn:flowNodeRef>Task_ReportFatalityInjury</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Directorate" name="Competent Directorate">
        <bpmn:flowNodeRef>Task_SchoolReportAccident</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_PrivateInsurance" name="Private Insurance Provider">
        <bpmn:flowNodeRef>Task_ReportToPrivateInsurer</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Incident" name="Incident Happens">
      <bpmn:outgoing>SequenceFlow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Classification Task -->
    <bpmn:task id="Task_ClassifyIncident" name="Classify Incident Type">
      <bpmn:incoming>SequenceFlow_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_02</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for Report Type -->
    <bpmn:exclusiveGateway id="Gateway_ReportType" name="Report Type?">
      <bpmn:incoming>SequenceFlow_02</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_03</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_04</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Employee Reporting -->
    <bpmn:task id="Task_InformEmployee" name="Inform Employer Immediately">
      <bpmn:incoming>SequenceFlow_03</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_05</bpmn:outgoing>
    </bpmn:task>

    <!-- Severity Check -->
    <bpmn:exclusiveGateway id="Gateway_SeverityCheck" name="Fatality/Serious Injury?">
      <bpmn:incoming>SequenceFlow_05</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_06</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_07</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Labour Inspectorate Reporting -->
    <bpmn:task id="Task_ReportFatalityInjury" name="Report to Labour Inspectorate">
      <bpmn:incoming>SequenceFlow_06</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_12</bpmn:outgoing>
    </bpmn:task>

    <!-- Insurance Provider Reporting -->
    <bpmn:exclusiveGateway id="Gateway_InjuryCheck" name="Unable to work 3+ days?">
      <bpmn:incoming>SequenceFlow_07</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_14</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Report to Insurance Provider -->
    <bpmn:task id="Task_ReportToProvider" name="Report to Accident Insurance Provider (within 5 days)">
      <bpmn:incoming>SequenceFlow_14</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_20</bpmn:outgoing>
    </bpmn:task>

    <!-- School/University Reporting -->
    <bpmn:exclusiveGateway id="Gateway_SchoolCheck" name="Student/Schoolchild?">
      <bpmn:incoming>SequenceFlow_15</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_23</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_24</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- School Report -->
    <bpmn:task id="Task_SchoolReportAccident" name="School Reports to Directorate (within 5 days)">
      <bpmn:incoming>SequenceFlow_23</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_27</bpmn:outgoing>
    </bpmn:task>

    <!-- Private Insurance Check -->
    <bpmn:exclusiveGateway id="Gateway_PrivateInsurance" name="Private Insurance?">
      <bpmn:incoming>SequenceFlow_24</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_30</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_31</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Private Insurance Reporting -->
    <bpmn:task id="Task_ReportToPrivateInsurer" name="Report to Private Insurer (within 3 days if fatality)">
      <bpmn:incoming>SequenceFlow_30</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_32</bpmn:outgoing>
    </bpmn:task>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_EmployeeDone" name="Employee Reporting Complete">
      <bpmn:incoming>SequenceFlow_12</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_ProviderReported" name="Insurance Provider Notified">
      <bpmn:incoming>SequenceFlow_20</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_SchoolDone" name="School Reporting Complete">
      <bpmn:incoming>SequenceFlow_27</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_PrivateInsured" name="Private Insurance Notified">
      <bpmn:incoming>SequenceFlow_32</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_01" sourceRef="StartEvent_Incident" targetRef="Task_ClassifyIncident"/>
    <bpmn:sequenceFlow id="SequenceFlow_02" name="" sourceRef="Task_ClassifyIncident" targetRef="Gateway_ReportType"/>

    <!-- Employee Reporting Path -->
    <bpmn:sequenceFlow id="SequenceFlow_03" name="Employee/Student" sourceRef="Gateway_ReportType" targetRef="Task_InformEmployee"/>
    <bpmn:sequenceFlow id="SequenceFlow_05" name="" sourceRef="Task_InformEmployee" targetRef="Gateway_SeverityCheck"/>

    <!-- Fatality/Serious Injury Path -->
    <bpmn:sequenceFlow id="SequenceFlow_06" name="Yes - Fatal/Serious" sourceRef="Gateway_SeverityCheck" targetRef="Task_ReportFatalityInjury"/>
    <bpmn:sequenceFlow id="SequenceFlow_12" name="" sourceRef="Task_ReportFatalityInjury" targetRef="EndEvent_EmployeeDone"/>

    <!-- Non-Fatality Path -->
    <bpmn:sequenceFlow id="SequenceFlow_07" name="No - Minor Injury/Incident" sourceRef="Gateway_SeverityCheck" targetRef="Gateway_InjuryCheck"/>

    <!-- Insurance Provider Reporting Decision -->
    <bpmn:sequenceFlow id="SequenceFlow_14" name="Unable to work 3+ days" sourceRef="Gateway_InjuryCheck" targetRef="Task_ReportToProvider"/>
    <bpmn:sequenceFlow id="SequenceFlow_20" name="" sourceRef="Task_ReportToProvider" targetRef="EndEvent_ProviderReported"/>

    <!-- Student/School Check -->
    <bpmn:sequenceFlow id="SequenceFlow_15" name="Not 3+ days unable to work" sourceRef="Gateway_InjuryCheck" targetRef="Gateway_SchoolCheck"/>
    <bpmn:sequenceFlow id="SequenceFlow_23" name="Yes - Student/Schoolchild" sourceRef="Gateway_SchoolCheck" targetRef="Task_SchoolReportAccident"/>

    <!-- School Reporting -->
    <bpmn:sequenceFlow id="SequenceFlow_27" name="" sourceRef="Task_SchoolReportAccident" targetRef="EndEvent_SchoolDone"/>

    <!-- Private Insurance Check Path -->
    <bpmn:sequenceFlow id="SequenceFlow_24" name="No - Not Student/Schoolchild" sourceRef="Gateway_SchoolCheck" targetRef="Gateway_PrivateInsurance"/>
    <bpmn:sequenceFlow id="SequenceFlow_30" name="Yes - Private Insurance" sourceRef="Gateway_PrivateInsurance" targetRef="Task_ReportToPrivateInsurer"/>

    <!-- Private Insurance Reporting -->
    <bpmn:sequenceFlow id="SequenceFlow_32" name="" sourceRef="Task_ReportToPrivateInsurer" targetRef="EndEvent_PrivateInsured"/>

  </bpmn:process>
</bpmn:definitions>