<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_DIY_Repair" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_UserTool" name="DIY Smartphone Repair Process" processRef="Process_DiyRepair"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_DiyRepair" isExecutable="true">
    
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Hardware issue detected">
      <bpmn:outgoing>SequenceFlow_AccCheck</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Account Logic Gateway -->
    <bpmn:exclusiveGateway id="Gateway_HaveAccount" name="Have account?">
      <bpmn:incoming>SequenceFlow_AccCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CreateAcc</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_LoginUser</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Create Account Task -->
    <bpmn:userTask id="Task_CreateAccount" name="Create account">
      <bpmn:incoming>SequenceFlow_CreateAcc</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AccConverge</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Login Task -->
    <bpmn:userTask id="Task_Login" name="Log into account">
      <bpmn:incoming>SequenceFlow_LoginUser</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckLoginSuccess</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Login Success Gateway -->
    <bpmn:exclusiveGateway id="Gateway_LoginSuccess" name="Is login successful?">
      <bpmn:incoming>SequenceFlow_CheckLoginSuccess</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EnterDetails</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Input Details -->
    <bpmn:userTask id="Task_EnterModel" name="Enter device model">
      <bpmn:incoming>SequenceFlow_EnterDetails</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SelectIssue</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_SelectIssue" name="Select type of hardware issue">
      <bpmn:incoming>SequenceFlow_SelectIssue</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SystemProcessStart</bpmn:outgoing>
    </bpmn:userTask>

    <!-- System Processing (Parallel) -->
    <bpmn:parallelGateway id="Gateway_SplitSystem" name="">
      <bpmn:incoming>SequenceFlow_SystemProcessStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ListMaterials</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ListTools</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- System Tasks -->
    <bpmn:serviceTask id="Task_SystemListMat" name="List required materials">
      <bpmn:incoming>SequenceFlow_ListMaterials</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConvSystem1</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_SystemListTools" name="List required tools">
      <bpmn:incoming>SequenceFlow_ListTools</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConvSystem2</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Offer Choices -->
    <bpmn:userTask id="Task_OfferChoices" name="Offer ordering choices">
       <bpmn:incoming>SequenceFlow_SystemConverge</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AcquisitionCheck</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Convergence of System Tasks -->
    <bpmn:parallelGateway id="Gateway_ConvSystem" name="">
       <bpmn:incoming>SequenceFlow_ConvSystem1</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ConvSystem2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SystemConverge</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Acquisition Logic -->
    <bpmn:userTask id="Task_AcquisitionCheck" name="Have all required items?">
       <bpmn:incoming>SequenceFlow_AcquisitionCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckFriends</bpmn:outgoing>
    </bpmn:userTask>

     <!-- Friends / Purchase Logic -->
    <bpmn:userTask id="Task_ContactFriends" name="Get second-hand items from friends">
       <bpmn:incoming>SequenceFlow_CheckFriends</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FriendsConverge</bpmn:outgoing>
    </bpmn:userTask>

     <bpmn:userTask id="Task_PurchaseOnline" name="Purchase online">
       <bpmn:incoming>SequenceFlow_CheckBuy</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BuyConverge</bpmn:outgoing>
    </bpmn:userTask>

     <!-- Repair Phase -->
    <bpmn:serviceTask id="Task_DisplayInstructions" name="Display repair instructions">
       <bpmn:incoming>SequenceFlow_AcquisitionConverge</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Instructions</bpmn:outgoing>
    </bpmn:serviceTask>

     <bpmn:manualTask id="Task_RepairDevice" name="Repair device">
       <bpmn:incoming>SequenceFlow_Instructions</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RepairDone</bpmn:outgoing>
    </bpmn:manualTask>

     <!-- Outcome Check -->
    <bpmn:exclusiveGateway id="Gateway_IsFixed" name="Is issue fixed?">
       <bpmn:incoming>SequenceFlow_RepairDone</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_IntentionReview</bpmn:outgoing>
    </bpmn:exclusiveGateway>

     <!-- Success Path (Review/Video) -->
    <bpmn:userTask id="Task_WriteReview" name="Write review">
       <bpmn:incoming>SequenceFlow_IntentionReview</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReviewConverge</bpmn:outgoing>
    </bpmn:userTask>

     <bpmn:userTask id="Task_UploadVideo" name="Upload video of repair steps">
       <bpmn:incoming>SequenceFlow_IntentionVideo</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_VideoConverge</bpmn:outgoing>
    </bpmn:userTask>

     <!-- Failure Path (Expert) -->
    <bpmn:userTask id="Task_SendToExpert" name="Send device to an expert">
       <bpmn:incoming>SequenceFlow_NotFixed</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendToExpertDone</bpmn:outgoing>
    </bpmn:userTask>

     <!-- End Events -->
     <bpmn:endEvent id="EndEvent_Success" name="Hardware issue fixed">
       <bpmn:incoming>SequenceFlow_SummaryConverge</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>