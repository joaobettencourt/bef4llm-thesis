<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_RobotBurgerSeller">
  <bpmn:process id="Process_1" name="Robotic Burger Seller Process" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_ReceivingOrder" name="Robot receives order">
      <bpmn:outgoing>SequenceFlow_AskType</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Ask Order Type (Menu vs Burger) -->
    <bpmn:userTask id="Task_AskOrderType" name="Ask if menu or burger">
      <bpmn:incoming>SequenceFlow_AskType</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MenuDecision</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway 1: Menu Decision -->
    <bpmn:exclusiveGateway id="Gateway_Menu" name="Menu?">
      <bpmn:incoming>SequenceFlow_MenuDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MenuYes_ParallelSplit</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Parallel Split (Menu Path) -->
    <bpmn:parallelGateway id="Parallel_Split_Menu" gatewayDirection="Diverging">
      <bpmn:incoming>SequenceFlow_MenuYes_ParallelSplit</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PrepareDrink</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_AskSides</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 1 (Parallel): Prepare Drink -->
    <bpmn:serviceTask id="Task_PrepareDrink" name="Prepare drink">
      <bpmn:incoming>SequenceFlow_PrepareDrink</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DrinkDone_Converge1</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Task 2 (Parallel): Ask Fries/Wedges -->
    <bpmn:userTask id="Task_AskSides" name="Ask fries or wedges">
      <bpmn:incoming>SequenceFlow_AskSides</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SideDecision</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway 2: Side Decision -->
    <bpmn:exclusiveGateway id="Gateway_Fries" name="Fries or Wedges?">
      <bpmn:incoming>SequenceFlow_SideDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PrepareFries</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 3 (Parallel): Prepare Fries -->
    <bpmn:serviceTask id="Task_PrepareFries" name="Prepare fries">
      <bpmn:incoming>SequenceFlow_PrepareFries</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SideDone_Converge2</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Task 4 (Parallel): Prepare Wedges -->
    <bpmn:serviceTask id="Task_PrepareWedges" name="Prepare wedges">
      <bpmn:incoming>SequenceFlow_PrepareFries</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SideDone_Converge2</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Gateway 3: Converge Sides -->
    <bpmn:exclusiveGateway id="Gateway_CombineSides" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow_SideDone_Converge2</bpmn:outgoing>
      <bpmn:incomming>SequenceFlow_PrepareWedges</bpmn:outgoing>
    </bpmn:exclusiveGateway>

  </bpmn:process>
</bpmn:definitions>