<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_ViennaNightRun" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Runner" name="Vienna Night Run Participation Process" processRef="Process_ViennaNightRun"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_ViennaNightRun" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Participate" name="Participate Night Run">
      <bpmn:outgoing>SequenceFlow_SelectBlock</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Select starting block -->
    <bpmn:task id="Task_SelectStartingBlock" name="Select starting block">
      <bpmn:incoming>SequenceFlow_SelectBlock</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StartRunMeasure</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway for running and measuring -->
    <bpmn:parallelGateway id="ParallelGateway_RunStart" name="">
      <bpmn:incoming>SequenceFlow_StartRunMeasure</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Run5km</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_MeasureTime</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Run 5 km -->
    <bpmn:task id="Task_Run5km" name="Run for 5 km">
      <bpmn:incoming>SequenceFlow_Run5km</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StopMeasureTime</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Start to measure time -->
    <bpmn:task id="Task_StartMeasure" name="Start measuring time">
      <bpmn:incoming>SequenceFlow_MeasureTime</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StopMeasureTime</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway converging -->
    <bpmn:parallelGateway id="ParallelGateway_RunEnd" name="">
      <bpmn:incoming>SequenceFlow_StopMeasureTime</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GetTotalTime</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Get total running time -->
    <bpmn:task id="Task_GetRunningTime" name="Get total running time">
      <bpmn:incoming>SequenceFlow_GetTotalTime</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Check25min</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway for 25 minutes check -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_TimeCheck" name="Less than 25 min?">
      <bpmn:incoming>SequenceFlow_Check25min</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TrainLoop</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_GetStartingNumber</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Do Training (loop back) -->
    <bpmn:task id="Task_Train" name="Do training">
      <bpmn:incoming>SequenceFlow_TrainLoop</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReturnToBlockSelect</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Get starting number -->
    <bpmn:task id="Task_GetStartingNumber" name="Get starting number">
      <bpmn:incoming>SequenceFlow_GetStartingNumber</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WorkTimeCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway for work time check -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_WorkTime" name="More than 1h before start?">
      <bpmn:incoming>SequenceFlow_WorkTimeCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GoFromHome</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_LeaveWork</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Go from home -->
    <bpmn:task id="Task_GoFromHome" name="Go to run from home">
      <bpmn:incoming>SequenceFlow_GoFromHome</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConvergeToRun</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Leave directly from work -->
    <bpmn:task id="Task_LeaveWork" name="Go after work to run">
      <bpmn:incoming>SequenceFlow_LeaveWork</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConvergeToRun2</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway converging -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_TravelConverge" name="">
      <bpmn:incoming>SequenceFlow_GoFromHome</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ConvergeToRun2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StartNightRun</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Parallel Gateway for running and drinking -->
    <bpmn:parallelGateway id="ParallelGateway_RunDrink" name="">
      <bpmn:incoming>SequenceFlow_StartNightRun</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NightRunTask</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_DrinkIsoSport</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Run the night run -->
    <bpmn:task id="Task_NightRun" name="Run at Night Run">
      <bpmn:incoming>SequenceFlow_NightRunTask</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConvergeFinish</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Drink iso sport -->
    <bpmn:task id="Task_DrinkIsoSport" name="Drink during run">
      <bpmn:incoming>SequenceFlow_DrinkIsoSport</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConvergeFinish2</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway converging -->
    <bpmn:parallelGateway id="ParallelGateway_RunDrinkEnd" name="">
      <bpmn:incoming>SequenceFlow_ConvergeFinish</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ConvergeFinish2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FinalTime</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Receive final running time -->
    <bpmn:task id="Task_ReceiveFinalTime" name="Receive final running time">
      <bpmn:incoming>SequenceFlow_FinalTime</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndEvent</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_RunFinished" name="Run finished">
      <bpmn:incoming>SequenceFlow_EndEvent</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_SelectBlock" sourceRef="StartEvent_Participate" targetRef="Task_SelectStartingBlock"/>
    <bpmn:sequenceFlow id="SequenceFlow_StartRunMeasure" sourceRef="Task_SelectStartingBlock" targetRef="ParallelGateway_RunStart"/>
    <bpmn:sequenceFlow id="SequenceFlow_Run5km" sourceRef="ParallelGateway_RunStart" targetRef="Task_Run5km"/>
    <bpmn:sequenceFlow id="SequenceFlow_MeasureTime" sourceRef="ParallelGateway_RunStart" targetRef="Task_StartMeasure"/>
    <bpmn:sequenceFlow id="SequenceFlow_StopMeasureTime" sourceRef="Task_Run5km" targetRef="ParallelGateway_RunEnd"/>
    <bpmn:sequenceFlow id="SequenceFlow_GetTotalTime" sourceRef="ParallelGateway_RunEnd" targetRef="Task_GetRunningTime"/>
    <bpmn:sequenceFlow id="SequenceFlow_Check25min" sourceRef="Task_GetRunningTime" targetRef="ExclusiveGateway_TimeCheck"/>

    <!-- Time Check Gateway Outgoing -->
    <bpmn:sequenceFlow id="SequenceFlow_TrainLoop" name="No - Train again" sourceRef="ExclusiveGateway_TimeCheck" targetRef="Task_Train">
      <bpmn:conditionExpression>${runningTime &gt;= 25}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Training Loop Back -->
    <bpmn:sequenceFlow id="SequenceFlow_ReturnToBlockSelect" sourceRef="Task_Train" targetRef="Task_SelectStartingBlock"/>

    <!-- Continue after passing time check -->
    <bpmn:sequenceFlow id="SequenceFlow_GetStartingNumber" name="Yes - Less than 25 min" sourceRef="ExclusiveGateway_TimeCheck" targetRef="Task_GetStartingNumber">
      <bpmn:conditionExpression>${runningTime &lt;= 25}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Work Time Check -->
    <bpmn:sequenceFlow id="SequenceFlow_WorkTimeCheck" sourceRef="Task_GetStartingNumber" targetRef="ExclusiveGateway_WorkTime"/>

    <!-- Travel Options -->
    <bpmn:sequenceFlow id="SequenceFlow_GoFromHome" name="Yes - More than 1h left" sourceRef="ExclusiveGateway_WorkTime" targetRef="Task_GoFromHome">
      <bpmn:conditionExpression>${workEndTime &gt;= startTime + 60}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_LeaveWork" name="No - Leave from work" sourceRef="ExclusiveGateway_WorkTime" targetRef="Task_LeaveWork">
      <bpmn:conditionExpression>${workEndTime &lt; startTime + 60}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Converge travel paths -->
    <bpmn:sequenceFlow id="SequenceFlow_ConvergeToRun" sourceRef="Task_GoFromHome" targetRef="ExclusiveGateway_TravelConverge"/>
    <bpmn:sequenceFlow id="SequenceFlow_ConvergeToRun2" sourceRef="Task_LeaveWork" targetRef="ExclusiveGateway_TravelConverge"/>

    <!-- Run and Drink Parallel Tasks -->
    <bpmn:sequenceFlow id="SequenceFlow_StartNightRun" sourceRef="ExclusiveGateway_TravelConverge" targetRef="ParallelGateway_RunDrink"/>
    <bpmn:sequenceFlow id="SequenceFlow_NightRunTask" sourceRef="ParallelGateway_RunDrink" targetRef="Task_NightRun"/>
    <bpmn:sequenceFlow id="SequenceFlow_DrinkIsoSport" sourceRef="ParallelGateway_RunDrink" targetRef="Task_DrinkIsoSport"/>

    <!-- Converge run and drink -->
    <bpmn:sequenceFlow id="SequenceFlow_ConvergeFinish" sourceRef="Task_NightRun" targetRef="ParallelGateway_RunDrinkEnd"/>
    <bpmn:sequenceFlow id="SequenceFlow_ConvergeFinish2" sourceRef="Task_DrinkIsoSport" targetRef="ParallelGateway_RunDrinkEnd"/>

    <!-- End -->
    <bpmn:sequenceFlow id="SequenceFlow_FinalTime" sourceRef="ParallelGateway_RunDrinkEnd" targetRef="Task_ReceiveFinalTime"/>
    <bpmn:sequenceFlow id="SequenceFlow_EndEvent" sourceRef="Task_ReceiveFinalTime" targetRef="EndEvent_RunFinished"/>

  </bpmn:process>
</bpmn:definitions>