<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_InternshipProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_Internship">
    <bpmn:participant id="Participant_ApplicantCompany" name="Internship Process" processRef="Proc_InternshipMain"/>
  </bpmn:collaboration>

  <bpmn:process id="Proc_InternshipMain" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="Start_ApplyInternship" name="Apply for Internship">
      <bpmn:outgoing>Flow_01_StartToEntry</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Entry Task - Enter details -->
    <bpmn:userTask id="Task_EntryDetails" name="Enter topic, money amount, experience and hobbies">
      <bpmn:incoming>Flow_01_StartToEntry</bpmn:incoming>
      <bpmn:outgoing>Flow_02_EntryToOffers</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Offers Arrival (Service Task) -->
    <bpmn:serviceTask id="Task_OffersArrival" name="Several offers arrive">
      <bpmn:incoming>Flow_02_EntryToOffers</bpmn:incoming>
      <bpmn:outgoing>Flow_03_OffersToDecision</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Decision Gateway - Accept or Deny -->
    <bpmn:exclusiveGateway id="Gateway_AcceptDeny" name="Accept offer?">
      <bpmn:incoming>Flow_03_OffersToDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_04_Accepted</bpmn:outgoing>
      <bpmn:outgoing>Flow_05_Denied</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Path when offer accepted -->
    <bpmn:userTask id="Task_AcceptOffer" name="Accept offer">
      <bpmn:incoming>Flow_04_Accepted</bpmn:incoming>
      <bpmn:outgoing>Flow_06_InvalidateOthers</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Invalidate other offers -->
    <bpmn:serviceTask id="Task_InvalidateOffers" name="Invalidate all other offers">
      <bpmn:incoming>Flow_06_InvalidateOthers</bpmn:incoming>
      <bpmn:outgoing>Flow_07_StartUpdates</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Parallel Gateway for status updates -->
    <bpmn:parallelGateway id="GW_StatusUpdateStart" name="">
      <bpmn:incoming>Flow_07_StartUpdates</bpmn:incoming>
      <bpmn:outgoing>Flow_08_ApplicantUpdates</bpmn:outgoing>
      <bpmn:outgoing>Flow_09_CompanyUpdates</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Applicant Status Updates Loop -->
    <bpmn:userTask id="Task_ApplicantUpdate" name="Write status update">
      <bpmn:incoming>Flow_08_ApplicantUpdates</bpmn:incoming>
      <bpmn:outgoing>Flow_10_CheckApplicantCount</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Check if 3 updates done -->
    <bpmn:exclusiveGateway id="Gateway_ApplicantCheck" name="At least 3 status updates?">
      <bpmn:incoming>Flow_10_CheckApplicantCount</bpmn:incoming>
      <bpmn:outgoing>Flow_11_MoreUpdates</bpmn:outgoing>
      <bpmn:outgoing>Flow_12_DoneWithUpdates</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Loop back for more updates -->
    <bpmn:userTask id="Task_CompanyUpdate" name="Company writes status update">
      <bpmn:incoming>Flow_09_CompanyUpdates</bpmn:incoming>
      <bpmn:outgoing>Flow_13_CheckCompanyCount</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Check if 3 updates done -->
    <bpmn:exclusiveGateway id="Gateway_CompanyCheck" name="At least 3 status updates?">
      <bpmn:incoming>Flow_13_CheckCompanyCount</bpmn:incoming>
      <bpmn:outgoing>Flow_14_MoreUpdates</bpmn:outgoing>
      <bpmn:outgoing>Flow_15_DoneWithUpdates</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Converge both update paths -->
    <bpmn:parallelGateway id="GW_StatusUpdatesEnd" name="">
      <bpmn:incoming>Flow_12_DoneWithUpdates</bpmn:incoming>
      <bpmn:incoming>Flow_15_DoneWithUpdates</bpmn:incoming>
      <bpmn:outgoing>Flow_16_StartRecommendation</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Recommendation Decision -->
    <bpmn:exclusiveGateway id="Gateway_Recommend" name="Recommend company?">
      <bpmn:incoming>Flow_16_StartRecommendation</bpmn:incoming>
      <bpmn:outgoing>Flow_17_SendTweets</bpmn:outgoing>
      <bpmn:outgoing>Flow_18_NoRecommend</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Send tweets in parallel -->
    <bpmn:userTask id="Task_WriteTweet" name="Write tweet for friends">
      <bpmn:incoming>Flow_17_SendTweets</bpmn:incoming>
      <bpmn:outgoing>Flow_19_StartParallelSend</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel send tweets -->
    <bpmn:parallelGateway id="GW_TweetStart" name="">
      <bpmn:incoming>Flow_19_StartParallelSend</bpmn:incoming>
      <bpmn:outgoing>Flow_20_SendTweet1</bpmn:outgoing>
      <bpmn:outgoing>Flow_21_SendTweet2</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Send tweets -->
    <bpmn:sendTask id="Task_TweetSend" name="Send tweet">
      <bpmn:incoming>Flow_20_SendTweet1</bpmn:incoming>
      <bpmn:outgoing>Flow_23_ConvergeTweets</bpmn:outgoing>
    </bpmn:sendTask>

    <!-- Converge tweets -->
    <bpmn:parallelGateway id="GW_TweetsEnd" name="">
      <bpmn:incoming>Flow_21_SendTweet2</bpmn:incoming>
      <bpmn:incoming>Flow_23_ConvergeTweets</bpmn:incoming>
      <bpmn:outgoing>Flow_FinalToComplete</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- End Event -->
    <bpmn:endEvent id="End_Internship" name="Internship finished">
      <bpmn:incoming>Flow_FinalToComplete</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Flow definitions with proper attributes -->
    <bpmn:sequenceFlow id="Flow_01_StartToEntry" sourceRef="Start_ApplyInternship" targetRef="Task_EntryDetails"/>
    <bpmn:sequenceFlow id="Flow_02_EntryToOffers" sourceRef="Task_EntryDetails" targetRef="Task_OffersArrival"/>
    <bpmn:sequenceFlow id="Flow_03_OffersToDecision" sourceRef="Task_OffersArrival" targetRef="Gateway_AcceptDeny"/>
    <bpmn:sequenceFlow id="Flow_04_Accepted" name="Yes" sourceRef="Gateway_AcceptDeny" targetRef="Task_AcceptOffer">
      <bpmn:conditionExpression>accepted</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_05_Denied" name="No - wait for other offers" sourceRef="Gateway_AcceptDeny" targetRef="Task_OffersArrival"/>
    <bpmn:sequenceFlow id="Flow_06_InvalidateOthers" sourceRef="Task_AcceptOffer" targetRef="Task_InvalidateOffers"/>
    <bpmn:sequenceFlow id="Flow_07_StartUpdates" sourceRef="Task_InvalidateOffers" targetRef="GW_StatusUpdateStart"/>
    <bpmn:sequenceFlow id="Flow_08_ApplicantUpdates" sourceRef="GW_StatusUpdateStart" targetRef="Task_ApplicantUpdate"/>
    <bpmn:sequenceFlow id="Flow_10_CheckApplicantCount" sourceRef="Task_ApplicantUpdate" targetRef="Gateway_ApplicantCheck"/>
    <bpmn:sequenceFlow id="Flow_12_DoneWithUpdates" name="Yes (3+ updates)" sourceRef="Gateway_ApplicantCheck" targetRef="GW_StatusUpdatesEnd">
      <bpmn:conditionExpression>updatesCount >= 3</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_09_CompanyUpdates" sourceRef="GW_StatusUpdateStart" targetRef="Task_CompanyUpdate"/>
    <bpmn:sequenceFlow id="Flow_13_CheckCompanyCount" sourceRef="Task_CompanyUpdate" targetRef="Gateway_CompanyCheck"/>
    <bpmn:sequenceFlow id="Flow_15_DoneWithUpdates" name="Yes (3+ updates)" sourceRef="Gateway_CompanyCheck" targetRef="GW_StatusUpdatesEnd">
      <bpmn:conditionExpression>updatesCount >= 3</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_16_StartRecommendation" sourceRef="GW_StatusUpdatesEnd" targetRef="Gateway_Recommend"/>
    <bpmn:sequenceFlow id="Flow_17_SendTweets" name="Yes - recommend to friends" sourceRef="Gateway_Recommend" targetRef="Task_WriteTweet">
      <bpmn:conditionExpression>recommend</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_18_NoRecommend" name="No - finish internship" sourceRef="Gateway_Recommend" targetRef="End_Internship"/>
    <bpmn:sequenceFlow id="Flow_19_StartParallelSend" sourceRef="Task_WriteTweet" targetRef="GW_TweetStart"/>
    <bpmn:sequenceFlow id="Flow_20_SendTweet1" name="" sourceRef="GW_TweetStart" targetRef="Task_TweetSend">
      <bpmn:conditionExpression>tweetType = 'friend'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_21_SendTweet2" name="" sourceRef="GW_TweetStart" targetRef="Task_TweetSend"/>
    <bpmn:sequenceFlow id="Flow_23_ConvergeTweets" sourceRef="Task_TweetSend" targetRef="GW_TweetsEnd"/>

  </bpmn:process>
</bpmn:definitions>