<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_NewCourseRegistration" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="Participant_Process" name="New Application for Registering for an USI course" processRef="Process_NewCourseRegistration"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_NewCourseRegistration" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="Start_WishToEnroll" name="Wish to enroll in course">
      <bpmn:outgoing>Flow_SelectCourse</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Select Course -->
    <bpmn:userTask id="Task_SelectCourse" name="Select a course">
      <bpmn:incoming>Flow_SelectCourseLoopback</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckFreeSpots</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway: Free Spots? -->
    <bpmn:exclusiveGateway id="Gateway_FreeSpots" name="Slots free?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_CheckFreeSpots</bpmn:incoming>
      <bpmn:outgoing>Flow_ShowCoursesYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_SelectCourseLoopback</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Service Task: System shows courses -->
    <bpmn:serviceTask id="Service_ShowCourses" name="System tells you the courses and dates">
      <bpmn:incoming>Flow_ShowCoursesYes</bpmn:incoming>
      <bpmn:outgoing>Flow_SelectSpecificCourse</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Task: Select Specific Course -->
    <bpmn:userTask id="Task_SelectSpecific" name="Select one">
      <bpmn:incoming>Flow_SelectSpecificCourse</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckAccount</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway: Already Registered? -->
    <bpmn:exclusiveGateway id="Gateway_AlreadyRegistered" name="Already have account?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_CheckAccount</bpmn:incoming>
      <bpmn:outgoing>Flow_LoginYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_CheckEligibilityNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Log into account (Path Yes) -->
    <bpmn:userTask id="Task_LoginYes" name="Log into it">
      <bpmn:incoming>Flow_LoginYes</bpmn:incoming>
      <bpmn:outgoing>Flow_SplitTwitterPayment</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Check Eligibility (Path No) -->
    <bpmn:userTask id="Task_CheckEligibility" name="Check if registered at eligible university">
      <bpmn:incoming>Flow_CheckEligibilityNo</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_EligibleUniversity</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway: Eligible University? -->
    <bpmn:exclusiveGateway id="Gateway_Eligible" name="Eligible university?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Gateway_EligibleUniversity</bpmn:incoming>
      <bpmn:outgoing>Flow_RegisterAccountYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_RequestActivationNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Register Account (Path Yes) -->
    <bpmn:userTask id="Task_RegisterAccount" name="Register your account">
      <bpmn:incoming>Flow_RegisterAccountYes</bpmn:incoming>
      <bpmn:outgoing>Flow_MergeToLogin</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Request Activation (Path No) -->
    <bpmn:userTask id="Task_RequestActivation" name="Request activation">
      <bpmn:incoming>Flow_RequestActivationNo</bpmn:incoming>
      <bpmn:outgoing>Flow_WaitForResponseStart</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Intermediate Catch Event: Wait for response -->
    <bpmn:intermediateCatchEvent id="Event_WaitActivation" name="Wait for a response">
      <bpmn:incoming>Flow_WaitForResponseStart</bpmn:incoming>
      <bpmn:outgoing>Flow_MergeToLogin2</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Merge Point for Login -->
    <bpmn:exclusiveGateway id="Gateway_LoginMerge" name="" gatewayDirection="Converging">
      <bpmn:incoming>Flow_MergeToLogin</bpmn:incoming>
      <bpmn:incoming>Flow_MergeWaitActivation</bpmn:incoming>
      <bpmn:outgoing>Flow_SplitTwitterPayment2</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Parallel Gateway Split -->
    <bpmn:parallelGateway id="GW_ParallelStart" name="" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_SplitTwitterPayment2</bpmn:incoming>
      <bpmn:outgoing>Flow_ConnectTwitter</bpmn:outgoing>
      <bpmn:outgoing>Flow_CompleteRegistration</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Connect Twitter -->
    <bpmn:userTask id="Task_ConnectTwitter" name="Connect to twitter account">
      <bpmn:incoming>Flow_ConnectTwitter</bpmn:incoming>
      <bpmn:outgoing>Flow_TweetFriends</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Tweet Friends -->
    <bpmn:userTask id="Task_Tweet" name="Tweet to friends">
      <bpmn:incoming>Flow_TweetFriends</bpmn:incoming>
      <bpmn:outgoing>Flow_MergeEnd1</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Complete Registration & Payment -->
    <bpmn:userTask id="Task_CompleteReg" name="Complete registration and provide payment info">
      <bpmn:incoming>Flow_CompleteRegistration</bpmn:incoming>
      <bpmn:outgoing>Flow_MergeEnd2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel Gateway Converge -->
    <bpmn:parallelGateway id="GW_ParallelMerge" name="" gatewayDirection="Converging">
      <bpmn:incoming>Flow_MergeEnd1</bpmn:incoming>
      <bpmn:incoming>Flow_MergeEnd2</bpmn:incoming>
      <bpmn:outgoing>Flow_IssueTicket</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Service Task: Issue Ticket -->
    <bpmn:serviceTask id="Service_IssueTicket" name="System issues course tickets">
      <bpmn:incoming>Flow_IssueTicket</bpmn:incoming>
      <bpmn:outgoing>Flow_EndEvent</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- End Event -->
    <bpmn:endEvent id="End_ReceiveTicket" name="Receive course ticket">
      <bpmn:incoming>Flow_EndEvent</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Flow_SelectCourse" sourceRef="Start_WishToEnroll" targetRef="Task_SelectCourse"/>
    <bpmn:sequenceFlow id="Flow_CheckFreeSpots" sourceRef="Task_SelectCourse" targetRef="Gateway_FreeSpots"/>
    <bpmn:sequenceFlow id="Flow_ShowCoursesYes" name="yes" sourceRef="Gateway_FreeSpots" targetRef="Service_ShowCourses"/>
    <bpmn:sequenceFlow id="Flow_SelectCourseLoopback" name="no" sourceRef="Gateway_FreeSpots" targetRef="Task_SelectCourse"/>
    <bpmn:sequenceFlow id="Flow_SelectSpecificCourse" sourceRef="Service_ShowCourses" targetRef="Task_SelectSpecific"/>
    <bpmn:sequenceFlow id="Flow_CheckAccount" sourceRef="Task_SelectSpecific" targetRef="Gateway_AlreadyRegistered"/>

    <!-- Login Paths -->
    <bpmn:sequenceFlow id="Flow_LoginYes" name="yes" sourceRef="Gateway_AlreadyRegistered" targetRef="Task_LoginYes"/>
    <bpmn:sequenceFlow id="Flow_CheckEligibilityNo" name="no" sourceRef="Gateway_AlreadyRegistered" targetRef="Task_CheckEligibility"/>

    <!-- Eligibility Paths -->
    <bpmn:sequenceFlow id="Flow_Gateway_EligibleUniversity" sourceRef="Task_CheckEligibility" targetRef="Gateway_Eligible"/>
    <bpmn:sequenceFlow id="Flow_RegisterAccountYes" name="yes" sourceRef="Gateway_Eligible" targetRef="Task_RegisterAccount"/>
    <bpmn:sequenceFlow id="Flow_RequestActivationNo" name="no" sourceRef="Gateway_Eligible" targetRef="Task_RequestActivation"/>

    <!-- Merge to Login -->
    <bpmn:sequenceFlow id="Flow_MergeToLogin" sourceRef="Task_RegisterAccount" targetRef="Gateway_LoginMerge"/>
    <bpmn:sequenceFlow id="Flow_WaitForResponseStart" sourceRef="Task_RequestActivation" targetRef="Event_WaitActivation"/>
    <bpmn:sequenceFlow id="Flow_MergeWaitActivation" sourceRef="Event_WaitActivation" targetRef="Gateway_LoginMerge"/>

    <!-- Parallel Split -->
    <bpmn:sequenceFlow id="Flow_SplitTwitterPayment2" name="" sourceRef="Task_LoginYes" targetRef="GW_ParallelStart"/>

    <!-- Twitter Path -->
    <bpmn:sequenceFlow id="Flow_ConnectTwitter" sourceRef="GW_ParallelStart" targetRef="Task_ConnectTwitter"/>
    <bpmn:sequenceFlow id="Flow_TweetFriends" sourceRef="Task_ConnectTwitter" targetRef="Task_Tweet"/>

    <!-- Payment Path -->
    <bpmn:sequenceFlow id="Flow_CompleteRegistration" name="" sourceRef="GW_ParallelStart" targetRef="Task_CompleteReg"/>

    <!-- Convergence & End -->
    <bpmn:sequenceFlow id="Flow_MergeEnd1" sourceRef="Task_Tweet" targetRef="GW_ParallelMerge"/>
    <bpmn:sequenceFlow id="Flow_MergeEnd2" sourceRef="Task_CompleteReg" targetRef="GW_ParallelMerge"/>
    <bpmn:sequenceFlow id="Flow_IssueTicket" name="" sourceRef="GW_ParallelMerge" targetRef="Service_IssueTicket"/>
    <bpmn:sequenceFlow id="Flow_EndEvent" sourceRef="Service_IssueTicket" targetRef="End_ReceiveTicket"/>

  </bpmn:process>
</bpmn:definitions>