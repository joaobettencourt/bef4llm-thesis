<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com/bpmn">
  <process id="recourseProcess" isExecutable="true">
    <startEvent id="probableRecourseDetected">
      <outgoing>checkCase</outgoing>
      <messageEventDefinition/>
    </startEvent>
    <sequenceFlow id="checkCaseFlow" sourceRef="probableRecourseDetected" targetRef="checkCase"/>
    <task id="checkCase">
      <incoming>checkCaseFlow</incoming>
      <outgoing>recoursePossible</outgoing>
    </task>
    <exclusiveGateway id="recoursePossibleGateway">
      <incoming>recoursePossible</incoming>
      <outgoing>yesRecoursePossible</outgoing>
      <outgoing>noRecoursePossible</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="recoursePossibleFlow" sourceRef="checkCase" targetRef="recoursePossibleGateway"/>
    <sequenceFlow id="yesRecoursePossibleFlow" name="yes" sourceRef="recoursePossibleGateway" targetRef="sendRequestForPayment"/>
    <task id="sendRequestForPayment">
      <incoming>yesRecoursePossible</incoming>
      <outgoing>sendReminder</outgoing>
    </task>
    <sequenceFlow id="sendRequestForPaymentFlow" sourceRef="sendRequestForPayment" targetRef="sendReminder"/>
    <task id="sendReminder">
      <incoming>sendRequestForPaymentFlow</incoming>
      <outgoing>eventBasedGateway</outgoing>
    </task>
    <sequenceFlow id="sendReminderFlow" sourceRef="sendReminder" targetRef="eventBasedGateway"/>
    <eventBasedGateway id="eventBasedGateway">
      <incoming>eventBasedGateway</incoming>
      <outgoing>disagreementLetterReceived</outgoing>
      <outgoing>reminderDue</outgoing>
      <outgoing>moneyReceived</outgoing>
    </eventBasedGateway>
    <intermediateCatchEvent id="disagreementLetterReceived">
      <incoming>disagreementLetterReceived</incoming>
      <outgoing>checkReasoning</outgoing>
      <messageEventDefinition/>
    </intermediateCatchEvent>
    <sequenceFlow id="disagreementLetterReceivedFlow" sourceRef="eventBasedGateway" targetRef="disagreementLetterReceived"/>
    <task id="checkReasoning">
      <incoming>checkReasoning</incoming>
      <outgoing>ok</outgoing>
    </task>
    <exclusiveGateway id="okGateway">
      <incoming>ok</incoming>
      <outgoing>yesOk</outgoing>
      <outgoing>noOk</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="checkReasoningFlow" sourceRef="checkReasoning" targetRef="okGateway"/>
    <task id="closeCaseYes">
      <incoming>yesOk</incoming>
      <outgoing>caseClosed</outgoing>
    </task>
    <endEvent id="caseClosed">
      <incoming>caseClosed</incoming>
    </endEvent>
    <sequenceFlow id="closeCaseYesFlow" sourceRef="closeCaseYes" targetRef="caseClosed"/>
    <sequenceFlow id="noOkFlow" name="no" sourceRef="okGateway" targetRef="handOverToCollectionAgency"/>
    <intermediateCatchEvent id="reminderDue">
      <incoming>reminderDue</incoming>
      <outgoing>reminderDueHandled</outgoing>
      <timerEventDefinition/>
    </intermediateCatchEvent>
    <sequenceFlow id="reminderDueFlow" sourceRef="eventBasedGateway" targetRef="reminderDue"/>
    <task id="handOverToCollectionAgency">
      <incoming>noOk</incoming>
      <incoming>reminderDueHandled</incoming>
      <outgoing>caseOpen</outgoing>
    </task>
    <endEvent id="caseOpen">
      <incoming>caseOpen</incoming>
    </endEvent>
    <sequenceFlow id="handOverToCollectionAgencyFlow" sourceRef="handOverToCollectionAgency" targetRef="caseOpen"/>
    <intermediateCatchEvent id="moneyReceived">
      <incoming>moneyReceived</incoming>
      <outgoing>makeBooking</outgoing>
      <messageEventDefinition/>
    </intermediateCatchEvent>
    <sequenceFlow id="moneyReceivedFlow" sourceRef="eventBasedGateway" targetRef="moneyReceived"/>
    <task id="makeBooking">
      <incoming>makeBooking</incoming>
      <outgoing>closeCaseNo</outgoing>
    </task>
    <task id="closeCaseNo">
      <incoming>closeCaseNo</incoming>
      <outgoing>caseClosedNo</outgoing>
    </task>
    <sequenceFlow id="closeCaseNoFlow" sourceRef="closeCaseNo" targetRef="caseClosedNo"/>
    <endEvent id="caseClosedNo">
      <incoming>caseClosedNo</incoming>
    </endEvent>
  </process>
</definitions>