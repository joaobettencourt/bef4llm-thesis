<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com/bpmn">

  <collaboration id="collaboration">
    <participant id="Participant_1" name="Kreditvergabe Frontend (Bank)" processRef="Process_1"/>
    <participant id="Participant_2" name="Schufascoring (Bank)" processRef="Process_2"/>
    <participant id="Participant_3" name="Scoringservice (Schufa)" processRef="Process_3"/>

    <messageFlow id="MessageFlow_1" sourceRef="Participant_1" targetRef="StartEvent_1"/>
    <messageFlow id="MessageFlow_2" sourceRef="Task_2" targetRef="Participant_1"/>
    <messageFlow id="MessageFlow_3" sourceRef="Task_4" targetRef="Participant_1"/>

  </collaboration>

  <process id="Process_1">
    <!-- empty process -->
  </process>

  <process id="Process_2">
    <startEvent id="StartEvent_1" name="Schufascoring angefragt">
      <outgoing>SequenceFlow_1</outgoing>
      <messageEventDefinition/>
    </startEvent>

    <task id="Task_2" name="Scoring-anfrage senden">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_2"/>

    <eventBasedGateway id="EventBasedGateway_1">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_4</outgoing>
      <outgoing>SequenceFlow_5</outgoing>
    </eventBasedGateway>

    <sequenceFlow id="SequenceFlow_3" sourceRef="Task_2" targetRef="EventBasedGateway_1"/>

    <intermediateCatchEvent id="IntermediateCatchEvent_1" name="Schufascore verzögert">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_6</outgoing>
      <messageEventDefinition/>
    </intermediateCatchEvent>

    <sequenceFlow id="SequenceFlow_4" sourceRef="EventBasedGateway_1" targetRef="IntermediateCatchEvent_1"/>

    <task id="Task_3" name="Verzögerung melden">
      <incoming>SequenceFlow_6</incoming>
      <!-- outgoing not specified -->
    </task>

    <sequenceFlow id="SequenceFlow_6" sourceRef="IntermediateCatchEvent_1" targetRef="Task_3"/>

    <intermediateCatchEvent id="IntermediateCatchEvent_2" name="Schufascore sofort ermittelt">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_7</outgoing>
      <messageEventDefinition/>
    </intermediateCatchEvent>

    <sequenceFlow id="SequenceFlow_5" sourceRef="EventBasedGateway_1" targetRef="IntermediateCatchEvent_2"/>

    <task id="Task_4" name="Schufascore zurückmelden">
      <incoming>SequenceFlow_7</incoming>
      <!-- outgoing not specified -->
    </task>

    <sequenceFlow id="SequenceFlow_7" sourceRef="IntermediateCatchEvent_2" targetRef="Task_4"/>

  </process>

  <process id="Process_3">

    <startEvent id="StartEvent_0o849un" name="Scoringanfrage gestellt">
      <outgoing>SequenceFlow_158pur5</outgoing>
      <messageEventDefinition/>
    </startEvent>

    <sequenceFlow id="SequenceFlow_158pur5" sourceRef="StartEvent_0o849un" targetRef="Task_1r15hqs"/>

    <task id="Task_1r15hqs" name="Scoring durchführen (level 1)">
      <incoming>SequenceFlow_158pur5</incoming>
      <outgoing>SequenceFlow_1nznlgx</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_1nznlgx" sourceRef="Task_1r15hqs" targetRef="ExclusiveGateway_0rtdod4"/>

    <exclusiveGateway id="ExclusiveGateway_0rtdod4">
      <incoming>SequenceFlow_1nznlgx</incoming>
      <outgoing>SequenceFlow_052bcer</outgoing>
      <outgoing>SequenceFlow_0jh32vv</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow_052bcer" sourceRef="ExclusiveGateway_0rtdod4" targetRef="Task_07vbn2i"/>

    <task id="Task_07vbn2i" name="Schufascore senden">
      <incoming>SequenceFlow_052bcer</incoming>
      <!-- outgoing not specified -->
    </task>

  </process>

</definitions>