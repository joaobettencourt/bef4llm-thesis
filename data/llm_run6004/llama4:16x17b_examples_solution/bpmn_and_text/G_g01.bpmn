<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/DD/20100524/DC/"
             id="definitions" targetNamespace="http://www.example.com">
  <process id="LANPartyProcess" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_SendInvitations"/>
    <task id="Task_SendInvitations" name="Send Invitations to 10 Friends">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_SendInvitations" targetRef="IntermediateCatchEvent_GetGamesList"/>
    <intermediateCatchEvent id="IntermediateCatchEvent_GetGamesList">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
      <messageEventDefinition/>
    </intermediateCatchEvent>
    <sequenceFlow id="SequenceFlow_3" sourceRef="IntermediateCatchEvent_GetGamesList" targetRef="ExclusiveGateway_HasEnoughGames"/>
    <exclusiveGateway id="ExclusiveGateway_HasEnoughGames">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_4</outgoing>
      <outgoing>SequenceFlow_5</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_HasEnoughGames" targetRef="Task_PrepareGames">
      <conditionExpression xsi:type="tFormalExpression">${hasAllGames}</conditionExpression>
    </sequenceFlow>
    <serviceTask id="Task_DownloadMissingGames">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </serviceTask>
    <sequenceFlow id="SequenceFlow_5" sourceRef="ExclusiveGateway_HasEnoughGames" targetRef="Task_DownloadMissingGames"/>
    <sequenceFlow id="SequenceFlow_6" sourceRef="Task_DownloadMissingGames" targetRef="Task_PrepareGames"/>
    <task id="Task_PrepareGames">
      <incoming>SequenceFlow_4</incoming>
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_7" sourceRef="Task_PrepareGames" targetRef="ExclusiveGateway_EnoughFriends"/>
    <exclusiveGateway id="ExclusiveGateway_EnoughFriends">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_8</outgoing>
      <outgoing>SequenceFlow_9</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_8" sourceRef="ExclusiveGateway_EnoughFriends" targetRef="Task_SetAppointment">
      <conditionExpression xsi:type="tFormalExpression">${enoughFriends}</conditionExpression>
    </sequenceFlow>
    <serviceTask id="Task_SetAppointment">
      <incoming>SequenceFlow_8</incoming>
      <outgoing>SequenceFlow_10</outgoing>
    </serviceTask>
    <sequenceFlow id="SequenceFlow_9" sourceRef="ExclusiveGateway_EnoughFriends" targetRef="IntermediateThrowEvent_SuggestNewDate"/>
    <intermediateThrowEvent id="IntermediateThrowEvent_SuggestNewDate">
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_11</outgoing>
      <messageEventDefinition/>
    </intermediateThrowEvent>
    <sequenceFlow id="SequenceFlow_10" sourceRef="Task_SetAppointment" targetRef="ParallelGateway_PrepareParty"/>
    <sequenceFlow id="SequenceFlow_11" sourceRef="IntermediateThrowEvent_SuggestNewDate" targetRef="ExclusiveGateway_EnoughFriends"/>
    <parallelGateway id="ParallelGateway_PrepareParty">
      <incoming>SequenceFlow_10</incoming>
      <outgoing>SequenceFlow_12</outgoing>
      <outgoing>SequenceFlow_13</outgoing>
    </parallelGateway>
    <sequenceFlow id="SequenceFlow_12" sourceRef="ParallelGateway_PrepareParty" targetRef="ExclusiveGateway_HasEnoughBeer"/>
    <exclusiveGateway id="ExclusiveGateway_HasEnoughBeer">
      <incoming>SequenceFlow_12</incoming>
      <outgoing>SequenceFlow_14</outgoing>
      <outgoing>SequenceFlow_15</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_13" sourceRef="ParallelGateway_PrepareParty" targetRef="Task_BuyBeer">
      <conditionExpression xsi:type="tFormalExpression">${notEnoughBeer}</conditionExpression>
    </sequenceFlow>
    <task id="Task_BuyBeer">
      <incoming>SequenceFlow_13</incoming>
      <outgoing>SequenceFlow_16</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_14" sourceRef="ExclusiveGateway_HasEnoughBeer" targetRef="ManualTask_StartParty"/>
    <manualTask id="ManualTask_StartParty">
      <incoming>SequenceFlow_14</incoming>
      <outgoing>SequenceFlow_17</outgoing>
    </manualTask>
    <sequenceFlow id="SequenceFlow_15" sourceRef="ExclusiveGateway_HasEnoughBeer" targetRef="Task_BuyBeer"/>
    <sequenceFlow id="SequenceFlow_16" sourceRef="Task_BuyBeer" targetRef="ManualTask_StartParty"/>
    <sequenceFlow id="SequenceFlow_17" sourceRef="ManualTask_StartParty" targetRef="EndEvent_1"/>
    <endEvent id="EndEvent_1">
      <incoming>SequenceFlow_17</incoming>
    </endEvent>
  </process>
</definitions>