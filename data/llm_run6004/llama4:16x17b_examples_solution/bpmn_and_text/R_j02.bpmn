<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/06-02-01.xsd" id="definitions" targetNamespace="http://bpmn.io/schema/bpmn">
   <process id="inspectionProcess" isExecutable="true">
     <startEvent id="startInspection">
       <outgoing>enterMachineDetails</outgoing>
     </startEvent>
     <sequenceFlow id="sf1" sourceRef="startInspection" targetRef="chooseConfiguration"/>
     <userTask id="chooseConfiguration" name="Choose configuration">
       <incoming>sf1</incoming>
       <outgoing>beginInspection</outgoing>
     </userTask>
     <sequenceFlow id="sf2" sourceRef="chooseConfiguration" targetRef="exclusiveGateway1"/>
     <exclusiveGateway id="exclusiveGateway1">
       <incoming>sf2</incoming>
       <outgoing>hasError</outgoing>
       <outgoing>noError</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="sf3" name="yes" sourceRef="exclusiveGateway1" targetRef="printErrorCodes">
       <conditionExpression xsi:type="tFormalExpression">${errorExists}</conditionExpression>
     </sequenceFlow>
     <serviceTask id="printErrorCodes" name="Print error codes">
       <incoming>sf3</incoming>
       <outgoing>sf4</outgoing>
     </serviceTask>
     <sequenceFlow id="sf4" sourceRef="printErrorCodes" targetRef="exclusiveGateway2"/>
     <serviceTask id="clearErrorCodesTask" name="Clear error codes">
       <incoming>sf4</incoming>
       <outgoing>sf5</outgoing>
     </serviceTask>
     <sequenceFlow id="sf5" sourceRef="clearErrorCodesTask" targetRef="parallelGateway"/>
     <sequenceFlow id="noError" name="no" sourceRef="exclusiveGateway1" targetRef="parallelGateway"/> 
     <parallelGateway id="parallelGateway">
       <incoming>noError</incoming>
       <incoming>sf5</incoming>
       <outgoing>performTestRun</outgoing>
       <outgoing>readErrorCodes</outgoing>
     </parallelGateway>
     <sequenceFlow id="sf6" sourceRef="parallelGateway" targetRef="userTask4"/>
     <userTask id="userTask4" name="Perform test run">
       <incoming>sf6</incoming>
       <outgoing>exclusiveGateway3</outgoing>
     </userTask>
     <sequenceFlow id="sf7" sourceRef="parallelGateway" targetRef="serviceTask5"/>
     <serviceTask id="serviceTask5" name="Read error codes">
       <incoming>sf7</incoming>
       <outgoing>sf8</outgoing>
     </serviceTask>
     <sequenceFlow id="sf8" sourceRef="serviceTask5" targetRef="exclusiveGateway1"/>
     <sequenceFlow id="sf9" sourceRef="userTask4" targetRef="exclusiveGateway2"/> 
     <exclusiveGateway id="exclusiveGateway2">
       <incoming>sf9</incoming>
       <incoming>sf5</incoming>
       <outgoing>writeFinalReport</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="sf10" sourceRef="exclusiveGateway2" targetRef="userTask6"/>
     <userTask id="userTask6" name="Write final report">
       <incoming>sf10</incoming>
       <outgoing>endInspection</outgoing>
     </userTask>
     <sequenceFlow id="sf11" sourceRef="userTask6" targetRef="endEvent"/>
     <endEvent id="endEvent">
       <incoming>sf11</incoming>
     </endEvent>
   </process>
</definitions>