<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/DD/20100524/DC http://www.omg.org/spec/DD/20100524/DI http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">
   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>
     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="UserTask_1"/>
     <userTask id="UserTask_1" name="Describe the symptoms">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </userTask>
     <sequenceFlow id="SequenceFlow_2" sourceRef="UserTask_1" targetRef="ServiceTask_1"/>
     <serviceTask id="ServiceTask_1" name="Send a report to the fridge service center">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
     </serviceTask>
     <sequenceFlow id="SequenceFlow_3" sourceRef="ServiceTask_1" targetRef="ExclusiveGateway_1"/>
     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_4</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_1" targetRef="ServiceTask_2"/>
     <serviceTask id="ServiceTask_2" name="Select local service facility">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </serviceTask>
     <sequenceFlow id="SequenceFlow_5" sourceRef="ServiceTask_2" targetRef="IntermediateCatchEvent_1"/>
     <intermediateCatchEvent id="IntermediateCatchEvent_1" name="Wait until service facility arrives">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_6</outgoing>
       <timerEventDefinition/>
     </intermediateCatchEvent>
     <sequenceFlow id="SequenceFlow_6" sourceRef="IntermediateCatchEvent_1" targetRef="ExclusiveGateway_2"/>
     <exclusiveGateway id="ExclusiveGateway_2">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_7</outgoing>
       <outgoing>SequenceFlow_8</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_7" sourceRef="ExclusiveGateway_2" targetRef="ManualTask_1">
       <conditionExpression xsi:type="tFormalExpression">${additional.parts.needed == true}</conditionExpression>
     </sequenceFlow>
     <manualTask id="ManualTask_1" name="Collect additional parts in warehouse">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </manualTask>
     <sequenceFlow id="SequenceFlow_9" sourceRef="ManualTask_1" targetRef="ServiceTask_3"/>
     <serviceTask id="ServiceTask_3" name="Order additional parts">
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_11</outgoing>
     </serviceTask>
     <sequenceFlow id="SequenceFlow_11" sourceRef="ServiceTask_3" targetRef="IntermediateCatchEvent_2"/>
     <intermediateCatchEvent id="IntermediateCatchEvent_2" name="Additional parts arrive">
       <incoming>SequenceFlow_11</incoming>
       <outgoing>SequenceFlow_13</outgoing>
       <!--<conditionalEventDefinition condition="${parts.arrived == true}"/>-->
     </intermediateCatchEvent>
     <sequenceFlow id="SequenceFlow_13" sourceRef="IntermediateCatchEvent_2" targetRef="ManualTask_2"/>
     <manualTask id="ManualTask_2" name="Repair the fridge">
       <incoming>SequenceFlow_8</incoming>
       <incoming>SequenceFlow_13</incoming>
       <outgoing>SequenceFlow_10</outgoing>
     </manualTask>
     <sequenceFlow id="SequenceFlow_10" sourceRef="ManualTask_2" targetRef="ExclusiveGateway_3"/>
     <exclusiveGateway id="ExclusiveGateway_3">
       <incoming>SequenceFlow_10</incoming>
       <outgoing>SequenceFlow_12</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_12" sourceRef="ExclusiveGateway_3" targetRef="ManualTask_3"/>
     <manualTask id="ManualTask_3" name="Confirm that fridge is okay">
       <incoming>SequenceFlow_12</incoming>
       <outgoing>SequenceFlow_14</outgoing>
     </manualTask>
     <sequenceFlow id="SequenceFlow_14" sourceRef="ManualTask_3" targetRef="ExclusiveGateway_4"/>
     <exclusiveGateway id="ExclusiveGateway_4">
       <incoming>SequenceFlow_14</incoming>
       <outgoing>SequenceFlow_15</outgoing>
       <outgoing>SequenceFlow_16</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_15" sourceRef="ExclusiveGateway_4" targetRef="UserTask_2">
       <!--<conditionExpression xsi:type="tFormalExpression">${rating.submitted == true}</conditionExpression>-->
     </sequenceFlow>
     <userTask id="UserTask_2" name="Rate Service Facility">
       <incoming>SequenceFlow_15</incoming>
       <outgoing>SequenceFlow_17</outgoing>
     </userTask>
     <sequenceFlow id="SequenceFlow_16" sourceRef="ExclusiveGateway_4" targetRef="EndEvent_1"/>
     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_16</incoming>
       <incoming>SequenceFlow_17</incoming>
     </endEvent>
     <sequenceFlow id="SequenceFlow_17" sourceRef="UserTask_2" targetRef="EndEvent_1"/>
   </process>
</definitions>