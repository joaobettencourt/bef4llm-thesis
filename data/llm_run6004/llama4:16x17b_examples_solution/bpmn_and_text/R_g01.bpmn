<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/06-02-01.xsd"
             id="definitions" targetNamespace="http://bpmn.io/schema/bpmn">
  <process id="Process_1" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="UserTask_1"/>
    <userTask id="UserTask_1" name="Select device model">
      <outgoing>SequenceFlow_2</outgoing>
    </userTask>
    <sequenceFlow id="SequenceFlow_2" sourceRef="UserTask_1" targetRef="ExclusiveGateway_1"/>
    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
      <outgoing>SequenceFlow_4</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_1" targetRef="UserTask_2">
      <conditionExpression xsi:type="tFormalExpression">${hasAccount}</conditionExpression>
    </sequenceFlow>
    <userTask id="UserTask_2" name="Log into account">
      <outgoing>SequenceFlow_5</outgoing>
    </userTask>
    <sequenceFlow id="SequenceFlow_5" sourceRef="UserTask_2" targetRef="ExclusiveGateway_2"/>
    <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_1" targetRef="UserTask_3"/>
    <userTask id="UserTask_3" name="Create account">
      <outgoing>SequenceFlow_6</outgoing>
    </userTask>
    <sequenceFlow id="SequenceFlow_6" sourceRef="UserTask_3" targetRef="ExclusiveGateway_2"/>
    <exclusiveGateway id="ExclusiveGateway_2">
      <incoming>SequenceFlow_5</incoming>
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_7" sourceRef="ExclusiveGateway_2" targetRef="UserTask_4"/>
    <userTask id="UserTask_4" name="Select type of hardware Issue">
      <outgoing>SequenceFlow_8</outgoing>
    </userTask>
    <sequenceFlow id="SequenceFlow_8" sourceRef="UserTask_4" targetRef="ParallelGateway_1"/>
    <parallelGateway id="ParallelGateway_1">
      <incoming>SequenceFlow_8</incoming>
      <outgoing>SequenceFlow_9</outgoing>
      <outgoing>SequenceFlow_10</outgoing>
    </parallelGateway>
    <sequenceFlow id="SequenceFlow_9" sourceRef="ParallelGateway_1" targetRef="ServiceTask_1"/>
    <serviceTask id="ServiceTask_1" name="List required materials">
      <outgoing>SequenceFlow_11</outgoing>
    </serviceTask>
    <sequenceFlow id="SequenceFlow_11" sourceRef="ServiceTask_1" targetRef="ParallelGateway_2"/>
    <sequenceFlow id="SequenceFlow_10" sourceRef="ParallelGateway_1" targetRef="ServiceTask_2"/>
    <serviceTask id="ServiceTask_2" name="List required tools">
      <outgoing>SequenceFlow_12</outgoing>
    </serviceTask>
    <sequenceFlow id="SequenceFlow_12" sourceRef="ServiceTask_2" targetRef="ParallelGateway_2"/>
    <parallelGateway id="ParallelGateway_2">
      <incoming>SequenceFlow_11</incoming>
      <incoming>SequenceFlow_12</incoming>
      <outgoing>SequenceFlow_13</outgoing>
    </parallelGateway>
    <sequenceFlow id="SequenceFlow_13" sourceRef="ParallelGateway_2" targetRef="ServiceTask_3"/>
    <serviceTask id="ServiceTask_3" name="Offer ordering choices">
      <outgoing>SequenceFlow_14</outgoing>
    </serviceTask>
    <sequenceFlow id="SequenceFlow_14" sourceRef="ServiceTask_3" targetRef="ExclusiveGateway_3"/>
    <exclusiveGateway id="ExclusiveGateway_3">
      <incoming>SequenceFlow_14</incoming>
      <outgoing>SequenceFlow_15</outgoing>
      <outgoing>SequenceFlow_16</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_15" sourceRef="ExclusiveGateway_3" targetRef="UserTask_5">
      <conditionExpression xsi:type="tFormalExpression">${hasAllItems}</conditionExpression>
    </sequenceFlow>
    <userTask id="UserTask_5" name="Get second-hand tools and materials from friends">
      <outgoing>SequenceFlow_17</outgoing>
    </userTask>
    <sequenceFlow id="SequenceFlow_16" sourceRef="ExclusiveGateway_3" targetRef="UserTask_6"/>
    <userTask id="UserTask_6" name="Purchase online">
      <outgoing>SequenceFlow_18</outgoing>
    </userTask>
    <sequenceFlow id="SequenceFlow_17" sourceRef="UserTask_5" targetRef="ExclusiveGateway_4"/>
    <sequenceFlow id="SequenceFlow_18" sourceRef="UserTask_6" targetRef="ExclusiveGateway_4"/>
    <exclusiveGateway id="ExclusiveGateway_4">
      <incoming>SequenceFlow_17</incoming>
      <incoming>SequenceFlow_18</incoming>
      <outgoing>SequenceFlow_19</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_19" sourceRef="ExclusiveGateway_4" targetRef="ServiceTask_4"/>
    <serviceTask id="ServiceTask_4" name="Display repair instructions">
      <outgoing>SequenceFlow_20</outgoing>
    </serviceTask>
    <sequenceFlow id="SequenceFlow_20" sourceRef="ServiceTask_4" targetRef="UserTask_7"/>
    <userTask id="UserTask_7" name="Repair device">
      <outgoing>SequenceFlow_21</outgoing>
    </userTask>
    <sequenceFlow id="SequenceFlow_21" sourceRef="UserTask_7" targetRef="ExclusiveGateway_5"/>
    <exclusiveGateway id="ExclusiveGateway_5">
      <incoming>SequenceFlow_21</incoming>
      <outgoing>SequenceFlow_22</outgoing>
      <outgoing>SequenceFlow_23</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_22" sourceRef="ExclusiveGateway_5" targetRef="UserTask_8">
      <conditionExpression xsi:type="FormalExpression">${isFixed}</conditionExpression>
    </sequenceFlow>
    <userTask id="UserTask_8" name="Write review and/or upload video">
      <outgoing>SequenceFlow_24</outgoing>
    </userTask>
    <bpmn:manualTask id="ManualTask_1" name="Send device to an expert">
      <outgoing>SequenceFlow_25</outgoing>
    </bpmn:manualTask>
    <sequenceFlow id="SequenceFlow_23" sourceRef="ExclusiveGateway_5" targetRef="ManualTask_1"/>
    <sequenceFlow id="SequenceFlow_24" sourceRef="UserTask_8" targetRef="EndEvent_1"/>
    <sequenceFlow id="SequenceFlow_25" sourceRef="ManualTask_1" targetRef="EndEvent_1"/>
    <endEvent id="EndEvent_1">
      <incoming>SequenceFlow_24</incoming>
      <incoming>SequenceFlow_25</incoming>
    </endEvent>
  </process>
</definitions>