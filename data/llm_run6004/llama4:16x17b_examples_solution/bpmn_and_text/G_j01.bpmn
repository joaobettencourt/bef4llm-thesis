<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/06-02-01.xsd" 
             id="definitions" targetNamespace="http://www.example.com">
  <process id="FarmingBotProcess" isExecutable="true">
    <startEvent id="StartGame">
      <outgoing>DetermineResources</outgoing>
    </startEvent>
    <sequenceFlow id="DetermineResources" sourceRef="StartGame" targetRef="GatherPreferences"/>
    <userTask id="GatherPreferences" name="Create Farming List">
      <incoming>DetermineResources</incoming>
      <outgoing>CreateFarmingList</outgoing>
    </userTask>
    <sequenceFlow id="CreateFarmingList" sourceRef="GatherPreferences" targetRef="CheckAvailableResources"/>
    <scriptTask id="CheckAvailableResources" name="Check available resources">
      <incoming>CreateFarmingList</incoming>
      <outgoing>AdjustTheList</outgoing>
    </scriptTask>
    <sequenceFlow id="AdjustTheList" sourceRef="CheckAvailableResources" targetRef="ExclusiveGateway_1"/>
    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>AdjustTheList</incoming>
      <outgoing>No</outgoing>
      <outgoing>Yes</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="No" name="No, start farming" sourceRef="ExclusiveGateway_1" targetRef="StartFarming">
      <conditionExpression xsi:type="tFormalExpression">${false}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Yes" name="Yes, adjust list" sourceRef="ExclusiveGateway_1" targetRef="AdjustFarmingList">
      <conditionExpression xsi:type="tFormalExpression">${true}</conditionExpression>
    </sequenceFlow>
    <userTask id="AdjustFarmingList" name="Adjust Farming List">
      <incoming>Yes</incoming>
      <outgoing>Adjusted</outgoing>
    </userTask>
    <sequenceFlow id="Adjusted" sourceRef="AdjustFarmingList" targetRef="ExclusiveGateway_1"/>
    <serviceTask id="StartFarming" name="Notify player and start farming">
      <incoming>No</incoming>
      <outgoing>Farming</outgoing>
    </serviceTask>
    <sequenceFlow id="Farming" sourceRef="StartFarming" targetRef="ParallelGateway_1"/>
    <parallelGateway id="ParallelGateway_1">
      <incoming>Farming</incoming>
      <outgoing>CollectResources</outgoing>
      <outgoing>CheckInventory</outgoing>
    </parallelGateway>
    <sequenceFlow id="CollectResources" sourceRef="ParallelGateway_1" targetRef="Task_1"/>
    <task id="Task_1" name="Collect Resources">
      <incoming>CollectResources</incoming>
      <outgoing>Collected</outgoing>
    </task>
    <sequenceFlow id="Collected" sourceRef="Task_1" targetRef="ParallelGateway_2"/>
    <parallelGateway id="ParallelGateway_2">
      <incoming>Collected</incoming>
      <outgoing>NotifyPlayer</outgoing>
      <outgoing>UpdateList</outgoing>
    </parallelGateway>
    <sequenceFlow id="NotifyPlayer" sourceRef="ParallelGateway_2" targetRef="NotifyPlayerTask"/>
    <serviceTask id="NotifyPlayerTask" name="Notify player">
      <incoming>NotifyPlayer</incoming>
    </serviceTask>
    <sequenceFlow id="UpdateList" sourceRef="ParallelGateway_2" targetRef="AdjustFarmingListUserTask"/>
    <userTask id="AdjustFarmingListUserTask" name="Update list of resources to farm">
      <incoming>UpdateList</incoming>
    </userTask>
    <sequenceFlow id="CheckInventory" sourceRef="ParallelGateway_1" targetRef="CheckInventoryTask">
      <conditionExpression xsi:type="tFormalExpression">${false}</conditionExpression>
    </sequenceFlow>
    <scriptTask id="CheckInventoryTask" name="Check Inventory for damages">
      <incoming>CheckInventory</incoming>
    </scriptTask>
    <endEvent id="FarmingBotFinished">
      <incoming>NotifyPlayer</incoming>
    </endEvent>
  </process>
</definitions>