<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">
  <collaboration id="Collaboration_1">
    <participant id="Participant_1" name="Customer" processRef="Process_1"/>
    <participant id="Participant_2" name="Architect" processRef="Process_2"/>
    <participant id="Participant_3" name="Online Store" processRef="Process_3"/>
  </collaboration>
  
  <process id="Process_1" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="UserTask_1"/>
    
    <userTask id="UserTask_1" name="Collect requirements">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </userTask>
    
    <sequenceFlow id="SequenceFlow_2" sourceRef="UserTask_1" targetRef="UserTask_2"/>
    
    <userTask id="UserTask_2" name="Send requirements to architect">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>MessageFlow_1</outgoing>
    </userTask>
    
    <sequenceFlow id="SequenceFlow_3" sourceRef="UserTask_2" targetRef="InclusiveGateway_1"/>
    
    <inclusiveGateway id="InclusiveGateway_1">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_4</outgoing>
      <outgoing>SequenceFlow_5</outgoing>
    </inclusiveGateway>
    
    <sequenceFlow id="SequenceFlow_4" name="yes" sourceRef="InclusiveGateway_1" targetRef="UserTask_3"/>
    
    <userTask id="UserTask_3" name="Refine requirements">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </userTask>
    
    <sequenceFlow id="SequenceFlow_5" name="no" sourceRef="InclusiveGateway_1" targetRef="UserTask_4"/>
    
    <userTask id="UserTask_4" name="Create material list">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </userTask>
    
    <sequenceFlow id="SequenceFlow_6" sourceRef="UserTask_3" targetRef="InclusiveGateway_1"/>
    
    <sequenceFlow id="SequenceFlow_7" sourceRef="UserTask_4" targetRef="ParallelGateway_1"/>
    
    <parallelGateway id="ParallelGateway_1">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_8</outgoing>
      <outgoing>SequenceFlow_9</outgoing>
    </parallelGateway>
    
    <sequenceFlow id="SequenceFlow_8" sourceRef="ParallelGateway_1" targetRef="UserTask_5"/>
    
    <userTask id="UserTask_5" name="Order materials online">
      <incoming>SequenceFlow_8</incoming>
      <outgoing>SequenceFlow_10</outgoing>
    </userTask>
    
    <sequenceFlow id="SequenceFlow_9" sourceRef="ParallelGateway_1" targetRef="UserTask_6"/>
    
    <userTask id="UserTask_6" name="Invite friends to build house">
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_11</outgoing>
    </userTask>
    
    <sequenceFlow id="SequenceFlow_10" sourceRef="UserTask_5" targetRef="ExclusiveGateway_1"/>
    
    <sequenceFlow id="SequenceFlow_11" sourceRef="UserTask_6" targetRef="ExclusiveGateway_1"/>
    
    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>SequenceFlow_10</incoming>
      <incoming>SequenceFlow_11</incoming>
      <outgoing>SequenceFlow_12</outgoing>
    </exclusiveGateway>
    
    <sequenceFlow id="SequenceFlow_12" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_1"/>
    
    <endEvent id="EndEvent_1">
      <incoming>SequenceFlow_12</incoming>
    </endEvent>
  </process>
  
  <process id="Process_2" isExecutable="false">
    <startEvent id="StartEvent_2">
      <incoming>MessageFlow_1</incoming>
      <outgoing>SequenceFlow_13</outgoing>
    </startEvent>
    
    <sequenceFlow id="SequenceFlow_13" sourceRef="StartEvent_2" targetRef="UserTask_7"/>
    
    <userTask id="UserTask_7" name="Send draft to customer">
      <incoming>SequenceFlow_13</incoming>
      <outgoing>MessageFlow_2</outgoing>
    </userTask>
  </process>
  
  <messageFlow id="MessageFlow_1" sourceRef="UserTask_2" targetRef="StartEvent_2"/>
  <messageFlow id="MessageFlow_2" sourceRef="UserTask_7" targetRef="InclusiveGateway_1"/>
</definitions>