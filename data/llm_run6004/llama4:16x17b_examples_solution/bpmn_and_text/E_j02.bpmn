<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/BPMN20.xsd" 
             id="definitions" targetNamespace="http://www.example.com">
   <process id="becoming_a_parent_process" isExecutable="true">
     <startEvent id="start_event_1">
       <outgoing>sequence_flow_1</outgoing>
     </startEvent>
     <sequenceFlow id="sequence_flow_1" sourceRef="start_event_1" targetRef="fetch_information"/>
     <userTask id="fetch_information" name="Fetch information about potential models">
       <outgoing>sequence_flow_2</outgoing>
     </userTask>
     <sequenceFlow id="sequence_flow_2" sourceRef="fetch_information" targetRef="select_model_gateway"/>
     <exclusiveGateway id="select_model_gateway">
       <incoming>sequence_flow_2</incoming>
       <outgoing>sequence_flow_3</outgoing>
       <outgoing>sequence_flow_4</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="sequence_flow_3" name="yes" sourceRef="select_model_gateway" targetRef="collect_relevant_information">
       <conditionExpression xsi:type="tFormalExpression">${approval == true}</conditionExpression>
     </sequenceFlow>
     <userTask id="collect_relevant_information" name="Collect relevant information">
       <outgoing>sequence_flow_5</outgoing>
     </userTask>
     <sequenceFlow id="sequence_flow_5" sourceRef="collect_relevant_information" targetRef="notify_social_security"/>
     <serviceTask id="notify_social_security" name="Notify Social Security">
       <outgoing>sequence_flow_6</outgoing>
     </serviceTask>
     <sequenceFlow id="sequence_flow_6" sourceRef="notify_social_security" targetRef="gather_information_from_companies"/>
     <userTask id="gather_information_from_companies" name="Gather information from companies">
       <outgoing>sequence_flow_7</outgoing>
     </userTask>
     <sequenceFlow id="sequence_flow_7" sourceRef="gather_information_from_companies" targetRef="decide_about_extension_gateway"/>
     <exclusiveGateway id="decide_about_extension_gateway">
       <incoming>sequence_flow_7</incoming>
       <outgoing>sequence_flow_8</outgoing>
       <outgoing>sequence_flow_9</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="sequence_flow_8" name="yes" sourceRef="decide_about_extension_gateway" targetRef="extend_maternity_leave">
       <conditionExpression xsi:type="string">${extension_requested == true}</conditionExpression>
     </sequenceFlow>
     <userTask id="extend_maternity_leave" name="Extend maternity leave">
       <outgoing>sequence_flow_10</outgoing>
     </userTask>
     <sequenceFlow id="sequence_flow_10" sourceRef="extend_maternity_leave" targetRef="end_event"/>
     <sequenceFlow id="sequence_flow_9" name="no" sourceRef="decide_about_extension_gateway" targetRef="end_event"/>
     <endEvent id="end_event">
       <incoming>sequence_flow_10</incoming>
       <incoming>sequence_flow_9</incoming>
     </endEvent>
   </process>
</definitions>