<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">
  <process id="InternshipProcess" isExecutable="true">

    <!-- Start Event -->
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>

    <!-- User Task: Enter desired topic and amount of money -->
    <userTask id="UserTask_1" name="Enter desired topic and amount of money.">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </userTask>

    <!-- Sequence Flow -->
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="UserTask_1"/>
    <sequenceFlow id="SequenceFlow_2" sourceRef="UserTask_1" targetRef="ExclusiveGateway_1"/>

    <!-- Exclusive Gateway: Offers arrival -->
    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
      <outgoing>SequenceFlow_4</outgoing>
    </exclusiveGateway>

    <!-- Sequence Flows from Exclusive Gateway -->
    <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_1" targetRef="UserTask_2">
      <conditionExpression xsi:type="tFormalExpression">${offerArrived}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_1" targetRef="ServiceTask_InvalidOffers"/>

    <!-- User Task: Accept or deny offers -->
    <userTask id="UserTask_2" name="Accept or deny offers.">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_5</outgoing>
      <outgoing>SequenceFlow_6</outgoing>
    </userTask>

    <!-- Sequence Flows from User Task -->
    <sequenceFlow id="SequenceFlow_5" sourceRef="UserTask_2" targetRef="ExclusiveGateway_2">
      <conditionExpression xsi:type="tFormalExpression">${offerAccepted}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="SequenceFlow_6" sourceRef="UserTask_2" targetRef="ServiceTask_InvalidateOffers"/>

    <!-- Exclusive Gateway: Offer accepted -->
    <exclusiveGateway id="ExclusiveGateway_2">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_7</outgoing>
      <outgoing>SequenceFlow_8</outgoing>
    </exclusiveGateway>

    <!-- Sequence Flows from Exclusive Gateway -->
    <sequenceFlow id="SequenceFlow_7" sourceRef="ExclusiveGateway_2" targetRef="UserTask_WriteStatusUpdates"/>
    <sequenceFlow id="SequenceFlow_8" sourceRef="ExclusiveGateway_2" targetRef="ParallelGateway_1"/>

    <!-- Service Task: Write status updates about internship -->
    <userTask id="UserTask_WriteStatusUpdates" name="Write at least 3 status updates.">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_9</outgoing>
    </userTask>

    <!-- Sequence Flow -->
    <sequenceFlow id="SequenceFlow_9" sourceRef="UserTask_WriteStatusUpdates" targetRef="ParallelGateway_1"/>

    <!-- Parallel Gateway: Send tweets in parallel -->
    <parallelGateway id="ParallelGateway_1">
      <incoming>SequenceFlow_8</incoming>
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_10</outgoing>
    </parallelGateway>

    <!-- Sequence Flows from Parallel Gateway -->
    <sequenceFlow id="SequenceFlow_10" sourceRef="ParallelGateway_1" targetRef="ServiceTask_SendTweets"/>

    <!-- Service Task: Send tweets -->
    <sendTask id="ServiceTask_SendTweets" name="Send separate tweets.">
      <incoming>SequenceFlow_10</incoming>
    </sendTask>

    <!-- Service Tasks -->
    <serviceTask id="ServiceTask_InvalidOffers" name="Make other offers invalid">
      <incoming>SequenceFlow_4</incoming>
    </serviceTask>
    <serviceTask id="ServiceTask_InvalidateOffers" name="Invalidate other offers">
      <incoming>SequenceFlow_6</incoming>
    </serviceTask>

    <!-- End Event -->
    <endEvent id="EndEvent_1">
      <incoming>SequenceFlow_10</incoming>
    </endEvent>

  </process>
</definitions>