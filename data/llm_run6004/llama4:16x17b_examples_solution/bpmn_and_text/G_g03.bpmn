<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="definitions" targetNamespace="http://www.example.com">
   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>
     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_Group_1"/>
     <task id="Task_Group_1" name="Group Task">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_Group_1" targetRef="ExclusiveGateway_1"/>
     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_4</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_1" targetRef="Task_Account_Info">
       <conditionExpression xsi:type="tFormalExpression">${hasBattleNetAccount == false}</conditionExpression>
     </sequenceFlow>
     <task id="Task_Account_Info" name="Enter account information">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_Account_Info" targetRef="ServiceTask_Confirm_Email"/>
     <serviceTask id="ServiceTask_Confirm_Email" name="Click link in confirmation mail">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </serviceTask>
     <sequenceFlow id="SequenceFlow_6" sourceRef="ServiceTask_Confirm_Email" targetRef="ExclusiveGateway_2"/>
     <exclusiveGateway id="ExclusiveGateway_2">
       <incoming>SequenceFlow_6</incoming>
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_8</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_1" targetRef="ExclusiveGateway_2">
       <conditionExpression xsi:type="tFormalExpression">${hasBattleNetAccount == true}</conditionExpression>
     </sequenceFlow>
     <sequenceFlow id="SequenceFlow_7" sourceRef="ExclusiveGateway_2" targetRef="ServiceTask_Check_Subscription">
       <conditionExpression xsi:type="tFormalExpression">${hasWoWSubscription == false}</conditionExpression>
     </sequenceFlow>
     <serviceTask id="ServiceTask_Check_Subscription" name="Check WoW subscription">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </serviceTask>
     <exclusiveGateway id="ExclusiveGateway_3">
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_10</outgoing>
       <outgoing>SequenceFlow_11</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_9" sourceRef="ServiceTask_Check_Subscription" targetRef="ExclusiveGateway_3"/>
     <task id="Task_Payment_Method" name="Select payment method">
       <incoming>SequenceFlow_10</incoming>
       <outgoing>SequenceFlow_12</outgoing>
     </task>
     <exclusiveGateway id="ExclusiveGateway_4">
       <incoming>SequenceFlow_12</incoming>
       <outgoing>SequenceFlow_13</outgoing>
       <outgoing>SequenceFlow_14</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_10" sourceRef="ExclusiveGateway_3" targetRef="Task_Payment_Method">
       <conditionExpression xsi:type="tFormalExpression">${paymentMethod == 'credit card'}</conditionExpression>
     </sequenceFlow>
     <task id="Task_Credit_Card_Info" name="Enter credit card information">
       <incoming>SequenceFlow_13</incoming>
       <outgoing>SequenceFlow_15</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_13" sourceRef="ExclusiveGateway_4" targetRef="Task_Credit_Card_Info"/>
     <task id="Task_Bank_Account_Info" name="Enter bank account information">
       <incoming>SequenceFlow_14</incoming>
       <outgoing>SequenceFlow_16</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_14" sourceRef="ExclusiveGateway_4" targetRef="Task_Bank_Account_Info"/>
     <parallelGateway id="ParallelGateway_1">
       <incoming>SequenceFlow_15</incoming>
       <incoming>SequenceFlow_16</incoming>
       <outgoing>SequenceFlow_17</outgoing>
     </parallelGateway>
     <sequenceFlow id="SequenceFlow_15" sourceRef="Task_Credit_Card_Info" targetRef="ParallelGateway_1"/>
     <sequenceFlow id="SequenceFlow_16" sourceRef="Task_Bank_Account_Info" targetRef="ParallelGateway_1"/>
     <sequenceFlow id="SequenceFlow_17" sourceRef="ParallelGateway_1" targetRef="Task_Select_Realm_Race_Class"/>
     <task id="Task_Select_Realm_Race_Class" name="Select realm, race and class">
       <incoming>SequenceFlow_17</incoming>
       <outgoing>SequenceFlow_18</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_18" sourceRef="Task_Select_Realm_Race_Class" targetRef="ParallelGateway_2"/>
     <parallelGateway id="ParallelGateway_2">
       <incoming>SequenceFlow_18</incoming>
       <outgoing>SequenceFlow_19</outgoing>
       <outgoing>SequenceFlow_20</outgoing>
     </parallelGateway>
     <sequenceFlow id="SequenceFlow_19" sourceRef="ParallelGateway_2" targetRef="Task_Enter_Name"/>
     <task id="Task_Enter_Name" name="Enter character name">
       <incoming>SequenceFlow_19</incoming>
       <outgoing>SequenceFlow_21</outgoing>
     </task>
     <exclusiveGateway id="ExclusiveGateway_5">
       <incoming>SequenceFlow_21</incoming>
       <outgoing>SequenceFlow_22</outgoing>
       <outgoing>SequenceFlow_23</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_21" sourceRef="Task_Enter_Name" targetRef="ExclusiveGateway_5"/>
     <serviceTask id="ServiceTask_Check_Name_Availability" name="Check availability of character name">
       <incoming>SequenceFlow_22</incoming>
       <outgoing>SequenceFlow_24</outgoing>
     </serviceTask>
     <sequenceFlow id="SequenceFlow_22" sourceRef="ExclusiveGateway_5" targetRef="ServiceTask_Check_Name_Availability"/>
     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_24</incoming>
     </endEvent>
   </process>
</definitions>