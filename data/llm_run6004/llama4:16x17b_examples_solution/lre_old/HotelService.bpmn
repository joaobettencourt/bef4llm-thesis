<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="The Evanstonian Room Service Process" targetNamespace="http://bpmn.io/schema/bpmn">

   <process id="Process_1" isExecutable="true">
     <laneSet>
       <lane id="Lane_0" name="Room-Service Manager">
         <flowNodeRef>StartEvent_1</flowNodeRef>
         <flowNodeRef>Task_TakeDownOrder</flowNodeRef>
         <flowNodeRef>ParallelGateway_1</flowNodeRef>
         <flowNodeRef>Task_GiveOrderToSommelier</flowNodeRef>
         <flowNodeRef>Task_SubmitOrderTicketToKitchen</flowNodeRef>
       </lane>

       <lane id="Lane_1" name="Sommelier">
         <flowNodeRef>Task_FetchWineFromCellar</flowNodeRef>
         <flowNodeRef>Task_PrepareAlcoholicBeverages</flowNodeRef>
       </lane>

       <lane id="Lane_2" name="Kitchen">
         <flowNodeRef>Task_PrepareMeal</flowNodeRef>
       </lane>

       <lane id="Lane_3" name="Waiter">
         <flowNodeRef>ParallelGateway_0</flowNodeRef>
         <flowNodeRef>Task_ReadyCart</flowNodeRef>
         <flowNodeRef>Task_DeliverToGuestsRoom</flowNodeRef>
         <flowNodeRef>Task_ReturnToRoomServiceStation</flowNodeRef>
       </lane>

     </laneSet>

     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_0</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_0" sourceRef="StartEvent_1" targetRef="Task_TakeDownOrder"/>

     <task id="Task_TakeDownOrder" name="Take down order">
       <incoming>SequenceFlow_0</incoming>
       <outgoing>SequenceFlow_1</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_1" sourceRef="Task_TakeDownOrder" targetRef="ParallelGateway_1"/>

     <parallelGateway id="ParallelGateway_1">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_4</outgoing>
     </parallelGateway>

     <sequenceFlow id="SequenceFlow_2" sourceRef="ParallelGateway_1" targetRef="Task_SubmitOrderTicketToKitchen"/>

     <task id="Task_SubmitOrderTicketToKitchen" name="Submit order ticket to kitchen">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_3" sourceRef="ParallelGateway_1" targetRef="Task_GiveOrderToSommelier"/>

     <task id="Task_GiveOrderToSommelier" name="Give order to sommelier">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_4" sourceRef="ParallelGateway_1" targetRef="Task_AssignOrderToWaiter"/>

     <task id="Task_AssignOrderToWaiter" name="Assign order to waiter">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_7</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_SubmitOrderTicketToKitchen" targetRef="Task_PrepareMeal"/>

     <task id="Task_PrepareMeal" name="Prepare meal">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_8</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_GiveOrderToSommelier"
                   targetRef="InclusiveGateway_0"/>

     <inclusiveGateway id="InclusiveGateway_0">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_9</outgoing>
       <outgoing>SequenceFlow_10</outgoing>
     </inclusiveGateway>

     <sequenceFlow id="SequenceFlow_7" sourceRef="Task_AssignOrderToWaiter"
                   targetRef="ParallelGateway_0"/>

     <parallelGateway id="ParallelGateway_0">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_11</outgoing>
     </parallelGateway>

     <sequenceFlow id="SequenceFlow_8" sourceRef="Task_PrepareMeal"
                   targetRef="ExclusiveGateway_1"/>

     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_12</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_9" sourceRef="InclusiveGateway_0"
                   targetRef="Task_FetchWineFromCellar"/>

     <task id="Task_FetchWineFromCellar" name="Fetch wine from cellar">
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_13</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_10" sourceRef="InclusiveGateway_0"
                   targetRef="Task_PrepareAlcoholicBeverages"/>

     <task id="Task_PrepareAlcoholicBeverages" name="Prepare alcoholic beverages">
       <incoming>SequenceFlow_10</incoming>
       <outgoing>SequenceFlow_14</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_11" sourceRef="ParallelGateway_0"
                   targetRef="Task_ReadyCart"/>

     <task id="Task_ReadyCart" name="Ready cart">
       <incoming>SequenceFlow_11</incoming>
       <outgoing>SequenceFlow_15</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_12" sourceRef="ExclusiveGateway_1"
                   targetRef="ParallelGateway_2"/>

     <parallelGateway id="ParallelGateway_2">
       <incoming>SequenceFlow_12</incoming>
       <outgoing>SequenceFlow_16</outgoing>
       <outgoing>SequenceFlow_17</outgoing>
     </parallelGateway>

     <sequenceFlow id="SequenceFlow_13" sourceRef="Task_FetchWineFromCellar"
                   targetRef="ExclusiveGateway_0"/>

     <exclusiveGateway id="ExclusiveGateway_0">
       <incoming>SequenceFlow_13</incoming>
       <outgoing>SequenceFlow_18</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_14" sourceRef="Task_PrepareAlcoholicBeverages"
                   targetRef="ExclusiveGateway_0"/>

     <sequenceFlow id="SequenceFlow_15" sourceRef="Task_ReadyCart"
                   targetRef="Task_DeliverToGuestsRoom"/>

     <task id="Task_DeliverToGuestsRoom" name="Deliver to guest's room">
       <incoming>SequenceFlow_15</incoming>
       <outgoing>SequenceFlow_19</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_16" sourceRef="ParallelGateway_2"
                   targetRef="Task_ReturnToRoomServiceStation"/>

     <task id="Task_ReturnToRoomServiceStation" name="Return to room-service station">
       <incoming>SequenceFlow_16</incoming>
       <outgoing>SequenceFlow_20</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_17" sourceRef="ParallelGateway_2"
                   targetRef="Task_DebitGuestsAccount"/>

     <task id="Task_DebitGuestsAccount" name="Debit guest's account">
       <incoming>SequenceFlow_17</incoming>
     </task>

     <sequenceFlow id="SequenceFlow_18" sourceRef="ExclusiveGateway_0"
                   targetRef="ParallelGateway_2"/>

     <sequenceFlow id="SequenceFlow_19" sourceRef="Task_DeliverToGuestsRoom"
                   targetRef="Task_ReturnToRoomServiceStation"/>

     <sequenceFlow id="SequenceFlow_20" sourceRef="Task_ReturnToRoomServiceStation"/>
   </process>
</definitions>