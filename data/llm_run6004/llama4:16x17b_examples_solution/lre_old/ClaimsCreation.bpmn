<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Claims Handling Process" targetNamespace="http://example.com/bpmn">

   <process id="Process_1" isExecutable="true">
     <laneSet>
       <lane id="Lane_Clerk" name="Clerk">
         <flowNodeRef>StartEvent_1</flowNodeRef>
         <flowNodeRef>Task_SearchPoliceReport</flowNodeRef>
         <flowNodeRef>Task_ComposeFile</flowNodeRef>
       </lane>
       <lane id="Lane_ClaimsHandler" name="Claims Handler">
         <flowNodeRef>Task_CalculateClaimEstimate</flowNodeRef>
         <flowNodeRef>Task_CreateActionPlan</flowNodeRef>
       </lane>
       <lane id="Lane_ClaimsManager" name="Claims Manager">
         <flowNodeRef>Task_NegotiateSettlement</flowNodeRef>
       </lane>
     </laneSet>

     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_StartToSearchPoliceReport</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_StartToSearchPoliceReport" sourceRef="StartEvent_1" targetRef="Task_SearchPoliceReport"/>

     <task id="Task_SearchPoliceReport" name="Search police report database">
       <incoming>SequenceFlow_StartToSearchPoliceReport</incoming>
       <outgoing>SequenceFlow_SearchPoliceReportToComposeFile</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_SearchPoliceReportToComposeFile" sourceRef="Task_SearchPoliceReport" targetRef="Task_ComposeFile"/>

     <task id="Task_ComposeFile" name="Compose file">
       <incoming>SequenceFlow_SearchPoliceReportToComposeFile</incoming>
       <outgoing>SequenceFlow_ComposeFileToCalculateClaimEstimate</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_ComposeFileToCalculateClaimEstimate" sourceRef="Task_ComposeFile" targetRef="Task_CalculateClaimEstimate"/>

     <task id="Task_CalculateClaimEstimate" name="Calculate claim estimate">
       <incoming>SequenceFlow_ComposeFileToCalculateClaimEstimate</incoming>
       <outgoing>SequenceFlow_CalculateClaimEstimateToCreateActionPlan</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_CalculateClaimEstimateToCreateActionPlan" sourceRef="Task_CalculateClaimEstimate" targetRef="Task_CreateActionPlan"/>

     <task id="Task_CreateActionPlan" name="Create action plan">
       <incoming>SequenceFlow_CalculateClaimEstimateToCreateActionPlan</incoming>
       <outgoing>SequenceFlow_CreateActionPlanToNegotiateSettlement</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_CreateActionPlanToNegotiateSettlement" sourceRef="Task_CreateActionPlan" targetRef="Task_NegotiateSettlement"/>

     <task id="Task_NegotiateSettlement" name="Negotiate estimate settlement">
       <incoming>SequenceFlow_CreateActionPlanToNegotiateSettlement</incoming>
       <outgoing>SequenceFlow_NegotiateSettlementToNotifyClaimant</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_NegotiateSettlementToNotifyClaimant" sourceRef="Task_NegotiateSettlement" targetRef="Task_NotifyClaimant"/>

     <task id="Task_NotifyClaimant" name="Notify claimant">
       <incoming>SequenceFlow_NegotiateSettlementToNotifyClaimant</incoming>
       <outgoing>SequenceFlow_NotifyClaimantToEndEvent</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_NotifyClaimantToEndEvent" sourceRef="Task_NotifyClaimant" targetRef="EndEvent_1"/>

     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_NotifyClaimantToEndEvent</incoming>
     </endEvent>

   </process>
</definitions>