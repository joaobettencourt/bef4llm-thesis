<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Text Description" targetNamespace="http://bpmn.io/schema/bpmn">

   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_Examine_Bill"/>

     <task id="Task_Examine_Bill" name="Examine Bill">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_Examine_Bill" targetRef="ExclusiveGateway_1"/>

     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_4</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_3" name="Confirm" sourceRef="ExclusiveGateway_1" targetRef="Task_Confirm_Bill">
       <conditionExpression xsi:type="tFormalExpression">${billConfirmed  == true}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="SequenceFlow_4" name="Reject" sourceRef="ExclusiveGateway_1" targetRef="Task_Reject_Bill">
       <conditionExpression xsi:type="tFormalExpression">${billRejected  == true}</conditionExpression>
     </sequenceFlow>

     <task id="Task_Confirm_Bill" name="Confirm Bill with Payment Advice">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>

     <task id="Task_Reject_Bill" name="Reject Bill">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_Confirm_Bill" targetRef="EndEvent_1"/>
     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_Reject_Bill" targetRef="EndEvent_1"/>

     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_5</incoming>
       <incoming>SequenceFlow_6</incoming>
     </endEvent>

   </process>
</definitions>