<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" 
             targetNamespace="http://example.com/bpmn">

   <process id="Process_1" isExecutable="true">
     <laneSet>
       <lane id="Lane_MailProcessingUnit" name="Mail Processing Unit">
         <flowNodeRef>StartEvent_1</flowNodeRef>
         <flowNodeRef>Task_CollectMail</flowNodeRef>
         <flowNodeRef>Task_SortUnopenedMail</flowNodeRef>
       </lane>
       <lane id="Lane_Registry" name="Registry">
         <flowNodeRef>Task_SortOpenedMail</flowNodeRef>
         <flowNodeRef>Task_RegisterMail</flowNodeRef>
         <flowNodeRef>Task_CheckCompliance</flowNodeRef>
         <flowNodeRef>ExclusiveGateway_QualityCheck</flowNodeRef>
         <flowNodeRef>Task_PrepareRequisition</flowNodeRef>
         <flowNodeRef>EndEvent_Rejected</flowNodeRef>
       </lane>
       <lane id="Lane_Cashier" name="Cashier">
         <flowNodeRef>ExclusiveGateway_FeePayment</flowNodeRef>
         <flowNodeRef>Task_ReceiveFee</flowNodeRef>
         <flowNodeRef>Task_PrintPhysicalFile</flowNodeRef>
         <flowNodeRef>EndEvent_FilePrepared</flowNodeRef>
       </lane>
     </laneSet>

     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_StartToCollectMail</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_StartToCollectMail" sourceRef="StartEvent_1" targetRef="Task_CollectMail"/>

     <task id="Task_CollectMail" name="Collect mail">
       <incoming>SequenceFlow_StartToCollectMail</incoming>
       <outgoing>SequenceFlow_CollectToSortUnopenedMail</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_CollectToSortUnopenedMail" sourceRef="Task_CollectMail" targetRef="Task_SortUnopenedMail"/>

     <task id="Task_SortUnopenedMail" name="Sort unopened mail">
       <incoming>SequenceFlow_CollectToSortUnopenedMail</incoming>
       <outgoing>SequenceFlow_SortUnopenedToSortOpenedMail</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_SortUnopenedToSortOpenedMail" sourceRef="Task_SortUnopenedMail" targetRef="Task_SortOpenedMail"/>

     <task id="Task_SortOpenedMail" name="Sort opened mail">
       <incoming>SequenceFlow_SortUnopenedToSortOpenedMail</incoming>
       <outgoing>SequenceFlow_SortOpenedToRegisterMail</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_SortOpenedToRegisterMail" sourceRef="Task_SortOpenedMail" targetRef="Task_RegisterMail"/>

     <task id="Task_RegisterMail" name="Register mail">
       <incoming>SequenceFlow_SortOpenedToRegisterMail</incoming>
       <outgoing>SequenceFlow_RegisterToCheckCompliance</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_RegisterToCheckCompliance" sourceRef="Task_RegisterMail" targetRef="Task_CheckCompliance"/>

     <task id="Task_CheckCompliance" name="Check compliance">
       <incoming>SequenceFlow_RegisterToCheckCompliance</incoming>
       <outgoing>SequenceFlow_CheckToQualityGateway</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_CheckToQualityGateway" sourceRef="Task_CheckCompliance" targetRef="ExclusiveGateway_QualityCheck"/>

     <exclusiveGateway id="ExclusiveGateway_QualityCheck">
       <incoming>SequenceFlow_CheckToQualityGateway</incoming>
       <outgoing>SequenceFlow_NotCompliantToPrepareRequisition</outgoing>
       <outgoing>SequenceFlow_CompliantToReceiveFee</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_NotCompliantToPrepareRequisition" sourceRef="ExclusiveGateway_QualityCheck" targetRef="Task_PrepareRequisition">
       <conditionExpression xsi:type="tFormalExpression">${not compliant}</conditionExpression>
     </sequenceFlow>

     <task id="Task_PrepareRequisition" name="Compile requisition">
       <incoming>SequenceFlow_NotCompliantToPrepareRequisition</incoming>
       <outgoing>SequenceFlow_RequisitionToEndRejected</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_RequisitionToEndRejected" sourceRef="Task_PrepareRequisition" targetRef="EndEvent_Rejected"/>

     <endEvent id="EndEvent_Rejected">
       <incoming>SequenceFlow_RequisitionToEndRejected</incoming>
     </endEvent>

     <sequenceFlow id="SequenceFlow_CompliantToReceiveFee" name="Compliant" sourceRef="ExclusiveGateway_QualityCheck" targetRef="Task_ReceiveFee"/>

     <task id="Task_ReceiveFee" name="Receive fee payment">
       <incoming>SequenceFlow_CompliantToReceiveFee</incoming>
       <outgoing>SequenceFlow_FeePaidToFilePrinted</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_FeePaidToFilePrinted" sourceRef="Task_ReceiveFee" targetRef="ExclusiveGateway_FeePayment"/>

     <exclusiveGateway id="ExclusiveGateway_FeePayment">
       <incoming>SequenceFlow_FeePaidToFilePrinted</incoming>
       <outgoing>SequenceFlow_PaidToPrintPhysicalFile</outgoing>
       <outgoing>SequenceFlow_NotApplicableToEndEvent</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_PaidToPrintPhysicalFile" sourceRef="ExclusiveGateway_FeePayment" targetRef="Task_PrintPhysicalFile"/>

     <task id="Task_PrintPhysicalFile" name="Capture details and print physical file">
       <incoming>SequenceFlow_PaidToPrintPhysicalFile</incoming>
       <outgoing>SequenceFlow_FilePrintedToEndEvent</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_FilePrintedToEndEvent" sourceRef="Task_PrintPhysicalFile" targetRef="EndEvent_FilePrepared"/>

     <endEvent id="EndEvent_FilePrepared">
       <incoming>SequenceFlow_FilePrintedToEndEvent</incoming>
     </endEvent>

   </process>
</definitions>