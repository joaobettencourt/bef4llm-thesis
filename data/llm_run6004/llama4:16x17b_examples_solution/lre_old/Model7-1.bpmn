<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Lead Processing" targetNamespace="http://example.com/bpmn">

   <process id="Process_1" isExecutable="true">
     <laneSet>
       <lane id="Lane_Manager" name="Manager">
         <flowNodeRef>StartEvent_1</flowNodeRef>
         <flowNodeRef>Task_CheckOpenLeads</flowNodeRef>
         <flowNodeRef>Task_SelectTopFiveLeads</flowNodeRef>
         <flowNodeRef>Task_ProcessLead</flowNodeRef>
         <flowNodeRef>ExclusiveGateway_1</flowNodeRef>
         <flowNodeRef>EndEvent_1</flowNodeRef>
       </lane>
       <lane id="Lane_SalesAssistant" name="Sales Assistant">
         <flowNodeRef>Task_CallContactPerson</flowNodeRef>
       </lane>
     </laneSet>

     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_StartToCheckOpenLeads</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_StartToCheckOpenLeads" sourceRef="StartEvent_1" targetRef="Task_CheckOpenLeads"/>

     <task id="Task_CheckOpenLeads" name="Check open leads">
       <incoming>SequenceFlow_StartToCheckOpenLeads</incoming>
       <outgoing>SequenceFlow_CheckToSelect</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_CheckToSelect" sourceRef="Task_CheckOpenLeads" targetRef="Task_SelectTopFiveLeads"/>

     <task id="Task_SelectTopFiveLeads" name="Select top five leads">
       <incoming>SequenceFlow_CheckToSelect</incoming>
       <outgoing>SequenceFlow_SelectToCall</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_SelectToCall" sourceRef="Task_SelectTopFiveLeads" targetRef="Task_CallContactPerson"/>

     <task id="Task_CallContactPerson" name="Call contact person">
       <incoming>SequenceFlow_SelectToCall</incoming>
       <outgoing>SequenceFlow_CallToGateway</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_CallToGateway" sourceRef="Task_CallContactPerson" targetRef="ExclusiveGateway_1"/>

     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_CallToGateway</incoming>
       <outgoing>SequenceFlow_GatewayToProcess</outgoing>
       <outgoing>SequenceFlow_GatewayToCall</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_GatewayToProcess" sourceRef="ExclusiveGateway_1" targetRef="Task_ProcessLead">
       <conditionExpression xsi:type="tFormalExpression">${lead. interested == true}</conditionExpression>
     </sequenceFlow>

     <task id="Task_ProcessLead" name="Process lead">
       <incoming>SequenceFlow_GatewayToProcess</incoming>
       <outgoing>SequenceFlow_ProcessToEnd</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_ProcessToEnd" sourceRef="Task_ProcessLead" targetRef="EndEvent_1"/>

     <sequenceFlow id="SequenceFlow_GatewayToCall" sourceRef="ExclusiveGateway_1" targetRef="Task_CallContactPerson"/>

     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_ProcessToEnd</incoming>
     </endEvent>

   </process>
</definitions>