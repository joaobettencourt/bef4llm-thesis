<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" 
             targetNamespace="http://bpmn.io/schema/bpmn">

   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_0"/>

     <task id="Task_0" name="Enter customer data object">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_0" targetRef="ExclusiveGateway_0"/>

     <exclusiveGateway id="ExclusiveGateway_0">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_4</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_3" name="yes" sourceRef="ExclusiveGateway_0" targetRef="Task_1">
       <conditionExpression xsi:type="tFormalExpression">${order.needSpecialHandling  == true}</conditionExpression>
     </sequenceFlow>

     <task id="Task_1" name="Handle Special Order">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_4" name="no" sourceRef="ExclusiveGateway_0" targetRef="Task_2"/>

     <task id="Task_2" name="Process Order">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_1" targetRef="EndEvent_0"/>
     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_2" targetRef="EndEvent_0"/>

     <endEvent id="EndEvent_0">
       <incoming>SequenceFlow_5</incoming>
       <incoming>SequenceFlow_6</incoming>
     </endEvent>

   </process>
</definitions>