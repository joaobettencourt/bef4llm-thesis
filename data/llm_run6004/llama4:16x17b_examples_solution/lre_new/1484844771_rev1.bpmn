<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" 
             targetNamespace="http://bpmn.io/schema/bpmn">
   <process id="InvoiceProcess" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>
     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_VendorLocation"/>
     <task id="Task_VendorLocation" name="Locate Vendor in SAP system">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_VendorLocation" targetRef="ExclusiveGateway_VendorExists"/>
     <exclusiveGateway id="ExclusiveGateway_VendorExists">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_4</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_3" name="Vendor does not exist" sourceRef="ExclusiveGateway_VendorExists" targetRef="SubProcess_NewVendorRecord">
       <!-- Add condition expression here -->
     </sequenceFlow>
     <subProcess id="SubProcess_NewVendorRecord" name="Record new Vendor">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_5</outgoing>
       <startEvent id="StartEvent_NewVendor">
         <outgoing>SequenceFlow_6</outgoing>
       </startEvent>
       <sequenceFlow id="SequenceFlow_6" sourceRef="StartEvent_NewVendor" targetRef="Task_FillOutRequestForm"/>
       <task id="Task_FillOutRequestForm" name="Fill out request for new Vendor Master Record form">
         <incoming>SequenceFlow_6</incoming>
         <outgoing>SequenceFlow_7</outgoing>
       </task>
       <sequenceFlow id="SequenceFlow_7" sourceRef="Task_FillOutRequestForm" targetRef="Task_AttachRequestToInvoice"/>
       <task id="Task_AttachRequestToInvoice" name="Staple request to invoice">
         <incoming>SequenceFlow_7</incoming>
         <outgoing>SequenceFlow_8</outgoing>
       </task>
       <sequenceFlow id="SequenceFlow_8" sourceRef="Task_AttachRequestToInvoice" targetRef="Task_PlaceInInternalOutbox"/>
       <task id="Task_PlaceInInternalOutbox" name="Place invoice in internal outbox for new vendors">
         <incoming>SequenceFlow_8</incoming>
         <outgoing>SequenceFlow_9</outgoing>
       </task>
       <sequenceFlow id="SequenceFlow_9" sourceRef="Task_PlaceInInternalOutbox" targetRef="ExclusiveGateway_UrgentInvoice"/>
       <exclusiveGateway id="ExclusiveGateway_UrgentInvoice">
         <incoming>SequenceFlow_9</incoming>
         <outgoing>SequenceFlow_10</outgoing>
         <outgoing>SequenceFlow_11</outgoing>
       </exclusiveGateway>
       <sequenceFlow id="SequenceFlow_10" name="Urgent invoice" sourceRef="ExclusiveGateway_UrgentInvoice" targetRef="IntermediateCatchEvent_24Hours">
         <!-- Add condition expression here -->
       </sequenceFlow>
       <intermediateCatchEvent id="IntermediateCatchEvent_24Hours" name="24 hours">
         <incoming>SequenceFlow_10</incoming>
         <outgoing>SequenceFlow_12</outgoing>
         <timerEventDefinition/>
       </intermediateCatchEvent>
       <sequenceFlow id="SequenceFlow_12" sourceRef="IntermediateCatchEvent_24Hours" targetRef="EndEvent_SubProcess"/>
       <endEvent id="EndEvent_SubProcess">
         <incoming>SequenceFlow_12</incoming>
       </endEvent>
       <sequenceFlow id="SequenceFlow_11" name="Non-urgent invoice" sourceRef="ExclusiveGateway_UrgentInvoice" targetRef="IntermediateCatchEvent_1To5Days">
         <!-- Add condition expression here -->
       </sequenceFlow>
       <intermediateCatchEvent id="IntermediateCatchEvent_1To5Days" name="1-5 working days">
         <incoming>SequenceFlow_11</incoming>
         <outgoing>SequenceFlow_13</outgoing>
         <timerEventDefinition/>
       </intermediateCatchEvent>
       <sequenceFlow id="SequenceFlow_13" sourceRef="IntermediateCatchEvent_1To5Days" targetRef="EndEvent_SubProcess"/>
     </subProcess>
     <sequenceFlow id="SequenceFlow_4" name="Vendor Exists" sourceRef="ExclusiveGateway_VendorExists" targetRef="Task_AddSAPNumberToInvoice">
       <!-- Add condition expression here -->
     </sequenceFlow>
     <task id="Task_AddSAPNumberToInvoice" name="Add SAP Vendor number to invoice">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_14</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_14" sourceRef="Task_AddSAPNumberToInvoice" targetRef="ExclusiveGateway_SortInvoices"/>
     <exclusiveGateway id="ExclusiveGateway_SortInvoices">
       <incoming>SequenceFlow_14</incoming>
       <outgoing>SequenceFlow_15</outgoing>
       <outgoing>SequenceFlow_16</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_15" name="Sort by Vendor" sourceRef="ExclusiveGateway_SortInvoices" targetRef="Task_SortByVendor"/>
     <task id="Task_SortByVendor" name="Sort invoices by vendor">
       <incoming>SequenceFlow_15</incoming>
       <outgoing>SequenceFlow_17</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_17" sourceRef="Task_SortByVendor" targetRef="Task_EnterIntoSAP"/>
     <sequenceFlow id="SequenceFlow_16" name="Sort by Amount" sourceRef="ExclusiveGateway_SortInvoices" targetRef="Task_SortByAmount"/>
     <task id="Task_SortByAmount" name="Sort invoices by amount">
       <incoming>SequenceFlow_16</incoming>
       <outgoing>SequenceFlow_18</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_18" sourceRef="Task_SortByAmount" targetRef="Task_EnterIntoSAP"/>
     <task id="Task_EnterIntoSAP" name="Invoices entered into SAP system">
       <incoming>SequenceFlow_17</incoming>
       <incoming>SequenceFlow_18</incoming>
       <outgoing>SequenceFlow_19</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_19" sourceRef="Task_EnterIntoSAP" targetRef="EndEvent_1"/>
     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_19</incoming>
     </endEvent>
   </process>
</definitions>