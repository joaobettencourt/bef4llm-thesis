<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" 
             targetNamespace="http://bpmn.io/schema/bpmn">
   <process id="buyHardwareProcess" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
       <messageEventDefinition/>
     </startEvent>
     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_AnalyzeRequest"/>
     
     <task id="Task_AnalyzeRequest">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_AnalyzeRequest" targetRef="ExclusiveGateway_1"/>
     
     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_4</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_3" name="approved" sourceRef="ExclusiveGateway_1" targetRef="Task_EditRequest"/>
     <sequenceFlow id="SequenceFlow_4" name="denied" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_InformedAboutDenial"/>
     
     <task id="Task_EditRequest">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_EditRequest" targetRef="IntermediateThrowEvent_AskSupplierAboutPrices"/>
     
     <intermediateThrowEvent id="IntermediateThrowEvent_AskSupplierAboutPrices">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_6</outgoing>
       <messageEventDefinition/>
     </intermediateThrowEvent>
     <sequenceFlow id="SequenceFlow_6" sourceRef="IntermediateThrowEvent_AskSupplierAboutPrices" targetRef="IntermediateCatchEvent_ReceiveOffer"/>
     
     <intermediateCatchEvent id="IntermediateCatchEvent_ReceiveOffer">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_7</outgoing>
       <messageEventDefinition/>
     </intermediateCatchEvent>
     <sequenceFlow id="SequenceFlow_7" sourceRef="IntermediateCatchEvent_ReceiveOffer" targetRef="Task_FillInFormAndSendToManagement"/>
     
     <task id="Task_FillInFormAndSendToManagement">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_8</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_8" sourceRef="Task_FillInFormAndSendToManagement" targetRef="Task_AnalyzeRequestByManagement"/>
     
     <task id="Task_AnalyzeRequestByManagement">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_AnalyzeRequestByManagement" targetRef="ExclusiveGateway_2"/>
     
     <exclusiveGateway id="ExclusiveGateway_2">
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_10</outgoing>
       <outgoing>SequenceFlow_11</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_10" name="approved" sourceRef="ExclusiveGateway_2" targetRef="ParallelGateway_1"/>
     <sequenceFlow id="SequenceFlow_11" name="not approved" sourceRef="ExclusiveGateway_2" targetRef="ExclusiveGateway_3"/>
     
     <parallelGateway id="ParallelGateway_1">
       <incoming>SequenceFlow_10</incoming>
       <outgoing>SequenceFlow_12</outgoing>
       <outgoing>SequenceFlow_13</outgoing>
     </parallelGateway>
     <sequenceFlow id="SequenceFlow_12" sourceRef="ParallelGateway_1" targetRef="Task_PrepareOrder"/>
     <sequenceFlow id="SequenceFlow_13" sourceRef="ParallelGateway_1" targetRef="Task_FindFinanceResources"/>
     
     <task id="Task_PrepareOrder">
       <incoming>SequenceFlow_12</incoming>
       <outgoing>SequenceFlow_14</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_14" sourceRef="Task_PrepareOrder" targetRef="IntermediateThrowEvent_SendOrder"/>
     
     <intermediateThrowEvent id="IntermediateThrowEvent_SendOrder">
       <incoming>SequenceFlow_14</incoming>
       <outgoing>SequenceFlow_15</outgoing>
       <messageEventDefinition/>
     </intermediateThrowEvent>
     <sequenceFlow id="SequenceFlow_15" sourceRef="IntermediateThrowEvent_SendOrder" targetRef="IntermediateCatchEvent_OrderAccepted"/>
     
     <intermediateCatchEvent id="IntermediateCatchEvent_OrderAccepted">
       <incoming>SequenceFlow_15</incoming>
       <outgoing>SequenceFlow_16</outgoing>
       <messageEventDefinition/>
     </intermediateCatchEvent>
     <sequenceFlow id="SequenceFlow_16" sourceRef="IntermediateCatchEvent_OrderAccepted" targetRef="ParallelGateway_2"/>
     
     <parallelGateway id="ParallelGateway_2">
       <incoming>SequenceFlow_16</incoming>
       <outgoing>SequenceFlow_17</outgoing>
     </parallelGateway>
     <sequenceFlow id="SequenceFlow_17" sourceRef="ParallelGateway_2" targetRef="Task_ReceiveHwAndInvoice"/>
     
     <task id="Task_ReceiveHwAndInvoice">
       <incoming>SequenceFlow_17</incoming>
       <outgoing>SequenceFlow_18</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_18" sourceRef="Task_ReceiveHwAndInvoice" targetRef="EndEvent_ProcessCompleted"/>
     
     <exclusiveGateway id="ExclusiveGateway_3">
       <incoming>SequenceFlow_11</incoming>
       <outgoing>SequenceFlow_19</outgoing>
       <outgoing>SequenceFlow_20</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_19" name="rework" sourceRef="ExclusiveGateway_3" targetRef="Task_EditRequest"/>
     <sequenceFlow id="SequenceFlow_20" name="denied" sourceRef="ExclusiveGateway_3" targetRef="EndEvent_RequestDeniedByManagement"/>
     
     <task id="Task_FindFinanceResources">
       <incoming>SequenceFlow_13</incoming>
       <outgoing>SequenceFlow_21</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_21" sourceRef="Task_FindFinanceResources" targetRef="ParallelGateway_2"/>
     
     <endEvent id="EndEvent_InformedAboutDenial">
       <incoming>SequenceFlow_4</incoming>
     </endEvent>
     <endEvent id="EndEvent_RequestDeniedByManagement">
       <incoming>SequenceFlow_20</incoming>
     </endEvent>
     <endEvent id="EndEvent_ProcessCompleted">
       <incoming>SequenceFlow_18</incoming>
     </endEvent>
   </process>
 </definitions>