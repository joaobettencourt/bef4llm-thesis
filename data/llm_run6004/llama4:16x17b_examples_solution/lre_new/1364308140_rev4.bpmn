<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Business Process Model" targetNamespace="http://example.com/bpmn">
   <process id="OrderProcess" isExecutable="true">
     <startEvent id="StartEvent1">
       <outgoing>SequenceFlow1</outgoing>
       <messageEventDefinition/>
     </startEvent>
     <sequenceFlow id="SequenceFlow1" sourceRef="StartEvent1" targetRef="ParallelGateway1"/>
     <parallelGateway id="ParallelGateway1">
       <incoming>SequenceFlow1</incoming>
       <outgoing>SequenceFlow2</outgoing>
       <outgoing>SequenceFlow3</outgoing>
     </parallelGateway>
     <sequenceFlow id="SequenceFlow2" sourceRef="ParallelGateway1" targetRef="TaskPrepareGoods"/>
     <task id="TaskPrepareGoods">
       <incoming>SequenceFlow2</incoming>
       <outgoing>SequenceFlow4</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow4" sourceRef="TaskPrepareGoods" targetRef="GatewayMerge1"/>
     <sequenceFlow id="SequenceFlow3" sourceRef="ParallelGateway1" targetRef="TaskPrepareInvoicing">
     </sequenceFlow> 
     <task id="TaskPrepareInvoicing">
       <incoming>SequenceFlow3</incoming>
       <outgoing>SequenceFlow5</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow5" sourceRef="TaskPrepareInvoicing" targetRef="ExclusiveGateway1"/>
     <exclusiveGateway id="ExclusiveGateway1">
       <incoming>SequenceFlow5</incoming>
       <outgoing>SequenceFlow6</outgoing>
       <outgoing>SequenceFlow7</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow6" name="Customer is subsidiary and relationship not yet modeled" sourceRef="ExclusiveGateway1" targetRef="TaskAddParentCompany"/>
     <task id="TaskAddParentCompany">
       <incoming>SequenceFlow6</incoming>
       <outgoing>SequenceFlow8</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow8" sourceRef="TaskAddParentCompany" targetRef="GatewayCreateInvoice"/>
     <sequenceFlow id="SequenceFlow7" name="Customer is independent or subsidiary relationship already modeled" sourceRef="ExclusiveGateway1" targetRef="GatewayCreateInvoice"/> 
     <task id="TaskCreateInvoice">
       <incoming>SequenceFlow8</incoming>
       <incoming>SequenceFlow7</incoming>
       <outgoing>SequenceFlow9</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow9" sourceRef="TaskCreateInvoice" targetRef="IntermediateThrowEvent1"/>
     <intermediateThrowEvent id="IntermediateThrowEvent1">
       <incoming>SequenceFlow9</incoming>
       <outgoing>SequenceFlow10</outgoing>
       <messageEventDefinition/>
     </intermediateThrowEvent>
     <sequenceFlow id="SequenceFlow10" sourceRef="IntermediateThrowEvent1" targetRef="EndEvent1"/>
     <endEvent id="EndEvent1">
       <incoming>SequenceFlow10</incoming>
     </endEvent>
     <gateway id="ParallelGateway1"/> 
     <gateway id="ExclusiveGateway1"/>  
     <gateway id="GatewayMerge1"> 
        <incoming > SequenceFlow4</incoming> 
         <incoming >SequenceFlow10</incoming> 
    </gateway>
   </process>
</definitions>