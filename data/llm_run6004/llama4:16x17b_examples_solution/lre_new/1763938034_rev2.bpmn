<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd http://www.omg.org/spec/DD/20100524/DC/20100524/06-02-01.xsd" 
             id="definition" name="Reward and Training Process">
   <process id="RewardsAndTrainingProcess" isExecutable="true">
     <laneSet>
       <lane id="ManagementLane" name="Management">
         <flowNodeRef>StartEvent</flowNodeRef>
         <flowNodeRef>CheckPerformanceTask</flowNodeRef>
         <flowNodeRef>SuggestDismissalTask</flowNodeRef>
         <flowNodeRef>SuggestTrainingTask</flowNodeRef>
         <flowNodeRef>SuggestForRewardTask</flowNodeRef>
         <flowNodeRef>ChooseBenefitTask</flowNodeRef>
         <flowNodeRef>AnnounceEmployeeOfTheMonthTask</flowNodeRef>
         <flowNodeRef>ExclusiveGateway1</flowNodeRef>
         <flowNodeRef>ExclusiveGateway2</flowNodeRef>
         <flowNodeRef>ExclusiveGateway3</flowNodeRef>
       </lane>
       <lane id="HRLane" name="HR">
         <flowNodeRef>DismissEmployeeTask</flowNodeRef>
         <flowNodeRef>ProvideTrainingTask</flowNodeRef>
       </lane>
       <lane id="FinanceLane" name="Finance">
         <flowNodeRef>CalculateRewardTask</flowNodeRef>
         <flowNodeRef>PayRewardTask</flowNodeRef>
       </lane>
     </laneSet>

     <startEvent id="StartEvent">
       <outgoing>SequenceFlow1</outgoing>
     </startEvent>

     <task id="CheckPerformanceTask" name="Check Employee Performance">
       <incoming>SequenceFlow1</incoming>
       <outgoing>SequenceFlow2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow1" sourceRef="StartEvent" targetRef="CheckPerformanceTask"/>

     <exclusiveGateway id="ExclusiveGateway1">
       <incoming>SequenceFlow2</incoming>
       <outgoing>SequenceFlow3</outgoing>
       <outgoing>SequenceFlow4</outgoing>
       <outgoing>SequenceFlow5</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow2" sourceRef="CheckPerformanceTask" targetRef="ExclusiveGateway1"/>

     <task id="SuggestDismissalTask" name="Suggest Employee Dismissal">
       <incoming>SequenceFlow3</incoming>
       <outgoing>SequenceFlow6</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow3" sourceRef="ExclusiveGateway1" targetRef="SuggestDismissalTask"/>

     <task id="DismissEmployeeTask" name="Dismiss Employee">
       <incoming>SequenceFlow6</incoming>
       <outgoing>SequenceFlow7</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow6" sourceRef="SuggestDismissalTask" targetRef="DismissEmployeeTask"/>

     <endEvent id="EndEvent1">
       <incoming>SequenceFlow7</incoming>
     </endEvent>

     <sequenceFlow id="SequenceFlow7" sourceRef="DismissEmployeeTask" targetRef="EndEvent1"/>

     <task id="SuggestTrainingTask" name="Suggest Training">
       <incoming>SequenceFlow4</incoming>
       <outgoing>SequenceFlow8</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow4" sourceRef="ExclusiveGateway1" targetRef="SuggestTrainingTask"/>

     <task id="ProvideTrainingTask" name="Provide Training">
       <incoming>SequenceFlow8</incoming>
       <outgoing>SequenceFlow9</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow8" sourceRef="SuggestTrainingTask" targetRef="ProvideTrainingTask"/>

     <endEvent id="EndEvent2">
       <incoming>SequenceFlow9</incoming>
     </endEvent>

     <sequenceFlow id="SequenceFlow9" sourceRef="ProvideTrainingTask" targetRef="EndEvent2"/>

     <task id="SuggestForRewardTask" name="Suggest for Reward">
       <incoming>SequenceFlow5</incoming>
       <outgoing>SequenceFlow10</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow5" sourceRef="ExclusiveGateway1" targetRef="SuggestForRewardTask"/>

     <exclusiveGateway id="ExclusiveGateway2">
       <incoming>SequenceFlow10</incoming>
       <outgoing>SequenceFlow11</outgoing>
       <outgoing>SequenceFlow12</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow10" sourceRef="SuggestForRewardTask" targetRef="ExclusiveGateway2"/>

     <task id="ChooseBenefitTask" name="Choose Appropriate Benefit">
       <incoming>SequenceFlow11</incoming>
       <outgoing>SequenceFlow13</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow11" sourceRef="ExclusiveGateway2" targetRef="ChooseBenefitTask"/>

     <task id="CalculateRewardTask" name="Calculate Reward">
       <incoming>SequenceFlow12</incoming>
       <outgoing>SequenceFlow14</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow12" sourceRef="ExclusiveGateway2" targetRef="CalculateRewardTask"/>

     <task id="PayRewardTask" name="Pay Reward">
       <incoming>SequenceFlow14</incoming>
       <outgoing>SequenceFlow15</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow14" sourceRef="CalculateRewardTask" targetRef="PayRewardTask"/>

     <exclusiveGateway id="ExclusiveGateway3">
       <incoming>SequenceFlow13</incoming>
       <incoming>SequenceFlow15</incoming>
       <outgoing>SequenceFlow16</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow13" sourceRef="ChooseBenefitTask" targetRef="ExclusiveGateway3"/>
     <sequenceFlow id="SequenceFlow15" sourceRef="PayRewardTask" targetRef="ExclusiveGateway3"/>

     <task id="AnnounceEmployeeOfTheMonthTask" name="Announce Employee of the Month">
       <incoming>SequenceFlow16</incoming>
       <outgoing>SequenceFlow17</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow16" sourceRef="ExclusiveGateway3" targetRef="AnnounceEmployeeOfTheMonthTask"/>

     <endEvent id="EndEvent3">
       <incoming>SequenceFlow17</incoming>
     </endEvent>

     <sequenceFlow id="SequenceFlow17" sourceRef="AnnounceEmployeeOfTheMonthTask" targetRef="EndEvent3"/>
   </process>
 </definitions>