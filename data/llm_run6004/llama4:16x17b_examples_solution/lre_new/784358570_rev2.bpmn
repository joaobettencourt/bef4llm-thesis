<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Business Process Model" targetNamespace="http://example.com/bpmn">
   <process id="OrderProcess" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>
     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_ReviewOrder"/>
     <userTask id="Task_ReviewOrder" name="Review order">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </userTask>
     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_ReviewOrder" targetRef="ExclusiveGateway_1"/>
     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_4</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_1" targetRef="Task_PreparePackage">
       <conditionExpression xsi:type="tFormalExpression">${allProductsAvailable()}</conditionExpression>
     </sequenceFlow>
     <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_1" targetRef="Task_InformCustomerDelay">
       <conditionExpression xsi:type="tFormalExpression">${someProductsUnavailable()}</conditionExpression>
     </sequenceFlow>
     <userTask id="Task_PreparePackage" name="Prepare package">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </userTask>
     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_PreparePackage" targetRef="Task_InformCourier"/>
     <userTask id="Task_InformCourier" name="Inform courier about prepared packages for delivery">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </userTask>
     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_InformCourier" targetRef="IntermediateThrowEvent_WaitForPickup"/>
     <intermediateCatchEvent id="IntermediateThrowEvent_WaitForPickup">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_7</outgoing>
       <timerEventDefinition/>
     </intermediateCatchEvent>
     <sequenceFlow id="SequenceFlow_7" sourceRef="IntermediateThrowEvent_WaitForPickup" targetRef="Task_PickupPackage"/>
     <userTask id="Task_PickupPackage" name="Pick up package by courier">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_8</outgoing>
     </userTask>
     <sequenceFlow id="SequenceFlow_8" sourceRef="Task_PickupPackage" targetRef="ServiceTask_DecideRoute"/>
     <serviceTask id="ServiceTask_DecideRoute" name="Decide the best route for all packages">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </serviceTask>
     <sequenceFlow id="SequenceFlow_9" sourceRef="ServiceTask_DecideRoute" targetRef="Task_DeliverPackage"/>
     <userTask id="Task_DeliverPackage" name="Deliver package to customer">
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_10</outgoing>
     </userTask>
     <sequenceFlow id="SequenceFlow_10" sourceRef="Task_DeliverPackage" targetRef="EndEvent_1"/>
     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_10</incoming>
     </endEvent>
     <userTask id="Task_InformCustomerDelay" name="Inform customer about potential delay and order missing products">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_11</outgoing>
     </userTask>
     <sequenceFlow id="SequenceFlow_11" sourceRef="Task_InformCustomerDelay" targetRef="IntermediateThrowEvent_WaitForDelivery"/>
     <intermediateCatchEvent id="IntermediateThrowEvent_WaitForDelivery">
       <incoming>SequenceFlow_11</incoming>
       <outgoing>SequenceFlow_12</outgoing>
       <timerEventDefinition/>
     </intermediateCatchEvent>
     <sequenceFlow id="SequenceFlow_12" sourceRef="IntermediateThrowEvent_WaitForDelivery" targetRef="Task_CheckProductsAgain"/>
     <userTask id="Task_CheckProductsAgain" name="Check products on store again">
       <incoming>SequenceFlow_12</incoming>
       <outgoing>SequenceFlow_13</outgoing>
     </userTask>
     <sequenceFlow id="SequenceFlow_13" sourceRef="Task_CheckProductsAgain" targetRef="ExclusiveGateway_1"/>
   </process>
 </definitions>