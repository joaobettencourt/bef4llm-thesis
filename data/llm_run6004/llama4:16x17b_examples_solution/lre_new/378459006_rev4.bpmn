<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" 
             targetNamespace="http://example.com/paymentProcess">
   <process id="PaymentProcess" isExecutable="true">
     <startEvent id="WeeklySchedule">
       <outgoing>GenerateReport</outgoing>
     </startEvent>
     <sequenceFlow id="GenerateReport" sourceRef="WeeklySchedule" targetRef="GeneratePaymentReport"/>
     <task id="GeneratePaymentReport" name="Generate a Payment report">
       <incoming>GenerateReport</incoming>
       <outgoing>PayVendor</outgoing>
     </task>
     <sequenceFlow id="PayVendor" sourceRef="GeneratePaymentReport" targetRef="PayTheVendor"/>
     <task id="PayTheVendor" name="Pay the vendor">
       <incoming>PayVendor</incoming>
       <outgoing>SendReportsToDepartmentsAndClient</outgoing>
     </task>
     <sequenceFlow id="SendReportsToDepartmentsAndClient" sourceRef="PayTheVendor" targetRef="ParallelGateway1"/>
     <parallelGateway id="ParallelGateway1">
       <incoming>SendReportsToDepartmentsAndClient</incoming>
       <outgoing>SendToAccountsReceivable</outgoing>
       <outgoing>SendToRegistry</outgoing>
       <outgoing>SendAutomatedReportToClient</outgoing>
     </parallelGateway>
     <sequenceFlow id="SendToAccountsReceivable" sourceRef="ParallelGateway1" targetRef="GenerateMonthlyInvoice"/>
     <task id="GenerateMonthlyInvoice" name="Generate monthly invoice for clients">
       <incoming>SendToAccountsReceivable</incoming>
       <outgoing>ChargeClientSequenceFlow</outgoing>
     </task>
     <sequenceFlow id="ChargeClientSequenceFlow" sourceRef="GenerateMonthlyInvoice" targetRef="ChargeTheClient"/>
     <task id="ChargeTheClient" name="Charge the client  $35 per invoice">
       <incoming>ChargeClientSequenceFlow</incoming>
       <outgoing>EndChargingSequenceFlow</outgoing>
     </task>
     <sequenceFlow id="EndChargingSequenceFlow" sourceRef="ChargeTheClient" targetRef="EndEvent2"/>
     <endEvent id="EndEvent2">
       <incoming>EndChargingSequenceFlow</incoming>
     </endEvent>
     <sequenceFlow id="SendToRegistry" sourceRef="ParallelGateway1" targetRef="SelectInvoicesForArchiving"/>
     <task id="SelectInvoicesForArchiving" name="selects the paper-based invoices that have been paid">
       <incoming>SendToRegistry</incoming>
       <outgoing>ArchiveInvoicesPerVendorSequenceFlow</outgoing>
     </task>
     <sequenceFlow id="ArchiveInvoicesPerVendorSequenceFlow" sourceRef="SelectInvoicesForArchiving" targetRef="Task_Archive_Per_Vendor"/>
     <task id="Task_Archive_Per_Vendor" name="archive the invoices per vendor">
       <incoming>ArchiveInvoicesPerVendorSequenceFlow</incoming>
       <outgoing>TrackDownPaymentSequenceFlow</outgoing>
     </task>
     <sequenceFlow id="TrackDownPaymentSequenceFlow" sourceRef="Task_Archive_Per_Vendor" targetRef="EndEvent1"/>
     <endEvent id="EndEvent1">
       <incoming>TrackDownPaymentSequenceFlow</incoming>
     </endEvent>
     <sequenceFlow id="SendAutomatedReportToClient" sourceRef="ParallelGateway1" targetRef="Task_Send_Automated_Report_To_Client"/>
     <task id="Task_Send_Automated_Report_To_Client" name="send automated report to client">
       <!-- No outgoing sequence flow defined as per description -->
     </task>
   </process>
</definitions>