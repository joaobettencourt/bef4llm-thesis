<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd" 
             id="definition" name="Business Process Model" targetNamespace="http://bpmn.io/schema/bpmn">
   <process id="Process_Customer" isExecutable="true">
     <startEvent id="StartEvent_Customer">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>
     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_Customer" targetRef="Task_VisitWebsite"/>
     <task id="Task_VisitWebsite" name="Visit Bank Website">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_VisitWebsite" targetRef="Task_FillData"/>
     <task id="Task_FillData" name="Fill in personal data">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_3" sourceRef="Task_FillData" targetRef="Task_CreatePdf"/>
     <task id="Task_CreatePdf" name="Generate and print Pdf">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_4</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_4" sourceRef="Task_CreatePdf" targetRef="ExclusiveGateway_1"/>
     <eventBasedGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_5</outgoing>
       <outgoing>SequenceFlow_6</outgoing>
     </eventBasedGateway>
     <sequenceFlow id="SequenceFlow_5" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_Refusal"/>
     <endEvent id="EndEvent_Refusal">
       <incoming>SequenceFlow_5</incoming>
     </endEvent>
     <sequenceFlow id="SequenceFlow_6" sourceRef="ExclusiveGateway_1" targetRef="Task_SendDocumentsToPostOffice"/>
     <task id="Task_SendDocumentsToPostOffice" name="Send Documents To Post Office">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>MessageFlow_1</outgoing>
     </task>
     <messageFlow id="MessageFlow_1" sourceRef="Task_SendDocumentsToPostOffice" targetRef="StartEvent_PostOfficer"/>
   </process>

   <process id="Process_PostOfficer">
     <startEvent id="StartEvent_PostOfficer">
       <incoming>MessageFlow_1</incoming>
       <outgoing>SequenceFlow_7</outgoing>
     </startEvent>
     <sequenceFlow id="SequenceFlow_7" sourceRef="StartEvent_PostOfficer" targetRef="Task_AuthenticateCustomer"/>
     <task id="Task_AuthenticateCustomer" name="Authenticate Bank Customer">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_8</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_8" sourceRef="Task_AuthenticateCustomer" targetRef="Task_MailAccountRequest"/>
     <task id="Task_MailAccountRequest" name="Mail Account Request">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>MessageFlow_2</outgoing>
     </task>
     <messageFlow id="MessageFlow_2" sourceRef="Task_MailAccountRequest" targetRef="StartEvent_BankOfficer"/>
   </process>

   <process id="Process_BankOfficer">
     <startEvent id="StartEvent_BankOfficer">
       <incoming>MessageFlow_2</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </startEvent>
     <sequenceFlow id="SequenceFlow_9" sourceRef="StartEvent_BankOfficer" targetRef="Task_CheckData"/>
     <task id="Task_CheckData" name="Check Customer Data">
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_10</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_10" sourceRef="Task_CheckData" targetRef="ExclusiveGateway_2"/>
     <exclusiveGateway id="ExclusiveGateway_2">
       <incoming>SequenceFlow_10</incoming>
       <outgoing>SequenceFlow_11</outgoing>
       <outgoing>SequenceFlow_12</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_11" sourceRef="ExclusiveGateway_2" targetRef="Task_MailDocuments">
       <conditionExpression xsi:type="tFormalExpression">${approval  ==  'approved'}</conditionExpression>
     </sequenceFlow>
     <task id="Task_MailDocuments" name="Mail Account Documents">
       <incoming>SequenceFlow_11</incoming>
     </task>
     <sequenceFlow id="SequenceFlow_12" sourceRef="ExclusiveGateway_2" targetRef="Task_MailRefusal">
       <conditionExpression xsi:type="tFormalExpression">${approval  ==  'rejected'}</conditionExpression>
     </sequenceFlow> 
     <task id="Task_MailRefusal" name="Mail letter of refusal">
       <incoming>SequenceFlow_12</incoming>
     </task>
   </process>

</definitions>