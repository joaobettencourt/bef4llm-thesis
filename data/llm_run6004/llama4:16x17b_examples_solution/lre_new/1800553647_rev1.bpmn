<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Business Process Model" targetNamespace="http://bpmn.ios/">
   <process id="PurchaseProcess" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>
     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="ExclusiveGateway_1"/>
     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
       <outgoing>SequenceFlow_3</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_2" sourceRef="ExclusiveGateway_1" targetRef="Task_1">
       <conditionExpression xsi:type="tFormalExpression">${enoughGoodsInStock  == true}</conditionExpression>
     </sequenceFlow>
     <task id="Task_1" name="Consume goods from stock"/>
     <sequenceFlow id="SequenceFlow_4" sourceRef="Task_1" targetRef="EndEvent_1"/>
     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_4</incoming>
     </endEvent>
     <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_1" targetRef="Task_2">
       <conditionExpression xsi:type="tFormalExpression">${enoughGoodsInStock  == false}</conditionExpression>
     </sequenceFlow>
     <task id="Task_2" name="Specify and quantify the demand"/>
     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_2" targetRef="Task_3"/>
     <task id="Task_3" name="Create purchase requisition in ERP system">
       <outgoing>SequenceFlow_6</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_3" targetRef="Task_4"/>
     <task id="Task_4" name="Check supplier information in ERP system">
       <outgoing>SequenceFlow_7</outgoing>
       <outgoing>SequenceFlow_8</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_7" sourceRef="Task_4" targetRef="ExclusiveGateway_2"/>
     <exclusiveGateway id="ExclusiveGateway_2">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_9</outgoing>
       <outgoing>SequenceFlow_10</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_8" sourceRef="Task_4" targetRef="Task_5">
      <!-- assuming supplierExists is defined -->
     </sequenceFlow>
     <task id="Task_5" name="Create supplier in ERP system"/>
     <sequenceFlow id="SequenceFlow_10" sourceRef="ExclusiveGateway_2" targetRef="Task_6"/>
     <sequenceFlow id="SequenceFlow_9" sourceRef="ExclusiveGateway_2" targetRef="Task_6"/>
     <task id="Task_6" name="Create order template from purchase requisition in ERP system">
       <outgoing>SequenceFlow_11</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_11" sourceRef="Task_6" targetRef="Task_7"/>
     <task id="Task_7" name="Approve and trigger order">
       <outgoing>SequenceFlow_12</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_12" sourceRef="Task_7" targetRef="EndEvent_2"/>
     <endEvent id="EndEvent_2">
       <incoming>SequenceFlow_12</incoming>
     </endEvent>
   </process>
</definitions>