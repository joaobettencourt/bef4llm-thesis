<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Expense Report Process">
   <process id="ExpenseReportProcess" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>
     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_ReceiveExpenseReport"/>
     <task id="Task_ReceiveExpenseReport" name="Receive Expense Report">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_ReceiveExpenseReport" targetRef="ExclusiveGateway_AccountCheck"/>
     <exclusiveGateway id="ExclusiveGateway_AccountCheck">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_4</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_AccountCheck" targetRef="Task_ReviewReport">
     </sequenceFlow>
     <task id="Task_ReviewReport" name="Review Report">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_ReviewReport" targetRef="ExclusiveGateway_AmountCheck"/>
     <exclusiveGateway id="ExclusiveGateway_AmountCheck">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_6</outgoing>
       <outgoing>SequenceFlow_7</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_6" sourceRef="ExclusiveGateway_AmountCheck" targetRef="Task_DepositoryToBankAccount">
     </sequenceFlow>
     <task id="Task_DepositoryToBankAccount" name="Depository to employee's bank account">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_8</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_8" sourceRef="Task_DepositoryToBankAccount" targetRef="EndEvent_ProcessComplete"/>
     <endEvent id="EndEvent_ProcessComplete">
       <incoming>SequenceFlow_8</incoming>
       <incoming>SequenceFlow_16</incoming>
       <incoming>SequenceFlow_18</incoming>
     </endEvent>
     <sequenceFlow id="SequenceFlow_7" sourceRef="ExclusiveGateway_AmountCheck" targetRef="Task_RequestSupervisorApproval">
     </sequenceFlow>
     <task id="Task_RequestSupervisorApproval" name="Request supervisor approval">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_9</outgoing>
       <outgoing>SequenceFlow_10</outgoing>
       <outgoing>SequenceFlow_11</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_RequestSupervisorApproval" targetRef="IntermediateCatchEvent_7Days">
     </sequenceFlow>
     <intermediateCatchEvent id="IntermediateCatchEvent_7Days">
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_12</outgoing>
       <timerEventDefinition/>
     </intermediateCatchEvent>
     <sequenceFlow id="SequenceFlow_12" sourceRef="IntermediateCatchEvent_7Days" targetRef="Task_SendApprovalInProgressEmail">
     </sequenceFlow>
     <task id="Task_SendApprovalInProgressEmail" name="Send approval in progress email to employee">
       <incoming>SequenceFlow_12</incoming>
       <outgoing>SequenceFlow_13</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_13" sourceRef="Task_SendApprovalInProgressEmail" targetRef="Task_RequestSupervisorApproval"/>
     <intermediateCatchEvent id="IntermediateThrowEvent_Approve">
       <incoming>SequenceFlow_10</incoming>
       <outgoing>SequenceFlow_14</outgoing>
       <messageEventDefinition/>
     </intermediateCatchEvent>
     <sequenceFlow id="SequenceFlow_14" sourceRef="IntermediateThrowEvent_Approve" targetRef="Task_DepositoryToBankAccount"/>
     <intermediateThrowEvent id="IntermediateThrowEvent_Rejected">
       <incoming>SequenceFlow_11</incoming>
       <outgoing>SequenceFlow_15</outgoing>
       <messageEventDefinition/>
     </intermediateThrowEvent>
     <sequenceFlow id="SequenceFlow_15" sourceRef="IntermediateThrowEvent_Rejected" targetRef="Task_SendRejectionEmailToEmployee">
     </sequenceFlow>
     <task id="Task_SendRejectionEmailToEmployee" name="Send rejection email to employee">
       <incoming>SequenceFlow_15</incoming>
       <outgoing>SequenceFlow_16</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_16" sourceRef="Task_SendRejectionEmailToEmployee" targetRef="EndEvent_ProcessComplete"/>
     <exclusiveGateway id="ExclusiveGateway_28Days">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_4</outgoing>
       <outgoing>SequenceFlow_17</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_28Days" targetRef="IntermediateCatchEvent_28Days">
     </sequenceFlow>
     <intermediateCatchEvent id="IntermediateCatchEvent_28Days">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_18</outgoing>
       <timerEventDefinition/>
     </intermediateCatchEvent>
     <sequenceFlow id="SequenceFlow_17" sourceRef="ExclusiveGateway_28Days" targetRef="EndEvent_ResubmitReport">
     </sequenceFlow>
     <endEvent id="EndEvent_ResubmitReport">
       <incoming>SequenceFlow_18</incoming>
     </endEvent>
     <sequenceFlow id="SequenceFlow_10" name="Supervisor approved" sourceRef="Task_RequestSupervisorApproval" targetRef="IntermediateThrowEvent_Approve"/>
     <sequenceFlow id="SequenceFlow_11" name="Supervisor rejected" sourceRef="Task_RequestSupervisorApproval" targetRef="IntermediateThrowEvent_Rejected"/>
   </process>
</definitions>