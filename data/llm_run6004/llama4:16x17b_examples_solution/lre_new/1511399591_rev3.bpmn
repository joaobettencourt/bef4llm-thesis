<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Business Process Model" targetNamespace="http://example.com/bpmn">
   <process id="CustomerFeedbackProcess" isExecutable="true">
     <startEvent id="StartEvent1">
       <outgoing>SequenceFlow1</outgoing>
     </startEvent>
     <sequenceFlow id="SequenceFlow1" sourceRef="StartEvent1" targetRef="Task1"/>
     <task id="Task1" name="Collect data and conduct business analysis regarding customer feedback">
       <incoming>SequenceFlow1</incoming>
       <outgoing>SequenceFlow2</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow2" sourceRef="Task1" targetRef="Task2"/>
     <task id="Task2" name="Integrate Design and decide where customer feedback module should be placed">
       <incoming>SequenceFlow2</incoming>
       <incoming>SequenceFlow8</incoming>
       <outgoing>SequenceFlow3</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow3" sourceRef="Task2" targetRef="IntermediateCatchEvent1"/>
     <intermediateCatchEvent id="IntermediateCatchEvent1">
       <incoming>SequenceFlow3</incoming>
       <outgoing>SequenceFlow4</outgoing>
     </intermediateCatchEvent>
     <task id="Task3" name="Check design and provide feedback">
       <incoming>SequenceFlow4</incoming>
       <outgoing>SequenceFlow5</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow4" sourceRef="IntermediateCatchEvent1" targetRef="Task3"/>
     <exclusiveGateway id="ExclusiveGateway1">
       <incoming>SequenceFlow5</incoming>
       <outgoing>SequenceFlow6</outgoing>
       <outgoing>SequenceFlow7</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow5" sourceRef="Task3" targetRef="ExclusiveGateway1"/>
     <sequenceFlow id="SequenceFlow6" name="Design OK" sourceRef="ExclusiveGateway1" targetRef="Task4"/>
     <sequenceFlow id="SequenceFlow7" name="Need adjustments" sourceRef="ExclusiveGateway1" targetRef="Task2"/>
     <task id="Task4" name="Integrate with the overall implementation">
       <incoming>SequenceFlow6</incoming>
       <outgoing>SequenceFlow9</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow8" sourceRef="Task7" targetRef="Task2"/>
     <sequenceFlow id="SequenceFlow9" sourceRef="Task4" targetRef="Task5"/>
     <task id="Task5" name="Test the final website to make sure everything is going well">
       <incoming>SequenceFlow9</incoming>
       <outgoing>SequenceFlow10</outgoing>
     </task>
     <exclusiveGateway id="ExclusiveGateway2">
       <incoming>SequenceFlow10</incoming>
       <outgoing>SequenceFlow11</outgoing>
       <outgoing>SequenceFlow12</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow10" sourceRef="Task5" targetRef="ExclusiveGateway2"/>
     <sequenceFlow id="SequenceFlow11" name="Not OK" sourceRef="ExclusiveGateway2" targetRef="Task6"/>
     <task id="Task6" name="Provide test results">
       <incoming>SequenceFlow11</incoming>
       <outgoing>SequenceFlow13</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow12" name="Test OK" sourceRef="ExclusiveGateway2" targetRef="EndEvent1"/>
     <endEvent id="EndEvent1">
       <incoming>SequenceFlow12</incoming>
     </endEvent>
     <task id="Task7" name="Adjust according to test results and integrate with overall implementation">
       <incoming>SequenceFlow13</incoming>
       <outgoing>SequenceFlow8</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow13" sourceRef="Task6" targetRef="Task7"/>
   </process>
 </definitions>