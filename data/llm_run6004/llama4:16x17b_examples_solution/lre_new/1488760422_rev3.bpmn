<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" 
             targetNamespace="http://bpmn.io/schema/bpmn">
   <process id="InvoiceProcess" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
       <messageEventDefinition/>
     </startEvent>
     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_0xxt38b"/>
     <task id="Task_0xxt38b" name="Receive the invoice">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_0xxt38b" targetRef="Task_0kl2q6r"/>
     <task id="Task_0kl2q6r" name="Sort the invoice per client">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_3" sourceRef="Task_0kl2q6r" targetRef="Task_06itgbl"/>
     <task id="Task_06itgbl" name="Sort the invoice per vendor">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_4</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_4" sourceRef="Task_06itgbl" targetRef="Task_0ei059v"/>
     <task id="Task_0ei059v" name="Attach invoice entry form to invoice">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_0ei059v" targetRef="SubProcess_1tw1bnp"/>
     <subProcess id="SubProcess_1tw1bnp" name="Enter required info on the invoice entry form and check completeness">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </subProcess>
     <sequenceFlow id="SequenceFlow_6" sourceRef="SubProcess_1tw1bnp" targetRef="ExclusiveGateway_00icqv2"/>
     <exclusiveGateway id="ExclusiveGateway_00icqv2">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_7</outgoing>
       <outgoing>SequenceFlow_8</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_7" name="Not complete" sourceRef="ExclusiveGateway_00icqv2" targetRef="EndEvent_0b0tzr5"/>
     <sequenceFlow id="SequenceFlow_8" name="Complete" sourceRef="ExclusiveGateway_00icqv2" targetRef="Task_1p3rseb"/>
     <task id="Task_1p3rseb" name="Enter the info for the SLA">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_1p3rseb" targetRef="Task_0mjyqkd"/>
     <task id="Task_0mjyqkd" name="Check the priority">
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_10</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_10" sourceRef="Task_0mjyqkd" targetRef="ExclusiveGateway_1lf21mx"/>
     <exclusiveGateway id="ExclusiveGateway_1lf21mx">
       <incoming>SequenceFlow_10</incoming>
       <outgoing>SequenceFlow_11</outgoing>
       <outgoing>SequenceFlow_12</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_11" name="Low" sourceRef="ExclusiveGateway_1lf21mx" targetRef="Task_0bgwiqn"/>
     <sequenceFlow id="SequenceFlow_12" name="High priority" sourceRef="ExclusiveGateway_1lf21mx" targetRef="Task_0xlj9ag"/>
     <task id="Task_0xlj9ag" name="Apply the red stamp on entry invoice">
       <incoming>SequenceFlow_12</incoming>
       <outgoing>SequenceFlow_13</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_13" sourceRef="Task_0xlj9ag" targetRef="ExclusiveGateway_1yzzi8z"/>
     <exclusiveGateway id="ExclusiveGateway_1yzzi8z">
       <incoming>SequenceFlow_13</incoming>
       <incoming>SequenceFlow_11</incoming>
       <outgoing>SequenceFlow_14</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_14" sourceRef="ExclusiveGateway_1yzzi8z" targetRef="Task_0bgwiqn"/>
     <task id="Task_0bgwiqn" name="Check invoice compliance">
       <incoming>SequenceFlow_14</incoming>
       <outgoing>SequenceFlow_15</outgoing>
     </task>
     <exclusiveGateway id="ExclusiveGateway_1yregad_2">
       <incoming>SequenceFlow_15</incoming>
       <outgoing>SequenceFlow_16</outgoing>
       <outgoing>SequenceFlow_17</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_15" sourceRef="Task_0bgwiqn" targetRef="ExclusiveGateway_1yregad_2"/>
     <sequenceFlow id="SequenceFlow_16" name="Not Complete" sourceRef="ExclusiveGateway_1yregad_2" targetRef="ExclusiveGateway_0n06z6s"/>
     <exclusiveGateway id="ExclusiveGateway_0n06z6s">
       <incoming>SequenceFlow_16</incoming>
       <outgoing>SequenceFlow_18</outgoing>
       <outgoing>SequenceFlow_19</outgoing>
       <outgoing>SequenceFlow_20</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_18" name="Send to experience staff" sourceRef="ExclusiveGateway_0n06z6s" targetRef="Task_01zpaz8"/>
     <task id="Task_01zpaz8" name="Process the Non- compliance invoice">
       <incoming>SequenceFlow_18</incoming>
       <outgoing>SequenceFlow_21</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_21" sourceRef="Task_01zpaz8" targetRef="ExclusiveGateway_1utud7s"/>
     <task id="Task_12vb5pl" name="Call the client">
       <incoming>SequenceFlow_19</incoming>
       <outgoing>SequenceFlow_22</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_19" sourceRef="ExclusiveGateway_0n06z6s" targetRef="Task_12vb5pl"/>
     <task id="Task_14ojysc" name="Send a postal mail requesting the information complete">
       <incoming>SequenceFlow_20</incoming>
     </task>
     <sequenceFlow id="SequenceFlow_20" sourceRef="ExclusiveGateway_0n06z6s" targetRef="Task_14ojysc"/>
     <intermediateCatchEvent id="IntermediateThrowEvent_1">
       <outgoing>SequenceFlow_23</outgoing>
       <timerEventDefinition/>
     </intermediateCatchEvent>
     <task id="Task_0c9qbqp" name="Send reminder">
       <incoming>SequenceFlow_23</incoming>
       <outgoing>SequenceFlow_24</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_23" sourceRef="IntermediateThrowEvent_1" targetRef="Task_0c9qbqp"/>
     <sequenceFlow id="SequenceFlow_24" sourceRef="Task_0c9qbqp" targetRef="ExclusiveGateway_1utud7s"/>
     <exclusiveGateway id="ExclusiveGateway_1utud7s">
       <incoming>SequenceFlow_21</incoming>
       <incoming>SequenceFlow_24</incoming>
       <outgoing>SequenceFlow_25</outgoing>
     </exclusiveGateway>
     <task id="Task_1n4gktk" name="Allocate invoice to DEO">
       <incoming>SequenceFlow_25</incoming>
       <outgoing>SequenceFlow_26</outgoing>
     </task>
     <endEvent id="EndEvent_1siish7">
       <incoming>SequenceFlow_26</incoming>
     </endEvent>
     <sequenceFlow id="SequenceFlow_25" sourceRef="ExclusiveGateway_1utud7s" targetRef="Task_1n4gktk"/>
     <sequenceFlow id="SequenceFlow_26" sourceRef="Task_1n4gktk" targetRef="EndEvent_1siish7"/>
     <endEvent id="EndEvent_0b0tzr5">
       <incoming>SequenceFlow_7</incoming>
       <messageEventDefinition/>
     </endEvent>
   </process>
</definitions>