<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definitions" 
             targetNamespace="http://example.com/bpmn">

   <process id="carServiceProcess" isExecutable="true">
     <startEvent id="serviceDue" name="Service Due">
       <outgoing>checkCarRegistration</outgoing>
     </startEvent>

     <sequenceFlow id="checkCarRegistrationFlow" sourceRef="serviceDue" targetRef="checkCarRegistration"/>

     <task id="checkCarRegistration" name="Check Car Registration">
       <incoming>checkCarRegistrationFlow</incoming>
       <outgoing>notifyCarOwner</outgoing>
       <outgoing>carNotRegistered</outgoing>
     </task>

     <sequenceFlow id="notifyCarOwnerFlow" sourceRef="checkCarRegistration" targetRef="notifyCarOwner">
       <conditionExpression xsi:type="tFormalExpression">${carRegistered == true}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="carNotRegisteredFlow" sourceRef="checkCarRegistration" targetRef="carNotRegistered">
       <conditionExpression xsi:type="tFormalExpression">${carRegistered == false}</conditionExpression>
     </sequenceFlow>

     <task id="notifyCarOwner" name="Notify Car Owner">
       <incoming>notifyCarOwnerFlow</incoming>
       <outgoing>fineCarOwner</outgoing>
     </task>

     <intermediateCatchEvent id="fineCarOwner" name="Fine Car Owner">
       <incoming>fineCarOwnerFlow</incoming>
       <timerEventDefinition>
         <timeDuration>P30D</timeDuration>
       </timerEventDefinition>
       <outgoing>fineCarOwnerTask</outgoing>
     </intermediateCatchEvent>

     <sequenceFlow id="fineCarOwnerFlow" sourceRef="notifyCarOwner" targetRef="fineCarOwner"/>

     <task id="fineCarOwnerTask" name="Fine Car Owner Task">
       <incoming>fineCarOwnerTaskFlow</incoming>
       <outgoing>carNotRegisteredEnd</outgoing>
     </task>

     <sequenceFlow id="fineCarOwnerTaskFlow" sourceRef="fineCarOwner" targetRef="fineCarOwnerTask"/>

     <endEvent id="carNotRegisteredEnd" name="Car Not Registered">
       <incoming>carNotRegisteredFlow</incoming>
     </endEvent>

     <subProcess id="carServiceSubprocess" name="Car Service Subprocess">
       <startEvent id="enterCarProblems" name="Enter Car Problems">
         <outgoing>enterCarProblemsTask</outgoing>
       </startEvent>

       <sequenceFlow id="enterCarProblemsTaskFlow" sourceRef="enterCarProblems" targetRef="enterCarProblemsTask"/>

       <task id="enterCarProblemsTask" name="Enter Car Problems Task">
         <incoming>enterCarProblemsTaskFlow</incoming>
         <outgoing>sendStatusUpdates</outgoing>
       </task>

       <sequenceFlow id="sendStatusUpdatesFlow" sourceRef="enterCarProblemsTask" targetRef="sendStatusUpdates"/>

       <intermediateCatchEvent id="sendStatusUpdates" name="Send Status Updates">
         <incoming>sendStatusUpdatesFlow</incoming>
         <messageEventDefinition messageRef="statusUpdate"/>
         <outgoing>payThroughApp</outgoing>
       </intermediateCatchEvent>

       <sequenceFlow id="payThroughAppFlow" sourceRef="sendStatusUpdates" targetRef="payThroughApp"/>

       <task id="payThroughApp" name="Pay through App">
         <incoming>payThroughAppFlow</incoming>
         <outgoing>enterRepairSuccess</outgoing>
       </task>

       <sequenceFlow id="enterRepairSuccessFlow" sourceRef="payThroughApp" targetRef="enterRepairSuccess"/>

       <task id="enterRepairSuccess" name="Enter Repair Success and Next Service Date">
         <incoming>enterRepairSuccessFlow</incoming>
         <outgoing>serviceCompletedEnd</outgoing>
       </task>

       <sequenceFlow id="serviceCompletedEndFlow" sourceRef="enterRepairSuccess" targetRef="serviceCompletedEnd"/>
     </subProcess>

     <endEvent id="carNotRegisteredEnd" name="Car Not Registered End">
       <incoming>fineCarOwnerTask</incoming>
     </endEvent>

     <endEvent id="serviceCompletedEnd" name="Service Completed">
       <incoming>enterRepairSuccessFlow</incoming>
     </endEvent>
   </process>
 </definitions>