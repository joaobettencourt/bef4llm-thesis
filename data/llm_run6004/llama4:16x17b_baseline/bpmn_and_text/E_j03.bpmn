<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definitions" 
             name="Work Accident Process"
             targetNamespace="http://example.com/workaccident">

   <process id="workAccidentProcess" isExecutable="true">
     <startEvent id="startEvent1" name="New Work Accident Occurs">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="task1"/>

     <task id="task1" name="Gather Information About the Accident">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
       <outgoing>sequenceFlow3</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow2" sourceRef="task1" targetRef="exclusiveGateway1"/>

     <exclusiveGateway id="exclusiveGateway1">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow4</outgoing>
       <outgoing>sequenceFlow5</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow4" sourceRef="exclusiveGateway1" targetRef="task2"/>

     <task id="task2" name="Report Accident to Employer">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow6</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow6" sourceRef="task2" targetRef="serviceTask1"/>

     <serviceTask id="serviceTask1" name="Employer Reports Accident to Labour Inspectorate">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow8</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlow8" sourceRef="serviceTask1" targetRef="endEvent1"/>

     <task id="task3" name="Report Accident to Authorities/Insurance Provider">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow7</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow5" sourceRef="exclusiveGateway1" targetRef="task3"/>

     <sequenceFlow id="sequenceFlow7" sourceRef="task3" targetRef="endEvent1"/>

     <endEvent id="endEvent1" name="Accident Reported and Processed">
       <incoming>sequenceFlow7</incoming>
       <incoming>sequenceFlow8</incoming>
     </endEvent>

   </process>

</definitions>