<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definitions" 
             targetNamespace="http://example.com/bpmn">

   <process id="Process_Find_Job" isExecutable="true">
     <startEvent id="StartEvent_New_Job_Application" name="New Job Application">
       <outgoing>SequenceFlow_Report_Application</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_Report_Application" sourceRef="StartEvent_New_Job_Application" targetRef="Task_Report_Job_Application"/>

     <task id="Task_Report_Job_Application" name="Report Job Application to Employment Agency">
       <incoming>SequenceFlow_Report_Application</incoming>
       <outgoing>SequenceFlow_Receive_Potential_Offers</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_Receive_Potential_Offers" sourceRef="Task_Report_Job_Application" targetRef="Task_Receive_Potential_Job_Offers"/>

     <task id="Task_Receive_Potential_Job_Offers" name="Receive Potential Job Offers">
       <incoming>SequenceFlow_Receive_Potential_Offers</incoming>
       <outgoing>SequenceFlow_Company_Confirms_Application</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_Company_Confirms_Application" sourceRef="Task_Receive_Potential_Job_Offers" targetRef="ParallelGateway_1"/>

     <parallelGateway id="ParallelGateway_1">
       <incoming>SequenceFlow_Company_Confirms_Application</incoming>
       <outgoing>SequenceFlow_Confirm_Rate_Application</outgoing>
       <outgoing>SequenceFlow_Negotiate_Job_Interview</outgoing>
     </parallelGateway>

     <sequenceFlow id="SequenceFlow_Confirm_Rate_Application" sourceRef="ParallelGateway_1" targetRef="Task_Company_Confirms_and_Rates_Application"/>

     <task id="Task_Company_Confirms_and_Rates_Application" name="Company Confirms and Rates Application">
       <incoming>SequenceFlow_Confirm_Rate_Application</incoming>
       <outgoing>SequenceFlow_Negotiate_Interview_or_Prosecute</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_Negotiate_Job_Interview" sourceRef="ParallelGateway_1" targetRef="Task_Negotiate_Job_Interview"/>

     <task id="Task_Negotiate_Job_Interview" name="Negotiate Job Interview">
       <incoming>SequenceFlow_Negotiate_Job_Interview</incoming>
       <outgoing>SequenceFlow_Prosecute_or_End</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_Prosecute_or_End" sourceRef="Task_Company_Confirms_and_Rates_Application" targetRef="ExclusiveGateway_1"/>

     <sequenceFlow id="SequenceFlow_Negotiate_Interview_or_Prosecute" sourceRef="Task_Negotiate_Job_Interview" targetRef="ExclusiveGateway_1"/>

     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_Prosecute_or_End</incoming>
       <incoming>SequenceFlow_Negotiate_Interview_or_Prosecute</incoming>
       <outgoing>SequenceFlow_Probation_Phase</outgoing>
       <outgoing>SequenceFlow_Application_Rejected</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_Probation_Phase" sourceRef="ExclusiveGateway_1" targetRef="Task_Probation_Phase"/>

     <task id="Task_Probation_Phase" name="Probation Phase">
       <incoming>SequenceFlow_Probation_Phase</incoming>
       <outgoing>SequenceFlow_Rate_Company</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_Rate_Company" sourceRef="Task_Probation_Phase" targetRef="ParallelGateway_2"/>

     <parallelGateway id="ParallelGateway_2">
       <incoming>SequenceFlow_Rate_Company</incoming>
       <outgoing>SequenceFlow_You_Rate_Company</outgoing>
       <outgoing>SequenceFlow_Company_Rates_You</outgoing>
     </parallelGateway>

     <sequenceFlow id="SequenceFlow_You_Rate_Company" sourceRef="ParallelGateway_2" targetRef="Task_You_Rate_the_Company"/>

     <task id="Task_You_Rate_the_Company" name="You Rate the Company">
       <incoming>SequenceFlow_You_Rate_Company</incoming>
       <outgoing>SequenceFlow_Reviews_Available</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_Reviews_Available" sourceRef="Task_You_Rate_the_Company" targetRef="ExclusiveGateway_2"/>

     <sequenceFlow id="SequenceFlow_Company_Rates_You" sourceRef="ParallelGateway_2" targetRef="Task_Company_Rates_You"/>

     <task id="Task_Company_Rates_You" name="Company Rates You">
       <incoming>SequenceFlow_Company_Rates_You</incoming>
       <outgoing>SequenceFlow_Reviews_Available</outgoing>
     </task>

     <exclusiveGateway id="ExclusiveGateway_2">
       <incoming>SequenceFlow_Reviews_Available</incoming>
       <outgoing>SequenceFlow_End_Successful</outgoing>
       <outgoing>SequenceFlow_Continue_Receiving_Offer</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_End_Successful" sourceRef="ExclusiveGateway_2" targetRef="EndEvent_Job_Becomes_Permanent"/>

     <endEvent id="EndEvent_Job_Becomes_Permanent" name="Job Becomes Permanent">
       <incoming>SequenceFlow_End_Successful</incoming>
     </endEvent>

     <sequenceFlow id="SequenceFlow_Continue_Receiving_Offer" sourceRef="ExclusiveGateway_2" targetRef="Task_Receive_Potential_Job_Offers"/>

     <sequenceFlow id="SequenceFlow_Application_Rejected" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_Application_Rejected"/>

     <endEvent id="EndEvent_Application_Rejected" name="Job Application Rejected">
       <incoming>SequenceFlow_Application_Rejected</incoming>
     </endEvent>

   </process>
 </definitions>