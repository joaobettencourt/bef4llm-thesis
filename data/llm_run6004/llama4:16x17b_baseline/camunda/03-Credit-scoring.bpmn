<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definitions" name="Credit Scoring Process" targetNamespace="http://example.com">

   <process id="creditScoringProcess" isExecutable="true">
     <startEvent id="startEvent1">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="task1"/>

     <task id="task1" name="Receive credit-scoring request">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow2" sourceRef="task1" targetRef="exclusiveGateway1"/>

     <exclusiveGateway id="exclusiveGateway1">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
       <outgoing>sequenceFlow4</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow3" name="immediate result" sourceRef="exclusiveGateway1" targetRef="task2">
       <conditionExpression xsi:type="tFormalExpression">${resultAvailable  == true}</conditionExpression>
     </sequenceFlow>

     <task id="task2" name="Present immediate result to clerk">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow5</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow5" sourceRef="task2" targetRef="endEvent1"/>

     <endEvent id="endEvent1">
       <incoming>sequenceFlow5</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow4" name="delayed result" sourceRef="exclusiveGateway1" targetRef="intermediateCatchEvent1"/>

     <intermediateCatchEvent id="intermediateCatchEvent1">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow6</outgoing>
     </intermediateCatchEvent>

     <sequenceFlow id="sequenceFlow6" sourceRef="intermediateCatchEvent1" targetRef="task3"/>

     <task id="task3" name="Inform clerk about delay">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow7</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow7" sourceRef="task3" targetRef="task4"/>

     <task id="task4" name="Receive level 2 scoring result">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow8</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow8" sourceRef="task4" targetRef="task5"/>

     <task id="task5" name="Present final result to clerk">
       <incoming>sequenceFlow8</incoming>
     </task>

   </process>

   <!-- Agency process -->
   <process id="agencyProcess" isExecutable="true">
     <startEvent id="agencyStartEvent">
       <outgoing>agencySequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="agencySequenceFlow1" sourceRef="agencyStartEvent" targetRef="exclusiveGateway2"/>

     <exclusiveGateway id="exclusiveGateway2">
       <incoming>agencySequenceFlow1</incoming>
       <outgoing>agencySequenceFlow2</outgoing>
       <outgoing>agencySequenceFlow3</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="agencySequenceFlow2" name="immediate result available" sourceRef="exclusiveGateway2" targetRef="agencyTask1">
       <conditionExpression xsi:type="tFormalExpression">${resultAvailable  == true}</conditionExpression>
     </sequenceFlow>

     <task id="agencyTask1" name="Perform level 1 scoring">
       <incoming>agencySequenceFlow2</incoming>
       <outgoing>agencySequenceFlow4</outgoing>
     </task>

     <sequenceFlow id="agencySequenceFlow4" sourceRef="agencyTask1" targetRef="agencyEndEvent1"/>

     <endEvent id="agencyEndEvent1">
       <incoming>agencySequenceFlow4</incoming>
     </endEvent>

     <sequenceFlow id="agencySequenceFlow3" name="delayed result" sourceRef="exclusiveGateway2" targetRef="agencyTask2"/>

     <task id="agencyTask2" name="Perform level 2 scoring">
       <incoming>agencySequenceFlow3</incoming>
       <outgoing>agencySequenceFlow5</outgoing>
     </task>

     <sequenceFlow id="agencySequenceFlow5" sourceRef="agencyTask2" targetRef="agencyEndEvent2"/>

     <endEvent id="agencyEndEvent2">
       <incoming>agencySequenceFlow5</incoming>
     </endEvent>

   </process>

   <!-- Message Flows -->
   <messageFlow id="messageFlow1" name="scoring request" sourceRef="task1" targetRef="agencyStartEvent"/>
   <messageFlow id="messageFlow2" name="immediate scoring result" sourceRef="agencyEndEvent1" targetRef="exclusiveGateway1"/>
   <messageFlow id="messageFlow3" name="final scoring result" sourceRef="agencyEndEvent2" targetRef="task4"/>

</definitions>