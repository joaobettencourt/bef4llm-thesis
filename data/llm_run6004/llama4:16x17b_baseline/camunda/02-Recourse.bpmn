<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definitions" 
             targetNamespace="http://example.com/bpmn">

   <process id="recourseProcess" isExecutable="true">
     <startEvent id="startEvent1">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="task1"/>

     <task id="task1" name="Get information about possible subrogation">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow2" sourceRef="task1" targetRef="exclusiveGateway1"/>

     <exclusiveGateway id="exclusiveGateway1">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
       <outgoing>sequenceFlow4</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow3" name="yes" sourceRef="exclusiveGateway1" targetRef="task2">
       <!--conditionExpression xsi:type="tFormalExpression">${subrogationPossible  == true}</conditionExpression-->
     </sequenceFlow>

     <sequenceFlow id="sequenceFlow4" name="no" sourceRef="exclusiveGateway1" targetRef="endEvent1"/>

     <task id="task2" name="Check case and send request for payment">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow5</outgoing>
       <outgoing>sequenceFlow6</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow5" sourceRef="task2" targetRef="exclusiveGateway2"/>

     <exclusiveGateway id="exclusiveGateway2">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow7</outgoing>
       <outgoing>sequenceFlow8</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow7" name="payment received" sourceRef="exclusiveGateway2" targetRef="task3">
       <!--conditionExpression xsi:type="tFormalExpression">${paymentReceived  == true}</conditionExpression-->
     </sequenceFlow>

     <sequenceFlow id="sequenceFlow8" name="disagreement or deadline reached" sourceRef="exclusiveGateway2" targetRef="task4"/>

     <task id="task3" name="Make booking and close case">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow9</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow9" sourceRef="task3" targetRef="endEvent1"/>

     <task id="task4" name="Check reasoning and forward to collection agency if necessary">
       <incoming>sequenceFlow8</incoming>
       <outgoing>sequenceFlow10</outgoing>
       <outgoing>sequenceFlow11</outgoing>
     </task>

     <exclusiveGateway id="exclusiveGateway3">
       <incoming>sequenceFlow10</incoming>
       <outgoing>sequenceFlow12</outgoing>
       <outgoing>sequenceFlow13</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow10" sourceRef="task4" targetRef="exclusiveGateway3"/>

     <sequenceFlow id="sequenceFlow11" sourceRef="task2" targetRef="task4"/>

     <sequenceFlow id="sequenceFlow12" name="agree with recourse" sourceRef="exclusiveGateway3" targetRef="task5">
       <!--conditionExpression xsi:type="tFormalExpression">${insurantAgrees  == false}</conditionExpression-->
     </sequenceFlow>

     <sequenceFlow id="sequenceFlow13" name="disagree with recourse" sourceRef="exclusiveGateway3" targetRef="endEvent1">
       <!--conditionExpression xsi:type="tFormalExpression">${insurantAgrees  == true}</conditionExpression-->
     </sequenceFlow>

     <task id="task5" name="Forward to collection agency">
       <incoming>sequenceFlow12</incoming>
       <outgoing>sequenceFlow14</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow14" sourceRef="task5" targetRef="endEvent1"/>

     <endEvent id="endEvent1">
       <incoming>sequenceFlow4</incoming>
       <incoming>sequenceFlow9</incoming>
       <incoming>sequenceFlow13</incoming>
       <incoming>sequenceFlow14</incoming>
     </endEvent>

   </process>
 </definitions>